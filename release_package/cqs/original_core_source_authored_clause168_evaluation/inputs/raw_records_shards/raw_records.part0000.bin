{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":1296},{"literal_text_all_w_t_and_m_t":"This field specifies the NR Cell Global ID of the TRP belonging to a particular network area where the associated assistance data are applicable.","paragraph_zero_based":1297},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":1298},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the TRP belonging to a particular network area where the associated assistance data are applicable.","paragraph_zero_based":1299},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":1300},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":1301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1302},{"literal_text_all_w_t_and_m_t":"–CoordinateID","paragraph_zero_based":1303},{"literal_text_all_w_t_and_m_t":"The IE CoordinateID is used to indicate a reference point that defines the origin of a local Cartesian Coordinate System as defined in TS 23.032 [15].","paragraph_zero_based":1304},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1306},{"literal_text_all_w_t_and_m_t":"CoordinateID-r18 ::= VisibleString (SIZE (1..256))","paragraph_zero_based":1307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1308},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1310},{"literal_text_all_w_t_and_m_t":"–DL-PRS-ID-Info","paragraph_zero_based":1311},{"literal_text_all_w_t_and_m_t":"The IE DL-PRS-ID-Info provides the IDs of the reference TRPs' DL-PRS Resources.","paragraph_zero_based":1312},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1314},{"literal_text_all_w_t_and_m_t":"DL-PRS-ID-Info-r16 ::= SEQUENCE {","paragraph_zero_based":1315},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID-r16INTEGER (0..255),","paragraph_zero_based":1316},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ResourceID-List-r16SEQUENCE (SIZE (1..nrMaxResourceIDs-r16)) OF","paragraph_zero_based":1317},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-ResourceID-r16","paragraph_zero_based":1318},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":1319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["b6bcf2498743070fb54e47310825a7d5420f174d8c19c702f203882c75874920","15143652e4a50fece57b7fcdaee3601c58e56cb5f52b513d13da0c309150a399","bc9b14b9d28f5918841f2eac3caf4d53fa83479d39213e7471a4c85de4778247","2339e3283d72f19e915071509912e4918dad820835da0d80e39c59bf5e68386c","ebe6d5b1e88ff3cdea41e6534c969ac4f2fab1f038e78d34349a7b5ead781314","e1a751d4bfa5ef014a1ccb7b378be1e687ff9f72748a21217c3e8447259636dc","f976c84d6f0d5738ff0d89ad0e4523e225bab6a4dc3b5075f0a3a7601dfac251","0d987e676234cccd9b3b411d3a6ec5a317494126f059e4fecde82034c17f86e5","159935935fa829a4289b252bfc198d995b8bd9eb49137194a8230fd598b355ac","b518ff3f34c7470319b31424fad5bc9b6da8cee1e41c1aefc570f790f850529e","68d8ea061e4192416641ef1684f08816903fe4535f19f06d49ce2d7302db00e3","83c156d9d3ea143af1355b4fed9620edcd44b1a1ad3c22882cb25c200af5d4a0","19a020770894566c48132e9dca5e617474e299c568481d341f97d5c08284041d","0f2166f319263c53bddeaa2b654fbbcfc50bde0f8f8a84ef32b88138e6784fb7","0044323189d3990054c767