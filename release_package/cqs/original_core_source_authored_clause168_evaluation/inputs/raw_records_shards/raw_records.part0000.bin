{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":9408},{"literal_text_all_w_t_and_m_t":"Logical channel: BCCH","paragraph_zero_based":9409},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9410},{"literal_text_all_w_t_and_m_t":"MIB","paragraph_zero_based":9411},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9412},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-START","paragraph_zero_based":9413},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9414},{"literal_text_all_w_t_and_m_t":"MIB ::=                             SEQUENCE {","paragraph_zero_based":9415},{"literal_text_all_w_t_and_m_t":"    systemFrameNumber                   BIT STRING (SIZE (6)),","paragraph_zero_based":9416},{"literal_text_all_w_t_and_m_t":"    subCarrierSpacingCommon             ENUMERATED {scs15or60, scs30or120},","paragraph_zero_based":9417},{"literal_text_all_w_t_and_m_t":"    ssb-SubcarrierOffset                INTEGER (0..15),","paragraph_zero_based":9418},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":9419},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigSIB1                    PDCCH-ConfigSIB1,","paragraph_zero_based":9420},{"literal_text_all_w_t_and_m_t":"    cellBarred                          ENUMERATED {barred, notBarred},","paragraph_zero_based":9421},{"literal_text_all_w_t_and_m_t":"    intraFreqReselection                ENUMERATED {allowed, notAllowed},","paragraph_zero_based":9422},{"literal_text_all_w_t_and_m_t":"    spare                               BIT STRING (SIZE (1))","paragraph_zero_based":9423},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9425},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-STOP","paragraph_zero_based":9426},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9428},{"literal_text_all_w_t_and_m_t":"MIB field descriptions","paragraph_zero_based":9429},{"literal_text_all_w_t_and_m_t":"cellBarred","paragraph_zero_based":9430},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred, as defined in TS 38.304 [20]. This field is ignored by IAB-MT. This field is ignored for connectivity to NTN. This field is ignored by UEs supporting NES if cellBarredNES is configured in SIB1.","paragraph_zero_based":9431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f4b8b299b0994988fee1bde42d8a64af8833794c99783a6c97c8de8947fc0093","d8188a88df53c9f9680d67f88980d05da59c5c177d24a13cc0d800cb09e51269","26559253e3bc40a33c87c02b9ba2d39ccb6efcf43313e2d640ea3adfacd1f6eb","9f4c15f1081aba9ec29b3d71c25b851ba4c0334973fffbe4f6b13f6813a8f6f9","b7e1d565f298e0cbdedcb70bb59913ab2e27d943a0ebc589ddfff416115ac14e","e21b9f52c52a0cd7bd8f37ae24435171873842a4eaaf9e6f3cec14c3abb0cd39","86646780559fe0084f340e380c9bb03ca1409aae3f44eac929f8ef2275076f3b","b1cd73ed1a29af7a308cd7e4d951389c498efce60679cea886f83a824be3b41f","64aff7539d6d85811ea1957d4fa5b6e4d73508e2e6c230852033079e18f36d68","b53da6aed3a627f0a01cf6f5724fe9dfec58b4fdf86c6f159bcc9b452808d76f","1f2e05788d5585366d9393f8717e85d1605ae996a002197318ef2888a1d35960","e0d11b0cf63ebb27fcd747f2261c3801bb544aeb636095976bf69cf668522470","de609582f536bd0095162f3f8d52188f41c09cc96782bb4907a2b6098f379055","ef4663b65a2adf3d4083584bd40768fd1639d12eab92efbfe351914650cc0519","b3134b7a44a874fba2869e965aceeef0c1718b2eda9db5fa4620e90dfe0f0b1e","74223d0052804a0a5477280fd905a620a113c7d28501f145b6a1e8253a780fa2","d5259e3be5bdc55a0432fa8cc7ea06366388187c4561dc1ea95fa33cbb9d2cb1","314622f3a4076bef2180ff07213ea689b22a97d9adc996af957effbd09c8bf75","ccb66bb268b96b34f3964fd23c49b728df53d92a597d9d1b9af90cbccd0fa713","efb93a59a2aad6d949f90585d12709490c50465598e2c9afc0c68c13d9a1b5a7","741c847196ca9fe4ec743a23d1885933614b03b4f50b2ad725076b834088bee3","43f71061b3115c7d37b0ede8965956aebe405859a2afd0e892b28d2618b517e4","572fe03e908d051f0d15c5826a415c3e730f92866a2fe92ce5353c3afe2c12dd","eede2e96fb08dcbdbe80ea49d03c870aa1b127c6bdf3de7f3b9c777f332fe730"],"paragraph_range_zero_based":[9408,9431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p9408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":9432},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.2) and uplink (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":9433},{"literal_text_all_w_t_and_m_t":"intraFreqReselection","paragraph_zero_based":9434},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells when the highest ranked cell is barred, or treated as barred by the UE, as specified in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":9435},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigSIB1","paragraph_zero_based":9436},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET), a common search space and necessary PDCCH parameters. If the field ssb-SubcarrierOffset indicates that SIB1 is absent, the field pdcch-ConfigSIB1 indicates the frequency positions where the UE may find SS/PBCH block with SIB1 or the frequency range where the network does not provide SS/PBCH block with SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9437},{"literal_text_all_w_t_and_m_t":"ssb-SubcarrierOffset","paragraph_zero_based":9438},{"literal_text_all_w_t_and_m_t":"Corresponds to kSSB (see TS 38.213 [13]), which is the frequency domain offset between SSB and the overall resource block grid in number of subcarriers. (See TS 38.211 [16], clause 7.4.3.1). For operation with shared spectrum channel access in FR1 (see 37.213 [48]), this field corresponds to kSSB, and kSSB is obtained from kSSB (see TS 38.211 [16], clause 7.4.3.1); the LSB of this field is used also for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9439},{"literal_text_all_w_t_and_m_t":"The value range of this field may be extended by an additional most significant bit encoded within PBCH as specified in TS 38.213 [13].","paragraph_zero_based":9440},{"literal_text_all_w_t_and_m_t":"This field may indicate that this cell does not provide SIB1 and that there is hence no CORESET#0 configured in MIB (see TS 38.213 [13], clause 13). In this case, the field pdcch-ConfigSIB1 may indicate the frequency positions where the UE may (not) find a SS/PBCH with a control resource set and search space for SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":9441},{"literal_text_all_w_t_and_m_t":"subCarrierSpacingCommon","paragraph_zero_based":9442},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages. If the UE acquires this MIB on an FR1 carrier frequency, the value scs15or60 corresponds to 15 kHz and the value scs30or120 corresponds to 30 kHz. If the UE acquires this MIB on an FR2 carrier frequency, the value scs15or60 corresponds to 60 kHz and the value scs30or120 corresponds to 120 kHz. For operation with shared spectrum channel access in FR1 (see 37.213 [48]) and for operation in FR2-2, the subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages is same as that for the corresponding SSB. For operation with shared spectrum channel access, this field instead is used for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":9443},{"literal_text_all_w_t_and_m_t":"systemFrameNumber","paragraph_zero_based":9444},{"literal_text_all_w_t_and_m_t":"The 6 most significant bits (MSB) of the 10-bit System Frame Number (SFN). The 4 LSB of the SFN are conveyed in the PBCH transport block as part of channel coding (i.e. outside the MIB encoding), as defined in clause 7.1 in TS 38.212 [17].","paragraph_zero_based":9445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9446},{"literal_text_all_w_t_and_m_t":"Editor’s note: A NES-capable UE in the cell barring context is at least UE supporting cell DTX/DRX. FFS if other NES features will need to be included only if legacy impact is found. FFS how we capture it in the CR in terms of wording. A reference to a specific UE capability to be added.","paragraph_zero_based":9447},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9448},{"literal_text_all_w_t_and_m_t":"–MobilityFromNRCommand","paragraph_zero_based":9449},{"literal_text_all_w_t_and_m_t":"The MobilityFromNRCommand message is used to command handover from NR to E-UTRA/EPC, E-UTRA/5GC or UTRA-FDD.","paragraph_zero_based":9450},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9451},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9452},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9453},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9454},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand message","paragraph_zero_based":9455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6b6a2791dbbc4335593e5df0fbf923ccdeb41e541b865849b5882b140267ace2","3fbc1ab778f9a9a345aee1e0f5cb2de91a0355ecaccdf3539af72d391dd7aa2b","e4ca4846a6a184fb3ac9283861669d7a28ac4b629e0c8f6b2e1812fa5097b457","4be8232c72ea4a39be1a1eba4f11b306ade9175caf392bb2250c5d4b22848dc6","a1fb5902ed1c54e5e301b950a8348d19cde011a557e87a4f3754a77ee434531e","09cd8197ff5f377b7c617bf3f04be5e9d719d6be832a720630ca7bf372695868","ee44b06198c1b2ccb5051ad2ebf27ec864d30c5260d59027d66e97d012c8a229","baff5ba5eae493ffade494e0f2dc1ecb010c0403f467f494e5186604e97d4995",