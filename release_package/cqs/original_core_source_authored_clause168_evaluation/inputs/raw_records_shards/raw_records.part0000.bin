{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":1896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1897},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":1898},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":1899},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":1900},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":1901},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":1902},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":1903},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":1904},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1905},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":1906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1907},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration ::=                  SEQUENCE {","paragraph_zero_based":1908},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":1909},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":1910},{"literal_text_all_w_t_and_m_t":"        rrcReconfiguration                      RRCReconfiguration-IEs,","paragraph_zero_based":1911},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":1912},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":1913},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1914},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1915},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs ::=              SEQUENCE {","paragraph_zero_based":1916},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                       RadioBearerConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":1917},{"literal_text_all_w_t_and_m_t":"    secondaryCellGroup                      OCTET STRING (CONTAINING CellGroupConfig)                              OPTIONAL, -- Cond SCG","paragraph_zero_based":1918},{"literal_text_all_w_t_and_m_t":"    measConfig                              MeasConfig                                                             OPTIONAL, -- Need M","paragraph_zero_based":1919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["fe95539ce8833c0423db1eb2dc2a7d3231d3de9ed6b3fda4273e43246237edf3","d33aaf96306deec950f01fcc3f0393a2810f395adf6affa1d8edd8f621d49a21","52e787c60cb308e90f061619d3594f6d8235b9000455df15cc76e6f5213663e9","3101d66cf23821359786be7f7191610b3ed133907f204e1f461cb78467df2955","1b5f546072c71ca980af7b683e2d6a118008a55564342806b929e46f1f7568ef","beea3d895a01d2fe905dc875d9ace586bb407ece976b5ef542b2e02e101cdac4","f916ee09150fe4b0ddf40b5012d32acb0b76120441126b714a8a08ac5591d84b","2423eef29c1177f2328224549a2a781f657c535a93fc89bd20731d4b7549326c","0ef4dae065823531511d7f5987c5a47b2188b0798a909916ed432b39d59129f7","05c827aee8cc16860930a23e50f180bb1120017a3e70df81c531b728ddb78fe7","6bdcfc4b24