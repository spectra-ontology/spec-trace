{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the received rlf-TimersAndConstants is set to release:","paragraph_zero_based":1944},{"literal_text_all_w_t_and_m_t":"2>if any DAPS bearer is configured:","paragraph_zero_based":1945},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311 for the target cell group, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1946},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1947},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1948},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1949},{"literal_text_all_w_t_and_m_t":"2>if any DAPS bearer is configured:","paragraph_zero_based":1950},{"literal_text_all_w_t_and_m_t":"3>configure the value of timers and constants for the target cell group in accordance with received rlf-TimersAndConstants;","paragraph_zero_based":1951},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1952},{"literal_text_all_w_t_and_m_t":"3>(re-)configure the value of timers and constants in accordance with received rlf-TimersAndConstants;","paragraph_zero_based":1953},{"literal_text_all_w_t_and_m_t":"3>stop timer T310 for this cell group, if running;","paragraph_zero_based":1954},{"literal_text_all_w_t_and_m_t":"3>stop timer T312 for this cell group, if running;","paragraph_zero_based":1955},{"literal_text_all_w_t_and_m_t":"3>reset the counters N310 and N311.","paragraph_zero_based":1956},{"literal_text_all_w_t_and_m_t":"5.3.5.5.7SpCell Configuration","paragraph_zero_based":1957},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1958},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":1959},{"literal_text_all_w_t_and_m_t":"2>if the SpCellConfig contains the rlf-TimersAndConstants which is set to setup:","paragraph_zero_based":1960},{"literal_text_all_w_t_and_m_t":"3>use value for timers T311 as received in rlf-TimersAndConstants;","paragraph_zero_based":1961},{"literal_text_all_w_t_and_m_t":"2>else if rlf-TimersAndConstants is not configured for this cell group or SpCellConfig contains the rlf-TimersAndConstants which is set to release:","paragraph_zero_based":1962},{"literal_text_all_w_t_and_m_t":"3>use value for timers T311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1963},{"literal_text_all_w_t_and_m_t":"1>else","paragraph_zero_based":1964},{"literal_text_all_w_t_and_m_t":"2>if the SpCellConfig contains the rlf-TimersAndConstants:","paragraph_zero_based":1965},{"literal_text_all_w_t_and_m_t":"3>configure the RLF timers and constants for this cell group as specified in 5.3.5.5.6;","paragraph_zero_based":1966},{"literal_text_all_w_t_and_m_t":"2>else if rlf-TimersAndConstants is not configured for this cell group:","paragraph_zero_based":1967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fa4169020b18a432231242f0e1f3a44593c6fad44cd75a5c231d27edb771f045","daaa6a381e75698f1b04b34fed412a7f7c7135e7488e096f7c7de2d04271b5ef","0a62f7267527f0655f8ae61cd9b7f7a627253c6ea7d8e48e7de9115a79948cda","7616a148dec65644ddab74742e27d5a5e6a7c42d4ccee7eb70e1851f73455424","aa36344c1bd83e8c125c435de670bd8d42a1857d624a2c25c4a8fef09ad3f969","4a88989090f5d1306d415390a85b39266107ee6f24d613dfea43bf764d763d42","0081086938d624526b5eed66c68b4a966bedbe28d3286f7046658d35efcf0c34","b76dd0d4c6