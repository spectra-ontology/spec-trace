{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44353},{"literal_text_all_w_t_and_m_t":"–End of NR-InterNodeDefinitions","paragraph_zero_based":44354},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44355},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-INTER-NODE-DEFINITIONS-END-START","paragraph_zero_based":44356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44357},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":44358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44359},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-INTER-NODE-DEFINITIONS-END-STOP","paragraph_zero_based":44360},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44362},{"literal_text_all_w_t_and_m_t":"12Processing delay requirements for RRC procedures","paragraph_zero_based":44363},{"literal_text_all_w_t_and_m_t":"The UE performance requirements for RRC procedures are specified in the following tables. The performance requirement is expressed as the time in [ms] from the end of reception of the network -> UE message on the UE physical layer up to when the UE shall be ready for the reception of uplink grant for the UE -> network response message with no access delay other than the TTI-alignment (e.g. excluding delays caused by scheduling, the random access procedure or physical layer synchronisation). In case the RRC procedure triggers BWP switching, the RRC procedure delay is the value defined in the following table plus the BWP switching delay defined in TS 38.133 [14], clause 8.6.3.","paragraph_zero_based":44364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44365},{"literal_text_all_w_t_and_m_t":"Figure 12.1-1: Illustration of RRC procedure delay","paragraph_zero_based":44366},{"literal_text_all_w_t_and_m_t":"Table 12.1-1: UE performance requirements for RRC procedures for UEs","paragraph_zero_based":44367},{"literal_text_all_w_t_and_m_t":"Procedure title:","paragraph_zero_based":44368},{"literal_text_all_w_t_and_m_t":"Network -> UE","paragraph_zero_based":44369},{"literal_text_all_w_t_and_m_t":"UE -> Network","paragraph_zero_based":44370},{"literal_text_all_w_t_and_m_t":"Value [ms]","paragraph_zero_based":44371},{"literal_text_all_w_t_and_m_t":"Notes","paragraph_zero_based":44372},{"literal_text_all_w_t_and_m_t":"RRC Connection Control Procedures","paragraph_zero_based":44373},{"literal_text_all_w_t_and_m_t":"RRC reconfiguration","paragraph_zero_based":44374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["de038db982e8994dfa5f274ccb5290f81adca4a1d75a004767d29e6f60560e16","9a9a04a932a247ba9bb09d1ae187cb8fd6e6443029db27fdb29361e0c1de8111","e321fd87d6ea0fcf304a75b5040757d494d95a22745697bb264be6a47ecf8bab","928803d8bc90c08c4f65d179e9c13052f6f31975d77b409e5a4a8d7e9f463c96","f994cff6bd76d58e8172891fb059bdfad0a164dab48c0638b772e9a14d9847a0","f4d0b76a8bbf9f85f29f72c1592549d42b91e32996a7fa3502d29be772c0566c","b31f06ec755765959c9ce88f3d7f5e86d2f00e94671efc35c6cc844d05d42c24","2fe21607b31efdcd04fd11341a5ea380596131035b78f9f17ee32ce7b93b9a0f","747c6062eeb38efcd3d37eb3ac2c02f03296a990000494f747150bcc2c28740b","7d3184f4d9b9782a6ee2a09cdae711582b9f489a4bbace2fd50d50e34dae46c9","357e84d74a9420568472efe5c7bdd192c9fa9ea453efdcdb15fc22310056f3e3","640039584cf3c9ad2f74b1eb59dedbc53f379076e3989f9dc15fb68cc7d59