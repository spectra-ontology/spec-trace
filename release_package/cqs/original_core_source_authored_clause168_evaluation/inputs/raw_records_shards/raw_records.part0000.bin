{"fields":{"filename":"R2-2301174.zip::R2-2301174 - CR3873 Correction for Uu message transfer procedure.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.8.9.8.3Reception of RemoteUEInformationSidelink message by the L2 U2N Relay UE","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"1>if the RemoteUEInformationSidelink includes the sl-PagingInfo-RemoteUE:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_CONNECTED on an active BWP with common search space configured including pagingSearchSpace; or","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_IDLE or RRC_INACTIVE:","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"3>if the sl-PagingInfo-RemoteUE is set to setup:","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"4>monitor the Paging message at the L2 U2N Remote UE's paging occasion calculated according to sl-PagingIdentityRemoteUE and sl-PagingCycleRemoteUE included in sl-PagingInfo-RemoteUE;","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"3>else (the sl-PagingInfo-RemoteUE is set to release):","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"4>stop monitoring the Paging message at the L2 U2N Remote UE's paging occasion;","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"4>release the received paging information in sl-PagingInfo-RemoteUE;","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"2>else (the UE is in RRC_CONNECTED on an active BWP without pagingSearchSpace configured):","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"3>if the sl-PagingInfo-RemoteUE is set to setup:","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"4>include the received sl-PagingIdentityRemoteUE in SidelinkUEInformationNR message and perform Sidelink UE information transmission in accordance with 5.8.3;","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"3>else (the sl-PagingInfo-RemoteUE is set to release):","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to release the sl-PagingIdentityRemoteUE in SidelinkUEInformationNR message in accordance with 5.8.3;","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"4>release the received paging information in sl-PagingInfo-RemoteUE;","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"1>if the RemoteUEInformationSidelink includes the sl-RequestedSIB-List:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"2>if the sl-RequestedSIB-List is set to setup:","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"3> if the L2 U2N Relay UE has not stored a valid version of SIB(s) indicated in sl-RequestedSIB-List:","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"4>perform acquisition of the system information indicated in sl-RequestedSIB-List in accordance with 5.2.2;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"4>perform the Uu message transfer procedure in accordance with 5.8.9.9;","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"4>perform the Uu message transfer procedure in accordance with 5.8.9.9;","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"2>if the sl-RequestedSIB-List is set to release:","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"69376c1fd5ef3c9aea92699c51af06f4a06428eaee9e91442d75fc66631908ad","original_member_sha256":"c9aa1d0527b4fe5eea731f1043e789b41def2d627cb2e14372615f94d2cfd618","paragraph_ElementTree_utf8_XML_sha256":["f382da5b4792c4df6d68858fd455af570dfdf89cc9cc031ab2bcdab4257