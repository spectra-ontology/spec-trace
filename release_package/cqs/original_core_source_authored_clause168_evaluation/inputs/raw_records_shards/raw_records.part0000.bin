{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1537},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1539},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-AssistanceData field descriptions","paragraph_zero_based":1540},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ReferenceInfo","paragraph_zero_based":1541},{"literal_text_all_w_t_and_m_t":"This field specifies the IDs of the assistance data reference TRP.","paragraph_zero_based":1542},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataList","paragraph_zero_based":1543},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS resources for each frequency layer. ","paragraph_zero_based":1544},{"literal_text_all_w_t_and_m_t":"nr-SSB-Config","paragraph_zero_based":1545},{"literal_text_all_w_t_and_m_t":"This field specifies the SSB configuration of the TRPs.","paragraph_zero_based":1546},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PositioningFrequencyLayer","paragraph_zero_based":1547},{"literal_text_all_w_t_and_m_t":"This field specifies the Positioning Frequency Layer for the nr-DL-PRS-AssistanceDataPerFreq field.","paragraph_zero_based":1548},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataPerFreq","paragraph_zero_based":1549},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resources for the TRPs within the Positioning Frequency Layer.","paragraph_zero_based":1550},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":1551},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resource ID to uniquely identify a DL-PRS Resource, and is associated with a single TRP.","paragraph_zero_based":1552},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":1553},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the TRP. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":1554},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":1555},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, as defined in TS 38.331 [35]. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":1556},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":1557},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":1558},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-SFN0-Offset","paragraph_zero_based":1559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["d49aad6c85bd8825aea0d9643f9ae7b41bf751089f2fd1609b3f74faa6ecd355","9076a3e1dd20adaba1fe36af4341394a9e7a09ef7176d4d1da1c133128933ce9","198066b8bf4954e3dd2ea3d70299e29c89878a9cc122e46de2716d3be8534e18","90bfd91b8c150cdd7f36fecc8da173a96e90c5378efbf0a49b99f9d5fffac9f4","0aa0d7ccd19173d6cf540ab0c33e14dde1de1aa083467aadbfddf508226b2738","62aae1fd724461e3b6c166ec3809c6d8ca8d0f3dd08d8dad644fd52206ad4bd0","404627824369c3a4a7db0cbbbe57de1f596bb97650687eddc48e70644af0f12d","6fb5d107cdf6217496ac51ab2e6527c5f4d2b0c84aca641670adfdbf4262e9bb","9357c0b7fd3afb03ab07c791a1827dd0a7579883e31ceea5a3ba2ca646266e0c","cd36c56443d14f3bc7ccbd7fabf1a270f6c3f3b65c8a93408b000bfdbd612aa5","6a2333b132b5d12f045ee99145c6158df4a54c5962dd286cfda14f3edda3fb32","cccabb5784deda23408313eef8234c4b6e9607cc193c580b995db09e8380c98b","e1a896074dd5308dbc923f829a2446e0a065d1621e0fc72497c337fe072fee08","8d7031e24d2819f5ff067f47284adbfcf35e066504f3636a6f41fa2d14377b5d","59cc6dcde0bb2b421cc09dba7a68d382ce2ac5e521796f1dfc96f1d661efe76c","3c8cadc694fe8b328ff0e5e5116290b8870aff70952b5d12cdeca5e3f087441e","8347432cc257de7a1d5c81aa647cbed71e343dcbb5c0bb18ae32d517661206bc","fe69ec0b6c380931a751159a0b48ee539ed32c64e08f7c52fe3acd70810d2d90","c73ccd8fe0e54d9923e23c934db806e77eb891f6587af145ebd972cda20ec381","cc0b10568f9a0d1b6dacfdea36e4b68ec9788a5dd5053177a070c01732ef3169","6bcc678ba3aeac7962ba9ba4078b4b1bc44209295ab9055457578b57721a4a0b","def37f9db27eeefa742f4322232e7e511aff8649b12af6cc6bdb7ac557aa687b","fb32f7ee391ab63400b034c0a44f2f61896d8732704fc45a1a9e7794d4e7c4ef","f4c7395c3847ccea393b2f3c32346db60b60cae5dda07d59046438c0cebb700c"],"paragraph_range_zero_based":[1536,1559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1536"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the time offset of the SFN#0 slot#0 for the given TRP with respect to SFN#0 slot#0 of the assistance data reference TRP and comprises the following subfields:","paragraph_zero_based":1560},{"literal_text_all_w_t_and_m_t":"-sfn-Offset specifies the SFN offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP.","paragraph_zero_based":1561},{"literal_text_all_w_t_and_m_t":"The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of the assistance data reference TRP to the beginning of the closest subsequent radio frame #0 of this neighbour TRP.","paragraph_zero_based":1562},{"literal_text_all_w_t_and_m_t":"-integerSubframeOffset specifies the frame boundary offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP counted in full subframes.","paragraph_zero_based":1563},{"literal_text_all_w_t_and_m_t":"The offset is counted from the beginning of a subframe #0 of the assistance data reference TRP to the beginning of the closest subsequent subframe #0 of this neighbour TRP, rounded down to multiples of subframes.","paragraph_zero_based":1564},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD","paragraph_zero_based":1565},{"literal_text_all_w_t_and_m_t":"This field indicates the RSTD value that the target device is expected to measure between this TRP and the assistance data reference TRP. The nr-DL-PRS-ExpectedRSTD field takes into account the expected propagation time difference as well as transmit time difference of PRS positioning occasions between the two TRPs. The resolution is 4Ts, with Ts=1/(15000*2048) seconds.","paragraph_zero_based":1566},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD-Uncertainty","paragraph_zero_based":1567},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty in nr-DL-PRS-ExpectedRSTD value. The uncertainty is related to the location server′s apriori estimate of the target device location. The nr-DL-PRS-ExpectedRSTD and nr-DL-PRS-ExpectedRSTD-Uncertainty together define the search window for the target device.","paragraph_zero_based":1568},{"literal_text_all_w_t_and_m_t":"The resolution R is","paragraph_zero_based":1569},{"literal_text_all_w_t_and_m_t":"-Ts if all PRS resources are in frequency range 2,","paragraph_zero_based":1570},{"literal_text_all_w_t_and_m_t":"-4Ts otherwise,","paragraph_zero_based":1571},{"literal_text_all_w_t_and_m_t":"with Ts=1/(15000*2048) seconds.","paragraph_zero_based":1572},{"literal_text_all_w_t_and_m_t":"The target device may assume that the beginning of the subframe for the PRS of this TRP is received within the search window of size","paragraph_zero_based":1573},{"literal_text_all_w_t_and_m_t":"-[-nr-DL-PRS-ExpectedRSTD-UncertaintyR ; nr-DL-PRS-ExpectedRSTD-UncertaintyR] centred at TREF+1 millisecondN+nr-DL-PRS-ExpectedRSTD4Ts,","paragraph_zero_based":1574},{"literal_text_all_w_t_and_m_t":"where TREF is the reception time of the beginning of the subframe for the PRS of the assistance data reference TRP at the target device antenna connector, and N can be calculated based on","paragraph_zero_based":1575},{"literal_text_all_w_t_and_m_t":"-nr-DL-PRS-SFN0-Offset","paragraph_zero_based":1576},{"literal_text_all_w_t_and_m_t":"-dl-PRS-Periodicity-and-ResourceSetSlotOffset","paragraph_zero_based":1577},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ResourceSlotOffset.","paragraph_zero_based":1578},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-Info","paragraph_zero_based":1579},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS configuration of the TRP.","paragraph_zero_based":1580},{"literal_text_all_w_t_and_m_t":"dl-PRS-SubcarrierSpacing","paragraph_zero_based":1581},{"literal_text_all_w_t_and_m_t":"This field specifies the subcarrier spacing of the DL-PRS Resource. 15, 30, 60 kHz for FR1; 60, 120 kHz for FR2. All DL-PRS Resources and DL-PRS Resource Sets in the same Positioning Frequency layer have the same value of dl-PRS-SubcarrierSpacing.","paragraph_zero_based":1582},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":1583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["54f41f69c1ec78fe2957a91320c2682604180aff5e513fe6072c3621a2660040","5d8834d96301d3eb8c7b0d4901aedfa91ed0447c78cb62d41f83b573127ea6c2","b3aaeca2a5639688940dbace396da86f62a9e60ee5537a568e8f0e6e2902290f","6b101a52a02ee19d659ab2ece9004615f36d5428592dc44de4326a5a5b34a6e9","85d43b39df3848039b0868454a3f374d9a0402629cbd8444016789fcacd12658","1fcf2edbf1b4d6b02d2923e7a59a9215e342c5e9daf9b03af376c63c9ee8b34b","db3bb965883cfdf53b9e2180724ab5937d0077301a77a328baeeff216c54f729","1b646c2cbaf5125aa0719ce2d9fe61bdec2c0357911fc6e5ed9b98c42125643f","b58c322cfcccb85676b1038506a8648fb13b177cff6097c8a14bfaf52a2e5c94","80e5268a8a8d2178f1a64ff6a3e4efc0b737e6a42c47d8643c70e3fbfba52d68","2a6a3e43084f4c02c640caf27c85a2280f78c17d852cc9fe264dee3e1d368aef","ccf3ebb2acc818e867a238a8b173e7bf78ef95dc6f12ee6ccbd9ff9637596e56","08f2b0ee8531f0c0706ffb8cf83d32f3f605781e92185364f11a5458febb6b64","c5b1994a24299930f053101568c10fd504e0c0e2adecd032f3a174b674a55b7b","4b7629896b58ffb946e7e3e64227efa4eebd283b07bec795ffbc4d75dfefa27d","6301ca09cefdaea3ba35823c2890e38d982378b947d35a13590f37b62358d295","f5a65a2b0294efe951a386855b64b210dc98ffe7e3994139da891d97024f70a0","5bd30dd25c1768a8dc85db99f183aad9dd81289f29b6f68618e61a65daee843d","3efa11db76ac48d0f68d2326c6241e5cb01a289921d8944c66be6c6e7d846cfe","7a7e1b4ab7c04fa9ef94f357e6bfa7adc5fc2f3078a82caa933349a9bbaf3345","c4513397e8bf468734d4ea8e8c5e87ab33fa7ad791d514f083fea55bdd5d6e85","36a6b97f2c14faf951886028b02404c8cbbb4100aee750580c59aa57fba4561c","4206df0a217b9041e50876f68b41bcb550356b1be194a2c1ebb7acf4bda6bb05","89aef4659b8d44f3a09833d5bc90fcfcf3b4373a0a855b488be5b7b9485f8c3f"],"paragraph_range_zero_based":[1560,1583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1560"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs. All DL-PRS Resources of the DL-PRS Resource Set have the same bandwidth. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of DL-PRS Bandwidth and Start PRB.","paragraph_zero_based":1584},{"literal_text_all_w_t_and_m_t":"Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":1585},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":1586},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to reference DL-PRS Point A for the Positioning Frequency Layer. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-StartPRB.","paragraph_zero_based":1587},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":1588},{"literal_text_all_w_t_and_m_t":"This field specifies the absolute frequency of the reference resource block for the DL-PRS. Its lowest subcarrier is also known as DL-PRS Point A. A single DL-PRS Point A for DL-PRS Resource allocation is provided per Positioning Frequency Layer. All DL-PRS Resources belonging to the same DL-PRS Resource Set have the same DL-PRS Point A.","paragraph_zero_based":1589},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN","paragraph_zero_based":1590},{"literal_text_all_w_t_and_m_t":"This field specifies the Resource Element spacing in each symbol of the DL-PRS Resource. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of comb size N.","paragraph_zero_based":1591},{"literal_text_all_w_t_and_m_t":"dl-PRS-CyclicPrefix","paragraph_zero_based":1592},{"literal_text_all_w_t_and_m_t":"This field specifies the Cyclic Prefix length of the DL-PRS Resource. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-CyclicPrefix.","paragraph_zero_based":1593},{"literal_text_all_w_t_and_m_t":"prs-OnlyTP","paragraph_zero_based":1594},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the NR-DL-PRS-AssistanceData is provided for a PRS-only TP. Whether the field is present or absent should be the same for all the NR-DL-PRS-AssistanceData of all the PRS transmitted under the same TP.","paragraph_zero_based":1595},{"literal_text_all_w_t_and_m_t":"The target device shall not assume that any other signals or physical channels are present for the TRP other than DL-PRS.","paragraph_zero_based":1596},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA","paragraph_zero_based":1597},{"literal_text_all_w_t_and_m_t":"This field specifies the expected AoD or AoA in the Global Coordinate System (GCS) at the target device location together with uncertainty.","paragraph_zero_based":1598},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoD: This field specifies the expected azimuth angle of departure.Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":1599},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoD-Unc: This field specifies the (single-sided) uncertainty of the expected azimuth angle of departure. If this field is absent, it indicates maximum uncertainty (60 degrees).Scale factor 1 degree; range 0 to 60 degrees.","paragraph_zero_based":1600},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoD: This field specifies the expected elevation angle of departure.Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":1601},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoD-Unc: This field specifies the (single-sided) uncertainty of the expected elevation angle of departure. If this field is absent, it indicates maximum uncertainty (30 degrees).Scale factor 1 degree; range 0 to 30 degrees.","paragraph_zero_based":1602},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoA: This field specifies the expected azimuth angle of arrival. Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":1603},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoA-Unc: This field specifies the (single-sided) uncertainty of the expected azimuth angle of arrival. If this field is absent, it indicates maximum uncertainty (60 degrees).Scale factor 1 degree; range 0 to 60 degrees.","paragraph_zero_based":1604},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoA: This field specifies the expected elevation angle of arrival. Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":1605},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoA-Unc: This field specifies the (single-sided) uncertainty of the expected elevation angle of arrival. If this field is absent, it indicates maximum uncertainty (30 degrees).Scale factor 1 degree; range 0 to 30 degrees.","paragraph_zero_based":1606},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["9a2ddb671477b087ab2bc391e755dedea1fccfd1eb69928f687e432fc144e9d9","51fa9ea06928e33d816e89d74fcb603d0f4633f297e09fec2523c947b6fdebb2","53a73301a1f83e945d5502072b2211d999c1c7ff3f4c8134d443ba43f070e78c","eb4c57adddf7f2e60ffeec0a4721bc3449464fb76aa0647e727b41d364cbf7b1","108fa2e7faea87d0c349b273726e1a5c427da9fd8b24466cd9e7dc93ef269916","81e47cd4c4dc169c71d75052a2c25cecee349db21ea295b8cf3cb225e547c4a5","8c60e570b4d0654fe534d7ac