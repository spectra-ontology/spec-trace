6fd31a2ac22a7df927bc8605a61b94bae43f","9ca7216927ebbf69d179752602eec03af881b758c8263d6f0c1a186da621653a","c59c3fd5a534da95f68d8a18081e1d558b795338f00dbaa623168b0b622f3944","a4c50a6d52bbb3c2d743466cd5fa77e69f3c2b81af5999acd9691c6b977812ea","195ce46fe80a6ffea127efc5ae232c9ccbcfef1fb0e394bdbb53d0a11af0e9d0","0ce4abfece22ac9218563f29a335eef5d0f373b3569d8e81c1241cf00152ff14","eab1226e6ed6c54e764b16a289b5e489d1ac304c78e24a84604e52bacef41bfc","724c5a02c6d7c5fc86556b036a36305152e34d2425147dfe3fee6a879464fa1e","f249f4daf1aab0d091c27edf064886b4b6dfa0b9e1cbd5322b0ddc4bf9f624f4"],"paragraph_range_zero_based":[1608,1631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1608"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1633},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1635},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-RequestLocationInformation field descriptions","paragraph_zero_based":1636},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RstdMeasurementInfoRequest","paragraph_zero_based":1637},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device is requested to report DL-PRS Resource ID(s) or DL-PRS Resource Set ID(s) used for determining the timing of each TRP in RSTD measurements.","paragraph_zero_based":1638},{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements","paragraph_zero_based":1639},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-TDOA measurements requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested.","paragraph_zero_based":1640},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability","paragraph_zero_based":1641},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device may request additional PRS assistance data from the server. TRUE means allowed and FALSE means not allowed.","paragraph_zero_based":1642},{"literal_text_all_w_t_and_m_t":"additionalPaths","paragraph_zero_based":1643},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathList in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPathsExt shall be absent.","paragraph_zero_based":1644},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-Request","paragraph_zero_based":1645},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-UE-Rx-TEG-ID in IE NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":1646},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest","paragraph_zero_based":1647},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the indicated type and granularity of the estimated LOS-NLOS-Indicator in the NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":1648},{"literal_text_all_w_t_and_m_t":"additionalPathsExt","paragraph_zero_based":1649},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathListExt in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPaths shall be absent.","paragraph_zero_based":1650},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request","paragraph_zero_based":1651},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-DL-PRS-RSRPP for the additional paths in fields nr-AdditionalPathList or nr-AdditionalPathListExt.","paragraph_zero_based":1652},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport","paragraph_zero_based":1653},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide multiple measurement instances in a single measurement report; i.e., include the nr-DL-TDOA-SignalMeasurementInstances (in the case of UE-assisted mode is requested) or nr-DL-TDOA-LocationInformationInstances (in the case of UE-based mode is requested) in IE NR-DL-TDOA-ProvideLocationInformation.","paragraph_zero_based":1654},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSTD-MeasurementsPerTRP-Pair","paragraph_zero_based":1655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["218c1ac8dbde5452d66554147620b59015d2a586b3f5d5fbc22c9446296abc43","d0d135c09278c78a943ccc3112009b7c28d9f23aea521adcf223719571ecf2c6","c8da459bd0b806b271ba2571d56c0ab33fc6d1c5e289ece434992627115fe862","c000c9fadf3e5029c94a4978b6ce0607c3c7cf080adb0d8361edeba01e575421","3101f2b3a20f09f782d456e3b2a1716fbc310e6121fad7011c3c83b182878e9b","b2eec399ac5cd38ba632bc6b27e25a29e60b9b6c8d6dac68bb8fa63b76f16a32","90d2295578cf6bf2be5101d072f60b3a110b286a7cbaf36b3efacc6e7120d4ed","4ea86d0bd61dc081c9815d95eb80a7d0d23fe2f4f77e6ea50584380d2fa01737","a6e0af032ba123d77b508a3c2c3a476ba4b77ed415d980c93c167762ef8a2023","ca52ae93671560e56501082d88539134312059a10104b2866515e5c259d8fe1f","f9da6cd17f227ee5343cd6c0bf99a5a1a93404774e1b097d95304c20aa5e0010","dfb55568db846c7825a2d270090da04cb4eb887893bfb00a4627c40a8b2d668e","5564f52e7c644509f3041af8cb4d74ff4c67f17c15fa50690cf8c6fe3536ef33","328ce5303d1973564ee53990dfa8ea11d054a5d0d66ecfa93254db5bb28fbf78","2398b2ebfcfbdf3d673cd76162f3c9209e0150f5c0a4e2b32c3b5858d0f7ee3b","3b63af3a4c21b2165ba5fdbeee0e262e3b57fec536d546ab3c9ce1b166df3e32","e3ced1478e7a6e771a30e466dd1bd98d1c2f4e363dda67987e7f77bc1d9cc548","aa96614b764e83e6e87990aee75ec4521f3ce2c36119058f3700bce01f677bd2","174a3ac2deb59e996cbe91e94188766fd7d89b7b13a25ce03d4e784356990bf8","c11b8e0d11daa6f964ba7a092eb2161949c41138f202d46ba96ea6bbb9c0b26e","0f99c4a9709b7f53c9360408085e2cda782b93e6ac7c04d65c04c4e58a90ce11","32f17798d99f84d30ebe71da4a6148a61cd54acac7cf74ee9239238f5d87e800","f56cd62970c7475c810babda044c2b4b62838bb7953f9fff3e3c1f79330fe5d0","c2df9e3edcf1c7e0e3966725aff0b6f0a636b2974d4e6434e42abae7244f5159"],"paragraph_range_zero_based":[1632,1655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1632"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of DL-PRS RSTD measurements per pair of TRPs. The maximum number is defined across all Positioning Frequency Layers.","paragraph_zero_based":1656},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor","paragraph_zero_based":1657},{"literal_text_all_w_t_and_m_t":"This field specifies the recommended reporting granularity for the DL RSTD measurements. Value (0..5) corresponds to (k0..k5) used for nr-RSTD and nr-RSTD-ResultDiff in NR-DL-TDOA-MeasElement. The UE may select a different granularity value for nr-RSTD and nr-RSTD-ResultDiff.","paragraph_zero_based":1658},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs","paragraph_zero_based":1659},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with N different UE Rx TEGs. Enumerated value 'n0' indicates that the number N of different UE Rx TEGs to measure the same DL PRS Resource can be determined by the target device, value 'n2' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 2 different UE Rx TEGs, value 'n3' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 3 different UE Rx TEGs, and so on.","paragraph_zero_based":1660},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-UE-RxTEG-Request should also be present.","paragraph_zero_based":1661},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples","paragraph_zero_based":1662},{"literal_text_all_w_t_and_m_t":"This field, if present and set to 'requested', indicates that the target device is requested to perform the requested measurements with reduced number of samples (M=1 or M=2) as specified in TS 38.133 [46].","paragraph_zero_based":1663},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2","paragraph_zero_based":1664},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability.","paragraph_zero_based":1665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1666},{"literal_text_all_w_t_and_m_t":"6.5.10.6NR DL-TDOA Capability Information","paragraph_zero_based":1667},{"literal_text_all_w_t_and_m_t":"–NR-DL-TDOA-ProvideCapabilities","paragraph_zero_based":1668},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-TDOA-ProvideCapabilities is used by the target device to indicate its capability to support NR DL-TDOA and to provide its NR DL-TDOA positioning capabilities to the location server.","paragraph_zero_based":1669},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1671},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-ProvideCapabilities-r16 ::= SEQUENCE {","paragraph_zero_based":1672},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-Mode-r16PositioningModes,","paragraph_zero_based":1673},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-PRS-Capability-r16NR-DL-PRS-ResourcesCapability-r16,","paragraph_zero_based":1674},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-MeasurementCapability-r16NR-DL-TDOA-MeasurementCapability-r16,","paragraph_zero_based":1675},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-QCL-ProcessingCapability-r16NR-DL-PRS-QCL-ProcessingCapability-r16,","paragraph_zero_based":1676},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ProcessingCapability-r16NR-DL-PRS-ProcessingCapability-r16,","paragraph_zero_based":1677},{"literal_text_all_w_t_and_m_t":"additionalPathsReport-r16ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":1678},{"literal_text_all_w_t_and_m_t":"periodicalReporting-r16PositioningModesOPTIONAL,","paragraph_zero_based":1679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["5c36fde8c61a419d1c0ec5085766f38297d77e6f0fb5dae25104e991b6afb8f2","980176b8043470806d7fa4a6621fb4b41756de887f4de7cadec789c629822d29","f27527b38128baa5ffbf91b18c1f8b3d503058cfe624905e936bb550e4d7919a","27f3674a3bf6ace03e1b93df1a188ec4defa96dbec2868ce55df7cbabfebe0fe","3ece5fb35d3df24b94197ebbaab785d814e50808858a7e64ccd91b2d04c751e3","6d4682088629454a739d19c6c2c2ac526ba3861c7c436eb2af9289a5593bd00e","de039b0bd3a198cc4d3c5eba5e413362565aca93b22d7c36b06efc6d1ec2aebf","d875f493d4179845c9796a22202287f226df7f1a6de5b691bd4d2877b6588659","2e5522a3a38371499d6555ba10fbf4604652ca08272b153e43a8f6b4bf32a3ef","d5f8e90379ca5784c38adde5d3c8352afd47152bf634996932bae2c65b9e6cb3","39d99f00993363113eb0664c045be76846c1f3a695ee00d39673d5cbac84bcb1","508e816ce98e2c909a2a05ac7522e6c342250f70b5c0fc069584d47e219aac21","84f2e64e86a29c7358ec51b37953c85e0f83d7062d4f5ba1803d83e8440d7973","12de45fd618e6e86d7e4789c10bde98ec61d93e39e6f7994af55d935b5a3fd96","9eaa77fbd76ad5cea1819cdcc07e3ab792f690312cbf0a2c24901e0342e5d55a","0bef307561ba1181932c3d93910b68de1e4eef135c9f52252054edda349f68c7","9e050e0273e5caa221b5db3790b250d1039158ddcbb8005d4d9bb85579c3587b","57eec0e7228ca782bdf05f873929c0590cbf00b7deb3ccae9b5fd0846c5340aa","ab3a160e730ed50217b8c08386ae7f5bff8df8750adf25aa136f2bb9cfcb77a1","b3e4fcfd416de52bf9d1e28331582ee415f94da966ee26d8c1c5530607f12ee8","f9e37c8c43b1a0d44ad111849ce53e796182aa2d6bac7687411ee21c526fce1c","7aa1bd0300b093400e59628bb5d0b476538c2b38211bc514d3d782ffe399a55d","a13cb504ac90f1d778817cda5a0a2753c34b3c0d17d57b1763533571291128f2","abd89dcf0607625a4390052fd031ac663602aa09c71e47416f6f7df46553295a"],"paragra