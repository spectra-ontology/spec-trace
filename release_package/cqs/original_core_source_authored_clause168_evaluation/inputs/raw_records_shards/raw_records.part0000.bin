{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36672},{"literal_text_all_w_t_and_m_t":"–BT-NameList","paragraph_zero_based":36673},{"literal_text_all_w_t_and_m_t":"The IE BT-NameList is used to indicate the names of the Bluetooth beacon which the UE is configured to measure.","paragraph_zero_based":36674},{"literal_text_all_w_t_and_m_t":"BT-NameList information element","paragraph_zero_based":36675},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36676},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-START","paragraph_zero_based":36677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36678},{"literal_text_all_w_t_and_m_t":"BT-NameList-r16 ::=                SEQUENCE (SIZE (1..maxBT-Name-r16)) OF BT-Name-r16","paragraph_zero_based":36679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36680},{"literal_text_all_w_t_and_m_t":"BT-Name-r16 ::=                    OCTET STRING (SIZE (1..248))","paragraph_zero_based":36681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36682},{"literal_text_all_w_t_and_m_t":"-- TAG-BTNAMELIST-STOP","paragraph_zero_based":36683},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36685},{"literal_text_all_w_t_and_m_t":"BT-NameList field descriptions","paragraph_zero_based":36686},{"literal_text_all_w_t_and_m_t":"bt-Name","paragraph_zero_based":36687},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs Bluetooth measurements according to the names identified. For each name, it refers to LOCAL NAME defined in Bluetooth specification [51].","paragraph_zero_based":36688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36689},{"literal_text_all_w_t_and_m_t":"–DedicatedInfoF1c","paragraph_zero_based":36690},{"literal_text_all_w_t_and_m_t":"The IE DedicatedInfoF1c is used to transfer IAB-DU specific F1-C related information between the network and the IAB node. The carried information consists of F1AP message encapsulated in SCTP/IP or F1-C related (SCTP)/IP packet, see TS 38.472 [64]. The RRC layer is transparent for this information.","paragraph_zero_based":36691},{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c information element","paragraph_zero_based":36692},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36693},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-START","paragraph_zero_based":36694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3884856a5a45006074aaf498270703fec53b714e189f8e74d446177d87462cd5","5d9121cec24ba14a83de211044d2317aa7f40d751547d0504c4fcd91c3ae06a1","77f5c1c05976b3109c673e1c8f97abea16438ecb5145100917e8c2f1cac22d0e","b8025a6e9331e130e2d989fa6b3ac7bd8b72e3bbfa9b5c95940ac935b1fa3446","80efb4618898b63c4108a413b8e919c4110f267fe5f3a4c1618bfa48d62a61bb","1cc8a51a7a4456400f49f5e8d2e8784758be31005fd206cfc34241949efbbded","fb8ad4bf45d00f875dd0c2fced109a57db9cef2919a2a79ed9d65e1cc6329d41","ba49a4911983b49fb254f6e4e767e26638e94746a61b26d83007314c061b096e","e03e4b5408bc989f86dfae9426f9cc46e0f90918a7826be40181a6812e18fd86","23c25683fda01d3d0386ee076dde67c21baceee28c0f6210ce36c2891058b25d","39864b9d2a52f48f30d5a3f0c1546276e8a2803ddc3d10b8ee149f4d45b77300","dab197fa5fda38df4fe59037d636dea1e8550238bc4fdd70a256f154e64b9d42","d310dc2c6648cf96c672182e874ba47df314cedce1956bec487a6d8aba151aaf","c529bd5d51c628d0eb7d8d774137e8839edc2575a776807ee38265036aa10fc6