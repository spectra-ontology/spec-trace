{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"gNB-SideRTT-BasedPDC-r17","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports gNB-side RTT-based PDC, as specified in TS 38.300 [28]. A UE supporting this feature shall also support rtt-BasedPDC-CSI-RS-ForTracking-r17 and/or rtt-BasedPDC-PRS-r17.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"inactiveState","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RRC_INACTIVE as specified in TS 38.331 [9].","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"inactiveStateNTN-r17","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports RRC_INACTIVE in NTN as specified in TS 38.331 [9]. It is mandated if the UE indicates the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"inactiveStatePO-Determination-r17","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports to use the same i_s to determine PO in RRC_INACTIVE state as in RRC_IDLE state.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["ad6ea23b4a311e3970d0b8ba5f7fe999f262ac29125769dcbf672dd6ce674e66","366aeb2e56965193b365075d36a748c8887a6de3b93340175330a7818394b12f","8e26835601d64dbc4b4a3e7f2d3eb1c0a45c86cdcf20d741b6c5e98d0f477d41","92a2a83e8c239742341f873110f9edfcb1b14c72fb8494d45348ec1e50ed4d91","5846a60cbaee63b77f7f9100e43a7330431d65df5f96f6240b69d66cb8daf58d","8f804189b4cc198c4bcf7ca4ca34b628ea99a3842539f9d6a1e295ba92875d9b","cbe4ecdde7c11b2953a261e6b40a6f331568626bc5633ee3281818a3210d8902","9441fa08bdecc4f6cca8ab69c691a61417b365fbf0dcd545d250291484b97445","34c35260cae3416e1da8bfb5ea8e7d224bbe20b3cf7107d677dac2054ba183d1","68ba0f5c58e9ae33a9ea51622a274fa17b40e8b4a86fb8a7e97b57b19b12d25b","ea043e568d905af88a1b5a7fa2b0edf442aed9093de853aebb46faccf387547e","15da0669336431426551310d02bb2ade80934ec24123a38ed18055525bce2f32","3a323fa4e7eebd5fc6a3d25b336de2ce58d8b30202dd9f49a68b27545f82825d","bcbcc3b5da0cc8b26d7c7718461c236b09e369dafae705b1a6b9379eba184f96","0db9eecda73273894d827f71b4c9bcd1cbf2d15e79f06351822b1352353302b6","7ffd295ae429206e39e6e5fd4e364cc2ccb944007f0b5d954907e80ad0a9cf58","8dff48ad0b6df2ab5154ab068be406b4e1e39b1301fe6ed9c5cf2a96fea17b16","7e2e06a9852b3a5ba742ac9034ca18846c5f1fa08ffd137e77c93e60186f7071","d74dba1f0abde4ce96a61fe4ca26df35e05597a477a99c7a0a7be1a07f8f9d22","6d278ca2679d27e95f2a3790281c614ce46ab3