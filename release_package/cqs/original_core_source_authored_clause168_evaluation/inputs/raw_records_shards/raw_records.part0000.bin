{"fields":{"filename":"R2-2301167.zip::R2-2301167 - CR3872 Correction for receiving PC5 link release during path switching.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"2>release spCellConfig, if configured;","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"2>suspend all RBs, and BH RLC channels for IAB-MT, and Uu Relay RLC channels for L2 U2N Relay UE, except SRB0 and broadcast MRBs;","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"2>release the MCG SCell(s), if configured;","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"2>if MR-DC is configured:","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"3>perform MR-DC release, as specified in clause 5.3.5.10;","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"2>release delayBudgetReportingConfig, if configured and stop timer T342, if running;","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"2>release overheatingAssistanceConfig, if configured and stop timer T345, if running;","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"2>release idc-AssistanceConfig, if configured;","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"2>release btNameList, if configured;","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"2>release wlanNameList, if configured;","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"2>release sensorNameList, if configured;","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"2>release drx-PreferenceConfig for the MCG, if configured and stop timer T346a associated with the MCG, if running;","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"2>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfig for the MCG, if configured stop timer T346e associated with the MCG, if running;","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"2>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"2>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"2>release releasePreferenceConfig, if configured stop timer T346f, if running;","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"2>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"2>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"2>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"2>release obtainCommonLocation, if configured;","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3ae7382fac5a05fbdfcee0ce7ffa40cab8c9106486f09469eabd3ee9af9676d5","original_member_sha256":"22956335148b7a5c16c2b5dda19d49a29d30d34a1f02b6918ba645f49922cb03","paragraph_ElementTree_utf8_XML_sha256":["2c8ec56d5df115df889e283f8d88b8195477cc0aa6bc38b15cd302eab19bd2ce","d86d03ad6c62163cddfc648e972072dce42a31e61e2a691aa3ef1cd42e6295