{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19656},{"literal_text_all_w_t_and_m_t":"MeasIdleConfig field descriptions","paragraph_zero_based":19657},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":19658},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index.","paragraph_zero_based":19659},{"literal_text_all_w_t_and_m_t":"beamMeasConfigIdle","paragraph_zero_based":19660},{"literal_text_all_w_t_and_m_t":"Indicates the beam level measurement configuration.","paragraph_zero_based":19661},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":19662},{"literal_text_all_w_t_and_m_t":"Indicates the NR carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19663},{"literal_text_all_w_t_and_m_t":"carrierFreqEUTRA","paragraph_zero_based":19664},{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carrier frequency to be used for measurements during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19665},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":19666},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":19667},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":19668},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR idle/inactive measurement parameters apply. The UE shall select the first listed band which it supports in the frequencyBandList field to represent the NR neighbour carrier frequency.","paragraph_zero_based":19669},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":19670},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall include beam measurements in the NR idle/inactive measurement results.","paragraph_zero_based":19671},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":19672},{"literal_text_all_w_t_and_m_t":"Max number of beam indices to include in the idle/inactive measurement result.","paragraph_zero_based":19673},{"literal_text_all_w_t_and_m_t":"measCellListEUTRA","paragraph_zero_based":19674},{"literal_text_all_w_t_and_m_t":"Indicates the list of E-UTRA cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19675},{"literal_text_all_w_t_and_m_t":"measCellListNR","paragraph_zero_based":19676},{"literal_text_all_w_t_and_m_t":"Indicates the list of NR cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":19677},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListEUTRA","paragraph_zero_based":19678},{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dc098254807f99a92049051d600cf608ec1385ea7fa2b8fe8becec3605ea5f99","a6d9aa6db5ab87d58f370b7e128394881074f6e03b854991e0ff9f9a1a481433","2b4e0fd9ef69af574800744a6ba19150f7a9f3468dcd0badb6c94748af537238","20245a3d2ab6111b90be65ff729d4a8ccdc7562f6aea17ae89622889e4e485fb","4b56205ad86f7a08eceacb55cc617f892e05e1fe36a352416ff