{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27528},{"literal_text_all_w_t_and_m_t":"–ServingCellAndBWP-Id","paragraph_zero_based":27529},{"literal_text_all_w_t_and_m_t":"The IE ServingCellAndBWP-Id is used to indicate a serving cell and an uplink or a downlink BWP.","paragraph_zero_based":27530},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id information element","paragraph_zero_based":27531},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27532},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-START","paragraph_zero_based":27533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27534},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id-r17 ::= SEQUENCE {","paragraph_zero_based":27535},{"literal_text_all_w_t_and_m_t":"    servingcell-r17              ServCellIndex,","paragraph_zero_based":27536},{"literal_text_all_w_t_and_m_t":"    bwp-r17                      BWP-Id","paragraph_zero_based":27537},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27539},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-STOP","paragraph_zero_based":27540},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27542},{"literal_text_all_w_t_and_m_t":"–ServCellIndex","paragraph_zero_based":27543},{"literal_text_all_w_t_and_m_t":"The IE ServCellIndex concerns a short identity, used to uniquely identify a serving cell (i.e. the PCell, the PSCell or an SCell) across the cell groups. Value 0 applies for the PCell, while the SCellIndex that has previously been assigned applies for SCells.","paragraph_zero_based":27544},{"literal_text_all_w_t_and_m_t":"ServCellIndex information element","paragraph_zero_based":27545},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27546},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-START","paragraph_zero_based":27547},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27548},{"literal_text_all_w_t_and_m_t":"ServCellIndex ::=                   INTEGER (0..maxNrofServingCells-1)","paragraph_zero_based":27549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27550},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-STOP","paragraph_zero_based":27551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["11f981101cbd6d06a1ed456ac134f59a105f7fd049a7fa0fec72e910f79b5564","2b35d2c500cde45c17bbdd7fd4072dd3cf0d544083ea282aa2e49131c099fb8d","953139f6f983b5646b12bd92ae72dd4efc6f01129deece1d69edf60499dd8f80","5e9eb964d06fea288369c6e9a270ece0e91935232154898fe47e565d59bc3b49","ab163a2dff7bc7003d9537657f028e7203126ad1713a0c3075fda057d282d3c8","7c18ccd00007d62f29b7e9eb76540f4758348b0eaceb77a8ac2f49d2b5e4cdee","da5a945ff9ae6ca6903514500034491bb5c583641440a5f2fb3f53b445745ec9","4f69342ae915a1dc1e6b8a54ce6befdde6181fabec2c92688168ce9464ed7287","a8e0c37b66d11e209a5496804fca5fefd990e8bbe4f96a6b23a96cda58877bc8","ebdd0f39ab640e2f7895807dd28366c75e586c9c996d364699a16e5215ce31b8","30c97862e1092167e9d0157c8e9d01fbc4b6d566aaa84162964f5e99f3a86285","bceb75a138887596435c7cc89e1900c3bfe18c71c49578c5496cdb4a7d02eca6","4d2bf1d4c2a6925f57e4963485b052fd73b56234e5a09311451e71960f63df19","93647f9be96e30765c91f99251a4c7919f2508e1acc6239b307d2179313ab46c","8bc9e7b512221b0a1d52eac3e225279b0ca11bcdbdd5d43d065b3469374077df","70eda7c7d36631ce42ece3e9abc7c6377d5c7de8508ac98faefdca575481dfb0","67f1b30ec72d2d20f6f8641f60a5