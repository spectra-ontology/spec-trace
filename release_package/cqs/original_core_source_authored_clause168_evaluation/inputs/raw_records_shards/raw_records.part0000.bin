{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mbs-FreqList","paragraph_zero_based":9504},{"literal_text_all_w_t_and_m_t":"List of MBS frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":9505},{"literal_text_all_w_t_and_m_t":"mbs-Priority","paragraph_zero_based":9506},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prioritises MBS broadcast reception above unicast and MBS multicast reception. The field is present (i.e. value true), if the UE prioritises reception of broadcast services, on frequencies indicated in mbs-FreqList, above a reception of any of the unicast bearers and multicast MRBs. Otherwise the field is absent.","paragraph_zero_based":9507},{"literal_text_all_w_t_and_m_t":"mbs-ServiceList","paragraph_zero_based":9508},{"literal_text_all_w_t_and_m_t":"List of MBS broadcast services which the UE is receiving or interested to receive.","paragraph_zero_based":9509},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9510},{"literal_text_all_w_t_and_m_t":"–MCGFailureInformation","paragraph_zero_based":9511},{"literal_text_all_w_t_and_m_t":"The MCGFailureInformation message is used to provide information regarding NR MCG failures detected by the UE.","paragraph_zero_based":9512},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9513},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9514},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9515},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":9516},{"literal_text_all_w_t_and_m_t":"MCGFailureInformation message","paragraph_zero_based":9517},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9518},{"literal_text_all_w_t_an