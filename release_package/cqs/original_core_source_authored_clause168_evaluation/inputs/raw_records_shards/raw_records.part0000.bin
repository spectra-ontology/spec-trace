{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22872},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22873},{"literal_text_all_w_t_and_m_t":"    repetitionNumber-v1730                  ENUMERATED {n2, n3, n4, n5, n6, n7, n8, n16}                   OPTIONAL   -- Cond Format1-2","paragraph_zero_based":22874},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22875},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22877},{"literal_text_all_w_t_and_m_t":"Dummy-TDRA-List ::= SEQUENCE (SIZE(1.. maxNrofDL-Allocations)) OF MultiPDSCH-TDRA-r17","paragraph_zero_based":22878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22879},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TDRA-List-r17 ::= SEQUENCE (SIZE(1.. maxNrofDL-AllocationsExt-r17)) OF MultiPDSCH-TDRA-r17","paragraph_zero_based":22880},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22881},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TDRA-r17 ::= SEQUENCE {","paragraph_zero_based":22882},{"literal_text_all_w_t_and_m_t":"    pdsch-TDRA-List-r17                 SEQUENCE (SIZE(1..maxNrofMultiplePDSCHs-r17)) OF PDSCH-TimeDomainResourceAllocation-r16,","paragraph_zero_based":22883},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22884},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22885},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22886},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-STOP","paragraph_zero_based":22887},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22889},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":22890},{"literal_text_all_w_t_and_m_t":"k0","paragraph_zero_based":22891},{"literal_text_all_w_t_and_m_t":"Slot offset between DCI and its scheduled PDSCH (see TS 38.214 [19], clause 5.1.2.1). k0-v1710 is only applicable for PDSCH SCS of 480 kHz and 960 kHz. If multiple PDSCHs are configured per PDCCH, the network always configures this field. Otherwise, when the field is absent and only one PDSCH is configured per PDCCH, the UE applies the value 0.","paragraph_zero_based":22892},{"literal_text_all_w_t_and_m_t":"mappingType","paragraph_zero_based":22893},{"literal_text_all_w_t_and_m_t":"PDSCH mapping type (see TS 38.214 [19], clause 5.3).","paragraph_zero_based":22894},{"literal_text_all_w_t_and_m_t":"repetitionNumber","paragraph_zero_based":22895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5bc01c9bd65c1084dedaf1996c74fc703f2b58be2fc56257ab4a9e0b31941bd1","903dfdcc8ea1978b3a00f5e9da3d4320924701824c1887ccb678126d2ab9af58","6a302290e2d010ef5de0a4525886c1d01235e1ca2c0939b95eba84740141ab38","e5be522aaaf420c94f357b98c01f487f2abdae18ee7d9bae81bd42c0cbd3ba06","9e3f4fa90a6e61806a0e48056eab80edc1f914b34878341d0871d9a0e117fc00","6119661a59a94e06d4ed81be7b6dc86a5a1fb4e3883f2da380353ae7ecca3037","0fd35bfbaceb81aed177cc8089dd0ccec447d5c0c7f3efbc8899c7a077f4227e","e5816c6bed7e25e8d75f66b05094e29c923e1fd6557b68c252af78dc5b40058a","320b081e953709497758a89758bffa1aae2863785e0d98211e28378d7b296153","5b49c1748525c7c3ee19f296a30b37c9ab946d627c9bc2973f65f3cb5f5d74e8","6ad686c48e93dece0bec0e832fd037a5f66f9812ef58b8a46cb95de832417999","33a8ec26f6fe6290205d7e9448a289206ce7e9803e927952648bdc59492279a2","8a9a6b3eb6412f2d5563999b03656077cae8cc8377f9a8a43734d