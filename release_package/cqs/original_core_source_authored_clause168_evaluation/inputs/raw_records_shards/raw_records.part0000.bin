{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–FeatureSetCombinationId","paragraph_zero_based":32088},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetCombinationId identifies a FeatureSetCombination. The FeatureSetCombinationId of a FeatureSetCombination is the position of the FeatureSetCombination in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability). The FeatureSetCombinationId = 0 refers to the first entry in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability).","paragraph_zero_based":32089},{"literal_text_all_w_t_and_m_t":"NOTE:The FeatureSetCombinationId = 1024 is not used due to the maximum entry number of featureSetCombinations.","paragraph_zero_based":32090},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId information element","paragraph_zero_based":32091},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32092},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-START","paragraph_zero_based":32093},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32094},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId ::=         INTEGER (0.. maxFeatureSetCombinations)","paragraph_zero_based":32095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32096},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-STOP","paragraph_zero_based":32097},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32099},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlink","paragraph_zero_based":32100},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlink indicates a set of features that the UE supports on the carriers corresponding to one band entry in a band combination.","paragraph_zero_based":32101},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink information element","paragraph_zero_based":32102},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32103},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-START","paragraph_zero_based":32104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32105},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink ::=                  SEQUENCE {","paragraph_zero_based":32106},{"literal_text_all_w_t_and_m_t":"    featureSetListPerDownlinkCC             SEQUENCE (SIZE (1..maxNrofServingCells)) OF FeatureSetDownlinkPerCC-Id,","paragraph_zero_based":32107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32108},{"literal_text_all_w_t_and_m_t":"    intraBandFreqSeparationDL               FreqSeparationClass                                                     OPTIONAL,","paragraph_zero_based":32109},{"literal_text_all_w_t_and_m_t":"    scalingFactor                           ENUMERATED {f0p4, f0p75, f0p8}                                          OPTIONAL,","paragraph_zero_based":32110},{"literal_text_all_w_t_and_m_t":"    dummy8                                  ENUMERATED {supported}                                                  OPTIONAL,","paragraph_zero_based":32111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d91ea129345e6885900969a91ea8713f85f49fe46194b96f9668155ad021d7c6","13ced0ec85f49d449a6e0bbcf1b6c19a4e16dd1d4732dc9c06d20e370ee97ba5","1f9f2c97ab695b25e25f62e99f56bb861a86712d3f3831890156ad8068d0859a","23ad6db0ec415d1989de7f6c4d4bf9c70dc2914de5cd6a4dc41374b1a6a2361e","039847b373329803fc1358132560917a9aa7f001458bedf787e34846f375baad","09c1b52fa5cf1dd991a2af1759d99a9ece7271942bd0dcb4323fcee415d