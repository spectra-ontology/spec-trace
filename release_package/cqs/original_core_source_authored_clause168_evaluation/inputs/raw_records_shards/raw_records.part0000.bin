m_t":"}","paragraph_zero_based":2966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2967},{"literal_text_all_w_t_and_m_t":"SL-SIB-ReqInfo-r17 ::=                   ENUMERATED { sib1, sib2, sib3, sib4, sib5, sib6, sib7, sib8, sib9, sib10, sib11, sib12, sib13,","paragraph_zero_based":2968},{"literal_text_all_w_t_and_m_t":"                                                      sib14, sib15, sib16, sib17, sib18, sib19, sib20, sib21, sibNotReq11, sibNotReq10, sibNotReq9,","paragraph_zero_based":2969},{"literal_text_all_w_t_and_m_t":"                                                      sibNotReq8, sibNotReq7, sibNotReq6, sibNotReq5, sibNotReq4, sibNotReq3, sibNotReq2, sibNotReq1, ... }","paragraph_zero_based":2970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2971},{"literal_text_all_w_t_and_m_t":"-- TAG-REMOTEUEINFORMATIONSIDELINK-STOP","paragraph_zero_based":2972},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2973},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2974},{"literal_text_all_w_t_and_m_t":"RemoteUEInformationSidelink-IEs field descriptions","paragraph_zero_based":2975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["27c2c3ee123a8ff951b6dfee2eadd75b018f392f027b71cfab37777beb29260a","5a4123bec5a7764105607f9e76c42bf5c9cb504d883b364624454d5aa81378de","dc54a162085427a3bca3d52b106bc64b023e466db25cf8025de4bef4b9e33961","506a5b657c637c9af81ccb6ff778c31cd6f7a5dfa34b1eccc1a6e4b08c22ca0a","b2343cd1d714d1cc86ca6eec33e2d2584888006e53a2150ff0be18cd406b54bb","5b0eea71d1fe8b649de14c0fb24c0bf8dc84def2a6123f148a089850c96a9b0b","78f5f391020ed89fcb3ae1ade160a9f9f4852b3cf6583bfbf4ceab621876b48b","91297202df1e7ee1ed6d55be50