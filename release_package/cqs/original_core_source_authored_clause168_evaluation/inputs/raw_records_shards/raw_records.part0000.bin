{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16944},{"literal_text_all_w_t_and_m_t":"    resourcesForChannel2-r17        CHOICE {","paragraph_zero_based":16945},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS2-r17                 SEQUENCE {","paragraph_zero_based":16946},{"literal_text_all_w_t_and_m_t":"            resourceSet2-r17                INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":16947},{"literal_text_all_w_t_and_m_t":"            qcl-info2-r17                   SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF TCI-StateId","paragraph_zero_based":16948},{"literal_text_all_w_t_and_m_t":"                                                                                                  OPTIONAL   -- Cond Aperiodic","paragraph_zero_based":16949},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16950},{"literal_text_all_w_t_and_m_t":"        csi-SSB-ResourceSet2-r17        INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfigExt)","paragraph_zero_based":16951},{"literal_text_all_w_t_and_m_t":"    }                                                                                             OPTIONAL,  -- Cond NoUnifiedTCI","paragraph_zero_based":16952},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetExt          INTEGER (1..maxNrofCSI-SSB-ResourceSetsPerConfigExt)          OPTIONAL   -- Need R","paragraph_zero_based":16953},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16954},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16956},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-APERIODICTRIGGERSTATELIST-STOP","paragraph_zero_based":16957},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16959},{"literal_text_all_w_t_and_m_t":"CSI-AssociatedReportConfigInfo field descriptions","paragraph_zero_based":16960},{"literal_text_all_w_t_and_m_t":"ap-CSI-MultiplexingMode","paragraph_zero_based":16961},{"literal_text_all_w_t_and_m_t":"Indicates if the behavior of transmitting aperiodic CSI on the first PUSCH repetitions corresponding to two SRS resource sets configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' is enabled or not.","paragraph_zero_based":16962},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":16963},{"literal_text_all_w_t_and_m_t":"CSI-IM-ResourceSet for interference measurement. Entry number in csi-IM-ResourceSetList in the CSI-ResourceConfig indicated by csi-IM-ResourcesForInterference in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on). The indicated CSI-IM-ResourceSet should have exactly the same number of resources like the NZP-CSI-RS-ResourceSet indicated in resourceSet within nzp-CSI-RS.","paragraph_zero_based":16964},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSet, csi-SSB-ResourceSet2","paragraph_zero_based":16965},{"literal_text_all_w_t_and_m_t":"CSI-SSB-ResourceSet for channel measurements. Entry number in csi-SSB-ResourceSetList in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on).","paragraph_zero_based":16966},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":16967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["13c16494d8a076e0e17e8febe039b85671620f52585e332a0625f3ee5517c98c","000d78b451fece7b1a3874b61317ac1bfd722494155ed38358d6fe1764a52808","78c7dc1607906fe25a48aa3ce3ac77d59b81bc88d8c41a187758b993f21a809f","c82320095668553a7962b33730fe658910fa042b2db08e8d5a698dece384962e","80ef63a67579caa16c5514b73b27114875a5c3234230ae15d04b090262bd85a2","0ebea11acec0e8d88c5b71b92b8cfba6f3d8172c8ea09c0bacf7c61b579efa08","2129244a7e261487daf983096b2204dd1489630be5843ec4e54cec14ced3ec79","5542232f51ee03e897713c26e4f37220ec5546eaf81073bda2b9e1f1ea0003fb","3885927fee51e403a0f3ae3b434c82b9902d04e442ed59f98c7c6d08e049fe86","34e1e08fb38d443c4d5db246432828007637d37a615599c9bc6daa14d9399c76","635490033de2bf4f383ec444c1cd2b2363897deaaf75d6b2afa1de407bb15a1d","c27463ec5545735bc67b93f37b611701783949e8ecf1b41b0183ad93ebcfb7a3","f16ef3e00b9c04c2ba51e743c61c59cbc3a0a9b46aed344f7ac40dd543d5ad7b","3df4e414e023b0a22d3f6ac775b94fd7eae692ff0e8f845aa28476953c3085cc","d3d0c4a999ee8904357d937343eef1b1e600bc348c83a6c102f8c0c357d634fe","9510b9e9ea44cbafe63cf6566e22e24745ce5dabf6a870a452081841ba567943","6b21fc477b03715cface11521d44cf1b8dc14c644b11ff6adc0b79b45dc7dc3a","c293f86e97b6faef101014cc42dc9c5670f5d3ee8c9be487763f8191aee88b7f","d52f53017b73a43fe41ab93795a087dcbba57476277060adb62bdbc4c5a39fbb","00b1a59d8070a8019fbaa5967c9b74783516b4ce34aba184cc7dd5f7f60b6cce","eddd741a6f151a230b2a689384a2764082df9d9254131431759c1ef93a09d8ff","c4e21020650545a9f156591a70399f7294851df81432785f8005a0b5f9a88cee","707fdf49190450c2896f37546fa928b4ab4a64c3486715346a0665addc5a0e88","6cbdc0631b7ed7fe7743015febeaadeb65d0e4dfd91b820e0a2d2a8fa45683f5"],"paragraph_range_zero_based":[16944,16967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16944"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet for interference measurement. Entry number in nzp-CSI-RS-ResourceSetList in the CSI-ResourceConfig indicated by nzp-CSI-RS-ResourcesForInterference in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on). ","paragraph_zero_based":16968},{"literal_text_all_w_t_and_m_t":"qcl-info, qcl-info2","paragraph_zero_based":16969},{"literal_text_all_w_t_and_m_t":"List of references to TCI-States for providing the QCL source and QCL type for each NZP-CSI-RS-Resource listed in nzp-CSI-RS-Resources of the NZP-CSI-RS-ResourceSet indicated by resourceSet within nzp-CSI-RS. Each TCI-StateId refers to the TCI-State which has this value for tci-StateId and is defined in tci-StatesToAddModList or in dl-OrJointTCI-StateList in the PDSCH-Config included in the BWP-Downlink corresponding to the serving cell and to the DL BWP to which the resourcesForChannelMeasurement (in the CSI-ReportConfig indicated by reportConfigId above) belong to. First entry in qcl-info corresponds to first entry in nzp-CSI-RS-Resources of that NZP-CSI-RS-ResourceSet, second entry in qcl-info corresponds to second entry in nzp-CSI-RS-Resources, and so on (see TS 38.214 [19], clause 5.2.1.5.1). When this field is absent for aperiodic CSI RS, the UE shall use QCL information included in the  \"indicated\" DL only/Joint TCI state as specified in TS 38.214","paragraph_zero_based":16970},{"literal_text_all_w_t_and_m_t":"reportConfigId","paragraph_zero_based":16971},{"literal_text_all_w_t_and_m_t":"The reportConfigId of one of the CSI-ReportConfigToAddMod configured in CSI-MeasConfig","paragraph_zero_based":16972},{"literal_text_all_w_t_and_m_t":"resourcesForChannel2","paragraph_zero_based":16973},{"literal_text_all_w_t_and_m_t":"Configures reference signals for channel measurement corresponding to the second resource set for L1-RSRP measurement as configured in IE CSI-ResourceConfig when nrofReportedGroups-r17 is configured in IE CSI-ReportConfig. If this is present, network configures csi-SSB-ResourceSetExt instead of csi-SSB-ResourceSet and the UE ignores csi-SSB-ResourceSet in resourcesForChannel, and the resourcesForChannel configures the reference signals for channel measurement corresponding to the first resource set for L1-RSRP measurement (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":16974},{"literal_text_all_w_t_and_m_t":"resourceSet","paragraph_zero_based":16975},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet for channel measurements. Entry number in nzp-CSI-RS-ResourceSetList in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement in the CSI-ReportConfig indicated by reportConfigId above (value 1 corresponds to the first entry, value 2 to the second entry, and so on).","paragraph_zero_based":16976},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16977},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16978},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16979},{"literal_text_all_w_t_and_m_t":"Aperiodic","paragraph_zero_based":16980},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the NZP-CSI-RS-Resources in the associated resourceSet have the resourceType aperiodic and unifiedTCI-StateType is not configured. The field is optionally present, Need R, if the NZP-CSI-RS-Resources in the associated resourceSet have the resourceType aperiodic and unifiedTCI-StateType is configured. The field is absent otherwise.","paragraph_zero_based":16981},{"literal_text_all_w_t_and_m_t":"CSI-IM-ForInterference","paragraph_zero_based":16982},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the CSI-ReportConfig identified by reportConfigId is configured with csi-IM-ResourcesForInterference; otherwise it is absent.","paragraph_zero_based":16983},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ForInterference","paragraph_zero_based":16984},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the CSI-ReportConfig identified by reportConfigId is configured with nzp-CSI-RS-ResourcesForInterference; otherwise it is absent.","paragraph_zero_based":16985},{"literal_text_all_w_t_and_m_t":"NoUnifiedTCI","paragraph_zero_based":16986},{"literal_text_all_w_t_and_m_t":"This field is absent, Need R, if unifiedTCI-StateType is configured for the serving cell in which the CSI-AperiodicTriggerStateList is included. It is optionally present, Need R, otherwise.","paragraph_zero_based":16987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16988},{"literal_text_all_w_t_and_m_t":"–CSI-FrequencyOccupation","paragraph_zero_based":16989},{"literal_text_all_w_t_and_m_t":"The IE CSI-FrequencyOccupation is used to configure the frequency domain occupation of a channel state information measurement resource (e.g. NZP-CSI-RS-Resource, CSI-IM-Resource).","paragraph_zero_based":16990},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation information element","paragraph_zero_based":16991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e6bd2479fef2407f5eb59f2132084f819cae5cde556187a86faf30099c0c2b33","5618a0da5bf94bb0aa5eb44486f7671ef430372a1499a42563afa88bfa55dc60","140b1b54418eaf1d3213c4c16d2ff7db2fe81baf90e4b68bdcc9f5dff72dd456","e35e8f5780b3dca9c2662b528d8c5777194eafdb3fcf7ba15db62f6bb0b9b0ae","15cf64dbe37c4802f7f0de841056156d88b4e2af14349dab393b700278de16e9","b6575351e5f7d381d516e815a0d2e3e94128c26fccb4410a04d