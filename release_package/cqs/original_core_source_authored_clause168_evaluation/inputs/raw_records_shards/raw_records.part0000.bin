{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3241},{"literal_text_all_w_t_and_m_t":"Delta-Height-r16 ::= SEQUENCE {","paragraph_zero_based":3242},{"literal_text_all_w_t_and_m_t":"delta-Height-r16INTEGER (-1024..1023),","paragraph_zero_based":3243},{"literal_text_all_w_t_and_m_t":"coarse-delta-Height-r16INTEGER (0..4095)OPTIONAL,-- Need OP","paragraph_zero_based":3244},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":3245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3247},{"literal_text_all_w_t_and_m_t":"LocationUncertainty-r16 ::= SEQUENCE {","paragraph_zero_based":3248},{"literal_text_all_w_t_and_m_t":"horizontalUncertainty-r16INTEGER (0..255),","paragraph_zero_based":3249},{"literal_text_all_w_t_and_m_t":"horizontalConfidence-r16INTEGER (0..100),","paragraph_zero_based":3250},{"literal_text_all_w_t_and_m_t":"verticalUncertainty-r16INTEGER (0..255),","paragraph_zero_based":3251},{"literal_text_all_w_t_and_m_t":"verticalConfidence-r16INTEGER (0..100)","paragraph_zero_based":3252},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3254},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3256},{"literal_text_all_w_t_and_m_t":"RelativeLocation field descriptions","paragraph_zero_based":3257},{"literal_text_all_w_t_and_m_t":"milli-arc-second-units","paragraph_zero_based":3258},{"literal_text_all_w_t_and_m_t":"This field provides the units and scale factor for the delta-latitude and delta-longitude fields. Enumerated values mas0-03, mas0-3, mas3, and mas30, correspond to 0.03, 0.3, 3, and 30 milliarcseconds, respectively. ","paragraph_zero_based":3259},{"literal_text_all_w_t_and_m_t":"height-units","paragraph_zero_based":3260},{"literal_text_all_w_t_and_m_t":"This field provides the units and scale factor for the delta-height field. Enumerated values mm, cm, and m correspond to 10-3 metre, 10-2 metre, and 1 metres, respectively.","paragraph_zero_based":3261},{"literal_text_all_w_t_and_m_t":"delta-latitude","paragraph_zero_based":3262},{"literal_text_all_w_t_and_m_t":"This field specifies the delta value in latitude of the desired location, defined as \"desired location\" minus \"reference point location\" and comprises the following sub-fields:","paragraph_zero_based":3263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["c8cb7f39cb693fa5f3d3f1679852c01200c302e5f13c9ae05baad70ed8141c6e","0d4128af1271f20dc706b26541bb0feeb306fe9ab2c1262106ac1f502db5a258","fe8a285225b4bdb962fc9a6556d1cd598eed66095d35dfeba7b63b4732703b4d","99ee550183b36a242310594be5762321ee7fb7d82b3d30bfdfd4d1a1d47639d2","68bbb15b26785585eab76d6efc97e8f50d305feb5b75fc16775eff5c5be07db2","49fae878359dcf8def0941960497e076d90c4f85d1f9e0d75c3b1ccb1d0cc72a","bad9900acc5048ea3b849060a02a8f61d3c7c956ee10fbb523f9a5198a772dd9","67ab1634dc0bbb65cbe42ab97476594900149423c4579de6245e0a687b2d6d4c","70ff7ea8df9a4249cab20504ab61a9d499ee3d4eafae4f7d755c5526dc3adf15","b422d57483bd1ee07b690fc0f597bcb61e452cd0d69fbfd77bda6a34daf24a28","d87391b24244226d490410ffa1704739c8e3bf0f27ec92f9f19f253caad927d2","3b4e22f2e6d65d6ad18e6ac2a9a3418ffbe2909abbde0610f104f2671f37cdde","d5fd907fcb097650e788040c8aa94e6a64a4207ab517acef0b37c3b7d167b92c","66cfb41e98f779782e9e8910ae4514f4f0d85c57fd20ac3b93642109f228a819","e556fb5b04c82638fcc3fb7759ca674370d6b6f4b16c7aa61a35a97e672eb495","fc911f5aa9d3e0628d4d4bdfc75c7bfe55c8ea1a5e46ab99a994badf419f9fb5","4a3a5f8f9e25e731b99193e31d22be57a4b0d1912cb310c6f3ce75b456ca20e1","b67c3591a0157736669e002a25952454a3c2780ba3e68e4f5a8d2a6d084c5752","ebc023fe5a3c9cf43981c5c44c59906b44a57cbce54c47613679995cbc09d86c","0f26ec0e42f4ad9b4f022b119084c03a974ae167f13fa656a8fcc0c1b284f713","879475031b46da6589fc00a76f6f4038b91cf8bc7fe3fb07c284ec02be961277","1def9d623574f9d331c82701488b171bc04b4cb7d5e1081a00d6272323e0117d","bd12ecb99805e38e47dba56f922bd7cacf2f000fce71db4803803e9ce48dd91a","f0f74ba5d4130891044ce52325409f3dc54746d80e0e2af412b16ee28c952069"],"paragraph_range_zero_based":[3240,3263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3240"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-delta-Latitude specifies the delta value in latitude in the unit provided in milli-arc-second-units field.","paragraph_zero_based":3264},{"literal_text_all_w_t_and_m_t":"-coarse-delta-Latitude specifies the delta value in latitude in 1024 times the size of the unit provided in milli-arcsecondunits field and with the same sign as in the delta-Latitude field. If this field is absent, the value for coarse-delta-Latitude is zero.","paragraph_zero_based":3265},{"literal_text_all_w_t_and_m_t":"I.e., the full delta-latitude is given by:","paragraph_zero_based":3266},{"literal_text_all_w_t_and_m_t":"(delta-Latitude × milli-arc-second-units) ± (coarse-delta-Latitude × 1024 × milli-arc-second-units) [milli-arc-seconds] ","paragraph_zero_based":3267},{"literal_text_all_w_t_and_m_t":"delta-longitude","paragraph_zero_based":3268},{"literal_text_all_w_t_and_m_t":"This field specifies the delta value in longitude of the desired location, defined as \"desired location\" minus \"reference point location\" and comprises the following sub-fields:","paragraph_zero_based":3269},{"literal_text_all_w_t_and_m_t":"-delta-Longitude specifies the delta value in longitude in the unit provided in milli-arc-second-units field.","paragraph_zero_based":3270},{"literal_text_all_w_t_and_m_t":"-coarse-delta-Longitude specifies the delta value in longitude in 1024 times the size of the unit provided in milli-arcsecondunits field and with the same sign as in the delta-Longitude field. If this field is absent, the value for coarse-delta-Longitude is zero.","paragraph_zero_based":3271},{"literal_text_all_w_t_and_m_t":"I.e., the full delta-longitude is given by:","paragraph_zero_based":3272},{"literal_text_all_w_t_and_m_t":"(delta-Longitude × milli-arc-second-units) ± (coarse-delta-Latitude × 1024 × milli-arc-second-units) [milli-arc-seconds] ","paragraph_zero_based":3273},{"literal_text_all_w_t_and_m_t":"delta-height","paragraph_zero_based":3274},{"literal_text_all_w_t_and_m_t":"This field specifies the delta value in ellipsoidal height of the desired location, defined as \"desired location\" minus \"reference point location\" and comprises the following sub-fields:","paragraph_zero_based":3275},{"literal_text_all_w_t_and_m_t":"-delta-Height specifies the delta value in ellipsoidal height in the unit provided in height-units field.","paragraph_zero_based":3276},{"literal_text_all_w_t_and_m_t":"-coarse-delta-Height specifies the delta value in ellipsoidal height in 1024 times the size of the unit provided in height-units field and with the same sign as in the delta-Height field. If this field is absent, the value for coarse-delta-Height is zero.","paragraph_zero_based":3277},{"literal_text_all_w_t_and_m_t":"I.e., the full delta-height is given by:","paragraph_zero_based":3278},{"literal_text_all_w_t_and_m_t":"(delta-Height × height-units) ± (coarse-delta-Height × 1024 × height-units) [metres] ","paragraph_zero_based":3279},{"literal_text_all_w_t_and_m_t":"locationUNC","paragraph_zero_based":3280},{"literal_text_all_w_t_and_m_t":"This field specifies the uncertainty of the location coordinates and comprises the following sub-fields:","paragraph_zero_based":3281},{"literal_text_all_w_t_and_m_t":"-horizontalUncertainty indicates the horizontal uncertainty of the ARP latitude/longitude. The ′horizontalUncertainty′ corresponds to the encoded high accuracy uncertainty as defined in TS 23.032 [15] and ′horizontalConfidence′ corresponds to confidence as defined in TS 23.032 [15].","paragraph_zero_based":3282},{"literal_text_all_w_t_and_m_t":"-verticalUncertainty indicates the vertical uncertainty of the ARP altitude. The 'verticalUncertainty' corresponds to the encoded high accuracy uncertainty as defined in TS 23.032 [15] and 'verticalConfidence' corresponds to confidence as defined in TS 23.032 [15].","paragraph_zero_based":3283},{"literal_text_all_w_t_and_m_t":"If this field is absent, the uncertainty is the same as for the associated reference point location.","paragraph_zero_based":3284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3285},{"literal_text_all_w_t_and_m_t":"–TEG-TimingErrorMargin","paragraph_zero_based":3286},{"literal_text_all_w_t_and_m_t":"The IE TEG-TimingErrorMargin defines the timing error margin values of the UE Rx TEGs, UE Tx TEGs, or TRP Tx TEGs. Enumerated value 'tc0' corresponds to 0 Tc, 'tc2' corresponds to 2 Tc and so on, where Tc is defined in TS 38.211 [41] clause 4.1.","paragraph_zero_based":3287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["6fcf8407c3e70f708111e93f1667a46524dad55e6628da84b97544916e647164","fe315c36a1be55bf66005a62a80b97b5c89733992dc2a62178f35be5afb25627","facc6727be99b698a5369a6a206cb281e682a629f535a081848ebee656b4b7ff","77d9be24d7e98c21322e69100489a9437149edb3be031a1261c7be7e9214187b","2ccc1b12c74e8401daa6ec466d08553e47cf1e897f5f5437a28847a891f0984e","f5c122ab2190c6364bb530ba3857741ba56bcbc2736c2304cbfdb3002782dd24","786a2e54ff44be18a662c4fbf4051ca66a2ee61199ed8edcf69d3011a28b5714","a21e2a7d830caa502d8a2eb156debd58db334e410f5b307d610833c8941fa036","b1b809a6e1d261a533215d23543083c773d680521ead9e644fbc8b4bbd899077","7f20653de3192a676faac7c4461e3fae294c149f8e2a443b264fc603d74581a0","641fe4b41be60c136b527456e7ec841a0adbeacfcabb670de0d6796fb6206417","b12295428fd9d2860bb237aa123c78ddc007d365716d25f9aa2858d40ba266db","cef592a2ba1f0f651b587496d80393129411ae458312de6f029b148700ca1bb7","0d224c916d41f9161baa83b2c538af312e87a2ae6303428db6609e2bb109368a","03b70abb19cc13eea1dd08028d75c39a8b9e8103719bb35438909fb53305320f","48d0ad7d48e10417f2d17c0c32b4c0da9e0af21c5f5c04c5dd84ffd2045b8eae","1a3df00e2ca54e426052c3646f7aa308ffe0dbb566092b8700391de36df925b0","8c8340fda90a1e8dd3dda0c383ba840cac54c19734ab7c492091e92e4f988672","9dfcae284c9342f4db26b41b34ae317b79ac332bc4e7b79b56e93e2ef68c60a1","1b18b2d9bd63c0582f3e4f43b2554fadb10b594bdeb1bed34433d58832af144c","ff48b5632d9b422434116670dde883ac4d27b40291ca0d0337bb8b73f5e6a43b","f9f2c6c1965d44ca9503f66cd8cb0da4089f563cfc85ad1db754e4e7c47b0634","6dcbd17e209bb2473afd41f61a32b2027f2b5cb3f10c7707a4415494051d07ba","404a02d0f3900f47fdbdb216eed73b5364e42111c74c1fb096df9cacee38ea29"],"paragraph_range_zero_based":[3264,3287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3264"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3289},{"literal_text_all_w_t_and_m_t":"TEG-TimingErrorMargin-r17 ::= ENUMERATED { tc0, tc2, tc4, tc6, tc8, tc12, tc16, tc20, tc24,","paragraph_zero_based":3290},{"literal_text_all_w_t_and_m_t":"tc32, tc40, tc48, tc56, tc64, tc72, tc80 }","paragraph_zero_based":3291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3292},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3294},{"literal_text_all_w_t_and_m_t":"–RxTxTEG-TimingErrorMargin","paragraph_zero_based":3295},{"literal_text_all_w_t_and_m_t":"The IE RxTxTEG-TimingErrorMargin defines the timing error margin values of the UE RxTx TEGs. Enumerated value 'tc0-5' corresponds to 0.5 Tc, 'tc1' corresponds to 1 Tc and so on, where Tc is defined in TS 38.211 [41] clause 4.1.","paragraph_zero_based":3296},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3298},{"literal_text_all_w_t_and_m_t":"RxTxTEG-TimingErrorMargin-r17 ::= ENUMERATED { tc0-5, tc1, tc2, tc4, tc8, tc12, tc16, tc20,","paragraph_zero_based":3299},{"literal_text_all_w_t_and_m_t":"tc24, tc32, tc40, tc48, tc64, tc80, tc96, tc128 }","paragraph_zero_based":3300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3301},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3304},{"literal_text_all_w_t_and_m_t":"6.5.10.6NR DL-TDOA Capability Information","paragraph_zero_based":3305},{"literal_text_all_w_t_and_m_t":"–NR-DL-TDOA-ProvideCapabilities","paragraph_zero_based":3306},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-TDOA-ProvideCapabilities is used by the target device to indicate its capability to support NR DL-TDOA and to provide its NR DL-TDOA positioning capabilities to the location server.","paragraph_zero_based":3307},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3309},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-ProvideCapabilities-r16 ::= SEQUENCE {","paragraph_zero_based":3310},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-Mode-r16PositioningModes,","paragraph_zero_based":3311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["d88ef8fc85715c95b71365419d125551d06d93b73c15d0576a7a9356a5e9f45a","1cc3623cda74adc0a622c185a8622fbfca70a784c6ea0675a9cc9f20e1373b20","e9df8997d3a7ad6fe7b5e28fbcede05cfb0013e1d2a6df301979f1e0cd69811a","3e763b344b0af73cc9a578b066a6dc158e157ffe0add400973d1886e5a26bbac","7c90b33a2e810c829e63a46d50dea40589f04b2fe67f4ebfc9ff86274e5ffdcf","1857ace87106d6655a3e243e4bc1bb069f13fad3c55d9c5915fc4e0eecb0b49e","06f8a7ca63dbac9ec5034ca573b0220e336c86473d73bb67734dcc9ab9938635","d620f1d0527846b96b620669e9cd6e83316f91bfa818e94aeec8508a66204d3b","91f0b8bdabf56ca9a674239e0ea072275f410baa7913e001fe1bca981c350ae8","197e4f9e8945300ae39be99e68f0e1acfacebd646c6424f64168b56061d3acf3","c137436e7fb7e6b4cf1e5cf16d173c00703a59931919756d06d90d5c4a7d2be9","bdbd3a44ae70fce2af19177301e4e756f1b572603eb9d07259bc7eb0f20ca7e6","68079a9454b32002a61f59321b2b3cff4d04fae46d35c12701783b041aacdade","1c311ed1304d677d1d4e95be01a05d33236d73ad2f3ddc41aab503274388415c","33665b5746ee287b3d8f51c9c7255bba19bfed89cd6da5a543124437