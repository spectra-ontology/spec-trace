{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21816},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21817},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21818},{"literal_text_all_w_t_and_m_t":"Periodic","paragraph_zero_based":21819},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21820},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":21821},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21822},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21823},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceId","paragraph_zero_based":21824},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceId is used to identify one NZP-CSI-RS-Resource.","paragraph_zero_based":21825},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId information element","paragraph_zero_based":21826},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21827},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-START","paragraph_zero_based":21828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21829},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId ::=           INTEGER (0..maxNrofNZP-CSI-RS-Resources-1)","paragraph_zero_based":21830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21831},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-STOP","paragraph_zero_based":21832},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph