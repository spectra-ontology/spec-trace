{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BDS-GridModSup","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports BDS-GridModel; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"RTK-OSR-Sup","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-RTK-Observations; otherwise it is not present. Note, support for GNSS-RTK-Observations implies support for GNSS-RTK-CommonObservationInfo as well.","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"GLO-CPB-Sup","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GLORTKBiasInformation; otherwise it is not present. This field may only be present if gnss-ID indicats 'glonss'.","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"MAC-Sup","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKMACCorrectionDifferences; otherwise it is not present.","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"Res-Sup","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKResiduals; otherwise it is not present.","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"FKP-Sup","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKFKPGradients; otherwise it is not present.","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"OC-Sup","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSROrbitCorrections; otherwise it is not present.","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"CC-Sup","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSRClockCorrections; otherwise it is not present.","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"CB-Sup","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSRCodeBias; otherwise it is not present.","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"URA-Sup","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-URA; otherwise it is not present.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"PB-Sup","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-PhaseBias; otherwise it is not present.","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"STEC-Sup","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-STEC-Correction; otherwise it is not present.","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["e01973807df2e47da8a638178ba0af983cffa3ad8e24c58a966c3d6740edb64b","64fc90c9704103e4d33dbd3a1242205b6140147708855573d6fdf20807d8afe4","cba03e75f844a6c3de90f19716498667f129662dfe58b6ca0e6512e3d218d98c","3295f1d048574930e63caaa80ec12353ed90ca045e193213dee475641e6dd1e9","5e143ba54e491b7b65ffaf235b2bae84baa840d871270981f486aeef6898ce63","3fc48042