{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide overheating assistance information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":1320},{"literal_text_all_w_t_and_m_t":"2>if the UE experiences internal overheating:","paragraph_zero_based":1321},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum secondary component carriers:","paragraph_zero_based":1322},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":1323},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsDL to the number of maximum SCells the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1324},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsUL to the number of maximum SCells the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1325},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1:","paragraph_zero_based":1326},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":1327},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1;","paragraph_zero_based":1328},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1;","paragraph_zero_based":1329},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":1330},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":1331},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1;","paragraph_zero_based":1332},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1;","paragraph_zero_based":1333},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":1334},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":1335},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2;","paragraph_zero_based":1336},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2;","paragraph_zero_based":1337},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":1338},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":1339},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1340},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1341},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":1342},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":1343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["797cee7b643529051e70430ca0288f9ab82f9a3ac642503c40e80c237fb9cbdd","739862b0a8c2bc42a51a360ef7115f11391f50781026cf1c56867eb863b4a8ed","abe4bc8cb6ee31d70db1898c16a4aa35b018abadfa3d5e69cd7fdf37974caf10","6cef8bb8f8c8bbdbb0ad21d58a1fc1942dd9b46a6c5141c7840b1e7a20322291","e37a95a87dbf74e35f8f853ba126189521c6b94d803280a3b0f69428a261150f","42adae7c349e07e676aa8866f783c4a5f54d1d4b73943432e8542014fc2a24fb","455fcb728d2c48bc490cc7c6bb31f70e84bda03f203c6b5643cfe5635820521a","78507ff8b8a7b9ad84eba48e97cd1e13ccb530468508fc68824eef437a318d60","c73632974ee13baf80dea1e45254cd7df3980d9d9c85bbbeb64bf07099535c2e","059bac4271623adf7117919fe0771d213727abc87054c72d906645b3d434b528","497757eab69815ca6669f40c133f427e839dc8e50492eba79a021495db0e0af4","df2018b44460bb33fb97e44a5f303faa552ad3655e27a32f4bb76dea89bc75e3","481162825ea2f244d0f47f11be77c1ff1f9c78f89bf7ba26bd11d4700f05b4f8","97b9b8a9e7d0cbf67eea59c90b516ce6fe3d7514b5ed3efadf59ea9a21caae8e","202783a2c585ccbd828740d57647bdc14acff9fb05573164e92493d226f40d77","6ab653462153d68b7336e86a9d846654b6cf2f6951163a906c360aeee85ef9d7","7664040371e98815ad63ad5ec802b92f86c5c510d5e5202dd2096853d510de9b","6ba43fe83fcbea1d01f51fa6667fbfd001eb500dd378c36e823ad04ca307ad03","b0d8b03542b58890d8491be4fe2bf78ec1731ce6d463573761b15477c78a54d7","fee34f5ca9bc71cf142f60098a2ad0a8c3ab963261b4e2d1f012aceb51555e4d","4dd8d1e2277771a446e0619332c4f8884be60fac3d4817f61c121ffcedde3163","55ea25f2076aecf37835a44e959d55adf3731a8143694f5f1a781d5f1b18e43a","538f869ff2bfda90936f65ab1af98c6196ea0e0f0346596e815a79c4e73eb3aa","75782f0ef72787121efa9c4e1c3333d9c5c79b0087513b52fadccda990931c62"],"paragraph_range_zero_based":[1320,1343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1320"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1344},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1345},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2:","paragraph_zero_based":1346},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":1347},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":1348},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":1349},{"literal_text_all_w_t_and_m_t":"2>else (if the UE no longer experiences an overheating condition):","paragraph_zero_based":1350},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs, reducedMaxBW-FR1, reducedMaxBW-FR2, reducedMaxBW-FR2-2, reducedMaxMIMO-LayersFR1, reducedMaxMIMO-LayersFR2 or reducedMaxMIMO-LayersFR2-2 in OverheatingAssistance IE;","paragraph_zero_based":1351},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1352},{"literal_text_all_w_t_and_m_t":"2>if there is at least one carrier frequency included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1353},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqList with an entry for each affected carrier frequency included in candidateServingFreqListNR;","paragraph_zero_based":1354},{"literal_text_all_w_t_and_m_t":"3>for each carrier frequency included in the field affectedCarrierFreqList, include interferenceDirection and set it accordingly;","paragraph_zero_based":1355},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":1356},{"literal_text_all_w_t_and_m_t":"3>include victimSystemType for each UL CA combination included in affectedCarrierFreqCombList;","paragraph_zero_based":1357},{"literal_text_all_w_t_and_m_t":"3>if the UE sets victimSystemType to wlan or bluetooth:","paragraph_zero_based":1358},{"literal_text_all_w_t_and_m_t":"4>include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":1359},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1360},{"literal_text_all_w_t_and_m_t":"4>optionally include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":1361},{"literal_text_all_w_t_and_m_t":"NOTE 1:When sending an UEAssistanceInformation message to inform the IDC problems, the UE includes all IDC assistance information (rather than providing e.g. the changed part(s) of the IDC assistance information).","paragraph_zero_based":1362},{"literal_text_all_w_t_and_m_t":"NOTE 2:Upon not anymore experiencing a particular IDC problem that the UE previously reported, the UE provides an IDC indication with the modified contents of the UEAssistanceInformation message (e.g. by not including the IDC assistance information in the idc-Assistance field).","paragraph_zero_based":1363},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide drx-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1364},{"literal_text_all_w_t_and_m_t":"2>include drx-Preference in the UEAssistanceInformation message;","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters for the cell group:","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the long DRX cycle:","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["f0e8224bd49ac5c82c83bb63435a974d7ef284e56fe5b36f38c212e6dc9f0303","fc49cb620bef36ef8da9a627e079c9ea113eeb9f0b1a02880ebde0348b4480d7","2891a00cf0bbd245cdd0d65e74a3222f0a4f6cc244ba57f87902586e10660523","5531d756417e901e1b7e871e84e986521f5ee712d0b04a7b36ce96a1036bcdde","9c48ebff80724b0285b97b19003c4e8306d5bbae0526527b080041d34f42cb3b","faddf5fcad74d2d27d40db934f403617f1ebf2aef44d8539b24b2e71a13cab57","8e870a4fbd5795d88925dba4d69bd3befad6959d9449a0e42266ec4b88db39cb","9dfe85ef0b727054a0f9e4f876ec5037e0795ae319c51fa7bf96d8a58e0e2e6f","03f421815171b4a1843447acd0a935d15a07d2247cd4b1e7cda49f7ebf683c94","f9dbb6e4249595fe4a3d86a2b146745f0333e274a882a920ff82ae4ff14cfa4b","95c23f4a1d9c1c86b5d7519c7233e075334fb19445e1540a9bd6ea1ae59d88ce","16d4da90d0a4b9532239dcd5d58a36d78dbc08a45efcbfa4e9826cb0951ecc4d","0e27d59b710b2fab52bb08b77eea71ee521ccfb4f19c4444feff6b0bd87cae64","2bebcefd607d69c23cfded49e690831dd9c74c0f087c278ba34dad5fa7599f69","8d646c6516977981ddb0a0cb48f2aa2f9f293f6f059ddbefcdec2cecf3eac16c","fa7df715ea93b2dbcfde2fff7aad91023ff8c0737040dfc64e590fcef868916c","40bd1ff10945c4d254467103cd5004e1ffbee378b7af9e701a2a6e0ade54c967","4ecf1316ef42b4996545e72e39525c526d1b9d32822990f46d9e8ec1bd5a58bf","d7054d5ba95c32765853071781faa2ae9e1c53337448c19db2cd0dc94d2f1710","9947c4f7b920b504339600cf45aa717a0a9cff9de0daef0a7c8691707b28d938","96fcd221dbf13b1bd44c2fc0ddb6a231191ea6462dca07ad9cfa0f80e56292ab","1772c678097cf9b843b8e16cf6ab07daf460c6a77ee0e27765575307f46af80c","fd51166c37ea7c7cb24083a70e9785a55ad20d27dada9ea084c09324d634a00b","5879bbfcda22d925c48664f3117b6308a17e944e41083fbeffc83ee3ec06b481"],"paragraph_range_zero_based":[1344,1367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1344"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-LongCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1368},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the DRX inactivity timer:","paragraph_zero_based":1369},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-InactivityTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1370},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX cycle:","paragraph_zero_based":1371},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1372},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX timer:","paragraph_zero_based":1373},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycleTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":1374},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on DRX parameters for the cell group):","paragraph_zero_based":1375},{"literal_text_all_w_t_and_m_t":"3>do not include preferredDRX-LongCycle, preferredDRX-InactivityTimer, preferredDRX-ShortCycle and preferredDRX-ShortCycleTimer in the DRX-Preference IE;","paragraph_zero_based":1376},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1377},{"literal_text_all_w_t_and_m_t":"2>include maxBW-Preference in the UEAssistanceInformation message;","paragraph_zero_based":1378},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth for the cell group:","paragraph_zero_based":1379},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR1:","paragraph_zero_based":1380},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the MaxBW-Preference IE;","paragraph_zero_based":1381},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR1 in the cell group;","paragraph_zero_based":1382},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR1 in the cell group;","paragraph_zero_based":1383},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":1384},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":1385},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-1 in the cell group;","paragraph_zero_based":1386},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-1 in the cell group;","paragraph_zero_based":1387},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":1388},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR1 and reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":1389},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-PreferenceFR2-2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":1390},{"literal_text_all_w_t_and_m_t":"2>include maxBW-PreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":1391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["64d522f2bb7718dcdb6914d57b57267fea9e38fc23533de0d9788271b5c97813","67109df1a15c07b3bb1e184fe7a8cfedea9bf88f2bff9cefb0a7c87bd4601981","c5c48c3b651cff49c639abf648a0104bdb22ee548a22705da33c995ffcad726c","ef8993fc50db17b61e2e5eb60f1191c3b2aa373cedb9ba80f4a8ce9b4bde665c","c0b312bf246ab8fecf457cedc50db77ccaae388a293ebc7eac28eba7c216d2b2","d00e15b55d6adf5f4cbcb3adf35a8da2dac7cfc7a00183af1e219c13db1b3c86","2c6ca6e073702a6f0d92a6c0b5f377796491ab32295ed6185a1c2e3b05ed67eb","4e32916ebf1d73746d1a0c5034d5ebc8f377f5fa26eb9815a02bafcfae3beb5c","8fceb70d7cc1b6c10ef9a5875282d1368e6b846519a9d504c3f13870ce5679c7","558a1f7cd17607f8e25c6d8027e5d38af31d6ec9a4c4c7cf4f6b900e568c0170","36d48dfe3f3e10fbd4cfeab0a8bc61a37ac4fdaed17a1b1303a346861f1956a1","f94bfef202ece1628ad617d5ca85eb027a55657c041f67e613ec74861dfa0681","c58d5249ee61f097f91fd08a7a4716951fe93e40394932ec024ebd2132788278","eda1a149ec1d8697948a46500b119041821e01da263f38ceefff3ee247e42e62","857878548223203afbc8254031de7909e2b424868b4cb33e697464966c1e49b5","1a87422ed5d9c01c7d83c8242ec3a9d72944f890198c2dfc85fec630ffa619bd","394f7c2ea9446c61880afc96c027268a2fbcc75bb271b51ee6823de78314169d","208192b9fb1e5df2d977a8bfbad0810a8bc3ef820223475d3d77203bfc2d071d","925184fd8f20c3e5959fff1d3b04cb67e9661261de02d98ecc777e65007e2ed2","c5bade7daae30c4e352be16858e11b892b5a608e04c4b9b816c31987587c31fa","966443bdc45666df800ebab3db9fc0bdb565478b3fc17f003fef675c771668f1","c5ad83e67db1e626331f33012832db5329d4f502ebb67e1740e6a381d125b4ec","5508f21d9ea0e8e0c100defe95d55cf9f750318d6c0f30ded6278e1e2dabfc8f","e25fc9b3f5a9e8e2a56d0d04389057d634ed32e95d3dfefbb0ca68be0dae0c18"],"