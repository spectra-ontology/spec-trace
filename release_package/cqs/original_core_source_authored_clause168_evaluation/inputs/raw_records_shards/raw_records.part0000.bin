{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"excludedCellsToAddModListEUTRAN","paragraph_zero_based":19896},{"literal_text_all_w_t_and_m_t":"List of cells to add/ modify in the exclude-list of cells.","paragraph_zero_based":19897},{"literal_text_all_w_t_and_m_t":"excludedCellsToRemoveListEUTRAN","paragraph_zero_based":19898},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the exclude-list of cells.","paragraph_zero_based":19899},{"literal_text_all_w_t_and_m_t":"widebandRSRQ-Meas","paragraph_zero_based":19900},{"literal_text_all_w_t_and_m_t":"If set to true, the UE shall, when performing RSRQ measurements, use a wider bandwidth in accordance with TS 36.133 [40]. The network may set the field to true if the measurement bandwidth indicated by allowedMeasBandwidth is 50 resource blocks or larger; otherwise the network sets this field to false.","paragraph_zero_based":19901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19902},{"literal_text_all_w_t_and_m_t":"–MeasObjectId","paragraph_zero_based":19903},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectId used to identify a measurement object configuration.","paragraph_zero_based":19904},{"literal_text_all_w_t_and_m_t":"MeasObjectId information element","paragraph_zero_based":19905},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19906},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTID-START","paragraph_zero_based":19907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19908},{"literal_text_all_w_t_and_m_t":"MeasObjectId ::=                    INTEGER (1..maxNrofObjectId)","paragraph_zero_based":19909},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19910},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTID-STOP","paragraph_zero_based":19911},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19913},{"literal_text_all_w_t_and_m_t":"–MeasObjectNR","paragraph_zero_based":19914},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectNR specifies information applicable for SS/PBCH block(s) intra/inter-frequency measurements and/or CSI-RS intra/inter-frequency measurements.","paragraph_zero_based":19915},{"literal_text_all_w_t_and_m_t":"MeasObjectNR information element","paragraph_zero_based":19916},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19917},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-START","paragraph_zero_based":19918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["522fc2c377d082913200e2580def81299dc8632e259a2a951bb2958ad3445434","3b8d034ba3caeb4d4aae4ac5df87f7fb749a7261bd057343bfeded52531b89a1","0b2e3a9f787bc25560fb3df310df8f06cd3b9f354c0337f77aee80531b2b149a","67630efce6be335e20feb2996c3ac27bffca41a97708cef61e1217ccebb103bd","7e7e7035e81607e8fa5635d9e611c22e2219e000d828a9e08b8b613749edfe33","69cdab6bcb484159f0d499e88b62fa10b8eb989cd4a52b000e9d06d79a834e49","b71312de9c886e8cb84d95bce2eaac8054a8de6c20c809b9e4e8dfe85bad3b8f","edf49b625ebb95dbc9648987bacc981fd835381670df20a4e0b7f669309b14a8","2dbade93c56a94d7bd4b883d236ab0be4fd3fe118c7988c54d439e14125949a4","cf75990c85546ccf8c1dd7cb83b9fbe01c846602014406ed5eb58c0f3f5ac629","4fcd60e6ffd8908e5b6fbb8682f87c09722fc9ae7545894e7bcce1ca5054ef95","5c3711631a9bb7e16cbdc0aa54eae754e187d969d26b2ee991aadee863a55a98","8ac1a028040783de651855957f624d1664b8d78067ef0e3b3a9f3da7ecf9c35f","afb90b54c58e9bce3410b9e7e2adb410fe216c7889d1a37f69