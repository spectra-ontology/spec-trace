text_all_w_t_and_m_t":"sl-CSI-RS-FreqAllocation","paragraph_zero_based":2873},{"literal_text_all_w_t_and_m_t":"Indicates the frequency domain position for sidelink CSI-RS.","paragraph_zero_based":2874},{"literal_text_all_w_t_and_m_t":"sl-CSI-RS-FirstSymbol","paragraph_zero_based":2875},{"literal_text_all_w_t_and_m_t":"Indicates the position of first symbol of sidelink CSI-RS.","paragraph_zero_based":2876},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-PC5","paragraph_zero_based":2877},{"literal_text_all_w_t_and_m_t":"Indicates the NR sidelink DRX configuration for unicast communication, as specified in TS 38.321 [3]","paragraph_zero_based":2878},{"literal_text_all_w_t_and_m_t":"sl-LatencyBoundCSI-Report","paragraph_zero_based":2879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["804c2a8b50fad7d5cc55c1b7556c28042f537eba7aefe2ca2669747dda53d170","84166d2ab15b7f62c338de57f8ea79900707ba29f9b7373bb8fa3cc4433e6ccc","a279b939313498f521c04fdac30539a74f3d0187210a40a756b5eacd44d68007","264038271cc75d7c819753126bc0e30fbfe8df9566366044d1728ff099be8ae3","79c89ac18947a6d8391ceae67c5eada887dbdf5c592fa878bd72243eb2a63430","287df78ce57357e10fd4ad23c2a932ee4301ee99395fa1b12509c99eb35ea9c4","048d0959a6cd850c60ee6f891f2fcb4648f139fa0827ed3e2d0ac36a10c4baa6","c5bf832ee52d83559d49b1297936b5cbb7f346ba2dd26e81840a3682729e4fce","5a898d10d80c99a27eb83fe29d702f5767b7bab8868cd15a01cb15007ec5a8bd","8c890052ca2b456afc80f6834105fca7046b3a8a84dedf9093cd53b70f617da8","3ccd7002a6e5ac12bc97d60bc873a0b7c572d1dbe92d459d707e287d8c16f56d","ff6f0e4cbae4f86cc6faa6a27ee39721ce6b16a491b61d7c5195915b0cd09564","9043d441977813caf19d41c5367f6e5febfacab3a0b554f70fbce13607bb6f42","b9aadf0674f5c46db3f21c87b613e4