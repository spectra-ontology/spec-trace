{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":1992},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":1993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1994},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1996},{"literal_text_all_w_t_and_m_t":"–UEAssistanceInformation","paragraph_zero_based":1997},{"literal_text_all_w_t_and_m_t":"The UEAssistanceInformation message is used for the indication of UE assistance information to the network.","paragraph_zero_based":1998},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1, SRB3","paragraph_zero_based":1999},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":2000},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":2001},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":2002},{"literal_text_all_w_t_and_m_t":"UEAssistanceInformation message","paragraph_zero_based":2003},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2004},{"literal_text_all_w_t_and_m_t":"-- TAG-UEASSISTANCEINFORMATION-START","paragraph_zero_based":2005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2006},{"literal_text_all_w_t_and_m_t":"UEAssistanceInformation ::=         SEQUENCE {","paragraph_zero_based":2007},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":2008},{"literal_text_all_w_t_and_m_t":"        ueAssistanceInformation             UEAssistanceInformation-IEs,","paragraph_zero_based":2009},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","p