esourcesAlt-1-r16)","paragraph_zero_based":32002},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":32003},{"literal_text_all_w_t_and_m_t":"    nCJT1SP-eType2R2PS-null-r16  SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":32004},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":32005},{"literal_text_all_w_t_and_m_t":"    nCJT1SP-Type2-Type2PS-r16    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":32006},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":32007},{"literal_text_all_w_t_and_m_t":"    -- {Codebook 2, Codebook 3} = {\"New Rel17 combinations in FG 23-9-5\"}","paragraph_zero_based":32008},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-null-r17         SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":32009},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":32010},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-M2R1-null-r17    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":32011},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_based":32012},{"literal_text_all_w_t_and_m_t":"    nCJT-feType2PS-M2R2-null-r17    SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesExt-r16)) OF INTEGER (0..maxNrofCSI-RS-ResourcesAlt-1-r16)","paragraph_zero_based":32013},{"literal_text_all_w_t_and_m_t":"                                                               OPTIONAL,","paragraph_zero_bas