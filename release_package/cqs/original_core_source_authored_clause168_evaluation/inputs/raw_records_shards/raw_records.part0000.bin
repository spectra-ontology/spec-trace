{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"GNSSIDSBAS","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the GNSSID = sbas; otherwise it is not present.","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"TimeModSup","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-TimeModelList; otherwise it is not present.","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"DGNSS-Sup","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-DifferentialCorrections; otherwise it is not present.","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"NavModSup","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-NavigationModel; otherwise it is not present.","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"RTISup","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-RealTimeIntegrity; otherwise it is not present.","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"DataBitsSup","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-DataBitAssistance; otherwise it is not present.","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"AcquAssistSup","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-AcquisitionAssistance; otherwise it is not present.","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"AlmanacSup","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-Almanac; otherwise it is not present.","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"UTCModSup","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-UTC-Model; otherwise it is not present.","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"AuxInfoSup","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-AuxiliaryInformation; otherwise it is not present.","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"DBDS-Sup","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports BDS-DifferentialCorrections; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["2b4f68186823415e745b5f1026ece33a1294f878e311cf484ea7d972ba53db30","38e9bc2d9d55af7b815d738486932379bebc0f515630848d677af68863d58c77","10d7a95f5f1cde2798c87cf87fcda28d7e0bd23e7991eacae6abedce5627d786","39b044aa0bda2395232942741090cfdf574769181b4bc8320f8b816a6837f776","ee0289abffe96b11da93e3a941d3fb86faab8e37475d3c63b460caafe39f4bef","fddeb6c560bebbf8436bfd1692ebfc9c33b92bc2f66d35cbd28811a84c367da0","f96c0813c4d70e7188148cdc562663b254de8b051e25f3dee3decb0f58b2fa5a","5c8fa35cb6f82d407322ec7f5e111334a5300c8d6ec64c6e3f76273f3faa879e","974951664e9e0626649097e4f72efe931570b801cfbbdc44a40