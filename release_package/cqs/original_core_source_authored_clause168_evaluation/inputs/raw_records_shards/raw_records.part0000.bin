{"fields":{"filename":"R2-2300389.zip::R2-2300389.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c7e60e196f658e3187eac15b2334b6457ddd7091cde40f923c6d5d20e088fd75","original_member_sha256":"1523b9101b790ceb291307f49f9833fb440bf047f8e1a28422ad262497223b44","paragraph_ElementTree_utf8_XML_sha256":["e119a6f8beb7bd154841ef0b22664329dbf68fa4d975e0e26361f084641bc358","3aabd151f1949f32dc55d1bc35113e90ca3e854bcb7e6c83e8512e5c6bc5b8a0","13730e83ee9b771e7ea0a5b0e288651514426e8b699bc4a4de84fa878c2ee452","bc2fe30c3fc74e754e2426c05e562f4da4b116b4e5a75c734a2fc197b68fc2a6","e4fee192f8e881c1f1df7b7b9868b81eba5cac926156c501a8bdb82b98246c9b","02d95ec3620b8c3026bf532e7681bf5f5fd34c72554371a91c156439af197fff","3f9cdecea7677e68eb2d9a064fac1246fd08a353842d36911e1458ca43e11522","48e237e0d7ee67e74496babcd6bc801bc190ea2f32c882b653b996e4dfadec6c","5daa6471d7fa57b6c3df16ee3acf15386eec1e3deb4e9eae7add548c2b2f6207","af63d5ea69e6c4b41fd8001868d2b2cbbc8d31186640410232690d032ba4c3cd","fccb0b6e690b39d192fd9f2b4061a6584788ed963f272d6df8da712fa693ab39","69835d517ef4248db8ffaf33557fe05586fe726df023ec050d497bf9e33666c5","69e361d0eecc589ceac930c25f0e6499a913a3b77feb830423851e3dc4159041","faf41555ebf3bed244c01d3a5b58bfac9823696de80d7e990274632a0d791124","52d73beb48e906dab399db2422a4fd67ce968963ebd6743e7feb2563046c3a8c","56be0a89db76e1dc51fcd6d653b38537a5eb9f0db01401a8cba1022a3aa27c63","bba2eaa44cc4d85550a27dd417d9f58187f40d336c378ac889dccbb05b798322","5c0c18834deb1ae4727cf602f6ffd29d21afe20cb38937bc4d6bf8995c6b5e26","8c42a71dc90511bb8d756d97aaaeae3e69a149f7f683da93ccb88b61362bf077","f80107976549da01a04ce48ea13d2d933df314933dbada8684bc311afba9b1b1","356dadbd15b592da988aad9b00a563824a92752b489b3d848e6ca869645d68d0","40ed7be41e890ccf62ceadccb50a81e5076404aff3183ba00c78fbb931187900","de2a05d4a276dc88964df436e3748037ec19ec3f176fd898ecedd28144fe1364","76dfafc85120b979ba7d0f53f9a78dbd0d502363b131833097869bbcda94a5ba"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2300389.zip::R2-2300389.docx:p168"}
{"fields":{"filename":"R2-2300389.zip::R2-2300389.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c7e60e196f658e3187eac15b2334b6457ddd7091cde40f923c6d5d20e088fd75","original_member_sha256":"1523b9101b790ceb291307f49f9833fb440bf047f8e1a28422ad262497223b44","paragraph_ElementTree_utf8_XML_sha256":["78e7ce5bf4e0efa7bf422eb77b8181a57dc0efb5d9fa65c9434011f7d1da053a","1fbda9a769b17fa1928981bbfd932a04f1dd2b77dacb536445e2564ca480a8f1","47e0e42333516fe1a5c9c8606f1d436cc81f58d74dfeb653c5eefd379f553d1d","7527a03e88c2f505be84b4169898583a3653af64962bab3561dbd8e57008e5dc","e46066a32c9072064834477be69cfcaeb40913792135069eaf38f6aa052adc88","ad88030af43f8b6997309fd4ed60494b32365968dca65214f15b35313548fb9c","64b50ab7cff7083be25669553584b90863ddd0d42f30d5d87b373b39c779d0ba","345fcdd5f10789896f91324dc4bdee49adcb9d63e106862af62c158f2b58209b","f443fa99ac0338d5fe71e953d938711f9bf077582f6a9bb5642508c385b4e489","2483b96be79da528651bbd983703a0e21c40d9e02aefb572f359a6da0470e32e","d2b01b6fc03253aa92dfa368859bab14ae113434a0a68a88182181f202d9cf5b","0bfde235385a6b9db2f74b98b477e95c5388011ec1977a698bc7b5fea20d50d6","0f1f6533519c46483df667bc1504b81587cbda6b8a4883c6f646c8c462a6737b","04b2245202680f2d32fc81e70c225ce74d5446276209bca92fe49240864f0c05","14bb007062ab5c7fc49d8c051222c3729791263a863b58e5b2c93c1d62fafd36","f3e5b8561733a1b3d777e9647cee398c6510a0d6b167101ae3a2bb686bfdb1bf","661b8d4aa979cb1c48903f5c495bbceeb42e32e39d82c78a5846d47e43c60f75","43c376439472de17c6c8e282953aa14b9af148f0260d2a5bdca291f8cd472e36","cc9a1bad121b7641b3bdc1b2d9c6f4c843fcb7c851d0782f9ada03d9bbdea1f0","934bd9146df4ff4133a3d9f33478419ca9634bbed0fcbae7845e55f4548a49a2","dc7537e6a7af400aece995a8432a6b4ded7d1a7b514f308de42fa4349aaab4ee","4fd642a0c7981456ba3c03761f68287f8c2d27b4ddbd5012b039a50e8a568904","ed193cdf6fd7f23cf36305e8a7ff257eb1c19dec0930ebfed7c5ddd1383b6cee","f054a9085bae4fd9450cc2b9b0143e62e8cbd7d697f6ff054c3c8bb571560571"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2300389.zip::R2-2300389.docx:p192"}
{"fields":{"filename":"R2-2300389.zip::R2-2300389.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch from a L2 U2N Relay UE to a serving cell ) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"End of Change","paragraph_zero_based":238}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c7e60e196f658e3187eac15b2334b6457ddd7091cde40f923c6d5d20e088fd75","original_member_sha256":"1523b9101b790ceb291307f49f9833fb440bf047f8e1a28422ad262497223b44","paragraph_ElementTree_utf8_XML_sha256":["90855bfaad92673a0ac9b26f0fd7946bc8bfedeb352b4ba008644b1fe57a3134","5dc23f46778b11816a6aa76eb9fd1429be1c6776bbf713249ce4675285d3e949","5f2570a7883be617ed785b3d57e135c3422b962d66ffba12778695b8f52a874b","07d96ace477118a989c11aa7135ce648e295f379ce336af36032843d0e1c0f8d","a5e0a92298456e0303f335a70dd20295a9ce9d4f3a916b9ccb9741f16e94b784","6874c79fb2eec2bd5ae8a87587386d60fe3382bdf37b2a66bc89722f5198fc1a","af63d5ea69e6c4b41fd8001868d2b2cbbc8d31186640410232690d032ba4c3cd","cfab34c6af8a42a320fef144f16ca35a32d7e1e11ef150c378100080bcd3f13f","912753097df50e3f06e61471d37b2ce452e94c3617dc5d88bac851988c906dc2","1401ee3e010a78a45b12fc123763584a3da3dd78b211ed3efa8124d057e039e6","5a51f079e801d2d05e483b12733cce