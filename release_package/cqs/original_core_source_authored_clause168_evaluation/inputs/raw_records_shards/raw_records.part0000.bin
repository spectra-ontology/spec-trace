{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16728},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigIndexMAC-r16 ::= INTEGER (0.. maxNrofConfiguredGrantConfigMAC-1-r16)","paragraph_zero_based":16729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16730},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIGINDEXMAC-STOP","paragraph_zero_based":16731},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16733},{"literal_text_all_w_t_and_m_t":"–ConnEstFailureControl","paragraph_zero_based":16734},{"literal_text_all_w_t_and_m_t":"The IE ConnEstFailureControl is used to configure parameters for connection establishment failure control.","paragraph_zero_based":16735},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl information element","paragraph_zero_based":16736},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16737},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-START","paragraph_zero_based":16738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16739},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl ::=   SEQUENCE {","paragraph_zero_based":16740},{"literal_text_all_w_t_and_m_t":"    connEstFailCount                    ENUMERATED {n1, n2, n3, n4},","paragraph_zero_based":16741},{"literal_text_all_w_t_and_m_t":"    connEstFailOffsetValidity           ENUMERATED {s30, s60, s120, s240, s300, s420, s600, s900},","paragraph_zero_based":16742},{"literal_text_all_w_t_and_m_t":"    connEstFailOffset                   INTEGER (0..15)                                                         OPTIONAL    -- Need S","paragraph_zero_based":16743},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16745},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-STOP","paragraph_zero_based":16746},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16748},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl field descriptions","paragraph_zero_based":16749},{"literal_text_all_w_t_and_m_t":"connEstFailCount","paragraph_zero_based":16750},{"literal_text_all_w_t_and_m_t":"Number of times that the UE detects T300 expiry on the same cell before applying connEstFailOffset.","paragraph_zero_based":16751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9d21599f7963e7f387c5f0a206a5bbe42e82423ee35d18689ec30713d007eca8","e2c2c50a7107b24973ba40111b23f0d7ac4fbc5ae1f343523d14de690ec61cad","f4f14c4caffe14d46f339dd7f220c25c4a6615677d1b4854ce6d6206ca8e5456","b811d81854d47200c1ae7acacc12b89a374911cffa8a0e94be32c9da8d4aa903","61af5a9be07c6d7cbf3a75238b81f0db19c54dd47e5de907a17d44c01129ed3d","5b6e181791a1a88f52d70c06d989dc208a63e271597d927716fd7488380c2478","30404ceabb6566530606c51239f3a70be8dd38f0b42a7c0382a78d5190ecb0f4","8ea799066c29fb12e3b32985ce8cb6ba3a5657abdfca7e0c62cd4a57d9842491","c1c4582a387dd34f6a29a7106e6dc17b2853d55ed050cc791235e47b6fc71977","c4770c47611edb4409d1906c6c3678b675fb62855ec746259f5861e3f16cc55e","d1e4153d028685582fe711aeb6cb3f079d85af7fb37e96c0b0dca8ee5c2c2fbf","1ddc2427c36f04cffda961c0dcc66426efeb6c219f65837cbc8ea10935e8b32a","cd5d1a3cb5f396abc92efc4556574fddc82eba5aace043b2eb996808f2a78e9b","e9d4377424e8d3142951886a9aaf6f8a3ce7549f65bae7f35bd3dad8229953d0","eaea6640c09f1dc24cf4f926a2bd59aaa5cfe6fb7ac016bb9ec39ff4d904204e","3580031b0898ed4abf0771f5641a70ea57720c8be9f9b5d2fba12f30d4eb8828","3e06fcb6ae4c61418ef6f23263943e0e3a62cc0de4f42de2c3dc56fe71fc5924","8e3b05571766390ff23ff3b659409852883e82b73ab19401c505028c8bcf9288","14fd653a752b77d62110561ddacbe926f57d5c82f894376071e255ca96b5e8a1","445f4d58fdcc6ee1ecf59bb39e01c236806d0b4f9a19703263d0aaa616f6955f","4740cf850f85477ec0040eeb6621aa20503aefd155e581180420313f2b962406","8a6232f360de3b427532d9c6edce55b5d901e31283abb2f99feb15a8d5f00c9a","4cf94d1adcdef6e992d7043aa9047cf4ce17a92b75385db752ac6bba8f8171a6","b5b2d5566b64391cd6f773b48b4aaae52b976e79bb39a7bb2a64470903522be3"],"paragraph_range_zero_based":[16728,16751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16728"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"connEstFailOffset","paragraph_zero_based":16752},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsettemp\" in TS 38.304 [20]. If the field is absent, the value of infinity shall be used for \"Qoffsettemp\".","paragraph_zero_based":16753},{"literal_text_all_w_t_and_m_t":"connEstFailOffsetValidity","paragraph_zero_based":16754},{"literal_text_all_w_t_and_m_t":"Amount of time that the UE applies connEstFailOffset before removing the offset from evaluation of the cell. Value s30 corresponds to 30 seconds, value s60 corresponds to 60 seconds, and so on.","paragraph_zero_based":16755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16756},{"literal_text_all_w_t_and_m_t":"–ControlResourceSet","paragraph_zero_based":16757},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSet is used to configure a time/frequency control resource set (CORESET) in which to search for downlink control information (see TS 38.213 [13], clause 10.1). For the UE not supporting multipleCORESET in FR1, in order to receive MBS multicast in CFR within the UE's active BWP, if a CORESET is not configured within the PDCCH-ConfigMulticast, the CORESET other than CORESET#0 configured within the UE's active BWP for scheduling unicast can be used for scheduling MBS multicast, and the CORESET is expected to be included completely within the CFR and the parameters configured in the CORESET are expected to be supported by the UE for MBS multicast.","paragraph_zero_based":16758},{"literal_text_all_w_t_and_m_t":"ControlResourceSet information element","paragraph_zero_based":16759},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16760},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-START","paragraph_zero_based":16761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16762},{"literal_text_all_w_t_and_m_t":"ControlResourceSet ::=              SEQUENCE {","paragraph_zero_based":16763},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                ControlResourceSetId,","paragraph_zero_based":16764},{"literal_text_all_w_t_and_m_t":"    frequencyDomainResources            BIT STRING (SIZE (45)),","paragraph_zero_based":16765},{"literal_text_all_w_t_and_m_t":"    duration                            INTEGER (1..maxCoReSetDuration),","paragraph_zero_based":16766},{"literal_text_all_w_t_and_m_t":"    cce-REG-MappingType                 CHOICE {","paragraph_zero_based":16767},{"literal_text_all_w_t_and_m_t":"        interleaved                         SEQUENCE {","paragraph_zero_based":16768},{"literal_text_all_w_t_and_m_t":"            reg-BundleSize                      ENUMERATED {n2, n3, n6},","paragraph_zero_based":16769},{"literal_text_all_w_t_and_m_t":"            interleaverSize                     ENUMERATED {n2, n3, n6},","paragraph_zero_based":16770},{"literal_text_all_w_t_and_m_t":"            shiftIndex                          INTEGER(0..maxNrofPhysicalResourceBlocks-1)       OPTIONAL -- Need S","paragraph_zero_based":16771},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16772},{"literal_text_all_w_t_and_m_t":"        nonInterleaved                      NULL","paragraph_zero_based":16773},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":16774},{"literal_text_all_w_t_and_m_t":"    precoderGranularity                 ENUMERATED {sameAsREG-bundle, allContiguousRBs},","paragraph_zero_based":16775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1d2f208102cc0934a639