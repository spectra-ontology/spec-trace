9c90bff7d94c2c25ad9560c87b850c1ebf0c8af62cc72","7a919a3c1348651c03b42fdb14661fd1bae611f8a3088ab6ae98fec715de4bde","d7d61145e859d30018628aba7487421f0e2eb415fe7227c53d56daae4265de83","cf4e05c47c0896226469244a62fed9583cf824ee95ad59d0788c380ca26377c3","ed1b74e29f2bc2672fad71c5be6987e8450c0d95a8d696b5614faaf25238ccd8","3c1525fa518a8d33c1aada2dc96629b4e0451591a16b4a79f5c820a076b315ab","cfc07a4fd7dd57b415b0a0d50c8ef1fb376391f62d2f0ac4573ed3f4dd7423d8","98adba1e8ebc611d969a467930a3d5f14fe528023c6bd519d1bda600b3694b35","9fa109f148ac4d3cfff8f7ce6d374be7ee12fbe9002b8d35c8a77ffe7dcde36f","bca9676cbdc85c89922379d4ed4b28b924f5f9279e3eb4f2879e2607d87b25d3","eac0e97fe7bd7c85f201a24bd833e4c23ab3143831b6d383bd4da4e8cc96c57b","9aa3a9824e80c9b1cb765223ec7aa2c32be13bb17629bd53c504dd55b4053235","7161b6ef08bdef29e8cfc74915a80fdb5bda77e3d4433ae9fe30f966d4cf4bc7","e9922049e930b37949a4fb513672dee1be27a041370dc81fdfb48e4d808f3d1f","e3666efe573addc94d064d56096eb332614a695763054434c12c26e465419d17","42b329b193073fa9e8e11b6219700d97d69f1ffcb0b3d52cc5532b3911f88598"],"paragraph_range_zero_based":[10056,10079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10056"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":10080},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":10081},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":10082},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":10083},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured or if the masterCellGroup includes ReconfigurationWithSync or if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured. For conditional PSCell change, the field is absent if the secondaryCellGroup includes ReconfigurationWithSync. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition.","paragraph_zero_based":10084},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":10085},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":10086},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":10087},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":10088},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":10089},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":10090},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":10091},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED.","paragraph_zero_based":10092},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":10093},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":10094},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":10095},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":10096},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":10097},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":10098},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":10099},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":10100},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":10101},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":10102},{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":10103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ef4af332c5ff89d92b627f3ff0209b37326d46f6beaf90f0bcc0a3ed83300753","0ec774f5574509f773f850c4d791035e2aeb28c0e8fafb7e382f3580d5fc2988","592308c2cf3ac8e15992cc932105b3f8785bfb17f6fe3e6e1ebf52eec19b60cc","0606461b4c80c6f683403f88ed0b6e09f52a10b4fd90fe1cd667f78c45bc628c","00eb40ba4167c699abb5cf40ab6e21e1954cfbf41ebc2dfb5f24d8ca7eac5480","42ba806587c7f5c8a95ef29df0b405f4e3cf4256315ae3b31ac89bf59c0bd76c","1a6ebcc8eaf53e33e748203f4268a5882304218232798ecd518ab5bda514b62b","088cf9f3bf8e92beeea446593cfc3977a30e67899e1fa019f7bdfef4f5e4b6bb","35a40ebe639876b4866a2664660d4dd7c717710736c84357e6ebcd200424475e","9ac4bf129cc7e8972904d73c6941a6e943d4e995b549c06320a6a737af02ad60","e8daeb09465863804b48b9a975b12bf7564296e1214e8d7b45d86b94bb4f8e79","e9b4d16a7a729af0ca6be2b8222ad79448cb188ce0ca0d1c355f2602995e34c0","9bbdf38e9966181edd4ba6d9f012205a6c5b2890ff138e39d27bb21c740d4e5d","7cb7162d866a40ee72afe3a7663231979b57d5b6a750e54278404a341462d334","a6bb1dac95f73adc62f1e80d12b947143e11dc01f5cc8d656edee92d5b77971e","dfe1a2c5c22d33b0e18f6a9bd2b9bd263b1960993490b13692b92f730352de8c","bd25f06687be0c06dd3af43e21669b2e58ca69be1153d9d15542aee188fa6bf2","4f62b1729add3e4c7219ca61d0a775964863ab41111b6ff4fca706a89c77ec5d","bc6c8954b7da0e2add7d9bc1a814c855e643fff036604abb16bae17ea8a572d4","2d6c2f19c338700c175da9a36d84194ebd2c539f63936893814780690f2eeb0b","6942790c184998336f755e333a9fb917f95bfa3bd2edd4388b61901eaaae9a25","27c08cdabb5f47d1f5d0972d0e99461dc96b4c46679c3ca19024e31874471769","2172b8b0c97345286abb1784cb96524132ce57878d1ea60e9a7470d0463131ea","3ea0bd9917b0577185a32cc3623e32466a288a6d63accc48279a9d62cabfa6f2"],"paragraph_range_zero_based":[10080,10103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10080"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":10104},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":10105},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":10106},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":10107},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":10108},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":10109},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":10110},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":10111},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":10112},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":10113},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":10114},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":10115},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":10116},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":10117},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":10118},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":10119},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":10120},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":10121},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":10122},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":10123},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, measConfig, bap-Config and IAB-IP-AddressConfigurationList.","paragraph_zero_based":10124},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":10125},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":10126},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together with concurrent measurement gap or preconfigured measurement gap for positioning.","paragraph_zero_based":10127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7cf0acc2dde9e5451b4a57be69f31d78f0727bf07c82d6699910f5bc96b56712","61b68e43983a472745a361fed00eeee30b0b5320161759c52f313e433f80239c","e6edd34bd032d4ab2ca6422102e158aa61f4b192d8a6c0986a7582efb98e12a0","9ded816c7fc6899d2eebe1e96f3574a5816dce3eaa569e13a14df5f145aa519e","b1e3c9be1eb113db4ced5ed507cfb3c6d7d5d93dd754bf88507edd9aa9f4e952","73036daf7faf15a90972493a930a4d8e6f59460d942255422d179fd37b16b680","a4442f5c0ace838dc6725313150ab14c1aee08d4aa81b10f7df51321613225f4","2f04edd956075941ca6e952eefe6605b65248b46840d07e461bcca5f4c7999da","40273fb4a738b61937f0dfc690aa8aee83a259ef46a3d96c5b8e5a89da8003d2","80f8cdb7c2e52014f99d47b45a2435d57265b051e19aa84a29aee91b4ef63499","07f9001c5b5e3a49f164dde6b2ab09888ae0bd374bf76c4536b517d8f5e09dab","390ffcdec63eee57b3424be80249f4a4c1ea5f1df775ea992c2cd1199d0391b4","c561d191ffb451bea221de0261d7e0705937ef58db0b27abb69004c1bbc1440a","5d6951a2f555e766d03d61274c24a58d39cb9d56ad1c84f4d675e73a4bdcfead","c5b2d7d349b9408a143fd5f25645da68626c14ecd1c1df241879f5ec33fd64d6","bc155ce36a6e55929b382019d945f492097fd1196828310561e8b5a139a93d31","841da9b71b746f00566298259357c39da1dcaa53e15aa9409ffeb24b360edef4","f20119558ade3abd91da7524d2eacdf6893588c94223207b2ec876fae5b036f8","3db7e4585757e803e1c2cddc410f2b015bc2e2a9a51039fe2efd6212499c8b92","13496d229c8559b4fbda09d0b07f91e7a013dead3e7a2b71789aa659acc56dc5","39bf7eb13bbe730e0d32c89c2c847438fa3599ab4f23fa7ee97001b9a7642aca","5b5c1f352a3c14ca065f6df538a6db0a7efae4dd530f6a841b4a503787530c26","a1f6c78f58b35e07743192ce337dff93ba539e1c21b06673a54cbdeb9da38931","4d36b24a5597d5999dfe6991f04d3503288a31a35ff539b5f3ae34ff04b0649c"],"paragraph_range_zero_based":[10104,10127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10104"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":10128},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":10129},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":10130},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10131},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":10132},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10133},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":10134},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10135},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":10136},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":10137},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":10138},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":10139},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":10140},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":10141},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":10142},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList, obtainCommonLocation and uav-FlightPathAvailabilityConfig can be included.","paragraph_zero_based":10143},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":10144},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":10145},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":10146},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":10147},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":10148},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":10149},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":10150},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":10151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3eae60084f7da4ecd5a243478d3a4126540ec33e742f8a451e3707ef580d277d","c24e584cd41c0033e4a91e6e8a877c96d953f0dc60adbc120b3d570207b65a8e","022cd2b0dcb689f4fbb0d914fb7efd3f3487b85618138c73dd455b662c7d4d16","5efb0e9aabd473612b55b47e7e5afb2570f1366688b507deacebe62b1103a223","c262d4c2071357f23cadf4f81338d7605495c934db4933699bb88755f32382e6","9a5a08a6c576c22a6f98f4f3145dcf5156143e787e807729e5534724806b7bf0","6ad2da57029f4330a751985895cc8e82e2bc17b6a81cf696f5771a9e0d7e686b","9461b629cf0dc7def54dd2b9cd54f7757e6f81766c251640f8df87bd5e14e776","afce3b80ca992475b933ba84b0954313978d8f8ca3b80a009a26ad6e1a8a3627","d23208f3ed61255a0b1c830c52c288db94bfa32c0b3bdc04daabe4caa00bdaa6","96c1ebe9fe09f4bc52ab80d943c2987ab9865a7bbe7f2a59c9aa5f70212c0256","e7c0d47b69c8b944045b7f3fc695349bf550643507766df4a6572f3491af3a0f","d0ae142456d479147b0c56bfea2d3b349febf40ae4739c05ea20932b70b9e37e","a9eae90800cf2bee2c068f8704c760f408322f29c38ed5ec2159870b3e34f7f5","6f9f8bbcf7c793196672c091c08f2a8df7779c6a0b15f705fea640b701dfe308","78c2de33ad152b5b61a22720a8e76fe1c8c454d3ac7b46d422dbc518c248dbdf","f4383b1fcc25b22c54c25285df660c2283ffcf446bf6282d4122ed845800ab1b","750b436d520f8bc70c77081bcd4cee8ff57f5c369b3fd8ee4adbd0331534eae0","d7278c9616bfbf3bc94cf93dc39e3a785aa67ec8a68b8f7b8e1acbff2640454b","4247415c9b9c1711c27def83e6099110dcaee3b88adf5ed1c732c80c9f935723","d034d1942c375f821a05989a665816a9f51c676227a1b922e9d1c631693a5e79","628598e4c26c85f22d37016b8594794cc06e9c1a2c47be893db641fab1fdd872","edb6b55fd787189190c4b32efa5fc328a03da6d2d9516360474abe58b0bf12b6","4f28d8f7cdafaa54432e996f8adcd9b47d211851b4edf8d6e8ad981d4d5f9a6b"],"paragraph_range_zero_based":[10128,10151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10128"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":10152},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":10153},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":10154},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":10155},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA or CPC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig.","paragraph_zero_based":10156},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":10157},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE. The field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":10158},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":10159},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE. The field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":10160},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":10161},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":10162},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":10163},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary.","paragraph_zero_based":10164},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":10165},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery.","paragraph_zero_based":10166},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":10167},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":10168},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":10169},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":10170},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":10171},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":10172},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":10173},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":10174},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":10175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0d73d5bc41d8baaff9acf5f5b5668d8782856fd6783a049b09360e03af4395e6","cd3dbe6b35ccb7887970fdff91da8fbbe0b27721f40faf145af383d95865e87c","08173b74de4f009aac59900dcb453ae7343e965f881902e7b40d316980ccc3d7","19175a97a2313c2ab012581d4a6a8f79aff9cd2c5850cd169fce9f597be4965b","3aa050121097a01e2547f6ce23e0b30ae1b70bee5471c6082f2b1eb00237d45e","e4b2c05fff39a68feafd43d05df488027f4de6ca00853206b56fa5f644145fef","f3d3670a9c18d2b7cba8de64e637d1a38ab124207cee5824878f189923fa767b","c140093b6c8fc641a5cc3d54a0537dbdd1fffa553a03841207f2447c93e26abc","a44f4384855e97db4877e86645c30eb55992076debf0957014ae7e8d841fbc31","5aeab6e050dcd610a15712d057e443a12dbaee4f6ef49906af54474e8a19c242","f3e057124f91aff1139c465b1e84f0e8404ef7233818e5fef7235a4ff9c75822","9a53bdf2155d8083c490e1cb229995a2f6ba23a83b73df1f8990d71c35627f45","98a945c18b48732c4855a779a4cbba002c89b85fcce0312b15ac8a301f540073","96f6aeeaa5bc83675cba56319037089e673247e1c17af5cf4a9ff5bb2e5d4952","3239c4cc32f73d6300678c3942baa27daae87ef0ffcd2bee0c93342800a6024e","0ba8e1d19b611d9fc4b008113f2c0aba4b3553b956a23d9d5926f83c80e382b1","4eb3c617fc6dd584aa8972beb59bbcd07460b2cfe7267773158cc1c01fed64c7","d1870d25272eb4a266f505c51824dd7899cf6dfe87cc763dcf50f683cfda6a65","fb5cce904ad1c6c2d559d6c819f2eeadd4f405fb8613b6040c6635f9aa640a2c","99f8b06eb405a5cf5cf2ff7b0e8e97ad5870694cfb7bea2b61b3e9888bedb91f","c921b4d736d8537adc8e95f2d746913080f62448b916394e00cd8fa8d36a7e44","17b748207cf9d56ccc236173baee639be602334193663115354a9da3a2dc6c0d","c306beda45e4533a6055fdb7d08fe57b7914437a7ec6a6abda8d9ad44f3ee63a","d89453914adf840761fcb1b144a6705616ee9beeb86dd34c944dd244e2e0c394"],"paragraph_range_zero_based":[10152,10175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10152"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":10176},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":10177},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":10178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10179},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10180},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10181},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":10182},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":10183},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":10184},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":10185},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":10186},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. Otherwise the field is absent.","paragraph_zero_based":10187},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":10188},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during reconfiguration with sync and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":10189},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":10190},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":10191},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":10192},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":10193},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":10194},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":10195},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":10196},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation)","paragraph_zero_based":10197},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent","paragraph_zero_based":10198},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":10199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3f3346a44b2a4d9116fcae03b9504ed3a91c005e22392ba6afc109e9ee7b69a3","78efaa5b348f58ddf8bc2d88a918ad16e9f454c71e6dd7d5b1805970603f1274","8f6210c65c996f146630b38fd62b8c08fa8dda531daed4cea09d828abd7de719","dc8c1c2c9e2034e8ab05591fdc6426b60e2f9ec40fc4db45075cc1537deb0a75","15c84e34a5978436ef9e23b420d194e475f679a19bcaf3597659b3601921efdf","882f46b622f2ad6494e35e96497133672e64a82afdefebac185327f9d1dd17c9","b991651a32907a0355df144e33f11b5bc9034daa048354d814999b72899bd3d4","67187b4cb276a2e0e9492841c62319eb99adb4755236b0945713249b2c770e6b","3c6fde2b4736b882f62527f3c7bf6353e0f05b5f1c5e72247211efec35b5af98","e17c5738a74a9b3e0ec223eb64334d0319815f9d66c8aea847154acdc85d4a60","4e71683f71dbc13d800f86629023a3da8a118befcbe6bfce4ee6408ae0c3f57b","afdde620956af426b8fe250ae4de65c57ccd34a23a9d34b3812cd2293474c519","8ef6b8025d9ce0a05451e34640b8f2582376efe312c13ce8d5766a55904fcc0d","732f32aa04e96cbde151a4e115ff64e458c23435fa49967e99225acbc7fbabb8","5fe3b07e3bf04748d9cabe82c2ed6e08b26d036b3c93215345e0fc4705d61b2c","df5bc95b6ed2b10a9ee159a20f681e5bfe8ede92e6c1c0d5c62d93fa507ceb35","30e1f81b66f82c1d4792258e596070d70e7abc4d52533cc4701536349e3d769c","5d77d830dd8a1f81958e92e906a58617d935c9e00038dc80f77ce20a6d209308","672b2adae2a7a5bd9eee9a7f86ec00bbca3005e6e850a4ad9c9