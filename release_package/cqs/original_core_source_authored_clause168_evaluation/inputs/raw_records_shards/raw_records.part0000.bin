{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":28272},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":28273},{"literal_text_all_w_t_and_m_t":"    valueTag-r17                            INTEGER (0..31)                                             OPTIONAL, -- Cond NonPosSIB","paragraph_zero_based":28274},{"literal_text_all_w_t_and_m_t":"    areaScope-r17                           ENUMERATED {true}                                           OPTIONAL  -- Need S","paragraph_zero_based":28275},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28277},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-STOP","paragraph_zero_based":28278},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28280},{"literal_text_all_w_t_and_m_t":"SchedulingInfo field descriptions","paragraph_zero_based":28281},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":28282},{"literal_text_all_w_t_and_m_t":"Indicates that a SIB is area specific. If the field is absent, the SIB is cell specific.","paragraph_zero_based":28283},{"literal_text_all_w_t_and_m_t":"si-BroadcastStatus","paragraph_zero_based":28284},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of si-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting. When SIB19 is scheduled, the si-BroadcastStatus for the mapped SIB19 is set to broadcasting.","paragraph_zero_based":28285},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with si-BroadcastStatus set to notBroadcasting in the list of concatenated SI messages configured by schedulingInfoList in si-SchedulingInfo and SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when si-RequestConfig, si-RequestConfigRedCap or si-RequestConfigSUL is configured.","paragraph_zero_based":28286},{"literal_text_all_w_t_and_m_t":"si-Periodicity","paragraph_zero_based":28287},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames. Value rf8 corresponds to 8 radio frames, value rf16 corresponds to 16 radio frames, and so on.","paragraph_zero_based":28288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28289},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo field descriptions","paragraph_zero_based":28290},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":28291},{"literal_text_all_w_t_and_m_t":"This field is not used in this specification. If received, it is ignored by the UE.","paragraph_zero_based":28292},{"literal_text_all_w_t_and_m_t":"si-RequestConfig","paragraph_zero_based":28293},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28294},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap","paragraph_zero_based":28295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7944eda22b9a05863c0ccd1af780194db77d709396384933eb928d3ab859acab","793756a05a4a7880ec71dc439c12da58dc4d6a428be0f901de183bcc03537446","34f2da974aa4dc8894db720b2c2c74be2385b37af33b16a455148b7506fb0c06","6e3af85ca884adb849d90f2223b4a401a2a12da1f813ed7a68adc440c280c1d6","fe4e8b189cca256b7c49ae6b1d18ba782e965ae0ffeed2b31112d0efe0bff002","5e66b2ce6b5910c05445c635e8962f4559cac75e2f478cdfeaf945679357a2d5","ca80041638ec198cb32b0486e89719dfd66d0faaa9d89f7c8dba46eb845dc2b3","96f843cfa1e22e2b6b5d89952ce51f4045681f5fe44092d411891b3f42960310","45393730fcc2e79ae6e0d2188255cd8c45db1ddfce10d0d0adb965d1e3bdfebd","25fd6a7c383f6bfd471ac2d7e6d88be7392d1a953f64565e8109ce8397afc314","a917a8595ed3aa93a9eedc9f6a50982a8add7998895c3bb7f56b1a719f226f8e","64db7cbbb428284c4c93d7bc3e9d4fdfabbc43089f44033cc78c0b9a8a7a32bf","809322b3bdbab4169b6d4109dfd234205496fda0d1bfbc58ae0582902ca858eb","c82c422ce44112d53a3c650aa8cc16d0958741e94f18e737f0b2e12dbc4d9059","6b8c6e5369f9b5a94ddefeb9dd96179eca3a50ed3873ef5115e81909325ad4d0","1cc51e0623ea92cd5125be257bdc2398e2dad9017056b73fb0663a779498c523","ffebcb1d582a9ef848518a03e10b1908810a8dbd0def5d36832ef3117bed99a7","496439dc01b218a067918d79121302b28ba09bd6df8524840d3727683f9c57b1","13546fb03d426b598de848eae282de540237b2484acd7261857ebb4e543a806e","6af5822f8bc05a0dcd09c82648b666e0e7819acd2ecfabb22c6936e368584b85","bfd3e827fb87b2d23ac276c8bcc1d33ffbe4b8a0686d44ff362431a8218beb01","2f34eba40eda0b2c15c791f693fbc0b5490496636c7d1667cb50b41b231490b8","48975cd9a1b1d18f6bf61b2e040ecd76524455c1893321ba91013eb30e36c5b6","a84e6bcf32134e1ec8520b7f755ac6b5b622718cb7ba1c36168367f005fe6d0f"],"paragraph_range_zero_based":[28272,28295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28272"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28296},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL","paragraph_zero_based":28297},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":28298},{"literal_text_all_w_t_and_m_t":"si-WindowLength","paragraph_zero_based":28299},{"literal_text_all_w_t_and_m_t":"The length of the SI scheduling window. Value s5 corresponds to 5 slots, value s10 corresponds to 10 slots and so on. The network always configures si-WindowLength to be shorter than or equal to the si-Periodicity. The values s2560-v1710 and s5120-v1710 are only applicable for SCS 480 kHz.","paragraph_zero_based":28300},{"literal_text_all_w_t_and_m_t":"systemInformationAreaID","paragraph_zero_based":28301},{"literal_text_all_w_t_and_m_t":"Indicates the system information area that the cell belongs to, if any. Any SIB with areaScope within the SI is considered to belong to this systemInformationAreaID. The systemInformationAreaID is unique within a PLMN/SNPN.","paragraph_zero_based":28302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28303},{"literal_text_all_w_t_and_m_t":"SchedulingInfo2 field descriptions","paragraph_zero_based":28304},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":28305},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":28306},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":28307},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":28308},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":28309},{"literal_text_all_w_t_and_m_t":"The posSIBs as defined in TS 37.355 [49] mapped to SI for scheduling using schedulingInfoList2. ","paragraph_zero_based":28310},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":28311},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":28312},{"literal_text_all_w_t_and_m_t":"si-WindowPosition","paragraph_zero_based":28313},{"literal_text_all_w_t_and_m_t":"This field indicates the SI window position of the associated SI-message. The network provides si-WindowPosition in an ascending order, i.e. si-WindowPosition in the subsequent entry in schedulingInfoList2 has always value higher than in the previous entry of schedulingInfoList2. The network configures this field in a way that ensures that SI messages scheduled by schedulingInfoList and/or posSchedulingInfoList do not overlap with SI messages scheduled by schedulingInfoList2.","paragraph_zero_based":28314},{"literal_text_all_w_t_and_m_t":"sib-MappingInfo","paragraph_zero_based":28315},{"literal_text_all_w_t_and_m_t":"Indicates which SIBs or posSIBs are contained in the SI message.","paragraph_zero_based":28316},{"literal_text_all_w_t_and_m_t":"sibType","paragraph_zero_based":28317},{"literal_text_all_w_t_and_m_t":"The type of SIB(s) mapped to SI for scheduling using schedulingInfoList2. Value type1 indicates SIBs and value type2 indicates posSIBs.","paragraph_zero_based":28318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["096d1bc6ef894fe5ad8fef784b1dca0da99a214745489a05295a9e3da39ea3c2","2130fefcef970c903c3a8d4267066eba05e3a20cffa847c0d247c7ef0ce273d4","b032507f27577105095424587ba7f60616390f7801872325f24608e3cafd4eb0","7c1fd7c13fd73aca141bc26a4a1a71a78da8d35c9b4c93508d1acd3229b1302b","df1ee34144fe1108ffc9907126606adc3e39ff3908cb1d4decc011a5d54bde4f","028858d280fc5ee424420c540c9b478e18f59bae677e08d88f9bc05a5c1191e6","df9cf69cdca2a8923056eeb701beac76e7f3301b2d2f1640552a4e7f47325400","d415e5d2afc801b57f92ad2d4c08fd6e4c7a2eb44e9289fbde5bdf95d9251751","5742144d535456e74812ef7b5093886b5b55d2ef5d3fac2521b999762d1958fb","323903261beb142149e7021cf59171d6265ba5f8a8c2c59907a45d29a3034d5c","f067a392dafb30d80c52952468e2e08c4959089e3ef826756aef0be22169ff86","6205347cdf2de1ed13ae1c5c1a087ed376db149e570bb89274708d5c39375fab","04738c76a06874d7f7c0d554805a41f015c4f8d4eb59baff465ca16f0f3f5c4f","2aed0d649aae850b009f036c7e7027bd68efe7989ec2a0d82d077fb81960d865","e360f3e05c3092606a3aefc665133f22de63e310fde7d9efc49db7d08d3a1697","3b5824438c86303267829003a09f1d33c8a0c726baa924c8378753c8ac1c1859","2357d351053fa8cf838eb31b38ef5d0598632c5866561b8e61797715fafc8c49","7d30a734527db06391d9fab1bbb2fe3c40bca7075cf2e022f5392803dd290de9","3aa61aa4f448208dd871d9b2ad53a232d31ba2ed1bbf8816a098c43609bc10b4","6a10bc9698a0fb71a6828f7fc1b5e34a7db0babee8195cfd14226f0447c9ff96","bd935e0be9fa5ea079ded7e86668a9d3a20753fe87e842c33427fa1d38e986a2","30ac63afff0e68aa706909ecbdaa261a4e4ce32efccf1130bc5bef44377916a8","4bb649d64c88a29a52696430c2bd4fc49f1672bc63a7e98d06a41cb26a56772b","e6fecadbeba3c4cb9356611a4e3ab24e77bc405f2e34867e7f4ab7f59576bc22"],"paragraph_range_zero_based":[28296,28319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28296"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":28320},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28321},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":28322},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28323},{"literal_text_all_w_t_and_m_t":"SIB-TYPE","paragraph_zero_based":28324},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is different from SIB6, SIB7 or SIB8. For SIB6, SIB7 and SIB8 it is absent.","paragraph_zero_based":28325},{"literal_text_all_w_t_and_m_t":"NonPosSIB","paragraph_zero_based":28326},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is type1. For type2 it is absent.","paragraph_zero_based":28327},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":28328},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28329},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":28330},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":28331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28332},{"literal_text_all_w_t_and_m_t":"–SK-Counter","paragraph_zero_based":28333},{"literal_text_all_w_t_and_m_t":"The IE SK-Counter is a counter used upon initial configuration of SN security for NR-DC and NE-DC, as well as upon refresh of S-KgNB or S-KeNB based on the current or newly derived KgNB during RRC Resume or RRC Reconfiguration, as defined in TS 33.501 [11].","paragraph_zero_based":28334},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28335},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-START","paragraph_zero_based":28336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28337},{"literal_text_all_w_t_and_m_t":"SK-Counter ::=  INTEGER (0..65535)","paragraph_zero_based":28338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28339},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-STOP","paragraph_zero_based":28340},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28342},{"literal_text_all_w_t_and_m_t":"–SlotFormatCombinationsPerCell","paragraph_zero_based":28343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["052d6f0ec85d8a68f2d4f97072f07a4e3f6c6712de447e9294ebc00413a53085","9f1176bb33260ebdee1edb27577446797cc85ec46a36aca921d02728a2dad5c2","a94769590db7eae7a061022950fa5527773ed77182ae9fceb898db0d3c29e853","f30af9d68a79e3ff738cd6da6be8acd58b081856929b0d55b4b5d07e7b440447","52c0f34833ac3d63eea4135c40f5ce33b49a2ba356512941beec673e7e8fd71c","c38d445bc2e74b68baf69a87031bb0566d623984d3d18ac1e9f93c786aa9044a","c268d9caca66610cf32d3917ccb2c9311897d27ed5913f5d314e0fe47f33366b","4ca4762043a2a7f489fb34e9f9523d66036385117d45b1c1540f28b04250d5c2","bad5f9e47730cce749515cc65d04e1efbc4419c8ce5eeb65cc662be843c509c3","2a78b2c01ca5430784c321cee49fd2268627fbd9ee1bcc81ffa2cb97147723f1","98b587db3d7ff79e7f7e8b38c6d294adf04c71df2e64bacc4a7c6819adeec906","73bf4749cf4731dd58a3617baccac958b56823afb4af4cda85facd0451b933b7","e77adca851d07f9e82035806fd0d30b32cc8319ec135683c539e84d2a09b4bb5","e2a4388086e0e295036b8e4e98dab7115ad742899647c68bf80cd24ea39a2f50","e1bb3f53d1c291e18a4ae56b5bf611a29cb8be2e4d3b6900b3b6844ea22b87b9","836f016da393e2938ffb8fe87e64a6572e6e916e00d03249865ec75f3f5c02bf","e1510642920623ebac8edc11b4b555c1c0519abcf8e5659f37e9781850ab4dfe","e1982dc3167128b8c01ff725f8d57972b0ea55f41a5eb81d285a58ce84022a27","c37f6de852ada0a894a2b0ffb256bae857ea1ed2510ebaa0cae932628e37f46c","b565fcb456814b4ffab5fe6c7835bbaeecf0c880dbece76887ea51dc1b1a3c74","1848aaadccf834aca58932b9e64e0108d93ab38d0005591344ec86c9fdfe2834","581b13686c33d3dabc1869af7f20bfc836202dc17ef44bba62d79f2b3c822cfe","de7a74a12a9401aab4994a9f60bcb9290016fcc2746c1e9b6b4255cffc68a299","f9e23c41eeb16963c9f6cbe8c43f7ade4fcde14da0c523e9d8152ce1cc103832"],"paragraph_range_zero_based":[28320,28343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28320"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SlotFormatCombinationsPerCell is used to configure the SlotFormatCombinations applicable for one serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28344},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell information element","paragraph_zero_based":28345},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28346},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-START","paragraph_zero_based":28347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28348},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell ::=   SEQUENCE {","paragraph_zero_based":28349},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":28350},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":28351},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing2                  SubcarrierSpacing                                                         OPTIONAL, -- Need R","paragraph_zero_based":28352},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinations              SEQUENCE (SIZE (1..maxNrofSlotFormatCombinationsPerSet)) OF SlotFormatCombination","paragraph_zero_based":28353},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need M","paragraph_zero_based":28354},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER(0..maxSFI-DCI-PayloadSize-1)                                      OPTIONAL, -- Need M","paragraph_zero_based":28355},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28356},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28357},{"literal_text_all_w_t_and_m_t":"    enableConfiguredUL-r16              ENUMERATED {enabled}                                                      OPTIONAL  -- Need R","paragraph_zero_based":28358},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28359},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28360},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28362},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination ::=           SEQUENCE {","paragraph_zero_based":28363},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinationId             SlotFormatCombinationId,","paragraph_zero_based":28364},{"literal_text_all_w_t_and_m_t":"    slotFormats                         SEQUENCE (SIZE (1..maxNrofSlotFormatsPerCombination)) OF INTEGER (0..255)","paragraph_zero_based":28365},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8336c5fb73e89f968bcbdb723077b933a4fcae755ae9339dfc3652f20a6e2e1b","b34f1d1787fecdc2ea3715f7e0c3559f7da3cae4305501ca943f9326eeacf1be","3625439fae9f7a9966d88dbef1b8c3139df98bead5ef14263a548ad5a1256513","3dcddf98d56114daaf0f1f246d268ad6e0040dd028b408442aa02478dba0336c","9d1032a0ae8f554b6dbbb92abfd1e7cac05aa525e5466cce7c94da601cd7c64d","c2278a0584cd77f38a2953c0376c9639219d67b20da037ddd52cf993d7df3e37","374278772ce679e6f94f42edaf72c7a4bb966dab3bec996e0c5ca1baf68f5581","d1693d545a16ac1a1ffda37a0fa70ce330b20f10e97dcc42631e1414b44b716e","4d0eeebc2c329d400abee19d2796279a30a2beb240e5c19a9bb482d16a5a7