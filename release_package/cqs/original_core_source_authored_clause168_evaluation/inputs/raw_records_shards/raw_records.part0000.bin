{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9025},{"literal_text_all_w_t_and_m_t":"IABOtherInformation-IEs field descriptions","paragraph_zero_based":9026},{"literal_text_all_w_t_and_m_t":"iab-IPv4-AddressNumReq","paragraph_zero_based":9027},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IPv4 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9028},{"literal_text_all_w_t_and_m_t":"iab-IPv4-AddressReport","paragraph_zero_based":9029},{"literal_text_all_w_t_and_m_t":"This field is used to report the IPv4 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9030},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressNumReq","paragraph_zero_based":9031},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IPv6 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9032},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressPrefixReq","paragraph_zero_based":9033},{"literal_text_all_w_t_and_m_t":"This field is used to request the prefix of IPv6 address per specific usage. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9034},{"literal_text_all_w_t_and_m_t":"iab-IPv6-AddressReport","paragraph_zero_based":9035},{"literal_text_all_w_t_and_m_t":"This field is used to report the IPv6 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9036},{"literal_text_all_w_t_and_m_t":"iab-IPv6-PrefixReport","paragraph_zero_based":9037},{"literal_text_all_w_t_and_m_t":"This field is used to report the prefix of IPv6 address per specific usage assigned by OAM for IAB-DU. The specific usages include F1-C traffic, F1-U traffic, non-F1 traffic and all traffic.","paragraph_zero_based":9038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9039},{"literal_text_all_w_t_and_m_t":"IAB-IP-AddressNumReq-IEs field descriptions","paragraph_zero_based":9040},{"literal_text_all_w_t_and_m_t":"all-Traffic-NumReq","paragraph_zero_based":9041},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for all traffic.","paragraph_zero_based":9042},{"literal_text_all_w_t_and_m_t":"f1-C-Traffic-NumReq","paragraph_zero_based":9043},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for F1-C traffic.","paragraph_zero_based":9044},{"literal_text_all_w_t_and_m_t":"f1-U-Traffic-NumReq","paragraph_zero_based":9045},{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for F1-U traffic.","paragraph_zero_based":9046},{"literal_text_all_w_t_and_m_t":"non-F1-Traffic-NumReq","paragraph_zero_based":9047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["79aa9295711b4c860d36d4c34fdf3c10b78c314d6a1d1065c2be6db43c2af20a","9884ffddc4ba8daaef9fc527fa70c30b4e46a7360b6128208c2f0a084131b9c2","01abb3f533a69998a65cfa6e88a69ae47faf14b207d405de630f5829459b1a70","f7741626e1d1452bb33f1cf29a3cd07db3948dcae417fcdcae9ca8234d25317a","f9f50cbad63ef32a1a0240bfde6d157329d9e134d12657f07e1380bda1eb4c72","bd90babfcd4f65f9d024c563f31d6368d95