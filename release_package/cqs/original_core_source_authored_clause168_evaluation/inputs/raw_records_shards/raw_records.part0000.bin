nfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"95b5452dcdc46b87411657002095bc67fd93f084654e53f76beb747cb0df61f4","original_member_sha256":"a5700810783730dc819152118c725930196bfe57c3f7e171d8317425bb53ec2f","paragraph_ElementTree_utf8_XML_sha256":["628668100d4b633a67be13fde166a58d5db66b9fa8f7388a987cf8e9a3f06aab","7bd57907f7865c1c23afb7bd2f1ac08ab70afd3884da5091a1db6ef47d6a089a","6e69aba9186597343940a373b134cd41bd4c86cc35f8f8ecdf83117cf1c16ccd","3344c4cc03458808ebada624dfb092edc3ecd821401c1810f2eac66bdb347f6b","c6dbeb893c04697504a7616c5387e9cdc5f8a5edb73e143154f2a886fafa47ae","7b49e8fc12db365b33832b1fbdb0f4e669a8f51c9918d8f6b6a999b4518d18b7","f77c388cd412880fcfb566904c5b70ad4e753f57f01b310efcec6e993c835634","5e2d416dd74472947e1491cb0cffbe90a3ccd68ce275fbf6048f0891224f15cc","5e4d46a3d043aa23c1d575ddbd6662d858e7ca5287cb7348ff4774e22574b3ee","a7997f53f4bc2ac3f7c071bf39742d0bf71daef89a130fecd897bb482e9ac083","6b6076e27d54fa08f40c6262605e3b5c94ccc6c0ed03f57f0ba7bb75b3fa8d9b","06da61beb04499dc3130052bd3434a646e891992b8a3475d0f45433f5e7d7980","a4e577a112fd8189181a3ec05babca167a0f8355fbe1eb03bc5446554779df00","1e89d2668c2724b4ab6f04b17a2154b8e9663c738d3b4901edfaa6d06d860ecf","0d8847d4cc107f16836449e389536311baf046f40c2905753f417e795b095205","df964c7c3d544b9275abb6e01e126ddf304a89fe7e4e7335039004e46477f207","94275aaf06a1d7b2b3a8f305ffb8ffc8d3c7fe0b053f1da142a588491570e8fd","96fd6a8ec352c1dc7e5b5658fbd3d23be94662a0a1dfc476c113800579de6d65","cf53ad84bb9142bbdb78b23d84e4c25da35e593067112a42597a7dc667cf1650","7ef2febbba1d44a94ad353e2b4a32caf699c5df396a7b3e8929429222d22dda6","2566041f83418f2b48d86a7bcc65f75da99690116be5ba124b7e4bcc674a65e9","ebaa8778e240a4a499175f3e89a538ed8b01f0799e16ee40bc4bc88916f98daa","7222a47530f88c9c38f567cdbf02a91913a62eadd93a684dfd37a327459993af","6a52502323019ddfbe35d279d029389ae4ea029361894c413d9785cc3751e6fe"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/d