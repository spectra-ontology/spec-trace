{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11016},{"literal_text_all_w_t_and_m_t":"RegisteredAMF ::=                   SEQUENCE {","paragraph_zero_based":11017},{"literal_text_all_w_t_and_m_t":"    plmn-Identity                       PLMN-Identity                                   OPTIONAL,","paragraph_zero_based":11018},{"literal_text_all_w_t_and_m_t":"    amf-Identifier                      AMF-Identifier","paragraph_zero_based":11019},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11020},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11021},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSETUPCOMPLETE-STOP","paragraph_zero_based":11022},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11023},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11024},{"literal_text_all_w_t_and_m_t":"RRCSetupComplete-IEs field descriptions","paragraph_zero_based":11025},{"literal_text_all_w_t_and_m_t":"guami-Type","paragraph_zero_based":11026},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the GUAMI included is native (derived from native 5G-GUTI) or mapped (from EPS, derived from EPS GUTI) as specified in TS 24.501 [23].","paragraph_zero_based":11027},{"literal_text_all_w_t_and_m_t":"iab-NodeIndication","paragraph_zero_based":11028},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that the connection is being established by an IAB-node as specified in TS 38.300 [2].","paragraph_zero_based":11029},{"literal_text_all_w_t_and_m_t":"idleMeasAvailable","paragraph_zero_based":11030},{"literal_text_all_w_t_and_m_t":"Indication that the UE has idle/inactive measurement report available.","paragraph_zero_based":11031},{"literal_text_all_w_t_and_m_t":"mobilityState","paragraph_zero_based":11032},{"literal_text_all_w_t_and_m_t":"This field indicates the UE mobility state (as defined in TS 38.304 [20], clause 5.2.4.3) just prior to UE going into RRC_CONNECTED state. The UE indicates the value of medium and high when being in Medium-mobility and High-mobility states respectively. Otherwise the UE indicates the value normal.","paragraph_zero_based":11033},{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part2","paragraph_zero_based":11034},{"literal_text_all_w_t_and_m_t":"The leftmost 9 bits of 5G-S-TMSI.","paragraph_zero_based":11035},{"literal_text_all_w_t_and_m_t":"onboardingRequest","paragraph_zero_based":11036},{"literal_text_all_w_t_and_m_t":"This field indicates that the connection is being established for UE onboarding in the selected onboarding SNPN, see TS 23.501 [32].","paragraph_zero_based":11037},{"literal_text_all_w_t_and_m_t":"registeredAMF","paragraph_zero_based":11038},{"literal_text_all_w_t_and_m_t":"This field is used to transfer the GUAMI of the AMF where the UE is registered, as provided by upper layers, see TS 23.003 [21].","paragraph_zero_based":11039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ddbdb02ae949852e96b15eb899fcffaa2ed309dfc87e77ffae8b3e3da83d4857","cb5a03e1b3c3530de3fa8222de5817b4b64059993dad57b6a859ea03940e681a","07f7ba49763e0e0ee870c61cdd5535957f352df33521a7567461eebe25c65166","8133ddeb94fbb08be7e52fd711b08174837397e7931b9b92ee72fb080f3468bb","62fe9acb3d42a53aca33417011d15c24e3531b60f91a6fd7705e7ba9bdf354fc","f40cecdea56de3691d9ff537b06dabeb0a3b22e2753fc12bf6742d2af525b7bc","bd03409265ffa773f7194769eb382efffc0e43b56970c572e379870663340a8d","1289c9f48d6fbc4cffec28803a917f3fc2901857b310c0dac5ffd4e2970ccb6e","5f2dc14240a6ad04296790fb8f7b6d0302b45aff