{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    deActivated-r17                     NULL,","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"    activeBWP-r17                       INTEGER (0..maxNrofBWPs)","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-STOP","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"CC-State field descriptions","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"dlCarrier","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"Indicates DL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"ulCarrier","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"Indicates UL carrier activation state for this carrier and the related active BWP Index, if activated.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"CellGroupConfig field descriptions","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"BAP address of the parent node in cell group.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToAddModList","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"Configuration of the backhaul RLC entities and the corresponding MAC Logical Channels to be added and modified.","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"bh-RLC-ChannelToReleaseList","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"List of the backhaul RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"f1c-TransferPath","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an EN-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with lte, IAB-MT can only use LTE leg for F1-C transfer. If IAB-MT is configured with nr, IAB-MT can only use NR leg for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select an LTE leg or a NR leg for F1-C transfer. If the field is not configured, the IAB node uses the NR leg as the default one.","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"f1c-TransferPathNRDC","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"The F1-C transfer path that an NR-DC IAB-MT should use for transferring F1-C packets to the IAB-donor-CU. If IAB-MT is configured with mcg, IAB-MT can only use the MCG for F1-C transfer. If IAB-MT is configured with scg, IAB-MT can only use the SCG for F1-C transfer. If IAB-MT is configured with both, it is up to IAB-MT to select the MCG or the SCG for F1-C transfer.","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["91e7a9d1b0cf500c680a24b67b9adc97186d3a9aa5f4d827b4a4e713c2217ff9","2fe2834d9f799928aeb3ae660235f913daf46ff48f3db75ab08a0fbd25117c59","aa3778d5aae4adb6c07601a97c7c1880803a405f05509ec15ca52cbd10d939d5","ce3d623a358320a91244224fe742e7a29b588d36eed888c8a768ef4004cb8ff1","9a4c73104de1364b04156c4dbfec4858ca30ad4fa80a82ded825caf42743112a","48488a515f0d0876c1abc40917c2985f8775f7ce2a257464d78ca52b9e50b7bd","3b2908617475c5d27e97a74ed06cf8d59a44c19ab432041b5c1f0c6e42a63e85","dbf7d4dc50155cff6cbfddfc448558e748e7439cc56f948bc96f3879cd50d146","a4464e2d4c54dfca8fb52cef5e2506159e9a671233d5a555ddeff8d99b08ed7d","460b1262a041220ce806f77c5e13faaeb84660f2ce24afd390284445e85b1273","94ae6aee70a4641b3b29b877c9042c436e300068a240a6a69351f75263c0763c","b12009ce6af7aba16340cd1996166b0b88e77721ea0a6ae70816805e7525a10b","f98c90fe024fa7f9ad99755f4079a83895f9af569d90fb302d0115b722a7a0b7","8e7f452ac7c4c642dc684f07a48dbe4176f30c62f413cc229ce64f6ea3f08d92","4e5878304764357d2e8b1c5690213034b20f741d58e4be0968e1e944e04cb368","0aaa1ca1e5a36a2ea305ee5eeded57e48cc58ed649b0571e429689fffa41b145","3aa9a2bd6de012b2c943ba0e213d20c305660dc86a19ea9b2989f4d98e81ce7c","30f47acca2444328ece8a2f05756facf44fa53cc9e6496a16d0187b4c7cecec5","9f5aeb30a17570836419e7cd9499c08933eb275e19408b5a3195ba840a1c84e4","fe21965b90f8e94974a6e2aec90d43633ee063da2fe032470b716733c44ccacd","af9707dedfaeb0e89cab5c184b42baeb5de631feaad3587e1b184144f5d34712","1dfbf834aa9dbdd6289f5bcf12901db5f41ef234410ff0b96264d1490098954a","5c194c83a9c3535e8b805b742bae8d8630441ccd661afbaded03499b58038deb","0907d9f09ff83924d07092a65ed295ef57451f279f5a40c62f9cbdedb59a25a8"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p456"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mac-CellGroupConfig","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"MAC parameters applicable for the entire cell group.","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"This field is used to transfer npn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to SNPN Identity. If this field is absent, the UE uses the npn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"This field is used to transfer plmn-IdentityInfoList in SIB1 of the SCell. The UE uses this field to translate the plmn-Index in MCCH of SCell to PLMN Identity. If this field is absent, the UE uses the plmn-IdentityInfoList in SIB1 of the PCell.","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"rlc-BearerToAddModList","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"Configuration of the MAC Logical Channel, the corresponding RLC entities and association with radio bearers.","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrent","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink and supplementary uplink Direct Current location information upon BWP configuration and reconfiguration. This field is only present when the BWP configuration is modified or any serving cell is added or removed. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. If UE is configured with SUL carrier, UE reports both UL and SUL Direct Current locations.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentMoreCarrier","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with intra-band CA. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message. The UE only reports the uplink Direct Current location information that are related to the indicated cc-CombinationList. The network does not include carriers which locate in DL only spectrum described in TS 38.101-2 [39], clause 5.3A.4 and defined by Fsd according to Table 5.3A.4-3 in FR2 in the IntraBandCC-CombinationReqList. I.e. DL-only carrier in FR2 frequency spectrum is not used to calculate the default DC location.","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"reportUplinkTxDirectCurrentTwoCarrier","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"Enables reporting of uplink Direct Current location information when the UE is configured with uplink intra-band CA with two carriers. This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"rlc-BearerToReleaseListExt","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"List of the RLC entities and the corresponding MAC Logical Channels to be released for multicast MRBs.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"rlmInSyncOutOfSyncThreshold","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"BLER threshold pair index for IS/OOS indication generation, see TS 38.133 [14], table 8.1.1-1. n1 corresponds to the value 1. When the field is absent, the UE applies the value 0. Whenever this is reconfigured, UE resets N310 and N311, and stops T310, if running. Network does not include this field.","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"sCellSIB20","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB20 of the SCell in order to allow the UE for MBS broadcast reception on SCell. The network configures this field only for a single SCell at a time.","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"sCellState","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"Indicates whether the SCell shall be considered to be in activated state upon SCell configuration. If the field is included for an SCell configured with TRS for fast activation of the SCell, such TRS is not used for the corresponding SCell.","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"sCellToAddModList","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be added or modified.","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["3c85316594d2500dddcfe939a9653cadcbf453fa411048ae862746e796520c18","d3e62cdaedd03778245bf83c6e5a06a3333544d2e1516757e402daea3bc0aae2","1ada52b0d2d2104dcd9d6383df17f5b73e884af408fb93a05a98797aafdf1a52","3287e23b40f539c16666dda157092ae4729a2a5908124d4a46f57027ff26d8cf","f81f3a7e8946e1e5d2a9ee6e53127067995e91a592e1acafe56b59cc288c1cff","0ee64c9633cdd658aef34defa91f2e462a3113dbfdbdd3b0de8d90b9d314797a","930a3101569602d0d9626589a6cb7dfa816fba7d8f4f74e1699dcc5838ce3fa0","d855023fe419eb17d703e03041054500a10cccd4d0fdb4cc4f5d5bdc514c0b62","c6f7fbfa367022938631a5500cca2f11652250a8f675891e8b89b54d1f07dcf8","91a5edb2a071b827c02216c197888519ab088e6e4a5ea829266ee00be9cfec76","d4d5a430f59b49c7d049842a54711d6a839f69f895dd5258e55bd7f2c7644e53","72fdb5e1f8a17591e9cfb4e612b1d7467fe2b8bcef4b524b805637f747064c79","09f10df049232372a145f0c767bef79d8f84cdc778877616b2c40f72a582c84a","86c964292dbea94f384360fc4a17c7a63204a1370e5261e0ca076cc5cb87e843","e86ad531200d49e1b2a6faf6089cda08db40f6fffbbcbd07e47d585caca072b9","5594c419ee2f2c85cafd2734cc1b7b8f915e3cf1f0a46e63825290d703e3ff11","5e822f021d47cef7c11fd4a087e6661cb13e78f2e5099a8f57ab4305150e8ff0","88bae3fd0e1ccb2b7a05a1ee24674010292955c4adf05bc68dd6f56c728e429d","7515936ceafac5de7ebeb2661876f72dc2eac3d2e2c5b48e2e5a55faadde1e9d","61153b4a6c879eec2d9e9f5183858016ab481556d62fdc4d52047aaf22074f76","8748d2ea45cbe3a6f79d07da39d4bdbeaac1e368e0298d9be6f1d8d641d66428","360c962886ddb1e03287455e8b02b47788d14a15277732fdd03197f6383d9f9f","e336fb5359b1e1f31e4804b94ddba4919de910ebfc0b7ce80a86fdf8eae3fdac","9ffeb15b714c113bfbb53b550b55cba3a4086c33fa6e9da0f00dcc3775ebaa51"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p480"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sCellToReleaseList","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"List of secondary serving cells (SCells) to be released.","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"simultaneousSpatial-UpdatedList1, simultaneousSpatial-UpdatedList2","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for spatial relation with a MAC CE. The simultaneousSpatial-UpdatedList1 and simultaneousSpatial-UpdatedList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"simultaneousTCI-UpdateList1, simultaneousTCI-UpdateList2","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"List of serving cells which can be updated simultaneously for TCI relation with a MAC CE. The simultaneousTCI-UpdateList1 and simultaneousTCI-UpdateList2 shall not contain same serving cells. Network should not configure serving cells that are configured with a BWP with two different values for the coresetPoolIndex in these lists.","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"simultaneousU-TCI-UpdateList1, simultaneousU-TCI-UpdateList2, simultaneousU-TCI-UpdateList3, simultaneousU-TCI-UpdateList4","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"List of serving cells for which the Unified TCI States Activation/Deactivation MAC CE applies simultaneously, as specified in TS 38.321 [3] clause 6.1.3.47. The different lists shall not contain same serving cells. Network only configures in these lists serving cells that are configured with unifiedTCI-StateType.","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"spCellConfig","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"Parameters for the SpCell of this cell group (PCell of MCG or PSCell of SCG). ","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingOption","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"Indicates which option is configured for dynamic UL Tx switching for inter-band UL CA or (NG)EN-DC. The field is set to switchedUL if network configures option 1 as specified in TS 38.214 [19], or dualUL if network configures option 2 as specified in TS 38.214 [19]. Network always configures UE with a value for this field in inter-band UL CA case and (NG)EN-DC case where UE supports dynamic UL Tx switching.","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPowerBoosting","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE is allowed to enable 3dB boosting on the maximum output power for transmission on carrier2 under the operation state in which 2-port transmission can be supported on carrier2 for inter-band UL CA case with dynamic UL Tx switching as defined in TS 38.101-1 [15]. Network can only configure this field for dynamic UL Tx switching in inter-band UL CA case with power Class 3 as defined in TS 38.101-1 [15].","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-2T-Mode","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"Indicates 2Tx-2Tx switching mode is configured for inter-band UL CA or SUL, in which the switching gap duration for a triggered uplink switching (as specified in TS 38.214 [19]) is equal to the switching time capability value reported for the switching mode.","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"If this field is absent and uplinkTxSwitching is configured, it is interpreted that 1Tx-2Tx UL Tx switching is configured as specified in TS 38.214 [19]. In this case, there is one uplink (or one uplink band in case of intra-band) configured with uplinkTxSwitching, on which the maximum number of antenna ports among all configured P-SRS/A-SRS and activated SP-SRS resources should be 1 and non-codebook based UL MIMO is not configured.","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitching-DualUL-TxState","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"Indicates the state of Tx chains if the state of Tx chains after the UL Tx switching is not unique (as specified in TS 38.214 [19]) in case of 2Tx-2Tx switching is configured and uplinkTxSwitchingOption is set to dualUL. Value oneT indicates 1Tx is assumed to be supported on the carriers on each band, value twoT indicates 2Tx is assumed to be supported on that carrier.","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToAddModList","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be added or modified.","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelToReleaseList","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"List of the Uu RLC entities and the corresponding MAC Logical Channels to be released.","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["e6989040ebf619921dbd6be7d2a3ae0e333e82f0782cdaca5127c635564848db","760e758ee87ac917324e92bcfa9e0ecae081d1f89e91daceac2167323e68b834","520d3236aa42188450329e981c16ada12e220006fe6302fa3f9bad2e79bfea67","c21d84b2e3097610a753b091b5ba800da1962a8d2aed2674f061666f230940eb","2dd7b6beed29243631583db3b40d1d21723cc2aeaec07564fd778f270c359d33","37c8c1b9d22fdcaa2f2595c773273801808d8e8d68adbb95ddd9f1c19f785f07","1de35005455b1fd1f3e8e4e951bc46066183925cfe53850966194ce2340eb75c","bc0ef78ac88b93ce0dd36e59945d2fd5bb0e51090b30842dabc5cd74195b3c39","dc7671a74bd6d7db84da4c51373600c4807874528850d73c3f7cf5739ce4be4c","bd923e959aff410b7e0799424d045ef9d7894a59f7f49999b68cabedff6ec7ae","8b0a904846766e5f893647b3a715b4320a29f7efc0c284b7a3fb72767c803f2d","06fda88269e97f3eef08ea099f7780c9a2decde45fb126178f90a58aef6702ea","cdb35df29b25e73a66a01a69b21a2a0aaf41210cf79f0e1d3d4bf121c65ce04b","59eb0bacb92b6fe421969ca68e9219d26eddc28c2ffb254095e28806260c85a2","cc90ebf9f8e482687796702833141090f567df785b679ccfe60af01681875de9","2f6ed4cf2f5204b8b2525db3178045d673d0647bbebdaf72547eedc31e7dafa6","dc2a7346b7c2aa460fb754696698fbffb8868fbf5134a7cb75b36f16942cfe37","6041def9c0a88544f05499712767fa00fca7307c8a00569488933f75dce66beb","aed8ead26ce4ae1827d6f9f3ee93f1a30bf1c2c9ee25722d74e5fd91f2117f75","72b0c857146749f793b741a45d3594b667b327a092fece0f91db87f51057e847","563c4cf2067c85d1212e47a2592010a5e836ff79e5041ef957fff87a3e88cfc4","dddc187b180fc5d2665a48e61c7502e8f1352d30677b8415098ef38e29b67f64","c13dd184fc5beed23758c3f823a66c948692369db301e59d6ec068ef4bd8bd7d","b1de08749d068f958c95df6d60034a5fbb64314c11bff0726cabefdc113ea63a"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p504"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DeactivatedSCG-Config field descriptions","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"bfd-and-RLM","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE shall perform RLM and BFD on the PSCell when the SCG is deactivated and the network ensures that beamFailure-r17 is not configured in the radioLinkMonitoringConfig of the DL BWP of the PSCell in which the UE performs BFD. If set to false, the UE is not required to perform RLM and BFD on the PSCell when the SCG is deactivated.","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"DAPS-UplinkPowerConfig field descriptions","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"p-DAPS-Source","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the source cell group during DAPS handover.","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"p-DAPS-Target","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in the target cell group during DAPS handover.","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"uplinkPowerSharingDAPS-Mode","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in DAPS handover (see TS 38.213 [13]).","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"GoodServingCellEvaluation field descriptions","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"The parameter \"X\" (dB) for the good serving cell quality criterion in RRC_CONNECTED, for a cell operating in FR1 and FR2, respectively. If this field is absent, the UE applies the (default) value of 0 dB for \"X\".","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"IAB-ResourceConfig field descriptions","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"iab-ResourceConfigID","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"This ID is used to indicate the specific resource configuration addressed by the MAC CEs specified in TS 38.321 [3].","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"periodicitySlotList","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in ms of the list of slot indexes indicated in slotList.","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"slotList","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"Indicates the list of slot indexes to which the information indicated in the specific MAC CE applies to, as specified in TS 38.321 [3]. The values of the entries in the slotList are strictly less than the value of the periodicitySlotList.","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"slotListSubcarrierSpacing","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["69023cb9e1d7fe46df8b55afc803de3a2b00e2c20ae2f23002c0296499f8b102","f8e77ff116588337fcc4c87d813aeb6be222093ee850f3253cf869847047cab5","b08a082dce79431906a9b5decb2aab7adca2b4c3a5f58845bb43e14f35717f25","5e61a46a757772ee9e4a8f259f5934b2ffa2e86cf148a5b778d8fd0ac97b50f5","4cb99c188a50c08ae4b574967dbbb84b42f09680fc37efea6db150c264d82be3","d65980916f0f745d8315453c8bdc1069ee0425486eafeb37909e564a949ccc7f","5eae404c2751ef4e6a866c987cf9f0718a314162ec1a1d877c3bfd2540f4d23e","97757b1c876c51fcfc4919f6d0d577618f72cf95323b0626b1c63a38166b803e","f1e7f242561a1e54e71f00d9766f814515e29ed2f1b4f9f82afa1942362a1204","02d358d62d0ff70dc8362ff37c637bfef2c2adc06f67f73e1894e028a6a7a715","44bc438b7ea8a11dcae53566caaa50d5e00ffea2e1fd9706fe7279a28255345f","f60f5ca5606cebbe9ce8620417826bb4d12be69021ddd6ec34b6e4cc353b2b37","f31e268cbb38355bd6253cc81f558f7ac739a0bcd109d337bb4752c9ae8c3bba","3cffc5eb2d1e52dca6bf8b368895c79f610a2895c500325c4b33b21aa78d3071","baaa403a751e7fab57ef9f4a96261568a7fc7d9614e819b1552260a7801c35b8","e2f3cbbfa7b8064a891c65bbd911bd0f7867f5b51a18e5d47e2c6d23723c2a16","8f9028a772aa4fdb8cb771af5bdf3cac18cc89102bbb793f01a132bb96a68d58","3fdf45214c418f6543ff8743149e6620235779fb3b4a4dde5e58aee646c8e8a4","b9dd2ab93af989f694d72e1e06754773208627730f43fe668e44dea030b26633","85c08a51535fbe5926d9ac548d2c6e706b15aa9856c7dc0ace30bf9fe453b914","cfb00ff57d91697b0fc1548bda8b6534205f3739a8044110af0141a984669876","c77a8a14f1c3633340fbbe1ff2f4d28740ea222314ed04361c349a3393cfdfe3","b515f6fb6c0903da5decd911c9a2b6c63851e666d7be7458c7ed415d8e928ffd","7e8d2b15a7b7c53dbd9d00ea7e4c06bf44138ace7821b2e55471554f2d1dea4c"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p528"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used as reference for the slotList configuration.","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"FR2-2:  120 or 480 kHz","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"ReconfigurationWithSync field descriptions","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"rach-ConfigDedicated","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"Random access configuration to be used for the reconfiguration with sync (e.g. handover). The UE performs the RA according to these parameters in the firstActiveUplinkBWP (see UplinkConfig).","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell change and NR PCell change. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in spCellConfigCommon or sets to the same periodicity as ssb-Periodicity-r17 in nonCellDefiningSSB-r17 if the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17.","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"For case of NR PCell change, the smtc is based on the timing reference of (source) PCell. For case of NR PSCell change, it is based on the timing reference of source PSCell.","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"If both this field and targetCellSMTC-SCG are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message. If the first active DL BWP included in this RRC message is configured with nonCellDefiningSSB-r17, this field corresponds to the NCD-SSB indicated by nonCellDefiningSSB-r17, otherwise, this field corresponds to the CD-SSB indicated by absoluteFrequencySSB in frequencyInfoDL.","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"ReportUplinkTxDirectCurrentMoreCarrier field descriptions","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"IntraBandCC-Combination","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"Indicates the state of the carriers and BWPs indexes of the carriers in a CC combination, each carrier in this combination corresponds to an entry in servCellIndexList with same order. This IE shall have the same size as servCellIndexList.","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"IntraBandCC-CombinationReqList","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"Indicates the list of the requested carriers/BWPs combinations for an intra-band CA component.","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"servCellIndexList","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"indicates the list of cell index for an intra-band CA component.","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"SCellConfig field descriptions","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"goodServingCellEvaluationBFD","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["a247a4b9a86380ebf2906674f977ce56c0c7c89aa6be810deaf9ff95874b94af","b88691add5289306c8a8936c8822c377d36f4c4f4525ad063726cf86863bcfb1","d5977a1ddec7d63d89494b0b6e7505e940afe9987caba253b7e8679e6ef750b1","e940eaaf2b2b307a62d6b244adc0cde24e9defab061c6a82cbda772ed60853a2","8809dd9e40f617d82a9c7dd5c6958e70df1a04f03b305f4315f12793f97cde3f","410f80fb9a936b83302d6f3c59b38959b2aa58d5e69bf64f7dee320a37c35019","77a262f33f8ad92e40f3b95b698187a082e2ccc8ced89ea20dac567420e16d21","8fb1df68025b2c0f0e631e88762922e93493f5d86e847e8912ab721c7b65b4b5","6597a0ff36d567d7bd9a48c3ddf283c7f3a11d2a7c396e42ca0d5cb7acdf2245","eb59ab56b421f0685f0a100485147e72b8369167674b1a394232409b608de039","ca88d398c630210d9785faf25157cdba721d9d5f3a694b2d95712782d578ccd8","287e7cd9e24de477a287f55db655f7eda8b732cb8454253230124dca5d04bec7","a19369761db48dcd3936bd3d90a70449a385f356a5337da25b6605fc8060afc1","fc5f869326beb9bc8ca7c4ca185f602e4eb3d5902756785f62dc66794bb5ce72","08ceb0674db0c441f038616a2ee2dbebb91a9482c6a437945a042801d93aba2c","b9cff26fca344d6b0b8b79ff9ef2bb13a125d2f30bdc0fd05922966d46a78ba7","e9823190fb370af14341112c4de2fb95002a4fd0ebbb426a84d5cc1a0b9e3d94","a7e260f59dcdc59dfd7b5eaf88f2764a8dba9730058338256fa1953dcf3b936f","e3cbd44e92f1b051354808a88cee6b23643c2b2d3c9dcb087e8a24a1d2fd9d44","39b19b53d57e6fc4f72349db993e3debabebf3cde781a46e356282d9f153b9dc","30f4f6c184455f7039d057ae11c129ad59d12b1211af21966e0bc296055987cb","ca1778b4c4004c8ecc79488be6ff552a68486dbb2e98a4acba879384e8ecd638","1fa37055748fabc8bae96c7f80b3fe49745c794039d6379cfa78d8d05827ed05","d6bbd11054412fb992c0abe66086dbd69ee3005c4556fc37803ed12fdc018177"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p552"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the criterion for a UE to detect the good serving cell quality for BFD relaxation in an SCell in RRC_CONNECTED. This field is always configured when the network enables BFD relaxation for the UE in this SCell. This field is absent if failureDetectionSetN is present for the SCell.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated while this SCell is deactivated. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"secondaryDRX-GroupConfig","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether the SCell belongs to the secondary DRX group. All serving cells in the secondary DRX group shall belong to one Frequency Range and all serving cells in the legacy DRX group shall belong to another Frequency Range. If drx-ConfigSecondaryGroup is configured, the field is optionally present. The network always includes the field if the field was previously configured for this SCell and the SCell remains in the secondary DRX group. Removal of an individual SCell from the secondary DRX group is supported by using an SCell release and addition. Otherwise, if drx-ConfigSecondaryGroup is not configured, the field is absent and the UE shall release the field. The UE shall also release the field if drx-ConfigSecondaryGroup is released without including sCellToAddModList.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR SCell addition. The network sets the periodicityAndOffset to indicate the same periodicity as ssb-periodicityServingCell in sCellConfigCommon. The smtc is based on the timing of the SpCell of associated cell group. In case of inter-RAT handover to NR, the timing reference is the NR PCell. In case of intra-NR PCell change (standalone NR) or NR PSCell change (EN-DC), the timing reference is the target SpCell. If the field is absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"Next change on TS 38.331 for Option B-1-1","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"–NeedForGapsInfoNR","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsInfoNR indicates whether measurement gap is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR information element","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-START","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR-r16 ::=        SEQUENCE {","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForGap-r16      NeedForGapsIntraFreqList-r16,","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"    interFreq-needForGap-r16      NeedForGapsBandListNR-r16","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreqList-r16 ::=          SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForGapsIntraFreq-r16","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"NeedForGapsBandListNR-r16 ::=             SEQUENCE (SIZE (1..maxBands)) OF NeedForGapsNR-r16","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["26254a95109f4350ed9ac68eef5e16e60c610ec41aff893fe200572ad71689b5","fe92d5416eec2d34f1b7f3b1b5ea79acbbcdd12136c5ae746856039de52fc0d9","5078d92c2278b590255d2659ca1fe705e1bdf56ac685a818c6b5d3db2ff267ad","89e35f857a13c85d440dd1e84aad1ae6244006233a346737ac80bda453f8ed94","b82ac9ef2538c44ab12f78878e0ce36a189274d4ed5110676db1359ce2fd15ba","8bceaa4aca233da58f3fb5be80c4a478f20e8b263ec594e4df55a3251a29a231","fd1efc4dc3d444510f69dd5e59404be1595aa2646e3103b651f6e326e812e8ae","a7c41300e972c16183297932c38e4a45fa58283230192ad829ba6695ac6e6fb5","193ef775cc0cd95b594265a71cadb4962c10188f6f036fc2af8503faf0e626dc","9afae81b35b60bcb