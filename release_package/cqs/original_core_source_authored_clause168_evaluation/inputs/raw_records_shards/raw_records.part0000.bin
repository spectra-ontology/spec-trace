d":1861},{"literal_text_all_w_t_and_m_t":"UE-TxTEG-RequestUL-TDOA-Config-r17 ::=  CHOICE {","paragraph_zero_based":1862},{"literal_text_all_w_t_and_m_t":"    oneShot-r17                             NULL,","paragraph_zero_based":1863},{"literal_text_all_w_t_and_m_t":"    periodicReporting-r17                   ENUMERATED { ms160, ms320, ms1280, ms2560, ms61440, ms81920, ms368640, ms737280 }","paragraph_zero_based":1864},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1865},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-STOP","paragraph_zero_based":1866},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1868},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":1869},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":1870},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":1871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["883bc14b7d688155d620ae4bf66f96c2ef002c3723d7fcc27f0e574bf5a3c555","9217b926a83f2fe78ce2aa31513aab382346ba8b6158fcabe75d35878c826ee6","401141d6b328da77539dbe833b1c824862ec1406d43f7db35eca470002f24c91","be717c3e70b70a6e9ff2273dea081d7f61053b11e18976311728c98ec90a6138","8c2326ac393fd26e32d73f2d62895b4cdaba670111efe44a68539fc2dd6c8284","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","b000a25c131f5b58d8c870610eb86de57b990ca8456a26b1392a18edbb27de11","b7abf4df832a9243e408de1a9d9413b63969168761e999be8a0afdd19df7d474","a68c664e64b4cf53ebf3c539074dc121ba01e2e47ba0d0263ae3962555d539f4","8c2326ac393fd26e32d73f2d62895b4cdaba670111efe44a68539fc2dd6c8284","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","55a78cb29a62b961ddf7fcb429cf91217f4e76d4d7613da838850163c1f5ebd7","788672629e47e37865060352dbc0c7b3c5c40ef7320261b0d1044bfc77861e73","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","57ae68f5172685b89401ce3e1ff50f41ffa6d77c35a4af5b2d6de142d3ced178","67b26a5a40bc412f471e61c0f414cac7575c17885e83b6aab396afbc0f25b26d","deffc3385e49bb5c2f4f75802a1589b7409c0fab140e944c960dc4d5a2faf50d","8c2326ac393fd26e32d73f2d62895b4cdaba670111efe44a68539fc2dd6c8284","1f2fed0df8ab1320df2bc54f1930b2ef2990f9e10042d72bd70f0e8349b03cba","fb4c88e5cf323796a0c3fbca75bf7950204d2c33794e025ca9d253ef27c9b402","b6e3cc714d5465b0b43a134e7df4d529568cacfda75173612e0361e58adc6d48","b47e8594939f90f4b775bde361eae49c427c4b2c1f123228f4efa619ddbdfed6","aab04f40b3d58c019df95fe23d118cc8ac20e8b7be6c3bbb9e1a7e2ee3bdf42c","5e12cf76f6e942a96fb27a302447f8cf762fecd1484848321b2b2d7804bf0fbd"],"paragraph_range_zero_based":[1848,1871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1848"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":1872},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":1873},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":1874},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":1875},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":1876},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured or if the masterCellGroup includes ReconfigurationWithSync or if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured. For conditional PSCell change, the field is absent if the secondaryCellGroup includes ReconfigurationWithSync. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition.","paragraph_zero_based":1877},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":1878},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":1879},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":1880},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":1881},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":1882},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":1883},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":1884},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED.","paragraph_zero_based":1885},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":1886},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":1887},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":1888},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":1889},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":1890},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":1891},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":1892},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":1893},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":1894},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":1895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["257fc9a6004fb15e0fc916ca18e45c0692071a4b3cb372c8a9363df4b676bb1e","56762c0376dc23c1d0e69839a9ee3b293656ebdbcc2d2b6ad01f8dbcfa157b73","8a8e5adc27c227be3e38724395f53466b8b67e98cef9877a49bc9635f29b7ea7","ac0fa5a857d8578c4315a0609c039ffd34d5ebbe4957bd422d61881bc73d2b41","da522155fed14d472c937f6f815748d8356ca8847b53f80bf256ba7a718d6842","891d65530c9819191878966cd3fa02a554f83d4b91c2ba864120f517d44c2888","e8e433d148db5772446af3d6d3a1b739f322b17f8d0eb8cdfcf13cb25777c27f","ef3db995ea7ccb20020da7aecf8f16393dc82004455c967d211e353ca8726822","575574ff66edf36501a73599039bb3317f84df660138bfc476b8c7ad10693b30","c8776e2a43339f480c4f5d6c099b448473a29c7dfc590d0514694ad56d879f7d","25c99036e95adc5bc828be8aee693b7bf05c89789a8b73039600540d9fd5456f","20c4ecd7d41b0ab71d02cde78949c7437f817e169eed851d37b408f878db0046","5ea461e9cd6d706c4e3d0e7fa9bd22ad1c4bc4ee62a1a1acd81b2f2076ea6a13","978403fa8a58354fb375da8de8a451ee109f115f84ef05c02db3d88d51e4a5db","367568b80cacb5d77c3946dd3655d25e7051d95fa736a51212a12ce8e3f13b51","3e923cd021062dad7165a1047217f8e6727697b44fecd15374ef0e5b68aba141","45a8a6bf3d9135faefd824cb535f1ef62c0a5f3c94a5da7d7d7e9691f161dcdc","18920ffc4110b2dad307504f8f96f22bf0977e69d64f8a65762dfe4eba788009","cff317e39141f703365c5000fee34cb76b4b14516566ce83a2ad76031e458065","7cd9431bb6dee50a602df9ff0929064103a207ff75b5b4d04bde0d7f48a935c5","36b112d0481e3fcc337fea7ace33228f1af99fcfa0b601ba51b15ab8a202f6ba","2d2172e47e0185bc439989e775c605b879a85cbaadf394cf2feeab40c5432b27","df91f3c92eefd40299bab59611131c1635dfa80a9dff691fee0f0a14dc95c782","5dd09cc8ee367879b9c52ca1604e4e788e6b2be2fb3081c229245a8e028e2f23"],"paragraph_range_zero_based":[1872,1895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1872"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":1896},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":1897},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":1898},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":1899},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":1900},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":1901},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":1902},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":1903},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":1904},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":1905},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":1906},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":1907},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":1908},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":1909},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":1910},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":1911},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":1912},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":1913},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":1914},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":1915},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":1916},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, measConfig, bap-Config and IAB-IP-AddressConfigurationList.","paragraph_zero_based":1917},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":1918},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":1919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["34a6618da768d706cfdccaf2910ab2459c9ec97643e8e564cecbc9da17a01687","4d7aa875644b62455405d5c962ba25c7f28c70260cd370ec5121bab17a49a6a0","5ece651f2783bf47887b7a2584a61bfdce410dbb0928889f82c3557ebce2be76","405063735262d7e2baace8a989f0a91940404e3c22c063b955f3a3cead1e131c","ebd36b1382518fa22e3bcb36e539da5c626f6adb5877952e1a7c395696892320","90ee978fe937372495ec361ddc40005a122211fe09a4069d4623ce40172b992d","1f3382f8086b8447c6cf9e7c6e37c3efcfa9f3c08f3e9b1b4d0ab6f6967d1dab","a9b657fccb43140c718a94e217bc61ccc5f71ad3b928e3816de32b8d49582a62","79ae936bd2a7bbe9c06ad105684fd8b674c0763d22c4bdb2261fb9f02364ff7a","9740e093f4480e00d484c0100105b5bab9e2fb0219f2332a4ec8081e9c7ea1f3","7a883d12cba801a9765300913bcb2923dbdecc6cc6dabf8d0fc14b3f43a6ff7a","cffd3be159c934fa98a3132cbb3b84df0f1b583b833270e03b9a2e4da53d2938","7d9cbd50fdbb31fb1bccd62efc454a1f45e0185d30dd84710e1a28b3a4073a44","2f4326fdde2452d081afe0e242b4102a2c234caef9cb544ade258ca0a8c72017","8655c8f98c218600dcd2863f442cef8390324261177c82bee28411c40a0b83b2","d886b7ba2990818b0f499c89dd218866ed0d7a6ca319ea8f65db60d43f8dda7f","036fba55124b7a948dbf18b4f651c0880627e7d59525b3b0f1ae8f09ffa0df00","0097d5f5eb5da6a272a60bc99e5dfe48f2f9d81edb5e0b1f6772d828fe8e1f6b","5d1ccf51f82ca5e66d463b8479fdece7f74c5cb4a84037a5d390a3809b277718","308e95168b82386d6a35ecbb062dffb764f13c87e2a559a0d195f6e96f077694","94a43df68b6248126c691da941e5f6493d359558102708e192ec1b8d821d1503","9935709b2cf4247fd53c6e6ab6dea7836eac97e0ec989cc1b4da33f5cb576141","7d21135c80d726979c3c95cc89ef4c97e0d65092920eb9b68b4960872695c589","75e5b233268facecffa7d1bb765e6efc9a15445e2ad7bb13a903da39957f865d"],"paragraph_range_zero_based":[1896,1919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1896"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together with concurrent measurement gap or preconfigured measurement gap for positioning.","paragraph_zero_based":1920},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":1921},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":1922},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":1923},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":1924},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":1925},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":1926},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":1927},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":1928},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":1929},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":1930},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":1931},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":1932},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":1933},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":1934},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":1935},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList and obtainCommonLocation can be included.","paragraph_zero_based":1936},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":1937},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":1938},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":1939},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":1940},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":1941},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":1942},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":1943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["2523a2cf504604b2583987e0fb4ba3cd0b0eb4ee8f4d8080f0ccbd900547e947","95d0432f93133766c0917adf5afe3e7c14d90b3752e6f04c67cd8d29fda1a6fb","9f8fa82fd3869c7ee13413a33a3150a170b4579e25a014407339f846b438ded8","33301a82edb9d219659de51f51003723ee015519037f0d164ba31bedc12cfa58","138048404ff35e7f9a79701661eb9505cae5e5cb4869e041de72a297b46d0bdd","d46b4a9cc927ce93ada4a4354d9854e729b2b75f428f36058902b52beaab265d","98dd7cbd0ef1ce2dd4ffbc7d23f3c6857bb4022caa4c776b9c020718fb0aa4dd","fe22c49cc928dd463eab95fc6c4f39ab49c9bbac6c4bc44991928a4f6492ee4c","1b796a524939db9d4c9b13f059eee64e0fb90131b5d513b95866f2816134af36","201c01729e7693bb20ff494850080663d3c5621287577b7f88c9cfe925da7417","3f0b9e592030ea1853b8aee8ce7a6564231c69f76ac2fb5d42f63f2acf1cc560","f5439a508dbd068dd89eb971d54418a4bcc55f38083f452f97541ae8de0b3475","55d7056e22fd4b94a6c80f4ee42fcbbbe3781d54647d2b07d604a85c4dbeb9cb","dc33dc6614b0861ab10409d81e3fdf2fe510532ac123043e562cdb748bf7bff5","721f2c4a227d2c1d8d8599cce36c2ce2ca79a8f155e48d886d7daabd426aac83","f5c0fac92d8348e901c70896d5d1fc439cc0de588471262a4133b072ad6f8f73","06f7cd6846c8c7684cec1c11f0c596bf025f7cf40f6321d87fd04c210d442e90","1b200d2e9df8e3d0befb822a1df3f3e781c4d48431a3320d18cfada500d0aa2f","8d8849711c781baf6a12b3ac7da065bf61e2312fcbd5f5e87e0f4db83066c3c2","3e9a071e724366cfb396d5be07cb9624d218c55cd8577f3e637c0cb20ebbc97a","cfe93f36419061e31fddb47bdd1887a22d8e5bc82887dbbe43d5b06e0ee9727b","1839307257cd96c307edde7420919b2c4269a354d7968691796a2da1a4f0043c","70b68adcc11d95efa913e38e99c3979ddbbd0923147273dec48c7c07f0ce71c1","7469670d2cb1215aa12ff24889d5f6ebf5a6f6af0b970d222d4b037501330e1d"],"paragraph_range_zero_based":[1920,1943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1920"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":1944},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":1945},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":1946},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":1947},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":1948},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA or CPC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig.","paragraph_zero_based":1949},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":1950},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE. The field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":1951},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":1952},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE. The field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":1953},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":1954},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":1955},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":1956},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary.","paragraph_zero_based":1957},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":1958},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery.","paragraph_zero_based":1959},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":1960},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":1961},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":1962},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":1963},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":1964},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":1965},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":1966},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":1967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["69b3fdd4b1baa5f066237fe8616283d91ccda038889ade633679ff61b02f5090","f767f4d5650814efc2fc4e792577b3a587012344ee4e9ce813e0fd504f677a70","d5e6467fd43fa870928bd55d21b33f1d05ec26b853a49a138474cb82f3d51fe7","cc247fe95662e1524f3db89c76ef8847675d7591db60dc638418193a29e8ea50","da1416ddbd90c146c0f0efd16d354d5e84f6dfbac1d13583310e21739ec4b4fb","f7c47285ad66c938c1d83503fbb02f1e93d7b5dc05d44f9bc3e4345b33134014","b9cfda35b9d0f46a20fe7a5cc94bdde6cd99fd270343fc54c0acb78f9ae577cd","c2d281b0f2dc4495698eb7d9245c5298480968af0ef83b494f9f2f5633ab0213","e6338d5521920023553a58e8e85ea9548ea006e32a2a064343edd8525eac6663","d14acc49481507c780a427e612f1ec5d118797d66d841b58bc04f97f958b75b1","1229efe54cf2a57f7cf412f75d09bd40672cd082991451933e0b20b8b85168f2","2d27860ade28c34ea2686c20a71a62371e78fd265740a0b2a54c6ee72147ade7","feb02928d7684a7ff4ac5f028982287925a2db7a8d91f31bfc21d08215648742","103d8b831bb7c90dc874fd52ad3929a1baedb83d497eca5d895874dd77e193c4","ad076fdff0b4cdf211c27d269836ea16fd2c94e46717b8e58a398ea0ca3cf001","35abd16bc69b89d734ff37d19de418a6bfa3c02b09b9e4fd52a181840c23c9fd","a3250c1e825246731baf9f41d4627db0cd8955dbfd1375db63da3fa29e2f958a","330745acf32c2f7a4c49633dcbf841cabd09046373d6d33fe62e4f6a51c04b37","22efe1e7e3edf4bc9d11ccac5c1ac42d0c4eb0c030a5d13afcef81093d842646","7d5192e0075fdd755030eda8fb2198ad2a525c99a5c914a2c5e43c5f07521cb7","a6a95d0afa9eaf7f4c9b9f2d10f1463324a0ca4ee0d9057b692a83b87a0d7470","29d28ab04cd7a81ad882156bf1ffb8f2edfa6fb035e362b17c14ebf8c7189eb6","de0aaa6d5f03aa55370c150f73ab4be3f810d9e122f2f181606f2a47724752f9","4b8c1ecd7139a2cb14a7c18c4350285f69001247f0668b188b33356aaf8c5a88"],"paragraph_range_zero_based":[1944,1967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p1944"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":1968},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":1969},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":1970},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":1971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1972},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":1973},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1974},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":1975},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":1976},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":1977},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":1978},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":1979},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. Otherwise the field is absent.","paragraph_zero_based":1980},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":1981},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during reconfiguration with sync and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":1982},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":1983},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":1984},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":1985},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":1986},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":1987},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":1988},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":1989},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation)","paragraph_zero_based":1990},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent","paragraph_zero_based":1991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["551d0ceb52945ca3c75d28d4101795f132b10702e063474885c6be5b8f41654d","8a203b9d416d8313b45392896186b197eb7fcc4dfa473a3bcb13ec6d21af29ac","29fc8aee217b6f71d6215f3f6cd713073341e992225ddd45d271f78da34be716","a78c4106f889a0a06c111c38038fe776da361e484ad4ec984b6cf34ee3695935","b6e3cc714d5465b0b43a134e7df4d529568cacfda75173612e0361e58adc6d48","2b854451f66292211701f037f5aa5ef493d7ba3f0ac593b4e1e6c24b37b8c0c5","d96000fd6662093b0f7b1381733f0df51f049199b42c573d6d23252ab9b787d3","09b32830fe1ffca9202d52ffae940c1b8415cc3a4d57acde70cac03329750ef1","d91fa645bb4aef030d99afdef350e2f29f19d1915a946c1e25f6d24dab44101a","0d6623a8a092865e1b40c66218b0c03b82fa4b801e4f2915842660b00aa2246f","b0845e826fd1d9b6e7f1b382c236963b97ad831dfda81ff32962a0438b644402","e0cbbc8cb486e8d9dff7e311be440bc899795721dd0d619a92c4e71964722c23","162b4696215f2e4b291e9df1208ba8274d48e990d4f84b569315a395784f5162","2fe071fd7559d1ed1843132980dd3823e14bc10173663f27e8271b48eb3d2448","5388f6e656b0845d2df4c4ac691e60bb306695f38a49c2d8a6324b03ac6d6b6b","d7a918b728e657e3935906bb074d61202f7f65514372ccce1501b07f3da72f83","ac92140e63bc40814cad519015a91cb6f013a84b7786cf34be2813e0360f8ac1","75789ca6f3ff581aa4d575e36960298ffd0e85cb0cef510bd57383744c9844dc","280ed29f4b37d827b21569b61046fdefb5441e83145e77eb956e