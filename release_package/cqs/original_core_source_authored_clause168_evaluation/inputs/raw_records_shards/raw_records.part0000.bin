{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the Doppler uncertainty value. It is defined such that the Doppler experienced by a stationary target device is in the range [DopplerDoppler Uncertainty] to [DopplerDoppler Uncertainty]. Doppler Uncertainty is given in unit of m/s by multiplying the Doppler Uncertainty value in Hz by the nominal wavelength of the assisted signal.","paragraph_zero_based":1176},{"literal_text_all_w_t_and_m_t":"Enumerated values define 60 m/s, 80 m/s, 100 m/s, 120 m/s, and \"No Information\". ","paragraph_zero_based":1177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1178},{"literal_text_all_w_t_and_m_t":"codePhaseSearchWindow Value to Code Phase Search Window [ms] relation","paragraph_zero_based":1179},{"literal_text_all_w_t_and_m_t":"codePhaseSearchWindow","paragraph_zero_based":1180},{"literal_text_all_w_t_and_m_t":"Value","paragraph_zero_based":1181},{"literal_text_all_w_t_and_m_t":"Code Phase Search Window [ms]","paragraph_zero_based":1182},{"literal_text_all_w_t_and_m_t":"'00000'","paragraph_zero_based":1183},{"literal_text_all_w_t_and_m_t":"No information","paragraph_zero_based":1184},{"literal_text_all_w_t_and_m_t":"'00001'","paragraph_zero_based":1185},{"literal_text_all_w_t_and_m_t":"0,002","paragraph_zero_based":1186},{"literal_text_all_w_t_and_m_t":"'00010'","paragraph_zero_based":1187},{"literal_text_all_w_t_and_m_t":"0,004","paragraph_zero_based":1188},{"literal_text_all_w_t_and_m_t":"'00011'","paragraph_zero_based":1189},{"literal_text_all_w_t_and_m_t":"0,008","paragraph_zero_based":1190},{"literal_text_all_w_t_and_m_t":"'00100'","paragraph_zero_based":1191},{"literal_text_all_w_t_and_m_t":"0,012","paragraph_zero_based":1192},{"literal_text_all_w_t_and_m_t":"'00101'","paragraph_zero_based":1193},{"literal_text_all_w_t_and_m_t":"0,016","paragraph_zero_based":1194},{"literal_text_all_w_t_and_m_t":"'00110'","paragraph_zero_based":1195},{"literal_text_all_w_t_and_m_t":"0,024","paragraph_zero_based":1196},{"literal_text_all_w_t_and_m_t":"'00111'","paragraph_zero_based":1197},{"literal_text_all_w_t_and_m_t":"0,032","paragraph_zero_based":1198},{"literal_text_all_w_t_and_m_t":"'01000'","paragraph_zero_based":1199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["381dc67c56c5ceaf85d625550ac38e02dce0e6183c9887c1a2117e80f87df52a","3707d4fc7be9aef1193bcf7f13e04b9532b414ce8ef33dafc4d6d9de7d8569d0","a3f47cc934130cb53d5552801eedbd78a34b5d22e04ea85f047cfa24dc1c88b7","54ec45fbe7ef6fb88f73a86f347c2975398774030ef46276c0b0123a6c574924","3a2a5b48f6b8616e16be251a7e5e1b3fb8b194260d072440756613b822eebde4","d021b99b0791ae2c223c84d9ac14cae6605fd99994555f6051ac9830af23214f","416d48e5d4e0706864e55c288a16025cbad2650417e37e137046c7b317e208c4","f8855d5ee455bcfc5fb4efc05f09dabd955e71ff46db4a09252f039052172626","6935533ceeac64d28cea58157b04bf0dd47c51322d0dfaf4e15d3d4cb729e609","75e52642310871791791082453877fe118c3b74c9ce2cee5d9b4d0494b1902b9","82a395db050b69dab190a2b0f1d17c1e06ed6b301c1705aa0065e734948cc2de","7307fc0f13dce16f7264751fa7f95f8c9b7c0f48246f7129b3c72fe2de04d2dc","19baeb1a417a55e1570ced044d885e3cca690605ae4bba10cd4867b67b9ef9b7","a7579afb643d7f72c7b8346c3333412d2d4a06da92a85353c42eaa71ceb0356a","6d1719ab7e730afe784acc52486f3768d661d2185d32cbb27fd710c5df59bffa","13a33955524b8ac66deb9e37923b49698a7d564e3aa0f7d6da61c6675fa8237a","23c478b9000612d0b968ca1c981e92e4846145f6ccc9e7e9c4c1d3c7fe8cd29f","23a7b6333dcf8bfef30417e34f49bdec81e5bde1c111f3867c007dd1aef26270","5908faa7f2f9c9169c29f5b392d12d12d004a6eb1b9ee04fc423d510f1542