{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCMessage-IEs ::=                SEQUENCE {","paragraph_zero_based":8352},{"literal_text_all_w_t_and_m_t":"    field1                            InformationElement1            OPTIONAL,  -- Need M","paragraph_zero_based":8353},{"literal_text_all_w_t_and_m_t":"    field2                            InformationElement2            OPTIONAL,  -- Need R","paragraph_zero_based":8354},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              RRCMessage-v1570-IEs           OPTIONAL","paragraph_zero_based":8355},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8357},{"literal_text_all_w_t_and_m_t":"RRCMessage-1570-IEs ::=           SEQUENCE {","paragraph_zero_based":8358},{"literal_text_all_w_t_and_m_t":"    field3                            InformationElement3            OPTIONAL,  -- Need M","paragraph_zero_based":8359},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              RRCMessage-v1640-IEs           OPTIONAL","paragraph_zero_based":8360},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8362},{"literal_text_all_w_t_and_m_t":"RRCMessage-v1640-IEs ::=          SEQUENCE {","paragraph_zero_based":8363},{"literal_text_all_w_t_and_m_t":"    field4                            InformationElement4            OPTIONAL,  -- Need R","paragraph_zero_based":8364},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              SEQUENCE {}                    OPTIONAL","paragraph_zero_based":8365},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8367},{"literal_text_all_w_t_and_m_t":"InformationElement1 ::=           SEQUENCE {","par