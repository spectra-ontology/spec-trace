{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18697},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v18xy ::=       SEQUENCE {","paragraph_zero_based":18698},{"literal_text_all_w_t_and_m_t":"    frequencyBandListAerial-r18         MultiFrequencyBandListNR-Aerial-SIB-r18","paragraph_zero_based":18699},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18700},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18701},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-STOP","paragraph_zero_based":18702},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18704},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB field descriptions","paragraph_zero_based":18705},{"literal_text_all_w_t_and_m_t":"offsetToPointA","paragraph_zero_based":18706},{"literal_text_all_w_t_and_m_t":"Represents the offset to Point A as defined in TS 38.211 [16], clause 4.4.4.2.","paragraph_zero_based":18707},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18708},{"literal_text_all_w_t_and_m_t":"List of one or multiple frequency bands to which this carrier(s) belongs. If frequencyBandList-v1760 is present, it shall contain the same number of entries, listed in the same order as in frequencyBandList (without suffix).","paragraph_zero_based":18709},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18710},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A (see TS 38.211 [16], clause 5.3). The network configures this for all SCSs that are used in DL BWPs in this serving cell.","paragraph_zero_based":18711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18712},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoUL","paragraph_zero_based":18713},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoUL provides basic parameters of an uplink carrier and transmission thereon.","paragraph_zero_based":18714},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL information element","paragraph_zero_based":18715},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18716},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFOUL-START","paragraph_zero_based":18717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18718},{"literal_text_all_w_t_and_m_t":"FrequencyInfoUL ::=                 SEQUENCE {","paragraph_zero_based":18719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cd09a484878fb80b1ec51f7ffa24205d44cfe5b56b44626c22df90f3ed045b9a","76470a9623d69fd8833ab2fd26377facea9b34b036019c95a726bfc0068ddf39","ab8cfc9930e7921b1ee7e3b2348410f2cd7bce9bde1eaffcf79d634f3fb4a1ae","8a4580d3a7565adbc3ce22d81ad48c335f08d85ad57d201fd1ee5ad39bc7442e","60a43960e7261dff960d1697376a3b3d53f6dcb337676625ae7b5d9caa13f39d","87ffde60ed31cb51a7b9efd83f8ce43f4e043183bf2ece8638b8c489da532cfe","6e30f1319c80cee97278133075443c2d972f4da63edcff03243e20634dec5a82","3b4828eaab3f3be5b5897cd9a8b34b2794c166c05a1e30361b8dd5e0a56349a3","91ae51f16bd7ca2b8d75f305feadc7dbbe7f0b491306f4558461ab62795150b6","6c7894f177f8e31f7f77d9ca05036d300d9687eb8b90e95aceb1299dd1c15100","1f48b4652890521f3164f146243dc10ff700485f6f3c01b02f849d1552275aa0","dca085033bde179d28b82daa0a3aba128dbaf2fd2547e2c8d3bbf530c7f254d4","4c743e2488ec2ae5919e5abb0a7bd466f81080f73ee081ba875bc7c9d072de8e","d6f22000fbb28171be12323