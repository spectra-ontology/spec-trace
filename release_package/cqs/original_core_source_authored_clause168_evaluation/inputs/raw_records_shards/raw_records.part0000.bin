aph_zero_based":36666},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36668},{"literal_text_all_w_t_and_m_t":"AreaConfiguration field descriptions","paragraph_zero_based":36669},{"literal_text_all_w_t_and_m_t":"InterFreqTargetInfo","paragraph_zero_based":36670},{"literal_text_all_w_t_and_m_t":"If configured, it indicates the neighbouring frequency and cells for which UE is requested to perform measurement logging. It can include sync raster or non-sync raster frequencies.","paragraph_zero_based":36671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d576a25ae303f41e5502b3a214bdd0af0e69c84fdd6b4640c98d39f511e91567","74510c4781a96183f18211af1b667349f6bd38a74a0ddd322ff1bc77e41fa2bc","13f8c0fdb9319ebb8bba8f340e3714ece237b596f0a0c6d590715545e0fcd339","8e50a6e1c4831db60b6615df32324bd8e46c942a888ef4961a553fb3784e2c48","c81e1d1837ceb87311a37ae1e33eff4ea03a0dad4d480a2f6135877e658d3ac5","04f77e2cb08f51c0697ea5fef171e9f0ed8e3bcf2df0d5d13c8c155b5b9f0bbd","79d8dee10e496307af510506b681cd1b36c98af6e5c20ccd75fcdf118a24550a","5f5c4851cbdbcebd19243354d801080bce933a5e45443185965f39b3a745f8db","3f7ad6cd5a39359d802235c93df2340946cd7afa5ec975b4fdbdeebd5f87b08f","c1e145d5675bd482bd1d8651788622566673fb22a05ff188a55e8345b8897348","7feef4185b75b5f3226753dbc1563129aac4bbb8a30448e309c9579d23f92dff","1d01179cd68b09d0fa6d7070b05b1df5a8c8b8a646fc97f9f513ed9a5c6a964e","f51e3eb93eb19ab52d9751fbfbf7062e9cb857127ac9977cb2051c7d1a746aad","09c40e909dac40495acce1cf8120f4055e1c0fc22af8d16d0e1ea5ce379f771f","e65c6077df7faad56ce9f729d1385409d329ecbecc31528a190967b0e118c731","c4c480419a1c6bbdaffa79e9d3994a03aa286c6989c1d2