v1610-IEs ::=    SEQUENCE {","paragraph_zero_based":10238},{"literal_text_all_w_t_and_m_t":"    ue-MeasurementsAvailable-r16                UE-MeasurementsAvailable-r16                                            OPTIONAL,","paragraph_zero_based":10239},{"literal_text_all_w_t_and_m_t":"    needForGapsInfoNR-r16                       NeedForGapsInfoNR-r16                                                   OPTIONAL,","paragraph_zero_based":10240},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1640-IEs                                    OPTIONAL","paragraph_zero_based":10241},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10243},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1640-IEs ::=    SEQUENCE {","paragraph_zero_based":10244},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentTwoCarrierList-r16     UplinkTxDirectCurrentTwoCarrierList-r16                                 OPTIONAL,","paragraph_zero_based":10245},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1700-IEs                                    OPTIONAL","paragraph_zero_based":10246},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e61e2876f764d5a0ff42e6f8b3ef71c7c1bb241d54804bdacbc03b0ab83a67f8","7c2e8fdf4cd1aaedfc9d7930aa519f2fb86ac50060102b2d8fa0b49a4ca35c5e","19838dd33026c0d38a04e2bf7c53d78fffca8b41fd8f70f40a1c3beaea7c5db1","7c5ac3e938c0641805cf980b3416539a9e1abaf717d8214b794a673b02f1c997","2552f8131dc7a8e37f1e83893858c109fe8