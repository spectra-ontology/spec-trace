{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-TRP-TEG-Info field descriptions","paragraph_zero_based":2304},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":2305},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS ID of the TRP for which the TRP Tx TEG information is provided.","paragraph_zero_based":2306},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":2307},{"literal_text_all_w_t_and_m_t":"This field specifies the physical Cell-ID of the TRP for which the TRP Tx TEG information is provided, as defined in TS 38.331 [35].","paragraph_zero_based":2308},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":2309},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the TRP for which the TRP Tx TEG information is provided, as defined in TS 38.331 [35].","paragraph_zero_based":2310},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":2311},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":2312},{"literal_text_all_w_t_and_m_t":"dl-PRS-TEG-InfoSet","paragraph_zero_based":2313},{"literal_text_all_w_t_and_m_t":"This field specifies the TRP Tx TEG ID associated with the transmissions of each DL-PRS Resource of the TRP. The dl-prs-trp-Tx-TEG-ID in dl-PRS-TEG-InfoSet is associated with the nr-DL-PRS-ResourceID of NR-DL-PRS-Info using the same structure and order.","paragraph_zero_based":2314},{"literal_text_all_w_t_and_m_t":"nr-TRP-TxTEG-TimingErrorMargin","paragraph_zero_based":2315},{"literal_text_all_w_t_and_m_t":"This field specifies the timing error margin value for all the TRP Tx TEGs contained within one NR-DL-PRS-TRP-TEG-InfoPerTRP.","paragraph_zero_based":2316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2317},{"literal_text_all_w_t_and_m_t":"–NR-On-Demand-DL-PRS-Configurations","paragraph_zero_based":2318},{"literal_text_all_w_t_and_m_t":"The IE NR-On-Demand-DL-PRS-Configurations provides a set of possible DL-PRS configurations which can be requested by the target device on-demand.","paragraph_zero_based":2319},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2321},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Configurations-r17 ::= SEQUENCE {","paragraph_zero_based":2322},{"literal_text_all_w_t_and_m_t":"on-demand-dl-prs-configuration-list-r17SEQUENCE (SIZE (1..maxOD-DL-PRS-Configs-r17)) OF","paragraph_zero_based":2323},{"literal_text_all_w_t_and_m_t":"On-Demand-DL-PRS-Configuration-r17,","paragraph_zero_based":2324},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2325},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["8ef8a7495b6bd1c675c2f7c6049ed6d3777aed892a68cdb5db11db1f480af991","9f681fddd4a5579c1b3018007b96979c7f731f094978155c9df7a2cac6861a33","0ead844e6b1af5a8bc0c098c7197ae170679079fb0f31da48bb76d677a0e8d9d","cdd14122ab277648269a9c295162a8785711e5a422ae44cdf516c9470387cd6d","77a9858872a26534394f47a458c2707eac1d03b0d4cef5bcffe93d35475df83d","04d8853473823f178e6ee90cc0d1a67fc7d1d4052cad0c8d914d779644b67a6a","8716c696f90f6639b688f30361bd3efafd0b20a59c1edbe9c32beebf71a02fdd","d461eee9b2e92d134a080f62fc58faa128eeda4b99e52a813eedcb5bc790f2ef","