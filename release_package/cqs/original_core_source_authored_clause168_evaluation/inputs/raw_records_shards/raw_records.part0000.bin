{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If subband amplitude reporting is activated (true).","paragraph_zero_based":16248},{"literal_text_all_w_t_and_m_t":"twoTX-CodebookSubsetRestriction","paragraph_zero_based":16249},{"literal_text_all_w_t_and_m_t":"Codebook subset restriction for 2TX codebook (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16250},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-codebookSubsetRestriction-i2","paragraph_zero_based":16251},{"literal_text_all_w_t_and_m_t":"i2 codebook subset restriction for Type I Single-panel codebook used when reportQuantity is CRI/Ri/i1/CQI (see TS 38.214 [19] clause 5.2.2.2.1).","paragraph_zero_based":16252},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-ri-Restriction","paragraph_zero_based":16253},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeI-SinglePanel-RI-Restriction (see TS 38.214 [19], clause 5.2.2.2.1).","paragraph_zero_based":16254},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-Group1, typeI-SinglePanel-Group2","paragraph_zero_based":16255},{"literal_text_all_w_t_and_m_t":"Configures codebooks for CSI calculation when UE is configured with two CMR Groups with CMRGroupingAndPairing in the NZP-CSI-RS-ResourceSet associated with the CSI-ReportConfig. Network configures the same number of ports for both codebooks.","paragraph_zero_based":16256},{"literal_text_all_w_t_and_m_t":"typeI-SinglePanel-ri-RestrictionSDM, typeI-SinglePanel-ri-RestrictionSTRP","paragraph_zero_based":16257},{"literal_text_all_w_t_and_m_t":"Restriction for RI for N Resource Pairs when two CMR Groups are configured with CMRGroupingAndPairing in the NZP-CSI-RS-ResourceSet associated with the CSI-ReportConfig (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":16258},{"literal_text_all_w_t_and_m_t":"typeII-PortSelectionRI-Restriction","paragraph_zero_based":16259},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeII-PortSelection-RI-Restriction (see TS 38.214 [19], clauses 5.2.2.2.4 and 5.2.2.2.6).","paragraph_zero_based":16260},{"literal_text_all_w_t_and_m_t":"typeII-RI-Restriction","paragraph_zero_based":16261},{"literal_text_all_w_t_and_m_t":"Restriction for RI for TypeII-RI-Restriction (see TS 38.214 [19], clauses 5.2.2.2.3 and 5.2.2.2.5).","paragraph_zero_based":16262},{"literal_text_all_w_t_and_m_t":"valueOfN","paragraph_zero_based":16263},{"literal_text_all_w_t_and_m_t":"Field provides the value of parameter N as specified in TS 38.214 [19], clause 5.2.2.2.7. The field is present only when M=2 set by paramCombination, see TS 38.214 [19].","paragraph_zero_based":16264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16265},{"literal_text_all_w_t_and_m_t":"–CommonLocationInfo","paragraph_zero_based":16266},{"literal_text_all_w_t_and_m_t":"The IE CommonLocationInfo is used to transfer detailed location information available at the UE to correlate measurements and UE position information.","paragraph_zero_based":16267},{"literal_text_all_w_t_and_m_t":"CommonLocationInfo information element","paragraph_zero_based":16268},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16269},{"literal_text_all_w_t_and_m_t":"-- TAG-COMMONLOCATIONINFO-START","paragraph_zero_based":16270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["858ba81e6b929ea47947d83c7b7a3ad80c6e6535ef74227acc06420c25ebb50c","760e48a480d79449e5a370a7c3dc5844030d83458e48d0f6f0a9e0b16c1367ab","ac800b1f6ced44da682c4a4bc9e