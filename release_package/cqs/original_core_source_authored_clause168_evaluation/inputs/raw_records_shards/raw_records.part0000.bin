{"fields":{"filename":"R2-2306115.zip::R2-2306115_Corrections on L2 U2N Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"* * * Start of 3rd Change * * * *","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"5.8.6.1General","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to select a synchronisation reference and the procedure is used when transmitting NR sidelink communication/discovery. This procedure also applies to NR sidelink discovery.","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"* * * End of Changes * * * *","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":270}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c1ed42b119e148cbb57fcea39491d4da5b78930bc8a6166f3f3e3aba27e25a2c","original_member_sha256":"f3afebf4757d0143b195626e6dcb6201bb479e0a62fc2aa634fb9db81c094386","paragraph_ElementTree_utf8_XML_sha256":["919d4218ee2689eea2480b6570f208a230c66417e300bcae33e6538e0a2b2d5c","2feb648edcdacf6094ac9fdc575f052f990697e7bb2c765c3320a5a1e2f18bde","2ada3a14a399a652453f98feda97aeaada3d84a14b9c5b69f8bd9eb0439ff228","c5c3a5394a3d94bd6c36e21784fd8f2a63bea236b5cdffa250d560116cde91fd","7335ac681fff880dd93aba9de32f1d59d7c0e80805eab913b855fbab5e697168","f0ede091c4edbde4f229ae27e32151f6fbe0067d691a608551b802f1aca86b17","7db8e5d3f5f8cdbd784aa8a2fbab7fbb1226acefaa73b41a6c7bfc2f701306c8"],"paragraph_range_zero_based":[264,270],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306115.zip::R2-2306115_Corrections on L2 U2N Relay.docx:p264"}
