{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":11256},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":11257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11258},{"literal_text_all_w_t_and_m_t":"–SidelinkUEInformationNR","paragraph_zero_based":11259},{"literal_text_all_w_t_and_m_t":"The SidelinkUEinformationNR message is used for the indication of NR sidelink UE information to the network.","paragraph_zero_based":11260},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11261},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11262},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11263},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11264},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR message","paragraph_zero_based":11265},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11266},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-START","paragraph_zero_based":11267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11268},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR-r16::=         SEQUENCE {","paragraph_zero_based":11269},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":11270},{"literal_text_all_w_t_and_m_t":"        sidelinkUEInformationNR-r16         SidelinkUEInformationNR-r16-IEs,","paragraph_zero_based":11271},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":11272},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":11273},{"literal_text_all_w