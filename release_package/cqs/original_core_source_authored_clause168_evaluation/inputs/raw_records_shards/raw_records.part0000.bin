{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pucch-ConfigMulticast1-r17          SetupRelease { PUCCH-Config }                                           OPTIONAL,  -- Need M","paragraph_zero_based":15264},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigMulticast2-r17          SetupRelease { PUCCH-Config }                                           OPTIONAL   -- Need M","paragraph_zero_based":15265},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15266},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15267},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToAddModList-r17     SEQUENCE (SIZE (1..maxNrofPathlossReferenceRSs-r17)) OF PathlossReferenceRS-r17","paragraph_zero_based":15268},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL, -- Need N","paragraph_zero_based":15269},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToReleaseList-r17    SEQUENCE (SIZE (1..maxNrofPathlossReferenceRSs-r17)) OF PathlossReferenceRS-Id-r17","paragraph_zero_based":15270},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL  -- Need N","paragraph_zero_based":15271},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15272},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15274},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigToAddModList-r16    ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfig","paragraph_zero_based":15275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15276},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigToReleaseList-r16   ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":15277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15278},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationState-r16 ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":15279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15280},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationStateList-r16  ::=","paragraph_zero_based":15281},{"literal_text_all_w_t_and_m_t":"                             SEQUENCE (SIZE (1..maxNrofCG-Type2DeactivationState)) OF ConfiguredGrantConfigType2DeactivationState-r16","paragraph_zero_based":15282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15283},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-STOP","paragraph_zero_based":15284},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15286},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated field descriptions","paragraph_zero_based":15287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e591531ddc17a1af5d9739bd138205a06a1f22d43bdc79baf0f3a79ddd0b82c0","5b22f8e4611eb06c58d5a41ef752652c374aa9a29466aa3c5b069f9d00b16ab4","7b661bfd096f4770e98749a75e3dc136d932cc9a90329f04a300d78e429f675c","bd8131d39b63429927d923cc3841afac0186ab693838a3c1b4f7527b89fe318d","6d970d39bf4483e35e4d6b57e609de853b73465b2b1beaee6d63f3d7994a6036","8adbac069b2bc33242ac0712054a964c8e16b5cf6edcb989d27125c099628215","910558b7ae6833a15c63b643e1e20197005f29701b6e6b4027c84dff0ca831a7","772ee6fc574727bdaf200978d8d7668c489a4459dad86fe30c1a57de2faa6f9e","78146e04a487ed5d1884bf4a123814e34498f27396b68a1e4173054ec56da0ac","0605c33a4e5c90a761c3820c8ac5b65a826ce99a2b93ff5e2e3a8b67194a1615","7c45d52f3d86de90b31c0f2f5a8a6b38f2580685c8fe81828dfd03e118f61de6","885fa7da85e8aba657782de213f787b00f4b8085dc703c1531478d81d4d7de30","79b690d07914582bb3f8d35d53bdf472fa820cf5c55ffccdb568fda1ea643b83","fd2167992b6c6bac3a3dadd679137e814e65a8fa5e2ae1cd73332936e9ac17fa","be4d238ce6e9f51c3bd5a98e9f4aebf14d55f4d16800cb3c16ae0825ca325d05","7e982a9db9ad9771fbc42ea53f57128bdf3fc044d3599aeeb084fb2c83340512","392c9e7bcfb555a85bf756fff7da0d4c205db61b2c8c912f876ef57148dd9198","a5e83aa54e40441388f00612ae13d01bbcacae07229822b2e212502b29f68fd5","4bcedd3d41737bc8bc91b1547a7aa32bf1644e251b8cba0497a1a081d1872b0e","8ba0ca3eefea642848aa100bc4abb0cfd7ed0e800d4800c0d3dcc9950d6a4205","dcea4bfe1de2ab02c7b1d0f0357499aa37df8d8596704f7347ab341986555824","e9274a60dda48defa6f1debbae4a4d88da5caa3d08cdfa1bf43b36495d4fc846","a7c423b17b88ea9810141a33376fb5d54a0163960c6a99a094cc492b0c3e0809","6ee776cca88fc74c83f43d1e984c77c8a9661cc98040d9ec7ea6f3f34a4c0274"],"paragraph_range_zero_based":[15264,15287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15264"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryConfig","paragraph_zero_based":15288},{"literal_text_all_w_t_and_m_t":"Configuration of beam failure recovery. If supplementaryUplink is present, the field is present only in one of the uplink carriers, either UL or SUL.","paragraph_zero_based":15289},{"literal_text_all_w_t_and_m_t":"configuredGrantConfig","paragraph_zero_based":15290},{"literal_text_all_w_t_and_m_t":"A Configured-Grant of type1 or type2. It may be configured for UL or SUL but in case of type1 not for both at a time. Except for reconfiguration with sync, the NW does not reconfigure configuredGrantConfig when there is an active configured uplink grant Type 2 (see TS 38.321 [3]). However, the NW may release the configuredGrantConfig at any time. Network can only configure configured grant in one BWP using either this field or configuredGrantConfigToAddModList.","paragraph_zero_based":15291},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToAddModList","paragraph_zero_based":15292},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more configured grant configurations to be added or modified for one BWP. Except for reconfiguration with sync, the NW does not reconfigure a Type 2 configured grant configuration when it is active (see TS 38.321 [3]). The network configures multiple CG configurations for one BWP with either all configurations or no configuration configured with cg-RetransmissionTimer-r16.","paragraph_zero_based":15293},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToReleaseList","paragraph_zero_based":15294},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more UL Configured Grant configurations to be released. The NW may release a configured grant configuration at any time.","paragraph_zero_based":15295},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigType2DeactivationStateList","paragraph_zero_based":15296},{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple Configured Grant type 2 configurations to be deactivated when the corresponding deactivation DCI is received, see clause 7.3.1 in TS 38.212 [17] and clause 10.2 in TS 38.213 [13].","paragraph_zero_based":15297},{"literal_text_all_w_t_and_m_t":"cp-ExtensionC2, cp-ExtensionC3","paragraph_zero_based":15298},{"literal_text_all_w_t_and_m_t":"Configures the cyclic prefix (CP) extension (see TS 38.211 [16], clause 5.3.1). For 15 kHz SCS, {1..28} are valid for both cp-ExtensionC2 and cp-ExtensionC3. For 30 kHz SCS, {1..28} are valid for cp-ExtensionC2 and {2..28} are valid for cp-ExtensionC3. For 60 kHz SCS, {2..28} are valid for cp-ExtensionC2 and {3..28} are valid for cp-ExtensionC3.","paragraph_zero_based":15299},{"literal_text_all_w_t_and_m_t":"lbt-FailureRecoveryConfig","paragraph_zero_based":15300},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection of consistent uplink LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":15301},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList","paragraph_zero_based":15302},{"literal_text_all_w_t_and_m_t":"A list of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation. If unifiedTCI-StateType is not configured for the serving cell, no element in this list is configured.","paragraph_zero_based":15303},{"literal_text_all_w_t_and_m_t":"pucch-Config","paragraph_zero_based":15304},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL, the network configures PUCCH only on the BWPs of one of the uplinks (normal UL or SUL). The network configures PUCCH-Config at least on non-initial BWP(s) for SpCell and on all BWP(s) for PUCCH SCell. If supported by the UE, the network may configure at most one additional SCell of a cell group with PUCCH-Config (i.e. PUCCH SCell). If PUCCH cell switching is supported by the UE, the network may configure two TDD serving cells with PUCCH-Config within each PUCCH group. For supporting PUCCH cell switching in the PUCCH group with the SpCell, the TDD SpCell and one TDD SCell shall have PUCCH-Config on their normal UL. For supporting PUCCH cell switching in the PUCCH group with only SCells, two TDD SCells shall have PUCCH-Config on their normal UL.","paragraph_zero_based":15305},{"literal_text_all_w_t_and_m_t":"In (NG)EN-DC and NE-DC, the NW configures at most one serving cell per frequency range with PUCCH. In (NG)EN-DC and NE-DC, if two PUCCH groups are configured, the serving cells of the NR PUCCH group in FR2 use the same numerology. For NR-DC, the maximum number of PUCCH groups in each cell group is one, and only the same numerology is supported for the cell group with carriers only in FR2.","paragraph_zero_based":15306},{"literal_text_all_w_t_and_m_t":"The NW may configure PUCCH for a BWP when setting up the BWP. The network may also add/remove the pucch-Config in an RRCReconfiguration with reconfigurationWithSync (for SpCell or PUCCH SCell) or with SCell release and add (for PUCCH SCell) to move the PUCCH between the UL and SUL carrier of one serving cell. In other cases, only modifications of a previously configured pucch-Config are allowed.","paragraph_zero_based":15307},{"literal_text_all_w_t_and_m_t":"If one (S)UL BWP of a serving cell is configured with PUCCH, all other (S)UL BWPs must be configured with PUCCH, too.","paragraph_zero_based":15308},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationList","paragraph_zero_based":15309},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.1). Different PUCCH Resource IDs are configured in different PUCCH-Config within the pucch-ConfigurationList if configured.","paragraph_zero_based":15310},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast1","paragraph_zero_based":15311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["27a18d4846b88d5c380f6118ccd39635a5c56aeb57437bd4e313cee5d7c54845","1c032b52857c446041de992bdab99c8cf02b3c842dad83fc65c48fe19618dc0c","585cc49a429851879558da60170b660cf3479abf8af436103ae9e3b6c46b14e7","5de555872b232ac29166321e4f0fb6f48396c2230653d28228a2e8f6ca800087","0f1af671f494b2666e3d4e9587fcd4b0a4dd797993e46760cf90a0d5f8b3658a","4b2dba0843dc9201242eec152950bdf34145db8604f925141010a7f9e0bb70f3","e6922b7a195562eec3fe54929e5f0bc4751bda1831348faf90be71d6ed120cd2","20261667814b44eb76074cfad6ac41752c7e3cc159c325dff5c3d1bbd8530c67","b3134bfe22aa242984914b5d60b2e81ac91946da8a47c400854ab0135416a707","a15dc0139a1c7734972579165cf2892e7b617966621e239d5c9a32d6e4e572ba","33aee1b739b4d4b2a2e7edf9a4e61b30ff7be46166abb7aadae2cec77fa19a46","8ea6fa3d3ce3e06c0add4c4c12e3dc1500f5da5eec054d61514ce850fe272e67","0d342b835600fcc9a3bf9852d06036f64dc5347d0311c433d08f19c2759ad4be","6d5aae2a4328b7c2e760f65b711b120b6bdf63f057a54836027df48d7c62f071","21368b6b8eb2e64c916a268f1495978569832e7b37a209c1d0200b46e65c551e","086a116642703694d4294b93a41c6b8e38231c7333d516ba2b1a972139203ca6","1486c32792ae8e8188350e606eb998bdf1cf655ebf601cfd3d6b389fcad784ec","986b0652da472697f947d264bc6878a63add7d822ab26d3144736a987b59211a","f78757b0e097834c51182fc2b0403e8f6829b2550e0d55bc6c24a10ce6f85174","1b0d0750b4ef2e07823a44c14a1a06b3649db0df986cfbab4ead1f0f06949b4e","69eae09befde8a60a30bc37f90d1459bf0f27819335ff087c150014a8ccf1d05","57dfdb896bb46313dab7b648630f45a79aa0c39bd3a07a3ee2b587229ed10a1a","aa913c4ec9e204c15c3fada7878010e4d62261579abb292e9487669e973c4584","719c169669bc6887eacd0029f411384609e52cba73b43811a4b4a1b7098508ba"],"paragraph_range_zero_based":[15288,15311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15288"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":15312},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast2","paragraph_zero_based":15313},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed NACK-only feedback for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":15314},{"literal_text_all_w_t_and_m_t":"pusch-Config","paragraph_zero_based":15315},{"literal_text_all_w_t_and_m_t":"PUSCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL and if it has a PUSCH-Config for both UL and SUL, an UL/SUL indicator field in DCI indicates which of the two to use. See TS 38.212 [17], clause 7.3.1.","paragraph_zero_based":15316},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast1","paragraph_zero_based":15317},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the HARQ-ACK codebook for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":15318},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast2","paragraph_zero_based":15319},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the NACK-only feedback for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":15320},{"literal_text_all_w_t_and_m_t":"sl-PUCCH-Config","paragraph_zero_based":15321},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PUCCH configurations used for the HARQ-ACK feedback reporting for NR sidelink communication.","paragraph_zero_based":15322},{"literal_text_all_w_t_and_m_t":"srs-Config","paragraph_zero_based":15323},{"literal_text_all_w_t_and_m_t":"Uplink sounding reference signal configuration.","paragraph_zero_based":15324},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":15325},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS when UE is configured with unifiedTCI-StateType for this serving cell. For each serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated or it is not configured in any BWP-UplinkDedicated. When unifiedTCI-StateRef in the BWP-UplinkDedicated or in the PDSCH-Config if the unifiedTCI-StateType is set to joint, of a serving cell refers to another serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated of these two serving cells or it is not configured in any BWP-UplinkDedicated of these two serving cells.","paragraph_zero_based":15326},{"literal_text_all_w_t_and_m_t":"ul-TCI-StateList","paragraph_zero_based":15327},{"literal_text_all_w_t_and_m_t":"Indicates the applicable UL TCI states for PUCCH, PUSCH and SRS.","paragraph_zero_based":15328},{"literal_text_all_w_t_and_m_t":"ul-TCI-ToAddModList","paragraph_zero_based":15329},{"literal_text_all_w_t_and_m_t":"Indicates a list of UL TCI states.","paragraph_zero_based":15330},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":15331},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and UL BWP where UL TCI states applicable to this UL BWP are defined. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":15332},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":15333},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for PUSCH (see TS 38.213 [13], clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0, 1, 2, and 3 for PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":15334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["14c6e4beb04673e5acd732aec6e9248415708de9081522ae3b858f784cda5a8e","8f057df3d480385c0974a5f5a698521fc9c9578c17017af6d64d24e0c491651a","4279096a0456b5f49973d79f4640bc4ab4da4c27682b35b4216e85d3cd35dc9d","3be81313a047921514329a81502c51f037e0f13984639b520a0f53de330213e9","caa9c57662cf5a664cad7b83a7df69e9dc2cce763d7a0a3d487d1b0d17b8c82a","30c6146aecf75ac52014842161bcf7d97d4e4e19bffa4d7cd78477e00a69bc1b","9fb0aeda02f10673629e649074cca927a27a5b10e3c87babb620710f6359d5c0","31d13a0d2eefb8c2a78444705b262b326ba6eba8ec3fabe232ad13b55d85f028","c67bc611b7e780cea8cbac1774a7829cac01ea7a315aac7bd9a6ac00729cd85a","283568b05f5c1e80b5ef61b6ed113c40cf7eb6d6b0ce7ecc1bb8fa4d1d64906e","2d1fb62b1fad101e2df2d0d3b2ea0707ce03ded5d149252edd897791d69cbbb6","0b30bba49c4329ee831fcfc1498caa2c3330ad4a2f7698a05cbcba6d8d1fa1e2","ad3bb956dcd5366dbed564bcf2ebe109cc23ed3f36b964920c6bea7f3aa2a972","bf90e2da116202a04f79d275e5c47827c861ef2c9a0f8f8fdcde458fca8b44f4","957d2d6282e02f4bfecb19c87749c3e0001d81401fcf30d7e0e283d2560c7151","07c0cbff52bd97e277e762397f655952d96fcb624f19a3312e83535bfaf70b0f","dbcf8d70ea3c2ee514256b89c17e41ca6fdd04eeaa0ebb15c9df20b743db708e","1150f6a57d07181ae1e1caa66c68ae8c724aa95f6ee47bab722b529696c9160c","812189ef710aa43162380cfc2b2d1cf2be01f99d49ab997f645f5b41658caadc","2af12e26f964201dbcad7eaa3882ef2005f1777a8c28ac57a010da4cac6e99ce","4c94ae20067cb5eb1f6150c414407a530b3f99bf1be4f9a49de3096787738504","81a35f64417c19c3194bbcf0f3d8854e369661f5e669795bfd20d284d724943e","0734e49b9a9570c89d48a72c2490e8d464b7f8d943dc22801dfb12225d370085","12d143edd71c21f476725015911be1520f9575a02d0319c27887197b4a2167ef"],"paragraph_range_zero_based":[15312,15335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15312"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15336},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15337},{"literal_text_all_w_t_and_m_t":"NoTCI-PC","paragraph_zero_based":15338},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if unifiedTCI-StateType is configured for this serving cell and ul-powerControl is not configured for any UL TCI state or joint TCI state of this serving cell. Otherwise it is absent, Need R","paragraph_zero_based":15339},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":15340},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkDedicated of an SpCell. It is absent otherwise. ","paragraph_zero_based":15341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15342},{"literal_text_all_w_t_and_m_t":"NOTE 1:In case of RRCReconfiguration with reconfigurationWithSync, the UE performs a MAC reset, which involves releasing the PUCCH-CSI/SRS/SR configuration in accordance with clause 5.3.12 and TS 38.321 [3], clauses 5.12 and 5.2. Hence, for these parts of the dedicated radio resource configuration, delta signalling is not supported in the message when reconfigurationWithSync is included.","paragraph_zero_based":15343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15344},{"literal_text_all_w_t_and_m_t":"–CandidateBeamRS","paragraph_zero_based":15345},{"literal_text_all_w_t_and_m_t":"The IE CandidateBeamRS inlcudes candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":15346},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS information element","paragraph_zero_based":15347},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15348},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-START","paragraph_zero_based":15349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15351},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS-r16 ::=                SEQUENCE {","paragraph_zero_based":15352},{"literal_text_all_w_t_and_m_t":"    candidateBeamConfig-r16                CHOICE {","paragraph_zero_based":15353},{"literal_text_all_w_t_and_m_t":"        ssb-r16                                SSB-Index,","paragraph_zero_based":15354},{"literal_text_all_w_t_and_m_t":"        csi-RS-r16                             NZP-CSI-RS-ResourceId","paragraph_zero_based":15355},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":15356},{"literal_text_all_w_t_and_m_t":"    servingCellId                          ServCellIndex                                                            OPTIONAL  -- Need R","paragraph_zero_based":15357},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b3c0051d768ba0fdc6be2d4cebe5e5cbc6a7cc5d9c35115dc086676c2c45c6b4","3b621db8a68c8c11f609c4180edc2d453e22bc701bc20cf1ca665abca6d4e6d4","ed9e7afc1e9c344d3247c0735de4855adb2e0294a03f3e9c18d77e5446b46fee","6bca14355ba96c3bf778ea249b9d0ab927a87b5c1b128e7c6e7f29861d6a314c","8a765f8184585afd0109e0471b160d95da0f6f47844dd40ee46d48103fb72cd2","451389f107da88d4cf5b725b785084e627f7cba98e65f73d32661ebda93dd074","a983c1f35020891a3222030808b061fe241c76020ad87d6a52bbcb3ce4271023","be500d45a90ccd69519bd8cb5f986aec3b920ca9f78fbb4c85f1495a05876