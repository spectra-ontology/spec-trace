{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6.5Short Message","paragraph_zero_based":40512},{"literal_text_all_w_t_and_m_t":"Short Messages can be transmitted on PDCCH using P-RNTI with or without associated Paging message using Short Message field in DCI format 1_0 (see TS 38.212 [17], clause 7.3.1.2.1).","paragraph_zero_based":40513},{"literal_text_all_w_t_and_m_t":"Table 6.5-1 defines Short Messages. Bit 1 is the most significant bit.","paragraph_zero_based":40514},{"literal_text_all_w_t_and_m_t":"Table 6.5-1: Short Messages","paragraph_zero_based":40515},{"literal_text_all_w_t_and_m_t":"Bit","paragraph_zero_based":40516},{"literal_text_all_w_t_and_m_t":"Short Message","paragraph_zero_based":40517},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":40518},{"literal_text_all_w_t_and_m_t":"systemInfoModification","paragraph_zero_based":40519},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs.","paragraph_zero_based":40520},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":40521},{"literal_text_all_w_t_and_m_t":"etwsAndCmasIndication","paragraph_zero_based":40522},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of an ETWS primary notification and/or an ETWS secondary notification and/or a CMAS notification.","paragraph_zero_based":40523},{"literal_text_all_w_t_and_m_t":"3","paragraph_zero_based":40524},{"literal_text_all_w_t_and_m_t":"stopPagingMonitoring","paragraph_zero_based":40525},{"literal_text_all_w_t_and_m_t":"This bit can be used for only operation with shared spectrum channel access and if nrofPDCCH-MonitoringOccasionPerSSB-InPO is present.","paragraph_zero_based":40526},{"literal_text_all_w_t_and_m_t":"If set to 1: indication that the UE may stop monitoring PDCCH occasion(s) for paging in this Paging Occasion as specified in TS 38.304 [20], clause 7.1.","paragraph_zero_based":40527},{"literal_text_all_w_t_and_m_t":"4","paragraph_zero_based":40528},{"literal_text_all_w_t_and_m_t":"systemInfoModification-eDRX","paragraph_zero_based":40529},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs. This indication applies only to UEs using IDLE eDRX cycle longer than the BCCH modification period.","paragraph_zero_based":40530},{"literal_text_all_w_t_and_m_t":"5 – 8","paragraph_zero_based":40531},{"literal_text_all_w_t_and_m_t":"Not used in this release of the specification, and shall be ignored by UE if received.","paragraph_zero_based":40532},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40533},{"literal_text_all_w_t_and_m_t":"6.6PC5 RRC messages","paragraph_zero_based":40534},{"literal_text_all_w_t_and_m_t":"6.6.1General message structure","paragraph_zero_based":40535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["32b8a22519cef7b82ec2b79c6ca99e93389987d079215264ca60c22fe8b30f3e","85afeb197d52feca8ff717a4ce966671ffc3a4404327056824eaaeec54fd3cb4","71372d4448104acec6b8732d1aa7b46afa362368034cb715a6fdeec1e3c17c9c","1d76c2e1c40ede9469e84e4a50b0f500a811e5895ed3fc37f5d62eb9cf02c8ba","fc18febbe52e93623227adb26edd55e7f9275e01e32a279b10f7665162bc393f","fba8a1b37c3144e0d89e76932fdf34acd31186908ea09ecdbf1159014cb398f9","529227efc1dd2232893a2eedce1fa4c4932a01d242047094aebd7cfed3314796","dca7d60187dd5cbe48124ddde97e37c7f682cdb9e9efe8a33f83ff8e4e193b96","133dd2457ccb55ce8e137c45f09567046fb4a6bb8caba89f24dba5d015cf0783","856a446d371da2a0fd196b53bc314874d8150943b2483c1ac399e101c8a7f80f","643337c1e87794