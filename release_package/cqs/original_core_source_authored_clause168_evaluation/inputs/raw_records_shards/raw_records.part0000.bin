{"fields":{"filename":"R2-2306787.zip::R2-2306787.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                                        spare9, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-4, posSibType6-5, posSibType6-6, posSibType1-11, posSibType2-26, spare7, spare6,","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"                                                            spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"            encrypted-r17                       ENUMERATED { true }                                     OPTIONAL, -- Need R","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"            gnss-id-r17                         GNSS-ID-r16                                             OPTIONAL, -- Need R","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"            sbas-id-r17                         SBAS-ID-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"    valueTag-r17                            INTEGER (0..31)                                             OPTIONAL, -- Cond NonPosSIB","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"    areaScope-r17                           ENUMERATED {true}                                           OPTIONAL  -- Need S","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-STOP","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"SchedulingInfo field descriptions","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"Indicates that a SIB is area specific. If the field is absent, the SIB is cell specific.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"si-BroadcastStatus","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of si-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting. When SIB19 is scheduled, the si-BroadcastStatus for the mapped SIB19 is set to broadcasting.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with si-BroadcastStatus set to notBroadcasting in the list of concatenated SI messages configured by schedulingInfoList in si-SchedulingInfo and SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when si-RequestConfig, si-RequestConfigRedCap or si-RequestConfigSUL is configured.","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"si-Periodicity","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"71bf8a03b8168d0eb793b81e95f1422678456bcfdfecb5f615e838825767ddef","original_member_sha256":"e2f10bb1655d30e3234a69b31dcee442967ee3237f297b9ca235efd79a3eb3e6","paragraph_ElementTree_utf8_XML_sha256":["36822b7d36c12ed097f9ee46697a823bdbdd318021e4ba5e722f0225bc343d1f","1968c04922d1b77cccf66f3ca18a6849ae32532b3415c2474079d6fb8e5b0c35","5919c83fbbb21b90f64c37c7fd83da58495d03951ab976bf8c6139ca2875ca0f","7e9426370d48b3b8bc387376f9b6cba6082ca3dbd92310f02ba7c7518e8a181d","ebbfee96cd84d86fa5da7e840bc58ffd850f571a155de6f04e023cb1783bbe7e","8fdf50c39834b060a77b8e525a68e8135822e2725b33b47a66105bc2546a1c3c","49aa039b74f909bfa24d4c5205bfe327c4596d2f8b1a49e876b7f416946f1f2a","bb16b3a0bf78f81d1a7bf60cf838d3e4f05f93b2837ce791974b75a755cd22fb","cdb88aa1ad9d22216425d5d2161613b012abe6924d15b1111cbae1ba158d9d55","421fe2e22190bc792c9dd01b5f0e6ee9a2f772fdfc1d8d33293970950896b7b2","e50c6aa4c3fdf3fbebf51a5ee79fc3ca7bc0e29142bada91e9a3fe08dd0aee7e","6f61c20c19605ed93080edf2d00ad1401356d82c207de344a33c9ea90bff8f4d","f0af1a32b97288640987376a10f379fc429256e85603e99378937a9d84445d81","2996bb0df4785619d7de5ac2821e926d6abcf0e1422871a0e7c3677bd797fcd4","db91e0a6011cb37715b2b9f31e0527c7b15a76f5075f2226d532d62954e45b15","27a4c9ced4c7381cd2a7e0b9788d8336444f94eaebcb7aced7a1401fecafed86","3860d4c39839883785c58dde8a9e2646a91131048cbb8f574f25b4ef3cec3204","6fadfb123c6588dfc09817fa34ed66c074266e4b72e0951017d9b833012e2109","ec41992b2bc8b76e582a8b900ccef9f6005b87bb2886f79cecfc6143dc584e92","80b9248217bad0854ca0f533afd2df200bd20759141733aad7cec350b24703d7","ad76659015ff94b67e16a0facc42aa76f9793b11e81b076e8dcc4765d84829c3","5b43f8a20b486cd3dc4428e9839411962aad2a9531d1053fa8f9890dca746655","e1dd6385951138353f206c2360935c77b670d0d33d16fe4c0d653ab4f9592a00","ad9710ab27c4017d749a5a0689f72fde9f2520bf31461d1f6a74bb2e3a75e91f"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306787.zip::R2-2306787.docx:p288"}
{"fields":{"filename":"R2-2306787.zip::R2-2306787.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames. Value rf8 corresponds to 8 radio frames, value rf16 corresponds to 16 radio frames, and so on.","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo field descriptions","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"This field is not used in this specification. If received, it is ignored by the UE.","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"si-RequestConfig","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"si-WindowLength","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"The length of the SI scheduling window. Value s5 corresponds to 5 slots, value s10 corresponds to 10 slots and so on. The network always configures si-WindowLength to be shorter than or equal to the si-Periodicity. The values s2560-v1710 and s5120-v1710 are only applicable for SCS 480 kHz.","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"systemInformationAreaID","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"Indicates the system information area that the cell belongs to, if any. Any SIB with areaScope within the SI is considered to belong to this systemInformationAreaID. The systemInformationAreaID is unique within a PLMN/SNPN.","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"SchedulingInfo2 field descriptions","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"The posSIBs as defined in TS 37.355 [49] mapped to SI for scheduling using schedulingInfoList2. ","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"71bf8a03b8168d0eb793b81e95f1422678456bcfdfecb5f615e838825767ddef","original_member_sha256":"e2f10bb1655d30e3234a69b31dcee442967ee3237f297b9ca235efd79a3eb3e6","paragraph_ElementTree_utf8_XML_sha256":["0498dfd388a8b1598a0c582de65c8915d2c14a5e05411a71788ce552be2372fe","d4bf040fce9374d12fd8e74f5b77c3da8392499f5992a7361f3b9541a6a2cfd6","70f1de30f4d63a89e1bebb0d161ff12b0f0e76c01499a83cdc3579c9d4af1723","716b8cddec9f5102f7028e033cfaf4715a68efb87bacd9f8e236758eaa07299b","0bf149d0745f130071dd2b7f23d308dc76b2aab00c5c8d931269b286273977f8","d851e7a6d17df6333b4abff7c5212c4fa275a8ad0aac37e9fcac22ef93b53d51","6f08231d7cb3c567052d8feab7a0909ae68632992252b6fe002fdd99f44c3724","2af9c9cceb7246b69563de7f8f521e1b0f4653922255cb6b27a7e05832667507","4cc3d03a263b7cd7e1d437e8c15962f9a94ba549818e225c0fe9acec28bfec47","fac15f4349393e1b61c913a316233b3cb5e1cb0251313ba0f212b6d8c647b1b2","f38783f290a20c44dc393d208abeb015276327e201bc6e1befbbfd6c507aba3d","33f302defd5110f0fc43a657555ca9b165dc61eb83c8ea02ed3e1f2d90d201ec","9c6e29ea2a155892e76af156a039962462f0c52a1d4d1a0cbaed37e5dd666d1e","a4938ae0afc343454f29c55d5f7680ce6e1e1b059b2618249258634f1eeaee29","99a77dacc0193be9edc8c4c4987aed7ca9431b598b17d53e65ed46df9c8d51ed","ea5d41f5a96cdb1eed04891632d2e2281b0153286f6986b4118c0c80c47c4643","08d2960aa2fbfcfdc58e24229e10bac51e7ca656e2ca4e329ab195f87ce36901","6dfe5c6bbc7583f753c6b6ba10495976377740f1c9c28a917687959828207d2f","d4c6a6e8b0bf7492fa2dfa2d1c64c240ad71a64c506858fafb7dfcd2534ec9cd","aa0b0dc13114833c3cdfa4540e2bdf168cfa47ae9ae77f251af5e1a5a2765a3a","7e6745983a5ec9551c1eec6416bae81100bebef76e6c4b1468b1e12ec2859275","3b254f92d276d841f0bb703c683f961a9bafb9b9c172beaa7705f0547815fff7","456c0f363d9b3179a7c38fdea81463a3c4e09a44c71fd96eeebd2102e800a3bd","6e719491085e2ea525849480a7976de63e28244ebac2359c2be2fa860ea11337"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306787.zip::R2-2306787.docx:p312"}
{"fields":{"filename":"R2-2306787.zip::R2-2306787.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"si-WindowPosition","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"This field indicates the SI window position of the associated SI-message. The network provides si-WindowPosition in an ascending order, i.e. si-WindowPosition in the subsequent entry in schedulingInfoList2 has always value higher than in the previous entry of schedulingInfoList2. The network configures this field in a way that ensures that SI messages scheduled by schedulingInfoList and/or posSchedulingInfoList do not overlap with SI messages scheduled by schedulingInfoList2.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"sib-MappingInfo","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"Indicates which SIBs or posSIBs are contained in the SI message.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"sibType","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"The type of SIB(s) mapped to SI for scheduling using schedulingInfoList2. Value type1 indicates SIBs and value type2 indicates posSIBs.","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if si-BroadcastStatus is set to notBroadcasting for any SI-message included in SchedulingInfo. It is absent otherwise.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"SIB-TYPE","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is different from SIB6, SIB7 or SIB8. For SIB6, SIB7 and SIB8 it is absent.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"NonPosSIB","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is type1. For type2 it is absent.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in SchedulingInfo. It is absent otherwise.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in SchedulingInfo. It is absent otherwise.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"End of changes","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"71bf8a03b8168d0eb793b81e95f1422678456bcfdfecb5f615e838825767ddef","original_member_sha256":"e2f10bb1655d30e3234a69b31dcee442967ee3237f297b9ca235efd79a3eb3e6","paragraph_ElementTree_utf8_XML_sha256":["b5b8d4083c84f746612aabf6be391ed762fc6044abfa577f8ab279868114d43a","ce61983d373b342ff44afbf8b2b36e5da2e48921cc44d7659fb98c652ce0d75a","2c8c793b9583331076c4b8e11ea414f8e11a3a0a24163a73cca08f50ce01615e","f937040df7993aa1a