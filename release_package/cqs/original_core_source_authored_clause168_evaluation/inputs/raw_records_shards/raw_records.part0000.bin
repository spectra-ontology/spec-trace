and_m_t":"}","paragraph_zero_based":13311},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13312},{"literal_text_all_w_t_and_m_t":"IntraFreqExcludedCellList ::=       SEQUENCE (SIZE (1..maxCellExcluded)) OF PCI-Range","paragraph_zero_based":13313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13314},{"literal_text_all_w_t_and_m_t":"IntraFreqAllowedCellList-r16 ::=    SEQUENCE (SIZE (1..maxCellAllowed)) OF PCI-Range","paragraph_zero_based":13315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13316},{"literal_text_all_w_t_and_m_t":"IntraFreqCAG-CellListPerPLMN-r16 ::= SEQUENCE {","paragraph_zero_based":13317},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityIndex-r16               INTEGER (1..maxPLMN),","paragraph_zero_based":13318},{"literal_text_all_w_t_and_m_t":"    cag-CellList-r16                     SEQUENCE (SIZE (1..maxCAG-Cell-r16)) OF PCI-Range","paragraph_zero_based":13319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["74779bd328a85e8e87491941a3cd2c2d82ba24f043cddb4aceba4d960a72cba5","25856f451be4eb64854d4d71f981f66cbae1d6a2a4631441fcb8c6fe74fa34e5","283174c7d03fcba545c026cdd34f40cd8bfe77e544ccdab86a33cea734ef1d5d","fbd8f0d404b77089cf1fd04bd632e27a6a52e033af2c224fd9a1bde9e86cc6f1","51afebfd03245c9572d93477b00450950ffb317c82ceb7ed9d7b693640891aa0","6f3bf84f5a57325f485b36cf6fa7c3b340154bc2a61523775adfb267e61cb14f","90a191d8867a374e6ff0d046a3fed371f7cdcb3de758f3d1cd03403416dcaac4","9f7f8052bae19a19f2a7a36d2ba3514d8f29ec26e797143e0a24a67204ccaa61","6b1d58189a56fa94e9cc63d1e825f2a5e163108b5579544d68941587d605444e","70f44e3845a130333e88260e0ee86acc22d20eb684dbf0db94b74684bbaee007","63820d32a4fa39c44e14e2f75a211f89817e8849e27be