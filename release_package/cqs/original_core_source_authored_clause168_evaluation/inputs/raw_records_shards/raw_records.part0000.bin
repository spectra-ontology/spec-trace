{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":27960},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":27961},{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":27962},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":27963},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16          ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}                   OPTIONAL, -- Need R","paragraph_zero_based":27964},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r16                     SSB-PositionQCL-Relation-r16                                    OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":27965},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                     HighSpeedConfig-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":27966},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27967},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27968},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-v1700               HighSpeedConfig-v1700                                               OPTIONAL, -- Need R","paragraph_zero_based":27969},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                                OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":27970},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r17      ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25}  OPTIONAL, -- Need R","paragraph_zero_based":27971},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r17                 SSB-PositionQCL-Relation-r17                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":27972},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                              OPTIONAL, -- Need R","paragraph_zero_based":27973},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommon-v1700                                            OPTIONAL, -- Need R","paragraph_zero_based":27974},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                      NTN-Config-r17                                                      OPTIONAL  -- Need R","paragraph_zero_based":27975},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27976},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27977},{"literal_text_all_w_t_and_m_t":"    featurePriorities-r17               SEQUENCE {","paragraph_zero_based":27978},{"literal_text_all_w_t_and_m_t":"        redCapPriority-r17                  FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27979},{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27980},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":27981},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":27982},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":27983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fa86de4cd789f996c07ae1b8b6d83a9ff589bc97092f20eabc33a7144f8cdcac","537762dfdd47bc613cf72cca8adacf672eb2d7cc18db5a8ddcab5f0a24b16604","510bfaebb0c3937f5ba201e3e7247c490dd01f78cd8976a5d0ebf3ce094f3c42","78285b82ca22a8bdea78332d5bccb7cb885058e601a141640ba0eb652a76ac08","9dddfe97e30ed02ae19c6dadd8599ea8dc519ae79fb0dadb71f33a78fc662eea","31d20f5ecee96a1bca7f6c13c7526aede7053871be80ae2faa28563a0df8568d","8418da66ae2354ec2dae7b6d0c026026c660bfbf7f9d3fd477cee95445a4facb","9b6b39ea8aa9ca51edb4a9adfc2b628f4c67725d0adc5bbcc4dab60b0c2eb494","737f694b6622599ce8b21aabe2d25dff1628ce467cb1d9b6c869d14032641129","30126a207b83cc3615201f09b5054762fd8eebc837b74d9d0b4c10e0cb6a2966","8c395a4476d22536ab2ab3fdf6970f1a361573778371f74149f5585ee533405c","8e2ea1b8527cb8c87dd80eeaa53786a3c6408070eb399750245742573bb33d26","086bac34116c6c16fbb83978a39f8ea7fbffa2aa22d324635d7aa02c3293c739","888aa6bc0e5aedecd634a9aee2d9191380b6841d7afc9b28be536ba5a4df9653","fa90c4e765eb8425afccf4f8b4ec045053129d6d4b0bdb86905f9aa73a5a48e7","626f1f499f9317fadc0efcfe261fe1a881da473c502dced5053fd3a78a0e14f8","b7d7bbd3727e39c9b64917b8c25c457f2c5134115965fc38ff9fd600224df2c9","5ba71abd47e4518cbbcc65fbca54eb5cc6fde709a933a72fa8e27d9aa5a9d26a","477f945435e317bdad5e4c14e82c392b4f5a78741f8cfc3a3114fa8d094e0fb0","78c0076f096c487dba5f380018f51462116ee26efc99d1c39bbcb1d390105799","37fd8533b1c61188a65e2300f3cc4e42fdc39cbeff12c2db49861a8adddcd7b4","e273f90d46cae2ffa00573d21249c60b154e5fd22844ebc5fb975f43eed1b93d","6e847767a6a4e7b256978604e210120491e01a16ef28e1bab9a01f9564a28521","ff4a6fc6eaad7fa0c5f843e44f8df408ac4ce9f3d702149cc6f6fa1b46ad64c4"],"paragraph_range_zero_based":[27960,27983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27960"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27984},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27985},{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17            ENUMERATED {enabled}                                                OPTIONAL -- Cond SharedSpectrum2","paragraph_zero_based":27986},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27987},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27989},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":27990},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27991},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27992},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":27993},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":27994},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":27995},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":27996},{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":27997},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":27998},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":27999},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":28000},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":28001},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":28002},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":28003},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":28004},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":28005},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":28006},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["61c72df3b214b6dd39444fc47f72d1e22d4e4c1d2cff9bb7cb7aba3cea68b961","5cc6f0d5f962d5f68b7ed8c2aaca80412143b9594b97d393c9fa77b79a545f59","165226d4921c47461f517b203e2a1be68e879bcbe4cdc9ca4feb95a15aafa96d","afeee6ff0f6cf8a2f6b0f19bbe1000d1b1caca2170c8ec8bf00fc4eba66cadd7","6901d4402bc9c8b426fc130d44a7a97ca2fed97d2992d8e9a964a5cef0c4be88","b570b2befe330c0d90f72b37374f26c572c2dbca05efc2f1c871575497661e8e","ad1e0068e219628ad565dcde97b7c991d7997ae2fa2c7c2cdf4a3e77e92dd871","b00191be6ed73c92e5649f0b855b40cffa7a970d5517878a155faa1996d6fff1","bae4ccf6be72a1b4bbb776156afd0f16659156de5c2e49be8dfd033ca45d6f95","c837e4c8ae2c6dcd4b3a0ad1dc32b794208322cfcf317b6bd87e83d8d95a9a81","cf0792ecafbf238cb2ce6ac6f13561b11299deccb3f64ff2999243828672e230","aa214f8b77f3cfa8c5092604674cb20442e59c3146d8c5ae1aa86a97b064c3d1","8488ebf60ffdbc2ee02ef458c93d5a0ac02ee0948e5468f920add9bf9ac32b93","2d013593bdbee56344ec415d2633dc8c7525b43f51248bd0f3d0c54f2bd7994a","9d1b4b67c13262b71e37b918ca782f5bcb437dd95ceb322acd461d0113d340c2","638791ae9df64ab165e7da6aa5fa8e70198f90c745a925060f730864317b0222","1175e7240b3eb3ea6924e773edf5e5e8b0b125f22624863ea826253b9abb76f4","67f0b694262443621aa761dcc14dc94111cfd70a7b72aa02c9137ade01f89101","53b83d3b441bb2e19f426b25e38f374b769661c60586cbd8dfe9e16ed9f36f30","49178fd570ba2c784ff08f655ada339e4a3cbbb0ad9665f5ecd6ae8ff07f82bf","c47525287e944eb5f469e1e4adcf957151f640762fc4af6b6e49d16ea915851b","5851110516767496d3c51be1239491e17e295ce85c53be9e5ab20407a6709c2a","7b4d72a5bb5c7d7b2749e22a0506df7314831827a316dae1a1f3898a26092ab1","55e5735cd7ac886643a5e8bdd52b80510afcd625ee62887d03fadccaf8b2c3a1"],"paragraph_range_zero_based":[27984,28007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p27984"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":28008},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":28009},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":28010},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28011},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":28012},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":28013},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":28014},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":28015},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":28016},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":28017},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":28018},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28019},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":28020},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":28021},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":28022},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":28023},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":28024},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28025},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":28026},{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":28027},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":28028},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":28029},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":28030},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":28031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bbea2bdb82ecd891d7f108c644ac45a408ecdc524b19ed11ef1ba34d1d868fbe","74c47454d6518ed0f6cac6a3a363781560ee8ee4178d8eeed47d0b627f1ec88b","e787beaba036f83d3981087bd90c15cd0261118f63a22ad8c070e90774c2311c","aa7155d570909f6aed872f95d9d780546ce17d7104ecb5ed6d7add95b39caf7f","c83bc5f662ee648fbf7dec40a232b910af1865f00a3b1e00dfb55dff4e28bec2","b497db60ed7466c1ef155c11e9fff05c78d924b511c1cbb3c329400c749e17c9","7acd9d44a2c92b050f76a9bf826da79d16e2cbb460757f6bede4ccf8e729aa93","ce994696d0bac3ee6e088cb363c3069951310eeb149c1c31fade99737e9f8417","5f9db2ef0427898fd0cb840a5d487a4bebd913edbdd78428d4ac0f259b4a6249","e35491501c71166ecfb4e909da39b7f9779023690b5cbc66b70c6c95cfd7fcd0","d34152fcca01424505d0baf5009fd4f2cc1a1389c8f0f5c35b1a5dc4de3e6c6a","09cc9c50ff27226b7b7b8a659e348ad5d41099ccf982ef78ae04c2b0fa6e7575","6cd67b48a51635c96897c213781c1a687d32f0793ccee13f787b9eb82c6bb9d2","9a1b984581f3cacd7ba320d23e11288588b8193eba33bf3c75d9af658147a7d5","096868592664cb6928f060b35f760e67dbebfad110d87fd7ad455b5704dc2cd3","7cf96d902186f44ffeb18017e2b773d02f5dc918816b4c0550bba919239a1ee0","a72ef5bf061092fd1c861a9ebccb96c46e8978f372a6805038c0e3550d766577","66e3c9375b5744fe085df4ae400e85158410c3790a6b11fd401737d0ee36dda4","67149e9d6889bf8f02c414f1226a81a7a7d0bc8f727dca3483c65adf5345f9c6","55a3d369159eaadcd7ff056405f52cfe76e329f6bc7e18450683049642eead48","465b602e2cffa07672af3f5b6ef1c151e40b125f5caf5d4d593e0e64dc7959b1","9338cf9d75baf91bc106130d010c153bfa0d5e2d0508059609ac7828a7717ea4","3d0efa30726924ee112019a11fa0ef6d932e8a5ea6d1f5ca9d65aab927c9f69b","8b12f3476ce0fec24e8d8be70dc0b1917d9802de6a78213a26c80dabd020436e"],"paragraph_range_zero_based":[28008,28031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28008"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":28032},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":28033},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":28034},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":28035},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":28036},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":28037},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":28038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28039},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28040},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28041},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":28042},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":28043},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":28044},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch between a serving cell and a L2 U2N Relay UE) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":28045},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":28046},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":28047},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":28048},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":28049},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":28050},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":28051},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":28052},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":28053},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28054},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommonSIB","paragraph_zero_based":28055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["adcf0f357b1317226c4f1e395ea5c779056a703f61af15675148de1f2496239d","a17a898158667a6c4f5515e0b3043294eb5da38e6dc4526ec3b485601204cfd5","ffc815747026174826ae617f3ad51b6a93e13ae6d99d8b91c5dfed6973b67807","299707a42639cc712d04f8ab8e439f8608f87910f49af0c43f479dedf3474b78","928d2c07bdc03e3536e8962f436f507e67070fb152f065dd9aa4c707e073f280","faf5c954e555bac35092a191c79337077da595c57bfd1eec5336f65f1d290dd0","141b62865e38dd3d8eb04aa2b9aa3222f7bc1ea7903c25e458931ed4b06cda6d","04cc75304efa75b2f75adcfa601646282decd4986273ccbcac06e0