ered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"f4de96798bbc81e192ab86aef4c96d5808f910f90c562fa0da86a9342b3834e7","original_member_sha256":"48d5af770e5366975fd1862efc9cb0a00102f51c91e75bdac13dfc8d4711e1c9","paragraph_ElementTree_utf8_XML_sha256":["c07b751f332d1715778439af0e62938677046d67b3f7a8208ff1b7c2904d8c6d","7dfb3fb76075b61a9006229ebc1669908792d11b89fc2b44504bb417d241771f","d94cc964f50f8250f1b803c238a1b9ed8708fd55d9540dc2b7637f32692a1ea2","09aae4af1f8f927139897dedbb8215f0d886b57ee3a83da4d8d40c61ba2d9b95","602ee220881ce1cb995b3adbdaf34613fd85bd8a13534f5c0a459462247605e4","0939711dc15e2bcfb9c9e5607296dfcbb24b8d238894144ca04c5bbf5a57e881","3ccfecb57eea17769747addcb11612cd6446c7d3961aec8b46b9e316516788e7","3e80991d81a349c3e6f0e7632da99040505209c551786dd9bfaa4670c902a569","cfebf552d8b2e8e6965ef4bf6ce757d8c201f9dd5c540b6d3c73897a4f6a3c60","361a3545cb44209292ba26bd62d3d57c5599234956a84b38f6bfccc1ed192584","77d9d09c1b02d8fdd3f04789f6d80f2b5594da22c22c7c89d2dd25a6e0852911","f750e9e06fa7222b62dd30d49b8e0e7d0c92256fb0d98d4feff26cc34dcf9627","b79b3935f3b0e310b9b62dc71dc47cde1f2f1650eb53ad4d00ca8ffbef5990d1","33b1c5ebb4da5c2057d1d8b3232094572415a7f341a9e6ba61f17fecbbcf57b3","f9740d475761f9cf0568428186a61235d6197d4d98fff000928fab9ac02a7a1a","6193d8400d8ab7c4e1abbd1614cf48eff6b2e7529adf5d785ae9fddbba3b454a","41ae8817b3c82014b7b9d4607e90fea2e49112b4e76ebc7f24444dd2d55b8872","3d3da3ed9751ca97aacaa15264403a90cdb5363a8cc77a67421e45eb6a3f3604","786965b9ba8092a27dd93a6fd458b23013be239bdd3ffa2cab4b8eadc1cf8c81","00fef4e0e1ff7b6f199cdc9b37307bfae429153a96ad196ea3a60eb1834b0130","4f240bb4ca7b2eba34beff91f273489e5ea98b419a7bcccb9aaf3d1c5c8c2b92","1a35daf8b042b0037722024c1d80c45f49b01aeb52477823491fc4e71f0925ba","9295c0a79c6519a0da042bea6a5530a1757c447cb6567b87a367e2853c0b56f1","0950a67eb52ed1ba78df82dafb328fbf6fdfc456d0c0ce33d6481862b7d49cce"],"paragraph_range_zero_based":[0,23],"projection":"All w:t and m:t including tracked insertion/deletion