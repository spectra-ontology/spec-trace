{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigGC-BC","paragraph_zero_based":37920},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":37921},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToReleaseList","paragraph_zero_based":37922},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to remove.","paragraph_zero_based":37923},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToAddModList","paragraph_zero_based":37924},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to add and/or modify.","paragraph_zero_based":37925},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37926},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":37927},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":37928},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":37929},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":37930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37931},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigGC-BC","paragraph_zero_based":37932},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigGC-BC is used to configure DRX related parameters for NR sidelink groupcast and broadcast communication, unicast/broadcast based communication of Direct Link Establishment Request (TS 24.587 [57]), and discovery message (TS 24.554 [72]).","paragraph_zero_based":37933},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC information element","paragraph_zero_based":37934},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37935},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGGC-BC-START","paragraph_zero_based":37936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37937},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC-r17 ::=      SEQUENCE {","paragraph_zero_based":37938},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-BC-PerQoS-List-r17    SEQUENCE (SIZE (1..maxSL-GC-BC-DRX-QoS-r17)) OF SL-DRX-GC-BC-QoS-r17        OPTIONAL,    -- Need M","paragraph_zero_based":37939},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-generic-r17           SL-DRX-GC-Generic-r17                                                       OPTIONAL,    -- Need M","paragraph_zero_based":37940},{"literal_text_all_w_t_and_m_t":"    sl-DefaultDRX-GC-BC-r17         SL-DRX-GC-BC-QoS-r17                                                        OPTIONAL,    -- Need M","paragraph_zero_based":37941},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37942},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["336572c1459b5a898f1892b39d7d50d478214d42922ad0ca972425c7e141177b","8fbe7955b14535e75c3e4eb97065e331550caf279e9ffe740a7cb531d775e316","bb93483a505a85aa803332868cdab17e140e587650f440198360fec8a92d8620","e2db1885fe76f957ee4e408a8b7527fa9a70d415896a0b2722a10adbe6d6d8de","0ec5d67aaad0d11fa872c9b71871b94a9f272e64f6f59038384017ee6586035c","fb1c5fc5ecfa2fe5da0139fba948ff1987100b9ed87d83b7cdf5dcdb2e579668","56edcdee278a4db7a77c960b2188a23ce925280c4dab9c4e7ceb1ab89b49648f","8fb21a430f0ec7b268cfb7559d38e2e1b7e95e5e3