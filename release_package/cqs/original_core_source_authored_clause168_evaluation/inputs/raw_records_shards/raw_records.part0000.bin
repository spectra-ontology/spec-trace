{"fields":{"filename":"R2-2305849.zip::R2-2305849- CR4118 Correction for release message with re-establishment v1.0.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Re-establishement procedure will be triggered again during re-establishment.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"NG-RAN Architecture supporting the PC5 interface","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"The reception of PC5 unicast release message at L2 remote UE","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"There is no inter-operatbility issues","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"5.3.7.2, 5.3.7.7","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zer