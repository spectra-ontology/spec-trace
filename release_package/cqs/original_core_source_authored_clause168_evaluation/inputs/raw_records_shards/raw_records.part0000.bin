{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":21432},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21434},{"literal_text_all_w_t_and_m_t":"CAG-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":21435},{"literal_text_all_w_t_and_m_t":"    cag-Identity-r16                 BIT STRING (SIZE (32)),","paragraph_zero_based":21436},{"literal_text_all_w_t_and_m_t":"    manualCAGselectionAllowed-r16    ENUMERATED {true}                         OPTIONAL   -- Need R","paragraph_zero_based":21437},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21438},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21439},{"literal_text_all_w_t_and_m_t":"NID-r16 ::=                      BIT STRING (SIZE (44))","paragraph_zero_based":21440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21441},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITY-STOP","paragraph_zero_based":21442},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21444},{"literal_text_all_w_t_and_m_t":"NPN-Identity field descriptions","paragraph_zero_based":21445},{"literal_text_all_w_t_and_m_t":"cag-Identity","paragraph_zero_based":21446},{"literal_text_all_w_t_and_m_t":"A CAG-ID as specified in TS 23.003 [21]. The PLMN ID and a CAG ID in the NPN-Identity identifies a PNI-NPN.","paragraph_zero_based":21447},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":21448},{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":21449},{"literal_text_all_w_t_and_m_t":"manualCAGselectionAllowed","paragraph_zero_based":21450},{"literal_text_all_w_t_and_m_t":"The manualCAGselectionAllowed indicates that the CAG ID can be selected manually even if it is outside the UE's allowed CAG list.","paragraph_zero_based":21451},{"literal_text_all_w_t_and_m_t":"NID","paragraph_zero_based":21452},{"literal_text_all_w_t_and_m_t":"A NID as specified in TS 23.003 [21]. The PLMN ID and a NID in the NPN-Identity identifies a SNPN.","paragraph_zero_based":21453},{"literal_text_all_w_t_and_m_t":"nid-List","paragraph_zero_based":21454},{"literal_text_all_w_t_and_m_t":"The nid-List contains one or more NID.","paragraph_zero_based":21455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9ad4ba26fc9835d44a48ef252993f9699995e6bc393fdabc2849e9f3ea092678","4defc7ad1776b4e968c60c494d3dbaa327d04eee8a635596eccde940f92fb2cb","20ca6b6e8c0f4666cc2bd3c81b40fb852c06c20b74ffd972f6460bb83e87cdd4","26c0c60f9028db3f2554ffbc418796e0b695ac0f5a267b6c97d0716705003bad","20ebc420135067646f6d5bfbbb1b3054260cc6f4170522d117d97cdb863fb57d","aabcbb426b45c1fed0f241a375d1f7312fc4da1961ed1c7bdb9ecd229156b266","94f4be7bbbf420557869cde469a8a164a6516cdc6dea31e307e91261a9ea21ed","c776ce5992a1b62d540360560dbd914356e38405618c609d2ada2769c892a054","b94f7cab8deda7156d26fab0893ae0382a2f6bfabedbe33e204883d941892c88","0de733aea37219028f47b023b767e1d4b1ce4744f50b197215589c4a2a8ed1ab","2d6e3df54d3ab6f23b9d9b04c138528ba4106a71112b0602bfb698e0544b29e0","963dad3e31e2f26b89349e0bfd82c5d350cd11244d964ad5a4f0fffdefaaee53","1c928b68b79a0c6d87df8d8c9da9bacba04859204aed9c6a21542d8b13d7856e","d4f710273d9c8d5e7ab25c54de1c038a0467801ed0199bfd58c530733fd6ac05","488f4b6983332907d399ede57f3d86f9c2538f1e8510c28da423b4403b51cde5"