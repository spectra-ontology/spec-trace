{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21312},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-STOP","paragraph_zero_based":21313},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21315},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA field descriptions","paragraph_zero_based":21316},{"literal_text_all_w_t_and_m_t":"needForNCSG-EUTRA","paragraph_zero_based":21317},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for E-UTRA measurement.","paragraph_zero_based":21318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21319},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA field descriptions","paragraph_zero_based":21320},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":21321},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA target band to be measured.","paragraph_zero_based":21322},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":21323},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform measurements on the concerned EUTRA target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration message or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that NCSG is needed, value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed.","paragraph_zero_based":21324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21325},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-InfoNR","paragraph_zero_based":21326},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-InfoNR indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":21327},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR information element","paragraph_zero_based":21328},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21329},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-START","paragraph_zero_based":21330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21331},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR-r17 ::=     SEQUENCE {","paragraph_zero_based":21332},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForNCSG-r17         NeedForNCSG-IntraFreqList-r17,","paragraph_zero_based":21333},{"literal_text_all_w_t_and_m_t":"    interFreq-needForNCSG-r17         NeedForNCSG-BandListNR-r17","paragraph_zero_based":21334},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cfe980f5de1eed72b01ca7108d61bcaf3ae591fee029e3012a144e3f674e8f7c","3d30ffd9d3863b11743b5b9bff4381b2db37970f15a6676538978552cdcc16e2","47b34eddbb1b9249fbf3d9905551ce88e7ed359e4451e8646be796b35fb0a2f7","de9770db1c7bbd2e22b4cd9712e313d4d8b3a844c97673003294eac76125b5c1","38a98c343f61783c63c66f48eb552109a67eab543bcc1e2b723912b1913a7c94","e0dd006e240bf876a2197b800932cec83ab5beba9b5f7404f240fd3d3ccf8da3","784457f0b14df2f71cbc1b0b48b7b40828d503f34e27daae1cae2cfd95c72da9","5c1e229b0bf34b16a3f4a718e6bf6ea49f8ba28d8faef5fae9ee8defd1bd701e","093a0b382ee577becb4ba4c41fa315f4c713b104d058381d4a9242c86f9a15b5","0b3648f2d79472e935577147e4564292237dc112e8