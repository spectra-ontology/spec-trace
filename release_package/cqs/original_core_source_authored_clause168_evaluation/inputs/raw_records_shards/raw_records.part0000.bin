{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2448},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR field descriptions","paragraph_zero_based":2449},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToAddModList","paragraph_zero_based":2450},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to add and/or modify.","paragraph_zero_based":2451},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToReleaseList","paragraph_zero_based":2452},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to remove.","paragraph_zero_based":2453},{"literal_text_all_w_t_and_m_t":"sl-PHY-MAC-RLC-Config","paragraph_zero_based":2454},{"literal_text_all_w_t_and_m_t":"This field indicates the lower layer sidelink radio bearer configurations.","paragraph_zero_based":2455},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToAddModList","paragraph_zero_based":2456},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to add and/or modify. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":2457},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToReleaseList","paragraph_zero_based":2458},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to remove. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":2459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2460},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config field descriptions","paragraph_zero_based":2461},{"literal_text_all_w_t_and_m_t":"networkControlledSyncTx","paragraph_zero_based":2462},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall transmit synchronisation information (i.e. become synchronisation source). Value on indicates the UE to transmit synchronisation information while value off indicates the UE to not transmit such information.","paragraph_zero_based":2463},{"literal_text_all_w_t_and_m_t":"sl-DRX-Config","paragraph_zero_based":2464},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration(s) for unicast, groupcast and/or broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":2465},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":2466},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":2467},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToAddModList","paragraph_zero_based":2468},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to add and/or modify. In this release, only one entry can be configured in the list.","paragraph_zero_based":2469},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToReleaseList","paragraph_zero_based":2470},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to remove. In this release, only one entry can be configured in the list.","paragraph_zero_based":2471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["bb0f5d6840ff31aae073f9385db5118bbc889013c850271b1aaaaf5f2b11d6ea","d2b7e0750e044eac2bc90ebc5ad4386ea51b60364f8d7f9034850aef788770aa","f73c7df1f87376dee22828e21583717e0ca47c6196eb7c328c10fe04b1724974","5562eb08cd1d756998520b49d05f20749c3e83b277657ca6f0e990ed7179f0ce","84c94c0d3b7722a7d9c8271f322f455a126707b10c3bb18008a59c7bd5174c94","2f0af2b9f2e4b7c2a960395b2ddf580c515a7cc8ba14b60e1cca1c3841cb93bb","e951441fd63ae01816288711b8327f4d94ec7cf12964895a037ec9eca0b24689","44567797603adc361a22ebdd85cc80a82113a7cfbc7e78053fccd588ea99172f","7803630b3925a799331ad940846aa4fb891ce9a26e77ee57a89139be120f5cf7","5768d449aa47e4e97ea7d1c270f86ae7640d5a47e137b24db9e6bd5ab22f6547","550af7675d0403a941db9c32de0f232b55ff560475d559601e4a90b986674ba6","b1024b92fdeafbdf27782bf831ec9efba3cdc039fb6cd596a33033084b219b54","5f7d573b3fc78a70e4900663122622303c2394a2ab0bfe574e886b58d8ab3ce4","4136e4a74344e6e643c3bfeef8de5bbfe4cfe0c2b6df2486647d4f91998a646d","3ed8e886946d0772f946278747fdcafb536cec8a0df319d7feb2d589ae71899d","fd46a81f5039e549fba209733e7c666c7150dd9d70952a01abc9fe9c2ff70d01","243795e71effb258f5f5e8e56fc3a68a983aa6b3bd6d6831cc2ab7a931958fad","144c1b995802ab4bb9bb70c370c87bd2234c2f73134b95cdefdc515a6f8f4b5a","0f2d4499becf094ccbeaa97abdccb600d201bc10982e0ca0ea8bae4288108a73","56059146e3ac4f9c9d50a599b53643374db3e4ef2477ee098a6a3de6031220b8","292a7d9d988c82d8e8f8b294e30d10bde5a66f7d19a0094859963171c6ea2deb","33a4597204632b5a6ee33fb6c37a7d0a34b539c4c92cece9f340be91c6eb6db4","3208b20a1b4bbe1a957d3b40df11333582a00d807fa9bb0f6fb2ff3f99b3f256","c4700ddf92bec9adb7a6bc2d996a8863133c9a9b4d12beefb7ad287caaf26599"],"paragraph_range_zero_based":[2448,2471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2448"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToAddModList","paragraph_zero_based":2472},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to add and/or modify.","paragraph_zero_based":2473},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToReleaseList","paragraph_zero_based":2474},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to remove.","paragraph_zero_based":2475},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToAddModList","paragraph_zero_based":2476},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to add and/or modify. Each PC5 Relay RLC channel configuration provided by network to L2 U2N Relay UE is uniquely associated with one L2 U2N Remote UE.","paragraph_zero_based":2477},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList","paragraph_zero_based":2478},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to remove.","paragraph_zero_based":2479},{"literal_text_all_w_t_and_m_t":"sl-ScheduledConfig","paragraph_zero_based":2480},{"literal_text_all_w_t_and_m_t":"Indicates the configuration for UE to transmit NR sidelink communication based on network scheduling. This field is not configured simultaneously with sl-UE-SelectedConfig. This field is not configured to a L2 U2N Remote UE.","paragraph_zero_based":2481},{"literal_text_all_w_t_and_m_t":"sl-UE-SelectedConfig","paragraph_zero_based":2482},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection. This field is not configured simultaneously with sl-ScheduledConfig.","paragraph_zero_based":2483},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":2484},{"literal_text_all_w_t_and_m_t":"Indicates whether CSI reporting is enabled in sidelink unicast. If the field is absent, sidelink CSI reporting is disabled.","paragraph_zero_based":2485},{"literal_text_all_w_t_and_m_t":"sl-CSI-SchedulingRequestId","paragraph_zero_based":2486},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink CSI Reporting MAC CE and Sidelink DRX Command MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":2487},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":2488},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":2489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2490},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2491},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2492},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":2493},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":2494},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":2495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["600566a6b536104560ea38ce0fac20f67062b685a59999562d127ef35a8517a6","ff7fa7000fbfaa0149df2436efb38e381fc8faa16ce02d4f87dcf4d756948ecb","7a9b40f1e995a260583606915c0174b972d9e48528d7c6b33fb5b7c2b9c9f00b","30e54e3c2b1e859de5b7a403a21ccb2fae0b8b60c952f778b8e028c100178457","ec14db151dcc4fa6338c551c12fdb7cf671f4738a4a471f43a2a2bfe7bc75689","ef30451fc12e54a0ef8171c08755e33