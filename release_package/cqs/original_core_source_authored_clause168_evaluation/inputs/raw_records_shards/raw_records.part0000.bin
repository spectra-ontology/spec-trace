_t":"","paragraph_zero_based":13768},{"literal_text_all_w_t_and_m_t":"–SIB8","paragraph_zero_based":13769},{"literal_text_all_w_t_and_m_t":"SIB8 contains a CMAS notification.","paragraph_zero_based":13770},{"literal_text_all_w_t_and_m_t":"SIB8 information element","paragraph_zero_based":13771},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13772},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-START","paragraph_zero_based":13773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13774},{"literal_text_all_w_t_and_m_t":"SIB8 ::=                        SEQUENCE {","paragraph_zero_based":13775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44abcd543e619ee32ab5ef1d82487a5183ffc6039d1604cb5f242b1b659a1f76","14921e53e0b4920cdcf8c842fdccd47cc11209902d3256b2affbff04e6500f91","d22f1ae91e79edd5b84609e0ed44e1bd52ee153d3ea183c7b7f209dc546bee5c","6c3d5111694cc9333ae228df27b68bc53fe51b689b8399b6efa853faa4908558","f61f542bc5da38a3721d1d729b1fc890a442b427c0361d67533a0d7aaa322ac4","a3a8d8d5109bb3571a647ca70e7a8d8e1d6b3a20e8522a444d0f135eb9494204","e0905d449d546447f465364a1de0de4492202e20e9853e6febb3f07a57f90bf8","8b2fda70406239970549c0d56de53727ae317d167b44778421ea5cb334199711","38b999a0a260e2b7af56732033f8959f0bd206956777448f5c6aef5012967043","82b778e67931f1fbd873cf05efb5370ad5b8a1ec6ee1242b13ee38e6ba00e54b","0b4124e1d524aaf1306efd9152aa95f9a90aaf2d1ca48ceed1295900d4316929","c8e4cfc3e023f31e85417162e534b503097bb4041a7371a425f72e3aae2e385e","e7dfed3ead86b71babb7bbf959edde489ac8e1dd3ace6e4afdbdcffc4302dbff","d1f3853c9d4e859b3032f277490fb94979ea21e5a02c125f028afcd7264a281d","2ef949d101a24c8d250d1be4219dde26577e2a89f0d561f2fbb1061489bc7b09","ab646dd2a00a482