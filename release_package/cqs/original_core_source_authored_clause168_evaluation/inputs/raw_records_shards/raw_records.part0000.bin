d143d107626164e347a68e8d633107a401c557e7e1ef21233bb41734af01","9a25f1cfd11e67768777788bee9075a4834454150df4928d33be70bfcbb5d4bc","7641c70ac0aed2741218613193ea661ab272838de8c90dda3b2b7631fced06cd","8e67705e230215353ccacd31c56f08f55ac77286e3bc6445f9af1819f5770536","c292a8193671eaf0292ce6878b2ba2580b44c975f08c8928c00c7f77e87a4752","393a508503951dd149bf9f2e3f104b634d52135a1db9ccc3ba8184b8940ca48b","0e04833e3734b8b47f13acd3ed43238f28a55acc71f1906980a820004fbceeea","de22aa7ae4d5824d304e2cefe4e4513aa2c76c0c71312bc1267b8c631d7ee093","18a8e298eac0e694c882829c7872509ba24eae90bc5d5afeac027d0716570b01","db94baec41f0899a328189b85fbc72fba2fd4c380d48b475421f08091208b27b","a831d82210b1d257d77f7cbf72a592c58234f755c422d485e868dfe18cfff761","299454266a6fd9fcadcaae4a82e430910d9d4e20f29528e1cdbb0dd8e6d3b72e","a5f422a190d806ed2bbae26f4fb298102b4bdb16879af783eb9c73a9a86ef82c","f73757a3055ac56d43e514578de0fc6c154e871bae14636ba04d332a5b1b6a1c","c0859319df1b7153b2c915962a19d5bf3022ed620269c1301c524111fb3a8ddf","16533279aec316580b6cf05c9188634c61c1946cfc917af00596bbb75c4bf3b6","c7293aec9eaf3a6cd6076e6668315540bbdddec0e8371baf303b8474963fc462","ce9d43cdfae2372beb2deff5feae6e1449088984ebb85ea7239b55c0fabc3413"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p288"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the zone configuration for the corresponding sl-ZoneConfigMCR-Index.","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfigMCR-Index","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["e2b959d2dce8221d796eb7869e8be5f855ecefe5da42f209e0218262890377fd","5a42a433893b1dd2f90117a45758e83ef6c8b36324086ef704ee046655cf1238","24394bae4547715b439c6836e68b52d35acec26d3e4cb7cf7c920310334d8bf9","61ea5141173199ff8b11d00c0c7e253855295c65bfc8d53cc71b4f9b05800955","f8ea3ab5a839c854f624b9396e237faa5768f9e760bb305365b068abc95b5d7b","bf4a3ba7d7e96e557b5f40d50ae118b18f5e3ce9510f585a48931787ab6fb196","1d8fe8254eb840a2e2ebfc560ed1c8e517ad1ae7f927da7f468b42f6678e260d","1102ca380e4031b57cf1ac737880be0b49b0c613903988bb01a5fbe32ef4d4fd","034464e4b6edc1ecedd42ee135b3b4acb44f2dd99d17a5427c599d74fb962927","facc6a5700bcc3b4e3ced320fcb474a570a4c73c7b83e704fb5d4b39e5548fc3","867beff6383d6ed76f2b03ce92d2d52b0869e1ab6a6f4fad3c599c1f15a8ca5d","82f650ff7dcfec685bb8ce329bfce3696e470d87a1de770ff5e43f1aea1e5466","f9d45e13c518664fd24fe466cbe637eafb31a50643a4e5260ced11ebfd0c5eea","a2072cad12d52699be1c4028fcc880c2f9b2b210ac059709dac552e0798caf80","23d56db2759d311c65f35da3f4afb97d3caf9f9220d7044a712ea850d096ceef","62ff640dbaff2be9ecb9e48465a1bd277a9d66171ed93fff6916a4d0fe8d24f9","338e6482ba35668ca339b301698790f9a0cbaec08ce908ab2410d3d17c267e47","1dd521037a2a511fed51e2da6cbfa29deef24f896f2f75fd4ba02c92651c0ef9","09e6d46748b5a47499a846bb7c2bd3e22b6c1ac426dde24455362510f7584ec1","545b7f6e5a2dd206f1611c85536f1dc64609c68e7a83bf23a10a0b96c213015f","ccbc667aff8ecaee94aa65211b9b1674148ff676ef2e007314bd9345131ab78f","6bc56aab48cfcb6f7513e2c1ab56aa750a2274372872d82c7d24966eb1517839","b657722ebc193d3cd8e30a76d8f671d11650200865f008b36b37ac8d85906d94","a9a1eaa6aa02decc5445380976d52b62db070aeec3ee1f61f13c243263467f66"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p312"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["3431eaeb9797cd70336fee5ba4e9e1ca46c02dda3301d95f71f2748f3ab46b96","d0d7ec1fb0b588c8f972ebe8979aafd1bcb24e5a492aa299cf051a65820731c2","7c9b9bd388396a21456ebb2f58310a00b781ef095644d86ec8de149d90b9299a","1ce42ac853eaa4395e35d8fbd8879da3b596ce27076220625176d1a3e2aaf25a","90de0d77f40a07bf57db6e0869e4c9e1159b15452d2a00557ac884a5026b74e5","4fa5a99b41165c31893ab403a78a61f7f060c26d0ff37d8911e0bb1da20d1713","1f5f0912a388626967217b4f4850db136f09ce0c5c5e1acc311fe3a345b1c58c","8db01023ab6ede25b1aca6df58384b4735f0e4d44633f01e1f00834f03e972ea","eea1090c8b34c7404025edb95add4ff680d936be2d80b6224a411f117058fd4e","dd94658c8643118b2e13e3e495801f77f9e2e56470a100b75fa147fd50b734be","ded28c0961a4ae794b5f975a325025a082d8bdf9940e386c01c0641edbae8533","dbdea2294a16dd48b425eea7c2b5bd7616f5dad97fe0ba7af26c8d1a6a66bbef","254e498c671a5bb93d84cd923e5b039a8f5a26a2bcdc2db964581801297879d7","1ec37bae2b14c33f938adc21bd8446c7d4209f357064ea31fee739b6a2e3bf90","830802194b02d59374f38aa58979f5f660eaba31a623dd8a8d84ae7276303eaa","fcc0d56b8659c8563bceb0dddd104f6ff2dba811386cca773d762fec0bccc213","a75450875ca1f3bb0cc2f6feb21334e87f2673249c85d00f43358dc7a27d82d0","fe48179cd0147dfa1c053d19ecee009fc879bcdc9d39764575c39c0db1fe4a1e","23503e606da1753f2a352bcdb437d7af67896fdb5546e49ae0d1e44fe4749b01","9a6f91034155ecd58faf04a6f07e7498722c52b1be739ca3526fd72441377082","4419553d9420fb78abc2f769d9a30b02a340e797b5caa12da5de9968419fffa7","bc28a83821ce86f8366a6e0776276ee73758274b10ec8a0d6835f819426232e6","801ecfcc0826a74dd603b2b93d93dcb9e9840903da0c28b08265f2b18de41efb","8802c743945656feeaee2f05853df484a1c900ca8e35695797e1dc04592b5307"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p336"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBits","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in first stage SCI.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"sl-TimeResourcePSCCH","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols of PSCCH in a resource pool.","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-Config field descriptions","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"sl-BetaOffsets2ndSCI","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"Indicates candidates of beta-offset values to determine the number of coded modulation symbols for second stage SCI. The value indicates the index of Table 9.3-2 of TS 38.213 [13].","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-DMRS-TimePatternList","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"Indicates the set of PSSCH DMRS time domain patterns in terms of PSSCH DMRS symbols in a slot that can be used in the resource pool.","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"sl-Scaling","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["2bea0dcbd2e85f05cb1c65689963e3d7578e6ba74eabbc123e8bc90adc43c527","48eb731012e2f17b84d0624c8fe7482fd8c63b8ff4246893c4fdafb6194b5ed5","8bba9bc9c588d015d12abc8014fab4810f9dd46060a881219cde12980756642a","824e59069663d76c2202a7319ec3992ea726fb4ca2dab17ad505a342e138f258","3d91795826e332e5035988edb86f69adaa5cbe05dba23f8040edce9de762c090","4f51f9fc602c9344a1a83333c6727cd7875541ed23919feb097b342bfa0d6da2","efd607b409dbf08953474c0da192913a1729e3a01f5a21f751234ea40b727f08","13303a801d5177dea10fb4fdbc08bec74e7a254228a96af3abe89a57a9d4f73c","ef73da4f372a31a16fb06cdbca2702d466680f07884adee2584a5d9399dd153a","a7dc6803203d47f9fb71a7e61bce02b3ff44e26bf6b11eac30f376a665719286","420a1c91374a6c67988f20e1242e0ae281f73630ff8b68684438337e83506fac","0abe6be8c16d1c3f4180d393bb4fbaef771359d83c83427eb186fc775f29a8c9","0a50025e9a3c6e2ed4cdfb434522cb8f16d3b4ebfc91e64539958a0b7c2bde94","d28f7544a2506eb05870fc1a52b8be85392a5bef46c3cab22d228fb9cccf0e66","41c8b03dc37f5463d17ee26e16c29e86f943c9d3ec5f387edd51dd0601b53775","d9289f49dadf33b3e7e5a2836f117c84c41ddca8cbd44547afe23d6f512a717f","ab5db328fdc9ddaabc387c44ddc9521cfb46a8a6c6f89c9056406d72697a00e3","ca8d66b9808b6bde26933f99a68e449e2373780d2a9ebe89b4a3925914dec056","0b7142b4e70fb2db3dd38ec373e7ca2b7557449cd8255a5fdcde6e99ebde4d03","9291fe5f647f6f1bb21b2e71bdc6484ce5011fa19fa177d83d4a332bf0a95560","48588aaf09077700027a2c117519abbe2d34c75340db993e9284732d119a6ee7","d3371e5818cc3fbec575c2efb660d605b3acd18c434ca3b80c14124e7623c82b","bb6347f7df4d2c6f93b33c149114b0825752ea8b34870cd3eaeb5b89b32c59ca","cde20b39cc9d9d63dd46c77ac68f83520da11e693a7ad7ab95a0cd387a3000f8"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p360"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to the second stage SCI on PSSCH. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on.","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"SL-PSFCH-Config field descriptions","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"sl-MinTimeGapPSFCH","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"The minimum time gap between PSFCH and the associated PSSCH in the unit of slots.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"sl-NumMuxCS-Pair","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"Indicates the number of cyclic shift pairs used for a PSFCH transmission that can be multiplexed in a PRB.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CandidateResourceType","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"Indicates the number of PSFCH resources available for multiplexing HARQ-ACK information in a PSFCH transmission (see TS 38.213 [13], clause 16.3).","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-HopID","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"Scrambling ID for sequence hopping of the PSFCH used in the resource pool.","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Period","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"Indicates the period of PSFCH resource in the unit of slots within this resource pool. If set to sl0, no resource for PSFCH, and HARQ feedback for all transmissions in the resource pool is disabled.","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-Set","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for PSFCH transmission and reception. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on. Value 0 in the bitmap indicates that the corresponding PRB is not used for PSFCH transmission and reception while value 1 indicates that the corresponding PRB is used for PSFCH transmission and reception (see TS 38.213 [13]).","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"SL-PTRS-Config field descriptions","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"sl-PTRS-FreqDensity","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of SL PT-RS  as a function of scheduled BW. If the field is not configured, the UE uses K_PT-RS = 2","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"sl-PTRS-TimeDensity","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"Presence and time density of SL PT-RS  as a function of MCS. If the field is not configured, the UE uses L_PT-RS = 1","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"sl-PTRS-RE-Offset","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for SL PT-RS . If the field is not configured, the UE applies the value offset00 (see TS 38.211 [16], clause 8.4.1.2.2).","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["4df42ecef8e37af4d49179473c0616b0d09fd0c81e5ae73ec8087cea7418265e","adaf339a4f14734dba101cceb89ce66216ec4ecc9c5cac50a4a231aca62285e6","62d0f574ea22bbfd52685d71599e4b2ad65f7df29af575e42b973af81076edde","0120211e545b4ab13af9b35c88db8cce94476a30485b65e17385977a6cb27008","84388a4196622e78bf0475c86d8554efa28c16c7f3df667470398b78b1d4f3bb","206085c2e7cb2aa45efcf43c9d7214950e4401c4c9dd9759f27e022cf55608e4","f7981a27d7e804d10fd5ff177da99bb5e76c0f74f73921647126cd01e6c22151","d8adfc6a51181837adbb92357e69dcb8168f80f3d904cf0f78cdca0ce613b0e2","025702b9f32eb952bf8e54bca0101411e474d7af7cd8d6123496c4aad9fb9aaa","b340b696248eb120b22a96a0438d9b9482f89ffc6d4b9dee789852ce9c19650b","c93a52145dbba3344d9bbc92f7962b7d831279344ded7553a63e6df0a91896b7","76898da179b9836bf0b0c67c23decf72e34c2c24316e3d3163eceff8c2c9b8d3","d7a2b30d8b4363dbf111b828bb1741fb08c233a2aa1294cd7f517e943e5b12a8","cc0505f18757623df3edf7e0ca95e63453d21df19584f151255689ad921ab361","21c1810e8f5458f6df71b377454e4fcc0b5e00ebe1932f168c1e0ff99600771c","41cd7fb4a46854d187a546f8a0f1084a2c7d4b8d44d078076c563750f4dedafb","81a60b2651e7b4bbdb38112a15c7a852281ba884ba1ce2f146b711181b17bdce","1e9fc4a86dc259cefa65f6e901363a57660283b3702ced30b7c6ad4a485a6e6a","264e1a29c38efd6316523b94a3d2b1cac1e7be1f492e41512b0c05c2031f12e8","28d695db7d713d1a3109e9f6fdcca3e7880ca554b0d991c0a8e2d0c46bfc5e54","d553c07b6f630d816d0bcfb2550b28a84614ab60141d6f53fa297a7ff276b956","63d780c4ac3147472819e1a00ea1e293d20dc0d5bb46fbe222e7fba3364099b9","ef07e501536e14cc6e5e8c673c8d42e6cecc60f2e283e3efe9c4d29937a24e01","694c00f3405502411d7e0e8b21c5be7730d6b21e67ea217fa286332dac75820f"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p384"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfigRP field descriptions","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigList","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between PSSCH transmission parameter (such as MCS, PRB number, retransmission number, CR limit) sets by using the indexes of the configurations in sl-CBR-PSSCH-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-RangeConfigList, and priority ranges. It also indicates the default PSSCH transmission parameters to be used when CBR measurement results are not available, and MCS range for the MCS tables used in the resource pool. The field sl-CBR-PriorityTxConfigList-v1650 is present only when sl-CBR-PriorityTxConfigList-r16 is configured.","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserve","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of reserved PSCCH/PSSCH resources that can be indicated by an SCI.","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"sl-MultiReserveResource","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"Indicates if it is allowed to reserve a sidelink resource for an initial transmission of a TB by an SCI associated with a different TB, based on sensing and resource selection procedure.","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"sl-ResourceReservePeriodList","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"Set of possible resource reservation period allowed in the resource pool in the unit of ms. Up to 16 values can be configured per resource pool. The value ms0 is always configured.","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"sl-RS-ForSensing","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS of PSCCH or PSSCH is used for L1 RSRP measurement in the sensing operation.","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"sl-SensingWindow","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the start of the sensing window.","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"sl-SelectionWindowList","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"Parameter that determines the end of the selection window in the resource selection for a TB with respect to priority indicated in SCI. Value n1 corresponds to 1*2µ, value n5 corresponds to 5*2µ, and so on, where µ = 0,1,2,3 refers to SCS 15,30,60,120 kHz respectively.","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"sl-Thres-RSRP-List","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and the threshold should be selected based on the priority in the decoded SCI and the priority in the SCI to be transmitted. A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above a threshold.","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"SL-PowerControl field descriptions","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPower","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the UE's sidelink transmission power on this resource pool. The unit is dBm.","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"sl-Alpha-PSSCH-PSCCH","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for sidelink pathloss based power control for PSCCH/PSSCH when sl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"sl-P0-PSSCH-PSCCH","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["9ca074754bd6a08456058d40a6e7dce11fb50d07c2db4aa877e1605b407dc7c9","c8803e342672177d65a4b37bc68eb9092894b8264eb3687d5ad8e26d15300793","a0e7369f886b9031b4897e3745e3224a18a7da820eb5f42aabadb9b7c5b08f39","e70033f5931c2bde331914831c8c84f9301da8903e1455f1a036fb32b5271f2e","8ccb1c85aafd7933a6a85ef996f8f815bd7f31efe6d51d0ac0bc2f8df5fc0259","4aaa052b048e02ecfc9c58c110088c93440ab600127bd56e4c911698547ab135","c59ab6012a2fbf23f2964dd70c2015c39a1ece8769906294e44c9aa1f2e8d21f","0789e6c2f6a94ed8d685ab10707781f4a7ca6480c19cb63ba1adef4d35f7ae7c","11202a138347713cbdb9d085bdf018899c934592506368c788aa071eb8d62307","6d941a97b36c2be8727bc546d53d4e376b37defb1fe85ab47e22fef9cfb552fc","3341ce449287fd6c090b197d47273ee65371dca9d4f0c7de7b940b5f718cf32f","3bc432ffbe4766947facbc65dbb4175083da68cbb6780e0063b44f12cf9dd030","71ad9ff1b2df28cc639f15dac9b5dd325be18c5c834ffa00436206374cf611f3","11923daadfe9d0b0201966c014fac732948f318c23cd1d63d1e7bf1ce4066292","2cf6a146b6c76edc205b791c0f0adb6cb239f59bdf9fdffa344e4ac265139917","3077fc4b0672231dbc1c8333d81d88bd84df06c31b701656609025a5d0bc5184","8f8aad62a8948ce6abdf4db221f385d93846338e9c4aa0bb3ba33278746cd28f","c1fca7b1017d5e4281fc36f3d8a0338047d3b46dc1a74894ab68579dd6c43797","d94e70fca7f74a4e93bc083dd446f853aee3253948b69926c31434c217c75691","92452225ce623c06fa62981961ef6386b8bfbecd2836c96834f140aaacdb339b","6f92386799936e3d0e9d61ee811563cebbba7784e218421f60d3fc56415d0539","76ecd6055b425b4909d22f3b28d20b9b95b693f0826e7b7b9124f9533c2b74c6","c01dbe125f7490a4b0247db40aa92df5ec4fe59ac1a61b565bd911b03f03c279","2270f10db58637cd13beb91c1a00102a658fdddb2e378465c7de7572bb6c6aa3"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx:p408"}
{"fields":{"filename":"R2-2301175.zip::R2-2301175_38331_CR3874_(Rel-17)_Clarification on dl-P0-PSXCH for OoC Remote UE.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates P0 value for sidelink pathloss based power control for PSCCH/PSSCH. If not configured, sidelink pathloss based power control is disabled for PSCCH/PSSCH. When sl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores sl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSSCH-PSCCH","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"dl-P0-PSSCH-PSCCH","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSCCH/PSSCH. If not configured, downlink pathloss based power control is disabled for PSCCH/PSSCH. When dl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores dl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured.","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSFCH","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSFCH when dl-P0-PSFCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"dl-P0-PSFCH","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSFCH. If not configured, downlink pathloss based power control is disabled for PSFCH. When dl-P0-PSFCH-r17 is configured, the UE ignores dl-P0-PSFCH-r16.","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSFCH when dl-P0-PSFCH is configured.","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config field descriptions","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"sl-MaxMCS-PSSCH","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"END OF CHANGE","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":451}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["6b75f8b2faf9ccbc5ef94437b217eaa95bf0c04f86bcfe7503f6b53004aa91dd","72e6c68fa4309476f73dc11abfef27d6f4517951118c619f0919bb13427eb090","c393a400b5f489d829779a3187654dda8ecfee532eb688ffaae2f12f380a0092","b32185dc0a89971ceba923822d766a2940a810705d0d35432f848a6982462cba","cc5271a22f70416bf1b81b39c6835b86a6346472426023d13bb041e545509679","26d9224d40c2394a8d4434bc85d92e63a89e5c2989d2ada91b5068322001cf7