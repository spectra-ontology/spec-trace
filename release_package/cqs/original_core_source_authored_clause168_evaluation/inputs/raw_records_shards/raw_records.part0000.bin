{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9792},{"literal_text_all_w_t_and_m_t":"PagingRecord-v1700 ::=              SEQUENCE {","paragraph_zero_based":9793},{"literal_text_all_w_t_and_m_t":"    pagingCause-r17                     ENUMERATED {voice}      OPTIONAL    -- Need N","paragraph_zero_based":9794},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9796},{"literal_text_all_w_t_and_m_t":"PagingUE-Identity ::=               CHOICE {","paragraph_zero_based":9797},{"literal_text_all_w_t_and_m_t":"    ng-5G-S-TMSI                        NG-5G-S-TMSI,","paragraph_zero_based":9798},{"literal_text_all_w_t_and_m_t":"    fullI-RNTI                          I-RNTI-Value,","paragraph_zero_based":9799},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":9800},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9802},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-STOP","paragraph_zero_based":9803},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9805},{"literal_text_all_w_t_and_m_t":"PagingRecord field descriptions","paragraph_zero_based":9806},{"literal_text_all_w_t_and_m_t":"accessType","paragraph_zero_based":9807},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to the PDU sessions from the non-3GPP access.","paragraph_zero_based":9808},{"literal_text_all_w_t_and_m_t":"pagingRecordList","paragraph_zero_based":9809},{"literal_text_all_w_t_and_m_t":"If the network includes pagingRecordList-v1700, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix).","paragraph_zero_based":9810},{"literal_text_all_w_t_and_m_t":"pagingCause","paragraph_zero_based":9811},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to IMS voice. If this field is present, it implies that the corresponding paging entry is for IMS voice. If upper layers indicate the support of paging cause and if this field is not present but pagingRecordList-v1700 is present, it implies that the corresponding paging entry is for a service other than IMS voice. Otherwise, paging cause is undetermined.","paragraph_zero_based":9812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9813},{"literal_text_all_w_t_and_m_t":"–RRCReestablishment","paragraph_zero_based":9814},{"literal_text_all_w_t_and_m_t":"The RRCReestablishment message is used to re-establish SRB1.","paragraph_zero_based":9815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["55983dbb538d6cc4564ce79d2e1d5da18a19d7cc978dcc9a85f7c38dfd6b7f26","8faaa5e64b7bad61400b7b63c02b67834b114caec17180b7af08bf30652caf1c","ead037101c6084e507707a9e78af86c28ff9650a0d79197b5ad53331924ef28a","b3d0f518785b2385dbcf60b8889536df36b344b1f9ae09cd6c50a4b7a863e2c9","a8c7f16c38180ea52b495ec1aa2068f1f355f3e9bbfc35e7a302906369cf4368","1143214b3751adcd84e5f88b0c999a9172c2883a4bcade2591f6adf47e5db61c","70c530f4bfb0532ce60432b55129e05ead8e5f1e314d114f7d2a9856dcc10d79","6e6401b8019cface23ff762bdb819c3d977e6f26b1add4e1a324acd5bd2f9d87","475382816de3c44453949b261aa89909fcc3bd474d8e0daf906df52f736cd5da","6b338b56eb2ddb48b1fa81329e0ed2aaf4ea3d801b69fbf24bad8831a737f722","bb4bef2810b0192f0ad54aa713784e380625a3c8b7407e1e97244f3c9498cba0","6fb5f1494fb38a9ba8016a77e5418a4b355d9bbf0e223a56bd8c9e18