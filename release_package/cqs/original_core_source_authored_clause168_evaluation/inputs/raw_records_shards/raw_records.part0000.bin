{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Physical Cell Identity of the SSB on the ARFCN indicated by carrierFreq.","paragraph_zero_based":44160},{"literal_text_all_w_t_and_m_t":"psCellOnlyOnFirstSSB","paragraph_zero_based":44161},{"literal_text_all_w_t_and_m_t":"Value true indicates that only the SSB indicated in the first instance of MeasTiming in the measTiming list can be used for a PSCell configuration (i.e. in spCellConfigCommon of the secondaryCellGroup).","paragraph_zero_based":44162},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":44163},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]).","paragraph_zero_based":44164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44165},{"literal_text_all_w_t_and_m_t":"–UERadioPagingInformation","paragraph_zero_based":44166},{"literal_text_all_w_t_and_m_t":"This message is used to transfer radio paging information, covering both upload to and download from the 5GC, and between gNBs.","paragraph_zero_based":44167},{"literal_text_all_w_t_and_m_t":"Direction: gNB to/ from 5GC and gNB to/from gNB","paragraph_zero_based":44168},{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation message","paragraph_zero_based":44169},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44170},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-PAGING-INFORMATION-START","paragraph_zero_based":44171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44172},{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation ::= SEQUENCE {","paragraph_zero_based":44173},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":44174},{"literal_text_all_w_t_and_m_t":"        c1                                  C