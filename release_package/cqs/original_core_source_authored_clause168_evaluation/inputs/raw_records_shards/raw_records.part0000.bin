e5720a73536ce9e5e0dbceab2384e43a8ead141a58a8438a0ddbab7f8","274f48894b2638e6e020876b7896767dd4f46c67316e4bd0f76dc330a879394c","3d4e62c4f7b27c54ea108759e6e6b98c31d95feb6028d863f7ea084d32856de8","9400edfc97207e7218d7c73e9c1bfc4c898515cce40a4951eaee21ee542accd8","dab0168001af81442318292d40a0517eae0e8e1b67dc25a2181e85b7036dbaf2","cc5a2bb0f88b6c7a65dc9fa14af225df1eccea64d0484a151f84c5fbdb2ed6c6","e7d3ee05c80543cb444713e1d89edfc651cea3e3052114f3e64a7545f3ed5bb5"],"paragraph_range_zero_based":[20520,20543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p20520"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20544},{"literal_text_all_w_t_and_m_t":"TimeBetweenEvent-r17 ::= INTEGER (0..1023)","paragraph_zero_based":20545},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20546},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTS-STOP","paragraph_zero_based":20547},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20549},{"literal_text_all_w_t_and_m_t":"MeasResultEUTRA field descriptions","paragraph_zero_based":20550},{"literal_text_all_w_t_and_m_t":"eutra-PhysCellId","paragraph_zero_based":20551},{"literal_text_all_w_t_and_m_t":"Identifies the physical cell identity of the E-UTRA cell for which the reporting is being performed. The UE reports a value in the range 0..503, other values are reserved.","paragraph_zero_based":20552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20553},{"literal_text_all_w_t_and_m_t":"MeasResultNR field descriptions","paragraph_zero_based":20554},{"literal_text_all_w_t_and_m_t":"averageDelay","paragraph_zero_based":20555},{"literal_text_all_w_t_and_m_t":"Indicates average delay for the packets during the reporting period, as specified in TS 38.314 [53]. Value 0 corresponds to 0 millisecond, value 1 corresponds to 0.1 millisecond, value 2 corresponds to 0.2 millisecond, and so on.","paragraph_zero_based":20556},{"literal_text_all_w_t_and_m_t":"cellResults","paragraph_zero_based":20557},{"literal_text_all_w_t_and_m_t":"Cell level measurement results.","paragraph_zero_based":20558},{"literal_text_all_w_t_and_m_t":"choCandidate","paragraph_zero_based":20559},{"literal_text_all_w_t_and_m_t":"This field indicates whether the associated cell is a candidate target cell for conditional handover. This field may be included only in the SuccessHO-Report within UEInformationResponse message.","paragraph_zero_based":20560},{"literal_text_all_w_t_and_m_t":"choConfig","paragraph_zero_based":20561},{"literal_text_all_w_t_and_m_t":"If the associated cell is a candidate target cell for conditional handover, this field indicates the conditional handover execution condition for each measId within condTriggerConfig associated to the cell. This field may be included only in the rlf-report within UEInformationResponse message.","paragraph_zero_based":20562},{"literal_text_all_w_t_and_m_t":"drb-Id","paragraph_zero_based":20563},{"literal_text_all_w_t_and_m_t":"Indicates DRB value for which uplink PDCP delay ratio or value is provided, according to TS 38.314 [53].","paragraph_zero_based":20564},{"literal_text_all_w_t_and_m_t":"firstTriggeredEvent","paragraph_zero_based":20565},{"literal_text_all_w_t_and_m_t":"This field is set to condFirstEvent if the execution condition associated to the first entry of choConfig was fulfilled first in time. This field is set to condSecondEvent if the execution condition associated to the second entry of choConfig was fulfilled first in time. This field may be included only in rlf-report within UEInformationResponse message.","paragraph_zero_based":20566},{"literal_text_all_w_t_and_m_t":"locationInfo","paragraph_zero_based":20567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f532b8dccac711943bf3767891767aca2c80c1f293bedd2e36031f1d2875262f","2dc6466dcadac3debbf34e6504fd889952db9c55ff8b88d2e02f498ccafc04df","a7368f0545719cbafd3f470ec1b5761a781c576d32a45235c415a27ab0c8d342","de36115af5e3a7a906a097ae868fddd90fba9451d92b18ea5703adddba37dbdb","6a357bc5de7b82dcfa00df04