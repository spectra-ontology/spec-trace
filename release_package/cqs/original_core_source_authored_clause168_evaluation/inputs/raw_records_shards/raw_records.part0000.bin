{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-UE-RxTx-TEG-ID-r17INTEGER (0..maxNumOfRxTxTEGs-1-r17)","paragraph_zero_based":1968},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":1969},{"literal_text_all_w_t_and_m_t":"case2-r17SEQUENCE {","paragraph_zero_based":1970},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTx-TEG-ID-r17INTEGER (0..maxNumOfRxTxTEGs-1-r17),","paragraph_zero_based":1971},{"literal_text_all_w_t_and_m_t":"nr-UE-Tx-TEG-Index-r17INTEGER (1..maxTxTEG-Sets-r17)","paragraph_zero_based":1972},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":1973},{"literal_text_all_w_t_and_m_t":"case3-r17SEQUENCE {","paragraph_zero_based":1974},{"literal_text_all_w_t_and_m_t":"nr-UE-Rx-TEG-ID-r17INTEGER (0..maxNumOfRxTEGs-1-r17),","paragraph_zero_based":1975},{"literal_text_all_w_t_and_m_t":"nr-UE-Tx-TEG-Index-r17INTEGER (1..maxTxTEG-Sets-r17)","paragraph_zero_based":1976},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":1977},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1978},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1980},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1982},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1983},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1984},{"literal_text_all_w_t_and_m_t":"Case2-3","paragraph_zero_based":1985},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE NR-UE-RxTx-TEG-Info is provided for choice's case2 and case3. Otherwise it is not present.","paragraph_zero_based":1986},{"literal_text_all_w_t_and_m_t":"TEGCase3","paragraph_zero_based":1987},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP, if the IE NR-UE-RxTx-TEG-Info is provided for choice case3. Otherwise it is not present.","paragraph_zero_based":1988},{"literal_text_all_w_t_and_m_t":"TEGCase2-3","paragraph_zero_based":1989},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP, if the IE NR-UE-RxTx-TEG-Info is provided for choice's case2 and case3. Otherwise it is not present.","paragraph_zero_based":1990},{"literal_text_all_w_t_and_m_t":"TEGCase1-2","paragraph_zero_based":1991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["e626b089674914183b5d35912c38b85b56eec9c5d75d7a6ce79e024cd6dc54bc","9ca530b41181d878d9a4c719ed4db4d1f0d5d2313cc94d74f2fd056d9dcb4467","707bc3d39db2ab54bb3051cb5c36d8130f6f9107930bef181fed1ab4727d0aae","335387006532e42b844e84996d0cda9c89b10e95500bdcc8cfd948aa9a34d9d2","01c2f2b62dd141cc80b9762a3935b6c3df4a13d6e5a64d8dc8f0edcce95c822b","2de8ac06302886db0b77164037896cbb053ce8fdd5b35ddde33041c4364d0a63","532ac58d3f0d4d299d6f26897e91ec4a2de32c69fc694d7790af06785977092c","0ccb78927b7c33f8f157e1b821aceadf4bc35f17ebe50bfc28ac1f3d071d78f0","77f3c3bb31a08987126b95285d1c18506303616774245e9a67dc9289841e86d5","8b16adde3402fc61572496eb11bfa6292a7af6c8f7d035903409633252f21db2","1c5d5a9e2b85f9e9b3b41cd375c96d03fd478479d84ec9624dc929441358889f","8860243a56dba176a99fa59c1d982f104c1d13b1712c8b8560bf1739291bd51e","9afaef8de56fa82426a97d0ef17d717d706bf6d937a4a696ba0d5c0d230db009","92f17112182f0fba186e4909e10ae44d9aab4124c2582e62204c20e77f859ecb","e3dde1b35a72ebb97f5d0098103c8154cb9d79927408994b836b9669747bff22","6bbaf10884070dfed23f44e88cb44b25ae85e8547eca9ce6d67b7d887abd1aaf","5a5eeb471b6c009e10be45d2a7b0e45051a7d6f3171b142a9b74239a6df75772","43a1ef6500e24ce656c2eac6e19d22413e0c5aebcf2058f8337c8a7d3e2ff9b2","c5fd93e626ec64d1234c4b3dabfeb390ee64f4ad0d19f529769795d427a0aa36","02551309bb04430a0dad2bd277246d6ece8f63bf83785753ae88ab68e3ad1898","372fe7b3860e2828dde00f6cb430aad3c36a83a3104aa89b6f41fa12bf693eb0","3d485933ee4d67759b9e815a21d2704c62d00f6ad8317d632e5686aff848c35b","36fbef09d8b061e14ad323bceb8e2e12e1fc1b6ca4a3c6cd12f4f1885781c4f2","c071d824bca1fb069c4ea693b7c4d34724e5ae8df64544d8894c498d676eff29"],"paragraph_range_zero_based":[1968,1991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1968"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP, if the IE NR-UE-RxTx-TEG-Info is provided for choice's case1 and case2. Otherwise it is not present.","paragraph_zero_based":1992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1993},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-SignalMeasurementInformation field descriptions","paragraph_zero_based":1994},{"literal_text_all_w_t_and_m_t":"nr-NTA-Offset","paragraph_zero_based":1995},{"literal_text_all_w_t_and_m_t":"This field provides the NTAoffset used by the target device as specified in TS 38.133 [46], Table 7.1.2-2. Enumerated values nTA1, nTA2, nTA3, and nTA4 correspond to NTAoffset of 25600 Tc, 0 Tc, 39936 Tc, and 13792 Tc, respectively.","paragraph_zero_based":1996},{"literal_text_all_w_t_and_m_t":"nr-SRS-TxTEG-Set","paragraph_zero_based":1997},{"literal_text_all_w_t_and_m_t":"This field provides the SRS for Positioning Resources associated with a particular UE Tx TEG and comprises the following subfields:","paragraph_zero_based":1998},{"literal_text_all_w_t_and_m_t":"-nr-TimeStamp specifies the start time for which the NR-SRS-TxTEG-Element is valid. If this field is absent, the nr-TimeStamp of this instance of the NR-SRS-TxTEG-Element of the nr-SRS-TxTEG-Set is the same as the nr-TimeStamp of the previous instance of the NR-SRS-TxTEG-Element. If this field is also absent in the first NR-SRS-TxTEG-Element of the nr-SRS-TxTEG-Set, all NR-SRS-TxTEG-Element's provided are valid for the measurement period of the NR-Multi-RTT-SignalMeasurementInformation.","paragraph_zero_based":1999},{"literal_text_all_w_t_and_m_t":"-nr-UE-Tx-TEG-ID specifies the ID of this UE Tx TEG.","paragraph_zero_based":2000},{"literal_text_all_w_t_and_m_t":"-carrierFreq specifies the frequency of the SRS for positioning resources.","paragraph_zero_based":2001},{"literal_text_all_w_t_and_m_t":"-srs-PosResourceList specifies the SRS for Positioning Resources belonging to this UE Tx TEG.","paragraph_zero_based":2002},{"literal_text_all_w_t_and_m_t":"For each UE Tx TEG, there may be up to 8 changes (different nr-TimeStamp) of the TEG-SRS association information provided in nr-SRS-TxTEG-Set, i.e., the maximum value for maxTxTEG-Sets is 64.","paragraph_zero_based":2003},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-TimingErrorMargin","paragraph_zero_based":2004},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Rx TEG timing error margin value for all the UE Rx TEGs within one NR-Multi-RTT-SignalMeasurementInformation. If the IE NR-UE-RxTx-TEG-Info is present with choice case3 and this field is absent, the receiver should consider the UE Rx TEG timing error margin value to be the maximum applicable value as defined in TS 38.133 [46].","paragraph_zero_based":2005},{"literal_text_all_w_t_and_m_t":"nr-UE-TxTEG-TimingErrorMargin","paragraph_zero_based":2006},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Tx TEG timing error margin value for all the UE Tx TEGs within one NR-Multi-RTT-SignalMeasurementInformation. If the IE NR-UE-RxTx-TEG-Info is present with choice case2 or case3 and this field is absent, the receiver should consider the UE Tx TEG timing error margin value to be the maximum value available in IE TEG-TimingErrorMargin.","paragraph_zero_based":2007},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTEG-TimingErrorMargin","paragraph_zero_based":2008},{"literal_text_all_w_t_and_m_t":"This field specifies the UE RxTx TEG timing error margin value for all the UE RxTx TEGs within one NR-Multi-RTT-SignalMeasurementInformation. If the IE NR-UE-RxTx-TEG-Info is present with choice case1 or case2 and this field is absent, the receiver should consider the UE RxTx TEG timing error margin value to be the maximum applicable value as defined in TS 38.133 [46].","paragraph_zero_based":2009},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":2010},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resources ID to uniquely identify a DL-PRS Resource. This ID can be associated with multiple DL-PRS Resource Sets associated with a single TRP.","paragraph_zero_based":2011},{"literal_text_all_w_t_and_m_t":"Each TRP should only be associated with one such ID.","paragraph_zero_based":2012},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":2013},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":2014},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":2015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["31c92d6e6f65b31a9f3e2b74d13647c448cbabb227f4a1788b188efb67f478d1","5f661def08e93c2de32541945b6772bad945963d1415e1eda54cbeb93454b5cc","82ccfef1a24b594196631b8d17f821f893af187ee3e0ae78a7172b90b973a791","e30026a40cc9026d5617b7dc7b658f00085d6c77c53924c15bb663dca7114231","9b736a814b4679c96cc6ce3e80d0cb5dbe507ed2d31eff8026d5f2225d637abb","9be23f15a2c0390eddf5b05d39c80ede16ee4d622a52412df5275979224906e5","24349f27f113db7041385bde5b06cfbbd80d3a5970ffb6cbce52d46768113e64","52d01f5d11864b526c6238013cf5f39282ea9e19ed25480cf89e1442db79b60d","b4119a30979435f5618b7abeb105307a48c6f822c51b123cf9108ec4c8ab454a","daff18aeef6fa3f3346836480fea5b559adb8e55f44209f170b6b98bfbc82735","1ee387e982b6693e35d2bc40fce78a5a6a969bc5a28c9ecac6170283a2a0b489","4a76d91a1b4f06fb5b7bdf39dc8e0b4f4be06443ce89827d9ed1e7dc3e02134c","4d45f6d58566cfb078e03a77137c3dde2046e520177326c18bf9cca07d67d5c9","2c9eb12c0b78503770acb09ed58192015e58400f185094648d15fceb079c2f70","ba097ee304a5f8fb815948e6eade93458e364c3c8a8ec0ee707e68b375e81561","027a526ee3e3437a32dea638e42825803d3c52dc83c909b748bf34777020b067","ceda6260e33a8bb8faf7a09c52c0eabece7956f39fc3abca00575879fcf28ec9","70c929f4729b6e1d121525fc445226ffb76aece602a6882021128b66f5ef0256","c7e7483b54c4ea3506f3872c84195bb9410acdb995896b097f9646f301571474","1aead8d32627302080ecb14c56343fd33592f34f1c5ebcb3b861b055fed81111","b77635e4589521fa20ca01f755be2b8533a36e247d14d54ffa68f8bd74254b07","d8f57a1c932167003cc2edafcfb753a5e1fca1f06041a97939a5e7a5e7dfd4d2","bd895802cb78fd3be3276a3d545e5310982dfe378bd3479270b043de65dc1fc1","f624de66330708d36cdaefc644f6c80216f0fc56d0689defb402bb4ae13c9f6a"],"paragraph_range_zero_based":[1992,2015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1992"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":2016},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":2017},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":2018},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTimeDiff","paragraph_zero_based":2019},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Rx–Tx time difference measurement, as defined in TS 38.215 [36]. ","paragraph_zero_based":2020},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathList","paragraph_zero_based":2021},{"literal_text_all_w_t_and_m_t":"This field specifies one or more additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-UE-RxTxTimeDiff value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathListExt shall be absent.","paragraph_zero_based":2022},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":2023},{"literal_text_all_w_t_and_m_t":"This field specifies the time instance for which the measurement is performed.","paragraph_zero_based":2024},{"literal_text_all_w_t_and_m_t":"nr-TimingQuality","paragraph_zero_based":2025},{"literal_text_all_w_t_and_m_t":"This field specifies the target device′s best estimate of the quality of the measurement.","paragraph_zero_based":2026},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-Result","paragraph_zero_based":2027},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-PRS reference signal received power (DL PRS-RSRP) measurement, as defined in TS 38.215 [36]. The mapping of the quantity is defined as in TS 38.133 [46].","paragraph_zero_based":2028},{"literal_text_all_w_t_and_m_t":"nr-Multi-RTT-AdditionalMeasurements","paragraph_zero_based":2029},{"literal_text_all_w_t_and_m_t":"This field provides up to 3 additional UE Rx-Tx time difference measurements corresponding to a single configured SRS Resource or Resource Set for positioning. Each measurement corresponds to a single received DL-PRS Resource or DL-PRS Resource Set [45].","paragraph_zero_based":2030},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-Multi-RTT-AdditionalMeasurementsExt shall be absent.","paragraph_zero_based":2031},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTx-TEG-Info","paragraph_zero_based":2032},{"literal_text_all_w_t_and_m_t":"This field provides the ID(s) of the UE TEG associated with the nr-UE-RxTxTimeDiff or nr-UE-RxTxTimeDiffAdditional measurement. One of the following combinations of TEG IDs can be provided:","paragraph_zero_based":2033},{"literal_text_all_w_t_and_m_t":"-case1 provides the UE RxTx TEG ID;","paragraph_zero_based":2034},{"literal_text_all_w_t_and_m_t":"-case2 provides the UE RxTx TEG ID together with the UE Tx TEG ID. The nr-UE-Tx-TEG-Index provides the index to the nr-SRS-TxTEG-Set field for the applicable UE Tx TEG ID, where value '1' indicates the first NR-SRS-TxTEG-Element in nr-SRS-TxTEG-Set, value '2' indicates the second NR-SRS-TxTEG-Element in nr-SRS-TxTEG-Set, and so on;","paragraph_zero_based":2035},{"literal_text_all_w_t_and_m_t":"-case3 provides the UE Rx TEG ID together with the UE Tx TEG ID. The nr-UE-Tx-TEG-Index provides the index to the nr-SRS-TxTEG-Set field for the applicable UE Tx TEG ID, where value '1' indicates the first NR-SRS-TxTEG-Element in nr-SRS-TxTEG-Set, value '2' indicates the second NR-SRS-TxTEG-Element in nr-SRS-TxTEG-Set, and so on.","paragraph_zero_based":2036},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-Result","paragraph_zero_based":2037},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time, as defined in TS 38.215 [36]. The mapping of the measured quantity is defined as in TS 38.133 [46].","paragraph_zero_based":2038},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-Indicator","paragraph_zero_based":2039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["08730f188ec4e05009603a5978545e1ddc92d05fd01898b4557f61330dc91a35","d5c2b971afaed0b044ebf0c8b98b2924ed7b3097cda6248056ed0a3942b6e675","ac6a8a2ddfc1ab2d4bf0eb79e62bbc4f4eb5d14b553763b20787900c027f3404","49d8b56d9cd13e105655c81dc70956038cee68e5a0a7f0886e3dd952a23b6b62","95c94b1d4fa999a7326228738afea253046cd083ff6c5c473be6d7d2b0f67f8a","f834f0adc86ac3e40195b834758a59ace47cc2ad42fdfc250f3c7e2008189e2e","2a655ebe002253e1cc1ad5b18011607d9af13c008f73974ac3d7ce77554cf8de","1ff67349af06e283fc80cff2148eeb9bc8fbcdeaaece245a881968840b56c16b","b866db23c617bd9e78a55b439f00010e99b03f035a98f23664026a62d7632943","90e87d86a8ca3a3a29c9d0f0830450850ee9cbbd79fad60187f2278436c1ae5f","0a146f9cdd02177341e963c103bfdeab2f7fca77b58a2566bd61bd630f47e18e","867c7a9ca07672e5c468520a473618f79c1c306b030e72938588d6344a2ec0d8","761a3db7cf447948856d79e516509cb19c7ec384a7bd314a9b261fd5f97dc0bb","ba0332c164161c9076a941b9ebe0df17fdce1658bf30215febc095f152b71aad","b7d0f19514e0acd765eb08eaf3b456f01a69bafe4d3bf017837b94df2b309e19","3b9feaeaaf2e3f06fcb44df40f4515484082a0a3e2ac16370101a93d6e8c45b2","3028e157b8104696f42d76a45d7cdc60e9c0cf77d5dd9dbbdada681ca9b59ddd","532adacf23830c4cbb33183406291f22c2feb8cacded9a41328c2ff2288cb3f5","4f0296d4ac6e4d79be17208d15cbeb69fdec9bfac2ad7365be4a8c4444d74696","792b8121562e005559fc5aff3416a194927cea78643478bc6ebfe9c39cf00c9f","8ac9d06e53ce5ac005acc2d34f97df4a24df3101eac9ea30ae2fde674fe81669","d1542136d6c5a26728ee6259f80597aae17311d71646d0b13d1e894708e51c29","d242f023679ec1f455c1c1b338655cf9eb862c644a6135b41b9a67e00bcec527","6e9fb850fcd111b84782df3065accdb5fa4ccdbf7e27316e76fe8d2b1ff74d07"],"paragraph_range_zero_based":[2016,2039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p2016"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the UE Rx-Tx Time Difference, RSRP or RSRPP of first path measurement for the TRP or resource.","paragraph_zero_based":2040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2041},{"literal_text_all_w_t_and_m_t":"NOTE:If the requested type or granularity in nr-los-nlos-IndicatorRequest is not possible, the target device may provide a different type and granularity for the estimated LOS-NLOS-Indicator.","paragraph_zero_based":2042},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathListExt","paragraph_zero_based":2043},{"literal_text_all_w_t_and_m_t":"This field provides up to 8 additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-UE-RxTxTimeDiff value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathList shall be absent.","paragraph_zero_based":2044},{"literal_text_all_w_t_and_m_t":"nr-Multi-RTT-AdditionalMeasurementsExt","paragraph_zero_based":2045},{"literal_text_all_w_t_and_m_t":"This field, in addition to the measurements provided in NR-Multi-RTT-MeasElement, provides UE Rx-Tx time difference measurements of up to 4 DL-PRS Resources of a TRP with different UE RxTx or UE Rx TEGs. For a certain DL-PRS Resource, there can be up to 8 measurement results with respect to different UE RxTx or UE Rx TEGs. If this field is present, the field nr-Multi-RTT-AdditionalMeasurements shall be absent.","paragraph_zero_based":2046},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-ResultDiff","paragraph_zero_based":2047},{"literal_text_all_w_t_and_m_t":"This field provides the additional DL-PRS RSRP measurement result relative to nr-DL-PRS-RSRP-Result. The DL-PRS RSRP value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-RSRP-Result. The mapping of this field is defined as in TS 38.133 [46].","paragraph_zero_based":2048},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTimeDiffAdditional","paragraph_zero_based":2049},{"literal_text_all_w_t_and_m_t":"This field provides the additional UE Rx-Tx Difference measurement result relative to nr-UE-RxTxTimeDiff. The UE Rx-Tx Difference value of this measurement is obtained by adding the value of this field to the value of the nr-UE-RxTxTimeDiff field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":2050},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-ResultDiff","paragraph_zero_based":2051},{"literal_text_all_w_t_and_m_t":"This field specifies the additional NR DL-PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time relative to nr-DL-PRS-FirstPathRSRP-Result. The DL-PRS RSRPP of first path value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-FirstPathRSRP-Result field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":2052},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorPerResource","paragraph_zero_based":2053},{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the UE Rx-Tx Time Difference, RSRP or RSRPP of first path measurement for the resource.","paragraph_zero_based":2054},{"literal_text_all_w_t_and_m_t":"This field may only be present if the field nr-LOS-NLOS-Indicator choice indicates perResource.","paragraph_zero_based":2055},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2056}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["6b3ee0f6b6075aaf2502ccc31afd38d80c4ebc2e0a6a26c85bc426a24b248c03","15aaa038375d9f7062615a0ded04436a6c38b509784db484bd5cf672df75463f","5b6fc350c3b88a5e2b08fb54b72fcd4f146e802345bfb344fc4ed981a63a13b6","c247cc70facd1413ab57dbb611d2b33f22c2943d718db3ea1ec5ed7f1d608504","64f624f8cdf92afa99e2484c0e390bdc3893c63445f7a291227813c78a344d21","ba8945c64168f1b5863cadad98c4bd15abb41245d73961eebb345b3f07655af8","6d6919cc40a0b4e695df453194442ca9e6daea25bf657e0668c82ac5d6c7e966","e98c621303bfb936634aa18a8d08da4abf385c0bc30e8dfe6b406c381a956a61","b8844a82a81fa57a8afb8c18b179a3f61c7ec742d5e5136498b54fea22b95569","1ced39103732d66272aab1b8b877cb761e296034fa60e4bd64333dc373633c67","5e59ce0434ca9593ee96a71f4c871e453d99ab67636da7b3c3213509b2428a83","a6bb9d8e6a2304b265f5eb4ea7b8f88eed0252ea071d6b85435c7de546b2ade2","d1a734c70637d2d2663d43e2ecf63ad8fdb1a26ec8ae95634f824acc0113ff01","24a9b3f83f943104856d72a7b925691f4e4992464e7e01b3cf81ea33ed2687a9","d0c588b13bc4873e0edfd53cb9384a33798805dc8cb9061faf1c476aad75b2d8","13c0f4cc3df86a14e0224fcad8d35f900dc8460fc881618974a0340f4f37196b","7b352e06139bfb76696ce96f627597822ff3a20eff14a33744af032d8727544e"],"paragraph_range_zero_based":[2040,2056],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p2040"}
