{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27553},{"literal_text_all_w_t_and_m_t":"–ServingCellConfig","paragraph_zero_based":27554},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfig is used to configure (add or modify) the UE with a serving cell, which may be the SpCell or an SCell of an MCG or SCG. The parameters herein are mostly UE specific but partly also cell specific (e.g. in additionally configured bandwidth parts). Reconfiguration between a PUCCH and PUCCHless SCell is only supported using an SCell release and add.","paragraph_zero_based":27555},{"literal_text_all_w_t_and_m_t":"ServingCellConfig information element","paragraph_zero_based":27556},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27557},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-START","paragraph_zero_based":27558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27559},{"literal_text_all_w_t_and_m_t":"ServingCellConfig ::=               SEQUENCE {","paragraph_zero_based":27560},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationDedicated    TDD-UL-DL-ConfigDedicated                                                OPTIONAL,   -- Cond TDD","paragraph_zero_based":27561},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP                  BWP-DownlinkDedicated                                                    OPTIONAL,   -- Need M","paragraph_zero_based":27562},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToReleaseList           SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Id                               OPTIONAL,   -- Need N","paragraph_zero_based":27563},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToAddModList            SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Downlink                         OPTIONAL,   -- Need N","paragraph_zero_based":27564},{"literal_text_all_w_t_and_m_t":"    firstActiveDownlinkBWP-Id           BWP-Id                                                                   OPTIONAL,   -- Cond SyncAndCellAdd","paragraph_zero_based":27565},{"literal_text_all_w_t_and_m_t":"    bwp-InactivityTimer                 ENUMERATED {ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30,","paragraph_zero_based":27566},{"literal_text_all_w_t_and_m_t":"                                                    ms40,ms50, ms60, ms80,ms100, ms200,ms300, ms500,","paragraph_zero_based":27567},{"literal_text_all_w_t_and_m_t":"                                                    ms750, ms1280, ms1920, ms2560, spare10, spare9, spare8,","paragraph_zero_based":27568},{"literal_text_all_w_t_and_m_t":"                                                    spare7, spare6, spare5, spare4, spare3, spare2, spare1 }    OPTIONAL,   --Need R","paragraph_zero_based":27569},{"literal_text_all_w_t_and_m_t":"    defaultDownlinkBWP-Id               BWP-Id                                                                  OPTIONAL,   -- Need S","paragraph_zero_based":27570},{"literal_text_all_w_t_and_m_t":"    uplinkConfig                        UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":27571},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":27572},{"literal_text_all_w_t_and_m_t":"    pdcch-ServingCellConfig             SetupRelease { PDCCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27573},{"literal_text_all_w_t_and_m_t":"    pdsch-ServingCellConfig             SetupRelease { PDSCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27574},{"literal_text_all_w_t_and_m_t":"    csi-MeasConfig                      SetupRelease { CSI-MeasConfig }                                         OPTIONAL,   -- Need M","paragraph_zero_based":27575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4940d150916fd87fb448e7cf40781600b360549df0032ec1b8732841612d8471","f0961c65da579e359ae3658eb6efbc3247bd87c7c86743e5fafe39209b092a08","d8687a4f90361b4efc38e3f8b57c0b320780a9cef673865f515752c698a278e6","7985b8797f22829e67511a114496850f2ce57babc0d59d683d91e8af2f7eca29","a97f99033c8dd0b97cde91c6129747f234b85b1c100e1b22ffed2d8c89898bca","0166c1367b5532aeaae6346c181be9aa9b84f1efb0552252dbcce27b8bc8b8af","2f17471a47cbdec48a066637c8921e0bd8b7c8a63fed6d6a840124bfc122a335","71ab955758146bc41c171fd1c29fa0650db190d5624774147ebe6d0b2c2945ab","1f9a82c37fe6ea5d51cbf96336582256d2d419b7046de3ff8ca16d6be7a5bf9b","3bb0980c7a0cd5eb59436cebfb0693038d0b036e7d4b1c245cbf0e785d988278","aa4623cd857166c6f63908d0cf980eb3b5bf0eefd01ea035cd449bb4a2ca7a27","2f1a17a055e8eee44d9ef6b7fb91de7ec3f413afa0a4149a26ddec7004026a45","b708d026baecb68e5bb8e4fd920aaa5d714ffbc23f7dd9843dbf672680062d25","c51e8148bab94b06482f42b600f77b12506a98fed652ff89dab57cf624ea8653","586202d8b374a6f08dd62c37cc27411fef0a62bcc67e3e2103fbd7f7b1eb7393","849e15a3bc4a337916e935e6c8d0a262896d4d4f3c593530d6b75baf033186e1","edcf13120c0e75fead8ac863936611c313d0efea9e2903e7585bf065712a013d","622960ea0629f2d210fa3eb0aafb234790e87d3bbc6ff4251f49e01079e3384d","01392e7e75a5036da529c41e4a630103ff7f111b8cfad5d1a9e9238dd7d2161f","86858c1b1153ce68dc189f0067d02623e6fab634b486a9e0437e0f6ccbff122b","58810fceedea24a0cbd83709f11b557cd4de4d386035c1d71eae1a089ebc4b7f","8d880783ab9d4e4655fdfc49307ed8ce5764f502e426ce096377a35d