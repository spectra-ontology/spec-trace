{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqCommRelayInfo field descriptions","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"sl-RelayDRXConfig","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the applied sidelink DRX configuration for the relay related communication.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityL2U2N","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for the established PC5 link for relay by L2 U2N Relay UE.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"sl-LocalID-Request","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"This field is used to request local UE ID for the corresponding destination by the L2 U2N Relay UE.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListL2U2N","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication for established PC5 link for relay. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"sl-PagingIdentityRemoteUE","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the paging UE ID(s) for the corresponding destination(s) by the L2 U2N Relay UE.","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"<text omitted>","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"END OF THE CHANGE","paragraph_zero_based":327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"86fada5ff07263f82a7ae2684ffc6687b5dedba803d73277e43f49470661bd2e","original_member_sha256":"55341d84f1383c55565e46179ecc3fb961a2efa6d1be571bfc13d4a345f73303","paragraph_ElementTree_utf8_XML_sha256":["2dd9612720c74cf79be67d55a4e2ecb7fde925f6204b0c4b19089d4b033f7742","67fd29de98f28e0eeff13535f1f996195bb4fafb700c0889bea80d9ade8fe5fb","2b8b30c6454ebc461587d9cd48d2e96b925d754ab16fc2632cdbc55756e458ea","719d3a04cfdb4c9d23b93f6e5af3e051019f9c6b47aad108408267eea0b651d4","abd5690f0bf9acfdb1d6d19681b0cd9b3a9f1b7f6c87b350baa790b8a9bc836d","177f6672b7c2775fa57242ee55112afa3550ea5a8f1913f452c7ba02706dc22b","7e40d871cb90381faa1a4229ccccc0bb2f361ad9bf52bc6d4517fcfba664b037","7c87066d2b7b0a51afff815f6e143caca145d5996455640697b37c82fb4b9fd0","4076063b44b25eaf936365c76092679894488b7528343afde40b002fd48830b2","d46b9fe0abcc8d62b9d68bb3d93298540d8ffe57b6a982c1dc9a7eac86e2f040","d7a9a7c9cbdda0d7e1f4cb3d7354e096f3fa9123cad56ec60f05723ea1475588","14fb446e3360b8121d9c4dabc6bde25577295a7d8139d8fbce7b0dd079486e51","6f82407da4470b2d42c35510df32ed3a8692e83f4cc75ad19e7ab993732e973d","5854550f3a24c322b5552948d2ffa1df0710674a1870bf310ab0ff7f6943e666","7d81cc60a6432b106d7385b457960c3dc83b5034f5149677ce012fdd02cd3ef7","3fc0997c0e0902d5fddff70be31212b919f6a5977c10f16d39311a662a49cca7"],"paragraph_range_zero_based":[312,327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row"