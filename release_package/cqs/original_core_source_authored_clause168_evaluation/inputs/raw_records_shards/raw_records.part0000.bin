{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":17976},{"literal_text_all_w_t_and_m_t":"        dmrs-UplinkTransformPrecoding-r16   SetupRelease {DMRS-UplinkTransformPrecoding-r16}                OPTIONAL    -- Need M","paragraph_zero_based":17977},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":17978},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":17979},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17980},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17982},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkTransformPrecoding-r16  ::=  SEQUENCE {","paragraph_zero_based":17983},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID0                   INTEGER(0..65535)                                               OPTIONAL,   -- Need S","paragraph_zero_based":17984},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID1                   INTEGER(0..65535)                                               OPTIONAL    -- Need S","paragraph_zero_based":17985},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17987},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-STOP","paragraph_zero_based":17988},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17989},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17990},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig field descriptions","paragraph_zero_based":17991},{"literal_text_all_w_t_and_m_t":"dmrs-AdditionalPosition","paragraph_zero_based":17992},{"literal_text_all_w_t_and_m_t":"Position for additional DM-RS in UL (see TS 38.211 [16], clause 6.4.1.1.3). If the field is absent, the UE applies the value pos2. See also clause 6.4.1.1.3 for additional constraints on how the network may set this field depending on the setting of other fields.","paragraph_zero_based":17993},{"literal_text_all_w_t_and_m_t":"dmrs-Type","paragraph_zero_based":17994},{"literal_text_all_w_t_and_m_t":"Selection of the DMRS type to be used for UL (see TS 38.211 [16], clause 6.4.1.1.3) If the field is absent, the UE uses DMRS type 1.","paragraph_zero_based":17995},{"literal_text_all_w_t_and_m_t":"dmrs-Uplink","paragraph_zero_based":17996},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used, as specified in TS38.211 [16], clause 6.4.1.1.1.1.","paragraph_zero_based":17997},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecoding","paragraph_zero_based":17998},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used for PUSCH with pi/2 BPSK modulation, as specified in TS38.211 [16], clause 6.4.1.1.1.2. The network configures this field only if tp-pi2BPSK is configured in PUSCH-Config.","paragraph_zero_based":17999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4cca91cef44030b10b885bc94e2559885fddc5a8464f3f85d7955650f9da4344","7dd56edf3ee56e31f5ba882db60f94fd66fbd185f1f84f01b1e0e4667fbc4b2e","60e6eac710e7a54861f0624f494875389139b57389c4ac7bb458d326a3f3bc2c","52fee41c267695610886c245f60d0d7f860826507c70a0049a67e4a96c563ab2","2c52fd11cbb16174b30cb5eb8ba2b1bf7724cc95611f90dc3b22c0bf1fef815e","e54e1b84316fa27e6aba66cd289f7454caa01bd1012f7d5e752d947894a6ae82","1ff3bca2facee3216776958c568c8a428b21b27ec2e756ed1e12bea981a061f7","937c2120be79d11c6b9dc62e4c3dd641b2ca088cfdfda04a3f698822a18aa1c2","500a836b07da844ebf18a046b769c93632b6f4e419aeb7bd5a6b30578951d779","e689e15ccbe5a1ef5c420270906f0307abeebb193949ab474004aefdb177250b","a704eaf9e9042cb08c71998ef57795d98c6ee2b2f4ce3f01b21dc77d11c23ff9","e90fda74f2e7df8f2083ce7b57f76c5ef9fe63e73f2d63cd82b90ebd87bb4df5","c2eea7f48b0b2c36c51af35f0a1d6e1a8fae117edd1dd23883a2c1ef60cf708e","8a680137882640a04d202d021b633925c6b3293f3be1ab91cd1617e286a98b29","393cee80aba8535bc5e855ea87874eaff42015260c377034c0303cad5005347a","988b14e050ba058812e18b49dc320068a829fe21af84900c618dd3fd98b82c95","b285970dc1f45c952099e2ff0523198df03d203531ca1f5b2b0cca0394a107cb","6c449ed658460f96cc40a9db0f47cecf464248ce7b25706f81d374bcfa6d5d71","58e88d5e5479786e830183c293da85f4f0aa7e49ddec2de4d8deaad715d0c9f3","143f0da450450cd39e044dc9e59960cc0ef58ee1f15114a1d2378d1b780bf8b5","cd706726920264aba9d01f94d92c98b11fbe11dfe9893ed307d5035d5ebfb011","773ce8ec355313650bfe7f9c6c27082be7e51bfada903a0e18c5a180fb855dee","ceb337e90a2b9995fc2eb523a4ee687de774473337a99d8c867d3caa6af08f49","26b9413abf99d3e6ad117aa4ff89054d454514190eb3b9c90e05294234e8b35f"],"paragraph_range_zero_based":[17976,17999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p17976"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxLength","paragraph_zero_based":18000},{"literal_text_all_w_t_and_m_t":"The maximum number of OFDM symbols for UL front loaded DMRS. len1 corresponds to value 1. len2 corresponds to value 2. If the field is absent, the UE applies value len1. If set to len2, the UE determines the actual number of DM-RS symbols by the associated DCI. (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":18001},{"literal_text_all_w_t_and_m_t":"nPUSCH-Identity","paragraph_zero_based":18002},{"literal_text_all_w_t_and_m_t":"Parameter: N_ID^(PUSCH) for DFT-s-OFDM DMRS. If the value is absent or released, the UE uses the value Physical cell ID (physCellId). See TS 38.211 [16].","paragraph_zero_based":18003},{"literal_text_all_w_t_and_m_t":"phaseTrackingRS","paragraph_zero_based":18004},{"literal_text_all_w_t_and_m_t":"Configures uplink PTRS (see TS 38.211 [16]).","paragraph_zero_based":18005},{"literal_text_all_w_t_and_m_t":"pi2BPSK-ScramblingID0, pi2BPSK-ScramblingID1","paragraph_zero_based":18006},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for pi/2 BPSK DMRS for PUSCH (see TS 38.211 [16], Clause 6.4.1.1.2). When the field is absent the UE applies the value Physical cell ID (physCellId) of the serving cell.","paragraph_zero_based":18007},{"literal_text_all_w_t_and_m_t":"scramblingID0","paragraph_zero_based":18008},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":18009},{"literal_text_all_w_t_and_m_t":"scramblingID1","paragraph_zero_based":18010},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":18011},{"literal_text_all_w_t_and_m_t":"sequenceGroupHopping","paragraph_zero_based":18012},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder the NW may configure group hopping by the cell-specific parameter groupHoppingEnabledTransformPrecoding in PUSCH-ConfigCommon. In this case, the NW may include this UE specific field to disable group hopping for PUSCH transmission except for Msg3, i.e., to override the configuration in PUSCH-ConfigCommon (see TS 38.211 [16]). If the field is absent, the UE uses the same hopping mode as for Msg3.","paragraph_zero_based":18013},{"literal_text_all_w_t_and_m_t":"sequenceHopping","paragraph_zero_based":18014},{"literal_text_all_w_t_and_m_t":"Determines if sequence hopping is enabled for DMRS transmission with transform precoder for PUSCH transmission other than Msg3 (sequence hopping is always disabled for Msg3). If the field is absent, the UE uses the same hopping mode as for msg3. The network does not configure simultaneous group hopping and sequence hopping. See TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":18015},{"literal_text_all_w_t_and_m_t":"transformPrecodingDisabled","paragraph_zero_based":18016},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for Cyclic Prefix OFDM.","paragraph_zero_based":18017},{"literal_text_all_w_t_and_m_t":"transformPrecodingEnabled","paragraph_zero_based":18018},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for DFT-s-OFDM (Transform Precoding).","paragraph_zero_based":18019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18020},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommon","paragraph_zero_based":18021},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommon provides common downlink parameters of a cell.","paragraph_zero_based":18022},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon information element","paragraph_zero_based":18023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1df8fc779de7e964752d26d7f67222276b731b8b1ab32f83590f4e98a714c645","da8c90cb27368ff363f85f187e86d1de906b71706a0e31c93b9fb75577b11ed6","135dda1af749a878939a8f0744dc744d4501b51e17d91ae3f2417a9865013bbf","33801ecf17ab333ae278e4bb48633c28d37198fd5f32b997dcb9209f7b275150","de666bc1627e64d25f35fa5a8d3ab095afb88b9b6e048bc65bfc5b7d1f6d8f07","a6e3a5b0bc07da7f7ac7ad266843acf2aa4b2e11118a069ff64376f008e5e135","6c1e5e8163eb1455bb53d0ccec808c117de5c0a8cba7ba04f3857155101b234d","cbe110a9f03da719c698e3b665782c65e154cc2a4bd90d802b5c4813bd426a4b","b0b7c57a2dc380a2934734ca943aac83bdd57d86ba620bfb14aa6aca5edd829e","704348ff96f4494c9f7015fbb2af68211e1e584f315cba09d227819bd05e57fd","eab65fec8665974c839ac5c944838de6335c81bc6542bbd12a647346b7436a86","ccb21c5e2386a687b6ec7c60a521a593cec98debd1f6e9bfaa35fd29417c0ed6","03f9848a62aadf1c8cb27edd4cd9c531efe16d3f5f4763b2213fccbf3e13f02b","c4c5834a123eadf1ecc4f6222c924e40543d606def2ad935f56586362e06bd0c","edae5406a65e24db634e4318c9cf7af7f183941100316ec20b0cf9f9ea9d4e4f","e523a171a1a229f522fd3d1991bd2aa0c4d8810c98cedfbeee63c4c6a3c891b7","2ea00dedee7727f43894465c9e390e23f0daa0494ed0cdebd9b0c6979c21bdb2","dda4772216c10671c858d301c880e507de4b86db3f8ca68f25247a76af5da789","c3bf8b5a3f8416348622625de500424fbdabe72897d0a9b70f6857d23b3987de","f658f3b30e96791e615e12e4f5a3234bb3327e0aa4ea6bde10ff71f5a2251260","02f640573f33a91c40225b8bbcc9567c4b96ba306b14ce06ef7f596bd84e867c","2fe4110a900d8a0af71011d9df99ece5e51408d20083c7076807b8ff295049e7","6992b7eed00fca1ff5d4b56ae25a8481e1db8790dde2e91441cbf667740ae140","bba36f46979f3acb13b8e85d270e7d7e7215ce58b0295c7841c596c22b3c5b9d"],"paragraph_range_zero_based":[18000,18023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18000"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18024},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-START","paragraph_zero_based":18025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18026},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon ::=        SEQUENCE {","paragraph_zero_based":18027},{"literal_text_all_w_t_and_m_t":"    frequencyInfoDL                 FrequencyInfoDL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":18028},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP              BWP-DownlinkCommon                              OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":18029},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18030},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18031},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP-RedCap-r17   BWP-DownlinkCommon                              OPTIONAL    -- Need R","paragraph_zero_based":18032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18033},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18034},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18036},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-STOP","paragraph_zero_based":18037},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18038},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18039},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon field descriptions","paragraph_zero_based":18040},{"literal_text_all_w_t_and_m_t":"frequencyInfoDL","paragraph_zero_based":18041},{"literal_text_all_w_t_and_m_t":"Basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18042},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":18043},{"literal_text_all_w_t_and_m_t":"The initial downlink BWP configuration for a serving cell. The network configures the locationAndBandwidth so that the initial downlink BWP contains the entire CORESET#0 of this serving cell in the frequency domain.","paragraph_zero_based":18044},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP-RedCap","paragraph_zero_based":18045},{"literal_text_all_w_t_and_m_t":"If present, RedCap UEs use this DL BWP instead of initialDownlinkBWP.","paragraph_zero_based":18046},{"literal_text_all_w_t_and_m_t":"If absent, RedCap UEs use initialDownlinkBWP provided that it does not exceed the RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":18047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9a56f4b239b8b57d870ef8354075e8bcfe2d6526557754e6653d9afe4334a1f2","35d3ea1beed10ba31c50bd8aab2f7fd9e9c82d531dfd9b9094ca6e2ea16fdc86","2a2649e0c48b5294c2ee38d16bb448581a833852be02cd19be50f45c0710578c","7bb2386d5d4d01876f43dbaa3928a0f930f6cd700bbe93d57678d67e3cbdaef2","ab50d68abf9cf2f125ead2451b794a38e8f90c7717a3e87cd58cec7a73ed5bef","b570ac4091723dde327279084b7fbac5613bcbd1ac39cc720348d52fb50a7257","af34b047d94a56522c17ccfefd4b570693ec14f4186f64861f09f8ffb0d01116","9fccd998df27d37dbab27925d6493a44ede54f4ed3d809710d232ff5317df268","7163bd66493c52c692fa67064b7dae68f10d68733639d6d805489798d91f0e21","0f9174b71553c0da88abede84e221f8f91f37735d9f6b5fff3c535eb2e4719b8","ece444bd4bf25731aa75b5dd661c78279e5bb1c516c87d7020bb9bcb6d9152f3","ef0bb0e495e012f96988e4ddd828fe524a4609808ee3d879892e20b33c8cdd08","7215284e9f4387dfb361d9