etation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14736"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS. If the field is absent, the UE uses the preamble index associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":14760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14761},{"literal_text_all_w_t_and_m_t":"BFR-SSB-Resource field descriptions","paragraph_zero_based":14762},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":14763},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing BFR upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":14764},{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":14765},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell. It determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":14766},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14767},{"literal_text_all_w_t_and_m_t":"–BeamFailureRecoveryRSConfig","paragraph_zero_based":14768},{"literal_text_all_w_t_and_m_t":"The IE BeamFailureRecoveryRSConfig is used to configure the UE with candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":14769},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig information element","paragraph_zero_based":14770},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14771},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYRSCONFIG-START","paragraph_zero_based":14772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14773},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig-r16 ::= SEQUENCE {","paragraph_zero_based":14774},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdBFR-r16               RSRP-Range                                                               OPTIONAL, -- Need M","paragraph_zero_based":14775},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List-r16            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL, -- Need M","paragraph_zero_based":14776},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":14777},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":14778},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List2-r17            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL  -- Need R","paragraph_zero_based":14779},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":14780},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14782},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYRSCONFIG-STOP","paragraph_zero_based":14783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1a916ddcb76b04485da4f75cd3d33fb15d67ec6fd85c5f1838dda3d418d19f5d","7744c0ae62ef8f3f290b6922f8f3e77348110754d6c0c978794a075df7dd35bc","f8088f82c87f30b24a64a7b1d8da3c345ba674caf95e70abfa6399a1ca985e26","e9f447be4b7bc5b8b715a68e422faa803432239f90bd860c15bc578b3872f7eb","11259ca44504d774ad97a44ccff014031278f9230c4faa51af78333f78295120","1e8bd145be7d2925dd1024551fa9d67b92782ef528e0656275c96eafaab8204b","5fa155a40a8f95703fb11e841be9a48bdc4dfce666e0ad90f30d52b4c3e5cbc5","2c52b126a4d5e719825bdbad14058a7277b22c9aa1939544d10a7ff4ddd326ee","a1282f6c5327f1eec8f9ad5d8905c1631c1c4571cbd61f2821716d58da6f4287","df7cb813933d0c702494