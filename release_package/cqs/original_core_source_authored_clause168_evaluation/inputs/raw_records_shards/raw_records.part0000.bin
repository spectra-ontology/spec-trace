{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4464},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4465},{"literal_text_all_w_t_and_m_t":"1>else if gapUE is set to release:","paragraph_zero_based":4466},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap configuration configured by gapUE.","paragraph_zero_based":4467},{"literal_text_all_w_t_and_m_t":"1>for each measGapId included in the received gapToReleaseList:","paragraph_zero_based":4468},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measGapId;","paragraph_zero_based":4469},{"literal_text_all_w_t_and_m_t":"1>for each measPosPreConfigGapId included in the received posMeasGapPreConfigToReleaseList:","paragraph_zero_based":4470},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measPosPreConfigGapId;","paragraph_zero_based":4471},{"literal_text_all_w_t_and_m_t":"1>for each GapConfig received in gapToAddModList:","paragraph_zero_based":4472},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the GapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4473},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4474},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":4475},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":4476},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":4477},{"literal_text_all_w_t_and_m_t":"2>apply the measurement gap as per UE measurement gap, FR1 measurement gap, or FR2 measurement gap according to the gapType indicated by the GapConfig;","paragraph_zero_based":4478},{"literal_text_all_w_t_and_m_t":"2>associate the measurement gap with the measGapId indicated by the GapConfig;","paragraph_zero_based":4479},{"literal_text_all_w_t_and_m_t":"2>if gapSharing in the GapConfig is present:","paragraph_zero_based":4480},{"literal_text_all_w_t_and_m_t":"3>setup the gap sharing configuration for the measurement gap in accordance with the received gapSharing as defined in TS 38.133 [14];","paragraph_zero_based":4481},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4482},{"literal_text_all_w_t_and_m_t":"3>release the gap sharing configuration (if configured) for the measurement gap;","paragraph_zero_based":4483},{"literal_text_all_w_t_and_m_t":"1>for each PosGapConfig received in PosMeasGapPreConfigToAddModList:","paragraph_zero_based":4484},{"literal_text_all_w_t_and_m_t":"2>if a measurement gap configuration associated with the measPosPreConfigGapId indicated by the PosGapConfig is already setup:","paragraph_zero_based":4485},{"literal_text_all_w_t_and_m_t":"3>release the measurement gap configuration;","paragraph_zero_based":4486},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the PosGapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f