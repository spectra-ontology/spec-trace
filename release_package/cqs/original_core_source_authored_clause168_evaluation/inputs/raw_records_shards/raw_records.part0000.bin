{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In 7.1.1, new timer T4xx is added for indirect path addition/change.","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"Multi-path is not supported.","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"3.1, 3.2, 4.2.2, 4.4, 5.3.3.1a, 5.3.5.2, 5.3.5.3, 5.3.5.5.12, 5.3.5.5.13, 5.3.5.xx (new), 5.3.7.2, 5.3.8.3, 5.3.13.1a, 5.7.3b.2, 5.7.3c (new), 5.7.4.1, 5.7.4.2, 5.7.4.3, 5.8.9.8.2, 5.8.9.8.3, 5.8.9.10.4, 6.2.1, 6.2.2, 6.3.2, 6.3.4, 6.6.2, 7.1.1","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"TS 38.321 CRxxxx","paragraph_zero_based":