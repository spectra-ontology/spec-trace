{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>set rsrpResult-EUTRA to the RSRP of the EUTRA PSCell;","paragraph_zero_based":5592},{"literal_text_all_w_t_and_m_t":"1>if average uplink PDCP delay values are available:","paragraph_zero_based":5593},{"literal_text_all_w_t_and_m_t":"2>set the ul-PDCP-DelayValueResultList to include the corresponding average uplink PDCP delay values;","paragraph_zero_based":5594},{"literal_text_all_w_t_and_m_t":"1>if PDCP excess delay measurements are available:","paragraph_zero_based":5595},{"literal_text_all_w_t_and_m_t":"2>set the ul-PDCP-ExcessDelayResultList to include the corresponding PDCP excess delay measurements;","paragraph_zero_based":5596},{"literal_text_all_w_t_and_m_t":"1>if the includeCommonLocationInfo is configured in the corresponding reportConfig for this measId and detailed location information that has not been reported is available, set the content of commonLocationInfo of the locationInfo as follows:","paragraph_zero_based":5597},{"literal_text_all_w_t_and_m_t":"2>include the locationTimestamp;","paragraph_zero_based":5598},{"literal_text_all_w_t_and_m_t":"2>include the locationCoordinate, if available;","paragraph_zero_based":5599},{"literal_text_all_w_t_and_m_t":"2>include the velocityEstimate, if available;","paragraph_zero_based":5600},{"literal_text_all_w_t_and_m_t":"2>include the locationError, if available;","paragraph_zero_based":5601},{"literal_text_all_w_t_and_m_t":"2>include the locationSource, if available;","paragraph_zero_based":5602},{"literal_text_all_w_t_and_m_t":"2>if available, include the gnss-TOD-msec,","paragraph_zero_based":5603},{"literal_text_all_w_t_and_m_t":"1>if the coarseLocationRequest is set to true in the corresponding reportConfig for this measId:","paragraph_zero_based":5604},{"literal_text_all_w_t_and_m_t":"2>include coarseLocationInfo, if available;","paragraph_zero_based":5605},{"literal_text_all_w_t_and_m_t":"1>if the includeWLAN-Meas is configured in the corresponding reportConfig for this measId, set the wlan-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5606},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultWLAN, in order of decreasing RSSI for WLAN APs;","paragraph_zero_based":5607},{"literal_text_all_w_t_and_m_t":"1>if the includeBT-Meas is configured in the corresponding reportConfig for this measId, set the BT-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5608},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultBT, in order of decreasing RSSI for Bluetooth beacons;","paragraph_zero_based":5609},{"literal_text_all_w_t_and_m_t":"1>if the includeSensor-Meas is configured in the corresponding reportConfig for this measId, set the sensor-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5610},{"literal_text_all_w_t_and_m_t":"2>if available, include the sensor-MeasurementInformation;","paragraph_zero_based":5611},{"literal_text_all_w_t_and_m_t":"2>if available, include the sensor-MotionInformation;","paragraph_zero_based":5612},{"literal_text_all_w_t_and_m_t":"1>if the includeAltitudeUE is configured in the corresponding reportConfig for this measId:","paragraph_zero_based":5613},{"literal_text_all_w_t_and_m_t":"2>set the altitudeUE to include the altitude of the UE;","paragraph_zero_based":5614},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable transmission resource pool for NR sidelink communication/discovery (for measResultsSL):","paragraph_zero_based":5615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5e7ee4824c20999bc32d7ac29989c95c45d7aa2272ae812f0d0205bc140f3fed","fae0df72a2f0a0b26cf40bb858fa48e70dd4b094f3019f6573b446ab42228ad0","9756bfc08042bd1826dbc01d7ff3a9550cc361f8863ed91bc4c67547e0415e72","f4da2de559f657add9a6ed2e3fc10541c5fb7bd490777a3bd3e0cc45e6d6b851","69f6185db2da365cfd0e07dc7ba575663368cac80ec53ef7dfd150b4dce67ba2","dbe398036a1d957e24cd896dbe3581e87bbe75b428ac639db56caaddbd6f7e16","b93f84f85b2c3a0adc09e90659139f0c8ee7a39bc8ffc7c185d554ce2f8fd1ca","b4d0b4ca0aedf26c24dfdaf6de31a75f05fc287e7e3f410d424bcd414261b9eb","28a2d8ca3a997d1f316970c7261dce8cc2fa149c048f305c37bbf6ddbddefef8","811d7d08eba2cbf10aed50fdcfb8d5140f4c2918f9b414567f5f829ae064f91c","112173c5c519896ad14266d253d164354a44f34fab029845257206c37be44929","4b2b0f5440fc1ec0e637cbd7e66579cabf1417bc13367915775efccbdd9c7a74","e23546bc155300702dce590cdf2ae4cea8f4b400d32e62fa48d8a77dcf7d0e92","8b0d0d19f547c00dcbe61bf0e597d5e10217d7fbea5c69b29a16d664ac4336e1","55c9512d051aea7e9238f4ea8e3884c00aecd8105a5b368261f7e15fe486bdbf","434cdf4a4b51a5034083863fe9f74576184a81c886d4694ab873a63ac6085e90","d6340a9b444f38ba0de26cea2f427dc6639c05e8c5d62dfaef7da31426223e39","ff9f444cb6af0f4409c0d42623af695ff7af72553eece69229423e4847db8316","b9109b5b1b89ee7a79e0095f3672127eaf1f9ba51539c63771fca35baa91bfda","d36e814969ce367bc81fd10bf3f8a89ebf294488121695ad15c86c14b5c05299","3f2206e1c0cc59d6f8404f0e0bfcbecae317e259390b3fb9c6c97de4f2f46e84","d3a8f0af378f2eb3c785116bb54a58422605ebbd172de6da305dfbb85cc23010","1337fb1a22317ce2da57dd00f4ef5f9013db1603c8432948d76081b732043b1b","c7a5a11b0ad9eb980fb59fbd3a26a4a8ec7688cc8fcc52a86e04e28af4398808"],"paragraph_range_zero_based":[5592,5615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5592"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set the measResultsListSL to include the CBR measurement results in accordance with the following:","paragraph_zero_based":5616},{"literal_text_all_w_t_and_m_t":"3>if the reportType is set to eventTriggered:","paragraph_zero_based":5617},{"literal_text_all_w_t_and_m_t":"4>include the transmission resource pools included in the poolsTriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5618},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5619},{"literal_text_all_w_t_and_m_t":"4>include the applicable transmission resource pools for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5620},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR sidelink communication/discovery, then for each transmission resource pool to be reported:","paragraph_zero_based":5621},{"literal_text_all_w_t_and_m_t":"4>set the sl-poolReportIdentity to the identity of this transmission resource pool;","paragraph_zero_based":5622},{"literal_text_all_w_t_and_m_t":"4>set the sl-CBR-ResultsNR to the CBR measurement results on PSSCH and PSCCH of this transmission resource pool provided by lower layers, if available;","paragraph_zero_based":5623},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":5624},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable CLI measurement resource to report:","paragraph_zero_based":5625},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to cli-EventTriggered or cli-Periodical:","paragraph_zero_based":5626},{"literal_text_all_w_t_and_m_t":"3>set the measResultCLI to include the most interfering SRS resources or most interfering CLI-RSSI resources up to maxReportCLI in accordance with the following:","paragraph_zero_based":5627},{"literal_text_all_w_t_and_m_t":"4>if the reportType is set to cli-EventTriggered:","paragraph_zero_based":5628},{"literal_text_all_w_t_and_m_t":"5>if trigger quantity is set to srs-RSRP i.e. i1-Threshold is set to srs-RSRP:","paragraph_zero_based":5629},{"literal_text_all_w_t_and_m_t":"6>include the SRS resource included in the cli-TriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5630},{"literal_text_all_w_t_and_m_t":"5>if trigger quantity is set to cli-RSSI i.e. i1-Threshold is set to cli-RSSI:","paragraph_zero_based":5631},{"literal_text_all_w_t_and_m_t":"6>include the CLI-RSSI resource included in the cli-TriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5632},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5633},{"literal_text_all_w_t_and_m_t":"5>if reportQuantityCLI is set to srs-rsrp:","paragraph_zero_based":5634},{"literal_text_all_w_t_and_m_t":"6>include the applicable SRS resources for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5635},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5636},{"literal_text_all_w_t_and_m_t":"6>include the applicable CLI-RSSI resources for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5637},{"literal_text_all_w_t_and_m_t":"4>for each SRS resource that is included in the measResultCLI:","paragraph_zero_based":5638},{"literal_text_all_w_t_and_m_t":"5>include the srs-ResourceId;","paragraph_zero_based":5639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4d039a19ccecfbdd874c8dfca9eeafb96a0c859f8222c7422745175dca33d3cd","960d05a023db49cdd93970c51cab4a0867b5935d835ff890a45771fa0cb1863d","2b870cf4add246ee9299017e785d2603eb9ca1f2a075ee131c7ea37084b06cba","b8499bd7de91df67ceae7a582a5a554ce1ab1ac6f35b4f63945cb06ea72c4478","9ce45b14dca75209a54c7543b41964de2b4e8e8a620ab1ef6a5f0fcd55f41345","6d58f214721125d1f347a2d6bcabd1e4b05ac4520ddf889811394c8915c0825c","299a9c9ae43cf379231e209cf307bea48bd57afa23d4992cfbf92fd94591fa82","c326fc768adff9dfe613548931b7b82d4e5439e20cecfb72b8628984a8adee0f","48dcfc260a82e3a3cbd69be92f41d8475417f5b946ac456398422800deb54b27","3fe084bd13764d8375dc095a3193dafa748f5df4ed2334aa193e8c172376f426","b6b066438d79ee5e9c45ea78659e1fa554d2dfd823735c2ce982b59d7fc1aa5b","2fbf378e4aa0da52df985cd8d5b7103f7a1cbdffd68d2292646365712718c128","a0c319d77666868981589a6eff896ca8a0f7647c8e3d422833bac740d5135b20","b7d1a8de11596ca94b94cafa9091e2ecc596c9601cf5a32db04f882c14f9da50","cab3a88935a979c67a2903d2c4946ff74804f2572aa416bfba6e3fb91bf9dd44","e82d4e1548fa89628e61a3685e335648aad21acbbd26af2e0f533046de82c0a4","b45515ea0d17e53affb2ee362aeca9cff203c4a48b7d414471f97a0b323b4112","6fe3673f2d411780522fa2e35212802a07af58a1a909dcfbb514a389597617f9","14c90465c6eb8a896f088fb8ab9653c6e783b8dd0809a0b402124b57bafe8a2f","da9333a35705ee4cc332a26ac1c1cbe8ba48b6a6bd22c15fceb94bbd29b123ba","24a9432fc73308705ad779e33fc860266e146f30ca6974f1b693380f748673a8","342d934f4e5be68e9cac95c64b91534b371f2ebae7b5654f63422df16e4db8ab","6e29f55d45f22ed5803e0f47293c8bec5646c78fd0610035102caa52046cfb55","db831feefa2c40d29b67f1ca931c09455fcfb617b8e3e5912f36fb5ea081e4b5"],"paragraph_range_zero_based":[5616,5639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5616"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>set srs-RSRP-Result to include the layer 3 filtered measured results in decreasing order, i.e. the most interfering SRS resource is included first;","paragraph_zero_based":5640},{"literal_text_all_w_t_and_m_t":"4>for each CLI-RSSI resource that is included in the measResultCLI:","paragraph_zero_based":5641},{"literal_text_all_w_t_and_m_t":"5>include the rssi-ResourceId;","paragraph_zero_based":5642},{"literal_text_all_w_t_and_m_t":"5>set cli-RSSI-Result to include the layer 3 filtered measured results in decreasing order, i.e. the most interfering CLI-RSSI resource is included first;","paragraph_zero_based":5643},{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable UE Rx-Tx time difference measurement to report:","paragraph_zero_based":5644},{"literal_text_all_w_t_and_m_t":"2>set measResultRxTxTimeDiff to the latest measurement result;","paragraph_zero_based":5645},{"literal_text_all_w_t_and_m_t":"1>increment the numberOfReportsSent as defined within the VarMeasReportList for this measId by 1;","paragraph_zero_based":5646},{"literal_text_all_w_t_and_m_t":"1>stop the periodical reporting timer, if running;","paragraph_zero_based":5647},{"literal_text_all_w_t_and_m_t":"1>if the numberOfReportsSent as defined within the VarMeasReportList for this measId is less than the reportAmount as defined within the corresponding reportConfig for this measId:","paragraph_zero_based":5648},{"literal_text_all_w_t_and_m_t":"2>start the periodical reporting timer with the value of reportInterval as defined within the corresponding reportConfig for this measId;","paragraph_zero_based":5649},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5650},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical or cli-Periodical or rxTxPeriodical:","paragraph_zero_based":5651},{"literal_text_all_w_t_and_m_t":"3>remove the entry within the VarMeasReportList for this measId;","paragraph_zero_based":5652},{"literal_text_all_w_t_and_m_t":"3>remove this measId from the measIdList within VarMeasConfig;","paragraph_zero_based":5653},{"literal_text_all_w_t_and_m_t":"1>if the measurement reporting was configured by a sl-ConfigDedicatedNR received within the RRCConnectionReconfiguration:","paragraph_zero_based":5654},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":5655},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":5656},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":5657},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5658},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5659},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via E-UTRA embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":5660},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":5661},{"literal_text_all_w_t_and_m_t":"2>if the measurement configuration that triggered this measurement report is associated with the SCG:","paragraph_zero_based":5662},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":5663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5d99fbb62b2a22559be0e4aba4920052c4809143ad7c9c5d5fdc70a200d7d4ce","ca1ed35b0f0fc83f5f2c5cf4cd66939fe7d1e821979d9081cf002e49ad98c14c","8b95c9bba852dab365d9a6662c2a85cc061b56f93b0df46bbad0e9849263035b","a051f77411322bd92c8dfcd8d30a07dbff8f7f6eb1355deb900c5ecbf4e46a7a","941662ca24f30b9fe0d12e5d0d4d9dd5ba82db832e7070cf3371a5c404fc6763","b50bc2ead8096ab1e415825e5475d16f68968391a89da9720f8f443d6cb7c8ad","bd94e660828e8fd8d35f7915439aa8734f21d90a240b9f050f54af12379a09b6","d6abb2dc1dde77639850aa93602678c80d5b2da13ae6644d5c259bd18a0831d8","a2c587854535e0ea93e3763c2a9e0a0aaa82dc62feb40eca5b1dafd926a67e68","ec2b70e4e98a98a02b0aeb6a3fbb92de7fca9f2f80bbf5b51d29ace7f9110ce7","7d34909d000b53f821fe080de0e25f9ef4fd41c5ed3990916858f3fa2292141d","2f98fce3c736cb1296a7b1a758e1dcf3c4fa07dcb78d9b5bf45cc72e1fa8e106","ac67bbbf673d78065b1519a1ce0b293cc242d12bf8eda3854e48640d5e4f9dd2","e1135ad3a19623b15ba491f6d9fe14cdbb534b54fb010c183c1d7295ac29151c","3b9b5bbdbef8c3d37011f966853cb43ee7a3178838f164cbc98ec1b10206e280","bd1cb2b793278239dc4faa9f931cd63e399b3ff2f92ed292f542c1d2ab3851ac","ec45325979b487b26d89e0e470d2821a2e8200a893c2a0281662344ebe5e37fe","9dc12271739502114d7fdaffa79ea1dfdd234fe132a7eb055b70e3ea84508ded","90c3529a795034a614efaf7d5cb24780c284286c92c6c4cceb1348ec278f64ba","0ced4475293440fa597d76a33dbd95b1a196758d5dda790da040853dcdd4b743","33cf35ce276933f59e378566f1d037408f8fbc449fb04ad2f88fee65ffcd5aad","f77b3080429ece5621f7bc27f5b46e87abfca9264dd9ac7c5f00cd7e92dde91c","210bfcd1f34cd04bb16cc010e11d241ee340891cbc5a95fb467999264a7fa10d","0f52a3af59adcbadc9aacd452ebb0a8bd2680971abdb5b0e276f70c2dfbd09ea"],"paragraph_range_zero_based":[5640,5663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5640"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5664},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5665},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":5666},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5667},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB1 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":5668},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5669},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5670},{"literal_text_all_w_t_and_m_t":"5.5.5.2Reporting of beam measurement information","paragraph_zero_based":5671},{"literal_text_all_w_t_and_m_t":"For beam measurement information to be included in a measurement report the UE shall:","paragraph_zero_based":5672},{"literal_text_all_w_t_and_m_t":"1>if reportType is set to eventTriggered:","paragraph_zero_based":5673},{"literal_text_all_w_t_and_m_t":"2>consider the trigger quantity as the sorting quantity if available, otherwise RSRP as sorting quantity if available, otherwise RSRQ as sorting quantity if available, otherwise SINR as sorting quantity;","paragraph_zero_based":5674},{"literal_text_all_w_t_and_m_t":"1>if reportType is set to periodical:","paragraph_zero_based":5675},{"literal_text_all_w_t_and_m_t":"2>if a single reporting quantity is set to true in reportQuantityRS-Indexes;","paragraph_zero_based":5676},{"literal_text_all_w_t_and_m_t":"3>consider the configured single quantity as the sorting quantity;","paragraph_zero_based":5677},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5678},{"literal_text_all_w_t_and_m_t":"3>if rsrp is set to true;","paragraph_zero_based":5679},{"literal_text_all_w_t_and_m_t":"4>consider RSRP as the sorting quantity;","paragraph_zero_based":5680},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5681},{"literal_text_all_w_t_and_m_t":"4>consider RSRQ as the sorting quantity;","paragraph_zero_based":5682},{"literal_text_all_w_t_and_m_t":"1>set rsIndexResults to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes or CSI-RS indexes in order of decreasing sorting quantity as follows:","paragraph_zero_based":5683},{"literal_text_all_w_t_and_m_t":"2>if the measurement information to be included is based on SS/PBCH block:","paragraph_zero_based":5684},{"literal_text_all_w_t_and_m_t":"3>include within resultsSSB-Indexes the index associated to the best beam for that SS/PBCH block sorting quantity and if absThreshSS-BlocksConsolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":5685},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the SS/PBCH based measurement results for the quantities in reportQuantityRS-Indexes for each SS/PBCH block index;","paragraph_zero_based":5686},{"literal_text_all_w_t_and_m_t":"2>else if the beam measurement information to be included is based on CSI-RS:","paragraph_zero_based":5687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2c75a9c79e0c23f6e06782ee217cc3a5651fcb18909e8f5a027bbfeb74820d02","3339d01419a07352e73774a11aec8b577fc7cfced0ec4a8bb3ea26a4bd349119","3ab6aca5cfb35d137bb5ead233a1f3ce3db96815b44482edb80388f873b8726f","515163cb521ca676e5157e7a2a7a96fec32b5b6f99f5f461ff87d985759603b3","abefcb3b6c222bc3e52685fb91ad4bb5f3ad695ed1a671ec637ce2ce6ff365d4","01ba9372e3fa1b7cb67193c88c241f621ad7b24da9eeead024c3f9fbd90a6052","784e4139ceb3b8885b332fee319b20302cd822c21d21a38f6a7eb3990b520114","7e1f1ac405dc54b7ca8afa6f8afb77a3e933dd1b23e289970a77242f0995c60c","951f1dae488f18dfabc1b645b9dba7e808e949d7d8fd4c6e181ff906b35dec0f","f671040964953c99ac010d838a06a41ec7c7a7add1e8435e8fcac57a0163c338","fb967cf9c4068e09a02c8685ccebeebb82711efd35b9fb5f8c1500041e98d352","f5cf0a68d5d674437c4822ae2c3df723480fa61e2220c9087637c57fc4c6c5d6","ce7fcfb5ae4dcaee5c6e60bd3765026c8d7f597257f6fd51b5244da417b9d582","d1f4d84fa85ebef790d3af40164c7e61d172db775cdd77a53536c8271b26bbe4","11eb308774ae640609740123212e8976a7d56461906deee320f8100ee8d4ccc7","236a53757dc2a0b1976d1a398b66b5f2475920de5113921cde0fb5d611f32c46","34996a60304ce06bafdb9507d01b7f2ce7a0fb06d6bde82c8ca89b19d3492c47","10c3d63e00d4703728fdc086a64c1a6b514e7462ec26afa7acace8768efdefaa","759645b77585210ae608a8c96cff8e92f134e7a367d885a57a635ac076201370","840eb0525e8bd3720d2af88b7b175a2cde777dcea2759a00a4d269e00bdc2ace","ba6417025a071af3f218c42a5a3b0befdddbc375a0bd7a999fc587064a21470f","2b7ce91587a1a07597629ed670bcbb5c467d98326b426b9e3974c52b44adafb5","d8fe5d940b56204294f82bd416e24567dba0ff91d917127ec27be37120981e39","b240a24c82efc7907ee2c1cfeed5f3d2f8e65e97b89fd8fc7bdf604522ccc5c7"],"paragraph_range_zero_based":[5664,5687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5664"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include within resultsCSI-RS-Indexes the index associated to the best beam for that CSI-RS sorting quantity and, if absThreshCSI-RS-Consolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshCSI-RS-Consolidation;","paragraph_zero_based":5688},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the CSI-RS based measurement results for the quantities in reportQuantityRS-Indexes for each CSI-RS index.","paragraph_zero_based":5689},{"literal_text_all_w_t_and_m_t":"5.5.5.3Sorting of cell measurement results","paragraph_zero_based":5690},{"literal_text_all_w_t_and_m_t":"The UE shall determine the sorting quantity according to parameters of the reportConfig associated with the measId that triggered the reporting:","paragraph_zero_based":5691},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to eventTriggered:","paragraph_zero_based":5692},{"literal_text_all_w_t_and_m_t":"2>for an NR cell, consider the quantity used in the aN-Threshold (for eventA1, eventA2, eventA4, eventA4H1 and eventA4H2) or in the a5-Threshold2 (for eventA5, eventA5H1 and eventA5H2) or in the aN-Offset (for eventA3, eventA3H1, eventA3H2 and eventA6) or in the x1-Threshold2 (for eventX1) as the sorting quantity;","paragraph_zero_based":5693},{"literal_text_all_w_t_and_m_t":"2>for an E-UTRA cell, consider the quantity used in the bN-ThresholdEUTRA as the sorting quantity;","paragraph_zero_based":5694},{"literal_text_all_w_t_and_m_t":"2>for an UTRA-FDD cell, consider the quantity used in the bN-ThresholdUTRA-FDD as the sorting quantity;","paragraph_zero_based":5695},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the yN-Threshold2-Relay as the sorting quantity;","paragraph_zero_based":5696},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to periodical:","paragraph_zero_based":5697},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityCell for an NR cell, and according to reportQuantity for an E-UTRA cell, as below:","paragraph_zero_based":5698},{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":5699},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":5700},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5701},{"literal_text_all_w_t_and_m_t":"4>if rsrp is set to true;","paragraph_zero_based":5702},{"literal_text_all_w_t_and_m_t":"5>consider RSRP as the sorting quantity;","paragraph_zero_based":5703},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5704},{"literal_text_all_w_t_and_m_t":"5>consider RSRQ as the sorting quantity;","paragraph_zero_based":5705},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityUTRA-FDD for UTRA-FDD cell, as below:","paragraph_zero_based":5706},{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":5707},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":5708},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5709},{"literal_text_all_w_t_and_m_t":"4>consider RSCP as the sorting quantity.","paragraph_zero_based":5710},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the reportQuantityRelay as the sorting quantity;","paragraph_zero_based":5711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3b41ae01613d5790c614dd58544e7849423280ed312090dab85e481dedcc724b","41474c730eb5d647e23602036fa0b040aa0f094e0a7f0e658ea375af582f66f6","2235e12b83b4d2f8d82c9ac3ed49e11c9ba017c66935dff1bfac65bfb1d27292","e2852b0e87fc997db2fd850ccfd1c1574b776300e2e5f06fe4663d9f534c88be","22a82e58cdf20a0826d2ecdce39d73e735e120e9ffec98f5b1920f4909fde3cc","4d6ea3963b5fddd9f48f9c63a80ae9997d0ec1b86d681aecb6decd13aecb9d44","81eee1484c5e4cef19d2d27f7c11984dfa4e309e9700ef76350440682bad9732","d46f9887ac637e62c86c08e08f9bfa98ad3ca9c28488129ec5c36b6d9f8b04d0","c48625cc40c00c018efc64d3de3c73acd29a97adcdb90aee2dfda231b347e3a2","6e188b4aff279d3802b74f1f07d9aa28b0237dfbcadc4f1eb73c20ed1d103b14","48be2decb0a284184c7c2842636b486581563aafad312ba70df420adf214fdd4","9a4fbd563782309e0f6186673abba34aae05f074d83eb31bd829a151b2d9c640","e674deb0397b3f70b2bd44db2fc491c0253daf36f5beb7964153e63ca147de8e","f3ae48b10e4dc0169de09a5fd6f0638a72ad78f1cede895c72da6c613f6962f0","8917c878973c047ea57fb89e22c0ad1cffe3092f84c176d5a4ff2b3a5a8b0bd8","ce756c1968567ad5d134e07306f0a9932c039bf60f9a0878fdef1129a5287837","19ec7661ce8b07aa98b9676455db237650a4a791997f50e3caa8f48bd10d2ce0","d8b5e410bb694de4ad3eba6627c56b47b14abc1d8c394d686a4544ee7215d8f4","f6e4700b7e68f854f6b2ddfa156ace1564589f4ce290d453e02e4bcdcd597523","e9755b44d5dced3e13a210ac6cd167d1e5b5a49dd792fe8d516cc40a13bbe5ec","82b1ef7e95c2776621466c8501a2145c130a560b27ac7fe1a5d852f84cb6da78","54e7944eba36d2de3c77ce59621f63a56585a226fe1515b0dd8db5b49155ff5b","05cdf0f0cdec180dc8e536fc984ad628d6b1e434081835a2851c80c174e446bb","2d3b627f7061f2350c7677645d7f92ddf0286120e790447f6e394436c5c44b0c"],"paragraph_range_zero_based":[5688,5711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5688"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5.6Location measurement indication","paragraph_zero_based":5712},{"literal_text_all_w_t_and_m_t":"5.5.6.1General","paragraph_zero_based":5713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5714},{"literal_text_all_w_t_and_m_t":"Figure 5.5.5.1-1: Location measurement indication","paragraph_zero_based":5715},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to indicate to the network that the UE is going to start/stop location related measurements towards E-UTRA or NR (eutra-RSTD, nr-RSTD, nr-UE-RxTxTimeDiff, nr-PRS-RSRP) which require measurement gaps or start/stop detection of subframe and slot timing towards E-UTRA (eutra-FineTimingDetection) which requires measurement gaps. UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":5716},{"literal_text_all_w_t_and_m_t":"NOTE:It is a network decision to configure the measurement gap.","paragraph_zero_based":5717},{"literal_text_all_w_t_and_m_t":"5.5.6.2Initiation","paragraph_zero_based":5718},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5719},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to start performing location measurements towards E-UTRA or NR or start subframe and slot timing detection towards E-UTRA, and the UE requires measurement gaps for these operations while measurement gaps are either not configured or not sufficient:","paragraph_zero_based":5720},{"literal_text_all_w_t_and_m_t":"2>if preconfigured measurement gaps for positioning and posMG-Request are configured and the UE considers that at least one of the preconfigured measurement gaps for positioning is sufficient for the location measurement when activated:","paragraph_zero_based":5721},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to initiate the measurement gap activation request using UL MAC CE as specified in TS 38.321 [3];","paragraph_zero_based":5722},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":5723},{"literal_text_all_w_t_and_m_t":"3>initiate the procedure to indicate start as specified in clause 5.5.6.3;","paragraph_zero_based":5724},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE verifies the measurement gap situation only upon receiving the indication from upper layers. If at this point in time sufficient gaps are available, the UE does not initiate the procedure. Unless it receives a new indication from upper layers, the UE is only allowed to further repeat the procedure in the same PCell once per frequency of the target RAT if the provided measurement gaps are insufficient.","paragraph_zero_based":5725},{"literal_text_all_w_t_and_m_t":"NOTE 1a:When indication is received from upper layers for performing location measurement and there is pre-configured measurement gap configured (not preconfigured measurement gap for positioning), the UE considers this preconfigured measurement gap to be not sufficient if the measurement gap is not considered to be always activated according to clause 9.1.7.2 of TS 38.133 [14].","paragraph_zero_based":5726},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to stop performing location measurements towards E-UTRA or NR or stop subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5727},{"literal_text_all_w_t_and_m_t":"2>if there is no activated preconfigured measurement gap for positioning:","paragraph_zero_based":5728},{"literal_text_all_w_t_and_m_t":"3>if there is previously triggered UL MAC CE transmission for the measurement gap activation for positioning:","paragraph_zero_based":5729},{"literal_text_all_w_t_and_m_t":"4>indicate to the lower layers to cancel the triggered UL MAC CE transmission for the measurement gap activation as specified in TS 38.321 [3];","paragraph_zero_based":5730},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5731},{"literal_text_all_w_t_and_m_t":"4>initiate the procedure to indicate stop as specified in 5.5.6.3.","paragraph_zero_based":5732},{"literal_text_all_w_t_and_m_t":"2>else if there is activated preconfigured measurement gap for positioning:","paragraph_zero_based":5733},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to deactivate all the activated measurement gap(s) for positioning as specified in TS 38.321 [3].","paragraph_zero_based":5734},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE may initiate the procedure to indicate stop even if it did not previously initiate the procedure to indicate start.","paragraph_zero_based":5735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9ccb688b49c3ae005f3f8555cb5db2cb1635d9403469194c5ff6dbdd20ff6d7f","24839967f82b12012f926efeb15bc8f571e483bf437ec965b994d771f3165cd3","e49629af5435c474983b6aa710ca2ffd2a27d2c0f4ebce3197ce3f459e498246","9e61c5312f5e7c7e757c81ad271f13e39f75fc5eda556456516ef2e2564a8282","9a9f518f11b1cd339a1b8b69db52a127d1dec4dbdd041d2a60e471283af945f6","7de46fa7a555f11257e156e214d671a474ae9faf7f4d6c48366661a72141be6e","316b523ba4ca6adcf7f7711431e690a975128cdfd2efafe6d3f177e1c442a220","9e717e80573af5140b7d4c7c00c517154a3bab243f4b8467e332115004a52198","2d525d50f4037bc73bc7f0ce872e7c39e7ec470438b7b806ed870a4ad50812e1","eba6562b7a3dce7dd09e6c5fbed46ed73a7d51117f29a84496a10a910c99dc3f","c5c7a2bb19f5dbdcc04ef6a1e7b7267708011d3600879b6777f8a3e01162315c","2ad5a23a36e19c23dce13c9ed7abbc0b7f64d500ef1e5ec1e66af7665cdfb5eb","a7095d5ec1f3454caa49b4c78a760991189aaa92fce76a2a058d3fd8601e70aa","ad24c25396ae902406ac069d81e82a35f027b9dfa383ff4dfa0a537bedf244b2","611d3a9969049c0aea11f72cf31d59c90e52bf7eac74a5928caf558c64e640ae","502360bd55f8e96b7da3ea3420debbc3dba34d82fc045b254d5b3e2070a03e27","4daaac22c7c0b968e0e4e4e3288cfa5ee5066fe358d039df2fae4b8e50353ca1","63b7fd74604d34bdaff147d19389024a636700d5ad3caad28cb3cc5cc44ef0af","b0a4bd5cd83134148dac258002e7a8fa10c79639cd5852a0057d777094ec7d99","62a67e85452edcc46089ee746b29d750d52453eeddd883dcaeb43bf9ed6ba4e9","9b4b0092818cf368b99b9b85d17ddb996c855aadeb3cee53da66f7b7ce0cc3be","66f4eb77253e5010095680a2abd5b8e67093ccfb2158526dd9498e9a1ccb0d6b","30db5dc5dfb4602724708111d10f835eb2e8c0b2ca605e58354364dcc01b82bf","d9957d4ca7df36cbeac76530bf5a544b380856e7e40b87843f1d59f9ba690bad"],"paragraph_range_zero_based":[5712,5735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5712"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5.6.3Actions related to transmission of LocationMeasurementIndication message","paragraph_zero_based":5736},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of LocationMeasurementIndication message as follows:","paragraph_zero_based":5737},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of location related measurements:","paragraph_zero_based":5738},{"literal_text_all_w_t_and_m_t":"2>if the procedure is initiated for RSTD measurements towards E-UTRA:","paragraph_zero_based":5739},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the eutra-RSTD according to the information received from upper layers;","paragraph_zero_based":5740},{"literal_text_all_w_t_and_m_t":"2>else if the procedure is initiated for positioning measurement towards NR:","paragraph_zero_based":5741},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the nr-PRS-Measurement according to the information received from upper layers;","paragraph_zero_based":5742},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of location related measurements:","paragraph_zero_based":5743},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":5744},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5745},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value eutra-FineTimingDetection;","paragraph_zero_based":5746},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":5747},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":5748},{"literal_text_all_w_t_and_m_t":"1>submit the LocationMeasurementIndication message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5749},{"literal_text_all_w_t_and_m_t":"5.5aLogged Measurements","paragraph_zero_based":5750},{"literal_text_all_w_t_and_m_t":"5.5a.1Logged Measurement Configuration","paragraph_zero_based":5751},{"literal_text_all_w_t_and_m_t":"5.5a.1.1General","paragraph_zero_based":5752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5754},{"literal_text_all_w_t_and_m_t":"Figure 5.5a.1.1-1: Logged measurement configuration","paragraph_zero_based":5755},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to configure the UE to perform logging of measurement results while in RRC_IDLE and RRC_INACTIVE. The procedure applies to logged measurements capable UEs that are in RRC_CONNECTED.","paragraph_zero_based":5756},{"literal_text_all_w_t_and_m_t":"NOTE:NG-RAN may retrieve stored logged measurement information by means of the UE information procedure.","paragraph_zero_based":5757},{"literal_text_all_w_t_and_m_t":"5.5a.1.2Initiation","paragraph_zero_based":5758},{"literal_text_all_w_t_and_m_t":"NG-RAN initiates the logged measurement configuration procedure to UE in RRC_CONNECTED by sending the LoggedMeasurementConfiguration message.","paragraph_zero_based":5759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["77b7a935a98d130ac5ceb0f93fda11fb998d0a53d3e1c419dff65852bfe609e6","2f08db413e33edd548c1dd1ebcb4bc88195b5b690152a6dd1f5b3cc9f82dc63a","1cce9bcbc58acb9fb96957c99dde73af2a82f116caa61307a0caec1364128008","c48df735f69f6637ee38ab3fec29fb8e84c2ce9619c420eda15880bfc1da4dec","d1b107d5706b750269cd97fad5cd1c4773299c3ebce814c17b5a46d3f10fee7d","78c5ca8ac50ccd0383bbfa9377915eecca745b48aef9e93a0c2c0aab35baabd9","2da2bee650b8ac55b3d060645459505611a0e4d59d98399f8867f71c5432d239","236ac7a3d6deebbb847228d3540a31a066d5f0f3f04ff1d4785c6be32f7d7131","d43e6768aaa13486d92dce84d0e68c559527954f6be028c7e1595b57a5c0eb24","d9c0be08a686926222eee75dbcd2a02898418ff95907b522127c119ab56c9680","1c6aacd0fbeec20a08cb40426476748e34c74fb42b67b8ec4ed72cfc18491be8","32d2c2fc6b8396f6cf7194722650a602461d1e387c6e26bb9656298c72cae06e","3c6237f1ded5e5da8dadcb7516dc4cfe984f97d16a3090263dbc3d866bf4d1be","96d647258e0a5e786c4f2a62f5381a76d628d763d259c65997b9b20c504e6cfe","ce5318d23d07929d40032c4e08a2120834104319208a43fbf9b937e6a7783ae5","d1c6edb91a7e52f05db269763583c2faac69f652a42e1d603cb45306ba311327","8a328e0731ebf908f97746a01e99bb193aa48c3a3edc7d9393424f00d6d77305","d2bed47872e1766c34dc852769fbe6d4b90a7deb78a88c5d1c25a4f2cf243aea","d882d03c9e189ac73d2c895ca6bfddaa722963bff56656548c8aa30e36486d19","f5a6e6be80eab716972bc2aad0b35893a692a69741ab92a9abd5b010a4e160a8","810803934b6504e08e0d85913c282c9f1ed319559b577ca1a7b64ad77f1ffb31","ca94948204105aba1a1d9afeffe1ba9d8871fc514fe4f9db5440f9baa922e87c","09facbf0c3d19b52098a2d5a795b82a4de8b4c791d55a4486501ec3c642dca77","f763db5b3f6668676fd32a5a3aa252c81d32a9f9b013974c04903f8b937a821a"],"paragraph_range_zero_based":[5736,5759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5736"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5a.1.3Reception of the LoggedMeasurementConfiguration by the UE","paragraph_zero_based":5760},{"literal_text_all_w_t_and_m_t":"Upon receiving the LoggedMeasurementConfiguration message the UE shall:","paragraph_zero_based":5761},{"literal_text_all_w_t_and_m_t":"1>discard the logged measurement configuration as well as the logged measurement information as specified in 5.5a.2;","paragraph_zero_based":5762},{"literal_text_all_w_t_and_m_t":"1>store the received loggingDuration, reportType and areaConfiguration, if included, in VarLogMeasConfig;","paragraph_zero_based":5763},{"literal_text_all_w_t_and_m_t":"1>if the LoggedMeasurementConfiguration message includes plmn-IdentityList:","paragraph_zero_based":5764},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN as well as the PLMNs included in plmn-IdentityList;","paragraph_zero_based":5765},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5766},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN;","paragraph_zero_based":5767},{"literal_text_all_w_t_and_m_t":"1>store the received absoluteTimeInfo, traceReference, traceRecordingSessionRef, and tce-Id in VarLogMeasReport;","paragraph_zero_based":5768},{"literal_text_all_w_t_and_m_t":"1>store the received bt-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5769},{"literal_text_all_w_t_and_m_t":"1>store the received wlan-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5770},{"literal_text_all_w_t_and_m_t":"1>store the received sensor-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":5771},{"literal_text_all_w_t_and_m_t":"1>start timer T330 with the timer value set to the loggingDuration;","paragraph_zero_based":5772},{"literal_text_all_w_t_and_m_t":"1>store the received sigLoggedMeasType, if included, in VarLogMeasReport;","paragraph_zero_based":5773},{"literal_text_all_w_t_and_m_t":"1>store the received earlyMeasIndication, if included, in VarLogMeasConfig;","paragraph_zero_based":5774},{"literal_text_all_w_t_and_m_t":"5.5a.1.4T330 expiry","paragraph_zero_based":5775},{"literal_text_all_w_t_and_m_t":"Upon expiry of T330 the UE shall:","paragraph_zero_based":5776},{"literal_text_all_w_t_and_m_t":"1>release VarLogMeasConfig;","paragraph_zero_based":5777},{"literal_text_all_w_t_and_m_t":"The UE is allowed to discard stored logged measurements, i.e. to release VarLogMeasReport, 48 hours after T330 expiry.","paragraph_zero_based":5778},{"literal_text_all_w_t_and_m_t":"5.5a.2Release of Logged Measurement Configuration","paragraph_zero_based":5779},{"literal_text_all_w_t_and_m_t":"5.5a.2.1General","paragraph_zero_based":5780},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to release the logged measurement configuration as well as the logged measurement information.","paragraph_zero_based":5781},{"literal_text_all_w_t_and_m_t":"5.5a.2.2Initiation","paragraph_zero_based":5782},{"literal_text_all_w_t_and_m_t":"The UE shall initiate the procedure upon receiving a logged measurement configuration in same or another RAT. The UE shall also initiate the procedure upon power off or upon deregistration.","paragraph_zero_based":5783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["46c8ea152e7c9f2146253af22286aac0a005e01040bf1ca24357eb4e45c408d0","a43d7ecbaca5e49e79df56121b1edafbc6e5c0e2a5cf5f8d865f51b0f773eefb","0762c254469d9a2cf6c8b261552df173de58bf1bf321e34b8400ea8efa00dce5","0b1a1275f6588e30725292126f6b5f20aa98ffcda902c5e41cfa89408aa53bc3","e186ce4830d60d1330403c45c46858676b67c35680e3e1b6fdfae504ed12cb26","fb5f51db76f44aea6c0e2b23fd95f3b9ba0cc51be3e8475b4ec860668c0d720f","8d357783f12f1d2cb60d867f51abb757919b0383d0f6f2b6a184d16c2936f942","633fbc88ea49814444d082670657739f4bf28316688d569c879852d09126789b","9657b7edab44105a83a0dc111ab566184905733fd0d64bd2022d67ea38c67e43","7aa86f345f56bedd24cbea555989d0934f1881ac122001eb07829f53bcfe4190","8899391079fe8cc3c2b79f3fd6056a13df68b31201c2141c9792fd775cbf87f1","7777831c7a9ec9d9cedf41c4ac66db5dfcd5ac66b2bb920ea8f201fe921de139","c5f4f88fccb52585b16ff4e0427f8c686e343eafc063cba6e6879709000e5235","d34432cf997206d81cf9a1d7716c51f7f50a1f477f09a6638727402ca3bfcace","205d64e122e616728eec7409f64d5dc581f976c3b54a9aee8c4f20bbcef5ee5f","cd99a4a18deb13a5bc70223c212a0b1bd56d09c414472b87f3533c1b2036a203","1fba5aca89fb4d7c253c5b587809d12c68935f16d95a98dc7de45900695d268b","810b4918360ddfa398ad4af86aba0b3e2fb0586b612a7b06b2f2adc2c6579c34","5638cbc91da85606363640a7d930f5a5c4c944855deaebb87ee520dfa8133252","7b405f057899ab5ff918713bcf6c7ba480478279faa731335a932102ee084485","c42944ff1ce00f663ebe22d36ba3e352c65e6dae653fb01a95501f6739cfbd08","166f1ca19a4bee2f3154c778b737e1d1ba3a73ece261abcb4743b432e9d387f2","195dee160ad6b37768e0cec561a141b2438c9191eb224f7ee5112fb713c86359","9d705376ae33c7393076f2fd20fd5f715fa0746989ce1f811bcd4e584353247e"],"paragraph_range_zero_based":[5760,5783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5760"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5784},{"literal_text_all_w_t_and_m_t":"1>stop timer T330, if running;","paragraph_zero_based":5785},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the logged measurement configuration as well as the logged measurement information, i.e. release the UE variables VarLogMeasConfig and VarLogMeasReport.","paragraph_zero_based":5786},{"literal_text_all_w_t_and_m_t":"5.5a.3Measurements logging","paragraph_zero_based":5787},{"literal_text_all_w_t_and_m_t":"5.5a.3.1General","paragraph_zero_based":5788},{"literal_text_all_w_t_and_m_t":"This procedure specifies the logging of available measurements by a UE in RRC_IDLE and RRC_INACTIVE that has a logged measurement configuration. The actual process of logging within the UE, takes place in RRC IDLE state could continue in RRC INACTIVE state or vice versa.","paragraph_zero_based":5789},{"literal_text_all_w_t_and_m_t":"5.5a.3.2Initiation","paragraph_zero_based":5790},{"literal_text_all_w_t_and_m_t":"While T330 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":5791},{"literal_text_all_w_t_and_m_t":"1>if measurement logging is suspended:","paragraph_zero_based":5792},{"literal_text_all_w_t_and_m_t":"2>if during the last logging interval the IDC problems detected by the UE is resolved, resume measurement logging;","paragraph_zero_based":5793},{"literal_text_all_w_t_and_m_t":"1>if not suspended, perform the logging in accordance with the following:","paragraph_zero_based":5794},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":5795},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":5796},{"literal_text_all_w_t_and_m_t":"4>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":5797},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":5798},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":5799},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5800},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":5801},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered, and eventType is set to outOfCoverage:","paragraph_zero_based":5802},{"literal_text_all_w_t_and_m_t":"3>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the UE is in any cell selection state;","paragraph_zero_based":5803},{"literal_text_all_w_t_and_m_t":"3>upon transition from any cell selection state to camped normally state in NR:","paragraph_zero_based":5804},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; and","paragraph_zero_based":5805},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the current camping cell is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5806},{"literal_text_all_w_t_and_m_t":"5>perform the logging;","paragraph_zero_based":5807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["28ff3f078239a4ce6b2bd39bb74f899f5bab54d1d452dd447c7fcebf9e9123b0","53e0a671e7d0a8a211bee64affb3d120fcb5f6b03e309f248983b8534cb7629a","cd1b6f1cd80c1a8f71162d8a57ba2a83aab88adbbcdfb4fff229bf39bf3c39f2","c2ce292dd7a468085016e95bffcdce1076ca60d39ef823351ae6aa252fa33bbb","0ec6da18432000776dc852c547c422f63e40eb104d3cc14cdb0a7d2099b712f8","ae0c4839df05b9a0931a304f6220f08ec198767ffa2be70f678f9a07e4bab887","49b87841792687e2ff7114921e4438d483d2579561ef8cd94cc15a6e2c5803de","c8af088db2d41b045c27376981eda8bb9c20a7104a39750666027595089d3411","c18f4f5e78255bff0a6c23c9ad3fd030a4d301d72ddb393571eed2bf530950ac","3e1ff4dde810082af5af4309c9239214752a661c63b2cd56cb720a4a81307528","181296fbf85d7a86866bbf35592962dcd9d640837ec203449afd68371387b0ca","7408365cef038ef7be32dfb6989465fa2ed140f11ed28dff5699abafa12d403e","08997f49992b7763217a399006071c9aa4680fc20a57f9341b7ce957ad5a4b3e","889eae4ce014b443e237ea9e47dce0bf18ac0ed216d76426335f2086aa867f0e","ff9bbde22eaf2e635ff5d85fee2c4be96c01a010e6d82e14cacd6a93401d4a65","e715786fddeaea9a9ecf31e6583d23f936753725bf058f6e9628d190a5321516","e8c3f1bb4147ab9a9b1779ca32281c9ad1d83d857fbb8403e349cb880dfd7dc7","dccb2b15bfea41b3161d4201fd4055c1106ea480a515a45f65ff7dc4104a0e8d","3a9f1145110c654dbf41943813cbd41928766d0cff643056bb3aef50ccc75604","69b84dbdd7705cabc2ecb0acb2992bcaae149107beb328a8504d5cb2684f9751","86c1a94a76f770a03a7590c6307b0df283b8d47bb8284838710cce7711ddafac","70ee4c811e83e37b9bb2d5aa933ca0b7732f40f2380829b718d65a99bacee655","354e826a5dc509205bb194e77ad18f089be4c6148b3f9653241f23cb77bb0cfb","25fe2ad26f745b1222fdb84c0f5141aa9e39ad8ad384f068548fa40abdcd38b4"],"paragraph_range_zero_based":[5784,5807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5784"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and eventType is set to eventL1:","paragraph_zero_based":5808},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":5809},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":5810},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig;","paragraph_zero_based":5811},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the conditions indicated by the eventL1 are met;","paragraph_zero_based":5812},{"literal_text_all_w_t_and_m_t":"2>when performing the logging:","paragraph_zero_based":5813},{"literal_text_all_w_t_and_m_t":"3> if InterFreqTargetInfo is configured and if the UE detected IDC problems on at least one of the frequencies included in InterFreqTargetInfo or any inter-RAT frequency during the last logging interval, or","paragraph_zero_based":5814},{"literal_text_all_w_t_and_m_t":"3>if InterFreqTargetInfo is not configured and if the UE detected IDC problems during the last logging interval:","paragraph_zero_based":5815},{"literal_text_all_w_t_and_m_t":"4>if measResultServingCell in the VarLogMeasReport is not empty:","paragraph_zero_based":5816},{"literal_text_all_w_t_and_m_t":"5>include inDeviceCoexDetected;","paragraph_zero_based":5817},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging from the next logging interval;","paragraph_zero_based":5818},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5819},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging;","paragraph_zero_based":5820},{"literal_text_all_w_t_and_m_t":"3>set the relativeTimeStamp to indicate the elapsed time since the moment at which the logged measurement configuration was received;","paragraph_zero_based":5821},{"literal_text_all_w_t_and_m_t":"3>if location information became available during the last logging interval, set the content of the locationInfo as in 5.3.3.7:","paragraph_zero_based":5822},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":5823},{"literal_text_all_w_t_and_m_t":"4>set anyCellSelectionDetected to indicate the detection of no suitable or no acceptable cell found;","paragraph_zero_based":5824},{"literal_text_all_w_t_and_m_t":"4>if the reportType is set to eventTriggered in the VarLogMeasConfig; and","paragraph_zero_based":5825},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN at the time of entering the any cell selection state is included in plmn-IdentityList stored in VarLogMeasReport; and","paragraph_zero_based":5826},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the last suitable cell that the UE was camping on is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":5827},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last suitable cell that the UE was camping on;","paragraph_zero_based":5828},{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last suitable cell the UE was camping on;","paragraph_zero_based":5829},{"literal_text_all_w_t_and_m_t":"4>else if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":5830},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last logged cell that the UE was camping on;","paragraph_zero_based":5831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8537207a036ea18277478522f3b565985c9a73adcb32f424dc8799501a733bac","18bd40cda2e5a281051cb3ce09f9c23d78ed1e3c443511070b25175cf857bbc4","e2a883d056f0911f60d2f7c09b43b3e6b91d12e484433bc564060c7cef29b2ee","4ea7b0d845aa1f917f83b4f9a2b0fb22787281c20a2aa63768c450d40c222e40","9caa9ab47e5d3c02190b2b177e912cf0900a6585f45b31a7ef686fa59650052c","2c3a06728289bd02abe4f43c4e1f7d223fee150bc32f4267face36a17b3a11aa","742f6b3129088ff9ea92137a3a494e57703b7f6fbef6872712bf2c15dfd4c450","152cfefd2a25fc3778bff685ef1bbe36027e800c715da0d0df653be89a3c0fea","326262cfc58214e6e2caa4474d3de741b9b13391ec37023ee5525bc8be1c1ed0","83a28bd83984069fcd0a221c5bda943af060d4dcd55039d41aac1844d5e8525f","5ef8543d12d4465b51956cfba459a229d591de4b0cd4411c0a7097976eb5ebbb","38d7a8607819c8c770b4c24e1a27a6592ad2fd482a614992be8ad072e94fd377","18136e9a8c22f960760b8dad26a4aff68fd326ea5166a8a7fc1ab594fa78f000","9bfe9e0052f8cc6c0d06e61ff728967470fd07fe85bb8600cc5a2e20d8ca7441","15fe6fa7480763b303f3c4fcb72332c78b51ab685a3d2b43db17b8dba2f4bf48","7539c32c03e0642e00129b5001576b14d4741c84967cc07b955f64f0ccb02988","9e59ea4f94eb139a2aeb5cee943220681ec344887a10e13ede427c666f428af8","b7b02dfdf7fdb8c9c9d9c0a43414fdf0d8a8d16cb7a30224cd204bd955187096","b443fb006a47c92f10b7512ce8e4c27af099fdea8208943bb169c71bf9a19860","ce4c97eb889825c3d68edd5f0cb5e34aa2fde7c3cd2471073975869f13f1c617","24bddfda2e7c75a7a825aeb2fea991b03f268d8edabf6a787551a8c30cfcd5bd","8d4908a9ea356f00d55ae5701bf2f56db2f3c76e0efd59ddff7c8b74f6129d62","5435234669952815f257ccb35463ffba1ab610c99c4281df246c71911e0f1814","143caef791649a8004bbf66bd690747c11af3523380623f9a4df7344100742ce"],"paragraph_range_zero_based":[5808,5831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5808"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last logged cell the UE was camping on;","paragraph_zero_based":5832},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5833},{"literal_text_all_w_t_and_m_t":"4>set the servCellIdentity to indicate global cell identity of the cell the UE is camping on;","paragraph_zero_based":5834},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the quantities of the cell the UE is camping on;","paragraph_zero_based":5835},{"literal_text_all_w_t_and_m_t":"3>if available, set the measResultNeighCells, in order of decreasing ranking-criterion as used for cell re-selection, to include measurements of neighbouring cell that became available during the last logging interval and according to the following:","paragraph_zero_based":5836},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 6 neighbouring cells on the NR serving frequency and for at most 3 cells per NR neighbouring frequency and for the NR neighbouring frequencies in accordance with the following:","paragraph_zero_based":5837},{"literal_text_all_w_t_and_m_t":"5>if interFreqTargetInfo is included in VarLogMeasConfig:","paragraph_zero_based":5838},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":5839},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and either in measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":5840},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":5841},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and SIB4;","paragraph_zero_based":5842},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5843},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":5844},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in either measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":5845},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":5846},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in SIB4;","paragraph_zero_based":5847},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 3 neighbours per inter-RAT frequency in accordance with the following:","paragraph_zero_based":5848},{"literal_text_all_w_t_and_m_t":"5>if earlyMeasIndication is included in VarLogMeasConfig:","paragraph_zero_based":5849},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT neighbouring frequencies that are included in either measIdleCarrierListEUTRA (within the VarMeasIdleConfig) or SIB5;","paragraph_zero_based":5850},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5851},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT frequencies that are included in SIB5;","paragraph_zero_based":5852},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":5853},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE includes the latest results of the available measurements as used for cell reselection evaluation in RRC_IDLE or RRC_INACTIVE, which are performed in accordance with the performance requirements as specified in TS 38.133 [14].","paragraph_zero_based":5854},{"literal_text_all_w_t_and_m_t":"NOTE 2:For logging the measurements on frequencies (indicated in measIdleCarrierListNR/ measIdleCarrierListEUTRA) in the logged measurement, the qualityThreshold in measIdleConfig should not be applied, and how the UE logs the measurements on the frequencies is left to the UE implementation.","paragraph_zero_based":5855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8b1104843883bb2b0e29f0112938628b8c8350387c95c9c9f2ec988c866b78d1","c65c451cb90892fd7805ba0a9ce32a9d68d554d857dd8794854a2e9ac10fc3df","894de8d226b1c9fabd81767ee7988a0791865b917a14a3a60cc3f80fe197a412","e869b0237d86b2ccfbe6221ba13369b021e3b92c5b802780765a30fa8fb9a0db","a0088bfc6263cb659ce32aa9dca1a56a94c4d1a8a46fc0206e022d9640ee7fb0","3083c56c90b9f61c112a5f06410c557e29d724a491efc7553113c0f9ba27322a","74c8e27cd672b475968e68aafc666f72183152099d86159e342413c1270c0ba8","83761ccafca63804419f7b98d76137f5b97bbd9a9c0e8d4a4674d3840db199a8","8204c84f8ae861ed755b104c5efd4d6bb8696161a26a51385fa7ccb6ea95be46","00e8f016c059e6b8eb47128113d91b641ce31d790934a706ed9795eb653de414","c1b3d04436a974003896a8527bc602915e02405ea727cf11f5c61215c8eedb5a","305557bdbf63a5c16148e3e4635e2784a7602ee7bd0742d7806a2173a9f3d52b","16562a14b93dca8d5b7839b7cc35995fbbb165ff36762dd12a55a669e03009cc","7d28a97268ddc6c55606c596cae04ee9f67980e0986544117dfbf783d16c38eb","e41f8720d9d28fee7828cf0c71d10f55b2a143d4f6164f50671bed4bb32e3a5b","da3d78bf400b4b47a1dbf86492d301a3e9bac4c20330d4b7813c31831faf92e6","fba886cf714082dbc9e875c40482d1f1233229e1fde3ea08c4b998799a3d4bef","26c24057e3dc2a355c3d2964fd0087e9ee550f4f58079509fb54b023d071166d","5011cd5113134d0129e8ecb42f22b5f5a57a7fd88c0123dfe1de6141eaaa4e15","340536e30ba18c87a1d50c47b81226323b5f5059990ac9aa79f7bf75231ddf14","1ad7b4dfa00899dd5dc292d51bfcb1e23f5607b668440e0363dfc3db31e72b09","8a8ad9f43eddb38682821ceaf141e7bfde97dd3deddfefb8b873f01f15f54b07","8b2a52f8b8e7ab441a864a6036b4bc6a802daa378bd9101cedd313b6073dde20","714bc200998d598f006043803dee24669e03a34e41784fc062021239dae119e3"],"paragraph_range_zero_based":[5832,5855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5832"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>when the memory reserved for the logged measurement information becomes full, stop timer T330 and perform the same actions as performed upon expiry of T330, as specified in 5.5a.1.4.","paragraph_zero_based":5856},{"literal_text_all_w_t_and_m_t":"5.6UE capabilities","paragraph_zero_based":5857},{"literal_text_all_w_t_and_m_t":"5.6.1UE capability transfer","paragraph_zero_based":5858},{"literal_text_all_w_t_and_m_t":"5.6.1.1General","paragraph_zero_based":5859},{"literal_text_all_w_t_and_m_t":"This clause describes how the UE compiles and transfers its UE capability information upon receiving a UECapabilityEnquiry from the network.","paragraph_zero_based":5860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5861},{"literal_text_all_w_t_and_m_t":"Figure 5.6.1.1-1: UE capability transfer","paragraph_zero_based":5862},{"literal_text_all_w_t_and_m_t":"5.6.1.2Initiation","paragraph_zero_based":5863},{"literal_text_all_w_t_and_m_t":"The network initiates the procedure to a UE in RRC_CONNECTED when it needs (additional) UE radio access capability information. The network should retrieve UE capabilities only after AS security activation. Network does not forward UE capabilities that were retrieved before AS security activation to the CN.","paragraph_zero_based":5864},{"literal_text_all_w_t_and_m_t":"5.6.1.3Reception of the UECapabilityEnquiry by the UE","paragraph_zero_based":5865},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of UECapabilityInformation message as follows:","paragraph_zero_based":5866},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to nr:","paragraph_zero_based":5867},{"literal_text_all_w_t_and_m_t":"2>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-NR-Capability and with the rat-Type set to nr;","paragraph_zero_based":5868},{"literal_text_all_w_t_and_m_t":"2>include the supportedBandCombinationList, featureSets and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":5869},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra-nr:","paragraph_zero_based":5870},{"literal_text_all_w_t_and_m_t":"2> if the UE supports (NG)EN-DC or NE-DC:","paragraph_zero_based":5871},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-MRDC-Capability and with the rat-Type set to eutra-nr;","paragraph_zero_based":5872},{"literal_text_all_w_t_and_m_t":"3>include the supportedBandCombinationList and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":5873},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra:","paragraph_zero_based":5874},{"literal_text_all_w_t_and_m_t":"2>if the UE supports E-UTRA:","paragraph_zero_based":5875},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a ue-CapabilityRAT-Container of the type UE-EUTRA-Capability associated with the terrestrial network and with the rat-Type set to eutra as specified in TS 36.331 [10], clause 5.6.3.3, according to the capabilityRequestFilter, if received;","paragraph_zero_based":5876},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to utra-fdd:","paragraph_zero_based":5877},{"literal_text_all_w_t_and_m_t":"2>if the UE supports UTRA-FDD:","paragraph_zero_based":5878},{"literal_text_all_w_t_and_m_t":"3>include the UE radio access capabilities for UTRA-FDD within a ue-CapabilityRAT-Container and with the rat-Type set to utra-fdd;","paragraph_zero_based":5879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["71e8e2b26f6021926b7c0dabe87e11b376950d6784c20a2e341456682221b32d","ca4262c487d8ef0acee829e1251aa53bf4b4f1582f6d1d7bb6edd6db0f180b2f","a4b5e0953f1f56dff12956bf822d8be7ee795c891a1956992e82926a17a40e86","9ac54214cf9f96e92f9a921ae6ac81d02e12f6a8a7b5c20630b83e68bb9f3df8","6066a8873ce8bf54aff40881aeb9bccc7a847a88266aa1fd0e24c4ff823a6160","ad7d1d0055103d4662d8f6a4cac9cfcadd9059e01893d2b246ec41b0be29a1f8","9d3c199579955817ad2d5dcfaa565f4622d8f6380802d93265d3f29a5eddd23c","e8c75fd562e69ab2bce286d0c9fb5b807032a764e802ac27895bd847cfa4f4a6","28fd7e7e4c6c6f9384a35cf9cdd2e8d33ff9ad0e29588d2796d801fd7726b366","9d3ef5b6a26e797e286441bac04353e553adc674c14dbb708df423cc08e27fad","b7ad3a48bf0d0c6e3e1aa5d7cbcc2ed48a3c8d94c436d437c35ae2bb28b16016","d6f0520879473742d9980d9ea8e6ae7ff9e32fc6bf9a1f108617ac9d55d9cf3b","5bbd0f53e6c736a9c79570140eac2a294425d9cb617b2d4785f90aa6dee0b9e3","8ed4da9a14a2ecb12064ea0564331350313961e0a6422547735b18ca0890eb2a","7a2dc73ffa525be8b56df0668a76903c479c0cc1da45dbe1d60b09d9187a2afa","789dd6c027aaa84717f2a529ce4af9c3824aab16407dde760f1345862649c154","ce0f4e1cafac286035f8d32dcdae265fd88291f14799ceae616e3b2d4d861099","7dbf5d38b85376321ca7dfbacc99f477f2fc0dfd196cb6f247894438d06ac4b9","3734dfd383a3d5d17efa84bdee5f4bd9b5262a5d80cd22832cd8942d408334f0","1941a9a7356a245bbce378dc765520a0e9bcf5ed6237b0100abdb13638f468a6","5b9a6b9dc8c0c4fd032821ba1ab8787bf489a70dd186af0f1c6e1e71ec00da4d","7b7c10044476e32bcbc83dbb7d89add556548e0ec887546a3f99ef0c50ff2b27","df2e474398301a177c6c0a1e9b53c87af0228ad7e49a065c618bfd7c3a67fd69","280a1bf28b699cc9c63f4872ddb72fff38938b269ec2ebffb0067e998374f6ad"],"paragraph_range_zero_based":[5856,5879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5856"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the RRC message segmentation is enabled based on the field rrc-SegAllowed received, and the encoded RRC message is larger than the maximum supported size of a PDCP SDU specified in TS 38.323 [5]:","paragraph_zero_based":5880},{"literal_text_all_w_t_and_m_t":"2>initiate the UL message segment transfer procedure as specified in clause 5.7.7;","paragraph_zero_based":5881},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5882},{"literal_text_all_w_t_and_m_t":"2>submit the UECapabilityInformation message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":5883},{"literal_text_all_w_t_and_m_t":"5.6.1.4Setting band combinations, feature set combinations and feature sets supported by the UE","paragraph_zero_based":5884},{"literal_text_all_w_t_and_m_t":"The UE invokes the procedures in this clause if the NR or E-UTRA network requests UE capabilities for nr, eutra-nr or eutra. This procedure is invoked once per requested rat-Type (see clause 5.6.1.3 for capability enquiry by the NR network; see TS 36.331 [10], clause 5.6.3.3 for capability enquiry by the E-UTRA network). The UE shall ensure that the feature set IDs are consistent across feature sets, feature set combinations and band combinations in all three UE capability containers that the network queries with the same fields with the same values, i.e. UE-CapabilityRequestFilterNR, UE-CapabilityRequestFilterCommon and fields in UECapabilityEnquiry message (i.e. requestedFreqBandsNR-MRDC, requestedCapabilityNR, eutra-nr-only flag, and requestedCapabilityCommon) as defined in TS 36.331, where applicable.","paragraph_zero_based":5885},{"literal_text_all_w_t_and_m_t":"NOTE 1:Capability enquiry without frequencyBandListFilter is not supported.","paragraph_zero_based":5886},{"literal_text_all_w_t_and_m_t":"NOTE 2:In (NG)EN-DC, the gNB needs the capabilities for RAT types nr and eutra-nr and it uses the featureSets in the UE-NR-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the NR UE capabilities for the supported MRDC band combinations. Similarly, the eNB needs the capabilities for RAT types eutra and eutra-nr and it uses the featureSetsEUTRA in the UE-EUTRA-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the E-UTRA UE capabilities for the supported MRDC band combinations. Hence, the IDs used in the featureSets must match the IDs referred to in featureSetCombinations across all three containers. The requirement on consistency implies that there are no undefined feature sets and feature set combinations.","paragraph_zero_based":5887},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the UE cannot include all feature sets and feature set combinations due to message size or list size constraints, it is up to UE implementation which feature sets and feature set combinations it prioritizes.","paragraph_zero_based":5888},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5889},{"literal_text_all_w_t_and_m_t":"1>compile a list of \"candidate band combinations\" according to the filter criteria in capabilityRequestFilterCommon (if included), only consisting of bands included in frequencyBandListFilter, and prioritized in the order of frequencyBandListFilter (i.e. first include band combinations containing the first-listed band, then include remaining band combinations containing the second-listed band, and so on), where for each band in the band combination, the parameters of the band do not exceed maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL, maxCarriersRequestedUL, ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":5890},{"literal_text_all_w_t_and_m_t":"1>for each band combination included in the list of \"candidate band combinations\":","paragraph_zero_based":5891},{"literal_text_all_w_t_and_m_t":"2>if the network (E-UTRA) included the eutra-nr-only field, or","paragraph_zero_based":5892},{"literal_text_all_w_t_and_m_t":"2>if the requested rat-Type is eutra:","paragraph_zero_based":5893},{"literal_text_all_w_t_and_m_t":"3>remove the NR-only band combination from the list of \"candidate band combinations\";","paragraph_zero_based":5894},{"literal_text_all_w_t_and_m_t":"NOTE 4:The (E-UTRA) network may request capabilities for nr but indicate with the eutra-nr-only flag that the UE shall not include any NR band combinations in the UE-NR-Capability. In this case the procedural text above removes all NR-only band combinations from the candidate list and thereby also avoids inclusion of corresponding feature set combinations and feature sets below.","paragraph_zero_based":5895},{"literal_text_all_w_t_and_m_t":"2>if it is regarded as a fallback band combination with the same capabilities of another band combination included in the list of \"candidate band combinations\", and","paragraph_zero_based":5896},{"literal_text_all_w_t_and_m_t":"2>if this fallback band combination is generated by releasing at least one SCell or uplink configuration of SCell or SUL according to TS 38.306 [26]:","paragraph_zero_based":5897},{"literal_text_all_w_t_and_m_t":"3>remove the band combination from the list of \"candidate band combinations\";","paragraph_zero_based":5898},{"literal_text_all_w_t_and_m_t":"NOTE 5:Even if the network requests (only) capabilities for nr, it may include E-UTRA band numbers in the frequencyBandListFilter to ensure that the UE includes all necessary feature sets needed for subsequently requested eutra-nr capabilities. At this point of the procedure the list of \"candidate band combinations\" contains all NR- and/or E-UTRA-NR band combinations that match the filter (frequencyBandListFilter) provided by the NW and that match the eutra-nr-only flag (if RAT-Type nr is requested by E-UTRA). In the following, this candidate list is used to derive the band combinations, feature set combinations and feature sets to be reported in the requested capability container.","paragraph_zero_based":5899},{"literal_text_all_w_t_and_m_t":"1>if the requested rat-Type is nr:","paragraph_zero_based":5900},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList as many NR-only band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5901},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5902},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":5903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0ad315146d78a3e9095884f785d7b4701e06d7a09b6b1256a75625c47d2301cb","8509694509fb4078bdb31a9a786f84e00112d004db09343e3123966b5b2c6805","8802e561da6824150a18246958a9b8fab2bb70b12ae457f39daa4f76f5a73d52","e0da6e60775ee1155a596d6e13fab5129332c4a67da149b4934ddf3ec2884eb2","855ddf03522ea3d31a61f9db7128a86d4cd4894cadda037b3961971639ef34d2","39a4462791190902aaebb1f6a404b85c83451246d2169b7509aff3cdcfa762de","2efcf3b4f8168923f4bc0ec29d8f6be9848e5ff23277aa264ae219cac50ac704","45e458515e7badc28cab4cb06f14cba08ffc5bd15e1643b7d37c1f189e9e8321","2fc366061b04203fa7fc0a7959a25f485a9b51b09803609ab1f2bdc52f047f39","7e95b7c5e4fe13318e62e0f6981d607e81b5d97255612cc03a3d1a81ebf421fb","19b0fe30175ca2b21fee1cf88d56fecb8403789fb7c1be381cdfcce38ebbdff7","d0923aab3723dc7dd9518dedee0ee479fca6c838d212741af855e5288caba17b","746fd744daad3d85d313c151de65737ae65d2bb31303b7395727f727e7f7064f","b3125b160dd0c9464cd6a082377967c6a5530bc963e7e0a8647c1316e9deb0b3","f470ef9f32e74870f70486edaf2940b7be6da7328938df022aa95483cc4ae941","ac6ad520b08237f25d175f45dcb99a511561e46a737717a2a4e1ab52af091461","2654cd5d7f7a15eec096f7c625635029a3a6eb0f6f7b479e0a235b00d3ce5cc6","22dfa1405c80c6760b6001587955d5e3c0fc2bddd6af138ae65845ddff21ccb4","0edd503757a7dfad50232b8cebd085814aadbccf29e5c925f8f926392da29469","5e2a2490825f8554e1d9211a3c635c2a791d369fc5d54a3f221502509119bb02","1642fd2eb37279db9713a858829bb356fb5d2282e42252bb385bf12d19a4cf1e","49e2d0dec2b6d874fab0088cd2d8183469da5ea3ee0026e700aebeefa3b77f26","26c7a8999a1ef08e6ad3afa6f66fb96c83b103e8169e333e8d59426d40e99c97","fee42b090f37de5957ef611bb8a19a0ba4f4baccfbfd8c2e9fb6f9a8cc6d1a8a"],"paragraph_range_zero_based":[5880,5903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5880"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5904},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5905},{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":5906},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":5907},{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":5908},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many NR-only band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5909},{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5910},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":5911},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5912},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5913},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":5914},{"literal_text_all_w_t_and_m_t":"NOTE 6:This list of \"candidate feature set combinations\" contains the feature set combinations used for NR-only as well as E-UTRA-NR band combinations. It is used to derive a list of NR feature sets referred to from the feature set combinations in the UE-NR-Capability and from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":5915},{"literal_text_all_w_t_and_m_t":"2>if sidelinkRequest is received:","paragraph_zero_based":5916},{"literal_text_all_w_t_and_m_t":"3>for a sidelink band combination the UE included in supportedBandCombinationListSidelinkEUTRA-NR, supportedBandCombinationListSL-RelayDiscovery or supportedBandCombinationListSL-NonRelayDiscovery:","paragraph_zero_based":5917},{"literal_text_all_w_t_and_m_t":"4>if the UE supports partial sensing for a band of the sidelink band combination, include the partial sensing capabilities for the band using the sl-TransmissionMode2-PartialSensing-r17;","paragraph_zero_based":5918},{"literal_text_all_w_t_and_m_t":"3>set sidelinkRequested to true;","paragraph_zero_based":5919},{"literal_text_all_w_t_and_m_t":"2>include into featureSets the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed any of maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL or maxCarriersRequestedUL, whichever are received;","paragraph_zero_based":5920},{"literal_text_all_w_t_and_m_t":"1>else, if the requested rat-Type is eutra-nr:","paragraph_zero_based":5921},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only as many E-UTRA-NR band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5922},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5923},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":5924},{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5925},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5926},{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":5927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b281189ecc7c7ff7487267ced225de7c2973ac3c01175cc83bc08389d01ce9dd","a751a8a465b6f8c4fbbd1e7492d8f32add5e51799abd4b1493442334b5e80dad","8d0740fff9488e6d361bce2cab70ffdeba5de70691b046b74007d9ed19e41e8f","3680f49af7e226e53d067c2b3fa1e4fe86267ef7bf0f2ae7472c1026e79ea39b","5cd8d4c0aaabc189efb3951928380115b5c6cfcbc63c1068cc98be8a9cf68874","c34c0c6d3c282cc875260209908c320ac3fc311176e07c358d97eb70715cd415","d0ff603f0334978e8ae5a86dcdaca3b704feab78300e4db49056b329c69b8174","8c4b3b511fee308e1a46e9849e6f60f072379abaf8499cbde58f466ef1dfd451","a64b96036a7624d39734432587ede80abf9890fae838f0fa7fa10b0cffd19706","84e65bdc6d93592860f1beb5573b40016eb2649b8c8cfeca154e5d7b0c7e5356","00b47f4758e8049975136f1a49f917162a5ec28bc33c6672fe0348fc946c92fb","0f7b8f9dc55c4969fe97a0922b51e127d69c2069ad359e07d9871f123be989c1","82d07872a539875bca5a14e252272404d58e18d70e45424a8ba3b828f0b21ea9","16844b062608ae8a4e0cbdaca6db50554327655959b0a6ed3bcc51371beb1925","0f90633f43e4caa41716787a7db9526e59a4b398cb4b28dc1f77cdf3534b41a8","399ef3fb6cad58ce2c9f096d22c1bbc0fdf85b4ec8de709cf81fea350d5f6f6d","82f8f3567c7acef57cdcb595a3f4eb9960e5a2b6532f2e051aba37168874e805","78e9c2688342744446de584438d5ebc2e05e2b3a9f7f4fb57e36e3b6b4c6ef84","11545380d33a18cd0e2510f8dad1e86974e84c3ff829441c444327e3ed6cd22d","c64cb1b8a144f3d29e5d1041be1b73d60d4ffa61caec0c85effcd0bd0998d43a","22989d2b96190a11c99056588275598142ad21e77e40af9a75e6d60e7bc861bc","3e42bc7f2b864b598497161e1affa9fa37624043cca4e7876a4e898b10f241a8","831f887c33da5bb81ea9f5b808742a39a69a7b09e690be9cdc92f0d762609b3a","20b066bbab6ca25a8ff89138b750a108206fb9c9298dfd0fa6496054fd6e51fb"],"paragraph_range_zero_based":[5904,5927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5904"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":5928},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many E-UTRA-NR band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":5929},{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":5930},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":5931},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":5932},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":5933},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":5934},{"literal_text_all_w_t_and_m_t":"1>else (if the requested rat-Type is eutra):","paragraph_zero_based":5935},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":5936},{"literal_text_all_w_t_and_m_t":"NOTE 7:This list of \"candidate feature set combinations\" contains the feature set combinations used for E-UTRA-NR band combinations. It is used to derive a list of E-UTRA feature sets referred to from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":5937},{"literal_text_all_w_t_and_m_t":"2>include into featureSetsEUTRA (in the UE-EUTRA-Capability) the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":5938},{"literal_text_all_w_t_and_m_t":"1>include the received frequencyBandListFilter in the field appliedFreqBandListFilter of the requested UE capability, except if the requested rat-Type is nr and the network included the eutra-nr-only field;","paragraph_zero_based":5939},{"literal_text_all_w_t_and_m_t":"1>if the network included ue-CapabilityEnquiryExt:","paragraph_zero_based":5940},{"literal_text_all_w_t_and_m_t":"2>include the received ue-CapabilityEnquiryExt in the field receivedFilters;","paragraph_zero_based":5941},{"literal_text_all_w_t_and_m_t":"5.6.1.5Void","paragraph_zero_based":5942},{"literal_text_all_w_t_and_m_t":"5.7Other","paragraph_zero_based":5943},{"literal_text_all_w_t_and_m_t":"5.7.1DL information transfer","paragraph_zero_based":5944},{"literal_text_all_w_t_and_m_t":"5.7.1.1General","paragraph_zero_based":5945},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5946},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1.1-1: DL information transfer","paragraph_zero_based":5947},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from NG-RAN to a UE in RRC_CONNECTED or to a UE in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB Donor-CU to IAB-DU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":5948},{"literal_text_all_w_t_and_m_t":"5.7.1.2Initiation","paragraph_zero_based":5949},{"literal_text_all_w_t_and_m_t":"The network initiates the DL information transfer procedure whenever there is a need to transfer NAS dedicated information, or F1-C related information to an IAB-node. The network initiates the DL information transfer procedure by sending the DLInformationTransfer message.","paragraph_zero_based":5950},{"literal_text_all_w_t_and_m_t":"5.7.1.3Reception of the DLInformationTransfer by the UE","paragraph_zero_based":5951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["05a234ae368ca1fb94b3a82f7552317ea035eef226b12c1f31496916100a9c71","b361a8989fd06b2c0261b8ab146d774d4cb771b0a7c7c2dc02dc11c5a93251ba","bbf834cce8fdf26f0e82f06a3297bb6c7e8c3c7d65f2595b6b1cb00e8c8dc2d3","395021c6d729369489edfbf4ab8d3957e93666eaff311f548afb30bc4dfee927","b34aef557c96d60ed67516de2e3436d544ee309a7afdd502e940e850140a7771","2f542d3ab85c51058120b3add2dd9ea1bfc36146e781b01b32e8a1a01cd557d7","ec4fd1b05ddc7d84700225b66fa5cfee9f6e7d310ca69f46672601c83a3b7a7a","1be9cb62b71156fa95f8f28ae8a1bf91f8ac271dc6bee9f1e903626793330b2d","5a72156331a95b9248208b087bc5b638f2f9a5f40301ed1da9215db91ba815ef","8854056fb9db2e2e54cfcf3286b122bca0660cbca6d2d463365bae9406ac7529","80a397fb3307f4d674c13b8df63f6a0102da050e5edbd86b66f5f1b8b072aff9","a077b57bc0e18c257ff08e7a122db64d86634c6c487717b91f6c3391f4a70343","b98c7cbe5aaed32e48ed6bf31e8e100809849418ed195d6c296f71c367033aef","bec6f4f3160d0621f687354fcad0606e438a36d2e4cbf4ba249aeb2c5e02bd11","b0ba436a70abd0ad24eee189736c44ad7ae2320d70b54618ca66e64dc37b0d46","eade6fa02f42301e04523afb2e0ba88d649329890391276dfcaa626bb1d36ba2","9406edee9b86f4eea4b9de9625aacd1f7b051bab12d022e706586eac894a60e0","acb5ef65633b2ec2aa478136d2a36540cf9f719e6559f6b922d78d79c97c063a","507e42b89082526681c2a1af6216cb3c9859b83760fda93f0f0469f4e0019654","ffd9c078a71abcc14ab22de933918a936f45310513fc3d9e107a8e7aa9eef987","3e8cbcf5db31487e609383d2fded4ef38dd4c7006bbf7eab47f1d65df9db86a9","9859cd51d36f1a072099fc9bc49208e0b7ab3b4b8b9fe8472136820c8074d410","a0e0bc0b092918b89609ff384357b756589acf4deae79c28675c9559664c954b","b0df97c62bfa466cdd00e15594e3f48613a27f32d7c0346ee7746a8b44190a27"],"paragraph_range_zero_based":[5928,5951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5928"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the UE shall:","paragraph_zero_based":5952},{"literal_text_all_w_t_and_m_t":"1>if dedicatedNAS-Message is included:","paragraph_zero_based":5953},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedNAS-Message to upper layers.","paragraph_zero_based":5954},{"literal_text_all_w_t_and_m_t":"1>if referenceTimeInfo is included:","paragraph_zero_based":5955},{"literal_text_all_w_t_and_m_t":"2>calculate the reference time based on the time, referenceSFN and timeInfoType if it is included;","paragraph_zero_based":5956},{"literal_text_all_w_t_and_m_t":"2>calculate the uncertainty of the reference time based on the uncertainty, if uncertainty is included;","paragraph_zero_based":5957},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the reference time and, if uncertainty is included, of the uncertainty;","paragraph_zero_based":5958},{"literal_text_all_w_t_and_m_t":"2>ignore all further referenceTimeInfo received in SIB9, if any.","paragraph_zero_based":5959},{"literal_text_all_w_t_and_m_t":"1>if sib9Fallback is included:","paragraph_zero_based":5960},{"literal_text_all_w_t_and_m_t":"2>apply referenceTimeInfo in SIB9.","paragraph_zero_based":5961},{"literal_text_all_w_t_and_m_t":"1>if rxTxTimeDiff-gNB is included:","paragraph_zero_based":5962},{"literal_text_all_w_t_and_m_t":"2>calculate the propagation delay based on the UE Rx-Tx time difference measurement and the received Rx-Tx time difference measurement at the gNB;","paragraph_zero_based":5963},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay.","paragraph_zero_based":5964},{"literal_text_all_w_t_and_m_t":"1>if ta-PDC is set to activate:","paragraph_zero_based":5965},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay determined by the accumulated Timing Advance commands.","paragraph_zero_based":5966},{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the IAB-MT shall:","paragraph_zero_based":5967},{"literal_text_all_w_t_and_m_t":"1>if dedicatedInfoF1c is included:","paragraph_zero_based":5968},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedInfoF1c to the collocated IAB-DU.","paragraph_zero_based":5969},{"literal_text_all_w_t_and_m_t":"5.7.1aDL information transfer for MR-DC","paragraph_zero_based":5970},{"literal_text_all_w_t_and_m_t":"5.7.1a.1General","paragraph_zero_based":5971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5972},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1a.1-1: DL information transfer MR-DC","paragraph_zero_based":5973},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer RRC messages from the network to the UE over SRB3 (e.g. an NR RRC reconfiguration message including reconfigurationWithSync, an E-UTRA RRC connection reconfiguration message including mobilityControlInfo, an RRC connection release message, a MobilityFromNRCommand message, or a MobilityFromEUTRACommand message) during fast MCG link recovery.","paragraph_zero_based":5974},{"literal_text_all_w_t_and_m_t":"5.7.1a.2Initiation","paragraph_zero_based":5975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fffc5065242341c69dc3f149247452deab510260123867fcd8a595ea2e40e4f4","26d60b79923cb208ba305325961e3b3b17cce12564c13d043f44583b6f35c5f6","e04605f31830899cb671adec82b80d3dd02a3ab4eeb1695621dd2121f583b214","45b8bce45f47b81fa88c8ff763027e4805d45f6af0e1003887c6954c11e3b50c","51547bf1009f82076c86ee3ba39d0e2c57c66206b70f907f0670d29a8d1b6653","75c62abab17c8ca6215aee5da54c2bc0847249ddf14afbfeaaed00f7c726c06a","cc44113e6e8580d1c7c2e273b48cd3b89a9e9d27dea187f3bd920a9c0a1db4da","b630c177b3c8eaeee76dd06e9a54c9e273dd75f2ffa549a44b41e527458aba8e","b96c8397a5a95512a9cd4505183b89d8cd6a1191628df7fcf851e61c0df886a3","9ed2d0e7d355a4f3c686db2e360623601cbeeb8c34effaf24d9a2a1bfc0b7ad1","d136237e3dcd1e0685bc4dfb0bd1d209106162240ab2f80798b2fc3f6b2032b4","0640650a06bece4f59dae736590357a3ca528d8bb26bbea0e5f9309927266930","c102e136a1b546550d8cf57710ae6044337c3ef2f1b37e48b62ab927ba5fdab6","64bd1bc9bc60f3121dbdc075ebcf3e14137f8a978ce631688690c573d4797552","6f92c207572e5380851190ea594e3d644480eb8fedf3e845b5e240590cfab613","e67aa1b25dcdc557fae64d69b5ca17e2a4003a9aedc0fcf6ba18b52f2b3e0ffb","de400674f8e1123ad42e42d7179c3d3955561be4c6461a9501bfda11fa1e8b61","cf5200aacced6fec895f970ee7eed0112138cf33ee5f056c8dd7616cf5bf0c7e","59c1f95e8e8cd87464926809a5025496cd761f04ae670df39a1ba8720f22f28f","66d56d2d5800d8ff8ad923094b56df4c4a0372c1f582e78b0a42514989fc2ed7","42b3f1874e7a4fc1b25f19fabee2568ad0edf1923c9f2c4050413590fc526347","0b030a44d915b11548a2e025a3be3992eb1902ca77c7abba784ba78249e7ebac","0ad8d4a9dcb723a3fe597011b5181e61ffc9f2fa1790db4554999e165248b8bf","4061be4f8381f746287500ef7dc8c6c01b6869b50de4a6818e419e98d9924d0e"],"paragraph_range_zero_based":[5952,5975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5952"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The network initiates this procedure whenever there is a need to transfer an RRC message during fast MCG link recovery.","paragraph_zero_based":5976},{"literal_text_all_w_t_and_m_t":"5.7.1a.3Actions related to reception of DLInformationTransferMRDC message","paragraph_zero_based":5977},{"literal_text_all_w_t_and_m_t":"Upon receiving the DLInformationTransferMRDC, the UE shall:","paragraph_zero_based":5978},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message is included in dl-DCCH-MessageNR:","paragraph_zero_based":5979},{"literal_text_all_w_t_and_m_t":"2>perform the RRC reconfiguration procedure according to 5.3.5.3;","paragraph_zero_based":5980},{"literal_text_all_w_t_and_m_t":"1>else if the RRCRelease message is included in dl-DCCH-MessageNR:","paragraph_zero_based":5981},{"literal_text_all_w_t_and_m_t":"2>perform the RRC release procedure according to 5.3.8;","paragraph_zero_based":5982},{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromNRCommand message is included in the dl-DCCH-MessageNR:","paragraph_zero_based":5983},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from NR procedure according to 5.4.3.3;","paragraph_zero_based":5984},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionReconfiguration message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":5985},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection reconfiguration procedure as specified in TS 36.331 [10], clause 5.3.5.4;","paragraph_zero_based":5986},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionRelease message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":5987},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection release as specified in TS 36.331 [10], clause 5.3.8;","paragraph_zero_based":5988},{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromEUTRACommand message is included in the dl-DCCH-MessageEUTRA:","paragraph_zero_based":5989},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from E-UTRA procedure as specified in TS 36.331 [10], clause 5.4.3.3;","paragraph_zero_based":5990},{"literal_text_all_w_t_and_m_t":"5.7.2UL information transfer","paragraph_zero_based":5991},{"literal_text_all_w_t_and_m_t":"5.7.2.1General","paragraph_zero_based":5992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5993},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2.1-1: UL information transfer","paragraph_zero_based":5994},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from the UE to the network in RRC_CONNECTED or in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB-DU to IAB Donor-CU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":5995},{"literal_text_all_w_t_and_m_t":"5.7.2.2Initiation","paragraph_zero_based":5996},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED or a UE in RRC_INACTIVE during SDT initiates the UL information transfer procedure whenever there is a need to transfer NAS dedicated information. The UE initiates the UL information transfer procedure by sending the ULInformationTransfer message. In addition, an IAB-MT in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer F1-C related information. When F1-C related information has to be transferred, the IAB-MT shall initiate the procedure only if SRB2 or split SRB2 is established.","paragraph_zero_based":5997},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5998},{"literal_text_all_w_t_and_m_t":"5.7.2.3Actions related to transmission of ULInformationTransfer message","paragraph_zero_based":5999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["624640a68c0557391861f7939fe45b1a1c71b0c54391eeac30ca1a0a27890d63","466e8990e741246a8ad2e3b45a67675fd561d5b26f25cb6292d62a3793b53560","249c688765e591bb6638f55a9e6658688a8da17e9002e97054b75ee524f45ba7","c53d9393c40280efee41a6b451e6b11b297407faef7a9c358c5dfdd961c46f0f","c4d04a62207d5640697ea685447e62814f163650f34d53cf79441b7249f3bcfb","8cb6f238559f8613a1cae608c48c53d6a361ffa008ea208ed4db4a9c060d41d1","e9137542ee4fab5b585f03ef2b15bdd8fbcc8d6f9e7485abb6b83ee52eebaf7e","b8b71547d1f9181dc944307113038b8b59fe9b103976ffac1a94f51b5c44d85c","7ba3984abfc899aad32228d5f0d022f31e6d78b2f1b6a2e96e10111dbfb599dc","549f1c68b7dc29193543a98a9f0ebaf81f2c507ef7c5d1c02cd1db01b16b5a4f","3c8e15bdd46b170010e5c298d8800dc3e2c5867ae5b89fc256aa6f336bd79534","5a020c529920d2cdd38aab5ebb4f4d557de4ea5f5af54b2d3c728890f3aabf53","9dd3c8e92fcaa66f1a733f37090adbd62e132469a3a2502bfb8edfa050d44914","2b06c30a6ed77e560d411e6c9c112ff4ea7169ba73a4e15717c0834c829f1005","852b9db8df8b13a645f064b3f224b7f5fe5f9b82ce842c20438de18e8b34403d","3926cb6a42c2f2c31620ad090078066d7cd423eee648121be1d4916f6d9a63d4","54c31336d9ddff1f3b88a445bd85ece955ac9e67ee3b60374f76577739882142","00f9d7e5839868719f8a0b653c08db0ca466f602e1e5db0293764e79d0c7623b","285fb8f1ef4cce3131b7a6afcd87c20e447afd67aa55402abb4121253927c40e","325705481bb88514f548037ea367be5e6496afd485af7c355fd7c886768299c5","9a22ea43a5f75a09f4628ac216b122bc04e1d64e5484e8ba95089dbd1b21e93e","3adf98b5ee21da15e4b60b5e2c4d3352ddf6a091e6b3bf22c9feb77997b4ca6f","f7c065f60f505bd2e832b8a4742ab87171f3c777f4e5c8443be88abdbeb66fb2","a56b7d54ecfc717372686f77ee8f8889541dfebaa08a0f46912bc48b3b351abb"],"paragraph_range_zero_based":[5976,5999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5976"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransfer message as follows:","paragraph_zero_based":6000},{"literal_text_all_w_t_and_m_t":"1>if the upper layer provides NAS PDU:","paragraph_zero_based":6001},{"literal_text_all_w_t_and_m_t":"2>set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":6002},{"literal_text_all_w_t_and_m_t":"1>for the IAB-MT, if there is a need to transfer F1-C related information:","paragraph_zero_based":6003},{"literal_text_all_w_t_and_m_t":"2>include the dedicatedInfoF1c;","paragraph_zero_based":6004},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransfer message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6005},{"literal_text_all_w_t_and_m_t":"5.7.2.4Failure to deliver ULInformationTransfer message","paragraph_zero_based":6006},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6007},{"literal_text_all_w_t_and_m_t":"1>if AS security is not started and radio link failure occurs before the successful delivery of ULInformationTransfer messages has been confirmed by lower layers; or","paragraph_zero_based":6008},{"literal_text_all_w_t_and_m_t":"1>if PDCP re-establishment or release/addition (e.g due to key refresh upon PCell or PSCell change, or RRC connection re-establishment, or failure of resume procedure initiated for SDT) occurs on an SRB on which ULInformationTransfer messages were submitted for transmission but successful delivery of these messages was not confirmed by lower layers:","paragraph_zero_based":6009},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the possible failure to deliver the information contained in the concerned ULInformationTransfer messages, unless the messages only include dedicatedInfoF1c.","paragraph_zero_based":6010},{"literal_text_all_w_t_and_m_t":"5.7.2aUL information transfer for MR-DC","paragraph_zero_based":6011},{"literal_text_all_w_t_and_m_t":"5.7.2a.1General","paragraph_zero_based":6012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6013},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2a.1-1: UL information transfer MR-DC","paragraph_zero_based":6014},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer MR-DC dedicated information from the UE to the network e.g. the NR or E-UTRA RRC MeasurementReport, FailureInformation, UEAssistanceInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message.","paragraph_zero_based":6015},{"literal_text_all_w_t_and_m_t":"5.7.2a.2Initiation","paragraph_zero_based":6016},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer for MR-DC procedure whenever there is a need to transfer MR-DC dedicated information. I.e. the procedure is not used during an RRC connection reconfiguration involving NR or E-UTRA connection reconfiguration, in which case the MR DC information is piggybacked to the RRCReconfigurationComplete message, except in the case the UE executes an intra-SN CPC.","paragraph_zero_based":6017},{"literal_text_all_w_t_and_m_t":"5.7.2a.3Actions related to transmission of ULInformationTransferMRDC message","paragraph_zero_based":6018},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferMRDC message as follows:","paragraph_zero_based":6019},{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer MR-DC dedicated information related to NR:","paragraph_zero_based":6020},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageNR to include the NR MR-DC dedicated information to be transferred (e.g., NR RRC MeasurementReport, UEAssistanceInformation, FailureInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message);","paragraph_zero_based":6021},{"literal_text_all_w_t_and_m_t":"1>else if there is a need to transfer MR-DC dedicated information related to E-UTRA:","paragraph_zero_based":6022},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the E-UTRA MR-DC dedicated information to be transferred (e.g., E-UTRA RRC MeasurementReport, or MCGFailureInformation message);","paragraph_zero_based":6023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8c5c6287efac033752a4f03aaf8a2e88722cd7748a7685841838db8f8a44e28f","b425503d43d7e4ca39d4476f3ae38fc4bcb10723469cbbcef12eded288317672","e50b3270b946a36ac789e96ae783fa6f47c0c7fa43021b0f21516a8857a87b98","8d51483e070841948b1589ef6ed91a3bdf4a085a177f52ccba4344ac7f354bf2","8fb2d2c12051d654d244c510561e28f68d4d039fa31a9473bc737694ae2d1f4b","1c5a3c50467e36589d992f880d02b39a817f826ea4f7dfef427b9176cc3b5e62","d0f24fc3d46a6c933044db73c0b5a9069d00c601764a079a35b2a2025cc0dd79","d7bda69d87516df0888f005c73525a14f8fc6b75e688aa98550deefe4b527d0c","c533c2e3b0819cf401bc0ae460302b397872dccabd413df7a0054af6856304e1","184262073fee0821eba077504c40f25861e1bb965e2b9fc15cbd2f68fd9d7ed1","0a6ba8fa1f95a90ec9adbfb66da57499c88158aba4fb31d0b89b09e04f781ee6","ad9f0ce01bd03458510aacdca260be9586c39f057b514bb6f455f886d44305e7","5db34f0e99e1927bfa312374266ed77bc2c89f25e72198c615d35add64276e1c","61f0e941c281e271171603b3f681b12832f15af54a0390939eba0ea8fd1633ac","ad8e2ea0b57ae243a29dac72d6e4c377c189106de0e6410b2eb921af376725d3","9506a1abec723657b02c3d5f7692ec2348076cf4abf477b531e32115ad43438d","a8e80896b7284fd01aeb5f463620bb9fae0cb181adf00dc86529fbb2868f245e","61745476fca7b14e806b3183aef42b98f504c138985d40e5d0e44a029d1026ef","45e0d5f1a0c5aeaca5901aa0290c7f81ebca4ed5587159b31b22280bed8a4366","1e0102ffad0838a21224607f4b74c70993fe9cb9e714c321375c692a9b232c40","82674330c3ede33f1210fec28e0004783c6fff132bfa1539287eb6a8ad0bc340","bcbce07fa1e614c0dfe2ab5ea604a756b62070e3acdb56d708a70d7c81abdbbc","85087afafcf9cf32026d24e5f6e79474d7f784eb089739b19749d5f413132980","c20d8c2954cba86225ccad6ec2d57946aab1b84dccd9d5490eb632b0ac071379"],"paragraph_range_zero_based":[6000,6023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6000"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferMRDC message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6024},{"literal_text_all_w_t_and_m_t":"5.7.2bUL transfer of IRAT information","paragraph_zero_based":6025},{"literal_text_all_w_t_and_m_t":"5.7.2b.1General","paragraph_zero_based":6026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6027},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2b.1-1: UL transfer of IRAT information","paragraph_zero_based":6028},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer from the UE to NR MCG dedicated information terminated at the NR MCG but specified by another RAT e.g. the E-UTRA MeasurementReport message, the E-UTRA SidelinkUEInformation message or the E-UTRA UEAssistanceInformation message. The specific information transferred in this message is set in accordance with:","paragraph_zero_based":6029},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.6.10 of TS 36.331 [10] for E-UTRA UEAssistanceInformation message;","paragraph_zero_based":6030},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.10.2 of TS 36.331 [10] for E-UTRA SidelinkUEInformation message;","paragraph_zero_based":6031},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.5.5 of TS 36.331 [10] for E-UTRA MeasurementReport Message.","paragraph_zero_based":6032},{"literal_text_all_w_t_and_m_t":"5.7.2b.2Initiation","paragraph_zero_based":6033},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer dedicated inter-RAT information as specified in TS 36.331 [10].","paragraph_zero_based":6034},{"literal_text_all_w_t_and_m_t":"5.7.2b.3Actions related to transmission of ULInformationTransferIRAT message","paragraph_zero_based":6035},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferIRAT message as follows:","paragraph_zero_based":6036},{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer dedicated LTE information related to V2X sidelink communications:","paragraph_zero_based":6037},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the V2X sidelink communication information to be transferred (e.g. the E-UTRA RRC MeasurementReport message, the E-UTRA RRC SidelinkUEInformation message, or the E-UTRA RRC UEAssistanceInformation message);","paragraph_zero_based":6038},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferIRAT message to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":6039},{"literal_text_all_w_t_and_m_t":"5.7.3SCG failure information","paragraph_zero_based":6040},{"literal_text_all_w_t_and_m_t":"5.7.3.1General","paragraph_zero_based":6041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6042},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3.1-1: SCG failure information","paragraph_zero_based":6043},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform E-UTRAN or NR MN about an SCG failure the UE has experienced i.e. SCG radio link failure, beam failure of the PSCell while the SCG is deactivated, failure of SCG reconfiguration with sync, SCG configuration failure for RRC message on SRB3, SCG integrity check failure, and consistent uplink LBT failures on PSCell for operation with shared spectrum channel access.","paragraph_zero_based":6044},{"literal_text_all_w_t_and_m_t":"5.7.3.2Initiation","paragraph_zero_based":6045},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure to report SCG failures when neither MCG nor SCG transmission is suspended and when one of the following conditions is met:","paragraph_zero_based":6046},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure for the SCG, in accordance with clause 5.3.10.3;","paragraph_zero_based":6047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3da34b0f0d4705c95cd8f2572cbf33c8b0885d79a34d9e62e24d0c2033ea46bb","a482bc4e397836e2593a3578c9a0bdf65422fe8f42379c8397bbb7ebafbae53e","b0a8b5df7a6929fa65ddaabada11461fe6167dac00515467fda7c82cfc5e9e67","ff4adc8a4cd88d339198046aec0f434bcae56c1580f883e203d4b80ce100d361","ef469865db9ff5c5982397dec345e867f116ea0eb911661c584b07439f5a485f","bb1cd559392ef27c9b668651b29f851d8f96c67c2b685b6825504b78286db3d0","b6ee2fd44fd35bf09bcffd45730fc4e7e77343408ed95eab41a08fef1e103102","028887bc54874fb051346745ad0feb0c9f3de95166191cd8c8d680c32aeb5822","a869449e011998d00fdaf35a3f46f792cf104751d643d5f26766e8033be7d509","2a413f4197cd2c26599cd2f59d58d6a6489831e3bf90a1e974d2d25baed5d3fc","71fb70f44f3811d94f9d6b4bc196a8ba917edfcd0312128aa5804ed9505e14a7","b86624a35164eb1c9c0bfa549dd0be3b98f9e9676b2c17a07188754bd388b8ce","9ebdee79e3b72d59aa2128b3465f2cdcbe59f54846190f87a81bb199f8d04a8f","3e7990c71d943a9b83ec5dbb4bf0287674c253769dcd241c6b35026a469d97a8","a7a78fd3567d6b00792eafc22a0674fea1a399d4488977fd2dc341e60a73dd01","16cacbc374ae40f3a071c0a20b7b0607724e4d47df44077fbec70fcc04e2f641","81d92984678bbc77fc9629c064ff43fa6a225e205383eca502d8ff4e71a21778","4a0cc21910323f8726736a01e08471516034d2704b1e5646abff3169afe9c309","f611bf6f74f638b0477962402a7c0e11c4f4babd654806c6ad750403051b1da8","59b5c104c97c81cc64d540500010ea2903833a7413c051db071ecaa74a58b9db","1a05bcf32209eb96c00d1af6e8e15d39b07d88dfe03a43d26b2cf53d3a8af4f9","acfbe1c17599f3d0d5d8197d0bb414eaeda7ff0696bf9660789dd8bc7123e119","a00731ee05610ec3d3c42b9249b9e0d200f0fef9bc8bcb4cb17c235f6da48cc0","e83a03641232d3cfe58edee31fa5eb005e6b747a14fbb1ed122203206393178b"],"paragraph_range_zero_based":[6024,6047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6024"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>upon detecting beam failure of the PSCell while the SCG is deactivated, in accordance with TS 38.321[3];","paragraph_zero_based":6048},{"literal_text_all_w_t_and_m_t":"1>upon reconfiguration with sync failure of the SCG, in accordance with clause 5.3.5.8.3;","paragraph_zero_based":6049},{"literal_text_all_w_t_and_m_t":"1>upon SCG configuration failure, in accordance with clause 5.3.5.8.2;","paragraph_zero_based":6050},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from SCG lower layers concerning SRB3.","paragraph_zero_based":6051},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6052},{"literal_text_all_w_t_and_m_t":"1>if the procedure was not initiated due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6053},{"literal_text_all_w_t_and_m_t":"2>suspend SCG transmission for all SRBs, DRBs and, if any, BH RLC channels;","paragraph_zero_based":6054},{"literal_text_all_w_t_and_m_t":"2>reset SCG MAC;","paragraph_zero_based":6055},{"literal_text_all_w_t_and_m_t":"1>stop T304 for the SCG, if running;","paragraph_zero_based":6056},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CPC or CPA, if configured;","paragraph_zero_based":6057},{"literal_text_all_w_t_and_m_t":"1>if the UE is in (NG)EN-DC:","paragraph_zero_based":6058},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformationNR message as specified in TS 36.331 [10], clause 5.6.13a.","paragraph_zero_based":6059},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6060},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformation message in accordance with 5.7.3.5.","paragraph_zero_based":6061},{"literal_text_all_w_t_and_m_t":"5.7.3.3Failure type determination for (NG)EN-DC","paragraph_zero_based":6062},{"literal_text_all_w_t_and_m_t":"The UE shall set the SCG failure type as follows:","paragraph_zero_based":6063},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformationNR message due to T310 expiry:","paragraph_zero_based":6064},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6065},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to T312 expiry:","paragraph_zero_based":6066},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as t312-Expiry;","paragraph_zero_based":6067},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide reconfiguration with sync failure information for an SCG:","paragraph_zero_based":6068},{"literal_text_all_w_t_and_m_t":"2>set the failureType as synchReconfigFailureSCG;","paragraph_zero_based":6069},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide random access problem indication from SCG MAC:","paragraph_zero_based":6070},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["88d81d216b184516a378c36b040220db394e3e7d154e1bbe91a1dfbde890445b","019c4e55e823c30924579a825e4a68840b1144891f7b9ba22c70f7956be63914","ff3fbd80a6863bad5421f8af9410d0380913e1af12806d65cd5f1741a025c279","b14a84725461b891e8d62a2c3a8e09e0bdec68ecce6d0ec883ecd1ff86e620e7","86fef5f22ded3d88d2d9ecf4eec456fa86283d76cb7d9af26823088b6e51b794","28e7a5bcd7f4cb1872d21b37eea8a0e5e0d1cf19cee32a418e60884eedcfdfde","cfbdbad94982830975014b0f5c0ca9c850d282ba4ea7c45bb96dd2116e675238","7be558aa8437d30b72d217a6d984999b15872d04b81b461409338a322cc3d115","1a8075964430703ae1f6a0d2345ca5dd24913f310709fd3309d6ec7908bbf9e6","aee6a47b13d3fcbf8075ad0d93fee39ed30af8f325831db867df960fd9a2f094","eab2e7a95317a4b4b2f9fd2f3329e24e4398883b3d86ac6843bdf4dae4396e27","2c38c82487a502cedf6004590d4eeae3f01d45fc3d94b4973838a96f58c85fe3","26d2b88c6204ccb2f4faf43b6d8e6c0b24f177b47a4142ef0c6899988c01cfac","0de5d94902e74e8e36c6fcb76a90fd78240debcffb6b4b3a5f05165bd0382dd8","5cc7c834bfbb1166da050a52e6a75ac84538c341a29034a8123231c4119c95fc","345e9707457110faca49e1ba078759ac6a7acd9266b1bf3531877762645745fc","0776916380f52a49efa636307f57b2c734f74fca463173442946f9187259a7d9","90fc310339638ec6c08e755d28fd4de7fe21c3e88070a9f237d77ab2b4e27945","c4ada642667a52ddfe72f6d3dc75d640399dc81f58ee943af7e0354f924ab3d9","d44ef14e4b427a1f08009b8137c7ba1e32d6db25e20923d40cf3f8798c2fe44d","5ec7cfb3f3dc2febb244543b87c90558e76cbac40049f1e3ca6d6e6f7e28233b","4747705fc7b3ea035701faf6fb97ab21c1e4970307084ab92b4586d032ca971c","d7940a20a974b4513befdbb53d0033adbbb93cfaf9406203ec44b41bd47316b9","61af5fd9875e8405e195dad712f2c8e332db70fb0422405cb7e988f72b6c17e4"],"paragraph_range_zero_based":[6048,6071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6048"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem and set the failureType-v1610 as beamFailureRecoveryFailure;","paragraph_zero_based":6072},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6073},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6074},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide indication from SCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6075},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx;","paragraph_zero_based":6076},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to SRB3 integrity check failure:","paragraph_zero_based":6077},{"literal_text_all_w_t_and_m_t":"2>set the failureType as srb3-IntegrityFailure;","paragraph_zero_based":6078},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to Reconfiguration failure of NR RRC reconfiguration message:","paragraph_zero_based":6079},{"literal_text_all_w_t_and_m_t":"2>set the failureType as scg-reconfigFailure;","paragraph_zero_based":6080},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to consistent uplink LBT failures:","paragraph_zero_based":6081},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as scg-lbtFailure;","paragraph_zero_based":6082},{"literal_text_all_w_t_and_m_t":"1> else if connected as an IAB-node and the SCGFailureInformationNR is initiated due to the reception of a BH RLF indication on BAP entity from the SCG:","paragraph_zero_based":6083},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as bh-RLF.","paragraph_zero_based":6084},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6085},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as beamFailure.","paragraph_zero_based":6086},{"literal_text_all_w_t_and_m_t":"5.7.3.4Setting the contents of MeasResultSCG-Failure","paragraph_zero_based":6087},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MeasResultSCG-Failure as follows:","paragraph_zero_based":6088},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured on NR SCG for which a measId is configured and measurement results are available:","paragraph_zero_based":6089},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultPerMOList;","paragraph_zero_based":6090},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6091},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6092},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6093},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6094},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1ee1b1f243cf197e788acae3ebd279260276714acbcfe812ff113aa316ddb942","b6c0554efcf3cf7d58ec13c0b941ea92d2bfab70bc7ddca0d7397043cd814d3c","4aa9a164087dc781a5ef900f76f2e3b041c2ab15216ae9a22d9eed70ebb5fff8","052dd4f475de0593180be5721d884c2ed1d5ef0f4416a14fd3d5a25ca7e9f336","687ecad7b425e44203bfcc64e3b4947df2ef0075f67e9e260720c128fef81d12","e2e4dd44c91f8f2087573b5981c360d37ad290b71b493853f9441cec1c2073e8","5ad7e8a3e58dfedc6b9c572faec5632b6eb132d9c6ef27c7e4178a31a08e1f9a","d1a3e0c8b6217d36bc89cd0bd025d8eb31618887097a1a6505e273d54a2b54b0","021cc6166316a8663c142f20496c7d74f766efc0daea58005cec0b15954351cf","98819d9e33ca99104fdb43c666a8694ce8587a29057a9273d86adfdea3ea5212","a0ed17824b0497ac890b48cb860e1ce4d7d08877ce840c24604840a751487dc4","660832acdceca737eb7c4befc3bb90e43e0b9f0cfbb499b73f755b0793834dd2","83abee4642562f2ad59f2e218df79ed51abf56cb4e7273761bbeaf58ffcb0891","f486cb70a80c8e767303053bfabb6f80c10982946f32f33c54069270ec4e68c4","4b959ace44604124b708366fc44efa91d3eab12188e00f22382564a3fb9075a9","1dc5b0cce7acc29124cfd0bac25915aebffb14e339433bcec7603ff8a6dd79fc","67a829f5da3ccf2723e91960f8c2cc6c4c1c23f7937a2510f61742e42be773a5","ca8a6123f2aba99e430ba71c3c19bbe09519484fd29935a603930b1f15353c1d","0eb5fa337e81a5fd865257124cfbfa2e7d086151cc742bb9265469c143eb89f0","d98483d1375ffd987babd9a7ef20e3d5c6364edf418fbe84f718c5d4ce418881","d25f5c4981f15d8dea8bdf4f094cfd5a325185dc3adefcfab5d3153439a07625","cfb544e038c1e62e32ef593b16bc1097f61a464a2f34de1b5d4123e639cf4db9","6b82d71efa5c084b759a70f271030d93416e3f5bf3cf44be6a9052c39fb25ced","2fac59e468821a3b91f110b5823867c0c1df36124e81848b20f4f555a5a2e28f"],"paragraph_range_zero_based":[6072,6095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6072"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6096},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6097},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6098},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6099},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6100},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6101},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6102},{"literal_text_all_w_t_and_m_t":"NOTE:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6103},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7 according to the otherConfig associated with the NR SCG.","paragraph_zero_based":6104},{"literal_text_all_w_t_and_m_t":"5.7.3.5Actions related to transmission of SCGFailureInformation message","paragraph_zero_based":6105},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the SCGFailureInformation message as follows:","paragraph_zero_based":6106},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformation message due to T310 expiry:","paragraph_zero_based":6107},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6108},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to T312 expiry:","paragraph_zero_based":6109},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set the failureType-v1610 as t312-Expiry;","paragraph_zero_based":6110},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide reconfiguration with sync failure information for an SCG:","paragraph_zero_based":6111},{"literal_text_all_w_t_and_m_t":"2>set the failureType as synchReconfigFailureSCG;","paragraph_zero_based":6112},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide random access problem indication from SCG MAC:","paragraph_zero_based":6113},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6114},{"literal_text_all_w_t_and_m_t":"3>set the failureType as other and set the failureType-v1610 as beamFailureRecoveryFailure;","paragraph_zero_based":6115},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6116},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6117},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message to provide indication from SCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6118},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx;","paragraph_zero_based":6119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c7df40dcdcbebea76920acef1d7dae820636ebbf10dc7020a0a66cb43973c2d2","37c997ea640d4bffd2defe1e922c25b8ba78f5294823b034c1a5264021a752ef","a0afcaab0c6a79284cd8bd6f939ba04ee7b80615432de6416b7f46b4c6f10fea","d6464252b2d7e84f5a40c4a07b692a4892b5ce34608b5d9d0fae693c69576e28","2236129b3b300734334cf4c87dba3a024b61a5a4cd7e542489e119a8ffb3623c","8a3a7cd4b2a4026bcb8cbba37f3ffba23692cb602e9f3b43d2b60177404c95a6","ccb8c64038f76c54529065ba8021be0faebd0576d5253c432e46cb0bc265f030","1a7569c52ca117dfdfd323716d9dff5166fb0f0032bd3229e7f262b7fe7871ec","8fe9c6e856f96e8ff00cb1215defb4d576ca23d90ad7294354bc5fb0e9440df3","0d5e1e2d6e253b8fdcee7232f680606fdab9112ed68b9703a6252d1792d02784","f7fed253c18c6d93da64ca7ee672e836192fbff1df7ba6316d933827f3486085","e35f4f8037d344106ff2a18368152295e289325669afb1d5cbcd7b3071458991","47f39368235bba19cc8bce5a10fe79ed201db040f3c6c0c511898270416c90cf","fd33c0949d63ee64e6a1dca8dd698147c74a3077b1530c98998069688fc15f01","22848c94cef57f626ca83b238ee8c6650ac7fc2cf5b5217285e9e750b5fd82ba","d9b8a5bff3518ccb3046c9f68a68d21e365e89625a5ab58c316ab459b0a3dafa","7179aa7f5c38a533a29706dc75c5c14e95d408ec71f7e9e1f4e0cc5f23a23662","21cd4c1140637c9b86a4be8420dfec2d860f85c9685a8605768a51fc9990e055","dd17bb8de0e56a3420dfbd26a24fc79ca5f20db31e95b95035393437b6ff48c8","9cb59df434f2d10eb61369bd3af5be63c3808ebdc8fed9a2d9e95aff898615ae","e56a8850a3474dfed0b4f70a9a206b7a5be82974b2111b9a534f030aeeceb87d","6ac60b36cb22b2aae3a1540c9384704cb55499396ab1e823c803fe4a061c1a89","664b1a76fc15878d51efe416a4977982c82ffc84d36e91dc269148593682ded0","423ff54e37116863408a5561066ecafcd2ec7ccfb4819aa256979f80d7512236"],"paragraph_range_zero_based":[6096,6119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6096"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to SRB3 IP check failure:","paragraph_zero_based":6120},{"literal_text_all_w_t_and_m_t":"2>set the failureType as srb3-IntegrityFailure;","paragraph_zero_based":6121},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to Reconfiguration failure of NR RRC reconfiguration message:","paragraph_zero_based":6122},{"literal_text_all_w_t_and_m_t":"2>set the failureType as scg-reconfigFailure;","paragraph_zero_based":6123},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to consistent uplink LBT failures:","paragraph_zero_based":6124},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set the failureType-v1610 as scg-lbtFailure;","paragraph_zero_based":6125},{"literal_text_all_w_t_and_m_t":"1>else if connected as an IAB-node and the SCGFailureInformation is initiated due to the reception of a BH RLF indication on BAP entity from the SCG:","paragraph_zero_based":6126},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set failureType-v1610 as bh-RLF;","paragraph_zero_based":6127},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":6128},{"literal_text_all_w_t_and_m_t":"2>set the failureType as other and set failureType-v1610 as beamFailure;","paragraph_zero_based":6129},{"literal_text_all_w_t_and_m_t":"1> include and set MeasResultSCG-Failure in accordance with 5.7.3.4;","paragraph_zero_based":6130},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured by a MeasConfig associated with the MCG, and for which measurement results are available:","paragraph_zero_based":6131},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultFreqList;","paragraph_zero_based":6132},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6133},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency in measResultFreqList to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6134},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6135},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS in measResultFreqList to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6136},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6137},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell in measResultFreqList to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6138},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList in measResultFreqList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6139},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6140},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6141},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6142},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c2a029de550570b2527bc2e3c45e70d6048c3bad57701e6bfac9bcb77fed5ceb","5f06ecaffefd91e21c315ec2a58a5efe9500a621c67cf3c8927e4d2963a1f88d","95889c160039a29747ef70d8605e4c3857c622a06f7297e9825cab468ef812b7","fcc3b4ba21d2e4fd93b2598345a1eb8120cbfed4d28f7d937b06c1d1b495fba1","a657a4bd46b4ec53f80e98873b61a94c930033fa9f9d51536c05408129d84f11","5bd00b2154b48d80a68e57040ddc5ca1954500418bae9a5b9ce9bf57cc4184c6","a7dafe214a32c029ea9acc132c7588fed0c8234482a35847d92c8762da2506d9","55f74a8f203979a4e87c80a1339bcd19aa52fa45162085b2a379c46d3d519007","a8388c3795cf61c4f4de4469a37fb3b2f74abd5141b12e01088320d0ef0d5549","7c34eaa0df55727fba61d7879171696c5effbaa47aa1ce9e102ad9c3c4f5213a","56cf1258147cee565bf596f6e233238c0875ba25abbc6249724cc977c04fa808","9ed9ff9a27f981bec7bd8fa088c541ae391c7ec1e1ca07b89d7f4aab3b21a13b","440f78e21e8ff80b4033782cb9c9a2c0cb7ae1d60b7072b299e13e2e51d00c0f","da25944e9f31038797acc04db6f3a388faf0bbf6132bdd48b014ea3015e14ec2","ca9a724030f06a4a9507a9675cae722f32ff2186aee67e65be9fe52815f3455a","e213174aa2bcf45fe30eb5a2e6a0112a4dd29ff5d849b0fcf5898f28aba07b06","d14a571489b7613d48ec91bddf4d9e4b0b47ccd79cfef8784f7eac68e255bc5c","9cb67dd9f8f8b53024306755da3e83f9aa07ec9457f74022ce32db6ab84d0c41","9d696fa87c4e8316ff104ccab923bcfd5ccc777756f70686f4614381910a2231","42fd2689c3183ce1b4badb767b46e568b6e0671df36be9ad2d379f41acf734ce","3c37f6160189f39c3bb6653618e0f32cec6dbe00a6c413ac0bb611182e14e914","1a5edae3dc3ffa117d23179123c6fffedef577df86ce35b4c4e79866a87fc330","68594a2c64b4dd83f0a33e55b9253dbaacb40cd419b8c72450ba71b0b0d22676","1e7a01849535daa50ad2bdef6bcd5007d2adfcec20e3983eaa40784be42baa77"],"paragraph_range_zero_based":[6120,6143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6120"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6144},{"literal_text_all_w_t_and_m_t":"NOTE 1:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6145},{"literal_text_all_w_t_and_m_t":"NOTE 2:Field measResultSCG-Failure is used to report available results for NR frequencies the UE is configured to measure by SCG RRC signalling.","paragraph_zero_based":6146},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7 according to the otherConfig associated with the NR MCG.","paragraph_zero_based":6147},{"literal_text_all_w_t_and_m_t":"1>if the UE supports SCG failure for mobility robustness optimization:","paragraph_zero_based":6148},{"literal_text_all_w_t_and_m_t":"2>if the failureType is set to synchReconfigFailureSCG; or","paragraph_zero_based":6149},{"literal_text_all_w_t_and_m_t":"2>if the failureType is set to randomAccessProblem and the SCG failure was declared while T304 was running:","paragraph_zero_based":6150},{"literal_text_all_w_t_and_m_t":"3>set perRAInfoList to indicate the performed random access procedure related information as specified in 5.7.10.5.","paragraph_zero_based":6151},{"literal_text_all_w_t_and_m_t":"3>set the failedPSCellId to the physical cell identity and carrier frequency of the target PSCell of the failed PSCell change;","paragraph_zero_based":6152},{"literal_text_all_w_t_and_m_t":"3>set the previousPSCellId to the physical cell identity and carrier frequency of the source PSCell associated to the last received RRCReconfiguration message including reconfigurationWithSync for the SCG;","paragraph_zero_based":6153},{"literal_text_all_w_t_and_m_t":"3>set the timeSCGFailure to the elapsed time since the last execution of RRCReconfiguration message including the reconfigurationWithSync for the SCG until declaring the SCG failure;","paragraph_zero_based":6154},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6155},{"literal_text_all_w_t_and_m_t":"3>set the failedPSCellId to the physical cell identity and carrier frequency of the PSCell in which the SCG failure was declared;","paragraph_zero_based":6156},{"literal_text_all_w_t_and_m_t":"3>if the last RRCReconfiguration message including the reconfigurationWithSync for the SCG was received to enter the PSCell in which the SCG failure was declared:","paragraph_zero_based":6157},{"literal_text_all_w_t_and_m_t":"4>set the timeSCGFailure to the elapsed time since the last execution of RRCReconfiguration message including the reconfigurationWithSync for the SCG until declaring the SCG failure;","paragraph_zero_based":6158},{"literal_text_all_w_t_and_m_t":"4>set the previousPSCellId to the physical cell identity and carrier frequency of the source PSCell associated to the last received RRCReconfiguration message including reconfigurationWithSync for the SCG;","paragraph_zero_based":6159},{"literal_text_all_w_t_and_m_t":"The UE shall submit the SCGFailureInformation message to lower layers for transmission.","paragraph_zero_based":6160},{"literal_text_all_w_t_and_m_t":"5.7.3aEUTRA SCG failure information","paragraph_zero_based":6161},{"literal_text_all_w_t_and_m_t":"5.7.3a.1General","paragraph_zero_based":6162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6163},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3a.1-1: EUTRA SCG failure information","paragraph_zero_based":6164},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform NR MN about an SCG failure on E-UTRA SN the UE has experienced (e.g. SCG radio link failure, SCG change failure), as specified in TS 36.331 [10] clause 5.6.13.2.","paragraph_zero_based":6165},{"literal_text_all_w_t_and_m_t":"5.7.3a.2Initiation","paragraph_zero_based":6166},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure to report EUTRA SCG failures when neither NR MCG nor EUTRA SCG transmission is suspended and in accordance with TS 36.331 [10] clause 5.6.13.2. Actions the UE shall perform upon initiating the procedure, other than related to the transmission of the SCGFailureInformationEUTRA message are specified in TS 36.331 [10] clause 5.6.13.2.","paragraph_zero_based":6167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e4bd5aeb348cdfc42423f8804360bd5167036848574a7608a3142d885f18ed8e","30e997c6b3031d5b18d758fe99cf6918009695b72cc24de9061c7bf6d7950cee","993e7848589079325686cabeb5bac3ed0c026e8fe7954dcea0fa5e95f8e31ed2","870d14bf83484a7cac72b3dfa06f342e3629339478c20d348583eab62ca55c2e","35ff1263e4ede10ec5a848ca591758134e6f4f303189ec5c228b32756cbd3ad1","f735dd9cc25c2d7d679c135dd09b3a2911a913c8abae1aa4e59df5aab918ad56","28ad55341c78053ebf3e58e2ff34b010462bfd741365259c067df7fac4a4e9ee","82d4d1e4b0567c14d097b3ee5e2726672d020dc239b0d61ea5e24f3cf9b64939","2a684b89930db53e8a6123f85654f6a581d37be135a66b251665820c90050a36","c605e74ad45fa18234f4e5489964ea5a561226005825a190a0d0bb91f4089e9d","d04e9cca49226d211460248046d2968f1884f82461dd0e77e0ea79677ab196a6","e3ed38608500b292a8a4e34bcedca96d1ad00c8addde6778be21422b4cb95184","ebe7e0c4a216bead4216c726f56fe70ab3fd19beec788816d1ac8dd4681adfc7","a52681a231467c9735cd37662ad8c448f83d60bbf207ca5552a95ff3d924b746","011867ff3edaa7832c0853e8ff0c81bb60ec4d67e174e74a69c884f8a8fd47b9","e902f11ebb2300d555ab896ddd3d927765f4b2130b61e7e602cfd73ceaf4bf43","e1a8ca132f403c9ebf9df65038dbbff7356bc5c2f0c2b0b03d60f0117c60936f","d4b369c4b8bd400e00a24a9adbf218052f7719f220973ed23476402363e17364","386dbfaffdcd879940891e0703ea6b63e2f6401e3411b27a9e0ced3edd3b1ca6","dcb3064db0b052d3942c0c8926c8c081caa7b78a60ef73d1e07cd7ac2b477fdf","4a64fa063ae2fb060794626647a570d7459d5e1797067cadffff2895a9918750","e670b60f02e94a24e77df93eb1550dac71eba12ea92f290caa5478873c7bb29a","a05fa71f0d1d1b5f0171ec0d77fd6638d7d9ba1b390bba0c1befea68ca6de79f","7bae63cef2d6f604153dc4e7e34239e36d09e27ed1da04d49d7e90c7055dd173"],"paragraph_range_zero_based":[6144,6167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6144"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.3a.3Actions related to transmission of SCGFailureInformationEUTRA message","paragraph_zero_based":6168},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the SCGFailureInformationEUTRA message as follows:","paragraph_zero_based":6169},{"literal_text_all_w_t_and_m_t":"1>include failureType within failureReportSCG-EUTRA and set it to indicate the SCG failure in accordance with TS 36.331 [10] clause 5.6.13.4;","paragraph_zero_based":6170},{"literal_text_all_w_t_and_m_t":"1>include and set measResultSCG-FailureMRDC in accordance with TS 36.331 [10] clause 5.6.13.5;","paragraph_zero_based":6171},{"literal_text_all_w_t_and_m_t":"1>for each EUTRA frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6172},{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListMRDC to include the best measured cells, ordered such that the best cell is listed first using RSRP to order if RSRP measurement results are available for cells on this frequency, otherwise using RSRQ to order if RSRQ measurement results are available for cells on this frequency, otherwise using SINR to order, and based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6173},{"literal_text_all_w_t_and_m_t":"NOTE:Field measResultSCG-FailureMRDC is used to report available results for E-UTRAN frequencies the UE is configured to measure by E-UTRA RRC signalling.","paragraph_zero_based":6174},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7.:","paragraph_zero_based":6175},{"literal_text_all_w_t_and_m_t":"The UE shall submit the SCGFailureInformationEUTRA message to lower layers for transmission.","paragraph_zero_based":6176},{"literal_text_all_w_t_and_m_t":"5.7.3bMCG failure information","paragraph_zero_based":6177},{"literal_text_all_w_t_and_m_t":"5.7.3b.1General","paragraph_zero_based":6178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6179},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3b.1-1: MCG failure information","paragraph_zero_based":6180},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform the network about an MCG failure the UE has experienced i.e. MCG radio link failure. A UE in RRC_CONNECTED, for which AS security has been activated with SRB2 and at least one DRB or multicast MRB setup or, for IAB, SRB2, may initiate the fast MCG link recovery procedure in order to continue the RRC connection without re-establishment.","paragraph_zero_based":6181},{"literal_text_all_w_t_and_m_t":"5.7.3b.2Initiation","paragraph_zero_based":6182},{"literal_text_all_w_t_and_m_t":"A UE configured with split SRB1 or SRB3 initiates the procedure to report MCG failures when neither MCG nor SCG transmission is suspended, the SCG is not deactivated, t316 is configured, and when the following condition is met:","paragraph_zero_based":6183},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG, in accordance with 5.3.10.3, while T316 is not running.","paragraph_zero_based":6184},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6185},{"literal_text_all_w_t_and_m_t":"1>stop timer T310 for the PCell, if running;","paragraph_zero_based":6186},{"literal_text_all_w_t_and_m_t":"1>stop timer T312 for the PCell, if running;","paragraph_zero_based":6187},{"literal_text_all_w_t_and_m_t":"1>suspend MCG transmission for all SRBs, DRBs, multicast MRBs, except SRB0, and, if any, BH RLC channels;","paragraph_zero_based":6188},{"literal_text_all_w_t_and_m_t":"1>reset MCG MAC;","paragraph_zero_based":6189},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CHO, if configured;","paragraph_zero_based":6190},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CPC, if configured;","paragraph_zero_based":6191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8276864de4dd90255ad870f52685125637aaa26f955b6cb72b7d3501ebe57a6f","6339030a14709c18f06687fbcfcd81ca1e628c7ac7756a6d54c2227606b71669","9cc8fa669dcd68dab7d72f5f875fbe309969a1535326f7ffdc6b9f138608d82e","a435bd8c2240eda1c04d8878768dfee036dd9312518f730254b33d6f5aa67590","df9a3a71128f21b69ad9d22445af2c737eb0a030fa694f20f1d28aef04cfac9c","f7d72e00a40d52ebf1166ae0edcd6ca548f0f2722d6bcefe92babe35e440b910","f701ae24351a4d2add5344ac1276bae31a1ab4957078a9a0901743c1b30d1eab","2b2a1a4479149f5687cd4d9015a8f3cc641b7c8c74bb4b805c5f0b55027e139f","827f1769c3a6d2551dc81258344e861e92ef460fdbaa74a91ceb4e7d2526af9b","6e43fee9789a9e44563338af5c52022f1893215ec372d8f078a093c08b616c2b","d7b66f73ef7d55f46687acf3d406ffd4bf32035304e205719e40458425995c69","5d52d481756d744f21afcb752c1d52cd6a4b74f1c6de59626aa8ded5ac2ff303","b5b5ae8690d5f4635ac0f8aae000494e8784300b3058e2e4f36a9b4ecfabe1d2","fa30619f6ab9967b0a2322d1033e06366869d6b32e4dfee8ae0c80fe57f636e7","99ba893837a3d6caec3e0f4ffd8f45f40673ce3f1e87fd4ec8d39f176461af54","1a345a9b1dbcb5a2b7bf7da28f8495f5e893adf236a9d6500de5e9586502e553","79b9a546bb3e5582c799132f149abfcfa7448e85cc0805e9061225a3beedf2c4","688fd4fda7ed44ffa9e7830e6683710f3271366b2fcca3e5cd7ef165a5efd7f6","e35918c67b4d40ec27795ca27bc86791c2dc6f8971f8144dc3ab90ac1c471592","ae9eef66806b64d94cf1f578a038683f0f62a1346ced86c147ffb106a4184faa","47bd1ad1cd983298520e4725663aea4f67fcdd728b65a743717d00739f630a0c","843c2695308dbd221f46504e7ddb7e2274af3043c355c76241d73438900235e5","0279bfd5cb7e8af1d28caffee71785fb7372d48002d361406ae89cea097e893f","a278cf0d933d507d4e8fe34d27903a6226ddc7404f499b015b35799f711512d0"],"paragraph_range_zero_based":[6168,6191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6168"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the MCGFailureInformation message in accordance with 5.7.3b.4.","paragraph_zero_based":6192},{"literal_text_all_w_t_and_m_t":"NOTE:The handling of any outstanding UL RRC messages during the initiation of the fast MCG link recovery is left to UE implementation.","paragraph_zero_based":6193},{"literal_text_all_w_t_and_m_t":"5.7.3b.3Failure type determination","paragraph_zero_based":6194},{"literal_text_all_w_t_and_m_t":"The UE shall set the MCG failure type as follows:","paragraph_zero_based":6195},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the MCGFailureInformation message due to T310 expiry:","paragraph_zero_based":6196},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":6197},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message due to T312 expiry:","paragraph_zero_based":6198},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t312-Expiry;","paragraph_zero_based":6199},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message to provide random access problem indication from MCG MAC:","paragraph_zero_based":6200},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":6201},{"literal_text_all_w_t_and_m_t":"3>set the failureType as beamFailureRecoveryFailure;","paragraph_zero_based":6202},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6203},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":6204},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message to provide indication from MCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":6205},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx:","paragraph_zero_based":6206},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the MCGFailureInformation message due to consistent uplink LBT failures on the MCG:","paragraph_zero_based":6207},{"literal_text_all_w_t_and_m_t":"2>set the failureType as lbt-Failure;","paragraph_zero_based":6208},{"literal_text_all_w_t_and_m_t":"1>else if connected as an IAB-node and the MCGFailureInformation message is initiated due to the reception of a BH RLF indication on BAP entity from the MCG:","paragraph_zero_based":6209},{"literal_text_all_w_t_and_m_t":"2>set the failureType as bh-RLF.","paragraph_zero_based":6210},{"literal_text_all_w_t_and_m_t":"5.7.3b.4Actions related to transmission of MCGFailureInformation message","paragraph_zero_based":6211},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MCGFailureInformation message as follows:","paragraph_zero_based":6212},{"literal_text_all_w_t_and_m_t":"1>include and set failureType in accordance with 5.7.3b.3;","paragraph_zero_based":6213},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured by a measConfig associated with the MCG, and for which measurement results are available:","paragraph_zero_based":6214},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultFreqList;","paragraph_zero_based":6215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5b62ddc43329a8f56454ce289c44bd0be7a723ccd900b243b934406ac22fb1cc","e4752f69c7e690df1f149aec39aac9712ff1f4337a11240235777e6da7dabd87","3b41f2fe5ab0b13843be7a09dee94b8aeca0956f2366081536b4f3dc81dfa7a7","7cea4b911ab9ab53567b7c2fed01da0c4eb4df7e6295cfd5d5db6f429e805700","d7a6ba0180faa7afc230d190a74b2e19b20e95623e1d001fb3592bb1ae511d20","5e1922ab23eb0d75c14169a4d02185e6a40ffda41717a0729177f1d23fb5292e","c60556236aca8cc2d92f25d0c639fe7d5dfec62f7b1bd8fd9f883a5b093b4eef","55fabc2ea8b867b5a9f38bfefca2737c40e319ba23b5b0e787f34b84b3fe8b44","a39192aa4f625f7d9b3a63ffda7de9de3113f6be208b40081f68d64b8379b0e3","d38b00cfff7d500472d489602b880d3fc78a4dbe691369d6b0ce73f1a89786bd","239650cd4287ead16b7d732690c37d7a442758ca1864cc46b61b31ad9ba6451b","402aca8613d1788da0370628318cee6b2c76081fa9243761c295e5b4cc19f1f7","6c99a70e8981ca488bca0e5369672a461a71b7dd88fa8a79db0f5c95627d0085","2149bcc3a65e442653f97537e99fa2081c68168e6c2bd30cd8340cb4eee48dd3","369e6ac8b9b2c308d66398ace57896fcf1c8be14804ea5fb7fcfc1821646f01f","07c604c10fc693b947cf2a4e6ac260c658c74e0649deab761035b17e972a7987","2dfa20ef69618342cdf239a9123bcaa21439729903ab52bdd99628affcdbdd92","5a403ab1beea943cf19cf39f857ca296140848e51fc7b7a38799b42a3f869285","d632dd5ae94d5254b1229daf2fce632c73ebe3f4df444195f9488868077930fd","5bd496762b6882c8e196ca08e26ba75c1d7510dd1aef1a01fb41257a47cbb574","fe2105420f4ed9136f08cc3494e0c2e9f1e74ede846ef7fcdbcea219c0ef3522","cfe89e49a404d4247560ebf0604941dc5aaf01b54951f8f671ab4aa3ce623cbe","66d74da8ba3cf349e0dcc19f99df5c85f1590cd08c3cabddc59b27bbbfcc056b","9324d1e08f12786d68f7693bd9842bffc9e17c6c1ca765547843bd3125aefb5b"],"paragraph_range_zero_based":[6192,6215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6192"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":6216},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency in measResultFreqList to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":6217},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":6218},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS in measResultFreqList to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":6219},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":6220},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell in measResultFreqList to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":6221},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList in measResultFreqList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":6222},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":6223},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":6224},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":6225},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":6226},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":6227},{"literal_text_all_w_t_and_m_t":"1>for each EUTRA frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6228},{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListEUTRA to include the best measured cells, ordered such that the best cell is listed first using RSRP to order the cells if RSRP measurement results are available for cells on this frequency, otherwise using RSRQ to order the cells if RSRQ measurement results are available for cells on this frequency, otherwise using SINR to order the cells, based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6229},{"literal_text_all_w_t_and_m_t":"1>for each UTRA-FDD frequency the UE is configured to measure by measConfig for which measurement results are available:","paragraph_zero_based":6230},{"literal_text_all_w_t_and_m_t":"2>set the measResultFreqListUTRA-FDD to include the best measured cells, ordered such that the best cell is listed first using RSCP to order the cells if RSCP measurement results are available for cells on this frequency, otherwise using EcN0 to order the cells, based on measurements collected up to the moment the UE detected the failure, and for each cell that is included, include the optional fields that are available;","paragraph_zero_based":6231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6232},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NR-DC:","paragraph_zero_based":6233},{"literal_text_all_w_t_and_m_t":"2>include and set measResultSCG in accordance with 5.7.3.4;","paragraph_zero_based":6234},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NE-DC:","paragraph_zero_based":6235},{"literal_text_all_w_t_and_m_t":"2>include and set measResultSCG-EUTRA in accordance with TS 36.331 [10] clause 5.6.13.5;","paragraph_zero_based":6236},{"literal_text_all_w_t_and_m_t":"NOTE 1:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":6237},{"literal_text_all_w_t_and_m_t":"NOTE 2:Field measResultSCG-Failure is used to report available results for NR frequencies the UE is configured to measure by SCG RRC signalling.","paragraph_zero_based":6238},{"literal_text_all_w_t_and_m_t":"NOTE 3:Field measResultSCG-EUTRA is used to report available results for E-UTRAN frequencies the UE is configured to measure by E-UTRA RRC signalling.","paragraph_zero_based":6239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f8103434720ae5ff12e07b4243d58f7447c7f421d1343453de9842b2d76fc482","6bc38e729e99d2490df6d44ccd765316c3dc742f1961763f28be9b39dcc8430d","2ef34164480c714fa74afb071999ab1a45c74710adf5b3853d85d6b9c908b93a","09ede0724428d4b8d8ebfeec5321d53a28499958e4707d680ad5d47282e6d1c9","24d6b124243834366ead5a7cd606080e48291a588f0cae16abd26b6109b81801","2cedbbcff50ea38d8568e144ef988f60468c8499288bc19a55bf7041fc6f0426","28c4c1618c8f576a8db5691485fd934ead273740fef675c2fca4ff281b3c2fa5","9e6269487c0fc4041c5427516b2b580eb58103bb5b3da80755d322fcc1170a31","e25b214a356b1fb56f5559c4de2d543180666afd06a42773a9453db3ccf4d95e","d8b26bcf0d76cbf7931d84e2fea3d620a442b59773600ef50020c0cf420f7aa3","1accf7410b1114d0876d824e58b287c123484460502211889500d380769699c0","38d1f6f6aa994a3f9f91edb9f3a42bc10814f8b87f38876770568c3adf3dfbfa","59a957a214c509a7a1d51d8e91863d23724ea6209e5143c2682851fab3032486","a12f152e60a262f886eb658d3819f049b5b92a400f243b1f796fb880ba2b512d","3d84861e2e8af78a2b067589d1eecb6891bb4197282efa504168ed8494b25d0d","2a4c4f4773012b67fd79104015e25313d8582940af64ce8c5d0526c89ad54cc3","c0496970cf1d9e7ddd8ea37fa8a7884cbbf1b364c25156e1bc01cdf4b6a46912","cb479e69c3343478b925dc57bdbb56d1d0055e4ffdbb9a5e50d31e85034b2dc9","12297c4489b2693d876a23a4cfa1ca7495e7ea3b39adda82e85f6e7e0c8184d6","283f5e455e2862bc826a66cdb8c4aceaaaad22670f87ebc5f2e05d6060fbffbd","c71c743825e339d30d331a0dd8ba5cc23952be3e39261ac54c50fe878d9d9830","0181243d8db3cfb5eaba73093dd7bc62254bde7a858ad6a05dc7e61ed0bad220","5de93792a69335199ec353789c46e98e916379541abb783971707b6cffc8612c","4a2a03d9e4b0b7ad5147c3829f15f310f02f57c81961dbc57c8c61c8bad16cdd"],"paragraph_range_zero_based":[6216,6239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6216"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if SRB1 is configured as split SRB and pdcp-Duplication is not configured:","paragraph_zero_based":6240},{"literal_text_all_w_t_and_m_t":"2>if the primaryPath for the PDCP entity of SRB1 refers to the MCG:","paragraph_zero_based":6241},{"literal_text_all_w_t_and_m_t":"3>set the primaryPath to refer to the SCG.","paragraph_zero_based":6242},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6243},{"literal_text_all_w_t_and_m_t":"1>start timer T316;","paragraph_zero_based":6244},{"literal_text_all_w_t_and_m_t":"1>if SRB1 is configured as split SRB:","paragraph_zero_based":6245},{"literal_text_all_w_t_and_m_t":"2>submit the MCGFailureInformation message to lower layers for transmission via SRB1, upon which the procedure ends;","paragraph_zero_based":6246},{"literal_text_all_w_t_and_m_t":"1>else (i.e. SRB3 configured):","paragraph_zero_based":6247},{"literal_text_all_w_t_and_m_t":"2>submit the MCGFailureInformation message to lower layers for transmission embedded in NR RRC message ULInformationTransferMRDC via SRB3 as specified in 5.7.2a.3.","paragraph_zero_based":6248},{"literal_text_all_w_t_and_m_t":"5.7.3b.5T316 expiry","paragraph_zero_based":6249},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6250},{"literal_text_all_w_t_and_m_t":"1>if T316 expires:","paragraph_zero_based":6251},{"literal_text_all_w_t_and_m_t":"2>initiate the connection re-establishment procedure as specified in 5.3.7.","paragraph_zero_based":6252},{"literal_text_all_w_t_and_m_t":"5.7.4UE Assistance Information","paragraph_zero_based":6253},{"literal_text_all_w_t_and_m_t":"5.7.4.1General","paragraph_zero_based":6254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6255},{"literal_text_all_w_t_and_m_t":"Figure 5.7.4.1-1: UE Assistance Information","paragraph_zero_based":6256},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is for the UE to inform the network of:","paragraph_zero_based":6257},{"literal_text_all_w_t_and_m_t":"-its delay budget report carrying desired increment/decrement in the connected mode DRX cycle length, or;","paragraph_zero_based":6258},{"literal_text_all_w_t_and_m_t":"-its overheating assistance information, or;","paragraph_zero_based":6259},{"literal_text_all_w_t_and_m_t":"-its IDC assistance information, or;","paragraph_zero_based":6260},{"literal_text_all_w_t_and_m_t":"-its preference on DRX parameters for power saving, or;","paragraph_zero_based":6261},{"literal_text_all_w_t_and_m_t":"-its preference on the maximum aggregated bandwidth for power saving, or;","paragraph_zero_based":6262},{"literal_text_all_w_t_and_m_t":"-its preference on the maximum number of secondary component carriers for power saving, or;","paragraph_zero_based":6263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["234ae3fcff581aeb3c29f8a6c73f73d3d8b7d6bb0da3832ad4d302622f431d96","29ed9d962f5de91acece7f2a21d462acbde7d560b51dce1a597ff0ded4a846c0","8fcefa82d2c4df3c52d5baf8de7e4d93d68ccb683b1f78f2f712a207c0657326","f4320924924c6918b4c85d21d91906848c7b9c63cfc663f7b8b0f61948da9226","359fb8227f059fd696488b9981142cef5808b91c7136d21262035b28f1c02143","15c1ed1bc0e9c0e9f9ee2d2ab76b898be3a39f0f6a007f684db3aa9263fa92ed","0588f5b46eec4ef4b43c602f0236d18c72db0543c56de6543a7b76db20aa6261","185f10f9e9d49f3d74071cf1425ea8592b5331c8c827abd042bb1741c319dd59","c63c07cc4df4b073d2c658c456e40b807cf8f8ca2a40f865d9e3bc9fb8f5dcdb","716db4a22446d4d9445d583ad77984593c9ac3622c37afd753d3a9cae7c0bf62","664a292e6ca791fdf58557d636c5805ff015546bffeef49a6481937066889d92","ef21b7052444a38b7c1d4718febaa0147382e1a27f64e3f759521bc55bdbd2ee","071cf3b9cfcd5f6e79c7903d05eef7c71a039b3718884381d54ae6c631e14696","89b225b6f88f16dc2c55c31bd2b13fb3b575468206a8fd7b422a08e90cefe824","b6c5201a5057d2d5222fe16331f54e17ec9962fb01acad33d521a1f8b8732de7","6990cdace979a134b45db6ff38e25f96fb1dd28e8a26dbebfb6feac8a733a418","102788d721769b2eb34186830fb840279e8022162302ca9be97c6891693c6f91","cf55fe3cf58560ceee1cbbfea4dbb48aaa77b511820f06c1b7f0e4eba16dd229","312a5e97c5335d8ecd26efc860712010c2142ac15f771fc01343417229a0d54a","b60bc830f74943b42346d1b1cbe9aa555ecefe7394f239309c3d097bacaf8b6b","45f018866456e97bc0608ca1c6ec9574167bc41601bcf939608ea5b9d952366f","933d46bba3c6289a15ba6c605fb47caba72f621b27e96342b2b7d6eee233ceae","e8f509208550b9a8da8f602c054ee2103493302ea602d95dd0a54b296b3ef1ae","886e1e48e8b091d7ed986dcfd84714c10a16f6d9085493ec992c0787177063fc"],"paragraph_range_zero_based":[6240,6263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6240"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-its preference on the maximum number of MIMO layers for power saving, or;","paragraph_zero_based":6264},{"literal_text_all_w_t_and_m_t":"-its preference on the minimum scheduling offset for cross-slot scheduling for power saving, or;","paragraph_zero_based":6265},{"literal_text_all_w_t_and_m_t":"-its preference on the RRC state, or;","paragraph_zero_based":6266},{"literal_text_all_w_t_and_m_t":"-configured grant assistance information for NR sidelink communication, or;","paragraph_zero_based":6267},{"literal_text_all_w_t_and_m_t":"-its preference in being provisioned with reference time information, or;","paragraph_zero_based":6268},{"literal_text_all_w_t_and_m_t":"-its preference for FR2 UL gap, or;","paragraph_zero_based":6269},{"literal_text_all_w_t_and_m_t":"-its preference to transition out of RRC_CONNECTED state for MUSIM operation, or;","paragraph_zero_based":6270},{"literal_text_all_w_t_and_m_t":"-its preference on the MUSIM gaps, or;","paragraph_zero_based":6271},{"literal_text_all_w_t_and_m_t":"-its relaxation state for RLM measurements, or;","paragraph_zero_based":6272},{"literal_text_all_w_t_and_m_t":"-its relaxation state for BFD measurements, or;","paragraph_zero_based":6273},{"literal_text_all_w_t_and_m_t":"-availability of data and/or signalling mapped to radio bearers which are not configured for SDT, or;","paragraph_zero_based":6274},{"literal_text_all_w_t_and_m_t":"-its preference for the SCG to be deactivated, or;","paragraph_zero_based":6275},{"literal_text_all_w_t_and_m_t":"-availability of uplink data to transmit for a DRB for which there is no MCG RLC bearer while the SCG is deactivated, or;","paragraph_zero_based":6276},{"literal_text_all_w_t_and_m_t":"-change of its fulfilment status for RRM measurement relaxation criterion, or;","paragraph_zero_based":6277},{"literal_text_all_w_t_and_m_t":"-service link (specified in TS 38.300 [2]) propagation delay difference between serving cell and neighbour cell(s); or","paragraph_zero_based":6278},{"literal_text_all_w_t_and_m_t":"-availability of flight path information for Aerial UE operation.","paragraph_zero_based":6279},{"literal_text_all_w_t_and_m_t":"5.7.4.2Initiation","paragraph_zero_based":6280},{"literal_text_all_w_t_and_m_t":"A UE capable of providing delay budget report in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide delay budget report and upon change of delay budget preference.","paragraph_zero_based":6281},{"literal_text_all_w_t_and_m_t":"A UE capable of providing overheating assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting internal overheating, or upon detecting that it is no longer experiencing an overheating condition.","paragraph_zero_based":6282},{"literal_text_all_w_t_and_m_t":"A UE capable of providing IDC assistance information in RRC_CONNECTED may initiate the procedure if it was configured to do so, upon detecting IDC problem if the UE did not transmit an IDC assistance information since it was configured to provide IDC indications, or upon change of IDC problem information.","paragraph_zero_based":6283},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on DRX parameters of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a preference on DRX parameters and upon change of its preference on DRX parameters.","paragraph_zero_based":6284},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum aggregated bandwidth of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum aggregated bandwidth preference and upon change of its maximum aggregated bandwidth preference.","paragraph_zero_based":6285},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of secondary component carriers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of secondary component carriers preference and upon change of its maximum number of secondary component carriers preference.","paragraph_zero_based":6286},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the maximum number of MIMO layers of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a maximum number of MIMO layers preference and upon change of its maximum number of MIMO layers preference.","paragraph_zero_based":6287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b641bf99aaaad3c5faaa1585bb018bdf1fc8718d39f5ed1dbd3478f2fe9c9055","9fc86bb7726ea92e4a8959950f78a5dfc39f724d50aa959d8edcc7a692ef0854","1832cb512df69ad57ea24e15811501386b6403b3fc1de491e020c9c81cbe3c83","3923343c3a35f5734f48a01251020dfdd0bf83ea1ec056c9d1ce97f2ad0840f1","40c3ea1fcd2a896f9e292e6280ea411f4dde784dc247c2014fddca49e0ca0401","d89883a0bfac8bf7fbc55c434a7f114c56a8c5295f803f790ff5369522c24b0d","9081d1c29d70cdd8e11b4cb4804d6c4f55b8149d9c2490355ee6871d57f5c5eb","07d0149e1e6481a3e3ac34f62c5ce5cd5e1fe16e86bf0f9172c6298f5acbb291","86f7b3aa5cf97637028617dc7a3cbd13233d6fac9e2ac34faf5ffe1af9c29094","b8e9f5f16d67d7db05d18a5183eeae1cfda71e59900213bea42a01c51badb38b","9e32c3d4444c29fb1bd985f5f21087716f325e7f782ce9311e11932e08af3757","943ae74158053a473163478a43b925cc4c6fbca396723295f316d46ee1191c8a","7aa34deb075079a9a65508b5b1f3611df820f680c1afedb8bbc7ecfaa8e83c70","8d6ea65fdcc03e7cb266d7b648942a60ee57b22c9de6562ad18ee72e256ad520","3860d0d557302cb224985ca483489fe135008d27f66ca29dced82c78633fd9e4","facc1a05c626d6e812c4a698a52212ec8c7da8c7e3cf22b7ab03f4131b192448","92ddef329c069782595667af1c96adfc60a3c993f1a9ed8e6494946d3bbdfa2c","0cbb7e25563222a8548cc107bdd2197d7f4b3543350310a3a76682956a8d1cb6","8b937d85dedbf7ed0e32662a9c7d9f5e20fd6eeb0b906e74362dcd8e17cb29ef","623541f9b875b436c4b83f134627e82e31e2566658c3bab74167e2c98f874c9c","8306a9eab6573bddbd11f2d58ee8cd655db7a34942e76e912259cf0dc7cb3336","40ecd3b8bff1ce4a12a41759aa581acc2a9c64d62e7a9366e689d5bbbae94140","d8d9f0f63db13c6ff4f8a54eed10b58ced70cbd45f75a05d6bcc8461717ddeac","60fce623a7a6241d34c3102dc793f6de4283667cb69ae1ca62e3d068a2dda0a2"],"paragraph_range_zero_based":[6264,6287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6264"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving in RRC_CONNECTED may initiate the procedure in several cases, if it was configured to do so, including upon having a minimum scheduling offset preference and upon change of its minimum scheduling offset preference.","paragraph_zero_based":6288},{"literal_text_all_w_t_and_m_t":"A UE capable of providing assistance information to transition out of RRC_CONNECTED state may initiate the procedure if it was configured to do so, upon determining that it prefers to transition out of RRC_CONNECTED state, or upon change of its preferred RRC state.","paragraph_zero_based":6289},{"literal_text_all_w_t_and_m_t":"A UE capable of providing configured grant assistance information for NR sidelink communication in RRC_CONNECTED may initiate the procedure in several cases, including upon being configured to provide traffic pattern information and upon change of traffic patterns.","paragraph_zero_based":6290},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in being provisioned with reference time information may initiate the procedure upon being configured to provide this indication, or if it was configured to provide this indication and upon change of its preference.","paragraph_zero_based":6291},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of its preference in FR2 UL gap may initiate the procedure if it was configured to do so, upon detecting the need of FR2 UL gap activation/deactivation.","paragraph_zero_based":6292},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for gap preference may initiate the procedure if it was configured to do so, upon determining it needs the gaps, or upon change of the gap preference information.","paragraph_zero_based":6293},{"literal_text_all_w_t_and_m_t":"A UE capable of providing MUSIM assistance information for leave indication may initiate the procedure if it was configured to do so upon determining that it needs to leave RRC_CONNECTED state.","paragraph_zero_based":6294},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its RLM measurements of a cell group in RRC_CONNECTED state shall initiate the procedure for providing an indication of its relaxation state for RLM measurements upon being configured to do so, and upon change of its relaxation state for RLM measurements in RRC_CONNECTED state.","paragraph_zero_based":6295},{"literal_text_all_w_t_and_m_t":"A UE capable of relaxing its BFD measurements in serving cells of a cell group in RRC_CONNECTED shall initiate the procedure for providing an indication of its relaxation state for BFD measurements upon being configured to do so, and upon change of its relaxation state for BFD measurements in RRC_CONNECTED state.","paragraph_zero_based":6296},{"literal_text_all_w_t_and_m_t":"A UE capable of SDT initiates this procedure when data and/or signalling mapped to radio bearers that are not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing).","paragraph_zero_based":6297},{"literal_text_all_w_t_and_m_t":"A UE capable of providing its preference for SCG deactivation may initiate the procedure if it was configured to do so, upon determining that it prefers or does no more prefer the SCG to be deactivated.","paragraph_zero_based":6298},{"literal_text_all_w_t_and_m_t":"A UE that has uplink data to transmit for a DRB for which there is no MCG RLC bearer while the SCG is deactivated shall initiate the procedure.","paragraph_zero_based":6299},{"literal_text_all_w_t_and_m_t":"A UE capable of providing an indication of fulfilment of the RRM measurement relaxation criterion in connected mode may initiate the procedure if it was configured to do so, upon change of its fulfilment status for RRM measurement relaxation criterion for connected mode.","paragraph_zero_based":6300},{"literal_text_all_w_t_and_m_t":"A UE capable of providing service link propagation delay difference between serving cell and neighbour cell(s) shall initiate the procedure upon being configured to do so, and upon determining that service link propagation delay difference between serving cell and a neighbour cell has changed more than threshPropDelayDiff compared with the last reported value.","paragraph_zero_based":6301},{"literal_text_all_w_t_and_m_t":"A UE capable of indicating the availability of flight path information may initiate the procedure, if it was configured to do so, upon determining that an initial or updated flight path information is available.","paragraph_zero_based":6302},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6303},{"literal_text_all_w_t_and_m_t":"1>if configured to provide delay budget report:","paragraph_zero_based":6304},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with delayBudgetReport since it was configured to provide delay budget report; or","paragraph_zero_based":6305},{"literal_text_all_w_t_and_m_t":"2>if the current delay budget is different from the one indicated in the last transmission of the UEAssistanceInformation message including delayBudgetReport and timer T342 is not running:","paragraph_zero_based":6306},{"literal_text_all_w_t_and_m_t":"3>start or restart timer T342 with the timer value set to the delayBudgetReportingProhibitTimer;","paragraph_zero_based":6307},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide a delay budget report;","paragraph_zero_based":6308},{"literal_text_all_w_t_and_m_t":"1>if configured to provide overheating assistance information:","paragraph_zero_based":6309},{"literal_text_all_w_t_and_m_t":"2>if the overheating condition has been detected and T345 is not running; or","paragraph_zero_based":6310},{"literal_text_all_w_t_and_m_t":"2>if the current overheating assistance information is different from the one indicated in the last transmission of the UEAssistanceInformation message including overheatingAssistance and timer T345 is not running:","paragraph_zero_based":6311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1f7c9cd37d8533314bc0da447351410aa29d34c9b17ce6c904d6140b351aea2f","e913c6f35e5d086f81ac014258e6f48625751e8821237fe4b26609f72af32145","fbe7468c39a6ccf0ca6d9d760d855f871b1c67eed4105ee70b3db8524b429384","63dd53c3a1504a8ee2386f674665e21a9ea1f260b7149bf4cb182ceae3a5beed","68fb5f213bc8457887049dfee921ce46d7f8484dc8c962da2064813c0ec9d07b","f85bc1a1ae4d62161232a04acfc8aff62d998d1d42596f13a3868dd472e39ef3","1bce7eede253e968bb11ba7d321cff18d302e8db248d31caa77470ca900bfb8d","28f2446a200f8ff866c7ef8341bee5b9ce5cbc15be382c38f1995c7aa64ca73e","cb25051efd70182ebcacabc99d71709c5d31501adf2354afe3943f0ddbee2ec3","59c14f1a7269836cccef503bd2d1d9b29808b14d701ba4b15f8374cd899288de","e18284d82de05559c60eb1b6ca029701d8d4a471f82cda81c56666c9267d565e","590e58cdcadddd65da0e2330969f5206df4dba3881bfd31652a44564ac4e60d3","960bdf128a76b2d51d3ef9e08e450f0ed563562d45cfdb00b389abc2a163a94c","61161c2b68847759caf85efaf6156e3937609d27b5bc3685f56101c7ce888948","15e60a79799cf15ee77c1458be9f239e940142d95bbea579577fc5b9a56da5dd","2150963d696810a5d355dc6e25f22ef54ed8fce75524d44e06a82f2c4269b0bc","179d4799aa5603a3cd2bc95b37e81b31d9411142a3baf0f6490d22f49b7d7466","aeccf17ed4797e318e68a4ca873e774e34a2d88363bf59e3048ad1a4523a0924","c5b38fa6242364f9b4a965e9e48fe9f3b4fbba7f493f7844662d5bb6d130589a","5200801f0a634efeb2b55d950e6d9256b114b9888b4212182a854cf64d5cc64f","f4db631da1ca143238eb8a6437d31de6ec2b8ccb013ef1bbd88b57b7d6623267","f7f1fdeb3e2d4d2061b8a8f754fb11c50c153b9b7b7852ee0db46f74591aa012","ff49030ae2f304e470b286544b7b13ac5dfb5d0670b4fa140def109be3bc74b1","bd90c6b98a349ef19f17c4daa37df8abe6e8f5d9bfb2274830653b9abfd680b6"],"paragraph_range_zero_based":[6288,6311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6288"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>start timer T345 with the timer value set to the overheatingIndicationProhibitTimer;","paragraph_zero_based":6312},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide overheating assistance information;","paragraph_zero_based":6313},{"literal_text_all_w_t_and_m_t":"1>if configured to provide IDC assistance information:","paragraph_zero_based":6314},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with idc-Assistance since it was configured to provide IDC assistance information:","paragraph_zero_based":6315},{"literal_text_all_w_t_and_m_t":"3>if on one or more frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself; or","paragraph_zero_based":6316},{"literal_text_all_w_t_and_m_t":"3>if on one or more supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6317},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC assistance information;","paragraph_zero_based":6318},{"literal_text_all_w_t_and_m_t":"2>else if the current IDC assistance information is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":6319},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide IDC assistance information;","paragraph_zero_based":6320},{"literal_text_all_w_t_and_m_t":"NOTE 1:The term \"IDC problems\" refers to interference issues applicable across several subframes/slots where not necessarily all the subframes/slots are affected.","paragraph_zero_based":6321},{"literal_text_all_w_t_and_m_t":"NOTE 2:For the frequencies on which a serving cell or serving cells is configured that is activated, IDC problems consist of interference issues that the UE cannot solve by itself, during either active data exchange or upcoming data activity which is expected in up to a few hundred milliseconds.For frequencies on which a SCell or SCells is configured that is deactivated, reporting IDC problems indicates an anticipation that the activation of the SCell or SCells would result in interference issues that the UE would not be able to solve by itself.For a non-serving frequency, reporting IDC problems indicates an anticipation that if the non-serving frequency or frequencies became a serving frequency or serving frequencies then this would result in interference issues that the UE would not be able to solve by itself.","paragraph_zero_based":6322},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on DRX parameters of a cell group for power saving:","paragraph_zero_based":6323},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters of the cell group and the UE did not transmit a UEAssistanceInformation message with drx-Preference for the cell group since it was configured to provide its preference on DRX parameters of the cell group for power saving; or","paragraph_zero_based":6324},{"literal_text_all_w_t_and_m_t":"2>if the current drx-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including drx-Preference for the cell group and timer T346a associated with the cell group is not running:","paragraph_zero_based":6325},{"literal_text_all_w_t_and_m_t":"3>start the timer T346a with the timer value set to the drx-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6326},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current drx-Preference;","paragraph_zero_based":6327},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum aggregated bandwidth of a cell group for power saving:","paragraph_zero_based":6328},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth of the cell group and the UE did not transmit a UEAssistanceInformation message with maxBW-Preference and/or maxBW-PreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum aggregated bandwidth of the cell group for power saving; or","paragraph_zero_based":6329},{"literal_text_all_w_t_and_m_t":"2>if the current maxBW-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxBW-Preference and/or maxBW-PreferenceFR2-2for the cell group and timer T346b associated with the cell group is not running:","paragraph_zero_based":6330},{"literal_text_all_w_t_and_m_t":"3>start the timer T346b with the timer value set to the maxBW-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6331},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxBW-Preference and/or maxBW-PreferenceFR2-2;","paragraph_zero_based":6332},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of secondary component carriers of a cell group for power saving:","paragraph_zero_based":6333},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxCC-Preference for the cell group since it was configured to provide its preference on the maximum number of secondary component carriers of the cell group for power saving; or","paragraph_zero_based":6334},{"literal_text_all_w_t_and_m_t":"2>if the current maxCC-Preference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxCC-Preference for the cell group and timer T346c associated with the cell group is not running:","paragraph_zero_based":6335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3962fc8140f74f7740e01e7136be48985147ed3bc0e1f6f30d72b36f940e9813","cc412c493ae616bc5ca0d47662e15f05b272a75be1c4338b96876043ac6906b7","048bda5cfdbeafee22e6791d89bbcea3849daec8e2dd5f5db3c3d8e4bb1fdeb4","aab2daaea077962cd45016e6229594edd0dee8e88378a3080390a15aff2b86a1","aec1f428a475ad1ae33f1837d9a12064e91dde557db811ddc75c174cf514f074","894e0c44237608843d5e9ff797627187790cc84d5ea5e9b93e65f2f58ac6fa0e","56f2880bd18ead8925b95c87fb8711c481957726b7544ba96082d71fa21d2813","c165cd5bf5d9ed56309021aeb31412e2e7210b0f56b32983b007b86c89b108de","734d2e32a9734b10c35d592f7c21f59e9bd415f497d5d90a86b4210c7761a9ac","1cfbc0241f1051edfc073ca401bea769f2a1833afa0e2b43158d04c24b510af4","5443b23429e30afbd6d4c078d034678d3456cfafc6ffc59a489b44cf6b546734","b737797987741a549ef02b14442a3284fd50e6301234009d7f34cb0a03778b11","12db5ecd8e721ff5ffa3ff3d3786be1206b918a2b60902d1353dcca974e2352d","3394d0feda85e5cd1978a3d9287cf7bbf62f3b6b980ecc1a4452c19350285fe6","c624ff9daa7f8c183fac9967c1f4583e81b10cdbb7a1ed212af3751ed5eacb1f","5cfdd2918122de58028e62e9323ac75c780ca20aa9801f4ef460695e2532472e","83cf2ef7f61bdcd347f1f6daa11f85f7d463a858cca334d4e5591d9611383941","953760b49a4749b14ba4f238ef9de49da134921b3de9b1059545662f3dfd1826","2398d1b360f88e9f60037f21951a2748739fe6057351a93ff5071430c5ac1c10","65663c314e43ecee01e21e9410d619a55747eeefa072b9716fb4f8841f70fdc0","2e5bafbb5398e4ee96c8af10e9301320d830d1b30137588cd411a15ea695dc9b","f8e0fc0d63bd826d76d834b26d8c0c7ad16e01854de951e8c35b423fca1e3097","95b6cd328d44be57d8954f6aefd60366c3a8999946ed7101e31003f0baa08d5b","50e1b4eb4099b1e9fe8dd9a2c9c4052d42c04b689e346f5cb5965ddf6704f7bf"],"paragraph_range_zero_based":[6312,6335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6312"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>start the timer T346c with the timer value set to the maxCC-PreferenceProhibitTimer of the cell group;","paragraph_zero_based":6336},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxCC-Preference;","paragraph_zero_based":6337},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the maximum number of MIMO layers of a cell group for power saving:","paragraph_zero_based":6338},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers of the cell group and the UE did not transmit a UEAssistanceInformation message with maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group since it was configured to provide its preference on the maximum number of MIMO layers of the cell group for power saving; or","paragraph_zero_based":6339},{"literal_text_all_w_t_and_m_t":"2>if the current maxMIMO-LayerPreference information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2 for the cell group and timer T346d associated with the cell group is not running:","paragraph_zero_based":6340},{"literal_text_all_w_t_and_m_t":"3>start the timer T346d with the timer value set to the maxMIMO-LayerPreferenceProhibitTimer of the cell group;","paragraph_zero_based":6341},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current maxMIMO-LayerPreference and/or maxMIMO-LayerPreferenceFR2-2;","paragraph_zero_based":6342},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of a cell group for power saving:","paragraph_zero_based":6343},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling of the cell group and the UE did not transmit a UEAssistanceInformation message with minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group since it was configured to provide its preference on the minimum scheduling offset for cross-slot scheduling of the cell group for power saving; or","paragraph_zero_based":6344},{"literal_text_all_w_t_and_m_t":"2>if the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt information for the cell group is different from the one indicated in the last transmission of the UEAssistanceInformation message including minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt for the cell group and timer T346e associated with the cell group is not running:","paragraph_zero_based":6345},{"literal_text_all_w_t_and_m_t":"3>start the timer T346e with the timer value set to the minSchedulingOffsetPreferenceProhibitTimer of the cell group;","paragraph_zero_based":6346},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current minSchedulingOffsetPreference and/or minSchedulingOffsetPreferenceExt;","paragraph_zero_based":6347},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its release preference and timer T346f is not running:","paragraph_zero_based":6348},{"literal_text_all_w_t_and_m_t":"2>if the UE determines that it would prefer to transition out of RRC_CONNECTED state; or","paragraph_zero_based":6349},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with connectedReporting and the UE determines that it would prefer to revert an earlier indication to transition out of RRC_CONNECTED state:","paragraph_zero_based":6350},{"literal_text_all_w_t_and_m_t":"3>start timer T346f with the timer value set to the releasePreferenceProhibitTimer;","paragraph_zero_based":6351},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the release preference;","paragraph_zero_based":6352},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6353},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide configured grant assistance information for NR sidelink communication;","paragraph_zero_based":6354},{"literal_text_all_w_t_and_m_t":"1>if configured to provide preference in being provisioned with reference time information:","paragraph_zero_based":6355},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with referenceTimeInfoPreference since it was configured to provide preference; or","paragraph_zero_based":6356},{"literal_text_all_w_t_and_m_t":"2>if the UE's preference changed from the last time UE initiated transmission of the UEAssistanceInformation message including referenceTimeInfoPreference:","paragraph_zero_based":6357},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide preference in being provisioned with reference time information.","paragraph_zero_based":6358},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference on FR2 UL gap:","paragraph_zero_based":6359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9aa3640d1d8cfe2811c054ab45c9409d9354f77cf88a8d99d0986dbd1f04d22c","b94ac184aed352b6292ea5531f5e53afa8a93e6a4df4a2c349572937253dff0b","d83c7e60f82584987497cf8b86e4800a0f7e92cfcc88127938615a7de19df907","b8d694ab464370ba5a67c46f8694045b97eebf7f45ba035674fa084b230f1b02","e28bbaf38f1e464c01749beaf721a1dbd6f8a1d29138876d194703087dae5c6d","d0a9401a1e2897ec786e23df6c97492bfc255e44c984f50cb79854413d90146b","55c94fda4454be2d0150a6b222388ee5566ca9400c087d50c19b231f0136e1f3","bef5204c6b19be2f195c7276b8795d0116fc2d7e5466e918631228032bb8c865","9db79cc49874382d5113874a1a4ca1529c974d08730701b58add3a6cecda5cd8","23b43cdb334eb7bbf6fd68e590ae9889a04e6cbfa444b0a607ad0f6bedd4f2e6","0739303c4285b4d7baa76226d7f0a7ee6154905e5a6eec073ed1890933e48213","2a45ba66d3b666dfd1b61bacd8966d7cac8f140d700ba82233d6e584d2d7987b","36807297346c1bd9173fcdf6d560ad3ec3a9e74b553713235f974c1331e44b73","aa77df1c8269eea50afdb7c21695810cb359e5d4bc62cfc57c54ac7abfe6e3b3","38c9305101fdcad18e8d0466b79f700415e546ab4583a47f52b9315eb88781af","dc96c2f331c25863f5dbf3a795c0c3cf31c3f32604b56ff8088778f1d80f784d","ef48e59baef26e675be731a2225ce7ee27c1b8c9a677942e12cd3e4626e58cf2","ece7f243517dea88564931a8996b7e4112c24b08d4a095659e38bf52e5f8dab1","22887c2e6882edea4bbddea3ad5e1e174b0784ecba2de72ef889ffcc0bbeacdf","611a5745cf875344aac4b53e632bc5513c4ca3be93bfee2849779d146dff39e6","056841913579c9f50f907e64fcd89c41a48e0ee9bbb1524f3cd20dc4456c073f","01a7e93956c54a2dff2fa261991a3a089580977f761c2a208f0597a82f42a28b","4bed38a5472fc1d7fec314279a208628acafc7da471b528e3927c160a994c01e","22e776421d0e1ffa56ab97f1fee824ac8ad3c7881c99fa041758972168e2a451"],"paragraph_range_zero_based":[6336,6359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6336"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with ul-GapFR2-Preference since it was configured to provide its preference on FR2 UL gap information:","paragraph_zero_based":6360},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference on FR2 UL gap activation/deactivation:","paragraph_zero_based":6361},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference;","paragraph_zero_based":6362},{"literal_text_all_w_t_and_m_t":"2>else if the current FR2 UL gap preference is different from the one indicated in the last transmission of the UEAssistanceInformation message:","paragraph_zero_based":6363},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide FR2 UL gap preference.","paragraph_zero_based":6364},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for leaving RRC_CONNECTED:","paragraph_zero_based":6365},{"literal_text_all_w_t_and_m_t":"2>if the UE needs to leave RRC_CONNECTED state and the timer T346g is not running:","paragraph_zero_based":6366},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide MUSIM assistance information for leaving RRC_CONNECTED;","paragraph_zero_based":6367},{"literal_text_all_w_t_and_m_t":"3>start the timer T346g with the timer value set to the musim-LeaveWithoutResponseTimer;","paragraph_zero_based":6368},{"literal_text_all_w_t_and_m_t":"1>if configured to provide MUSIM assistance information for gap preference:","paragraph_zero_based":6369},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the MUSIM gap(s) and the UE did not transmit a UEAssistanceInformation message with musim-GapPreferenceList since it was configured to provide MUSIM assistance information for gap preference; or","paragraph_zero_based":6370},{"literal_text_all_w_t_and_m_t":"2>if the current musim-GapPreferenceList is different from the one indicated in the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList and the timer T346h is not running:","paragraph_zero_based":6371},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the current musim-GapPreferenceList;","paragraph_zero_based":6372},{"literal_text_all_w_t_and_m_t":"3>start or restart the timer T346h with the timer value set to the musim-GapProhibitTimer.","paragraph_zero_based":6373},{"literal_text_all_w_t_and_m_t":"NOTE 3:The UE does not need to initiate transmission of the UEAssistanceInformation message if the difference between the current musim-GapPreferenceList and the last transmission of the UEAssistanceInformation message including musim-GapPreferenceList is only due to removal of an ended aperiodic gap.","paragraph_zero_based":6374},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of RLM measurements of a cell group and RLM measurement of the cell group is not stopped:","paragraph_zero_based":6375},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with rlm-MeasRelaxationState since it was configured to provide the relaxation state of RLM measurements for the cell group; or","paragraph_zero_based":6376},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of RLM measurements for the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including rlm-MeasRelaxationState of the cell group and timer T346j associated with the cell group is not running:","paragraph_zero_based":6377},{"literal_text_all_w_t_and_m_t":"3>start timer T346j with the timer value set to the rlm-RelaxtionReportingProhibitTimer;","paragraph_zero_based":6378},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of RLM measurements of the cell group;","paragraph_zero_based":6379},{"literal_text_all_w_t_and_m_t":"1>if configured to provide the relaxation state of BFD measurements of serving cells of a cell group and BFD measurement of the cell group is not stopped:","paragraph_zero_based":6380},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with bfd-MeasRelaxationState since it was configured to provide the relaxation state of BFD measurements for the cell group; or","paragraph_zero_based":6381},{"literal_text_all_w_t_and_m_t":"2>if the relaxation state of BFD measurements in any serving cell of the cell group is currently different from the relaxation state reported in the last transmission of the UEAssistanceInformation message including bfd-MeasRelaxationState of the cell group and timer T346k associated with the cell group is not running:","paragraph_zero_based":6382},{"literal_text_all_w_t_and_m_t":"3>start timer T346k with the timer value set to the bfd-RelaxtionReportingProhibitTimer;","paragraph_zero_based":6383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["39f905da15899c6c12cf593ddfb3857836fb9e368a0174157078d408be6d3b80","8f436d1c76b345fb623efb03b618cdd5a1592fc36178732c98a55a8211a9f83c","2973c61101b71f8b57f83e9e992ebe2c3b007d8f8f409a61abac296db9f65836","60e6b178c30060925279a78d3f55659206f888fa6e4cdc10a17708be08b7fa69","64d615ecbbd7debcfa50a5af715d558b108044414be97836cee2215df48f4206","2f301bbac2581334753c7e5035534e8fd2b67711102399aff91795d87a51eb2a","b5286121cc93fb5fd296d40684e4309df12b2a23179acd5fccba96cae729e56d","6628a29ec8ee26275d89e68b8ad6a171b55ea644fb9211fbc9a5a5be8ceeb082","e47f42fc9479f046fc8fc3738d04faa60ba51f00018d03f1dc9a2a40523e2171","a0e8c0c74a7fe5db80545f74213cefa03c9a76a214bacedb9ad021a892d5e2a7","7d1fb8ed9913ff008b45b70476bb609ac25fac8e0765e7248f22c85e332a841e","73d267cbccaece7abe9678a0a78de5633bf96cd9989e7aa3634bb86bc817fd1a","7e21ba44bcc56c178199062a701ccfa0300c5301ab2c2aa981f0b571b4c3de00","efe9ad5074bc500548131b8235ba7b56f1517e5b815bccf70797a3190a856081","fd22a38b83f0f6db3e41c32881dab46bee6d6ef704de0f2d99dc3b0213be179b","aff02e5b7fe73c20bf8543bf31c1326ed0f4c4d90faff8b09add5e57fb1b39e8","2aefc1c402e36f079a71e396196dadfe72c0c5946ef925092cce845ca8946150","47110e5dcd157601fc2331ac9032dd69cf6c5f2346e7cfd6d125f9e5bcb02560","51adb0bb643c8823deec8c9841fc10e5b3df83b3821adff1fdaebe448f4d5e40","5f93bc4611290a5203d694113b37428fce2bdc72e7a146c9bca0b958860a7783","349be5c7d1f1615682fce5d76b9bd86bb155dba373708c58187cae84dc0d2f8f","a79563a501caab2229eb8cde032c05fd1370bea8797ff818b29d99f4a89de15f","baec9be39bde640eb844fac0ac770b1e170dbed545611e7e64d995736a0ec68c","daef27498d717a258a7ab29dc4e101788275015e02883de3b445e90ce22b4d9d"],"paragraph_range_zero_based":[6360,6383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6360"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the relaxation state of BFD measurements of serving cells of the cell group.","paragraph_zero_based":6384},{"literal_text_all_w_t_and_m_t":"1>if data and/or signalling mapped to radio bearers not configured for SDT becomes available during SDT (i.e. while SDT procedure is ongoing):","paragraph_zero_based":6385},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with nonSDT-DataIndication since the initiation of the current resume procedure for SDT:","paragraph_zero_based":6386},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide nonSDT-DataIndication.","paragraph_zero_based":6387},{"literal_text_all_w_t_and_m_t":"1>if configured to provide its preference for SCG deactivation and timer T346i is not running;","paragraph_zero_based":6388},{"literal_text_all_w_t_and_m_t":"2>if the UE prefers the SCG to be deactivated and did not transmit a UEAssistanceInformation message with scg-DeactivationPreference since it was configured to provide its SCG deactivation preference; or","paragraph_zero_based":6389},{"literal_text_all_w_t_and_m_t":"2>if the UE preference for SCG deactivation is different from the last indicated scg-DeactivationPreference:","paragraph_zero_based":6390},{"literal_text_all_w_t_and_m_t":"3>start timer T346i with the timer value set to the scg-DeactivationPreferenceProhibitTimer;","paragraph_zero_based":6391},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide the UE preference for SCG deactivation;","paragraph_zero_based":6392},{"literal_text_all_w_t_and_m_t":"1>if the SCG is deactivated, and,","paragraph_zero_based":6393},{"literal_text_all_w_t_and_m_t":"1>the UE has uplink data to send for an SCG RLC entity while the UE previously did not have any uplink data to send for any SCG RLC entity:","paragraph_zero_based":6394},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the UE has uplink data to send for a DRB whose DRB-Identity is not included in any RLC-BearerConfig in the CellGroupConfig associated with the MCG.","paragraph_zero_based":6395},{"literal_text_all_w_t_and_m_t":"1>if configured to send indications of RRM measurement relaxation criterion fulfilment:","paragraph_zero_based":6396},{"literal_text_all_w_t_and_m_t":"2>if the criterion in 5.7.4.4 is met for a period of TSearchDeltaP-StationaryConnected:","paragraph_zero_based":6397},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a UEAssistanceInformation message with rrm-MeasRelaxationFulfilment as true since it was configured to provide indications of RRM measurement relaxation criterion fulfilment; or","paragraph_zero_based":6398},{"literal_text_all_w_t_and_m_t":"3>the last UEAssistanceInformation message indicated the criterion in 5.7.4.4 is not fulfilled with rrm-MeasRelaxationFulfilment as false:","paragraph_zero_based":6399},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is fulfilled;","paragraph_zero_based":6400},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6401},{"literal_text_all_w_t_and_m_t":"3>if the last UEAssistanceInformation message indicated fulfilment of the criterion in 5.7.4.4 with rrm-MeasRelaxationFulfilment as true:","paragraph_zero_based":6402},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate that the criterion for RRM measurement relaxation for connected mode is not fulfilled.","paragraph_zero_based":6403},{"literal_text_all_w_t_and_m_t":"1>if configured to provide service link propagation delay difference between serving cell and neighbour cell(s);","paragraph_zero_based":6404},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit a UEAssistanceInformation message with propagationDelayDifference since it was configured to provide service link propagation delay difference between serving cell and neighbour cell(s); or","paragraph_zero_based":6405},{"literal_text_all_w_t_and_m_t":"2>for any neighbour cell in neighCellInfoList, if the service link propagation delay difference between serving cell and the neighbour cell has changed more than threshPropDelayDiff since the last transmission of the UEAssistanceInformation message including propagationDelayDifference:","paragraph_zero_based":6406},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to provide service link propagation delay difference between serving cell and each neighbour cell included in the neighCellInfoList;","paragraph_zero_based":6407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["aa1b458dc496ec5588b52241b81706e674a1778490017837330c23a5f10742d5","d2599d320e6df95fbd89c18f31e9efc4af0160f12ffb2d1a1a295205f4ce7db1","47f5bfc3e4fa5278f69bb60b19017d7659c9446625bfdc15cf09e0dd137f010f","ef4c4c9432f448dabce36faf85b63e9b6e6f9e5002b5a8fcf32b90838a97e464","b77d658d3158a91ff50ae4e47a969e1d5b4f2b99cfca802109dc5e5c045274f7","79db3976c95711ddf5abefd96e314d421ef7fc3492cb03ffbfc780257af201df","09f0a377ad1624808e72397e666499f7313d5830e4056cc6e55264350883f785","02399439c47b96d3fd69b2174472986438cbcdd094adeb1072019a51b1c2258c","4e5e9a74a2f4b5a64132641c124fd786ff917c5bbae6244486c04d07ed9b57de","35d3fc4f54a7e3bad849fe96748089bba53c5eea07a825fdb5b543ce93affd02","e0fdf64b73c1b2e3383edb6d0d0df0809c3a49b4b93f6de19f0856763d457923","7ab5424847295256e61d6df10bccf009615e7c38763804b8e80be633c07a859b","244bed9e33a0b6c25f1bb8324ff6bacf43984ee855cb0bd4736ff8172783af80","1b6e558ec0a0f5f1871c74170ead6a9bc84c03e66e44e817152cd4355bd3bc6e","c43155a05c96c541c40faccfcd1b1b50ce564dbeca0dc142c97152da761a12d2","42e487187688bb735e53387a8742eac2df2409e6181acf8528ae8ae71b1de452","902a6cf2f33c75b61722a43e9e9c965623f23db4df7bf4fea98cd8707d932786","493517044c6d04e5c65bbde750ebd086e44d7cf1c5a1e58cc91473616f922f57","0d1836c08d1f9671afe96d164f39e1f3afca25aaac88b028fa5af8b1e3d10ca4","d6bb6c1ae0f6c84f1ef97c35f51f25d063657bb491cea1c8d18f12868d7d3ef5","ceeb70f2ab58086b02f9b4ec10c6413feaf644460510610a71aca7f9e8e15a5c","5b71e22df3e8a0f4759f58f75dd0e8695881293698d1efe39cf591e3b3328dbb","38c7468e2dd957a348dc9617ece9dd9347436d5f507051de322bb35c795530cd","76ca47c001b84caf985f86ab98117139b4f36112a8d60039d2ae15f6b0905d87"],"paragraph_range_zero_based":[6384,6407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if configured to indicate the availability of flight path information and the UE has flight path information available:","paragraph_zero_based":6408},{"literal_text_all_w_t_and_m_t":"2>if the UE had not previously provided a flight path information; or","paragraph_zero_based":6409},{"literal_text_all_w_t_and_m_t":"2>if flightPathUpdateDistanceThr is configured and for at least one waypoint previously provided to the network, the 3D distance between the previously provided location and the new location is more than or equal to the distance threshold configured by flightPathUpdateDistanceThr; or","paragraph_zero_based":6410},{"literal_text_all_w_t_and_m_t":"2> if flightPathUpdateTimeThr is configured and for at least one waypoint previously provided to the network, the timestamp was not previously provided but is now available, or the time between the previously provided timestamp and the new timestamp, if available, is more than or equal to the time threshold configured by flightPathUpdateTimeThr:","paragraph_zero_based":6411},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the UEAssistanceInformation message in accordance with 5.7.4.3 to indicate the availability of flight path information;","paragraph_zero_based":6412},{"literal_text_all_w_t_and_m_t":"NOTE x:If neither flightPathUpdateDistanceThr nor flightPathUpdateTimeThr is configured, it is up to UE implementation whether to initiate transmission of the UEAssistanceInformation message when updated flight path information is available.","paragraph_zero_based":6413},{"literal_text_all_w_t_and_m_t":"5.7.4.3Actions related to transmission of UEAssistanceInformation message","paragraph_zero_based":6414},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message as follows:","paragraph_zero_based":6415},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a delay budget report according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":6416},{"literal_text_all_w_t_and_m_t":"2>set delayBudgetReport to type1 according to a desired value;","paragraph_zero_based":6417},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide overheating assistance information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":6418},{"literal_text_all_w_t_and_m_t":"2>if the UE experiences internal overheating:","paragraph_zero_based":6419},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum secondary component carriers:","paragraph_zero_based":6420},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":6421},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsDL to the number of maximum SCells the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6422},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsUL to the number of maximum SCells the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6423},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1:","paragraph_zero_based":6424},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":6425},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1;","paragraph_zero_based":6426},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1;","paragraph_zero_based":6427},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":6428},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":6429},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1;","paragraph_zero_based":6430},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1;","paragraph_zero_based":6431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["818819632f1656724e17c8afa26158bc1bd0cb91dc3ea697b444618e193634ac","f604d71565d9837e89ba812c88586d5ffa54bb6a555e4715ee2a0c80de36df2d","9ea6353c96111649b2de09277b5935da97172f855906dbe1859b80dbcc3d7f83","3add716478295e3bdae975a7eb35b8124a7d76481e2094b2ec860fa14c28d2b0","45abee8b85b77042705c8742b22071e2a25433c301671fa41f5549a29829aafb","02f6e86ec80a970dd46b44f20ac5aee6780d657c8b20ea9c89a53df080dc25f7","870f3c95a1de0117ac788164843f944c5a15941c29ad767ba9f2e85e08514e28","a9ebb9cd2d3f509fcbdd15ebb87282f8a4c3f2b3c9edb8f0787c25290fc4b7d2","7f7e5fc9e9cce49ecd4a6a9f3328b4d3a4748ef70372104774e9bb6aff636d90","ae0a6f4cd99b84a1b3940fad09aa3be53281c181dead439348d07aa6c7a092d3","08e042a1f5fb61114519dddc1ab8ce5848b0bc8060f57cb5672dfec310fb526b","f6ff94cdcd2d621a0b79515d96bf22507d68d26704015f12e85d310ea6d532b8","c6f10334b85f6df678e8b8194370907fde5acc12544131233800082c57eebbcd","c704a7cd614c4cf6f4a17ee22cb2b708bb06781a08058edbc8f392597e4914ad","6ede9c7dcdbd723e3a84905cab32ab28e145ecf7258176166958cf98afa17ba1","cfbccb3f5676af0860fd4707bdad1944cf50e34f42613928ea4b35595389788d","5f603e1ae6baf41641ede25dd4049831976bfbaf8e9e80ecaa02047e7e3795b1","f7936e90d9e90ab6ba6b4eec80af30c94be61400a9ce9465588fda7ce5123ff2","bbaa2b6d4c986022c69eaabc36fef69a87ff6e80d03616cbf44d0d16908739bf","11d495be93d7d840120fbdf54afe11ca57c1759d27971951e74a3b54a0124c37","1e1befbce8f8ca540cc4f5f052a1b78b077b3399eef163395edf176e1bc4cdf8","3719b12733702f5182315c53d35f1ee2d890dc7c7f66f194e1b87b35a6c029e1","1d222b7ba711475bc41b4245e3fd892acae526335bd40b6bdcb0dd7f814f7052","aa5c97765e164550f2652e28c475aa30a84ded2dd0090a70f2cc417fd38036e2"],"paragraph_range_zero_based":[6408,6431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6408"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":6432},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6433},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2;","paragraph_zero_based":6434},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2;","paragraph_zero_based":6435},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":6436},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":6437},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6438},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6439},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":6440},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":6441},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6442},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6443},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2:","paragraph_zero_based":6444},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6445},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6446},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6447},{"literal_text_all_w_t_and_m_t":"2>else (if the UE no longer experiences an overheating condition):","paragraph_zero_based":6448},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs, reducedMaxBW-FR1, reducedMaxBW-FR2, reducedMaxBW-FR2-2, reducedMaxMIMO-LayersFR1, reducedMaxMIMO-LayersFR2 or reducedMaxMIMO-LayersFR2-2 in OverheatingAssistance IE;","paragraph_zero_based":6449},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6450},{"literal_text_all_w_t_and_m_t":"2>if there is at least one carrier frequency included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6451},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqList with an entry for each affected carrier frequency included in candidateServingFreqListNR;","paragraph_zero_based":6452},{"literal_text_all_w_t_and_m_t":"3>for each carrier frequency included in the field affectedCarrierFreqList, include interferenceDirection and set it accordingly;","paragraph_zero_based":6453},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":6454},{"literal_text_all_w_t_and_m_t":"3>include victimSystemType for each UL CA combination included in affectedCarrierFreqCombList;","paragraph_zero_based":6455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f3ba4f94eac8cce8bf6478d20452d7a4f06339ea9642f89a140b6622cd4744b2","cc50bf00c2373f70fc46295dc6ebcbd57e376857ce0c0423290b4942617c2c8d","27952a97d71b070774c7ae2da01bf8f38c0e78f51002a3f89e00ae02006d7d0c","35d9ca7afa48762c12fd23194606dfebe19794f3fc65a5d2bbac2f844024b35b","7cf2c5bd032b98df568c65e2e3e44611cd8b5588ae37230b8bb591e5f16b96df","30cb013d21aab3cadc0db9416e7243f0ed1933995d0509547b90787956135de0","5f7bdbc9923444b97def9dfeb470fe429dab72d07fd8df4766fd04533f5dd060","24b76dbf5d36cd4e82f1923db04366dbef6711a5ac86a00c865bc37aa0efc4ed","0403cfd57eb5aa88ce5643e59470586171456fb2a4c3ca8a40154c30524d179b","5e998c97ee3e67da4a07068632a2613cea347825af670ea481de4a56fd30dc8f","84cbb5d5543a637912fc25f7008be0e101f7b75379b2192b5b90a5d2b98dc2a5","45d9eb5c88635ef8b5567ed7bc1d4a29184c25365fb2bd58bbc4e7333ac2a005","26f057da588edc4a4c7d318a96957bb7911d36506b67e62d596e04b3847bad80","5ec4b1a7023e054eb409f9d2f49d2946402b7468b9f6f607dd2bc43056edd489","de4d9baf7892d4fac85d7ebc42a3c31c4779fdcf2baa22ce4ebdc7b577528496","041814a562cb705a6d2d1ef7156f0ac873750ad98cedd46f9934553cd958eb1a","b61a22331294dc27a7e681daf212b33b9a198073efc07b643ff9c4a5a999ecb6","2e86298c496e59c3df4de9bd2dfa359ecce96ea97eb85a11c54cafeae13cb5e4","a63fc4da4665670492e7a1cd6c790c2ccfaa7a152a145f6b3ac206b6721598fb","1333dee7c4472fafe7671338b1e95e874606d3eae2404de0c3ef8de6f89f9fe8","2b91a184109f6df29b6dbddfc6fe2bc41b06c9ca6cc204b35df6ff15f859157a","31bf7d776d7d9d655fb9f8827f6f2db7fb31615b50569a43c5afca162a98c8f7","5d53e6fba3a95a53a6e303afd883cc48fd48a1b04886cb4250a00e61bfee299c","f71bcf2a27a58d2949865822c651ff82ad64373ccbf22b62b814fba1dc304156"],"paragraph_range_zero_based":[6432,6455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6432"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the UE sets victimSystemType to wlan or bluetooth:","paragraph_zero_based":6456},{"literal_text_all_w_t_and_m_t":"4>include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":6457},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6458},{"literal_text_all_w_t_and_m_t":"4>optionally include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":6459},{"literal_text_all_w_t_and_m_t":"NOTE 1:When sending an UEAssistanceInformation message to inform the IDC problems, the UE includes all IDC assistance information (rather than providing e.g. the changed part(s) of the IDC assistance information).","paragraph_zero_based":6460},{"literal_text_all_w_t_and_m_t":"NOTE 2:Upon not anymore experiencing a particular IDC problem that the UE previously reported, the UE provides an IDC indication with the modified contents of the UEAssistanceInformation message (e.g. by not including the IDC assistance information in the idc-Assistance field).","paragraph_zero_based":6461},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide drx-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6462},{"literal_text_all_w_t_and_m_t":"2>include drx-Preference in the UEAssistanceInformation message;","paragraph_zero_based":6463},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters for the cell group:","paragraph_zero_based":6464},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the long DRX cycle:","paragraph_zero_based":6465},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-LongCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6466},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the DRX inactivity timer:","paragraph_zero_based":6467},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-InactivityTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6468},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX cycle:","paragraph_zero_based":6469},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6470},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX timer:","paragraph_zero_based":6471},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycleTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":6472},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on DRX parameters for the cell group):","paragraph_zero_based":6473},{"literal_text_all_w_t_and_m_t":"3>do not include preferredDRX-LongCycle, preferredDRX-InactivityTimer, preferredDRX-ShortCycle and preferredDRX-ShortCycleTimer in the DRX-Preference IE;","paragraph_zero_based":6474},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6475},{"literal_text_all_w_t_and_m_t":"2>include maxBW-Preference in the UEAssistanceInformation message;","paragraph_zero_based":6476},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth for the cell group:","paragraph_zero_based":6477},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR1:","paragraph_zero_based":6478},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the MaxBW-Preference IE;","paragraph_zero_based":6479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["914d2d98c854b2571db4ea5a09242ae897b57eb426aec7363fbecb5d30694d76","f89fde78a526862b8bc1f91250af8298c253853de5470610fa70a09939afeeda","4a3035816957a2d0f11f03db43bb0b8f58fbc18db9d84878daf1c9ea9315eec4","e0e6792379ff3318715d8c8ec9ba94de6ba6265a0753cb8419faec4d36aa9d2f","283ce77a12f5098fd2032b2be003cf54fdaae2489ebe17b2979b294d6514a12d","e3bc6abbcb83a8daaf6478fbc6fc84ef131560121508673e81e19df31aee33bc","45783d465df0f6cd6f193530c9a8ff68498622734b82a7d5b00396e7f0890624","87aaeb0104359a0264a683653c1d7af026ae01e00f758123ea1e241db211df88","1221666fb139d8f6b9ec2b3e24f25ce52430008b2473c869a5d3feba76d03245","95c7dca2056e9c5f9575a0d46f051112bb9f8162431bca615ef92c3e19d71fa3","d01d20033871b3f0842967600e85ee03c2df510c4d51d92505762e30b835ce1f","35b729a96d1f9c00ab34cca09940d7b0f42805e69f4711e38619be075e8baa90","be53104742bc35c96c902a5f421f57e080e5afd837b6aea5350fb8a3b2de505d","0ce6c41f0fa0899bb13963c8ba0519ce5252b149c24d0e98b071bde38cfe2205","52be939526bfb76719cf9d5dbbe4a1477e2bdccb4b3342ec4764c47060580fae","c2fbd88e1de8aa3a18a0c873e214f1fad6a3d284eca0c0d87f9c0bd6923b48b2","008c99defe94e33efb705451d8662efecd5495e180295e631514182f8bf38c84","841572471693888f86c300e6839559a3d1e0a4f1548bad017f7c4b6d1390394d","f732de684a386f5e3dfb562f1ceab399553283402686bb6c3a24b2869cf62f16","9b6e846e30353410e061666378f42e090fef7b6f1ab1a4bc912eb9bbfcbac385","668bdaf72723be201a835529ad8adfe44a16396871976a683da2f7b9b708ecde","7a7231636b2fa474ba