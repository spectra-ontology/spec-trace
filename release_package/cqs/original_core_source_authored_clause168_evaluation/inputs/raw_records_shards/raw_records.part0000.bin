element","paragraph_zero_based":26826},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26827},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-START","paragraph_zero_based":26828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26829},{"literal_text_all_w_t_and_m_t":"RNTI-Value ::=                      INTEGER (0..65535)","paragraph_zero_based":26830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ac94b7799ba29e8c41ff777a7e3bc7f661180c9862286f05a5a47ebe450dcf33","9fe44ec5c829b160651428d950f5c9fd7db88949d76f7ee9fa57e6bd23acb59b","5944c1dfb574285bfa3a02022dd08ac177d2991316d4002ec828e2d662c897ce","d1ffd4ee0c8ed25f0c808365f57eeb208d4c84c3c12e39878cb8d0c8b6e0178f","605d92e8230f8268a0dfbbf1eb10e506942ec4ab35e081e8abd548a713f428ee","aabe1fc7fc11efbc20f48bd67ddb507033fd38047e3c2b38a34f602d34ad8dcf","f03a139099b5f075cd5d3f2dda1b78995bcff264f1f5f8ca80229920e3084c94","b0c13f740134f338d4dd14efb0e64889c39546cd6613b7de8ebf186e8a9ebff8","32a6b91df2eb237ed267cf37aca2b8f9eb60bae4a43eac3c75f915d75ae7b19b","ae45d83843f0ed3e95cfc05024bab5c8cb5d38082530c06f62b902add48f7b64","65cdb87812331705784d7395120cedd0b9e16ed0e3a307b3bdfedd07d18f3ce2","f327d8de9fdaa8155b056f1f5c27b082783f64e6322c2d2560be01fe3aa4b11c","0b19b32bcd53555abee08fd8c397daba85a262f462e412900e38bbff74333a79","e0fcccd60c9114df0bfd7f5b3bc4763963f9458dca2327b43454e43b79baacc1","d2e2d6b754f519a3eb35fe90b19cfacdd5ea0d9b7e83f4bfba7bf9a38c75d4ce","a8fbd45ff834b45e34202e17b0d9acdf4abed988805d9b0d471e75ee230e01e3","1a0a849fc85544359de996d892e4f86cc3ff9133a118b7551681d7db89a9e48c","dc8a0504b1b8138e42128e40fae3b91f7c15118dd6fa8ee87a8842