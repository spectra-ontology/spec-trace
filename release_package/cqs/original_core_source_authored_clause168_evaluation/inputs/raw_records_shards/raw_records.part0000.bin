{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical or cli-Periodical or rxTxPeriodical:","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"3>remove the entry within the VarMeasReportList for this measId;","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"3>remove this measId from the measIdList within VarMeasConfig;","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"1>if the measurement reporting was configured by a sl-ConfigDedicatedNR received within the RRCConnectionReconfiguration:","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via E-UTRA embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"2>if the measurement configuration that triggered this measurement report is associated with the SCG:","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB1 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["d69ec133a717d0f3cd4e2ccb0d218ee8836649b3e32f03cf690586e1c320f12d","09c85806b8d9ccaf5df83b7ab4d46cd7649aa4f49fad92723bf14f8ccee7aaae","eda4ade61854c61f36eae20f0885d41aadeaa49a0b345753c0709c7d6470e87c","6056e68b339915c7c3ec64e2d4a264e35517b5189d1f2d7cd411d93648e6514e","1b56361fc2ff554fd3dbad6c65303819b116a9e2d86f673963bae37b670b0c1c","5ed73ba24c79fcdd7917a957320263d1c5d2a195572006984d859326ddc3c66b","b8fa6445f4a4d9f046981e79a6626093b