{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-CarrierFreqNR-r17           ARFCN-ValueNR","paragraph_zero_based":39528},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39529},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39530},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-STOP","paragraph_zero_based":39531},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39532},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39533},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo field descriptions","paragraph_zero_based":39534},{"literal_text_all_w_t_and_m_t":"sl-CarrierFreqNR","paragraph_zero_based":39535},{"literal_text_all_w_t_and_m_t":"Indicates the DL frequency of the cell indicated by sl-PhysCellId.","paragraph_zero_based":39536},{"literal_text_all_w_t_and_m_t":"sl-PhysCellId","paragraph_zero_based":39537},{"literal_text_all_w_t_and_m_t":"Indicates the PCI of the PCell.","paragraph_zero_based":39538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39539},{"literal_text_all_w_t_and_m_t":"–SL-SourceIdentity","paragraph_zero_based":39540},{"literal_text_all_w_t_and_m_t":"The IE SL-SourceIdentity is used to identify a source of a NR sidelink communication.","paragraph_zero_based":39541},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity information element","paragraph_zero_based":39542},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39543},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-START","paragraph_zero_based":39544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39545},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity-r17 ::=   BIT STRING (SIZE (24))","paragraph_zero_based":39546},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39547},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-STOP","paragraph_zero_based":39548},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39550},{"literal_text_all_w_t_and_m_t":"–SL-SRAP-Config","paragraph_zero_based":39551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["935483354fdfa17b7a1f97c56bc5ae1f577813794548fb51cfbca2b2c314ad0d","e826bcd716b5f2aefd88abd4ea31d696dd2a571355f036473995198477b7a5ef","eccb2082297876e272c7176ab84483f3023d3d674a90e5d6cdb1712f8a495eeb","342e68230a57ae80c162564979491b36f9235c7f8eca3d1bf154890e8392e762","ab03f5ed8eb989e9722901795a406f33123c57ee0ab6fab7f735f3d4ca83a927","f3828b2146c0bbe5e8e6cd193f5e788bf2e9185bb1f63491b4240894f3b8bb1a","5c875b8eefab589b739371e75eec9a1a6f8cb27ed2be50e8ef136f54d23f0c19","bfa1d3d104e9e5ae4e95dcad196d7aa1262537ac10b8793cd74e335370fcc97c","0c36f467f94e9b72befe7e70760055e1f02e81d55c2511a4d1ef3623ebef042b","d3cbc70e3e40f98c4cc3f4b3c60f359ae4642b0d9965df073533642557087047","d8f967667470b6e8a2f132d25a489d2525bb9e5beafb3dd03778b49dfd0353aa","e929e2eae8426992a3f3075195c7b5596bcd478dff5a9e5f41e7e6a6ee9a6b62","c16b3c481e000b5bec47211f1d465d942df6412d868590aa34f26013e3201736","1df66261428a4a04764171837b1976a2657a435086720bb04973474e77c1ab84","1ae4770a5d323db8f6c5db4dfe5e0a116246f71a36764c08ef2a2af47663e3ea","45da4d17f189f014c782860ca0a0ce64589c471d2120620cb5fd3a1c89ecc5aa","2b8e4b3f7b40af778d0ab16fa2e71d5a35a8a9d9898591b3e33f3a1bb6e8198e","5fb42163bc5344efc29ce51691894a5d90d616028afdef4d57750b68118db3d6","8e9766287ee4de63fcbabf62ae4d1764f237bcf987155708ebaaa15ef7372754","418d4c4f3633d6eda50a67064cc70c64304b1f137017226dc2b6458f7c95a7ac","43ac34cfeb737da19c552019ad310