{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37836},{"literal_text_all_w_t_and_m_t":"SL-ConfigIndexCG-r16 ::=          INTEGER (0..maxNrofCG-SL-1-r16)","paragraph_zero_based":37837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37838},{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNumList-r16 ::=     SEQUENCE (SIZE (1..8)) OF SL-CG-MaxTransNum-r16","paragraph_zero_based":37839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37840},{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNum-r16 ::=                  SEQUENCE {","paragraph_zero_based":37841},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":37842},{"literal_text_all_w_t_and_m_t":"    sl-MaxTransNum-r16                         INTEGER (1..32)","paragraph_zero_based":37843},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37845},{"literal_text_all_w_t_and_m_t":"SL-PeriodCG-r16 ::=            CHOICE{","paragraph_zero_based":37846},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG1-r16               ENUMERATED {ms100, ms200, ms300, ms400, ms500, ms600, ms700, ms800, ms900, ms1000, spare6,","paragraph_zero_based":37847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dc8b44d573df1cc6ca83c19a0c36b583e501fd756dfef9da8a6ce3239f11614b","7f9e84e2d8c1e25a5ab7b2ee6668630d8d327294a60459a770efbfe16d35f6e9","2be3116523eae473b40be090c3356e6ee7ce0f022eea1e682bf236a3b635965c","897e6882708ffcfd393a263b07937fa0f4ddb17f75eccdb6bf082d1bbe60e693","d66105e8342be5563f93e6496ba35b850582592bde653