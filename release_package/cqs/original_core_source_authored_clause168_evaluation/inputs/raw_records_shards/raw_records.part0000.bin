{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreq-r16  ::=                 SEQUENCE {","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"    servCellId-r16                               ServCellIndex,","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"    gapIndicationIntra-r16                       ENUMERATED {gap, no-gap}","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"NeedForGapsNR-r16  ::=                        SEQUENCE {","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"    bandNR-r16                                   FreqBandIndicatorNR,","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"    gapIndication-r16                            ENUMERATED {gap, no-gap}","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-STOP","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR field descriptions","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"intraFreq-needForGap","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap requirement information for NR intra-frequency measurement.","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"interFreq-needForGap","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap requirement information for NR inter-frequency measurement.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreq field descriptions","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured. ","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["b6ad48873744c9991bf5a25b3d612ba10492884192d9740d5e90a23c93c18e42","dcba4fee30f913d9a07d39963de817f13ddc5875908a8a0118efba74f5d69ef2","b1e5891c9302c4bda0e16ce9de777201b3c6028da9f7f4a30955fef578e5c9cf","92914200504938c1e9afc3fe17f67fd07fc71405fc6976602870fe4d035830b5","5b3bf403ffcbf62e4eebe2e155ef783dc64425d8a6a65ac2208a51386e7ab7df","85e2bf7bd683e7ad14865f3066782d2f31ade29f36cec2becbcbdd4dcf24f64f","41bc5dbaf077a384a9e6e5d3ed554b01b04d2b4785723f217b737c9823021a40","503e34b8eeb18850469020de82934d4b6a824bbfba6c243b528159cea1b93cfe","0184499f16628ac53b5fbeef688011b6cb8ab6cfcacef60d0db3b8c128358b91","f6bbe23104ec60c174f19c0ec60def20c145ee2929afdbece03adb477da80cd9","78c36dee462c6a50233ff65d3f4dad7967d6f4298700e02a4ed9ee90333cc96e","2a0e07a2d7efb0ba317bc3ee9f8a410c0348147a3bfe256498b4ff18095ff954","65de7564abf5fd2ae21f36c54374fd1e1fa969570076fe97340e4484d83990f1","6eb4881feec846398f76a945b82a2dd40df576dd6a1c5e9b2391672cc83872c6","18e156de319bf8330fbf7c7bb3030dcac0895dde4b183b12bb8d7954231f431d","c5ed476ffb851ba3cd33c184f4830427cbb390d82ba6d7bd8d64632dcb924053","a355bf2e1955136decfc83278d1f299c87b27200051f541d6befcfdb422d3b1f","9e29180b0738c152040d9f55448a52ba9c7222afadf2f64028907dc9e902b7f7","619070fa921773cbf2169b375923c74a61e53e03bfa69c8cec971ef76241a5cb","9316d6e49696adaf001eb9407d3844fda5281cf65a692176fe0c10bdaf91563b","5bf8503a008c7bae9f13b83053b8edd2273dbf5eaf39f0e217d1968ed357f066","711824cb059a3857d95942faeec7d885e3dedb2c4faf7a58b5b1fcadd2af519f","fdce4676e41d369b2f370c29cd7b4919ccf1ea940233d3ca57573d074d619f9b","2e879f06154a748e030ca821bfba6fa3b53be1c1357febb8dd34ad1b7e33ec91"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p600"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value no-gap indicates a measurement gap is not needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not. ","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"NeedForGapsNR field descriptions","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value no-gap indicates a measurement gap is not needed. ","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"Next change ","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"–NonCellDefiningSSB","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"The IE NonCellDefiningSSB is used to configure a NCD-SSB to be used while the UE operates in a RedCap-specific initial BWP or a dedicated BWP that does not contain the CD-SSB.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB information element","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-START","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB-r17 ::=      SEQUENCE {","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB-r17        ARFCN-ValueNR,","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"    ssb-Periodicity-r17             ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }       OPTIONAL,   -- Need S","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"    ssb-TimeOffset-r17              ENUMERATED { ms5, ms10, ms15, ms20, ms40, ms80, spare2, spare1 }      OPTIONAL,   -- Need S","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-STOP","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3cd3bd3ea6f05fcf1dde3ac1d5aa467822a74a179e280d98a06785c15716876d","original_member_sha256":"0d094412acfc7036a6b390e89ffc0838f330e4812a58534567ea0c3db4ee0e42","paragraph_ElementTree_utf8_XML_sha256":["5a7694a9dbb8b0869f1951bc37891388515008d8fd052c138905d63834165288","39bf614c4e800a6a7c058b5da42fc21e510cd6a64bc12c3a99e8af827c60ac01","8ad4d7a00149a4fe146a4a5c7068ad76164c28fc88b293c930c2e4a6b4b5757c","1c0e1ad9be08db434d444e678f3512081e9546ac15d1a0d1cc6cf9b3c6139d1d","afe4fc23300ad75257d4a8cf9b161d60214547da12573c5376575ec235608eb3","f074bc9dd1e290c6e4a97a10a7113321d549cd3c74ff51d9f2b188ff4e628f45","8cc436a623b8a19870d3fae11e1d6b91a01aa723a50d7222991fbf56cb2f5407","5d06a99096a98809e1e3975bd7da572e2104c72677ad8b1d71e7eb6234734f9e","eff49cd63ea85aa37d67b02e050bd4b42968378d114f2d10ef20ad2a728f9230","4e0217b79c8fefb7d53b8ebacdd533812528c9c2a0fb9dcd1c29abeaa0b9cab3","ad887e618e02984e7be0712fdfc1e9829f4b2abd03964a2dac2c823c620b66d7","dffd7951cd704c4a6e97c677a8b11232c242871452fe8e129b02ff2701165e38","deb7a4f5a0b1ae71168b64c391828ccc31642fe50e0cf484f2b7088d9710ad9d","31f503300760ad29d7e06453af69e11b924c302fa953cc15df20b617e9dd4aab","dc7df477a7a40c80591e76fa6cea53fb328dba7cfb06e2087f0433f37f7b776d","e50764dbb78e8c24486fc8180bc008bb1dc6e350ddcbf17cc0ba702dc092088c","fb12c7ef86419e81c5ab3977af52a95b2ee0335ed4c541476bb0541a44321bb3","25a44f83a77b46eac9a95093e336582a6cb3fcc004aa11328c950684c0c75360","b787c4d4d0047d19bbfa8f1d205fc5cc6f7b2c86642013ee623dce7411cc756e","ca42624b41251a2def45fa339faf2025b0f2510587c5ca82afa4040ca27ff0a8","4ca2340fbff7a62dbf5c107525836b29468a1704082df6cd3bc436ef9313a6a8","10eb44e415bd0911cc323fb158d91332d682b30b1cb52ff266ae9150a4bde1bb","a1d57536c6883b5d2db49e2afb7c5e2ba08e2ff039bb3bf743f4358f74804f34","8d671a0d10706e6037a237ff9b60298069a96278bea10edba912706d0c2d12a8"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx:p624"}
{"fields":{"filename":"R2-2311925.zip::R2-2311925_Introduction of BWP_Wor in TS38.331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB field descriptions","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"Frequency of the NCD-SSB. The network configures this field so that the SSB is within the bandwidth of the BWP configured in BWP-DownlinkCommon.","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"The periodicity of this NCD-SSB. The network configures only periodicities that are larger than the periodicity of serving cell's CD-SSB. If the field is absent, the UE applies the SSB periodicity of the CD-SSB (ssb-periodicityServingCell configured in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"ssb-TimeOffset","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"The time offset between CD-SSB of the serving cell and this NCD-SSB. Value ms5 means the first burst of NCD-SSB is transmitted 5ms later than the first burst of CD-SSB transmitted after the first symbol of SFN=0 of the serving cell, value ms10 means the first burst of NCD-SSB is transmitted 10ms later than the first burst of CD-SSB transmitted after the first symbol in SFN=0 of the serving cell, and so on. If the field is absent, RedCap UE considers that the time offset between the first burst of CD-SSB transmitted in the serving cell and the first burst of this NCD-SSB transmitted is zero.","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"End of change ","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"","pa