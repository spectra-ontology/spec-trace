{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ReportConfig field descriptions","paragraph_zero_based":38976},{"literal_text_all_w_t_and_m_t":"sl-ReportType","paragraph_zero_based":38977},{"literal_text_all_w_t_and_m_t":"Type of the configured sidelink measurement report.","paragraph_zero_based":38978},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38979},{"literal_text_all_w_t_and_m_t":"SL-EventTriggerConfig field descriptions","paragraph_zero_based":38980},{"literal_text_all_w_t_and_m_t":"sl-EventId","paragraph_zero_based":38981},{"literal_text_all_w_t_and_m_t":"Choice of sidelink measurement event triggered reporting criteria.","paragraph_zero_based":38982},{"literal_text_all_w_t_and_m_t":"sl-ReportAmount","paragraph_zero_based":38983},{"literal_text_all_w_t_and_m_t":"Number of sidelink measurement reports applicable for sl-EventTriggered report type.","paragraph_zero_based":38984},{"literal_text_all_w_t_and_m_t":"sl-ReportInterval","paragraph_zero_based":38985},{"literal_text_all_w_t_and_m_t":"Indicates the interval between periodical reports (i.e., when sl-ReportAmount exceeds 1) for sl-EventTriggered report type.","paragraph_zero_based":38986},{"literal_text_all_w_t_and_m_t":"sl-ReportOnLeave","paragraph_zero_based":38987},{"literal_text_all_w_t_and_m_t":"indicates whether or not the UE shall initiate the sidelink measurement reporting procedure when the leaving condition is met for a frequency in sl-FrequencyTriggeredList, as specified in 5.8.10.4.1.","paragraph_zero_based":38988},{"literal_text_all_w_t_and_m_t":"sl-ReportQuantity","paragraph_zero_based":38989},{"literal_text_all_w_t_and_m_t":"The sidelink measurement quantities to be included in the sidelink measurement report.","paragraph_zero_based":38990},{"literal_text_all_w_t_and_m_t":"sl-TimeToTrigger","paragraph_zero_based":38991},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a sidelink measurement report.","paragraph_zero_based":38992},{"literal_text_all_w_t_and_m_t":"sN-Threshold","paragraph_zero_based":38993},{"literal_text_all_w_t_and_m_t":"Threshold used for events S1 and S2 specified in clauses 5.8.10.4.2 and 5.8.10.4.3, respectively.","paragraph_zero_based":38994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38995},{"literal_text_all_w_t_and_m_t":"SL-PeriodicalReportConfig field descriptions","paragraph_zero_based":38996},{"literal_text_all_w_t_and_m_t":"sl-ReportAmount","paragraph_zero_based":38997},{"literal_text_all_w_t_and_m_t":"Number of sidelink measurement reports applicable for sl-Periodical report type.","paragraph_zero_based":38998},{"literal_text_all_w_t_and_m_t":"sl-ReportInterval","paragraph_zero_based":38999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0c6ec1a6103519e22b9b2f07ce24491b8000812d7ffb768a2a6c4d05c31c299f","a3b51d8c6480427aa183df7884eef25e9b3c28d01bfd52cfa53fc927600caf78","c3d32123be8ecbe24f3d4198d484a86f0f23c2bc73dfe89dfa4802938fac24cb","c3196177d70c45f874fe356ba2e767abe95032f7d6382634902982135e8057a5","e38f3c5aa92c6800b9f9d23e8b64b5a2fa9b412ddaf96ce5d0f680e2beda36c8","2c3116b7910c132698155e85b0072e6fc65f81c5f9f609f67810ed92ee5880e0","2928dcd347b39b23d9d0f23f988864cfaaa46768517ccdd0c40ef076565c9d9b","3e1b4e5bc8df2880dbe940eb993b914ce19aceb20fe65acaaa197621f2c465d9","cfbb8ac96aac87996169924b2e42163b8bd5ef2449e8aad69389e9e94170f238","0f2cdbcdeaefe9928f37c5c5f7ef65ceff05eb6e1cc9a9bf72a93653bfa4760d","e950a791d9fa2c02281638910f12faf8eca7d85c4ff8a1b9a31709f4aa0b6121","b11a