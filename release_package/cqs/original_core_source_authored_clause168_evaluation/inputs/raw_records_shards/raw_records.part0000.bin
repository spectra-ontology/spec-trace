{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCReestablishmentRequest-IEs field descriptions","paragraph_zero_based":9672},{"literal_text_all_w_t_and_m_t":"reestablishmentCause","paragraph_zero_based":9673},{"literal_text_all_w_t_and_m_t":"Indicates the failure cause that triggered the re-establishment procedure. gNB is not expected to reject a RRCReestablishmentRequest due to unknown cause value being used by the UE.","paragraph_zero_based":9674},{"literal_text_all_w_t_and_m_t":"ue-Identity","paragraph_zero_based":9675},{"literal_text_all_w_t_and_m_t":"UE identity included to retrieve UE context and to facilitate contention resolution by lower layers.","paragraph_zero_based":9676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9677},{"literal_text_all_w_t_and_m_t":"–RRCReconfiguration","paragraph_zero_based":9678},{"literal_text_all_w_t_and_m_t":"The RRCReconfiguration message is the command to modify an RRC connection. It may convey information for measurement configuration, mobility control, radio resource configuration (including RBs, MAC main configuration and physical channel configuration) and AS security configuration.","paragraph_zero_based":9679},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":9680},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9681},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9682},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9683},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration message","paragraph_zero_based":9684},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9685},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-START","paragraph_zero_based":9686},{"literal_text_all_w_t_and_m_t":"","paragrap