{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dedicatedNAS-Message                DedicatedNAS-Message                OPTIONAL,   -- Need N","paragraph_zero_based":9096},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                        OPTIONAL,","paragraph_zero_based":9097},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                DLInformationTransfer-v1610-IEs     OPTIONAL","paragraph_zero_based":9098},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9099},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9100},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer-v1610-IEs ::= SEQUENCE {","paragraph_zero_based":9101},{"literal_text_all_w_t_and_m_t":"    referenceTimeInfo-r16               ReferenceTimeInfo-r16               OPTIONAL,   -- Need N","paragraph_zero_based":9102},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                DLInformationTransfer-v1700-IEs     OPTIONAL","paragraph_zero_based":9103},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9105},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer-v1700-IEs ::= SEQUENCE {","paragraph_zero_based":9106},{"literal_text_all_w_t_and_m_t":"    dedicatedInfoF1c-r17                DedicatedInfoF1c-r17                OPTIONAL,   -- Need N","paragraph_zero_based":9107},{"literal_text_all_w_t_and_m_t":"    rxTxTimeDiff-gNB-r17                RxTxTimeDiff-r17                    OPTIONAL,   -- Need N","paragraph_zero_based":9108},{"literal_text_all_w_t_and_m_t":"    ta-PDC-r17                          ENUMERATED {activate,deactivate}    OPTIONAL,   -- Need N","paragraph_zero_based":9109},{"literal_text_all_w_t_and_m_t":"    sib9Fallback-r17                    ENUMERATED {true}                   OPTIONAL,   -- Need N","paragraph_zero_based":9110},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                         OPTIONAL","paragraph_zero_based":9111},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9113},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFER-STOP","paragraph_zero_based":9114},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9116},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer field descriptions","paragraph_zero_based":9117},{"literal_text_all_w_t_and_m_t":"rxTxTimeDiff-gNB","paragraph_zero_based":9118},{"literal_text_all_w_t_and_m_t":"Indicates the Rx-Tx time difference measurement at the gNB (see clause 5.2.3, TS 38.215 [9]). Upon receiving this field, the UE calculates the propagation delay based on the RTT-based PDC mechanism method as described in TS 38.300 [2]. The network does not configure this field, if the UE is configured with ta-PDC with value activate.","paragraph_zero_based":9119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["54e1c0ff703f8f64bd98ee779969975eda19575da33bdd9d97b4293cc95628eb","37aa2f2d61ea38351c7b781b746632b98053d5eda3c9c5486f1d764817cd33a7","952213983fa8396e72c0b3e5ed2f7ee3f4888b65bc42e6abd0a3b76972ef0c91","e4f1ba2444693b0a322da9227f479263fa52e4df04dfafaad6f30e6a7683ec18","8817410f360d0e16807982842b030186d54de6f970809b5a3ce45ff397471f27","060393fe10e57065e5c80071ae44434b45de7c90f1f07b9900227fd948ee0d59","b91be776c99695da24c2faf77fe70b1f8d5eb8362a00591fd98566bffd8d86de","bdcb8cc3d66de68