{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10945},{"literal_text_all_w_t_and_m_t":"RRCSetup-IEs field descriptions","paragraph_zero_based":10946},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":10947},{"literal_text_all_w_t_and_m_t":"The network configures only the RLC bearer for the SRB1, mac-CellGroupConfig, physicalCellGroupConfig and spCellConfig.","paragraph_zero_based":10948},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":10949},{"literal_text_all_w_t_and_m_t":"Only SRB1 can be configured in RRC setup.","paragraph_zero_based":10950},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":10951},{"literal_text_all_w_t_and_m_t":"Contains dedicated configurations for NR sidelink communication. The network configures only the PC5 Relay RLC channel and sl-PHY-MAC-RLC-Config used for the SRB1.","paragraph_zero_based":10952},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":10953},{"literal_text_all_w_t_and_m_t":"Contains dedicated configurations used for L2 U2N relay related operation. The network configures only the SRAP configuration used for the SRB1 and local UE ID.","paragraph_zero_based":10954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10955},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10956},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10957},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10958},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE; otherwise it is absent.","paragraph_zero_based":10959},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10960},{"literal_text_all_w_t_and_m_t":"–RRCSetupComplete","paragraph_zero_based":10961},{"literal_text_all_w_t_and_m_t":"The RRCSetupComplete message is used to confirm the successful completion of an RRC connection establishment.","paragraph_zero_based":10962},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10963},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10964},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10965},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":10966},{"literal_text_all_w_t_and_m_t":"RRCSetupComplete message","paragraph_zero_based":10967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2bb7bb756538e197c9feaa6418216f2054d827ebdabe14b0db8436d258ecaf40","a07389806ead3713b230b26aa579e23063df8777e4953b62d15cbe2b3b5f6a1b","6bea6135b81e58f686435f5b291d77848f7c0f16d35c0501eed9458cdced3013","dc8cdbdb7116d999c54b1cd4af87d77ba50775cf46554ba371f010f3bde23c8a","df60c31329e4b12ad2e5affb9389f44fdd5d43e3a2a970350b37959ffd89f2f9","342026d97bf68b09778c43c66f155ddb238be54856b43154d26f5218f3070345","ac89505efd0828583d12df1d810283630bafe3af3b1aa50adb1125e2bd9b573a","521b93df97667fa0d0679672f58845cd0edf3f0547b1bcc25aea655d79b0690c","6f8d8db2eed7db2fb82ce4a5ab3e617aa194f34211b8dd9fae6dedd97f29ea2f","2afa221d457ca8b94177a1c45a3d57b87eb537ff8aae9e9ba0f68cfdb27736a6","7a4553af2e3f784951b750b180d1c90eb5ba42a9b5f4d3c43aa31a1c8cd124ab","fff48c35ae52b635ae21a27262198e577b38525705601be4a90a956dd6a64880","f88945f517e85645fc14bf697fa123e46f218f701b533fe46173a4cae7361125","e9877cca3e457290000bc312ba210c1311da5e12c324a2aaf3c10efd5f90936a","0aae494eba48c788ca1bd8