{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"measIdleCarrierListNR","paragraph_zero_based":19680},{"literal_text_all_w_t_and_m_t":"Indicates the NR carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":19681},{"literal_text_all_w_t_and_m_t":"measIdleDuration","paragraph_zero_based":19682},{"literal_text_all_w_t_and_m_t":"Indicates the duration for performing idle/inactive measurements while in RRC_IDLE or RRC_INACTIVE. Value sec10 correspond to 10 seconds, value sec30 to 30 seconds and so on.","paragraph_zero_based":19683},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":19684},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation.","paragraph_zero_based":19685},{"literal_text_all_w_t_and_m_t":"qualityThreshold","paragraph_zero_based":19686},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive NR measurements.","paragraph_zero_based":19687},{"literal_text_all_w_t_and_m_t":"qualityThresholdEUTRA","paragraph_zero_based":19688},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive E-UTRA measurements.","paragraph_zero_based":19689},{"literal_text_all_w_t_and_m_t":"reportQuantities","paragraph_zero_based":19690},{"literal_text_all_w_t_and_m_t":"Indicates which measurement quantities UE is requested to report in the idle/inactive measurement report. ","paragraph_zero_based":19691},{"literal_text_all_w_t_and_m_t":"reportQuantitiesEUTRA","paragraph_zero_based":19692},{"literal_text_all_w_t_and_m_t":"Indicates which E-UTRA measurement quantities the UE is requested to report in the idle/inactive measurement report.","paragraph_zero_based":19693},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":19694},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per beam index the UE shall include in the NR idle/inactive measurement results.","paragraph_zero_based":19695},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":19696},{"literal_text_all_w_t_and_m_t":"Indicates the measurement timing configuration for inter-frequency measurement. If this field is absent in VarMeasIdleConfig, the UE assumes that SSB periodicity is 5 ms in this frequency.","paragraph_zero_based":19697},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":19698},{"literal_text_all_w_t_and_m_t":"Indicates subcarrier spacing of SSB.","paragraph_zero_based":19699},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19700},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":19701},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":19702},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5565e29b502880d79c5fc8e20ef4e902d785823ec1c0ab952b80f7d249d7be8d","646f6d0c0fae77102e9e6a43a102bb50a1a1649af7fbd0ddadb9f82746bac5ea","ee0eb682c0ccd3fb95dcc28543832c9abe8e76d145aecdd17c06d3d2f078a5a6","ee5195be35ba27053613e4c09fd0608b6b4a46890bedd5a488a547bcad010491","82c3d303e6c3a792d48d5e127cbb38f39ccb8c08e5b06067a4d40cf1afbe4d40","3749892e46505f3df6c013ccc536acf991af4221b3521400cae11cd0c9ade184","e710f8fd2cf07b37c3350ab9715d16506325c0ae5aeb29d0972e12329afaa80f","72ab82007c1dedf1b3beb8065d7b93bf5cdd