{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ZoneLength","paragraph_zero_based":39744},{"literal_text_all_w_t_and_m_t":"Indicates the length of each geographic zone.","paragraph_zero_based":39745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39746},{"literal_text_all_w_t_and_m_t":"–SLRB-Uu-ConfigIndex","paragraph_zero_based":39747},{"literal_text_all_w_t_and_m_t":"The IE SLRB-Uu-ConfigIndex is used to identify a sidelink DRB configuration from the network side.","paragraph_zero_based":39748},{"literal_text_all_w_t_and_m_t":"SLRB-Uu-ConfigIndex information element","paragraph_zero_based":39749},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39750},{"literal_text_all_w_t_and_m_t":"-- TAG-SLRB-UU-CONFIGINDEX-START","paragraph_zero_based":39751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39752},{"literal_text_all_w_t_and_m_t":"SLRB-Uu-ConfigIndex-r16 ::=                    INTEGER (1..maxNrofSLRB-r16)","paragraph_zero_based":39753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39754},{"literal_text_all_w_t_and_m_t":"-- TAG-SLRB-UU-CONFIGINDEX-STOP","paragraph_zero_based":39755},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39757},{"literal_text_all_w_t_and_m_t":"6.3.6MBS information elements","paragraph_zero_based":39758},{"literal_text_all_w_t_and_m_t":"–CarrierFreqListMBS","paragraph_zero_based":39759},{"literal_text_all_w_t_and_m_t":"The IE CarrierFreqListMBS is used to inform network of the frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":39760},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS information element","paragraph_zero_based":39761},{"literal_text_all_w_t_a