{"fields":{"filename":"R2-2301347.zip::R2-2301347.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"GNSS-ID-SBAS","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if gnss-id is set to sbas. It is absent otherwise.","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in PosSchedulingInfo. It is absent otherwise.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB and if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in PosSchedulingInfo. It is absent otherwise.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":203}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e8db888fb982803df73b5b70d0aab8c62937a78cdcaaf45c33eae1b126eff1c9","original_member_sha256":"80851f6ec4179a1dcedf260272906258a89ff70e2fd14ccbbe1e0979b29cdbec","paragraph_ElementTree_utf8_XML_sha256":["3d4cbd7d96d5bbc2203d5ecfee9cd49c1eda5e45ea9bb457c5c78c