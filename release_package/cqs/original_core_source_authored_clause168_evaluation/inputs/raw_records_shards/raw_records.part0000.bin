{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE CSI-RS-ResourceMapping is used to configure the resource element mapping of a CSI-RS resource in time- and frequency domain.","paragraph_zero_based":17616},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping information element","paragraph_zero_based":17617},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17618},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-START","paragraph_zero_based":17619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17620},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping ::=          SEQUENCE {","paragraph_zero_based":17621},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation           CHOICE {","paragraph_zero_based":17622},{"literal_text_all_w_t_and_m_t":"        row1                                BIT STRING (SIZE (4)),","paragraph_zero_based":17623},{"literal_text_all_w_t_and_m_t":"        row2                                BIT STRING (SIZE (12)),","paragraph_zero_based":17624},{"literal_text_all_w_t_and_m_t":"        row4                                BIT STRING (SIZE (3)),","paragraph_zero_based":17625},{"literal_text_all_w_t_and_m_t":"        other                               BIT STRING (SIZE (6))","paragraph_zero_based":17626},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17627},{"literal_text_all_w_t_and_m_t":"    nrofPorts                           ENUMERATED {p1,p2,p4,p8,p12,p16,p24,p32},","paragraph_zero_based":17628},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain         INTEGER (0..13),","paragraph_zero_based":17629},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain2        INTEGER (2..12)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":17630},{"literal_text_all_w_t_and_m_t":"    cdm-Type                            ENUMERATED {noCDM, fd-CDM2, cdm4-FD2-TD2, cdm8-FD2-TD4},","paragraph_zero_based":17631},{"literal_text_all_w_t_and_m_t":"    density                             CHOICE {","paragraph_zero_based":17632},{"literal_text_all_w_t_and_m_t":"        dot5                                ENUMERATED {evenPRBs, oddPRBs},","paragraph_zero_based":17633},{"literal_text_all_w_t_and_m_t":"        one                                 NULL,","paragraph_zero_based":17634},{"literal_text_all_w_t_and_m_t":"        three                               NULL,","paragraph_zero_based":17635},{"literal_text_all_w_t_and_m_t":"        spare                               NULL","paragraph_zero_based":17636},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17637},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation,","paragraph_zero_based":17638},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1e4bf4834618e23308495395d62af9635c9e2a14a2c61ecf08c25e8babf5411a","87faf9b92255df3fe573841890166141c7822207253ad045029dbf66318afafe","3d6e70abd8833a06c55b7c1c7fc44d030f6918e5534fe0a6bddf8ebbc29181aa","4af4a68808f4ffc0b1e260279c1d5697f67e986db6a033b7480866e0e19345cb","23bc94eb24ba14a0415dd16280e005912f7fba1e40c2d2cfd1e7375f7af8f2d3","5be04a71e30bdd87832e8c56832e5917567b0c7aa66da4d530e97ab3273a8c53","85079c2838f6d2428d5f85c568bc690217a7d5b696c3ddac079c9c6be907aa23","6f50cd76a2cba42377ca9500f4f9e37da296c49992d6a7de05ec281a1bec2f8b","39d84a921971d3437f1f19f053c98cd623ae9bc7d564dafe544b080ae83fb233","3e36b9b34c