{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SHAREDSPECTRUMCHACCESSPARAMSPERBAND-STOP","paragraph_zero_based":36552},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36554},{"literal_text_all_w_t_and_m_t":"6.3.4Other information elements","paragraph_zero_based":36555},{"literal_text_all_w_t_and_m_t":"–AbsoluteTimeInfo","paragraph_zero_based":36556},{"literal_text_all_w_t_and_m_t":"The IE AbsoluteTimeInfo indicates an absolute time in a format YY-MM-DD HH:MM:SS and using BCD encoding. The first/ leftmost bit of the bit string contains the most significant bit of the most significant digit of the year and so on.","paragraph_zero_based":36557},{"literal_text_all_w_t_and_m_t":"AbsoluteTimeInfo information element","paragraph_zero_based":36558},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36559},{"literal_text_all_w_t_and_m_t":"-- TAG-ABSOLUTETIMEINFO-START","paragraph_zero_based":36560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36561},{"literal_text_all_w_t_and_m_t":"AbsoluteTimeInfo-r16 ::= BIT STRING (SIZE (48))","paragraph_zero_based":36562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36563},{"literal_text_all_w_t_and_m_t":"-- TAG-ABSOLUTETIMEINFO-STOP","paragraph_zero_based":36564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36566},{"literal_text_all_w_t_and_m_t":"–AppLayerMeasConfig","paragraph_zero_based":36567},{"literal_text_all_w_t_and_m_t":"The IE AppLayerMeasConfig indicates configuration of application layer measurements.","paragraph_zero_based":36568},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig information element","paragraph_zero_based":36569},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36570},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-START","paragraph_zero_based":36571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36572},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":36573},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToAddModList-r17   SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayer-r17     OPTIONAL, -- Need N","paragraph_zero_based":36574},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToReleaseList-r17  SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayerId-r17   OPTIONAL, -- Need N","paragraph_zero_based":36575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cd2de5a25272b1be4239b9aaab548efd963074093505e915694e1f27d4284f72","8ef454bb32399c772b53c426b582139c320e8f60120e48dcac653a5afa4ca11a","89c787638bd060db07df150580dba50a79e29e406ad1584ca7490ecc5f491fb3","64e426ef8cfe089a51bb65c61ea7961de032398a6618595b3cc0f488008727f6","6209789689ddcc4d8961eb7a42d34d298b912490ef36da7555b976d36503baad","cfd585f4003f1c1288b445d44154136d036e905dca6bcd789db7c6773726ed9c","241ef3c461ce489945359b14e32354cf8253c25fd3db2d2398dccdba46b6cd65","b7b1c1c676f0f4a6c438a30ac48f4444f110e9edd34831fc1f56af8ff2c1a202","66ed3a76cb7f8ef5a7ab6e6c98e532b83da585bd5811c27855bf3a55ef9e983d","ee096fbb6cf0d2c77e71b73269d002ae200954f1905aa8090407fc94df500a52","77188ce958ad50e902e3907f655ab4cb5157c9fc3885f60e97591f2b27bc2b66","999228c25cafbfcd1cc12f5b5c5f420071929803b9e16d649b7303b765424990","2f958a83b721599238f0a0b2659910f2e3593635bf2e33ef13f326e57f38ff96","ec3c2ff568729527ccec11038deaf7449d9