{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39576},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-STOP","paragraph_zero_based":39577},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39579},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config field descriptions","paragraph_zero_based":39580},{"literal_text_all_w_t_and_m_t":"sl-LocalIdentity","paragraph_zero_based":39581},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the L2 U2N Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":39582},{"literal_text_all_w_t_and_m_t":"sl-MappingToAddModList","paragraph_zero_based":39583},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be added or modified.","paragraph_zero_based":39584},{"literal_text_all_w_t_and_m_t":"sl-MappingToReleaseList","paragraph_zero_based":39585},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be released.","paragraph_zero_based":39586},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-RB-Identity","paragraph_zero_based":39587},{"literal_text_all_w_t_and_m_t":"Identity of the end-to-end Uu bearer identity of the L2 U2N Remote UE. The value 3 for the field srb-identity-r17 (i.e., for configuring SRB3) is not supported in this version of the specification.","paragraph_zero_based":39588},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelUu","paragraph_zero_based":39589},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on Uu Hop for uplink transmissions at the L2 U2N Relay UE.","paragraph_zero_based":39590},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":39591},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on PC5 Hop for downlink transmissions at the L2 U2N Relay UE and for uplink transmissions at the L2 U2N Remote UE.","paragraph_zero_based":39592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39593},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39594},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39595},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":39596},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":39597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39598},{"literal_text_all_w_t_and_m_t":"–SL-SyncConfig","paragraph_zero_based":39599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["21aecce1ad9b0c0387372323288eaee86f340db7412d7b2a879120cee13a1c08","c26bef54d05f2412071874ff6ec7b2dd8a7ce07159f6d515180bb0bd161f15c8","4745a48163e464cdbf0d0ae3ba11fdad6440bf6ace58d2a79a50bd490b4499bf","fad793d7e116cc8a56458a44d2291ec97d441210b5fa8773238e49b49bf262ba","3ae560daeca34c26f7e1d44abef3e7c81bec080ce6a37c7387dad16c17296d1e","f248a01e146d0f763e8a2f7244425e89079e1f6175320a83a52a7ff07ca150da","ad93e0abc036b8c6788e1e92a83510a6488955c8d3a7091f18cc0dfdbaa39351","f94159466fab10f5547883fe32b41b254ac95a8472339686e2a102b6cdbbc8f1","fba427f9efd2593c392c642851f76ce0b8abe82a18631054140c5c573c0d3e0a","bb44afdccddcfcb5937393ae0ce67554aab94c015f56073b5f487fe81225d88d","46ad4e8a21315c1130e15e274637a5d980681280dfc10c4054