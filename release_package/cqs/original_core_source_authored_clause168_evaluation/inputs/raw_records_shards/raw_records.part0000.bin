{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"(Incl FR2-2 DIFF)","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"maxMRB-Add-r17","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"Indicates the additional maximum number of MRBs that the UE supports for MBS multicast reception as specified in TS 38.331 [9]. ","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"mcgRLF-RecoveryViaSCG-r16","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports recovery from MCG RLF via split SRB1 (if supported) and via SRB3 (if supported) as specified in TS 38.331[9].","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference-r16","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference on the minimum scheduling offset for cross-slot scheduling of the cell group for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication-r16","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports mpsPriorityIndication on RRC release with redirect as defined in TS 38.331 [9].","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["2d2fd940ee627051f76de25029c1a770fec3c4a345a268c91c5387abb65de47a","0c6fad53b8a4f16467fa5ccd32e201672a16c6051cac4b428d463be4436034ed","7cb8e53ec428157c494ad03e6237ac30c608b8c70f18e06bdfb96ee0f384c471","b520057c4f1762ddae715cb82e1536a84c3920d7037a1c3abb436d5719bb46ad","c37a3474d55feaacc623134e1c000ba67d103685dce85c86ea6b71406f3b4245","b3df315885a1c8bd6e013e27efbc119959efcaf6c4ccaa4cff8811709ae50020","9b3b1f45ea452e586a346d66f00891e0b5c0b9a480fb210eeeca962508053f30","968f537f26f70abbc394eacb97145b900023b776fc0fff3c9f22d42c52106553","8aa84defc335fd02ca3fb3f101b999ec4fb0d4f29c6d0a8c3d5c7a8ecac2d41b","30a0f7e814aff382955400d47bcc9f9c299512952e35f20a0b13ca8ac34ae5b4","94f05c16c70f6d96c7e12f9776c0ae54c287a85d25f552f033ec61e62b680a42","d9c0ab02d1ae90113bb6a469919a5dacbcfed2413650aeb701b64a067b7f0311","9c19f34ee4b9b48448b35124ca846bb520a71a8ec823ea2cdebbcf43db9ffe8e","233e3c83b63a596b6ecc62d04a3986ca93247f16f3d9520638f7d49e5362911c","f1b1cb118953bae11f04a44706b7daf1a6572ba14332e585424c9ecff425c23c","b6a31781c74d907ff47443cc71f9da4fb07aab56cf26372ea5e55ea2a9443fdb","822e5ed210e5ef0354adfb7dedbde7d23ab00f45b0f11320bba0ddaf7199519d","c778395727d72161d3975ceefcbd7034408adaad1376120e00a355d6e506d553","d5468b2bd1c2be70ecb857c5876ec9c2ab4c67cfd91677308142892e64a0e1b4","6ab9f50818de58afe3b62440eef3f5bcf361a1c74bc320dceff5a55b8bac6148","d443f4cd14b3526cc74c451f6e7b9e659da772d9a685e3f125b6a4c1a7da046c","784235dcb1fe6e51972e6f0629f5fe8da2336e027bf8ebc5807040b44243cdb4","b55463f7bfc781c24ba4e8c62fdb640271bd8d2257a78ce60778be9d55cec110","841c723c3ddfcd6d60b683a2e1d5d2ddfb62fb3293901e71819502050db5ab39"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p192"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"multiRX-PanelFR2-Preference-r18","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing multi-Rx panel operation preference for FR2, as defined in TS38.331 [9].","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"FR2 only","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"musim-GapPreference-r17","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.331 [9]. UE supporting this feature supports 3 periodic gaps and 1 aperiodic gap.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"musimLeaveConnected-r17","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing MUSIM assistance information with indication of leaving RRC_CONNECTED state as defined in TS 38.331 [9].","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"nonTerrestrialNetwork-r17","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports NR NTN access. If the UE indicates this capability the UE shall support the following NTN essential features, e.g., timer extension in MAC/RLC/PDCP layers and RACH adaptation to handle long RTT, acquiring NTN specific SIB and more than one TAC per PLMN broadcast in one cell.","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["35b0b9dc5d0e553fa6a3fb23efddff107334f48ebbb493af0dbefcee39e6f563","134c24b2c1cbe282c3cc4c1e847213db7bbe306fd88a401ec9b32c155aba0505","8929e276df5c13d0a45fb677b7fd7267789b03a31e98e4aaffde9ae0e45159db","51986b1a6aff50eb4e9ee5f949cd916fc1c0da7759a8a3b1558cbca2e69c0457","7481da1c0242df734ed1439c65f4580b705a78918728acd170d00341f4ad2092","6c957cf1a854bcf4688b0cafefeeab35265cb3be7aea5666f515249596667849","50689156f5daf8e9ff2a2d11821ab72ad47d3eaec4ae235ca67a1db095315d3e","3ddba5e380fcff1b16a891cfb702e843eaedb7fa83a633446d459bf72e8b259b","1c7692a234fa0e20624d16c87dbd429974eab5cc500e6638727c8b23cf6e78c7","79bfbe67f06a8ecb77a707f0beb3543f665336768bac64b0933cd9e28b2dd1c1","3c1a41b2a16678db30bddd9f76181b11356e8ebf6765c52b71852ee4cecdcba8","4d1cfd7bb2a7b9fbaac802ff7cbc414703dd0f36e5a8a341e3ae35d2ecc21e8c","d7d027492a664c8b9641c2c68627bfdc569c16c49949a6a0ae1960baff4ab378","131fd1acf2c01ef449bef9c8476877a027de7b72bd82f29c568443b796a8d478","3c6a17d1867b9f7a179d30b8e7d27d1b89ad955e43d5e09fe1aedfb79399a271","f6d4ff62ea19f095979ebfc8ae2b9d6fdb58954adeb3a774e70cfb66472dc59c","f561e3e8b292e056debb68507c9c45a26d410c34cb958a10f1f6506035046725","951140f6960afdf6b637e09d3bc4faac8bbf038c93664844d0dbccbadbf0c85c","e55afe980b9c7adb5123f158b55f411f1a8da441a10b2ad069ee5a1d213d531a","3b58855a371a59f5f09a2c7e874ca4bf0717dd9ceff768e02315f4cb436ca319","af4ea878bb547ff1a71a71cff342367f41cb7ca79a5793cf63e8684a8bffe947","c7403e212f46f2ba0ffadf42bd98f814fc11fdd141304ade8ac611aab7311ed9","5ae3817ffb8b442c47df0937b88245652bf3596c5656f09a20b21235c6ba235b","034987c3fc20880b23ec24eecc20d81da3b460046a5723f321f34e90d904cbd0"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p216"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"ntn-ScenarioSupport-r17","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the NTN features in GSO scenario or NGSO scenario. If a UE does not include this field but includes nonTerrestrialNetwork-r17, the UE supports the NTN features for both GSO and NGSO scenarios, and also supports mobility between GSO and NGSO scenarios.","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Connected-r16","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the on-demand request procedure of SIB(s) or posSIB(s) while in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"overheatingInd","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports overheating assistance information.","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"pei-SubgroupingSupportBandList-r17","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports receiving paging early indication in DCI format 2_7 as specified in TS38.304 [21] for a list of frequency band. The UE shall support UEID based subgrouping for a frequency band if it indicates supporting of paging early indication reception for the frequency band. The set of OFDM symbols within a slot where UE can monitor the PEI PDCCH in Type 2A CSS is the same as the requirement for paging PDCCH in Type 2 CSS for IDLE and INACTIVE mode UEs.","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["2ce767a68865f04113a58ebc08a4b9b8ea9a9ec69dbb98aea6acebb7d7524ebd","5ea909906245ef585387af3175db2599a4d515de559672f907ca04ca9b193508","77557d13da17413541b01a5f0c87f9ce4efe2f355cc6f79520785ba7c50adab5","6115839a3e7c24c9cca979b86cf0946229d04a32d4cc591cbc4caa948c391c67","7ace6512103abfaa627678c8027161abac47ba8e6146983baacc0913b17ce187","6c6265696e97aaedc8e54377cfd746a53095e517e74d1087a8bc299bf22f2b49","fc23dd8403fe5f479ea89072eaf0f65da38b93de4f502408e5e815d433996e8c","ef0442ad69b79829e2ebcb398d965faedd0d45bf40eeef26b00534addc4fcba3","510a295017669b9374019b8c34601e778228b7651d479183286ba29619044ea0","8f1b2aa71232c1d2065011c492a11e371924f009ee88f27725b5309e2ef08b35","e7df5372585f046662cefb19d6b7f8163af6e6fa09f6a12384fae82bb3a4181e","ccd049f6f26581063b7aa331a6b0a93e863d66b0267ec22d57258ca312002cde","076430fab31a39824f8ff20056265c287954354b09a09883347c72950f976bb1","c4e70533c43e126fb768a6bbf192ccafba78357c59374f34ff0dd853950f97af","de2fe7a0ac1896a71eab41c09fe25793f2a31367a30284b33f42182cca118e33","76651cfa4ecd8308fc09fd61bc241e89e007705f9c943de26bcbbf562e9193e9","1b8f1bac353925b4f3cd950efff6163bd530e781eb3aa9a55fd90cc3894d41c4","286f56eb9deb8c723314952516d47d9ea16d05ed22fcaebfac0055908906dcf5","d531742e0f2dd6450ad93ec0e28d350aa35b4f490e34190d5ee759f1709fab52","a184192497c141728a5fe289bf9ed2a1422559c2a7a644141298096594ee11b2","f70096a184cb29482258b42e62b0476d4de4fde70d05cd46dd4d838bc5f1db39","c74df9ba5f000ef9f3b3dff4b29d34bc86ac89d07900be25551dba157230c589","a67db7e2167bf91b5e910744140b69ee3e0b9f9bd251a07b9873503cbff38a95","26fa3741af53d5dfead00e9d54aaf9b388de390a908e6affa4851a4aad12af72"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p240"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"partialFR2-FallbackRX-Req","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE meets only a partial set of the UE minimum receiver requirements for the eligible FR2 fallback band combinations as defined in Clause 4.2 of TS 38.101-2 [3] and Clause 4.2 of TS 38.101-3 [4]. If not indicated, the UE shall meet all the UE minimum receiver requirements for all the FR2 fallback combinations in TS 38.101-2 [3] and TS 38.101-3 [4]. The UE shall support configuration of any of the FR2 fallback band combinations regardless of the presence or the absence of this field.","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"ra-SDT-r17","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports transmission of data and/or signalling over allowed radio bearers in RRC_INACTIVE state via Random Access procedure (i.e., RA-SDT) with 4-step RA type and if UE supports twoStepRACH-r16, with 2-step RA type, as specified in TS 38.331 [9].","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"ra-SDT-NTN-r17","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports transmission of data and/or signalling over allowed radio bearers in RRC_INACTIVE state in NTN via Random Access procedure (i.e., RA-SDT) with 4-step RA type and if UE supports twoStepRACH-r16 for NTN, with 2-step RA type, as specified in TS 38.331 [9]. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"redirectAtResumeByNAS-r16","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reception of redirectedCarrierInfo in an RRCRelease message in response to an RRCResumeRequest or RRCResumeRequest1 which is triggered by the NAS layer, as specified in TS 38.331 [9].","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["b6c2c187eef4dba6686e37a1e29f374580ebaaf6904cddd53608c0e4926f0be6","958ad20bd657bd1e4b2ad455f476bf582b6bec14d63ba8aa25026732cdd97d68","e81203a44f3f1e77fcaeb44d5256ee422bf62df7f1dc34e36e0b15cb06064887","48445ae12a62ca59e49ad046c54486704471e0d9afd0ffd11098bb6aab458bc2","139395d3fc6d8df040e545404d8c8c8670a0552f2ecf067890a5a52519a3af97","29923355c0da9de417aab063b35222dc410f888bcde749a26e924cc3f2a0dc8a","c7357121fa9e162fb6a7023a4299d677e89fc6b9b765de6beed8941e7e274c18","5f182771db9a8054766089e7a072cc88acf1706e3c4ffe7ca13604cf85c637db","e99ecf8170493d37a34283bd6e5bc70da23be23c5e3d1a51f9a2a21ff9b0b091","cd588157e6465f2fb6df63ae6211f973f9e34e223fb6463d51b0e0790d2fdbc0","916ff84b2006ac33e8b850ac04baeb005536a5e8fd9ba9480b84174dc18016a6","0c89c503c231b1c1eff3cfc1522f691841b8b195ce9cccd39c1c5d95be60b632","1fae3eb73e309d8ba97ad51a427823036f7759b5386840035d6927459cd24bb1","b6fd2391d27b999eaf9d245f09b4694c4c07f1929c3c60cf23007aed918c8653","d707b50c3749f3eb67a3ff9af9bce66d66285676161bbd8c04a53a660c1feced","1b185e1344d3e3f69ed6bc60962f16d8653370eb2faa681784f38a82a03f5bfa","a0d58b4e4231f6413d718788a5b320bf0f84021b0b34da3f63565e3a42d581a2","bdc160c6630ed698ee20e3570ecb5cc949fb5a994a8206d89fce47157b46d411","f854641435059e1be2649b8f176f44675dc1f472f3253e5fb69b6f5b22d47947","c586e394fc3cfa6b931a25623c7e03c4dddb31c4c1c44a889d3683cf27ee8a7b","6190f76e1b0abf754103af1d9838630d67073bf8fd37e73e75adf5b467e11b95","0581828ebd1a00c4473e3f33bd6520a12f6a980e1c182ad0724e4ea8937079da","13f1d1354b206ae141f6ddca0470c1b7e444d5cd3e0c04c8eb846fa45f664774","7b0dc70bb8a8cae09496ae4ad39e90ecd4787d5f56a85bea17f825f455455300"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p264"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"reducedCP-Latency","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports reduced control plane latency as defined in TS 38.331 [9]","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"referenceTimeProvision-r16","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports provision of referenceTimeInfo in DLInformationTransfer message and in SIB9 and reference time information preference indication via assistance information, as specified in TS 38.331 [9].","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"releasePreference-r16","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference assistance information to transition out of RRC_CONNECTED for power saving, as specified in TS 38.331 [9].","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"resumeWithStoredMCG-SCells-r16","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports not deleting the stored MCG SCell configuration when initiating the resume procedure.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["5e2d94afe64fe0167d3cb2bb83d24a1ebf849bd4a5bdc4a500fbbbb35c873cce","c6d9fc5379c16cc604346f7e434449efbcb6e6f858c18a72b67e3c2334e1fce4","55c2f20eea15f61e68514e2b4fb237faa548802a1506445edad98363decfd9da","5f4f80f7ea322608366ab135e992af9f90c30631557e52558d6e682b889a6891","ad39c84179c561b8aeaa6aa8be4b57cb24f8fcc57852a459932382f777c66850","4ab730da1da17077b175d02371809441de9f9b1043aa718317522b9f1a2bcf91","d27f3375f6131b478c81ad67f7e41dcafd1438e30dc9a6edd7b15b1fc20c07e8","c648f73f65c2549e8fee4541dee9d89aa8bda32bb7e5c0a0fd5a387721c710bd","b03f735fef1caba3ed6d963a57a035f7e3d9fcd5493703c923a560601d65776b","ff85cd5fe2ed4d52612ac6e6872014047cf656e73ee9a657297534d039924492","668db469b66fa7ef2a2ec4389b4554ee358b0bfbfb54ad2366d2f4bb24305b96","c4c3e8ad4dae3710f0635946950981f7a61361ae9f1a107d6e262b180d15f4cf","dfda7dba424311ddc0d7bb245ce0e2f713e01a77eb266d45f3c043cb463f3381","71f840749cbbf61f0c71764857ea21f6670ae19141b05c4105dc85efea636fc0","07b534a2b3aa95771ecb25438fa797d949951ba7edcb7b2de16bb2ecb5fcd40e","aa24453de45e86093cd2f10a387207ec8b22b3a7a5547509fb2bfb4827bdf91c","38436fee16e5e3c464872927fbe18c3cc08200558c828da6ec2c97b3db6b4a2c","70c0317a2eccef75d120c6aa436a8edf45f529d59d3e9eb8e5a68b2c134ca257","3b805d17e45068ec636f2a0de6b5ee691fd8835d382ceba533906abfcb6cf20d","536e407725bb5b035b9a336130d3b21c0f098abe2a5e51edabd7b274d5377a56","a5557f0618608618943ede588392322b24d3a4b32516b56aa86ea7b0f85d7fb6","de231534972dda329d3c4e1348bee756ee7e2ff7923679cfea392a27fc7fad6f","1b9ff3a2b079ca5d4ffca4f95ef751003457c8340d769a2af24451ce8efdd461","5f1ca0b6b1ff7d6277c7d93292f13e6ffdb080bcc37e6eea722e08acd515c546"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p288"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"resumeWithStoredSCG-r16","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports not deleting the stored SCG configuration when initiating resume. The UE which indicates support for resumeWithStoredSCG-r16 shall also indicate support for resumeWithSCG-Config-r16.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"resumeWithSCG-Config-r16","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports (re-)configuration of an SCG during the resume procedure.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"sliceInfoforCellReselection-r17","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports slice-based cell reselection information in SIB and on RRC release for slice-based cell reselection in RRC _IDLE and RRC INACTIVE as defined in TS 38.304 [21].","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"splitSRB-WithOneUL-Path","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL transmission via MCG path and DL reception via either MCG path or SCG path, as specified for the split SRB in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode).","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["f3eb1534a01c1db91ce3e9c90af2ac24185d3000e014404332904f01f50b7cd1","9282ba1d4ffd3eab15138470fc7410a9b0562938f590fd6be0d760d2ba330c22","a7195fd9eccd93d4163c6e837e6a76fb85f2ae6bdd4dc2adad512733c2dbc30b","45b8d72f36b0444ba56981b18e8b8ba08ea4e5af5897994367779af7125438e0","42f44741119602e6a2cce856b4319c13d23d74e93419e34864ebd6e3a6bfa68c","a882f4dfad28d42c99fc59af5861aba05880ab3ed44662aecd7bff72495218b3","3ea70fc562383dd7442568fae8c0bec0ca3ee0bb6a1a6d32df341dfe6432082c","a32bef6af9786e4444eb3afd16efd47197dba0be18721e225527e6372809ad6d","dc7c248360410dd71de047bbf5b24ffffa552690df21286d84011e8eac4ef26e","c9c59ff71bb550f9a3b91128310ce13310ffe6bb52c1036cec391e65ca3d1ea9","86bb63fac9423be50fdf379bde03841f239f9c34296490229648d3e249ab8892","84c13e9dc6ee9c39fba6a45f7890434828aaba904101d59f98f3da36343aa7af","314d0fd6b52208349e9995eed6283f9e5e9416db8a7bbb6460c1c2b0473cda77","ad59be08d05466e2be52d633d2a16a7915c7d816257d98705b1359e4c9d4bf0a","bd611fc7ecf1cdb061b3c3486308a0e0de55f820cf22d11a8b0f59382fb767a5","a2ba08b997cdeb5f3b1e07d36dced07937018c8dfc02f675bf826b543cef07dc","dad6f41f72c88b9f59cc3bdb38e586ca5ba3a504960316789e57e70e27b9194a","71c84205ac1bb9b483cee858e8317b5d2278fb353039c4bdd332f9c75c02402b","0b15c8bc07895899145fa8e2a7c1df01c7d45c5a919fddb31a6fcfd0899d1708","5e1421e40c0c52fc23ca9fbc50541f2be897f029d676de54c490ba3369879aac","ecf127ef9f4d78925af1fe96b33620399e57b2240ff44a1967c9a396c296ded1","3a3af0f7bba4c82fab7b189e25fec5fa6f6716903548e65879706628b7281969","17a01340f37ca98352adc7ecb46a537782ffc15c18436564645b011195261d80","a7d9211c8b11e3ff50a7fbc9b3daadb6adf77bba22378d7613b37b2bbbbf0e44"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p312"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"splitDRB-withUL-Both-MCG-SCG","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports UL transmission via both MCG path and SCG path for the split DRB as specified in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode).","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"srb3","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports direct SRB between the SN and the UE as specified in TS 37.340 [7]. The UE shall not set the FDD/TDD specific fields for this capability (i.e. it shall not include this field in UE-MRDC-CapabilityAddXDD-Mode). This field is not applied to NE-DC.","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"srb-SDT-NTN-r17","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the usage of signalling radio bearer SRB2 over RA-SDT or CG-SDT in NTN, as specified in TS 38.331 [9].","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"A UE supporting this feature shall also indicate support of ra-SDT-NTN-r17, or cg-SDT-r17 in NTN bands. A UE supporting this feature shall also indicate the support of nonTerrestrialNetwork-r17.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"srb-SDT-r17","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports the usage of signalling radio bearer SRB2 over RA-SDT or CG-SDT, as specified in TS 38.331 [9].","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["189994574bd7b4998619f8ede99dca8da8c1c6680f4f5feff110b49c744d2ac4","5070e651400203fc5489ebfad0613b026cd0f7ae1b9e8ceb25434630999055e0","0d39b4219c108f4e668ad2d87ec7b68685e49b0458988c0644e18ebdba13dd19","acca17d067a569f181d79963f592eb6d86c81e1686ab285756b3b4f6404ba6b9","b6b3f8923bbe1c3b4035f92f9755ad0b975fa59f6436e31c23db60d53f13f8d8","7b27fb5d6b108ed796b88548c68bd9fa54046a295acee099c1bb77aca5062ef7","e374e2db35119d875617c3442b09da2c54bd2cb2ca8bf5f58fcdb75d80bebd3d","446c67a556e1ef82be1905a098f428dad03bdbb657ab93f02345d18fb6808b58","df86301ee446cef73c5d54889477c3e910308d2caaa68f11e045d69c1ac037e1","736003f4ed7d888a4baa526facf0194cc0e9d8d1d42874cb2272b0a617ccdc53","130fd3896de7bc47c7339780f258f790ab4483d95b0e1f5f118669f1a84023c3","fc885dffe69b9c1fd1906d9d8bbc4a25999c3f8f69e91b95f609f4061cedd26e","6ee59cf895f895b18ffa206acd2cae7eef857193a0dfc2a8b58ac16a7e6a5bbb","d0bb3de0e4236502ebee1b2b22bc52613613460ce3e3a9fac0ca2149528759e3","600d334ccc1c42958961d81958a738e30a7a9373b4e6cf1146f2b970bcc16bd3","7df990993becc4d818ab711eb2524d15123fc3bbafd68d16d34b30d32929d9a6","d62456e1b5c7e9ba2d3985dc07020408f866043ddc2e7307114717624606fb11","9fd7813f7277224a7408eb321ef66e5024b2abf3773d3dab344a9a701e771769","0ed3b579da8a76f20a1df3357cd67b8495ba8fb71759d16702b6b2129d44bcf7","4d48d173d92bff2a19e2733f43466f42ad1a4537638dfe0c3e5a58861301cf15","e166ed12aa7b3cb08c3e7113a3d3f498f9dc762491edd5c970ff40e7a5496e68","8889b1242cf4cf127976001d84e58a0d527fc85f9e3ec70b6b4bb5b21af5c6bc","6346e107cf9d8211378a3e78b1f3b85c1f608aee45c36b534ab65046fa110d4b","e38e0c9f6eaa8f020625922f10753ff102d6c36525f382584030efa87360a615"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311155.zip::R2-2311155.docx:p336"}
{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"A UE supporting this feature shall also indicate support of ra-SDT-r17 or cg-SDT-r17.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Pattern-r17","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"Indicates FR2 UL gap pattern(s) supported by the UE for NR SA, for NR-DC without FR2-FR2 band combination, for NE-DC, and for (NG)EN-DC, if UE supports a band in FR2. The leading / leftmost bit (bit 0) corresponds to the FR2 UL gap pattern 0, the next bit corresponds to the FR2 UL gap pattern 1, as specified in TS 38.133 [5] and so on. The UE shall set at least one of the bits to 1 for FR2 UL gap pattern 1 and 3, if the UE indicates support for ul-GapFR2-r17 in an FR2 band.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"CY","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"FR2 only","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"ul-RRC-Segmentation-r16","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports uplink RRC segmentation of UECapabilityInformation as specified in TS 38.331 [9].","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":379}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["b91a6b37716db48bca37dd4ba0d4d88795cd94b9e4d608f1de3ddb4e27dc31a8","cd76e78c7d31c24067a5ed5fc5e10216e33b038ce0a236fe08e6862cccf4067d","4bd8afb579bf80c229eabcea90cbaad3e7bef4804c8917c265514052b97f39e0","589064aee3f603869c1b7a9e0c0a66c865fc52200c1e3a6b04411213fa5c8fa5","2051011655f2faa1b6913a50eba0290226209b46141b1f13ac9f57607ffda40e","00fc837d6745994e4b32f3c849b13546010497d881d2164e5db81ec2f6730a31","ed13c58eab1212439718be5603bd6768e9566cf602516a82d31edde8259ef6bd","e863ca4cea6a265a7c6860bb0fb75b5f0443770e1343bc5229db91ccf58471e8","d6d613a4f8677cdad7ca80a71eba727d976ccc7cfd7fbf51c8a6c92916607067","0298274355d9fc90844bf256a1a3cd7f176089fe0b07e5f68bfa99b5af8f100d","9dabc9923cd9c92d85d5c668a61cb456c371f9074ccfdfac97bb0cc60bf15f66","1f0259ff289deda18731e80fe0aae720453114514fa17a92b0c4a816656636b4","814e3a68818ac67015d108b368ed96df7900af059442c83d6a266a33c13458a2","3f661a0fdc21cb285be4702b0cd5fa67dc4d3f58c07f015adad7a3a039e9eab5","9f7ad9a300ddbcf8fd8ff412d4e3dac1db5f347ee8a4c167f13940952ca85689","77657dd55027891ad53939f360726b5af52a12d5d32865e3eaa165c3a4ab7c8b","50c1f667ab4af248c943a6b431b22bc690e19603fc1721813c791eab83a9c268","7ab785db049c140f29c97d7ed5d5708bccbb1effcd9135fd064f73b086020c66","ec459cdd959748800c62aaf8e0592b732cd6e3bf2b3f694af70776b8902b92e0","b295b7828df73ec297f47f2b9b8dcaf74c29651c86e31a4b32a53e2f24cce35f"],"paragraph_range_zero_based":[360,379],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretati