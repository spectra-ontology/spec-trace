nd_m_t":"SRVCCSingle Radio Voice Call Continuity","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"SSSynchronization Signal","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"SSBSS/PBCH block","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"SSSSecondary Synchronisation Signal","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"SSSGSearch Space Set Group","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["81df5643a55d0f092cbdcd5f57d5768e7f8af1a5339c2e82af1b2ae43163946c","8e887a2c5bd54382ea0e6b87fbbe657ee7a2316c7ceb2e8c00a3260b3c90f348","0a1484bc6dbecac6a7d60a3b5389f85f536a6009d0f865bc752042f1ce5a5cb1","f8ccdec0a5b47f8bdf52a52d559abde4da532eb221f78540b9c578ffd4ae9217","30154edc1d264b42a0a774fcc3638929f7d849ffe4b2c0db6ff48d5e1cfe0a25","eeeca8105d2f16e4ebcb53f0438ae984858cc56e72c5d065cf29536f88bd1c3e","1dcd41be89bd0b85c743e452c3c0824cfeecdb543d494a2ff845188673450bb2","99d66f4b80b7d93561bc23b11a2a92162f9677a03328e4534b075326b41142ca","8eaf4036966232442015fc732d4fbf213237383de211a5387b0cedb7145cb91c","16958194c5ecd0917b22b515f42e8fe3ff4b16dabfea78c0396337bfa9bf0f86","6d84ad564e31f83054d705d621ff19e987b39a8230a5a849e589761f10b60bcf","e611418ca177fe831ee33cb4382708fa732700c5a88877721fa761d1175bb1b9","f1fd4dbc36e6f1b2f15293f2babe7717b9927cfcdada0b93a353c73ebd85c16e","013b82e4af064bf8d35106f294616aab4f9b06f8aa5281fef9ca7c158578794f","203bfc7d0f10960d33603f51741c9bc1095ff3a24272b19a1305f54da2c1df92","610a8944b74eab96d43192089a5e529cf8f8192d9019b274a0006a3943f131f3","be16a99ac0121f0ac80c48c90611fa09aeb989d67c51b806752cd54645919006","c2a73e68b7872e0ac5c27aa46545de6c3bd68f3096f964eb132f2c517b5e996f","5d5c92517