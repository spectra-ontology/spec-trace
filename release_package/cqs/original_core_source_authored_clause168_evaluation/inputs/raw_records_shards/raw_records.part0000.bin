{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Note, if this field is absent but the nr-SelectedDL-PRS-IndexList field is present, the nr-DL-PRS-AssistanceData may be provided in IE NR-DL-TDOA-ProvideAssistanceData or NR-DL-AoD-ProvideAssistanceData.","paragraph_zero_based":1848},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexList","paragraph_zero_based":1849},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resources which are applicable for this NR-Multi-RTT-ProvideAssistanceData message.","paragraph_zero_based":1850},{"literal_text_all_w_t_and_m_t":"nr-Multi-RTT-Error","paragraph_zero_based":1851},{"literal_text_all_w_t_and_m_t":"This field provides Multi-RTT error reasons.","paragraph_zero_based":1852},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations","paragraph_zero_based":1853},{"literal_text_all_w_t_and_m_t":"This field provides a set of available DL-PRS configurations which can be requested by the target device on-demand.","paragraph_zero_based":1854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1855},{"literal_text_all_w_t_and_m_t":"NOTE 1:Void.","paragraph_zero_based":1856},{"literal_text_all_w_t_and_m_t":"NOTE 2:If this field is absent but the nr-On-Demand-DL-PRS-Configurations-Selected-IndexList is present, the nr-On-Demand-DL-PRS-Configurations may be provided in IE NR-DL-AoD-ProvideAssistanceData or NR-DL-TDOA-ProvideAssistanceData.","paragraph_zero_based":1857},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-Selected-IndexList","paragraph_zero_based":1858},{"literal_text_all_w_t_and_m_t":"This field specifies the selected available on-demand DL-PRS configurations which are applicable for this NR-Multi-RTT-ProvideAssistanceData message.","paragraph_zero_based":1859},{"literal_text_all_w_t_and_m_t":"assistanceDataValidityArea","paragraph_zero_based":1860},{"literal_text_all_w_t_and_m_t":"This field specifies the network area for which this NR-Multi-RTT-ProvideAssistanceData is valid.","paragraph_zero_based":1861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1862},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":1863},{"literal_text_all_w_t_and_m_t":"6.5.12.4NR Multi-RTT Location Information Elements","paragraph_zero_based":1864},{"literal_text_all_w_t_and_m_t":"–NR-Multi-RTT-SignalMeasurementInformation","paragraph_zero_based":1865},{"literal_text_all_w_t_and_m_t":"The IE NR-Multi-RTT-SignalMeasurementInformation is used by the target device to provide NR Multi-RTT measurements to the location server.","paragraph_zero_based":1866},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1868},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-SignalMeasurementInformation-r16 ::= SEQUENCE {","paragraph_zero_based":1869},{"literal_text_all_w_t_and_m_t":"nr-Multi-RTT-MeasList-r16NR-Multi-RTT-MeasList-r16,","paragraph_zero_based":1870},{"literal_text_all_w_t_and_m_t":"nr-NTA-Offset-r16ENUMERATED { nTA1, nTA2, nTA3, nTA4, ... }OPTIONAL,","paragraph_zero_based":1871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["20a8723197c8619b1a9a4100ccd46d0d026caf6c53afb5b715b1a906e1b24f66","d188070524cb7d403c87dc3a58ead36e9723ca27dce5c97f55859a08cde99c28","b09036a6cce451a16f493c4f21a4e04f7d5dad0af1571c63beb2e4eb8ec6b1c6","f6dcbca072f970980662122e78eb43f5561e0b1224748145d23e5d77f13e805f","ebb797a1c40c7ca9eb788228c9e2ae7a651143bf4183c85419840a424f4257cc","fffe8fa6ac864a218ff0414b4f45dd66698cf3b2349dd8d9f51030