{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable L2 U2N Relay UEs not included in the relaysTriggeredList for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig (a subsequent L2 U2N Relay UE triggers the event):","paragraph_zero_based":4824},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4825},{"literal_text_all_w_t_and_m_t":"3>include the concerned L2 U2N Relay UE(s) in the relaysTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4826},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4827},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the leaving condition applicable for this event is fulfilled for one or more of the L2 U2N Relay UEs included in the relaysTriggeredList defined within the VarMeasReportList for this measId for all measurements after layer 3 filtering taken during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4828},{"literal_text_all_w_t_and_m_t":"3>remove the concerned L2 U2N Relay UE(s) in the relaysTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4829},{"literal_text_all_w_t_and_m_t":"3>if reportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":4830},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4831},{"literal_text_all_w_t_and_m_t":"3>if the relaysTriggeredList defined within the VarMeasReportList for this measId is empty:","paragraph_zero_based":4832},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4833},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer for this measId, if running;","paragraph_zero_based":4834},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable transmission resource pools for all measurements taken during timeToTrigger defined for this event within the VarMeasConfig, while the VarMeasReportList does not include an measurement reporting entry for this measId (a first transmission resource pool triggers the event):","paragraph_zero_based":4835},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4836},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4837},{"literal_text_all_w_t_and_m_t":"3>include the concerned transmission resource pool(s) in the poolsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4838},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4839},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable transmission resource pools not included in the poolsTriggeredList for all measurements taken during timeToTrigger defined for this event within the VarMeasConfig (a subsequent transmission resource pool triggers the event):","paragraph_zero_based":4840},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4841},{"literal_text_all_w_t_and_m_t":"3>include the concerned transmission resource pool(s) in the poolsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4842},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4843},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered and if the leaving condition applicable for this event is fulfilled for one or more applicable transmission resource pools included in the poolsTriggeredList defined within the VarMeasReportList for this measId for all measurements taken during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4844},{"literal_text_all_w_t_and_m_t":"3>remove the concerned transmission resource pool(s) in the poolsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4845},{"literal_text_all_w_t_and_m_t":"3>if the poolsTriggeredList defined within the VarMeasReportList for this measId is empty:","paragraph_zero_based":4846},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_