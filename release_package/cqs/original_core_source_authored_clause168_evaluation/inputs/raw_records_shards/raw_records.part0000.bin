{"fields":{"filename":"R2-2303915.zip::R2-2303915 Corrections on MAC reset regarding configured sidelink grant.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>flush MSGA buffer;","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Scheduling Request procedure;","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Buffer Status Reporting procedure;","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Power Headroom Reporting procedure;","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered consistent LBT failure;","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered BFR;","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Sidelink Buffer Status Reporting procedure;","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Pre-emptive Buffer Status Reporting procedure;","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Recommended bit rate query procedure;","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Configured uplink grant confirmation;","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered configured sidelink grant confirmation;","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"1>clear, if any, configured sidelink grants;","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Desired Guard Symbol query;","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"1>flush the soft buffers for all DL HARQ processes;","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"1>for each DL HARQ process, consider the next received transmission for a TB as the very first transmission;","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"1>release, if any, Temporary C-RNTI;","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"1>reset all BFI_COUNTERs;","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"1>reset all LBT_COUNTERs.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"If a Sidelink specific reset of the MAC entity is requested for a PC5-RRC connection by upper layers, the MAC entity shall:","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"1>flush the soft buffers for all Sidelink processes for all TB(s) associated to the PC5-RRC connection;","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"1>consider all Sidelink processes for all TB(s) associated to the PC5-RRC connection as unoccupied;","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Scheduling Request procedure only associated to the PC5-RRC connection;","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Sidelink Buffer Status Reporting procedure only associated to the PC5-RRC connection;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"1>cancel, if any, triggered Sidelink CSI Reporting procedure associated to the PC5-RRC connection;","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"bde1953134afc7232c3b85bbe56f17a18335b0467ee90fb1e9fe1e0ffc4a998f","original_member_sha256":"5226f282075a722b4cebe17bdc4641f967c0f2298a5db15c2df09f33f91ba38f","paragraph_ElementTree_utf8_XML_sha256":["ba0c3b8bf75acd9af93876fb3b02c1cd6b9b066495d7c5b2786fc9ff45b7f63e","258dff3368522f90e8540822264ed612f28383a0991c674b4a9bfc8115a6a027","9bc654faa4c2fb0d5e4a271e987f76e8a69e060663e20c3b19969792658b43a0","a3b80b0e20ef16791442fbdffbf6e54c41d6617f4f1e0aed9b26526d152b2418","648ef3d2d6afc5dfa7c5e044f306585ce8b9d622ea32a36eefbd