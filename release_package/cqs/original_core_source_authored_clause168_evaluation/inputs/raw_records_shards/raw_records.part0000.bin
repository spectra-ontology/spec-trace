{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        priority                            INTEGER (1..16),","paragraph_zero_based":19056},{"literal_text_all_w_t_and_m_t":"        prioritisedBitRate                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":19057},{"literal_text_all_w_t_and_m_t":"                                            kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":19058},{"literal_text_all_w_t_and_m_t":"        bucketSizeDuration                  ENUMERATED {ms5, ms10, ms20, ms50, ms100, ms150, ms300, ms500, ms1000,","paragraph_zero_based":19059},{"literal_text_all_w_t_and_m_t":"                                                            spare7, spare6, spare5, spare4, spare3,spare2, spare1},","paragraph_zero_based":19060},{"literal_text_all_w_t_and_m_t":"        allowedServingCells                 SEQUENCE (SIZE (1..maxNrofServingCells-1)) OF ServCellIndex","paragraph_zero_based":19061},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL,   -- Cond PDCP-CADuplication","paragraph_zero_based":19062},{"literal_text_all_w_t_and_m_t":"        allowedSCS-List                     SEQUENCE (SIZE (1..maxSCSs)) OF SubcarrierSpacing                   OPTIONAL,   -- Need R","paragraph_zero_based":19063},{"literal_text_all_w_t_and_m_t":"        maxPUSCH-Duration                   ENUMERATED {ms0p02, ms0p04, ms0p0625, ms0p125, ms0p25, ms0p5, ms0p01-v1700, spare1}","paragraph_zero_based":19064},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need R","paragraph_zero_based":19065},{"literal_text_all_w_t_and_m_t":"        configuredGrantType1Allowed         ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":19066},{"literal_text_all_w_t_and_m_t":"        logicalChannelGroup                 INTEGER (0..maxLCG-ID)                                              OPTIONAL,   -- Need R","paragraph_zero_based":19067},{"literal_text_all_w_t_and_m_t":"        schedulingRequestID                 SchedulingRequestId                                                 OPTIONAL,   -- Need R","paragraph_zero_based":19068},{"literal_text_all_w_t_and_m_t":"        logicalChannelSR-Mask               BOOLEAN,","paragraph_zero_based":19069},{"literal_text_all_w_t_and_m_t":"        logicalChannelSR-DelayTimerApplied  BOOLEAN,","paragraph_zero_based":19070},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":19071},{"literal_text_all_w_t_and_m_t":"        bitRateQueryProhibitTimer       ENUMERATED {s0, s0dot4, s0dot8, s1dot6, s3, s6, s12, s30}               OPTIONAL,    -- Need R","paragraph_zero_based":19072},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":19073},{"literal_text_all_w_t_and_m_t":"        allowedCG-List-r16                  SEQUENCE (SIZE (0.. maxNrofConfiguredGrantConfigMAC-1-r16)) OF ConfiguredGrantConfigIndexMAC-r16","paragraph_zero_based":19074},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need S","paragraph_zero_based":19075},{"literal_text_all_w_t_and_m_t":"        allowedPHY-PriorityIndex-r16        ENUMERATED {p0, p1}                                                 OPTIONAL    -- Need S","paragraph_zero_based":19076},{"literal_text_all_w_t_and_m_t":"        ]],","paragraph_zero_based":19077},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":19078},{"literal_text_all_w_t_and_m_t":"        logicalChannelGroupIAB-Ext-r17      INTEGER (0..maxLCG-ID-IAB-r17)                                      OPTIONAL,   -- Need R","paragraph_zero_based":19079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f73e85cf2bd4d5c454741d757629019384b44d4164b17d92769ece2a4495328d","98995a42e2a366bc623238c4d106fc91faeb36744b11f43bd8f7f3b26f9a322c","f26ce69161ca696b40ec67f91e37a2712f0641e7dc7132beef6100b7770bf5c9","fa6ebe673944a881bae42331c3e497951f10f63495ff17e9b21ed2133ebd9fa9","4f96c85c2e80ffa02c7d238ec824751efb375bd905c345f5c74f9bc2b86408e4","79365c3a268e94f2399dc59a2bb661e348ed7783eca58f98f32adf7bc8d71ad2","c0d066629af04265da329d193f7ec943145887cbbc7dc9169439d27af4fc79bb","11aa1fde8c910de95c9a66f3ee9930ee48c428fd1c107ce45d6c0910703b87a6","57a010d07c8e7d1b32312d719ab9204f869ded9c306775bfac6f023818b5f786","3c9fe11561d4c2aaeb128b3dbb4a4d8ccbdd23feaa755d06fe03e97499e92012","8c186f753a5e679a1ebe60d828bead8dc4836776d6c3b9f6cd8ebfc89d56af91","07b60b13432a5b5b7ed53775215f2abc9696b4a6b5f72b968a14347549fc4205","b839a6f454e95d7409c744f143bb2d92454376088f557337f9f43033ca3a98f0","844e84c8aff9b98020277e7e1fa36127ec10fa7e148489f53bdd284ff416cab7","c6d07b49713f0c6b96ca006b57cf201cd4fec6ca8e1156d753a52343504d76bf","48d17586fe660a8b0be2880240038505f677b8cb8d63ef9d24fa46279646641c","eff2f16cc9d625ce4cfdb2394ba804df574446f842f4197a586a2306d43216cd","a76bc2a94610422100d219de13facb503cea94fed1d9e63d7df6ab7c2c1e9bf7","baee41ed39bde5f138b966b9b8d623a775a1c12d3dab866ea7315eb9165845b2","95f4a19d2d221dcd2809c99072dc9fe0e53f64462c3acd0421e2bfedc6c22a49","963474f70a1c8ef1b611a8a787d233d0f58c3c90168d2a9196333312c1f430d9","bbbfcc42120ff1dbb71d3d0b5f1c14e8eba080efa5724b305af0809bd637538f","69efc191f698095ceeb2b1aacd1dfabf5a525f6f919539fbf50b2391a1bdf8be","7fc615689623dfe5594a7b428283fdc8b94348ff2645238f80a1de0c615b4f61"],"paragraph_range_zero_based":[19056,19079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19056"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        allowedHARQ-mode-r17                ENUMERATED {harqModeA, harqModeB}                                   OPTIONAL    -- Need R","paragraph_zero_based":19080},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":19081},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Cond UL","paragraph_zero_based":19082},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19083},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19084},{"literal_text_all_w_t_and_m_t":"    channelAccessPriority-r16           INTEGER (1..4)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":19085},{"literal_text_all_w_t_and_m_t":"    bitRateMultiplier-r16               ENUMERATED {x40, x70, x100, x200}                                   OPTIONAL    -- Need R","paragraph_zero_based":19086},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19087},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19089},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":19090},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19092},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig field descriptions","paragraph_zero_based":19093},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":19094},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any configured grant configurations. If the field configuredGrantType1Allowed is present, only those configured grant type 1 configuration indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":19095},{"literal_text_all_w_t_and_m_t":"allowedHARQ-mode","paragraph_zero_based":19096},{"literal_text_all_w_t_and_m_t":"Indicates the allowed HARQ mode of a HARQ process mapped to this logical channel. If the parameter is absent, there is no restriction for HARQ mode for the mapping. This field applies to SRB1, SRB2 and DRBs.","paragraph_zero_based":19097},{"literal_text_all_w_t_and_m_t":"allowedPHY-PriorityIndex","paragraph_zero_based":19098},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a dynamic grant. If the field is present and the dynamic grant has a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to the dynamic grants indicating PHY-priority index equal to the values configured by this field. If the field is present and the dynamic grant does not have a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to this dynamic grant if the value of the field is p0, see TS 38.213 [13], clause 9. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any dynamic grants. Corresponds to \"allowedPHY-PriorityIndex\" as specified in TS 38.321 [3].","paragraph_zero_based":19099},{"literal_text_all_w_t_and_m_t":"allowedSCS-List","paragraph_zero_based":19100},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the indicated numerology. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured numerology. Corresponds to 'allowedSCS-List' as specified in TS 38.321 [3].","paragraph_zero_based":19101},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19102},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":19103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f08f58bfffd3ff8ebbde319307dd110cb23df2f2961152b49dadf39d75db106","192810e5fc60c63f0feefbe1ebd99e6972ede1484448dd917bef04cff26b275d","5657c056b9c5ed9f31a3e01815f6d8a60502e239e5bf494b87225415dbe118b1","e4bf5b1567f38ab2394ab45a50f49754208c1736c37b665a3c3405bc475ce26d","1e6f1c08e4a51c680d963c6412db28b7a4e336b2577eeba459df432a9b719676","5b2e05ae83a2db7a8220302605e328a75abcb3793194e254bbd8c6d68e6b7276","3f84b1e3581e7482d105940f2046b83da0828cb7903cdecae662f163a5558372","1c4a465d3b42a6e8cf28947a2b476bdadfa19fc023d91858f8d27550dc034c72","fb019d426623975a86ca3bbfaff3aa8a998a19a326a40cbe03a0a2b1efb66ab6","270452f362f17f83fc5be26e1bc257d63f9e4bff8a11df5beafc6d55122a0a65","a1f42995598f3a9ede2d643544e9c6e8ac1fec957bcf043a660f69ac6132e2b7","759f21d00ae02435700c6fcb6617f8691616226b142a27c6433f007666e799eb","e90fa300f6076637c756aa8840a674e04239e447e6d03dfc6df826b2b51d52d0","8409d5e8a351a7ed6bdc03b8243dca2848def6574d869ecc6862f2395edd7085","9eeb0c09c12e2cfacb04eb57539fe4b51d2cd35fd26e8f6bf608d6756c9d11e5","8978115b4089468b449d50285eeb54052934362d9637e14f09091874259556d8","7a011e9fd830321a12c8556f7f7b39fba7ae70d07cf0bb35977fac8d79070bfc","adff6727b70c6834c4825bebd84d0dd59ae7a686ea3f9fa9a2e82a060cfcb8c1","6f72d48900a744a3f07954feaa5cf8c6da07ea8018888b5640635b53d3ceb97f","fe9433f277ac7d49d4fcc48fc7e60d1110c62d4be743d62cbaf377acac9fc76d","04ddb979c168e6c1535e0367526cb2f648662fd81899293d6d11ba8844e4d085","8d2f54490465918704dfd84ba237902ee744dc170fa1099c89711a9f8bd8633b","399f3c9c274d6f96bbb2a3ebd731e845beafe62821610444531d1314223693c7","a004e3b1eaf2a2fe62f411932d871ef013b1a39b36449389782dd5dd35236fec"],"paragraph_range_zero_based":[19080,19103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19080"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":19104},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19105},{"literal_text_all_w_t_and_m_t":"allowedServingCells","paragraph_zero_based":19106},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the serving cells indicated in this list. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured serving cell of this cell group. Corresponds to 'allowedServingCells' in TS 38.321 [3].","paragraph_zero_based":19107},{"literal_text_all_w_t_and_m_t":"bitRateMultiplier","paragraph_zero_based":19108},{"literal_text_all_w_t_and_m_t":"Bit rate multiplier for recommended bit rate MAC CE as specified in TS 38.321 [3]. Value x40 indicates bit rate multiplier 40, value x70 indicates bit rate multiplier 70 and so on.","paragraph_zero_based":19109},{"literal_text_all_w_t_and_m_t":"bitRateQueryProhibitTimer","paragraph_zero_based":19110},{"literal_text_all_w_t_and_m_t":"The timer is used for bit rate recommendation query in TS 38.321 [3], in seconds. Value s0 means 0 s, s0dot4 means 0.4 s and so on.","paragraph_zero_based":19111},{"literal_text_all_w_t_and_m_t":"bucketSizeDuration","paragraph_zero_based":19112},{"literal_text_all_w_t_and_m_t":"Value in ms. ms5 corresponds to 5 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":19113},{"literal_text_all_w_t_and_m_t":"channelAccessPriority","paragraph_zero_based":19114},{"literal_text_all_w_t_and_m_t":"Indicates the Channel Access Priority Class (CAPC), as specified in TS 38.300 [2], to be used on uplink transmissions for operation with shared spectrum channel access in FR1. The network configures this field only for SRB2 and DRBs.","paragraph_zero_based":19115},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":19116},{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1. Corresponds to 'configuredGrantType1Allowed' in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":19117},{"literal_text_all_w_t_and_m_t":"logicalChannelGroup, logicalChannelGroupIAB-Ext","paragraph_zero_based":19118},{"literal_text_all_w_t_and_m_t":"ID of the logical channel group, as specified in TS 38.321 [3], which the logical channel belongs to. The logicalChannelGroupIAB-Ext is only applicable to the IAB-MT. When logicalChannelGroupIAB-Ext is configured, logicalChannelGroup shall be ignored.","paragraph_zero_based":19119},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-Mask","paragraph_zero_based":19120},{"literal_text_all_w_t_and_m_t":"Controls SR triggering when a configured uplink grant of type1 or type2 is configured. true indicates that SR masking is configured for this logical channel as specified in TS 38.321 [3].","paragraph_zero_based":19121},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-DelayTimerApplied","paragraph_zero_based":19122},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the delay timer for SR transmission for this logical channel. Set to false if logicalChannelSR-DelayTimer is not included in BSR-Config.","paragraph_zero_based":19123},{"literal_text_all_w_t_and_m_t":"maxPUSCH-Duration","paragraph_zero_based":19124},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be transmitted using uplink grants that result in a PUSCH duration shorter than or equal to the duration indicated by this field. Otherwise, UL MAC SDUs from this logical channel can be transmitted using an uplink grant resulting in any PUSCH duration. Corresponds to \"maxPUSCH-Duration\" in TS 38.321 [3]. The PUSCH duration is calculated based on the same length of all symbols, and the shortest length applies if the symbol lengths are different.","paragraph_zero_based":19125},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":19126},{"literal_text_all_w_t_and_m_t":"Logical channel priority, as specified in TS 38.321 [3].","paragraph_zero_based":19127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0cc1ccee6ae4d3500c2b5f937d6bfb44b6be2244e80afdf9a054582f6cf61492","7530f4dfe65dd6d6c3cccd94e4fd0fb62072884a87aa07a1c0a07a5a13350cd2","f2dad4c5fee58ed2842183b20067de420053c6e0698bbbd56c81874c523212c5","3d8579026fabf0e1d90599f0d9e7d15f1c255f240230e2e160231f2681c30f68","f2e3cc1c4487662c99f06636d448d2af5c52a4027b7aba091344ca4ae4dccfdf","abec9349910b2bd3806e1e90e3af70d88c92d3cf9cb973ad212bf25965bcfae0","4cf75f714642bfd4aef320be7cc3fd68c9ce210ad82dfd35f9fe88c9d7175d66","398075e063dfafaca16f4b18d4d79525963b2f423de13f192ee934984b7a1b41","4dffb92300703698bed588666a751744d7fd621941b6f90f33faf6b6f13f9d41","13fa7a62f30c5dbfe799117cc41eaec958ff90650f09f1eac63f13b54a2dda82","f4e02e35421e2ea82991e77ec71fee2f9545a7fe6919b0524e5c7719f345c405","6c7493887d306f9a61bb2eaa73142d366190fc142a1d9558ada438fbec2c17d8","687ef98e2d23e4234b7f2bd7fe8f72eae1e1701f48b700fa2b1a1ad604bba7de","602cf47f75e7320c1466def44d21515b3d3aef2c6e29fe3c5982c0ffdc8c2efd","41b44a361c16560efa4d01532f9b9c46fce72fc9b370781aeb37bedcafd1be5f","f274c586f40ab6fad14e46e5547794bf30ccff887fbdb14aafce289d31caf8a1","2284ca371b75c2f4582a89833c238c373a0366429ad2da1217db487816ffc99a","58a41db54134f15ecd8b99f1b52b8a030d1b811e35a687e190ea84ff5d64d16f","35bb51908bf0c2ff62b8fb2d1131d8d8bc7bb60586170fea5e5e21ed9f43e0ae","ca673c726370757eb69f8d0e37d48edc056e3f3192b3691e6abd38375a9e6bc2","6e31faf04ae39e1767a2666e83a5d3e8a36d98ab5d0752e200148d2edaa392de","d60c6bd1341e5a5cb83ea6d0ef3bc1508a4b9a428c956756ef40ddb5be7972ac","1b198cec06dd40fb0a9e411eac4bbb954f689b50b2789a91e5da6e4f34f50654","a53792697040c76daa12ef76e5eab275f5ca1d34047743310c4562a086f45c35"],"paragraph_range_zero_based":[19104,19127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19104"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"prioritisedBitRate","paragraph_zero_based":19128},{"literal_text_all_w_t_and_m_t":"Value in kiloBytes/s. Value kBps0 corresponds to 0 kiloBytes/s, value kBps8 corresponds to 8 kiloBytes/s, value kBps16 corresponds to 16 kiloBytes/s, and so on. For SRBs, the value can only be set to infinity.","paragraph_zero_based":19129},{"literal_text_all_w_t_and_m_t":"schedulingRequestId","paragraph_zero_based":19130},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for this logical channel, as specified in TS 38.321 [3].","paragraph_zero_based":19131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19132},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19133},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19134},{"literal_text_all_w_t_and_m_t":"PDCP-CADuplication","paragraph_zero_based":19135},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the DRB/SRB associated with this logical channel is configured with PDCP CA duplication in UL in the cell group in which this IE is included (i.e. the PDCP entity is associated with multiple RLC entities belonging to this cell group). Otherwise the field is optionally present, need R.","paragraph_zero_based":19136},{"literal_text_all_w_t_and_m_t":"UL","paragraph_zero_based":19137},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for a logical channel with uplink if it serves DRB or multicast MRB. It is optionally present, Need R, for a logical channel with uplink if it serves an SRB. Otherwise it is absent.","paragraph_zero_based":19138},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19139},{"literal_text_all_w_t_and_m_t":"–LogicalChannelIdentity","paragraph_zero_based":19140},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelIdentity is used to identify one logical channel (LogicalChannelConfig) and the corresponding RLC bearer (RLC-BearerConfig) or BH RLC channel (BH-RLC-ChannelConfig) or Uu Relay RLC channel (Uu-RelayRLC-ChannelConfig) or PC5 Relay RLC channel (SL-RLC-ChannelConfig).","paragraph_zero_based":19141},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity information element","paragraph_zero_based":19142},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19143},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-START","paragraph_zero_based":19144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19145},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity ::=          INTEGER (1..maxLC-ID)","paragraph_zero_based":19146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19147},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-STOP","paragraph_zero_based":19148},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19150},{"literal_text_all_w_t_and_m_t":"–LTE-NeighCellsCRS-AssistInfoList","paragraph_zero_based":19151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["be385e2c9a638c434047e82f5db3a4c17ee6ce2b5a4189c1e8da9b7c1f31193f","0498a00cd5858d2a3f8d71898fc61390e39dda11a62f39622b7e276c8d4987f1","0f9c89b96e1608df722a6b95c9478f6f284318e70b0a9d78b3bb9b966dca38fc","4344e69b231574593aa3cba5c3a6c004c4c4738cdb4f73a4142983c89aece3f0","7c0e55bfb3840f4268256ccdb0d6a73e8a7068d2541ba7a1626a0a2a13fd0b54","c660ebfbecc8403344e340365154a6af26599724c6543e86f542a2c6c7b244a4","c4a7c2021ff8febe0afd52de8b06d8417d12bf47137ae07887997e99f6021099","290606e093f91acb694d057db4e628d7bf036bcb3b9d4369546c01410cb4477c","1974f0d1086d6d000d367205d691a38943973df718034455c65f743826f72764","c040639b54721506fad0237ff83edb2cb0abc5db1325b6d80d25b76a49b5f3a9","d256e688e881df8bbbb54cf29db86c0aff57db9207504fe3039d23404f69f5ac","1e46d37b45b717d7302177d08a425c636718238602e3720728892d5463eb4ad9","34e8b82d9ad71682ec92ed991b59e13024d6d3b84f3c2c80824848abe2699955","b65564d614e24f1ad17d4f9446926b89f6a00e9914f0b11719a16daec6b92b87","e08668a22096b3a4da42a49ebbd8bf3c2a84d1517389dd06137b5ec7aa2a7562","3cfe00f8e74ffe44855a91b25f5bec585d29f8a9ad0465a4ab2e38f4bb5b0876","96a0eb42e9696d5ffdcf6fe1770a873dc5d21c64675108fe3d33a4c83601fd85","fbf6238b20f6f44524d8f7669e49a40bc5c8a81b6dbda36946a01fee43178d70","dc2429779b1bc9322f240233b4e7ee1dedea9e4e92b97fa1da4df3ea39574a00","db366ddc962d33841e9640e1931226e9c48892e3cb26e6fe745e2acdd328d680","0ae2dd3813e7650157461c65b5b54c8adc248ab41b95647129e3de4ad8291e5b","11623910107fac1c9fc13b6067b10448482c9f1760b2fbd4e020ae382cf809f3","7f6adb2a19657ad29fd985b59a235f792510f9145ef00e4182378a0ec6a30a8b","29b1bb316cd27e0c4843fdcba0adfa11d4b9069cf5f87139c38b8db8343d51ea"],"paragraph_range_zero_based":[19128,19151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19128"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE LTE-NeighCellsCRS-AssistInfoList-r17 is used to provide configuration information of neighbour LTE cells to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR.","paragraph_zero_based":19152},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList information element","paragraph_zero_based":19153},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19154},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-START","paragraph_zero_based":19155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19156},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList-r17 ::= SEQUENCE (SIZE (1..maxNrofCRS-IM-InterfCell-r17)) OF LTE-NeighCellsCRS-AssistInfo-r17","paragraph_zero_based":19157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19158},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":19159},{"literal_text_all_w_t_and_m_t":"    neighCarrierBandwidthDL-r17              ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1}   OPTIONAL,   -- Cond CRS-IM","paragraph_zero_based":19160},{"literal_text_all_w_t_and_m_t":"    neighCarrierFreqDL-r17                   INTEGER (0..16383)                                          OPTIONAL,   -- Need S","paragraph_zero_based":19161},{"literal_text_all_w_t_and_m_t":"    neighCellId-r17                          EUTRA-PhysCellId                                            OPTIONAL,   -- Need S","paragraph_zero_based":19162},{"literal_text_all_w_t_and_m_t":"    neighCRS-muting-r17                      ENUMERATED {enabled}                                        OPTIONAL,   -- Need R","paragraph_zero_based":19163},{"literal_text_all_w_t_and_m_t":"    neighMBSFN-SubframeConfigList-r17        EUTRA-MBSFN-SubframeConfigList                              OPTIONAL,   -- Need S","paragraph_zero_based":19164},{"literal_text_all_w_t_and_m_t":"    neighNrofCRS-Ports-r17                   ENUMERATED {n1, n2, n4}                                     OPTIONAL,   -- Need S","paragraph_zero_based":19165},{"literal_text_all_w_t_and_m_t":"    neighV-Shift-r17                         ENUMERATED {n0, n1, n2, n3, n4, n5}                         OPTIONAL    -- Cond NotCellID","paragraph_zero_based":19166},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19168},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-STOP","paragraph_zero_based":19169},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19171},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo field descriptions","paragraph_zero_based":19172},{"literal_text_all_w_t_and_m_t":"neighCarrierBandwidthDL","paragraph_zero_based":19173},{"literal_text_all_w_t_and_m_t":"Indicates the channel bandwidth of the neighbour LTE cell in number of PRBs. If the field is absent, the UE applies the value of carrierBandwidthDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":19174},{"literal_text_all_w_t_and_m_t":"neighCarrierFreqDL","paragraph_zero_based":19175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["eff38da4c57bddca54312bd549b29f239bc6eaa864e2a7bc9f09402db2b0e874","6bec627298da421b8345caca7e6d28b7859ff1829e001ca2eda2d444af453e9e","4f3d4de5f142a08cabb970ccc7b9c1b1d282d097be5344ade2d135a2372a9f0a","9ec1e5e8305c0b4da983b7b69bff3a4ec3a2e02d54355df078e957ff952ef8ca","93906a3b66b6c82c6970b4645b44674feae95fc0fc045fd425a5ff27274f7740","64dac4bfcf3ef231b4fe42f5e6800b3534dd50c89c2a1b012eea4f33097737b5","2768ad8b3f9ef7f89177402667b5d37e6bee3fbd71e76b2ce1019f538b444274","c52d31b714ac461a14bc79fd263031770f4df97c0ec29fbfc84e59c1207ebdc6","6da4a9640f120ec3ec48f51297f10b68c595642a72ae0d9d9d0a0fa97a5d9c42","ebd28e01aa31bc66d57dbc84c8c49ede3dd05c4334cfb7a82e3d5209a65da8fe","810d9e9b23fb099e969783bf4a403dae332aca21813c0787f2925c2148f59096","f13341d7fde370aa4f7123c3dfa627e7cffe355b15ea9b0ea3a2907797d8fe53","683d3aece723eaf9f12e24d69f911434b679f45e785b7e36eb7bbbb2d1f20a3f","7df55284289e7ea44dedbfd572bbf7af0decf206c0e4523547ab3cf5545d30b1","f17d089d4d03b9e799f2e922efc7697ce2f7e215797c029b2b1ed57079da8753","121739ec74e3960f07cdcb95bb99517fe341dc9f0482f148ac0c7b492fb3f430","62ff94fcfbe2655c0354a2bc988295d51162537a2482403cd5e4fef8e4a49e96","dbe910fb16baf545c540e834b2e62b07f59eca0164f59d84cb3b620c3687bdef","3e24004c2f40e27686dab2aec2e8757e0e9601634967df44693a75c0bb0b6e6c","96648aa892be3686eb9bdc138a5f6f2ebac2f864d22893fb5b3924dfe6ab9bac","53ab9f8b88c734f161b5216e20e8d914653baa1f3f1a0903bee9e892ae05e1c1","0794be43c153b667dc1aa460c9ad271e7195b6f5b5be52057406b205db1d2276","55acbae4bca1012eda41a9241e966f11ee97536519c168a695485ee76deeebe6","4558986c8b2e4a6973873d2c1b2656666f631cfe4cb3766b97fc82c42abc7c44"],"paragraph_range_zero_based":[19152,19175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19152"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the downlink centre frequency of the neighbour LTE cell. If the field is absent, the UE applies the value of carrierFreqDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":19176},{"literal_text_all_w_t_and_m_t":"neighCellId","paragraph_zero_based":19177},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID of the neighbour LTE cell for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":19178},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, either this field or neighV-Shift is included in each instance.","paragraph_zero_based":19179},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, the entry with neighV-Shift is only used for neighbour LTE cells for which neighCellId is not provided (i.e. the entry with neighCellId takes precedence over the entry with neighV-Shift, if provided).","paragraph_zero_based":19180},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry with neither this field nor neighV-Shift, the information within the entry applies to all neighbour LTE cells.","paragraph_zero_based":19181},{"literal_text_all_w_t_and_m_t":"neighCRS-muting","paragraph_zero_based":19182},{"literal_text_all_w_t_and_m_t":"Indicates whether the CRS interference mitigation is enabled in the neighbour LTE cell, as specified in TS 36.133 [40], clause 3.6.1.1.","paragraph_zero_based":19183},{"literal_text_all_w_t_and_m_t":"neighMBSFN-SubframeConfigList","paragraph_zero_based":19184},{"literal_text_all_w_t_and_m_t":"Indicates the MBSFN subframe configuration of the neighbour LTE cell. If RateMatchPatternLTE-CRS is configured for this serving cell and the field is absent, the UE applies the value of mbsfn-SubframeConfigList indicated in RateMatchPatternLTE-CRS for this serving cell if configured; otherwise, if the field is absent, the UE assumes MBSFN is not configured in the neighbour LTE cell.","paragraph_zero_based":19185},{"literal_text_all_w_t_and_m_t":"neighNrofCRS-Ports","paragraph_zero_based":19186},{"literal_text_all_w_t_and_m_t":"Indicates the CRS antenna ports number of the neighbour LTE cell. If the field is absent, the UE applies the value of nrofCRS-Ports indicated in RateMatchPatternLTE-CRS for this serving cell, if configured. If RateMatchPatternLTE-CRS is not configured for this serving cell and the field is absent, the UE applies the default value n4.","paragraph_zero_based":19187},{"literal_text_all_w_t_and_m_t":"neighV-Shift","paragraph_zero_based":19188},{"literal_text_all_w_t_and_m_t":"Indicates the shifting value v-shift of neighbour LTE cells for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":19189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19190},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19191},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19192},{"literal_text_all_w_t_and_m_t":"CRS-IM","paragraph_zero_based":19193},{"literal_text_all_w_t_and_m_t":"For the serving cell with 15kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-15kHzSCS-r17, but not supporting crs-IM-nonDSS-15kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":19194},{"literal_text_all_w_t_and_m_t":"For the serving cell with 30kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-30kHzSCS-r17, but not supporting crs-IM-nonDSS-30kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":19195},{"literal_text_all_w_t_and_m_t":"NotCellID","paragraph_zero_based":19196},{"literal_text_all_w_t_and_m_t":"If the field neighCellId is present, this field shall be absent; otherwise, it is optionally present if the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry, Need S, or it is mandatory present if the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries.","paragraph_zero_based":19197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19198},{"literal_text_all_w_t_and_m_t":"–MAC-CellGroupConfig","paragraph_zero_based":19199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2f62fbe25d18697fd37c3f5bfa0870b55f0b5c5a427af738b58b55b6bde650e2","bc8a9a4c3f9d8465238415be0b237f1556e1b9858135ae49f3dfb24837c083ce","aafb7160ccdacc0782faf26a273e3371a1b2b08211613bbacf31edd8a35f78b6","83d6ef476492b1db6ff5022e833169ff12e67180f345bd6674502ac58501c58f","de53bfe05ef904c0ccac9ad0382ce7926a290cea580bb2c238bbc1455d4945ee","a9fa80a5d67277f5428bd202d7ab2595f85c1697136e6da201da98438631dc5e","bb4c7f7d0f7b013a2c83bd66bb5a570cf2f9a2f7aeb775a44c37ed7f969a231a","f450ccfbb268d81f9018963e8f1e5ca2338dd4006bd4b7c11f09de50013a7d28","34b735f9ecc92e5c31ac329fb25318ee5c4dfd59221e8e1db38cd73b8d98fc56","a0a24fff3a62283eacbb88ecef3fb48d098598a5e18c12630d4f6695aef79e9d","0e24b306905ad96c4a0c1f59e5a2d59d88b4c9da6e31f7d093690d0b0bce54b9","33f6a20ba16e01debd10f16c7b3dc557e5949ffef1e8e8f81d1b260c35