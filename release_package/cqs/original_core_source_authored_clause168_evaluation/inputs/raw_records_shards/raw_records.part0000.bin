{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TxParameters","paragraph_zero_based":37704},{"literal_text_all_w_t_and_m_t":"Indicates PSSCH transmission parameters.","paragraph_zero_based":37705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37706},{"literal_text_all_w_t_and_m_t":"–SL-ConfigDedicatedNR","paragraph_zero_based":37707},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfigDedicatedNR specifies the dedicated configuration information for NR sidelink communication/discovery.","paragraph_zero_based":37708},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR information element","paragraph_zero_based":37709},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37710},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-START","paragraph_zero_based":37711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37712},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR-r16 ::=         SEQUENCE {","paragraph_zero_based":37713},{"literal_text_all_w_t_and_m_t":"    sl-PHY-MAC-RLC-Config-r16            SL-PHY-MAC-RLC-Config-r16                                              OPTIONAL,    -- Need M","paragraph_zero_based":37714},{"literal_text_all_w_t_and_m_t":"    sl-RadioBearerToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSLRB-r16)) OF SLRB-Uu-ConfigIndex-r16        OPTIONAL,    -- Need N","paragraph_zero_based":37715},{"literal_text_all_w_t_and_m_t":"    sl-RadioBearerToAddModList-r16       SEQUENCE (SIZE (1..maxNrofSLRB-r16)) OF SL-RadioBearerConfig-r16       OPTIONAL,    -- Need N","paragraph_zero_based":37716},{"literal_text_all_w_t_and_m_t":"    sl-MeasConfigInfoToReleaseList-r16   SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIndex-r16     OPTIONAL,    -- Need N","paragraph_zero_based":37717},{"literal_text_all_w_t_and_m_t":"    sl-MeasConfigInfoToAddModList-r16    SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-MeasConfigInfo-r16       OPTIONAL,    -- Need N","paragraph_zero_based":37718},{"literal_text_all_w_t_and_m_t":"    t400-r16                             ENUMERATED {ms100, ms200, ms300, ms400, ms600, ms1000, ms1500, ms2000} OPTIONAL,    -- Need M","paragraph_zero_based":37719},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37720},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":37721},{"literal_text_all_w_t_and_m_t":"    sl-PHY-MAC-RLC-Config-v1700          SetupRelease { SL-PHY-MAC-RLC-Config-v1700 }                           OPTIONAL,    -- Need M","paragraph_zero_based":37722},{"literal_text_all_w_t_and_m_t":"    sl-DiscConfig-r17                    SetupRelease { SL-DiscConfig-r17}                                      OPTIONAL     -- Need M","paragraph_zero_based":37723},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":37724},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37726},{"literal_text_all_w_t_and_m_t":"SL-DestinationIndex-r16  ::=             INTEGER (0..maxNrofSL-Dest-1-r16)","paragraph_zero_based":37727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6f18e5ba474dbde84c181bc1399e8b04d86501840b30b290c7dfd12bf6c79f51","a009d14e1954a4334a9299184a2f3246427264ef4015efd029c385c6db387037","74a2975496945721fc69d9d3bb6fbbbfd782b7bf470265af971d6e4a29afe9a0","a414432914837f2b778aa5a0505d8da072b0bcf35ec468fca96f1d22ad8d6946","b247ffa5ec7b769fa544033c895c54cff65d84ea8d760e4f1ff0080535a4f2a9","93bbb751e722cac3fccb55b0c764cacb2ffa0640b4a49cf46f00b0fa38d9c334","8c8ea41c92b4b5