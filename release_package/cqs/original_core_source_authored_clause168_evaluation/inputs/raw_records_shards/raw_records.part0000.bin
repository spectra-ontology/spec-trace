{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":3144},{"literal_text_all_w_t_and_m_t":"localOrigin-v18xyCoordinateID-r18","paragraph_zero_based":3145},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":3146},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":3147},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3149},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3151},{"literal_text_all_w_t_and_m_t":"ReferencePoint field descriptions","paragraph_zero_based":3152},{"literal_text_all_w_t_and_m_t":"referencePointGeographicLocation","paragraph_zero_based":3153},{"literal_text_all_w_t_and_m_t":"This field provides the geodetic or local location of the reference point.","paragraph_zero_based":3154},{"literal_text_all_w_t_and_m_t":"localOrigin ","paragraph_zero_based":3155},{"literal_text_all_w_t_and_m_t":"This field provides an identifier for the reference point that defines the origin of a local Cartesian coordinate system [15].","paragraph_zero_based":3156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3157},{"literal_text_all_w_t_and_m_t":"–RelativeCartesianLocation","paragraph_zero_based":3158},{"literal_text_all_w_t_and_m_t":"The IE RelativeCartesianLocation provides a Cartesian location relative to some known reference location.","paragraph_zero_based":3159},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3161},{"literal_text_all_w_t_and_m_t":"RelativeCartesianLocation-r18 ::= SEQUENCE {","paragraph_zero_based":3162},{"literal_text_all_w_t_and_m_t":"cartesianCoordinatesUnits-r18 ENUMERATED { mm, cm, d