73f080e3a6f364c4f9700f1cca1a0a","3e0ca9347def4c25c1838ddaeb26dc063764528d7e38c0f21b97c2ce718f1866","330a8fa4f612ccceaf976cbeb1127261d310daa014b2efb2957f812f3323fbb1","89444d4370ca97f6ddaee2c7739e4388be922ae22ce4cfdfb32812c768a4aa40","919da7386d18c8fb5d5d7f1ddcbc10b58265d54def9025f05a7dfbe1cae31f40","40a7e3b007e101df3e6946d9f446f1765b2b9331d848e4f465289d59820037c7","2056b37ae7744a42c2502fd6c162ffab2f5d04e7dd8d9e2e517ca61b9f0f402d","cf8e257cf67415f84a734b8fa7a2837d50cb5ce8591d2934cc8f68a5efa980ce","fd2875fe32eec48588370c5f12c24150969ddb1169df173a3feaab43c7459caa","133f71311a5ed6e6198d7a90ad5348f10720c708f26be4886d09d14fed7c3123"],"paragraph_range_zero_based":[14688,14711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14688"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    csi-RS                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":14712},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                     SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1)   OPTIONAL,   -- Need R","paragraph_zero_based":14713},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                    INTEGER (0..63)                                                                 OPTIONAL,   -- Need R","paragraph_zero_based":14714},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14715},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14717},{"literal_text_all_w_t_and_m_t":"CandidateBeamRSListExt-r16::=       SEQUENCE (SIZE(1.. maxNrofCandidateBeamsExt-r16)) OF PRACH-ResourceDedicatedBFR","paragraph_zero_based":14718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14719},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYCONFIG-STOP","paragraph_zero_based":14720},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14722},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig field descriptions","paragraph_zero_based":14723},{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryTimer","paragraph_zero_based":14724},{"literal_text_all_w_t_and_m_t":"Timer for beam failure recovery timer. Upon expiration of the timer the UE does not use CFRA for BFR. Value in ms. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":14725},{"literal_text_all_w_t_and_m_t":"candidateBeamRSList, candidateBeamRSListExt-v1610","paragraph_zero_based":14726},{"literal_text_all_w_t_and_m_t":"Set of reference signals (CSI-RS and/or SSB) identifying the candidate beams for recovery and the associated RA parameters. This set includes all elements of candidateBeamRSList (without suffix) and all elements of candidateBeamRSListExt-v1610. The UE maintains candidateBeamRSList and candidateBeamRSListExt-v1610 separately: Receiving candidateBeamRSListExt-v1610 set to release releases only the entries that were configured by candidateBeamRSListExt-v1610, and receiving candidateBeamRSListExt-v1610 set to setup replaces only the entries that were configured by candidateBeamRSListExt-v1610 with the newly signalled entries. The network configures these reference signals to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. ","paragraph_zero_based":14727},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":14728},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for contention free beam failure recovery (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":14729},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":14730},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":14731},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":14732},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":14733},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":14734},{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be used by the UE to attempt contention free random access to recover from beam failure (see TS 38.213 [13], clause 6).","paragraph_zero_based":14735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b99d3e353e9df137125239b05dbd0f68ae51e3607cb95161497e9a72dfe29263","48e99eee182f0e4071c888980fa215be351bf0e6491a4536f443ae9d1da48a8a","0a6431e4d5d3e1292af1ff74f90d120b62505837d1bc7157191ba898715e36ab","7de015160f1cf7004b947ca8d7b2e188e89c472fad5d7beaa78468522de0e1d9","da9b3a3a15eb69f95ce025ee81731a5d4a471c5706347920e0801d2c4cb99083","02b3ee445a7460a8d9edd150da81fd4931ccd26336310c1da812c2fce23429db","e5cab23500b64cc4c3e31c27fdff4f812972ef09d1f54c2a2df9aefb602ed2ff","e29752131fe42885091c72418cb28e6b929d659d3d934b1bed7302be269ba2ce","71d888c73cb1a46d9f1e2ba68666feba94bd0db5de35dd17d43597e8ddd864a8","f6d5f6aea2aea9c1d1ab8d0e44e142ca1a5a56ca63cdfc350ca24d50bedbe034","057ff23475d967461547d0f22aacc5b2d0c5be914ba269349f945e3dd96b95ac","00057ec3c81bf008f7f785a9569df444d2ee480fc2cda056638ef22cdff7fda3","2919b0817bffc15c8537a869058d50615c5561f2c4a43c9c026349c6bd3288b8","0e6b8bc21c0662cc1cc6ff0944e3d588b9c17b1452611501f57192f5bb0f2f8a","73832b1d4b00469062d1e8d2814a58bbcd8fbe4337072f5e84e1c3fe2a229e82","82c630b572a4dbcc550484b6c6f388fb58c6e93f43a1444e8eecde3c274e8dff","bbd604a5757856437b9f13f283aae1e8234e92a0c930ecb8d80a93f4b338dac5","333cd6cacfe7c60f2ddf40d5cdaea0bdf30949242d5db44172d7a88d277c8620","ab3f7ed74ca790f99380fafb1a49cc558a8153368c2e6323be19e14535d273be","1cb3b22475e74dbd4701b52184d8da439123011e7e3501199906125947831703","a5529a6dad11299a838dda265da03ff52fb8e6113ec78e344344bbb59ba1ec92","cc9a4700fcf3d5c1b41690009d05a82441bcac0d4f81bbdcc1458fd43bcadc5f","95987bd981a9edb27b138f1f6cf3cc4ccd376490c9a5f018519ea0159b72cb03","a44ee96f5cb1cd42525bf8a6e86d6a15c8a4d1bad87d22c1891baf654f77a45b"],"paragraph_range_zero_based":[14712,14735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14712"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":14736},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":14737},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationTwoStep","paragraph_zero_based":14738},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":14739},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":14740},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources.","paragraph_zero_based":14741},{"literal_text_all_w_t_and_m_t":"rach-ConfigBFR","paragraph_zero_based":14742},{"literal_text_all_w_t_and_m_t":"Configuration of random access parameters for BFR.","paragraph_zero_based":14743},{"literal_text_all_w_t_and_m_t":"recoverySearchSpaceId","paragraph_zero_based":14744},{"literal_text_all_w_t_and_m_t":"Search space to use for BFR RAR. The network configures this search space to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. The CORESET associated with the recovery search space cannot be associated with another search space. Network always configures the UE with a value for this field when contention free random access resources for BFR are configured.","paragraph_zero_based":14745},{"literal_text_all_w_t_and_m_t":"rootSequenceIndex-BFR","paragraph_zero_based":14746},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1) for beam failure recovery.","paragraph_zero_based":14747},{"literal_text_all_w_t_and_m_t":"spCell-BFR-CBRA","paragraph_zero_based":14748},{"literal_text_all_w_t_and_m_t":"Indicates that UE is configured to send MAC CE for SpCell BFR as specified in TS38.321 [3].","paragraph_zero_based":14749},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":14750},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for CF-BFR, see TS 38.213 [13], clause 8.1.","paragraph_zero_based":14751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14752},{"literal_text_all_w_t_and_m_t":"BFR-CSIRS-Resource field descriptions","paragraph_zero_based":14753},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":14754},{"literal_text_all_w_t_and_m_t":"The ID of a NZP-CSI-RS-Resource configured in the CSI-MeasConfig of this serving cell. This reference signal determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":14755},{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":14756},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing BFR upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":14757},{"literal_text_all_w_t_and_m_t":"If the field is absent the UE uses the RA occasion associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":14758},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":14759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"sou