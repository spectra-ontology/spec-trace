t_XML_sha256":"c435577f6d7cf2e4fe4434b4c3369f969adf7cd4a971595e76ce3b84904e80ba","original_member_sha256":"6f1fcd84e60deecbfe43a31a29c6ba9f64fe43515295e947e3677a081d3af633","paragraph_ElementTree_utf8_XML_sha256":["0e19b81f87d3bdc2ef8b647396cef0b654a0980685f47da385dbf025b72d6b3a","a9c53bdfdd39f8e6ca97cd76d19167c48157f0677c11978d12e4c36116d72d0a","5344855e0fe3fa7f07b6e9f317481cc9b7dfd6f4dd34d3babe988ed5122da228","a2f6639e81b0b309dc2818dc9d799155d7eacc71f419342dc03b98db169b2da1","0fbc15aca88709f6e0bf1a4ad3b9408ba17eba977f695f93b785cfcbd249c3c5","e0d334f23360a49063cb320b71d49e2def0fe9a5e62366582f2ae3c702804472","e9bb87084260d960fe8bd9766a936465efd063900f4c24da12cdccbb087e37cf","37af868d797143f2f4c78d0430a28d61e696204a98d6d30cc71e31b834542543","f0c962faa7eb7da162ce4cc0907bfe475042520891e2dbb21a8ee1ffdab2d682","7e85ce478e209d0d2c158e5a9941ab2af0d3f96791ae3375ba35acfb2035094a","ffbb247ee065aee728a9425d0566548b22fb77f21ba1ee91c1bbdf65a25d33d9","83c7c63b7e064386d69c2724cd6cf1b784e8809b9a5f5530e0cb97c705f27633","08eed9f3d3c0d7b5ad9be1268595ad2385e4e52065f3b7cf1b63e31e7a945772","5088cc15e2280550796b212be9e2cb84ba7be08e5e8ef8357a7987518a9b92db","ccf3e542702790e906a6e62672ded541e15cf1844698454a407440a6d9bd3bf9","15c688de34899defee20bf40d5bf07ec6e66c5369a7f00a115b509170ca43ab4","e127f5f36047df71a523d9fc7438651c56df8ee54afb27eb5796b70c202318b0","73e61e81b73c1707d43cde5a184477ca2042f4c4701ef35e50c63924c61e4f29","49069048e641b79dbced68ded3190a3fb952b6c2769342d89bbcfc02dc29b02c","e5a540b784baac4e7e88e4749d98f4312b0928d04870520da544cce2e21619f3","21ea53af5e30e1a51c6a7fe6e9dd847a61d9bcf9c59f9904a4279e085aa137a3","d11228f01d099ef8a23678e33ee8d6112c3b487062935fbef0a8f2520ceba344","408d42fb52d6847a90ce6eaf454357ce6d0a5e4a2e16ff35598e3a848601dbb6","624a8ffe8c34a78ad400e3d3f36639a710f524d4fa450dfab6b8b247bc5da3e1"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx:p96"}
{"fields":{"filename":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"START OF CHANGE","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"5.22.1.3.2PSFCH reception","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"The MAC entity shall for each PSSCH transmission:","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"1>if an acknowledgement corresponding to the PSSCH transmission in clause 5.22.1.3.1a is obtained from the physical layer:","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"2>deliver the acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"2>if negative-only acknowledgement was enabled in the SCI:","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"3>deliver a positive acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"3>deliver a negative acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process;","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"1>if the PSSCH transmission occurs for a pair of Source Layer-2 ID and Destination Layer-2 ID corresponding to a PC5-RRC connection which has been established by upper layers:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"2>perform the HARQ-Based Sidelink RLF Detection procedure as specified in clause 5.22.1.3.3.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"If sl-PUCCH-Config is configured by RRC, the MAC entity shall for a PUCCH transmission occasion:","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"1>if the timeAlignmentTimer, associated with the TAG containing the Serving Cell on which the HARQ feedback is to be transmitted, is stopped or expired:","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"2>not instruct the physical layer to generate acknowledgement(s) of the data in this TB.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"1>else if a MAC PDU has been obtained for a sidelink grant associated to the PUCCH transmission occasion in clause 5.22.1.3.1, the MAC entity shall:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"2>if the most recent transmission of the MAC PDU was not prioritized as specified in clause 5.22.1.3.1a:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a negative acknowledgement on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"2>else if HARQ feedback has been disabled for the MAC PDU and next retransmission(s) of the MAC PDU is not required:","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a positive acknowledgement corresponding to the transmission on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"2>else if HARQ feedback has been disabled for the MAC PDU, and no sidelink grant is available for next retransmission(s) of the MAC PDU (including immediately after all PSSCH duration(s) in an sl-PeriodCG for the sidelink grant, the number of transmissions of the MAC PDU has not reached sl-MaxTransNum corresponding to the highest priority of the logical channel(s) in the MAC PDU, if configured in sl-CG-MaxTransNumList for the sidelink grant by RRC), if any:","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal a negative acknowledgement corresponding to the transmission on the PUCCH according to clause 16.5 of TS 38.213 [6].","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"3>instruct the physical layer to signal an acknowledgement corresponding to the transmission on the PUCCH according to clause 16.5 of TS 38.213 [6]","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c435577f6d7cf2e4fe4434b4c3369f969adf7cd4a971595e76ce3b84904e80ba","original_member_sha256":"6f1fcd84e60deecbfe43a31a29c6ba9f64fe43515295e947e3677a081d3af633","paragraph_ElementTree_utf8_XML_sha256":["76463f2ca3b1112a758510b68dc6f278a41af75105393fe34f1729c1ac230483","07b2cd78cace65c0e3acbc941ac61fae421824db5a8a0bf6c38d4371079f5856","f09f9d3fcd51a7ef98af076404de705b747192ae7ba68a96da78cb5ec8bcacec","99be432132ed8a6e87a05a072a204a8e661fad5d0a16be38570cf27de812d082","52af7c75254374a2558ef9b0ffaf41ea1e9959548f3f2a776bb9194c552f8db7","54b9210123450af81daaf1d4f884e1378570dce5a04ec9bcd5abc6dffe2919d4","cc5a1fa9ebb24c6c753368b0a21d30d95a4d9831a341a6f4379faafc7f52b4f0","e78170aacabc8ea5eca4eb78af95b5f30ff095c2f9849c342c5c66aecdc63214","8d1889798cf62f92793cb90722b4c60e7c5b6a815eb0ca6d23075cf82e1699cf","9ba2af67f789105e9d37bded589bd56ad8eb803364b3708e9e63954acc82ccba","799fd3f2f219149043eaffc2659c374e78e7558f1ec050f35e7ea3721c3f36e6","b3dfb87ae03d469f0f0d453e8dde2877aa6cb0602bacbc8cd2bbf435108553bf","c3d0a114cd7d16d971ff9e368004f9696b7bb25fc592092aa131944333dcfc30","26671d470b089338c02c739d0bfda2e6d2f790524a1db6f07461d93208d29634","fda65c27febdf24cb8741b2ff0f3708631d66f1037e7801e0b0b6c0106cea102","4a847fcceab3e9168f8ce3e599e3f8638a1670083b37002076248ada5930d789","31fcb4f42362ebc81ba3e05814824ca7e1e1196a040e77eca80691152e31b5e5","80dc71bb679d10cb3f433eb319c6581e5a8a0b4ed53a686cc020d277beda46d7","a45a6be69355113d5b5ff21d0e2c1083fc51634157118a95ada526a1794e6278","521afdffc799ff0a01fe9acca95299fd75407644b50931ea86ab628b52a7