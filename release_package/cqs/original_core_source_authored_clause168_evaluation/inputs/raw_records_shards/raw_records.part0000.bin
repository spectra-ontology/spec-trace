{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator field descriptions","paragraph_zero_based":14640},{"literal_text_all_w_t_and_m_t":"ai-RNTI","paragraph_zero_based":14641},{"literal_text_all_w_t_and_m_t":"Used by an IAB-MT for detection of DCI format 2_5 indicating AvailabilityCombinationId for an IAB-DU's cells.","paragraph_zero_based":14642},{"literal_text_all_w_t_and_m_t":"availableCombToAddModList","paragraph_zero_based":14643},{"literal_text_all_w_t_and_m_t":"A list of availabilityCombinations to add for the IAB-DU's cells. (see TS 38.213 [13], clause 14).","paragraph_zero_based":14644},{"literal_text_all_w_t_and_m_t":"availableCombToReleaseList","paragraph_zero_based":14645},{"literal_text_all_w_t_and_m_t":"A list of availabilityCombinations to release for the IAB-DU's cells. (see TS 38.213 [13], clause 14).","paragraph_zero_based":14646},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeAI","paragraph_zero_based":14647},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with ai-RNTI (see TS 38.213 [13]).","paragraph_zero_based":14648},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14649},{"literal_text_all_w_t_and_m_t":"–BAP-RoutingID","paragraph_zero_based":14650},{"literal_text_all_w_t_and_m_t":"The IE BAP-RoutingID is used for IAB-node to configure the BAP Routing ID.","paragraph_zero_based":14651},{"literal_text_all_w_t_and_m_t":"BAP-RoutingID information element","paragraph_zero_based":14652},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14653},{"literal_text_all_w_t_and_m_t":"-- TAG-BAPROUTINGID-START","paragraph_zero_based":14654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14655},{"literal_text_all_w_t_and_m_t":"BAP-RoutingID-r16::=        SEQUENCE{","paragraph_zero_based":14656},{"literal_text_all_w_t_and_m_t":"    bap-Address-r16              BIT STRING (SIZE (10)),","paragraph_zero_based":14657},{"literal_text_all_w_t_and_m_t":"    bap-PathId-r16               BIT STRING (SIZE (10))","paragraph_zero_based":14658},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14660},{"literal_text_all_w_t_and_m_t":"-- TAG-BAPROUTINGID-STOP","paragraph_zero_based":14661},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["216895b12e056e3b8daf61f6a47047ae0dd912eea96f9880e2c5fbfaa5313daa","4fc9cd88572663c058b5137469719487270645d9ab525a85936007faa3dfc996","f893daa64e5e12a7f87eb0c5be4c2adedc954d1c215f3e05732da3c1fa483f68","e0023b7a3051fe11986327f527347bfade044d4b93cfa526cb2f6a3339a57b68","0269f28121a1d27a5be9060d39f2146470487623a7abef4eed4b29d4030b8449","92aec2bbb0be220c546b3a622e077c938f7e9e3df31b8823f3f559619ea5af36","f783a9e2c11464c3999dd56af95edfc90bd764c4fb724be05321506ca2c5435c","23e89879149ee21eb0da890d3c23e13ee89a094397dd6e8700e6b8cd7cfe37cb","e63438f9ecc9b66e7cb5132782448bd93af9539df8acbff94d88ef1ccccd2a76","c39581aa0704eee53b8d791b7354098190fc3e3e8cabc3ebab3d18f4e9ad5d8f","1df9dbebc8adffcc3bf9352883cb5cdab8dab5aec950aab151826832d029bf10","0f8d51184d7486e3d86bfc23eb3b15ebab7a74f1dc64f5bf3066ef5966e060c5","69911f7241210d4417d88bfeeea5bb37e2429d7553fe66cbc3edabf6fc145b04","9509802628608b0bec1f10f92a9da97a86757dbfb79b0499eca0d0d55504bbcd","32ab284310188428b20eff9dfbb69ba427810dd2c63b98d07a87e1b356b6b154","44810924f4a7990a8c6398e13b2908d002eb2faff1585304bb56f2786e3884