{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            dl-OrJointTCI-StateToAddModList-r17        SEQUENCE (SIZE (1..maxNrofTCI-States)) OF TCI-State","paragraph_zero_based":22632},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need N","paragraph_zero_based":22633},{"literal_text_all_w_t_and_m_t":"            dl-OrJointTCI-StateToReleaseList-r17       SEQUENCE (SIZE (1..maxNrofTCI-States)) OF TCI-StateId","paragraph_zero_based":22634},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL    -- Need N","paragraph_zero_based":22635},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":22636},{"literal_text_all_w_t_and_m_t":"        unifiedTCI-StateRef-r17                  ServingCellAndBWP-Id-r17","paragraph_zero_based":22637},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":22638},{"literal_text_all_w_t_and_m_t":"    beamAppTime-r17                              ENUMERATED {n1, n2, n4, n7, n14, n28, n42, n56, n70, n84, n98, n112, n224, n336, spare2,","paragraph_zero_based":22639},{"literal_text_all_w_t_and_m_t":"                                                            spare1}                                             OPTIONAL,   -- Need R","paragraph_zero_based":22640},{"literal_text_all_w_t_and_m_t":"    dummy                                        SetupRelease { Dummy-TDRA-List }                                    OPTIONAL,   -- Need M","paragraph_zero_based":22641},{"literal_text_all_w_t_and_m_t":"    dmrs-FD-OCC-DisabledForRank1-PDSCH-r17          ENUMERATED {true}                                           OPTIONAL,   -- Need R","paragraph_zero_based":22642},{"literal_text_all_w_t_and_m_t":"    minimumSchedulingOffsetK0-r17                   SetupRelease { MinSchedulingOffsetK0-Values-r17 }           OPTIONAL,   -- Need M","paragraph_zero_based":22643},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-1-2-v1700          INTEGER (0..5)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":22644},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-1-1-r17            INTEGER (5)                                                    OPTIONAL,   -- Need R","paragraph_zero_based":22645},{"literal_text_all_w_t_and_m_t":"    mcs-Table-r17                                ENUMERATED {qam1024}                                           OPTIONAL,   -- Need R","paragraph_zero_based":22646},{"literal_text_all_w_t_and_m_t":"    mcs-TableDCI-1-2-r17                         ENUMERATED {qam1024}                                           OPTIONAL,   -- Need R","paragraph_zero_based":22647},{"literal_text_all_w_t_and_m_t":"    xOverheadMulticast-r17                       ENUMERATED {xOh6, xOh12, xOh18}                                OPTIONAL,   -- Need S","paragraph_zero_based":22648},{"literal_text_all_w_t_and_m_t":"    priorityIndicatorDCI-4-2-r17                 ENUMERATED {enabled}                                           OPTIONAL,   -- Need S","paragraph_zero_based":22649},{"literal_text_all_w_t_and_m_t":"    sizeDCI-4-2-r17                              INTEGER (20..maxDCI-4-2-Size-r17)                              OPTIONAL    -- Need R","paragraph_zero_based":22650},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22651},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22652},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationListForMultiPDSCH-r17 SetupRelease { MultiPDSCH-TDRA-List-r17 }                   OPTIONAL    -- Need M","paragraph_zero_based":22653},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22654},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2fea07728a5fa32596850f0e58e3819afa4f88fd15468e3aeca32be9030bda49","7a20c774d0c6ce869af2e5cbd92d1ab8f0efcc2b4a4a0af5a3c2b80166a43d32","78cfae5069849a06e8688d75db2076812588db84ec48b7d7714032c590c30a84","c42cade045ab336d599743f131ec1559374d34a20df2bbf4e202e2d0d398ed2a","7ddeb0416f0bbe9de8b1a678516e3093ed546c0c1c4b8d178e60b4a4a664fcb6","216792033f909c621a986048fc9901d38a0f49887c749dfd249000d1e974e9a1","2a10d257dfc3498bbe470134de132ea089b3eebe2e4dafb19028191676b32abb","a23ce1aac6a20483a086f0b10bed7b202ab3b10e10f4ca08813db7b45a0d8a13","05e5ca39c5f5882241d49852c7142e5efaee65f85a5c3d64b870b52163fe8996","c7c715abc38fb31f3903b60b7a24c899bc9cbdbf91d9a7c3ed1b5c780af946d6","135c0b9b7d2ba930f94e3c3727fc8623da23b2d74dcefee8c31d1d21226182c2","5a69c2f9f41831bef02d918e1a955e05514473431794ec8e2297721b5624ba9c","a78011fc7fd6eb137dee21e71e54dc899491ee1265e1c82f91ecaf82e3bf7ae9","abb461db7685f25b993da61ada984b2c694bf3d66746cee3fe9dee7630a47a1a","1d7a8b263e44f2ba34052338b36041108386f8af81228f437f5ceb23865cffef","9c0f759a88fc167da549f30ccbaa919ec79a33dfe0bf6069b48909e801e3d28c","c987188787d272285f0fbe611f94a38242218364d8760bd492c0a5229d5dca41","ea65e1ab0a703673212c120ec946171dd6c21ed380bffc54d82534e74d314289","05161a45b50883b8f49bf59bafe8c124ed7b2844ba65dd399678b4e5dd3ea617","711476d2cecc268f1f9d8d516282c0ce46b1aefe0fb642908cea749ecb215af2","baf6aa46a8396cc6e4c8a75c8ddbb6c4748e4de2fc8a12cc50fc498e1ad495f1","fb412445eb0be144631f83e2ca93b95f59ff5284b40615b97415bbcc3facaacd","8e164a801b9ba99f716da4bf23d5cb864fa774f776cc64b2afb624f9c1b82d4c","4e49585c746a2a85da0e566a4e7e52e2a6c712ed9f7b693041d50c4d0d93f4c2"],"paragraph_range_zero_based":[22632,22655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22632"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22656},{"literal_text_all_w_t_and_m_t":"RateMatchPatternGroup ::=               SEQUENCE (SIZE (1..maxNrofRateMatchPatternsPerGroup)) OF CHOICE {","paragraph_zero_based":22657},{"literal_text_all_w_t_and_m_t":"    cellLevel                               RateMatchPatternId,","paragraph_zero_based":22658},{"literal_text_all_w_t_and_m_t":"    bwpLevel                                RateMatchPatternId","paragraph_zero_based":22659},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22661},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r16 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r16)","paragraph_zero_based":22662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22663},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r17 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r17)","paragraph_zero_based":22664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22665},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDL-r16 ::=                INTEGER (1..8)","paragraph_zero_based":22666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22667},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-STOP","paragraph_zero_based":22668},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22670},{"literal_text_all_w_t_and_m_t":"PDSCH-Config field descriptions","paragraph_zero_based":22671},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-1-2","paragraph_zero_based":22672},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 1_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 1_2. Otherwise, the field size is set to 0 for DCI format 1_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 nor dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 is configured, this field is absent.","paragraph_zero_based":22673},{"literal_text_all_w_t_and_m_t":"aperiodic-ZP-CSI-RS-ResourceSetsToAddModList, aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2","paragraph_zero_based":22674},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring aperiodically triggered zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network configures the UE with at most 3 aperiodic ZP-CSI-RS-ResourceSets and it uses only the ZP-CSI-RS-ResourceSetId 1 to 3. The network triggers a set by indicating its ZP-CSI-RS-ResourceSetId in the DCI payload. The DCI codepoint '01' triggers the resource set with ZP-CSI-RS-ResourceSetId 1, the DCI codepoint '10' triggers the resource set with ZP-CSI-RS-ResourceSetId 2, and the DCI codepoint '11' triggers the resource set with ZP-CSI-RS-ResourceSetId 3 (see TS 38.214 [19], clause 5.1.4.2). The field aperiodic-ZP-CSI-RS-ResourceSetsToAddModList applies to DCI format 1_1 and the field aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.2 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":22675},{"literal_text_all_w_t_and_m_t":"beamAppTime","paragraph_zero_based":22676},{"literal_text_all_w_t_and_m_t":"Indicates the first slot to apply the unified TCI indicated by DCI as specified in TS 38.214 Clause 5.1.5. The value n1 means 1 symbol, n2 two symbols and so on. The first slot is at least Y symbols indicated by beamAppTime parameter after the last symbol of the acknowledgment of the joint or separate DL/UL beam indication. The same value shall be configured for all serving cells in any one of the simultaneousU-TCI-UpdateListN configured in IE CellGroupConfig based on the smallest SCS of the active BWP.","paragraph_zero_based":22677},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPDSCH, dataScramblingIdentityPDSCH2","paragraph_zero_based":22678},{"literal_text_all_w_t_and_m_t":"Identifier(s) used to initialize data scrambling (c_init) for PDSCH as specified in TS 38.211 [16], clause 7.3.1.1. The dataScramblingIdentityPDSCH2 is configured if coresetPoolIndex is configured with 1 for at least one CORESET in the same BWP.","paragraph_zero_based":22679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["79fc2a2cc74d17ecfd80c744de78c0060462b6d7c7e1501897a94c5398a3b11b","e4ad973860344b3f20c3d6804da2395940c43ba0d4c4e086bfd4806d306c0a23","3678aff5c6b943e715b6b36def7711def04169b96640f3dd8947dc38ef4f1f48","da4e9d220c7c14f8bbc83c0c0dc4054f3fe55ba05bb0405d8af511c482deb37e","cfa74a645b9f1fb4ce0343bdc69a6cbfa0e62717cb15b0afff0ddc5cd6348e12","5a6f4d1ad533fffd7bfc59de9aa10d3f9cc0c4dd57987e4b7b501fa434fd6521","0115e89c8c32b45897c44b62f1808c5bfada0b31ec9fe9a567b37b5ce0658659","d3f678939972598d4b74b3f58719bd5c8ffb9dd48b8ade11d87ae4e7baccd7bd","01258ecc0fea1329576b66f25f2c568e63b077af082bdfbf79aaa1c0db62488d","b9765bf05fcf903d5a53094324b01c6a244395d9adf7e7d8a594f493e63933ae","5d1ca835b16d6c8059dfaf41ccf13719faa109e076fdd6eff1ed7c53f2746050","f3b53416101853d7c8ebc95c82133e8731f213e36adc6de37766979df22e4a33","f36ab41630e967a333209baa37b4089e8bc4eb0077130eefda1f9a830425241b","e91cf1c5f975250102168684d7dad679d7a3c17fb4c4846f7ab546f358d9cbb4","d72bfbfe11d9f1264bdcc7ac41c68a094ce1d256ea1e879c6c36fefe5be74dac","06b903de8c33a844c0c38570412b89fcaa9d1e6993ea078e24a2aed2d338678a","48c9314356f9243d36529071194c557191f72b29ba618b3e9500a6e63df91c2e","1a1443d0986c10c100133146b98bd77e9f6c276622998d84f2430bf7c00dff2a","58f90c882f8fb8858bdfd3dfa69db011b2cf5277d56e4e222062544b36c93a5b","b30b1e5b48b9ee61ab85f0797bf02fd043995d502b3f54e1cb4baabeaa6b7d7f","6ae09a4af06a2e759afac0efd896368c2ce96e8108d4fd783fef1e0554f6fbab","55ce8f80552a951e0f6c86bc4765d444150a4f95981d1221bd033ae0e3ccd7d1","028187b8ec66b539321c36b860a4239149b7765852bb33da9e29f4143721ac2b","9f543420f50e470cdd4595214339535965a2ff3b124d44b5c62ed1a3734626fe"],"paragraph_range_zero_based":[22656,22679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22656"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-OrJointTCI-StateToAddModList","paragraph_zero_based":22680},{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports, PDCCH DMRS ports, and CSI-RS, and in case of join mode, also the PUSCH, PUCCH and SRS (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":22681},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeA, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2","paragraph_zero_based":22682},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type A (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeA applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22683},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeB, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2","paragraph_zero_based":22684},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type B (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeB applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22685},{"literal_text_all_w_t_and_m_t":"dmrs-FD-OCC-DisabledForRank1-PDSCH","paragraph_zero_based":22686},{"literal_text_all_w_t_and_m_t":"If configured, the UE may assume that the set of remaining orthogonal antenna ports, which are within the same code division multiplexing (CDM) group and have different frequency domain orthogonal cover codes (FD-OCC), are not associated with the PDSCH of another UE (see TS 38.214 [19], clause 5.1.6.2). It is applicable for PDSCH SCS of 480 and 960 kHz when rank 1 PDSCH with type-1 or type-2 DMRS is scheduled.","paragraph_zero_based":22687},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-1_2","paragraph_zero_based":22688},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 1_2 If the field is absent, then the UE applies the value of 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 1_2. If the field is present, then the UE applies the value of 1 bit as in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22689},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":22690},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":22691},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-1-2","paragraph_zero_based":22692},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22693},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":22694},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in this DL BWP. If not configured, the UE uses the maxMIMO-Layers configuration in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs, when the UE operates in this BWP. The value of maxMIMO-Layers for a DL BWP shall be smaller than or equal to the value of maxMIMO-Layers configured in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs.","paragraph_zero_based":22695},{"literal_text_all_w_t_and_m_t":"For MBS multicast, indicates the maximum number of MIMO layers to be used for group-common PDSCH of MBS multicast in this CFR. If not configured for CFR, the UE applies value 1. The value of maxMIMO-Layers for a CFR shall be smaller than or equal to the value of maxMIMO-Layers configured in PDSCH-ServingCellConfig IE of the serving cell to which this CFR belongs.","paragraph_zero_based":22696},{"literal_text_all_w_t_and_m_t":"maxNrofCodeWordsScheduledByDCI","paragraph_zero_based":22697},{"literal_text_all_w_t_and_m_t":"Maximum number of code words that a single DCI may schedule. This changes the number of MCS/RV/NDI bits in the DCI message from 1 to 2.","paragraph_zero_based":22698},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":22699},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI formats 1_0 and 1_1 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-Table-r17 is present for DCI format 1_1, the network does not configure the field mcs-Table (without suffix). For a RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":22700},{"literal_text_all_w_t_and_m_t":"mcs-TableDCI-1-2","paragraph_zero_based":22701},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI format 1_2 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-TableDCI-1-2-r17 is present, the network does not configure the field mcs-TableDCI-1-2-r16. For a RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":22702},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK0","paragraph_zero_based":22703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bb7010322e399f55c170993cbd45e64ca33878ce3a3b43436947265af1eb4b8d","f923615dce4e4073a7a7918320010c815d45b930cdb70f933686b77dc27f4ffa","23ece17ac0dbe9d69020663e074ecf341aebc5dec839d4f9352ec95a01f9bc8a","639ca657b90d4fb4e5e2ba17e08cbd071af244aa2237cc83ba668fde8abf0e20","e9bdddeacbd38063b6adb9f90c6bf796abe2ac0b3cf500f03cd89d7bb375896b","97d7b7bb66d187c3c9e17bf24df1c01a5b738926ce21d7833de2d2e85ff92c30","4665d57068ddc3750d377ffef946fbc91d8e3943bacc1661712fdd54ff14470e","db888ae859fc09c924579fde52717dba727573416eb26b44df42695d3939d28c","1f266537da709cf5b1f8c66b626ea4219679ad1009a2265fe8936d4b2a0a9e30","31da079364039a4ff49bebee7e8736af947d876e1fc387c4403ac1deb2bcc43c","aad398c14dc9dd8dcb376e82017d52944c084a26f50dcfa3a357549c4dfc4d8d","9716918f1cfec506df6d3186332e89ec1a5592a1488406a6aaa968c2fa86300e","2a88b0cd39a272dca74ae1a9b1054e27fb62499d03aa39121f4630d75a97d0b6","067ddaf397daad97fd95702179ab720ba12ba0c49e4f072a3dc114081cc71fba","f3614a41692cd52967dde5d9af0bea0e2bfce275259987808d6bf6f46ae34c6a","0527cf68aca6cd18e99569ed0584b688ec985850a91b107750c3216ca9402cf2","5229b2fc3d35734bbe2959107d0618274fcc7f8cc3ebe8d07a785aa1916f1383","7eb5c9b669497776d7f307981604ddee632efbf9c2bf09e1b011a0aad12ab990","d6743ba5373704b8b6b2285092f3497c24c9d61d33f8c46c3d6305c7587271c8","f80ccf443b11f1bce8dc82ad3c1ad19490123e137f73fd5698584c0543ccd8e9","6c0b7024a5c30599be33a5bda520812ea03ce1b377d9e5c84a45d621753ed64f","2b5ada40b83580c6692ccf4f90314b48c1302114a5809d48198fd471895c1cae","c48b8e7a2b4023e5b5b78ebad5bd1807662157a9cedc2a99925904acd4843c03","a8233c6ea5806570432fcdaf946da65ade5e58aa6fefbd072d9f662a97144d8f"],"paragraph_range_zero_based":[22680,22703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22680"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of minimum K0 values. Minimum K0 parameter denotes minimum applicable value(s) for the TDRA table for PDSCH and for A-CSI RS triggering Offset(s) (see TS 38.214 [19], clause 5.3.1).","paragraph_zero_based":22704},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-1-2","paragraph_zero_based":22705},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":22706},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":22707},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent in PDSCH-Config which is not used for MBS CFR, the UE applies the value 1.","paragraph_zero_based":22708},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-1-2","paragraph_zero_based":22709},{"literal_text_all_w_t_and_m_t":"When configured, enhanced Type 3 HARQ-ACK codebook triggering by DCI format 1_2 is enabled.","paragraph_zero_based":22710},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field-1-2","paragraph_zero_based":22711},{"literal_text_all_w_t_and_m_t":"Enables the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in DCI format 1_2 if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH cell group.","paragraph_zero_based":22712},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackDCI-1-2","paragraph_zero_based":22713},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to report A/N for all HARQ processes and all component carriers configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":22714},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-RetxDCI-1-2","paragraph_zero_based":22715},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":22716},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList, pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH","paragraph_zero_based":22717},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data.","paragraph_zero_based":22718},{"literal_text_all_w_t_and_m_t":"The field pdsch-TimeDomainAllocationList (with or without suffix) applies to DCI format 1_0 and DCI format 1_1 (see table 5.1.2.1.1-1 in TS 38.214 [19]), and if the field pdsch-TimeDomainAllocationListDCI-1-2 is not configured, to DCI format 1_2. If the field pdsch-TimeDomainAllocationListDCI-1-2 is configured, it applies to DCI format 1_2 (see table 5.1.2.1.1-1A in TS 38.214 [19]). The field pdsch-TimeDomainAllocationListForMultiPDSCH applies to DCI format 1_1.","paragraph_zero_based":22719},{"literal_text_all_w_t_and_m_t":"The network does not configure the pdsch-TimeDomainAllocationList-r16 simultaneously with the pdsch-TimeDomainAllocationList (without suffix) in the same PDSCH-Config.","paragraph_zero_based":22720},{"literal_text_all_w_t_and_m_t":"prb-BundlingType, prb-BundlingTypeDCI-1-2","paragraph_zero_based":22721},{"literal_text_all_w_t_and_m_t":"Indicates the PRB bundle type and bundle size(s) (see TS 38.214 [19], clause 5.1.2.3). If dynamic is chosen, the actual bundleSizeSet1 or bundleSizeSet2 to use is indicated via DCI. Constraints on bundleSize(Set) setting depending on vrb-ToPRB-Interleaver and rbg-Size settings are described in TS 38.214 [19], clause 5.1.2.3. If a bundleSize(Set) value is absent, the UE applies the value n2. The field prb-BundlingType applies to DCI format 1_1, and the field prb-BundlingTypeDCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.3).","paragraph_zero_based":22722},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-1-1, priorityIndicatorDCI-1-2, priorityIndicatorDCI-4-2","paragraph_zero_based":22723},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"priority indicator\" in DCI format 1_1/1_2/4_2. When the field is absent in the IE, then 0 bit for \"priority indicator\" in DCI format 1_1/1_2/4_2. The field priorityIndicatorDCI-1-1 applies to DCI format 1_1, the field priorityIndicatorDCI-1-2 applies to DCI format 1_2 and the field priorityIndicatorDCI-4-2 applies to DCI format 4_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":22724},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDynDCI-1-2","paragraph_zero_based":22725},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_2 is enabled (see TS 38.213 [13], clause 9.A).","paragraph_zero_based":22726},{"literal_text_all_w_t_and_m_t":"p-ZP-CSI-RS-ResourceSet","paragraph_zero_based":22727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8be710ae397db8c0ef85b0e82250d14f7716e75a4460fc18c559766f9fed29e7","b7e709c0c19454e2dba8b3aaac6d600d991dd61428341a89a5bdd457e331e38e","08b621d9fdd225cc75feaed9fa35af10e925a0e439c992bd1ca3d0893ed7db29","505e8758cf7f2f9fedf409e941d3168386c37bd22a72cf2a88cbdfb2353f284f","ac5a9973ef4a85052aae36c4aa3bc37703889e669eba1c7ae478f62526e57a5a","59e59efe4086e692c2c6f1a87000f779ed88d062f16189c6d55bf970add223d8","558b17ef2dc65fc885caa2a807b684d150c3c3e423a162ec3acf3e087f572ea7","b66ead32b644e9ffcda7175ccd02be9ffa0212c440ea1e3beead83defdff57d2","28aa81ea409c3d2a81277e3ef9db079d329c5d3e17034d0ec45b6fbc432cf5a9","bec8eccf4320244afe26c925eb2450ab938d31663b87bfc074bd5f0a33f4c127","a4dda35b8def481aa15b2556c25f5a472f8720b501f48bfb4a4386d5e8584f56","61f7fdd2ec5bbf1fba56ba7eedc5e9583cc725f8ba3c3ac8442428938cef8fe9","5982c7a57893491a32cdf29e624e564c33436117b484adf809491b1879fa3c4c","de76732f4c9928fb9f0679aa6313427d736004e4fd9fd863e37d9611c3ee7b61","5aa7a4117ee65def5074fcc67f0f0f0855fa49da24fd72e55f5b58dcaec2d445","c452ce5e517b65d2c7c5992c0033c0a4083ca66c98b7073d53324f6b794682db","65f4b1002998f5686a6520c6e9ca1e18ae785290964bae000955e1bca249c87e","d8233af6bb8d6b2c5cec428b2026c92b719602e2957fb34a195e05783071645d","b414af8094133b16ffaf56d80cf3a8675ef96785cfcf3135524faad1ea8fc4d3","0311dfd88889ed383e52b295716c768bc083a3b8374c6ebbe484d75b7e65656c","741c3d52f829a4dc61e6ed0429e23548565f8ade83d60373fcabbb8d8d496a6d","c1e5d2e7ae34cb8a99aea9d957435ae7f36a09451371691c17bc8c6891e40c5f","a40e988ce4ba9781530a813fa3eb30a73f002e78082457a3ee8fed7802b77ca7","266ed9e1634abeb6b5282cdfb8a6a10b74a24a28a5885586fcb2861102703bea"],"paragraph_range_zero_based":[22704,22727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22704"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A set of periodically occurring ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network uses the ZP-CSI-RS-ResourceSetId=0 for this set.","paragraph_zero_based":22728},{"literal_text_all_w_t_and_m_t":"If p-ZP-CSI-RS-ResourceSet is configured in both PDSCH-Config for MBS CFR and PDSCH-Config for the assoicated BWP, it is subject to UE capability whether the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for MBS CFR can be different from the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for the assoicated BWP.","paragraph_zero_based":22729},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup1, rateMatchPatternGroup1DCI-1-2","paragraph_zero_based":22730},{"literal_text_all_w_t_and_m_t":"The IDs of a first group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup1 applies to DCI format 1_1, and the field rateMatchPatternGroup1DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":22731},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup2, rateMatchPatternGroup2DCI-1-2","paragraph_zero_based":22732},{"literal_text_all_w_t_and_m_t":"The IDs of a second group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup2 applies to DCI format 1_1, and the field rateMatchPatternGroup2DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":22733},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":22734},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both MBS CFR and its associated BWP, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":22735},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":22736},{"literal_text_all_w_t_and_m_t":"Selection between config 1 and config 2 for RBG size for PDSCH. The UE ignores this field if resourceAllocation is set to resourceAllocationType1 (see TS 38.214 [19], clause 5.1.2.2.1).","paragraph_zero_based":22737},{"literal_text_all_w_t_and_m_t":"referenceOfSLIVDCI-1-2","paragraph_zero_based":22738},{"literal_text_all_w_t_and_m_t":"Enable using the starting symbol of the PDCCH monitoring occasion in which the DL assignment is detected as the reference of the SLIV for DCI format 1_2. When the RRC parameter enables the utilization of the new reference, the new reference is applied for TDRA entries with K0=0. For other entries (if any) in the same TDRA table, the reference is slot boundary as in Rel-15. PDSCH mapping type A is not supported with the new reference. The new reference of SLIV is not configured for a serving cell configured to be scheduled by cross-carrier scheduling on a scheduling cell with different numerology (see TS 38.212 [17] clause 7.3.1 and TS 38.214 [19] clause 5.1.2.1).","paragraph_zero_based":22739},{"literal_text_all_w_t_and_m_t":"repetitionSchemeConfig","paragraph_zero_based":22740},{"literal_text_all_w_t_and_m_t":"Configure the UE with repetition schemes. The network does not configure repetitionSchemeConfig-r16 and repetitionSchemeConfig-v1630 simultaneously to setup in the same PDSCH-Config. The network does not configure this parameter and sfnSchemePDSCH in MIMOParam-r17 simultaneously in the same serving cell.","paragraph_zero_based":22741},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-1-2","paragraph_zero_based":22742},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 5.1.2.2). The field resourceAllocation applies to DCI format 1_1, and the field resourceAllocationDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.2.2).","paragraph_zero_based":22743},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-1-2","paragraph_zero_based":22744},{"literal_text_all_w_t_and_m_t":"Configure the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 1_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 5.1.2.2.2).","paragraph_zero_based":22745},{"literal_text_all_w_t_and_m_t":"sizeDCI-4-2","paragraph_zero_based":22746},{"literal_text_all_w_t_and_m_t":"Indicates the size of DCI format 4-2 (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":22747},{"literal_text_all_w_t_and_m_t":"sp-ZP-CSI-RS-ResourceSetsToAddModList","paragraph_zero_based":22748},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring semi-persistent zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList) (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":22749},{"literal_text_all_w_t_and_m_t":"tci-StatesToAddModList","paragraph_zero_based":22750},{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports (see TS 38.214 [19], clause 5.1.5). If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":22751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["458845647810aac562b2965f30b5ae2b89378bb0fe98f7c4829bde9b3bd6bc46","1a4afda357288e4d2cc9772dbd368f9e8b862d858b604bb3937742ef8e137ca4","6fb8eed77ce901cd4d7903dc38c1aff728d182b676c35da746f49a5e6be9cef3","d7e06298f64da37eb897bf4c80d744cbe0c6d64aed46689ee59e639b6e1066ad","3215430464152e68008efad80f6197ccc7ab78138afbacebd1b4c6465fedc932","325bada7fa2b3f4021641a20ef53441ac840ad108b895846811dc7af8fbbe444","9cc9d76b8a4cb5bd3b702763ff7e946d3d86d7862f0d0e6a49e43499a43ffbe1","2d1baadaa1144087db550de4a51ee1cef614a94e86a173f9dc8b33c1d0a4fb9d","d0eb788c35d7555a003c3e983092f194ab107a748d7d538848bc625220ccb769","81ac7ef6c28f0aba3183a87db437a526546524eb82f83712d0ca14c6ee548685","856a591a9f24e5df73806f49c48e37154937ea49dcb7531f1d7ad50bd727b2e1","c8b97e83df59796f2016592936e282c2925b29ba7a7a2ab508c9e309210ba028","84a835d1d2c01fde9b747ff21510456b837734164d2e95c43284f1381de2c673","70bc9b021b0c1b5751ef914137208bef6f45b6a3f76456c8a277b2b890b5e5c5","2b1d2121c7b61837d361c0c79c5bc528d780d2b58211a9089466f4f51210b3c2","68ac5569e2dbd88f229ee54ce3dabfcc21d736677ed0db2e715f91d159537d25","19d3c14d98e0fb0fa82dd798baa34c5db8d360e8ca55e745fbf44341b80eac19","0ce472dbd625f9bac1464f511f00d3cdcf44599ccc710d44fd8304146d57e73a","e30dc1e50350681bf0b5b0cb43ee835cee438864629429d7ceb7ba2a70c7e349","7da59a0732828794a9f0658ae108b35306b7962ba523cc22fee1568f92dac8a5","c316745d3b7ed259986e7d1fbb17b52b313c1da76dacfab33cbd69b67aae1fc2","e17343248aa7dc0ffeb13164162118c51ea66d263e74fe82b9451822735be532","9301f70670de1c08e90b33a1921de0e061659d9d2bbbf822b5e3813afca8e623","d3ae39eea01d8997463e90d667ebcd9503aa0ba48f2b371069389db1d7b01646"],"paragraph_range_zero_based":[22728,22751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p22728"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":22752},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and BWP where the configuration for dl-OrJointTCI-StateToAddModList-r17 are defined. When this field is present, dl-OrJointTCI-StateToAddModList and dl-OrJointTCI-StateToReleaseList are not present. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":22753},{"literal_text_all_w_t_and_m_t":"vrb-ToPRB-Interleaver, vrb-ToPRB-InterleaverDCI-1-2","paragraph_zero_based":22754},{"literal_text_all_w_t_and_m_t":"Interleaving unit configurable between 2 and 4 PRBs (see TS 38.211 [16], clause 7.3.1.6). When the field is absent, the UE performs non-interleaved VRB-to-PRB mapping.","paragraph_zero_based":22755},{"literal_text_all_w_t_and_m_t":"xOverheadMulticast","paragraph_zero_based":22756},{"literal_text_all_w_t_and_m_t":"Accounts for an overhead from CSI-RS, CORESET etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19]).","paragraph_zero_based":22757},{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceToAddModList","paragraph_zero_based":22758},{"literal_text_all_w_t_and_m_t":"A list of Zero-Power (ZP) CSI-RS resources used for PDSCH rate-matching. Each resource in this list may be referred to from only one type of resource set, i.e., aperiodic, semi-persistent or periodic (see TS 38.214 [19]).","paragraph_zero_based":22759},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22760},{"literal_text_all_w_t_and_m_t":"–PDSCH-ConfigCommon","paragraph_zero_based":22761},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ConfigCommon is used to configure cell specific PDSCH parameters.","paragraph_zero_based":22762},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon information element","paragraph_zero_based":22763},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22764},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-START","paragraph_zero_based":22765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22766},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":22767},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList                  PDSCH-TimeDomainResourceAllocationList          OPTIONAL,   -- Need R","paragraph_zero_based":22768},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22769},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22771},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-STOP","paragraph_zero_based":22772},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22774},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon field descriptions","paragraph_zero_based":22775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["985ed0a10746d92c0842d1af16c3ed44e8d407451f98d1be9824c613b73fe0f7","038e270b28838272385921379b05d0c280924dd4b57da25e5bb19f8b53353642","d94e0e9fd11f25b0a58a655694accd14d459eb2aae0cff4728937bf0fab79f08","9b51d873710dd30e61a9b576ead0a6146fad7966e1658c144765dbce0f457f08","4d00e72f5a48f26e1f66a56b98bf84a1c3604b071d976fa4ae312084b218096d","6b8d45dcb5ca3d310ffc199eddbe995ec90391d9e474f115a2786594eccf0cdf","313408c6f664366a1de174f295ab2495794c20702bb405430cf67383a07a6094","1cefd4888c59aa75d3cd7d6c64ab3