{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TMGI-r17 ::=                     SEQUENCE {","paragraph_zero_based":40080},{"literal_text_all_w_t_and_m_t":"    plmn-Id-r17                      CHOICE {","paragraph_zero_based":40081},{"literal_text_all_w_t_and_m_t":"        plmn-Index                       INTEGER (1..maxPLMN),","paragraph_zero_based":40082},{"literal_text_all_w_t_and_m_t":"        explicitValue                    PLMN-Identity","paragraph_zero_based":40083},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":40084},{"literal_text_all_w_t_and_m_t":"    serviceId-r17                    OCTET STRING (SIZE (3))","paragraph_zero_based":40085},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":40086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40087},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-STOP","paragraph_zero_based":40088},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40090},{"literal_text_all_w_t_and_m_t":"TMGI field descriptions","paragraph_zero_based":40091},{"literal_text_all_w_t_and_m_t":"plmn-Index","paragraph_zero_based":40092},{"literal_text_all_w_t_and_m_t":"PLMN index or NPN index according to the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1. If this field is included in the MRB-ToAddMod-r17, the UE translates the plmn-Index into the PLMN Identity or SNPN Identity based on the configuration in SIB1 (which is the SIB1 of the target cell in case of handover). The explicitValue is not used for MBS service(s) of an SNPN.","paragraph_zero_based":40093},{"literal_text_all_w_t_and_m_t":"serviceId","paragraph_zero_based":40094},{"literal_text_all_w_t_and_m_t":"Uniquely identifies the identity of an MBS service within a PLMN. The field contains octet 3- 5 of the IE Temporary Mobile Group Identity (TMGI) as defined in TS 24.008 [38]. The first octet contains the third octet of the TMGI, the second octet contains the fourth octet of the TMGI and so on.","paragraph_zero_based":40095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40096},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":40097},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":40098},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40099},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":40100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40101},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":40102},{"literal_text_all_w_t_and_m_t":"maxAI-DCI-PayloadSize-r16               INTEGER ::= 128      --Maximum size of the DCI payload scrambled with ai-RNTI","paragraph_zero_based":40103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fd2a7f1ee6a595985efe121b8cba6a0dbe6870179a24e868c3af40ae1115cdfa","3648803275579b1c5f63bf426c8c6592ce9756e80027112932ba15af6abf8ea5","8f3f5768e336ad678d68a5597ee73f4cc1fe7053e22c2d0c01739105fdfe1026","1464d5e83bf42e2f6557b95b06e521d648a7dd70897d7fc570a9b69faf503967","44baf5ffec4714a2c5400a3f61c6dbb8b13733cab0c2ac845fc7e323b1a4c15b","9ffb9b108d5f3d9eec48bc7eae9fea2cca716ef5af74af6cf889963754546e6e","b5a744c5b1cc9c9c3af6b17e53e4e9d1fb64951a097463f11b9390400822d3d6","44b5c9ff94217699a2083671a