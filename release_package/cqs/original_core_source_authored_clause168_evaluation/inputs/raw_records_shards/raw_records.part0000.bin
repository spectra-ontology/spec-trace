{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                               spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":37848},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG2-r16               INTEGER (1..99)","paragraph_zero_based":37849},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37851},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-STOP","paragraph_zero_based":37852},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37854},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig field descriptions","paragraph_zero_based":37855},{"literal_text_all_w_t_and_m_t":"sl-ConfigIndexCG","paragraph_zero_based":37856},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant.","paragraph_zero_based":37857},{"literal_text_all_w_t_and_m_t":"sl-CG-MaxTransNumList","paragraph_zero_based":37858},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of times that a TB can be transmitted using the resources provided by the sidelink configured grant. sl-Priority corresponds to the logical channel priority.","paragraph_zero_based":37859},{"literal_text_all_w_t_and_m_t":"sl-FreqResourceCG-Type1","paragraph_zero_based":37860},{"literal_text_all_w_t_and_m_t":"Indicates the frequency resource location of sidelink configured grant type 1. An index giving valid combinations of one or two starting sub-channel and length (jointly encoded) as resource indicator value (RIV), as defined in TS 38.214 [19].","paragraph_zero_based":37861},{"literal_text_all_w_t_and_m_t":"sl-HARQ-ProcID-Offset","paragraph_zero_based":37862},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process ID for sidelink configured grant type 1 or sidelink configured grant type 2, see TS 38.321 [3], clause 5.8.3.","paragraph_zero_based":37863},{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN","paragraph_zero_based":37864},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for sidelink configured grant type 1. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":37865},{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN-Type2","paragraph_zero_based":37866},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for PSCCH/PSSCH transmissions without a corresponding PDCCH on sidelink configured grant type 2. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":37867},{"literal_text_all_w_t_and_m_t":"sl-NrOfHARQ-Processes","paragraph_zero_based":37868},{"literal_text_all_w_t_and_m_t":"This field indicates the number of HARQ processes configured for a specific sidelink configured grant. It applies for both type 1 and type 2.","paragraph_zero_based":37869},{"literal_text_all_w_t_and_m_t":"sl-PeriodCG","paragraph_zero_based":37870},{"literal_text_all_w_t_and_m_t":"This field indicates the period of sidelink configured grant in the unit of ms.","paragraph_zero_based":37871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44688efa136a026ebb57fd729caf6a310b4e9602ba6e75e8e9a9255288351a93","398ce884e12c64ecf03ddabdc2d45de7e7bd496b8cbe5942566cfd30c1a4ef70","f9b6ee8f34d7338809f89031d0b310590675a30bd3c5bba734b87e3123ea58f6","808a684c22f510d75edeb35ba