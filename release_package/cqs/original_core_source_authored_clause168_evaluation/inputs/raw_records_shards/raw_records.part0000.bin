{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":37272},{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":37273},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":37274},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":37275},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":37276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37277},{"literal_text_all_w_t_and_m_t":"–PhysCellIdUTRA-FDD","paragraph_zero_based":37278},{"literal_text_all_w_t_and_m_t":"The IE PhysCellIdUTRA-FDD is used to indicate the physical layer identity of the cell, i.e. the primary scrambling code, as defined in TS 25.331 [45].","paragraph_zero_based":37279},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD information element","paragraph_zero_based":37280},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37281},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-START","paragraph_zero_based":37282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37283},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD-r16 ::=        INTEGER (0..511)","paragraph_zero_based":37284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37285},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-STOP","paragraph_zero_based":37286},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37288},{"literal_text_all_w_t_and_m_t":"–RRC-TransactionIdentifier","paragraph_zero_based":37289},{"literal_text_all_w_t_and_m_t":"The IE RRC-TransactionIdentifier is used, together with the message type, for the identification of an RRC procedure (transaction).","paragraph_zero_based":37290},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier information element","paragraph_zero_based":37291},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37292},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-START","paragraph_zero_based":37293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37294},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier ::=       INTEGER (0..3)","paragraph_zero_based":37295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9712fcd3801c48ed4c63fdc13c592d267dbbdb9a59dd660b84d07fba7e677290","08029bd6a364b469850a35371899ab4e39f319e5e6013268303a0ccd72d88ab9","939465696583e76c170db05940e29bb1b8157c7eee5c7a316ab6c1f1e78343cc","2462844137859580bbb55d3d33c56a0018b671c052276fbbf1173680ab9e9395","fe43ad3979f5af17043cf16c47de13a1314541af7ec7549112932d6e84837432","0f50915ce100e7bd9e77b238d1dab3e344c8a5ee7d9fc4cdc6efb85868824f8b","1d324c3130b434001f223c2ae439f585bff08c78ec6ba29806bd286c359a7d21","e1ae06e106e0ba91aa316f454fd07e8327365a16e8d8a6d9e9386bcfd55610ba","dd83deffd00060c50cdc1ca6c094bca7f4e4cfa4b0d13883e9f45f6988f8db8b","8f8d1f3eb16b92b803eec0f36e37be96b41aab516bf3d545540097b1d39829ed","edf72f42559230cd9c57de8891cfea000aed203ddd6da6049333c7c84523645b","3b8cfabac27f93c33c8b0e0cacfa525d8a77ebd672e1f9ca1d82f1f24856a