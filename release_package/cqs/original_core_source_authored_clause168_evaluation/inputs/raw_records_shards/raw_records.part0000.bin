_t":"1>stop timer T346i, if running;","paragraph_zero_based":3685},{"literal_text_all_w_t_and_m_t":"1>release referenceTimePreferenceReporting from the UE Inactive AS context, if stored;","paragraph_zero_based":3686},{"literal_text_all_w_t_and_m_t":"1>release sl-AssistanceConfigNR from the UE Inactive AS context, if stored;","paragraph_zero_based":3687},{"literal_text_all_w_t_and_m_t":"1>release musim-GapAssistanceConfig from the UE Inactive AS context, if stored and stop timer T346h, if running;","paragraph_zero_based":3688},{"literal_text_all_w_t_and_m_t":"1>release musim-GapConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3689},{"literal_text_all_w_t_and_m_t":"1>release musim-LeaveAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3690},{"literal_text_all_w_t_and_m_t":"1>release propDelayDiffReportConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3691},{"literal_text_all_w_t_and_m_t":"1>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3692},{"literal_text_all_w_t_and_m_t":"1>release rrm-MeasRelaxationReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3693},{"literal_text_all_w_t_and_m_t":"1>release uav-FlightPathAvailabilityConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3694},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9fee590bf9315a0da098af1a265b3d063db88dca31e62d587068347bc88a0a89","adfc5fb1d84cd6045008affdffb9deacb26b5bbc3cd975e28c4735040e7e581e","b4a3422d6d9ab97be4210e27bdcd5dd64f31