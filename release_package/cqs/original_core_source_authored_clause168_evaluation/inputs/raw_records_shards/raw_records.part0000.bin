{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ReferenceLocation contains location information used as a reference location. The value of the field is same as Ellipsoid-Point defined in TS37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":25632},{"literal_text_all_w_t_and_m_t":"ReferenceLocation information element","paragraph_zero_based":25633},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25634},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-START","paragraph_zero_based":25635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25636},{"literal_text_all_w_t_and_m_t":"ReferenceLocation-r17 ::= OCTET STRING","paragraph_zero_based":25637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25638},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-STOP","paragraph_zero_based":25639},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25641},{"literal_text_all_w_t_and_m_t":"–ReferenceTimeInfo","paragraph_zero_based":25642},{"literal_text_all_w_t_and_m_t":"The IE ReferenceTimeInfo contains timing information for 5G internal system clock used for, e.g., time stamping, see TS 23.501 [32], clause 5.27.1.2.","paragraph_zero_based":25643},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo information element","paragraph_zero_based":25644},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25645},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-START","paragraph_zero_based":25646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25647},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo-r16 ::= SEQUENCE {","paragraph_zero_based":25648},{"literal_text_all_w_t_and_m_t":"    time-r16                            ReferenceTime-r16,","paragraph_zero_based":25649},{"literal_text_all_w_t_and_m_t":"    uncertainty-r16                     INTEGER (0..32767)          OPTIONAL,   -- Need S","paragraph_zero_based":25650},{"literal_text_all_w_t_and_m_t":"    timeInfoType-r16                    ENUMERATED {localClock}     OPTIONAL,   -- Need S","paragraph_zero_based":25651},{"literal_text_all_w_t_and_m_t":"    referenceSFN-r16                    INTEGER (0..1023)           OPTIONAL    -- Cond RefTime","paragraph_zero_based":25652},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25654},{"literal_text_all_w_t_and_m_t":"ReferenceTime-r16 ::=           SEQUENCE {","paragraph_zero_based":25655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cf310a2fdeb32cd7ade63a1015778344ef27ff754f4c9bcf5db309482a0f5df6","3e65cb905d0826309a8cc6b22cf3f5802629229bfd0658daa4aa86c89570ee95","ba482cac1dc5442d49eef12eb0c6adf8190096b9767969c016ee458cfd4e2e1a","842b9c837a95068e83b86570097ba977fb5b2bbb334e2886446c3e1e42407479","4a09b60da044defc5a6fcc22a617f63becaa05230f0da748dcbc8cea794ccea6","b09350687bca206eb04f381aa922bc5ae3b5358bb530b73e7cef9fcb6692b881","48b9435023db7e1d8d2e904dd0e742ed54a5400297fcb4e9c6f7a42724d03f8f","a58947d5d3eaa78942454b583b9a1fa268426fff187846b0dfdc7a79d115c373","e6d9ca849db0a29ee25e8c6ae53d2f06addb758217d12bc4f1d48d93ed089420","19a77f2bb7099c6c29ee024dd7113a016e1f22dd609709d529adb4bcf139295d","72d865aa1375fd4e50880219eee805a3cc3d8eee84216609e4dea5f7f3dc0dce","7c57ab582c44e5fa783ac5a94a1f0a651b2b7fc6518637e9d35ba56a27fc919f","add8ac1499c7cdc9657ac0032d35d5922fbb98d1876bd9c8f793a2b4329b4061","9033c30f9ad5deb2c58c3348d012d814dc29716b449110a5fcc3aa30584b2acf","7df51d08d54e6ed14b6359add9b8756fafdd63be348ddffb851f6026801a3422","bc0122433d3439494402b9b17343b9df4c2a5912982e4a4c9ff3b558c6d83107","a2c94ec052908a6c1fe5e7343208aa80563c962545d151feb2b69a1e81e5fc4f","cc7d12b289ed29a66e5ca809a567d046b4c388cda3f308bf981a5c0d5d1a9034","05232f62544a36c94da00ca474ba346cc47c3267f20f1d48921fb49b72c032eb","629ddbb15d09507228bf32d4de3cb7a0effb9a305e66ed61cef74a2e3953a374","80e10ad8281dfa8ae0c6c55d0a6e6e690a4ca757911d7f2cd5bcc345a9ddd077","9bc7d4bc35d3cb0df9557d3c5d4c92cb039c0b3b2b213a88d3391f32126e1595","8ea4b6ab4c925b88487f83fb3a91afca4face2dfad881a41bc2de411a33cc473","a216ca89b39f67052de6e6cb4280b99922cd4b8a129ff279c5a375b9df903ee8"],"paragraph_range_zero_based":[25632,25655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25632"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    refDays-r16                         INTEGER (0..72999),","paragraph_zero_based":25656},{"literal_text_all_w_t_and_m_t":"    refSeconds-r16                      INTEGER (0..86399),","paragraph_zero_based":25657},{"literal_text_all_w_t_and_m_t":"    refMilliSeconds-r16                 INTEGER (0..999),","paragraph_zero_based":25658},{"literal_text_all_w_t_and_m_t":"    refTenNanoSeconds-r16               INTEGER (0..99999)","paragraph_zero_based":25659},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25661},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-STOP","paragraph_zero_based":25662},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25663},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25664},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo field descriptions","paragraph_zero_based":25665},{"literal_text_all_w_t_and_m_t":"referenceSFN","paragraph_zero_based":25666},{"literal_text_all_w_t_and_m_t":"This field indicates the reference SFN corresponding to the reference time information. If referenceTimeInfo field is received in DLInformationTransfer message, this field indicates the SFN of PCell.","paragraph_zero_based":25667},{"literal_text_all_w_t_and_m_t":"time","paragraph_zero_based":25668},{"literal_text_all_w_t_and_m_t":"This field indicates time reference with 10ns granularity. If included in DLInformationTransfer and if UE-side TA PDC is de-activated, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. If included in DLInformationTransfer and if UE is requested to transmit UE Rx-Tx time difference measurement, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. Otherwise, the indicated time is referenced at the network, i.e., without compensating for RF propagation delay.","paragraph_zero_based":25669},{"literal_text_all_w_t_and_m_t":"The indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from the origin of the time field.","paragraph_zero_based":25670},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in DLInformationTransfer message, the time field indicates the time at the ending boundary of the system frame indicated by referenceSFN. The UE considers this frame (indicated by referenceSFN) to be the frame which is nearest to the frame where the message is received (which can be either in the past or in the future).","paragraph_zero_based":25671},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in SIB9, the time field indicates the time at the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted.","paragraph_zero_based":25672},{"literal_text_all_w_t_and_m_t":"If referenceTimeInfo field is received in SIB9, this field is excluded when determining changes in system information, i.e. changes of time should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":25673},{"literal_text_all_w_t_and_m_t":"timeInfoType","paragraph_zero_based":25674},{"literal_text_all_w_t_and_m_t":"If timeInfoType is not included, the time indicates the GPS time and the origin of the time field is 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time). If timeInfoType is set to localClock, the origin of the time is unspecified.","paragraph_zero_based":25675},{"literal_text_all_w_t_and_m_t":"uncertainty","paragraph_zero_based":25676},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty of the reference time information provided by the time field. The uncertainty is 25ns multiplied by this field. If this field is absent, the uncertainty is unspecified.","paragraph_zero_based":25677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25678},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7e5a1c0c1a1123b85b795565d802f1c5a322c42469b41a9274ce855c6ffc9df1","672e3ecf774f3abba039fd091a1a5a1d91eaa646c92985c390c64800f194c94c","862883e0a1d76ea336e5481673617eec17d6c8167eb50d94bbf30589135238b3","9c608301b56ca3f8569e7a0dfba42691fdc172463f399e35c2126bebb040c09f","067aacd826de05b622e4e27415cd08e818af53284818889fa5a05654a3180bc8","5c7b73d44f7bf4bb67b15beba6287b56be5a2a47bca6db7215b349abd7a6a9fc","f2e28b31debd16e8300619892e276a02177116a9cd688620d70a3f0e9e10e309","255838cdbc1170bf9773060cc881896b1d70dae3dc22dab326ef0c85f6aa6e70","ee57ae54298db0a973b2e8f626a4f7a3da49422992b1cfeb1eaf5bfa1669cc7d","c0d0bf84db9ac7007eaf96b1644e5607604e6982ae012a2ed7760cbc049fc7ef","12498237331b44c481698749ea227e33d7295a253c56758d102743983e7ca1b9","dc477ab9c63b2d367de0bea42079724292d0685c1a7cfe5a054286281e57990a","44a2e2a53b85f841481f28a53fdd548e6eec107bbf35de389d04ecb43c838db2","37806a9cdb23a891fc1435dccbed95f0aab458fde2ecb0e9f168c3a8582ccbcc","c4cf24002ad005f970962ba00114c8f6a9457ef6bc8a4ba5264183f9dd08ed73","5f7fd9afa6dfc0bd5a75bd0349821edbdd6b69a3848825512941269552a0cd39","bc52acd571920856fcb1895c92f9f7f67e8b5db5b9095ce93a37ff89419aa8a7","84e54482a6f6f5fdc19f81a3edc1b1e603509d7d335a40a5392c21615e22706b","74c7d3972b73fe3fdea9f