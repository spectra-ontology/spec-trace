p48"}
{"fields":{"filename":"R2-2301167.zip::R2-2301167 - CR3872 Correction for receiving PC5 link release during path switching.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"UE is triggered to initiate re-establishment procedure during path switching from indirect to direct path upon receiving the PC5 unicast link release from the source relay UE.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"NG-RAN Architecture supporting the PC5 interface","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Re-establishment procedure in L2 U2N relay operation","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"There is no inter-operatbility issues","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"5.3.7.2","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3ae7382fac5a05fbdfcee0ce7ffa40cab8c9106486f09469eabd3ee9af9676d5","original_member_sha256":"22956335148b7a5c16c2b5dda19d49a29d30d34a1f02b6918ba645f49922cb03","paragraph_ElementTree_utf8_XML_sha256":["b09acffb5a77e8ba142a8c19b004ebde4bb0fea3906a1690ece1520d1cc64860","f958fd75f1c1026eb498ae99a26bc4a9d7c5d676540f74d58f0098fd2d07f23c","a8a9fa3ae117bcc9176c9dfd7fd9d23d23e809a7ad611149ab0ad3ec78b9decb","618cf7329158bd928681fb03a1601df89796f978bac1c2b6d369a84fded42b61","2ac56d8282620d8bbd982a58c3fe388fa4a0197d8c6f3ab37b0140b201da523b","9b4b0949a22330b9dd6720845b0a094e2a717d9d75e060a5f533c77bd5943c62","c1cdf4906805eea3df5a2d720c6a7ae5ea5a711629bb5be02e9fd4c20016ca04","7c960007b366a1cbcc63cc205f311625005c1744254b9b92acda2226936f8403","fca86c16f2c9d5c2d7dce6dcf26a2d34ad48b92a9b16a15b4b174b6aec34c6ea","fcfa32f0e2de81ed02f1ec65dc59fa19da5a1ce6b9f842d62a64f6e7dc129980","1082b739de4451ffd893a981f5b3ba4d4c0e908f37f85daf23e6b6c03ce77812","0977bb3b41d4465f2a10f894865e7f480764fab4ef25206478765bcc1ca9fd76","e029a03423dcf65fcdb8c7b233df32976603d72bc646160d8dbb7c277404128a","ec3bd28ebce508a86199de0d889871c31019348df4bac83661aa646c6108d14f","0cfb47f047a3b46aabf67fa3a58b324dc338927aec0ca0252cece5acb3c4b993","ce297274ac0172853e82b2596c4a943b0f9772add1a2dd01286f2e8f1d9aad1e","6953e29ca61f6d2a84b20fe5dfba001ec1f55dcca79d2e2a721fd477912ac842","03d710b239b3e419662a036a3d0b8ae7e405a7904154f1642f2fe88dcf4e71d5","507bb97ef06913080550a22f2f3138b958eb43f08e2a6251b94d823c0d7f7457","ade6d007421b077c5c971cf9a1f84d9d6e9531df8bb04cd0690c143cf3f1a167","102b5e93f0973028a0475abb420a907f3bf29162caf113491879b9ef03c1d173","61c17ef6cd7048a2c1bf7f3c366d2298288b28c6b0ad7483ad639b0f09b90659","f1b294fb7