{"fields":{"filename":"R2-2305059.zip::R2-2305059 38331_Correction_FD_SL_Relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"If Sidelink UE implement this change, there is no inter-operability issue between UE and gNB.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If Sidelink TX UE implement this change, but the Sidelink RX UE is not implemented this change, there is no inter-operability issue .","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Confusion will remain in the spec about which IE is used by L3 U2N relay UE or L3 U2N remtoe UE to report its SL destinaiton. ","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"6.2.2","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_an