{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC field descriptions","paragraph_zero_based":8904},{"literal_text_all_w_t_and_m_t":"dl-DCCH-MessageNR","paragraph_zero_based":8905},{"literal_text_all_w_t_and_m_t":"Includes the DL-DCCH-Message. In this version of the specification, the field is only used to transfer the NR RRCReconfiguration, RRCRelease, and MobilityFromNRCommand messages.","paragraph_zero_based":8906},{"literal_text_all_w_t_and_m_t":"dl-DCCH-MessageEUTRA","paragraph_zero_based":8907},{"literal_text_all_w_t_and_m_t":"Includes the DL-DCCH-Message. In this version of the specification, the field is only used to transfer the E-UTRA RRCConnectionReconfiguration, RRCConnectionRelease, and MobilityFromEUTRACommand messages as specified in TS 36.331 [10].","paragraph_zero_based":8908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8909},{"literal_text_all_w_t_and_m_t":"–FailureInformation","paragraph_zero_based":8910},{"literal_text_all_w_t_and_m_t":"The FailureInformation message is used to inform the network about a failure detected by the UE.","paragraph_zero_based":8911},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":8912},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":8913},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":8914},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":8915},{"literal_text_all_w_t_and_m_t":"FailureInformation message","paragraph_zero_based":8916},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":8917},{"literal_text_all_w_t_and_m_t":"-- TAG-FAILUREINFORMATION-START","paragraph_zero_based":8918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8919},{"literal_text_all_w_t_and_m_t":"Fa