{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"In Rel-18, new functionalities were agreed for NR to provide enhanced support of XR services, which requires PDCP protocol modifications.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Following new functionalities are introduced for XR.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"PDU Set discard","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"PSI based SDU discard at congestion","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Data volume calculation for Delay Status Reporting","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["abcb1f0ce305a1c4924674150bebb13420e71cfbbff91f5c621ecd7d29f240f3","f00af9ee988b7b303f52167b46117728acbe8b3f061a8336cc64a9f408dceee1","23e6e4e3cb931d8eea9037107d606f55fc1294c01becb292f0e59f4e74e776d2","550675e2df98f4806f3966af6b23ff676f796b69b6f15fcf753e283f223a5727","8b8ec576885d3ba24c223a83df227ea73f9e3033f776eaeb3aa72817f53b7403","4fc19771745328ce5543711bf9802bd852f797ab4ebc111813829c494232d1fa","54c8d90f448bc7259c1cbca8454954426163727a16310c826bb70bd6a429bf20","5a26fdc9bd6acb25cfc6a25ac96db4eceb82a11f99c28559eb8c04cae14640c7","0bb1693f68d48289385fe52714ee94778d65ad2ea77f3a408549793009628623","2016637b7b00b7bf44850e28253c0c5548aef80b39e6a6307c8e1b6460069e76","6e22879c9fce462441b161e354572cc8c29b585c4114d8e2366a879126585fef","2f32455784c0efd82880658c590566b6f17b00b593a24aee49dc5fe997e9a58a","72b5056e63261e2a84833f00b7d4f941406561457f829bbf8304e92aa6fce9c8","31cec539257b76c84948e55d94bd6c8f6af27be33e4bcecca743baa9fdc0d47d","51a5bbd5f8d50e9966e267b58c37d6e10a3fbd2a938f18a3fe3dc03f11d569e6","6674defd5cffc9f91fd14f77619d5c7814d4a2daed82ca6561ea07ac486e5a5d","5e659080abfd33780635a251c53ca01002a01e0abb63d2a70e4aa5af2b27f6bf","875ecea518a39d9c5e9066bec