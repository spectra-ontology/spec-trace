{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID (PCI) of the SSB for the referenceSignal.","paragraph_zero_based":21936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21937},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21938},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21939},{"literal_text_all_w_t_and_m_t":"RS-SSB","paragraph_zero_based":21940},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if ssb-Index is configured for referenceSignal. Otherwise it is absent, Need R.","paragraph_zero_based":21941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21942},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS-Id","paragraph_zero_based":21943},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS-Id is an ID for a reference signal (RS) configured as PUSCH, PUCCH and SRS pathloss reference RS for unified TCI state operation.","paragraph_zero_based":21944},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id information element","paragraph_zero_based":21945},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21946},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-START","paragraph_zero_based":21947},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21948},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-Id-r17 ::= INTEGER (0..maxNrofPathlossReferenceRSs-1-r17)","paragraph_zero_based":21949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21950},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-ID-STOP","paragraph_zero_based":21951},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21952},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21953},{"literal_text_all_w_t_and_m_t":"–