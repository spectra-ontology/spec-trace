{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":24624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24625},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24626},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24627},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":24628},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured within ServingCellConfig. It is absent otherwise.","paragraph_zero_based":24629},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":24630},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured within ServingCellConfig. It is mandatory present otherwise.","paragraph_zero_based":24631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24632},{"literal_text_all_w_t_and_m_t":"–Q-OffsetRange","paragraph_zero_based":24633},{"literal_text_all_w_t_and_m_t":"The IE Q-OffsetRange is used to indicate a cell, beam or measurement object specific offset to be applied when evaluating candidates for cell re-selection or when evaluating triggering conditions for measurement reporting. The value is in dB. Value dB-24 corresponds to -24 dB, dB-22 corresponds to -22 dB and so on.","paragraph_zero_based":24634},{"literal_text_all_w_t_and_m_t":"Q-OffsetRange information element","paragraph_zero_based":24635},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24636},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-OFFSETRANGE-START","paragraph_zero_based":24637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24638},{"literal_text_all_w_t_and_m_t":"Q-OffsetRange ::=                   ENUMERATED {","paragraph_zero_based":24639},{"literal_text_all_w_t_and_m_t":"                                                dB-24, dB-22, dB-20, dB-18, dB-16, dB-14,","paragraph_zero_based":24640},{"literal_text_all_w_t_and_m_t":"                                                dB-12, dB-10, dB-8, dB-6, dB-5, dB-4, dB-3,","paragraph_zero_based":24641},{"literal_text_all_w_t_and_m_t":"                                                dB-2, dB-1, dB0, dB1, dB2, dB3, dB4, dB5,","paragraph_zero_based":24642},{"literal_text_all_w_t_and_m_t":"                                                dB6, dB8, dB10, dB12, dB14, dB16, dB18,","paragraph_zero_based":24643},{"literal_text_all_w_t_and_m_t":"                                                dB20, dB22, dB24}","paragraph_zero_based":24644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24645},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-OFFSETRANGE-STOP","paragraph_zero_based":24646},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8180834b4de986bcf17123124a829ddf528080434c688ea0f3c364134b5e33d7","7f067948679eca944f7e2fc85399f48c4a74b4f0e5e5cbeefc073aba4a4289f0","975f12fd12d824dd27b06235463944edb5675ea76d841a0fd5826edd865c7954","229d3df7b2d207f4bab45b887cfefa092f23797e87ddf3cd3112303117867ea7","5a892ed8c26185aa13b56af5b877ce9b45c9efcf7b199e3fcaf1cc1fbe22ddae","441fe7f38da7025c2a73c6af3a8a3abf594768c20dde8b668fa6479b9fc584df","fe2d63bd95400861792ce7aedaa87f3c13817ed81d0712946387c9975268a20a","8001e59340f8c26082db137c19ad171b2238b3ced088eae273b8363ddec5fa2e","dc99cc8c8a18e9107b3954d609b06fee4fba962c43fd08fbdb7dc0de2c41