{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29616},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-START","paragraph_zero_based":29617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29618},{"literal_text_all_w_t_and_m_t":"TCI-StateId ::=                     INTEGER (0..maxNrofTCI-States-1)","paragraph_zero_based":29619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29620},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-STOP","paragraph_zero_based":29621},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29622},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29623},{"literal_text_all_w_t_and_m_t":"–TCI-UL-State","paragraph_zero_based":29624},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-State indicates the TCI state information for UL transmission.","paragraph_zero_based":29625},{"literal_text_all_w_t_and_m_t":"TCI-UL-State information element","paragraph_zero_based":29626},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29627},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-START","paragraph_zero_based":29628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29629},{"literal_text_all_w_t_and_m_t":"TCI-UL-State-r17 ::=             SEQUENCE {","paragraph_zero_based":29630},{"literal_text_all_w_t_and_m_t":"    tci-UL-StateId-r17              TCI-UL-StateId-r17,","paragraph_zero_based":29631},{"literal_text_all_w_t_and_m_t":"    servingCellId-r17                ServCellIndex                                         OPTIONAL,   -- Need R","paragraph_zero_based":29632},{"literal_text_all_w_t_and_m_t":"    bwp-Id-r17                       BWP-Id                                                OPTIONAL,   -- Cond CSI-RSorSRS-Indicated","paragraph_zero_based":29633},{"literal_text_all_w_t_and_m_t":"    referenceSignal-r17              CHOICE {","paragraph_zero_based":29634},{"literal_text_all_w_t_and_m_t":"        ssb-Index-r17                    SSB-Index,","paragraph_zero_based":29635},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index-r17                 NZP-CSI-RS-ResourceId,","paragraph_zero_based":29636},{"literal_text_all_w_t_and_m_t":"        srs-r17                          SRS-ResourceId","paragraph_zero_based":29637},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":29638},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                AdditionalPCIIndex-r17                                OPTIONAL,   -- Need R","paragraph_zero_based":29639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d11bb4318d59bba55ee2519138fce1dfa361a77816ab272f5735491cf487b4c0","5ec4d4df91c609aa282b30efd0eb6354da54ca707fcf42570d6509ebbcd879f2","ef8ff5945662214bffc6e0a63f625caae2b2cbe0fe4f6199c09676152486a091","d1eafeebc93c30c492119b2f9e1a845e1ef97a7519e36dbc02a749ff228431e7","f965ee93fd831435ac3c9eb29d9f4bc5181db24422d862aeb9fcfa43cdc89e9e","f79cfef94a64213b855dbfa69843d5715fb827ead19b0240770182ea1e00d84b","c2c06a2826f23333dfd60358916b9584ea4c7b278b54454a45ab98e94b406ba8","b87a2ad4fd473736d5f5e680a037423f003b7ea757433e09d357425960b8741d","4a2fc45e40b9db7012323dca6857f8f575b86ffd70ae08a008bc353bdc5c2423","20672cf0dd88b6df34b145dd436071d031149bd8796aec0f0fab73028c06e5fc","4c02860ccccf3b105fbdc3a1db3dd0a8abf10343580d7a65c46d6a77e8eb3f3e","0525c2fbad96d0f4dc1a3d4a649059d55a7a221eb2d2068310c6ac60302192dd","86531d63629d6a6791101eb06c5d01c2be68ec786e42ae1f7c307e13926fb321","aa75fbfb9b8bbfa665368ac276b4ec878cab39c8f1c16089143be512a18a83df","666b3683b5ef108de43cc5b46eb2e49c93918dcc8a453e0d900f0efa04ecc7c6","1eb4912e7e7e81b5353773929c2206fcec5d2a5d9671abc3071eeb4f8f7b7511","4c62046dd018cc0d21246cd54f99f327857ea8ff6aeceb96b850456a7f625232","c132878aed59e57852ad43c453b5dcc24f1c84c8eac3d2f1e846237b22f1d5a9","d932d081a9e94e7c372efd983c533665789491169b65c5e8bb3d7aaac16ff25a","6fc6e2b0a5843f820092fdce4179702ae774880781adba527f7aa6a5a1a916b5","aa19757ed605fdfdfbd2fe404c407b788c9bd0a0eaf329c6806bdddd608fb483","0571934490686f40ea1ef3c5c3ea10b47397f0b1abf0111bd59ae879b3e9bb93","c3dd1985e54e675446956dda7d901c0af4911ab07660285a9461b6a57f9a1e4d","c4d95109c05f3f2e3e39a80c483b3b1733aa729d4dd2ec71baf3915bd7f3e3a0"],"paragraph_range_zero_based":[29616,29639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29616"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17              Uplink-powerControlId-r17                             OPTIONAL,   -- Need R","paragraph_zero_based":29640},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17       PathlossReferenceRS-Id-r17                            OPTIONAL,   -- Cond Mandatory","paragraph_zero_based":29641},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29642},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29643},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29644},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-STOP","paragraph_zero_based":29645},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29647},{"literal_text_all_w_t_and_m_t":"TCI-UL-State field descriptions","paragraph_zero_based":29648},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29649},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB. In case the servingCellId is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field servingCellId. Otherwise, it refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell where the ul-TCI-StateList is applied by the UE.","paragraph_zero_based":29650},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29651},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS is located in or UL BWP where the SRS is located in.","paragraph_zero_based":29652},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29653},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-UL-State is applied by the UE.","paragraph_zero_based":29654},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":29655},{"literal_text_all_w_t_and_m_t":"The ID of the reference Signal (e.g. a CSI-RS or a SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the UL TCI State is applied by the UE.","paragraph_zero_based":29656},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":29657},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the ul-TCI-ToAddModList is configured.","paragraph_zero_based":29658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29659},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29660},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29661},{"literal_text_all_w_t_and_m_t":"CSI-RSorSRS-Indicated","paragraph_zero_based":29662},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if referenceSignal is set to csi-RS-index or to srs, absent otherwise","paragraph_zero_based":29663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["151ff3