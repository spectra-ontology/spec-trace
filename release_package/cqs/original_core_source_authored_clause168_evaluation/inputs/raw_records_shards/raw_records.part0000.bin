xt_all_w_t_and_m_t":"ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResources-r17","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n1, n2, n4, n8, n16, n32, n64 }","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResourcesPerSlot-r17","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n1, n2, n3, n4, n5, n6, n8, n10,","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"n12, n14 }OPTIONAL,","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["d94ad493732e4094913123020fae32425330ac7f2e7e6b15655bde3ab1dc5b04","5a3a778bb91a8934314448d57e1cdc969158e733e70707d3803f53b2c889baee","750397dcfe666c0ba8902c622b3f03ccdbd4d3ed40da120c7f7f6f22b2574bfd","b5a19d1496f5348c034564a9a490ddd9906031f0bdb82a66a4fc255f0f241a89","686c4b496610d76af712e2b278e5aa9b38ee81c5b88549be60f8a310f9754461","d67dada867a6544ce34138c610bf8e81148fcc049ccb503547acd664bd3a5f06","91927dd5d6aa920b003eb7e1a013a01d4fe965c03b6dc1d34e662e41ae5edf0e","3243bbfe38a344a85c5dc314812d678f95002c3338f2805554728b085cdcd08b","7a180521094dabbd0d65226d04e0e5da9af03c2aca4f802c8d505a2e3c689da7","451ddbe3555cd9f42fc54e9479b88277ffe5e6aaf0c692b22513fdf78ecc52c8","79e7895eae64bf88a47dfad109496ec882e01b77ab3a84b86daf45daa61813ef","52fc70a63354baf099263ee311e059044bde957667329eca4e5cf75e62efbbc8","b8fccfb116e32ad834711e4c67e72b69f2b4a3c0a9c0e950d2a5f919465e8cb9","934929584f053873edbac0e67fd8f71c084e2fbdb5d936910f9f747288165630","73254595b988c409805e898ab10c9e33a69fac792b165f442ddf5ef4af9e523c","6f9085a30e69a9d42b1f2e0098a7b2c723a53282183fc1904cc5c19f0dc0562f","88f7ab3ef947f781f3e0be9f08459cf537ea5a61e3ef692bd9431257fd4d5318","2296d8e785a88b34fcd2611f286aad0daf45cccf038f4c64d912303770fd3634","c392367bb336c3dbbe3d246488ec2497dc103e0ee0ec9c4e3e93d5bf5f8713ba","e3936821f78cdb369e99761722355baadb2f9e98ad381fef861df98be7850453","3483e45210371c4afdbf31c126b0453db90944ce03e453359150e9eff77cc320","6b562d1565cec9c55c8d43b22923e5b7d61378e01727145b240e717b77ab6bf8","8fbf2266b564ae55407f295d05d3c4f055f8dc1ff28b7c9ed6bcc15d929360fe","674b7bfc3108c17593441dc8942cc170691f9e06240853a27914a6e6430251a8"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p408"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"switchingTimeSRS-TX-OtherTX-r17ENUMERATED { us100, us140, us200, us300, us500 }","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"PosSRS-SP-RRC-Inactive-InInitialUL-BWP-r17 ::= SEQUENCE {","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResources-r17","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"ENUMERATED {n1, n2, n4, n8, n16, n32, n64}OPTIONAL,","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"maxNumOfSemiPersistentSRSposResourcesPerSlot-r17","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10, n12, n14}","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"NR-UL-SRS-Capability field descriptions","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"srs-PosResourceConfigCA-BandList","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"This field indicates the number of SRS for positioning resources supported by the target device. The target device includes this field for each band which belongs to the srs-CapabilityBandList for the current configured CA band combination. The capability signalling comprises the following parameters:","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"-freqBandIndicatorNR indicates the current configured NR band of the target device.","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"-maxNumberSRS-PosResourceSetsPerBWP indicates the maximum number of SRS Resource Sets for positioning supported by the target device per BWP. Enumerated values n1, n2, n4, n8, n12, n16 correspond to 1, 2, 4, 8, 12, 16 SRS Resource Sets for positioning, respectively.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"-maxNumberSRS-PosResourcesPerBWP indicates the maximum number of periodic, semi-persistent, and aperiodic SRS Resources for positioning supported by the target device per BWP. Enumerated values n1, n2, n4, n8, n16, n32, n64 correspond to 1, 2, 4, 8, 16, 32, 64 SRS Resources for positioning, respectively.","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"-maxNumberPeriodicSRS-PosResourcesPerBWP indicates the maximum number of periodic SRS Resources for positioning supported by the target device per BWP. Enumerated values n1, n2, n4, n8, n16, n32, n64 correspond to 1, 2, 4, 8, 16, 32, 64 periodic SRS Resources for positioning, respectively.","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"-maxNumberAP-SRS-PosResourcesPerBWP indicates the maximum number of aperiodic SRS Resources for positioning supported by the target device per BWP. Enumerated values n1, n2, n4, n8, n16, n32, n64 correspond to 1, 2, 4, 8, 16, 32, 64 aperiodic SRS Resources for positioning, respectively.","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["646e03e3604342ab1f8250df168772b38d2d0a77fcc289833512c6e252e4e160","86669583d2e426cecfa011f0c31a1120b07f611ac903b834b983120cdebf3fe6","7ea5d96514169b781c28c7faedc7a93a746030607837c43e907ff31be0e9e6f9","cf58b550c178b7de9eabe7e659f9824f149fb5dba3681033c5641c68dc9d10a8","d03c4f1a36d90c420fec3037d23b5c65d0005392625177e3410d5984065a29ba","18b9aaece35ea42c0bdba72bc49d65ceb21d7140a590b8ebc8f2a6c72997708e","4659c29826496441929cfea06bbdc50beb4bc4b909742623d0b1b9f7f6818dd1","5a444ace44622c7efe4ca772909f26f11b3f15f19cd340b8bf068b4f0db768b5","e973889c779cac8220bd59bd5b67fca9ccd7a320b7da0cd06477de2caeda6e1d","8714e0b5c0386a72560b109d4278017988344582dbbf143ee30fec4df091aae9","9419ebf098df3fda32be85c13c80ab92df9317c3a78e15f4af8d0958e13cc0f4","487eeec393f297149bc598a2fb4aaa34f5c218f5bac80bd00f14f64e79ad5003","b8463201e956d2a578e53da933acbb1d301f11d5cf02d5fa9ece53d2cbf4fd84","b327c623bb50171e09a5c143bbfea50a75b15b928defb0a7e6ae375c1603de5c","aeac5d442f296e463bd139f448b08482917e69707dec6fd22f972944ea3bae8f","bfb4997904392e1564300d6bc182c620741fddc65067da5e752835e709ec516c","2619349c7d36bfecbda789c7b0c159ba9b8fa7d2b21887a8d3808f66f54dcbc8","7a6b42170826aa19400c432bd633f7a67d5703864a68ee8f731beba0754fa03c","75663f9fd2d9e82c5a9ed68a7fe899cc4af613c066cd8d818ddd2dba7f06e605","3930a5dda89910c2991bcfea868489b74025e13fb9365658ea24a3f1c2361819","e515f21c861bf652254ba7872d63fb5844383c5f9cf0b8b9674b5049f953ecfc","0cd36eb92754e23ff8fde12599a4704a4f095b27ae3603ae4cc66b7b2d4e2cb1","d5e1e8657e7e2d1215c4485429ada686c6e1f563de2531349ab99748af8d5441","43d924d5a5b658d6b84c305d59b2bbd546fa00fdaf38103f58e8ed68554a4e79"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p432"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-maxNumberSP-SRS-PosResourcesPerBWP indicates the maximum number of semi-persistent SRS Resources for positioning supported by the target device per BWP. Enumerated values n1, n2, n4, n8, n16, n32, n64 correspond to 1, 2, 4, 8, 16, 32, 64 semi-persistent SRS Resources for positioning, respectively.","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"maxNumberSRS-PosPathLossEstimateAllServingCells","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of pathloss estimates that the UE can simultaneously maintain for all the SRS resource sets for positioning across all cells in addition to the up to four pathloss estimates that the UE maintains per serving cell for the PUSCH/PUCCH/SRS transmissions. The UE shall include this field if the UE supports any of olpc-SRS-PosBasedOnPRS-Serving, olpc-SRS-PosBasedOnSSB-Neigh and olpc-SRS-PosBasedOnPRS-Neigh. Otherwise, the UE does not include this field.","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"maxNumberSRS-PosSpatialRelationsAllServingCells","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"indicates the maximum number of maintained spatial relations for all the SRS resource sets for positioning across all serving cells in addition to the spatial relations maintained spatial relations per serving cell for the PUSCH/PUCCH/SRS transmissions. It is only applied for FR2. The UE can include this field only if the UE supports any of spatialRelation-SRS-PosBasedOnSSB-Serving, spatialRelation-SRS-PosBasedOnCSI-RS-Serving, spatialRelation-SRS-PosBasedOnPRS-Serving, spatialRelation-SRS-PosBasedOnSSB-Neigh or spatialRelation-SRS-PosBasedOnPRS-Neigh. Otherwise, the UE does not include this field.","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"olpc-SRS-Pos","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports open-loop power control for SRS for positioning. The capability signalling comprises the following parameters:","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-olpc-SRS-PosBasedOnPRS-Serving indicates whether the UE supports OLPC for SRS for positioning based on PRS from the serving cell in the same band. The UE can include this field only if the UE supports NR-DL-PRS-ProcessingCapability and srs-PosResources TS38.331 [35] Otherwise, the UE does not include this field.","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-olpc-SRS-PosBasedOnSSB-Neigh indicates whether the UE supports OLPC for SRS for positioning based on SSB from the neighbouring cell in the same band. The UE can include this field only if the UE supports srs-PosResources TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"-olpc-SRS-PosBasedOnPRS-Neigh indicates whether the UE supports OLPC for SRS for positioning based on PRS from the neighbouring cell in the same band. The UE can include this field only if the UE supports olpc-SRS-PosBasedOnPRS-Serving. Otherwise, the UE does not include this field.","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"Note:A PRS from a PRS-only TP is treated as PRS from a non-serving cell.","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"-maxNumberPathLossEstimatePerServing indicates the maximum number of pathloss estimates that the UE can simultaneously maintain for all the SRS resource sets for positioning per serving cell in addition to the up to four pathloss estimates that the UE maintains per serving cell for the PUSCH/PUCCH/SRS transmissions. The UE shall include this field if the UE supports any of olpc-SRS-PosBasedOnPRS-Serving, olpc-SRS-PosBasedOnSSB-Neigh and olpc-SRS-PosBasedOnPRS-Neigh. Otherwise, the UE does not include this field.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"spatialRelationsSRS-Pos","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports spatial relations for SRS for positioning. It is only applicable for FR2. The capability signalling comprises the following parameters:","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnSSB-Serving indicates whether the UE supports spatial relation for SRS for positioning based on SSB from the serving cell in the same band. The UE can include this field only if the UE supports srs-PosResources TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnCSI-RS-Serving indicates whether the UE supports spatial relation for SRS for positioning based on CSI-RS from the serving cell in the same band. The UE can include this field only if the UE supports spatialRelation-SRS-PosBasedOnSSB-Serving. Otherwise, the UE does not include this field.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnPRS-Serving indicates whether the UE supports spatial relation for SRS for positioning based on PRS from the serving cell in the same band. The UE can include this field only if the UE supports any of DL-PRS Resources for DL-AoD, DL-PRS Resources for DL-TDOA or DL-PRS Resources for Multi-RTT, or srs-PosResources TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnSRS indicates whether the UE supports spatial relation for SRS for positioning based on SRS in the same band. The UE can include this field only if the UE supports srs-PosResources TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnSSB-Neigh indicates whether the UE supports spatial relation for SRS for positioning based on SSB from the neighbouring cell in the same band. The UE can include this field only if the UE supports spatialRelation-SRS-PosBasedOnSSB-Serving. Otherwise, the UE does not include this field.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"-spatialRelation-SRS-PosBasedOnPRS-Neigh indicates whether the UE supports spatial relation for SRS for positioning based on PRS from the neighbouring cell in the same band. The UE can include this field only if the UE supports spatialRelation-SRS-PosBasedOnPRS-Serving. Otherwise, the UE does not include this field.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"Note:A PRS from a PRS-only TP is treated as PRS from a non-serving cell.","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"posSRS-RRC-Inactive-InInitialUL-BWP","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports positioning SRS transmission in RRC_INACTIVE state for initial UL BWP. The capability signalling comprises the following parameters:","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"-maxNumOfSRSposResourceSets indicates the maximum number of SRS Resource Sets for positioning supported by the UE.","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["bc62f72f3e19e5f6522f72e1dfaafbc1fd13fc41ce8c0f98ad13e1045d18eb23","8d00ef6dd2719995adbb09df665433f9072f6802a80af4625e2dc3da7fc2817a","5aa0988fe68f37eb0a34b98d096e23d879e41b2dabb4d277441f48c0d4ff6742","d88bd4cb36c1c5d3b12db22132244caffeed56917bd79e6bab87f3d2f9ca39b6","aa51cb7d5d49a542b0086b91ef8dd9714ab64859e3e5f31959188b4d8178f08e","a3b70c89a0712feb5e289fcff6f57d7df4f2c2f49a9a16a45229a7d3e2b6fb72","6aef5b721bf6da82e5d2573e77516026df063266f450bc2c07e0c0f6588945db","6f07e3fece1a3567fd1ccb8624650d25a6dbd65648f3745763c4856066928584","b43351ca8333e9c3fa4004b4b4329aa11d50e77563dfddd6e902d2a94830a608","3c11fab800aca4972bfb055a6a6c9c9e376f416322ab3cc947ad1224abd9e529","e29b7cf93fabe1591850c4f86f7d8882279f87a36cc65908b42bb9bb49019f9b","7be4da3e12c17905f428ccecfe34c8c89d428b0aa48a10efa9a267be6f1a3329","c0cbcfb799f0b737a5fc34bc7bdf0f4070185d9968a58a60c55f7e170ca6a0ef","c4c13f676256d26a807b3384721f26de07a7febd0e588d41d23424722b38f1c8","9d5b3fbdb23d7d813739c5899baa0963529c3a904599eaf1667ab6eacb16bc16","2960d7b0319530651fa92d00b9d38e9106736eea6ea308ab1277f6cf9dbe89e4","b66db28325cc8300db0fa6e9a49e6605cf1bb7a2db54d1237f3f86a984309067","46c040f00ddc2c49605f6bd0d8a21c77f5bfd45481eea23e817f03026e6561a6","8811e3d287c34ddcd039b6bf1257dae9675decfbd4f9c0b910c8e5a9d47ea281","5911471dd0880ec86dfda1b2b586169da34b62165309899d05881c81d3caddc7","e39db4098eb23699abd58c6667ad55dace52c957cf8782793b8a7a48626f3688","5063571de4daf06b7acbf9928f5af9a1d003c0439e62e619aa97df091078a901","f4d274a4a08d851c085534782743a13606c6ac4288a28e476445327705968232","a8927d7fc7d6190cd95e7d88618505380196f0cbe3aa67b3ec9846068b42943f"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p456"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicAndSemiPersistentSRSposResources indicates the maximum number of periodic and semi-persistent SRS Resources for positioning supported by the UE.","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicAndSemiPersistentSRSposResourcesPerSlot indicates the maximum number of periodic and semi-persistent SRS Resources for positioning per slot supported by the UE.","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicSRSposResources indicates the maximum number of periodic SRS Resources for positioning supported by the UE.","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicSRSposResourcesPerSlot indicates the maximum number of periodic SRS Resources for positioning per slot supported by the UE.","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"-dummy1, dummy2 are not used in the specification. If received they shall be ignored by the receiver.","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"posSRS-RRC-Inactive-OutsideInitialUL-BWP","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports positioning SRS transmission in RRC_INACTIVE state outside initial UL BWP. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field. The capability signalling comprises the following parameters:","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"-maxSRSposBandwidthForEachSCS-withinCC-FR1 indicates the maximum SRS bandwidth in MHz supported for each SCS that UE supports within a single CC for FR1.","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"-maxSRSposBandwidthForEachSCS-withinCC-FR2 indicates the maximum SRS bandwidth in MHz supported for each SCS that UE supports within a single CC for FR2.","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"-maxNumOfSRSposResourceSets indicates the maximum number of SRS Resource Sets for positioning supported by the UE.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicSRSposResources indicates the maximum number of periodic SRS Resources for positioning supported by the UE.","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicSRSposResourcesPerSlot indicates the maximum number of periodic SRS Resources for positioning per slot supported by the UE.","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"-differentNumerologyBetweenSRSposAndInitialBWP indicates whether different numerology between the SRS and the initial UL BWP is supported by the UE. If the field is absent, the UE only supports same numerology between the SRS and the initial UL BWP.","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"-srsPosWithoutRestrictionOnBWP indicates whether SRS operation without restriction on the BW is supported by the UE; BW of the SRS may not include BW of the CORESET#0 and SSB. If the field is absent, the UE supports only SRS BW that includes the BW of the CORESET #0 and SSB.","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicAndSemiPersistentSRSposResources indicates the maximum number of periodic and semi-persistent SRS Resources for positioning supported by the UE.","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"-maxNumOfPeriodicAndSemiPersistentSRSposResourcesPerSlot indicates the maximum number of periodic and semi-persistent SRS Resources for positioning per slot supported by the UE.","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"-differentCenterFreqBetweenSRSposAndInitialBWP indicates whether different center frequency between the SRS for positioning and the initial UL BWP is supported by the UE. If the field is absent, the UE only supports same center frequency between the SRS for positioning and initial UL BWP.","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"-maxNumOfSemiPersistentSRSposResources indicates the maximum number of semi-persistent SRS Resources for positioning supported by the UE. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field.","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"-maxNumOfSemiPersistentSRSposResourcesPerSlot indicates the maximum number of semi-persistent SRS Resources for positioning per slot supported by the UE. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field.","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-switchingTimeSRS-TX-OtherTX indicates the switching time between SRS Tx and other Tx in initial UL BWP or Rx in initial DL BWP.","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"olpc-SRS-PosRRC-Inactive","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports open-loop power control for SRS for positioning in RRC_INACTIVE state. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field.","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"spatialRelationsSRS-PosRRC-Inactive","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports spatial relations for SRS for positioning in RRC_INACTIVE state on FR2. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field.","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["7920caede14606b78a920c680375a1a6af1380f3db69e961043226f849baf8ac","58ffc7f6ee3f54bedf41a223f23c4a33e0321383190f974a47ac55da081b00a5","059e420204b8afc78abd08d36fb89a6ef57c78c928ce0db5999d073417f68c67","4103b46af658f89191041e4fbf8f86a5220178c4deac3c8c44abfb22b9d0f370","85d0bf5154fcb2c84b540d00ec2c91bc1603fc3d45f1100e73e9ff716b2e16cf","32f9e37ff17c42e8d8e2e308c05b6866ae51818bb6ae26d2e55b9bfcc4c489e8","2b681a675e77003080a75c0439e24d6bb9e81b1352e74783bbd95acc67d50052","b62a0c5e6340fb67505c5e2c008b5a3dec6d7af8f907adbc20706a34210abb59","83bcca718f9629a0542a50aecf2fdde67164745fc65e97a0a7959de29b47de46","be73b782a6017c056d987afaa4a52e382b7db066aaf3e19c6917f8aa42c5289e","4a706d4df493cb2756ceb1147d4b4492774df38beba2704f2efdcc1eba180466","454c1e828ba2d9233d54132e9c11f762f2c1b465a30706e0cc8f966aac7081b6","ea3cef561deb087f27ed1f2b375ef2999321173663ebdbd20197a3b9b98569f6","d52b38c5f698bba6921cb38d59753f616388005ff581e655adf683c49cd9be08","103b1a030dd3320b9ce19aac68f5fd3e60757da232e7f9f14cafcdefd36c6968","530a35b46753d1088814536b159f03258d9b7872f6236f00a946f13ca1d8f225","8eb1bf9ed433bddc86a87776fedbd13a1ab407edf7f9bd4f134ce1be06b888b2","aca952967c949ca60e0708b191e2d315ed44a0e5b392cabc1095b36f441f2c09","e00ca94c04e9e0d978411deb261af9f8e73ea4e8316952d22c7addbb19f05a29","3d3b49ba1d3b2bdfdea63c68a2fabdf2b979e7f7aedcd6f834139c2adbc1640e","3efaa2c78aa2c31bd45f460626addd515f68eb828b8972f2a99c7df1760dc9df","f83e39aa6b23704a4ab31e7a6f1274300fa204094864b3f2133c759a840218bc","8e1e3f263ba1b2b1a33134ddfb2b84c8e75f01629472ee489347222ad47e4e77","26d2ca69ed5c93963831a25d5337961acc05ad1a03b0fe18ba63e65034ab6a52"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p480"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"posSRS-SP-RRC-Inactive-InInitialUL-BWP","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports positioning SRS transmission in RRC_INACTIVE state for initial UL BWP with semi-persistent SRS. The UE can include this field only if the UE supports posSRS-RRC-Inactive-InInitialUL-BWP. Otherwise, the UE does not include this field. The capability signalling comprises the following parameters:","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"-maxNumOfSemiPersistentSRSposResources indicates the maximum number of semi-persistent SRS Resources for positioning supported by the UE.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"-maxNumOfSemiPersistentSRSposResourcesPerSlot indicates the maximum number of semi-persistent SRS Resources for positioning per slot supported by the UE.","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"6.5.2.2GNSS Assistance Data Elements","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"–GNSS-ReferenceTime","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"The IE GNSS-ReferenceTime is used by the location server to provide the GNSS specific system time with uncertainty and the relationship between GNSS system time and network air-interface timing of the eNodeB/NodeB/BTS transmission in the reference cell.","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"If the IE networkTime is present, the IEs gnss-SystemTime and networkTime provide a valid relationship between GNSS system time and air-interface network time, as seen at the approximate location of the target device, i.e. the propagation delay from the gNB/ng-eNB/eNodeB/NodeB/BTS to the target device is compensated for by the location server. Depending on implementation, the relation between GNSS system time and air-interface network time may have varying accuracy. The uncertainty of this timing relation is provided in the IE referenceTimeUnc. If the propagation delay from the eNodeB/NodeB/BTS to the target device is not accurately known, the location server uses the best available approximation of the propagation delay and take the corresponding delay uncertainty into account in the calculation of the IE referenceTimeUnc.","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"If the IE networkTime is not present, the IE gnssSystemTime is an estimate of current GNSS system time at time of reception of the IE GNSS-ReferenceTime by the target device. The location server should achieve an accuracy of +/- 3 seconds for this estimate including allowing for the transmission delay between the location server and the target device. Note that the target device should further compensate gnss-SystemTime for the time between the reception of GNSS-ReferenceTime and the time when the gnss-SystemTime is used.","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"The location server provides a value for the gnss-TimeID only for GNSSs supported by the target device.","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"The IE GNSS-ReferenceTimeForOneCell can be provided multiple times (up to 16) to provide fine time assistance for several (neighbour) cells.","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"GNSS-ReferenceTime ::= SEQUENCE {","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"gnss-SystemTimeGNSS-SystemTime,","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"referenceTimeUncINTEGER (0..127)OPTIONAL,-- Cond noFTA","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"gnss-ReferenceTimeForCellsSEQUENCE (SIZE (1..16)) OF","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"GNSS-ReferenceTimeForOneCellOPTIONAL,-- Need ON","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["763f5fb0cdac0f312514b84359b6e5ecc4d0c2ad7f2bcbf2768bf315c702145a","b4692de706ad4eaa099d57230ec472802b177ae6a65e48c4f125b7e4fc184b17","08caf4c4df984d0971c5e12b4300c73e74fb4c7cbb36b85e341f2769c6dcbd76","54fc4e3a36eefb749cbeb004c30269a7806a61e79b096e441614e7afddd73067","6eee6620b3c9c633cc4c367ca2655f7dabdcadc73a6a16ad824e3f8a6b17a35b","65d49b0e661914ea4623385444726e92dac0d194b8f345cd065641826c827aa6","aa77c4cd8a1b5a3c65baa2773680144786dd3ecf657550849780fb75e3a68844","658b9cf93dfb852e0e75781d7bca13dfa76306e03d1e397ba532538b4fc1065f","7d913688b9c07e963797d98dbd70a7a5d59ec4abb6a199d1711bbe6c13958405","58006fae70617615f019fac20a71262d52c7b9c5152548115c6e7f056343aa5e","d41e16620dabc1958206299906fb7c72d373080e445e2556c202f96e39aef3fd","30ad95e4beb253d74c8cc274c220f68d71cdca51e291895eff6799612d7c2509","4d780073d23e4b4ca22e283128808c732ba4d123582b1044562e985707ca7ba4","5d18d8c9edb87c0b5fdfa3b3b16b644872f88b8547488515f39bb0fccf350dc6","28f450f59839a878106abc9297649da66c2173ea25176614d6fd2e4759344de7","fb98f421cc59b1c2e696935264600f4738d02bacc493d2e2f3dd7bbd57fe9190","9f6ae6ac8adde30662c2225540eae417afa0f86d5e15c0ed83831d996600b6d9","64276193abec6a10fd5f6d5a22522f38f06fdf17e57661b94b14af18f38ac176","a7568d994cdb33e77129776f42a6691573f986bdb60f58bc73e2f345cde88cc3","e7ac3a5ed763d586f289baf20090e6101f0ea620b8efb9cd1365442c04983506","bd5967cf1fda6a05b6dc47ffe5d041fd3f6af4c75f109d51130a7a5c03f15faa","c705171bc3f408b43f4932a56fc26010049edb37360d5c61a0f3e218c9746163","e4ea82d1a380867a2bf023df09d025aae74969797412d8cfd090450a783f6e7e","269c4514d3fadf0f5d039ab13d1416ab9e7217a4bb2f2913a8f29b54acab0b11"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p504"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"GNSS-ReferenceTimeForOneCell ::= SEQUENCE {","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"networkTimeNetworkTime,","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"referenceTimeUncINTEGER (0..127),","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"bsAlignENUMERATED {true}OPTIONAL,","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"noFTA","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"The field may be present if gnss-ReferenceTimeForCells is absent; otherwise it is not present.","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"GNSS-ReferenceTime field descriptions","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"gnss-SystemTime","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"This field provides the specific GNSS system time.","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"networkTime","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"This field specifies the cellular network time at the epoch corresponding to gnss-SystemTime.","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"referenceTimeUnc","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"This field provides the accuracy of the relation between gnssSystemTime and networkTime time if IE networkTime is provided. When IE networkTime is not provided, this field can be included to provide the accuracy of the provided gnssSystemTime.","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"If GNSS TOD is the given GNSS time, then the true GNSS time, corresponding to the provided network time as observed at the target device location, lies in the interval [GNSS TOD - referenceTimeUnc, GNSS TOD + referenceTimeUnc].","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"The uncertainty r, expressed in microseconds, is mapped to a number K, with the following formula:","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["c54ec159db324c9ed8370b0df7e0651f69a7038e5622e1fe5fdf163b0d659312","7e6ffd9ba7403ce953db869503e72f896b6c730071b0f28017133f686325ff09","75400dda3617859dcf40b93cdf5e7c50595fea16bee39dcf1b76d910e68546e2","b73ade96e088d92048edffd27347c717adc06a6966fbc80bdb3a406c180d6ffd","1d48f7818ee41c4da22ff2e4675de1da14a97bd3b560a299c5f96ce84c3d519f","4cb0f7c8ce0f8e1294d8898998b340da369d28a2df888ee1262a336ae3462037","e6d1ed534813fac583662f1bc54ea8a306718d1ea0ff61f44b8527542c5452d2","43bace1000e8508cd9da1d6f52fdbaeaa9a8a6762b6079948b0748d2513872ef","475c98cfdb4c517d16d64a0a07985f07c2fc4eedf87ba758a0b25d9f094b0c97","49c8173fe89fe50262984d13e2f6a97ba6a6bb5dcc09861e29bfcc0fb762fe7e","b2af9f9f7f5d5772904428ca1cf7355c5eec1e0e26a3fa2cf82b7398c2bbd7bc","401c9f7d52cdace0ea3a07307c68415237875ecb8fda395c85c70d98b043c8ed","dcfcdb72f6534ae0ce613eea0c7812e860f8640034ab2575734df0b104525707","6c75cf190bb488991c910989d3ac7089ad561e4a3a727ef509679612a0357a33","2c6bb3c23d09cafe45933d45d1e0d8d73b67b5dd279b71009cd1ac8c8f2e1ba7","806e790d371484b16775272017af97784c703fd6539e22ede36588d21812086b","3c1c3c4cc9fc4ea6cf07af11fa0c4d2692995d824e885841a60432448fec967f","f9fa5543acdfb05fe6d6339fda95ee804b7c94421ede6174b36d8dc1c2292a95","7427cc3cb640d4a773841cd7fc5b50b4adebcf07382edde5501204c6c9a534ec","81ab8694a7971eb375696813826b417630d22dbdd069a0632ecb4a6483189df4","7df5071b295a40339acc2d48bf319b2783ef0bcef4d61a30326ca25c3b77f7e2","56b5bac0543e8d9f43268f7f116ca7240358361183f8b59e0bd26b9f7e45d3bc","deeb505ddf3af4e61fab4fd8ea1cc6fbb1a02e48da975fe12e10e29950943f4e","e54f99b2d82b71630abf72ae62a313d466fd37c069ecc70fe988d23e7144f759"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p528"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"r = C*(((1+x)K)-1)","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"with C = 0.5 and x = 0.14. To encode any higher value of uncertainty than that corresponding in the above formula to K=127, the same value, K=127, shall also be used. The uncertainty is then coded on 7 bits, as the binary encoding of K. Example values for the referenceTimeUnc Format: see table K to uncertainty relation below. ","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"bsAlign","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"This flag, if present, indicates that the transmission timings of all cells sharing, depending on the RAT, the same carrier frequency and Tracking Area/Location Area/Routing Area as the cell indicated, are frame aligned. This information allows the target device to derive the GNSS - cellular time relation for any of these cells based on the timing relation information provided in GNSS-ReferenceTime. The flag should be set consistently in all these cells. This flag does not guarantee SFN alignment.","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"K to uncertainty relation","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"Value of K","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"Value of uncertainty","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"0","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"0 nanoseconds","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"70 nanoseconds","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"149.8 nanoseconds","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"50","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"349.62 microseconds","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"127","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"≥ 8.43 seconds","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["07ff1b3f7df021969586dbc4489de7cb8f6003cfb4a8f8fc37e27ab968379577","9d9422600bb15350882cb7e12d2d2665ecbe07a94dbb10f189713f9c47e7a05a","e84b3236dd3e9fc261c3bdbdc478f11513674937471ca8de60dd44c9020a7a8f","88174a133b067fb37c856da33988905da2a866978da95eba4efe5785b7839a96","9e927d038c28c10f6bb1f71bfe8cad5276610435c96ef4daa1cf7433c931a231","a45418c09ee11f70a64dd15f968c23043f591f69959f29ec18ce557c13006eb9","24af0d55e1d020b13e3c4ab41397e44bc95a52d795101d6831031b0208e85c12","3cfa4abc1dc4fdb5fb0777cb4b605e937afd0a87a347898ed8dcc97da0ac333c","5f75782daf5511a2219484dae85c2f9ba4c0843ce0825781167ad98b08fa2fd6","f00e805d6e49ab203b68e9f11317cee7d749e962c0c021fa0d3eb5c74ca15365","ae86edfacec5a13e251b61edbf6f73f1676b20d3e9bf2f63334e0885b0f2aee2","70d40ca0367a49304f3a8354b6a51c8d30853b32df3f078d01708b4a3b5214ab","92e2433c5529314de145ec576dad92e35bd864c19d855d7bc82e3050f02c1dd7","5eeef4a6cb8e6ac1494b64dbb92d4ee23c004eda514aab715078fc92330bf7c8","f10fd1217b3169f4c09e5cfb