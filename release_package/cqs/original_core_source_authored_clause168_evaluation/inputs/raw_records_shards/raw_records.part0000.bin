34b4c3369f969adf7cd4a971595e76ce3b84904e80ba","original_member_sha256":"6f1fcd84e60deecbfe43a31a29c6ba9f64fe43515295e947e3677a081d3af633","paragraph_ElementTree_utf8_XML_sha256":["1abf07a526d6f61e8a8d9b9f078f0d7fe2c0e218d89169c0fa6233a68f98f412","91e52e6eb680a98232b3d98ce4975ade610609d99fe97b9ad873f76818be184e","f6a3dc2f82c506e670822e36199366d4c7016804dd8f18d600d59d29400226ac","87e261a4fe9a4e44e784863f99e5efc829c19a16243ea77350864c873c0df226","393706177df2100ce59c6ecf8fc246670fae06a549ebbad13181f9861f04296b","8470ea2573fd0db966a0b45506954f5ca66caf78aa090f1b11943115d7096eff","d5e8c04059b97daf3bab049f14a47bfe7b8c285c7be1f252ad3c9f828ef25524","80e8da23152d52f2ec37f545a945b94d5803b86f4f2a9ab39d45a220f13e93d2","bde739416edb4e69849e437258bb008bbf1c206d790db657d4a50ff9eb3adfce","9a705d30399fb1f59a390e556457a23bf3393ae6a1ef9ba721a7f39567243a4b","3b617c1028e503d0b35e17a01699e9ec039599e383f39f7b819c60cbc82c2881","5a8fb6c2879184924b79543ce0ea22c012a199de75fd5c32c36e819d668a8d6d","458f03f3d63c4322ffd93a8d5d1a60d7133256e615ff02f0e43b4dbd3753d000","83bff799c0019ed1bb5e51cdb10fe12ef32d7ea3612085f6ce3dadde282fcfec","4bc4e29e2ba24cc277d9c6bafad3d96a4ae9c53af2c41b2f2b80123d0ab7c6d1","d6530ba082f95e0b42c25557978a77639eaad59e0a14e8ef741e4f28a4274b38","b8154354bd2da741aeaea2173c13b50ec7e9b50175f01c840fd8de4eeb220f12","c7c4395d5b53a49afac1e764a7f54dc8f2ca096eb8ef4a46090b5d326d6e7682","7c18da1c4b70c868c423a67e457b59d150520416b7a41ab12952058f6b809122","00f750505978d9021a7c70e12991099e30d4fe66f47970020ef5f75bf2157430","d2e1827a8fc4c75095d5d4e6891db81d015efda1e4f7b382b7c297f116907548","b831d2d3e124a96571e2507a6569aff3cdae755fbf3c8e345b7bd874bad25637","13c933124b635d0c4f93b7bf419f32f20cc7350b74eb62b89564be529169fcf1","ab11f334dca9d78b4089d55503aeebdb983fa410d5ce82446c02f2eefdbc17dc"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx:p24"}
{"fields":{"filename":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-16","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-15(Release 15)Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"     Rel-19(Release 19)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"In current specification, it is stated that if an acknowledgement corresponding to the PSSCH transmission is not obtained from the physical layer, UE delivers a negative acknowledgement to the corresponding Sidelink HARQ entity for the Sidelink process. However, this does not apply to NACK-only case and should be clarified.  ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"In section 5.22.1.3.2, clarify that if NACK-only is enabled and no acknowledgement is obtained from the physical layer, UE delivers a positive acknowledgement to the SL HARQ entity for the SL process, otherwise, UE delivers a negative acknowledgement to the SL HARQ entity for the SL process. ","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: ","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"  NR SA, NR-DC, NE-DC, (NG)EN-DC","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impacted functionality","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c435577f6d7cf2e4fe4434b4c3369f969adf7cd4a971595e76ce3b84904e80ba","original_member_sha256":"6f1fcd84e60deecbfe43a31a29c6ba9f64fe43515295e947e3677a081d3af633","paragraph_ElementTree_utf8_XML_sha256":["6c14188b935b71c193d6e88beab856351147c70ff8d4348a6e87fcd8c73e7fb9","b0a809ef3d489b75d5885f0fd106c2212f09a2f99dc066d4f6f3a4e7a42a5f14","b492eae2f5f89dd7af65044b9c03a7dda795334fd0cebbbbf8e4456e6938838f","b10cc07f5fd694b129fbbc5076893a354db3ef9208ec057f546d2901bf4c71e8","6800356d20b56d6e56cd4bc8f075b32b66392d20291e93fb5b543d9ff25e3528","91099cadd31d99f1e8b2a34db26f3ebf5ba0c830ad26005cbd7dc9d0dc20ec01","224417853c2536e2e9a02f1beb0ac2155a24bb8e4b9bcb45112811525a765a67","639705040e6190bacfc3a72dc66b5ec316f4e7c57b6dae323c7f42ff6d2263bd","2778d2f78f1b80d9f28ff0a902f4dd45de598fce5e9b0ff8efbf7354afca2937","49193f0680870b23ee68f45f6ebde151d353198122730dc52f031120fcb76ddb","20ece7df4fcc561e6207ff53152a190af027fc33b1abcb0ccb58d347a8e43ee4","b9bc6977f1abedcd15b18b762ea84d40304107eba31a1727be490b4c2b061c04","10dddf03bf6a9eb1ac12a281a941a328b81d01279928a7469aa9d025e7c671c2","d91f7f26bf6342647586c7ce2c38f0895d71be2eef20adddd59f3d5267fa0ecb","13111a18352827f53b245e9b0771cd68372b079825709e66624027dc9a7808f2","0c050a72c03e8c896afb0566ebf23a69a75f9ea82c9a8cf6ec4991968bcffb9e","4d77ec1a9866eb8f55adce89a3212e7e79d1b8b2ac27b65d68da4b06e9a25c09","2af6227200b7c74405234d0735a87058bdf487ebc370c4f6a040c516ecdc1620","9da6e4039ce050cf794c2ffcdafa18153aef8663920fda9e512f6f31921f9243","1b43373d331ddd6a04598df2c94b98a75ecfd707e35d55b7e75e2e18dc415a8a","5dc4a25513b8c3ee36dedd9bea5275be8af58ce45b84950f7541bbb9a66668c7","a84774b8a435d796a1c015a54b54d29f48cc7ba89e1cc4d77caba0a073508074","b38eecfe58bcee2cce7bc898016c814166283b7daf930f09fa514b48d60315f5","55f79e90c6e923a31e3020d0736291f1466a02d9b8f41ae6556535a0789ee374"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx:p48"}
{"fields":{"filename":"R2-2303211.zip::R2-2303211 Correction on PSFCH reception for NR sidelink.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PSFCH reception ","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to this CR while the UE is not, there is no inter-operability issue.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR while the network is not, there is no inter-operability issue.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"If one UE is implemented according to this CR while the other UE is not, there is no inter-operability issue.","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"UE will deliver negative acknowledgement to the SL HARQ entity for the SL process when no acknowledgement is obtained from the physical layer even for NACK-only case, which is not correct.","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"5.22.1.3.2","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c435577f6d7cf2e4fe4434b4c3369f969adf7cd4a971595e76ce3b84904e80ba","original_member_sha256":"6f1fcd84e60deecbfe43a31a29c6ba9f64fe43515295e947e3677a081d3af633","paragraph_ElementTree_utf8_XML_sha256":["9a1cea05c2a1a4f7b747e31a07d6c37881d4052bf5aae613b2358632fcba0456","b3d38423ac1805fda06fc7c763c19b618ae95ae7a51220084c79b804214f21ed","9ebf4ee56af17e928f1b207ef425b7dbb68f5f0a03612365079ea48190f4f0d0","581c4767dfde769da605024689440f2a770add5f49dafa9c8793c2b03540f754","f2455c52a598494a7f16e06cd71181918140057204780e7267f3a9ed02969f7b","0a35f0e6c4e8087f794f794c2ca85686bb4b17b4ca72c5bd50446f20c126d767","f84c8a5681a6b6445abd41b4ab7d9074d75d260201c549ae3fc8aa065a59ee43","77002e255bd498b62f26bb52f0e46a086972b1d22190edbe86575055e407ff4a","3220a08d3f7b8dbfcc74cdc079f3177c438e3a0dae9d9cde6229c9edec1522d7","7fb6acc293459d3f7bfbf1386f33b7a3d17d3d73da2b61ebf7bc670f88919ec2","5bddd5039a10346bcbccb2616a1c7e3880107ecffb27271f383c9385e917fe65","2dee114c0f0bd9ef0ba301f381c7d93047a8f6c5a3de6e73f4a64b1e578a81a7","5c622d73be6cf73e38538533f331a2d24ba92778743232e7f858a29104374917","397a1c52f37550186c52f17c76f8ace403b8942cd5f0a74dd23436f9243c1e97","5b732b23a7e4a66e6298e8fe6e97ce03f04c6d438d5ffbf7a04614d0a8e9f2ce","358e0906dde987ae3d9f58cf0182e4a4688c5489b7284328fd23242b2b4f341d","5eba849f58c6b50baa5c001db53fe471e61f552412ec5c104534e93d53a2dac4","ebd8b1a7df30d471311b2f0736c9a0506b3259968f6dcea3911e464ef44aa73e","9bcb7d761bd511fdddcccc3372e7984d5ea86c54f54184515afa7bf00709d4c0","e521728909feef103bfcd106046e3e8182fbd76fa2c35d5a