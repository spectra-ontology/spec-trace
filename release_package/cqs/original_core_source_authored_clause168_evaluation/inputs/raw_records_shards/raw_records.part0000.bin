eee818e26a7827303b4c55dfce570ee58c3c058ab4","487688f0519ba4ea2afee30dc7398e223c8f1a697422be785ac4d53a429189aa","7b2c85325f7f005729e97b54b1597f7177146dab80687c5c8652d119c4ca9f74","8944b2f1ab66a69a039a77d9d3e284f84d82741c9e83e0561f9d8577ea2f5db3","b996770538362f5fd459c24010b20b14acfd845121425bccebedf44e14abe027","2a4f1b93764f061882de25a7d789923061a7edf4ae634ec85b3dbd7a67d5b2c7","0bc2e8d0b48738fe84a8bd6f3e082138b8312538ca61f817e2923cdc181ec29b","563297bef91f664be62dbc484fa8fda223248ff34142db463c51a486941f65fe","acab5c95314c1f06745f993b2e0a431f593175c8e220d44a3ed396e3a559ed5d","ee94b6e239698d1f4059ab134738c94e12dd631fdf14d662cb3f63caf57a2802","fabf5fe2f9529dd3d2d71a02dc47d1a16f197965ade265b5707da2fd84d23288"],"paragraph_range_zero_based":[39840,39863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39840"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms. ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39864},{"literal_text_all_w_t_and_m_t":"drx-LongCycleStartOffsetPTM","paragraph_zero_based":39865},{"literal_text_all_w_t_and_m_t":"drx-LongCycle-PTM in ms and drx-StartOffset-PTM in multiples of 1 ms.","paragraph_zero_based":39866},{"literal_text_all_w_t_and_m_t":"drx-onDurationTimerPTM","paragraph_zero_based":39867},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":39868},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimer-DL-PTM","paragraph_zero_based":39869},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the CFR where the transport block was received. value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":39870},{"literal_text_all_w_t_and_m_t":"drx-SlotOffsetPTM","paragraph_zero_based":39871},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":39872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39873},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39874},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39875},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":39876},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if HARQ feedback is enabled for a G-RNTI/G-CS-RNTI associated with this DRX configuration. It is absent otherwise. ","paragra