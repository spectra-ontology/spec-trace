{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2592},{"literal_text_all_w_t_and_m_t":"–NR-SelectedDL-PRS-IndexList","paragraph_zero_based":2593},{"literal_text_all_w_t_and_m_t":"The IE NR-SelectedDL-PRS-IndexList is used by the location server to provide the selected DL-PRS Resource of nr-DL-PRS-AssistanceDataList to the target device.","paragraph_zero_based":2594},{"literal_text_all_w_t_and_m_t":"In the case of assistance data for multiple NR positioning methods are provided, the IE NR-DL-PRS-AssistanceData shall be present in only one of NR-Multi-RTT-ProvideAssistanceData, NR-DL-AoD-ProvideAssistanceData, or NR-DL-TDOA-ProvideAssistanceData.","paragraph_zero_based":2595},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2597},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-IndexList-r16 ::=SEQUENCE (SIZE (1..nrMaxFreqLayers-r16)) OF","paragraph_zero_based":2598},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-PerFreq-r16","paragraph_zero_based":2599},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2600},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-PerFreq-r16 ::= SEQUENCE {","paragraph_zero_based":2601},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-FrequencyLayerIndex-r16INTEGER (0..nrMaxFreqLayers-1-r16),","paragraph_zero_based":2602},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexListPerFreq-r16 SEQUENCE (SIZE (1..nrMaxTRPsPerFreq-r16)) OF","paragraph_zero_based":2603},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-IndexPerTRP-r16","paragraph_zero_based":2604},{"literal_text_all_w_t_and_m_t":"OPTIONAL,--Need OP","paragraph_zero_based":2605},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2606},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2607},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2608},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-IndexPerTRP-r16 ::= SEQUENCE {","paragraph_zero_based":2609},{"literal_text_all_w_t_and_m_t":"nr-SelectedTRP-Index-r16INTEGER (0..nrMaxTRPsPerFreq-1-r16),","paragraph_zero_based":2610},{"literal_text_all_w_t_and_m_t":"dl-SelectedPRS-ResourceSetIndexList-r16SEQUENCE (SIZE (1..nrMaxSetsPerTrpPerFreqLayer-r16))","paragraph_zero_based":2611},{"literal_text_all_w_t_and_m_t":"OFDL-SelectedPRS-ResourceSetIndex-r16","paragraph_zero_based":2612},{"literal_text_all_w_t_and_m_t":"OPTIONAL,--Need OP","paragraph_zero_based":2613},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2614},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["64ee7e0efcd7c1c508418856b36f55298033770c9a7ba7aa70f2e7c8c9efe7ac","ee941608bc416793f5748cbfafbe8accc27d81f862904b8e60d3dc9baad7c861","920d04ee4317b2b7a01668d26b1337a8a136d88c680b4a9f0fdd2b1857e03312","a6664c459893c658ba4ced665a6d8cf41ef7ac4e727e78625d5097b1b7452d0c","2e5ddf33f57d4545a1c402154aed862b6032de6ccec10bb1d3ad5e513fe56012","27d052cb32b268fc252c84f898061434d6053946944c1bd52d0e0becd66e6795","9661dcefac66c33902f680ec7fc5342d0e04e7c2a0c3fb4fa2c5bdfa1a4f66ab","d05db2d786836efad2d08fdcbe21c7d6b8aa77b7550538979183745c4c55ce8f","41df9008968502c9092d162d88019e3063af7654788ddaaaf014b8d3c1b3a56b","8c3ea3d11b3572feb65a32dd4140897674be7290b4fb4338fbb3262b8d80f39b","eb5ae185f4833a275c778e48afd3351ff55d754d23cdb8df54547079a757d588","6018f10e8e769f46af0d552446b142cf593a1440defac9da17aaa5721a184645","e34e036378673dd117703a1cae63e816263f48e6e0e386ead67fa