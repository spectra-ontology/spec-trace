"        sl-MaxDataBurstVolume-r16     INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":38749},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38750},{"literal_text_all_w_t_and_m_t":"   }","paragraph_zero_based":38751},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38753},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-STOP","paragraph_zero_based":38754},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38756},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile field descriptions","paragraph_zero_based":38757},{"literal_text_all_w_t_and_m_t":"sl-GFBR","paragraph_zero_based":38758},{"literal_text_all_w_t_and_m_t":"Indicate the guaranteed bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0824fa323bc75b59a8b0aab439c52ddb68bf7e446afe0684d2c6426aca822759","d1c80b4eef0157bbdb3948bc277c835d8631961fdbcad892cd80f11927bd26ae","e572e3eb76a0001d63a348d9d323ffed79d019f2afebd1f2d7b5827d6922a363","b021d5b5a5b7b6438064286b17cc856340e3032d42f46d016de61ebec6dacc96","e08b445a580e1162c06145c22193eaee3497fdf33c29fbdff323beb401f7f648","f43e890d7dd1f40605ab4aed495f1a58b14acf33b0ab52083fe266c6c440740b","c28bc0f27e0ad7206b94c491bed74c65da9524cf053731f557532c05d2d6ea06","da84168c9a3610f68d21b09c3a3570aafa7def74d401579e74bb67855b94d1b3","a4e9d84e642b7387393bf84903cb6498d3371615c936064b6424fb8b4084a18e","4f531ba588b756c0a812b832ab5a2c19713951701216d098b29ece2678da82e1","10c4c67c6b4b9738bad9b94b7c3ef8f2019392ce6878fe92f7890ac13fcdc638","d77b3485af80f3a95b50e17deec9d5da6dbee603a066ba0bb04c43b45341b55f","769c854e6522aa54132d6573bc3dd2774763fa9c789d2ba2e60e7384294bb58f","7da229abe11c0082ac06e281eb3486bfcd2e47daa5f07a3cb6c3ccfe339315ab","d5a1b08c20cecbf52cfee23dad395cbd4c78e173959ee9efeb8fccecbe79756e","5f4feb882a31f2de21d39faee593552c4dd434fd065992f8e116a06e4aed440a","b2d6a5a667106861e0d411fb3a8ca5b1ec45aaf8c05d1e41a5f2eb056c762ae1","d92e38cca9e5146530563536e42ab972b4e21945fbf19f1344ce47d0470677fa","66490ad5a57ea451b0088e00875c8691f5135540e2f397d00867c7a806713ebe","bdeff86d39c22c3e2714292ec1583894c5475fbd1e8f6531a9d04758fc58552c","8860976c519ba88a6095fdd2e52327422fbd44e32139f79daa0100f767a253f7","367c8009abba85cfde8bd8955fa0d1bdd55cf025d697b7d315a731e7dfd5d4fb","7f6f8e56d5283bdb10b216e1cc98548b4b9c4e21b9c4cdaae59a1c90a0fa4593","a289d15b9284469821e2d584e2dc288badb9f27034073ce9c61e1aedc9d097c0"],"paragraph_range_zero_based":[38736,38759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38736"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-MFBR","paragraph_zero_based":38760},{"literal_text_all_w_t_and_m_t":"Indicate the maximum bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":38761},{"literal_text_all_w_t_and_m_t":"sl-PQI","paragraph_zero_based":38762},{"literal_text_all_w_t_and_m_t":"This field indicates either the PQI for standardized PQI or non-standardized QoS parameters.","paragraph_zero_based":38763},{"literal_text_all_w_t_and_m_t":"sl-Range","paragraph_zero_based":38764},{"literal_text_all_w_t_and_m_t":"This field indicates the range parameter of the Qos flow, as defined in clause 5.4.1.1.1, TS 23.287 [55]. It is present only for groupcast. The unit is meter.","paragraph_zero_based":38765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38766},{"literal_text_all_w_t_and_m_t":"SL-PQI field descriptions","paragraph_zero_based":38767},{"literal_text_all_w_t_and_m_t":"sl-AveragingWindow","paragraph_zero_based":38768},{"literal_text_all_w_t_and_m_t":"Indicates the Averaging Window for a QoS flow, and applies to GBR QoS flows only. Unit: ms. The default value of the IE is 2000ms.","paragraph_zero_based":38769},{"literal_text_all_w_t_and_m_t":"sl-MaxDataBurstVolume","paragraph_zero_based":38770},{"literal_text_all_w_t_and_m_t":"Indicates the Maximum Data Burst Volume for a QoS flow, and applies to delay critical GBR QoS flows only. Unit: byte.","paragraph_zero_based":38771},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":38772},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a QoS flow. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":38773},{"literal_text_all_w_t_and_m_t":"sl-PacketErrorRate","paragraph_zero_based":38774},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Error Rate for a QoS flow. The packet error rate is expressed as Scalar x 10-k where k is the Exponent.","paragraph_zero_based":38775},{"literal_text_all_w_t_and_m_t":"sl-PriorityLevel","paragraph_zero_based":38776},{"literal_text_all_w_t_and_m_t":"Indicates the Priority Level for a QoS flow. Values ordered in decreasing order of priority, i.e. with 1 as the highest priority and 8 as the lowest priority.","paragraph_zero_based":38777},{"literal_text_all_w_t_and_m_t":"sl-StandardizedPQI","paragraph_zero_based":38778},{"literal_text_all_w_t_and_m_t":"Indicate the PQI for standardized PQI.","paragraph_zero_based":38779},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38780},{"literal_text_all_w_t_and_m_t":"–SL-QuantityConfig","paragraph_zero_based":38781},{"literal_text_all_w_t_and_m_t":"The IE SL-QuantityConfig specifies the layer 3 filtering coefficients for NR SL RSRP measurement for a destination.","paragraph_zero_based":38782},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig information element","paragraph_zero_based":38783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a2ba95985d6db8216ba9347563ecba2c4aee20a7a783c0d5be113d7c32b7e532","a7e1b98d0ef46dfa7eb0474d3ac6f08ddfdba99d06cf3f515811b8a4ce11ee3b","2201200c337f5996f56928705b2bcb7a211b471a0a6d173f7ebe7b2972e84824","8ae120c516173ca9500287bbe59adc4137324d469429d1c98b23059468b3f2e7","a0de5c970618b1946a84117b44ed2e360d042483905fe14a6105b117243b2d88","91c5a53822caae05ab2b26790738eab70279e38c769442a9dc5d79469383febf","f848b91180fa71011345e6111efc0f06fbc78132396c1b3caa8836f39bcffb8f","74f0046369e845038c9e7147ba1120159f5977b4f4a1fb9d961265776308d6c3","264c530261770b7b59bf8e