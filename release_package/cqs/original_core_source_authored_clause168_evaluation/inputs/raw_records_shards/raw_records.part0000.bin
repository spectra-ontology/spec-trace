{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-InactivityTimer","paragraph_zero_based":37992},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms, ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. This field is only valid for groupcast communication.","paragraph_zero_based":37993},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-RetransmissionTimer","paragraph_zero_based":37994},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the sidelink BWP where the transport block was received. Value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":37995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37996},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigUC","paragraph_zero_based":37997},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigUC is used to configure sidelink DRX related parameters for unicast communication.","paragraph_zero_based":37998},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC information element","paragraph_zero_based":37999},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38000},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGUC-START","paragraph_zero_based":38001},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38002},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC-r17 ::=                 SEQUENCE {","paragraph_zero_based":38003},{"literal_text_all_w_t_and_m_t":"    sl-drx-onDurationTimer-r17              CHOICE {","paragraph_zero_based":38004},{"literal_text_all_w_t_and_m_t":"                                                subMilliSeconds INTEGER (1..31),","paragraph_zero_based":38005},{"literal_text_all_w_t_and_m_t":"                                                milliSeconds    ENUMERATED {","paragraph_zero_based":38006},{"literal_text_all_w_t_and_m_t":"                                                    ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":38007},{"literal_text_all_w_t_and_m_t":"                                                    ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":38008},{"literal_text_all_w_t_and_m_t":"                                                    ms1600, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":38009},{"literal_text_all_w_t_and_m_t":"                                            },","paragraph_zero_based":38010},{"literal_text_all_w_t_and_m_t":"    sl-drx-InactivityTimer-r17              ENUMERATED {","paragraph_zero_based":38011},{"literal_text_all_w_t_and_m_t":"                                                ms0, ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60, ms80,","paragraph_zero_based":38012},{"literal_text_all_w_t_and_m_t":"                                                ms100, ms200, ms300, ms500, ms750, ms1280, ms1920, ms2560, spare9, spare8,","paragraph_zero_based":38013},{"literal_text_all_w_t_and_m_t":"                                                spare7, spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":38014},{"literal_text_all_w_t_and_m_t":"    sl-drx-HARQ-RTT-Timer1-r17              ENUMERATED {sl0, sl1, sl2, sl4, spare4, spare3, spare2, spare1}     OPTIONAL,   -- Need M","paragraph_zero_based":38015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3628625cd81983b2415a0585af15490d8c1b441eb0b504e9688083ec60aaf9de","95f3666c88226a1c71cb