{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14496},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-START","paragraph_zero_based":14497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14498},{"literal_text_all_w_t_and_m_t":"Alpha ::=                       ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}","paragraph_zero_based":14499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14500},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-STOP","paragraph_zero_based":14501},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14502},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14503},{"literal_text_all_w_t_and_m_t":"–Altitude","paragraph_zero_based":14504},{"literal_text_all_w_t_and_m_t":"The IE Altitude is used to indicate altitude relative to sea level. The actual value is the field value in meters.","paragraph_zero_based":14505},{"literal_text_all_w_t_and_m_t":"Altitude information element","paragraph_zero_based":14506},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14507},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-START","paragraph_zero_based":14508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14509},{"literal_text_all_w_t_and_m_t":"Altitude-r18 ::=              INTEGER (minAltitude-r18..maxAltitude-r18)","paragraph_zero_based":14510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14511},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-STOP","paragraph_zero_based":14512},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14514},{"literal_text_all_w_t_and_m_t":"–AMF-Identifier","paragraph_zero_based":14515},{"literal_text_all_w_t_and_m_t":"The IE AMF-Identifier (AMFI) comprises of an AMF Region ID, an AMF Set ID and an AMF Pointer as specified in TS 23.003 [21], clause 2.10.1.","paragraph_zero_based":14516},{"literal_text_all_w_t_and_m_t":"AMF-Identifier information element","paragraph_zero_based":14517},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14518},{"literal_text_all_w_t_and_m_t":"-- TAG-AMF-IDENTIFIER-START","paragraph_zero_based":14519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["963b494a39e920d0585779f3a3d63b82aa2f1dcd83063a05e65b67007d713b97","11c605d0680afe4ea1af675ea056cfbd53c8d0f92464a94444230f37928c92ba","c4d4dc49a3053e6af622a4c9595e071664c224acd44893200fdc4a5dc10f0c15","38c402470f4d38c01ed32cc59665b6fa442e224f5f9525884fba0a42ebc1e2e1","8cdb4d0bf0b16ee6712ab3dd8e1c0613c2b15f68a8d3dffc135fc482cf60785e","0a1ee59b773c9edb378ce8be092575d332e24604f53db95dc86132d67fed1f12","afd2a474ca66442c9082a2be37a372253d4a83a4ed63219fa1623a074dc69ca0","a405075151800c5e00bceb2070c11bdf6c8cfdecaa8e98e7ec2d478b439d7d12","24b513d30fd52510d0fc6c9a02a7dce6cd8a19a6fcffca53fc3a8ee8f9f48ab4","62bc34cae05a6e3cdde56e58e04a54f9e4799c44a1cb700afb7458a38701d19a","fdc096010a2d6ceeaa569d169a83777291d7b53cbc1ef864c881748a7933c534","8ec5e8c13366ba5e1965638246cde2ba4d2564caf0229dc8bab22fa9a75a5202","d2ed21792af76b13fea42a219b377fd4eb6aea006162e1c439ef74afe6d73a17","a1620865000dfb238e8589416a2fa626417b69fd38eb94fe47883601d160bdb3","5cb4878d11225baeccd5ee1a43340fcc6cc106fb50401334a2cb26bd3075c127","69a966374c8405fc2f4aa3a474f63bac6200116034c4aff78af6675121822eef","24dea4954f0ed2d5bb1bb30901f8e68265de48f698712a0618bc2bf7a76781f3","f2051fc36abfb1744abca7162c1612ede62f9ba1fbb3657ae03e4f9708adf061","6cc5b9c143cfde29ae