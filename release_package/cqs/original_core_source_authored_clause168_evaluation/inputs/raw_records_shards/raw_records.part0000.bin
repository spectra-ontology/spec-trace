IONAL,   -- Need M","paragraph_zero_based":38559},{"literal_text_all_w_t_and_m_t":"sl-PBPS-OccasionReservePeriodList-r17     SEQUENCE (SIZE (1..16)) OF INTEGER (1..16)                          OPTIONAL,   -- Need M","paragraph_zero_based":38560},{"literal_text_all_w_t_and_m_t":"sl-Additional-PBPS-Occasion-r17           ENUMERATED { monitored }                                            OPTIONAL,   -- Need M","paragraph_zero_based":38561},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowPeriodic-r17                 INTEGER (5..30)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":38562},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsAperiodic-r17      INTEGER (1..32)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":38563},{"literal_text_all_w_t_and_m_t":"sl-MinNumRssiMeasurementSlots-r17         INTEGER (1..800)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38564},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-RandomSelection-r17         INTEGER (0..100)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38565},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing-r17          INTEGER (0..100)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38566},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic-r17                INTEGER (0..30)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":38567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6c5f523707681487b83f57f09bf65f11db85f9ed7c053ccf6385c93bfeb1783c","abca00a7463c66042bb4a69b55abe87358ee15e50f880636d1a2ba59e94ca83f","e3075ba2a349e8cfaad0124a4f78dba98c3c7da590b1a29d5b19251d7db69e9b","0f8ef54f2e299b78289f2d9db6b65cce01ad8d74d75bcde05703a463563c55fb","752ac18c8c1d0899f1f54f05b34871eca97a0a450e1b482ac671d630981ab447","87e97124437f52c57edab5ad7ab99f155888d3d43ecf6f3bb84bb6aee6cabd03","59204c06fa3d01f9eab0742e7677955fc5180617449e6d8177ee52017f3073ac","cb226d0736d2b836c03326dba80c109dc4f596889897335a6595df196655e2a7","ea66c565f16357979b31f17204dc3ed0dbccab05b3bf9ab0b67ba7454fb5bd38","41cff1a404cb0368822505f8af883e71d03966f9bacfc4135f05b6a191a01e26","2795ba719c8a346f820a4b9511bb411c404f09b478c0995bdbed16db26396d1d","b582a31b439e6b7cb71a841e7ab8f163b1cd7c910e2cf66f50936354d0e5de2d","85302ab4e2bcdb622c2e6d2dcf2b408cc5375ae51d3d42bf5d0e6e8413cc80a5","267172b83d4d28ed6e5853dd658f4493fc8d6bcbe65e8d2701b50876d43edd56","0b8bceeccd81f25ae1472d96ee679f550f224f9cedbfc90f87a9f8ae93fa87c7","9ad10a47c2d1aba4c1cce8898342bdc6ff1dc3a7eef33c9dc11d9e4f1e9dc754","7e21264910315c3d1464f0de9f132fee0503f8b124e94e6f44f4bccb83872ebe","4e54b31c742a68eec5ecae56b954301c8d09de2b584b9e7a9363207f73a1a8ef","3736deac210854519eac7dbf75e44b165f9c5e6938b61fc54515f8b1e6f6a0b1","61c545d36b1589f0b1dda9bd262456573428daedc79aacd185c528a0bce74fdb","1c7a23324c91804e56fc99d5f065057af27b939cc89195a9db8d200a17dbc722","c92e453c7b73c0c927fa898af9b17cf0db10418391fba60c5f08aa5d3a91ac75","4180c86f9d1c0a4a24354da11a1bdeac8b31b50fa2f97efcf372272916647a3c","13ce61acc8a3c2e40612b3ef3ea3696505e059ca0b45edf8ca11ecf93664f860"],"paragraph_range_zero_based":[38544,38567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38544"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime-r17         ENUMERATED { enabled, disabled }                                    OPTIONAL,   -- Need M","paragraph_zero_based":38568},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38569},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38571},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PBPS-CPS-CONFIG-STOP","paragraph_zero_based":38572},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38574},{"literal_text_all_w_t_and_m_t":"SL-PBPS-CPS-Config field descriptions","paragraph_zero_based":38575},{"literal_text_all_w_t_and_m_t":"sl-Additional-PBPS-Occasion","paragraph_zero_based":38576},{"literal_text_all_w_t_and_m_t":"Indicates that UE additionally monitors periodic sensing occasions that correspond to a set of values. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38577},{"literal_text_all_w_t_and_m_t":"sl-AllowedResourceSelectionConfig","paragraph_zero_based":38578},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource selection mechanism(s), i.e. full sensing only, partial sensing only, random resource selection only, or any combination(s) thereof. (see TS 38.214 [19], clause 8.1.4). Only c1, c4 , c5 or c7 can be configured for a Rel-16 resource pool. If this field is not configured for a resource pool included in sl-TxPoolSelectedNormal, only full sensing is allowed in the corresponding resource pool.","paragraph_zero_based":38579},{"literal_text_all_w_t_and_m_t":"c1: only full sensing allowed","paragraph_zero_based":38580},{"literal_text_all_w_t_and_m_t":"c2: only partial sensing allowed","paragraph_zero_based":38581},{"literal_text_all_w_t_and_m_t":"c3: only random selection allowed","paragraph_zero_based":38582},{"literal_text_all_w_t_and_m_t":"c4: full sensing+random selection allowed","paragraph_zero_based":38583},{"literal_text_all_w_t_and_m_t":"c5: full sensing+ partial sensing allowed","paragraph_zero_based":38584},{"literal_text_all_w_t_and_m_t":"c6: partial sensing + random selection allowed","paragraph_zero_based":38585},{"literal_text_all_w_t_and_m_t":"c7: full sensing+ partial sensing + random selection allowed.","paragraph_zero_based":38586},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic","paragraph_zero_based":38587},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the minimum size of contiguous partial sensing window in logical slot units for a resource (re)selection procedure and re-evaluation/pre-emption checking triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4). If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":38588},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowPeriodic","paragraph_zero_based":38589},{"literal_text_all_w_t_and_m_t":"Indicates the size of contiguous partial sensing window in logical slot units when UE performs periodic-based and contiguous partial sensing for a resource (re)selection procedure triggered by periodic transmission. If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":38590},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing","paragraph_zero_based":38591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f6bc3dfb50ccb573bf06ad1ee9937300d040665701242f958a1044276eb27dfd","ef989061fcd768df5f9ce81b3a70ab6ebb133551437f9d091ac94aa59fa57e83","39aacea6dd39871e48f46781f6dddea7de3e24efc8b7f222aca40667a1d72a67","216e8b7947a64e278d328e4e9eaf041bb8b8090f46680afe7988d5e9ecc9ddf3","c9656e4ec2d7d1881a6ba48961989dadbf83d5056e07bad35631b442ec05c77b","ada2e4d21af6e256a6ae5f2d70cddf5871baf438f899a2d1d2ef128c6825bdc9","40726f6d8dda61eeda98b6b6c036a61d58af7223e2fc0a9c415a93d52ab3623b","68aecbba6f18c228bf8c64b3f1ca7f2001aac195958cddc1d64b3469aff13299","10c0979da24c19d841a502d4b456be860b3d61b78167a9701ca440a4c78c6956","b7ce4d29a659178d2fe3d3f4ae4e45b9ef260ef69c9e1f83e9dba6366c1df22b","192526043966a489265ff7aeac50b6bede38205643402d60776259dd3e4f21d0","d7bc27be72b91a28901f5bed064f0009a0fee0020f45748c4cc2d119b636ee28","5e410b17dbe02117229b700ff038b4145f65777b20de901e47d557e2912463fa","c49b86c4c24206031830d01584451b0a06f51433ff2bb69efb2bbdf7d15f10e8","35f360ba3b27047bd8e0553b0b86da85c94d4e48f6e74fafb27be8ea4076e9a1","184674582cdb3f822a1b2946edb74bac5701d6d5d3a8078191de1052a9f37ac9","d7718de0be18ba36dc477d74ebdcab5e704657b010970e7d4c8609c57126cfc9","5724bfa18c92dfa0f501db63a100b0740de7a9d547f1d988b0cfa3f90ce26716","379c116f38da3a7728d737a8d281e05e8ac69ecf747757cf2e41da9fe5a42642","f06070af6ca2d8ee2e7dbb94695be3f0e8fedb5e5e3d388bf4c75060f7e0ef3b","87a16140de05293c5ca0aacb0a38fed627fdf50749a2059c5bdb759d8cc2bc3c","127ec92c0814401063b2627820e4ec56ace3d41bbf60f1ab503ce65c8f73883f","d0b445d01ff665ac0269b433b46f8c919a12c98231e929d6594f248f1aae0b71","b7aa102016cebb9a6b3510524630254c869847e7223d3d307e32f359e662ed8d"],"paragraph_range_zero_based":[38568,38591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates default value of SL CBR measurement for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured) if the number of SL RSSI measurement slots over CBR measurement window is below sl-MinNumRssiMeasurementSlots, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":38592},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-RandomSelection","paragraph_zero_based":38593},{"literal_text_all_w_t_and_m_t":"Indicates default value of CBR measurement for a UE that performs random resource selection if no SL CBR measurement result over SL CBR measurement window, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":38594},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsAperiodic","paragraph_zero_based":38595},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y' slots that are included in the possible candidate resources corresponding to periodic-based partial sensing and/or contiguous partial sensing for resource (re)selection triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38596},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsPeriodic","paragraph_zero_based":38597},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y slots that are included in the possible candidate resources corresponding to periodic-based partial sensing for resource (re)selection triggered by periodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38598},{"literal_text_all_w_t_and_m_t":"sl-MinNumRssiMeasurementSlots","paragraph_zero_based":38599},{"literal_text_all_w_t_and_m_t":"Indicates a threshold for a minimum number of SL RSSI measurement slots over CBR measurement window for which the SL RSSI is measured for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured). (see TS 38.214 [19], clause 8.1.6).","paragraph_zero_based":38600},{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime","paragraph_zero_based":38601},{"literal_text_all_w_t_and_m_t":"Indicates whether or not UE is required to perform SL reception of PSCCH and RSRP measurement for partial sensing on slots in SL DRX inactive time when partial sensing is configured by its higher layer. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38602},{"literal_text_all_w_t_and_m_t":"sl-PBPS-OccasionReservePeriodList","paragraph_zero_based":38603},{"literal_text_all_w_t_and_m_t":"Indicates the subset of periodicity values from sl-ResourceReservePeriodList used to determine periodic sensing occasions in periodic-based partial sensing, by means of an index to the corresponding entry in sl-ResourceReservePeriodList-r16. If not configured, all periodicity values from sl-ResourceReservePeriodList are used to determine periodic sensing occasions in periodic-based partial sensing (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":38604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38605},{"literal_text_all_w_t_and_m_t":"–SL-PDCP-Config","paragraph_zero_based":38606},{"literal_text_all_w_t_and_m_t":"The IE SL-PDCP-Config is used to set the configurable PDCP parameters for a sidelink radio bearer.","paragraph_zero_based":38607},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config information element","paragraph_zero_based":38608},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38609},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-START","paragraph_zero_based":38610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38611},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config-r16 ::=       SEQUENCE {","paragraph_zero_based":38612},{"literal_text_all_w_t_and_m_t":"    sl-DiscardTimer-r16          ENUMERATED {ms3, ms10, ms20, ms25, ms30, ms40, ms50, ms60, ms75, ms100, ms150, ms200,","paragraph_zero_based":38613},{"literal_text_all_w_t_and_m_t":"                                 ms250, ms300, ms500, ms750, ms1500, infinity}                                   OPTIONAL, -- Cond Setup","paragraph_zero_based":38614},{"literal_text_all_w_t_and_m_t":"    sl-PDCP-SN-Size-r16          ENUMERATED {len12bits, len18bits}                                               OPTIONAL, -- Cond Setup2","paragraph_zero_based":38615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a341e8581dc494d9bfb00b9f366b331d25754dc2e541aa3fd8e81992d506214c","bcb2a55cf505c74d14c3df5fe1ef885f89f00a1fa8380caa1c3ea52a55a5c706","373c9c0cf9217c65164441e8c8e7375b155e681281753e5becc0d83d5d4dc848","6eef442862c35577a092490d3a55980c69ce8a53b42e60a6afdd742e863ad264","78ac3e910e1c5b0511fbff378e545583be70446c2cacf7bb1da9b517069f9f2a","a38f8e785ac9c8ee2fe40375927b86b17a96e3929ea3d1415572fa2b89f2531f","2a356cf7453adc175fab1975643bc090e930331e37ce06410722c3ab0124e95c","e2f8e953e5c1efc57b0354b2a644a658a02f86bb17a529fff156ba122a3857f3","8d413bda8c5210b94c5fa2c1cca9f8996b7873562321b438b67f6c8231079127","dc58364e841c222c85c24dd74d0ebd0a44d7ad039132a0b62ed32b9bdabbc574","4684a66588807c735871756664904a7648bd9db06e6893ab9e96484aac1ef07f","91d3d56fe3b6fb888ae122e024428d6f6d31e01ddf76f9c4add864087e93045c","48924f08dedc8eae156eb55542f0c9b106aa30c15b17b62d39e123e269f1a98c","1827d5f50282a3f28f29ce47813e8b58b98a4b27c0b09f534ec387ff6dc41c9e","35a5db6904dad7f680b665cd6e61c4e3dc84750fb58ab86d642dbe9c25fe227d","a2169babd3c87ed40dd102705c4518f56be3493f5d8d0c2d21adf13ba2c6637c","19721b64326a7c9816db53a30ffd17faff83c5e1008a2f851e8c103eb60f0f51","99bc606e11cf766d10bc8121afc8263feb1f5915d61199d0592ca24b8d00cf15","21f45da52b4f86f8d447544b15ca9522c14366983ff548edfb1380b9e7199bc3","0e3c33a5e675e6a0236e509f2c36ef45ecb02190ec6d0a3983cfa1ca56eca589","34b286afcec3a0aa754ae1a195004c17d54433780c75db86edc048beccea20b7","e1a606d18f2c5f504993232f9e6a358172642b7564ff15329202cf73fcb6d590","39a25de4fcd7f608f6c64350cd6c37de7db1cbfa360fc8fdb2b834dc5262c82a","179689a48d8d41ebe27262b181b9870bbe670dfd9e3c694eee6f6fa13a6a3f4e"],"paragraph_range_zero_based":[38592,38615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38592"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-OutOfOrderDelivery        ENUMERATED { true }                                                             OPTIONAL,    -- Need R","paragraph_zero_based":38616},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38617},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38619},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-STOP","paragraph_zero_based":38620},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38622},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config field descriptions","paragraph_zero_based":38623},{"literal_text_all_w_t_and_m_t":"sl-DiscardTimer","paragraph_zero_based":38624},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on.","paragraph_zero_based":38625},{"literal_text_all_w_t_and_m_t":"sl-OutOfOrderDelivery","paragraph_zero_based":38626},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":38627},{"literal_text_all_w_t_and_m_t":"sl-PDCP-SN-Size","paragraph_zero_based":38628},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for unicast NR sidelink communication, 12 or 18 bits, as specified in TS 38.323 [5]. For groupcast and broadcast NR sidelink communication, only 12 bits is applicable, as specified in 9.1.1.5.","paragraph_zero_based":38629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38630},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38631},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38632},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":38633},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via dedicated signaling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":38634},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":38635},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via dedicated signaling and in case of sidelink DRB configuration via system information and pre-configuration for RLC-AM and RLC-UM for unicast NR sidelink communication; otherwise the field is not present, Need M.","paragraph_zero_based":38636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38637},{"literal_text_all_w_t_and_m_t":"–SL-PSBCH-Config","paragraph_zero_based":38638},{"literal_text_all_w_t_and_m_t":"The IE SL-PSBCH-Config indicates PSBCH transmission parameters on each sidelink bandwidth part.","paragraph_zero_based":38639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ad3142d5421f9a32b789b4baa86bd5c882bab9236eeb9f476d33e674ebdc46c5","0c5549541f575d9fb2db1ff882f54139291c66f8ae12298ddb8b68077eb822f4","de29fe404e2fb88f262ff64e6b6f6605c9049cd1ccadb44176f798a89ba3c8ab","20cf06229ba50a66aabbfef896c8e468018f7646a9fd00a9c600aa6ce41c3fad","4dfb51fe609338f6088ee45a707247aa450d091d70beae7f47a61580188d6971","07572b504340d7f30dbbe9666a1a7a8d57ca9dba0fdcab704e49145c90883e56","944250f9203589e1795b7d6001986bd5cf7efe67931eba0a32937c7