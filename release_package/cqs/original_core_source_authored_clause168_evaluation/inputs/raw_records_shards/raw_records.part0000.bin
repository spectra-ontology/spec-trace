{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36768},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoListAerial-r18 ::=     SEQUENCE (SIZE (1..maxMultiBands)) OF EUTRA-MultiBandInfoAerial-r18","paragraph_zero_based":36769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36770},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoAerial-r18 ::=         SEQUENCE {","paragraph_zero_based":36771},{"literal_text_all_w_t_and_m_t":"    eutra-FreqBandIndicator-r18               FreqBandIndicatorEUTRA,","paragraph_zero_based":36772},{"literal_text_all_w_t_and_m_t":"    eutra-NS-PmaxListAerial-r18               EUTRA-NS-PmaxList                           OPTIONAL    -- Need R","paragraph_zero_based":36773},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36775},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLISTAERIAL-STOP","paragraph_zero_based":36776},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36778},{"literal_text_all_w_t_and_m_t":"–EUTRA-NS-PmaxList","paragraph_zero_based":36779},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-NS-PmaxList concerns a list of additionalPmax and additionalSpectrumEmission, as defined in TS 36.101 [22], table 6.2.4-1 for UEs neither in CE nor BL UEs, TS 36.101 [22], table 6.2.4E-1 for UEs in CE or BL UEs, and TS 36.101 [22], table TBD for Aerial UEs, for a given frequency band.","paragraph_zero_based":36780},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList information element","paragraph_zero_based":36781},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36782},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-START","paragraph_zero_based":36783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36784},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList ::=               SEQUENCE (SIZE (1..maxEUTRA-NS-Pmax)) OF EUTRA-NS-PmaxValue","paragraph_zero_based":36785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36786},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxValue ::=              SEQUENCE {","paragraph_zero_based":36787},{"literal_text_all_w_t_and_m_t":"    additionalPmax                      INTEGER (-30..33)                       OPTIONAL,   -- Need R","paragraph_zero_based":36788},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission          INTEGER (1..288)                        OPTIONAL    -- Need R","paragraph_zero_based":36789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["639e709be1cdfca83af86b05d350a42ae462114c0ba9b7424167c515fb68de39","92c3cabd212fad23d0090aef7af719825bd82399e4bab1c31adf628e4a02a257","33df27df196155e1828e78d409b8db7b5b4be96321717d2b629e059fdfea455a","297da52ea96fee1497e46fb0f92fd65c4e8596f2a5dd6b8b4e036d580c0ba36f","a7076cd5e45c6ac24a98e157b7f9f4949d6371689d8116cecb92dcc719209f33","c3984851b1d7b65471e03330d371b774bdbcc165f6530d5045c4e1a1ff4e51cb","6726aaa5d83d310e66e1b32d1e20f97f86b2c9de8124a2fc2d8185dde64bbb48","cc01a2edff391b0eff757e51c99a6b210cd1d5d5054b080d7f2545214d9808ff","d39086e0f3f5bf947027e15165e38c283eed642dc228c8ac9552a52cea355ef5","630a2e908e70cada23035e6fc1c9b5146557927b67a3eac8847d34a3e9daec0e","cbbb111b658a86babc141f5eb650da47a280ebfc7ce8b501179bd1e5375ad55a","f1659617b498529d7173eb9cd266bbf232720c6