{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    -- R1 23-8-3SRS Antenna switching for >4Rx","paragraph_zero_based":30864},{"literal_text_all_w_t_and_m_t":"    srs-AntennaSwitchingBeyond4RX-r17                     SEQUENCE {","paragraph_zero_based":30865},{"literal_text_all_w_t_and_m_t":"        -- 1. Support of SRS antenna switching xTyR with y>4","paragraph_zero_based":30866},{"literal_text_all_w_t_and_m_t":"        supportedSRS-TxPortSwitchBeyond4Rx-r17                BIT STRING (SIZE (11)),","paragraph_zero_based":30867},{"literal_text_all_w_t_and_m_t":"        -- 2. Report the entry number of the first-listed band with UL in the band combination that affects this DL","paragraph_zero_based":30868},{"literal_text_all_w_t_and_m_t":"        entryNumberAffectBeyond4Rx-r17                        INTEGER (1..32)      OPTIONAL,","paragraph_zero_based":30869},{"literal_text_all_w_t_and_m_t":"        -- 3. Report the entry number of the first-listed band with UL in the band combination that switches together with this UL","paragraph_zero_based":30870},{"literal_text_all_w_t_and_m_t":"        entryNumberSwitchBeyond4Rx-r17                        INTEGER (1..32)      OPTIONAL","paragraph_zero_based":30871},{"literal_text_all_w_t_and_m_t":"    }                                                                              OPTIONAL","paragraph_zero_based":30872},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30873},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30874},{"literal_text_all_w_t_and_m_t":"BandParameters-v1730 ::= SEQUENCE {","paragraph_zero_based":30875},{"literal_text_all_w_t_and_m_t":"    -- R1 39-3-2Affected bands for inter-band CA during SRS carrier switching","paragraph_zero_based":30876},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingAffectedBandsListNR-r17    SEQUENCE (SIZE (1..maxSimultaneousBands)) OF SRS-SwitchingAffectedBandsNR-r17","paragraph_zero_based":30877},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30879},{"literal_text_all_w_t_and_m_t":"ScalingFactorSidelink-r16 ::=       ENUMERATED {f0p4, f0p75, f0p8, f1}","paragraph_zero_based":30880},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30881},{"literal_text_all_w_t_and_m_t":"IntraBandPowerClass-r16 ::=         ENUMERATED {pc2, pc3, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":30882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30883},{"literal_text_all_w_t_and_m_t":"SRS-SwitchingAffectedBandsNR-r17 ::= BIT STRING (SIZE (1..maxSimultaneousBands))","paragraph_zero_based":30884},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30885},{"literal_text_all_w_t_and_m_t":"-- TAG-BANDCOMBINATIONLIST-STOP","paragraph_zero_based":30886},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a080c6beb95f41e9144a1b4107543f5cb7a7753fd896ec57917f185100be4b0b","87e8d8a274e4a44e2c2bdeb3cd7400eff67dbd5f27b8acfcdcda369b9fc5d3c2","96036a99af83b58b03a84630ee1b61ffbf41bab4f468f154b98e433684618240","e38986d46a03e4e9d1266e03bce75a619a009751b8abef6fb6b4e7574d8ec971","2adab0894252bd63aa0956d9a30a9546294a167a22e65fff0c01baf97a0e8cfa","609687aa28ed18dea1f6b33ad49a73c5cf60bf8e7469b7996a270ea5c841d0d2","5fb7f948a31f220a738f510fb10f969da5fdd52fa224dc2b18d53a919654d6c1","ba3d4a506b3f74304afba6ff0c330ecdb8790729a9f0ad06c52a0a4420521595","a449c4a1d4ce45a12779e31491696c7dbf96f24407e3cf4dbd6c9783b25f0589","b01d04c0dad5920438b59858416a8abdac1f9f658b97c3d88f36ccd6de0096c8","dbbcf6b75c075c00ce74c887a99752899ebbcb1fde730c4372521e396ac68775","a27915b9acabd102a107840725d611559ad3afb41c9d246dfaa48ffdcaf637ae","1c92632dba8c69748d34e5d240ced5407d3060079649e947971af2b1f1a0233b","0786a11f770f6aac5c8dda9f9ba5a97c5aaea9a92ad95aec4c6ef7a22feefec5","c941d361b339ed796fdadde9fb0c7e42d318ec91185b67c8addda2c28aa01507","e1a666ce1abf8ed82106697b62c1f9d2e214cabbd712121c4ba07ce6641692a4","88a07e1ee4116e379fc94680acce5a0d28e071a2ba80b1f521d1e6ede9053a8d","75b26b3280e29a3783d079277e40fe70afe481633a8dc65c5bb30d168d86a574","3d230f3c75d9eae86db336b0b97816666fd9012ab6be160f094ced62088f9709","903e8f45e8f176fcca1942dff0aa557f63cf45e41bdb2509ca0891e34dbbc8d1","1f2805b8b6e42ce5812ca26a49991f17a6bf6493810c9ae7ebe1b067b4a3bb57","81059853494084e210a9178d398b1a595ee9c19d2e1e9a9f8ce77d516c454a55","66e945637e7547f32b6f3f9bd95d1c7d3af1ca6fa6fef2823b93abddeddef2c4","3b84b353f64fc2b24a91667b45fa027a7c06988f5525695a35a2ee8ee451a1ad"],"paragraph_range_zero_based":[30864,30887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30864"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30888},{"literal_text_all_w_t_and_m_t":"BandCombination field descriptions","paragraph_zero_based":30889},{"literal_text_all_w_t_and_m_t":"BandCombinationList-v1540, BandCombinationList-v1550, BandCombinationList-v1560, BandCombinationList-v1570, BandCombinationList-v1580, BandCombinationList-v1590, BandCombinationList-v15g0, BandCombinationList-v15n0, BandCombinationList-v1610, BandCombinationList-v1630, BandCombinationList-v1640, BandCombinationList-v1650, BandCombinationList-v1680, BandCombinationList-v1690, BandCombinationList-v16a0, BandCombinationList-v1700, BandCombinationList-v1720, BandCombinationList-v1730, BandCombinationList-v1760","paragraph_zero_based":30890},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix). If the field is included in supportedBandCombinationListNEDC-Only-v1610, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":30891},{"literal_text_all_w_t_and_m_t":"If the field is included in supportedBandCombinationListNEDC-Only-v15a0, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix) of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":30892},{"literal_text_all_w_t_and_m_t":"BandCombinationList-UplinkTxSwitch-r16, BandCombinationList-UplinkTxSwitch-v1630, BandCombinationList-UplinkTxSwitch-v1640, BandCombinationList-UplinkTxSwitch-v1650, BandCombinationList-UplinkTxSwitch-v1690, BandCombinationList-UplinkTxSwitch-v16a0, BandCombinationList-UplinkTxSwitch-v16e0, BandCombinationList-UplinkTxSwitch-v1700, BandCombinationList-UplinkTxSwitch-v1720, BandCombinationList-UplinkTxSwitch-v1730, BandCombinationList-UplinkTxSwitch-v1760","paragraph_zero_based":30893},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList-UplinkTxSwitch-r16.","paragraph_zero_based":30894},{"literal_text_all_w_t_and_m_t":"For the field of supportedBandCombinationList-UplinkTxSwitch-v1700, if the UE does not support 2Tx-2Tx switching for a given band combination, the field of supportedBandPairListNR-v1700 in the corresponding entry is absent.","paragraph_zero_based":30895},{"literal_text_all_w_t_and_m_t":"ca-ParametersNRDC","paragraph_zero_based":30896},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the NR capability container, the field indicates support of NR-DC. Otherwise, the field is absent.","paragraph_zero_based":30897},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDAPS","paragraph_zero_based":30898},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when any DAPS bearer is configured.","paragraph_zero_based":30899},{"literal_text_all_w_t_and_m_t":"ne-DC-BC","paragraph_zero_based":30900},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the MR-DC capability container, the field indicates support of NE-DC. Otherwise, the field is absent.","paragraph_zero_based":30901},{"literal_text_all_w_t_and_m_t":"supportedBandPairListNR-r16, supportedBandPairListNR-v1700","paragraph_zero_based":30902},{"literal_text_all_w_t_and_m_t":"Indicates a list of band pair supporting UL Tx switching as defined in TS 38.101-1 [15] for a given band combination.","paragraph_zero_based":30903},{"literal_text_all_w_t_and_m_t":"A UE supporting 2Tx-2Tx switching should include both of supportedBandPairListNR-r16 and supportedBandPairListNR-v1700. And the UE shall include the same number of entries listed in the same order as in supportedBandPairListNR-r16.","paragraph_zero_based":30904},{"literal_text_all_w_t_and_m_t":"If the UE does not support 2Tx-2Tx switching for a given band pair, the field of uplinkTxSwitchingPeriod2T2T in the corresponding entry is absent.","paragraph_zero_based":30905},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListNR","paragraph_zero_based":30906},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular pair of NR bands, the RF retuning time when switching between a NR carrier corresponding to this band entry and another (PUSCH-less) NR carrier corresponding to the band entry in the order indicated below:","paragraph_zero_based":30907},{"literal_text_all_w_t_and_m_t":"-For the first NR band, the UE shall include the same number of entries for NR bands as in bandList, i.e. first entry corresponds to first NR band in bandList and so on,","paragraph_zero_based":30908},{"literal_text_all_w_t_and_m_t":"-For the second NR band, the UE shall include one entry less, i.e. first entry corresponds to the second NR band in bandList and so on","paragraph_zero_based":30909},{"literal_text_all_w_t_and_m_t":"-And so on","paragraph_zero_based":30910},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListEUTRA","paragraph_zero_based":30911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["de95f757d35e82eea4915c78b265f3ec5db609458641ba8779789d2bfc895864","8a601ebbd7d9a3067992d0bc8736aa025e5e6c3dd7ff33027c2085eb3fa3d5b0","ddbb8154fc1d81929fdd415298c12490c703f0fa5ee679b8a71516f204c32429","ebdd9e392f05c7a1015da011ccbdd8f939fb5e457ce86ebf671c8c83d4f51b31","67091e417