agraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ecc7295152ab004fee6c5fe5b51922f6b04fc31c69bc0c2a87740df08932928","original_member_sha256":"5ac2a6eb195866185c7c6c25a8e6bde44e85ab5aebfb9dafb46d77b16a9bd085","paragraph_ElementTree_utf8_XML_sha256":["f25982e6580ef697eb21ccbc1a608883d0549bb49c7706012bd5811101ee84f6","26c19569eb49aa9b7b5b769931dfa4fef91005c20a9717f8e1c944e27663c1e7","5b266a2ffc6dd89de828d628a3998e0ac8804712b18b1fc50df911c2abaae52d","616791aff0eda03dcb5ae010912299c244908a645003c6613162361ecfabd42e","bd4cf9e54c85235d0be9e713b2f9accfe0a9ace26325c35fed72d4e38ba1dbd3","75d1e83551f3f4fc05cd9c1e111c126eddc27133866954b88207d0a2e311624f","11f94b9fb282176b0f79c992b3e35ca4187edd7355054b8ebd32178671a3f968","6be83edc135b91bf15b8d6b577f9d1d277628b1ad3ea7f828dff0d5e5e583deb","a5854169e32f94a1cb34e0296b8540888737c4d2cdd2c29b943609f4a31b0244","d83b6d4608fdc71bd6f2481f97071898239eed7ed23690c734a6bdabf5b03108","e8e43e725bc83f45d206e4e9808d43f3034e527a3184f4dca948eee17ab71ebb","e43b2edd0421ad18a3ba4f1251ed0cbf0fa1c1403860a8b57cd5894b0b23a58b","ae3cdd5394130026d490cae0cfa908e35eca987b16ddae1ac189d82ac9d3227a","c374fed4bd13fee2df6d333a27e0c8835272b235ffb481c4a328382da00228fc","67c6734c63e12159fcd04d20d47212d538167b8a4fa1cc16373bc63a04698636","4adc8f15d6afbfaaf6202e960026918fd7cb5788efa816b1f354fd03497bb3de","b0495c203275f6bb48616d1c528b03a4e312ace7179326bc5d6f1e31ef895994","9d1b07b7c0e8ddcd5f08cd22333377f67bb716fbe661610ae6e0b905abca5c18","993d5bb34af3ebfab423da1e6491da257b1ebc9142e584e022f22dce96240e52","805fd169e49f2f741615b44c2fc8b63ee4daa6c6de22a2b0f8ed56f06fef12d6","eac3b0e7738c091d60b1f31639fdbad98ccc6e44ecbe6be89f629a52cc6a91a4","4cae1a61c15f826b9552d2333336020b0e1548533863dd3b94d8d215c70a5458","9931adeeb232d594805dc531f64e2e9e62d6c5654ed6684f3ff8896c927993c5","9ab893de73be33c96fe1326c017899be5d76a2c1082dddc15ffe2148519a1580"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state