{"fields":{"filename":"R2-2304885.zip::R2-2304885 CR to 38305 Integrity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Correlation Times: The minimum time interval beyond which two sets of GNSS assistance data parameters for a given error can be considered to be independent from one another.","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"End of Changes","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":243}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2bd06981bfa1735db77ada95dc726f733939bc78990db1a54790e7b1527f9b39","original_member_sha256":"ea7cb980358ba72e01e1d7f194ddf360632247511118ed9bd841957f774703d8","paragraph_ElementTree_utf8_XML_sha256":["ec67f9edb3c4d3d0f0e1a9c49c5ee863eb1ff7cfefa423e5b5cb348bf336843a","e1a4cd28be5dd3e4b00edc8efcdda0089a5c52675d39b5f2e7eff2f56a970553","41824ff0763bf02ca0f4be7eac8d4bbc309118193fad32fb685dda15ba120f72","21afe6f8ce4aced9d907f5f3e59529c355ec865c3ed1d206534ec117efda3e08"],"paragraph_range_zero_based":[240,243],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2304885.zip::R2-2304885 CR to 38305 Integrity.docx:p240"}
