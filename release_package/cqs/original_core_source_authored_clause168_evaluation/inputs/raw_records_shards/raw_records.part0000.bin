{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:The following table indicates per MN RAT and SN RAT whether RAT capabilities are included or not in ue-CapabilityInfo.","paragraph_zero_based":44064},{"literal_text_all_w_t_and_m_t":"MN RAT","paragraph_zero_based":44065},{"literal_text_all_w_t_and_m_t":"SN RAT","paragraph_zero_based":44066},{"literal_text_all_w_t_and_m_t":"NR capabilities","paragraph_zero_based":44067},{"literal_text_all_w_t_and_m_t":"E-UTRA capabilities","paragraph_zero_based":44068},{"literal_text_all_w_t_and_m_t":"MR-DC capabilities","paragraph_zero_based":44069},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":44070},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44071},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44072},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44073},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44074},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44075},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":44076},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44077},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44078},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44079},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44080},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":44081},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":44082},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44083},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":44084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44085},{"literal_text_all_w_t_and_m_t":"–MeasurementTimingConfiguration","paragraph_zero_based":44086},{"literal_text_all_w_t_and_m_t":"The MeasurementTimingConfiguration message is used to convey assistance information for measurement timing.","paragraph_zero_based":44087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b38bafa07e897bb4a38577d8549d6944e4ab18b7d7b47f89e8f3e2ad58268aed","04a0d1ea0ba52f58c8be95c2ea301d9aba64626948aae3adf596e1388da58c8a","6270d97f27787df4725ad857ed6d0cbf87dc6bf42229b822b3d00cbe0d2ab23c","9210a6e8f73d077cb2570896798c14d3bb08a2f0f840345d50d9bb595abc9be3","159043ff91d2ac0e0263839dfacb97b04a60f455df062a5e6bfa69292baa7df1","b6618001c77aafe79bb438f45fec3655fa0064eb5e3ba28b8f0887fa8d448393","ff8946ae7c2887d706ab4fcf645ea890bd073d7bcf7aef53d218c2d402204157","bea6e7c21697abb926d9ceb37b91a997eeee5ceff21214dd3c5e452c4c6bef1d","e44367cfbe92aedba86d0cc35e1eb3ddae8cdbe3aee111b93af8f67ed32d97eb","12b13ba102fb751e8137e027a1b2fd3792f417dfec28eac3efc3616203c25a6d","3e450a2f90c4b60f5b505b83865a149d32af1715b038f483e945d2e089c6df2a","374be19ef19e7f35da99abe825387c6595a6a8a09698c4e63f827613f7fa3f3a","3d5adb5f659ba12045ff5747ae3fe2817ceae86c17a9589d421b262710e7c964","04ab460c843f1650cd3939bc5e47bfe447467d97b0c77ba240d36ed09a2308d2","5daf526072722f127243d69e14c5b0091d9adc5c7c789e