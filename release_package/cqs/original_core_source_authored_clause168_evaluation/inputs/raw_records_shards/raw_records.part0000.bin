{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":10488},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":10489},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":10490},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE; otherwise it is absent.","paragraph_zero_based":10491},{"literal_text_all_w_t_and_m_t":"RestoreSCG","paragraph_zero_based":10492},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if restoreSCG is included. It is optionally present, Need M, otherwise.","paragraph_zero_based":10493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10494},{"literal_text_all_w_t_and_m_t":"–RRCResumeComplete","paragraph_zero_based":10495},{"literal_text_all_w_t_and_m_t":"The RRCResumeComplete message is used to confirm the successful completion of an RRC connection resumption.","paragraph_zero_based":10496},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":10497},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":10498},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":10499},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":10500},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete message","paragraph_zero_based":10501},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10502},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUMECOMPLETE-START","paragraph_zero_based":10503},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10504},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete ::=                   SEQUENCE {","paragraph_zero_based":10505},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier               RRC-TransactionIdentifier,","paragraph_zero_based":10506},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":10507},{"literal_text_all_w_t_and_m_t":"        rrcResumeComplete                       RRCResumeComplete-IEs,","paragraph_zero_based":10508},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":10509},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":10510},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3fd214f17eb9a9d4aa6ae12b97087555fa96c0223023fc7a85b7cbfbe6ef5bb2","3646cf43fd176734e8463d29f658e4fa50298a45f4cfa3de7d209126828d7226","28bd5dbe701f709978d8f475bf1978a39bf5ed02feac2162b1f10b3d374c0190","22bff8754297694fc1893cea8f937197e74bb308070b931237de613d4b414248","ec461c2016705186874315b1b7294b8b8bf15039056bb1bfec420cb23634b825","d70ae13e8f1088464df0c0035042fc73ac444d2b864a646f7c83cf1303e9db48","6da1ce28ac500a0b24cfc20a25b173bc0a249bebc6c602b10b2796445d66738f","d7cd78fdf3a9eb887b6530f1b59222fc5203a85dc266c3527439013a35f9ed12","cb0a7fa27f0ceb024c728a8ad1a4727ec0706311e09a42782c770cc1d563c96e","08b9e54ebce60ab12a647c1244476120927a4e9b4f71da5e198c7d9e62973b4d","876f9b5f988a965905dbdd20b8ce777832a6bd283aad3ac369f111af33d6c0c0","5614500475d4429a985a3ced081817b267f6e4266e01e94bab5a6492db95f88e","e27563a8566a281edf9c41da01b8d2922da930166b4527b84d66e095ca551b8f","b621110ea3e1b2fffca18ca502d42084ca0ae65373545104d40d230928bef4d3","199c8bd2d60516dfc549023ed2778609a29d51b8856caf7412e6013f4424f2a0","353bfa96fd5af383c9de612001a8e4ae3fa0d99d3689c6b9b0f60f7912375f3c","9260355a6595c903da00cdf4eec0b8