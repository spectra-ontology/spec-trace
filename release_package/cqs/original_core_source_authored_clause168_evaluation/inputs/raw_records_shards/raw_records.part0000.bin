{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent, Need R.","paragraph_zero_based":24000},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":24001},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise.","paragraph_zero_based":24002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24003},{"literal_text_all_w_t_and_m_t":"–PUSCH-Config","paragraph_zero_based":24004},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-Config is used to configure the UE specific PUSCH parameters applicable to a particular BWP.","paragraph_zero_based":24005},{"literal_text_all_w_t_and_m_t":"PUSCH-Config information element","paragraph_zero_based":24006},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24007},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-START","paragraph_zero_based":24008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24009},{"literal_text_all_w_t_and_m_t":"PUSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":24010},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPUSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":24011},{"literal_text_all_w_t_and_m_t":"    txConfig                                ENUMERATED {codebook, nonCodebook}                                  OPTIONAL,   -- Need S","paragraph_zero_based":24012},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeA        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":24013},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeB        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":24014},{"literal_text_all_w_t_and_m_t":"    pusch-PowerControl                      PUSCH-PowerControl                                                  OPTIONAL,   -- Need M","paragraph_zero_based":24015},{"literal_text_all_w_t_and_m_t":"    frequencyHopping                        ENUMERATED {intraSlot, interSlot}                                   OPTIONAL,   -- Need S","paragraph_zero_based":24016},{"literal_text_all_w_t_and_m_t":"    frequencyHoppingOffsetLists             SEQUENCE (SIZE (1..4)) OF INTEGER (1.. maxNrofPhysicalResourceBlocks-1)","paragraph_zero_based":24017},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need M","paragraph_zero_based":24018},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                      ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch},","paragraph_zero_based":24019},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          SetupRelease { PUSCH-TimeDomainResourceAllocationList }             OPTIONAL,   -- Need M","paragraph_zero_based":24020},{"literal_text_all_w_t_and_m_t":"    pusch-AggregationFactor                 ENUMERATED { n2, n4, n8 }                                           OPTIONAL,   -- Need S","paragraph_zero_based":24021},{"literal_text_all_w_t_and_m_t":"    mcs-Table                               ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":24022},{"literal_text_all_w_t_and_m_t":"    mcs-TableTransformPrecoder              ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":24023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e58