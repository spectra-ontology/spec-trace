f9f329327deaf566ba7a0b5a2a54dba69c743a","4714bb06e858119085d8c86de24bdafa096187881ebb3ac1b8f15afe8ed96e09","a6cf3a07ccfc4e28e28e006bf9988499070049e3de7ce1d8e9a66b8288e7e389","880cb954750269c49f24588179226613d9a3fb46074788ce5e4f9a93d5ef6ffb","8f3391ddb0ef91ff4dcaceeae2b9596ca7aafae0226438388da00e62d1d2578f","90b58710aa8b2c1b0e22a9436d6d244ab62fadf90414d73ec4885a7d623f2f0e","4a0b4659295730f2443c0057c4f0b25a964aafb38ed87e59e7e256bbc80ec332","e21778d47497d4ec50644c16d8019dd5d1f6152f4e476a13b82c914ee293af85","56ba6ad4a92cdc3cb2120d11b5af782953536d85edd9af0eb7c4836ba321fcf9","d7c35e58047581ae9b353a2bc35993fe72cb29402c0c054c02d7525ba935da99","09f17d5cd50953a49621d9aecd0f174ffde671c4b5c8442fa832c66a3327c792","338e96962ee75fbcf32b9f165028d3f8b9765769a4ed9630f6ed579f00bf0664","518f4b250d3d31191dd4eb4f0127d06a03801719449b79c1dc8f78cc74213632","da9b042bfb1128716ce1ab0b83528d51d4bc5e9a501619b4bc958ecc0176c46f","274fd52d4c2109b94a2371e1ac752acfe95e5bb758f9f06f968e3f1844540ad2","484fab5c26179fccce15afc726b4b3203b715c9694a4603ffe18809256728c35","bd25a5d936ca81410288374e8963dda246d455cee0304677ec7862346670c750","9b826b1bad0b3adb20b0279de3ed00b078df7e1da0023786663ca0a736b0db87"],"paragraph_range_zero_based":[35400,35423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p35400"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In this field the UE mirrors the FreqBandList that the NW provided in the capability enquiry, if any. The UE filtered the band combinations in the supportedBandCombinationList in accordance with this appliedFreqBandListFilter. The UE does not include this field if the UE capability is requested by E-UTRAN and the network request includes the field eutra-nr-only [10].","paragraph_zero_based":35424},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList","paragraph_zero_based":35425},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR (and NR-DC, if requested). The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-NR-Capability IE. The UE does not include this field if the UE capability is requested by E-UTRAN and the network request includes the field eutra-nr-only [10].","paragraph_zero_based":35426},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSidelinkEUTRA-NR","paragraph_zero_based":35427},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR sidelink communication only, for joint NR sidelink communication and V2X sidelink communication, or for V2X sidelink communication only. The UE does not include this field if the UE capability is requested by E-UTRAN (see TS 36.331[10]) and the network request includes the field eutra-nr-only.","paragraph_zero_based":35428},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSL-NonRelayDiscovery","paragraph_zero_based":35429},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR sidelink non-relay discovery. The encoding is defined in PC5 BandCombinationListSidelinkNR-r16.","paragraph_zero_based":35430},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSL-RelayDiscovery","paragraph_zero_based":35431},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR sidelink relay discovery. The encoding is defined in PC5 BandCombinationListSidelinkNR-r16.","paragraph_zero_based":35432},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":35433},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic uplink Tx switching for NR UL CA and SUL. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-NR-Capability IE. The UE does not include this field if the UE capability is requested by E-UTRAN and the network request includes the field eutra-nr-only [10].","paragraph_zero_based":35434},{"literal_text_all_w_t_and_m_t":"supportedBandListNR","paragraph_zero_based":35435},{"literal_text_all_w_t_and_m_t":"A list of NR bands supported by the UE. If supportedBandListNR-v16c0 is included, the UE shall include the same number of entries, and listed in the same order, as in supportedBandListNR (without suffix).","paragraph_zero_based":35436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35437},{"literal_text_all_w_t_and_m_t":"–RF-ParametersMRDC","paragraph_zero_based":35438},{"literal_text_all_w_t_and_m_t":"The IE RF-ParametersMRDC is used to convey RF related capabilities for MR-DC.","paragraph_zero_based":35439},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC information element","paragraph_zero_based":35440},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35441},{"literal_text_all_w_t_and_m_t":"-- TAG-RF-PARAMETERSMRDC-START","paragraph_zero_based":35442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35443},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC ::=                   SEQUENCE {","paragraph_zero_based":35444},{"literal_text_all_w_t_and_m_t":"    supportedBandCombinationList            BandCombinationList                             OPTIONAL,","paragraph_zero_based":35445},{"literal_text_all_w_t_and_m_t":"    appliedFreqBandListFilter               FreqBandList                                    OPTIONAL,","paragraph_zero_based":35446},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["91bb7baeb85e81ab0df90083ab498d12807dc7e93090c1b25bdd740a7c5e2b6a","b1366b683b3620a5f943c571c80d6d2f3a948400cdd41eac5d148335ba6e8daa","011fae21c3608d80abce70eb9e4325089ae33ec6c8adabc10bf54703a7fffda4","138566688b78bca097cd5d66714e4a56649e8a8ddaa52c2d2f3313a7fa3a7fd6","34638503775e715debc2b0e2615e0d0e4ce643796760e36cef577828cfbbf42c","8d0e0ce1b8a77327e35c2ef3cebde904723ca1023149ef969fbf0225fad278dc","80f26aa9fd8ed2466f9a640067b4d0b045cbc4ef646e9c894c9d32e9d7cba609","05f22533e369da65eea0aee85dda5201e0e6abb64f623e7f4899d1cfc245e45b","a75eab0bbc1dbf73bdace0bbaf1b66ddb970862d01b3773d70e11a28a6e32582","587a6d18e438e8567e9c10060a6a6e5ef006cbfd4c673c97434c9b5b3135971d","7afd19ffceef742011f338e411956f76af5f685e217e92b657543b8f2a35f341","a2635b1c6d7f46b2ee3cb261f1fa8a2d4c42911254b8648f0485099b1002d533","f147003c7727c06ab8259c974038a9caa60f93292c04d9c8995ebc4a116e6dd2","ca643e73524cfdada50a8d5e8a99578ce358957caec81996d868c949e4b8d1ec","0a6c23d84ba7ebbdef2b1a0632b2b09dcb441599857a95314320d2e143aea435","bdca21b00db4c0e4d05d585be785ba7fbac005f97ac4c2455c68f3e2ef39fe00","b0050c316958352b13c91499ab1c0f79677379e62f3d45920d5ace9a09dfaf7c","3a273b71d4bfe8b41ecc54cb4e29eb7613734bc4473b099eccdda1af5140dd0e","9a1527cf5b4d57906e0a2a81edef9995ae96f58af4f3d216a7e1cdc7c