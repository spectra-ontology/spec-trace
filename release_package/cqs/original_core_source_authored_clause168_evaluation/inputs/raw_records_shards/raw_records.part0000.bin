{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":2520},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":2521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2522},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2523},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2524},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":2525},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":2526},{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":2527},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":2528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2529},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":2530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2531},{"literal_text_all_w_t_and_m_t":"–RadioBearerConfig","paragraph_zero_based":2532},{"literal_text_all_w_t_and_m_t":"The IE RadioBearerConfig is used to add, modify and release signalling, multicast MRBs and/or data radio bearers. Specifically, this IE carries the parameters for PDCP and, if applicable, SDAP entities for the radio bearers.","paragraph_zero_based":2533},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig information element","paragraph_zero_based":2534},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2535},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-START","paragraph_zero_bas