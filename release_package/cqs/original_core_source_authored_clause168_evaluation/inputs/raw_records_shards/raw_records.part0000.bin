{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5088},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5089},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":5090},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5091},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c2-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":5092},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":5093},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":5094},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":5095},{"literal_text_all_w_t_and_m_t":"5.5.4.13Void","paragraph_zero_based":5096},{"literal_text_all_w_t_and_m_t":"5.5.4.14Void","paragraph_zero_based":5097},{"literal_text_all_w_t_and_m_t":"5.5.4.15Event D1 (Distance between UE and referenceLocation1 is above threshold1 and distance between UE and referenceLocation2 is below threshold2)","paragraph_zero_based":5098},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5099},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition D1-1 and condition D1-2, as specified below, are fulfilled;","paragraph_zero_based":5100},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition D1-3 or condition D1-4, i.e. at least one of the two, as specified below, are fulfilled;","paragraph_zero_based":5101},{"literal_text_all_w_t_and_m_t":"Inequality D1-1 (Entering condition 1)","paragraph_zero_based":5102},{"literal_text_all_w_t_and_m_t":"Ml1-Hys>Thresh1","paragraph_zero_based":5103},{"literal_text_all_w_t_and_m_t":"Inequality D1-2 (Entering condition 2)","paragraph_zero_based":5104},{"literal_text_all_w_t_and_m_t":"Ml2+Hys<Thresh2","paragraph_zero_based":5105},{"literal_text_all_w_t_and_m_t":"Inequality D1-3 (Leaving condition 1)","paragraph_zero_based":5106},{"literal_text_all_w_t_and_m_t":"Ml1+Hys<Thresh1","paragraph_zero_based":5107},{"literal_text_all_w_t_and_m_t":"Inequality D1-4 (Leaving condition 2)","paragraph_zero_based":5108},{"literal_text_all_w_t_and_m_t":"Ml2-Hys>Thresh2","paragraph_zero_based":5109},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5110},{"literal_text_all_w_t_and_m_t":"Ml1 is the distance between UE and a reference location for this event (i.e. referenceLocation1 as defined within reportConfigNR for this event), not taking into account any offsets.","paragraph_zero_based":5111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["41acf992a0324139ede05d15747d5c9d231ea641ad147f781712be2e6ba9e098","98fc7f42189a36cb2b5a927a0f5365ef90fa2f3375b11a5d83079aea8faa78e3","156bee9a570c87355ba401a8c9fd0b1b714cfde59c43c85bbc7568f9ad02a368","c368efcda905cc0c93b2263f5bee2e1b114249b45c538840cc50ee99f922c528","e47a4422f29e3fbe68e243deab9f2cffcab7cbb428370e49327207876b6b7cab","e47918334139d16bbbd7802a8cdaff1085f27f5a93c38924c58a2444e7d54302","94698c496dbaf256d8a9cb4eb6618fa9b254aa487a0e25caca4514073627778d","40584e386dffb2c1ec64a4bab98741236da5cbe5132719f7562b9ad800077176","a297cb11e7216fc6032f3627411cbeb930ef457a5f229bc807ff53c4bab84117","f7617ae9de0e1b6ae685bdb0774e42808bbc711cde8f90a9c51226a5e669bffb","f26aa81e51eaef8e02b37deeebf23c916968c3e8b0f18ac83bcd8fd20f965947","649008e99de36a2820d6a03acfd9115a1ec8480ff1843ebfb7ffd1ec3da68c77","10e80dd7b0ae840193f6138f6f1409ca48a7ec0db8dc13e900fa77206239454f","e157cdb76096416fea50c600877131810dd8e65b0653955fc49c389886218517","9e07d4066e729d06492e2a599b29e239e4707f9d2e1ef2e7066a7177d42100af","fd0ac67c77c35205f29108687ed706d3339f1f6d8f9b1d5e0dbef403454a2c38","684e49c50908e7aee347e2ccae0466b56cb0eb4fcfbccfa07a4941faae450522","a7bb48767cc94c1800c42550bffef83c68437c829da9875baba72eb86b58cf4f","c72bb5044ee9c33d8f627a69bdd91b9be101c5013c050196ac0cdcb09211c2bf","df2e2f4cd850168168eb488db38eebf1649781e92fb1355c08bdd183908fd826","a83368f8d770c746f166fb97ae1dc6f40ebc177661775e40067e4e9c770308b5","c7ff4b7dee8bffcb49be88a323e5c5680aad9eb26a77c787aa328476e4038c6b","2e51bdc6c45ba0d8f98b7e72a0f40df70c42bb71a67cfc450159fc2595443c5d","811f55580d62204b280d8505c4a7de1ddd4340a557cc6e5f677161ab7f1b515b"],"paragraph_range_zero_based":[5088,5111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5088"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Ml2 is the distance between UE and a reference location for this event (i.e. referenceLocation2 as defined within reportConfigNR for this event), not taking into account any offsets.","paragraph_zero_based":5112},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresisLocation as defined within reportConfigNR for this event).","paragraph_zero_based":5113},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold for this event defined as a distance, configured with parameter distanceThreshFromReference1, from a reference location configured with parameter referenceLocation1 within reportConfigNR for this event.","paragraph_zero_based":5114},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold for this event defined as a distance, configured with parameter distanceThreshFromReference2, from a reference location configured with parameter referenceLocation2 within reportConfigNR for this event.","paragraph_zero_based":5115},{"literal_text_all_w_t_and_m_t":"Ml1 is expressed in meters.","paragraph_zero_based":5116},{"literal_text_all_w_t_and_m_t":"Ml2 is expressed in the same unit as Ml1.","paragraph_zero_based":5117},{"literal_text_all_w_t_and_m_t":"Hys is expressed in the same unit as Ml1.","paragraph_zero_based":5118},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Ml1.","paragraph_zero_based":5119},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Ml1.","paragraph_zero_based":5120},{"literal_text_all_w_t_and_m_t":"NOTE:The definition of Event D1 also applies to CondEvent D1.","paragraph_zero_based":5121},{"literal_text_all_w_t_and_m_t":"5.5.4.16CondEvent T1 (Time measured at UE is within a duration from threshold)","paragraph_zero_based":5122},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5123},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition T1-1, as specified below, is fulfilled;","paragraph_zero_based":5124},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition T1-2, as specified below, is fulfilled;","paragraph_zero_based":5125},{"literal_text_all_w_t_and_m_t":"Inequality T1-1 (Entering condition)","paragraph_zero_based":5126},{"literal_text_all_w_t_and_m_t":"Mt>Thresh1","paragraph_zero_based":5127},{"literal_text_all_w_t_and_m_t":"Inequality T1-2 (Leaving condition)","paragraph_zero_based":5128},{"literal_text_all_w_t_and_m_t":"Mt>Thresh1+Duration","paragraph_zero_based":5129},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5130},{"literal_text_all_w_t_and_m_t":"Mt is the time measured at UE.","paragraph_zero_based":5131},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. t1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":5132},{"literal_text_all_w_t_and_m_t":"Duration is the duration parameter for this event (i.e. duration as defined within reportConfigNR for this event).","paragraph_zero_based":5133},{"literal_text_all_w_t_and_m_t":"Mt is expressed in ms.","paragraph_zero_based":5134},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mt.","paragraph_zero_based":5135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6b8cf02741b04614ef00172806719b71135cda7074b750e3b758b0e24607e091","cff101ea427efce72e519947a6aa55a4f5da27f414b9b88c67aaf851112ba864","f26060fac4fbf177b7505fc05f832a0eb00a4239759acf25f2caa5af81cdce07","5259867084697555c6ae2d1e78aa535911edac15de9b77f6de3f0caf703dcd87","51d22ce6d6e94d16c88a87964337c4184cd515aa17b9139081e4ced3582c1630","a8072c80da9466fbc7f4a7eb5755b4f25df5272bdffc73c2bbf6571f8962ee51","91f49e141b99445537fdd037937f863087c3267f9abb2c00512dad601676ba65","18468d8c016281d987ceb3ac7ab7cf72ab3e0b1564b448f066f9bfd3ab76b0dd","9af42509312cd29b115ea42ecdda8884cdd638f4dc2ede3a60d3ff01e7a88d90","9aa9b05e699805ab40db1378230119be51be21358639768ad40b057636124eb9","153926db29a5d7c09799c329ba02e6d3ff3dabded526663be18a7a4f53165ec3","6f1c08c80a225254ddc14e95542f203a2556972790c775217ff47be0dcafc072","ecc1b159d9fe6c93b7e4b0bf6351c49a273375ddb744a2019716c407bdf797cf","7c489de7bfc86ddcc955c2fca602fa0eed0b42aea025183f5cf83328b8b67fdd","ccb91360be4239e593c4e57d60a9b3ce88a07e0b13ebec90fa73dd7a9dd7bca0","ef71a0795edca67a95d4aa9a740a67de822403f80c06a4ddd3ca679c28d56eba","913140c85f502af55ed9675c5e5f17af531a03cad8abc30a2fb71e53ae480341","01953aa5ebd147f50bc2436e6a7c979b2b2c4f4043f246006813b2ee9880814b","cdf5c03cc3731c2ed24608b2f2206e4a9d75a082c2d41461bab0b0d1ec4e4253","24d1d6538ee008823cd5e321ffcec8384f54c95e7220969333a9b65b709aaf83","a6d72971b9d1cffe9c68d04a5bfbc93affe22a1b924a611f490daaef13798890","b28239b58d08196b273d176452d1edf6fd4e27d658ff3effa1e65a80532ba3f2","f87a0338d21ccbc193c35946e959a590b5ffca436515abd6532a690afa313d8f","39cac51f64c778fe1a18bdf71d982d258ef95fb0a6c7c01df7c907e0d28643a9"],"paragraph_range_zero_based":[5112,5135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5112"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Duration is expressed in the same unit as Mt.","paragraph_zero_based":5136},{"literal_text_all_w_t_and_m_t":"5.5.4.17Event X1 (Serving L2 U2N Relay UE becomes worse than threshold1 and NR Cell becomes better than threshold2)","paragraph_zero_based":5137},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5138},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition X1-1 and condition X1-2, as specified below, are fulfilled;","paragraph_zero_based":5139},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition X1-3 or condition X1-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":5140},{"literal_text_all_w_t_and_m_t":"Inequality X1-1 (Entering condition 1)","paragraph_zero_based":5141},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh1","paragraph_zero_based":5142},{"literal_text_all_w_t_and_m_t":"Inequality X1-2 (Entering condition 2)","paragraph_zero_based":5143},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh2","paragraph_zero_based":5144},{"literal_text_all_w_t_and_m_t":"Inequality X1-3 (Leaving condition 1)","paragraph_zero_based":5145},{"literal_text_all_w_t_and_m_t":"Mr – Hys > Thresh1","paragraph_zero_based":5146},{"literal_text_all_w_t_and_m_t":"Inequality X1-4 (Leaving condition 2)","paragraph_zero_based":5147},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh2","paragraph_zero_based":5148},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5149},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the serving L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5150},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the NR cell, not taking into account any offsets.","paragraph_zero_based":5151},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the reference signal of the NR cell (i.e. offsetMO as defined within measObjectNR corresponding to the NR cell).","paragraph_zero_based":5152},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the NR cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the frequency of the NR cell), and set to zero if not configured for the cell.","paragraph_zero_based":5153},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event.","paragraph_zero_based":5154},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. x1-Threshold1-Relay as defined within reportConfigNR for this event).","paragraph_zero_based":5155},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. x1-Threshold2 as defined within reportConfigNR for this event).","paragraph_zero_based":5156},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm.","paragraph_zero_based":5157},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":5158},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":5159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["084aa9d4219fc24c7ca6c839881825f1a192cc9dd4f932ef17899da8e62b7188","254ac9ee46d9272ad67a0c9b6edc39050aac43708e89f288fb3208085b010c74","bee99ba8f55658f0570cc80641a2f95d615e98f2228d2860561dd7800760