8048e5b7fc853e76e","fddf688e10ca641df358b198d7a9ebd0818989d51c46323c9b96e504769fd189","9341cbf43ab63901dd603ffbabb5f2cc746398e0a3e8a39dde989e6ec5bde00a","5040a2734dc4352f82167d451fbe6e54f094be8c5d9e6ff6a43ba59b9091affd","20156833b964e03a6ba816ad8dbe0aa6e87b0e268762c0ea214cc8fe8ad9f92b","960931003ed5bc966950de77e92e302ccaa1d7afe2f1821389fc76999858a851","ac5eea7247fb7e26306ad3d673a81bc74a7ead948e8af8b834186d71ecf89168","56a2538fe26602d743580cb33340afed8d907ddb0dff0689c16a26de2e55436b","072ce3919fbb160493345d50e02c514cd050211bf97533d4d6bc5b8f810368a0","f032c7c8967bb4953c46ec86acd216cfcc90df53da970b09f3e91b7ef8440131","affab962cfd87039a1f0508ef50a44419a689a501fabb5f8c0b22fffcf478d11"],"paragraph_range_zero_based":[30048,30071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30048"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30072},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config field descriptions","paragraph_zero_based":30073},{"literal_text_all_w_t_and_m_t":"gapOffset","paragraph_zero_based":30074},{"literal_text_all_w_t_and_m_t":"Value gapOffset is the gap offset of the FR2 UL gap pattern with UGRP indicated in the field ugrp. The value range is from 0 to ugrp-1.","paragraph_zero_based":30075},{"literal_text_all_w_t_and_m_t":"refFR2-ServCellAsyncCA","paragraph_zero_based":30076},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 serving cell identifier whose SFN and subframe is used for FR2 UL gap calculation for this gap pattern with asynchronous CA involving FR2 carrier(s).","paragraph_zero_based":30077},{"literal_text_all_w_t_and_m_t":"ugl","paragraph_zero_based":30078},{"literal_text_all_w_t_and_m_t":"Value ugl is the gap length in ms of the FR2 UL gap. The FR2 UL gap length is according to Table 9.1.11-1 in TS 38.133 [14]. Value ms0dot125 corresponds to 0.125 ms, ms0dot25 corresponds to 0.25 ms and so on. ","paragraph_zero_based":30079},{"literal_text_all_w_t_and_m_t":"ugrp","paragraph_zero_based":30080},{"literal_text_all_w_t_and_m_t":"Value ugrp is the gap repetition period in (ms) of the FR2 UL gap. The FR2 UL gap repetition period is according to Table 9.1.11-1 in TS 38.133 [14].","paragraph_zero_based":30081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30082},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30083},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30084},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":30085},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring FR2 UL gap pattern to UE in:","paragraph_zero_based":30086},{"literal_text_all_w_t_and_m_t":"- (NG)EN-DC, NR SA, NE-DC or NR-DC without FR2-FR2 band combination, with asynchronous CA involving FR2 carriers.","paragraph_zero_based":30087},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent.","paragraph_zero_based":30088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30089},{"literal_text_all_w_t_and_m_t":"–UplinkCancellation","paragraph_zero_based":30090},{"literal_text_all_w_t_and_m_t":"The IE UplinkCancellation is used to configure the UE to monitor PDCCH for the CI-RNTI.","paragraph_zero_based":30091},{"literal_text_all_w_t_and_m_t":"UplinkCancellation information element","paragraph_zero_based":30092},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30093},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-START","paragraph_zero_based":30094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["702022563a35c5e47d1b80e612d4b5d3df444ef5a4cb78d80778d803392dc451","52455df1b2256e35f0b8609c411527b625821faf3dad84c3e526d62cf551cf67","125220c1006570df4386883dde5c5fe3308ab40cd587a8368c3b3f6565d4994e","f4ed8e6ad1bc84a164ca3c6120c83bc9c3c5a180f4020783e555e239b4e1b136","7735b2ca31223e8e7c8cd5a620f569cdfde628c824e0896659db42945eae1873","ad4abec329aa8b6270b0ea20ddab40df55953730628318df37d1b26e2c9ccd9a","239949119c5f10ac511a9fe33199567345d3f92df845363bd831241bb6d4e18a","b818c62182fb24bcc16e022181fd3aeb6a1e4826d118a0c6bf44e66379b58b92","ab7e1b3de60d5a004e34712881a59a0b4e565c52049001edcbc76a2f3c2d008c","e25f15698aeae8937c4743978e052ff638698279d675ef6ce9300cee8b2a551f","ab4d50aebebb548fb5fa683e5564b108dbbd88ac7b7425176a0f05d2b41aa1eb","