{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-STOP","paragraph_zero_based":29520},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29522},{"literal_text_all_w_t_and_m_t":"TAR-Config field descriptions","paragraph_zero_based":29523},{"literal_text_all_w_t_and_m_t":"offsetThresholdTA","paragraph_zero_based":29524},{"literal_text_all_w_t_and_m_t":"Offset for TA reporting as specified in TS 38.321 [3]. Network only configures this parameter for MCG.","paragraph_zero_based":29525},{"literal_text_all_w_t_and_m_t":"timingAdvanceSR","paragraph_zero_based":29526},{"literal_text_all_w_t_and_m_t":"Used to configure whether a Timing Advance report may trigger a Scheduling Request as specified in TS 38.321 [3].","paragraph_zero_based":29527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29528},{"literal_text_all_w_t_and_m_t":"–TCI-ActivatedConfig","paragraph_zero_based":29529},{"literal_text_all_w_t_and_m_t":"The IE TCI-ActivatedConfig is used to provide activated TCI states for PDSCH and/or PDCCH of the PSCell or of an SCell.","paragraph_zero_based":29530},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig information element","paragraph_zero_based":29531},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29532},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-START","paragraph_zero_based":29533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29534},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig-r17 ::= SEQUENCE {","paragraph_zero_based":29535},{"literal_text_all_w_t_and_m_t":"    pdcch-TCI-r17               SEQUENCE (SIZE (1..5)) OF TCI-StateId,","paragraph_zero_based":29536},{"literal_text_all_w_t_and_m_t":"    pdsch-TCI-r17               BIT STRING (SIZE (1..maxNrofTCI-States))","paragraph_zero_based":29537},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29539},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-STOP","paragraph_zero_based":29540},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29541},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29542},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig field descriptions","paragraph_zero_based":29543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["52c038f9b3f7b82229da9c9e70e21a8d82f8608fc506f5946e26081dad608d12","6e081fbd178e2da7b9dd9b3887ace408412ca86bf37b0b3746235a4dc63a9dde","f7a437ba33b4b1396f49f8512db0a19d7563e34c924bf96711e8ee36d015ed2d","c8824f198e00dd288d9350629538585d9b655cea0654b8f46ff24e9a35b6aafe","3c8df4e624fafd56f5864710de761da00a07992a8e0e900505ec554418b0b351","b5a31c28a96c424d4edb2d7414d3e88658537fa11192949bfaa88b9688116c58","b2150c05fd1698954957fa703cc221da967bf0a7ce7370c9bc473ecb574472fc","986fa0490d57d6e5925129cf62d02ff34b7e31a8e05ea17e1303a72261e1ec52","91fe94675b02e7f577c270c79febd09f731f7c9193a60a736eafde97b18552a0","7e3d0da9ded8803fae9a821a12d145f313274b7a2400c321628ac2d310cc048b","e6cdff458b9757df4742ab3528876b3d02807c310738118460f80e03989ea130","3ddba18b9a1ab22181c9acc190b0b8a3b91908df2ea318a7442887def9f5b8d0","7ce1e7da692add10cc14a3e6d01877c8902654725821a797503f79b9c090aa26","fc93a8cb8dce1abf7bc44114efc454e1159e559e25ebfd1a4d7aab120ab7d539","ddd4e7214aa977fd4782d01a8860b9fe7c187a9e34117fa8ecf2402f41a78785","2e2ffcdd9dd990a67b4d132c0094ec5576fb7df5e1686f7883eb98866329fffd","cd3e432130f3bb40cb8bbed5bd12514629152f82d18469de0a5a4c9bad2494a2","aff1ff45008136a0d0f39a499b5c3771214b8b9cebaf5ee64ba971f4ed79bbba","9ae5046e1d7ca7917095e4f5ef71d8cd436603adcef3dbdc18f34c114d6e509d","b40dc11e5c183c0d1f7f68bc5424984f453faa11e4ef2d5ca0d5bc35682b70e9","033f7ee9670c8a3cbe4a77a234b8d61e202ed0144a7305b070daf67eaa4e5f56","c295b7c15c468fb1aadb32fc13b99bd5dbdf45644e17cbf8bd3a2c6e90c9861c","9cf13723f2c2af673558ce5a24a9425cbc52ce1ff55d8e4a104afce956c8c074","be1f2c6abdb88b76739b0d99ab91fdbba6d3eb99c34d18ba34fb2ee956e295fc"],"paragraph_range_zero_based":[29520,29543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29520"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdcch-TCI","paragraph_zero_based":29544},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state for PDCCH for each configured CORESET of the DL BWP to be activated at SCell activation, to be activated for the PSCell at SCG activation and/or to be used for BFD, RLM and measurements while the SCG is deactivated. The list includes exactly as many entries as CORESETs configured in this BWP, ordered by increasing values of ControlResourceSet-Id, i.e. the first entry indicates the TCI state for the configured CORESET with the lowest ControlResourceset-Id value, the second value indicates the TCI states for the configured CORESET with the second lowest ControlResourceset-Id value, and so on.","paragraph_zero_based":29545},{"literal_text_all_w_t_and_m_t":"pdsch-TCI","paragraph_zero_based":29546},{"literal_text_all_w_t_and_m_t":"Indicates TCI states for PDSCH reception at SCell addition/activation or of the PSCell at SCG activation. This field indicates activated TCI state(s) for this BWP ordered by increasing values of TCI-StateId, i.e. the first bit indicates the activation state of the TCI state with the lowest TCI-StateId value, the second value indicates the activation status of the TCI state with the second lowest TCI-State-Id value, and so on. A bit set to 0 indicates that the corresponding TCI state is deactivated, a bit set to 1 indicates that the TCI state is activated.","paragraph_zero_based":29547},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29548},{"literal_text_all_w_t_and_m_t":"–TCI-State","paragraph_zero_based":29549},{"literal_text_all_w_t_and_m_t":"The IE TCI-State associates one or two DL reference signals with a corresponding quasi-colocation (QCL) type.","paragraph_zero_based":29550},{"literal_text_all_w_t_and_m_t":"TCI-State information element","paragraph_zero_based":29551},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29552},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-START","paragraph_zero_based":29553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29554},{"literal_text_all_w_t_and_m_t":"TCI-State ::=                       SEQUENCE {","paragraph_zero_based":29555},{"literal_text_all_w_t_and_m_t":"    tci-StateId                         TCI-StateId,","paragraph_zero_based":29556},{"literal_text_all_w_t_and_m_t":"    qcl-Type1                           QCL-Info,","paragraph_zero_based":29557},{"literal_text_all_w_t_and_m_t":"    qcl-Type2                           QCL-Info                                                    OPTIONAL,   -- Need R","paragraph_zero_based":29558},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29559},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29560},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                      OPTIONAL,   -- Need R","paragraph_zero_based":29561},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17          PathlossReferenceRS-Id-r17                                  OPTIONAL,   -- Cond JointTCI1","paragraph_zero_based":29562},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                 Uplink-powerControlId-r17                                   OPTIONAL    -- Cond JointTCI","paragraph_zero_based":29563},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29565},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0