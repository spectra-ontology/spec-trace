{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"connectedReporting","paragraph_zero_based":37176},{"literal_text_all_w_t_and_m_t":"Indicates that the UE can report a preference to remain in RRC_CONNECTED state following a report to leave RRC_CONNECTED state. If absent, the UE cannot report a preference to stay in RRC_CONNECTED state.","paragraph_zero_based":37177},{"literal_text_all_w_t_and_m_t":"delayBudgetReportingProhibitTimer","paragraph_zero_based":37178},{"literal_text_all_w_t_and_m_t":"Prohibit timer for delay budget reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot4 means prohibit timer is set to 0.4 seconds, and so on.","paragraph_zero_based":37179},{"literal_text_all_w_t_and_m_t":"drx-PreferenceConfig","paragraph_zero_based":37180},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's DRX preferences for power saving.","paragraph_zero_based":37181},{"literal_text_all_w_t_and_m_t":"drx-PreferenceProhibitTimer","paragraph_zero_based":37182},{"literal_text_all_w_t_and_m_t":"Prohibit timer for DRX preferences assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37183},{"literal_text_all_w_t_and_m_t":"idc-AssistanceConfig","paragraph_zero_based":37184},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected IDC problem.","paragraph_zero_based":37185},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfig","paragraph_zero_based":37186},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving.","paragraph_zero_based":37187},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceProhibitTimer","paragraph_zero_based":37188},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred bandwidth assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37189},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceConfig","paragraph_zero_based":37190},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":37191},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":37192},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":37193},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":37194},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37195},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":37196},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":37197},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":37198},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":37199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f9e54d6eb6bb0f7ed2ca506da2b525519fe67d7a72df2a6bd3e6c549be1c1b29","c4b30f9aa006bb918dd1b76f2aa5400e4210ca44e6ac5622816b95e46509854b","df08b40e14cecf3917b7df88d308f9a51b637500b3acd58e706903b559ac35ff","cb0702e6b820159e66dbd044af8c9196d5c8faa5e2f212b6c44a297fe489a62d","cf520a979aeea489177b43ab8ea13551f3e9a15336d6aeca4596ac8c3a885d9c","b45ee1d0569227d81ec94e927fb782ecd4bda862d20227db2bd75e2872959c49","82512b70bd4a25d6cf4e58830039ef02a24f75d3b49e32c681cf9cc0aef543c0","4e46507c076237926de25a08c5dc4b6fe965aab150779aafee79a7f49b9588e1","f473878d1f1911540854f861057defc592aa494e242bc15f4fe00babf9f1fb6d","21f86f620dbfb4655a053aede96076ce3fcd15dcf8f46b7b10fbe0d8cf3feb0d","d8e42e75eef2d03b9b9043eb4e3ae1891e43f2e21a5d9aabbee27f9ac03547d1","40520164ee914bc129e1f3787b59526b8711e26e432938278645133884af1a3d","b2450d9b5fbaed9713b91c631cdd44355bed70f1b37b4162269fbc72762d0f47","32d1998aa5620416ac8091b1f790b8efa07eade79259ab04df9ee5e0f6f1dd50","21025fd8c5f019cee857a7847ae9bfdbfce1465dd78ba088248a2346b8008a40","2fe7000d3290eaa253121911a3b2c1f3ad686d25ce29161a80307e7e6817e88b","bfd4ddad7800bf93d93ed7e414947272cf6db306bd9639cc519d720808d40577","f7fc3d7cf3bd4da1240cb27f379b8373d965f81baa1545331295dff70f85dd43","8ad0c27bba1f559f1c7793f00d617e48e53b14d31f55b518b21c0da98b6d2832","5f9ccef17f59802b16d10a6d11cd33b41ef7bc535bf6284eecc01616b77cc548","a84be1ee402d0acc75f3e8121c6bd8cc1f37ccf7bd614eb0bb298cd1d8eac637","5969a24a7c4d71cca884baa71c2ca3cd5e98a426a24821c9e8711c2f800f1914","11e4aa70421a2d151587b1738a978431c7870dc1