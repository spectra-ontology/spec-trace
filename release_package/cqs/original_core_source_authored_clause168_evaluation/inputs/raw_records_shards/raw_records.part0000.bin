{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24648},{"literal_text_all_w_t_and_m_t":"–Q-QualMin","paragraph_zero_based":24649},{"literal_text_all_w_t_and_m_t":"The IE Q-QualMin is used to indicate for cell selection/ re-selection the required minimum received RSRQ level in the (NR) cell. Corresponds to parameter Qqualmin in TS 38.304 [20]. Actual value Qqualmin = field value [dB].","paragraph_zero_based":24650},{"literal_text_all_w_t_and_m_t":"Q-QualMin information element","paragraph_zero_based":24651},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24652},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-QUALMIN-START","paragraph_zero_based":24653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24654},{"literal_text_all_w_t_and_m_t":"Q-QualMin ::=                       INTEGER (-43..-12)","paragraph_zero_based":24655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24656},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-QUALMIN-STOP","paragraph_zero_based":24657},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24659},{"literal_text_all_w_t_and_m_t":"–Q-RxLevMin","paragraph_zero_based":24660},{"literal_text_all_w_t_and_m_t":"The IE Q-RxLevMin is used to indicate for cell selection/ re-selection the required minimum received RSRP level in the (NR) cell. Corresponds to parameter Qrxlevmin in TS 38.304 [20]. Actual value Qrxlevmin = field value * 2 [dBm].","paragraph_zero_based":24661},{"literal_text_all_w_t_and_m_t":"Q-RxLevMin information element","paragraph_zero_based":24662},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24663},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-RXLEVMIN-START","paragraph_zero_based":24664},{"literal_text_all_w_t_and_m_