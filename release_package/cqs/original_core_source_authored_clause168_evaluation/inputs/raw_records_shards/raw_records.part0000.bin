{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23928},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoExt-r16 ::=       SEQUENCE {","paragraph_zero_based":23929},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId-v1610         PUCCH-SpatialRelationInfoId-v1610                              OPTIONAL,   -- Need S","paragraph_zero_based":23930},{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id-v1610        PUCCH-PathlossReferenceRS-Id-v1610                             OPTIONAL,    --Need R","paragraph_zero_based":23931},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23934},{"literal_text_all_w_t_and_m_t":"PUCCH-SRS ::=                       SEQUENCE {","paragraph_zero_based":23935},{"literal_text_all_w_t_and_m_t":"    resource                            SRS-ResourceId,","paragraph_zero_based":23936},{"literal_text_all_w_t_and_m_t":"    uplinkBWP                           BWP-Id","paragraph_zero_based":23937},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23939},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":23940},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23942},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo field descriptions","paragraph_zero_based":23943},{"literal_text_all_w_t_and_m_t":"pucch-PathLossReferenceRS-Id","paragraph_zero_based":23944},{"literal_text_all_w_t_and_m_t":"When pucch-PathLossReferenceRS-Id-v1610 is configured, the UE shall ignore pucch-PathLossReferenceRS-Id (without suffix).","paragraph_zero_based":23945},{"literal_text_all_w_t_and_m_t":"pucch-SpatialRelationInfoId","paragraph_zero_based":23946},{"literal_text_all_w_t_and_m_t":"When pucch-SpatialRelationInfoId-v1610 is configured, the UE shall ignore pucch-SpatialRelationInfoId (without suffix). If pucch-SpatialRelationInfoId-v1610 is absent, the UE shall use the pucch-SpatialRelationInfoId (without suffix).","paragraph_zero_based":23947},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":23948},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the ServCellId of the serving cell in which this PUCCH-SpatialRelationInfo is configured","paragraph_zero_based":23949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23950},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo-Id","paragraph_zero_based":23951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e1dd02f43acfe310d69d65175b9904d2747548495319e867b89ae76f7a593197","9b38a043f12b36b41777c269321ef77d622eb567f49e6fd5f7262be8770252d7","123b36efdc8407e86d3e73854846c6b4f2d9ec497bd70404a4a27e04d9d1186d","76fb62b9aa68ba25f2aaa2797b279c5e6252521cc6979a0108a45c4b1a17fcbe","7a50977c5f4509517e6bc36ee77b941519f2f8fe45db71c999c70fb475bda218","fd0e2d1c281006a64d8154239997119fddffa361ecd8682d15e6ceda7f69016a","bf6c0bf1587d106620d177baadf580024d2f203b26a920023c510204474d866f","3a4d26719c68266f327ba06113336f442d46a35f2bd281a0cd8613f8267ba258","3b6ef2997a0fb5e0f34bfffa34db7d19db723797b4fa46d5b1d3f451a70eb38d","c195fff573990e1ccdb28fa0658f3deaf8c80fc6e288b33a90adf9b6c45091a1","5550b5a55ce51f4c98a179dd828dbe35c6d45d9e9d5d35919712b1457308e8fe","30aa9018356c13640badc72c003928bd