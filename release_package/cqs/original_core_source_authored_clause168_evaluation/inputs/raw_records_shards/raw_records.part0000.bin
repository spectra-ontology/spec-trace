 table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"13260ee9bba0a047cbddf8eb9f8f20d481d5022dfd7922f87b55d5afa5abf372","original_member_sha256":"8312534bc8869558e6089447be92e0f2ad7945068fda4ebfe19e0ca2e1cfbea0","paragraph_ElementTree_utf8_XML_sha256":["4713dede51dd761768fce3583d3accfb4921de7b7d6303e4c042c8097d6d5e95","b497ab8b88a9d2565f8164b08543d896f4e19d6409a0a4573c1412c06dd39bc6","e45645a5300751fa93318fb0c2c355b2389a4c77d86f2a756ddb60b7bc7af6be","6318ec1a2e59d8794f8cf9702d6f1ee0b9bd9c50d9ce65652aeb8a44f74fffcd","74d806b9b410b0485dc974854632f1ee7224c6c03f507ea2d6ff5813ada7fc96","76551ba7b0f4e84aa27d0abe161d8947f1f40dd10956dd4a3b08f4703b860b97","af1c8853a49c2e42abd3134d5a9413e461dc217fa98bac1d0f4512949d976bef","95738820df3746e0ed1f81d1dcbc294240ab5247ac483f0e0b2d85b31b023dbb","52d31a92f97104e7882d2e2f8b939f79188b9391ca70e4c9673c51585d17b62e","4315ef82a4c616d99de15095355b40afd9ac8dba50394ebc1455b8a26277cd61","151370fe42d700a2cf306b0f2144a29b34a6f63af38a26b671c9596987c8f1d8","b79a7d58a4d493430d6a92adb7497530500f7016779f70f8b0a14bd218300059","13afe513a9adbfa1c63973302f2aea827e0c1b18037071385a7f1ca896a4e612","032ac30ab1003623303c799d9f1f7345c10bef160855acaa91808a2a3d00412a","735dd4a23e083bc34a777680593c5c210997989c390470027f749aac7731a75a","1656cd9ed7fd6ad832142938a50f23625b8482d892bd9809123010be5c46e3e6","fc2ae990891257ee7d3e09284828c81546ee6e9e6809593bda56eb7b2941fcc0","7bbef623c8aae8f9eb83e064ef75841ba21888b344051b6fc3132442b3e9ce18","bbdc9bc0a4123cae5ec5a025f73565d3cbae19ffb56f3fc5a42942275c32ed60","93907dd6e04f6e13efd62dc6c261fbb0c103e4ecdf5e13f0a22412182fd3b256","4314f5ef8f5bf917a587ffd5002a88403dfd0bf4794780846415f15593a9d1fd","75ae8523cffdefb4b189663d128d29f6bd0b8d1d20d8b23bb74c60762ea19c81","03d30156778d08cff9bb0b83b322d113845d2bbe5e5ee2b302d24607d09a9a55","b9dd32923e06ae15edb9aa3ec5f7c642a1d422b6682f5fb2b03baaff92912376"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-