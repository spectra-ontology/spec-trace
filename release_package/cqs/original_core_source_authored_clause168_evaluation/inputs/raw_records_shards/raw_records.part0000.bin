{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ms5120                              INTEGER(0..5119),","paragraph_zero_based":38040},{"literal_text_all_w_t_and_m_t":"        ms10240                             INTEGER(0..10239)","paragraph_zero_based":38041},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":38042},{"literal_text_all_w_t_and_m_t":"    sl-drx-SlotOffset                       INTEGER (0..31)","paragraph_zero_based":38043},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38044},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38045},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGUC-STOP","paragraph_zero_based":38046},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38047},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38049},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC field descriptions","paragraph_zero_based":38050},{"literal_text_all_w_t_and_m_t":"sl-drx-CycleStartOffset","paragraph_zero_based":38051},{"literal_text_all_w_t_and_m_t":"Sidelink drx-Cycle in ms and sidelink drx-StartOffset in multiples of 1 ms.","paragraph_zero_based":38052},{"literal_text_all_w_t_and_m_t":"sl-drx-HARQ-RTT-Timer1, sl-drx-HARQ-RTT-Timer2","paragraph_zero_based":38053},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the BWP where the transport block was received. Value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on. sl-drx-HARQ-RTT-Timer1 is used for HARQ feedback enabled sidelink retransmission if SCI does not indicate retransmission resource(s). sl-drx-HARQ-RTT-Timer2 is used for HARQ feedback disabled sidelink retransmission in resource pool configured with PSFCH if SCI does not indicate retransmission resource(s).","paragraph_zero_based":38054},{"literal_text_all_w_t_and_m_t":"sl-drx-InactivityTimer","paragraph_zero_based":38055},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the BWP where the transport block was received, sl0 corresponds to 0, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":38056},{"literal_text_all_w_t_and_m_t":"sl-drx-onDurationTimer","paragraph_zero_based":38057},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":38058},{"literal_text_all_w_t_and_m_t":"sl-drx-RetransmissionTimer","paragraph_zero_based":38059},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the BWP where the transport block was received. Value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":38060},{"literal_text_all_w_t_and_m_t":"sl-drx-SlotOffset","paragraph_zero_based":38061},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":38062},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8566c2686a5b69dc5ff6fe2bcac5fef17bc5a914f8bee0df4456aade4c6b5678","9e4c1158dcb96642ceb3fa7ed4658014087544a9d5fd30909df3523a89750f87","532b7b579924e19ec071fac3fe8a8b1281315ca48688be33d8aa0d733d559d66","94b82bfcf3f11f7243f930895d507aec679ea2411b2dbfdbb04af9be5b281289","ca0be488f353cd0831be706796a