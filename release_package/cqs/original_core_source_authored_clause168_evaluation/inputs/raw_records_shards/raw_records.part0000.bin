051f074334006cb8072a06665aaa60c18845","8a03db76faacc84ecbcd79d05b443fd00453c7f3da6987c934f7ba6f973375cd","0fba6b2dc577be2ba99cefc4b35ae9f7fa5cfc37812b594d208a838aaf3e3782","5a5d503c5a79c5d2302a3bad34ab7fc277dbc07f5b3932fab4f891ed27344315","0191e57003c6ab3eccba8fb23622374fb81bf1afa25175e9fd94935a7e61e4b2","92af176c5d7d223e20b5feb66fca335855176f96e7f86a2e6f3c07bf19c9cd26","940417b621094fce559e0e2d988208883bc9de6dbd81655f62340d325109fc87","2a8c78500a428a8a672c1a429218c60ebb310fc38c2b7f1e0d4f3964f543b764"],"paragraph_range_zero_based":[14016,14039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14016"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    disasterRelatedIndication-r17     NULL,","paragraph_zero_based":14040},{"literal_text_all_w_t_and_m_t":"    commonPLMNs-r17                   NULL,","paragraph_zero_based":14041},{"literal_text_all_w_t_and_m_t":"    dedicatedPLMNs-r17                SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity","paragraph_zero_based":14042},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14044},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB15-STOP","paragraph_zero_based":14045},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14047},{"literal_text_all_w_t_and_m_t":"SIB15 field descriptions","paragraph_zero_based":14048},{"literal_text_all_w_t_and_m_t":"commonPLMNsWithDisasterCondition","paragraph_zero_based":14049},{"literal_text_all_w_t_and_m_t":"A list of PLMN(s) for which disaster condition applies and that disaster inbound roaming is accepted, which can be commonly applicable to the PLMNs sharing the cell.","paragraph_zero_based":14050},{"literal_text_all_w_t_and_m_t":"applicableDisasterInfoList","paragraph_zero_based":14051},{"literal_text_all_w_t_and_m_t":"A list indicating the applicable disaster roaming information for the networks indicated in plmn-IdentityInfoList and npn-IdentityInfoList-r16. The network indicates in this list one entry for each entry of plmn-IdentityInfoList, followed by one entry for each entry of npn-IdentityInfoList-r16, meaning that this list will have as many entries as the number of entries of the combination of plmn-IdentityInfoList and npn-IdentityInfoList-r16. The first entry in this list indicates the disaster roaming information applicable for the network(s) in the first entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, the second entry in this list indicates the disaster roaming information applicable for the network(s) in the second entry of plmn-IdentityInfoList/npn-IdentityInfoList-r16, and so on. Each entry in this list can either be having the value noDisasterRoaming, disasterRelatedIndication, commonPLMNs, or dedicatedPLMNs. If an entry in this list takes the value noDisasterRoaming, disaster inbound roaming is not allowed in this network(s). If an entry in this list takes the value disasterRelatedIndication, the meaning of this field for this network(s) is as specified for \"disaster related indication\" in TS 23.122 [74], clause 4.4.3.1.1. If an entry in this list takes the value commonPLMNs, the PLMN(s) with disaster conditions indicated in the field commonPLMNsWithDisasterCondition apply for this network(s). If an entry in this list contains the value dedicatedPLMNs, the listed PLMN(s) are the PLMN(s) with disaster conditions that the network(s) corresponding to this entry accepts disaster inbound roamers from. For SNPNs, the network indicates the value noDisasterRoaming.","paragraph_zero_based":14052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14053},{"literal_text_all_w_t_and_m_t":"–SIB16","paragraph_zero_based":14054},{"literal_text_all_w_t_and_m_t":"SIB16 contains configurations of slice-based cell reselection information.","paragraph_zero_based":14055},{"literal_text_all_w_t_and_m_t":"SIB16 information element","paragraph_zero_based":14056},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14057},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB16-START","paragraph_zero_based":14058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14059},{"literal_text_all_w_t_and_m_t":"SIB16-r17 ::=                    SEQUENCE {","paragraph_zero_based":14060},{"literal_text_all_w_t_and_m_t":"    freqPriorityListSlicing-r17      FreqPriorityListSlicing-r17              OPTIONAL,  -- Need R","paragraph_zero_based":14061},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension         OCTET STRING                             OPTIONAL,","paragraph_zero_based":14062},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["95a530c408f598b43519b5d4ee6e75e268c4e9e63ed7b86f12fea9ecd37563bb","fcf7f27bfb3a01217ffc40750150ecd54967ab79fd95049f4278e0a28c21f220","9187befad42c1a7fb06e7b95a3231e7146d2b7393387db541b63ec8bd9d5886a","0b195b82c7cfffdafab3d661962dff237a4d9790cfa877a6bbd8c48139ff7d2e","d23727797768a0ef9c829e93760de0e7ec46fa744c1be4220ba6c809b22be25b","4053b9e1dce563841812cbb64552bcc2fb8e3c8fbb5619dc5a60c4c68fb1232d","03254cd5efa0dc598ade0f7c251117161849efb57060894b2807a1181a41e400","b61056eb18357b107806ae22c060de6bb4aceae296e7e01cd1f8c39078195165","de8368178d6d7305931299528a35784671579c5a6c233408b5beef2e49b3fbcf","243535ce35806bf9c20477a776f0ef8174ca8f5646ba1c386cc473da6e9987e7","ce2bd65ac5693adcd0678023e356cef5cba5a121a2be92ce894bdf8058de86db","18709607005856f019e35f2ebaf7974d1bef7650c669499712d3cdc454c1dfed","5fe65af0f5c48dd852e4917c02d55bdbb826d44567b092b394c96c2fadf8bd83","456b8041a3caa209944d3624ec07c06c8c638f627ad2f68b32ee5f4e6abda14f","fb8641f2f5dadc653207d72082aacc639a4f88375ec389f78ffd8ee3e22176f8","4c5af5e6621b990f1e7c663f6f2f1bc28c4850829a36f8bdba78437cbf91bc4a","2046f471035d7e4da309cfcd17200835c7579f738438cbeda02d9f0dbb9fe319","3f94eb98f7c7602d6dc1563b6ec5033c4a0057d543ef023976736339378137ca","df3b54d688ae94c733163050259be4965892e016b375980c32b06ba874c658b3","c24a6c36f16d24b98e71ded574756c4d2806d3a10303527a9e9888d19a6f47e2","b0ad2268eab28e8f3d2bb6297dce7c0be2b39667873d5141acf5c66