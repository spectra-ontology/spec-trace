{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":2352},{"literal_text_all_w_t_and_m_t":"    ehc-Uplink-r16                 SEQUENCE {","paragraph_zero_based":2353},{"literal_text_all_w_t_and_m_t":"        maxCID-EHC-UL-r16              INTEGER (1..32767),","paragraph_zero_based":2354},{"literal_text_all_w_t_and_m_t":"        drb-ContinueEHC-UL-r16         ENUMERATED { true }                                      OPTIONAL,   -- Need N","paragraph_zero_based":2355},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":2356},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL    -- Need M","paragraph_zero_based":2357},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2359},{"literal_text_all_w_t_and_m_t":"UL-DataSplitThreshold ::= ENUMERATED {","paragraph_zero_based":2360},{"literal_text_all_w_t_and_m_t":"                                            b0, b100, b200, b400, b800, b1600, b3200, b6400, b12800, b25600, b51200, b102400, b204800,","paragraph_zero_based":2361},{"literal_text_all_w_t_and_m_t":"                                            b409600, b819200, b1228800, b1638400, b2457600, b3276800, b4096000, b4915200, b5734400,","paragraph_zero_based":2362},{"literal_text_all_w_t_and_m_t":"                                            b6553600, infinity, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":2363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2364},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt-r16 ::= ENUMERATED {ms0dot5, ms1, ms2, ms4, ms6, ms8, spare2, spare1}","paragraph_zero_based":2365},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2366},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt2-r17 ::= ENUMERATED {ms2000, spare3, spare2, spare1}","paragraph_zero_based":2367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2368},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression-r17 ::= CHOICE {","paragraph_zero_based":2369},{"literal_text_all_w_t_and_m_t":"    newSetup                      SEQUENCE {","paragraph_zero_based":2370},{"literal_text_all_w_t_and_m_t":"        bufferSize-r17                ENUMERATED {kbyte2, kbyte4, kbyte8, spare1},","paragraph_zero_based":2371},{"literal_text_all_w_t_and_m_t":"        dictionary-r17                ENUMERATED {sip-SDP, operator}                            OPTIONAL    -- Need N","paragraph_zero_based":2372},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":2373},{"literal_text_all_w_t_and_m_t":"    drb-ContinueUDC           NULL","paragraph_zero_based":2374},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["d867b5924d6074b9fc9e8d2a00f674ac380d92b9ff1adcf82dc1f4507584fee6","34190dc82cadbff6f19f2c769ecd16ab475c3b82096c992fcf383bea52af14e9","70ec46d555a9720aed591aeeb09fda710ec9218765e2088d326bd1f9b96925c5","537fd2276d1d091242a3b105f9f8a58553aac47605da02da6ff8d2eaef7ae274","71b4ab9c66d69acf16a47ebe5dfd6d2b894762c514b31a1da032f6a91ccdcb48","2f3b26d723fb2575a89d53071150243efede09036b2963352dc0757eaa6a9591","8c2326ac393fd26e32d73f2d62895b4cdaba670111efe44a68539fc2dd6c8284","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","ca328da8e4f3138feeb0c45d83333d5abf28d45744e1f5339f70e35385746942","f71b98646b678ed59867f2a87ee4dd9239c69ad5994184ffe2434d9422fcd748","c5cddc27d440d5578e46b2987762a066d643202c89b741d0ec822a541d56d9da","dd77f36fa96beada436f44f898a9eabbf0a95a2a3b5622856f001bdc894f7305","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","9affbf34684f8703c550107663a7d6183337437cfd75b548b09cd2c74cd7a19a","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","887f311770698db28fbcfbd899aa4cfe8a06355cfc3223417ea1ed854ef3d73b","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","750fc767d3f0a1f3d815e9d4df93499b5c2159b8383cf878341498d9ab011035","4a763413e42a7e391e9d32a09af5a78011a52027331cd8eaa61e61431528cbd2","591474632e7ddb9e7188b5b0d0bbe662a89a70acf56fac9120c52b81252076ce","271a13e4ad35c482f35cd8343b5c15b97eca118095d0fe5022e9e31c5a109b50","b4faf019d59238c9aea98044f7861308448cafc64e6d8d13f632eb82adca9fc1","00e390333c3590cdd8df2e166598983e679bb3b8dd08ecc7e9d89d2a123ea5b9","8c2326ac393fd26e32d73f2d62895b4cdaba670111efe44a68539fc2dd6c8284"],"paragraph_range_zero_based":[2352,2375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2352"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2376},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-STOP","paragraph_zero_based":2377},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2379},{"literal_text_all_w_t_and_m_t":"PDCP-Config field descriptions","paragraph_zero_based":2380},{"literal_text_all_w_t_and_m_t":"cipheringDisabled","paragraph_zero_based":2381},{"literal_text_all_w_t_and_m_t":"If included, ciphering is disabled for this DRB regardless of which ciphering algorithm is configured for the SRB/DRBs. The field may only be included if the UE is connected to 5GC. Otherwise the field is absent. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":2382},{"literal_text_all_w_t_and_m_t":"discardTimer","paragraph_zero_based":2383},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms and so on. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":2384},{"literal_text_all_w_t_and_m_t":"discardTimerExt","paragraph_zero_based":2385},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms0dot5 corresponds to 0.5 ms, value ms1 corresponds to 1ms and so on. If this field is present, the field discardTimer is ignored and discardTimerExt is used instead.","paragraph_zero_based":2386},{"literal_text_all_w_t_and_m_t":"discardTimerExt2","paragraph_zero_based":2387},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimerExt specified in TS 38.323 [5]. Value ms2000 corresponds to 2000 ms. If this field is present, the field discardTimer and discardTimerExt are ignored and discardTimerExt2 is used instead.","paragraph_zero_based":2388},{"literal_text_all_w_t_and_m_t":"drb-ContinueROHC","paragraph_zero_based":2389},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the ROHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. This field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated. The network does not include the field if the bearer is configured as DAPS bearer. This field can be configured for both DRB and multicast MRB.","paragraph_zero_based":2390},{"literal_text_all_w_t_and_m_t":"duplicationState","paragraph_zero_based":2391},{"literal_text_all_w_t_and_m_t":"This field indicates the uplink PDCP duplication state for the associated RLC entities at the time of receiving this IE. If set to true, the PDCP duplication state is activated for the associated RLC entity. The index for the indication is determined by ascending order of logical channel ID of all RLC entities other than the primary RLC entity indicated by primaryPath in the order of MCG and SCG, as in clause 6.1.3.32 of TS 38.321 [3]. If the number of associated RLC entities other than the primary RLC entity is two, UE ignores the value in the largest index of this field. If the field is absent, the PDCP duplication states are deactivated for all associated RLC entities. ","paragraph_zero_based":2392},{"literal_text_all_w_t_and_m_t":"ethernetHeaderCompression","paragraph_zero_based":2393},{"literal_text_all_w_t_and_m_t":"This fields configures Ethernet Header Compression. This field can only be configured for a bi-directional DRB or a bi-directional multicast MRB. The network reconfigures ethernetHeaderCompression only upon reconfiguration involving PDCP re-establishment and with neither drb-ContinueEHC-DL nor drb-ContinueEHC-UL configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":2394},{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":2395},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in both uplink and downlink. If uplinkOnlyROHC is configured, the UE shall apply the configured ROHC profile(s) in uplink (there is no header compression in downlink). ROHC can be configured for any bearer type. ROHC and EHC can be both configured simultaneously for a DRB or a multicast MRB. The network reconfigures headerCompression only upon reconfiguration involving PDCP re-establishment or involving PDCP entity reconfiguration to configure DAPS bearer(s), and without any drb-ContinueROHC. Network configures headerCompression to notUsed when outOfOrderDelivery is configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":2396},{"literal_text_all_w_t_and_m_t":"initialRX-DELIV","paragraph_zero_based":2397},{"literal_text_all_w_t_and_m_t":"Indicates the initial value of RX_DELIV during PDCP window initialization for multicast MRB as specified in TS 38.323 [5].","paragraph_zero_based":2398},{"literal_text_all_w_t_and_m_t":"integrityProtection","paragraph_zero_based":2399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","12c50f081881ab8d4988915499cf97b74e6cdf7f76dc5598f1bd9d364d9ff44a","fb4c88e5cf323796a0c3fbca75bf7950204d2c33794e025ca9d253ef27c9b402","b6e3cc714d5465b0b43a134e7df4d529568cacfda75173612e0361e58adc6d48","174f97479af1d212506c6060b13d424af66f03016cf795f1f576b17cdd75ca63","fbfc3c2dc340e17422214e5564d3e7423c87e8216f6698bce2681a9e97a0d25b","83d9ed89f8aae89668db98caf87660f5dd0d8e524f7c8e30514c1af9dbd87ea0","afb5cbb419f3d4af894d0849bf25784e692983e16aa32896912c150c2527f01e","62d0963463c7088ff048dcfd9dd961c864e6d330040dc2d70546bdf0737d41a7","7c349620cf383ea43f8e3df0c77d959882186198dc4df306a84b994ce722edaa","87c0d1cf836230fc8a335e13b978a476d71868990f3d4bc9055d56451ab0319f","d8d3ed9d77bad19dd7d1614012f4119e708295a175037cfd41d64e111e5d8be2","2b5f9315666c6b4929045d899afa7f6fc774438a05525b8a7ed56d32932713ee","f79e214b816fbc4a23d4ac56bf5f67d3c5440cc2c18bab2c187cd8faa6ebdfbc","ea61dd80745ee389526e56ba36731e468e2bb043649820509a67c6b26396f46f","145d19cb5719e1b0d1e4c7c7c9741bd88a8a5f485fb9e81baecda0289d3c73b0","9d73e3b8895a2e6b0cf556b456118227ec92dcabe60cd95bb9023dfe75bb83bc","af7286fabbccc7ecab17c77263de5f92bc5876973efc00676ac4df166ddf3d39","b4b5cd2bca27e2b0fb6ee9a647afaf5b9119212ca1622e6b19a0a41eaad4158c","cb5bcaf9f02c9d6dfe208b71ac0fbaa2554b65dd550ad47aa49f7caef0ba5754","3f64a1f19143f3450fe7109803f4e41f376f20b06b4bc13853ecacc87e4bb373","90b8d1a0c920bece04b6e9d28ac3f2d32c0afc4cff11d5af50c743857f2242fe","e5e7bfe3adb6085f591604c47d5e81dcef1718d55c9e717fc15e148bbbf27dc2","396c1a4c5f46e7e353e87faa08ee51af03d671e9d92275b56df033756be63ced"],"paragraph_range_zero_based":[2376,2399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2376"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not integrity protection is configured for this radio bearer. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":2400},{"literal_text_all_w_t_and_m_t":"maxCID","paragraph_zero_based":2401},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID parameter as specified in TS 38.323 [5].","paragraph_zero_based":2402},{"literal_text_all_w_t_and_m_t":"The total value of MAX_CIDs across all bearers for the UE should be less than or equal to the value of maxNumberROHC-ContextSessions parameter as indicated by the UE.","paragraph_zero_based":2403},{"literal_text_all_w_t_and_m_t":"moreThanOneRLC","paragraph_zero_based":2404},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than one RLC entity is associated with the PDCP entity. This field is not present if the bearer is configured as DAPS bearer.","paragraph_zero_based":2405},{"literal_text_all_w_t_and_m_t":"moreThanTwoRLC-DRB","paragraph_zero_based":2406},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than two RLC entities are associated with the PDCP entity for DRBs.","paragraph_zero_based":2407},{"literal_text_all_w_t_and_m_t":"outOfOrderDelivery","paragraph_zero_based":2408},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":2409},{"literal_text_all_w_t_and_m_t":"pdcp-Duplication","paragraph_zero_based":2410},{"literal_text_all_w_t_and_m_t":"Indicates whether or not uplink duplication status at the time of receiving this IE is configured and activated as specified in TS 38.323 [5]. The presence of this field indicates that duplication is configured. PDCP duplication is not configured for CA packet duplication of LTE RLC bearer. The value of this field, when the field is present, indicates the state of the duplication at the time of receiving this IE. If set to true, duplication is activated. The value of this field is always true, when configured for a SRB. For PDCP entity with more than two associated RLC entities for UL transmission, this field is always present. If the field moreThanTwoRLC-DRB is present, the value of this field is ignored and the state of the duplication is indicated by duplicationState. For PDCP entity with more than two associated RLC entities, only NR RLC bearer is supported.","paragraph_zero_based":2411},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":2412},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for downlink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":2413},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeUL","paragraph_zero_based":2414},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for uplink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":2415},{"literal_text_all_w_t_and_m_t":"primaryPath","paragraph_zero_based":2416},{"literal_text_all_w_t_and_m_t":"Indicates the cell group ID and LCID of the primary RLC entity as specified in TS 38.323 [5], clause 5.2.1 for UL data transmission when more than one RLC entity is associated with the PDCP entity. In this version of the specification, only cell group ID corresponding to MCG is supported for SRBs, except for the split SRB2 of the IAB-MT, and except when the UE is required to set the primaryPath to refer to the SCG as specified in clause 5.7.3b.4. In this last case, if the network sends an RRCReconfiguration message (in NR-DC) or an EUTRA RRCConnectionReconfiguration message (in (NG)EN-DC) keeping SRB1 as split SRB, the network explicitly configures the primaryPath for the PDCP entity of SRB1 to refer to the MCG. In this version of the specification, only cell group ID corresponding to MCG is supported for DRBs when the SCG is deactivated. In MR-DC, the NW indicates cellGroup for split bearers using logical channels in different cell groups. The NW always indicates logicalChannel if CA based PDCP duplication is configured in the cell group indicated by cellGroup of this field. In MP, when the primay path is set to indirect path, the field cellGroup and logicalChannel are absent, and the field primaryPathOnIndirectPath is set to true.","paragraph_zero_based":2417},{"literal_text_all_w_t_and_m_t":"primaryPathOnIndirectPath","paragraph_zero_based":2418},{"literal_text_all_w_t_and_m_t":"Indicates that the primary RLC entity is on indirect path for DRB when MP is configured. ","paragraph_zero_based":2419},{"literal_text_all_w_t_and_m_t":"splitSecondaryPath","paragraph_zero_based":2420},{"literal_text_all_w_t_and_m_t":"Indicates the LCID of the split secondary RLC entity as specified in TS 38.323 [5] for fallback to split bearer operation when UL data transmission with more than two RLC entities is associated with the PDCP entity. This RLC entity belongs to a cell group that is different from the cell group indicated by cellGroup in the field primaryPath.","paragraph_zero_based":2421},{"literal_text_all_w_t_and_m_t":"statusReportRequired","paragraph_zero_based":2422},{"literal_text_all_w_t_and_m_t":"For AM DRBs, AM MRBs and DAPS UM DRBs, indicates whether the DRB or the multicast MRB is configured to send a PDCP status report in the uplink, as specified in TS 38.323 [5]. For DAPS AM DRBs, it also indicates whether the DRB is configured to send a second PDCP status report in the uplink, as specified in TS 38.323 [5].","paragraph_zero_based":2423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["cf46d2ab348c9207b5148f3780191b2b3ff68dda70b4e1b87cbc69f60ef661d0","f0f4d47423eecaad74d313f6a957e7404498576ff3dd43b2d2f7fbf40279f514","275d3d8f0ed6493a93c65dabfae637571b91abec540a89589718f96456d248e9","92fa9ac6352ef3e83e5f2890f642f6782d5edd30ce0c7680ba2cf3d83a67ab0e","2439355b8c31b02666048e6792d46ea24350292d3f78104800f45d9355945640","62549ad097149e049ba1455db62374b97192970549416797dc079a488cb237a5","29e9184d65487a77f16a49a24580499e7113b721e7e66d9adbdaee1a0a0ceaf1","111dbaa1b443f8885b2adb16619fa5b25d3f408c4d0221ef2373e0d6e6ee6dc2","b505095340823c389454538ab0840459cf8b0ee6782585a6aa1d1bdbca45e103","a9e63f8a26f8b70b16ef04cc51208fcc37d56efdb79c67b4956033368104fb75","864aa43e0d5d0e04d7801ea56dd68e79d615b9f36771ac127e1d9d1dafdc33da","0e151fee70c52c30ed9d2893453219cc0f6c2d6b58e5d04dd2dcb0fac488dc15","a9ccb833b42a6523af40e537c6bc90e7c036c3e7c2bfcd5376b4a151bcf93318","f02964dce991c2423a0b705ba9f5789f1cd099e7b66081bccf0b512c4b03258d","53293dba8f5aee2d670f4cc82c6e570e7f95eb98af52aceb20a13c25b42244c4","f9803627226908d2b35690240e2fdd597aa40cf9ce59d219de022be5132f88ae","9bd64ea8432f578c70e8a153d2324916cebedb3bfb07c51e4dbfb9dcba4a3ff1","748eb4c0d8fe67b587be04d6bfbc3b6131e55ec632fa26590c4d3bde30ca73b1","f25c1874860b5c301ca213e71261fed17837efdc981f140d17c1fe929ba486ee","df7162be3c9b96b6aec0aa93777d4e0891fa13104c69dcd39c79d148f28baed7","6c535bf3c69467627fbf20e67599c069d380ecfe6ff87c283198bf3afe6b786b","fff414a450a54ed3b7960069caca4b26f0c73c38834c87096bb2e7ebf6b4b183","ed78784c2b5e23dfc438ad025560add6b10f63ceb2f20b0c5ceae5ae6f538312","14910abdcf26540090dbc264a7104134548309514876349938a1b64771cb1a54"],"paragraph_range_zero_based":[2400,2423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2400"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"survivalTimeStateSupport","paragraph_zero_based":2424},{"literal_text_all_w_t_and_m_t":"Indicates whether the DRB associated with this PDCP entity has survival time state support. If this field is configured to be true, all associated RLC entities are activated for PDCP duplication upon reception of a retransmission grant addressed to CS-RNTI, as specified in TS 38.321 [3].","paragraph_zero_based":2425},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":2426},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms0 corresponds to 0 ms, value ms20 corresponds to 20 ms, value ms40 corresponds to 40 ms, and so on.  When the field is absent the UE applies the value infinity. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":2427},{"literal_text_all_w_t_and_m_t":"ul-DataSplitThreshold","paragraph_zero_based":2428},{"literal_text_all_w_t_and_m_t":"Parameter specified in TS 38.323 [5]. Value b0 corresponds to 0 bytes, value b100 corresponds to 100 bytes, value b200 corresponds to 200 bytes, and so on. The network sets this field to infinity for UEs not supporting splitDRB-withUL-Both-MCG-SCG and when the SCG is deactivated. If the field is absent when the split bearer is configured for the radio bearer first time, then the default value infinity is applied.","paragraph_zero_based":2429},{"literal_text_all_w_t_and_m_t":"uplinkDataCompression","paragraph_zero_based":2430},{"literal_text_all_w_t_and_m_t":"Indicates the UDC configuration that the UE shall apply. Network does not configure uplinkDataCompression for a DRB, if headerCompression or ethernetHeaderCompression is already configured or outOfOrderDelivery or DAPS is configured for the DRB. The maximum number of DRBs where uplinkDataCompression can be applied is two. The network reconfigures uplinkDataCompression only upon reconfiguration involving PDCP re-establishment. If the field is set to drb-ContinueUDC, the PDCP entity continues the uplink data compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is set to drb-ContinueUDC only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":2431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2432},{"literal_text_all_w_t_and_m_t":"EthernetHeaderCompression field descriptions","paragraph_zero_based":2433},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-DL","paragraph_zero_based":2434},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the downlink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":2435},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-UL","paragraph_zero_based":2436},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the uplink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":2437},{"literal_text_all_w_t_and_m_t":"ehc-CID-Length","paragraph_zero_based":2438},{"literal_text_all_w_t_and_m_t":"Indicates the length of the CID field for EHC packet. The value bits7 indicates the length is 7 bits, and the value bits15 indicates the length is 15 bits. Once the field ethernetHeaderCompression-r16 is configured for a DRB or a multicast MRB, the value of the field ehc-CID-Length for this DRB or multicast MRB is not reconfigured to a different value.","paragraph_zero_based":2439},{"literal_text_all_w_t_and_m_t":"ehc-Common","paragraph_zero_based":2440},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for both downlink and uplink.","paragraph_zero_based":2441},{"literal_text_all_w_t_and_m_t":"ehc-Downlink","paragraph_zero_based":2442},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only downlink. If the field is configured, then Ethernet header compression is configured for downlink. Otherwise, it is not configured for downlink.","paragraph_zero_based":2443},{"literal_text_all_w_t_and_m_t":"ehc-Uplink","paragraph_zero_based":2444},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only uplink. If the field is configured, then Ethernet header compression is configured for uplnik. Otherwise, it is not configured for uplink.","paragraph_zero_based":2445},{"literal_text_all_w_t_and_m_t":"maxCID-EHC-UL","paragraph_zero_based":2446},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID_EHC_UL parameter as specified in TS 38.323 [5]. The total value of MAX_CID_EHC_UL across all bearers for the UE should be less than or equal to the value of maxNumberEHC-Contexts parameter as indicated by the UE.","paragraph_zero_based":2447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["6a1b925bd1bc6920f8a884e25683d8e5f2d4cd8ac44f453f3fe502c976d75ce8","16d194759b1f54876a349843f8676986b57a8d3d7f2abc56dc59df9e7111050e","796dfcdb91317d27c890d042b6a8763629dc0f58bb07dd6296cdf46ef0d70490","566cb899071a1f3ae0b082de387727ab89a9e927b3a13fe6d93916dead52b982","857c42047f0b44be51f2acaa94b7e04b6ac51f92a7c30fd4df3d371689038e63","880357d389724860d6373474fb092a0de6bf9ff4efdec09b70ef058c18f96005","9817201f714fa62acd12ef66deb975b0704738994907c119a349be04662fab71","8515a93f318d516aedf223d776113cd538532e4288ffe8d372412becba27abc1","b6e3cc714d5465b0b43a134e7df4d529568cacfda75173612e0361e58adc6d48","01d57550aedd6015d7d1e690f36e9bfbdbf96a869a9b25e7ca2aa1db75e8f356","4df44e2520531a2f817b90c85fce89ae40097779290d149aab19da3e218276c3","0941f0ac903a6dedc43d10ef62b1124c87260cd95aa50b8c5e4c63d48a1f3561","dcb37690f17dc77237d246708e492ac96ea6e116f8d9b2a67aca60c4fb0a4fb8","8958a26d14df8c6030f56279ee4e8dead1bc30dbde468eae778223a14b07dcd1","245606caa972334e28290a528193e503990b1396f249befa5fa0ef0558dd6e13","5d9f47a23d4c79c709150e6a4654eddea946e6b07de760d9b46fba8bd8c40d91","8e773e66b02a9cc237b8d2198fbad5a2781f2559f31964ffc8eeac9938e13402","8d7f1e13c294816198c7a39c1435c662b727d2259d6ecfa1439ff84fd3f786cc","4465277afb25960db5803ed38d8258e6bda6dd66d4df29b494260ba39ff5d3e8","d60407b022a080dee5847b01d0ae896c9577dc913febe39ac706565af094f2ee","c0d4f8107c0119cd131e13b198d533fcb147d1166fd40b8aa15d6c2bc1d1d9c7","3106d7adb64f7d8bc5be5b375b4eb20ce46b037afc58aeeecd1e3aebbbf7e7cc","dd43e918362cfed4e05923e68dd4e88ea47e1666208f2016ac517cb36b71f58a","f4e8961baec668e24f41da7029b6c9c9d3cc6226ac197c117e511810127dcba8"],"paragraph_range_zero_based":[2424,2447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2424"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2448},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression field descriptions","paragraph_zero_based":2449},{"literal_text_all_w_t_and_m_t":"bufferSize","paragraph_zero_based":2450},{"literal_text_all_w_t_and_m_t":"This field indicates the buffer size applied for UDC as specified in TS 38.323 [5]. Value kbyte2 means 2048 bytes, kbyte4 means 4096 bytes and so on.","paragraph_zero_based":2451},{"literal_text_all_w_t_and_m_t":"dictionary","paragraph_zero_based":2452},{"literal_text_all_w_t_and_m_t":"This field indicates which pre-defined dictionary is used for UDC as specified in TS 38.323 [5]. The value sip-SDP means that UE shall prefill the buffer with standard dictionary for SIP and SDP defined in TS 38.323 [5], and the value operator means that UE shall prefill the buffer with operator-defined dictionary.","paragraph_zero_based":2453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2454},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":2455},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2456},{"literal_text_all_w_t_and_m_t":"DRB","paragraph_zero_based":2457},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the corresponding DRB/multicast MRB is being set up, absent for SRBs. Otherwise this field is optionally present, need M.","paragraph_zero_based":2458},{"literal_text_all_w_t_and_m_t":"DRB2","paragraph_zero_based":2459},{"literal_text_all_w_t_and_m_t":"This field is optionally present in case of DRB, need M. Otherwise, it is absent for SRBs and MRBs.","paragraph_zero_based":2460},{"literal_text_all_w_t_and_m_t":"Drb-Duplication","paragraph_zero_based":2461},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent. For DRBs, this field is absent if duplication is not configured. Otherwise, this field is optional, need R.","paragraph_zero_based":2462},{"literal_text_all_w_t_and_m_t":"MoreThanOneRLC","paragraph_zero_based":2463},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer (except for multicast MRB) with more than one associated logical channel and upon RRC reconfiguration with the association of additional logical channels to the PDCP entity.","paragraph_zero_based":2464},{"literal_text_all_w_t_and_m_t":"The field is also mandatory present in case the field moreThanTwoRLC-DRB is included in PDCP-Config.","paragraph_zero_based":2465},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with multiple logical channels, this field is optionally present need M. Otherwise, this field is absent. Need R.","paragraph_zero_based":2466},{"literal_text_all_w_t_and_m_t":"MoreThanTwoRLC-DRB","paragraph_zero_based":2467},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent.","paragraph_zero_based":2468},{"literal_text_all_w_t_and_m_t":"For DRBs, this field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer with more than two associated logical channels and upon RRC reconfiguration with the association of one or more additional logical channel(s) to the PDCP entity so that the PDCP entity has more than two associated logical channels.","paragraph_zero_based":2469},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with more than two logical channels, this field is optionally present, Need M. Otherwise, the field is absent, Need R.","paragraph_zero_based":2470},{"literal_text_all_w_t_and_m_t":"Rlc-AM","paragraph_zero_based":2471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["574b9c2f41fbed1d032b9001bc061989575ec21550f20afd16afc5c883e5d416","fd6f10ac984687da823c29d11ca4d24dc2f460cbaf433753dd1ba589160fc06d","56d5f0cf4ff87f9aef6350ddf27e9c4fe22b2625b51eecaee01df02715543426","608dbfb39253104e12862a981bfe315fbee8bfee3b1b079ccc153c504de3e41a","5b3add95928d8e8acd3a6f15cf01db6e250214a2620099b87acf2a1708503c8c","0c7b82deb183563ca2e3cdd2b2a350432dd709cd28dd07b5481a9fd12e48d2fc","b6e3cc714d5465b0b43a134e7df4d529568cacfda75173612e0361e58adc6d48","99fc61570fe4da163386a4c6a9ada3da761b2c3b07a7960ca5dd572e023a5c6c","fe1872e212f0282f9dd7a6a2406c12c8cd3477224371d1cab1c4f5fd074ab4e2","8c6daad9fa25dc15ae3c33a47bdb8c1bc89c822257ce58c798687283f570de25","be84ef09706cc42cbb0fa1cfc7d69aae7d39c47e453c3a56b3b81efcb120d72b","fe573125630fa7936f15e720513135be035b33e1c46a1f8cb63af8e89aad3e8c","5190d4c58017c9b03d194854ec8749107054972c60796d75dad9b1be2d4fbb6e","b3c740b45c65297762fccf2a89fe1750e11622f9465788f92c6d82cc33465fc2","b74816244bcfa20a821506db1579494d9888b85d6ac2025ecdcdc962b995d6c2","f54dd0c63b62db18e6ddb38d1b4beb3abca0b17588725b072042d9353810415e","92d328c8f7d34ff54657db4e2a983ee39f1248acc6d629ac90d0a9122985fba1","a4538f1410eff3a5ebf87814201c93344c9722df1e20109d16087cd08c42c7e8","7ef0ed047440e2c6c209cd00568ef0cb46f149490954c06f53e6b865fd430b69","27137a0bb5b808a1b05833767c82d2f07490d9a42246ffcb0ec209043c0c77aa","2755dfbf86c04a511e88575687fcbd521e16560766581ace7bb3385fa1ebba1e","68aff1f1f1a96965e16002f52a538c0b6eb64cf0015794c827cbdb0b10c5b953","6db3f618ac705f3da16c85debc01827171b4e6f9783a6a6f4aca115b116aaa83","3b0965e50ba0304a1ec26b4f07067a3911a7a7fe23b8097e7dbad2f569ec1822"],"paragraph_range_zero_based":[2448,2471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2448"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For RLC AM, the field is optionally present, need M. Otherwise, the field is absent.","paragraph_zero_based":2472},{"literal_text_all_w_t_and_m_t":"Rlc-AM-UM","paragraph_zero_based":2473},{"literal_text_all_w_t_and_m_t":"In case of DRB, for RLC UM (if the UE supports DAPS handover) or RLC AM, the field is optionally present, need R. In case of multicast MRB, if multicast MRB is associated with at least one RLC AM entity, the field is optionally present, need R. Otherwise, the field is absent.","paragraph_zero_based":2474},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":2475},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of DRB setup. Otherwise the field is optionally present, need M.","paragraph_zero_based":2476},{"literal_text_all_w_t_and_m_t":"SplitBearer","paragraph_zero_based":2477},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optional present, need M, in case of radio bearer with more than one associated RLC mapped to different cell groups.","paragraph_zero_based":2478},{"literal_text_all_w_t_and_m_t":"SplitBearer2","paragraph_zero_based":2479},{"literal_text_all_w_t_and_m_t":"The field is mandatory present, in case of a split bearer. Otherwise the field is absent.","paragraph_zero_based":2480},{"literal_text_all_w_t_and_m_t":"SplitBearerMP","paragraph_zero_based":2481},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optional present, need M, when MP is configured.","paragraph_zero_based":2482},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC","paragraph_zero_based":2483},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to 5GC. Otherwise the field is absent.","paragraph_zero_based":2484},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC1","paragraph_zero_based":2485},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to NR/5GC or if the UE supports user plane integrity protection when connected to E-UTRA/EPC (as specified in TS 33.401 [30]). Otherwise the field is absent.","paragraph_zero_based":2486},{"literal_text_all_w_t_and_m_t":"Setup1","paragraph_zero_based":2487},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of DRB setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":2488},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":2489},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case for radio bearer setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":2490},{"literal_text_all_w_t_and_m_t":"MRB-Initialization","paragraph_zero_based":2491},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of multicast MRB setup. In case of PDCP re-establishment for multicast MRB, this field is optionally present, Need N. Otherwise, this field is absent, Need N.","paragraph_zero_based":2492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2493},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":2494},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelConfig","paragraph_zero_based":2495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["77cc67487748a361fb8949df97026d34c349f3cf1b74e4410d153baf49745c3a","00a411475747da08fc9b785e041e039a4bcca0bb24fe37ae7e0eeec299d6924b","f2393901c07595deee1cb0b52c9af596f8b64a6b43280c63ce3c1d70d8983287","f8f9f95d33af5a444d20396fb0acec7445b051f58c96a0bf7e5102c9961cc76c","8909a56e9c369dee356bd0e0369c364029262f3fa18bd93497c41924f281f0e0","cd527d9ed27dce886429d883245ab6f22885fa3ea84d9d491bf33d634cf5066c","99a90d32889528011ecd5fdec39d3b9b31b5f004e6905e180a294056e7a66807","e1adaa9631b97eac9488667aad2b2017daca3632cf1ce0ee9e2baff3a0e11416","07e6ca14fb5e3e22c9a5a44a66919612f23554fd852f4ef71e2a401ac37af279","9d61338c388ce991a728edc8ebc8ffd29c46e67347613a48ff9e99dbf826b114","fa862611b7c5cf3921a7270d0e348d885ed530dd72ad0eaa99b30e4cfb3922ad","4042610058f5c80ac09e2f6ed9ba480ec2c11bd4717d75a0507e65787727b9b2","12c86d315bc8fe7f69126ed7a69bd8b2b775810d91fa874bbfae6d6af39f15b3","29fcb6ec1a3bf13f4654dde015e5a499a2fc5639fa309c1eb28b1641f07477c7","44013e0834573ab679587e64c077546bf72d1118ae47326871a75e27772e0f2f","fc0dc5ea96306c9f336bf9c395428b7f4279ed0fc01d413eb7c95c916d3445b1","b9dd95d0b4496e914285bc9c6f399bc52a97b2debde44924377a72bfc1caf1ea","2b9698a98081e02fbb86793667ed8ea7e95496c787fc4687240d21466407a3f3","e325c929f48124a7b05e0e7f81d3327bfcc4b05264a45b3ef04b0f2e652170a1","805eb02099abab279a7d20166461d9a1a13bf3f82c0f6b0a47b09274761920f5","6afeb2284242414fdd91073475cc7ac46617b5670d029a8aa09a7265a41b4d19","bb61b93a0baafdf5c2127327182b5f4db3262d5ac3fe731e12c43862fa78d9cd","f5b0f74158e820b517a401fe83206325edde925ff1ed5d58e19eecb7042d28af","354b99ea9bff4eb25531d085146a84a00ce0646755aeeb7055892b7d6e0fcec0"],"paragraph_range_zero_based":[2472,2495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx:p2472"}
{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelConfig is used to configure an RLC entity, a corresponding logical channel in MAC for Uu Relay RLC channel between L2 U2N Relay UE and network, or between a N3C relay UE and network in case of MP.","paragraph_zero_based":2496},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig information element","paragraph_zero_based":2497},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2498},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELCONFIG-START","paragraph_zero_based":2499},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2500},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig-r17::= SEQUENCE {","paragraph_zero_based":2501},{"literal_text_all_w_t_and_m_t":"    uu-LogicalChannelIdentity-r17    LogicalChannelIdentity                    OPTIONAL,   -- Cond RelayLCH-SetupOnly","paragraph_zero_based":2502},{"literal_text_all_w_t_and_m_t":"    uu-RelayRLC-ChannelID-r17        Uu-RelayRLC-ChannelID-r17,","paragraph_zero_based":2503},{"literal_text_all_w_t_and_m_t":"    reestablishRLC-r17               ENUMERATED {true}                         OPTIONAL,   -- Need N","paragraph_zero_based":2504},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r17                   RLC-Config                                OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":2505},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig-r17     LogicalChannelConfig                      OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":2506},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":2507},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2509},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELCONFIG-STOP","paragraph_zero_based":2510},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2511},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2512},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig field descriptions","paragraph_zero_based":2513},{"literal_text_all_w_t_and_m_t":"uu-LogicalChannelIdentity","paragraph_zero_based":2514},{"literal_text_all_w_t_and_m_t":"Indicates the logical channel id for Uu Relay RLC channel of the L2 U2N Relay UE.","paragraph_zero_based":2515},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelID","paragraph_zero_based":2516},{"literal_text_all_w_t_and_m_t":"Indicates the Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":2517},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":2518},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established.","paragraph_zero_based":2519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["c928f1a3c4fd838a31e8c64a02192b2ed5ec1b4aad36d842db618ca488d01d66","61e17fa5edff7fd61809fc399353912bd185efdc12d3917ff3d74fadb4eeca06","2795241b7847f648ef4a40425da39df5bf1b71e1d5e551c8bb9fac6be30e62cd","9de91fee4868ea617e0a7b4753700fd23fac6eb6bb1724aa801b1f5c7a0d9eb4","37122c096aedd99403ec63c912271c54f431a40a98485a700373acd0d51de27e","85d3469015d473b728c77728dd1468865b834b222e07c7409c30dbff19ec9844","6687d8ddf2c420a9d17401123cf057a5ce07250ee36eeb59673a7f71496f46ad","778c19665ca90f20cd30dfad1ba885743a21f59119948c84c12d6d94f36e5e34","10a6b5716d67054e52b2942278461dc5fca02db8197f9792f6de8c92cdc05a42","0d003ca7c9499d470b7b54d028f791cf98b9edb2e4cba213b4db8c312beb0fbd","ab1f80cf670856b0b461f880c3554