 includes:","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-the radio related information transported in FFSa transparent container between source gNB and target gNB upon inter gNB handover;","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["c7f2b5971a145ac8751aaa78da83aaddd79e0b7ebeab50a73d78d7428eeebd5c","c44df12845b17fb118302e6c32183421d45b34009598bfb238ee733d8cc053c6","867e5cb511577a156e3a18e15cd28d347ea1b97a789657aa23a60e6a490ec434","244ecef025e5092be4965e63ab1f3fbb7adc031d0bd030914f1c2fd96361dd53","7f6c5281cb3ecde7e198fdd3e7c1856fd9c7a0ba4e07d8aab6340ed3f1dd3ff6","a16170a05b3fa21892a4fc1cc6b19060ea68d44809538840a5426ca90efecb04","5eaad387517c7f9e328ddf83db3bc11239374869df5cf7c154cc2a181f8b6ebf","cdd163feede0929b8e780aa78c5c2cee3352ce929bb9c9144dd877d4877718ce","baeeb45e44756d1bfbc5575033e9820bd05b771d00482f24b15ee001d3e86c95","65bc976a11b63d44b5681e1144cd6b77879a98fe0dd5400f5de1a08df5b5d453","a2e37a04948be150feb604b64c70bc13c6c9991f29ad24fdafb3590732977685","38fe7c0e93d23f6b18098980e440dd955b60f092a6592f1b4c8fcea55c07fd92","8ff21adc5099f6d14eed6ba3b4bd76ab548d3d68c9c1bdbb60dc0117996078fe","1f191e185b06f2e40bac1a454481f3ca06da5e06cabe182f08eed172643ade5a","fe309a9d18be3e4609b0494d5f9c1a89cdaef87ee3b87b03ed11d670b8cb6bf7","2ae4b10c51960ea0da85532590d36afc3eb44d425e824c362e96e0ca05e0f15f","5e3325cfa81aa4f2854170fa78b20942d7c781d6d0988761579d97fb326e1d9b","b664a45620e5a1a3e6c0d37f9154242fc283be95eb830c2e9bc71410e247f5ef","1ad8fbfb95cb64b0c27bb9d695dc65733ff7a4e0d5b42353dc0b25d5eb5b94c6","47bef823247ce009e5dfa3b29c4feece369bbe73a8793f7e8a50e9cf7ba0bee0","03c045cae0bc5a4add73cd8467d6ac654dac9d2cb3844b2575e8c61619526a24","dc85f