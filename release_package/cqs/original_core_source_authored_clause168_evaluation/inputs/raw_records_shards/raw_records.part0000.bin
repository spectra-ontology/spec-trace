{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SL-DRX-Config","paragraph_zero_based":37896},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-Config is used to configure DRX related parameters for NR sidelink communication/discovery. The SL DRX timers should be calculated in the unit of physical slot.","paragraph_zero_based":37897},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config information element","paragraph_zero_based":37898},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37899},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIG-START","paragraph_zero_based":37900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37901},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":37902},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigGC-BC-r17                     SL-DRX-ConfigGC-BC-r17                                                 OPTIONAL,     -- Cond HO","paragraph_zero_based":37903},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-ToReleaseList-r17          SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIndex-r16     OPTIONAL,     -- Need N","paragraph_zero_based":37904},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-ToAddModList-r17           SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DRX-ConfigUC-Info-r17    OPTIONAL,     -- Need N","paragraph_zero_based":37905},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37906},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37908},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC-Info-r17 ::=               SEQUENCE {","paragraph_zero_based":37909},{"literal_text_all_w_t_and_m_t":"    sl-DestinationIndex-r17                    SL-DestinationIndex-r16                                                OPTIONAL,     -- Need N","paragraph_zero_based":37910},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-r17                        SL-DRX-ConfigUC-r17                                                    OPTIONAL,     -- Need N","paragraph_zero_based":37911},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37912},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37914},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIG-STOP","paragraph_zero_based":37915},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37918},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config field descriptions","paragraph_zero_based":37919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["be19d800701fc43999bd08b44be750e8e48af8a02a303d507594a3ba3a1ccddc","ae85abe9710756ceaf3e374cb8275997023bd0572ce9f2381c2b3b99c78a65b4","f43afbd2894124ca12dbabaf2c70048f2f50b477675286ffe8556fb03cad148f","5461543d15136c601bc64b17e2b1de9a3043955f64861975637aacdfeda1fdad","15d113c0ccd087f8a579a5b2a0683ad9cf0203d26781e429be99ac69e1fdd682","9da2cd37cf523e560dcca2699bfa01229f98a5db1f2b7836f4ce5a0fdebe8ad3","5b2b2f6d6bc2932822e2023b9ae6b27db9555539db0a7ea89a8b59b271b38873","bfa581551d80058b59df3ed53254e00e8eb8770f8000eafbfb817c9195179134","0d6a212686af2c29545b1a5f153b27d355a7843fe1c24970cd04fc77058ecd3d","232bf9ce887aeda7c72dd03aeba464d32b6c0c598de3e2c72c8ee803e10a5478","6ac23a2889b7d862a05ecbf4a7f66fbc6544dfcdcfb9a503d433df4bf79b6c98","e63137e638df500dc