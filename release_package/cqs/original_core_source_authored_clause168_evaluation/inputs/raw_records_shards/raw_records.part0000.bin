{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23976},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sSCell-r17                             INTEGER (1..15)                         OPTIONAL,  -- Need R","paragraph_zero_based":23977},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sScellSecondaryPUCCHgroup-r17          INTEGER (1..15)                         OPTIONAL   -- Cond twoPUCCHgroup","paragraph_zero_based":23978},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23979},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23980},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23981},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":23982},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23984},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig field descriptions","paragraph_zero_based":23985},{"literal_text_all_w_t_and_m_t":"tpc-IndexPCell","paragraph_zero_based":23986},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the SpCell) inside the DCI format 2-2 payload.","paragraph_zero_based":23987},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-SCell","paragraph_zero_based":23988},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the PUCCH SCell) inside the DCI format 2-2 payload.","paragraph_zero_based":23989},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-sSCell, tpc-IndexPUCCH-sSCellSecondaryPUCCHgroup","paragraph_zero_based":23990},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the alternative PUCCH cell for PUCCH cell switching) inside the DCI format 2-2 payload, for the primary PUCCH group and the secondary PUCCH group respectively.","paragraph_zero_based":23991},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23992},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23993},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23994},{"literal_text_all_w_t_and_m_t":"PDCCH-OfSpcell","paragraph_zero_based":23995},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell. Otherwise, the field is absent, Need R.","paragraph_zero_based":23996},{"literal_text_all_w_t_and_m_t":"PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":23997},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the PUCCH-SCell.","paragraph_zero_based":23998},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is configured with a PUCCH SCell in this cell group and if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell.","paragraph_zero_based":23999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["23b2da00a2bad53c79b61aaba16aef464c95911dd0a021c79350c8aaf7415540","bdd66b72b0443bc1cbd5788db4df3aff34de7a30994a24e1b78f3cf706765ac5","83bbf08ce63b2aeed21353e66aa9dbef0319abc94837686ce32a7d07bec3ac2c","a9745c8ce93e2cfdf1db9819caf7c82f1cfab8f03c04f8506ee7616a65c435c2","59fcfd60b246f829102bc91c57e56e879581882541d9f32fd189d2ffb7527e75","53207367657a280f4e915487e98998bf1fcf5ac0160d70407e0d22edf8ffcfde","68634ca7ab87f330e817ba2d8c6e5978a707be39fc