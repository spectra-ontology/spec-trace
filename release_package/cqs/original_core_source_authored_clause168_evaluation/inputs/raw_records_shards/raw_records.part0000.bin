{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the target NR bands that the UE is requested to report the gap requirement information.","paragraph_zero_based":21216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21217},{"literal_text_all_w_t_and_m_t":"–NeedForGapsInfoNR","paragraph_zero_based":21218},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsInfoNR indicates whether measurement gap is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":21219},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR information element","paragraph_zero_based":21220},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21221},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-START","paragraph_zero_based":21222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21223},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR-r16 ::=        SEQUENCE {","paragraph_zero_based":21224},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForGap-r16      NeedForGapsIntraFreqList-r16,","paragraph_zero_based":21225},{"literal_text_all_w_t_and_m_t":"    interFreq-needForGap-r16      NeedForGapsBandListNR-r16","paragraph_zero_based":21226},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21228},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreqList-r16 ::=          SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForGapsIntraFreq-r16","paragraph_zero_based":21229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21230},{"literal_text_all_w_t_and_m_t":"NeedForGapsBandListNR-r16 ::=             SEQUENCE (SIZE (1..maxBands)) OF NeedForGapsNR-r16","paragraph_zero_based":21231},{"literal_text_all_w_t_and_m_t":"","paragrap