{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23328},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23329},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":23330},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23332},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":23333},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":23334},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20]. This field is ignored by IAB-MT.","paragraph_zero_based":23335},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":23336},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity.","paragraph_zero_based":23337},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":23338},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":23339},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":23340},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs. The absence of the field indicates that the cell only supports PSCell/SCell functionality (per PLMN) or is an NTN cell.","paragraph_zero_based":23341},{"literal_text_all_w_t_and_m_t":"trackingAreaList","paragraph_zero_based":23342},{"literal_text_all_w_t_and_m_t":"List of Tracking Areas to which the cell indicated by cellIdentity field belongs. If this field is present, network does not configure trackingAreaCode. Total number of different TACs across different PLMN-IdentityInfos shall not exceed maxTAC. This field is only present in an NTN cell.","paragraph_zero_based":23343},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23344},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityList2","paragraph_zero_based":23345},{"literal_text_all_w_t_and_m_t":"Includes a list of PLMN identities.","paragraph_zero_based":23346},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2 information element","paragraph_zero_based":23347},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23348},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-START","paragraph_zero_based":23349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23350},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2-r16 ::= SEQUENCE (SIZE (1..16)) OF PLMN-Identity","paragraph_zero_based":23351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["599903a6b719326695cb56cb55d7579ad6ffb75ff8513a3bbcebb96048264e16","b854e97474ab19ba25f410d97e606320089d06c831bc5c1e296c5940b675685a","6fb526054cbbb2d7ce62248717fb399d5e6e729c9ac32017a4fa139e29659a46","6667c8749fa39ac11bdbd0a58f75f57175fc61412b992b0cfbf86b3049318c52","151414a72237521b390c46eaa4ec8215c9ad8cadafb469f258d602331cf8e35c","02eac4ded31b688ae3ef2c3856a45494ba632378415eca4ec3956f06287ee450","36377bbf57a089902db4365cde29e096501248285cf501e7500300c90cc4cad8","e886e67dad46bd85e7863d02eeee613d74060aab9d90fcbd14fb99fdf437b597","81ddf6fb476