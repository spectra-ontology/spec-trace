{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15985},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-NR-STOP","paragraph_zero_based":15986},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15988},{"literal_text_all_w_t_and_m_t":"CGI-InfoNR field descriptions","paragraph_zero_based":15989},{"literal_text_all_w_t_and_m_t":"noSIB1","paragraph_zero_based":15990},{"literal_text_all_w_t_and_m_t":"Contains ssb-SubcarrierOffset and pdcch-ConfigSIB1 fields acquired by the UE from MIB of the cell for which report CGI procedure was requested by the network in case SIB1 was not broadcast by the cell.","paragraph_zero_based":15991},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":15992},{"literal_text_all_w_t_and_m_t":"Contains cellReservedForOtherUse field acquired by the UE that supports nr-CGI-Reporting-NPN from SIB1 of the cell for which report CGI procedure was requested by the network.","paragraph_zero_based":15993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15994},{"literal_text_all_w_t_and_m_t":"–CGI-Info-Logging","paragraph_zero_based":15995},{"literal_text_all_w_t_and_m_t":"The IE CGI-Info-Logging indicates the NR Cell Global Identifier (NCGI) for logging purposes (e.g. RLF report), the globally unique identity, and the TAC information of a cell in NR.","paragraph_zero_based":15996},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging information element","paragraph_zero_based":15997},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15998},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-START","paragraph_zero_based":15999},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16000},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging-r16 ::=     SEQUENCE {","paragraph_zero_based":16001},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r16                    PLMN-Identity,","paragraph_zero_based":16002},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                     CellIdentity,","paragraph_zero_based":16003},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16                 TrackingAreaCode               OPTIONAL","paragraph_zero_based":16004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16006},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-STOP","paragraph_zero_based":16007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ad200744c2ffc23d2e878a90a1d9abfe90b6e2ec4c38cb0b8d26a02722601dac","6c515b5e7426ef8949235fe35d2504a12d78c60b14372da77ef2e4c9224b06c4","b348bea7ef88e4d329347766db0ca55f0a1cd4fdde39a88f905a50a5ded35058","924e67a88d1a67a8335848b15a514246d8e85fa337f72e8d95ea924e1247a471","460d6110bdaa923935fdf9c445d5510d29ed6225e9fc442b4e1dbdac565f434f","fdb770eb1cee330bee8cab0ac1c8e8c706b1b15d8365a7e3e8476ae9742cd774","30d40efd34a5a61fc0698f24792892004788369f900f9eb5559ae7f5d7ba8900","fcfcaa46691b4b5adce529d06e1e25e26cc0b64586f1c9bf1902a15b1350f4c1","431a3af6be988f62b02bdb2db709dd91da25b68af441b4660af9944ed132e40e","01cb8b980240ddadfa1d193ab9d5d82b066d84ad48dd1c7a1360c76baf5b36e4","32a62a6e1ffc0a86ea941405bd50b9d91240bcb5c5035702d8b901ec099872fa","80bc6114016208cb3950415bb83fe819c5b8cd8ee90098317a92307ace95c408","f095ef8e01af0dfb4c1f211649fe731da9f4bf0c75ec3a0d99c0f34f54ef360d","526b7962992391d005b6c009a5df5476d4b9b