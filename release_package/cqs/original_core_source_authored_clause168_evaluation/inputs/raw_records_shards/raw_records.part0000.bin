{"fields":{"filename":"R2-2301347.zip::R2-2301347.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impact analysis:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"GNSS positioning using posSIB for assistance data","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR while the network is not, there is no inter-operability issue (although the “Consequences if not approved” may occur).","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR while the UE is not, the network will not send an inconsistent posSIB and there is no inter-operability issue.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"6.3.1a","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":93},{"literal_text_all_w_t_a