1226},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":41227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41228},{"literal_text_all_w_t_and_m_t":"7Variables and constants","paragraph_zero_based":41229},{"literal_text_all_w_t_and_m_t":"7.1Timers","paragraph_zero_based":41230},{"literal_text_all_w_t_and_m_t":"7.1.1Timers (Informative)","paragraph_zero_based":41231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2998268524e9dc4ace152131dec92c7a503188261e2a2138d1b33aa5e5743ddd","86d9b49e7176312b1d5070682af6a199516fbcc360c1a3933d3bbdff4852aeb3","ad98e725ed93ee8e718c805a9f5c390a5e98b3b2361eb0933082efa81a215b3f","8ca4250c8d8558a03f6a9cba637381b578a8190df135098201bc33b4e3b68835","e57afe7b332e99f0fa2d5de7194a54f133dd9b30f24948c36e58f750c81c0fec","0aee8d10bf8e794129ceacc1667adfd3ab3f16aa8506b42de3bfca57909a0fae","967fac00b76ecc600aa35906897aecaea2b207591f34e23728760fe6af11f6cf","958c48245aea2da7bf99a3e1bfa6ac52b0adcc325eba094ccd02fc616327d408","8c648697346c9c992725ceafd9da3ed154b7f55824153839144c899679b2aeef","eeee8268532d5fb51974a5393946840dba0a8032676d73af7f92b5fa956bf9be","ca2b747148e8842d3c12b5bab2578002d644d3d6001b7038f0438c591414bd90","550c372357d91f2338fae814600b4a8edbf443e7438f31740d5dcf61e6036724","f6a5a7037cf91ca314a7aa11f6620e50d68f8ffc613c4c5fae107f79e78897d1","8237fd9e35d1ae5b9f3e7ae5ce53770244275818175fdc76ff1c779d015887f8","a035c3b7b4613deb5297a49399fba55249cab574f3937d705c9796c37d356f00","09375baa4d1eea5bebbdb697ea5d15a2cd837302386646f806ca9746c6f9f298","cbacae30e6e977498f91e5ff77d21f542fac39ec7e23d514c94894241dffb2a8","989102a29b8810b4195de6cdf280b5e97e576eee3a2d1809ad7b97cf90529611","e21050d18346b442895dd2de03600c96ddaf5c87f4b4778ae455b7bad229f839","96f5fb2914a236f5048ebb11d5fc90cc5f0d8e827f49e145a7bb0162d30b1b40","b09c7d68f09a9a01aa87c3b383c6df1072b021ebb208d28d47dde5ab71e51332","506ab1a8f2316154ad49902c33b158319f9552ff732c44860b9cbd047c6a0476","d8cb7714aa3305e6f8347a1963a70b7aad735c75282b5c80592045098fd995c3","ff7dacc1879e3e33fa3c2c814a3c2ce605b2d7663c926d33c36d6cf7aabbf6d2"],"paragraph_range_zero_based":[41208,41231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p41208"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Timer","paragraph_zero_based":41232},{"literal_text_all_w_t_and_m_t":"Start","paragraph_zero_based":41233},{"literal_text_all_w_t_and_m_t":"Stop","paragraph_zero_based":41234},{"literal_text_all_w_t_and_m_t":"At expiry","paragraph_zero_based":41235},{"literal_text_all_w_t_and_m_t":"T300","paragraph_zero_based":41236},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCSetupRequest.","paragraph_zero_based":41237},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCSetup or RRCReject message, cell re-selection, relay reselection, and upon abortion of connection establishment by upper layers.","paragraph_zero_based":41238},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.3.7. ","paragraph_zero_based":41239},{"literal_text_all_w_t_and_m_t":"T301","paragraph_zero_based":41240},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCReestabilshmentRequest","paragraph_zero_based":41241},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReestablishment or RRCSetup message as well as when the selected cell becomes unsuitable or the (re)selected L2 U2N Relay UE becomes unsuitable, upon reception of notificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection.","paragraph_zero_based":41242},{"literal_text_all_w_t_and_m_t":"Go to RRC_IDLE","paragraph_zero_based":41243},{"literal_text_all_w_t_and_m_t":"T302","paragraph_zero_based":41244},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReject while performing RRC connection establishment or resume, upon reception of RRCRelease with waitTime.","paragraph_zero_based":41245},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED or RRC_IDLE, upon cell re-selection, upon cell change due to relay (re)selection, and upon reception of RRCReject message.","paragraph_zero_based":41246},{"literal_text_all_w_t_and_m_t":"Inform upper layers about barring alleviation as specified in 5.3.14.4","paragraph_zero_based":41247},{"literal_text_all_w_t_and_m_t":"T304","paragraph_zero_based":41248},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReconfiguration message including reconfigurationWithSync for the MCG which does not include sl-PathSwitchConfig, or upon reception of RRCReconfiguration message including reconfigurationWithSync for the SCG not indicated as deactivated in the NR or E-UTRA message containing the RRCReconfiguration message or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync.","paragraph_zero_based":41249},{"literal_text_all_w_t_and_m_t":"Upon successful completion of random access on the corresponding SpCell","paragraph_zero_based":41250},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, upon SCG release","paragraph_zero_based":41251},{"literal_text_all_w_t_and_m_t":"For T304 of MCG, in case of the handover from NR or intra-NR handover, or path switch from a L2 U2N Relay UE to a NR cell, initiate the RRC re-establishment procedure; In case of handover to NR, perform the actions defined in the specifications applicable for the source RAT. If any DAPS bearer is configured and if there is no RLF in source PCell, initiate the failure information procedure.","paragraph_zero_based":41252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41253},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, inform network about the reconfiguration with sync failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":41254},{"literal_text_all_w_t_and_m_t":"T310","paragraph_zero_based":41255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["14831b3255d24d13184d1efd28b1cc8f077876f5a77f162ce8b71d254a9e15f6","d0b3db03ec38ca0ed759fbcb6480ade651edf317d30a0ec553515e6fb317dcca","dae131c3f060027d9b510e6652ae913e97360e3923624d51f08c19f8bffc8f7a","5319996a2ce099c647ff1db312782b07b7fd9e5420e3a919027d8211101899bc","fbd91f9f42108250aeaf14fe17771af6b3913cdfc15e72f3afbc5d91362c347e","3c26cea7fb931b1f1f51d4a2c742577b34a1949453a7ec60b2af25041ba9f152","8bc8a2e34897046469fbf580688e5e0b393dd2343b9ebb7ebb782f6778478c00","6b5d3ed112e6bb08d70c533ae9c34c0f8f826af87e39df4ad126ded89d0369c9","a79125c377847d5f858ef0bf2efca7157dcd9e35e22d023adf9ab8cc3ae8059c","f38deaaa08129f4c03ca8bfbf310508002c1d9de64cff404d9148d8e42612aa1","630abf01fa054401607f4a2f5c5a93634a6b16b3ef3b95627d5693faa8d655f9","2373858e1f0d5422b9b60b093804f59d2d87668a6b7a08db4bc2647bc947d80b","f6781c01a4f0cecea35da31ba5b1c0b72d4c5f2ff558c11f85935a55091e73a9","085cfea7742ade4c38de3fe4dfe36deb60360d94a810f7417e9ba79423ab9f36","08e3dc8028abf146fd4963adec05d888bbde1e212471d0f211f91669ca8f253e","ba4c0d1a8d5b06f7dc18a09caa848238c34454852d643a9a556ffd3ab8d0353d","68ccea934e19d0a78fe9294ee742a3736a402c41455ba1c74cefd33c36e1e467","dbc4ef551626072927a813b755edb10e8848a523b423847dfdb0ed592ab6abd6","b9e98b6fb0489ef2155fee84a3b88da6b3cb3ac5adfee87a30836c38bf5a2a97","43e18386e238d2be7da303fad4190b4ccc6e1f39f28d2dffb1c962fc7a638fc7","7d86d0bce9d6fd24f476ae8ec867ca6a6e8eed3a495f46c06b315df56ba189db","af20000dd56466b8a963993254f605e0477c475b4b74b10491f01325ac985066","cbe8664e66087a1ca5296ca8a8c62383c35b845c0646a091219c1535601e31f7","7d7540040a909a6559f241d9a565da2dc0812c00a04be04b955d7ca3d6c926fd"],"paragraph_range_zero_based":[41232,41255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p41232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon detecting physical layer problems for the SpCell i.e. upon receiving N310 consecutive out-of-sync indications from lower layers.","paragraph_zero_based":41256},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the connection re-establishment procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon initiating the MCG failure information procedure.","paragraph_zero_based":41257},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T310 is kept in SCG.","paragraph_zero_based":41258},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in MCG: If AS security is not activated: go to RRC_IDLE else: initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure as specified in 5.3.7 or the procedure as specified in 5.3.10.3 if any DAPS bearer is configured.","paragraph_zero_based":41259},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":41260},{"literal_text_all_w_t_and_m_t":"T311","paragraph_zero_based":41261},{"literal_text_all_w_t_and_m_t":"Upon initiating the RRC connection re-establishment procedure","paragraph_zero_based":41262},{"literal_text_all_w_t_and_m_t":"Upon selection of a suitable NR cell, or upon selection of a suitable L2 U2N Relay UE, or a cell using another RAT.","paragraph_zero_based":41263},{"literal_text_all_w_t_and_m_t":"Enter RRC_IDLE","paragraph_zero_based":41264},{"literal_text_all_w_t_and_m_t":"T312","paragraph_zero_based":41265},{"literal_text_all_w_t_and_m_t":"If T312 is configured in MCG: Upon triggering a measurement report for a measurement identity for which T312 has been configured and useT312 has been set to true, while T310 in PCell is running.","paragraph_zero_based":41266},{"literal_text_all_w_t_and_m_t":"If T312 is configured in SCG and useT312 has been set to true: Upon triggering a measurement report for a measurement identity for which T312 has been configured, while T310 in PSCell is running.","paragraph_zero_based":41267},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon initiating the connection re-establishment procedure, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the MCG failure information procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon the expiry of T310 in corresponding SpCell.","paragraph_zero_based":41268},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T312 is kept in SCG","paragraph_zero_based":41269},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in MCG initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure.","paragraph_zero_based":41270},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure.as specified in 5.7.3.","paragraph_zero_based":41271},{"literal_text_all_w_t_and_m_t":"T316","paragraph_zero_based":41272},{"literal_text_all_w_t_and_m_t":"Upon transmission of the MCGFailureInformation message","paragraph_zero_based":41273},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease,  RRCReconfiguration with reconfigurationwithSync for the PCell, MobilityFromNRCommand, or upon initiating the re-establishment procedure","paragraph_zero_based":41274},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.3b.5.","paragraph_zero_based":41275},{"literal_text_all_w_t_and_m_t":"T319","paragraph_zero_based":41276},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is not initiated for SDT.","paragraph_zero_based":41277},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCRelease with suspendConfig or RRCReject message, upon cell re-selection or upon relay (re)selection.","paragraph_zero_based":41278},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":41279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6916610f894f8d83bfcf9dfea22a2bf8f2df83275668ab907f45c58cbf037dad","edc95730590fb11d537f13083c8d622c73218876c1962bc9364f39f1f31e6fa3","80449f450a94268d29e5fc67916496ecfca502db6bc83fa11306f7f0cba774e8","8b1707a3e0ff6cf96147bc6b316c2006d51a83cb547763d181354662a5152b7c","76452f599f9bcb6a9fbab18189701b93c02e92f50c110f9f99bf58d9357b6da2","527564fed9e6a9daee93c9d50eb817e3119b39960a19fa3ce6d7c193da986dc0","b6918b9f5881c356ee765890fcc25128193a63d4735b4d41fdc7fc0625f14a4b","020a1a6495d63c76fe7b50a798873fcee34c93e9225b461a503b6c79e23b4142","94e2ce2d47206e8eb18a9acb3b451d97370925e8bfd2b29f09cb81885fcc51ab","1c229bc6d69ebdfd9f1d66eeca19fd5f28b116759ed71360727f7db93d84ed03","8