{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25248},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATIONFORSLICING-START","paragraph_zero_based":25249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25250},{"literal_text_all_w_t_and_m_t":"RA-PrioritizationForSlicing-r17 ::=    SEQUENCE {","paragraph_zero_based":25251},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationSliceInfoList-r17     RA-PrioritizationSliceInfoList-r17,","paragraph_zero_based":25252},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25253},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25255},{"literal_text_all_w_t_and_m_t":"RA-PrioritizationSliceInfoList-r17 ::= SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF RA-PrioritizationSliceInfo-r17","paragraph_zero_based":25256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25257},{"literal_text_all_w_t_and_m_t":"RA-PrioritizationSliceInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":25258},{"literal_text_all_w_t_and_m_t":"    nsag-ID-List-r17                       SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF NSAG-ID-r17,","paragraph_zero_based":25259},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization-r17                  RA-Prioritization,","paragraph_zero_based":25260},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25261},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25263},{"literal_text_all_w_t_and_m_t":"-- TAG-RA-PRIORITIZATIONFORSLICING-STOP","paragraph_zero_based":25264},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25266},{"literal_text_all_w_t_and_m_t":"–RadioBearerConfig","paragraph_zero_based":25267},{"literal_text_all_w_t_and_m_t":"The IE RadioBearerConfig is used to add, modify and release signalling, multicast MRBs and/or data radio bearers. Specifically, this IE carries the parameters for PDCP and, if applicable, SDAP entities for the radio bearers.","paragraph_zero_based":25268},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig information element","paragraph_zero_based":25269},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25270},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-START","paragraph_zero_based":25271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["21495c4198efa06800696487d996e183b5daea023fe522e8afc269c138dcebd3","15fbca7eaa198c537f9fb9d84faf49da0cb215214175cef875063e930028f9df","42673a6ccecda5c9032d13f255d0068f6d7ff78d2aa3aa7bca551c2323f156ad","14e162e171d76dd6691c57ca26ae61f600e2a5c9ab06a75d1f702cbe8000b9ca","a3b1c6d9bad5302d39a62eb59315c13c387f68fd633362649f22f05488da61f0","5ca0f22b6cc677951abb23829906086288029e0289c75a862fdc1892049a48fc","deea01f90338ad6b789c8e6dc7aa89df95c22bf2e030226bcb9d12071ad43c08","f0aef694115b4bada34719b099c16438a039c6246764aac21446d5bacc3181c0","d415a40ad3aab5d5ed468ea925abc6136da21486bd2d0c59fbbb3e15118e7650","e9966c2b816ded922ab696ba3466f34af654f8e15647411093babcf786abe151","9ee517ecbbbe6b31249d1f1a687e530ab0f8ac4303f93c2423ed2c09de8b175a","96449ba8117a3758b4e709b4b43db0a30d0f12e41b8abec2d6678ae1ec8992d8","197af54fd7d1a43427fc7370acee4fc047d312bccb08ff1a690e4dcb3696d85f","794fd5e816c2225b305623a17b385148892be89a1b7869809fdfe0844e8ec467","3892d9f57ee8be2affa5ed99fe4764cdef1f535bfb6e64a47c845b318dfc3d17","3d54a680029ff2d691609d