{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    supportedBandCombinationList-v15g0             BandCombinationList-v15g0        OPTIONAL,","paragraph_zero_based":35520},{"literal_text_all_w_t_and_m_t":"    supportedBandCombinationListNEDC-Only-v15g0    BandCombinationList-v15g0        OPTIONAL","paragraph_zero_based":35521},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35523},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC-v15n0 ::=                     SEQUENCE {","paragraph_zero_based":35524},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-v15n0                  BandCombinationList-v15n0                       OPTIONAL","paragraph_zero_based":35525},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35526},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35527},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC-v16e0 ::=                     SEQUENCE {","paragraph_zero_based":35528},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch-v16e0   BandCombinationList-UplinkTxSwitch-v16e0        OPTIONAL","paragraph_zero_based":35529},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35531},{"literal_text_all_w_t_and_m_t":"-- TAG-RF-PARAMETERSMRDC-STOP","paragraph_zero_based":35532},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35534},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC field descriptions","paragraph_zero_based":35535},{"literal_text_all_w_t_and_m_t":"appliedFreqBandListFilter","paragraph_zero_based":35536},{"literal_text_all_w_t_and_m_t":"In this field the UE mirrors the FreqBandList that the NW provided in the capability enquiry, if any. The UE filtered the band combinations in the supportedBandCombinationList in accordance with this appliedFreqBandListFilter.","paragraph_zero_based":35537},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList","paragraph_zero_based":35538},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for (NG)EN-DC, or both (NG)EN-DC and NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35539},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListNEDC-Only, supportedBandCombinationListNEDC-Only-v1610","paragraph_zero_based":35540},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports only for NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35541},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":35542},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic UL Tx switching for (NG)EN-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":35543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c6beb9103955473f1038fbfc0fc804196518415c2c2217d927c1274fbf4be173","b321da61a2d46744ddd893c61b36135d9f3f1f80fc5d9d96183a3b22a86304d5","970896020fbd317599d13dbcc598267f5fd780a5aee549a3643678ce4ec1a3e4","aab7fe1efa79