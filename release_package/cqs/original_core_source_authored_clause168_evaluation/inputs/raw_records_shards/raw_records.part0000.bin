ces-1-r16)","paragraph_zero_based":19768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19769},{"literal_text_all_w_t_and_m_t":"RSSI-PeriodicityAndOffset-r16 ::=   CHOICE {","paragraph_zero_based":19770},{"literal_text_all_w_t_and_m_t":"    sl10                                INTEGER(0..9),","paragraph_zero_based":19771},{"literal_text_all_w_t_and_m_t":"    sl20                                INTEGER(0..19),","paragraph_zero_based":19772},{"literal_text_all_w_t_and_m_t":"    sl40                                INTEGER(0..39),","paragraph_zero_based":19773},{"literal_text_all_w_t_and_m_t":"    sl80                                INTEGER(0..79),","paragraph_zero_based":19774},{"literal_text_all_w_t_and_m_t":"    sl160                               INTEGER(0..159),","paragraph_zero_based":19775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8b05cd25625b841004c792e78ce501c1d8d24678276fdeb30c65f123ecef0f8f","9ff17bf4f287ba69a063f150bd2a35916a2feb09f3e350802f75d4777a2e3b1e","59e35b718103d98b75ff83078de0ed334518166c0a0abc9d8277a5f63e76d389","67fbae1870b2ec4a1772dec4b6b4f437d37321db74ff5ba2ef9a47623d1ddf08","a33dd4dff71ccbb7a23d3ef71e5fcc4fca6c9f0fd9b58aaba66f5877d90bb7a4","d369ca569242c8011bf5a3eec3be69551eb25d347acaeff8596d607e3804e285","299ad6f3d7fde78102d769fca0d3b96a3d8e51f686231e6e22ec5891609e5a9e","5e898f7753f40cb200aa6326b60aed2f45313afffd9e345cc385484251ba4c63","0600febeab25d856dc76245a509956b812c5304ffe62b3282adad72e79323ac3","0f400551c7c767daf861b1c764458b891360e662a1f98fbb47a17f2583f8a310","2791b396a7fdb7db4f92cba6b9c5bccb63921470e360e176b048098ba47e982a","76806dfcb389d72a7c161caf4f71ecc95808e8b97b36604dba6b5900637bc3c2","9e1146b36e27696022a528578e