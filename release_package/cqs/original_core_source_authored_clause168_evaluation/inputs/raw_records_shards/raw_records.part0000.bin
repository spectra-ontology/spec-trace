old-r16                          ENUMERATED { t1, t2, t3, t4, t6, t8, t16, t32 },","paragraph_zero_based":39400},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39401},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39402},{"literal_text_all_w_t_and_m_t":"    sl-UM-RLC-r16                                SEQUENCE {","paragraph_zero_based":39403},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthUM-r16                      SN-FieldLengthUM                               OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":39404},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39405},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":39406},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d3b0334b309fe89560b931506813721b5a23e14f7ce0fa6739442b902e3bd487","d303653f35fd223892ce4c2911b5ad4caf9c4bd8a02b9f1ec7485662e717cec0","177db654c514d82070df98c7d2ecc1241e1f8dab6af6803990b007e5441585b4","21799293323746915432074d059a17e2e81188c3567e0daf5058eef44fac730f","bf746c539d9c80f279bf4e1ddfb0f84b720b314d04d705897908c64a2e25014a","7bd84586dbbf8986be81f27b6678986f0ad82b2549ce4bee6db22f7ed8a79309","4a37f594bcb55d0109824f61df9ade3cf0c440bbb16c07422fe9b0cda00011a1","8f939af3f8530f646a993e9e8abc4bd10f341371af33d209d28337708b9733f1","8dd8d8b35731bd0e7466b8762daa6e4cd073209c5d9b0a3013c77d37e9eeeed6","11dc61b58cda94e75547e41ff0847e56b321c9e4b1b285536186c6e161ab7b9d","71f4b6b13a144d55b282aa67ffa983adc5d892b3108854604ab3a3f5f087c4ab","dcd8e099856243ccc2934af7ab42bc14e807b206d51cb78a9dd067a4baf10edc","9b27c149838e0cec8f2cbd74d04262cf9f1e68e6ea64bfb28bc7d1475fffba91","ea8e17a42c0d9a83fb5587bd6a3a7613cbe9ee46a84bfc88f33c29b1cd8914c3","dd836db9f932aac3ae4c3a400d53995b0a1de6a42fb0c15916bf87e423674c58","af92e5a16954391cd65117d7ee0c6b3a3c421b3af94e8d7d8c8e0eccef68a75f","97530692851178329265d6d81f3bb5757b0478907b1901f17d4b5a96ed0e018c","50f4e0b218054748f498812b8b624324fafda2877c91223cc5e7542b05e61a2b","5ce61737f06f15eaa96c33789b216cdd66192e98e8797f44aea4a61e85c2bb16","e1cf1713e446292e13ec91c40dd8c801638e20ea0a2f47ed87c6efbc6f7d1bce","ef024c0fe3c79807d8fce3d6740673098696c896f3d36860ee89f67a2db059ad","9351da1a4f3fe5513fca8b5f1cf8693738ad809587bf7729c89021780d8057fe","3021e18b08716b14e211e925a797c479371e37eb697491854677cbc44a0536f4","4c2f01008a9b18c04e7d91b90ceb2810f157d5e9ca28ae835a0fedc1032aeb29"],"paragraph_range_zero_based":[39384,39407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39409},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-STOP","paragraph_zero_based":39410},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39412},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config field descriptions","paragraph_zero_based":39413},{"literal_text_all_w_t_and_m_t":"sl-MaxRetxThreshold","paragraph_zero_based":39414},{"literal_text_all_w_t_and_m_t":"Parameter value of maxRetxThreshold for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":39415},{"literal_text_all_w_t_and_m_t":"sl-PollByte","paragraph_zero_based":39416},{"literal_text_all_w_t_and_m_t":"Parameter value of pollByte for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":39417},{"literal_text_all_w_t_and_m_t":"sl-PollPDU","paragraph_zero_based":39418},{"literal_text_all_w_t_and_m_t":"Parameter value of pollPDU for RLC AM for NR sidelink communications, seeTS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":39419},{"literal_text_all_w_t_and_m_t":"sl-SN-FieldLength","paragraph_zero_based":39420},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC SN field size for NR sidelink communication, see TS 38.322 [4]. For groupcast and broadcast, only value size6 (6 bits) is configured for the field sl-SN-FieldLengthUM.","paragraph_zero_based":39421},{"literal_text_all_w_t_and_m_t":"sl-T-PollRetransmit","paragraph_zero_based":39422},{"literal_text_all_w_t_and_m_t":"Timer value of t-PollRetransmit for RLC AM for NR sidelink communications, see TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":39423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39424},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":39425},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":39426},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":39427},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB  configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":39428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39429},{"literal_text_all_w_t_and_m_t":"–SL-ScheduledConfig","paragraph_zero_based":39430},{"literal_text_all_w_t_and_m_t":"The IE SL-ScheduledConfig specifies sidelink communication configurations used for network scheduled NR sidelink communication.","paragraph_zero_based":39431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e3040d95faef0e9458b747d4b77610a5b1b7d04e02a30abec2ffe0c7151bdc12","c300cf68ddf4f8c7ca97d174c939c24852dacc2e862644d657b0819ffd133754","c7ce09451d95625f0453a676e48753bb4e3216228454d96146bc2097a8d3cbf4","bd3f68101a28f813501905f487ea1020885d1e322a355c56933e7e06a99b89a7","fafb213e244438c1a9af56191ad18ef48525cd0fbec3aa31c123b81462a9390f","78d78e88daf6c46f05d7