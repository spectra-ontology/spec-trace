{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the SCellConfig contains the goodServingCellEvaluationBFD:","paragraph_zero_based":2016},{"literal_text_all_w_t_and_m_t":"3>the UE may perform the evaluation of the good serving cell quality criterion for this serving cell as specified in 5.7.13.2.","paragraph_zero_based":2017},{"literal_text_all_w_t_and_m_t":"5.3.5.5.10BH RLC channel release","paragraph_zero_based":2018},{"literal_text_all_w_t_and_m_t":"The IAB-node shall:","paragraph_zero_based":2019},{"literal_text_all_w_t_and_m_t":"1>for each BH-RLC-ChannelID value included in the bh-RLC-ChannelToReleaseList that is part of the current IAB-node configuration within the same cell group (LCH release); or","paragraph_zero_based":2020},{"literal_text_all_w_t_and_m_t":"1>for each BH-RLC-ChannelID value that is to be released as the result of an SCG release according to 5.3.5.4:","paragraph_zero_based":2021},{"literal_text_all_w_t_and_m_t":"2>release the RLC entity or entities as specified in TS 38.322 [4], clause 5.1.3;","paragraph_zero_based":2022},{"literal_text_all_w_t_and_m_t":"2>release the corresponding logical channel.","paragraph_zero_based":2023},{"literal_text_all_w_t_and_m_t":"5.3.5.5.11BH RLC channel addition/modification","paragraph_zero_based":2024},{"literal_text_all_w_t_and_m_t":"For each BH-RLC-ChannelConfig received in the bh-RLC-ChannelToAddModList IE the IAB-node shall:","paragraph_zero_based":2025},{"literal_text_all_w_t_and_m_t":"1>if the current configuration contains a BH RLC Channel with the received bh-RLC-ChannelID within the same cell group:","paragraph_zero_based":2026},{"literal_text_all_w_t_and_m_t":"2>if reestablishRLC is received:","paragraph_zero_based":2027},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":2028},{"literal_text_all_w_t_and_m_t":"2>reconfigure the RLC entity or entities in accordance with the received rlc-Config;","paragraph_zero_based":2029},{"literal_text_all_w_t_and_m_t":"2>reconfigure the logical channel in accordance with the received mac-LogicalChannelConfig;","paragraph_zero_based":2030},{"literal_text_all_w_t_and_m_t":"1>else (a backhaul logical channel with the given BH-RLC-ChannelID was not configured before within the same cell group):","paragraph_zero_based":2031},{"literal_text_all_w_t_and_m_t":"2>establish an RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2032},{"literal_text_all_w_t_and_m_t":"2>configure this MAC entity with a logical channel in accordance to the received mac-LogicalChannelConfig.","paragraph_zero_based":2033},{"literal_text_all_w_t_and_m_t":"5.3.5.5.12Uu Relay RLC channel release","paragraph_zero_based":2034},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2035},{"literal_text_all_w_t_and_m_t":"1>for each Uu-RelayRLC-ChannelID value included in the uu-RelayRLC-ChannelToReleaseList that is part of the current configuration within the same cell group (LCH release):","paragraph_zero_based":2036},{"literal_text_all_w_t_and_m_t":"2>release the RLC entity as specified in TS 38.322 [4], clause 5.1.3;","paragraph_zero_based":2037},{"literal_text_all_w_t_and_m_t":"2>release the corresponding logical channel.","paragraph_zero_based":2038},{"literal_text_all_w_t_and_m_t":"5.3.5.5.13Uu Relay RLC channel addition/modification","paragraph_zero_based":2039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b6ba6b21056d97081f7e6a7f7504e1c5f0e1e576225dd770cf153c8d5f52df4f","6