{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-LOS-NLOS-GriddedIndications; otherwise it is not present. Support for GNSS-LOS-NLOS-GriddedIndications implies support for LOS-NLOS-GridPoints.","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"–GNSS-LOS-NLOS-GridSupport","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GridSupport-r16 ::=SEQUENCE {","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"7.2Mapping of posSibType to assistance data element","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"The supported posSibType's are specified in Table 7.2-1. The GNSS Common and Generic Assistance Data IEs are defined in clause 6.5.2.2. The OTDOA Assistance Data IEs and NR DL-TDOA/DL-AoD Assistance Data IEs are defined in clause 7.4.2. The Barometric Assistance Data IEs are defined in clause 6.5.5.8. The TBS (based on MBS signals) Assistance Data IEs are defined in clause 6.5.4.8.","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"Table 7.2-1: Mapping of posSibType to assistanceDataElement","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"assistanceDataElement","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"GNSS Common Assistance Data (clause 6.5.2.2)","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"posSibType1-1","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"GNSS-ReferenceTime","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["bda826ef6c53eb3832c0e7abdeaa03e53651f2cbb9db7ce7d8b80d34b77c8f72","5cbf9c7756cfe0251ea56393fa0c29541373c0f83fad61a32ada5147eefeb33d","aa3bb3000b688731ea6fb7c8e36b938138db83ec2fa0e9b5e4629a6429fd42d6","b8592cb51f07eb13428b85dd1dc9bef52cab5d79cd912c40b9cf37e48351e956","5566c08d3bd246737c902678d60529355dadf7318f094a251d995acd4d446974","8d232a046680bca6bd83fd2e4bc8481b09f372fb216c5d604bae87bfafcffcd0","b8eba604e80b6f839f90165143e65f88d3cf5b445ffed6d1ddbfc2fa5f290d64","0e55ed014041450861db9d47eae399e510c7c7d73fb503e3bb579f4d39958221","4abc7900c64cdb5d34934ad9f25233071d8426b101677ffe50b0072230367794","3e79dcf4c5a2aeda5e26cc6cebe28744d7244d01b3a83492b7a775129af4c62c","67c93c75beabc5f49f17f915f10e690574d38c08a6c2aa59964007c40473a4fe","144603e99d7e825d38093b7ef067b8cf0cdf3c6a972539cd742fc57908f38c05","6ab0222f5e56ac44af971da011454be43978acaede34748745198feb274d6d25","6e373d66c106adfc204bd3bd1e704ad82945d61e6c2417d707d0115cd387c4c4","2e05fa87b33b4738cf6539da11ec9037cf4823885381c7aa20dc9ea572c1662c","a416915b3bc07fe70245f6dccb25dee3fbab17b321cdcd402f86a57182853c28","7dcf