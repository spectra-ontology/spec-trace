{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BAP-RoutingID field descriptions","paragraph_zero_based":14664},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":14665},{"literal_text_all_w_t_and_m_t":"The ID of a destination IAB-node or IAB-donor-DU used in the BAP header.","paragraph_zero_based":14666},{"literal_text_all_w_t_and_m_t":"bap-PathId","paragraph_zero_based":14667},{"literal_text_all_w_t_and_m_t":"The ID of a path used in the BAP header.","paragraph_zero_based":14668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14669},{"literal_text_all_w_t_and_m_t":"–BeamFailureRecoveryConfig","paragraph_zero_based":14670},{"literal_text_all_w_t_and_m_t":"The IE BeamFailureRecoveryConfig is used to configure the UE with RACH resources and candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.1.1.","paragraph_zero_based":14671},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig information element","paragraph_zero_based":14672},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14673},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYCONFIG-START","paragraph_zero_based":14674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14675},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig ::=       SEQUENCE {","paragraph_zero_based":14676},{"literal_text_all_w_t_and_m_t":"    rootSequenceIndex-BFR               INTEGER (0..137)                                                          OPTIONAL, -- Need M","paragraph_zero_based":14677},{"literal_text_all_w_t_and_m_t":"    rach-ConfigBFR                      RACH-ConfigGeneric                                                        OPTIONAL, -- Need M","paragraph_zero_based":14678},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdSSB                   RSRP-Range                                                                OPTIONAL, -- Need M","paragraph_zero_based":14679},{"literal_text_all_w_t_and_m_t":"    candidateBeamRSList                 SEQUENCE (SIZE(1..maxNrofCandidateBeams)) OF PRACH-ResourceDedicatedBFR   OPTIONAL, -- Need M","paragraph_zero_based":14680},{"literal_text_all_w_t_and_m_t":"    ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two,","paragraph_zero_based":14681},{"literal_text_all_w_t_and_m_t":"                                                       four, eight, sixteen}                                      OPTIONAL, -- Need M","paragraph_zero_based":14682},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                           OPTIONAL, -- Need M","paragraph_zero_based":14683},{"literal_text_all_w_t_and_m_t":"    recoverySearchSpaceId               SearchSpaceId                                                             OPTIONAL, -- Need R","paragraph_zero_based":14684},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization                   RA-Prioritization                                                         OPTIONAL, -- Need R","paragraph_zero_based":14685},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryTimer            ENUMERATED {ms10, ms20, ms40, ms60, ms80, ms100, ms150, ms200}            OPTIONAL, -- Need M","paragraph_zero_based":14686},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":14687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["10a951e06854d18313ca6183bdd6a7d27d3b3370b5e397080bf587d6bfa837d4","17fd70b9f1f857