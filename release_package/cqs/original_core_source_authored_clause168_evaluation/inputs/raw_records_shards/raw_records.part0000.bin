{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":42792},{"literal_text_all_w_t_and_m_t":"sl-RoHC-Profiles","paragraph_zero_based":42793},{"literal_text_all_w_t_and_m_t":"This field indicates the supported RoHC profiles for NR sidelink communications.","paragraph_zero_based":42794},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":42795},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":42796},{"literal_text_all_w_t_and_m_t":"sl-TxProfileList","paragraph_zero_based":42797},{"literal_text_all_w_t_and_m_t":"List of one or multiple Tx profiles, indicating the compatibility of supporting SL DRX as specified in TS 38.321 [3]. It is up to the UE implementation whether/how to apply this field.","paragraph_zero_based":42798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42799},{"literal_text_all_w_t_and_m_t":"–End of NR-Sidelink-Preconf","paragraph_zero_based":42800},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42802},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":42803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42804},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42805},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42806},{"literal_text_all_w_t_and_m_t":"9.4Radio Information Related to Discovery Message","paragraph_zero_based":42807},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC information elements that are transferred in Discovery Message.","paragraph_zero_based":42808},{"literal_text_all_w_t_and_m_t":"–SL-AccessInfo-L2U2N","paragraph_zero_based":42809},{"literal_text_all_w_t_and_m_t":"The IE SL-AccessInfo-L2U2N includes the radio information included in Discovery Message used for L2 U2N relay operation.","paragraph_zero_based":42810},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N information elements","paragraph_zero_based":42811},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42812},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ACCESSINFO-L2U2N-START","paragraph_zero_based":42813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42814},{"literal_text_all_w_t_and_m_t":"NR-Sidelink-DiscoveryMessage DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":42815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d96578735e93ce471fd2145edee1220a7f37b8a90493ed359020a0ef590e4d1e","21da4a22391fe8f990f8f428eca2d4e24f02369ec2ed56e231caa1e46967dc71","5b5b71ee6c00ad4adefae0a14b5553df69367d3cbc68a4bd0b03a751b7eb2d49","50abe9c6047d84d2b6f8da303d3469f53215ff9125be146ea4eda48338696827","bd87619ff9f26457f9d4cb43956e14edd3e90a05374c62a4ff6a92dfa29d35ca","7905506280bbee6461a8eb6557075d0081477f61a04a848ba69b6080818b43cb","15feec102f117c5bd1a37e7c488598198a6bb3cbce64c91c162b6ac9ea545c8d","e493bd32d90f15db7d5a40695d17cdf3a45ff6a4c443eb92d89aee3c51da8b19","f5ab6385f56eecf1cae3a9f93522419a752d531b3e91b084a50f20cb3d99c194","1cf5abfe48c0cd8081cd66961bb55130a1364418cbeb7a853f1a356ef4cb4ffe","128af0f57fdb04ca12eab3262e07cc477bc48ea138b07edd5af8122cf887ae3c","5ef7b4a577bd71545b0870d916fc43b9d1b85fd0e192d4d33fa461efe547a1aa","c1dd6d351e21562b7edb20fc5cc26fab34008e4136f5b183503f261ce004f272","e5abe7f5cc96cfe2459327a03034c3883bff8afa496abd1d30764a04b48df477","83deddde61cd64dcaa2f94d9f2599a16