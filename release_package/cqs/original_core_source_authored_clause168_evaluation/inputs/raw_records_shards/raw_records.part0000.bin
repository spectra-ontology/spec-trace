36b6b654dfbe8063a148b6cc6046f6db90","7392ad6ca416c5601749411de25923d32d6896cf84040c9510fa39f4d06744ca","ca963f0a5ef9c7762bc3ef89c9e8e2a52003d00ec7f7a846d08950b2bfffa1f6","178c823fdd9e5b71825c0224dbae8a5e42a839c87ad80a2b1d09cf0be19913d1","9e1b261a84c013f7bc0320e313ad55d09b6dc3534127fe4c40a41a14032b4fad","af02efb6b7bcd66184a06baf34f242dcba0b76137be4b428d5994bd21e07ab6d","61f01cc6a7834149a5351df0fa0a072b57587bcaebcb0fe1a5afffbe0d9292bb","4970882b919464f0f124a90b2ac4ab25e5e4207b4bf7ae42bcb4263bcf79dc76","3ab6842a75aa202238e77f87a683247389f113430e2c63df9136076115e9e032"],"paragraph_range_zero_based":[19008,19031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19008"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19033},{"literal_text_all_w_t_and_m_t":"LocationMeasurementInfo field descriptions","paragraph_zero_based":19034},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":19035},{"literal_text_all_w_t_and_m_t":"The EARFCN value of the carrier received from upper layers for which the UE needs to perform the inter-RAT RSTD measurements.","paragraph_zero_based":19036},{"literal_text_all_w_t_and_m_t":"measPRS-Offset","paragraph_zero_based":19037},{"literal_text_all_w_t_and_m_t":"Indicates the requested gap offset for performing RSTD measurements towards E-UTRA. It is the smallest subframe offset from the beginning of subframe 0 of SFN=0 of the serving cell of the requested gap for measuring PRS positioning occasions in the carrier frequency carrierFreq for which the UE needs to perform the inter-RAT RSTD measurements. The PRS positioning occasion information is received from upper layers. The value of measPRS-Offset is obtained by mapping the starting subframe of the PRS positioning occasion in the measured cell onto the corresponding subframe in the serving cell and is calculated as the serving cell's number of subframes from SFN=0 mod 40.","paragraph_zero_based":19038},{"literal_text_all_w_t_and_m_t":"The UE shall take into account any additional time required by the UE to start PRS measurements on the other carrier when it does this mapping for determining the measPRS-Offset.","paragraph_zero_based":19039},{"literal_text_all_w_t_and_m_t":"NOTE:Figure 6.2.2-1 in TS 36.331[10] illustrates the measPRS-Offset field.","paragraph_zero_based":19040},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":19041},{"literal_text_all_w_t_and_m_t":"The ARFCN value of the carrier received from upper layers for which the UE needs to perform the NR DL-PRS measurements.","paragraph_zero_based":19042},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-RepetitionAndOffset","paragraph_zero_based":19043},{"literal_text_all_w_t_and_m_t":"Indicates the gap periodicity in ms and offset in number of subframes of the requested measurement gap for performing NR DL-PRS measurements.","paragraph_zero_based":19044},{"literal_text_all_w_t_and_m_t":"nr-MeasPRS-length","paragraph_zero_based":19045},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap length in ms of the requested measurement gap for performing NR DL-PRS measurements. The measurement gap length is according to in Table 9.1.2-1 in TS 38.133 [14].","paragraph_zero_based":19046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19047},{"literal_text_all_w_t_and_m_t":"–LogicalChannelConfig","paragraph_zero_based":19048},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelConfig is used to configure the logical channel parameters.","paragraph_zero_based":19049},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig information element","paragraph_zero_based":19050},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19051},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-START","paragraph_zero_based":19052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19053},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig ::=            SEQUENCE {","paragraph_zero_based":19054},{"literal_text_all_w_t_and_m_t":"    ul-SpecificParameters               SEQUENCE {","paragraph_zero_based":19055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML