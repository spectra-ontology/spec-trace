{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RTK-OSR-Req","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-Observations; otherwise it is not present.","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"GLO-CPB-Req","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GLO-RTK-BiasInformation; otherwise it is not present.","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"MAC-Req","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSSRTKMACCorrectionDifferences; otherwise it is not present.","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"Res-Req","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-Residuals; otherwise it is not present.","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"FKP-Req","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RTK-FKP-Gradients; otherwise it is not present.","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"OC-Req","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-OrbitCorrections; otherwise it is not present.","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"CC-Req","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-ClockCorrections; otherwise it is not present.","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"CB-Req","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-CodeBias; otherwise it is not present.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"URA-Req","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-URA; otherwise it is not present.","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"PB-Req","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-PhaseBias; otherwise it is not present.","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"STEC-Req","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-SSR-STEC-Correction; otherwise it is not present","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"Grid-Req","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSSSSRGriddedCorrection; otherwise it is not present.","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["82b153b0aec7d1d10354442f674e0faf3296f23d125e53f7e81dd38d2d7c28cc","6cbce4fea1b4b7f9f92e4b9a0d2a8fe80a3b25c2c39b52c0334fc18184589894","052480821df8e748310c8e6e7f61d910e5748d99f4fc51bfd55f5956152c7340","2a4306110af04239adb78c8b71b4609e6f6e40d4365ba6998b3d38a0a31f114e","04adca7ba651b79a0449e7d1b59be8bb431afa827762f33ee25b7180799aa7f5","bfe11f64cbe9e84cefec6ed64b54def1838a5b097ada02aaa9839d964edafafc","e69635cf40076fe3eb4eeaf595da90b7891083954108affe9a576eb10793412c","513cc62b34709838704386377c992f51e9ed5e19f069928800bda4bdebaf60f0","a38670b801