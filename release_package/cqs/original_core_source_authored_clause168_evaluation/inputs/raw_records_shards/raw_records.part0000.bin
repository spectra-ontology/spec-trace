{"fields":{"filename":"R2-2301348.zip::R2-2301348.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"6.3.1aPositioning System information blocks","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"–PosSI-SchedulingInfo","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSI-SCHEDULINGINFO-START","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"PosSI-SchedulingInfo-r16 ::=               SEQUENCE {","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"    posSchedulingInfoList-r16                  SEQUENCE (SIZE (1..maxSI-Message)) OF PosSchedulingInfo-r16,","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfig-r16                        SI-RequestConfig                                 OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfigSUL-r16                     SI-RequestConfig                                 OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfigRedCap-r17                  SI-RequestConfig                                 OPTIONAL   -- Cond REDCAP-MSG-1","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"PosSchedulingInfo-r16 ::= SEQUENCE {","paragraph_zero_based":137},{"liter