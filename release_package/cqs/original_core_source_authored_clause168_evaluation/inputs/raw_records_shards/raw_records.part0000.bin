{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17568},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17570},{"literal_text_all_w_t_and_m_t":"CSI-RS-Index ::=                    INTEGER (0..maxNrofCSI-RS-ResourcesRRM-1)","paragraph_zero_based":17571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17572},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCECONFIGMOBILITY-STOP","paragraph_zero_based":17573},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17575},{"literal_text_all_w_t_and_m_t":"CSI-RS-CellMobility field descriptions","paragraph_zero_based":17576},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceList-Mobility","paragraph_zero_based":17577},{"literal_text_all_w_t_and_m_t":"List of CSI-RS resources for mobility. The maximum number of CSI-RS resources that can be configured per measObjectNR depends on the configuration of associatedSSB and the support of increasedNumberofCSIRSPerMO capability (see TS 38.214 [19], clause 5.1.6.1.3).","paragraph_zero_based":17578},{"literal_text_all_w_t_and_m_t":"density","paragraph_zero_based":17579},{"literal_text_all_w_t_and_m_t":"Frequency domain density for the 1-port CSI-RS for L3 mobility. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17580},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":17581},{"literal_text_all_w_t_and_m_t":"Allowed size of the measurement BW in PRBs. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17582},{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":17583},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":17584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17585},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility field descriptions","paragraph_zero_based":17586},{"literal_text_all_w_t_and_m_t":"csi-RS-CellList-Mobility","paragraph_zero_based":17587},{"literal_text_all_w_t_and_m_t":"List of cells for CSI-RS based RRM measurements.","paragraph_zero_based":17588},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":17589},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell providing the timing reference for CSI-RS resources without associatedSSB. The field may be present only if there is at least one CSI-RS resource configured without associatedSSB. If this field is absent, the UE shall use the timing of the PCell for measurements on the CSI-RS resources without associatedSSB. The CSI-RS resources and the serving cell indicated by refServCellIndex for timing reference should be located in the same band.","paragraph_zero_based":17590},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":17591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d0e5b4ee803fe3d850768b519ca9c30c66b6040e3e2d2296ac46ce4c0fd6101d","2d5569df8c24c11f6864bb201f9779d43dbb3ff8c6e4c27ffea9bea69f879b68","db020be1c77db8fe1772be18e9a1f966381cc7df39c16e6f06f24d4d088f72dd","7e481b247adc39dbe19507109a7a468d50f22e9f53106afe6b917a4ed36788d2","d759c5fd053ec8789254f7400c6e634d150364958880fc33c61048327e7fa573","e0196a7419e673a3d4b9e4249a4aa01927f237cb85be3977703c6e4144b1b1c4","3abf9be1e4aa59b7e93957bd8a4589f5ee7c3e0036f73ac1570c711367107388","0c0bcc498baf71b97e87364f76503eea54f1547c51c323f3996aefacbe1aaea3","5708bf2910e20e343460a114a8912b5fd82e353f51f009269081ebc92947a7ff","bab113d880e6a1d69b7f3165e0ed97c137760011765caf4f63b84c6c57d6e457","3ffd6fa0c609d6d08592babd873b4fcca837f645afb28db92a1c2242cfab0f3e","7d411826b5e5002612ca9a3c6cf637952d9b4cc4a26c712bc428cca4957cf2d5","3a69a2019b4ee13d0204c42af197513f62dd2581416e79d928bfa76c3a9ea1d0","4da69dd226785bd9faea294cccacd4066f1ea482a211641f8e57d08461cf329b","b4c38ebaeb87abbf40bf79763f0e0a6c659af981ebb3c08f8213bd3664eda1c1","1aff19a082f8199f7f1d31137ef79b58c7c60357b02d99b9e8870c34da548de8","fe2c89e4dd07ae535156e59c90910c2ab34211a7bad7daad6269000015c3f2d5","51bf899e9e91ab810ba8a8bc97771367241de61506874cbb90b8117307911ac0","432626a07708505bc32ee28229dfe55ae8bb7503f332739231c011b89177910f","5b46ff04a65f19dc05a78123dbd491ceee5d57a3479ef1d68cdcb8db8bb73e51","b1e6cc739a92cc470cf4c69580a20d699433f1840808c2f9d6269ca8a5e611da","4d351b38c5eb31065731276648343a9b4e334f8651731ffd1001d5f6ab67f152","0e4a0dc0e231f61fdf46078800b9ea523a033c4a1a50b7c112d798f3be7bd98c","fdd936a5a3fca5607bf37b8efe6ce65fb30356d3baf08963de86ace878434c61"],"paragraph_range_zero_based":[17568,17591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p17568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of CSI-RS.","paragraph_zero_based":17592},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":17593},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":17594},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":17595},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":17596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17597},{"literal_text_all_w_t_and_m_t":"CSI-RS-Resource-Mobility field descriptions","paragraph_zero_based":17598},{"literal_text_all_w_t_and_m_t":"associatedSSB","paragraph_zero_based":17599},{"literal_text_all_w_t_and_m_t":"If this field is present, the UE may base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the cell indicated by the cellId in the CSI-RS-CellMobility. In this case, the UE is not required to monitor that CSI-RS resource if the UE cannot detect the SS/PBCH block indicated by this associatedSSB and cellId. If this field is absent, the UE shall base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the serving cell indicated by refServCellIndex. In this case, the UE is required to measure the CSI-RS resource even if SS/PBCH block(s) with cellId in the CSI-RS-CellMobility are not detected.","paragraph_zero_based":17600},{"literal_text_all_w_t_and_m_t":"CSI-RS resources with and without associatedSSB may be configured in accordance with the rules in TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17601},{"literal_text_all_w_t_and_m_t":"csi-RS-Index","paragraph_zero_based":17602},{"literal_text_all_w_t_and_m_t":"CSI-RS resource index associated to the CSI-RS resource to be measured (and used for reporting).","paragraph_zero_based":17603},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":17604},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS, see TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":17605},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":17606},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3 including table 7.4.1.5.2-1. The number of bits that may be set to one depend on the chosen row in that table.","paragraph_zero_based":17607},{"literal_text_all_w_t_and_m_t":"isQuasiColocated","paragraph_zero_based":17608},{"literal_text_all_w_t_and_m_t":"Indicates that the CSI-RS resource is quasi co-located with the associated SS/PBCH block, see TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":17609},{"literal_text_all_w_t_and_m_t":"sequenceGenerationConfig","paragraph_zero_based":17610},{"literal_text_all_w_t_and_m_t":"Scrambling ID for CSI-RS (see TS 38.211 [16], clause 7.4.1.5.2).","paragraph_zero_based":17611},{"literal_text_all_w_t_and_m_t":"slotConfig","paragraph_zero_based":17612},{"literal_text_all_w_t_and_m_t":"Indicates the CSI-RS periodicity (in milliseconds) and for each periodicity the offset (in number of slots). When subcarrierSpacing is set to kHz15, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 3/4/9/19/39 slots. When subcarrierSpacing is set to kHz30, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 7/9/19/39/79 slots. When subcarrierSpacing is set to kHz60, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 15/19/39/79/159 slots. When subcarrierSpacing is set kHz120, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 31/39/79/159/319 slots. When subcarrierSpacing is set to kHz480, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 127/159/319/639/1279 slots. When subcarrierSpacing is set to kHz960, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 255/319/639/1279/2559 slots. If slotConfig-r17 is present, UE shall ignore the slotConfig (without suffix).","paragraph_zero_based":17613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17614},{"literal_text_all_w_t_and_m_t":"–CSI-RS-ResourceMapping","paragraph_zero_based":17615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f886baaa363a2b269ba07441234794ecc1c4a174d1051c30b7dc1f78f59cc8b8","58434798d7c794b0ff147867770bb816d729b2463f4cebfd6a83a7015906ad4d","f294ca0a26eacd7b295ee2e8398cf5c437513b7ae39a846277a8ebe0028a03b9","b93040ba163d5c576f3eed3b11301daf3909b4aef33b6e05953fd2272b0ca3b4","50b4c2584e441308265be3691507a9f5c417398d8e18bd39034c681eb703e0c8","4efd3b869475d0c3816fc0c4002f34227b9bd9a6c7cd07410fb7599e9be706fe","c5e22a4758fb905ede22f48e40d514cf5713b8cd12f2de1eebf6e057b29a6974","2eca30e3a828b6cc31185448346af40febc7089c95d61b86075eb7fdbac56c49","dd5e170c6de7aa25e9ebc071970851145a47d410cb47e03f35df0c1ad0653abe","4b587995707e036dfde3934977d1697b8bcb5fcbaf004a767c6c351b0ec45eed","ebec432f93f18f98f224b5d13a525b93b21e6eabfa7280caeeffd556366739c4","dc3510f9bd4f3f1a87876311fadc01bb80a3c93797521ce6f59092c4019f16f0","7d0316138a7140e8d53c9b7fc2119fc1dde626cfc0e9e61afad6971e97bef28e","250a6ebaaab582ff2a0266c089f142ca1e9b3624256d159daac3169597532fd1","015a9b88409cd29b4a833601bec9693be20cbbb8896c437353eab5677c5c1712","54d485c0b864e9d7a214e55435c08c1bc8bf5d11ba750effcb2fdaf938c3c5