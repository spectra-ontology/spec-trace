ots-1)","paragraph_zero_based":29774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29775},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGDEDICATED-STOP","paragraph_zero_based":29776},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29778},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated field descriptions","paragraph_zero_based":29779},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList","paragraph_zero_based":29780},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1. ","paragraph_zero_based":29781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29782},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated-IAB-MT field descriptions","paragraph_zero_based":29783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["36fedf4e335dcf835b5a05d6d3e916c9686c95d23d49f500aa89915d57ba66b2","ed439630631248995f8a57d84842a0903866d18264baa21068f934504ecda8fe","32f012dff19598c0cda7f6507928927c5db66950ea471ed5a647ee8bddf2d645","a794c54b5542f81e0a70ea105cba7344ab87babdfc88e295881babe5770d2012","4bd03256150116c89212b48403305f69dd943247db039c70bb23c2334a8caeb7","2e41fd187e27a845e93854fcc0dc2b80dc98f7a8fb2c822a09aa68f6d42b2121","eefe54129c4b1fe596860ca84de5f219e3d832cf4d8e1ddd6ce044bf3cb2c2dc","34034c44b5680f30e1dab6a17ceaa03648e855c834ebc335283d0cdaa277aa13","b0f113ad8133ee5debbdb686ef584ad87ebcbd7d4117e7cabeee4f7a5971142c","2ce258e12e59255983a80c4065f64ed1b2dc336325dd374799db862e602feaba","d7e5fae6cf40869d4bfc04d19285d758e7804640da79a80db33ce601cc119d7a","95608e59e65acd19d000d5d034c89497cc0a47afa9e3b910d3c4fbf3336cca74","22eb42ea75a1f6a2b5c36bddca6d490b6d33a961bc40e94e0330919e9a464b45","839aca1c20836f8849e45ca3b03f6f3fe6d054d6a01f6a88157c2554547cb92d","f4af174bc8f3b3a8b1be5f460d868af5250fdcaff6d3f256c56822ce42573c59","1de0590503b5935d5ea49c23aad90c242d0256940ace7154849f7e1734b995c9","10f97686bf2eb82c648c3592845129fb87a7878b6a2b820ef38c93f210a236d2","d41d97431fb98e5e3aad4099e22ea5878240f8381e17acd625095ecf860ef57b","b79a788d8a6e7c18f4a8715f90d86ab8eebe0df0299687b963ce82906af98aa0","cfd2bceb7a88831fca059445f0bd30a6b95aa79cfeac3ffa02b06c0177b4f8e6","70e6f09b30fa408ad38ad73c88e91a81acbc13527280744ad9ef13d41e083904","c0a43f8e79929eb00da9ea9134e947a5cb0c3d63b739984b3428d3e03897b194","78547b76ae9485a5c5d2604b70d13249323910c679d171d91c28b9e59fc1f02c","b852bfcb60c7da25d0752e86b5a7b9ba70979d5007b8b73e06aa68ddf47438bd"],"paragraph_range_zero_based":[29760,29783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29760"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList-IAB-MT","paragraph_zero_based":29784},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList-IAB-MT allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon with a limitation that effectively only flexible symbols can be overwritten in Rel-16.","paragraph_zero_based":29785},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToReleaseList-IAB-MT","paragraph_zero_based":29786},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationsToReleaseList-IAB-MT allows release of a set of slot configuration previously add with slotSpecificConfigurationToAddModList-IAB-MT.","paragraph_zero_based":29787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29788},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig field descriptions","paragraph_zero_based":29789},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":29790},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot identified by slotIndex. If the field is absent the UE assumes that there are no leading DL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29791},{"literal_text_all_w_t_and_m_t":"nrofUplinkSymbols","paragraph_zero_based":29792},{"literal_text_all_w_t_and_m_t":"Number of consecutive UL symbols in the end of the slot identified by slotIndex. If the field is absent the UE assumes that there are no trailing UL symbols. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29793},{"literal_text_all_w_t_and_m_t":"slotIndex","paragraph_zero_based":29794},{"literal_text_all_w_t_and_m_t":"Identifies a slot within a slot configuration period given in tdd-UL-DL-configurationCommon, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":29795},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":29796},{"literal_text_all_w_t_and_m_t":"The direction (downlink or uplink) for the symbols in this slot. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively.","paragraph_zero_based":29797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29798},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig-IAB-MT field descriptions","paragraph_zero_based":29799},{"literal_text_all_w_t_and_m_t":"symbols-IAB-MT","paragraph_zero_based":29800},{"literal_text_all_w_t_and_m_t":"The symbols-IAB-MT is used to configure an IAB-MT with the SlotConfig applicable for one serving cell. Value allDownlink indicates that all symbols in this slot are used for downlink; value allUplink indicates that all symbols in this slot are used for uplink; value explicit indicates explicitly how many symbols in the beginning and end of this slot are allocated to downlink and uplink, respectively; value explicit-IAB-MT indicates explicitly how many symbols in the beginning and end of this slot are allocated to uplink and downlink, respectively.","paragraph_zero_based":29801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29802},{"literal_text_all_w_t_and_m_t":"–TrackingAreaCode","paragraph_zero_based":29803},{"literal_text_all_w_t_and_m_t":"The IE TrackingAreaCode is used to identify a tracking area within the scope of a PLMN/SNPN, see TS 24.501 [23].","paragraph_zero_based":29804},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode information element","paragraph_zero_based":29805},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29806},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-START","paragraph_zero_based":29807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["72d14ae7292a57822d37b942276ee07d97d0450210b0ade5cefcd37c800e73ca","f8666324a91a28915efa184bf49734b26f76f58db26bb25859b01a6f940d1b87","d2696f6eb9e25a8c81ca78d56342b36c5947648942b8ff60db07da01c7579b48","1788f02d07a8b43f457a463b5588d46989c70f36f5c27f07e9c21d05d2d843d2","1fe43e7ae50be6703debe1cef10da906aa67cd518aa67d97ba47e5a398e56a0a","fde03dfd92c9075d48c6ea99ec7b4940b59171c168e8abed3fd24561f41377f9","15fdb18713f0ec50362050fac2c3fea620a563a6c669c29a172ae199f07becf5","867b4cf533a7c81d2396b706395e8682ae3fb83c87710cfe11d1a6080a16b003","9437750270aa5a98d7031e27521bae7b081e04b0a546f4b545d7ceffb1b734c6","0fe54cbffe90188442f6a83e7855e0f777a8b28b4197a96a2525aa25ad1c3f40","a91d311ce3756596cf730ed1a5db9d6657d1e185a29dcf89410538279612214d","bab316914a11cf283b3e135fdef681ab156be3afb7be9b956666dc8fa028cf2b","304458d6d148c62d24403143dcf058f7486bf9859eb294ab52a36b233c7a249e","653e9ed951c8f3654a40d7a8f7189f4b3021f5d4f3bcc18e1e604f7585666f10","415c23adb6c6f032e17a48066c3bc308bf37b44552abf367465da5641727bb40","d561eb0ae40250feee1abbe6ba636aca55a85a52c26d91f9efe7da7b3ab3f786","dce81dc83792d451bfd6048703288baa18f3cb19a7e7f0a0e5d4e9b09434aa7e","1fc304e42e8c56552f21c688ecb13006f7b8ba32ac63859c82ba753d067e04db","99cb4f8583e5d1ce4be954a38d5afa4d71b10dc61907cfaba2f207e5497d5155","0b3eac5425464fadd9ef2ae875cef19524a1bce2b85ce59c54f7429b4ca7e9b1","8f4a4edbf26ac6b1a287e047469f1746f8a1ee92272f6ae09ff08385c13e5e04","48e2e25e1a96ee13582931c92511400a6943c764471e8c140cf0dbc8cceb1264","766b8a9f8d68b727c8c3d24c4e5ab63afa175da0c05f5e33f30400ea9960c04d","aab34b96df085a377439aadb6d42bc4cd2db78a3ae90a1390cd8027740525e4b"],"paragraph_range_zero_based":[29784,29807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29784"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29808},{"literal_text_all_w_t_and_m_t":"TrackingAreaCode ::= BIT STRING (SIZE (24))","paragraph_zero_based":29809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29810},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACKINGAREACODE-STOP","paragraph_zero_based":29811},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29813},{"literal_text_all_w_t_and_m_t":"–T-Reselection","paragraph_zero_based":29814},{"literal_text_all_w_t_and_m_t":"The IE T-Reselection concerns the cell reselection timer TreselectionRAT for NR and E-UTRA. Value in seconds. For value 0, behaviour as specified in 7.1.2 applies.","paragraph_zero_based":29815},{"literal_text_all_w_t_and_m_t":"T-Reselection information element","paragraph_zero_based":29816},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29817},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-START","paragraph_zero_based":29818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29819},{"literal_text_all_w_t_and_m_t":"T-Reselection ::=                   INTEGER (0..7)","paragraph_zero_based":29820},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29821},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-STOP","paragraph_zero_based":29822},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29824},{"literal_text_all_w_t_and_m_t":"–TimeAlignmentTimer","paragraph_zero_based":29825},{"literal_text_all_w_t_and_m_t":"The IE TimeAlignmentTimer is used to configure the time alignment timer as specified in TS 38.321 [3]. The values are in ms.","paragraph_zero_based":29826},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer information element","paragraph_zero_based":29827},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29828},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-START","paragraph_zero_based":29829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29830},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer ::=              ENUMERATED {ms500, ms750, ms1280, ms1920, ms2560, ms5120, ms10240, infinity}","paragraph_zero_based":29831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1c8f8789829e4ff483bdf6c6656728401bbf4abdf473adbcb8b90c24da69160b","2798f1b26a5058bd68336d9c86c827314fefcd43a75fc279e2e079aa640b967a","1206e3f13b35f0f603c7de3f8ce9ddeffa0fd9c0c5b091b4b22fed339e9cc60b","8cc6ec4526e6dc095ada5b90cae788f4adb4777a8ab7b953f0ab493c2aa60e18","13a67471fe3cb1bf6a97d3dd1a896d15c6702034734faf4786bb61ff660a948b","e896007d360018f0d21d6bc7d0394e40c327500535500a0f86ba9c337530b628","598ebe0f74138c1d7a2cd1682b378d700298afc99bf769afda4771e2ef3748c6","8ec00f1bfad268792d08f887463b554af73711df65dbdcb84d2adf71fab107a1","39de52d9466ffaf384ba2af9606b5734bb5b38b4fe0a18e4ef2e1de433ef31a7","7f2195fa2131a476b55554a51bbf9ab463a48e7479aaebdfcd039f1a680c4f0c","126578bd06c7cffeccd574993a463ef1cd190ad9cb710e4090e33dfbb73f3e27","603bee1a1eb6441064d53774559105e3a9ed2b0fa27eae3776d84e0f03c6bca0","cc4f32c98c4259cb3f4e6f4b418551b02a7092616875e89fa5b061ff559eb8e6","a83c2c96fd84ab0a0ed3013c1798eeaf13c741fe15ca60cd7f3f84db4c2ed3a1","7c9a45505a7fb185840474fc8a5098497cca73ba4b287caf0fa2e800abce2b5f","2e78e947d64fedeed96ca670e211d6caab8e5337497d5563a1124bb16b99622f","787e4f7d2b498f22c2dd80078fb261cd1807245081655f734dfd6f64d5d17a77","4f388a515798ff0e65d8d588dc8db6b506ee6d2e7436175ce0423a6e5a3d837f","64d23c13acede6c6acf67cbca7a3dac2a8796860cf01477fc758e6a12bfcb182","594489308213b96761a54e0b0b012dc7ef6434668dc740865a99a123e10fd75e","9bf657cc47f5802cbe1b8ebcf85322182e9f35861398b2014867b0a4589e142b","8c26340adc857a2ef33dd4e39181ce863aedd110f2ad76c4c52571f955d42374","a497acc807d4d82fcc5a24c2a0f738ea9a28cbd304f324fbef8ae44ea7cfa902","ca259eb87ed6658f71af7302543d6c5645ad4e1211701d0a341d3def733c0323"],"paragraph_range_zero_based":[29808,29831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29808"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29832},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-STOP","paragraph_zero_based":29833},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29835},{"literal_text_all_w_t_and_m_t":"–TimeToTrigger","paragraph_zero_based":29836},{"literal_text_all_w_t_and_m_t":"The IE TimeToTrigger specifies the value range used for time to trigger parameter, which concerns the time during which specific criteria for the event needs to be met in order to trigger a measurement report. Value ms0 corresponds to 0 ms and behaviour as specified in 7.1.2 applies, value ms40 corresponds to 40 ms, and so on.","paragraph_zero_based":29837},{"literal_text_all_w_t_and_m_t":"TimeToTrigger information element","paragraph_zero_based":29838},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29839},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-START","paragraph_zero_based":29840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29841},{"literal_text_all_w_t_and_m_t":"TimeToTrigger ::=                   ENUMERATED {","paragraph_zero_based":29842},{"literal_text_all_w_t_and_m_t":"                                        ms0, ms40, ms64, ms80, ms100, ms128, ms160, ms256,","paragraph_zero_based":29843},{"literal_text_all_w_t_and_m_t":"                                        ms320, ms480, ms512, ms640, ms1024, ms1280, ms2560,","paragraph_zero_based":29844},{"literal_text_all_w_t_and_m_t":"                                        ms5120}","paragraph_zero_based":29845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29846},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-STOP","paragraph_zero_based":29847},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29848},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetIndex","paragraph_zero_based":29849},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetIndex provides the index of the entry in uac-BarringInfoSetList. Value 1 corresponds to the first entry in uac-BarringInfoSetList, value 2 corresponds to the second entry in this list and so on. An index value referring to an entry not included in uac-BarringInfoSetList indicates no barring.","paragraph_zero_based":29850},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex information element","paragraph_zero_based":29851},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29852},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-START","paragraph_zero_based":29853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29854},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex ::=                INTEGER (1..maxBarringInfoSet)","paragraph_zero_based":29855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c884f860a6979b1d82ee59be5c1b122847e018239fdae2d2ad03be8e62f679d9","3e407a9aaa0d907a3b025295b9f93ff61b3ad54d985bcae1b91bdb1ae31abf2c","c03f9b9ec7d5fa27d338ca8788eb7e2ac880c494272ecbf1be7beea36638403e","bf700d5ae645d4150959b3759c3e35df8e79229013fba56736cb3c400ccbd47b","ecd1b0c71d59e06d30a13098cd02eda048e3166517f43d598ffb4132bfc01d5d","7658f126d48ed20c07959f92b204b76b9a67ea63310eaacc50df8c85cf3fa004","47d06fe16d639854b388b67fd315986fe05ac05a1c0da31b1f4dcaae5d1fb270","bc5682635968462d8162399a6378ac83560c4fd92b42d103a165ac1e8d77827a","3ad0c97e541ed6f5192179a3a1910b87e0c78b6fdd74bdb1943b29ae56e9e068","d24d02a45b7b01461f42497df353c106a13