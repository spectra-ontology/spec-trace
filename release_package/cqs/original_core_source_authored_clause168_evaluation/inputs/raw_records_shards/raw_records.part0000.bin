{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16920},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList ::=   SEQUENCE (SIZE (1..maxNrOfCSI-AperiodicTriggers)) OF CSI-AperiodicTriggerState","paragraph_zero_based":16921},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16922},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerState ::=       SEQUENCE {","paragraph_zero_based":16923},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfoList      SEQUENCE (SIZE(1..maxNrofReportConfigPerAperiodicTrigger)) OF CSI-AssociatedReportConfigInfo,","paragraph_zero_based":16924},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16925},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16926},{"literal_text_all_w_t_and_m_t":"    ap-CSI-MultiplexingMode-r17         ENUMERATED {enabled}                                          OPTIONAL  -- Need R","paragraph_zero_based":16927},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16928},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16930},{"literal_text_all_w_t_and_m_t":"CSI-AssociatedReportConfigInfo ::=  SEQUENCE {","paragraph_zero_based":16931},{"literal_text_all_w_t_and_m_t":"    reportConfigId                      CSI-ReportConfigId,","paragraph_zero_based":16932},{"literal_text_all_w_t_and_m_t":"    resourcesForChannel                 CHOICE {","paragraph_zero_based":16933},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS                          SEQUENCE {","paragraph_zero_based":16934},{"literal_text_all_w_t_and_m_t":"            resourceSet                         INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":16935},{"literal_text_all_w_t_and_m_t":"       