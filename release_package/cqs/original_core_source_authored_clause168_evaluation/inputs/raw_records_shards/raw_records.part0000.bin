ocx:p8184"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching sl-ReportConfigId from the sl-ReportConfigList within the VarMeasConfigSL;","paragraph_zero_based":8208},{"literal_text_all_w_t_and_m_t":"2>remove all sl-MeasId associated with the sl-ReportConfigId from the sl-MeasIdList within the VarMeasConfigSL, if any;","paragraph_zero_based":8209},{"literal_text_all_w_t_and_m_t":"2>if a sl-MeasId is removed from the sl-MeasIdList:","paragraph_zero_based":8210},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this sl-MeasId from the VarMeasReportListSL, if included;","paragraph_zero_based":8211},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer and reset the associated information (e.g. sl-TimeToTrigger) for this sl-MeasId.","paragraph_zero_based":8212},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the sl-ReportConfigToRemoveList includes any sl-ReportConfigId value that is not part of the current UE configuration.","paragraph_zero_based":8213},{"literal_text_all_w_t_and_m_t":"5.8.10.2.7Sidelink reporting configuration addition/modification","paragraph_zero_based":8214},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8215},{"literal_text_all_w_t_and_m_t":"1>for each sl-ReportConfigId included in the received sl-ReportConfigToAddModList:","paragraph_zero_based":8216},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching sl-ReportConfigId exists in the sl-ReportConfigList within the VarMeasConfigSL, for this entry:","paragraph_zero_based":8217},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry with the value received for this sl-ReportConfig;","paragraph_zero_based":8218},{"literal_text_all_w_t_and_m_t":"3>for each sl-MeasId associated with this sl-ReportConfigId included in the sl-MeasIdList within the VarMeasConfigSL, if any:","paragraph_zero_based":8219},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry for this sl-MeasId from the VarMeasReportListSL, if included;","paragraph_zero_based":8220},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer and reset the associated information (e.g. sl-TimeToTrigger) for this sl-MeasId;","paragraph_zero_based":8221},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":8222},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received sl-ReportConfig to the sl-ReportConfigList within the VarMeasConfigSL.","paragraph_zero_based":8223},{"literal_text_all_w_t_and_m_t":"5.8.10.2.8Sidelink quantity configuration","paragraph_zero_based":8224},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8225},{"literal_text_all_w_t_and_m_t":"1>for each received sl-QuantityConfig:","paragraph_zero_based":8226},{"literal_text_all_w_t_and_m_t":"2>set the corresponding parameter(s) in sl-QuantityConfig within VarMeasConfigSL to the value of the received sl-QuantityConfig parameter(s);","paragraph_zero_based":8227},{"literal_text_all_w_t_and_m_t":"1>for each sl-MeasId included in the sl-MeasIdList within VarMeasConfigSL:","paragraph_zero_based":8228},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this sl-MeasId from the VarMeasReportListSL, if included;","paragraph_zero_based":8229},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer and reset the associated information (e.g. sl-TimeToTrigger) for this sl-MeasId.","paragraph_zero_based":8230},{"literal_text_all_w_t_and_m_t":"5.8.10.3Performing NR sidelink measurements","paragraph_zero_based":8231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c8900f778fb3fd5ddbc01cb495190fd6433688448f452e5a6bfff11b4d1adb25","ec4f2540785915d27dbd947d48732929dc45f725dd22632fe5cd145ecabdab8c","bd5f9302a4599c8f4d5a6c4cdb5a35ae6c812ceccc3c5f22b287d159d536f982","ea4f17051593684f69cfed8c04cf52306c2c88d7bdf0e570716ea4e4fa87b5b1","3174082661bdb649a0dbb338dc1f984f8d7522ee9f6a3c99fb820f7dd496d937","768f4d0cf287599bb45cdf61a6b0067bacc58f51314c80e2bdaf7b9134f4be98","037be4ff276b6de481309784ac2fa64a880731c0469ecc49de784322dc8aeefc","fbe6e9781d2ecd55d7abe9f7e4ee836d29e1740e593b57e9cef1be6aff543d13","fe8aa1243a0d6f41700aeb6fc37ffe7abe4546a43dc6860f23da685e36d7979c","3401989a3d260b9645bc83eaf0cab78781827577b7001aff04930f97a1099162","7367f4eac3e893d81e1041dd695b354950101ca0ef98af3eaec65794acd3ca65","ed8fd855c611469e82a81bf3ee7dc42209380b9e0f5d77bd2534e677d7c8b09a","05f1ce33ecf9ff4525328edb2f6cea4a08062d532fde7779bfffe5191d3a3186","9644148b5cfd8fd1771ce14da71e89ad7651e52d87e56f9b8f0c1ec527895274","9991a2c43f07f4e3268491e3eb54223bbd1bc5d208d2ecfd8da14eeae00d920d","3cf9d3ce6bf06353daf5e6eb704a499c0f04ac509485308fc4d442508bce3bf9","6606f90daf1d4f58c2e47f92a9741a696e24c2475e997bf282e8cef46166fdcc","c75b695c06bfc57b218112a76ea364148455cdc4ced227f26cbe40618ff90aad","eefcb812e454f113f2535a7c5877b2b752c9e3386bf58f32b41df478ee33cf7c","1b8d0779ed2ce269fa1e641b4799a36f5d0c8b0651cb8a53edaa2a6fa4187e19","a73de9a667ac2dfbb6633b957f2f30bfcd23b365089a93b465044ae0b0869a23","98dd2ee7569e002081652dc171898109505fc739b4b955030cdc03bf84f54568","2aa1a98c74af9858e46167dfa3ade2d64593d84ee78b27bbbb1fca9e97cf96ee","889435f3e0f3c9c153ccb6f54f0cbb0cdea09815e69c56d8c2b3021168a4bb64"],"paragraph_range_zero_based":[8208,8231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8208"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.8.10.3.1General","paragraph_zero_based":8232},{"literal_text_all_w_t_and_m_t":"A UE shall derive NR sidelink measurement results by measuring one or multiple DMRS associated per PC5-RRC connection as configured by the peer UE associated, as described in 5.8.10.3.2. For all NR sidelink measurement results the UE applies the layer 3 filtering as specified in clause 5.5.3.2, before using the measured results for evaluation of reporting criteria and measurement reporting. In this release, only NR sidelink RSRP can be configured as trigger quantity and reporting quantity.","paragraph_zero_based":8233},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8234},{"literal_text_all_w_t_and_m_t":"1>for each sl-MeasId included in the sl-MeasIdList within VarMeasConfigSL:","paragraph_zero_based":8235},{"literal_text_all_w_t_and_m_t":"2>if the sl-MeasObject is associated to NR sidelink and the sl-RS-Type is set to dmrs:","paragraph_zero_based":8236},{"literal_text_all_w_t_and_m_t":"3>derive the layer 3 filtered NR sidelink measurement result based on PSSCH DMRS for the trigger quantity and each measurement quantity indicated in sl-ReportQuantity using parameters from the associated sl-MeasObject, as described in 5.8.10.3.2.","paragraph_zero_based":8237},{"literal_text_all_w_t_and_m_t":"2>perform the evaluation of reporting criteria as specified in 5.8.10.4.","paragraph_zero_based":8238},{"literal_text_all_w_t_and_m_t":"5.8.10.3.2Derivation of NR sidelink measurement results","paragraph_zero_based":8239},{"literal_text_all_w_t_and_m_t":"The UE may be configured by the peer UE associated to derive NR sidelink RSRP measurement results per PC5-RRC connection associated to the NR sidelink measurement objects based on parameters configured in the sl-MeasObject and in the sl-ReportConfig.","paragraph_zero_based":8240},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8241},{"literal_text_all_w_t_and_m_t":"1>for each NR sidelink measurement quantity to be derived based on NR sidelink DMRS:","paragraph_zero_based":8242},{"literal_text_all_w_t_and_m_t":"2>derive the corresponding measurement of NR sidelink frequency indicated quantity based on PSSCH DMRS as described in TS 38.215 [9] in the concerned sl-MeasObject;","paragraph_zero_based":8243},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 filtering as described in 5.5.3.2;","paragraph_zero_based":8244},{"literal_text_all_w_t_and_m_t":"5.8.10.4Sidelink measurement report triggering","paragraph_zero_based":8245},{"literal_text_all_w_t_and_m_t":"5.8.10.4.1General","paragraph_zero_based":8246},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8247},{"literal_text_all_w_t_and_m_t":"1>for each sl-MeasId included in the sl-MeasIdList within VarMeasConfigSL:","paragraph_zero_based":8248},{"literal_text_all_w_t_and_m_t":"2>if the sl-ReportType is set to sl-EventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the sl-EventId of the corresponding sl-ReportConfig within VarMeasConfigSL, is fulfilled for NR sidelink frequency for all NR sidelink measurements after layer 3 filtering taken during sl-TimeToTrigger defined for this event within the VarMeasConfigSL, while the VarMeasReportListSL does not include a NR sidelink measurement reporting entry for this sl-MeasId (a first NR sidelink frequency triggers the event):","paragraph_zero_based":8249},{"literal_text_all_w_t_and_m_t":"3>include a NR sidelink measurement reporting entry within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8250},{"literal_text_all_w_t_and_m_t":"3>set the sl-NumberOfReportsSent defined within the VarMeasReportListSL for this sl-MeasId to 0;","paragraph_zero_based":8251},{"literal_text_all_w_t_and_m_t":"3>include the concerned NR sidelink frequency in the sl-FrequencyTriggeredList defined within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8252},{"literal_text_all_w_t_and_m_t":"3>initiate the NR sidelink measurement reporting procedure, as specified in 5.8.10.5;","paragraph_zero_based":8253},{"literal_text_all_w_t_and_m_t":"2>else if the sl-ReportType is set to sl-EventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the sl-EventId of the corresponding sl-ReportConfig within VarMeasConfigSL, is fulfilled for NR sidelink frequency not included in the sl-FrequencyTriggeredList for all NR sidelink measurements after layer 3 filtering taken during sl-TimeToTrigger defined for this event within the VarMeasConfigSL (a subsequent NR sidelink frequency triggers the event):","paragraph_zero_based":8254},{"literal_text_all_w_t_and_m_t":"3>set the sl-NumberOfReportsSent defined within the VarMeasReportListSL for this sl-MeasId to 0;","paragraph_zero_based":8255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d121a8be7db3008124518427dae8c853b2a5f590b9353303a1f10e397c2a0a29","2a582eb2c2d853238f01cced9a4b4d7bac477952ffc7dc45b8ecccab0d7e1dcb","bd7c70370e93aa60bccaad0d7ae24c275d5d1f53c6f94e5068961618ebc6e50c","653f468b44325bfbd893eda3f8448180401530ea808c8a8b3e7acac177824a3a","3954f7f5f4b933f19c2804af3d24b813da33cdf0f26468430ebf82305810bc76","d3aed8593ae2f8694612c787d25fc41264c3f60a40808cf5a35411ec49397d86","763728a4fca11cea4f70decb9f4949906dd041d18eeb1975a05f01eec8ff7be4","6f0ebb8853574f29addc9339be3f47db25d970d6ca5c1dc75ffad6f6aaa69b55","bb71545af5ae0a23b3a142714ca9be6b266fd39799c153561cf37517592b7cbc","8fcc376a813dd21dd0ac71f07314a55812bd5492722a6afe8a688b37ca9c58f2","6dfeaca8e02b9f07f43d4ed3e0ff15fe5101e2850cc296e6ea13f4f3642b9cb1","2a7f396110f5a130401c8cb9628f2d7fad4342f59b0650cb892d39115821cd10","872c25c7698720ae6624b326c5f7d5f7564e09f5ae0161c5e353bbb86d33c4d7","486febd83834a26aa09408de48062181713bacba50c919730387ea8ceef1cf70","301926cee8da67b0f1e62f0b8f354f7e75b08a78af53f84bf222cbc2d2699c93","fbb05e270de0b7893874de69fc20e898d111634e498fd9575adf28ccb431a5ed","25d620d557e087b96f5b82afc9005a66a6751d31083ed1acbe7a27aa2485238b","1e41166f4b91d1e7270732f67eccba64d5d3507aa8e3d6d435e8e9625905a3cb","9550dd19eda3b07088009661243cec7add72a96cba699c11beef1d0da2f0f903","16acdaa96a42f65acd1e261183e5bc554e3b79aac921a5c899eb523c911b6114","d2689df3e2e92843703e3d967e2f70f552d67318cbb3ae09b715a8805ffbc87e","079be8fafcd4a727677d79f286ea769d124a6abb9c46638f6c87828f912bfbcf","219ce5641541e0737439bcfac855ecd272469bce7067ed156fa6cc0ea086c7f0","070bc3112f647a7e137e6f8b78a33e13cb2332c48a7c40a297cfc7e74e535f03"],"paragraph_range_zero_based":[8232,8255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include the concerned NR sidelink frequency in the sl-FrequencyTriggeredList defined within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8256},{"literal_text_all_w_t_and_m_t":"3>initiate the NR sidelink measurement reporting procedure, as specified in 5.8.10.5;","paragraph_zero_based":8257},{"literal_text_all_w_t_and_m_t":"2>else if the sl-ReportType is set to sl-EventTriggered and if the leaving condition applicable for this event is fulfilled for NR sidelink frequency included in the sl-FrequencyTriggeredList defined within the VarMeasReportListSL for this sl-MeasId for all NR sidelink measurements after layer 3 filtering taken during sl-TimeToTrigger defined within the VarMeasConfigSL for this event:","paragraph_zero_based":8258},{"literal_text_all_w_t_and_m_t":"3>remove the concerned NR sidelink frequency in the sl-FrequencyTriggeredList defined within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8259},{"literal_text_all_w_t_and_m_t":"3>if sl-ReportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":8260},{"literal_text_all_w_t_and_m_t":"4>initiate the NR sidelink measurement reporting procedure, as specified in 5.8.10.5;","paragraph_zero_based":8261},{"literal_text_all_w_t_and_m_t":"3>if the sl-FrequencyTriggeredList defined within the VarMeasReportListSL for this sl-MeasId is empty:","paragraph_zero_based":8262},{"literal_text_all_w_t_and_m_t":"4>remove the NR sidelink measurement reporting entry within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8263},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer for this sl-MeasId, if running;","paragraph_zero_based":8264},{"literal_text_all_w_t_and_m_t":"2>if sl-ReportType is set to sl-Periodical and if a (first) NR sidelink measurement result is available:","paragraph_zero_based":8265},{"literal_text_all_w_t_and_m_t":"3>include a NR sidelink measurement reporting entry within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8266},{"literal_text_all_w_t_and_m_t":"3>set the sl-NumberOfReportsSent defined within the VarMeasReportListSL for this sl-MeasId to 0;","paragraph_zero_based":8267},{"literal_text_all_w_t_and_m_t":"3>initiate the NR sidelink measurement reporting procedure, as specified in 5.8.10.5, immediately after the quantity to be reported becomes available for the NR sidelink frequency:","paragraph_zero_based":8268},{"literal_text_all_w_t_and_m_t":"2>upon expiry of the periodical reporting timer for this sl-MeasId:","paragraph_zero_based":8269},{"literal_text_all_w_t_and_m_t":"3>initiate the NR sidelink measurement reporting procedure, as specified in 5.8.10.5.","paragraph_zero_based":8270},{"literal_text_all_w_t_and_m_t":"5.8.10.4.2Event S1 (Serving becomes better than threshold)","paragraph_zero_based":8271},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8272},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition S1-1, as specified below, is fulfilled;","paragraph_zero_based":8273},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition S1-2, as specified below, is fulfilled;","paragraph_zero_based":8274},{"literal_text_all_w_t_and_m_t":"1>for this NR sidelink measurement, consider the NR sidelink frequency corresponding to the associated sl-MeasObject associated with this event.","paragraph_zero_based":8275},{"literal_text_all_w_t_and_m_t":"Inequality S1-1 (Entering condition)","paragraph_zero_based":8276},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":8277},{"literal_text_all_w_t_and_m_t":"Inequality S1-2 (Leaving condition)","paragraph_zero_based":8278},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":8279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["14a64c8f9d90eb0bdf8440ce8f6b818cccc731baf51dadc92309b4c580ba891f","38827659a01677295d2e1cd0c15af7ff2ff41c04c5e7a0ab6a26534fb8cf19b9","6f10f69dcb3228d91a025b0f93fa21e72089adc425f1d230a3e74a42f9d16749","53c7a484cc4d86f21eecd14aabdd13cc5459007492df3b733970a539c949a9f4","3a024e41b6f4ecf6c35237fa83533e1052eb272c861a3c5eb8c0aacd48e9fc94","8575bcd3861d598b2092d146e4101cf34b51eac36654a79e67a998258e11032d","8da05621fe4dfc7ef92870304c8a9a61dfeca6868af033839373170378047b19","90da72200eb66beb3a56e9e86384904fc98523365f2ef2befcbd9bcb93f179d0","36f563d0f8c7a6ad73122dfc1682c93d58747acb49c0815c98f06746caed72e3","dd3f9e2a73ed14281a0f8d09c86910e0ce16cb3c55d1967702fe0d4f5fab0899","4b4f748dce08008375fcf1f0ed1e96a1ac08610802cdbbe6bf41a01689f39230","f9d4f19d44eda24cf7df05d5dece0dc0b590e93de1a655a27510f8286db1198d","1b2ea839564b57153de0d0948ae51664b1aea81d85511c901a49c46ae892080b","b54e7eba711ecc65f595e8b762c689ba1be5ae32e971810e41c3cd358eda9a4d","913e6fc61a121f786be02d10f3344134f90d34a777aff7c6d6df2a28f00c7192","d50b65cb7f31e269faa0e71cfd86b9f820e03ba801ed0f3518c9b5cfc0b29570","27ecc47aa886648572bf8cc81afc7f15d118434f3d1fa55f55e03499356143ba","4ef94f1adfaba2a75c65fc74ef1158c1b6ac835eea85cfd70a54706c1d5b0fe4","299f03bdd910f28abacb1cffab1c84ce90fcd49c4a2e5056a8cf1088284a331a","f945341010b174e89dac9881c1d7757cdc08b7e3069e4b6e8b8b981906f75c4a","d125c0585d3b14ab146b0a833101e8a3159807fb9364d77a3fcd6edf78cfd9ec","2e6f7cca5c5fef700bf02043694346af833a67077808d92aef89e727ef730c77","6338fba2c32bc8217491582e479a114b0cddfe0b4567d88455c84adc48882aac","d4b098216540a74604a32dee129f0cc2dcfdd57d5cf67759fc286d43cbf813fa"],"paragraph_range_zero_based":[8256,8279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8256"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":8280},{"literal_text_all_w_t_and_m_t":"Ms is the NR sidelink measurement result of the NR sidelink frequency, not taking into account any offsets.","paragraph_zero_based":8281},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. sl-Hysteresis as defined within sl-ReportConfig for this event).","paragraph_zero_based":8282},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. s1-Threshold as defined within sl-ReportConfig for this event).","paragraph_zero_based":8283},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP.","paragraph_zero_based":8284},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":8285},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":8286},{"literal_text_all_w_t_and_m_t":"5.8.10.4.3Event S2 (Serving becomes worse than threshold)","paragraph_zero_based":8287},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8288},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition S2-1, as specified below, is fulfilled;","paragraph_zero_based":8289},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition S2-2, as specified below, is fulfilled;","paragraph_zero_based":8290},{"literal_text_all_w_t_and_m_t":"1>for this NR sidelink measurement, consider the NR sidelink frequency indicated by the sl-MeasObject associated to this event.","paragraph_zero_based":8291},{"literal_text_all_w_t_and_m_t":"Inequality S2-1 (Entering condition)","paragraph_zero_based":8292},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":8293},{"literal_text_all_w_t_and_m_t":"Inequality S2-2 (Leaving condition)","paragraph_zero_based":8294},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":8295},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":8296},{"literal_text_all_w_t_and_m_t":"Ms is the NR sidelink measurement result of the NR sidelink frequency, not taking into account any offsets.","paragraph_zero_based":8297},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. sl-Hysteresis as defined within sl-ReportConfig for this event).","paragraph_zero_based":8298},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. s2-Threshold as defined within sl-ReportConfig for this event).","paragraph_zero_based":8299},{"literal_text_all_w_t_and_m_t":"Ms is expressed in dBm in case of RSRP.","paragraph_zero_based":8300},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":8301},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":8302},{"literal_text_all_w_t_and_m_t":"5.8.10.5Sidelink measurement reporting","paragraph_zero_based":8303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["534cbc787b4c482822bfd9efe94227d603fe1f6d0fa8817141ae818f6ed8cc99","cee02af6f8db5e5f218b9db6ed070f2e449f5e858b53e035dd8a5067c3587a67","9a7eeba3b44ff549f153c0ea3035b79d77cf3368daf315a7f8707c94f0e3dd52","eea212e6dce65f92ad9bb2e9790121df47a816f94fc5bb9eb4c64c04a46b1458","1b06654864eaa7f374fb025320394627c30112472a472472ad33e1337c49df98","1d03338a07f365bce03aa8ddfdd964ad82ade638ddaa3bb823839aa1a0001ef4","18e17553dc4aff42a77eeee9987c0233c4e6c774ac1009d5570a8100dc2402d5","e626b4391348115e7c45d7e66f711207ad8ac5629cf4e3167b0da873be7f550d","ff4c47b76a341f681375bf8ac4574a11c9896c3dcab4ba53ffc8567019c96ad6","20e14a97b02b1b87198171e93652821a97874bf0ac0b8bb0100beaa6434f337d","e0446b94347dc1cd44cb00671b78830799cb6c3ccf3a09456ccbfe82f7b013a7","7b2b0e3eb0b9d67e2a4239fa413baf55fa585183fbc2e963e10dbbf61f642f1b","f6a38f1e5e4c3a8ec3d993689be3c65bf9d4412cfafd5b58398a6e9dc5c1fc06","8de3e1a2c4473069c8b0919536afbb78b24b0e50c40f151f7bd82a8318cf6485","c60245230295c96bbc1f206988b562bfa57e5cc6862499fc1d4283caf0a58f3b","879209fbee3f5100245b6e3518374ff0e01c4a2f5cc716eee65cf01be116c019","fd6141b7c3c8cbbbb6311b139df0cba894ea3c221f363365552d5016c87651bf","f30df4225a5cbfeda3d8f197fef44791e8168a3f8051ee1b72c7dbca31073f0e","ac98be46e9e3915afffde06523974aa005386b2a45d06766ae5528ebcc420685","fcc50028e028bd7686f264d0e857ce9edcd6595d3106cda66ecfcd8733349ff3","0781297e406eb0d3611cbbcd9b2645399e4ab6defff0705daf8d037ce4fd6741","052d83f0794baa0363e6fb042395a8845a900d2d774ac71fce4dfc068e70202f","623a2795107f12bb95e7c4be0ba395f2b27adcd90552d54aaa33b93f402f9382","adf6f9dfd4d46e441f00a850afa8d0fc65f916d08ac49c324f03635f41049e9e"],"paragraph_range_zero_based":[8280,8303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8280"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.8.10.5.1General","paragraph_zero_based":8304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8305},{"literal_text_all_w_t_and_m_t":"Figure 5.8.10.5.1-1: NR sidelink measurement reporting","paragraph_zero_based":8306},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer measurement results from the UE to the peer UE associated.","paragraph_zero_based":8307},{"literal_text_all_w_t_and_m_t":"For the sl-MeasId for which the NR sidelink measurement reporting procedure was triggered, the UE shall set the sl-MeasResults within the MeasurementReportSidelink message as follows:","paragraph_zero_based":8308},{"literal_text_all_w_t_and_m_t":"1>set the sl-MeasId to the measurement identity that triggered the NR sidelink measurement reporting;","paragraph_zero_based":8309},{"literal_text_all_w_t_and_m_t":"1>if the sl-ReportConfig associated with the sl-MeasId that triggered the NR sidelink measurement reporting is set to sl-EventTriggered or sl-Periodical:","paragraph_zero_based":8310},{"literal_text_all_w_t_and_m_t":"2>set sl-ResultDMRS within sl-MeasResult to include the NR sidelink DMRS based quantity indicated in the sl-ReportQuantity within the concerned sl-ReportConfig;","paragraph_zero_based":8311},{"literal_text_all_w_t_and_m_t":"1>increment the sl-NumberOfReportsSent as defined within the VarMeasReportListSL for this sl-MeasId by 1;","paragraph_zero_based":8312},{"literal_text_all_w_t_and_m_t":"1>stop the periodical reporting timer, if running;","paragraph_zero_based":8313},{"literal_text_all_w_t_and_m_t":"1>if the sl-NumberOfReportsSent as defined within the VarMeasReportListSL for this sl-MeasId is less than the sl-ReportAmount as defined within the corresponding sl-ReportConfig for this sl-MeasId:","paragraph_zero_based":8314},{"literal_text_all_w_t_and_m_t":"2>start the periodical reporting timer with the value of sl-ReportInterval as defined within the corresponding sl-ReportConfig for this sl-MeasId;","paragraph_zero_based":8315},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":8316},{"literal_text_all_w_t_and_m_t":"2>if the sl-ReportType is set to sl-Periodical:","paragraph_zero_based":8317},{"literal_text_all_w_t_and_m_t":"3>remove the entry within the VarMeasReportListSL for this sl-MeasId;","paragraph_zero_based":8318},{"literal_text_all_w_t_and_m_t":"3>remove this sl-MeasId from the sl-MeasIdList within VarMeasConfigSL;","paragraph_zero_based":8319},{"literal_text_all_w_t_and_m_t":"1>submit the MeasurementReportSidelink message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":8320},{"literal_text_all_w_t_and_m_t":"5.8.11Zone identity calculation","paragraph_zero_based":8321},{"literal_text_all_w_t_and_m_t":"The UE shall determine an identity of the zone (i.e. Zone_id) in which it is located using the following formulae, if sl-ZoneConfig is configured:","paragraph_zero_based":8322},{"literal_text_all_w_t_and_m_t":"x1= Floor (x / L) Mod 64;","paragraph_zero_based":8323},{"literal_text_all_w_t_and_m_t":"y1= Floor (y / L) Mod 64;","paragraph_zero_based":8324},{"literal_text_all_w_t_and_m_t":"Zone_id = y1 * 64 + x1.","paragraph_zero_based":8325},{"literal_text_all_w_t_and_m_t":"The parameters in the formulae are defined as follows:","paragraph_zero_based":8326},{"literal_text_all_w_t_and_m_t":"L is the value of sl-ZoneLength included in sl-ZoneConfig;","paragraph_zero_based":8327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1275647eeb908ce10e2b7aa17127fc6c06edf5c2f463e2bfc0fbd25bd4b96f79","3f4ee9424460fd07ddfa6c2627d3a9569bfc2b0f01893458607831413e1359e8","cd589b8affaff36bc77e31f1136171f313ffb3d8c02ca642fd7d1146c7fecb6a","c5354aef062e655d14f4509129d346d77bfdaa422fee35136a2cfcd749d37472","7f94bb6c01bd067c8283802a9089c13353b1a5eed8a2d87b8f6e87810444b747","825eae9a375de64df221ddfb5ba527c1b4fc9d276956f5d5e6c3926348175304","115f9dc2b5fdff22541eeb7537a3eb4012c05531a5583d6027195921e1cec003","4ee398d4bc87f78e15689326177e42bf214dfa8932025e107a25f2c4f87bb918","8cfe146094ed89dfbe213e8a6ab2b69a5d091e2705551ee75c124d3cdcd0d982","2be08f8737a06548d2eeb0ff3e28e2a8b76cc8398b058e6f45fdde24adfc2b0a","09bc40ddff38d4f615900728329128fc4dcf0abe09e293494fd7f5e69f199d43","1af2b2ce3861d15dd5cb89e591dedc7c5bcf4568f361b6055881a33c2abfe1e1","739b2b2784f7929189fdbe2bc6f3c72ffec74a768ace19ee262df159fe90550d","60ca3e2ef45a8eec7980800b32b0393ca383ebee58380b5c9b490d89598448bc","9e85682f26abb9c8b922e8d99cf83a72c9216e0422cd3d68e5eabe08b066c628","36ce2f5c942f6329fd8df3d2ff3378647772fa366bdf71ff852b6279acd40005","afb92e267283719cd2f4d32e376348e8d73fa014ac248cada8838ac659dd66c0","d0ffdd68469286bf6a20e793bc47196e096097a9fe72a45c5af5af2150bf6418","ddd4ae8863c6645f123d1d35f32d2374827e98dc6bd94311ad2eb8ad2a1d9135","2d6fb00f1735fd054b0534d00fad08e65fa64ab057a3c2acb7f5be227433b7f1","6992c9d101eb9af6a43ee3623d4ad6a53e199a3d0514f61ef072688252eec44b","a838343cf48ad0ef676e73e68f99946fcc9e29bd002dec49dabcb52113258d8d","f60764015ae7b9966766358acadc447913091883459b7c64b20aeb59335d4410","b827538458c59fea2d224401bc06b0718b222dd55646c8690cd35bf8c5ae2db6"],"paragraph_range_zero_based":[8304,8327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8304"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"x is the geodesic distance in longitude between UE's current location and geographical coordinates (0, 0) according to WGS84 model [58] and it is expressed in meters;","paragraph_zero_based":8328},{"literal_text_all_w_t_and_m_t":"y is the geodesic distance in latitude between UE's current location and geographical coordinates (0, 0) according to WGS84 model [58] and it is expressed in meters.","paragraph_zero_based":8329},{"literal_text_all_w_t_and_m_t":"NOTE:How the calculated zone_id is used is specified in TS 38.321 [3].","paragraph_zero_based":8330},{"literal_text_all_w_t_and_m_t":"5.8.12DFN derivation from GNSS","paragraph_zero_based":8331},{"literal_text_all_w_t_and_m_t":"When the UE selects GNSS as the synchronization reference source, the DFN, the subframe number within a frame and slot number within a frame used for NR sidelink communication/discovery are derived from the current UTC time, by the following formulae:","paragraph_zero_based":8332},{"literal_text_all_w_t_and_m_t":"DFN= Floor (0.1*(Tcurrent –Tref–OffsetDFN)) mod 1024","paragraph_zero_based":8333},{"literal_text_all_w_t_and_m_t":"SubframeNumber= Floor (Tcurrent –Tref–OffsetDFN) mod 10","paragraph_zero_based":8334},{"literal_text_all_w_t_and_m_t":"SlotNumber= Floor ((Tcurrent –Tref–OffsetDFN)*2μ) mod (10*2μ)","paragraph_zero_based":8335},{"literal_text_all_w_t_and_m_t":"Where:","paragraph_zero_based":8336},{"literal_text_all_w_t_and_m_t":"Tcurrent is the current UTC time obtained from GNSS. This value is expressed in milliseconds;","paragraph_zero_based":8337},{"literal_text_all_w_t_and_m_t":"Tref is the reference UTC time 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Thursday, December 31, 1899 and Friday, January 1, 1900). This value is expressed in milliseconds;","paragraph_zero_based":8338},{"literal_text_all_w_t_and_m_t":"OffsetDFN is the value sl-OffsetDFN if configured, otherwise it is zero. This value is expressed in milliseconds.","paragraph_zero_based":8339},{"literal_text_all_w_t_and_m_t":"μ=0/1/2/3 corresponding to the 15/30/60/120 kHz of SCS for SL, respectively.","paragraph_zero_based":8340},{"literal_text_all_w_t_and_m_t":"NOTE 1:In case of leap second change event, how UE obtains the scheduled time of leap second change to adjust Tcurrent correspondingly is left to UE implementation. How UE handles to avoid the sudden discontinuity of DFN is left to UE implementation.","paragraph_zero_based":8341},{"literal_text_all_w_t_and_m_t":"NOTE 2:Void.","paragraph_zero_based":8342},{"literal_text_all_w_t_and_m_t":"5.8.13NR sidelink discovery","paragraph_zero_based":8343},{"literal_text_all_w_t_and_m_t":"5.8.13.1General","paragraph_zero_based":8344},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to perform NR sidelink discovery as specified in TS 23.304 [65].","paragraph_zero_based":8345},{"literal_text_all_w_t_and_m_t":"5.8.13.2NR sidelink discovery monitoring","paragraph_zero_based":8346},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink discovery that is configured by upper layers to monitor NR sidelink discovery messages shall:","paragraph_zero_based":8347},{"literal_text_all_w_t_and_m_t":"1>if the frequency used for NR sidelink discovery is included in sl-FreqInfoToAddModList in RRCReconfiguration message and sl-DiscConfig is included in RRCReconfiguration; or if the frequency used for NR sidelink discovery is included in sl-FreqInfoList included in SIB12 and sl-DiscConfigCommon is included in SIB12:","paragraph_zero_based":8348},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with sl-DiscRxPool for NR sidelink discovery reception included in RRCReconfiguration message with reconfigurationWithSync (i.e. handover):","paragraph_zero_based":8349},{"literal_text_all_w_t_and_m_t":"3>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool indicated by sl-DiscRxPool for NR sidelink discovery reception in RRCReconfiguration;","paragraph_zero_based":8350},{"literal_text_all_w_t_and_m_t":"2>else if the UE is configured with sl-RxPool for NR sidelink discovery reception included in RRCReconfiguration message with reconfigurationWithSync (i.e. handover):","paragraph_zero_based":8351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e98fc852d2e649b6a01a5540a87803f43db6c79383e49e7e607ca184dc4ba477","4166318b997ec1c584f547e16030b2b42717784211d768cb5f71a572eecc1102","db016e731b24dfb9c446b0d4fb85c5f536294666db4aab5b253ea49ed351c828","30c50af499d8a7b49b2e60d82a8dfefccf23daa3bca3f81d473522ae116a9c75","efcd3eca3b5c4577620021bbf834f8e10cb9ca89c4932c999f2c2c97da8a8d81","b021597975911d1662e23314761c5289d9d9e7076667934d645a1975c63cce9f","139cd662af339389d3675026200a7d813c2d4ef628b209b2a5ed23da79d1f6fa","0a7ce6977053cbe9fdd1dfb9c1e35e8b8d770f3d42830b0868aee2004907154c","6b0a2bcf8eb4747871ea1c80e6ae6eab52a6fac31ee2901ce9dcf7f229d1494b","36ccec7561f912ba75e75077480a4cf35493ffa7dcc637cc4f7ec1513330f61c","d149a358397c33088703328eba0f3ada9e667615af20d5346904b626c98805c7","9e2b7fd6feef50dae9a80716bd38cb0e94d180e607f693339eeb93684f394aaa","8d142eb785bb60becb0626a78bc3ea1da6624e1758886175708351a29d1fd3d4","d72a92529abc6cd236881c2240cef5bc4b157f70c657d6710041c4f778bd6629","41f743241ec1839f6e40ccd10c76af0e31520d7e778e9cd0b0a77cd15f3df4c1","ea7ed23b1e0887beb1c3243b947bec8d9ba8e1b13836af935e227a7771f64439","b48dc1b870cd3e3cba74116053731462b89f83f22ade459c325a40176864a105","9381139ead5b95e9e5151ba1cb668b3809e100530bffe2c68c75cfe6357ccc31","54d179e8c8b60e1411a73304fb6267e7085e810ccb8830402893d25025caad28","fc03c432723d8fd92bad6e56eebe92f6cbe092a41bb3bb5878da15887fba539a","3e257202b56679e3e959fb065bfdd4bd4e941e287c7fb85b90ee4172acd1e702","18218147cd78a97939769387ea5f03e9bf21bbb3cb4ed381d6b59fdcac163050","09eb9d87f6cc6bb7525753cb2353019e3214c63af42d21a9072b842697b4a7c5","d33292475810bb9f01abcf9b8e9e05652e054c552f6e5f13ce9af6efffbdbc25"],"paragraph_range_zero_based":[8328,8351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8328"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool indicated by sl-RxPool for NR sidelink discovery reception in RRCReconfiguration;","paragraph_zero_based":8352},{"literal_text_all_w_t_and_m_t":"2>else if the cell chosen for NR sidelink discovery reception provides SIB12:","paragraph_zero_based":8353},{"literal_text_all_w_t_and_m_t":"3>if sl-DiscRxPool for NR sidelink discovery reception is included in SIB12:","paragraph_zero_based":8354},{"literal_text_all_w_t_and_m_t":"4>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool indicated by sl-DiscRxPool for NR sidelink discovery reception in SIB12;","paragraph_zero_based":8355},{"literal_text_all_w_t_and_m_t":"3>else if sl-RxPool for NR sidelink discovery reception is included in SIB12:","paragraph_zero_based":8356},{"literal_text_all_w_t_and_m_t":"4>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool indicated by sl-RxPool for NR sidelink discovery reception in SIB12;","paragraph_zero_based":8357},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":8358},{"literal_text_all_w_t_and_m_t":"2>if out of coverage on the concerned frequency for NR sidelink discovery:","paragraph_zero_based":8359},{"literal_text_all_w_t_and_m_t":"3>if sl-DiscRxPool was preconfigured:","paragraph_zero_based":8360},{"literal_text_all_w_t_and_m_t":"4>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool that was preconfigured by sl-DiscRxPool for NR sidelink discovery reception in SL-PreconfigurationNR, as defined in clause 9.3;","paragraph_zero_based":8361},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8362},{"literal_text_all_w_t_and_m_t":"4>configure lower layers to monitor sidelink control information and the corresponding data using the resource pool that was preconfigured by sl-RxPool for NR sidelink discovery reception in SL-PreconfigurationNR, as defined in clause 9.3;","paragraph_zero_based":8363},{"literal_text_all_w_t_and_m_t":"NOTE:If sl-DiscRxPool and sl-RxPool are both included in SIB12 or preconfigured, it is up to UE implementation whether to monitor sidelink control information and the corresponding data using the resource pool indicated by sl-RxPool for NR sidelink discovery reception.","paragraph_zero_based":8364},{"literal_text_all_w_t_and_m_t":"5.8.13.3NR sidelink discovery transmission","paragraph_zero_based":8365},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink discovery that is configured by upper layer to transmit NR sidelink discovery message shall:","paragraph_zero_based":8366},{"literal_text_all_w_t_and_m_t":"1>if the frequency used for NR sidelink discovery is included in sl-FreqInfoToAddModList in sl-ConfigDedicatedNR within RRCReconfiguration message; or if the frequency used for NR sidelink discovery is included in sl-FreqInfoList within SIB12:","paragraph_zero_based":8367},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_CONNECTED and uses the frequency included in sl-ConfigDedicatedNR within RRCReconfiguration message:","paragraph_zero_based":8368},{"literal_text_all_w_t_and_m_t":"3>if the UE is acting as NR sidelink U2N Relay UE and sl-DiscConfig is included in RRCReconfiguration, and if the NR sidelink U2N Relay UE threshold conditions as specified in 5.8.14.2 are met based on sl-RelayUE-Config; or","paragraph_zero_based":8369},{"literal_text_all_w_t_and_m_t":"3>if the UE is selecting NR sidelink U2N Relay UE / has a selected NR sidelink U2N Relay UE/ configured with measurement object associated to L2 U2N Relay UEs and sl-DiscConfig is included in RRCReconfiguration, and if the NR sidelink U2N Remote UE threshold conditions as specified in 5.8.15.2 are met based on sl-RemoteUE-Config; or","paragraph_zero_based":8370},{"literal_text_all_w_t_and_m_t":"3>if the UE is performing NR sidelink non-relay discovery:","paragraph_zero_based":8371},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured with sl-ScheduledConfig:","paragraph_zero_based":8372},{"literal_text_all_w_t_and_m_t":"5>if T310 for MCG or T311 is running; and if sl-TxPoolExceptional is included in sl-FreqInfoList for the concerned frequency in SIB12 or included in sl-ConfigDedicatedNR in RRCReconfiguration; or","paragraph_zero_based":8373},{"literal_text_all_w_t_and_m_t":"5>if T301 is running and the cell on which the UE initiated RRC connection re-establishment provides SIB12 including sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":8374},{"literal_text_all_w_t_and_m_t":"5>if T304 for MCG is running and the UE is configured with sl-TxPoolExceptional included in sl-ConfigDedicatedNR for the concerned frequency in RRCReconfiguration:","paragraph_zero_based":8375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["935de6616a0553624293e50e77fb401b5dd8cb54fc138aef474fcfb89a264757","23661d76885d0143ce17b240d3c0f1a3c21e94ef9de3fe4a6f9af8564e09cbbd","2184cc382cdc58bf5f652da384fc5243657120e9e212a3081948fcfca3dae484","cb0454ef3c7ddfa9c42fda0949894c45de8d207f2b75447bc3483b94a0ed4289","fb67e2574d5cd84bd5d3f691543d9fff3db3ec11691c98c01c65cbf74f4a9924","44ea9d57e7f6cdb24eaac8428c387d18f741d1325c27835bdc0892170cd513e9","525c49bce0888b4f3e24636b8ec328a5406e0a972322382ac298a0d5b84bdc1c","c4378f1f93fe7eca766e0cd98debdc7632525aa5c25e8aab279f382c70612e78","e0253d6ccfef7814f8d02fa3a946322477ce7c5caeb37aeb08a8fc77757c827b","1d9b7898f567b9509daa4e7b0f25a7e2c2a4fdaf8049db1c2b5e6679d2c9fa88","626f272a0dfcd68e52b12c439ba03b6efb2cdbdf4c58f107b16dcc242d7afa99","dd07094976e18c4fbcb6b2e9d57259614871a0c09c90547764cde4d4b95bb7e4","ef0c479b709e8b2b968b3b2313c4202ce64b638fac0a8596391a5568a7a045b8","4ef947a5b3bbf89b744cc136f98fef2588c4ef20ce86cf2e1579f08f96b3b066","a6af864455728aeac9f1fa4d86b5cb730beaf74d01c6322d2c2dce45868cc89f","77ab3dcfe1d07c691c2284d530197bd5fd652e869f5e82ee977422a7b28a92a7","3a77cb36aed0c1079ea36b307bce0b0c12676f4b9cec416f4d59ebbc1fb91e57","c15b23aee533743370f08a650973c94d5cbbd6edec93075e85752f0b379f5fa5","38f46c193ea24c68736a7ed1b36fcdac1051c88323916a8412fd5ea950aa04a3","211cc7f83daeeec418876cfbe010b9856b536b36d28cefbbce4c2b3972cee5ad","b1bf3100433ccde0f3f35a01fde9d906ae0bf7190d129809e3d9b5dcee325bef","d5b33f7cc73435cab20b8c0e404d09efc6afcbede7869be26267866ef6d25e2e","f095009e38c1d182221c615d8cc24fc08d0520c8309976f6667ef2896f61f2fa","5c59132fcfc71a7ca9cb2e205416d2985c8bd87a6e657250bb1968e05ebed9fb"],"paragraph_range_zero_based":[8352,8375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8352"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>configure lower layers to perform the sidelink resource allocation mode 2 based on random selection using the resource pool indicated by sl-TxPoolExceptional as defined in TS 38.321 [3];","paragraph_zero_based":8376},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8377},{"literal_text_all_w_t_and_m_t":"6>configure lower layers to perform the sidelink resource allocation mode 1 using the resource pool indicated by sl-DiscTxPoolScheduling or sl-TxPoolScheduling for NR sidelink discovery transmission on the concerned frequency in RRCReconfiguration;","paragraph_zero_based":8378},{"literal_text_all_w_t_and_m_t":"5>if T311 is running, configure the lower layers to release the resources indicated by rrc-ConfiguredSidelinkGrant (if any);","paragraph_zero_based":8379},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured with sl-UE-SelectedConfig:","paragraph_zero_based":8380},{"literal_text_all_w_t_and_m_t":"5>if the sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency is included in the sl-ConfigDedicatedNR within RRCReconfiguration, and if a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency included in sl-ConfigDedicatedNR within RRCReconfiguration is not available in accordance with TS 38.214 [19]; or","paragraph_zero_based":8381},{"literal_text_all_w_t_and_m_t":"5>if the sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency is not included in the sl-ConfigDedicatedNR within RRCReconfiguration, and a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency included in sl-ConfigDedicatedNR within RRCReconfiguration is not available in accordance with TS 38.214 [19];","paragraph_zero_based":8382},{"literal_text_all_w_t_and_m_t":"6>if sl-TxPoolExceptional for the concerned frequency is included in RRCReconfiguration; or","paragraph_zero_based":8383},{"literal_text_all_w_t_and_m_t":"6>if the PCell provides SIB12 including sl-TxPoolExceptional in sl-FreqInfoList for the concerned frequency:","paragraph_zero_based":8384},{"literal_text_all_w_t_and_m_t":"7>configure lower layers to perform the sidelink resource allocation mode 2 based on random selection using the resource pool indicated by sl-TxPoolExceptional as defined in TS 38.321 [3];","paragraph_zero_based":8385},{"literal_text_all_w_t_and_m_t":"5>else, if the sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency is included in the sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":8386},{"literal_text_all_w_t_and_m_t":"6>configure lower layers to perform the sidelink resource allocation mode 2 based on resource selection operation according to sl-AllowedResourceSelectionConfig (as defined in TS 38.321 [3] and TS 38.214 [19]) using the pools of resources indicated by sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency in RRCReconfiguration;","paragraph_zero_based":8387},{"literal_text_all_w_t_and_m_t":"5>else, if the sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency is included in the sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":8388},{"literal_text_all_w_t_and_m_t":"6>configure lower layers to perform the sidelink resource allocation mode 2 based on resource selection operation according to sl-AllowedResourceSelectionConfig (as defined in TS 38.321 [3] and TS 38.214 [19]) using the pools of resources indicated by sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency in RRCReconfiguration;","paragraph_zero_based":8389},{"literal_text_all_w_t_and_m_t":"2>else if the cell chosen for NR sidelink discovery transmission provides SIB12:","paragraph_zero_based":8390},{"literal_text_all_w_t_and_m_t":"3>if the UE is acting as NR sidelink U2N Relay UE and sl-DiscConfigCommon is included in SIB12, and if the NR sidelink U2N Relay UE threshold conditions as specified in 5.8.14.2 are met based on sl-RelayUE-ConfigCommon in SIB12; or","paragraph_zero_based":8391},{"literal_text_all_w_t_and_m_t":"3>if the UE is selecting NR sidelink U2N Relay UE / has a selected NR sidelink U2N Relay UE and sl-DiscConfigCommon is included in SIB12, and if the NR sidelink U2N Remote UE threshold conditions as specified in 5.8.15.2 are met based on sl-RemoteUE-ConfigCommon in SIB12; or","paragraph_zero_based":8392},{"literal_text_all_w_t_and_m_t":"3>if the UE is performing NR sidelink non-relay discovery:","paragraph_zero_based":8393},{"literal_text_all_w_t_and_m_t":"4>if SIB12 includes sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency, and a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in the sl-DiscTxPoolSelected for NR sidelink discovery transmission is available in accordance with TS 38.214 [19] or random selection, if allowed by sl-AllowedResourceSelectionConfig, is selected:","paragraph_zero_based":8394},{"literal_text_all_w_t_and_m_t":"5>configure lower layers to perform the sidelink resource allocation mode 2 based on resource selection operation according to sl-AllowedResourceSelectionConfig using the pools of resources indicated by sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency in SIB12 as defined in TS 38.321 [3];","paragraph_zero_based":8395},{"literal_text_all_w_t_and_m_t":"4>else if SIB12 includes sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency, and a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in the sl-TxPoolSelectedNormal for NR sidelink discovery transmission is available in accordance with TS 38.214 [19] or random selection, if allowed by sl-AllowedResourceSelectionConfig, is selected:","paragraph_zero_based":8396},{"literal_text_all_w_t_and_m_t":"5>configure lower layers to perform the sidelink resource allocation mode 2 based on resource selection operation according to sl-AllowedResourceSelectionConfig using the pools of resources indicated by sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency in SIB12 as defined in TS 38.321 [3];","paragraph_zero_based":8397},{"literal_text_all_w_t_and_m_t":"4>else if SIB12 includes sl-TxPoolExceptional for the concerned frequency:","paragraph_zero_based":8398},{"literal_text_all_w_t_and_m_t":"5>from the moment the UE initiates RRC connection establishment or RRC connection resume, until receiving an RRCReconfiguration including sl-ConfigDedicatedNR, or receiving an RRCRelease or an RRCReject; or","paragraph_zero_based":8399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["034dd3ca5642506477acce0492d2c2f7bd40e375a485b63f20f4abcc3e1864dd","69bfcd6e8d6dbda945618460743d934cb9bdc686ce8f75810c32a12f1971047e","7ecab9bac42af1eac604de2f99b7a7420d39b727657e1df9ea229e336b1bb4a6","de87d66b67b32d9a06c6df241240a1b2d37205deb95e4e833a1f74a6d4d22521","8871c8daa05388880f8586b6990a354141678d05e01e7b353cf7b25d88493ac5","db6583de7d85d01b151c169687e0b8ee8d9385eb517bec4c0e5355ed67317c70","5a6813ee79b8e65d22b02711c7ae5104945919a37e44f80ac3b8844223e52de6","96e3941edf7b4b12f945975b4e4815ef89b7a8d9ef9cb1d6b26384151efc506e","c522c8c623da4075736bef16ea5d07a1806a0303008df84fd0af934b879d9cd7","a78728140bef6ec0498d3104ef1f9750c94abc6b22ada6e6006ec7ffba3ded5b","7fb81485cee37b4ab61c0c3d8ca2c0eaf01df0162bebb5ab67d6167749fca3e7","55ee8ac3eca8474c103436fbbdaba43854c437e48ff7baef3a776dbdd8b26b5a","26ac3d24c371f636ccf40d333bf3368243a0d04c08e1cdd8089c86710846584e","c18277230b7dd5fd77e6a8d559f62e19d11f36ff6ebbdf164cd9c3031f383971","58164c6f7d5bb5b4aeb629347e7000f5fe2237c8446c3a4da95d2d5a962e4c84","99973df441c226d39579ae2dd42d95e51821fafc70f94dd9a268428aed9c56f1","6d1c6397e81f0ab5f7470434f0e05e84d275bd0371781143dc52596ddc15406e","6d8f8a589c97a3902a57da20646eda0cc5033de0be5a74fde855a74239657f53","88847ca2327d998d34fac2a71b6aab50e7441d7484daa2f035a696db78964f99","a93cfd424aad215c0e4ac450814478c58e20e25ec8312729849b74d2013b7e65","1ea92bee996c76bc99985de974277ca1957307cbfb84976af5d105cac19d2aba","016e1d5835fa8e81e4ac92d09040a6511e29bd1ecf7321575b83adfb885d14d0","3b8327377f053f681d049a5ac02a2bc31dc1730ba33aeb3f3ddb3a751e9a2020","fca0580b6605800d4528732a278ea545205bce41c8d6a716300dc09ef51d2a0c"],"paragraph_range_zero_based":[8376,8399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8376"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency in SIB12 is not available in accordance with TS 38.214 [19]; or","paragraph_zero_based":8400},{"literal_text_all_w_t_and_m_t":"5>if sl-DiscTxPoolSelected for NR sidelink discovery transmission on the concerned frequency is not included in SIB12 and if a result of full/partial sensing, if selected and is allowed by sl-AllowedResourceSelectionConfig, on the resources configured in sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency in SIB12 is not available in accordance with TS 38.214 [19]:","paragraph_zero_based":8401},{"literal_text_all_w_t_and_m_t":"6>configure lower layers to perform the sidelink resource allocation mode 2 based on random selection (as defined in TS 38.321 [3]) using one of the pools of resources indicated by sl-TxPoolExceptional for the concerned frequency;","paragraph_zero_based":8402},{"literal_text_all_w_t_and_m_t":"1>else if out of coverage on the concerned frequency for NR sidelink discovery:","paragraph_zero_based":8403},{"literal_text_all_w_t_and_m_t":"2>if the UE is acting as L3 U2N Relay UE; or","paragraph_zero_based":8404},{"literal_text_all_w_t_and_m_t":"2>if the UE is selecting NR sidelink U2N Relay UE / has a selected NR sidelink U2N Relay UE and if the NR sidelink U2N Remote UE threshold conditions as specified in 5.8.15.2 are met based on sl-PreconfigDiscConfig in SidelinkPreconfigNR; or","paragraph_zero_based":8405},{"literal_text_all_w_t_and_m_t":"2>if the UE is performing NR sidelink non-relay discovery:","paragraph_zero_based":8406},{"literal_text_all_w_t_and_m_t":"3>configure lower layers to perform the sidelink resource allocation mode 2 based on resource selection operation according to sl-AllowedResourceSelectionConfig (as defined in TS 38.321 [3] and TS 38.213 [13]) using the pools of resources indicated in sl-DiscTxPoolSelected or sl-TxPoolSelectedNormal for NR sidelink discovery transmission on the concerned frequency in SidelinkPreconfigNR.","paragraph_zero_based":8407},{"literal_text_all_w_t_and_m_t":"NOTE:It is up to UE implementation to determine, in accordance with TS 38.321[3], which resource pool to use if multiple resource pools are configured, and which resource allocation scheme is used in the AS based on UE capability (for a UE in RRC_IDLE/RRC_INACTIVE) and the allowed resource schemes sl-allowedResourceSelectionConfig in the resource pool configuration.","paragraph_zero_based":8408},{"literal_text_all_w_t_and_m_t":"5.8.14NR sidelink U2N Relay UE operation","paragraph_zero_based":8409},{"literal_text_all_w_t_and_m_t":"5.8.14.1General","paragraph_zero_based":8410},{"literal_text_all_w_t_and_m_t":"This procedure is used by a UE supporting NR sidelink U2N Relay UE operation configured by upper layers to transmit NR sidelink discovery messages to evaluate AS layer conditions.","paragraph_zero_based":8411},{"literal_text_all_w_t_and_m_t":"5.8.14.2NR sidelink U2N Relay UE threshold conditions","paragraph_zero_based":8412},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink U2N Relay UE operation shall:","paragraph_zero_based":8413},{"literal_text_all_w_t_and_m_t":"1>if the threshold conditions specified in this clause were previously not met:","paragraph_zero_based":8414},{"literal_text_all_w_t_and_m_t":"2>if threshHighRelay is not configured; or the RSRP measurement of the PCell, or the cell on which the UE camps, is below threshHighRelay by hystMaxRelay if configured; and","paragraph_zero_based":8415},{"literal_text_all_w_t_and_m_t":"2>if threshLowRelay is not configured; or the RSRP measurement of the PCell, or the cell on which the UE camps, is above threshLowRelay by hystMinRelay if configured:","paragraph_zero_based":8416},{"literal_text_all_w_t_and_m_t":"3>consider the threshold conditions to be met (entry);","paragraph_zero_based":8417},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":8418},{"literal_text_all_w_t_and_m_t":"2>if the RSRP measurement of the PCell, or the cell on which the UE camps, is above threshHighRelay if configured; or","paragraph_zero_based":8419},{"literal_text_all_w_t_and_m_t":"2>if the RSRP measurement of the PCell, or the cell on which the UE camps, is below threshLowRelay if configured;","paragraph_zero_based":8420},{"literal_text_all_w_t_and_m_t":"3>consider the threshold conditions not to be met (leave);","paragraph_zero_based":8421},{"literal_text_all_w_t_and_m_t":"5.8.15NR sidelink U2N Remote UE operation","paragraph_zero_based":8422},{"literal_text_all_w_t_and_m_t":"5.8.15.1General","paragraph_zero_based":8423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["369e1d92ab6967680d587fc2292720f16e1e4ac15d207b8b4ef3941500793293","0721ba2667fe2841c9cf8cfa2132d5abb4ab36276243be2b72329bb73aeeaf4a","80f1ab4dadf3972a36c63ebb114de577f23f7ca114005bccb8f95f625ebee715","25f66c5b35e82a15b640b3b638c3039cb33b7bfd9b717db57905dd5e83f86412","7e7eb012ed2c55709b04b404e910472f3f979087f193c711aa43109e384fa6bc","fb7839a91a9ef97c687b3476adf126f8aa86763bdf210650a5d43ac7d97cae3b","82162d9fb248f738721467eb894942d39eda6cc001e68ea4c451e0e0b9bd5a4c","4a53a6d2c948950492d36468a4d44fa5cf0f004488d32d399d9be087444603ed","039d3b18ce403fe0aa02e20a8f3bb37e8968eb615c2c9df9e514d291a00c4423","9263bf4e1a5798b9a940115393aa0f779560950da13afbe95dc95fc426f58aad","e43a7a2d84ef8e0843c44bd8e431f88481e1e49316e4a8f70222988ccf726142","6f3c8acbd26372c7de72af2649efdf2bface9ac8ca0ba25ff8e34c0d15399426","54ef12e2d7c1f292cc0b8fd044f2012cfe419fab2a6995d9ff9b8fff2d047b77","a3e4c004d62049bb3c222ef5f9f869b67b5cd69f65d8c3810a68f6cb39ababaa","b70b626c0f440d5c292e71c94fee959f062bf24eff999533bb4efcb17df345c2","1763690b67ebb770c0be33880e0fb7e1ab0e6994955829c27fd21be890d6da6b","9ad71d2a1374ed17ed22df56fbf6de39a5b4d11b5aac94a473d1f9aab71b7aee","dca5be58cbedf22f352c44d78d8e487639c9f424737780745fee1804a15b3ef3","18b490a6824cda115cb4ea038355aa672c62ed4afe44fb878d56124a3a9f64af","c08b39e389a33a03c4fc4caf0427b1c0eafabe7144bb6134261fbab7a5a5c52e","10522dc6278c5df17c2f7951c7abca26acdb81edf49fcd4789c24b1d03de4289","911dd2ecb04ac1483f15713fb62b4bad7c592eff4187c67077837489f85d9956","0897f9fa0e1ede12a539ded9f0b03c77ab623bc4b085e969e27d1fec66528475","c13e87ac1f4d6ec0375548a2c611f1ec3f335b4158235f87a6d0b0f5950d05c5"],"paragraph_range_zero_based":[8400,8423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8400"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This procedure is used by a UE supporting NR sidelink U2N Remote UE operation configured by upper layers to transmit NR sidelink discovery message to evaluate AS layer conditions. The procedure is also used to perform selection and reselection of NR sidelink U2N Relay UE.","paragraph_zero_based":8424},{"literal_text_all_w_t_and_m_t":"5.8.15.2NR Sidelink U2N Remote UE threshold conditions","paragraph_zero_based":8425},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink U2N Remote UE operation shall:","paragraph_zero_based":8426},{"literal_text_all_w_t_and_m_t":"1>if the threshold conditions specified in this clause were previously not met:","paragraph_zero_based":8427},{"literal_text_all_w_t_and_m_t":"2>if threshHighRemote is not configured; or the RSRP measurement of the PCell, or the cell on which the UE camps, is below threshHighRemote by hystMaxRemote if configured, or","paragraph_zero_based":8428},{"literal_text_all_w_t_and_m_t":"2> if the UE has no serving cell:","paragraph_zero_based":8429},{"literal_text_all_w_t_and_m_t":"3>consider the threshold conditions to be met (entry);","paragraph_zero_based":8430},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":8431},{"literal_text_all_w_t_and_m_t":"2>if the RSRP measurement of the PCell, or the cell on which the UE camps, is above threshHighRemote if configured:","paragraph_zero_based":8432},{"literal_text_all_w_t_and_m_t":"3>consider the threshold conditions not to be met (leave);","paragraph_zero_based":8433},{"literal_text_all_w_t_and_m_t":"The L2 U2N Remote UE considers the cell indicated by sl-ServingCellInfo in the SL-AccessInfo-L2U2N-r17 received from the connected L2 U2N Relay UE as the PCell/camping cell.","paragraph_zero_based":8434},{"literal_text_all_w_t_and_m_t":"5.8.15.3Selection and reselection of NR sidelink U2N Relay UE","paragraph_zero_based":8435},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink U2N Remote UE operation that is configured by upper layers to search for a NR sidelink U2N Relay UE shall:","paragraph_zero_based":8436},{"literal_text_all_w_t_and_m_t":"1>if the UE has no serving cell; or","paragraph_zero_based":8437},{"literal_text_all_w_t_and_m_t":"1>if the RSRP measurement of the cell on which the UE camps (for L2 and L3 U2N Remote UE in RRC_IDLE or RRC_INACTIVE)/ the PCell (for L3 U2N Remote UE in RRC_CONNECTED) is below threshHighRemote within sl-RemoteUE-Config:","paragraph_zero_based":8438},{"literal_text_all_w_t_and_m_t":"2>if the UE does not have a selected NR sidelink U2N Relay UE; or","paragraph_zero_based":8439},{"literal_text_all_w_t_and_m_t":"2>if the UE has a selected NR sidelink U2N Relay UE, and SL-RSRP of the currently selected NR sidelink U2N Relay UE is available and is below sl-RSRP-Thresh; or","paragraph_zero_based":8440},{"literal_text_all_w_t_and_m_t":"2>if the UE has a selected NR sidelink U2N Relay UE, and SL-RSRP of the currently selected NR sidelink U2N Relay UE is not available, and SD-RSRP of the currently selected U2N Relay UE is below sl-RSRP-Thresh; or","paragraph_zero_based":8441},{"literal_text_all_w_t_and_m_t":"NOTE 1:U2N Remote UE uses SL-RSRP measurements for relay reselection trigger evaluation when there is data transmission from U2N Relay UE to U2N Remote UE, and it is left to UE implementation whether to use SL-RSRP or SD-RSRP for relay reselection trigger evaluation in case of no data transmission from U2N Relay UE to U2N Remote UE. If SD-RSRP is used, the discovery procedure will be performed between the U2N Remote UE and the selected U2N Relay UE.","paragraph_zero_based":8442},{"literal_text_all_w_t_and_m_t":"2>if the UE has a selected NR sidelink U2N Relay UE, and upper layers indicate not to use the currently selected NR sidelink U2N Relay UE; or","paragraph_zero_based":8443},{"literal_text_all_w_t_and_m_t":"2>if the UE has a selected NR sidelink U2N Relay UE, and upper layers request the release of the PC5-RRC connection; or","paragraph_zero_based":8444},{"literal_text_all_w_t_and_m_t":"2>if the UE has a selected NR sidelink U2N Relay UE, and sidelink radio link failure is detected on the PC5-RRC connection with the current U2N Relay UE as specified in clause 5.8.9.3:","paragraph_zero_based":8445},{"literal_text_all_w_t_and_m_t":"3>perform NR sidelink discovery procedure as specified in clause 5.8.13 in order to search for candidate NR sidelink U2N Relay UEs;","paragraph_zero_based":8446},{"literal_text_all_w_t_and_m_t":"4>when evaluating the one or more detected NR sidelink U2N Relay UEs, apply layer 3 filtering as specified in 5.5.3.2 across measurements that concern the same U2N Relay UE ID and using the sl-FilterCoefficientRSRP in SIB12 (if in RRC_IDLE/INACTIVE), the sl-FilterCoefficientRSRP in sl-ConfigDedicatedNR (if in RRC_CONNECTED) or the preconfigured sl-FilterCoefficientRSRP as defined in 9.3 (out of coverage), before using the SD-RSRP measurement results;","paragraph_zero_based":8447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f7263e85febf088c5eadf5bfe2421ec13710b74ac16aeb65e40f4c4dcd3ba28","313781d7a75cd363bb538c2e14a120cfd0e11206653db8870cd501c10644ddbd","0fd9396472edeab8bd44ed20c2804d018212e85c1126f5d7a3e4351e4d03337f","efb57b4c15e68b2855ad8e619077ec2dccbbf49d45127a1dca5b5a2103be76ab","9e13013311cb205e297c749705108e0337cda0903d31af9c6203c8676e8ac971","fedf0ac1a0f603791c7d0f4c2a934c2f62afb98a3b6e68cc919671e50b7f5dae","fa59ee1682c56f49dbeb1f7e7c2fa4c2192c2b85d58de4a78933215855d05ff0","e486c1a45fdb012115c4dff0436b262e6d9f0f839a664d9f1cf4b0b7d23c1648","2fa849bc76cef1452cf67151d682cd40ddccfe87ba9b29f099631d76febba1d1","a2a66c9f5159961ed5e3236c3d3a961b302a26828b5c015dc8749b80e22a403f","68323990ef88ef7048aa30bb0f59324184413c278715f5b28827db2075f8795e","53c66fe8be69ccfd784fda3db29eeb1c87a451fcabf80e52e031e2e7dd39f2bc","ec4bc31d3a8888f27e33b11741f399b4f6eb2039bc0801338ed421bee853d243","17cc7eeda37c5d85a935bff6835eedbf95c6a33858d61e7d9b83eea6038b1ef0","1606864395fa40de41bf8909a01c8e17132edcf200f8629f774066b820b9487b","456ef9434a8ba4b722346b2e6d066215f0d7df2bac8570e5c391466701489da8","6ca04d948272216e33420de08ad0296acd4f118542374151311424f5b9f02b2c","372e203be35b81b8ad46981a2fea47e12e12adc5ecffe5a57ebc004c99305e0c","9cc8d4ed289413675b915b6ec772683789acb973e5257b2e76b4e2c02efa9ff2","28d740e1e1d487baeaa56845f6a2bdd03ae3675d890a7533931f34f4ea9bf234","c4c30074302f2812d33bd134dc747d0521082bbf5c50abf2684a5f5d8d67c858","fb6cd8a5bdbab0e60eb574df3cdfceec70f53db7b594c1e837ef4c795b85c375","dca532340be3b2efcfbeb96958b9a61572e9e0ec952fe54e06ec41b1d91e3c80","f96bd5faaf2ccfa6f691ec2919ec0c44b6d4763c310d4dffac3792edca4a9248"],"paragraph_range_zero_based":[8424,8447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8424"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>consider a candidate NR sidelink U2N Relay UE for which SD-RSRP exceeds sl-RSRP-Thresh by sl-HystMin has met the AS criteria;","paragraph_zero_based":8448},{"literal_text_all_w_t_and_m_t":"3>if the UE detects any suitable NR sidelink U2N Relay UE(s):","paragraph_zero_based":8449},{"literal_text_all_w_t_and_m_t":"4>consider one of the available suitable NR sidelink U2N relay UE(s) can be selected;","paragraph_zero_based":8450},{"literal_text_all_w_t_and_m_t":"NOTE 2:A candidate NR sidelink U2N Relay UE which meets all AS layer criteria defined in 5.8.15.3 and higher layer criteria defined in TS 23.304 [65] can be regarded as suitable NR sidelink U2N Relay UE by the NR sidelink U2N Remote UE. If multiple suitable NR sidelink U2N Relay UEs are available, it is up to Remote UE implementation to choose one NR sidelink U2N Relay UE. The details of the interaction with upper layers are up to UE implementation.","paragraph_zero_based":8451},{"literal_text_all_w_t_and_m_t":"NOTE 3:For L2 U2N Remote UEs in RRC_IDLE/INACTIVE and L3 U2N Remote UEs, the cell (re)selection procedure and relay (re)selection procedure run independently. If both suitable cells and suitable NR sidelink U2N Relay UEs are available, it is up to NR sidelink U2N Remote UE implementation to select either a cell or a NR sidelink U2N Relay UE. Furthermore, L3 U2N Remote UE's selection on both cell and NR sidelink U2N Relay UE is also based on UE implementation.","paragraph_zero_based":8452},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8453},{"literal_text_all_w_t_and_m_t":"4>consider no NR sidelink U2N Relay UE to be selected.","paragraph_zero_based":8454},{"literal_text_all_w_t_and_m_t":"5.9MBS Broadcast","paragraph_zero_based":8455},{"literal_text_all_w_t_and_m_t":"5.9.1Introduction","paragraph_zero_based":8456},{"literal_text_all_w_t_and_m_t":"5.9.1.1General","paragraph_zero_based":8457},{"literal_text_all_w_t_and_m_t":"UE receiving or interested to receive MBS broadcast service(s) applies MBS broadcast procedures described in this clause as well as the MBS Interest Indication procedure as specified in clause 5.9.4.","paragraph_zero_based":8458},{"literal_text_all_w_t_and_m_t":"MBS broadcast configuration information, except CFR configuration for MCCH/MTCH, is provided on MCCH logical channel. MCCH carries the MBSBroadcastConfiguration message which indicates the MBS broadcast sessions that are provided in the cell as well as the corresponding scheduling related information for these sessions. Optionally, the MBSBroadcastConfiguration message may also contain a list of neighbour cells providing the same broadcast MBS service(s) as provided in the current cell. The configuration information required by the UE to receive MCCH is provided in SIB1 and SIB20. Additionally, System Information may provide information related to service continuity of MBS broadcast in SIB21.","paragraph_zero_based":8459},{"literal_text_all_w_t_and_m_t":"5.9.1.2MCCH scheduling","paragraph_zero_based":8460},{"literal_text_all_w_t_and_m_t":"The MCCH information (i.e. information transmitted in messages sent over MCCH) is transmitted periodically, using a configurable repetition period and within a configured transmission window. MCCH transmissions (and the associated radio resources and MCS) are indicated via the PDCCH addressed to MCCH-RNTI. PDCCH monitoring occasion(s) for MCCH transmission are determined according to the common search space indicated by searchspaceMCCH. If searchspaceMCCH is set to zero, PDCCH monitoring occasions for MCCH message reception in the MCCH transmission window are the same as PDCCH monitoring occasions for SIB1 where the mapping between PDCCH monitoring occasions and SSBs is specified in TS 38.213[13]. If searchspaceMCCH is not set to zero, PDCCH monitoring occasions for MCCH message are determined based on search space indicated by searchspaceMCCH. PDCCH monitoring occasions for MCCH message which are not overlapping with UL symbols (determined according to tdd-UL-DL-ConfigurationCommon) are sequentially numbered from one in the MCCH transmission window. The [x×N+K]th PDCCH monitoring occasion for MCCH message in MCCH transmission window corresponds to the Kth transmitted SSB, where x = 0, 1, ...X-1, K = 1, 2, …N, N is the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 and X is equal to CEIL(number of PDCCH monitoring occasions in MCCH transmission window/N). The actual transmitted SSBs are sequentially numbered from one in ascending order of their SSB indexes. The UE assumes that, in the MCCH transmission window, PDCCH for an MCCH message is transmitted in at least one PDCCH monitoring occasion corresponding to each transmitted SSB and thus the selection of SSB for the reception MCCH messages is up to UE implementation.","paragraph_zero_based":8461},{"literal_text_all_w_t_and_m_t":"5.9.1.3MCCH information validity and notification of changes","paragraph_zero_based":8462},{"literal_text_all_w_t_and_m_t":"Change of MCCH information only occurs at specific radio frames, i.e. the concept of a modification period is used. Within a modification period, the same MCCH information may be transmitted a number of times, as defined by its scheduling (which is based on a repetition period).","paragraph_zero_based":8463},{"literal_text_all_w_t_and_m_t":"When the network changes (some of) the MCCH information, it notifies the UEs about the change starting from the beginning of the MCCH modification period via PDCCH which schedules the MCCH in every repetition in that modification period.","paragraph_zero_based":8464},{"literal_text_all_w_t_and_m_t":"Upon receiving a change notification, a UE receiving or interested to receive MBS services transmitted using MBS broadcast acquires the new MCCH information starting from the same slot. The UE applies the previously acquired MCCH information until the UE acquires the new MCCH information. The notification is transmitted with a 2-bit bitmap, see TS 38.212 [17] clause 7.3.1.5.1. The MSB in the 2-bit bitmap, when set to '1', indicates the start of new MBS service(s). The LSB in the 2-bit bitmap, when set to '1', indicates modification of MCCH information other than the change caused by start of new MBS service(s), e.g. modification of a configuration of an on-going MBS session(s), MBS session(s) stop or neighbouring cell information modification.","paragraph_zero_based":8465},{"literal_text_all_w_t_and_m_t":"5.9.2MCCH information acquisition","paragraph_zero_based":8466},{"literal_text_all_w_t_and_m_t":"5.9.2.1General","paragraph_zero_based":8467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8468},{"literal_text_all_w_t_and_m_t":"Figure 5.9.2.1-1: MCCH information acquisition","paragraph_zero_based":8469},{"literal_text_all_w_t_and_m_t":"The UE applies the MCCH information acquisition procedure to acquire the MBS broadcast configuration information broadcasted by the network. The procedure applies to MBS capable UEs interested to receive or that are receiving MBS broadcast services that are in RRC_IDLE, RRC_INACTIVE or RRC_CONNECTED with an active BWP with common search space configured by searchSpaceMCCH.","paragraph_zero_based":8470},{"literal_text_all_w_t_and_m_t":"5.9.2.2Initiation","paragraph_zero_based":8471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b9b5b2abbc949178441b5d2034740f3d15957de0c0ac7972a9cee8b4f06af39c","507fba7f3199053e08ee5697df52d413c000b918ba1878abf9c2db1a495dd038","647578858e9763ac5c9080bfab0a67281c76692510a81069dc2acdbe3dc25993","5cfe09984f463e07952e4a97efe847f9820b72572bb793e8be395432636303d8","ccfce07217392fbf077fa9037b13d8448c8c5ce47077b5831df31cf97017b96e","67c0fa3083adbc04a7bdfab6e97790ab8e7fe2b6d745f45533d66272673544d2","ce33725ffd2f9aa5f7544794227148806f4f71b24f4244e4a2f1a9cb75c0520d","87bc2f302c65b548d0224aad4cc4b31fedd73c2cc511b04aa83cecb2306d6bb7","01da119952e2fbbd215e2ebdcd59e7d549ec0711f10182293bc63a91004be7f1","0ee54b743a56437aa03f98b7dfe1f91d6d99897d4bf439bdd366368ebefa6441","ea727aa0e8e8332f2382b35fad6a52e82e64121a199057750485a14460525a17","5ba3f6054d1b9db8880083b148411ca4f11431cc39e3a2df0e987d454bcb9c29","019d2404a089dfa80a5661d08b9536b66b63dab71d501a285629020cfbde05f0","692d2309ea24dc08156d0202b22d9bc1279b5e02de0163411e8cb82493990bf4","058be5f273c951a2b3d82843580425d4f02f14bce2b1b0d35bdcdf5ea8f9bdf4","3e6282f92f24734cb81fb129da17c870c30c32dea427c9dab43672c17922425e","fb22f9fe868e710ab5d5d9fe6001e1ce51ace4f3c8988697620885ad0e81456c","1b5e5e4281d50a73a202f9da7003ed274c8241452e067aaa9fc92bbe5637c58b","be77cf2cf25474709776a221f497c82924555e87709b2631c11cf149527c3f06","9c8818ef2052aaa30a5ef08358bed0d4ea6761ce20f5660ba5d7a3c8a7088a9e","818e1b64fd37a26c1bcbd9e477a1befe7664110d51caadd6a731c55399af5a03","98c26411a70a6bddcc7e461b8019e96c50e4c5fbef86110445460f49e9a818ec","cbfdcec2133953e7c9c6e2b5dea481709cf0b0497e5a6895136ed9088e1a0342","362167d43b84b852a84c0a1ed9df0371115daf2ae429e8464ef3db0fb6befb23"],"paragraph_range_zero_based":[8448,8471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8448"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE shall apply the MCCH information acquisition procedure upon becoming interested to receive MBS broadcast services. A UE interested to receive MBS broadcast services shall apply the MCCH information acquisition procedure upon entering the cell providing SIB20 (e.g. upon power on, following UE mobility), upon receiving SIB20 of an SCell via dedicated signalling and upon receiving a notification that the MCCH information has changed due to the start of new MBS service(s). A UE that is receiving data via broadcast MRB shall apply the MCCH information acquisition procedure upon receiving a notification that the MCCH information has changed due to MCCH information modification other than the change caused by the start of new MBS service(s).","paragraph_zero_based":8472},{"literal_text_all_w_t_and_m_t":"NOTE 1:It is up to UE implementation how to address a possibility of the UE missing an MCCH change notification.","paragraph_zero_based":8473},{"literal_text_all_w_t_and_m_t":"NOTE 2:It is up to UE implementation to use the cell/tracking area list in the USD to avoid acquiring the MCCH when the UE is outside the MBS service area of the MBS broadcast service.","paragraph_zero_based":8474},{"literal_text_all_w_t_and_m_t":"Unless explicitly stated otherwise in the procedural specification, the MCCH information acquisition procedure overwrites any stored MCCH information, i.e. delta configuration is not applicable for MCCH information and the UE discontinues using a field if it is absent in MCCH information.","paragraph_zero_based":8475},{"literal_text_all_w_t_and_m_t":"5.9.2.3MCCH information acquisition by the UE","paragraph_zero_based":8476},{"literal_text_all_w_t_and_m_t":"An MBS capable UE interested to receive or receiving an MBS broadcast service shall:","paragraph_zero_based":8477},{"literal_text_all_w_t_and_m_t":"1>if the procedure is triggered by an MCCH information change notification:","paragraph_zero_based":8478},{"literal_text_all_w_t_and_m_t":"2>start acquiring the MBSBroadcastConfiguration message on MCCH in the concerned cell from the slot in which the change notification was received;","paragraph_zero_based":8479},{"literal_text_all_w_t_and_m_t":"1>if the UE enters a cell providing SIB20; or","paragraph_zero_based":8480},{"literal_text_all_w_t_and_m_t":"1>if the UE receives sCellSIB20:","paragraph_zero_based":8481},{"literal_text_all_w_t_and_m_t":"2>acquire the MBSBroadcastConfiguration message on MCCH in the concerned cell at the next repetition period.","paragraph_zero_based":8482},{"literal_text_all_w_t_and_m_t":"5.9.2.4Actions upon reception of the MBSBroadcastConfiguration message","paragraph_zero_based":8483},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of the MBSBroadcastConfiguration message apply other than those specified elsewhere e.g. within the corresponding field descriptions.","paragraph_zero_based":8484},{"literal_text_all_w_t_and_m_t":"5.9.3Broadcast MRB configuration","paragraph_zero_based":8485},{"literal_text_all_w_t_and_m_t":"5.9.3.1General","paragraph_zero_based":8486},{"literal_text_all_w_t_and_m_t":"The broadcast MRB configuration procedure is used by the UE to configure PDCP, RLC, MAC and the physical layer upon starting and/or stopping to receive a broadcast MRB transmitted on MTCH, or upon modification of a configuration of a broadcast MRB received by the UE. The procedure applies to MBS capable UEs that are interested to receive or that are receiving an MBS broadcast service that are in RRC_IDLE, RRC_INACTIVE or RRC_CONNECTED with an active BWP with common search space configured by searchSpaceMTCH or searchSpaceMCCH.","paragraph_zero_based":8487},{"literal_text_all_w_t_and_m_t":"NOTE:How to perform a modification of a broadcast MRB which is already configured in the UE is left to UE implementation.","paragraph_zero_based":8488},{"literal_text_all_w_t_and_m_t":"5.9.3.2Initiation","paragraph_zero_based":8489},{"literal_text_all_w_t_and_m_t":"The UE applies the broadcast MRB establishment procedure to start receiving an MBS session of an MBS broadcast service it is interested in. The procedure may be initiated e.g. upon start of the MBS session, upon entering a cell providing an MBS broadcast service the UE is interested in, upon becoming interested in the ongoing MBS broadcast service, upon removal of the UE capability limitations inhibiting reception of the ongoing MBS broadcast service UE is interested in.","paragraph_zero_based":8490},{"literal_text_all_w_t_and_m_t":"The UE applies the broadcast MRB release procedure to stop receiving a session of an MBS broadcast service. The procedure may be initiated e.g. upon stop of the MBS session, upon leaving the cell broadcasting the MBS service the UE is interested in, upon losing interest in the MBS service, when capability limitations start inhibiting reception of the concerned service.","paragraph_zero_based":8491},{"literal_text_all_w_t_and_m_t":"5.9.3.3Broadcast MRB establishment","paragraph_zero_based":8492},{"literal_text_all_w_t_and_m_t":"Upon a broadcast MRB establishment, the UE shall:","paragraph_zero_based":8493},{"literal_text_all_w_t_and_m_t":"1>establish a PDCP entity and an RLC entity in accordance with MRB-InfoBroadcast for this broadcast MRB included in the MBSBroadcastConfiguration message and the configuration specified in 9.1.1.7;","paragraph_zero_based":8494},{"literal_text_all_w_t_and_m_t":"1>configure the MAC layer in accordance with the mtch-SchedulingInfo (if included);","paragraph_zero_based":8495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a3e3e18877a8062df306a311a9461d0ed715987571f9b7d868c25754628e8459","5d1e378261c700c312811e16bdd7ecd1d6d9b4936aaaa9bfec0a0f449084a339","d77f17741b6900fa170cd0be65ce517825c976e416aa3ef479a03eb171fdabef","df47f876ab983a82e09a45dba943accfc838e4ad3b850766e5d6290f2875bad2","7530d962d63aeb39e503e96ddb6db43b361d0ef5651e8691718323578f42919e","2e669e5782236f3f015b413dbc94312bad3a0b48269ab8be6c2f19bb14e23153","7bc3401ffdeaa07e3248dc9e237f9b2ce258f2a22362e0e18100e83d516cb967","e7e0cdb7dd342eddcdf2fb361fc80350325c1a73a1d0b9a63698782f1a434faa","2bba508ae2139f422ef9ce802d7c81dece8350587d67b966ea4954c0b7b9b9b8","819dee1d66ce97d965f33ae39176dc03aa3b5fbb0cf0073c411b333d01789616","91bf1c6224e1d39fe45c1b78510eba1703a6c72b32f5062c1aa19f21c9b08807","dec27e8f010ac7987ac82048c49d92089cac505ee6ec459b6a6fdfe65213cedb","eb3faabe8a1506fff75b685293f8997ecf8befefc6f05ca573a4ef0ba636f630","717fb5460c1cb774790964c3523ce5eefc629cee0177a086564eab318a6a234c","2eb6fbff97e7ea233ee967241794bfccac00dd3aa1584bc7847be19797fa7a9e","20a2ea5c47857837bc3a957632709b356f3db033053e93bf612cc604f5b2b1ae","13259bbe5e661ab891e86beaed797d6b71fb737dd8a0b70bdf44e3cc3d54a5a4","6aa12688dfd4b795f1da10323e334e105f19d060a13be6fdabf0f7640ed10468","5df68a6a650d9882c211d813688d1008b5e9ebf1c19935e15efb49e7b47d123a","e7296ccbcfa44eddbb7312c333ddca228f556c291115cd7490ddeb733bc6f846","2061a8095e7fc8dc18364379c5737b4b7bdb4b135a7622039f46ae35ab95752b","6971ba18863538ca2bdd22d536167e42c67cde3010702fb3aca035daebb6526b","b927802f8fdde687a641c07b0349026e31871ebd134ba6244560e9591fef719e","64a11c7904fe0b9843e390c22059183af4596813b14c1618c8760c6bcdddbe07"],"paragraph_range_zero_based":[8472,8495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8472"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>configure the physical layer in accordance with the mbs-SessionInfoList, searchSpaceMTCH, and pdsch-ConfigMTCH, applicable for the broadcast MRB;","paragraph_zero_based":8496},{"literal_text_all_w_t_and_m_t":"1>if an SDAP entity with the received mbs-SessionId does not exist:","paragraph_zero_based":8497},{"literal_text_all_w_t_and_m_t":"2>establish an SDAP entity as specified in TS 37.324 [24] clause 5.1.1;","paragraph_zero_based":8498},{"literal_text_all_w_t_and_m_t":"2>indicate the establishment of the user plane resources for the mbs-SessionId to upper layers;","paragraph_zero_based":8499},{"literal_text_all_w_t_and_m_t":"1>receive DL-SCH on the cell where the MBSBroadcastConfiguration message was received for the established broadcast MRB using g-RNTI and mtch-SchedulingInfo (if included) in this message for this MBS broadcast service.","paragraph_zero_based":8500},{"literal_text_all_w_t_and_m_t":"5.9.3.4Broadcast MRB release","paragraph_zero_based":8501},{"literal_text_all_w_t_and_m_t":"Upon broadcast MRB release for MBS broadcast service, the UE shall:","paragraph_zero_based":8502},{"literal_text_all_w_t_and_m_t":"1>release the PDCP entity, RLC entity as well as the related MAC and physical layer configuration;","paragraph_zero_based":8503},{"literal_text_all_w_t_and_m_t":"1>if the SDAP entity associated with the corresponding mbs-SessionId has no associated MRB:","paragraph_zero_based":8504},{"literal_text_all_w_t_and_m_t":"2>release the SDAP entity, as specified in TS 37.324 [24] clause 5.1.2;","paragraph_zero_based":8505},{"literal_text_all_w_t_and_m_t":"2>indicate the release of the user plane resources for the mbs-SessionId to upper layers.","paragraph_zero_based":8506},{"literal_text_all_w_t_and_m_t":"5.9.4MBS Interest Indication","paragraph_zero_based":8507},{"literal_text_all_w_t_and_m_t":"5.9.4.1General","paragraph_zero_based":8508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8509},{"literal_text_all_w_t_and_m_t":"Figure 5.9.4.1-1: MBS Interest Indication","paragraph_zero_based":8510},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform the network that the UE in RRC_CONNECTED is receiving or is interested to receive MBS broadcast service(s) and to inform the network about the priority of MBS broadcast versus unicast and multicast MRB reception. MBS Interest Indication can only be sent after AS security activation.","paragraph_zero_based":8511},{"literal_text_all_w_t_and_m_t":"5.9.4.2Initiation","paragraph_zero_based":8512},{"literal_text_all_w_t_and_m_t":"An MBS capable UE in RRC_CONNECTED may initiate the procedure in several cases including upon successful connection establishment/resume, upon entering or leaving the broadcast service area, upon MBS broadcast session start or stop, upon change of interest, upon change of priority between MBS broadcast reception and unicast/multicast reception, upon change to a PCell providing SIB21 (i.e. where the SIB1 scheduling information contains SIB21), upon receiving SIB20 of an SCell via dedicated signalling, upon handover, and upon RRC connection re-establishment.","paragraph_zero_based":8513},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":8514},{"literal_text_all_w_t_and_m_t":"1>if SIB21 is provided by the PCell:","paragraph_zero_based":8515},{"literal_text_all_w_t_and_m_t":"2>ensure having a valid version of SIB21 for the PCell;","paragraph_zero_based":8516},{"literal_text_all_w_t_and_m_t":"2>if the UE did not transmit MBS Interest Indication since last entering RRC_CONNECTED state; or","paragraph_zero_based":8517},{"literal_text_all_w_t_and_m_t":"2>if since the last time the UE transmitted an MBS Interest Indication, the UE connected to a PCell not providing SIB21:","paragraph_zero_based":8518},{"literal_text_all_w_t_and_m_t":"3>if the set of MBS broadcast frequencies of interest, determined in accordance with 5.9.4.3, is not empty:","paragraph_zero_based":8519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02bb6ced3681b1ebbfdc24fad21bf137f4a02ee4030edd0221ef779f7fbc47f5","a54bd7b1c3f1d0dd05589a0889cf888c01cf625b6e65dd895abc3fdc6585de72","82b664fd8609c94ea3eb5d6ea5c8ab821fbd507a5e091534c3ddd26bcd7ad209","5a3b1c93d4c7277a30276db5d140eafbe29a5c933e6979bf30a48a4450c92235","bfe5293434b22eb48bdc47c8a5d790706d608206e9ccfdcaa32c059d521b6266","0bf38ac598881fdea254bf485a53ad0db4aabefd5df63a981bd61aecdc5b61f9","5fb584830c3666d4077cd02e376a69c34c1ae34e92b6822d7d1a129832ebbbc8","142d26eab0941fb001d5db4d7090f71d4260b6bb081c3c1ed079157aa7023a24","2f926eae24f7adfa5c71dc65fa138805e9dc5697666bcd29a43b9a44f85b8ab7","ce9e99ee32a4e71e146832626130d022d223728d3adbd2436f079a0d856460ab","8e1a432d38e8c167420ada3f0a856a0c3d43e72683c1b49c81cad7b61432690a","be47f8f271a0f00c7409ca0cd0cbed2c212d736be528353f7234100c7553d565","c46c7e0ce9421b4ee1927358141cd564f7bbaa183ffa75b6ec9da1e3595b4c3d","032ef42a09105b3b7f3881c702db41f3fb533cc5ad8c865d033107f7c2b4f0c3","07fe3eeada776c6650bdd43b2bd76553a087c39f69d57cdb7feded170bbffa4d","94284cc43cb121d6fee094aed23f7a57c6920d66d2171350dd28f48f9e12a4d2","f2c19c37fc8d37d6e271e1a9337d0e8dcae43b078ca2c0a5bcecac1382b3bed5","a2384e1bd5799f90f31fc84b158e2f1f756dea30365ade1e9a7a819d52f7fbdd","2a9b38df9490c33ef84a2fb45542d8eeca8404983672a40eea4c738b87d753cb","d40fd744574d64d3923187d56cde51037b7756dfdb0ac816039e7954b1b59672","f90d05e3a9555c14f860d6008a0839634d762ed14fa0b39839e1147281c866f6","534f68a4dabf70469f528e559f11f5c12e98b3571ecb3dc627b71325869ba032","f138bfea14b754e06b55920bf1014727d5b8b233a1c3ce4e24525fbca6334fc0","172a5a363eb63914143b365a36c420591321965ccd6c07cb011bb588cce70dbc"],"paragraph_range_zero_based":[8496,8519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8496"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set the contents of MBS Interest Indication according to 5.9.4.5 and initiate transmission of the MBSInterestIndication message;","paragraph_zero_based":8520},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":8521},{"literal_text_all_w_t_and_m_t":"3>if the set of MBS broadcast frequencies of interest, determined in accordance with 5.9.4.3, is different from mbs-FreqList included in the last transmission of the MBS Interest Indication; or","paragraph_zero_based":8522},{"literal_text_all_w_t_and_m_t":"3>if the prioritisation of reception of all indicated MBS broadcast frequencies compared to reception of any of the established unicast bearers and multicast MRBs has changed since the last transmission of the MBS Interest Indication:","paragraph_zero_based":8523},{"literal_text_all_w_t_and_m_t":"4>set the contents of MBS Interest Indication according to 5.9.4.5 and initiate transmission of the MBSInterestIndication message;","paragraph_zero_based":8524},{"literal_text_all_w_t_and_m_t":"NOTE:The UE may send MBS Interest Indication even when it is able to receive the MBS services it is interested in, i.e. to avoid that the network allocates a configuration inhibiting MBS broadcast reception.","paragraph_zero_based":8525},{"literal_text_all_w_t_and_m_t":"3>else if SIB20 is provided for the PCell or for the SCell:","paragraph_zero_based":8526},{"literal_text_all_w_t_and_m_t":"4>if since the last time the UE transmitted the MBS Interest Indication, the UE connected to a PCell not providing SIB20 and the UE was not provided with SIB20 for an SCell; or","paragraph_zero_based":8527},{"literal_text_all_w_t_and_m_t":"4>if the set of MBS broadcast services of interest determined in accordance with 5.9.4.4 is different from mbs-ServiceList included in the last transmission of the MBS Interest Indication:","paragraph_zero_based":8528},{"literal_text_all_w_t_and_m_t":"5>set the contents of MBS Interest Indication according to 5.9.4.5 and initiate the transmission of MBSInterestIndication message.","paragraph_zero_based":8529},{"literal_text_all_w_t_and_m_t":"5.9.4.3MBS frequencies of interest determination","paragraph_zero_based":8530},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8531},{"literal_text_all_w_t_and_m_t":"1>consider a frequency to be part of the MBS frequencies of interest if the following conditions are met:","paragraph_zero_based":8532},{"literal_text_all_w_t_and_m_t":"2>at least one MBS session the UE is receiving or interested to receive via a broadcast MRB is ongoing or about to start; and","paragraph_zero_based":8533},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may determine whether the session is ongoing from the start and stop time indicated in the User Service Description (USD), see TS 38.300 [2] or TS 23.247 [67].","paragraph_zero_based":8534},{"literal_text_all_w_t_and_m_t":"2>for at least one of these MBS sessions, SIB21 acquired from the PCell includes mapping between the concerned frequency and one or more MBS FSAIs indicated in the USD for this session, or for at least one of these MBS sessions, the concerned frequency is not included in SIB21 but is indicated in the USD for this session; and","paragraph_zero_based":8535},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE considers a frequency to be part of the MBS frequencies of interest even though NG-RAN may (temporarily) not employ a broadcast MRB for the concerned session, i.e., the UE does not verify if the session is indicated on MCCH.","paragraph_zero_based":8536},{"literal_text_all_w_t_and_m_t":"2>the supportedBandCombinationList the UE included in UE-NR-Capability contains at least one band combination including the concerned MBS frequency.","paragraph_zero_based":8537},{"literal_text_all_w_t_and_m_t":"NOTE 3:When evaluating which frequencies the UE is capable of receiving, the UE does not take into account whether they are currently configured as serving frequencies.","paragraph_zero_based":8538},{"literal_text_all_w_t_and_m_t":"5.9.4.4MBS services of interest determination","paragraph_zero_based":8539},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8540},{"literal_text_all_w_t_and_m_t":"1>consider an MBS service to be part of the MBS services of interest if the following conditions are met:","paragraph_zero_based":8541},{"literal_text_all_w_t_and_m_t":"2>the UE is receiving or interested to receive this service via a broadcast MRB; and","paragraph_zero_based":8542},{"literal_text_all_w_t_and_m_t":"2>the session of this service is ongoing or about to start; and","paragraph_zero_based":8543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d91dbc3cde7f9dda824a0897b34079afa8529a0d5d80b83f0a4312c1ad01973b","23a00f8de91a0164ca312ce7a52a8edf1de97e90f3ff227c88ecc227158d1d64","40462e53f2414dcbd78bffce4042d778f11d7c2a2e4b738103531656b6930523","c11ee720bd94593171f9eb95bd40a64d27574fc1a84a13edfea7c5eb1d342481","7930dec1415e17a1ab379541e24459a3f1debf0d094a177243aff9f77ba3317c","b90f1f6c0538464370b7c58bef6b6853d9c3340d4ef71eb172c3fe8845ea8b7b","7036bb2021f3dc8d739e87dccaec81da7ffeefeb98b0ee41f9cf69b9b06e1402","e3be1e58f2ca277da2f6bff2e6d94b8ba63e61f91d13811337aa2a869ff77ffd","4d6b9a0ddc5e0386e1243c1fe43bbd86a9bf56feddb1cdcdb553266c2371a171","cbdd3cf006cc4c8981de13fe85071867d71edd4f0eb2d332fed7efbf2b0587c4","5da1c601fde89441987d6bcf7fe105a0a246fc1acf5de8d83ca94efec4faf2db","060fda66f679c3912abaf55cda0531431134a0e115f15f917b5f5034ca706033","8a5d9996a3836edc577e0ef17d6b648a5c7479a52e2aeb27efbd0fce4941db56","847f159ad643473d80939c44f710e09c760ce53e79831d218d4a16526b1ed0d0","f0f77add8f232fb87375f4c7351079ab43113216de34d7f311e1a763b0dff868","48abee8c1d4a4a7fd7f79dc92132e23edd9b49bb2c47e1c17f1b965874da246d","cdae9809bfcc38a741725382a36401f312bde79d162581214f6024035227cf44","adf56e16c61917968f727fecf3515925acbb5de01248f29f97d9ebedef0d0ae7","1a9a929ba1270ecbec081548bf7cc9814a9416c64d20ef199a8a6525bc1e016b","8d9529c7fa5caf2483441a4651a58085665db59b4bbe6c5d15e20538d6cfebef","d80bb290cea8983585fa9257c2fc130be0ef0bd3d79e9b87f561fd6603315db8","c41faff4cf7adbc5003b5e86eb3cde7b26a80927424856f6f25bb8744f12e8dd","d6cb23bddfc1bb41112e123138e8f938c19d26700365f8efbe941d9ca5b3a89a","056d645b1e458d133c17ca2dc7655faa1a45b81df5a8146a24f67f3d603d148f"],"paragraph_range_zero_based":[8520,8543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8520"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>one or more MBS FSAIs in the USD for this service is included in SIB21 acquired from the PCell for a frequency belonging to the set of MBS frequencies of interest, determined according to 5.9.4.3 or SIB21 acquired from the PCell does not provide the frequency mapping for the concerned service but that frequency is included in the USD of this service.","paragraph_zero_based":8544},{"literal_text_all_w_t_and_m_t":"NOTE:The UE may determine whether the session is ongoing from the start and stop time indicated in the User Service Description (USD), see TS 38.300 [2] or TS 23.247 [67].","paragraph_zero_based":8545},{"literal_text_all_w_t_and_m_t":"5.9.4.5Setting of the contents of MBS Interest Indication","paragraph_zero_based":8546},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MBS Interest Indication as follows:","paragraph_zero_based":8547},{"literal_text_all_w_t_and_m_t":"1>if the set of MBS frequencies of interest, determined in accordance with 5.9.4.3, is not empty:","paragraph_zero_based":8548},{"literal_text_all_w_t_and_m_t":"2>include mbs-FreqList and set it to include the MBS frequencies of interest sorted by decreasing order of interest, using the absoluteFrequencySSB for serving frequency, if applicable, and the ARFCN-ValueNR(s) as included in SIB21 or in USD (for neighbouring frequencies);","paragraph_zero_based":8549},{"literal_text_all_w_t_and_m_t":"2>include mbs-Priority if the UE prioritises reception of all indicated MBS frequencies above reception of any of the unicast bearers and multicast MRBs;","paragraph_zero_based":8550},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the UE prioritises MBS broadcast reception and unicast/multicast data cannot be supported because of congestion on the MBS carrier(s), NG-RAN may for example initiate release of unicast bearers/multicast MRBs.","paragraph_zero_based":8551},{"literal_text_all_w_t_and_m_t":"2>if SIB20 is provided for the PCell or for the SCell:","paragraph_zero_based":8552},{"literal_text_all_w_t_and_m_t":"3>include mbs-ServiceList and set it to indicate the set of MBS services of interest sorted by decreasing order of interest determined in accordance with 5.9.4.4.","paragraph_zero_based":8553},{"literal_text_all_w_t_and_m_t":"NOTE 2:The mbs-ServiceList is not required to be used by the NG-RAN to determine the frequency on which to enable MBS broadcast reception for the UE.","paragraph_zero_based":8554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8555},{"literal_text_all_w_t_and_m_t":"6Protocol data units, formats and parameters (ASN.1)","paragraph_zero_based":8556},{"literal_text_all_w_t_and_m_t":"6.1General","paragraph_zero_based":8557},{"literal_text_all_w_t_and_m_t":"6.1.1Introduction","paragraph_zero_based":8558},{"literal_text_all_w_t_and_m_t":"The contents of each RRC message is specified in clause 6.2 using ASN.1 to specify the message syntax and using tables when needed to provide further detailed information about the fields specified in the message syntax. The syntax of the information elements that are defined as stand-alone abstract types is further specified in a similar manner in clause 6.3.","paragraph_zero_based":8559},{"literal_text_all_w_t_and_m_t":"Usage of the text \"Network always configures the UE with a value for this field\" in the field description indicates that the network has to provide a value for the field in this or in a previous message based on delta configuration (for an optional field with Need M). It does not imply a mandatory presence of the field.","paragraph_zero_based":8560},{"literal_text_all_w_t_and_m_t":"6.1.2Need codes and conditions for optional fields","paragraph_zero_based":8561},{"literal_text_all_w_t_and_m_t":"The need for fields to be present in a message or an abstract type, i.e., the ASN.1 fields that are specified as OPTIONAL in the abstract notation (ASN.1), is specified by means of comment text tags attached to the OPTIONAL statement in the abstract syntax. All comment text tags are available for use in the downlink direction for RRC message and in the sidelink for PC5 RRC message. The meaning of each tag is specified in table 6.1.2-1.","paragraph_zero_based":8562},{"literal_text_all_w_t_and_m_t":"If conditions are used, a conditional presence table is provided for the message or information element specifying the need of the field for each condition case. The table also specifies whether UE maintains or releases the value in case the field is absent. The conditions clarify what the UE may expect regarding the setting of the message by the network for the RRC message or by the peer UE in the sidelink RRC message. Violation of conditions is regarded as invalid network behaviour when transmitting downlink RRC message or invalid UE behavior when transmitting PC5 RRC message, which the UE is not required to cope with. Hence the general error handling defined in 10.4 does not apply in case a field is absent although it is mandatory according to the CondC or CondM condition.","paragraph_zero_based":8563},{"literal_text_all_w_t_and_m_t":"For guidelines on the use of need codes and conditions, see Annex A.6 and A.7.","paragraph_zero_based":8564},{"literal_text_all_w_t_and_m_t":"Table 6.1.2-1: Meaning of abbreviations used to specify the need for fields to be present","paragraph_zero_based":8565},{"literal_text_all_w_t_and_m_t":"Abbreviation","paragraph_zero_based":8566},{"literal_text_all_w_t_and_m_t":"Meaning","paragraph_zero_based":8567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e50f72945a954e1807d7390a3e5f880076b4f87daf9506d21cbc6c3f172f1598","13df635609f727b306a0c72a314592800b5658481b18c512fdbfb3d2d74a658f","24ceb34f05c3a03de0e25181714ec8a8edd1b8a62a746b115f89b78c888a32a7","3d8ff2817d73fcbea961efd44271ee381c661915b3fe3adf59e0a3c4fc95dcba","03f0b52b6de2ed49cda9379f1a636f2634dffdf503f8579050c9b549cb6bea8f","ea93fc319d40bb5847c1bcc449feab508047403efdd1085b280c54fc69491e7e","e48e568c4403ccf135b6534b92b9e08d08ace9c55f8646f00c349d7642f98ba1","86e61ae59e32ce9b2a9fb954d5fb5a84083f26bae4100b1a4e9902a3cdbd3cfd","3bb3479805748e84f163fab81c1a6f140d6e1350525cda83797095e7ff2d9ee0","8b250451961b76aec49817af197a785bfbd7006c44d190a8164cee2830b72843","c31c353b7a4a530f433126f743f08f73a847f2ee36636703cd0b66385230518c","486ddfe293b34b898f9c854faa380a838919cb633e7d09d54d36044d06326cf4","f6f17a52a61ce1309f7f1a58ff8cca9cf6210862f9bad2c6b67fe08ce79e7231","411a39e773f10cd20b0412c04483f2dad2824d512eb090c6bf7d687894a0772a","d8c9c0c1b02f36a115338e77d7791f07e992b2652b59cce006f5ef3ecf3fcbb5","64b5c5ee1a708abf07eebee1f46b341aeae660a297e5c25b1b0b993f39439e68","76c58dfae9ec22d6465c71a3f4bc0af883fa6ca537e22601c6673976faab4b81","1d480ebf31a211d7b535eb6d22553184e57becf5a56001f603378c57bb01d6bf","d9fa42c2bc2266a28c6ba4315816088705ffc4cc16ac5413bf71eddd1b63604c","a16024cf1c61aa98e1897201b565e5dfa98f41e3e7fa11cc9404d076d978a170","e7ae96827c6db5e9cf42b77856f929257cb6e2c8fc069ab56272d8485d85c650","b59f65f343d7f61a3cca50b4a311f560f16a76fab4f2d85c45a7b1e1044c6f70","fdb2adc0348a8d84fdc3255ebb86cb858b77639526dfe1d0e0d618651d0e53a3","2c3f1ca4f1d58d6d866dd090dbbb234879cf5d9df1caf9cbb6e5bae83f349eb4"],"paragraph_range_zero_based":[8544,8567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8544"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Cond conditionTag","paragraph_zero_based":8568},{"literal_text_all_w_t_and_m_t":"Conditionally present","paragraph_zero_based":8569},{"literal_text_all_w_t_and_m_t":"Presence of the field is specified in a tabular form following the ASN.1 segment.","paragraph_zero_based":8570},{"literal_text_all_w_t_and_m_t":"CondC conditionTag","paragraph_zero_based":8571},{"literal_text_all_w_t_and_m_t":"Configuration condition","paragraph_zero_based":8572},{"literal_text_all_w_t_and_m_t":"Presence of the field is conditional to other configuration settings.","paragraph_zero_based":8573},{"literal_text_all_w_t_and_m_t":"CondM conditionTag","paragraph_zero_based":8574},{"literal_text_all_w_t_and_m_t":"Message condition","paragraph_zero_based":8575},{"literal_text_all_w_t_and_m_t":"Presence of the field is conditional to other fields included in the message.","paragraph_zero_based":8576},{"literal_text_all_w_t_and_m_t":"Need S","paragraph_zero_based":8577},{"literal_text_all_w_t_and_m_t":"Specified","paragraph_zero_based":8578},{"literal_text_all_w_t_and_m_t":"Used for (configuration) fields, whose field description or procedure specifies the UE behavior performed upon receiving a message with the field absent (and not if field description or procedure specifies the UE behavior when field is not configured).","paragraph_zero_based":8579},{"literal_text_all_w_t_and_m_t":"Need M","paragraph_zero_based":8580},{"literal_text_all_w_t_and_m_t":"Maintain","paragraph_zero_based":8581},{"literal_text_all_w_t_and_m_t":"Used for (configuration) fields that are stored by the UE i.e. not one-shot. Upon receiving a message with the field absent, the UE maintains the current value.","paragraph_zero_based":8582},{"literal_text_all_w_t_and_m_t":"Need N","paragraph_zero_based":8583},{"literal_text_all_w_t_and_m_t":"No action (one-shot configuration that is not maintained)","paragraph_zero_based":8584},{"literal_text_all_w_t_and_m_t":"Used for (configuration) fields that are not stored and whose presence causes a one-time action by the UE. Upon receiving message with the field absent, the UE takes no action.","paragraph_zero_based":8585},{"literal_text_all_w_t_and_m_t":"Need R","paragraph_zero_based":8586},{"literal_text_all_w_t_and_m_t":"Release","paragraph_zero_based":8587},{"literal_text_all_w_t_and_m_t":"Used for (configuration) fields that are stored by the UE i.e. not one-shot. Upon receiving a message with the field absent, the UE releases the current value.","paragraph_zero_based":8588},{"literal_text_all_w_t_and_m_t":"NOTE:In this version of the specification, the condition tags CondC and CondM are not used.","paragraph_zero_based":8589},{"literal_text_all_w_t_and_m_t":"Any field with Need M or Need N in system information shall be interpreted as Need R.","paragraph_zero_based":8590},{"literal_text_all_w_t_and_m_t":"The need code used within a CondX definition only applies for the case (part of the condition) where it is defined: A condition may have different need codes for different parts of the condition. In particular, the CondX definition may contain the following \"otherwise the field is absent\" parts:","paragraph_zero_based":8591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ead0dd3e6debcfadf772dbffe04d247718f6a9d2a60d32b19c1dd37a71661fee","130d93e6a00181039d23fb7ca5b0b04c1a66f5e9a9902d45bab837ba4cd84d7b","52112fb833f801a019e8dedd438eebc10128d2a8efa7e1d7955a53532d69dc39","b39e3461f242fb90b51412d5ee45e59a36bc69d7f29c8583cb19cd4e04537389","b9229b155aaba3909d6385e3dbe73bf716c9e763e7018a2550f87818eb7da9a7","26eaf65218a5c1ef38f3efab5bfa8d6a4863091b9ebc2eec2d7ff5d3664b24ee","6d59168a8c1f7d107bd3a9354a48fb280a82d5aee36d6766c9f7d56505000555","44474fb37a504db4988333bae018c55fb9e7fd1b5df8c96df6e8eecc5ad1f208","b00193d837166d4092a567fccb71dc27c123a25c7dd9b2861ad9a95e75d36c45","a2bbe1551a7e7e13b0ab0f709cbeb10309060f75dcd2be76ee34c70b6579476d","aeddbbdc3209fb5acddb0676c189adc11b61380c7eebd9af13d2708d9edbd5f9","6992e2a5ebff376c57b84521c303905bdb3cb6ccbe821c0d4d043ca2f12b8ab2","2760dd7f7e2878f36ebd97e2aea389f9d9219d6c4d4c7ad5e44e63cbeb517ad9","b386d9adf1a3e9fc511146cf8a6bd1e7c2dade706ad5b5de2715ff17395d081e","0dd810e2589805754e10a794e6693961e3430c1362155627793a6661ce5ef823","b004e5cd2082d5c9146672517df658d9179aea142c4e6c6930f283c8002ab184","9efc00bdbf4703e9ee6d32a808d528be06650f86a7a5b75c1c7dd87b9e41a858","8bbc1fd2137efe62d4f2a20b18185cd88492af9d02945f532d985cfecab8966e","31cd0c480d76066b470cf1d6f311363188c46ddaf3d5e9ad1d9e106305739d00","bb82a83dc7d566d8e0f92d2f2865bc22cfa92f30b6d4fa2902475e596747f135","c7e7bb08a354a395cb552a555eabcf72f917407ece9f80d73407ba7c24d0a9ac","4f8ff36e8a3c2b3225d1ac792ce96d5e0adcdd80b32ffe46f4f61d1011494412","7d1e9903ae3f0cc360df3f8d3e83d9ba4a55af2f8cde39b85d0cdb2218e55ef4","6d8f97b0b9cbaa3806b25be2a2b7876fc12505530d876924baff37435b52ee8b"],"paragraph_range_zero_based":[8568,8591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-\"Otherwise, the field is absent\": The field is not relevant or should not be configured when this part of the condition applies. In particular, the UE behaviour is not defined when the field is configured via another part of the condition and is reconfigured to this part of the condition. A need code is not provided when the transition from another part of the condition to this part of the condition is not supported, when the field clearly is a one-shot or there is no difference whether UE maintains or releases the value (e.g., in case the field is mandatory present according to the other part of the condition).","paragraph_zero_based":8592},{"literal_text_all_w_t_and_m_t":"-\"Otherwise, the field is absent, Need R\": The field is released if absent when this part of the condition applies. This handles UE behaviour in case the field is configured via another part of the condition and this part of the condition applies (which means that network when transmitting downlink RRC message or peer UE transmitting PC5 RRC message can assume UE releases the field if this part of the condition is valid).","paragraph_zero_based":8593},{"literal_text_all_w_t_and_m_t":"-\"Otherwise, the field is absent, Need M\": The UE retains the field if it was already configured when this part of the condition applies. This means the network when transmitting downlink RRC message or the peer UE when transmitting PC5 RRC message cannot release the field, but UE retains the previously configured value.","paragraph_zero_based":8594},{"literal_text_all_w_t_and_m_t":"Use of different Need codes in different parts of a condition should be avoided.","paragraph_zero_based":8595},{"literal_text_all_w_t_and_m_t":"For downlink RRC message and sidelink PC5 RRC messages, the need codes, conditions and ASN.1 defaults specified for a particular (child) field only apply in case the (parent) field including the particular field is present. Thus, if the parent is absent the UE shall not release the field unless the absence of the parent field implies that.","paragraph_zero_based":8596},{"literal_text_all_w_t_and_m_t":"For (parent) fields without need codes in downlink RRC messages or sidelink PC5 RRC message, if the parent field is absent, UE shall follow the need codes of the child fields. Thus, if parent field is absent, the need code of each child field is followed (i.e. Need R child fields are released, Need M child fields are not modified and the actions for Need S child fields depend on the specified conditions of each field). Examples of (parent) fields in downlink RRC messages and sidelink PC5 RRC message without need codes where this rule applies are:","paragraph_zero_based":8597},{"literal_text_all_w_t_and_m_t":"-nonCriticalExtension fields at the end of a message using empty SEQUENCE extension mechanism,","paragraph_zero_based":8598},{"literal_text_all_w_t_and_m_t":"-groups of non-critical extensions using double brackets (referred to as extension groups), and","paragraph_zero_based":8599},{"literal_text_all_w_t_and_m_t":"-non-critical extensions at the end of a message or at the end of a structure, contained in a BIT STRING or OCTET STRING (referred to as parent extension fields).","paragraph_zero_based":8600},{"literal_text_all_w_t_and_m_t":"The handling of need codes as specified in the previous is illustrated by means of an example, as shown in the following ASN.1.","paragraph_zero_based":8601},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":8602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8603},{"literal_text_all_w_t_and_m_t":"RRCMessage-IEs ::=                SEQUENCE {","paragraph_zero_based":8604},{"literal_text_all_w_t_and_m_t":"    field1                            InformationElement1            OPTIONAL,  -- Need M","paragraph_zero_based":8605},{"literal_text_all_w_t_and_m_t":"    field2                            InformationElement2            OPTIONAL,  -- Need R","paragraph_zero_based":8606},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              RRCMessage-v1570-IEs           OPTIONAL","paragraph_zero_based":8607},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8608},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8609},{"literal_text_all_w_t_and_m_t":"RRCMessage-1570-IEs ::=           SEQUENCE {","paragraph_zero_based":8610},{"literal_text_all_w_t_and_m_t":"    field3                            InformationElement3            OPTIONAL,  -- Need M","paragraph_zero_based":8611},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              RRCMessage-v1640-IEs           OPTIONAL","paragraph_zero_based":8612},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8614},{"literal_text_all_w_t_and_m_t":"RRCMessage-v1640-IEs ::=          SEQUENCE {","paragraph_zero_based":8615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["58a389bccc0106978c4288ab4b593622e860a71fdddcc6de7901607f8cf8732a","849c0888d2d9f4e1eeb82a0c8ed6441ba0776a7ea136b66ee0b9caf49352f364","6325fc06e0e41efd2513955474259ef8c6e785bb67ead5b0e5f0d9f5c19ae7ac","33f715d5abe5ad64f293be1a662d761ff56bbf99d8b06d20a8f3bb306107d015","f2cb3f8528969b8c0d8c94f71c44af42ffbaba6c1b57f04760cc11f756b932e0","15c3c74f93850307d707dff7c5fa73cd0d1b57a18268017a3e11081961f28bb5","99fe87956c698a99054b8c551baa9089fb3891abd32c8ad7207073ab316ffd6a","89a71d3cb14c0227b404155dc9d30e2c6e183f7a9cf9e2b3b3828a99b1b4c11f","d13a01f34fec69b7436d35cb9b41501afe493db55b76335280191aef3ccf8f2b","384e35448e8a07683d6561528e583371cc5515f35f0a10e6407772e89e986575","752f2ea70e33e2c03e588b2fc99f0789d5194dfba4be9db0ae8d1c9b91725f3a","86dbdbfae3e38bc055bb76fde8d430697a63436b984fa5bfdac101b843a8b067","366ab92464f732cabc020f078d178caf0e0c5a4a1f9b5934866cbe73464bdbd1","c07d1b0fbb2e0eed789a93b1c778d1d3b249bb31a5d3f4c43af771298d2db849","dd1dded61f91e989a5e7d1d9c2542a48131a4bb14db9a680783d0cfeb3da02e1","5dc1b27dfc115bdad1617566769b93e1e1519fe87b89f3a5e58f70cbbd5df05e","d512a4f5160870377659e97e3707d889c49c3ba7541849ae3c86ca2b80ad1d26","ff4df5857da2e822cae52d993ad053ebdcf592283dc91a24e2c5f86408971921","302d8e051b79334d1187aab5e2720aa8ea1ec34931e71d9f09d28243499580b6","13af3d20b6bfb552ecd0991ddd807113b56b92f9e04292e32fccba7c10a60886","a629d7079c6320a466e30f02a95a6fc1fb14bfbc5f06486dd3dfa6614f230c11","c0d1c595237c8e4fcda6634e42c9a838fd9a28edc1cc9e017fd1cd0b96802443","f036cef33306c7c6aa5f6024b4f56c46e661ffa6cdb7f033149618b9ff1f03e4","9f7b20843324622d2f00520ab1ec2117293d0bf34a0acb608256208f42b93bec"],"paragraph_range_zero_based":[8592,8615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8592"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    field4                            InformationElement4            OPTIONAL,  -- Need R","paragraph_zero_based":8616},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              SEQUENCE {}                    OPTIONAL","paragraph_zero_based":8617},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8619},{"literal_text_all_w_t_and_m_t":"InformationElement1 ::=           SEQUENCE {","paragraph_zero_based":8620},{"literal_text_all_w_t_and_m_t":"    field10                           InformationElement10           OPTIONAL,  -- Need N","paragraph_zero_based":8621},{"literal_text_all_w_t_and_m_t":"    field11                           InformationElement11           OPTIONAL,  -- Need M","paragraph_zero_based":8622},{"literal_text_all_w_t_and_m_t":"    field12                           InformationElement12           OPTIONAL,  -- Need R","paragraph_zero_based":8623},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":8624},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":8625},{"literal_text_all_w_t_and_m_t":"    field13                           InformationElement13           OPTIONAL,  -- Need R","paragraph_zero_based":8626},{"literal_text_all_w_t_and_m_t":"    field14                           InformationElement14           OPTIONAL   -- Need M","paragraph_zero_based":8627},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":8628},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8630},{"literal_text_all_w_t_and_m_t":"InformationElement2 ::=           SEQUENCE {","paragraph_zero_based":8631},{"literal_text_all_w_t_and_m_t":"    field21                           InformationElement11           OPTIONAL,  -- Need M","paragraph_zero_based":8632},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":8633},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8635},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":8636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8637},{"literal_text_all_w_t_and_m_t":"The handling of need codes as specified in the previous implies that:","paragraph_zero_based":8638},{"literal_text_all_w_t_and_m_t":"-if field1 in RRCMessage-IEs is absent, UE does not modify or take action on any child fields configured within field1 (regardless of their need codes);","paragraph_zero_based":8639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a64eabbb9d11e17e8d5d496d032e01f2ec82145b581d55bd8df9d04561fa6531","8b546517aceb18bbce5210c7de3b6054d5f3baeb68a14f7e51e6515d46941924","999d6b48084f1679f6710adb38bac871bbecf0d2964dc0537fcbd4ddca226ae7","ef1b89a4a662f0bd9201a6d40805652cf879805181831ef2e1468761d5e62478","43fe634ff254503841e9274f653411817bc91a02857607e8b15813ad3f7351cd","5ab69af8fc8558db1921288adb7bdf4e52da463369330e99b011e697f003f2af","fe027666829b652f5dbf90a73204e46b72ef9c02b9cd67c765f9f6f76a509ec5","8e30fab9ea9656aba5a8e4c10c7d5f1776ea939cf7a105f3ce35dbaacb915cdd","3606e0d5bff57f3583622165f31cb88751fd699daed1af7c74d7858749d946bd","65b7bf05438a118e52a1d0f97755bcb9671ec15b5e579b2f50468d44fae18b72","014ae44a689e595941e345e6d1189800b61535df5bcc83b75401016119cb7e87","0f0dc7886d401b21df1cb21267387a97b9d14d54a9ebfb58c6eda107a80717a2","6dc7a237d1a838ac68864de4f0892410fa627ff7d919e0307ae767f27df97799","633739749f7cfad5c596e01a011a43987bbd984087835a1522f69294bf005d39","77ae10545fec3932f43a558fbff8088db2f207ac75f38eda1b45b1c4480f60cf","fae0c73c7cb245d1f8eb57e640ebec8c5ab5f13d7012d2fa7a1fddcaba7896d5","b63f2d28fcf3c68126dcdb68561f1e573a825173ef5715d71a8cfd09f22dcd93","617dc045425fd120d74f33f148393b4e652691f95c43ee199d1c63bb625559ff","a506526476cb8cecb1d0242c77edf517b4010d9b8219e8a3b429fc962b5e2fa1","c237cd525668726b01827418cfcc9f7f5118e42e07df9a4ef65f05556902736b","c0fbca9bee25170f2335df706bd77813bc2d09bb72356d6f9fd7c9c287c8be40","3be68413db381201152c36ff655ff8eb17087e5a9e0e2c01a7f6154b8aa9cb9c","bac78a89780c83b8cf32658b935c38bef8cbf30d683e666173d0eb34586b9596","eddae66d5c7a08427021be0fc54c2b88a42478e3669c2312a0317e2a3772c9f8"],"paragraph_range_zero_based":[8616,8639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p8616"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-if field2 in RRCMessage-IEs is absent, UE releases the field2 (and also its child field field21);","paragraph_zero_based":8640},{"literal_text_all_w_t_and_m_t":"-if field1 or field2 in RRCMessage-IEs is present, UE retains or releases their child fields according to the child field presence conditions;","paragraph_zero_based":8641},{"literal_text_all_w_t_and_m_t":"-if field1 in RRCMessage-IEs is present but the extension group containing field13 and field14 is absent, the UE releases field13 but does not modify field14;","paragraph_zero_based":8642},{"literal_text_all_w_t_and_m_t":"-if nonCriticalExtension defined by IE RRCMessage-v1570-IEs is absent, the UE does not modify field3 but releases field4;","paragraph_zero_based":8643},{"literal_text_all_w_t_and_m_t":"6.1.3General rules","paragraph_zero_based":8644},{"literal_text_all_w_t_and_m_t":"In the ASN.1 of this specification, the first bit of a bit string refers to the leftmost bit, unless stated otherwise.","paragraph_zero_based":8645},{"literal_text_all_w_t_and_m_t":"Upon reception of a list not using ToAddModList and ToReleaseList structure, the UE shall delete all entries of the list currently in the UE configuration before applying the received list and shall consider each entry as newly created. This applies also to lists whose size is extended (i.e. with a second list structure in the ASN.1 comprising additional entries), unless otherwise specified. This implies that Need M should not be used for fields in the entries of these lists; if used, UE will handle such fields equivalent to a Need R.","paragraph_zero_based":8646},{"literal_text_all_w_t_and_m_t":"6.2RRC messages","paragraph_zero_based":8647},{"literal_text_all_w_t_and_m_t":"6.2.1General message structure","paragraph_zero_based":8648},{"literal_text_all_w_t_and_m_t":"–NR-RRC-Definitions","paragraph_zero_based":8649},{"literal_text_all_w_t_and_m_t":"This ASN.1 segment is the start of the NR RRC PDU definitions.","paragraph_zero_based":8650},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":8651},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-RRC-DEFINITIONS-START","paragraph_zero_based":8652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8653},{"literal_text_all_w_t_and_m_t":"NR-RRC-Definitions DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":8654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8655},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":8656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8657},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-RRC-DEFINITIONS-STOP","paragraph_zero_based":8658},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":8659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8660},{"literal_text_all_w_t_and_m_t":"–BCCH-BCH-Message","paragraph_zero_based":8661},{"literal_text_all_w_t_and_m_t":"The BCCH-BCH-Message class is the set of RRC messages that may be sent from the network to the UE via BCH on the BCCH logical channel.","paragraph_zero_based":8662},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":8663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["455c669f7d5d3ade22eba4c4c0680fbe8c976f8f51adce27e900886fd83b026a","e0ca92db71429c0c9d7ebc4f1effca0f134ed89289fbb91ad2898225d9a0ffe7","b0e0ca87c93381065c426e1244ebd4cd76e76f6f663fae03339f12adf5606795","ceecb5edc65b7506ab26660651444171b42c22563022416c4b685c5615f4cf15","3ea10a47723dc5a8c176eb977cd3e6740dc9f42e7fb