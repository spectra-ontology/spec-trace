{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21672},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList-v1760 ::=                SEQUENCE (SIZE (1.. maxNR-NS-Pmax)) OF NR-NS-PmaxValue-v1760","paragraph_zero_based":21673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21674},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxValue-v1760 ::=               SEQUENCE {","paragraph_zero_based":21675},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission-v1760        AdditionalSpectrumEmission-v1760    OPTIONAL   -- Need N","paragraph_zero_based":21676},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21678},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxListAerial-r18 ::=            SEQUENCE (SIZE (1..maxNR-NS-Pmax)) OF NR-NS-PmaxValueAerial-r18","paragraph_zero_based":21679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21680},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxValueAerial-r18 ::=               SEQUENCE {","paragraph_zero_based":21681},{"literal_text_all_w_t_and_m_t":"    additionalPmax-r18                          P-Max                           OPTIONAL,   -- Need N","paragraph_zero_based":21682},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission-r18              AdditionalSpectrumEmission-r18","paragraph_zero_based":21683},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21685},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-NS-PMAXLIST-STOP","paragraph_zero_based":21686},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21687},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21688},{"literal_text_all_w_t_and_m_t":"–NSAG-ID","paragraph_zero_based":21689},{"literal_text_all_w_t_and_m_t":"The IE NSAG-ID is used to identify an NSAG (TS 23.501 [32]) for slice-based cell reselection or slice-based random access.","paragraph_zero_based":21690},{"literal_text_all_w_t_and_m_t":"NSAG-ID information element","paragraph_zero_based":21691},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21692},{"literal_text_all_w_t_and_m_t":"-- TAG-NSAG-ID-START","paragraph_zero_based":21693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21694},{"literal_text_all_w_t_and_m_t":"NSAG-ID-r17 ::=                      BIT STRING (SIZE (8))","paragraph_zero_based":21695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cfbb0b4238d7f9ef95057ebb888d910d6e95076ac56f96961616d0bae102a5ee","5621b1afabe0a7f4b2fd2fff8c59bc39749b569e73affdb3753441a8dd30be62","4ebf59d40505a1f26abca7ae0d528f12cd970bcef214c3a7ab9efc42d70719e5","f32e47d0d8a4b6735b7e7b2513204433d089fd2c93bd5f01222a7c460a3835d4","8965beb7694231346affd2c47b20b58cdfebcf57f49b37978c15e68bc556a8b4","385ed66bd499c60489aebfa0081ef9bdec98e3088eb64b2e007543f74c255386","0add5854b577b0aba188cdb766abdc9fcfdceec71020e28274df74d7a1e5c126","253a09f6e9ad2cc193e73d03a16ab3c2a91eb67f03ffc51e6324c40485ef459e","c7cb4b0d485ac1096a207596f0a40861ee174d3408e2c0e3ea659d9541deb689","bdb69a979d04c06cc2a9e0a4065aae4c754b28f30cac309e98ebc26e0f29037e","71971f19bb93b33b3523680756903dc1aa0ba93ec37c0ba0dd0247792fc9a509","a7051c1575f3d6c8dffe1c7b895f2eba738b012b1d1561929d962f7b24fe533c","99e4679845f3b7b041014394c345e8d480686c1ecc95d993c60e75abe9aa70f9","bb97e0ba4a662c47e7324e494ecb23549826efc86ac0bd158fed2bd08b998659","420dcf69cb64db633676c3001d2d247362c3a57557bca01086e22bd8b5f337ae","75952e0dab1b297802fcb350a0e0d139