{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16009},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging field descriptions","paragraph_zero_based":16010},{"literal_text_all_w_t_and_m_t":"cellIdentity","paragraph_zero_based":16011},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1.","paragraph_zero_based":16012},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":16013},{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (in SIB1) in the instance of PLMN-IdentityInfoList that contained the reported cellIdentity.","paragraph_zero_based":16014},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":16015},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs.","paragraph_zero_based":16016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16017},{"literal_text_all_w_t_and_m_t":"–CLI-RSSI-Range","paragraph_zero_based":16018},{"literal_text_all_w_t_and_m_t":"The IE CLI-RSSI-Range specifies the value range used in CLI-RSSI measurements and thresholds. The integer value for CLI-RSSI measurements is according to Table 10.1.22.2.2-1 in TS 38.133 [14].","paragraph_zero_based":16019},{"literal_text_all_w_t_and_m_t":"CLI-RSSI-Range information element","paragraph_zero_based":16020},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16021},{"literal_text_all_w_t_and_m_t":"-- TAG-CLI-RSSI-RANGE-START","paragraph_zero_based":16022},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16023},{"literal_text_all_w_t_and_m_t":"CLI-RSSI-Range-r16 ::=                      INTEGER(0..76)","paragraph_zero_based":16024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16025},{"literal_text_all_w_t_and_m_t":"-- TAG-CLI-RSSI-RANGE-STOP","paragraph_zero_based":16026},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16028},{"literal_text_all_w_t_and_m_t":"–CodebookConfig","paragraph_zero_based":16029},{"literal_text_all_w_t_and_m_t":"The IE CodebookConfig is used to configure codebooks of Type-I and Type-II (see TS 38.214 [19], clause 5.2.2.2)","paragraph_zero_based":16030},{"literal_text_all_w_t_and_m_t":"CodebookConfig information element","paragraph_zero_based":16031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6fa1284b0a849e6ed6a80e1fe93e98719a799dff0a65b9abe7a8285dc07dd42d","c7f4efd2e58764d0af5bd78226823bef7189250361d0fdcfa8674c98408a4c82","b08ffb9ea88037942e439383b37feabeff7c0d52836d90c927e193d032acda16","da630e8a208f1248b50e8d4957fb741c4e9a56343a166df49895f3a546493c53","e3bf3fd7a03d2fafc272dd101f2607d63cfbe09a7e4fa2d451dff8fcfc757c4c","6a63d526fbeb3063b43dde13be8c68454d68ce9ae2ab4fa649ac7c60080364c7","03a7241c04a0f5f423e455faadcf76627b82d617f17a926795570840905ff05b","5777e5f9fb6e9bde0a302d80268f63e2916b67d7fbb79c6315f76d53dd1fb519","a7863ba2c7c525a606e9ea00feb9e8b0c049b13bf093c705cf22b438f5714cc8","e2e8fbbbec220d6ecfd353478466ffd8f5d8087ceda764e5f15046ce814e47d5","9e59209d4c339bf129b20c3c1beafe9b844b02f1424ffe8b34c09f669384699b","7d1a769a2d8b5d5fbba308a9575e7b302bcc92148bef1853d99ff877277b44e5","a6136a23ee287eba93be4812d64c877a4ba7fbc9ab9e466726d1e007d2b598