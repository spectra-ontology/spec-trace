{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSTSlice/Service Type","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"SU-MIMOSingle User MIMO","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"SULSupplementary Uplink","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"TATiming Advance","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"TBTransport Block","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"TCETrace Collection Entity","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"TNLTransport Network Layer","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"TPCTransmit Power Control","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"TRPTransmit/Receive Point","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"TRSTracking Reference Signal","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"U2NUE-to-Network","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"UCIUplink Control Information","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"UDCUplink Data Compression","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"UE-Slice-MBRUE Slice Maximum Bit Rate","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"UL-AoAUplink Angles of Arrival","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"UL-RTOAUplink Relative Time of Arrival","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"UL-SCHUplink Shared Channel","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"UPFUser Plane Function","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"URLLCUltra-Reliable and Low Latency Communications","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"VRVirtual Reality","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"V2XVehicle-to-Everything","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"Xn-CXn-Control plane","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"Xn-UXn-User plane","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"XnAPXn Application Protocol","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["dc5249f9d0df3b8bb24d4d654addccec225bbb6db20710533c42646aa9989300","33f48a29e2d0b1eb1dc99062bf35ecd9914c873c77e5894c9c4e953215e4bb3d","8aa873f511635e2ac1a26dffb9c438b18c459a92abdcff90894a9c729374f8e7","099c1f799fcf96a339ab8945093625c8718271386d4ba06eb56f80eca9143101","8948e1056c0b514da526946db60597d50179c2df3768efa142d1afd30e38ea82","9a2b1e664511a421129538e785e399db490229843ad070bb274a3264b79f6b9b","e2691f135266ec75f4101a6fe456596d1a642ff5e31397025c49c90bf29cb996","9eeb487a9222d38d02ef3306034337c9d7009e54d64abec77442b8776b64d0f0","2a74ba0e6c0adfaf294c92f192b7651ac3d56199fb15fbd7a2afd9afc999d7b6","4365a1ed1e5ed02b3d215039d150ed79dae62d5ab72d6139198f5c78ac002e79","5b7a0c0dfbbd6b9e678da11aed01fe312df87f00ab8021016354d21fa8d30701","255db450c60c1b575ac8b5efd12b58dfbc9bb025153aedf026f9c28032b9108c","09c4ff6b06d738c8c8d449b64e78bb75189d1f6bc87c8779c473709e55ffa441","ea575e67eff355292d415f1a8fc82ceacbb56cd939e276be08db63828b9cce40","283c9f7048041539abf38ae466fb601ccd5eac29f89b2d4e1c5d46efdd2858cb","7ca4d545d8002b260e3441ee5495169b780e07e9c8bb8425419d681d6868bbd4","d4843b372392d9a13e3124a4acaff3b63f772518628ee0f07fb53d143e754f4a","b143143f740b7ae395cd0ace63a4097b4e51b60d232211ba92ccb4ae108a94bf","97209097cdcd71449b9b9ea8fc0e6fc9b0fb474f1cfac426ef42bd458c53939c","22c956895fc8c205760f138b1b59ca5b9cece4ef79686a3771585aa0f2515c9b","fc43d73622e88748f80f90707a9839dfb60ea34b7ff7a4b12eb3dbf21b5dce40","f5eda03e2de7c3c37b2d3871bd9aa3e7e5a560eb006d647c6392bdf76c95cba6","45bf9284fa0f8eeb833fb0fa0c4706587630bf579dc2230301a7940f11b4610f","f83f72104ac1821de66ea51a8b6e708ed6430ba4dbdccd1e3fcce12f67806747"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p360"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"XReXtended Reality","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"3.2Definitions","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1], in TS 36.300 [2] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1] and TS 36.300 [2].","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"BH RLC channel: an RLC channel between two nodes, which is used to transport backhaul packets.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"Boundary IAB-node: as defined in TS 38.401 [4].","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"Broadcast MRB: A radio bearer configured for MBS broadcast delivery.","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"CAG Cell: a PLMN cell broadcasting at least one Closed Access Group identity.","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"CAG Member Cell: for a UE, a CAG cell broadcasting the identity of the selected PLMN, registered PLMN or equivalent PLMN, and for that PLMN, a CAG identifier belonging to the Allowed CAG list of the UE for that PLMN.","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"CAG-only cell: a CAG cell that is only available for normal service for CAG UEs.","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"Cell-Defining SSB: an SSB with an RMSI associated.","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"Child node: IAB-DU's and IAB-donor-DU's next hop neighbour node; the child node is also an IAB-node.","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"Conditional Handover (CHO): a handover procedure that is executed only when execution condition(s) are met.","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"CORESET#0: the control resource set for at least SIB1 scheduling, can be configured either via MIB or via dedicated RRC signalling.","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"DAPS Handover: a handover procedure that maintains the source gNB connection after reception of RRC message for handover and until releasing the source cell after successful random access to the target gNB.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"Data Burst: A set of multiple PDUs generated and sent by the application in a short period of time, as defined in TS 23.501 [3].","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"Direct Path: a type of UE-to-Network transmission path, where data is transmitted between a UE and the network without sidelink relaying.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"Downstream: direction toward child node or UE in IAB-topology.","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"Early Data Forwarding: data forwarding that is initiated before the UE executes the handover.","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"Earth-centered, earth-fixed: a global geodetic reference system for the Earth intended for practical applications of mapping, charting, geopositioning and navigation, as specified in NIMA TR 8350.2 [51].","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"Feeder link: wireless link between the NTN Gateway and the NTN payload.","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"Geosynchronous Orbit: earth-centered orbit at approximately 35786 kilometres above Earth's surface and synchronised with Earth's rotation. A geostationary orbit is a non-inclined geosynchronous orbit, i.e. in the Earth's equator plane.","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"Group ID for Network Selection: an identifier used during SNPN selection to enhance the likelihood of selecting a preferred SNPN that supports a Default Credentials Server or a Credentials Holder, as specified in TS 23.501 [3].","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"gNB: node providing NR user plane and control plane protocol terminations towards the UE, and connected via the NG interface to the 5GC.","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["d198aa8416a42eff2c0cdbbdfed0a6f1e6108e47949a3ccfb638252d437e2d37","bc7bb847ae4a399a8cd012ff0758326a74b2a92499888e61a05db3ea55079aa9","b77e7dd0cd72ba8e3353a4d2233d2d117a162efc405e330cf8bd2139d1ed9171","dcf185a744a84897ba43af4bda39b6228bb053a15218e048a4d712abd65d6463","c9610e9ab39511679a42be64e261ae381828e4dccd935ecabfefab0d5baa915f","0943aa9944baea00e31eca32cc3546425d88b1d48fe3f1c314ccf7bc940d1519","80628d9f930f8a75d3c32d6243b5063cf28ffa48b6f4fba1513187db9e62f972","86c5c199c1dd6db5fbaf9e95488c2bb6576d4bf0f253830579d9eb2154c4ff30","3a443b860674d38735d495592b98b9f1637485a21ee78dd934984559b0ca1f57","8d4296c80e4db1e68ad962c273f6241ecffe0d5e3d8de07e38b36e05bf60276d","bf36db4060a590ad0a611037c0a3c3cf4308a7bdfb8c6abcd4854550a3cd7d7c","7a45bb9b553a118c4934d9ad06ea2c9268a6565bbea4dece24ae32c5d0dab498","4b4a7d4bb00ab2d5d5a5798fd7b34333f4201479057e61c3d29ff12cd5ec478c","9254eb873b1c1693fc45e79572d7beb771abf477d6d619a978f6054829ecdbb5","cdaa4367c5b1fcec1411d4f713f8a7d1593a3799346d626dbd70a7a92c758702","90f76d23770d12b05e199512c55f80e080b42dbfae134cfa690a96f830509e81","9a907ef2d162e0f5ed202eaa08d80fc72dbc01de98f871f1945e65d8dc084578","3e5d88a37a68ceb2f40c25e9851ecb414d0a8c84cafc70c1e7958b550e594701","d535e3bc2368800d536ace53368560a9e0a8f3ff3135029717f8524de5001d61","a2001a9c9ea69ead71df154bc647473e30cd0637fd047333d9754d2f88ecfa39","222201c36bf8d6a8603bfc73ba915bfc3faeb7e7d26a2e4cb741b42194f12ccf","0f8ed67ae4dec742c9dd80f2e32644b13b68e5bf3887d7436d59840a5bc955ea","67b1810f549cd11893e8b64be0e2283665b66fc6c1059500d6da1c183cb67f7a","905120b507551df68c9eb14b312555cd62e403d6f05f55607bcd9807e46ade2c"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p384"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"High Altitude Platform Station: airborne vehicle embarking the NTN payload placed at an altitude between 8 and 50 km.","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"IAB-donor: gNB that provides network access to UEs via a network of backhaul and access links.","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"IAB-donor-CU: as defined in TS 38.401 [4].","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"IAB-donor-DU: as defined in TS 38.401 [4].","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"IAB-DU: gNB-DU functionality supported by the IAB-node to terminate the NR access interface to UEs and next-hop IAB-nodes, and to terminate the F1 protocol to the gNB-CU functionality, as defined in TS 38.401 [4], on the IAB-donor.","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"IAB-MT: IAB-node function that terminates the Uu interface to the parent node using the procedures and behaviours specified for UEs unless stated otherwise. IAB-MT function used in 38-series of 3GPP Specifications corresponds to IAB-UE function defined in TS 23.501 [3].","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"IAB-node: RAN node that supports NR access links to UEs and NR backhaul links to parent nodes and child nodes. The IAB-node does not support backhauling via LTE.","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"IAB topology: the unison of all IAB-nodes and IAB-donor-DUs whose F1 and/or RRC connections are terminated at the same IAB-donor-CU.","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"Indirect Path: a type of UE-to-Network transmission path, where data is forwarded via a U2N Relay UE between a U2N Remote UE and the network.","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"Inter-donor partial migration: migration of an IAB-MT to a parent node underneath a different IAB-donor-CU while the collocated IAB-DU and its descendant IAB-node(s), if any, are terminated at the initial IAB-donor-CU. The procedure renders the said IAB-node as a boundary IAB-node.","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"Intra-system Handover: handover that does not involve a CN change (EPC or 5GC).","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"Inter-system Handover: handover that involves a CN change (EPC or 5GC).","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"Late Data Forwarding: data forwarding that is initiated after the source NG-RAN node knows that the UE has successfully accessed a target NG-RAN node.","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"Mapped Cell ID: in NTN, it corresponds to a fixed geographical area.","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"MBS Radio Bearer: A radio bearer configured for MBS delivery.","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"MSG1: preamble transmission of the random access procedure for 4-step random access (RA) type.","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"MSG3: first scheduled transmission of the random access procedure.","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"MSGA: preamble and payload transmissions of the random access procedure for 2-step RA type.","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"MSGB: response to MSGA in the 2-step random access procedure. MSGB may consist of response(s) for contention resolution, fallback indication(s), and backoff indication.","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"Multicast/Broadcast Service: A point-to-multipoint service as defined in TS 23.247 [45].","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"Multicast MRB: A radio bearer configured for MBS multicast delivery.","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"Multi-hop backhauling: using a chain of NR backhaul links between an IAB-node and an IAB-donor.","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"ng-eNB: node providing E-UTRA user plane and control plane protocol terminations towards the UE, and connected via the NG interface to the 5GC.","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"NG-C: control plane interface between NG-RAN and 5GC.","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["6863bd171bda63b6254c2d5714fca6a8900912f004c4c74949a328d343b43169","b473ed845db051fe52b7fb71cbeae285763f2dbed6ebeba5fcf18fcf7c6c713c","1f2a9bd4ca364316724702a0bba05fb6c9b443911b12aa76054e1b5f70c4c93c","6ad52984a6a47ac362a55c079aaff2f0240f82118b69ab7406e4c324ab94fd9d","d37433d9ce0c33c0250a0e2695158b9423870f3791bf8a50cbc1f2293d2770e4","385c0bc6fa2afcbb635b637144d21ab46d6b17afb96792a86899603d82728df5","e7d968de9eab374c6720cbc6f7272e856939ba58d14636e52bf1a8290dc066f6","185c5fd7c509d391f38c538f7b69eb21c485094274a7f7c4dd045ac0443c26b2","f1497566e148556a25b21c2079579e77eb905c1b90191af8b457a16a0bb9ecdc","6211e2864fa6255b9f3d4ff521547a928ae41d91a67d8750df6cc1bbbc2c39c6","ec480e72cbd9d176a3c5724ec0a33dfb1ee480c67c71669e7f84fdfb670fb220","a4f43d477ad60a7141d180bd8d31662e0fca6cb16e2ec6be4b863156df1861fa","193bd9635fa3a44ad2c055c614d3f3318ba2e8d4db67ba11f1d9a446deb261e4","531a5244c3faea871422233f174fffbbeac6f4e25471932833894af0cc0cb16c","aaced9425d35b0df0abd9f90e126f47cd4046c24ea3a1b8133ffd1b3a55bc2b2","e8646f0bb0188e3363a835e3af1f29933f348ab227c11df39dc23d8f83b47411","11f440365913f4c4d9826fc0b56407340cbe9f6c17d7607a2d26b34f2e84bb0c","e052b025f709f0e73bb5e79d68464ce6f7601f8c48e11a69ae72eb7c058337ea","18922def46fb47ae6ff1a1110481f2d7a91d0f7e19b3758fc24b095aed4d631b","1253cc97fc83700a357abcfae25956f0c920284e09a21fd8ceec86e4187eed19","df81e7bec96436d54cdf57b0be0f9f5a61246398c7ec29dc7237e9aa889953ac","6f9e968b87b32b6c09af78755777cc39d151834f0133125b35f3f08b11739297","8686a805419f10694d4576776d8c5562f340e9bebc1c90536bb05d5c462e3b3d","32a4f95eb75837bed73b14fdf1f191b02850554ac4e28bc573d06663181de817"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p408"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NG-U: user plane interface between NG-RAN and 5GC.","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"NG-RAN node: either a gNB or an ng-eNB.","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"Non-CAG Cell: a PLMN cell which does not broadcast any Closed Access Group identity.","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"Non-Geosynchronous orbit: earth-centered orbit with an orbital period that does not match Earth's rotation on its axis. This includes Low and Medium Earth Orbit (LEO and MEO). LEO operates at altitudes between 300 km and 1500 km and MEO at altitudes between 7000 km and 25000 km, approximately.","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"Non-terrestrial network: an NG-RAN consisting of gNBs, which provide non-terrestrial NR access to UEs by means of an NTN payload embarked on an airborne or space-borne NTN vehicle and an NTN Gateway.","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"NR backhaul link: NR link used for backhauling between an IAB-node and an IAB-donor, and between IAB-nodes in case of a multi-hop backhauling.","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X communication as defined in TS 23.287 [40] and the ProSe communication (including ProSe non-Relay and UE-to-Network Relay communication) as defined in TS 23.304 [48], between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"NR sidelink discovery: AS functionality enabling ProSe non-Relay Discovery and ProSe UE-to-Network Relay discovery for Proximity based Services as defined in TS 23.304 [48] between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"NTN Gateway: an earth station located at the surface of the earth, providing connectivity to the NTN payload using the feeder link. An NTN Gateway is a TNL node.","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"NTN payload: a network node, embarked on board a satellite or high altitude platform station, providing connectivity functions, between the service link and the feeder link. In the current version of this specification, the NTN payload is a TNL node.","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"Numerology: corresponds to one subcarrier spacing in the frequency domain. By scaling a reference subcarrier spacing by an integer N, different numerologies can be defined.","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"Parent node: IAB-MT's next hop neighbour node; the parent node can be IAB-node or IAB-donor-DU","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"PC5 Relay RLC channel: an RLC channel between L2 U2N Remote UE and L2 U2N Relay UE, which is used to transport packets over PC5 for L2 UE-to-Network Relay.","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"PDU Set: one or more PDUs carrying the payload of one unit of information generated at the application level (e.g. frame(s) or video slice(s) for XR Services), as defined in TS 23.501 [3].","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"PLMN Cell: a cell of the PLMN.","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"RedCap UE: a UE with reduced capabilities as specified in clause 4.2.21.1 in TS 38.306 [11].","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"Relay discovery: AS functionality enabling 5G ProSe UE-to-Network Relay Discovery as defined in TS 23.304 [48], using NR technology but not traversing any network node.","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"Satellite: a space-borne vehicle orbiting the Earth embarking the NTN payload.","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"Service link: wireless link between the NTN payload and UE.","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"Sidelink Discovery RSRP: RSRP measurements on PC5 link related to NR sidelink discovery.","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"Sidelink RSRP: RSRP measurements on PC5 link related to NR sidelink communication.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"SNPN Access Mode: mode of operation whereby a UE only accesses SNPNs.","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"SNPN-only cell: a cell that is only available for normal service for SNPN subscribers.","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"SNPN Identity: the identity of Stand-alone NPN defined by the pair (PLMN ID, NID).","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["bb1acab91691e59c811ad88fd4e94ec9a7f927c1425d5108c6ca82b2c6e442e1","ac5803c9772c58e322b2e5f0cb9533a627ff408b25f09e6b47165f8c8787111f","73444f73773b5ed27d5b9faafc9e64cc1d4c0af84d0f6da7c35d7a5d3f74c8df","69d266f93521a046138173e425b68657b7b1bf285ff84a134eedad074cc72af8","510dd8066ef6842a703a80d9fd7b1bc7551056329f26903d38db8d8107d31801","dc6a85d40f8122306ffe3914627eb92cbabd846c50527d3992d2d661f91050e3","38c7593534273040c9c8552ef10d6e629d5ed4d7201572f8dfa5e18c07002f4f","5742208b1a1a1abb80d7a7e3101c432e178f9d2f012f382744936ffec10e561f","77dd5a58b745dffd969452b849db27a3bab9755d3d4e50b499c0a4265e05f900","04cb3ad61c21100f8a3792f01608b337f676eb309e5969e82b1816a546bb4311","69997cb19c8883ac6020b79ab013d8abce644a0e6d0ec3af3d43817fab3f0042","9ffba01225e28dad4005077855f0d9f4ff6114f1d0f2c9ee58b44960a6431df9","874c2e87449b262f27ae8c39e0ad2f5889698444172fb0fff05511f546d794c3","ff6755f48543b8e9f5164253b70f7cf30d8b5265cd2d17c0449b0443c1fbf430","7612c0cbacbbabf73454d3bf643ed7c1900cb030e10a27c38d3c0754e9f9e4f2","61e901a364323eed8dfc0be44ec5ddfcd8cf3cc04d6caa4c4634fd1c70e0459f","f37206834896ca1ba89e6803b231170d603d1c56ce341bb0e01e8d4eb00afaa4","4590ffb5edbfbd52b92e0dff64e48eff6a87cf286cc2f04baaa0a55eab0ed5da","62697b872daccc958e43e8945f1ee00b3faaa1903530d41b69ff44900b3ecc09","2aa52f92546482aec3a7206dce5e87ba79b0e1dda908ba11e5ebcb69c7300102","77ffe57370353e25a700d5e6b93dd735fce0b1d0e21f08eeb03ecc456a6b6734","df3754121bc1f2ee3a569d31703f9b1a4bb12ddb43464e29d45bd49b51729977","719b9229df94216b952d031e217227d4028b72715b47ec004f89351fea768423","ccfb1caac308d801d43f474152c7672b7b64a193345661cf32f7f8df5f4de959"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p432"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Transmit/Receive Point: part of the gNB transmitting and receiving radio signals to/from UE according to physical layer properties and parameters inherent to that element.","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"U2N Relay UE: a UE that provides functionality to support connectivity to the network for U2N Remote UE(s).","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"U2N Remote UE: a UE that communicates with the network via a U2N Relay UE.","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"Upstream: direction toward parent node in IAB-topology.","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"Uu Relay RLC channel: an RLC channel between L2 U2N Relay UE and gNB, which is used to transport packets over Uu for L2 UE-to-Network Relay.","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X communication as defined in TS 23.285 [41], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"Xn: network interface between NG-RAN nodes.","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"Next Modified Subclause (new)","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"16.XeXtended Reality Services","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"16.X.1General","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"This subclause describes the functionalities for the support of eXtended Reality (XR) services that require high data rate and low latency communications. An overview of XR services is available in TR 38.835 [AA], while the service requirements are documented in TS 22.261 [19].","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"16.X.2Awareness","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"XR-Awareness relies on QoS flows, PDU Sets, Data Bursts and traffic assistance information (see TS 23.501 [3]).","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"The following PDU Set QoS Parameters may be provided by the SMF to the gNB as part of the QoS profile of the QoS flow, and to enable PDU Set based QoS handling at least one of them shall be provided:","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-PDU Set Delay Budget (PSDB): as defined in TS 23.501 [3], upper bound for the duration between the reception time of the first PDU (at the UPF for DL, at the UE for UL) and the time when all PDUs of a PDU Set have been successfully received (at the UE in DL, at the UPF in UL). A QoS Flow is associated with only one PSDB, and when available, it applies to both DL and UL and supersedes the PDB of the QoS flow.","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"-PDU Set Error Rate (PSER): as defined in TS 23.501 [3], upper bound for a rate of non-congestion related PDU Set losses between RAN and the UE. A QoS Flow is associated with only one PSER, and when available, it applies to both DL and UL and supersedes the PER of the QoS flow. ","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"NOTE 1:In this release, a PDU set is considered as successfully delivered only when all PDUs of a PDU Set are delivered successfully.","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"-PDU Set Integrated Handling Information (PSIHI): indicates whether all PDUs of the PDU Set are needed for the usage of PDU Set by application layer, as defined in TS 23.501 [3].","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"NOTE 2:The PDU Set QoS parameters are common for all PDU Sets within a QoS flow.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"In addition, the UPF can identify PDUs that belong to PDU Sets, and may indicate to the gNB the following PDU Set Information in the GTP-U header:","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"-PDU Set Sequence Number;","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"-Indication of End PDU of the PDU Set;","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"-PDU Sequence Number within a PDU Set;","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"-PDU Set Size in bytes;","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["14392d724b76720f54d887428e27b714259bb97c7fd6b6ad03818efacfa47f7c","fd08d0f9bc7e63a444a77eebb8826c69b4a0b7da961c082ccf4dbe812f46f22a","cb46b41155276fd36964c3e12ddcfb4b85448f2bd6193eb896711890dfb9306e","36fc6de11739920f993354158cc52755e919673f6d00d1dce5f7e142fc67e8a2","334ff75a00c6171290974414e63c18fe3f257e0cca7d67daa3683f51c38a5d8d","4b37cb4704e07b2fad2567a50842e4d31f18517afdccf7cc246859b0ffd03267","70db3f74d5fac011d7b49244500893db375264ec2cda87f63c8e2dfa51f544f1","3cf59e4d64f1ee4e154b06ab37b34c9da209ddf7386ee5287020fe509a8bc685","766f9b06b88936b80af9602c231097a92552dd41b8437e3ca4e91bd2f8f66890","9629dc2102fcc83c4a479225df5a841c61309362ac742f44a8f507b48f93a454","93d6f5520a00b84d4fcf75ee720cae1d56448b49eb070bdb3d7049123e720560","d9b7d3bfd593e55be14d04c22ac751759afd0ec08c55d47e02322ed9e1a56051","cc4cef2eb683c18dc8893f3988a30f135666799d678a97cee21f489bbf1b9d3d","55afe07cbb7e2709f75f092c3f3c48dacd3b30514cb8b6e3ae1f71707fbb10c6","f6d83386889cc377beb29afd2e92c246e6887430a0b9206ac2f58ee1f05d0b36","9b3acb860858da322e9ca7fca3830d1b1ffa5a6f0d9af3b00e8b3f2777369359","002467eb4a9ceb1b401aa53615fd639008abb0459d120cfa50d84499993e6c56","059ccb588b04ca8c496c5bb6b26c68abb58ce727f1eb7f4470efbe1a099312ba","406bcbc8284201618830039b6e49f4eae7a92fe336a268f97deea97b5bbab43c","d59005b38992b3a32eee9f2d5c285f155fbb2c7c9c7b930cce1899762ea1e951","6850e77085f45e214abf1c248dbddbf473b826b451aff5928e37332fea8a2922","004f04abbe89dc6b5bc230073eda4f99a8b49e49aded724ea84791cb9402b3fc","587421851599fcedf91fb031bb98cffb60c865aeb1365cbcbaeacc18e7175000","bc80d08ce7db7c91677b8f9217eacb04eb03026cb0d0183b78160e84294d2275"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p456"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-PDU Set Importance (PSI), which identifies the relative importance of a PDU Set compared to other PDU Sets within the same QoS Flow.","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"The following traffic assistance information may also be provided by 5GC to the gNB:","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"-Via TSCAI (for both GBR and non-GBR QoS flows):","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"-UL and/or DL Periodicity;","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"-N6 Jitter Information (i.e. between UPF and Data Network) associated with the DL Periodicity.","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"-Indication of End of Data Burst in the GTP-U header of the last PDU in downlink.","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"In the uplink, the UE needs to be able to identify PDU Sets and Data Bursts dynamically, including PSI. How this is done is left up to UE implementation but when possible for a QoS flow, this is indicated to the gNB via UE Assistance Information.","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"16.X.3Power Saving","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"Most XR video frame rates (15, 30, 45, 60, 72, 90 and 120 fps) correspond to periodicities that are not an integer (66.66, 33.33, 22.22, 16.66, 13.88, 11.11 and 8.33 ms respectively). The gNB may configure a DRX cycle expressed in rational numbers so that the DRX cycle matches those periodicities, e.g. for the traffic with a frame rate of 60 fps, the network may configure the UE with a DRX cycle of 50/3 ms.","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"Configured grants may be configured without the need for the UE to monitor possible UL retransmissions, thus increasing the number of power saving opportunities for the UE.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"16.X.4Capacity","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"16.X.4.1Physical Layer Enhancements","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"The following enhancements for configured grant-based PUSCH transmission are introduced:","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"-Support of multiple CG PUSCH transmission occasions within a single period of a CG configuration;","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"-Indication of unused CG PUSCH occasion(s) of a CG configuration with Uplink Control Information multiplexed in CG PUSCH transmission of the CG configuration.","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"16.X.4.2Layer 2 Enhancements","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"16.X.4.2.1Assistance Information","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"In order to enhance the scheduling of uplink resources for XR, the following improvements are introduced:","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"-One additional buffer size table to reduce the quantisation errors in BSR reporting (e.g. for high bit rates):","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-Whether, for an LCG, the new table can be used in addition to the regular one is configured by the gNB;","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"-When the new table is configured for an LCG, it is used whenever the amount of the buffered data of that LCG is within the range of the new table, otherwise the regular table is used.","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"-Delay Status Report (DSR) of buffered data via a dedicated MAC CE:","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"-Triggered for an LCG when the remaining time before discard of any buffered PDCP SDU goes below a configured threshold (threshold configured per LCG by the gNB);","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"-When triggered for an LCG, reports the amount of data buffered with a remaining time before discard below the configured threshold, together with the shortest remaining time of any PDCP SDU buffered. ","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["71deda3d9591dbdd9828c5fe423c187adbd0ed80c78b1ee4e43565cb4d723763","508caa8169745d4dcedbe5eaee60c2f51899fdc1b8c1318cdd2b6eea21a7dd7b","89551f090d240a844e4f79e698a4c1b93f4d06d6a88c96d0c4bd0b1869b0a15f","c02c211dd6c3e6cbe3aad8849830ed5cae89b80dbfaafd2bda425171dcf7c045","d7b8b0d846126cc0505a1488ca005947ffa630d925621d2129a22e052a32fab7","2f60bafa869596bbca700fa3a679c7b4ca4779ae30e95d5fa1a697737dc89fe3","b079d127444f29457aedca09c67425e28ae246f9ef6dcb73984ec168e88807c1","5b6634be586cf312941e5ff85acb4557b7ef1eff3ad9241964bd776e74cc25e2","98cbd82ef0e697179d8bcf1ea51a572f2bb67a25da5303a24976377748eb1a5b","b9bdcd2310040f70f1e254d50ab19d6cbbab4614da29f66f7a108b65209a5b5f","f9744bcd134f5c9ab2ceecd1475abb2dafb87712e626b219a6b901ac5a678239","7146d9b2f8e80116b2465c46a382277cc961f8155c73f0d66d0bdde0b7d06d45","de81ea49f076ddc0a47476d7df2241680cb2070e081f3a4c5a551ba1072101c5","b132896c8137f6048d849fe42038e8351ce087ce3fdb5b7995bc91c21782b2d6","a7c0692df7b99f1840157002dba29a205e69be5718cf92c1d257ab25b8cfd678","fd8309d934581954dab603a52b65130576f9cfe946e5b142e51b229ed400f898","f1c736bc6e58db8526e9f78467f8ea27a6215aab4c840b0b5f0ce2503a2fdebd","75a1f9b49566f3d0814efca4cd52581c8468fab12ecf7cfec0bfce3c8b5f18af","b123cee1132c3a35788fc180af178a5e718c3f91dc156c804e79edc3039df805","4ba62ef680d44e28555f5c9a8dcc83022a9c49b8bf3c60cdeb787dac73ed3853","d9548c24156af3f9c47e0083a5a6186a6e8d62ddb34fb2e95e967517a7f5087d","e6a339099a66e98d50271fea2d69913ce99cac5588612cda0d8ef4c4050da835","7e16517194aaaa329b741dc9fa9ff9c2a9db2483361f64130025ccbe5fe736e4","0e5afbb52a7af40f126911e930810ba61d871302434184388ebd07b342c531dd"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p480"}
{"fields":{"filename":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Reporting of uplink assistance information (jitter range, burst arrival time, UL data burst periodicity) per QoS flow by the UE via UE Assistance Information.","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"16.X.4.2.2Discard","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"When the PSIHI is set for a QoS flow, as soon as one PDU of a PDU set is known to be lost, the remaining PDUs of that PDU Set can be considered as no longer needed by the application and may be subject to discard operation at the transmitter to free up radio resources.","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"NOTE:It cannot always be assumed that the remaining PDUs are not useful and can safely be discarded. Also, in case of Forward Error Correction (FEC), active discarding of PDUs when assuming that a large enough number of packets have already been transmitted for FEC to recover without the remaining PDUs is not recommended as it might trigger an increase of FEC packets.","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"In uplink, the UE may be configured with PDU Set based discard operation for a specific DRB. When configured, the UE discards all packets in a PDU set when one PDU belonging to this PDU set is discarded due to discard timer expiry.","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"In case of congestion, the gNB may use the PSI for PDU set discarding. For uplink, dedicated downlink signalling is used to request the UE to apply a shorter discard timer to low importance SDUs in PDCP.","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"NOTE:How SDUs are identified as low importance is left up to UE implementation. When a PSI is available, it can be used to classify the PDCP SDUs of a PDU Set according to the guidelines specified in TS 26.522 [BB].","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"End of Changes","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":514}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2fbdc8e21df0ca5e5238ab2519e12ef7f05b390e3ef691156eab6c10b57de74a","original_member_sha256":"ace3699ad508692d78ee240be40a34317c97cb7ece1040d80e3fa57831488dba","paragraph_ElementTree_utf8_XML_sha256":["86a05f765b569d97e3be9f15bcb1a93136c7c8d373780429131689bb2acd3ec3","0daf04ce06a56624917af27e271c44b237c5363813c8a1957c2d99ec91a4296b","12c1460ab23a6a7e276f1a47ff1f55cc6d802a4787b7808fa7dd0c34843396e3","2ebce38b923e5abe38c6ca6c52931a08cbdeaa0669ca4ea5f5bbbd43b16cc93b","52c40c12c8fb1a9b3fbcb4b6ae21aeb8af26256111280a789094afaefecb149c","298f9cd34a744bab6a4c838ef3eb4203cf03422d20423eeddec5cbfb35153728","ccbf5512e23fadbab48e55c1a8589ec76f9c0987efaf990abea182990d1430c5","01c07dd6dee298616b330b802f4d714cb723b7abeac7de23f8f096e5cc37baa2","8d8018e7089b9bf6f8427b9f94738142564226c1716bb17b3ce24e6bc50310b6","41824ff0763bf02ca0f4be7eac8d4bbc309118193fad32fb685dda15ba120f72","21afe6f8ce4aced9d907f5f3e59529c355ec865c3ed1d206534ec117efda3e08"],"paragraph_range_zero_based":[504,514],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312136.zip::R2-2312136 XR Stage 2 CR.docx:p504"}
