","a829505caa7fd82530ae1947775c8920f782b6b772984f952088de06d764b80b","9ef3f7b928ca0b8d8ea490ea5cd3d5af27c3c2e9f6ca703ceac68cccbe6c62c2","85dbea299dae70fb579b5e8b2e529314fcb8f95cdc2d22ff009afa0cc9fd7b4a","dc19fd9e6e1dd8fe5bdc132696b40cae53c7276663dbbefdb3c624cad8b5205b","3591dee5e8cf6efcd9dc65cd3d01fb70baf99adf2eb5966363913281df14848a","b25203a1c2dcf5c61797ba6d6f988e7c468011a18a1a8501d4126bf9a994c0fb","20d654b799c0c50db87f6a395d4342f9616fa84c1de31478fc520e488a3dc060","99cdf7215813d6fdf440091ed6fd753d2ede0ff19ce512c87549af0bb406152b"],"paragraph_range_zero_based":[2592,2615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2592"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RelayUE-ConfigU2U field descriptions","paragraph_zero_based":2616},{"literal_text_all_w_t_and_m_t":"sl-RSRP-Thresh-DiscConfig ","paragraph_zero_based":2617},{"literal_text_all_w_t_and_m_t":"Indicates the threshold of SL-RSRP for a U2U Relay UE to evaluate AS layer conditions for discovery. The U2U relay UE applies the value of this field to decide which UE(s) can be announced as proximity UE(s) in the discovery message when performing U2U Relay Discovery with Model A, and decide whether to forward the discovery message when performing the U2U Relay Discovery with Model B as specified in [65]. ","paragraph_zero_based":2618},{"literal_text_all_w_t_and_m_t":"sd-RSRP-Thresh-DiscConfig ","paragraph_zero_based":2619},{"literal_text_all_w_t_and_m_t":"Indicates the threshold of SD-RSRP for a U2U Relay UE to evaluate AS layer conditions for discovery. The U2U relay UE applies the value of this field to evaluate AS layer conditions to decide which UE(s) can be announced as proximity UE(s) in the discovery message when performing U2U Relay Discovery with Model A, and decide whether to forward the discovery message when performing the U2U Relay Discovery with Model B or U2U relay communication with integrated Discovery as specified in TS 23.304 [65].","paragraph_zero_based":2620},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2622},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2623},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2624},{"literal_text_all_w_t_and_m_t":"SL-RSRP-ThreshRelay","paragraph_zero_based":2625},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if sl-RSRP-Thresh-DiscConfig is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":2626},{"literal_text_all_w_t_and_m_t":"SD-RSRP-ThreshRelay","paragraph_zero_based":2627},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if sd-RSRP-Thresh-DiscConfig is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":2628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2630},{"literal_text_all_w_t_and_m_t":"–SL-RemoteUE-ConfigU2U","paragraph_zero_based":2631},{"literal_text_all_w_t_and_m_t":"The IE SL-RemoteUE-ConfigU2U specifies the configuration information for NR sidelink U2U Remote UE.","paragraph_zero_based":2632},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ConfigU2U information element","paragraph_zero_based":2633},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2634},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-REMOTEUE-CONFIGU2U-START","paragraph_zero_based":2635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2636},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ConfigU2U-r18::=           SEQUENCE {","paragraph_zero_based":2637},{"literal_text_all_w_t_and_m_t":"    sl-RSRP-ThreshU2U-r18                  SL-RSRP-Range-r16                                    OPTIONAL,     -- Need R","paragraph_zero_based":2638},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientU2U-r18            FilterCoefficient                                    OPTIONAL,     -- Need R","paragraph_zero_based":2639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["d31a14df0c1cad081f194b59093f3a6d5a0a117e8f962c0345c0baf54583a731","85543d45cf4f8bea1dff9100dbb3641b9be72bb85ffcebefb74560c98cf8ff0