{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9096},{"literal_text_all_w_t_and_m_t":"–LoggedMeasurementConfiguration","paragraph_zero_based":9097},{"literal_text_all_w_t_and_m_t":"The LoggedMeasurementConfiguration message is used to perform logging of measurement results while in RRC_IDLE or RRC_INACTIVE. It is used to transfer the logged measurement configuration for network performance optimisation.","paragraph_zero_based":9098},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9099},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9100},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9101},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9102},{"literal_text_all_w_t_and_m_t":"LoggedMeasurementConfiguration message","paragraph_zero_based":9103},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9104},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGGEDMEASUREMENTCONFIGURATION-START","paragraph_zero_based":9105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9106},{"literal_text_all_w_t_and_m_t":"LoggedMeasurementConfiguration-r16 ::=  SEQUENCE {","paragraph_zero_based":9107},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":9108},{"literal_text_all_w_t_and_m_t":"        loggedMeasurementConfiguration-r16      LoggedMeasurementConfiguration-r16-IEs,","paragraph_zero_based":9109},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":9110},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9111},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_ba