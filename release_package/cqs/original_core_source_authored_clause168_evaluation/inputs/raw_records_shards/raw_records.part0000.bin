{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37656},{"literal_text_all_w_t_and_m_t":"SL-TxConfigIndex-r16 ::=            INTEGER (0..maxTxConfig-1-r16)","paragraph_zero_based":37657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37658},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-PRIORITYTXCONFIGLIST-STOP","paragraph_zero_based":37659},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37661},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList field descriptions","paragraph_zero_based":37662},{"literal_text_all_w_t_and_m_t":"sl-CBR-ConfigIndex","paragraph_zero_based":37663},{"literal_text_all_w_t_and_m_t":"Indicates the CBR ranges to be used by an index to the entry of the CBR range configuration in sl-CBR-RangeConfigList.","paragraph_zero_based":37664},{"literal_text_all_w_t_and_m_t":"sl-DefaultTxConfigIndex","paragraph_zero_based":37665},{"literal_text_all_w_t_and_m_t":"Indicates the PSSCH transmission parameters to be used by the UEs which do not have available CBR measurement results, by means of an index to the corresponding entry in sl-Tx-ConfigIndexList. Value 0 indicates the first entry in sl-Tx-ConfigIndexList. The field is ignored if the UE has available CBR measurement results.","paragraph_zero_based":37666},{"literal_text_all_w_t_and_m_t":"sl-MCS-RangeList","paragraph_zero_based":37667},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value and maximum MCS value for the associated MCS table(s). UE shall ignore the minimum MCS value and maximum MCS value used for table of 64QAM indicated in SL-CBR-PriorityTxConfigList-r16 if SL-CBR-PriorityTxConfigList-v1650 is present.","paragraph_zero_based":37668},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":37669},{"literal_text_all_w_t_and_m_t":"Indicates the upper bound of priority range which is associated with the configurations in sl-CBR-ConfigIndex and in sl-Tx-ConfigIndexList. The upper bounds of the priority ranges are configured in ascending order for consecutive entries of SL-PriorityTxConfigIndex in SL-CBR-PriorityTxConfigList. For the first entry of SL-PriorityTxConfigIndex, the lower bound of the priority range is 1.","paragraph_zero_based":37670},{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-v1650","paragraph_zero_based":37671},{"literal_text_all_w_t_and_m_t":"If included, it includes the same number of entries, and listed in the same order, as in SL-CBR-PriorityTxConfigList-r16.","paragraph_zero_based":37672},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37673},{"literal_text_all_w_t_and_m_t":"–SL-CBR-CommonTxConfigList","paragraph_zero_based":37674},{"literal_text_all_w_t_and_m_t":"The IE SL-CBR-CommonTxConfigList indicates the list of PSSCH transmission parameters (such as MCS, sub-channel number, retransmission number, CR limit) in sl-CBR-PSSCH-TxConfigList, and the list of CBR ranges in sl-CBR-RangeConfigList, to configure congestion control to the UE for sidelink communication.","paragraph_zero_based":37675},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList information element","paragraph_zero_based":37676},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37677},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-START","paragraph_zero_based":37678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4b3399b212b9d3a7beaf7762596ffe917928378de3e30a899be32d7d01dd7a7f","7696820a4a2f8c97b1fae587898a975b0443beef318095da903a67272932c008","86689bad27bed5525a5fcf4f4075fcf3226bd894a04e722aa368e8136c0f238e","f3d3a6d89f131ca3e5d7c621049be5b11c28e971a9f06947ff7e4b93bb8f8fc8","875c84a76660e6018771852c8e35076ffc6e8c07897626c1fe913938ed63b9a8","d5cc1b603b9b6b10dbe9e634d8a551ab4caffd8e7930dc1882f106f4e678f526","732c82d5d6d5303e601e73226159e13855262a6f93e6e4b9aae758056dac676a","a8fd6f512fda07bef3f58a039a6b79e294a6249d21fd5de3f7701ff64477acb1","8cb4c826d912751c4138db6839c16fbff30315b66e4f3bbb4cdf6cabe436c0bc","3adfa07ba0476a8af08d6562fdc713b26d4e42b3f9a11337e2d71df3510556b0","e239ee87cd4298bd4a31ae82d3e204353633e6eb54dcb6d04a4122957a78e652","a7e08595507036b3f7c4e93c390b30241017b68cf1456c5c061f7e583ac423b7","e9cdafd4bc6356017f031ffd04bcef46014b5b2833aecb65c497fa72929ada27","6028a3d3662c4cbc3bf03cce9c58ed9e6fe623106924c1a8d22010088bc59bff","dde3d9ef6c917b795de427de8cb4627225fb5e6a9e12740a6d0f0d49e50a16b1","2dc6ed08c85ffc0e2d5438b9e3d76690f63c4ef91162408c6f3825cdd6637b6d","17879adf50c6b20366cf5b58bfb260c5e3dbee8685f3d3f9e0a42097742ce6eb","858cebb815d493a7d5d226506378729dfa691732020cf6ccb38efd12dd40422d","52583abfa5bd6fe784f069b1c0d368bb479e29e7c0dbb724b6a43fd727889d66","0fa2f569f5301ccd5a6afe3e73306e6055a9752c6506d235139d01a7d0c84116","eac69b8b9ac183da1295594034f7644f35b01b686112fc552a355e5c9780decf","43a083560159a87e276292b9917e2733839932577d1938ecbb80b0dc83f74852","7567f09a6d01a2a06175084129a2c3557e0eae923e846db26e12932dbff254ee","4e78c3e271e6e3645c1826e5b71199e0926158e096de27b19a1ad4a8b26201a3"],"paragraph_range_zero_based":[37656,37679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p37656"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList-r16 ::=     SEQUENCE {","paragraph_zero_based":37680},{"literal_text_all_w_t_and_m_t":"    sl-CBR-RangeConfigList-r16            SEQUENCE (SIZE (1..maxCBR-Config-r16)) OF SL-CBR-LevelsConfig-r16     OPTIONAL,   -- Need M","paragraph_zero_based":37681},{"literal_text_all_w_t_and_m_t":"    sl-CBR-PSSCH-TxConfigList-r16         SEQUENCE (SIZE (1.. maxTxConfig-r16)) OF SL-CBR-PSSCH-TxConfig-r16    OPTIONAL    -- Need M","paragraph_zero_based":37682},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37684},{"literal_text_all_w_t_and_m_t":"SL-CBR-LevelsConfig-r16 ::=           SEQUENCE (SIZE (1..maxCBR-Level-r16)) OF SL-CBR-r16","paragraph_zero_based":37685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37686},{"literal_text_all_w_t_and_m_t":"SL-CBR-PSSCH-TxConfig-r16 ::=         SEQUENCE {","paragraph_zero_based":37687},{"literal_text_all_w_t_and_m_t":"    sl-CR-Limit-r16                       INTEGER(0..10000)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":37688},{"literal_text_all_w_t_and_m_t":"    sl-TxParameters-r16                   SL-PSSCH-TxParameters-r16                                             OPTIONAL    -- Need M","paragraph_zero_based":37689},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37691},{"literal_text_all_w_t_and_m_t":"SL-CBR-r16 ::=                        INTEGER (0..100)","paragraph_zero_based":37692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37693},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-STOP","paragraph_zero_based":37694},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37695},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37696},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList field descriptions","paragraph_zero_based":37697},{"literal_text_all_w_t_and_m_t":"sl-CBR-RangeConfigList","paragraph_zero_based":37698},{"literal_text_all_w_t_and_m_t":"Indicates the list of CBR ranges. Each entry of the list indicates in SL-CBR-LevelsConfig the upper bound of the CBR range for the respective entry. The upper bounds of the CBR ranges are configured in ascending order for consecutive entries of sl-CBR-RangeConfigList. For the first entry of sl-CBR-RangeConfigList the lower bound of the CBR range is 0. Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":37699},{"literal_text_all_w_t_and_m_t":"sl-CR-Limit","paragraph_zero_based":37700},{"literal_text_all_w_t_and_m_t":"Indicates the maximum limit on the occupancy ratio. Value 0 corresponds to 0, value 1 to 0.0001, value 2 to 0.0002, and so on (i.e. in steps of 0.0001) until value 10000, which corresponds to 1.","paragraph_zero_based":37701},{"literal_text_all_w_t_and_m_t":"sl-CBR-PSSCH-TxConfigList","paragraph_zero_based":37702},{"literal_text_all_w_t_and_m_t":"Indicates the list of available PSSCH transmission parameters (such as MCS, sub-channel number, retransmission number and CR limit) configurations.","paragraph_zero_based":37703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9c4fec68546b396f8b5b0b37d6b85277ff27515f8170a64ec410610ccb7ca7a4","e46d9806aaf84f8c29ac9416c26f53ab8bb2d4e295c64db9682758ce12522a8c","ce386b1db62ab2abb3ec43a4ce71f1f692677517ce94bee565000e67ea64460b","ec9cd95b2b047022dea6