737280 }","paragraph_zero_based":2030},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2031},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATION-STOP","paragraph_zero_based":2032},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2034},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":2035},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":2036},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":2037},{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":2038},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":2039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["9bcc36c8f6bc08064908b8f77013fd9b40c9aa0c48f1a2b508d0e275b2e68b15","e9f646f0149efa721aaa82ad5fd00a6ccbec8e2ab43af2df734212a642c3de70","b64272903e8f39a21e754b5f78c9e1680343702e038b3c1a1a8c6c9912b4d2a0","e3b5cf34f6c8215d8f5e3f5ad1038c17b8ec080c2d915272fb461cceb27f7fa1","941c6f5ef12b18c064611b1c02078026bfbb490f3f693137cbdd3f1b933e70f5","cc74ceac9b9cf39d8c8d24859dfbebdba8e601daf6fde4c6692fbd7058b78586","8a3774d0db1857299d3c37971831b82426778fa997b2722c3fa913ce9c66736b","65b1bff9b9d46c6aa8a5a2e7e5c6a006cf38255846b6ff9fb35bd483d32ad369","f2ce245bcd415d82b05a766841810e3dfc639a528b3937dee76102aad063aa09","20e9023dd54945064387143834250f8f00fd9be0160875cdb8a5a8e3cf961070","cb820310376af8606886e729fdd8f92ed294bb146adf9c230a728916bf7f5e5d","97f0bdab734ebc5e22c3b04ef22bdb62591692f0e9333c318dc80caaf4317491","6b03decfba714a690a5be8db0069645386c27519bb58d307d710db5d3b57df6d","bbed807d55555272706428da44e245f3ca419f7d6d0eed905c9952bfeb39f934","7fa29ffb382903be224b75dedef4e7aa0e50d265e606613fdc4d86085cdc3fd3","9afb916e3cb3fbba922dcecb75d2f4a3bf87795f58a3e8bedfb2c534233b581b","5aad21c6832d57afec0beefeffd613804bda5e081fbcd302c54fdfccae253f75","b73e318d68c7e0fa8ffe15cd6ba60a30b682611e3e079a31a00a95adc01613c3","da7fcf3be294a7c440170bf1a2b8f9dc165c055e600a6d00e3421ad0c642cbca","4ae63e0bdbb6d5523ae7caa69b038dac8c172c62a54aa124df0cbf3d6eceb7c7","953e701f5248ed9320f4583d0061fde8026c048f90c5e7b4962d0bd2a1cf2d03","475a764f372b625e8a057c7ce0023392d1e561e147309ed1d7d55409bed985bd","dd3b6df7ee9d7955de4a2bba28e1ecf1cde6a6e54e2ad1213d35a57d73356406","a3f36d7e599a3416d2afa845981c07f1903284ed32dea2a38e6e1263ecf3d9da"],"paragraph_range_zero_based":[2016,2039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2016"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":2040},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":2041},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":2042},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured or if the masterCellGroup includes ReconfigurationWithSync or if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured. For conditional PSCell change, the field is absent if the secondaryCellGroup includes ReconfigurationWithSync. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition.","paragraph_zero_based":2043},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":2044},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":2045},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":2046},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":2047},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":2048},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":2049},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":2050},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED.","paragraph_zero_based":2051},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":2052},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":2053},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":2054},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB21 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":2055},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":2056},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":2057},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":2058},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":2059},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":2060},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":2061},{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":2062},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":2063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["e6b94fec37c687e687f75be6af22f4511d9bff99d04a9868df4ffdb8d50f2d5a","4055249746234ffe4933c2ff87ffdac782fee34168afa15a0a71f38b1c8f9fb6","a479df5e99f2867d44644ee8fca6eee8d6887aa0db89926e4d4070d239f9b6fe","c9b75ba330c69aabcf075a94f2327ee69cfd0a28783215aac39e9c73c45f46e2","579310eb5668784b7d7cbe5e496271c4d6eebfa57c686acb1abae5c2b89b49b4","158fa4cd669af0879961e0cb55a175fee68abaf97b1edaaa89872888c8cd6fdc","11ca66a46dda1e4f80747e1e76560755ec163747529d082efa8a31de42f8f31a","283ab37598ddcdf212c3d28987bf90c3ff824c5522bb18b416bfbf60fd18df6d","33863c6c92aa002e583b8aaf591ea0ba046ad0a91fdedd6fe7ac1a3cce4acb37","df60432a4767da35b16eb34d8c0b7fda760936b1346191493847bdbc05fbca9b","59f49b9a52d224cf235b152c5a9850ebb27868a269d073925954fd4c7bcbb5ae","f5103b11a2533cafe34712206de0e990398a3b6c99c7821084e4ae85b2a15f18","2e2b15edc0fe1f5231c86205df3187729d8a7bed596dfcd0f9dcc3ebc5c46c05","1f408c4df9551a13dbdf53f727a008b074ed22bc64876fd41534040a92cca7dc","f9cbb3acbd3caed7f13db12b5c1901b6021b2da1570c2a2cdfbaf2b708b6b1a2","c25e6110ddc5cbb56882e96b38967764f67e80ac81db39e755da21ce449cfa59","5d24cb77cfdb9b9fab25224e7e0049d2c9877515a1e040b30717f3f98a14ff41","56cac245e216decac6232b51d68a599953ab6e458360289a5eb772d1724714bd","43697a7bff48a27519984839854d70fa850b892562f4bba2be0a259592930161","2f5d900838105399a8cc612e7944fa85adf804ceb8f157deb6afbf59e34eb4b8","f9bd14dc63834e1d587a69ba9ee12ef549ed9df906fb07f65072cf6c968aeeba","5ec8d9e9a547f6d0d1c43e1af65aa6d215c427aaa4f8293876ca859cb950c390","356bf806ead6fe94d7d72049716b3ebdeba0e196873c902c3eecdef4beaee52a","2ed998dbf1195c40935ef4e004846c88f9ad532c84e5839f4904b2054cd08a32"],"paragraph_range_zero_based":[2040,2063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2040"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":2064},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":2065},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":2066},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":2067},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":2068},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":2069},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":2070},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":2071},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":2072},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":2073},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":2074},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":2075},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":2076},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":2077},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":2078},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":2079},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":2080},{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":2081},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":2082},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, measConfig, bap-Config and IAB-IP-AddressConfigurationList.","paragraph_zero_based":2083},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":2084},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":2085},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together with concurrent measurement gap or preconfigured measurement gap for positioning.","paragraph_zero_based":2086},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":2087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["59a0ea953af09fe3223ab05a2beb7197c4130e85b6266723065d4f822b826fab","5f592605c9856feed4d0d3441d3709e41da91f674bfea800985e2939925fde41","534eaa6b6179537dc6fddc55b7f6c74a3ffd6d97f56bee1151e7970cf3849deb","2b270f3e48c6f73816682f5e051ebcf147f1209370ddeb4d4f987b4a79ab4c9b","8a8652cbc0e011a6caae3923725a7aa9ddfbccef08f860777ee7b4f2d514fdb9","4e9202fb540a8b1c7a1905f6d215778678889a78510316dec6a09199de5718dc","c2dce344f455f05a4491abf698ac903613d98441bf673540d25557d0a134f731","4d78b5b48a800239a3088ed50bb42180bfea374bba786fbf3f42d3e61422f15a","8fcb81fe3eac638991ba588f73fde70a94d2d7c0b3e7ac01c9df7bd72607c17e","b735eac2007d5c87a3abe6b40591844d376f55dc371615fa1e8257d42e52cd13","b6f9722ec94d742fd2258d1f58eb9038e8166340c3aaa027b7ee3624966d0f2b","47ef4c19190ff2186eeff4155a2272dced8fc955fe4301b9250c8318b4d28f77","dc7a76d84c2400047e02f5ddae6693dd0acc7bd88d65e2781681bc42180aefb3","c7e42baf79daaaa33e3ec34156c2c29cdcc3b541b0514d40084115e08f7a305f","3179a124bcde3101426a371acbff0b524e8c26a3065304ecff1033c0826df6cf","5ca7f7b9bb708e45af4fd514a17f51ca08792b3e7ac5e358b1ea69233b2eb31f","02f56c76f8c6ffb959e0659ca14ac6d1bf0a03f7d204bed3c65a3841b9ea2c70","b4c42f4b1e331678ef606ffdce956ba5751e5aeef225f3bdfe65c4b16692cda1","834f59e40ec7b287db46245c2a075f6e34c568f9ee4ad856a91b222ca46a20d6","d5df9befb72fe74a34c217cbf3652712296b45a0e924e1eec57df0aa4c5c8800","b6c8fae6df99a9d1f1c0c07ca45cbb44b631d9f1457e8416635350161c9f0080","881935069280bc177e5742be80e11318a380b9b7d6e592e7303123e9d7069153","cbed9bf0b2269db5fe508a7a511fc1d102d8489d4542f15eb30d7f722e1c681c","bdfd79651c2301243ea9dc7438a00a1b69c707c2f994a27b5d611effb8f0d8cc"],"paragraph_range_zero_based":[2064,2087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2064"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":2088},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":2089},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2090},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":2091},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2092},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":2093},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":2094},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":2095},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":2096},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":2097},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":2098},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":2099},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":2100},{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":2101},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList and obtainCommonLocation can be included.","paragraph_zero_based":2102},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":2103},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":2104},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":2105},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":2106},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":2107},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":2108},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":2109},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":2110},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":2111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["e5a75aa55b3f4bfcc93fa3ed30755dc757950374b846e7b42a0c8cf73a076f5c","e2255d5e2681b26a95615011666fb7525e0d2266d06127dae51e2b5d2624ac54","a89aa3a40d5c6d32c32d0500893b84299daa1f505f0ea8a34e3ea141e0a379b9","9c48fb0d38969725500ad05f2782abd58d0cbed9677c791613b3a2c8ca631117","42927f33db685b1972473cca472e4074a9325c17c0f6e344c01f932801263067","771e2d1bc280cefcac5ae3035ab12f751fab75caf4ed049c95ae47564298a973","cf6ab1b458a3702c095d735c45ed54152c2d5121996964236352de2fbce44ee6","1ecb21a4f16b8e7cf7163eed1e1303831924eecb868cc157a06271a56a350c79","d85960b3f52917227a1377a830c6d7f9738c6f5d69b8ad929bfc91023fd558fa","818b1935a2055b840ca2f728ce623ec9d3a447c9eca884b8a5b2a6305c1dbd12","9e18ada968af83f13acb8835069590fcdc1ad789a09a50452e28d636dc587f2f","1822007aac9480fb20b1c4adb2ef7b736814ee4d3a1022136c023207b3025283","fcb5112f2ae03e186218ff6604cec1bcf36d87bcffdd477b7b45f18a2983ccce","c599c28597a8d91199f8a29a8c2fa4d84e5b673a99a2534cac486206e5d67e9f","6c60971105deec24ba8edf964d8b885467a9739c402a326c29564831a802d0ad","80463693a505ddd0e8d4cb4268dce91de860742a9549e646b44046dc6588187e","9be7976afc859410563f67d84beaeeda6923906a528b778dcfba2737a964e7ed","a2c834cf5fd430c83e5893ada87a3588c5cb8b2351c835568b83e3a68fac9aff","6e11495ffeec127d4a0d5911dcea967ed984cc5f1a75931d81e4a05a230cbac2","342dd3def760f27c9991eea9dc14d320ea88535070d5ffb28481c033fd478b33","34430e9d1f33db805c93b974d45ecf0568e7f8da17e95f6717ea494b3b0bbd13","e786d75a23f63c93a15004b82bdb16912d409c43288697cce88a01d6e2456987","88c38861c0e31346d224ff99c92dd97b173e2daf9656be11343f024f85354c2f","d8ae6d427ab49610939e48cf4a05bb9e54d0e6614219034c939b39c3805c4ddc"],"paragraph_range_zero_based":[2088,2111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2088"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":2112},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":2113},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":2114},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA or CPC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig.","paragraph_zero_based":2115},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":2116},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE. The field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":2117},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":2118},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE. The field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":2119},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":2120},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":2121},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":2122},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary.","paragraph_zero_based":2123},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":2124},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery.","paragraph_zero_based":2125},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":2126},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":2127},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":2128},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":2129},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":2130},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":2131},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":2132},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":2133},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":2134},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":2135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["1b9dac89cc46eec07074e401b8f325158c6c0f83fbe2e7e93f0650d2e41e152c","9b36615a1e42d8244af3c5da3e3164e348935fb749e823329823c477b0c24141","aa120f12fdadd39767f26839164c3656360892aefe4821c110b3a8b39b3df064","4ff4511ee0191ce7a334fac14fe64a31705196e732e9950ae8b5115ed10b169f","bed73cfe57b53cf332cdb67467c61814fe95a2ca4eb278628badf0fdb8d72a51","a7ff86bb71925f935d7f9bad0ea90d7d0e41416ef23abb1e3fff0fd8897342d5","f647095f75516b5ed05078becd7cf10e2efcdeebf09bfd03a97cbb4596018cb1","026880bca32be332b1a276484a2ca5a3f961153872d82c885a35f3f1f9b3bb49","145890e26267b426b295132c05fbb2c7c5f16c8cd4f19540d268c160a7fc2b58","82d019b1bf036ba1cf64c5a1b34bc723f4344bc1a6c8fe446e8faf61a6b750d0","179832c4441f2c7a46bd61f2735cdb46386fed21994cd8eba3d9af79f68f8df6","c5527f5b2d67d164836b24fdb1c71a2febf0428841eee13adb7929f693525d8e","f8fb986515fbbfcbb894d7a58b0331a56251785e46a04acc73ae1bb1e452503d","2022faa67a8292994573333081c8dd4a30766f4908696acccb191afaf6f352de","84f3fff1b6487af448eb6dca7cd87064d2d24948c9edb3b8df59633ea84ecda4","6eddcc4449cf2cc99db61cc4dff304966fa90cf24c7dc3a4533f1b74c4417129","366ec0d4f1902cdaffa502be17780045dcf05f67368a8e0da8ce51246dd6bb19","c476536ee3230e1920460d893f49b9292ecaaf86c328b2637c6763d89cf11dcb","63ee3708c9aa0e0e6e79b96edd870bb2a06471548bdc352105fc9f0ae70b5057","fb1fb68fdfa4da0056c4428ca434cd0284637f78e1b140ccefcded117a53b64f","9d13581543917e5f21b8fcc616e5887f90b1063b70d57767d88df6dae78ea054","ad00da13e3f29af058f47ea36e7f1fe1c7585e8289dc773d19552128a9b034eb","af3e1087184a22f157a037de684c8d99fa17b3e4281fb3491f4801b8d4275711","5a6a26e9d27c0c1920be1ec860a8eb04cc1b1ee82a2676fa6f69e7113d0565ff"],"paragraph_range_zero_based":[2112,2135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2112"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":2136},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":2137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2138},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":2139},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2140},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":2141},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":2142},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":2143},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":2144},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":2145},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. Otherwise the field is absent.","paragraph_zero_based":2146},{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":2147},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during reconfiguration with sync and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":2148},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":2149},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":2150},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":2151},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":2152},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":2153},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":2154},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":2155},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation)","paragraph_zero_based":2156},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent","paragraph_zero_based":2157},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":2158},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":2159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["ab63b91df34a49893809eefecd29cc07f64c44b7660e76828bab78af95f3917b","fbb5c4a11a00194e57cbd18d38177b209dd89f0559a5d20b9f970d6f559790e8","1b7dd9339af63733f95dff6f15465e930b2c6dab9ab243ba39e4eb3b1e79c103","cfc2479f166dac20394b286ad18a72dc71d2be171da58504672306a239c8a926","b2ecc5016bceede2250518877bdf0a773db7461685ce37b3d8b3626da20c2373","0f253bbd5003874d682fb01c2bbce900e80f7787a07b66eee9c6e4c6946b8c7b","4b76de5161a77c97ed1688805b3d2d5cac09053641830179e0fd34efd58f3c93","6d59fdbf32dd5262f53ed14a740d3e287ff4ef4f7535f05d412f3f2fdc924c5b","d9080b6f35e618c773b3d32cd32fb648cb65d9acd31685a7e5819dd4d5f96b07","0fc81d81a8d3dfa73e853d87b7f6089698d91c5339abdad294211ab516337459","99bbd807a6650ea7345b9058700aaa94405d1b05eedb3194fd0680cd077073eb","f271916d7cb81b67b4ae2428feebdf714074fd243c9f222519dab2c3028056af","976adbe1fc6d6b0db953739137a3ada89eb9b35351933e06f1d256b69ecbb181","b4ffbde092d45c59bc3e3cc80f4eaac5aef480adcbf94db45223e88fc9e60990","009c0a5426c7a0a075be122d352186920a884b4519ac78af82553def7a8e15f9","95a6a6fe57c345930ada29a65224a5c9459abeb6408369414a81a7f340acc5a5","ca296d0ad84173c14aee3d31f7f9a40120beee1a189382d0fd6b0260a1159258","eb928f145b94e023bbafb4e73832f27a5891c9362410a8c9520b2869439cba2b","81b21be42738ab0f2ad5fed26617375c56d8d4b3cfff5538b9f14e766de49543","a8f065d237dd50946fbb117ef8c66137c06669e7ce13fce04595a0971d94c2f2","a901b0e611aab41f36a5557e5802653852cbb0af091bbabe6f54a4cd87f15149","373c9ad0a928b28ee7471aa6955dced0bbd924697f294b055d316d05d6620339","c22ed689f9e58a7b4e952a577905ff88e13734e26bb87757f10d51844af66ed1","90d91dee7bcd9b5707e7caba24ed1edad55