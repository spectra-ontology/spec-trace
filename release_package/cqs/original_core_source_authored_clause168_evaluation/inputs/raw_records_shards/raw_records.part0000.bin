sha256":"79f5984c19f5201732d06222469fdfac7a3d95c6570ca5484c683601561d09f7","original_member_sha256":"5566407ba7f157afa39e1e7995716386e1fc82a6f5c951a64bb939bdb8f753d5","paragraph_ElementTree_utf8_XML_sha256":["cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032","13a296cdc0117fe8fab98180233cab30f64a0cefa9202305e6800261ccf44a19","5a13fceff94c505bcc5a761d985dc17eb1bfcf9724f7626d3bae06c87b37acc0","f204aa7a2ae2c45a76efe09d7d6844b1a58ab58c27a8bcba750ff1e4fd34ece4","7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","215ec34d9ca2bdd05c1b65f9a92889bb7ca26213d1a676ed59890e0b89ebe5d4","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","edd5f1436b418f127f4de842ebe3fcb39852189ac6497df1a8595fa0a8b97855","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","832c2cc0a9a351caf5049a41c1cdf451951f93fe8664cf674443c1f03785451a","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305060.zip::R2-2305060 38331_Correction_SUI_relay.docx:p96"}
{"fields":{"filename":"R2-2305060.zip::R2-2305060 38331_Correction_SUI_relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"START OF FIRST CHANGE","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"5.8.3.2Initiation","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink communication or NR sidelink discovery or NR sidelink U2N relay operation that is in RRC_CONNECTED may initiate the procedure to indicate it is (interested in) receiving or transmitting NR sidelink communication or NR sidelink discovery or NR sidelink U2N relay operation in several cases including upon successful connection establishment or resuming, upon change of interest, upon changing QoS profile(s), upon receiving UECapabilityInformationSidelink from the associated peer UE, upon RLC mode information updated from the associated peer UE or upon change to a PCell providing SIB12 including sl-ConfigCommonNR. A UE capable of NR sidelink communication may initiate the procedure to request assignment of dedicated sidelink DRB configuration and transmission resources for NR sidelink communication transmission. A UE capable of NR sidelink communication may initiate the procedure to report to the network that a sidelink radio link failure or sidelink RRC reconfiguration failure has been declared. A UE capable of NR sidelink discovery may initiate the procedure to request assignment of dedicated resources for NR sidelink discovery transmission or NR sidelink discovery reception. A UE capable of U2N relay operation may initiate the procedure to report/update parameters for acting as U2N Relay UE or U2N Remote UE (including L2 Remote UE's source L2 ID).","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink operation that is in RRC_CONNECTED may initiate the procedure to report the sidelink DRX configuration received from the associated peer UE for NR sidelink unicast reception, upon accepting the sidelink DRX configuration from the associated peer UE. A UE capable of NR sidelink communication that is configured with sl-ScheduledConfig and is performing sidelink unicast transmission may initiate the procedure to report the sidelink DRX assistance information or the sidelink DRX configuration reject information received from the associated peer UE, upon receiving either of them from the associated peer UE. A UE capable of NR sidelink communication that is configured with sl-ScheduledConfig and is performing sidelink groupcast transmission may initiate the procedure to report the sidelink DRX on/off indication for the associated Destination Layer-2 ID.","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"A UE capable of NR sidelink operation that is in RRC_CONNECTED may initiate the procedure to report the Destination Layer-2 ID and QoS profile(s) associated with its interested service(s) that sidelink DRX is applied, for NR sidelink groupcast or broadcast reception.","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"Upon initiating this procedure, the UE shall:","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"1>if SIB12 including sl-ConfigCommonNR is provided by the PCell:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"2>ensure having a valid version of SIB12 for the PCell;","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layers to receive NR sidelink communication on the frequency included in sl-FreqInfoList in SIB12 of the PCell:","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a SidelinkUEInformationNR message since last entering RRC_CONNECTED state; or","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"3>if since the last time the UE transmitted a SidelinkUEInformationNR message the UE connected to a PCell not providing SIB12 including sl-ConfigCommonNR; or","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message did not include sl-RxInterestedFreqList; or if the frequency configured by upper layers to receive NR sidelink communication on has changed since the last transmission of the SidelinkUEInformationNR message:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate the NR sidelink communication reception frequency of interest in accordance with 5.8.3.3;","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message included sl-RxInterestedFreqList:","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate it is no longer interested in NR sidelink communication reception in accordance with 5.8.3.3;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layers to transmit non-relay NR sidelink communication on the frequency included in sl-FreqInfoList in SIB12 of the PCell:","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a SidelinkUEInformationNR message since last entering RRC_CONNECTED state; or","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"3>if since the last time the UE transmitted a SidelinkUEInformationNR message the UE connected to a PCell not providing SIB12 including sl-ConfigCommonNR; or","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message did not include sl-TxResourceReqList; or if the information carried by the sl-TxResourceReqList has changed since the last transmission of the SidelinkUEInformationNR message:","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"79f5984c19f5201732d06222469fdfac7a3d95c6570ca5484c683601561d09f7","original_member_sha256":"5566407ba7f157afa39e1e7995716386e1fc82a6f5c951a64bb939bdb8f753d5","paragraph_ElementTree_utf8_XML_sha256":["09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","5e6e78c509901ae3936d881dd0c9b12c94a02c1a5b9226ba72b61bcdd6bc46b1","97864fba050d73e119a112b9b93e52fba5a967d7af701f9bc2df8e8af5169c02","71f8f88caf42f95f231f03ac15d92c9f814a99c75d96ac36de89b5ec67ceaea5","5fcc45153cf51883e98c4a6605a850d5190f3e052808adb4058930b8be869ec4","3f404c386fa4ff81bff0708bc3645a3b6eecaeb4fb6abaf030ce50f518d7b1c4","d3111f2255ed463f1f436becae8a5cb067eb5733d966d7df3d19f257c5fb4ec3","f5dde7121164bb2caa0996a8082ddf86d99ac9b53955bb0d31c91e46dcc1856a","09d7d4858ec46b0d906b29767a192d2611d8101958401fa04473a627b394743f","ced6be9dfd386a0fda913eb343230fe291d9b1f51758dd17494031ad89904941","6fffb8aa6021c3e34ca113a4eefb91fe2c637779ec685bfad2b28acdf0dbfc2f","5897aaf5d952afd3c0df77b20efcf336a472a3dcb803e75e97942266aa7cacc8","4f30badf6262ccb5d4fdddbfb63b18ae04dfbfe459964d1874ba380114e6a090","b6c5e99f82bdfa2fe2228d3ad95fa476318248f8dfeeb408e25ea91988534b67","de5eef09b62e109cd72b492a96c73c1d1276fe2b6719ee7f780306047a242724","b620e87bd12b2113bfd1ad9a21a88421b057f8c47b0e4a8a442a2902f1664831","aa70f4e30fa169a566a6194d52e8bad3f81e85f208da1f2d6d2dd297df8f21fc","65cc2dadd1f3840a18d922f7e31e8a0752b44cb89abbd6038bad2bc263b2ac63","a6d2ac61fd40b527b5b6a14f611aaf61ae608982871dbe3d484ebafa34c33f8a","9e5f464fc30e62b028ebace747c2c5084190a1d6b8f6d29b2e67accf909455bd","f8995b86ae839acadbf0df3d460ec9b296909489936b5af5a96432ca9429fd0c","7df21577a351a0383569663160c7a42596fbb9408e2f725a1190816cc47c0cff"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305060.zip::R2-2305060 38331_Correction_SUI_relay.docx:p120"}
{"fields":{"filename":"R2-2305060.zip::R2-2305060 38331_Correction_SUI_relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate the NR sidelink communication transmission resources required by the UE in accordance with 5.8.3.3;","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message included sl-TxResourceReqList:","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate it no longer requires NR sidelink communication transmission resources in accordance with 5.8.3.3.","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layer to receive NR sidelink non-relay discovery messages on the frequency included in sl-FreqInfoList in SIB12 of the PCell including sl-NonRelayDiscovery:","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a SidelinkUEInformationNR message since last entering RRC_CONNECTED state; or","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"3>if since the last time the UE transmitted a SidelinkUEInformationNR message the UE connected to a PCell not providing SIB12 including sl-ConfigCommonNR or connected to a PCell providing SIB12 but not including sl-NonRelayDiscovery; or","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message did not include sl-RxInterestedFreqListDisc; or if the frequency configured by upper layers to receive NR sidelink non-relay discovery messages on has changed since the last transmission of the SidelinkUEInformationNR message:","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate the NR sidelink discovery reception frequency of interest in accordance with 5.8.3.3;","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message included sl-RxInterestedFreqListDisc:","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate it is no longer interested in NR sidelink non-relay discovery messages reception in accordance with 5.8.3.3;","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layer to receive NR sidelink L2 U2N relay discovery messages on the frequency included in sl-FreqInfoList in SIB12 of the PCell including sl-L2U2N-Relay; or if configured by upper layer to receive NR sidelink L3 U2N relay discovery messages on the frequency included in sl-FreqInfoList in SIB12 of the PCell including sl-L3U2N-RelayDiscovery:","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"3>if the UE did not transmit a SidelinkUEInformationNR message since last entering RRC_CONNECTED state; or","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"3>if since the last time the UE transmitted a SidelinkUEInformationNR message the UE connected to a PCell not providing SIB12 including sl-ConfigCommonNR or connected to a PCell providing SIB12 but not including sl-L2U2N-Relay in case of L2 U2N relay operation or connected to a PCell providing SIB12 but not including sl-L3U2N-RelayDiscovery in case of L3 U2N relay operation; or","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message did not include sl-RxInterestedFreqListDisc; or if the frequency configured by upper layers to receive NR sidelink discovery messages on has changed since the last transmission of the SidelinkUEInformationNR message:","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"4>if the UE is capable of U2N Relay UE, and if SIB12 includes sl-RelayUE-ConfigCommon; or","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"4>if the UE is selecting a U2N Relay UE / has a selected U2N Relay UE / configured with measurement object associated to L2 U2N Relay UEs, and if SIB12 includes sl-RemoteUE-ConfigCommon:","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"5>initiate transmission of the SidelinkUEInformationNR message to indicate the NR relay sidelink discovery reception frequency of interest in accordance with 5.8.3.3;","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layers not to receive NR sidelink L2 U2N relay discovery messages; or ","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"2>`if configured by upper layers not to receive NR sidelink L3 U2N relay discovery messages:","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"3>if the last transmission of the SidelinkUEInformationNR message included sl-RxInterestedFreqListDisc:","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"4>initiate transmission of the SidelinkUEInformationNR message to indicate it is no longer interested in NR relay sidelink discovery messages reception in accordance with 5.8.3.3;","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"2>if configured by upper layer to transmit NR sidelink non-relay discovery messages on the frequency included in sl-FreqInfoList in SIB12 of the PCell including sl-NonRelayDiscovery:","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"79f5984c19f5201732d06222469fdfac7a3d95c6570ca5484c683601561d09f7","original_member_sha256":"5566407ba7f157afa39e1e7995716386e1fc82a6f5c951a64bb939bdb8f753d5","paragraph_ElementTree_utf8_XML_sha256":["64d4a9a20e7c367