1","7f0315f46cd4f6c34d1cff0d6f31a4965fccd54b86957d7c19c9771b474c43b0","0931db55f7a04e138ee86f5c6ac4b165cc636ff2b02adb7123d24fdb659a4bb9","9fe0512d07bf32a0d4b27f88ae176fe3d5ae94d30627d460497f5f3599abd226","900a30fdddae4a0be161d2a4d575b918d83171b867fd99ae2a34a0d3188d17c9","5255056cbcaccf4803318dc17b7ba47d1cbef2b1640567f3904f4fe195561fe4","4df2af2c394b04d775721a821a30ed6eaebb82bdfc0bab0491a0d5c480fbd9e4","08bbf9aabb61d6044965b5eb3a39abf616b4b08f39d6234544a6019d658dd3ec","00c22304f391f1903252e7caa3544e318d5244eebf3326815b8e86a242f65590","4f3f14847ff3dd56491ccf41e28e3b69ebf13bd3f224932a45660d9798f2bbc2","028905b50970351d3f676fea8b5c70a49e68a9384b94eab6291a25af9189f405","340605c68b9cfc9df62d0ad0bd067109c22fab89bae1fc253e2b66165a1ff2de"],"paragraph_range_zero_based":[12000,12023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p12000"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12024},{"literal_text_all_w_t_and_m_t":"-- TAG-UEASSISTANCEINFORMATION-STOP","paragraph_zero_based":12025},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12027},{"literal_text_all_w_t_and_m_t":"UEAssistanceInformation field descriptions","paragraph_zero_based":12028},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqList","paragraph_zero_based":12029},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequencies that are affected by IDC problem.","paragraph_zero_based":12030},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqCombList","paragraph_zero_based":12031},{"literal_text_all_w_t_and_m_t":"Indicates a list of NR carrier frequencie combinations that are affected by IDC problems due to Inter-Modulation Distortion and harmonics from NR when configured with UL CA.","paragraph_zero_based":12032},{"literal_text_all_w_t_and_m_t":"bfd-MeasRelaxationState","paragraph_zero_based":12033},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of BFD measurements. Each bit corresponds to a serving cell of the cell group. A serving cell is mapped to the (servCellIndex+1)-th bit, starting from MSB. A bit that is set to 1 indicates that the UE is performing BFD measurements relaxation on the serving cell mapped on the bit. A bit that is set to 0 indicates that the UE is not performing BFD measurements relaxation on the serving cell mapped on the bit. If a serving cell is not configured to the UE, the corresponding bit is set to 0.","paragraph_zero_based":12034},{"literal_text_all_w_t_and_m_t":"delayBudgetReport","paragraph_zero_based":12035},{"literal_text_all_w_t_and_m_t":"Indicates the UE-preferred adjustment to connected mode DRX.","paragraph_zero_based":12036},{"literal_text_all_w_t_and_m_t":"interferenceDirection","paragraph_zero_based":12037},{"literal_text_all_w_t_and_m_t":"Indicates the direction of IDC interference. Value nr indicates that only NR is victim of IDC interference, value other indicates that only another radio is victim of IDC interference and value both indicates that both NR and another radio are victims of IDC interference. The other radio refers to either the ISM radio or GNSS (see TR 36.816 [44]).","paragraph_zero_based":12038},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreference","paragraph_zero_based":12039},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving.","paragraph_zero_based":12040},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceExt","paragraph_zero_based":12041},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferences on minimumSchedulingOffset of cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":12042},{"literal_text_all_w_t_and_m_t":"musim-GapPreferenceList","paragraph_zero_based":12043},{"literal_text_all_w_t_and_m_t":"Indicates the UE's MUSIM gap preference and related MUSIM gap configuration, as defined in TS 38.133 [14] clause 9.1.10.","paragraph_zero_based":12044},{"literal_text_all_w_t_and_m_t":"musim-PreferredRRC-State","paragraph_zero_based":12045},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state when leaving RRC_CONNECTED.","paragraph_zero_based":12046},{"literal_text_all_w_t_and_m_t":"nonSDT-DataIndication","paragraph_zero_based":12047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["58a828d65824034705f9d4d68d3bf69bcfe20e65ef755b892ba29712509b0ec0","aa0e9a07bbbae72c6d350ca359d738596ba5a83b6cd9ef1e3233de2dfac0b162","09c32ef47a7a7c3ca10c84985d32cd7665cc8fdb29461015ec7ef2effca6ee87","b29b0b112824f27ace4f0b1e98e0e52266978c00e23e9d96f480c1be3d3a49b6","85df511a01894a31fbe05a0b57baf6e1efc54b0a9e07a824691e4614fabfb130","7f6eb5e8f3fc47ace7238fc6ecc7154ae88df9112f40b462f2d37a9171ac3e45","72aa977950086be04b7d93d2a1d342adf2bc95cc917dc2a410669e61890c18c8","2177ebc04c7d93efef0dc97c4c6078367cc61ac0df933471bf12a5dfdc8e3646","b8e080b3a5a50632b4f98db338b66d995144d5ef256e8ebc6db21b2a803a2c53","495c0216997c423614cee5d054dc2d9a1b2576b8b0b6f2e2e26f465aeb7430da","c7014c0aeb4f83f73249ebd4d3c807a971320ec0a82f458a1e41f5a05ed2c100","784d61a1f892fe1357f10baa30b956151175c7b4928df73d86852c26980af9a6","0895d9ef7dcc18c1ea11c41a8f52c60cc944d4ff6851d64ccb3f24b81c8171c7","5b830c95f0fcca8f17570c02effcf55e6591d607a93c5967c033111d10edaac1","479f618be660ceae996e677d4218123dae9d4d2b1a41cdfb24bc3caa2f7effec","61831e23bd819e4d0e4ab88d83a87336f8960e9d501910d80c27ca762147b1b9","2ee75ee5538e4dc25f31cd5490143de89c1c8a03762077f2b92d4992addb78e0","c7a1ba8a73804a411814704042595a87f9ddb7186e70b4913b411313abd36854","f7e9976fbee973f07358ae5068a744a13ff35d5153454dd0777256c52e600529","79f3a6780e39d26844ab21017daeeb6af09e9eb1e9626e2d18fcf5c0b381f5c8","6c0f0c380d24ee3ed57160ac4fbb5df88a81c3c1fde6c281e69cb9d917f7b207","4f4376a336424bd6a2696ffcbde49a0561da207737039e33faa23731317d2b34","1677279554079207a218c14e8dd44926c100f511c316195d51f7843e7bd7309a","3cb3e49de7229b781594cab36cc0cc2f874a6f94c12aaef83a07061e8000cf6f"],"paragraph_range_zero_based":[12024,12047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p12024"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Informs the network about the arrival of data and/or signaling mapped to radio bearers not configured for SDT while SDT procedure is ongoing.","paragraph_zero_based":12048},{"literal_text_all_w_t_and_m_t":"preferredDRX-InactivityTimer","paragraph_zero_based":12049},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred DRX inactivity timer length for power saving. Value in ms (milliSecond). ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the DRX inactivity timer. If secondary DRX group is configured, the preferredDRX-InactivityTimer only applies to the default DRX group.","paragraph_zero_based":12050},{"literal_text_all_w_t_and_m_t":"preferredDRX-LongCycle","paragraph_zero_based":12051},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred long DRX cycle length for power saving. Value in ms. ms10 corresponds to 10ms, ms20 corresponds to 20 ms, ms32 corresponds to 32 ms, and so on. If preferredDRX-ShortCycle is provided, the value of preferredDRX-LongCycle shall be a multiple of the preferredDRX-ShortCycle value. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the long DRX cycle.","paragraph_zero_based":12052},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycle","paragraph_zero_based":12053},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle length for power saving. Value in ms. ms2 corresponds to 2ms, ms3 corresponds to 3 ms, ms4 corresponds to 4 ms, and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle.","paragraph_zero_based":12054},{"literal_text_all_w_t_and_m_t":"preferredDRX-ShortCycleTimer","paragraph_zero_based":12055},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred short DRX cycle timer for power saving. Value in multiples of preferredDRX-ShortCycle. A value of 1 corresponds to preferredDRX-ShortCycle, a value of 2 corresponds to 2 * preferredDRX-ShortCycle and so on. If the field is absent from the DRX-Preference IE, it is interpreted as the UE having no preference for the short DRX cycle timer. A preference for the short DRX cycle is indicated when a preference for the short DRX cycle timer is indicated.","paragraph_zero_based":12056},{"literal_text_all_w_t_and_m_t":"preferredK0","paragraph_zero_based":12057},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k0 (slot offset between DCI and its scheduled PDSCH - see TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k0 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k0 for cross-slot scheduling.","paragraph_zero_based":12058},{"literal_text_all_w_t_and_m_t":"preferredK2","paragraph_zero_based":12059},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred value of k2 (slot offset between DCI and its scheduled PUSCH - see TS 38.214 [19], clause 6.1.2.1) for cross-slot scheduling for power saving. Value is defined for each subcarrier spacing (numerology) in units of slots. sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, sl4 corresponds to 4 slots, and so on. If a value for a subcarrier spacing is absent, it is interpreted as the UE having no preference on k2 for cross-slot scheduling for that subcarrier spacing. If the field is absent from the MinSchedulingOffsetPreference IE, it is interpreted as the UE having no preference on k2 for cross-slot scheduling.","paragraph_zero_based":12060},{"literal_text_all_w_t_and_m_t":"preferredRRC-State","paragraph_zero_based":12061},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preferred RRC state. The value idle is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_IDLE. The value inactive is indicated if the UE prefers to be released from RRC_CONNECTED and transition to RRC_INACTIVE. The value connected is indicated if the UE prefers to revert an earlier indication to leave RRC_CONNECTED state. The value outOfConnected is indicated if the UE prefers to be released from RRC_CONNECTED and has no preferred RRC state to transition to. The value connected can only be indicated if the UE is configured with connectedReporting.","paragraph_zero_based":12062},{"literal_text_all_w_t_and_m_t":"propagationDelayDifference","paragraph_zero_based":12063},{"literal_text_all_w_t_and_m_t":"Indicates the one-way service link propagation delay difference between serving cell and each neighbour cell included in neighCellInfoList, defined as neighbour cell's service link propagation delay minus serving cell's service link propagation delay, in number of ms. First entry in propagationDelayDifference corresponds to first entry in neighCellInfoList, second entry in propagationDelayDifference corresponds to second entry in neighCellInfoList, and so on.","paragraph_zero_based":12064},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1","paragraph_zero_based":12065},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR1. The aggregated bandwidth across all downlink carrier(s) of FR1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR1. The aggregated bandwidth across all uplink carrier(s) of FR1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR1.","paragraph_zero_based":12066},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR1 of both the NR MCG and the SCG. This maximum aggregated bandwidth only includes carriers of FR1 of the SCG in (NG)EN-DC. Value mhz0 is not used when indicated to address overheating.","paragraph_zero_based":12067},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12068},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2","paragraph_zero_based":12069},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-1, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-1. The aggregated bandwidth across all downlink carrier(s) of FR2-1 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-1. The aggregated bandwidth across all uplink carrier(s) of FR2-1 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-1. If the field is absent from the MaxBW-Preference IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-1.","paragraph_zero_based":12070},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-1 of the SCG in (NG)EN-DC.","paragraph_zero_based":12071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d09ff6623e4a9cba6294ec02deb142a1a80d08381bafffacba7926293e72c793","2d4b74ea3ec66e2c4c5f5509dd61f0774afa163a7c6673e7f5ba535ae73bba46","0c00c1d2e055046bcba7168242b397d5e4a0fc58865b8ef82b144c159902cd52","9d9599b03c1f9a74218476fac479d71c728d831ad03c74585eeb556dbd9d2e7a","7bc47fb9acd399d6e54904e804f67ab8caf3c67793ad1e36754fd035a4809dad","0d150123d961cab246ef5bf6727e13d051c7f99278a2664a81f4c56f976d26b0","442a30bc3af6f14ec96d902574efe5bbccbc25d62084779df3c2f7ecfd5cd5f9","00b40fc73bdb625aa575e45143ab1dec898259935d75bb679093587967a0920b","da61c935874e289f3ba847deb3b18e8f00de690a08504bb5dd09ac07b6d065d2","79623dc7fb59d7fc5b0e25c70989fb016e0564beb679a0ce88b582ca639fc77a","3024b1125993ae3732de31e7a9ea60b1a0da0156fd5fdf59ba6e8431e084e300","3250f0cb6459784df29a7ea689214d5bfebf1112d3d1ed70972a4d6f05995e04","b5a75414e39695cf9fe59f34928d378b9e72980fcd4f203efd542e1e4ce05866","3ce9ca85dde0c2b696f86909453a6435efd8112406d9cdfa016417140bc3845b","1b166b49316361d9d97b657bc94ea4e198d65064d4dbf4f55bd584a81cf76da4","e007fb5886c0c5db2b822f8b7b14690db8167141eb89d14ee98cc995ca089932","74a9821e1477f67322c4ec7b968c21b4e2117bf8f53198c4ab851cfdd964a1ac","206044d38345b5beeb2f367893cb98be0573c17ef13b8b1968026b71e16b1272","36a334d1ff9ecdb6239e1a2e3e32f8c072513a903ecaea5acc70a04064f038d0","91b6c437b6daf19582485dd5bc6847c75b2f430cb8780e7ea243bb6217d3d086","94c401423ec13b3ef0e9976889f8c5b2718a73a4fb7b3801ea942fe835c1d215","61fefefed8773574075c8451dd45283d30ee2ab6decba95f2bb70c3744262448","3d655b70dba45814781963c6723f0f69e9ee1e0fd086d55f8ed08336ea6f0f7d","38e777553dbc0f17a9da1114c43a6c5109438dd6dfd5588afcb6c80564321660"],"paragraph_range_zero_based":[12048,12071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p12048"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-1 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12072},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR2-2","paragraph_zero_based":12073},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum aggregated bandwidth across all downlink carrier(s) and across all uplink carrier(s) of FR2-2, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cell(s) operating on FR2-2. The aggregated bandwidth across all downlink carrier(s) of FR2-2 is the sum of bandwidth of active downlink BWP(s) across all activated downlink carrier(s) of FR2-2. The aggregated bandwidth across all uplink carrier(s) of FR2-2 is the sum of bandwidth of active uplink BWP(s) across all activated uplink carrier(s) of FR2-2. If the field is absent from the MaxBW-PreferenceFR2-2 IE or the OverheatingAssistance IE, it is interpreted as the UE having no preference on the maximum aggregated bandwidth of FR2-2.","paragraph_zero_based":12074},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of both the NR MCG and the NR SCG. This maximum aggregated bandwidth only includes carriers of FR2-2 of the SCG in (NG)EN-DC.","paragraph_zero_based":12075},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum aggregated bandwidth includes carrier(s) of FR2-2 of the cell group that this UE assistance information is associated with. The aggregated bandwidth can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12076},{"literal_text_all_w_t_and_m_t":"reducedCCsDL","paragraph_zero_based":12077},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":12078},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes both SCells of the NR MCG and PSCell/SCells of the SCG. This maximum number only includes PSCell/SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":12079},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell/SCells of the cell group that this UE assistance information is associated with. The maximum number of downlink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12080},{"literal_text_all_w_t_and_m_t":"reducedCCsUL","paragraph_zero_based":12081},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink SCells indicated by the field, to address overheating or power saving.","paragraph_zero_based":12082},{"literal_text_all_w_t_and_m_t":"When indicated to address overheating, this maximum number includes both SCells of the NR MCG and PSCell/SCells of the SCG. This maximum number only includes PSCell/SCells of the SCG in (NG)EN-DC.","paragraph_zero_based":12083},{"literal_text_all_w_t_and_m_t":"When indicated to address power saving, this maximum number includes PSCell/SCells of the cell group that this UE assistance information is associated with. The maximum number of uplink SCells can only range up to the current active configuration when indicated to address power savings.","paragraph_zero_based":12084},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-DL","paragraph_zero_based":12085},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":12086},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR1-UL","paragraph_zero_based":12087},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR1 in the cell group when indicated to address power savings.","paragraph_zero_based":12088},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-DL","paragraph_zero_based":12089},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":12090},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-UL","paragraph_zero_based":12091},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-1 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-1. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-1 in the cell group when indicated to address power savings.","paragraph_zero_based":12092},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-DL","paragraph_zero_based":12093},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of downlink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving. This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of downlink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated downlink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":12094},{"literal_text_all_w_t_and_m_t":"reducedMIMO-LayersFR2-2-UL","paragraph_zero_based":12095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c82f7ba110609ef5ed166a5973bcb3de6b3aa5fa7b2cf5a3df371481b66ba4d9","2c42a5e5da95d4ae8fa75fb7fd1d0dc81df9ef6d1019ea90f8e5be85020f75e6","4be90187cf1e986b0819e964bf1b613391eda324f3f1a4e2518d85718ab1ccde","5c6bc9e7bc43cd91c48246ec4e8c0b0244c4fdc74978e5cd141957b7ef11cd3c","3c507dba0721527a014b28e7eaf95d25d813fa04c81ecc49d36f535826e205a6","e6c812bcc670e208534a6108a1509c5064780f3328f98cb0b5ae7ac6ce38d24b","5a70f046ddc19e3f2320222f549524eb30bc8ef1bb17bb2c9e8edd44d8bffd13","ac2f9d5f444bde121954dec57c6f29f72546be6f0842d5b643c1cfffcfe0a9f2","a1f7576749d650190e2244e78f3f9157552ad31fdea8d924363f9e0592ab9599","ac8fbd044d1274fb4a243cca4a9ca6380281aa377e8fe345cc722b98ce3b6fda","58e2b8153984c97bed46d75c71285ed20d8143b96f48c686dab26d3f839fb0d4","82c9003802a009a63a25f4f4e9b07807957043dfdfad82cd309703d5c758fc90","9f579017f1c04c4d41ec02ac02c0cdcbe5b6ba0a495c1f06963018d0ccf67b2f","e3753db8eb923d156342804622cde75f7ee07716067a2db086400a50bccd825e","6160ea5e506fa402a785a660357c95655309fc3834f0a5047cb03692c49b74e1","8f7e7d459b56e16260ea0904e4384d8e207c7aa4c12190433860f5ce6d070d03","1b7bae91a6a54101383df96425b6f1b7d143675c77400207777c239c22d971fe","a2bcda2c761bbdfa37f9b6f647d1edf09f613e295c71e29a547d1705e82b4e6d","b8f683fbac721d240e6ab748350c841b5e35b4bd8b40a7cc6fc2493dec952510","dd88e170c853046d7ba351806e8286f1b58ff345406e1f8140f30fbf34b88ec3","591bb5ba5062e72b96dccff0d133981f4156220477ca6b3154fbaa6d2e487a09","8d8d38d2edfdfb944bff99812dc85f92964f1607b04647f5eadb4a8efda6aa19","3c508cf6fcefedec139665d32590a90562f65977d4a9889884471b4e9ec086f5","e47aa6f96c3ffd48f2d46f3c0a540083c970a625ecb6785326cde52bf6c47f9e"],"paragraph_range_zero_based":[12072,12095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p12072"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on reduced configuration corresponding to the maximum number of uplink MIMO layers of each serving cell operating on FR2-2 indicated by the field, to address overheating or power saving (see NOTE 1). This field is allowed to be reported only when UE is configured with serving cells operating on FR2-2. The maximum number of uplink MIMO layers can only range up to the maximum number of MIMO layers configured across all activated uplink carrier(s) of FR2-2 in the cell group when indicated to address power savings.","paragraph_zero_based":12096},{"literal_text_all_w_t_and_m_t":"referenceTimeInfoPreference","paragraph_zero_based":12097},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE prefers being provisioned with the timing information specified in the IE ReferenceTimeInfo.","paragraph_zero_based":12098},{"literal_text_all_w_t_and_m_t":"resumeCause","paragraph_zero_based":12099},{"literal_text_all_w_t_and_m_t":"Provides the resume cause based on the information received from the upper layers.","paragraph_zero_based":12100},{"literal_text_all_w_t_and_m_t":"rlm-MeasRelaxationState","paragraph_zero_based":12101},{"literal_text_all_w_t_and_m_t":"Indicates the relaxation state of RLM measurements. Value true indicates that the UE is performing relaxation of RLM measurements, and value false indicates that the UE is not performing relaxation of RLM measurements.","paragraph_zero_based":12102},{"literal_text_all_w_t_and_m_t":"rrm-MeasRelaxationFulfilment","paragraph_zero_based":12103},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE fulfils the relaxed measurement criterion for stationary UE in 5.7.4.4. Value true indicates that the UE fulfils the criterion, and value false indicates that the UE does not fulfil the criterion.","paragraph_zero_based":12104},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":12105},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":12106},{"literal_text_all_w_t_and_m_t":"sl-UE-AssistanceInformationNR","paragraph_zero_based":12107},{"literal_text_all_w_t_and_m_t":"Indicates the traffic characteristic of sidelink logical channel(s), specified in the IE SL-TrafficPatternInfo, that are setup for NR sidelink communication.","paragraph_zero_based":12108},{"literal_text_all_w_t_and_m_t":"type1","paragraph_zero_based":12109},{"literal_text_all_w_t_and_m_t":"Indicates the preferred amount of increment/decrement to the long DRX cycle length with respect to the current configuration. Value in number of milliseconds. Value ms40 corresponds to 40 milliseconds, msMinus40 corresponds to -40 milliseconds and so on.","paragraph_zero_based":12110},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PatternPreference","paragraph_zero_based":12111},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on FR2 UL gap pattern as defined in TS 38.133 [14].","paragraph_zero_based":12112},{"literal_text_all_w_t_and_m_t":"victimSystemType","paragraph_zero_based":12113},{"literal_text_all_w_t_and_m_t":"Indicate the list of victim system types to which IDC interference is caused from NR when configured with UL CA. Value gps, glonass, bds, galileo and navIC indicates the type of GNSS. Value wlan indicates WLAN and value bluetooth indicates Bluetooth.","paragraph_zero_based":12114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12115},{"literal_text_all_w_t_and_m_t":"NOTE 1:The field may also indicate the UE's preference on reduced configuration corresponding to the maximum number of SRS ports (i.e. nrofSRS-Ports) of each serving cell operating on the associated frequency range.","paragraph_zero_based":12116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12117},{"literal_text_all_w_t_and_m_t":"SL-TrafficPatternInfo field descriptions","paragraph_zero_based":12118},{"literal_text_all_w_t_and_m_t":"messageSize","paragraph_zero_based":12119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7308451c7736160815f08410c266ad4f52da919b65bd3763cc3966f60ef4b732","4a2917cdd6adbc0ea35cb92a087d721daeceef65c96d2616be26da55ae27e491","fe2db18456b91dfb2ef1f82ee3b81ab61e581ce63ef6ed04599881cba44c1ed2","180df7c1272f5c1b86b3e8058e322bf47caad6b7b7c0de4228afa2654ceb3edc","42479c92e3c7884ef9f28f595696ab3ebc8a95c876b48ff645c487754c701ad0","87461326a5ed8103d60573cce1c86b2428c1de67df4178d27918c731ea3d4616","62f14852bd3f204b923d8a5fc0653a9007df29ce409d3dea947adab5132bb9d2","23928641baaa72983ae407e455cd128b7fa073e929e7cf18348402049c11dfde","d205c8be0c4d930ff77d8ea82267d4f3778f90f2c5d000f93c653135a950fb17","02b535280317b054dd24f9a5a7c34048d0f99210386786a6e4805abdc57ae3ba","e62d731adf55f84368aa7f0645fc6942a83ba7d9823393f27597e8ee057c7a41","e4e86ed3d0249a255b270c8d2172ead9a0a1193fb91a6223b41ba8ca619456ba","660c41da27dbe73f14cf84ffa739b22179f896faf1025eb30212d7cb1a107838","5b9cec716cd2c102470695388b884ca98b8f68eb620509b10b9d45868c19fa9b","c9250360de0191aa633fb5d51be6560ea882497c3e089cbbca9f78a0a532fd30","1636dbef8281da6896e3a5b0894b538bd23cb5ee6090cda0b1bc77a9118b46b0","207c94f28f21456af03914ade6a50e6a3f170d40f0cd441821668bf0e0f773ac","755638aaec75d131889f9797c63e344456bff124c35e986e1adc4ecaf16e2dd1","51216194f95be7ea071349cbb3c49613145ad5174164813b329bc6e41e3b3c5c","8824daf07895e6c223340e9d990ecb7fef30a825b99947ad53d1109a5c971032","c4b22ff93d7d1a60521c4a593236a634188049317af5d4f0fb07c77b48d83149","dac448ada984de60aad4ebc4159a6fa1fac825dbe8f95b1da06579635e2bf932","71716f35d5f976b286a8d721a80cb521096555e4bd7bd6d88e893050c797ba28","f09859de3bf3055517ce8be3e317feb6a1d3b84a12d1f1a24cbe4db5a40f9f40"],"paragraph_range_zero_based":[12096,12119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p12096"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the maximum TB size based on the observed traffic pattern. The value refers to the index of TS 38.321 [3], table 6.1.3.1-2.","paragraph_zero_based":12120},{"literal_text_all_w_t_and_m_t":"timingOffset","paragraph_zero_based":12121},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated timing for a packet arrival in a sidelink logical channel. Specifically, the value indicates the timing offset with respect to subframe#0 of SFN#0 in milliseconds.","paragraph_zero_based":12122},{"literal_text_all_w_t_and_m_t":"trafficPeriodicity","paragraph_zero_based":12123},{"literal_text_all_w_t_and_m_t":"This field indicates the estimated data arrival periodicity in a sidelink logical channel. Value ms20 corresponds to 20 ms, ms50 corresponds to 50 ms and so on.","paragraph_zero_based":12124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12125},{"literal_text_all_w_t_and_m_t":"–UECapabilityEnquiry","paragraph_zero_based":12126},{"literal_text_all_w_t_and_m_t":"The UECapabilityEnquiry message is used to request UE radio access capabilities for NR as well as for other RATs.","paragraph_zero_based":12127},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12128},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12129},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12130},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":12131},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry message","paragraph_zero_based":12132},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12133},{"literal_text_all_w_t_and_m_t":"-- TAG-UECAPABILITYENQUIRY-START","paragraph_zero_based":12134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12135},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry ::=             SEQUENCE {","paragraph_zero_based":12136},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":12137},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12138},{"literal_text_all_w_t_and_m_t":"        ueCapabilityEnquiry                 UECapabilityEnquiry-IEs,","paragraph_zero_based":12139},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":12140},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12141},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["40f0ed937efdbad68f989f71b66c9bbf531aaf020f2eb906ac2d9c4127348855","70e2945f1ee57418248e02246ea88b254218f25da74a45d146b57e8e28bcc4ad","4e377610335c2149d3ab6311482876a5c9c314c06064e9090c77aa2eb14eedfd","007e2dd81e40f01d1d5716b451da3837dd3621ee88c2773951a62442505a96c7","a35571cbce8707cce14f47068ce75ea89fe98fd85b99a746f5a6843ea3ff121f","a62a3c3198af0ea1191464b9186fe9d2d5a39f00b78358a35e32c68b9a1f51a3","9d83e35ce715ccccd2957b2cd910f764bb4e978b1835e5bda10d3bddbbcbeff0","ae46396d8f754cb6b8093ec5df08f32edfbe7922a792e451c66cb8597fa7d298","20af60c561800a638cc4dbb7e1ce300ab232b4bbae3dcc3e6497f72cb3ee531c","7886d46c43765b08c0baa61b0992ea09dea624643260c22af40773f63cad4431","1cce2abf369cfc7ca2686e84e0e54ff985b5076f5e4d4f29ca2017af988e165b","b03f8a26d15a6f9f0cfb64c2e78b0eb20f7a6ba4c75fa09358a1697bdec3c304","593fdb