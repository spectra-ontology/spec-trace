85c4b98574a","8733674307078f394fbb7d0926b085ec4a624f07fc2990c5f6e5f175d9f87834","823e9ffbbcd0c177fa416aec1627c30e86b345a3f14826a7487e7e09038633c7","6cc095cde4fb8f5e751c6f301b69d875bdff8eeee00cae95bc9b1e61b2c46f96","094018615f7d52df0cc0ab3d0737b6b9ab35c80152eb225b149228261c009ed6","8c3a672dd1b131e83b8c74993a3458a7584f4e7f1e8d0a3c792b36644e303235","1927d08eaa7b928be7bcf1829b3c7f81c63c54c4b60dc021e337ba4e9c0bb667","dfa287610106d5d8b3777c0a894c374be4ffd82af05c9976837884d7930fd9f5","c13c978d531220ded3a0ee00e53d4fc8e26d904f763b240943e01737d2adc199","21664132f015d810594df479addf9726f755a4feb5977d1d0830f3b132a826ae"],"paragraph_range_zero_based":[29352,29375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29352"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":29376},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":29377},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":29378},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":29379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29380},{"literal_text_all_w_t_and_m_t":"SSB-MTC2 field descriptions","paragraph_zero_based":29381},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29382},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":29383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29384},{"literal_text_all_w_t_and_m_t":"SSB-MTC3 field descriptions","paragraph_zero_based":29385},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":29386},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":29387},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29388},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC, used for IAB-node discovery.","paragraph_zero_based":29389},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":29390},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":29391},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":29392},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS block index 0, the second bit corresponds to SS block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS block is not to be measured while value 1 indicates that the corresponding SS block is to be measured (see TS 38.215 [9]). When the field is not configured the IAB-MT measures on all SS blocks. Regardless of the value of this field, SS blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":29393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29394},{"literal_text_all_w_t_and_m_t":"SSB-MTC4 field descriptions","paragraph_zero_based":29395},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":29396},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":29397},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":29398},{"literal_text_all_w_t_and_m_t":"Offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Offset is given in number of subframes.","paragraph_zero_based":29399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c26bf3c683d438649d1ab32045a921cd4e3f06a02b6af900b537b7793707615b","9d733c6552859d46b7d370fa3645c56a69c5b850db8feef75a9239be65a64096","5c9fe3cebf924e2a99871cfdec6879cbe2fff9dfa5cfa3970c09aba464e1374b","edd56acc85f623533261ab59b5611e0758f975f054fcff96e1a259e163995252","85b3489da7b0ecc1d223c1bee4607e124b3060d0c331f2738141f54439d00405","78d3fcc0526b065b3ba4c8b49ee53fb5ec8e928fb9ad0fe059bc96c716d23ab1","c4f8e93146b8f03d9c7df3bd66cc8452e511bfe9a6b8d886860d43a5891a9915","91b3cdb967015a44f69ed56552be576264158ff034fbba8d290ad8e384646596","d237895c7ad3f112591c645ce458f0782e61473251f0bf1856bcaf743c113926","f7d932503e1e6af4355911a315feb23d5a909c175f1437643f53b314141862b3","14dd19d5951d3ed089c8c286cd82b8d28edd72b3aae493192b32ecce3fca93f3","0d595ee565aff1fbb5b7c8c1da47bb670527f5d252f610ffe5e4ccba6711eb5c","38a31e17120c1c855e79177482e804cd081c74e82015e322fe8030f915749464","b7b504447385aabc147e24208c61ba4aad094dcbf090b6cd3fd4d784c96a8114","3f349da400469ebb5d6cd14829584f554ff8e5ab0ccfb6e42d1d2317723f4c50","2fb1e599c4f774c5dd7a492d1db1a82d65c1b4bec4be16fa3c6b060c44f19489","9f9f951ec15b9d09c64b5f915d6d3cc8893f56601a7a1c43e757bd3d0b44db00","0f3ffc9a9fc37e6e0c569de4cdec800465bbed2288d4a060a53cdf408f8d36aa","c4794142345d3e3aa13f71da04a5c828a3a20f2d066ad80d27e15278409c5a11","28b44537d6078ac842d3571ffca0c4fd1c2d0f14d3209d5d7670f2a958f7495f","4569ef8c162630d99f371d7fda14d9446ba4502b758aed5bbd0c231c9da92b15","7083469ee2d7f278694f46c8f9fe626774cb6d2a01cf7e87c3a2c034dc2fdb50","83445671d3dda9aab0a33d5ec590ade201621621a98d554a4d66dde5d5d829cb","24d853c480ae6b2be805da342b05d20effbe72a1b1d7a0168f4443ec83e712cf"],"paragraph_range_zero_based":[29376,29399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29376"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29400},{"literal_text_all_w_t_and_m_t":"SSB-MTC-AdditionalPCI field descriptions","paragraph_zero_based":29401},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29402},{"literal_text_all_w_t_and_m_t":"PCI of the additional SSB different from serving cell PCI.","paragraph_zero_based":29403},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":29404},{"literal_text_all_w_t_and_m_t":"Periodicity of the SS/PBCH blocks, see 5.5.2.10. Periodicity is given in number of subframes.","paragraph_zero_based":29405},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":29406},{"literal_text_all_w_t_and_m_t":"Indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":29407},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":29408},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":29409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29410},{"literal_text_all_w_t_and_m_t":"–SSB-PositionQCL-Relation","paragraph_zero_based":29411},{"literal_text_all_w_t_and_m_t":"The IE SSB-PositionQCL-Relation is used to indicate the QCL relationship between SSB positions on the frequency indicated by ssbFrequency (see TS 38.213 [13], clause 4.1) for operation with shared spectrum channel access. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":29412},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation information element","paragraph_zero_based":29413},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29414},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-START","paragraph_zero_based":29415},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29416},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r16 ::=  ENUMERATED {n1,n2,n4,n8}","paragraph_zero_based":29417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29418},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r17 ::=  ENUMERATED {n32, n64}","paragraph_zero_based":29419},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29420},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-STOP","paragraph_zero_based":29421},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e49e65dbb1e74e1c27754356b40b7a9f334a04d528453063afe8b3691262ac2b","72f8ee7875b7b94bba2a42662e35d70d8f508de6b50cbd87e451e1c630a84bed","11c54f21b2386d5029a04eb085af4df72aa57d8453c38ff04f75b3e4e5444909","7bf85ee6c5a3b80e7c333527e6dfc500ed53c12bba3bf3b5d7b028d4dd711e5d","9f8a74c6149a0b5626b40e5ac5108b3f9f4148bb14cb82e1836612eaa5b82fca","f571601175b938b0809fd0625499e61892f299c516ea56f3497ac887cca4c419","d2836f528a4fa9ba20f594bda8f612ffba5f5da4ecac9e35db93e95b5e6d9a5a","070ba1bf3435f9223fb302fa35d1a4d0fa69808e48b3fd6e42160e76f1f7b4dd","4267305859ac48b0e215bc2222c3e981fb0dd8f917a1769e8c964ba53e987c3d","d968a3aa19e819e07a8115121cb270f2438b5e4d7434c7f5bcbe95447a5f61ca","4abbe53c92ff116bd804734e7e9ded5e6444cb172edb79fa45a8badb9626924f","26ab016c19445fd5f5acffd354da20d44536de0db6dda1af6ca89ebdf6060ea0","3f5ab6c1d511243e41f811e288b8d6cc115034765cc2b2ad8fa6934d39bea863","18fc0c48fe699c7f2aa22330d21026973b0173aa91940843fafd18a50a019d69","bf5585e6ea75d39c12f085a9b24fb74c221c2060429075c9517cc040cb1421d6","c040a01798c274a0720eadc0dc9a490fdaeac6c1cd50ae6c30745327f581ad90","69618d3cce636c51f066e2fea933f5e6aaf99096243d5a44a9f422df0e66bcce","4dbd97baec27e91f78444ea2bd8b134c44d5c530ae19690d9086352118dfb2eb","acb6c5e83d56f388cce3b196558870f64d9ae7610c1b53d3a68adef53e4c3db4","ff5dcd86776f8321c6e6ed22ee6836e20a7a7ac6f8025f29307abb3623def414","d7ec11902ac293a58481751a7a2a0b935b2004aafd1e4a5585f8fcf4614fecc2","949f675e9d27bc7a6682996904f6965a7c6078f5fe65c65cfc2a8e2b31715124","caa57081f12e2c52d5b390c3e9f6909945d138fa9b2881f903d8a962252ec43c","5be95574140f0df224bf868d9f7e5be085eb80337bb2d0e650ed6b8e0c39d7c4"],"paragraph_range_zero_based":[29400,29423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29400"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SSB-ToMeasure","paragraph_zero_based":29424},{"literal_text_all_w_t_and_m_t":"The IE SSB-ToMeasure is used to configure a pattern of SSBs. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":29425},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure information element","paragraph_zero_based":29426},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29427},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-START","paragraph_zero_based":29428},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29429},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure ::=                   CHOICE {","paragraph_zero_based":29430},{"literal_text_all_w_t_and_m_t":"    shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":29431},{"literal_text_all_w_t_and_m_t":"    mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":29432},{"literal_text_all_w_t_and_m_t":"    longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":29433},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29435},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-STOP","paragraph_zero_based":29436},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29438},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure field descriptions","paragraph_zero_based":29439},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":29440},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to (k– 1) may be transmitted; if the k-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted.","paragraph_zero_based":29441},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":29442},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL-Common and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. If ssb-PositionQCL is configured with a value smaller than ssb-PositionQCL-Common, only the leftmost K bits (K = ssb-PositionQCL) are applicable for the corresponding cell.","paragraph_zero_based":29443},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":29444},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":29445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29446},{"literal_text_all_w_t_and_m_t":"–SS-RSSI-Measurement","paragraph_zero_based":29447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f2627b3c0e2bd21eb2300348056b1d63b69a2150973343bf6ab5fdd63633254f","c25690169d121d71d2723fcf310fcee28e0a71053d6e7379a5ab30e00fc5e28a","815680d2bb90d9fa315c8587c1320e60699fa33d24d894cd3b2e904de75834c5","7e41671c4b443fae5c15eef579eaae742212eb87142d4794c3467fd8dd4a4b2b","2b72302b84dc96f59a51cb4a6e968e2126b190765c8170cf61b3bad839dc65ab","94fbddff532b4226e433762dc1aef302ed27b81090f03afe88a730db3680200b","b54308cde8a8db2863676fb260821da63a7ba70ef473142476157d49c32b40b1","91f0bd57d66fb1a5b07958381e647eaf56c7f883c5047d07fa9fa65b106bbd97","ab212c54be706c13348f7706c9d44f673c5d753edea0fac8a719c1167addfdbc","844d2f9450e7a544e428b14cf12d696feff15149180f59ab5bbe0d1adfe7220a","084a54d5a30a0467b86d10d7763a5a7a28373af2a710eb9efb0c435c1834a6b8","7de78967c10ba33c4b2a454444fcf1a4b7ffe4e575718b77f73639c25fbca2be","c31217704aa38f92ddfccddc1166344072ccc30aadbcc7a2238870682e2cad3a","8c3168c9c9b6370023c0dad26a9badac89542dd9611a31516362434a34d7cd72","0dd4ad5d2100fb8390d9c924ece0a16123dd025afce3aa7e5e426652f3bf9bdc","be48f3d08efd7a516977f9f887193d3c95a690d630ac357d0d4004dbc8c9a297","e9a641dadd1048a8737b679aef547d333070919f95850c6de665fdbd56072c2b","549665d046b67dc7f7fa19f9a7129ac80d4015a47a32488847237cb3e4a0f87c","ff5b203d900f4a663b24a28e509c8da721133488345f1bb9ee2d63a19d9f2236","89aa9e78a576b2f8a7be8070b06e8c5959e92dad7302ef88d92183707cd1adc5","a4b08dd66d1650887f47be977b1d17311d9170b1d7a1cd2bcc0507f07c6e57a3","ac764380a428ab033b47c911e3c1b9715421f99c5fe017a3458480e9f92ea3d4","30aad4a593a180877d89c998ea3cbbccdbdef990ec9aa227d4fc4978800e036f","ec989e51c186268576c1c0f2df2f093fc8271f37b4bd8ac3c36a1ff1143cb219"],"paragraph_range_zero_based":[29424,29447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29424"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SS-RSSI-Measurement is used to configure RSSI measurements based on synchronization reference signals.","paragraph_zero_based":29448},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement information element","paragraph_zero_based":29449},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29450},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-START","paragraph_zero_based":29451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29452},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement ::=             SEQUENCE {","paragraph_zero_based":29453},{"literal_text_all_w_t_and_m_t":"    measurementSlots                    BIT STRING (SIZE (1..80)),","paragraph_zero_based":29454},{"literal_text_all_w_t_and_m_t":"    endSymbol                           INTEGER(0..3)","paragraph_zero_based":29455},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29457},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-STOP","paragraph_zero_based":29458},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29460},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement field descriptions","paragraph_zero_based":29461},{"literal_text_all_w_t_and_m_t":"endSymbol","paragraph_zero_based":29462},{"literal_text_all_w_t_and_m_t":"Within a slot that is configured for RSSI measurements (see measurementSlots) the UE measures the RSSI from symbol 0 to symbol endSymbol. This field identifies the entry in Table 5.1.3-1 in TS 38.215 [9], which determines the actual end symbol.","paragraph_zero_based":29463},{"literal_text_all_w_t_and_m_t":"measurementSlots","paragraph_zero_based":29464},{"literal_text_all_w_t_and_m_t":"Indicates the slots in which the UE can perform RSSI measurements. The length of the BIT STRING is equal to the number of slots in the configured SMTC window (determined by the duration and by the subcarrierSpacing). The first (left-most / most significant) bit in the bitmap corresponds to the first slot in the SMTC window, the second bit in the bitmap corresponds to the second slot in the SMTC window, and so on. The UE measures in slots for which the corresponding bit in the bitmap is set to 1. In case this field is configured for a SCell with ca-SlotOffset-r16, the bits in the bitmap corresponds to the slots that are fully contained in the SMTC window.","paragraph_zero_based":29465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29466},{"literal_text_all_w_t_and_m_t":"–SubcarrierSpacing","paragraph_zero_based":29467},{"literal_text_all_w_t_and_m_t":"The IE SubcarrierSpacing determines the subcarrier spacing. Restrictions applicable for certain frequencies, channels or signals are clarified in the fields that use this IE.","paragraph_zero_based":29468},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing information element","paragraph_zero_based":29469},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29470},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-START","paragraph_zero_based":29471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4c7c71f87be6f7112b557467f0e463752ca886cbc0e747ada3c065a6fb399bce","1d8bed55155039de1d7d84342588f8d909ef5dc227181e594543d1b10b568ab9","732c69268e0b67bbf11fb51b638f5620a6c2e83730f7cd02f8e7622e8bac22d1","33a457d1166da1e147ca642cf4be499257b8cc1ac53da94011707c2ac9ac04a9","4751c679ab29ac968e7c521711bc768fc2d579bafd499779ad6face8e590f5a7","8d2bc556c6b984d13344cf366d638224532e2ab34c4c8afa6d3b75a64b5d7dcf","b8cdb47e0347c1c022eb350a3dff1482f5514e8cacec66f284fdc3f48676bd05","441d4270171db9b125098af68d1e17d4a4cce1f8565568f529de243206b6f5df","dc60b99e75595ff0f1ffd3c1963c66a76ddacd94423255eab3862a43595d611f","38a1fc26558d37e30f04677958f3b177b29a661eb24525d5a1aa880f8c515c58","76e24c28591dce3915aaa5803ab293030425a43213d481a1096961c1e9d2c47b","13e1cb7a3553b3dbf3b48150b4f4719d7b36225f8e4d8ef24c60342d6a58990f","258b2ffec8ba2f362c7b9fa57eb0a69aa02755ebb340ee65a4c2f43a862236c6","abf1dbcf8358cdc4ac2350af7e22335f054c3bcf32fee8951a080516ae391dba","9dd854c57b72c7f7cf6b1ecbb275fb6fee10a9b187ae2fd0d690f137dc6bf1bc","24e417e78cd4c2c82214f3cdeda24c06cbfc8f85f487f1b3849067e6601e1d9b","f3795496d03e2dd7a03ef1f6567555e987ceb383d207c953bec37d32cdccad58","bc3a584383257e4360dac75f1eef3bd95116154310b5e4d6071ebaff26807b9a","d1739670a765a8141b16989741c40d2455bd88ed8e344a245234d062818d5f28","9eec51221ca99a508c65d65994145f0bd3cbc588959ea05edd54d2db8da3ca9c","5fe0bc525c7e14150322c092ad31678eaee3160f05a001ca4c3e6449c31bed8b","c3bb8f12c4bb493e7e54cb07a80cc549c29ad0c7d78a618e5e6a673b4758a734","87e1007d2c289f3e00c766e60beaebed991a1d6df29cbd23a1c6cfe951d5308f","d1a77d3fbd7d6dbd741418e8d68d3fee43d7594958acc704f865cb30ab3eb20a"],"paragraph_range_zero_based":[29448,29471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29448"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29472},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing ::=               ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, kHz480-v1700, kHz960-v1700, spare1}","paragraph_zero_based":29473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29474},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-STOP","paragraph_zero_based":29475},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29477},{"literal_text_all_w_t_and_m_t":"–TAG-Config","paragraph_zero_based":29478},{"literal_text_all_w_t_and_m_t":"The IE TAG-Config is used to configure parameters for a time-alignment group.","paragraph_zero_based":29479},{"literal_text_all_w_t_and_m_t":"TAG-Config information element","paragraph_zero_based":29480},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29481},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-START","paragraph_zero_based":29482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29483},{"literal_text_all_w_t_and_m_t":"TAG-Config ::=                      SEQUENCE {","paragraph_zero_based":29484},{"literal_text_all_w_t_and_m_t":"    tag-ToReleaseList                   SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG-Id                          OPTIONAL,   -- Need N","paragraph_zero_based":29485},{"literal_text_all_w_t_and_m_t":"    tag-ToAddModList                    SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG                             OPTIONAL    -- Need N","paragraph_zero_based":29486},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29487},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29488},{"literal_text_all_w_t_and_m_t":"TAG ::=                             SEQUENCE {","paragraph_zero_based":29489},{"literal_text_all_w_t_and_m_t":"    tag-Id                              TAG-Id,","paragraph_zero_based":29490},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimer                  TimeAlignmentTimer,","paragraph_zero_based":29491},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29492},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29494},{"literal_text_all_w_t_and_m_t":"TAG-Id ::=                          INTEGER (0..maxNrofTAGs-1)","paragraph_zero_based":29495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bcebf6fd37981b36fa149ea37681f25c2723edbe3a6f579bc8971b1045468b22","e934f26fecc730388d534812c870c7c540d9f395f973a6f987d32dca433e912d","16659f34a95c132e692f69cb0c43cfe5953dad419555581ab726681cdf6b9bd2","dce61b3bf23200c05441f30a19b67cfea271adcc73662cc351f75419c4e90a4f","0180862880abb17279c33e6afffaa0674160fb364f0bc731721f1b34fd5bb313","748b707bb16bff03f29a2ec267c3065d8248e8962178df86818309a74ea92ae1","5a3cd47dfbc0e75e46c8ba97bffd8734972b3094cd261daaada047a62214bfd0","316e47d87d68bff28c7de373c613798c4e7b7916684cb88806f7c9436748514f","193e54c3da0c5407e40fc1e984e2687d7182f8dc92ea53120b8863296b20176a","ff20cbfac930f4e996447e742493c9d1d22bddde5040e532084b3413098ce02c","5287f2894c262fef8b5c3f4516b9fb9a8db4768262cb75c003c53b60f0052dd9","3cad5a24cac564f510287e35e753bb2c5b4aedf2ec93d7616f907f13c47e0fd4","51cce8911693b2c6debb3d18e9fa1fc7e8e867d589b84aa2dd09d0fcb4860482","88d1e598d5b139989ca68be0f70620fa10e8271a50d2e249f178e5650e587efd","0cb3f4944ecd31ac354b08e68562f83fe7bbc42dfbeaa6ced5aa109e754bf62a","8493f955a4a599c54ce1603be944ce991130388c58e994e20fa870ef8a96102f","2776b3d178dfb2af5ddfb0a29835f1e9939c4e4ea8c38501d5e6c47d60a0325c","ffda0458b9be0a1f945cac270bb5945ea272822e7156eb37bac22c8b49107891","b6715fadd4c8c189bf79013095dc29d19234a83b334993798061830bdee16df7","d196a70a4963abde0069b26bd7bbeb6b6bde76f9b18e0b51515f1c5d755b7e0e","860a3dca856ce3ca6c39435a19bb88543cc5a8e950aa8c93212de010e366506a","81e043f1ad137209551ecd44d6f852fcad3b3098e4a937b6842ef007e1cf74fc","fbc7c5a47c1869d2efca7ed52429a45ebfa0d72e92967d99bc83f721e4380098","df999fb29385f25659b3feeef8798892f312fb836d078aabffcecef4270543de"],"paragraph_range_zero_based":[29472,29495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29472"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29496},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-STOP","paragraph_zero_based":29497},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29498},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29499},{"literal_text_all_w_t_and_m_t":"TAG field descriptions","paragraph_zero_based":29500},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":29501},{"literal_text_all_w_t_and_m_t":"Indicates the TAG of the SpCell or an SCell, see TS 38.321 [3]. Uniquely identifies the TAG within the scope of a Cell Group (i.e. MCG or SCG).","paragraph_zero_based":29502},{"literal_text_all_w_t_and_m_t":"timeAlignmentTimer","paragraph_zero_based":29503},{"literal_text_all_w_t_and_m_t":"The timeAlignmentTimer for TAG with ID tag-Id, as specified in TS 38.321 [3].","paragraph_zero_based":29504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29505},{"literal_text_all_w_t_and_m_t":"–TAR-Config","paragraph_zero_based":29506},{"literal_text_all_w_t_and_m_t":"The IE TAR-Config is used to configure Timing Advance reporting in non-terrestrial networks.","paragraph_zero_based":29507},{"literal_text_all_w_t_and_m_t":"TAR-Config information element","paragraph_zero_based":29508},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29509},{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-START","paragraph_zero_based":29510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29511},{"literal_text_all_w_t_and_m_t":"TAR-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":29512},{"literal_text_all_w_t_and_m_t":"    offsetThresholdTA-r17               ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5, ms6 ,ms7, ms8, ms9, ms10, ms11, ms12,","paragraph_zero_based":29513},{"literal_tex