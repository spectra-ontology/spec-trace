RequestId-r16       SetupRelease {SchedulingRequestId}                                     OPTIONAL,    -- Need M","paragraph_zero_based":37738},{"literal_text_all_w_t_and_m_t":"    sl-SSB-PriorityNR-r16                INTEGER (1..8)                                                         OPTIONAL,    -- Need R","paragraph_zero_based":37739},{"literal_text_all_w_t_and_m_t":"    networkControlledSyncTx-r16          ENUMERATED {on, off}                                                   OPTIONAL     -- Need M","paragraph_zero_based":37740},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37742},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config-v1700 ::=      SEQUENCE {","paragraph_zero_based":37743},{"literal_text_all_w_t_and_m_t":"    sl-DRX-Config-r17                    SL-DRX-Config-r17                                                      OPTIONAL,    -- Need M","paragraph_zero_based":37744},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelToReleaseList-r17      SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelID-r17            OPTIONAL, -- Cond L2U2N","paragraph_zero_based":37745},{"literal_text_all_w_t_and_m_t":"    sl-RLC-ChannelToAddModList-r17       SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelConfig-r17        OPTIONAL, -- Cond L2U2N","paragraph_zero_based":37746},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":37747},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37748},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37749},{"literal_text_all_w_t_and_m_t":"SL-DiscConfig-r17::=                 SEQUENCE {","paragraph_zero_based":37750},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-Config-r17                SetupRelease { SL-RelayUE-Config-r17}                                  OPTIONAL, -- Cond L2RelayUE","paragraph_zero_based":37751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table parag