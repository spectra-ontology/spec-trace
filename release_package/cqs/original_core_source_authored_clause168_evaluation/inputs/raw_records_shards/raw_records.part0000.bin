{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"subframeAllocation2","paragraph_zero_based":36744},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig-v1430 in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":36745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36746},{"literal_text_all_w_t_and_m_t":"–EUTRA-MultiBandInfoList","paragraph_zero_based":36747},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MultiBandInfoList indicates the list of frequency bands in addition to the band represented by CarrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":36748},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList information element","paragraph_zero_based":36749},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36750},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLIST-START","paragraph_zero_based":36751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36752},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList ::=     SEQUENCE (SIZE (1..maxMultiBands)) OF EUTRA-MultiBandInfo","paragraph_zero_based":36753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36754},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfo ::=         SEQUENCE {","paragraph_zero_based":36755},{"literal_text_all_w_t_and_m_t":"    eutra-FreqBandIndicator         FreqBandIndicatorEUTRA,","paragraph_zero_based":36756},{"literal_text_all_w_t_and_m_t":"    eutra-NS-PmaxList               EUTRA-NS-PmaxList                           OPTIONAL    -- Need R","paragraph_zero_based":36757},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36759},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLIST-STOP","paragraph_zero_based":36760},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36762},{"literal_text_all_w_t_and_m_t":"–EUTRA-MultiBandInfoListAerial","paragraph_zero_based":36763},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MultiBandInfoListAerial indicates the list of frequency bands for aerial UE in addition to the band represented by CarrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":36764},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoListAerial information element","paragraph_zero_based":36765},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36766},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLISTAERIAL-START","paragraph_zero_based":36767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ccdd0daefcf40b2fa7b5dc6b45021a22e8894b1fcabe296b3144c904cfb9164f","3b8b8ad82426c63db2293082ab7b33ae700ce8c0220e910bbb0a8ba91c811e24","7d355b884fb0347f70bd04c629207d9fb34efcf6255bb06d0250794fa8a0d198","271482f47ba71c76f99562b6ce967d8761d3ab89906a4ff17753a0335486689d","e11301e95c31cbbea597d273d8a9506e82c8766a4ec25652a91e39cb9964f1cf","085ac87295a8a057d0002240745a260c6b54931af3baf0183e73278e6ea59c38","0ee4aef0dfaa1493cfa72ff9e4d264824ef32ff30107e20ce5b706de90fa5a0a","e29bedc3041381337f118c527ab2e5cf9bd520e05a16da0b9608477847924112","c3a52081db1b07986e2ec1723a6b5c19fc9828ccf27273897d21be215d526af6","1cbb13250b1f0e87569e4b53e5e3d1e51c44