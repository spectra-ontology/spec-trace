{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                                           OPTIONAL,","paragraph_zero_based":1920},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1530-IEs                                           OPTIONAL","paragraph_zero_based":1921},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1923},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1530-IEs ::=            SEQUENCE {","paragraph_zero_based":1924},{"literal_text_all_w_t_and_m_t":"    masterCellGroup                         OCTET STRING (CONTAINING CellGroupConfig)                              OPTIONAL, -- Need M","paragraph_zero_based":1925},{"literal_text_all_w_t_and_m_t":"    fullConfig                              ENUMERATED {true}                                                      OPTIONAL, -- Cond FullConfig","paragraph_zero_based":1926},{"literal_text_all_w_t_and_m_t":"    dedicatedNAS-MessageList                SEQUENCE (SIZE(1..maxDRB)) OF DedicatedNAS-Message                     OPTIONAL, -- Cond nonHO","paragraph_zero_based":1927},{"literal_text_all_w_t_and_m_t":"    masterKeyUpdate                         MasterKeyUpdate                                                        OPTIONAL, -- Cond MasterKeyChange","paragraph_zero_based":1928},{"literal_text_all_w_t_and_m_t":"    dedicatedSIB1-Delivery                  OCTET STRING (CONTAINING SIB1)                                         OPTIONAL, -- Need N","paragraph_zero_based":1929},{"literal_text_all_w_t_and_m_t":"    dedicatedSystemInformationDelivery      OCTET STRING (CONTAINING SystemInformation)                            OPTIONAL, -- Need N","paragraph_zero_based":1930},{"literal_text_all_w_t_and_m_t":"    otherConfig                             OtherConfig                                                            OPTIONAL, -- Need M","paragraph_zero_based":1931},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1540-IEs                                           OPTIONAL","paragraph_zero_based":1932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1934},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1540-IEs ::=        SEQUENCE {","paragraph_zero_based":1935},{"literal_text_all_w_t_and_m_t":"    otherConfig-v1540                       OtherConfig-v1540                                                      OPTIONAL, -- Need M","paragraph_zero_based":1936},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCReconfiguration-v1560-IEs                                           OPTIONAL","paragraph_zero_based":1937},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1939},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-v1560-IEs ::=         SEQUENCE {","paragraph_zero_based":1940},{"literal_text_all_w_t_and_m_t":"    mrdc-SecondaryCellGroupConfig            SetupRelease { MRDC-SecondaryCellGroupConfig }                        OPTIONAL,   -- Need M","paragraph_zero_based":1941},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig2                       OCTET STRING (CONTAINING RadioBearerConfig)                           OPTIONAL,   -- Need M","paragraph_zero_based":1942},{"literal_text_all_w_t_and_m_t":"    sk-Counter                               SK-Counter                                                            OPTIONAL,   -- Need N","paragraph_zero_based":1943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coor