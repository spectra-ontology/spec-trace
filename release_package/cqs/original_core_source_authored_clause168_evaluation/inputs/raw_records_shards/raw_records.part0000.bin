{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31608},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC-v1730 ::=                  SEQUENCE {","paragraph_zero_based":31609},{"literal_text_all_w_t_and_m_t":"    ca-ParametersNR-ForDC-v1730                   CA-ParametersNR-v1730                        OPTIONAL","paragraph_zero_based":31610},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31612},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC-v1760 ::=                  SEQUENCE {","paragraph_zero_based":31613},{"literal_text_all_w_t_and_m_t":"    ca-ParametersNR-ForDC-v1760                  CA-ParametersNR-v1760","paragraph_zero_based":31614},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31615},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31616},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-PARAMETERS-NRDC-STOP","paragraph_zero_based":31617},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31619},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC field descriptions","paragraph_zero_based":31620},{"literal_text_all_w_t_and_m_t":"ca-ParametersNR-forDC (with and without suffix)","paragraph_zero_based":31621},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the UE capabilities when NR-DC is configured with the band combination. If a version of this field (i.e., with or without suffix) is absent for a band combination, the corresponding ca-ParametersNR field version in BandCombination is applicable to the UE configured with NR-DC for the band combination. If a version of this field (i.e., with or without suffix) is present for a band combination but does not contain any parameters, the UE does not support the corresponding field version when configured with NR-DC for the band combination.","paragraph_zero_based":31622},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDC","paragraph_zero_based":31623},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when NR-DC is configured. If this field is absent for a band combination, the featureSetCombination in BandCombination (without suffix) is applicable to the UE configured with NR-DC for the band combination.","paragraph_zero_based":31624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31625},{"literal_text_all_w_t_and_m_t":"–CarrierAggregationVariant","paragraph_zero_based":31626},{"literal_text_all_w_t_and_m_t":"The IE CarrierAggregationVariant informs the network about supported \"placement\" of the SpCell in an NR cell group.","paragraph_zero_based":31627},{"literal_text_all_w_t_and_m_t":"CarrierAggregationVariant information element","paragraph_zero_based":31628},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31629},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERAGGREGATIONVARIANT-START","paragraph_zero_based":31630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c894cec5326eb47c6e2678ad7074fcebb293b8b4baf00c694d969003184540a5","d7489079926dcc3beb62f4affb0cb2fad0e27651e631d72cf916a4ef2ae8762e","e9662839fdef1c7109289b921b1ada452365b759b77b2658cb06569b302e4b7b","3a9ce3627b49562e8b6a61e8bd9ac2939ca7af9669c67465deaecc899e9266ab","37d13c89c234302b66cab90c01e6ff01e0ea06124