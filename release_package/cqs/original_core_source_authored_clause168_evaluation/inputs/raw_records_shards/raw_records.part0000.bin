{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10800},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10801},{"literal_text_all_w_t_and_m_t":"RRCSetupRequest-IEs field descriptions","paragraph_zero_based":10802},{"literal_text_all_w_t_and_m_t":"establishmentCause","paragraph_zero_based":10803},{"literal_text_all_w_t_and_m_t":"Provides the establishment cause for the RRCSetupRequest in accordance with the information received from upper layers. gNB is not expected to reject an RRCSetupRequest due to unknown cause value being used by the UE.","paragraph_zero_based":10804},{"literal_text_all_w_t_and_m_t":"ue-Identity","paragraph_zero_based":10805},{"literal_text_all_w_t_and_m_t":"UE identity included to facilitate contention resolution by lower layers.","paragraph_zero_based":10806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10807},{"literal_text_all_w_t_and_m_t":"InitialUE-Identity field descriptions","paragraph_zero_based":10808},{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part1","paragraph_zero_based":10809},{"literal_text_all_w_t_and_m_t":"The rightmost 39 bits of 5G-S-TMSI.","paragraph_zero_based":10810},{"literal_text_all_w_t_and_m_t":"randomValue","paragraph_zero_based":10811},{"literal_text_all_w_t_and_m_t":"Integer value in the range 0 to 239 – 1.","paragraph_zero_based":10812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10813},{"literal_text_all_w_t_and_m_t":"–RRCSystemInfoRequest","paragraph_zero_based":10814},{"literal_text_all_w_t_and_m_t":"The RRCSystemInfoRequest message is used to request SI message(s) required by the UE as specified in clause 5.2.2.3.3 and 5.2.2.3.3a.","paragraph_zero_based":10815},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":10816},{"literal_text_all_w_t_and_m_t":