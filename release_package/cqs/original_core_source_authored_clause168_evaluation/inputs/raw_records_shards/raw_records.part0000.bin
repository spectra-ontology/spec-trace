{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":12240},{"literal_text_all_w_t_and_m_t":"connEstFailReportReq","paragraph_zero_based":12241},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the connection failure.","paragraph_zero_based":12242},{"literal_text_all_w_t_and_m_t":"flightPathInfoReq","paragraph_zero_based":12243},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE can report information about the flight path information, if available, and to specify the flight path information report configuration.","paragraph_zero_based":12244},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementReq","paragraph_zero_based":12245},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the idle/inactive measurement information, if available, to the network in the UEInformationResponse message.  ","paragraph_zero_based":12246},{"literal_text_all_w_t_and_m_t":"logMeasReportReq","paragraph_zero_based":12247},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about logged measurements.","paragraph_zero_based":12248},{"literal_text_all_w_t_and_m_t":"mobilityHistoryReportReq","paragraph_zero_based":12249},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about mobility history information.","paragraph_zero_based":12250},{"literal_text_all_w_t_and_m_t":"ra-ReportReq","paragraph_zero_based":12251},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the random access procedure.","paragraph_zero_based":12252},{"literal_text_all_w_t_and_m_t":"rlf-ReportReq","paragraph_zero_based":12253},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the radio link failure.","paragraph_zero_based":12254},{"literal_text_all_w_t_and_m_t":"successHO-ReportReq","paragraph_zero_based":12255},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the successful handover report.","paragraph_zero_based":12256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12257},{"literal_text_all_w_t_and_m_t":"FlightPathInfoReportConfig field descriptions","paragraph_zero_based":12258},{"literal_text_all_w_t_and_m_t":"maxWayPointNumber","paragraph_zero_based":12259},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of way points UE can include in the flight path information report if this information is available at the UE. ","paragraph_zero_based":12260},{"literal_text_all_w_t_and_m_t":"includeTimeStamp","paragraph_zero_based":12261},{"literal_text_all_w_t_and_m_t":"Indicates whether time stamp of each way point can be reported in the flight path information report if time stamp information is available at the UE.","paragraph_zero_based":12262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bdcf17ea18e01818870b3db7d3449a3792e4687123e82fea0499cb8f664063b8","22e632c5b261e4435225a61cc9ed4aff25dc7008164cf5c2b9b1c43ba3dc1b71","83afc5f096090bf42924b738ed9ae6eb84a87b22d64abe723ea8fca373f78b3b","e2c40905f493f9908f3b99ffc2dfbb61beee65b5b416ac141abe1cfd345d6b2d","cc9d7edb6866b81c19aceac3bbacb16cf66428b571a7ae910638954825a79be3","cf51491be7846d1e93253b2d7d252ace2b617