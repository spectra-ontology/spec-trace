{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SecurityConfig ::=                      SEQUENCE {","paragraph_zero_based":25320},{"literal_text_all_w_t_and_m_t":"    securityAlgorithmConfig                 SecurityAlgorithmConfig                                 OPTIONAL,   -- Cond RBTermChange1","paragraph_zero_based":25321},{"literal_text_all_w_t_and_m_t":"    keyToUse                                ENUMERATED{master, secondary}                           OPTIONAL,   -- Cond RBTermChange","paragraph_zero_based":25322},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25323},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25325},{"literal_text_all_w_t_and_m_t":"MRB-ToAddModList-r17 ::=                SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-ToAddMod-r17","paragraph_zero_based":25326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25327},{"literal_text_all_w_t_and_m_t":"MRB-ToAddMod-r17 ::=                    SEQUENCE {","paragraph_zero_based":25328},{"literal_text_all_w_t_and_m_t":"    mbs-SessionId-r17                       TMGI-r17                                                OPTIONAL,   -- Cond MRBSetup","paragraph_zero_based":25329},{"literal_text_all_w_t_and_m_t":"    mrb-Identity-r17                        MRB-Identity-r17,","paragraph_zero_based":25330},{"literal_text_all_w_t_and_m_t":"    mrb-IdentityNew-r17                     MRB-Identity-r17                                        OPTIONAL,   -- Need N","paragraph_zero_based":25331},{"literal_text_all_w_t_and_m_t":"    reestablishPDCP-r17                     ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":25332},{"literal_text_all_w_t_and_m_t":"    recoverPDCP-r17                         ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":25333},{"literal_text_all_w_t_and_m_t":"    pdcp-Config-r17                         PDCP-Config                                             OPTIONAL,   -- Cond PDCP","paragraph_zero_based":25334},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25335},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25337},{"literal_text_all_w_t_and_m_t":"MRB-ToReleaseList-r17 ::=               SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-Identity-r17","paragraph_zero_based":25338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25339},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOBEARERCONFIG-STOP","paragraph_zero_based":25340},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25342},{"literal_text_all_w_t_and_m_t":"DRB-ToAddMod and MRB-ToAddMod field descriptions","paragraph_zero_based":25343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8b85eeccc98f7833120632095f62926e3be0bce028adfd66bdba3b9899113a7c","c166722ba1049a36b0b04faeee574b1db48348118dd0137c96e0fb8bf3baaf0e","70d081560a9612ab725200deb7896f27d4a5710d458b8542606624efbe8370c0","90db36158119e3dd0ab5e3388a5fbc151e04cc628f8842c469a6189f856edd6c","ae2505830dc08f4951258d39732a2a6e303eb58bd3bcffeee6bb5c7ecde2a18f","3b441367e70b0b02033376991335eeb805f45eedd9424395390761754bacc902","651b99788de9118e4e482129ef2c51f572b9b5c1709bed9b5e45b6460e85148e","b2c1d161c12a07725bda11645f07007f3284070dd1e0f87434643e0aedd2886a","1121e2099f0ac3384fcdc25f09682621f652047baa5e44ca91211b1378bf8a3c","65080ef8aa6f6a3a638e5f3ff6c0744b39c851fe8fb9f44c4d049d653afc0422","fd97fafc5009a54adc454574b54bbaefe3ffe5fd59bc42c0bf9da38733acc0f6","8611a7e54c5a4b2229cfd9055c016ca29ceb70987d942648e235c256ca56c326","46cb6e8b570c742d836bfd52f1cbb566407ef47b3f0cb0eb36fb977ba8ceb71d","e7a19225aa29599d3e72bbaa2999446e9242e2cee752ca0b015abe44607d2d22","f1fc873ea25de4038cc8303f683f10172c686a0d583483f363643905e7725df8","36052b1d5e1ae064cbffa5db188d93ca1d97beaaa0c38390f931804245e1bb0f","6af8ac513e3d774415047e508211813be41f4070335d7817488c18c863ece695","cc9a5f1475ccbc74f92ad303368a4dbae29f9ec7ac7fce4d69fc5f7f973310f7","80f4f713d9c84a0c416e829eafa484c8ae090f3a4c5339fa2657026baf3390ce","883ae19a89a89e23c918f43f0a032190fd4332ff201a941de998469e555309c0","60e3f78b67cb87953c7a4e33b6a4b4c93c1d293864232115e0c575634323243c","8c20e5a66e7eef8641b254916a8a71a70ce6b0b835f800fbd963a6a592fda726","5c9099dbedbd9d1834dc3a411ec3a4cfcfe293fa2613c2c8fbda748b1e740d4a","22af8dc571665cfe7153d9000402d74eac05cf5154ffad8c30bf14064227dd2b"],"paragraph_range_zero_based":[25320,25343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25320"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cnAssociation","paragraph_zero_based":25344},{"literal_text_all_w_t_and_m_t":"Indicates if the bearer is associated with the eps-bearerIdentity (when connected to EPC) or sdap-Config (when connected to 5GC).","paragraph_zero_based":25345},{"literal_text_all_w_t_and_m_t":"daps-Config","paragraph_zero_based":25346},{"literal_text_all_w_t_and_m_t":"Indicates that the bearer is configured as DAPS bearer.","paragraph_zero_based":25347},{"literal_text_all_w_t_and_m_t":"drb-Identity","paragraph_zero_based":25348},{"literal_text_all_w_t_and_m_t":"In case of DC, the DRB identity is unique within the scope of the UE, i.e. an MCG DRB cannot use the same value as a split DRB. For a split DRB the same identity is used for the MCG and SCG parts of the configuration.","paragraph_zero_based":25349},{"literal_text_all_w_t_and_m_t":"eps-BearerIdentity","paragraph_zero_based":25350},{"literal_text_all_w_t_and_m_t":"The EPS bearer ID determines the EPS bearer.","paragraph_zero_based":25351},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":25352},{"literal_text_all_w_t_and_m_t":"Indicates which multicast MBS session the bearer is associated with.","paragraph_zero_based":25353},{"literal_text_all_w_t_and_m_t":"mrb-Identity","paragraph_zero_based":25354},{"literal_text_all_w_t_and_m_t":"Identification of the multicast MRB.","paragraph_zero_based":25355},{"literal_text_all_w_t_and_m_t":"mrb-IdentityNew","paragraph_zero_based":25356},{"literal_text_all_w_t_and_m_t":"New identity of the multicast MRB when mrb-Identity needs to be changed, e.g. as a result of a handover.","paragraph_zero_based":25357},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":25358},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to termination point change for the bearer, reconfiguration with sync, resuming an RRC connection, or the first reconfiguration after reestablishment. It is also applicable for LTE procedures when NR PDCP is configured. Network doesn't include this field for DRB if the bearer is configured as DAPS bearer.","paragraph_zero_based":25359},{"literal_text_all_w_t_and_m_t":"recoverPDCP","paragraph_zero_based":25360},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should perform recovery according to TS 38.323 [5]. Network doesn't include this field if the bearer is configured as DAPS bearer.","paragraph_zero_based":25361},{"literal_text_all_w_t_and_m_t":"sdap-Config","paragraph_zero_based":25362},{"literal_text_all_w_t_and_m_t":"The SDAP configuration determines how to map QoS flows to DRBs when NR or E-UTRA connects to the 5GC and presence/absence of UL/DL SDAP headers.","paragraph_zero_based":25363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25364},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig field descriptions","paragraph_zero_based":25365},{"literal_text_all_w_t_and_m_t":"securityConfig","paragraph_zero_based":25366},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm and key to use for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included after AS security has been activated, the UE shall continue to use the currently configured keyToUse and security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig. The field is not included when configuring SRB1 before AS security is activated.","paragraph_zero_based":25367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["219050cd48f3bb8da548469d79f9c35854dea0066028c96bbc9a382b56ccc336","c0cb28d415db92cbd101e6e73a740d7543f165dbeb723f3c6ae5ac08b573c3db","e9ad62eb6591384073cfde79006ee012f7b013b9fde6c41d90e855b615528fd3","79defd5be73c9ec15bb86bcfd8ccca144a017cf48a8941e8a26570468d30ab0c","f3abae50196c3df19524a5aa874ea8702a16f6463a8cac1956d91a66ae3aad49","4a0fd02bcfbb1f930453722ee8f5e07ecca98a135e92332ff3631d36cbb43e4c","013180fa283ab5710a41da408f90d43e207d85e6f6ef13c2256676a1cee68b08","84d5596c0165c9820c4415ff1fe8226f52091211e7d2a2425e2b92e933489be2","fa1006d3ce2bde3d8d2dee65c4eacff28f60533c78fb02f70acc2a9ced1193b9","80f2ab76013c62f5f4362f34b25b3df71d349a6ce60f0306cb5ed85195159baa","00bb12a16501e70c8e881d6b434ddc4c0caeba27b4eaec9954c85881547d22d7","849e1a547e8e1c26c3bd2f8e6d93bdfd9f3fc420ce1b3774bf3410fea2fcb3f1","01ea0a92b991908eaf420ee4df87966015ccb42c14904b795d95410186082af7","551896eef7351227f2f1e9f9939fad194427626cf1cc8a60b9d84275adbd1f2c","a3b6361f9dd6e6ea3e875a12b9d6ca113c0d7fd420060a41abe570cd81fcbffb","3004543d6d7b9aefedb8d00fb41461487beee729c8f8474f7b5de55382808e10","1ead847dbb2dd186f2583b97dccbb01dfce7848a480c8a2857821e0782d20bc3","2d176758d319cf0a4f743ff8fa8f79a878025e6f8c1db73abbeb17804502ddbb","93aa9b7479a4c2d6a1389653ccb5d7f9abb1bbec071ff155bffb1c19edd1d504","3239f265cafbd2481a8a427c0678aa032a6b15cbfe5b7024f56053a6c9c7996d","a4b3f7f3c95759ab07783d0889de83f67fcb1ad46335a82bd4c362bbb4cffe6b","267683c177b8f269c3e2c914a791bf64d572e90ec2d9284b4f0c1e4b54903c56","d08994bd6f1b1c26fee636da46d273bc4b9ea326044b9836a24ff91379135b89","86a36983e448c049c577b691220c7a68587d2ed2ce1fcf33f7aec5082bd293de"],"paragraph_range_zero_based":[25344,25367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25344"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"srb3-ToRelease","paragraph_zero_based":25368},{"literal_text_all_w_t_and_m_t":"Release SRB3. SRB3 release can only be done over SRB1 and only at SCG release and reconfiguration with sync.","paragraph_zero_based":25369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25370},{"literal_text_all_w_t_and_m_t":"SecurityConfig field descriptions","paragraph_zero_based":25371},{"literal_text_all_w_t_and_m_t":"keyToUse","paragraph_zero_based":25372},{"literal_text_all_w_t_and_m_t":"Indicates if the bearers configured with the list in this IE RadioBearerConfig are using the master key or the secondary key for deriving ciphering and/or integrity protection keys. For MR-DC, network should not configure SRB1 and SRB2 with secondary key and SRB3 with the master key. When the field is not included, the UE shall continue to use the currently configured keyToUse for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":25373},{"literal_text_all_w_t_and_m_t":"securityAlgorithmConfig","paragraph_zero_based":25374},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included, the UE shall continue to use the currently configured security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":25375},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25376},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod field descriptions","paragraph_zero_based":25377},{"literal_text_all_w_t_and_m_t":"discardOnPDCP","paragraph_zero_based":25378},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should discard stored SDU and PDU according to TS 38.323 [5].","paragraph_zero_based":25379},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":25380},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to reconfiguration with sync, for SRB2 when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR, the network does not set this field to true. For LTE SRBs using NR PDCP, it could be for handover, RRC connection reestablishment or resume. Network doesn't include this field if any DAPS bearer is configured.","paragraph_zero_based":25381},{"literal_text_all_w_t_and_m_t":"srb-Identity, srb-Identity-v1700","paragraph_zero_based":25382},{"literal_text_all_w_t_and_m_t":"Value 1 is applicable for SRB1 only. Value 2 is applicable for SRB2 only. Value 3 is applicable for SRB3 only. Value 4 is applicable for SRB4 only. If srb-Identity-v1700 is received for an SRB, the UE shall ignore srb-Identity (i.e. without suffix) for this SRB.","paragraph_zero_based":25383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25384},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25385},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25386},{"literal_text_all_w_t_and_m_t":"RBTermChange","paragraph_zero_based":25387},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":25388},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":25389},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN.","paragraph_zero_based":25390},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":25391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a4db87c58de61187119c815fcb6d35dddd2115138981b478f6266e42de9ca491","512d45b59208d0e77e531ca81a1f994509dff6a8d236f1e50063917a1d3a58e6","a22f28dbfa4fb6fa22d6f936136167f1d1439fd488c4e4a348aa5cc60c355376","8cac71fd0441799d397d14d4039d982f5da65d2e8c788141895657b386676bf5","494fa3cddfad480018e986e1ef80de4126e69c88dbbcb13f281025f4c3e561c4","72b9c29ca6f49866e74937cd94c1e17dee531b47960edd4cd197b57e94231819","128f4d779689fd0c7f9013535e772984994aae8a7231215e568b6007a01ef916","d857e1ef65592cde6cecd1ec9741e9f9ea416e0ae59590b054b5c50dff63d159","a9563cf0a2ead1317ac8df02433f4f79b99ee29e17b1407cfe6bd0180405c0ae","5153584daa93474acf8b0fcd48f8737f58b053299a7d3f5b38ab305a9a42f042","f03d84d05207353f63bfef52457ac04a00d4302aba4c7e5776ae6d5c99dfa234","c5939076fab95433e503ab889c0dc19878f0af3b9486c15ad9868eade0feea98","c561a81a9999f6d1ef993c03b6a1e2acbd48cfa770fdfb30adc275bc76b6e6b3","b18f48124242c31f10de01aeaabb53811a81c011a9144cacf84a665a4a0127c2","3547b41863e876e1990c3e83a2972191afb48e2ba6d7f179bb05722b514f7a4d","1b5a52663eda7ba03c7a1c9ae343928ca60863a3af7cb7cd171cf771f82a50b7","0fbb7cd55f5c985894e18c6c79fe174339132585f3dfdc5399c9d93144c078d7","9035d4156de1e4fe3d411a5bb8fdc2fa7cf8cdd7a30288f8084bdaea5e21b5c3","7219d65cdaa6f509832d0c67750ba9fb283256dc713c4a6c5f6c0744ec1dc1ce","bb33c82997eccb9d0ed7336204c6d77ebcb8b9dcc76131835f7f714792bd3049","a611d876c9c5d26149a40e262712c2d8ace46e1ee5c70be822dfae68c594d774","bd46610496fd787c0cb195a8b9358afc746c737f8780924b9a4c0f2d4fdc4d9d","0b7ca8c0f5d16a1a5c3f2ca014eac139679e678a529b68f065e4e1d6312a7057","c7a88bda9660ce562d6e7eb482a0865c6037e27b3af106430eda78fcb5bcfe1c"],"paragraph_range_zero_based":[25368,25391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25368"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RBTermChange1","paragraph_zero_based":25392},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":25393},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":25394},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN,","paragraph_zero_based":25395},{"literal_text_all_w_t_and_m_t":"-handover from E-UTRA/EPC or E-UTRA/5GC to NR,","paragraph_zero_based":25396},{"literal_text_all_w_t_and_m_t":"-handover from NR or E-UTRA/EPC to E-UTRA/5GC if the UE supports NGEN-DC.","paragraph_zero_based":25397},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":25398},{"literal_text_all_w_t_and_m_t":"PDCP","paragraph_zero_based":25399},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB/multicast MRB is being setup or corresponding DRB/multicast MRB is reconfigured with NR PDCP or corresponding SRB associated with two RLC entities is being setup or if the number of RLC bearers associated with the DRB/multicast MRB or SRB is changed. The field is optionally present, Need S, if the corresponding SRB associated with one RLC entity is being setup or corresponding SRB is reconfigured with NR PDCP; otherwise the field is optionally present, need M.","paragraph_zero_based":25400},{"literal_text_all_w_t_and_m_t":"DRBSetup","paragraph_zero_based":25401},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":25402},{"literal_text_all_w_t_and_m_t":"HO-Conn","paragraph_zero_based":25403},{"literal_text_all_w_t_and_m_t":"The field is mandatory present","paragraph_zero_based":25404},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":25405},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured,","paragraph_zero_based":25406},{"literal_text_all_w_t_and_m_t":"-or in case of RRCSetup.","paragraph_zero_based":25407},{"literal_text_all_w_t_and_m_t":"Otherwise the field is optionally present, need N.","paragraph_zero_based":25408},{"literal_text_all_w_t_and_m_t":"Upon RRCSetup, only SRB1 can be present.","paragraph_zero_based":25409},{"literal_text_all_w_t_and_m_t":"HO-toNR","paragraph_zero_based":25410},{"literal_text_all_w_t_and_m_t":"If mrb-ToAddModList is not included, the field is mandatory present","paragraph_zero_based":25411},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":25412},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured.","paragraph_zero_based":25413},{"literal_text_all_w_t_and_m_t":"In case of RRCSetup, the field is absent; otherwise the field is optionally present, need N.","paragraph_zero_based":25414},{"literal_text_all_w_t_and_m_t":"DAPS","paragraph_zero_based":25415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7f01c2746992f5695acfcc816a7d5511e151cc38d8af99861f149152b4f4ad9c","3b5af490c21fb303d2f30ed59d05d57e7a14eec29c435823a60b0387843483f7","e37dd536f934707d39f94ca41b95f3eb003acd20a07eb01a00c781a4477e12a4","9cea2d39834c89bb0d2857ca877e75e5c2ec0bb4206e4b0bb6af393b17b9f65c","eeaef5dc4e79fc5ea2b99b862b8473423e9fd35d24ae7de5160adae12479ecd3","b979b3963f571fc50276f1d563e31dba379730e16774dc97b430c96f4efeb9eb","7fa3dc933584397983492b31836e2ffaf008d8e2285a782be7a35ef1f5a4ad6c","39eff0f1d8f358d07f7cfd543f002031c1b9202988a47805ba48763ebf9e292d","7720727850b12c8dd15d35526d157b2e00c9599aad498764edf7836dde7e9a7a","817d3a5117401c3813164bd516fd71a1a65b9d2a31578dc9064cc415505634c5","f1eb923d2dbf84550ce3ddf702cf47e5498a35e3e7820074b7c60ca5bd83a865","b18ab1c9c306b39f39f71e90babc390258ce00b46e988a04fff211afdb04c794","51b12e30b424bcd5797871d388d97a14c1ba228cb2aca05359e71c21eda49781","6a2dc40c9478805634f1e6a2bb3de4eb23dd9110861e64dce4d68e448800a320","6d55e1b847c511eb1b5b84921c94086e2d453fe13e69fd16f26551b3cd749908","e9688690e23e234f1b7c92b1c86a6643d51ff78ebe1f2b0615f78bdb0ac06fc4","08a194826cf9a62684338a725b55cb8e56e7cf35c1bf461c8466b9c041d0b2a5","67dc8d15c0ff78370820e272634411d8676b80424c5dfac47bac1fafaad7cd90","66eb54545c8ac818f348029b8b361f3feb41686f73638d09dcc681a8539fa39f","0a8e34eac038c14ad6694bbb60874e88c086e8847796d66bc1d128a54cf98da9","391388abce06d3394e2fcb1288ae072a5211878d53ecc6137281953787b358e2","074df1b5d1a4b3479f54573c65d520b084bbb27f708be3664fbd6d77efeec4f9","971189b5ae3a29fcd337fe50408f2c57a476ceb7305bcea53d6151b087749f01","06f2e8485f4965e5a7ad0363069f8d227d672a942f52b80f105b12e80b4855e9"],"paragraph_range_zero_based":[25392,25415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25392"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, need N, in case masterCellGroup includes ReconfigurationWithSync, SCell(s) and SCG are  not configured, multi-DCI/single-DCI based multi-TRP are not configured in any DL BWP, supplementaryUplink is not configured, ethernetHeaderCompression is not configured for the DRB, conditionalReconfiguration is not configured, and NR sidelink and V2X sidelink are not configured. Otherwise the field is absent.","paragraph_zero_based":25416},{"literal_text_all_w_t_and_m_t":"MRBSetup","paragraph_zero_based":25417},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding multicast MRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":25418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25419},{"literal_text_all_w_t_and_m_t":"–RadioLinkMonitoringConfig","paragraph_zero_based":25420},{"literal_text_all_w_t_and_m_t":"The IE RadioLinkMonitoringConfig is used to configure radio link monitoring for detection of beam- and/or cell radio link failure. See also TS 38.321 [3], clause 5.1.1.","paragraph_zero_based":25421},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig information element","paragraph_zero_based":25422},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25423},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOLINKMONITORINGCONFIG-START","paragraph_zero_based":25424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25425},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig ::=       SEQUENCE {","paragraph_zero_based":25426},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToAddModList   SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS","paragraph_zero_based":25427},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25428},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToReleaseList  SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS-Id","paragraph_zero_based":25429},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25430},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount             ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                          OPTIONAL, -- Need R","paragraph_zero_based":25431},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer               ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}  OPTIONAL, -- Need R","paragraph_zero_based":25432},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":25433},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25434},{"literal_text_all_w_t_and_m_t":"    beamFailure-r17                         BeamFailureDetection-r17                                              OPTIONAL  -- Need R","paragraph_zero_based":25435},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25436},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25438},{"literal_text_all_w_t_and_m_t":"BeamFailureDetection-r17 ::=        SEQUENCE {","paragraph_zero_based":25439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["501f1d799562b4916323d9dd