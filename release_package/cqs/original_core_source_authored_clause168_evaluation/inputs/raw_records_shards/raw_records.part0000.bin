{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30241},{"literal_text_all_w_t_and_m_t":"Uplink-powerControlId-r17 ::= INTEGER(1.. maxUL-TCI-r17)","paragraph_zero_based":30242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30243},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINK-POWERCONTROL-STOP","paragraph_zero_based":30244},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30246},{"literal_text_all_w_t_and_m_t":"Uplink-PowerControl field descriptions","paragraph_zero_based":30247},{"literal_text_all_w_t_and_m_t":"p0AlphaSetforPUSCH, p0AlphaSetforPUCCH, p0AlphaSetforSRS","paragraph_zero_based":30248},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUSCH, PUCCH and SRS (see TS 38.213 [13], clause 7.2). When the field alpha is absent in p0AlphaSetforPUSCH, the UE applies the value 1 for PUSCH power control. When the field alpha is absent in p0AlphaSetforSRS, the UE applies the value 1 for SRS power control. In p0AlphaSetForPUCCH, the field alpha is absent (not used).","paragraph_zero_based":30249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30250},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelConfig","paragraph_zero_based":30251},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelConfig is used to configure an RLC entity, a corresponding logical channel in MAC for Uu Relay RLC channel between L2 U2N Relay UE and network.","paragraph_zero_based":30252},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig information element","paragraph_zero_based":30253},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30254},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELCONFIG-START","paragraph_zero_based":30255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30256},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig-r17::= SEQUENCE {","paragraph_zero_based":30257},{"literal_text_all_w_t_and_m_t":"    uu-LogicalChannelIdentity-r17    LogicalChannelIdentity                    OPTIONAL,   -- Cond RelayLCH-SetupOnly","paragraph_zero_based":30258},{"literal_text_all_w_t_and_m_t":"    uu-RelayRLC-ChannelID-r17        Uu-RelayRLC-ChannelID-r17,","paragraph_zero_based":30259},{"literal_text_all_w_t_and_m_t":"    reestablishRLC-r17               ENUMERATED {true}                         OPTIONAL,   -- Need N","paragraph_zero_based":30260},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r17                   RLC-Config                                OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":30261},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig-r17     LogicalChannelConfig                      OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":30262},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d7f8b2a2bfda1460cf7aef2161e88047bbb71bd04bbfd88912ae0ec781022ee6","b4f0e641f0a296986b26fab75a55731f57a720cc484be8721d00a6a0e27a4598","b332bbfdb56884db992a0a7dc3c10562057993d22002c977ecaf81370f705245","c4f6d2a0deab17fd3a01c7c21432aefaf5b5765b9d1d2b26165a4705325f3945","5cfe9f65ade8e387912ce4acb9ea3706ab2cf5b53d2dc5b0a3e00c1aad8dc8d9","3334b7d40e98bdcb60bbef6d01dc0059df980ce0b12b7c64b44aab9c007bb50b","a6ba4824ce751ec8d0d3797706e3bd40d8c09eb70e4417016014f14b3c5fca37","d61bb1adbf57adb420b51bbd55aa9cd0050fd493