{"fields":{"filename":"R2-2301019.zip::R2-2301019.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-RB-Identity-r17 ::=         CHOICE {","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"    srb-Identity-r17                        INTEGER (0..3),","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"    drb-Identity-r17                        DRB-Identity,","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-STOP","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config field descriptions","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"sl-LocalIdentity","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the L2 U2N Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"sl-MappingToAddModList","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"Indicates the list of mapping between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66].","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"sl-MappingToReleaseList","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be released.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-RB-Identity","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"Identity of the end-to-end Uu bearer identity of the L2 U2N Remote UE. The value 3 for the field srb-identity-r17 (i.e., for configuring SRB3) is not supported in this version of the specification.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelUu","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on Uu Hop for uplink transmissions at the L2 U2N Relay UE.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on PC5 Hop for downlink transmissions at the L2 U2N Relay UE and for uplink transmissions at the L2 U2N Remote UE.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"890a1a41550c92f4f4d4fd733244e9f2ca4b99b896082f68e57b39a62f8df172","original_member_sha256":"4d9f158efad51e5969f6795f719418e62c14198c6b9e5aa8f29cc107e6120491","paragraph_ElementTree_utf8_XML_sha256":["df9d35d314c030951e4f01eb336d507588a2582deb3499f5a737e1863e31c5ff","a2bddb504fc986b26fa806043d60348e41a021c459976279a1aac16e3ad9b08c","1850f6fcb0d76a5bf21844ba8174fab24111c5c31882301d1b64217889f9934a","ae2bd5408b25a7aa3c0ea5e9ab04da48aff83544737ea58ed506ebffd58933f3","e7fe5cc7eff46210eccf49cb4598cd9dbff442c4773eec7b54d198468f58c3cf","ec50f7023a2e175dcb04f0b5bee556696bbad08c5b84e590782e1bbb1d1508e6","0255c8e4be74649e35d023fff7f3a7f7c841e09506b079d48b771ffcf82513f8","b893f1cdd10f82c0069d452336db9dd948fb05ce41e23dcd7918e6f138670044","e258f65ae0df39eb97b1502c0a31dcfd6175a890e9d68fef2bcbce245b09af92","fc9b63abd98ddf2121f66e2e9ae7c4ee622c1db116015ad4abd4d4eb109e08b5","e3a641092bc7b3a0b5869a8c33377abf6763bc38f9eff3e885fa2b5dba06b94b","33775b81184b1d6a67f01db55c6caaf806ec790f838ddc72b4035