30.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p13824"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB10 information element","paragraph_zero_based":13848},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13849},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-START","paragraph_zero_based":13850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13851},{"literal_text_all_w_t_and_m_t":"SIB10-r16 ::=               SEQUENCE {","paragraph_zero_based":13852},{"literal_text_all_w_t_and_m_t":"    hrnn-List-r16               HRNN-List-r16                                   OPTIONAL,   -- Need R","paragraph_zero_based":13853},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                    OPTIONAL,","paragraph_zero_based":13854},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13855},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13857},{"literal_text_all_w_t_and_m_t":"HRNN-List-r16 ::=           SEQUENCE (SIZE (1..maxNPN-r16)) OF HRNN-r16","paragraph_zero_based":13858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13859},{"literal_text_all_w_t_and_m_t":"HRNN-r16 ::=                SEQUENCE {","paragraph_zero_based":13860},{"literal_text_all_w_t_and_m_t":"    hrnn-r16                    OCTET STRING (SIZE(1.. maxHRNN-Len-r16))        OPTIONAL   -- Need R","paragraph_zero_based":13861},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13863},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-STOP","paragraph_zero_based":13864},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13866},{"literal_text_all_w_t_and_m_t":"SIB10 field descriptions","paragraph_zero_based":13867},{"literal_text_all_w_t_and_m_t":"HRNN-List","paragraph_zero_based":13868},{"literal_text_all_w_t_and_m_t":"The same amount of HRNN (see TS 23.003 [21]) elements as the number of NPNs in SIB 1 are included. The n-th entry of HRNN-List contains the human readable network name of the n-th NPN of SIB1. The hrnn in the corresponding entry in HRNN-List is absent if there is no HRNN associated with the given NPN.","paragraph_zero_based":13869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13870},{"literal_text_all_w_t_and_m_t":"–SIB11","paragraph_zero_based":13871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c43dc797607244ac4a0abcb8fe477cb25961b9fe77e39658cae541477db7df06","6905a2acb62c61b9008e385c6bc953689f8293e93fae458e54cfff2b45a1bb95","0f0c2e91500751733575b90f182a3423ec4f077ffdfeb129e43e1ae59e5eacae","73aadf9cbb22007fa3a141eb09e478286afe1ce2141f78682edfd11da4ec1eca","bea014ddc9b8a448a323b3de53d59881fbf21dc6a2820f7abdc74f3467041355","5df554d9abd5fb3402eb451466343efea4fb808af07c7034c0930469c06b3bca","fa4631f9f696883a540816aae72dba426f8d735c22e5f197386bb3c53be7ed7d","f94a9995252c8233d07f2886fb201d2ab66bd2f919e3eb329eb615669438f72d","fa6d45d4612f936d0a4a9fc4e2e936b5d0c3ec0ac81d773064b78603a11d5577","befa285d9b3e126c366643e41da67210c997e368a8865122d207215d20a6cd21","03bd99e8c90f2b92e50f584f264c52ae76e1231162a660255e615462e29bf1fe","6969246d343b8d9d66297e38e93e19f42753fd09fa68dce84fb515c56ff03291","7d2c84d876dec82e6857b76110ad4d075fa16e622a372d3e8fdd624545addd0a","d2fab08e2c3d4ee532f66eead815cfa0cb173ebc7d5d8b03bf85aeeff51fe642","01e19f035425f3a9f96ff7ba99d5114293cafac3ad4a429f799053742354e239","b39c72d3a8d4c4b0a9193ee81a0b26bd61