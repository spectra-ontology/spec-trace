{"fields":{"filename":"R2-2311970.zip::R2-2311970 Introduction of Rel-18 Multi-path.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–N3C-IndirectPathConfigRelay","paragraph_zero_based":2688},{"literal_text_all_w_t_and_m_t":"The IE N3C-IndirectPathConfigRelay indicates the N3C indirect path related configuration used by N3C relay UE.","paragraph_zero_based":2689},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay information element","paragraph_zero_based":2690},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2691},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHCONFIGRELAY-START","paragraph_zero_based":2692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2693},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay-r18 ::=           SEQUENCE {","paragraph_zero_based":2694},{"literal_text_all_w_t_and_m_t":"    n3c-MappingToReleaseList-r18                SEQUENCE (SIZE (1..maxLC-ID)) OF SL-RemoteUE-RB-Identity-r17     OPTIONAL, -- Need N","paragraph_zero_based":2695},{"literal_text_all_w_t_and_m_t":"    n3c-MappingToAddModList-r18                 SEQUENCE (SIZE (1..maxLC-ID)) OF N3C-MappingToAddMod-r17         OPTIONAL, -- Need N","paragraph_zero_based":2696},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":2697},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2699},{"literal_text_all_w_t_and_m_t":"n3c-MappingToAddMod-r18 ::=            SEQUENCE {","paragraph_zero_based":2700},{"literal_text_all_w_t_and_m_t":"    n3c-RemoteUE-RB-Identity-r18          SL-RemoteUE-RB-Identity-r17,","paragraph_zero_based":2701},{"literal_text_all_w_t_and_m_t":"    n3c-RLC-ChannelUu-r18                 Uu-RelayRLC-ChannelID-r17                                              OPTIONAL, -- Need M","paragraph_zero_based":2702},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":2703},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2705},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHCONFIGRELAY-STOP","paragraph_zero_based":2706},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2708},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay field descriptions","paragraph_zero_based":2709},{"literal_text_all_w_t_and_m_t":"n3c-MappingToAddModList","paragraph_zero_based":2710},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the N3C remote UE and the Uu RLC channel to be added or modified. The Uu RLC channel is associated to only one N3C remote UE’s end-to-end bearer.","paragraph_zero_based":2711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["9a964e8275cf696f26ea3bc46a18478a97b446a94bf9955c10a952b1afdf2e7a","0055860e4fff1608a71137778d00245d4d70b339bb95bf848282537995cfa3bc","f5f14171677a3bfdc8e712a1389e7e65685232bf7178687981a98149479d88f8","98c574fcbca9a24b6bdf508af7d0335c09fa789db10a423e2217e327469e056b","0182f6ccc18d06320b71b972ee484cbe55997858a87783f59d883c1406080bff","4749443a8ceb025bef1e5bf7f2dff3fc52103d56e8cb390ff789db8b2e774b1f","1e3ba9c715a41cb50e59e29562673b7007e1ba30fabd27630e82f6ae9cd404fa","dfdc81d96a2d2a285a524c2cc21fc490850bac6ba81c946c4b50c1e585937d0d","349a54f4f27a44061c94b31eaff15ee02c2af6e8523d0927d6534686853bfc46","64cdacb82ceb4bc55d28341b022675d45da42350e1986b59d3706cc2cdf4dea3","fed6ae1b418cd4a6770a49d11ec983aff79b803fb065c329657fbbfe1f006641","6b215b7fc2affcd833c5ca03054c5162fbbaeb9864