{"fields":{"filename":"R2-2312518.zip::R2-2312518 - 38321_CR1706_Rel-18_Introduction of Cross-RRH TCI state switch indication for high speed train.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-TCI State Indication for UE-specific PDCCH MAC CE;","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"-SP CSI reporting on PUCCH Activation/Deactivation MAC CE;","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"-SP SRS Activation/Deactivation MAC CE;","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"-PUCCH spatial relation Activation/Deactivation MAC CE;","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"-Enhanced PUCCH spatial relation Activation/Deactivation MAC CE;","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"-SP ZP CSI-RS Resource Set Activation/Deactivation MAC CE;","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"-Recommended Bit Rate MAC CE;","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"-Enhanced SP/AP SRS Spatial Relation Indication MAC CE;","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-SRS Pathloss Reference RS Update MAC CE;","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-PUSCH Pathloss Reference RS Update MAC CE;","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"-Serving Cell set based SRS Spatial Relation Indication MAC CE;","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"-SP Positioning SRS Activation/Deactivation MAC CE;","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"-Timing Delta MAC CE;","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"-Guard Symbols MAC CEs;","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"-Positioning Measurement Gap Activation/Deactivation Command MAC CE;","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"-PPW Activation/Deactivation Command MAC CE;","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"-PUCCH spatial relation Activation/Deactivation for multiple TRP PUCCH repetition MAC CE;","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"-PUCCH Power Control Set Update for multiple TRP PUCCH repetition MAC CE;","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"-Unified TCI States Activation/Deactivation for UE-specific PDSCH MAC CE;","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"-Differential Koffset MAC CE;","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-Case-7 Timing advance offset MAC CE;","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-DL TX Power Adjustment MAC CE;","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"-Child IAB-DU Restricted Beam Indication MAC CE;","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"-Timing Case Indication MAC CE.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ecc7295152ab004fee6c5fe5b51922f6b04fc31c69bc0c2a87740df08932928","original_member_sha256":"5ac2a6eb195866185c7c6c25a8e6bde44e85ab5aebfb9dafb46d77b16a9bd085","paragraph_ElementTree_utf8_XML_sha256":["fe63632b0784c101af0bc7ffd4729cacbe9ad48fa4d692901790ca4d679498fd","5bc55e2afa1615a323fdf1215200e8da99b38fdbd25f57d4f4f0d889e2014e23","40980b5880901de4dd4e628630feb285d66ae7ef3b770881c18b54d7f0e55fc3","31080271fcc58b8ec66cacfa47409b83dfb32f609c5914160902f25e54b21a9a","d40a8731eba011111cf6e3ac090121c64d1701fa1dee36f3db3d77136f92286d","1364f43678c37932dc9dc3a5a4f3cb68e906f9b421bf6fb4698423d38cf4b13d","6c9e8626bd1fdbf05029b454e3635ebd7fa4313dd3ad9ac96d5a44c928e8bd69","68401d97a561ab62d82d44f8de600d1b53f2fbb8f87430a4e4846834b67fe0e4","b5f50416d990f1ef026c813e3cb1ee11a15ccbbac497c17436a3c0c3e9338589","63d8b895d64f721757cb514e79b498f4b235690036c08ae993c8a7b164bfc126","5c18608f93492e9b3ddee1002da55c2e194438ac846561ba584fc150188051bf","4128558e44502d89fb577b4efed0a4b41b1dba28cd15522316a8592a06a911ba","f639baca00a4cf47702cd2562fa220d501ac80444581daa0e6d06cfbaf2a5d11","b4cc9fcd34faa79e5f066abd1d3a38c04957be1afb4145b78aab8d5ad6a0e80b","3ef18bd42ca5e639027536fc49cd44282e63c47adc084019c191f21515750797","f0119d9ec36b1af8bef16f7656fd4194884ddd07095ec08de2dade4995895545","10f9115961599c601041b60176c93784c0499ecfda7a6c1d12ae57255f92e73c","6bd748649f2da98b1d44708456e9ad269f2b972b22322317a6fd127937b9bf8e","080175adc88c70488cdbf1eafd036e96b83d9ed489e529d04c86105ad46df50c","fb15a2d039a54640f37fe8a3c9b05203456e971fc768c304d807cb8ebf942595","1bc15fe234e6b1fa57c14eed4faa87d7aec6600ec4ebaf2f421bd76157fcb9e9","9cb543db19274eec84305661a595b2ef69204931887d05ea5d3464a67fb118f5","0d7ecd3fcaeb5b2f10ad574785113d4e9829e320907b1aaf5ec73ee4854cb874","02bed2ca32b7d67e6aefc65388f81775c906bd373e5512ac83a8d28bf71cdbfb"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312518.zip::R2-2312518 - 38321_CR1706_Rel-18_Introduction of Cross-RRH TCI state switch indication for high speed train.docx:p216"}
{"fields":{"filename":"R2-2312518.zip::R2-2312518 - 38321_CR1706_Rel-18_Introduction of Cross-RRH TCI state switch indication for high speed train.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Cross-RRH TCI State Indication for UE-specific PDCCH MAC CE.","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"<<<<Skipped>>>>","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"5.18.5Indication of TCI state for UE-specific PDCCH","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"The network may indicate a TCI state for PDCCH reception for a CORESET of a Serving Cell or a set of Serving Cells configured in simultaneousTCI-UpdateList1 or simultaneousTCI-UpdateList2 by sending the TCI State Indication for UE-specific PDCCH MAC CE or the cross-RRH TCI State Indication for UE-specific PDCCH MAC CE described in clause 6.1.3.15. The network may also indicate two TCI states for PDCCH reception for a CORESET of a Serving Cell or a set of Serving Cells configured in simultaneousTCI-UpdateList1 or simultaneousTCI-UpdateList2 by sending the Enhanced TCI States Indication for UE-specific PDCCH MAC CE described in clause 6.1.3.44.","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"The MAC entity shall:","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity receives a TCI State Indication for UE-specific PDCCH MAC CE on a Serving Cell:","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers the information regarding the TCI State Indication for UE-specific PDCCH MAC CE.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity receives an Enhanced TCI States Indication for UE-specific PDCCH MAC CE on a Serving Cell:","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers the information regarding the Enhanced TCI States Indication for UE-specific PDCCH MAC CE.","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"1>if the MAC entity receives a cross-RRH TCI State Indication for UE-specific PDCCH MAC CE on a Serving Cell:","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers the information regarding the cross-RRH TCI State Indication for UE-specific PDCCH MAC CE.","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"6Protocol Data Units, formats and parameters","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"<<<<Skipped>>>>","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"6.1.3.15TCI State Indication for UE-specific PDCCH MAC CE/Cross-RRH TCI State Indication for UE-specific PDCCH MAC CE ","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"Compared to the TCI State Indication for UE-specific PDCCH MAC CE, the cross-RRH TCI State Indication for UE-specific PDCCH MAC CE also indicates there is a large timing difference between DL signals from two RRHs and lower layers shall apply the one shot large timing adjustment specified in Clause 7.1.2.3 in TS 38.133 [11] on the first UL transmission after TCI state switch without checking the DL timing difference threshold.","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"The TCI State Indication for UE-specific PDCCH MAC CE is identified by a MAC subheader with LCID as specified in Table 6.2.1-1. The Cross-RRH TCI State Indication for UE-specific PDCCH MAC CE is identified by a MAC subheader with eLCID as specified in Table 6.2.1-1b. They have a fixed size of 16 bits with following fields:","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"-Serving Cell ID: This field indicates the identity of the Serving Cell for which the MAC CE applies. The length of the field is 5 bits. If the indicated Serving Cell is configured as part of a simultaneousTCI-UpdateList1 or simultaneousTCI-UpdateList2 as specified in TS 38.331 [5], this MAC CE applies to all theServing Cells in the set simultaneousTCI-UpdateList1 or simultaneousTCI-UpdateList2, respectively;","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"-CORESET ID: This field indicates a Control Resource Set identified with ControlResourceSetId as specified in TS 38.331 [5], for which the TCI State is being indicated. In case the value of the field is 0, the field refers to the Control Resource Set configured by controlResourceSetZero as specified in TS 38.331 [5]. The length of the field is 4 bits;","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"-TCI State ID: This field indicates the TCI state identified by TCI-StateId as specified in TS 38.331 [5] applicable to the Control Resource Set identified by CORESET ID field. If the field of CORESET ID is set to 0, this field indicates a TCI-StateId for a TCI state of the first 64 TCI-states configured by tci-StatesToAddModList and tci-StatesToReleaseList in the PDSCH-Config in the active BWP or by dl-OrJoint-TCI-State-ToAddModList and dl-OrJoint-TCI-State-ToReleaseList in the PDSCH-Config in the active BWP or the reference BWP. If the field of CORESET ID is set to the other value than 0, this field indicates a TCI-StateId configured by tci-StatesPDCCH-ToAddList and tci-StatesPDCCH-ToReleaseList in the controlResourceSet identified by the indicated CORESET ID. The length of the field is 7 bits.","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"Figure 6.1.3.15-1: TCI State Indication for UE-specific PDCCH MAC CE/Cross-RRH TCI State Indication for UE-specific PDCCH MAC CE","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ecc7295152ab004fee6c5fe5b51922f6b04fc31c69bc0c2a87740df08932928","original_member_sha256":"5ac2a6eb195866185c7c6c25a8e6bde44e85ab5aebfb9dafb46d77b16a9bd085","paragraph_ElementTree_utf8_XML_sha256":["19103f9d81182bbbc8438d0a985eeb3264db7ae5edcca14c6cb63473e36da43c","2bfc90d2d4ff7be10bf4ee0b0f769823ad0f75ef738bc59a5a6e56b78fbaa4e1","02584578ea6105f5e19a77a238712f695dae925735e3ff227946a10eb904f147","573b0775f1d744a518633c45c2918e93d2f340aa5e6d0e5c25ae20500a07d34d","f09a7e9ccc9f703c94ae05565d8071c985756f52cf1799693bb572f7c26d1e0c","e21e9e0116cf5c09fd13813807c155970ef8e6b0229f9905922209c7722227f5","fe7bd1a799d3d531b60d8e9c5fbd8959c9a4908b68f91ad19fa66217b7d84087","0bb8228efb987d0a17e1464aaaf758da8ce1f7c7d1c8363c7106b821195f4f10","1b1870bd640a707070639c34e57652f9dec581285b06c48f9219b41415953991","b358d6becf5f62ed19675075fdbece509805eddaff9f456a44ea20142c762785","bb471a624d9b7a48ff34167daad8ec310576cb3d40f95186a6b8263a74b69cca","028690c167c8567739eaf3d8a53e48ffd502ee5b996d7a557580dfd844719f1d","1f51557b4fbd548cc2167d3249bcb6d8f9274fa2eb292e37dabd09da8156062c","40531baa67f680f6532253c0ae46269a484a80c7d6f647940588e6ceea3b9818","cc3b5fbc74b49478e3cd92e240dd9d1e0dd93bfb7de13c299c7d02cdc26e0849","d84c87f3802f93e0827a25e51432cd490a9780a49385acd8eef4dc97cc1f4145","80f1b30bf6f27fcac620dab751b7c1bcf906f47f151e3950ab11ecb6009ead11","71449eb76b29e71566c41d896fcd0348d14bddc9d9349f43be00dae48db25add","21cbec8dedc2cd9d3e61df5bf9b9a7a0692071dc6b2326c975326dd21548915d","9038dc3bcf7a27725c5852bbcafd28ffb54bf0a7de566f129e8f3686fe890c38","85d38773325725004cd4d042e8829d6135d615619119ab5c179169d2cc970b48","c151940e9f93a2cbc2b9e457ac807e719208fd5f172ef98bcf972844a923d4ae","af0156b9d9ad73a7ce019fd7e3b6300f1ba5f017a73f28c5a0da5e982160578a","689d0a75afa2471fc0ab00047465e4be20d39911344390365ea475f7d3354ed5"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312518.zip::R2-2312518 - 38321_CR1706_Rel-18_Introduction of Cross-RRH TCI state switch indication for high speed train.docx:p240"}
{"fields":{"filename":"R2-2312518.zip::R2-2312518 - 38321_CR1706_Rel-18_Introduction of Cross-RRH TCI state switch indication for high speed train.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"<<<<Skipped>>>>","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"6.2Formats and parameters","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"6.2.1MAC subheader for DL-SCH and UL-SCH","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"The MAC subheader consists of the following fields:","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"-LCID: The Logical Channel ID field identifies the logical channel instance of the corresponding MAC SDU or the type of the corresponding MAC CE or padding as described in Tables 6.2.1-1, 6.2.1-1c and 6.2.1-2 for the DL-SCH and UL-SCH respectively. There is one LCID field per MAC subheader. The size of the LCID field is 6 bits. If the LCID field is set to 34, one additional octet is present in the MAC subheader containing the eLCID field and follow the octet containing LCID field. If the LCID field is set to 33, two additional octets are present in the MAC subheader containing the eLCID field and these two additional octets follow the octet containing LCID field;","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"NOTE 1:For MBS broadcast, a logical channel is identified based on G-RNTI and LCID if the same LCID is allocated for logical channels corresponding to different G-RNTIs.","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"-eLCID: The extended Logical Channel ID field identifies the logical channel instance of the corresponding MAC SDU or the type of the corresponding MAC CE as described in tables 6.2.1-1a, 6.2.1-1b, 6.2.1-2a and 6.2.1-2b for the DL-SCH and UL-SCH respectively. The size of the eLCID field is either 8 bits or 16 bits.","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"NOTE 2:The extended Logical Channel ID space using two-octet eLCID and the relevant MAC subheader format is used, only when configured, on the NR backhaul links between IAB nodes or between IAB node and IAB Donor, or for multicast MTCHs.","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"-L: The Length field indicates the length of the corresponding MAC SDU or variable-sized MAC CE in bytes. There is one L field per MAC subheader except for subheaders corresponding to fixed-sized MAC CEs, padding, and MAC SDUs containing UL CCCH. The size of the L field is indicated by the F field;","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"-F: The Format field indicates the size of the Length field. There is one F field per MAC subheader except for subheaders corresponding to fixed-sized MAC CEs, padding, and MAC SDUs containing UL CCCH. The size of the F field is 1 bit. The value 0 indicates 8 bits of the Length field. The value 1 indicates 16 bits of the Length field;","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"-R: Reserved bit, set to 0.","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"The MAC subheader is octet aligned.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"Table 6.2.1-1 Values of LCID for DL-SCH","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Codepoint/Index","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"LCID values","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"0","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"CCCH","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"1–32","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"Identity of the logical channel of DCCH, DTCH and multicast MTCH","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"33","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID field (two-octet eLCID field)","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"34","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID field (one-octet eLCID field)","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"35–46","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ecc7295152ab004fee6c5fe5b51922f6b04fc31c69bc0c2a87740df08932928","original_member_sha256":"5ac2a6eb195866185c7c6c25a8e6bde44e85ab5aebfb9dafb46d77b16a9bd085","paragraph_ElementTree_utf8_XML_sha256":["0a1cfd724d2d1e91b897f328b9a8875d70f1e747973fbfded66a57a69368cb3c","38b1e6912f302618d994c9fc0853073f236e9bd54c837202b1473e23a2f09c4c","a8e06231e76359e39b04382e704248d20edd15e61b3ef8400c3ef5df3b08733a","80398b68451aaa7a48b0cf29e644e8338cd19dcbe5395e4503d04e1ffaf2b8e8","90b035f06d6905879d6d6643a0c06dbc785a95a24e7dee9f04218bc73e147485","1a4b68686bf9ce08cb518e9a2bbb667395fde8864b49ec6ce5ac27a45b623071","37121fc4903b09c71ac9b7c8102a42e593503aa8252fbe34b22557b695f683df","7b9cb36b740ccab6d18d29bfe5ec70292d78737214b1ce39d73908e98a94a8b6","fdd2a771ee2b9a944f5ee67f3c936bc585530194dbb9630f842b4a88f604583d","e93a64eff8e6c1df9f6496dfcc8fb71b97219ce8481eaf0f601c718233d64f8b","d39dad6e187abe12516297b8d7b3ce014ec6d027cd030d121092ef651052dc1a","c8fe5be6a3b60b78d93c0e6d4429365805422822000ecca1061572c7cd3e277a","ae0af0c0aaa7b473bb228e7c2655cb8a263f3ae05debe55ca77cdc7ab80a04a8","a8c6ac33815e15f7e3940811c3105c37bdd51c01f28608cc11e76e7b6f5f61ff","e5f396616ed61d6e6124e882d28effd87f6d63a7e50511097baadb617de901f0","43c8f737b02e24cc8f2ee9e1e0f13eac6ef82e93775e1137b1eb16035170a3d0","847b109a3cc3fa912bdd6f25f32109c098c6054635563dc84d50540c160be9ae","59a3f7fdb7e1d53d79c6cbda512165604676fb52959a7991589019c8ddd49333","cb718b1d3163dd2e5f4aab391d7e9474d474ea6035bf6bc7a06cf7155dcf2ece","ec9c5621863bd686ab7c3a9b89e9112bfb4316012396dd54ce7387f208bca6f0","1aaa8e8702cc2a9a3dfce2148921bf9acebeaee16e0a6919ed4417d02112e8da","a