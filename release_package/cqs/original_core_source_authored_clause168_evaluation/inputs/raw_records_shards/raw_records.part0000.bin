{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":6312},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":6313},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":6314},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":6315},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6316},{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":6317},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":6318},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6319},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":6320},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":6321},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6322},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to false.","paragraph_zero_based":6323},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on FR2 UL gap according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6324},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for FR2 UL gap configuration:","paragraph_zero_based":6325},{"literal_text_all_w_t_and_m_t":"3>set ul-GapFR2-PatternPreference to the preferred FR2 UL gap pattern;","paragraph_zero_based":6326},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference for the FR2 UL gap configuration):","paragraph_zero_based":6327},{"literal_text_all_w_t_and_m_t":"3>do not include ul-GapFR2-PatternPreference in the UL-GapFR2-Preference IE.","paragraph_zero_based":6328},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide MUSIM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6329},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM periodic gap(s):","paragraph_zero_based":6330},{"literal_text_all_w_t_and_m_t":"3>include musim-GapPreferenceList with an entry for each periodic gap the UE prefers to be configured;","paragraph_zero_based":6331},{"literal_text_all_w_t_and_m_t":"4>set musim-GapLength and musim-GapRepetitionAndOffset in the musim-GapInfo IE to the values of the length and the repetition/offset of the gap(s), respectively, the UE prefers to be configured with;","paragraph_zero_based":6332},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM aperiodic gap:","paragraph_zero_based":6333},{"literal_text_all_w_t_and_m_t":"3>include the field musim-GapPreferenceList, with one entry for the aperiodic gap the UE prefers to be configured;","paragraph_zero_based":6334},{"literal_text_all_w_t_and_m_t":"4>include musim-GapLength in the musim-GapInfo IE and set it to the values of the length of the gap the UE prefers to be configured with;","paragraph_zero_based":6335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["87e73049825d03853d77096b84288fe4693423c4807101a4d5c68faace7036fa","c69592323cab964ee253317547c5f3e4717209147206b186f6c8101471f060b5","c0f98d8ac8113f275794131649731c8e29ebd843cb36c3d5dc30acfde0d06c43","31fec6102afeec494424c84a5504e949e6173e2d47e34dc0f90ea31450266409","582ac8af0cc9b602cc4752e5c5ddc44ee3e132b2a89890f64e8ff1b94e4a2c58","cb3582b98f95aec578a65979de8d48eb390e0b338413f4195c8a61051246fcda","12182fab65f2581451b2d338ed508fc0ca54e40e397af5ccc73c210393aab7b3","ec997d0b72999526921e41aacd98a52b9408309d99b2d0ed6fd0d92859154ba7","2cca1f11b81febb8f52dc7175253e5a07156202335a2808a487ff5efc04a18bf","0eaadb5467776b525ecf66967fca683441acb854409a2392f2deb3bc97f7a035","b920087e7829d23d66d0fa7ea4bb539185e2ca3c7fa2abf8ee08012cb1d72301","a8b36d615c693ad0197e5745145a497853c573553cb376dd69d866ea9a7d4a68","c335e5762a4762759cdf1cf2030026617393a892452e8a7ff8170cc5f0199dd2","2348a2f04efbe1d42f2954e9463313de19792fab99c8ad58570e82ddc8a70f81","ad74017daea8d6393a7f90f01cb6e879339ae64d6207609c1c8883361463de4b","4f7a56c2e23d2d779fd3530b38bf1b4af06eb52d84a8ef844ec068b9064bb7cc","45db9c1a5735533269cbaf66e5c3856f60aed0a5d8e1d6340fdf1c7e611533a6","1cacd8cb852ea6968f9f3a4e68487c8d3761c74316ca6decd21c7c28dfaccdfc","839e5dec93dc4c46d8b0e27cb799f589e3a62bfa485dfd519e8c9b7f55109544","90a193cab0d7210ac66e5e57097d66ff42aab65a485c7a9c287b4ac62bbd953f","7f0ab1ea32a9a74d13beadfa383b382be8819451486adee3d110e82ad0a569a1","ab1acced73094c1a02ec40851c7589a8d25b7d043ca82872881aefa42fae8033","4931bd0aa04b763f61c13b95294ad4d5e19a49e042ab8efaed388205f0a26312","f3c56188d0b6e719ca4ea36a02ff4a402f97bf25d98db71ac4bfe0425ec1e9c3"],"paragraph_range_zero_based":[6312,6335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6312"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>optionally include musim-Starting-SFN-AndSubframe in the musim-GapInfo IE and set it to the starting SFN/subframe of the gap the UE prefers to be configured with;","paragraph_zero_based":6336},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for the periodic/aperiodic gaps:","paragraph_zero_based":6337},{"literal_text_all_w_t_and_m_t":"3>do not include musim-GapPreferenceList in the musim-Assistance IE;","paragraph_zero_based":6338},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference to leave RRC_CONNECTED state:","paragraph_zero_based":6339},{"literal_text_all_w_t_and_m_t":"3>set musim-PreferredRRC-State to the preferred RRC state.","paragraph_zero_based":6340},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of RLM measurements of a cell group according to 5.7.4.2:","paragraph_zero_based":6341},{"literal_text_all_w_t_and_m_t":"2>if the UE performs RLM measurement relaxation on the cell group according to TS 38.133 [14]:","paragraph_zero_based":6342},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to true;","paragraph_zero_based":6343},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6344},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to false;","paragraph_zero_based":6345},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of BFD measurements of a cell group:","paragraph_zero_based":6346},{"literal_text_all_w_t_and_m_t":"2>for each serving cell of the cell group:","paragraph_zero_based":6347},{"literal_text_all_w_t_and_m_t":"3>if the UE performs BFD measurement relaxation on this serving cell according to TS 38.133 [14]:","paragraph_zero_based":6348},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '1', where n is equal to the servCellIndex value + 1 of the serving cell;","paragraph_zero_based":6349},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6350},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '0', where n is equal to the servCellIndex value + 1 of the serving cell.","paragraph_zero_based":6351},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate availability of data mapped to radio bearers not configured for SDT according to 5.7.4.2:","paragraph_zero_based":6352},{"literal_text_all_w_t_and_m_t":"2>include the nonSDT-DataIndication in the UEAssistanceInformation message;","paragraph_zero_based":6353},{"literal_text_all_w_t_and_m_t":"2>include and set the resumeCause according to the information received from the upper layers, if provided.","paragraph_zero_based":6354},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference for SCG deactivation according to 5.7.4.2:","paragraph_zero_based":6355},{"literal_text_all_w_t_and_m_t":"2>include scg-DeactivationPreference in the UEAssistanceInformation message;","paragraph_zero_based":6356},{"literal_text_all_w_t_and_m_t":"2>set the scg-DeactivationPreference to scgDeactivationPreferred if the UE prefers the SCG to be deactivated, otherwise set it to noPreference;","paragraph_zero_based":6357},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication that the UE has uplink data related to a deactivated SCG according to 5.7.4.2:","paragraph_zero_based":6358},{"literal_text_all_w_t_and_m_t":"2>include uplinkData in the UEAssistanceInformation message.","paragraph_zero_based":6359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["96f878587b31a2be070a0efdd0ff74cb22701845cfb4a9f44226f03ee35d8781","626e02901393bd4c0e3633803a5d65ef2343c1f3f828bedea5398ebe86d85e56","da5d49765b61947facda9903d7a6adf6d37a5305d240fc09ed75edde62a0760f","a087b12bb14b025fcbbd5831eabd1d5445415cc915fb2764f8c72c4e70f5d9fd","c6c8e1b77012706ca3fd8c2a2de1128f21ca7eeda485d2ed113e7ee98924e318","5615e68c7179529e1a6466fcc1a333fe9444527b2e106cfc355ea11bcee430ff","70dd0229335f7f467c914c29cfe21cd530ba399f71ddd4d17f6c0b903e572c5c","6efc86476cdc739eeb9a9cf0861a40d9f12e24b85729533b3fd3be5a3225af48","d02c57864781c0a4b817c2f75f435f7327b4b15a90f98b31695c92fafe05b3f9","5fdea04f2fac7b96264309a7b29b2ba6514d8ac25fb5d8f6e5b0b3fc187afcdc","21917d96cb82cba945cba93134a8b4c3ad79b36a4125eaa4913b76d8d991794a","f99b8b71753617c8425c58c5661dea51fcacd412ef10539c2bc37a81aaa9c70d","8ba79df2d6a839c72f067b087d0ddc5a09b0c817d43bd0bff810cf0077bca2ab","5abba42906d459a2a68de82b8c7ba1bd3e1b65fb3c2300ef012719df7a4763bd","185d77dfe4c4d964e925646acdd98702832f92bf56fe330a7f47532c1bc6a219","f47021cc1c0c54e60a6256a1061331c346873d189a4c2e9e6f7eef1fa3a8f4a6","2f5d3a4d71d83ca81a483031cd99cfb1b08b23dc2936e7aca96ad47a015cff24","aeda501efe6dbecc63d5054f98c2e8b445e506295b27665915907ebddd5e5d55","ee7e0954fea679048982a0f7a920c788a1e2c4726dfdd9e6bb3082d9487281c3","f673551f258ae99a7f0fb69ae63af9a5d376413be92f57a18043064b2f36ac35","91f94b4cf3c1350193fcd32bbbcbdffd6dc9837541a2d6a656d4f1deea712328","0cedbf071d454acfc7c3f7481e8eff153080fd2379143d1f895ca5d7a32770f6","d8aaf440b64eb43387c43516921e6840941d39fd84b828a9aeb9273fcce33680","a1acc41d351d158ff59d93c4c9e4c6250d8035bd8afb9cc0e79782fdf1872c47"],"paragraph_range_zero_based":[6336,6359],"projection":"All w:t and m:t including tracked 