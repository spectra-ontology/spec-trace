{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T346d (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41328},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with maxMIMO-LayerPreference.","paragraph_zero_based":41329},{"literal_text_all_w_t_and_m_t":"Upon releasing maxMIMO-LayerPreferenceConfig during the connection re-establishment/resume procedures, upon receiving maxMIMO-LayerPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41330},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41331},{"literal_text_all_w_t_and_m_t":"T346e (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":41332},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with minSchedulingOffsetPreference.","paragraph_zero_based":41333},{"literal_text_all_w_t_and_m_t":"Upon releasing minSchedulingOffsetPreferenceConfig during the connection re-establishment/resume procedures, upon receiving minSchedulingOffsetPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":41334},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41335},{"literal_text_all_w_t_and_m_t":"T346f","paragraph_zero_based":41336},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with releasePreference.","paragraph_zero_based":41337},{"literal_text_all_w_t_and_m_t":"Upon releasing releasePreferenceConfig during the connection re-establishment/resume procedures, or upon receiving releasePreferenceConfig set to release.","paragraph_zero_based":41338},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41339},{"literal_text_all_w_t_and_m_t":"T346g","paragraph_zero_based":41340},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-PreferredRRC-State.","paragraph_zero_based":41341},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease, or upon receiving musim-LeaveAssistanceConfig set to release.","paragraph_zero_based":41342},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.8.6.","paragraph_zero_based":41343},{"literal_text_all_w_t_and_m_t":"T346h","paragraph_zero_based":41344},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-GapPreferenceList Information.","paragraph_zero_based":41345},{"literal_text_all_w_t_and_m_t":"Upon releasing musim-GapAssistanceConfig during the connection re-establishment/resume procedures, or upon receiving musim-GapAssistanceConfig set to release.","paragraph_zero_based":41346},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41347},{"literal_text_all_w_t_and_m_t":"T346i","paragraph_zero_based":41348},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with scg-DeactivationPreference","paragraph_zero_based":41349},{"literal_text_all_w_t_and_m_t":"Upon releasing scg-DeactivationPreferenceConfig during RRC connection re-establishment/resume or upon receiving scg-DeactivationPreferenceConfig set to release.","paragraph_zero_based":41350},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":41351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["897ca3792235c64e93e2cf6abc793a521564f80734de824310efb2a33801bbb0","d2eab26e22a83c5adf45de33866236dbd225449a846217ccd007b47b1fd56f8a","66c8c86675e61fe0c231dab089a77ea9f17bb89628cdf0413eb49815e915816c","8356fa5