ll_w_t_and_m_t":"Inside to narrow down the grid scope","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"Outside to describe which side (north, west, south, east, above, below) of the specified grid the target device wants new grid data","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"verticalGridType","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"This field specifies the type of vertical grid that is requested by the target device – either a ground level or a 3D grid.","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["e65876c7a7886e8a7d779f6a62cf33caf0400a9e472cf2af3ac7d0a0e531beb3","28b59d9d97da520528e9c385d53b8b75ad3b07d3683a50353795500a58413320","16332c75427d1ec9848961922e71ae9dafcda2a331dff9f2274380b7c68a75e9","9982fc514ff38026de18282cc4f7f71b4695370a61846980d890bd0e3418a2ce","ce4ff56c492699d2b10a7c9a5d7700e880d241c6ce2351f621d6dd6133a3bac9","3defe313eb7f036f8f01cb2be6d964127367163ff37ceed52e87b4da5633ba59","b83f48026527037b028b0242f34ab03ec999ac0918ff61e665ec1aa4b60896af","a14eb57861fbd9c75db4ba4467ad5eef8d64a7b0029c17b60dfd2b5805f555b3","8169d974d44aafb642b4070ee7917f372e664e616010d107f9dc3dc076e5b37a","16b5b2fa8b216b27cd6e0c06437df06b0c6ef9d7d8a3e6119a21b07ec7405992","0864e468a6bb6b5d760c7753eb59c30609d778831959a2d0377aea6db816a1ba","086d179dc7e3089e1629bc8ccb835b00536d705d3f6770356773a9b848f6135f","320542df5e32980d2f196de227d0d9f1d42a97ca9ef38115dc98461ea2554ab7","e4d39aacbaf5eab8142f9f44d668dc352366fdcc507bc35ad593aa802a9edf3a","fba340d7b167c315ce5005f475cd7042d374a62940c2059c84b77aa8485626f4","611ff2c46c76bb4