dinates":{"document_XML_sha256":"5beccf2c4f7bc5ba3600d747955377cdba92a80fa413985f5bae4049b3acb775","original_member_sha256":"d98a639b7aa49723a0879cdea4b6917ea304cb84ec0d9c26e2a2bc33ee4c3d9f","paragraph_ElementTree_utf8_XML_sha256":["ac0c5dcb292132a02c5c00b11af02c3fadad4979616c119cbf2828cfa15b0cee","385d352bf13e5e76c08d910886e029dec1818acb20b8453d45611bbaca6994e5","78c102571c7dedf8b85218fe0c07bfa7d281cd2282c109f09571e27ab17856b6","c4491965c66a773decc17ac2f5770bb1e6f7a419be8814b13d2d5e75e450748c","c6b88c21e27d89bdc2e84afc8379e5e0c1f3ad24a8eb4dec07f64a162a35a232","e595cb22e1d6c655d0aad89aeee23e31ce4b62a84a23741d08816fc62002ac57","c3cb387b64261b67cfb35f2dc614334469fdd5fa270dcb0792f4c73fb0719c4a","97f8d791d93d4d425b8992da7ea5224a968d4bd3f927313a2f13e39de4300590","9ed06085b3ef652f3add030f164a792feada87c16a6bb7edcd48c7a4211483b2","6bbff1e67258c4478cf9846c57712040829e7794a229adc86495fbfd7a61e564","c0e319d50f0c27c4b0931c52c7ab872e35bfb5528d38bbbe507bd4ae73fede62","0d7f4c2205342109200f6384d913474488fda2cfa4de2889bd1dde14c1154f79","87bd573004a7d32239ed419e4929a328f6e80816b6662810660bd2564b20def1","e1f1b880da5de2e57e3e5759ef1d5643884ba93799b9ec0d5f998f24128e4bdc","4a50e8ebf1a967336244d56e8fe16c1736f2bbd96eb7a206a69465e6e646384e","36847229657fec94dfb73568feaa74a2ee063c3eb3d29a0c69ca5afbed81ab6c","2a666e52eb9230899445cc8fae07df4a6025d0fc47f946f4e80537e989436aea","1d56ccdd332acc8eacad868e50d88f8655e020c0fb103a2dc042c1ec461fc145","4078f966740de8e0d9e9441ecfdc70e294b9b7221df7c50c35e10eb8e087e2d9","b4745f2b86af6a4aa8ed60fa3f80fb45a8f5632a8ab8ec4be9ad2ce149edfa69","02d06725edbffe0e15a3424cd09ead7ff110d90285ff30348d4f8283d22deef0","99d9f3162de0e1a11774bf4539bb5e6052360c918332738be22e4cf077b3257d","a27b7edaaf60288f2f76b8c2298e49e84f04c1b5b023f70f6a5b83ea04c432a3","d80158f11788eff5eb7fda1579533ce2f266c665b975548e33452650346834fd"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer a