{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-Config-r17               SetupRelease { SL-RemoteUE-Config-r17}                                 OPTIONAL  -- Cond L2RemoteUE","paragraph_zero_based":37752},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37754},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-STOP","paragraph_zero_based":37755},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37757},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR field descriptions","paragraph_zero_based":37758},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToAddModList","paragraph_zero_based":37759},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to add and/or modify.","paragraph_zero_based":37760},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToReleaseList","paragraph_zero_based":37761},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to remove.","paragraph_zero_based":37762},{"literal_text_all_w_t_and_m_t":"sl-PHY-MAC-RLC-Config","paragraph_zero_based":37763},{"literal_text_all_w_t_and_m_t":"This field indicates the lower layer sidelink radio bearer configurations.","paragraph_zero_based":37764},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToAddModList","paragraph_zero_based":37765},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to add and/or modify. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":37766},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToReleaseList","paragraph_zero_based":37767},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to remove. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":37768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37769},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config field descriptions","paragraph_zero_based":37770},{"literal_text_all_w_t_and_m_t":"networkControlledSyncTx","paragraph_zero_based":37771},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall transmit synchronisation information (i.e. become synchronisation source). Value on indicates the UE to transmit synchronisation information while value off indicates the UE to not transmit such information.","paragraph_zero_based":37772},{"literal_text_all_w_t_and_m_t":"sl-DRX-Config","paragraph_zero_based":37773},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration(s) for unicast, groupcast and/or broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":37774},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":37775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4a9ea3cf504ff029ebd8fdc1c09166c234e19b5a8eb5cdc8ca8bc6632d6aa2e9","3afe90d532e0bd422102b0cce088859aad6e15daad159c2262fd408e7b8e5201","3a9fae48527cafd4e44fc26637c16472fc9d80be177773d0b5699f84daf9cb09","05e093cf8aab0febc0632e3be5a94b24877cda5410481a5e7b75000c26820cfb","4c958b645a10ca5a1626e9415d6e7183b14b2cdb51ce0bacf77ba43f2f9721e1","31fea295ec818249d26d2a0bce1349d5c65d69a2c059f155bed22fed77901dd3","4cc65161d2799d1fe7d075b4e685c8b9a4d510ac6af00c876e4f08f32f16c8df","dfd49545199f5f1329a8933a2bae5d779071a7b7389b67b31c3c06d786832e4a","c0504ddf5c563ccbd9ad95a066266849a0d4b836ca6b8ad9743a8cd13e575f5e","c26782e87bcc95c5b1d53d989518e5ebba1c82942a745e3670a29236fcc93ff9","a724bb8b4f276d81c31a9e1217ed12c5eb9983e50b1c85f51a141366526db8ee","0db52d8a112a18a4c495ebaca7d40b99a35f69b54285589fc93177636b859365","5d4e93b5e08bb6690fe7f58c525f8ef2b54f988d793f5de778e4b74ae54158c8","de623c609f0f6d7e4b108152872675bc89d815a51cbf4bea50f281a69e0aade9","a3bd7f035b80ca54e5061e9bafea22ca10b2536c315e61ef80fde8e26240dac2","954c3fa12e45b91f166a3869037cb4dca46690e8a1bebce95f00143bc76036e5","b487dced0b14dab0b23ea408a141d6c81b9ae828f8a0acda89852613cb6e7131","9ee8bb0e4e665263e71698030d935a14c64debdd949bc080fdeb01237778c638","5b812d8d8937fb0fc93939f8bb71562944c3aa8f44b508f1f87b00151b62cc7d","b51c35d57ff4f05cb7c2413d783d67eb7f7e50b470d68eb2852f76c0e1ebbf91","f2135d29d305ab318b56f5dea299ab00661af7222a72255fa2b269653922431f","0254c70aa549b17d6d18e660ea69f9c9a76900670b3e4c0f71eb42c59b688fe4","4c6bdeb6bbdeef0c17feab7dd417485e48f58d8cecf16d02036b34413ae142b1","4cba37931f917505b4b315c65e9f2ef2562970121e062aa950dc6db2a21714af"],"paragraph_range_zero_based":[37752,37775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p37752"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":37776},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToAddModList","paragraph_zero_based":37777},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to add and/or modify. In this release, only one entry can be configured in the list.","paragraph_zero_based":37778},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToReleaseList","paragraph_zero_based":37779},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to remove. In this release, only one entry can be configured in the list.","paragraph_zero_based":37780},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToAddModList","paragraph_zero_based":37781},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to add and/or modify.","paragraph_zero_based":37782},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToReleaseList","paragraph_zero_based":37783},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to remove.","paragraph_zero_based":37784},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToAddModList","paragraph_zero_based":37785},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to add and/or modify. Each PC5 Relay RLC channel configuration provided by network to L2 U2N Relay UE is uniquely associated with one L2 U2N Remote UE.","paragraph_zero_based":37786},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList","paragraph_zero_based":37787},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to remove.","paragraph_zero_based":37788},{"literal_text_all_w_t_and_m_t":"sl-ScheduledConfig","paragraph_zero_based":37789},{"literal_text_all_w_t_and_m_t":"Indicates the configuration for UE to transmit NR sidelink communication based on network scheduling. This field is not configured simultaneously with sl-UE-SelectedConfig. This field is not configured to a L2 U2N Remote UE.","paragraph_zero_based":37790},{"literal_text_all_w_t_and_m_t":"sl-UE-SelectedConfig","paragraph_zero_based":37791},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection. This field is not configured simultaneously with sl-ScheduledConfig.","paragraph_zero_based":37792},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":37793},{"literal_text_all_w_t_and_m_t":"Indicates whether CSI reporting is enabled in sidelink unicast. If the field is absent, sidelink CSI reporting is disabled.","paragraph_zero_based":37794},{"literal_text_all_w_t_and_m_t":"sl-CSI-SchedulingRequestId","paragraph_zero_based":37795},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink CSI Reporting MAC CE and Sidelink DRX Command MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":37796},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":37797},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":37798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf