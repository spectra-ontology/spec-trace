{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1201},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1202},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1203},{"literal_text_all_w_t_and_m_t":"Segmentation","paragraph_zero_based":1204},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need OP, if lpp-message-segmentation-req has been received from the location server with bit 1 (targetToServer) set to value 1. The field shall be omitted if lppmessagesegmentation-req has not been received in this location session, or has been received with bit 1 (targetToServer) set to value 0.","paragraph_zero_based":1205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1206},{"literal_text_all_w_t_and_m_t":"CommonIEsProvideLocationInformation field descriptions","paragraph_zero_based":1207},{"literal_text_all_w_t_and_m_t":"locationEstimate","paragraph_zero_based":1208},{"literal_text_all_w_t_and_m_t":"This field provides a location estimate using one of the geographic shapes defined in TS 23.032 [15]. Coding of the values of the various fields internal to each geographic shape follow the rules in TS 23.032 [15]. The conditions for including this field are defined for the locationInformationType field in a Request Location Information message.","paragraph_zero_based":1209},{"literal_text_all_w_t_and_m_t":"velocityEstimate","paragraph_zero_based":1210},{"literal_text_all_w_t_and_m_t":"This field provides a velocity estimate using one of the velocity shapes defined in TS 23.032 [15]. Coding of the values of the various fields internal to each velocity shape follow the rules in TS 23.032 [15].","paragraph_zero_based":1211},{"literal_text_all_w_t_and_m_t":"locationError","paragraph_zero_based":1212},{"literal_text_all_w_t_and_m_t":"This field shall be included if and only if a location estimate and measurements are not included in the LPP PDU. The field includes information concerning the reason for the lack of location information. The LocationFailureCause 'periodicLocationMeasurementsNotAvailable' shall be used by the target device if periodic location reporting was requested, but no measurements or location estimate are available when the reportingInterval expired.","paragraph_zero_based":1213},{"literal_text_all_w_t_and_m_t":"earlyFixReport","paragraph_zero_based":1214},{"literal_text_all_w_t_and_m_t":"This field shall be included if and only if the ProvideLocationInformation message contains early location measurements or an early location estimate. The target device shall set the values of this field as follows:","paragraph_zero_based":1215},{"literal_text_all_w_t_and_m_t":"-noMoreMessages: This is the only or last ProvideLocationInformation message used to deliver the entire set of early location information.","paragraph_zero_based":1216},{"literal_text_all_w_t_and_m_t":"-moreMessagesOnTheWay: This is one of multiple ProvideLocationInformation messages used to deliver the entire set of early location information (if early location information will not fit into a single message).","paragraph_zero_based":1217},{"literal_text_all_w_t_and_m_t":"If this field is included, the IE SegmentationInfo shall not be included.","paragraph_zero_based":1218},{"literal_text_all_w_t_and_m_t":"locationSource","paragraph_zero_based":1219},{"literal_text_all_w_t_and_m_t":"This field provides the source positioning technology for the location estimate.","paragraph_zero_based":1220},{"literal_text_all_w_t_and_m_t":"NOTE 1:In this version of the specification, the entry 'tbs' is used only for TBS positioning based on MBS signals.","paragraph_zero_based":1221},{"literal_text_all_w_t_and_m_t":"NOTE 2:The entry 'sensor' is used only for positioning technology that uses barometric pressure sensor. The entry 'motion-sensor' is used for positioning technology that uses sensor(s) to detect displacement and movement, e.g. accelerometers, gyros, magnetometers.","paragraph_zero_based":1222},{"literal_text_all_w_t_and_m_t":"locationTimestamp","paragraph_zero_based":1223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["402766b0b4c0336368fadcfdad99d7c12695b4a64e3a378746486502ba75f22e","bece83ee61a7f81bd2bd6b62ce7cb8ebc491e3f33ae034b6374903e0c421568a","8a00599e1b7e41457c72064f293b7c09c01d5103278f2d3c621b858260caf4c9","4397ae3b785516919b4bdf7bff0b6504df121fb7e477ec3e431fa2554795e882","bad9ee31e82aaa16f0c66e795f193910065c1138fcf38dee7c22be7a7e9dcf46","ad3f5c5c862245663c169df6c8b1de6a3cf3bb7a4aa65edbdaaa44207bdd1b50","5f97f18df6ae2ba0419954ab97fd3863e4d7851829c8f27bcbf2093e23b387e2","43cb8906891099812478e68414ac9cecda0f8670022f1375a16cd8128dc383c3","d952d955b7fc7593526bbec821b717671cb7cf115b8e39f49a82d5a69dada523","80e3a187625f1c85c1a58fcec065dd8ccff86100b06eab095364ee3fa8af5dac","51a39be1bd910de1140b32fc1deb0c9ee4ecad441cf3369fbc5ebce29ef40a34","b3cf31d77842f5dbdef58e5da5ac9c82ff29d5256a6a68e0354e8960b99f4dec","b2883ae564cd4efadb6c25523f0dc46caf07680144f98daae391765eca2b98b7","b8a8ab4b373e28c053f344a71c8bf6434d448874f08c1e8ed8c5a975e502a8ac","34799dcd5a2886fa470e68acd39e7888a2e3715f5e039ecf422b7ac9efa6670f","edc81c053a91b40842c03d9a8e741f7da9a117f195f3e976df92d9a57121fb10","25e2ca1dd52fdab8d4fb715a2212f9c6ebb67983f3d6ab03d1e161f35e569a79","a7ac7f47dcc7da0e6ba516bea2f9dca937c8c0e2a2bbba5b6301b8c85b1447ee","f0c891dbd8b43c4dbf448cd0cd109d238d90d4690f79f594aef1cf8c0f5d1bdd","799f2e4b894dd7d6f7804b59ad9426cf71a27d88e0b8031c7ed073d2d18e642e","5bcdbb2b57414867a28e7750ffcd3b7493e461e61cd38f1075fae4a8e62aed27","4618cb03930521f36b4ca04c4ba7607a4ce305c988492480a6c000ac36a70a6c","0343bd0cedd6ac3406f9dd131cfba513fc3ff974471fd2034c0a551989ad60c6","95b644b8f405ffd0de6465f12482df8bb4813df4f5f18dd5e27d12aea73594a5"],"paragraph_range_zero_based":[1200,1223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1200"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides the UTC time when the location estimate is valid and should take the form of YYMMDDhhmmssZ.","paragraph_zero_based":1224},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":1225},{"literal_text_all_w_t_and_m_t":"This field indicates whether this ProvideLocationInformation message is one of many segments, as specified in clause 4.3.5","paragraph_zero_based":1226},{"literal_text_all_w_t_and_m_t":"integrityInfo","paragraph_zero_based":1227},{"literal_text_all_w_t_and_m_t":"This field provides the integrity result for the locationEstimate.","paragraph_zero_based":1228},{"literal_text_all_w_t_and_m_t":"-horizontalProtectionLevel provides the HPL for the locationEstimate along the semi-major axis of the error ellipse. Scale factor 0.01 metre; range 0 – 500 metres.","paragraph_zero_based":1229},{"literal_text_all_w_t_and_m_t":"-verticalProtectionLevel provides the VPL for the locationEstimate. Scale factor 0.01 metre; range 0 – 500 metres.","paragraph_zero_based":1230},{"literal_text_all_w_t_and_m_t":"-achievableTargetIntegrityRisk indicates the achievable TIR for which the HPL and VPL are provided. The achievable TIR is given by P=10-0.1n [hour-1] where n is the value of achievableTargetIntegrityRisk and the range is 10-1 to 10-9 per hour. If this field is absent, the achievable TIR is the same as the targetIntegrityRisk in CommonIEsRequestLocationInformation.","paragraph_zero_based":1231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1232},{"literal_text_all_w_t_and_m_t":"NOTE:Void.","paragraph_zero_based":1233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1234},{"literal_text_all_w_t_and_m_t":"–CommonIEsAbort","paragraph_zero_based":1235},{"literal_text_all_w_t_and_m_t":"The CommonIEsAbort carries common IEs for an Abort LPP message Type.","paragraph_zero_based":1236},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1238},{"literal_text_all_w_t_and_m_t":"CommonIEsAbort ::= SEQUENCE {","paragraph_zero_based":1239},{"literal_text_all_w_t_and_m_t":"abortCauseENUMERATED {","paragraph_zero_based":1240},{"literal_text_all_w_t_and_m_t":"undefined,","paragraph_zero_based":1241},{"literal_text_all_w_t_and_m_t":"stopPeriodicReporting,","paragraph_zero_based":1242},{"literal_text_all_w_t_and_m_t":"targetDeviceAbort,","paragraph_zero_based":1243},{"literal_text_all_w_t_and_m_t":"networkAbort,","paragraph_zero_based":1244},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1245},{"literal_text_all_w_t_and_m_t":"stopPeriodicAssistanceDataDelivery-v1510","paragraph_zero_based":1246},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["a75c57ae38e77a9a9493d08254b756970e0675e1236633e942e3570916edf257","97f5df1aadbf5f6c654d17ac662dbe2b5ba15c4f4b0ea3fad1acaed32fa4e79e","d89518e57032e382fc6e41d3a115216e9b9744c259be3398f4816a042317c221","1374de1fe021f45f6bbce4230798738d51eacebb75d9ce9ede575781f838f67e","3b2ffc8215af274fa2b06d3e1ebb5afdc90ba6567a8d99b20405e1904504823c","c4a794a96367854a1b8f6b30fa68ab799afbecb0ef900ea190348cbffbc8a930","c729b9ef8bb9ae569ea855d9201b7bdc2810f2f61a7d9d9af7ceafa9edcd2024","e9d6dc5140e1077e97365171e5b2a0e67e2497b3d6b300cd30d73c70ee655254","7a96ae00ff0161d5041f3f4b556ce53d532b482e7d7ea279d83a145d1622fa69","e79a16768b2702cb65ca16d74320e15706ba77d22652e1c135e86cc900900e77","1611571f3af81f9850c382b330e3bc7165ac912dda8b390e2eddffdd095b904c","45ff4cdc01e9866c98c21a1827950146c02537f4f5171471dff998b2d4ce1f81","f89bbbeb09cb51b84b3918b4451786a7e10e8641f6be8daf428d039ca7c6954c","12f42d95b9aeb9abc8125f2dc8f3ecaaec7ac563573c6311e6e97ad39bc8c24d","066ef5a68e66969f6e411fdee873b345650d18e67ebd00c5856651076258ad70","e106bc816c7c95bcfee7294fda717a4d5304e8143bf6411535fdaa810003440e","c2e83f127cda8d79c6e3b1e4932576bb08118b29fbaf1b9e4b5a4aa210cc8849","8ca1517c66f18101de207db93216479346a7f387ef4821700b6acb24bc3bfee2","31329e06786ddec7226f682433d3d7b0838c6c5db17489d63f5c038d23866d00","b0b707c3c61230726f882b7a2ab268d8c76b463b4601729af716b329d79a5acd","f7097d706cee848a4e61c05b42c90f2366b0eb215bb26cd123fef85e20718049","d84075c8eb3dd058a869ed42a51e5b68dfcc5c9b90ac8a505b2a28b7cf76c3ff","9babe7d9183a691651a7dd60193b695293bd83da62d754147786e2a5ca162a11","aed77540ac025715ec6ea93151ec11176afcd199e5c04e4af24841329e102318"],"paragraph_range_zero_based":[1224,1247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1224"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1249},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1251},{"literal_text_all_w_t_and_m_t":"CommonIEsAbort field descriptions","paragraph_zero_based":1252},{"literal_text_all_w_t_and_m_t":"abortCause","paragraph_zero_based":1253},{"literal_text_all_w_t_and_m_t":"This IE defines the request to abort an ongoing procedure. The abort cause 'stopPeriodicReporting' should be used by the location server to stop any ongoing location reporting configured as periodicalReporting or triggeredReporting in the CommonIEsRequestLocationInformation.","paragraph_zero_based":1254},{"literal_text_all_w_t_and_m_t":"The abort cause 'stopPeriodicAssistanceDataDelivery' should be used by the location server or target device to stop any ongoing periodic assistance data delivery, as specified in clauses 5.2.1a and 5.2.2a.","paragraph_zero_based":1255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1256},{"literal_text_all_w_t_and_m_t":"–CommonIEsError","paragraph_zero_based":1257},{"literal_text_all_w_t_and_m_t":"The CommonIEsError carries common IEs for an Error LPP message Type.","paragraph_zero_based":1258},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1260},{"literal_text_all_w_t_and_m_t":"CommonIEsError ::= SEQUENCE {","paragraph_zero_based":1261},{"literal_text_all_w_t_and_m_t":"errorCauseENUMERATED {","paragraph_zero_based":1262},{"literal_text_all_w_t_and_m_t":"undefined,","paragraph_zero_based":1263},{"literal_text_all_w_t_and_m_t":"lppMessageHeaderError,","paragraph_zero_based":1264},{"literal_text_all_w_t_and_m_t":"lppMessageBodyError,","paragraph_zero_based":1265},{"literal_text_all_w_t_and_m_t":"epduError,","paragraph_zero_based":1266},{"literal_text_all_w_t_and_m_t":"incorrectDataValue,","paragraph_zero_based":1267},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1268},{"literal_text_all_w_t_and_m_t":"lppSegmentationError-v1450","paragraph_zero_based":1269},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1270},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["12c2321f7dbfd1b88b9c48db4ce3e83d84e061361cec289cfc97afbcfaa3abb6","86a857c72802fb06b4b8c24a8c62c6735319a1eacce7682b363ebedd550a664b","013b385cc32e6c3057fa7120d2e16d16d7f305eb7a173cd1ed4574636a02874c","e2a6eabc2f9fa00d95475170741689574113e6d211fa6dbd5772e16ed1efd1c4","d4854723f57f3919c76aa42a62b00e22ea34582ec0b8d88705249fe1a4ba2933","35fcd4e27cd2d50e26023f06b4d592f87a7c6fb5ddf35b02fbba09daf3687b1b","5a7bd1e88a8f2af8548fbf574f18eb935a94f7cd292637350bf38cdeec35937f","1782d914ce3d99cabb7f8e967b5aaed186b3c032d935bb594d32483d6200b0b8","34a24cd8cfcb47747ba247e3d709487863f0a92f485fdc784b84f953c0ccaa44","188c8e1a03cc0e6817c73ec1a615114be1706373ab768d3718d2d3ea7a6c5b82","470c1fce078689498a9860fe9769f14def2578368c42ae5d20ed4406a34281ef","4dfbb8377491d6b239fac66ebaa1d1df8112b32697404547de229858a2a527db","4f8a03caf9d26d1bc782fa6f7c62d3293acb4b7cc09be6f40488eed84a38efd9","0afd99786f651468a02a4c9fe9c57f431f4607b99a4308d25d3d11700c477221","db9c7accb5f0b9e85621b3311082df032553ae2f6430e5b3975ceec4f7dc093a","7194d6fd4f4e895d642ac365bda1dd1dd419fa292b51d2f03bf16b836ef604ae","2c6fa5f6a053d539bab564b3d0fc0f2b20f3acf2afb1b71946b8c0c1864da6d1","ef8a4235dd8df8cf52096b05deb3801042dec2a3019d61fa25a83b2f7af47f87","f898dce2b3377d3237dcc539d67f304f818f3a9e91162d4fb05be25ebe5ff418","45a6b590033eb0ba10ccabe1106afb9a068b0cdf83666230681db13df5ee17e9","704f2f7aec45d0354775f62499977cd977b0ad5079fe133b7f06f99fa973f425","09169eb00517cb1a1f395c756b511bba449a1fd7a7a7183a3af4f27e09dd339f","1fc42a296d272c3ced664a62f740990b019a1cbf43cc385fc3fb1b48ef789296","f88ace17b85e2ff7d585575880d332e5afb852d2dae7fe72160a628e87e0df75"],"paragraph_range_zero_based":[1248,1271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p1248"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1272},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1274},{"literal_text_all_w_t_and_m_t":"CommonIEsError field descriptions","paragraph_zero_based":1275},{"literal_text_all_w_t_and_m_t":"errorCause","paragraph_zero_based":1276},{"literal_text_all_w_t_and_m_t":"This IE defines the cause for an error. 'lppMessageHeaderError', 'lppMessageBodyError' and 'epduError' is used if a receiver is able to detect a coding error in the LPP header (i.e., in the common fields), LPP message body or in an EPDU, respectively. 'lppSegmentationError' is used if a receiver detects an error in LPP message segmentation.","paragraph_zero_based":1277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1278},{"literal_text_all_w_t_and_m_t":"6.4.3Common NR Positioning Information Elements","paragraph_zero_based":1279},{"literal_text_all_w_t_and_m_t":"–AreaID-CellList","paragraph_zero_based":1280},{"literal_text_all_w_t_and_m_t":"The IE AreaID-CellList provides the NR Cell-IDs of the TRPs belonging to a particular network area where the associated assistance data are valid.","paragraph_zero_based":1281},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1283},{"literal_text_all_w_t_and_m_t":"AreaID-CellList-r17 ::= SEQUENCE (SIZE(1..maxCellIDsPerArea-r17)) OF NR-Cell-IDs-r17","paragraph_zero_based":1284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1285},{"literal_text_all_w_t_and_m_t":"NR-Cell-IDs-r17 ::= SEQUENCE {","paragraph_zero_based":1286},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r17NCGI-r15OPTIONAL,-- Need ON","paragraph_zero_based":1287},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r17NR-PhysCellID-r16OPTIONAL,-- Need ON","paragraph_zero_based":1288},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r17ARFCN-ValueNR-r15OPTIONAL,-- Need ON","paragraph_zero_based":1289},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1290},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1292},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1294},{"literal_text_all_w_t_and_m_t":"AreaID-CellList field descriptions","paragraph_zero_based":1295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["4fc930ae9edf7c9490e13cf1f43ab8a84b3bab60bc5b89d508af2d92dc8520eb","e5555c204c7a8303589918d3d822c79364dba0157d758dd3f3666bb93a3389ac","34f6ce2ae54cb84823f6cc5392c5f184b5b2a5d44452367742c1f93a45af1082","7d97e97ee98d13f63b18171f21580b60d3c6db80b3729abf5a1d1660e51ffa27","e27897345246505af1d7ce157b104000de34c265c38e717d709c574f8238d895","2c63a37ae73300a9feef886ae411d40439a2af7c4e2973afac6a8f3c957b9ca7","261ca185340597e9b59186fa8ff5fe42f07469584e8e25560f3c2d6133fb94a8","e05d7f72d310237870d7aff2402f68d4da048d17de75e603a68d8aa8ce36d874","6edaca0797951c8d1c07469155cb78dde2951f36ac9c4469bb8beac559dfb88b","a71ceb94d0cd8f455f88e980a200aad3d7c0d62bc9db0d8e3cd45a6d74f59a61","74fc43a780d740632508b06cd810538e2002b9ba3feea0c5861c039aedcaee8c","d44b7c48f999d61b6e1ab3ebfc3a996a6db439b4e5578ec8dcdcb0a4111f807d","0babc9aad423990e85fd2179265613c2a33816374c72f79f93d92077016b83dc","75f2dc9b72e6fd42d02e89837bfb4d8c8c4b885f62932f2d6b3b5880511f63cb","a66eefa674b0a50a7079e75944b6cf42ce838d761db180a312cbf64490429d13