},{"literal_text_all_w_t_and_m_t":"PosSIB-MappingInfo-r16 ::=   SEQUENCE (SIZE (1..maxSIB)) OF PosSIB-Type-r16","paragraph_zero_based":14392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14393},{"literal_text_all_w_t_and_m_t":"PosSIB-Type-r16 ::=          SEQUENCE {","paragraph_zero_based":14394},{"literal_text_all_w_t_and_m_t":"    encrypted-r16                ENUMERATED { true }                                            OPTIONAL,  -- Need R","paragraph_zero_based":14395},{"literal_text_all_w_t_and_m_t":"    gnss-id-r16                  GNSS-ID-r16                                                    OPTIONAL,  -- Need R","paragraph_zero_based":14396},{"literal_text_all_w_t_and_m_t":"    sbas-id-r16                  SBAS-ID-r16                                                    OPTIONAL,  -- Cond GNSS-ID-SBAS","paragraph_zero_based":14397},{"literal_text_all_w_t_and_m_t":"    posSibType-r16               ENUMERATED { posSibType1-1, posSibType1-2, posSibType1-3, posSibType1-4, posSibType1-5, posSibType1-6,","paragraph_zero_based":14398},{"literal_text_all_w_t_and_m_t":"                                              posSibType1-7, posSibType1-8, posSibType2-1, posSibType2-2, posSibType2-3, posSibType2-4,","paragraph_zero_based":14399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5463e03663f7ec23882160f049bf090e7f005efac0a7ac780f89ae1f1577fbcc","7c24cc192622b0379294666b2d2d4ce371b9e2c167e6747bf82947ccb0e4c4fd","c84df14f195e025f02b7996cd736c01247ba64ddebe48dc2b0e8f3c3fc77aef9","11b7cc7b1d813d974ef6933d1c7f9e8c3329b42beb389bbde1bd12047c878d9f","56bbd42c166960f5394e31582a18f5a787dd29c22355ae0517f7e75823644da1","e6995962ff30a6f636124e099b7bd601d73c78b5fc9e05