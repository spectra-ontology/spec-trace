{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE NG-5G-S-TMSI contains a 5G S-Temporary Mobile Subscription Identifier (5G-S-TMSI), a temporary UE identity provided by the 5GC which uniquely identifies the UE within the tracking area, see TS 23.003 [21].","paragraph_zero_based":21384},{"literal_text_all_w_t_and_m_t":"NG-5G-S-TMSI information element","paragraph_zero_based":21385},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21386},{"literal_text_all_w_t_and_m_t":"-- TAG-NG-5G-S-TMSI-START","paragraph_zero_based":21387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21388},{"literal_text_all_w_t_and_m_t":"NG-5G-S-TMSI ::=                         BIT STRING (SIZE (48))","paragraph_zero_based":21389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21390},{"literal_text_all_w_t_and_m_t":"-- TAG-NG-5G-S-TMSI-STOP","paragraph_zero_based":21391},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21393},{"literal_text_all_w_t_and_m_t":"–NonCellDefiningSSB","paragraph_zero_based":21394},{"literal_text_all_w_t_and_m_t":"The IE NonCellDefiningSSB is used to configure a NCD-SSB to be used while the UE operates in a RedCap-specific initial BWP or dedicated BWP.","paragraph_zero_based":21395},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB information element","paragraph_zero_based":21396},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21397},{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-START","paragraph_zero_based":21398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21399},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB-r17 ::=      SEQUENCE {","paragraph_zero_based":21400},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB-r17        ARFCN-ValueNR,","paragraph_zero_based":21401},{"literal_text_all_w_t_and_m_t":"    ssb-Periodicity-r17             ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }       OPTIONAL,   -- Need S","paragraph_zero_based":21402},{"literal_text_all_w_t_and_m_t":"    ssb-TimeOffset-r17              ENUMERATED { ms5, ms10, ms15, ms20, ms40, ms80, spare2, spare1 }      OPTIONAL,   -- Need S","paragraph_zero_based":21403},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21404},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21405},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21406},{"literal_text_all_w_t_and_m_t":"-- TAG-NONCELLDEFININGSSB-STOP","paragraph_zero_based":21407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f81f15e686c36a46159b922a182af78f8c2ae3afa40849034bf777dc12395f31","1c2f5a635656ccdaad52a9b6836f6061ca75cd5682443790241848ad26bd5e48","db20ad68cc481d2435df84bdb83a9c0508e8d2768cea3508ef203012bc9f9075","8baa869a3f41e3622bc13c43f0c8de66127fa3998deb9f02286231b67af846c6","0d241f35503d928c0a7b270bede46b2b528b9a2ef5262c292b4f45ec55443f4a","e1ae55e95dae845dcd88a59afc7127919710067910a8def5dd1a3f2308587aef","2b71ef8477dd5add2ebe809752444e5d204ab142fd7d77d00e1b4fea3438050e","51959a4cc9e46b44bf6611f1762548ac86ba06f7884211bc33e273421656a2af","c7db4034bfe5dca2a9cf7f2d876ae04e99d9958f1bee4534784445af9cadec69","3ba117c2e1d6d60f2b4c039459cd98d8dcf70b0e0019978cd121ba2cbb4f787b","f8350e01e82d415a7d4f4bfe2ebf2b3810b758b8fac7e12d9fb32458d349242e","01183126ff9f6051f2ac983bbc0fe37a2281bd377c3ebdc39e5cec9060887123","1ee86aba3a8b706320a409c6db05b418afc7ded1e7e644c593d2d805ec6a6c9f","3d11fd5e91cf461ec0d86ac4bd3901612dc87f5c70f3e6d36a728dcc7a641fe4","aea94591d7531dbf3877ed30cdb5f571971d895c0b8e26b3236f8e8e6bce2f00","57f173d665d5baf9cb0fb78b2cd74e4b7e7ab739fb05a4435083355f59ced0ad","bae8d0eaea9d3f19265e744eedac4b69ca6eedb16af3926798f63e7f96631b14","782c53595699931192d2872912c1291fc40964560db0445e243161cf5f608660","d12608d0b83195ed4a338a74bf91d9d8fcff3d4ee8edcd36b54bd336a531c6f8","2e9ffd784c8bffb1bf9d00af6a13d88464cea1992b0593c5c7953334a8bc3548","47a4d1419279db684de48085bc9b9f616e07519d16ef2fb41a3ef89f23fde361","e8fcfb2dba3626634d9fc97197e20c6e23ec87329e8b91cd7432d8a943205d10","dfca1ef3fc7c788343f89944f27e3b55429741efa6af2064e1f881cb0a2fd015","a90f1e76e8dbe7d8b834b08d9d10a88a30d9f05e3bd60fc6e12e0d661fa45bd4"],"paragraph_range_zero_based":[21384,21407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p21384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21409},{"literal_text_all_w_t_and_m_t":"NonCellDefiningSSB field descriptions","paragraph_zero_based":21410},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":21411},{"literal_text_all_w_t_and_m_t":"Frequency of the NCD-SSB. The network configures this field so that the SSB is within the bandwidth of the BWP configured in BWP-DownlinkCommon.","paragraph_zero_based":21412},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":21413},{"literal_text_all_w_t_and_m_t":"The periodicity of this NCD-SSB. The network configures only periodicities that are larger than the periodicity of serving cell's CD-SSB. If the field is absent, the UE applies the SSB periodicity of the CD-SSB (ssb-periodicityServingCell configured in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":21414},{"literal_text_all_w_t_and_m_t":"ssb-TimeOffset","paragraph_zero_based":21415},{"literal_text_all_w_t_and_m_t":"The time offset between CD-SSB of the serving cell and this NCD-SSB. Value ms5 means the first burst of NCD-SSB is transmitted 5ms later than the first burst of CD-SSB transmitted after the first symbol of SFN=0 of the serving cell, value ms10 means the first burst of NCD-SSB is transmitted 10ms later than the first burst of CD-SSB transmitted after the first symbol in SFN=0 of the serving cell, and so on. If the field is absent, RedCap UE considers that the time offset between the first burst of CD-SSB transmitted in the serving cell and the first burst of this NCD-SSB transmitted is zero.","paragraph_zero_based":21416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21417},{"literal_text_all_w_t_and_m_t":"–NPN-Identity","paragraph_zero_based":21418},{"literal_text_all_w_t_and_m_t":"The IE NPN-Identity includes either a list of CAG-IDs or a list of NIDs per PLMN Identity. Further information regarding how to set the IE is specified in TS 23.003 [21].","paragraph_zero_based":21419},{"literal_text_all_w_t_and_m_t":"NPN-Identity information element","paragraph_zero_based":21420},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21421},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITY-START","paragraph_zero_based":21422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21423},{"literal_text_all_w_t_and_m_t":"NPN-Identity-r16 ::=             CHOICE {","paragraph_zero_based":21424},{"literal_text_all_w_t_and_m_t":"    pni-npn-r16                      SEQUENCE {","paragraph_zero_based":21425},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21426},{"literal_text_all_w_t_and_m_t":"        cag-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF CAG-IdentityInfo-r16","paragraph_zero_based":21427},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21428},{"literal_text_all_w_t_and_m_t":"    snpn-r16                         SEQUENCE {","paragraph_zero_based":21429},{"literal_text_all_w_t_and_m_t":"        plmn-Identity-r16                PLMN-Identity,","paragraph_zero_based":21430},{"literal_text_all_w_t_and_m_t":"        nid-List-r16                     SEQUENCE (SIZE (1..maxNPN-r16)) OF NID-r16","paragraph_zero_based":21431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["471438208de9241616bd4bff4099ce915b8638f65187d9d703bc0bd8b1e8cc5b","bfe8570ff7cc21