ocument_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["e848d24069ce8d0eecd033c5a42b827c4d26edf9b2674eb219724c8cf21b314f","fdb98a4d3fdb6fe8602492805972fcdf9b7e73e008134f7db6cfeff62796394b","b41dda6a9a8d43455f9051bc307a8a642683dcbc50845a2437470fa2109f7f70","acea39d8d8c5ecfc6bb09e76b9e246337f2e0f285affc645421a8aa72b2d1b73","206435cb7e75a8cccecfd93c6a061e43c188dba0c3fc1d1e1c494100da68b7f7","4a4ca2a95bc8a4f709f099720684f04ef74cac161f97af5c1e319a9c5d641c09","fdb98a4d3fdb6fe8602492805972fcdf9b7e73e008134f7db6cfeff62796394b","b41dda6a9a8d43455f9051bc307a8a642683dcbc50845a2437470fa2109f7f70","d562863f0dd88a2b9c00148f4966a61800f9134e757fd77f3f28357869253807","206435cb7e75a8cccecfd93c6a061e43c188dba0c3fc1d1e1c494100da68b7f7","70f0408f0bfbe07114a8e1bad232f8a2635b995efa9561658283d4262da2f098","ea30732bd1c2e330ae7ac458b16a61b6c46a2b2b176d46f0d2124120e458061e","0c90ead1d50b0eb53c3e83023388162a0c7b47e6443837578e887bb29af7acc4","86bb402a19c95a676ce229761cdcf9b67de96e5a1876e7f67dd086daa7dc7a45","8f4ac14b250734f09a243d4dff573d5f511d65dc233a5aaeb7861e19b32fd5dd","f3967979694aa87cc6bce635ada13cff56de3fa89be22ab566727f2694da7ce4","18ff51ab40b36a486c3094ab715e3fbcddb0eb59f51ff70bca05d15b88f6988b","4a1dec8fb14d8839f29475f947c5fa5712aa66a94b1eb8e92a98194197985a41","aece9f43dc861aa2d41b1a72eaa0f2829fcd73ed55c9ddcce31f1d854aabe4b4","ac0ec1406cda6d980df4fe1b8ea8d4e2a37fd6256c154c91b4dbb5f51069ac61","94676ff3ad221721391c2caafe42b175657ff418bc552d71bcba67378a39a42d","94aabb80a1dd03cc86eea245b3045401858d5ddd27f2b3f3a0f069756a0607e8","94676ff3ad221721391c2caafe42b175657ff418bc552d71bcba67378a39a42d","396aaee4897d9dd0b101565eba0457742161da3db22f7b05b042d4d9ab7a48bd"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation.