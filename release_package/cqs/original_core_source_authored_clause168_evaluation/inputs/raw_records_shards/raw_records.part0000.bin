{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–DMRS-UplinkConfig","paragraph_zero_based":17952},{"literal_text_all_w_t_and_m_t":"The IE DMRS-UplinkConfig is used to configure uplink demodulation reference signals for PUSCH.","paragraph_zero_based":17953},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig information element","paragraph_zero_based":17954},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17955},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-START","paragraph_zero_based":17956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17957},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig ::=               SEQUENCE {","paragraph_zero_based":17958},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                  OPTIONAL,   -- Need S","paragraph_zero_based":17959},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                       OPTIONAL,   -- Need S","paragraph_zero_based":17960},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":17961},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":17962},{"literal_text_all_w_t_and_m_t":"    transformPrecodingDisabled          SEQUENCE {","paragraph_zero_based":17963},{"literal_text_all_w_t_and_m_t":"        scramblingID0                       INTEGER (0..65535)                                              OPTIONAL,   -- Need S","paragraph_zero_based":17964},{"literal_text_all_w_t_and_m_t":"        scramblingID1                       INTEGER (0..65535)                                              OPTIONAL,   -- Need S","paragraph_zero_based":17965},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":17966},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":17967},{"literal_text_all_w_t_and_m_t":"        dmrs-Uplink-r16                     ENUMERATED {enabled}                                            OPTIONAL    -- Need R","paragraph_zero_based":17968},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":17969},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":17970},{"literal_text_all_w_t_and_m_t":"    transformPrecodingEnabled           SEQUENCE {","paragraph_zero_based":17971},{"literal_text_all_w_t_and_m_t":"        nPUSCH-Identity                     INTEGER(0..1007)                                                OPTIONAL,   -- Need S","paragraph_zero_based":17972},{"literal_text_all_w_t_and_m_t":"        sequenceGroupHopping                ENUMERATED {disabled}                                           OPTIONAL,   -- Need S","paragraph_zero_based":17973},{"literal_text_all_w_t_and_m_t":"        sequenceHopping                     ENUMERATED {enabled}                                            OPTIONAL,   -- Need S","paragraph_zero_based":17974},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":17975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["19333378c5e0d63d392a1358362ab50e7bd2ae9d44bd3ca5181a8b736aad34d1","8ce2ae61cabda75c61b1fa49b6362f9432251cfaaa