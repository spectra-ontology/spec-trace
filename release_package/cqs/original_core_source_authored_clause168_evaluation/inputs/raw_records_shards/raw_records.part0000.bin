{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17160},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfig","paragraph_zero_based":17161},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfig is used to configure a periodic or semi-persistent report sent on PUCCH on the cell in which the CSI-ReportConfig is included, or to configure a semi-persistent or aperiodic report sent on PUSCH triggered by DCI received on the cell in which the CSI-ReportConfig is included (in this case, the cell on which the report is sent is determined by the received DCI). See TS 38.214 [19], clause 5.2.1.","paragraph_zero_based":17162},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig information element","paragraph_zero_based":17163},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17164},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-START","paragraph_zero_based":17165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17166},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig ::=                SEQUENCE {","paragraph_zero_based":17167},{"literal_text_all_w_t_and_m_t":"    reportConfigId                          CSI-ReportConfigId,","paragraph_zero_based":17168},{"literal_text_all_w_t_and_m_t":"    carrier                                 ServCellIndex                   OPTIONAL,   -- Need S","paragraph_zero_based":17169},{"literal_text_all_w_t_and_m_t":"    resourcesForChannelMeasurement          CSI-ResourceConfigId,","paragraph_zero_based":17170},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference         CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":17171},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourcesForInterference     CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":17172},{"literal_text_all_w_t_and_m_t":"    reportConfigType                        CHOICE {","paragraph_zero_based":17173},{"literal_text_all_w_t_and_m_t":"        periodic                                SEQUENCE {","paragraph_zero_based":17174},{"literal_text_all_w_t_and_m_t":"            reportSlotConfig                        CSI-ReportPeriodicityAndOffset,","paragraph_zero_based":17175},{"literal_text_all_w_t_and_m_t":"            pucch-CSI-ResourceList                  SEQUENCE (SIZE (1..maxNrofBWPs)) OF PUCCH-CSI-Resource","paragraph_zero_based":17176},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":17177},{"literal_text_all_w_t_and_m_t":"        semiPersistentOnPUCCH                   SEQUENCE {","paragraph_zero_based":17178},{"literal_text_all_w_t_and_m_t":"            reportSlotConfig                        CSI-ReportPeriodicityAndOffset,","paragraph_zero_based":17179},{"literal_text_all_w_t_and_m_t":"            pucch-CSI-ResourceList                  SEQUENCE (SIZE (1..maxNrofBWPs)) OF PUCCH-CSI-Resource","paragraph_zero_based":17180},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":17181},{"literal_text_all_w_t_and_m_t":"        semiPersistentOnPUSCH                   SEQUENCE {","paragraph_zero_based":17182},{"literal_text_all_w_t_and_m_t":"            reportSlotConfig                        ENUMERATED {sl5, sl10, sl20, sl40, sl80, sl160, sl320},","paragraph_zero_based":17183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d04f34df8137aca5b1f22f92a6a49ec0bb2803e42510899fcb80dd8d969c9929","1855d2edc3c426c2d4fa97861cbab097cdc08c1d614ec02ec8a09d15cce664d5","f73aec41800f75ba495929d5d91dc9661fca96dbb4a90cf244475e8ef8c177c3"