{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":3072},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":3073},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":3074},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the RRCReestablishmentRequest message in accordance with 5.3.7.4;","paragraph_zero_based":3075},{"literal_text_all_w_t_and_m_t":"NOTE 2:This procedure applies also if the UE returns to the source PCell.","paragraph_zero_based":3076},{"literal_text_all_w_t_and_m_t":"Upon selecting an inter-RAT cell, the UE shall:","paragraph_zero_based":3077},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3078},{"literal_text_all_w_t_and_m_t":"5.3.7.3aActions following relay selection while T311 is running","paragraph_zero_based":3079},{"literal_text_all_w_t_and_m_t":"Upon selecting a suitable L2 U2N Relay UE, the L2 U2N Remote UE shall:","paragraph_zero_based":3080},{"literal_text_all_w_t_and_m_t":"1>indicate to upper layer to trigger the PC5 unicast link establishment with the selected L2 U2N Relay UE, if a new L2 U2N Relay UE is selected;","paragraph_zero_based":3081},{"literal_text_all_w_t_and_m_t":"1>ensure having valid and up to date essential system information as specified in clause 5.2.2.2;","paragraph_zero_based":3082},{"literal_text_all_w_t_and_m_t":"1>stop timer T311;","paragraph_zero_based":3083},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3084},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3085},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3086},{"literal_text_all_w_t_and_m_t":"1>stop the cell selection procedure, if ongoing;","paragraph_zero_based":3087},{"literal_text_all_w_t_and_m_t":"1>start timer T301;","paragraph_zero_based":3088},{"literal_text_all_w_t_and_m_t":"1>release the RLC entity for SRB0, if any;","paragraph_zero_based":3089},{"literal_text_all_w_t_and_m_t":"1>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":3090},{"literal_text_all_w_t_and_m_t":"1>apply the specified configuration of SL-RLC0 as specified in 9.1.1.4;","paragraph_zero_based":3091},{"literal_text_all_w_t_and_m_t":"1> apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":3092},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCReestablishmentRequest message in accordance with 5.3.7.4.","paragraph_zero_based":3093},{"literal_text_all_w_t_and_m_t":"5.3.7.4Actions related to transmission of RRCReestablishmentRequest message","paragraph_zero_based":3094},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCReestablishmentRequest message as follows:","paragraph_zero_based":3095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["0c967a0a9cccf7f1c4e3a33900d319982118be596fd0a3b2819e05cf82600642","7084486bc8e1fdc1ae1f4efeafbe4c28b2800ad473866e322be451be4b64fb72","86ffdb866ade9436f80712b6f3d9272ed980a11673c54161eaa2d22ba6c445e4","c1f46687ceabc8da480eb26ede33cbaf29af21e09087d103ffe60ee7525b427d","7c5bcf11eb3951b310b15b23b0dbb6e5a847530e0038b362ad96c13ca0091641","26868f3f7ed505ea987a49d0bb88cbcdde642b7db7cf0ba6bf0ba14eedb4ac76","d369ad77962a2b968956c87511485d3009f5e20abefc571cf3920fa8b1a99405","4422cfdb02220caa7259fe3c5365aab88240e0bd4afffe0006ebcccddcce4bd4","e1cdfa30a72c903fdc47674030a51960a69f48526677ccfd3000af06691ff4ca","42f68fbccab352a5b9a7cda8571dcd751b0b87203f812e432d5e996d58490072","83f99839780c6f84d22835c49872023b468b69a53a8f733f3e512158285235ee","cbede3bea958499441cbcc94a40e0cfa5b59ff2ad1e6a57bb701601fde4f8dca","0ff5f44db77341ac50f5663542eb944b8fd808f955ccd0c20f31e87e9c9aae60","79f9214c0a0a2554179ecef07e570174fd5eea02b9dfcdb140b43e5170066b25","49bb122c5462cb968cbbe0fbdbc3324e05d0b64e75d952c48e6abeea88e15e3b","cca4b2f3ec56a817c4af05956648e1b0a36683e05d380255224b5b0b7917a3b0","9f9a21c7d8051c3de0fad089e8a85d8da889ee6a8983005f0bfc5ee1b3eaf238","399abb809f116e51c77169700057bab2a8f5acd28147ad4ce0020a1f29911838","a4a3b71212ca143b5fe8c627b7d40c02d12b125aefed215a8f5f5ad852e409cd","21abe523520ae2a35491abc7004f1fe762b2dc70412b0d85a5122565fabf06a8","6109fd94f0ec46b426fda3553625f313c1ca7ffbfa242abf17c1a42555317197","7f1795118465e122fbffeeeb6718765f01696bb3e849eeae4751d72249f99469","d58bbcf29c0f2727f0323d1cc75ade6c415b8bff8411a4dea1e3455ddca8b65b","982e86fd707bf02bdf6025ba3dc33c44aac40d3b5d1f08cd5c63dd8442903030"],"paragraph_range_zero_based":[3072,3095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3072"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the procedure was initiated due to radio link failure as specified in 5.3.10.3 or reconfiguration with sync failure as specified in 5.3.5.8.3:","paragraph_zero_based":3096},{"literal_text_all_w_t_and_m_t":"2>set the reestablishmentCellId in the VarRLF-Report to the global cell identity of the selected cell;","paragraph_zero_based":3097},{"literal_text_all_w_t_and_m_t":"1>set the ue-Identity as follows:","paragraph_zero_based":3098},{"literal_text_all_w_t_and_m_t":"2>set the c-RNTI to the C-RNTI used in the source PCell (reconfiguration with sync or mobility from NR failure) or used in the PCell in which the trigger for the re-establishment occurred (other cases);","paragraph_zero_based":3099},{"literal_text_all_w_t_and_m_t":"2>set the physCellId to the physical cell identity of the source PCell (reconfiguration with sync or mobility from NR failure) or of the PCell in which the trigger for the re-establishment occurred (other cases);","paragraph_zero_based":3100},{"literal_text_all_w_t_and_m_t":"2>set the shortMAC-I to the 16 least significant bits of the MAC-I calculated:","paragraph_zero_based":3101},{"literal_text_all_w_t_and_m_t":"3>over the ASN.1 encoded as per clause 8 (i.e., a multiple of 8 bits) VarShortMAC-Input;","paragraph_zero_based":3102},{"literal_text_all_w_t_and_m_t":"3>with the KRRCint key and integrity protection algorithm that was used in the source PCell (reconfiguration with sync or mobility from NR failure) or of the PCell in which the trigger for the re-establishment occurred (other cases); and","paragraph_zero_based":3103},{"literal_text_all_w_t_and_m_t":"3>with all input bits for COUNT, BEARER and DIRECTION set to binary ones;","paragraph_zero_based":3104},{"literal_text_all_w_t_and_m_t":"1>set the reestablishmentCause as follows:","paragraph_zero_based":3105},{"literal_text_all_w_t_and_m_t":"2>if the re-establishment procedure was initiated due to reconfiguration failure as specified in 5.3.5.8.2:","paragraph_zero_based":3106},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value reconfigurationFailure;","paragraph_zero_based":3107},{"literal_text_all_w_t_and_m_t":"2>else if the re-establishment procedure was initiated due to reconfiguration with sync failure as specified in 5.3.5.8.3 (intra-NR handover failure) or 5.4.3.5 (inter-RAT mobility from NR failure):","paragraph_zero_based":3108},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value handoverFailure;","paragraph_zero_based":3109},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3110},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value otherFailure;","paragraph_zero_based":3111},{"literal_text_all_w_t_and_m_t":"1>re-establish PDCP for SRB1;","paragraph_zero_based":3112},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3113},{"literal_text_all_w_t_and_m_t":"2>establish or re-establish (e.g. via release and add) SL RLC entity for SRB1;","paragraph_zero_based":3114},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as defined in 9.2.4 for SRB1;","paragraph_zero_based":3115},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of PDCP as defined in 9.2.1 for SRB1;","paragraph_zero_based":3116},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SRAP as defined in 9.2.5 for SRB1;","paragraph_zero_based":3117},{"literal_text_all_w_t_and_m_t":"1> else:","paragraph_zero_based":3118},{"literal_text_all_w_t_and_m_t":"2>re-establish RLC for SRB1;","paragraph_zero_based":3119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["040b69b01c859c8c7df1447f811dafb9842f7656281573c4b465026cc11e6706","52fe7f92e4961281b74f721d5a9a966946334e60d5db4f93b43c616c432bc708","94f02f61fc9b48ebcb14ed540be4db2cff82f899268bb4a0708cd3d84857a05c","5d9189e5c620b0ebe259b3201427d3320de1bbfae8ad58e75d1475913da88b03","08f2b2dbf4df395f3b07b93b707fb692a7ca8aa305b5505b8561976f5873d802","e69209d5f7d351f5ff1577016731877316152805b96f2e9cea6193a10eb93082","63b103075c9854dae30980001d762c9f113823fa6ee308c162f92274c2b6ac49","58fe2af35b2253a91d2858ee9cba532316ae983659df3933a9759383991aaa08","e887ace73fda9b2dc3f58210f7433db5956822a7235be1598e9c5a61781f513e","2c35622e5add18f8bbc3ee7330abab6b5901f7677101d3399249c204cb18e254","055b24af92ea3fc23807d65df01f92f1b11dba5f40fcc27ac043f0e3b02e0513","dd83b891d5609d20b47be2dbad90c27da2481d38eccda85b249d1899124ebf01","5a93f1de7f3f4d95cdbc8151521dfd40ac3fa499646b2d451a99d3d573cd315c","0b86d6887fc5b40440cbd8658e00845d1b5ee3b8595cb3c8f0ab79581ad6af7c","d7146a5667dd3d1c3188dc603cbf0b0e8f51662bba27d271e469b688a250a6df","d8bd12c02303b44b82404d6e3a6d650ab64fbd81abf0371591f7602d4c26cad4","41ee2346d326c639d6c06b20d4358de3cc7a929dda801309154201b60823c20e","04a3c58be09904b183b4a149ca843ee50b6458c261671497fc6da73357a3d5db","616aabba69fcb2bf789529b01f2541430649fae8ba87541c22c2abffb5f8c6f3","b16aadca6c2d202d955ed91e928cee5e29cd23df6ed8fda1d0ca02951ec5a395","46e319287c9886eba11acbc77b34d1d2de815fecb386137d5ebbfe4532de2f75","a09146014121cbdd723986555c22bf10dedba977bbaeee59ccfaf6ffd212fc06","01771e1cecf989bcbc920729b8999abfbe14ea9ea59c5f0afce89835f4f54c36","26480468a08e7748387f8c4dad137de272aeb6686894d472564255a9dbd715b4"],"paragraph_range_zero_based":[3096,3119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3096"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>apply the default configuration defined in 9.2.1 for SRB1;","paragraph_zero_based":3120},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to suspend integrity protection and ciphering for SRB1;","paragraph_zero_based":3121},{"literal_text_all_w_t_and_m_t":"NOTE:Ciphering is not applied for the subsequent RRCReestablishment message used to resume the connection. An integrity check is performed by lower layers, but merely upon request from RRC.","paragraph_zero_based":3122},{"literal_text_all_w_t_and_m_t":"1>resume SRB1;","paragraph_zero_based":3123},{"literal_text_all_w_t_and_m_t":"1>if ta-Report is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":3124},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":3125},{"literal_text_all_w_t_and_m_t":"1>submit the RRCReestablishmentRequest message to lower layers for transmission.","paragraph_zero_based":3126},{"literal_text_all_w_t_and_m_t":"5.3.7.5Reception of the RRCReestablishment by the UE","paragraph_zero_based":3127},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3128},{"literal_text_all_w_t_and_m_t":"1>stop timer T301;","paragraph_zero_based":3129},{"literal_text_all_w_t_and_m_t":"1>consider the current cell to be the PCell;","paragraph_zero_based":3130},{"literal_text_all_w_t_and_m_t":"1>update the KgNB key based on the current KgNB key or the NH, using the received nextHopChainingCount value, as specified in TS 33.501 [11];","paragraph_zero_based":3131},{"literal_text_all_w_t_and_m_t":"1>store the nextHopChainingCount value indicated in the RRCReestablishment message;","paragraph_zero_based":3132},{"literal_text_all_w_t_and_m_t":"1>derive the KRRCenc and KUPenc keys associated with the previously configured cipheringAlgorithm, as specified in TS 33.501 [11];","paragraph_zero_based":3133},{"literal_text_all_w_t_and_m_t":"1>derive the KRRCint and KUPint keys associated with the previously configured integrityProtAlgorithm, as specified in TS 33.501 [11].","paragraph_zero_based":3134},{"literal_text_all_w_t_and_m_t":"1>request lower layers to verify the integrity protection of the RRCReestablishment message, using the previously configured algorithm and the KRRCint key;","paragraph_zero_based":3135},{"literal_text_all_w_t_and_m_t":"1>if the integrity protection check of the RRCReestablishment message fails:","paragraph_zero_based":3136},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure', upon which the procedure ends;","paragraph_zero_based":3137},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to resume integrity protection for SRB1 using the previously configured algorithm and the KRRCint key immediately, i.e., integrity protection shall be applied to all subsequent messages received and sent by the UE, including the message used to indicate the successful completion of the procedure;","paragraph_zero_based":3138},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to resume ciphering for SRB1 using the previously configured algorithm and, the KRRCenc key immediately, i.e., ciphering shall be applied to all subsequent messages received and sent by the UE, including the message used to indicate the successful completion of the procedure;","paragraph_zero_based":3139},{"literal_text_all_w_t_and_m_t":"1>release the measurement gap configuration indicated by the measGapConfig, if configured;","paragraph_zero_based":3140},{"literal_text_all_w_t_and_m_t":"1>release the MUSIM gap configuration indicated by the musim-GapConfig, if configured;","paragraph_zero_based":3141},{"literal_text_all_w_t_and_m_t":"1>release the FR2 UL gap configuration indicated by the ul-GapFR2-Config, if configured;","paragraph_zero_based":3142},{"literal_text_all_w_t_and_m_t":"1>perform the L2 U2N Remote UE configuration procedure in accordance with the received sl-L2RemoteUE-Config as specified in 5.3.5.16;","paragraph_zero_based":3143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f49a488b4ae60bb99b9f308a111dc7620803dff330a5cbd63a39a85425c5b7d0","32f071560ee0ae4071ded2f6d140a1a78712bc6e3d46f4042884757d02303f4f","0df3883fd00f3af103aa8774a617bc377ac25e07bffe225b3a44fa05ffc9890e","83d27e339a172b65b3c88c2bbdf0df4c58b5190a9911e9e5b7922a785fa9fbf0","073714b0aaf1a6c16d36728620cb1b7220ed4c925cf303db498e5f24b32cfef7","1296671f5abbb219c97428105083c982ea550384aec94ab19e64401257fa2b6c","1198754a77b841c088c9c87007a9f7478973ac9e9dcffd572edb308784b8a073","cb9c8626cdfd2b561fb284616780e8c863ca7b6577325b6bc6d4671f77ce2786","ca769454a8db02473d1d0ef85dfaaded625a1cb682fdb6eef86646cef459777e","7686bdd93329d551f84edb8784af6cb83c17e6c709deaf282960a9db4eae7107","c8fc476541c265510593716ae4f45c2fffd4b7cbe3a61151b83e75df143d6ee2","dee17598617337b85915c70edae45dcb9a5d128498cafe946ea1456fcf0b40fa","038004ac567f5909087d383f54413109089fe6d1e9d99bfa3bb215271e34931b","0397bed659b340a5b78948d0fc8cee2a96f3bfff3a3d2d815c4527418f0cc7c0","c340c96e11c8a57a01f404a7fddb8eff4c57613a530d17216c1b25a645bc053b","c25ea16694d7374a3caeee68caf3e3f7dd4f71dd1ab882129bfd3ae9ef6bff3c","38ad19f0f60405198865a3cc8f6b7a709b67288cd9a4964c697bf93184c20eea","ae65e413ec7ab4e78a60da632abd024065ddd8007cad0ac167660957fd4931a8","60aa8a5c082b8ece778c6b601bb7c0d4f11056b162d2a30b8012c7edae65d9ec","a04c0f40cb1a1479b9f23551bbb065ac95e42af6cdaa9c6cc139267e4e0db048","64b56789d2c4ed1629684798a1280be4b96da9a5d7b481e2fb6a8579238c9729","35180fbd76f0938bac6339bbd527408ca41fa8d7f6a817827c376de6a2699d6d","836d3663e4d8d8672f28802c8821368b0fa0426c5cf653c675221c9f034b6324","255a5dce0aebd59aa451e1a21b672aff6887637a3f3b08aebeabf5b6750b00c2"],"paragraph_range_zero_based":[3120,3143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3120"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>set the content of RRCReestablishmentComplete message as follows:","paragraph_zero_based":3144},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":3145},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3146},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3147},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCReestablishmentComplete message;","paragraph_zero_based":3148},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3149},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCReestablishmentComplete message;","paragraph_zero_based":3150},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included:","paragraph_zero_based":3151},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running and the logged measurements configuration is for NR:","paragraph_zero_based":3152},{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCReestablishmentComplete message;","paragraph_zero_based":3153},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3154},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements available for NR:","paragraph_zero_based":3155},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCReestablishmentComplete message;","paragraph_zero_based":3156},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":3157},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3158},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report; or","paragraph_zero_based":3159},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report of TS 36.331 [10] and if the UE is capable of cross-RAT RLF reporting and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]:","paragraph_zero_based":3160},{"literal_text_all_w_t_and_m_t":"3>include rlf-InfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3161},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful handover information available in VarSuccessHO-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessHO-Report:","paragraph_zero_based":3162},{"literal_text_all_w_t_and_m_t":"3>include successHO-InfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3163},{"literal_text_all_w_t_and_m_t":"1>submit the RRCReestablishmentComplete message to lower layers for transmission;","paragraph_zero_based":3164},{"literal_text_all_w_t_and_m_t":"1>if SIB21 is provided by the PCell:","paragraph_zero_based":3165},{"literal_text_all_w_t_and_m_t":"2>if the UE initiated transmission of an MBSInterestIndication message during the last 1 second preceding detection of radio link failure:","paragraph_zero_based":3166},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of an MBSInterestIndication message in accordance with 5.9.4;","paragraph_zero_based":3167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ea19d6cfadc0386fdb4b1141b82eaa588935f850671e684987641c483982283b","b32f9d97ad13165fad0fee0b6a184093835ee5c861e867dd830c36c4108008a9","7c1c1b995c7da1beab65c8e8b1f1b343c0e543f8177924d2236b3b36cbc10e5e","0464cf9086cac350e10d9f2db875b9d35891a76ab97fd7c5cd11f193cb26c840","a0d102dc0ddacffe5b7ccfb915f6913be1c356d92b6aef0517536ebd91711a99","adf893511660c471742fcb8eb860d37adf4547e374ff15f66fc28cc74324f51f","e0d33ea14765aa1e7c82474c76a8a97bdd4d5078c52f86e4f5bbc5861c9bcf62","029162eff637ef91f0e6fc141e8dd0e1523a75aa884d9bdfd6f4387698352cee","d96510c993bc81b3b5bb14507788d1e30976fd3873609ecf186b1cf0ffc82350","c62f6f817b0a49591dd6a72f021069f9b15219c819d808c24461307cfb79813a","1f26c016ad552f5d361007671de961451693c4a025ffc7c0a16c5372ff3969aa","6ffd5cebc68cb635dc034693aed412b9a10487931e93aaf538a90e4682f3c42a","3586045257d987f68b379f113b5f95ee49138cd732a394fabbaecdd2c6ca0b79","c3e0494d6fe51642dfbba3c641f3534abc96fa5ff6d5a45a8f4073952268e52a","637e1a1ccf2e1664e128e2f72686d156aba651b59c314212e5a21a340c8e9ee3","b07f6ded6d3de0be0f6e74ae2701971a8b72a7561a881c76fff9898a09ffdd79","835e502d42d675b55b2bf16e5431a100699a0b6823cc739d333363c9275241c4","62208273c94f913fd20a76cafdb55cbf4ab5dd5a8079f01704ebf53d0983f2dc","27f26b03449185610311f59fb65593c07e2e0180df4073b67881cfbb5d7a08fd","f4e4c3295f7c45f5e8174e10e0aca969b2dc3d88079c675fa42e75d69fccd227","1eff491a4abc62d8094f701d1699eb57ac1b4bf5a1547f3d25153354ee000e1c","20d40ac4d7851a3bc3fae5590a0feceac56dc91a318d5080e1e92a734332e46b","badd7f9c776ab15c63eff48259beba5571f4808d97a87e4773b6a83c70104d33","abb8074522b4840d7b15265f71c0ff5de0027e60216d2ab6fd70b4d6c7deba49"],"paragraph_range_zero_based":[3144,3167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3144"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>the procedure ends.","paragraph_zero_based":3168},{"literal_text_all_w_t_and_m_t":"5.3.7.6T311 expiry","paragraph_zero_based":3169},{"literal_text_all_w_t_and_m_t":"Upon T311 expiry, the UE shall:","paragraph_zero_based":3170},{"literal_text_all_w_t_and_m_t":"1>if the procedure was initiated due to radio link failure or handover failure:","paragraph_zero_based":3171},{"literal_text_all_w_t_and_m_t":"2>set the noSuitableCellFound in the VarRLF-Report to true;","paragraph_zero_based":3172},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3173},{"literal_text_all_w_t_and_m_t":"5.3.7.7T301 expiry or selected cell/L2 U2N Relay UE no longer suitable","paragraph_zero_based":3174},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3175},{"literal_text_all_w_t_and_m_t":"1>if timer T301 expires; or","paragraph_zero_based":3176},{"literal_text_all_w_t_and_m_t":"1>if the selected cell becomes no longer suitable according to the cell selection criteria as specified in TS 38.304 [20]; or","paragraph_zero_based":3177},{"literal_text_all_w_t_and_m_t":"1>if the (re)selected L2 U2N Relay UE becomes unsuitable; or","paragraph_zero_based":3178},{"literal_text_all_w_t_and_m_t":"1>upon reception of NotificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection; or","paragraph_zero_based":3179},{"literal_text_all_w_t_and_m_t":"1>upon PC5 unicast link release indicated by upper layer at L2 U2N Remote UE:","paragraph_zero_based":3180},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3181},{"literal_text_all_w_t_and_m_t":"5.3.7.8Reception of the RRCSetup by the UE","paragraph_zero_based":3182},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3183},{"literal_text_all_w_t_and_m_t":"1>perform the RRC connection establishment procedure as specified in 5.3.3.4.","paragraph_zero_based":3184},{"literal_text_all_w_t_and_m_t":"5.3.8RRC connection release","paragraph_zero_based":3185},{"literal_text_all_w_t_and_m_t":"5.3.8.1General","paragraph_zero_based":3186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3187},{"literal_text_all_w_t_and_m_t":"Figure 5.3.8.1-1: RRC connection release, successful","paragraph_zero_based":3188},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is:","paragraph_zero_based":3189},{"literal_text_all_w_t_and_m_t":"-to release the RRC connection, which includes the release of the established radio bearers (except for broadcast MRBs), BH RLC channels, Uu Relay RLC channels, PC5 Relay RLC channels as well as all radio resources; or","paragraph_zero_based":3190},{"literal_text_all_w_t_and_m_t":"-to suspend the RRC connection only if SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, are setup, which includes the suspension of the established radio bearers (except for broadcast MRBs).","paragraph_zero_based":3191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8820285c4b4f5542cb69e51af18c8641a7087f6fc446981bc2ab2f763871fc0c","51b1846f3067f6a52d26207d254d6765506270d12b52cb06968b3559819eebed","a59deeced68bc9e84c6b2a7f9d464fa6a7af2b2ef33adfbb2854f49396baf12b","e6f46628c9faaa3f844e15fcc01970b988a5c0aadc931e59c7c7ecbc16ca115f","e3f2c880781953d8a2f4e2f43c5cbea9691e4e87cf916dc1d68c38e1aa88faa8","e0aa1e06ee15fb761d5a531156bd9295348af8f45251cb4c34c6a842596061e1","7b87d4626e0b1cd505ba1c7c2f8aa70027e0f456203c7854983479cb5dc2f468","d2243401fee70eb4bfb068320d2d051ba26f676aa1158ccf79699e5615604bbc","30da726147b279d673e0061436c36067fa4c108144925fb75c6cd7f758ccf16a","ef2742d186378c2cdca8b9e62a338732de4d7fa6b87ae4bb63d4a9e6b24d23c3","e73f3899ad5ff2dbec7acd4b70ccf479a3bc16104cb08bf15166eeb9435320d2","28387c37c9fa2408addb54ad1e20cb688cd9877cf508ee65af1c2d82d12dda14","2eb6df2e382af67362d88b5b6c6bcb2801dac6413775176daac05afbf2bd4628","c58fc193746e5a99939c2d5ffb7adf217bd332390039f09ea65782186eadd1fd","3c95e8951f4fafae4ca0a9a106ef89fd58eeb7fe8652845b2cdefcc7b712a9b9","fbe1544aad7354fd4cae0e47ba32248eebb3520af95775c60cfee1680c5b93db","cf71f0dd5405680db8489512a0d9101a669a6d13d5e0ccd2421241aff6b2719f","99ac695d12cacc2f15f70727a4c8df7cd5c364457516dac69f09b2a9cddd515b","34b013da036a87f4a69fce143fe9a6c399590ec94a6d6d50242ae9282f8e55a7","5df2d213fd6e59d702dd1b6c3e0f243ce6e593f4d541fc1e332ffd00f436ff18","dd0590493fe8ee2f077af66f32b25e642365cec84c4abe6025a554b5069419e6","9837558883257e0fdc47aca4794a28b182d861cda7c4d6d84f9c14234113c273","3631a643231e57293e8b997e3bf49f7e52bf6a9eab8f49874f9a296f6000cf59","dbdabc59484268bd8c58ea35f1a9d077d731a5798893f79cf9c5dce28d166aeb"],"paragraph_range_zero_based":[3168,3191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3168"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.8.2Initiation","paragraph_zero_based":3192},{"literal_text_all_w_t_and_m_t":"The network initiates the RRC connection release procedure to transit a UE in RRC_CONNECTED to RRC_IDLE; or to transit a UE in RRC_CONNECTED to RRC_INACTIVE only if SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, is setup in RRC_CONNECTED; or to transit a UE in RRC_INACTIVE back to RRC_INACTIVE when the UE tries to resume (for resuming a suspended RRC connection or for initiating SDT); or to transit a UE in RRC_INACTIVE to RRC_IDLE when the UE tries to resume (for resuming of a suspended RRC connection or for initiating SDT). The procedure can also be used to release and redirect a UE to another frequency.","paragraph_zero_based":3193},{"literal_text_all_w_t_and_m_t":"5.3.8.3Reception of the RRCRelease by the UE","paragraph_zero_based":3194},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3195},{"literal_text_all_w_t_and_m_t":"1>delay the following actions defined in this clause 60 ms from the moment the RRCRelease message was received or optionally when lower layers indicate that the receipt of the RRCRelease message has been successfully acknowledged, whichever is earlier;","paragraph_zero_based":3196},{"literal_text_all_w_t_and_m_t":"1>stop timer T380, if running;","paragraph_zero_based":3197},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":3198},{"literal_text_all_w_t_and_m_t":"1>if timer T316 is running;","paragraph_zero_based":3199},{"literal_text_all_w_t_and_m_t":"2>stop timer T316;","paragraph_zero_based":3200},{"literal_text_all_w_t_and_m_t":"2>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":3201},{"literal_text_all_w_t_and_m_t":"1>stop timer T350, if running;","paragraph_zero_based":3202},{"literal_text_all_w_t_and_m_t":"1>stop timer T346g, if running;","paragraph_zero_based":3203},{"literal_text_all_w_t_and_m_t":"1>if the AS security is not activated:","paragraph_zero_based":3204},{"literal_text_all_w_t_and_m_t":"2>ignore any field included in RRCRelease message except waitTime;","paragraph_zero_based":3205},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with the release cause 'other' upon which the procedure ends;","paragraph_zero_based":3206},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes redirectedCarrierInfo indicating redirection to eutra:","paragraph_zero_based":3207},{"literal_text_all_w_t_and_m_t":"2>if cnType is included:","paragraph_zero_based":3208},{"literal_text_all_w_t_and_m_t":"3>after the cell selection, indicate the available CN Type(s) and the received cnType to upper layers;","paragraph_zero_based":3209},{"literal_text_all_w_t_and_m_t":"NOTE 1:Handling the case if the E-UTRA cell selected after the redirection does not support the core network type specified by the cnType, is up to UE implementation.","paragraph_zero_based":3210},{"literal_text_all_w_t_and_m_t":"2>if voiceFallbackIndication is included:","paragraph_zero_based":3211},{"literal_text_all_w_t_and_m_t":"3>consider the RRC connection release was for EPS fallback for IMS voice (see TS 23.502 [43]);","paragraph_zero_based":3212},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes the cellReselectionPriorities:","paragraph_zero_based":3213},{"literal_text_all_w_t_and_m_t":"2>store the cell reselection priority information provided by the cellReselectionPriorities;","paragraph_zero_based":3214},{"literal_text_all_w_t_and_m_t":"2>if the t320 is included:","paragraph_zero_based":3215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["74ef7d6d45fce6d13dcccb7b1de47af08f17a7004646e0ea8584bf2a2e176e1a","0fa64085464e424cdf1a067b45e8227b38fbc603b194e8a2a1edfee1f4ecbeae","256bb01c825b999ad5ee0a4a00f0cecf808ab6de63181c248e1955b04e1139b8","c25ad5a685c6a8136147801b13138942b46824e33bbd6d3ec4d4899d0561e11e","1f20eafa6e81f9274929f92f32c7f5528c12987cf352817d8dab8028d7395ed7","4e6c3f357e54795b3eccd4ca4988d66a92bc1596c21da6ed2209a839f4c7e2e3","f344f04b50e7daa53d9c390c3cc1613a53011ecaf5964ac669a93bc1ff664874","1db14cb6a6082fa55310f322e30d0c2ad79734f6a7557f2b3b035c128c0a6b0c","41e4442904b42c831892b021a1f3b943eec21ec3ff058db10a2d6f41861d1e24","134ddfe0a5a638d1c117ad10816b3cec1b99bb9ab6c0f4eeb16a0016158a5d10","900c17ff76119b08ceb9f9d39e691edcf89a41e0af9977705f9e54b4187616f5","2f70b13ecad447f52699f96d8c883e85f8435f8fcc9decc01ba2ab686ec239af","1086e16039442f99d8410454e8b91e7decef9ca1581b7aad934775a0aacc2d13","db91e7eb4bd07b0b142cff9058e233b4d6534ad72c1b8e9b37edb53693756613","58a15c451067df5e91fcf88d7566236cbaad447fed7bdcf123f71dd30657d548","4cfbafad3a6405f2fae0f8a7a4bc1a2d049378df2a546c45b1fbc2ba6a04050a","932258f36a6d5881304247ef27be0f886711f5a2c7a3baea3270d10b5e33c156","b70bcacdcd6e1cb855cab5eb68375adcab2125f65c1c8be6c9ef641e61c6b10c","f5ebf13683740b4bea8b55d5c1d0911f1343f7fa7364c9af0193c9330cb7890e","652bd4ff0afc897b4413f64fa086a3f0ad4b950477c47511f7f4e85dd76e5de9","3f6a3586368c89966e6d6a33a5634462232c042edd30baa8e3738b9e5a1a8a94","bfb1713462eb597fadbf0090e5a2569e44aefe1a993671f5fe8c675e714a4ab3","9cd2fc6dc244bc20c75f7e42f398677e00d7e4244decd102d768e49ac8699267","a606e99643f614d09e7cdb766cc8a69ce9dbf5dfe91a46677383ac96b918b6a5"],"paragraph_range_zero_based":[3192,3215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 3