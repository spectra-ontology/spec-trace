{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Troposphere Vertical Wet Static Delay Rate Error bound which is the mean value for an overbounding model that bounds the residual troposphere rate error in the vertical wet delay component.","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"The bound is meanTroposphereVerticalWetDelayRate + K * stdDevTroposphereVerticalWetDelayRate and shall be so that the probability of it to be exceeded shall be lower than IRallocation for irMinimum < IRallocation < irMaximum, where K = normInv(IRallocation / 2) and irMinimum, irMaximum as provided in IE GNSS-Integrity-ServiceParameters.","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"This IRallocation is a fraction of the Target Integrity Risk that represents the integrity risk budget available.","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"Scale factor 0.00005 m/s; range 0-0.01275 m/s.","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"stdDevTroposphereVerticalWetDelayRate","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"This field specifies the Standard Deviation Troposphere Vertical Wet Static Delay Rate Error bound which is the standard deviation for an overbounding model that bounds the residual troposphere rate error in the vertical wet delay component.","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"Scale factor 0.00005 m/s; range 0-0.01275 m/s.","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"Relationship between SSR troposphere quality and URA indicator and physical quantity","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"CLASS","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"VALUE","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"Index","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"SSR troposphere quality indicator","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"and","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"SSR URA","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"Q [mm]","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"7","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"7","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"63","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"5466.50<Q","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"7","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"6","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"62","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"4919.75<Q≤5466.50","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fb8ec76fc8fff2631a54eea3056fb58660493df02c08adfc8f87a29b6647ca9c","original_member_sha256":"c372cd2cebbb02ac4d53a8ac60ad70ed83b67917bcef75f23e4950c4d4dce8c5","paragraph_ElementTree_utf8_XML_sha256":["ecd533df8a82af8ff4dbd7b5431b5d317fc805ae6ad1183f637e7b1000e31475","5016717a4bc1eb1c88221d562b834d78e5ab73ce4fcd610ca6bca4326156c192","62e4bfb247412246b822267eaf112f307a053650b9312fc43729a1f3dc28fc24","b7d982be5a59f2c150ccca9b059adcd0ba5885f5649855817f24286f2deadc41","22743f2ebfd9536e93d4a395d74be76fac3df273cc16ffcc48241379dd8019d7","02cb4b7f260d4fb57ac05f4ac30c85993e74217fe23493d9a99f662f60e0d23c","347a11004af63ecdb1cfcaca6ce1168229128b8f87558d28fbeada423e714106","48919a892802af8f5de7f1655ee2d522e08195263602193e73c3374a6405adfe","29f7dff17d3f187dc269d119de8b0df460741ee2a5475d7d978bd01e0af3aec0","63d23ef3385b61e7ce8495bb7c83e3ecb72549666d25cd3bb277de599b4ecc05","0720667b0724c952f763fdaca0b898c6e95caa1657b461f155d43ee85becafb3","4f1bbe478f8d