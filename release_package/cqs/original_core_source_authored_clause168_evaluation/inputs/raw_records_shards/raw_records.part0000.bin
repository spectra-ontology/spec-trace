 dl-P0-PSBCH-r17         INTEGER (-202..24)                                                                  OPTIONAL     -- Need M","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-STOP","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"53da1889dc35904076dbb4e20cf7868c2a9a535cdb1b6c6c8b3ce10e10ca2a60","original_member_sha256":"1d1c7a562bc0a858dad014746765439744ed1921a2cf95aed6a29e33f202ddc7","paragraph_ElementTree_utf8_XML_sha256":["c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","e799ac63c6097954983e53d2a81ba6ce12bf35f84cbfbcb70fe33aeb4b09e4bf","6f29b6fb6760c97b52afb7428f6e8a71cf3fdc0c6ee480630459dd41c021fe00","6a808e923a1450a79a8028951e5e1534bea72d78db82ad9030244f1d4a8e7374","89c0d33dfd9f88c3e804570fc1ceb8706af5f8e5c60006771640373be570a170","ec9e551e82af52afbe71068b229d81d72bd8e9787b8e507abc408f563ca1b23d","ed487229fc74d1195b9c6d5b815bb00821d301cd6ec2c32a3de7699b61338845","ac3c8e1f63414c5c750e381ce9ad937fd871b8e44c91945037e180be087100e0","e14979161d856879a0be52d1f610838aac5fbc58885ed37395b7281a4cc68a67","782842985f7fe5bbee6a378caa105192ca365d8d4f8fd81c9f043bfbcd95bd4f","db8c435e125a9b793955a5c8443e8eb770e2ff62f2d418b4739ae344d9794b25","59c9b93e2150ab6f3e606fccfbc2e739559143b01e03e6efa9a44ab6082685d7","a5dd1aad8be8b849a202a94cf5c19af7489a85617d5fc2784adfcad102bc1acd","e10a17d8b54f1e8a9fcc1e2865b49dc5e09c5fd6adbaa8bcfa19bcece5f78bee","a04c2d4740bfd0f5b94dc20fa872155ae7eed20058c2686000ae40d70ec2ef85","bd97ea071defb188e998327b5aa8c115397995e700cc2a0fdfddc4c9006618de","7fbef40cd1a26ed1f7e82ed500a37d7a33c798479dea919ea4d7b2956ae1