{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9552},{"literal_text_all_w_t_and_m_t":"MeasResultList2EUTRA ::=          SEQUENCE (SIZE (1..maxFreq)) OF MeasResult2EUTRA-r16","paragraph_zero_based":9553},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9554},{"literal_text_all_w_t_and_m_t":"-- TAG-MCGFAILUREINFORMATION-STOP","paragraph_zero_based":9555},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9557},{"literal_text_all_w_t_and_m_t":"MCGFailureInformation field descriptions","paragraph_zero_based":9558},{"literal_text_all_w_t_and_m_t":"measResultFreqList","paragraph_zero_based":9559},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on NR frequencies the UE is configured to measure by the measConfig associated with the MCG.","paragraph_zero_based":9560},{"literal_text_all_w_t_and_m_t":"measResultFreqListEUTRA","paragraph_zero_based":9561},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on E-UTRA frequencies the UE is configured to measure by measConfig associated with the MCG.","paragraph_zero_based":9562},{"literal_text_all_w_t_and_m_t":"measResultFreqListUTRA-FDD","paragraph_zero_based":9563},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on UTRA FDD frequencies the UE is configured to measure by measConfig associated with the MCG.","paragraph_zero_based":9564},{"literal_text_all_w_t_and_m_t":"measResultSCG","paragraph_zero_based":9565},{"literal_text_all_w_t_and_m_t":"The field contains the MeasResultSCG-Failure IE which includes available measurement results on NR frequencies the UE is configured to measure by the measConfig associated with the SCG.","paragraph_zero_base