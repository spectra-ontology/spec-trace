:19235},{"literal_text_all_w_t_and_m_t":"    g-RNTI-ConfigToAddModList-r17       SEQUENCE (SIZE (1..maxG-RNTI-r17)) OF MBS-RNTI-SpecificConfig-r17       OPTIONAL,    -- Need N","paragraph_zero_based":19236},{"literal_text_all_w_t_and_m_t":"    g-RNTI-ConfigToReleaseList-r17      SEQUENCE (SIZE (1..maxG-RNTI-r17)) OF MBS-RNTI-SpecificConfigId-r17     OPTIONAL,    -- Need N","paragraph_zero_based":19237},{"literal_text_all_w_t_and_m_t":"    g-CS-RNTI-ConfigToAddModList-r17    SEQUENCE (SIZE (1..maxG-CS-RNTI-r17)) OF MBS-RNTI-SpecificConfig-r17    OPTIONAL,    -- Need N","paragraph_zero_based":19238},{"literal_text_all_w_t_and_m_t":"    g-CS-RNTI-ConfigToReleaseList-r17   SEQUENCE (SIZE (1..maxG-CS-RNTI-r17)) OF MBS-RNTI-SpecificConfigId-r17  OPTIONAL,    -- Need N","paragraph_zero_based":19239},{"literal_text_all_w_t_and_m_t":"    allowCSI-SRS-Tx-MulticastDRX-Active-r17   BOOLEAN                                                           OPTIONAL     -- Need M","paragraph_zero_based":19240},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19241},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19242},{"literal_text_all_w_t_and_m_t":"    schedulingRequestID-PosMG-Request-r17 SchedulingRequestId                                                   OPTIONAL,    -- Need R","paragraph_zero_based":19243},{"literal_text_all_w_t_and_m_t":"    drx-LastTransmissionUL-r17          ENUMERATED {enabled}                                                    OPTIONAL     -- Need R","paragraph_zero_based":19244},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19245},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19246},{"literal_text_all_w_t_and_m_t":"    posMG-Request-r17                   ENUMERATED {enabled}                                                    OPTIONAL     -- Need R","paragraph_zero_based":19247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_ce