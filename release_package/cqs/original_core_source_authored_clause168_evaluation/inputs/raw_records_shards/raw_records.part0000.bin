{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":12528},{"literal_text_all_w_t_and_m_t":"targetCellMeas","paragraph_zero_based":12529},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":12530},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":12531},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the initiation of the last conditional reconfiguration execution towards the target cell and the reception of the latest conditional reconfiguration for this target cell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":12532},{"literal_text_all_w_t_and_m_t":"upInterruptionTimeAtHO","paragraph_zero_based":12533},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the time of arrival of the last PDCP PDU received from the source cell for any data radio bearer and the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer, and it is measured at the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer. The field is set only in case of DAPS handover.Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":12534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12535},{"literal_text_all_w_t_and_m_t":"–UEPositioningAssistanceInfo","paragraph_zero_based":12536},{"literal_text_all_w_t_and_m_t":"The UEPositioningAssistanceInfo message is used to provide positioning assistance information as requested by the Network.","paragraph_zero_based":12537},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12538},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12539},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12540},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":12541},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo message","paragraph_zero_based":12542},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12543},{"literal_text_all_w_t_and_m_t":"-- TAG-UEPOSITIONINGASSISTANCEINFO-START","paragraph_zero_based":12544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12545},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo-r17 ::= SEQUENCE {","paragraph_zero_based":12546},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12547},{"literal_text_all_w_t_and_m_t":"        uePositioningAssistanceInfo-r17     UEPositioningAssistanceInfo-r17-IEs,","paragraph_zero_based":12548},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":12549},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12550},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["d81fb4aa8e4b6df3f2f77875eb682a9a9acda99bd6e75590d597a7830a9ef9f0","d081b98e896f5350fc5e8c101215bc1085ffed46319ddacb2eee2fd6ca827240","0dbcdd9d074d6ff17e98178f5296ca3770a97d421b386b232a0ebd9dd9d