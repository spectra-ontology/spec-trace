8","aeefc2b0dcaad895b047b9ddf819050bc4d55ee6f4f919558b7c493fb33f92e0","22f5d375476cf0a432215098b4f2282056ed0ad409d223c3f90cca20d4246dba","e2527351582e24d812778724cdf700aea2e4e92166fa737916fff2e948899a2d","4f8619a7999410ea211453d409d7cd85daf7fe90578fa9893fa8db60121f8a30","955eca1fde98197e02c1f6707f291056270783df2cc403957031f07a924affdc","0d6df5706f85384f2a7777faac6f1bf3600c2c76a79ec3d790b07a89a8f0681b","cdd82e157214d581294332bdae2986760eb55fbd00c36ee876836906832354c0","6a08e85749334937f827e3cb3b3270b71e146420073cdd72e80d9f1a7e662590","42e4b84efc93730ba7454aa91b4fffa437a7815953af8e732965d6db80f7d013","d25577fbc3c6a51e637d57f3aac0db9f8df5d3523bbbe825cd95485be322242b","70270c583aa36d04e250b962ff2c088a3820a7757caa00c2cc62d35a20bfa9ff","9ff4e8ebe20267c798c4636b839cbea0cf15e4f8676c7e32b391c3744b521eed","60ef0982def40885a55552250140f55711868b288ccf97cec414c50bfd5aa903","9d37aab98fd916feef7f6689a00a4bc90a38f8f0acddeff360adb8b526ea8b69","52f2299f518f3af0453ac22eb553094f422b9cb1e02f079cb91e884b347ab92f","6d74a9ac870ff9f298dfabfff51cd98d8c579f4dcc3bab693885c37463ae8c1b"],"paragraph_range_zero_based":[14088,14111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14088"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    indBitID-r17                               INTEGER (0..5),","paragraph_zero_based":14112},{"literal_text_all_w_t_and_m_t":"    nrofResources-r17                          ENUMERATED {n2, n4}","paragraph_zero_based":14113},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14115},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB17-STOP","paragraph_zero_based":14116},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14118},{"literal_text_all_w_t_and_m_t":"SIB17 field descriptions","paragraph_zero_based":14119},{"literal_text_all_w_t_and_m_t":"segmentContainer","paragraph_zero_based":14120},{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB17-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB17 is broadcast.","paragraph_zero_based":14121},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":14122},{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB17-IEs. A segment number of zero corresponds to the first segment, a segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":14123},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":14124},{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":14125},{"literal_text_all_w_t_and_m_t":"trs-ResourceSetConfig","paragraph_zero_based":14126},{"literal_text_all_w_t_and_m_t":"RS configuration of TRS occasion(s) for idle/inactive UE(s), in terms of a list of N>=1 NZP TRS resource set(s). The maximum number of TRS resource sets configured by higher layer is 64. If a TRS resource is configured, the L1 based availability indication is always enabled based on that configuration. A UE which acquired SIB17 with a TRS configuration but did not yet receive an associated L1-based availability indication considers the configured TRS as unavailable. If SIB scheduling indicates that SIB17 has changed, the UE considers its configured TRS(s) as unavailable until it receives the associated L1-based availability indication(s).","paragraph_zero_based":14127},{"literal_text_all_w_t_and_m_t":"validityDuration","paragraph_zero_based":14128},{"literal_text_all_w_t_and_m_t":"The valid time duration for L1 availability indication, time unit is one default paging cycle. When the field is absent, UE assumes a default time duration to be 2 default paging cycles. The field is only valid while the UE has a valid SIB17.","paragraph_zero_based":14129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14130},{"literal_text_all_w_t_and_m_t":"TRS-ResourceSet field descriptions","paragraph_zero_based":14131},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":14132},{"literal_text_all_w_t_and_m_t":"The index of the first OFDM symbol in the PRB used for TRS in a slot. The field indicates the first symbol in a slot for the first TRS resource within the slot, and the symbol for the second TRS resource in the same slot can be derived implicitly with symbol index as firstOFDMSymbolInTimeDomain+4.","paragraph_zero_based":14133},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":14134},{"literal_text_all_w_t_and_m_t":"Indicates the offset of the first RE to RE#0 in a RB in row1.","paragraph_zero_based":14135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["26b8a5544e0ccc0f380864ea5b0a5fcc1e235a39981916c150e85d157943a204","67df9d7c1205d3b540706d4a8faef8e3bec6f6cc95319cd31142ea801b75a577","d589436e02e03cb6d7aff54ffb7c831a2063b3d946694c96eab0d270b9bb1164","882227235c3a5b8d08234168289d187e41a3d28b76d40d0b9e8d74469752cb80","63ac9633da8371a5f11b557aa4bf7132cec14b93696afd76b4848fb90ba5e4cb","bdbd59cbc1c6d5c1d910b095368dedbfa52770eb123c918394d7169e888054e5","738fcec0d58396ce1be69fcdfacdac661f43cee84fb551980ad6f2f047d51639","cf1889575a4633f94ba6b238be2ab2bea014150316efa12a5c8752f39474c106","8abc38836d1f679aac186107da346ca4621efed08d395a4af308fbffb9bf6fb1","733ce771140c67e8bfb54d165f117d47b8fc47ef9b46fae027c3a06523f24ebd","68024014f8b55c25566a160f22a5f32334c32c71c4b586ffbdd4d962628db14a","19699d802a6ffb842d70f934fd3d595ff7537494add9ff07aed3da4adc810c86","38147929f7946b01a5e5ddfba57d576cc121253c6481c1c0cefac1c3db682ed2","4f518c642d82930cd6923ad2690582488ef0154e1527ce1fcfb2267505821656","dbf810a44eeca3d59623984e77cd7ded5cf1e811f9012fb24f005e7a5b2f56f5","9a42379be129b9aece3a0146b547e64dffa811f3255ad2c064c7ae889ace5cd8","91d382ef113b9aef735c06840ecec9493ec13a8aaed7560b27d874b1a35b35e3","eda0f564f7f81e81d08d12b6b4bd854b15c925de1854b81be99dc8717811f974","fca781c39f9ed21db5cc285f661c14a67ca843a6a1bfc97ea00de95de2040c2f","10fad6abc6eb46aedbfd20b4c1e46f1d128b9b3028700735adc58028f311f521","f0575ca4e74a719185b16fdcbb3f16f6ad6e440418a274a1ce27f933940496b2","4362c90dc3757d516c50d18c640690c3112f5ece95bd9c071dd84e440b575996","7be610f2f54c60084c14710b3df1850a9689b4358571883f20656e5f69e50f0d","b6e935f167d10acd089414a85ef95352e31fb7553c6ad95dccaea912a05ee13d"],"paragraph_range_zero_based":[14112,14135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14112"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"indBitID","paragraph_zero_based":14136},{"literal_text_all_w_t_and_m_t":"The index of the associated bit in TRS availability indication field in DCI. Each TRS resource set is configured with an ID i for the association with (i+1)-th indication bit in TRS availability indication field in DCI.","paragraph_zero_based":14137},{"literal_text_all_w_t_and_m_t":"nrofRBs","paragraph_zero_based":14138},{"literal_text_all_w_t_and_m_t":"Number of PRBs across which corresponding TRS resource spans.","paragraph_zero_based":14139},{"literal_text_all_w_t_and_m_t":"nrofResources","paragraph_zero_based":14140},{"literal_text_all_w_t_and_m_t":"The number of TRS resources for a TRS resource set.","paragraph_zero_based":14141},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":14142},{"literal_text_all_w_t_and_m_t":"The periodicity and slot offset (slot) for periodic TRS. It is used to determine the location of the first slot of TRS resource set. The periodicity value slots10 corresponds to 10 slots, value slots20 corresponds to 20 slots, and so on.","paragraph_zero_based":14143},{"literal_text_all_w_t_and_m_t":"powerControlOffsetSS","paragraph_zero_based":14144},{"literal_text_all_w_t_and_m_t":"Power offset (dB) of NZP CSI-RS RE to SSS RE.","paragraph_zero_based":14145},{"literal_text_all_w_t_and_m_t":"scramblingID-Info","paragraph_zero_based":14146},{"literal_text_all_w_t_and_m_t":"One or more scrambling IDs are configured for a TRS resource set. If a common scrambling ID is configured, it applies to all the TRS resources within the TRS resource set. Otherwise, each TRS resource within the TRS resource set is provided with a scrambling ID. If the number of TRS resources for the TRS resource set is 2, scramblingIDperResourceListWith2-r17 is configured, while scramblingIDperResourceListWith4-r17 is configured for the case that the number of TRS resources for the TRS resource set is 4.","paragraph_zero_based":14147},{"literal_text_all_w_t_and_m_t":"ssb-Index","paragraph_zero_based":14148},{"literal_text_all_w_t_and_m_t":"The index of reference SSB with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":14149},{"literal_text_all_w_t_and_m_t":"startingRB","paragraph_zero_based":14150},{"literal_text_all_w_t_and_m_t":"The PRB index where corresponding TRS resource starts in relation to common resource block #0 (CRB#0) on the common resource block grid.","paragraph_zero_based":14151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14152},{"literal_text_all_w_t_and_m_t":"–SIB18","paragraph_zero_based":14153},{"literal_text_all_w_t_and_m_t":"SIB18 contains Group IDs for Network selection (GINs) to support access using credentials from a Credentials Holder or to support UE onboarding.","paragraph_zero_based":14154},{"literal_text_all_w_t_and_m_t":"SIB18 information element","paragraph_zero_based":14155},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14156},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB18-START","paragraph_zero_based":14157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14158},{"literal_text_all_w_t_and_m_t":"SIB18-r17 ::=               SEQUENCE {","paragraph_zero_based":14159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5ab060e31dc21235525ef56984cc9e4c0a5a689a5c92c4efc3b4208f918eab94","06cad32bfb36d6539085563bc21ffd8d8071b1b15b8e9fd74cab2318ce5d3c07","45f0cf8fa9ac57771887bab16cde804af6cdd0aeb19b9773f47b17acbf54f181","92ca73a2c2729bf85b9f50ad0f78a85c61ba670a33aa7e0fc0f87430eab94a29","22652f07a53f12ca7d224186c300ace44c366280c239902b3b3dec064e0cbe89","d3ad4b5eae5fb637a2917b920e9ef775b1066c4fa64a764ec1ec1321e7a1459c","830ecbc0fca6c167def9fe7013fa2f57106e4162b5611482737ea0da43228dde","c090ad3afe1f5f8f0a491127c4defa25a78dd29ca76bd8709cb2254a7fe977e4","d985d779d531df75db11e08b85176c2b45df8482ca15e7435c21d173f9302e33","89a39c7411a768969dbb6d82b73e99e1ef26a8ae26f6bd02882f8b9f087363c1","a3fefb5ab5201b835a427f9c37e6d34cf56cbaaef7b971ef1d2c813ab065294e","b3ef0cf8274e0e794330dffccf8402ccbbbf518ae2a8bb2092c3e84f3d4f96a5","6e0f5656d0c6aa62bae7215f27e2502328510257bf0e9cac970b989675b46ea0","88ccac04e2de0d28dd4ff172617cadd9c4750dd466e9fd4ae306cb6533dfe4cf","30cfe118379f8cf2546bf901b26c71ee75aea13fb9c8533eab911ac1d9198c25","51e77e549ff88ed50d4bd0f2c650c06bcf1ca0f0a1a9f1291d5d81227935bac2","cd1b520e715941f018e3d6809c8a0187a822bf19d4ebf9a9e9ec220d3246b400","4185abe94f87ee0c899887b3133318eb57c0c4c9740278c8bbf1f996363d6b2a","a40384a23cbf93a0a54e388b5f59dd9031f13eead82f991cf46d6f94d0df7f4b","0feac87889ac0e420b39f37951ace91bed94208627d06caac9c3a24472eea307","f00b7f0e7549d7ff8d7839887afa0700cf31e72cb0a202c4e18d51547433b077","c24aee46b35d5b031b34b06fb89807f515e4cf74fbfeda711accb26dc900e1c4","1ca799db958b81781bf4075c952834f8b95df69a51e4571a36b2bc164c7638eb","f9da3902f72aeee8600593ad2e7d21d6cebc340815abcf676d818669deaa12cb"],"paragraph_range_zero_based":[14136,14159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14136"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    gin-ElementList-r17         SEQUENCE (SIZE (1..maxGIN-r17)) OF GIN-Element-r17            OPTIONAL,   -- Need R","paragraph_zero_based":14160},{"literal_text_all_w_t_and_m_t":"    gins-PerSNPN-List-r17       SEQUENCE (SIZE (1..maxNPN-r16)) OF GINs-PerSNPN-r17           OPTIONAL,   -- Need S","paragraph_zero_based":14161},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                                  OPTIONAL,","paragraph_zero_based":14162},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14165},{"literal_text_all_w_t_and_m_t":"GIN-Element-r17 ::=         SEQUENCE {","paragraph_zero_based":14166},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r17           PLMN-Identity,","paragraph_zero_based":14167},{"literal_text_all_w_t_and_m_t":"    nid-List-r17                SEQUENCE (SIZE (1..maxGIN-r17)) OF NID-r16","paragraph_zero_based":14168},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14170},{"literal_text_all_w_t_and_m_t":"GINs-PerSNPN-r17 ::=        SEQUENCE {","paragraph_zero_based":14171},{"literal_text_all_w_t_and_m_t":"    supportedGINs-r17           BIT STRING (SIZE (1..maxGIN-r17))                             OPTIONAL   -- Need R","paragraph_zero_based":14172},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14173},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB18-STOP","paragraph_zero_based":14174},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14176},{"literal_text_all_w_t_and_m_t":"SIB18 field descriptions","paragraph_zero_based":14177},{"literal_text_all_w_t_and_m_t":"gin-ElementList","paragraph_zero_based":14178},{"literal_text_all_w_t_and_m_t":"The gin-ElementList contains one or more GIN elements. Each GIN element contains either one GIN, which is identified by a PLMN ID and a NID, or multiple GINs that share the same PLMN ID. The total number of GINs indicated does not exceed maxGIN-r17. The GIN index m is defined as d1+d2+…+d(n-1)+i for the GIN included in the n-th entry of the gin-ElementList and the i-th entry of its corresponding GIN-Element, where d(k) is the number of GIN index values used in the k-th gin-ElementList entry.","paragraph_zero_based":14179},{"literal_text_all_w_t_and_m_t":"gins-PerSNPN-List","paragraph_zero_based":14180},{"literal_text_all_w_t_and_m_t":"Indicates the supported GINs for each SNPN. The network includes the same number of entries as the number of SNPNs in snpn-AccessInfoList in provided in SIB1, and the n-th entry in this list corresponds to the n-th SNPN listed in snpn-AccessInfoList provided in SIB1. The network configures this field only if the cell broadcasts more than one SNPN in SIB1. If this field is absent, as in case of a single SNPN broadcasted in SIB1, the UE shall associate all GINs in gin-ElementList to that SNPN. ","paragraph_zero_based":14181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14182},{"literal_text_all_w_t_and_m_t":"GINs-PerSNPN field descriptions","paragraph_zero_based":14183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6f39d317b9a73c953072669222b787c8abe4d40673d2e813eb3cd2a5ff575e39","e867fdf9099aa22da1040608660765452a1ea3d45532d25093a014eb679dc15e","9e296acefaaeff8e2ff52c4505591fc79c9221779ea40628700cda754eb229c1","721bcdd2366c93e54a7b76decf3d462c73b2b92ee5a430f7fb550a3bb9dd867a","0bd97e86b9981bdfe525d678425c86a25254da9b79b563ee4a29d10d2b2fa605","978b2a91140c5701e79db09cbef3497254f4e26fe2b5be23ea91ee9b6034e414","bd9847c3d3e1cd9e40b1f0fa4ae6f4087747f53dd1af02d64d554ced12bf8131","91e4414810de09d88256a262675db9eb95e54e22025681f99c1f9f5b4d534919","659571680a16e44fd7e7ee2ada69ed14dbc19437a9577c20591e9d4d08cb919b","15559fa6da14322cb4011d8db6a295bfad405541a52b0ad46213ea0d8686ebb4","9cc54c52de73d45fa0aa4d0d722e774ca90fac9a1d269f65d8c11966900c09df","b0469b6cacb06fd1321cc89fbe389fdedae9eba19daac5093c0d4d003c023c71","6adfe1a43a79a3e6efe8da2b1732f0b1bf6f22e0aefca74a883506925e617a23","65ac8b0e4ef9b6593601b18000ce934f86ac3e078159183df9bbf7bfd903293b","7d751bfc12242f1c64e03c6eac48c71ca9332413085233e958e7d0be5dfd12d1","cee77d12f17efffa93ff25eec31bc011a682343dacb894f348477b489eca22ef","4e4fb31c023b333b59e5eae735584e2e077c44ce6bd4a8e7e055e2230f03920d","7b1175637a85464e282ceefab6d719e73c8ccd1ba64dd4dd33905d2a8c1c0d13","a9fee6cf9702f19ebcf4d616da41f8cbbb379feb8d1535a8dedc236e4a1dfaaf","33efb40d3e91203552156bffa5c79798f7de244531190c767c3987ddd16c9fa9","34c2004b3a6920170ce32e9b6c0e0b9dd4f0ab593ec1e1200a76ec9fd02191e1","f4d1b05ef26f720e5b161dcaaac4c994b05b3cf4c5e78c511bf311df5e8df748","0b7e30f92344e8805fddbd51ce9c3964c1348b28221aa1cdd64b3bafe64e83de","ce9374cf2463d182353bcb27c9d31e4b38e2d71696d8c0728e91664662c4d5a9"],"paragraph_range_zero_based":[14160,14183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"supportedGINs","paragraph_zero_based":14184},{"literal_text_all_w_t_and_m_t":"Indicates the GINs which are supported by the given SNPN. The first/leftmost bit corresponds to the GIN with GIN index 1, the second bit corresponds to the GIN with GIN index 2 and so on. A bit set to 1 indicates that the GIN is supported by the SNPN. If the field is not present, then the corresponding SNPN does not support any GINs. ","paragraph_zero_based":14185},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14186},{"literal_text_all_w_t_and_m_t":"–SIB19","paragraph_zero_based":14187},{"literal_text_all_w_t_and_m_t":"SIB19 contains satellite assistance information for NTN access.","paragraph_zero_based":14188},{"literal_text_all_w_t_and_m_t":"SIB19 information element","paragraph_zero_based":14189},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14190},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB19-START","paragraph_zero_based":14191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14192},{"literal_text_all_w_t_and_m_t":"SIB19-r17 ::= SEQUENCE {","paragraph_zero_based":14193},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                           NTN-Config-r17                                  OPTIONAL,       -- Need R","paragraph_zero_based":14194},{"literal_text_all_w_t_and_m_t":"    t-Service-r17                            INTEGER (0..549755813887)                       OPTIONAL,       -- Need R","paragraph_zero_based":14195},{"literal_text_all_w_t_and_m_t":"    referenceLocation-r17                    ReferenceLocation-r17                           OPTIONAL,       -- Need R","paragraph_zero_based":14196},{"literal_text_all_w_t_and_m_t":"    distanceThresh-r17                       INTEGER(0..65525)                               OPTIONAL,       -- Need R","paragraph_zero_based":14197},{"literal_text_all_w_t_and_m_t":"    ntn-NeighCellConfigList-r17              NTN-NeighCellConfigList-r17                     OPTIONAL,       -- Need R","paragraph_zero_based":14198},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                 OCTET STRING                                    OPTIONAL,","paragraph_zero_based":14199},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":14200},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":14201},{"literal_text_all_w_t_and_m_t":"    ntn-NeighCellConfigListExt-v1720         NTN-NeighCellConfigList-r17                     OPTIONAL        -- Need R","paragraph_zero_based":14202},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":14203},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14205},{"literal_text_all_w_t_and_m_t":"NTN-NeighCellConfigList-r17 ::=          SEQUENCE (SIZE(1..maxCellNTN-r17))  OF NTN-NeighCellConfig-r17","paragraph_zero_based":14206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ecbbc759141c35d157f8ec6622317089c516ca810a5792fbd23588dbb2646646","959d45917506e4edce253a8e8dec61041d4edbffbbe9c3b47f179653df44caf4","e5c83b0f80b920837d4d78eecfa9f3eed00cfad5abac6ef5044315140eeb0244","8576a77470eff9de0736d891c2122e16e4489ad7c5b730827424b95292ac5e6d","fd763e13109defbdb4a9986c643ac58c0df3cea8f882a05ded118a42d5147ee4","6793411f7bfddf52cea3b91a8697643a33f1c2b6f789ac31886c4006d8d3e82d","cd1f3c38228fae0e7ad2688a9244990d7b3f979b50d0f40f3510b03ac7f1c96a","38955d581