{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1345},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1346},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1347},{"literal_text_all_w_t_and_m_t":"AzElFine","paragraph_zero_based":1348},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the angles where this IE is used are provided with 0.1 degrees resolution; otherwise it is not present.","paragraph_zero_based":1349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1350},{"literal_text_all_w_t_and_m_t":"LCS-GCS-TranslationParameter field descriptions","paragraph_zero_based":1351},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":1352},{"literal_text_all_w_t_and_m_t":"This field specifies the bearing angle α for the translation of the LCS to a GCS as defined in TR 38.901 [44].","paragraph_zero_based":1353},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":1354},{"literal_text_all_w_t_and_m_t":"alpha-fine","paragraph_zero_based":1355},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the alpha.","paragraph_zero_based":1356},{"literal_text_all_w_t_and_m_t":"The total bearing angle α is given by alpha + alpha-fine.","paragraph_zero_based":1357},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":1358},{"literal_text_all_w_t_and_m_t":"beta","paragraph_zero_based":1359},{"literal_text_all_w_t_and_m_t":"This field specifies the downtilt angle β for the translation of the LCS to a GCS as defined in TR 38.901 [44].","paragraph_zero_based":1360},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":1361},{"literal_text_all_w_t_and_m_t":"beta-fine","paragraph_zero_based":1362},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the beta.","paragraph_zero_based":1363},{"literal_text_all_w_t_and_m_t":"The total downtilt angle β is given by beta + beta-fine.","paragraph_zero_based":1364},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"gamma","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"This field specifies the slant angle γ for the translation of the LCS to a GCS as defined in TR 38.901 [44].","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["4e4134cbdbad66e95839e9fdde135fa1a2b465b9ed20a362c38fef7819d77b33","c1b58a68272920177888802a5f08628ba710206c7a87eba79d53ac97457fb40b","72a6a3ac7ddb187c28e7ab7f123696c58d830b1223a2c59b4f31760582185de5","2c4221e3aee97238f6e705e3a9d8cee7502f8ef9af14a022fc9cc26d9d7804d6","48e575327b81ad6dcb3bba09907a7a421ac9ab2d770d97f0a3c57651f8e68cd8","6773954bfe6c79d9cd08a143880bcc7ac833be673384860e78399ae17e827210","0d434212b411935eaa0d5e428b4d347ead6bd4e9520cc71559b88b72f78199bc","8dca9c58f905ee8b3922c542150699a91f5de620a70bbe307d730daa46420d2a","5a494a35b6b45df7f7daab54aae661e961d7c43bc7ef0040ad1b5a7d0285a9aa","d1ddd0e32a48574b96e2245c22d36a3c35185076f353452bd42d2c074bbb0e96","d7c0184a278870c1af034c3b708415b75ec2d78735d70b3c7a6cfdf05a2c07b7","cc5a19dd937f3250adaed012651fd98fdc02b2eaf81d48d9547122026f7f9eef","b6020cc6984a9e7a765c4717ed30d0cb57880914b9d91760dab52ff1bf719f4f","56d33c22ffc53476975459a46c6e5d356f28d93c4b82f145b21ca2d3