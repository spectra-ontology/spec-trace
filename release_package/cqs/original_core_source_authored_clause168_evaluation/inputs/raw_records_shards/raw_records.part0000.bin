{"fields":{"filename":"R2-2301433.zip::R2-2301433 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Adding GNSS Types in GNSS-SSR-OrbitCorrections to clarify SSR clock correction signal reference and clarification of GNSS Troposperic Delay Correction","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Ericsson","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"NR_pos-Core","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2023-02-17","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"