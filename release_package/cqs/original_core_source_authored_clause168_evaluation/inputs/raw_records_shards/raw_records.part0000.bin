{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: inclination i, see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18432},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18433},{"literal_text_all_w_t_and_m_t":"longitude","paragraph_zero_based":18434},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: longitude of ascending node , see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18435},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18436},{"literal_text_all_w_t_and_m_t":"meanAnomaly","paragraph_zero_based":18437},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: Mean anomaly M at epoch time, see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18438},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18439},{"literal_text_all_w_t_and_m_t":"periapsis","paragraph_zero_based":18440},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: argument of periapsis , see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":18441},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":18442},{"literal_text_all_w_t_and_m_t":"positionX, positionY, positionZ","paragraph_zero_based":18443},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite position state vector in ECEF. Unit is meter.","paragraph_zero_based":18444},{"literal_text_all_w_t_and_m_t":"Step of 1.3 m. Actual value = field value * 1.3.","paragraph_zero_based":18445},{"literal_text_all_w_t_and_m_t":"semiMajorAxis","paragraph_zero_based":18446},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: semi major axis , see NIMA TR 8350.2 [71]. Unit is meter.","paragraph_zero_based":18447},{"literal_text_all_w_t_and_m_t":"Step of 4.249 * 10-3 m. Actual value = 6500000 + field value * (4.249 * 10-3).","paragraph_zero_based":18448},{"literal_text_all_w_t_and_m_t":"velocityVX, velocityVY, velocityVZ","paragraph_zero_based":18449},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite velocity state vector in ECEF. Unit is meter/second.","paragraph_zero_based":18450},{"literal_text_all_w_t_and_m_t":"Step of 0.06 m/s. Actual value = field value * 0.06.","paragraph_zero_based":18451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18452},{"literal_text_all_w_t_and_m_t":"–FeatureCombination","paragraph_zero_based":18453},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombination indicates a feature or a combination of features to be associated with a set of Random Access resources (i.e. an instance of FeatureCombinationPreambles).","paragraph_zero_based":18454},{"literal_text_all_w_t_and_m_t":"FeatureCombination information element","paragraph_zero_based":18455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fff1a06a6b39d27021ee6537307f600ccaa967d97a11df561baa9e673c67f2fa","53d8f114607564b313a46b639a4bf4ae20287567f1aa71a14dfe1203690f9547","275f5aa1d7838570a32bfbe23d87e6eb424994f82e4ee92383765b3c3a03c94a","185d9c6f78be3530fddac58040cd8dc8d251b772ae66a92463a8619f1d6945b9","fb354594987f56c1663c7fd860f75bcb6fb0c25ff57d9ce3672c2871f9bdae9b","637573e206ba3a86c00122335257f1705b96d67ebad5d8c7825ba0e565d0297f","1a8091203995b135b8413a8f4e521e15b469c5787afafd78daca015a30542d79","da6adc36f9d9e5611cd18ce4