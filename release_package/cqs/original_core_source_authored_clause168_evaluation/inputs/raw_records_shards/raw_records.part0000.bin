{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    mbsfn-SubframeConfigList            EUTRA-MBSFN-SubframeConfigList                                          OPTIONAL,   -- Need M","paragraph_zero_based":25608},{"literal_text_all_w_t_and_m_t":"    nrofCRS-Ports                       ENUMERATED {n1, n2, n4},","paragraph_zero_based":25609},{"literal_text_all_w_t_and_m_t":"    v-Shift                             ENUMERATED {n0, n1, n2, n3, n4, n5}","paragraph_zero_based":25610},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25612},{"literal_text_all_w_t_and_m_t":"LTE-CRS-PatternList-r16 ::=         SEQUENCE (SIZE (1..maxLTE-CRS-Patterns-r16)) OF RateMatchPatternLTE-CRS","paragraph_zero_based":25613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25614},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-STOP","paragraph_zero_based":25615},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25616},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25618},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS field descriptions","paragraph_zero_based":25619},{"literal_text_all_w_t_and_m_t":"carrierBandwidthDL","paragraph_zero_based":25620},{"literal_text_all_w_t_and_m_t":"BW of the LTE carrier in number of PRBs (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25621},{"literal_text_all_w_t_and_m_t":"carrierFreqDL","paragraph_zero_based":25622},{"literal_text_all_w_t_and_m_t":"Center of the LTE carrier (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25623},{"literal_text_all_w_t_and_m_t":"mbsfn-SubframeConfigList","paragraph_zero_based":25624},{"literal_text_all_w_t_and_m_t":"LTE MBSFN subframe configuration (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25625},{"literal_text_all_w_t_and_m_t":"nrofCRS-Ports","paragraph_zero_based":25626},{"literal_text_all_w_t_and_m_t":"Number of LTE CRS antenna port to rate-match around (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25627},{"literal_text_all_w_t_and_m_t":"v-Shift","paragraph_zero_based":25628},{"literal_text_all_w_t_and_m_t":"Shifting value v-shift in LTE to rate match around LTE CRS (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":25629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25630},{"literal_text_all_w_t_and_m_t":"–ReferenceLocation","paragraph_zero_based":25631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f08b425a5685cf174344aecbd4da2bc67c9e6cc8dcd1b6247dc99daac6d793b","6205e393e64a69a97d14728f3a5c3b13b28aa69e89df5721ae8038d3d92ca039","aeeea41fa7fbd3952d26774b9757b074ada0961140261357e2c90faf9ce450ce","1f5824539598828e636d2836284bf61a6394d9da8e797c0818a4fe661439af25","7d7d295cec17fc3febe2773dc7bcdfd2466ecb7f52b3d8af20bf84eb90535f19","6c63950ca252f35abbc6c98c0c59b8a0219c88a047cd93a9b157b2a01438b60d","59066da49a8d2e69d1b6d1eabf0c92f2ba01cb673ae7971ad7f657b94fe2c8cb","a36815e57b334764780e09201625a0c303ba3f82155cb91c3a63c24addb0c7f8","0671f3b51b6313579d6a22ddd16481daa1e462dd230e4b013a630a5559b2ceaa","1afcd0204473918964412919d374028f7fd792fdd677eccfff614078fb5e55ce","cc2a8d5a6376dfb01e630f8d30201b94fd7c2336cb48432a94fade5f1ab9e461","f28fc37b63a3ce52ec679f3843cf94b9eb8f7f94e092fc913bdb6f68f1a4a833","eeeafe73d18f0f4d067cdba312e39ce0a6ef1cb1daf6f12c2a0969c9af31e596","3876184e3001dd279cf923ab0185b87a963d6ccbfa61e74d3699d1055f13e8fb","56be5515ed9ce14