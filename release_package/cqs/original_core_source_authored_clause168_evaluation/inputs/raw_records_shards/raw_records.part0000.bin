{"fields":{"filename":"R2-2311155.zip::R2-2311155.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"inDeviceCoexInd-r16","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports IDC (In-Device Coexistence) assistance information as specified in TS 38.331 [9].","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"maxBW-Preference-r16, maxBW-Preference-r17","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference of a cell group on the maximum aggregated bandwidth for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"Yes","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"(Incl FR2-2 DIFF)","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"maxCC-Preference-r16","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference of a cell group on the maximum number of secondary component carriers for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreference-r16, maxMIMO-LayerPreference-r17","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports providing its preference of a cell group on the maximum number of MIMO layers for power saving in RRC_CONNECTED, as specified in TS 38.331 [9].","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"UE","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"No","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d3539b88153eb1825c1ff8f900b2fee60bc28c01f14d3c311eac8eabe315c4d0","original_member_sha256":"4421de7f3746b536970f96e57e25fecf59510dc02ad23fdce959f0a78ff61a4c","paragraph_ElementTree_utf8_XML_sha256":["a4c42b2629d89911e4f656362177dda19fc33fb23460e10388cbae3b1d867ff5","17d0cb10adeed4af888c1b8784f76c0dafcc3d0d1f0e4cb4dbddf70f507ebe22","23b20fa0a04279a1aec28bb59b2ce08147913fa71bc22ea6fff6b8d7a4e9b206","1966399d05eaa6f8701cfc709e1169e781a86f08b5440b28431d99cabf2c9582","9ef792033630936c2e3016749b084a797640a89e3dbf126ca28293bb084973f0","f1a0025cf2b1b0ed55ed4a5de7d93f860947eb20f64012bd67263e7171891ada","b77b406a01ef535e2c9685197e592ae903cd149e0a988f004b38b28978e9b2a2","3875e255e2bec6d9eb6a32963ffbe5542be530bee1f62d9a9374a8aa9c9b1a2a","9e0cb66f5bb4831b7c169d655ee3afabff4574ffecc1ddc54ca1e05e695c0dec","76f62fd76db2393a572bb56d4ef04f178e05428be92fea49687be1a0c8a2aa6c","e0a2079fd4cf1f5ba65d5b70b3e01f0dcc68ac8c0800bda695f2dbd4434cf1c0","5615d59b0c90f5943027332b02f33e14adb16a73eb46592d334a038211841ce4","32540632cf22fb99898deb06a565f991bbaee5c500f2ea5f47af3489a951bb9b","e8ec849207c7960cde1b83a4912835dd24061da4d2812e16f051cd5f4afe2bdb","ca4bf7aa092b21658a4de9fbe7921b5804f664a4fbbd51ede0b83b5168bcc3cc","120fd9ddf3ad31ee2aa46bdbc1594088de360be3ca44ea0b258897ccb4027c0d","a614b8939b65d37f9ebe5d173ba8491eac42ea45758a3c2cdda01f817c629775","4