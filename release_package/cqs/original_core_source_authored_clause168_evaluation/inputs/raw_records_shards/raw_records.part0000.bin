{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23352},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-STOP","paragraph_zero_based":23353},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23355},{"literal_text_all_w_t_and_m_t":"–PRB-Id","paragraph_zero_based":23356},{"literal_text_all_w_t_and_m_t":"The IE PRB-Id identifies a Physical Resource Block (PRB) position within a carrier.","paragraph_zero_based":23357},{"literal_text_all_w_t_and_m_t":"PRB-Id information element","paragraph_zero_based":23358},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23359},{"literal_text_all_w_t_and_m_t":"-- TAG-PRB-ID-START","paragraph_zero_based":23360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23361},{"literal_text_all_w_t_and_m_t":"PRB-Id ::=                          INTEGER (0..maxNrofPhysicalResourceBlocks-1)","paragraph_zero_based":23362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23363},{"literal_text_all_w_t_and_m_t":"-- TAG-PRB-ID-STOP","paragraph_zero_based":23364},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23365},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23366},{"literal_text_all_w_t_and_m_t":"–PTRS-DownlinkConfig","paragraph_zero_based":23367},{"literal_text_all_w_t_and_m_t":"The IE PTRS-DownlinkConfig is used to configure downlink phase tracking reference signals (PTRS) (see TS 38.214 [19] clause 5.1.6.3)","paragraph_zero_based":23368},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig information element","paragraph_zero_based":23369},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23370},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-START","paragraph_zero_based":23371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23372},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig ::=             SEQUENCE {","paragraph_zero_based":23373},{"literal_text_all_w_t_and_m_t":"    frequencyDensity                    SEQUENCE (SIZE (2)) OF INTEGER (1..276)                                 OPTIONAL,   -- Need S","paragraph_zero_based":23374},{"literal_text_all_w_t_and_m_t":"    timeDensity                         SEQUENCE (SIZE (3)) OF INTEGER (0..29)                                  OPTIONAL,   -- Need S","paragraph_zero_based":23375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["26ff9697cec60167512f92f52d170773057c0f4db993a1a70b74a669d00614d0","98bff6e575c0adcdb285dc3317b0058073a1095e6fe91796c4568158f4fd9469","8b4c5495a13754ee67984bcc08cafa60fca269a5484e7660b4a010b48381c5eb","3416a6ad83c70882ed5f7b4fbd8bd74904674d9eb1060a5369b4f77e397335c3","617d7bed325d1f4e97f9fd129aecebe9e79276e7643bfb979ea8777577b4e246","d112eda0e33cb063e8c5a6605a0c96ec0cdf222f7248f2c2d8d48f614336b1a6","680923e0c3598100523e54d936188e1c94d216b206cf05292e951fc6d90b3562","505d9f70da9bda868755360d39a67d123381d54e4be369efbaf6fefe05fe2507","cc4dca6c2d90f6459ce4bf6ff7502b134d25ec71ec23c8d7c5023cb64ff85e15","2f441a094117d588af149cde985abf0c236550b5afb5a38603982cd0304cc201","6c74c6209a3daa1ad58d52a50e6c9650efae5a097fb90437d1c9203a4b8a8564","9094d9f12a8f5359cfaec9431e13fb6cf570b44685485a60c671aefeeb2ac10b","4cef601706e0ab0da447b586a1c4ac19e430958b280c99855f2f78c905e8086b","b73a43525481eb41b875f0ef7f3ca99e9cb85fcfb31414b953ed4a9e9e9b3bae","731eb254a7bfa1b6972789d6c50e5462150b4c599f0ead8ef0e6ead62104ee80","5a59db4374d94cdea3879ca94dc10b8108f6538a9612251baf3ea8e4ea556ca5","ee6f6120452e763f712c5b8456769792a23e8131080422e30c56c55ee8322e96","f4dff73fec2ad3c26b57d4be0a9d0a31e87fdac2f2fb222a9e15be133a36def0","26ae2348c03a1745d4d51dc4e2a540422abfc3c66b6b032f4631d5368a058441","48966e48571f8288c5afd07c1922cdaacb55a5e2990d1f2071096cf725bf1b02","3df3f5f0f6aac9d95ac71610d90a5292df159aaadc73f663e1f45f3559c3a456","51a57cddb40332fa001a7cb989fddbd873756716c5243f741af177ff7842eb05","a78a31661da1e10bbaf8a3547aa255e5ebb39fdbc6fe3e374c2783049f35b996","4394954aaaf15b3c9e6c9b10f89b9ffae5a5e5a39b6ab05f7b781461517f60a0"],"paragraph_range_zero_based":[23352,23375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23352"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    epre-Ratio                          INTEGER (0..3)                                                          OPTIONAL,   -- Need S","paragraph_zero_based":23376},{"literal_text_all_w_t_and_m_t":"    resourceElementOffset               ENUMERATED { offset01, offset10, offset11 }                             OPTIONAL,   -- Need S","paragraph_zero_based":23377},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23378},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23379},{"literal_text_all_w_t_and_m_t":"    maxNrofPorts-r16                    ENUMERATED {n1, n2}                                                     OPTIONAL    -- Need R","paragraph_zero_based":23380},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23382},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23384},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":23385},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23387},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig field descriptions","paragraph_zero_based":23388},{"literal_text_all_w_t_and_m_t":"epre-Ratio","paragraph_zero_based":23389},{"literal_text_all_w_t_and_m_t":"EPRE ratio between PTRS and PDSCH. Value 0 corresponds to the codepoint \"00\" in table 4.1-2. Value 1 corresponds to codepoint \"01\", and so on. If the field is not provided, the UE applies value 0 (see TS 38.214 [19], clause 4.1).","paragraph_zero_based":23390},{"literal_text_all_w_t_and_m_t":"frequencyDensity","paragraph_zero_based":23391},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of DL PT-RS as a function of Scheduled BW. If the field is absent, the UE uses K_PT-RS = 2 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-2).","paragraph_zero_based":23392},{"literal_text_all_w_t_and_m_t":"maxNrofPorts","paragraph_zero_based":23393},{"literal_text_all_w_t_and_m_t":"The maximum number of DL PTRS ports specified in TS 38.214 [19] (clause 5.1.6.3). 2 PT-RS ports can only be configured for a DL BWP that is configured, as specified in TS 38.214 [19] clause 5.1, with a mode where a single PDSCH has association between the DM-RS ports and the TCI states as defined in TS 38.214 [19] clause 5.1.6.2.","paragraph_zero_based":23394},{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":23395},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for DL PTRS. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 7.4.1.2.2).","paragraph_zero_based":23396},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":23397},{"literal_text_all_w_t_and_m_t":"Presence and time density of DL PT-RS as a function of MCS. The value 29 is only applicable for MCS Table 5.1.3.1-1 (TS 38.214 [19]). If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-1).","paragraph_zero_based":23398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["22ae4a7e6aa964ab0090b979c0be543e0263f91033f2be97fd69f893e671936a","5e429ebc33e7db45cacbed85b2043c285585e0514ea87a72392a9d86bf4ac970","90200ac3cb674fde5da1a4e54f3bcd6279f84eb349f86020b76b2514c240633b","9132dcc5863f4d318bfc