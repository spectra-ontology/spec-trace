{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–GNSS-GenericAssistDataReq","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"The IE GNSS-GenericAssistDataReq is used by the target device to request assistance data from a location server for one or more specific GNSSs. The specific GNSS for which the assistance data are requested is indicated by the IE GNSSID and (if applicable) by the IE SBASID. Assistance for up to 16 GNSSs can be requested.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"GNSS-GenericAssistDataReq ::= SEQUENCE (SIZE (1..16)) OF GNSS-GenericAssistDataReqElement","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"GNSS-GenericAssistDataReqElement ::= SEQUENCE {","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"gnss-IDGNSS-ID,","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"sbas-IDSBAS-IDOPTIONAL, -- Cond GNSS-ID-SBAS","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"gnss-TimeModelsReqGNSS-TimeModelListReqOPTIONAL, -- Cond TimeModReq","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"gnss-DifferentialCorrectionsReqGNSS-DifferentialCorrectionsReqOPTIONAL, -- Cond DGNSS-Req","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"gnss-NavigationModelReqGNSS-NavigationModelReqOPTIONAL, -- Cond NavModReq","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"gnss-RealTimeIntegrityReqGNSS-RealTimeIntegrityReqOPTIONAL, -- Cond RTIReq","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"gnss-DataBitAssistanceReqGNSS-DataBitAssistanceReqOPTIONAL, -- Cond DataBitsReq","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"gn