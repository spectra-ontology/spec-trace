{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    uplinkHARQ-mode-r17                     SetupRelease { UplinkHARQ-mode-r17}                     OPTIONAL    -- Need M","paragraph_zero_based":24480},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24481},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24483},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":24484},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":24485},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24486},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24487},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24488},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-0-2-r16 ::=           INTEGER (1..4)","paragraph_zero_based":24489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24490},{"literal_text_all_w_t_and_m_t":"UplinkHARQ-mode-r17 ::=                 BIT STRING (SIZE (32))","paragraph_zero_based":24491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24492},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":24493},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24495},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":24496},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":24497},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB (see TS 38.213 [13], clause 9.1).","paragraph_zero_based":24498},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24499},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig field descriptions","paragraph_zero_based":24500},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":24501},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":24502},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if the SCS of at least one UL BWP configured in the cell is 480 or 960 kHz.","paragraph_zero_based":24503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3fcd45c85a725680e7868691a808a45aaf1d2616588edccd0e98bce0a668b6a1","f23bcc2b2e125c7740230431809b3160d126f5c0735afeb1a86cd46d113fc1e0","62f079f06140bf37ce396aca5007ee8594826a1e5af023a26e614802e58acbfa","ee1627eff8753319ec7f1cd26a95c1db58b8edf37a38744d50f887b3dbea73aa","fcc9fd3aab762f5beb3c49f542b2a947abbedad0c245a51916644bd2d9cd193d","0efd8866b73c7b4944bed64797846fb6c15f251287c181066769d87d5137b9f5","ee682373e258b641660462586d6fd3b32aaff788c6f4a73085bf1133358e4123","6abb577dc495683d03f860c1ca62f2e1e33c6fbe3a63d2aa304f503aa890df1c","80427e685fded05f630688e0614c6c5c4b885def4f92739ea771a0a4b6bb8371","f4ac4369abd7de7988a49008632d829c98aa02aa6b287c0b7d90253e2be9ee8f","13d6281975a1c44ad9ab6e7d9fac8de61d9607e29d303ad2136fe457f918bc5f","a209b337dfbbae412a12f53c883c25b9921df5e8d207136b3897dc124c4bcb36","9184dc940a00aeaa2db30e7aade2a5cef8a6e7447ff92fa1f5bacc8fa235840e","b364f73f9b78e33605cd1eca5bd4bd45fe5fdf6bf9004d750a904d74ce4c241f","83955283e34c4d8473d6a217cb80a1d586f7d39fe93b0eb6d0826f7cb0831c27","f638e74b4c92ad58ffe168db2d9bec47bfe611d13e4f54215342832d6f506b9b","0356d7eb1ae564413bd1d1d91d2d226ec652e4aba2a89c66c49abc834ae658b2","a86a5aa3696ae1d4a6522a4cfff5bbda504abb68105ff00d78976d2eb39fd54a","11a5095c547af1bf9bcb35534d47cf14d84648467adf55407e8d3ba8f8dc6820","2cab041d8e4d72ab6e99a66bbd17014bd7b0066bd249ae1ba8137bcb218cf2c3","02832a24238369ff4c424a4ae553b6531f7f6de299a9bb08b6e044eff77febc0","dd43b29468b381841e37561a883bccfadbe5563edf774fd0d92569aa63d9ba69","b930c47f5bc9e93589c7ebb8c173a2946e5526a1ee9fa1db38e647b14b23a354","6fe7fa198831fd80236540814692bc08031040585e9ebb425f5b50ed5c95d587"],"paragraph_range_zero_based":[24480,24503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":24504},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRank to the same value. The field maxMIMO-Layers refers to DCI format 0_1.","paragraph_zero_based":24505},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPUSCH","paragraph_zero_based":24506},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PUSCH of a serving cell. Value n32 corresponds to 32 HARQ processes. If the field is absent, the UE uses 16 HARQ processes (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":24507},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":24508},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PUSCH (see 38.214 [19], clause 6.4).","paragraph_zero_based":24509},{"literal_text_all_w_t_and_m_t":"rateMatching","paragraph_zero_based":24510},{"literal_text_all_w_t_and_m_t":"Enables LBRM (Limited buffer rate-matching). When the field is absent the UE applies FBRM (Full buffer rate-matchingLBRM) (see TS 38.212 [17], clause 5.4.2).","paragraph_zero_based":24511},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":24512},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the value 'xoh0' (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":24513},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersDCI-0-2","paragraph_zero_based":24514},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH for DCI format 0_2 in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRankDCI-0-2 to the same value.","paragraph_zero_based":24515},{"literal_text_all_w_t_and_m_t":"uplinkHARQ-mode","paragraph_zero_based":24516},{"literal_text_all_w_t_and_m_t":"Used to set the HARQ mode per HARQ process ID, see TS 38.321 [3]. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. A bit set to one identifies a HARQ process with HARQmodeA and a bit set to zero identifies a HARQ process with HARQ modeB. This field applies for SRBs and DRBs.","paragraph_zero_based":24517},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24518},{"literal_text_all_w_t_and_m_t":"–PUSCH-TimeDomainResourceAllocationList","paragraph_zero_based":24519},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PUSCH. PUSCH-TimeDomainResourceAllocationList contains one or more of such PUSCH-TimeDomainResourceAllocations. The network indicates in the UL grant which of the configured time domain allocations the UE shall apply for that UL grant. The UE determines the bit width of the DCI field based on the number of entries in the PUSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":24520},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation information element","paragraph_zero_based":24521},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24522},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":24523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24524},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations)) OF PUSCH-TimeDomainResourceAllocation","paragraph_zero_based":24525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24526},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation ::=  SEQUENCE {","paragraph_zero_based":24527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["92e74f256eeab6f815fa3afb5c80583837495a0984b548ac05c92532cce8285b","a8c06c93cf2e74a027ac1e1c8cdf94f775d6c70999aff748479ebced41933a65","4ab05fe6b8d01c72ad798d26971f6e843934f5b4b71147d2e79a642726a846fd","da89837805b02541e04ce24d136532f879dcbe5b808b3ba41dace533b382c24f","555bf7ecb6eaafe94cd1fbcd9931a550f0f3039d99d157a6b43dd0ec2ee6a2f2","4c880068e14fce448ad72242890718c1437532c66009d45039f2d9838a26c332","39dd42f27c2351c53b445e2a1411d66da15f2c246d21cc90f9c2b72a5751e4eb","f14644ffe2cd1e0d520cb81886d21dba88b68cd9595790a5fded0754e5e0480a","f630c7c344977c2c8a72d289b96e1445893a29f0a0c94f7761c0fbdba069bbae","6022e2f101d845f6d3f2e3f3e30795990400ac155ae983fcf54e48121d431e7b","6d20e5189a6f47cdff0fc26b0bd660d611de43252ead8c8a931b4f2dd5649987","e07017f64e59144571fee794fb0bc86860d6425eddcc5556e0ad1103c1dd5371","0607b1bf6815b26b9559b6f6b1d1db416bebbfe6779a41f8b29e3427f9bedc26","16492a73508d3650d937afd1c347470d1f6d3cff687524822863358e62b89a2e","e85b5224090cf37c45e0cb0b06813fad2153739ca5b9b4abce488c122a360c7b","6a1d092f7e1426bbf7e069c26c9b743a8e0a4417428f3fa5105034025eaab77a","dcec812534fb1748ea893555e998572c2481e0403717274ef15984f4b301f41d","4f320cc37dbd587fe13b1073b04b04fa8977666585c0f36f3d11f4ca6b93fd8f","b4a95fa40e40d444a131291780f1ee823dde682186c03193adf2979e7ab83c0c","ce34ec14f51bdb18ecda6d21da38d442a076b32c10bce7ec7dbfc85f67f2509a","41e9b8acb9b2781e10c583923d3e140470a22f79a89ddf399d6e9fa5fb0