Configuration-r17-IEs,","paragraph_zero_based":9449},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture          SEQUENCE {}","paragraph_zero_based":9450},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9451},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9453},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration-r17-IEs ::= SEQUENCE {","paragraph_zero_based":9454},{"literal_text_all_w_t_and_m_t":"    mbs-SessionInfoList-r17               MBS-SessionInfoList-r17                                              OPTIONAL,   -- Need R","paragraph_zero_based":9455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3a3214278e54d00e3a478e68bc2e1404774e1737212a63efb7b73a5bdafd8a3b","38a999eebe99d8a50f9f9f35b2f8c9716fd9620c6aca3769f342f3df851f3453","ee9ed984eebb4558f4244efb1ad192653cafe7c0d9450bc1aceb7e27722a8e30","c7b1579a9170fb406dc5a7d5a81bbbf4e94d75ca08cb5a385715d47d7bbc5271","6da8de29df09d76344622171bed120ce5392ee7ae3c8127448a3676d26a4cbb6","17e21e02c4c234ad64208252742c5f3f4248c6413c29570ba4a02444c53fc88b","37d37d294260088d840a92eca7ff2fbe88b948b0baa7fc37d6dc927caf4a1a8f","dfb38d59636c93457ff84f2247ed38ccbb799004331771cbe8da5a8598a9384f","df76cc5b99a062a7bfc510b402e48b880fbf19f34e90cca413849991ee8db157","cb6d1462f21e78983d7ca393f05211667f86e3790f7bcee8efebdb14596695a6","c78f0618343ec9283cf527996d9e05e9ec59b56476368927db45b38ed72bca8e","25464fe4012e691ba6e0e8b91381c29baaa332a9fef079f391fd4a963e0543c7","564061ac074e24c3d68d1c6e4beaa459c467cbb23e93c9b717a2b457b8e4a8a7","6f2d0d883505807dad8a910b1e5e7a42e5e320c44f2a6a2c9f9b46c266da513d","48ecc37bc7db5c80189bf6b962e3ba3a