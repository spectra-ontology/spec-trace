{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29856},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-STOP","paragraph_zero_based":29857},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29859},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetList","paragraph_zero_based":29860},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetList provides a list of access control parameter sets. An access category can be configured with access parameters according to one of the sets.","paragraph_zero_based":29861},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList information element","paragraph_zero_based":29862},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29863},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-START","paragraph_zero_based":29864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29865},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList ::=          SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet","paragraph_zero_based":29866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29867},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList-v1700 ::= SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet-v1700","paragraph_zero_based":29868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29869},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet ::=              SEQUENCE {","paragraph_zero_based":29870},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactor                   ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40,","paragraph_zero_based":29871},{"literal_text_all_w_t_and_m_t":"                                                    p50, p60, p70, p75, p80, p85, p90, p95},","paragraph_zero_based":29872},{"literal_text_all_w_t_and_m_t":"    uac-BarringTime                     ENUMERATED {s4, s8, s16, s32, s64, s128, s256, s512},","paragraph_zero_based":29873},{"literal_text_all_w_t_and_m_t":"    uac-BarringForAccessIdentity        BIT STRING (SIZE(7))","paragraph_zero_based":29874},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29876},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet-v1700 ::= SEQUENCE {","paragraph_zero_based":29877},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactorForAI3-r17  ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40, p50, p60, p70, p75, p80, p85, p90, p95}","paragraph_zero_based":29878},{"literal_text_all_w_t_and_m_t":"                                                                       OPTIONAL  -- Need S","paragraph_zero_based":29879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02f5828721fd032432e8e28bf394ceddde30105300858b99c7657832a9f55013","03578311e6241eed221de1263a39c9bd9b1312c39f1134495bb7528536192381","d6176d74abbac1468f40d2976c61f2021aee85bbb79852a519eae737072f9525","fad5622626c2439ff53848f8948be23734a4fb8adbc5871c60e8a56a658b36e2","c7f9eb00a3963ed6e12e9117559b7f71d3d6edc3405e9b3af73404099b6ad426","ac5ae70dd7cd13358d4d7497a1b7c07cb5872eb5c79f06d07390383a9016e170","8b512e7e6e7f63e135dd693d48b620d4add6d7d05028cf38137e387dbc9c1ea8","17ea678e1706c47ed04093bbbba4ad0c5d9c369f197b130bfcddd92ac2003296","41be02033cea6cad80cfad2baafa6cea5370f29d86adfee153ad2f14600c3fae","3f445778b00dfcddfc73633df2117fc42281496b24bdf2cf133cdf117b59e1b3","b6ba2cd26c2fac1b64b0ad055b8f0ef972f97944e10066dcef06019076ff2701","ddc61b963f7362525ee1a7d13adff13c6352c04ce1482d7d50d92c22a54a61bb","d9f5ab2a2d55193f0802e7f6a1997bd211337ee12bc860554f3c7f51bc6c222c","6783dd0908fdc76818aa405164f759eb420a37f5943f8f9e43d39b4db9a3f785","7b29a63df3afcaa579223f83b482cc4448ac18e671b15b40693703de80d4b55c","e8af87a66a0ae1a790fb58c270122149cafa6b599880228d63237d65b8e09741","55ee06b8bb8eec2de795ff4424da0534e8a9e11e05d5133013e0cabe51d61095","b4828de507e72b03c7ac6b04a3f06def08f3167246c373b42cb23d7b5b4320a1","0913fefd6f714a13dd8e6196ae94fc30f2a72f83e4137bd5347a93b6278da164","9bbb12a4c8f5bddd42ee81b13857b88a0905ea48dd3b98ecb2c2e69da2722678","2d644007c213f049f21dd1dcff316228cdaa1699099cf94aaf6ff1e5d6f18514","7da10267ea21ee768a971973fe8cd9e0d84024c6398043201aacf7c09ef5400f","07e1181ee58ce8415568f8939c39a9c583f9a128bf089d2ec9dcee1864db08f9","0423ef3eff33d20f0fe37970c46895718e8753a24a40d98fb6100f4782c1f298"],"paragraph_range_zero_based":[29856,29879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29856"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29880},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29881},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-STOP","paragraph_zero_based":29882},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29884},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList field descriptions","paragraph_zero_based":29885},{"literal_text_all_w_t_and_m_t":"uac-BarringInfoSetList","paragraph_zero_based":29886},{"literal_text_all_w_t_and_m_t":"List of access control parameter sets. Each access category can be configured with access parameters corresponding to a particular set by uac-barringInfoSetIndex. Association of an access category with an index that has no corresponding entry in the uac-BarringInfoSetList is valid configuration and indicates no barring.","paragraph_zero_based":29887},{"literal_text_all_w_t_and_m_t":"uac-BarringForAccessIdentity","paragraph_zero_based":29888},{"literal_text_all_w_t_and_m_t":"Indicates whether access attempt is allowed for each Access Identity. The leftmost bit, bit 0 in the bit string corresponds to Access Identity 1, bit 1 in the bit string corresponds to Access Identity 2, bit 2 in the bit string corresponds to Access Identity 11, bit 3 in the bit string corresponds to Access Identity 12, bit 4 in the bit string corresponds to Access Identity 13, bit 5 in the bit string corresponds to Access Identity 14, and bit 6 in the bit string corresponds to Access Identity 15. Value 0 means that access attempt is allowed for the corresponding access identity.","paragraph_zero_based":29889},{"literal_text_all_w_t_and_m_t":"uac-BarringFactor","paragraph_zero_based":29890},{"literal_text_all_w_t_and_m_t":"Represents the probability that access attempt would be allowed during access barring check.","paragraph_zero_based":29891},{"literal_text_all_w_t_and_m_t":"uac-BarringFactorForAI3","paragraph_zero_based":29892},{"literal_text_all_w_t_and_m_t":"Barring factor applicable for Access Identity 3. Represents the probability that access attempt would be allowed during access barring check. If absent, the UE considers the access attempt as allowed.","paragraph_zero_based":29893},{"literal_text_all_w_t_and_m_t":"uac-BarringTime","paragraph_zero_based":29894},{"literal_text_all_w_t_and_m_t":"The average time in seconds before a new access attempt is to be performed after an access attempt was barred at access barring check for the same access category, see 5.3.14.5.","paragraph_zero_based":29895},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29896},{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerCatList","paragraph_zero_based":29897},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerCatList provides access control parameters for a list of access categories.","paragraph_zero_based":29898},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList information element","paragraph_zero_based":29899},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29900},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERCATLIST-START","paragraph_zero_based":29901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29902},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList ::=           SEQUENCE (SIZE (1..maxAccessCat-1)) OF UAC-BarringPerCat","paragraph_zero_based":29903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["63e447b867688f22226f9adc121943624c9eb9342365