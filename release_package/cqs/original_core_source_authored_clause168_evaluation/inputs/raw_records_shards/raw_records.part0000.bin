{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17833},{"literal_text_all_w_t_and_m_t":"-- TAG-DL-PPW-PRECONFIG-STOP","paragraph_zero_based":17834},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17836},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfig field descriptions","paragraph_zero_based":17837},{"literal_text_all_w_t_and_m_t":"dl-PPW-ID","paragraph_zero_based":17838},{"literal_text_all_w_t_and_m_t":"Indicates the pre-configured ID for DL-PRS processing window configuration.","paragraph_zero_based":17839},{"literal_text_all_w_t_and_m_t":"dl-PPW-PeriodicityAndStartSlot","paragraph_zero_based":17840},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in slots and the offset of the starting slot with respect to SFN #0 slot #0 of the serving cell where the DL-PRS processing window is configured.","paragraph_zero_based":17841},{"literal_text_all_w_t_and_m_t":"length","paragraph_zero_based":17842},{"literal_text_all_w_t_and_m_t":"Indicates the length of DL-PRS processing window in slots. Value 1 indicates length of one slot, value 2 indicates length of two slots and so on.","paragraph_zero_based":17843},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":17844},{"literal_text_all_w_t_and_m_t":"Indicates the priority between PDCCH/PDSCH/CSI-RS and PRS as specified in TS 38.214 [19].","paragraph_zero_based":17845},{"literal_text_all_w_t_and_m_t":"type","paragraph_zero_based":17846},{"literal_text_all_w_t_and_m_t":"Indicates the DL-PRS processing window type as specified in TS 38.214 [19].","paragraph_zero_based":17847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17848},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":17849},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":17850},{"literal_text_all_w_t_and_m_t":"MultiType","paragraph_zero_based":17851},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting multiple processing types, otherwise it is absent.","paragraph_zero_based":17852},{"literal_text_all_w_t_and_m_t":"MultiState","paragraph_zero_based":17853},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting option 1 or option 2 for the configured type, otherwise it is absent.","paragraph_zero_based":17854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e9757c88d57c3b821bbfeaa95c8a9cf53bf0daaea8f22375c1d890a167d49f36","d00800bf651bc64ef338fb958d52a3dda97e843c185b458948d234855a8e4b2a","bf25dc217dc29cb5352ed254fae61670e0b3cc6188c91c0c8f5527e733c36704","e472ed363548a2d1d91ec284c7029f06d83feb9f173eb5968cd225b3082bf941","2460aa5cf0bcc095f3d96881a8f3aeb9756c9cdd3cfd2e9a15b6d34cf06cf1fd","8b8108a0d6721a7c1d6a09f4f32fe3e5fe67782a3463ec1b1db173c8298df063","6aba7927258987553d3c23a66abdf5b49ecb978a8ab5bf5648b0b39c7ec7bb95","8fd24b2271a12d89986aed257da0224a54e827ed4d0905c49b5b976849ddfdc3","ab5e853598f7ef53721f52b2c184c7c7b472d1b128c1c48dea72e07fc4a4423d","13c307a4dfa1954ecd0818358e792e430449c33ff5e0aaccf2a2962a1110993f","19bb564944a0d2ee8240d3ac3c212a39d5e65d9bcf93326e105add305b60374e","8de2c9a64d1c009d871e63cbedd6e459d587247d30299d3f71f77fcdd6408cd0","f5424d7037608d8940948413bb6ef5169c0e8685d3669c4b9074d872597f02ce","cccf8ee75a3d9b647e12015d4598b2bb446b4010b338df3d6e8a51d079199ec7","2b89f8b86d153c0883935450f4210d45ce2a6b7f1d0abe73d4352b4988e0affe","cbcb02b99d21a581fdc18d74d42961542fd5f62b4dfb48831ba49bb5c4400339","f4c932aca6dd2e66787337b7072acfc3dd2b107b075ba05e8648dcecb3d58788","394f5bb0df36fb41e669da6d15abb93c298c96fc44a25cb47458e4357339cb0d","f283998d082e6b447a24cef4ef1b121df49245b5f3680a46ab91182c3252b8a6","0e6ded72c4110df8c14fbf59993efba9a22c0d397fd0ffd86750cee37f60861f","d8d2f2be6f53a207a9e9b87e699c54d013a1ad31c23d90512e42b12461c85f62","ce7af57edb79c7fe9b8e4e446f8f4f8695bcdc62d51744a2357fc552c8a43847","30a3b278b8e6c1604bd8fcd720cc143f82e51649618ca8777fd6dc1a1cbde40c","f512037a47a1a55c14c900a613ca29c9f376b2854eb3dcb16846dffa0b137a31"],"paragraph_range_zero_based":[17832,17855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p17832"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUCCH-Config","paragraph_zero_based":17856},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUCCH-Config-r17 is used to configure DMRS bundling for PUCCH.","paragraph_zero_based":17857},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config information element","paragraph_zero_based":17858},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17859},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-START","paragraph_zero_based":17860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17861},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config-r17 ::=         SEQUENCE {","paragraph_zero_based":17862},{"literal_text_all_w_t_and_m_t":"    pucch-DMRS-Bundling-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17863},{"literal_text_all_w_t_and_m_t":"    pucch-TimeDomainWindowLength-r17          INTEGER (2..8)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":17864},{"literal_text_all_w_t_and_m_t":"    pucch-WindowRestart-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17865},{"literal_text_all_w_t_and_m_t":"    pucch-FrequencyHoppingInterval-r17        ENUMERATED {s2, s4, s5, s10}                                    OPTIONAL,   -- Need S","paragraph_zero_based":17866},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17867},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17869},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-STOP","paragraph_zero_based":17870},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17872},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config field descriptions","paragraph_zero_based":17873},{"literal_text_all_w_t_and_m_t":"pucch-DMRS-Bundling","paragraph_zero_based":17874},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUCCH are jointly enabled.","paragraph_zero_based":17875},{"literal_text_all_w_t_and_m_t":"pucch-FrequencyHoppingInterval","paragraph_zero_based":17876},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUCCH. When both inter-frequency hopping and DMRS bundling are enabled for PUCCH repetitions, the UE is expected to be configured with at least one pucch-FrequencyHoppingInterval-r17 and pucch-TimeDomainWindowLength-r17. When DMRS bundling for PUCCH is enabled by pucch-DMRS-Bundling-r17, PUCCH frequency hopping interval is only determined by the configuration of PUCCH hopping interval if PUCCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUCCH frequency hopping is indicated by pucch-TimeDomainWindowLength-r17.","paragraph_zero_based":17877},{"literal_text_all_w_t_and_m_t":"pucch-TimeDomainWindowLength","paragraph_zero_based":17878},{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in slots for DMRS bundling for PUCCH. The value shall not exceed the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26]. If this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUCCH repetitions and the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26].","paragraph_zero_based":17879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["081e0986d7123b7f9a2eecf10d52f9c256c7f0b33b54014f7a707bdf64acf788","fa0f4504e1431a85334a37a34420f3422158c38c132f1638d3de3d5e40a31ed8","4bfb8fa6683cb700e44fb96d900677088d5249ce2926bfa17d7b073ec2700c4f","d7b65da2babb8836c03e78f0bbbb1b5cc0d6cd09725a380fa5559ef156f530ef","c879056d87776b60f4a4eb76eeeecf3eb2444adcb6d98546d02511aba10494b8","4e12506183fe09cde24fda02876a17dda6417c67f58c6448d38a2afde9273394","44490071a57809e8bc0e97d86456414d464dc95b28d6fd5a2c5459e90263b1c1","7ab590af9b88ff5ec48100bfb24d64620d2cb146b67620507537b182966a591d","bb5683bdb2dc16a64b254f357aa2ea9c838c877434b45e58f9083882c8f889e9","8b83043d97ef0ae21714b2b488c77b57306054e5cc9c6ab8556a1a4c4fff314e","05876089b5088ab1b52dca3ea0401c642e6b83e58ada8b52b5c743c492b5c4cc","afaa3dff19c4d0a780ac491a93e22ab6d2f8cbf056594d6ec256a80d7e868e74","0a41e754a5297280dc2c2767391d8ef98fd6ad53b974f60e6b89f25a3edff2f8","c0d12765b8b45930fcadba9588e2cbefae680abfd66e928abb6a617a2eaab802","db4cea7ccbd1b7496f99aa6c8ea53a00bcfbc0daa9ecc596b9fa4b544453a07a","2c62b25e51d4d03793cf1f70f1819b721e0f20e5ffa38e55191002bd8b49f37a","71b9e4ea177a26d8142e145e0912ede434f46a6edb5c2255ad52a62985312a68","77c8e9adc24d6c1921aa8633f859ab8c7ace91da22d6c12a49d8e0c06c389f4f","8d8b33e74f2a5d33d8b21a5fe396007d2fa4eae1056025e1ceb2843bcfe6cc21","5020824a3e13abf9d1a804627c471dbf3427a4dc77e0d47f1a1f35ffd120923d","499ef2fce7b47ce6653dbf71c2bc07e6027ad0eaed9bcc6f0610dc3ea6eff5dc","718ebf47879209aa330c71ae2839640b0a9ec78bb786a0b657c0d24e63134774","4bcd99d5e5bb0e43088235ae3f7c8371f5181f73aa9f750ed381a83e47247ee3","04cb396c740ec896ae9b2024dd3d59faf730ce50c081be84aeeff314292fbdc7"],"paragraph_range_zero_based":[17856,17879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p17856"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-WindowRestart","paragraph_zero_based":17880},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUCCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":17881},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":17882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17883},{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUSCH-Config","paragraph_zero_based":17884},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUSCH-Config-r17 is used to configure DMRS bundling for PUSCH.","paragraph_zero_based":17885},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config information element","paragraph_zero_based":17886},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17887},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-START","paragraph_zero_based":17888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17889},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config-r17 ::=          SEQUENCE {","paragraph_zero_based":17890},{"literal_text_all_w_t_and_m_t":"    pusch-DMRS-Bundling-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17891},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainWindowLength-r17           INTEGER (2..32)                                                 OPTIONAL,   -- Need S","paragraph_zero_based":17892},{"literal_text_all_w_t_and_m_t":"    pusch-WindowRestart-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":17893},{"literal_text_all_w_t_and_m_t":"    pusch-FrequencyHoppingInterval-r17         ENUMERATED {s2, s4, s5, s6, s8, s10, s12, s14, s16, s20}        OPTIONAL,   -- Need S","paragraph_zero_based":17894},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17895},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17897},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-STOP","paragraph_zero_based":17898},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17899},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17900},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config field descriptions","paragraph_zero_based":17901},{"literal_text_all_w_t_and_m_t":"pusch-DMRS-Bundling","paragraph_zero_based":17902},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUSCH are jointly enabled.","paragraph_zero_based":17903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["54bae8631c6cb55e7f5e6035416c37e2b8e125c4d953164dc74acb2e7997d71f","1a89ece5ffb66b9bc275c238057b3a76599227d8d6d534e864e83df22489a2b0","0fa5bb38f1c2762e2c7127f7fca36f9217a89ad15d7d83661e319c6723ab1f67","0992c600d0e96e923eedf3adb73326d2cd74245d370eab467f91466fec9cf8b9","8fc0ee8e631b34f1c3551b511d97f7bf57a624ea78e45291a2fa95b75c50e1b3","7f47f2ad8d8298aa1cc0d3509d835f700dfd52db6970b6e73c0b82f620da238d","c7e3e6b83bdf6937b953951cc4cba05fce4569b25ae793da8de1ef2c0a5a8617","b81534f01a3f670f551aa3e87be41f97014792c52bf28cc46b1f7beac9258466","64520fb84679f53685c984f9e841d1f6808bc9cb1031287980a5ca01fff9d3ac","e57efd46b59a421c6cb91e375b2ccad6066411b65b26f90944b7cdf36d98b018","fa126ca6b75d07063b87c904ef5027e8bab392c8e8af75954dbd2406549262fa","e786a781b61566d5707f38b1134541bdb01318974b9751083f654d92aae7a9dc","32abc3cbf66d81db206b6e7c9bf21b58c2f14ba58a9439def83e34ab54226192","16a7f592a2d69e401aed7f8a1a9fcccd5fb435e7add8477109c5073ec38d7e21","46a004c7a0eba8a0b3221e53bfcb8db03aba5875f441dd0d180f32ea4fa289fb","602afce1f41f6f0e1ab2a9948c10ab5e9796a240f6e43fa04433db9589b167ef","04bebcc10e277c530b25bbb311783413235c1bf70fa3f43bf80647b5fe4405e2","335c0db1d3d4e0a70b692c2e574b62d1744021149574da46c4483239ba9ca36a","4f3c2b91b93c7f4461d01cdd37ba206d4d1a52346b9aaa9195b86f0025fca337","5d88f8d50df358791dad3c7440f475acbb8ed090f52b6fa4c3adda023740b648","9fb2aa48c9b0dbb36f9b46c7ce132b34b614024a6add2585dbded28c7c53bdcd","6cdbcae7af69cb0ff101c222487ddf15c2eb254c0127d3fd3681943d5d0dd699","128730e3e2fd05ed77873ead76d1b99ab3dbcb74b98d2af9987e522518d3e8d6","1bcda90ed594f6ba96928cfa72184ef55f422aa80127db9921b3ef5e26171e3c"],"paragraph_range_zero_based":[17880,17903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p17880"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pusch-FrequencyHoppingInterval","paragraph_zero_based":17904},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUSCH. When both inter-frequency hopping and DMRS bundling are enabled for PUSCH repetitions, the UE is expected to be configured with at least one pusch-FrequencyHoppingInterval-r17 and pusch-TimeDomainWindowLength-r17. This parameter is shared for both DG-PUSCH and CG-PUSCH. When DMRS bundling for PUSCH is enabled by pusch-DMRS-Bundling-r17, PUSCH frequency hopping interval is only determined by the configuration of PUSCH hopping interval if PUSCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUSCH frequency hopping is indicated by pusch-TimeDomainWindowLength-r17.","paragraph_zero_based":17905},{"literal_text_all_w_t_and_m_t":"Note: For unpaired spectrum, the UE is not expected to be configured the value of s6, s8, s12, s14 and s16.","paragraph_zero_based":17906},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainWindowLength","paragraph_zero_based":17907},{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in number of consecutive slots for DMRS bundling for PUSCH. The value shall not exceed the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For PUSCH repetition type A/B, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUSCH repetitions and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For TBoMS, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the duration of TBoMS transmission (including repetition of TBoMS) and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26].","paragraph_zero_based":17908},{"literal_text_all_w_t_and_m_t":"pusch-WindowRestart","paragraph_zero_based":17909},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUSCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":17910},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":17911},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17912},{"literal_text_all_w_t_and_m_t":"–DMRS-DownlinkConfig","paragraph_zero_based":17913},{"literal_text_all_w_t_and_m_t":"The IE DMRS-DownlinkConfig is used to configure downlink demodulation reference signals for PDSCH.","paragraph_zero_based":17914},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig information element","paragraph_zero_based":17915},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17916},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-DOWNLINKCONFIG-START","paragraph_zero_based":17917},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17918},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig ::=             SEQUENCE {","paragraph_zero_based":17919},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17920},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                           OPTIONAL,   -- Need S","paragraph_zero_based":17921},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                       OPTIONAL,   -- Need S","paragraph_zero_based":17922},{"literal_text_all_w_t_and_m_t":"    scramblingID0                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17923},{"literal_text_all_w_t_and_m_t":"    scramblingID1                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":17924},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-DownlinkConfig  }                                   OPTIONAL,   -- Need M","paragraph_zero_based":17925},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17926},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8a428654b43ecf989b0f61f5bdfadf9968948935325dbffa63a86da61729898c","e1d15e3352cd314adcaa1e2c18b623ed591a4d434e99c0b175d2416afa4e5329","f939b530b0c5bc6f652237b55dc70994a1edbd72cc8bae55a73786a8d359f4a8","c2d7a0454bf3c7abc9cc9e5e56dcc1b8e3281c6cd9b3b7727d2606cce93b858c","b87191e6e961353eed2644a3b0a5a12e0b9f846708d1685dadbd64f5cce4e69b","b71f389b283e6a49ff17945234638db8bad3fae5c26ab7754c57c632243f27a9","13ee41f86546b8a98f7e9d343ccdea3d82ee8f6f7a2ca0c4b9517ce396cec14d","168b3d580a5d6ff202784df6afb76dd2f816605ba043e51cf7288409efe93df6","a7a1ed89695e93781e1a588a0fa1b3c2fdd08c4c0094701dd4c8eb6bb38767c2","6104f8b37865335ac6dd0ccb221bce68242b