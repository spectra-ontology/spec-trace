{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowP\" in TS 38.304 [20].","paragraph_zero_based":13248},{"literal_text_all_w_t_and_m_t":"threshServingLowQ","paragraph_zero_based":13249},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshServing, LowQ\" in TS 38.304 [20].","paragraph_zero_based":13250},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP","paragraph_zero_based":13251},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":13252},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":13253},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-Stationary\" in TS 38.304 [20]. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":13254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13255},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13256},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13257},{"literal_text_all_w_t_and_m_t":"HSDN","paragraph_zero_based":13258},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if speedStateReselectionPars is present; otherwise the field is not present.","paragraph_zero_based":13259},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":13260},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this intra-frequency operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":13261},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":13262},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this intra-frequency operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":13263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13264},{"literal_text_all_w_t_and_m_t":"–SIB3","paragraph_zero_based":13265},{"literal_text_all_w_t_and_m_t":"SIB3 contains neighbouring cell related information relevant only for intra-frequency cell re-selection. The IE includes cells with specific re-selection parameters as well as exclude-listed cells.","paragraph_zero_based":13266},{"literal_text_all_w_t_and_m_t":"SIB3 information element","paragraph_zero_based":13267},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13268},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB3-START","paragraph_zero_based":13269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13270},{"literal_text_all_w_t_and_m_t":"SIB3 ::=                            SEQUENCE {","paragraph_zero_based":13271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e4ec735a5a6d072da329648fe28556d8f4693459c8803fe356c106c4e19afe1a","fd4cdd3cb0abc60d723913f3f68d0bf08a4ea23414296047c44e1b27cf08add7","abbca1c146de30b1eb27934da83c24bc051150587957f230ad3325a3be7a3b59","947066963b48951af1db8e6615e6366b6d9840be4858b83e90059929296d6880","cafbef31d5fde35b5619c0c3920d746fa3bd572b23e968954a20245b81c94f49","72b5de455f02899bb1c2d8f0153b4d33c4be121b7a36334ed4ce07d833b17390","46b8d3f027ba8ce1e8a2b65b808b51e0dfd4b0435d3f5cdcb326669635cedbe6","276e133433100c25882547e124ab8e94aef70a7757a648a7a7061c73071c2bce","b15441b2cf2e15ec203d725cbf174eebc4a48369f9e07e6c79096c47071473ab","9d777361704e033bc5cc4411943422b7de60c575835e2c37bed3a6c108e35c89","5c2591c5c9c8fe5eb6842a346d7490a1a5164