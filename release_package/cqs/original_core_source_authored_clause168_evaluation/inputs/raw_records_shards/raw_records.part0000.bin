{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    profile0x0102-r16                     BOOLEAN,","paragraph_zero_based":42768},{"literal_text_all_w_t_and_m_t":"    profile0x0103-r16                     BOOLEAN,","paragraph_zero_based":42769},{"literal_text_all_w_t_and_m_t":"    profile0x0104-r16                     BOOLEAN","paragraph_zero_based":42770},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42771},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42772},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PRECONFIGURATIONNR-STOP","paragraph_zero_based":42773},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42775},{"literal_text_all_w_t_and_m_t":"SL-PreconfigurationNR field descriptions","paragraph_zero_based":42776},{"literal_text_all_w_t_and_m_t":"sl-DRX-PreConfig-GC-BC","paragraph_zero_based":42777},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":42778},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":42779},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on. If the field is absent, no offset is applied.","paragraph_zero_based":42780},{"literal_text_all_w_t_and_m_t":"sl-PreconfigDiscConfig","paragraph_zero_based":42781},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration for discovery message transmission used by NR sidelink U2N Remote UE. ","paragraph_zero_based":42782},{"literal_text_all_w_t_and_m_t":"sl-PreconfigEUTRA-AnchorCarrierFreqList","paragraph_zero_based":42783},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":42784},{"literal_text_all_w_t_and_m_t":"sl-PreconfigFreqInfoList","paragraph_zero_based":42785},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication and/ or NR sidelink discovery configuration some carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in the list.","paragraph_zero_based":42786},{"literal_text_all_w_t_and_m_t":"sl-PreconfigNR-AnchorCarrierFreqList","paragraph_zero_based":42787},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":42788},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerPreConfigList","paragraph_zero_based":42789},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":42790},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerPreConfigList","paragraph_zero_based":42791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a6f883345e1833ea1e3897a92303269968cecb1a53883efdfeae929794dcdb23","4af6b9e7761842f0e86528d65e2e0356be3824387ad65df0a0afb6090bde41c8","778f8fbdb1e3185b50aeb2c8d86ca4bf6a717f3318eb3b153a2300e568a12065","5eccba6f57e4953b010fa995624d2f5aed510db3b28161c2c73104af4902d492","171cba0186d3c62c41ddc1de859626cdde8d767d68280195b665576d7f6f93f1","7938c149f9b8d0fd4eb7ea84cbf7998b0de0d04e3497f3e8bd1d374459cd312b","051703b68b9ca5b3c294882fac93093052e24c035852b4358e4ffb096e25cd0a","fa641a