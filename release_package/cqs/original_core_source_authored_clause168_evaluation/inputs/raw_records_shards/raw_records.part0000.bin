{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36888},{"literal_text_all_w_t_and_m_t":"IAB-IP-Usage-r16 ::= ENUMERATED {f1-C, f1-U, non-F1, spare}","paragraph_zero_based":36889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36890},{"literal_text_all_w_t_and_m_t":"-- TAG-IAB-IP-USAGE-STOP","paragraph_zero_based":36891},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36893},{"literal_text_all_w_t_and_m_t":"–LoggingDuration","paragraph_zero_based":36894},{"literal_text_all_w_t_and_m_t":"The LoggingDuration indicates the duration for which UE is requested to perform measurement logging. Value min10 corresponds to 10 minutes, value min20 corresponds to 20 minutes and so on.","paragraph_zero_based":36895},{"literal_text_all_w_t_and_m_t":"LoggingDuration information element","paragraph_zero_based":36896},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36897},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGGINGDURATION-START","paragraph_zero_based":36898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36899},{"literal_text_all_w_t_and_m_t":"LoggingDuration-r16 ::=   ENUMERATED {","paragraph_zero_based":36900},{"literal_text_all_w_t_and_m_t":"                              min10, min20, min40, min60, min90, min120, spare2, spare1}","paragraph_zero_based":36901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36902},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGGINGDURATION-STOP","paragraph_zero_based":36903},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36905},{"literal_text_all_w_t_and_m_t":"–LoggingInterval","paragraph_zero_based":36906},{"literal_text_all_w_t_and_m_t":"Th