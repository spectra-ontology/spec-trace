{"fields":{"filename":"R2-2300329.zip::R2-2300329 Adding missing field description for Multi-RTT R17 TS 37355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-RequestAssistanceData-r16 ::= SEQUENCE {","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r16NR-PhysCellID-r16OPTIONAL,","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"nr-AdType-r16BIT STRING {dl-prs (0),","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"ul-srs (1) } (SIZE (1..8)),","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-Request-r17NR-On-Demand-DL-PRS-Request-r17OPTIONAL,","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Request-r17ENUMERATED { eAoD, eAoA }OPTIONAL,","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"pre-configured-AssistanceDataRequest-r17ENUMERATED { true }OPTIONAL","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-RequestAssistanceData field descriptions","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"This field specifies the NR physical cell identity of the current primary cell of the target device.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"nr-AdType","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"This field indicates the requested assistance data and/or configuration. dl-prs means requested assistance data is nr-DL-PRS-AssistanceData, ul-srs means a request for UL-SRS configuration.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"NOTE: UL-SRS is configured via NRPPa and RRC signalling as specified in clause 8.10.4 of TS 38.305 [40].","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"nr-on-demand-DL-PRS-Request","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"This field indicates the on-demand DL-PRS requested for Multi-RTT. This field may be included when the dl-prs bit in nr-AdType is set to value '1'.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Request","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"409763e6471f2c1f34717cc7bfa872ad4d554d6aec1479aeb3f62bc9b16a6048","original_member_sha256":"ccc1b4b91b71fda123ce12217f3394b0bc7c513f824519ae259f1c64691c3f8b","paragraph_ElementTree_utf8_XML_sha256":["8fe03d213ce4327dba5c6d6c8c25a02211017db8adb114c44e3128b9dcf16361","b5bd78feea28273e96b26c4ded9b603898d29d0d7680dbb828de125d5288923c","db5d6d3f023839ca3df30469ce52ab51372e10b0f21ec35c6ba6a0ae491c71b3","a6c456737eb4c2621fd724ddb58035b7fa4ae1db8492764d790d1df62345d7ca","fba340a7b46c3fa1346be58167a20605f543ccc3c0533749ddc4bef8cbfb0089","9de4ea176155fffaff041463f7493e2ba6ee6c2bd81fc9af15949a5fac1a8ce9","9577fbb540cf2371d0de746ba3462d833c420614effc5571f143ec0ebb7789e7","a047b60cfb5415b901d31d785114c96f1250107e48992b6a94fb54ef87f73b4a","cdaa4caa1737f912e43bb051b7fcbbc947dbd7d79e55cc3775093ff3de65aed9","cbb53ec667e6867c416b6510abcd93b0f1ab705ac3bdbfb16cfaaac87f6e2f39","db2b23e4d920998680fc0bca5e2ad44c6ee4cff5d9eb4a1812fcc2d7d9c752a6","f1135dfd2f885fa3a9ead7b29817e6076d745ea11c3e57e8dd14303901b2871e","e15282afaf899a578c473122e466f2342092b6b8a8e3396e4015b1