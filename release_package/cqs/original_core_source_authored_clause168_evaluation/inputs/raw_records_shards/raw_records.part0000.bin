ayValueConfig specifies the configuration of the UL PDCP Packet Delay value per DRB measurement specified in TS 38.314 [53].","paragraph_zero_based":30016},{"literal_text_all_w_t_and_m_t":"UL-DelayValueConfig information element","paragraph_zero_based":30017},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30018},{"literal_text_all_w_t_and_m_t":"-- TAG-ULDELAYVALUECONFIG-START","paragraph_zero_based":30019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30020},{"literal_text_all_w_t_and_m_t":"UL-DelayValueConfig-r16 ::=  SEQUENCE {","paragraph_zero_based":30021},{"literal_text_all_w_t_and_m_t":"    delay-DRBlist-r16            SEQUENCE (SIZE(1..maxDRB)) OF DRB-Identity","paragraph_zero_based":30022},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1298124525561e38f02c48b0adcdcb7c36dbc68bad569ca99ef4cc70ec80aacf","cf7f274d5ce956b8b266e9047c5c3a9122ed5f90765ebdfe438ea8e4ddded057","5edc35e2b13345ef43862d2e489a2a88ce47f9c617aef8455de16e2fbc96d881","191494d0264d18442068322463ab7a4e3475ffdde3217a8618fa05570cf4be03","96951d5e1735c8bc5feda1c9bff0686bb324c0c0d19db9a847b9d1f81e6f57bc","c40b94c1c6d481249145d5b8356cacfe7a1a8e77b8bc0587bbf7eb8be613ca9b","313616ae25b2d8f1094af4c2e7c88def6530efc313ab19b47ba35260936d0d8b","5856cc10ea1ff870e412dc0fdc5b3a1873b49d006962d05a0ad83e379ba7e495","083afc09341b0086cfbd5544ee22a68886616361098f24555efbf8add6863acd","98420996fbf45477f799bd7b638a8f8d4f3b250e94b42ad2951ab32554833610","1c040177c123cdaae047c32d42cd59e9ac7fe76ff973c62109308d5e9e20b4ca","317492212210dafe5be0b8b557685200387624c3b9ad8d2fd28894acc97e12cf","59b7bebbb107d8ca6cf0b73a6c11bbf5a3