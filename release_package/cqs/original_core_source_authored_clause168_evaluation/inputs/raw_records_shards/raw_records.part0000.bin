{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":2952},{"literal_text_all_w_t_and_m_t":"2>release spCellConfig, if configured;","paragraph_zero_based":2953},{"literal_text_all_w_t_and_m_t":"2>suspend all RBs, and BH RLC channels for IAB-MT, and Uu Relay RLC channels for L2 U2N Relay UE, except SRB0 and broadcast MRBs;","paragraph_zero_based":2954},{"literal_text_all_w_t_and_m_t":"2>release the MCG SCell(s), if configured;","paragraph_zero_based":2955},{"literal_text_all_w_t_and_m_t":"2>if MR-DC is configured:","paragraph_zero_based":2956},{"literal_text_all_w_t_and_m_t":"3>perform MR-DC release, as specified in clause 5.3.5.10;","paragraph_zero_based":2957},{"literal_text_all_w_t_and_m_t":"2>release delayBudgetReportingConfig, if configured and stop timer T342, if running;","paragraph_zero_based":2958},{"literal_text_all_w_t_and_m_t":"2>release overheatingAssistanceConfig, if configured and stop timer T345, if running;","paragraph_zero_based":2959},{"literal_text_all_w_t_and_m_t":"2>release idc-AssistanceConfig, if configured;","paragraph_zero_based":2960},{"literal_text_all_w_t_and_m_t":"2>release btNameList, if configured;","paragraph_zero_based":2961},{"literal_text_all_w_t_and_m_t":"2>release wlanNameList, if configured;","paragraph_zero_based":2962},{"literal_text_all_w_t_and_m_t":"2>release sensorNameList, if configured;","paragraph_zero_based":2963},{"literal_text_all_w_t_and_m_t":"2>release drx-PreferenceConfig for the MCG, if configured and stop timer T346a associated with the MCG, if running;","paragraph_zero_based":2964},{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":2965},{"literal_text_all_w_t_and_m_t":"2>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":2966},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":2967},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfig for the MCG, if configured stop timer T346e associated with the MCG, if running;","paragraph_zero_based":2968},{"literal_text_all_w_t_and_m_t":"2>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":2969},{"literal_text_all_w_t_and_m_t":"2>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":2970},{"literal_text_all_w_t_and_m_t":"2>release releasePreferenceConfig, if configured stop timer T346f, if running;","paragraph_zero_based":2971},{"literal_text_all_w_t_and_m_t":"2>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":2972},{"literal_text_all_w_t_and_m_t":"2>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":2973},{"literal_text_all_w_t_and_m_t":"2>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":2974},{"literal_text_all_w_t_and_m_t":"2>release obtainCommonLocation, if configured;","paragraph_zero_based":2975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f2205403d2b33139c3c3cb2c0feb3deba1a6eecef6ac99733e151ddd8aec93b6","9403f6f876b81bd1b6c73bdedc09adb329707a328c621ab28f2e08d225677728","16a86f322005cd862cdf