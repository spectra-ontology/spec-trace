{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    -- R1 33-6-1: DL priority indication for multicast in DCI","paragraph_zero_based":35400},{"literal_text_all_w_t_and_m_t":"    priorityIndicatorInDCI-Multicast-r17                            ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":35401},{"literal_text_all_w_t_and_m_t":"    -- R1 33-6-1a: DL priority configuration for SPS multicast","paragraph_zero_based":35402},{"literal_text_all_w_t_and_m_t":"    priorityIndicatorInDCI-SPS-Multicast-r17                        ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":35403},{"literal_text_all_w_t_and_m_t":"    -- R1 33-6-2: Two HARQ-ACK codebooks simultaneously constructed for supporting HARQ-ACK codebooks with different priorities","paragraph_zero_based":35404},{"literal_text_all_w_t_and_m_t":"    -- for unicast and multicast at a UE","paragraph_zero_based":35405},{"literal_text_all_w_t_and_m_t":"    twoHARQ-ACK-CodebookForUnicastAndMulticast-r17                  ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":35406},{"literal_text_all_w_t_and_m_t":"    -- R1 33-6-3: More than one PUCCH for HARQ-ACK transmission for multicast or for unicast and multicast within a slot","paragraph_zero_based":35407},{"literal_text_all_w_t_and_m_t":"    multiPUCCH-HARQ-ACK-ForMulticastUnicast-r17                     ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":35408},{"literal_text_all_w_t_and_m_t":"    -- R1 33-9: Supporting unicast PDCCH to release SPS group-common PDSCH","paragraph_zero_based":35409},{"literal_text_all_w_t_and_m_t":"    releaseSPS-MulticastWithCS-RNTI-r17                             ENUMERATED {supported}                      