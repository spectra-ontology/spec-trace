{"fields":{"filename":"R2-2301434.zip::R2-2301434 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"expectedDL-AzimuthAoD-r17INTEGER (0..359),","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"expectedDL-AzimuthAoD-Unc-r17INTEGER (0..60)OPTIONAL, -- Need OP","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"expectedDL-ZenithAoD-r17INTEGER (0..180),","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"expectedDL-ZenithAoD-Unc-r17INTEGER(0..30)OPTIONAL  -- Need OP","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"expectedAoA-r17SEQUENCE {","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"expectedDL-AzimuthAoA-r17INTEGER (0..359),","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"expectedDL-AzimuthAoA-Unc-r17INTEGER (0..60)OPTIONAL, -- Need OP","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"expectedDL-ZenithAoA-r17INTEGER (0..180),","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"expectedDL-ZenithAoA-Unc-r17INTEGER(0..30)OPTIONAL  -- Need OP","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-AssistanceData field descriptions","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ReferenceInfo","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"This field specifies the IDs of the assistance data reference TRP.","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataList","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS resources for each frequency layer. ","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"nr-SSB-Config","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"This field specifies the SSB configuration of the TRPs.","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PositioningFrequencyLayer","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"This field specifies the Positioning Frequency Layer for the nr-DL-PRS-AssistanceDataPerFreq field.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"afd7460cf554024cdd543f9064d790b9aa6edee1b4152e9ba84094d5a97ec947","original_member_sha256":"200d020a4005a2583dd49ea3376815774f4ec73f5686eaea31635f25c702125f","paragraph_ElementTree_utf8_XML_sha256":["dd97688f07eff7dd1ad9cf464ae1c11900ded69a48846fd93a8f42f99daa3ee7","7fc8d78e1b05dc574a3d73eefde6851f20a3184ac7172abcaa7c840fd92afc12","5e709a265814f606210234e76f3816aee65ff36942bd65336cfc72b732b17ebb","b7dcdf0d3410ea7d93fdd66fb9c964a961423006daf82c41abd02248328abcaf","a9e7e0f93088c3e2a681dfe9ef86e6303fad9db4c298f69dc56828b9118c2ca5","e61fa775941b909624a5f254400703636ca004f81e704d4981aad3646bbe083d","27d6b421eacd01037574615865c488b722f1d78aac414db8ac9af77f6fce9076","a0e7f17b97b1a0f4fbd0bb4e509997a8a6e935053eb01fe53d30ba73b27996ae","8984da420aa26bd2e83ec08284e19ec3c6ab15978f5b475bb9bc6465ae70fb3a","86765db07e24a94b2836ccd615480fd4b8fb6ee73b5fec27cddccbc2a2cf5b4f","663b4f794b2bea9d36f145ff79dd95af2a78fb5f99b508ec2b4a3022e861a3af","e0ae8c7b75a70ed5b706fdade8a5329bdc2a508352ae89c61fbf94338164e06b","cec96e5c00deefcf508a10e76f9aea2325dc964ddb041839c17250a901b0f7f5","95debc4f5d42b0d48a2dcd3444212e8f8dca780177d268c8a33e0e7703a32cb0","6ead3a82ecc23c3a2ecac882e56c1e471e8924beba9f7ad7fdd65feb440cca97","20d11387a4c45abf3124ede5c73a668e8dee3ad9a560dc6e6698d19ec98b66ef","1e812995e9577db9167a3a8eccaa1637b78a1d938170b2e6ca6bf9797d8728ee","01af79db16e47e298d57e19a7e0d5bc4fa68fa06c7eeea92b9314d2284232c1e","18346e0ab0c90e9149dfcc5c68c312586511e182f3054dd51aa3355a134b86ea","91fc1b9d50abf4f37e76e6cd5c9605841505c1718cba05e75398f84d864ab793","338ceaaeec0fbda8eb064ca9246320ba9d8e46d5b7d8dc7783d22645aa13c197","f3c9f015fd718acf7e253c7f6280808949ad32c0d977cd307ae4743c902432dd","31abb373d15a4a9c15f297f03b99233969c8bb77569e9fd2150d15d6944aeecc","6d293346728935da311afeb9d9cc051805b7154001f57580ed8481e7d47b34dc"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301434.zip::R2-2301434 Note.docx:p216"}
{"fields":{"filename":"R2-2301434.zip::R2-2301434 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataPerFreq","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resources for the TRPs within the Positioning Frequency Layer.","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resource ID to uniquely identify a DL-PRS Resource, and is associated with a single TRP.","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the TRP. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, as defined in TS 38.331 [35]. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-SFN0-Offset","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"This field specifies the time offset of the SFN#0 slot#0 for the given TRP with respect to SFN#0 slot#0 of the assistance data reference TRP and comprises the following subfields:","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"-sfn-Offset specifies the SFN offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP.","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of the assistance data reference TRP to the beginning of the closest subsequent radio frame #0 of this neighbour TRP.","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"-integerSubframeOffset specifies the frame boundary offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP counted in full subframes.","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"The offset corresponds to the number of full subframes counted from the beginning of a subframe #0 of the assistance data reference TRP to the beginning of the closest subsequent subframe #0 of this neighbour TRP.","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"NOTE:The location server should set the value in accordance with the defined search window for the target device using nr-DL-PRS-ExpectedRSTD and nr-DL-PRS-ExpectedRSTD-Uncertainty.","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"This field indicates the RSTD value that the target device is expected to measure between this TRP and the assistance data reference TRP. The nr-DL-PRS-ExpectedRSTD field takes into account the expected propagation time difference as well as transmit time difference of PRS positioning occasions between the two TRPs. The resolution is 4Ts, with Ts=1/(15000*2048) seconds.","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD-Uncertainty","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty in nr-DL-PRS-ExpectedRSTD value. The uncertainty is related to the location server′s apriori estimate of the target device location. The nr-DL-PRS-ExpectedRSTD and nr-DL-PRS-ExpectedRSTD-Uncertainty together define the search window for the target device.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"The resolution R is","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"-Ts if all PRS resources are in frequency range 2,","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"-4Ts otherwise,","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"afd7460cf554024cdd543f9064d790b9aa6edee1b4152e9ba84094d5a97ec947","original_member_sha256":"200d020a4005a2583dd49ea3376815774f4ec73f5686eaea31635f25c702125f","paragraph_ElementTree_utf8_XML_sha256":["7c5ba8f3b1ba63b21bfd3773ed8e4634de5093770f767247626c6fe2f80d9f3d","6d8595d06e25992e26942e90fc7aeb608f0e0e1f76236fdb2b01807b6085fa49","6d282065a409aed2e83258c1df6af931a58dc903bc4b90e6a1309eac103940f9","8a32a33f51eb67545cd345fc324318463253589111430f413c736d593906a843","c0eaa83e3702aa70000b98caabb13b9b935027453412dba409c84f08e6a92425","c87ffff04baaa013725ae01511d8c98283e4e169b9db703c76650ab58e769888","a7eea46a214845d691b7e3d587b7735ba68df52a40133a0f3a266b74473402f6","8135dddeee98b37fa5867141147d7c5b1838305a0dea326ab9064af9b989ed0e","1685add6b597674145793fa4a927fd064e4130e963ae51cbd3157b928391660f","e815aa1538f8d22e8c9a0b9bab8f445ad32c9a82d2b71c1c05587baf44421d96","20fe9a39ce1294068688deebe6ab871a4a892b3dc280597e2694acad8259c9cf","45bfc15659ad386b9e1180370f9e6cef6a5f64db7d2173a16df9e44d070e8e52","ee299f27c436421ad338b2011c7e076fb74aa04f39a3e0d9e6c33765b518cfe8","13b44ab8b85d53d5f87979cf207f55c0f906dc42a8e32cd39eaf7891fb51c27a","3db56190d69946cd46dce7d6e3ec1f9dc9e0769de04f2f6b9c1383ff07c13341","3597b627a88abe782dba683c66a0c55ce9030d65cb0a19b55a908fd37c33d69a","2253bda47a3ca4e199702014ec184945c2592a9b0d3937f13c4fdae31c6a2f0e","e76874fa89d9d7afbf828d55bc18ba710504ca42873a01dd04c30f021f36d990","6376761652f77ee048d8f223332b52b7c2930b94a7cf5dacb613154bc29d923b","e85cdf8f0da4061d1b91b6af736f58fd2527ed26242f692fad7ab79e63efa8ed","8e5a26927a5cac5366b288040004430b8abba67a2bffa3d6baadabfa9f60eafb","0cd606cb8b089b8c2fca0bbd83d3302fc3c0feb8e1140bb3d3ef149beb2748ff","d9787704d95cc4d425916832d93fab343c3350e7a5bc12e5d5d587b5a988cc2f","7fcc9f6800f14efbfc2399f6fe35a71fc6db075c31f34af1f087048c0199f48b"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301434.zip::R2-2301434 Note.docx:p240"}
{"fields":{"filename":"R2-2301434.zip::R2-2301434 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"with Ts=1/(15000*2048) seconds.","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"The target device may assume that the beginning of the subframe for the PRS of this TRP is received within the search window of size","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"-[-nr-DL-PRS-ExpectedRSTD-UncertaintyR ; nr-DL-PRS-ExpectedRSTD-UncertaintyR] centred at TREF+1 millisecondN+nr-DL-PRS-ExpectedRSTD4Ts,","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"where TREF is the reception time of the beginning of the subframe for the PRS of the assistance data reference TRP at the target device antenna connector, and N can be calculated based on","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"-nr-DL-PRS-SFN0-Offset","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"-dl-PRS-Periodicity-and-ResourceSetSlotOffset","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ResourceSlotOffset.","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-Info","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS configuration of the TRP.","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"dl-PRS-SubcarrierSpacing","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"This field specifies the subcarrier spacing of the DL-PRS Resource. 15, 30, 60 kHz for FR1; 60, 120 kHz for FR2. All DL-PRS Resources and DL-PRS Resource Sets in the same Positioning Frequency layer have the same value of dl-PRS-SubcarrierSpacing.","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs. All DL-PRS Resources of the DL-PRS Resource Set have the same bandwidth. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of DL-PRS Bandwidth and Start PRB.","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to reference DL-PRS Point A for the Positioning Frequency Layer. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-StartPRB.","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"This field specifies the absolute frequency of the reference resource block for the DL-PRS. Its lowest subcarrier is also known as DL-PRS Point A. A single DL-PRS Point A for DL-PRS Resource allocation is provided per Positioning Frequency Layer. All DL-PRS Resources belonging to the same DL-PRS Resource Set have the same DL-PRS Point A.","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"This field specifies the Resource Element spacing in each symbol of the DL-PRS Resource. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of comb size N.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"dl-PRS-CyclicPrefix","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"This field specifies the Cyclic Prefix length of the DL-PRS Resource. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-CyclicPrefix.","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"prs-OnlyTP","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the NR-DL-PRS-AssistanceData is provided for a PRS-only TP. Whether the field is present or absent should be the same for all the NR-DL-PRS-AssistanceData of all the PRS transmitted under the same TP.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"afd7460cf554024cdd543f9064d790b9aa6edee1b4152e9ba84094d5a97ec947","original_member_sha256":"200d020a4005a2583dd49ea3376815774f4ec73f5686eaea31635f25c702125f","paragraph_ElementTree_utf8_XML_sha256":["924f078d75f551b29c4ddcf735da34b30286d27c1697d6b0d01ac72de667d28f","b63205567f9ae3691877b25d50ac9abc318b376a10f7e954633232e074bac865","a729c0857ceb060e7608c25cb1aecc4962a42a850adc2233d2606d96a0674676","36704f83ba31a75c1ce8495102ac92da48438d0c620ab81f258db59b3afd0a13","159d63e7060c62fb54eeedfb435202876628f98df951cf044b67b61dbedd62e8","cdfd0e712f410a27615e926f8b306eebd01d5f2a7bf80692be2a7b21f525ff95","22e24a1c04c0a85ad0283fa5ef427378e8bd775fdecbbb1f5981ecbd33e3f029","ffb170245d6f59823fddddb98c2a6a4ac201db7e57299433260ae357c942677a","09037fb4567de15e346a18b456858d1d10d30347c8e2a486a46a8968577b9e61","7e0eb58ccd387df78292b98ddbca23faf2ac74a132b013c837206fddf9ee12c2","34bb85434cc4ab861ce31f8ba6f76ea6df569a772abffba9655bf64868137b1a","9fbbccd370cece3e7e3d1113cf3bd342c525f569cf8af3e04ecbebf69a290fdd","df2159b86d075fa3c473a03c98b391479d26355413c4dbd7a85058bf41860b15","92f3c12821703418c5b288fa47b728e4c2c7b20e0ba04ec46bca26f1fec5a981","27d2c767382a7aa5e7e0a4a460ff9db46d567eb26a3b3dedbb6866d670258028","d9b2fc735a15e9030dc1792fdc9197fde23d2ad43d1c8b6b5806564f8629400d","dbbe467c271c67e8cb250ccc2d805601ed1d9b15b188341f459e719883cb69a1","4364725d7f558afdfe1681bdc2c8ad60ace81746ad9e39db861ee99d09764012","98c823155a67e447c02824304556eae77d9af889a0c3707b90b3b770c13346b1","3dcc0c9111c1f45b56c4f2ef6f66abec1abb7da015ce434851d698c6f0a742ed","4a1e3043223f1b85c3751c2fb1235ac7154456f5c743095a502aa41ac20c19bb","26c1208e44b817f3c9567ea98358a70079d2b3a3c0bc5648f4a6a268cf4eea90","909214f2ef004edbb2ac16d2d4f3d2fe94de4c519e2ef1a5ccdf3d1104a2f827","3267fcbab1030a64b6d1d25f2f2c1e9095f5fabb02957a75607f8b620d2e7d1b"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301434.zip::R2-2301434 Note.docx:p264"}
{"fields":{"filename":"R2-2301434.zip::R2-2301434 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The target device shall not assume that any other signals or physical channels are present for the TRP other than DL-PRS.","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"This field specifies the expected AoD or AoA in the Global Coordinate System (GCS) at the target device location together with uncertainty.","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoD: This field specifies the expected azimuth angle of departure.Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoD-Unc: This field specifies the (single-sided) uncertainty of the expected azimuth angle of departure. If this field is absent, it indicates maximum uncertainty (60 degrees).Scale factor 1 degree; range 0 to 60 degrees.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoD: This field specifies the expected elevation angle of departure.Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoD-Unc: This field specifies the (single-sided) uncertainty of the expected elevation angle of departure. If this field is absent, it indicates maximum uncertainty (30 degrees).Scale factor 1 degree; range 0 to 30 degrees.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoA: This field specifies the expected azimuth angle of arrival. Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"-expectedDL-AzimuthAoA-Unc: This field specifies the (single-sided) uncertainty of the expected azimuth angle of arrival. If this field is absent, it indicates maximum uncertainty (60 degrees).Scale factor 1 degree; range 0 to 60 degrees.","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoA: This field specifies the expected elevation angle of arrival. Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"-expectedDL-ZenithAoA-Unc: This field specifies the (single-sided) uncertainty of the expected elevation angle of arrival. If this field is absent, it indicates maximum uncertainty (30 degrees).Scale factor 1 degree; range 0 to 30 degrees.","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"afd7460cf554024cdd543f9064d790b9aa6edee1b4152e9ba84094d5a97ec947","original_member_sha256":"200d020a4005a2583dd49ea3376815774f4ec73f5686eaea31635f25c702125f","paragraph_ElementTree_utf8_XML_sha256":["7b86b1a908bd52feeef98a082cd65fa1d7b3cd2d330f1575405ea836dce59632","a1929c673a4d117a702c20b22845d2fbc3a5fc4fcb8e72fac4249ac31e1df342","675bfdbf4c35180256294ec071055df0eeed97619e27d2cb8d3af923268974f3","1e8f997f468