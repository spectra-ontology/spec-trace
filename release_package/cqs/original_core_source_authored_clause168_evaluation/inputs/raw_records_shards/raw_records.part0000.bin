{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETESIDELINK-STOP","paragraph_zero_based":40968},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40970},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationCompleteSidelink field descriptions","paragraph_zero_based":40971},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":40972},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. The UE shall not include this field. If received it shall be ignored by the peer UE.","paragraph_zero_based":40973},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigReject","paragraph_zero_based":40974},{"literal_text_all_w_t_and_m_t":"Indicates the rejection of sidelink DRX configuration received from the peer UE for the corresponding NR sidelink unicast communication.","paragraph_zero_based":40975},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40976},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationFailureSidelink","paragraph_zero_based":40977},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationFailureSidelink message is used to indicate the failure of a PC5 RRC AS reconfiguration. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":40978},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":40979},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":40980},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":40981},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":40982},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationFailureSidelink message","paragraph_zero_based":40983},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragrap