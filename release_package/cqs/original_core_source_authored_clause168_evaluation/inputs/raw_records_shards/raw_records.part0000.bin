{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18648},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL","paragraph_zero_based":18649},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18650},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL information element","paragraph_zero_based":18651},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18652},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-START","paragraph_zero_based":18653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18654},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL ::=                 SEQUENCE {","paragraph_zero_based":18655},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB                ARFCN-ValueNR                                                   OPTIONAL,   -- Cond SpCellAdd","paragraph_zero_based":18656},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR,","paragraph_zero_based":18657},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR,","paragraph_zero_based":18658},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":18659},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18660},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18662},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-STOP","paragraph_zero_based":18663},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18665},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL field descriptions","paragraph_zero_based":18666},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":18667},{"literal_text_all_w_t_and_m_t":"Absolute frequency position of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A (see TS 38.211 [16], clause 4.4.4.2). Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList.","paragraph_zero_based":18668},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":18669},{"literal_text_all_w_t_and_m_t":"Frequency of the SSB to be used for this serving cell. SSB related parameters (e.g. SSB index) provided for a serving cell refer to this SSB frequency unless mentioned otherwise. The CD-SSB of the PCell is always on the sync raster. Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15] or TS 38.101-5 [75]). If the field is absent, the SSB related parameters should be absent, e.g. ssb-PositionsInBurst, ssb-periodicityServingCell and subcarrierSpacing in ServingCellConfigCommon IE. If the field is absent, the UE obtains timing reference from the SpCell or an SCell if applicable as described in TS 38.213 [13], clause 4.1. This is only supported in case the SCell for which the UE obtains the timing reference is in the same frequency band as the cell (i.e. the SpCell or the SCell, respectively) from which the UE obtains the timing reference.","paragraph_zero_based":18670},{"literal_text_all_w_t_and_m_t":"For cells supporting RedCap, this field corresponds to the CD-SSB.","paragraph_zero_based":18671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["56377f8800574fad9944fcc5f5cbb2a445538b8c4a3c302379feee31f27b7a3f","f05c48535d3e93d954f6ddc75c7839e604898a9ac80de230c7c78b6cb0380bf8","de783341aa2c9a3e66a99e34bb765a0bf7972aa24f417ec3fe977be93b9052dd","50a83786dc4a6c35772fada6fc6dd698d16a69fd0e1c63476527acd104ee46b0","6110ff7cdf5a3af977ba3912cf92c73ea781f2fb70c3a7fcfacdd43fe031e41b","2e19965dca60015e83c2a6b1286639f27943231c7023befe7789e644ff77cbae","d4175985008ffc91556cabdc5938740e48f733c9519c382d313330409447cb8e","cee265584f66c235fec3538ccbd5482e70116d3ae10f62c0eee3c62a0392e02e","2533a4d80041c61ff24c908850527b885d238a8607b05bf0877dfedb576011a1","3a0b899a889ebabeaf79cf09ae5ed51f94fe7aa697ef3d3ff7f266ab70d31067","ad2beeba166eda34501511323519277c09e31fc9dfea1b21bbd303e20de352a7","302860244a680d3137f86b3855012d8a5f4d815720cbf9f243f4fa1bc4a982ee","ee7b061efe15d6760b2c68fafaaccc605f10d1e39a07f041974424d38124becd","5175e75abe4097ca9081e02160baabbb03530fd26271253824bd4d1b6a0cb3ba","dbc835a2567ad47f2544a575862557d536d4596465e9d2311bb03c887ccae797","150255009ea0d279e7c1dc57ebf6a0b4fe832ec5afcad0484ec6df19ad119f1c","a6e7abb2020deb1290361a358a5e850d54440ddfefd9b47988fa8cefd33a9549","15a86f0ef7f893121a011466e69dff995e0ca91fba2605e40edcc05c04513466","5fce5d2776fdb49fe85d27b1ad7c39e7a018a395ceee25f2cfcccb393b24bb04","822401ba16dd3ad385803e5a7692aa4ec8edf2f3d4d709b5b180efd99166ec46","f2259816a1d608c059f56afbb34c48a241cb04774c078a7f555bf8a537166193","03e655e37f34f6e7f9d0c0c98ff074658d47a2681b311877ce04563f5dce507a","4fdb3e84c00b673dfd0bd98b0cbddedcbc992e00c784af8c9c8d33cb2c62ea88","3601b27c61249b6848d544b35028a5f3eaaff33f9896da6ac993182b6a6a49aa"],"paragraph_range_zero_based":[18648,18671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18648"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":18672},{"literal_text_all_w_t_and_m_t":"List containing only one frequency band to which this carrier(s) belongs. Multiple values are not supported.","paragraph_zero_based":18673},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":18674},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A. The network configures a scs-SpecificCarrier at least for each numerology (SCS) that is used e.g. in a BWP (see TS 38.211 [16], clause 5.3).","paragraph_zero_based":18675},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18676},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18677},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18678},{"literal_text_all_w_t_and_m_t":"SpCellAdd","paragraph_zero_based":18679},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoDL is for SpCell. Otherwise the field is optionally present, Need S.","paragraph_zero_based":18680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18681},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL-SIB","paragraph_zero_based":18682},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL-SIB provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":18683},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB information element","paragraph_zero_based":18684},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18685},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-START","paragraph_zero_based":18686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18687},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB ::=             SEQUENCE {","paragraph_zero_based":18688},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR-SIB,","paragraph_zero_based":18689},{"literal_text_all_w_t_and_m_t":"    offsetToPointA                      INTEGER (0..2199),","paragraph_zero_based":18690},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier","paragraph_zero_based":18691},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18693},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v1760 ::=       SEQUENCE {","paragraph_zero_based":18694},{"literal_text_all_w_t_and_m_t":"    frequencyBandList-v1760             MultiFrequencyBandListNR-SIB-v1760","paragraph_zero_based":18695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dad7579a437f5972332643678a7c80ece49d7332025b86a1d56518225527290b","877d628460fd59080cd67ada207d3525000b1677fff89ca0ace1fe12e4d9ddce","98c2e9cbc082c8904585fdc8cb9d7d2e0275469db2e9640d170ddcbccdc7d217","18681149d5f68322a832dfac20e6729ab9b97d6ae6548e0ffcc0812bdf67888d","6f66994d74ea0198751afef13a20426a240fec7719116d05b2af6852e31b7908","6d696550f4c34cff020e6269757aa29f0e67aed49299048f88727880cceb48e8","0fdf23997e2e89d4aa55c875581c7d2fadcc8a8b1e6a863c523c1dae338c14e7","9b080f2e494bffa0cf34bb4ee02f58356005ddd29c385957caebeb92cd718782","e6ede6a4630457a2680bd5e1e794cea7eb5efedf8cc6bb52848c41a812a794ff","03cb7720256d2bcd353a2ed73fa20797399623951aae3e31d7ccfe252963477d","673d6cc77f93cb2289d7d3f950b30f83e9e6e99fc3ffa231239d2e7ba54ca71f","db84cb3cdf81268786e601f400f32edcd2a3