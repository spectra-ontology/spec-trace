{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":21168},{"literal_text_all_w_t_and_m_t":"    }                                                                                  OPTIONAL -- Cond periodic","paragraph_zero_based":21169},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21171},{"literal_text_all_w_t_and_m_t":"MUSIM-Starting-SFN-AndSubframe-r17 ::= SEQUENCE {","paragraph_zero_based":21172},{"literal_text_all_w_t_and_m_t":"    starting-SFN-r17                       INTEGER (0..1023),","paragraph_zero_based":21173},{"literal_text_all_w_t_and_m_t":"    startingSubframe-r17                   INTEGER (0..9)","paragraph_zero_based":21174},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21176},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-STOP","paragraph_zero_based":21177},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21178},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21179},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo field descriptions","paragraph_zero_based":21180},{"literal_text_all_w_t_and_m_t":"musim-GapLength","paragraph_zero_based":21181},{"literal_text_all_w_t_and_m_t":"Indicates the length of the UE's MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for both periodic gap and aperiodic gap preference indication.","paragraph_zero_based":21182},{"literal_text_all_w_t_and_m_t":"musim-GapRepetitionAndOffset","paragraph_zero_based":21183},{"literal_text_all_w_t_and_m_t":"Indicates the gap repetition period in ms and gap offset in number of subframes for the periodic MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for the periodic MUSIM gap preference indication.","paragraph_zero_based":21184},{"literal_text_all_w_t_and_m_t":"musim-Starting-SFN-AndSubframe","paragraph_zero_based":21185},{"literal_text_all_w_t_and_m_t":"Indicates gap starting position for the aperiodic MUSIM gap. This field is optionally present for the aperiodic MUSIM gap preference indication.","paragraph_zero_based":21186},{"literal_text_all_w_t_and_m_t":"starting-SFN","paragraph_zero_based":21187},{"literal_text_all_w_t_and_m_t":"Indicates gap starting SFN number for the aperiodic MUSIM gap.","paragraph_zero_based":21188},{"literal_text_all_w_t_and_m_t":"startingSubframe","paragraph_zero_based":21189},{"literal_text_all_w_t_and_m_t":"Indicates gap starting subframe number for the aperiodic MUSIM gap.","paragraph_zero_based":21190},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dafdb60650ad08a61db57a40cadd40d1d240d20dcf010c46ee2ec671dd430daf","d0f7145bc262b94a06c775bad73a0f058f016337730a3ef484f85319834982bc","cbbd1d32fc48e4c47e9d3b809dfcc44eabcacf15d23a7e50acc40c8c6fab7224","0635a960147c4f4b5eb04c4eb216f0e21113f0968de82984cce6db869121381f","2a54d716b2607f1f3e24effcf7a0238e1e52c1921dc1fe69f786e76de805b668","25636323d84d102c7fce322bd9328e81232e1c7ffff2d25deadd2471d858c348","562a815fde31f29ff79f645bedbf7757d21c10ba7a0a9168968b801d18c4162c","c17056ffc0bcb60d97d4a11dc0c5286197b2359c059c4afc93040fc12d6855d8","3b60e4e7c7f0812a05e73c88cb9fbb67042bcd5d7175b2748c44921d389a9460","60a4e63f57e23baf0cf290c82c17865b1ca60f483d8476e38cb0521708c23ea5","41cfb04f5b1133e37fc35bd38a532db3b72d597a9e4b470e80e58a6d96f5712f","f19776304381599d71742