{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19848},{"literal_text_all_w_t_and_m_t":"EUTRA-CellIndexList ::=                     SEQUENCE (SIZE (1..maxCellMeasEUTRA)) OF EUTRA-CellIndex","paragraph_zero_based":19849},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19850},{"literal_text_all_w_t_and_m_t":"EUTRA-CellIndex ::=                         INTEGER (1..maxCellMeasEUTRA)","paragraph_zero_based":19851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19853},{"literal_text_all_w_t_and_m_t":"EUTRA-Cell ::=                              SEQUENCE {","paragraph_zero_based":19854},{"literal_text_all_w_t_and_m_t":"    cellIndexEUTRA                              EUTRA-CellIndex,","paragraph_zero_based":19855},{"literal_text_all_w_t_and_m_t":"    physCellId                                  EUTRA-PhysCellId,","paragraph_zero_based":19856},{"literal_text_all_w_t_and_m_t":"    cellIndividualOffset                        EUTRA-Q-OffsetRange","paragraph_zero_based":19857},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19860},{"literal_text_all_w_t_and_m_t":"EUTRA-ExcludedCell ::=                      SEQUENCE {","paragraph_zero_based":19861},{"literal_text_all_w_t_and_m_t":"    cellIndexEUTRA                              EUTRA-CellIndex,","paragraph_zero_based":19862},{"literal_text_all_w_t_and_m_t":"    physCellIdRange                             EUTRA-PhysCellIdRange","paragraph_zero_based":19863},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19864},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19865},{"literal_text_all_w_t_and_m_t":"-- TAG-M