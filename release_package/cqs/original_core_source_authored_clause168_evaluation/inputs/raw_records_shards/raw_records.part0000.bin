{"fields":{"filename":"R2-2301466.zip::R2-2301466_CR38.321_R17_threshold.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"RACH","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, there is no interoperability issue.","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, there is no interoperability issue.","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"There is ambiguity in the specification on whether the UE should use unfiltered or filtered L1_RSRP measurements when comparing with the configured threshold for the RACH triggered as part of beam failure recovery.","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"5.1.2","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_ba