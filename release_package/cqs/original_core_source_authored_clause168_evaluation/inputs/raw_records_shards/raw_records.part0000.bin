        BOOLEAN,","paragraph_zero_based":3927},{"literal_text_all_w_t_and_m_t":"    profile0x0101-r16                     BOOLEAN,","paragraph_zero_based":3928},{"literal_text_all_w_t_and_m_t":"    profile0x0102-r16                     BOOLEAN,","paragraph_zero_based":3929},{"literal_text_all_w_t_and_m_t":"    profile0x0103-r16                     BOOLEAN,","paragraph_zero_based":3930},{"literal_text_all_w_t_and_m_t":"    profile0x0104-r16                     BOOLEAN","paragraph_zero_based":3931},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3933},{"literal_text_all_w_t_and_m_t":"SL-PreconfigDiscConfig-v18xy ::=   SEQUENCE {","paragraph_zero_based":3934},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-PreconfigU2U-r18   SL-RelayUE-ConfigU2U-r18,","paragraph_zero_based":3935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["110371662baae9f3ccd92315be5d541fdd9d67e06a12c85acf912c058296d663","560b547563fcaa1007edc813f632c9afe0660fb1cf82ef05ddc53853a063a794","267bd5deda48758c3e589c2c4b13af4787fdab8b766116c1a40977a519500cc3","dc7c77ad2f3da6677287149592e37d66cbd75e3f342bccc9da6315ad7587dcf8","35e1895834922e876b3306954a46ff876968b5fbf6f430001ca3558ead540de3","d63206b61211254f8ada06392556a5cab30ef83cd271e5f8f69084161eb2409a","6f40e0825a6e02ffbc5eb275974d551a5ec70daa815dd0251401bfa5ce0274f2","29be15d7c21f5db60ab5b3fc4a61b995a79a5c2cd6c12dad8ecf1371c4894486","7ba3922a2155927156b10e9155d5e0aba0f8df2855917c63046c9dbb34d1cef0","29acf18e9564e0f586d9a3914ede94d66c3309774f18c7d44a61f3bba81b8c58","51efabf0e18d82df046b8673471614091b0645a256497d3bbdb82e7b80d2d8db","cfc8ee1fab55eaf8c5caf35f4b260a5abd9ee4230d71d4ba08f1204816c31f50","77bb5074d93535088a87fc17320a388fe18395ff53d227d84ff00f92160fef1e","c1733e1d1b28e73fdbed9d5c40ef58e924e2871b81e215961656c9c2441a7da8","6c6b6c6e169d686a021227fcd2cdadff5e8fc889dc9a584ba142d20d47b8e4bf","ff50a8c8cdfb6b12219d117d2c283dac3f88d554056fbc6cb49b9fc0f3f3b572","8da735ab407fd191ccad122ba93e932b8fe7967080b147b0369460e7a3f8f3fd","e17feb4781ed38a2b128d87313575055f1279621990d85be1f4700571432e7c3","758ed8043dbf802cdd34b9e26bdbe54d50add87f1f434e05c98eea6382544eba","16577142aefbf2aea72bd06847e5b184d4b772206da578515fe9eae6f5f68b7a","b252ca63ae10e1cf983718265a217829d51db7db46236bccd93938656a3d9608","c5809a2b90b47212e20cfd43c4843d2323041e490744366ecea34c9b7a75482f","783e17316aed64d12163caa09a79f7c5b4e985628ad13dcc11a05493c4b14648","ad23da8ba08cf2b846dc718817e8c03c7d9dc3bbcd7e184ca5b0aaa0db16e61e"],"paragraph_range_zero_based":[3912,3935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p3912"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-PreconfigU2U-r18  SL-RemoteUE-ConfigU2U-r18","paragraph_zero_based":3936},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3937},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3939},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PRECONFIGURATIONNR-STOP","paragraph_zero_based":3940},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3942},{"literal_text_all_w_t_and_m_t":"SL-PreconfigurationNR field descriptions","paragraph_zero_based":3943},{"literal_text_all_w_t_and_m_t":"sl-DRX-PreConfig-GC-BC","paragraph_zero_based":3944},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":3945},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":3946},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on. If the field is absent, no offset is applied.","paragraph_zero_based":3947},{"literal_text_all_w_t_and_m_t":"sl-PreconfigDiscConfig","paragraph_zero_based":3948},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration for discovery message transmission used by NR sidelink U2N Remote UE, used by NR sidelink U2U Relay UE or used by NR sidelink U2U Remote UE. ","paragraph_zero_based":3949},{"literal_text_all_w_t_and_m_t":"sl-PreconfigEUTRA-AnchorCarrierFreqList","paragraph_zero_based":3950},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":3951},{"literal_text_all_w_t_and_m_t":"sl-PreconfigFreqInfoList","paragraph_zero_based":3952},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication and/ or NR sidelink discovery configuration some carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in the list.","paragraph_zero_based":3953},{"literal_text_all_w_t_and_m_t":"sl-PreconfigNR-AnchorCarrierFreqList","paragraph_zero_based":3954},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":3955},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerPreConfigList","paragraph_zero_based":3956},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":3957},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerPreConfigList","paragraph_zero_based":3958},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":3959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["e16b4d3ab9431e669d105c80a859d587ad125e4c5781261cd3febae0dfbdee81","4026cdd8296ba9844eb2aa5ecdbd476f09771a9e2038180d0016e28c29294231","b9deb55793db4c29ad4c4ab3b65579e52e11d5eb095ac5a36b216883e1fa336f","f07ab3434857538d24529763ea6cbb31569118939bd9f675d178629fd8da029a","184568eca2cd4bfdf75a8d0bbcc0dc0c8497546177979d271537d3568f77a733","e867805c7c9fd273cf4d321f38bf0f56574d6556f92a3c7151d3daf592d956f0","20e11c2428acf9957d8702ad9d67afe9dd9e48625cedff3f8df42d5e4940a647","07deec07d3d27c847978cf60b1cad0b399c94d112b69ed87be46ec5d04deadd5","eae803309d44c0c01b994bbea744bea7a6202eeb7a0728c3266e39212ea0ddc8","4b1ca3edde5af5750c181a611b7d71a644fec86e8241e8edb78a3a62d646ea93","8c50c3f20abbcd7039471e97539c3ece4fedbab1c2a513ca9edc0b71a9ee8903","1668d11f9f220b9f4bba9b3d42fc443b22864ed4dd3c30ba399539936c17641e","52a5b78db39e222d8400e98648d867706ff1598638b0a71be2b59c02198a2576","fc3a7427d0d109aab7b29e367cc5da0c57b6a8738927fd4b63ed140feaf7ce3a","bdef68651e82908730a08625382fd25d3b904ee363eb60b75eb9f57f696a5f84","24cabe5bd7e0623e79cf2899a72bee009f957e00bc768715907db55f85114aa2","c4f2bbccfe146d926f9cbe84568b986fdac61baba12ba31f7d8b3fc2f4a1f64b","4d46f3e9279b3d0da6fb2a49351f8d8abe57ff04b177553dc32f817395b886e4","b7d87be0107738b0cae95d7f2d9079f2d5ea886baf7393921af0c1512f3559e5","42942976d48cf0ac268fb3723f2f5f615974334236b3bc6df11698f98c1ffdec","f85278e70a176e0f199861c026bdcb918294a895cf3bac0f8bcd8db9c3e78b16","11c313915ab88c4a897a58bfdd9795a80b7200b2712da390ab78400cd106a561","0e9f4d6de9c2d90335dbf9318504bdb0edf0e5d88878b5f10d1e5bd0d05bb9c4","a6249fe83ba61f80a88888fd069653d18d2558859d78ff4e5d48610342cba9f4"],"paragraph_range_zero_based":[3936,3959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p3936"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-RoHC-Profiles","paragraph_zero_based":3960},{"literal_text_all_w_t_and_m_t":"This field indicates the supported RoHC profiles for NR sidelink communications.","paragraph_zero_based":3961},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":3962},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":3963},{"literal_text_all_w_t_and_m_t":"sl-TxProfileList","paragraph_zero_based":3964},{"literal_text_all_w_t_and_m_t":"List of one or multiple Tx profiles, indicating the compatibility of supporting SL DRX as specified in TS 38.321 [3]. It is up to the UE implementation whether/how to apply this field.","paragraph_zero_based":3965},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3966},{"literal_text_all_w_t_and_m_t":"–End of NR-Sidelink-Preconf","paragraph_zero_based":3967},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":3968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3969},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":3970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3971},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3973},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3974},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3975},{"literal_text_all_w_t_and_m_t":"<<Change End>>","paragraph_zero_based":3976},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3978},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3980},{"literal_text_all_w_t_and_m_t":"Annex X (informative): RAN2 agreements on U2U","paragraph_zero_based":3981},{"literal_text_all_w_t_and_m_t":"List of RAN2 agreements that are foreseen most relevant for this Running CR.","paragraph_zero_based":3982},{"literal_text_all_w_t_and_m_t":"Grey: no impact.","paragraph_zero_based":3983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["9638cb55eb87cde52756e9befb6e8173924a455fdf071d24b416227fe7f650f5","2dd8a2096bb1c6b59825ea4635c4463f3f64c367bcdb89d63bc0334d0961cd8f","f6b3ddccf874c6d9e455c72814e7cde1f582de24047a055eb4b07a588cb4bbbf","0faeb907cc84524bc287129c47d30b1705a4f0d14d1ef9835441307fc863d5ad","870415f7eb0552fcdcc2d27bdb1b7d0a64cb27df3ac9afbbb91acc4135db2bef","1bf01c701ecb3786f38adec98cbc4be41f6b8b96654d96fbdc8f8016c5c7462d","eeb432e120b3325a6035788a1fce25cdf54f8fcdf7f01746fcc478974b0b14a6","60ddb69b65ccb796b5113645f3e24547cc6fd0d17682db7734355a963de9ce0b","444dcfa9d3eb3a2eb8e0c5c2c755f18e59100b90129f96c3dbccc88803d7b737","d88b2cfe1cedfdf1c32b73aa0d89a6eeb59c99f784d23b819df1bcd8ef759175","23aeca477b596cdabb50c6b3afe01fbe84d74b5a8b4448ce586d9b260dfa7254","70707bf625cf526664654316b3d174efaffc3f4663be25ca072d005b2b837fb1","a899e63aeb26a6f0cef383916a41c80630b0324f23f89618ff9114d670b339b7","e4a18708164701a34d0ea25f756f9fb461572b9ea42915cfc37ba6e22d95113b","3cd75b5eb129398818ae1d8c7eaaadc3dccceea90949b39a3f50e2bdca0a3cf2","a92750be245e8ffbab3189e7714bbbf39246bfbbe266fb903a4c351e992c3263","859e6a5a67c5ee06209b8ef3018277634610b224a75f307c7a4d4abee1113fa7","663c27073a810db402ad8deaae3d53c069cf4f046362c52c4c490dbcd9c7e753","0999ca0fbef2d9842f4ccba32ce067e431103bc6d826ba71e2a780f23aa2357c","93f17e27a962277c60a92ac30acbacbcbd4585cf419e21527d6f185234e460a3","ed27c8f48d3ee7df26e67b47229906b382b5e104e68419dfc2882586ac15cfe5","d48bfda01421a419f8ad03c212cce1bd89b811ea7568af6faa20d765dfc6a6e4","d4f165e2ab8fe256070202a69e85b2ca9277aa7f5967f5d8ab3f68763d52f060","953319b90ac25db2c60c890ff60db41496c85974bd0861c3983456e8d106b31c"],"paragraph_range_zero_based":[3960,3983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p3960"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Yellow: impact identified not fully implemented or captured as Editor’s Note.","paragraph_zero_based":3984},{"literal_text_all_w_t_and_m_t":"Green: impact identified, and change implemented.","paragraph_zero_based":3985},{"literal_text_all_w_t_and_m_t":"RAN2#123bis Agreement","paragraph_zero_based":3986},{"literal_text_all_w_t_and_m_t":"For SRAP header in U2U Relay, the UE ID size is 8bits for each UE (i.e., 16 bits for the E2E UE pair).","paragraph_zero_based":3987},{"literal_text_all_w_t_and_m_t":"For SRAP header in U2U Relay, the Bearer ID size is 5bits. FFS how to derive 5-bit value BEARER ID from SLRB configuration index.","paragraph_zero_based":3988},{"literal_text_all_w_t_and_m_t":"The Local UE ID of the U2U Remote UE is assigned before E2E SL-SRBs transmission.","paragraph_zero_based":3989},{"literal_text_all_w_t_and_m_t":"Reuse RRC ReconfigurationSidelink to indicate the Local ID pair from relay UE to Remote UEs.","paragraph_zero_based":3990},{"literal_text_all_w_t_and_m_t":"WA: Carry L2 ID and Local ID in RRCReconfigurationSidelink message with the assumption that the association between User Info and L2 ID is done at ProSe layer.","paragraph_zero_based":3991},{"literal_text_all_w_t_and_m_t":"LS to SA2 to indicate the above WA and ask SA2 to implement it if feasible.  If not, RAN2 intend to adopt option 1, but the details do not need to be included in the LS.  RAN2 intend to implement according to the WA in RAN2#124, and if SA2 indicate it is not feasible, it can be handled in maintenance.","paragraph_zero_based":3992},{"literal_text_all_w_t_and_m_t":"The UE ID assignment for U2U remote UEs is up to U2U relay UE implementation, i.e., no specification impact on how to assign the local ID is needed.","paragraph_zero_based":3993},{"literal_text_all_w_t_and_m_t":"Approved LS (R2-2311566) on L2ID and User Info for L2 based U2U.","paragraph_zero_based":3994},{"literal_text_all_w_t_and_m_t":"WA: AS signalling is used to indicate the end-to-end QoS and QoS split for L2 U2U relay.","paragraph_zero_based":3995},{"literal_text_all_w_t_and_m_t":"There are no additional procedures at the gNB beyond Rel-16 operation in the ID reporting/resource allocation procedures for an RRC_CONNECTED U2U relay/remote UE. Some Rel-16 functionality may not be applicable to U2U (to be determined on a case by case basis).  FFS stage 3 impact to message formats (e.g., additional fields).","paragraph_zero_based":3996},{"literal_text_all_w_t_and_m_t":"Mode 1 resource allocation is supported for U2U relay according to Rel-16 procedures.","paragraph_zero_based":3997},{"literal_text_all_w_t_and_m_t":"The U2U relay UE is configured with SL-RSRP and SD-RSRP thresholds for discovery, and it applies the threshold appropriate to the quantity it measures.  This applies to all discovery models (A/B/integrated) from signalling point of view, with the single exception as below.","paragraph_zero_based":3998},{"literal_text_all_w_t_and_m_t":"The relay UE determines whether to forward the DCR in integrated discovery based on SL-RSRP measurements, but it applies the SD-RSRP threshold.","paragraph_zero_based":3999},{"literal_text_all_w_t_and_m_t":"RAN2 confirm the following agreement applies to both source L2 remote UE and L2 target remote UE. FFS for L3 U2U relay, including whether there is a need for the PC5-RLF indication in this case.","paragraph_zero_based":4000},{"literal_text_all_w_t_and_m_t":"- When the remote UE receives PC5-RLF indication from the U2U relay UE, it would inform upper layers and rely on upper layers to trigger relay (re)selection (or not).","paragraph_zero_based":4001},{"literal_text_all_w_t_and_m_t":"The same threshold(s) is configured for U2U remote UE for relay selection and re-selection trigger evaluation.","paragraph_zero_based":4002},{"literal_text_all_w_t_and_m_t":"When relay (re)selection is triggered, integrated discovery can be triggered to discover and select a relay UE. No impact on running CR is foreseen.","paragraph_zero_based":4003},{"literal_text_all_w_t_and_m_t":"Communication resource pool is used for the DCR/DCA message with integrated-discovery.","paragraph_zero_based":4004},{"literal_text_all_w_t_and_m_t":"For U2U relay UE and target remote UE, it can be up to UE implementation on cross-layer interaction for the AS layer condition check for discovery message forwarding. Check whether and how to capture it in the CR drafting.","paragraph_zero_based":4005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4006},{"literal_text_all_w_t_and_m_t":"RAN2#123 Agreement","paragraph_zero_based":4007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["8ba17b738af0a5c3ad4fb38e0f88ae40fe19b6d76cdb20c967259db0ae07dd34","72fc28dee62a74b14516f351ee1874767c37a446c0e86b12423ef01cef9d6a04","8d1079e7a9d6f4f8bde0d75dcf7de9cda8d6ba1081b0fc3d48c5dee9f844d30e","9b33a3907fc2526f6b921579df2ba7d2d0f5a55740730f28561b176eb669d2c6","3c7d8dedf8195fb981cece1d26f23e7b3afe4db130e4abe5ee458823e9cc59b5","10d173a77d77515dadf79f106f5cf3aa9ae155e7a0869ac852b5d6bfa986387d","845ca5ac46d9ca7cad937186186fb0c5d9d9cfcb21b30d1feb03d4af8d5dcdfc","748fbdb55768bebf50005dda8499d5697c4370185eebceb1b7f5c951350b461a","b447234621967d31df9360ad3db137978d73e7e2c24b746a6d7a20f0ba780873","72f8eae4e00e95cab5fee710fb8d1139b86b64856fba1c94e4f04462c71b2cc0","11f9032dfc4e1254d650e7bca03f5871bb6230a8cc989e04b95afd6a0873f4d2","a25f092ea3b0ce849211638889947bf00d7e401c28e230a41ffba5934225b3c5","1e35302a80237fdd2c2a83e717df8e2abf9a1337ae38d33ab2606aac5e47e367","257f493217a868bc082e5ec448a2c3a60457e09a379e0f42913607753d1fce4d","0c365d71d58d64e6bb50f3c4322cf314b93dbe8cd1f7223a2b2c3c9ebd3b4057","b80279d03c8684020b7f38861158847a757e7a26782c74704f5778bacba76cb1","5599ccba02400d4aed90505d3c209646ddf40ec7ed8d2a94e00fbda273bfe0b8","2be268bbd7c4597fe40ee3695e00b0871d2d9fadd479813a13b27370f553b3ca","bab0f58045373fb378144c47b0cbb3dad6bf9a7bb097ede5d10aa0781727cb60","15da46a4d59d6dad1bc30b0f5435bd4aaf924936a6c3265f839ed590d49a77b6","2f3976e48e7576c42c0e1ebb6c0b602b014b8c1cb7ed45f042a67aa7e33b0d5f","56e25bc69b0f4152b14834a47b2977341ccc2c68e4bc41f0b95ddbd90b82cb30","ba9f2303a3cc91f00929dcdc6af45644f0c48677773984b7530fd12202a259c2","1149e62e4565c2431f1f8043a4ee35de81709e58c64b501e884dd7e886f74fda"],"paragraph_range_zero_based":[3984,4007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p3984"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE in RRC_CONNECTED state can obtain UE-to-UE relay discovery parameters in dedicated discovery configuration.","paragraph_zero_based":4008},{"literal_text_all_w_t_and_m_t":"For integrated discovery DCA message, no AS criterion is needed for the relay UE to forward the response message to the source Remote UE.","paragraph_zero_based":4009},{"literal_text_all_w_t_and_m_t":"For Model B, the relay UE forwards the solicitation message only if the PC5 RSRP between the relay UE and the source remote UE is above a threshold.","paragraph_zero_based":4010},{"literal_text_all_w_t_and_m_t":"For Model B, no AS criterion is needed for the relay UE to forward the response message to the source Remote UE.","paragraph_zero_based":4011},{"literal_text_all_w_t_and_m_t":"E2E SL-SRB and E2E SL-DRB use different index(es).","paragraph_zero_based":4012},{"literal_text_all_w_t_and_m_t":"Fixed index (i.e., 0/1/2/3) are defined for E2E SL-SRB 0/1/2/3 respectively.","paragraph_zero_based":4013},{"literal_text_all_w_t_and_m_t":"Use specified PC5 RLC Channel configuration on each hop for E2E SL-SRB 0/1/2/3.","paragraph_zero_based":4014},{"literal_text_all_w_t_and_m_t":"The TX Remote UE derives the PDCP and SDAP configuration for e2e SL-DRB and provides the portion of the configuration related to RX to the RX Remote UE using E2E PC5-RRC message (similar to legacy PC5 configuration).","paragraph_zero_based":4015},{"literal_text_all_w_t_and_m_t":"The TX Remote UE derives the first hop configuration (e.g. PC5 relay RLC Channel configuration) for SL-DRB and provides to the relay UE the portion of the configuration related to RX on the first hop (i.e., Rx by the relay UE), using per-hop PC5-RRC message (similar to legacy PC5 configuration).","paragraph_zero_based":4016},{"literal_text_all_w_t_and_m_t":"The two conclusions above do not exclude the derivation involving information from gNB/preconfiguration/specified configuration.","paragraph_zero_based":4017},{"literal_text_all_w_t_and_m_t":"Split PDB is sent to the source (TX) Remote UE from the Relay UE.","paragraph_zero_based":4018},{"literal_text_all_w_t_and_m_t":"It is left to Relay UE implementation on how to split the PDB.","paragraph_zero_based":4019},{"literal_text_all_w_t_and_m_t":"The Relay UE derives the second hop configuration (e.g. PC5 relay RLC Channel configuration) for each SL-DRB.","paragraph_zero_based":4020},{"literal_text_all_w_t_and_m_t":"It is FFS how the Relay UE derives second hop configuration for SL-DRB.","paragraph_zero_based":4021},{"literal_text_all_w_t_and_m_t":"Same as L3 based U2U relay, the QoS split should be per e2e QoS flow, and RAN2 expect that the source UE will inform the Relay UE QoS flow(s) and corresponding QoS profiles.  FFS if this requires AS signalling or can be done in upper layers.","paragraph_zero_based":4022},{"literal_text_all_w_t_and_m_t":"At least PDB is sent from the source UE to the relay UE for splitting.","paragraph_zero_based":4023},{"literal_text_all_w_t_and_m_t":"The source UE sends to the Relay UE all the QoS profiles for the e2e QoS flows.","paragraph_zero_based":4024},{"literal_text_all_w_t_and_m_t":"At least for single-hop relay, use local ID instead of L2 ID as UE ID in SRAP header. ","paragraph_zero_based":4025},{"literal_text_all_w_t_and_m_t":"At least for single-hop U2U relay, two local IDs are included in SRAP header to identify source and target Remote UE respectively.  FFS impact on SRAP header.","paragraph_zero_based":4026},{"literal_text_all_w_t_and_m_t":"For single-hop U2U relay, the local ID for a particular UE is the same on both hops.","paragraph_zero_based":4027},{"literal_text_all_w_t_and_m_t":"Approved LS in R2-2309231 to SA2 on U2U agreements from RAN2#123.","paragraph_zero_based":4028},{"literal_text_all_w_t_and_m_t":"New specified per-hop configurations are used for E2E SL-SRB 0/1/2/3 respectively.  FFS how they will be implemented in specs (e.g., if the configurations are identical the tables might be merged for different SL-SRBs).","paragraph_zero_based":4029},{"literal_text_all_w_t_and_m_t":"RAN2#122 Agreement","paragraph_zero_based":4030},{"literal_text_all_w_t_and_m_t":"For Model A discovery, the relay UE should only announce the neighbour UEs for which the SD-RSRP/SL-RSRP between the relay UE and the neighbour UE is above a configured threshold in a discovery announcement message. LS is sent to SA2.","paragraph_zero_based":4031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["1e1b02fb75e97378e77e6787cb1e473b45229420cbd0f237fa1716330d9abdb4","9c75428a6c08413449ea9a0e625eac1ee263727173d6546ff23e6c094735fdfb","388350ad8a329a945305e3b35b3204975bcd91b8378701b24bdf3e441409bd7c","eb54eb2ed84b62f7df217249b4028192761589806cefeb1581993142261d477c","8866cf2c8ec21ecc87247c661ac714893c530429611e8a4e82418e087249d51a","e9b5aab0bb0c0a9344fcbe1c29067619cbca7a1bbb2709e74f42de69c80f6325","52a0d311567fe58d9a4cd41abea5a675916dac3c2af11773fd5c16b3c7e7b40b","dfdd50d67b91db6226e502a606dbecc20520df24ea5864851775fdf865c38091","b29ad06db219d063b4978d63651d6b678c781a794c1646fa97a4aac77dac71e5","716c2b2169808f0707b32b6b3634e9d1f0942bc0ee21234dc5b7bf9e822c0bd5","fd3d924ad166b59d406ea3aed32a29e888ba39b4e9ec9bfa5c90c94d2d4286d5","d8a0e5997cbc810e638d14c0b3bc2875c6932c7a1988eac4efcb86a7f1b6e4f6","cbc7072b3a6c6859e19012b3076008ff30fb4d34bcfae365f7293ebd199bd8c1","5bae18e9b45243ff90e6037ea7d0d479c95b8346ead11ebcf095185ff03437ab","ee444f1ef63ac02db842a2bc2e12dc05a32012798f2c87e230a5d6c6448e5d2f","5de8e7869ec90b3ad777e11eb4fdce6fc41c1123cd68ddf64f0e250d70c55e66","e1aa3b8c0a0b7f1650c6090c410e84e10751bd8a0beeed903232bda82a05495c","0fcf6cbfad0d83e5449c264ba8f46762a1da81c3aa1566fd15f3cd3f37b1bef6","5da57ff01c575fe6cae0334fe8e091c9bb900f3187912d405fcb4853bc8605ea","94a35001eed05d9bef5639d5769a8eeefdceb6eaa646cf5268825d3b508ae497","8a1df31e0b4e884abbd9aa3df68eca74aa8a449fa7c4cf6fe148b3af0578b136","f1d503d40c9a3ce46b7a067739441ac77caf97244c16cab3e828c49a800e4fd5","d2068c65c59cb80c008cf55f78c5e7c5fd8a6348dad3e003bb3d441e57d2c2e3","9bb1356fcc020266eff25d7845382cf32b81beba6f015b559433bf6fdec7b8b2"],"paragraph_range_zero_based":[4008,4031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p4008"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For Model A discovery, upon discovery message reception, remote UE considers a relay UE as a candidate relay UE if the SD-RSRP towards the relay UE is above a configured threshold.","paragraph_zero_based":4032},{"literal_text_all_w_t_and_m_t":"For Model B discovery, upon discovery response messages reception, the source remote UE considers a relay UE as a candidate relay UE if the SD-RSRP towards the relay UE is above a configured threshold.","paragraph_zero_based":4033},{"literal_text_all_w_t_and_m_t":"For integrated-discovery, when receiving DCR message from one or multiple relay UEs, the target remote UE should consider candidate relay UEs towards which the SL-RSRP is above a configured threshold to respond and that satisfy upper-layer criteria, and select a relay UE from among them.","paragraph_zero_based":4034},{"literal_text_all_w_t_and_m_t":"For non-integrated U2U relay discovery model B, when relay (re)selection is triggered at the remote UE, the discovery transmission may be triggered at the same time to search for candidate relay UEs.","paragraph_zero_based":4035},{"literal_text_all_w_t_and_m_t":"Approved LS to SA2 on announcement of neighbour UEs in R2-2306697.","paragraph_zero_based":4036},{"literal_text_all_w_t_and_m_t":"Separate thresholds for SL-RSRP and SD-RSRP are configured for the trigger of U2U relay (re)selection. ","paragraph_zero_based":4037},{"literal_text_all_w_t_and_m_t":"Besides the PC5 link quality, RAN2 does not pursue other AS criteria for relay (re)selection.","paragraph_zero_based":4038},{"literal_text_all_w_t_and_m_t":"For the E2E SL-SRB configuration of U2U relay, specified PDCP configuration is used. FFS for the SRAP and PC5 RLC channel configuration for SL-SRB.  ","paragraph_zero_based":4039},{"literal_text_all_w_t_and_m_t":"AS layer is responsible for QoS split in L2 U2U relay.","paragraph_zero_based":4040},{"literal_text_all_w_t_and_m_t":"Relay UE is responsible for AS layer QoS split in L2 U2U relay. ","paragraph_zero_based":4041},{"literal_text_all_w_t_and_m_t":"For OOC U2U relay/remote UE, pre-configuration is used for the E2E SL-DRB and per-hop PC5 RLC channel configuration.","paragraph_zero_based":4042},{"literal_text_all_w_t_and_m_t":"For RRC_IDLE/INACTIVE U2U relay/remote UE, SIB is used for the E2E SL-DRB and per-hop PC5 RLC channel configuration.","paragraph_zero_based":4043},{"literal_text_all_w_t_and_m_t":"Authorization for L2 U2U relay operation is supported. ","paragraph_zero_based":4044},{"literal_text_all_w_t_and_m_t":"The support of authorization for L2 U2U relay operation does not mean the dedicated configuration for U2U relay has to be supported. Whether the dedicated configuration for U2U relay is supported or not is FFS.  ","paragraph_zero_based":4045},{"literal_text_all_w_t_and_m_t":"Authorization for L2 U2U relay operation includes: 1) whether the UE is authorized to act as a 5G ProSe Layer-2 U2U Relay UE; 2) whether the UE is authorized to act as a 5G ProSe Layer-2 U2U Remote UE.","paragraph_zero_based":4046},{"literal_text_all_w_t_and_m_t":"Authorization for L3 U2U relay operation is not supported. ","paragraph_zero_based":4047},{"literal_text_all_w_t_and_m_t":"The legacy authorization for “5G ProSe Direct discovery” and “5G ProSe Direct communication” can be reused for L3 U2U remote/relay UE.","paragraph_zero_based":4048},{"literal_text_all_w_t_and_m_t":"Approved Reply LS on ProSe Authorization information related to UE-to-UE Relay operation in R2-2306889.","paragraph_zero_based":4049},{"literal_text_all_w_t_and_m_t":"For the possible use of a short ID in U2U relay, RAN2 will downselect between the following options for identifying the source and destination remote UEs at the SRAP layer:","paragraph_zero_based":4050},{"literal_text_all_w_t_and_m_t":"a)Single ID, identifying the source and destination remote UEs","paragraph_zero_based":4051},{"literal_text_all_w_t_and_m_t":"b)Source ID and Destination ID","paragraph_zero_based":4052},{"literal_text_all_w_t_and_m_t":"For the possible use of a short ID in U2U relay, the U2U relay UE performs the ID assignment. FFS if this ID should be assigned hop-by-hop or globally.","paragraph_zero_based":4053},{"literal_text_all_w_t_and_m_t":"These agreements do not imply agreement to use a short ID.","paragraph_zero_based":4054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["4a8d06c8f36569fdee34e78deb2dfe73654e3f11240c4adf79d07075dcdaa7de","9754036f22cf79c14113465af0409cadaa2272eed096c2d750db00292f27cfb0","1a71061b6196da8bb45e5db34b145a9e47bcee14955560150ac0fc355f5f8348","0b26be9a24b24119cf3db5b1385ff4b8d2439038c4a0fde21b66e48349df7987","a59ce6efb2201eb65f96fcc347ea859f7916682ba2e7c53d24d25b41fb2b818b","4a53b6a154dfb3bb4e0b240152c025e4f04c9998b2164beaea5bfcee201e6ad1","9efc2a0c7e40d2448ba98d58cc4d68295372d76644a3bf56c1271c2997622c86","b052dcf3079f126769de6921ea1afcf4e6125dfc3ebac3232b9348e523f1c8d7","18b51f020419d9eec21c9e320c398b38434298d465e58dcfca6d1037e7af9084","7994c09ab79a1283fa49718c9bc6d178e41e1a868b1f4be1e913434a3acdf3ad","b7d49ffd1f03b0e4b8f3caa2f9184d4523d9058d116f943de9c47706ab048593","8a3504b6de48d9d395f13260c03f5cdbfb265d7c77a0008ff630fe9a3a5540c5","d126858b84f479490d6d4384a1b04afb12496035b3838433d38c6fd703112bd2","831141f8d8beff3d60e9d688c04200f982e1301a42737dd8deda8aa7c8d6c3a6","bd405f841da94384e71dc1bd37175be053a40869c14fe584a7b04e701fe0eedd","5f9423c54bfdd724e9dc08f65486ce058a1d28d26f72167455fd29f7c29c9442","0ab9c9d9ef706947b19bc9235a2ca9b60b92697f1bb7a676711f1adadc378e74","edd847027185ef809872b940aa7c8912e75dd3001b42ee9dba5699020d2e1e26","0004abebedbf02cdb9c14421611a98016b6c344eae6f27e626816e4efc13f683","f76315363d26a4cdc56478d52ee70bf1381a95240ba9be07d0f653792d8536c7","6567f5a99fd571c660750da29d084bf2d1c503353bf7667c35b4d16bb1dd3590","ce2c584e3fc82555c61d3c666c6fa3de7682b4fa53c8ca51fa97ca570d5d43de","f834fc8eef88971ceccfaeb969d0227eda9b18c787a5b53d0205b77f7b1c8b39","2ef944cad403f9a603fc18323145745b2eb088461ecf91d08213c549e89ca079"],"paragraph_range_zero_based":[4032,4055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p4032"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RAN2#121bis-e Agreement","paragraph_zero_based":4056},{"literal_text_all_w_t_and_m_t":"For the integrated-discovery case, the relay UE forwards the discovery message for DCR message with integrated Discovery case only if the PC5 RSRP between the relay UE and the source remote UE is above a threshold.","paragraph_zero_based":4057},{"literal_text_all_w_t_and_m_t":"For Model-B discovery, after receiving a discovery message from a relay UE, a target remote UE transmits the discovery response message only if the PC5 RSRP between the target remote UE and the relay UE is above a configured threshold.  FFS if there is separate impact for this agreement from the relay selection functionality.","paragraph_zero_based":4058},{"literal_text_all_w_t_and_m_t":"Both mode-1 and mode-2 resource allocation can be supported on both remote UE and relay UE in U2U relay case.  No impact to legacy resource allocation procedures is expected.","paragraph_zero_based":4059},{"literal_text_all_w_t_and_m_t":"End-to-end PC5 RRC connection between source remote UE and target remote UE is supported, in addition to PC5-RRC connections between each remote UE and the relay UE.  This does not imply support of all PC5-RRC procedures between the remote UEs.","paragraph_zero_based":4060},{"literal_text_all_w_t_and_m_t":"Each remote UE (source or destination) can trigger relay selection based on the direct link quality.  FFS interaction between discovery and selection.","paragraph_zero_based":4061},{"literal_text_all_w_t_and_m_t":"Postpone replying to the SA2 LS on authorization.","paragraph_zero_based":4062},{"literal_text_all_w_t_and_m_t":"Multiplexing of different destinations in the same RLC channel of the first hop is supported.","paragraph_zero_based":4063},{"literal_text_all_w_t_and_m_t":"RAN2 confirms that multiplexing of the different bearers from the different source remote UEs into the same RLC channel in the second hop is supported.","paragraph_zero_based":4064},{"literal_text_all_w_t_and_m_t":"Relay UE determines the egress RLC Channel based on the mapping of E2E bearer ID and egress RLC Channel for a particular pair between source remote UE and target remote UE.","paragraph_zero_based":4065},{"literal_text_all_w_t_and_m_t":"A one-to-one correspondence between end-to-end PC5 RRC connection and end-to-end PC5 unicast link is supported as legacy.","paragraph_zero_based":4066},{"literal_text_all_w_t_and_m_t":"E2E PC5-RRC connection is considered to be established after a corresponding E2E PC5 unicast link is established.  FFS how configurations for e2e SL-SRBs are supported.","paragraph_zero_based":4067},{"literal_text_all_w_t_and_m_t":"WA: E2E bearer ID (i.e., configuration index in the list of SLRB configurations) is used as input for the L2 U2U relay ciphering and deciphering at PDCP.","paragraph_zero_based":4068},{"literal_text_all_w_t_and_m_t":"LS to SA3 to confirm the feasibility of using the configuration index.","paragraph_zero_based":4069},{"literal_text_all_w_t_and_m_t":"RAN2#121 Agreement","paragraph_zero_based":4070},{"literal_text_all_w_t_and_m_t":"For relay UE selection, the remote UE uses SL-RSRP measurements towards peer remote UE to trigger relay UE selection when there is data transmission on direct link.","paragraph_zero_based":4071},{"literal_text_all_w_t_and_m_t":"For relay UE reselection, the remote UE uses SL-RSRP measurements towards the relay UE to trigger relay UE reselection when there is data transmission on the indirect link.","paragraph_zero_based":4072},{"literal_text_all_w_t_and_m_t":"In both cases, it is left to remote UE implementation whether to use SL-RSRP or SD-RSRP for relay (re)selection trigger evaluation in case of no data transmission.","paragraph_zero_based":4073},{"literal_text_all_w_t_and_m_t":"FFS if there need to be different configured thresholds for SL-RSRP and SD-RSRP.","paragraph_zero_based":4074},{"literal_text_all_w_t_and_m_t":"Each Remote UE can trigger Relay reselection based at least on current hop quality. ","paragraph_zero_based":4075},{"literal_text_all_w_t_and_m_t":"RAN2 confirms the user plane protocol stack for L2 UE-to-UE Relay in Figure 5.5.1-1 and control plane protocol stack for L2 UE-to-UE Relay in Figure 5.5.1-2 of TR 38.836 [2].","paragraph_zero_based":4076},{"literal_text_all_w_t_and_m_t":"RAN2 confirms Remote UE E2E Radio Bearer ID should be included in the adaptation layer in first and second PC5 hop.","paragraph_zero_based":4077},{"literal_text_all_w_t_and_m_t":"RAN2 confirms Remote UE determines the egress RLC channel based on the mapping from the E2E bearer ID to egress RLC channel, for a particular target Remote UE.","paragraph_zero_based":4078},{"literal_text_all_w_t_and_m_t":"FFS if multiplexing of different destinations in the same RLC channel is supported.","paragraph_zero_based":4079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["842303374e39f8d67b5edb2d90dfc6cb0b4c20d2cee998380932fd76d748bf86","14876c2ed53e44c360d067e4f325751714e4561a02ce7680ed7c9dce0b394745","1a035d1c739a5b48d9abafb84b1abec269b759205a666f64b5e1ef4f2777167e","e5391ebeb1d5b8df7d84acf03fe58d17847ce4a6a7e50cc144a751f55fbe7502","80ededba4506b44a9cb256dd4c64226a00bcce0e2b101e6000a82e006e0e6aa5","ebf30f2e29c056ab0b4d2dbc13afdcb588fb7067d4f0d9dc9fef8bb5c7ec68f3","aad2506cd875dec012c8b58fac40138bb62aea3f9d617bccd74f4662e359b656","da657f27df5bfa4fa57a191603bfcbe7539377d15db699b618e6541723f90d3f","f18300a6c25fa875e016d8360af1b61e6820bf957a184ae3887601511cf0b103","b20adf7265536e51a09ccf07f5abbe390a97c22b90b7ea76b5deb5b08672c5c9","c7caf3770ac2ba8277ba40687a5ad6a440e9a86a027b91f9eac736149a545c4e","deed187d75103191b3fa6d9394cbf62c35fb48886e03e90ecc303f9ccea6e64d","c4bff4ae87d03dc45268bb29d377d2b903b1c883b16933ee7cd99d691962c56c","6f43ecfeada2664f0e5f660edc1669b111f33fe693a73127b59cb2e8fcb46c62","84690f9ca117963e831e4bb7a334d544a7233eab66ffde61d9a74dd3c99a8d82","a93d11692653cd2a73be31deccc42f78f7dc21ba44341df6d17de7eba5e8495b","2d0c19643f9efc27211c7e387ff775a038ac9000f203538b471b03135338149c","4edb7916cdde97bcb25c4bf18514724c67eaf7a82b8f691378b876c7ef18cef0","33939dfb3b40abd084f4509fe033328013cbb1c66197c0490792e1d5598f3ca3","b4d137871c1e4e37614b5dd9a664ab0941636e827fc2b98d4180db41d197609c","27dcc4be48a3bf15ec1ba0817cab672fda1df949f842817b47630e7b2a51ae57","e507779e682c6da2cd0adeea19e9e3e6d21c680fe2c87e7b4058556d65159781","252ac1faaf5024e1a26b201c89f3349d6fdba7bfddc3e43c5e1f52d643847ef5","2b607f74c1111fc454b2f5e777affd291c4bdb2948eb70e4e3d200ce69cde6bb"],"paragraph_range_zero_based":[4056,4079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p4056"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"An ID mappable to the destination remote UE is needed in the first hop (Tx remote UE to relay), at least in case multiplexing of different destinations in the same RLC channel is supported.","paragraph_zero_based":4080},{"literal_text_all_w_t_and_m_t":"An ID mappable to the source remote UE is needed in the second hop (relay to Rx remote UE).","paragraph_zero_based":4081},{"literal_text_all_w_t_and_m_t":"FFS if the IDs are different (e.g., source and destination UE IDs) or common (e.g., a local ID for the pair).","paragraph_zero_based":4082},{"literal_text_all_w_t_and_m_t":"FFS whether both UE IDs are included in the header or the relay UE does a mapping.","paragraph_zero_based":4083},{"literal_text_all_w_t_and_m_t":"RAN2#120 Agreement","paragraph_zero_based":4084},{"literal_text_all_w_t_and_m_t":"RAN2 to agree that in U2U relay, OOC UEs obtain discovery configuration from pre-configuration and IDLE/INACTIVE UEs obtain discovery configuration from SIB.","paragraph_zero_based":4085},{"literal_text_all_w_t_and_m_t":"RAN2 to confirm that SL-SRB0 is reused for DCR message if discovery is integrated into PC5 unicast link establishment procedure.","paragraph_zero_based":4086},{"literal_text_all_w_t_and_m_t":"UE-to-UE relay selection can be triggered based on the PC5 RSRP (FFS SL-RSRP or SD-RSRP) of the direct link falling below a threshold.  FFS which remote UE (or both) can trigger relay selection.  FFS the relationship between selection and discovery.","paragraph_zero_based":4087},{"literal_text_all_w_t_and_m_t":"UE-to-UE relay reselection can be triggered based on the PC5 RSRP (FFS SL-RSRP or SD-RSRP) between a remote UE and the relay UE falling below a threshold.  FFS which remote UE (or both) can trigger relay reselection.  FFS if/how the second hop between the relay UE and the peer UE is considered.","paragraph_zero_based":4088},{"literal_text_all_w_t_and_m_t":"RAN2 does not agree T400 as a new relay reselection trigger because it is already considered when determining PC5 RLF to trigger relay reselection.","paragraph_zero_based":4089},{"literal_text_all_w_t_and_m_t":"When the remote UE receives PC5-RLF indication from the U2U relay UE, it would inform upper layers and rely on upper layers to trigger relay reselection (or not).  FFS if there would be any constraints on the remote UE implementation behaviour to keep or release the PC5 link with the relay UE.","paragraph_zero_based":4090},{"literal_text_all_w_t_and_m_t":"RAN2#119bis-e Agreement","paragraph_zero_based":4091},{"literal_text_all_w_t_and_m_t":"RAN2 postpone discussion of authorization for UE-to-UE relay and intend to reply to the SA2 LS in R2-2209357 when there is progress.","paragraph_zero_based":4092},{"literal_text_all_w_t_and_m_t":"In UE-to-UE relay, the remote/relay UE in RRC_IDLE/RRC_INACTIVE or OOC can acquire discovery configuration as in Rel17 (i.e., cell-specific configuration/preconfiguration). FFS if any restrictions specific to UE-to-UE relay are introduced for in-coverage UE in RRC_CONNECTED.   ","paragraph_zero_based":4093},{"literal_text_all_w_t_and_m_t":"Protocol stack for U2N Relay discovery is re-used for U2U Relay Discovery ","paragraph_zero_based":4094},{"literal_text_all_w_t_and_m_t":"U2U Relay re-uses SL-SRB4 (with associated PDCP, RLC procedures and configuration) to carry discovery messages ","paragraph_zero_based":4095},{"literal_text_all_w_t_and_m_t":"Both shared and dedicated resource pool can be used for U2U discovery transmission and Rel-17 pool selection principle is re-used. ","paragraph_zero_based":4096},{"literal_text_all_w_t_and_m_t":"SL-RSRP and SD-RSRP can be used for relay selection/reselection criteria.  FFS when each of the two quantities are used and whether to re-use the criteria in Rel17.Relay selection triggers include at least 1) Upper layer trigger; 2) PC5 signal strength conditions.  RAN2 further discuss details for trigger 2).","paragraph_zero_based":4097},{"literal_text_all_w_t_and_m_t":"Relay reselection triggers include at least 1) Upper layer trigger; 2) PC5-RLF detection at the remote UE; 3) PC5-RLF indication received from the relay; 4) PC5 signal strength conditions; 5) PC5 link release message from relay to remote.  RAN2 further discuss details for trigger 4), potentially including T400 expiry.  FFS if some of the conditions could be indicated to upper layer instead of directly causing reselection.","paragraph_zero_based":4098},{"literal_text_all_w_t_and_m_t":"RAN2 will strive to simplify the gNB involvement in U2U-relay-specific operation as compared to the U2N case.  Details are FFS, including whether some gNB control is needed for the in-coverage scenario and how/whether the gNB involvement can be simplified compared to U2N.","paragraph_zero_based":4099},{"literal_text_all_w_t_and_m_t":"Rel17 SI assumptions on RRC state and coverage scenarios can be re-used.","paragraph_zero_based":4100},{"literal_text_all_w_t_and_m_t":"Discovery message transmission at the remote UE is conditioned on at least upper layer indication.","paragraph_zero_based":4101},{"literal_text_all_w_t_and_m_t":"RAN2#119e Agreement","paragraph_zero_based":4102},{"literal_text_all_w_t_and_m_t":"RAN2 confirm that the Scenario, Assumption and Requirement in section 5.1 of TR 38.836 apply for UE-to-UE relay support, with below clarifications:","paragraph_zero_based":4103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["03d843cdc73ef4c062c48c65170fe921eaf17a2f193018c5d586e9cfe4401ddd","adfd02fdd1400507a5db09e02128fd0ad4c6d8b0aeacae0faaa6bac471e7bd11","03323ee95de70eef6ebf63d12eb554995506dbba6b27196f204bb100daf59c58","1e2592b8f2215aeea7079d05b15d63fb38aef14ab20281379e8e9ddd343c0690","92b27c9aef1a1bda26d49828558f2fbb3540f81efe632d0a9d144f1576acfb79","2d833ebeee5ff59a244f27ac7dbc0a0e02dadd6271b8acd190b807082de98ef6","d31d1e5c9cb42a2439407077d5ffeaf4313639a501361ffd6e87c58015e2fdf4","635cc26ad49ffc76b3da5b95035f90f7e1ee76a4665f62a6bafb3b18270ab5c3","afae73fa47f5ef7f5a24faf724277af2ee9ac2cc42b6a68a9cd9ec6c5c150753","129f62a8c5d42ca1ff34da019d5472d874be30975a6866d8b0d78e4509637ad0","e61a9b84287d8cf90d93a276cf9f5853b9de19e344ebcccdc2aa0160f0e9a84b","36945960393f0ea4d26b1def3838dec4738116f0feca355a8b56ad9387baf274","1407831adddc6419df7efbe8cf1be81843a30da8f39ee6d09dead90c536c0d0f","05913c62280848b71a4cbabe36b013dcb1d47b7af78adc344c1a265491a6af99","076274ca92fd2acc0e9cf37751db0e04774b05466c58f9bd28100afa86d0247f","8b687e5236e9256488cfc3fecceef758bfe79fcaeb13c1b4d4c8e87936f6cb7e","236284bc841d5c997b450643037488bbb4e2489f40c195e1bd8bb9c1880628cd","37978a2060016ec464720203da00cf989f8c4f024035225316295c09a01a3bb0","9b00003819e936952134cf166d59a9c6e005577e029fa5e1e06c2bad16e40430","98cbef6b10beb2859dda5abfa420cc5a2b79c1f9b29aef2252dc9a891b37a7d5","a7fe5501424443442db8a35aabfbac5f2e7d5b705db7372dd4ae2c81d48266c1","671842b4fafb52e383c5109b83715114d8079e34c46f7099bacca671c0ca1eac","e48beb1f88a9247421873ff7264576b08aa39daf5d7d36b28f2355ba79da1030","0a0fe8f0240c1fa00034048b684a061448ba722f21b57a54bf04d36c931a9cf8"],"paragraph_range_zero_based":[4080,4103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p4080"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For cast type on UE-to-UE communication, only unicast is considered","paragraph_zero_based":4104},{"literal_text_all_w_t_and_m_t":"FFS if coverage and RRC state aspects need to be revisited in light of the existing U2N support.","paragraph_zero_based":4105},{"literal_text_all_w_t_and_m_t":"RAN2 will follow SA2 decision on the discovery model including cast type.","paragraph_zero_based":4106},{"literal_text_all_w_t_and_m_t":"gNB will not configure a Uu RSRP threshold to be used by U2U Relay or Remote UE to determine whether to transmit U2U discovery signalling. FFS what conditions would govern transmission of the discovery signalling.","paragraph_zero_based":4107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":4108}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["10514be03edd17e8c195aa5bbd9a4beddae12d4784365bd61049327963a01ed3","62894ea0bc3b7f52a575863dba4333d139fbeec55d0855e5c65431af77e0dfc9","ccd8344ec225cbaa16bdaf62fed9354353374684adccd97fceb665164e058043","5eb8f25c1ad2b96bb40151cb6fd89f09bf022be52631cfe8298ec1719c4b5730","2c105c1f1d6327bd7cc8965b4db25d9241ce2001c44ab59320f2eecc22fcbe0b"],"paragraph_range_zero_based":[4104,4108],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p4104"}
