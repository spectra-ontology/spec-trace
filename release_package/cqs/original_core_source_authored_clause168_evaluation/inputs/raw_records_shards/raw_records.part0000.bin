{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21192},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21193},{"literal_text_all_w_t_and_m_t":"aperiodic","paragraph_zero_based":21194},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of aperiodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":21195},{"literal_text_all_w_t_and_m_t":"gapSetup","paragraph_zero_based":21196},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new MUSIM gap. The field is optionally present, Need M, otherwise.","paragraph_zero_based":21197},{"literal_text_all_w_t_and_m_t":"periodic","paragraph_zero_based":21198},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of periodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":21199},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21200},{"literal_text_all_w_t_and_m_t":"–NeedForGapsConfigNR","paragraph_zero_based":21201},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsConfigNR contains configuration related to the reporting of measurement gap requirement information.","paragraph_zero_based":21202},{"literal_text_all_w_t_and_m_t":"NeedForGapsConfigNR information element","paragraph_zero_based":21203},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21204},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsConfigNR-START","paragraph_zero_based":21205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21206},{"literal_text_all_w_t_and_m_t":"NeedForGapsConfigNR-r16 ::=        SEQUENCE {","paragraph_zero_based":21207},{"literal_text_all_w_t_and_m_t":"    requestedTargetBandFilterNR-r16       SEQUENCE (SIZE (1..maxBands)) OF FreqBandIndicatorNR            