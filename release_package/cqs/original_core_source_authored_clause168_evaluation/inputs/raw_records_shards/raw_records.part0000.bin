{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2616},{"literal_text_all_w_t_and_m_t":"DL-SelectedPRS-ResourceSetIndex-r16 ::= SEQUENCE {","paragraph_zero_based":2617},{"literal_text_all_w_t_and_m_t":"nr-DL-SelectedPRS-ResourceSetIndex-r16INTEGER (0..nrMaxSetsPerTrpPerFreqLayer-1-r16),","paragraph_zero_based":2618},{"literal_text_all_w_t_and_m_t":"dl-SelectedPRS-ResourceIndexList-r16SEQUENCE (SIZE (1..nrMaxResourcesPerSet-r16)) OF","paragraph_zero_based":2619},{"literal_text_all_w_t_and_m_t":"DL-SelectedPRS-ResourceIndex-r16","paragraph_zero_based":2620},{"literal_text_all_w_t_and_m_t":"OPTIONAL--Need OP","paragraph_zero_based":2621},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2622},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2623},{"literal_text_all_w_t_and_m_t":"DL-SelectedPRS-ResourceIndex-r16 ::= SEQUENCE {","paragraph_zero_based":2624},{"literal_text_all_w_t_and_m_t":"nr-DL-SelectedPRS-ResourceIdIndex-r16INTEGER (0..nrMaxNumDL-PRS-ResourcesPerSet-1-r16),","paragraph_zero_based":2625},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2626},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2628},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2630},{"literal_text_all_w_t_and_m_t":"NR-SelectedDL-PRS-IndexList field descriptions","paragraph_zero_based":2631},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-FrequencyLayerIndex","paragraph_zero_based":2632},{"literal_text_all_w_t_and_m_t":"This field indicates the frequency layer provided in IE NR-DL-PRS-AssistanceData. Value 0 corresponds to the first frequency layer provided in nr-DL-PRS-AssistanceDataList in IE NR-DL-PRS-AssistanceData, value 1 to the second frequency layer in nr-DL-PRS-AssistanceDataList, and so on.","paragraph_zero_based":2633},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexListPerFreq","paragraph_zero_based":2634},{"literal_text_all_w_t_and_m_t":"This field provides the list of addressed TRPs of the selected frequency layer. If this field is absent, all DL-PRS Resources of all TRPs of the indicated frequency layer are addressed.","paragraph_zero_based":2635},{"literal_text_all_w_t_and_m_t":"nr-SelectedTRP-Index","paragraph_zero_based":2636},{"literal_text_all_w_t_and_m_t":"This field indicates the addressed TRP of the selected frequency layer. Value 0 corresponds to the first entry in nr-DL-PRS-AssistanceDataPerFreq provided in IE NR-DL-PRS-AssistanceData, value 1 corresponds to the second entry in nr-DL-PRS-AssistanceDataPerFreq, and so on.","paragraph_zero_based":2637},{"literal_text_all_w_t_and_m_t":"dl-SelectedPRS-ResourceSetIndexList","paragraph_zero_based":2638},{"literal_text_all_w_t_and_m_t":"This field provides the list of addressed DL-PRS Resource Sets of the selected TRPs of the selected frequency layer. If this field is absent, all DL-PRS Resource Sets and Resources of the indicated TRP are addressed.","paragraph_zero_based":2639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["69cea35dbc530d33264d0b0a7c13d0061468462f9fc91904425e2fc55bd1c8a9","0c328a3204f40d739c0e7a6cd8beeba42fc337999b3f2dd70dd78cdd1e6b684f","0d4b06799c6649df19f982417562ee35864caef4f44487f5fb54f1cd91db8768","2d484bf38d427ecb9dfb94ae613aac180796d49840e8410730f3d3aa94337e9d","9bbd40bea1aea6824445cd121063d58a6880cbe72250b9d039a5679d472afede","91e43f9492105e916542cedbb64f441a551cab5cfd3c4