{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SNPNStand-alone Non-Public Network","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"SpCellSpecial Cell","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"SRAPSidelink Relay Adaptation Protocol","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"SRBSignalling Radio Bearer","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"SRSSounding Reference Signal","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"SSBSynchronization Signal Block","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"TAGTiming Advance Group","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"TDDTime Division Duplex","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"TEGTiming Error Group","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"TMTransparent Mode","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"TMGITemporary Mobile Group Identity","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"U2NUE-to-Network","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"UDCUplink Data Compression","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"ULUplink","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"UMUnacknowledged Mode","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"UPUser Plane","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"VRVirtual Reality","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"In the ASN.1, lower case may be used for some (parts) of the above abbreviations e.g. c-RNTI.","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"4General","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"4.1Introduction","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"This specification is organised as follows:","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"-clause 4.2 describes the RRC protocol model;","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7ba92b53efeecbc86d8177cc357bd49b146db8ebd1589f57dc8b1265735dfffc","b0db1cea07583ace1df187b745411deb9c1d7746d5f8a73c08fd42ee4aacbadb","402435f953ace8933b2d122e046d95cec99686a10c5b2230528f89125693cf2a","8fe70d1cd6b70e418716b595d30d2131b2787efd5e4ecf8ddfb9d3dcb46ae251","86f3cacc4e861e04533f9966aa6f2ad14f9740076425a3a378a8b534571ceac1","5fc9e7942a5b3146aaebb74dc38daf6939d7eb33b8d110d2fc57767feea28c37","3a899a4787c039078ae7303399b24098b914d013da1ee89aaf6eb63f4c7406a8","fb7321625e940ba9e27175da04df2f94db6fdfd63ee37d7dbc9d6926eedb9c89","04dafb0a9e69adedb7bb235d5a01624285df0b2eecf1ebe823fa1eb5ebf6a08a","efa63643b8dba7e27a1068d78df0c9881a92b11705366586b94dcfd1908f9625","8ea5cdc1b29b03148053eff2eacd0cde0144d47df159c777347e3fb5b48b1a1a","0ab6d5abac7cd09e1b35b2508edc9a3226cfec60057e75f5c96892877bbb9d61","330d9a4cbead07cba401a41d0dd4f0651ec8fd6797367c3add3b78ba92615610","56b86cce65c9ac4449c7e0c60807216422e9aeabed74e599a4b3fb5ef149b2f6","5079153c44e9608afc6e2a4b4f5ce49142b94a8758a266c1d45a88e4b13eaac3","9532ec296cde44e9d20e8cf8977da179065fc503a5eb08fd1d297f37a1818e5d","701afc62dcc31a48189f5b77732b50367595e467e212d78e3bb0fd6c340e9fb5","a5d25fdb3f69b4a46788111f753a100d721d75f9b73171cdcb9d9a9683580ee8","c73941f0315ab469f8b15bb93d046e27bb09197461e02c5f72bab73a7146bebd","0eb931a8b14e0ac49d2ea0ba16957d4228128295e8d79ff2dba3369d33eb64c0","d11d373ae80876036e70e293bf51297506fbeaf5a7907ccb0574949aef33edfa","1534765744579979c737e0c6d0bc9bc39d1babf9fdf64d98beac0349aadf3a94","ee9e69b081c34e2c537ba208f3092b9a6481fcae70a23328ab2db1b6b20f38df","b0902499e1cdde4cf97687ef5068b2a73a70d856925357784426f2b6e6dfa376"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-clause 4.3 specifies the services provided to upper layers as well as the services expected from lower layers;","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"-clause 4.4 lists the RRC functions;","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"-clause 5 specifies RRC procedures, including UE state transitions;","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"-clause 6 specifies the RRC messages in ASN.1 and description;","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"-clause 7 specifies the variables (including protocol timers and constants) and counters to be used by the UE;","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"-clause 8 specifies the encoding of the RRC messages;","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"-clause 9 specifies the specified and default radio configurations;","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"-clause 10 specifies generic error handling;","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"-clause 11 specifies the RRC messages transferred across network nodes;","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"-clause 12 specifies the UE capability related constraints and performance requirements.","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"4.2Architecture","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"4.2.1UE states and state transitions including inter RAT","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"A UE is either in RRC_CONNECTED state or in RRC_INACTIVE state when an RRC connection has been established. If this is not the case, i.e. no RRC connection is established, the UE is in RRC_IDLE state. The RRC states can further be characterised as follows:","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"-RRC_IDLE:","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers;","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast;","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"-Monitors a Paging channel for CN paging using 5G-S-TMSI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, monitors a Paging channel for CN paging using TMGI;","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"-Acquires system information and can send SI request (if configured);","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"-Performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cb1ed92f73d0d286c50b31a3b7fef6dffe602c1b55f54876dfcad8409f31855d","f7327aae95db9b63607b833e49447503bdce07e47ca1c8b05e1cee5d1108324f","27b1ee107195d580b87da47fb4cbf202c4377b952e72d49303988671d95f6feb","370a5b299b681adf27f06eddeb5bc77cc252b29e79c57dafacb60591ab9b2566","ac8ab906b954f33006d1eaeb0380b75d84d07bedd0f76b2e1b81c7d530d1e50e","63c5285ce6a848d5442b96d48826dddfadb579d8b2eae1355f0e2d955a9b6b41","7d4c5ea91e68e487e94ff9e363519fc5a05cf0e523330509d938131daf78002e","0d451363457504179d68473c0deaa174297bab218c59d30b3efe345bc72b96ff","a0f05508587dc3f713b8cc0b05d4a22d503e3ce9d8a1797815291d1b6bbeef9b","66b49e4dd027bb4c827df4a2f755652a064a4067aab5e6171be9efbbbd5ca65b","c3b48adbf5fbceafe50d7ba303e65b3343d83ee3ea048cf38466b3aeb00baf96","3b64bc36eaa013c0addd5d96159f4bf133b6b20a21f0fd95bf1eb2cc87eb9ed0","7f675f10fbc65ae8757d102b8acb7482236331278ff2a8bae8d0638b75aaebbc","9bb169903fac2fcce7d4b09c9cdb9700443a7f9075d75ae60dd52305378bf8b4","7e246a4783a19972bfe9d99fd4ffe49d24120726bfaef1b850c472147cb2930f","eeb8a8e1f6078c6cbdff17381017439a399d84de05db65db496227397acd119e","3437c02cef9441409c981c230c4c56d79ce150c28f2a06ee383f61606a772cf6","856b6dbffe1153504bf2af93258bac78044482ec2ce2656b986d47be61971898","f4b5c4a659bb3cc17028f36dfd1020318a0419c4de577bbf358f78be66d836c8","a784e4d155bc55501b0917aa4944ae1e1319f58b9e50822e8dd1d629f66f9418","fc659f4047d9b8063583542c92b8973eacb7ec3ae418bd574b6a3f6d06053b25","f09e0495101c32f4064e77ac68cd2508a40682ad55586d371a83d85916e665f6","4b04a46cd8523b52963a7355d507f76ce7bb4f928f4b4d7e5ef620f3f7214af4","43787aa52fdb35b88f1a3e71fe84508dcd48512343c7c8872704d44acc922e94"],"paragraph_range_zero_based":[408,431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p408"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"-RRC_INACTIVE:","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"-A UE specific DRX may be configured by upper layers or by RRC layer;","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast;","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"-UE controlled mobility based on network configuration;","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"-The UE stores the UE Inactive AS context;","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"-A RAN-based notification area is configured by RRC layer;","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data and/or signalling to/from UE over radio bearers configured for SDT.","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5);","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"-During SDT procedure, monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, monitors a Paging channel for CN paging using 5G-S-TMSI and RAN paging using fullI-RNTI, except if the UE is acting as a L2 U2N Remote UE;","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS multicast reception, while SDT procedure is not ongoing, monitors a Paging channel for paging using TMGI;","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and cell (re-)selection;","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"-Performs RAN-based notification area updates periodically and when moving outside the configured RAN-based notification area;","paragraph_zero_based":447},{"literal_text_all_w_t_and_m_t":"-Acquires system information and, while SDT procedure is not ongoing, can send SI request (if configured);","paragraph_zero_based":448},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs logging of available measurements together with location and time for logged measurement configured UEs;","paragraph_zero_based":449},{"literal_text_all_w_t_and_m_t":"-While SDT procedure is not ongoing, performs idle/inactive measurements for idle/inactive measurement configured UEs;","paragraph_zero_based":450},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data;","paragraph_zero_based":451},{"literal_text_all_w_t_and_m_t":"-Transmits SRS for Positioning.","paragraph_zero_based":452},{"literal_text_all_w_t_and_m_t":"-RRC_CONNECTED:","paragraph_zero_based":453},{"literal_text_all_w_t_and_m_t":"-The UE stores the AS context;","paragraph_zero_based":454},{"literal_text_all_w_t_and_m_t":"-Transfer of unicast data to/from UE;","paragraph_zero_based":455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["67d42c82817102d6cb82b610d65d3fd7a437fdbd431c774df23bfca6277521a2","9924dd147bd1313ee218ff106ebe69b2cda2c77e7ecc3742d00d646d26483496","a95c493f6876386fce4775ef4d6b616586f0ff08a084d239fd2fddb885150d9b","48641322235c1d771a26fcd4b1543cf5a821bd99de53bc276e8025fa95e988a7","98e2e3d1d0fb3ac5f17d722bcd377c9fbf4d1d75b3c9bc1a5a8589a312037612","e0483b50f2d73b99e2bf7b95cae91554d4d6ebbf425e7f8d2b8235858b78d444","18df534b3dda81654f207cfe5a796e298beef6b783a4259c3c2154238599882c","f9e1cfd4fc849ed36ff7d39b9b2b30fdc4fcd9031debb98f1d10c0f9214763ca","1694a5664d887d31828f71f7351c145d86050676dad15df6a25495c5b09f0d26","32f19a834aad43f9862e3790bb2e2e36ba80d60eefa76ce8342beb1233bbcfb4","7ce7350064138d856b7f707eddfed23af9443aa301582507b407a5c1d670574e","4b3326fae96efbc69d1aaeb378de2bda5afc8fe8289b4ba011222d2dd908cd6b","af91a6547d1ca2f286b7e47998d39cd3eb275e375f2c23d17e6b6a5c4b995025","f8e8170328410faad62fcf23b94f644d4fe18d9855261730ef587689bd89570c","10dce5526bba9bbafd3702316b161087b1b4e893f4783ea3237bcecb1e323a92","cfe67189a0ba5f9bfdb3e757167d3526a8cfba0f26c04ecf6eea0032de8563b9","5192523d51f9d59689cd7f56542b325bdc0b53b8d1b0506ad15fc2be642b639a","1e3e8f633336ab7fcd34af00a4b762ec9dcfa558194a1ff49ae12641cef6eefc","b1bd59caa7c6232cb92285e2c13f19852fba856b9b81962ebc6f76ced322fc2e","74b1247663c345da3ce1488168dd1e370cf790fe2b1fb6d994977c593df77007","915afdf187d112242110d7d681de68096f47a8d4e91b5867bf416c0cc64b05cc","549f54d68fb02bca8a7f1be39fbbfc559004d0e7961b49ea94abb3930561d0d1","d007fba815c9a7651b2562d920673249a1325fc286c4b0e3392b986c60d43591","aeee2d159b6b8b41657838aa851b0a41784b7c595f0836d2c76808e947ef5c38"],"paragraph_range_zero_based":[432,455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p432"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Transfer of MBS multicast data to UE;","paragraph_zero_based":456},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a UE specific DRX;","paragraph_zero_based":457},{"literal_text_all_w_t_and_m_t":"-At lower layers, the UE may be configured with a DRX for PTM transmission of MBS broadcast and/or a DRX for MBS multicast;","paragraph_zero_based":458},{"literal_text_all_w_t_and_m_t":"-For UEs supporting CA, use of one or more SCells, aggregated with the SpCell, for increased bandwidth;","paragraph_zero_based":459},{"literal_text_all_w_t_and_m_t":"-For UEs supporting DC, use of one SCG, aggregated with the MCG, for increased bandwidth;","paragraph_zero_based":460},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility within NR, to/from E-UTRA, and to UTRA-FDD;","paragraph_zero_based":461},{"literal_text_all_w_t_and_m_t":"-Network controlled mobility (path switch) between a serving cell and a L2 U2N Relay UE, or vice versa.","paragraph_zero_based":462},{"literal_text_all_w_t_and_m_t":"-The UE:","paragraph_zero_based":463},{"literal_text_all_w_t_and_m_t":"-Monitors Short Messages transmitted with P-RNTI over DCI (see clause 6.5), if configured;","paragraph_zero_based":464},{"literal_text_all_w_t_and_m_t":"-Monitors control channels associated with the shared data channel to determine if data is scheduled for it;","paragraph_zero_based":465},{"literal_text_all_w_t_and_m_t":"-Provides channel quality and feedback information;","paragraph_zero_based":466},{"literal_text_all_w_t_and_m_t":"-Performs neighbouring cell measurements and measurement reporting;","paragraph_zero_based":467},{"literal_text_all_w_t_and_m_t":"-Acquires system information;","paragraph_zero_based":468},{"literal_text_all_w_t_and_m_t":"-Performs immediate MDT measurement together with available location reporting;","paragraph_zero_based":469},{"literal_text_all_w_t_and_m_t":"-If configured by upper layers for MBS broadcast reception, acquires MCCH change notification and MBS broadcast control information and data.","paragraph_zero_based":470},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1 illustrates an overview of UE RRC state machine and state transitions in NR. A UE has only one RRC state in NR at one time.","paragraph_zero_based":471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":472},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-1:UE state machine and state transitions in NR","paragraph_zero_based":473},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2 illustrates an overview of UE state machine and state transitions in NR as well as the mobility procedures supported between NR/5GC, E-UTRA/EPC and E-UTRA/5GC.","paragraph_zero_based":474},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":475},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-2:UE state machine and state transitions between NR/5GC, E-UTRA/EPC and E-UTRA/5GC","paragraph_zero_based":476},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3 illustrates the mobility procedure supported between NR/5GC and UTRA-FDD.","paragraph_zero_based":477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":478},{"literal_text_all_w_t_and_m_t":"Figure 4.2.1-3:Mobility procedure supported between NR/5GC and UTRA-FDD","paragraph_zero_based":479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["81b1d00024bd001f13ae3a178715381a9a903a0c286c5f32c0de509669a8bafd","9473137f36a381f6daab00f4bdb56e124fba393ad9607300fcd97b9715fac6e0","b6993b1aee8a2b83275a875634ff6a7e44ba93ad5edd23d122e82e5e1574f779","413427cb5a5e965a967bc5fb7df49c385f67ad6118f7e31698a341aa9bb856a4","0f919663de8c85259f55d56888343b31742ee5b1295e8c0dce7dca6134bd0e86","fd29a764417010a3506e9158e620b0f85e97e3d7ac6cae547b2bbda602b5d048","bb9c936ca9aaeccb6051059b96e398a056f03549464b6a79c7e790cc75dd7508","704994ea1b1e708b35e68741bfbc07e2757f1dec08c8d1a347675ad1735489ae","a59d34d28c60e858263e48c1c679f8b4b5e7acc278b307cbb965f64cab166425","2ec0338ef64d38418fff2c82faa871372da328626a98e0e514bc5f4b74adc72c","cd9a8edc9f049f184b20d29aab2f23e0c8cc53cdb288587c08379bf0c3989d60","290a616d1667e19e4acadc444d10c9b439a0ed2f26116aaef61878f803dbe480","82528c60835b91f94d7d38db6a0fa1c4976932f76e8f5a29998f87f165c7082c","c7c603ceee5fc8805dee70bf8b58b14e7ab049d916e326e105793721c3b739a8","04dcce834a0044143c893a2cae034edead822226a2966357c101994a4252a145","e5e34518c0bf62761a27f997fd4ac296cf99731762bd7af9c82a030bf5eb3fbf","f54c45830543a629e6587c5055823228bd3251c5c4fb48c68b0e6aa65a14677c","9c589fb0d479a2866ba5d26157e1a39b4761ba2e8729e82b77a78181fb161722","3494c86b845689e822a21f6ea7962c6c2fb5ec5d4d3637f1065549931d1a513b","c18a490181ce5b68aeb140fde515c2ea869883d6779aaca472d0160e96e24684","be685a1ae0326668176e0bbb28de7c906c24d52c5f50728161284daba8a3e394","1d71ab9935199eedf73213eba3d11302d081d160bed5e13a282e13d355b1be5b","2e0408210115442a29232c0f9bc49c0acd155fcba67d5a39c5ba2b6a7456f339","a2b7d53293f2381459f434227019d2dc58e6fadcf3d35d4af941d0e512e5962c"],"paragraph_range_zero_based":[456,479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p456"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":480},{"literal_text_all_w_t_and_m_t":"4.2.2Signalling radio bearers","paragraph_zero_based":481},{"literal_text_all_w_t_and_m_t":"\"Signalling Radio Bearers\" (SRBs) are defined as Radio Bearers (RBs) that are used only for the transmission of RRC and NAS messages. More specifically, the following SRBs are defined:","paragraph_zero_based":482},{"literal_text_all_w_t_and_m_t":"-SRB0 is for RRC messages using the CCCH logical channel;","paragraph_zero_based":483},{"literal_text_all_w_t_and_m_t":"-SRB1 is for RRC messages (which may include a piggybacked NAS message) as well as for NAS messages prior to the establishment of SRB2, all using DCCH logical channel;","paragraph_zero_based":484},{"literal_text_all_w_t_and_m_t":"-SRB2 is for NAS messages and for RRC messages which include logged measurement information, all using DCCH logical channel. SRB2 has a lower priority than SRB1 and may be configured by the network after AS security activation;","paragraph_zero_based":485},{"literal_text_all_w_t_and_m_t":"-SRB3 is for specific RRC messages when UE is in (NG)EN-DC or NR-DC, all using DCCH logical channel;","paragraph_zero_based":486},{"literal_text_all_w_t_and_m_t":"-SRB4 is for RRC messages which include application layer measurement report information, all using DCCH logical channel. SRB4 has a lower priority than SRB1 and can only be configured by the network after AS security activation.","paragraph_zero_based":487},{"literal_text_all_w_t_and_m_t":"In downlink, piggybacking of NAS messages is used only for one dependant (i.e. with joint success/failure) procedure: bearer establishment/modification/release. In uplink piggybacking of NAS message is used only for transferring the initial NAS message during connection setup and connection resume.","paragraph_zero_based":488},{"literal_text_all_w_t_and_m_t":"NOTE 1:The NAS messages transferred via SRB2 are also contained in RRC messages, which however do not include any RRC protocol control information.","paragraph_zero_based":489},{"literal_text_all_w_t_and_m_t":"Once AS security is activated, all RRC messages on SRB1, SRB2, SRB3 and SRB4, including those containing NAS messages, are integrity protected and ciphered by PDCP. NAS independently applies integrity protection and ciphering to the NAS messages, see TS 24.501 [23].","paragraph_zero_based":490},{"literal_text_all_w_t_and_m_t":"Split SRB is supported for all the MR-DC options in both SRB1 and SRB2 (split SRB is not supported for SRB0, SRB3 and SRB4).","paragraph_zero_based":491},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, SRB0, SRB1 and SRB3 are assigned with the highest priority Channel Access Priority Class (CAPC), (i.e. CAPC = 1) while CAPC for SRB2 is configurable.","paragraph_zero_based":492},{"literal_text_all_w_t_and_m_t":"4.3Services","paragraph_zero_based":493},{"literal_text_all_w_t_and_m_t":"4.3.1Services provided to upper layers","paragraph_zero_based":494},{"literal_text_all_w_t_and_m_t":"The RRC protocol offers the following services to upper layers:","paragraph_zero_based":495},{"literal_text_all_w_t_and_m_t":"-Broadcast of common control information;","paragraph_zero_based":496},{"literal_text_all_w_t_and_m_t":"-Notification of UEs in RRC_IDLE, e.g. about a mobile terminating call;","paragraph_zero_based":497},{"literal_text_all_w_t_and_m_t":"-Notification of UEs about ETWS and/or CMAS;","paragraph_zero_based":498},{"literal_text_all_w_t_and_m_t":"-Transfer of dedicated signalling;","paragraph_zero_based":499},{"literal_text_all_w_t_and_m_t":"-Broadcast of positioning assistance data;","paragraph_zero_based":500},{"literal_text_all_w_t_and_m_t":"-Transfer of application layer measurement configuration and reporting.","paragraph_zero_based":501},{"literal_text_all_w_t_and_m_t":"4.3.2Services expected from lower layers","paragraph_zero_based":502},{"literal_text_all_w_t_and_m_t":"In brief, the following are the main services that RRC expects from lower layers:","paragraph_zero_based":503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["26a9c32f36f04b823eae5c9c4776662fc79bfd7d20e18ffa0a7aba57333d7ffd","b93f37e2277dc6584003ac152f0a1f7fce448ed83f52581863d3eed1c25cef44","8e63df9ca75ad3469ccfbc1712aa4999800d4b85f9b08e5e82cf322f340921bd","cba93d589704f9c4f96de44bb0b0d5d738b805e171837db70f2dcdf5fc53e2b8","06c2fe4256176dfd7eefb93cc96b756fbea321f77d91ed39c4056e5916cde3ad","ee929709f515564f202167fc0ffaf820241e31a995a6e6e16c8b989c49235ff3","ad52aeb8843506ad0b3bebf83e13b5817757788d145ba6794c5b4eed864bf6ca","4ab8a35dc6d62f1cc58a2e6ad764e869991778f2a0634433cd897b2f29d8f83a","cf32dc8087dfc0b0af4823bff72455defeb1ff1754082507721264bd27d8cf2e","5c1fbba7e360886d9069bdf6535873e75429ef7af2ac4ecc7416ed2886252f4b","66571a86d11a9ca0479d22100129268e0d618cff1972ca76253ac0f79bf32ac9","fbf5b8d536e7373ca4074cfe8cd72d7f3a671d1cc677c19f9cf9ad9c892a7a57","afc7ecd50e71bb496de889b97e4f3e90a71561cb7b3b892801bc8d0105835395","21bbe886f2a5095f09b63c5fe4c55d515f0588cb31cb64194ce3796cd779834e","5cc53144b7d8195c9c29224c08d7e7d5ef24476bae65b2e74c2cf85c6d208a7d","c9d895152bba5bf341fdaccd67cf62acf55469bb739eb7c9f8274c7685396a88","1c6efe75525651d7c2ad640c8e18d4c7990ff8cb95e63a1da0afe8c44f9e0b30","0d0dbaf46f918e4e88dd1e0db8557665e62642e9a1d7b6cedd875a283305bb7e","ac09d5819a4803c8d548983c1afc653c42308ec2e8c4684d7b0a0c45d6aa3780","d4796750bed4d3dfaf73ed63daaaaa50425024f8bd77bd7a2b158e1ef5b8958e","8a4ad51c5952034036cfe955f2271e43eb48c43f84d55f97b34b2149b6692c04","2c155abbf46cf3ad62187755303ea3f0e2f1dcfe7996a233b2571ea30bab8816","5f4e4b8c82b00c24da3f218ec089fdab097a48263ebd5d771148f127c480e6c0","ef37ab4d8688a59705440b2ca49537d17b8aa0149ef5a2fb0139c53e5965e791"],"paragraph_range_zero_based":[480,503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Integrity protection, ciphering and loss-less in-sequence delivery of information without duplication;","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"4.4Functions","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"The RRC protocol includes the following main functions:","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"-Broadcast of system information:","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"-Including NAS common information;","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"-Information applicable for UEs in RRC_IDLE and RRC_INACTIVE (e.g. cell (re-)selection parameters, neighbouring cell information) and information (also) applicable for UEs in RRC_CONNECTED (e.g. common channel configuration information);","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"-Including ETWS notification, CMAS notification;","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"-Including positioning assistance data.","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"-RRC connection control:","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"-Paging;","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RRC connection, including e.g. assignment/modification of UE identity (C-RNTI, fullI-RNTI, etc.), establishment/modification/suspension/resumption/release of SRBs (except for SRB0);","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"-Access barring;","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"-Initial AS security activation, i.e. initial configuration of AS integrity protection (SRBs, DRBs) and AS ciphering (SRBs, DRBs);","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"-RRC connection mobility including e.g. intra-frequency and inter-frequency handover, path switch from a PCell to a target L2 U2N Relay UE or from a L2 U2N Relay UE to a target PCell, associated AS security handling, i.e. key/algorithm change, specification of RRC context information transferred between network nodes;","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/suspension/resumption/release of RBs carrying user data (DRBs/MRBs);","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"-Radio configuration control including e.g. assignment/modification of ARQ configuration, HARQ configuration, DRX configuration;","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"-In case of DC, cell management including e.g. change of PSCell, addition/modification/release of SCG cell(s);","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"-In case of CA, cell management including e.g. addition/modification/release of SCell(s);","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"-QoS control including assignment/ modification of semi-persistent scheduling (SPS) configuration and configured grant configuration for DL and UL respectively, assignment/ modification of parameters for UL rate control in the UE, i.e. allocation of a priority and a prioritised bit rate (PBR) for each RB of UE and logical channel of IAB-MT.","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"-Recovery from radio link failure.","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"-Inter-RAT mobility including e.g. AS security activation, transfer of RRC context information;","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"-Measurement configuration and reporting:","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"-Establishment/modification/release of measurement configuration (e.g. intra-frequency, inter-frequency and inter- RAT measurements);","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"-Setup and release of measurement gaps;","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["46cb6a21c4a88903826a10f443a0c0bc82f34cfc22ac22c48ee5b25299453bc1","9acca5a5492da82a65c5ef6760830ae180eb628de195d86306732f704df37d20","d290b60c00b344204e7d68cf317d2b491dc91490304d38d1ff1e793ed2bacff3","105553cca61f52c35fd101ba11786b26126a75ee1573385ec7acf3d7398c84da","40e0bc8f3e60241d76fb30112512f4a7c9455bd6b9065b70dbd48fbd9f9b6ce4","a7e8a8d122e3ad59543e76b74c54f4a9228f3fa79064e3c24e772aa4e1cec4fc","fce0902ca597014f74ac1b00d0d03cac1daf46b27726dd1396d1c361267e3a8f","59f82d989fa2ea64956237fda72833eb7c939a9a3f0dd547666ffd20dd4e16b4","3fffed65052aac0f16a0fbc2b7a656ff39322d37ffd27a2a7dc0bed01ccd40a8","3dfa330234ed6375439a31d650dd5045539b32ed34e3a98275e8024c43e33ced","944ad4f2cd1a3ad4f5ab7e6e312fbfcdb5e799ef8d4a3f198a52572b0d0f6c47","fb372f006258a1ff3e38c26a79f32ffeca8b9badf365a707f2557d05f3754019","7b26c3bb23aa42a620246efba457029dcab08dece6d66f872d8325db635c2335","b32fe97438a8bfa38d97a2fa143a5e56120af0c358d67b65c4c5a08ce37bc9ac","84d6e06c9dcfceddd3b0cb2daa5ea3e7f1368823925da38a5cb2b37c93155253","767b11d03f4883adb9874117c1b750920f48024e7c519ecb834fab9f5249bc85","9a3249ab0e7f77a87e7c28b6acaad3d1abf12d149d29fd4dcc5c91ffb2a26480","6a33399f62e095c4c5d84d26d90e2f805c2ad4c2fa86a8cd0dd714797226bc60","77be522afee5029b7ab0ce7269c0e98e796d9b0f6c8219006f77913cdb43ffe1","0bcdf2b560297b0dbdbcad01a12a87f25f484fbeca56966cb089c94dbc422de6","a1fa01466e7ccc07316e98c5709afb0c5a2cf25960e0e0e4600433abdc095f33","5df8b40b1224263c04a595e18cc370ec8befd7ca7caa29a604b6bf9d4c1d823c","9863f7835ad561458487a68b3ffe5ca5a91e77bb4d7ea35ebdba0c3cc0862d97","c433f86243f6f5059b5517f3005b43f2f8827f41ebb758acd760a22b5de6d67d"],"paragraph_range_zero_based":[504,527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p504"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Measurement reporting.","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"-Configuration of BAP entity and BH RLC channels for the support of IAB-node.","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"-Configuration of SRAP entity and Uu/PC5 Relay RLC channels for the support of L2 U2N relay.","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"-Other functions including e.g. generic protocol error handling, transfer of dedicated NAS information, transfer of UE radio access capability information.","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"-Support of self-configuration and self-optimisation.","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"-Support of measurement logging and reporting for network performance optimisation, as specified in TS 37.320 [61];","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"-Support of transfer of application layer measurement configuration and reporting.","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"5Procedures","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"5.1General","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"5.1.1Introduction","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"This clause covers the general requirements.","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"5.1.2General requirements","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"1>process the received messages in order of reception by RRC, i.e. the processing of a message shall be completed before starting the processing of a subsequent message;","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"NOTE:Network may initiate a subsequent procedure prior to receiving the UE's response of a previously initiated procedure.","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"1>within a clause execute the steps according to the order specified in the procedural description;","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"1>consider the term 'radio bearer' (RB) to cover SRBs, DRBs and MRBs unless explicitly stated otherwise;","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"1>set the rrc-TransactionIdentifier in the response message, if included, to the same value as included in the message received from the network that triggered the response message;","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to setup:","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"2>apply the corresponding received configuration and start using the associated resources, unless explicitly specified otherwise;","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"1>upon receiving a choice value set to release:","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"2>clear the corresponding configuration and stop using the associated resources;","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"1>in case the size of a list is extended, upon receiving an extension field comprising the entries in addition to the ones carried by the original field (regardless of whether the network signals more entries in total); apply the following generic behaviour unless explicitly stated otherwise:","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"2>create a combined list by concatenating the additional entries included in the extension field to the original field while maintaining the order among both the original and the additional entries;","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["67d442249bd44ccda08b0ce3c3fa95b43dc6ecfbb9fafa9f61dd3ade315dd1ec","f35d13570c4e6a98ffe8c168fdc05a5cc7493d07344ec55375a1f653e7a20690","f430f3ea6724e4cad10674f08176d475e0593c4496c80fe851e0664b831691d0","8919700fb387411b012251584a3a0ab4f5a05a0d990061126dbd9bc39b7482ef","38aa6d48cd509c927f279ae72341e32988ace3df952725c54b9dc2cffdf570af","417154898ca2fb33ea0546e792a7b3a1a92b4807f9b9b896081269b20f549410","a4f30d437e14b08e3e1102eedc15593e039a955d706be0f94f5874fa3cb0ddf4","4ff1ccc210a2682fc0e740528122b8cc34cd3818f3cb02c7c6da7db2210965cc","be5420b680bc18c13554571360a3c7eebd387d45bab6a349e11c4cfab2b34c22","c0faa7997740dac4927f0ecde827ff13d578530916fb9b81e751165c35aa4501","2cab31b1e4939f754850dba177b29343ff6efb69cbbf31f16a304da0bd1a5001","9b5decff2bf9c57b31198946b12ac60d492938029db065926be46010301b2e6a","331135389e4fe5cf52982f55ec89b4a5705eb38b408cd308d728614df127619a","faa7c7f501e9b0cdac83ae80a48aed668d0777d61085d127802d8b4f0ded5d62","e0afa0b65d39fb7245deaa110010b6716d6cb3facdd4c64d8d0773f5b5152dda","c12bd44c27a20a511f5633e26f2ea1832ffb40eee625ecf2372f72d2de3896cc","55399ea06ce09fd2a3e44963441f8cdc94980edc0ca1ba3876f4292ab2c34eca","00d374ab33b8c8ca1bba35303efff483e977edc949c9f0dab5ae8e9a8291ce75","5b9c0eb6d33743b29d2f5b20722391045aac4099dfebff0518bec30f024e3b31","563ba02cff8f00a67e4239fa74477f5fb85d9c4ebf53a7485dca8d4448a07443","40b0e2ad5d713ddb129398e51534be5434a6caa5ce8e0c9dad0995518219b968","f32de0019c2c5754b392541416f0cd8d30b6a894eeea726e3fe130da58557c81","e3b21bb9cd1d1d55f0015c002671aaf2e766e56f005d57775da3b58d591341e0","2da3b6f4102e9f1262358dba8c907cd275be858ee9c5e8c90d3f1f8a67d45ed1"],"paragraph_range_zero_based":[528,551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p528"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>for the combined list, created according to the previous, apply the same behaviour as defined for the original field.","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"5.1.3Requirements for UE in MR-DC","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"In this specification, the UE considers itself to be in:","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"-EN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to EPC,","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"-NGEN-DC, if and only if it is configured with nr-SecondaryCellGroupConfig according to TS 36.331[10], and it is connected to 5GC,","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"-NE-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to eutra-SCG,","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"-NR-DC, if and only if it is configured with mrdc-SecondaryCellGroup set to nr-SCG,","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"-MR-DC, if and only if it is in (NG)EN-DC, NE-DC or NR-DC.","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"NOTE:This use of these terms deviates from the definition in TS 37.340 [41] and other specifications. In TS 37.340, these terms include also the case where the UE is configured with E-UTRA or NR MCG only (i.e. no NR or E-UTRA SCG) but with one or more bearers terminated in a secondary node (i.e. using NR PDCP).","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"The UE in (NG)EN-DC only executes a subclause of clause 5 in this specification when the subclause:","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-is referred to from a subclause under execution, either in this specification or in TS 36.331 [10]; or","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"-applies to a message received on SRB3 (if SRB3 is established); or","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"-applies to field(s), IE(s), UE variable(s) or timer(s) in this specification that the UE is configured with.","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"When executing a subclause of clause 5 in this specification, the UE follows the requirements in clause 5.1.2 and in all subclauses of this specification applicable to the messages (including processing time requirements), fields, IEs, timers and UE variables indicated in the subclause under execution.","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"Next Change","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"5.2System information","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"5.2.1Introduction","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"System Information (SI) is divided into the MIB and a number of SIBs and posSIBs where:","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"-the MIB is always transmitted on the BCH with a periodicity of 80 ms and repetitions made within 80 ms (TS 38.212 [17], clause 7.1) and it includes parameters that are needed to acquire SIB1 from the cell. The first transmission of the MIB is scheduled in subframes as defined in TS 38.213 [13], clause 4.1 and repetitions are scheduled according to the period of SSB;","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the period of SSB is larger than 80 ms, the MIB is transmitted with the same periodicity as that of SSB.","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"-the SIB1 is transmitted on the DL-SCH with a periodicity of 160 ms and variable transmission repetition periodicity within 160 ms as specified in TS 38.213 [13], clause 13. The default transmission repetition periodicity of SIB1 is 20 ms but the actual transmission repetition periodicity is up to network implementation. For SSB and CORESET multiplexing pattern 1, SIB1 repetition transmission period is 20 ms. For SSB and CORESET multiplexing pattern 2/3, SIB1 transmission repetition period is the same as the SSB period (TS 38.213 [13], clause 13). SIB1 includes information regarding the availability and scheduling (e.g. mapping of SIBs to SI message, periodicity, SI-window size) of other SIBs with an indication whether one or more SIBs are only provided on-demand and, in that case, the configuration needed by the UE to perform the SI request. SIB1 is cell-specific SIB;","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"-SIBs other than SIB1 and posSIBs are carried in SystemInformation (SI) messages, which are transmitted on the DL-SCH. Only SIBs or posSIBs having the same periodicity can be mapped to the same SI message. SIBs and posSIBs are mapped to different SI messages, i.e. an SI message contains either only SIBs or only posSIBs. Each SI message is transmitted within periodically occurring time domain windows (referred to as SI-windows with same length for all SI messages). Each SI message is associated with an SI-window and the SI-windows of different SI messages do not overlap. That is, within one SI-window only the corresponding SI message is transmitted. An SI message may be repeated with the same content a number of times within the SI-window. Any SIB or posSIB except SIB1 can be configured to be cell specific or area specific, using an indication in SIB1. The cell specific SIB is applicable only within a cell that provides the SIB while the area specific SIB is applicable within an area referred to as SI area, which consists of one or several cells and is identified by systemInformationAreaID;","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"-The mapping of SIBs to SI messages is configured in schedulingInfoList and schedulingInfoList2, while the mapping of posSIBs to SI messages is configured in posSchedulingInfoList and schedulingInfoList2.Each SIB and each posSIB is mapped to a single SI message. posSIBs of the same posSibType carrying GNSS Generic Assistance Data for different GNSS/SBAS (identified by gnss-id/sbas-id, see TS 37.355 [49]) are mapped to different SI messages.Each SIB and posSIB is contained at most once in an SI message.For SIBs and posSIBs with segments, the segments contained in SI messages are transmitted according to the SI message periodicity, with one segment of a particular sibType/posSibType in each SI message;","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"-For a UE in RRC_CONNECTED, the network can provide system information through dedicated signalling using the RRCReconfiguration message, e.g. if the UE has an active BWP with no common search space configured to monitor system information, paging, or upon request from the UE.","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c20a2a6e1e0ec4987a2245b2950f77a7803d006716da31a0c8c144113a98d5c9","49d0aa9b99945c2a90057f9de043004cc60cd51d1ef9ce9a4e74957f3f316096","58381cccce1688ea06d1452742187a1194776e70cef78cf6745358569acd7f66","9e947ef183568db4d0d04c811def9c145937a756be81d47b65a5d83e1b001ad7","2dd7dcaccbc153fd77716917bdc756b4cb8100d0bfa699ec98eeb3be0fba6a1d","bb6953fa8c0c2f271d8c04ce3c563705f4cbed14d1e97db93d8622258e243e83","cd34f790eea5cae87b73c0857ccb3e843b0a6764c0ee3cc905458af42f1dfab0","83e6aa01e0cdaa6934dd3bc9ed77b8e286efb27614e3f114c675ab5ac71c3384","2e92c326c4de39674d32b017f030cabe862e1588ebc9d979af39081f1d105348","405667c7eb583c2eb46898157a6af6fdf6b76e2bc97c6265ad37d2cb7266e101","f0ca5fd2aaa8ab553addbe4cc9a7fc65d8abb26df865a4d519a62eec73edb8ac","907b4db0ed248f4e315eea60646fb5b7b83b51bdbb87932072f0f83e6c9035a6","e0aede789bcd3f66ea88f20ade2b63b926fa6059f82c450eff45fd115caa5566","f625adc099b6994f953df6dcebd2207c4fde9e921fbd7064d33ccecb7e4ff919","a1ea69ce5c5a5a0986fbe04dd5abb1b88dd2824623b2d1f5437283ae781bd204","f98601598f14f78c4fb3715fed3487b50af98f2dbf278167a7634cae9a9fda06","c588479b4705150e50541439e44c024001cba6df26fb68c6a1d84e1339c7e934","9a99611066fb5444374c07ae487f584a2c92c4f684c1c6db8928418bc2fc4ebb","d8779e1e32ecb0988342752df5bf68cae92e6462aed343842e3a8f9f47de1e78","f3f4acb3196955e67be3030382be38125b4bfa501d42f17e404f0970f9fa7d85","df06b68604086c6e0b65fb695f5c7e1dcfde9a497e1fb4aaf761ab6d5a0facb3","84545bf833eb41ead146435b086a3dc24f4b9de61d8e45473b1e451be7f8d0f5","6f6b751f9858a66efd717d67bfbfe9067fbb48dd254601468cd4a0eaaf39b36e","eaeaba788651183c2a59f8cfb57d8b2e7fa2bcd80b8ee9dadd1dbfbf7d86946d"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p552"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For PSCell and SCells, the network provides the required SI by dedicated signalling, i.e. within an RRCReconfiguration message. Nevertheless, the UE shall acquire MIB of the PSCell to get SFN timing of the SCG (which may be different from MCG). Upon change of relevant SI for SCell, the network releases and adds the concerned SCell. For PSCell, the required SI can only be changed with Reconfiguration with Sync.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"NOTE 2:The physical layer imposes a limit to the maximum size a SIB can take. The maximum SIB1 or SI message size is 2976 bits.","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"5.2.2System information acquisition","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"5.2.2.1General UE requirements","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"Figure 5.2.2.1-1: System information acquisition","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"The UE applies the SI acquisition procedure to acquire the AS, NAS- and positioning assistance data information. The procedure applies to UEs in RRC_IDLE, in RRC_INACTIVE and in RRC_CONNECTED.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"The UE in RRC_IDLE and RRC_INACTIVE shall ensure having a valid version of (at least) the MIB, SIB1 through SIB4, SIB5 (if the UE supports E-UTRA), SIB11 (if the UE is configured for idle/inactive measurements), SIB12 (if UE is capable of NR sidelink communication/discovery and is configured by upper layers to receive or transmit NR sidelink communication/discovery), and SIB13, SIB14 (if UE is capable of V2X sidelink communication and is configured by upper layers to receive or transmit V2X sidelink communication), SIB15 (if UE is configured by upper layers to report disaster roaming related information), SIB16 (if the UE is capable of slice-based cell reselection and the UE receives NSAG information for cell reselection from upper layer), SIB17 (if the UE is using TRS resources for power saving in RRC_IDLE and RRC_INACTIVE) and SIB19 (if UE is accessing NR via NTN access).","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"The UE capable of MBS broadcast which is receiving or interested to receive MBS broadcast service(s) via a broadcast MRB shall ensure having a valid version of SIB20, regardless of the RRC state the UE is in.","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having a valid version of the posSIB requested by upper layers.","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"5.2.2.2SIB validity and need to (re)-acquire SIB","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"5.2.2.2.1SIB validity","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"The UE shall apply the SI acquisition procedure as defined in clause 5.2.2.3 upon cell selection (e.g. upon power on), cell-reselection, return from out of coverage, after reconfiguration with sync completion, after entering the network from another RAT, upon receiving an indication that the system information has changed, upon receiving a PWS notification, upon receiving request (e.g., a positioning request) from upper layers; and whenever the UE does not have a valid version of a stored SIB or posSIB or a valid version of a requested SIB.","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"When the UE acquires a MIB or a SIB1 or an SI message in a serving cell as described in clause 5.2.2.3, and if the UE stores the acquired SIB, then the UE shall store the associated areaScope, if present, the first PLMN-Identity in the PLMN-IdentityInfoList for non-NPN-only cells or the first NPN identity (SNPN identity in case of SNPN, or PNI-NPN identity in case of PNI-NPN) in the NPN-IdentityInfoList for NPN-only cells, the cellIdentity, the systemInformationAreaID, if present, and the valueTag, if present, as indicated in the si-SchedulingInfo for the SIB. If the UE stores the acquired posSIB, then the UE shall store the associated areaScope, if present, the cellIdentity, the systemInformationAreaID, if present, the valueTag, if provided in assistanceDataSIB-Element, and the expirationTime if provided in assistanceDataSIB-Element. The UE may use a valid stored version of the SI except MIB, SIB1, SIB6, SIB7 or SIB8 e.g. after cell re-selection, upon return from out of coverage or after the reception of SI change indication. The valueTag and expirationTime for posSIB is optionally provided in assistanceDataSIB-Element, as specified in TS 37.355 [49].","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE can inform the interested SIB(s) to the connected L2 U2N Relay UE as defined in clause 5.8.9.8.2 and receive the SIB(s) from the L2 U2N Relay UE as defined in clause 5.8.9.9.3. A L2 U2N Remote UE in RRC_CONNECTED receives SIB1 and other SIB(s) in RRCReconfiguration message and performs on-demand SI request if required, as defined in clause 5.2.2.3.5 and 5.2.2.3.6. The L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE or RRC_CONNECTED is not required to obtain SI over Uu interface, but it may decide to perform the SI acquisition procedure over Uu interface as defined in clause 5.2.2.3 by UE implementation.","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"NOTE:The storage and management of the stored SIBs in addition to the SIBs valid for the current serving cell is left to UE implementation.","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"1>delete any stored version of a SIB after 3 hours from the moment it was successfully confirmed as valid;","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a SIB:","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the SIB is the same as the value received in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity included in the NPN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity included in the PLMN-IdentityInfoList, the systemInformationAreaID and the valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the systemInformationAreaID and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c9f05be18eadbb269b00015c90e5c0f27474961112c87d8208c9d52723d564af","16cb1f46530d06759cca6ec6e41a92c41d2d47c3ecd32b8e3a4e0e7911a43034","e7f52f9f3f711f6c1d215dc9092ed88acc0d4981872bbadfeabacbb42db0d2a8","43d10a98acf68f63404c156a58165cad6de34984eac70501513387d40c22e13c","47f3e7de4c9a3a9d8a780e5dc552e948ed21afe170abcb253429d6200970fda8","8272e70ac44f29d2e11767564722605be70972ee8ef2a69e3e82f229415ef1d3","74daeb72550ead24e542ed34036d0a43c6b26fb7704307d90b800d6189204ec0","536923711f51e953c605572e09126b9963fe460eda591cbb9f31c51600a5258b","6ae89f62ddf6c32255a9b3b96b8aafec4ecbcb4e851d46f667c168a44dc8ea79","23b6fdfb2af75f159e0d7e4883da393da7d58a6a41459d5b5ddc8bd93c6414f1","68d1f1a1763383bbc63f1174c3c3e29a8093e387d014e45daba29f962e85a011","9ee433b546da988dca8749c6860508b1f8389455a0352c549a8ecbec35da6a28","cebbff14f4dff48df2f141cd39526401f910bae21b4335104b2996e121a96de0","8783cc11ccc6582d813ee7c15cd7a1ed8b13807d7ea08c89b6d6d80e71987d08","037dec2298d2d215ff8acb3e3d93dcad55a9b064d2c531094203689478582d39","c04528bcec04a9652dfaa1b49171eef944dbb1c8f23ce277a1e7a337ca4a7431","8ca792a060b58e67825565defb094ce4bc6d523f5cd4e4f2fbf7e9b60bffe12c","ac941f42a36c049cda678daf270e9a4ff662cf3f733be041d92d870ee367e84d","ef0ab68f1bf69b5b365e9931c51ce5186106805808839b3e3d9d1f42c5209047","02c37ef7be4f592e92d7d438b2885077eefdb2dfcacc4c9ec08245aaeb7bbf2b","d1cf2d35818837ab38d9bb8d6dfd2b4fe13bf4d51829a09b6833de081fbddec7","360d07799e09d487ba1e5fa12e05c39da53475be3102eee6bdf164e3745772c1","21a24f90a0900356422453616c298d1b4d9dc7562e736eda5ba81490f2f2efb3","062b46f2d44bb595d8bc4639fc6889b4db033ad6e742eba39bf2b07780e5d140"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p576"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the SIB and the areaScope value is not included in the si-SchedulingInfo for that SIB from the serving cell:","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"4>if the first NPN identity in the NPN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the NPN identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"5>consider the stored SIB as valid for the cell;","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"3>else if the first PLMN-Identity in the PLMN-IdentityInfoList, the cellIdentity and valueTag that are included in the si-SchedulingInfo for the SIB received from the serving cell are identical to the PLMN-Identity, the cellIdentity and the valueTag associated with the stored version of that SIB:","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"4>consider the stored SIB as valid for the cell;","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"1>for each stored version of a posSIB:","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is associated and its value for the stored version of the posSIB is the same as the value received in the posSIB-MappingInfo for that posSIB from the serving cell and the systemInformationAreaID included in the si-SchedulingInfo is identical to the systemInformationAreaID associated with the stored version of that posSIB:","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"2>if the areaScope is not present for the stored version of the posSIB and the areaScope value is not included in the posSIB-MappingInfo for that posSIB from the serving cell and the cellIdentity for the posSIB received from the serving cell is identical to the cellIdentity associated with the stored version of that posSIB:","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"3>if the valueTag (see TS 37.355 [49]) for the posSIB received from the serving cell is identical to the valueTag associated with the stored version of that posSIB; or if the expirationTime (see TS 37.355 [49]) associated with the stored posSIB has not been expired:","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"4>consider the stored posSIB as valid for the cell;","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"5.2.2.2.2SI change indication and PWS notification","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"A modification period is used, i.e. updated SI message (other than SI message for ETWS, CMAS, positioning assistance data, and some NTN-specific information as specified in the field descriptions ) is broadcasted in the modification period following the one where SI change indication is transmitted. The modification period boundaries are defined by SFN values for which SFN mod m = 0, where m is the number of radio frames comprising the modification period. The modification period is configured by system information. If H-SFN is provided in SIB1, and UE is configured with eDRX, modification period boundaries are defined by SFN values for which (H-SFN * 1024 + SFN) mod m = 0.","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"For UEs in RRC_IDLE or RRC_INACTIVE configured to use an IDLE eDRX cycle longer than the modification period, an eDRX acquisition period is defined. The boundaries of the eDRX acquisition period are determined by H-SFN values for which H-SFN mod 1024 = 0.","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"The UE receives indications about SI modifications and/or PWS notifications using Short Message transmitted with P-RNTI over DCI (see clause 6.5). Repetitions of SI change indication may occur within preceding modification period or within preceding eDRX acquisition period. SI change indication is not applicable for SI messages containing posSIBs.","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for SI change indication in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. UEs in RRC_CONNECTED shall monitor for SI change indication in any paging occasion at least once per modification period if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging, as specified in TS 38.213 [13], clause 13.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for SI change indication in any paging occasion at least once per modification period, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"During a modification period where ETWS or CMAS transmission is started or stopped, the SI messages carrying the posSIBs scheduled in posSchedulingInfoList may change, so the UE might not be able to successfully receive those posSIBs in the remainder of the current modification period and next modification period according to the scheduling information received prior to the change.","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_IDLE or in RRC_INACTIVE while SDT procedure is not ongoing shall monitor for indications about PWS notification in its own paging occasion(s) that the UE monitors as specified in TS 38.304 [20]. ETWS or CMAS capable UEs in RRC_CONNECTED shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle if the UE is provided with common search space, including pagingSearchSpace, searchSpaceSIB1 and searchSpaceOtherSystemInformation, on the active BWP to monitor paging.","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"ETWS or CMAS capable UEs in RRC_INACTIVE while SDT procedure is ongoing shall monitor for indication about PWS notification in any paging occasion at least once every defaultPagingCycle, if the initial downlink BWP on which the SDT procedure is ongoing is associated with a CD-SSB.","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"For Short Message reception in a paging occasion, the UE monitors the PDCCH monitoring occasion(s) for paging as specified in TS 38.304 [20] and TS 38.213 [13].","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c6de8ead3feba7bb8989a8055b3f01e9251a21d3c283b8e2a48fdddb82ddf176","0d0e40019119f21b6e47045c459cb052348ea7b4b8ab03fa268133bb726bca6e","a0822599ec0ada973f08d17e3aa134784ca69017219d2d4305b3c7437d28e027","69f29937e9b31ffd34d20f4e73138a4a6a5a43155db7ebaf60055a6fa33d7a76","f90450a56b7ecd357a5fa14e4b8c83b92275abd455af4b46439a8f7a51b713ce","a569ff4b9a9094191065818e87408bbc18ea798f8237da282ab9912de4b995d1","9f1c2fcc1d9c9dad83e6a5bc3917c58f70efb42e5737e5e2a1da437ecf040101","3663cbd39c0f9115e01b2d742bdb98c7ffa2e54df9b5b42065f0c6adfd7a8c8f","63d025bb0ebabcac8511108567c6b85f4d41a8c33c5419d59472a30db965f30e","f6450ae587a31e051053bc3eb0635e9b7fdc61d61d05f36d7b1d1783b353b531","e8e1e34cd41213a14b8ad6eeb9e58ece5df98a6cf6b9089e87936bccc6099c31","7fd032a3a3c58623065805afb4f5145cdacef76b92a13b4350e25293d24c589d","0517b2d723532ed7302c56230c70e9297089279de30c6349eda9575a9e7cb58b","c308404975e002496dc8919ffe2a7dfae3001a41b738d1c3c94be461fcf6a1ee","186411e62ba3ebee8e5de06be91b489bb788d2d03f033c0465ab9fd928ae5a21","bac1c3080918d987a69ed7f0cb91e635a73d7f118730a545bc5be9324a29c6f3","251d11ecafc859cd7e86b5ffa406742e4279e46faa8d9a4d48d1ff7bf3b3927b","cad739f616c52f6a1d46cc1371465933fa757763f013a7bcf749c93dc7ec0273","8c839636b98e9e3a48aa920ccb12e82810973aeeb90584f9cddfcd0558839b56","bf607114d73d1e720edea86f059c22bcb11231661141e2cecb942ed0fda0e136","a3f0857915ce29fb404111b300e918730b0bb40563b84ef7710b31e7fd54d451","c8b6c28c82feea94b0927fc91fb9ab6db7d45f746ac411261146dcff71f1c89a","e9f77cb50b7dbc11f75ae677b4c7a4f52746890db26af26a9ad9ffd39cb825b1","4df03ca607010541d5943cc222902016a90b16e081aae6e5b081b690a10a8f08"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p600"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A L2 U2N Remote UE is not required to monitor paging occasion for SI modifications and/or PWS notifications. It obtains the updated system information and SIB6/7/8 from the connected L2 U2N Relay UE as defined in clause 5.8.9.9.3.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"If the UE receives a Short Message, the UE shall:","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"1>if the UE is ETWS capable or CMAS capable, the etwsAndCmasIndication bit of Short Message is set, and the UE is provided with searchSpaceSIB1 and searchSpaceOtherSystemInformation on the active BWP or the initial BWP:","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"2> immediately re-acquire the SIB1;","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB6:","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"3>acquire SIB6, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"2>if the UE is ETWS capable and si-SchedulingInfo includes scheduling information for SIB7:","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"3>acquire SIB7, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"2>if the UE is CMAS capable and si-SchedulingInfo includes scheduling information for SIB8:","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"3>acquire SIB8, as specified in clause 5.2.2.3.2, immediately;","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"NOTE:In case SIB6, SIB7, or SIB8 overlap with a measurement gap it is left to UE implementation how to immediately acquire SIB6, SIB7, or SIB8.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"1>if the UE does not operate an IDLE eDRX cycle longer than the modification period and the systemInfoModification bit of Short Message is set:","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next modification period;","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"1>if the UE operates an IDLE eDRX cycle longer than the modification period and the systemInfoModification-eDRX bit of Short Message is set:","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"2>apply the SI acquisition procedure as defined in clause 5.2.2.3 from the start of the next eDRX acquisition period boundary.","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"5.2.2.3Acquisition of System Information","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"5.2.2.3.1Acquisition of MIB and SIB1","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"1>apply the specified BCCH configuration defined in 9.1.1.1;","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"2>acquire the MIB, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"2>if the UE is unable to acquire the MIB;","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["61f56f4fd46536ea960864f985c4eaa183c8e4549a5368bda52b84d96f6144ce","922fa2795c02fdbf9e5b0928113607f4017b8815836f091921891eff74d42479","6b280765166d05593e39d72ae3f2c4afb1bc7cf0c1813859b0244e12f1283650","ca08288b29a44102c7c84374e360d25dbfc01e718b43b23da1fff839706e3924","dd2880d919ecfa8b133ccdd2b7b5a41744acdea04f9c0c2f48218233a2c25f23","a870af13d8eea17b53c4d295b6b73b10a94d2449d3b7271fac68354601e88cee","e8bb9a71605dc912b6251d0c1d4244af7373213c78c41df8d6d0a186a7577240","c69d6a942ba1ef1431d73febd8b10775342f6c3f6f064712644d1f5043a0f12f","0e08111e623f698b3f2675a428023630b7e0ea8af8f4158a148142778d5d2945","c0901e938374661a8fdbe42a233311d397dfc8a14c61475fc34ef0eeb4cf7b06","abbf8af012b5c4dcc528c1a9a7b056f0845bcb9beac68e5f5ad70c1c60804f53","38ee2efcf10079c22b635978b7152b87e6a7e1630b97b7a2a539238fd038c253","bba0f5792671f120c408be1d3dbfae859d889ddc04d5618689e5ae87ed21b25e","0819eedd61a98307561af8afa2537a58f4142f724fd457ccdfff1101e84195dd","b062948ad7b242da54b34e7aa8cc5bfd791c358b6006d9fe1016f21653141b92","1bdee024ab56d237959df6acb77f19fe6f0e57a0782a44a8ec6c24f015f5de4e","337553f7bdb95125112f9ed54f090f59a16a0ebb2ebe617bc8a4a18c21f83156","e58dcc9094fd6dd8a47e7ad6ac01986a4ea4b85a0eeb2125e3c8e32b06d475fa","639e1c481f676db1d17a69be491ec46790fe76d5eb02e296c997643ac601124a","d42b3ee210fe5905b0f78773e72d9487790f159dec04d5b87daab01ff1fa3efe","43ed99385c211fe37a4f63e19df94c0ddf8127bf809341d5e4995ec811aacb03","edec0be09e0f434ae476cc4bcd8cbbdd2326bcbec64636711aeea52e5c380906","52c1cb8dd1d9cc77933148a5e351b3b525c9db1957230afe0518c5d01e934738","5e451f7fd51c69805e49fe8e377043d08ebbe5fbc271ce7d55f7cdcdb2c17824"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p624"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"3>perform the actions specified in clause 5.2.2.4.1.","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and pagingSearchSpace and has received an indication about change of system information; or","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1 and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, UE has not acquired SIB1 in current modification period; or","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"1> if the UE is in RRC_CONNECTED with an active BWP with common search space configured by searchSpaceSIB1, and, the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, and, si-BroadcastStatus for the required SIB(s) or posSI-BroadcastStatus for the required posSIB(s) is set to notbroadcasting in acquired SIB1 in current modification period; or","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_IDLE or in RRC_INACTIVE; or","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"2>if ssb-SubcarrierOffset indicates SIB1 is transmitted in the cell (TS 38.213 [13]) and if SIB1 acquisition is required for the UE:","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"3>acquire the SIB1, which is scheduled as specified in TS 38.213 [13];","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"3>if the UE is unable to acquire the SIB1:","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"4>perform the actions as specified in clause 5.2.2.5;","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"4>upon acquiring SIB1, perform the actions specified in clause 5.2.2.4.2.","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"2>else if SIB1 acquisition is required for the UE and ssb-SubcarrierOffset indicates that SIB1 is not scheduled in the cell:","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in clause 5.2.2.5.","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE in RRC_CONNECTED is only required to acquire broadcasted SIB1 and MBS broadcast if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e., the broadcast and unicast/MBS multicast beams are quasi co-located. The UE in RRC_INACTIVE state while SDT procedure is ongoing, is only required to acquire broadcasted SIB1 and MIB if the UE can acquire them without disrupting unicast data reception, i.e. the broadcast and unicast beams are quasi co-located.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"NOTE 2:UE in RRC_INACTIVE that does not support inactiveStateNTN-r17 enters RRC_IDLE upon cell reselection between TN cell and NTN cell, and initiates the NAS signalling connection recovery (see TS 24.501 [23]).","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"5.2.2.3.2Acquisition of an SI message","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"For SI message acquisition PDCCH monitoring occasion(s) are determined according to searchSpaceOtherSystemInformation. If searchSpaceOtherSystemInformation is set to zero, PDCCH monitoring occasions for SI message reception in SI-window are same as PDCCH monitoring occasions for SIB1 where the mapping between PDCCH monitoring occasions and SSBs is specified in TS 38.213[13]. If searchSpaceOtherSystemInformation is not set to zero, PDCCH monitoring occasions for SI message are determined based on search space indicated by searchSpaceOtherSystemInformation. PDCCH monitoring occasions for SI message which are not overlapping with UL symbols (determined according to tdd-UL-DL-ConfigurationCommon) are sequentially numbered from one in the SI window. The [x×N+K]th PDCCH monitoring occasion (s) for SI message in SI-window corresponds to the Kth transmitted SSB, where x = 0, 1, ...X-1, K = 1, 2, …N, N is the number of actual transmitted SSBs determined according to ssb-PositionsInBurst in SIB1 and X is equal to CEIL(number of PDCCH monitoring occasions in SI-window/N). The actual transmitted SSBs are sequentially numbered from one in ascending order of their SSB indexes. The UE assumes that, in the SI window, PDCCH for an SI message is transmitted in at least one PDCCH monitoring occasion corresponding to each transmitted SSB and thus the selection of SSB for the reception SI messages is up to UE implementation.","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"When acquiring an SI message, the UE shall:","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"1>determine the start of the SI-window for the concerned SI message as follows:","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"2>if the concerned SI message is configured in the schedulingInfoList:","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b1bef6186e38a53f04ef8be81561f3b8bab8dd87eb28f99423c9b8927b2c56d8","cf76273d8e1d49795c1035d7d9c532a38f2db103fb6e8c338412c7dc6369a236","bfc6136a3272a93218ee4dfa17db811dd6cb3a96d1291b2450ddbf2d118fa780","792fda39eef381ce7bb636359b24f1fc4a3028f0488c1951357f4082834988e9","c91f029f89a9484b9aa7769f244991efecd1b8818386c061dec4e023552ba467","a7b2d21a2a9e2c0174872124ddc96337929c5769d3c824e0f87e788db697ecee","bf29723e395ea747b998abb6b02560de7116d30acf399d7fb9b4d372623d96ae","03fd4231c781c118aed4c6947503c924f5d558fd35666d3e1681ea92bf6935ea","b6a8a90c7332c7741f4db15dc599e9af0c8c7b2dddbf188dcd5690a1cb62648c","237d6e92debf6406c232f26738a48fee4d6b549477a21384db000a72559e3011","f60ec031aaaf422f81f6b752785ad645fb7992b53031edb39d7ea75837273934","2f26ecbd59891bb668f03eaf000e6ab5befabca69aa14b27c5bf6de97fbfaef7","246ce788dca250b7951c6c4ef1c7f372daf47bb9206ff92bafa285d11ccd791b","24c8218d465eb0feb260ea505e8cb42d9c130ca1fc0cbbf82aab99f86e5e480e","9daaa5bf8a0a3300f3daeeb3ac0d14ddba922321b6709aaec8984047e0d6947b","2f0a4dd08b259dc9142992b161ec73d689d4c85031ec3987ed34a59975bac480","330d36567f68f1a1fd69fe69af1bc7235883d119a669d3c8336584500665ffb7","855d1c33cca3768d51a91b0f748f054546747956d773038ac9ddc0c3c5980a8d","99ef1bc42b969ffe24b81c8817725c8641d836397c8f5f02c77e2362e342c8e9","0b44cbb6af930e52854a0b6ce07267b56a86fbfe2b82d9d44af95c2d5f85e38c","04a9b95fa69fd21d30b6c5f70bba7bb446103fa982dea2792a6c485aa618b56a","e9a5590e98259ac9d7fb8d23b42d1d25597ca3185f8d3df8889187a6cc7b4e22","0a566965be23e838fd9d6bb62c22737d077c134775c06da927ea0eae724c55d2","3f6b3b5f01eb3118f11c7c0223874db7d8d455b17f8f187471307d39ca33aa84"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p648"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the schedulingInfoList2;","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (si-WindowPosition -1) × w, where w is the si-WindowLength;","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the si-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured in the posSchedulingInfoList and offsetToSI-Used is not configured:","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"3>create a concatenated list of SI messages by appending the posSchedulingInfoList in posSI-SchedulingInfo in SIB1 to schedulingInfoList in si-SchedulingInfo in SIB1;","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the concatenated list;","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N), where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"2>else if the concerned SI message is configured by the posSchedulingInfoList and offsetToSI-Used is configured:","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"3>determine the number m which corresponds to the number of SI messages with an associated si-Periodicity of 8 radio frames (80 ms), configured by schedulingInfoList in SIB1;","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"3>for the concerned SI message, determine the number n which corresponds to the order of entry in the list of SI messages configured by posSchedulingInfoList in SIB1;","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"3>determine the integer value x = m × w + (n – 1) × w, where w is the si-WindowLength;","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"3>the SI-window starts at the slot #a, where a = x mod N, in the radio frame for which SFN mod T = FLOOR(x/N) +8, where T is the posSI-Periodicity of the concerned SI message and N is the number of slots in a radio frame as specified in TS 38.213 [13];","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"1>receive the PDCCH containing the scheduling RNTI, i.e. SI-RNTI in the PDCCH monitoring occasion(s) for SI message acquisition, from the start of the SI-window and continue until the end of the SI-window whose absolute length in time is given by si-WindowLength, or until the SI message was received;","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"1>if the SI message was not received by the end of the SI-window, repeat reception at the next SI-window occasion for the concerned SI message in the current modification period;","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"1>if all the SIB(s) and/or posSIB(s) requested in DedicatedSIBRequest message have been acquired:","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"2>stop timer T350, if running;","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is only required to acquire broadcasted SI message if the UE can acquire it without disrupting unicast or MBS multicast data reception, i.e. the broadcast and unicast/MBS multicast beams are quasi co-located.","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is not required to monitor PDCCH monitoring occasion(s) corresponding to each transmitted SSB in SI-window.","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the concerned SI message was not received in the current modification period, handling of SI message acquisition is left to UE implementation.","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"NOTE 4:A UE in RRC_CONNECTED may stop the PDCCH monitoring during the SI window for the concerned SI message when the requested SIB(s) are acquired.","paragraph_zero_based":694},{"literal_text_all_w_t_and_m_t":"NOTE 5:A UE capable of NR sidelink communication/discovery and configured by upper layers to perform NR sidelink communication/discovery on a frequency, may acquire SIB12 or SystemInformationBlockType28 from a cell other than current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED), if SIB12 of current serving cell (for RRC_INACTIVE or RRC_IDLE) or current PCell (for RRC_CONNECTED) does not provide configuration for NR sidelink communication/discovery for the frequency, and if the other cell providing configuration for NR sidelink communication/discovery for the frequency meets the S-criteria as defined in TS 38.304 [20] or TS 36.304 [27].","paragraph_zero_based":695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1c70aa1ecf0fdc8eff6de230f0e33ed2bbe9167c385f5593f08902c2322b966c","4e21ce0bce8e4c5c4f6b68aebedf56b986b61bd83b662c2d33c4ca2895c61a80","f280a5ea3410325a61284a91b1142d5959afe5bbfb2ed90bcc975f5524c4af98","49fd650fd8d3ba94e0298beb37b6602d678bbb5c4fdc9c4b54d46a7685dfebb5","db4ede0000c4c3976ffd06f46d73ebcef903ff5c0017369abba03c412c7e8855","4c239e612cc56af7a5c24af7ac060024f82035347b101f3ac0441d659b0ebd36","aa4b5df40c43b8774f5234deba42439a2a4b3c4fb2ab2e53d7228b405e8981cc","2cf265f061355d95cc803ee1a7a36d11f49da4bd835783fd424d13ef68fb28db","71d492d223513b746ee4c46af5f85da1451a548ecb0af49e407c534ef2564fd8","829f325a2503563afd02e0db4f4174d1f5ea85f83556850da9364391c958adda","ccb4355ade8d3996a220fc62d1969a599d678a339d320666841563a5a715d02a","58c1987efb76477842184cf85ce5de74b302e62ba4e20023de4425d8cd6d9de9","07c04a48033a92a68bc9e192318fb944ae01a45dc7cae88900f410ae50046abd","26c40b97697754c6a43f679c13dcb5466a69d170fb72f17b29659e0f9802050c","c9cefbe067ccaebfe90ffbeae56c54f0362abf5ae59c9245986f5ea427eb9ee7","d6d3857f9944a372d6feff0d4b70d0f8bba3405f39f38f5399d42dcd80ebee8a","1ac7d2fd6af819573c82d748c8e17d0982adeaeb4a70eb11fd853b9925e5fa74","6e51f8112fb93a533435e23d7e27f9b2e8cbbaa18adb409cf9c536205003786c","96588a2b53d991fc3e8bdaa6b7df1c4a223f8bd35f5df0b88270af8d66b31266","b57162bb120b24ee1135f6663064d6706ef7e4453f30f141c331a73df0cf86e6","307ebb8571754a8aee36e0ddabcaf4ac379fd5fb0698b9432a800d56e285bb67","18ba73b155f75442b8d3b227947ae943286e10d8de0361a9e52d5f9b80f066ea","e7b02903cbec2bff677baefb0e43f76440d5dbcd2e93ea623e0a73db5bf7f5ac","5e3daf45c224c2ff193b969f852781258f08045efa3ff03a59fccf782b6bc8ac"],"paragraph_range_zero_based":[672,695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p672"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>perform the actions for the acquired SI message as specified in clause 5.2.2.4.","paragraph_zero_based":696},{"literal_text_all_w_t_and_m_t":"5.2.2.3.3Request for on demand system information","paragraph_zero_based":697},{"literal_text_all_w_t_and_m_t":"The UE shall, while SDT procedure is not ongoing:","paragraph_zero_based":698},{"literal_text_all_w_t_and_m_t":"1>if SIB1 includes si-SchedulingInfo containing si-RequestConfigSUL and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":699},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigSUL corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":700},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":701},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":702},{"literal_text_all_w_t_and_m_t":"1>else if the UE is a RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfigRedCap and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":703},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfigRedcap corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":704},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":705},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":706},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":707},{"literal_text_all_w_t_and_m_t":"2>if the UE is not a RedCap UE and if SIB1 includes si-SchedulingInfo containing si-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met; or","paragraph_zero_based":708},{"literal_text_all_w_t_and_m_t":"2>if the UE is a RedCap UE and if initialUplinkBWP-RedCap is not configured in UplinkConfigCommonSIB and if SIB1 includes si-SchedulingInfo containing si-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":709},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in si-RequestConfig corresponding to the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":710},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":711},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":712},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":713},{"literal_text_all_w_t_and_m_t":"3>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":714},{"literal_text_all_w_t_and_m_t":"3>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":715},{"literal_text_all_w_t_and_m_t":"3>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":716},{"literal_text_all_w_t_and_m_t":"3>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":717},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the RRCSystemInfoRequest message with rrcSystemInfoRequest in accordance with 5.2.2.3.4;","paragraph_zero_based":718},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for RRCSystemInfoRequest message with rrcSystemInfoRequest is received from lower layers:","paragraph_zero_based":719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["81d1495668ec02ba9393b590f6a8b0e52f758e47940f3c60cebacd60f79c4d0a","4352dacea3d6b31d6bf67c5f4b53df48bb169d56a61486874cdc2ad4fab6f04c","abba84d850d81cc81311ea22ae4e01af162b6c7985e787ceefa0e9a136fc62ad","1bdad3161b911725224224d8740c0aaf54e91099b730fc0887bb399e24451032","7b8e1e0f9de5f6ac471100bc032aa01ceb5cd1a8ce8f723e2ca667343b5d79c5","30ce7d79be735539306b0f41287b4bc81c10a92207e32a6efc5c371cef114054","9c983254a3098d0e1324629afa1e6d6083600d40fbfbeb07275078e478ce5390","0ab044d30bcc5e7cce5ec76bd53236591ec4d07e86a3d5c10baa183b74e8de3c","4dbc06e493dcd2bc27655cc8d400b8c0891a6a3490b3aba1a413870c69d6416a","89194731d39c47f1f8a41c184db702aa03b1529d70345d6bfefc3662727b9561","5f261693673a6c58aa04fec9c5c632d1fef9378838fc3e8c25540186d85aea42","e359f8e177bd4889ee8ba2605cc4c088f211f1189fde2c375245b5d17b1ae8ca","2e173da8073bb49ac41dae2b57e61c7f860883ee78a4f5895e64c2cff41b4b90","488112f14832f8ff5a49cf1540b8076ea41cbaee1e6f5f7b2062b3e31b48484e","0b3d1e0b537ce45b09f691549e42f1ff3abca004b7d65c665be4b5071e480ef5","ad0ee9fd10c46c95df338a8bbe7cc275fe42648566e06ffb80a7d739e7bc13a7","8b66e2fd5d465df9dad20e5e8595fadfc1e7ac3acc2edd51a9a7c8032861fdf4","e55bb391d02ea61bedf5882ce95d0262ff65f8cfd7b6e6d96f4da154273058db","c6015b813a1913ad6e90dcdc34dbc59704dd7224b55b7123130926ca486ade96","fb54e0a17841814ba5f29632aa8cf88d48e3f1fb99d2c91c5dd1bd1f4ae7ecd4","8946a2ff0e340072741ea520948aace8061faabb35d2391db97e965a338cc4be","de42d638b1bc15dce998488c96511a79917641fe577964bcb892d14c8b1e64be","03e3e716b2a704b63df6550a1109761623590415879d8975726b631d5893f6af","eee4a7bebef9a794074f7f05701d69123def74f420a8a0349ac9047a9e6c0c1f"],"paragraph_range_zero_based":[696,719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p696"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":720},{"literal_text_all_w_t_and_m_t":"1>if cell reselection occurs while waiting for the acknowledgment for SI request from lower layers:","paragraph_zero_based":721},{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":722},{"literal_text_all_w_t_and_m_t":"2>if SI request is based on RRCSystemInfoRequest message with rrcSystemInfoRequest:","paragraph_zero_based":723},{"literal_text_all_w_t_and_m_t":"3>release RLC entity for SRB0.","paragraph_zero_based":724},{"literal_text_all_w_t_and_m_t":"NOTE:After RACH failure for SI request it is up to UE implementation when to retry the SI request.","paragraph_zero_based":725},{"literal_text_all_w_t_and_m_t":"5.2.2.3.3aRequest for on demand positioning system information","paragraph_zero_based":726},{"literal_text_all_w_t_and_m_t":"The UE shall, while SDT procedure is not ongoing:","paragraph_zero_based":727},{"literal_text_all_w_t_and_m_t":"1>if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfigSUL and criteria to select supplementary uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":728},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on supplementary uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfigSUL corresponding to the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":729},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":730},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":731},{"literal_text_all_w_t_and_m_t":"1>else if the UE is a RedCap UE and if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfigRedCap and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":732},{"literal_text_all_w_t_and_m_t":"2>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfigRedCap corresponding to the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":733},{"literal_text_all_w_t_and_m_t":"2>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":734},{"literal_text_all_w_t_and_m_t":"3>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":735},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":736},{"literal_text_all_w_t_and_m_t":"2>if the UE is not a RedCap UE and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met; or","paragraph_zero_based":737},{"literal_text_all_w_t_and_m_t":"2>if the UE is a RedCap UE and if initialUplinkBWP-RedCap is not configured in UplinkConfigCommonSIB and if SIB1 includes posSI-SchedulingInfo containing posSI-RequestConfig and criteria to select normal uplink as defined in TS 38.321[3], clause 5.1.1 is met:","paragraph_zero_based":738},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layer to initiate the Random Access procedure on normal uplink in accordance with TS 38.321 [3] using the PRACH preamble(s) and PRACH resource(s) in posSI-RequestConfig corresponding to the SI message(s) that the UE upper layers require for positioning operations , and for which posSI-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":739},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for SI request is received from lower layers:","paragraph_zero_based":740},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":741},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":742},{"literal_text_all_w_t_and_m_t":"3>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7547b617a9b1655ecbb9cda91cc348df8a621feff89b5b7df2b7988af5654341","cecb39a2e2fdb122228421579d386e326f220f9729ad55287882a5d3e538735b","e3b369d84dd3366d9fd0e05d6b85795c9e554f7f913fe387ef41da28efa4902a","7e99595cd44257abf98066e18718f1ad05c1676bf2b4e0de13fd17c37dac7e8f","e4ee937e05c6f78484c11097a90a348d9f6170a675bff61e5e14c3624b16e2d7","bc50f609cbc158417f44c772cb834814aa7dfba61865b01afc120000a2dc573b","8251d35d45ffcefa4f86dfbeb95f55376c23a4dab19f6f2359162698d8759c30","d8b58ae6a6910fb65344356aa861cf453658966229efada538691970a67342ba","c836f72e3c7ea289b42b3c72c84ba1706e874f7ca94a9c27a184d87f61791f46","4a156b7966c2a33e7ed9eb10c0b079640c46265a784429123a5dddbf720a7816","5ff2b102dbb56cabab102781d4cb2c446c22e0282c0524f16fcacc6231924230","3fa4ede60f6873229f965c934c03605dfab6cef8bd078ccea42e06fa4f332d34","ebe162745d7781cb80212556098c244e0effa75f22913aa8169b310f6ecb8ca9","368bc0609b157af38d690bdb23388b2d34bdee30fb567121897b6b2821c35463","efddaad09901dca2d8f8ce9d89d6978abddcd88b8c909477f0ddb978b41190c6","671d4a0415f573ab3035ad4767fcb0c3aba4202a50f57fc520287ebfce39d35d","3510bdc679585c1caad18b1c8ff33b7e912b1045c8e76af6106afbb310752518","caa50c7d74c5c03289318c07d3d6657bbb14992b85c8472a92a1d0c54f7125fe","7266a6da449297f81098d72bfca0f5e2f96390fccbc6b3e32acc966968e36477","914b219378c5adb5a8dbd1dcaba7a51e9e0ed7f39ece89be24c98908b2130e5a","94b3307c09a11fc34377f5e61b41cb6306875d7feda8c02b46ff0a40ed2baadb","d0082a086a17e6238c0cb1b89d7dcebae17e7694e8da42b0bda9e7f08415a735","4f7e9ffdab688c0141c240cc4b6a04842d549767b606380f8a931d7de54a9097","a2e3f6227e5fe9901e8b3c8b0e13adad2e8ac09946424808d5f6ebb2f78e9cde"],"paragraph_range_zero_based":[720,743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p720"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"3>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"3>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of the RRCSystemInfoRequest message with rrcPosSystemInfoRequest in accordance with 5.2.2.3.4;","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"3>if acknowledgement for RRCSystemInfoRequest message with rrcPosSystemInfoRequest is received from lower layers:","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"4>acquire the requested SI message(s) as defined in clause 5.2.2.3.2, immediately;","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"1>if cell reselection occurs while waiting for the acknowledgment for SI request from lower layers:","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"2>reset MAC;","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"2>if SI request is based on RRCSystemInfoRequest message with rrcPosSystemInfoRequest:","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"3>release RLC entity for SRB0.","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"NOTE:After RACH failure for SI request it is up to UE implementation when to retry the SI request.","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"5.2.2.3.4Actions related to transmission of RRCSystemInfoRequest message","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCSystemInfoRequest message as follows:","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"1>if the procedure is triggered to request the required SI message(s) other than positioning:","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"2>set the requested-SI-List to indicate the SI message(s) that the UE requires to operate within the cell, and for which si-BroadcastStatus is set to notBroadcasting;","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is triggered to request the required SI message(s) for positioning:","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"2>set the requestedPosSI-List to indicate the SI message(s) that the UE upper layers require for positioning operations, and for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"The UE shall submit the RRCSystemInfoRequest message to lower layers for transmission.","paragraph_zero_based":761},{"literal_text_all_w_t_and_m_t":"5.2.2.3.5Acquisition of SIB(s) or posSIB(s) in RRC_CONNECTED","paragraph_zero_based":762},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":763},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED with an active BWP not configured with common search space with the field searchSpaceOtherSystemInformation and the UE has not stored a valid version of a SIB or posSIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) or posSIB(s) in accordance with clause 5.2.2.1, or","paragraph_zero_based":764},{"literal_text_all_w_t_and_m_t":"1>if the UE is in RRC_CONNECTED and acting as a L2 U2N Remote UE and the UE has not stored a valid version of a SIB, in accordance with clause 5.2.2.2.1, of one or several required SIB(s) in accordance with clause 5.2.2.1:","paragraph_zero_based":765},{"literal_text_all_w_t_and_m_t":"2>for the SI message(s) that, according to the si-SchedulingInfo or posSI-SchedulingInfo in the stored SIB1, contain at least one required SIB or requested posSIB:","paragraph_zero_based":766},{"literal_text_all_w_t_and_m_t":"3>if onDemandSIB-Request is configured and timer T350 is not running:","paragraph_zero_based":767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["04f8a114f1f403a3f0e3b5ae1b947fc600cf3dabd7a5ca12e508fd212e6a542b","5a91a86020a357bec0d1f5954bf0948c0d8dd0db1b16f9f8ecf71cac8d77c613","fc6bd5eca92fd6ec1e9da5b69b01fcb3912b2188dca43b18bee383453525364b","bfc5ca754a76f5c255212113479e5ebc336bbaedfc72efbd8d4ab2d2753560da","dcf8ff857ad28d3b1628d480db0c51082237de4b286feb13f6c2a1f2c018d96c","5751c22b9636a225efcd8dfab9f461a7c5314e2b64afc5643faf2969e57da951","f20a52a6ef1e3cc3780548a92bf3107cd8a16ee3b332370afbcd5741bf6633fd","5583071087707263e53978e0507d2b34839b9e49d8a75acb5282a12af8f2a604","39c6d49c7a28fe4cbde373b45a77e1fe995f99026943a4e315d2a3e41ab8323d","349a439711a148e270b2fb3f8c52764d66db8c9c127296b989ed5b6484bd7ed2","205dedcb2211cc41e335ba7871cad70a1c3e42d2b0903b896a0d76b3758b8775","b1a4596efcde061d34e12d648876e870c28db6733dff1599c22b54f6b2d4cd0e","eead34eca1faab3874c0134cb1ee4f9ea802e3aa9c2e5eb160e47aed970738bc","a52038314f6809b8a0a734245cf010d802bd283ce7bbefb5163ae2aad390ef6f","36c6eab686b3a32abfedda64ec3ccebfbc8e528f9904668f6450f7a45a584284","b3a12ded8ad983d12946c381d45ee172298e2d15fc213505676f2a6cad88e720","c15a17af6fb19fc15606698a184dba49478dd243fa38029b55c5d46d9b7f950b","a1285bff7f9645bed0e6f3f2ef894bef4f3f54a6beb5061e7e02eea3fc50b0cf","c972d542575e1c8ed84550c0b967527b0c422013442b5b5c1f5ad975e86c5585","860256c632c305aa37ec408f185973827e2a8ca794fd71a31d116f6754add490","592c484aa20dad0709d8f6835e3c54e04bb6216ad956f8a6a31f4cb5d11586cf","52541ac3654eed9f392ec2ca2c60b9f54a7972444e04d7b18aadbc0eaa388397","101f2065aecf547e998ab6982de6c4f740e1c4c1d2d4d577d7b