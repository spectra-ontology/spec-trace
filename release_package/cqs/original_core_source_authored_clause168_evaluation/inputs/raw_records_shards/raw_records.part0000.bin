{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cg-MaxNumberConfigsAllCC","paragraph_zero_based":44328},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of active configured grant configurations. Corresponds to the UE capability maxNumberConfigsAllCC-r16 in activeConfiguredGrant-r16.","paragraph_zero_based":44329},{"literal_text_all_w_t_and_m_t":"maxNumberCSI-RS-BFD","paragraph_zero_based":44330},{"literal_text_all_w_t_and_m_t":"Indicates the maximal number of different CSI-RS resources for the UE to monitor PDCCH quality. Corresponds to the UE capability maxNumberCSI-RS-BFD.","paragraph_zero_based":44331},{"literal_text_all_w_t_and_m_t":"maxNumberCSI-RS-SSB-CBD","paragraph_zero_based":44332},{"literal_text_all_w_t_and_m_t":"Indicates the maximal number of different CSI-RS (and/or SSB) resources for new beam identifications. Corresponds to the UE capability maxNumberCSI-RS-SSB-CBD.","paragraph_zero_based":44333},{"literal_text_all_w_t_and_m_t":"maxNumberSSB-BFD","paragraph_zero_based":44334},{"literal_text_all_w_t_and_m_t":"Indicates the maximal number of different SSBs for the UE to monitor PDCCH quality. Corresponds to the UE capability maxNumberSSB-BFD.","paragraph_zero_based":44335},{"literal_text_all_w_t_and_m_t":"sps-MaxNumberConfigsAllCC","paragraph_zero_based":44336},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of SPS configurations. Corresponds to the UE capability maxNumberConfigsAllCC-r16 in sps-r16.","paragraph_zero_based":44337},{"literal_text_all_w_t_and_m_t":"trs-MaxConfResourceSetsAllCC","paragraph_zero_based":44338},{"literal_text_all_w_t_and_m_t":"Indicates the maximum configured CSI-RS for tracking (i.e. TRS) resource sets. Corresponds to the UE capability maxConfiguredResourceSetsAllCC in csi-RS-ForTracking.","paragraph_zero_based":44339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44340},{"literal_text_all_w_t_and_m_t":"11.4Inter-node RRC multiplicity and type constraint values","paragraph_zero_based":44341},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraints definitions","paragraph_zero_based":44342},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44343},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-MULTIPLICITY-AND-CONSTRAINTS-START","paragraph_zero_based":44344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44345},{"literal_text_all_w_t_and_m_t":"maxMeasFreqsMN              INTEGER ::= 32  -- Maximum number of MN-configured measurement frequencies","paragraph_zero_based":44346},{"literal_text_all_w_t_and_m_t":"maxMeasFreqsSN              INTEGER ::= 32  -- Maximum number of SN-configured measurement frequencies","paragraph_zero_based":44347},{"literal_text_all_w_t_and_m_t":"maxMeasIdentitiesMN         INTEGER ::= 62  -- Maximum number of measurement identities that a UE can be configured with","paragraph_zero_based":44348},{"literal_text_all_w_t_and_m_t":"maxCellPrep                 INTEGER ::= 32  -- Maximum number of cells prepared for handover","paragraph_zero_based":44349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44350},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-MULTIPLICITY-AND-CONSTRAINTS-STOP","paragraph_zero_based":44351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c3787e63edb5d8a769bf3562c45f25e4d4e3d7f2c79e7844f9971de0bbbdc621","7f42d9ab4f91b822b856a688f4b08f2300825d0acf56e68f3179bbcc230bf38f","5911e4925b03d24f35b16deb33813e5bfdbd46e9ca524e3e3b09bcf8a70cb771","68a1483e718833679a9704bcbaea5a70daced1583fa82948748e7bb977512a65"