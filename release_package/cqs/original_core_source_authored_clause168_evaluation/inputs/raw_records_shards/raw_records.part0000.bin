(1..64)) OF DGNSS-CorrectionsElement","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"DGNSS-CorrectionsElement ::= SEQUENCE {","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"svIDSV-ID,","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"iodBIT STRING (SIZE(11)),","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["635525bbe6aa7fd35dcb4bea6085217037e6e46bd5e107dd7e511e1af4831d7f","01fc915a078948aa46dd6dbb5a53870bd2a780bf59556ce2125894bcf4dac26f","d338173fdd163e1d83c461bf2a3af3521d7e76c19c883766f0502955f65e8626","91d6378f897434fa42dfea9f973900995357ba3e6fee723ef26d5d35138324c6","d333693269cefd6e5ce0551b43bd80e5212453e5a647ab0d21bf08c3dc142bd8","705ccd1f9a5fdc73e450a90bc43264186f14b3762ee9af5972d22c966cce34e5","6b71bfc8fa22894ab43d40be83305e7d1cb94e7e6a04d74fa9415930133335e2","100d7d2b35694da0c66756aea9aeb95b44ef888104b9dfc9037edcf4e5c3e5be","bd2a60364de9698717acefb50b7a848e8072cf6c37ab5e57be6c149968c97a1e","fa519e449f3534dc2235712b96b3bb6180e23455aa8b119abedb85fc2228cef7","7680d684fd3bcfffe17b1da8d6ff2752c165ada1e1809ef3855adc84f1dea067","c665b6975befe770cf77e98c51a7a260c644e9317ef3cc9d747b6990df54db3a","99e5941bdb1a120d78ef3eabf03f494650bc2e1f7d591476f398438735e3fb72","affead208e8f53bdc5277a9b35bdc221631a820460f1ecf1fe7e95122dade985","5d39929df88a81058ffa6b8916f37dc5e759305732d6a1b5de62e9a4f9579259","7cb3f0091461e143bde85f700478bd3813eff77b63c3e3f54ed1838065928e08","be63bc5f9a4c51aedc5f91fd02aee52aff4dcbabd632720c359858e3a95d899c","cbe2fafef351de38ca9a82e3e5c3f81dca9952ff90d96715ef34abb0afcf510a","a1a77f1e70f7f674d5eb610669037a4578f46d044a89bb8f