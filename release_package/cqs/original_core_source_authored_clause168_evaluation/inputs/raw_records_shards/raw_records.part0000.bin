6                    INTEGER (0..27),","paragraph_zero_based":39137},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16                    INTEGER (0..31)","paragraph_zero_based":39138},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39140},{"literal_text_all_w_t_and_m_t":"SL-BetaOffsets-r16 ::=                 INTEGER (0..31)","paragraph_zero_based":39141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39142},{"literal_text_all_w_t_and_m_t":"SL-PowerControl-r16 ::=    SEQUENCE {","paragraph_zero_based":39143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d7c7de63c2120e945a8e34ae62f9107ec803eeefe22296a2875d976e5aedbf16","d851fe71b681ef4b2f2de2ac9539dcce43125b046dbb725d2f6e7319a98ad6e1","17cfb825f92b0ad9492085ed7114c01595ea3d51572b4fe4443fd34e8f6b640d","181c54ec0281e241813bb3ce93e999599dddf1dbfd4c67eb36158614ce4062b8","a8d0160a147bb9968607905ee08c3928457a66f666935410996c9833c3b9d3b3","41bc7735620067e2237d1f28c26ae0ee360058f1fb0db4d35231c74a1e500dda","ae276390a10e4a7fa728e0bb2eafd3510675c0b47e60b3faac1dfea292578918","3f1b9e3492d70518c951aee70a0d794d0a5a035d991bfea79dde9c0e4f665d7e","894716d85e999fe229d57368b56762eb1d72d1ad6ac5432a331bf2d51268d8c2","a9633eb0344158899b216b1bb5b1f461b70559cadabe131fec00196501c307e5","2b5d9b0a43e5cbab9a6a2cf8b94b7b25967675a7131022fb2237ade6c2d93712","398a73f34d387adb60f5cc0fbdae91e89fc6974be7711cc0fd006ccf31af9b7c","029da2cdcf5c5edd787c359608fc39b091c715f33481cce3c42e04c79d65752b","68a6b0a8732c8f735dba6fa0e898d33c326ca9dfcba0c96cf47cb87f05e19b1d","db478063c7961cd481a5298b4461c686cc5bf0751761fac221509c633c50614d","eb8c5b53f22abdea44eb5f9ae29ef049