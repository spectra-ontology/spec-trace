XML_sha256":"0ed20e35f80ae6dbd920dbfb65a5ffcc912cf1eceeb6f721c9d4744c57b8a97e","original_member_sha256":"410a03e8639120f55092631249de3d039280236418ef38d73948186067c759a1","paragraph_ElementTree_utf8_XML_sha256":["b24514198c8e8bd85b365a04902dd9534487458020d3207727b64156a0e4170a","dbc099a6f8ab8ff70386cae833fd2f7af8ed10acf01be84d0edcdd87c769af76","8869cd4d8acaae9c09f5083168b326d3b044c8829bd3dbe9c31cb5dcb7f5e5a5","fba0f8a35acf8f7ab1160fb4a56991d09082dcb6c4ad6876c21ef0cd6b3600d4","484e6ddddc72c575611de75cf8061167ac3b1a0d24d764bd626bc94abb284ab4","7a10fd6ebaf38422860599a293120a650bb190c32b4615d9e714cad7fb1e8d22","31b02ad542e00be108165b71e3d1a5f562ff1d133297ff2c1718b502cf35e86e","64e0562afd77b8f4da030f6838b0779f2cd884cfe7bea5c1ff5aa5c10141bf3b","f79c3c77cf402e344501474f4d767f6c9a0968e284d426b208f49ab96fbe4117","fa4f65bb03d040e1d5feb4c5335a924475777f0c16cc79be24073c0ff8eb4736","6cf012cfb33bf632d4e5d1179511318444c46f1b01347732fdf749fe039f67c7","643519ae67e5b3bfd7a3abfd20cfb174e46b17b08a84e631c271c630a6fe12fb","d84ebfb394a07287dd437a057ffa1fe16af2884e3b4bb967737bef83dcf9e25a","9741a5d314da645900189e475769435c7289f600966199dd009d4ff3c023f63d","d379664a8014d2c0d46f8096835b033268cb5c9ba30abeac3515700198df477f","c50baebc7c388cee71dd6817bff399731fd26fdc90035f42a6861dc753beee86","7ae65d5e66fcfa6ff46a9dfa65db920887fd72712497c085d2222dfc148783b5","1dbe74d72dbe0b03ab97e820c4550db4ded771576fe3d61f8a471bce690542a1","0e6aaafa496a850a3e597695ef8987459b76859fddf34eb55ab279089604b2bc","e200053cc2d08324abf7e1febd8cd86f24fb873e708bb02d59927a91f42148a1","58e633018f3909f2bfee4fcfc9eb3b89c69da7e1d0de12bb6a01898efce26f24","3022064d0c8371bb809b259cdeb5dae8261157d530dc2bbebfe9b47a31370d21","3b6186e976652334d47b087ec0bf1d9816bbf6d9193a9444298eb0dcc63f16e6","89c19289c46aee6253c66646e9a147cd6e075be0554fbd89362a966a0def437c"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"sourc