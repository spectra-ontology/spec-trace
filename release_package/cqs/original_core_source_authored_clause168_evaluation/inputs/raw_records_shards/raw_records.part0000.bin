{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 36.304 [27]. Actual value Qqualmin = field value [dB].","paragraph_zero_based":13680},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":13681},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 36.304 [27]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":13682},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":13683},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 36.304 [27]. Actual value Qrxlevmin = field value * 2 [dBm].","paragraph_zero_based":13684},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":13685},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 36.304 [27]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":13686},{"literal_text_all_w_t_and_m_t":"t-ReselectionEUTRA","paragraph_zero_based":13687},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionEUTRA\" in TS 38.304 [20].","paragraph_zero_based":13688},{"literal_text_all_w_t_and_m_t":"threshX-High","paragraph_zero_based":13689},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighP\" in TS 38.304 [20].","paragraph_zero_based":13690},{"literal_text_all_w_t_and_m_t":"threshX-HighQ","paragraph_zero_based":13691},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighQ\" in TS 38.304 [20].","paragraph_zero_based":13692},{"literal_text_all_w_t_and_m_t":"threshX-Low","paragraph_zero_based":13693},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowP\" in TS 38.304 [20].","paragraph_zero_based":13694},{"literal_text_all_w_t_and_m_t":"threshX-LowQ","paragraph_zero_based":13695},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowQ\" in TS 38.304 [20].","paragraph_z