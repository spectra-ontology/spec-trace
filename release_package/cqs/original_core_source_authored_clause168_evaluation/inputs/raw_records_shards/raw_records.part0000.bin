{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToAddList           SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16776},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToReleaseList       SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":16777},{"literal_text_all_w_t_and_m_t":"    tci-PresentInDCI                        ENUMERATED {enabled}                                  OPTIONAL, -- Need S","paragraph_zero_based":16778},{"literal_text_all_w_t_and_m_t":"    pdcch-DMRS-ScramblingID                 INTEGER (0..65535)                                    OPTIONAL, -- Need S","paragraph_zero_based":16779},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16780},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16781},{"literal_text_all_w_t_and_m_t":"    rb-Offset-r16                       INTEGER (0..5)                                            OPTIONAL, -- Need S","paragraph_zero_based":16782},{"literal_text_all_w_t_and_m_t":"    tci-PresentDCI-1-2-r16              INTEGER (1..3)                                            OPTIONAL, -- Need S","paragraph_zero_based":16783},{"literal_text_all_w_t_and_m_t":"    coresetPoolIndex-r16                INTEGER (0..1)                                            OPTIONAL, -- Need S","paragraph_zero_based":16784},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId-v1610          ControlResourceSetId-v1610                                OPTIONAL  -- Need S","paragraph_zero_based":16785},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16786},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16787},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-r17           ENUMERATED {enabled}                                      OPTIONAL  -- Need R","paragraph_zero_based":16788},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16791},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-STOP","paragraph_zero_based":16792},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16794},{"literal_text_all_w_t_and_m_t":"ControlResourceSet field descriptions","paragraph_zero_based":16795},{"literal_text_all_w_t_and_m_t":"cce-REG-MappingType","paragraph_zero_based":16796},{"literal_text_all_w_t_and_m_t":"Mapping of Control Channel Elements (CCE) to Resource Element Groups (REG) (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16797},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":16798},{"literal_text_all_w_t_and_m_t":"Identifies the instance of the ControlResourceSet IE. Value 0 identifies the common CORESET configured in MIB and in ServingCellConfigCommon (controlResourceSetZero) and is hence not used here in the ControlResourceSet IE. Other values identify CORESETs configured by dedicated signalling or in SIB1 or SIB20. The controlResourceSetId is unique among the BWPs of a serving cell.","paragraph_zero_based":16799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d0400b38f3e0847899d63454077edd61c60b7d68934f96d5acc07699492f0ff4","82978b6489f0c890d5991f378a362ea3424750a575d53bc4c654ac859c57758e","f7ae3c78b388becb92871c62ff9c92cfa0bef57e2ffe2b677c43e8c5a30a5bfc","78c2817c1ed25603b41284f232a135d52cad379a2d241dd3643b3c917ee91c80","c33284234072fe1e22921ae8c1922c028e85a75926763c0186d87d4283ac6116","623306bf8d4e01128b2e351d85568724c39e5c36c0d0bb7a60b8874c98465c2a","df84ab7438960464d3f050be99b797803db5306b2b7f7ce7f1f7f71aad750da7","f9892051ae62f3bb255962a71be005ebb53b82cd76b7c75199fd1d16b7bbb2ed","e159385cdc8f0319aeb12ba6c5c23b6c6271156858285e771ff7386fad8d8c4d","2d2234911b16b88c613fcf98cb41091bc2086995512d11e83ca8d391a194a04e","21bda344f1d8c6ecea42dee6b6066c9b5a58f28bccb27a2873b614d17a8816d6","c57dcbf5434b58b57492bb79f180dfab0c337ae5c09ad09c19a61c1bb959a7f8","ea3ba0b25d901375c25b13b627bdf20a27687f5ad431eae65702d4b68ec6142b","74986971fca3bef066aa5b3bf56512d873ea766d9f09d98c3ecc1ea10ab892f5","72af250fc31480bffbf8d0b7e57ac913321a7bcf60a085ae7adb122d5b6ce159","c639f3dd80408ec4a705b5797390e71c25cb0720e358725248a949359cf51982","672498839e01ea6a43a41e90431f0d8ba1d8cd6cb3b6cdea48d2e923d4095d70","8800cc4508a94a9aa0ecbc860ede210c20272779c4b6647674520664145691a6","b77b1dabc533b9274290d62a095d4f4a8e4d2546500cd84aa5764df917959d75","984a8139a68993c97b42dbfd377b64f18f04ad5b6fa65056a3c2af3f45ca0e65","de37941df0b980497ae46a65737003fa5dd1d159ccbef726c01b194dcf84d6fa","8d73085d6470457b30e61c2d5a50e9dfebdac9656f9acfac7672bdcc2b44b3ee","a4ea3d55a8a756d4b498f2f9af10c821484570634bbcceb3ce06a929646bdc50","5c3069d4473abd033458760f340660da98dc207cc8e3e629d18a86e5dcf68544"],"paragraph_range_zero_based":[16776,16799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16776"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the field controlResourceSetId-v1610 is present, the UE shall ignore the controlResourceSetId field (without suffix).","paragraph_zero_based":16800},{"literal_text_all_w_t_and_m_t":"coresetPoolIndex","paragraph_zero_based":16801},{"literal_text_all_w_t_and_m_t":"The index of the CORESET pool for this CORESET as specified in TS 38.213 [13] (clauses 9 and 10) and TS 38.214 [19] (clauses 5.1 and 6.1). If the field is absent, the UE applies the value 0.","paragraph_zero_based":16802},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":16803},{"literal_text_all_w_t_and_m_t":"Contiguous time duration of the CORESET in number of symbols (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16804},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":16805},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception on this CORESET, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":16806},{"literal_text_all_w_t_and_m_t":"frequencyDomainResources","paragraph_zero_based":16807},{"literal_text_all_w_t_and_m_t":"Frequency domain resources for the CORESET. Each bit corresponds a group of 6 RBs, with grouping starting from the first RB group in the BWP or MBS CFR where the CORESET is configured. When at least one search space is configured with freqMonitorLocation-r16, only the first NRBG,set0size bits are valid (see TS 38.213 [13], clause 10.1). The first (left-most / most significant) bit corresponds to the first RB group in the BWP or MBS CFR where the CORESET is configured, and so on. A bit that is set to 1 indicates that this RB group belongs to the frequency domain resource of this CORESET. Bits corresponding to a group of RBs not fully contained in the bandwidth part within which the CORESET is configured are set to zero (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16808},{"literal_text_all_w_t_and_m_t":"interleaverSize","paragraph_zero_based":16809},{"literal_text_all_w_t_and_m_t":"Interleaver-size (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16810},{"literal_text_all_w_t_and_m_t":"pdcch-DMRS-ScramblingID","paragraph_zero_based":16811},{"literal_text_all_w_t_and_m_t":"PDCCH DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.3.1). When the field is absent the UE applies the value of the physCellId configured for this serving cell.","paragraph_zero_based":16812},{"literal_text_all_w_t_and_m_t":"precoderGranularity","paragraph_zero_based":16813},{"literal_text_all_w_t_and_m_t":"Precoder granularity in frequency domain (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":16814},{"literal_text_all_w_t_and_m_t":"rb-Offset","paragraph_zero_based":16815},{"literal_text_all_w_t_and_m_t":"Indicates the RB level offset in units of RB from the first RB of the first 6RB group to the first RB of BWP (see 38.213 [13], clause 10.1).","paragraph_zero_based":16816},{"literal_text_all_w_t_and_m_t":"reg-BundleSize","paragraph_zero_based":16817},{"literal_text_all_w_t_and_m_t":"Resource Element Groups (REGs) can be bundled to create REG bundles. This parameter defines the size of such bundles (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16818},{"literal_text_all_w_t_and_m_t":"shiftIndex","paragraph_zero_based":16819},{"literal_text_all_w_t_and_m_t":"When the field is absent the UE applies the value of the physCellIdconfigured for this serving cell (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":16820},{"literal_text_all_w_t_and_m_t":"tci-PresentInDCI","paragraph_zero_based":16821},{"literal_text_all_w_t_and_m_t":"This field indicates if TCI field is present or absent in DCI format 1_1 and DCI format 4_2. When the field is absent the UE considers the TCI to be absent/disabled. In case of cross carrier scheduling, the network sets this field to enabled for the ControlResourceSet used for cross carrier scheduling in DCI format 1_1 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16822},{"literal_text_all_w_t_and_m_t":"tci-PresentDCI-1-2","paragraph_zero_based":16823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02c6633b14ef29e9d9e1381a6b51a87e8587afd701f83dbd6c7415fd141145e5","2e290c5c2f3aacfdc2881c0b59f803d6098e2e1d42c5afb86d054b2e9cd37293","e63c4e4ee09b331511cc5b796be706028edd6015d224a1c2176abcc571f3fc64","267eee5a00ff05cb566858d1fe32bfb4855b66d26270ae8f370b8927062e7ada","80ca714551c2c5166fade95b68b54716e3553efae4b254d182d15d4fffba4103","fcb30cc2470ddbdc5cdfdac7180e0874b145cfa51d97c4a655c56359d266196c","199e43223cb1d32e3dd054f680d3f025ac0c787274394ab18d2c4d05dc980886","59855e4a0d3bb7749843c6e343d8cbe5ecbce488e926710e26d25645bcc26964","8529d7044f2364d51b13ce2f1b3bd1c188828b4060876161a30162bd11c33705","a1f975e7c2e1b2fff44829aba2c7d05392462c9ddd6ce015149889536e947a66","8676406995f6c6d8acb930c9d39260a9e3e2731e7ecd1e4b9415586ff292c3e0","9ad014836f9220a6e60831b5a6d64612ac55efa2f87c75eb8882f71fdac14604","ed7f91e4140dd37c172ea6fa6d3757ca35102ec9cf270c49063aab459bd311e7","876bad72720111c400330fcc71ddddeb6dd367bb3f5ea11dfed430110631142d","6646dbcfc68b45f55bbc28d0f61fbfbecafb9aba797d8c1821fd5654cd6da46c","789bc63b4ecaf127cd3212b15384c57e78eb3b18b463e556e0997e6303b9d5bb","83c6998f33138ccebe0f6365250c50a5710f8c60d1ff6807bb3eea9b6d8ea321","a46737dd2efbbe173e216743ea63ad1c6274f416aaf7ecbea2a75722a3d36321","d3101ee94c99447bddac1c5b22f30600c51028229c1ef0b34267e0ba5aabaf1d","b1ad04092cfa05ceedfabc6d70b688360aacda13380962cf1ddd593f41a8503e","cf5e9bafb4cdc2b4f80288571c574767623a7f29cbb4128bd17b0a4e2df3ec92","dd8b00ba013c96dcd9d5656998b6930bf4da6a8cd46fe7bb398cbf7ac00b39f9","b9a542883b6057af2ace9463e165f0f47a1cf4cf317bc8615ea6c4228bc7d244","a471939294ec2fbf8efea5c1eb40d4322557fb3f3321f512e30cd60323c4d22d"],"paragraph_range_zero_based":[16800,16823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16800"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Transmission configuration indicator\" in DCI format 1_2. When the field is absent the UE applies the value of 0 bit for the \"Transmission configuration indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.5). In case of cross carrier scheduling, the network configures this field for the ControlResourceSet used for cross carrier scheduling in DCI format 1_2 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":16824},{"literal_text_all_w_t_and_m_t":"tci-StatesPDCCH-ToAddList","paragraph_zero_based":16825},{"literal_text_all_w_t_and_m_t":"A subset of the TCI states defined in pdsch-Config, either with tci-StatesToAddModList or dl-OrJointTCI-StateList, included in the BWP-DownlinkDedicated corresponding to the serving cell and to the DL BWP to which the ControlResourceSet belong to. They are used for providing QCL relationships between the DL RS(s) in one RS Set (TCI-State) and the PDCCH DMRS ports (see TS 38.213 [13], clause 6.). The network configures at most maxNrofTCI-StatesPDCCH entries. The QCL relationships defined herein do not apply to MBS broadcast.","paragraph_zero_based":16826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16827},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16828},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16829},{"literal_text_all_w_t_and_m_t":"NotSIB-initialBWP","paragraph_zero_based":16830},{"literal_text_all_w_t_and_m_t":"The field is absent in SIB1/SIB20 and in the PDCCH-ConfigCommon of the initial BWP in ServingCellConfigCommon, if SIB1/SIB20 is broadcasted. Otherwise, it is optionally present, Need N.","paragraph_zero_based":16831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16832},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetId","paragraph_zero_based":16833},{"literal_text_all_w_t_and_m_t":"The ControlResourceSetId IE concerns a short identity, used to identify a control resource set within a serving cell. The ControlResourceSetId = 0 identifies the ControlResourceSet#0 configured via PBCH (MIB) and in controlResourceSetZero (ServingCellConfigCommon). The ID space is used across the BWPs and MBS CFRs of a Serving Cell.","paragraph_zero_based":16834},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId information element","paragraph_zero_based":16835},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16836},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-START","paragraph_zero_based":16837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16838},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId ::=                INTEGER (0..maxNrofControlResourceSets-1)","paragraph_zero_based":16839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16840},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-r16 ::=            INTEGER (0..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16841},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16842},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-v1610 ::=          INTEGER (maxNrofControlResourceSets..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":16843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16844},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-STOP","paragraph_zero_based":16845},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e58229389