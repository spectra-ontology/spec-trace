{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2929},{"literal_text_all_w_t_and_m_t":"NR-UE-TEG-ID-CapabilityPerBand-r17 ::= SEQUENCE {","paragraph_zero_based":2930},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-r17FreqBandIndicatorNR-r16,","paragraph_zero_based":2931},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-ID-MaxSupport-r17ENUMERATED {n1, n2, n3, n4, n6, n8}OPTIONAL,","paragraph_zero_based":2932},{"literal_text_all_w_t_and_m_t":"nr-UE-TxTEG-ID-MaxSupport-r17ENUMERATED {n1, n2, n3, n4, n6, n8}OPTIONAL,","paragraph_zero_based":2933},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTEG-ID-MaxSupport-r17ENUMERATED {n1, n2, n4, n6, n8, n12, n16,","paragraph_zero_based":2934},{"literal_text_all_w_t_and_m_t":"n24, n32, n36, n48, n64}OPTIONAL,","paragraph_zero_based":2935},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs-r17","paragraph_zero_based":2936},{"literal_text_all_w_t_and_m_t":"ENUMERATED {n2, n3, n4, n6, n8}OPTIONAL,","paragraph_zero_based":2937},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGsSimul-r17","paragraph_zero_based":2938},{"literal_text_all_w_t_and_m_t":"ENUMERATED {n1, n2, n3, n4, n6, n8}OPTIONAL,","paragraph_zero_based":2939},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2940},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2942},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2944},{"literal_text_all_w_t_and_m_t":"NR-UE-TEG-Capability field descriptions","paragraph_zero_based":2945},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-ID-MaxSupport","paragraph_zero_based":2946},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UE-RxTEGs, which is supported and reported by the UE. This field is applicable for UE assisted DL-TDOA and Multi-RTT positioning. The UE can include this field only if the UE supports prs-ProcessingCapabilityBandList and any of maxNrOfDL-PRS-ResourceSetPerTrpPerFrequencyLayer, maxNrOfTRP-AcrossFreqs, maxNrOfPosLayer, maxNrOfDL-PRS-ResourcesPerResourceSet and maxNrOfDL-PRS-ResourcesPerPositioningFrequencylayer. Otherwise, the UE does not include this field.","paragraph_zero_based":2947},{"literal_text_all_w_t_and_m_t":"NOTE:A single value is reported when both Multi-RTT and DL-TDOA are supported.","paragraph_zero_based":2948},{"literal_text_all_w_t_and_m_t":"nr-UE-TxTEG-ID-MaxSupport","paragraph_zero_based":2949},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UE-TxTEGs, which is supported and reported by the UE. This field is applicable for Multi-RTT and UL-TDOA positioning. For UL-TDOA, the UE can include this field only if the UE supports supportedSRS-PosResources defined in TS 38.331 [35]. For Multi-RTT, the UE can include this field only if the UE supports maxNrOfDL-PRS-ResourcesPerResourceSet, maxNrOfDL-PRS-ResourcesPerPositioningFrequencylayer and supportedSRS-PosResources defined in TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":2950},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTEG-ID-MaxSupport","paragraph_zero_based":2951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["77a961a42f9e55e2ba904bf43af3c00426271f10a6d56ac8bbbaea2ef3f70061","c67e98a6cd5ec1841f18d75253b8f06c3d02d9c0dc5d390d00c58b773f1ee446","8e5245755cb440a978619967fb340ff18feaf045017fec7cab4e4dff35a7a6ba","e3eff2811a9e4e89ce87e5ca970cddccc5429496e5647c6619a138a80317bd5d","d6402556d923345a1cb6546a723c8c1e815a2d6c855d0636f74ee879a3e7c81c","27296922b1c5953eee28f1b3b66759d0072379b8ac2926d81c7b09fc85776133","b8f8c388975ac91d57125dd1826ed9c08183695b9934c659101cfb9c1aa6fa93","78e654fc9d597926754bafbef3094017e09892a45dcaf0d80b9a9d791147808e","fdcb76ad6dddc1880d1cac5b19455be28027dbb85df96e61ad7b0fc1c3c0667c","92b3e8040ea6ec311961a5d15a9c6b85638dcfdb412179290061f167414f7381","61c228f53c67880c703cb59ae8728e42e4cab2b05f19713f6eece64f55347b8a","1d348849d44be196df470c0cc1c54f5a8b366c24d8cd09fc925a2eabf8c7749f","5b92ee34480278f53e9ddb8634d38a7b477a9df6326c50ad381237572738dde4","102ca9b92caffe0a7faef90481e92567faf678c01c6135a77523c374ef61ba17","b4b623e3c5487cc2fe6d35c55357fdd6ef78ff1aba619d56d851e383afc7690e","b33ac078642749b7948d1fc991860ae5a5fcf1a1336bec89bf7366a6a885205c","0c6a2c09e1b651d3a12520c32bc0dd6968c7fc61eec4dd178235157f694eeeec","f8871da0859c5a4f95291f4185be80fcebca439ecb581dfde7106c91c81de13e","c547aae64fa2b0ef20512c239ee7f20fd8e67032eb69d87a9eb1d26e3a7cc832","c0611ff81e1c4c18bf91c5f86b0f24ac174569c4a05748ac8c4ca3ec947bdc6e","d68d1dd033bedf2f0407a77b9f6e5f933c9955eaf66a664cd6095c66736baf04","6d3e578dee0bf981d1dedb7b9d7b762af5746629e2a898651067b6e759b86abf","9faaaeeea83f956ccb719d29c00f0f230a6339edfec4eb8bfe450886eb7d76c0","29b773c1fe0d7676abbc858e0af399c77cabf59f5ea270528a4994590afef736"],"paragraph_range_zero_based":[2928,2951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2928"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UE-RxTxTEGs, which is supported and reported by the UE. This field is applicable for Multi-RTT positioning. The UE can include this field only if the UE supports maxNrOfDL-PRS-ResourcesPerResourceSet, maxNrOfDL-PRS-ResourcesPerPositioningFrequencylayer and supportedSRS-PosResources defined in TS 38.331 [35]. Otherwise, the UE does not include this field.","paragraph_zero_based":2952},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs","paragraph_zero_based":2953},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of different UE-RxTEGs that a UE can support to measure the same DL-PRS Resource of a TRP. This field is applicable for UE assisted DL-TDOA and Multi-RTT positioning. The UE can include this field only if the UE supports nr-UE-RxTEG-ID-MaxSupport. Otherwise, the UE does not include this field.","paragraph_zero_based":2954},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGsSimul","paragraph_zero_based":2955},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UE Rx TEGs for measuring the same DL-PRS Resource simultaneously. This field is applicable for UE assisted DL-TDOA and Multi-RTT positioning. The UE can include this field only if the UE supports measureSameDL-PRS-ResourceWithDifferentRxTEGs. Otherwise, the UE does not include this field.","paragraph_zero_based":2956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2957},{"literal_text_all_w_t_and_m_t":"–NR-UL-SRS-Capability","paragraph_zero_based":2958},{"literal_text_all_w_t_and_m_t":"The IE NR-UL-SRS-Capability defines the UE uplink SRS capability.","paragraph_zero_based":2959},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2960},{"literal_text_all