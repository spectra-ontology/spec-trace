9a1a169705fb065098069cbd12ac480bf77e2411","9f2c2058ee3eced0de55f2539be664640e8131e755222317e2d1f28c4ebe615f","9a3d3941ffa2881d9c9080620036b1e464461319ecdd026d42676979fb570f65","1d788ca31f0f295c5e55fa64721d1382b5a3fa26123b5c1454c349dfc36b132a","9d98d257c8a341c722a8eb89789ebd9f513aac17187086e38f73258df83dd4ec","522f42097b0de1657eb5209168b0c984ab7bebd1f4b05ff8cbb2f3701b1d1c1f","7f1d49f2ec4e67dd9385bf9391540dcc2be5d5f54f1f43db58948c87c6ae9789","075db51397896385a898a84500bb5982e3d0a6d37bb8ee29cc7298c468328d6d","29ee39fbf24c362c047bcf838f1eeebadb3646d1a6590355d42186f564a67336","b5d87e992a804a66f83dbe54cddcfff2aa40f827cd898a3e0b453b92dd5849c3","44b74a8dcbc0040f01ea65da1a9b261e7c9a982607929e257c57a8a6db71e0d8","dd1364c7f80953e6f3af31d14470c05cf76dda4e1241d856cd85ebfd54703e67","9e2b8d11987ff7858a42489ab0aa585bc8e7cc07353342329ec88d6ee70794a2","ab2dabda8abdee464e634deec53f83ca87a72b439b412403c391ac44f94e4a59"],"paragraph_range_zero_based":[23112,23135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23112"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-BlindDetectionCA-CombIndicator-r17 ::= SEQUENCE {","paragraph_zero_based":23136},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA1-r17                  INTEGER (1..15)                                        OPTIONAL,   -- Need R","paragraph_zero_based":23137},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA2-r17                  INTEGER (1..15)                                        OPTIONAL,   -- Need R","paragraph_zero_based":23138},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCA3-r17                  INTEGER (1..15)","paragraph_zero_based":23139},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23141},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSICALCELLGROUPCONFIG-STOP","paragraph_zero_based":23142},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23144},{"literal_text_all_w_t_and_m_t":"PhysicalCellGroupConfig field descriptions","paragraph_zero_based":23145},{"literal_text_all_w_t_and_m_t":"ackNackFeedbackMode","paragraph_zero_based":23146},{"literal_text_all_w_t_and_m_t":"Indicates which among the joint and separate ACK/NACK feedback modes to use within a slot as specified in TS 38.213 [13] (clause 9).","paragraph_zero_based":23147},{"literal_text_all_w_t_and_m_t":"bdFactorR","paragraph_zero_based":23148},{"literal_text_all_w_t_and_m_t":"Parameter for determining and distributing the maximum numbers of BD/CCE for mPDCCH based mPDSCH transmission as specified in TS 38.213 [13] Clause 10.1.","paragraph_zero_based":23149},{"literal_text_all_w_t_and_m_t":"cs-RNTI","paragraph_zero_based":23150},{"literal_text_all_w_t_and_m_t":"RNTI value for downlink SPS (see SPS-Config) and uplink configured grant (see ConfiguredGrantConfig).","paragraph_zero_based":23151},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-0-2","paragraph_zero_based":23152},{"literal_text_all_w_t_and_m_t":"Indicates if \"Downlink assignment index\" is present or absent in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is absent, then 0 bit for \"Downlink assignment index\" in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is present, then the bitwidth of \"Downlink assignment index\" in DCI format 0_2 is defined in the same was as that in DCI format 0_1 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":23153},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-1-2","paragraph_zero_based":23154},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Downlink assignment index\" in DCI format 1_2. If the field is absent, then 0 bit is applied for \"Downlink assignment index\" in DCI format 1_2. Note that 1 bit and 2 bits are applied if only one serving cell is configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic. 4 bits is applied if more than one serving cell are configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":23155},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH","paragraph_zero_based":23156},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUCCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUCCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clause 9.1.2.1). If the field harq-ACK SpatialBundlingPUCCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUCCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23157},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH-secondaryPUCCHgroup","paragraph_zero_based":23158},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clause 9.1.2.1). When the field is absent, the use of spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUCCH. See TS 38.213 [13], clause 9.1.2.1. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5e98ae85557afdc1cf90d8b4c9747abf581645486cd2e12f1dda81ee2175704e","5e35eed5ba2011ebc9894bf93d3c9eac2b023bdb3cfdf3a81ea88925851ad263","eed60cfe8c991f9c46b2d042b758c76c7ca7c6c122b75507afa4b48f44c8b232","f6ad3be545f4ae7b7769c53df9634608f12340509afd70713ef0016e9075419c","d7866eb5f9d384867c49000a595975ba5f14254531e4bc860350a2d7d53e7817","9840ec9ecbacb3d483469ec83f8986a905d00ad024673678abc8553cfed29077","7e00182077eedb9b92062695c928079f4e30f9bb69521d557ba8130c42c8645d","730da55935a1c546983b09b5e305e4ba0feb48a3c8a8f3f5dec779c4857907e5","fcfc91a9327cf758ec0ceb5e1591ab8ed29d2eda61f6b785c658f89bf0a57d8a","ec5ebf100ace65d3c52a048e78dc793f593b6ef70d9b0e5dd7772046778cf6cd","8336f97f5e8eec753b665ab7e81e28855d6095595ae24b841b8d5680c647a6ab","6629031d1825955472508e272bac3edd718381ff6b24cfa3756a09f4aa45eb17","3353c366cc931690e96c5ec51ee1dbfd61a7f261b2c521a2eb23dc43875c3d67","579b2438869dce910a9c85a7516b487265742d50924943824d613d9f7192b30d","49908151a6aec6aa8e585fc4307c393ceb429f3abdd294793817faa0f5222c6e","7c563cc42863e661da44c6618abced9ce5c137c0f94fff014a2d7c13241b3674","93879fa5dffdb0ee53b4ced18983c487df9107231edda901b5c8a4a68715a301","eac14abc1215d92e8e51db3b0cc4557add0d3369a4c460a646e291e5926e35df","a181b061732350e0beaef1d8ff3a6373141cf1fbcd700d6f9241ed84edc98212","1df754e268b1fab0483022b6ad887254e3a5c4eebd9d6c202b6948c60a6b18c0","dec9a2dd3af971379cad0b8293d1f2d6fbba3d65fcd16103e76ec4cf0c9dd092","5783ba15adc81597da718f8be873caaa02a0e3424ac7d8f2685bd06678346c37","6a65f6179d2649e429a9188814265327d16a71605bd225303bc5bbb5bef23c75","cb7477c0f7e768a8cc3c0783e17b486fffc3d25a19acf7b4d135bf414a9fcc22"],"paragraph_range_zero_based":[23136,23159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23136"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH","paragraph_zero_based":23160},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUSCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUSCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). If the field harq-ACK SpatialBundlingPUSCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUSCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23161},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH-secondaryPUCCHgroup","paragraph_zero_based":23162},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). When the field is absent, the use of spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUSCH. See TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":23163},{"literal_text_all_w_t_and_m_t":"intraBandNC-PRACH-simulTx","paragraph_zero_based":23164},{"literal_text_all_w_t_and_m_t":"Enables parallel PRACH and SRS/PUCCH/PUSCH transmissions across CCs in intra-band non-contiguous CA (see TS 38.213 [13], clause 8.1 and TS 38.214 [19], clause 6.2.1). This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":23165},{"literal_text_all_w_t_and_m_t":"mcs-C-RNTI","paragraph_zero_based":23166},{"literal_text_all_w_t_and_m_t":"RNTI to indicate use of qam64LowSE for grant-based transmissions. When the mcs-C-RNTI is configured, RNTI scrambling of DCI CRC is used to choose the corresponding MCS table.","paragraph_zero_based":23167},{"literal_text_all_w_t_and_m_t":"nfi-TotalDAI-Included","paragraph_zero_based":23168},{"literal_text_all_w_t_and_m_t":"Indicates whether the NFI and total DAI fields of the non-scheduled PDSCH group is included in the non-fallback DL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":23169},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR1","paragraph_zero_based":23170},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 1 (FR1) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":23171},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR2","paragraph_zero_based":23172},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 2 (FR2) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":23173},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetection, pdcch-BlindDetection2, pdcch-BlindDetection3, pdcch-BlindDetection4","paragraph_zero_based":23174},{"literal_text_all_w_t_and_m_t":"Indicates the reference number of cells for PDCCH blind detection for the CG. Network configures the field for each CG when the UE is in NR DC and sets the value in accordance with the constraints specified in TS 38.213 [13]. The network configures pdcch-BlindDetection only if the UE is in NR-DC. The network configures pdcch-BlindDetection2 only if the UE is in NR-DC with at least one downlink cell using Rel-16 PDCCH monitoring capability. The network configures pdcch-BlindDetection3 only if the UE is in NR-DC with at least one downlink cell using Rel-15 PDCCH monitoring capability. The network configures pdcch-BlindDetection4 only if the UE is in NR-DC with at least one downlink cell using Rel-17 PDCCH monitoring capability.","paragraph_zero_based":23175},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator","paragraph_zero_based":23176},{"literal_text_all_w_t_and_m_t":"Configure one combination of pdcch-BlindDetectionCA1 (for R15) and pdcch-BlindDetectionCA2 (for R16) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 as UE capability. The combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 configured by pdcch-BlindDetectionCA-CombIndicator is from the more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":23177},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r17 is used to configure one combination of pdcch-BlindDetectionCA1 (for R15), pdcch-BlindDetectionCA2 (for R16) and pdcch-BlindDetectionCA3 (for R17) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 as UE capability. The combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 configured by pdcch-BlindDetectionCA-CombIndicator-r17 is from the more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":23178},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r16 and pdcch-BlindDetectionCA-CombIndicator-r17 are not configured simultaneously.","paragraph_zero_based":23179},{"literal_text_all_w_t_and_m_t":"p-NR-FR1","paragraph_zero_based":23180},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 1 (FR1). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR1 (configured total for all serving cells operating on FR1).","paragraph_zero_based":23181},{"literal_text_all_w_t_and_m_t":"p-NR-FR2","paragraph_zero_based":23182},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 2 (FR2). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR2 (configured total for all serving cells operating on FR2). This field is only used in NR-DC. A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":23183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["34718de23730e4f0732cd3cf2578f8239e59f694854b57ceffb8377fec21525a","e56b4d532b5f619d2f87a0a2b623eef34ad224159717390020e94df9b2a9c00d","2736f6e312a6f1790f59b79fb8a9b50dcf3c44615a811e09dafe62aca960bc01","9b7ebc5b87c739f94dcd25b941fe80ed1b9ed8e4e89fcd1c7803a72cf04c8ac6","3cb24a934aaef38c667985ac42fb37de2d74e477610283bce286e29228ce9dd8","ef60917d81dd4c7851e693c4be206a610c4c703dd77f6beffed43722e4f4bcd2","067cdd1c1e820e689c3000a64ce8ba3e1363a25dc4ca5887c13ef19599c28bc0","34098f7b8bc906e44aef45e536b992191dc15d4c13ae0eef7ec4b692c1d15693","9cfe26efbaa42f308012263c83194c8a0bd4861c746948abf10639c8e36ba925","6a2c2c7e90fcc67d0513a09ffa49832c486a910de11aaead0a68b83d56095d8c","0f40079827bc5cfd84b11a83c63bcaee3e6507cc4f70187255c9da4ed5ddb789","c5312dd0bb2d317ad1c34ccf50f81506da2af423c237142fa1a0d06de6e904cf","68be06da064d4e9043cf1d51ccd67bd8386fb7136abc05bad210cf12065ee349","a690afa20309bd80df314044251a811fdf24f1d69be5266ebdfb2c1e97a01385","0bb6217da69f50728969db888f91ffdefa7ac8c25a50807dda13c8d595cdd9e3","0fd1ab32ecdc2d416759158441fdbd36f94760d87e3d9525e56e5e3e2a0d71aa","1eb59aaf17b35fec2eb55e15cc16585c681d2b2d163f294752a18b790986335c","638d442e8382b534e93bfba951022175ed2168f11532ff0b1dd58f74abf55073","25a4f170ab4a99daf145225f972ede6af71ce54777c3d150fd5aae211340c0b7","a087d6ca171b3d19c9acd909af795322eab94e69ee22aa5863d14ab0b178e76d","353338309739c95adb9f52ecfc831b31fa023c38480b41ad43ddc077f8165c3b","54b3a1ecf1ee459c154c6773c44a8513eed795f67755d7509aaa3ec0adfca2b9","0650a25cadb2b264cf9da4268d6cbedc5b925dfda64ad993a5c19f0032ec8eb9","24501563a1342c91aaae514ad609091753b1bdb4441701a841e7850dc155e308"],"paragraph_range_zero_based":[23160,23183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"prioLowDG-HighCG","paragraph_zero_based":23184},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where low-priority dynamic grant-PUSCH collides with high-priority configured grant-PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":23185},{"literal_text_all_w_t_and_m_t":"prioHighDG-LowCG","paragraph_zero_based":23186},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where high-priority dynamic grant PUSCH collides with low-priority configured grant PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":23187},{"literal_text_all_w_t_and_m_t":"ps-RNTI","paragraph_zero_based":23188},{"literal_text_all_w_t_and_m_t":"RNTI value for scrambling CRC of DCI format 2-6 used for power saving (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23189},{"literal_text_all_w_t_and_m_t":"ps-Offset","paragraph_zero_based":23190},{"literal_text_all_w_t_and_m_t":"The start of the search-time of DCI format 2-6 with CRC scrambled by PS-RNTI relative to the start of the drx-onDurationTimer of Long DRX (see TS 38.213 [13], clause 10.3). Value in multiples of 0.125ms (milliseconds). 1 corresponds to 0.125 ms, 2 corresponds to 0.25 ms, 3 corresponds to 0.375 ms and so on.","paragraph_zero_based":23191},{"literal_text_all_w_t_and_m_t":"ps-WakeUp","paragraph_zero_based":23192},{"literal_text_all_w_t_and_m_t":"Indicates the UE to wake-up if DCI format 2-6 is not detected outside active time (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not wake-up if DCI format 2-6 is not detected outside active time.","paragraph_zero_based":23193},{"literal_text_all_w_t_and_m_t":"ps-PositionDCI-2-6","paragraph_zero_based":23194},{"literal_text_all_w_t_and_m_t":"Starting position of UE wakeup and SCell dormancy indication in DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":23195},{"literal_text_all_w_t_and_m_t":"ps-TransmitPeriodicL1-RSRP","paragraph_zero_based":23196},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start.","paragraph_zero_based":23197},{"literal_text_all_w_t_and_m_t":"ps-TransmitOtherPeriodicCSI","paragraph_zero_based":23198},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start.","paragraph_zero_based":23199},{"literal_text_all_w_t_and_m_t":"p-UE-FR1","paragraph_zero_based":23200},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR1 (configured for the cell group).","paragraph_zero_based":23201},{"literal_text_all_w_t_and_m_t":"p-UE-FR2","paragraph_zero_based":23202},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR2 (configured for the cell group). A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":23203},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook","paragraph_zero_based":23204},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to both CA and non-CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). If pdsch-HARQ-ACK-Codebook-r16 is signalled, UE shall ignore the pdsch-HARQ-ACK-Codebook (without suffix). For the HARQ-ACK for sidelink, if pdsch-HARQ-ACK-Codebook-r16 is signalled, the UE uses pdsch-HARQ-ACK-Codebook (without suffix) and ignores pdsch-HARQ-ACK-Codebook-r16. If the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary PUCCH group. Otherwise, this field is applied to the cell group (i.e. for all the cells within the cell group). For the HARQ-ACK for sidelink, if the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary and secondary PUCCH group and the UE ignores pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup.","paragraph_zero_based":23205},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookList","paragraph_zero_based":23206},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured). For the HARQ-ACK for sidelink, the UE uses pdsch-HARQ-ACK-Codebook and ignores pdsch-HARQ-ACK-CodebookList if this field is present.","paragraph_zero_based":23207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9e641d22642539ffe1c0d4a798d19ed4cdd4f145f3cccb47329095dd21b066bd","12d93c39e3906797cf1017ed5ce3ce3ac4ca9d5770e75167f998c788b69bb9f3","49cb6024421877dd3ac15091e629abc11c1c22aa524b4fb383269162f5e4a8e8","4ea2c97f08e8167d9e2723d1c40cb9909635288d7a4649e7d255b26808ea0ede","645eba63efe56d10db082d9694a4cfb1f2fd0def3fadaf4ab70ac4b9de089112","0a934e86b98ec8a010cf780a7fdaf903d626b12c0c4ba285a6e5ba7ea5cf4dee","f41c689d5ec55b032bb3791d7d318e49c81f73e69a7f6c0df0d4ebc525c43255","24c32f2141455d05baae4af4fbff802d297d33c9022a9d8ae14ad2080f99b2f5","b334d1311ba04029932e5c95f6eb6749e5c48dccc89c048ad1df416d70758485","006c19d23e5f56e8af9758b3d2f40123f4abfa028754d80732ec39956eec37a6","996f871709cc3512a06768536ef228314a2c310dbd4e924e9b2448734b19d848","9edb01dc29a5574399d6b88097fe8596188da6091eb81daa28161339c6e48258","9db654244a371b106c8879ae3b5b4b96bedb82e549cf9d68225e90ad118a8fb8","7e205b2faf36ea3759416069ab3cdf3e49ef6b619b6d570c3564e86f160b1b60","c5fd90fdf04722e4da95821c05ab56ef448836cc8cb85346d54092c18368b3b8","e997e8722c59d5e8bef54d11f0e267803350f05363e495c5c5d7381299a1944c","4e9c13c1991ce0f37ac906786ba8ada2ca091b671c180aa491c49f5cd9fa2f63","e3e8502f8f6280d858da79eb39a90c6c8753d9efc39d948e6f4f46d3e93b8a6c","431ecaa0407570814fe42d89c5e09c1aae3a7aa1ef2d4b391a056e89578f0bac","15fea6039b67bc40e404239524cfce61519e3d920e5cee65d7355251cbc987cc","7b8983ef84958ac3f3204dbd6fa0de12e75565ee0c034c61910069dc83d5a06a","3bbf50233ae432776ed1f1867564e388fe5aaa5a058f775c5476a0661bfa6408","821a2351485b4eba671c1e53365008672713894b9c227e983cfd7e7119c7e1d7","9c2b25f92282ada64dca577928bfa85d3a3b2b7a36c43a63f86d4af75ac983e8"],"paragraph_range_zero_based":[23184,23207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23184"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup","paragraph_zero_based":23208},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). It is configured for secondary PUCCH group.","paragraph_zero_based":23209},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field, pdsch-HARQ-ACK-EnhType3DCI-FieldSecondaryPUCCHgroup","paragraph_zero_based":23210},{"literal_text_all_w_t_and_m_t":"Indicates the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in the primary PUCCH group if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH group, or in the secondary PUCCH group if the more than one enhanced Type 3 HARQ-ACK code is configured for the secondary PUCCH group, respectively.","paragraph_zero_based":23211},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3ToAddModList, pdsch-HARQ-ACK-EnhType3SecondaryToAddModList","paragraph_zero_based":23212},{"literal_text_all_w_t_and_m_t":"Configure the list of enhanced Type 3 HARQ-ACK codebooks for the primary PUCCH group and the secondary PUCCH group, respectively. When configured, DCI format 1_1 can request the UE to report A/N for one of the configured enhanced Type 3 HARQ-ACK codebooks in the corresponding PUCCH group (see TS 38.213 [13], clause 9.1.4). The network can configure pdsch-HARQ-ACK-EnhType3SecondaryToAddModList only if secondary PUCCH group is configured.","paragraph_zero_based":23213},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedback","paragraph_zero_based":23214},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":23215},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackCBG","paragraph_zero_based":23216},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include CBG level A/N for each CC with CBG level transmission configured. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":23217},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackNDI","paragraph_zero_based":23218},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include NDI for each A/N reported. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":23219},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Retx, pdsch-HARQ-ACK-RetxSecondaryPUCCHgroup","paragraph_zero_based":23220},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource in the primary PUCCH group and the secondary PUCCH group, respectively (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":23221},{"literal_text_all_w_t_and_m_t":"pucch-sSCell, pucch-sSCellSecondaryPUCCHgroup","paragraph_zero_based":23222},{"literal_text_all_w_t_and_m_t":"indictates the alternative PUCCH cells for PUCCH cell switching in the primary and the secondary PUCCH group, respectively. For the primary PUCCH group, it is configured for cells on top of SpCell. For the secondary PUCCH group, it is configured for cell on top of the PUCCH SCell.","paragraph_zero_based":23223},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDyn, pucch-sSCellDynsecondaryPUCCHgroup","paragraph_zero_based":23224},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_1 is enabled (see TS 38.213 [13], clause 9.A, clause 9.1.5), respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":23225},{"literal_text_all_w_t_and_m_t":"pucch-sSCellPattern, pucch-sSCellPatternSecondaryPUCCHgroup","paragraph_zero_based":23226},{"literal_text_all_w_t_and_m_t":"When configured, the UE applies the semi-static PUCCH cell switching (see TS 38.213 [13], clause 9.A) using the time domain pattern of applicable PUCCH cells indicated by this field, respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":23227},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH, simultaneousPUCCH-PUSCH-SecondaryPUCCHgroup","paragraph_zero_based":23228},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions with different priorities for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":23229},{"literal_text_all_w_t_and_m_t":"simultaneousSR-PUSCH-diffPUCCH-Groups","paragraph_zero_based":23230},{"literal_text_all_w_t_and_m_t":"Enables simultaneous SR and PUSCH transmissions in different PUCCH groups (see TS 38.321 [3], clause 5.4.1, clause 5.4.4).","paragraph_zero_based":23231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7f4b3e24614d1f2f9a0355657f872729b6ba0de4dbc87b9b70f838e0f3eb8277","7089ea0ce34a4bf420ac8d9026f566fc7d91307a106c1186c545eab2244ffd0c","6160e25daaacd43497acb5212ec10f16006a9e2b9a2121ab2010e38554d8d73e","e0572d158843e5820d6d278ef52871c88874119323425a92d26e5d6dc9231ee3","f3b839a94d99f5aa25ba95d7a56bf06ede835fe813571e0edfab4600c60aaf22","293028573f724f95cd2679e476d6ebcf9aefa35258cb4e416b90ca36984f544c","1f7660096fe6379b98e1a990b2861babc8031b3942dc5957e8a4ab0c2b4ce41a","fc0db70b2f490c9d5a7e847a7ab04affd61f389b03746eaa234f1305896fb0b4","1751541afc08e084cd8d6b3927af00feef2793fc0c652d2c36586cbad5b7fbfe","d0787a500a231ef3a127320eda55022318e56609482b9682c19e976982299399","1e50a8e9528a5a15e6360f3ffebdb3078894ae11781700d61aba90ff5f237483","0ca00b48731838394a86d1eacaf642bf40c8ab8310ec521df89ee500e226be33","7c1e1292fdec0045d1ba5c12663ee5f1d9f1d8498b506a1ed47958938155f735","8d70ab213d9b684595fdfcda1641c6061f589edebc65a3329edda46591a993c6","a75cf17203fdfc1306d7bfe76247e80ace18863d51f16fb96c5a894b398c2569","cf462d4d3192bc2fefca0856c9b7743653db762dc9aeff15e8f0887dac4e4851","1e7ab0b31503b85da23a7bb2be1811aeb01c655a8def695c45558ecc10a9a2af","111c1efbe89c0ef15e3d137a64d87b59454969ad41587b9b52225bcdfd743e05","e08392a7010df572624f931eaeb0ebf2d0ca25f1d2d6cf1561f0db3cd51adb9f","3847d0f5ed268427d59b608453f89c6d83896aa06a1bb1d91564fd6308f83fa7","7511f13b517b3b5977846fb5a62c53d5bc3982f93f360a45da666c38d4c5921e","04016b46bd8728d8ef6f0ce6fe83887b3008cba31d5007bf2b29c728880395e7","b0dbe203c0d66e904452e2a950bb62aa230247315acfe27ec61bc5466f83279c","5ba7240905504e86056613df335decc9663afcf27db52ac52f63e634f150c987"],"paragraph_range_zero_based":[23208,23231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23208"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sizeDCI-2-6","paragraph_zero_based":23232},{"literal_text_all_w_t_and_m_t":"Size of DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":23233},{"literal_text_all_w_t_and_m_t":"sp-CSI-RNTI","paragraph_zero_based":23234},{"literal_text_all_w_t_and_m_t":"RNTI for Semi-Persistent CSI reporting on PUSCH (see CSI-ReportConfig) (see TS 38.214 [19], clause 5.2.1.5.2). Network always configures the UE with a value for this field when at least one CSI-ReportConfig with reportConfigType set to semiPersistentOnPUSCH is configured.","paragraph_zero_based":23235},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH-RNTI","paragraph_zero_based":23236},{"literal_text_all_w_t_and_m_t":"RNTI used for PUCCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23237},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH-RNTI","paragraph_zero_based":23238},{"literal_text_all_w_t_and_m_t":"RNTI used for PUSCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23239},{"literal_text_all_w_t_and_m_t":"tpc-SRS-RNTI","paragraph_zero_based":23240},{"literal_text_all_w_t_and_m_t":"RNTI used for SRS TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":23241},{"literal_text_all_w_t_and_m_t":"twoQCLTypeDforPDCCHRepetition","paragraph_zero_based":23242},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is expected UE to identify and monitor two QCL-TypeD properties for multiple overlapping CORESETs in the case of PDCCH repetition.","paragraph_zero_based":23243},{"literal_text_all_w_t_and_m_t":"uci-MuxWithDiffPrio, uci-MuxWithDiffPrio-secondaryPUCCHgroup","paragraph_zero_based":23244},{"literal_text_all_w_t_and_m_t":"When configured, enables multiplexing a high-priority (HP) HARQ-ACK UCI and a low-priority (LP) HARQ-ACK UCI into a PUCCH or PUSCH for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":23245},{"literal_text_all_w_t_and_m_t":"ul-TotalDAI-Included","paragraph_zero_based":23246},{"literal_text_all_w_t_and_m_t":"Indicates whether the total DAI fields of the additional PDSCH group is included in the non-fallback UL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":23247},{"literal_text_all_w_t_and_m_t":"xScale","paragraph_zero_based":23248},{"literal_text_all_w_t_and_m_t":"The UE is allowed to drop NR only if the power scaling applied to NR results in a difference between scaled and unscaled NR UL of more than xScale dB (see TS 38.213 [13]). If the value is not configured for dynamic power sharing, the UE assumes default value of 6 dB.","paragraph_zero_based":23249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23250},{"literal_text_all_w_t_and_m_t":"MulticastConfig field descriptions","paragraph_zero_based":23251},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookListMulticast","paragraph_zero_based":23252},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks for MBS multicast. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured).","paragraph_zero_based":23253},{"literal_text_all_w_t_and_m_t":"type1CodebookGenerationMode","paragraph_zero_based":23254},{"literal_text_all_w_t_and_m_t":"Indicates the mode of Type-1 HARQ-ACK codebook generation, as specified in TS 38.213 [13]. Mode 1 is based on the k1 values that are in the intersection of K1 set for unicast and K1 set for multicast. Mode 2 is based on the k1 values that are in the union of K1 set for unicast and K1 set for multicast.","paragraph_zero_based":23255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e39bd5167177fad5be068a84d3616df370acfde606c5a116654fb6e8ca06571a","51c8822e9eeb36f9d4d6b4794bea59fa56010690c0f6b46bcc6ffc2b112db2b4","9253b289e47b052d6e97e7fb9e3f365d69148a1ac3048b7f4de9bc2b4e84fd3b","213730284b53971daedcc26b7522de8184d3ab1dfa93e8f09c8c95717af9801a","6396d91ff64cff7a9a23f0a71c250b1bd6259169b02dfeaf2c30d95bbd2d5003","b2afacc517a88a5f54b3a9cc8e848923f46ab45565abacec725c0c2a945dbc02","79abb8e632cb45edb666b77329bc838a95d28bbd618ae949b62a73439ec45430","34d9dd3e0fc1ac90f55534e71c707f0f2db2b2be749fcf68b3987507c89427f5","9637da05b8eb2a9dca1eb65f5284c01b2d8f298f9d20a148962b844379ab247b","e4b74d3e3092c8f9768ab905c98a187b3c97e897b787ae04029b57d551cac3ef","cc6aa7b1f9a24b051152657459226b6e6a6d52b09cbfc5dcd0fed7fb335c35d4","54367991c97695b56e9de6a3e582e17159ef3a57741a2dd68e69c0c967c37dce","7fee015ac75c497ee539456ae3c77be804c2f783da029509ac97cc2e58439b51","910f012f0057734d9da834dcf86f90f1006bfa7236ad6544bbecc03bf1653880","1d78f1f912cef720469f5419220fb46f01351442e31feab0a54f7d595e1ea3af","557cd6beeda76beafafebb73f6991aa17edb58bc23518bd2f2c9914ab111390e","b34fa9903bfafc4f6eb9db32fb806e09995805e5f557d95938f2b006ad676d39","6357ddd9042c93225c7a93847bef52b78f290c32fc04af8697efe8fde59eec3f","5cfec45e5c47e404e756e9e54f9b7348597bbc76fdcfbb9f8a35f823b19947dd","291bf767b1c8bc0d90ebe1d136f487967bc321eecc06fa8f8fce483387be6527","b782b0d2187129ac458c74c360736e49d3c96891e1dc0ccc90637238906c6ea0","cc70879c008e1b450c56bc975a5d9ac76a98cdac6203e782cb1025a659a00900","6830a84a24eb12ecfcfb05d03d7305ce314846b8871037bfdfeba9f383ae7f81","69800589186165b22b9993c52d3241068162a59e477d3b89c2463beea420d971"],"paragraph_range_zero_based":[23232,23255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23256},{"literal_text_all_w_t_and_m_t":"PDSCH-HARQ-ACK-EnhType3 field descriptions","paragraph_zero_based":23257},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3CBG","paragraph_zero_based":23258},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include CBG level A/N for each CC with CBG level transmission configured of the enhanced Type 3 HARQ-ACK codebook. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC.","paragraph_zero_based":23259},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3NDI","paragraph_zero_based":23260},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include NDI for each A/N reported of the enhanced Type 3 HARQ-ACK codebook.","paragraph_zero_based":23261},{"literal_text_all_w_t_and_m_t":"perCC","paragraph_zero_based":23262},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per CC configuration.","paragraph_zero_based":23263},{"literal_text_all_w_t_and_m_t":"perHARQ, perHARQ-Ext","paragraph_zero_based":23264},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per HARQ process and CC configuration. perHARQ-Ext is present only when nrofHARQ-ProcessesForPDSCH-v1700 is present in pdsch-ServingCellConfig of at least one serving cell in the PUCCH group. If perHARQ-Ext is present, the UE ignores perHARQ.","paragraph_zero_based":23265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23266},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23267},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23268},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":23269},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, in the PhysicalCellGroupConfig of the MCG. It is absent otherwise. ","paragraph_zero_based":23270},{"literal_text_all_w_t_and_m_t":"SCG-Only","paragraph_zero_based":23271},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in the PhysicalCellGroupConfig of the SCG in (NG)EN-DC as defined in TS 38.213 [13]. It is absent otherwise.","paragraph_zero_based":23272},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":23273},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise, Need R. ","paragraph_zero_based":23274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23275},{"literal_text_all_w_t_and_m_t":"–PLMN-Identity","paragraph_zero_based":23276},{"literal_text_all_w_t_and_m_t":"The IE PLMN-Identity identifies a Public Land Mobile Network. Further information regarding how to set the IE is specified in TS 23.003 [21].","paragraph_zero_based":23277},{"literal_text_all_w_t_and_m_t":"PLMN-Identity information element","paragraph_zero_based":23278},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f7e5de12ff085fc25ffa8b71735e06beea3e380e40bdfdab60384965b6055298","8f8b85757180e89affd6c5d4f72d0f96880c97ab727d5840313cec01253630a2","bddb89006f273cae485b14250038b9e2056a6383e0873cb70ff2dcc65d665db5","3eb11ca3e858dd5168318185046e2b1d6590e0ad034e5840ec2b3148b344c128","c2b15021fc4109f5a9ecee5865ce36edd3f5da6bd6d0a02102793c765dd97027","e3a029325a993d50d649727e42b9d6de3ce9e2fbb459fc45da36162f8f7f8baa","e0a2ea94b2892d97cbde7718237c66df2aad415a9f74a418a68ecc0c1e696779","f2b7e6f85bf9ca7966d450ffc88bdc04b3f2d48df155458447d77a799c2ae8e9","23107bc086489b54f436d7e0281d14a1519b875fcc3acd9524f413c0a80b56e8","2517ba376a1cbc0e7a613d6b88f9aeeac8adfe7d6d5bdace1f5155037efa9ed7","30e9bc51b3c0e38c6218194bf0a65e05f4a9143e918d2de0851fdbf7bf3155d6","0f33e768f6dc9b34ba2985ac14e97928c7cb6e17e1349de41483e19731bfb9df","81cc983a0c2f1a72acc84e60c983dbbd5bb8f6fd8a0adb36b31e91ff854ac903","1622baadef3f92c5bd54d58d644cc4fa3f590426855866a134f470f3a3dce0d4","985ff548f2e95dbada877e590b3a18cf1444cd9946ef813befbdd836d5118dfe","8f7931eeebfd640c6cec3b720454a0a31892d3f4913692444d3f6f1cc02d35d4","05a3c63107aacfe16599747d59830f8180a485110c624c2dbb2ec05e71b042fa","2e60438c9977f60cc084ad9dae59e92a5e1eabfee2208ef965e86b0c72a769f2","d8790f40b846aea0a4732a766f1bfde14144227711e398b7309f9110d14f960f","e73756404b82ea492e02345326351f6e814d352216de6b27d549816a8da105ee","0df7e4c9ece058cb9978825ada560b948afcf76c95940087de546bd9a6c98455","fa3844a8b5b5f1aa517e2c671e4cbb9747d2663ab3fe77f5cd29ad2c30f1aa51","340176fa081a5204b234f7666c3f7e02250400b3fe92076fa7e5e58ac5bc3cf9","783a2b78751bff78c5fed9807ffef53d4779ddb081b4fe75499c64ced757854a"],"paragraph_range_zero_based":[23256,23279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p23256"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-START","paragraph_zero_based":23280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23281},{"literal_text_all_w_t_and_m_t":"PLMN-Identity ::=                   SEQUENCE {","paragraph_zero_based":23282},{"literal_text_all_w_t_and_m_t":"    mcc                                 MCC                 OPTIONAL,                   -- Cond MCC","paragraph_zero_based":23283},{"literal_text_all_w_t_and_m_t":"    mnc                                 MNC","paragraph_zero_based":23284},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23286},{"literal_text_all_w_t_and_m_t":"MCC ::=                             SEQUENCE (SIZE (3)) OF MCC-MNC-Digit","paragraph_zero_based":23287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23288},{"literal_text_all_w_t_and_m_t":"MNC ::=                             SEQUENCE (SIZE (2..3)) OF MCC-MNC-Digit","paragraph_zero_based":23289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23290},{"literal_text_all_w_t_and_m_t":"MCC-MNC-Digit ::=                   INTEGER (0..9)","paragraph_zero_based":23291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23292},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-STOP","paragraph_zero_based":23293},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23294},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23295},{"literal_text_all_w_t_and_m_t":"PLMN-Identity field descriptions","paragraph_zero_based":23296},{"literal_text_all_w_t_and_m_t":"mcc","paragraph_zero_based":23297},{"literal_text_all_w_t_and_m_t":"The first element contains the first MCC digit, the second element the second MCC digit and so on. If the field is absent, it takes the same value as the mcc of the immediately preceding IE PLMN-Identity. See TS 23.003 [21].","paragraph_zero_based":23298},{"literal_text_all_w_t_and_m_t":"mnc","paragraph_zero_based":23299},{"literal_text_all_w_t_and_m_t":"The first element contains the first MNC digit, the second element the second MNC digit and so on. See TS 23.003 [21].","paragraph_zero_based":23300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23301},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23302},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e84da7efde0026460c8cd667ee2a0ac85f5577ff4297710604c2a2aec8852aff","51e70bf3fd83cf18feddfcab63cdb64dbe47c18dc8d6bdd9af05f2b545ba5d2e","f22d23763b8e7fb4c9eb3bb13539764ad8d65d1f7cb56e3087c5a4816797ac91","8b6b3c78cd05a3e48312f6f1f14c11621762c05c96e2546146afd51adea815ba","6e8a9171fd9fee819c0e6014f3dc5bde7f7a300b3e88b0936baec5e1b2160de5","dad48f6f06f436b9e75ff85a1dfe1fc1b54337323320879fb48f125cefb79689","b96991224100fd03579050eabd66c48ffa38a400269107726e1642b878d94558","377a4bf62b7c4acd0bba2b7a3204f28ba072bda5e1bfa8652d95ddeddf37713a","972a13d3fc9050dac43b9ac03c6c7a931063d9edf61ae013235e66d04797b408","f59137316e1a7127d76591172a039f2ee2acba113650e1250fbbc17d55b34bd0","41ba2613c6188d227ec2f5b4630f0cdb590cb1d51a9d9f1baf31be717f825595","20f0c14babf2dd01e981e33cfd8aaaffccf249aceefcc5e5542c658511f7dfb3","f1c70a3f0b503df7f543189e9a46e70965c15cb13b53cf5066eeb5b2478b653f","d5529ceabcc9595f45e1c5ff5d4b60b15fd8033870ecbef9ad693a7961c9423c","31b7db04faa17810f5c90c0172194fb374bd60c0ac15b2b721ae245d63f3f835","786250dd97bc44576261ad9f40a4fff8c85b2966eb67c