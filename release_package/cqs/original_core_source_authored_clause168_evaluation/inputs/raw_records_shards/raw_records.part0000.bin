{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MCC","paragraph_zero_based":23304},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when PLMN-Identity is not used in a list or if it is the first entry of PLMN-Identity in a list. Otherwise it is optionally present, Need S.","paragraph_zero_based":23305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23306},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityInfoList","paragraph_zero_based":23307},{"literal_text_all_w_t_and_m_t":"The IE PLMN-IdentityInfoList includes a list of PLMN identity information.","paragraph_zero_based":23308},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList information element","paragraph_zero_based":23309},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23310},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":23311},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23312},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":23313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23314},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":23315},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":23316},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":23317},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":23318},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":23319},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":23320},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23321},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23322},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":23323},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":23324},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23325},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":23326},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL       -- Need R","paragraph_zero_based":23327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["78be489ce1ae5f811370a514293d9ae4cb27ed5993d91e4dfd656d26968df510","10c0d2353366fba10496432673a2295038ac023668d03b9a0674b845e82d0e33","b6c2c0ccb214cba7bdff71d9ef88d00a20649e11477b3b587b9cffb1ae58fc07","e14ad638ee18968b041486b771df449d1dc5e89b497377255833d8122e03d0b0","d0502f8b387210f7a984277f0063bda816d612eb606c73bb4d5b535d02521fca","dd26241fa320858672a333de0f06e509490951bf476ea1f93bbcdc5babe27238","055c5bc33b943588324704c211ddd91dbf602a06e75bf45c0f74a50c761b33b4","812f6d4cea66263e9cfc5a82288d3a0f78a7b43195c1f605