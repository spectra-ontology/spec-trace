61a6ee49d8ab8bf7da3cb1cb078ba0f3956b9d6894a5a3f2e4a18aa0b1","aafec44d341690a27a0b7738b41104dcf6a0ab71fc8fc848b76574b07a3bd3e6","6d4c7e2e4b0cf5e22a6ccfa6ed63709e48863833be0f47ef3174f32500aa5529","3f69cb892f5b251c18b648627f8af592397971c37e974fc74afd6a5cc0649c22","70bcd08fcc20a9f19f6568451d875b4a5ee5201f2465170963e6503ad11cfac7"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306788.zip::R2-2306788.docx:p240"}
{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"   stepDown-r18                    StepElement-r18,","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"   upperValidityStepAltitude-r18   StepElement-r18     OPTIONAL,","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"   lowerValidityStepAltitude-r18   StepElement-r18     OPTIONAL,","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"   ...","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"StepElement-r18 ::= ENUMERATED {n1, n2, n3, n4, n5, n10, n20, n50, n100}","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"3D","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if a 3D grid is provided; otherwise it is absent. ","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-GridPoints field descriptions","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"gridPointsSetID","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the LOS-NLOS Grid Point set. It is a regionally unique arbitrary number that is used by the UE to ensure that the LOS-NLOS indications are being applied to the correct set of points.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"referencePointLatitude","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"This field specifies the latitude for the reference point, expressed in the range of -90° , +90°, coded as a number between -224 and 224-1, coded in 2's complement binary on 25 bits. The relation between the latitude X in the range [90°, 90°] and the coded number N is:","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"N=X90∘224","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"where  denotes the greatest integer less than or equal to x (floor operator).","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["baaad475b3f1298066e5efd5b7a2d034e5d930cf51a0fe29329dbf9869523e6f","0bb6cc80a8bec452da7a8d1a9622f3c4251cbbab2ce3aded93b1b4096b1b8168","69d5b48671f506efeca3c205c0b762e937d381e62d78a9e8a41bba4e741976a5","de627669c7203dbeb4b8035876f08a3328a6b7c2611398682eb1e69617f6edfd","9396df6594b50f744f77f45faaf1e6307247abc472148766d9fe43aecaa777a6","f705f2d2b452dd9c08f4f4e7ef7bdb88d6fb7d93e04f39f64880ee0d60ed697d","dc77e3a0dadb3e5c7ad52a23ac276e02ee10b62839568462a815c7d632cbb949","3e582100aaaec5762b2ef4fea43457f0f795517544514de62d270fbc37437312","aec42bad25d2bcad8a915e2e09165e626f6bf9a73be62566ee3f2ce58e331512","fadb96fba4a636e8e401ce63ce976252eb310598529ef4553f8b074cfbe389af","68250eb5164f82448626943be28d0e370e152d4ae0fb21d020a1aa852e43bcda","7eebc3a22ad21d0231ba19028529beaabac871074c46e709a561228d8ac5dae8","c5d62817cc1d3320290db39b51b6235a0e46e92fc15936af8d361a1813dfb180","f9a43aada8df0417121f9a99f3adeb4ccf06129c20a9691d382098247eaaf7fc","1f7bbf94cf399f03560a0780685b522123e0f2da4a5805039bd589674a0228a6","9497eff5b746beeea39984f49671a88f3e5e837101bc89a38d5170b6fa48db12","47d14f31f9a5848342f1e953417c7236adbf339189e0f36de4f88d1ad0d34408","98854d59c7f28e9c9483d81ed756f6e097313b2cbce866564cb5c9107e2f3e62","b32e5c0e3dd7904eacd8379dce23fb864986f2a59a5ecec8b2e38ba6dbfcf2bd","931989385881ad8871deaf44853e1d6d47aa087d94b29782466580d59b24c035","ccca27f939e67e7b183dd97dc79230992a3ec4e76cbd14eb553012039bb917c7","dfd7cc9b173ccadc51b36fe7ed70011997c469ccbbdae05d4c2dc87f46b6e9db","5e7ce010487a02f09d9cb479581c18fbdfdec6ceafb247f1bcf7dfeac101ca65","111686d00bc6989514b4250c1e9d49a22b870d5d084e92612d740b3d0e17f0ad"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306788.zip::R2-2306788.docx:p264"}
{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"referencePointLongitude","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"This field specifies the longitude for the reference point, expressed in the range -180°, +180°, coded as a number between -225 and 225-1, coded in 2's complement binary on 26 bits. The relation between the longitude X in the range [-180°, 180°) and the coded number N is:","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"N=X180∘225","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"numberOfStepsSouth, numberOfStepsEast, numberOfStepsDown","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"These fields specify the number of steps for south, east and down direction respectively.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"stepSouth, stepEast, stepDown","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"These fields specify the spacing of the grid points for south, east and down respectively. The values  n1, n2, n3, n4, n5, n10, n20, n50, n100 encodes 1, 2, 3, 4, 5, 10, 20, 50, 100, meters respectively.","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"bitmaskOfGrids","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"This field specifies the availability of grid data at the horizontal grid points in the array, and applies to all altitude layers of the grid. If a specific bit is enabled (set to '1'), the grid is available. Only the first (numberOfStepsSouth+1)×(numberOfStepsEast+1) bits are used, the remainder are set to '0'. Starting with the northwest corner of the array (top left on a north oriented map) the grid points are enumerated with row precedence – first row west to east, second row west to east, until last row west to east – ending with the southeast corner of the array. If the field is omitted all grid points are used and none omitted.","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"If this field is present and ","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"           - the field referenceAltitudeCoarse is also present, it provides the fine resolution of the 3D grid altitude of the upmost layer.","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"             the field referenceAltitudeCoarse is absent, this field provides the altitude above ground level of the 2D grid with a scale factor of 1m. If the field is absent, the default value is 0.","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"referenceAltitudeCoarse","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"This field is present if a 3D grid is provided and specifies the coarse altitude, scale factor 10m, of the upmost layer of the grid relative to the WGS84 ellipsoid. If this field is absent, a 2D grid is provided, valid for ground level.","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"upperValidityStepAltitude","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the upper validity altitude relative to the grid upper layer altitude, indicating that the data associated to the spatial grid is valid for device altitudes up to the upper validity altitude. The upper validity altitude is (referenceAltitude Fine + 10* referenceAltitudeCoarse + upperValidityStepAltitude) where the values of n1, n2, n3, n4, n5, n10, n20, n50, n100 of upperValidityStepAltitude  encodes 1, 2, 3, 4, 5, 10, 20, 50, 100, meters respectively.","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"lowerValidityStepAltitude","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the lower validity altitude relative to the lowest grid layer altitude, indicating that the data associated to the spatial grid is valid for device altitudes down to the lower validity altitude. The lower validity altitude is (referenceAltitudeFine + 10* referenceAltitudeCoarse – numberOfStepsDown*stepDown- lowerValidityStepAltitude), where where the values  n1, n2, n3, n4, n5, n10, n20, n50, n100 of upperValidityStepAltitude  encodes 1, 2, 3, 4, 5, 10, 20, 50, 100, meters respectively.","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"-GNSS-LOS-NLOS-GriddedIndications","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GriddedIndications is used by the location server to provide GNSS LOS_NLOS indication information. The parameters provided in IE GNSS-LOS-NLOS-GriddedIndications apply to all GNSSs.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["621d2b7ba25e40e40ec255053921aac410264587106271c392c7e806e59d62dc","1de39731cbc5db71794d3c2439d16a59282e055a320e42cb4994e79d157f54f2","c2f5f07ed812f4a558b79b877fc85e62be11fad2c37abb2c0b40a6516cf94dcb","a9b2e2198a5fb25e477fcc50e5b2c64050163a09e04f61aceffc1f1f1707420d","8efbb8d6213782e1e4fe758befd0b20fc83edaf52d70732368cda35a62fae495","de086747474e9491e7acd0d717609726a7f714a3427afbbe4955838161f49601","163915a0ca89b6cce7e0fa0e65b74304308608d900233cd18541e695ea8156c6","9b2adc83e201ccd864f5c5be6bd25f256bc715be343bf4b78573c0ff97fa6940","024b674f01e4c7eaabb