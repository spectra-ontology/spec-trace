932d","823dc9405bd2b8ca8fd59f494c7e7a807e7ffbd823e97a72b9c4db3825f1da06","89cd89979dd3bd0c046c5d980f8aa87792761333ba1cc95caeb6c24db3b07d51","a90b3800c9f294f1b98ae76d5099e51190de7186b8fa5db838f34cad869d52fa","20d0daf514680c0634c05737fd9ecf927e0776bdfad72439c441c0e520caeada","7e7d81f7a39d6c4ee66fe890f15e2abb3122ac90f501453456516b09bfc01b17","b6993674affa90dfc5f88316bbe8230090c232c17a5a90e7ad9d873f90ad071b","6592b3d7add67b668da243d48a071c68e5edc60d5dbf5d70cdc878222dbe1368"],"paragraph_range_zero_based":[744,767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p744"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":768},{"literal_text_all_w_t_and_m_t":"GNSS-NavigationModel field descriptions","paragraph_zero_based":769},{"literal_text_all_w_t_and_m_t":"nonBroadcastIndFlag","paragraph_zero_based":770},{"literal_text_all_w_t_and_m_t":"This field indicates if the GNSS-NavigationModel elements are not derived from satellite broadcast data or are given in a format not native to the GNSS. A value of 0 means the GNSS-NavigationModel data elements correspond to GNSS satellite broadcasted data; a value of 1 means the GNSS-NavigationModel data elements are not derived from satellite broadcast. ","paragraph_zero_based":771},{"literal_text_all_w_t_and_m_t":"gnss-SatelliteList","paragraph_zero_based":772},{"literal_text_all_w_t_and_m_t":"This list provides ephemeris and clock corrections for GNSS satellites indicated by SVID.","paragraph_zero_based":773},{"literal_text_all_w_t_and_m_t":"svHealth","paragraph_zero_based":774},{"literal_text_all_w_t_and_m_t":"This field specifies the satellite's current health. The health values are GNSS system specific. The interpretation of svHealth depends on the GNSSID and is as shown in table GNSS to svHealth Bit String(8) relation below.","paragraph_zero_based":775},{"literal_text_all_w_t_and_m_t":"iod","paragraph_zero_based":776},{"literal_text_all_w_t_and_m_t":"This field specifies the Issue of Data and contains the identity for GNSS Navigation Model.","paragraph_zero_based":777},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted GPS NAV ephemeris, the iod contains the IODC as described in [4].","paragraph_zero_based":778},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted Modernized GPS ephemeris, the iod contains the 11-bit parameter toe as defined in [4, Table 30-I] [6, Table 3.5-1].","paragraph_zero_based":779},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted SBAS ephemeris, the iod contains the 8 bits Issue of Data as defined in [10] Message Type 9.","paragraph_zero_based":780},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted QZSS QZS-L1 ephemeris, the iod contains the IODC as described in [7].","paragraph_zero_based":781},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted QZSS QZS-L1C/L2C/L5 ephemeris, the iod contains the 11-bit parameter toe as defined in [7].","paragraph_zero_based":782},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted GLONASS ephemeris, the iod contains the parameter tb as defined in [9].","paragraph_zero_based":783},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted Galileo ephemeris, the iod contains the IOD index as described in [8].","paragraph_zero_based":784},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted BDS B1I/B3I ephemeris, the iod contains 11 MSB bits of the toe as defined in [23], [50].","paragraph_zero_based":785},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted BDS B1C/B2a ephemeris, the iod contains the IODC as described in [39], [49].","paragraph_zero_based":786},{"literal_text_all_w_t_and_m_t":"In the case of broadcasted NavIC ephemeris, the iod contains 11 MSB bits of the toe as defined in [38].","paragraph_zero_based":787},{"literal_text_all_w_t_and_m_t":"The interpretation of iod depends on the GNSSID and is as shown in table GNSS to iod Bit String(11) relation below.","paragraph_zero_based":788},{"literal_text_all_w_t_and_m_t":"svHealthExt","paragraph_zero_based":789},{"literal_text_all_w_t_and_m_t":"This field specifies the satellite's additional current health. The health values are GNSS system specific. The interpretation of svHealthExt depends on the GNSSID and is as shown in table GNSS to svHealthExt Bit String(4) relation below.","paragraph_zero_based":790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["bdd4a81264e65919610c9b06a8ce9c0c1ae4912b19cf36a60c39500a397bdb62","064e6517734fa39107218f9bb1bc2a662234ceecc913a4525954771b0d5666fe","bbf401a2507cbd6bff8ea680359cc3e455feef10a973bb31bb4c7d6605c38886","4e46544562ebb713dd9dbe3da27858861150cfbd0bbd779b226f0e3913c7c4c2","c983a936cf1fe8ba029c6518d86ba6ca6e7cf74d16b3e57ecd0de9cee91400fc","216ed21a20c38093367794edd7dd59ccd03e123c26059b192ab58f47d7487209","95ef68ec0d31edea32b45f4d9896b90da497d282791f2ee0b51885a122b2db85","59fc6f9940c364ef2471ee316f71df67e38878ea52f6a11c3b8d07e4035c3400","b6c56792ff9ecbc4cf5949fbc0100ddcc27eb5bd1062855775b1462b9dc1f595","8a216840609f455d4b6378208a4703776a373ec022041cbba64f7e8b9b3b2b67","f6f461198e9e19f71d16b5c93f0293b217f501836c7ca97f5a91aa2adec9a2ce","a269b894c7786626f7d3a2e8617f10f618a19a1c4a1b10ab7eb1c4ffe5a84064","135617c86be06ea364e7e3475d25443dda71805df38bd0bf3910608e0c9229e1","3493c223783b890c883ef5e5419f8d15d996337cfaa5f91a70d500fd72f4708d","7f49b40e06ae64aafea0ffd55a1640adb0ea6b5f1ec7046d18f86ec90f91a342","39effc64fe50eb5ca18c0df2b7998337fd37062eb84bfa0dc00a1dc4b9937536","9daa088298e5cbbecd3a3f0837a10ef20f5fae920c41859635ec2227418a13c3","e14428008d07b5c38b6407bdfc60585ad0c684608f5285eb0c8a5cbd9d259407","9b3c7bfebd3a49193019ab1096f227d0d5b0bc0cef99512f60dc711c4fdf1186","0a22d89bbb81731a8ba64bee2f24a7222bb1af347f3d4df0e6be49f63abc4a58","baf5b0ce919a5f613ddcab4be45f6bcb31c56b7325ce83bc2850189bc75dba7f","b362c43cf579303331f13e29fe13412f3f7850e1227956e1db46c9a5b144cfb9","f82a7df70b303cff87505331b4c39d9111716dca55572fedfb78b2925be2e30a","99e8af9e88b3eb9358ab3ccffd6f4f6ab58d8308ba3fb785a184160f2ad1fcb9"],"paragraph_range_zero_based":[768,791],"projection":"All w:t an