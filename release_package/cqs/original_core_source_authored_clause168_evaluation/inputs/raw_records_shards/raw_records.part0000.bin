{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SI-RequestConfig ::=                SEQUENCE {","paragraph_zero_based":28176},{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI                    SEQUENCE {","paragraph_zero_based":28177},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI                       RACH-ConfigGeneric,","paragraph_zero_based":28178},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":28179},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":28180},{"literal_text_all_w_t_and_m_t":"    si-RequestPeriod                    ENUMERATED {one, two, four, six, eight, ten, twelve, sixteen}       OPTIONAL,   -- Need R","paragraph_zero_based":28181},{"literal_text_all_w_t_and_m_t":"    si-RequestResources                 SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResources","paragraph_zero_based":28182},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28184},{"literal_text_all_w_t_and_m_t":"SI-RequestResources ::=             SEQUENCE {","paragraph_zero_based":28185},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex               INTEGER (0..63),","paragraph_zero_based":28186},{"literal_text_all_w_t_and_m_t":"    ra-AssociationPeriodIndex           INTEGER (0..15)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":28187},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                     OPTIONAL    -- Need R","paragraph_zero_based":28188},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28190},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-STOP","paragraph_zero_based":28191},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28193},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig field descriptions","paragraph_zero_based":28194},{"literal_text_all_w_t_and_m_t":"rach-OccasionsSI","paragraph_zero_based":28195},{"literal_text_all_w_t_and_m_t":"Configuration of dedicated RACH Occasions for SI. If the field is absent, the UE uses the corresponding parameters configured in rach-ConfigCommon of the initial uplink BWP.","paragraph_zero_based":28196},{"literal_text_all_w_t_and_m_t":"si-RequestPeriod","paragraph_zero_based":28197},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-Request configuration in number of association periods.","paragraph_zero_based":28198},{"literal_text_all_w_t_and_m_t":"si-RequestResources","paragraph_zero_based":28199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["48bc1a6493c9be43fb35364b2854667ef943081d10e90c7e1d6c9433fd39c5a2","5866363a5378b51ac8e9f248ba7e0244abb8f29f9b8db94b1d04b583b0225357","56bbf15519ea144bb19ebdd773381a44ff755ca9445d0a5039e41bc384389197","f27fd45dbd39ebf077042db9f3f7be6aff5d0f40581b32dde981166213b609c4","87867e9258392302ccf8b38348bea6c5e841a10352ed8911f2087d7ce231e002","6eea7c065fa7ce78723f75a1ebd1fa7137ddbb573aaddff9a471769b5d3ff2c3","2a7b06c31f38700bd8ce1fdc339969719014fb04ad02a8217b45fdff502d8e65","102a804eac0f9ef2c39b27c70488603dd25df2c4eea5bd26950ed7159cb2d441","9fa14065decc72ef68e19e4c75677aa8936c3cd7e79d1e3e995e72d1bfb7697b","3a271f6f7947e0e642ba8addba428de89638ae99d070a7db1f845c01c198f2f5","e67a6009f64ed53f6feed991828f040a027f749b7515c5a389343bd032e192e8","4ccdb34c0a54aa5a63c4e371751da4e798c3d4540ddc5a8cf2e96dd02cdbd489","d2b4ae430dd0bc1f5e75c2d8b37f9636223b62f6326040f61b3f009175bc5ba3","0c140f0dfe4b65a69da5c126edde9737a6db790d4465625f92d0f3821125f458","19edbbabcd7b340d527177da20980327e7d335fbe00d46e05e3d0b0aa3c245e8","800dc9860f23be29233645037e68739c6c8819338a62de6d1c222035aa763fb3","65a52bbac320406eed090824b2ca90cfac3d8172e800f911e15ccc6869098bf7","73c42060089210cca63ed4f5b55fc5f0928793ca1f40d00b737022223959abda","b9c04a9ddfd2c3885c8decb7c1e1edd92b17b52c41358381d8da8251fbd9b120","3aa90dd9a17de2953f18b11e655433c1db484b5ec65e83103e47124c34e32ad8","8bc6bdffedb6e2dd98c740e4e2b5e800f46b6b7da7138f31f7b606d031443f50","1b372f41c12ae804a8653a9a50cf2bed5d633810b603c8425da9ce11d908ead2","c96ebf47c76bfb6a50da3510a93382536475d9eb041338e94dfb847c4aa15b1e","a5f6cf9bb3ac079a050ce6a139bd40c6cf3bed98ff4d8439e9af547275763b6c"],"paragraph_range_zero_based":[28176,28199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28176"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":28200},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfig is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28201},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28202},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":28203},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResources should not result in system information change notification.","paragraph_zero_based":28204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28205},{"literal_text_all_w_t_and_m_t":"SI-RequestResources field descriptions","paragraph_zero_based":28206},{"literal_text_all_w_t_and_m_t":"ra-AssociationPeriodIndex","paragraph_zero_based":28207},{"literal_text_all_w_t_and_m_t":"Index of the association period in the si-RequestPeriod in which the UE can send the SI request for SI message(s) corresponding to this SI-RequestResources, using the preambles indicated by ra-PreambleStartIndex and rach occasions indicated by ra-ssb-OccasionMaskIndex.","paragraph_zero_based":28208},{"literal_text_all_w_t_and_m_t":"ra-PreambleStartIndex","paragraph_zero_based":28209},{"literal_text_all_w_t_and_m_t":"If N SSBs are associated with a RACH occasion, where N > = 1, for the i-th SSB (i=0, …, N-1) the preamble with preamble index = ra-PreambleStartIndex + i is used for SI request; For N < 1, the preamble with preamble index = ra-PreambleStartIndex is used for SI request.","paragraph_zero_based":28210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28211},{"literal_text_all_w_t_and_m_t":"–SI-SchedulingInfo","paragraph_zero_based":28212},{"literal_text_all_w_t_and_m_t":"The IE SI-SchedulingInfo contains information needed for acquisition of SI messages.","paragraph_zero_based":28213},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo information element","paragraph_zero_based":28214},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28215},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-START","paragraph_zero_based":28216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28217},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo ::=               SEQUENCE {","paragraph_zero_based":28218},{"literal_text_all_w_t_and_m_t":"    schedulingInfoList                  SEQUENCE (SIZE (1..maxSI-Message)) OF SchedulingInfo,","paragraph_zero_based":28219},{"literal_text_all_w_t_and_m_t":"    si-WindowLength                     ENUMERATED {s5, s10, s20, s40, s80, s160, s320, s640, s1280, s2560-v1710, s5120-v1710 },","paragraph_zero_based":28220},{"literal_text_all_w_t_and_m_t":"    si-RequestConfig                    SI-RequestConfig                                                OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":28221},{"literal_text_all_w_t_and_m_t":"    si-RequestConfigSUL                 SI-RequestConfig                                                OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":28222},{"literal_text_all_w_t_and_m_t":"    systemInformationAreaID             BIT STRING (SIZE (24))                                          OPTIONAL,  -- Need R","paragraph_zero_based":28223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["501fece1ada1037c90f6ee8a0b8844ec67900ff79d650d02fd518264268bd86b","813e0f15abba016fe78736d862a1fd21fdf205d046f0d2f72a922704a10925a9","0e2aae46f85082fef13be56106e2011672d37214332b8aa74b1dbcbf6ee9a708","8f9d110d07ef9626d421d6bb5d92379ef4e040ee45f4cb99c7adf92c645a821e","e251c5ad67f1563dd55181119a2cfe924e7375eeb1b4ccfade41d76e4aa3717c","fdc73ab2aabf8e19da5ea0dde7df374fb92bcec56a6c12bdb38834fe0dcc3