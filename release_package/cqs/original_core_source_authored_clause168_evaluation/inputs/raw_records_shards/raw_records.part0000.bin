iginal CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["0acf7ae27d65a2a7f436c04729b966932ac55000cb7777f2fb69418757e12104","0fb31118e91272bdd5a0a562e0f99b859ff8a5c41ae77d3022d584adc3293e9b","fa355b2c07e72f67866949e4fe3406ffd33a7b8bde7509ac267d0fe5420b3b99","89aae8e8bff76b133291028db10a3eaf1d1a8a130038286e081965fdeb391f46","da4deecf7c5a5bd5f42480a97cf6929cf895cd3d7a3e0eaf3a3e4b59d6ee6bb3","63082ec996b6fc0f72891768da4d2d3bd75e2d9ea3780e3ad610aee849d358c8","ed06b2f9a08d46bf9bcc004d129ae9d0ae449154c1555ecc5cce59e0f2a3a685","f9be733be6f2b68dd7d9fa15a589f56beff3d38215f03c60240eaeb63c5c8d0a","e044ba2a541e33436fd3e1cf8cc5c01b57b678b8f93a1940b039446403dfe362","b07ac01cd18cff74c5dd90b9455b682713a6a77fef82d55a95a7b31f054ca765","28661a325e42bff478533860f5f2a0f273858900537ad5a44767dce7dc5b5f8b","863bb29cc5f718449f0b18e8c079f26047023c7a1564fe3e8823feeb6e3aaaac","e3ea03e4af2788c2bcb9a28a612eb236851f045d8d892a70f6a09ab5fbcde4f3","d3f5850d4eb1936af3b4186674334cd3fab387b4549308f2194bcccb9e99f334","32f26a09fb5da461ffd173e120f74dda6370fddc7a796009e7f89f5322839176","f0019d8e97744b4a330e641aca009386034bd374385b6aa1aeaf280385dfc384","58689b95af326eeff67cd939472c390313225553b2a547c3540c0987b41048f6","51cf3551d88c2e578cca7ce9659403157b739bc96d84e04ecb6ffdb75bc93863","2718092a3ae57afb24a4f23f47efc58d14e0d8a2caac52519237aa7ed57cfec9","d1332fc18b12ff7b36b827624cc41dea26c9853e3d96f4be3f6af5481556a3df","82232c826f47fc9db51b2951560c283363cd1e9025622173f42c230b69b4cd7f","8df8db8151c2be72910ba8ca0a9cad17b2028a4c113596f317ebef6b46eaa348","faa56612f39ba466a41f8c0727c2103a449ac0c5c45afec80014f5fbe94ef748","3448cd5aee212b04bb0e7f1eb7f9975385948d9593f49f381e19167f3952bdb2"],"paragraph_range_zero_based":[0,23],"projection":"All w:t and m:t i