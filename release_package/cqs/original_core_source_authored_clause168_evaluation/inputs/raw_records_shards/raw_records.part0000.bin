{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25680},{"literal_text_all_w_t_and_m_t":"RefTime","paragraph_zero_based":25681},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if referenceTimeInfo is included in DLInformationTransfer message; otherwise the field is absent.","paragraph_zero_based":25682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25683},{"literal_text_all_w_t_and_m_t":"–RejectWaitTime","paragraph_zero_based":25684},{"literal_text_all_w_t_and_m_t":"The IE RejectWaitTime is used to provide the value in seconds for timer T302.","paragraph_zero_based":25685},{"literal_text_all_w_t_and_m_t":"RejectWaitTime information element","paragraph_zero_based":25686},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25687},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-START","paragraph_zero_based":25688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25689},{"literal_text_all_w_t_and_m_t":"RejectWaitTime ::=                  INTEGER (1..16)","paragraph_zero_based":25690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25691},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-STOP","paragraph_zero_based":25692},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25694},{"literal_text_all_w_t_and_m_t":"–RepetitionSchemeConfig","paragraph_zero_based":25695},{"literal_text_all_w_t_and_m_t":"The IE RepetitionSchemeConfig is used to configure the UE with repetition schemes as specified in TS 38.214 [19] clause 5.1.","paragraph_zero_based":25696},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig information element","paragraph_zero_based":25697},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25698},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-START","paragraph_zero_based":25699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25700},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig-r16 ::= CHOICE {","paragraph_zero_based":25701},{"literal_text_all_w_t_and_m_t":"    fdm-TDM-r16                        SetupRelease { FDM-TDM-r16 },","paragraph_zero_based":25702},{"literal_text_all_w_t_and_m_t":"    slotBased-r16                      SetupRelease { SlotBased-r16 }","paragraph_zero_based":25703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["eca6d77696f2b14128bdf4bd40f853ce74adb1d10fb922a8998b405f3e30d76d","d334c135b4f18caf2acfa21c8c0e19747e4087b76cada8e2ecee31e79ca1b338","8c30f4908ce03e7656f21bf8114d958b9138cb5d145109e9106b0d6188526ba6","f5a48954ecaeea96110f6a1d4b67a537233ecc3d876020a6cd767bb417f40e37","78186604f16f90562dc5690162d9f7dded25b1a4561078139d7a5b3f8ce4f684","45696023d7dbbac3af1bb25087f624768ef80d031915b0df7f4d1230473024d4","9c7fd39a210a691528c14f2b4e2bd72912315d43234e35d3596467e70ba34052","228e8ca70b53b957c8be27d8aa438497ff87301a37667abd85ef0fb3207c2e1b","9e73258933f4741c069c191fcc4cc06dc564075eb4b9c2e6ad0385be5ebbeb49","e8b5221c5f90e844e27b49140ed0e18c31468019974c953142607ab80683b85b","1f2a9cf9e546d3cec0085f2a9237493b6986496f7757169581fff03067d9084e","5744cd351f2d35dde658cf641072fab3e962f8c408dda2a178e246f7a08bd92e","969b0d8fcbe1916c7874d1533d987befc5afd16f0e06e143c19e8cc96e206eeb","bcd230e3d66359918aaf6ac66d395ae9b03a947d9d108f56e4fa363d1d424e95","a66f2f644273c1cb6cbfc2bd2b7ef1a7ce36fd369d3a8873ce4b9bed23df6095","9bc60880123ce8ec42536f4d52ec40abbbd5867500ef44988ec46466df687a9d","68e393225638979dd934b3fb66