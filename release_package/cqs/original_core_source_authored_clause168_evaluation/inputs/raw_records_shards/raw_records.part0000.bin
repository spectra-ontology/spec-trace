2840 - 38300_C0650_Rel-17_Correction to 38.300 on IUC cast type.docx:p24"}
{"fields":{"filename":"R2-2302840.zip::R2-2302840 - 38300_C0650_Rel-17_Correction to 38.300 on IUC cast type.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"RAN1 has made the below agreement regarding IUC Scheme 1.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"For Scheme 1, unicast is supported for an explicit request transmission for inter-UE coordination information","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Unicast is used for the inter-UE coordination information transmission triggered by the explicit request","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"From the above agreement, it is seen that both IUC explicit request and IUC reporting triggered by the explicit request are transmitted in unicast manner.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"However, the corresponding text of clause 16.9.8 in 38.300 is not clear.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"For transmission of the explicit request and reporting for IUC information in unicast manner is supported.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Reformulate the text in the same way as the existing texts for IUC information transmission triggered by a condition.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5fa410a7ffa3e1f88caffede2551dc13218dfb2ab5374b280cff93ae9eeefce3","original_member_sha256":"f6d595631cb9621be67c9ac13fbd053acf174052ca516ce2a9467ec42d9bb9cf","paragraph_ElementTree_utf8_XML_sha256":["07b37f9382cb4563a76e06a3091184f1a25d93efb1d4a7ce6b1912cf5e0344c5","49757793c301e1b42ce3a2f5fe6de1d778711cbd77defe5a9880549543d950b9","2c3c33db3917ad7d8c5dd4327165cee43def6d2814eb537adb4ce0800eb79fe7","337ea18d1cbe73cd23af973173806423cc975a8a8ed020d665da422d8a237198","99f7497d345193f94321fc78259eb1ee9d8374103ccda1740fdba9df311d1159","a072056b2b28ea4e645bcfe95108bfd898635550328034d863c1953441b998c1","5b47f45d49e536de3b6d5e631981f66afc7f1da2e37d6a6a473a2e92e01fcbbc","8bd151c2b6bd30b02395cf315d3840e70074a5c9b7b771d52833ee373298c178","9ee8004cb88a34162bb5eb46c0c18bb0bf1eb58264f6a683d54e41efb29c2c15","4150cbaaabf1e132d6a7c803a37dae13ee904d3b14e33890e023ff2e9aba3f25","2278383fedc6ace6f8f0a92516943d5e75aa7f14ca403617a07b6ffe0a5d4ddb","d64d21a445eb6d60b7cdeb423c7ebff1e9b9d6d8e68fa04c8c9b014923795d8b","0f286b194b59e9918e17b804b443b11d843c7c26e43dda1f0ed905456b089bae","7c858474862d54d3f4dcadcfe6509b8dced7821686f3571639481c0ac4701a06","68470a4648ccf253c334699579a40944269f1a6ed2ffed8a3b6f588dbe5c68b3","fbb3102a0986443dd3a9077e18eb8753bf45f7884eb2f566c7d88917806e3316","f78f632ddef0140d36e651e314d067688d70b78791c0e6a6ba367779b4d0a9b6","782cefcdaa6b61e709629aa9d09d6cf126db09fd17b09bcd0e2964429f302afd","87f38fdf3588b2bb9cbd70ec10756caa3b43819366c7f13ccbfa03aa69b800e2","da1140ef0e0a6334618075d93f790b13d1b2b1039d086905ad1fd3850a8b5da7","73e617924fbb2791ddad8e604f2504911ecff50327de6375beda409dd5928394","4e1cb9063c7437ac44e7a74b230cdb23697e44a42b988844921ae8c5fb7209fb","513262f07b7770e8e408817df16d3766727a2968d7e06b9d964ccdb25576a29c","3cc5eaae6333f3624ac49d1a0cb765f50aa717fdeebbe7c4165d9c8cffbf4802"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2302840.zip::R2-2302840 - 38300_C0650_Rel-17_Correction to 38.300 on IUC cast type.docx:p48"}
{"fields":{"filename":"R2-2302840.zip::R2-2302840 - 38300_C0650_Rel-17_Correction to 38.300 on IUC cast type.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"For IUC information transmission triggered by an explicit request, both the explicit request and the IUC information triggered by the explicit request are transmitted in unicast manner. ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: NR SA ","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"SL IUC","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"If the network implemens the changes according to the CR, but not the UE, there is no inter-operability issue, since the changes concern only UE action.","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"If the UE implemens the changes according to the CR but not the network, there is no inter-operability issue, since the changes concern only UE action.","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"If one UE implements the changes according to the CR but not another UE, the both UEs may have different interpretation to IUC functions as captured in clause 16.9.8. This may affect IUC trigger and report between UEs.","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"UEs may have different interpretation to IUC functions as captured in clause 16.9.8. This may affect IUC trigger and report between UEs.","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"16.9.8","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5fa410a7ffa3e1f88caffede2551dc13218dfb2ab5374b280cff93ae9eeefce3","original_member_sha256":"f6d595631cb9621be67c9ac13fbd053acf174052ca516ce2a9467ec42d9bb9cf","paragraph_ElementTree_utf8_XML_sha256":["e81acc2dc91ffb92b52e6f79662d568aaa8fb905a6296b101e443450ba405caa","fb0d4faa4f5667625c36201c09cb34b964999d4a7c2f968b44db5cd5c842cfdc","0ace2efbbf2cc22a074c237fceb32b5ddb8a156228bad92ca7d1923c65848bea","5c010cb7f8b651b3dd6a6e566a590ebaa8e2d0e128e71381ee953ff4303ddccf","041a0666b20cd41f6c4a8e8d97ae221338f3a95a3b411a66bcc8d9c84fbd6995","401b4ecb30939fefd7f28c94127345197ab1af2ac75d7281760cb0e005773440","f8fefc366531d2a13e88d84bc1670f2a8e319d81c25be63ae46454ded9f12035","760573e2ed35bc48271b8879c13f126d60b525274c39638f6dae448e82a55ee8","f9be24e41f3fefd12cbd48bd5d44a51af1613302c291ca18a03bba1f182c8f75","fb42a4b735037b0e70620b65b079642a16b37ba63716047f56028c9f2ca1d588","5ab3af6b78ad7cf5611a02fb78167bf396dd835d44a2bc344ce2d706152e385f","2e7d061c4ff5fd180afa61b03d1643b372dd3bab8e7b185b251a930e7261d849","e05258bad4152ba6b4a177fec18c3b53e10f1fca3c83fcac69614e2fd929cb63","c55599984e719925956e03f3e034627d43564afef4e7fa8f7e6d3ba8315de5e5","17ce8f421d0263dff