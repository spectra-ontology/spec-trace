fd4046ee1ab1dbb03578e215b23","c4eba447654e4358f5275a98c3ff54c26cf55c0a95c8b85182921c518c6476fd","048dff6401238150b7035eb62119868cb5b5ce13003a80e603f9a8b2d7e8e92e","e7f1e7450366c3a0bdf31608685f83560cff21b8dc9f6b99f585ae16222c3b22","d9217c646e4aa9bf3dd0c9f163e685d601209a636715ddad57f1e6e4b3a12b1f","804c152117dcf6d5a6b86087422b4ef5e61ce5bc5d82e7f6701cd31d8d37f232","9d420229c7a7e2d4190d92688d9e23814649644d1e9cbe2581a4dd01ed344795"],"paragraph_range_zero_based":[25704,25727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p25704"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig field descriptions","paragraph_zero_based":25728},{"literal_text_all_w_t_and_m_t":"fdm-TDM","paragraph_zero_based":25729},{"literal_text_all_w_t_and_m_t":"Configures UE with a repetition scheme among fdmSchemeA, fdmSchemeB and tdmSchemeA as specified in clause 5.1 of TS 38.214 [19]. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release slotBased if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25730},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":25731},{"literal_text_all_w_t_and_m_t":"For slot-based repetition scheme, selected RV sequence is applied to transmission occasions associated to the first TCI state. The RV sequence associated to the second TCI state is determined by a RV offset from that selected RV sequence.","paragraph_zero_based":25732},{"literal_text_all_w_t_and_m_t":"slotBased","paragraph_zero_based":25733},{"literal_text_all_w_t_and_m_t":"Configures UE with slot-based repetition scheme. Network always configures this field when the parameter repetitionNumber is present in IE PDSCH-TimeDomainResourceAllocationList. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release fdm-TDM if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":25734},{"literal_text_all_w_t_and_m_t":"startingSymbolOffsetK","paragraph_zero_based":25735},{"literal_text_all_w_t_and_m_t":"The starting symbol of the second transmission occasion has K symbol offset relative to the last symbol of the first transmission occasion. When UE is configured with tdmSchemeA, the parameter startingSymbolOffsetK is present, otherwise absent.","paragraph_zero_based":25736},{"literal_text_all_w_t_and_m_t":"tciMapping","paragraph_zero_based":25737},{"literal_text_all_w_t_and_m_t":"Enables TCI state mapping method to PDSCH transmission occasions.","paragraph_zero_based":25738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25739},{"literal_text_all_w_t_and_m_t":"–ReportConfigId","paragraph_zero_based":25740},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigId is used to identify a measurement reporting configuration.","paragraph_zero_based":25741},{"literal_text_all_w_t_and_m_t":"ReportConfigId information element","paragraph_zero_based":25742},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25743},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-START","paragraph_zero_based":25744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25745},{"literal_text_all_w_t_and_m_t":"ReportConfigId ::=                          INTEGER (1..maxReportConfigId)","paragraph_zero_based":25746},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25747},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-STOP","paragraph_zero_based":25748},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25750},{"literal_text_all_w_t_and_m_t":"–ReportConfigInterRAT","paragraph_zero_based":25751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4abf2645afdbb5db46a0848b5a8d8f114151a4bb1c0d0573e49af998ae493603","5b5d186a900b126069200d9165443e1b492ee515379e0059b19453a917589c93","b9178a915cabc96c3e123f9d49f6dcf18a2e8cac056298b3ec56bc6887421d6d","8151990d276448ef15