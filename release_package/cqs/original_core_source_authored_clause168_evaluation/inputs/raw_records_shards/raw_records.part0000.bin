"","paragraph_zero_based":2538},{"literal_text_all_w_t_and_m_t":"SL-L2RemoteUE-Config-r17 ::=      SEQUENCE {","paragraph_zero_based":2539},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigRemote-r17          SL-SRAP-Config-r17                                    OPTIONAL,  --Need M","paragraph_zero_based":2540},{"literal_text_all_w_t_and_m_t":"    sl-UEIdentityRemote-r17           RNTI-Value                                            OPTIONAL, -- Cond FirstRRCReconfig","paragraph_zero_based":2541},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":2542},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["1502a3cc660af755d1c517a42f0a3dd83dee4127e3c33502a680afaaf49a9bf4","42d6790ef6da830314650871dea213937dab6bb1930fc3cd1c0792205c16323a","8eba4e04ff6883053baccc2202204cba110704c13e8cecf18e7df952015400eb","de19f174a7bb9182dcc03fbea2da84e3be38fafe0a3487daf9931313bd846c00","bd63fea6848d69b5da7aceecd762c4ac2c7ff715f227806b1e5327b80b2fa497","6671ccde52cec5587636bc1a2b86020a9b0eb2d75427e620be0e21b499e817b2","dfb84e1767f6104499a09f8effa7bd60a76b6dfa40d96cc400f05f054660c4f7","a34fef5a094dcd3e9d77e7fabf8b7ba5a419675f48c2bc3f2092cf7049828ce2","a93f4cd37f8ae277841efcd1c91b8530719db3762c438897c55d4f9e117aeb0d","aa001a6fccd53f866ab00793428a6ce2263aa64058f99a49a41ef3564fe8803b","3aaf37fe9a5d9fe4a87b2ed88b4551501e2fb86beebfd69857826b9843d4e244","6933c21e0f83c5e08ade76ad2be6682324c567698467eb48c3f5900881593b60","6a46f73dbcb686613b2c780274509564edc5acf908a016b1e8e9d56ef5bce56b","6f2c94e306aa04711ce8bf93a3a77b276526be5af5d78ea65e806b551a100027","f31a5e2a9a1c5f25b8199067ca4a5d8e2227326de5706c76d80e11353dc6d1d5","