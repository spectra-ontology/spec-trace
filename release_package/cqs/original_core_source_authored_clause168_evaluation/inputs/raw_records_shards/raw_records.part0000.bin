{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-STOP","paragraph_zero_based":21912},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21914},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS","paragraph_zero_based":21915},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS is used to configure a Reference Signal (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation.","paragraph_zero_based":21916},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS information element","paragraph_zero_based":21917},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21918},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-START","paragraph_zero_based":21919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21920},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS-r17 ::=   SEQUENCE {","paragraph_zero_based":21921},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17          PathlossReferenceRS-Id-r17,","paragraph_zero_based":21922},{"literal_text_all_w_t_and_m_t":"    referenceSignal-r17                 CHOICE {","paragraph_zero_based":21923},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":21924},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                        NZP-CSI-RS-ResourceId","paragraph_zero_based":21925},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21926},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                         OPTIONAL  -- Cond RS-SSB","paragraph_zero_based":21927},{"literal_text_all_w_t_and_m_t":"}","paragraph_z