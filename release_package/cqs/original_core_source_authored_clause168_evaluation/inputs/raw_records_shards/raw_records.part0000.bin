{"fields":{"filename":"R2-2301432.zip::R2-2301432 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PositioningFrequencyLayer-r16 ::= SEQUENCE {","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"dl-PRS-SubcarrierSpacing-r16ENUMERATED {kHz15, kHz30, kHz60, kHz120, ...},","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth-r16INTEGER (1..63),","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB-r16INTEGER (0..2176),","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA-r16ARFCN-ValueNR-r15,","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN-r16ENUMERATED {n2, n4, n6, n12, ...},","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"dl-PRS-CyclicPrefix-r16ENUMERATED {normal, extended, ...},","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-SFN0-Offset-r16 ::= SEQUENCE {","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"sfn-Offset-r16INTEGER (0..1023),","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset-r16INTEGER (0..9),","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"...}","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-AssistanceData field descriptions","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ReferenceInfo","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"This field specifies the IDs of the assistance data reference TRP.","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataList","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS resources for each frequency layer. ","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"nr-SSB-Config","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"This field specifies the SSB configuration of the TRPs.","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8ea2f71f3934a8587b5f7f325441496184ccd7b68d1aa88459300c9d9e56e2b","original_member_sha256":"ce424fd41c1de8e7fe631d2c48a21f828a13a40e8c26645855bf15096b4f8bc5","paragraph_ElementTree_utf8_XML_sha256":["38883276a9a340b676436491554671a62ba94b1a2a0c0985dace7da38f720cf8","e6ed923fb469c23317e42b253e80c1b0342f4ce773dd84e662b5761683a60a24","4eeca7e6d005669ef5cdaf027164badf4e1b7d644d8d31e33b1e63df4e874b32","977d9a226e03c2c439a457356f6ab0061782f4e53da8903c9cef47c1b4e55473","d682a712895e35354500d9ba312d9d8454a4b644772abe0b25db2034e58db371","b0e70cfc22ffddba18a38ae03080a90263350e1d5d510f86691c657df2d1ec96","24a92c52e282452b303fd2ea612ee1d9cadf824a13899d5778e7fc786f65d4d0","093f566477e334e09b0cfc845afa5d48e26af9c514b496ae510d0c7a85ec7ad0","ca0d9447e516f4a373622714b61630be403dc2a5b1a1c6693d5fc92e284c0118","1d85879b61cdc4fe11c8767e6b7a0acf75b19db581315ea023fef976d56f1ee6","1c025b7271d8a55fc9136b051073a8e1cef56390ad815f25caaf97400c18af43","41a32e72a4665d17209f0d77e5147dbf210e1ab8adcf4bf6e53a61f695998f7b","f6eca647163fe4c722fcfb716a6aa36c46ff0350656dfdd91066f1b5082af900","17da24868db69da177056b77a385b5606971bf5eae0d50a7cfc58c4b7f2b7708","0eb55620da08642d458afa39d8a380373b68c8eab36fed67f30a44bab28ee214","82d957af584507ba0f4508db1be1e794061e076e1fb2ff2f1711981a2dfa4c56","01d14bcb902065f2be65245d52a944639dfb93046b61ab168e0aab1bb1c62f0e","04a72e9e0eff80256e9d81ddd62f2843383b015f3a91302dd9101c13e1618924","0ed035291b2c3d7e0994cbad120b726be47516b219b12b5738d0d9d8418e34a7","29963aab40989b025da0c2a9334715a3cf70259aac6b1b44162a5176662d7df1","76e563728e0fe586874f97136c1d58a29a916c36fbc706cd04b43b10b925cca8","31e7a0fd43ce3b57fbb9da0f2c0704042b5b49418903fcf8edaae7e82ba60255","0575a960209110ddd48fdcd8725b8f57f75cd58da5f25a4f23401c0364b6f81b","8d06d03478fb7f0f6543097d6777eeeb8cb598305d28bc2ab0dbe3f9d31a9415"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301432.zip::R2-2301432 Note.docx:p192"}
{"fields":{"filename":"R2-2301432.zip::R2-2301432 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-PositioningFrequencyLayer","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"This field specifies the Positioning Frequency Layer for the nr-DL-PRS-AssistanceDataPerFreq field.","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceDataPerFreq","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resources for the TRPs within the Positioning Frequency Layer.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resource ID to uniquely identify a DL-PRS Resource, and is associated with a single TRP.","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the TRP. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, as defined in TS 38.331 [35]. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID. When the field prs-OnlyTP is included, this field is not included.","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-SFN0-Offset","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"This field specifies the time offset of the SFN#0 slot#0 for the given TRP with respect to SFN#0 slot#0 of the assistance data reference TRP and comprises the following subfields:","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"-sfn-Offset specifies the SFN offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP.","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of the assistance data reference TRP to the beginning of the closest subsequent radio frame #0 of this neighbour TRP.","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"-integerSubframeOffset specifies the frame boundary offset at the TRP antenna location between the assistance data reference TRP and this neighbour TRP counted in full subframes.","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"The offset corresponds to the number of full subframes counted from the beginning of a subframe #0 of the assistance data reference TRP to the beginning of the closest subsequent subframe #0 of this neighbour TRP.","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"NOTE:The location server should set the value in accordance with the defined search window for the target device using nr-DL-PRS-ExpectedRSTD and nr-DL-PRS-ExpectedRSTD-Uncertainty.","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"This field indicates the RSTD value that the target device is expected to measure between this TRP and the assistance data reference TRP. The nr-DL-PRS-ExpectedRSTD field takes into account the expected propagation time difference as well as transmit time difference of PRS positioning occasions between the two TRPs. The resolution is 4Ts, with Ts=1/(15000*2048) seconds.","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedRSTD-Uncertainty","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty in nr-DL-PRS-ExpectedRSTD value. The uncertainty is related to the location server′s apriori estimate of the target device location. The nr-DL-PRS-ExpectedRSTD and nr-DL-PRS-ExpectedRSTD-Uncertainty together define the search window for the target device.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8ea2f71f3934a8587b5f7f325441496184ccd7b68d1aa88459300c9d9e56e2b","original_member_sha256":"ce424fd41c1de8e7fe631d2c48a21f828a13a40e8c26645855bf15096b4f8bc5","paragraph_ElementTree_utf8_XML_sha256":["d00713183f123c12c7235113677a575fae358ddff290dadf720619b904c1991a","c91c8dfd98b4781f6fb5f78c39eff96f4a8d1a566df6410e2dfe1b30ff101fd0","b63134fde829fd3808c827438024c022822f85996a96c3c87808f2f1fcff810a","f5d5368980752e229b54f802e11a8e2f60341e39c942b7b42a4f31c8d71ed876","c9c3dcf12d27268ddf94c21e88183504a316f27032034ceee2993e02f7cb516f","1687b77e4553ff726912fc2f061874c712209bfcdace6815ed52d38c64c69589","54d900b71bc042e472bca9f9621ebd83cf3ce3efd960d0fa641e4a68bdf2bd1d","070df3fea6b16e77b147c8430725732f8847df0b808237f5a6d105840612163e","5795b050815c249ec97f7ef334336a6b3a34208d205c79128473461536e98e00","f0dc6472397fd9242949af0b4c86d8767062a707b82b287ddaee485f2a6edcf8","e1e35d3cb91800af7181b0ee25cf9f8579cf2f03a631cd9af199a901b794ed57","b3e73669e7b43be99f9435ab64ea4e3d7cda3314833b420ec1d02763a77c882e","2d96c9a9145ccad5fd7fb1b96f7832461f49f38e8669bb4c663ff06d78150b2b","e5282d34ea6ade0e9bd3c9043d2530c388d755c5268ccc807e987e139fbf982c","66eb68f6d4e45ec4f2ed92e30ecbb430c0e7e1d799a59a2c6674f3d3f2027b3a","0ed4c591374ac86d922a65693819cccc8bf29cea10a821f4623e407172c6db87","61d253366afe422c06c72f440cf3e1c9fe5244863de42155777a3a6aca35b1d3","c5c1c75c8e2d13f2228df2156751bca7f9a60751ac275c53714c68c0a266695a","29ff1bf0d312a495813481ac3b9b36304c85805d22ee19840e715eca542fbed5","fe59526cf8b1c6d834612194127b98a17b2be2f2a513c9552820bd1ecb2db46b","b9175ba159fdc82c317eba9dfcd789d1a42652474bddc339ce36f8a75509f048","111f59a30e862d5d42cf18fe90910d0cd77b3487c3121a49e40d25015016cc09","8b5dfab73dd97879f8e88d331173f16e6e3892f5a67087b5caf73682a62a242a","de0c42e114c689b3a036784acaaba3be93f61caaeec8e378066780659877e2e7"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301432.zip::R2-2301432 Note.docx:p216"}
{"fields":{"filename":"R2-2301432.zip::R2-2301432 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The resolution R is","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"-Ts if all PRS resources are in frequency range 2,","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"-4Ts otherwise,","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"with Ts=1/(15000*2048) seconds.","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"The target device may assume that the beginning of the subframe for the PRS of this TRP is received within the search window of size","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"-[-nr-DL-PRS-ExpectedRSTD-UncertaintyR ; nr-DL-PRS-ExpectedRSTD-UncertaintyR] centred at TREF+1 millisecondN+nr-DL-PRS-ExpectedRSTD4Ts,","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"where TREF is the reception time of the beginning of the subframe for the PRS of the assistance data reference TRP at the target device antenna connector, and N can be calculated based on","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"-nr-DL-PRS-SFN0-Offset","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"-dl-PRS-Periodicity-and-ResourceSetSlotOffset","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ResourceSlotOffset.","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-Info","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS configuration of the TRP.","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"dl-PRS-SubcarrierSpacing","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"This field specifies the subcarrier spacing of the DL-PRS Resource. 15, 30, 60 kHz for FR1; 60, 120 kHz for FR2. All DL-PRS Resources and DL-PRS Resource Sets in the same Positioning Frequency layer have the same value of dl-PRS-SubcarrierSpacing.","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs. All DL-PRS Resources of the DL-PRS Resource Set have the same bandwidth. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of DL-PRS Bandwidth and Start PRB.","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to reference DL-PRS Point A for the Positioning Frequency Layer. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-StartPRB.","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"dl-PRS-PointA","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"This field specifies the absolute frequency of the reference resource block for the DL-PRS. Its lowest subcarrier is also known as DL-PRS Point A. A single DL-PRS Point A for DL-PRS Resource allocation is provided per Positioning Frequency Layer. All DL-PRS Resources belonging to the same DL-PRS Resource Set have the same DL-PRS Point A.","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"dl-PRS-CombSizeN","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"This field specifies the Resource Element spacing in each symbol of the DL-PRS Resource. All DL-PRS Resource Sets belonging to the same Positioning Frequency Layer have the same value of comb size N.","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"dl-PRS-CyclicPrefix","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8ea2f71f3934a8587b5f7f325441496184ccd7b68d1aa88459300c9d9e56e2b","original_member_sha256":"ce424fd41c1de8e7fe631d2c48a21f828a13a40e8c26645855bf15096b4f8bc5","paragraph_ElementTree_utf8_XML_sha256":["8e518c90c87e31b08bf797be62264000a81561a922b3845d2be6ee7e1d88536e","b5c5e5b9605b7236905c8b57da0e1cf2ae81f61f0c6f15c5c06898c5b2b72fa0","e1197150525a304b694bdb22b5254e7127ad51c1ebe5f5190e697c84e2cfba6f","6ebd0b0ba31f4217df6a41576e24886dcf58a2b614f713b6de4fc2e3921ef71d","748a58a557a857996f5440ba813a76334543ecc9efb57f1344fdbb0fbd33c0d3","387c3bd0762ad1be821d5dfe313fee105011e9e011cba30144d133f86d88131b","39b33bcc9e632ff238125626a87de37b0354ba9ed96d765c6fafe0e438d48c74","ea6f02e0bcae0edd53ade280e85d97b8e2ae9cca2103ce0fc554eb138609a9b4","da86812178aeeac86bd093ca5178d4bf1f562f898f0a7c7c665bb3e5830203d5","e6f78ebe6b8faa331b8066daa94a016a7b0e50f16af134f08a6aea8e25dc300b","906e45dc90a5f78024a44b8585a2c7d1fa598bcf5aa48fafc2113deaf8d5b407","89f6bd0311a3b256cf0252213d792f0e27dfe3628112e814bc87f15a48d255ba","3e5f109ea79ed4c84933a3ecdd70d65d9768aa484c3820c200829881ae8ab02f","242c95b7549b70c7bc6b68fc50067f0701216908924792ea8807fb7bc0e6a9cd","1ea269b500e50ba9424a316c14d0d794ae7022df856a57603df03fbd31e61d0a","bb21b21a59b0e714e4084d475e6b00b1c171c0a4591c8a72ea9b05d619830b2b","4718f1015b896d99b234cffd3b6997bfd6bbe2b4ac6c87a59b7cef52ea741f12","98955bd64d334e1c5aa9e6f59d73586f8f90f0d6cec35445204f347fc6bee4be","0879825629a2115fb5b6961244d61aa48e66b0b9ce86fba68a374dfccfa0640f","50a153d3e9e24d093b7fde5a02b71da1a30c9183e84121e4718748f3fd388aff","0cd1610080fbcef4f358ea29391e4e25f4f402ad64a6815032cc42e349832c43","d8dd238596735bff9b8aaefaece3ec605bdcf1d5ee67894218a0296a8d76cf02","988af8c0c64cdf797066a6f2a0f33bc813e4e4165a2bb46d521179b907c70028","636e45d1e36d2bbd6be2d0c698272c30811c172572638e4d57f57e8174a2281d"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301432.zip::R2-2301432 Note.docx:p240"}
{"fields":{"filename":"R2-2301432.zip::R2-2301432 Note.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the Cyclic Prefix length of the DL-PRS Resource. All DL-PRS Resources Sets belonging to the same Positioning Frequency Layer have the same value of dl-PRS-CyclicPrefix.","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"prs-OnlyTP","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the NR-DL-PRS-AssistanceData is provided for a PRS-only TP. Whether the field is present or absent should be the same for all the NR-DL-PRS-AssistanceData of all the PRS transmitted under the same TP.","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"The target device shall not assume that any other signals or physical channels are present for the TRP other than DL-PRS.","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":269}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"d8ea2f71f3934a8587b5f7f325441496184ccd7b68d1aa88459300c9d9e56e2b","original_member_sha256":"ce424fd41c1de8e7fe631d2c48a21f828a13a40e8c26645855bf15096b4f8bc5","paragraph_ElementTree_utf8_XML_sha256":["2fe0eefbfb484a2a1e116ebf46ae67f5412b98368816227defa07f93d66ce289","129d34665a9962b0d107ada4f7c9b4267d9247fd8588723c8d1ad66f387eebd1","8b4c1a7b0992fba6eb366d57bc646610775d01e5d5381711d748e8787e582a50","9349de97546760082193446ea6b3ea96a999f5fd8b8ac0ed3ca1f7f965c6a1be","d694d4e592f1cbcecc852754ed6b5926340305f26721b598a0d37d7e718d47e5","e27f0b5ed28321c42ffca1e99db1192e801b571fba52b1ad6a8916da36d5bbe6"],"paragraph_range_zero_based":[264,269],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301432.zip::R2-2301432 Note.docx:p264"}
