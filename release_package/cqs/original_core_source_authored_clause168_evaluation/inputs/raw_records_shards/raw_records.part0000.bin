{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2592},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2593},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2594},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2595},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2596},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2597},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2598},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Address is included:","paragraph_zero_based":2599},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2600},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2601},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2602},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2603},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2604},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2605},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2606},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2607},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Prefix is included in iab-IP-AddressToAddModList:","paragraph_zero_based":2608},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2609},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2610},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2611},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2612},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2613},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2614},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ebcc7c228f89a301c07e0b2b1b683bce94df6fbb20a3337bcd8ca0f9cdf89377","10ab50fef8304011708985012586921179c0073ee5788f8b3533c4e5bde85f13","6ab2eee9523dda1b896efb7e34f1e9e1de9581707273e8da4c70545972f0c8d5","be7e1774325cfcc2e12bbeaa9b9b72d9a90fa3bb762a3eb807357ca5bc5cda06","ccf4fdb76ddce9752872362defb4bcedcd815c814fd64fb6e9fa58754b9561f1","aff81f9032c8b9a95afb24da0c70a43edb56fefc5055671f9e7ee7a5e8b8b51b","185eb8a863b184d4bcce3758d694f9de8398930edc38f34c975c8aceff90ec4d","57741cae3b1fa97faa112bf4ba4e7194fa54293b496419ae46912bd7cb3810a4","b40cc6350087b012d3545c1a090989b6e601372d311c8054f47fa126d0b13500","d06144df0d5c9b554762a0e7fc9dd63c846c6496a1ddf19e61a69c7a180e26b4","d7fc07e3ce1931ad29ebb1bf9265fa4ac60c2603e225235a02a9a5302cd1ca75","609f75365791869f1394ca7675f4215758926c7e569fe13f6ad4e0e2e5c61d26","837dfc323ce025b54f1d01775315b88aaa59d5fc7eac2bdea2e916267b28b466","f6b277734095c9c2325c6e8c9f0516537d9079ee2a4cb0f9b9841cd63c0a0012","50442290d959e488e196b331f1fef5a9b0d657a6bf700f725dc2783edff62097","9bc66d57592891882cb9c7790ca52f19fe923e36a44128179e948284d1a88bab","a62c204c31c29a768f8b280cda9e60e7c1de92b67181cfac607e9a46cc74c75f","aff5cfbe575ebad9ee9365c78c7328b2a62db51a2d2b2bf770643218e8c08199","adb2c963fd98617a2e0e7214e9749f214b9777a52108c7ca04919d556156cf64","4e1b21e1cdb88d584bd00f5c5092b1840e9bde189cbcd54ef0665d2eac720dd0","bb92acc715ff716d44c3696aaedadbb45fc93746eb7d68b672ec79f3f6d63145","d13f9ba833f183565c6dba37257466d215ba8dbcdcf090186af6abe28ffd405e","9b286a9c25b7cf073f668661657fdeab133cb761d67acb9316994c7f5f3d054d","31816ec5feb07789a0c448c15a9c057151435f68f967a990ace92e3fcbffce8e"],"paragraph_range_zero_based":[2592,2615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2592"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2616},{"literal_text_all_w_t_and_m_t":"1>for each iab-IP-AddressIndex value included in the iab-IP-AddressToAddModList that is part of the current IAB-MT configuration:","paragraph_zero_based":2617},{"literal_text_all_w_t_and_m_t":"2>modify the IP address configuration(s) in accordance with the IAB-IP-AddressConfiguration corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2618},{"literal_text_all_w_t_and_m_t":"5.3.5.13Conditional Reconfiguration","paragraph_zero_based":2619},{"literal_text_all_w_t_and_m_t":"5.3.5.13.1General","paragraph_zero_based":2620},{"literal_text_all_w_t_and_m_t":"The network configures the UE with one or more candidate target SpCells in the conditional reconfiguration. The UE evaluates the condition of each configured candidate target SpCell. The UE applies the conditional reconfiguration associated with one of the target SpCells which fulfils associated execution condition. The network provides the configuration parameters for the target SpCell in the condRRCReconfig.","paragraph_zero_based":2621},{"literal_text_all_w_t_and_m_t":"In NR-DC, the UE may receive two independent conditionalReconfiguration:","paragraph_zero_based":2622},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration associated with MCG, that is included in the RRCReconfiguration message received via SRB1; and","paragraph_zero_based":2623},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration, associated with SCG, that is included in the RRCReconfiguration message received via SRB3, or, alternatively, included within a RRCReconfiguration message embedded in a RRCReconfiguration message received via SRB1.","paragraph_zero_based":2624},{"literal_text_all_w_t_and_m_t":"In this case:","paragraph_zero_based":2625},{"literal_text_all_w_t_and_m_t":"-the UE maintains two independent VarConditionalReconfig, one associated with each conditionalReconfiguration;","paragraph_zero_based":2626},{"literal_text_all_w_t_and_m_t":"-the UE independently performs all the procedures in clause 5.3.5.13 for each conditionalReconfiguration and the associated VarConditionalReconfig, unless explicitly stated otherwise;","paragraph_zero_based":2627},{"literal_text_all_w_t_and_m_t":"-the UE performs the procedures in clause 5.5 for the VarConditionalReconfig associated with the same cell group like the measConfig.","paragraph_zero_based":2628},{"literal_text_all_w_t_and_m_t":"In EN-DC, the VarConditionalReconfig is associated with the SCG.","paragraph_zero_based":2629},{"literal_text_all_w_t_and_m_t":"In NE-DC and when no SCG is configured, the VarConditionalReconfig is associated with the MCG.","paragraph_zero_based":2630},{"literal_text_all_w_t_and_m_t":"The UE performs the following actions based on a received ConditionalReconfiguration IE:","paragraph_zero_based":2631},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToRemoveList:","paragraph_zero_based":2632},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration removal procedure as specified in 5.3.5.13.2;","paragraph_zero_based":2633},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToAddModList:","paragraph_zero_based":2634},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration addition/modification as specified in 5.3.5.13.3;","paragraph_zero_based":2635},{"literal_text_all_w_t_and_m_t":"5.3.5.13.2Conditional reconfiguration removal","paragraph_zero_based":2636},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2637},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId value included in the condReconfigToRemoveList that is part of the current UE conditional reconfiguration in VarConditionalReconfig:","paragraph_zero_based":2638},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching condReconfigId from the VarConditionalReconfig;","paragraph_zero_based":2639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b2c05d25af69f6cdc4bd6634347599da8b54a9f61bbaaa24022c3b4a95b94f54","4c9074a0c3b09a7f011e77618d8fe23e94ae7c19a43e46dc3629c1dfb815d6ca","0256156e2080976da71da558440f6accef4c3050b2e32b1fac7cb3f65b924d1a","8e116a370aaa6463a2a8bae1e630382f39c50bb0e0f9c98b1f6093e6e7c26735","105950953c1fda587dd3aea4f352e474e4fba6271558100dae178f468ee62632","25dae23718f2590b033c3768f3f73333575b4264269c7cbc97a8de18c1f098b9","273f0f5db325bf8f6db9156ff57992a8dde1993b2af0bae0e76cef12ddcb8f74","98a429a623d1f8fac978a8182f795f3265853855a51d2920b4be22edfc39555f","697cd1f3457f2b90bf1fd6c023dcbfb14b712c871673983e77d5fb99384dbd2e","d8fafbfeadbbeaefa8fa3f53ce8d25eb5be34c37939a4c3fcc210f24ddae30ff","6abd99f7cd5ae27db16d58413d19d2d7eaab6e152446da3dbb1d5982aaec87aa","fa051786b5b7e35839c685ccd357db786755861c045102bd891e4040e5a7b2a5","55111cbb619753059839923312c2584080deda2aefa7d61b7d1eedbac5137a25","5e45dd0843cf51eeca8cd2fae73def1bfd116113d925422fc0b0173065d569dc","e656c0d7b0695022f4e10cd7a7a75333cffdb2b5bd075a873d6aa51c33b3b3c4","4b28f1f05fe9696ef7d7e542cf7aa36f6ca52a11f3b30aa76e5cca9e8bea699b","64e2ff680bbad70255be557a47a55bb79af9b94276a0457fa4d46fe0cbe1a9b2","6e44d355490a66344b0342dbb6254c49eb938a73344b7875335664bce9f392ef","7cf5cb40544e0aa7957998f271f6b74cc0be320a7ae3644f75c51df62b03a52b","af292628b5f632fd6f43287aa259777be89d2f495fc5fcff825988fe3009fdcd","307743a1315f5dc79b80c22502988573ca865140b437cd0d5342755659195796","967bdb2547918ce7e25d8ac3e102c122cb51b81e92265d96d898ce47d1afe589","6cd86a7abaa3657e093dce915f57e575702349004b4be3fa34cc4ebf9612dc95","d4d3bd1e6cd0e237095ccbba2e7736b8fd2885ca63bd52b905c56e16871b2b4b"],"paragraph_range_zero_based":[2616,2639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2616"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the condReconfigToRemoveList includes any condReconfigId value that is not part of the current UE configuration.","paragraph_zero_based":2640},{"literal_text_all_w_t_and_m_t":"5.3.5.13.3Conditional reconfiguration addition/modification","paragraph_zero_based":2641},{"literal_text_all_w_t_and_m_t":"For each condReconfigId received in the condReconfigToAddModList IE the UE shall:","paragraph_zero_based":2642},{"literal_text_all_w_t_and_m_t":"1>if an entry with the matching condReconfigId exists in the condReconfigToAddModList within the VarConditionalReconfig:","paragraph_zero_based":2643},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condExecutionCond or condExecutionCondSCG;","paragraph_zero_based":2644},{"literal_text_all_w_t_and_m_t":"3>replace condExecutionCond or condExecutionCondSCG within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2645},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condRRCReconfig;","paragraph_zero_based":2646},{"literal_text_all_w_t_and_m_t":"3>replace condRRCReconfig within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2647},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2648},{"literal_text_all_w_t_and_m_t":"2>add a new entry for this condReconfigId within the VarConditionalReconfig;","paragraph_zero_based":2649},{"literal_text_all_w_t_and_m_t":"1>perform conditional reconfiguration evaluation as specified in 5.3.5.13.4;","paragraph_zero_based":2650},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4Conditional reconfiguration evaluation","paragraph_zero_based":2651},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2652},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId within the VarConditionalReconfig:","paragraph_zero_based":2653},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration within condRRCReconfig includes the masterCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2654},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the masterCellGroup in the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2655},{"literal_text_all_w_t_and_m_t":"2>else if the RRCReconfiguration within condRRCReconfig includes the secondaryCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2656},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the secondaryCellGroup within the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2657},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCondSCG is configured:","paragraph_zero_based":2658},{"literal_text_all_w_t_and_m_t":"3>in the remainder of the procedure, consider each measId indicated in the condExecutionCondSCG as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2659},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCond is configured:","paragraph_zero_based":2660},{"literal_text_all_w_t_and_m_t":"3>if it is configured via SRB3 or configured within nr-SCG or within nr-SecondaryCellGroupConfig (specified in TS 36.331[10]) via SRB1:","paragraph_zero_based":2661},{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2662},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c6acdfebd88798283a7bf42bcb3cc080bfc778da30b1617fca4b4c1f692e9bf3","0838351ccba8bdd5075e6992ec27528541a5d84171a2a70d68e4116923bbc996","f0411e5d3e5f72e8b3970f3e22448406f810148ed26b38422bfc00e838da047d","c7835b31145b78b6ed9cee5c2fa6170c149fcb616f3bfc29a421924166d45947","4e01e73c587a32292c14d6b51c97dc80a1d4666303bf1796d66c9b41e9e313f9","c9781a9d2781ca8d073a61603b9faa2004c60dff568f7e1d515c8529f6acff0c","d7267f91f4f3438353ec8a48587df0168c335c554230ab8af7c784ae37b7be33","aeba9cc6d1b4480afb0f5ebb07d425ab1b3b2d3b59fa2f1e090d02fd1021d814","7d9e245d825b2967e4257a1fc275d27d6cfb4f28c440a988374c909ab338e96e","cb8797c1975d82a05f8b63b0794fffb71cfde38acc87b0f9af47a62b215bc1a0","5799185bbe1feff62ba322c86827c145a0b8d9a7968531d8d2438c28e362769a","3795fede4509cde197b3c490b35e9dbcb44e4bdd47fb916b645937fe50ac2ab0","95d2897cd4931b0a8d8abf90960512b00d774f6f2ac923b8cc41d1411d3deaf5","85678075d8f6afed7b313c81fcf3174401db71abcdfcd98874855faa76657e09","fc6a52b3cfee0608ddf7348cac0d62ac91cf6fa46e3ae001d17116bd946caedd","376eaacbc717608782c305c986d300278a41a8d3f340f61f2b056e77357a705a","f035de9a3428307c321fa575aff7e8620d398862f18226621250f58ec2bbc0ba","ba610561030f0fc7da9c7de18bf27ed0c81a0c6a2e13705d2242e178db1dceb8","e5f2a20474f0f8229a8e99ebc03bc06b06260aa037585c25d7ad0b8fc426cb82","8db0cc11cd863dc0e5f2a6bb4c0c8174828618bd734ab28a582ea0e0e213fead","9dace63f1bb3133192ab740a588a7eb3f18c96e885ad664c9cd0afd1013af917","d459a4dca4b48ace90facc74a5d591e98889100a71c90868533df4d5f6136742","28c72d228838a9f9c3e657c8ff05d8b6978b2b88a62075ff423e38c45e89e1fd","381c2044024e2da01309f5ee6e273f98fcc4b22684696eb1c0f2bc16af89094e"],"paragraph_range_zero_based":[2640,2663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2640"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the MCG measConfig;","paragraph_zero_based":2664},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the condExecutionCond or condExecutionCondSCG associated to condReconfigId:","paragraph_zero_based":2665},{"literal_text_all_w_t_and_m_t":"3>if the condTriggerConfig is not configured with nesEvent:","paragraph_zero_based":2666},{"literal_text_all_w_t_and_m_t":"4>if the condEventId is associated with condEventT1, and if the entry condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2667},{"literal_text_all_w_t_and_m_t":"4> if the condEventId is associated with condEventD1, and if the entry conditions applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2668},{"literal_text_all_w_t_and_m_t":"4>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the entry condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2669},{"literal_text_all_w_t_and_m_t":"5>consider the event associated to that measId to be fulfilled;","paragraph_zero_based":2670},{"literal_text_all_w_t_and_m_t":"4>if the measId for this event associated with the condReconfigId has been modified; or","paragraph_zero_based":2671},{"literal_text_all_w_t_and_m_t":"4>if the condEventId is associated with condEventT1, and if the leaving condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2672},{"literal_text_all_w_t_and_m_t":"4> if the condEventId is associated with condEventD1, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2673},{"literal_text_all_w_t_and_m_t":"4>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2674},{"literal_text_all_w_t_and_m_t":"5>consider the event associated to that measId to be not fulfilled;","paragraph_zero_based":2675},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2676},{"literal_text_all_w_t_and_m_t":"4>if indication concerning NES-specific CHO execution condition is received from lower layers, indicating that the NES-specific CHO execution condition is enabled; and","paragraph_zero_based":2677},{"literal_text_all_w_t_and_m_t":"4>if the entry condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2678},{"literal_text_all_w_t_and_m_t":"5>consider the event associated to that measId to be fulfilled;","paragraph_zero_based":2679},{"literal_text_all_w_t_and_m_t":"4>if the measId for this event associated with the condReconfigId has been modified; or","paragraph_zero_based":2680},{"literal_text_all_w_t_and_m_t":"4>if indication concerning NES-specific CHO execution condition is received from lower layers, indicating that the NES-specific CHO execution condition is disabled; or","paragraph_zero_based":2681},{"literal_text_all_w_t_and_m_t":"4>if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2682},{"literal_text_all_w_t_and_m_t":"5>consider the event associated to that measId to be not fulfilled;","paragraph_zero_based":2683},{"literal_text_all_w_t_and_m_t":"2>if event(s) associated to all measId(s) within condTriggerConfig for the applicable cell are fulfilled, and none of the event(s) is configured with nesEvent:","paragraph_zero_based":2684},{"literal_text_all_w_t_and_m_t":"3>consider the applicable cell, associated to that condReconfigId, as a triggered cell;","paragraph_zero_based":2685},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in 5.3.5.13.5;","paragraph_zero_based":2686},{"literal_text_all_w_t_and_m_t":"2>if event(s) associated to all measId(s) within condTriggerConfig for a target candidate cell within the stored condRRCReconfig are configured with nesEvent and fulfilled:","paragraph_zero_based":2687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7b9da37f8bb7f2346d50274379629a800bf17a18e1413abff2d4cba2bb24d659","4a7f7ea303393703c079e5683ce2a084177861b19e0df20404c45df6f0258f1a","a6739541e391f1f5a1131a46308b93907f693ed7eaf135d3cf6dd4a920bf68cd","17dfe6e137b7ce3861a4676cbd54da679adf8f00027fa4103aa50eed4b418bf6","adb0dd43cec380fa04fe061207f8c2fda80900830d1cf1b108f6314c3ce31c85","b6e690ddc77dc5d76c3125398eab50beec80db540d79a5b836f1be57470e8cfe","fe83c88cbdf060962db916d812518ae95e0a29b6a33adb7ccd5d677504adcbb8","b39f8681b9a2e2bfe6668379a760d37ecedaab20009653c991923c658725b3c3","4a348a9767b875b289d4ddb96e98616930d9dae4a416005c95559f593a39e7e9","5b9c3807f6c4e8a04d76104f2e462a357f85ef009c63dd18f4850c549ffc40fc","7d07df586bad8af69a4c21263ba20876eb28c788ca8032900d8133c615928e86","a7f7e4b9aaa7270abc0aa40de7abffbf22a65e9ab172a6a5ae6fd25e1586da4f","1990e0947c839c6bf27c0223ca4a738f2b3ee5904772babfd30e2965b2b2749b","3209e12a0cfd0ec36d097dfe10d7a32c81c6d9003d2fd6340df000587250eadd","7973046cca413db4b5d94d887ef529d68d30b1a71f253fecd7912ec7b4e2786c","7c5e18d2e0366c15a613d6c5141f8e32aef4216b3cf1c91f6625e80e4919c21c","df1a8faea1e4b600b0278f3839631f2afed4eb0e158a6cb64f4438f4ac8bb10e","7c4398319e858a1d1a5962ca715ba02583059587115ef5d4b618f871729b1c79","3928d59c41da9f5ad8f42ff8d8871873b5a98f36fab31006008ff083ffaf8cd8","eed333fcdb1a1a89b96e5e92ba78b1e8db018691fa84665d9d55062db5a335f2","f261a8c40e7598d21309d401ceed2fcae936d4e7c3b60d357e8aced9ebf668c2","3369b623ad4b1c31471f4c0129e09dd5c946fc55c8c255fcf74e18e08ea6bb9d","5027a619faed236ceafd1b6a03c4f2d22ea27784239ff8bb2371587aa639cc70","d2bf5a2b33e9f72f23b262835613c08e86831fa5f19988fb02a85d3bb91d3b30"],"paragraph_range_zero_based":[2664,2687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2664"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider the target candidate cell within the stored condRRCReconfig, associated to that condReconfigId, as a triggered cell;","paragraph_zero_based":2688},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in 5.3.5.13.5;","paragraph_zero_based":2689},{"literal_text_all_w_t_and_m_t":"2>if one of the events associated to the measIds within condTriggerConfig for a target candidate cell within the stored condRRCReconfig is not configured with nesEvent and fulfilled, and the other event associated to the measIds within condTriggerConfig for a target candidate cell within the stored condRRCReconfig is configured with nesEvent:","paragraph_zero_based":2690},{"literal_text_all_w_t_and_m_t":"3>consider the target candidate cell within the stored condRRCReconfig, associated to that condReconfigId, as a triggered cell;","paragraph_zero_based":2691},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in 5.3.5.13.5;","paragraph_zero_based":2692},{"literal_text_all_w_t_and_m_t":"NOTE 1:Up to 2 MeasId can be configured for each condReconfigId. The conditional reconfiguration event of the 2 MeasId may have the same or different event conditions, triggering quantity, time to trigger, and triggering threshold.","paragraph_zero_based":2693},{"literal_text_all_w_t_and_m_t":"NOTE 2:Void.","paragraph_zero_based":2694},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4aConditional reconfiguration evaluation of SN initiated inter-SN CPC for EN-DC","paragraph_zero_based":2695},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2696},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigurationId within the VarConditionalReconfiguration specified in TS 36.331[10]:","paragraph_zero_based":2697},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN associated to the condReconfigurationId as specified in TS 36.331[10]:","paragraph_zero_based":2698},{"literal_text_all_w_t_and_m_t":"3>if the entry condition(s) applicable for the event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2699},{"literal_text_all_w_t_and_m_t":"4>consider this event to be fulfilled;","paragraph_zero_based":2700},{"literal_text_all_w_t_and_m_t":"3>if the measId for this event has been modified; or","paragraph_zero_based":2701},{"literal_text_all_w_t_and_m_t":"3>if the leaving condition(s) applicable for this event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2702},{"literal_text_all_w_t_and_m_t":"4>consider this event associated to that measId to be not fulfilled;","paragraph_zero_based":2703},{"literal_text_all_w_t_and_m_t":"2>if trigger conditions for all events associated with the measId(s) indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN as specified in TS 36.331[10]), are fulfilled:","paragraph_zero_based":2704},{"literal_text_all_w_t_and_m_t":"3>consider the target cell candidate within the RRCReconfiguration message contained in nr-SecondaryCellGroupConfig in the RRCConnectionReconfiguration message, as specified in TS 36.331[10], contained in the stored condReconfigurationToApply, associated to that condReconfigurationId as specified in TS 36.331[10]), clause 5.3.5.9.4, as a triggered cell;","paragraph_zero_based":2705},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in TS 36.331[10]), clause 5.3.5.9.5;","paragraph_zero_based":2706},{"literal_text_all_w_t_and_m_t":"NOTE:Void.","paragraph_zero_based":2707},{"literal_text_all_w_t_and_m_t":"5.3.5.13.5Conditional reconfiguration execution","paragraph_zero_based":2708},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2709},{"literal_text_all_w_t_and_m_t":"1>if more than one triggered cell exists:","paragraph_zero_based":2710},{"literal_text_all_w_t_and_m_t":"2>select one of the triggered cells as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4779b79ba1c7168ce0241a3703b3828ec4ab1d93d43bdec32bca095d04fbb313","589086155fa1ac3979155e1dfe867d42e693ac44dffa534ffcc81a3336b7c5cc","b9882672843f193aa250ef04430b81730465e2f3ea566e989fd5beefbc01ab1c","5ae03121ccc88f6246fba74f2d534de5f66dfa35a2da6810bd94298eea8547e8","d812a8634ca5464ee102b259a4888bda16e70862a15d03281f95472b6d0ce67c","1f0374f9da42d7111a97f6be57c6e9ffe6afb654df1cfe16230ffb8015466adc","277a2f8ebe7d077a8aea02c1b7a73087bd1e40b4b99829612478c52689c35110","d04b71d7f7f964d9480708026f76c4520a80610b0543d03dfe04ec0d919093ab","556346ddc04a7ad91f686a5364e593b7a492ba326840f1ab7f51d6999407d194","39b3f6b13385382a8009b3e2f303554dca821c68247e1b91ab788b6966bba1cd","a06e5cf01ca588e215629cda63561d9b1811396fa70dc1aed37520b0dbb11b6a","b12d59f47657237a7c81e74a19eef798a044f862cb39afcb2f67af4792ba1d2c","5b03631901558e0bafb8802861ae7e0994c3df3cfc164c231eeb31eb6a969a7f","1642a1092c878fc0fc4c7dd1c14368175f46f312b21c13ac56064edade711639","d9a37f64f54b8e7c9092f5922ea2ce015ff26f3d2fb3efd108e992ffaf3e94af","4dcd3a5039168426746560a860edccd7c5aad26375f353b999989c1b9d261ae6","c0e976f61a8a5d9f986a4fed7c98b2edfe4e8f5c0fad6276a3621d2ba4f246e9","54a2e87faea7004a0cfc6dce5ff909e41a137f2101131fbdce0097313612810f","468019b3a44296cdd3006d6f12aaf439f8d81720207143fe0ca873a6fbc4b131","c2eddbe22b925e0818426aede174527c75946c56ac4026ad5b051e7960f4e785","7df2752d5057867607a59d151e6c027acddb9bcf34a69c533e98d10db1b88bc1","b07220f8934ca3a54180e80a9a35a53652beb9d2a5a57196fd0f9b93183f8391","166d5994c50f4cf7558e8907d8c6327159fcf6e13dfd3f216c46753bfcee2ea1","dee4dc421c6c29e89d02e2307ce27a8b771a915bb9c6e5094f90aa05f2bd0a0a"],"paragraph_range_zero_based":[2688,2711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2688"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"2>consider the triggered cell as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"1>for the selected cell of conditional reconfiguration execution:","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"2>apply the stored condRRCReconfig of the selected cell and perform the actions as specified in 5.3.5.3;","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"NOTE:If multiple NR cells are triggered in conditional reconfiguration execution, it is up to UE implementation which one to select, e.g. the UE considers beams and beam quality to select one of the triggered cells for execution.","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"5.3.5.13aSCG activation","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"1>if the UE is configured with an SCG after receiving the message for which this procedure is initiated:","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"2>if the UE was configured with a deactivated SCG before receiving the message for which this procedure is initiated:","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"3>consider the SCG to be activated;","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"3>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers that the SCG is activated.","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"5.3.5.13bSCG deactivation","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"1>consider the SCG to be deactivated;","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"1>indicate to lower layers that the SCG is deactivated;","paragraph_zero_based":2728},{"literal_text_all_w_t_and_m_t":"1>if bfd-and-RLM is configured to true:","paragraph_zero_based":2729},{"literal_text_all_w_t_and_m_t":"2>perform radio link monitoring on the SCG;","paragraph_zero_based":2730},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to perform beam failure detection on the PSCell;","paragraph_zero_based":2731},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2732},{"literal_text_all_w_t_and_m_t":"2>stop radio link monitoring on the SCG;","paragraph_zero_based":2733},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to stop beam failure detection on the PSCell;","paragraph_zero_based":2734},{"literal_text_all_w_t_and_m_t":"2>stop timer T310 for this cell group, if running;","paragraph_zero_based":2735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["5f15179601ec7b45685d0e1569ff2e548e2a84f72355779c70dc1ae023c9e43c","1deb92fe37231ddbc821c7f2e09376f593526e33b42ae78d3f50eb416110a0a1","4c5715f6a998520d2dd6b2eec78ecce85848c1e55613ca26874c7bef57ac0687","b3a89b3b36c9a8200cfa408621b7800453f15b56225b8088bc1fce43f61a244e","0220e9c70b0f7a1d8ba776ab934c1f538052e350257893ad49791fccfb7d517b","9fa8cd4e7b23e15b77b6de3cc9ce530fc2e5060c9da0c2f92d00587a5c44d889","71af504681406e5551a7a69766d83a3f8860027d78a426998ad04b44aeb6e884","d35f34d27e722e228c2df77fd9cf9398c75f41861578cffaed2ca067838f1031","de95114012fc58597523f406b73fa8bed4ebe7019e9c5dee0cf673f5cf2b508b","622170f6884fde323b00ab11c4b3d81f73591b3fe8e052bbdd1c05685eccb550","4ee685ca174ce64566faef7615222ff38f965a40a7f7e2ab5e040c41dbc03f10","f7bd755118e99bdfa7393a3620b41acd5725a3b42f9a6a01f88b8dfb4b009e88","5534279546322ca546e19a39913385e73cbb2a37393ca8a7ef9f9b95fc40e4ba","256ce791eb031dc812b162d42bb009948bddd92f8ce350eddd0f88120c9aa850","2d9673cd0b875821e59edb6c3e0fb89847e46d9772977904c2163e87d950c899","539a198c38c899812921614925d45f0d5dc4a0da70461037df101c5e52339a31","5b433c6855a9d87ba1cfd98be4cca85bf21bd41c3b4ce66d86fbd124b64deba4","2312144cf38af2a90542632ed060a872ce0770a24c7adc69dde9ef77f68830ad","6a268ed23a316406653ead6dccbcb2527e4ec6c18b85845bd97a528b292b2676","6a98ee032de9dc9ca4dab755c8a3b039f42da1ce78dbb1ac1de16648a66a341e","e4ad5aa4dc8d20d18033380c448b24392d77891058d98693d061bf9adc5e0e2e","a3be1ee7b8d7cc21b0dba5300d6592d17f5c93e41e0c868f1b18eeae4c0fb89e","ca085df7392b2fc8f99caa177be4796e2e0ddb4f59b8bee290b47176fbdaf4b8","dcd62c6316356c3ada30a3401c7a5ccb2df831bae70d3a7660f71b709710b540"],"paragraph_range_zero_based":[2712,2735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2712"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>stop timer T312 for this cell group, if running;","paragraph_zero_based":2736},{"literal_text_all_w_t_and_m_t":"2>reset the counters N310 and N311;","paragraph_zero_based":2737},{"literal_text_all_w_t_and_m_t":"1>if the UE was in RRC_CONNECTED and the SCG was activated before receiving the message for which this procedure is initiated:","paragraph_zero_based":2738},{"literal_text_all_w_t_and_m_t":"2>if SRB3 was configured before the reception of the RRCReconfiguration or of the RRCConnectionReconfiguration and SRB3 is not to be released according to any RadioBearerConfig included in the RRCReconfiguration or in the RRCConnectionReconfiguration as specified in TS 36.331[10]:","paragraph_zero_based":2739},{"literal_text_all_w_t_and_m_t":"3>trigger the PDCP entity of SRB3 to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":2740},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity of SRB3 as specified in TS 38.322 [4].","paragraph_zero_based":2741},{"literal_text_all_w_t_and_m_t":"5.3.5.13b1SCG activation without SN message","paragraph_zero_based":2742},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2743},{"literal_text_all_w_t_and_m_t":"1>if the SCG was deactivated before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed:","paragraph_zero_based":2744},{"literal_text_all_w_t_and_m_t":"2>consider the SCG to be activated;","paragraph_zero_based":2745},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers that the SCG is activated;","paragraph_zero_based":2746},{"literal_text_all_w_t_and_m_t":"2>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2747},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2748},{"literal_text_all_w_t_and_m_t":"2>if bfd-and-RLM was not configured to true before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed; or","paragraph_zero_based":2749},{"literal_text_all_w_t_and_m_t":"2>if lower layers indicate that a Random Access procedure is needed for SCG activation:","paragraph_zero_based":2750},{"literal_text_all_w_t_and_m_t":"3>initiate the Random Access procedure on the PSCell, as specified in TS 38.321 [3].","paragraph_zero_based":2751},{"literal_text_all_w_t_and_m_t":"5.3.5.13cFR2 UL gap configuration","paragraph_zero_based":2752},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2753},{"literal_text_all_w_t_and_m_t":"1>if ul-GapFR2-Config is set to setup:","paragraph_zero_based":2754},{"literal_text_all_w_t_and_m_t":"2>if an FR2 UL gap configuration is already setup, release the FR2 UL gap configuration;","paragraph_zero_based":2755},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 UL gap configuration indicated by the ul-GapFR2-Config in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":2756},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR (gapOffset/10);","paragraph_zero_based":2757},{"literal_text_all_w_t_and_m_t":"if the UGRP is larger than 5ms:","paragraph_zero_based":2758},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":2759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["10d6aa114b6594acbd2e08f0f9c451de3c8c731703b4560e666afbefcd9f1c32","2042eca552d9c2c2864cb3e05d697204cf855d3574e16494d484c74c45ac61ee","a039c17d4aac1912e60ed8cce1b0cd4337814e2f0d034bb92be2ad8940c02ab9","9aaf09c1e05ae7aaff3be0878f82aa59c75bb7284d3dce64fe030389d6bd5a72","8c3fd5b7c54573a70b4fc6939edb8a0e6f128667fd423b5b6950a632e0b5da4e","770a89930c1dbb795f4332ec731de365cef4bd98fc3e085083a2107579a57999","d844b6e540772d2ffc175fc652b42e38e65db2c0a472e58b4232e8af60cbb703","9d52862201fc16750b2bad666da4369876cdf2a2126024c456d97d0e75305cae","296cedd01ea986571f7605c4910f9910b5d7de67ac1a8de05bb026e8b06fc258","3879914e2b3054d9bfffb9ce4c814e93f553f949418def0e800bdcbecf0093be","f7bda95c721e807240d3601d513aa040696a3d5a8d1ee002cb92caf04980ddcc","12547ed02c0c0f8eaa0727ca15503c32d4387fe8e19a5ff333e46dc4a77f5f1a","f0d68b86318dcf9d4f5ba5b44d4e78d9bbbab7bcad62441f7c26bc06cee28cce","caeeff5d2eb487c6264c2321640cbd978dc562369bf7555ad8a6964c56711b4c","cf13a01878e9811ddcb1bf70f267732222bd3ac791f686d7107ffa5210a58599","36dfa225b260ade10dc4f078ff6d852190ea05563a758c3363a9e0d4bd379214","63e12610346c81cbdbf536b56135008f67454de9b517b5b92d81ac30fe6d73ca","a984b13c575ffe666345c4b1866f18c9c5baa5c9a5a7cd5541ed31e3713251d0","d7a5d227623f079926f32fc68dd626e0995bf9b5bb47b9d47d279747bf180bba","a2e83e139ad074ce903475b1577f6ca4c6244949af7d6f01482ea7e33b3357c3","edc04c9bf14d8777e9955f4d139e02be7039462816fe37376f9e20a0c1334801","11b22ae8928a52312afa43c8e6f072e4c828c011daf5ba23981c244152b22d20","34e49a1031735577480ee91f9e219db73d8ac13f2071b6dba07889c50ade65a4","4b68d0472b8ecff5f3016531576d2b9b3a94e51e9f28a047e25685c4fb8c74af"],"paragraph_range_zero_based":[2736,2759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2736"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":2760},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset or (gapOffset +5);","paragraph_zero_based":2761},{"literal_text_all_w_t_and_m_t":"with T = CEIL(UGRP/10).","paragraph_zero_based":2762},{"literal_text_all_w_t_and_m_t":"1>else if ul-GapFR2-Config is set to release:","paragraph_zero_based":2763},{"literal_text_all_w_t_and_m_t":"2>release the FR2 UL gap configuration.","paragraph_zero_based":2764},{"literal_text_all_w_t_and_m_t":"NOTE 1:For ul-GapFR2-Config configuration with synchronous CA, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation. For ul-GapFR2-Config configuration with asynchronous CA, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2-ServCellAsyncCA in ul-GapFR2-Config is used in the gap calculation.","paragraph_zero_based":2765},{"literal_text_all_w_t_and_m_t":"5.3.5.13dApplication layer measurement configuration","paragraph_zero_based":2766},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2767},{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToReleaseList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2768},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToReleaseList:","paragraph_zero_based":2769},{"literal_text_all_w_t_and_m_t":"3>forward the measConfigAppLayerId and inform upper layers about the release of the application layer measurement configuration including any RAN visible application layer measurement configuration;","paragraph_zero_based":2770},{"literal_text_all_w_t_and_m_t":"3>discard any application layer measurement report received from upper layers;","paragraph_zero_based":2771},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to send application layer measurement report for the measConfigAppLayerId.","paragraph_zero_based":2772},{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToAddModList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2773},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToAddModList:","paragraph_zero_based":2774},{"literal_text_all_w_t_and_m_t":"3>if measConfigAppLayerContainer is included for the corresponding MeasConfigAppLayer configuration:","paragraph_zero_based":2775},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerContainer, the measConfigAppLayerId and the serviceType to upper layers considering the serviceType;","paragraph_zero_based":2776},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to send application layer measurement report for the measConfigAppLayerId in accordance with 5.7.16;","paragraph_zero_based":2777},{"literal_text_all_w_t_and_m_t":"3>forward the transmissionOfSessionStartStop, if configured, and measConfigAppLayerId to upper layers considering the serviceType;","paragraph_zero_based":2778},{"literal_text_all_w_t_and_m_t":"3>if ran-VisibleParameters is set to setup and the parameters have been received:","paragraph_zero_based":2779},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId, the ran-VisiblePeriodicity, if configured, the numberOfBufferLevelEntries, if configured, and the reportPlayoutDelayForMediaStartup, if configured, to upper layers considering the serviceType;","paragraph_zero_based":2780},{"literal_text_all_w_t_and_m_t":"3>else if ran-VisibleParameters is set to release:","paragraph_zero_based":2781},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId and inform upper layers about the release of the RAN visible application layer measurement configuration;","paragraph_zero_based":2782},{"literal_text_all_w_t_and_m_t":"3>if pauseReporting is set to true:","paragraph_zero_based":2783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6343b4be6e8729d5da14477f0ce975eda12e994b11223028f1ef01fedffdc695","65d06435518c14e96370a0984272ae66121b7249971f85bdfb1b8cc87165f8fa","2cd2055bb387ab0b38e29962180c6c700d1c398cd1ebdb344b2091743dfcfb94","658d89d23fb876688edf8387b0606c18f3e46b364d60b2fb5f52110a6d9040d7","69f8107be2930cba261d75990563dbec999439e3b8bf4d595c7bfc56443e48e1","5bc6b7b5ed0b87e78907bbd7a18e72a32714a4a35bd28d84a267acc329ecdffd","ef5f73d665bdf5cc84bdd88d383bfb70d3bec76e601fe2b9dbac5a9189088d18","da203303a284ca94651abe621e407f53e262b18a7316ef8ee4311cf2fd4e754b","516d41722d40baa1a10e10128938f22609c89299fee2db9eb30121477620a0cd","4a12b6da530bba9982096abe22617648fd0bdfa3271e28bc3cf2c099a6e3e905","aeed74e833cc2b52cd796581f1e8cb5180618f2e3acd10d044eb5d919914281c","3be4fd0b75553c24815490034abc0fd4921a5adcff370a71c0ca6de2eda98f39","c1d8c51eb3cbb73c6f0c576407cbfe73f7f9b057a9207dd7e588a7e512a4b404","6f924276d7697d1074f9d0cbc795c053d8f4706aaeb91e01c1b895aab58e205b","d482613c48c9358ee4c87a218fe9381bcb3477fac513e863269d81bf4a75cc6f","dd61de4fb08ea31314152484ef6a580b1b3226a81d2b5e4b4a6e5942c5b29efd","fd62f58059ef5e04e43b5a6e8b4e5724f13c6db1ae43031bfae7699e721f7631","235a09195e61708a5351c46fd5211649f98cb0f9dda53c0b4c458821189a7026","29c38f0c5a82e6a7ffc7c2e268b0ea4718de0375c30fdb129cb98c9caee3ae7e","4c8dc2c68a76606b0b9ca0c7a79c6085a5fd7e3eff06d24ca4a4c9a46af37306","c9470a1052ed86533e1001118ba36daf0a8f5b2c681b4494501b3b2efef422f2","0439abaa5cd217e568b5da79c294e609cc0116157effc28064555836ea2056ef","90b341703d8948322a367ea75769c832926a594398366642535aa5907e0567cb","acdd56eb23e96f0b53782ed5439111afec86feb178540e9953dc5dc411efb9cb"],"paragraph_range_zero_based":[2760,2783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2760"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if at least one segment, but not all segments, of a segmented MeasurementReportAppLayer message containing an application layer measurement report associated with the measConfigAppLayerId has been submitted to lower layers for transmission:","paragraph_zero_based":2784},{"literal_text_all_w_t_and_m_t":"5>submit the remaining segments of the MeasurementReportAppLayer message to lower layers for transmission;","paragraph_zero_based":2785},{"literal_text_all_w_t_and_m_t":"4>suspend submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2786},{"literal_text_all_w_t_and_m_t":"4>store any previously or subsequently received application layer measurement report containers associated with the measConfigAppLayerId for which no segment, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":2787},{"literal_text_all_w_t_and_m_t":"3>else if pauseReporting is set to false and if transmission of application layer measurement report containers has previously been suspended for the application layer measurement configuration associated with the measConfigAppLayerId:","paragraph_zero_based":2788},{"literal_text_all_w_t_and_m_t":"4>submit stored application layer measurement report containers to lower layers, if any, for the application layer measurements configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2789},{"literal_text_all_w_t_and_m_t":"4>resume submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2790},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may discard reports when the memory reserved for storing application layer measurement report containers becomes full.","paragraph_zero_based":2791},{"literal_text_all_w_t_and_m_t":"NOTE 2:The transmission of RAN visible application layer measurement reports and appLayerSessionStatus is not paused when pauseReporting is set to true.","paragraph_zero_based":2792},{"literal_text_all_w_t_and_m_t":"5.3.5.14Sidelink dedicated configuration","paragraph_zero_based":2793},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2794},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2795},{"literal_text_all_w_t_and_m_t":"2>for each entry included in the received sl-FreqInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2796},{"literal_text_all_w_t_and_m_t":"3>release the related configurations from the stored NR sidelink communication/discovery configurations;","paragraph_zero_based":2797},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2798},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink communication:","paragraph_zero_based":2799},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-RxPool for NR sidelink communication reception, as specified in 5.8.7;","paragraph_zero_based":2800},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink communication:","paragraph_zero_based":2801},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication transmission, as specified in 5.8.8;","paragraph_zero_based":2802},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink discovery:","paragraph_zero_based":2803},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscRxPool or sl-RxPool for NR sidelink discovery reception, as specified in 5.8.13.2;","paragraph_zero_based":2804},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink discovery:","paragraph_zero_based":2805},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling, sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink discovery transmission, as specified in 5.8.13.3;","paragraph_zero_based":2806},{"literal_text_all_w_t_and_m_t":"2>perform CBR measurement on the transmission resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling, sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication/discovery transmission, as specified in 5.5.3;","paragraph_zero_based":2807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["6dfddf3b26f0f4da7a43950f44abb781712926c629fc2cdda7ee912d692638a1","c83882d1b5796965378afc301285392479d63441127647d04f103f65dfc4c2d0","397212dab2ba2d6e638ed35219b34ef25291be9b1afd8f297013819ab937480c","a3322e98ef7d9db6b725e1ca8ab1523dcf5cd96d55f00524e5aabf0d8ee7f48a","444c04690b66870612a9b353459e680f9d06ddb1796a20aba37d22f9f99ad184","0dc752dcf98275d4c17ab425da7ac3363d1657c4f174cf266d9f9da1a7a5e4b2","edefea1c21af3b8f252eb04300a1e58a433430ac14c8176113e1225be5a3a86f","34c08bebc6e97517c0d2e9121d4483b82fe415269212aad6782fbeb2e8513571","6cb8f3e1a38be0006d6c86c0dc5f76859debf5fd52db5ebdcae6dcbc420f2233","d0b4eb7e4d3edab02b2af17ecda50c01d62d2b0e128708b37b34bfeced749e94","cd872ad8beef0f8f5586ec3b0471e65841ebb651edd92e89bbca57b09c6baa66","314c6469dcb4776d6d05f86c5ef5b9b182991bad54483fd4c0edc3ead26727fd","992544a12a98bd84c3df64a50e521ec003073017b90e1864760e84608e367f42","414bd52d3473e471e20be3556c000df9bf2271eda2449b31d28fbc02e7049fd0","7a3fdf6f01bef39530c50f8788e7619880ece5f8fa8ee0bd7fe3641e0c372e4a","a78b950450041f792acdfce2c0863cf089f20c5a8f355313eb7e0bbe7624f0f0","48ac4b9edf963fbef877fa6619357467971d88c323c1e9a44c1aa5cbaeef286f","13bd0664405dc8809da18960565e9eb757700eca067e9b5e8c7db00cf07d328b","e7511fb3c91841ce2807114ece8443be8ca70f79a60db6032c6ab29b2b93adb3","5d0fc5b85c2c4c10d341e824cf458a71e1c77e361770ddbd64e090236972ac1a","d329b5dc0947ec968f8be0e42a98237a6c0c7e8b553f184f041f1b35b79b8621","5dd8edee8cfa0aed94c4ca8a42100dfcc3481c5fcd286198af0ca3a7e258acff","60be08b3b3a4fd71b8cdf6ad6602afd013622a7d176ce0bd31c8d84bc82f0f82","47c3f7f01e72296dc97240dabeebf21f8008c8ffe009fd00cdb74e01cad404d7"],"paragraph_range_zero_based":[2784,2807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2784"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>use the synchronization configuration parameters for NR sidelink communication/discovery on frequencies included in sl-FreqInfoToAddModList, as specified in 5.8.5;","paragraph_zero_based":2808},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToReleaseList or sl-RLC-BearerToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2809},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB release as specified in 5.8.9.1a.1;","paragraph_zero_based":2810},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToAddModList or sl-RLC-BearerToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2811},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB addition/modification as specified in 5.8.9.1a.2;","paragraph_zero_based":2812},{"literal_text_all_w_t_and_m_t":"1>if sl-ScheduledConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2813},{"literal_text_all_w_t_and_m_t":"2>configure the MAC entity parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-ScheduledConfig;","paragraph_zero_based":2814},{"literal_text_all_w_t_and_m_t":"1>if sl-UE-SelectedConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2815},{"literal_text_all_w_t_and_m_t":"2>configure the parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-UE-SelectedConfig;","paragraph_zero_based":2816},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2817},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-MeasConfigInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2818},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2819},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2820},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2821},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2822},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is not part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2823},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink measurement configuration.","paragraph_zero_based":2824},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink measurement configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2825},{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2826},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-DRX-ConfigUC-ToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2827},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2828},{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2829},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2830},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["dd7c942e6b205db96166989838a2a2ef29a53c6355db5ad389c6f77a9c5c8dce","137368da2369fb187e18b0e4b36c865c1b9d44ba55838652ead7ff3abb8aeb47","7411bd29b9a3a87e85967c0f55c0446deecadaeae2d937ba79ebfd192688d292","7a8eb6950344375c346a1557c647bfc8110d5317c9fd24c3f5e25d15dac99958","673efda281cf94600c83732a6d2182c1175dd733918590f56d6efdab2047be0f","b55955c26bc0e178575bd87b95b6878fc7f3c0836817d9bc987d670ff1b1898c","8cf001f5d5381c29fc28d50ec576274ed431d297d5cbd7c548c4e3f4604d55c3","a52f695c17ba4da61a2f7bcfe146bfb6e72922d13afd7105346fd141a8d1c239","b57831b8f997ae54ca63c29f8c2c92ec842b6b8158b8d2e282915887e56aa5b4","0f6064779952ff6200f6b43ac07d24515b21a8af7ffd8a6aa3b3cd1ec20b0cd1","71598f4885b1da1e0822078eec3b29603c8c62d799492b69a4ce6004da8b256e","6c6b3cbe10e93acbbd805f054208fc9bf3cd84aff34c24eb2e381d87958c5a50","54f59b9ef9892c186d7cf1899eaf50c2824b8549a969f5ca87cd4da15553df81","4ba498ceade48465cc61742012f0038628d92ed76e949a673cd10f18696730cb","cfac555b9a0ace8d15ca7e5f039ec78eded7d4c633cf65f3042749d45824dbf0","ab2836688ef82272c3a0d94b222ee00c269f90f4fdff28372135e6eaf2ba01db","2802afeb75ee912c688fc332db3af1de5eb0af1685618ef1b2cd0def2c394945","8a589ceeaf886bb616623c5c52d0ae9ac2091d7a98f686f025df55e6c1dcd9a7","d02111b7545b0ed3f65f232aee06d8cac651f0d89fa0072bf162fa54c048def4","18e867c1a1924b47d63f59335a145255fcc80282ebdaa9f3dac2a59a2a1b56ca","22314618d3f11a0e2c92496927231f3d55603c157835c3ca14887e91e32176df","b7f795ceb21e07ed234ccf19414d2a342a9111b1545a871a75eacbef8e32d602","2e843de8aa0e9ddd20bdf09cc2bd8fa474db54b46336b77be8fa5fd3e2cdb6c1","f7c4d89535f695345ca8c3abda4e6c716f2a17c59082cbdbc943700a1e819245"],"paragraph_range_zero_based":[2808,2831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2808"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is not part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2832},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink DRX configuration.","paragraph_zero_based":2833},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink DRX configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2834},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2835},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel release as specified in 5.8.9.7.1;","paragraph_zero_based":2836},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration or RRCSetup:","paragraph_zero_based":2837},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel addition/modification as specified in 5.8.9.7.2;","paragraph_zero_based":2838},{"literal_text_all_w_t_and_m_t":"5.3.5.15L2 U2N Relay UE configuration","paragraph_zero_based":2839},{"literal_text_all_w_t_and_m_t":"5.3.5.15.1General","paragraph_zero_based":2840},{"literal_text_all_w_t_and_m_t":"The network configures the L2 U2N Relay UE with relay operation related configurations. For each connected L2 U2N Remote UE indicated in sl-L2IdentityRemote, the network provides the configuration parameters used for relaying.","paragraph_zero_based":2841},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2842},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RelayUE-Config is set to setup:","paragraph_zero_based":2843},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2844},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE release as specified in 5.3.5.15.2;","paragraph_zero_based":2845},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToAddModList:","paragraph_zero_based":2846},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE addition/modification as specified in 5.3.5.15.3;","paragraph_zero_based":2847},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RelayUE-Config is set to release:","paragraph_zero_based":2848},{"literal_text_all_w_t_and_m_t":"2>release the relay operation related configurations.","paragraph_zero_based":2849},{"literal_text_all_w_t_and_m_t":"5.3.5.15.2L2 U2N Remote UE Release","paragraph_zero_based":2850},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2851},{"literal_text_all_w_t_and_m_t":"1>if the release is triggered by reception of the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2852},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIdentity value included in the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2853},{"literal_text_all_w_t_and_m_t":"3>if the current UE has a PC5 RRC connection to a L2 U2N Remote UE with SL-DestinationIdentity:","paragraph_zero_based":2854},{"literal_text_all_w_t_and_m_t":"4>indicate upper layers to trigger PC5 unicast link release.","paragraph_zero_based":2855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["db755c7b61a75a1553b6f2cfdade155f8aecf37bc10bcb02cd1d1315b523ef99","0440ccb32b5ec424581e630078fe60185192b9d80824d508eb14e37dc99aeb7d","d3368f341f613e07300ddb2f2dc79b7240b4907e897fca40208c650632cd01ca","3481e5ba75329caa5636df8c9743c962106ef8484b0700b96d0657e4bb680ae9","3ced19bc07f92360203f724b5749292dd430b1430ca005786c50db1c18901c3c","aaf4e6946526c08e6a60edd120dfd3dd1a37be848a3c9c050493c84fb555cc34","932db358899a268065f80b3666300cba042ad24dd80dea4e74ceb0c517a5c86f","bdd738b7ca3ba93a25af14720e6c31ceda5bf68af70f49dafe5b2fe79a1d57e6","7bdd5736e89a55c02098baae568b4b23fce1c48c23edea0eb3125aefe393c201","5be994e75e98f68b114a09d2e994dad2d3c722d16229ec5b87b09991f5b6e0fa","02d09e7637d92a4cea7ec5ef3e4dd6844d3065531f45899e508f4263770e07d6","1085013c6f1509222abca2e90e2a5bfa7a2d40b40af62ac029357cae9563ee79","e58c5dac39895dc6239aae92098ad0b3dff9a3b582b2d75f48bf25556eb3cf16","8bc11aae5d5c8c2baf52186cb2a773f9c9556a52bacaac413a097a90ef8ce51c","df69cff3eb52281ece638219a4769a81b3066e153cf185d0e7f621516656cff3","567d5fbbf2470ec2939b203d31435f4ae42f523470f3130480635fca63549e5f","b68788874adbaa9089ecde814b4aedf3e6d2bebb1dc066179b8b5645455212af","6806df50116db46c1c7311707c9414f9e7b29cee33cc4d9b9638c9d3cd67930c","ece4d42daa62004f0073dee5b54eaf46781563fce665aa3a0e86123044bf4513","1978bb8b4fc8cd01a19d56bea8968867516178fe1b04aebe9dfd8c8fa435960d","9e2fb9e814294296cbc5af8253bf50042a0f77f2555a2a08a7383e4366b6e59a","8354542d9ccef0a4446a9fee16c68de8626f14481a07291966764fb7178f6943","b90522ae5d8078afc74c859d933c34ddf35da6e7ed8cef34db4261471082d303","8e2c3cd5d26e69883e2fabd8030813374d8965e23d199d581e8c16238e1ac8f0"],"paragraph_range_zero_based":[2832,2855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2832"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.5.15.3L2 U2N Remote UE Addition/Modification","paragraph_zero_based":2856},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2857},{"literal_text_all_w_t_and_m_t":"1>if no SRAP entity has been established:","paragraph_zero_based":2858},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66];","paragraph_zero_based":2859},{"literal_text_all_w_t_and_m_t":"1>for each sl-L2IdentityRemote value included in the sl-RemoteUE-ToAddModList that is not part of the current UE configuration (L2 U2N Remote UE Addition):","paragraph_zero_based":2860},{"literal_text_all_w_t_and_m_t":"2>configure the parameters to SRAP entity in accordance with the sl-SRAP-ConfigRelay;","paragraph_zero_based":2861},{"literal_text_all_w_t_and_m_t":"2>if SRB1 is included in sl-MappingToAddModList, and sl-EgressRLC-ChannelPC5 is configured:","paragraph_zero_based":2862},{"literal_text_all_w_t_and_m_t":"3>release SL-RLC1, if established;","paragraph_zero_based":2863},{"literal_text_all_w_t_and_m_t":"3>associate the PC5 Relay RLC channel as indicated by sl-EgressRLC-ChannelPC5 with SRB1;","paragraph_zero_based":2864},{"literal_text_all_w_t_and_m_t":"2>else: (i.e. SRB1 is not included in sl-MappingToAddModList, or SRB1 is included in sl-MappingToAddModList, but sl-EgressRLC-ChannelPC5 is not configured)","paragraph_zero_based":2865},{"literal_text_all_w_t_and_m_t":"3>if SL-RLC1 is not established:","paragraph_zero_based":2866},{"literal_text_all_w_t_and_m_t":"4>apply the default configuration of SL-RLC1 as specified in clause 9.2.4 and associate it with the SRB1;","paragraph_zero_based":2867},{"literal_text_all_w_t_and_m_t":"1>for each sl-L2IdentityRemote value included in the sl-RemoteUE-ToAddModList that is part of the current UE configuration (L2 U2N Remote UE modification):","paragraph_zero_based":2868},{"literal_text_all_w_t_and_m_t":"2>modify the configuration in accordance with the sl-SRAP-ConfigRelay;","paragraph_zero_based":2869},{"literal_text_all_w_t_and_m_t":"5.3.5.16L2 U2N Remote UE configuration","paragraph_zero_based":2870},{"literal_text_all_w_t_and_m_t":"The network configures the L2 U2N Remote UE with relay operation related configurations, e.g. SRAP configuration.","paragraph_zero_based":2871},{"literal_text_all_w_t_and_m_t":"The L2 U2N Remote UE shall:","paragraph_zero_based":2872},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RemoteUE-Config is set to setup:","paragraph_zero_based":2873},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RemoteUE-Config contains the sl-SRAP-ConfigRemote:","paragraph_zero_based":2874},{"literal_text_all_w_t_and_m_t":"3>if no SRAP entity has been established:","paragraph_zero_based":2875},{"literal_text_all_w_t_and_m_t":"4>establish a SRAP entity as specified in TS 38.351 [66];","paragraph_zero_based":2876},{"literal_text_all_w_t_and_m_t":"3>configure the parameters to SRAP entity in accordance with the sl-SRAP-ConfigRemote;","paragraph_zero_based":2877},{"literal_text_all_w_t_and_m_t":"3>if SRB1 is included in sl-MappingToAddModList, and sl-EgressRLC-ChannelPC5 is configured:","paragraph_zero_based":2878},{"literal_text_all_w_t_and_m_t":"4>release SL-RLC1, if established;","paragraph_zero_based":2879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["251a8a190bbdcbd8ec72ac934008547fefea81eeb7e1158c6a25727f3b1bdff8","88314caf34f31821638a529c487180e5eea95426ec87a14e9a11471d0b2d9273","11e840679f77f39dcc736fd22d8a998e6f51f42ffaf74207e75645270b30d569","605f657355a2354b38da10045842cb8b9d1f3cd64d74ef60677b362584fdee0b","4e21963fed72cbe874cee9721fd6da1066d46b2ac54e7a5d9d79c143d636c7ec","3fd4bb619dea6495b6da73903bf8f7a9f61f5af20f5ed927b63024033cc7f767","71a310cccee88244287c3fc3036973bebce7bab38d1d8f00253b728893a75feb","dd84f915c8b6a46caf8e8aba12ea5a839190ce68eb484f1db3ae1cf18220bc62","10a8b7b5838eb0d5f6002fecd9ef9f060c741da499dcb070eb6432a556ac63df","d22e3ec724c04e99a53577962fc4596c260d6fa77b1bffcd07aff27988f5005e","f2f09ba644c221adfc3a91e39c7101ec4d848866a6bcce7ab6d82d6c9c35c865","c3d6dda33a022417dfd3b631cdbcb56244d880d7d4e36199fcbbf60a9ce4663f","d50a60aa496bd083e961e573a44f4ff740bf175e62ee5ef2d77947e650d7d823","5c4007f5234cbd2f2512d615c1287b5d3d7c2acdd0ece7485325845c22941d19","26bb15e0d0ac602a47d236cb37b236bfc07a320afabc9e9d28950c659d7b6016","bc33b531f9da9b9ccd6eb9ed277f8f0cf910f0911d4c27e30d0cacc0587d0b57","790a3fe21753d47acc7f6f89e24a243c4e9958126b0ca2b9d8f5cff8de8f179c","56d65b88e9eaefc7d4b036a635b6327f96285d75a34069034d4f05cd280d88fb","82294ac6cc1a2e72778f1f480286ee2411618a984225aecfb330375cc71205fd","9d40c62007eaf14d42811bd5fcc78a9bddb72ef3337ba8fd5c73f82b4cf4c1b7","0df9d772160d4ca26eea0e4f4b1566dd28bb406b3054972d15bc456b2b7028e4","beeff5f894c0035131d2696e291821f574498f68f391eda6460375da9eb67abf","3d6b0abb704a66a99ebe0201c4c34bf20b56d71ce8fb29a472ede810a3e51d61","f607fbfbe315f0ef1d4848fe0509e4e3e2edb7a08a53fdc5d4545daf8bad9dfa"],"paragraph_range_zero_based":[2856,2879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2856"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4> associate the PC5 Relay RLC channel as indicated by sl-EgressRLC-ChannelPC5 with SRB1;","paragraph_zero_based":2880},{"literal_text_all_w_t_and_m_t":"3>else: (i.e. SRB1 is not included in sl-MappingToAddModList, or SRB1 is included in sl-MappingToAddModList, but sl-EgressRLC-ChannelPC5 is not configured)","paragraph_zero_based":2881},{"literal_text_all_w_t_and_m_t":"4>if SL-RLC1 is not established:","paragraph_zero_based":2882},{"literal_text_all_w_t_and_m_t":"5>apply the default configuration of SL-RLC1 as specified in clause 9.2.4 and associate it with the SRB1;","paragraph_zero_based":2883},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RemoteUE-Config contains the sl-UEIdentityRemote:","paragraph_zero_based":2884},{"literal_text_all_w_t_and_m_t":"3>use the value of the sl-UEIdentityRemote as the C-RNTI in the PCell.","paragraph_zero_based":2885},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RemoteUE-Config is set to release:","paragraph_zero_based":2886},{"literal_text_all_w_t_and_m_t":"2>release the relay operation related configurations.","paragraph_zero_based":2887},{"literal_text_all_w_t_and_m_t":"5.3.6Counter check","paragraph_zero_based":2888},{"literal_text_all_w_t_and_m_t":"5.3.6.1General","paragraph_zero_based":2889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2890},{"literal_text_all_w_t_and_m_t":"Figure 5.3.6.1-1: Counter check procedure","paragraph_zero_based":2891},{"literal_text_all_w_t_and_m_t":"The counter check procedure is used by the network to request the UE to verify the amount of data sent/ received on each DRB. More specifically, the UE is requested to check if, for each DRB, the most significant bits of the COUNT match with the values indicated by the network.","paragraph_zero_based":2892},{"literal_text_all_w_t_and_m_t":"NOTE:The procedure enables the network to detect packet insertion by an intruder (a 'man in the middle').","paragraph_zero_based":2893},{"literal_text_all_w_t_and_m_t":"5.3.6.2Initiation","paragraph_zero_based":2894},{"literal_text_all_w_t_and_m_t":"The network initiates the procedure by sending a CounterCheck message.","paragraph_zero_based":2895},{"literal_text_all_w_t_and_m_t":"NOTE:The network may initiate the procedure when any of the COUNT values reaches a specific value.","paragraph_zero_based":2896},{"literal_text_all_w_t_and_m_t":"5.3.6.3Reception of the CounterCheck message by the UE","paragraph_zero_based":2897},{"literal_text_all_w_t_and_m_t":"Upon receiving the CounterCheck message, the UE shall:","paragraph_zero_based":2898},{"literal_text_all_w_t_and_m_t":"1>for each DRB that is established:","paragraph_zero_based":2899},{"literal_text_all_w_t_and_m_t":"2>if no COUNT exists for a given direction (uplink or downlink) because it is a uni-directional bearer configured only for the other direction:","paragraph_zero_based":2900},{"literal_text_all_w_t_and_m_t":"3>assume the COUNT value to be 0 for the unused direction;","paragraph_zero_based":2901},{"literal_text_all_w_t_and_m_t":"2>if the drb-Identity is not included in the drb-CountMSB-InfoList:","paragraph_zero_based":2902},{"literal_text_all_w_t_and_m_t":"3>include the DRB in the drb-CountInfoList in the CounterCheckResponse message by including the drb-Identity, the count-Uplink and the count-Downlink set to the value of TX_NEXT – 1 and RX_NEXT – 1 (specified in TS 38.323 [5]), respectively;","paragraph_zero_based":2903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["efe9025cef509b742ef96badb94b71ec46ffa7009277a705fa4de0cc857578dd","e25c4bbaafafbe724a870f69b32e53a10f5b0bcd99a01add73cc852d5ec5ee8b","7a57a0f9f9576c78386aa983380c9c9d3bce6a808a500207eea0f706c4d1572d","36259cd09555ab046a28dc36ee3b7d948e67739e23efaae3e6b66c5050d69974","043dca1e51e5df38e8190706c9906558348a46644db0ab4caf8b5adfac16863f","038541e97c5ff96480edcb5b72e7ba10ecb4c8da5b6d69e6fe876715515e5f53","bbc8f6df8c8dc9827a0cad2b140cf7a9cc174a313d82d1812c53ae86795b7cdf","48e96b015cecd2159f8527dbd7e3c30f4dd14434a5a86cc5abf57cf5a2d19c6c","aa945eb5640c40621bf441f313a3e446058728341be0e211ab3b9dce4b5bb040","f8fc05d834cb03d1373e4656686bdf9d293f1f83664042c46f0c90a1ab2fee6b","5acb5d1eb4853018dcebc7191087db362c0fd4959c6f24b8cb6a7ceace82e50f","df25b90857aeb80622d73a3070eabf579f6f82a3779111a7d4340a6eb9276d74","783f8c88fcc88ab891266770e42aaf5b2abc9cb6f86b6ddb34e2b91fa58dab41","063f84b87d6dba7c1a767ec10917a135c6b1e07fef431ad6299f0f9283b496fc","9f54fc7452aeb50a976b9a750637b0be962ad47bb0f33baa8c5a68e7f44007cb","4a9ce88569825c422cdcf9a1a3e76f9c97e378c9dbc58f8b89cdbc15168a091c","11430e4a741cbb42b378d53fe6a53ba84c0dfb094039f761edfdda0b95806e45","c16125213458def2e0a70f739c412667bd4f259eba74d57cde9e8d01e3bf4fd5","70dd01104bac6ddda4b479ca8342699844065f7bd2d765c8c674939a1f9452d2","156f40deb048c569dff33d7ae0bb13046e6f980fc671b37de7f60fa6d408729c","081c584ba25c6b279a0a64e8c6979fb2045c6c662918e54de51696d6f7ee31d9","9b9bdd6b32aca721962de027fcb3009c776417b5d39d97a79118af43711416f7","44b4203724aa2d135b2a697f1639a5446ca13c63e7a8d071edd2ab96aaeebc02","cb4596f12d10565445b45c610b3188bd69a95410f3cff91b0cd5b49efb1145f6"],"paragraph_range_zero_based":[2880,2903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2880"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if, for at least one direction, the most significant bits of the COUNT are different from the value indicated in the drb-CountMSB-InfoList:","paragraph_zero_based":2904},{"literal_text_all_w_t_and_m_t":"3>include the DRB in the drb-CountInfoList in the CounterCheckResponse message by including the drb-Identity, the count-Uplink and the count-Downlink set to the value of TX_NEXT – 1 and RX_NEXT – 1 (specified in TS 38.323 [5]), respectively;","paragraph_zero_based":2905},{"literal_text_all_w_t_and_m_t":"1>for each DRB that is included in the drb-CountMSB-InfoList in the CounterCheck message that is not established:","paragraph_zero_based":2906},{"literal_text_all_w_t_and_m_t":"2>include the DRB in the drb-CountInfoList in the CounterCheckResponse message by including the drb-Identity, the count-Uplink and the count-Downlink with the most significant bits set identical to the corresponding values in the drb-CountMSB-InfoList and the least significant bits set to zero;","paragraph_zero_based":2907},{"literal_text_all_w_t_and_m_t":"1>submit the CounterCheckResponse message to lower layers for transmission upon which the procedure ends.","paragraph_zero_based":2908},{"literal_text_all_w_t_and_m_t":"5.3.7RRC connection re-establishment","paragraph_zero_based":2909},{"literal_text_all_w_t_and_m_t":"5.3.7.1General","paragraph_zero_based":2910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2911},{"literal_text_all_w_t_and_m_t":"Figure 5.3.7.1-1: RRC connection re-establishment, successful","paragraph_zero_based":2912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2914},{"literal_text_all_w_t_and_m_t":"Figure 5.3.7.1-2: RRC re-establishment, fallback to RRC establishment, successful","paragraph_zero_based":2915},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to re-establish the RRC connection. A UE in RRC_CONNECTED, for which AS security has been activated with SRB2 and at least one DRB/multicast MRB setup or, for IAB, SRB2, may initiate the procedure in order to continue the RRC connection. The connection re-establishment succeeds if the network is able to find and verify a valid UE context or, if the UE context cannot be retrieved, and the network responds with an RRCSetup according to clause 5.3.3.4.","paragraph_zero_based":2916},{"literal_text_all_w_t_and_m_t":"The network applies the procedure e.g as follows:","paragraph_zero_based":2917},{"literal_text_all_w_t_and_m_t":"-When AS security has been activated and the network retrieves or verifies the UE context:","paragraph_zero_based":2918},{"literal_text_all_w_t_and_m_t":"-to re-activate AS security without changing algorithms;","paragraph_zero_based":2919},{"literal_text_all_w_t_and_m_t":"-to re-establish and resume the SRB1;","paragraph_zero_based":2920},{"literal_text_all_w_t_and_m_t":"-When UE is re-establishing an RRC connection, and the network is not able to retrieve or verify the UE context:","paragraph_zero_based":2921},{"literal_text_all_w_t_and_m_t":"-to discard the stored AS Context and release all RBs and BH RLC channels and Uu Relay RLC channels;","paragraph_zero_based":2922},{"literal_text_all_w_t_and_m_t":"-to fallback to establish a new RRC connection.","paragraph_zero_based":2923},{"literal_text_all_w_t_and_m_t":"If AS security has not been activated, the UE shall not initiate the procedure but instead moves to RRC_IDLE directly, with release cause 'other'. If AS security has been activated, but SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, are not setup, the UE does not initiate the procedure but instead moves to RRC_IDLE directly, with release cause 'RRC connection failure'.","paragraph_zero_based":2924},{"literal_text_all_w_t_and_m_t":"5.3.7.2Initiation","paragraph_zero_based":2925},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when one of the following conditions is met:","paragraph_zero_based":2926},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG and t316 is not configured, in accordance with 5.3.10; or","paragraph_zero_based":2927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b859fda334cc9310dcd48a17f5cefa578dbbbf8fffc5d710f630c9ea130b4dad","e37faf979d288e86323d66939305e0752d6a7dac8e6289223406c7990c004e52","74aff5abb245f7004b9e1e085d9f59a15921471d30fab86b4163a64d2ed2078a","61e358a8681ce2a0a4660b46c86829581e5717bd1464b4c7d9c58b37c9dcfe0f","5ce3103e6b21b434c01abb1e4c8b924d59a8a57f6371e25d47df8ac31d195536","e6f0e05b352c1f2899c6021174d88237c3aae630e4887165e3b61c10ea5e179a","6cb26fc261b892a43475e2b39ef1f674d56951c668ba76556a282221fb1024e0","a4a900583515e3fcdac68dd5767da8cd71ce578f8c3bbc79e15679ab53d2215c","411120e044df9c7a28249b9a8a86f5f2ee7e082245f1ad67caa14c4941568572","4f8860946981f9eeb8f9f3d566a05a52e142b68c5e90bd73e6b683c85458232f","ecbfc765088d73c7946cba0bb7cfad76737231475d59126d300db61c7c0590c1","7c61d25ebcd9ecfd1621ba8c5f67bc8cebe07adb657650e1238fa7391a813615","81745ee1f14b9e16a57fa154a91327b66df113d740b0ddd37670a8a8fcf2edfe","a1f08f08f7730b9f3b2f7e68409f59b968efa8ca4afe039fdc42dd0db0a46912","755a5e88d9413b3188b253c3d13bef8e59aa9dbbb26ca6d570986095669ea118","1110b5424c34668c88ffe6557d681186bd8306c07d889250093dedd7720d7233","1e1e01e73a3a1a60a64ede94d3cfb5a2df27250eb6acc4737e9cb7f122516014","27a1810ffc3a25501a1ed93a82fcb854f4426c51666f4d982755a0b2deb66c78","ed3ff188d2c69a73bf2a17dec50ccde96d5f1b6c7225bbc0f4739473b74332ea","32777c866e2d108a40e7e2174d108fa006abfb40b2d1f081ac37aa1ec28eda85","9e8c0861aec9da33211be0c94ef4e68cbc480fa95341542ce8f0eb62a1377775","015931114e5790390eb600baebc820db820cb102905d74c579e9619378cc2af4","fea0d06848c357598173441a4916dd6a96e1169e31f9157a400b82fcb3a32a4b","d3bde14bdcdcd8ce6d2f081372de3e0dab20f82e39f951ca033f220c8a30f8cd"],"paragraph_range_zero_based":[2904,2927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p2904"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while SCG transmission is suspended, in accordance with 5.3.10; or","paragraph_zero_based":2928},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while PSCell change or PSCell addition is ongoing, in accordance with 5.3.10; or","paragraph_zero_based":2929},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure of the MCG while the SCG is deactivated, in accordance with 5.3.10; or","paragraph_zero_based":2930},{"literal_text_all_w_t_and_m_t":"1>upon re-configuration with sync failure of the MCG, in accordance with clause 5.3.5.8.3; or","paragraph_zero_based":2931},{"literal_text_all_w_t_and_m_t":"1>upon mobility from NR failure, in accordance with clause 5.4.3.5; or","paragraph_zero_based":2932},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from lower layers concerning SRB1 or SRB2, except if the integrity check failure is detected on the RRCReestablishment message; or","paragraph_zero_based":2933},{"literal_text_all_w_t_and_m_t":"1>upon an RRC connection reconfiguration failure, in accordance with clause 5.3.5.8.2; or","paragraph_zero_based":2934},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure for the SCG while MCG transmission is suspended, in accordance with clause 5.3.10.3 in NR-DC or in accordance with TS 36.331 [10] clause 5.3.11.3 in NE-DC; or","paragraph_zero_based":2935},{"literal_text_all_w_t_and_m_t":"1>upon reconfiguration with sync failure of the SCG while MCG transmission is suspended in accordance with clause 5.3.5.8.3; or","paragraph_zero_based":2936},{"literal_text_all_w_t_and_m_t":"1>upon SCG change failure while MCG transmission is suspended in accordance with TS 36.331 [10] clause 5.3.5.7a; or","paragraph_zero_based":2937},{"literal_text_all_w_t_and_m_t":"1>upon SCG configuration failure while MCG transmission is suspended in accordance with clause 5.3.5.8.2 in NR-DC or in accordance with TS 36.331 [10] clause 5.3.5.5 in NE-DC; or","paragraph_zero_based":2938},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from SCG lower layers concerning SRB3 while MCG is suspended; or","paragraph_zero_based":2939},{"literal_text_all_w_t_and_m_t":"1>upon T316 expiry, in accordance with clause 5.7.3b.5; or","paragraph_zero_based":2940},{"literal_text_all_w_t_and_m_t":"1>upon detecting sidelink radio link failure by L2 U2N Remote UE in RRC_CONNECTED, in accordance with clause 5.8.9.3; or","paragraph_zero_based":2941},{"literal_text_all_w_t_and_m_t":"1>upon reception of NotificationMessageSidelink including indicationType by L2 U2N Remote UE in RRC_CONNECTED, in accordance with clause 5.8.9.10; or","paragraph_zero_based":2942},{"literal_text_all_w_t_and_m_t":"1>upon PC5 unicast link release indicated by upper layer at L2 U2N Remote UE in RRC_CONNECTED while T301 is not running.","paragraph_zero_based":2943},{"literal_text_all_w_t_and_m_t":"NOTE 0:It is up to UE implementation whether to initiate the procedure while T346g is running.","paragraph_zero_based":2944},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":2945},{"literal_text_all_w_t_and_m_t":"1>stop timer T310, if running;","paragraph_zero_based":2946},{"literal_text_all_w_t_and_m_t":"1>stop timer T312, if running;","paragraph_zero_based":2947},{"literal_text_all_w_t_and_m_t":"1>stop timer T304, if running;","paragraph_zero_based":2948},{"literal_text_all_w_t_and_m_t":"1>start timer T311;","paragraph_zero_based":2949},{"literal_text_all_w_t_and_m_t":"1>stop timer T316, if running;","paragraph_zero_based":2950},{"literal_text_all_w_t_and_m_t":"1>if UE is not configured with attemptCondReconfig:","paragraph_zero_based":2951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["48e1cbae5bf3770a64d2b64e24377d3bda9d36b093d564acc9107e0a348127ab","64c65cedff575fe33e4e1033ae39ccd7cbd3449c5812b1d6a19b1cec1b33f6be","35939dab6c0e0a65d5f46f080ef82ca1ecf0458f49607fb5f9da943008ba7232","daa2e164c0bf990f3df0b848b462d1ec7a09c7771f0ad728a93ca2b485e49ec8","b28c6e97b25b9711a20f757315a5ec41aabae53006523203aa843e639f49f927","ce3526d904da8afe365fab69ffdc112d0d17c4476471e0692aebc7d69456c466","a5cb790c1fd73d1cbdacbf92892374cfc334846623e7498236927c530a53ff68","8b544659a4b942584199b0cdf928c7a1baf3a79f0e46513f96fa9486a61746fc","5d45761f67b535f5c7be2e6128ad3e3ad6589b5f6581e98b1104eac0356c0110","3bfc039f5b2da7b147713d4ee8e697fc44ec4a0bb50f130de16ed25ebf80b9a6","2c5c7d404f3a39e04e5b9e11399e8fc93e128419ac719cde1dbada47f75bc591","56ed78ea50b2b4c75c1bd07ee7ae8f5f91f9da96f574619569ece4076709e082","c0f44c0b231d7afc6ba8651be3816e7802ec017728c647596fed06683b128056","9dfc13c6295d4ca74354ecf332f142c99217b058ba4a865bb0d6a14d703df246","b3559d58e0077a91c01a534e93571273d17aa7af1eed722ea9001884e8649df8","18ce1da81cac6e97ccde4fa354a8c2d46a8eeae0425d425303245d5f0949c8da","eaa91b73b35d8d556a57fa0a8d22bfb54fd4ee803bbebe6024716f37bd409e31","01cb97ed6c510afef413ad51f3d5a9b70bf078bb35fbe15bbbcb012c2db968b1","f40b122e4d28c8fa58ce1a1848138ba0efcceb47c1bb6214aeed22642b9840fc","b4feb4768c6890e61e28854aab84608798c5b8f44787445a3c43a0cfe76e95dd","e326b417d741d7dcfd11f2d342721aa247497a8a867df78585872bb5339a73df","e638a9f5e8fe79fc75502583c298f8d40fb3ccf8c9d2cb253d2e1199caba6614","48e725680925d1e82e7a72d7c0834eb21c4b25dd252cd6c33688993c4b21743f","0770a7d081a548fc9ea3336811580d7426dc62c761aca5e514a387cf0489525a"],"paragraph_range_zero_based":[2928,2951],"projection":"All w:t 