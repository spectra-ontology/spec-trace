(SIZE (1..maxNrofP0-PUSCH-Set-r16)) OF P0-PUSCH-r16            OPTIONAL, -- Need R","paragraph_zero_based":24397},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24398},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24400},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-SetId-r16 ::=              INTEGER (0..maxNrofSRI-PUSCH-Mappings-1)","paragraph_zero_based":24401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24402},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-r16 ::=                    INTEGER (-16..15)","paragraph_zero_based":24403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24404},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-POWERCONTROL-STOP","paragraph_zero_based":24405},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1e058df8d13bfd88b2ae588284c8e4d7eaa3a08125e58b1637abd76e590681ee","94ea5753f5ffa131795c191d43046604d169821c9c067fdd1e1e5a6b833c2bb5","c6a359c7205848087f60fb3f3a10480fd32c217db0173aefb9ee3d690886fac0","8fefdf4e232120e920a645b3f9a41c9a8d9c29100eaec9a5e396ba1ddd2dff3a","f077951b2855d6f40bf6541b56c5823defe4ddbb5b6d3500a79a9a47d3a12809","d9bc80e6dedbb8cf87c6a3d92849bb9c3a1473a2978155667cfb515f3aa960b7","6aa2978dc367598f099eaf49df9dc75a505cb6ebb8efe46df53d31274cc021e8","a76dc57cafe46f9cb5d0bc84cbd2d126c5b17e96d2e45e4306f40f18caa5c13e","1af16a75d1d223cc16ae2224b1127819e9b28127fa1d3f3db756b24ecc95add5","4c735a36b27c8792a85a50daa088d52720cd9b73742a30e3637398c854ee9d08","03fd4912f8cae7ed9eff3edc725c1ac21c4f91a66e7aa46d168c8461e4c8b477","b68db9f3f971e1f899a5f2fd5481cd1143d6539af9806328c1c1aa404e4e7dc1","fd898987ddab009c514f5223b312743deef8017e19c60a3554b8e9a65b415209","df2ab80ac8376accc4261c89f4d22e4379c343dac52e461453cac49397421350","67328ad8470c8b15806c8e76c10a3a8fcd4d23209e7490fd4d417cbf8e5fc940","9a8f779cd1085d932286ff3019c10ed582cc0a16eda9460b13c94f3bd94e7ca3","0505498846aeeba1ef5210d2f081d9db72b6f55ec4386ea5937fb606da49e4b3","237283e27f96035914e6a8a25b12466c5cee0c6d1fb0dd51ae885fb2729a9340","da0058de55c9e0e98fff1288162956c985502c4838ce229bb4f2f6710d2d7b74","f2ce97e5d5c36397add604800f98cdfdcc6e124c7bf5ab39e48d87c9ab565067","b52f55be4ec53c61a5f12461152bcadc00ed5da46488b169fa3da84fb8f1d39c","4e604964068db8827fa85afb9ac25971db7f6d8100c2042471b4316f2612877a","cdd94a5a0032fb83ec06dbd1a4feb60a05558fd763dfa4fcfa6c9cd522d04a76","7a665f5e6cae3cb11e86f236087a9d4f93993fc18013cd9945eb782fc41068a3"],"paragraph_range_zero_based":[24384,24407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"P0-PUSCH-AlphaSet field descriptions","paragraph_zero_based":24408},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":24409},{"literal_text_all_w_t_and_m_t":"alpha value for PUSCH with grant (except msg3) (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24410},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":24411},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3) in steps of 1dB (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 0.","paragraph_zero_based":24412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24413},{"literal_text_all_w_t_and_m_t":"P0-PUSCH-Set field descriptions","paragraph_zero_based":24414},{"literal_text_all_w_t_and_m_t":"p0-List","paragraph_zero_based":24415},{"literal_text_all_w_t_and_m_t":"Configuration of {p0-PUSCH, p0-PUSCH} sets for PUSCH. If SRI is present in the DCI, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and both olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 are configured to be 1 bit, then one p0-PUSCH can be configured in P0-PUSCH-Set. If SRI is not present in the DCI, and if any of olpc-ParameterSetDCI-0-1 and olpc-ParameterSetDCI-0-2 is configured to be 2 bits, then two p0-PUSCH values can be configured in P0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24416},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetId","paragraph_zero_based":24417},{"literal_text_all_w_t_and_m_t":"Configure the index of a p0-PUSCH-Set (see TS 38.213 [13] clause 7 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":24418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24419},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl field descriptions","paragraph_zero_based":24420},{"literal_text_all_w_t_and_m_t":"deltaMCS","paragraph_zero_based":24421},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply delta MCS. When the field is absent, the UE applies Ks = 0 in delta_TFC formula for PUSCH (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24422},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":24423},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":24424},{"literal_text_all_w_t_and_m_t":"msg3-Alpha","paragraph_zero_based":24425},{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for msg3 PUSCH (see TS 38.213 [13], clause 7.1). When the field is absent the UE applies the value 1.","paragraph_zero_based":24426},{"literal_text_all_w_t_and_m_t":"olpc-ParameterSetDCI-0-1, olpc-ParameterSetDCI-0-2","paragraph_zero_based":24427},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for Open-loop power control parameter set indication for DCI format 0_1/0_2 in case SRI is not configured in the DCI. 2 bits is applicable only if SRI is not present in the DCI format 0_1. The field olpc-ParameterSetDCI-0-1 applies to DCI format 0_1 and the field olpc-ParameterSetDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11).","paragraph_zero_based":24428},{"literal_text_all_w_t_and_m_t":"p0-AlphaSets","paragraph_zero_based":24429},{"literal_text_all_w_t_and_m_t":"Configuration {p0-pusch, alpha} sets for PUSCH (except msg3 and msgA PUSCH), i.e., { {p0,alpha,index1}, {p0,alpha,index2},...} (see TS 38.213 [13], clause 7.1). When no set is configured, the UE uses the P0-nominal for msg3/msgA PUSCH, P0-UE is set to 0 and alpha is set according to either msg3-Alpha or msgA-Alpha (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24430},{"literal_text_all_w_t_and_m_t":"p0-NominalWithoutGrant","paragraph_zero_based":24431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["71ef40894da3c91136eec0724547e708215bda53b5ccc655e6fbe69b7604de97","2a6998ebd5d5e7d1fb46d87a2fe8cfaf0759216fbe9dd3ae4b1061bb50b4ca0d","7a397b5175d1af4b1ba32da0876a9a24ea0514965ba81db4dd8fcca52d7711d2","352c259523cd63b2c4d520c7b3fd65e6358bdff9076a0b63b470a92b49ddb7eb","d9df308e039118183a51ccacfdf8710cd8d296329d1ba9fe1263ac4d060798d5","ae3683e6b5b981c265be8486d12cf72e5a38059490dfb6ae79cf94047f934798","c6fe7301993d23e1883661b94adb1af72129e646f61d88e25d90ab791f92ce0d","911947be33e952e28bfdf64be728c702fcedd11a483d7192f3749f059e9a0aac","68c90afc63c77da87a6a0a6cfb4047038ad16e27b9ce2548b65e4829544a9b82","4158b433f0496ca161e28befb333537e37b9d12b2cee3f6cf13ace8d5fa39fe1","a1a37d4a6c8b9621ea101083a766362d2a001b796fad394b640eceda3faa72f0","5b05eca17b7d9155b01789fb503531700924cfe3acdb01b9d45799ba196e7811","7e1e604582e95ce2ae4c579ea1d9f62beb797624e34acac577f9e639673fd9c8","fe20f07e69e142b70fbb31e0b9af040ca1bd22a310d27b9aea29eb0a7391381f","b24606af087dea791faec1b62c3c3529f44d2a1528dc649437232307dc569649","52f453f95419b69d16d73a1438d8b931b481c13c9d76c00653376bebf70dc62f","272a9276c54983dcc875b3b93e16f2578901412db9fcc3e7d92c23c9b945d10b","a2190627f10082eb52648b084d1566680325a9842a0fbdb509efec29ba73e517","c3608e7df55526abd15b0ec9a5ea5cc0b80eb7b03ec9893dd18504da5de0628e","c218f261abc5145bbd7b7f50171c88167197cdafdd94465fc071c9d7cc02fb8a","61c5364e5c8f058ea15e2156e293e8f3e24f82d82677d9dcc0a0f3f89aa08c0d","7303689dba125d8f0b14330034d4df3a6599e43cc72bd5ea9b924dc2360a2852","99bf0655ba7ab753bf131e33d2fce85107d35d1ba569120612fba21fc4d06206","53121ed029aec0791960026525a2b441109d01b11e57df85a1ed485c1b7d4bf4"],"paragraph_range_zero_based":[24408,24431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24408"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"P0 value for UL grant-free/SPS based PUSCH. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24432},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList","paragraph_zero_based":24433},{"literal_text_all_w_t_and_m_t":"Configure one additional P0-PUSCH-Set per SRI. If present, the one bit or 2 bits in the DCI is used to dynamically indicate among the P0 value from the existing P0-PUSCH-AlphaSet and the P0 value(s) from the P0-PUSCH-Set (See TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 17).","paragraph_zero_based":24434},{"literal_text_all_w_t_and_m_t":"p0-PUSCH-SetList2","paragraph_zero_based":24435},{"literal_text_all_w_t_and_m_t":"For indicating per-TRP OLPC set in DCI format 0_1/0_2 with the legacy field, a second p0-PUSCH-SetList-r16 is used. When this field is present the p0-PUSCH-SetList corresponds to the first SRS resource set (see TS 38.213).","paragraph_zero_based":24436},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList, pathlossReferenceRSToAddModListSizeExt","paragraph_zero_based":24437},{"literal_text_all_w_t_and_m_t":"A set of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for PUSCH path loss estimation. The set consists of Reference Signals configured using pathLossReferenceRSToAddModList and Reference Signals configured using pathlossReferenceRSToAddModListSizeExt. Up to maxNrofPUSCH-PathlossReferenceRSs may be configured (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24438},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToReleaseList, pathlossReferenceRSToReleaseListSizeExt","paragraph_zero_based":24439},{"literal_text_all_w_t_and_m_t":"Lists of reference signals for PUSCH path loss estimation to be released by the UE.","paragraph_zero_based":24440},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList","paragraph_zero_based":24441},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24442},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-MappingToAddModList2","paragraph_zero_based":24443},{"literal_text_all_w_t_and_m_t":"A list of SRI-PUSCH-PowerControl elements for second SRS-resource set, among which one is selected by the SRI field in DCI (see TS 38.213 [13], clause 7.1). When this field is present the sri-PUSCH-MappingToAddModList corresponds to the first SRS resource set for PUSCH.","paragraph_zero_based":24444},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":24445},{"literal_text_all_w_t_and_m_t":"If enabled, UE applies TPC commands via accumulation. If not enabled, UE applies the TPC command without accumulation. If the field is absent, TPC accumulation is enabled (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24446},{"literal_text_all_w_t_and_m_t":"twoPUSCH-PC-AdjustmentStates","paragraph_zero_based":24447},{"literal_text_all_w_t_and_m_t":"Number of PUSCH power control adjustment states maintained by the UE (i.e., fc(i)). If the field is present (n2) the UE maintains two power control states (i.e., fc(i,0) and fc(i,1)). If the field is absent, it maintains one power control state (i.e., fc(i,0)) (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":24448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24449},{"literal_text_all_w_t_and_m_t":"SRI-PUSCH-PowerControl field descriptions","paragraph_zero_based":24450},{"literal_text_all_w_t_and_m_t":"sri-P0-PUSCH-AlphaSetId","paragraph_zero_based":24451},{"literal_text_all_w_t_and_m_t":"The ID of a P0-PUSCH-AlphaSet as configured in p0-AlphaSets in PUSCH-PowerControl.","paragraph_zero_based":24452},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-ClosedLoopIndex","paragraph_zero_based":24453},{"literal_text_all_w_t_and_m_t":"The index of the closed power control loop associated with this SRI-PUSCH-PowerControl.","paragraph_zero_based":24454},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PathlossReferenceRS-Id","paragraph_zero_based":24455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["28baed12e4e62e6992d94be07752d396c7da103dbe184e6645559fc9674941c1","91c23ec9af65ded20afed78e99d698afd5d1cbc9a84da7700feffa17bd698d36","d37da02eaf051e3f6b25d0a08fc6c271defc0be432f4a5b665b806d103b2d19e","66d888e29823ee1ab130c1823a4d150efff50252d0ca41e5176f7ae6eef86ef2","bc2524da2da38ef348deea363827146d6bc2908d97a741bb00ea436a09e9dafb","63b4c45f4e6eeb53fda02e4435bee3cdfd01c9b2e60beab1b105a664e5404a06","578cd0be62f07bf701dfd2e49f9db54a8a4a097e32451791471b947f8f7a82fc","9cd804a2e6721264e44434175b4aa3ea8286597001de2eae5830b66c7cecd16b","ba2266048dae6adab5e09b3dcc7ba64c04485e21aa6fa7cf90138ed7bbe3d535","e61c4848a75f010727a6b89090bda0518c0bc5e980752277458c85879febc8ee","8ce59784230df25b914c7379b592a1d2e837e618429de0df341636ab3d792ece","5da042f798b14227661e87298a638f49a1889c515f618d4f17a459e8e9f6b310","89d3bc4ddddfe53ce1646d69aa4aef386d2ef4bf7acba4d3264848607eb24377","7550c86aaf3f88a96fa292042d69ae86e65c8eb997af0931961f110cb9c29116","99de1631cbf8b59758a79d56698b824cc06a6a3836d1eb46e8358efb5c14c38f","34a8c0a8e150e4785202c4646740d9d19ff560124492b9805af5f73d7aabb0bb","59fda2075326a4cd33af0ea77ed1b438a76b147eeba4a51447c14a9b65b5fad3","079934641b7a0656d14c75f211926e211ce97d7d30f583a128e81df2e36f4a13","1d58418e451d96cf6bb01587f76d984166b83301417d122edf6c84bffb51d56a","e151c9803f8f2511389f418ed8580ba8ceb09728b2b291738fc5943209dc6b06","5b1a264d099738334d1465d3bf12ed7b9742d3ff16552184eb0250e7bb724bab","ddbc62efd76034a8f5856e18f2e511af9b441985320199f9b5b9e7b86b2e384d","46a323c6b4bd4d42f2c40643df1e837c7cebd8836769aa36826079be02541406","c511858bfd9536376423dccfb08a86a9c181855d759c757f871576ed9014c3e3"],"paragraph_range_zero_based":[24432,24455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24432"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The ID of PUSCH-PathlossReferenceRS as configured in the pathlossReferenceRSToAddModList in PUSCH-PowerControl.","paragraph_zero_based":24456},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PowerControlId","paragraph_zero_based":24457},{"literal_text_all_w_t_and_m_t":"The ID of this SRI-PUSCH-PowerControl configuration. It is used as the codepoint (payload) in the SRI DCI field.","paragraph_zero_based":24458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24459},{"literal_text_all_w_t_and_m_t":"–PUSCH-ServingCellConfig","paragraph_zero_based":24460},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ServingCellConfig is used to configure UE specific PUSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":24461},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig information element","paragraph_zero_based":24462},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24463},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":24464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24465},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":24466},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PUSCH-CodeBlockGroupTransmission }       OPTIONAL,   -- Need M","paragraph_zero_based":24467},{"literal_text_all_w_t_and_m_t":"    rateMatching                            ENUMERATED {limitedBufferRM}                            OPTIONAL,   -- Need S","paragraph_zero_based":24468},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED {xoh6, xoh12, xoh18}                         OPTIONAL,   -- Need S","paragraph_zero_based":24469},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24470},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24471},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..4)                                          OPTIONAL,   -- Need M","paragraph_zero_based":24472},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                 OPTIONAL    -- Need M","paragraph_zero_based":24473},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24474},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24475},{"literal_text_all_w_t_and_m_t":"    maxMIMO-LayersDCI-0-2-r16               SetupRelease { MaxMIMO-LayersDCI-0-2-r16}               OPTIONAL    -- Need M","paragraph_zero_based":24476},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24477},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24478},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPUSCH-r17          ENUMERATED {n32}                                   OPTIONAL,   -- Need R","paragraph_zero_based":24479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8ed3fe1e1af18f996d6a3542e3e4bb842dd30627befc9cc773523ba646c5f095","0710fdb31a120fe12d54010da9c2bdc50f4975e9c07afe6629bb36e5b2eb5be7","85b7f5e45ddceaf48f521a714fe0b6b80569dbff81da5449f8fb6a0ce72607ec","7aada54a16ecaa1918a5cacba7813bcd39ae3195919f29d9cab371974916b22a","2f4c42974098cb79ed1796edc772811afee033b09cf59b34c27eb0bdb0f95eff","c6fbf8644e51168584250d12736ed2a143984d48dee53572d904c680d5803384","fe5edecde3d64a3c9dacbd39723490a555bb7ad681c0786376d4fc91f922a8ae","0783fe4e