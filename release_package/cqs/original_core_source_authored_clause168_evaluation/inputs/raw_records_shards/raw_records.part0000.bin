{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":29664},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":29665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29666},{"literal_text_all_w_t_and_m_t":"–TCI-UL-StateId","paragraph_zero_based":29667},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-StateId is used to identify one TCI-UL-State configuration.","paragraph_zero_based":29668},{"literal_text_all_w_t_and_m_t":"TCI-UL-StateId information element","paragraph_zero_based":29669},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29670},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATEID-START","paragraph_zero_based":29671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29672},{"literal_text_all_w_t_and_m_t":"TCI-UL-StateId-r17 ::=              INTEGER (0..maxUL-TCI-1-r17)","paragraph_zero_based":29673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29674},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATEID-STOP","paragraph_zero_based":29675},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29677},{"literal_text_all_w_t_and_m_t":"–TDD-UL-DL-ConfigCommon","paragraph_zero_based":29678},{"literal_text_all_w_t_and_m_t":"The IE TDD-UL-DL-ConfigCommon determines the cell specific Uplink/Downlink TDD configuration.","paragraph_zero_based":29679},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon information element","paragraph_zero_based":29680},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29681},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGCOMMON-START","paragraph_zero_based":29682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29683},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon ::=          SEQUENCE {","paragraph_zero_based":29684},{"literal_text_all_w_t_and_m_t":"    referenceSubcarrierSpacing          SubcarrierSpacing,","paragraph_zero_based":29685},{"literal_text_all_w_t_and_m_t":"    pattern1                            TDD-UL-DL-Pattern,","paragraph_zero_based":29686},{"literal_text_all_w_t_and_m_t":"    pattern2                            TDD-UL-DL-Pattern                                                       OPTIONAL, -- Need R","paragraph_zero_based":29687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["df058774b6a2de0634d2b4fc854b37b2d8a61744e3b96eaa5538a3c427d66665","de145f1390b85767714a96d2e93cedb7a1a0fc15a8d6521a2317b47d532cb5b7","c011cb51b32e7d0974c8615b1d6c8cc74a79346afac4a0ccd8a6bd3b2ce9134b","407c9de2d7f4af9db9ef3bbb300f6a7d74fdf8b57fa2886dec81b5e9e8d0185c","784ed0401357f60ad684f51be38770a6d573f26735a35defb899b6e6d666cbb4","051a45684d88f77578c614288a3e49f30c43bd32f9c3a1bb2fd6d78fdc0b4445","ed4de18283a004b631716e95e96a21c90f0bbd6f244ed7953260ac91b0cc35a4","6239b4ddc648bb8d1a49885940adda2dca9f7b66875dd88148f77cd54633649e","95f95bc334274863d3da67eed44220656471ab7b6f65aa6927aeeb6acf07764f","ed6015cb0f02033a3a00a0b2d5710100776d0276d413af278c8cad33f27f604c","91d77d4ac685c45b0b16b64e3977e3f38200ad63c1d3c8e105498fdd0b0959c7","15917bab20f3e5740a2e4eb6ec920d86913ea3593da2395fbd4cb98b00ab3134","87c6f24ce976f9f86d927a9eecb437eece73fae788bac679c63545bacbb78afe","e2e231f4ce401fe8ae53a9acc1a452ddd56c01e033b3f45e3785d006108d0ec7","b57c09e08d756b041b6ddb14e78e149c53f750b49c2c6a9c711f0843fe710048","cdd7b6e03cf082aaa5d9be32e441c401aae8361a727d1d33b89c434c2bd6377d","bcf586446d4beb2bdc14e78781711c2264e9c42a0c5bf94d82cf4ee7bd4a7e12","a6e871878b333dc779c01544bde792e06de1c18cffb1665b4dbcee30eb866e09","8aab2620dbd01544e9a880865cbab7a8be19adbf5e798524d53ae0787b8cc558","363cf33064b4599f50cae0f7a3a00ed343631e1649a24e096b28355e6f04e54d","68cc978a638d2a3a0e23ded8804580f11ff363a1716f0233d91df85b7c621408","c4700d3b3d19f88c2fa6afcdc244b6db1e4875bd2ad67f7fa4fe467c1f0ba88c","9cbbfad21e53e178ccf18af5dd10a81bc2bf47a869188d874cc2bb277b9fbf0b","349ffcd1700c1a96e2b4b005bec76a6d512d6121ebc04849b4f37aa66ac0e466"],"paragraph_range_zero_based":[29664,29687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29664"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29688},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29690},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-Pattern ::=               SEQUENCE {","paragraph_zero_based":29691},{"literal_text_all_w_t_and_m_t":"    dl-UL-TransmissionPeriodicity       ENUMERATED {ms0p5, ms0p625, ms1, ms1p25, ms2, ms2p5, ms5, ms10},","paragraph_zero_based":29692},{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSlots                   INTEGER (0..maxNrofSlots),","paragraph_zero_based":29693},{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSymbols                 INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":29694},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSlots                     INTEGER (0..maxNrofSlots),","paragraph_zero_based":29695},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSymbols                   INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":29696},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29697},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29698},{"literal_text_all_w_t_and_m_t":"    dl-UL-TransmissionPeriodicity-v1530     ENUMERATED {ms3, ms4}                                               OPTIONAL -- Need R","paragraph_zero_based":29699},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29700},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29702},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGCOMMON-STOP","paragraph_zero_based":29703},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29705},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon field descriptions","paragraph_zero_based":29706},{"literal_text_all_w_t_and_m_t":"referenceSubcarrierSpacing","paragraph_zero_based":29707},{"literal_text_all_w_t_and_m_t":"Reference SCS used to determine the time domain boundaries in the UL-DL pattern which must be common across all subcarrier specific carriers, i.e., independent of the actual subcarrier spacing using for data transmission.","paragraph_zero_based":29708},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":29709},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":29710},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":29711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dc711e89288bfdc6238feba3972a178b87a64803d73c213bfbb6e938acf61099","51c62c2f8e1187f02ca1c311c57becfee96aacd131cbfc06e94c299c7c1ee52c","468eff66c94b925b4335b7fc8fb8206d81382364195baeebe02799e623a0aefc","81b3bc3675b25ea0ab1a099d36b90b1d9d184e2f35e985163bcdd87d4f58b396","c9f0b8371fe6a1819036a9a93c0d6f52df952a41e38bf0b33d1d49a0a6f18464","a8d08c8f03b53ac89350a7f47be83c4e613a861735bddb61de7bb316d1faae1c","9faed717dd47be4587bdbb70f5da2c0c26cbf0ebce28fb1ca476e706296c0354","4e4ec6d9361b1d3510a9c281ef7561f7263762fc16942e3f4981a63df4fe32f4","308d07bb44f2ff7faba681afcd04005746fa789e3f972663be6bf1849a76fa7b","c3bc4cabc4812929331b2e544377e810071243cb3bfb7dfca057426e4391bbd1","31776cdaf5b6d895d0bdd66da67d2026696fb37376b889f4b90ed3d087712858","13910a677fae2d9b9cf90962d7ba70634b12bfe692ae068317f584f835cbe6f1","5b859ccb1c8768c1fdd29d1cbf817e7e1db88fb25dc3165e80737a7dde0652ed","27a394f57c8c57e202b176435c1b539fdd0266bbeca618a12d4af9e3693f1b85","cdb64abaa9030c175c29f6e333c014c622c2449293f33d25188a7c1db7ebc580","1acc467b38a12869a8ffc7446612d0d7fe23aeebf41646b73ba950116c1c09b3","1e4a0e8c1a62c454339e09f7d530b7ff3d2208525dd403903c97dc3d92778754","2cabbc40c363ba8b4b6d3dfec16198ec9c2403ea81ca15a2078f680d9825a054","d2b4fc49a4f167cde10310d0f953e7cc6bb27450262b10fc41743f3dda1a162c","60ee2c3f9a72e2fc3de8253813ef910c81df5b59429e5b2256e5eee4a1ac1063","4c3aafcaf0bf5d920aa92295b2ad0207cb3757cc7a80e301fc9a332f9be232a9","bde0679bd143082fbd8d94c827a585e3d53e0d32a6908ffb093e7d6a035f10d4","3eb094986766e863300d27d6994ce08e57b0b6a9f82b3ff9836eded3cbb4a6bd","974baf7ea381207fac3402768f9f2538e0cfd87d757390bd6d7bdfc6de416374"],"paragraph_range_zero_based":[29688,29711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29688"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":29712},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29713},{"literal_text_all_w_t_and_m_t":"The network configures a not larger than any SCS of configured BWPs for the serving cell. The network or SL-PreconfigGeneral configures a not larger than the SCS of (pre-)configured SL BWP.See TS 38.213 [13], clause 11.1.","paragraph_zero_based":29714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29715},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-Pattern field descriptions","paragraph_zero_based":29716},{"literal_text_all_w_t_and_m_t":"dl-UL-TransmissionPeriodicity","paragraph_zero_based":29717},{"literal_text_all_w_t_and_m_t":"Periodicity of the DL-UL pattern, see TS 38.213 [13], clause 11.1. If the dl-UL-TransmissionPeriodicity-v1530 is signalled, UE shall ignore the dl-UL-TransmissionPeriodicity (without suffix).","paragraph_zero_based":29718},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSlots","paragraph_zero_based":29719},{"literal_text_all_w_t_and_m_t":"Number of consecutive full DL slots at the beginning of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":29720},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":29721},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot following the last full DL slot (as derived from nrofDownlinkSlots). The value 0 indicates that there is no partial-downlink slot. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29722},{"literal_text_all_w_t_and_m_t":"nrofUplinkSlots","paragraph_zero_based":29723},{"literal_text_all_w_t_and_m_t":"Number of consecutive full UL slots at the end of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":29724},{"literal_text_all_w_t_and_m_t":"nrofUplinkSymbols","paragraph_zero_based":29725},{"literal_text_all_w_t_and_m_t":"Number of consecutive UL symbols in the end of the slot preceding the first full UL slot (as derived from nrofUplinkSlots). The value 0 indicates that there is no partial-uplink slot. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":29726},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29727},{"literal_text_all_w_t_and_m_t":"–TDD-UL-DL-ConfigDedicated","paragraph_zero_based":29728},{"literal_text_all_w_t_and_m_t":"The IE TDD-UL-DL-ConfigDedicated determines the UE-specific Uplink/Downlink TDD configuration.","paragraph_zero_based":29729},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated information element","paragraph_zero_based":29730},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29731},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGDEDICATED-START","paragraph_zero_based":29732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29733},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated ::=       SEQUENCE {","paragraph_zero_based":29734},{"literal_text_all_w_t_and_m_t":"    slotSpecificConfigurationsToAddModList      SEQUENCE (SIZE (1..maxNrofSlots)) OF TDD-UL-DL-SlotConfig       OPTIONAL, -- Need N","paragraph_zero_based":29735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b60209eb0dade6fe7b2eee7e78bb8a8b49d42cb8b44836ae1072fe683918221f","2917e4edc5dea646b9bbcbbd3b46501ec898420930c5308abdf34b8857579cde","6ac365454bfe3738a70e8ed1b04febbe32488df