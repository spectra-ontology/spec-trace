{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    bm-MaxNumberAperiodicCSI-RS-Resource-r17 INTEGER (0..64)                                       OPTIONAL,","paragraph_zero_based":44304},{"literal_text_all_w_t_and_m_t":"    cg-MaxNumberConfigsAllCC-r17             INTEGER (0..32)                                       OPTIONAL,","paragraph_zero_based":44305},{"literal_text_all_w_t_and_m_t":"    maxNumberCSI-RS-BFD-r17                  INTEGER (0..64)                                       OPTIONAL,","paragraph_zero_based":44306},{"literal_text_all_w_t_and_m_t":"    maxNumberCSI-RS-SSB-CBD-r17              INTEGER (0..256)                                      OPTIONAL,","paragraph_zero_based":44307},{"literal_text_all_w_t_and_m_t":"    maxNumberSSB-BFD-r17                     INTEGER (0..64)                                       OPTIONAL,","paragraph_zero_based":44308},{"literal_text_all_w_t_and_m_t":"    sps-MaxNumberConfigsAllCC-r17            INTEGER (0..32)                                       OPTIONAL,","paragraph_zero_based":44309},{"literal_text_all_w_t_and_m_t":"    trs-MaxConfResourceSetsAllCC-r17         INTEGER (0..256)                                      OPTIONAL,","paragraph_zero_based":44310},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44311},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44313},{"literal_text_all_w_t_and_m_t":"-- TAG-RESOURCECONFIGNRDC-STOP","paragraph_zero_based":44314},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44316},{"literal_text_all_w_t_and_m_t":"ResourceConfigNRDC field descriptions","paragraph_zero_based":44317},{"literal_text_all_w_t_and_m_t":"fr1-ResourceConfig, fr2-ResourceConfig","paragraph_zero_based":44318},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of resources that SCG is allowed to configure for FR1/FR2, respectively. ","paragraph_zero_based":44319},{"literal_text_all_w_t_and_m_t":"maxNumberResAcrossCC-AcrossFR","paragraph_zero_based":44320},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of configured CSI-RS resources. Corresponds to the UE capability maxNumberResAcrossCC-AcrossFR-r16 in maxTotalResourcesForAcrossFreqRanges-r16.","paragraph_zero_based":44321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44322},{"literal_text_all_w_t_and_m_t":"ResourceConfigPerFR field descriptions","paragraph_zero_based":44323},{"literal_text_all_w_t_and_m_t":"bm-MaxNumberAperiodicCSI-RS-Resource","paragraph_zero_based":44324},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of aperiodic CSI-RS resources that the SCG is allowed to configure for the UE to measure L1-RSRP. Corresponds to the UE capability maxNumberAperiodicCSI-RS-Resource in beamManagementSSB-CSI-RS.","paragraph_zero_based":44325},{"literal_text_all_w_t_and_m_t":"bm-MaxNumberCSI-RS-Resource","paragraph_zero_based":44326},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total number of NZP-CSI-RS resources that can be configured for the UE to measure L1-RSRP. Corresponds to the UE capability maxNumberCSI-RS-Resource in beamManagementSSB-CSI-RS.","paragraph_zero_based":44327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5ddb76193d81e6d70acc979c5a39d47b3318cdb545d120501f2315b43366e8a9","215e76fe5e7d920e4a5e43f0d50b14ba2da3952bc0933c13e726c584a7e06e20","09415eb276ddb79d5e40be351377253239ea738b76231d2e49c8395b2d68438b","9e7