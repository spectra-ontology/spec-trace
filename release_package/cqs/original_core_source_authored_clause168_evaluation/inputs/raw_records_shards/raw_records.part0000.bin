{"fields":{"filename":"R2-2305363.zip::R2-2305363 Correction on PosSRS-RRC-Inactive-OutsideInitialUL-BWP.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"NR Standalone, NE-DC, NR-DC","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Inactive UL positioning","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to this CR while the network is not or if the network is implemented according to this CR while the UE is not, there is no inter-operability issue.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Incorrect understanding of the values for IE maxSRSposBandwidthForEachSCS-withinCC-FR1-r17 and maxSRSposBandwidthForEachSCS-withinCC-FR2-r17.","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"6.3.3","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragr