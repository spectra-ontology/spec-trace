  ...","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"                            }   OPTIONAL,-- Need OP","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["be24a34447bd2446cb56946875d86610479b48896a50e384cf4c9469bd91701b","ef2551acd877d4ee0bd6d5242766813980adf4cbb67d101e3d9f4eb64686a203","9f791f35b777c6aad081508cacb911b1e495ac6f5bb3bcc8ab162fd6ed04b982","edc44bf539839cbe4e5fcf318af68130d000b8ce7190b2ff2f8f6059034705e6","5b6c208433cbcde125afd750fc60e347552ec3aa682e0f8ce209275178a6b947","6fe45dbd7170a9f29d0ce4ddb3526b5eba5f051b6b524a06292135c715f91f39","c6596252ee3520c1ed3cf64fc704b12afa252ed3b4478d173e5a70ea48eacade","fdf84af9bd017589ba2958c0f75d68f2d4863ca88c029b4aa9be27752e521640","59934517c2bb058eed5032d8033b229481292c812d314010f9d85b39d3217f76","cde5c9214caaedead165ff8f484185678a96d61e8b5fdc819e52f742c17d4115","f25a72c455dd1c3b9fda8352cb51f68d3ca164544d7cab13f98ed2a2e27110fa","12568048cb0860b42d991d468202232e2d8b7f6e1a81639891382e4e4cbd4830","864b9a79f03a8cb1aca65a7bca6147caec00c71c54a896e0b39191fa6a764921","fca8056d8015ba3536ffba3335e3c82954c6c158661083661bc8331d9e9697c4","133ddd4ddfd6c8a7bce173df06c4cdf8b607aa2d87168b9b43d66a734c53e505","08ea0bf97769b068e57ab2755f1bf0b4712e0c9233eb76afdf32c66d54f95a66","10c8ff1802cc578057f186632df3e62f81ef076836800bab1a2b7234601382aa","682475b12d85087750a1badb5c9f7cee81beea06ecaebd6ae406c8f2eb1c10ed","7ec8635e05508eb60009282efeb6eada01ccf8bec58a27000dae73fb02dedcef","e23b22f63f8cfe29740389dac7c71afed77e0581392ccef9a7c142ac3c86ba97","65924d0a5c1fdf496b6aed832514b69ff21870baf71bcc9da4ee6f4a58fcd3dd","a7d407475d8dbc2ccca738d1e6c61c77135a8e4c38e57bd02c3bb59cdcfd47e5","449eebf27d87cf652eaab9828e5daaeceb5cf88d371b24447c2dbfd1e754dfdf","34b100caff61e84750514b0f68761723cb4260df34c3e7c05535c0d1506f3c3a"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306537.zip::R2-2306537.docx:p240"}
{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"StepElement-r18 ::= ENUMERATED {n1, n2, n3, n4, n5, n10, n20, n50, n100}","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"3D","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"This field is present if a 3D grid is provided; otherwise it is absent. gridList.","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-GridPoints field descriptions","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"gridPointsSetID","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the LOS-NLOS Grid Point set. It is a regionally unique arbitrary number that is used by the UE to ensure that the LOS-NLOS indications are being applied to the correct set of points.","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"referencePointLatitude","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"This field specifies the latitude for the reference point, expressed in the range of -90° , +90°, coded as a number between -224 and 224-1, coded in 2's complement binary on 25 bits. The relation between the latitude X in the range [90°, 90°] and the coded number N is:","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"N=X90∘224","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"where  denotes the greatest integer less than or equal to x (floor operator).","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"referencePointLongitude","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"This field specifies the longitude for the reference point, expressed in the range -180°, +180°, coded as a number between -225 and 225-1, coded in 2's complement binary on 26 bits. The relation between the longitude X in the range [-180°, 180°) and the coded number N is:","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"N=X180∘225","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"The reference point defines the northwest corner of the grid point array.","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"numberOfStepsSouth, numberOfStepsEast, numberOfStepsDown","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"These fields specify the number of steps for south, east and down direction respectively.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["5f4f24b79df573bba4dde707c81ddfdfc5d3ca859d231dacf170247defeb6a61","addfa12ecd0413e31ea246e484b9b906f1617dd8c25cc374fbd8a15a62db2527","dc5e42cac6748cd2d0d7907b114058dfe54acc90c3fa622a8478d5228ad683f1","93c04b200414cb10d4f602932be7a39d8808efdd7f98f94b927d2e229fbb465b","87bcdca4b68deb1a1b5a8fdd5ba1334e4b06a4f2e68623b7b6217ca283770d82","6c9ccdcbfbd3715fd1b8069414c2f4597a6f66fb4903d0282b041cc3c2c43dae","0fd8ce754a596ae4782c476a7a88088cf5b7c96794f08b90c7ad187baaf520eb","bb5efdc95fdf29cedbe36667a13b9d64a5d64d2875b9d9423a06b23934fcead0","9c03175ac5e5fe45899326fb4bdee5578b8d40391d598c246d0c338b6d633fc6","5b601c4d1a03dec5134e4a241dfca505126ac0a7dce8b0257e81e0d05b65df92","8011a772621433c2ed37b23c060547e8f2bf8b5f444981510ccb588093ba2cdc","d24a453f2b42fb71fc38b0b93984e307e517ff5231c73477ea6eb1ee3c01e872","143afe31c1089e358b6e4651db826755bc6c7c7e2ab7e89896a72a711889cead","221866e346fe63b26f48348d2cf45c6ceb55ff5a633482f42dc03bc9af1adc19","525904cae6b30e4df44634215e52d25749b5c4de2f918db121c17c0862c23f87","c88020e6faf3e9db7010b6fba3528613ad2bd08efa86d13ac10a81a23186b772","0d23e19f88fc074217234db11e0528d5f49aa968c97425f46b359dab4ad383b8","20ea4f51703bafa4ba7d01a818f93926639e6be79f0e95a87643fcee9c9f73d9","1a9833f1a232ee945d8d9bac4e7b1bff097cc3fa00511440dfe6a9a879fd016d","adc45c4bf5fd9beed1fbec874623e9ba436ee4f1154e136f3d68f1f88712895c","2e8137282255ab45d25ba55945555af378583f79c6404c68e800c182cd1c7d26","07a521a1396469187ac12634f0776bcbc3cfa95f829c68b1b22d0517e5b7b6d4","2360cd96371777bea76374fbc71826f585af60c55d898338308847f35dcff7bc","112d28c81a06ed1e988f0be857746139ede7d46df94da05705962011d51d2e2c"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306537.zip::R2-2306537.docx:p264"}
{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"stepSouth, stepEast, stepDown","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"These fields specify the spacing of the grid points for south, east and down respectively. The values  n1, n2, n3, n4, n5, n10, n20, n50, n100 encodes 1, 2, 3, 4, 5, 10, 20, 50, 100, meters respectively.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"bitmaskOfGrids","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"This field specifies the availability of grid data at the horizontal grid points in the array, and applies to all altitude layers of the grid. If a specific bit is enabled (set to '1'), the grid is available. Only the first (numberOfStepsSouth+1)×(numberOfStepsEast+1) bits are used, the remainder are set to '0'. Starting with the northwest corner of the array (top left on a north oriented map) the grid points are enumerated with row precedence – first row west to east, second row west to east, until last row west to east – ending with the southeast corner of the array. If the field is omitted all grid points are used and none omitted.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"If this field is present and ","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"           - the field referenceAltitudeCoarse is also present, it provides the fine resolution of the 3D grid altitude of the upmost layer.","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"             the field referenceAltitudeCoarse is absent, this field provides the altitude above ground level of the 2D grid with a scale factor of 1m. If the field is absent, the default value is 0.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"referenceAltitudeCoarse","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"This field is present if a 3D grid is provided and specifies the coarse altitude, scale factor 10m, of the upmost layer of the grid relative to the WGS84 ellipsoid. If this field is absent, a 2D grid is provided, valid for ground level.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"upperValidityStepAltitude","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the upper validity altitude relative to the grid upper layer altitude, indicating that the data associated to the spatial grid is valid for device altitudes up to the upper validity altitude. The upper validity altitude is (referenceAltitude Fine + 10*referenceAltitudeCrude + upperValidityStepAltitude).","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"lowerValidityStepAltitude","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the lower validity altitude relative to the lowest grid layer altitude, indicating that the data associated to the spatial grid is valid for device altitudes down to the lower validity altitude. The lower validity altitude is (referenceAltitudeFine + 10*referenceAltitudeCrude – numberOfStepsDown*stepDown- lowerValidityStepAltitude).","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"-GNSS-LOS-NLOS-GriddedIndications","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GriddedIndications is used by the location server to provide GNSS LOS_NLOS indication information. The parameters provided in IE GNSS-LOS-NLOS-GriddedIndications apply to all GNSSs.","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GriddedIndications-r18 ::= SEQUENCE {","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"gridPointSetID-r18INTEGER (0..16383),","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"expirationTime-r18UTCTimeOPTIONAL,-- Cond NotAlreadyProvided","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"gridList-r18GridList-r18,","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["d723d27ebc77eef4152972b785581b7a1ecd7b03d3aa8d7242ed034a22532ed9","a286dcecb6211b60d86868edfddd68c19bea037904ca05403e44459cd168e579","fb119e3da2c8dba23e2bf057957d713a05b7957845007c2d0f797f00b3d50230","dab23e49058f2f90ebd4cbefe6c9e68faafa68cdbb6dca6387f3c3221a9f9a60","65562478bc51479a7d64802faf20bc759c4e482d549ec26e5ea0705d614482c9","29068fd4e469dc38ffdbcc4314cb5386e1d096fde59e916b57ac735bdecf6fe4","77116ecb63c83c1e473186fd83d8f3d763ebdc5e06bc552e5ed6a0e3f2ce0c0f","a9743fb20c608498353cc0740314e21f65a84f2b96921879e878fa0ba256a260","0864f8c06a8a5a0aa16a580760d60bfd66595a83eebf61791b7af097668de7b0","b8ea74dcca177cb1ac60e8ef360072bde1d709fe1c443382857aaf9a53709c66","33ba5e0c043f49e414f1a0299332a81787b071949aad4f17f3b74d2551648ea2","650056a2dd6bb0e9e24aeb003b89d62cdbabc0e290753d94288dc80bd09ab7fc","58b06f757bf162fe9b71d54e3e2f0242eb0dc31d9866a1d8667ccd4dd440f974","8d903b831784c3b71e8b66e56c782dc4f91b01980d4050f8c7ca746ffacff1bc","cf9fdbcfad8da3a49422d4dba05606990f58383fbd19e0225016c2893a6cca60","5c0b387a015e65859ef3d284e669601dd6a5c9e0358255aee5c4cdf941df5f5a","ce90700101a6c13ada89e142d3ce4e5acd4d2b27700f6b4824c449594908b01d","17c33a77d6bed45d8665afff270e880c8c17e536a36af50984bf8c436f5ea26c","52cd216b65b88195c40b1336c64db6467d015e4225eab2ad4a850d0ae924fe87","3