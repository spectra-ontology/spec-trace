{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–HysteresisAltitude","paragraph_zero_based":18888},{"literal_text_all_w_t_and_m_t":"The IE HysteresisAltitude is a parameter used within the entry and leave condition of an altitude-based event triggered reporting condition and within altitude range based parameter configuration. The actual value is field value in meters.","paragraph_zero_based":18889},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude information element","paragraph_zero_based":18890},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18891},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-START","paragraph_zero_based":18892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18893},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude-r18 ::=                      INTEGER (0..64)","paragraph_zero_based":18894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18895},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-STOP","paragraph_zero_based":18896},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18898},{"literal_text_all_w_t_and_m_t":"–HysteresisLocation","paragraph_zero_based":18899},{"literal_text_all_w_t_and_m_t":"The IE HysteresisLocation is a parameter used within entry and leave condition of a location based event triggered reporting condition. The actual value is field value * 10 meters.","paragraph_zero_based":18900},{"literal_text_all_w_t_and_m_t":"HysteresisLocation information element","paragraph_zero_based":18901},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18902},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-START","paragraph_zero_based":18903},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18904},{"literal_text_all_w_t_and_m_t":"HysteresisLocation-r17 ::=          INTEGER (0..32768)","paragraph_zero_based":18905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18906},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-STOP","paragraph_zero_based":18907},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18909},{"literal_text_all_w_t_and_m_t":"–InvalidSymbolPattern","paragraph_zero_based":18910},{"literal_text_all_w_t_and_m_t":"The IE InvalidSymbolPattern is used to configure one invalid symbol pattern for PUSCH transmission repetition type B applicable for both DCI format 0_1 and 0_2, see TS 38.214 [19], clause 6.1.","paragraph_zero_based":18911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1ae43cd4d72b2c8fd8a9d3ae5c49ac7f37a4996af7c19891662171e1782e497f","a7df4358a09c0abbccd302e92ae7e3866f5686682507d2bc7b1caae254c98187","8c183edf1e3e88c61ff666ee9882c275a5850bae0fc78b6b3aede2c1f477abbc","9609593b59c22a62074364d0dbc03bb0328d9714aebdfce04f915b32afe80354","e945ecbc9b2b954092b24513ede5aaf3721dcf23875818517c9a21287095955e","ec3175029b2c8d47696a8f1c85b033b3858993509e095e030b1e3bedeecdcb47","93e0ca5e08caf5742908eff8a764d0b7f53c7989e903f22a3a684b1bdbc8a2db","520262bf8705e190a887d245e5895f13ec25566c2c473b4450094283f5f2513b","312c4678d76aa9ffe596313a352828f714d344565422e372ff71ab80252f4358","6171457f389b88d9494f95a15661873f2270d413a1d5b847278ac10e554f8fe8","0e1fdc8b6c96b004aba8aa533bc5af13f83ca7e7f497c11eb19a62604972f24c","5930b5f5f019ffad7b8e0274970d9e90e77b976fcec9659f8fbfb1662de4df7b","d5fabaaec8e6d6236f29f30143e74b693a6d90d18e4b04fad4d0a7a8618bbca6","2c6d303