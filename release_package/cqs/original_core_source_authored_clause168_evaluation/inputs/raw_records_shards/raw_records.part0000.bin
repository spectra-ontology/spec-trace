{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"QCL-Info ::=                        SEQUENCE {","paragraph_zero_based":29568},{"literal_text_all_w_t_and_m_t":"    cell                                ServCellIndex                                               OPTIONAL,   -- Need R","paragraph_zero_based":29569},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id                                                      OPTIONAL, -- Cond CSI-RS-Indicated","paragraph_zero_based":29570},{"literal_text_all_w_t_and_m_t":"    referenceSignal                     CHOICE {","paragraph_zero_based":29571},{"literal_text_all_w_t_and_m_t":"        csi-rs                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":29572},{"literal_text_all_w_t_and_m_t":"        ssb                                 SSB-Index","paragraph_zero_based":29573},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":29574},{"literal_text_all_w_t_and_m_t":"    qcl-Type                            ENUMERATED {typeA, typeB, typeC, typeD},","paragraph_zero_based":29575},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29576},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29578},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-STOP","paragraph_zero_based":29579},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29581},{"literal_text_all_w_t_and_m_t":"QCL-Info field descriptions","paragraph_zero_based":29582},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":29583},{"literal_text_all_w_t_and_m_t":"The DL BWP which the RS is located in. If the field is absent, the RS is located in the DL BWP in which the TCI-State is applied by the UE.","paragraph_zero_based":29584},{"literal_text_all_w_t_and_m_t":"cell","paragraph_zero_based":29585},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-State is applied by the UE. The RS can be located on a serving cell other than the serving cell for which the TCI-State is applied by the UE only if the qcl-Type is configured as typeC or typeD. If the referenceSignal is set to csi-rs and unifiedTCI-StateType is configured, either both cell and bwp-Id are present or both cell and bwp-Id are absent. See TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29586},{"literal_text_all_w_t_and_m_t":"referenceSignal","paragraph_zero_based":29587},{"literal_text_all_w_t_and_m_t":"Reference signal with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29588},{"literal_text_all_w_t_and_m_t":"qcl-Type","paragraph_zero_based":29589},{"literal_text_all_w_t_and_m_t":"QCL type as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d36d3ec7c89bda554a33c87b04a4d1e11be4c6f4e8a0e1dd7ae3a13fd6b92fb2","6336b47a94f6be324ce51b1ab98b77f7e0304c2458ba2669ecb5fc6b79f0d0fd","aef47bd4b517c1cf6b585d025ef932f15a9968baef2419412cc2b7fbf539c029","240233a9b61746aec9929b10df10881e75a00e97e0e5c5f5255695a421248c7d","c11180ed45abf88896acd53ca9342aaceca5089876908687c0461570c7b99db0","81427be910c0c686288a549cb65d7bf5c0721a577111b62a35f3d767321c06f1","570e25c537e21fd7eacc4d263beca6f0090621edc174ad211712da3f3f5d48e1","23d8c011e19afc97ed5bb281f51af36eac0e0b275ccdb43fbf1c1431c42bd519","d3e0a6a4771ef1a61768b4938efe03687aca693c586977d84596f2841d3adccf","3972f20f30880320353674ed57f0c8fa46e305033986c3aa9cb364d3fe2f1471","8a428e60fd6a90089fe3702a54c0875699278df416ce611038c3976ed34443ec","cd25050e0c3129a1388fe87b67be676af16f137d2c21a1f7e2f26f7274643ce1","ecd0383298f92541604332ec24e8d63ed1cb3e69083b629cf3d36b6a5b5d02c4","62e118d6ae6c05d33a8b2f6eb3f0cdac73a0b611f0fe4eabdb7d1dbc731ad874","bf3ee341d6838d6974b1cfffef80941e369abe92313dd70344d7fb8c65ab3f25","9d18df7a02a4cc14db5f3c4f307ee153a66d33ace4c495cca7962839e05a7d9f","61ea10953f453c09b46ac9f91e67823b0383bf6ce3d076acc9ceee9a81071454","002670cbec6f150c7baf115460c826b6c10cb67e9026bbdafaeadf9e6ad636dd","e8124ae96bcc5430486903e16e07dfde395ba9e597ebdf4c11b4499fed2f880b","f864a36794d6cb2708fe965325a45c1ddc288d91099c10702fe354447fc479a7","b5515f346598be1a084c90cab9a7f642690b8109b0dd73eceabb859dd834c30e","832d2165dc9efda417beb5fd5ca18d4d9e5821992ab37d3f23d85f5b6204654e","9c63a9a2e3920f3b82d6dba7dbdaa077ae9fb6074316366a60f73b91cdb987c9","6c8eddad94f9b216a0b1f3637086e706c1069a0aa04fbe7449257f042c0632d3"],"paragraph_range_zero_based":[29568,29591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TCI-State field descriptions","paragraph_zero_based":29592},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":29593},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB for both QCL-Type1 and QCL-Type2. In case the cell is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field cell. Otherwise, it refers to a PCI value configured in a list additionalPCI-ToAddModList configured in the serving cell where the TCI-State is applied by the UE. When this field is present the cell for qcl-Type1 and qcl-Type2 is configured with same value, if present.","paragraph_zero_based":29594},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":29595},{"literal_text_all_w_t_and_m_t":"The ID of the reference signal (e.g. a CSI-RS or an SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the TCI State is applied by the UE.","paragraph_zero_based":29596},{"literal_text_all_w_t_and_m_t":"qcl-Type1, qcl-Type2","paragraph_zero_based":29597},{"literal_text_all_w_t_and_m_t":"QCL information for the TCI state as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":29598},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":29599},{"literal_text_all_w_t_and_m_t":"ID number of the TCI state.","paragraph_zero_based":29600},{"literal_text_all_w_t_and_m_t":"ul-PowerControl","paragraph_zero_based":29601},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the dl-OrJointTCI-StateToAddModList is configured.","paragraph_zero_based":29602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29603},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29604},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29605},{"literal_text_all_w_t_and_m_t":"CSI-RS-Indicated","paragraph_zero_based":29606},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs is included and unifiedTCI-StateType is not configured. This field is optionally present, Need R, if csi-rs is included and unifiedTCI-StateType is configured. Otherwise, it is absent, Need R.","paragraph_zero_based":29607},{"literal_text_all_w_t_and_m_t":"JointTCI","paragraph_zero_based":29608},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29609},{"literal_text_all_w_t_and_m_t":"JointTCI1","paragraph_zero_based":29610},{"literal_text_all_w_t_and_m_t":"This field is mandatory present, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":29611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29612},{"literal_text_all_w_t_and_m_t":"–TCI-StateId","paragraph_zero_based":29613},{"literal_text_all_w_t_and_m_t":"The IE TCI-StateId is used to identify one TCI-State configuration.","paragraph_zero_based":29614},{"literal_text_all_w_t_and_m_t":"TCI-StateId information element","paragraph_zero_based":29615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinate