{"fields":{"filename":"R2-2301431.zip::R2-2301431 Orbit and Tropo.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"If NW implements the CR and UE does not","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"UE interprets the AD as without the CR, i.e. AD applicable only to the associated constellation, which may result in positioning error","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"If UE implements the CR and NW does not","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"UE interprets the AD correctly if tropospheric delay corrections is provided only for one constellation","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"Incomplete specification and missing behaviour. The standard may not fully support GNSS types Galileo. The standard is not fully supporting tropospheric delay corrections.","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"6.5.2.2","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"402880a9d8f08f91fe24b048856b9780e089d79cd12536aba800d266be1e632a","original_member_sha256":"7cb6fb3149876999a30042fc450d0b566e79a928f6263bf65b46f1ac1a712180","paragraph_ElementTree_utf8_XML_sha256":["01bdb75df91ed26b6c863fa43a498bf6aabd40f6239fdd71b04e631eb88d8ef1","28c02c4a6d332e337bd8d00538aa82878535b8d6a68892c7e84a2a5513b96cbc","142559003db191e90b2eb5dbae3181a498f1a221992112d36c20ecf109cc4f7c","07feda3e931f13f9a76ad661019d9d100d7e3f30b9f0de95143f7bce96b5f269","dbf89bf982321ae4e5dae4e39db4dc80c36325c17074b3606cf68cbbd398e517","70a84da9d5ce1bbfd08efb5a806d84841f382a940bacdd8862c99b395399c397","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","eba2af3da2812677f015002609ff913c6814575e24e999cba0d438648e909ac0","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","6ff837ed9580cad264fbd52c1482066b93bcd6cfde3c2d620d6dfc7745f26aba","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a4e","cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032