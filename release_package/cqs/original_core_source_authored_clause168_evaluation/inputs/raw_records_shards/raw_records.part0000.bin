eral_text_all_w_t_and_m_t":"[37]3GPP TS 36.423: \"E-UTRA; X2 application protocol (X2AP)\".","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"[38]3GPP TS 24.008: \"Mobile radio interface layer 3 specification; Core network protocols; Stage 3\".","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"[39]3GPP TS 38.101-2 \"NR; User Equipment (UE) radio transmission and reception; Part 2: Range 2 Standalone\".","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"[40]3GPP TS 36.133:\"E-UTRA; Requirements for support of radio resource management\".","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"[41]3GPP TS 37.340: \"E-UTRA and NR; Multi-connectivity; Stage 2\".","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"[42]3GPP TS 38.413: \"NG-RAN, NG Application Protocol (NGAP)\".","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"[43]3GPP TS 23.502: \"Procedures for the 5G System; Stage 2\".","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"[44]3GPP TR 36.816: \"Evolved Universal Terrestrial Radio Access (E-UTRA); Study on signalling and procedure for interference avoidance for in-device coexistence \".","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"[45]3GPP TS 25.331: \"Universal Terrestrial Radio Access (UTRA); Radio Resource Control (RRC); Protocol specification\".","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"[46]3GPP TS 25.133: \"Requirements for Support of Radio Resource Management (FDD)\".","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"[47]3GPP TS 38.340: \"Backhaul Adaptation Protocol (BAP) specification\"","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragr