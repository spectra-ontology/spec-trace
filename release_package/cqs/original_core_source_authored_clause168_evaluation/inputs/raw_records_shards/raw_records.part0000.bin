L_sha256":"61ed7bc628316aeacded3fb6e59725c2105ab4951b563da4da8eca75cb9abe3a","original_member_sha256":"b1c315f635ff35ff9ae385c261c0967ba4b109a6e7bed98ebc7d880ca7e68ac3","paragraph_ElementTree_utf8_XML_sha256":["3a32c7bb136c81b2a04a4f97fc658b0e72d54b4571dbdf179d6cd6d11a940f7f","99163e155020c00d02c2ea2407cf46e349d92a0a5ca1495c26cbf554362c7228","d1e6d13d6db36620f5bb71ac22ab86edfae7c9ed07d8bdee9fade0404a8402d3","478d4664e4f6ac435bdd1e71c5aeff0c74370ef7d7d81dbc7a7eaf1ec813aa9c","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","c14fec5a1b6639d7738c3ecfd108a5e0b79049ffb43a65593f1c5f61a0565de1","4e8aacf4e54c6331abfe123af9d34bd68ce52c0b7382cf38228908442651e97a","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","fe78732cb3512cc5484aff696831b12b28c2cd72bb5804fb975d9753ae67e848","2f972cbefc3fee71163a451c0ae90f059d88b9744677cc9130dcfa7ff24d65bf","bb204acaf3b25458da54524f7b388e57787c4ff94ee3b930ed69fdcf20ae4688","67ccc4ab997864d9d1671ab605d0bcdcaf1efd68be9018e3aa650dc3f3469e1a","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","28133df962f93bd31f93747a300c929bc0ea4709793367db4f7724995eb6094e","c956f44c6805fa5fb596d4b681bc3aa504a490a0935c8aba7c79e39299a189ce","fb817d553c33b06ced7090fe8c5ed93cb58195ba589743763af45f5183a3f70e","41e145a6efb959238c27d20bdba6a114f1647e90c9b025637151ebceaa5f0722","e869b85dcd6d4de7416681b5e4c2940bc1737166e7b991ce0e73b8fdd03c4dc2","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301121.zip::R2-2301121 Miscellaneous corrections to TS 38.331 for SL relay.docx:p24"}
{"fields":{"filename":"R2-2301121.zip::R2-2301121 Miscellaneous corrections to TS 38.331 for SL relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"In clause 5.3.3.1a, only when both dedicated discovery pool and shared pool are not provided in SIB12, UE may initiate RRC connection establishment to enter RRC connected to acquire SL resources for NR SL discovery.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Upon receiving NW configuration to establish a PC5 Relay RLC channel, UE shall assign a LCID for the logical channel to be associated with the PC5 Relay RLC channel and include the LCID in RRCReconfigurationSidelink to send to the peer UE. However, this is missing in clause 5.8.9.1.2.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"In clause 5.8.9.1.2, move the sl-RLC-ChannelToReleaseListPC5 to the front to avoid confusion. The original text seems like “corresponding to PC5 Relay RLC channel in the sl-RLC-ChannelToReleaseListPC5” which is misunderstanding.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Wrong IE name is used in PC5 Relay RLC channel release in clause 5.8.9.7.1. As we can see, it is SL-RLC-ChannelID used in sl-RLC-ChannelToReleaseList/sl-RLC-ChannelToReleaseListPC5, not sl-RLC-ChannelID or sl-RLC-ChannelID-PC5.","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList-r17      SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelID-r17","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseListPC5-r17      SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-ChannelID-r17 ","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Some minor corrections.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"In clause 5.3.3.1a, change “or” to “and”.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61ed7bc628316aeacded3fb6e59725c2105ab4951b563da4da8eca75cb9abe3a","original_member_sha256":"b1c315f635ff35ff9ae385c261c0967ba4b109a6e7bed98ebc7d880ca7e68ac3","paragraph_ElementTree_utf8_XML_sha256":["af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","c4f041a9762bf9d1a2cc8c4e7a51b1602c9a76b1829e63493dd23c9d645657cd","427cc975da2598f14bff0bfff5bed0c40718db699439358f1f9ef28e95cbaab6","25575fc71f7f111bbd9ce8e5b6acd86d8780fdd8625af5aec176d06e4a726a00","dd873086dc7002a620a1ac5a9f63c4800bd1003ee535e0f0bfd28c73e1050f5a","92201337099bd04512e626e9508e7d82eab276afc4ad3a61f34f174acecaa34d","1ed1b1c58aacc1c3927a4165d010345453764a8567165692ce7b30d654c520de","584deeaa975f7dca5020fee76c516f491e5580d8fc278713666a8575adc195a0","e72bf84f4887553733f1e2ab08b9c464c96a1a24b6456377d6306e0599a55aec","37b976f007f4d05011edb2cc81cfe5b6f18a07a44b78de4d25bfb1f948f4deb6","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","733fa31e721e73a863ea5cb07afd971b62236195c837b2a964671d3eba94f9c7","4fc09e052f66c98fabd99bbf5f72eb37a374f055fb4f2d351be1ee7d36172ecb","dbe002fad9a7089a491e6e2ab4053d8993648b297f5a5273e67a067c92d37be8","666cbfe4ba2d698decc8228519b45f9c15bca3db9604c7f6b15b0e5ef6726e48","266c379ee2db024bcbc29390faa277394754a9f0e9f8877104525ff2df3bc325","3e3256a5d3b09b5336ae42511b1e0922fa459bcf2f8f20d6ee062c967b34122f","140306254796b1c2414027b484832b3fe900d2ea5a5d0b2d4c3df9f822178f4c","675f933742e3cb58f36302b025106579a43c73199939b34cad40bd2506dbd270","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","4ae738c175a19b7b852cd3e8fb867e22e149edf1d058bf6365e9f3b2165065e6","51ef09f14d882bf00bf5a83f7436542a644c7d2c2326686260224922ec3ddb78"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2301121.zip::R2-2301121 Miscellaneous corrections to TS 38.331 for SL relay.docx:p48"}
{"fields":{"filename":"R2-2301121.zip::R2-2301121 Miscellaneous corrections to TS 38.331 for SL relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In clause 5.8.9.1.2, add the description for assigning LCID for PC5 Relay RLC channel.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"In clause 5.8.9.1.2, move the sl-RLC-ChannelToReleaseListPC5 to the front.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"In clause 5.8.9.7.1, change sl-RLC-ChannelID / sl-RLC-ChannelID-PC5 to SL-RLC-ChannelID.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Some minor corrections.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Wrong condition for UE to initiate RRC connection establishment.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"LCID assignment for the logical channel to be associated with a PC5 Relay RLC channel to be established is missing.","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Text leads to misunderstanding.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Wrong IE name is used in PC5 Relay RLC channel release procedure.","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Some errors are remaining in the spec.","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"NG-RAN Architecture supporting the PC5 interface.","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"SL relay communication.","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"There is no inter-operatbility issues.","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"5.3.3.1a, 5.8.3.3, 5.8.9.1.2, 5.8.9.7.1, 5.8.9.9.3, 5.8.9.10.3, 5.8.15.3","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"61ed7bc628316aeacded3fb6e59725c2105ab4951b563da4da8eca75cb9abe3a","original_member_sha256":"b1c315f635ff35ff9ae385c261c0967ba4b109a6e7bed98ebc7d880ca7e68ac3","paragraph_ElementTree_utf8_XML_sha256":["305afe01a7ac02ce7aad2bd7986f2f1f7657afe31717f642491e10d87b185417","5418dd6eb6f1e88f439d15197ebb15a657c7a7126b5055cdd3115e702ea3dec8","bf519902870985c955e025b46024b713122758d4309e983ad0a8bc55fee7b1e8","0675cd79106498f5447eecc833ee7f337c3945e0f94f452eeb074cbc8715f9e1","3ba396081e8c2a1af4ed5ab33469faf763c5018b07f1e4f7343dbc332203b5fd","af4686c051bb6687e39bc3b9619449eeefa8f1bb394fe6df60722e0c0f79d1a5","9289279b62cc3a629acd189a0c0bea3257d20550f9af34f7df922824190a8d92","388f0614dca13f4f733374da355af24082cb51f537176ee317cbb48d133170d2","41750881156dc4180b2a824336ab897d64b942907adca32b4d94a410084c477b","f679290285bef7340c76c8da597bfced4423bd6f9a2e38fc0fd897f29ad79c3b","b7c287a09146905eaffba4b53f5478ff49aa02e2f885eefba87626b6ae9c8633","c51e7aebb52c1bae8b361cd26929751b87e5719c97cd9e19e6baac8f34446a0c","834453fa79ba9b99c6cfd3f2fbaea61fe4a8a0704ba62d949e3eedd5daa578df","13a10b45feffbd5eb644f71233a60c78ff7a6de33e5a632df055d48cda07e2e4","784f304de4a1db856ed1ea153531d35feb604a0f33ea5c3676a2111d28108a32","a98c3b8d5533ea086d1c7f9d39a11a3efd50d947388789e41c38a