,"paragraph_zero_based":14248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14249},{"literal_text_all_w_t_and_m_t":"MCCH-RepetitionPeriodAndOffset-r17 ::= CHOICE {","paragraph_zero_based":14250},{"literal_text_all_w_t_and_m_t":"    rf1-r17                                INTEGER(0),","paragraph_zero_based":14251},{"literal_text_all_w_t_and_m_t":"    rf2-r17                                INTEGER(0..1),","paragraph_zero_based":14252},{"literal_text_all_w_t_and_m_t":"    rf4-r17                                INTEGER(0..3),","paragraph_zero_based":14253},{"literal_text_all_w_t_and_m_t":"    rf8-r17                                INTEGER(0..7),","paragraph_zero_based":14254},{"literal_text_all_w_t_and_m_t":"    rf16-r17                               INTEGER(0..15),","paragraph_zero_based":14255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["445a2a2d1aa9cbc348d2dde4aed386d8d3d8e3e78a8c64dd3fd4a32b7a041248","1ba6b56ce4cc69e9c5d605f9e3e74c7d89bc51e9bcc0a442ed479a83a81364ff","7053fbee160b345459125eda152164f5f4eb1ad9410ec8c3b92cc987ecfafb91","a630fe481c19c98961adec83d3886e03625dc0f84b9e55f1b51d1348b5942fa3","c7414e5c9308573521fca0a7375caaa770c51267687e4db5df3ab2e4052ed23a","38498c78f8cbab00e8a887b896a525314f08263ffb98f1c5c79830822dc09048","c361a88a5bec7f7fcbdf90aa73d9ca3a49618b48e1c0aac5be320df3d3080def","cc9e2c89f835eafd6fd06f3d83efae6bb94dd44f91c8ec48646c6bd8b2f80ab1","4914b5fdf1485e966970165f0b1ffe1d04eb4f0e6b645826831d9ccf7d6a03e8","00d78ef61d31fb2d68f7202d2a7823f8fd831371bd80af67660b0ca0fef863c1","02cb68e6be4b3b284b0e8ac7ae84813c5745d25d8b0476543fcaac5bdbe9e8b2","b4a93af7c58eddae9cda21535ab0d0759e087ee5a4d4b5b510f60c2695eb1236","7bc7ad285f6590ea867e68eb96234fadb6453a375ae3411d4120ecc40b0b45e7","ac3d72e6768b90caa5c1c9d83e15614e642a12f072b6a6e86ce3cf2343762797","04249ecf486679dd6ec8afb091796f52e59cc218f1b10cea3876914bb9636b9d","027cf230778ec6a55397963364b7bf64e4b8f739932591750668342320c82578","53ad06e81eee9770c5545d9e7f0a5499e7b27a06b2000cab05eebbbfaf872414","8a645853aa778c00f725f08a2f9044b09e1ceac8fc2d4d518be09bdd0d62e538","08145024cac570a830b3cef5172db2cf76706b955792fa7e758818d0d574f4e2","e9ff51dcc0ac14739c34a0a00ef98f02efb4e9baddb62d359492eca103fabba8","04a5b500c1dd06262836fa39b73040d49dd1e120760c7943a9026cdbccc751d6","8228a8141b98cadb36d80baeff2a33c5e573ecbb3e698e2153731da325d6c1d7","a1059ead18a849c59ba69d28fae136876ee7663d743f4ff74750e52abb78ee3f","eccc426cbe46eb02b34179db382bc73e361f5165459eabed3d0bb281611f1b27"],"paragraph_range_zero_based":[14232,14255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rf32-r17                               INTEGER(0..31),","paragraph_zero_based":14256},{"literal_text_all_w_t_and_m_t":"    rf64-r17                               INTEGER(0..63),","paragraph_zero_based":14257},{"literal_text_all_w_t_and_m_t":"    rf128-r17                              INTEGER(0..127),","paragraph_zero_based":14258},{"literal_text_all_w_t_and_m_t":"    rf256-r17                              INTEGER(0..255)","paragraph_zero_based":14259},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14261},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB20-STOP","paragraph_zero_based":14262},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14264},{"literal_text_all_w_t_and_m_t":"SIB20 field descriptions","paragraph_zero_based":14265},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMCCH-MTCH","paragraph_zero_based":14266},{"literal_text_all_w_t_and_m_t":"Common frequency resource used for MCCH and MTCH reception. If the field is absent, the CFR for broadcast has the same location and size as CORESET#0 and PDSCH configuration of MCCH is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":14267},{"literal_text_all_w_t_and_m_t":"mcch-WindowDuration","paragraph_zero_based":14268},{"literal_text_all_w_t_and_m_t":"Indicates, starting from the slot indicated by mcch-WindowStartSlot, the duration in slots during which MCCH may be scheduled. Absence of this field means that MCCH is only scheduled in the slot indicated by mcch-WindowStartSlot. The network always configures mcch-WindowDuration to be shorter or equal to the length of MCCH repetition period.","paragraph_zero_based":14269},{"literal_text_all_w_t_and_m_t":"mcch-ModificationPeriod","paragraph_zero_based":14270},{"literal_text_all_w_t_and_m_t":"Defines periodically appearing boundaries, i.e. radio frames for which SFN mod mcch-ModificationPeriod = 0. The contents of different transmissions of MCCH information can only be different if there is at least one such boundary in-between them. Value rf2 corresponds to two radio frames, value rf4 corresponds to four radio frames and so on.","paragraph_zero_based":14271},{"literal_text_all_w_t_and_m_t":"mcch-RepetitionPeriodAndOffset","paragraph_zero_based":14272},{"literal_text_all_w_t_and_m_t":"Defines the length and the offset of the MCCH repetition period. rf1 corresponds to a repetition period length of one radio frame, rf2 corresponds to a repetition period length of two radio frames and so on. The corresponding integer value indicates the offset of the repetition period in the number of radio frames. MCCH is scheduled in the MCCH transmission window starting from each radio frame for which: SFN mod repetition period length = offset of the repetition period.","paragraph_zero_based":14273},{"literal_text_all_w_t_and_m_t":"mcch-WindowStartSlot","paragraph_zero_based":14274},{"literal_text_all_w_t_and_m_t":"Indicates the slot in which MCCH transmission window starts.","paragraph_zero_based":14275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14276},{"literal_text_all_w_t_and_m_t":"–SIB21","paragraph_zero_based":14277},{"literal_text_all_w_t_and_m_t":"SIB21 contains the mapping between the current and/or neighbouring carrier frequencies and MBS Frequency Selection Area Identities (FSAI).","paragraph_zero_based":14278},{"literal_text_all_w_t_and_m_t":"SIB21 information element","paragraph_zero_based":14279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00",