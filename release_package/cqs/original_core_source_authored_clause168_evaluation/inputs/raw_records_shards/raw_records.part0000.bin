{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if T312 is not running for corresponding SpCell:","paragraph_zero_based":4776},{"literal_text_all_w_t_and_m_t":"5>start timer T312 for the corresponding SpCell with the value of T312 configured in the corresponding measObjectNR;","paragraph_zero_based":4777},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4778},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered and if the leaving condition applicable for this event is fulfilled for one or more of the cells included in the cellsTriggeredList defined within the VarMeasReportList for this measId for all measurements after layer 3 filtering taken during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4779},{"literal_text_all_w_t_and_m_t":"3>remove the concerned cell(s) in the cellsTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4780},{"literal_text_all_w_t_and_m_t":"3>if reportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":4781},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4782},{"literal_text_all_w_t_and_m_t":"3>if the cellsTriggeredList defined within the VarMeasReportList for this measId is empty:","paragraph_zero_based":4783},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4784},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer for this measId, if running;","paragraph_zero_based":4785},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable L2 U2N Relay UEs for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig, while the VarMeasReportList does not include a measurement reporting entry for this measId (a first L2 U2N Relay UE triggers the event):","paragraph_zero_based":4786},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4787},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4788},{"literal_text_all_w_t_and_m_t":"3>include the concerned L2 U2N Relay UE(s) in the relaysTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4789},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4790},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more applicable L2 U2N Relay UEs not included in the relaysTriggeredList for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig (a subsequent L2 U2N Relay UE triggers the event):","paragraph_zero_based":4791},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4792},{"literal_text_all_w_t_and_m_t":"3>include the concerned L2 U2N Relay UE(s) in the relaysTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4793},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4794},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and if the leaving condition applicable for this event is fulfilled for one or more of the L2 U2N Relay UEs included in the relaysTriggeredList defined within the VarMeasReportList for this measId for all measurements after layer 3 filtering taken during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4795},{"literal_text_all_w_t_and_m_t":"3>remove the concerned L2 U2N Relay UE(s) in the relaysTriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4796},{"literal_text_all_w_t_and_m_t":"3>if reportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":4797},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4798},{"literal_text_all_w_t_and_m_t":"3>if the relaysTriggeredList defined within the VarMeasReportList for this measId is empty:","paragraph_zero_based":4799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["72bd42d4d77724ed10c3c5aaca8c32b132754266197c18ba97d2cbbee172dfc9","9de63755af7d6d1b16f673aa2554530bd1ccacd58ec69789c5dacb196aeaa7d7","f6e982404125d46e473a9e9c3ef68f6f6c7e51374b2a99605f458945e7703178","0587c8d1d1bd5526294367f8129dd9539ac6b818825f0a3659472a617d2a2f24","4bd90bcea3a42daab8d31efe6280fd46741889e654bc6543b9e021cbd3658659","4b44079303765c54078e5539c3af248cbf7417c00dc2b04e3b51d5bfef34492f","bf1a22609c2ea62a7377da5c41ad60ec4aedf14c7f337e7b5c4e49173807bf60","1b4dcdb5665dd2bff