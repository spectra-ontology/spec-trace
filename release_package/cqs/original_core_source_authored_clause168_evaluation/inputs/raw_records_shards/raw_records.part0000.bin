          OPTIONAL","paragraph_zero_based":15950},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15951},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15952},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRALOGGING-STOP","paragraph_zero_based":15953},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15955},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging field descriptions","paragraph_zero_based":15956},{"literal_text_all_w_t_and_m_t":"cellIdentity-eutra-epc, cellIdentity-eutra-5GC","paragraph_zero_based":15957},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1.","paragraph_zero_based":15958},{"literal_text_all_w_t_and_m_t":"plmn-Identity-eutra-epc, plmn-Identity-eutra-5GC","paragraph_zero_based":15959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a9191bddd731393300e5dc09897e5d02d07e6ddce321bd793cd1c6b84bd7b17c","39aa2d68f912bd6721d448ba411f961fe727fd82b9868e716003d992e4835b27","74376ec98f8e1fa26484fd12090177fc9ea084f3271cac3b999c8479d2e0ac97","dffcbff8be22878948d50a4feefa7a36d8deae66e6d395f235c9d636de934bb8","2eb071690c84fd5926b83731f79f8ecaf9ff6e7e08921b7821c9418538af9009","961e83d6f717174b5aee500e129506b8737dfe51571efb344ddba3c6d7ee2c3a","a65007407a9dd8062585cd1cb10a6e6f52b2160d5499df4b6f4fc7d4691e6a22","521280295d3226ea171e2de82ae8b3d76616812380e74cd5513f4848a1e399c2","359c77b4e996efb2a6ee05f12d9aca7eaa8da5868be03eda01deade31ed74074","b5c8bcb7e