source-r17","paragraph_zero_based":1531},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-Indicator-r17OPTIONAL,","paragraph_zero_based":1532},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathListExt-r17NR-AdditionalPathListExt-r17OPTIONAL","paragraph_zero_based":1533},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1534},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["d16a5417073894f5495de7b4a79c6cdc84f914e066e669f29e3d47c75d606d4d","788da49ebc67011ab08da10ad540d4c6437bd3832345af7cdd7e7075b33e823e","5f651ffaf9ab2e3aef53fea4e68bd4ae5dcbdbce31c9f681125fe0032c81797b","07c4219997e99f8a242c06a9887d90df5e5b4f07393afd51dad6d3aaa3011a79","2b96ab1a2e931591842bc21dba8704d35c002c10414979a4afacc7f44a6ce7cd","9fa408623258154a930f1f3ad76e65f423462c4b75b737388d9ecc410fb6d48d","bbb8fb75d708c15d25c5acd9aa42f8c49cf4045be50eaa6b6b7018f8cbed4d92","37a017b18df958d24bd1d3264ff1310f2efd89c5797e89a3595d49f6b31c641c","818439057b6dd9bf6f9cea955012b657a563d93921ef325ad57a8c72d0c0d277","4f682892c7295a41a001ade732cdbeb9660eac38ed74678548cd25f382365d58","64ef6bc6684ee06f15395fac66e0b174033d00169aae17b6d1b0e3b420b7af25","11ddb6c2aa14a4610767cb6af03f16ab6e0a08882e8894819683f5d8515aa4e5","bd4437c7545b2bc29d9f574fd756feebdf3a7d74a8df9562591507f4128bb520","5a8a785af2d84521d66d9e06127f561ce713d370a1bec3646f7e9611ae2fb7ba","caf3ca3712184797fafb323c30ac32e18223f568a2d2bce912826155177962d6","ed88d41e8acd5cf8a3506696f55b82585c045d262fd5fc9c171a1a8a297fbfde","22865ffb124f1b6813039ede3b6d91a451188c4876dd7ce1f63f653bc12a76c0","681a8a36c2960a740e53ff1917203be23d404ca5714927e541280cb4a6069d51","9ba0d5da07227d82dd162febf3f748437ca91eb6336e9b05f64eefe2a874a988","fe6b91cc7b3d7e05f3aca7d2c8818ecc5971df10d87bd04b6a6e41872c4d73ff","5031d60089dc71aba4fc88dd1e543374fb00cdc6dfce285ee148655042503eb8","478e4691bd5392702b9b4fcc1d2afad6a1a261ec5ecb9e37d8319e958697b625","258134e065fef2b3868d85c633d4012d608de7dc307ad8a637a032c842fa38ee","bf8c1da6e26af31fec4ed2c0bfb0e585a71e6ba3afceb3a4402444226139efc6"],"paragraph_range_zero_based":[1512,1535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1512"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1536},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1538},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1539},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1540},{"literal_text_all_w_t_and_m_t":"UERxTEG","paragraph_zero_based":1541},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP, if the field nr-UE-Rx-TEG-ID is present; otherwise it is not present.","paragraph_zero_based":1542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1543},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-SignalMeasurementInformation field descriptions","paragraph_zero_based":1544},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-TimingErrorMargin","paragraph_zero_based":1545},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Rx TEG timing error margin value for all the UE Rx TEGs within one NR-DL-TDOA-SignalMeasurementInformation. If the nr-UE-Rx-TEG-ID is present and this field is absent, the receiver should consider the UE Rx TEG timing error margin value to be the maximum applicable value as defined in TS 38.133 [46].","paragraph_zero_based":1546},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":1547},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resources ID to uniquely identify a DL-PRS Resource. This ID can be associated with multiple DL-PRS Resource Sets associated with a single TRP.","paragraph_zero_based":1548},{"literal_text_all_w_t_and_m_t":"Each TRP should only be associated with one such ID.","paragraph_zero_based":1549},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":1550},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":1551},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":1552},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":1553},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":1554},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":1555},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":1556},{"literal_text_all_w_t_and_m_t":"This field specifies the time instance at which the TOA and DL PRS-RSRP/RSRPP (if included) measurement is performed. The nr-SFN and nr-Slot in IE NR-TimeStamp correspond to the TRP provided in dl-PRS-ReferenceInfo as specified in TS 38.214 [45]. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1557},{"literal_text_all_w_t_and_m_t":"nr-RSTD","paragraph_zero_based":1558},{"literal_text_all_w_t_and_m_t":"This field specifies the relative timing difference between this neighbour TRP and the PRS reference TRP, as defined in TS 38.215 [36].  Mapping of the measured quantity is defined as in TS 38.133 [46].","paragraph_zero_based":1559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["4f30fb5d2bf034985a9098c12aa52f0bb8be1fc1c8af68add1846e888fc562df","7a4f8d3026e4f36f2bcc8cc23a2e6eb6226d715a2424f6ea86ab2384dbfa292c","034cce956d2dfd5e9cf731b0b6ccbe99ad37034e3f9a2ef6baa8e6b66f92cb1d","08455188e1fed254e95414c4e34957b8f22d4307d5fdf3513f0e1b03f78f8fbd","2fd2b648f9c66ab636e7f3e9e6d892743ae7f1ced449b94ecea69e2dbe67040c","1bad00e987f17cbb50427e5cc2c9a2fd76edb1994fef55042b2687c47958e780","997ef16835cac73b0a24be4ace0955afc97d969b7f913215009baf2491402df2","f59af1b9d663187e45c04a60533cee2922e5972ce9054050f566f6e5651202ae","5baf5e7361b001c11b38a85359d3b03882530104a684f8fcb869f3217029c14c","78b5042776c912c936f7b3bea1aa906a32669902e8fcf8243a2233aaba42d87a","ed1bfa0f5c236726338b852b69d0ba669bc5e18f0454bab162cf5e5c659ac666","1562c45897e238d5d0d57f13456abf11f41feefe592da25d5ebc130f1747094f","7fed9949a586e2965bb15a72b99ef2d947dddc76d3d63e4e89aa1de8c5c71f47","5032f5c6a34f5a5d0dedff32ecc4717d8eab4a8919d9f1c2eae28718fab50cff","07118975939a5d0971d77548ca729116e6b91342a5ab65a8b887edab758d6716","84558b3ec5747b08f65bb7958a33010f81c0f541eda2445d6c862bc4257b92f1","6595dcc1bae271414dc564ac1a7e21cc2d9d702b34ea6113c0c7f40099991808","c8919bca67455ac8e78a96704f3be47ec9773ce702b4704077a2d6a8d4c81003","137fe3965b5242fc6f62d3717ed11e4961b47ea72658269c3d97ec49915837a9","e56519eab98ac778294b5624e4e57b44ec55de2a87b4c34a53eaee9b92033b70","f4673bffa6106a951e4295cf758a01817ebbf2723462eca189250c09c08d9181","145ac82471ce7272c634d4e6edb232efa10b7a2c1a0f11b84f497de407e2aee9","d078ed9f6b759959455b09f3071e42455a2092eb3f9f8e118710708c9a4dcb34","e2c90108159405eba97a66140d381844ffc978d6e3ac97edfd9148f6eb2857ed"],"paragraph_range_zero_based":[1536,1559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1536"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathList","paragraph_zero_based":1560},{"literal_text_all_w_t_and_m_t":"This field specifies one or more additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-RSTD value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathListExt shall be absent.","paragraph_zero_based":1561},{"literal_text_all_w_t_and_m_t":"nr-TimingQuality","paragraph_zero_based":1562},{"literal_text_all_w_t_and_m_t":"This field specifies the target device′s best estimate of the quality of the TOA measurement. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1563},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-Result","paragraph_zero_based":1564},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-PRS reference signal received power (DL PRS-RSRP) measurement, as defined in TS 38.215 [36]. The mapping of the quantity is defined as in TS 38.133 [46].","paragraph_zero_based":1565},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-AdditionalMeasurements","paragraph_zero_based":1566},{"literal_text_all_w_t_and_m_t":"This field provides up to 3 additional RSTD measurements per pair of TRPs, with each measurement between a different pair of DL-PRS Resources or DL-PRS Resource Sets of the DL-PRS for those TRPs [45].","paragraph_zero_based":1567},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-DL-TDOA-AdditionalMeasurementsExt shall be absent.","paragraph_zero_based":1568},{"literal_text_all_w_t_and_m_t":"nr-UE-Rx-TEG-ID","paragraph_zero_based":1569},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the UE Rx TEG associated with the TOA measurement. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff. When different UE Rx TEGs for RSTD measurements are requested, the maximum number of reported RSTD measurements associated with different DL-PRS Resources per UE Rx TEG per target TRP is 4.","paragraph_zero_based":1570},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-Result","paragraph_zero_based":1571},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time, as defined in TS 38.215 [36]. The mapping of the measured quantity is defined as in TS 38.133 [46].","paragraph_zero_based":1572},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-Indicator","paragraph_zero_based":1573},{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the TOA measurement for the TRP or resource. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1575},{"literal_text_all_w_t_and_m_t":"NOTE:If the requested type or granularity in nr-los-nlos-IndicatorRequest is not possible, the target device may provide a different type and granularity for the estimated LOS-NLOS-Indicator.","paragraph_zero_based":1576},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathListExt","paragraph_zero_based":1577},{"literal_text_all_w_t_and_m_t":"This field provides up to 8 additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-RSTD value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathList shall be absent.","paragraph_zero_based":1578},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-AdditionalMeasurementsExt","paragraph_zero_based":1579},{"literal_text_all_w_t_and_m_t":"This field, in addition to the measurements provided in NR-DL-TDOA-MeasElement, provides TOA measurements of up to 4 DL-PRS Resources of a TRP with different UE Rx TEGs. For a certain DL-PRS Resource, there can be up to 8 TOA measurement results with respect to different Rx TEGs.","paragraph_zero_based":1580},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-DL-TDOA-AdditionalMeasurements shall be absent.","paragraph_zero_based":1581},{"literal_text_all_w_t_and_m_t":"nr-RSTD-ResultDiff","paragraph_zero_based":1582},{"literal_text_all_w_t_and_m_t":"This field provides the additional DL RSTD measurement result relative to nr-RSTD. The RSTD value of this measurement is obtained by adding the value of this field to the value of the nr-RSTD field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["8c4d4ab7f3f38781b67ec06ef6cd06438708e5d3fd6c813aaeb5cc3238d01a4b","c8143789e11d8a83cc292067c4b5b85b289e85247578accd6a0d54d678207a24","b806fa3f12263dad4ba253984a1a7ee6bc798b3a64e97302616f9f8f94821c4f","cddfe841766e5e9df6189e9f35a8905756f49a5330828fd482a394f37487cdf5","ce376c0aff38f29d94fadb4026362553b7c252ae980d600367bb0f2c54dbbcba","3331e5bdb4eb956a59b599ec9638fdf7df1c740c94936502d19eaf5dfcd60172","0d5d037db47a6ee819752298bc14bbcb1d469fd7624461b3e579545078c7ded6","95a9745802987d8300b11e98b156eaeb28e2ac050f73995efa6f97921ded916f","fbae5223f6afb8112c997fd060f5d3f03c253d26a23ed142a6258278814f38dd","19923f5c080c4b545731bf11dc9ffcad35791d37a1d955610841326831bae305","be8e15f5768053a4f4929e0559b6d7d25a72d87857c85d15c66ec93929df0729","754b768ff2e4f2f8b37ee974496507b37a6ef3f629c771120163c94c03f422aa","40f8e5781caedd60beaaeb270beea4e6eb982b84ff5b0ef791e4cf7506c304fb","d62818bba76c85d93f9224110965b1168eb3edbb7ab9755396d9c2b8748de51b","8b843784d67d6607a439de95ad35eafb83ecafbbee25958f93d514c8a18ec28c","42e623c4e38a4dc8c457830e8b1abed224f0a04eadc4f896490eee809e8223bf","da287601aa683825e4e6b2be0aac55054099aee180fe8ba4a4dc0045e336f993","5221338e3ae779026749b5555eed1b5fd9b88b96f54b2963fc2944330f8ffc2b","1a6d39e4fffeef757b134d0089e9d430d348f4aef23d6251af4b4f5803d907b3","a6962da943d2700821d7579fa5f790757c88fd719fe730bc845c1ab1163cfbae","e3955bf89e1165012ca3b59f13f539d672056aaa36beb516ed0d80d5fdb78a7a","fb56eeb67171597109aad7f06ff9af8fe1e6531a8c716722530d283e8e028092","d2e061e1ffd3f8e63ab60dbd96da661c2089f0daeda968004fd51521bd552e28","027e430b2a3d65c7e0fa2fbb2ac67a4deb26d9ce49ecfb230845032d9bf8a481"],"paragraph_range_zero_based":[1560,1583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1560"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-ResultDiff","paragraph_zero_based":1584},{"literal_text_all_w_t_and_m_t":"This field provides the additional DL-PRS RSRP measurement result relative to nr-DL-PRS-RSRP-Result. The DL-PRS RSRP value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-RSRP-Result field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1585},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-ResultDiff","paragraph_zero_based":1586},{"literal_text_all_w_t_and_m_t":"This field specifies the additional NR DL PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time relative to nr-DL-PRS-FirstPathRSRP-Result. The DL-PRS RSRPP of first path value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-FirstPathRSRP-Result field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1587},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorPerResource","paragraph_zero_based":1588},{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the TOA measurement for the resource. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1589},{"literal_text_all_w_t_and_m_t":"This field may only be present if the field nr-LOS-NLOS-Indicator choice indicates perResource.","paragraph_zero_based":1590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1591},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":1592},{"literal_text_all_w_t_and_m_t":"6.5.10.5NR DL-TDOA Location Information Request","paragraph_zero_based":1593},{"literal_text_all_w_t_and_m_t":"–NR-DL-TDOA-RequestLocationInformation","paragraph_zero_based":1594},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-TDOA-RequestLocationInformation is used by the location server to request NR DL-TDOA location measurements from a target device.","paragraph_zero_based":1595},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1597},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-RequestLocationInformation-r16 ::= SEQUENCE {","paragraph_zero_based":1598},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RstdMeasurementInfoRequest-r16ENUMERATED { true }OPTIONAL,-- Need ON","paragraph_zero_based":1599},{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements-r16BIT STRING { prsrsrpReq (0),","paragraph_zero_based":1600},{"literal_text_all_w_t_and_m_t":" firstPathRsrpReq-r17 (1)","paragraph_zero_based":1601},{"literal_text_all_w_t_and_m_t":" } (SIZE(1..8)),","paragraph_zero_based":1602},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability-r16BOOLEAN,","paragraph_zero_based":1603},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-ReportConfig-r16NR-DL-TDOA-ReportConfig-r16OPTIONAL, -- Need ON","paragraph_zero_based":1604},{"literal_text_all_w_t_and_m_t":"additionalPaths-r16ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1605},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1606},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["c5eaea459555b2be30ab3e4d01dc226956084f829eb4a415acf2ae55ea7e9028","8ebddfb91416cb812286d4f6a66708499bf576682f6d73b723e88125f83b98c7","1788ff78468159