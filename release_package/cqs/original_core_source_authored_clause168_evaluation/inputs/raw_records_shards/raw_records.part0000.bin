{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    numberOfN-r17                       INTEGER(1..4),","paragraph_zero_based":22944},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22945},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22947},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-STOP","paragraph_zero_based":22948},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22950},{"literal_text_all_w_t_and_m_t":"PHR-Config field descriptions","paragraph_zero_based":22951},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":22952},{"literal_text_all_w_t_and_m_t":"This field is not used in this version of the specification and the UE ignores the received value.","paragraph_zero_based":22953},{"literal_text_all_w_t_and_m_t":"mpe-ProhibitTimer","paragraph_zero_based":22954},{"literal_text_all_w_t_and_m_t":"Value in number of subframes for MPE reporting, as specified in TS 38.321 [3]. Value sf10 corresponds to 10 subframes, and so on.","paragraph_zero_based":22955},{"literal_text_all_w_t_and_m_t":"mpe-Reporting-FR2","paragraph_zero_based":22956},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report MPE P-MPR in the PHR MAC control element, as specified in TS 38.321 [3].","paragraph_zero_based":22957},{"literal_text_all_w_t_and_m_t":"mpe-Threshold","paragraph_zero_based":22958},{"literal_text_all_w_t_and_m_t":"Value of the P-MPR threshold in dB for reporting MPE P-MPR when FR2 is configured, as specified in TS 38.321 [3]. The same value applies for each serving cell (although the associated functionality is performed independently for each cell).","paragraph_zero_based":22959},{"literal_text_all_w_t_and_m_t":"multiplePHR","paragraph_zero_based":22960},{"literal_text_all_w_t_and_m_t":"Indicates if power headroom shall be reported using the Single Entry PHR MAC control element or Multiple Entry PHR MAC control element defined in TS 38.321 [3]. True means to use Multiple Entry PHR MAC control element and False means to use the Single Entry PHR MAC control element defined in TS 38.321 [3]. The network configures this field to true for MR-DC and UL CA for NR, and to false in all other cases.","paragraph_zero_based":22961},{"literal_text_all_w_t_and_m_t":"numberOfN","paragraph_zero_based":22962},{"literal_text_all_w_t_and_m_t":"Number of reported P-MPR values in a PHR MAC CE.","paragraph_zero_based":22963},{"literal_text_all_w_t_and_m_t":"phr-ModeOtherCG","paragraph_zero_based":22964},{"literal_text_all_w_t_and_m_t":"Indicates the mode (i.e. real or virtual) used for the PHR of the activated cells that are part of the other Cell Group (i.e. MCG or SCG), when DC is configured. If the UE is configured with only one cell group (no DC), it ignores the field.","paragraph_zero_based":22965},{"literal_text_all_w_t_and_m_t":"phr-PeriodicTimer","paragraph_zero_based":22966},{"literal_text_all_w_t_and_m_t":"Value in number of subframes for PHR reporting as specified in TS 38.321 [3]. Value sf10 corresponds to 10 subframes, value sf20 corresponds to 20 subframes, and so on.","paragraph_zero_based":22967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ae477056699e169e1c80bf9a289a8e27bf237967d7ff6bd92a8b2b86cfac7e00","7b764cb0bfe2e202744a1f9d9e35b75380b5dc9d7c1e6e338d3faddbd864b18a","e4dbeabb558af6cdfb28f2ca22553091d231b8a7aa3b0cd154a7e17c6c902462","33655a5f8263dd5b2cacc1c82ce9fff8a80d