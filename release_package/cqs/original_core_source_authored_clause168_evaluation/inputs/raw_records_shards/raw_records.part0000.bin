{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    k2                                      INTEGER(0..32)                                  OPTIONAL,   -- Need S","paragraph_zero_based":24528},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":24529},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":24530},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24531},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24532},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations-r16)) OF PUSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":24533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24534},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24535},{"literal_text_all_w_t_and_m_t":"    k2-r16                                     INTEGER(0..32)          OPTIONAL,   -- Need S","paragraph_zero_based":24536},{"literal_text_all_w_t_and_m_t":"    puschAllocationList-r16                    SEQUENCE (SIZE(1..maxNrofMultiplePUSCHs-r16)) OF PUSCH-Allocation-r16,","paragraph_zero_based":24537},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":24538},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24540},{"literal_text_all_w_t_and_m_t":"PUSCH-Allocation-r16 ::=  SEQUENCE {","paragraph_zero_based":24541},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                           ENUMERATED {typeA, typeB}                     OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24542},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                  INTEGER (0..127)                              OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":24543},{"literal_text_all_w_t_and_m_t":"    startSymbol-r16                           INTEGER (0..13)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24544},{"literal_text_all_w_t_and_m_t":"    length-r16                                INTEGER (1..14)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":24545},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitions-r16                   ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16} OPTIONAL,   -- Cond Format01-02","paragraph_zero_based":24546},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24547},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24548},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitionsExt-r17                ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16, n20, n24, n28, n32, spare4, spare3, spare2,","paragraph_zero_based":24549},{"literal_text_all_w_t_and_m_t":"                                                          spare1}                           OPTIONAL,   -- Cond Format01-02-For-TypeA","paragraph_zero_based":24550},{"literal_text_all_w_t_and_m_t":"    numberOfSlotsTBoMS-r17                   ENUMERATED {n1, n2, n4, n8, spare4, spare3, spare2, spare1}   OPTIONAL,   -- Need R","paragraph_zero_based":24551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["90338c02add2182c8fe07892194f4789d0befd9900b2c5aacb9e4b1565fc70a7","256a6d88e2a6c0a3dbb9586052dbbd6b2d07c1fbe80474621959db22726582e5","910e1fcc175065d4c6f974252919aa5414ac0de9e990b343b3