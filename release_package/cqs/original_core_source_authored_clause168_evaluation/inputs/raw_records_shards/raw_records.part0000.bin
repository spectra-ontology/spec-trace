{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    logicalChannelSR-DelayTimer         ENUMERATED { sf20, sf40, sf64, sf128, sf512, sf1024, sf2560, spare1}                OPTIONAL, -- Need R","paragraph_zero_based":14928},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14929},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14931},{"literal_text_all_w_t_and_m_t":"-- TAG-BSR-CONFIG-STOP","paragraph_zero_based":14932},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14934},{"literal_text_all_w_t_and_m_t":"BSR-Config field descriptions","paragraph_zero_based":14935},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-DelayTimer","paragraph_zero_based":14936},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on.","paragraph_zero_based":14937},{"literal_text_all_w_t_and_m_t":"periodicBSR-Timer","paragraph_zero_based":14938},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf1 corresponds to 1 subframe, value sf5 corresponds to 5 subframes and so on.","paragraph_zero_based":14939},{"literal_text_all_w_t_and_m_t":"retxBSR-Timer","paragraph_zero_based":14940},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf10 corresponds to 10 subframes, value sf20 corresponds to 20 subframes and so on.","paragraph_zero_based":14941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14942},{"literal_text_all_w_t_and_m_t":"–BWP","paragraph_zero_based":14943},{"literal_text_all_w_t_and_m_t":"The IE BWP is used to configure generic parameters of a bandwidth part as defined in TS 38.211 [16], clause 4.5, and TS 38.213 [13], clause 12.","paragraph_zero_based":14944},{"literal_text_all_w_t_and_m_t":"For each serving cell the network configures at least an initial downlink bandwidth part and one (if the serving cell is configured with an uplink) or two (if using supplementary uplink (SUL)) initial uplink bandwidth parts. Furthermore, the network may configure additional uplink and downlink bandwidth parts for a serving cell.","paragraph_zero_based":14945},{"literal_text_all_w_t_and_m_t":"The uplink and downlink bandwidth part configurations are divided into common and dedicated parameters.","paragraph_zero_based":14946},{"literal_text_all_w_t_and_m_t":"BWP information element","paragraph_zero_based":14947},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14948},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-START","paragraph_zero_based":14949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14950},{"literal_text_all_w_t_and_m_t":"BWP ::=                             SEQUENCE {","paragraph_zero_based":14951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["184be440269ba0f7ec92fd7002c347af687015087dad80c6f563e104f4aa6d47","6f6554632d3dd6679c7ef776967a791f26247f88338ed12be80575f84720a840","271db4fa6306c71213c5ae6881ff1886b11c5fbbde7b8e5bf9f7216292787120","00ae364d92e14a29c82650b95be21d435975b6f769c3899009b606e56d2b3a19","08aedc6473707f9bf9b10a4e341468706774546aef65c8e2c1b65c3613d3ca98","c7b2bcf3c84ac9bc4f98e6f95c83e264684c9bcfbbc07d91bc46870a64708ead","4fd942b613917be035b427893145005af3b272d45edc0f0343a01563cfc2a83e","72bcf29b95f7d639eca60fdba5be46fff97b4eb7044c6443e68265a6367dac83","12bbecad18146adf62d0a3a5f99becb795155a1dade7c6af1f71f809a7dabf2d","83ce41b305f3c9a6592682827c9e2d16f8dab39e37a427d9c1aac94f32478a93","616ca2fdb6b56a72800a06a1f3451057558bc9741d24405523c36d71795e4308","05cc06d6cd04e6ac63b2bd15f865d9b7b53487d1cc4eb7448480cefc34020ec6","82ffa166bbcd23904cffe8ecc754a232d6f1d458f16d0118475fcae581a20ece","d4bae07e3b9166892acd041f9effed8c93493be1029c9c49d2d501ded3636307","cfaeb36bdfdc76f1b4a552fb8efce7d3f462e39652813eda6cf5c9b28df542dd","324e5619af3af6c153e26f56fbf01bc02f3edb5c985d7b59e172c5019f99dcfd","4a15705d83b2e3f559438da1575ae5bcb5a287e152d8b6e9057e4eea1c7063a4","62718f17428a9ba43a98e711ad237ef577959d4d59103550b7be734ce5d60cbd","c27cb0d97510da37e70fce53aab2c8b2b9f70ce98afb54f39c8241be4ba102ba","3420892cc778a3905e15b30db645f5dccc3696ef39251beef9411d70f4f8f96d","60e118637f6b3cc29f9e1659f6391c09b13640d10f7d695c0428b3e4e093f862","5d66e98bb7e899278bb410e01bfa45abfe337d1577f1d66bed4126c3634d035c","b6819101dccf3fa33fae1192c4ce4a00e03c267d7d8a2ef8b8e5b00315339565","53f91f9d5847fb892dcba295ffa473db5a94fe3324cf714d88532966877b1db8"],"paragraph_range_zero_based":[14928,14951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14928"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    locationAndBandwidth                INTEGER (0..37949),","paragraph_zero_based":14952},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":14953},{"literal_text_all_w_t_and_m_t":"    cyclicPrefix                        ENUMERATED { extended }                                                 OPTIONAL    -- Need R","paragraph_zero_based":14954},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14956},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-STOP","paragraph_zero_based":14957},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14958},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14959},{"literal_text_all_w_t_and_m_t":"BWP field descriptions","paragraph_zero_based":14960},{"literal_text_all_w_t_and_m_t":"cyclicPrefix","paragraph_zero_based":14961},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the extended cyclic prefix for this bandwidth part. If not set, the UE uses the normal cyclic prefix. Normal CP is supported for all subcarrier spacings and slot formats. Extended CP is supported only for 60 kHz subcarrier spacing. (see TS 38.211 [16], clause 4.2). Except for SUL, the network ensures the same cyclic prefix length is used in active DL BWP and active UL BWP within a serving cell.","paragraph_zero_based":14962},{"literal_text_all_w_t_and_m_t":"locationAndBandwidth","paragraph_zero_based":14963},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth of this bandwidth part. The value of the field shall be interpreted as resource indicator value (RIV) as defined TS 38.214 [19] with assumptions as described in TS 38.213 [13], clause 12, i.e. setting =275. The first PRB is a PRB determined by subcarrierSpacing of this BWP and offsetToCarrier (configured in SCS-SpecificCarrier contained within FrequencyInfoDL / FrequencyInfoUL / FrequencyInfoUL-SIB / FrequencyInfoDL-SIB within ServingCellConfigCommon / ServingCellConfigCommonSIB) corresponding to this subcarrier spacing. In case of TDD, a BWP-pair (UL BWP and DL BWP with the same bwp-Id) must have the same center frequency (see TS 38.213 [13], clause 12)","paragraph_zero_based":14964},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":14965},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing to be used in this BWP for all channels and reference signals unless explicitly configured elsewhere. Corresponds to subcarrier spacing according to TS 38.211 [16], table 4.2-1. The value kHz15 corresponds to µ=0, value kHz30 corresponds to µ=1, and so on.","paragraph_zero_based":14966},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":14967},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":14968},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":14969},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":14970},{"literal_text_all_w_t_and_m_t":"For the initial DL BWP and operation in licensed spectrum this field has the same value as the field subCarrierSpacingCommon in MIB of the same serving cell. Except for SUL, the network ensures the same subcarrier spacing is used in active DL BWP and active UL BWP within a serving cell. For the initial DL BWP and operation with shared spectrum channel access, the value of this field corresponds to the subcarrier spacing of the SSB associated to the initial DL BWP.","paragraph_zero_based":14971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14972},{"literal_text_all_w_t_and_m_t":"–BWP-Downlink","paragraph_zero_based":14973},{"literal_text_all_w_t_and_m_t":"The IE BWP-Downlink is used to configure an additional downlink bandwidth part (not for the initial BWP).","paragraph_zero_based":14974},{"literal_text_all_w_t_and_m_t":"BWP-Downlink information element","paragraph_zero_based":14975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["98b3667979b7113a9ff65b90176072c247e90eb7d506d1353978a3e9ead7ada9","325a0329c0fdaf5c908d920a1f100d3b0dd410a37c24da0b1696a1fa1826eab5","f71d8511d9dd8b7ab600cbcd4017064cde0d8194d711d052e7d4118f84b551bd","60a2b830c4976257d56a69d8dbccf75644b8aecab93919ce9b051b51bba72c79","dd497102d3daaee29892fda6a36d395ab4ecdec64aecbba9407f14f98e48b98f","ea9e5ef10bc4fccb3d1eca432a5130a9a80e12a52945559c0678035f0cc46cdb","c0db0c0066824b690368c28b6b896064984ef0d5f23c524f20ad76a2b9b6ca54","927813f16f0a45be44b120700757cba133b121466843f6b8f644526c962f774c","be09e133bae4589a02c552703e30590d760ea4a85652962ea4aea59b53a910c5","a5797d644e121d4a0f9718334032e54f493ec2caf57e36059044f221f2fe60e9","b3b9c6e6cf396641f95c7b2cb9cb8855d432a38e804d5051a3652dfce6449215","1fd64441348897042ab855437ebb4035946c0b35dac6e3cc1b2e0f3d863c2461","27f10eba45a838acc230954d84bed1100e196e2047dfc941a31d7827652a64fd","f3c254525db7acfd36996e82a7253487d22e4f7342cf3a82bb0b2b2771a05db9","a85c85b9c4799537f61e3adb253b9d459170c77def54cd5e4f779043601fa083","3b2f0fc312b5a29f0b6bd7f8cbc47a7934a204a32818e4ed034803e984130491","a240ca0f8b52697a633af22a5fb0de1515b472a8842ec76397f9a26f32ea7931","a6c0f9e91274c68618d9e9a5f018848936d592abcd9c9db0cb506438488e80fc","21e52381e8a6e10a660e2c768e2ca7f40db890dedcbb931969f0e2527c825044","66ac78d9960c6fbd03abff4857eef5710c28d2d214701821e16245df28bd29b8","2ccb7931c701ac74feb53073708459f552928fc2fbb95419761fdaaac1d5faed","0f5f5d52078c4ae64dc84d8041c2d54519ad6c099fbbe4af3ccdb4070e8a9857","cabf93cb1ca13613c30516d03b5c953aaaadc3a5bd2783ff54de95fec5b3c874","c638f7b84185c632e20b046666f0911a1e43466232f968e126358f9a1a1d8338"],"paragraph_range_zero_based":[14952,14975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14952"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14976},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINK-START","paragraph_zero_based":14977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14978},{"literal_text_all_w_t_and_m_t":"BWP-Downlink ::=                    SEQUENCE {","paragraph_zero_based":14979},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":14980},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-DownlinkCommon                                         OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":14981},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-DownlinkDedicated                                      OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":14982},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14983},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14985},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINK-STOP","paragraph_zero_based":14986},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14988},{"literal_text_all_w_t_and_m_t":"BWP-Downlink field descriptions","paragraph_zero_based":14989},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":14990},{"literal_text_all_w_t_and_m_t":"An identifier for this bandwidth part. Other parts of the RRC configuration use the BWP-Id to associate themselves with a particular bandwidth part.","paragraph_zero_based":14991},{"literal_text_all_w_t_and_m_t":"The network configures the BWPs with consecutive IDs from 1. The Network does not include the value 0, since value 0 is reserved for the initial BWP.","paragraph_zero_based":14992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14993},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":14994},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14995},{"literal_text_all_w_t_and_m_t":"SetupOtherBWP","paragraph_zero_based":14996},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new DL BWP. The field is optionally present, Need M, otherwise. ","paragraph_zero_based":14997},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14998},{"literal_text_all_w_t_and_m_t":"–BWP-DownlinkCommon","paragraph_zero_based":14999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d7fcb33b331a3615234e20fa31f5f658dc8dd22064b89240467aff67ea9e7015","4244a45261c9b9a1990f56d7892ad4f4e1285574e54894e9399816e174dbde3b","20aa46e1507ea9c09c2694cbd4013edd6cdfa1d305e202329ff3b2a85b648198","f54abc3fabe7bc7287be02f4b8db7ebff2a9a82f6036cfaee4ff0583fa031f04","9c169d83b9244fa3b9b917d6d87d1940212504f026827e971dbcc183adcb58af","4a0e85b43696f715e6822652bd8fdd644f285ccc46757be4c7b3731726036faf","896926c800322f0465a3292f8b6a01f3382a8ca80fd287e3f5452b294fe52e35","57a5c29b760c22fa0b76ce3bab58b2fed82f2b27e8ebd89271623bcfeb3fb93e","cb46a8b62624e38f9ea9cf3a829c567492095dbdcd95c4833bd80458a7ad9a27","c23fd0f34ea631f4b8b167daf3e0f86300bd3ea7f7e485ffae4f4b3400b8c192","c6bf821e9e062bd8c0d7ffc1f063fc68ef6edcbc631327def5fd527b1bb54dad","b9fba478198ddfadae0d366d8d36f6445a127b8b4d4cd87bcbb9cdf900c05615","a121454779ff9879c3a3d8afa3310e85800c2b34d262e742ede89695bdbe5d17","fba541cc98777b4c2d90fb5c40d34dea72adf8d0ce3e33a597e80aaa921c308e","a3d2c7eab303457d3262f93b0b136187c8b5d73d5a4593f56f505a5a2af14ae8","9c7b2d9635f457b582c44d7155cbeed2a461a0d084410f50ba84f02a6efd0e6a","186860cb96cb6cea156394cfc42cf2569d4f1229b1149bd6e583b5e8ff8e8a83","307a0f4493bf74481e048abd3877db174f8e9d016f3a17cea1dd872c7e3e42d0","3742b820560cd4c69a26ed3d18bcf4382069d72ba35ec91f4f8502e2b3aaeefe","9bda4445cc823f9713944e2e6edc355f16907ab45a5f45e2d0fe9f6150668c73","e87ae20a1184513043f94bdb192a5416bb40093afa3e53cea05eaa2a515ef66e","2599e5eed29e1a1821d353813b90fee29761a92111132729fc46a6bcd5a3db43","933679fa9a1ca16a38aa6c63fabcf242672ac1698862aa99320b71824f1ee7e6","2daab00f58be5d82ee2de7299a3f1e06996323f46d89ccc6710c7d348f5a8dd9"],"paragraph_range_zero_based":[14976,14999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14976"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE BWP-DownlinkCommon is used to configure the common parameters of a downlink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":15000},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon information element","paragraph_zero_based":15001},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15002},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKCOMMON-START","paragraph_zero_based":15003},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15004},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon ::=              SEQUENCE {","paragraph_zero_based":15005},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":15006},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigCommon                  SetupRelease { PDCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15007},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigCommon                  SetupRelease { PDSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15008},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":15009},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15011},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKCOMMON-STOP","paragraph_zero_based":15012},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15014},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkCommon field descriptions","paragraph_zero_based":15015},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigCommon","paragraph_zero_based":15016},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PDCCH of this BWP. This field is absent for a dormant BWP.","paragraph_zero_based":15017},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigCommon","paragraph_zero_based":15018},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PDSCH of this BWP.","paragraph_zero_based":15019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15020},{"literal_text_all_w_t_and_m_t":"–BWP-DownlinkDedicated","paragraph_zero_based":15021},{"literal_text_all_w_t_and_m_t":"The IE BWP-DownlinkDedicated is used to configure the dedicated (UE specific) parameters of a downlink BWP.","paragraph_zero_based":15022},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated information element","paragraph_zero_based":15023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["42066cfc7844c4425766e50224ad24242a1b51201310bb7f307f893ada385279","1680e84dabb0b4e1e08fa8275ca71ba21bbefa8542e8d31560fe0266009319a3","5315c8ca5dce88881d8d2059b54503a5292789e078b33be9753375cddde71f3c","a7eea6095c45da67f5d59710718b964f9fdfe82f146d5893ce315175d8a27641","2c50c6458a3dc5a8b2a0860469edd5d0bb0e7d56c01d88af05b4aff879cafd44","7d977fcfed0202f8bc2e837f245cf6beac55d3726e743426baf9a49c8d8b8495","548e8043fa4f01456215edeacf82522c3dcefb5d48ac31ec30f466962f819f69","9b80bf3c54bb72081f742220f34938856da97796de481ffae61ff8fd3b8658be","806336e1f72ed499590667567f989f23ec76aa29151b7efb79ea938f37ec32e8","187220d2c7f69eae9c75535f