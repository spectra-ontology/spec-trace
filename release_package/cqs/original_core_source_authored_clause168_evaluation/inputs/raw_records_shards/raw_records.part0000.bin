{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30265},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELCONFIG-STOP","paragraph_zero_based":30266},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30268},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig field descriptions","paragraph_zero_based":30269},{"literal_text_all_w_t_and_m_t":"uu-LogicalChannelIdentity","paragraph_zero_based":30270},{"literal_text_all_w_t_and_m_t":"Indicates the logical channel id for Uu Relay RLC channel of the L2 U2N Relay UE.","paragraph_zero_based":30271},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelID","paragraph_zero_based":30272},{"literal_text_all_w_t_and_m_t":"Indicates the Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":30273},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":30274},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established.","paragraph_zero_based":30275},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":30276},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":30277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30278},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30279},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30280},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":30281},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":30282},{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":30283},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":30284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30285},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelID","paragraph_zero_based":30286},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelID is used to identify a Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":30287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3ce962b61f3d6eb5b6f8b307d9b105a6223f8df91e4f8219379361766658f984","8cbe8cf0e04a13905c9ad0ca40b09c50d8bb0d8c18846027fdf9ad17b730adf4","59d3a5b89060f5d33375c50e6e215828931c4d629f42ab6a7f4b5fe6722adc99","1af6013fe26e20241d3557fd73addb5cf29b7a26d71e6783f69294c33d8bf948","63b29d421998fb01e7cff1304c17286b126fae370446b13680de1e814fc908f1","b4e9db49546592175643e0190c969647a05d5e8594397733e70a084d022a837d","57be1c85a7efa60f10b2d84222fc8782bbc569b6188aafdb1accb55afa46d943","1c344f504cb639bb67de22570971baa0b34df8fa7086355595c1eb5db2949fa8","9a5db84c4179242a7d1da4fd6840b6af074c34600821701482f103a1353da86e","d4e67ed07978f48916d201e064d4f2e44cb4287a8b28fdd3023d913c1d934be0","1d5ede29eeba3743df33a93d39179de883e1a45178ba005cf8cd085e8e90aa95","755b5774909e9e555b728e4c10dd615797b03b1b6c91765ab30aff492087c77f","40358fa1ddec488f9240acc3c5691b571e8eae813b2f63a327262713f2afb2db","7a37a0428bf61b7755a9b9301427508b784ca59726a88f79ed0717f662b0ac6c","46dcf30465d5385cc661d1ae3172903249c2a9ab0e85462b4ee8e26227f70b65","699ff34aa9cb81b05b4b9618abd4f258b8716dbaa32a3fa3d22bd4b4b38439e6","2e789451cc915ac90c2e150110bbfb6399f92008b2d487cac627a4c66bc46c6e","08aad759ef7441df8cffe22b4a5f8e5c88da05fd3fb0bb5217a7d789d72c4032","8e8cd5601d9ecede27ecdaf1b47cd39073d0415aaf4f8dc0eb6d79f3c6118074","671981d7e47a64bc76b61f16c2b10e6183123affef4aae4e3b7722bf3fcde095","35eb91df6e19495abc997cd39b6f5bcafebaa163e0b8c394add2c2c7e512e5a5","9134f9adc5224944f360c58f66ebeceb53904a12a715295751bce088bc1845fb","d434eababe5de607f363a14203093f1d93ef4e9986f7243cc5ebbe03bbb755ce","309ae0041021a58f500218968af59e40762139fd914f1d7f92b0653aece21a89"],"paragraph_range_zero_based":[30264,30287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30264"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID information element","paragraph_zero_based":30288},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30289},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELID-START","paragraph_zero_based":30290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30291},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID-r17 ::= INTEGER (1..maxLC-ID)","paragraph_zero_based":30292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30293},{"literal_text_all_w_t_and_m_t":"-- TAG-UURELAYRLCCHANNELID-STOP","paragraph_zero_based":30294},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30295},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30296},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentList","paragraph_zero_based":30297},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentList indicates the Tx Direct Current locations per serving cell for each configured UL BWP in the serving cell, based on the BWP numerology and the associated carrier bandwidth.","paragraph_zero_based":30298},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentList information element","paragraph_zero_based":30299},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30300},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-START","paragraph_zero_based":30301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30302},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentList ::=           SEQUENCE (SIZE (1..maxNrofServingCells)) OF UplinkTxDirectCurrentCell","paragraph_zero_based":30303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30304},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell ::=           SEQUENCE {","paragraph_zero_based":30305},{"literal_text_all_w_t_and_m_t":"    servCellIndex                           ServCellIndex,","paragraph_zero_based":30306},{"literal_text_all_w_t_and_m_t":"    uplinkDirectCurrentBWP                  SEQUENCE (SIZE (1..maxNrofBWPs)) OF UplinkTxDirectCurrentBWP,","paragraph_zero_based":30307},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30308},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30309},{"literal_text_all_w_t_and_m_t":"    uplinkDirectCurrentBWP-SUL              SEQUENCE (SIZE (1..maxNrofBWPs)) OF UplinkTxDirectCurrentBWP               OPTIONAL","paragraph_zero_based":30310},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44394f96c07da1483be59216a7bb357766f7fe67de054d28714c4634f5589e41","1b430b3ea14262ca273af4c0f4818672ac86e0f38c19409b5c4df46cf683b14d","3ccf13430e9cd06f21c2bcf46253d849fd8a41216454b74437645e7bfb5102ee","611b52c3b95fbfb6ed8c3ca8f128f8eb25cde48e874a5151651146d007605d62","67b3d0d8eb47e9f024e7246826df6d8a305c0ea33a3c154cfaa9892952871c5b","08f1c1386777e693bd5d95c1fe03b520a2018c7cc33cced09f9a1377472ec302","97a33e338ab2aabd68f0908aad85f6736425bc841c8a00f5745d26bf81c2d2e7","5ba5adf4de4445c92bbf032ed14027aae0d1099eced0065024a8f4b6b8c52ab5","53fc89e675a59ea622b7da593daef8482e77ab169b10906216c1ea5cc83ef5f1","dfa2c51d54bbd7362dbe5562c71a72c2c04d3cdb758e1ad48fd9a65df0a64e35","2c8430ee06560f59884f1abdb49bb849a08145659fd1568928ace79d10fa2d5f","4dd8a4b596798250edf834cd028a2cb760add21d09d2af17e91a4b06b59c9a92","6f528d9699268f03e848ea7d29372c3c1a138474fb89e88a59184e973dd69287","6213b0c5e65fc211e51142ebce8b165bb94bb658f6e5ee8208e0e82434bbeccd","8705d4d15bf8816540780339c48f62d46adabf0e05e77490fa29815595817bea","5c052fed8510662b088263e9a1454fcb5ef224f9afc9e923bc630b59ded35b5b","ed3eb84527330269b8786eef683ef9361262cb652e8ec3a74e17abd23c10c4b6","dcc11af4da8ae8b2c584106dde65c9a8066f32611e380eef2a521ad49c1ec64a","a16e61b047c18362ebcb8456582a2fb3a1e1c6fddd9d916e85e605fbf13787da","7f0d93a3a724b20e2944e1a6c050c5246671ae130442cd40f87f3d8fc1fa637f","3ae0cca52e914f8c55938406bdf8d091ce4bbabec501477a1d179c7a15f62b30","5a43bea6e32ef90bc7a4b48f8000e79864cd7c70199ced07da56945e5c7abfc5","452e1aa07e52c69dd392171c0334cb0d65deca616526f89c99ff3f114f403e1e","ccf284c5ce3cf13462ab52b15b688ee372c2da8bab9aa20e55cb233002074728"],"paragraph_range_zero_based":[30288,30311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30288"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30313},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP ::=            SEQUENCE {","paragraph_zero_based":30314},{"literal_text_all_w_t_and_m_t":"    bwp-Id                                  BWP-Id,","paragraph_zero_based":30315},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz                           BOOLEAN,","paragraph_zero_based":30316},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation                 INTEGER (0..3301)","paragraph_zero_based":30317},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30318},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30319},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-STOP","paragraph_zero_based":30320},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30322},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP field descriptions","paragraph_zero_based":30323},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":30324},{"literal_text_all_w_t_and_m_t":"The BWP-Id of the corresponding uplink BWP.","paragraph_zero_based":30325},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":30326},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":30327},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":30328},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding uplink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":30329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30330},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell field descriptions","paragraph_zero_based":30331},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":30332},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell corresponding to the uplinkDirectCurrentBWP.","paragraph_zero_based":30333},{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP","paragraph_zero_based":30334},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":30335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a7486914ea048fca3bac94cf270728ec22975000e2d3b84be5e8ae7fc8292156","829c7168ef5721c4d01f2f3560db1458c0246ad60a1098eeb43f222072cdb3e1","8b629f8915b46648c23abe9832ce3466c6cf5e8b4fa5118b5c0afefab33e4949","1655a937d0069e4185d42910b81b3294e4137d7bd6319d8af354859330f25da2","a6675bed321f8331108a7ce2d9a7cb7e429b6712510aa889e713adaf8760bb27","fbbdea6fa829fc214acc1343cf9516487d151eaef3af64cf2a30ff3d4f8ba711","b62dffd2b7b0598bddc49487cddcc11fd1cc62929e4a78596ec5abb4a0827947","c43e174000dade741b2e9a14e189b637482c41fafc64a63135e23c39850d1ae1","786e682c7e5c675c62fef524718dd2471975dd77325dcae18118b397a169b739","e77fad4b5177ff86cb448e235e448b97d9ab57ed4e1867781e554b1f3463fc87","6da9bbd8fb6fdf165a060e5