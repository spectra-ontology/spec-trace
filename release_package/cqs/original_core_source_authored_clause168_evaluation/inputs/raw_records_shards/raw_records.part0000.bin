{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the ssb-PositionQCL-CellsToAddModList:","paragraph_zero_based":4416},{"literal_text_all_w_t_and_m_t":"5>if an entry with the matching physCellId exists in the ssb-PositionQCL-CellsToAddModList:","paragraph_zero_based":4417},{"literal_text_all_w_t_and_m_t":"6>replace the entry with the value received for this physCellId;","paragraph_zero_based":4418},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4419},{"literal_text_all_w_t_and_m_t":"6>add a new entry for the received physCellId to the ssb-PositionQCL-CellsToAddModList;","paragraph_zero_based":4420},{"literal_text_all_w_t_and_m_t":"3>if the received measObject includes the cca-CellsToRemoveList:","paragraph_zero_based":4421},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the cca-CellsToRemoveList:","paragraph_zero_based":4422},{"literal_text_all_w_t_and_m_t":"5>remove the entry with the matching physCellId from the cca-CellsToAddModList;","paragraph_zero_based":4423},{"literal_text_all_w_t_and_m_t":"3>if the received measObject includes the cca-CellsToAddModList:","paragraph_zero_based":4424},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the cca-CellsToAddModList:","paragraph_zero_based":4425},{"literal_text_all_w_t_and_m_t":"5>if an entry with the matching physCellId exists in the cca-CellsToAddModList:","paragraph_zero_based":4426},{"literal_text_all_w_t_and_m_t":"6>replace the entry with the value received for this physCellId;","paragraph_zero_based":4427},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4428},{"literal_text_all_w_t_and_m_t":"6>add a new entry for the received physCellId to the cca-CellsToAddModList;","paragraph_zero_based":4429},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4430},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received measObject to the measObjectList within VarMeasConfig.","paragraph_zero_based":4431},{"literal_text_all_w_t_and_m_t":"5.5.2.6Reporting configuration removal","paragraph_zero_based":4432},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4433},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":4434},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":4435},{"literal_text_all_w_t_and_m_t":"2>remove all measId associated with the reportConfigId from the measIdList within the VarMeasConfig, if any;","paragraph_zero_based":4436},{"literal_text_all_w_t_and_m_t":"2>if a measId is removed from the measIdList:","paragraph_zero_based":4437},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4438},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["2cd86abd9bb7945dcedf45ad243d56bb9ab4e7420005046d7b4d706cadd0e03f","a307196e9f077b6c45496a01ed64da3818b089818dc33b1cf8e2cf31bd539e90","f91c276d8199d4e8103df3993775f5019c2560ec669e4764c8fec5830b0d9651","80c55ecd9ea5f24cedab7973225c35c8b916435854584b8319cc653607c0235a","e14f35b587e5495a92e90f6ed58f483a09a173dfb0ada4300c028e82d759367f","b9d634633d2fb871b81365bb48eebb3a064de0cae3ca6874216b3a5bdf4cd615","ebdf2558693de75d089584b779e6ec05bd83021a0e7967a1406acbe99f2cd0b0","f68da4772de72ff93aebcd1b168a5f7cb4daab18aee5f0deebeb7d5a612bf083","669c40b181ecedf8a60a2b4be62cd1d99176c7b87c94ebf3ae56ed763aee47f7","e9b154f24a0b1d6f20be510204748c3abb1eb9a67ad36d94721fdfe6ba7fadb1","aa7bead876659d5217d1f308ce9ccb091ca9573a6d24991217d3b876e13e8ad2","9ed7a446badfefa3cd4ca63b0ba044090051f2df3fc109cff9fd63706537248c","732ab510eecde21032ebe0b1a74cc95a201339b648d22d5b19742c9c2140d074","5b3397b4618c383f638eda6e42171ccd446d98e6a4152d1de3161d9d4212dc64","01fd365c12e50f41056f2ed499962bf822665e1dfa8ff168aefb530ba3522e74","67a5b3faaa3e58f603d88ff91b848811358a0ed736abc96bbc6fcf9ea1f1a180","269dffa1b6945f64ed0fad874d6457bbe41b77c8c7583af9df647beeb70aa12c","b5b87c776e4d7ccc3961dbccebbb57eb30bf8325d2ce79301bb6b7b4d216a243","0264480876a7f16cef23e4b966d5cfbe54233ef88b68b25785d1d6b6d58ce92c","864199e0cf67318df59d83cdf6710e2606da7324bf9a436454c745d14712555d","08954fd491f87ce57004073b9364236df74c2b6e0fd4be17196eb19c6fc2ef66","e33d802ada31ce69b6b6bdf048a3161d5462e90587a8532ddb6d480e332baefa","5156860ff5b2dcff625ccb6fa7b79204f63982115c8e7f089d97736bb11e7825","689da5b306b20e5751b9aa63db876b28ed1790a9e0d11c6184b0bb475561276d"],"paragraph_range_zero_based":[4416,4439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p4416"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the reportConfigToRemoveList includes any reportConfigId value that is not part of the current UE configuration.","paragraph_zero_based":4440},{"literal_text_all_w_t_and_m_t":"5.5.2.7Reporting configuration addition/modification","paragraph_zero_based":4441},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4442},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToAddModList:","paragraph_zero_based":4443},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching reportConfigId exists in the reportConfigList within the VarMeasConfig, for this entry:","paragraph_zero_based":4444},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry with the value received for this reportConfig;","paragraph_zero_based":4445},{"literal_text_all_w_t_and_m_t":"3>for each measId associated with this reportConfigId included in the measIdList within the VarMeasConfig, if any:","paragraph_zero_based":4446},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4447},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":4448},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4449},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received reportConfig to the reportConfigList within the VarMeasConfig.","paragraph_zero_based":4450},{"literal_text_all_w_t_and_m_t":"5.5.2.8Quantity configuration","paragraph_zero_based":4451},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4452},{"literal_text_all_w_t_and_m_t":"1>for each RAT for which the received quantityConfig includes parameter(s):","paragraph_zero_based":4453},{"literal_text_all_w_t_and_m_t":"2>set the corresponding parameter(s) in quantityConfig within VarMeasConfig to the value of the received quantityConfig parameter(s);","paragraph_zero_based":4454},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":4455},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":4456},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":4457},{"literal_text_all_w_t_and_m_t":"5.5.2.9Measurement gap configuration","paragraph_zero_based":4458},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4459},{"literal_text_all_w_t_and_m_t":"1>if gapFR1 is set to setup:","paragraph_zero_based":4460},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap configuration configured by gapFR1 is already setup, release the FR1 measurement gap configuration;","paragraph_zero_based":4461},{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap configuration indicated by the gapFR1 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":4462},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":4463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1