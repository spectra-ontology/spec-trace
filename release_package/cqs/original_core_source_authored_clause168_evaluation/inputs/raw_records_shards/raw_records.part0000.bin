_zero_based":118},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"2bd06981bfa1735db77ada95dc726f733939bc78990db1a54790e7b1527f9b39","original_member_sha256":"ea7cb980358ba72e01e1d7f194ddf360632247511118ed9bd841957f774703d8","paragraph_ElementTree_utf8_XML_sha256":["f01f3a2c1315c9049d327d5f0ba545d1369f415c4e2b03427c54f6f03d64f8b2","447b6f395df4a83738e169fff0764465a783dca2bff48ef0e6134cfc28a504cb","6da908accd7ccc70218bd4f35b94d0dcc72fb3dcd4dc886a43c9be71d6747cd6","6ee2aaaceec3ab3aa589ceaa79bc99648fdf2ab7974cbcc626ebf428c64b2301","3a266d7ed8d44fcafa4afca8b596053f63bac41807356e4e43db951a34fa5a94","6534760722694686391fa2baa128f4318a105be0fa7e26e59d5f6b31dadaefcc","f4618530f48987b7ab5c25fa37d142728cdfcc216340dcb5e3c940cfb30f3f4d","567f41a2a2d72a241578aec709c8e05751a6a07d0a0d4882cf96a891d40d963e","dbb25c261d9d8030f86587739746f4721148ea98cde26321430f3b6915ab73ac","eb6607bbc0ab991a16801cbe0646c3548a1804167ae9cc53d6256f1ac1dfed66","7dd7c67af149823ee1788e896260c5d1e84cba959d62b14515591d0ac34e6796","1662fdabf9ffa7f384efa6c46b162432d8a8e8ab3d1b130ed9165d4b79d2cb2d","b6487b87f9642ee3373d3e570669eb054c85c3d0c3d7ffb33c962b3fb4e93d09","0639880507f201db791779144a674dcb7ecec4b1edde2ca1a222de73c2b50dc1","98f24e1414768aa98b8cf2b3307bd3470925f38a61fb3de0bbdddf467a7a4388","d302cddbc2b28eced6a89e9ca9f1983c6d21aba2c119a2e4d5ec02f3e56aad58","ba77da599a5ba23ce6b74bae81cd7d8277e3c2c563c458c7b69de420f36a26e5","219ea3ad8a60c91b69af99743b31748f014587c00d238cadfce5010412d73e8c","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","b5fca8cd33d4647179a4c4ffb639de9f118701c1063027bc