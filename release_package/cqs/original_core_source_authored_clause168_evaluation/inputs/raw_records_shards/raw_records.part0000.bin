{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FlightPathInfoReport field descriptions","paragraph_zero_based":12840},{"literal_text_all_w_t_and_m_t":"timeStamp","paragraph_zero_based":12841},{"literal_text_all_w_t_and_m_t":"Time stamp that describes estimated time of arrival, if available, of the Aerial UE at the corresponding wayPointLocation.","paragraph_zero_based":12842},{"literal_text_all_w_t_and_m_t":"wayPointLocation","paragraph_zero_based":12843},{"literal_text_all_w_t_and_m_t":"Location coordinates of the planned waypoint. Parameter type LocationCoordinates defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":12844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12845},{"literal_text_all_w_t_and_m_t":"–UEPositioningAssistanceInfo","paragraph_zero_based":12846},{"literal_text_all_w_t_and_m_t":"The UEPositioningAssistanceInfo message is used to provide positioning assistance information as requested by the Network.","paragraph_zero_based":12847},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12848},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12849},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12850},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":12851},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo message","paragraph_zero_based":12852},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12853},{"literal_text_all_w_t_and_m_t":"-- TAG-UEPOSITIONINGASSISTANCEINFO-START","paragraph_zero_based":12854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12855},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo-r17 ::= SEQUENCE {","paragraph