{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommonSIB is used to configure cell specific parameters of a UE's serving cell in SIB1.","paragraph_zero_based":28056},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB information element","paragraph_zero_based":28057},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28058},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-START","paragraph_zero_based":28059},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28060},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB ::=      SEQUENCE {","paragraph_zero_based":28061},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommonSIB,","paragraph_zero_based":28062},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":28063},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":28064},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                           OPTIONAL, -- Need S","paragraph_zero_based":28065},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                SEQUENCE {","paragraph_zero_based":28066},{"literal_text_all_w_t_and_m_t":"        inOneGroup                          BIT STRING (SIZE (8)),","paragraph_zero_based":28067},{"literal_text_all_w_t_and_m_t":"        groupPresence                       BIT STRING (SIZE (8))                                   OPTIONAL  -- Cond FR2-Only","paragraph_zero_based":28068},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":28069},{"literal_text_all_w_t_and_m_t":"    ssb-PeriodicityServingCell          ENUMERATED {ms5, ms10, ms20, ms40, ms80, ms160},","paragraph_zero_based":28070},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                      OPTIONAL, -- Cond TDD","paragraph_zero_based":28071},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":28072},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28073},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28074},{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":28075},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":28076},{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":28077},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":28078},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16      ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}               OPTIONAL, -- Need R","paragraph_zero_based":28079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e752a794701f3a386acefac6c690fd9ab183d330a718825d762b60283be2e440","d58db3222cbb07f743d7fc3a3d9614a46994412642ff055b53e6119aa381bfa8","0ea47c89384a170758d3f996bfa0eaad56d7cc40b78cda5ead0a86f22e6f735e","905abb8f2771eac73ad300427692cc644a0ef2e7090d60491670554216a5f1c3","228a3a663350