e1882c64075f30f2d11999bd8180ae5448daeec224a04c92eabb513a68","73d0ad8b11881f72ba9a51fc09bfbf1829cc78358010ea2c872a972049f041de","713d3f94ce4be3cab88ba0e52fdf443109683ec2e7a3e8d094cf91b4d1f9d312","25642832c7da6ed81da30d858ba39b62c50a0854bd0b47d7193e8db7e4039180","c1d001b1cc69283f079c761c56dc23e66519a488a8716c12d0097ad7e9ea585a","f7b87f39c6b260bbd15f0c439236919c18ecb1a98ad8aad7a3783a9a6ab1b231","45405c968ffd270afd6a8c4f65d03309c75dfb479636e16b7e739bad6acd5ec1","b1e13ce9acae17b680fd9b4fc0472da1cccbd11293d9ec503d00d45da4e06c85"],"paragraph_range_zero_based":[3408,3431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3408"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"granularity-r17LOS-NLOS-IndicatorGranularity2-r17,","paragraph_zero_based":3432},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":3433},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":3434},{"literal_text_all_w_t_and_m_t":"scheduledLocationRequestSupported-r17ScheduledLocationTimeSupportPerMode-r17","paragraph_zero_based":3435},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":3436},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-AssistanceDataValidity-r17SEQUENCE {","paragraph_zero_based":3437},{"literal_text_all_w_t_and_m_t":"area-validity-r17INTEGER (1..maxNrOfAreas-r17)OPTIONAL,","paragraph_zero_based":3438},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":3439},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":3440},{"literal_text_all_w_t_and_m_t":"multiMeasInSameMeasReport-r17ENUMERATED { supported }OPTIONAL,","paragraph_zero_based":3441},{"literal_text_all_w_t_and_m_t":"mg-ActivationRequest-r17ENUMERATED { supported }OPTIONAL","paragraph_zero_based":3442},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":3443},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":3444},{"literal_text_all_w_t_and_m_t":"locationCoordinateTypes-r18LocationCoordinateTypesOPTIONAL","paragraph_zero_based":3445},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":3446},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":3447},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3448},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":3449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3450},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-ProvideCapabilities field descriptions","paragraph_zero_based":3451},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-Mode","paragraph_zero_based":3452},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-AoD mode(s) supported by the target device.","paragraph_zero_based":3453},{"literal_text_all_w_t_and_m_t":"periodicalReporting","paragraph_zero_based":3454},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports periodicalReporting. This is represented by a bit string, with a onevalue at the bit position means periodicalReporting for the positioning mode is supported; a zerovalue means not supported. If this field is absent, the target device does not support periodicalReporting in CommonIEsRequestLocationInformation.","paragraph_zero_based":3455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["13da6f00393d5038800de4301255278f5f6a14d7053049c220596ab6e8a2c7a8","e0e5739805830ddfadec889aaf18c1799c0e13b59c4437f7a0479b90639bf3d4","9a0b0a7444cc2f64075eaf5a27bf6914399bc15fc744872a5dd86d7fe05057cd","65e4ce86426cc4dbe56ccc5ad9726d0cd25e022942c20a1628163de7162ae659","65fbf52c899337388de09aa652294f39dbd3870ce252b160b41fa07168a1c10f","4ff4c2fd5a7230542ba165a24a768a515657262556f95fd1c5010dcd26de703f","d108094a2133adcfecd0b03a587e6cd8c94421fc4f68377da46c5bedd11c0cf0","df928a70f04dff190bf6ef9f97fe494588d4bac0656c2d3ac9f06b40af1b0048","0cdfe6d43bb6d0924dc55d811845e8144a7c6b16a73893b647262ee661af8b34","816685371808802775421be0798e2cd3f2912829978a342b6fc732f0a307882b","452d66154d0444e7a3182010aa63a75642eacec8c8f7a006b6df59704627dce6","a2faf7531c849fd65102b17d01c4e56ab5f20cab9042c053609de11820f2b899","af0fc8eceeaceee0f622a70fa3e18b1a58f38a666e8c2b8bcb5bcbdc9a45d806","d672ddcb5a128f24c12f24f3aad955bfdb4dacf424fccf362e7f677d66481640","1c1b24f216d7c2780cc55e5bfd9b997ab0905aeb2ebb2017f939be8711f6e569","6aeb7b6f639fa17afd2406743f1d37cc4e1b6ad0e58fc148700853b2f91096bd","0760d8e87c2449a044b3bb2302bca1122763692c1ee31441d5303085aad69563","b5a9d16501ac358b129f48c48027c0fec32c8516a6bd6f8e3343467db771789f","7eda5b78f7830f1c3f8ff6e9b2ce700db8cfb7ccb1a3f9a822630a18248f0a75","9caed798198b972cae8b23abf32602588f0fd31f247cc3c35cf22af0cdaa42bd","28967747f7721593458c8a9ae9c06240e4a8140b4bf8aebfdea86326e0ea4453","6b925f657e0703dddfa06c2d7b79788b6044d1c5e23e08de9bb70194b22050c5","23f11788e9080fa08d72c5fcacb3f2e009264ad52100a891198ea4ee2f31a169","8675c9c8e033b5d79d1d549322c977c93e9c7e585ea9ce2a0e64f6566d974124"],"paragraph_range_zero_based":[3432,3455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3432"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ten-ms-unit-ResponseTime","paragraph_zero_based":3456},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports the enumerated value 'ten-milli-seconds' in the IE ResponseTime in IE CommonIEsRequestLocationInformation. This is represented by a bit string, with a onevalue at the bit position means 'ten-milli-seconds' response time unit for the positioning mode is supported; a zerovalue means not supported. If this field is absent, the target device does not support 'ten-milli-seconds' response time unit in CommonIEsRequestLocationInformation.","paragraph_zero_based":3457},{"literal_text_all_w_t_and_m_t":"nr-PosCalcAssistanceSupport","paragraph_zero_based":3458},{"literal_text_all_w_t_and_m_t":"This field indicates the Position Calculation Assistance Data supported by the target device for UE-based DL-AoD. This is represented by a bit string, with a onevalue at the bit position means the particular assistance data is supported; a zerovalue means not supported.","paragraph_zero_based":3459},{"literal_text_all_w_t_and_m_t":"-bit 0 indicates whether the field nr-TRP-LocationInfo in IE NR-PositionCalculationAssistance is supported or not;","paragraph_zero_based":3460},{"literal_text_all_w_t_and_m_t":"-bit 1 indicates whether the field nr-DL-PRS-BeamInfo in IE NR-PositionCalculationAssistance is supported or not;","paragraph_zero_based":3461},{"literal_text_all_w_t_and_m_t":"-bit 2 indicates whether the field nr-RTD-Info in IE NR-PositionCalculationAssistance is supported or not. The UE can indicate this bit only if the UE supports prs-ProcessingCapabilityBandList and any of maxNrOfDL-PRS-ResourceSetPerTrpPerFrequencyLayer, maxNrOfTRP-AcrossFreqs, maxNrOfPosLayer, maxNrOfDL-PRS-ResourcesPerResourceSet and maxNrOfDL-PRS-ResourcesPerPositioningFrequencylayer. Otherwise, the UE does not include this field;","paragraph_zero_based":3462},{"literal_text_all_w_t_and_m_t":"-bit 3 indicates whether the field nr-TRP-BeamAntennaInfo in IE NR-PositionCalculationAssistance is supported or not.","paragraph_zero_based":3463},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-AssistanceDataSupport","paragraph_zero_based":3464},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the NR-DL-PRS-ExpectedLOS-NLOS-Assistance in IE NR-PositionCalculationAssistance:","paragraph_zero_based":3465},{"literal_text_all_w_t_and_m_t":"-type indicates whether the target device supports 'hard' value or 'hard' and 'soft' value in LOS-NLOS-Indicator in IE NR-DL-PRS-ExpectedLOS-NLOS-Assistance.","paragraph_zero_based":3466},{"literal_text_all_w_t_and_m_t":"-granularity indicates whether the target device supports nr-los-nlos-indicator in IE NR-DL-PRS-ExpectedLOS-NLOS-Assistance 'per-trp', 'per-resource', or both.","paragraph_zero_based":3467},{"literal_text_all_w_t_and_m_t":"The UE can include this field only if the UE supports one of maxDL-PRS-RSRP-MeasurementFR1, maxDL-PRS-RSRP-MeasurementFR2,dl-RSTD-MeasurementPerPairOfTRP-FR1, dl-RSTD-MeasurementPerPairOfTRP-FR2, maxNrOfRx-TX-MeasFR1, maxNrOfRx-TX-MeasFR2, supportOfRSRP-MeasFR1 and supportOfRSRP-MeasFR2 . Otherwise, the UE does not include this field.","paragraph_zero_based":3468},{"literal_text_all_w_t_and_m_t":"NOTE:A single value is reported when both Multi-RTT and DL-TDOA are supported.","paragraph_zero_based":3469},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Sup","paragraph_zero_based":3470},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the NR-DL-PRS-ExpectedAoD-or-AoA in NR-DL-PRS-AssistanceData. ","paragraph_zero_based":3471},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-BeamInfoSup","paragraph_zero_based":3472},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the NR-DL-PRS-BeamInfo in IE NR-DL-AoD-ProvideAssistanceData.","paragraph_zero_based":3473},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourcePrioritySubset-Sup","paragraph_zero_based":3474},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports the DL-PRS-ResourcePrioritySubset in IE NR-DL-PRS-Info. Enumerated value indicates the supported resource set relationship for the target DL-PRS Resource and the associated subset.","paragraph_zero_based":3475},{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-On-Demand-DL-PRS-Support","paragraph_zero_based":3476},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports on-demand DL-PRS requests.","paragraph_zero_based":3477},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorSupport","paragraph_zero_based":3478},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports nr-los-nlos-Indicator reporting in IE NR-DL-AoD-SignalMeasurementInformation.","paragraph_zero_based":3479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["a35f4051be9c125a56afe6ce0a547cba5a768a15d6a8986cf48dc0af0d1b1af7","b874bd56366675b7b82d42bde150f3b0653edcb594f7621199b2a90d7a3042b0","2f17484a47519c4c53744a33b68bf0750570fb1c9139b0d6d6e07ada6dd46841","e74b235524438f701f2721fb113068687e7e8fb18e8acc6488dd61ab1e398443","8844136c52e993252be41574e7a85462bbad69922109f2a640adde8010566e92","819ec26cb12d3fee02b02c0a2f3c97d4ede0a7b7e742d59b1f87e1773f2d03cc","c567cbd7e564dc4bb13b328adae3a81ea8215141a067328ada21d6d4bb7d3729","07f9fe8ea3104ecf7743ffe1f8e0fb0f9ea21874bd6a6c9e6f180ab0294139b6","4e65f964dfbcd50c8e2f9ea982f5fb0351da03c4f50e3686f9bfbfceda0bb048","69a258fa67a6919e55f84ad3a1e6e23a17d1d1471c923af7cd8b82e5f97614cc","cd89e82cfe8cd15577e27eb4858453a66a3909d321f1611f3909f99c5562ca22","22edfdeae9412699b93a88fa70f3993b3d5dd5df3e9a51c19f7e9f75b3521ece","9399c8a3a6adece1805b41fafa0ac8a9520cf606dac3819176f56423b139919d","cac3e7ef95e915dc496c9e28a61f0baa759dc6f24b80f7b38e52eb45b9abfd06","e84ae9e97084c98b307b08eb3b2b8b25ee94cddcde96fc556a690423059f819e","05295a1a7c774e8839d9e3e7856c33f196ebd055c35198a729cea8232984bf85","11273db08006b8fc05ee5db928e87fdcbebe6f06da5bcfaef531c3c563858041","a98a684adbb1625370b2a2668806a7afc668f7e83709e04f84c0f665b2a9ab9f","aab9adb07c623af0463f3a0ad8a8296c3f8f894de013b015a646f62ffabdd666","4ddeb2518133f53227d5a03bc150f2598de5ef4a023f373cbb78121f3ba2af85","a4f707934053971a2857ada1a10db48612a3c6d763e80c96998bb34809ad94f0","82ad445f3867b726a449e99edf2f246a15c8d437ec3a34d62c872d8996cbfae1","8a3a96e7bbdbe2c7097717c48cdf4067a60b13b894b9e21c6c851b997be719aa","d17eb3ab5fe1b98cb3a76e1a7006eb92d6797edd66e35019a410795aa9cd354e"],"paragraph_range_zero_based":[3456,3479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3456"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-type indicates whether the target device supports 'hard' value or 'hard' and 'soft' value in IE LOS-NLOS-Indicator.","paragraph_zero_based":3480},{"literal_text_all_w_t_and_m_t":"-granularity indicates whether the target device supports LOS-NLOS-Indicator reporting per TRP, per DL-PRS Resource, or both.","paragraph_zero_based":3481},{"literal_text_all_w_t_and_m_t":"scheduledLocationRequestSupported","paragraph_zero_based":3482},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the positioning modes for which the target device supports scheduled location requests – i.e., supports the IE ScheduledLocationTime in IE CommonIEsRequestLocationInformation – and the time base(s) supported for the scheduled location time for each positioning mode. If this field is absent, the target device does not support scheduled location requests.","paragraph_zero_based":3483},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-AssistanceDataValidity","paragraph_zero_based":3484},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports validity conditions for pre-configured assistance data and comprises the following subfields:","paragraph_zero_based":3485},{"literal_text_all_w_t_and_m_t":"-area-validity indicates that the target device supports pre-configured assistance data with area validity. The integer number indicates the maximum number of areas the target device supports.","paragraph_zero_based":3486},{"literal_text_all_w_t_and_m_t":"multiMeasInSameMeasReport","paragraph_zero_based":3487},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports multiple measurement instances in a single measurement report.","paragraph_zero_based":3488},{"literal_text_all_w_t_and_m_t":"mg-ActivationRequest","paragraph_zero_based":3489},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device supports low latency measurement gap activation request for DL-PRS measurements. The UE can include this field only if the UE supports mg-ActivationRequestPRS-Meas and mg-ActivationCommPRS-Meas defined in TS 38.331 [35].","paragraph_zero_based":3490},{"literal_text_all_w_t_and_m_t":"locationCoordinateTypes","paragraph_zero_based":3491},{"literal_text_all_w_t_and_m_t":"This field indicates the geographical location coordinate types that a target device supports for UE-based DL-AoD. TRUE indicates that a location coordinate type is supported and FALSE that it is not.","paragraph_zero_based":3492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3494}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["89b95e00140596711af086af1e2a8f2c5c73fc0b24112dde4387aa68d060b084","dc4654f31c8c3141be403ce5857b0ff653eda04ccf7f0cde0ee69944f085f4ef","61b63bcece691866928e3745d1a9098c86fd7fe6a3f2c8680f3df1b4a36b9d0b","b7a5ed63d080763d29c26ea1d4f490e12afc5189d97306215009cd2b2b4598d7","f72a1a67391d1c564e49eb5fe37917bda3d74d1ce19911f762356b1d321b0e31","e902dab87e25cd54ceb1747526d72d0db7ad48d26006d6541024b33a7b8c678c","6eb0f30262adb9a309e23d0563c345aff9567f9ec440d0d78e2ab3151daf76b2","5ac6ecaa3cbd169e3aafbc4025b8b44f1a31eda5a02c0b27438c5194a0c4cbe4","187b47bc8d55bc14ee935306b22985440e40afd6deb3e4bcd6c00e15535548cc","c342662cf63c15dd4632a65b002658451033b7aa31372d075afee1b733e9cdd5","bda3bc67d061c28505af5cbfc0bc79b9e38068c69a0dea21f07f749bdb136ff2","1c70e5577405fc54380686fa1b947d8730ab8c17f05a584ce