{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21624},{"literal_text_all_w_t_and_m_t":"    dl-PRS-r17                  SEQUENCE {","paragraph_zero_based":21625},{"literal_text_all_w_t_and_m_t":"        qcl-DL-PRS-ResourceID-r17       NR-DL-PRS-ResourceID-r17,","paragraph_zero_based":21626},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":21627},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21628},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21629},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21631},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-ResourceID-r17 ::= INTEGER (0..maxNrofPRS-ResourcesPerSet-1-r17)","paragraph_zero_based":21632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21633},{"literal_text_all_w_t_and_m_t":"RepFactorAndTimeGap-r17 ::=  SEQUENCE {","paragraph_zero_based":21634},{"literal_text_all_w_t_and_m_t":"    repetitionFactor-r17         ENUMERATED {n2, n4, n6, n8, n16, n32, spare2, spare1},","paragraph_zero_based":21635},{"literal_text_all_w_t_and_m_t":"    timeGap-r17                  ENUMERATED {s1, s2, s4, s8, s16, s32, spare2, spare1}","paragraph_zero_based":21636},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21638},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-DL-PRS-PDC-INFO-STOP","paragraph_zero_based":21639},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21641},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-ResourceSet field descriptions","paragraph_zero_based":21642},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":21643},{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for all the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs in this resource set. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same bandwidth. Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":21644},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":21645},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to subcarrier 0 in common resource block 0 for the DL-PRS Resource. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same value of dl-PRS-StartPRB.","paragraph_zero_based":21646},{"literal_text_all_w_t_and_m_t":"numSymbols","paragraph_zero_based":21647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["cbac6e7240dcc35858a24f992fa38a112ae7d795c8822cc87aba02b79456c0eb","e5703c91214f15bbca6fc6699f1bf8ee291a0e31c0620f8f8581ec8f91dd3c0d","b9f23a304a624363ddc267379d967155643784dd419407d8cad2f7562304b57e","8ee107f6d1c5c09b8080635295de8aefff66bb33c54d1c49b1fc0d1cc07fe357","9aa83f9ad4f02c35755a4f8e903c8079b1fbe700897dd170bb7de4270898e764","fdbf59ce57272308263fa2446bf68d4b642f159fb0eee2cb40202f8a4fdaee50","6d318688ad36d4b281f58db5c570962b6d5965cccb6701f707a9d372afb2e8e9","487ed2cf515d2b93371738fddd6113373a8a7154a61d9a8be57b9ae23052eb26","98fdff2c24a73343e17456a50ce2ca576fbdfb7a8960ef89134fa882a55899f8","29b2d18d399876feaa913acfe73e203ce03de6368594de91d78556eee7aa3524","b3891b288f5cfc9a5f863c1d83690e98b5c4690f5061c6bef01a181397a54e8b","3a0952458203456c5cb1ab7a0c765e86ee1a0ec0517077e64f75408924c25385","025eaad7dae5f6c80fc1e16c0ea4f14d8128f095a94d002672cf29f985abf565","3dcecc3e759fa81dc8b76c038f886d6671c5dd54449e35fb767598c80c9582ef","53ab03dd7de345bd63d23135cc6eba4131abe30fb9d820da465056827a66ab94","bb05050ba2573c99efe430fb22766e15ed76c47984c8ba733ec1d907ff0bac05","80cd2362f1c7afab5556c5174d2f84c2e9891a726d9a96f27a5e886005794ee6","babcd0e568998a80bdbd2da9aade49970da06a7191319678efc31fd57b772167","eaac1cdd758958ef08d62569280cb47ad8718e3d7c9d831c1ba6f8f38c0a0fcd","a33bad3f8616e09312e574fdab3402ebccc4a12b00e86682ba527c6d5bbfa4c6","776e43c94f17265833899b7a8d0a82a19480d35cc0dcae56476aa97cd1c2935f","63abc6e8902991cc547ab176f8cee05bc85ba2aec906668555842a902577bf6d","2b476542edcc8ea2a991e1ab6684129cc67d2571e49e46652394cc9dd0b3bef0","2b9dab7ca664c67ae9ab31f3f9f725338fdb757e6c1f08d25a15cdf350d9f098"],"paragraph_range_zero_based":[21624,21647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p21624"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the number of symbols per DL-PRS Resource within a slot.","paragraph_zero_based":21648},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":21649},{"literal_text_all_w_t_and_m_t":"This field specifies the periodicity of DL-PRS allocation in slots and the slot offset with respect to SFN #0 slot #0 in the PCell where the DL-PRS-PDC Resource Set is configured (i.e., slot where the first DL-PRS Resource of DL-PRS-PDC Resource Set occurs).","paragraph_zero_based":21650},{"literal_text_all_w_t_and_m_t":"repFactorAndTimeGap","paragraph_zero_based":21651},{"literal_text_all_w_t_and_m_t":"If this field is absent, the value for repetitionFactor is 1 (i.e., no resource repetition).","paragraph_zero_based":21652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21653},{"literal_text_all_w_t_and_m_t":"RepFactorAndTimeGap field descriptions","paragraph_zero_based":21654},{"literal_text_all_w_t_and_m_t":"repetitionFactor","paragraph_zero_based":21655},{"literal_text_all_w_t_and_m_t":"This field specifies how many times each DL-PRS Resource is repeated for a single instance of the DL-PRS Resource Set. It is applied to all resources of the DL-PRS Resource Set. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively.","paragraph_zero_based":21656},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":21657},{"literal_text_all_w_t_and_m_t":"This field specifies the offset in units of slots between two repeated instances of a DL-PRS Resource corresponding to the same DL-PRS Resource ID within a single instance of the DL-PRS Resource Set. The time duration spanned by one DL-PRS Resource Set containing repeated DL-PRS Resources should not exceed the periodicity configured by periodicityAndOffset.","paragraph_zero_based":21658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21659},{"literal_text_all_w_t_and_m_t":"–NR-NS-PmaxList","paragraph_zero_based":21660},{"literal_text_all_w_t_and_m_t":"The IE NR-NS-PmaxList is used to configure a list of additionalPmax and additionalSpectrumEmission, as defined in TS 38.101-1 [15], table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A for a given frequency band.","paragraph_zero_based":21661},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList information element","paragraph_zero_based":21662},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21663},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-NS-PMAXLIST-START","paragraph_zero_based":21664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21665},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList ::=                      SEQUENCE (SIZE (1..maxNR-NS-Pmax)) OF NR-NS-PmaxValue","paragraph_zero_based":21666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21667},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxValue ::=                     SEQUENCE {","paragraph_zero_based":21668},{"literal_text_all_w_t_and_m_t":"    additionalPmax                          P-Max                               OPTIONAL,   -- Need N","paragraph_zero_based":21669},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission              AdditionalSpectrumEmission","paragraph_zero_based":21670},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f12516659262e50c2140fb5aa9fbcc8ecf19da0aedc97f004d8d144fe4a12384","2459dceb22711