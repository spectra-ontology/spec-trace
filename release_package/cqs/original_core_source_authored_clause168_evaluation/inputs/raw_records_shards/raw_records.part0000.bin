{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":38712},{"literal_text_all_w_t_and_m_t":"CBR","paragraph_zero_based":38713},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, when the IE SL-PSSCH-TxParameters is present in SL-CBR-CommonTxConfigList, SL-UE-SelectedConfig, SIB12 or SidelinkPreconfigNR; otherwise the field is not present, need R.","paragraph_zero_based":38714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38715},{"literal_text_all_w_t_and_m_t":"–SL-QoS-FlowIdentity","paragraph_zero_based":38716},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-FlowIdentity is used to identify a sidelink QoS flow.","paragraph_zero_based":38717},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity information element","paragraph_zero_based":38718},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38719},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-START","paragraph_zero_based":38720},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38721},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity-r16 ::=                    INTEGER (1..maxNrofSL-QFIs-r16)","paragraph_zero_based":38722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38723},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-STOP","paragraph_zero_based":38724},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38726},{"literal_text_all_w_t_and_m_t":"–SL-QoS-Profile","paragraph_zero_based":38727},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-Profile is used to give the QoS parameters for a sidelink QoS flow. Need codes or conditions specified for SL-QoS-Profile do not apply, in case SL-QoS-Profile is included in SidelinkUEInformationNR.","paragraph_zero_based":38728},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile information element","paragraph_zero_based":38729},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38730},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-START","paragraph_zero_based":38731},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38732},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile-r16 ::=        SEQUENCE {","paragraph_zero_based":38733},{"literal_text_all_w_t_and_m_t":"    sl-PQI-r16                    SL-PQI-r16                                                  OPTIONAL,   -- Need R","paragraph_zero_based":38734},{"literal_text_all_w_t_and_m_t":"    sl-GFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":38735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e5e975a744a625d5da264bd6a515942ddfdab96114dba0ace7456f2a5e1fd9cb","74c2cd1ec2aa8686c676940e2e8e86650fd39555b2499b9ccfae8a11e0267a24","4ca70f3e418e6d2c6a754ce032b1fa8dec7383a064a177afd8bffcea7a9ee0bd","3deca7dda4a11efe65964ab84ca5426d975cb0607bdb87888cbc23f2126cdbd8","cea068a1150176f00803e226ce84a30b4274a0924b2b13fc4d8f42431cc1e229","5e497f0929b6ce67f9e70771aa991e966d1f551e63d812a1f1ee1efe301ff24b","07fc66961bcafd64d6c96bb67c0dc982c26b550a298402d76077f37e3670df95","91ab22c4bc1021f785429bb2714fe4dc8786f4324a200a2f414a4c9ebce6fb0a","f7f23e47255b56e8131f12bef8cbf18965e7272be7343ead1e3577f0d1e48778","2f8e70a8d8bdf07644bd52598f6eda42753523948d63481891bf563f8a43bf33","aa3bc5e99130a99710ff68b8dce91e8e52aa4900594eeb40d57a5a88eec6bdd4","5319e8ec291a57a1ce94ca226f5300c98981160bd48bfc8acac69b5c64273bb1","c6c125628e4d3f5bcc2e