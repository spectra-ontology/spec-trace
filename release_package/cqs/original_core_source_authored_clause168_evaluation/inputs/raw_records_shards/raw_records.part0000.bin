{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sib9Fallback","paragraph_zero_based":9120},{"literal_text_all_w_t_and_m_t":"Indicates that the UE fallbacks to receive referenceTimeInfo in SIB9.","paragraph_zero_based":9121},{"literal_text_all_w_t_and_m_t":"ta-PDC","paragraph_zero_based":9122},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE-side TA-based propagation delay compensation (PDC) is activated or de-activated. The network does not configure this field with activate, if the field rxTxTimeDiff-gNB is configured.","paragraph_zero_based":9123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9124},{"literal_text_all_w_t_and_m_t":"–DLInformationTransferMRDC","paragraph_zero_based":9125},{"literal_text_all_w_t_and_m_t":"The DLInformationTransferMRDC message is used for the downlink transfer of RRC messages during fast MCG link recovery.","paragraph_zero_based":9126},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB3","paragraph_zero_based":9127},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9128},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9129},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9130},{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC message","paragraph_zero_based":9131},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9132},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFERMRDC-START","paragraph_zero_based":9133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9134},{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC-r16 ::=       SEQUENCE {","paragraph_zero_based":9135},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":9136},{"literal_text_all_w_t_and_