{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on.","paragraph_zero_based":2352},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerConfigList","paragraph_zero_based":2353},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":2354},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigList","paragraph_zero_based":2355},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":2356},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":2357},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":2358},{"literal_text_all_w_t_and_m_t":"t400","paragraph_zero_based":2359},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 as described in clause 7.1. Value ms100 corresponds to 100 ms, value ms200 corresponds to 200 ms and so on.","paragraph_zero_based":2360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2363},{"literal_text_all_w_t_and_m_t":"<<Skip Unchanged>>","paragraph_zero_based":2364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2365},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2366},{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":2367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2368},{"literal_text_all_w_t_and