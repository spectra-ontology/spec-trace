ML_sha256":"7415921573891a3b422a70566bf834f34997fbf688c6bbe9a6822a18366f7dc6","original_member_sha256":"fb9a2ae736bd47dbee922f41b02070f91d504cf37a31fe0a2639ea321127534f","paragraph_ElementTree_utf8_XML_sha256":["1abf07a526d6f61e8a8d9b9f078f0d7fe2c0e218d89169c0fa6233a68f98f412","91e52e6eb680a98232b3d98ce4975ade610609d99fe97b9ad873f76818be184e","f6a3dc2f82c506e670822e36199366d4c7016804dd8f18d600d59d29400226ac","87e261a4fe9a4e44e784863f99e5efc829c19a16243ea77350864c873c0df226","393706177df2100ce59c6ecf8fc246670fae06a549ebbad13181f9861f04296b","8470ea2573fd0db966a0b45506954f5ca66caf78aa090f1b11943115d7096eff","69001447478940ba06326517beb4498143af7b03fb265770714e834acb39d765","80e8da23152d52f2ec37f545a945b94d5803b86f4f2a9ab39d45a220f13e93d2","bde739416edb4e69849e437258bb008bbf1c206d790db657d4a50ff9eb3adfce","9a705d30399fb1f59a390e556457a23bf3393ae6a1ef9ba721a7f39567243a4b","3b617c1028e503d0b35e17a01699e9ec039599e383f39f7b819c60cbc82c2881","5a8fb6c2879184924b79543ce0ea22c012a199de75fd5c32c36e819d668a8d6d","458f03f3d63c4322ffd93a8d5d1a60d7133256e615ff02f0e43b4dbd3753d000","83bff799c0019ed1bb5e51cdb10fe12ef32d7ea3612085f6ce3dadde282fcfec","4bc4e29e2ba24cc277d9c6bafad3d96a4ae9c53af2c41b2f2b80123d0ab7c6d1","d6530ba082f95e0b42c25557978a77639eaad59e0a14e8ef741e4f28a4274b38","7bd381f297727f08988a205c1954dd0ac94429500e1a52c9d858942926d3c7f8","c7c4395d5b53a49afac1e764a7f54dc8f2ca096eb8ef4a46090b5d326d6e7682","7c18da1c4b70c868c423a67e457b59d150520416b7a41ab12952058f6b809122","5817dd3b07b327d2e50313d03ee7da10b49bb80c1a715f74b15aa77bfdafeed1","d2e1827a8fc4c75095d5d4e6891db81d015efda1e4f7b382b7c297f116907548","b831d2d3e124a96571e2507a6569aff3cdae755fbf3c8e345b7bd874bad25637","13c933124b635d0c4f93b7bf419f32f20cc7350b74eb62b89564be529169fcf1","ab11f334dca9d78b4089d55503aeebdb983fa410d5ce82446c02f2eefdbc17dc"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_