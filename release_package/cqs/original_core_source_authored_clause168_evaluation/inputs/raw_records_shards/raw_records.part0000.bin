{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16344},{"literal_text_all_w_t_and_m_t":"–ConditionalReconfiguration","paragraph_zero_based":16345},{"literal_text_all_w_t_and_m_t":"The IE ConditionalReconfiguration is used to add, modify and release the configuration of conditional reconfiguration.","paragraph_zero_based":16346},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration information element","paragraph_zero_based":16347},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16348},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-START","paragraph_zero_based":16349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16350},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration-r16 ::=   SEQUENCE {","paragraph_zero_based":16351},{"literal_text_all_w_t_and_m_t":"    attemptCondReconfig-r16              ENUMERATED {true}              OPTIONAL,   -- Cond CHO","paragraph_zero_based":16352},{"literal_text_all_w_t_and_m_t":"    condReconfigToRemoveList-r16         CondReconfigToRemoveList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":16353},{"literal_text_all_w_t_and_m_t":"    condReconfigToAddModList-r16         CondReconfigToAddModList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":16354},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":16355},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16357},{"literal_text_all_w_t_and_m_t":"CondReconfigToRemoveList-r16 ::=     SEQUENCE (SIZE (1.. maxNrofCondCells-r16)) OF CondReconfigId-r16","paragraph_zero_based":16358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16359},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-STOP","paragraph_zero_based":16360},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16362},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration field descriptions","paragraph_zero_based":16363},{"literal_text_all_w_t_and_m_t":"attemptCondReconfig","paragraph_zero_based":16364},{"literal_text_all_w_t_and_m_t":"If present, the UE shall perform conditional reconfiguration if selected cell is a target candidate cell and it is the first cell selection after failure as described in clause 5.3.7.3.","paragraph_zero_based":16365},{"literal_text_all_w_t_and_m_t":"condReconfigToAddModList","paragraph_zero_based":16366},{"literal_text_all_w_t_and_m_t":"List of the configuration of candidate SpCells to be added or modified for CHO, CPA or CPC.","paragraph_zero_based":16367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f8c30ef05be9b08135cc1aa5b2b5dc6fdda6b39b25d2443e998a79e5ad2b217e","03d1556049c43bb401ca77475411827510e11792368cb22bf4a6df00622f9f19","8fedc5ded6ea2d0856c9e97e174918d18c7d026b365611f08939b9406e35cbf8","45a2d5ce520cc64297076c3ca310f6663f4d992dc05f2e673b84ff952d0a8e36","d043a9717da6bd4cf94d5bf1482e4453c61291e7cfef698b1e35bb8c3cc456d4","016c894178f595d39f0aace9e6d4946a65cdb201889771536c65fb5a5677c8c3","56ea1d7bb62bd0059bd45ff481720422c9b6f12ba81bf8827df17592a9ed5781","423ed7f92b3ae5852b91baf0386e5398cf374cdfd58894d5b1775f51e22a1d6d","59f70a0f2fa9175d0a64c7470cfb1a201b30460b4c51d8ea0660c6fdbfafe934","5f7c8590a7cee86feba8e09a3e7ef5954f4490fe0990def4b92a42b6af42f2d2","65fda1f55527aa2293d74a754e2357aea3f0da76f02807aa87c3e1f498190a4a","fac69550291543347b42bfac33ae9e2bde76ae9e584ea745861dfb99c0a4fb74","8e554e2ebe223