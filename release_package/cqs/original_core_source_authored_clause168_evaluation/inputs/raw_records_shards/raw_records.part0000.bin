{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                              posSibType2-5, posSibType2-6, posSibType2-7, posSibType2-8, posSibType2-9, posSibType2-10,","paragraph_zero_based":14400},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-11, posSibType2-12, posSibType2-13, posSibType2-14, posSibType2-15,","paragraph_zero_based":14401},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-16, posSibType2-17, posSibType2-18, posSibType2-19, posSibType2-20,","paragraph_zero_based":14402},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-21, posSibType2-22, posSibType2-23, posSibType3-1, posSibType4-1,","paragraph_zero_based":14403},{"literal_text_all_w_t_and_m_t":"                                              posSibType5-1,posSibType6-1, posSibType6-2, posSibType6-3,... },","paragraph_zero_based":14404},{"literal_text_all_w_t_and_m_t":"    areaScope-r16                ENUMERATED {true}                                              OPTIONAL -- Need S","paragraph_zero_based":14405},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14407},{"literal_text_all_w_t_and_m_t":"GNSS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":14408},{"literal_text_all_w_t_and_m_t":"    gnss-id-r16              ENUMERATED{gps, sbas, qzss, galileo, glonass, bds, ..., navic-v1760},","paragraph_zero_based":14409},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14410},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14412},{"literal_text_all_w_t_and_m_t":"SBAS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":14413},{"literal_text_all_w_t_and_m_t":"    sbas-id-r16              ENUMERATED { waas, egnos, msas, gagan, ...},","paragraph_zero_based":14414},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14415},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14417},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSI-SCHEDULINGINFO-STOP","paragraph_zero_based":14418},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14419},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14420},{"literal_text_all_w_t_and_m_t":"PosSI-SchedulingInfo field descriptions","paragraph_zero_based":14421},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":14422},{"literal_text_all_w_t_and_m_t":"Indicates that a posSIB is area specific. If the field is absent, the posSIB is cell specific.","paragraph_zero_based":14423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7dfb14a3099c0c5399e1879cd2788f5e4471f8cda8ee0d8e14cf12d61d53dcd1","eb52d0f5dcbc8351fbfbf8ccabbc4faefe639ecb57f6b60c7055026e24580639","79e5f1c8d886a998c5e9a370a086a95fae41faa8c4e7d96abc7f0efa3389df28","01517f047b8b20a2d2bd25a2cddc76e5559090f3138d454ef32f9c452c8e864a","1be5168d5e7a5757a07f1448bcfaf837a37758ba2ae6eb6e4fc9812451778935","1cfea611c11cbcb8b121be7d0325ec1673b7d8da0f2bc4659ec596cefcc608d2","7d42d664cba64d9cdb43c85689e1f31e16e4c95d5e2234aef5ed5ce9b15cb7ac","0afd97daf474b00dc5c3b823ba61ad194676e1cb47fc5724272bf04223e8b40c","bd8535e1214743d9dbfd993cf631f7eb7794c0887d57eaeb2af31ba863427fea","20aabb4d45b55ed23ff3b0bff142b2464a9ef790accef2d029b2473dae6a900e","a3e12f9f548e825b59b574546f803b6b8213464e1883f53b8f26da9fec4f713f","f2a04d95501306f29a1c2fc69c87556ac5e111d730a2e757a766f059cfc9cdbe","9d37b353c7dd6d6471cbe9ec191e9fa900b12a579b7549e0e9c946ad94ca3fbb","d7bae7eb87899d174adda9975b11447270dbfa4964cb23cd0a8081831d9c32a5","a470f9bb5d0275ba43c93f9547207d975750aa440455820550b3182377bc4dab","989f853a55701eaab4faefe59e357561157db88e1149b22e87d873cc50200066","84a40c742dd47269f9e4a589fb83caae60dcd8d5bc0762959492d0eebd58ea50","059c1e2bb5b6e2b089416ad92186283f1ca4e1984df7f4da9ee32cbd7c089dd1","ce6bfe6981fd312c2d17b5e88a131b5f10f84d92cac827929bde4703d76be464","60dab98c6e8c0d655a178fa35fc8597b56cc89801dad63f344d8d474c277400e","2fc82a4375aabdfe8e815bbf6203e83b6596bb0a88250909ad883d27f2049770","588ba173e7d05f284a90d84add86502aa1670f4966797fe4dabce400bb8a0071","c5eaa7418c41c3d5dfda8703019c3d667c1763011ca853c7a91dd2750dee18ea","2735f0f3929b7fa323455ceace5c0e62083a354a139b0c099b6992f300eba74d"],"paragraph_range_zero_based":[14400,14423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14400"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":14424},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":14425},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":14426},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":14427},{"literal_text_all_w_t_and_m_t":"posSI-BroadcastStatus","paragraph_zero_based":14428},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of posSI-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting.","paragraph_zero_based":14429},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with posSI-BroadcastStatus and si-BroadcastStatus set to notBroadcasting in the concatenated list of SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo and SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when posSI-RequestConfig or posSI-RequestConfigRedCap or posSI-RequestConfigSUL is configured.","paragraph_zero_based":14430},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfig","paragraph_zero_based":14431},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14432},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfigRedCap","paragraph_zero_based":14433},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14434},{"literal_text_all_w_t_and_m_t":"posSI-RequestConfigSUL","paragraph_zero_based":14435},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which posSI-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":14436},{"literal_text_all_w_t_and_m_t":"posSIB-MappingInfo","paragraph_zero_based":14437},{"literal_text_all_w_t_and_m_t":"List of the posSIBs mapped to this SystemInformation message.","paragraph_zero_based":14438},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":14439},{"literal_text_all_w_t_and_m_t":"The positioning SIB type is defined in TS 37.355 [49].","paragraph_zero_based":14440},{"literal_text_all_w_t_and_m_t":"posSI-Periodicity","paragraph_zero_based":14441},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames, such that rf8 denotes 8 radio frames, rf16 denotes 16 radio frames, and so on. If the offsetToSI-Used is configured, the posSI-Periodicity of rf8 cannot be used.","paragraph_zero_based":14442},{"literal_text_all_w_t_and_m_t":"offsetToSI-Used","paragraph_zero_based":14443},{"literal_text_all_w_t_and_m_t":"This field, if present indicates that all the SI messages in posSchedulingInfoList are scheduled with an offset of 8 radio frames compared to SI messages in schedulingInfoList. offsetToSI-Used may be present only if the shortest configured SI message periodicity for SI messages in schedulingInfoList is 80ms. If SI offset is used, this field is present in each of the SI messages in the posSchedulingInfoList.","paragraph_zero_based":14444},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":14445},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":14446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7f8936a1a869dc834ee8f727b70370fe66920660ad52c990d3399f30c55a383a","d79db4f830842138cae701f4781bd294fc2e2672a132df45346151dda19fff0c","141f9926a036e3f01e804509db8b8d473aee361bd094ba6608e7b343f4a8cf81","364d640430d05204a47652eff60903a88d29f267a7ee435cea36f06bee0aa5b2","acfc850b06eeb57d64dd45e6f43e52cedc01cce91d4f0178ede6494ff70d8e83","5f23751e91454e98e7194c44ee7210cd9ec168e6a450412b23b33efb5dab3070","7a22a1518ea550a5e60042bb60b0c1b7789a6c60632c9bd64ae7ec35811d7a10","773b84ce3a5dedc80e343538552c0b45ec17e84d242f9b5df8d2ccb9bdb59e8f","77040cc994566016ea378cb08b931e7d3817aebeb694e2aa0a467f6821970598","cc4d1e2889cb0a88975271c7a3ccd3ca14fea306f1de26735348c1abdbef115b","085103cc75daf9ca2eb967d4dae534bd184faa111e8efea6584919b45fb7a1e6","e4bc90f570297ac418afc743f37f0090f30502f3aa7c6a9146a66977d49053e7","c7e6b260358bc5f21bb0c27cf5fd97725870e9b148e51d6787faddae2f8100f0","f224973aac0c69059f010b2850ebd648a4abc0b69777d810793e906f05aa3454","b018c8a2faa70287a4067f5244131b648a8715bd6bf367b4073aceff1b53d3bc","a55d5e41baee23f65fa5515a00c5b67a9f712799c6ff3cf3a2a60774e6d88eb3","c816522be95800b6f2cf07c3333be01498727bc9d56ef84038f9e8927d15f27b","6461d75a1b686b52d5c5ae977a9c35eff40898e34f303459d35efb94e97a0026","b84545f5f66b6f765f073a578d805debda7b473d7549c823229da783d1c214d6","bf784a0225ae3799317116d62942a40f673e5377d6e618c40b3f217df67e9f35","ac45f92290f59070f071283e2122bd1d608b7d9b9e9419d713a7add8b78f606f","b7ca7ce8e97a012c5633c32374081f82899f170a6adb5a7536c6e9db365f030e","2e9323145a14c0e3ab248be255aafe6e0602ef41a95e081d817d733368796cf5","c39b9835a16e86ecfe4fa14e94ce45daba02ff7de8a94f183c6589fd9509ec11"],"paragraph_range_zero_based":[14424,14447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p14424"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":14448},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14449},{"literal_text_all_w_t_and_m_t":"GNSS-ID-SBAS","paragraph_zero_based":14450},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if gnss-id is set to sbas. It is absent otherwise.","paragraph_zero_based":14451},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":14452},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14453},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":14454},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB, and if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14455},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":14456},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB, and if posSI-BroadcastStatus is set to notBroadcasting for any SI-message included in posSchedulingInfoList or if si-BroadcastStatus is set to notBroadcasting for any SI-message containing type2 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":14457},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14458},{"literal_text_all_w_t_and_m_t":"–SIBpos","paragraph_zero_based":14459},{"literal_text_all_w_t_and_m_t":"The IE SIBpos contains positioning assistance data as defined in TS 37.355 [49].","paragraph_zero_based":14460},{"literal_text_all_w_t_and_m_t":"SIBpos information element","paragraph_zero_based":14461},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14462},{"literal_text_all_w_t_and_m_t":"-- TAG-SIPOS-START","paragraph_zero_based":14463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14464},{"literal_text_all_w_t_and_m_t":"SIBpos-r16 ::= SEQUENCE {","paragraph_zero_based":14465},{"literal_text_all_w_t_and_m_t":"    assistanceDataSIB-Element-r16        OCTET STRING,","paragraph_zero_based":14466},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension             OCTET STRING                        OPTIONAL,","paragraph_zero_based":14467},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":14468},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14470},{"literal_text_all_w_t_and_m_t":"-- TAG-SIPOS-STOP","paragraph_zero_based":14471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["061421ea673585a0d308015dc5ecd5ee5fef0a30b7054c49e9e85f646f4e8013","c000193ec57c3aba0abe55068b456a8dc2ccbba5a2515dd40615a1adfc40cc51","3e48ec62ff23ecfcb4a814a700df1e5b45f3d8ceb9e51a7eb750d21e9026810b","b7f9fab8a594d2c3cd864dcf49cb8fb46e14e563a850f696c538bcf6bd204044","0e0f42ece6dbb94fe4e5c504bcc4acd6220b2f7b183797348ac0ed36caa1ecfd","e94598fb1c2395cea7a49ea81a5300cc4d0540426bb5d1af1ee1d41a15394157","30499