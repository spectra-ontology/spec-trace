0,","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"                                              posSibType2-21, posSibType2-22, posSibType2-23, posSibType3-1, posSibType4-1,","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"                                              posSibType5-1,posSibType6-1, posSibType6-2, posSibType6-3,... },","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"    areaScope-r16                ENUMERATED {true}                                              OPTIONAL -- Need S","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"GNSS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"    gnss-id-r16              ENUMERATED{gps, sbas, qzss, galileo, glonass, bds, ...},","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"SBAS-ID-r16 ::= SEQUENCE {","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"    sbas-id-r16              ENUMERATED { waas, egnos, msas, gagan, ...},","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c37d2c372d2d4dda207570d35e3c89e967553baf9e0729526482088f9dbec876","original_member_sha256":"7efd55c589359846db5244076aa09f6bcb89b0414383a6c28a2936c9c5a14a52","paragraph_ElementTree_utf8_XML_sha256":["a87090e1db8f59940218b248c9c57d31309762e719e8daccc414e58545d3be8a","a1e3322c18956ee907dabaa59b979267b88bf16252080e1ba55978f94404ef23","52f7b0ae8d2a91408ee884e26e53450e85cb817770c4517c0a5e6f21c73d7bed","c8d38d9636225fbdc9a9b74522679344c551d565cc3a2177df400a0715c54771","ce5ea22177f61e6c0dd3019e