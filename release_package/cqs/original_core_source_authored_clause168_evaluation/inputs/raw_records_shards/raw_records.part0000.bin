{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16992},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-START","paragraph_zero_based":16993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16994},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation ::=         SEQUENCE {","paragraph_zero_based":16995},{"literal_text_all_w_t_and_m_t":"    startingRB                          INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":16996},{"literal_text_all_w_t_and_m_t":"    nrofRBs                             INTEGER (24..maxNrofPhysicalResourceBlocksPlus1),","paragraph_zero_based":16997},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":16998},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16999},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17000},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-FREQUENCYOCCUPATION-STOP","paragraph_zero_based":17001},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17003},{"literal_text_all_w_t_and_m_t":"CSI-FrequencyOccupation field descriptions","paragraph_zero_based":17004},{"literal_text_all_w_t_and_m_t":"nrofRBs","paragraph_zero_based":17005},{"literal_text_all_w_t_and_m_t":"Number of PRBs across which this CSI resource spans. Only multiples of 4 are allowed. The smallest configurable number is the minimum of 24 and the width of the associated BWP. If the configured value is larger than the width of the corresponding BWP, the UE shall assume that the actual CSI-RS bandwidth is equal to the width of the BWP.","paragraph_zero_based":17006},{"literal_text_all_w_t_and_m_t":"startingRB","paragraph_zero_based":17007},{"literal_text_all_w_t_and_m_t":"PRB where this CSI resource starts in relation to common resource block #0 (CRB#0) on the common resource block grid. Only multiples of 4 are allowed (0, 4, ...)","paragraph_zero_based":17008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17009},{"literal_text_all_w_t_and_m_t":"–CSI-IM-Resource","paragraph_zero_based":17010},{"literal_text_all_w_t_and_m_t":"The IE CSI-IM-Resource is used to configure one CSI Interference Management (IM) resource.","paragraph_zero_based":17011},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource information element","paragraph_zero_based":17012},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17013},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-START","paragraph_zero_based":17014},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ccea87bdec82afbbe298281f5f9223822c50c95ce6eb80b9a64432ac097e9c14","51caa61fd78dd5e52390a9fecee71e898389f628c80a986b82686804f8560f4a","91f04d9ef07dbdd9c4c0bf5bc809d87e94848c6c52e7c783807478fd46004795","7813178c17b8e96daea439d42fb43fec789a05529706bbdea3e6482e4e8af3fc","d81ee1783def5a45c08bbd74a0a21c8aec3451a39f8ff534f6462025c4251bf4","78115381129aaedabd9e95639b056381993debc29f8dd344958af00b3a7e123e","6f77d1e271305b58cc1d9daf5a7b3d0e966c5882c419eb2bf2ba14f59b79abe6","18398c64a08bd79be6f8837574fdec3e0703f7deb6b30a34545fb20d6a61dd81","c99ef095df31993312119b0e9102d3557670978c5ee3745b91467719b345d91a","4ff9d6b9158ab4ee4fca893bfa1b6da255b26c355f0b53a847df15118e230adf","7e113d611e7a45ddbcc0dfad454cda2c26554d9e432d094df01e1e9d0154c5be","adccb3e49b1e1d435de164409278d27cb32daa89c6335c25805e2f6ae3f84df8","5cd66e2f7c6194998a3402521f60e28acebfa6bb7093