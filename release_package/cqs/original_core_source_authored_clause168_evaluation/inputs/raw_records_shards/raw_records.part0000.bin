{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"frequencyBandListFilterSidelink","paragraph_zero_based":41064},{"literal_text_all_w_t_and_m_t":"This field is used to indicate frequency bands for which the peer UE is requested to provide supported bands and band combinations for NR sidelink communications. The UE always provides this field.","paragraph_zero_based":41065},{"literal_text_all_w_t_and_m_t":"ue-CapabilityInformationSidelink","paragraph_zero_based":41066},{"literal_text_all_w_t_and_m_t":"This field indicates the UECapabilityInformationSidelink message to provide the UE sidelink capability, which can be optionally sent together with UECapabilityEnquirySidelink.","paragraph_zero_based":41067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41068},{"literal_text_all_w_t_and_m_t":"–UECapabilityInformationSidelink","paragraph_zero_based":41069},{"literal_text_all_w_t_and_m_t":"The UECapabilityInformationSidelink message is used to transfer UE radio access capabilities. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":41070},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":41071},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":41072},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":41073},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":41074},{"literal_text_all_w_t_and_m_t":"UECapabilityInformationSidelink message","paragraph_zero_based":41075},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41076},{"literal_text_all_w_t_and_m_t":"-- TAG-UECAPABILITYINFORMATIONSIDELINK-START","paragraph_zero_based":41077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41078},{"literal_text_all_w_t_and_m_t":"UECapabilityInfor