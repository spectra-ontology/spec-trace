{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>for the associated reportConfigId:","paragraph_zero_based":3072},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":3073},{"literal_text_all_w_t_and_m_t":"3>if the associated measObjectId is only associated to a reportConfig with reportType set to condTriggerConfig:","paragraph_zero_based":3074},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":3075},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":3076},{"literal_text_all_w_t_and_m_t":"2>release the PC5 RLC entity for SL-RLC0, if any;","paragraph_zero_based":3077},{"literal_text_all_w_t_and_m_t":"2>start timer T301;","paragraph_zero_based":3078},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":3079},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":3080},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":3081},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":3082},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the RRCReestablishmentRequest message in accordance with 5.3.7.4;","paragraph_zero_based":3083},{"literal_text_all_w_t_and_m_t":"NOTE 2:This procedure applies also if the UE returns to the source PCell.","paragraph_zero_based":3084},{"literal_text_all_w_t_and_m_t":"Upon selecting an inter-RAT cell, the UE shall:","paragraph_zero_based":3085},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3086},{"literal_text_all_w_t_and_m_t":"5.3.7.3aActions following relay selection while T311 is running","paragraph_zero_based":3087},{"literal_text_all_w_t_and_m_t":"Upon selecting a suitable L2 U2N Relay UE, the L2 U2N Remote UE shall:","paragraph_zero_based":3088},{"literal_text_all_w_t_and_m_t":"1>indicate to upper layer to trigger the PC5 unicast link establishment with the selected L2 U2N Relay UE, if a new L2 U2N Relay UE is selected;","paragraph_zero_based":3089},{"literal_text_all_w_t_and_m_t":"1>ensure having valid and up to date essential system information as specified in clause 5.2.2.2;","paragraph_zero_based":3090},{"literal_text_all_w_t_and_m_t":"1>stop timer T311;","paragraph_zero_based":3091},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3092},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3093},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3094},{"literal_text_all_w_t_and_m_t":"1>stop the cell selection procedure, if ongoing;","paragraph_zero_based":3095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c7753bf128e53b2bc781b2e1be9ff24f1172e7280bc602c9df1d9fd7e49dda82","0a554e01d90c072a136f0f4a747466e8da5dbbd2c844149c8ae335294d2bc74d","464e150bd6103c2266dd50663cb559d7d559fe9bd00a992e4d65edfbbba8684a","513a70b4f68671284b7a6ef523123f35f4ca06ae349fe702b573a487bae8d3f4","e3d0b87257a5faee388cb6b890378a0de1302eb21119f0889ebab3ec6f917808","5ee9fae115d1b3b559cd02bac491f02171f140ccd26c13a40c6ebc2d42b87494","279bb1d9246155e23914906a2cf181ded93a9d6cd6826805c60cc058f53d2e34","be6dbb8504357c9e48ecca0179b4ec927dac3fa8b67c533de12d616233962456","0c967a0a9cccf7f1c4e3a33900d319982118be596fd0a3b2819e05cf82600642","4919a85b5a8e6b1b6d3869ccdf4c72b9846fa7659bf938bc419f2385183f76a3","86ffdb866ade9436f80712b6f3d9272ed980a11673c54161eaa2d22ba6c445e4","c1f46687ceabc8da480eb26ede33cbaf29af21e09087d103ffe60ee7525b427d","7c5bcf11eb3951b310b15b23b0dbb6e5a847530e0038b362ad96c13ca0091641","26868f3f7ed505ea987a49d0bb88cbcdde642b7db7cf0ba6bf0ba14eedb4ac76","d369ad77962a2b968956c87511485d3009f5e20abefc571cf3920fa8b1a99405","d4042b751d862c9ce5f0a0bed1ca5ddd760587d239f4348c8b4e11a50002f44f","e1cdfa30a72c903fdc47674030a51960a69f48526677ccfd3000af06691ff4ca","42f68fbccab352a5b9a7cda8571dcd751b0b87203f812e432d5e996d58490072","83f99839780c6f84d22835c49872023b468b69a53a8f733f3e512158285235ee","cbede3bea958499441cbcc94a40e0cfa5b59ff2ad1e6a57bb701601fde4f8dca","0ff5f44db77341ac50f5663542eb944b8fd808f955ccd0c20f31e87e9c9aae60","79f9214c0a0a2554179ecef07e570174fd5eea02b9dfcdb140b43e5170066b25","49bb122c5462cb968cbbe0fbdbc3324e05d0b64e75d952c48e6abeea88e15e3b","cca4b2f3ec56a817c4af05956648e1b0a36683e05d380255224b5b0b7917a3b0"],"paragraph_range_zero_based":[3072,3095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3072"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>start timer T301;","paragraph_zero_based":3096},{"literal_text_all_w_t_and_m_t":"1>release the RLC entity for SRB0, if any;","paragraph_zero_based":3097},{"literal_text_all_w_t_and_m_t":"1>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":3098},{"literal_text_all_w_t_and_m_t":"1>apply the specified configuration of SL-RLC0 as specified in 9.1.1.4;","paragraph_zero_based":3099},{"literal_text_all_w_t_and_m_t":"1> apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":3100},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCReestablishmentRequest message in accordance with 5.3.7.4.","paragraph_zero_based":3101},{"literal_text_all_w_t_and_m_t":"5.3.7.4Actions related to transmission of RRCReestablishmentRequest message","paragraph_zero_based":3102},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCReestablishmentRequest message as follows:","paragraph_zero_based":3103},{"literal_text_all_w_t_and_m_t":"1>if the procedure was initiated due to radio link failure as specified in 5.3.10.3 or reconfiguration with sync failure as specified in 5.3.5.8.3:","paragraph_zero_based":3104},{"literal_text_all_w_t_and_m_t":"2>set the reestablishmentCellId in the VarRLF-Report to the global cell identity of the selected cell;","paragraph_zero_based":3105},{"literal_text_all_w_t_and_m_t":"1>set the ue-Identity as follows:","paragraph_zero_based":3106},{"literal_text_all_w_t_and_m_t":"2>set the c-RNTI to the C-RNTI used in the source PCell (reconfiguration with sync or mobility from NR failure) or used in the PCell in which the trigger for the re-establishment occurred (other cases);","paragraph_zero_based":3107},{"literal_text_all_w_t_and_m_t":"2>set the physCellId to the physical cell identity of the source PCell (reconfiguration with sync or mobility from NR failure) or of the PCell in which the trigger for the re-establishment occurred (other cases);","paragraph_zero_based":3108},{"literal_text_all_w_t_and_m_t":"2>set the shortMAC-I to the 16 least significant bits of the MAC-I calculated:","paragraph_zero_based":3109},{"literal_text_all_w_t_and_m_t":"3>over the ASN.1 encoded as per clause 8 (i.e., a multiple of 8 bits) VarShortMAC-Input;","paragraph_zero_based":3110},{"literal_text_all_w_t_and_m_t":"3>with the KRRCint key and integrity protection algorithm that was used in the source PCell (reconfiguration with sync or mobility from NR failure) or of the PCell in which the trigger for the re-establishment occurred (other cases); and","paragraph_zero_based":3111},{"literal_text_all_w_t_and_m_t":"3>with all input bits for COUNT, BEARER and DIRECTION set to binary ones;","paragraph_zero_based":3112},{"literal_text_all_w_t_and_m_t":"1>set the reestablishmentCause as follows:","paragraph_zero_based":3113},{"literal_text_all_w_t_and_m_t":"2>if the re-establishment procedure was initiated due to reconfiguration failure as specified in 5.3.5.8.2:","paragraph_zero_based":3114},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value reconfigurationFailure;","paragraph_zero_based":3115},{"literal_text_all_w_t_and_m_t":"2>else if the re-establishment procedure was initiated due to reconfiguration with sync failure as specified in 5.3.5.8.3 (intra-NR handover failure) or 5.4.3.5 (inter-RAT mobility from NR failure):","paragraph_zero_based":3116},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value handoverFailure;","paragraph_zero_based":3117},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3118},{"literal_text_all_w_t_and_m_t":"3>set the reestablishmentCause to the value otherFailure;","paragraph_zero_based":3119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["9f9a21c7d8051c3de0fad089e8a85d8da889ee6a8983005f0bfc5ee1b3eaf238","399abb809f116e51c77169700057bab2a8f5acd28147ad4ce0020a1f29911838","a4a3b71212ca143b5fe8c627b7d40c02d12b125aefed215a8f5f5ad852e409cd","21abe523520ae2a35491abc7004f1fe762b2dc70412b0d85a5122565fabf06a8","6109fd94f0ec46b426fda3553625f313c1ca7ffbfa242abf17c1a42555317197","7f1795118465e122fbffeeeb6718765f01696bb3e849eeae4751d72249f99469","7e179d8e9613513cea2ff8592ba29b4c3bb1ef1a8ae9ab1aa58da7f612ea355c","982e86fd707bf02bdf6025ba3dc33c44aac40d3b5d1f08cd5c63dd8442903030","040b69b01c859c8c7df1447f811dafb9842f7656281573c4b465026cc11e6706","52fe7f92e4961281b74f721d5a9a966946334e60d5db4f93b43c616c432bc708","94f02f61fc9b48ebcb14ed540be4db2cff82f899268bb4a0708cd3d84857a05c","5d9189e5c620b0ebe259b3201427d3320de1bbfae8ad58e75d1475913da88b03","08f2b2dbf4df395f3b07b93b707fb692a7ca8aa305b5505b8561976f5873d802","e69209d5f7d351f5ff1577016731877316152805b96f2e9cea6193a10eb93082","63b103075c9854dae30980001d762c9f113823fa6ee308c162f92274c2b6ac49","58fe2af35b2253a91d2858ee9cba532316ae983659df3933a9759383991aaa08","40eb018abdc5034ff03bf9253d54d9a216afa5d19a09577efc8d208296db5e51","2c35622e5add18f8bbc3ee7330abab6b5901f7677101d3399249c204cb18e254","055b24af92ea3fc23807d65df01f92f1b11dba5f40fcc27ac043f0e3b02e0513","dd83b891d5609d20b47be2dbad90c27da2481d38eccda85b249d1899124ebf01","5a93f1de7f3f4d95cdbc8151521dfd40ac3fa499646b2d451a99d3d573cd315c","0b86d6887fc5b40440cbd8658e00845d1b5ee3b8595cb3c8f0ab79581ad6af7c","d7146a5667dd3d1c3188dc603cbf0b0e8f51662bba27d271e469b688a250a6df","d8bd12c02303b44b82404d6e3a6d650ab64fbd81abf0371591f7602d4c26cad4"],"paragraph_range_zero_based":[3096,3119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3096"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>re-establish PDCP for SRB1;","paragraph_zero_based":3120},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3121},{"literal_text_all_w_t_and_m_t":"2>establish or re-establish (e.g. via release and add) SL RLC entity for SRB1;","paragraph_zero_based":3122},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as defined in 9.2.4 for SRB1;","paragraph_zero_based":3123},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of PDCP as defined in 9.2.1 for SRB1;","paragraph_zero_based":3124},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SRAP as defined in 9.2.5 for SRB1;","paragraph_zero_based":3125},{"literal_text_all_w_t_and_m_t":"1> else:","paragraph_zero_based":3126},{"literal_text_all_w_t_and_m_t":"2>re-establish RLC for SRB1;","paragraph_zero_based":3127},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration defined in 9.2.1 for SRB1;","paragraph_zero_based":3128},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to suspend integrity protection and ciphering for SRB1;","paragraph_zero_based":3129},{"literal_text_all_w_t_and_m_t":"NOTE:Ciphering is not applied for the subsequent RRCReestablishment message used to resume the connection. An integrity check is performed by lower layers, but merely upon request from RRC.","paragraph_zero_based":3130},{"literal_text_all_w_t_and_m_t":"1>resume SRB1;","paragraph_zero_based":3131},{"literal_text_all_w_t_and_m_t":"1>if ta-Report is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":3132},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":3133},{"literal_text_all_w_t_and_m_t":"1>submit the RRCReestablishmentRequest message to lower layers for transmission.","paragraph_zero_based":3134},{"literal_text_all_w_t_and_m_t":"5.3.7.5Reception of the RRCReestablishment by the UE","paragraph_zero_based":3135},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3136},{"literal_text_all_w_t_and_m_t":"1>stop timer T301;","paragraph_zero_based":3137},{"literal_text_all_w_t_and_m_t":"1>consider the current cell to be the PCell;","paragraph_zero_based":3138},{"literal_text_all_w_t_and_m_t":"1>update the KgNB key based on the current KgNB key or the NH, using the received nextHopChainingCount value, as specified in TS 33.501 [11];","paragraph_zero_based":3139},{"literal_text_all_w_t_and_m_t":"1>store the nextHopChainingCount value indicated in the RRCReestablishment message;","paragraph_zero_based":3140},{"literal_text_all_w_t_and_m_t":"1>derive the KRRCenc and KUPenc keys associated with the previously configured cipheringAlgorithm, as specified in TS 33.501 [11];","paragraph_zero_based":3141},{"literal_text_all_w_t_and_m_t":"1>derive the KRRCint and KUPint keys associated with the previously configured integrityProtAlgorithm, as specified in TS 33.501 [11].","paragraph_zero_based":3142},{"literal_text_all_w_t_and_m_t":"1>request lower layers to verify the integrity protection of the RRCReestablishment message, using the previously configured algorithm and the KRRCint key;","paragraph_zero_based":3143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["41ee2346d326c639d6c06b20d4358de3cc7a929dda801309154201b60823c20e","04a3c58be09904b183b4a149ca843ee50b6458c261671497fc6da73357a3d5db","616aabba69fcb2bf789529b01f2541430649fae8ba87541c22c2abffb5f8c6f3","b16aadca6c2d202d955ed91e928cee5e29cd23df6ed8fda1d0ca02951ec5a395","46e319287c9886eba11acbc77b34d1d2de815fecb386137d5ebbfe4532de2f75","a09146014121cbdd723986555c22bf10dedba977bbaeee59ccfaf6ffd212fc06","01771e1cecf989bcbc920729b8999abfbe14ea9ea59c5f0afce89835f4f54c36","26480468a08e7748387f8c4dad137de272aeb6686894d472564255a9dbd715b4","f49a488b4ae60bb99b9f308a111dc7620803dff330a5cbd63a39a85425c5b7d0","32f071560ee0ae4071ded2f6d140a1a78712bc6e3d46f4042884757d02303f4f","0df3883fd00f3af103aa8774a617bc377ac25e07bffe225b3a44fa05ffc9890e","83d27e339a172b65b3c88c2bbdf0df4c58b5190a9911e9e5b7922a785fa9fbf0","073714b0aaf1a6c16d36728620cb1b7220ed4c925cf303db498e5f24b32cfef7","1296671f5abbb219c97428105083c982ea550384aec94ab19e64401257fa2b6c","1198754a77b841c088c9c87007a9f7478973ac9e9dcffd572edb308784b8a073","030b6acf4434405f2e257192dd8a047385e1df01e9ca4c6f8bc9eaf7d4900716","ca769454a8db02473d1d0ef85dfaaded625a1cb682fdb6eef86646cef459777e","7686bdd93329d551f84edb8784af6cb83c17e6c709deaf282960a9db4eae7107","c8fc476541c265510593716ae4f45c2fffd4b7cbe3a61151b83e75df143d6ee2","2657244986ae1ea909a3f854c6b40868de99f971da9df0caaae29c021ecc6478","038004ac567f5909087d383f54413109089fe6d1e9d99bfa3bb215271e34931b","0397bed659b340a5b78948d0fc8cee2a96f3bfff3a3d2d815c4527418f0cc7c0","c340c96e11c8a57a01f404a7fddb8eff4c57613a530d17216c1b25a645bc053b","93add4f515d52c4b360b222b258162b59584ebfcf854e3ac7a0beab7f528cd04"],"paragraph_range_zero_based":[3120,3143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3120"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the integrity protection check of the RRCReestablishment message fails:","paragraph_zero_based":3144},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure', upon which the procedure ends;","paragraph_zero_based":3145},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to resume integrity protection for SRB1 using the previously configured algorithm and the KRRCint key immediately, i.e., integrity protection shall be applied to all subsequent messages received and sent by the UE, including the message used to indicate the successful completion of the procedure;","paragraph_zero_based":3146},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to resume ciphering for SRB1 using the previously configured algorithm and, the KRRCenc key immediately, i.e., ciphering shall be applied to all subsequent messages received and sent by the UE, including the message used to indicate the successful completion of the procedure;","paragraph_zero_based":3147},{"literal_text_all_w_t_and_m_t":"1>release the measurement gap configuration indicated by the measGapConfig, if configured;","paragraph_zero_based":3148},{"literal_text_all_w_t_and_m_t":"1>release the MUSIM gap configuration indicated by the musim-GapConfig, if configured;","paragraph_zero_based":3149},{"literal_text_all_w_t_and_m_t":"1>release the FR2 UL gap configuration indicated by the ul-GapFR2-Config, if configured;","paragraph_zero_based":3150},{"literal_text_all_w_t_and_m_t":"1>perform the L2 U2N Remote UE configuration procedure in accordance with the received sl-L2RemoteUE-Config as specified in 5.3.5.16;","paragraph_zero_based":3151},{"literal_text_all_w_t_and_m_t":"1>set the content of RRCReestablishmentComplete message as follows:","paragraph_zero_based":3152},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":3153},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3154},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3155},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCReestablishmentComplete message;","paragraph_zero_based":3156},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3157},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCReestablishmentComplete message;","paragraph_zero_based":3158},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included:","paragraph_zero_based":3159},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running and the logged measurements configuration is for NR:","paragraph_zero_based":3160},{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCReestablishmentComplete message;","paragraph_zero_based":3161},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3162},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements available for NR:","paragraph_zero_based":3163},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCReestablishmentComplete message;","paragraph_zero_based":3164},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":3165},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3166},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report; or","paragraph_zero_based":3167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["38ad19f0f60405198865a3cc8f6b7a709b67288cd9a4964c697bf93184c20eea","ae65e413ec7ab4e78a60da632abd024065ddd8007cad0ac167660957fd4931a8","60aa8a5c082b8ece778c6b601bb7c0d4f11056b162d2a30b8012c7edae65d9ec","a04c0f40cb1a1479b9f23551bbb065ac95e42af6cdaa9c6cc139267e4e0db048","64b56789d2c4ed1629684798a1280be4b96da9a5d7b481e2fb6a8579238c9729","35180fbd76f0938bac6339bbd527408ca41fa8d7f6a817827c376de6a2699d6d","836d3663e4d8d8672f28802c8821368b0fa0426c5cf653c675221c9f034b6324","255a5dce0aebd59aa451e1a21b672aff6887637a3f3b08aebeabf5b6750b00c2","ea19d6cfadc0386fdb4b1141b82eaa588935f850671e684987641c483982283b","b32f9d97ad13165fad0fee0b6a184093835ee5c861e867dd830c36c4108008a9","7c1c1b995c7da1beab65c8e8b1f1b343c0e543f8177924d2236b3b36cbc10e5e","0464cf9086cac350e10d9f2db875b9d35891a76ab97fd7c5cd11f193cb26c840","a0d102dc0ddacffe5b7ccfb915f6913be1c356d92b6aef0517536ebd91711a99","adf893511660c471742fcb8eb860d37adf4547e374ff15f66fc28cc74324f51f","e0d33ea14765aa1e7c82474c76a8a97bdd4d5078c52f86e4f5bbc5861c9bcf62","029162eff637ef91f0e6fc141e8dd0e1523a75aa884d9bdfd6f4387698352cee","d96510c993bc81b3b5bb14507788d1e30976fd3873609ecf186b1cf0ffc82350","c62f6f817b0a49591dd6a72f021069f9b15219c819d808c24461307cfb79813a","1f26c016ad552f5d361007671de961451693c4a025ffc7c0a16c5372ff3969aa","6ffd5cebc68cb635dc034693aed412b9a10487931e93aaf538a90e4682f3c42a","3586045257d987f68b379f113b5f95ee49138cd732a394fabbaecdd2c6ca0b79","c3e0494d6fe51642dfbba3c641f3534abc96fa5ff6d5a45a8f4073952268e52a","637e1a1ccf2e1664e128e2f72686d156aba651b59c314212e5a21a340c8e9ee3","b07f6ded6d3de0be0f6e74ae2701971a8b72a7561a881c76fff9898a09ffdd79"],"paragraph_range_zero_based":[3144,3167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3144"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report of TS 36.331 [10] and if the UE is capable of cross-RAT RLF reporting and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]:","paragraph_zero_based":3168},{"literal_text_all_w_t_and_m_t":"3>include rlf-InfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3169},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful handover information available in VarSuccessHO-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessHO-Report:","paragraph_zero_based":3170},{"literal_text_all_w_t_and_m_t":"3>include successHO-InfoAvailable in the RRCReestablishmentComplete message;","paragraph_zero_based":3171},{"literal_text_all_w_t_and_m_t":"2>if the UE has flight path information available:","paragraph_zero_based":3172},{"literal_text_all_w_t_and_m_t":"3>if the UE had not previously provided a flight path information; or","paragraph_zero_based":3173},{"literal_text_all_w_t_and_m_t":"3>if flightPathUpdateDistanceThr is configured and for at least one waypoint previously provided to the network, the 3D distance between the previously provided location and the new location is more than or equal to the distance threshold configured by flightPathUpdateDistanceThr; or","paragraph_zero_based":3174},{"literal_text_all_w_t_and_m_t":"3>if flightPathUpdateTimeThr is configured and for at least one waypoint previously provided to the network, the timestamp was not previously provided but is now available, or the time between the previously provided timestamp and the new timestamp, if available, is more than or equal to the time threshold configured by flightPathUpdateTimeThr:","paragraph_zero_based":3175},{"literal_text_all_w_t_and_m_t":"4>include flightPathInfoAvailable;","paragraph_zero_based":3176},{"literal_text_all_w_t_and_m_t":"NOTE x:If neither flightPathUpdateDistanceThr nor flightPathUpdateTimeThr is configured, it is up to UE implementation whether to include flightPathInfoAvailable when updated flight path information is available.","paragraph_zero_based":3177},{"literal_text_all_w_t_and_m_t":"1>submit the RRCReestablishmentComplete message to lower layers for transmission;","paragraph_zero_based":3178},{"literal_text_all_w_t_and_m_t":"1>if SIB21 is provided by the PCell:","paragraph_zero_based":3179},{"literal_text_all_w_t_and_m_t":"2>if the UE initiated transmission of an MBSInterestIndication message during the last 1 second preceding detection of radio link failure:","paragraph_zero_based":3180},{"literal_text_all_w_t_and_m_t":"3>initiate transmission of an MBSInterestIndication message in accordance with 5.9.4;","paragraph_zero_based":3181},{"literal_text_all_w_t_and_m_t":"1>the procedure ends.","paragraph_zero_based":3182},{"literal_text_all_w_t_and_m_t":"5.3.7.6T311 expiry","paragraph_zero_based":3183},{"literal_text_all_w_t_and_m_t":"Upon T311 expiry, the UE shall:","paragraph_zero_based":3184},{"literal_text_all_w_t_and_m_t":"1>if the procedure was initiated due to radio link failure or handover failure:","paragraph_zero_based":3185},{"literal_text_all_w_t_and_m_t":"2>set the noSuitableCellFound in the VarRLF-Report to true;","paragraph_zero_based":3186},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3187},{"literal_text_all_w_t_and_m_t":"5.3.7.7T301 expiry or selected cell/L2 U2N Relay UE no longer suitable","paragraph_zero_based":3188},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3189},{"literal_text_all_w_t_and_m_t":"1>if timer T301 expires; or","paragraph_zero_based":3190},{"literal_text_all_w_t_and_m_t":"1>if the selected cell becomes no longer suitable according to the cell selection criteria as specified in TS 38.304 [20]; or","paragraph_zero_based":3191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["835e502d42d675b55b2bf16e5431a100699a0b6823cc739d333363c9275241c4","62208273c94f913fd20a76cafdb55cbf4ab5dd5a8079f01704ebf53d0983f2dc","39c11c08eda3b7e7a93bf68518dd16b2dcd4445277aaf967484e32942f299ef5","f4e4c3295f7c45f5e8174e10e0aca969b2dc3d88079c675fa42e75d69fccd227","345372d126d6d9cc1931b0767884106be6358d019177c5133f28b2d2208c7828","efe4b17b69c6b11e9eb0a6cbadd7d1f9229f287a0772b89221ee0dcf56420394","20772886c5ad09e2b1dcb358a0ece43ac574798af4b4e8da0d34ea41462a287b","5539af5a87525d73196ca30e0ae5eca4346b8581da2998b1b67a9dea4899c5b5","3755c63153d6d105cbe18f93e76d06195d86bde26ed9fbceb0798c725210f8e5","9ce324337aca2630888d2fbd4b94d9facd910ee04687c584154886277ad0ca75","9107d43db3b5af28e47d389a0d73b5e3948c43a544bec087939920ec1ed272a1","20d40ac4d7851a3bc3fae5590a0feceac56dc91a318d5080e1e92a734332e46b","badd7f9c776ab15c63eff48259beba5571f4808d97a87e4773b6a83c70104d33","abb8074522b4840d7b15265f71c0ff5de0027e60216d2ab6fd70b4d6c7deba49","8820285c4b4f5542cb69e51af18c8641a7087f6fc446981bc2ab2f763871fc0c","95bcd65b4a44678453023130da31e48d3fd371011947f9d4bc07d3c1f035e8ca","a59deeced68bc9e84c6b2a7f9d464fa6a7af2b2ef33adfbb2854f49396baf12b","e6f46628c9faaa3f844e15fcc01970b988a5c0aadc931e59c7c7ecbc16ca115f","e3f2c880781953d8a2f4e2f43c5cbea9691e4e87cf916dc1d68c38e1aa88faa8","e0aa1e06ee15fb761d5a531156bd9295348af8f45251cb4c34c6a842596061e1","e6c28f7c93af5ca3457a84be3d232db5b2402025fec4e09b28aa43a92113d38e","d2243401fee70eb4bfb068320d2d051ba26f676aa1158ccf79699e5615604bbc","30da726147b279d673e0061436c36067fa4c108144925fb75c6cd7f758ccf16a","ef2742d186378c2cdca8b9e62a338732de4d7fa6b87ae4bb63d4a9e6b24d23c3"],"paragraph_range_zero_based":[3168,3191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3168"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the (re)selected L2 U2N Relay UE becomes unsuitable; or","paragraph_zero_based":3192},{"literal_text_all_w_t_and_m_t":"1>upon reception of NotificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection; or","paragraph_zero_based":3193},{"literal_text_all_w_t_and_m_t":"1>upon PC5 unicast link release indicated by upper layer at L2 U2N Remote UE:","paragraph_zero_based":3194},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3195},{"literal_text_all_w_t_and_m_t":"5.3.7.8Reception of the RRCSetup by the UE","paragraph_zero_based":3196},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3197},{"literal_text_all_w_t_and_m_t":"1>perform the RRC connection establishment procedure as specified in 5.3.3.4.","paragraph_zero_based":3198},{"literal_text_all_w_t_and_m_t":"5.3.8RRC connection release","paragraph_zero_based":3199},{"literal_text_all_w_t_and_m_t":"5.3.8.1General","paragraph_zero_based":3200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3201},{"literal_text_all_w_t_and_m_t":"Figure 5.3.8.1-1: RRC connection release, successful","paragraph_zero_based":3202},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is:","paragraph_zero_based":3203},{"literal_text_all_w_t_and_m_t":"-to release the RRC connection, which includes the release of the established radio bearers (except for broadcast MRBs), BH RLC channels, Uu Relay RLC channels, PC5 Relay RLC channels as well as all radio resources; or","paragraph_zero_based":3204},{"literal_text_all_w_t_and_m_t":"-to suspend the RRC connection only if SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, are setup, which includes the suspension of the established radio bearers (except for broadcast MRBs).","paragraph_zero_based":3205},{"literal_text_all_w_t_and_m_t":"5.3.8.2Initiation","paragraph_zero_based":3206},{"literal_text_all_w_t_and_m_t":"The network initiates the RRC connection release procedure to transit a UE in RRC_CONNECTED to RRC_IDLE; or to transit a UE in RRC_CONNECTED to RRC_INACTIVE only if SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, is setup in RRC_CONNECTED; or to transit a UE in RRC_INACTIVE back to RRC_INACTIVE when the UE tries to resume (for resuming a suspended RRC connection or for initiating SDT); or to transit a UE in RRC_INACTIVE to RRC_IDLE when the UE tries to resume (for resuming of a suspended RRC connection or for initiating SDT). The procedure can also be used to release and redirect a UE to another frequency.","paragraph_zero_based":3207},{"literal_text_all_w_t_and_m_t":"5.3.8.3Reception of the RRCRelease by the UE","paragraph_zero_based":3208},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3209},{"literal_text_all_w_t_and_m_t":"1>delay the following actions defined in this clause 60 ms from the moment the RRCRelease message was received or optionally when lower layers indicate that the receipt of the RRCRelease message has been successfully acknowledged, whichever is earlier;","paragraph_zero_based":3210},{"literal_text_all_w_t_and_m_t":"1>stop timer T380, if running;","paragraph_zero_based":3211},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":3212},{"literal_text_all_w_t_and_m_t":"1>if timer T316 is running;","paragraph_zero_based":3213},{"literal_text_all_w_t_and_m_t":"2>stop timer T316;","paragraph_zero_based":3214},{"literal_text_all_w_t_and_m_t":"2>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":3215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e73f3899ad5ff2dbec7acd4b70ccf479a3bc16104cb08bf15166eeb9435320d2","28387c37c9fa2408addb54ad1e20cb688cd9877cf508ee65af1c2d82d12dda14","2eb6df2e382af67362d88b5b6c6bcb2801dac6413775176daac05afbf2bd4628","c58fc193746e5a99939c2d5ffb7adf217bd332390039f09ea65782186eadd1fd","477635c1707dc06ef04db8e2a04ae2e2853ae8bc299529b7ec9d58d787189cac","fbe1544aad7354fd4cae0e47ba32248eebb3520af95775c60cfee1680c5b93db","cf71f0dd5405680db8489512a0d9101a669a6d13d5e0ccd2421241aff6b2719f","7ff6a2528d40f2366eff5490c108b0d76c25037021d08379b8c5b0ffdf4925db","c37a2c76ab816ec5360f55966708e1db935e001d92dc0a30949033743abd08db","0474caf7916a7e0708722a7759eddc1b044c9cff2897d015041b9d42855eb0ab","dd0590493fe8ee2f077af66f32b25e642365cec84c4abe6025a554b5069419e6","9837558883257e0fdc47aca4794a28b182d861cda7c4d6d84f9c14234113c273","76cd8d0fc1962e0fc5d82f0e75224fda68f318d71d189d6fc1d9351893f69307","dbdabc59484268bd8c58ea35f1a9d077d731a5798893f79cf9c5dce28d166aeb","40ec691e8619f7e7294998633e3bd4edbf38c21dbf01614861ee0e4282f3da6b","0fa64085464e424cdf1a067b45e8227b38fbc603b194e8a2a1edfee1f4ecbeae","8da3b784df61667f846f5dff05172524ef816c590d41b21fe82ff4b2d71be64b","c25ad5a685c6a8136147801b13138942b46824e33bbd6d3ec4d4899d0561e11e","1f20eafa6e81f9274929f92f32c7f5528c12987cf352817d8dab8028d7395ed7","4e6c3f357e54795b3eccd4ca4988d66a92bc1596c21da6ed2209a839f4c7e2e3","f344f04b50e7daa53d9c390c3cc1613a53011ecaf5964ac669a93bc1ff664874","1db14cb6a6082fa55310f322e30d0c2ad79734f6a7557f2b3b035c128c0a6b0c","41e4442904b42c831892b021a1f3b943eec21ec3ff058db10a2d6f41861d1e24","134ddfe0a5a638d1c117ad10816b3cec1b99bb9ab6c0f4eeb16a0016158a5d10"],"paragraph_range_zero_based":[3192,3215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3192"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>stop timer T350, if running;","paragraph_zero_based":3216},{"literal_text_all_w_t_and_m_t":"1>stop timer T346g, if running;","paragraph_zero_based":3217},{"literal_text_all_w_t_and_m_t":"1>if the AS security is not activated:","paragraph_zero_based":3218},{"literal_text_all_w_t_and_m_t":"2>ignore any field included in RRCRelease message except waitTime;","paragraph_zero_based":3219},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with the release cause 'other' upon which the procedure ends;","paragraph_zero_based":3220},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes redirectedCarrierInfo indicating redirection to eutra:","paragraph_zero_based":3221},{"literal_text_all_w_t_and_m_t":"2>if cnType is included:","paragraph_zero_based":3222},{"literal_text_all_w_t_and_m_t":"3>after the cell selection, indicate the available CN Type(s) and the received cnType to upper layers;","paragraph_zero_based":3223},{"literal_text_all_w_t_and_m_t":"NOTE 1:Handling the case if the E-UTRA cell selected after the redirection does not support the core network type specified by the cnType, is up to UE implementation.","paragraph_zero_based":3224},{"literal_text_all_w_t_and_m_t":"2>if voiceFallbackIndication is included:","paragraph_zero_based":3225},{"literal_text_all_w_t_and_m_t":"3>consider the RRC connection release was for EPS fallback for IMS voice (see TS 23.502 [43]);","paragraph_zero_based":3226},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease message includes the cellReselectionPriorities:","paragraph_zero_based":3227},{"literal_text_all_w_t_and_m_t":"2>store the cell reselection priority information provided by the cellReselectionPriorities;","paragraph_zero_based":3228},{"literal_text_all_w_t_and_m_t":"2>if the t320 is included:","paragraph_zero_based":3229},{"literal_text_all_w_t_and_m_t":"3>start timer T320, with the timer value set according to the value of t320;","paragraph_zero_based":3230},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3231},{"literal_text_all_w_t_and_m_t":"2>apply the cell reselection priority information broadcast in the system information;","paragraph_zero_based":3232},{"literal_text_all_w_t_and_m_t":"1>if deprioritisationReq is included and the UE supports RRC connection release with deprioritisation:","paragraph_zero_based":3233},{"literal_text_all_w_t_and_m_t":"2>start or restart timer T325 with the timer value set to the deprioritisationTimer signalled;","paragraph_zero_based":3234},{"literal_text_all_w_t_and_m_t":"2>store the deprioritisationReq until T325 expiry;","paragraph_zero_based":3235},{"literal_text_all_w_t_and_m_t":"NOTE 1a:The UE stores the deprioritisation request irrespective of any cell reselection absolute priority assignments (by dedicated or common signalling) and regardless of RRC connections in NR or other RATs unless specified otherwise.","paragraph_zero_based":3236},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease includes the measIdleConfig:","paragraph_zero_based":3237},{"literal_text_all_w_t_and_m_t":"2>if T331 is running:","paragraph_zero_based":3238},{"literal_text_all_w_t_and_m_t":"3> stop timer T331;","paragraph_zero_based":3239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["900c17ff76119b08ceb9f9d39e691edcf89a41e0af9977705f9e54b4187616f5","2f70b13ecad447f52699f96d8c883e85f8435f8fcc9decc01ba2ab686ec239af","1086e16039442f99d8410454e8b91e7decef9ca1581b7aad934775a0aacc2d13","db91e7eb4bd07b0b142cff9058e233b4d6534ad72c1b8e9b37edb53693756613","58a15c451067df5e91fcf88d7566236cbaad447fed7bdcf123f71dd30657d548","4cfbafad3a6405f2fae0f8a7a4bc1a2d049378df2a546c45b1fbc2ba6a04050a","932258f36a6d5881304247ef27be0f886711f5a2c7a3baea3270d10b5e33c156","b70bcacdcd6e1cb855cab5eb68375adcab2125f65c1c8be6c9ef641e61c6b10c","f5ebf13683740b4bea8b55d5c1d0911f1343f7fa7364c9af0193c9330cb7890e","652bd4ff0afc897b4413f64fa086a3f0ad4b950477c47511f7f4e85dd76e5de9","3f6a3586368c89966e6d6a33a5634462232c042edd30baa8e3738b9e5a1a8a94","bfb1713462eb597fadbf0090e5a2569e44aefe1a993671f5fe8c675e714a4ab3","9cd2fc6dc244bc20c75f7e42f398677e00d7e4244decd102d768e49ac8699267","a606e99643f614d09e7cdb766cc8a69ce9dbf5dfe91a46677383ac96b918b6a5","4c370ca9080381536c66f46f4a51242961c9eb4778347468251b5b6a2b3e79f8","a068ce58f3bb0593d985e6516011fdccaa100dc4b6476f3633320f6321a1e75f","648249c42dccda698d10d6be0aa83b2e3f061b1abcab91a6036540226883b049","0ffadd91431d65d6d26fcdefdf63247200d101e3afbd15ea08818660e9c605ce","ede47d57f50db1f28aca7d311aec3b24695a7a6aa9edca8e36714041c69e440c","3355c8fcf8b95f1c3be07c6472a3c4b2f142dba0070d4e6e9c9058015a263e00","f0c8d6ad8f1433c2a6f8b24036ad9987084f4bb5318c17fc87cd61adcb021e74","a8afa54410647909f2d09d351ad49190eb28a12c5db0998483cdd4a699ec090e","30abb2e9100875c4c9a9f47d40df3da8d9440613c663a544f6e1692ae493694e","44306e9f56c591bbf4b62eb455e363830363c750041166d1dc14144c545a5f57"],"paragraph_range_zero_based":[3216,3239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3216"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":3240},{"literal_text_all_w_t_and_m_t":"2>if the measIdleConfig is set to setup:","paragraph_zero_based":3241},{"literal_text_all_w_t_and_m_t":"3>store the received measIdleDuration in VarMeasIdleConfig;","paragraph_zero_based":3242},{"literal_text_all_w_t_and_m_t":"3>start timer T331 with the value set to measIdleDuration;","paragraph_zero_based":3243},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains measIdleCarrierListNR:","paragraph_zero_based":3244},{"literal_text_all_w_t_and_m_t":"4>store the received measIdleCarrierListNR in VarMeasIdleConfig;","paragraph_zero_based":3245},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains measIdleCarrierListEUTRA:","paragraph_zero_based":3246},{"literal_text_all_w_t_and_m_t":"4>store the received measIdleCarrierListEUTRA in VarMeasIdleConfig;","paragraph_zero_based":3247},{"literal_text_all_w_t_and_m_t":"3>if the measIdleConfig contains validityAreaList:","paragraph_zero_based":3248},{"literal_text_all_w_t_and_m_t":"4>store the received validityAreaList in VarMeasIdleConfig;","paragraph_zero_based":3249},{"literal_text_all_w_t_and_m_t":"1>if the RRCRelease includes suspendConfig:","paragraph_zero_based":3250},{"literal_text_all_w_t_and_m_t":"2>reset MAC and release the default MAC Cell Group configuration, if any;","paragraph_zero_based":3251},{"literal_text_all_w_t_and_m_t":"2>apply the received suspendConfig except the received nextHopChainingCount;","paragraph_zero_based":3252},{"literal_text_all_w_t_and_m_t":"2>if the sdt-Config is configured:","paragraph_zero_based":3253},{"literal_text_all_w_t_and_m_t":"3>for each of the DRB in the sdt-DRB-List:","paragraph_zero_based":3254},{"literal_text_all_w_t_and_m_t":"4>consider the DRB to be configured for SDT;","paragraph_zero_based":3255},{"literal_text_all_w_t_and_m_t":"3>if sdt-SRB2-Indication is configured:","paragraph_zero_based":3256},{"literal_text_all_w_t_and_m_t":"4>consider the SRB2 to be configured for SDT;","paragraph_zero_based":3257},{"literal_text_all_w_t_and_m_t":"3>for each RLC bearer (except those associated with broadcast MRBs) that is not suspended:","paragraph_zero_based":3258},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":3259},{"literal_text_all_w_t_and_m_t":"3>for SRB2 (if it is resumed) and for SRB1:","paragraph_zero_based":3260},{"literal_text_all_w_t_and_m_t":"4>trigger the PDCP entity to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":3261},{"literal_text_all_w_t_and_m_t":"3>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":3262},{"literal_text_all_w_t_and_m_t":"4>configure the PCell with the configured grant resources for SDT and instruct the MAC entity to start the cg-SDT-TimeAlignmentTimer;","paragraph_zero_based":3263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c7e93c2001bec37e03f37d39bd4558ff4f1c0dd91a9f1044545bab24bc12ab8c","c4ffe4323488597a7c5a5350683263dfc63948b679cfe940ac5b9d6a082cc3c3","0b4b1e419da59533360ec4d5c92629f8a6dd0c3bca8abc6a368bdd3b7dce0df1","8a4b27dd59d0e328896fab2d93201dd319d985901512ed0530db531d0fcdb991","2ff4f3a1cffff0349d3d79c965a31f2139587fba09c0a1c8c0897c80697d556b","782996608d4ea07a55e90ef9011fe62f7249810c3fd552a7a457e778af7347f8","1cd7ce24fa8a51bd3160739137160d4fd9536f46efbf99385cbffabe87f4ee41","0db5c81d4be5bd962cbfa2492a1420af6c627e6f1097ce9297938630dc6632f2","9053687baad99c6fc49ae6a8f95ad7c285d1062018fa54ec693bb29d496abf3b","4f4fd3d95c64d20a4360469ea3bb24d16258030269c0da9903046bae5012cab4","9a12303487918585a1e26c563d1c4a0ba5b018da8616bd37b27f6d9b2565d923","06e95f269da83d152b8096d454e961f65093172507097ea3c5e24d05472a0efd","fbfd9940f723e098a1579bc1401d6eb39aeb108fcba3949886e77c0eb0d47d83","fcfa0bdbef7b945b8770536929ef855f526c07810a07b34c3b82eef4b7847b53","5e51e9a2769ed9c0bdf12fd45344f767e3211d5b3d26beff5001732892c9b250","c586165d5d80a51a7252df3754bf18b951b37167f25802197556277c4e668cea","91c07aa45a3d1d54babafeebefd4c85046a09466784bd1b360e118308adf3895","a0f489132d05b443c112df6ff5771992cb7ec413487e9ee6afb11da968a4f2fe","77684081574c437032f4d2da03f82aa16522f3cf382463ca6288ccc6ad2a46c7","51e7002188ffaaf2f1a5ab2ad744dc8c20ad4c2bccb56f76b5d93a2b78c86bce","f60a0d41033b3d6d739e579b401443d241d579161ed580201a5b5f4ddc29f1fd","dbcb7f9ff845bca39177b08adb2795e52d34a351251d170a39e9ccd4228a32a5","eff9389d204db017aeed638e4a4395f916646d70a00b25587d629dfb0a36159a","b736358eedd6748e22ef45c8bc4066ee492f75671795414911bddd199ac0ba30"],"paragraph_range_zero_based":[3240,3263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3240"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if srs-PosRRC-Inactive is configured:","paragraph_zero_based":3264},{"literal_text_all_w_t_and_m_t":"3>apply the configuration and instruct MAC to start the inactivePosSRS-TimeAlignmentTimer;","paragraph_zero_based":3265},{"literal_text_all_w_t_and_m_t":"NOTE 1b:The Network should provide full configuration to UE for SRS for Positioning in RRC_INACTIVE.","paragraph_zero_based":3266},{"literal_text_all_w_t_and_m_t":"2>remove all the entries within the MCG and the SCG VarConditionalReconfig, if any;","paragraph_zero_based":3267},{"literal_text_all_w_t_and_m_t":"2>for each measId of the MCG measConfig and for each measId of the SCG measConfig, if configured, if the associated reportConfig has a reportType set to condTriggerConfig:","paragraph_zero_based":3268},{"literal_text_all_w_t_and_m_t":"3>for the associated reportConfigId:","paragraph_zero_based":3269},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":3270},{"literal_text_all_w_t_and_m_t":"3>if the associated measObjectId is only associated to a reportConfig with reportType set to condTriggerConfig:","paragraph_zero_based":3271},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":3272},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":3273},{"literal_text_all_w_t_and_m_t":"2>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3274},{"literal_text_all_w_t_and_m_t":"3>if the PC5-RRC connection with the U2N Relay UE is determined to be released:","paragraph_zero_based":3275},{"literal_text_all_w_t_and_m_t":"4>indicate upper layers to trigger PC5 unicast link release;","paragraph_zero_based":3276},{"literal_text_all_w_t_and_m_t":"3>else (i.e., maintain the PC5 RRC connection):","paragraph_zero_based":3277},{"literal_text_all_w_t_and_m_t":"4>establish or re-establish (e.g. via release and add) SL RLC entity for SRB1;","paragraph_zero_based":3278},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3279},{"literal_text_all_w_t_and_m_t":"3>re-establish RLC entities for SRB1;","paragraph_zero_based":3280},{"literal_text_all_w_t_and_m_t":"2>if the RRCRelease message with suspendConfig was received in response to an RRCResumeRequest or an RRCResumeRequest1:","paragraph_zero_based":3281},{"literal_text_all_w_t_and_m_t":"3>stop the timer T319 if running;","paragraph_zero_based":3282},{"literal_text_all_w_t_and_m_t":"3>in the stored UE Inactive AS context:","paragraph_zero_based":3283},{"literal_text_all_w_t_and_m_t":"4>replace the KgNB and KRRCint keys with the current KgNB and KRRCint keys;","paragraph_zero_based":3284},{"literal_text_all_w_t_and_m_t":"4>replace the nextHopChainingCount with the value of nextHopChainingCount received in the RRCRelease message;","paragraph_zero_based":3285},{"literal_text_all_w_t_and_m_t":"4>replace the cellIdentity with the cellIdentity of the cell the UE has received the RRCRelease message;","paragraph_zero_based":3286},{"literal_text_all_w_t_and_m_t":"4>if the suspendConfig contains the sl-UEIdentityRemote (i.e. the UE is a L2 U2N Remote UE):","paragraph_zero_based":3287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44d1d8c2178a25d8a20d026e73a4694b3d200aaefb0217ad44902eade5e5fa09","b8f4cf443f46d69e7c4260763e6da97815b238ba32422c725d368aca3c08172a","5102ca31e712d45b7125363739e9ac7d15abaec8f5678c67c0a3cea8687403b4","78bfd781ebcdf52e886e38e079b95f37c9bd95aad547974aee057644b5ed72d2","dbd6cc230ba0573797aec76d3529b2584755c2402d67364f20b343e61e2becf6","1e61065a153278c43a220c84b9a4082b7b7c22ef4b4b4520dced40bdd0b00ab5","9302c6694b439864c535e561704a4efca814037637d51303dbe1ab186872cc3e","9554412c6cf42102cc77d6d807749831304b92815b58890cd8143f828e7b0458","cd2e291d74a8f24b707ef0cc504642669874bed44c4776136f0876001a71ca88","1aa5d8e24de93683ad8ab28a8abb511ff94692c25b508f8c8de9e93e76699e7e","db70de6bbff840869f249fe0cc02e0311a5ee280b5d18f330071d0abd631e3fe","98fd9ec4c72a39d15a21626c1eb884bc0384ecf4c25fcba5b73b3f80df8b2f19","b7dfc86e944215aa2a7e8f8fb4cfeac37292f0687c7798141abe7a08dc52ba9e","fa59f70b39ca9cab117eda46f952d740944189e60f0df683376da08a52decf68","b79daab2e853105cc9c85b7f49d44c991d3e66554f1c4bb3e2d73ed4f07a508c","e77e2eb736fdbb387a99d0d6c8186ffcaf4e5004409d15ad5488012d597d3bd4","a63b5fd195b1291f54e95dfd434e8379d4e2056ac25af3555f76a36b51c9badf","e1b0021839e490403237842510c86f251a6c259935385e7e2e6fae9783e89e41","659318bcb4d2ed106e0929038598ba210352bb3291381526c8c272104b1f7593","408be8c46bd68b8168b7be32d42d442136aad658319f058bbec3d6a73cfab780","a1ee3f26f51cd94d8cd7be149e5b838c3dedf3973eb525d57306f88ebd73cb0a","f1f9e68b92620d196bb795b0bcdf4fd99956a95bda14ba9205d24e867d812304","1b367e45f4796a06623965d5dd8f1cf755252ddf211bc998970f60fac2c166f2","0292207590bbe9c33226891a1227d24f8f223ddd629f32397f42d8fbb7c84387"],"paragraph_range_zero_based":[3264,3287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3264"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>replace the C-RNTI with the value of the sl-UEIdentityRemote;","paragraph_zero_based":3288},{"literal_text_all_w_t_and_m_t":"5>replace the physical cell identity with the value of the sl-PhysCellId in sl-ServingCellInfo contained in the discovery message received from the connected L2 U2N Relay UE;","paragraph_zero_based":3289},{"literal_text_all_w_t_and_m_t":"4> else:","paragraph_zero_based":3290},{"literal_text_all_w_t_and_m_t":"5>replace the C-RNTI with the C-RNTI used in the cell (see TS 38.321 [3]) the UE has received the RRCRelease message;","paragraph_zero_based":3291},{"literal_text_all_w_t_and_m_t":"5>replace the physical cell identity with the physical cell identity of the cell the UE has received the RRCRelease message;","paragraph_zero_based":3292},{"literal_text_all_w_t_and_m_t":"3>replace the nextHopChainingCount with the value associated with the current KgNB;","paragraph_zero_based":3293},{"literal_text_all_w_t_and_m_t":"3>stop the timer T319a if running and consider SDT procedure is not ongoing;","paragraph_zero_based":3294},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3295},{"literal_text_all_w_t_and_m_t":"3>store in the UE Inactive AS Context the nextHopChainingCount received in the RRCRelease message, the current KgNB and KRRCint keys, the ROHC state, the EHC context(s), the UDC state, the stored QoS flow to DRB mapping rules, the application layer measurement configuration, the C-RNTI used in the source PCell, the cellIdentity and the physical cell identity of the source PCell, the spCellConfigCommon within ReconfigurationWithSync of the NR PSCell (if configured) and all other parameters configured except for:","paragraph_zero_based":3296},{"literal_text_all_w_t_and_m_t":"-parameters within ReconfigurationWithSync of the PCell;","paragraph_zero_based":3297},{"literal_text_all_w_t_and_m_t":"-parameters within ReconfigurationWithSync of the NR PSCell, if configured;","paragraph_zero_based":3298},{"literal_text_all_w_t_and_m_t":"-parameters within MobilityControlInfoSCG of the E-UTRA PSCell, if configured;","paragraph_zero_based":3299},{"literal_text_all_w_t_and_m_t":"-servingCellConfigCommonSIB;","paragraph_zero_based":3300},{"literal_text_all_w_t_and_m_t":"-sl-L2RelayUE-Config, if configured;","paragraph_zero_based":3301},{"literal_text_all_w_t_and_m_t":"-sl-L2RemoteUE-Config, if configured;","paragraph_zero_based":3302},{"literal_text_all_w_t_and_m_t":"-uav-Config, if configured;","paragraph_zero_based":3303},{"literal_text_all_w_t_and_m_t":"NOTE 1c:suspendConfig is not stored as part of UE Inactive AS Context, except for the fields explicitly specified.","paragraph_zero_based":3304},{"literal_text_all_w_t_and_m_t":"3>store any previously or subsequently received application layer measurement report containers for which no segment, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":3305},{"literal_text_all_w_t_and_m_t":"NOTE 2:NR sidelink communication/discovery related configurations and logged measurement configuration are not stored as UE Inactive AS Context, when UE enters RRC_INACTIVE.","paragraph_zero_based":3306},{"literal_text_all_w_t_and_m_t":"2>suspend all SRB(s) and DRB(s) and multicast MRB(s), except SRB0 and broadcast MRBs;","paragraph_zero_based":3307},{"literal_text_all_w_t_and_m_t":"2>indicate PDCP suspend to lower layers of all DRBs and multicast MRBs;","paragraph_zero_based":3308},{"literal_text_all_w_t_and_m_t":"2>release Uu Relay RLC channel(s), if configured;","paragraph_zero_based":3309},{"literal_text_all_w_t_and_m_t":"2>release PC5 Relay RLC channel(s), if configured;","paragraph_zero_based":3310},{"literal_text_all_w_t_and_m_t":"2>release the SRAP entity, if configured;","paragraph_zero_based":3311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f75c908183ee373a32c79e1b5f57d3320b7b956744efff613f1b3951f74f624d","ced08970b049262e463174b4aa8a133aa2f75142daef49cb57e421b0275fc631","8e59f1f1212c4266f08edfce6e60424d5b9a373edcea1fa616592b7b9e395bc3","5563c3dfb8dd620abed1245a1b2632dcf4e223952790b8dbe8ee97425d5ef477","90a7d4627aece8b59030a34332994ce2a7bd6560c3db4588c99f62054773712c","fadba023b2eb9ef5772aaa79a7d9592b7413bc4311b7162718ef5605e5782e0d","310b083fe6b96becc93627e7798a99eeddadb7028b190ddf74527b9a7c042fcd","3fe6a3242c3871e264cd7235e07814ffd2d90a50ef157febf10496397b1a52a2","f3cff73523ed2e7e2f82599520de14c3552f2a97384ad61e7e96b2c638dae668","d4ad7b29a5eb0e8bbb07c06bb7378abe96f35f63d31bc9f1e21e8651462a0a6e","dad90eaf42ada78302e9a0fd0e45b5ad0ee54c2517b359e46235dfe817572258","6ffb98eab825fc5df7f068ff38adbccbe05e87dc9fe9577e645ee7cc73d9e06d","975d6da2a401577d8fa85a335f3ecae7a44b37ec036d7a5aeefe1c36cfcf1b52","3dba5e048bbb8c1529addfb3c2f1d3bf95a55e68e8c3935b7ed99b7fcf5332dd","34cf9cd0861382cec0019a86eaeb3c331770568a677446e77258d38b20a8a900","08445754db8a90cbc2fe108481cdc063bda380bb95306a2e548589243f120186","602af38d5b805797da477121fe3696f01e31aaaabede7b0b818c0f692e6eadd9","b8005d8cdbb8d5131bdbec722c3c81b8496aeae01f90b3a8e12eb13bb86c989b","221a11541cb23f44cea9ce5fc47d26bd5d5fc809b09124bb2cc33cb5a1483407","c4925ab3bf34a1f77b02863312ea905ae0931383dc037064c21faae53b409ba6","a103fcc42442c5f6f490a3724c6e898a2f4134074973e1650b43e5aa4fcc77bb","baa9c137acc077c82cfe42aced1696bc8a2e15bd6aa2248c724041220802e5d7","129abcc25edeed30a5f02734ec09bd0fbe26b97bd9750f7021184b8e69d9f5d6","6fed5d221b67ad1a013c049c58f01333d28bd2d605d3a98bf6ed11608ad89c8f"],"paragraph_range_zero_based":[3288,3311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3288"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 2a:A L2 U2N Relay UE may re-establish the SL-RLC0, SL-RLC1 and SRAP entity after release.","paragraph_zero_based":3312},{"literal_text_all_w_t_and_m_t":"2>if the t380 is included:","paragraph_zero_based":3313},{"literal_text_all_w_t_and_m_t":"3>start timer T380, with the timer value set to t380;","paragraph_zero_based":3314},{"literal_text_all_w_t_and_m_t":"2>if the RRCRelease message is including the waitTime:","paragraph_zero_based":3315},{"literal_text_all_w_t_and_m_t":"3>start timer T302 with the value set to the waitTime;","paragraph_zero_based":3316},{"literal_text_all_w_t_and_m_t":"3>inform upper layers that access barring is applicable for all access categories except categories '0' and '2';","paragraph_zero_based":3317},{"literal_text_all_w_t_and_m_t":"2>if T390 is running:","paragraph_zero_based":3318},{"literal_text_all_w_t_and_m_t":"3>stop timer T390 for all access categories;","paragraph_zero_based":3319},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3320},{"literal_text_all_w_t_and_m_t":"2>indicate the suspension of the RRC connection to upper layers;","paragraph_zero_based":3321},{"literal_text_all_w_t_and_m_t":"2>if the UE is capable of L2 U2N Remote UE:","paragraph_zero_based":3322},{"literal_text_all_w_t_and_m_t":"3>enter RRC_INACTIVE, and perform either cell selection as specified in TS 38.304 [20], or relay selection as specified in clause 5.8.15.3, or both;","paragraph_zero_based":3323},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3324},{"literal_text_all_w_t_and_m_t":"3>enter RRC_INACTIVE and perform cell selection as specified in TS 38.304 [20];","paragraph_zero_based":3325},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3326},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with the release cause 'other'.","paragraph_zero_based":3327},{"literal_text_all_w_t_and_m_t":"NOTE 3:Whether to release the PC5 unicast link is left to L2 U2N Remote UE's implementation.","paragraph_zero_based":3328},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is left to UE implementation whether to stop T430, if running, when going to RRC_INACTIVE.","paragraph_zero_based":3329},{"literal_text_all_w_t_and_m_t":"5.3.8.4T320 expiry","paragraph_zero_based":3330},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3331},{"literal_text_all_w_t_and_m_t":"1>if T320 expires:","paragraph_zero_based":3332},{"literal_text_all_w_t_and_m_t":"2>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities or inherited from another RAT;","paragraph_zero_based":3333},{"literal_text_all_w_t_and_m_t":"2>apply the cell reselection priority information broadcast in the system information.","paragraph_zero_based":3334},{"literal_text_all_w_t_and_m_t":"5.3.8.5UE actions upon the expiry of DataInactivityTimer","paragraph_zero_based":3335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6f492f99d8ddb72dc2aef45b3388e2ac12096f7368e55ebaf10583f59f22d592","39d9ba95fcb13662e54c9733c89a27aab7f27683682e593a8a1a2fb388893470","21354a94fc44136eae46a962179041e9f357f838814c7e3353644073c791f872","16c60588c5b99c007d9c3195dd81006c985058eb31806ba02e15f293ca5c1d66","a33c3ef01f01a0af5568b0c41cbc1511ed4b44566dae86e9e478c35afd69b792","d30212c2cb37e0f1302874750b7028d959fd7ac9a4ccecd095ceb2778a92a9ab","b6d771cbc160f54420ad576a7cbf76f69c967b07fbf3c29c6aa6462cec008105","7e534db94e23ac36c8d767853a745dc38c4495aed6dafa0ff675296862ab5fc8","7058db018bb9594cf24328fe48134dc785d6f50dd7b7603a22ccfc5226b32173","a28c6af529787347700a1088f37bcbd7e2fbaf679f68cee04e3a67cb306ab419","31ab02ba27c53eb0edc34e553a266877babecb5a84c1123c47e8ab894fa539d2","1767b04d77557762115371d68b01c5530bc2517e15db54ed5a64ba1adaee11a1","aff13d6d4dbbb1e6792746a68be9e0d45cf8eb0c48a39e18f00d829306c5fd7d","53a2c801f721f22117382811e94fd347ea11462df0d0a629088b697e83047516","468a258888f17074184ae5d098df920b72df972e5c36fc0f1969e02c976ca20d","38484a6c900af9f5ee41d3dd6500d4631b877ff7ca1bed782a000901b6ae22fe","1e91d009fd050f5050ce4e9ecea0764ed3be58e3f455550765450ff238abb532","17f9e2eb556b5d2f51f242f1b72abf26a26fc162f91da3af47a86836a9012027","5e9b7ccfa937aacc545d57bf58948690715ae0b8692f1d01cc1c8bf34bf9e5c9","9496a092d5df5f9ca445ec642825cb35d077d9c71a5cd6c5df5966ba7f523126","5fbf0afa04079a3174b183810a7abdae7c4d47ed2d39080e7d5c4d8936b5f983","1bb381e231f6048a99a98d237a1b8bf33e9d131dea51dc8eb5a6474ad9d47f23","cd2ea7dd36a061b72f70b6e0215de2136d4817250b9708cd33f7660a21198035","734d7c2b88f5fabeebd3322fbc7bbe446eea108a404c6040effe6ab839631dae"],"paragraph_range_zero_based":[3312,3335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3312"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving the expiry of DataInactivityTimer from lower layers while in RRC_CONNECTED, the UE shall:","paragraph_zero_based":3336},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure'.","paragraph_zero_based":3337},{"literal_text_all_w_t_and_m_t":"5.3.8.6T346g expiry","paragraph_zero_based":3338},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3339},{"literal_text_all_w_t_and_m_t":"1>if T346g expires:","paragraph_zero_based":3340},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'other'.","paragraph_zero_based":3341},{"literal_text_all_w_t_and_m_t":"5.3.9RRC connection release requested by upper layers","paragraph_zero_based":3342},{"literal_text_all_w_t_and_m_t":"5.3.9.1General","paragraph_zero_based":3343},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to release the RRC connection. Access to the current PCell may be barred as a result of this procedure.","paragraph_zero_based":3344},{"literal_text_all_w_t_and_m_t":"5.3.9.2Initiation","paragraph_zero_based":3345},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when upper layers request the release of the RRC connection as specified in TS 24.501 [23]. The UE shall not initiate the procedure for power saving purposes.","paragraph_zero_based":3346},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3347},{"literal_text_all_w_t_and_m_t":"1>if the upper layers indicate barring of the PCell:","paragraph_zero_based":3348},{"literal_text_all_w_t_and_m_t":"2>treat the PCell used prior to entering RRC_IDLE as barred according to TS 38.304 [20];","paragraph_zero_based":3349},{"literal_text_all_w_t_and_m_t":"1>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'other'.","paragraph_zero_based":3350},{"literal_text_all_w_t_and_m_t":"5.3.10Radio link failure related actions","paragraph_zero_based":3351},{"literal_text_all_w_t_and_m_t":"5.3.10.1Detection of physical layer problems in RRC_CONNECTED","paragraph_zero_based":3352},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3353},{"literal_text_all_w_t_and_m_t":"1>if any DAPS bearer is configured, upon receiving N310 consecutive \"out-of-sync\" indications for the source SpCell from lower layers and T304 is running:","paragraph_zero_based":3354},{"literal_text_all_w_t_and_m_t":"2>start timer T310 for the source SpCell.","paragraph_zero_based":3355},{"literal_text_all_w_t_and_m_t":"1>upon receiving N310 consecutive \"out-of-sync\" indications for the SpCell from lower layers while neither T300, T301, T304, T311, T316 nor T319 are running:","paragraph_zero_based":3356},{"literal_text_all_w_t_and_m_t":"2>start timer T310 for the corresponding SpCell.","paragraph_zero_based":3357},{"literal_text_all_w_t_and_m_t":"5.3.10.2Recovery of physical layer problems","paragraph_zero_based":3358},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive \"in-sync\" indications for the SpCell from lower layers while T310 is running, the UE shall:","paragraph_zero_based":3359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4a8ff8882b704b6feae9a45eafe7634e7db5a41db165464cf97fd83f41efaaad","81a34d45a87cdbfb11cd05da3ee8c4fc5d6e1f92ac0d9db10713dcc008e98164","676a9239f1a81a361389531a862439e6f629b6f6b662a9908fcf31fd8484b31b","dc834d779f2f7853cf9b0db9d9ed5073c3e26ad898981a5c63bd75869ece92a3","9c9f33301a9007d15d69abed98033bb0edbb51ac12a7087119147ea63bea894b","cd04cb25396c46daeffbf3d8935f25451d7a22116f89db304bd0cf527c1eda10","e582521ec4c0da06f9ec53f1252b03d1a62a3bccac567a91ebab1fd4166d6a70","7876d8036ab57eb7451e175d2b131afd7aead96239108aeb4356bb967bb8e866","9e021890fb990279924dd60b6b517438d0ad596fd5b1176f8cb41529fbd531bc","796fd17907bdc48da02d473b8465098daf3e76a2eea422d708275611332752fc","b5e0a485c265cf146ca977d2ec300d801e27af917167c8347d7cd32ab77f5e1e","2908b4fac8099d85b3c3200775e40a65fd88ee676b2b80290748e26356d0f481","2e70298fcfd241174a9f42fcd2dc523e86c7bc5dc90e7bf0310145989b0108bc","69d9a4e9e909960dd909daab6fae8d629a31283a379c3d20e33ec607e1d1b9db","71942cac6ea5783f933e6f848405b8de794ffd775da3e0620c781384c18c92d0","540e3042aef714ed91968600d1de8526961cd07e297cf7d8a3c4365a8c77da80","44ae88c52dce043abb39e6fe266bc2ad657d42e9c93553d7d9ac2f524d4f906c","627e6f249d9758365b19f529bb9b59c6cd8c35e37402dcf6c390513558474ed9","e2675cd6cda51cd7de9e949cf57cb0be61be8da0563813f2dca3073ee6263353","523aed4cbad23f9c9c09d9d18fab94071ce57b4818a9215679c546f52934d8f2","b6be8e5648f49b11f614b37fd72a34f352671cf0a216fde9a3a0329991f000e7","71b6a6bc857aacc4da7dd482a5b48d6b68e90c940f7e3be41203d20fe655190c","1a862e74d7d8f55e554787f8132d20a3d4e69f3352b9d0039d17306d965fc481","5373be93d95a0ea0f8fcbd8219b4c909fe668c4c2c93498a06ea7edcc794ef8a"],"paragraph_range_zero_based":[3336,3359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3336"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>stop timer T310 for the corresponding SpCell.","paragraph_zero_based":3360},{"literal_text_all_w_t_and_m_t":"1>stop timer T312 for the corresponding SpCell, if running.","paragraph_zero_based":3361},{"literal_text_all_w_t_and_m_t":"NOTE 1:In this case, the UE maintains the RRC connection without explicit signalling, i.e. the UE maintains the entire radio resource configuration.","paragraph_zero_based":3362},{"literal_text_all_w_t_and_m_t":"NOTE 2:Periods in time where neither \"in-sync\" nor \"out-of-sync\" is reported by L1 do not affect the evaluation of the number of consecutive \"in-sync\" or \"out-of-sync\" indications.","paragraph_zero_based":3363},{"literal_text_all_w_t_and_m_t":"5.3.10.3Detection of radio link failure","paragraph_zero_based":3364},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3365},{"literal_text_all_w_t_and_m_t":"1>if any DAPS bearer is configured and T304 is running:","paragraph_zero_based":3366},{"literal_text_all_w_t_and_m_t":"2>upon T310 expiry in source SpCell; or","paragraph_zero_based":3367},{"literal_text_all_w_t_and_m_t":"2>upon random access problem indication from source MCG MAC; or","paragraph_zero_based":3368},{"literal_text_all_w_t_and_m_t":"2>upon indication from source MCG RLC that the maximum number of retransmissions has been reached; or","paragraph_zero_based":3369},{"literal_text_all_w_t_and_m_t":"2>upon consistent uplink LBT failure indication from source MCG MAC:","paragraph_zero_based":3370},{"literal_text_all_w_t_and_m_t":"3>consider radio link failure to be detected for the source MCG i.e. source RLF;","paragraph_zero_based":3371},{"literal_text_all_w_t_and_m_t":"3>suspend the transmission and reception of all DRBs and multicast MRBs in the source MCG;","paragraph_zero_based":3372},{"literal_text_all_w_t_and_m_t":"3>reset MAC for the source MCG;","paragraph_zero_based":3373},{"literal_text_all_w_t_and_m_t":"3>release the source connection.","paragraph_zero_based":3374},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3375},{"literal_text_all_w_t_and_m_t":"2>during a DAPS handover: the following only applies for the target PCell;","paragraph_zero_based":3376},{"literal_text_all_w_t_and_m_t":"2>upon T310 expiry in PCell; or","paragraph_zero_based":3377},{"literal_text_all_w_t_and_m_t":"2>upon T312 expiry in PCell; or","paragraph_zero_based":3378},{"literal_text_all_w_t_and_m_t":"2>upon random access problem indication from MCG MAC while neither T300, T301, T304, T311 nor T319 are running and SDT procedure is not ongoing; or","paragraph_zero_based":3379},{"literal_text_all_w_t_and_m_t":"2>upon indication from MCG RLC that the maximum number of retransmissions has been reached while SDT procedure is not ongoing; or","paragraph_zero_based":3380},{"literal_text_all_w_t_and_m_t":"2>if connected as an IAB-node, upon BH RLF indication received on BAP entity from the MCG; or","paragraph_zero_based":3381},{"literal_text_all_w_t_and_m_t":"2>upon consistent uplink LBT failure indication from MCG MAC while T304 is not running:","paragraph_zero_based":3382},{"literal_text_all_w_t_and_m_t":"3>if the indication is from MCG RLC and CA duplication is configured and activated for MCG, and for the corresponding logical channel allowedServingCells only includes SCell(s):","paragraph_zero_based":3383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["06b4049bbfd5778164f1f0d2a7d82868070703d5424b9b9ae89e3cf135817631","bd32eba4c08360cf711291a5eefa04987b7c5035f918edca09e31dbcdb17492e","15ec0c2f83ca73e286906483f035ca700f6e5941fb9935caf0d2b5dd4db1e22e","34d2f67cfed6e915cfc7ae917d6637ec8ea3ab9e93b2ecbd750e9bcb736fcc21","019cf8b98028272cc332351ecf7992649b7bbbe1dc38ec798e65fc74cb812152","d03c1c90b1252eabab0d60559808db11f7a5facf46f2bf550a7bb62be5ad8d01","67849f0c4c0c285b7d82fd0f1727d4db9f0ac6c222f156ef76fff9d201cdd2f7","20c2bebf8514f9844b13171fd902e386c2834f7288d9203b8f907f92116916a1","cc46fc862b76d9bba4094fe68e392c2ffcbb11a7211f706f642535488f27e407","f11a263b06d6aba1ce2c13246dd5b0647760c78c28e386cb951eae8775b0a948","6be2590872c8482c7e8b76583dae78b151acb7e9046e96443bca4769b667ea0a","c20acbaea94c19922135bbd23ba0d1a99f3046f7c5dfa5c83cb9ff3e3d068bf4","be3a1f194ee8e4f18cc1b68bb0ff3826098f785fa91a13d8a5775f7a4ccbead5","164c43af3ec02b0e4b267a98e855f532f7aa2a4bbb70caddf208e484c27081b9","83743d77c3d7165aa0df1b28f6decbd1be6f1afa894065af20e32fc4e0b2967a","e259ac46e6bb03fd6fa635b4d086b3bc97538ddb54efedc08a8ff9cb0c128777","a5b26f6c0578caf3a0d349c34f2904f9914d3f84d7019ef023667fb66a2350f6","5a21044491a89cfd24693a51d38034206d56b0c59f01930e66d171fdce4a2fb4","6d735104e3ffca09fd1e44836e0319005c3391c6c17c9bd2fd5428b74704f25e","b59eb65c47c0a00c289f1885a659cb574c46742dd1a2285db15148e8b06b4fbf","deccafe7e1256ff38a48198ce1833f69ecf28e6999b3749ae23971c457346228","cd8313f7dca67847a6e528addfdf1e4fc1f94d363a0131faecf597f441c9c77c","0f69704cbb8687c66249cc78c0cf3952e59d0134e283b303789c036bade70b93","d9d71cca2b855fd8f1ebb8f5a67f4896ef4d93f42817eefed5080d058dfac28f"],"paragraph_range_zero_based":[3360,3383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3360"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>initiate the failure information procedure as specified in 5.7.5 to report RLC failure.","paragraph_zero_based":3384},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3385},{"literal_text_all_w_t_and_m_t":"4>consider radio link failure to be detected for the MCG, i.e. MCG RLF;","paragraph_zero_based":3386},{"literal_text_all_w_t_and_m_t":"4>discard any segments of segmented RRC messages stored according to 5.7.6.3;","paragraph_zero_based":3387},{"literal_text_all_w_t_and_m_t":"NOTE:Void.","paragraph_zero_based":3388},{"literal_text_all_w_t_and_m_t":"4>if AS security has not been activated:","paragraph_zero_based":3389},{"literal_text_all_w_t_and_m_t":"5>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'other';-","paragraph_zero_based":3390},{"literal_text_all_w_t_and_m_t":"4>else if AS security has been activated but SRB2 and at least one DRB or multicast MRB or, for IAB, SRB2, have not been setup:","paragraph_zero_based":3391},{"literal_text_all_w_t_and_m_t":"5>store the radio link failure information in the VarRLF-Report as described in clause 5.3.10.5;","paragraph_zero_based":3392},{"literal_text_all_w_t_and_m_t":"5>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure';","paragraph_zero_based":3393},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":3394},{"literal_text_all_w_t_and_m_t":"5>store the radio link failure information in the VarRLF-Report as described in clause 5.3.10.5;","paragraph_zero_based":3395},{"literal_text_all_w_t_and_m_t":"5>if T316 is configured; and","paragraph_zero_based":3396},{"literal_text_all_w_t_and_m_t":"5>if SCG transmission is not suspended; and","paragraph_zero_based":3397},{"literal_text_all_w_t_and_m_t":"5>if the SCG is not deactivated; and","paragraph_zero_based":3398},{"literal_text_all_w_t_and_m_t":"5>if neither PSCell change nor PSCell addition is ongoing (i.e. timer T304 for the NR PSCell is not running in case of NR-DC or timer T307 of the E-UTRA PSCell is not running as specified in TS 36.331 [10], clause 5.3.10.10, in NE-DC):","paragraph_zero_based":3399},{"literal_text_all_w_t_and_m_t":"6>initiate the MCG failure information procedure as specified in 5.7.3b to report MCG radio link failure.","paragraph_zero_based":3400},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":3401},{"literal_text_all_w_t_and_m_t":"6>initiate the connection re-establishment procedure as specified in 5.3.7.","paragraph_zero_based":3402},{"literal_text_all_w_t_and_m_t":"A L2/L3 U2N Relay UE shall:","paragraph_zero_based":3403},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure:","paragraph_zero_based":3404},{"literal_text_all_w_t_and_m_t":"2>either indicate to upper layers (to trigger PC5 unicast link release) or send NotificationMessageSidelink to the connected L2/L3 U2N Remote UE(s) in accordance with 5.8.9.10.","paragraph_zero_based":3405},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3406},{"literal_text_all_w_t_and_m_t":"1>upon T310 expiry in PSCell; or","paragraph_zero_based":3407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c2ff1e15e27a3f9e6017cdf9c5b30b2fae233f475cb911ec952dc9a2af2ba839","2701dc5d37d11ac4d1c3fcb1cca87e36a7299e8c825569a947ba01e635d262b4","47013e5f5737923f75c41275c6029d5baa2d56de5bfc3c11091fdc13b8a2e011","4b76dcefba44777b456fb0e1ef3de0bb10c2700db681479f4421f04ddfea6639","094f30996a4f33acb39145e4b965020fb12a1530842d0436b640b6311346cebc","b7d1a802997168ec6079ceea7550d5651fa97ae6d02b753806eb049f4afc6e61","4c8e5f07f71d7133468b843326d005900899166a50ccd285d87631f93a39f062","90289f22f8efffc30f051fb85403ef099aee766aa0594887e3ca54c3c4264f03","8c807b4ab1776a30101cd59769be6f908b4ea1e4ec328a903218bbbcfe5cf62b","52fd67b5a61367ee81d4615bab22988416ed0064f9a78da5682d13092ae88cc4","c096a0d73072fddec6205afa230756959f0803383d7ea6c78d8cc54f99e3fba8","0a60f5c75721c3be3e2db744295b216b24b4d51bea58448740215b56cd8f4084","69bd0fd770b8e93d976fc9727417dcc9f622ba5325ee478e58be433053c3c811","243cff12cef8882dc619940388bae811334eaaf8c7ee307f4eb124da20eb89ac","95526837cbb28a551e8d3f1bf19145ae07e99c62de7947cf1e354026cd8a8e52","6028100ba49a3ccaa78aa107285e0b06f906ef651f15156c2c56698351932214","55f0ea4d23a56d085ab0c20721b8ad651eeec9153c72118f2df2273d1daf3d62","f7f57259bf39eb936cef9d9977bf312578dba78c74169955a7c89814d0f076b1","21355d38ad33edbd5b896f7fb786c538031c0bf2e1883d04f92915261f233778","a03148391507ae2525565945f4f1110849400ef5dffe7c37114c571d0721e356","0fcabb676286fff8bfe3f8c424a41784a067c7a4e7092c6399c60940e9729d5c","fa3111af8a8e7590e1bd3cbbf61122b9b55450b406c236dbb258c7a49532b92f","5fd8554fc643983735c0895bc54c4c137ba9cb143ac29847ae2e01a8d0f55201","da05a65aa4968294354412170905f090af0dd3171c9a5f0899d27a78ff39b53a"],"paragraph_range_zero_based":[3384,3407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>upon T312 expiry in PSCell; or","paragraph_zero_based":3408},{"literal_text_all_w_t_and_m_t":"1>upon random access problem indication from SCG MAC; or","paragraph_zero_based":3409},{"literal_text_all_w_t_and_m_t":"1>upon indication from SCG RLC that the maximum number of retransmissions has been reached; or","paragraph_zero_based":3410},{"literal_text_all_w_t_and_m_t":"1>if connected as an IAB-node, upon BH RLF indication received on BAP entity from the SCG; or","paragraph_zero_based":3411},{"literal_text_all_w_t_and_m_t":"1>upon consistent uplink LBT failure indication from SCG MAC:","paragraph_zero_based":3412},{"literal_text_all_w_t_and_m_t":"2>if the indication is from SCG RLC and CA duplication is configured and activated for SCG, and for the corresponding logical channel allowedServingCells only includes SCell(s):","paragraph_zero_based":3413},{"literal_text_all_w_t_and_m_t":"3>initiate the failure information procedure as specified in 5.7.5 to report RLC failure.","paragraph_zero_based":3414},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3415},{"literal_text_all_w_t_and_m_t":"3>consider radio link failure to be detected for the SCG, i.e. SCG RLF;","paragraph_zero_based":3416},{"literal_text_all_w_t_and_m_t":"3>if the SCG is deactivated:","paragraph_zero_based":3417},{"literal_text_all_w_t_and_m_t":"4>stop radio link monitoring on the SCG;","paragraph_zero_based":3418},{"literal_text_all_w_t_and_m_t":"4>indicate to lower layers to stop beam failure detection on the PSCell;","paragraph_zero_based":3419},{"literal_text_all_w_t_and_m_t":"3>if MCG transmission is not suspended:","paragraph_zero_based":3420},{"literal_text_all_w_t_and_m_t":"4>initiate the SCG failure information procedure as specified in 5.7.3 to report SCG radio link failure.","paragraph_zero_based":3421},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3422},{"literal_text_all_w_t_and_m_t":"4>if the UE is in NR-DC:","paragraph_zero_based":3423},{"literal_text_all_w_t_and_m_t":"5>initiate the connection re-establishment procedure as specified in 5.3.7;","paragraph_zero_based":3424},{"literal_text_all_w_t_and_m_t":"4>else (the UE is in (NG)EN-DC):","paragraph_zero_based":3425},{"literal_text_all_w_t_and_m_t":"5>initiate the connection re-establishment procedure as specified in TS 36.331 [10], clause 5.3.7;","paragraph_zero_based":3426},{"literal_text_all_w_t_and_m_t":"5.3.10.4RLF cause determination","paragraph_zero_based":3427},{"literal_text_all_w_t_and_m_t":"The UE shall set the rlf-Cause in the VarRLF-Report as follows:","paragraph_zero_based":3428},{"literal_text_all_w_t_and_m_t":"1>if the UE declares radio link failure due to T310 expiry:","paragraph_zero_based":3429},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause as t310-Expiry;","paragraph_zero_based":3430},{"literal_text_all_w_t_and_m_t":"1>else if the UE declares radio link failure due to the random access problem indication from MCG MAC:","paragraph_zero_based":3431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1be5a3d59ced332bee228e8df45777943fd961240011cfdac97da1cbde0fb6b9","d2313245b1fb0471e2557c85b5ed20153f60d5e53a8ddc19ed5cda581fc2a1be","7eebf6d380da6c377bf04676d2d3333fa4e3e81c090d841d9f0b750133d5cdb4","017c400f8535f609db65750743f11befb8935851ce17dce75c4b82c02cde1981","733915a2f067caac6ef74b2932f67b7997337ef86ae8226f7ed411ba81eae38a","a20036576eaf90acf0e000befb996e693001535818bfd176a76421c2dc562d60","167286573d217ec83ff1db2121d24ff1000e142f4d0ff97e0f304cc24e6248e4","61ad7546388b091527b3f8770940d31883fa6f260aada8d275619cce6acef845","4db040742eb05530da669a289c3afeedc8de4f0d07595cad8b0c739fee432ef5","1685bb672e3cf0a63333413eb26ffb2be5a3d0730105982171746b0d2e537f24","60c2e6b462d4f11c190152540bb4b722478e83ed763b397edf813eed9d6df977","0eecf19a7e2c80a18281d2aa46cbc25802990988350fc505fcf7fd50d20a2b00","d5b2092cfc84c4b0b9f0653ba6e1b98e2c86706ee81d197d401053c89395fca4","f2c8ebddf2bbd89b41c10aba21a65691e8d200055b3d682c492bb2bf0d8a4417","56a071ffcfbb41164ea7e5135e8f09330615c8dcad88f677e63b4f649291e002","aebb6efbfe790cc57830a685d7b72e5f7e68d3b095cf5c952877cfd20fd88f72","37dce1ebf2a19aa9cebab8e1f7d269bc909e050d96e86864ccc8173c50ed7705","c55ab64b0a2f00b645916f9f12c0f1edaf966c9878e89297769e7dc0eae9289f","401ffc0741c85a58f95aae233f3de82564b4579e76ef728c0332a94b966d1dc0","771971f6b8472d5b226af8ac5d8f3931582c0e9b4f5b67ca2f3daaa93f12e597","0e41157fad9a9738a081d4f795338798d5e4bde8d955b57d6dab365227aff239","5c63e1df3b1be6e5e964e0ab980c7e6414a37bd47afbdce42a6e8477d61febc9","7a270e7f3c0e72b155db39f1272d2e8809c04ceb0afa9a2c65088b33e3b719c0","808eec5949c98a545c24a7122328e4774b0c14020514233991133279ae0da6a7"],"paragraph_range_zero_based":[3408,3431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3408"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":3432},{"literal_text_all_w_t_and_m_t":"3>set the rlf-Cause as beamFailureRecoveryFailure;","paragraph_zero_based":3433},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3434},{"literal_text_all_w_t_and_m_t":"3>set the rlf-Cause as randomAccessProblem;","paragraph_zero_based":3435},{"literal_text_all_w_t_and_m_t":"1>else if the UE declares radio link failure due to the reaching of maximum number of retransmissions from the MCG RLC:","paragraph_zero_based":3436},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause as rlc-MaxNumRetx;","paragraph_zero_based":3437},{"literal_text_all_w_t_and_m_t":"1>else if the UE declares radio link failure due to consistent uplink LBT failures:","paragraph_zero_based":3438},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause as lbtFailure;","paragraph_zero_based":3439},{"literal_text_all_w_t_and_m_t":"1>else if the IAB-MT declares radio link failure due to the reception of a BH RLF indication on BAP entity:","paragraph_zero_based":3440},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause as bh-rlfRecoveryFailure.","paragraph_zero_based":3441},{"literal_text_all_w_t_and_m_t":"1>else if the UE declares radio link failure due to T312 expiry:","paragraph_zero_based":3442},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause as t312-Expiry;","paragraph_zero_based":3443},{"literal_text_all_w_t_and_m_t":"5.3.10.5RLF report content determination","paragraph_zero_based":3444},{"literal_text_all_w_t_and_m_t":"The UE shall determine the content in the VarRLF-Report as follows:","paragraph_zero_based":3445},{"literal_text_all_w_t_and_m_t":"1>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":3446},{"literal_text_all_w_t_and_m_t":"1>set the plmn-IdentityList to include the list of EPLMNs stored by the UE (i.e. includes the RPLMN);","paragraph_zero_based":3447},{"literal_text_all_w_t_and_m_t":"1>set the measResultLastServCell to include the cell level RSRP, RSRQ and the available SINR, of the source PCell (in case HO failure) or PCell (in case RLF) based on the available SSB and CSI-RS measurements collected up to the moment the UE detected failure;","paragraph_zero_based":3448},{"literal_text_all_w_t_and_m_t":"1>if the SS/PBCH block-based measurement quantities are available:","paragraph_zero_based":3449},{"literal_text_all_w_t_and_m_t":"2>set the rsIndexResults in measResultLastServCell to include all the available measurement quantities of the source PCell (in case HO failure) or PCell (in case RLF), ordered such that the highest SS/PBCH block RSRP is listed first if SS/PBCH block RSRP measurement results are available, otherwise the highest SS/PBCH block RSRQ is listed first if SS/PBCH block RSRQ measurement results are available, otherwise the highest SS/PBCH block SINR is listed first, based on the available SS/PBCH block based measurements collected up to the moment the UE detected failure;","paragraph_zero_based":3450},{"literal_text_all_w_t_and_m_t":"1>if the CSI-RS based measurement quantities are available:","paragraph_zero_based":3451},{"literal_text_all_w_t_and_m_t":"2>set the rsIndexResults in measResultLastServCell to include all the available measurement quantities of the source PCell (in case HO failure) or PCell (in case RLF), ordered such that the highest CSI-RS RSRP is listed first if CSI-RS RSRP measurement results are available, otherwise the highest CSI-RS RSRQ is listed first if CSI-RS RSRQ measurement results are available, otherwise the highest CSI-RS SINR is listed first, based on the available CSI-RS based measurements collected up to the moment the UE detected failure;","paragraph_zero_based":3452},{"literal_text_all_w_t_and_m_t":"1>set the ssbRLMConfigBitmap and/or csi-rsRLMConfigBitmap in measResultLastServCell to include the radio link monitoring configuration of the source PCell (in case HO failure) or PCell (in case RLF), if available;","paragraph_zero_based":3453},{"literal_text_all_w_t_and_m_t":"1>for each of the configured measObjectNR in which measurements are available:","paragraph_zero_based":3454},{"literal_text_all_w_t_and_m_t":"2>if the SS/PBCH block-based measurement quantities are available:","paragraph_zero_based":3455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["70bea42771c39d6b4c4e9bc82e88a0b346c58757aa7260be1be15151a11ddd17","480bf36601d04006c9d3e9a346cb2d996fb8f7570a1305ff369cd18af66e3a92","4a67a25645ee9eb3d625f7ddd1f76cb8b682f962802c43b0ee4b99e2c2878aee","4b2443a3d325e2985faef250a0abd185e40276d18138db2db04549e4c335cb74","bb006107ae2f29d70bde7084494e83cb215c1ebfac4aba8c0d53676016c535ed","8052312588e80338fc2a13b0a33de146701e89cbfd6ba014a42cd518ea88aeda","0ff5a3acc559809a35515b67d09e370ec4a82e5084a744ce9b44716e0188ff49","4dde9d6b3accc0e2eb9191ec64e1d8f11eb7e0231ebdaa3bb28d0ef5f47e258d","c5be6a46fa54fb2e1f1aab37d2bb99c6666df70572b7b070c0bb047ade6ef81c","29c8d5e80b1f493de4aae2cb0c3a01b5da68a0b53e2d477d9014474244c38c98","bae704d732e1e58e42b0987ddcab7330fe6fee74d2237187b943ca9037dfa97b","388d5325b495810112f114e906d09c391708ac1dc413da10e15fabcd8140c590","5e9b0882a44038bf53fd6cd49e15a9bf4e9eab3b14c8cf284f4122cf454e77a6","2a4e87d73c864ba192a1ff659ab4f6a8db3ee41714076c7cc6851cbc46c623a0","56849b0d55ae0e53d6002c262d5c242b7d8ec747ad9a03d3c105061203cfee2e","21222edac0ef0c82e13515e7ee4a1da6dfbfba3672ca022fcef478ba9489997a","b3a41f1ad92c5bbf1d7e597fcfb4805f556d90ee560e3403f3087a9b4876e4b3","a0ed5f002c7d39cb178f44d72e09f35fc3569523b2b0574c7261c1539d0b7927","0dcdb8a0ab746cf81b94bd62641e84848efccadd4010b7fbda3fa22d511eb506","7b16fcea6fc6a8f134da3bcba6d80e77bdfb3347c11a77eef87bac64dc200cd7","e4ce196a37fa6a016832817d41aebd74b356eba44131dd900542d4532247447d","dd9230d26bab6b560003633c7ea8dbfe2db468031ce1c902bdb5cce13266f58a","e9cc2bfdb5d70df2e489345c9fb2045bfbfce96c2fa37735355c4305989cc4b3","b2d58a88c6c755e83701379add06f90ead02e45add0881799f723f05ae8a3462"],"paragraph_range_zero_based":[3432,3455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3432"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the measResultListNR in measResultNeighCells to include all the available measurement quantities of the best measured cells, other than the source PCell (in case HO failure) or PCell (in case RLF), ordered such that the cell with highest SS/PBCH block RSRP is listed first if SS/PBCH block RSRP measurement results are available, otherwise the cell with highest SS/PBCH block RSRQ is listed first if SS/PBCH block RSRQ measurement results are available, otherwise the cell with highest SS/PBCH block SINR is listed first, based on the available SS/PBCH block based measurements collected up to the moment the UE detected failure;","paragraph_zero_based":3456},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":3457},{"literal_text_all_w_t_and_m_t":"NOTE 0a:For the neighboring cells included in measResultListNR in measResultNeighCells ordered based on the SS/PBCH block measurement quantities, UE also includes the CSI-RS based measurement quantities, if available.","paragraph_zero_based":3458},{"literal_text_all_w_t_and_m_t":"2>if the CSI-RS based measurement quantities are available:","paragraph_zero_based":3459},{"literal_text_all_w_t_and_m_t":"3>set the measResultListNR in measResultNeighCells to include all the available measurement quantities of the best measured cells, other than the source PCell (in case HO failure) or PCell (in case RLF), ordered such that the cell with highest CSI-RS RSRP is listed first if CSI-RS RSRP measurement results are available, otherwise the cell with highest CSI-RS RSRQ is listed first if CSI-RS RSRQ measurement results are available, otherwise the cell with highest CSI-RS SINR is listed first, based on the available CSI-RS based measurements collected up to the moment the UE detected radio link failure;","paragraph_zero_based":3460},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":3461},{"literal_text_all_w_t_and_m_t":"NOTE 0b:For ordering the neighboring cells based on the CSI-RS measurement quantities, UE includes measurements only for the cells not yet included in measResultListNR in measResultNeighCells to avoid overriding SS/PBCH block-based ordered measurements.","paragraph_zero_based":3462},{"literal_text_all_w_t_and_m_t":"2>for each neighbour cell, if any, included in measResultListNR in measResultNeighCells:","paragraph_zero_based":3463},{"literal_text_all_w_t_and_m_t":"3>if the UE supports RLF-Report for conditional handover and if the neighbour cell is one of the candidate cells for which the reconfigurationWithSync is included in the masterCellGroup in the MCG VarConditionalReconfig at the moment of the detected failure:","paragraph_zero_based":3464},{"literal_text_all_w_t_and_m_t":"4>set choConfig in MeasResult2NR to the execution condition for each measId within condTriggerConfig associated to the neighbour cell within the MCG VarConditionalReconfig;","paragraph_zero_based":3465},{"literal_text_all_w_t_and_m_t":"4>if the first entry of choConfig corresponds to a fulfilled execution condition at the moment of handover failure, or radio link failure; or","paragraph_zero_based":3466},{"literal_text_all_w_t_and_m_t":"4>if the second entry of choConfig, if available, corresponds to a fulfilled execution condition at the moment of handover failure, or radio link failure:","paragraph_zero_based":3467},{"literal_text_all_w_t_and_m_t":"5>set firstTriggeredEvent to the execution condition condFirstEvent corresponding to the first entry of choConfig or to the execution condition condSecondEvent corresponding to the second entry of choConfig, whichever execution condition was fulfilled first in time;","paragraph_zero_based":3468},{"literal_text_all_w_t_and_m_t":"5>set timeBetweenEvents to the elapsed time between the point in time of fullfilling the condition in choConfig that was fulfilled first in time, and the point in time of fullfilling the condition in choConfig that was fulfilled second in time, if both the first execution condition corresponding to the first entry and the second execution condition corresponding to the second entry in the choConfig were fullfilled;","paragraph_zero_based":3469},{"literal_text_all_w_t_and_m_t":"1>for each of the configured EUTRA frequencies in which measurements are available;","paragraph_zero_based":3470},{"literal_text_all_w_t_and_m_t":"2>set the measResultListEUTRA in measResultNeighCells to include the best measured cells ordered such that the cell with highest RSRP is listed first if RSRP measurement results are available, otherwise the cell with highest RSRQ is listed first, and based on measurements collected up to the moment the UE detected failure;","paragraph_zero_based":3471},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":3472},{"literal_text_all_w_t_and_m_t":"NOTE 1:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":3473},{"literal_text_all_w_t_and_m_t":"1>set the c-RNTI to the C-RNTI used in the source PCell (in case HO failure) or PCell (in case RLF);","paragraph_zero_based":3474},{"literal_text_all_w_t_and_m_t":"1>if the failure is detected due to reconfiguration with sync failure as described in 5.3.5.8.3, set the fields in VarRLF-report as follows:","paragraph_zero_based":3475},{"literal_text_all_w_t_and_m_t":"2>set the connectionFailureType to hof;","paragraph_zero_based":3476},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RLF-Report for DAPS handover and if any DAPS bearer was configured while T304 was running:","paragraph_zero_based":3477},{"literal_text_all_w_t_and_m_t":"3>set lastHO-Type to daps;","paragraph_zero_based":3478},{"literal_text_all_w_t_and_m_t":"3>if radio link failure was detected in the source PCell, according to clause 5.3.10.3:","paragraph_zero_based":3479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6e77ecfbe35a06d47a6fc5ca8e91bbe43bee745521a539a67d593ad49001ebae","f0b283febd3b73c862d7b4de8ffd27aa744413a440f9bfbccfb8b2cc3ba9882a","72a8c2404937bf37f6008d17f9d6503701a629216bddfeb3b0abce743de3f56d","0f1df07499825e7d65a9a8a9e6aaea7166eac861e9e4ee6e4c0582e70e061259","f7412555b6dc3fcdf89d4470b3aad2d032a0861aed1279f7a905913136c58d2a","62aa8cb14998aa96e218f92d9e4ba1da44eb3ebc152f332cfdec22e2e912bb69","10697088dc9941c59b4e589e052f8283c93247f1e22d7a8957c388019cba4d31","50aafde32cbf9f7e9c046fa311f452cbd8004e50e8fbc0536e13312a4db08974","b3ada6d37e9f8e0a53fb1239540926a4f80d5d614287882d0b3203a28785d87b","eabe2f2040ab063322da9ef52f3c8b11fe02c7e3f9505a1681054d330edc2d92","8fc13e4286c04c0f49c621094ec61212ecfb767ca53892ebe29c61ba1cd5996a","7b516b371f63b6abab265b30674a9e2b0f5b34f63c84a078b39a2f0d763168a8","c7d31df6330461d318a47845a93e31b22d3ab4edd0f7735a35eedb15fcd583e3","e682768c940d4920a9f1795551e6b63f4acb41e1226245719a878dd5fd8af7dc","4e4531a46b8644cfdb7a46958de8b3db02f5193fe1ced2b49aae7d9a86921911","ccc8e6843ace7e672a74b82c697af1c5d964c3d6f6c16ef20f9d9d4a011f95b1","702b5e81e6fa0bf8a128c8bdc40bc4338f0be2901e50f67e46b08f228e002671","38d6dbd739efcc6157c1e2432030ad7dbc6a799175963cf5baabb29c1d196865","97c2bd49a2380b3924248ddc5dd933ad201a07f2b27224f315e56bb93003e254","9112d3f5a684c69acbf172f64221e4a419dc3a7e5b0af4a793b4c07159e49dfc","174d271672eaec15c4c2bef441dd98e0846df9c0c6581ffa63f3b675dfa57335","d4928f8fb7445f48561a8dd87aedf4f8bcd9c2f1468e699c0fb0cc8efb8f1e89","7e350a4534f5fef8c461cacbaa3d7a780b11a222394c9f3955b99b9eb652cbca","00c6c645d01bca3857d99cf08ad0b9c0bfe29244defd32ceaf5587ec4448b61e"],"paragraph_range_zero_based":[3456,3479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3456"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set timeConnSourceDAPS-Failure to the time between the initiation of the DAPS handover execution and the radio link failure detected in the source PCell while T304 was running;","paragraph_zero_based":3480},{"literal_text_all_w_t_and_m_t":"4>set the rlf-Cause to the trigger for detecting the source radio link failure in accordance with clause 5.3.10.4;","paragraph_zero_based":3481},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RLF-Report for conditional handover and if configuration of the conditional handover is available in the MCG VarConditionalReconfig at the moment of the handover failure:","paragraph_zero_based":3482},{"literal_text_all_w_t_and_m_t":"3>if the UE executed a conditional handover toward target PCell according to the condRRCReconfig of the target PCell:","paragraph_zero_based":3483},{"literal_text_all_w_t_and_m_t":"4>set timeSinceCHO-Reconfig to the time elapsed between the execution of the last RRCReconfiguration message including reconfigurationWithSync for the target PCell of the failed conditional handover, and the reception in the source PCell of the last conditionalReconfiguration including the condRRCReconfig of the target PCell of the failed conditional handover;","paragraph_zero_based":3484},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3485},{"literal_text_all_w_t_and_m_t":"4>set timeSinceCHO-Reconfig to the time elapsed between the execution of the last RRCReconfiguration message including reconfigurationWithSync for the target PCell of the failed handover, and the reception in the source PCell of the last conditionalReconfiguration including the condRRCReconfig;","paragraph_zero_based":3486},{"literal_text_all_w_t_and_m_t":"3>set choCandidateCellList to include the global cell identity, if available, and otherwise to the physical cell identity and carrier frequency of each of the candidate target cells for conditional handover included in condRRCReconfig within the MCG VarConditionalReconfig at the time of the failed handover, excluding the candidate target cells included in measResultNeighCells;","paragraph_zero_based":3487},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RLF-Report for conditional handover and if the last executed RRCReconfiguration message including reconfigurationWithSync was concerning a conditional handover:","paragraph_zero_based":3488},{"literal_text_all_w_t_and_m_t":"3>set lastHO-Type to cho;","paragraph_zero_based":3489},{"literal_text_all_w_t_and_m_t":"2>set the nrFailedPCellId in failedPCellId to the global cell identity and tracking area code, if available, and otherwise to the physical cell identity and carrier frequency of the target PCell of the failed handover;","paragraph_zero_based":3490},{"literal_text_all_w_t_and_m_t":"2>include nrPreviousCell in previousPCellId and set it to the global cell identity and tracking area code of the PCell where the last RRCReconfiguration message including reconfigurationWithSync was received;","paragraph_zero_based":3491},{"literal_text_all_w_t_and_m_t":"2>set the timeConnFailure to the elapsed time since the execution of the last RRCReconfiguration message including the reconfigurationWithSync;","paragraph_zero_based":3492},{"literal_text_all_w_t_and_m_t":"1>else if the failure is detected due to Mobility from NR failure as described in 5.4.3.5, set the fields in VarRLF-report as follows:","paragraph_zero_based":3493},{"literal_text_all_w_t_and_m_t":"2>set the connectionFailureType to hof;","paragraph_zero_based":3494},{"literal_text_all_w_t_and_m_t":"2>if last MobilityFromNRCommand concerned a failed inter-RAT handover from NR to E-UTRA and if the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA (NR to EUTRA):","paragraph_zero_based":3495},{"literal_text_all_w_t_and_m_t":"3>set the eutraFailedPCellId in failedPCellId to the global cell identity and tracking area code, if available, and otherwise to the physical cell identity and carrier frequency of the target PCell of the failed handover;","paragraph_zero_based":3496},{"literal_text_all_w_t_and_m_t":"2>include nrPreviousCell in previousPCellId and set it to the global cell identity and tracking area code of the PCell where the last MobilityFromNRCommand message was received;","paragraph_zero_based":3497},{"literal_text_all_w_t_and_m_t":"2>set the timeConnFailure to the elapsed time since the initialization of the handover associated to the last MobilityFromNRCommand message;","paragraph_zero_based":3498},{"literal_text_all_w_t_and_m_t":"1>else if the failure is detected due to radio link failure as described in 5.3.10.3, set the fields in VarRLF-report as follows:","paragraph_zero_based":3499},{"literal_text_all_w_t_and_m_t":"2>set the connectionFailureType to rlf;","paragraph_zero_based":3500},{"literal_text_all_w_t_and_m_t":"2>set the rlf-Cause to the trigger for detecting radio link failure in accordance with clause 5.3.10.4;","paragraph_zero_based":3501},{"literal_text_all_w_t_and_m_t":"2>set the nrFailedPCellId in failedPCellId to the global cell identity and the tracking area code, if available, and otherwise to the physical cell identity and carrier frequency of the PCell where radio link failure is detected;","paragraph_zero_based":3502},{"literal_text_all_w_t_and_m_t":"2>if an RRCReconfiguration message including the reconfigurationWithSync was received before the connection failure:","paragraph_zero_based":3503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["77d27e4123c57a62fd36a2cc139d3e53264290bb3fcb2b8211c0c26c8a4743cc","ee527520bd345d6da68f0eb27d936c38d7d4803abb3627499d0ad5ec409729d2","4a4d8dfb7ba44015914c6ebf01fae7091a17a2183512ea854a1a7fa88b76a2ae","9084ddc0efd9726d4500ba5ded5f66fdce244a9bc82b6153e8fbcb87b8606432","bc9661b71e7dc9ce15c180ee1091e077c91b6f61505bf41d879b0b6134b65ca7","70d1ffe454b715501854a08e7e4739073da2a41baa4ce32ad95f61eac7c0010c","4cebf576c0a50710baa621bf2c3171c8862f5f9c3f52a41dfc8a7f5194cfa185","7a39dd826c353e448d7038fa684541ee8a29daec89a22e97eb88da80641fe7c3","73fd97b98af99defb685aed6281709ec5eeff8b6a571df0bf6334e6472d837f9","6d39b34de6a5bb6e28c1460039930f613071c6ebd6d61d123b1305fec8420807","4959993e3262877a18def6fbd57c6aa3cd2395636d2157d34e65a03453ac7f8a","cf5c89b1b2ca1ecf33cc1693f7022df779a5071c7bbd72197f9e28b2e005e1fa","1d2c55168b5e9e67fd1e4039bf914024c5f5e0ddb5a96a41d7424026c11f5983","dbb45f22fa8d777b6f77bad23aca84075d1f57c8c5f3373ff775655ca924fdb4","bf04d9ffc0eb2d2e57ace62beea65b8cc0aae74c923eab0ddc2310b6dada7308","d8361067a23ff573100ba9b112aa926ce71b20e365507fc9d7b96d374cd66b1b","b35c76d9362fcc79c350554cc9e758d602fd665f6d9dff4662b23e89e43c5c4a","b705dc1aae3f956abb285107a2a46fc6291d93ec8fe8a6f52741e34deb4ec421","29d0ece9b2baa448fbfedfc46177154c1810d174fd23a5b95ced975b79d215b4","084cd1f33e747ebd36816924355cecff47a58110799768299d01e0948873d77f","fe59e0f2e6e13c2a1841a2c7c822319dcbc81e0b61677c8137124bc23bb8063a","d07d49390d6b390a7d1ca8e144cd3f0fe70f7c21e259c8b6500ff4611976d8c9","6391d132dd3f89be4c20ec0f43b81c27f2a9102c7cc9b8fe61f9c001351a5a80","9e1f155366ed6a504e9060f6a37c6974a13d9c002b64a45e4de13ac06a617bac"],"paragraph_range_zero_based":[3480,3503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the last successfully executed RRCReconfiguration message including the reconfigurationWithSync concerned an intra NR handover and it was received while connected to the previous PCell to which the UE was connected before connecting to the PCell where radio link failure is detected; and","paragraph_zero_based":3504},{"literal_text_all_w_t_and_m_t":"3>if T311 was not running before entering the PCell in which the radio link failure was detected:","paragraph_zero_based":3505},{"literal_text_all_w_t_and_m_t":"4>include the nrPreviousCell in previousPCellId and set it to the global cell identity and the tracking area code of the PCell where the last executed RRCReconfiguration message including reconfigurationWithSync was received;","paragraph_zero_based":3506},{"literal_text_all_w_t_and_m_t":"4>if the last executed RRCReconfiguration message including reconfigurationWithSync was concerning a DAPS handover:","paragraph_zero_based":3507},{"literal_text_all_w_t_and_m_t":"5>set lastHO-Type to daps;","paragraph_zero_based":3508},{"literal_text_all_w_t_and_m_t":"4>else if the last executed RRCReconfiguration message including reconfigurationWithSync was concerning a conditional handover:","paragraph_zero_based":3509},{"literal_text_all_w_t_and_m_t":"5>set lastHO-Type to cho;","paragraph_zero_based":3510},{"literal_text_all_w_t_and_m_t":"4>set the timeConnFailure to the elapsed time since the execution of the last RRCReconfiguration message including the reconfigurationWithSync;","paragraph_zero_based":3511},{"literal_text_all_w_t_and_m_t":"3>else if the last RRCReconfiguration message including the reconfigurationWithSync concerned a handover to NR from E-UTRA and if the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA:","paragraph_zero_based":3512},{"literal_text_all_w_t_and_m_t":"4>include the eutraPreviousCell in previousPCellId and set it to the global cell identity and the tracking area code of the E-UTRA PCell where the last RRCReconfiguration message including reconfigurationWithSync was received embedded in E-UTRA RRC message MobilityFromEUTRACommand message as specified in TS 36.331 [10] clause 5.4.3.3;","paragraph_zero_based":3513},{"literal_text_all_w_t_and_m_t":"4>set the timeConnFailure to the elapsed time since reception of the last RRCReconfiguration message including the reconfigurationWithSync embedded in E-UTRA RRC message MobilityFromEUTRACommand message as specified in TS 36.331 [10] clause 5.4.3.3;","paragraph_zero_based":3514},{"literal_text_all_w_t_and_m_t":"2>if configuration of the conditional handover is available in the MCG VarConditionalReconfig at the moment of declaring the radio link failure:","paragraph_zero_based":3515},{"literal_text_all_w_t_and_m_t":"3>set timeSinceCHO-Reconfig to the time elapsed between the detection of the radio link failure, and the reception, in the source PCell, of the last conditionalReconfiguration including the condRRCReconfig message;","paragraph_zero_based":3516},{"literal_text_all_w_t_and_m_t":"3>set choCandidateCellList to include the global cell identity if available, and otherwise to the physical cell identity and carrier frequency of each of all the candidate target cells for conditional handover included in condRRCReconfig within the MCG VarConditionalReconfig at the time of radio link failure, excluding the candidate target cells included in measResultNeighCells;","paragraph_zero_based":3517},{"literal_text_all_w_t_and_m_t":"1>if connectionFailureType is rlf and the rlf-Cause is set to randomAccessProblem or beamFailureRecoveryFailure; or","paragraph_zero_based":3518},{"literal_text_all_w_t_and_m_t":"1>if connectionFailureType is hof and if the failed handover is an intra-RAT handover:","paragraph_zero_based":3519},{"literal_text_all_w_t_and_m_t":"2>set the ra-InformationCommon to include the random-access related information as described in clause 5.7.10.5;","paragraph_zero_based":3520},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7.","paragraph_zero_based":3521},{"literal_text_all_w_t_and_m_t":"The UE may discard the radio link failure information or handover failure information, i.e. release the UE variable VarRLF-Report, 48 hours after the radio link failure/handover failure is detected.","paragraph_zero_based":3522},{"literal_text_all_w_t_and_m_t":"NOTE 2:In this clause, the term 'handover failure' has been used to refer to 'reconfiguration with sync failure'.","paragraph_zero_based":3523},{"literal_text_all_w_t_and_m_t":"5.3.11UE actions upon going to RRC_IDLE","paragraph_zero_based":3524},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3525},{"literal_text_all_w_t_and_m_t":"1>reset MAC;","paragraph_zero_based":3526},{"literal_text_all_w_t_and_m_t":"1>set the variable pendingRNA-Update to false, if that is set to true;","paragraph_zero_based":3527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["90a7cbdb8b3d1ca65526f7a2421fa8987d3fd4a82d72f63cfd1c0eaf44255a10","a1c89640cb8cfc9b69dfdc28abe5a3c23b5e9576304a8ebc01786e393d4b9c0e","9bd3f780d7c6dc33735bc17d3d43cd957da81f09859eb66e3eaa7221316e2949","49ba3e46a4b06163e9895aaf30151df6a4c1f863f876f1c3873de9a595c018cb","cced23e3aa500d9055635071bdf347dfa3e7efe6f29edbdb3a8afc0aa753c608","6105c0d3a75dfae22ed7db3d5f2db129e87f3def65a3089d99da979ccc951267","f4e78c792b6230d408fe3fe8bbd3bbb94ce12b1670831f308ce7e50dd87e105a","78987df1951575bbbdb242c020dd6a19b6269e989f5ff9b92fa8c664142492e8","a10772493bb140e275a7d82fde1aaa283cc58300c7a18b5d64222e1263fbe24a","d2a78d0ffd879b0d84e3368828907cb127390ac5a74b3401ea80ddb20ed1bb7a","5681a2a85c768976dce6f7c3e57f0638545c92ebe51dc4ce9b29654c96c868f7","3aae34c13cb0358d02c1f09ea8191514d317e53bbe56c8cd17288b363ca3061c","0f95c737434b32bba87f588df8c2afe6fa1871400d6cd820ce6dc9744a88bcb4","34e0012eb6a914bdd04478eab590afb039d8f03941cd1235bf2e499555cbda84","4cef3425dfc58e39d6f060ef6c24f4def08f881bf109d526fcc30bbbbf53f9f0","07381d82fdf474f0552d902ab6ed220dc262970e27516d97d30a43b23a675c78","6a3856c976747b4e85765b1b81167dc1f908906c7a411deae74d588bf9be83db","b5f520fc148587ecc3b9ad811c0415e45723fb2833cfc97df72da8c98c2c5f90","ef5011ca2d78e22834df88df60bfcb64e5c6692cfa84ff90327127749518561f","095e093a861b3fc1e2da087584ba5cf3a56fd41bec6edb884d4b2773b0e49846","2be246df2809180ce05afacb445a6d2ffaea0cd3871718ad100c35e333ba8137","e68b9148e1aff25a24e26255a0188bb22cf973e55b8eecc3f35104092f91101a","5638d07b3087957d12e5d47fb00f6fe233c7e993c06bf5b258fd65d781494e57","7aed561509085adc313af4e7a3d8c948e184a288679183936fddc4f31c1db676"],"paragraph_range_zero_based":[3504,3527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3504"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if going to RRC_IDLE was triggered by reception of the RRCRelease message including a waitTime:","paragraph_zero_based":3528},{"literal_text_all_w_t_and_m_t":"2>if T302 is running:","paragraph_zero_based":3529},{"literal_text_all_w_t_and_m_t":"3>stop timer T302;","paragraph_zero_based":3530},{"literal_text_all_w_t_and_m_t":"2>start timer T302 with the value set to the waitTime;","paragraph_zero_based":3531},{"literal_text_all_w_t_and_m_t":"2>inform upper layers that access barring is applicable for all access categories except categories '0' and '2'.","paragraph_zero_based":3532},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3533},{"literal_text_all_w_t_and_m_t":"2>if T302 is running:","paragraph_zero_based":3534},{"literal_text_all_w_t_and_m_t":"3>stop timer T302;","paragraph_zero_based":3535},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3536},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3537},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3538},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3539},{"literal_text_all_w_t_and_m_t":"1>if the UE is leaving RRC_INACTIVE:","paragraph_zero_based":3540},{"literal_text_all_w_t_and_m_t":"2>if going to RRC_IDLE was not triggered by reception of the RRCRelease message:","paragraph_zero_based":3541},{"literal_text_all_w_t_and_m_t":"3>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities;","paragraph_zero_based":3542},{"literal_text_all_w_t_and_m_t":"3>stop the timer T320, if running;","paragraph_zero_based":3543},{"literal_text_all_w_t_and_m_t":"2>if T319a is running:","paragraph_zero_based":3544},{"literal_text_all_w_t_and_m_t":"3>stop timer T319a;","paragraph_zero_based":3545},{"literal_text_all_w_t_and_m_t":"3>consider SDT procedure is not ongoing;","paragraph_zero_based":3546},{"literal_text_all_w_t_and_m_t":"1>stop all timers that are running except T302, T320, T325, T330, T331, T400 and T430;","paragraph_zero_based":3547},{"literal_text_all_w_t_and_m_t":"1>discard the UE Inactive AS context, if any;","paragraph_zero_based":3548},{"literal_text_all_w_t_and_m_t":"1>release the suspendConfig, if configured;","paragraph_zero_based":3549},{"literal_text_all_w_t_and_m_t":"1>release the uav-Config, if configured;","paragraph_zero_based":3550},{"literal_text_all_w_t_and_m_t":"1>remove all the entries within the MCG and the SCG VarConditionalReconfig, if any;","paragraph_zero_based":3551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b41deec6d3d5c6eb4ccf6aa43a85ead688bfbbd910d4b550a404fffac53087b5","ed2e21b4d9910c3b93561c4d4b9b60c3d3e29c5982317fc5164504645fc6da4f","f4897fa6534155e5b1ee2dc179ebd1025355342e78ebd3caaecf73728a831e8f","046328cd5a872da63f163be1a7e2ebec295fd81f453c353ff4adc874a11d4844","a6830d0cb8377d8081698a03dfb08cd6744bf7a799d8e57d127cb06b1c4a0860","e784a35ac00513c3115c27cc491e88b2efa93178aa96463c6d756ef4e06aca84","9ee5af1d994459e0b2657af3f25681ad04d1e2c06f67ad6e2dbdb0e568c8d4a7","374d884ee6ca093497397024fb26a8e000e2bf125b847d2074a40e6461826df0","a4caa74de0824c7af29802309e2577fa32d970f2ff694281984f53a81a2e1d33","635a7249dd7e799afdce2395b5befabd7231851d8814fa563d556fabc956002e","06ad7338f6dd14a8346299dbb19a4ef5cec580c699748ca1a87b62024afbd976","964e4b5d3fea59808f66517a818c81e88c39e5f11d5bf7d940ced1db10adcf16","5d240ee927ab45d51d1993897ae92075c6f411734f7c3240c20be0b22872693f","aba731011b3e0f62682ca869004be35ef6b9d9ca870d238492b1e1d0bdfd9b39","9e8a9380dbd50de937914a40a88075be43ca50a77b1457f2f53703531da70ee5","0733b837b3765a0738937538e2f331dbe968dc44c06ee00aac31733fa9412e6a","3737b3a3bf1e1093400a6235a079e0782e410d3c4ea3e64db83fa4e4e72fa1df","7b65b3cd62f776c1cbec33d6a8e34897d4cae2197e9f484fc6049fae89d89b93","4204b9b254a03df229dfbeaf796984e76ae43d2de7c9017f1fe33207eb28b8e9","04b12312ec3d8897736e8947d4b156cc34509b629217fc53bea3400c6f608bfc","3335193c0668e96553e57be70b0123d4cee0d5a04eca1ebfa585e6174541241a","988ae7c0be03617388e5be3c2b61e44683ca72fd5f11a716dfc7933ea4517472","27103242e3293dfe0c7ebba67d7eac8dcaf7ca186bf94824619389119af9f113","2b25a6e111eeb2b53407a707e9aeeee23f405fe3755f589973572661dcdf87b0"],"paragraph_range_zero_based":[3528,3551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3528"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for each measId, if the associated reportConfig has a reportType set to condTriggerConfig:","paragraph_zero_based":3552},{"literal_text_all_w_t_and_m_t":"2>for the associated reportConfigId:","paragraph_zero_based":3553},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":3554},{"literal_text_all_w_t_and_m_t":"2>if the associated measObjectId is only associated to a reportConfig with reportType set to condTriggerConfig:","paragraph_zero_based":3555},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":3556},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":3557},{"literal_text_all_w_t_and_m_t":"1>discard the KgNB key, the S-KgNB key, the S-KeNB key, the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key, if any;","paragraph_zero_based":3558},{"literal_text_all_w_t_and_m_t":"1>release all radio resources, including release of the RLC entity, the BAP entity, the MAC configuration and the associated PDCP entity and SDAP for all established RBs (except for broadcast MRBs), BH RLC channels, Uu Relay RLC channels, PC5 Relay RLC channels and SRAP entity;","paragraph_zero_based":3559},{"literal_text_all_w_t_and_m_t":"NOTE 0:A L2 U2N Relay UE may re-establish the SL-RLC0, SL-RLC1 and SRAP entity after release.","paragraph_zero_based":3560},{"literal_text_all_w_t_and_m_t":"1>indicate the release of the RRC connection to upper layers together with the release cause;","paragraph_zero_based":3561},{"literal_text_all_w_t_and_m_t":"1>inform upper layers about the release of all application layer measurement configurations;","paragraph_zero_based":3562},{"literal_text_all_w_t_and_m_t":"1>discard any application layer measurement reports which were not yet submitted to lower layers for transmission;","paragraph_zero_based":3563},{"literal_text_all_w_t_and_m_t":"1>discard any segments of segmented RRC messages stored according to 5.7.6.3;","paragraph_zero_based":3564},{"literal_text_all_w_t_and_m_t":"1>except if going to RRC_IDLE was triggered by inter-RAT cell reselection while the UE is in RRC_INACTIVE or RRC_IDLE or when selecting an inter-RAT cell while T311 was running or when selecting an E-UTRA cell for EPS fallback for IMS voice as specified in 5.4.3.5:","paragraph_zero_based":3565},{"literal_text_all_w_t_and_m_t":"2>if the UE is capable of L2 U2N Remote UE:","paragraph_zero_based":3566},{"literal_text_all_w_t_and_m_t":"3>enter RRC_IDLE, and perform either cell selection as specified in TS 38.304 [20], or relay selection as specified in clause 5.8.15.3, or both;","paragraph_zero_based":3567},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3568},{"literal_text_all_w_t_and_m_t":"3>enter RRC_IDLE and perform cell selection as specified in TS 38.304 [20];","paragraph_zero_based":3569},{"literal_text_all_w_t_and_m_t":"NOTE 1:Whether to release the PC5 unicast link is left to L2 U2N Remote UE's implementation.","paragraph_zero_based":3570},{"literal_text_all_w_t_and_m_t":"NOTE 2:It is left to UE implementation whether to stop T430, if running, when going to RRC_IDLE.","paragraph_zero_based":3571},{"literal_text_all_w_t_and_m_t":"5.3.12UE actions upon PUCCH/SRS release request","paragraph_zero_based":3572},{"literal_text_all_w_t_and_m_t":"Upon receiving a PUCCH release request from lower layers, for all bandwidth parts of an indicated serving cell the UE shall:","paragraph_zero_based":3573},{"literal_text_all_w_t_and_m_t":"1>release PUCCH-CSI-Resources configured in CSI-ReportConfig;","paragraph_zero_based":3574},{"literal_text_all_w_t_and_m_t":"1>release SchedulingRequestResourceConfig instances configured in PUCCH-Config.","paragraph_zero_based":3575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dbb7d49071e985b982e409b38d242bdbcf64df793deaa0de51579256c14d4ba3","fd5c58f7502c56a6a7486a079960eb7d5c58ccefa9e03e9c7edd8dbf4002526d","ccf8036a6792369f4e2f70c75cede85c936a021796ab768113b3aaeb5a4a728b","31317f881dede151b96c4efe7df103155e1aeedc698978658369685ddc75777d","9bb3cd1d239c1603e1944d7196d09add8ff1c2c9c16bb79592f59f83f2d4e502","d78a0678376ab2b8c7b8da59cb3c288e6a260d2668b8fcabba6221b2bab9ae7c","b8678456034b987a6d5ec4ba49e1c41e5bc85d9ac5ebd529227002d1acc60a7a","bbd22914d406f6e2ddefd294673f2edfcccbfd014f4b1a823dea287faed6a6db","5a97a65d9e2e733ff0690a8476e061843cea21948c5728e79749000de1d613c7","8dcf9b390a81b7b3a89cb640315c7445d1c27365814e4d31e9c6e4ec80b7fb42","6f6d5c7f0965cc7ac44ee9e6cf6a3720bb8f6b8290f2fa4ca26c5bd2ec810d9c","cb02b7a08957c7957edec241778212758ff13f8e19d59c73a52115801700b9e5","a71271217e266dbe1d62799fef342d9ac714bbb9b668f968e7b793662d3ee785","886ae45d32ed45bacf5262aa11eed422c72f71fe71bea6ec4d10930ccde1272c","1f9a9f733e4a23117a89c307cbb9aa9f31f106500c795282245d9256bb599801","ae3293467b1b978f66b6c4fc500e80c0dbc47ec3774e8a77be177d2a1d6aad69","8ca835ed2c1194d4d8e2693823dc9ad393fdb874af3ddc7146afe9416b5f1248","685874e579a832fc2ffc460b41ae6942873f323a5ae5aadd704f4260409ba605","b3c2542084774720f497c6d3a3351b8cba4475d32c863f04b7d061eebfd39ff3","70266404a86bdc87f1da57de4717a6997c017d4c62932fd16d521478d87a9cde","b6b35cd9a9afdd2cc0bbc990af2f2cdf2f8fcd8f248aaedc7ee32f71cd66f3d9","eb2f677c4fb81737a7dfd782f86527d4ece607407a02b841eb4e4757a846fbf7","3d733425bdcdd4fbb8a4db7fa73e84028e770d52ad08922673793e274d843686","808a44d5affe8f3bd875e209cfcca271966d511144bbdf8c11a6f778d1c6fd91"],"paragraph_range_zero_based":[3552,3575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3552"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving an SRS release request from lower layers, for all bandwidth parts of an indicated serving cell the UE shall:","paragraph_zero_based":3576},{"literal_text_all_w_t_and_m_t":"1>release SRS-Resource instances configured in SRS-Config.","paragraph_zero_based":3577},{"literal_text_all_w_t_and_m_t":"Upon receiving a positioning SRS configuration for RRC_INACTIVE release request from lower layers, the UE shall:","paragraph_zero_based":3578},{"literal_text_all_w_t_and_m_t":"1>release the configured srs-PosRRC-Inactive.","paragraph_zero_based":3579},{"literal_text_all_w_t_and_m_t":"5.3.13RRC connection resume","paragraph_zero_based":3580},{"literal_text_all_w_t_and_m_t":"5.3.13.1General","paragraph_zero_based":3581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3582},{"literal_text_all_w_t_and_m_t":"Figure 5.3.13.1-1: RRC connection resume, successful","paragraph_zero_based":3583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3584},{"literal_text_all_w_t_and_m_t":"Figure 5.3.13.1-2: RRC connection resume fallback to RRC connection establishment, successful","paragraph_zero_based":3585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3586},{"literal_text_all_w_t_and_m_t":"Figure 5.3.13.1-3: RRC connection resume followed by network release, successful","paragraph_zero_based":3587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3588},{"literal_text_all_w_t_and_m_t":"Figure 5.3.13.1-4: RRC connection resume followed by network suspend, successful","paragraph_zero_based":3589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":3590},{"literal_text_all_w_t_and_m_t":"Figure 5.3.13.1-5: RRC connection resume, network reject","paragraph_zero_based":3591},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to resume a suspended RRC connection, including resuming SRB(s), DRB(s) and multicast MRB(s) or perform an RNA update. This procedure is also used to initiate SDT in RRC_INACTIVE.","paragraph_zero_based":3592},{"literal_text_all_w_t_and_m_t":"5.3.13.1aConditions for resuming RRC Connection for NR sidelink communication/discovery/V2X sidelink communication","paragraph_zero_based":3593},{"literal_text_all_w_t_and_m_t":"For NR sidelink communication/discovery an RRC connection is resumed only in the following cases:","paragraph_zero_based":3594},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink communication and related data is available for transmission:","paragraph_zero_based":3595},{"literal_text_all_w_t_and_m_t":"2>if the frequency on which the UE is configured to transmit NR sidelink communication is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":3596},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink discovery and related data is available for transmission:","paragraph_zero_based":3597},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":3598},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":3599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["080b0f8b0c827dd1e14bc803639cbce4033d397139a370472500968602fb0ace","28c7a73e995dfba7d8ac8353189949520d24c7d02bf83b916e84328d1e838fd8","53b37f60c3cc929684d07b96e1ba6472a349eea65f485628f3d90550172dd181","103f94cff1ae252e6295acdd6b908672143bb59bb512094c66420d3d923660a5","1f60f06d7d868b4280a4d5e46272f198f5a427efe78de925b782fff4d7ecc138","08be281b6e6d05739d937c42133d6e03339ba675fa7d336562b740f7b860a3d2","70667aa2d4f88177c205f702aab2c20e207f9ec578c184001cb6a1a6e5b770f7","05d6027cf5a90daeba1819c772d16b9c5fd9514d1f47ebcbd2a762891e73da6c","fe96ce5cd2d0e610d385ecf507b1b2cad9b65972033ec73b620f73248add9c4d","e66cb92cbf951b9af1a50953bc1e3db4bd1ee896c8dca0f07dbc32f438ef5b1a","199c727e46249113fa06cb0298fb4aa9b0e6f95a994d2aa56150bfb83a9f72c2","aa763f5ff5d9846cea4c5b3734cf454e8dd479e56b8925f58104ae73d9d11848","7bb1420f64e38275fa7917a3d508d2dd7ed65a637bf321b2a2ec994f5ff4dca2","d3abbae9e7d687c534d82ab174141fdf0fc2af5b7be12bfad71ab652ec92585e","2a9c39f6629da86b894510961d4d2b6e16204af91dd208d5f8697fcd3ba79bea","004a891a0f966712f1868d231babdd7dc2c5eeff98bef886f8a560e15292e3d7","5eea46e1cb5af7e58735ce04722496aac1bc81534cf5cc0957f1255cbe40ab45","d03bd8de8d64c714bf15311445593e8e9e3c6d7ec294e14ebda2a4bf406a34b1","150ffec651808f8c04007b55e8999f17178e9f90ae39b7799f9ee1b50c9e552b","e9cfd8f7d1e9cb41904a79f14dcff3e328265a39ef391b1c26f7b948b3731767","d51698a889edd7357a3d40cd0efeeed67379deb6d13c57322ab9fc4c3a562873","060880cb66e2629f6c90e62eef0f1a0755fcdc40089ba14b7f9b3705998b3fe7","27280e1b971c92e3dc63b85628ac27ffbb75fc7bd972a849557e5b5f7748aa3a","0291e7e9fbd397eed8a7bb217a0d5dd52b8d20989a1fa03b706f426f7466b429"],"paragraph_range_zero_based":[3576,3599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3576"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":3600},{"literal_text_all_w_t_and_m_t":"3>if the frequency on which the UE is configured to transmit NR sidelink discovery is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-DiscTxPoolSelected or sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":3601},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE in RRC_INACTIVE, an RRC connection establishment is resumed in the following cases:","paragraph_zero_based":3602},{"literal_text_all_w_t_and_m_t":"1>if any message is received from the L2 U2N Remote UE via SL-RLC0 as specified in 9.1.1.4 or SL-RLC1 as specified in 9.2.4;","paragraph_zero_based":3603},{"literal_text_all_w_t_and_m_t":"For V2X sidelink communication an RRC connection resume is initiated only when the conditions specified for V2X sidelink communication in clause 5.3.3.1a of TS 36.331 [10] are met.","paragraph_zero_based":3604},{"literal_text_all_w_t_and_m_t":"NOTE:Upper layers initiate an RRC connection resume (except if the RRC connection resume is initiated at the L2 U2N Relay UE upon reception of a message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1). The interaction with NAS is left to UE implementation.","paragraph_zero_based":3605},{"literal_text_all_w_t_and_m_t":"5.3.13.1bConditions for initiating SDT","paragraph_zero_based":3606},{"literal_text_all_w_t_and_m_t":"A UE in RRC_INACTIVE initiates the resume procedure for SDT when all of the following conditions are fulfilled:","paragraph_zero_based":3607},{"literal_text_all_w_t_and_m_t":"1>the upper layers request resumption of RRC connection; and","paragraph_zero_based":3608},{"literal_text_all_w_t_and_m_t":"1>SIB1 includes sdt-ConfigCommon; and","paragraph_zero_based":3609},{"literal_text_all_w_t_and_m_t":"1>sdt-Config is configured; and","paragraph_zero_based":3610},{"literal_text_all_w_t_and_m_t":"1>all the pending data in UL is mapped to the radio bearers configured for SDT; and","paragraph_zero_based":3611},{"literal_text_all_w_t_and_m_t":"1>for a RedCap UE when RedCap-specific initial downlink BWP includes no CD-SSB, ncd-SSB-RedCapInitialBWP-SDT is configured; and","paragraph_zero_based":3612},{"literal_text_all_w_t_and_m_t":"1>lower layers indicate that conditions for initiating SDT as specified in TS 38.321 [3] are fulfilled.","paragraph_zero_based":3613},{"literal_text_all_w_t_and_m_t":"NOTE:How the UE determines that all pending data in UL is mapped to radio bearers configured for SDT is left to UE implementation.","paragraph_zero_based":3614},{"literal_text_all_w_t_and_m_t":"5.3.13.2Initiation","paragraph_zero_based":3615},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when upper layers or AS (when responding to RAN paging, upon triggering RNA updates while the UE is in RRC_INACTIVE, for NR sidelink communication/discovery/V2X sidelink communication as specified in clause 5.3.13.1a) requests the resume of a suspended RRC connection or requests the resume for initiating SDT as specified in clause 5.3.13.1b.","paragraph_zero_based":3616},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having valid and up to date essential system information as specified in clause 5.2.2.2 before initiating this procedure.","paragraph_zero_based":3617},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":3618},{"literal_text_all_w_t_and_m_t":"1>if the resumption of the RRC connection is triggered by response to NG-RAN paging:","paragraph_zero_based":3619},{"literal_text_all_w_t_and_m_t":"2>select '0' as the Access Category;","paragraph_zero_based":3620},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the selected Access Category and one or more Access Identities provided by upper layers;","paragraph_zero_based":3621},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred, the procedure ends;","paragraph_zero_based":3622},{"literal_text_all_w_t_and_m_t":"1>else if the resumption of the RRC connection is triggered by upper layers:","paragraph_zero_based":3623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5833a4b3866e48ab3f8cc84c2e9a8a1b7ea35fad2d8432e7b833e9b5bbc62017","218c58d19d7a225545f3a0ce1c1cc150bcf18831379251e6ef7e825d1db219b4","4383eea34b33cbc611b56931871151ab5efb4902f89b01ceb152ba1d87376c2c","0b62efae972dea10597b6b5cc7217b1f246ee2d4d44a2f62ffee3ae962eaedf4","7c1e601002045547407650a3797ec45643709500492feab48dcb0bbf49827b8d","548b4ff3b80c2f4fc44bd3b5a7204391329dacbdff8519307d8e8231c043a013","c299960b26a6058683aa18fc0ed97d21c779cb91331d6f7da93b72db537af244","1c3572b4a20714c1c1ac1f34505d422f1d989e0a79cd60b9221753865c0a0ee8","a65f79ace73a3b3e00ebe8437412879b6a599f984dafab93a06fc53f25e170b4","d87e2af9182bc34beb09b27cba6da2ed3df327b08f7007aaa12d3f32460e1de9","453e94b83f0fa69f1df595ae59f867e465c1f0816f7967e3bbeeb45d66aea3ce","341dd8633fe4a921ce7f85056738561b69b55bf8d1c0443995c2261e1f1991b7","a5d6cbb77e8b2543419db28dd859737964823f93633614dffb22f3ea47733008","ed998343326bd6c152c7046bceb261c0f9a591b5b2df8c5837fd4eec6c8b1c88","a37e572de91d0fc938beba9e1e4625e60140fa97e3e15180b04d76e01ba734ca","dca589a2bb418e6457e8e2cc039b19afba922e986659f3737c6f626c1a6779ce","8120a61e9dcd964c43d9648645cb4ee4c43f2403649a6000bd3715f09fa9e165","5af0ecbd0c91cf0925c9126072a20b17a917361de2469da3a9c72661b76e149c","c9f52180df08903a3bb52949d5eba8ba9021402bfec744176622fb5278d3b6e4","61c1157a7362cc2e3771223648689de2fd5865480827c6c0eb3013e5c6316645","d175d3e545174628b8f6eee845d8ece32fc738a19352f24cd49c6bba154bf11f","41ef72a5539ce92d8382c3180c6739c395b08c6637dfbabf2c8757457eec7a65","ea4c1a57b31987c0a75c89f7eb4a6d5cb9060159c15a7a230aa898fd9946d97b","31a1230ef119d4275df8f6f9e92e2525e48a3e603ba7e6e0efd1e3c24fcd298f"],"paragraph_range_zero_based":[3600,3623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3600"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the upper layers provide an Access Category and one or more Access Identities:","paragraph_zero_based":3624},{"literal_text_all_w_t_and_m_t":"3>perform the unified access control procedure as specified in 5.3.14 using the Access Category and Access Identities provided by upper layers;","paragraph_zero_based":3625},{"literal_text_all_w_t_and_m_t":"4>if the access attempt is barred, the procedure ends;","paragraph_zero_based":3626},{"literal_text_all_w_t_and_m_t":"2>if the upper layers provide NSAG information and one or more S-NSSAI(s) triggering the access attempt (TS 23.501 [32] and TS 24.501 [23]):","paragraph_zero_based":3627},{"literal_text_all_w_t_and_m_t":"3>apply the NSAG with highest NSAG priority among the NSAGs that are included in SIB1 (i.e., in FeatureCombination and/or in RA-PrioritizationSliceInfo), and that are associated with the S-NSSAI(s) triggering the access attempt, in the Random Access procedure (TS 38.321 [3], clause 5.1);","paragraph_zero_based":3628},{"literal_text_all_w_t_and_m_t":"NOTE:If there are multiple NSAGs with the same highest NAS-provided NSAG priority identified for access attempt as above, it is left to UE implementation to select the NSAG to be applied in the Random Access procedure.","paragraph_zero_based":3629},{"literal_text_all_w_t_and_m_t":"2>if the resumption occurs after release with redirect with mpsPriorityIndication:","paragraph_zero_based":3630},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause to mps-PriorityAccess;","paragraph_zero_based":3631},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3632},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause in accordance with the information received from upper layers;","paragraph_zero_based":3633},{"literal_text_all_w_t_and_m_t":"1>else if the resumption of the RRC connection is triggered due to an RNA update as specified in 5.3.13.8:","paragraph_zero_based":3634},{"literal_text_all_w_t_and_m_t":"2>if an emergency service is ongoing:","paragraph_zero_based":3635},{"literal_text_all_w_t_and_m_t":"NOTE 1:How the RRC layer in the UE is aware of an ongoing emergency service is up to UE implementation.","paragraph_zero_based":3636},{"literal_text_all_w_t_and_m_t":"3>select '2' as the Access Category;","paragraph_zero_based":3637},{"literal_text_all_w_t_and_m_t":"3>set the resumeCause to emergency;","paragraph_zero_based":3638},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3639},{"literal_text_all_w_t_and_m_t":"3>select '8' as the Access Category;","paragraph_zero_based":3640},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the selected Access Category and one or more Access Identities to be applied as specified in TS 24.501 [23];","paragraph_zero_based":3641},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred:","paragraph_zero_based":3642},{"literal_text_all_w_t_and_m_t":"4>set the variable pendingRNA-Update to true;","paragraph_zero_based":3643},{"literal_text_all_w_t_and_m_t":"4>the procedure ends;","paragraph_zero_based":3644},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the L2 U2N Relay UE initiates RRC connection resume triggered by reception of message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1 as specified in 5.3.13.1a, the L2 U2N Relay UE sets the resumeCause by implementation, but it can only set the emergency, mps-PriorityAccess, or mcs-PriorityAccess as resumeCause, if the same cause value in the message received from the L2 U2N Remote UE via SL-RLC0.","paragraph_zero_based":3645},{"literal_text_all_w_t_and_m_t":"1>if the UE is in NE-DC or NR-DC:","paragraph_zero_based":3646},{"literal_text_all_w_t_and_m_t":"2>if the UE does not support maintaining SCG configuration upon connection resumption:","paragraph_zero_based":3647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ee6094fa93710c7695e2e506518c7f2d6023787fd2c674d655ad21efd1a8c7b1","bcf50e137658df16787db58b772c52ece0dd3889d081fbcb9f88d56518754545","8350c6b41532ac1af981e44606fb8c28e0f5dbede019f6a9926ae8d841e75e08","63f83f8e27a5094d552759fff64967b468950d8785591634fee48609afd116da","256fdccd919e59d97f03aba578e0152746e8c1bc0a1896d09a2b4f628802b257","62c65b876bcc92b1094af094718e6191b4af0d4cfab094a78c1e0cf574b0ed6e","94c0b7075b8f25b5cf455274e0f4708a33c5981698b57ae17e9cdb44a399b256","1642c153ab43e800fd8d424e4b46818cbe26c6714990ab6b1c52a0c051a54668","73ea5f38eb2aabe77d8a1b916907fc9795b7ad34c0cf4ed0b8a23b325fe8e587","9b9185d19e530af5a809767aefca27169f8b3311278cbe5804bbf515c7495270","bdbf68f1e89fee5227a3dafd829377ed91532b7a7f3c5ac3904313e903e1ec5a","765aaccdb4479d9026a58b222aec1d7b91471694e72c748dddbfe671fc0c7396","e73bad4dec481e17b3a9df143d21b7088158fb8a97a0b75b56a16dfc6bae3e9c","9ff381762ad8892af515de9d3cea5a0321684b775607151a67f1e3d3c58f0807","4a0675bfd0d3dd754d1bfe6113dd395e4f11905db25f2352877eb6c7c956eab3","a3c8f6e649be4970d53e7397fb349929f801e721fa60a686db42aaeed63ae6f5","c9461c3be961bd69a48184934317e5e67537f1b1f7cfc4ce0f3e5f19ed7d31e0","a9803c2b2fea04977b6ec3b40405c5703aa5ad8bfd7cbb82cfe74449318097da","4091bc6dff1d1d5aeee2631224e9770fbe56b6918d5eb1b85057e858b8a7c58c","4059411529f5b69ac9a52fd6b4724e7538af604dccc6f625ce4e11fd6e0bee85","55e26bf9cdb2b741ed35511741d490b229e0fcb7f8de8a9e9773c083088b5685","eb8c44808fa9ca43276bfe3c11512e7a0af0fe41335891f9c268f6697341886e","e7b512962ac2e77353cd238572172af3b4487533e353185e6bcfd5a82b8acbbd","8bb2623f540bc8f63a9245a170fd212e3c281d000edc9f897c9fb32b3b16e765"],"paragraph_range_zero_based":[3624,3647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p3624"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release the MR-DC related configurations (i.e., as specified in 5.3.5.10) from the UE Inactive AS context, if stored;","paragraph_zero_based":3648},{"literal_text_all_w_t_and_m_t":"1>if the UE does not support maintaining the MCG SCell configurations upon connection resumption:","paragraph_zero_based":3649},{"literal_text_all_w_t_and_m_t":"2>release the MCG SCell(s) from the UE Inactive AS context, if stored;","paragraph_zero_based":3650},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3651},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":3652},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as defined in 9.2.4 for SRB1;","paragraph_zero_based":3653},{"literal_text_all_w_t_and_m_t":"2>apply the default PDCP configuration as defined in 9.2.1 for SRB1;","paragraph_zero_based":3654},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SRAP as defined in 9.2.5 for SRB1;","paragraph_zero_based":3655},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3656},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications, except for the parameters for which values are provided in SIB1;","paragraph_zero_based":3657},{"literal_text_all_w_t_and_m_t":"2>apply the default SRB1 configuration as specified in 9.2.1;","paragraph_zero_based":3658},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":3659},{"literal_text_all_w_t_and_m_t":"1>release delayBudgetReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3660},{"literal_text_all_w_t_and_m_t":"1>stop timer T342, if running;","paragraph_zero_based":3661},{"literal_text_all_w_t_and_m_t":"1>release overheatingAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3662},{"literal_text_all_w_t_and_m_t":"1>stop timer T345, if running;","paragraph_zero_based":3663},{"literal_text_all_w_t_and_m_t":"1>release idc-AssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3664},{"literal_text_all_w_t_and_m_t":"1>release drx-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3665},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346a, if running;","paragraph_zero_based":3666},{"literal_text_all_w_t_and_m_t":"1>release maxBW-PreferenceConfig and maxBW-PreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3667},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346b, if running;","paragraph_zero_based":3668},{"literal_text_all_w_t_and_m_t":"1>release maxCC-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3669},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346c, if running;","paragraph_zero_based":3670},{"literal_text_all_w_t_and_m_t":"1>release maxMIMO-LayerPreferenceConfig and maxMIMO-LayerPreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["dffad7e0ae77bca9f723ec9aa8149bb59dc22490b523636b