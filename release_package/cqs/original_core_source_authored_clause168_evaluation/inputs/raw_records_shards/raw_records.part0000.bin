{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release musim-GapAssistanceConfig from the UE Inactive AS context, if stored and stop timer T346h, if running;","paragraph_zero_based":3672},{"literal_text_all_w_t_and_m_t":"1>release musim-GapConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3673},{"literal_text_all_w_t_and_m_t":"1>release musim-LeaveAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3674},{"literal_text_all_w_t_and_m_t":"1>release propDelayDiffReportConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3675},{"literal_text_all_w_t_and_m_t":"1>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3676},{"literal_text_all_w_t_and_m_t":"1>release rrm-MeasRelaxationReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3677},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":3678},{"literal_text_all_w_t_and_m_t":"2>apply the specified configuration of SL-RLC0 used for the delivery of RRC message over SRB0 as specified in 9.1.1.4;","paragraph_zero_based":3679},{"literal_text_all_w_t_and_m_t":"2>apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":3680},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3681},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":3682},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":3683},{"literal_text_all_w_t_and_m_t":"1>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":3684},{"literal_text_all_w_t_and_m_t":"2>if the resume procedure is initiated in a cell that is different to the PCell in which the UE received the stored sdt-MAC-PHY-CG-Config:","paragraph_zero_based":3685},{"literal_text_all_w_t_and_m_t":"3>release the stored sdt-MAC-PHY-CG-Config;","paragraph_zero_based":3686},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3687},{"literal_text_all_w_t_and_m_t":"1>if ncd-SSB-RedCapInitialBWP-SDT is configured:","paragraph_zero_based":3688},{"literal_text_all_w_t_and_m_t":"2>if the resume procedure is initiated in a cell that is different to the PCell in which the UE received the stored ncd-SSB-RedCapInitialBWP-SDT:","paragraph_zero_based":3689},{"literal_text_all_w_t_and_m_t":"3>release the stored ncd-SSB-RedCapInitialBWP-SDT;","paragraph_zero_based":3690},{"literal_text_all_w_t_and_m_t":"1>if conditions for initiating SDT in accordance with 5.3.13.1b are fulfilled:","paragraph_zero_based":3691},{"literal_text_all_w_t_and_m_t":"2>consider the resume procedure is initiated for SDT;","paragraph_zero_based":3692},{"literal_text_all_w_t_and_m_t":"2>start timer T319a when the lower layers first transmit the CCCH message;","paragraph_zero_based":3693},{"literal_text_all_w_t_and_m_t":"2>consider SDT procedure is ongoing;","paragraph_zero_based":3694},{"literal_text_all_w_t_and_m_t":"1> else:","paragraph_zero_based":3695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bb914d9268f38aa9ffe887b20e04c399fef2463e3c3eddc4e5df812c4882e5dc","08468dd43d62928aa5e959563786e29c9f1e97a5e07772d66da0901fb6bbdfc6","62df453758173cd866e534790c03d03fa218cdc9f65ebf47238f79a72bb20370","949f3c68933837056e22c3da41ba3a85a96affbaca1d3aa901a4050cd11f2a64","c9fb6a2a864104136f6029ce764cfc6dcb2568071e0b2c0116fd0bacfaa92cc5","1772cc7faa84f0616713e28a35d460aa4a9bca26fb61686211a5df21187b37f2","21262f13cb3c379615345a91cbbe35043d5b0d979a0f464d347f8fc63416f8ed","1886d8105f5ccf9638b4f6ff6ef3cc56b1ddda414a4c387d7bf219588a4a8b6f","759287fe60f5b15062b4d79095d0da36ba0d083e6da819c601cc137837f19468","6bb308c6f6fa2bf45efbea7eaca31a3e36a8ce8d377190d92480a863cfa01fdc","24bedd5cba49eba835a7c650c568b516a2bb154302727790b8b7c6d83745599f","9f30e1e44dfb4d6001ae4fe8fb6e713d0a43fb74d11cff317e4c60a3ad04812d","930078744c34f00f3cc5811ae7047a4fdd1b7c78f8b9e4f617b0dbf49494026a","de15223c53794c97d22cc2a123a6d04182e9f036ce9bc36e0abccd6fb2b1358e","e4f3a0f74f000e92bd7a6e595b0c5dd2b4bf817acf54a466cb07995a4f1bd32c","8be9995bad0e174ab0e198b59982fdead734b7d0776869b98dd8f7b822e8e062","8f9dd838ea8faea89f2573c973fc0f2d2848e50e208954375e2958ab37c48d66","fb59cfab0da92d995739ae7f1967471e540841e0d5b03582c2a20230fcc85f7e","0e44449e71211e629ca8b0b3b517635f0d6b1099909396f2b63cf75bb827b0be","30b8327ca71cdea3ed828c00649eb8216ded866ee72216c217e051b74ebf42d7","a51e81ff680b7f5fbb7b91cde8954a28de98b05349ef8dea65a1bd350ea0c832","fb1420124f1b2590e2c915c488af8f9cb1ee2aaa86a3282e8767ef7aeec73e16","d7b9d128f0524100b2b3d287fdfada5bde1ce184011e0bcf7be47c6f221c38e8","7bbb15f15818598ac06531e920d568a0f0041283694adc2355e87e9e69d05651"],"paragraph_range_zero_based":[3672,3695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3672"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>start timer T319;","paragraph_zero_based":3696},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3697},{"literal_text_all_w_t_and_m_t":"1>if ta-Report is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":3698},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":3699},{"literal_text_all_w_t_and_m_t":"1>set the variable pendingRNA-Update to false;","paragraph_zero_based":3700},{"literal_text_all_w_t_and_m_t":"1>release successHO-Config from the UE Inactive AS context, if stored;","paragraph_zero_based":3701},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCResumeRequest message or RRCResumeRequest1 in accordance with 5.3.13.3.","paragraph_zero_based":3702},{"literal_text_all_w_t_and_m_t":"5.3.13.3Actions related to transmission of RRCResumeRequest or RRCResumeRequest1 message","paragraph_zero_based":3703},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCResumeRequest or RRCResumeRequest1 message as follows:","paragraph_zero_based":3704},{"literal_text_all_w_t_and_m_t":"1>if field useFullResumeID is signalled in SIB1:","paragraph_zero_based":3705},{"literal_text_all_w_t_and_m_t":"2>select RRCResumeRequest1 as the message to use;","paragraph_zero_based":3706},{"literal_text_all_w_t_and_m_t":"2>set the resumeIdentity to the stored fullI-RNTI value;","paragraph_zero_based":3707},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3708},{"literal_text_all_w_t_and_m_t":"2>select RRCResumeRequest as the message to use;","paragraph_zero_based":3709},{"literal_text_all_w_t_and_m_t":"2>set the resumeIdentity to the stored shortI-RNTI value;","paragraph_zero_based":3710},{"literal_text_all_w_t_and_m_t":"1>restore the RRC configuration, RoHC state, the EHC context(s), the UDC state, the stored QoS flow to DRB mapping rules and the KgNB and KRRCint keys from the stored UE Inactive AS context except for the following:","paragraph_zero_based":3711},{"literal_text_all_w_t_and_m_t":"-masterCellGroup;","paragraph_zero_based":3712},{"literal_text_all_w_t_and_m_t":"-mrdc-SecondaryCellGroup, if stored; and","paragraph_zero_based":3713},{"literal_text_all_w_t_and_m_t":"-pdcp-Config;","paragraph_zero_based":3714},{"literal_text_all_w_t_and_m_t":"1>set the resumeMAC-I to the 16 least significant bits of the MAC-I calculated:","paragraph_zero_based":3715},{"literal_text_all_w_t_and_m_t":"2>over the ASN.1 encoded as per clause 8 (i.e., a multiple of 8 bits) VarResumeMAC-Input;","paragraph_zero_based":3716},{"literal_text_all_w_t_and_m_t":"2>with the KRRCint key in the UE Inactive AS Context and the previously configured integrity protection algorithm; and","paragraph_zero_based":3717},{"literal_text_all_w_t_and_m_t":"2>with all input bits for COUNT, BEARER and DIRECTION set to binary ones;","paragraph_zero_based":3718},{"literal_text_all_w_t_and_m_t":"1>derive the KgNB key based on the current KgNB key or the NH, using the nextHopChainingCount value received in the previous RRCRelease message and stored in the UE Inactive AS Context, as specified in TS 33.501 [11];","paragraph_zero_based":3719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["179bc2487aaba131743dcfa158a8f92c4f6218c76743e718e6c921b4eb672aad","aa3318e92139b7fe885f4078bb80325b3e3ac8c67d64fb3b7037f6ff4f28e45b","0d3643b4d874c380d2fad89b05dcb03942eec1ff1deb85b6384b463694130847","46880f09e54a6f3cb5dd96d722190522d0a7d0d641e20c70580bf8011c723ae7","c25e52e0930fc3d20382a08158667fcf54acd52e856821ef261902d7d16442ec","79f60293ff6c3aa0579465a98ef6fe568f7f127a81e54fb34840d330be744040","56c13e57d7a65c9baec3403d7275a751c12f428a972d5986063edff85e90197a","444d767ed09f3e79a64dcf011a775eaa8f31ab73618bb015475c1cf40c090890","33d9ca4dbd514af3e067d22b6680feb3a653af9e1a1158c04239d51a2987fc75","47516167afd4e8412c80374a14d815eebc3659eb512ff42c9840c3fd7a122970","1bf408e70739ed1f013b48d15055a0a1d6d0e2ebb1c83860d121d3fa36585e48","19a08aa9f6e299c9a0f76cb9e087eb825dd4fc80c6fc89d1e15948c3e3c9b086","de95e2681e08d44542e65336ff5193fd797b9071460281f1790eba922dfad247","120de8117987e465ef253f86341958e98af7da49898851d4aa1b98e1fb414544","8a84c9239925e0a356c368bae6dd0bb1cbc384b0faeb224afec37e17c40b4120","fe52d433885b2d4fa41c6728b71617006080c9228747ac27079bafd535a3a612","5fa8e62afe5f0a37f337463ba2959e86f79ef23590dae88b6d32afd9471ef522","7251f1ce5b8c931ad325d4c0977f72ede2ab8b4178c32cadb32170fe01297511","e6e8b38be5fa468fdd29e503f8d305bbefc1aceb910aa31263aa32dc40de0f9e","9f3a1cc0fc3ea8451141af8321c381b5a79388f2508877424b9ab6f3d3885025","7a1800a0568eab539063d7e3a9befd5d2c7f75cd196ed8865d94af8a3fafca56","e761de3a3153f029a6070187346df92581c7d1271d88a4160b6580dad691fe94","4c0e9270a8b1e1d1c72d14a38878b06d013e1e053d9b3be81096beb40afb3d05","bc72e03703883577a007e8a682fcd06961c3afb9f0260073d53c02ee5f642df4"],"paragraph_range_zero_based":[3696,3719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3696"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>derive the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key;","paragraph_zero_based":3720},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to apply integrity protection for all radio bearers except SRB0 and MRBs using the configured algorithm and the KRRCint key and KUPint key derived in this clause immediately, i.e., integrity protection shall be applied to all subsequent messages received and sent by the UE;","paragraph_zero_based":3721},{"literal_text_all_w_t_and_m_t":"NOTE 1:Only DRBs with previously configured UP integrity protection shall resume integrity protection.","paragraph_zero_based":3722},{"literal_text_all_w_t_and_m_t":"1>configure lower layers to apply ciphering for all radio bearers except SRB0 and MRBs and to apply the configured ciphering algorithm, the KRRCenc key and the KUPenc key derived in this clause, i.e. the ciphering configuration shall be applied to all subsequent messages received and sent by the UE;","paragraph_zero_based":3723},{"literal_text_all_w_t_and_m_t":"1>re-establish PDCP entities for SRB1;","paragraph_zero_based":3724},{"literal_text_all_w_t_and_m_t":"1>resume SRB1;","paragraph_zero_based":3725},{"literal_text_all_w_t_and_m_t":"1>if the resume procedure is initiated for SDT:","paragraph_zero_based":3726},{"literal_text_all_w_t_and_m_t":"2>for each radio bearer that is configured for SDT and for SRB1:","paragraph_zero_based":3727},{"literal_text_all_w_t_and_m_t":"3>restore the RLC-BearerConfig associated with the RLC bearers of masterCellGroup and pdcp-Config from the UE Inactive AS context;","paragraph_zero_based":3728},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with Ethernet Header Compression:","paragraph_zero_based":3729},{"literal_text_all_w_t_and_m_t":"4>indicate to lower layer that ethernetHeaderCompression is not configured;","paragraph_zero_based":3730},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with UDC:","paragraph_zero_based":3731},{"literal_text_all_w_t_and_m_t":"4>indicate to lower layer that uplinkDataCompression is not configured;","paragraph_zero_based":3732},{"literal_text_all_w_t_and_m_t":"3>if the radio bearer is a DRB configured with ROHC function:","paragraph_zero_based":3733},{"literal_text_all_w_t_and_m_t":"4>if sdt-DRB-ContinueROHC is set to cell and the resume procedure is initiated in a cell that is the same as the PCell in which the UE received the previous RRCRelease message; or","paragraph_zero_based":3734},{"literal_text_all_w_t_and_m_t":"4>if sdt-DRB-ContinueROHC is set to rna and the resume procedure is initiated in a cell belonging to the same RNA as the PCell in which the UE received the previous RRCRelease message:","paragraph_zero_based":3735},{"literal_text_all_w_t_and_m_t":"5>indicate to lower layer that drb-continueROHC is configured;","paragraph_zero_based":3736},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":3737},{"literal_text_all_w_t_and_m_t":"5>indicate to lower layer that drb-continueROHC is not configured;","paragraph_zero_based":3738},{"literal_text_all_w_t_and_m_t":"3>re-establish PDCP entity for the radio bearer that is configured for SDT without triggering PDCP status report;","paragraph_zero_based":3739},{"literal_text_all_w_t_and_m_t":"2>resume all the radio bearers that are configured for SDT;","paragraph_zero_based":3740},{"literal_text_all_w_t_and_m_t":"1>submit the selected message RRCResumeRequest or RRCResumeRequest1 for transmission to lower layers.","paragraph_zero_based":3741},{"literal_text_all_w_t_and_m_t":"NOTE 2:Only DRBs with previously configured UP ciphering shall resume ciphering.","paragraph_zero_based":3742},{"literal_text_all_w_t_and_m_t":"If lower layers indicate an integrity check failure while T319 is running or SDT procedure is ongoing, perform actions specified in 5.3.13.5.","paragraph_zero_based":3743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["86711dca3abcaca1d439f1c7cb91108d45f1281cb941dc8f1aa9293f4acede60","e5b2262bcdc1e7bc38eb45355ae94ee069e7c9394fd216822b763ee24a8c9475","7318e821f3042a3c82e69cb6ca5a03c6c5c19ec98186503267295a9484e12f4f","ec9b404f0002fa9d217fe86145b703359d19138dfd5b795cf2207d8e36f0a377","0ffa5fefd696f5a78a5735d129e9d1e2a5ddbf256518f25d852a20281e8bdf45","7495d6b2230c43a836a5aace5438ba484497e70765afe0cf8b5a02f2a0ec6942","42e95d4e2246285270177e2ff90e5904ff9378f01a511413b94513374942d1ef","e2decbbd375ac89eaa8df50256266ecd30e92689fbfad49117e8c8d929f5b823","e69ac01afc7e5540d0753c3ec4b43731ab649ae0b05c47b1c7686bbb1b344f88","2577cd7ca9985f7152c03b437b951026d759c388cc4cfa92fd9c9c5879d8ec62","df28e2734f3a3a52a10343b4fee0337c9f0dd266f9d64924b83bd70d72452aa3","63b2000d3fb0cca566e77441d8ede2eed1ac05a05f3e886582c3da27cbd24ab1","6d98a9158a4a3f9d21850000cf056486415ecc5e60fd5a30210a4e594832db5f","36d7684ea8d402be99ec514b8c47eeca57585c68ab784874555ca770626eda5f","629fe8af8b746b0cf971cb22dd4ba5ea1b6708feaf82a0fe3241230a68fb2fe8","c3cbbe022991bda81006969ae83a339f55e051efca158c1fb12f02a54d1d5051","4759bf73a7281a656cc71114cd196a82f2b9cf30e8b4619f8f212c0db2e0dffe","e7aa2a5f60b4c795ad50affc732b03803e6ebd9bd5941fe3d183337cc8cc75bc","a49f887f6fb52aacf9df363e2398b93d3f7b32087cbdd96aa527fa464edf5aaa","b9ab3437ef3b81fc0eb39c0422b76b163831fcdd9d1a06f48c26ef3b2fed84cb","4f930d0bfc2edc39e509ce5e23f5884b49df0a09298611a78de96652998b7f76","f46987e197df37cdb96272bd7c123a830749fe195e8d6f5e7a41941bcc75f368","b93c3bb62d818238b193d6658f63dd091b5b58c4c211bf48f5d10382644adcef","98a3941b3309c2a81e19513b297e2eb4b6ee3d06e63fcc157f35e065d5428d3c"],"paragraph_range_zero_based":[3720,3743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3720"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the UE is a RedCap UE and the RedCap-specific initial downlink BWP is not associated with CD-SSB, the UE may continue cell re-selection related measurements as well as cell re-selection evaluation, otherwise the UE shall continue cell re-selection related measurements as well as cell re-selection evaluation. If the conditions for cell re-selection are fulfilled, the UE shall perform cell re-selection as specified in 5.3.13.6.","paragraph_zero_based":3744},{"literal_text_all_w_t_and_m_t":"NOTE 3:For L2 U2N Remote UE in RRC_INACTIVE, the cell (re)selection procedure as specified in TS 38.304 [20] and relay (re)selection procedure as specified in 5.8.15.3 are performed independently and it is up to UE implementation to select either a cell or a L2 U2N Relay UE.","paragraph_zero_based":3745},{"literal_text_all_w_t_and_m_t":"5.3.13.4Reception of the RRCResume by the UE","paragraph_zero_based":3746},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":3747},{"literal_text_all_w_t_and_m_t":"1>stop timer T319, if running;","paragraph_zero_based":3748},{"literal_text_all_w_t_and_m_t":"1>stop timer T319a, if running and consider SDT procedure is not ongoing;","paragraph_zero_based":3749},{"literal_text_all_w_t_and_m_t":"1>stop timer T380, if running;","paragraph_zero_based":3750},{"literal_text_all_w_t_and_m_t":"1>if T331 is running:","paragraph_zero_based":3751},{"literal_text_all_w_t_and_m_t":"2>stop timer T331;","paragraph_zero_based":3752},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":3753},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume includes the fullConfig:","paragraph_zero_based":3754},{"literal_text_all_w_t_and_m_t":"2>perform the full configuration procedure as specified in 5.3.5.11;","paragraph_zero_based":3755},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3756},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume does not include the restoreMCG-SCells:","paragraph_zero_based":3757},{"literal_text_all_w_t_and_m_t":"3>release the MCG SCell(s) from the UE Inactive AS context, if stored;","paragraph_zero_based":3758},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume does not include the restoreSCG:","paragraph_zero_based":3759},{"literal_text_all_w_t_and_m_t":"3>release the MR-DC related configurations (i.e., as specified in 5.3.5.10) from the UE Inactive AS context, if stored;","paragraph_zero_based":3760},{"literal_text_all_w_t_and_m_t":"2>restore the masterCellGroup, mrdc-SecondaryCellGroup, if stored, and pdcp-Config from the UE Inactive AS context;","paragraph_zero_based":3761},{"literal_text_all_w_t_and_m_t":"2>configure lower layers to consider the restored MCG and SCG SCell(s) (if any) to be in deactivated state;","paragraph_zero_based":3762},{"literal_text_all_w_t_and_m_t":"1>discard the UE Inactive AS context;","paragraph_zero_based":3763},{"literal_text_all_w_t_and_m_t":"1>store the used nextHopChainingCount value associated to the current KgNB;","paragraph_zero_based":3764},{"literal_text_all_w_t_and_m_t":"1>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":3765},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3766},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to start the timeAlignmentTimer associated with the PTAG, if it is not running;","paragraph_zero_based":3767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["fafdad314b37d4775083bb13e9243679304d64569eaebc74d6404176287ae28c","644c6673c0b0ff2ee69554204093338fdf85c24819ae60c285739b8fe5af60d1","559f7213c2ea4cd41513045bc664143441c59f35bc536c54f8319f3177f6fa46","e820b4ac0f4ed67513b837bc2028f89949b37cff43b86c5e0b16ed2e0ec8a21f","fec71bed260fd68a7aeebd2dca468435eeacad6ad4b96528ff706fbb1327a903","ea7913a9a067d5810a0f74e03a8c56ce65407eddcff0e9b6c71f7646d33acbe3","a2af78b305bb4a95e7525b1dc8cfa27f37ddccc468d7cbec3a43ba9ad4175cea","30758cb65a3ab15ffd10274ad1c91a09e4eee2cc6c43cfe4643be85afef20e61","6fc91444595bf2a84b0f87fe94d82a4ef49c764d3b0d12718890ba072a68cb67","dfd9c264c3d8949d819c7ac7819ade6d92e54094044a2650dd323ed453f53b88","e2421edccdecce52f917ba99b336d72bda567e5c5e7195e2d17f2e23830dc3b4","a813cc9952bffa6f6162b2127213a86ddfc949e05e152f70e4ee17fe090843b2","0feb4ddf29f9dab949bfd6c270a6c196f3d8929f90f98ebb02e567825d2e23a4","2806b7081c91f4a65483b543ab447209ae9025254993bb55b1b72f0193362a0d","3137ba1bf16a195dc3da9fbb24df97bf4ddd599e488131fe8fdab45b4ff332d9","3ea7659858daa5e63e64a7a2b518271c80c3821410cfbbe7643113ce45fc2a6c","94f3461ccdc6b24577a8765b46a44b36d0b0c477dfda1a890b77485002b3f313","bddda7590cf27921508d6422fa4d7fd56283e30e9118229665f04fec06d0b981","cb9d6a24b47beb77bd10ac357b4f2764de4ca6d7358616f24030cebfe42449a7","a94dd3fc0624dff20950e731ccfe139b6139e2045b0f9308348455a9580ad0f8","6995d6eb96fd8252f0135779173f31b5563d57ec2a013b0493e8d0e2d692bd71","ee8041cbedf536da195402249fa9a91c514ce3583c8a231e816cc5439aeba953","0fbc819db97ab5ccb4a47b027e006a89dc9ba6bb41b503a783943c4c1b620132","b968fb60bfd5df41ec455babff28e43d8e8ac9bd571522c53b1ee2d9bc6230c8"],"paragraph_range_zero_based":[3744,3767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3744"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if srs-PosRRC-InactiveConfig is configured:","paragraph_zero_based":3768},{"literal_text_all_w_t_and_m_t":"2>instruct the MAC entity to stop inactivePosSRS-TimeAlignmentTimer, if it is running;","paragraph_zero_based":3769},{"literal_text_all_w_t_and_m_t":"1>release the suspendConfig except the ran-NotificationAreaInfo;","paragraph_zero_based":3770},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume includes the masterCellGroup:","paragraph_zero_based":3771},{"literal_text_all_w_t_and_m_t":"2>perform the cell group configuration for the received masterCellGroup according to 5.3.5.5;","paragraph_zero_based":3772},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume includes the mrdc-SecondaryCellGroup:","paragraph_zero_based":3773},{"literal_text_all_w_t_and_m_t":"2>if the received mrdc-SecondaryCellGroup is set to nr-SCG:","paragraph_zero_based":3774},{"literal_text_all_w_t_and_m_t":"3>perform the RRC reconfiguration according to 5.3.5.3 for the RRCReconfiguration message included in nr-SCG;","paragraph_zero_based":3775},{"literal_text_all_w_t_and_m_t":"2>if the received mrdc-SecondaryCellGroup is set to eutra-SCG:","paragraph_zero_based":3776},{"literal_text_all_w_t_and_m_t":"3>perform the RRC connection reconfiguration as specified in TS 36.331 [10], clause 5.3.5.3 for the RRCConnectionReconfiguration message included in eutra-SCG;","paragraph_zero_based":3777},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume includes the radioBearerConfig:","paragraph_zero_based":3778},{"literal_text_all_w_t_and_m_t":"2>perform the radio bearer configuration according to 5.3.5.6;","paragraph_zero_based":3779},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the sk-Counter:","paragraph_zero_based":3780},{"literal_text_all_w_t_and_m_t":"2>perform security key update procedure as specified in 5.3.5.7;","paragraph_zero_based":3781},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the radioBearerConfig2:","paragraph_zero_based":3782},{"literal_text_all_w_t_and_m_t":"2>perform the radio bearer configuration according to 5.3.5.6;","paragraph_zero_based":3783},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the needForGapsConfigNR:","paragraph_zero_based":3784},{"literal_text_all_w_t_and_m_t":"2>if needForGapsConfigNR is set to setup:","paragraph_zero_based":3785},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide the measurement gap requirement information of NR target bands;","paragraph_zero_based":3786},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3787},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide the measurement gap requirement information of NR target bands;","paragraph_zero_based":3788},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the needForGapNCSG-ConfigNR:","paragraph_zero_based":3789},{"literal_text_all_w_t_and_m_t":"2>if needForGapNCSG-ConfigNR is set to setup:","paragraph_zero_based":3790},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide the measurement gap and NCSG requirement information of NR target bands;","paragraph_zero_based":3791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3af9d81bdb4446f570d10603cccdf193d082e697c2bfaadf4bd8ffc489571d00","f6355668c161f60750378d1c47aae64fc8c58602bc8e105fa678f27c6cc23221","c58e1b7a7e7c3eee2af5c67b89d422828764c5e7c338fb2a399c4dc1d8d51dc4","cbeac273b9872a873b45ec9f0e622d545e1396f115d809c00c21eb908ce12d94","916c63c6f824873a10cafcb691b084bfb4351af8d9a828c73705a1d103b9b61a","f7c85bdf58bbc44e6fe9503144bff0f838a0aca108b12dfe0c327d8b879ff634","1815eab851e49d04847e3ea2b051f40bc6b53057bb4141e6b99b1b93809031ad","22bf390601d02b9a08b0d5048805c92e0e08c396daa8f78062dcbf86f4dfa62f","71d3f0614c143c9ac4291eb9464a219a96cbab6711539be76d8a726a469d2497","54d5a8f6df353cf51a9cc7081834acc00585cdd2c107cacb2f55c6a2c7467a79","677b487accfc8b22f6b825bcea1ca37677cf82fd47b7c4a465ae2db58c6e9f0d","caa3ef4893b61d7be90ccee5956aed9c493aba151c9ced0cd7d128f4610a2e5a","236e262b75dffc65ec4ca5c474a4bd56a6e43f8da60af64c7f23d0c0ce6fe71e","4f6bb07c1367ecbd24bb8eee7f319de4a7295df83c8af88b69480605f849b9c2","d0f0a8f15ef819366a64451284dc2bfefc037b4c2e03bf2bb3601e6fce903ad0","4c89d4e204aba4094a52a901127a2a326b1be80d04a9a2b5313a7478dd3d6357","9a40d3a484d7bc6c1118e4c53ae73ec5afeccf7da832b34e964ce51f89d15880","5ef4ec2e238fbf4ea520ad325154a311c01be528ee63fd522036338b967257b8","7e492c30976385ca8e5984dd43df4fe15264105dd6dbb36fc1b612352fb605f1","1f23641fc8e832a14e5b3ba9c95ef39b008bf0196959d133520281bd9ccacda0","d44d317ac226b5f105a97e6202cb53efa10d247853403d9f475f427a484c9f32","dd1d6a98e1dfbaea139261ad849359fd1fb0db5f57ea32fc49a9a678e74a98c5","9c2461ca3b1dc1e1ee6ebd176db470c26ac111dbc8cbce3e9ef8ed716c16fac2","22c5d93f125836e6262d07ee00b40cff5f5f32ca8d9934a63955443210640a7a"],"paragraph_range_zero_based":[3768,3791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3768"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3792},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide the measurement gap and NCSG requirement information of NR target bands;","paragraph_zero_based":3793},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the needForGapNCSG-ConfigEUTRA:","paragraph_zero_based":3794},{"literal_text_all_w_t_and_m_t":"2>if needForGapNCSG-ConfigEUTRA is set to setup:","paragraph_zero_based":3795},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide the measurement gap and NCSG requirement information of EUTRA target bands;","paragraph_zero_based":3796},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3797},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide the measurement gap and NCSG requirement information of EUTRA target bands;","paragraph_zero_based":3798},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the appLayerMeasConfig:","paragraph_zero_based":3799},{"literal_text_all_w_t_and_m_t":"2>perform the application layer measurement configuration procedure as specified in 5.3.5.13d;","paragraph_zero_based":3800},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the sl-L2RemoteUE-Config (i.e. the UE is a L2 U2N Remote UE):","paragraph_zero_based":3801},{"literal_text_all_w_t_and_m_t":"2>perform the L2 U2N Remote UE configuration procedure as specified in 5.3.5.16;","paragraph_zero_based":3802},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the sl-ConfigDedicatedNR:","paragraph_zero_based":3803},{"literal_text_all_w_t_and_m_t":"2>perform the sidelink dedicated configuration procedure as specified in 5.3.5.14;","paragraph_zero_based":3804},{"literal_text_all_w_t_and_m_t":"1>resume SRB2 (if suspended), SRB3 (if configured), SRB4 (if configured), all DRBs (that are suspended) and multicast MRBs;","paragraph_zero_based":3805},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the SCG is deactivated, resuming SRB3 and all DRBs does not imply that PDCP or RRC PDUs can be transmitted or received on SCG RLC bearers.","paragraph_zero_based":3806},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities or inherited from another RAT;","paragraph_zero_based":3807},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":3808},{"literal_text_all_w_t_and_m_t":"1>if the RRCResume message includes the measConfig:","paragraph_zero_based":3809},{"literal_text_all_w_t_and_m_t":"2>perform the measurement configuration procedure as specified in 5.5.2;","paragraph_zero_based":3810},{"literal_text_all_w_t_and_m_t":"1>resume measurements if suspended;","paragraph_zero_based":3811},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3812},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3813},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3814},{"literal_text_all_w_t_and_m_t":"1>if T302 is running:","paragraph_zero_based":3815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["969222faf46a84bbad025ca3735f3012231746250f901382906c7c601c6521ee","00295b34f3ac49c6239b13725ac6ed8a450641fc1437ccf46e0f256800de6ace","466c981dd7eb5ebd5f39822c76a98f081b94b9f94fa4cd87f428cd9bca21e6a3","70138d1b7814992227b46b860b3d28fd8976beca41f66c62123fd3cd9e9950da","5b6c12f1a1635c540160063b906c64c6d35d2ce8c3356a3b37cd0b2bf8365b79","226e7a87a5c9b973b2dcc6ca17477382435265551d5ae0b6f58108a6a01e4714","266c4ef1ca7941bb7f3639860229bb7f5a0b0851da29553387916afca57d0636","743e243d92d2ed41ba29bdcae28e36091f47c0ce57d792478ea15f8c4b386578","63c16c496f0eadc63bc239ec6521448cb807442178c9fdbfcaebd0a8af472821","aeb3dda2121a5dd623f371064f46c55816e584da5eb5e7512a1085d23d9b829a","88a34d3e54102fa532797148158e8f96a3942c27cc42f85f604010c9c558a54e","08298fbf4bc447ea568e854a0317c7fe6a0502b80ae8bd486c0eb3bb4d8d1548","cc0a2fa4b20dec35dcbae356babc557d2fa7fe0d69b5b90e8c3bca4e9c8bd41c","65960ea72545a863edda37871928db83a7eb704cb08bb18b1772208451068e5c","d4ab7356e1cebfeeaf67b33a54e8651584ed98f46b7b3a92a9b89f64b96e4392","18c74d8607a3ddf78c4a82634944249b4b75df83fc6fab62e18311cddc90be6a","56e080483a16a116ac9d99ed68aec10c8293aec47609f30430657b1eeb79f9f0","e67a76c2faf64160506cb77e960c7d9935e215ae2d219e8ed1cb30448c715de1","f87f619bc550a0e429ac723ad01a9374094692ea81cf45f24be8d87ec35c4767","674ef17761b7917754d9f26540b99902ecf111992524f678e9e36a8891152337","260609b3d0a59d09e21d850b5ed263cd47512b4d437e7f07799acf22b341fd7b","0b02261a9d85d79ec30bbb1aafd94cac3d0f70cab9132d49c073ff54d421b1ff","fe14e0bf4ab69ccb0990758027ec818aeffaa95f4793678579feb308d96ddc00","79e8fa7dcff91332e718ea305cbf6a9fd61d88b8a4507b2871b4f467f61bae74"],"paragraph_range_zero_based":[3792,3815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3792"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>stop timer T302;","paragraph_zero_based":3816},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3817},{"literal_text_all_w_t_and_m_t":"1>enter RRC_CONNECTED;","paragraph_zero_based":3818},{"literal_text_all_w_t_and_m_t":"1>indicate to upper layers that the suspended RRC connection has been resumed;","paragraph_zero_based":3819},{"literal_text_all_w_t_and_m_t":"1>stop the cell re-selection procedure;","paragraph_zero_based":3820},{"literal_text_all_w_t_and_m_t":"1>stop relay reselection procedure if any for L2 U2N Remote UE;","paragraph_zero_based":3821},{"literal_text_all_w_t_and_m_t":"1>consider the current cell to be the PCell;","paragraph_zero_based":3822},{"literal_text_all_w_t_and_m_t":"1>set the content of the of RRCResumeComplete message as follows:","paragraph_zero_based":3823},{"literal_text_all_w_t_and_m_t":"2>if the upper layer provides NAS PDU, set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":3824},{"literal_text_all_w_t_and_m_t":"2>if upper layers provides a PLMN:","paragraph_zero_based":3825},{"literal_text_all_w_t_and_m_t":"3>if the UE is either allowed or instructed to access the PLMN via a cell for which at least one CAG ID is broadcast:","paragraph_zero_based":3826},{"literal_text_all_w_t_and_m_t":"4>set the selectedPLMN-Identity from the npn-IdentityInfoList;","paragraph_zero_based":3827},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3828},{"literal_text_all_w_t_and_m_t":"4>set the selectedPLMN-Identity to the PLMN selected by upper layers from the plmn-IdentityInfoList;","paragraph_zero_based":3829},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrent:","paragraph_zero_based":3830},{"literal_text_all_w_t_and_m_t":"3>include the uplinkTxDirectCurrentList for each MCG serving cell with UL;","paragraph_zero_based":3831},{"literal_text_all_w_t_and_m_t":"3>include uplinkDirectCurrentBWP-SUL for each MCG serving cell configured with SUL carrier, if any, within the uplinkTxDirectCurrentList;","paragraph_zero_based":3832},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrentTwoCarrier:","paragraph_zero_based":3833},{"literal_text_all_w_t_and_m_t":"3>include in the uplinkTxDirectCurrentTwoCarrierList the list of uplink Tx DC locations for the configured uplink carrier aggregation in the MCG;","paragraph_zero_based":3834},{"literal_text_all_w_t_and_m_t":"2>if the masterCellGroup contains the reportUplinkTxDirectCurrentMoreCarrier:","paragraph_zero_based":3835},{"literal_text_all_w_t_and_m_t":"3>include in the uplinkTxDirectCurrentMoreCarrierList the list of uplink Tx DC locations for the configured uplink carrier aggregation in the MCG;","paragraph_zero_based":3836},{"literal_text_all_w_t_and_m_t":"2>if the UE has idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport:","paragraph_zero_based":3837},{"literal_text_all_w_t_and_m_t":"3>if the idleModeMeasurementReq is included in the RRCResume message:","paragraph_zero_based":3838},{"literal_text_all_w_t_and_m_t":"4>set the measResultIdleEUTRA in the RRCResumeComplete message to the value of measReportIdleEUTRA in the VarMeasIdleReport, if available;","paragraph_zero_based":3839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9d1e4c316cd100e039ab7106e12058539a622c2ae57b775b4efc06ae388b8fc2","b51c16e16707a994084957e2bc6811cb9f609c082fa41555d0d95fe8dda97335","c2d27aab31cd6d63eef12514b0eb3a5055ff2a2a2acebe35dbc5fa3489f5b37b","1b67901a391924f429f82e029444cfe3d1f5cd811ea113ececf147e41100dde5","cf5fc744b474fa49c893e1e444125bcffa3ac3f8b064e3c5f9f95cb276b407bc","3afbef82d0f0a8f991b0918e4c2aceb42bceedf7a08537dd931cca80268d5c52","8059ef376c4d674d21c08173ffac420296aefcf5b0ef00b984668f77f1be7a38","bd302669a056f7c84424de6a44d21f517b8009acf11f89bb29990d4ae47350bf","04ed0d6cdf143adc6946a1e7fb1d5d8042f4cb58d4b52ffd388e836c038a4aa0","16eef831d75159d3010b716b03f9a2ee7eb5e0c26d2f518a322e447ff63edb13","6c48a2b667cc4352a11ef27f38b4d9235800f66e271c78b82c2d4b1cd51c77c6","00d1c67afb9447dc22801cde59ba511de2d3f30fee86de44dabfc936fa06bba5","3ad66279d6f54042496acb7c9acfcd5da355b17dbf12e61ecb76023e96b58138","c44e3ce0398a0b794bd55b0085495a8950b425e4bbb040024ac8c909797698f9","71bd8a069270fd9d84481ce2764bc6eee06d177d54943beafb5badba677b3d6e","9773715bd0575c00ddfec99e9ff69ca59d411e8d8d65ac1b3b64a0ef1a71377c","1e59bc2ef6b883e8b7e4f0187368b1e54faf24f32d7483805732e5ec512a1fdc","271375abe838424204984d0e6f1effc5f1c186aa76bd9bd7bd339eec821ae70c","da9d7fb31f98d7f8185c77e30dd2d30943447df1aea3022fbe8d0c3c302cfb5a","acd7770855451816a68be4868d7cc15fecd574d404a3fd00ca1845c40a91fdca","cc1fe6d75611258df208c749e7bac5ab044ce3cd2add9badb477dc61355f8adf","1080724a9c8e8f56bab54aecf883e0ad10e07271908ca04056bb3a49da7defd3","75f5cc0a8a64d24edf4112d44f153d218b639f95c79bb3ed31cb01d200edf6ad","5645e5e8c4ab9ef3eee7b091f72810d32169d47d8e814bb1b7f9f7ff071e8c57"],"paragraph_range_zero_based":[3816,3839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p3816"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set the measResultIdleNR in the RRCResumeComplete message to the value of measReportIdleNR in the VarMeasIdleReport, if available;","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"4>discard the VarMeasIdleReport upon successful delivery of the RRCResumeComplete message is confirmed by lower layers;","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsNR and the UE has NR idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport; or","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"4>if the SIB1 contains idleModeMeasurementsEUTRA and the UE has E-UTRA idle/inactive measurement information available in VarMeasIdleReport:","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"5>include the idleMeasAvailable;","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to eutra-SCG:","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"3>include in the eutra-SCG-Response the E-UTRA RRCConnectionReconfigurationComplete message in accordance with TS 36.331 [10] clause 5.3.5.3;","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"2>if the RRCResume message includes mrdc-SecondaryCellGroup set to nr-SCG:","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"3>include in the nr-SCG-Response the SCG RRCReconfigurationComplete message;","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCResumeComplete message;","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCResumeComplete message;","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCResumeComplete message;","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included:","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running and the logged measurements configuration is for NR:","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCResumeComplete message;","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements available for NR:","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCResumeComplete message;","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCResumeComplete message;","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["91068abb24d9bd0998d67a9f2ded844eafb6b4cf926e9912c22cc16819cadad1","3dcf9f44c7694faeb5d84ec9dded98814c6e84a8383c851f02735def8354c015","32f0810379b011a2a96a5e706da7ea2876768f2371fa4e0938a180b99487e804","60765ed64f743f9830307208fc78ac8e14739491059345da8887a869136fc073","6366ad9951738b3b3b9036f910952ee6346bec2b11923a330fc1a5e353aa027c","e97a028e8183ca5b82f4f7d9ab8fbf0e7b5e1dc678dc2d9eede244fb59657b31","bdcf64d0b9507615d2ebd2a26ad057de1fe499a7f70195da9606b8fa0f2b8543","f845660031682e127a0c7b5b8e962b1840be737a059cc231349020e34643b4e0","b440192b6b1c668cc86e31a0e7cf834bd12064831a934c817d96071c035ed1e5","5e0114d331c5fad54af89e34b26d6b4ee376f17cdde6b63e34b30a7608d1eb56","f5282220e2b5d45224d6b02d9289712a2ac360f4fbcb9b0f955b77f449b12d23","a405682f26bff1aa436cf834d338ffd3f138f0cf54c7438efe08b1b791884c29","9f0d9ce824f4ca348cd1d385f130e050035f8c5f46747933ae28c8f70cf64ffc","90576d35d155a0659eb997037e0960ff311106a95b8d8176def1853919abdbd2","55c54d8b0a3109c1bbcd83b75e36122651cadcc2113f4c0f38abf648da150310","b744d5e36a2f45240c37d4e435c2f05bdf3c43a731236ead7aed167404e8741a","e681fe3ced609eee0cb83edf6d29a8b0f2f3d78de811382af1f769dcb06ae1af","2499d3be03a5199fdc155091b3e192922ac3efcbab818d0d1294a7f86f96f20c","7994d2d78bd49b44be9b66e2e4510e1ba22730ae5394f572517b017c55a93ad0","23e2b68f079521811d014f5909ebeaea3a2aabf93ff77326ea795345b447d776","f57d168986c0181143f915bea8f654380fc3b5bc0d6b2918fe342e9823e3d68e","bb44e683dad4d1b89224874cd8f81535f7d3aede5b2944821e68769c7392f808","e4156fb425e6e2638bd779ae3540374827294ac8ebea31a25d97e5690e57a4f0","3031691deeac1cbea612eb3689a40e561924d91c407b179b3c9e0db22cdbd2bb"],"paragraph_range_zero_based":[3840,3863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edi