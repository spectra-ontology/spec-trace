{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RSRP-ChangeThreshold-r17 ::= ENUMERATED {dB4, dB6, dB8, dB10, dB14, dB18, dB22, dB26, dB30, dB34, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"SRS-PosConfig-r17 ::=               SEQUENCE {","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r17 SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16 OPTIONAL,-- Need N","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToAddModList-r17  SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSet-r16  OPTIONAL,-- Need N","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToReleaseList-r17    SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResourceId-r16      OPTIONAL,-- Need N","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceToAddModList-r17     SEQUENCE (SIZE(1..maxNrofSRS-PosResources-r16)) OF SRS-PosResource-r16        OPTIONAL -- Need N","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRELEASE-STOP","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"RRCRelease-IEs field descriptions","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"cellReselectionPriorities","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"Dedicated priorities to be used for cell reselection as specified in TS 38.304 [20]. The maximum number of NR carrier frequencies that the network can configure through FreqPriorityListNR and FreqPriorityListDedicatedSlicing together is eight. If the same frequency is configured in both FreqPriorityListNR and FreqPriorityListDedicatedSlicing, the frequency is only counted once.","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"cnType","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"Indicate that the UE is redirected to EPC or 5GC.","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"deprioritisationReq","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"Indicates whether the current frequency or RAT is to be de-prioritised.","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"deprioritisationTimer","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"Indicates the period for which either the current carrier frequency or NR is deprioritised. Value minN corresponds to N minutes.","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"measIdleConfig","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"Indicates measurement configuration to be stored and used by the UE while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"mpsPriorityIndication","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["23483bb61c6460525171e73c0fb4ed4ff8baf12a5a3ee41010ab9a6f97dabd81","9d8085db1602cda2fdc05005d9e15f6eb261bde493e23a755132e90f30678001","d2a80134ccde79b4cd83ee3814d22152feba9dc59d77c2c7740cbecd318a898e","e1260f34120f7749a9481c569a8854ebe079cf24f03046dcd3b7d5020abc81a6","60adcd654974a0864119b5137c23ec31ae3db404e83642becb684dfa9d578269","a3742dcb955a42493c331f3cda0fb44a05482a4cc863f3a5caaa9021fa7c22af","f5b49d5114a6aabb7fc383d0e0385a410d9244dd12b394e69a982b718a794dbe","f2f9d71646a7ccb9c1e88de87198b2b997ddcf57d7b51fa847b304ebfe2e8a86","72d80d3a92f15c5341acd50627420451619de4a279930969dbf922cf671a9dcb","1b5e868556bff68433426fdeffa70b8408e141501ff80cb94d8177fa88f4d95b","21ff023e80dadab80ce72f6098926ad5250825960ed16d8a8ffc6c564b8dc081","25e6f45ea78ba834ac58c874ac84ef386c9331df2697335529f49ab036299cb1","7c112fd8b333be08265232c2f074f459c1541846c1169739ccfb82e075a8f8a4","ea6eba122d61334b83f78ba69f8e03448d72de9fc5e6cae62ca248926d7528e5","a25ca1b0f39532666a35cf82f771850884ec6a0cfd2495d775b42f752fb3357b","0f80d86d6a035f4f48826d0b4aa7fea0efdd30d6833f69e8296710cccfeb1ab2","558af6abf187a2d3e1cf4494bee7e773e4f1c7e47bfac95b6035b5f131242d20","ed681ed94c59fce0aadfe8a4b4da23054b49b458a58a799fa17e01a8e9c3dbb3","fe8d96b73516f51d9fc254bbf70e8403e562762db22596e8af27b958e9249349","d3ab4d648f750df1088978f0b860ed01d43fbd5e5386e33935224c435d62f1b8","2fa8c0d7a0d697fd848e8c8c67c428e538d95271a95d50c490edc07bbdc17e7e","5d26170bfff1013b276182d91cfb8d34315d9ea92409e59859d57e77ed5084f1","d1fc9fa85f2790c92c78834985957c5d2d6df8646a436ccd351f698da33a7252","0fbae1fcd78ffd9f698bf8d49b5948ce41b94c197a9536200a7c2273d8f62429"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p552"}
{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the UE can set the establishment cause to mps-PriorityAccess for a new connection following a redirect to NR or set the resume cause to mps-PriorityAccess for a resume following a redirect to NR. If the target RAT is E-UTRA, see TS 36.331 [10]. The gNB sets the indication only for UEs authorized to receive MPS treatment as indicated by ARP and/or QoS characteristics at the gNB, and it is applicable only for this instance of release with redirection to carrier/RAT included in the redirectedCarrierInfo field in the RRCRelease message.","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"noLastCellUpdate","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"Presence of the field indicates that the last used cell for PEI shall not be updated. When the field is absent, the PEI-capable UE shall update its last used cell with the current cell. The UE shall not update its last used cell with the current cell if the AS security is not activated.","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"srs-PosRRC-InactiveConfig","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"SRS for positioning configuration during RRC_INACTIVE state.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"suspendConfig","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"Indicates configuration for the RRC_INACTIVE state. The network does not configure suspendConfig when the network redirect the UE to an inter-RAT carrier frequency or if the UE is configured with a DAPS bearer.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"redirectedCarrierInfo","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"Indicates a carrier frequency (downlink for FDD) and is used to redirect the UE to an NR or an inter-RAT carrier frequency, by means of cell selection at transition to RRC_IDLE or RRC_INACTIVE as specified in TS 38.304 [20]. Based on UE capability, the network may include redirectedCarrierInfo in RRCRelease message with suspendConfig if this message is sent in response to an RRCResumeRequest or an RRCResumeRequest1 which is triggered by the NAS layer (see 5.3.1.4 in TS 24.501 [23]).","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"voiceFallbackIndication","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"Indicates the RRC release is triggered by EPS fallback for IMS voice as specified in TS 23.502 [43].","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"CarrierInfoNR field descriptions","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"Indicates the redirected NR frequency.","paragraph_zero_based":590},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":591},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB in the redirected SSB frequency.","paragraph_zero_based":592},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":593},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":594},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":595},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":596},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":597},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration for the redirected SSB frequency. It is based on timing reference of PCell. If the field is absent, the UE uses the SMTC configured in the measObjectNR having the same SSB frequency and subcarrier spacing.","paragraph_zero_based":598},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["e89ecefff550d04c036464a903ae149c471efdf07d3516cc9bf96501f5d3a7fe","7e34cd6e36470d08e9f00844040b005f935808f5e9b3cff8a15e0214d7567731","a640be81624f378c6b9f0dbbcbd5b6cd81218d0c4678433decef4dced59303c0","18c0b6e38c7a965bb700f8bc6e5fb5b8cca0825cbb1121adbf2cad9d9395afb8","8ae2563f97b6b2b970fcd09f3f1e9d0631ca264e45f2a7daa13b0a44f2ba776d","fd8c68471d19a16a72b3b9fdb537e67130680b99deac01d60c8c696ea83cc2df","b94e977e8f5d3e13e4fdc6983f7ed5706ce8873c7dde4ddbd0e15963fd611d0c","94b09422311cb48902b9ce428a6ba3e89b2178ac1ab2f7b072ac52ffdc7e2bf3","61343d471cc2f2032562c40a78d48e4da7f1b1dce7404c196340da2be11b056b","3cb1771a64987eff2ff887a51484dc1e32bdb22b4b298ae1a26827a526deeabe","a92b0eb3d01cf2c43f57df43eef4ff2a3a07e493572d64cfb5c9ae7ecc276d14","dbc545bf039702400a517fb35b52816e3baedc279ffa746a6994f1e37c7b5496","0118ce865802a88729166eeccff8e70ec882d393e7dbb5c4a66fe406e0b6f59a","60ee2f04176e85f493643799a9e0f15d0adf1df96f08b6d69858dba598137efa","868f418f09a068d512e54016dd574fec74410d602f9e9f848d0bbfd216b8bdf9","131689d75e1d5910349cc779eb365ac2b0e000959cd1cac1073e3d5a3fae4cb2","60855815f363a59c4fbd1ab852e8fcd499f0daed99fc8cd4b3d6766f197a175c","2d3b6b4929873bf630bfed2fe195c31369f72712896cb04ec8e0ed51cfc76ada","ef31fecfd8bff6841877c7b5c5c2ad54e5b740d0676ec145ec0f4090b4c246fa","cc467ab3883a977a0feadf6a5ef6871f6176dc07631b2d90c59f378db842f790","8031c729da0b7be4a0b21fdbecb5026bc8465b2acc222e31a4b494b13614cc2b","29694f74aba2522d5f54fa4467aeb4d7b54de661eefd85b646000e74627fdece","989a01a2e0432c7a1d32a4b7ef38f4a49b42dc598a62b5d212cc11984f7704c7","0c6e046a0cded35b99aa779366a990b05e432b39ee4a5bc93a0322a3c20bcd71"],"paragraph_range_zero_based":[576,599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p576"}
{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RAN-NotificationAreaInfo field descriptions","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"cellList","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"A list of cells configured as RAN area.","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"ran-AreaConfigList","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"A list of RAN area codes or RA code(s) as RAN area.","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaConfig field descriptions","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-Area belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-Area always belongs to the registered SNPN).","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"ran-AreaCodeList","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"The total number of RAN-AreaCodes of all PLMNs does not exceed 32.","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"ran-Area","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"Indicates whether TA code(s) or RAN area code(s) are used for the RAN notification area. The network uses only TA code(s) or both TA code(s) and RAN area code(s) to configure a UE. The total number of TACs across all PLMNs does not exceed 16.","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"PLMN-RAN-AreaCell field descriptions","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"PLMN Identity to which the cells in ran-AreaCells belong. If the field is absent the UE not in SNPN access mode uses the ID of the registered PLMN. This field is not included for UE in SNPN access mode (for UE in SNPN access mode the ran-AreaCells always belongs to the registered SNPN).","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"ran-AreaCells","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"The total number of cells of all PLMNs does not exceed 32.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"SDT-Config field descriptions","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"sdt-DRB-ContinueROHC","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity of the radio bearers configured for SDT continues or resets the ROHC header compression protocol during PDCP re-establishment during SDT procedure, as specified in TS 38.323 [5]. Value cell indicates that ROHC header compression continues when the UE resumes for SDT in the same cell as the PCell when the RRCRelease message was received. Value rna indicates that ROHC header compression continues when the UE resumes for SDT in a cell belonging to the same RNA as the PCell where the RRCRelease message was received. If the field is absent, the UE releases any stored value for this field and the PDCP entity of the radio bearers configured for SDT always resets the ROHC header compression protocol during PDCP re-establishment when SDT procedure is initiated, as specified in TS 38.323 [5].","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"sdt-DRB-List","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["2502f47b34c2d8b3158c2b0945e19cf93ab4aba03cc97ee572e23fd39009857d","2665816d69a36958fd1ad28662d1f1fcb837de5deee134ecf8b1c9dce1c803c5","eb6eb1023cdadad8489cc0508848b50de2e2f7aec7df3c08d6593ff2e1f9f530","ba76e9523327028a868aa0bda5ab855a3a92321474a262cdade7645dddea0ecc","1a0be1b2dcc68ba637ab69f94ddeba93ee7970f45796eb605c4d83960ba729bc","ae7cf7b6a9d40c6dbe3c2809453cba5547c1f2ba4c2ff831a81f2c91a6b68d14","d6acc18325c82cd5e3948c57e7dfa787a73397d1717db354b4ca30b07b27a1f1","90df398ddeb20d71785b6be62ec7747344ea7069da11bee3d214768739bd6dcf","95d95d8b71cec5d853a7f77bbe8f300548e9265c5a5266bb2eb191df0add37de","f797fc3d5b2de30d38383d757810d9924dbdcb5be410fa0d7e83393bb195f12f","9412c1e66d0a02a9b4af0339b0786abd03b5f73f5bed5d5d18bbd4a84feffe3d","a1ec06cb98bca5ab7ff65aa5deccd55ec3116c34b70652199c45b48d09510138","640d36a6365ba198dbc83bcad6e88167e35f1080979fd45040ee1c450dd9b0fe","fce41b18eb1043572c4e080d26dada5a004596717d17f9ae8e229ee1b60d4a2e","8e911fbf3acd7869d1e1f1d240eb0bc7f010e8274c2fd75e58a7de8ab20af781","82bf5d34aefaf1f08bacf989401fc3d61e9bc5c863145eee669e68d12583bb31","2cf1dd1b769597487136449676417856f0cee85f9a8ed96cacac0664584d1a1e","12dfa15e9d78c4f92f5e22453559de46e510b7ccdb9dd6942787d66064350e85","b75ded31eb496646d91182f46b679c09936a5266527053ce05e6fe4842196266","ea187f0e8721c7ba7448ecc003327b82a5e396b0c1a4d93037f94ce73d066c5a","5c021fa0da699625669c709fef42c6167e27455aa4b6d381c3b74f56731f99ff","80ac77af155554f0d9546f26667e7d207231ca63b4fd2d00709de922f99f1882","82a6de5bac6fc15f42f27fc75897ef045adb2c029252f4cb30c16d1c8b99cc78","00f441dd8611f36e49f7175f95010a9649b89b52c6b19773ed4e08ef6e254651"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p600"}
{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the ID(s) of the DRB(s) that are configured for SDT. If size of the sequence is zero, then the UE assumes that none of the DRBs are configured for SDT. The network only configures MN terminated MCG bearers for SDT.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"sdt-SRB2-Indication","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"Indiates whether SRB2 is configured for SDT or not.","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"SDT-MAC-PHY-CG-Config field descriptions","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-DL","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"Downlink BWP configuration for CG-SDT. If a UE is a RedCap UE and if the initialDownlinkBWP-RedCap is configured in downlinkConfigCommon in SIB1, this field is configured for initialDownlinkBWP-RedCap, otherwise it is configured for initialDownlinkBWP.","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-NUL","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on NUL carrier. If a UE is a RedCap UE and if the initialUplinkBWP-RedCap is configured in uplinkConfigCommon in SIB1, this field is configured for initialUplinkBWP-RedCap, otherwise it is configured for initialUplinkBWP for NUL.","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"cg-SDT-ConfigInitialBWP-SUL","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"UL BWP configuration for CG-SDT on SUL carrier configured for the initialUplinkBWP for SUL.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"cg-SDT-CS-RNTI","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"The CS-RNTI value for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ThresholdSSB","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"An RSRP threshold configured for SSB selection for CG-SDT as specified in TS 38.321 [3].","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"cg-SDT-TA-ValidationConfig","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"Configuration for the RSRP based TA validation. If this field is not configured, then the UE does not perform RSRP based TA validation.","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"cg-SDT-timeAlignmentTimer","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"TAT value for CG-SDT as specified in TS 38.321 [3]. The network always configures this field when sdt-MAC-PHY-CG-Config is configured.","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"CG-SDT-ConfigLCH-Restriction field descriptions","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant for CG-SDT. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated CG-SDT configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any CG-SDT configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any CG-SDT configured grant configurations. If the field configuredGrantType1Allowed is present, only those CG-SDT configured grant type 1 configurations indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any CG-SDT configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["6cfe3d180ddebf1279f540c3e24d6fa457c4efcb9a94bdec17976b2ff8e28c1e","b8165bb9ed965beda1b13f82ab6e10ffcf6c6b8cbf075ce41b43281677badbbf","80f7392dc6c830882edad6cb6dbbbcf52a8cbff91b054eb71269c32fedce7213","221d71787ca282ee56d559394974e4553b91fdc75ce0f57dccdd1d9bd6d70a35","17997f62d2e14c3a6f4bf3d076fc37c5ba09f113981bac64ccfd671d269d8545","9146e285d2f5d65c7191bb0faff1c603aac17a2eb62cd79c7ca3a16bd95487c8","bd533d433c62c8bbd657b737624189da48263e9d38da92c0ee7aebd088453862","03db60f46e2971014811243939c3faef1dba0a577c033fc27a9487a4d36ef228","ed3fc8817f0c34867a3f650b1ad18efbbaa1fb201372dd3041e34fce8936566c","fb25ab9b5a7f99eeed0a8d06e55bc3bab5df14dfa7c66d6768e60ecea3c1f7d6","6abbd11c4b383d479b313350844b2108cd7708d41d3137fe5bffa284d7a641cb","6c316a74281c1d7fd0a54dc57419ab362fdb648974dd2814c722db049fb5f964","5d999e82640c0419cee1810c988a315c3c428f1497b251eb6cf57782136ef071","2b0972defdcf060a80b80a1b132b33b4bd81519dd5c009a09a5116a619d2af65","f7df200a64a92a70e2394186f2cf42657ffc0d3cd199836f3c5c794593a1f86a","cf51ffe7311ae2d39d87d0612bf4e20bfbfe1532f30c02215c43aabe8ca36380","06c189133e4b99d790b873801565d5552e79e9a5b7853a0f8e4567c2c9cc1ae5","b01d84711f34a4b48cb9510b10d5ae3d50fc8020583f81df88ec219c309b9ae9","10bd0434e7266cd5dddf2157e6c7d475299564927bdef99cf92150a2c162818c","7e6b2f27f043d376df6e1511893dbf84c8fe5952b50cd6169ffe865c2132a8cc","ecb6079a5a7f91f40631a45693dd14bb7b0695298642c30624718262e64df42b","64ba9169b9a5c1c4026928a51e3dbd15a5719195e7a06e6769290c67ac4e1b22","87552fc382927e457459d7c4041f57d2fa7182bc3a1ec5b21d48618352232b28","5df89ef8e027297848277520b1cb51dd0c1c03a16845795bc455efd56fe0370b"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p624"}
{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1 for CG-SDT. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1 for CG-SDT. Corresponds to \"configuredGrantType1Allowed\" in TS 38.321 [3].","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer associated with a servedRadioBearer configured for SDT.","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"CG-SDT-TA-ValidationConfig field descriptions","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"cg-SDT-RSRP-ChangeThreshold","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"The RSRP threshold for TA validation for CG-SDT as specified in TS 38.321 [3]. Value dB2 corresponds to 2 dB, value dB4 corresponds to 4 dB and so on.","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"SRS-PosRRC-InactiveConfig field descriptions","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"bwp-NUL","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Normal Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"bwp-SUL","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"BWP configuration for SRS for Positioning during the RRC_INACTIVE state in Supplementary Uplink Carrier. If the field is absent UE is configured with an SRS for Positioning associated with the initial UL BWP and transmitted, during the RRC_INACTIVE state, inside the initial UL BWP with the same CP and SCS as configured for initial UL BWP.","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-RSRP-ChangeThreshold","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"RSRP threshold for the increase/decrease of RSRP for time alignment validation as specified in TS 38.321 [3].","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"inactivePosSRS-TimeAlignmentTimer","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"TAT value for SRS for positioning transmission during RRC_INACTIVE state as specified in TS 38.321 [3]. The network always configures this field when srs-PosRRC-Inactive is configured.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"srs-PosConfigNUL","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Normal Uplink Carrier.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"srs-PosConfigSUL","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"SRS for Positioning configuration in RRC_INACTIVE state in Supplementary Uplink Carrier.","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"SuspendConfig field descriptions","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"ncd-SSB-RedCapInitialBWP-SDT","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["b8e2dadde30cac9946e43d366dbf70df5278770393069e312373e52e24fe7109","8a30a1998aff0e8295b53087e02db0700db6ab5b768c0e61f5c87c45696918cb","e2dc24c2b7ba6ce5cbe6eab5230d56288b4f545d4907439815c8289423e146f6","0fedd07d62f90108b69da97a98eedf5068c2168475ab28ae05f994c8e265ba1a","84af8d7d90dd1baf64be1e81634cdfe8be603ab682a24bbc928586208b747985","4422ae0bd3993a73381c9321b05406200d8f142fab85e7b3ff23a5180dd5f9a8","7693981b5208d7915999f454caa75f595976ef9c3e0cf00cb9ecc5aee0bed956","f2cba173436204d2a7ea1964cf290720272733f24f3cc52e94e69e2a3226898f","c2c13eed6afdaddc4e2aec2f8ac122cc4b450987b51f92f7ade167219686c7a4","baea8bd969078a1b3156ae65339975293afc70284fa03a82023fd9b7c126c093","695feb3aeff18f61d4cbeb4d5db55f58629f511be62451225f44f2adeb7f0371","702a1dd3bf44d2f9248738230f85bb2b94651da73d49e200097f5e6b405267d0","dd0d14b6ecbf994dcaa5c4fb80124930a7d3ce5305ff137ca7298daa4696137a","c3bb65be8241579577369fbe4eea0730bd23c50db8b45731015499cf1107ce5d","4fedb1888af00f2017878ee43b6f7da7aa3f54da20240dea3be6e2232b6e0037","54f72c4ab0364bc196f775ab9f17bd14dbaacf7ca5ff1b0f00822678f453b491","3a4dca33cf769ff9b411f37bb53d449a570012facc75afce80f0997871b855dc","d7609ed4246a44ce787f31f5724cc77bd410c17fa940ef17f930d023d2bc76c0","ea40745f5c8c41b955c0e581ac3edb8f95301ebdc6c660c50afc77d5f689f956","3085525b1478f9624c4280383d466d71b213e2a6a258fb4f02ad26b4d29a59cd","d23c46eb472af1c999ab234736eae8ebdd04fb43fe1b5c5ef1e953288ee012a5","0e2325c22b608b33f2aff0d3f34d1eb289e5859a5fcea2daf1e023f1f4de1b92","0022e0832975cef88949adb821e41cb01bb6dcd4110e29e5e45efeb0312f0eba","87109320894043966ba96e45aa62d2e7ca8026ed67683f4d372e158ecae66b12"],"paragraph_range_zero_based":[648,671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p648"}
{"fields":{"filename":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the UE uses the RedCap-specific initial DL BWP associated with the NCD-SSB for SDT. The network configures this field if a RedCap UE is configured with SDT in the RedCap-specific initial DL BWP not associated with CD-SSB. If configured, the NCD-SSB indicated by this field can only be used during the SDT procedure for CG-SDT or RA-SDT.","paragraph_zero_based":672},{"literal_text_all_w_t_and_m_t":"ran-ExtendedPagingCycle","paragraph_zero_based":673},{"literal_text_all_w_t_and_m_t":"The extended DRX (eDRX) cycle for RAN-initiated paging to be applied by the UE. Value rf256 corresponds to 256 radio frames, value rf512 corresponds to 512 radio frames and so on. Value of the field indicates an eDRX cycle which is shorter or equal to the IDLE mode eDRX cycle configured for the UE.","paragraph_zero_based":674},{"literal_text_all_w_t_and_m_t":"ran-NotificationAreaInfo","paragraph_zero_based":675},{"literal_text_all_w_t_and_m_t":"Network ensures that the UE in RRC_INACTIVE always has a valid ran-NotificationAreaInfo.","paragraph_zero_based":676},{"literal_text_all_w_t_and_m_t":"ran-PagingCycle","paragraph_zero_based":677},{"literal_text_all_w_t_and_m_t":"Refers to the UE specific cycle for RAN-initiated paging. Value rf32 corresponds to 32 radio frames, value rf64 corresponds to 64 radio frames and so on.","paragraph_zero_based":678},{"literal_text_all_w_t_and_m_t":"resumeIndication","paragraph_zero_based":679},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall trigger the RRC connection resume procedure immediately after receiving this RRCRelease message. The network only includes this field in the RRCRelease message used to terminate an ongoing SDT procedure.","paragraph_zero_based":680},{"literal_text_all_w_t_and_m_t":"sl-UEIdentityRemote","paragraph_zero_based":681},{"literal_text_all_w_t_and_m_t":"Indicates the C-RNTI to the L2 U2N Remote UE.","paragraph_zero_based":682},{"literal_text_all_w_t_and_m_t":"t380","paragraph_zero_based":683},{"literal_text_all_w_t_and_m_t":"Refers to the timer that triggers the periodic RNAU procedure in UE. Value min5 corresponds to 5 minutes, value min10 corresponds to 10 minutes and so on.","paragraph_zero_based":684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":685},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":686},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":687},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":688},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE's RNAU; otherwise it is absent.","paragraph_zero_based":689},{"literal_text_all_w_t_and_m_t":"RANPaging","paragraph_zero_based":690},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if the UE is configured with IDLE eDRX, see TS 24.501 [23]; otherwise the field is not present.","paragraph_zero_based":691},{"literal_text_all_w_t_and_m_t":"Redirection2","paragraph_zero_based":692},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if redirectedCarrierInfo is included; otherwise the field is not present.","paragraph_zero_based":693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":694}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"605f5556d4559c377af37734d128f90e6b23a50bfa171827ed70fbcc25e634bc","original_member_sha256":"c2bda6ec6791c373934daad8eb9bc8cda1172d062407a896f6ea0f18f8edff12","paragraph_ElementTree_utf8_XML_sha256":["e9118c2ff546d2e7e0c19c888d4aae9024d30d6b86f3bf3432675ee4ab39435e","1279fdb733fba50be37fbc64dc2e885c2dd9037439350bcb4876875e4c22e36e","f3d7fb2e8a8a8c0530270359e217f51b0fbfe7c3c8e95f1f2dac362e50e423bb","6f1adad9a411a6aa5bb42b7ec14bd4f534cb4ffa08e38a573d771d681433ca35","ba53113de3e2740999a2b425b257de4998e08be422bd303f6e3e73f9c290c2e9","97ae51ec30de3d5769f2a36d0d54d1a32df454d3f6d9d5a78e1b44b50a27a3ea","aaf6c97d6829775eaaec0b9e0dc01072a494ff16cb4d5846d4e9f3544c166cd3","37eda372147f79bcee56e80bb6552622097f7a4f2678fd778c3d1d7e2073cb8f","cc19e53f9f97bad0d17edb485c0f5e256535f83f12bd62471b5069db4e2596cd","447a1e897bcba91d06db12c7fbaac24905f641ba8e8c2c899efe68f5567ffdeb","03ef7e2bb4d5222934cf42bc690e68cad1b2ead800a092dd4cf29a6dc1e2f3ce","94545e05e54d31bfecc8e50bcbc850019ee2a90d42a2807e95630ef0a670b9ba","1a97383d39a02cca48bdfd337fc01f571a893fe82b4cae30ae59410fc2f6f7f7","3b301e078aa01bfa25e5bc030f43ae98f31236d436092d72b81d47138e364128","28b1352aa1ca840219b98b45771b091052172e69c625eff7e46c68347dcd51af","2224b5e33e40a5651089b628d2fc9e464faf28c6bead2d433e7075d50facb170","8accb03a347b04c69df4bf06acfb6a9416f066ed1d10d9c16bde299473791b76","3e42bfa017540736931abd5369683eedc842ad3436d27937c0af0db3c707615e","0af337884f2820efad51bf7095618fc06bcb6c25e4d27adfcb4a7c6fe4d00794","5e17a1eb4b93f18137d12775aa4279e5213167e5e2c0eabd9c0f883a6dedba02","5aca1fba66a0db41cc08bc34fc604602cb670bb7ff51c165977baf4422631cff","9a41479e7f1ca584ce1b7e65d8c9afc50f084dc6aafc1adaf291d145cb3ac652","197c5e8fc2b6960fe719d4710e48532f5824b9c1fa1eb08585b59744ea11230b"],"paragraph_range_zero_based":[672,694],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312597.zip::R2-2312597 TEI18 SDT_ReleaseEnh 38331 CR.docx:p672"}
