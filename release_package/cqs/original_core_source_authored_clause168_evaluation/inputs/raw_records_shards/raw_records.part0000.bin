{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-PSSCH-TxConfigList indicates PSSCH transmission parameters. When lower layers select parameters from the range indicated in IE SL-PSSCH-TxConfigList, the UE considers both configurations in IE SL-PSSCH-TxConfigList and the CBR-dependent configurations represented in IE SL-CBR-PriorityTxConfigList. Only one IE SL-PSSCH-TxConfig is provided per SL-TypeTxSync.","paragraph_zero_based":38664},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList information element","paragraph_zero_based":38665},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38666},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-START","paragraph_zero_based":38667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38668},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList-r16 ::=    SEQUENCE (SIZE (1..maxPSSCH-TxConfig-r16)) OF SL-PSSCH-TxConfig-r16","paragraph_zero_based":38669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38670},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfig-r16 ::=        SEQUENCE {","paragraph_zero_based":38671},{"literal_text_all_w_t_and_m_t":"    sl-TypeTxSync-r16                SL-TypeTxSync-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":38672},{"literal_text_all_w_t_and_m_t":"    sl-ThresUE-Speed-r16             ENUMERATED {kmph60, kmph80, kmph100, kmph120,","paragraph_zero_based":38673},{"literal_text_all_w_t_and_m_t":"                                                kmph140, kmph160, kmph180, kmph200},","paragraph_zero_based":38674},{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-r16      SL-PSSCH-TxParameters-r16,","paragraph_zero_based":38675},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-r16      SL-PSSCH-TxParameters-r16,","paragraph_zero_based":38676},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":38677},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":38678},{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":38679},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL     -- Need R","paragraph_zero_based":38680},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":38681},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38684},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxParameters-r16 ::=    SEQUENCE {","paragraph_zero_based":38685},{"literal_text_all_w_t_and_m_t":"    sl-MinMCS-PSSCH-r16              INTEGER (0..27),","paragraph_zero_based":38686},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16              INTEGER (0..31),","paragraph_zero_based":38687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c5f9a0375de71500aada2007cbabdef77af60de7e41e33068eebc6b77d2a8129","7f6d79011bddde488efff5ab4d97b6269d23ebe047f18392a11cff5eaa7ead37","cd549e3f255e87e0cd4b32645c83f53b06868ae1800f859418ff2743b0360f3a","a96cb8101203c78efb408442301d71148021d8ca73ca15a3e2f72327696c0808","0722e56b8aa2f596767807c0fb40ff07378cbbd2c2c20e27be46a399a254f2ba","669f26015dbc79e7c8b83bc608f8713a1a1ec062fd18326f54ac088ee37f637c","db11f75c976e14b357e3e18268e109f8ea5c2c672050d81f147dd01b40b3fd37","96bc2554b3f2a1ce749ca9ebae7c9e0ee9e68d844adcea3126142bc614f4c463","ac1e2fcd807ff0fe930d54f4e6e884f8ae3f9e427bab870518eab838596b66d7","28126669b6358c283211b386a869158972ebf60d8018372da305a1ffb49c5c9e","bd0852472e1ff4dc0fd4ed217f3118c264d74dd714256f7540ec8dee40317f7b","410566ed0436c1013594a094f649f0b8798f48f7802494956840196fea36a822","d71d624af087bdc4474530087aed99e2fb418700088eae82382129ddb3365574","7b1828c630abf147e096119457073c7d22c1b23501490810fb039206b2343666","ef19f3918d3bd743ef01616152ee5e7ad25cf8405ef1b54b519fe3b87c108bbf","64dd540f590d93c61cceda3f1e1be93f67281777e54da8704ea7a39fe0c56852","6f97bf220b649918485a732b7ac7196a650287884ba708f36f3937eeda6861bd","9d6a3c113cba1246d377ba23aa94192ff7c0146448774ddd0ed0a743a3e18597","206068a6c78a8ab24044225420503ea1dae460f119cc42d9141b52c6cf71ecc7","8c26fa34f83f652958704de91ed7ca4606b8aed14af6871f1afed41eeb971d34","bcc31d2d16bff7ce64c671c759a69b0eb2fbeb5b6d285433f7222131328b190d","bc4088c1657b85a8e8804445dda325fb8b2223ada04f455392e493e30075ab1c","59049cc42b4c634ff7b74b622c96e144d5dd897f594a57f76c16bdcd8a10d728","bc8aa01936616e7f96016d1110782dfa7fcf974fde54f126045601ff446b6a43"],"paragraph_range_zero_based":[38664,38687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p38664"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-MinSubChannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":38688},{"literal_text_all_w_t_and_m_t":"    sl-MaxSubchannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":38689},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxTransNumPSSCH-r16        INTEGER (1..32),","paragraph_zero_based":38690},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxPower-r16                SL-TxPower-r16                                      OPTIONAL    -- Cond CBR","paragraph_zero_based":38691},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38693},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-STOP","paragraph_zero_based":38694},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38695},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38696},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList field descriptions","paragraph_zero_based":38697},{"literal_text_all_w_t_and_m_t":"sl-MaxTxTransNumPSSCH","paragraph_zero_based":38698},{"literal_text_all_w_t_and_m_t":"Indicates the maximum transmission number (including new transmission and retransmission) for PSSCH.","paragraph_zero_based":38699},{"literal_text_all_w_t_and_m_t":"sl-MaxTxPower","paragraph_zero_based":38700},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum transmission power for transmission on PSSCH and PSCCH.","paragraph_zero_based":38701},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH, sl-MaxMCS-PSSCH","paragraph_zero_based":38702},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum MCS values used for transmissions on PSSCH. The UE shall ignore the minimum and maximum MCS values used for the associated MCS table(s) in sl-ParametersAboveThres-r16 and sl-ParametersBelowThres-r16 if sl-ParametersAboveThres-v1650 and sl-ParametersBelowThres-v1650 are present, respectively.","paragraph_zero_based":38703},{"literal_text_all_w_t_and_m_t":"sl-MinSubChannelNumPSSCH, sl-MaxSubChannelNumPSSCH","paragraph_zero_based":38704},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum number of sub-channels which may be used for transmissions on PSSCH.","paragraph_zero_based":38705},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSync","paragraph_zero_based":38706},{"literal_text_all_w_t_and_m_t":"This field indicates the synchronization reference type. For configurations by the eNB/gNB, only gnbEnb can be configured; and for pre-configuration or when this field is absent, the configuration is applicable for all synchronization reference types. ","paragraph_zero_based":38707},{"literal_text_all_w_t_and_m_t":"sl-ThresUE-Speed","paragraph_zero_based":38708},{"literal_text_all_w_t_and_m_t":"This field indicates a UE absolute speed threshold.","paragraph_zero_based":38709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38710},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":38711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["05f828642d8048a877c5883720b2cf2949e35b356668aa6de6cac90bf675071d","9ca2ce035f4332ed57599a46a82d8775e8aeed08e907336064e2bc2d475b8fa0","6528b476f4b2763123ef745741819c3306a83c30bcf1e8e765175524875e2f35","ec087747dce22f9374569f7096cfdf1e5776c0ba6c756f25b0d2a33f7e4d0b39","d0068099544bbcc999feb5b18535aef1572b91d6123579523eecc2ba2a5f63a7","32b3b1f7655b315e8fca8972578b2715935f9d35546078fbe7e608a8a7f4eea6","334632042ae4e6b042a6969b64f9338cfa2a02ba787d5