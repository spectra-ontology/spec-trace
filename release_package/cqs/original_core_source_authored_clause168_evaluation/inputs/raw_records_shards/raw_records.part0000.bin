{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1700-IEs                                             OPTIONAL","paragraph_zero_based":10704},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10706},{"literal_text_all_w_t_and_m_t":"RRCResume-v1700-IEs ::=             SEQUENCE {","paragraph_zero_based":10707},{"literal_text_all_w_t_and_m_t":"    sl-ConfigDedicatedNR-r17            SetupRelease {SL-ConfigDedicatedNR-r16}                         OPTIONAL, -- Cond L2RemoteUE","paragraph_zero_based":10708},{"literal_text_all_w_t_and_m_t":"    sl-L2RemoteUE-Config-r17            SetupRelease {SL-L2RemoteUE-Config-r17}                         OPTIONAL, -- Cond L2RemoteUE","paragraph_zero_based":10709},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigNR-r17         SetupRelease {NeedForGapNCSG-ConfigNR-r17}                      OPTIONAL, -- Need M","paragraph_zero_based":10710},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigEUTRA-r17      SetupRelease {NeedForGapNCSG-ConfigEUTRA-r17}                   OPTIONAL, -- Need M","paragraph_zero_based":10711},{"literal_text_all_w_t_and_m_t":"    scg-State-r17                       ENUMERATED {deactivated}                                        OPTIONAL, -- Need N","paragraph_zero_based":10712},{"literal_text_all_w_t_and_m_t":"    appLayerMeasConfig-r17              AppLayerMeasConfig-r17                                          OPTIONAL, -- Need M","paragraph_zero_based":10713},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                                                     OPTIONAL","paragraph_zero_based":10714},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10716},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-STOP","paragraph_zero_based":10717},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":10718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10719},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs field descriptions","paragraph_zero_based":10720},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":10721},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access.","paragraph_zero_based":10722},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementReq","paragraph_zero_based":10723},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the idle/inactive measurements, if available, to the network in the RRCResumeComplete message","paragraph_zero_based":10724},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":10725},{"literal_text_all_w_t_and_m_t":"Configuration of the master cell group.","paragraph_zero_based":10726},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":10727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b17039eb8f687de3ace7ebe8ba10fd75bcac96d8bb85f2d828735856481833d3","1e713497d1bc0442efb63cdd314ab5ab0a699a605218a06dc05d0454c23ebd99","f37b3efc3296aa8ba32c7658445de66352fff949c41810998944fab2b776313d","3320f5f71f410abfe956761c50c19c291d647c92029ad76f0c9dc524d44cb5fb","d6d931f67f12df276fcb7f35d659c4694574631758f0f4afe46764b17cda1efb","5dbce43208aaca9840b048b655a7d7b25f8225d3293fc4ed92e1bebaeba9d451","93894fc009d3f65a4e4ef32ccbfe58a1b2e0cc1651b3e72001468d178b285259","497ca035715d7acb028228062e1fd62c09bef2708fecb4e16e8566ed3cd06711","ffabd9c4228afabb2f0270d500f997fcf68fe54e30767fd5ecfae258ec71eb5e","2e8f661f5cbd9050736ba5824be0b062ad50ea5c51da08e0d0a911c63c956478","71d1925b38ab2a6af1bc716126906767fc72c85c39f169f2e860e4433859d894","49392a9cbf01bdc5fd41b0bbe56ecf6636cb493fb0fb18617c37502fa6bd85d5","0e3254c6bd1178c58228f00e6f6ffa1230531accc3a1d1c9d749c69d7daf091a","887af96bf563278416333aa90e582b1adf086141b97025dbbe0698eed1518cc0","41964103291d0bb0eb22a31ae843cba96a14dbc66e3dbcf55c86323fbc758ab6","322fa00531a0395d4ba222e6048f448b21ca7920c210142b7468675310a26943","afed36ccf440b0fc78be13fe24e4f14821715af0a750f4664427940abe59bfa6","45b6e8e0d8b3ccd84fb995c8e9ce42e15b7a4c7ef10fed53490ec437690dc35c","f50d026f777ccb01377f211d4af31f75ea3d587e7e3cc9a4f06566028126b52b","a2018e89d02c6794b152bf440b7ab20e4ab76bc30e98930b5ab3fca90889eff3","bc3645b0d04cfb914168bd48443a80e62d18b06db650dcd6a252c5e003c8ab8e","06941d126bb0881b15642b3bb17d5cce3fd73e81cd82b17c59c69e4d212897ee","49f84fc554a6ebb51e4a636c64dab5da17bfccceb2da3c97f2b73ae52f5a2b84","c360f691e37b97a5b28435028a789da3715de24b9f02bd0d6505742ab58739ad"],"paragraph_range_zero_based":[10704,10727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p10704"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.","paragraph_zero_based":10728},{"literal_text_all_w_t_and_m_t":"For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup (with at least reconfigurationWithSync), otherConfig and measConfig.","paragraph_zero_based":10729},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message only include the field scg-Configuration with at least mobilityControlInfoSCG.","paragraph_zero_based":10730},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":10731},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10732},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":10733},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10734},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":10735},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":10736},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":10737},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP.","paragraph_zero_based":10738},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":10739},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":10740},{"literal_text_all_w_t_and_m_t":"restoreMCG-SCells","paragraph_zero_based":10741},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the MCG SCells from the UE Inactive AS Context, if stored.","paragraph_zero_based":10742},{"literal_text_all_w_t_and_m_t":"restoreSCG","paragraph_zero_based":10743},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the SCG configurations from the UE Inactive AS Context, if stored.","paragraph_zero_based":10744},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":10745},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":10746},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":10747},{"literal_text_all_w_t_and_m_t":"A counter used to derive S-KgNB or S-KeNB based on the newly derived KgNB during RRC Resume. The field is only included when there is one or more RB with keyToUse set to secondary or mrdc-SecondaryCellGroup is included.","paragraph_zero_based":10748},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":10749},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery used by L2 U2N Remote UE.","paragraph_zero_based":10750},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":10751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8a