t_all_w_t_and_m_t":"all-Traffic-PrefixReq","paragraph_zero_based":9303},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for all traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9304},{"literal_text_all_w_t_and_m_t":"f1-C-Traffic-PrefixReq","paragraph_zero_based":9305},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for F1-C traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9306},{"literal_text_all_w_t_and_m_t":"f1-U-Traffic-PrefixReq","paragraph_zero_based":9307},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for F1-U traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9308},{"literal_text_all_w_t_and_m_t":"non-F1-Traffic-PrefixReq","paragraph_zero_based":9309},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for non-F1 traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02d79f3da21076912d383e0b28563ded87a75368ce70ecf79ca20c46275fb580","2fd7cb12c0898b4a031cfa232ab3f83c35cbbf374fbf4b46914992d2ded19796","7d7bcf06de05dd09d1a6ebaa7e298d5e337e628dd0f14ad728a48b707944a451","917d39bb5da2bb90063402e2656102edbc9b6cb89e611a5e549a35d27abafd18","9875f9c2e7acd36a02cecef88501c29055e93705b07525209bb970deb1c3e916","7ca1bb69dfb9ac791ec5e0955df68be726421e7f2d3f8038411bca489d8b6e3b","aeb5f2ec00a87be80bf6a74a13596cdf03dda15df26694502ee5525f3faaabc5","876b522151c9077529573763c0de514d