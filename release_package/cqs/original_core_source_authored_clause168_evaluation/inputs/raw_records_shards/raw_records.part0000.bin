{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE specific group-common PDSCH configuration for MBS multicast for one CFR.","paragraph_zero_based":15912},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToAddModList","paragraph_zero_based":15913},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations for MBS multicast.","paragraph_zero_based":15914},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToReleaseList","paragraph_zero_based":15915},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":15916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15917},{"literal_text_all_w_t_and_m_t":"–CGI-InfoEUTRA","paragraph_zero_based":15918},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoEUTRA indicates EUTRA cell access related information, which is reported by the UE as part of E-UTRA report CGI procedure.","paragraph_zero_based":15919},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRA information element","paragraph_zero_based":15920},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15921},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRA-START","paragraph_zero_based":15922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15923},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRA ::=                        SEQUENCE {","paragraph_zero_based":15924},{"literal_text_all_w_t_and_m_t":"    cgi-info-EPC                            SEQUENCE {","paragraph_zero_based":15925},{"literal_text_all_w_t_and_m_t":"            cgi-info-EPC-legacy                 CellAccessRelatedInfo-EUTRA-EPC,","paragraph_zero_based":15926},{"literal_text_all_w_t_and_m_t":"            cgi-info-EPC-list                   SEQUENCE (SIZE (1..maxPLMN)) OF CellAccessRelatedInfo-EUTRA-EPC             OPTIONAL","paragraph_zero_based":15927},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                       OPTIONAL,","paragraph_zero_based":15928},{"literal_text_all_w_t_and_m_t":"    cgi-info-5GC                            SEQUENCE (SIZE (1..maxPLMN)) OF CellAccessRelatedInfo-EUTRA-5GC             OPTIONAL,","paragraph_zero_based":15929},{"literal_text_all_w_t_and_m_t":"    freqBandIndicator                       FreqBandIndicatorEUTRA,","paragraph_zero_based":15930},{"literal_text_all_w_t_and_m_t":"    multiBandInfoList                       MultiBandInfoListEUTRA                                                      OPTIONAL,","paragraph_zero_based":15931},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorPriority               ENUMERATED {true}                                                           OPTIONAL","paragraph_zero_based":15932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15934},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRA-STOP","paragraph_zero_based":15935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8be532ee328b45d082f8b163344a796c4730980dfad2c024bdcd48aa2066f0f4","804cee71f7132ae5d9b067f010fa58894006cf27a8202ac47b6c3b3185ebc326","5b42c58d8ada2841c60ab7028c1e4e90d57be4873d3fd1053ab20404477f1546","3815012faca67897e294aad9ef95e84821d0adbfd9cca20710578a011ae2e4e7","322aaef2c380d7bbac6c68b1ad745d6c56073dda1e1f534e858ae76dc9fbc323","8404745727dd04dd411e3ddb5849caebf9ab9cb1fec7aa91d9afcc73c4fe947b","1a9819c1d200c99d190fd89ce