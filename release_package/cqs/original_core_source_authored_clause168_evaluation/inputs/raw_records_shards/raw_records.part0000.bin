SetupRelease { SL-RelayUE-Config-r17}                                  OPTIONAL, -- Cond L2RelayUE","paragraph_zero_based":2437},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-Config-r17               SetupRelease { SL-RemoteUE-Config-r17}                                 OPTIONAL  -- Cond L2RemoteUE","paragraph_zero_based":2438},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2439},{"literal_text_all_w_t_and_m_t":"SL-DiscConfig-v18xy ::=   SEQUENCE {","paragraph_zero_based":2440},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-ConfigU2U-r18   SetupRelease { SL-RelayUE-ConfigU2U-r18}                                  OPTIONAL, -- Cond U2URelayUE","paragraph_zero_based":2441},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ConfigU2U-r18  SetupRelease { SL-RemoteUE-ConfigU2U-r18}                                  OPTIONAL -- Cond U2URemoteUE","paragraph_zero_based":2442},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2445},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-STOP","paragraph_zero_based":2446},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["d327ec33601b88fbb827189199f3c964ac91793efa299e5def6e92d49761f410","81e758ba2dd43532a714749f41aeb2217f57d8b2db0293a4b023ed5602e75633","41e72e99ef68099ed4b4a33cc3218591dc3d095c7c53cc1a2e92cb8ec6d2ff7c","72bafe5d39f1f56399f85d319867bf7b9e6052dfa177ba5f3e96fa310f0f4579","a6343749e76c1ee1978bc109628e88aed7a45341655fc2b4bf698f27714651c3","60ca494a13f0815df7613be882135a16d26b68892c30535b724f8f