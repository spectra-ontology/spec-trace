,"paragraph_zero_based":25455},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToAddModList-r17        SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-r17","paragraph_zero_based":25456},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25457},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToReleaseList-r17       SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-Id-r17","paragraph_zero_based":25458},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":25459},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount-r17     ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                              OPTIONAL, -- Need R","paragraph_zero_based":25460},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer-r17       ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}      OPTIONAL, -- Need R","paragraph_zero_based":25461},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25462},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7228b0ab63e293dafa1153c44393904edf98b51ffb5b6b393f2a487ac4cb87ad","13191a8d2371ae605e28698efb433916c078d0b3c761c4cb6e2f596bcd4c6bb1","78fd41f7bb5d53d29fe65350d59a1647b1d8552bc3944c939ce575248e6583ca","61f6ee35110a4c0a9ba5815da52fddd39150d6d1fd3f9d4aae5ce42636c746df","1ec7328f25ed6397d69070382cc95c5b5116b1aeb262ccce4854