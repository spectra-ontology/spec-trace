{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates supported SRS resources for SRS carrier switching to the band associated with this FeatureSetDownlink. The UE is only allowed to set this field for a band with associated FeatureSetUplinkId set to 0.","paragraph_zero_based":32352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32353},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkId","paragraph_zero_based":32354},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkId identifies a downlink feature set. The FeatureSetDownlinkId of a FeatureSetDownlink is the index position of the FeatureSetDownlink in the featureSetsDownlink list in the FeatureSets IE. The first element in that list is referred to by FeatureSetDownlinkId = 1. The FeatureSetDownlinkId=0 is not used by an actual FeatureSetDownlink but means that the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":32355},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId information element","paragraph_zero_based":32356},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32357},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-START","paragraph_zero_based":32358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32359},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId ::=            INTEGER (0..maxDownlinkFeatureSets)","paragraph_zero_based":32360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32361},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-STOP","paragraph_zero_based":32362},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32364},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkPerCC","paragraph_zero_based":32365},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkPerCC indicates a set of features that the UE supports on the corresponding carrier of one band entry of a band combination.","paragraph_zero_based":32366},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC information element","paragraph_zero_based":32367},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32368},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-START","paragraph_zero_based":32369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32370},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC ::=         SEQUENCE {","paragraph_zero_based":32371},{"literal_text_all_w_t_and_m_t":"    supportedSubcarrierSpacingDL        SubcarrierSpacing,","paragraph_zero_based":32372},{"literal_text_all_w_t_and_m_t":"    supportedBandwidthDL                SupportedBandwidth,","paragraph_zero_based":32373},{"literal_text_all_w_t_and_m_t":"    channelBW-90mhz                     ENUMERATED {supported}                                                  OPTIONAL,","paragraph_zero_based":32374},{"literal_text_all_w_t_and_m_t":"    maxNumberMIMO-LayersPDSCH           MIMO-LayersDL                                                           OPTIONAL,","paragraph_zero_based":32375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["48c56fb93d94c4f0c2f0a69d832102cdfd55522debd569dcbc422f208de2bca0","d01d9cef6015f83d39daf02bb1a387bc4090ffa3023408c1fd6cc9fb83984124","86351e42b174707defca7e824651b23c87c1e40db087fb29bdae9de50a17fded","cf55ca7331e7c114e042ec4acaa09ea32329f1ff515f36d41df3c5162b0dca8f","c29c9a7d90c2b199f00b6ca433dff9f3351a2558167fd8fcfe8106d28e58558f","852c6a562a6e3ba95e622e68388c0eb