312091afdbd337fae152f3f1c0b02352531bc3861608b7c979b251b2fb","original_member_sha256":"b3df9986f1e1a65783802fcbb0669622197de3c478bf2a552b18a00d8e64775d","paragraph_ElementTree_utf8_XML_sha256":["898cafe81aeeb040f0d805d84c06bd044bbb0237a59094097d7706d429f5fb76","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","47ea09d621e18c4c086affa55a968f053a01e23f18425a691f5870c27e1f2080","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","960ac6d94bee5f9a6126140445c39ade7a112390a900aab49af0df1baecbb970","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","fa06d3bcc3f260e2e2b739603e629a81a62b1713751b69816a05315d148a7456","89311a554fa959513908dc16897b6a0e484425ad9b68ee6af262091501814623","139f295b4e9a30db75f113f5ad4458fde5cdb6907a7ecc1a18767d4e6febb607","c8598ea241255a86cb18780d409012e770a5c01f2cdd36626f38575877b01a7a","a12902e1c99250b9cc1eb3c1869f285694f2c55082e2e8f7e180c42ecb8eb05a","0cf13c5564d9445f10c16a99cbbf61897f2729d775c0e99317a448d77b12b146","583d3dc451e671aa06ab4784edcb8ce8e477e1b11499c685c3adc2720bc30645","3887d16dc8d8598ebaceeb32d8dbc0655c6ba2f11836e931a433c0ea6dad47ec","f0974efa70e5750d73c704b2776f8ca4c2a185986ffedf817ee22b058384cfcd","744a314da469d85b6761bc39bec6ec69152fd5af055f756f4ac55636fa4626d0","5092eac5df92ca3219fa772e11620472410b70f6c70ee09dfd85f37706a2dc25","7645bdb059a87b3a08405bc1685a6fb34e7a4778c10164b1cf5e073876ea2a5f","ac9174fe43d8824fb9c9e05cc3935990967433a6e53de5aaed83353db29ae178","c86b9a61790baaa70c1f6d9d03a7e4447c15f1eb58f1770db204956227eeacf5","4e6a8a942d3014d7ca02bdab3e3079a9fc2e805b0b10079bbaac1169d488e730"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306535.z