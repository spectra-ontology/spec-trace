{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":10776},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10778},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete-IEs ::=               SEQUENCE {","paragraph_zero_based":10779},{"literal_text_all_w_t_and_m_t":"    dedicatedNAS-Message                    DedicatedNAS-Message                                                    OPTIONAL,","paragraph_zero_based":10780},{"literal_text_all_w_t_and_m_t":"    selectedPLMN-Identity                   INTEGER (1..maxPLMN)                                                    OPTIONAL,","paragraph_zero_based":10781},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentList               UplinkTxDirectCurrentList                                               OPTIONAL,","paragraph_zero_based":10782},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":10783},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCResumeComplete-v1610-IEs                                             OPTIONAL","paragraph_zero_based":10784},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10786},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete-v1610-IEs ::=         SEQUENCE {","paragraph_zero_based":10787},{"literal_text_all_w_t_and_m_t":"    idleMeasAvailable-r16                   ENUMERATED {true}                                                       OPTIONAL,","paragraph_zero_based":10788},{"literal_text_all_w_t_and_m_t":"    measResultIdleEUTRA-r16                 MeasResultIdleEUTRA-r16                                                 OPTIONAL,","paragraph_zero_based":10789},{"literal_text_all_w_t_and_m_t":"    measResultIdleNR-r16                    MeasResultIdleNR-r16                                                    OPTIONAL,","paragraph_zero_based":10790},{"literal_text_all_w_t_and_m_t":"    scg-Response-r16                        CHOICE {","paragraph_zero_based":10791},{"literal_text_all_w_t_and_m_t":"        nr-SCG-Response                         OCTET STRING (CONTAINING RRCReconfigurationComplete),","paragraph_zero_based":10792},{"literal_text_all_w_t_and_m_t":"        eutra-SCG-Response                      OCTET STRING","paragraph_zero_based":10793},{"literal_text_all_w_t_and_m_t":"    }                                                                                                               OPTIONAL,","paragraph_zero_based":10794},{"literal_text_all_w_t_and_m_t":"    ue-MeasurementsAvailable-r16            UE-MeasurementsAvailable-r16                                            OPTIONAL,","paragraph_zero_based":10795},{"literal_text_all_w_t_and_m_t":"    mobilityHistoryAvail-r16                ENUMERATED {true}                                                       OPTIONAL,","paragraph_zero_based":10796},{"literal_text_all_w_t_and_m_t":"    mobilityState-r16                       ENUMERATED {normal, medium, high, spare}                                OPTIONAL,","paragraph_zero_based":10797},{"literal_text_all_w_t_and_m_t":"    needForGapsInfoNR-r16                   NeedForGapsInfoNR-r16                                                   OPTIONAL,","paragraph_zero_based":10798},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    RRCResumeComplete-v1640-IEs                                             OPTIONAL","paragraph_zero_based":10799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19