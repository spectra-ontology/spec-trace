teral_text_all_w_t_and_m_t":"dopplerUncertaintyExt-r10ENUMERATED {d60,","paragraph_zero_based":1124},{"literal_text_all_w_t_and_m_t":"d80,","paragraph_zero_based":1125},{"literal_text_all_w_t_and_m_t":"d100,","paragraph_zero_based":1126},{"literal_text_all_w_t_and_m_t":"d120,","paragraph_zero_based":1127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["fcdad10a75204e1cecef01cb058357499564869fcba2519b4ee8439325305e09","400bc80cffec75a5aa858f4e901d85bca2df7a79675e0692cb5e139ac665ac54","b4c67f0335bbcf82cd632af5b8fd9d3e69e45660ec9ee9181bfd6f819ba7ef50","344b24da86f468c0e30fd671f9ea6c9afe1be2d27f3193c0d88832cb6ccd3098","199a33d03dafb15a027f436cad140a89d13f11f56bd0d1bc70ae90659fba2d1a","94cd3f1a4169f664f1b3945036ece529e3f3dc64ec22338cf44e6a75be2f4b43","158157d1291fcc07f59802acbd18a6b9bfc9470932398b86e8cbd674217b80b2","c3bc91aa817a3dca0535d7864ff300e84b23eaa440604546eb6d3be2aabbfb54","7831f9b63d12d76005fec7473c4a7831c57b5ef56edf0dff01e176d71629bf49","d6d3d981748b4a93c689e43bd9f584830a6a07363c67d1ea444b0cc45532ba55","d3867a8dd469b6b3a429a9692a4b02548ebb721a0940d6941efd7d16e44085b3","481b0221ab84652f14a57069f48156be9eb4ef200a730d9e825987b46af9de84","fc84affd61e59116fb3bfa372b411f224bcd2144d8dc0cd13926e3c56e362f2a","2d70d3450a5d6000bf5efb16ada0f63eb525b71056dbc15a3d9bd52ec221fd9e","11027e0472885bf6ac333fffcef29c29d01fe9aed354bd7e91177dd8839d2370","5fddcb2e4166a07dff0be9b348ea0fce280a8fc094dce8c549c15f3b00355a13","641391bceea9bc18a2552c21db3f274accd563ecf8bfd015cc3fa508a4034bd8","43ffb57c20cbd009a136c8ce901d29db834d72a25074d45cbe0ffbcb2da9fbaa","a87b391e96a8cb3272eb4d6ff749c90b8e3ea7024482718d3015f4ce1296ecbd","a954930ae16da2a4b0cbe917d55cb877ab5bb917babf29e93e776ecb70f87a5a","da5b1d8b941c8e19de7936fcda5d080002b27f210701b5ffb6e54fe8b29231b1","4a8fff32ac4636bad144737abae2174cad3397b98774b5b0fd6d9241ad79a99a","a183f93cc175c95d143112f12a65115d39f0b3c0f935cc3d4b869d45ddd3decc","7b31d0e6a7497cf6601cfcf021c0dc1667d517b82f18f23a17c0ac9ccc90fa89"],"paragraph_range_zero_based":[1104,1127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1104"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"noInformation, ... }OPTIONAL-- Need ON","paragraph_zero_based":1128},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1130},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1132},{"literal_text_all_w_t_and_m_t":"GNSS-AcquisitionAssistance field descriptions","paragraph_zero_based":1133},{"literal_text_all_w_t_and_m_t":"gnss-SignalID","paragraph_zero_based":1134},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS signal for which the acquisition assistance are provided.","paragraph_zero_based":1135},{"literal_text_all_w_t_and_m_t":"gnss-AcquisitionAssistList","paragraph_zero_based":1136},{"literal_text_all_w_t_and_m_t":"These fields provide a list of acquisition assistance data for each GNSS satellite.","paragraph_zero_based":1137},{"literal_text_all_w_t_and_m_t":"confidence","paragraph_zero_based":1138},{"literal_text_all_w_t_and_m_t":"This field specifies the confidence level of the reference location area or volume used to calculate the acquisition assistance parameters (search windows). A high percentage value (e.g., 98% or more) indicates to the target device that the provided search windows are reliable. The location server should include this field to indicate the confidence level of the provided information.","paragraph_zero_based":1139},{"literal_text_all_w_t_and_m_t":"svID","paragraph_zero_based":1140},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS SVID of the satellite for which the GNSS-AcquisitionAssistance is given.","paragraph_zero_based":1141},{"literal_text_all_w_t_and_m_t":"doppler0","paragraph_zero_based":1142},{"literal_text_all_w_t_and_m_t":"This field specifies the Doppler (0th order term) value. A positive value in Doppler defines the increase in satellite signal frequency due to velocity towards the target device. A negative value in Doppler defines the decrease in satellite signal frequency due to velocity away from the target device. Doppler is given in unit of m/s by multiplying the Doppler value in Hz by the nominal wavelength of the assisted signal.","paragraph_zero_based":1143},{"literal_text_all_w_t_and_m_t":"Scale factor 0.5 m/s in the range from -1024 m/s to +1023.5 m/s.","paragraph_zero_based":1144},{"literal_text_all_w_t_and_m_t":"doppler1","paragraph_zero_based":1145},{"literal_text_all_w_t_and_m_t":"This field specifies the Doppler (1st order term) value. A positive value defines the rate of increase in satellite signal frequency due to acceleration towards the target device. A negative value defines the rate of decrease in satellite signal frequency due to acceleration away from the target device.","paragraph_zero_based":1146},{"literal_text_all_w_t_and_m_t":"Scale factor 1/210 m/s2 in the range from -0.2 m/s2 to +0.1 m/s2.","paragraph_zero_based":1147},{"literal_text_all_w_t_and_m_t":"Actual value of Doppler (1st order term) is calculated as (-42 + doppler1) * 1/210 m/s2, with doppler1 in the range of 0…63.","paragraph_zero_based":1148},{"literal_text_all_w_t_and_m_t":"dopplerUncertainty","paragraph_zero_based":1149},{"literal_text_all_w_t_and_m_t":"This field specifies the Doppler uncertainty value. It is defined such that the Doppler experienced by a stationary target device is in the range [DopplerDoppler Uncertainty] to [DopplerDoppler Uncertainty]. Doppler Uncertainty is given in unit of m/s by multiplying the Doppler Uncertainty value in Hz by the nominal wavelength of the assisted signal.","paragraph_zero_based":1150},{"literal_text_all_w_t_and_m_t":"Defined values: 2.5 m/s, 5 m/s, 10 m/s, 20 m/s, 40 m/s as encoded by an integer n in the range 0-4 according to:","paragraph_zero_based":1151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["a1be6fbc7b8de20c1e507ae126496c4a485c4c423fb4d11e6ab06a909b17696e","534da6fc2a56d70522d05837272c5f73ec02c54db66b961428867d29825b5fde","e28149cb45c393ce6d50585d46abcfbf918c904b0181f6c3d08307450417b543","f73726bb239d44c84f86aea2dbe56f90dd98f858223fb70996fbd26752593006","e5132e84138930a8e846b7577ed6d6c91f05a4659b49a68ee0f57429d1c732ad","00bbb67d960eabdf9fc1f130acf196a2b179ad02bdd76ead5998a5cf5db9b75a","8372ba5adfa0925a20ce695e76da13677e9c1575057107c34f427c5e5eeb7782","f7b57bf382aa0c20d79c662f79f0ce9c51f7f3a56dfad57656cc6bb45504b916","0930d373546faab4ae905a7688adcad84ed879ccf48078c1820b550f1371443e","50cbac22ec87436d7746ca2b8c0bce2f4e97bc5239bb3843f499669c7b91e9da","9970dab6b68a40cf0e3114ae6c366f84d42273479ad172283c7dea8e2a4d810c","06272126331f7438f55304034fdbc417599ab89ca4e0a1f274fd94d6f03bc60b","152bee78b21a62e567937a2e4358eb86f25e5c861d2451b1a43bf07074df24fd","b1169ec665b90a551a880bd432db58fbe160dec7081d3674c35e3d8d3e08271c","676da38805a996ff6b16b06b6739d33a0a73d001357361a1b39b1ab8a73fdd07","ae62cf5d0564b3266844ec5bc990f5faffa579f7f619cffb2f0d76e9d91bb865","acd476035353398ab0c59580a8b3925d495cb961f3ee30adf3efd3e86a3d3fb7","27587318bc11223971103adf5e51d42f845ec0305f668354759016987bc920b9","4aebcb858afd85e104af3afd50be54205220e99fc60a9b32408d9b45b5518c51","c6fbdcf5bb58ab55828a1f231b2c92067462169d30c19314874e5edbd2d0f821","2756463e88787a55893edab66fdcca353579d61d55affa3a991db692e12d6d71","7b3bcb958e46c43e1829781abf273b39886aceb57bbff937a49c1797fb71ea06","dfe9a0ae679560530ae3800e00f7576901e3d3c8c30c2cfcdf6e2ab2bded1260","6ac85191710a2194366444b6748e9986076ce74f4e6e0508e3e093cb45d9a2b5"],"paragraph_range_zero_based":[1128,1151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p1128"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2-n(40) m/s; n = 0 – 4.","paragraph_zero_based":1152},{"literal_text_all_w_t_and_m_t":"If the dopplerUncertaintyExt field is present, the target device that supports the dopplerUncertaintyExt shall ignore this field.","paragraph_zero_based":1153},{"literal_text_all_w_t_and_m_t":"codePhase","paragraph_zero_based":1154},{"literal_text_all_w_t_and_m_t":"This field together with the codePhase1023 field specifies the code phase, in units of milliseconds, in the range from 0 to 1 millisecond scaled by the nominal chipping rate of the GNSS signal, where increasing values of the field signify increasing predicted signal code phases, as seen by a receiver at the reference location at the reference time. The reference location would typically be an a priori estimate of the target device location.","paragraph_zero_based":1155},{"literal_text_all_w_t_and_m_t":"Scale factor 2-10 ms in the range from 0 to (1-2-10) ms.","paragraph_zero_based":1156},{"literal_text_all_w_t_and_m_t":"Note: The value (1-2-10) ms is encoded using the codePhase1023 IE.","paragraph_zero_based":1157},{"literal_text_all_w_t_and_m_t":"intCodePhase","paragraph_zero_based":1158},{"literal_text_all_w_t_and_m_t":"This field contains integer code phase (expressed modulo 128 ms). The satellite integer milli-seconds code phase currently being transmitted at the reference time, as seen by a receiver at the reference location is calculated as reference time (expressed in milli-seconds) minus (intCodePhase + (n×128 ms)), as shown in Figure 6.5.2.2-1, with n = …-2,-1,0,1,2….","paragraph_zero_based":1159},{"literal_text_all_w_t_and_m_t":"Scale factor 1 ms in the range from 0 to 127 ms.","paragraph_zero_based":1160},{"literal_text_all_w_t_and_m_t":"codePhaseSearchWindow","paragraph_zero_based":1161},{"literal_text_all_w_t_and_m_t":"This field contains the code phase search window. The code phase search window accounts for the uncertainty in the estimated target device location but not any uncertainty in reference time. It is defined such that the expected code phase is in the range [Code PhaseCode Phase Search Window] to [Code PhaseCode Phase Search Window] given in units of milliseconds.","paragraph_zero_based":1162},{"literal_text_all_w_t_and_m_t":"Range 0-31, mapping according to the table codePhaseSearchWindow Value to Code Phase Search Window [ms] relation shown below.","paragraph_zero_based":1163},{"literal_text_all_w_t_and_m_t":"azimuth","paragraph_zero_based":1164},{"literal_text_all_w_t_and_m_t":"This field specifies the azimuth angle. An angle of x degrees means the satellite azimuth a is in the range","paragraph_zero_based":1165},{"literal_text_all_w_t_and_m_t":"(x  a < x+0.703125) degrees.","paragraph_zero_based":1166},{"literal_text_all_w_t_and_m_t":"Scale factor 0.703125 degrees.","paragraph_zero_based":1167},{"literal_text_all_w_t_and_m_t":"elevation","paragraph_zero_based":1168},{"literal_text_all_w_t_and_m_t":"This field specifies the elevation angle. An angle of y degrees means the satellite elevation e is in the range","paragraph_zero_based":1169},{"literal_text_all_w_t_and_m_t":"(y  e < y+0.703125) degrees.","paragraph_zero_based":1170},{"literal_text_all_w_t_and_m_t":"Scale factor 0.703125 degrees.","paragraph_zero_based":1171},{"literal_text_all_w_t_and_m_t":"codePhase1023","paragraph_zero_based":1172},{"literal_text_all_w_t_and_m_t":"This field if set to TRUE indicates that the code phase has the value 1023 × 2-10 = (1-2-10) ms. This field may only be set to TRUE if the value provided in the codePhase IE is 1022. If this field is set to FALSE, the code phase is the value provided in the codePhase IE in the range from 0 to (1 - 2×2-10) ms. If this field is not present and the codePhase IE has the value 1022, the target device may assume that the code phase is between (1 - 2×2-10) and (1 - 2-10) ms. ","paragraph_zero_based":1173},{"literal_text_all_w_t_and_m_t":"dopplerUncertaintyExt","paragraph_zero_based":1174},{"literal_text_all_w_t_and_m_t":"If this field is present, the target device that supports this field shall ignore the dopplerUncertainty field. The location server should include this field only if supported by the target device.","paragraph_zero_based":1175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["6f00b50d1df73752f82b84720f16513bd1daf9b1c9176483902f82f51af13baa","45d59649cba8aff4cd4cad8e0afd6015718e67d4e59ca4da297e2c020a7968ec","3935291fb1fffb0bbb6062dc6cd6c1f4ad17430bb30ab8e156cc31f7719071bf","4922bf42c33c6c0d88b64df318dde714ac95060ee0feeb398171f6c529dc421c","2500b4dcfdbe7686e9b31400d03aae8d6dc00f7b97878e11f6051d734b6db93d","f9db33b8e320dfb72169c7f4a1f9bd6dea0e4aced6abf1b327357a99d314d9ec","fc7797a5869c2868550b0fba44d912e1209b58d4f7f4d5080415ed44fc1257ea","0149c5b2ffff9b6e7c397a3b173c63f65f60324ba1562a547b9c2c8c0e882434","4aa4ec7ac68aab62f2ae48421b2a5d0a906442b6c2aab6675a67b587fb96dec3","616a9b6d8ad3fbfe1dac015672cd48c4d59290ce0feeb95bc63f20be2697bae2","1b0068f031c7bbfef73c32201dbb7f20ec67368ce913fe947d1fe03bae5fec84","d9a92cf2afe00c0a1f058d5b366cb55e79052b383c060d8da9d5fa2c02759090","a02150519ccef149244dfc3ae4a87d53b064d59550dd693652a9af227dcd60ab","0d11c9b6fa21f03b47a52357b6f59159c6c9b4f4a490548c5991c5936a8963dd","b891aafd0830919eae179f05d01777e1a833b110a00dab49511c463b8f76d994","fd8789edea01234d065ce22d5ba5346bcb43fcbb7f71f1f60c0f29e023103596","ede2560ddfeb08fad6f6c135ea49b6aabf5750c0da96ccc08674d07b1f132a4f","4ae487e7133237d4c5949d764be2b0bb831985f7f7672fc33a99d3ed2447de56","15e55ddcb2553cb2a3959