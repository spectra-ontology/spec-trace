{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38208},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38210},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1-r17 ::=    SEQUENCE {","paragraph_zero_based":38211},{"literal_text_all_w_t_and_m_t":"    sl-IUC-Explicit-r17                       ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38212},{"literal_text_all_w_t_and_m_t":"    sl-IUC-Condition-r17                      ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38213},{"literal_text_all_w_t_and_m_t":"    sl-Condition1-A-2-r17                     ENUMERATED {disabled}                                                OPTIONAL,   -- Need M","paragraph_zero_based":38214},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-Option1List-r17  SEQUENCE (SIZE (1..8)) OF SL-ThresholdRSRP-Condition1-B-1-r17 OPTIONAL,   -- Need M","paragraph_zero_based":38215},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-Option2List-r17  SEQUENCE (SIZE (1..8)) OF SL-ThresholdRSRP-Condition1-B-1-r17 OPTIONAL,   -- Need M","paragraph_zero_based":38216},{"literal_text_all_w_t_and_m_t":"    sl-ContainerCoordInfo-r17                 ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38217},{"literal_text_all_w_t_and_m_t":"    sl-ContainerRequest-r17                   ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":38218},{"literal_text_all_w_t_and_m_t":"    sl-TriggerConditionCoordInfo-r17          INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38219},{"literal_text_all_w_t_and_m_t":"    sl-TriggerConditionRequest-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38220},{"literal_text_all_w_t_and_m_t":"    sl-PriorityCoordInfoExplicit-r17          INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38221},{"literal_text_all_w_t_and_m_t":"    sl-PriorityCoordInfoCondition-r17         INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38222},{"literal_text_all_w_t_and_m_t":"    sl-PriorityRequest-r17                    INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38223},{"literal_text_all_w_t_and_m_t":"    sl-PriorityPreferredResourceSet-r17       INTEGER (1..8)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":38224},{"literal_text_all_w_t_and_m_t":"    sl-MaxSlotOffsetTRIV-r17                  INTEGER (1..8000)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":38225},{"literal_text_all_w_t_and_m_t":"    sl-NumSubCH-PreferredResourceSet-r17      INTEGER (1..27)                                                      OPTIONAL,   -- Need M","paragraph_zero_based":38226},{"literal_text_all_w_t_and_m_t":"    sl-ReservedPeriodPreferredResourceSet-r17 INTEGER (1..16)                                                      OPTIONAL,   -- Need M","paragraph_zero_based":38227},{"literal_text_all_w_t_and_m_t":"    sl-DetermineResourceType-r17              ENUMERATED {uea, ueb}                                                OPTIONAL,   -- Need M","paragraph_zero_based":38228},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38229},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["36e2b5330d7e49df0cdea0000b58a9ea151264d90d316d8727ad5632313b9d88","9d6486ffeb0ced11799f21bf4d48b254f575f0a571c31c66b255ca4cd09185e9","342c87ec8f04e5bf99fb65b815e77fe8ed596245712cdb3f01e2675371a6d755","00d8be6da08883edfc0aaba7b08186a0774573d2420a34c1c5ff58af1bb49ba2","9f2010e2f82114f326a94e76dd86f51774eec1028b123bae1a0807abab1ac680","58afa7b6dd73c623d9554629dfea65451ccef5fc00b94e1ce6c4c9d8aca2fbe9","e558377caaf9d89fefaa5632ecc8cd0687335576aa52dd94cdd6a92a0e176c5c","07ca6a7036535d2e1ce23daf483a3bfc135ef73cf5e4048e93dd65abb0fb66af","f07c0d157deea958c658c627a29e9c4a7d811e523970d17bc024f076243e9160","756e55da0800950e4944dedcd54672fc6519303453709afda0a87e5d876f4e72","0c7add7ca3a904aeb116ca8dbafdbddd79736ffb3e1325f07a9283a538dd25de","895a41518531cad408e1a21ee7a66629fcda0bad7c3ebd6542aa612f51c25626","1156eaf2858858d7b685dfb37eacf16da9adc26696236829f1581afbd9a24355","71683da9b542ef1f0c43cf2aa7601b328eb1f5c34e76509b40b058281120d8bf","8f0544296c4ca84e2e2eac16b8d8975ae46447bcc0db080f85563e8b7d339426","a3e0354f3d4dbea4ba66eef0b3f41f058a0b69126d78c663e2d39c3b964f6afd","6e7adde5c33288ae284694a115ece21175d98212cb7ec255c1ec8124af7dd003","c91fcf52ba704f79eb8f7bd3d90c79ecf3ab89d50a3c3233991c8cc911e64bde","576a7b8f744e44670928542f0abf835073bd4775525e25f134f6269b85337c14","4e5f7cf11a08125a30be547a4312b3fd6c277b483c511e01ef1833348dc2045c","1cda7db9e0ff09131d987204dd2d427bcd3dd34ca15f495b85d9d523527ac0b6","fdba234f664398fd10cb19a67091305fee31bad7d3afdd6db2fa4d495e38b764","2fa8b8f8fc580be8b00dab78fc5e24192087b3fe2de2c0d614e1205