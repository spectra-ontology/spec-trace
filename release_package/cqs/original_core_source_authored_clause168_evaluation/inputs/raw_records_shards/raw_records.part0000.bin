{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mr– Hys > Thresh2","paragraph_zero_based":5184},{"literal_text_all_w_t_and_m_t":"Inequality Y1-3 (Leaving condition 1)","paragraph_zero_based":5185},{"literal_text_all_w_t_and_m_t":"Mp – Hys > Thresh1","paragraph_zero_based":5186},{"literal_text_all_w_t_and_m_t":"Inequality Y1-4 (Leaving condition 2)","paragraph_zero_based":5187},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh2","paragraph_zero_based":5188},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5189},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the PCell, not taking into account any offsets.","paragraph_zero_based":5190},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the candidate L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5191},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5192},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. y1-Threshold1 as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5193},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. y1-Threshold2-Relay as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5194},{"literal_text_all_w_t_and_m_t":"Mp is expressed in dBm in case of RSRP, or in dB in case of RSRQ and SINR.","paragraph_zero_based":5195},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm or dB, depending on the measurement quantity of candidate L2 U2N Relay UE.","paragraph_zero_based":5196},{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":5197},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mp.","paragraph_zero_based":5198},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mr.","paragraph_zero_based":5199},{"literal_text_all_w_t_and_m_t":"5.5.4.20Event Y2 (Candidate L2 U2N Relay UE becomes better than threshold)","paragraph_zero_based":5200},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5201},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition Y2-1, as specified below, is fulfilled;","paragraph_zero_based":5202},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition Y2-2, as specified below, is fulfilled;","paragraph_zero_based":5203},{"literal_text_all_w_t_and_m_t":"Inequality Y2-1 (Entering condition)","paragraph_zero_based":5204},{"literal_text_all_w_t_and_m_t":"Mr– Hys > Thresh2","paragraph_zero_based":5205},{"literal_text_all_w_t_and_m_t":"Inequality Y2-2 (Leaving condition)","paragraph_zero_based":5206},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh2","paragraph_zero_based":5207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["2760e14d6de427f1b4daf2b8967af0256b51ca36b9e62fe7744c4252577969e1","c05c903ea635be16fd5f16209f9a6e70c41ec9f5cc9225d70763c67e058ecf71","622c5b0e3b67c3f0c1cc735d4ba618c6509952a9b25fa573fd9cd3ecfae0515d","24b38c83b4a082484a06ef5badfbb07f7b27fd0dff1205b5c77c1fd8eefc4924","a7cf0c8541c335cab667e6fc2e3bb2f471878e3752473fd27faec0a2df95d917","3bf68967203c0fb1cd2c42c16560876518b61ce218eb79722df28a38c95d00ce","c4e3b9b5eebab7b8ed688373dfcdefcfb11c64cada12f4b3f91f5d808b90270e","cb6e5ba487dfdee82a6d0b9bf90459956e0a5a575859b8bce33d700e024eda4d","05c2878b7d44f14cf8443d22a1aeeb5ecd7a68ee0252163cb0acfea0f5b66855","b3b4c9d89fb922a42fddd9987bb7fff0fdca98df9ac479fba045949470132ffb","546343976d220ab08a919e99c71ba180c7bfdc26781c560cd6c0558ded685a0c","f942d1ea9f23894116bfa7baa1684cca557197bbccc308bbba17409191cead13","562edfecd425bd5ae0658e2b4afce7bd39bd9d041e9befcbaa9c704cdf2775f6","771ed7ce99c148a628d1e648fab3f6fdedd7a0cc44ece1fb5f255fae48183025","8bec31ef384e5267408489c5edce928ba03b63bf8feef403569181104dd38d9d","8672da6b3a5cf59310321aa427872cbc5605e6382a502d6831b5ab76a6512541","dd3631ec400ab21288786ede32d3b334c199b5d1cef75817e7f5bfd979fc6953","56d91b4e99f5585b049604da0ff3aad4745226e8a7d8508b47e57638b5fabbce","99f506dc90904fd477549453eb65722906997325753b9214b190fb88b0bfd8d0","3603a9e610b5a4f1e88b8a6baed284d2bbc190a2f601a7f57e450553a1e121f2","258b332359ef95021abc09fc14bdb81b23cac5a096d355f56f02e95e63f98cd5","a8afbbc85f96ee96e11c4d82cacbbe3347f10c63a0b4dadc93c154ecd782346d","22f8a870c6f10d0b784989822546f2ab2bc83fcddca15dd0925006972f8ec92f","b40a46228f793551358e5845f79bfef851be2d4901d37745242f6bdac96ad0d2"],"paragraph_range_zero_based":[5184,5207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5184"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5208},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the candidate L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5209},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5210},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. y2-Threshold-Relay as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5211},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm or dB, depending on the measurement quantity of candidate L2 U2N Relay UE.","paragraph_zero_based":5212},{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":5213},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Mr.","paragraph_zero_based":5214},{"literal_text_all_w_t_and_m_t":"5.5.5Measurement reporting","paragraph_zero_based":5215},{"literal_text_all_w_t_and_m_t":"5.5.5.1General","paragraph_zero_based":5216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5217},{"literal_text_all_w_t_and_m_t":"Figure 5.5.5.1-1: Measurement reporting","paragraph_zero_based":5218},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer measurement results from the UE to the network. The UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":5219},{"literal_text_all_w_t_and_m_t":"For the measId for which the measurement reporting procedure was triggered, the UE shall set the measResults within the MeasurementReport message as follows:","paragraph_zero_based":5220},{"literal_text_all_w_t_and_m_t":"1>set the measId to the measurement identity that triggered the measurement reporting;","paragraph_zero_based":5221},{"literal_text_all_w_t_and_m_t":"1>for each serving cell configured with servingCellMO:","paragraph_zero_based":5222},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with the measId that triggered the measurement reporting includes rsType:","paragraph_zero_based":5223},{"literal_text_all_w_t_and_m_t":"3>if the serving cell measurements based on the rsType included in the reportConfig that triggered the measurement report are available:","paragraph_zero_based":5224},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on the rsType included in the reportConfig that triggered the measurement report;","paragraph_zero_based":5225},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5226},{"literal_text_all_w_t_and_m_t":"3>if SSB based serving cell measurements are available:","paragraph_zero_based":5227},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on SSB;","paragraph_zero_based":5228},{"literal_text_all_w_t_and_m_t":"3>else if CSI-RS based serving cell measurements are available:","paragraph_zero_based":5229},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on CSI-RS;","paragraph_zero_based":5230},{"literal_text_all_w_t_and_m_t":"1>set the servCellId within measResultServingMOList to include each NR serving cell that is configured with servingCellMO, if any;","paragraph_zero_based":5231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9fdf054dbe3142c8428ff8727f961484f3ce2dc93ea926dd8b199e385d6c1ef5","0c6036a42179cd3479267ecaa2d503749b2eb7bac91065452fec75d8ac534bdf","5b4e62dac6dca8a4cff805b83820ef8d214ecb7160813a92226c4b4c476ae99d","4875ca4a5bcc0087dba6cb9f0ff9f12a3d9c479faca76bad4c2904b47cfe3a0f","98b7dde74441162343da5786e1b7943f318cf44961b84c5664d88c557a100334","bf2d9b1cc20d84a01a5518bfaa3cab1b98deeacda33075ed26bf56258650165c","9fefd2cfe4cfb5315a09f5686f0cb238c6ee9411dbcc62a3b11ac98cab699d15","63e9fb236e75351b5cee5d696f9c793b6f59a4d860be5cdd635168cc8a624211","cdb633950f98863b9173d2d4f2975f6d19967f9850fa19fce74b7f9aeff11011","b85e77942da5a7ac5f1cb586fd3d898b5a99d9097beb7d84c7b3e1cf453f1f15","77400c3e40a2ba50734d50d0d1ab5fafc48a32258597a9b4945333b774ee1f73","386385085b889ec809d3423d0e84f0c86bd4d27f1b3fd4dcc5d33042302d6f9e","2551541068cc8146bc4ee310d08906bb9d333384e5e7853217246c5d6443280a","75dcff669cf571da4cc0fd45c872a1e2e6d507dffae47fa63a18da9a4f31821b","2521dc7d572f57ca9fd327aaf960d2de77de471c64a87d06131235b33fa54fde","53e6fb68ade67697bbebd0b346825088876238fbd3adb44d0761492182e16b31","52f7e5edc960d7d96ce178b121bc88d81772af973ae8867c7a3e5b59e30f18e2","a86e4a6dbe5dacb7daf95aca7a01013cf69dd9a29781bf94fa838c87b4de0b32","cf922c2062b70b2907b7e28de6d37d829d7a029070650917ec750ca539d76ad3","ce037e01102c443375c59cb76b70cf5ebd792d5ffba98d717c894de5d24bcab2","5bbc3c8113771d668ec1e20136f823cd586cae678f1cc3bda81878f999965d52","e4952f147b17db91f83a7964f6467cc901f94319aef749a7955200c7f4d23ecb","4db71b09e14f87cce71cb65c4972293c26547a7ab3fa67268da352139d0d89bf","9df555b2f922a496e3b79009e179fa80e3729ebe27398fa1bf10a534664baa36"],"paragraph_range_zero_based":[5208,5231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5208"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5232},{"literal_text_all_w_t_and_m_t":"2>for each serving cell configured with servingCellMO, include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":5233},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":5234},{"literal_text_all_w_t_and_m_t":"2>for each measObjectId referenced in the measIdList which is also referenced with servingCellMO, other than the measObjectId corresponding with the measId that triggered the measurement reporting:","paragraph_zero_based":5235},{"literal_text_all_w_t_and_m_t":"3>if the measObjectNR indicated by the servingCellMO includes the RS resource configuration corresponding to the rsType indicated in the reportConfig:","paragraph_zero_based":5236},{"literal_text_all_w_t_and_m_t":"4>set the measResultBestNeighCell within measResultServingMOList to include the physCellId and the available measurement quantities based on the reportQuantityCell and rsType indicated in reportConfig of the non-serving cell corresponding to the concerned measObjectNR with the highest measured RSRP if RSRP measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured RSRQ if RSRQ measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured SINR;","paragraph_zero_based":5237},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5238},{"literal_text_all_w_t_and_m_t":"5>for each best non-serving cell included in the measurement report:","paragraph_zero_based":5239},{"literal_text_all_w_t_and_m_t":"6>include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":5240},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5, or eventB1, or eventB2:","paragraph_zero_based":5241},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NE-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":5242},{"literal_text_all_w_t_and_m_t":"3>set the measResultServFreqListEUTRA-SCG to include an entry for each E-UTRA SCG serving frequency with the following:","paragraph_zero_based":5243},{"literal_text_all_w_t_and_m_t":"4>include carrierFreq of the E-UTRA serving frequency;","paragraph_zero_based":5244},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the available measurement quantities that the UE is configured to measure by the measurement configuration associated with the SCG;","paragraph_zero_based":5245},{"literal_text_all_w_t_and_m_t":"4>if reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":5246},{"literal_text_all_w_t_and_m_t":"5>set the measResultServFreqListEUTRA-SCG to include within measResultBestNeighCell the quantities of the best non-serving cell, based on RSRP, on the concerned serving frequency;","paragraph_zero_based":5247},{"literal_text_all_w_t_and_m_t":"1>if reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5:","paragraph_zero_based":5248},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NR-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":5249},{"literal_text_all_w_t_and_m_t":"3>set the measResultServFreqListNR-SCG to include for each NR SCG serving cell that is configured with servingCellMO, if any, the following:","paragraph_zero_based":5250},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes rsType:","paragraph_zero_based":5251},{"literal_text_all_w_t_and_m_t":"5>if the serving cell measurements based on the rsType included in the reportConfig that triggered the measurement report are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5252},{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on the rsType included in the reportConfig that triggered the measurement report;","paragraph_zero_based":5253},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5254},{"literal_text_all_w_t_and_m_t":"5>if SSB based serving cell measurements are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ea753ff4b732871242f440a2bf3ecda70a773a2bb7b70a984f795e4ed2e53e64","5172e7495998f2d8b64320706456660db32644cd1b33a1a9b745ba3d6247bd13","88b0872b0cd2f6063b08862c82ceb345f0393294da353e861b2ee770efb52932","34a95513cfa45ccce7f2cc6e2a599a37ad1e5358b2d1712343eff1e3b1c48b02","fc262df2e2c0fa0996ad8fa02adc6a94676029311ea5829b37d8609e03c831da","e61c005595041e7db4d7e9685bbfeb5a42190ac0ff2e717c10d817883fef3141","b8e4b807f956e79c5b35bb694fff9a1690d63cd507a2515d30ea1d7228c97ac0","856e4248784fc08e44f9410c226b93b82795af6935c430258c00c44453b2ce26","5bff54d9c6d66fc99c5258b57e5609f310e7724c5a4a13d0c0a5563ae7ec3e4a","60431f5658c6003ac5e28972c898290954ce724ef8523bb63b4df55971d257c0","7b69e059187bf9178d78a67d7f45bfe393a3847b3d625b56b666f1795d8a93c1","5532a260203ea39a0717275a7b25a85a0e7f148d8f3246faec56e4a981749015","b2d7dc6fed144da607ce652263113f3f216a245f55816979af3aeb65194c81c0","1f1958f5fd0faa35e9c01856f61c43838bb5da83119e5ebdf3c5dcc591e83116","55ebed63b10de09d2b35c79066cbb413087522ad6272ea50efe84716e3e810d2","038af948742fda61b97c48a739544698c06b4fd0f475251f5b6c0b14275725cb","3fae1dac23dc8e4c603ff563b31cf6607e40ed5a697608e36ec10f7f4694f35b","dd52edf5b71e3ba8b00c3143084b41fcbde734a6ed16dc02867b58fbbdafcb74","e6b7c0ce98b01b0820549016f407f454c1207402df58ebfefa2aa8e6b01ed067","e60ff4acf82544e4cde27de775bc861a5438c3b90d47bf2b1de0cc4593b9bac6","fed221749ead3453e4a58070c0329a1c841c74d83cf6e7f98f5f6beaac38a6e6","76384b959fdd9959c282691e720a08a020c17c78e3a66fd6bb69641c627ec3ba","eeb94070fb3f52e42718a25c5b03a26dcea663395342d912342d6d4f2350a853","8ec4f3d05619b1ddebeba8ac3f709bf523bb91d87f6dc44ae319f5854240d08b"],"paragraph_range_zero_based":[5232,5255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5232"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on SSB;","paragraph_zero_based":5256},{"literal_text_all_w_t_and_m_t":"5>else if CSI-RS based serving cell measurements are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5257},{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on CSI-RS;","paragraph_zero_based":5258},{"literal_text_all_w_t_and_m_t":"4>if results for the serving cell derived based on SSB are included:","paragraph_zero_based":5259},{"literal_text_all_w_t_and_m_t":"5>include the ssbFrequency to the value indicated by ssbFrequency as included in the MeasObjectNR of the serving cell;","paragraph_zero_based":5260},{"literal_text_all_w_t_and_m_t":"4>if results for the serving cell derived based on CSI-RS are included:","paragraph_zero_based":5261},{"literal_text_all_w_t_and_m_t":"5>include the refFreqCSI-RS to the value indicated by refFreqCSI-RS as included in the MeasObjectNR of the serving cell;","paragraph_zero_based":5262},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5263},{"literal_text_all_w_t_and_m_t":"5>for each serving cell configured with servingCellMO, include beam measurement information according to the associated reportConfig as described in 5.5.5.2, where availability is considered according to the measurement configuration associated with the SCG;","paragraph_zero_based":5264},{"literal_text_all_w_t_and_m_t":"4>if reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":5265},{"literal_text_all_w_t_and_m_t":"5>if the measObjectNR indicated by the servingCellMO includes the RS resource configuration corresponding to the rsType indicated in the reportConfig:","paragraph_zero_based":5266},{"literal_text_all_w_t_and_m_t":"6>set the measResultNeighCellListNR within measResultServFreqListNR-SCG to include one entry with the physCellId and the available measurement quantities based on the reportQuantityCell and rsType indicated in reportConfig of the non-serving cell corresponding to the concerned measObjectNR with the highest measured RSRP if RSRP measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured RSRQ if RSRQ measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured SINR, where availability is considered according to the measurement configuration associated with the SCG;","paragraph_zero_based":5267},{"literal_text_all_w_t_and_m_t":"7>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5268},{"literal_text_all_w_t_and_m_t":"8>for each best non-serving cell included in the measurement report:","paragraph_zero_based":5269},{"literal_text_all_w_t_and_m_t":"9>include beam measurement information according to the associated reportConfig as described in 5.5.5.2, where availability is considered according to the measurement configuration associated with the SCG;","paragraph_zero_based":5270},{"literal_text_all_w_t_and_m_t":"1>if the measRSSI-ReportConfig is configured within the corresponding reportConfig for this measId:","paragraph_zero_based":5271},{"literal_text_all_w_t_and_m_t":"2>set the rssi-Result to the linear average of sample value(s) provided by lower layers in the reportInterval;","paragraph_zero_based":5272},{"literal_text_all_w_t_and_m_t":"2>set the channelOccupancy to the rounded percentage of sample values which are beyond the channelOccupancyThreshold within all the sample values in the reportInterval;","paragraph_zero_based":5273},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":5274},{"literal_text_all_w_t_and_m_t":"2>set the sl-MeasResultServingRelay in accordance with the following:","paragraph_zero_based":5275},{"literal_text_all_w_t_and_m_t":"3>set the cellIdentity to include the cellAccessRelatedInfo contained in the discovery message received from the serving L2 U2N Relay UE;","paragraph_zero_based":5276},{"literal_text_all_w_t_and_m_t":"3>set the sl-RelayUE-Identity to include the Source L2 ID of the serving L2 U2N Relay;","paragraph_zero_based":5277},{"literal_text_all_w_t_and_m_t":"3>set the sl-MeasResult to include the SL-RSRP of the serving L2 U2N Relay UE;","paragraph_zero_based":5278},{"literal_text_all_w_t_and_m_t":"NOTE 1:In case of no data transmission from L2 U2N Relay UE to L2 U2N Remote UE, it is left to UE implementation whether to use SL-RSRP or SD-RSRP when setting the sl-MeasResultServingRelay of the serving L2 U2N Relay UE.","paragraph_zero_based":5279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["02ef5c087713e896f82878167fb6de3da60624b6a4599d4898277dd71f7ab7d4","63d77bc4b2c79d595dfe20396fdabd4706dac78a27c99cdc9395f19349b78054","bd43c7a086954d5ae174bf184312b299096696d48c6afb9c19e7e6e434384cb5","38788435dbf7a2c5efeee50a389b4af8e012576d6b4ac6d25623151fc8a7b821","8b99bf7342390308636403e2267ae575eed27604c7368031d2527456141f716c","354c6864931c0502addfb893a28339082809841e2a84f5e06831f28b0b674b9d","d652b795dc182429de1487ca0e382edefa7bae65d6fbbd2fbc4d16602e84df76","d164c4d8a90622b335af51f7519de5a0ce684395d4ecf2dc61bda12a72027cfc","c6d3391ac208fae0cc0826fc0a17f5eeae63bb06fb230f4f4fdfebb38993bbfe","2ce8934f2c1877bb616dd5a2a966a5c517dbf4dfcbfb64544d252e69545d946a","8acc95526a97e7e4e044ce0559df961481468f5df19ec44549b485a9082850a0","61c2bbb94bf6ca54f96d1f31df212508c1ae77d465a0818856e03003cc902195","0aa75fefc2c9edfd8e8275b0616e08e156e8e39226a459a413340c598dea9115","97f5c23d4c6a86d909dc769aa0fa378e0c45e4c15ba6c4827adcfeae3ac95873","bc39e5de7d5d4182c25171220dbd3d010d93897d5a9fc54abce2644d62bb7943","835db99a872a8c2ade7175607084f5c07ed20bdb45b15d6172e9ce4e4c41eab5","e0a25f70cf5679ad8594e8372d03cb2e487c09c87a3e2a9cd70711d2b58c6e4e","cf2a84bbe12644656a7bf034898bedcaa134b556975b90343be2747c6a595ba1","5d248bf45c8e5dff1b842223e8f0e913b6c329e4525c80ec5564ddd0aa6abc02","771e52c4d3f39f6c417a5cccc5012bd4adfbaab01155ced104dabefeab86f096","207ad0a4d0155892766943f3825bbe0f4f6acf29cfa079931bd04b64e43778ff","8f967eead774eba39006b95da3028310aa25a7e1c3b72ff8c4fc44bbf32fecb4","b3deb3a59f3de241e077a550963dd15cd46a50d3289bab7cd044d2950610aed1","ff542ff78bbeed72098020f5e82e333a3e330c310dd170e4bc6857f715ddfe8f"],"paragraph_range_zero_based":[5256,5279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5256"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if there is at least one applicable neighbouring cell or candidate L2 U2N Relay UE to report:","paragraph_zero_based":5280},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to eventTriggered or periodical:","paragraph_zero_based":5281},{"literal_text_all_w_t_and_m_t":"3>if the measurement report concerns the candidate L2 U2N Relay UE:","paragraph_zero_based":5282},{"literal_text_all_w_t_and_m_t":"4>set the sl-MeasResultsCandRelay in measResultNeighCells to include the best candidate L2 U2N Relay UEs up to maxNrofRelayMeas in accordance with the following:","paragraph_zero_based":5283},{"literal_text_all_w_t_and_m_t":"5>if the reportType is set to eventTriggered:","paragraph_zero_based":5284},{"literal_text_all_w_t_and_m_t":"6>include the L2 U2N Relay UEs included in the relaysTriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5285},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5286},{"literal_text_all_w_t_and_m_t":"6>include the applicable L2 U2N Relay UEs for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5287},{"literal_text_all_w_t_and_m_t":"5>for each L2 U2N Relay UE that is included in the sl-MeasResultsCandRelay:","paragraph_zero_based":5288},{"literal_text_all_w_t_and_m_t":"6>set the cellIdentity to include the cellAccessRelatedInfo contained in the discovery message received from the concerned L2 U2N Relay UE;","paragraph_zero_based":5289},{"literal_text_all_w_t_and_m_t":"6>set the sl-RelayUE-Identity to include the Source L2 ID of the concerned L2 U2N Relay UE;","paragraph_zero_based":5290},{"literal_text_all_w_t_and_m_t":"6>set the sl-MeasResult to include the SD-RSRP of the concerned L2 U2N Relay UE;","paragraph_zero_based":5291},{"literal_text_all_w_t_and_m_t":"5>for each included L2 U2N Relay UE, include the layer 3 filtered measured results in accordance with the reportConfig for this measId, ordered as follows:","paragraph_zero_based":5292},{"literal_text_all_w_t_and_m_t":"6>set the sl-MeasResult to include the quantity(ies) indicated in the reportQuantityRelay within the concerned reportConfigRelay in decreasing order of the sorting quantity, determined as specified in 5.5.5.3, i.e. the best L2 U2N Relay UE is included first;","paragraph_zero_based":5293},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5294},{"literal_text_all_w_t_and_m_t":"4>set the measResultNeighCells to include the best neighbouring cells up to maxReportCells in accordance with the following:","paragraph_zero_based":5295},{"literal_text_all_w_t_and_m_t":"5>if the reportType is set to eventTriggered and eventId is not set to eventD1:","paragraph_zero_based":5296},{"literal_text_all_w_t_and_m_t":"6>include the cells included in the cellsTriggeredList as defined within the VarMeasReportList for this measId;","paragraph_zero_based":5297},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5298},{"literal_text_all_w_t_and_m_t":"6>include the applicable cells for which the new measurement results became available since the last periodical reporting or since the measurement was initiated or reset;","paragraph_zero_based":5299},{"literal_text_all_w_t_and_m_t":"5>for each cell that is included in the measResultNeighCells, include the physCellId;","paragraph_zero_based":5300},{"literal_text_all_w_t_and_m_t":"5>if the reportType is set to eventTriggered or periodical:","paragraph_zero_based":5301},{"literal_text_all_w_t_and_m_t":"6>for each included cell, include the layer 3 filtered measured results in accordance with the reportConfig for this measId, ordered as follows:","paragraph_zero_based":5302},{"literal_text_all_w_t_and_m_t":"7>if the measObject associated with this measId concerns NR:","paragraph_zero_based":5303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1537645564b4559d4ef262a940888cb0b15edc404c8178c1584f370fc890a91b","59217baa43a4b4349939e5e13765166b4a0d07fb34863f03654e5ea3bb9bab4b","77c7731f566d57dabfe4b4b1f755cec2c587bea72bae9df93ed41fc2f7eda06b","24d4e2cebc4858d083409000cd0bc60095f4545780c3c101a03d6c0a99c3a801","90bec41099948c5f27a16a4a035c2358635b5f97dea527b9fd67530296f53a6a","a3867f04742209051dab3daf34bbdbcba30b6d13c63ed4fa7bf6718b2f7b8c19","49b1629b443a43c3e6fdc30ef0f88b560e87ea8d1dc349fc83e23c753b9a38d3","5a044c8437c94bccadc4381dde58554b576bc4d01989e33c3b16918cc233bceb","e38e8fe79845aa17bbddcba81b89e6c0ef2bb0ad423ec62b39cf69fa6497076b","13a1c5a49daa3e77e702eeefce69dffe9e8fe4795d56b05543723d03faa8a3c7","01c3a8dc5e77b8dd6d6d06a80e20c785952ec68de9017a844e1d92fcdb261b09","c64c973f5e2c6909098591f200bb2fb5cfe844020dbab5563de129d88fece0a4","fbd5cdf34b0a1efa7cb29688cf66ed5f9e9cef00df66aa1c1f71aa2756851ecb","2b133967bbc4bfa3c1e0d51539a984569b33248ef6dc0dbb52e0184493a11703","d2db764413640fd8577fe148255d1508a5f9990bef8cdf8ae760236f7370e4d5","4affd60087020e571a3cc7f8155a80adfe0f7083d0dcd7a92360fdba2b413fa5","8759980776788a808979fb1e9602431702e1a365248085e41564d64932f6dcae","4c39c47eebaeb798b7538b005146faef8108d2dd28e36f794b73fe0c7ae44434","dce2e88a0c7c8a19e2cbd506843716a2098b7d924f5e9efcdee92600ecf29b54","6dbafa609401a7014415bd474d3b3812a438457d3ebfa29a4fd311c52a41295e","8e9e2bdb7a26ff6e934f016f0b26f5df258e6744974a00f3f48440a3b03d76cf","7ed79d093bae6425b56877f3b258e38c05f36b5796d89616a81444c901a62502","d2f216a94b687768c893a1f4d1639d60585d836f299f799635c57fa4697a8bdb","1b93429f956275ef7e2d7e91263dbc68f1404450116d9b7650795f25b5256a7e"],"paragraph_range_zero_based":[5280,5303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5280"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"8>if rsType in the associated reportConfig is set to ssb:","paragraph_zero_based":5304},{"literal_text_all_w_t_and_m_t":"9>set resultsSSB-Cell within the measResult to include the SS/PBCH block based quantity(ies) indicated in the reportQuantityCell within the concerned reportConfig, in decreasing order of the sorting quantity, determined as specified in 5.5.5.3, i.e. the best cell is included first;","paragraph_zero_based":5305},{"literal_text_all_w_t_and_m_t":"9>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport are configured, include beam measurement information as described in 5.5.5.2;","paragraph_zero_based":5306},{"literal_text_all_w_t_and_m_t":"8>else if rsType in the associated reportConfig is set to csi-rs:","paragraph_zero_based":5307},{"literal_text_all_w_t_and_m_t":"9>set resultsCSI-RS-Cell within the measResult to include the CSI-RS based quantity(ies) indicated in the reportQuantityCell within the concerned reportConfig, in decreasing order of the sorting quantity, determined as specified in 5.5.5.3, i.e. the best cell is included first;","paragraph_zero_based":5308},{"literal_text_all_w_t_and_m_t":"9>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport are configured, include beam measurement information as described in 5.5.5.2;","paragraph_zero_based":5309},{"literal_text_all_w_t_and_m_t":"7>if the measObject associated with this measId concerns E-UTRA:","paragraph_zero_based":5310},{"literal_text_all_w_t_and_m_t":"8>set the measResult to include the quantity(ies) indicated in the reportQuantity within the concerned reportConfigInterRAT in decreasing order of the sorting quantity, determined as specified in 5.5.5.3, i.e. the best cell is included first;","paragraph_zero_based":5311},{"literal_text_all_w_t_and_m_t":"7>if the measObject associated with this measId concerns UTRA-FDD and if ReportConfigInterRAT includes the reportQuantityUTRA-FDD:","paragraph_zero_based":5312},{"literal_text_all_w_t_and_m_t":"8>set the measResult to include the quantity(ies) indicated in the reportQuantityUTRA-FDD within the concerned reportConfigInterRAT in decreasing order of the sorting quantity, determined as specified in 5.5.5.3, i.e. the best cell is included first;","paragraph_zero_based":5313},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5314},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by cellForWhichToReportCGI is an NR cell:","paragraph_zero_based":5315},{"literal_text_all_w_t_and_m_t":"4>if plmn-IdentityInfoList of the cgi-Info for the concerned cell has been obtained:","paragraph_zero_based":5316},{"literal_text_all_w_t_and_m_t":"5>include the plmn-IdentityInfoList including plmn-IdentityList, trackingAreaCode (if available), trackingAreaList (if available), ranac (if available), cellIdentity and cellReservedForOperatorUse for each entry of the plmn-IdentityInfoList;","paragraph_zero_based":5317},{"literal_text_all_w_t_and_m_t":"5>include frequencyBandList if available;","paragraph_zero_based":5318},{"literal_text_all_w_t_and_m_t":"5>for each PLMN-IdentityInfo in plmn-IdentityInfoList:","paragraph_zero_based":5319},{"literal_text_all_w_t_and_m_t":"6>if the gNB-ID-Length is broadcast:","paragraph_zero_based":5320},{"literal_text_all_w_t_and_m_t":"7>include gNB-ID-Length;","paragraph_zero_based":5321},{"literal_text_all_w_t_and_m_t":"4>if nr-CGI-Reporting-NPN is supported by the UE and npn-IdentityInfoList of the cgi-Info for the concerned cell has been obtained:","paragraph_zero_based":5322},{"literal_text_all_w_t_and_m_t":"5>include the npn-IdentityInfoList including npn-IdentityList, trackingAreaCode, ranac (if available), cellIdentity and cellReservedForOperatorUse for each entry of the npn-IdentityInfoList;","paragraph_zero_based":5323},{"literal_text_all_w_t_and_m_t":"5>for each NPN-IdentityInfo in NPN-IdentityInfoList:","paragraph_zero_based":5324},{"literal_text_all_w_t_and_m_t":"6>if the gNB-ID-Length is broadcast:","paragraph_zero_based":5325},{"literal_text_all_w_t_and_m_t":"7>include gNB-ID-Length;","paragraph_zero_based":5326},{"literal_text_all_w_t_and_m_t":"5>include cellReservedForOtherUse if available;","paragraph_zero_based":5327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["85e6032b5aca07e319f334632515a63d5b6d3175e1c2b49bf1e70ef3ccd71e4e","bea1b26104e087f9fefef795dafbd6cf7ca046b95bad3c017c6a1a02a3351d73","0a8da23db4d3cf713dac8a6832d11e9efa149b46b71b091bcc1f4ad87d2fe15a","a1863e17e5a9e8048618fcf571cd5e63a4cf90b12d3a8548fea644d34ef64294","637e5901c93de6e6be126e80f0c12b30f040b870d0c3c0da70da25af366ee57e","8e3198c47b87ba69aa74cca90bff250561e0fba56e118f99284716ba49d69700","39af2db0092b65fdf016cce18559bf008ab8dc8d50d9bf477792907759b8ab79","7f8ed1dd34a164a19bb3ce9b6d491d3fc85fa6ac0823ca39edb47747c83d898a","5e2fd9b78f096b579e94002c4eeb4b0daabbe36de742db5afbac4fd235b6815e","ea50f168bb77a67a7b3480ffa977959138c4a3bea40dc79c5d53c5f117239ebe","231fc57c20dd70bd907bea385d8ef84488ebda786254f3ff0a8aaebc3cf23bcd","7462fa35702312cf12ab611839a5ab4d8cf589119c92568d41a4abe02762d1be","2261cd62b4a5a844e67c702a8fa2c514e7616e622dbe72608790943ef0bd2b9c","fca98e02a00f4f31f079e8ad1714dbc589fef9ced829affc071b27b88c759fbe","c9cad2eedff2715dfd08b26ea1dfbf413a239eabacebe0de35924164453efde4","9393fd5bd0c4f07ca3c7e31ebfd99862e01b571619fb01068b8b323c852b25bf","d0573180b3f8f1b928df790996f5c91473fbb11b3b72e4ac555785f49523ec37","1c4fe38279c273e36f8f9b61b31e07d7941d8039f241c751080ce8dc000483a8","efe9b571dad51b78afb3730bb9c91ffe5894bf1a569700f57b73a49e163d33fe","d6c76bbe6e2636587a557dba6ec6dbd7e9432ced0b31c96e701d562c296ffa32","9dad1c5d82cb0e5bcd3d184a2f1e2e6403148cbee311402f967680515f4265ea","e97d4b825a188c9680357b6b896552ac44801af208490111df58704ac3263a1f","615d85126343b2318c8bb62f3e7ffdac7ee8fbff2877f56ff0d58001a0cd01a4","a3d60c696bd9f1dc3f830567dbc54ba6ed44307261195eeb889c5686a59106e3"],"paragraph_range_zero_based":[5304,5327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5304"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>else if MIB indicates the SIB1 is not broadcast:","paragraph_zero_based":5328},{"literal_text_all_w_t_and_m_t":"5>include the noSIB1 including the ssb-SubcarrierOffset and pdcch-ConfigSIB1 obtained from MIB of the concerned cell;","paragraph_zero_based":5329},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by cellForWhichToReportCGI is an E-UTRA cell:","paragraph_zero_based":5330},{"literal_text_all_w_t_and_m_t":"4>if all mandatory fields of the cgi-Info-EPC for the concerned cell have been obtained:","paragraph_zero_based":5331},{"literal_text_all_w_t_and_m_t":"5>include in the cgi-Info-EPC the fields broadcasted in E-UTRA SystemInformationBlockType1 associated to EPC;","paragraph_zero_based":5332},{"literal_text_all_w_t_and_m_t":"4>if the UE is E-UTRA/5GC capable and all mandatory fields of the cgi-Info-5GC for the concerned cell have been obtained:","paragraph_zero_based":5333},{"literal_text_all_w_t_and_m_t":"5>include in the cgi-Info-5GC the fields broadcasted in E-UTRA SystemInformationBlockType1 associated to 5GC;","paragraph_zero_based":5334},{"literal_text_all_w_t_and_m_t":"4>if the mandatory present fields of the cgi-Info for the cell indicated by the cellForWhichToReportCGI in the associated measObject have been obtained:","paragraph_zero_based":5335},{"literal_text_all_w_t_and_m_t":"5>include the freqBandIndicator;","paragraph_zero_based":5336},{"literal_text_all_w_t_and_m_t":"5>if the cell broadcasts the multiBandInfoList, include the multiBandInfoList;","paragraph_zero_based":5337},{"literal_text_all_w_t_and_m_t":"5>if the cell broadcasts the freqBandIndicatorPriority, include the freqBandIndicatorPriority;","paragraph_zero_based":5338},{"literal_text_all_w_t_and_m_t":"1>if the corresponding measObject concerns NR:","paragraph_zero_based":5339},{"literal_text_all_w_t_and_m_t":"2>if the reportSFTD-Meas is set to true within the corresponding reportConfigNR for this measId:","paragraph_zero_based":5340},{"literal_text_all_w_t_and_m_t":"3>set the measResultSFTD-NR in accordance with the following:","paragraph_zero_based":5341},{"literal_text_all_w_t_and_m_t":"4>set sfn-OffsetResult and frameBoundaryOffsetResult to the measurement results provided by lower layers;","paragraph_zero_based":5342},{"literal_text_all_w_t_and_m_t":"4>if the reportRSRP is set to true;","paragraph_zero_based":5343},{"literal_text_all_w_t_and_m_t":"5>set rsrp-Result to the RSRP of the NR PSCell derived based on SSB;","paragraph_zero_based":5344},{"literal_text_all_w_t_and_m_t":"2>else if the reportSFTD-NeighMeas is included within the corresponding reportConfigNR for this measId:","paragraph_zero_based":5345},{"literal_text_all_w_t_and_m_t":"3>for each applicable cell which measurement results are available, include an entry in the measResultCellListSFTD-NR and set the contents as follows:","paragraph_zero_based":5346},{"literal_text_all_w_t_and_m_t":"4>set physCellId to the physical cell identity of the concerned NR neighbour cell.","paragraph_zero_based":5347},{"literal_text_all_w_t_and_m_t":"4>set sfn-OffsetResult and frameBoundaryOffsetResult to the measurement results provided by lower layers;","paragraph_zero_based":5348},{"literal_text_all_w_t_and_m_t":"4>if the reportRSRP is set to true:","paragraph_zero_based":5349},{"literal_text_all_w_t_and_m_t":"5>set rsrp-Result to the RSRP of the concerned cell derived based on SSB;","paragraph_zero_based":5350},{"literal_text_all_w_t_and_m_t":"1>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":5351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c58a530d30e88bbbb1180efb0e12c32e4230799d8775adf869a855482c0b0d7c","43ef2bce0dcf3b62441200f68556706b344f236fca4803b31c900738ba67cbcc","2557d4f23dc3099a51e0d033701cdd564b46a7b7f528df73f94f55aa80be1eec","7aedfd30d4b3f3534ea1133f999469b0dfed5246ef832ffe56e2477328290153","b9d11eb061922f8ec59fd3e30ebb0c026ea90ac5d224eac0aa5d20fa82654a1d","cc06fdfed5b851512ce49c4ed54b160fc57efcdf11dcd166b82ede258497e04b","fb51087bc1b8ca3e1ed4f757c2d404c016ece49a48f6ade49df7b8d88d3c9958","cd67d3ba4185007e2f7b017f39bf03483066391cd459ec6712412f25b424760c","d9b63945f3752cb30572c771d04ad8c855274d8a553eb19d40a1857b932b4f89","aed68f49ee60771f6dfde3a925545b71382490b6f2a0c09c277f1a9d12289321","f8451b8efc50e46a2ec6c58d7d96a31310e5774326ccc8c9bf91d792ae753e65","12ca8f24ff73af3f75f295e8e257e585626b10e2321786d33c95b0db42d42c03","7f35d9b485fc2b4051ac0835cc48f1430c0ecba64fdac7a6b98c77da8ee2082d","632d81dcac6e96d932febb13920cef3c5c8bf90446cd308f5dc5c09ea074153b","bd8d187af5c925043711477e596a27e7c222f97d9b850e3bc2eb4bdf7073f9b3","a3ba316347619d68d17c82995cbe780540b1ad21dcac0ef06f01abb0c64a25f1","f752a23362dbbdccc1b2578ff5dbd6a34b1425b60912cdf79eb96e2f93ab5aaa","36011816ee396d8680bc38b15a3a4f6f430526173d1478351c432b48d4ad1868","817479be88ba2f6c07da91a94179bb9047b519f330f422f0fef2ca3706bad356","6d0fe10a774e31289b197e3e4d802c2347ad91f545dff100bd55e8c83e90dcfe","fe27087cd66655a71c388adb0f3b0475513253ffc5b7acb58240b7de7c17b069","e1ed27905928f78522088057de92769d33d7313ecf1eebe1c0348321237b4b94","9b0fe406a35f377ce0297216e1341b5841bbbf7d0bf715121972884319a9918e","b2bb54bbf179c8ef8435d29302cbcaf0b2025ce5fa9caa3e80144388dfa920b9"],"paragraph_range_zero_based":[5328,5351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p5328"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the reportSFTD-Meas is set to true within the corresponding reportConfigInterRAT for this measId:","paragraph_zero_based":5352},{"literal_text_all_w_t_and_m_t":"3>set the measResultSFTD-EUTRA in accordance with the following:","paragraph_zero_based":5353},{"literal_text_all_w_t_and_m_t":"4>set sfn-OffsetResult and frameBoundaryOffsetResult to the measurement results provided by lower layers;","paragraph_zero_based":5354},{"literal_text_all_w_t_and_m_t":"4>if the reportRSRP is set to true;","paragraph_zero_based":5355},{"literal_text_all_w_t_and_m_t":"5>set rsrpResult-EUTRA to the RSRP of the EUTRA PSCell;","paragraph_zero_based":5356},{"literal_text_all_w_t_and_m_t":"1>if average uplink PDCP delay values are available:","paragraph_zero_based":5357},{"literal_text_all_w_t_and_m_t":"2>set the ul-PDCP-DelayValueResultList to include the corresponding average uplink PDCP delay values;","paragraph_zero_based":5358},{"literal_text_all_w_t_and_m_t":"1>if PDCP excess delay measurements are available:","paragraph_zero_based":5359},{"literal_text_all_w_t_and_m_t":"2>set the ul-PDCP-ExcessDelayResultList to include the corresponding PDCP excess delay measurements;","paragraph_zero_based":5360},{"literal_text_all_w_t_and_m_t":"1>if the includeCommonLocationInfo is configured in the corresponding reportConfig for this measId and detailed location information that has not been reported is available, set the content of commonLocationInfo of the locationInfo as follows:","paragraph_zero_based":5361},{"literal_text_all_w_t_and_m_t":"2>include the locationTimestamp;","paragraph_zero_based":5362},{"literal_text_all_w_t_and_m_t":"2>include the locationCoordinate, if available;","paragraph_zero_based":5363},{"literal_text_all_w_t_and_m_t":"2>include the velocityEstimate, if available;","paragraph_zero_based":5364},{"literal_text_all_w_t_and_m_t":"2>include the locationError, if available;","paragraph_zero_based":5365},{"literal_text_all_w_t_and_m_t":"2>include the locationSource, if available;","paragraph_zero_based":5366},{"literal_text_all_w_t_and_m_t":"2>if available, include the gnss-TOD-msec,","paragraph_zero_based":5367},{"literal_text_all_w_t_and_m_t":"1>if the coarseLocationRequest is set to true in the corresponding reportConfig for this measId:","paragraph_zero_based":5368},{"literal_text_all_w_t_and_m_t":"2>include coarseLocationInfo, if available;","paragraph_zero_based":5369},{"literal_text_all_w_t_and_m_t":"1>if the includeWLAN-Meas is configured in the corresponding reportConfig for this measId, set the wlan-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5370},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultWLAN, in order of decreasing RSSI for WLAN APs;","paragraph_zero_based":5371},{"literal_text_all_w_t_and_m_t":"1>if the includeBT-Meas is configured in the corresponding reportConfig for this measId, set the BT-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5372},{"literal_text_all_w_t_and_m_t":"2>if available, include the LogMeasResultBT, in order of decreasing RSSI for Bluetooth beacons;","paragraph_zero_based":5373},{"literal_text_all_w_t_and_m_t":"1>if the includeSensor-Meas is configured in the corresponding reportConfig for this measId, set the sensor-LocationInfo of the locationInfo in the measResults as follows:","paragraph_zero_based":5374},{"literal_text_all_w_t_and_m_t":"2>if available, include the sensor-MeasurementInformation;","paragraph_zero_based":5375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b