d measObject includes the cca-CellsToAddModList:","paragraph_zero_based":4405},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the cca-CellsToAddModList:","paragraph_zero_based":4406},{"literal_text_all_w_t_and_m_t":"5>if an entry with the matching physCellId exists in the cca-CellsToAddModList:","paragraph_zero_based":4407},{"literal_text_all_w_t_and_m_t":"6>replace the entry with the value received for this physCellId;","paragraph_zero_based":4408},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":4409},{"literal_text_all_w_t_and_m_t":"6>add a new entry for the received physCellId to the cca-CellsToAddModList;","paragraph_zero_based":4410},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":4411},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received measObject to the measObjectList within VarMeasConfig.","paragraph_zero_based":4412},{"literal_text_all_w_t_and_m_t":"5.5.2.6Reporting configuration removal","paragraph_zero_based":4413},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4414},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":4415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a3922c0b91b3d4d92c5ae64ade48a301fcf63cb047d08e4522622b9eb40466ab","9c590e89b44eab26f41cbfdc8b985053204b107e676784f7b09eea2648e98256","2487e5577ff2c2f89cb84327fded86bea59a2bd55276b0f9b14e25b0a3e52f63","ad64710b15e16be7dad792a4fc57dcd3116ade3450a044d02a10c12d19ba283c","8397f4d78bcb415348708a5fab40bb59b6eed2c314fc465f4de8ff9ee888f3de","2cd86abd9bb7945dcedf45