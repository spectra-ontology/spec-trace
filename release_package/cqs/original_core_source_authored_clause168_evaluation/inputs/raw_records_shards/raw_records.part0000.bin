{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC information element","paragraph_zero_based":15456},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15457},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-START","paragraph_zero_based":15458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15459},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC  ::=    SEQUENCE {","paragraph_zero_based":15460},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-eutra-epc             PLMN-IdentityList-EUTRA-EPC,","paragraph_zero_based":15461},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-epc              BIT STRING (SIZE (16)),","paragraph_zero_based":15462},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-epc                  BIT STRING (SIZE (28))","paragraph_zero_based":15463},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15465},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList-EUTRA-EPC::=          SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity","paragraph_zero_based":15466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15467},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-STOP","paragraph_zero_based":15468},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15470},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":15471},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":15472},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":15473},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15474},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":15475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15476},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":15477},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":15478},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":15479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c043f8a089acd02adc10ada484728db816e931a032c40336f9eb65ba06423cff","95283d83f16b3847537a804967da8e9506201cb26af7e773b45253e5b43bd3fa","2bd766c28294d7cada48faeabee462327b4ed19e9af65e8f0adc130ececeb16f","41287065350dd26fcad9a8f0f8061359db9f82937ddca61ee85039fcb7a05901","97ea171426abfaaff821df9ec0d5c4d39b122bc6f1a511eefc30dec626e564f6","8dd7d884328336a904236805c35ef16dbc8d2e32ecf1fb8daec82be98b8a5a44","f19cee69f33ebf22d6c26d77baeaaef25a4d1fc4a101945c87e58ec5ecc0445e","af8fbbdeaf3104b672f9f82cc124f25f7dfd4c921e26f8b5c9abe9481c63fccf","3aa09bb5ca7944f07853ce37e1e43619d50bbfb56ebb83d364d1894aa5d89337","69d53dd55a9b60e0c7dae44828e6e95a1417101078e0ecaf3b929d6ea5296823","51e3a67fc5aab827949d7f9f2fbbd2c112c1cee5035185e2edf03e94d8dc6cfa","e59e9c53cefd235c1b4cfe2838d60b428369591e0e283252d0398f1198af189e","1afa3483767bdbb797168f90136a809b4a2d16006bf8a13b48f3eceeabce673c","ecdcaefac100c08ee1eb08c2e249ad