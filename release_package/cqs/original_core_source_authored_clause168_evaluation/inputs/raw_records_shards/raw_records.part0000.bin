{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to cli-EventTriggered and if the entry condition applicable for this event, i.e. the event corresponding with the eventId of the corresponding reportConfig within VarMeasConfig, is fulfilled for one or more CLI measurement resources not included in the cli-TriggeredList for all measurements after layer 3 filtering taken during timeToTrigger defined for this event within the VarMeasConfig (a subsequent CLI measurement resource triggers the event):","paragraph_zero_based":4848},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4849},{"literal_text_all_w_t_and_m_t":"3>include the concerned CLI measurement resource(s) in the cli-TriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4850},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4851},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to cli-EventTriggered and if the leaving condition applicable for this event is fulfilled for one or more of the CLI measurement resources included in the cli-TriggeredList defined within the VarMeasReportList for this measId for all measurements after layer 3 filtering taken during timeToTrigger defined within the VarMeasConfig for this event:","paragraph_zero_based":4852},{"literal_text_all_w_t_and_m_t":"3>remove the concerned CLI measurement resource(s) in the cli-TriggeredList defined within the VarMeasReportList for this measId;","paragraph_zero_based":4853},{"literal_text_all_w_t_and_m_t":"3>if reportOnLeave is set to true for the corresponding reporting configuration:","paragraph_zero_based":4854},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4855},{"literal_text_all_w_t_and_m_t":"3>if the cli-TriggeredList defined within the VarMeasReportList for this measId is empty:","paragraph_zero_based":4856},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4857},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer for this measId, if running;","paragraph_zero_based":4858},{"literal_text_all_w_t_and_m_t":"2>if reportType is set to cli-Periodical and if a (first) measurement result is available:","paragraph_zero_based":4859},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4860},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4861},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5, immediately after the quantity to be reported becomes available for at least one CLI measurement resource;","paragraph_zero_based":4862},{"literal_text_all_w_t_and_m_t":"2>if reportType is set to rxTxPeriodical and if a (first) measurement result is available:","paragraph_zero_based":4863},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4864},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4865},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4866},{"literal_text_all_w_t_and_m_t":"2>upon expiry of the periodical reporting timer for this measId:","paragraph_zero_based":4867},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":4868},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig includes a reportType is set to reportSFTD:","paragraph_zero_based":4869},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":4870},{"literal_text_all_w_t_and_m_t":"4>if the drx-SFTD-NeighMeas is included:","paragraph_zero_based":4871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["ffdc5aab15a5fd3bae0138dbae65ebc9b35aff6e14e9f8b5eaed8b2667ef5de4","6b7008db32e4cc5d4890cff74389d2949f88e9e050dafa003e4734cdcec4d7a1","f8feeab929c6d3982fcee84dbbf110dfdf2a475cc687858dc33ae243198f8d8b","cadd017c863fd4e1a3797869fb3c4ae8fc46e7c1fc25d20d05a3d38328b3710f","db3444e823aa6414f690d1a55228a124de10b23251499647107f900cb3ba2e0d","c89980be5c1e3ac90f24600bb43a37729876754aed4f027071c0edd2d2453e61","ec214a0a9673adb5403569e8d6154563842e4cecf631dd632bcd3df3d726b8ee","a0e75bbbff085e03dcf837c483878ed4f64bb322005765ef3fc96c7cb2ac469c","0988460753c6b037072aad43719b0241c11c218088825b0c56dea54afd86b002","a510bdac07a226a801964752f552d00e6deb293c931f156fd2886063ecd9ba43","d05127b2f90661cb9a2a7fd9859401f10590bd5b80d73c3f314e88fac2b1c8f6","d7b599f2586fccba45ce1b0f37e6d7be080b3d187c0f869af724602d07f12cb6","2aa77ce6cdb49ae8e24b4318ad8753687074ff897f171e1dc6b0ec8a96a62845","921ca75932a4f2895b7b209127bcca6638d6f89074c705137522259beed83257","a0d42d8dbc978e133495aa51594ebcd0c132462cafc131c761c514ab1bfa7f4a","9707b7c14750342c6f87554cbbc36968da962ef518c4b402440ed256dc7873bb","6680b686cf386a12e56682e4facd1c543476d7fc518ce5c9f162a7cbedb6b879","fbdbc2ea6896d73a4f0cded06192d8148b6e168b26670870004960ae04f95dd6","87e686d18ca1dda1f50d9718a794a4d8e08252458c5d86ecb1539b5cda414735","3709ff1018a17abf3a1058a14acf2eaeb41d67de5cddbaccd5b84abf8fb02480","81bd90f08ad4ac2b26dcaf76b3597dd6c3388b5ca632961b624d14d9cc4c34fb","eeedbb82c6c97b5e56ac51372baa7d8b9b7c4926e4901c6623f619c39a820923","ae973136a3ab1b6c399ed0719b5c1cfed6ef87e76eddf360c0f301fc7db946f7","8c7f4249827565a9eb0fe49616402994125ac723971b88e79e0df45c4f62ea7c"],"paragraph_range_zero_based":[4848,4871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p4848"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the quantity to be reported becomes available for each requested pair of PCell and NR cell:","paragraph_zero_based":4872},{"literal_text_all_w_t_and_m_t":"6>stop timer T322;","paragraph_zero_based":4873},{"literal_text_all_w_t_and_m_t":"6>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4874},{"literal_text_all_w_t_and_m_t":"4>else","paragraph_zero_based":4875},{"literal_text_all_w_t_and_m_t":"5>initiate the measurement reporting procedure, as specified in 5.5.5, immediately after the quantity to be reported becomes available for each requested pair of PCell and NR cell or the maximal measurement reporting delay as specified in TS 38.133 [14];","paragraph_zero_based":4876},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":4877},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5, immediately after the quantity to be reported becomes available for the pair of PCell and E-UTRA PSCell or the maximal measurement reporting delay as specified in TS 38.133 [14];","paragraph_zero_based":4878},{"literal_text_all_w_t_and_m_t":"2>if reportType is set to reportCGI:","paragraph_zero_based":4879},{"literal_text_all_w_t_and_m_t":"3>if the UE acquired the SIB1 or SystemInformationBlockType1 for the requested cell; or","paragraph_zero_based":4880},{"literal_text_all_w_t_and_m_t":"3>if the UE detects that the requested NR cell is not transmitting SIB1 (see TS 38.213 [13], clause 13):","paragraph_zero_based":4881},{"literal_text_all_w_t_and_m_t":"4>stop timer T321;","paragraph_zero_based":4882},{"literal_text_all_w_t_and_m_t":"4>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4883},{"literal_text_all_w_t_and_m_t":"4>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4884},{"literal_text_all_w_t_and_m_t":"4>initiate the measurement reporting procedure, as specified in 5.5.5;","paragraph_zero_based":4885},{"literal_text_all_w_t_and_m_t":"2>upon the expiry of T321 for this measId:","paragraph_zero_based":4886},{"literal_text_all_w_t_and_m_t":"3>include a measurement reporting entry within the VarMeasReportList for this measId;","paragraph_zero_based":4887},{"literal_text_all_w_t_and_m_t":"3>set the numberOfReportsSent defined within the VarMeasReportList for this measId to 0;","paragraph_zero_based":4888},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":4889},{"literal_text_all_w_t_and_m_t":"2>upon the expiry of T322 for this measId:","paragraph_zero_based":4890},{"literal_text_all_w_t_and_m_t":"3>initiate the measurement reporting procedure, as specified in 5.5.5.","paragraph_zero_based":4891},{"literal_text_all_w_t_and_m_t":"5.5.4.2Event A1 (Serving becomes better than threshold)","paragraph_zero_based":4892},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":4893},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition A1-1, as specified below, is fulfilled;","paragraph_zero_based":4894},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition A1-2, as specified below, is fulfilled;","paragraph_zero_based":4895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b