{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–NR-Multi-RTT-ProvideAssistanceData","paragraph_zero_based":1824},{"literal_text_all_w_t_and_m_t":"The IE NR-Multi-RTT-ProvideAssistanceData is used by the location server to provide assistance data to enable UEassisted NR Multi-RTT. It may also be used to provide NR Multi-RTT positioning specific error reason.","paragraph_zero_based":1825},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1827},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-ProvideAssistanceData-r16 ::= SEQUENCE {","paragraph_zero_based":1828},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceData-r16NR-DL-PRS-AssistanceData-r16OPTIONAL,-- Need ON","paragraph_zero_based":1829},{"literal_text_all_w_t_and_m_t":"nr-SelectedDL-PRS-IndexList-r16NR-SelectedDL-PRS-IndexList-r16OPTIONAL,-- Need ON","paragraph_zero_based":1830},{"literal_text_all_w_t_and_m_t":"nr-Multi-RTT-Error-r16NR-Multi-RTT-Error-r16OPTIONAL,-- Need ON","paragraph_zero_based":1831},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1832},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1833},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-r17NR-On-Demand-DL-PRS-Configurations-r17","paragraph_zero_based":1834},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Need ON","paragraph_zero_based":1835},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-Selected-IndexList-r17","paragraph_zero_based":1836},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Configurations-Selected-IndexList-r17","paragraph_zero_based":1837},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Need ON","paragraph_zero_based":1838},{"literal_text_all_w_t_and_m_t":"assistanceDataValidityArea-r17AreaID-CellList-r17OPTIONAL-- Need ON","p