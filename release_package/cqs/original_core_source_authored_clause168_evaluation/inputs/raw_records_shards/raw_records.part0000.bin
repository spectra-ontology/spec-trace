{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"xN-ThresholdM","paragraph_zero_based":26376},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event xN. If multiple thresholds are defined for event number xN, the thresholds are differentiated by M. x1-Threshold1 and x2-Threshold indicates the threshold value for the serving L2 U2N Relay UE, x1-Threshold2 indicates the threshold value for the NR Cells.","paragraph_zero_based":26377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26378},{"literal_text_all_w_t_and_m_t":"CLI-EventTriggerConfig field descriptions","paragraph_zero_based":26379},{"literal_text_all_w_t_and_m_t":"i1-Threshold","paragraph_zero_based":26380},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. SRS-RSRP, CLI-RSSI) to be used in CLI measurement report triggering condition for event i1.","paragraph_zero_based":26381},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":26382},{"literal_text_all_w_t_and_m_t":"Choice of CLI event triggered reporting criteria.","paragraph_zero_based":26383},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":26384},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":26385},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26386},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":26387},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":26388},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a CLI measurement resource in srsTriggeredList or rssiTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":26389},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":26390},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":26391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26392},{"literal_text_all_w_t_and_m_t":"CLI-PeriodicalReportConfig field descriptions","paragraph_zero_based":26393},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":26394},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":26395},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":26396},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":26397},{"literal_text_all_w_t_and_m_t":"reportQuantityCLI","paragraph_zero_based":26398},{"literal_text_all_w_t_and_m_t":"The CLI measurement quantities to be included in the measurement report.","paragraph_zero_based":26399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4865afde03382dc5a493c0f2cd7fd2c463cda9361957a53ef88a789c0d083c9d","c7cde2cf408585b3c398bfff2083b8640f892177b71d1e7d649f2a5c7e12130a","4cde10723759a6a0b31819b753de8a0f142529a735decd80a64cf0aeb58e32ea","4aa9084800124ac8d153ffb55d3f0357756868a59bdc8fdd53cb70348c228b43","ff86f167f4d40e4c34e35a06796c1bc9f6bcf945890cae7c9a8cfb145124ac60","9b015303c67a25067665a7536b9088d167157af0464dd462231a5e724dc51f68","a0b5f71030eb031900e0a6f4b722eb14cc734769