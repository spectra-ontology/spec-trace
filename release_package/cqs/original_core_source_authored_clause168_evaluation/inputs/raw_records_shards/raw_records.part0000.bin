{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RSRP-Range-r16 ::=                  INTEGER (0..13)","paragraph_zero_based":39624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39625},{"literal_text_all_w_t_and_m_t":"SL-SSB-TimeAllocation-r16 ::=          SEQUENCE {","paragraph_zero_based":39626},{"literal_text_all_w_t_and_m_t":"    sl-NumSSB-WithinPeriod-r16             ENUMERATED {n1, n2, n4, n8, n16, n32, n64}                          OPTIONAL,    -- Need R","paragraph_zero_based":39627},{"literal_text_all_w_t_and_m_t":"    sl-TimeOffsetSSB-r16                   INTEGER (0..1279)                                                   OPTIONAL,    -- Need R","paragraph_zero_based":39628},{"literal_text_all_w_t_and_m_t":"    sl-TimeInterval-r16                    INTEGER (0..639)                                                    OPTIONAL     -- Need R","paragraph_zero_based":39629},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39631},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SYNCCONFIG-STOP","paragraph_zero_based":39632},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39634},{"literal_text_all_w_t_and_m_t":"SL-SyncConfig field descriptions","paragraph_zero_based":39635},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":39636},{"literal_text_all_w_t_and_m_t":"If configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to GNSS. If not configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to eNB/gNB.","paragraph_zero_based":39637},{"literal_text_all_w_t_and_m_t":"sl-SyncRefMinHyst","paragraph_zero_based":39638},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using absolute comparison.","paragraph_zero_based":39639},{"literal_text_all_w_t_and_m_t":"sl-SyncRefDiffHyst","paragraph_zero_based":39640},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using relative comparison.","paragraph_zero_based":39641},{"literal_text_all_w_t_and_m_t":"sl-NumSSB-WithinPeriod","paragraph_zero_based":39642},{"literal_text_all_w_t_and_m_t":"Indicates the number of sidelink SSB transmissions within one sidelink SSB period. The applicable values are related to the subcarrier spacing and frequency as follows:","paragraph_zero_based":39643},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 15 kHz: 1","paragraph_zero_based":39644},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 30 kHz: 1, 2","paragraph_zero_based":39645},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 60 kHz: 1, 2, 4","paragraph_zero_based":39646},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 60 kHz: 1, 2, 4, 8, 16, 32","paragraph_zero_based":39647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1a215e50b3230d9fb21f039ab002c4ae53afcef5fbc35c05d75904e60de008ef","310d56e987d3af1d15b2c73be020f4f2e11511503a1cea4a29ac2a3786e72056","3bef1841b47089fd533f96679d651a2dba86cbdfa24c2bdecdfbebc7ceab7311","dfb441957bb9334d22376a9cb64020c4381d8a9a0ad4d305baee142778071d7f","acc7c56dd4e7b39d8bc74fefe6837a396fc52a0eee7b5f88bb594a16846a7bc6","622f1125a71e3230700c0ac574b668000871bfea1f6a8e7a572c991dc1f1bd61","e41fedbff8ace332c23d26e17db8420e6c10f2d81e6017bb65ce0a295fbe37a5","9389a07684a2fe294ceb7b3ffb06de87a084030ee3d8ea4e15b6c5038c817739","c0e78923e7a0aa5b1d3c55dab9bd366134215be1379e86d23e9fac1729b9c064","10f485c62d0a6b83aff7af1b0a419e406807f08620fb5ef446e2fd3c0f0f1f4e","289e03cf77c0e49ecd58bedc535276a0fa3ba9e6a46bd612e4bbcd6343e5dec3","6bd439249f04dfb0b62ab431bd1674e126dfaddec81360e40eaf9a041286a7cb","7a0f0f6311c795e4fb9c4f4c81507ec41bee9b4e665fc547c4d68567adc28c0f","3dd59218c9d56e5e5960af8bf7499980309a477d6df8f25848483d4260508243","082e1c81194c703b975c880ab3dbd259b17db4b1e6325bbd8078297204ea1eb8","125dc375b8a0c513a3af017b2673f7bb4616ccc6c44df2d223dffd96c505791d","9b204f08dfbd7315790ae9ec32b2c8d32cfa11e47c1f564fbc3a1728a58702de","50a3f18d57b989b3a8a83f10fed42bf645e31182050603698b3a7d6528d9a235","5adc543096d809283dc05887b1753bb1651083166384db9ad2783a8b88a1c527","d5c1b40b7190db585205c247ad5646723dca90d06af3ee8a60dd5d7159becb96","df5d681cc7ef2983c92c994826af8bbcfaf23ce425a837b039112d5ecb362895","25e3574950cdbafd38f20762b19f199d10c72484163d8b3ccb58f7b16d3ec438","b0c88a78ead7d8604560247b88f9d65a3c0a9f97860f0d34b827af87056a8359","55711647d8a5c98bd94c6353055b1e439a01c515dfaecbbe2d881a853d265f97"],"paragraph_range_zero_based":[39624,39647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39624"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR2, SCS = 120 kHz: 1, 2, 4, 8, 16, 32, 64","paragraph_zero_based":39648},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetSSB","paragraph_zero_based":39649},{"literal_text_all_w_t_and_m_t":"Indicates the slot offset from the start of sidelink SSB period to the first sidelink SSB.","paragraph_zero_based":39650},{"literal_text_all_w_t_and_m_t":"sl-TimeInterval","paragraph_zero_based":39651},{"literal_text_all_w_t_and_m_t":"Indicates the slot interval between neighboring sidelink SSBs. This value is applicable when there are more than one sidelink SSBs within one sidelink SSB period.","paragraph_zero_based":39652},{"literal_text_all_w_t_and_m_t":"sl-SSID","paragraph_zero_based":39653},{"literal_text_all_w_t_and_m_t":"Indicates the ID of sidelink synchronization signal associated with different synchronization priorities.","paragraph_zero_based":39654},{"literal_text_all_w_t_and_m_t":"syncInfoReserved","paragraph_zero_based":39655},{"literal_text_all_w_t_and_m_t":"Reserved for future use.","paragraph_zero_based":39656},{"literal_text_all_w_t_and_m_t":"syncTxThreshIC, syncTxThreshOoC","paragraph_zero_based":39657},{"literal_text_all_w_t_and_m_t":"Indicates the thresholds used while in coverage and out of coverage, respectively. Value 0 corresponds to -infinity, value 1 to -115 dBm, value 2 to -110 dBm, and so on (i.e. in steps of 5 dBm) until value 12, which corresponds to -60 dBm, while value 13 corresponds to +infinity.","paragraph_zero_based":39658},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39659},{"literal_text_all_w_t_and_m_t":"–SL-Thres-RSRP-List","paragraph_zero_based":39660},{"literal_text_all_w_t_and_m_t":"IE SL-Thres-RSRP-List indicates a threshold used for sensing based UE autonomous resource selection (see TS 38.215 [9]). A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above the threshold defined by IE SL-Thres-RSRP-List. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":39661},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List information element","paragraph_zero_based":39662},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39663},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-START","paragraph_zero_based":39664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39665},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-List-r16 ::=    SEQUENCE (SIZE (64)) OF SL-Thres-RSRP-r16","paragraph_zero_based":39666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39667},{"literal_text_all_w_t_and_m_t":"SL-Thres-RSRP-r16 ::=         INTEGER (0..66)","paragraph_zero_based":39668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39669},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-THRES-RSRP-LIST-STOP","paragraph_zero_based":39670},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3b134aefc88ee99a4be5148d5f408d234faab9fdf933c83ef04bf6140348cb6c","d7ab29e741ffa09e5de480262ecc44e40dbdcad3676842b7f29f0f7e94ec70af","165d40ea43c2a444aeeac2550dd110d3ff44a88b3d8baa79995abd9a60f7c20e","1768305e3a188d7a21d2a1d719388d3f6a86cd6b58696e078d58818b03bf24af","efd6c75c62d9248b604202729e51567c05fd01c740d7cfc23c96d1ec838a1179","3dc30ff4d53f3415cf20503916e9