{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"needForGapNCSG-InfoEUTRA","paragraph_zero_based":10272},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap and NCSG requirement information of the UE for EUTRA target bands.","paragraph_zero_based":10273},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-InfoNR","paragraph_zero_based":10274},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the measurement gap and NCSG requirement information of the UE for NR target bands.","paragraph_zero_based":10275},{"literal_text_all_w_t_and_m_t":"scg-Response","paragraph_zero_based":10276},{"literal_text_all_w_t_and_m_t":"In case of NR-DC (nr-SCG-Response), this field includes the RRCReconfigurationComplete message. In case of NE-DC (eutra-SCG-Response), this field includes the E-UTRA RRCConnectionReconfigurationComplete message as specified in TS 36.331 [10].","paragraph_zero_based":10277},{"literal_text_all_w_t_and_m_t":"selectedCondRRCReconfig","paragraph_zero_based":10278},{"literal_text_all_w_t_and_m_t":"This field indicates the ID of the selected conditional reconfiguration the UE applied upon the execution of CPA or inter-SN CPC.","paragraph_zero_based":10279},{"literal_text_all_w_t_and_m_t":"uplinkTxDirectCurrentList","paragraph_zero_based":10280},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for the configured serving cells and BWPs if requested by the NW (see reportUplinkTxDirectCurrent in CellGroupConfig).","paragraph_zero_based":10281},{"literal_text_all_w_t_and_m_t":"uplinkTxDirectCurrentMoreCarrierList","paragraph_zero_based":10282},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for the configured intra-band CA requested by reportUplinkTxDirectCurrentMoreCarrier-r17.","paragraph_zero_based":10283},{"literal_text_all_w_t_and_m_t":"uplinkTxDirectCurrentTwoCarrierList","paragraph_zero_based":10284},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for the configured uplink intra-band CA with two carriers if requested by the NW (see reportUplinkTxDirectCurrentTwoCarrier-r16 in CellGroupConfig).","paragraph_zero_based":10285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10286},{"literal_text_all_w_t_and_m_t":"–RRCReject","paragraph_zero_based":10287},{"literal_text_all_w_t_and_m_t":"The RRCReject message is used to reject an RRC connection establishment or an RRC connection resumption.","paragraph_zero_based":10288},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":10289},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":10290},{"literal_text_all_w_t_and_m_t":"Logical channel: CCCH","paragraph_zero_based":10291},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":10292},{"literal_text_all_w_t_and_m_t":"RRCReject message","paragraph_zero_based":10293},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":10294},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCREJECT-START","paragraph_zero_based":10295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7b535c1ef42d1262216a6c1e81cca6715375deccf1d3f6ce617e8f99f7cf9db5","7b27154c6b995e37708d08b1e13af7bc7f271f65b466c23c9bc8557c27a10f0c","819f8f77489edfdb6c026c0e142c4d1dd2fa40592b5b342a54bd6cde8e7b494e","df6a199b07d81ae26327f916d04178ea6041be353c824f5eb27a8c27ec4f2d69","8e5b8ed81124e3127dc8284933c5a70b188c7acc34a90561432b9d29163977e8","6c85fe6378adfc7eb21cfef3b25e000b77a3f6854be97299343cad685e9fb593","4ab308795231e419e7900014685e