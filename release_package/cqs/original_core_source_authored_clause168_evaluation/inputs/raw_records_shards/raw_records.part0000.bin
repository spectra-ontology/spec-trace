{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30120},{"literal_text_all_w_t_and_m_t":"UplinkCancellation field descriptions","paragraph_zero_based":30121},{"literal_text_all_w_t_and_m_t":"ci-ConfigurationPerServingCell","paragraph_zero_based":30122},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the ci-PaylaodSize bit CI values inside the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30123},{"literal_text_all_w_t_and_m_t":"ci-RNTI","paragraph_zero_based":30124},{"literal_text_all_w_t_and_m_t":"RNTI used for indication cancellation in UL (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30125},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeForCI","paragraph_zero_based":30126},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with CI-RNTI (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30128},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell field descriptions","paragraph_zero_based":30129},{"literal_text_all_w_t_and_m_t":"ci-PayloadSize","paragraph_zero_based":30130},{"literal_text_all_w_t_and_m_t":"Configures the field size for each UL cancelation indicator of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30131},{"literal_text_all_w_t_and_m_t":"deltaOffset","paragraph_zero_based":30132},{"literal_text_all_w_t_and_m_t":"Configures the additional offset from the end of a PDCCH reception where the UE detects the DCI format 2_4 and the first symbol of the T_\"CI\" symbols, in the unit of OFDM symbols (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30133},{"literal_text_all_w_t_and_m_t":"frequencyRegionForCI","paragraph_zero_based":30134},{"literal_text_all_w_t_and_m_t":"Configures the reference frequency region where a detected UL CI is applicable (see TS 38.213 [13], clause 11.2A). It is defined in the same way as locationAndBandwidth.","paragraph_zero_based":30135},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":30136},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30137},{"literal_text_all_w_t_and_m_t":"positionInDCI-ForSUL","paragraph_zero_based":30138},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for SUL of this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30139},{"literal_text_all_w_t_and_m_t":"timeDurationForCI","paragraph_zero_based":30140},{"literal_text_all_w_t_and_m_t":"Configures the duration of the reference time region in symbols where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A). If the field is absent, i.e., the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is larger than 1 slot or 1 slot with only one monitoring occasion, the UE applies the value of the configured UL CI monitoring periodicity,","paragraph_zero_based":30141},{"literal_text_all_w_t_and_m_t":"timeFrequencyRegion","paragraph_zero_based":30142},{"literal_text_all_w_t_and_m_t":"Configures the reference time and frequency region where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["da97a67f29a16aea98c8a445bd77ad1c798c55f18952c56d9810756d323c4b25","cf44b8d82a2fb6b8b6872524eec30c10ecbb1378cf2e09a0f9075b77a77e896c","9a138a4fafc4f80b118934c4d797f5d268de8600c10945b7146494a1154b4112","f133c4eb6ee329579944a6161cccd8582298052459e0fbdc41c46d4565c73cc4","f492dc6ae66baaaa21b8e3b34a629733bc7c734f6231ffb9d4a4639619b92721","35ad5be251d579cd7b6f7d2255405caac6b752ab875e359f7696c00b57ac4c5e","5cccb2a3a251cb760b2a20c5e1a5e12b1987a45af1d97ab1d4147b21beb4dd5b","732f3470e91b001a28679367b36df7cd471d5eacb6f3cdbb8a3895884fa2d1d1","08ba847d2947bf54a4f2d13104cb85c356c076b6337c5867e0a6f6d70ff02525","b10387197265807da727108a8a471349585ef1ed214dfafe6347a0fad7a4712c","2290302f6e59760623ac518299574fcf9354a9682412b229b6110a3c5fbe4df8","396979585b5619aedc7c80e0a0f2fdcba7d96e41460f2cee1b8ab4c1d3c3c85f","525df305f5c65943dec7be720d4a581234e4a0d6c4896d327bc6b8be3f159420","42a166916ce3eff960298a443a9a251892cfef63189f4d638c9504c128af300f","d80d9db09c3a941fd99bcc9694d491e1ff8de2485ef684f38e4b3c3729001a0f","3c6e1817a2055cadda6004bcf99196843a477930c971e66cf668246427cc9d99","55afbecdf0d8c0818861de57827283ad2faa419ab8cc3a044dd5c37d185611c7","b69c003f6baacdf5da664f5b88a496f31d24cf73814d81faad1e9dca5346120b","516b209e9f6290525b1b5f81a08cef02045c522edc403ae22d4a6d3f2fa4762c","6e81f4426a9a16fb107c5cc1934f786e0bff534bd472a5e8ad37820dfbddc9bc","faf1d24db3863878eb2b2440266e95228b1e549df9cb4f488daea209c827b1cd","b95583ade21f9fc427b6b4882fa03fbf11632afffe3c6a3be2a2183a16eb93cd","79eef51b6884147457f6dfb3c21d2ed1e73ee4b32b947b81101037411a2a8300","48421af1348bca189f353b7d356acf2e72a58dff0d549b490075d1d7df4b865a"],"paragraph_range_zero_based":[30120,30143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p30120"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"timeGranularityForCI","paragraph_zero_based":30144},{"literal_text_all_w_t_and_m_t":"Configures the number of partitions within the time region of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30145},{"literal_text_all_w_t_and_m_t":"uplinkCancellationPriority","paragraph_zero_based":30146},{"literal_text_all_w_t_and_m_t":"Configures uplink cancellation behavior if both UL CI and intra-UE priority indicator are configured for a given UE. If the field is present, then UL CI is only applicable to the UL transmissions indicated/configured as low priority level. If the field is absent, UL CI is applicable to UL transmission irrespective of its priority level (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":30147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30148},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30149},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30150},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":30151},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfig. It is absent otherwise.","paragraph_zero_based":30152},{"literal_text_all_w_t_and_m_t":"SymbolPeriodicity","paragraph_zero_based":30153},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is 1 slot with more than one monitoring occasion, otherwise absent.","paragraph_zero_based":30154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30155},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommon","paragraph_zero_based":30156},{"literal_text_all_w_t_and_m_t":"The IE UplinkConfigCommon provides common uplink parameters of a cell.","paragraph_zero_based":30157},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon information element","paragraph_zero_based":30158},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30159},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-START","paragraph_zero_based":30160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30161},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon ::=              SEQUENCE {","paragraph_zero_based":30162},{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL                     FrequencyInfoUL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":30163},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP                    BWP-UplinkCommon                                OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":30164},{"literal_text_all_w_t_and_m_t":"    dummy                               TimeAlignmentTimer","paragraph_zero_based":30165},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5a40a18be3115a2769789501599656fc4eb00e6ba4cb2138215642027701e223","4be035be1e91bc63fdfa503f482c0d75fb33bd9e7c645027956dea1c87c99bf6","55465f9ce904762707cce61468fbe12262ea89002ebcb1479f323c78f6e6d365","b2804caca33f2d4523fe491ad6bcab0da5383e171b81cdeca78673e80dcd024d","85982962d17357199d639a0cfe7a22996720b5c574e4b8abe4a797c9ad781845","4a3681635fcd11d7a9e0a98dbd4a19cbb046da2395cfa7b6521b419f7568da9e","0b1f5c72d061a8d791b0b6c85f507a4a4f6a38