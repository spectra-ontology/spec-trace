{"fields":{"filename":"R2-2306827.zip::R2-2306827.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"A L2 U2N remote UE may be unable to perform downlink positioning and will be unable to request posSIBs.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"5.8.9.1.1, 5.8.9.1.2, 5.8.9.8.1, 5.8.9.8.2, 5.8.9.8.3, 5.8.9.9.2, 6.6.2","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"TS 38.305 CR XXXX","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"TS 37.355 CR XXXX","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"TS 38.306 CR XXXX ","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":" Test specifications","paragraph_zero_based":95}],"source":"Whole authen