{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For each Uu-RelayRLC-ChannelConfig received in the uu-RelayRLC-ChannelToAddModList the L2 U2N Relay UE shall:","paragraph_zero_based":2040},{"literal_text_all_w_t_and_m_t":"1>if the current configuration contains a Uu Relay RLC channel with the same uu-RelayRLC-ChannelID within the same cell group:","paragraph_zero_based":2041},{"literal_text_all_w_t_and_m_t":"2>if reestablishRLC is received:","paragraph_zero_based":2042},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":2043},{"literal_text_all_w_t_and_m_t":"2>reconfigure the RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2044},{"literal_text_all_w_t_and_m_t":"2>reconfigure the logical channel in accordance with the received mac-LogicalChannelConfig;","paragraph_zero_based":2045},{"literal_text_all_w_t_and_m_t":"1>else (a logical channel with the given uu-RelayRLC-ChannelID was not configured before within the same cell group):","paragraph_zero_based":2046},{"literal_text_all_w_t_and_m_t":"2>establish an RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2047},{"literal_text_all_w_t_and_m_t":"2>configure this MAC entity with a logical channel in accordance to the received mac-LogicalChannelConfig.","paragraph_zero_based":2048},{"literal_text_all_w_t_and_m_t":"5.3.5.6Radio Bearer configuration","paragraph_zero_based":2049},{"literal_text_all_w_t_and_m_t":"5.3.5.6.1General","paragraph_zero_based":2050},{"literal_text_all_w_t_and_m_t":"The UE shall perform the following actions based on a received RadioBearerConfig IE:","paragraph_zero_based":2051},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the srb3-ToRelease or srb4-ToRelease:","paragraph_zero_based":2052},{"literal_text_all_w_t_and_m_t":"2>perform the SRB release as specified in 5.3.5.6.2;","paragraph_zero_based":2053},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the srb-ToAddModList or if any DAPS bearer is configured:","paragraph_zero_based":2054},{"literal_text_all_w_t_and_m_t":"2>perform the SRB addition or reconfiguration as specified in 5.3.5.6.3;","paragraph_zero_based":2055},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the drb-ToReleaseList:","paragraph_zero_based":2056},{"literal_text_all_w_t_and_m_t":"2>perform DRB release as specified in 5.3.5.6.4;","paragraph_zero_based":2057},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the drb-ToAddModList:","paragraph_zero_based":2058},{"literal_text_all_w_t_and_m_t":"2>perform DRB addition or reconfiguration as specified in 5.3.5.6.5;","paragraph_zero_based":2059},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the mrb-ToReleaseList:","paragraph_zero_based":2060},{"literal_text_all_w_t_and_m_t":"2>perform multicast MRB release as specified in 5.3.5.6.6;","paragraph_zero_based":2061},{"literal_text_all_w_t_and_m_t":"1>if the RadioBearerConfig includes the mrb-ToAddModList:","paragraph_zero_based":2062},{"literal_text_all_w_t_and_m_t":"2>perform multicast MRB addition or reconfiguration as specified in 5.3.5.6.7;","paragraph_zero_based":2063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["122ae922da7fc0537770aa5989e30d9e042c14e85c8c726b42a987b9fa5caa7e","b924f3d275f5f4aabd4e22add8cebdf0ab10ecaabd98ac00e1bb151a4ac7a8a0","b026424114dcbacc98a0197f726b8fab929b07d3f271e3e15f73821a359249b2","adda7309c0df8c2c39a65e20ca19452107b5ffecb1fc1e709f5