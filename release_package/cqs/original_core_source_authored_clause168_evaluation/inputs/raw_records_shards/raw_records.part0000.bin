{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR measurement results performed during RRC_INACTIVE or RRC_IDLE.","paragraph_zero_based":12360},{"literal_text_all_w_t_and_m_t":"ra-ReportList","paragraph_zero_based":12361},{"literal_text_all_w_t_and_m_t":"This field is used to provide the list of RA reports that is stored by the UE for the past upto maxRAReport-r16 number of successful random access procedures, or failed or successful completion of on-demand system information request procedure.","paragraph_zero_based":12362},{"literal_text_all_w_t_and_m_t":"rlf-Report","paragraph_zero_based":12363},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the RLF report related contents.","paragraph_zero_based":12364},{"literal_text_all_w_t_and_m_t":"successHO-Report","paragraph_zero_based":12365},{"literal_text_all_w_t_and_m_t":"This field is used to provide the successful handover report if triggered based on the successful handover configuration.","paragraph_zero_based":12366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12367},{"literal_text_all_w_t_and_m_t":"LogMeasReport field descriptions","paragraph_zero_based":12368},{"literal_text_all_w_t_and_m_t":"absoluteTimeStamp","paragraph_zero_based":12369},{"literal_text_all_w_t_and_m_t":"Indicates the absolute time when the logged measurement configuration logging is provided, as indicated by NR within absoluteTimeInfo.","paragraph_zero_based":12370},{"literal_text_all_w_t_and_m_t":"anyCellSelectionDetected","paragraph_zero_based":12371},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the detection of any cell selection state, as defined in TS 38.304 [20]. The UE sets this field when performing the logging of measurement results in RRC_IDLE or RRC_INACTIVE and there is no suitable cell or no acceptable cell.","paragraph_zero_based":12372},{"literal_text_all_w_t_and_m_t":"inDeviceCoexDetected","paragraph_zero_based":12373},{"literal_text_all_w_t_and_m_t":"Indicates that measurement logging is suspended due to IDC problem detection.","paragraph_zero_based":12374},{"literal_text_all_w_t_and_m_t":"measResultServingCell","paragraph_zero_based":12375},{"literal_text_all_w_t_and_m_t":"This field refers to the log measurement results taken in the Serving cell.","paragraph_zero_based":12376},{"literal_text_all_w_t_and_m_t":"numberOfGoodSSB","paragraph_zero_based":12377},{"literal_text_all_w_t_and_m_t":"Indicates the number of good beams (beams that are above absThreshSS-BlocksConsolidation, if configured by the network) associated to the cells within the R value range (which is configured by network for cell reselection) of the highest ranked cell as part of the beam level measurements. If the UE has no SSB of a neighbour cell whose measurement quantity is above the absThreshSS-BlocksConsolidation or if the network has not configured the absThreshSS-BlocksConsolidation, then the UE does not include numberOfGoodSSB for the corresponding neighbour cell. If the UE has no SSB of the serving cell whose measurement quantity is above the absThreshSS-BlocksConsolidation or if the network has not configured the absThreshSS-BlocksConsolidation, then the UE shall set the numberOfGoodSSB for the serving cell to one.","paragraph_zero_based":12378},{"literal_text_all_w_t_and_m_t":"relativeTimeStamp","paragraph_zero_based":12379},{"literal_text_all_w_t_and_m_t":"Indicates the time of logging measurement results, measured relative to the absoluteTimeStamp. Value in seconds.","paragraph_zero_based":12380},{"literal_text_all_w_t_and_m_t":"tce-Id","paragraph_zero_based":12381},{"literal_text_all_w_t_and_m_t":"Parameter Trace Collection Entity Id: See TS 32.422 [52].","paragraph_zero_based":12382},{"literal_text_all_w_t_and_m_t":"traceRecordingSessionRef","paragraph_zero_based":12383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["b78b1f17f95858146fd9762ee0be8e1b5f79a87489b1d2f519c624bd09a16144","7ed748398c1e6463f8d7a38a2cacf30679f6c4101d905a64417e6be2b6a3e6b3","ea61cf7c7301483cac3b0d2353d0d3d540c842d2b44dae671e7245515234961c","dce6d8e995c729b4c1fd12d6a8a29e23c58029ac76521465be145331865c22e8","01ee879a383cad809e271dab8509a55c90bc461004f943830d65fe61d555aeda","a29ce6664430c97816487c5b6a84c66378b1f2cd225371039130720fe4a8d34f","83de8075296e4f728d698e464021996b1d337ee29cef7f2ba6fb56baaacc1520","22ef258b6849b7cad4562bbce9a31e187a35b7d9ee432d4a3146e559b5870f85","0f0c313d4953c34e4d52404e841176b1cb8b675a3b5c5ef0a819f05a43c4ae92","261ca9b0575c6942276ccc73f54237a962bd037c604290d6eb815cdef310be5e","ce19234553ec88997ee4007eec8d06297b1649e05ab8d45bd8ebfe06838cee42","c3994f6a7031a253b838e7544e99b698416963c0877b02d2c6007f0c2b17ea01","db70eece0ae8091626ba14d6d47b55e451f75f6209223c7ead2c9b56ba390dec","8e058cd443d3d558d0e88d54d9ca534b4128b440de1738e43b6a3b4c4787628b","853bd23b05164fb6d33ee7488c0551e8897a276d32e077029d44b830d6fad58a","a8a45577581dfc62b67502c1819c343e8ae1e80560d7fae2236320226a005cad","00f77d4aa14d604558c86e99e12be4621695c15e5fd7854d33e9f920c7eacc44","84af07e0b6d2870da64397cdf505bf5416accc9883dd1b79388b1d2c90402ed0","e1d0f080916cc74db4a7e65a64a23ca289b96ebb325ddb45825f523f5d21857d","14f5df3e291ea183764f8291ec266f8edfaf641e51dbc61c54a647e0825044d8","5c5184479b407911011ff2a27e3bf3d65aa6e47b36e0d5feb1ecfd4963c8c357","6ce6b0721c56648ee7e1147d91edb03326d156321fadc874e93aec5c3de635e7","ad4c879ad0e48e8458a6cf193a1131817cc3dc62d5b1c1546b145229259d2681","b51f42f1125303895372f511ba10a7c6f6c0d06245a40b3dbb110d699bbe488d"],"paragraph_range_zero_based":[12360,12383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12360"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameter Trace Recording Session Reference: See TS 32.422 [52].","paragraph_zero_based":12384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12385},{"literal_text_all_w_t_and_m_t":"ConnEstFailReport field descriptions","paragraph_zero_based":12386},{"literal_text_all_w_t_and_m_t":"measResultFailedCell","paragraph_zero_based":12387},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the cell, where connection establishment failure or connection resume failure happened.","paragraph_zero_based":12388},{"literal_text_all_w_t_and_m_t":"measResultNeighCells","paragraph_zero_based":12389},{"literal_text_all_w_t_and_m_t":"This field refers to the neighbour cell measurements when connection establishment failure or connection resume failure happened.","paragraph_zero_based":12390},{"literal_text_all_w_t_and_m_t":"numberOfConnFail","paragraph_zero_based":12391},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the latest number of consecutive failed RRCSetup or RRCResume procedures in the same cell independent of RRC state transition.","paragraph_zero_based":12392},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":12393},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (establishment or resume) failure. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":12394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12395},{"literal_text_all_w_t_and_m_t":"RA-InformationCommon field descriptions","paragraph_zero_based":12396},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":12397},{"literal_text_all_w_t_and_m_t":"This field indicates the absolute frequency position of the reference resource block (Common RB 0).","paragraph_zero_based":12398},{"literal_text_all_w_t_and_m_t":"locationAndBandwidth","paragraph_zero_based":12399},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth of the bandwidth part associated to the random-access resources used by the UE.","paragraph_zero_based":12400},{"literal_text_all_w_t_and_m_t":"perRAInfoList, perRAInfoList-v1660","paragraph_zero_based":12401},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about each of the random access attempts in the chronological order of the random access attempts. If perRAInfoList-v1660 is present, it shall contain the same number of entries, listed in the same order as in perRAInfoList-r16.","paragraph_zero_based":12402},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":12403},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used in the BWP associated to the random-access resources used by the UE.","paragraph_zero_based":12404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12405},{"literal_text_all_w_t_and_m_t":"RA-Report field descriptions","paragraph_zero_based":12406},{"literal_text_all_w_t_and_m_t":"cellID","paragraph_zero_based":12407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["f18c0a136f843a36d6aae91fcc1a9483ebbf27753d40a615942fc14784584b37","04222b8464c6114cc72c08117b8728bd73dea76ce9e67be56893d6565105c3d4","8a0fb32756e9d1ebfbea7b29da22996ff85d2ebe3cb53886793e50b527cd2baf","5190eccd8a9efc641767f4c399f499044b3c40976e369ec3a4d96d43dba8d87d","2877d09c17e1f7fb64bb919055ad59817a607879822d92f3edc16b0053bb3559","833827100fd9a44f683ce58f60e013e01acd4212fd5f5cd24cdc724bbba54e6d","1201398ef6a3e5428941500ba5085f1f13423a2a40abf12c92086c2fc638600e","43b32a7f796185f95a253d59ae22512820e6af9a0c542dc69f9bf8fbbb055098","c6ff77c7f05d7b18cffbf06f96c120d42db0df6384eb337e022b4a8034b62dd3","6b572bd3853c6c262660e86dee74887a30ed8766c24a918c6ccd7090630f7e50","8bd380562e9ed718db0e877566ed6d1b2728b6f22d45642bd9a6152f090b18eb","3abb3fbc0e673182f0ddead9f96e5098e4257dc2a47f7499b757be670c1b4745","eb511459c5e41235e8991bff5716449ccb44c71862fc825f3cabbfcda828ae2f","e909ec26143502ac3896eab5511e66f556aab95aa99520858de5c570d545112b","6f04e4b4348886c94a755ddaed9b9de76341bf3bbbbaff573d9864d7139e1b2d","9afd1b2060a4ba8e4f00f6b7856eebbe6de9bbef5ded31318ee3861f4c5437b1","aecdbd6fe79cf9fe803ebec57e26c7474f89d628955b7fe7623b050dd392d059","5025dd514fa0a36e00f99228d76a7bfcb03ecc04014fd9c40927fdbd862dbe11","0dbea073dac5ec109b6279212f72bdcc9c76ab7e35908207f0196cc44a161595","d9be89f0c2cb45c8fde7a5d38bfa091ed5cc0ec984bff323b80a11244eb5dec8","5bc6c81233c6a10327e0a67128479754a94761b49569cba6eb3fcf1ce7c65f34","52f626a330229529c6aa961c5ab81c593da1d5fce38cd3c803d656b5ecd2b52c","5f96c6440383faa22bda9571b5b890c25772d20a1cad9a3f4600f12b600f9744","dc0a7c2ab1b58deb066ba0f1adf3458202de3d69a00005527a3f986caa46990a"],"paragraph_range_zero_based":[12384,12407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12384"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the CGI of the cell in which the associated random access procedure was performed.","paragraph_zero_based":12408},{"literal_text_all_w_t_and_m_t":"contentionDetected","paragraph_zero_based":12409},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that contention was detected for the transmitted preamble in the given random access attempt or not. This field is not included when the UE performs random access attempt is using contention free random-access resources or when the raPurpose is set to requestForOtherSI or when the RA attempt is a 2-step RA attempt and fallback to 4-step RA did not occur (i.e. fallbackToFourStepRA is not included).","paragraph_zero_based":12410},{"literal_text_all_w_t_and_m_t":"csi-RS-Index, csi-RS-Index-v1660","paragraph_zero_based":12411},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CSI-RS index corresponding to the random access attempt.","paragraph_zero_based":12412},{"literal_text_all_w_t_and_m_t":"If the random access procedure is for beam failure recovery, the field indicates the NZP-CSI-RS-ResourceId. For CSI-RS index larger than maxNrofCSI-RS-ResourcesRRM-1, the index value is the sum of csi-RS-Index (without suffix) and csi-RS-Index-v1660.","paragraph_zero_based":12413},{"literal_text_all_w_t_and_m_t":"dlPathlossRSRP","paragraph_zero_based":12414},{"literal_text_all_w_t_and_m_t":"Measeured RSRP of the DL pathloss reference obtained at the time of RA_Type selection stage of the RA procedure as captured in TS 38.321 [3].","paragraph_zero_based":12415},{"literal_text_all_w_t_and_m_t":"dlRSRPAboveThreshold","paragraph_zero_based":12416},{"literal_text_all_w_t_and_m_t":"In 4 step random access procedure, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold rsrp-ThresholdSSB in beamFailureRecoveryConfig in UL BWP configuration of UL BWP selected for random access procedure initiated for beam failure recovery; Otherwise, rsrp-ThresholdSSB in rach-ConfigCommon in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":12417},{"literal_text_all_w_t_and_m_t":"In 2 step random access procedure, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold msgA-RSRP-ThresholdSSB in rach-ConfigCommonTwoStepRA in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":12418},{"literal_text_all_w_t_and_m_t":"fallbackToFourStepRA","paragraph_zero_based":12419},{"literal_text_all_w_t_and_m_t":"This field indicates if a fallback indication in MsgB is received (according to TS 38.321 [3]) for the 2-step random access attempt.","paragraph_zero_based":12420},{"literal_text_all_w_t_and_m_t":"intendedSIBs","paragraph_zero_based":12421},{"literal_text_all_w_t_and_m_t":"This field indicates the SIB(s) the UE wanted to receive as a result of the on demand SI request (when the RA procedure is a used as a SI request) initiated by the UE. That is, it indicates the one(s) of the SIB(s) in the SI message(s) requested to be broadcast that the UE was interested in.","paragraph_zero_based":12422},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":12423},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CBRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":12424},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndexCFRA","paragraph_zero_based":12425},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CFRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":12426},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-PayloadSize","paragraph_zero_based":12427},{"literal_text_all_w_t_and_m_t":"This field indicates the size of the overall payload available in the UE buffer at the time of initiating the 2 step RA procedure. The value refers to the index of TS 38.321 [3], table 6.1.3.1-1, corresponding to the UE buffer size.","paragraph_zero_based":12428},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":12429},{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CBRA..","paragraph_zero_based":12430},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDMCFRA","paragraph_zero_based":12431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7d616cb60dfdc90e194d178d5fb5d643a81e16b1996ad958f95b1858d0955210","e545121661bc2129fd6deaac3e4ce7fa81c48bfe4e56d7b3ac2865d1bed09bdf","e0957f5aa48199bca744766aa76926db4bd6761d2cd1c56b0e7134c56ca1604f","89227088001a9b400382e9643a17c87a0162ad23ae6fc7996b1ebc31425d2f74","13e17197bfc024f663e49fecc6c7a62f5452eeada7cd8f118d54ac80c5434bb5","6c12208e85160c872e8fe1abeb6db4596a5b13ed182bb053276a6e285e13b59e","3ccfab70e9439039ca95645286cdfb0c649d9e48db3eab6414cca330b5ef12b3","3668fde4f6aea3a0cd4c08036fbd78af20b67ec1b399a1719210b651d7541779","45778a1c2f956342d8e08d35a119cbf39ba40136e959a2259eb9033e6e00d595","ca3d4c5fde74e53200628ba2e826ae93417c6042dd92b20324dbc38c0a911479","186388179500b8bfe35af4d21cd2e9b6677b722e699c3781b19661a0fd3e57c4","66f4d7b9ad2dc8d6865d537827f52e758222f569d67bf4dce0e6922a561f3098","2f1e8bef4de15cc3e8b9fb2c22a496062d8330bf2eaa328110b346257a173566","d028688db90f631c26bc33da63c3aba5773f9c7ee42ad7c25c47073f2298291f","26c0d822b00b9cd6bdaec6452c16e47817790e7f00c9c91a70ecc8505a7d4058","2648be23116cc5deabde90f8aa3efcf7fe14db1ce1bf362420bc0436272de223","9c3dde291a1329fd957b8491e2cfef859f5663ea69c6bbcf7849ecea5afe1b56","e57b5074bdada0d25d39535b6a6659aa4ef8f50b2600c7cf89eff3cff205608e","ddf287fb993f079b402161bf435744724f27dc7a3526bc68883656b57802c1f7","59edb4a3005358084f4042424bdecab264ce54db8e166f6590855df8ac5062a5","a6ed218fc5826608b7aa7bd99fbd6c266988e54672605beeac0d0a93e90a1993","2f2a71af14beb957aefeeeb6dee41bfd62bd58918860b3f62cc792eed6d85468","1020bac85f9666f293b34e3722c8960c4f14e4e0635f6055eed7dec697a2e941","bd5d1b3441b4e12d7407029e60e8d3bc49a58df0e1c6f44456304f2904af571f"],"paragraph_range_zero_based":[12408,12431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CFRA.","paragraph_zero_based":12432},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":12433},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention based random-access resources for 2-step CBRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":12434},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStartCFRA","paragraph_zero_based":12435},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention free random-access resources for the 2-step CFRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":12436},{"literal_text_all_w_t_and_m_t":"msgA-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":12437},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS as derived from the msgA-PRACH-ConfigurationIndex in RACH-ConfigGenericTwoStepRA (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]) when the msgA-SubcarrierSpacing is absent and when only 2-step random-access resources are available in the UL BWP used in the random-access procedure; otherwise, this field is absent.","paragraph_zero_based":12438},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnCSI-RS","paragraph_zero_based":12439},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding CSI-RS.","paragraph_zero_based":12440},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnSSB","paragraph_zero_based":12441},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding SS/PBCH block.","paragraph_zero_based":12442},{"literal_text_all_w_t_and_m_t":"onDemandSISuccess","paragraph_zero_based":12443},{"literal_text_all_w_t_and_m_t":"This field is set to true when the RA report entry is included because of either msg1 based on demand SI request or msg3 based on demand SI request and if the on-demand SI request is successful. Otherwise, the field is absent.","paragraph_zero_based":12444},{"literal_text_all_w_t_and_m_t":"perRAAttemptInfoList","paragraph_zero_based":12445},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about a random access attempt.","paragraph_zero_based":12446},{"literal_text_all_w_t_and_m_t":"perRACSI-RSInfoList","paragraph_zero_based":12447},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same CSI-RS.","paragraph_zero_based":12448},{"literal_text_all_w_t_and_m_t":"perRASSBInfoList","paragraph_zero_based":12449},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same SS/PBCH block.","paragraph_zero_based":12450},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":12451},{"literal_text_all_w_t_and_m_t":"This field is used to provide information on random access attempts. This field is mandatory present.","paragraph_zero_based":12452},{"literal_text_all_w_t_and_m_t":"raPurpose","paragraph_zero_based":12453},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the RA scenario for which the RA report entry is triggered. The RA accesses associated to Initial access from RRC_IDLE, RRC re-establishment procedure, transition from RRC-INACTIVE. The indicator beamFailureRecovery is used in case of successful beam failure recovery related RA procedure in the SpCell [3]. The indicator reconfigurationWithSync is used if the UE executes a reconfiguration with sync. The indicator ulUnSynchronized is used if the random access procedure is initiated in a SpCell by DL or UL data arrival during RRC_CONNECTED when the timeAlignmentTimer is not running in the PTAG or if the RA procedure is initiated in a serving cell by a PDCCH order [3]. The indicator schedulingRequestFailure is used in case of SR failures [3]. The indicator noPUCCHResourceAvailable is used when the UE has no valid SR PUCCH resources configured [3]. The indicator requestForOtherSI is used for MSG1 based on demand SI request. The indicator msg3RequestForOtherSI is used in case of MSG3 based SI request. The field can also be used for the SCG-related RA-Report when the raPurpose is set to beamFailureRecovery, reconfigurationWithSync, ulUnSynchronized, schedulingRequestFailure and noPUCCHResourceAvailable.","paragraph_zero_based":12454},{"literal_text_all_w_t_and_m_t":"spCellID","paragraph_zero_based":12455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bcc2ed813c33c1ef253bb03bf977e833c8e9ecbff7d13e033e8178e638b92fcf","0153a098658cf5352f3149f8e1a592af9af733ca429428441d8b0f024af0f7e7","a32bfbe245cab554e81b5bea0efa6bba1317ce4ae3e372dfca7eab5fb0779dfc","e157a7f93f64017978784ba499a37a6504e0c255da771567f590dc2f45534718","55f768819cc9ad831aa2d830ccad9b868421797a3d95fe39f22cb88c0fecd5dc","38562cf32d113c87afd38c864e5bed51e29a0cf767d7d5f02c37ad166944619d","e8b59d46551614a472176e0e21bcb041f8d3b92a0ae572fb30bce0d28a39284c","529d838597a686b3b367c508c25ba745c474a95a9794332399a3e1898ee955ee","080671e0e5f1dbb50d6bd4a647910bdebb102550f7d4c1b522018ca34ac042bc","667f69cb850882271266f544fbda74d640366bf92f13475d228997220d85e51f","9ef951d66f3438ffff4e13642ad8001614281bd6c57eca97656dd43ebfec303f","54d01de6c0bf3f8e03ab3cd930bf5cd9f822c5a3d8b0f3b20ec9300528361a84","1c5535755b4a8daf24620affa7ac43af660163c1f3706e8a8478cd8afaf54981","97f97bdec77d7281c0d495e9536e1747729fb85704bbe3d065e6036dfbd46478","006d44bd9f9bf3f74d238e3e2ea92df0144d67e7afd398a50f60d4b95b32182e","74cea4eea53824f534d361a7c4dcec3f2de26d358e46e27813dae0e48582b763","7270b1a8cce87c9229bbe36ce9278fcd85116590dbaae9f22ceab1a39ae2edeb","404c5ecdf4fc1917ad8be56d0fdad23f29df26099a74e33c0184a6809207e9df","efe5ba5383459f485604be61001750d55d93e29505375b07e6f8d527cf74f319","22a0ee79bacb07122fa4d75d34bd2549c55a802779a0c2fc759fc56c14726d8b","25c2f725e21de71ac0b7d341e316a98a2c43b7b9cc5ccee94c0b8ea6e3780572","ac83493947d01f8f33a4d5a23c49ef17b5d70c8bdb1083e1ad3961d6a82a87f6","97febc1bfd4951c71dbbe548ae65bc4b9172803f2770c2eba6a0ad63ff353680","02976b12093513447523b690677a2f0a9e1ef07c43b2d0bbbc2aa52032a75989"],"paragraph_range_zero_based":[12432,12455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CGI of the SpCell of the cell group associated to the SCell in which the associated random access procedure was performed. If the UE performs RA procedure on a SCell associated to the MCG, then this field is set to the CGI of the PCell and if the UE performs RA procedure on a SCell associated to the SCG, then this field is set to the CGI of the PSCell. If the CGI of the PSCell is not available at the UE for the RA procedure performed on a SCell associated to the SCG or for the RA procedure on the PSCell, this field is set to the CGI of the PCell. Otherwise, the field is absent.","paragraph_zero_based":12456},{"literal_text_all_w_t_and_m_t":"ssb-Index","paragraph_zero_based":12457},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH index of the SS/PBCH block corresponding to the random access attempt.","paragraph_zero_based":12458},{"literal_text_all_w_t_and_m_t":"ssbsForSI-Acquisition","paragraph_zero_based":12459},{"literal_text_all_w_t_and_m_t":"This field indicates the SSB(s) (in the form of SSB index(es)) that the UE used to receive the requested SI message(s). The field is present if the purpose of the random access procedure was to request on-demand SI (i.e. if the raPurpose is set to requestForOtherSI or msg3RequestForOtherSI). Otherwise, the field is absent.","paragraph_zero_based":12460},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12461},{"literal_text_all_w_t_and_m_t":"RLF-Report field descriptions","paragraph_zero_based":12462},{"literal_text_all_w_t_and_m_t":"choCandidateCellList","paragraph_zero_based":12463},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the list of candidate target cells for conditional handover included in condRRCReconfig at the time of connection failure. The field does not include the candidate target cells included in measResultNeighCells.","paragraph_zero_based":12464},{"literal_text_all_w_t_and_m_t":"choCellId","paragraph_zero_based":12465},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the candidate target cell for conditional handover included in condRRCReconfig that the UE selected for CHO based recovery while T311 is running.","paragraph_zero_based":12466},{"literal_text_all_w_t_and_m_t":"connectionFailureType","paragraph_zero_based":12467},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the connection failure is due to radio link failure or handover failure.","paragraph_zero_based":12468},{"literal_text_all_w_t_and_m_t":"csi-rsRLMConfigBitmap,csi-rsRLMConfigBitmap-v1650","paragraph_zero_based":12469},{"literal_text_all_w_t_and_m_t":"These fields are used to indicate the CSI-RS indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF. The UE first fills in the csi-rsRLMConfigBitmap-r16 to indicate the first 96 CSI-RS indexes and then csi-rsRLMConfigBitmap-v1650 to indicate the latter 96 CSI-RS indexes. The first/leftmost bit in csi-rsRLMConfigBitmap-r16 corresponds to CSI-RS index 0, the second bit corresponds to CSI-RS index 1. The first/leftmost bit in csi-rsRLMConfigBitmap-v1650 corresponds to CSI-RS index 96, the second bit corresponds to CSI-RS index 97. These fields are included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":12470},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":12471},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI used in the PCell upon detecting radio link failure or the C-RNTI used in the source PCell upon handover failure.","paragraph_zero_based":12472},{"literal_text_all_w_t_and_m_t":"failedPCellId","paragraph_zero_based":12473},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the target PCell of the failed handover. For intra-NR handover nrFailedPCellId is included and for the handover from NR to EUTRA eutraFailedPCellId is included. The UE sets the ARFCN according to the frequency band used for transmission/ reception when the failure occurred.","paragraph_zero_based":12474},{"literal_text_all_w_t_and_m_t":"failedPCellId-EUTRA","paragraph_zero_based":12475},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the source PCell of the failed handover in an E-UTRA RLF report.","paragraph_zero_based":12476},{"literal_text_all_w_t_and_m_t":"lastHO-Type","paragraph_zero_based":12477},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the type of the last executed handover before the last detected connection failure. The field is set to cho if the last executed handover was initiated by a conditional reconfiguration execution. The field is set to daps if the last executed handover was a DAPS handover.","paragraph_zero_based":12478},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":12479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9124b92d5b03c27c1d09b7e5b1289c6f62cf2388330b17f4dfc66f35eafb9927","483ccf02d32b6e5acafb8465f9543f14c0d0ddc0f067ed508f2b76b4b349d93b","1fa9a53ddcef90c5d2488477c8b11ce1532a0b55eb02663f82c42135ebbde4db","54b7a258659e4a74a7e4709ab67ee50be43d45a2126389eff23cab39782c6ac7","1e3abb62bf53283d5de8cac7f62c7b40b9833a47127e715f335208c2f2eeb8c9","983dce3b9d8f13cf49e3ff928f22af9f11751e856e7e0712bc0941a061077c11","6c85d3f356c987cfca428cdc0702a8b3cbf249ddd8bb59475176e8b37869d0b5","71cacc065263dd244d1f1ed0cace94b0c0492281fcce2aa864c1d80533f3f4fa","bcb28bf2517cc72d739b7822b3750d7f25e0ec9edf6cf0726333f2e0d8978dd8","ff967dfe170a1a2b20ad0a1a4366964d308a5f425997012fc9f66e3d44605afa","c55089b7bc6b89bec9c0bcb37e8dde477d0aa40b7daf7f16afd8d9eec012626f","d88f2566c6ab2844266b482266db2ec1813f9686081932136504750d59de6151","1d2dfa18e06ff8d45c2ff038df8866203a07415426fc07dcbe26cf69fa555a6a","68e373f69500e64bb9e58e545a22eb88fb1b3d0479dd6dd8dd7388dd525bd8a0","e9c9ef1b2c40ce3a3fe6b85ee19b4c0da2c03e75b415c0069c01b29580d7fc4b","9230df836505e92a116cf02751e5f8807f2cb9e7d5221bbaa4091fff1b004139","bd65bfc61355dfb91814f2a354a935b88ad56cc39c9a634a316436ce8ed89488","f0172400717d63609f1061ed082301043bb6dc257ecac29f8d9608733b7b96c9","56473128bae2c94028c34ca2171b80e5083c0acbac9d722ec63a75d3347046fd","2d5e2603af6a12673af423458bf57d33156f3bf8f2b6981e2a402499d5a47d4a","17ac64b3d93235de5b0234c6891fcbd455bf7caed5b457fb630a3e8e9dfd572f","8c33308bafee2b1fd32f6febeec09e674a9f559485c7df14db0985c181b5f433","c4292a8576785054ac7297fa225decedf9e969b6d3316df59ac12bdd8a7248d5","843c5e1e162062f78060d61c0f4b137aedd91d28fe0b863c77bbeef2b4f0c73d"],"paragraph_range_zero_based":[12456,12479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring EUTRA Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":12480},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":12481},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":12482},{"literal_text_all_w_t_and_m_t":"measResultLastServCell","paragraph_zero_based":12483},{"literal_text_all_w_t_and_m_t":"This field refers to the log measurement results taken in the PCell upon detecting radio link failure or the source PCell upon handover failure.","paragraph_zero_based":12484},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA","paragraph_zero_based":12485},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-r9 IE as specified in TS 36.331 [10].","paragraph_zero_based":12486},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA-v1690","paragraph_zero_based":12487},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-v9e0 IE as specified in TS 36.331 [10].","paragraph_zero_based":12488},{"literal_text_all_w_t_and_m_t":"noSuitableCellFound","paragraph_zero_based":12489},{"literal_text_all_w_t_and_m_t":"This field is set by the UE when the T311 expires.","paragraph_zero_based":12490},{"literal_text_all_w_t_and_m_t":"previousPCellId","paragraph_zero_based":12491},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of the last handover (source PCell when the last executed RRCReconfiguration message including reconfigurationWithSync was received). For intra-NR handover nrPreviousCell is included and for the handover from EUTRA to NR eutraPreviousCell is included.","paragraph_zero_based":12492},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":12493},{"literal_text_all_w_t_and_m_t":"This field is optionally included when connectionFailureType is set to 'hof' or when connectionFailureType is set to 'rlf' and the rlf-Cause equals to 'randomAccessProblem' or 'beamRecoveryFailure'; otherwise this field is absent.","paragraph_zero_based":12494},{"literal_text_all_w_t_and_m_t":"reconnectCellId","paragraph_zero_based":12495},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cell in which the UE comes back to connected after connection failure and after failing to perform reestablishment. If the UE comes back to RRC CONNECTED in an NR cell then nrReconnectCellID is included and if the UE comes back to RRC CONNECTED in an LTE cell then eutraReconnectCellID is included","paragraph_zero_based":12496},{"literal_text_all_w_t_and_m_t":"reestablishmentCellId","paragraph_zero_based":12497},{"literal_text_all_w_t_and_m_t":"If the UE was not configured with conditionalReconfiguration at the time of re-establishment attempt, or if the cell selected for the re-establishment attempt is not a candidate target cell for conditional reconfiguration, this field is used to indicate the cell in which the re-establishment attempt was made after connection failure.","paragraph_zero_based":12498},{"literal_text_all_w_t_and_m_t":"rlf-Cause","paragraph_zero_based":12499},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the last radio link failure that was detected. In case of handover failure information reporting (i.e., the connectionFailureType is set to 'hof'), the UE is allowed to set this field to any value, except for the case in which a radio link failure was detected in the source PCell while performing a DAPS handover..","paragraph_zero_based":12500},{"literal_text_all_w_t_and_m_t":"ssbRLMConfigBitmap","paragraph_zero_based":12501},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH block indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF.The first/leftmost bit corresponds to SSB index 0, the second bit corresponds to SSB index 1. This field is included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":12502},{"literal_text_all_w_t_and_m_t":"timeConnFailure","paragraph_zero_based":12503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["7c666154cdb4097d8bbf78d4da2dc3a364541fc47b63f7ee56ceea02a90f2ada","4f07d95579deeaf0bc1f3e774ee35bfe158277fd33753ea12c34ff22fa2a2a31","a0ff745fda2a32b827ec557a21fc9a2c0567a637abcd24fc78445bc12c05aa3d","c491166341bed7cd6b3c31fd32a15a6e47f4bece8f480fc42f7d74a70171785c","5d42350f6a34fb434be9a08b4ae091e56508aa6c9596dec40eccf0795dcc45ba","d796b195516f84c2909bad8f860ce50907cdf4fc688f5362d223d3b2777a7484","d3edf29fdcf47ae78c2ca80a8403ead57b3b25c8a1fdf1a02c74fd4516c5777f","fc07c1acb562a646039ac920e1674d77ec67926492efc90964bc3bc424b0a6ee","718b4290bc1b6e8fcc538b54657af2c6b142ed748c3f2d0c55419399435010ef","b682d73cfa73585f45589aa8a65475bb84b870fe5031f01bb9cb45a5e5af2e18","ccd1edad88d15babd9ff17c6c369a9696dc49030698089fb7628d5a346ae5b1d","9b283f73509f677fe41a0d2b6a4bd18e7f4dbeeb1000a8bd7552071228b5cc88","139f834c043430e6a1bb085671d74c52b698eda3c966c38b4912f38764c78024","920f7c7717716d4eaf948146e9ce3e4f22e28760027550ae7cffa8b6a186f949","890bed1e404f2a22435db99d04f64bc4f2cbc7f3533728d68a206d7dc352fb04","b17380d061b687435fc49db0d1eb709bf2a8f33fcd0dc9574c56c4ce77d5693b","7849b4b8aacd1892f877dce4ce3af5676ca20812e1b859bd72f9ba17f93f6472","7225fb03c49260e9e932b9aa79fa35c3abf48d9c2cccf730ee95d6540800b1fa","066f3b38f2fab384769da37f785332fa0337b560b9e5e2a263a9e30075f73454","eb20f8aba9f5d153ef09d0486192469f7914629bdba805c705ddeb3784cf444c","0f20699651a6611a858240d0f12e1e2968ab7c1d04932b07e43bf8d3aa40276e","8c455e25ab912c199136595aa56b145d5fe19f6a2b26624bb9a4d22cd79a7286","61453b9ae9edf9eb8fefcca93c17dddb18e15ffb00ffc01495451281c3a52fd8","d1d10742a2834a011e24f09951a56266bbd14dd83ecb65bcad136b88fee80e4a"],"paragraph_range_zero_based":[12480,12503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p12480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last HO execution until connection failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":12504},{"literal_text_all_w_t_and_m_t":"timeConnSourceDAPS-Failure","paragraph_zero_based":12505},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the last DAPS handover execution and the radio link failure detected in the source cell while T304 is running. Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":12506},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":12507},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (radio link or handover) failure. Value in seconds. The maximum value 172800 means 172800s or longer. In the case of failure(s) (either at source or at target or at both) associated to DAPS handover, this field indicates the time elapsed since the latest connection (radio link or handover) failure.","paragraph_zero_based":12508},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":12509},{"literal_text_all_w_t_and_m_t":"In case of handover failure, this field is used to indicate the time elapsed between the initiation of the last handover execution towards the target cell and the reception of the latest conditional reconfiguration. In case of radio link failure, this field is used to indicate the time elapsed between the radio link failure and the reception of the latest conditional reconfiguration while connected to the source PCell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":12510},{"literal_text_all_w_t_and_m_t":"timeUntilReconnection","paragraph_zero_based":12511},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the connection (radio link or handover) failure and the next time the UE comes to RRC CONNECTED in an NR or EUTRA cell, after failing to perform reestablishment. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":12512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12513},{"literal_text_all_w_t_and_m_t":"SuccessHO-Report field descriptions","paragraph_zero_based":12514},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":12515},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the target PCell of the handover for which the successful HO report was generated.","paragraph_zero_based":12516},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":12517},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells when a successful handover is executed.","paragraph_zero_based":12518},{"literal_text_all_w_t_and_m_t":"rlf-InSourceDAPS","paragraph_zero_based":12519},{"literal_text_all_w_t_and_m_t":"This field indicates whether a radio link failure occurred at the source cell while T304 was running.","paragraph_zero_based":12520},{"literal_text_all_w_t_and_m_t":"shr-Cause","paragraph_zero_based":12521},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the successful HO report.","paragraph_zero_based":12522},{"literal_text_all_w_t_and_m_t":"sourceCellMeas","paragraph_zero_based":12523},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":12524},{"literal_text_all_w_t_and_m_t":"sourcePCellId","paragraph_zero_based":12525},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":12526},{"literal_text_all_w_t_and_m_t":"targetPCellId","paragraph_zero_based":12527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["a3c726d3281ef9ce81812cbfc73a88816a85df2313cfd66f0a21cc75b9063702","e7151da5f219fd0addee66750c0fd6f0b8909c7e926d2bd9bb75500adf335410","e32171b112e1310ac881e67805f230d1ba136044260fb99037ebc028b65c2d6d","072ff8705e2b9ac6d8adc04eeb6c9100835819a9bed38afb8ecb91409228de4c","931a01843fe68736ed243705f6109d3928b7147e2869bf5d0417133afc090dc2","30fcbf83829e5c4f47f3b811e3b05d5a8ae5e0e2aa957baab61e1ab35d0bdcc7","073d75a27d0f6123d06faf00e284d9d48f41146ef74a1f265c99f633cf94ba02","5c58c1c83787a5a7cd884d76a2f1541f0ae0670d572e391e8d100c9a4fac3103","75585454a289a20230a739d31c9b46e58e7e38509ec8cc5f8217a81d87414a54","f760fe6d8d9ce771ce2f58485db4a131ab9afecf7babe3b953f628102454a563","2ff6ad2a05d5533122a06dcab7462ffc3d46d1bc93a7c328065769d3bde68648","7069c1ded86b19ca317778010edad808da435b93c383d3cead5f87f59d84e3f0","142cbb82cacc2ad9e76503b59f244783c89b0246f2d02f3de7f1768fd410dcb1","b9cec7cd45fb73ee995c15d76e4ff3a6fd6dc5d2dc69eba9c93f12a30631c3de","e725384eef69a09e8556b3291e1725ead37c77928bc8bfeb36beb3f82aaa9612","2405ba2c8877f00516f397420a367d86c31ef876de07a63e70018c742cbfc089","0f449182666c325e7154d58ae42b20f96e1d528229a85522a9e22ad98292e956","6cab80d06fba0420ba3b44d589c49e354db524ca0676ef357144bd79f14692ed","8cff31678e4df0e05bbb745dbc9051af1a348e8c79dde37b2d5da72bb40c5948","4b8c08044a47f866fe8e9f17ed8bf8cecf76686aa5a0b1b1cea60646081393d3","84779f76570fb7c94c41aa6fd19dee271874e83c4276cb00838d1654fed71e48","f041e6de6902