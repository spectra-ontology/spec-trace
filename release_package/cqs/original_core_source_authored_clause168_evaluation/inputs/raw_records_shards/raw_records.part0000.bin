{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-STOP","paragraph_zero_based":15360},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15361},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15362},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS field descriptions","paragraph_zero_based":15363},{"literal_text_all_w_t_and_m_t":"candidateBeamConfig","paragraph_zero_based":15364},{"literal_text_all_w_t_and_m_t":"Indicates the resource (i.e. SSB or CSI-RS) defining this beam resource.","paragraph_zero_based":15365},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":15366},{"literal_text_all_w_t_and_m_t":"If the field is absent, the RS belongs to the serving cell in which BeamFailureRecoveryRSConfig is configured.","paragraph_zero_based":15367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15368},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo","paragraph_zero_based":15369},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo indicates cell access related information for this cell.","paragraph_zero_based":15370},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo information element","paragraph_zero_based":15371},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15372},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-START","paragraph_zero_based":15373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15374},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo   ::=         SEQUENCE {","paragraph_zero_based":15375},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList,","paragraph_zero_based":15376},{"literal_text_all_w_t_and_m_t":"    cellReservedForOtherUse             ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15377},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15378},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15379},{"literal_text_all_w_t_and_m_t":"    cellReservedForFutureUse-r16        ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15380},{"literal_text_all_w_t_and_m_t":"    npn-IdentityInfoList-r16            NPN-IdentityInfoList-r16      OPTIONAL    -- Need R","paragraph_zero_based":15381},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15382},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5ef028c471e770044b857c62e835de0a865a1b54755b86339764b62597adbf6c","79b96b486826df6b696328313831353d5a2880a7251c8f8ba8ef7f8ecfd5e95e","9031cff207b521bc3199fb793b8daf80e451bad851d69d07ad10aba7af5c8ab1","2b554583a316d1521886b45d711a33db0476578bc23804a5c24c5ca0a4a1e341","e2fad3df905030bf8df968d59925d6425d85799e64fd44ae2d358eb18aff4115","d16253c52bd76910e6a1a9e5ba419b9cde6eab11c01026ef04cee6fd46e7ed7c","e9bc8191e3665773db5baebc0e7d8bcce8bce087f26b338baaf22441bf7f02f8","31b76e6346bf04abeb7e04c3406ffeb4daa0c15eed82e1f172c8336f12b65245","eb5f76ccff0d2ad2379beba40530dbbf153402f2e49596a3b44802f2be44bcac","0f9ab34444988e8bead81cc10223827b19fb944cfc18823ff45d2ce155585150","b05308dfee685cd9f277dcec99cb9bd15a241b1148eb50d894fdca449ee70809","69bc06327eb3939574889f1a8270748e87287c376f33ebdd6d0174bc920da62e","0603497f05588b7903ebf11cf6d1790a92d999c173d8cb8b8454dda2f233fa7d","77e25bbee34e448dbbbfb30178133c7611c75717276dcd240bf829976c92386a","60b8db584eccf2d7f7a627ac9384d381617daf46ee8b6d0247b0dcc81e668a81","750c6806e213afb53702f2e45fefe14d984dbe6e836d23dfa22e77f1eb09197e","a7d00b9e015e0889fcf6e8fb475ec40847911e5a928228493e648dffead5edd3","f31e58c419c3914dd25df6d2aaa1082306c47d15ba78ba39e13fc14aa05ee5d7","2d17e7f6e642e9f98cdc64c3b0df2a1d009ea9f989d4637bb54d8fa9cd540919","fe29c5b54350a61346ecd0dc4ce768faf502ca5800c8299e04d259883a6ddbce","1a61956f14deeca511e12b7e2e84a54f63b10aa8945571709d46ced2ff40b27e","326bb42c1cd19a3b21ca32e3ddc6fff59e9b09dd2b28d19fa2c0b2f8e843ad73","5dbe57c7ed2b585cac77faf064a1a1ede0ddef2486ab1a9ac9cf897927a09e7a","718baec291338b1975a418a457f09b71af5eb41085160a486ebdb8fb2161e46b"],"paragraph_range_zero_based":[15360,15383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15360"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    snpn-AccessInfoList-r17             SEQUENCE (SIZE (1..maxNPN-r16)) OF SNPN-AccessInfo-r17    OPTIONAL    -- Need R","paragraph_zero_based":15384},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15385},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15387},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo-r17 ::=         SEQUENCE {","paragraph_zero_based":15388},{"literal_text_all_w_t_and_m_t":"    extCH-Supported-r17                 ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15389},{"literal_text_all_w_t_and_m_t":"    extCH-WithoutConfigAllowed-r17      ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15390},{"literal_text_all_w_t_and_m_t":"    onboardingEnabled-r17               ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":15391},{"literal_text_all_w_t_and_m_t":"    imsEmergencySupportForSNPN-r17      ENUMERATED {true}             OPTIONAL    -- Need R","paragraph_zero_based":15392},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15394},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-STOP","paragraph_zero_based":15395},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15397},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo field descriptions","paragraph_zero_based":15398},{"literal_text_all_w_t_and_m_t":"cellReservedForFutureUse","paragraph_zero_based":15399},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20] for future use. The field is applicable to all PLMNs and NPNs. This field is ignored by IAB-MT.","paragraph_zero_based":15400},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":15401},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20]. The field is applicable to all PLMNs. This field is ignored by IAB-MT for cell barring determination, but still considered by NPN capable IAB-MT for determination of an NPN-only cell.","paragraph_zero_based":15402},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":15403},{"literal_text_all_w_t_and_m_t":"The npn-IdentityInfoList is used to configure a set of NPN-IdentityInfo elements. Each of those elements contains a list of one or more NPN Identities and additional information associated with those NPNs. The total number of PLMNs (identified by a PLMN identity in plmn -IdentityList), PNI-NPNs (identified by a PLMN identity and a CAG-ID), and SNPNs (identified by a PLMN identity and a NID) together in the PLMN-IdentityInfoList and NPN-IdentityInfoList does not exceed 12, except for the NPN-only cells. A PNI-NPN and SNPN can be included only once, and in only one entry of the NPN-IdentityInfoList. In case of NPN-only cells the PLMN-IdentityList contains a single element that does not count to the limit of 12 and the cellIdentity of the first entry of the PLMN-IdentityInfoList is set to the same value as the cellIdentity-r16 of the first entry of the NPN-IdentityInfoList. The NPN index is defined as B+c1+c2+…+c(n-1)+d1+d2+…+d(m-1)+e(i) for the NPN identity included in the n-th entry of NPN-IdentityInfoList and in the m-th entry of npn-Identitylist within that NPN-IdentityInfoList entry, and the i-th entry of its corresponding NPN-Identity, where","paragraph_zero_based":15404},{"literal_text_all_w_t_and_m_t":"- B is the index used for the last PLMN in the PLMN-IdentittyInfoList; in NPN-only cells B is considered 0;","paragraph_zero_based":15405},{"literal_text_all_w_t_and_m_t":"- c(j) is the number of NPN index values used in the j-th NPN-IdentityInfoList entry;","paragraph_zero_based":15406},{"literal_text_all_w_t_and_m_t":"- d(k) is the number of NPN index values used in the k-th npn-IdentityList entry within the n-th NPN-IdentityInfoList entry;","paragraph_zero_based":15407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0b53e606e2062f07e790166706277d56546c45b446e817817b16719b330f2b68","ef432583f60fd6be548bdeeaf0b3367e06ef347707281b4d2ad5cfee5e64cf67","6f2a68fe5d234ebb237a492d02f077424752963c69933dcc4ffab543d23d2e75","cbac1067ffa8c0e32bcc689db35b93f202bdf779466b985caae357c791435323","7bb4665642938ed97488e5f1a3992221b17b87597c279398b548f9a63335e066","c73b51aa719ad05cb353c65d6c720b40b615884249fbaee211b34cbc96a88195","70e39400dd3e3e59f1f8e329af9da8c8876d9e16196a5af39c72a7135715eddf","d5f1d69fa4055d40dcf2b903e03f6b97e6c0356038ece246d1320468a7884880","ccecef18847f249cd2d82a1f5f48c2b53faa78385478b360df1fc49dcf80f554","1d75b4034309db54cb6d96646c659ac0142501b0de411c74f243cb7f600e4ed1","cfdcffddd9f5f3e9983c26f99f341f282b95fc8308b2f568b0685ba7ca0bfdc8","329007565cbf0a75989400065f49336ba07637191ddf507ba9d3e647dbf520bc","3105f0baa25756c88da722130445669ca16bb810b4b2f26a9179166c1b63e13e","3e5eed9b6686ce306cface099d25eb9bc244e246feb25db539ec285a76313913","296a1776233c5a4f3646d2adc8d2edd59d86bf71b603474cafe91ca4db337f43","adabb7b13394661e1d079f04fd464d1ade9123b1b766ad945319afb2888e419d","99344bb294843f32b863074357ae9040501e57e37eca1884f5920122cf99a7a2","a77ad57299e54b853020d8134223a0a55a159ba1232ece5df87dd3a8c7f4b491","a76d52a295b89c1af27cf7d91746e148d8ac26e2de6e26d84def48d612742758","2260e30bd92ddf8cb44b5f647da61d1237bcc8d7c69ce6ff06995a512ab6ceb0","5736f1e8006405ab1eeceb34e6b1dda0806716b504d036c1d71648fe5be12fa2","0573843e2982a3019f5557078ea99eb902f7072512034c588942c81e68daf739","160a75d3be70cbca32afc70c8bdc3611213f215d6ac6c921b8c3e0ad535dc668","f82a59558996f41e4137b792f2afff097ef0b169f01e7215bbb5187dc5cb232c"],"paragraph_range_zero_based":[15384,15407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15384"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- e(i) is","paragraph_zero_based":15408},{"literal_text_all_w_t_and_m_t":"    - i if the n-th entry of NPN-IdentityInfoList entry is for SNPN(s);","paragraph_zero_based":15409},{"literal_text_all_w_t_and_m_t":"    - 1 if the n-th entry of NPN-IdentityInfoList entry is for PNI-NPN(s).","paragraph_zero_based":15410},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":15411},{"literal_text_all_w_t_and_m_t":"The plmn-IdentityInfoList is used to configure a set of PLMN-IdentityInfo elements. Each of those elements contains a list of one or more PLMN Identities and additional information associated with those PLMNs. A PLMN-identity can be included only once, and in only one entry of the PLMN-IdentityInfoList. The PLMN index is defined as b1+b2+…+b(n-1)+i for the PLMN included at the n-th entry of PLMN-IdentityInfoList and the i-th entry of its corresponding PLMN-IdentityInfo, where b(j) is the number of PLMN-Identity entries in each PLMN-IdentityInfo, respectively.","paragraph_zero_based":15412},{"literal_text_all_w_t_and_m_t":"snpn-AccessInfoList","paragraph_zero_based":15413},{"literal_text_all_w_t_and_m_t":"This list provides access related information for each SNPN in npn-IdentityInfoList, see TS 23.501 [32]. The n-th entry of the list contains the access related information of the n-th SNPN in npn-IdentityInfoList. ","paragraph_zero_based":15414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15415},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo field descriptions","paragraph_zero_based":15416},{"literal_text_all_w_t_and_m_t":"extCH-Supported","paragraph_zero_based":15417},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports access using credentials from a Credentials Holder as specified in TS 23.501 [32].","paragraph_zero_based":15418},{"literal_text_all_w_t_and_m_t":"extCH-WithoutConfigAllowed","paragraph_zero_based":15419},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN allows registration attempts with credentials from a Credentials Holder from UEs that are not explicitly configured to select the SNPN as specified in TS 23.501 [32].","paragraph_zero_based":15420},{"literal_text_all_w_t_and_m_t":"imsEmergencySupportForSNPN","paragraph_zero_based":15421},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports IMS emergency bearer services for UEs in limited service mode in the cell. If absent, IMS emergency call is not supported by the SNPN in the cell for UEs in limited service mode.","paragraph_zero_based":15422},{"literal_text_all_w_t_and_m_t":"onboardingEnabled","paragraph_zero_based":15423},{"literal_text_all_w_t_and_m_t":"Indicates whether the onboarding SNPN allows registration for onboarding in the cell as specified in TS 23.501 [32].","paragraph_zero_based":15424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15425},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo-EUTRA-5GC","paragraph_zero_based":15426},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-5GC indicates cell access related information for an LTE cell connected to 5GC.","paragraph_zero_based":15427},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-5GC information element","paragraph_zero_based":15428},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15429},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-5GC-START","paragraph_zero_based":15430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a120