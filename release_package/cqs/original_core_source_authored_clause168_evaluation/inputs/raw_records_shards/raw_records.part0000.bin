6":"c1ed42b119e148cbb57fcea39491d4da5b78930bc8a6166f3f3e3aba27e25a2c","original_member_sha256":"f3afebf4757d0143b195626e6dcb6201bb479e0a62fc2aa634fb9db81c094386","paragraph_ElementTree_utf8_XML_sha256":["7cc3406fb68ca6f43bf9dcf1c921b049b2ad75a93f9fa86e67fe488d35219e0f","9fbe8dd6873a06962184d34e506ee28efaa4542eff5f29a04aede1164754d135","2269bc799252af61804645cf6d53b50db27f7fcb355c2d576394e4ea40042d5b","41e4314ebd0c9523530a4e89b13415dec9273f020d4b055cd37b601701e6c7bc","de19282850651a1bb86237f3450b1b891fb0822e86e9cc6db476c45a328d5956","b35e8de4c911e0cad18cdd757ca97ac3dc7cd35f805dd9a3a22673fde4aade6a","27c178b438f6cd8778504298cb58c74669d97775f38f67641119862798e2591b","a0377bfba54d4cc79c05e65a7e2fc37e56d5e152221c62584521d6a582c43da1","26a35660ab2b887c94499ccae924c0ce66710bd2f170fe0c75fd5371b04afb34","23f34dd10129f77546b6642095d10787368e87bfd68c29468df1317f03e782b8","c8b7b054426c42a2c0167a64b4640cdacc4f5cd3c6a36a6da8ebe5f9bbc82b2f","8a047e7d7fff416e296e19d53d27acd0c58031592ca1dec7a4853d5caa326f83","b84490d69ea72281617e183aa14c3a768f3a53266ad1de68c24a0da109aae9de","18719ae5ceee2140c0e3c3be1a40d3cdf8aa1e13473ae5909115b24703e41f94","1d3f3f445c94eab2e1b99bd42837f40ef5f16502d41f3c62e9a5884442844b37","7c2ff97e2e8a018874be3b6852d495af0cb423167c71978a6476fef3e697c2a4","c9a3ca461a81740038364b699c9e229c585ad549080b14b831f04e2918441539","06780969aaf7721dfa373d6fa43b02a7155087ff2f3b711ecdd4ebf41311c2c4","f2ae3f9a93a2aae7e9f5943af95ee03af53f5adb1317e65dc3002ea31854bb6d","883bb95964501f62518226050e40fbe2fdd546eaf1834be5387f65f16941018a","d78ae593302e8e26b08a5489e402adfe8f3c4b1c90110fb25cd59735d40cd7e6","74ae6d8954a69a21e7474fbabd03ebe98439a26fd9d3d94dbd377bc965a8fd90","d11f1775d370df83b7293b59d0f9ccf22dca42dee8afeef31d15acb2e6509fb1","e7a65e72b50a0dc39a8b57ed5acad35bcf730b083ba2ecf5783072ded6c93900"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"