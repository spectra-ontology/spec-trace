{"fields":{"filename":"R2-2305363.zip::R2-2305363 Correction on PosSRS-RRC-Inactive-OutsideInitialUL-BWP.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6.3.3UE capability information elements","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"––PosSRS-RRC-Inactive-OutsideInitialUL-BWP","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"The IE PosSRS-RRC-Inactive-OutsideInitialUL-BWP is used to convey the capabilities supported by the UE for Positioning SRS transmission in RRC_INACTIVE state configured outside initial UL BWP.","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"PosSRS-RRC-Inactive-OutsideInitialUL-BWP information element","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"-- TAG-POSSRS-RRC-INACTIVE-OUTSIDEINITIALUL-BWP-START","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"PosSRS-RRC-Inactive-OutsideInitialUL-BWP-r17::= SEQUENCE {","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"    -- R1 27-15b: Positioning SRS transmission in RRC_INACTIVE state configured outside initial UL BWP","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"    maxSRSposBandwidthForEachSCS-withinCC-FR1-r17   ENUMERATED {mhz5, mhz10, mhz15, mhz20, mhz25, mhz30, mhz35, mhz40,","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"                                                    mhz45, mhz50, mhz60, mhz70, mhz80, mhz90, mhz100}                    OPTIONAL,","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    maxSRSposBandwidthForEachSCS-withinCC-FR2-r17   ENUMERATED {mhz50, mhz100, mhz200, mhz400}                        OPTIONAL,","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    maxNumOfSRSposResourceSets-r17                  ENUMERATED {n1, n2, n4, n8, n12, n16}                         OPTIONAL,","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    maxNumOfPeriodicSRSposResources-r17             ENUMERATED {n1, n2, n4, n8, n16, n32, n64}                    OPTIONAL,","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"    maxNumOfPeriodicSRSposResourcesPerSlot-r17      ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10, n12, n14}        OPTIONAL,","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"    differentNumerologyBetweenSRSposAndInitialBWP-r17  ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"    srsPosWithoutRestrictionOnBWP-r17               ENUMERATED {supported}                                        OPTIONAL,","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"    maxNumOfPeriodicAndSemipersistentSRSposResources-r17  ENUMERATED {n1, n2, n4, n8, n16, n32, n64}              OPTIONAL,","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"    maxNumOfPeriodicAndSemipersistentSRSposResourcesPerSlot-r17  ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10, n12, n14}  OPTIONAL,","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    differentCenterFreqBetweenSRSposAndInitialBWP-r17  ENUMERATED {supported}                                     OPTIONAL,","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    switchingTimeSRS-TX-OtherTX-r17                 ENUMERATED {us100, us140, us200, us300, us500}                OPTIONAL,","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"    -- R1 27-15c: Support of positioning SRS transmission in RRC_INACTIVE state outside initial BWP with semi-persistent SRS","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"    maxNumOfSemiPersistentSRSposResources-r17       ENUMERATED {n1, n2, n4, n8, n16, n32, n64}                    OPTIONAL,","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"    maxNumOfSemiPersis