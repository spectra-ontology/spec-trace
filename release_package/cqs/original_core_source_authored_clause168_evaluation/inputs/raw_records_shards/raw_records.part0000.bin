{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41760},{"literal_text_all_w_t_and_m_t":"VarResumeMAC-Input field descriptions","paragraph_zero_based":41761},{"literal_text_all_w_t_and_m_t":"targetCellIdentity","paragraph_zero_based":41762},{"literal_text_all_w_t_and_m_t":"An input variable used to calculate the resumeMAC-I. Set to the cellIdentity of the first PLMN-Identity included in the PLMN-IdentityInfoList broadcasted in SIB1 of the target cell i.e. the cell the UE is trying to resume.","paragraph_zero_based":41763},{"literal_text_all_w_t_and_m_t":"source-c-RNTI","paragraph_zero_based":41764},{"literal_text_all_w_t_and_m_t":"Set to C-RNTI that the UE had in the PCell it was connected to prior to suspension of the RRC connection.","paragraph_zero_based":41765},{"literal_text_all_w_t_and_m_t":"sourcePhysCellId","paragraph_zero_based":41766},{"literal_text_all_w_t_and_m_t":"Set to the physical cell identity of the PCell the UE was connected to prior to suspension of the RRC connection.","paragraph_zero_based":41767},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41768},{"literal_text_all_w_t_and_m_t":"–VarRLF-Report","paragraph_zero_based":41769},{"literal_text_all_w_t_and_m_t":"The UE variable VarRLF-Report includes the radio link failure information or handover failure information.","paragraph_zero_based":41770},{"literal_text_all_w_t_and_m_t":"VarRLF-Report UE variable","paragraph_zero_based":41771},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41772},{"literal_text_all_w_t_and_m_t":"-- TAG-VARRLF-REPORT-START","paragraph_zero_based":41773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41774},{"literal_text_all_w_t_and_m_t":"VarRLF-Report-r16 ::=    SEQUENCE {","paragraph_zero_based":41775},{"literal_text_all_w_t_and_m_t":"    rlf-Report-r16           RLF-Report-r16,","paragraph_zero_based":41776},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-r16    PLMN-IdentityList2-r16","paragraph_zero_based":41777},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":41778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41779},{"literal_text_all_w_t_and_m_t":"-- TAG-VARRLF-REPORT-STOP","paragraph_zero_based":41780},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":41781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41782},{"literal_text_all_w_t_and_m_t":"–VarShortMAC-Input","paragraph_zero_based":41783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["aad379f9a374aeb3edc6be18d607bf18675ce92ad433345d1481d90a2e1ebceb","5d1c710a3173f77e5c62d1c402796cf7e237af71c20138e27dd8b1f826c476e6","326dc69c46d84907376cfc585f3023a5044eb79559e485482f1d89bb04004ff8","9cc069f37383a3bb9430ed12cffd5016c413ec517bde70c328b6984efb5fee3b","ebc2ff6d285545a8b4e8f962181d8d9e2840a8be0a19cab4c76cd7af2773c70b","bc9a6b7852c10d1adfe56d4c3839fb23bcfb7dbef275dcc0b7a7d8ec97e75a68","7df902cd57fd901e318b9a0080aad0940df86641edd6b07c6f82ca47fe4145d9","95381609867018643fbf09840aa6572aaa90572d811e28dadc519f58ceb2e167","bce32e619a1b1c5297a605737c807c5bfcb887967160cd6f82ea94243dfb1550","a6e0e438640d9a98fdf089cea23086c0df1c1911f94fb2d6f2937aef5e5708ff","2c29e7a9ffcb51868715a8297eddaf8796844bd6155fe72d2fa06f618fd3911b","61aa4f1fff7c8cf5db104edbaa47abe5e2b46233a83995c199691533b69e8f1c","37f80888f1e570d9d2146d5cfa2742224862c781198ac974ddb8161486ec6d2f","3842165adc1fb7e311c2fd87a990d0da9d173218077dc316cd21084e78b412f4","ec8b8cab64e717c9d382d7697c22d5b4d285fc03ee1bc951016d320a0046ff5f","643c78af421e4bd6fe274d31c0a56d1c7cbd80d691b56e67eade274cb197f2f7","768871c8ecb7aa4ee14c8670dd1a23452281abf0187ae55e67a71ccf84b741ec","683e584a03399c7c56b1bb8b6e6e86183ede2708a70c58f159bccee05edde4a5","3600abbbcb9f63ca16e2894fb4b1bece4d05f36450f47f9c5cc9469c286a1343","b9b4994d2c25dab617f1d094b1a4989642cc32d614239e80ecf0ca5480c43c85","703b48b8019892b8fdeeca7eacab04ec6b61830da49b1d43f891e7cd40c01fba","245106733b264e08e92b4e04008bd676349cda48bcb846024236a3d80e6179c4","ac992f1eeda143845590d797d355fd27a7043c44ef68d82ccf314c41a35a7dc5","e8b0bd87a99b0f18274d8b9435e6e1a010a6804ccad8970d402ffae79ed0eb2c"],"paragraph_range_zero_based":[41760,41783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p41760"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE variable VarShortMAC-Input specifies the input used to generate the shortMAC-I during RRC Connection Reestablishment procedure.","paragraph_zero_based":41784},{"literal_text_all_w_t_and_m_t":"VarShortMAC-Input variable","paragraph_zero_based":41785},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":41786},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSHORTMAC-INPUT-START","paragraph_zero_based":41787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41788},{"literal_text_all_w_t_and_m_t":"VarShortMAC-Input   ::=                 SEQUENCE {","paragraph_zero_based":41789},{"literal_text_all_w_t_and_m_t":"    sourcePhysCellId                        PhysCellId,","paragraph_zero_based":41790},{"literal_text_all_w_t_and_m_t":"    targetCellIdentity                      CellIdentity,","paragraph_zero_based":41791},{"literal_text_all_w_t_and_m_t":"    source-c-RNTI                           RNTI-Value","paragraph_zero_based":41792},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":41793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41794},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSHORTMAC-INPUT-STOP","paragraph_zero_based":41795},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":41796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41797},{"literal_text_all_w_t_and_m_t":"VarShortMAC-Input field descriptions","paragraph_zero_based":41798},{"literal_text_all_w_t_and_m_t":"targetCellIdentity","paragraph_zero_based":41799},{"literal_text_all_w_t_and_m_t":"An input variable used to calculate the shortMAC-I. Set to the cellIdentity of the first PLMN-Identity in the PLMN-IdentityInfoList broadcasted in SIB1 of the target cell i.e. the cell the UE is trying to reestablish the connection.","paragraph_zero_based":41800},{"literal_text_all_w_t_and_m_t":"source-c-RNTI","paragraph_zero_based":41801},{"literal_text_all_w_t_and_m_t":"Set to C-RNTI that the UE had in the PCell it was connected to prior to the reestablishment.","paragraph_zero_based":41802},{"literal_text_all_w_t_and_m_t":"sourcePhysCellId","paragraph_zero_based":41803},{"literal_text_all_w_t_and_m_t":"Set to the physical cell identity of the PCell the UE was connected to prior to the reestablishment.","paragraph_zero_based":41804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41805},{"literal_text_all_w_t_and_m_t":"–VarSuccessHO-Report","paragraph_zero_based":41806},{"literal_text_all_w_t_and_m_t":"The UE variable VarSuccessHO-Report includes the successful handover information.","paragraph_zero_based":41807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1172dfb5bf83ae69d0eb5979702e7dff87a334b37b2cf39eebec3c388f48c028","3b5d0cf36732920c2330e35c399705f1531ccf6798f267aca76ff7f87f287497","f3da8a3d16ebf5ef52f6ab4026bd24a7756777975f6957c26edf3e71ba2d600f","343aa78b44ac02266babcdbddff88f66ee0164a204438994ade7c56d799dd175","8f213e87909715587f6e131123bd3a07e8ab05d7b5984a41a2dd429438e28d89","2247341740cc1baf36157d14042d2bd523e6dcc0754dd440a96d77bd5466fdfa","aefe007a10710979a7c4606ac54957a2d5f2110a695fcc9c9de9957025d04534","5723ed1f9f530c519004dd6ae90de3f17e36a74537f49a87228afd3778d87437","e256473e4d8ea4c125152f28759a9c61e4d70a76b02803d75b854b9bafe375ef","b2cb21cf13ab03c6a035f6fb8140a3e3069468f662bdaee14248fba4d4fa37bc","4406cc8c5ec7ffd2f1aecf8759587adb4fdf09db9754fb5d30559034a057fa5e","3019738a7f13107bec3e4dda793b0c3ef9c5df4c071797d20baa84dc21279ce7","e9cd70e3de213c672624035cc5f4d2e123cd44