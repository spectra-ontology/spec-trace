{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release idc-AssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3648},{"literal_text_all_w_t_and_m_t":"1>release drx-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3649},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346a, if running;","paragraph_zero_based":3650},{"literal_text_all_w_t_and_m_t":"1>release maxBW-PreferenceConfig and maxBW-PreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3651},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346b, if running;","paragraph_zero_based":3652},{"literal_text_all_w_t_and_m_t":"1>release maxCC-PreferenceConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3653},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346c, if running;","paragraph_zero_based":3654},{"literal_text_all_w_t_and_m_t":"1>release maxMIMO-LayerPreferenceConfig and maxMIMO-LayerPreferenceConfigFR2-2 for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3655},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346d, if running;","paragraph_zero_based":3656},{"literal_text_all_w_t_and_m_t":"1>release minSchedulingOffsetPreferenceConfig and minSchedulingOffsetPreferenceConfigExt for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3657},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346e, if running;","paragraph_zero_based":3658},{"literal_text_all_w_t_and_m_t":"1>release rlm-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3659},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346j, if running;","paragraph_zero_based":3660},{"literal_text_all_w_t_and_m_t":"1>release bfd-RelaxationReportingConfig for all configured cell groups from the UE Inactive AS context, if stored;","paragraph_zero_based":3661},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346k, if running;","paragraph_zero_based":3662},{"literal_text_all_w_t_and_m_t":"1>release releasePreferenceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":3663},{"literal_text_all_w_t_and_m_t":"1>release wlanNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":3664},{"literal_text_all_w_t_and_m_t":"1>release btNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":3665},{"literal_text_all_w_t_and_m_t":"1>release sensorNameList from the UE Inactive AS context, if stored;","paragraph_zero_based":3666},{"literal_text_all_w_t_and_m_t":"1>release obtainCommonLocation from the UE Inactive AS context, if stored;","paragraph_zero_based":3667},{"literal_text_all_w_t_and_m_t":"1>stop timer T346f, if running;","paragraph_zero_based":3668},{"literal_text_all_w_t_and_m_t":"1>stop timer T346i, if running;","paragraph_zero_based":3669},{"literal_text_all_w_t_and_m_t":"1>release referenceTimePreferenceReporting from the UE Inactive AS context, if stored;","paragraph_zero_based":3670},{"literal_text_all_w_t_and_m_t":"1>release sl-AssistanceConfigNR from the UE Inactive AS context, if stored;","paragraph_zero_based":3671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8b47038e0c4f260521421030fb4029c76ff1a6ad32b2690bde5fc98c6f3781