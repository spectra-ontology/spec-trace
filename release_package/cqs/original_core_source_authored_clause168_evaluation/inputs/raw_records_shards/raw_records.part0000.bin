VE (e.g. cell (re-)selection parameters, neighbouring cell information) and information (also) applicable for UEs in RRC_CONNECTED (e.g. common channel configuration information);","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"78722f96da2c1b0794be02771e6d00815867826bc913cd2dc90778e7cf20a03c","original_member_sha256":"01249659941507b71cdd3a9a4350d5330966e5252dc21fbfc70854bb5a08b2f1","paragraph_ElementTree_utf8_XML_sha256":["ad2a4714c0a63b18878159c3d9bbe9c481676315ac42fb9544bc7fda020f2d1e","e24cde4ea5c35e796b427568898c8cbcd588e79272057abd251cd64440335739","3d826a78875d313c6ea7224fb6357911a2b8032c2d4e094de2e3b15acfe457f3","8342215bf977a1d7fb7029dc59045c03464e269e07eee83a3dcd21bc222281b6","96e967a21b714b666ab450879f14dd221155c04d1872680d89739a12bc7b1603","85da99af6510ff7760ae4e18c81eb46ff0a1d766b719a496f8ed4b94a10e282d","441eac2b218a6e922d8067fccb73ecbee5cade1bbee1a4d43aac5a6b06268c1c","1fe22be8e98f3ee0cd2f801236c0053c81445054689e897d9c899aaf1e4b0270","1b4cca771adc2a0a6eea661e1d12a832cceb17e7ad70b17641b4ce04306ea242","58890d00d27f08dd2ada58038a3d7626db7e9a4972f5db99ad5cfa40812996d5","d8c9285fc70f356d97a74f87345c6d18638a575becd0bb78ae6aa1e78884536c","a14d0272616c5229b220a8f3355b3c6c537c45a28424682e6ba25ae95982673f","3eb06b70e97d2e84607f51c28f85ecc631fadcadff6de012eafd88e2589df3a9","7c4a7c4dcfae1f1bc48791e57ad1bc5384bce188e3c770946e560b5294e6c73f","c953a106d45de973bd960640132f7e7f6f24c5f3c84b56ec52635d23115ff96e","5628a3c232ad1f24d9f1d9c6d0b656fdc254a5cbc5e7e1919c30a0888e614853","716c99885d608aab85771d2bbadb6c0973005abb7bf4e9ba5d65287a53eb6ff3","23692892395977a78919430ae7d6133e79afbdd27dc80154ec3e1f85c4550ded","fb51f708c77146d612da31be9d76c366cb03ff7ecef157e4dff685db04c07a59","ca25f91b9cc90f3bcfe616f26f502c7e38897694d2764e843e92bb14160594b3","d8d05d4222af8f5680c7123229d1f7df28a54d384b596c95e4c59f4e886420f5","8c8bb6b3be9a1245bfe997b082dc34