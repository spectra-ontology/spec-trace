{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CO-Duration-r17 ::=    INTEGER (0..4480)","paragraph_zero_based":28440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28441},{"literal_text_all_w_t_and_m_t":"AvailableRB-SetsPerCell-r16 ::=   SEQUENCE {","paragraph_zero_based":28442},{"literal_text_all_w_t_and_m_t":"    servingCellId-r16                 ServCellIndex,","paragraph_zero_based":28443},{"literal_text_all_w_t_and_m_t":"    positionInDCI-r16                 INTEGER(0..maxSFI-DCI-PayloadSize-1)","paragraph_zero_based":28444},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28446},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchTrigger-r16 ::=   SEQUENCE {","paragraph_zero_based":28447},{"literal_text_all_w_t_and_m_t":"    servingCellId-r16                  ServCellIndex,","paragraph_zero_based":28448},{"literal_text_all_w_t_and_m_t":"    positionInDCI-r16                  INTEGER(0..maxSFI-DCI-PayloadSize-1)","paragraph_zero_based":28449},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28451},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATINDICATOR-STOP","paragraph_zero_based":28452},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28454},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator field descriptions","paragraph_zero_based":28455},{"literal_text_all_w_t_and_m_t":"availableRB-SetsToAddModList","paragraph_zero_based":28456},{"literal_text_all_w_t_and_m_t":"A list of AvailableRB-SetsPerCell objects (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28457},{"literal_text_all_w_t_and_m_t":"co-DurationsPerCellToAddModList","paragraph_zero_based":28458},{"literal_text_all_w_t_and_m_t":"A list of CO-DurationsPerCell objects. If not configured, the UE uses the slot format indicator (SFI), if available, to determine the channel occupancy duration (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28459},{"literal_text_all_w_t_and_m_t":"co-DurationsPerCellToReleaseList","paragraph_zero_based":28460},{"literal_text_all_w_t_and_m_t":"A list of CO-DurationsPerCell objects to be released. An entry created using co-DurationsPerCellToAddModList-r16 or co-DurationsPerCellToAddModList-r17 can be deleted using co-DurationsPerCellToReleaseList.","paragraph_zero_based":28461},{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":28462},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with SFI-RNTI (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7b0c935de10e353a630bf2ae95b921018b4a9f035336a7b7262fff6bd75b4a38","0d94ced556d4a314777e0322f5ac5c4c1d62b9476ca9931de29078719d7dc58b","b0d8e388450ac2f0a1e0aa0fbf84d1ea1f6db1283cd6a21395233641d7614a9e","f9fe6f78969fdb019f1450983ab5e2cc30ffd0decc1fe8c34ae8c4a75e76efb6","99f9231079fbe9bd01cbc8038214d43a3032dca35ad0a5bab749514acfb34e70","2531618e8818b2d78950a5ebf0e6d584b2f0511d2a49ebac48943903f8c5b0f8","2133bd39ca09ab60d6b08f6150b771aaba05ec3cc188fd82b4762bed78a112af","44be21f38eff58e06c73f09f357f08f1282a9ab28682fbb0c17eb4ecd47dcd61","df9a068578ae4a5b609605b9c0bc33c9e93773daeef8f73804211b13225d02f1","47ab732be511327e08bbc0ba51cf44613c586d8bb6201e8e8be9049d752b728c","a1fd9d169e3238c72eda9ac38b0efb6d504c9e5d26d8e1bbe412b9edf2fb7b26","0d0b04186826a87b6dd7a7528eac0a2c389a8661a2286f1aca52a594f37098e7","5e843c635ed6325e5d22a5410b383a13b73ffe7491190c41aa9f62a51e2adf06","6b07e2afc91661da1f4ae93c76925b71306f08de5dbcbf4f33ed019ef0f1c512","3aa4ae1451ac2b1307d894e741cb52c77800ce0a56974a078dfcf78aa17d7c74","db379453966fc8a58b6faac8eff818ef5dd88918bf597e0fb482c743b8353e2d","8a38f38ffc38d0b7c7e1ffa463f80c018a0b1181cf9b03707abd00ffcc1e01a3","56f6a25b0904a06f59a7cb5e603cb14eb8e5ced79c638029896da5ef55a9b5db","14fd5fa2d2320bab4b42b1cb5176cd567af13ac82ca1f8519067a51a8fc89570","d8c1a9fa78a811cbfd5c2016cdf71135ec5c078f03e8289df01bafe40d67a546","ad62e77e0ccef4ecfb5b1831c5a4a169cb88f04f12aa08e13837b40e454b9a47","c21ed5b549ca74e150bade6d864f2c6ff3baf00b8d073ffdd28526cb98ab414c","40c35f3bf7af3cce270c1e72e8e16652ea3ef7149e20d1cbd015eccf57937f30","87534fe0a08fc03c6c0a75ae543c7406d8be940d7ad2fe0f39311654d0f82c47"],"paragraph_range_zero_based":[28440,28463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28440"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sfi-RNTI","paragraph_zero_based":28464},{"literal_text_all_w_t_and_m_t":"RNTI used for SFI on the given cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28465},{"literal_text_all_w_t_and_m_t":"slotFormatCombToAddModList","paragraph_zero_based":28466},{"literal_text_all_w_t_and_m_t":"A list of SlotFormatCombinations for the UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28467},{"literal_text_all_w_t_and_m_t":"switchTriggerToAddModList, switchTriggerToAddModListSizeExt","paragraph_zero_based":28468},{"literal_text_all_w_t_and_m_t":"A list of SearchSpaceSwitchTrigger objects. Each SearchSpaceSwitchTrigger object provides position in DCI of the bit field indicating search space switching flag for a serving cell or, if cellGroupsForSwitchList is configured, group of serving cells (see TS 38.213 [13], clause 10.4). If cellGroupsForSwitchList is configured, only one of the cells belonging to the same cell group is added/modified, and the configuration applies to all cells belonging to the cellGroupsForSwitchList (see TS 38.213 [13], clause 10.4). The network configures more than 4 SearchSpaceSwitchTrigger objects only if cellGroupsForSwitchList is not configured. The UE shall consider entries in switchTriggerToAddModList and in switchTriggerToAddModListSizeExt as a single list, i.e. an entry created using switchTriggerToAddModList can be modifed using switchTriggerToAddModListSizeExt and vice-versa.","paragraph_zero_based":28469},{"literal_text_all_w_t_and_m_t":"switchTriggerToReleaseModList, switchTriggerToReleaseListSizeExt","paragraph_zero_based":28470},{"literal_text_all_w_t_and_m_t":"A list of SearchSpaceSwitchTriggers to be released. If cellGroupsForSwitchList is configured, the SearchSpaceSwitchTrigger is released for all serving cells belonging to the same CellGroupForSwitch. The UE shall consider entries in switchTriggerToReleaseList and in switchTriggerToReleaseListSizeExt as a single list, i.e. an entry created using switchTriggerToAddModList or switchTriggerToAddModListSizeExt can be deleted using switchTriggerToReleaseList or switchTriggerToReleaseListSizeExt.","paragraph_zero_based":28471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28472},{"literal_text_all_w_t_and_m_t":"AvailableRB-SetsPerCell field descriptions","paragraph_zero_based":28473},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28474},{"literal_text_all_w_t_and_m_t":"The (starting) position of the bits within DCI payload indicating the availability of the RB sets of a serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28475},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":28476},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":28477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28478},{"literal_text_all_w_t_and_m_t":"CO-DurationsPerCell field descriptions","paragraph_zero_based":28479},{"literal_text_all_w_t_and_m_t":"co-DurationList","paragraph_zero_based":28480},{"literal_text_all_w_t_and_m_t":"A list of Channel Occupancy duration in symbols.","paragraph_zero_based":28481},{"literal_text_all_w_t_and_m_t":"The maximum duration that can be configured for the following SCS:","paragraph_zero_based":28482},{"literal_text_all_w_t_and_m_t":"-15 kHz: 280.","paragraph_zero_based":28483},{"literal_text_all_w_t_and_m_t":"-30 kHz: 560.","paragraph_zero_based":28484},{"literal_text_all_w_t_and_m_t":"-60 kHz: 1120.","paragraph_zero_based":28485},{"literal_text_all_w_t_and_m_t":"-120 kHz: 560.","paragraph_zero_based":28486},{"literal_text_all_w_t_and_m_t":"-480 kHz: 2240.","paragraph_zero_based":28487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a1b6325337fb83b85d7d7111468cec6dd5ed0ee6e2ab80e98bc244132997665b","7d0a31284988a6faf35fba94a7d93a4fe8509e193efcf52e4f80875888bd0853","ef83fd5993519f3359b1b6b49a9e345ec1e842fcfce005704aa2397b3177ff82","3d2e73f6271a6cc3a8d28ec3d74e0f627140291ebcfc404fb4d097a628c2a307","16e7d9675fa595dc64def17d2ee3956da129a5d341128d7ac08ab1a6abad16d0","f721c83d97d8bf95653d61bc636ae12f6bddd53b7be8618927997265b1399f34","d473092fd5ca7ddbfa02bd21926042f191e9ea4fe16d23ad0e16d46ee2469346","91f8a9d5d24762ffbb7cae837e4cd92811272014e6390af51706b52a7802eb11","ade8f1405845ba0560fb63e469f1bdcd1853401939f266c83b0553972db48893","4ccde990ff8942a0903e14830dd0e79b6f53a55631734b755f837b659b194a5b","8165458cff133602799726faea15471a1bf75a56c025b6b6abf701a3bd3f6dda","3ea9543fccd5be1c4e5b291f155427027e1ccbeb690b9ead2c77891935a6f176","9f3baf64aa819821cb1fab080ef53a8713b4dadff1e7e2151ab8169eeb40c419","5acbb71ac0355db02c13df79a29ed86a1f56ae663dc59bccb5f643e6e72f4e8f","5a1900da37c1b444da105bc6fdf0df07f99dfc6ae926d2580ce4a751ee276c13","e769ee1de91f18e9e463b8b563314081a2a3b42370a585bce5114576b53459fc","f44503c762dc3fc5417fb2ccfcd73f89d64281b2fdcd9126b93b58432855d47f","88241be5470a44365221c2dfd6a145c1053f05813470bb58e85182e113f665a6","9f28b17e2d4081514db201afe6dbcc925b34e16fc3b03b2290338541cf7693c8","f2d4e878b87404a825d91c04c6aa794b6b3ea8520bc0c569cacff77167cbc3aa","462ce916e22ad9f8ec13ea6c6a44c640f251f9082ad253519392a2da19627fd0","b66b77cfc49f7793a3ab00dba26e27c194b0e04a689589b5befab07668436d42","225663013ad2ac34a2113860ca8323cf80532454a155aa2eea1996fccfc28ac0","eee710e92981ed021283b1430727f60dface83b48028bbf594ff6509e6afa9e1"],"paragraph_range_zero_based":[28464,28487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28464"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-960 kHz: 4480.","paragraph_zero_based":28488},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28489},{"literal_text_all_w_t_and_m_t":"Position in DCI of the bit field indicating Channel Occupancy duration for UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28490},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":28491},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":28492},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":28493},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for the list of Channel Occupancy durations (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28494},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency range:","paragraph_zero_based":28495},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":28496},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":28497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28498},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchTrigger field descriptions","paragraph_zero_based":28499},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":28500},{"literal_text_all_w_t_and_m_t":"The position of the bit within DCI payload containing a search space switching flag (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":28501},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":28502},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable or the group of serving cells as indicated by CellGroupsForSwitch-r16 containing this servingCellId.","paragraph_zero_based":28503},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28504},{"literal_text_all_w_t_and_m_t":"–S-NSSAI","paragraph_zero_based":28505},{"literal_text_all_w_t_and_m_t":"The IE S-NSSAI (Single Network Slice Selection Assistance Information) identifies a Network Slice end to end and comprises a slice/service type and a slice differentiator, see TS 23.003 [21].","paragraph_zero_based":28506},{"literal_text_all_w_t_and_m_t":"S-NSSAI information element","paragraph_zero_based":28507},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28508},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-START","paragraph_zero_based":28509},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28510},{"literal_text_all_w_t_and_m_t":"S-NSSAI  ::=                        CHOICE{","paragraph_zero_based":28511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3e2a7d1ee7e8e746844a768318d285b44673979bac1986d3d4fedfffe8683f86","eb323f66285e57f4c6802d8e3b08d05b6e7dc3e4665da94b0b1b857d4e275f1a","c3668cfd5ea3220951b4fe26af9610fff9ede20281da953d8554ead56b178482","22d6daefd586a1cdfcb957b70729667bffaa21b9c984eee021fd83c32b83b56f","f8a4245a9ce261fbc1f02e484dc69e5eaeb7149a548b1074843cefd8f3b06407","166766d1b016af6cee44ef61ac69fd2f5731e041281a435b918b19dc7a024c1d","09599666e062aa539e89fb1943c8c614273d2407e4f527ab8ad75a6e588c3708","9f0a1e92118d7e5a6233b5830b14bdca94276f5e377c335bdbf3c4938f15745f","cfbd7fb799cc2662b6255ff25837eb07dbf62aa8fcf4cf19edb68acb4927c683","0e812e61e8100e2ee7caf9376295cff28e188eeaa53ca07c7b1d9dfae5eb4051","78e4ee512224bd546c05118c51de73815fe60cb501accc1a52cb4f1d60adc0f9","ed53e65947959d6