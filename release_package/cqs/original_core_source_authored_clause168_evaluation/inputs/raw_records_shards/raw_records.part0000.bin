{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"udreINTEGER (0..3),","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"pseudoRangeCorINTEGER (-2047..2047),","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"rangeRateCorINTEGER (-127..127),","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"udreGrowthRateINTEGER (0..7)OPTIONAL,-- Need ON","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"udreValidityTimeINTEGER (0..7)OPTIONAL,-- Need ON","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"GNSS-DifferentialCorrections field descriptions","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"dgnss-RefTime","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"This field specifies the time for which the DGNSS corrections are valid, modulo 1 hour. dgnss-RefTime is given in GNSS specific system time.","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"Scale factor 1second.","paragraph_zero_based":613},{"literal_text_all_w_t_and_m_t":"dgnss-SgnTypeList","paragraph_zero_based":614},{"literal_text_all_w_t_and_m_t":"This list includes differential correction data for different GNSS signal types, identified by GNSS-SignalID.","paragraph_zero_based":615},{"literal_text_all_w_t_and_m_t":"gnss-StatusHealth","paragraph_zero_based":616},{"literal_text_all_w_t_and_m_t":"This field specifies the status of the differential corrections. The values of this field and their respective meanings are defined as in table gnss-StatusHealth Value to Indication relation below.","paragraph_zero_based":617},{"literal_text_all_w_t_and_m_t":"The first six values in this field indicate valid differential corrections. When using the values described below, the \"UDRE Scale Factor\" value is applied to the UDRE values contained in the element. The purpose is to indicate an estimate in the amount of error in the corrections.","paragraph_zero_based":618},{"literal_text_all_w_t_and_m_t":"The value \"110\" indicates that the source of the differential corrections (e.g., reference station or external DGNSS network) is currently not being monitored. The value \"111\" indicates that the corrections provided by the source are invalid, as judged by the source. ","paragraph_zero_based":619},{"literal_text_all_w_t_and_m_t":"dgnss-SatList","paragraph_zero_based":620},{"literal_text_all_w_t_and_m_t":"This list includes differential correction data for different GNSS satellites, identified by SV-ID.","paragraph_zero_based":621},{"literal_text_all_w_t_and_m_t":"iod","paragraph_zero_based":622},{"literal_text_all_w_t_and_m_t":"This field specifies the Issue of Data field which contains the identity for the GNSS-NavigationModel.","paragraph_zero_based":623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["c5c2f07e5a2d1b89760cef55690bed70a7cd9ab29335e654407fe4e83531f680","cdffe0790b7017afc30426757b765bc212ee14bd69ca5831a7a9ebbf41fd05ab","d85259e11185c16a0d672392bbb8f4d5836ff9321815dd7043d72c2092ad5b3c","2b30100335788d8edac1fcfcf44216f5c2239fc15bd82ef9d8916591cc7b7076","76f782691a79564ef5ae11f6f359e841dc2c8073bc1114c24a6b7c0a16db9586","d66e1291fca8d2ae4ce747ad0ccb9a4dd3fa861b86dacdd5ebf2d24a0a2e7dd1","3a9e5785eb2f44afc39d4c64364ffbf48ded31a061e75b95abecf14cc9280df6","307d79ffa60a3e3ca7e01a70728b0ced4f9eebccd80b8a7e69e1d04807330b9b","240d42d87333eb3192490a257dfe3b23d739459aa8eceb56891fcd052b943b8c","5bcc2e48b0cec99a5a06f4bfb819a35a760c30e4990bbdfabf87744af613a1ac","d7baad2e1b3f6ca5c4db4201a1f207308571313cbcfc386792a32cc96ddf71c3","3154c85412771380d22a7bce79e63a5d1e04d766411b0775e0ea8ec2d1a438d0","5c7a57974084eee2d20b96ec78094ab216dc1644168bf48a96f7dd17972fbad5","149e5da3f1e89b828b18b9ffd578bea86126a97f6c3dcbb0d5e5e73bfc411d6d","8181f566a0dc7e0ef6aef219cd51035b36e1d00e0ba36de07924695688e767fe","ab5a779647a85898367a07503bdf40d8e9eb6ad29706462ca11c25c935a1887b","ea6665d0bc87de76e56157c3b2933fb442be6d067c594a6da5421ed3f9a1da5b","72e857d42ce622dda5a9075717ba3176e97a362fe3a2b82e5032a664c768f943","cb0da7cf4b037ed3c0b9a4b8b70d7404b440544b6c5806c33769fb8cbb865132","6109fd86113df7adafd92911c9d2b57672198d925b82fcdcbf6749c52b0bc4dd","fa0c67381f320ec13146fb26d8e88928b7b4677a01648f25bc427fa9808d3e76","d1a33824a235f833e7269ec4cf93ee02b21f3896b8d22d8388c14d422816a29e","fb25b97844ccdb3ce881612d268a2af27c9d43d9738167db50910011b9432faa","7d7cb05ea1b62cc28caaa76ff41fc966cff6e7892898e4e373ffbca3174b631e"],"paragraph_range_zero_based":[600,623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx:p600"}
{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"udre","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"This field provides an estimate of the uncertainty (1-) in the corrections for the particular satellite. The value in this field shall be multiplied by the UDRE Scale Factor in the gnss-StatusHealth field to determine the final UDRE estimate for the particular satellite. The meanings of the values for this field are shown in the table udre Value to Indication relation below. ","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"pseudoRangeCor","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"This field specifies the correction to the pseudorange for the particular satellite at dgnss-RefTime, t0. The value of this field is given in metres and the scale factor is 0.32 metres in the range of ±655.04 metres. The method of calculating this field is described in [11].","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"If the location server has received a request for GNSS assistance data from a target device which included a request for the GNSS Navigation Model and DGNSS, the location server determines, for each satellite, if the navigation model stored by the target device is still suitable for use with DGNSS corrections and if so and if DGNSS corrections are supported the location server should send DGNSS corrections without including the GNSS Navigation Model.","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"The iod value sent for a satellite shall always be the IOD value that corresponds to the navigation model for which the pseudo-range corrections are applicable.","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"The target device shall only use the pseudoRangeCor value when the IOD value received matches its available navigation model.","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"Pseudo-range corrections are provided with respect to GNSS specific geodetic datum (e.g., PZ-90.02 if GNSSID indicates GLONASS).","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"Scale factor 0.32 metres.","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"rangeRateCor","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"This field specifies the rate-of-change of the pseudorange correction for the particular satellite, using the satellite ephemeris and clock corrections identified by the iod field. The value of this field is given in metres per second and the resolution is 0.032 metres/second in the range of ±4.064 metres/second. For some time t1 > t0, the corrections for iod are estimated by","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"PRC(t1, IOD) = PRC(t0, IOD) + RRC(t0,IOD)(t1 - t0),","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"and the target device uses this to correct the pseudorange it measures at t1, PRm(t1,IOD), by","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"PR(t1, IOD) = PRm(t1, IOD) + PRC(t1, IOD) .","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"The location server always sends the RRC value that corresponds to the PRC value that it sends. The target device shall only use the RRC value when the iod value received matches its available navigation model.","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"Scale factor 0.032 metres/second.","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"udreGrowthRate","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"This field provides an estimate of the growth rate of uncertainty (1-) in the corrections for the particular satellite identified by SV-ID. The estimated UDRE at time value specified in the udreValidityTime t1 is calculated as follows:","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"UDRE(t0+t1) = UDRE(t0)  udreGrowthRate ,","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"where t0 is the DGNSS Reference Time dgnss-RefTime for which the corrections are valid, t1 is the udreValidityTime","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"field, UDRE(t0) is the value of the udre field, and udreGrowthRate field is the factor as shown in the table Value of udreGrowthRate to Indication relation below.","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"udreValidityTime","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"This field specifies the time when the udreGrowthRate field applies and is included if udreGrowthRate is included. The meaning of the values for this field is as shown in the table Value of udreValidityTime to Indication relation below.","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"gnss-StatusHealth Value to Indication relation","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["e36f7752793b0261d17ebab675ecce2b4d27fd682bb4f3d554f3e2757c9fef5e","94a56851a36f40c38f0514fc484ae0f4cdfdcc52d83f041a746a63ef5cd56834","9b77cd23e3065c2ffcd559ab8119eff236dec47871f507d27feb6d10efafa2c0","48aaee2154d91990cf8bde80aa166a485de7cd7610343f3950bc30f0a7f9bf46","d6251fd331396b099a07711849f54e9cf2a4079ddcd99ae11220ac34521e8ab1","07e32971670d913ef2289a4a72bae40ad5513c09981097753cb08119954ff0fb","7fcc1b3466dbc3179c943bf88499caa00e771be5373690a2a925bb12d01cc31f","ec4534d8b028e5ff9e1d0aa0c8af8500c9ed00143b8b8f805cd9e25fa481f9f5","2315aacc7572624fbd07f9655a5888bfb65d110a7741e276a3447d39ed950e15","1e96aa58141ef671ba09634c6108e3a64f401779e347a07c95ada5a4e382a093","cef5f1640d5a5891000ad08d3f69d388b4c2b7450a0fe6e3