{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide MUSIM assistance information for leaving RRC_CONNECTED and stop timer T346g, if running.","paragraph_zero_based":2472},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the rlm-RelaxationReportingConfig:","paragraph_zero_based":2473},{"literal_text_all_w_t_and_m_t":"2>if rlm-RelaxationReportingConfig is set to setup:","paragraph_zero_based":2474},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the relaxation state of RLM measurements in accordance with 5.7.4;","paragraph_zero_based":2475},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2476},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the relaxation state of RLM measurements and stop timer T346j associated with the cell group, if running;","paragraph_zero_based":2477},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the bfd-RelaxationReportingConfig:","paragraph_zero_based":2478},{"literal_text_all_w_t_and_m_t":"2>if bfd-RelaxationReportingConfig is set to setup:","paragraph_zero_based":2479},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the relaxation state of BFD measurements in accordance with 5.7.4;","paragraph_zero_based":2480},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2481},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the relaxation state of BFD measurements and stop timer T346k associated with the cell group, if running;","paragraph_zero_based":2482},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the scg-DeactivationPreferenceConfig:","paragraph_zero_based":2483},{"literal_text_all_w_t_and_m_t":"2>if the scg-DeactivationPreferenceConfig is set to setup:","paragraph_zero_based":2484},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its SCG deactivation preference in accordance with 5.7.4;","paragraph_zero_based":2485},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2486},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its SCG deactivation preference and stop timer T346i, if running.","paragraph_zero_based":2487},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the propDelayDiffReportConfig:","paragraph_zero_based":2488},{"literal_text_all_w_t_and_m_t":"2>if the propDelayDiffReportConfig is set to setup:","paragraph_zero_based":2489},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide service link propagation delay difference between serving cell and neighbour cell(s) in accordance with 5.7.4;","paragraph_zero_based":2490},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2491},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":2492},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the rrm-MeasRelaxationReportingConfig:","paragraph_zero_based":2493},{"literal_text_all_w_t_and_m_t":"2>if the rrm-MeasRelaxationReportingConfig is set to setup:","paragraph_zero_based":2494},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to report the fulfilment of the criterion for relaxing RRM measurements in accordance with 5.7.4;","paragraph_zero_based":2495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c8e6b2303b7abee8970a0d63f39fc9ce82180b2c0703e441a592cf4e4632b516","7dd835c8a7938322dcf20c9d24a1358c7fb0d152d46d3c3182b5c7053dcb4e3b","b3ad3b51d416b401bccfdbf3d7e3daadca3e2ba705ab14e6f56248824ad24648","fca6d6cc3107bae67cb53e81452c3de8664e0fc1766ce7e6c692e7ce401f934a","5e963d68834b22f980c6a4a8fea586688b4e53a62a004a7a67d9ed53b7d7d251","45cf74fcec83b51bf9ddf337059ff7bf8be836d8ae2ca2749d6e797039036baf","1f74291eed63f7e10a2d46d5b7bf74b92a1bdbd29119fdf0c8500fb32bd4a11b","1b91cf9ba7e0de8328f15bd067a61f7eecac32768f6556f97e0e5079d3451ac0","e6b919184af3bafc7b91f51dc1626f59f709c09a393df7bc626dc8cf11dc6eb7","dffd3d4f559d3e33e24a7d6ccb38d725dab3f5f7547897782f6f6fd86a23918a","b16335e5c3701022d19291e405839e1379d1aec2ae926cb7606567e57daf2aa7","c5d019f56212c7502a78e7e9ae1e74579d1d152e6c81c8bc4ffa9407924ca0ad","53570eef56faf862f456a2155ba0eda7dd909cc48588e88ebcee99cc54882204","c8ec3443193f8861383ed5049776d2455c3fb7d28cd4001a5d1a5d6d900b168b","02546bbe5971d8a41cd8ec0941a21a3c86f58114af989c98ef27a9c7836ab6f7","1b84d75e258132db2cac9a28b0496b2413a1ad1eeb949c71dc705048293be246","7245d1dd0553ed0d6dfba4a415baf78a4425706208f243915d2c053c1a1a56b8","5d6622a38f5f03ef219a007fd4da9bfea9d8fd64ae84d1495caac35f6a046598","ab58ea8f285fc8dcb973bab1079a4e4886e63807508ea0562d51992d9a506788","50a4a62636cdf70a84527616e834f5dc97b74c1b43e1a9864854c77f10be251e","1eb3a22c14cd79a17e1dfee0d01af8a4e772c9db47704a4acca131d7d296e752","22761de6e7099f48273a6459a084f74923b81040fd0fb15236d5ee842ca2c68b","2819ada98960e42e98f449c3a2bc60c971a25c470101f6a591e2ebb0a588b041","3e8f8657d1b277b9767c3834da1bb4f092946b6999a9a2711ec4be208562b952"],"paragraph_range_zero_based":[2472,2495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2472"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2496},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to report the fulfilment of the criterion for relaxing RRM measurements.","paragraph_zero_based":2497},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the uav-FlightPathAvailabilityConfig:","paragraph_zero_based":2498},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to indicate the availability of flight path information in accordance with 5.7.4;","paragraph_zero_based":2499},{"literal_text_all_w_t_and_m_t":"5.3.5.9aMUSIM gap configuration","paragraph_zero_based":2500},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2501},{"literal_text_all_w_t_and_m_t":"1>if musim-GapConfig is set to setup:","paragraph_zero_based":2502},{"literal_text_all_w_t_and_m_t":"2>for each musim-GapId included in the received musim-GapToReleaseList:","paragraph_zero_based":2503},{"literal_text_all_w_t_and_m_t":"3>release the periodic MUSIM gap configuration associated with the musim-GapId;","paragraph_zero_based":2504},{"literal_text_all_w_t_and_m_t":"2>for each MUSIM-Gap included in the received musim-GapToAddModList:","paragraph_zero_based":2505},{"literal_text_all_w_t_and_m_t":"3>setup periodic MUSIM gap configuration indicated by the MUSIM-Gap in accordance with the received musim-GapRepetitionAndOffset (providing musim-GapRepetition and Offset value for the following condition) i.e. the first subframe of each periodic MUSIM gap occurs at an SFN and subframe of the NR PCell meeting the following condition:","paragraph_zero_based":2506},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(Offset/10);","paragraph_zero_based":2507},{"literal_text_all_w_t_and_m_t":"subframe = Offset mod 10;","paragraph_zero_based":2508},{"literal_text_all_w_t_and_m_t":"with T = musim-GapRepetition/10;","paragraph_zero_based":2509},{"literal_text_all_w_t_and_m_t":"2>if musim-AperiodicGap is included:","paragraph_zero_based":2510},{"literal_text_all_w_t_and_m_t":"3>setup aperiodic MUSIM gap configuration indicated by the musim-AperiodicGap in accordance with the received musim-Starting-SFN-AndSubframe, i.e. the first subframe of aperiodic MUSIM gap occurs at an SFN and subframe of the NR PCell meeting the following condition:","paragraph_zero_based":2511},{"literal_text_all_w_t_and_m_t":"SFN = starting-SFN;","paragraph_zero_based":2512},{"literal_text_all_w_t_and_m_t":"subframe = startingSubframe;","paragraph_zero_based":2513},{"literal_text_all_w_t_and_m_t":"1>else if musim-GapConfig is set to release:","paragraph_zero_based":2514},{"literal_text_all_w_t_and_m_t":"2>release the MUSIM gap configuration.","paragraph_zero_based":2515},{"literal_text_all_w_t_and_m_t":"5.3.5.10MR-DC release","paragraph_zero_based":2516},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2517},{"literal_text_all_w_t_and_m_t":"1>as a result of MR-DC release triggered by E-UTRA or NR:","paragraph_zero_based":2518},{"literal_text_all_w_t_and_m_t":"2>release SRB3, if established, as specified in 5.3.5.6.2;","paragraph_zero_based":2519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b9adf35cbcc1f331aafe87580c3201eb04a510ce80589ce1715def626bdd3d92","f23d93052b621956ac742767cccc98f20c5c28894b9c9d795b9cded222b9a327","1b8625c1a4f7e9a5cf7547a1e01cbe62e611f6f69d1badc7dd3919eed322d94e","923c4bf31730207ab8caef883f9db7936c7c9db2b14090e77f8d5eedb05eadbe","9ab65f871821df5c2062364bacef7b687451a435aa87568209d1f523242899a6","0e81b6773eb66f986bbc7b7175ebd08cad731f78b0e4e2534571784e84a32c9a","0060298e8363ca79c3fe9b7ca0ae9e422d55da857cb514d59f20f0a4630f092f","9490a22b04bf3834c278e7a1804e1a42da5faaa3ba8abee2edfc1800b43069da","f1f4dfe23ca87142c861888fd54afba4da5252ad58897905e22309fb84bcc5f2","6cb560da98157961a1374204bc7f6477875f5511b36ca76c82d59f2d18dd16e1","d36b8ff09ba4cfc48ce9499e2bd203095fa5b2051a2438d4bc838893431a7c5b","8df7f205db5f096fe4e8555c69de0572dd2098d2006853993fe18a1f95e703e0","7c758f24e236ca6eaf30c5912954cb320bfac0fd88c1979b8c8bfd1883486fea","bb46a867c1bf44dd7347e8aa803f3ee61af302eca474cfdc5946cdeaf45c41c7","f7bef154e9f41ea567c5e54537ed54b891276c61d4b3633eb4a6ada93a194b98","797ac69885cd4e1b733e19f7b666e3630c8790360af4bea0b8e423342c79fded","3e778ffda4bd86b62373778af19091adcea661852e679f0e437d77261b299e51","f6bf8db2ad574d556af439b80f17505fe1d20b966203906336c11bf776a9a56d","c56e1005c68f34b87b0d49755174b09efd0760df9a45440d10c52610549217a5","7d44468981e930536f605ac8a851d57731deb71a6369800a8b94fcf0dfe32eb5","ea7ac25048a4abe4dd4a27baadc0f111c1b2e07f63ac37cf60314c536ebf8eba","6cdfdc8465b318d83c762f901c35bcb7f66ddabc2dd9265e253fb117d2728bbb","6cc1d130051707540bdee4fd241dc56ce91f8ff9772e1c6dd4ce37de85fe7d70","04b1401a81ffda176c4785a19ea629e5fe8741c7e700b5ae6a7ca88c44779ca9"],"paragraph_range_zero_based":[2496,2519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2496"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>release measConfig associated with SCG;","paragraph_zero_based":2520},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with NR SCG:","paragraph_zero_based":2521},{"literal_text_all_w_t_and_m_t":"3>release the SCG configuration as specified in clause 5.3.5.4;","paragraph_zero_based":2522},{"literal_text_all_w_t_and_m_t":"3>release otherConfig associated with the SCG, if configured;","paragraph_zero_based":2523},{"literal_text_all_w_t_and_m_t":"3>stop timers T346a, T346b, T346c, T346d, T346e, T346j and T346k associated with the SCG, if running;","paragraph_zero_based":2524},{"literal_text_all_w_t_and_m_t":"3>release bap-Config associated with the SCG, if configured;","paragraph_zero_based":2525},{"literal_text_all_w_t_and_m_t":"3>release the BAP entity as specified in TS 38.340 [47], if there is no configured bap-Config;","paragraph_zero_based":2526},{"literal_text_all_w_t_and_m_t":"3>release iab-IP-AddressConfigurationList associated with the SCG, if configured;","paragraph_zero_based":2527},{"literal_text_all_w_t_and_m_t":"2>else if the UE is configured with E-UTRA SCG:","paragraph_zero_based":2528},{"literal_text_all_w_t_and_m_t":"3>release the SCG configuration as specified in TS 36.331 [10], clause 5.3.10.19 to release the E-UTRA SCG;","paragraph_zero_based":2529},{"literal_text_all_w_t_and_m_t":"5.3.5.11Full configuration","paragraph_zero_based":2530},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2531},{"literal_text_all_w_t_and_m_t":"1>release/ clear all current dedicated radio configurations except for the following:","paragraph_zero_based":2532},{"literal_text_all_w_t_and_m_t":"-the MCG C-RNTI;","paragraph_zero_based":2533},{"literal_text_all_w_t_and_m_t":"-the AS security configurations associated with the master key;","paragraph_zero_based":2534},{"literal_text_all_w_t_and_m_t":"-the SRB1/SRB2 configurations and DRB/multicast MRB configurations as configured by radioBearerConfig or radioBearerConfig2.","paragraph_zero_based":2535},{"literal_text_all_w_t_and_m_t":"NOTE 1:Radio configuration is not just the resource configuration but includes other configurations like MeasConfig. Radio configuration also includes the RLC bearer configurations as configured by RLC-BearerConfig, PC5 Relay RLC channel as configured by SL-RLC-ChannelConfig, and Uu Relay RLC channel as configured by Uu-RelayRLC-ChannelConfig. In case NR-DC or NE-DC is configured, this also includes the entire NR or E-UTRA SCG configuration which are released according to the MR-DC release procedure as specified in 5.3.5.10.","paragraph_zero_based":2536},{"literal_text_all_w_t_and_m_t":"NOTE 1a:For NR sidelink communication/discovery, the radio configuration includes the sidelink RRC configuration received from the network, but does not include the sidelink RRC reconfiguration and sidelink UE capability received from other UEs via PC5-RRC. In addition, the UE considers the new NR sidelink configurations as full configuration, in case of state transition and change of system information used for NR sidelink communication/discovery.","paragraph_zero_based":2537},{"literal_text_all_w_t_and_m_t":"NOTE 1b:To establish the RLC bearer of SRB(s) after release due to fullConfig, the network can include the srb-Identity within srb-ToAddModList (i.e. the UE applies RLC default configuration) and/or provide rlc-BearerToAddModList of concerned SRB(s) explicitly.","paragraph_zero_based":2538},{"literal_text_all_w_t_and_m_t":"-the logged measurement configuration;","paragraph_zero_based":2539},{"literal_text_all_w_t_and_m_t":"1>if the spCellConfig in the masterCellGroup includes the reconfigurationWithSync:","paragraph_zero_based":2540},{"literal_text_all_w_t_and_m_t":"2>release/ clear all current common radio configurations;","paragraph_zero_based":2541},{"literal_text_all_w_t_and_m_t":"2>if sl-PathSwitchConfig was included in reconfigurationWithSync:","paragraph_zero_based":2542},{"literal_text_all_w_t_and_m_t":"3>use the default values specified in 9.2.3 for timer T311;","paragraph_zero_based":2543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f57ea3e36601172abca8061d1b3438ec8a6d4b56d0d065fd2ef21dee1bbd4965","813adeb19b0642f7a6665d01496a4e01be1d49b797f0eb6638417f0186b71b27","30b64a092c2379a7b2a3ac120bb5b29b56cb0a348702bc3d22bf924f7ff04b12","ae1a5d0ae95010609d4da5a9eaddb6d90a17a183a775c310a8995954f98b0ce0","e986b8a965129e63cd56b4ac2af529a27dd69ac6c563ee18311711242a85e6a0","adb510f651a30061dc0e128b84e0d8bddd72fc22a0a00014bfe9bf092a741fb7","6cd1e9155ee32efacd4541a1f958063307ccea7cddcf4d9c7c2aa10f328469f5","cfc0f3baa5ec73dc218d379125127998218a48b89233eb11f53e62da7f40e7a9","59b3b8866efa31eed92edeaf2637a0e925e2b785d71e317e5dd13f3f54aa6d15","402f42813d051146031bdec83af2f8c538db8df606ed904223111ca18152cea6","46b1d8df321499cf36f62d89362e02357f095a1da21263126ad40c4bd0b1b68c","8f8944d9e9fb173940a46771337254c0c557cec25d5662ed56344027040b94fb","855e7d82048961b03ec388fa2e078e0575725bab9a0e952a0bd8c55f190615d1","e2819843a234c3967ce61585fa8cde9aacda549f0a1d931ed33f48359dc33643","fb0646cbe3a2408e214752b9ce12564e43f655acccd9a9a0f5c5e552b667c82f","25ce222ac8770faa8dea57e7903a1f199d682026065848246457e18344a05634","fc73fbd71bf07bbd117e2d2c18d62cd38f06cb41c5121b3735c79fca9d80175d","79217b95fbc72295352995229c5e6b2a33fde8f23adf7b9fd27812d83a1b22ae","51d720acf464663d2caeadfa7f89b00f2db30ef1cf2617b2aa1c7f0f0c3e5976","a5909c874603d8f6c2494497235bb378ee51bb4fb59f99afbfe2fe42e4a15205","820e5eb219b3980b131f4e565afefecdc91952b013c8b61affad32ebb0c34599","88c79abc9914a45d5385c9080c4ea28fe647d908d7759c50dcaf6f7a48f596e7","062f21ad187b838b5e2c13bf399e9ede12919b3a1a04db3575a3c49f348a4f3a","684808d6c8b30c00011bb5982f2f6fe05a24e4deda8d1fe4bf7a0156e9fa5af3"],"paragraph_range_zero_based":[2520,2543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2520"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2544},{"literal_text_all_w_t_and_m_t":"3>use the default values specified in 9.2.3 for timers T310, T311 and constants N310, N311;","paragraph_zero_based":2545},{"literal_text_all_w_t_and_m_t":"1>else (full configuration after re-establishment or during RRC resume):","paragraph_zero_based":2546},{"literal_text_all_w_t_and_m_t":"2>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":2547},{"literal_text_all_w_t_and_m_t":"3>use value for timer T311, as included in ue-TimersAndConstants received in SIB1","paragraph_zero_based":2548},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2549},{"literal_text_all_w_t_and_m_t":"3>use values for timers T301, T310, T311 and constants N310, N311, as included in ue-TimersAndConstants received in SIB1;","paragraph_zero_based":2550},{"literal_text_all_w_t_and_m_t":"1>if no measConfigAppLayerId is included:","paragraph_zero_based":2551},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the release of all application layer measurement configurations;","paragraph_zero_based":2552},{"literal_text_all_w_t_and_m_t":"2>discard any received application layer measurement report from upper layers;","paragraph_zero_based":2553},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to send application layer measurement report.","paragraph_zero_based":2554},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE at the target side during reconfiguration with sync, or after re-establishment, or during RRC resume:","paragraph_zero_based":2555},{"literal_text_all_w_t_and_m_t":"2>apply the default configuration of SL-RLC1 as specified in clause 9.2.4 and associate it with the SRB1;","paragraph_zero_based":2556},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2557},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the following:","paragraph_zero_based":2558},{"literal_text_all_w_t_and_m_t":"-parameters for which values are provided in SIB1;","paragraph_zero_based":2559},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":2560},{"literal_text_all_w_t_and_m_t":"2>for each srb-Identity value included in the srb-ToAddModList (SRB reconfiguration):","paragraph_zero_based":2561},{"literal_text_all_w_t_and_m_t":"3>establish an RLC entity for the corresponding SRB;","paragraph_zero_based":2562},{"literal_text_all_w_t_and_m_t":"3>apply the default SRB configuration defined in 9.2.1 for the corresponding SRB;","paragraph_zero_based":2563},{"literal_text_all_w_t_and_m_t":"NOTE 2:This is to get the SRBs (SRB1 and SRB2 for reconfiguration with sync and SRB2 for resume and reconfiguration after re-establishment) to a known state from which the reconfiguration message can do further configuration.","paragraph_zero_based":2564},{"literal_text_all_w_t_and_m_t":"1>for each pdu-Session that is part of the current UE configuration:","paragraph_zero_based":2565},{"literal_text_all_w_t_and_m_t":"2>release the SDAP entity (clause 5.1.2 in TS 37.324 [24]);","paragraph_zero_based":2566},{"literal_text_all_w_t_and_m_t":"2>release each DRB associated to the pdu-Session as specified in 5.3.5.6.4;","paragraph_zero_based":2567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e34005b2f949ffa49784f307ada9795dd2195f2195e58d21baedd1c41110dcab","5c50980a4eaa3ccb99188b22c25fe8134108e424df598a78786d8dff7f7306ee","c46856fc87cbe5380a37fdef078d531bc39306b69881ff24cdfb4ab2d7503ad8","148f779a567560997d9046b259c143734e81df66611542b6e32bc8409df001d5","94939fdfe503f6349d959bbe314eb3aa3d6145911ac55635aea00b7708fb1037","aa5f939170e7c1146870403bafd609f3d1de66fe61cbc30a01e83293b2e92c3e","7505b35ff512295a1da819a96cb2aebabd40c55113d8475cf7713e8a17652170","e78ab810719ab920bbd73504deb0845d532ecb328d23eda524bf45afc97daf7b","e5440532a03024f09a718756cf1f647c6312d9476481a6b2a4e2b7c646625591","53a00d1e1fdc1db05c933f89710895511dc93922b5df06ba91f0305fe0ebabd5","2e536dddc5a1f17b5cbf943bbe2b65217c5e6f69c722254c849455aeb25caa83","9726e331534e498b216d9a1eeba3a3c448eeea4d968d8c3529265a8774c1aef3","b39066a3e627fb126ac2274942465f6a3e21cfa6715a44484762a66ea21744e9","f5c004c0d6c668629041047948f935719b340a0818d7a2b07ca48e961b78beda","46be85c52a58dab3a00c0f857778d3c523d3cbc9593f42175f35a437036f2070","c18e8c8f4c003cd589223b17af567e1b07a21333f32f0e7bf4b072c86905a4bc","62ca628e7bcfa4fb78bab9be500301d2ea4f769bc7ad9f71d6f345474269025f","e96d9fd1c19b6acc83b2588b66121439be316e40063dccae112c3f386f796518","86cdf7416c7c433fda66d7c42a140133c9361b168d3231c7df636d16760da72d","58ec7d21d0a36be0b2d06ad927092fd7087fb52ae19207715b7d4ef2050c53e5","788bbfa9649162dffe6f47333b87ebd4493523d707f83a2472f826374685a5fd","761b554ca97f8b6150308678705c313f9fb27874cc21ff85d05d3339b3f4a340","6c22412ddce942da7de8cf18d7650675c4dbb80ed3136b59d2bee8d51616d005","9e48a83db21177b0f9ed8cc0795a04f9c4b3470cbd37a217a6869edd32e9d65b"],"paragraph_range_zero_based":[2544,2567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2544"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:This will retain the pdu-Session but remove the DRBs including drb-identity of these bearers from the current UE configuration. Setup of the DRBs within the AS is described in clause 5.3.5.6.5 using the new configuration. The pdu-Session acts as the anchor for associating the released and re-setup DRB. In the AS the DRB re-setup is equivalent with a new DRB setup (including new PDCP and logical channel configurations).","paragraph_zero_based":2568},{"literal_text_all_w_t_and_m_t":"1>for each mbs-SessionId that is part of the current UE configuration and associated to a multicast MRB:","paragraph_zero_based":2569},{"literal_text_all_w_t_and_m_t":"2>release the SDAP entity (clause 5.1.2 in TS 37.324 [24]);","paragraph_zero_based":2570},{"literal_text_all_w_t_and_m_t":"2>release each multicast MRB associated to the mbs-SessionId as specified in 5.3.5.6.6;","paragraph_zero_based":2571},{"literal_text_all_w_t_and_m_t":"NOTE 4:This will retain the mbs-SessionId but remove the multicast MRBs including mrb-identity of these bearers from the current UE configuration. Setup of the multicast MRBs within the AS is described in clause 5.3.5.6.7 using the new configuration. The mbs-SessionId acts as the anchor for associating the released and re-setup multicast MRB. In the AS the multicast MRB re-setup is equivalent with a new multicast MRB setup (including new PDCP and logical channel configurations).","paragraph_zero_based":2572},{"literal_text_all_w_t_and_m_t":"1>for each pdu-Session that is part of the current UE configuration but not added with same pdu-Session in the drb-ToAddModList:","paragraph_zero_based":2573},{"literal_text_all_w_t_and_m_t":"2>if the procedure was triggered due to reconfiguration with sync:","paragraph_zero_based":2574},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the pdu-Session to upper layers after successful reconfiguration with sync;","paragraph_zero_based":2575},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2576},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the pdu-Session to upper layers immediately;","paragraph_zero_based":2577},{"literal_text_all_w_t_and_m_t":"1>for each mbs-SessionId that is part of the current UE configuration but not added with the same mbs-SessionId in the mrb-ToAddModList:","paragraph_zero_based":2578},{"literal_text_all_w_t_and_m_t":"2>if the procedure was triggered due to reconfiguration with sync:","paragraph_zero_based":2579},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the mbs-SessionId to upper layers after successful reconfiguration with sync;","paragraph_zero_based":2580},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2581},{"literal_text_all_w_t_and_m_t":"3>indicate the release of the user plane resources for the mbs-SessionId to upper layers immediately.","paragraph_zero_based":2582},{"literal_text_all_w_t_and_m_t":"5.3.5.12BAP configuration","paragraph_zero_based":2583},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2584},{"literal_text_all_w_t_and_m_t":"1>if the bap-Config is set to setup:","paragraph_zero_based":2585},{"literal_text_all_w_t_and_m_t":"2>if no BAP entity is established:","paragraph_zero_based":2586},{"literal_text_all_w_t_and_m_t":"3>establish a BAP entity as specified in TS 38.340 [47];","paragraph_zero_based":2587},{"literal_text_all_w_t_and_m_t":"2>if bap-Address is included:","paragraph_zero_based":2588},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to use the bap-Address as this node's BAP address;","paragraph_zero_based":2589},{"literal_text_all_w_t_and_m_t":"2>if defaultUL-BAP-RoutingID is included:","paragraph_zero_based":2590},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the default UL BAP routing ID according to the configuration;","paragraph_zero_based":2591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ecac566856ce8e40738c9fb2697cf3bc3f1e4aa96dedf6e1a849d317b7b64791","f0bfcc41ee7b82ea114c485edecb5ee7777c9d0b15fbc9eb5615e325dcd4697c","767c55474146a74b86ba1bb516455396227a3cde9526eeb161cbd95883437b50","bf62af47118c9e7c99af7ccfc7fe40ead4fe3ef632333a9f971ed084af9ecba4","ed6bf37c6b7f12a55de62c9f3438e1df50c52dfdc3667d9b88553e79899b40f4","9e2805e918345d7c45073192331c62cc9741e04c0e7ee61d8db74c1c3226688e","4d0889d98e2ede77591b1f15e99b0bbfdf6bbe514e203095ae9b3c68d38c04b4","7dd1bc1ebfd205f8d497385638ce6ce4b810ca4b04300c91fd12d1b089712e1a","53127a82fc9fed8eafb41b9e64d741ea8dd419c46c4f402cf6d06346223fd467","d55f35b83a54a0d8f3693bfb300955b76232ebdcd9e2b50153f949cfa3dfe12d","4f58bf7ccd0d569a5284c075ad149c8261efa67f2b8d8a883e626436ea771d8a","4b8c41abd244d18cc1a7ed75296f7cc63bc3d12827e41128f4343724da127801","c33e630453dab0c893ede61c2484987ad865b17ca3db5cd9b48b6acea4ff3608","a12e41a72c1b673e4c85965c13b0895d9d23d0096eb80729c33f034dbf6bfd0d","00b426c1688ac7082190c47f83c5a8af333807f08cd9d8a2b48028ef04a6ad68","8a188c79b9a1283f3ec5fda0bbfb6c49e68a8d01fde6e2d59b2628361ec0fb47","06e1143b665a2269aef3115d79226f7f6fadc4eab69c2ca9a5a27bca8b59ab32","159e8103088441e5af2d80dadee1c2128b93a29939b3ac2625a3fa33ffbede11","6f98e7de811be21f770f2e98318ee7634fee089e44d45fde2ccc9e4b4329596f","b67aaef1a96d73a796652a9cac618f9d5f559be2c32016c0eabd360a978257a0","da580a9af0debd8cda8b12e865ccdbe92581ea21bbe53c66cc4076aa202d7b5c","fcfdb56c13d660bf8831637778ecbd3afcbe687e54afd581e774185b9056c04e","e0dd1a4b0aabf3ef2feeb7b77a3bab65f1bd48dba7051ab92eb778679cbcac0b","4acd32ee5e23f3f0af62bbfb800dbe634eb2b21eaac1f4ffe793d21189a38a0a"],"paragraph_range_zero_based":[2568,2591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2568"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if defaultUL-BH-RLC-Channel is included","paragraph_zero_based":2592},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the default UL BH RLC channel according to the configuration;","paragraph_zero_based":2593},{"literal_text_all_w_t_and_m_t":"2>if flowControlFeedbackType is included:","paragraph_zero_based":2594},{"literal_text_all_w_t_and_m_t":"3>configure the BAP entity to apply the flow control feedback according to the configuration;","paragraph_zero_based":2595},{"literal_text_all_w_t_and_m_t":"1>if the bap-Config is set to release:","paragraph_zero_based":2596},{"literal_text_all_w_t_and_m_t":"2>release the concerned bap-Config;","paragraph_zero_based":2597},{"literal_text_all_w_t_and_m_t":"2>if there is no other configured bap-Config for the MCG or for the SCG","paragraph_zero_based":2598},{"literal_text_all_w_t_and_m_t":"3>release the BAP entity as specified in TS 38.340 [47].","paragraph_zero_based":2599},{"literal_text_all_w_t_and_m_t":"5.3.5.12aIAB Other Configuration","paragraph_zero_based":2600},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1IP address management","paragraph_zero_based":2601},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1.1IP Address Release","paragraph_zero_based":2602},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2603},{"literal_text_all_w_t_and_m_t":"1>if the release is triggered by reception of the iab-IP-AddressToReleaseList:","paragraph_zero_based":2604},{"literal_text_all_w_t_and_m_t":"2>for each iab-IP-AddressIndex value included in iab-IP-AddressToReleaseList:","paragraph_zero_based":2605},{"literal_text_all_w_t_and_m_t":"3>release the corresponding IAB-IP-AddressConfiguration.","paragraph_zero_based":2606},{"literal_text_all_w_t_and_m_t":"5.3.5.12a.1.2IP Address Addition/Modification","paragraph_zero_based":2607},{"literal_text_all_w_t_and_m_t":"The IAB-MT shall:","paragraph_zero_based":2608},{"literal_text_all_w_t_and_m_t":"1>for each iab-IP-AddressIndex value included in the iab-IP-AddressToAddModList that is not part of the current IAB-MT configuration:","paragraph_zero_based":2609},{"literal_text_all_w_t_and_m_t":"2>add the IP address indicated in iab-IP-Address, corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2610},{"literal_text_all_w_t_and_m_t":"2>if added IP address is iPv4-Address:","paragraph_zero_based":2611},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2612},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2613},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2614},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a4a65ab54327e4f567cee142e4c7eb2cc62e67cf15543ac783e58366eeba049a","94c0ea034564846e6efab532c82fed644336824f5d06b394cd3177b1eeba780c","91bbed01320a2d911492cc47cbeaee080aff482a931083ce97207e16563495d5","5fe91ecd0de17ffe33ae929041f4be859ce1d792af01c40127c2b7fe1f53b4ca","b4ddae745fb0f5591c360927d58b7a7ff6e9e36890995653ccbd42d7c6d56aa8","1025c6fde38866bd4d03a5e02747c0f80df993140004c237e46620b1cbad40a4","58143c7b61c2797ee8dedaf648e0019e70dcede9a38214c329d14d4cc92925cc","5f58acc4cd097cec824b88c02f3209c46baf421d5c0b50f51e10ae9e89e823b5","9a8c6b0fc031cf6623968df6ba73b1cfa7019e48d76ab554741fefed43ebb9a8","978173cb215a4f5b1935257d1f83a000bd732be68726c2758425a10ebbd97d62","c893736173fddd49b446d889a5dd5bed198bf9e27b2182c3863c6c396027ae4d","d1c7890b96c6ada898fb6136d39e516c4721472b98d2c4fdf609f72e5f5b5709","a54d766b2bbe6f8e7bbfb36be088749505a2bef57be2d219b84cd966aa1ecb76","c71f88d861c2e3037b07801cdea17f41e4201c3380f314abf15f3ec59f57d02e","6345a08ce8a66786ef462d37b3eb09fa987d7e71cb815f699b155eda7c4d76c4","42decc00fe370e0cc8658b7a05a07c8c6c4fbca8df023729157717f58c06126e","2b85a3fe459129d2220732c417563733ffc357c67ece8784337b89fb590d50fb","8e0aa756af5c8f329428fb1e9a05230db8b671bf4f93230cfa595c8b94ad95ad","dc502e13526968e41568f87be97afc5f276748353d77ee6ea99d6c1afd16477c","110260ee745f3e8ea67e7fd9b9630ca980d4d84a9d4a19b59c19b9a0ffb2fadc","61659d09037db468b331735fa089393226e45e5ff6aee87c06d5ced0d270e9d2","ebcc7c228f89a301c07e0b2b1b683bce94df6fbb20a3337bcd8ca0f9cdf89377","10ab50fef8304011708985012586921179c0073ee5788f8b3533c4e5bde85f13","6ab2eee9523dda1b896efb7e34f1e9e1de9581707273e8da4c70545972f0c8d5"],"paragraph_range_zero_based":[2592,2615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2592"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2616},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2617},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2618},{"literal_text_all_w_t_and_m_t":"4>store the received IPv4 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2619},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Address is included:","paragraph_zero_based":2620},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2621},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2622},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2623},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2624},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2625},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2626},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2627},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2628},{"literal_text_all_w_t_and_m_t":"2>else if iPv6-Prefix is included in iab-IP-AddressToAddModList:","paragraph_zero_based":2629},{"literal_text_all_w_t_and_m_t":"3>if iab-IP-Usage is set to f1-C:","paragraph_zero_based":2630},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-C traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2631},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to f1-U:","paragraph_zero_based":2632},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for F1-U traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2633},{"literal_text_all_w_t_and_m_t":"3>else if iab-IP-Usage is set to non-F1:","paragraph_zero_based":2634},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for non-F1 traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2635},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2636},{"literal_text_all_w_t_and_m_t":"4>store the received IPv6 address prefix for all traffic together with the IAB-donor-DU BAP address corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2637},{"literal_text_all_w_t_and_m_t":"1>for each iab-IP-AddressIndex value included in the iab-IP-AddressToAddModList that is part of the current IAB-MT configuration:","paragraph_zero_based":2638},{"literal_text_all_w_t_and_m_t":"2>modify the IP address configuration(s) in accordance with the IAB-IP-AddressConfiguration corresponding to the iab-IP-AddressIndex.","paragraph_zero_based":2639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["be7e1774325cfcc2e12bbeaa9b9b72d9a90fa3bb762a3eb807357ca5bc5cda06","ccf4fdb76ddce9752872362defb4bcedcd815c814fd64fb6e9fa58754b9561f1","aff81f9032c8b9a95afb24da0c70a43edb56fefc5055671f9e7ee7a5e8b8b51b","185eb8a863b184d4bcce3758d694f9de8398930edc38f34c975c8aceff90ec4d","57741cae3b1fa97faa112bf4ba4e7194fa54293b496419ae46912bd7cb3810a4","b40cc6350087b012d3545c1a090989b6e601372d311c8054f47fa126d0b13500","d06144df0d5c9b554762a0e7fc9dd63c846c6496a1ddf19e61a69c7a180e26b4","d7fc07e3ce1931ad29ebb1bf9265fa4ac60c2603e225235a02a9a5302cd1ca75","609f75365791869f1394ca7675f4215758926c7e569fe13f6ad4e0e2e5c61d26","837dfc323ce025b54f1d01775315b88aaa59d5fc7eac2bdea2e916267b28b466","f6b277734095c9c2325c6e8c9f0516537d9079ee2a4cb0f9b9841cd63c0a0012","50442290d959e488e196b331f1fef5a9b0d657a6bf700f725dc2783edff62097","9bc66d57592891882cb9c7790ca52f19fe923e36a44128179e948284d1a88bab","a62c204c31c29a768f8b280cda9e60e7c1de92b67181cfac607e9a46cc74c75f","aff5cfbe575ebad9ee9365c78c7328b2a62db51a2d2b2bf770643218e8c08199","adb2c963fd98617a2e0e7214e9749f214b9777a52108c7ca04919d556156cf64","4e1b21e1cdb88d584bd00f5c5092b1840e9bde189cbcd54ef0665d2eac720dd0","bb92acc715ff716d44c3696aaedadbb45fc93746eb7d68b672ec79f3f6d63145","d13f9ba833f183565c6dba37257466d215ba8dbcdcf090186af6abe28ffd405e","9b286a9c25b7cf073f668661657fdeab133cb761d67acb9316994c7f5f3d054d","31816ec5feb07789a0c448c15a9c057151435f68f967a990ace92e3fcbffce8e","b2c05d25af69f6cdc4bd6634347599da8b54a9f61bbaaa24022c3b4a95b94f54","4c9074a0c3b09a7f011e77618d8fe23e94ae7c19a43e46dc3629c1dfb815d6ca","f26cbc7ece653563704f0d8da101e5ec055151ee0ffb1cccb1f5d1c8d8724911"],"paragraph_range_zero_based":[2616,2639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2616"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.5.13Conditional Reconfiguration","paragraph_zero_based":2640},{"literal_text_all_w_t_and_m_t":"5.3.5.13.1General","paragraph_zero_based":2641},{"literal_text_all_w_t_and_m_t":"The network configures the UE with one or more candidate target SpCells in the conditional reconfiguration. The UE evaluates the condition of each configured candidate target SpCell. The UE applies the conditional reconfiguration associated with one of the target SpCells which fulfils associated execution condition. The network provides the configuration parameters for the target SpCell in the condRRCReconfig.","paragraph_zero_based":2642},{"literal_text_all_w_t_and_m_t":"In NR-DC, the UE may receive two independent conditionalReconfiguration:","paragraph_zero_based":2643},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration associated with MCG, that is included in the RRCReconfiguration message received via SRB1; and","paragraph_zero_based":2644},{"literal_text_all_w_t_and_m_t":"-a conditionalReconfiguration, associated with SCG, that is included in the RRCReconfiguration message received via SRB3, or, alternatively, included within a RRCReconfiguration message embedded in a RRCReconfiguration message received via SRB1.","paragraph_zero_based":2645},{"literal_text_all_w_t_and_m_t":"In this case:","paragraph_zero_based":2646},{"literal_text_all_w_t_and_m_t":"-the UE maintains two independent VarConditionalReconfig, one associated with each conditionalReconfiguration;","paragraph_zero_based":2647},{"literal_text_all_w_t_and_m_t":"-the UE independently performs all the procedures in clause 5.3.5.13 for each conditionalReconfiguration and the associated VarConditionalReconfig, unless explicitly stated otherwise;","paragraph_zero_based":2648},{"literal_text_all_w_t_and_m_t":"-the UE performs the procedures in clause 5.5 for the VarConditionalReconfig associated with the same cell group like the measConfig.","paragraph_zero_based":2649},{"literal_text_all_w_t_and_m_t":"In EN-DC, the VarConditionalReconfig is associated with the SCG.","paragraph_zero_based":2650},{"literal_text_all_w_t_and_m_t":"In NE-DC and when no SCG is configured, the VarConditionalReconfig is associated with the MCG.","paragraph_zero_based":2651},{"literal_text_all_w_t_and_m_t":"The UE performs the following actions based on a received ConditionalReconfiguration IE:","paragraph_zero_based":2652},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToRemoveList:","paragraph_zero_based":2653},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration removal procedure as specified in 5.3.5.13.2;","paragraph_zero_based":2654},{"literal_text_all_w_t_and_m_t":"1>if the ConditionalReconfiguration contains the condReconfigToAddModList:","paragraph_zero_based":2655},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration addition/modification as specified in 5.3.5.13.3;","paragraph_zero_based":2656},{"literal_text_all_w_t_and_m_t":"5.3.5.13.2Conditional reconfiguration removal","paragraph_zero_based":2657},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2658},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId value included in the condReconfigToRemoveList that is part of the current UE conditional reconfiguration in VarConditionalReconfig:","paragraph_zero_based":2659},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching condReconfigId from the VarConditionalReconfig;","paragraph_zero_based":2660},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the condReconfigToRemoveList includes any condReconfigId value that is not part of the current UE configuration.","paragraph_zero_based":2661},{"literal_text_all_w_t_and_m_t":"5.3.5.13.3Conditional reconfiguration addition/modification","paragraph_zero_based":2662},{"literal_text_all_w_t_and_m_t":"For each condReconfigId received in the condReconfigToAddModList IE the UE shall:","paragraph_zero_based":2663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fbf67764684293a0a2cd4dba3a71dae75598216615c821ab611caa489c4b350b","649ba617937a40c75f825695985b2ac6144d238fcd43a06943969df4034214bf","25dae23718f2590b033c3768f3f73333575b4264269c7cbc97a8de18c1f098b9","273f0f5db325bf8f6db9156ff57992a8dde1993b2af0bae0e76cef12ddcb8f74","98a429a623d1f8fac978a8182f795f3265853855a51d2920b4be22edfc39555f","697cd1f3457f2b90bf1fd6c023dcbfb14b712c871673983e77d5fb99384dbd2e","d8fafbfeadbbeaefa8fa3f53ce8d25eb5be34c37939a4c3fcc210f24ddae30ff","6abd99f7cd5ae27db16d58413d19d2d7eaab6e152446da3dbb1d5982aaec87aa","fa051786b5b7e35839c685ccd357db786755861c045102bd891e4040e5a7b2a5","55111cbb619753059839923312c2584080deda2aefa7d61b7d1eedbac5137a25","5e45dd0843cf51eeca8cd2fae73def1bfd116113d925422fc0b0173065d569dc","e656c0d7b0695022f4e10cd7a7a75333cffdb2b5bd075a873d6aa51c33b3b3c4","4b28f1f05fe9696ef7d7e542cf7aa36f6ca52a11f3b30aa76e5cca9e8bea699b","64e2ff680bbad70255be557a47a55bb79af9b94276a0457fa4d46fe0cbe1a9b2","6e44d355490a66344b0342dbb6254c49eb938a73344b7875335664bce9f392ef","7cf5cb40544e0aa7957998f271f6b74cc0be320a7ae3644f75c51df62b03a52b","af292628b5f632fd6f43287aa259777be89d2f495fc5fcff825988fe3009fdcd","9c14bdf6baa83ffd1c3cf16019dcb411d15767c5c9b793ae64e53a57566dcf1a","967bdb2547918ce7e25d8ac3e102c122cb51b81e92265d96d898ce47d1afe589","6cd86a7abaa3657e093dce915f57e575702349004b4be3fa34cc4ebf9612dc95","d4d3bd1e6cd0e237095ccbba2e7736b8fd2885ca63bd52b905c56e16871b2b4b","c6acdfebd88798283a7bf42bcb3cc080bfc778da30b1617fca4b4c1f692e9bf3","d38068355625b3ed74bcabb1869dd9d9e0dcfe3755023fb2a7dc497bfb0b0e0e","f0411e5d3e5f72e8b3970f3e22448406f810148ed26b38422bfc00e838da047d"],"paragraph_range_zero_based":[2640,2663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2640"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if an entry with the matching condReconfigId exists in the condReconfigToAddModList within the VarConditionalReconfig:","paragraph_zero_based":2664},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condExecutionCond or condExecutionCondSCG;","paragraph_zero_based":2665},{"literal_text_all_w_t_and_m_t":"3>replace condExecutionCond or condExecutionCondSCG within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2666},{"literal_text_all_w_t_and_m_t":"2>if the entry in condReconfigToAddModList includes an condRRCReconfig;","paragraph_zero_based":2667},{"literal_text_all_w_t_and_m_t":"3>replace condRRCReconfig within the VarConditionalReconfig with the value received for this condReconfigId;","paragraph_zero_based":2668},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2669},{"literal_text_all_w_t_and_m_t":"2>add a new entry for this condReconfigId within the VarConditionalReconfig;","paragraph_zero_based":2670},{"literal_text_all_w_t_and_m_t":"1>perform conditional reconfiguration evaluation as specified in 5.3.5.13.4;","paragraph_zero_based":2671},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4Conditional reconfiguration evaluation","paragraph_zero_based":2672},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2673},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigId within the VarConditionalReconfig:","paragraph_zero_based":2674},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration within condRRCReconfig includes the masterCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2675},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the masterCellGroup in the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2676},{"literal_text_all_w_t_and_m_t":"2>else if the RRCReconfiguration within condRRCReconfig includes the secondaryCellGroup including the reconfigurationWithSync:","paragraph_zero_based":2677},{"literal_text_all_w_t_and_m_t":"3>consider the cell which has a physical cell identity matching the value indicated in the ServingCellConfigCommon included in the reconfigurationWithSync within the secondaryCellGroup within the received condRRCReconfig to be applicable cell;","paragraph_zero_based":2678},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCondSCG is configured:","paragraph_zero_based":2679},{"literal_text_all_w_t_and_m_t":"3>in the remainder of the procedure, consider each measId indicated in the condExecutionCondSCG as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2680},{"literal_text_all_w_t_and_m_t":"2>if condExecutionCond is configured:","paragraph_zero_based":2681},{"literal_text_all_w_t_and_m_t":"3>if it is configured via SRB3 or configured within nr-SCG or within nr-SecondaryCellGroupConfig (specified in TS 36.331[10]) via SRB1:","paragraph_zero_based":2682},{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the SCG measConfig;","paragraph_zero_based":2683},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":2684},{"literal_text_all_w_t_and_m_t":"4>in the remainder of the procedure, consider each measId indicated in the condExecutionCond as a measId in the VarMeasConfig associated with the MCG measConfig;","paragraph_zero_based":2685},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the condExecutionCond or condExecutionCondSCG associated to condReconfigId:","paragraph_zero_based":2686},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventT1, and if the entry condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c7835b31145b78b6ed9cee5c2fa6170c149fcb616f3bfc29a421924166d45947","4e01e73c587a32292c14d6b51c97dc80a1d4666303bf1796d66c9b41e9e313f9","4eb88cea3dd794c7d09dced8368dd1d5b4146a277aa9fa609490147c434549a1","d7267f91f4f3438353ec8a48587df0168c335c554230ab8af7c784ae37b7be33","aeba9cc6d1b4480afb0f5ebb07d425ab1b3b2d3b59fa2f1e090d02fd1021d814","7d9e245d825b2967e4257a1fc275d27d6cfb4f28c440a988374c909ab338e96e","cb8797c1975d82a05f8b63b0794fffb71cfde38acc87b0f9af47a62b215bc1a0","5799185bbe1feff62ba322c86827c145a0b8d9a7968531d8d2438c28e362769a","5deb9fc82b53be22aace79637b3a7edff6eece4266dd8b3bfa0d972cd22c6caf","95d2897cd4931b0a8d8abf90960512b00d774f6f2ac923b8cc41d1411d3deaf5","85678075d8f6afed7b313c81fcf3174401db71abcdfcd98874855faa76657e09","fc6a52b3cfee0608ddf7348cac0d62ac91cf6fa46e3ae001d17116bd946caedd","376eaacbc717608782c305c986d300278a41a8d3f340f61f2b056e77357a705a","f035de9a3428307c321fa575aff7e8620d398862f18226621250f58ec2bbc0ba","ba610561030f0fc7da9c7de18bf27ed0c81a0c6a2e13705d2242e178db1dceb8","e5f2a20474f0f8229a8e99ebc03bc06b06260aa037585c25d7ad0b8fc426cb82","8db0cc11cd863dc0e5f2a6bb4c0c8174828618bd734ab28a582ea0e0e213fead","9dace63f1bb3133192ab740a588a7eb3f18c96e885ad664c9cd0afd1013af917","d459a4dca4b48ace90facc74a5d591e98889100a71c90868533df4d5f6136742","28c72d228838a9f9c3e657c8ff05d8b6978b2b88a62075ff423e38c45e89e1fd","381c2044024e2da01309f5ee6e273f98fcc4b22684696eb1c0f2bc16af89094e","7b9da37f8bb7f2346d50274379629a800bf17a18e1413abff2d4cba2bb24d659","4a7f7ea303393703c079e5683ce2a084177861b19e0df20404c45df6f0258f1a","b888cf257ba49348d2209613ecf33f803879c0ad38b3e24519fd333876154679"],"paragraph_range_zero_based":[2664,2687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2664"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3> if the condEventId is associated with condEventD1, and if the entry conditions applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2688},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the entry condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2689},{"literal_text_all_w_t_and_m_t":"4>consider the event associated to that measId to be fulfilled;","paragraph_zero_based":2690},{"literal_text_all_w_t_and_m_t":"3>if the measId for this event associated with the condReconfigId has been modified; or","paragraph_zero_based":2691},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventT1, and if the leaving condition applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell; or","paragraph_zero_based":2692},{"literal_text_all_w_t_and_m_t":"3> if the condEventId is associated with condEventD1, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cell during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig; or","paragraph_zero_based":2693},{"literal_text_all_w_t_and_m_t":"3>if the condEventId is associated with condEventA3, condEventA4 or condEventA5, and if the leaving condition(s) applicable for this event associated with the condReconfigId, i.e. the event corresponding with the condEventId(s) of the corresponding condTriggerConfig within VarConditionalReconfig, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event within the VarConditionalReconfig:","paragraph_zero_based":2694},{"literal_text_all_w_t_and_m_t":"4>consider the event associated to that measId to be not fulfilled;","paragraph_zero_based":2695},{"literal_text_all_w_t_and_m_t":"2>if event(s) associated to all measId(s) within condTriggerConfig for the applicable cell are fulfilled:","paragraph_zero_based":2696},{"literal_text_all_w_t_and_m_t":"3>consider the applicable cell, associated to that condReconfigId, as a triggered cell;","paragraph_zero_based":2697},{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in 5.3.5.13.5;","paragraph_zero_based":2698},{"literal_text_all_w_t_and_m_t":"NOTE 1:Up to 2 MeasId can be configured for each condReconfigId. The conditional reconfiguration event of the 2 MeasId may have the same or different event conditions, triggering quantity, time to trigger, and triggering threshold.","paragraph_zero_based":2699},{"literal_text_all_w_t_and_m_t":"NOTE 2:Void.","paragraph_zero_based":2700},{"literal_text_all_w_t_and_m_t":"5.3.5.13.4aConditional reconfiguration evaluation of SN initiated inter-SN CPC for EN-DC","paragraph_zero_based":2701},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2702},{"literal_text_all_w_t_and_m_t":"1>for each condReconfigurationId within the VarConditionalReconfiguration specified in TS 36.331[10]:","paragraph_zero_based":2703},{"literal_text_all_w_t_and_m_t":"2>for each measId included in the measIdList within VarMeasConfig indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN associated to the condReconfigurationId as specified in TS 36.331[10]:","paragraph_zero_based":2704},{"literal_text_all_w_t_and_m_t":"3>if the entry condition(s) applicable for the event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2705},{"literal_text_all_w_t_and_m_t":"4>consider this event to be fulfilled;","paragraph_zero_based":2706},{"literal_text_all_w_t_and_m_t":"3>if the measId for this event has been modified; or","paragraph_zero_based":2707},{"literal_text_all_w_t_and_m_t":"3>if the leaving condition(s) applicable for this event associated with that measId, is fulfilled for the applicable cells for all measurements after layer 3 filtering taken during the corresponding timeToTrigger defined for this event associated with that measId:","paragraph_zero_based":2708},{"literal_text_all_w_t_and_m_t":"4>consider this event associated to that measId to be not fulfilled;","paragraph_zero_based":2709},{"literal_text_all_w_t_and_m_t":"2>if trigger conditions for all events associated with the measId(s) indicated in the CondReconfigExecCondSCG contained in the triggerConditionSN as specified in TS 36.331[10]), are fulfilled:","paragraph_zero_based":2710},{"literal_text_all_w_t_and_m_t":"3>consider the target cell candidate within the RRCReconfiguration message contained in nr-SecondaryCellGroupConfig in the RRCConnectionReconfiguration message, as specified in TS 36.331[10], contained in the stored condReconfigurationToApply, associated to that condReconfigurationId as specified in TS 36.331[10]), clause 5.3.5.9.4, as a triggered cell;","paragraph_zero_based":2711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44bf28f910d5f4f2c7b0dd4029794f6c0761a82f23c86a180f13d72e8b7c295d","fa77378e37a49cd405823dfb2388a237d035c84040eb0e3f8b140882bbcbb0ab","ead81191380a8d946ad7b1e3a3b7b4dafb4197f83da56f20b58713e1d55b0f48","ed1bc44a2a256794f79d93867c17d4e1fe0284ddee5d5d0a90fe65333616fcd3","bc5871e867acd162a95b5496ecf9658efc3643fb3faf0ee95e4c216e487f7cc6","90c4968e159db1e7b1400c87282c5e4069b62264852b64d73aea5a01feb00988","f92116ca5772610343df911ae54cbcd73104d02eb9cfa49beee728b9ab1dc3d5","37d7daf6a5b90253e81bc25917a0161667ac4318ef3bfff82b229f3684edc4e9","781a3c3e581c244ea91a835d04fb9d135aa4512637b85f678224c778a96bb0f5","3369b623ad4b1c31471f4c0129e09dd5c946fc55c8c255fcf74e18e08ea6bb9d","385ed6ed32935f152e1ab271bbd7b675bae7affe0c59540c8637a567c3cc18d7","1f0374f9da42d7111a97f6be57c6e9ffe6afb654df1cfe16230ffb8015466adc","e86535da0082ef0c7d7ff211f95085be43b3a72b148dd5b1a787744e7fe60b32","81a34f3951ec9e4daca63aba884a60822590277821bf4bd89fbc7f5da30d4888","556346ddc04a7ad91f686a5364e593b7a492ba326840f1ab7f51d6999407d194","39b3f6b13385382a8009b3e2f303554dca821c68247e1b91ab788b6966bba1cd","a06e5cf01ca588e215629cda63561d9b1811396fa70dc1aed37520b0dbb11b6a","b12d59f47657237a7c81e74a19eef798a044f862cb39afcb2f67af4792ba1d2c","5b03631901558e0bafb8802861ae7e0994c3df3cfc164c231eeb31eb6a969a7f","1642a1092c878fc0fc4c7dd1c14368175f46f312b21c13ac56064edade711639","d9a37f64f54b8e7c9092f5922ea2ce015ff26f3d2fb3efd108e992ffaf3e94af","4dcd3a5039168426746560a860edccd7c5aad26375f353b999989c1b9d261ae6","c0e976f61a8a5d9f986a4fed7c98b2edfe4e8f5c0fad6276a3621d2ba4f246e9","54a2e87faea7004a0cfc6dce5ff909e41a137f2101131fbdce0097313612810f"],"paragraph_range_zero_based":[2688,2711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2688"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>initiate the conditional reconfiguration execution, as specified in TS 36.331[10]), clause 5.3.5.9.5;","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"NOTE:Void.","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"5.3.5.13.5Conditional reconfiguration execution","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"1>if more than one triggered cell exists:","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"2>select one of the triggered cells as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"2>consider the triggered cell as the selected cell for conditional reconfiguration execution;","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"1>for the selected cell of conditional reconfiguration execution:","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"2>apply the stored condRRCReconfig of the selected cell and perform the actions as specified in 5.3.5.3;","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"NOTE:If multiple NR cells are triggered in conditional reconfiguration execution, it is up to UE implementation which one to select, e.g. the UE considers beams and beam quality to select one of the triggered cells for execution.","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"5.3.5.13aSCG activation","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"1>if the UE is configured with an SCG after receiving the message for which this procedure is initiated:","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"2>if the UE was configured with a deactivated SCG before receiving the message for which this procedure is initiated:","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"3>consider the SCG to be activated;","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"3>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2728},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2729},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layers that the SCG is activated.","paragraph_zero_based":2730},{"literal_text_all_w_t_and_m_t":"5.3.5.13bSCG deactivation","paragraph_zero_based":2731},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2732},{"literal_text_all_w_t_and_m_t":"1>consider the SCG to be deactivated;","paragraph_zero_based":2733},{"literal_text_all_w_t_and_m_t":"1>indicate to lower layers that the SCG is deactivated;","paragraph_zero_based":2734},{"literal_text_all_w_t_and_m_t":"1>if bfd-and-RLM is configured to true:","paragraph_zero_based":2735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["468019b3a44296cdd3006d6f12aaf439f8d81720207143fe0ca873a6fbc4b131","c2eddbe22b925e0818426aede174527c75946c56ac4026ad5b051e7960f4e785","ba39491e1b79add909aaba7d74554416bd5a1b2f8ddcc362fb369debe7ea9caa","b07220f8934ca3a54180e80a9a35a53652beb9d2a5a57196fd0f9b93183f8391","166d5994c50f4cf7558e8907d8c6327159fcf6e13dfd3f216c46753bfcee2ea1","dee4dc421c6c29e89d02e2307ce27a8b771a915bb9c6e5094f90aa05f2bd0a0a","5f15179601ec7b45685d0e1569ff2e548e2a84f72355779c70dc1ae023c9e43c","d0ca0cb17814c58be721f7942cba83d21e3eec0104cb336fb64cb6da61a52835","4c5715f6a998520d2dd6b2eec78ecce85848c1e55613ca26874c7bef57ac0687","b3a89b3b36c9a8200cfa408621b7800453f15b56225b8088bc1fce43f61a244e","0220e9c70b0f7a1d8ba776ab934c1f538052e350257893ad49791fccfb7d517b","b6a214219bad56858d670f0559e2e5c01f082d9ff58acb73e8c8f49d75d5fc3b","71af504681406e5551a7a69766d83a3f8860027d78a426998ad04b44aeb6e884","d35f34d27e722e228c2df77fd9cf9398c75f41861578cffaed2ca067838f1031","de95114012fc58597523f406b73fa8bed4ebe7019e9c5dee0cf673f5cf2b508b","622170f6884fde323b00ab11c4b3d81f73591b3fe8e052bbdd1c05685eccb550","4ee685ca174ce64566faef7615222ff38f965a40a7f7e2ab5e040c41dbc03f10","f7bd755118e99bdfa7393a3620b41acd5725a3b42f9a6a01f88b8dfb4b009e88","5534279546322ca546e19a39913385e73cbb2a37393ca8a7ef9f9b95fc40e4ba","f65041ce476972be8389852b79dfd21f85b60a3f79466adc8b77efdeb1710374","2d9673cd0b875821e59edb6c3e0fb89847e46d9772977904c2163e87d950c899","539a198c38c899812921614925d45f0d5dc4a0da70461037df101c5e52339a31","5b433c6855a9d87ba1cfd98be4cca85bf21bd41c3b4ce66d86fbd124b64deba4","2312144cf38af2a90542632ed060a872ce0770a24c7adc69dde9ef77f68830ad"],"paragraph_range_zero_based":[2712,2735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2712"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>perform radio link monitoring on the SCG;","paragraph_zero_based":2736},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to perform beam failure detection on the PSCell;","paragraph_zero_based":2737},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2738},{"literal_text_all_w_t_and_m_t":"2>stop radio link monitoring on the SCG;","paragraph_zero_based":2739},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to stop beam failure detection on the PSCell;","paragraph_zero_based":2740},{"literal_text_all_w_t_and_m_t":"2>stop timer T310 for this cell group, if running;","paragraph_zero_based":2741},{"literal_text_all_w_t_and_m_t":"2>stop timer T312 for this cell group, if running;","paragraph_zero_based":2742},{"literal_text_all_w_t_and_m_t":"2>reset the counters N310 and N311;","paragraph_zero_based":2743},{"literal_text_all_w_t_and_m_t":"1>if the UE was in RRC_CONNECTED and the SCG was activated before receiving the message for which this procedure is initiated:","paragraph_zero_based":2744},{"literal_text_all_w_t_and_m_t":"2>if SRB3 was configured before the reception of the RRCReconfiguration or of the RRCConnectionReconfiguration and SRB3 is not to be released according to any RadioBearerConfig included in the RRCReconfiguration or in the RRCConnectionReconfiguration as specified in TS 36.331[10]:","paragraph_zero_based":2745},{"literal_text_all_w_t_and_m_t":"3>trigger the PDCP entity of SRB3 to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":2746},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity of SRB3 as specified in TS 38.322 [4].","paragraph_zero_based":2747},{"literal_text_all_w_t_and_m_t":"5.3.5.13b1SCG activation without SN message","paragraph_zero_based":2748},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2749},{"literal_text_all_w_t_and_m_t":"1>if the SCG was deactivated before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed:","paragraph_zero_based":2750},{"literal_text_all_w_t_and_m_t":"2>consider the SCG to be activated;","paragraph_zero_based":2751},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers that the SCG is activated;","paragraph_zero_based":2752},{"literal_text_all_w_t_and_m_t":"2>resume performing radio link monitoring on the SCG, if previously stopped;","paragraph_zero_based":2753},{"literal_text_all_w_t_and_m_t":"2>indicate to lower layers to resume beam failure detection on the PSCell, if previously stopped;","paragraph_zero_based":2754},{"literal_text_all_w_t_and_m_t":"2>if bfd-and-RLM was not configured to true before the reception of the RRCReconfiguration message or the E-UTRA RRCConnectionReconfiguration message for which the procedure invoking this clause is executed; or","paragraph_zero_based":2755},{"literal_text_all_w_t_and_m_t":"2>if lower layers indicate that a Random Access procedure is needed for SCG activation:","paragraph_zero_based":2756},{"literal_text_all_w_t_and_m_t":"3>initiate the Random Access procedure on the PSCell, as specified in TS 38.321 [3].","paragraph_zero_based":2757},{"literal_text_all_w_t_and_m_t":"5.3.5.13cFR2 UL gap configuration","paragraph_zero_based":2758},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6a268ed23a316406653ead6dccbcb2527e4ec6c18b85845bd97a528b292b2676","6a98ee032de9dc9ca4dab755c8a3b039f42da1ce78dbb1ac1de16648a66a341e","e4ad5aa4dc8d20d18033380c448b24392d77891058d98693d061bf9adc5e0e2e","a3be1ee7b8d7cc21b0dba5300d6592d17f5c93e41e0c868f1b18eeae4c0fb89e","ca085df7392b2fc8f99caa177be4796e2e0ddb4f59b8bee290b47176fbdaf4b8","dcd62c6316356c3ada30a3401c7a5ccb2df831bae70d3a7660f71b709710b540","10d6aa114b6594acbd2e08f0f9c451de3c8c731703b4560e666afbefcd9f1c32","2042eca552d9c2c2864cb3e05d697204cf855d3574e16494d484c74c45ac61ee","a039c17d4aac1912e60ed8cce1b0cd4337814e2f0d034bb92be2ad8940c02ab9","9aaf09c1e05ae7aaff3be0878f82aa59c75bb7284d3dce64fe030389d6bd5a72","8c3fd5b7c54573a70b4fc6939edb8a0e6f128667fd423b5b6950a632e0b5da4e","770a89930c1dbb795f4332ec731de365cef4bd98fc3e085083a2107579a57999","37c121d90c7b21cd435a063a8753fa3d1352b43b876ed25405c3c19fa66b4c68","9d52862201fc16750b2bad666da4369876cdf2a2126024c456d97d0e75305cae","336195fc60935e1152af83235fa3268b3af7ee1ab07f3320b85fa665cc9d8a84","3879914e2b3054d9bfffb9ce4c814e93f553f949418def0e800bdcbecf0093be","f7bda95c721e807240d3601d513aa040696a3d5a8d1ee002cb92caf04980ddcc","12547ed02c0c0f8eaa0727ca15503c32d4387fe8e19a5ff333e46dc4a77f5f1a","f0d68b86318dcf9d4f5ba5b44d4e78d9bbbab7bcad62441f7c26bc06cee28cce","caeeff5d2eb487c6264c2321640cbd978dc562369bf7555ad8a6964c56711b4c","cf13a01878e9811ddcb1bf70f267732222bd3ac791f686d7107ffa5210a58599","36dfa225b260ade10dc4f078ff6d852190ea05563a758c3363a9e0d4bd379214","7aa8da419f667b37980428a598de541b912e5fc6fc140accb25c97c8a56ab3f1","a984b13c575ffe666345c4b1866f18c9c5baa5c9a5a7cd5541ed31e3713251d0"],"paragraph_range_zero_based":[2736,2759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2736"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if ul-GapFR2-Config is set to setup:","paragraph_zero_based":2760},{"literal_text_all_w_t_and_m_t":"2>if an FR2 UL gap configuration is already setup, release the FR2 UL gap configuration;","paragraph_zero_based":2761},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 UL gap configuration indicated by the ul-GapFR2-Config in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":2762},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR (gapOffset/10);","paragraph_zero_based":2763},{"literal_text_all_w_t_and_m_t":"if the UGRP is larger than 5ms:","paragraph_zero_based":2764},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":2765},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":2766},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset or (gapOffset +5);","paragraph_zero_based":2767},{"literal_text_all_w_t_and_m_t":"with T = CEIL(UGRP/10).","paragraph_zero_based":2768},{"literal_text_all_w_t_and_m_t":"1>else if ul-GapFR2-Config is set to release:","paragraph_zero_based":2769},{"literal_text_all_w_t_and_m_t":"2>release the FR2 UL gap configuration.","paragraph_zero_based":2770},{"literal_text_all_w_t_and_m_t":"NOTE 1:For ul-GapFR2-Config configuration with synchronous CA, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation. For ul-GapFR2-Config configuration with asynchronous CA, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2-ServCellAsyncCA in ul-GapFR2-Config is used in the gap calculation.","paragraph_zero_based":2771},{"literal_text_all_w_t_and_m_t":"5.3.5.13dApplication layer measurement configuration","paragraph_zero_based":2772},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":2773},{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToReleaseList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2774},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToReleaseList:","paragraph_zero_based":2775},{"literal_text_all_w_t_and_m_t":"3>forward the measConfigAppLayerId and inform upper layers about the release of the application layer measurement configuration including any RAN visible application layer measurement configuration;","paragraph_zero_based":2776},{"literal_text_all_w_t_and_m_t":"3>discard any application layer measurement report received from upper layers;","paragraph_zero_based":2777},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to send application layer measurement report for the measConfigAppLayerId.","paragraph_zero_based":2778},{"literal_text_all_w_t_and_m_t":"1>if measConfigAppLayerToAddModList is included in appLayerMeasConfig within RRCReconfiguration or RRCResume:","paragraph_zero_based":2779},{"literal_text_all_w_t_and_m_t":"2>for each measConfigAppLayerId value included in the measConfigAppLayerToAddModList:","paragraph_zero_based":2780},{"literal_text_all_w_t_and_m_t":"3>if measConfigAppLayerContainer is included for the corresponding MeasConfigAppLayer configuration:","paragraph_zero_based":2781},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerContainer, the measConfigAppLayerId and the serviceType to upper layers considering the serviceType;","paragraph_zero_based":2782},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to send application layer measurement report for the measConfigAppLayerId in accordance with 5.7.16;","paragraph_zero_based":2783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d7a5d227623f079926f32fc68dd626e0995bf9b5bb47b9d47d279747bf180bba","a2e83e139ad074ce903475b1577f6ca4c6244949af7d6f01482ea7e33b3357c3","edc04c9bf14d8777e9955f4d139e02be7039462816fe37376f9e20a0c1334801","11b22ae8928a52312afa43c8e6f072e4c828c011daf5ba23981c244152b22d20","34e49a1031735577480ee91f9e219db73d8ac13f2071b6dba07889c50ade65a4","4b68d0472b8ecff5f3016531576d2b9b3a94e51e9f28a047e25685c4fb8c74af","6343b4be6e8729d5da14477f0ce975eda12e994b11223028f1ef01fedffdc695","65d06435518c14e96370a0984272ae66121b7249971f85bdfb1b8cc87165f8fa","2cd2055bb387ab0b38e29962180c6c700d1c398cd1ebdb344b2091743dfcfb94","658d89d23fb876688edf8387b0606c18f3e46b364d60b2fb5f52110a6d9040d7","69f8107be2930cba261d75990563dbec999439e3b8bf4d595c7bfc56443e48e1","5bc6b7b5ed0b87e78907bbd7a18e72a32714a4a35bd28d84a267acc329ecdffd","ced818bfd7704dc5e37848749bdd5b21a5c94c0b00c79ca5cc1f369cbbc3c6a8","da203303a284ca94651abe621e407f53e262b18a7316ef8ee4311cf2fd4e754b","516d41722d40baa1a10e10128938f22609c89299fee2db9eb30121477620a0cd","4a12b6da530bba9982096abe22617648fd0bdfa3271e28bc3cf2c099a6e3e905","aeed74e833cc2b52cd796581f1e8cb5180618f2e3acd10d044eb5d919914281c","3be4fd0b75553c24815490034abc0fd4921a5adcff370a71c0ca6de2eda98f39","c1d8c51eb3cbb73c6f0c576407cbfe73f7f9b057a9207dd7e588a7e512a4b404","ef525784ad57238baa169d876a90c7941efe517098be0e33866b824653d4efc5","d482613c48c9358ee4c87a218fe9381bcb3477fac513e863269d81bf4a75cc6f","dd61de4fb08ea31314152484ef6a580b1b3226a81d2b5e4b4a6e5942c5b29efd","fd62f58059ef5e04e43b5a6e8b4e5724f13c6db1ae43031bfae7699e721f7631","235a09195e61708a5351c46fd5211649f98cb0f9dda53c0b4c458821189a7026"],"paragraph_range_zero_based":[2760,2783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2760"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>forward the transmissionOfSessionStartStop, if configured, and measConfigAppLayerId to upper layers considering the serviceType;","paragraph_zero_based":2784},{"literal_text_all_w_t_and_m_t":"3>if ran-VisibleParameters is set to setup and the parameters have been received:","paragraph_zero_based":2785},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId, the ran-VisiblePeriodicity, if configured, the numberOfBufferLevelEntries, if configured, and the reportPlayoutDelayForMediaStartup, if configured, to upper layers considering the serviceType;","paragraph_zero_based":2786},{"literal_text_all_w_t_and_m_t":"3>else if ran-VisibleParameters is set to release:","paragraph_zero_based":2787},{"literal_text_all_w_t_and_m_t":"4>forward the measConfigAppLayerId and inform upper layers about the release of the RAN visible application layer measurement configuration;","paragraph_zero_based":2788},{"literal_text_all_w_t_and_m_t":"3>if pauseReporting is set to true:","paragraph_zero_based":2789},{"literal_text_all_w_t_and_m_t":"4>if at least one segment, but not all segments, of a segmented MeasurementReportAppLayer message containing an application layer measurement report associated with the measConfigAppLayerId has been submitted to lower layers for transmission:","paragraph_zero_based":2790},{"literal_text_all_w_t_and_m_t":"5>submit the remaining segments of the MeasurementReportAppLayer message to lower layers for transmission;","paragraph_zero_based":2791},{"literal_text_all_w_t_and_m_t":"4>suspend submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2792},{"literal_text_all_w_t_and_m_t":"4>store any previously or subsequently received application layer measurement report containers associated with the measConfigAppLayerId for which no segment, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":2793},{"literal_text_all_w_t_and_m_t":"3>else if pauseReporting is set to false and if transmission of application layer measurement report containers has previously been suspended for the application layer measurement configuration associated with the measConfigAppLayerId:","paragraph_zero_based":2794},{"literal_text_all_w_t_and_m_t":"4>submit stored application layer measurement report containers to lower layers, if any, for the application layer measurements configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2795},{"literal_text_all_w_t_and_m_t":"4>resume submitting application layer measurement report containers to lower layers for the application layer measurement configuration associated with the measConfigAppLayerId;","paragraph_zero_based":2796},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may discard reports when the memory reserved for storing application layer measurement report containers becomes full.","paragraph_zero_based":2797},{"literal_text_all_w_t_and_m_t":"NOTE 2:The transmission of RAN visible application layer measurement reports and appLayerSessionStatus is not paused when pauseReporting is set to true.","paragraph_zero_based":2798},{"literal_text_all_w_t_and_m_t":"5.3.5.14Sidelink dedicated configuration","paragraph_zero_based":2799},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":2800},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2801},{"literal_text_all_w_t_and_m_t":"2>for each entry included in the received sl-FreqInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2802},{"literal_text_all_w_t_and_m_t":"3>release the related configurations from the stored NR sidelink communication/discovery configurations;","paragraph_zero_based":2803},{"literal_text_all_w_t_and_m_t":"1>if sl-FreqInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2804},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink communication:","paragraph_zero_based":2805},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-RxPool for NR sidelink communication reception, as specified in 5.8.7;","paragraph_zero_based":2806},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink communication:","paragraph_zero_based":2807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["29c38f0c5a82e6a7ffc7c2e268b0ea4718de0375c30fdb129cb98c9caee3ae7e","4c8dc2c68a76606b0b9ca0c7a79c6085a5fd7e3eff06d24ca4a4c9a46af37306","c9470a1052ed86533e1001118ba36daf0a8f5b2c681b4494501b3b2efef422f2","0439abaa5cd217e568b5da79c294e609cc0116157effc28064555836ea2056ef","90b341703d8948322a367ea75769c832926a594398366642535aa5907e0567cb","acdd56eb23e96f0b53782ed5439111afec86feb178540e9953dc5dc411efb9cb","6dfddf3b26f0f4da7a43950f44abb781712926c629fc2cdda7ee912d692638a1","c83882d1b5796965378afc301285392479d63441127647d04f103f65dfc4c2d0","397212dab2ba2d6e638ed35219b34ef25291be9b1afd8f297013819ab937480c","a3322e98ef7d9db6b725e1ca8ab1523dcf5cd96d55f00524e5aabf0d8ee7f48a","444c04690b66870612a9b353459e680f9d06ddb1796a20aba37d22f9f99ad184","0dc752dcf98275d4c17ab425da7ac3363d1657c4f174cf266d9f9da1a7a5e4b2","edefea1c21af3b8f252eb04300a1e58a433430ac14c8176113e1225be5a3a86f","34c08bebc6e97517c0d2e9121d4483b82fe415269212aad6782fbeb2e8513571","6cb8f3e1a38be0006d6c86c0dc5f76859debf5fd52db5ebdcae6dcbc420f2233","7719f3febfadfda6108bde819e5340e3eb7867da1adfd15b6c3ce1a8f34cf9f1","cd872ad8beef0f8f5586ec3b0471e65841ebb651edd92e89bbca57b09c6baa66","314c6469dcb4776d6d05f86c5ef5b9b182991bad54483fd4c0edc3ead26727fd","992544a12a98bd84c3df64a50e521ec003073017b90e1864760e84608e367f42","7b7b1916b8f82421f652a8926d3546d2f6e3fdd79ea3a795d52ecc0a50ed1a1f","7a3fdf6f01bef39530c50f8788e7619880ece5f8fa8ee0bd7fe3641e0c372e4a","a78b950450041f792acdfce2c0863cf089f20c5a8f355313eb7e0bbe7624f0f0","48ac4b9edf963fbef877fa6619357467971d88c323c1e9a44c1aa5cbaeef286f","13bd0664405dc8809da18960565e9eb757700eca067e9b5e8c7db00cf07d328b"],"paragraph_range_zero_based":[2784,2807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2784"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication transmission, as specified in 5.8.8;","paragraph_zero_based":2808},{"literal_text_all_w_t_and_m_t":"2>if configured to receive NR sidelink discovery:","paragraph_zero_based":2809},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscRxPool or sl-RxPool for NR sidelink discovery reception, as specified in 5.8.13.2;","paragraph_zero_based":2810},{"literal_text_all_w_t_and_m_t":"2>if configured to transmit NR sidelink discovery:","paragraph_zero_based":2811},{"literal_text_all_w_t_and_m_t":"3>use the resource pool(s) indicated by sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling, sl-TxPoolSelectedNormal, sl-TxPoolScheduling or sl-TxPoolExceptional for NR sidelink discovery transmission, as specified in 5.8.13.3;","paragraph_zero_based":2812},{"literal_text_all_w_t_and_m_t":"2>perform CBR measurement on the transmission resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-TxPoolScheduling, sl-DiscTxPoolSelected, sl-DiscTxPoolScheduling or sl-TxPoolExceptional for NR sidelink communication/discovery transmission, as specified in 5.5.3;","paragraph_zero_based":2813},{"literal_text_all_w_t_and_m_t":"2>use the synchronization configuration parameters for NR sidelink communication/discovery on frequencies included in sl-FreqInfoToAddModList, as specified in 5.8.5;","paragraph_zero_based":2814},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToReleaseList or sl-RLC-BearerToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2815},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB release as specified in 5.8.9.1a.1;","paragraph_zero_based":2816},{"literal_text_all_w_t_and_m_t":"1>if sl-RadioBearerToAddModList or sl-RLC-BearerToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2817},{"literal_text_all_w_t_and_m_t":"2>perform sidelink DRB addition/modification as specified in 5.8.9.1a.2;","paragraph_zero_based":2818},{"literal_text_all_w_t_and_m_t":"1>if sl-ScheduledConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2819},{"literal_text_all_w_t_and_m_t":"2>configure the MAC entity parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-ScheduledConfig;","paragraph_zero_based":2820},{"literal_text_all_w_t_and_m_t":"1>if sl-UE-SelectedConfig is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2821},{"literal_text_all_w_t_and_m_t":"2>configure the parameters, which are to be used for NR sidelink communication/discovery, in accordance with the received sl-UE-SelectedConfig;","paragraph_zero_based":2822},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2823},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-MeasConfigInfoToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2824},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2825},{"literal_text_all_w_t_and_m_t":"1>if sl-MeasConfigInfoToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2826},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2827},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink measurement configuration information;","paragraph_zero_based":2828},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-MeasConfigInfoToAddModList that is not part of the current stored NR sidelink measurement configuration:","paragraph_zero_based":2829},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink measurement configuration.","paragraph_zero_based":2830},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink measurement configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e7511fb3c91841ce2807114ece8443be8ca70f79a60db6032c6ab29b2b93adb3","5d0fc5b85c2c4c10d341e824cf458a71e1c77e361770ddbd64e090236972ac1a","d329b5dc0947ec968f8be0e42a98237a6c0c7e8b553f184f041f1b35b79b8621","5dd8edee8cfa0aed94c4ca8a42100dfcc3481c5fcd286198af0ca3a7e258acff","60be08b3b3a4fd71b8cdf6ad6602afd013622a7d176ce0bd31c8d84bc82f0f82","47c3f7f01e72296dc97240dabeebf21f8008c8ffe009fd00cdb74e01cad404d7","dd7c942e6b205db96166989838a2a2ef29a53c6355db5ad389c6f77a9c5c8dce","137368da2369fb187e18b0e4b36c865c1b9d44ba55838652ead7ff3abb8aeb47","7411bd29b9a3a87e85967c0f55c0446deecadaeae2d937ba79ebfd192688d292","7a8eb6950344375c346a1557c647bfc8110d5317c9fd24c3f5e25d15dac99958","673efda281cf94600c83732a6d2182c1175dd733918590f56d6efdab2047be0f","b55955c26bc0e178575bd87b95b6878fc7f3c0836817d9bc987d670ff1b1898c","8cf001f5d5381c29fc28d50ec576274ed431d297d5cbd7c548c4e3f4604d55c3","a52f695c17ba4da61a2f7bcfe146bfb6e72922d13afd7105346fd141a8d1c239","b57831b8f997ae54ca63c29f8c2c92ec842b6b8158b8d2e282915887e56aa5b4","0f6064779952ff6200f6b43ac07d24515b21a8af7ffd8a6aa3b3cd1ec20b0cd1","71598f4885b1da1e0822078eec3b29603c8c62d799492b69a4ce6004da8b256e","6c6b3cbe10e93acbbd805f054208fc9bf3cd84aff34c24eb2e381d87958c5a50","54f59b9ef9892c186d7cf1899eaf50c2824b8549a969f5ca87cd4da15553df81","4ba498ceade48465cc61742012f0038628d92ed76e949a673cd10f18696730cb","cfac555b9a0ace8d15ca7e5f039ec78eded7d4c633cf65f3042749d45824dbf0","cc2a2a3921be88a67966f756234809d6fca5cf4037833e757bc580f03d543eff","2802afeb75ee912c688fc332db3af1de5eb0af1685618ef1b2cd0def2c394945","9937c2a3fdf99488e403da14cf74d0b35ef85aeb1794edb8f0d2ab8cdcbd5681"],"paragraph_range_zero_based":[2808,2831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p2808"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2832},{"literal_text_all_w_t_and_m_t":"2>for each SL-DestinationIndex included in the received sl-DRX-ConfigUC-ToReleaseList that is part of the current UE configuration:","paragraph_zero_based":2833},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching SL-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2834},{"literal_text_all_w_t_and_m_t":"1>if sl-DRX-ConfigUC-ToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2835},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2836},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry according to the value received for this sl-DestinationIndex from the stored NR sidelink DRX configuration information;","paragraph_zero_based":2837},{"literal_text_all_w_t_and_m_t":"2>for each sl-DestinationIndex included in the received sl-DRX-ConfigUC-ToAddModList that is not part of the current stored NR sidelink DRX configuration:","paragraph_zero_based":2838},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this sl-DestinationIndex to the stored NR sidelink DRX configuration.","paragraph_zero_based":2839},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is expected to update the mapping between the Destination Layer-2 ID and the destination index for the stored NR sidelink DRX configuration after the UE updates the destination list and reports to the gNB.","paragraph_zero_based":2840},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToReleaseList is included in sl-ConfigDedicatedNR within RRCReconfiguration:","paragraph_zero_based":2841},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel release as specified in 5.8.9.7.1;","paragraph_zero_based":2842},{"literal_text_all_w_t_and_m_t":"1>if sl-RLC-ChannelToAddModList is included in sl-ConfigDedicatedNR within RRCReconfiguration or RRCSetup:","paragraph_zero_based":2843},{"literal_text_all_w_t_and_m_t":"2>perform PC5 Relay RLC channel addition/modification as specified in 5.8.9.7.2;","paragraph_zero_based":2844},{"literal_text_all_w_t_and_m_t":"5.3.5.15L2 U2N Relay UE configuration","paragraph_zero_based":2845},{"literal_text_all_w_t_and_m_t":"5.3.5.15.1General","paragraph_zero_based":2846},{"literal_text_all_w_t_and_m_t":"The network configures the L2 U2N Relay UE with relay operation related configurations. For each connected L2 U2N Remote UE indicated in sl-L2IdentityRemote, the network provides the configuration parameters used for relaying.","paragraph_zero_based":2847},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE shall:","paragraph_zero_based":2848},{"literal_text_all_w_t_and_m_t":"1>if sl-L2RelayUE-Config is set to setup:","paragraph_zero_based":2849},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToReleaseList:","paragraph_zero_based":2850},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE release as specified in 5.3.5.15.2;","paragraph_zero_based":2851},{"literal_text_all_w_t_and_m_t":"2>if the sl-L2RelayUE-Config contains the sl-RemoteUE-ToAddModList:","paragraph_zero_based":2852},{"literal_text_all_w_t_and_m_t":"3>perform the L2 U2N Remote UE addition/modification as specified in 5.3.5.15.3;","paragraph_zero_based":2853},{"literal_text_all_w_t_and_m_t":"1>else if sl-L2RelayUE-Config is set to release:","paragraph_zero_based":2854},{"literal_text_all_w_t_and_m_t":"2>release the relay operation related configurations.","paragraph_zero_based":2855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d02111b7545b0ed3f65f232aee06d8cac651f0d89fa0072bf162fa54c048def4","18e867c1a1924b47d63f59335a145255fcc80282ebdaa9f3dac2a59a2a1b56ca","22314618d3f11a0e2c92496927231f3d55603c157835c3ca14887e91e32176df","b7f795ceb21e07ed234ccf19414d2a342a9111b1545a871a75eacbef8e32d602","2e843de8aa0e9ddd20bdf09cc2bd8fa474db54b46336b77be8fa5fd3e2cdb6c1","f7c4d89535f695345ca8c3abda4e6c716f2a17c59082cbdbc943700a1e819245","db755c7b61a75a1553b6f2cfdade155f8aecf37bc10bcb02cd1d1315b523ef99","0440ccb32b5ec424581e630078fe60185192b9d80824d508eb14e37dc99aeb7d","d3368f341f613e07300ddb2f2dc79b7240b4907e897fca40208c650632cd01ca","3481e5ba75329caa5636df8c9743c962106ef8484b0700b96d0657e4bb680ae9","3ced19bc07f92360203f724b5749292dd430b1430ca005786c50db1c18901c3c","aaf4e6946526c08e6a60edd120dfd3dd1a37be848a3c9c050493c84fb555cc34","932db358899a268065f80b3666300cba042ad24dd80dea4e74ceb0c517a5c86f","1aef82993e2d708ed32dc016a1e17a59bdb913db1820df47ae37dc3cc7974ae5","a45afbe965c9442588da9ebab9aa846314dfe67f310738699f48418239c97fd1","5be994e75e98f68b114a09d2e994dad2d3c722d16229ec5b87b09991f5b6e0fa","02d09e7637d92a4cea7ec5ef3e4dd6844d3065531f45899e508f4263770e07d6","1085013c6f1509222abca2e90e2a5bfa7a2d40b40af62ac029357cae9563ee79","e58c5dac39895dc6239aae92098ad0b3dff9a3b582b2d75f48bf25556eb3cf16","8bc11aae5d5c8c2baf52186cb2a773f9c9556a52bacaac413a097a90ef8ce51c","df69cff3eb52281ece638219a4769a81b3066e153cf185d0e7f621516656cff3","567d5fbbf2470ec2939b203d31435f4ae42f523470f3130480635fca63549e5f","b68788874adbaa9089ecde814b4aedf3e6d2bebb1dc066179b8b5645455212af","6806df50116db46c1c7311707c9414f9e7b29cee33cc4d9b9638c9d3cd67930c"],"paragraph_range_zero_based":[2832,2855],"projection"