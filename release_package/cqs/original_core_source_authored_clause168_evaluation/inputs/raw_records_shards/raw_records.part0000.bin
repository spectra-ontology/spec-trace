{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>treat the rest of the message as if the field was absent.","paragraph_zero_based":42912},{"literal_text_all_w_t_and_m_t":"NOTE:This clause does not apply to the case of an extension to the value range of a field. Such cases are addressed instead by the requirements in clause 10.3.","paragraph_zero_based":42913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42914},{"literal_text_all_w_t_and_m_t":"11Radio information related interactions between network nodes","paragraph_zero_based":42915},{"literal_text_all_w_t_and_m_t":"11.1General","paragraph_zero_based":42916},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are transferred between network nodes. These RRC messages may be transferred to or from the UE via another Radio Access Technology. Consequently, these messages have similar characteristics as the RRC messages that are transferred across the NR radio interface, i.e. the same transfer syntax and protocol extension mechanisms apply.","paragraph_zero_based":42917},{"literal_text_all_w_t_and_m_t":"11.2Inter-node RRC messages","paragraph_zero_based":42918},{"literal_text_all_w_t_and_m_t":"11.2.1General","paragraph_zero_based":42919},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are sent either across the X2-, Xn- or the NG-interface, either to or from the gNB, i.e. a single 'logical channel' is used for all RRC messages transferred across network nodes. The information could originate from or be destined for another RAT.","paragraph_zero_based":42920},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42921},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-INTER-NODE-DEFINITIONS-START","paragraph_zero_based":42922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42923},{"literal_text_all_w_t_and_m_t":"NR-InterNodeDefinitions DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":42924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42925},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":42926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42927},{"literal_text_all_w_t_and_m_t":"IMPORTS","paragraph_zero_based":42928},{"literal_text_all_w_t_and_m_t":"    ARFCN-ValueNR,","paragraph_zero_based":42929},{"literal_text_all_w_t_and_m_t":"    ARFCN-ValueEUTRA,","paragraph_zero_based":42930},{"literal_text_all_w_t_and_m_t":"    CellIdentity,","paragraph_zero_based":42931},{"literal_text_all_w_t_and_m_t":"    CGI-InfoEUTRA,","paragraph_zero_based":42932},{"literal_text_all_w_t_and_m_t":"    CGI-InfoNR,","paragraph_zero_based":42933},{"literal_text_all_w_t_and_m_t":"    CondReconfigExecCondSCG-r17,","paragraph_zero_based":42934},{"literal_text_all_w_t_and_m_t":"    CSI-RS-Index,","paragraph_zero_based":42935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a4c2d792c7d87d0ce18f8dc9fb292f499138ef5710e69d7326dd4aebeb5788a9","6e67d894d1ae568cfda69c9e1bb86888250a5234739c5eab32b0d6c969a0a62f","04602468030e5b4c3efca19960ca55a718864048b848b62833d37a26f212c2c3","7675d94949cb5da66b11a1218921197d9670f8aaf6cb978665a554d9ec5a3fba","17cb738d931938920f707caf4d1478ac3efc8af5de671fface5718dac3b9c4ef","28b31fc957828fcd2480c590da60f2459581e4b218272138f07b35c03d1d55b1","cb34b8f805f1aeffa8476ced866fcfb650d74d871f3f57cbf54266a8e1719c89","7874ccd895eca5bb38e70c4164c8d57dafc0903d689760ab793bb706bcf26d20","6db53f41be28987c29999062d775cf9fa9301b24f667529a791545de4564fed2","ce9b94ffe4d33ebdc7a146b1db1207f98b4c1a55e89e1eac85e7be1b0f940e