{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"GNSSIDSBAS","paragraph_zero_based":432},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the GNSSID = sbas; otherwise it is not present.","paragraph_zero_based":433},{"literal_text_all_w_t_and_m_t":"TimeModReq","paragraph_zero_based":434},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-TimeModelList; otherwise it is not present.","paragraph_zero_based":435},{"literal_text_all_w_t_and_m_t":"DGNSS-Req","paragraph_zero_based":436},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-DifferentialCorrections; otherwise it is not present.","paragraph_zero_based":437},{"literal_text_all_w_t_and_m_t":"NavModReq","paragraph_zero_based":438},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-NavigationModel; otherwise it is not present.","paragraph_zero_based":439},{"literal_text_all_w_t_and_m_t":"RTIReq","paragraph_zero_based":440},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-RealTimeIntegrity; otherwise it is not present.","paragraph_zero_based":441},{"literal_text_all_w_t_and_m_t":"DataBitsReq","paragraph_zero_based":442},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-DataBitAssistance; otherwise it is not present.","paragraph_zero_based":443},{"literal_text_all_w_t_and_m_t":"AcquAssistReq","paragraph_zero_based":444},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device requests GNSS-AcquisitionAssistance; otherwise it is not present.","paragraph_zero_based":445},{"literal_text_all_w_t_and_m_t":"AlmanacReq","paragraph_zero_based":446},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if 