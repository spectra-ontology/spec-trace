{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCI-List information element","paragraph_zero_based":21984},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21985},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-START","paragraph_zero_based":21986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21987},{"literal_text_all_w_t_and_m_t":"PCI-List ::=                        SEQUENCE (SIZE (1..maxNrofCellMeas)) OF PhysCellId","paragraph_zero_based":21988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21989},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-LIST-STOP","paragraph_zero_based":21990},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21991},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21992},{"literal_text_all_w_t_and_m_t":"–PCI-Range","paragraph_zero_based":21993},{"literal_text_all_w_t_and_m_t":"The IE PCI-Range is used to encode either a single or a range of physical cell identities. The range is encoded by using a start value and by indicating the number of consecutive physical cell identities (including start) in the range. For fields comprising multiple occurrences of PCI-Range, the Network may configure overlapping ranges of physical cell identities.","paragraph_zero_based":21994},{"literal_text_all_w_t_and_m_t":"PCI-Range information element","paragraph_zero_based":21995},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21996},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-START","paragraph_zero_based":21997},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21998},{"literal_text_all_w_t_and_m_t":"PCI-Range ::=                       SEQUENCE {","paragraph_zero_based":21999},{"literal_text_all_w_t_and_m_t":"    start                               PhysCellId,","paragraph_zero_based":22000},{"literal_text_all_w_t_and_m_t":"    range                               ENUMERATED {n4, n8, n12, n16, n24, n32, n48, n64, n84,","paragraph_zero_based":22001},{"literal_text_all_w_t_and_m_t":"                                                    n96, n128, n168, n252, n504, n1008,spare1}                  OPTIONAL    -- Need S","paragraph_zero_based":22002},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22003},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22004},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGE-STOP","paragraph_zero_based":22005},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5140571f381b5771d81ba65616b13153ce2c2355954e12b980d66ea4f4cfd534","a50a02433c7da3218529197025b3830d38d0f8565f527e0f85714c44425d824a","f4189c8637167ac61a08a2dc5176c8d0e2aa0ed4c69e5f4578a98b7f10505fb6","4864a955f35ed4e9cb70bfd0af68502654d5073c86ef3bcb0dfa90cded4b773c","9e3c0af4cad8232b151f9b1b8615239b8a99555ef2778bd84bb5acf22ca40752","8e583b99fde76d503bc0f6f523c8315d73a24eaacd7aa4aa60581050d2e3162f","c19a28156c0b32a4383975e8aa339a4f6a4b0a52876d34043854f70b30951007","3260d6aa0baf9a3d7f016e93d914fab5e09efa4b33024611877724c06da326fd","fbf52cb90636a94164e7c358efd866cba9235c89b1459a0877a762586518085e","7056f04742a1a48971cda364c2ea4f1ef14d27becbac1ff77361e8c5d87f5058","20ac13a4cb8182d62afccd625d45bb7e2fd35ac3f36c9a1f3e7873a95f9eb692","628697ea4a188f5a6d22b5e6411ced3605164706d0500523a66fe09648c7b11e","7a302f1986341f6b4239c68dca711f139eff40449b8de80999a243a0f70c0ba2","b6f9176e245bfc433f5f0558ea23de55326d65b152a0befc739eea3ce94c5d1a","1fd57a63f332f690803b9a5ff0a542d836b312d727fe0ac0c3a8a0bd52ece08a","9235546daf4e70c45d895549a62976c5312f6f3eeaa07d39e762e387ac5cb3fe","ffae5650f11765cdbdec00164e81aa36a4a91cd6117ecd681b711117c783ad2f","61bd8591a9767f540de6fdfd6c26f9a5dd924c7ad4d6d9de830c15c15923e423","fab60b56719442bb82d1daf576ebdc7eef6f961864ef877c91c7bf497c6aa12d","21b5b95f0db4b711a10e6bec626dd118e7b6f66dc9f129e7c0f360a07b7f1e45","7020f714585c259764ee451890ce6c189f0b992b1a675acb8f96e4af1e3bd883","71315352ace99176e444751f02bb7aed46dccb8d1b2ef677bf8a6c31fd011f36","b2dc4f8d9f42e3030aad43d592f23f06bee81427ea228a3dd5fdddc7b6149f80","20e898a0587268120ea9717f349785499f8595aaa522de5179f87b61cdb963ae"],"paragraph_range_zero_based":[21984,22007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p21984"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCI-Range field descriptions","paragraph_zero_based":22008},{"literal_text_all_w_t_and_m_t":"range","paragraph_zero_based":22009},{"literal_text_all_w_t_and_m_t":"Indicates the number of physical cell identities in the range (including start). Value n4 corresponds with 4, value n8 corresponds with 8 and so on. The UE shall apply value 1 in case the field is absent, in which case only the physical cell identity value indicated by start applies.","paragraph_zero_based":22010},{"literal_text_all_w_t_and_m_t":"start","paragraph_zero_based":22011},{"literal_text_all_w_t_and_m_t":"Indicates the lowest physical cell identity in the range.","paragraph_zero_based":22012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22013},{"literal_text_all_w_t_and_m_t":"–PCI-RangeElement","paragraph_zero_based":22014},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeElement is used to define a PCI-Range as part of a list (e.g. AddMod list).","paragraph_zero_based":22015},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement information element","paragraph_zero_based":22016},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22017},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-START","paragraph_zero_based":22018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22019},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement ::=                SEQUENCE {","paragraph_zero_based":22020},{"literal_text_all_w_t_and_m_t":"    pci-RangeIndex                      PCI-RangeIndex,","paragraph_zero_based":22021},{"literal_text_all_w_t_and_m_t":"    pci-Range                           PCI-Range","paragraph_zero_based":22022},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22023},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22024},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-STOP","paragraph_zero_based":22025},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22027},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement field descriptions","paragraph_zero_based":22028},{"literal_text_all_w_t_and_m_t":"pci-Range","paragraph_zero_based":22029},{"literal_text_all_w_t_and_m_t":"Physical cell identity or a range of physical cell identities.","paragraph_zero_based":22030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["069f90f8ab0aee810e5a283b78882c919fa4ef85fa3c7702191747da9d3c1db8","31ec34cb3eaebf50a83318e1f75d0bf4e11f2dbfa9ee4172f1ef169ff59d8d09","12de81e6e161527f0c4b839425b46f0b99b1ca38b3634ab963156a5e6073f954","4b4ad49e24ee0e704bb6d44be57050cf0307b0ab9c77123bd26f9e8f98098a69","7add90ba92a82a65e3569777d09a55804218b9e2c3ed4f46532c41747798e826","1905f8e2287f47fa3f45453f9b55e11b639be1a556261721b60cde4d4fb02268","68cfd832b5e673eb85cd08f3ace7e85d926f92f70881a43d05e49d2009def435","7b36edde7b803c18ae2d846d4af251384ad4b7bfe852b0193e57a2d20a0168d1","9cf73423b4f7207d9df703fd97b454eca670cfe77e2ab524a7a6706fb9bf3acc","ac1770d736ad693ff35fa6746818321ff1aec48991b2b56b14be45066664fb2b","68c325c920a267d11bc6f088bcf87e1816cb136228aa6b440afb534c98392b9e","579a63bc410b4ae187038a3b4f33206f432b15c47aa37b83f2fba956e2a053c0","759f177f68c0d7fa303cb3af30fe9a109fcbdae7e7659bd751a15dad9828c522","efd0a645f2d58dd60de4541969549998655e9d9b9023c8b6b8ddc3f50104e177","0da7520f4ae4a34c62e364993dc037ef7431a8888bc305eb2a5bad2692d21a70","120d35b8d4e6df113a044e76686a3908e24dfc18b69b