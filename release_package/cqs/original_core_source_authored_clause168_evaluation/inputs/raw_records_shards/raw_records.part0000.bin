ndication is needed for gNB capability of supporting U2U Relay.","paragraph_zero_based":2291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2292},{"literal_text_all_w_t_and_m_t":"SL-ConfigCommonNR-r16 ::=        SEQUENCE {","paragraph_zero_based":2293},{"literal_text_all_w_t_and_m_t":"    sl-FreqInfoList-r16                  SEQUENCE (SIZE (1..maxNrofFreqSL-r16)) OF SL-FreqConfigCommon-r16      OPTIONAL,    -- Need R","paragraph_zero_based":2294},{"literal_text_all_w_t_and_m_t":"    sl-UE-SelectedConfig-r16             SL-UE-SelectedConfig-r16                                               OPTIONAL,    -- Need R","paragraph_zero_based":2295},{"literal_text_all_w_t_and_m_t":"    sl-NR-AnchorCarrierFreqList-r16      SL-NR-AnchorCarrierFreqList-r16                                        OPTIONAL,    -- Need R","paragraph_zero_based":2296},{"literal_text_all_w_t_and_m_t":"    sl-EUTRA-AnchorCarrierFreqList-r16   SL-EUTRA-AnchorCarrierFreqList-r16                                     OPTIONAL,    -- Need R","paragraph_zero_based":2297},{"literal_text_all_w_t_and_m_t":"    sl-RadioBearerConfigList-r16         SEQUENCE (SIZE (1..maxNrofSLRB-r16)) OF SL-RadioBearerConfig-r16       OPTIONAL,    -- Need R","paragraph_zero_based":2298},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigList-r16          SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-RLC-BearerConfig-r16         OPTIONAL,    -- Need R","paragraph_zero_based":2299},{"literal_text_all_w_t_and_m_t":"    sl-MeasConfigCommon-r16              SL-MeasConfigCommon-r16                                                OPTIONAL,    -- Need R","paragraph_zero_based":2300},{"literal_text_all_w_t_and_m_t":"    sl-CSI-Acquisition-r16               ENUMERATED {enabled}                                                   OPTIONAL,    -- Need R","paragraph_zero_based":2301},{"literal_text_all_w_t_and_m_t":"    sl-OffsetDFN-r16                     INTEGER (1..1000)                                                      OPTIONAL,    -- Need R","paragraph_zero_based":2302},{"literal_text_all_w_t_and_m_t":"    t400-r16                             ENUMERATED {ms100, ms200, ms300, ms400, ms600, ms1000, ms1500, ms2000} OPTIONAL,    -- Need R","paragraph_zero_based":2303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["61e938d2013d287f01107ac0b62e9904ffc376f37b30811b164819889ba1d17e","ae0b0948c729433f7dc9fdc0c08c09cf4f580391a4d7ee4ac0c23a9b55e5c3a0","f940cfc250576d401ed95a8d5e972ec3188c8747b135e7976669bcca4f9071bd","3e50c5aa9c674873fcc08be0a21cbf45e97b6cce579bb7d7b821e2814b803119","49fc9804e7ca56198e5167e5eb3d159e13a5079f9e36b16a67cdc2a3a2a58129","5f6bc9d41566c5a30bc50c6db8c0d9d25615eb2bce73975af2cd4c0793501312","e61e873879052c469a3ad66eee7bfc1dbd3fdb5bdd8244d0bfda45117971e93a","46ee7a556ea32c4b1901da14c76313b892e4e12426225908623090af5b65c64c","1de0d2394dca0e1686b44db30783ffcb4b97985a8063cb0af643a6720a86e4e6","343a36a1f4504054cd91c2f82fa8aaa57bafc9551e0562d4f0f2e75afdaea733","89484bae85847788761299757b2db7b23975f51f70a8aab01bd6a84bfdd790cb","c6467822f94aa5ae99f3a6ffa30c8f324c71b89dc87708cae1939c18de140cfc","fe7ad6804890f69ab2701ad0d93fcbd75209ef91759c7b0e0867e9fd5ff46929","75b2802f6f7e6a6234dc6c51542ba4ba30f4a5e99aa63bf53155ea0a272c0c49","f36c7c21137e44204e3c806c2828cb18dc87d281de77620583221e9a5c106d64","41fc0f0f220e03c2d1c3c9a31ee424465d0e8778cc6fc6bb00d6e90a4b9bd064","96749cc48fce022b5d37355f3272cd62a2f5eecbdf82acc33a718810f367c3d1","42ee7b1261678b9a73c7bd62b164c9f5460732931af524826223f69b9db772cb","0c8899656fa056d7c6c31de30c2707cb9a907976af59b3eb0aa890d73dae81cb","a6d20feba9c723df5aaaf5238b47b533584c2b6f11db71313b32b1463156f4ab","aa757c94d6d95d70740996f966aee59aa022d33ff4f89aff3181c6edcb402