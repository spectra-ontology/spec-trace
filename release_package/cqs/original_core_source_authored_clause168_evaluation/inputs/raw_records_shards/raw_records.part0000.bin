{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21336},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-IntraFreqList-r17 ::= SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForNCSG-IntraFreq-r17","paragraph_zero_based":21337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21338},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-BandListNR-r17 ::=    SEQUENCE (SIZE (1..maxBands)) OF NeedForNCSG-NR-r17","paragraph_zero_based":21339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21340},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-IntraFreq-r17  ::=    SEQUENCE {","paragraph_zero_based":21341},{"literal_text_all_w_t_and_m_t":"    servCellId-r17                    ServCellIndex,","paragraph_zero_based":21342},{"literal_text_all_w_t_and_m_t":"    gapIndicationIntra-r17            ENUMERATED {gap, ncsg, nogap-noncsg}","paragraph_zero_based":21343},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21345},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-NR-r17  ::=           SEQUENCE {","paragraph_zero_based":21346},{"literal_text_all_w_t_and_m_t":"    bandNR-r17                        FreqBandIndicatorNR,","paragraph_zero_based":21347},{"literal_text_all_w_t_and_m_t":"    gapIndication-r17                 ENUMERATED {gap, ncsg, nogap-noncsg}","paragraph_zero_based":21348},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21350},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-STOP","paragraph_zero_based":21351},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21353},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR field descriptions","paragraph_zero_based":21354},{"literal_text_all_w_t_and_m_t":"intraFreq-needForNCSG","paragraph_zero_based":21355},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for NR intra-frequency measurement.","paragraph_zero_based":21356},{"literal_text_all_w_t_and_m_t":"interFreq-needForNCSG","paragraph_zero_based":21357},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for NR inter-frequency measurement.","paragraph_zero_based":21358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ad5b53229181d12ce1c0eea3c708d66af866cd0d187024fa46f83b3a3d066096","eca5968adf87acff60702f49c240bb82fa2f0a6961447a96a5c486074b63561c","98cf8b80e78a180d9d28e2914ea1457c69b649dc4eed7c56e06dbca842f8f0cb","47deaf41a42852464845cbe10b52a93c14c6c6504e83c467b8ac09ad2326395b","3cdd6aa11633f77c05b9a5321e303e089f1b1b64f3f969b21261e36907e0e62a","4f012ed21524ff5630c0c0c0ee877bd1f15e0ef798dfbea689f072c21ea4054a","c90af31b4b5af68193fa5f434f15522d442847166326d5affb8ae2b479b5bddf","6d1bf79a3386957e03ad9807b69f50f60398f036c880612c567cfc1904f6f5d9","953971212253c045d82dd583bb0746c7b4bbe3d3a7670f97e7dcaeb1e7c25128","dee5cd590969242580bcfac495b88f16377c246606c9737d8463fd8bc4ccd6bb","c831d44bb23619a34a245e5017cc888ac454198d671327ed8ba8e39f0e49ca5a","b9b18092bc440006a2c64851a0948fe21111a20ab056163ba67164b34ab4bf91","f0b6f49ce7f14ff15ad407ad8aadfa5c187383394107f1b02329cb60ee953008","1bf67c0fdd615859dfa20423400fca17904b4c1d43a98742354ae49faeb9a18c","f9150052c65bd3dcc2b45bea3d14096422ee96374edc3bf277a4b37b101448d2","ee9cbdfaae08206a6d6350c2b75075dfc7e510b8c568a19806d820b403dda061","372854581a5f119ff49dcea8401251f4e166ac9f3c2baea5aa7f25f57ed54284","44948f3f66b0f997e4f8c3ab1210f0d56b6f2928f75712838d19d823ec1f0b1a","31b4479a669cc07db5d9cfa29475c44e4f4d136b2968d0650035082814cf2b09","297f6fe1c1d5d8cd9440a8a85673c8178b259e99c5781c495981833ead72c550","80a1ba4943e3b07f8f1656c9614849bf0e36155ee84bea80cefb5660946339a9","05245b0328dd26abea6e2ea6804b42187277559ee9c7b6633452289a94e3614f","69c79d8879f6411d9dfc64817324c1dc2bae8289f0aa6212604e1c21d08bbffc","275440cc14372bce9d6570ef080c91cad78ee5036c10a940351d366b492eb03a"],"paragraph_range_zero_based":[21336,21359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p21336"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NeedForNCSG-IntraFreq field descriptions","paragraph_zero_based":21360},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":21361},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured.","paragraph_zero_based":21362},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":21363},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value ncsg indicates that a NCSG is needed if any of the UE configured BWPs do not contain the frequency domain resources of the SSB associated to the initial DL BWP. Value nogap-noncsg indicates that neither a measurement gap nor a NCSG is needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not.","paragraph_zero_based":21364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21365},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-NR field descriptions","paragraph_zero_based":21366},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":21367},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":21368},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":21369},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that a NCSG is needed, and value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed. ","paragraph_zero_based":21370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21371},{"literal_text_all_w_t_and_m_t":"–NextHopChainingCount","paragraph_zero_based":21372},{"literal_text_all_w_t_and_m_t":"The IE NextHopChainingCount is used to update the KgNB key and corresponds to parameter NCC: See TS 33.501 [11].","paragraph_zero_based":21373},{"literal_text_all_w_t_and_m_t":"NextHopChainingCount information element","paragraph_zero_based":21374},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21375},{"literal_text_all_w_t_and_m_t":"-- TAG-NEXTHOPCHAININGCOUNT-START","paragraph_zero_based":21376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21377},{"literal_text_all_w_t_and_m_t":"NextHopChainingCount ::=                    INTEGER (0..7)","paragraph_zero_based":21378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21379},{"literal_text_all_w_t_and_m_t":"-- TAG-NEXTHOPCHAININGCOUNT-STOP","paragraph_zero_based":21380},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21382},{"literal_text_all_w_t_and_m_t":"–NG-5G-S-TMSI","paragraph_zero_based":21383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f