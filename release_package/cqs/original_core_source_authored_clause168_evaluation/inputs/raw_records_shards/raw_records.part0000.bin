xt_all_w_t_and_m_t":"    ue-MeasurementsAvailable-r16                UE-MeasurementsAvailable-r16                                            OPTIONAL,","paragraph_zero_based":2198},{"literal_text_all_w_t_and_m_t":"    needForGapsInfoNR-r16                       NeedForGapsInfoNR-r16                                                   OPTIONAL,","paragraph_zero_based":2199},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1640-IEs                                    OPTIONAL","paragraph_zero_based":2200},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2202},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete-v1640-IEs ::=    SEQUENCE {","paragraph_zero_based":2203},{"literal_text_all_w_t_and_m_t":"    uplinkTxDirectCurrentTwoCarrierList-r16     UplinkTxDirectCurrentTwoCarrierList-r16                                 OPTIONAL,","paragraph_zero_based":2204},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        RRCReconfigurationComplete-v1700-IEs                                    OPTIONAL","paragraph_zero_based":2205},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["709b387bed1f4a943b4e311a5ced5d304348d1704a41d695b4b8b7bccbc9d206","82be1130af6c8d960c0210ea53f659038392643642db2bce48e68854650d048c","2f5e62033a793c6b5f0f456013f821b291c20ebbc6df244186abe5d4d63722c5","6b6b2a262f47fb629886b39d136353a786601885683c1d666e9395bc87cea69e","ba42c5bf99bef17545ce9e40b1b0317cbaff6786677c96dc38d