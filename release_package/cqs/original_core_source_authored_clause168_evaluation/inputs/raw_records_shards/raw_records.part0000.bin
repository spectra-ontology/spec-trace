},{"literal_text_all_w_t_and_m_t":"    prs-ProcessingCapabilityOutsideMGinPPW-r17    SEQUENCE (SIZE(1..3)) OF PRS-ProcessingCapabilityOutsideMGinPPWperType-r17   OPTIONAL,","paragraph_zero_based":35363},{"literal_text_all_w_t_and_m_t":"    -- R1 27-15a: Positioning SRS transmission in RRC_INACTIVE state for initial UL BWP with semi-persistent SRS","paragraph_zero_based":35364},{"literal_text_all_w_t_and_m_t":"    srs-SemiPersistent-PosResourcesRRC-Inactive-r17                 SEQUENCE {","paragraph_zero_based":35365},{"literal_text_all_w_t_and_m_t":"        maxNumOfSemiPersistentSRSposResources-r17                       ENUMERATED {n1, n2, n4, n8, n16, n32, n64},","paragraph_zero_based":35366},{"literal_text_all_w_t_and_m_t":"        maxNumOfSemiPersistentSRSposResourcesPerSlot-r17                ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10, n12, n14}","paragraph_zero_based":35367},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                          OPTIONAL,","paragraph_zero_based":35368},{"literal_text_all_w_t_and_m_t":"    -- R2: UE support of CBW for 120kHz SCS","paragraph_zero_based":35369},{"literal_text_all_w_t_and_m_t":"    channelBWs-DL-SCS-120kHz-FR2-2-r17                              BIT STRING (SIZE (8))                                      OPTIONAL,","paragraph_zero_based":35370},{"literal_text_all_w_t_and_m_t":"    channelBWs-UL-SCS-120kHz-FR2-2-r17                              BIT STRING (SIZE (8))                                      OPTIONAL","paragraph_zero_based":35371},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":35372},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35373},{"literal_text_all_w_t_and_m_t":"    -- R1 30-4a: DM-RS bundling for PUSCH repetition type A","paragraph_zero_based":35374},{"literal_text_all_w_t_and_m_t":"    dmrs-BundlingPUSCH-RepTypeA-r17                                 ENUMERATED {supported}      