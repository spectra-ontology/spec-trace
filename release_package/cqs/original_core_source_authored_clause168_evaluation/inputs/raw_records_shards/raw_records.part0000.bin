{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-Config information element","paragraph_zero_based":22056},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22057},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-START","paragraph_zero_based":22058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22059},{"literal_text_all_w_t_and_m_t":"PDCCH-Config ::=                    SEQUENCE {","paragraph_zero_based":22060},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModList      SEQUENCE(SIZE (1..3)) OF ControlResourceSet                      OPTIONAL,   -- Need N","paragraph_zero_based":22061},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseList     SEQUENCE(SIZE (1..3)) OF ControlResourceSetId                    OPTIONAL,   -- Need N","paragraph_zero_based":22062},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModList            SEQUENCE(SIZE (1..10)) OF SearchSpace                            OPTIONAL,   -- Need N","paragraph_zero_based":22063},{"literal_text_all_w_t_and_m_t":"    searchSpacesToReleaseList           SEQUENCE(SIZE (1..10)) OF SearchSpaceId                          OPTIONAL,   -- Need N","paragraph_zero_based":22064},{"literal_text_all_w_t_and_m_t":"    downlinkPreemption                  SetupRelease { DownlinkPreemption }                              OPTIONAL,   -- Need M","paragraph_zero_based":22065},{"literal_text_all_w_t_and_m_t":"    tpc-PUSCH                           SetupRelease { PUSCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":22066},{"literal_text_all_w_t_and_m_t":"    tpc-PUCCH                           SetupRelease { PUCCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":22067},{"literal_text_all_w_t_and_m_t":"    tpc-SRS                             SetupRelease { SRS-TPC-CommandConfig}                            OPTIONAL,   -- Need M","paragraph_zero_based":22068},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22069},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22070},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModListSizeExt-v1610 SEQUENCE (SIZE (1..2)) OF ControlResourceSet             OPTIONAL,   -- Need N","paragraph_zero_based":22071},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseListSizeExt-r16 SEQUENCE (SIZE (1..5)) OF ControlResourceSetId-r16        OPTIONAL,   -- Need N","paragraph_zero_based":22072},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-r16     SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-r16                     OPTIONAL,   -- Need N","paragraph_zero_based":22073},{"literal_text_all_w_t_and_m_t":"    uplinkCancellation-r16              SetupRelease { UplinkCancellation-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":22074},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-r16      ENUMERATED { r15monitoringcapability,r16monitoringcapability }   OPTIONAL,   -- Need M","paragraph_zero_based":22075},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r16         SearchSpaceSwitchConfig-r16                                      OPTIONAL    -- Need R","paragraph_zero_based":22076},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22077},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22078},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1700   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1700                   OPTIONAL,   -- Need N","paragraph_zero_based":22079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_m