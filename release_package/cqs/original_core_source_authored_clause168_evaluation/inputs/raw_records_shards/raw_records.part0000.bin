{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mp.","paragraph_zero_based":5448},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":5449},{"literal_text_all_w_t_and_m_t":"Ms, Hys2, Thresh3 are expressed in meters.","paragraph_zero_based":5450},{"literal_text_all_w_t_and_m_t":"5.5.5Measurement reporting","paragraph_zero_based":5451},{"literal_text_all_w_t_and_m_t":"5.5.5.1General","paragraph_zero_based":5452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5453},{"literal_text_all_w_t_and_m_t":"Figure 5.5.5.1-1: Measurement reporting","paragraph_zero_based":5454},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer measurement results from the UE to the network. The UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":5455},{"literal_text_all_w_t_and_m_t":"For the measId for which the measurement reporting procedure was triggered, the UE shall set the measResults within the MeasurementReport message as follows:","paragraph_zero_based":5456},{"literal_text_all_w_t_and_m_t":"1>set the measId to the measurement identity that triggered the measurement reporting;","paragraph_zero_based":5457},{"literal_text_all_w_t_and_m_t":"1>for each serving cell configured with servingCellMO:","paragraph_zero_based":5458},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with the measId that triggered the measurement reporting includes rsType:","paragraph_zero_based":5459},{"literal_text_all_w_t_and_m_t":"3>if the serving cell measurements based on the rsType included in the reportConfig that triggered the measurement report are available:","paragraph_zero_based":5460},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on the rsType included in the reportConfig that triggered the measurement report;","paragraph_zero_based":5461},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5462},{"literal_text_all_w_t_and_m_t":"3>if SSB based serving cell measurements are available:","paragraph_zero_based":5463},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on SSB;","paragraph_zero_based":5464},{"literal_text_all_w_t_and_m_t":"3>else if CSI-RS based serving cell measurements are available:","paragraph_zero_based":5465},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell within measResultServingMOList to include RSRP, RSRQ and the available SINR of the serving cell, derived based on CSI-RS;","paragraph_zero_based":5466},{"literal_text_all_w_t_and_m_t":"1>set the servCellId within measResultServingMOList to include each NR serving cell that is configured with servingCellMO, if any;","paragraph_zero_based":5467},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5468},{"literal_text_all_w_t_and_m_t":"2>for each serving cell configured with servingCellMO, include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":5469},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":5470},{"literal_text_all_w_t_and_m_t":"2>for each measObjectId referenced in the measIdList which is also referenced with servingCellMO, other than the measObjectId corresponding with the measId that triggered the measurement reporting:","paragraph_zero_based":5471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["59e6d2679c42a69ada208ca2279dd8ac3e375c7f8beba23ad8fcf9cd250822d0","9abd9aaa0416379f6900622c6dc6af9106a33b2aa474461b006e8a7c99faebb3","1e45632f82791c5ab4625c7d2a63ed4ecbc6e05c4bdb6981a9da553f5d70033a","24ac0b5e9ed38134c88690e8c72ff13347cbe4430066882bb4477f42a0aab143","de098611673662d1ead94f187548fb894773f772e47e72aa0ed7019285f78aed","6442861e4ebe68404a13d78f4df84f13a11209d51e73c6d13eb2e78f3b1ffdd1","77400c3e40a2ba50734d50d0d1ab5fafc48a32258597a9b4945333b774ee1f73","386385085b889ec809d3423d0e84f0c86bd4d27f1b3fd4dcc5d33042302d6f9e","2551541068cc8146bc4ee310d08906bb9d333384e5e7853217246c5d6443280a","75dcff669cf571da4cc0fd45c872a1e2e6d507dffae47fa63a18da9a4f31821b","2521dc7d572f57ca9fd327aaf960d2de77de471c64a87d06131235b33fa54fde","53e6fb68ade67697bbebd0b346825088876238fbd3adb44d0761492182e16b31","52f7e5edc960d7d96ce178b121bc88d81772af973ae8867c7a3e5b59e30f18e2","a86e4a6dbe5dacb7daf95aca7a01013cf69dd9a29781bf94fa838c87b4de0b32","f62976445f74995335f112f2e4c220b542dda308a95a599cc423aeab7ec57eca","ce037e01102c443375c59cb76b70cf5ebd792d5ffba98d717c894de5d24bcab2","5bbc3c8113771d668ec1e20136f823cd586cae678f1cc3bda81878f999965d52","e4952f147b17db91f83a7964f6467cc901f94319aef749a7955200c7f4d23ecb","4db71b09e14f87cce71cb65c4972293c26547a7ab3fa67268da352139d0d89bf","9df555b2f922a496e3b79009e179fa80e3729ebe27398fa1bf10a534664baa36","ea753ff4b732871242f440a2bf3ecda70a773a2bb7b70a984f795e4ed2e53e64","5172e7495998f2d8b64320706456660db32644cd1b33a1a9b745ba3d6247bd13","88b0872b0cd2f6063b08862c82ceb345f0393294da353e861b2ee770efb52932","34a95513cfa45ccce7f2cc6e2a599a37ad1e5358b2d1712343eff1e3b1c48b02"],"paragraph_range_zero_based":[5448,5471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5448"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if the measObjectNR indicated by the servingCellMO includes the RS resource configuration corresponding to the rsType indicated in the reportConfig:","paragraph_zero_based":5472},{"literal_text_all_w_t_and_m_t":"4>set the measResultBestNeighCell within measResultServingMOList to include the physCellId and the available measurement quantities based on the reportQuantityCell and rsType indicated in reportConfig of the non-serving cell corresponding to the concerned measObjectNR with the highest measured RSRP if RSRP measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured RSRQ if RSRQ measurement results are available for cells corresponding to this measObjectNR, otherwise with the highest measured SINR;","paragraph_zero_based":5473},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5474},{"literal_text_all_w_t_and_m_t":"5>for each best non-serving cell included in the measurement report:","paragraph_zero_based":5475},{"literal_text_all_w_t_and_m_t":"6>include beam measurement information according to the associated reportConfig as described in 5.5.5.2;","paragraph_zero_based":5476},{"literal_text_all_w_t_and_m_t":"1>if the reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5, or eventB1, or eventB2, or eventA3H1, or eventA3H2, or eventA4H1, or eventA4H2, or eventA5H1, or eventA5H2:","paragraph_zero_based":5477},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NE-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":5478},{"literal_text_all_w_t_and_m_t":"3>set the measResultServFreqListEUTRA-SCG to include an entry for each E-UTRA SCG serving frequency with the following:","paragraph_zero_based":5479},{"literal_text_all_w_t_and_m_t":"4>include carrierFreq of the E-UTRA serving frequency;","paragraph_zero_based":5480},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the available measurement quantities that the UE is configured to measure by the measurement configuration associated with the SCG;","paragraph_zero_based":5481},{"literal_text_all_w_t_and_m_t":"4>if reportConfig associated with the measId that triggered the measurement reporting includes reportAddNeighMeas:","paragraph_zero_based":5482},{"literal_text_all_w_t_and_m_t":"5>set the measResultServFreqListEUTRA-SCG to include within measResultBestNeighCell the quantities of the best non-serving cell, based on RSRP, on the concerned serving frequency;","paragraph_zero_based":5483},{"literal_text_all_w_t_and_m_t":"1>if reportConfig associated with the measId that triggered the measurement reporting is set to eventTriggered and eventID is set to eventA3, or eventA4, or eventA5, or eventA3H1, or eventA3H2, or eventA4H1, or eventA4H2, or eventA5H1, or eventA5H2:","paragraph_zero_based":5484},{"literal_text_all_w_t_and_m_t":"2>if the UE is in NR-DC and the measurement configuration that triggered this measurement report is associated with the MCG:","paragraph_zero_based":5485},{"literal_text_all_w_t_and_m_t":"3>set the measResultServFreqListNR-SCG to include for each NR SCG serving cell that is configured with servingCellMO, if any, the following:","paragraph_zero_based":5486},{"literal_text_all_w_t_and_m_t":"4>if the reportConfig associated with the measId that triggered the measurement reporting includes rsType:","paragraph_zero_based":5487},{"literal_text_all_w_t_and_m_t":"5>if the serving cell measurements based on the rsType included in the reportConfig that triggered the measurement report are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5488},{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on the rsType included in the reportConfig that triggered the measurement report;","paragraph_zero_based":5489},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5490},{"literal_text_all_w_t_and_m_t":"5>if SSB based serving cell measurements are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5491},{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on SSB;","paragraph_zero_based":5492},{"literal_text_all_w_t_and_m_t":"5>else if CSI-RS based serving cell measurements are available according to the measurement configuration associated with the SCG:","paragraph_zero_based":5493},{"literal_text_all_w_t_and_m_t":"6>set the measResultServingCell within measResultServFreqListNR-SCG to include RSRP, RSRQ and the available SINR of the serving cell, derived based on CSI-RS;","paragraph_zero_based":5494},{"literal_text_all_w_t_and_m_t":"4>if results for the serving cell derived based on SSB are included:","paragraph_zero_based":5495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fc262df2e2c0fa0996ad8fa02adc6a94676029311ea5829b37d8609e03c831da","e61c005595041e7db4d7e9685bbfeb5a42190ac0ff2e717c10d817883fef3141","b8e4b807f956e79c5b35bb694fff9a169