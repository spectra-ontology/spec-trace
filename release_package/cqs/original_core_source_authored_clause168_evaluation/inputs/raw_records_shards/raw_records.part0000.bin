{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication about whether the criterion for RRM relaxation for connected mode is fulfilled or not fulfilled:","paragraph_zero_based":6360},{"literal_text_all_w_t_and_m_t":"2>if the criterion for RRM measurement relaxation for connected mode is fulfilled:","paragraph_zero_based":6361},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to true;","paragraph_zero_based":6362},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6363},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to false.","paragraph_zero_based":6364},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the service link propagation delay difference between serving cell and neighbour cell(s) according to 5.7.4.2;","paragraph_zero_based":6365},{"literal_text_all_w_t_and_m_t":"2>include the propagationDelayDifference for each neighbour cell in the neighCellInfoList;","paragraph_zero_based":6366},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message for configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6367},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink communication:","paragraph_zero_based":6368},{"literal_text_all_w_t_and_m_t":"2>include the sl-UE-AssistanceInformationNR;","paragraph_zero_based":6369},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is up to UE implementation when and how to trigger configured grant assistance information for NR sidelink communication.","paragraph_zero_based":6370},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6371},{"literal_text_all_w_t_and_m_t":"1>if the procedure was triggered to provide configured grant assistance information for NR sidelink communication by an NR RRCReconfiguration message that was embedded within an E-UTRA RRCConnectionReconfiguration:","paragraph_zero_based":6372},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation to lower layers via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified in TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":6373},{"literal_text_all_w_t_and_m_t":"1>else if the procedure was triggered to provide UE preference for SCG deactivation or to indicate that the UE with a deactivate SCG has uplink data to send on a DRB for which there is no MCG RLC bearer:","paragraph_zero_based":6374},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation via SRB1 to lower layers for transmission;","paragraph_zero_based":6375},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":6376},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6377},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":6378},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6379},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via the E-UTRA MCG embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":6380},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":6381},{"literal_text_all_w_t_and_m_t":"2>if the UE assistance configuration that triggered this UE assistance information is associated with the SCG:","paragraph_zero_based":6382},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["01ca6521f3ed0e09408405e98fe9dd6da1ac1e31f8349e41e021baffa095f8c9","214ca1b794bfcf880a207d9e17428891a40353409bed90a88b6862385793d1fa","e93f0ee1dbbea9ced8fa351f0ab792df948e5927b6eb6015a7bedfc5ebeadc9b","afed2b2b0555b1e9a361c1396cfaef4e55e7c60cc1bac637cb050071fabf0e38","5a7d4a7facd6c33e11ed4a9878891789ab17dd0e2152f83464be51323e82e456","9024195cc2c79ba8aa3967b32bc56c1a22f7b2f4c7e597c70327b6b3bec194b7","ba4c7988bb9a6572db67c98abc107890afaee6eab56987c6cd7c71f0f9bc8edf","23f9f67f3febf19bad7f128b79f4b3a5262123eac6f929eee0f46067cb63f401","439a778ee27ed47ce86242cff0896bd8d5bf4d89c9ff20e252110028ddcc546e","5150da0a7caa66c34e03b33edde72e3f63c3b67154c13b315cc1c905b25ac4e9","5033c1cfff2825c1b60da3f779b5a0929b5969eb4f4c2da9017ea0b8129a0031","1219dc90c82deb54068de28ebd02b6abbea020b2751532604a16dbf5bf0ab8e1","072ed19ce5edf6e39e455b9e95ac2e6bdac0c0f8bebc61666f60d7fb1ba8f400","2ecfca92d0690c786b210be5994eec4c73dec3fdab3a3e1d7ad6ebf1feb38908","a6587787b0bf49988b128cc3b167eb96017efe4ab8e6d94a96d27c1d789f0341","21c269ca6849bba38d75ecb5439db12131a94e0e1a679790ea90a798e0e20eec","513d727c351d29c80083a920987c03f3f42732388aedfcec746416b7ffb778bb","a3363b19fe7cdebe2825101f199211aff404c64807f37973e5ae0d95f63667db","ddd2135d0e9adbf38f1db9a90f2a5a2a973d906dbfe92ffc130d21e5ec5cd242","f1069e4cf9287b78ad48fb1f3bf76e736704a2ed9ee3e4d1cde3def881943203","f29498a0d8626cdfe34767bc3b8726a72fbbf5ee636124da26d3ec9f44c3f7e5","a668327edbaf804798316c9e49557bbb7f88f0bb0f49ea5c321ba150bdc56c69","e28160602d9b887043eac9d4083ac3e2e38f5668b297d693e0987161be5faebe","7197d601c7450e03784d19d651e50a30372fc17d4f94c95102283f87b5c44647"],"paragraph_range_zero_based":[6360,6383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6360"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":6384},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6385},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via the NR MCG embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":6386},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6387},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB1 to lower layers for transmission;","paragraph_zero_based":6388},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6389},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":6390},{"literal_text_all_w_t_and_m_t":"5.7.4.3aSetting the contents of OverheatingAssistance IE","paragraph_zero_based":6391},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of OverheatingAssistance IE if initiated to provide overheating assistance indication for SCG in (NG)EN-DC according to clause 5.6.10.3 as specified in TS 36.331 [10]:","paragraph_zero_based":6392},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum secondary component carriers for SCG:","paragraph_zero_based":6393},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":6394},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsDL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6395},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsUL to the number of maximum SCells of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6396},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1 for SCG:","paragraph_zero_based":6397},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":6398},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1 of the SCG;","paragraph_zero_based":6399},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1 of the SCG;","paragraph_zero_based":6400},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1 for SCG:","paragraph_zero_based":6401},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":6402},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1 of the SCG;","paragraph_zero_based":6403},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1 of the SCG;","paragraph_zero_based":6404},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2 for SCG:","paragraph_zero_based":6405},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6406},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2 of the SCG;","paragraph_zero_based":6407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["c006989f68cbe67e5d355b246f41753de393fd11ae7450be05a72ec16abf1af4","18464e8efa9e7a1efebb29c672515e44fe3c65f7e14a18a9905d43e17d114697","cef6ea51eec28d4cfa737e55e022364cbbc8969e5dc9958ef5a43ec7a6f0cef2","e74f99abfaf548e754bfef158eaf3de685753302c3e77937be1f84a1300817ab","177436125a42fdea4384152d7648af129dee97997a4372b24773258be374b28b","9c1634aab7432258a8dca7343dd65ad7aa038a6c7ad95d28068726609b95b007","f268fffc46c18d754bd03284149ba68a45c2d5b9a53a081f5a72afde28d16058","03aac78429fc29ed53cba8189a43b44e7ea2f46af268a0c24d0c3ccaa6fd59b9","75628b4b35bf7a46d8edd40dd48e68d7a096e44dd3cfe9778cc9f2463b31eeda","983e6f3138460acaff1f0c12cfa5b1b0ad8eb22bf03ee4c3bf5c50c1f4b79d20","03fb085b9b6d1083206cb3333752eb0aea78b1c5511eeef41adc881c4efe0489","e84bd18d0f76282366a4ed6441deaea8b4c6228722d15d16594971eae20c6123","81994ec9628563dd84d22515ca41fa355fa3a9654e9976e8a3d86fb18bb10dae","f9c00259d7617b3f42b83c5ac193bf3dfed1c1168184b09590e96947c5530489","001db8318b58313e11803c0a7caec064ab5f57246993d7adf8bd4eb633b1cdee","c166d49531a574ebb93df4f43d8365c140b1f39f90fce3902c01c98226dc6e42","f8c78a0a4b2bd601c4e70423e7b03329e63d3b88cdf7b45db350e98c5d68d1da","65688b740dbaeb039bbdee7dcb3259a83ef3c08b85652b10f27c4af648cd97ba","4d5c76aef1a5805c35c41a9a8e71bdecd1ef2628ec9c0c4b675cf226150cdd94","125cf03013313049fcf88a9e9e55b2aa1e50395a735bd0e747d6eb5e0e539ece","04b77d1d21338c9d7afdc14be3292e6ca9481a3f5d528eeee674620976b82f5d","433b9f02e2a9fabf6ba84cc2164ccba524c156858c25c117892a2d724f1e36e5","3b10b04e897256ba9513a4c124f3e947efed3535ccc6d48c83e6e17c108f1d4e","af89c37656a707845f7a6e52d1988521103ccee7685ca7e39a0128c28fd0c109"],"paragraph_range_zero_based":[6384,6407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6384"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2 of the SCG;","paragraph_zero_based":6408},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1 for SCG:","paragraph_zero_based":6409},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":6410},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6411},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6412},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1 for SCG:","paragraph_zero_based":6413},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":6414},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6415},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6416},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2 for SCG:","paragraph_zero_based":6417},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":6418},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-2 of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":6419},{"literal_text_all_w_t_and_m_t":"2>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-2 of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":6420},{"literal_text_all_w_t_and_m_t":"5.7.4.4Relaxed measurement criterion for a stationary RedCap UE","paragraph_zero_based":6421},{"literal_text_all_w_t_and_m_t":"The relaxed measurement criterion for a stationary UE is met when:","paragraph_zero_based":6422},{"literal_text_all_w_t_and_m_t":"-(SS-RSRPRefStationaryConnected – SS-RSRP) < SSearchDeltaP-StationaryConnected,","paragraph_zero_based":6423},{"literal_text_all_w_t_and_m_t":"Where:","paragraph_zero_based":6424},{"literal_text_all_w_t_and_m_t":"-SS-RSRP = current L3 RSRP measurement of the PCell based on SSB (dB).","paragraph_zero_based":6425},{"literal_text_all_w_t_and_m_t":"-SS-RSRPRefStationaryConnected = reference SS-RSRP value of the PCell (dB), set as follows:","paragraph_zero_based":6426},{"literal_text_all_w_t_and_m_t":"-at the end of RRC reconfiguration procedure as specified in 5.3.5.3, when rrm-MeasRelaxationReportingConfig is included in the RRCReconfiguration message; or","paragraph_zero_based":6427},{"literal_text_all_w_t_and_m_t":"-after MAC successfully completes a Random Access procedure after applying a reconfigurationWithSync in spCellConfig while stationary criterion is configured; or","paragraph_zero_based":6428},{"literal_text_all_w_t_and_m_t":"-if (SS-RSRP – SS-RSRPRefStationaryConnected) > 0; or","paragraph_zero_based":6429},{"literal_text_all_w_t_and_m_t":"-if the relaxed measurement criterion has not been met for TSearchDeltaP-StationaryConnected:","paragraph_zero_based":6430},{"literal_text_all_w_t_and_m_t":"-UE shall set the value of SS-RSRPRefStationaryConnected to the current SS-RSRP value of the serving cell.","paragraph_zero_based":6431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e2610beef4137af5a2feffd1959c6b8638a16c8792b235dae2a9ff94d39c4726","a85cb1e8aa2682a1f8566b36d987830ceb8ce87066ed35e6cce7482a18c2df23","167a65e5dffa21ca5a987f79e41932c4179175f9bc40dcb44d61e94d3a7df96d","6d6063540e474d1c22b540dc6244a3f63a7640ea02461e6a8a43d450513b52e5","41e99cae5154022d48da9769a6a0b1f0bd2134398c9ee51d277cc04e882af789","6d93fd36edbd4d4c04fbb69b49b40baecc419b7f2cd9e60e98d976f49dafd926","bf0ab62e94f5bd4dbf1a9d083fd190ca38b51eb6064317f3110a3c778ca83774","0bf41499e5b3867358559e4d64c9828cc600f3f1f2decec852c6a43000d6fcae","3f430b401ac7056cf75d426efdb7e4b0cc06534b32d0579632dc7a6e865ae471","b346d29eb7f02ea1c90d9060c160708e5f18941a91ac0665cce4ce2a335fbe6b","4c58a2dbba6a620e7fdec690b17d85f104593fbd7a0b31dced384e9dea69c00d","27338ed1670ef467f21883c9e5e42a3dbb1f5ba83c4254be8e3c794027e006d8","f4d90a6e0a4b56f15effd480794ae0b541c09758f041039b51de24f2a46ff178","a32e2434eed53867414941b884c8ec9831acb3e376d74c2f2aef457b37611260","3bce47523b6cecba530d0d4be7b8423a68905b6fc592382787011596cadb9613","69ac87220ebc340a34b06d59fa6e8a2f349fefb752776b829cd0a60b2436498a","c7942f32cc41812bf316da6dbe0b9b48b2f2b6256ccbf7b728a66c152aad1129","3ba285c721db5769df82d785571d32eba251dd1374c028ad5073d95adb0bcab6","210bd9790d75c0323afed0ac47e9a67bdee67ed7d1e2b477a782b8578a662c19","cef5319dd4c67caa2155248e4d6a068b138566d1b6b3ab8b6b3e9cb2254e2fd0","c0596f2f9ceea115a6a6580cadb9d97e0fc21d0501af04cf62b0f602f4c603cd","fe6469180859e53a2bfa051eecd5c104c41435608473e5c64ad8ff8127b540c7","2405dd34ed315fe2d0df245f63ca02423522e4c1d6a048c2e667411fba7457a5","0ebc023552a19a488f7230007f237871b8bef78e3354c405401b23abd0a05058"],"paragraph_range_zero_based":[6408,6431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6408"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.4aVoid","paragraph_zero_based":6432},{"literal_text_all_w_t_and_m_t":"5.7.5Failure information","paragraph_zero_based":6433},{"literal_text_all_w_t_and_m_t":"5.7.5.1General","paragraph_zero_based":6434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6435},{"literal_text_all_w_t_and_m_t":"Figure 5.7.5.1-1: Failure information","paragraph_zero_based":6436},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform the network about a failure detected by the UE.","paragraph_zero_based":6437},{"literal_text_all_w_t_and_m_t":"5.7.5.2Initiation","paragraph_zero_based":6438},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure when there is a need inform the network about a failure detected by the UE. In particular, the UE initiates the procedure when the following condition is met:","paragraph_zero_based":6439},{"literal_text_all_w_t_and_m_t":"1>upon detecting failure for an RLC bearer, in accordance with 5.3.10.3;","paragraph_zero_based":6440},{"literal_text_all_w_t_and_m_t":"1>upon detecting DAPS handover failure, in accordance with 5.3.5.8.3;","paragraph_zero_based":6441},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6442},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the FailureInformation message as specified in 5.7.5.3;","paragraph_zero_based":6443},{"literal_text_all_w_t_and_m_t":"5.7.5.3Actions related to transmission of FailureInformation message","paragraph_zero_based":6444},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6445},{"literal_text_all_w_t_and_m_t":"1>if initiated to provide RLC failure information, set FailureInfoRLC-Bearer as follows:","paragraph_zero_based":6446},{"literal_text_all_w_t_and_m_t":"2>set logicalChannelIdentity to the logical channel identity of the failing RLC bearer;","paragraph_zero_based":6447},{"literal_text_all_w_t_and_m_t":"2>set cellGroupId to the cell group identity of the failing RLC bearer;","paragraph_zero_based":6448},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-failure;","paragraph_zero_based":6449},{"literal_text_all_w_t_and_m_t":"1>if initiated to provide DAPS failure information, set FailureInfoDAPS as follows:","paragraph_zero_based":6450},{"literal_text_all_w_t_and_m_t":"2>set the failureType as daps-failure;","paragraph_zero_based":6451},{"literal_text_all_w_t_and_m_t":"1>if used to inform the network about a failure for an MCG RLC bearer or DAPS failure information:","paragraph_zero_based":6452},{"literal_text_all_w_t_and_m_t":"2>submit the FailureInformation message to lower layers for transmission via SRB1;","paragraph_zero_based":6453},{"literal_text_all_w_t_and_m_t":"1>else if used to inform the network about a failure for an SCG RLC bearer:","paragraph_zero_based":6454},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured;","paragraph_zero_based":6455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3083ebfd2ab284b9bdd7d1e007e42437c88167c6d5afcba3f2e6180213689311","5b37ea09cecd38e8112b85ba43bbff765e260964007adea62ca37d7780f82144","a8a41fe521e17bfee81734006387edc4b295a9954c2122dd4be2a63c514c9dd6","8a32c50b6262a6864262d013d6970dd36620cbba15fff7b74a8f709cfffffb5c","43c4d604962e9d74ccf1e93bf9b6867d4ab5fcb7de7cde9e9769f73d12fe444b","00cfd47ae4374be8b9eef69827805cd907d463c9ae7bc6099d76cc2e9a0ff85a","db60c8bf3bef65ec8900545d95b88ce10d952641e8a0fbc927f05a6377543791","d67d6b9603a1b2f8ffc8d84a9306aa2bf490af78008916876c7fe9eaa2610eca","22df959aff5dd669a768788dbeb3cd3114fbf6cdbe2124fab6df2a2e51877ad6","ec17e4558a471057e6d6b7dd86ceb63a379856df905ee0395d9f19f0aba04c18","6bdc2732df06f00d227eead37879029fee777ecc588ebb90ab3052366900f639","e3380ffe5c3b1336cfb1daabef5e67994c2ebff2b2053ec21cd2aaf3f19f8ab8","f87da1f2bf7acf91f48b0c2a80aee3ba55a7be633ecf73a7c645b1b7cd56a7fc","43c89b6d79a84ea464a8b19ecc096630cdfcbdc5feab41d8a45cbcf8dcd2074a","c3ff279cfd0e7687b42edc8ab23e323bed88943ec2ca7f666cbd0704879c0a0d","545114b49e9767b19af50c4825bba5b2a2d61a6dce36f09e151c0c1af50d6e3d","b52a56ffb4f8135d0429614f73d9bd87cb244b3e0fd4ac15706048ab5eedf5c8","c319f65c447ec7bc3ca3fb9ad579239e69116291d09b010a7d13271ce678651f","7913ae488a5fe4486df069751c2960fb21a3d20da91234a10a95b7081545afad","7c4dcc07039f040bb2e6523048a2d0be3489be687843c6ea4a73774092ee604f","66b8ba5afcb20daac5cec6982351d6d1bd1fee1bcb14ded86f995580e2e8020c","c9745db84ef94e538dc2e2fdeacea80fcb1423dd658b7fd4e0d0a1c57acf6e35","c61c9ed118ad283ffdacbc461281e7671d46b0db7a9a2c79b20ea13bf7b034e7","9c94d69abf562b26c4f1164255d4dbb952817b604d2c737b0c643c246e08604c"],"paragraph_range_zero_based":[6432,6455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6432"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>submit the FailureInformation message to lower layers for transmission via SRB3;","paragraph_zero_based":6456},{"literal_text_all_w_t_and_m_t":"2>else;","paragraph_zero_based":6457},{"literal_text_all_w_t_and_m_t":"3>if the UE is in (NG)EN-DC:","paragraph_zero_based":6458},{"literal_text_all_w_t_and_m_t":"4>submit the FailureInformation message via E-UTRA SRB1 embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":6459},{"literal_text_all_w_t_and_m_t":"3>else if the UE is in NR-DC:","paragraph_zero_based":6460},{"literal_text_all_w_t_and_m_t":"4>submit the FailureInformation message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in clause 5.7.2a.3.","paragraph_zero_based":6461},{"literal_text_all_w_t_and_m_t":"5.7.6DL message segment transfer","paragraph_zero_based":6462},{"literal_text_all_w_t_and_m_t":"5.7.6.1General","paragraph_zero_based":6463},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6464},{"literal_text_all_w_t_and_m_t":"Figure 5.7.6.1-1: DL message segment transfer","paragraph_zero_based":6465},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer segments of DL DCCH messages from the network to the UE.","paragraph_zero_based":6466},{"literal_text_all_w_t_and_m_t":"NOTE:The segmentation of DL DCCH message is only applicable to RRCReconfiguration and RRCResume messages in this release.","paragraph_zero_based":6467},{"literal_text_all_w_t_and_m_t":"5.7.6.2Initiation","paragraph_zero_based":6468},{"literal_text_all_w_t_and_m_t":"The network initiates the DL Dedicated Message Segment transfer procedure whenever the encoded RRC message PDU exceeds the maximum PDCP SDU size. The network initiates the DL Dedicated Message Segment transfer procedure by sending the DLDedicatedMessageSegment message.","paragraph_zero_based":6469},{"literal_text_all_w_t_and_m_t":"5.7.6.3Reception of DLDedicatedMessageSegment by the UE","paragraph_zero_based":6470},{"literal_text_all_w_t_and_m_t":"Upon receiving DLDedicatedMessageSegment message, the UE shall:","paragraph_zero_based":6471},{"literal_text_all_w_t_and_m_t":"1>store the segment included in rrc-MessageSegmentContainer;","paragraph_zero_based":6472},{"literal_text_all_w_t_and_m_t":"1>if all segments of the message have been received:","paragraph_zero_based":6473},{"literal_text_all_w_t_and_m_t":"2>assemble the message from the received segments and process the message according to 5.3.5.3 for the RRCReconfiguration message or 5.3.13.4 for the RRCResume message;","paragraph_zero_based":6474},{"literal_text_all_w_t_and_m_t":"2>discard all segments.","paragraph_zero_based":6475},{"literal_text_all_w_t_and_m_t":"5.7.7UL message segment transfer","paragraph_zero_based":6476},{"literal_text_all_w_t_and_m_t":"5.7.7.1General","paragraph_zero_based":6477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6478},{"literal_text_all_w_t_and_m_t":"Figure 5.7.7.1-1: UL message segment transfer","paragraph_zero_based":6479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["1701bc04003899afcee80579d6e351bfb3526903a8bf7b47f9b79a5b51430d01","3296125d479b5a51a92cab2ccff91034eced4adf1c1ee54fddb89b4b721eeea3","807162e441378f7f4fb824e657368d57c4305588c9ff9cdaa11ddb60923f5c83","f1e7f302bac42a2f1ef264e14d5301f307f2f84f85f2af4214711716cf126d07","fec20d702d386fa8d5fd469d14cff2d0ca792afef9392862bebb04bbb0bfdf18","9569cf9b9f64f5b4c42a6c80d52e3adcc4d91fb10bf215de9a222113987e591b","9a56e98ac5bee44ff2a3d6d36633eb8be456f53b04d421e69b69d8f86a6a8cd1","61b7702ead02a3787ca4e9c22f81f4bea23eefdd82c384a2431021bdaca43ecf","7c6869176edaa46781524833472547d057d695c0914ad55bb3ffc3184d45c546","3eb19f9a10f7d1079abb37b8a0e4bc2464ba735fe1305a9aa0fa5c8f694cede8","e3e0ee831a8fdf9cc5406086f9c1d4bafbf6b2a14e4b41fc913d7b6bf44ad3b7","fb8cf6e91273f167bc4ccea1433b8fb48d9d07127f7d23411dc28d2da72e062c","8b6a24cf20ea5664b36c2bf52a5ae74a8a6cfb4c0707dd854762511062d6c4e1","12f5078a48d1923c48d1aa2014e109822a5f2c9e94326e400d00263ef35a4863","afa9966b7cab29a30292b0c31891f8697ceca09a430446441772fba139754954","7896be7c3d7aa004cd54e29ec356b5ed3f9958149923b7a87322153823d9dbf6","926a3bd22846a7004256965a744ecaeee714798c4d421de4cbda6e85991b1835","1ac9eb2fcaa1c17907baa59c7b4776ba952436e3b425ee293b6098be2bef80bf","0cd0ebc9b298a2da7574f731b517f489f672de8a3c8e54383047e37f8a1480ec","2b65c985e1a2bf8420e4086babfe6c17adfd7d894cc9527cef0d19216142e4ae","7d196e4849e16c671be99393aa555838dbd51931dc49ed7c2f5b4cc2b56f1bf2","c573d7ade011150b33bc5b7fbfca048a8da517eb8a03a17a41fd3e79c3665c5e","b11eb47e90a5811af02b06525dd37dd1a910dce722028f16c786e8eb84622134","c778630493b06c85d513509671eff22ace0345acbb81a20d48892ec7e5956ec0"],"paragraph_range_zero_based":[6456,6479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6456"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer segments of UL DCCH messages from UE to a NG-RAN in RRC_CONNECTED.","paragraph_zero_based":6480},{"literal_text_all_w_t_and_m_t":"NOTE:The segmentation of UL DCCH message is only applicable to UECapabilityInformation and MeasurementReportAppLayer in this release.","paragraph_zero_based":6481},{"literal_text_all_w_t_and_m_t":"5.7.7.2Initiation","paragraph_zero_based":6482},{"literal_text_all_w_t_and_m_t":"A UE capable of UL RRC message segmentation in RRC_CONNECTED will initiate the procedure when the following conditions are met:","paragraph_zero_based":6483},{"literal_text_all_w_t_and_m_t":"1>if the RRC message segmentation is enabled based on the field rrc-SegAllowed received, and","paragraph_zero_based":6484},{"literal_text_all_w_t_and_m_t":"1>if the encoded RRC message is larger than the maximum supported size of a PDCP SDU specified in TS 38.323 [5];","paragraph_zero_based":6485},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":6486},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the ULDedicatedMessageSegment message as specified in 5.7.7.3;","paragraph_zero_based":6487},{"literal_text_all_w_t_and_m_t":"5.7.7.3Actions related to transmission of ULDedicatedMessageSegment message","paragraph_zero_based":6488},{"literal_text_all_w_t_and_m_t":"The UE shall segment the encoded RRC PDU based on the maximum supported size of a PDCP SDU specified in TS 38.323 [5]. UE shall minimize the number of segments and set the contents of the ULDedicatedMessageSegment messages as follows:","paragraph_zero_based":6489},{"literal_text_all_w_t_and_m_t":"1>For each new UL DCCH message, set the segmentNumber to 0 for the first message segment and increment the segmentNumber for each subsequent RRC message segment;","paragraph_zero_based":6490},{"literal_text_all_w_t_and_m_t":"1>set rrc-MessageSegmentContainer to include the segment of the UL DCCH message corresponding to the segmentNumber;","paragraph_zero_based":6491},{"literal_text_all_w_t_and_m_t":"1>if the segment included in the rrc-MessageSegmentContainer is the last segment of the UL DCCH message:","paragraph_zero_based":6492},{"literal_text_all_w_t_and_m_t":"2>set the rrc-MessageSegmentType to lastSegment;","paragraph_zero_based":6493},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6494},{"literal_text_all_w_t_and_m_t":"2>set the rrc-MessageSegmentType to notLastSegment;","paragraph_zero_based":6495},{"literal_text_all_w_t_and_m_t":"1>submit all the ULDedicatedMessageSegment messages generated for the segmented RRC message to lower layers for transmission in ascending order based on the segmentNumber, upon which the procedure ends.","paragraph_zero_based":6496},{"literal_text_all_w_t_and_m_t":"5.7.8Idle/inactive Measurements","paragraph_zero_based":6497},{"literal_text_all_w_t_and_m_t":"5.7.8.1General","paragraph_zero_based":6498},{"literal_text_all_w_t_and_m_t":"This procedure specifies the measurements to be performed and stored by a UE in RRC_IDLE and RRC_INACTIVE when it has an idle/inactive measurement configuration.","paragraph_zero_based":6499},{"literal_text_all_w_t_and_m_t":"5.7.8.1aMeasurement configuration","paragraph_zero_based":6500},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to update the idle/inactive measurement configuration.","paragraph_zero_based":6501},{"literal_text_all_w_t_and_m_t":"The UE initiates this procedure while T331 is running and SDT procedure is not ongoing and one of the following conditions is met:","paragraph_zero_based":6502},{"literal_text_all_w_t_and_m_t":"1>upon selecting a cell when entering RRC_IDLE or RRC-INACTIVE from RRC_CONNECTED or RRC_INACTIVE; or","paragraph_zero_based":6503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cd3500d7bebcdcb0984132a80daee4c59e96785d53d8a3c97baf132cd896ba41","938472221344e78bba65ddbda4b91ae0fd208721ca7343419b8f15ef2cee5432","24f3161a69c40d73f9b70caf0a089fe90eeefaae7019da76d277403b698336b3","44ed95b5df9331cd930f90f1237d4f5ac852c6522089d9767315b0208da565ca","ac3d4ea53559e90094d9b4943652040d3f4ad37cebc35a34f716fa7a2576ad1d","250a07311cae4fe38e1858afd24ffac0e2a40c4aa97335c71907a0797b9459a0","a4180bec0e004a22bb6ec4591aaf7fd0390c7545cb90002bf27b41c81ea0805c","3bb79dd9166fa1a0aa661505d289d407cf0bc24c349f6aec507e5e38ef8b4504","7a7e7b0a9b2b0eb9882b74025a0994072e108df8118e0e6e677b7892e6f4ddab","6ee6d286f4ea1322495dad4d8e6d27750073ff060859a6134f095db492554703","4f305bfe8a3abc06454a19f7ed42d930805d132fe806d7847c60c6580d91b3f9","30eaefe2b1d6d1ee0764be5cadaae0c60ffa425aedd87e6de236a05712771997","f234a0b30fede56a76099d5f7c0e7ca24d5892ef0146fab10c68e6a34b3ab060","6f67f48189ac1c7c2b482b7d95af969cffe0110feea7d1f924acbd8ee79dd878","b3a4fb5d60228db3d39572c2e3e0c181498d888273e86c9ad0966acf08a9ef87","0894597810fbd6c741f25b6df6ea5515bb64415125a0525f4de5b615c6b3b355","263cd29a65e8fde0e00874d797b89b508afc7461a67573c21c009e0fcc63a1ef","6127420a49e5f03a9822d4718199e28937eccb1c5a36e21d24a1744206394910","cf2424530b2c627368cc6bf529ccc0d6ccfc7964944a473061195e759bef5533","5f8e029cdb702f0c5d7b22e4aaca3bed6ee85ddc0ba346509da16085380d4557","700b327651a3b7474cfef2f96b45ddc39b875d5c4286521b27b0fca58ea4dac3","aa7b4da08a58629524b9f93489cef420c27ec892bada0f0554110f819a820b19","17e16619d91aea1d3663683dcdcd8cca53d65b332e80a00c7e497c065f1a7077","f917e4c34d538a4df511cc65e6e66592407fe345bf87a91a035c5211f73ce17b"],"paragraph_range_zero_based":[6480,6503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6480"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>upon update of system information (SIB4, or SIB11), e.g. due to intra-RAT cell (re)selection;","paragraph_zero_based":6504},{"literal_text_all_w_t_and_m_t":"While in RRC_IDLE or RRC_INACTIVE, and T331 is running, the UE shall:","paragraph_zero_based":6505},{"literal_text_all_w_t_and_m_t":"1>if VarMeasIdleConfig includes neither a measIdleCarrierListEUTRA nor a measIdleCarrierListNR received from the RRCRelease message:","paragraph_zero_based":6506},{"literal_text_all_w_t_and_m_t":"2>if the UE supports idleInactiveEUTRA-MeasReport:","paragraph_zero_based":6507},{"literal_text_all_w_t_and_m_t":"3>if the SIB11 includes the measIdleConfigSIB and contains measIdleCarrierListEUTRA:","paragraph_zero_based":6508},{"literal_text_all_w_t_and_m_t":"4>store or replace the measIdleCarrierListEUTRA of measIdleConfigSIB of SIB11 within VarMeasIdleConfig;","paragraph_zero_based":6509},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6510},{"literal_text_all_w_t_and_m_t":"4>remove the measIdleCarrierListEUTRA in VarMeasIdleConfig, if stored;","paragraph_zero_based":6511},{"literal_text_all_w_t_and_m_t":"2>if the UE supports idleInactiveNR-MeasReport:","paragraph_zero_based":6512},{"literal_text_all_w_t_and_m_t":"3>if SIB11 includes the measIdleConfigSIB and contains measIdleCarrierListNR:","paragraph_zero_based":6513},{"literal_text_all_w_t_and_m_t":"4>store or replace the measIdleCarrierListNR of measIdleConfigSIB of SIB11 within VarMeasIdleConfig;","paragraph_zero_based":6514},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6515},{"literal_text_all_w_t_and_m_t":"4>remove the measIdleCarrierListNR in VarMeasIdleConfig, if stored;","paragraph_zero_based":6516},{"literal_text_all_w_t_and_m_t":"1>for each entry in the measIdleCarrierListNR within VarMeasIdleConfig that does not contain an ssb-MeasConfig received from the RRCRelease message:","paragraph_zero_based":6517},{"literal_text_all_w_t_and_m_t":"2>if there is an entry in measIdleCarrierListNR in measIdleConfigSIB of SIB11 that has the same carrier frequency and subcarrier spacing as the entry in the measIdleCarrierListNR within VarMeasIdleConfig and that contains ssb-MeasConfig:","paragraph_zero_based":6518},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6519},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB11 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6520},{"literal_text_all_w_t_and_m_t":"2>else if there is an entry in interFreqCarrierFreqList of SIB4 with the same carrier frequency and subcarrier spacing as the entry in measIdleCarrierListNR within VarMeasIdleConfig:","paragraph_zero_based":6521},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6522},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB4 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":6523},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6524},{"literal_text_all_w_t_and_m_t":"3>remove the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig, if stored;","paragraph_zero_based":6525},{"literal_text_all_w_t_and_m_t":"1>perform measurements according to 5.7.8.2a.","paragraph_zero_based":6526},{"literal_text_all_w_t_and_m_t":"5.7.8.2Void","paragraph_zero_based":6527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cf7fb3cf143c6a237137802b63d1bf1fa672a4441f9247a18f00ec1fb8a5b801","459990f271936e4585f493ae355209ae6f911af712af23e72a4182329d9d0624","c992ddf525144e2792ad037fe96e0503db33604d9421d504dc71a4b970dbadb4","03e1f79fbeafdc46ff53280858cf7615bce3ab4ad1d31a5de6ffaf299d6e7cdf","6b2ac5c0844b79fa7bd3fa510ad8642a4965fc344443ac7bc43068f0b0f5302f","3c5f6389eb03d18dbeda708642f9c3874554c384dd41daf4ca35c5ef6bd09972","53253c3b7b993a347c40a54477caf78fc16b3cf0201ae3cdb6a276c85a12622a","21b0eaca0a6dcbcee9e80cdddd6dbb7815123972e07459c8a5c0beebf37f6156","0a7ba324e64989097e5c416a6969fb9349b8c1d4201d20a44c2a59a01677ded7","d91cf98ec2e272a24435ccb685f769060113a2ff18b6a6733919f0acb22d19aa","2cac482b896ec1fd7e84bbf170fc938db8f3f8bec2f4a25b73c2922e2ec67062","d81d576f2eda9a55c02bf8b6a80da9e1e2e017d587c0b979d4244a1404157f88","48e8bcd4f3e3929a5e668e93224f6978e4c14dfbb8eca36e7089f7b60428666d","0bd9fa74f215db7ff96451aafb721fccca88330fda3f2e814cb6d80236652083","a9423dcc35aee1bc1c5364d6b74a596d59da20108e832a8186879ff8ab67a5fb","c2784935e1df506d9162132869faf6e9b34d45a83a1575e1de90079232d48eae","e163c42cde77f540cba668689526d3cfdbd5c87dfc0769e2340119ea9c30079c","fa62d1185f06da61e4fcbe55748439019974fe780f38b60f6de1fe64b0ac3f27","b21925f7ad8cecbcc6db09551a8bdaae9a21ad223920a98266a0bc815179e0d5","87e786738e29e51b9669fffa3ac72bd01beaa4bb3382a1248af3fab6bda727fa","ecd635f9f526a2cfe69a04f9d0b0cf5fd872f472c562404d85739ed3e7bccc46","7d22517fca5c6c67d5bad9ab9eb6b7d6bea4fe0e0a4bec11f1c9c69553255728","f4155bf312ca20cf58be64ba0016b43a5633cfeefbe03a8842b1aad83654be28","9727e142cda48e8c8fa1d986688dcbe0067a73385294b7225d9ba8b13440fe78"],"paragraph_range_zero_based":[6504,6527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6504"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.8.2aPerforming measurements","paragraph_zero_based":6528},{"literal_text_all_w_t_and_m_t":"When performing measurements on NR carriers according to this clause, the UE shall derive the cell quality as specified in 5.5.3.3 and consider the beam quality to be the value of the measurement results of the concerned beam, where each result is averaged as described in TS 38.215 [9].","paragraph_zero_based":6529},{"literal_text_all_w_t_and_m_t":"While in RRC_IDLE or RRC_INACTIVE, and T331 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":6530},{"literal_text_all_w_t_and_m_t":"1>perform the measurements in accordance with the following:","paragraph_zero_based":6531},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListEUTRA and the SIB1 contains idleModeMeasurementsEUTRA:","paragraph_zero_based":6532},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListEUTRA within VarMeasIdleConfig:","paragraph_zero_based":6533},{"literal_text_all_w_t_and_m_t":"4>if UE supports NE-DC between the serving carrier and the carrier frequency indicated by carrierFreqEUTRA within the corresponding entry:","paragraph_zero_based":6534},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and bandwidth indicated by carrierFreqEUTRA and allowedMeasBandwidth within the corresponding entry;","paragraph_zero_based":6535},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantitiesEUTRA is set to rsrq:","paragraph_zero_based":6536},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the sorting quantity;","paragraph_zero_based":6537},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6538},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the sorting quantity;","paragraph_zero_based":6539},{"literal_text_all_w_t_and_m_t":"5>if the measCellListEUTRA is included:","paragraph_zero_based":6540},{"literal_text_all_w_t_and_m_t":"6>consider cells identified by each entry within the measCellListEUTRA to be applicable for idle/inactive mode measurement reporting;","paragraph_zero_based":6541},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6542},{"literal_text_all_w_t_and_m_t":"6>consider up to maxCellMeasIdle strongest identified cells, according to the sorting quantity, to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":6543},{"literal_text_all_w_t_and_m_t":"5>for all cells applicable for idle/inactive measurement reporting, derive measurement results for the measurement quantities indicated by reportQuantitiesEUTRA;","paragraph_zero_based":6544},{"literal_text_all_w_t_and_m_t":"5>store the derived measurement results as indicated by reportQuantitiesEUTRA within the measReportIdleEUTRA in VarMeasIdleReport in decreasing order of the sorting quantity, i.e. the best cell is included first, as follows:","paragraph_zero_based":6545},{"literal_text_all_w_t_and_m_t":"6>if qualityThresholdEUTRA is configured:","paragraph_zero_based":6546},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from the cells applicable for idle/inactive measurement reporting whose RSRP/RSRQ measurement results are above the value(s) provided in qualityThresholdEUTRA;","paragraph_zero_based":6547},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6548},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from all cells applicable for idle/inactive measurement reporting;","paragraph_zero_based":6549},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListNR and the SIB1 contains idleModeMeasurementsNR:","paragraph_zero_based":6550},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListNR within VarMeasIdleConfig that contains ssb-MeasConfig:","paragraph_zero_based":6551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["755df2b2f6c2e1cfed859b366eed3577ca0693f23f50560fdf79b99997e2e99f","74ed4cd8ff28ae33f6d072b97daeee662b44c42cfd4e952fe172042b630eaac9","fe907341af2b0b605c7e95b3521adf45de1d66b1b63271078e1cfcd46a45cf69","79b91da169e08c4ad7f193cd9abdbc28fe4cc39e4695085fbb2cae41a1eabf08","4128f98fdb65da47f4b16483dc5b19c432fa8ea8d6884b09e8c56334aca1d165","ec925869cca0619775f3b69acc91b43719423ee3fa25bff1d17edc9a4b8b115d","3a67e342db81eb58489fdfebb941f7f85437489b215b0357641ca44a715a863a","a5c3485e668bad7ff2383603f18cd27a75fe295ac8659c7d9c4f979b689691a6","1faabb2713944329788678d2201fcd73f9c1c5bb43b5f7eb6eb3c8925dac8cd3","e85e84199448cdc3c1fefd7d91e006997654a0573294a0ce02dd0b092337c9e7","a095c706c8f0228b0210af8167927c38e374a4b04e28438127d4e3c793c527d6","48ee6ccb6f8d57c39d3441f9f0391219d28fcd8aa70d254422d2c3a896a5cbdf","6a26ad13330a96b3daee6bd2391ca839bf5bb477c0e489bc9f8248fb0850b199","0f7b29fa1889be56dd06bac4fbb55b0d67ceab15335a59a2f2f032235fd0e728","30f970b108d946a80a48b5ad6a075535a34cc5181ccdaa5434a0fe9849841a63","c2592776eb8367ed2c7b3ff84c1a43e73f52dbc2e8857dcc5426766725ed0b03","f649f2aef897a8f8817605d170e47d82244282d4aaf53d2f0d6bcb3c2ec33b74","3aca01e27bbc90619f70bf726d5ae94e6202fa32c949e0dc03858ed7ed8736e4","3692577daf2a8584cb737c0601e6cd210065e6ec10c329c4c22a15e5830736bd","8da4d9121b4af2ee10945a7d6a7507714194ee3c1d97c3a8b968db7cd2b8207d","56d1dd1e0c59011ae578d902682e713c21d9f8eaf198fb906ef1bd0789d15f3c","3ac1949ca8a7a2b421092f4dea84ffe353d3c812d00fed87a300480b5433aee0","60dbd4c107c380e540f7036e0ed333680299cc2a97635166e275da6a1247c743","ca9815d2a30f5e9c9c87c50c1cd046156f90984fe76e9fea4ee21b0e1a19e20a"],"paragraph_range_zero_based":[6528,6551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6528"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if UE supports carrier aggregation or NR-DC between serving carrier and the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry:","paragraph_zero_based":6552},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry;","paragraph_zero_based":6553},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantities is set to rsrq:","paragraph_zero_based":6554},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the cell sorting quantity;","paragraph_zero_based":6555},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6556},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the cell sorting quantity;","paragraph_zero_based":6557},{"literal_text_all_w_t_and_m_t":"5>if the measCellListNR is included:","paragraph_zero_based":6558},{"literal_text_all_w_t_and_m_t":"6>consider cells identified by each entry within the measCellListNR to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":6559},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6560},{"literal_text_all_w_t_and_m_t":"6>consider up to maxCellMeasIdle strongest identified cells, according to the sorting quantity, to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":6561},{"literal_text_all_w_t_and_m_t":"5>for all cells applicable for idle/inactive measurement reporting, derive cell measurement results for the measurement quantities indicated by reportQuantities;","paragraph_zero_based":6562},{"literal_text_all_w_t_and_m_t":"5>store the derived cell measurement results as indicated by reportQuantities for cells applicable for idle/inactive measurement reporting within measResultsPerCarrierListIdleNR in the measReportIdleNR in VarMeasIdleReport in decreasing order of the cell sorting quantity, i.e. the best cell is included first, as follows:","paragraph_zero_based":6563},{"literal_text_all_w_t_and_m_t":"6>if qualityThreshold is configured:","paragraph_zero_based":6564},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from the cells applicable for idle/inactive measurement reporting whose RSRP/RSRQ measurement results are above the value(s) provided in qualityThreshold;","paragraph_zero_based":6565},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6566},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from all cells applicable for idle/inactive measurement reporting;","paragraph_zero_based":6567},{"literal_text_all_w_t_and_m_t":"5>if beamMeasConfigIdle is included in the associated entry in measIdleCarrierListNR and if UE supports idleInactiveNR-MeasBeamReport for the FR of the carrier frequency indicated by carrierFreq within the associated entry, for each cell in the measurement results:","paragraph_zero_based":6568},{"literal_text_all_w_t_and_m_t":"6>derive beam measurements based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in TS 38.215 [9];","paragraph_zero_based":6569},{"literal_text_all_w_t_and_m_t":"6>if the reportQuantityRS-Indexes is set to rsrq:","paragraph_zero_based":6570},{"literal_text_all_w_t_and_m_t":"7>consider RSRQ as the beam sorting quantity;","paragraph_zero_based":6571},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6572},{"literal_text_all_w_t_and_m_t":"7>consider RSRP as the beam sorting quantity;","paragraph_zero_based":6573},{"literal_text_all_w_t_and_m_t":"6>set resultsSSB-Indexes to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes in order of decreasing beam sorting quantity as follows:","paragraph_zero_based":6574},{"literal_text_all_w_t_and_m_t":"7>include the index associated to the best beam for the sorting quantity and if absThreshSS-BlocksConsolidation is included, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":6575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["3c6693a9fade490b786ba8487ba1d10a908728c921cbcaa1157ec13a8af9e658","e317e61fc71a549e35c17f6eabf4e72f428af519237829a1d35b3a125c8cbe59","6260c380383c1d2ce424e114f44c99f06fbf093ffab97f87b4f9c29d25ca1eb8","2f4e0f3444b235e99757b5b77bd88eb0445961324e8fc0150b6e361b2b61ab2b","27de1ee030ea467ad2a7719f1849a7cf3f1ee9f7901b3f5d6018766164aa8aca","951ed5303b1500ff5ab0095c803411462f53f225c5c992354443949f3d41c59e","61aeb873d4c6f8fb5779b4e9872ec2e754458d7b09d444b475ca7baf579d5675","c5f071e6c5ac3176ea66b695dd9daac6ae5a7b3676904ed240f512e4ddf77286","b497c753fc2a71e755727017e6877de23147b6697e3bc3d87592d1cec1af6bd5","3c9d8f8aefa96ff3fb98faa5803ae95785bbe4ed0efe4ed34d921326cc9d7e01","ca209873584f040d9c81a7ff87b2d93fde631f04558deee7ad360211ce383c91","9abb1166a2fa5e21dc48cf7577c1db50eb7f480b908a97c357446cddf55ff2c2","2916f37227af18459c4fe12d19559acb09e1a5a9d86090b43033f36baea20b80","6ca879e113936450f28b5ca70ac19c1233af0e1abd7bcc08ae1e5523e1a35416","cfd725572e545a013c79d2bbed653e537971874aa62491ccd82200aad252e9d6","bb6bafd2172e9e3cce96158365f83bbb56de63f9416cde65245c091b48503757","7d2c277ecb2bbedda1a7916d09a2f8f197a1772a74fb6acf77ea8c37b7aa7dae","c7e99a5d90d6dff3f221dd1ff098889937f98bea1a10c15041e5c6329d3cb685","ffde2e6c6606bc27ea139a146a6582e4991635fb312a1eef8bc1b11e05489a7a","a6829b1c82e9a1287cc3df7924bbe709952d5788737cc31f4c6a677e602ad203","fd50959934b9966a3aed9c080398426a5ed26ff3861dc24b181f4fff455ebaf3","eb591eb92824dfdf3c512b6527e125b54b619572b7e1bc7b87b2aafe7c8e0a55","9c8d79ab84c8f24d7445d4d0c9ff440273bca362345b9cf4b30b9d1c2767c168","e62bbf7bba6b0e39343f62074a0ef83efb997babca7813bdae240446b713236a"],"paragraph_range_zero_based":[6552,6575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6552"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>if the includeBeamMeasurements is set to true:","paragraph_zero_based":6576},{"literal_text_all_w_t_and_m_t":"7>include the beam measurement results as indicated by reportQuantityRS-Indexes;","paragraph_zero_based":6577},{"literal_text_all_w_t_and_m_t":"2>if, as a result of the procedure in this clause, the UE performs measurements in one or more carrier frequency indicated by measIdleCarrierListNR or measIdleCarrierListEUTRA:","paragraph_zero_based":6578},{"literal_text_all_w_t_and_m_t":"3>store the cell measurement results for RSRP and RSRQ for the serving cell within measResultServingCell in the measReportIdleNR in VarMeasIdleReport.","paragraph_zero_based":6579},{"literal_text_all_w_t_and_m_t":"3>if the VarMeasIdleConfig includes the measIdleCarrierListNR and it contains an entry with carrierFreq set to the value of the serving frequency:","paragraph_zero_based":6580},{"literal_text_all_w_t_and_m_t":"4>if beamMeasConfigIdle is included in that entry, and if the UE supports idleInactiveNR- MeasBeamReport for the FR of the serving cell:","paragraph_zero_based":6581},{"literal_text_all_w_t_and_m_t":"5>derive beam measurements based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in TS 38.215 [9];","paragraph_zero_based":6582},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantityRS-Indexes is set to rsrq:","paragraph_zero_based":6583},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the beam sorting quantity;","paragraph_zero_based":6584},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6585},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the beam sorting quantity;","paragraph_zero_based":6586},{"literal_text_all_w_t_and_m_t":"5>set resultsSSB-Indexes to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes in order of decreasing beam sorting quantity as follows:","paragraph_zero_based":6587},{"literal_text_all_w_t_and_m_t":"6>include the index associated to the best beam for the sorting quantity and if absThreshSS-BlocksConsolidation is included in SIB2 of serving cell, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":6588},{"literal_text_all_w_t_and_m_t":"5>if the includeBeamMeasurements is set to true:","paragraph_zero_based":6589},{"literal_text_all_w_t_and_m_t":"6>include the beam measurement results as indicated by reportQuantityRS-Indexes;","paragraph_zero_based":6590},{"literal_text_all_w_t_and_m_t":"NOTE 1:How the UE performs idle/inactive measurements is up to UE implementation as long as the requirements in TS 38.133 [14] are met for measurement reporting.","paragraph_zero_based":6591},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is not required to perform idle/inactive measurements on a given carrier if the SSB configuration of that carrier provided via dedicated signaling is different from the SSB configuration broadcasted in the serving cell, if any.","paragraph_zero_based":6592},{"literal_text_all_w_t_and_m_t":"NOTE 3:How the UE prioritizes which frequencies to measure or report (in case it is configured with more frequencies than it can measure or report) is left to UE implementation.","paragraph_zero_based":6593},{"literal_text_all_w_t_and_m_t":"NOTE 4:When idleModeMeasVoiceFallback is included in SIB5, UE may decide to measure and report idle/inactive measurements for EUTRA carrier frequencies included in SIB5 even if it does not support NE-DC between the serving carrier and the EUTRA carrier frequencies.","paragraph_zero_based":6594},{"literal_text_all_w_t_and_m_t":"5.7.8.3T331 expiry or stop","paragraph_zero_based":6595},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6596},{"literal_text_all_w_t_and_m_t":"1>if T331 expires or is stopped:","paragraph_zero_based":6597},{"literal_text_all_w_t_and_m_t":"2>release the VarMeasIdleConfig.","paragraph_zero_based":6598},{"literal_text_all_w_t_and_m_t":"NOTE:It is up to UE implementation whether to continue idle/inactive measurements according to SIB11 and SIB4 configurations or according to E-UTRA SIB5 and E-UTRA SIB24 configurations as specified in TS 36.331 [10] upon inter-RAT cell reselection to E-UTRA, after T331 has expired or stopped.","paragraph_zero_based":6599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["4e5b96e10070fb78ab64b667b19b500adf621dc7fd16851177f84bf3a3c4bb6a","ca6a5104d1e07ae6b921f7618c8ad2aa1f04bc7bfc5d05633a091b097e232180","8c0fd080914cacbdbcb5e98104331b35cdc8c581cd2fa04db91ca74ce0a5720b","7c4e35ab1c66702922b6c5e80f3416d33b577e10b7d47df62c6169b49756d6d7","7f856edaa4d31cec2ac9fa8594833e52870e7b26ef00ff19a4a3f13ffc9cb2cb","65000981f9c6aaed9cb0bd9ff327176c17f07b18f3ffe807de62d38367296753","7043b63693008ebd9cd48adb41f1c7c507f9b1fd4b33f7056b961e6e5589965a","4994673fa0bb8d8808291cbd05778764baf5a3ec8df62dfda26827e039e15557","46ff626db31fa2e571cd98259dd0ba6a8f7aaa896a20966616f344b5b7378537","ebc48ca1e88d93a9512a977418e082d49649b40082bfd77a4ccabe8f39f8cab6","76110e6d1a57927009bf300e8307a71509365edb9d649e571354b4e2ab94ede3","59a224d2d7755aada3677a590fa850c9f9374c2c39f52fb7d794db932563bc95","9b13463e20544e006fa6d1295f3d4edc980179860ac171c4abd1c0954ec58983","08f071c55fb8daa7c71c6540079d84e68fb07dfad3547d0f3e5f3f281c5a7142","6367542223ad5972968bb4b7939aacda155f32f02047424c79e989417c421c0f","49a9347877df576bcc284d7e2e6130adcb0843bc466f89248f66353c4ada0f21","b1cf5cc174b3724e5551667115dce60408600cabd8b5faec81104372acc6ba8d","7e690685e2b5555ee196707e1f2af6a59d2623d25dcf09640b4c7434b650d59c","74f64497786fa2fea077af068dd3d9872ffaa808586d87ea612a8e0793abecf0","afdde5041c7f39178e85a9fe551fd04ec0734b998d35f4aacbcefe9646030546","0f08e2884b4a6a7e55ec64500136eee6d9244ca986235be42ff5ffe67a4ac879","42ffc10c16877e9a58bf097a5bc0e1002f5940961c821d0ee3b666981fa9e295","1bc8a20cb6c1def2b2f09377309d0506d941ab24d04ed320f1d470d8b503e850","eeeab1484909c588882405c4743e88b9b87550afd4c4d1029744f24c44e27fc7"],"paragraph_range_zero_based":[6576,6599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6576"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.8.4Cell re-selection or cell selection while T331 is running","paragraph_zero_based":6600},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6601},{"literal_text_all_w_t_and_m_t":"1>if intra-RAT cell selection or reselection occurs while T331 is running:","paragraph_zero_based":6602},{"literal_text_all_w_t_and_m_t":"2>if validityAreaList is configured in VarMeasIdleConfig:","paragraph_zero_based":6603},{"literal_text_all_w_t_and_m_t":"3>if the serving frequency does not match with the carrierFreq of an entry in the validityAreaList; or","paragraph_zero_based":6604},{"literal_text_all_w_t_and_m_t":"3>if the serving frequency matches with the carrierFreq of an entry in the validityAreaList, the validityCellList is included in that entry, and the physical cell identity of the serving cell does not match with any entry in validityCellList:","paragraph_zero_based":6605},{"literal_text_all_w_t_and_m_t":"4>stop timer T331;","paragraph_zero_based":6606},{"literal_text_all_w_t_and_m_t":"4>perform the actions as specified in 5.7.8.3, upon which the procedure ends.","paragraph_zero_based":6607},{"literal_text_all_w_t_and_m_t":"1>else if inter-RAT cell selection or reselection occurs while T331 is running:","paragraph_zero_based":6608},{"literal_text_all_w_t_and_m_t":"2>stop timer T331;","paragraph_zero_based":6609},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":6610},{"literal_text_all_w_t_and_m_t":"5.7.9Mobility history information","paragraph_zero_based":6611},{"literal_text_all_w_t_and_m_t":"5.7.9.1General","paragraph_zero_based":6612},{"literal_text_all_w_t_and_m_t":"This procedure specifies how the mobility history information is stored by the UE, covering RRC_IDLE, RRC_INACTIVE and RRC_CONNECTED.","paragraph_zero_based":6613},{"literal_text_all_w_t_and_m_t":"5.7.9.2Initiation","paragraph_zero_based":6614},{"literal_text_all_w_t_and_m_t":"If the UE supports storage of mobility history information, the UE shall:","paragraph_zero_based":6615},{"literal_text_all_w_t_and_m_t":"1>If the UE supports PSCell mobility history information and upon addition of a PSCell:","paragraph_zero_based":6616},{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedPSCellInfoList in variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":6617},{"literal_text_all_w_t_and_m_t":"3>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":6618},{"literal_text_all_w_t_and_m_t":"4>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":6619},{"literal_text_all_w_t_and_m_t":"5>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":6620},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6621},{"literal_text_all_w_t_and_m_t":"4>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":6622},{"literal_text_all_w_t_and_m_t":"2>for the included entry:","paragraph_zero_based":6623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["8026e434ea856407534ab6290745a459f71712cbb546932fca51b49f3e748885","2053b16fcae6b0c778c21dc646f66930ce9def9955840c265aee5b62e31757f5","798f431b1166f1d34b779cc631a38e1b2c1551c5f33e48984265a85e2815b84e","3c315db97f707d0462199c70639fac891ffdfc5088cc7a57b9842c901cdcfcbe","75aa24cb7872a2d52a89ca768fc1a11f6bb069352b2f76be9e5b6700f3953a37","ef94759dc75649ff2f0da80ec5e2a2bb90a5e33f7c76281f6d28d2a021290a95","8e19fd9b9b8672dac6dbd700e1dd5dca125263140ecd501eba59092a3ce06064","452348b1e5ce1a479d4ec21683e1a4fc133db16c0d857582f46d513e91a76b73","c9dd0ec43d010378415ad8d4137ec082e14c762996a711868b6ddebabf4bf010","4e2f2b143f54b07b0785735138162cfcf6e00fe3d5b681436ef09259a4d8d41f","84cc0a33fe03fcb781d8210a58796f045c611a25b6858423195fe9c01a3cf88b","31b50cbf8f309a6dcd6f3bbdc17477036f4ae95d8d17d9dfc05cf1eb018f155b","97c1c88fb90ca3ad5645cbe9d59ccaa6f1a67ed593dd1c76a07b9331abc4df84","a629ec6f6b2bd90972ad450dfb23048ea56348a0c807f7927070666fd5fccc35","7c61775335edc534b917ec24df82540299564b91aa49a61166b5c51d8d99da94","2f33fc59762473cf921902c97f86bb5cd19b9106f6c0461842cb270c100ac9c3","6bfecaaee320717ec194cb9c158992d17054bd4bc24f0dd0822d944d8f8fc9ee","0a6f19e0e3aae639454b025657747921bcb026cd97552ee655324df054cc8024","5145c588c7e3ff305f7c8a215c6534099674e51090c74f3101b59ff5ca9d9418","13d4f6b45c95939e0f070fab21b4d679aa43e50c81e7699c2025b2fc0c744266","0393144050894560d9e53a49bf83ec19873b8e47fdda780f071ff729a4bdd542","a3c6e7d545ca89613b54aac87f8ce32f981e6ccd5c7a6c3227ce105e7f6eeba9","9573c67bbf57c31cda8d956146c1fb11a66419affd4f70446bd093a6c8c0f79d","c9ca9fddc0da095caa4a0304e8aa8ea719b4ecbeb8f5b5698fcedd8844032120"],"paragraph_range_zero_based":[6600,6623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6600"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry according to following:","paragraph_zero_based":6624},{"literal_text_all_w_t_and_m_t":"4>if this is the first PSCell entry for the current PCell since entering the current PCell in RRC_CONNECTED:","paragraph_zero_based":6625},{"literal_text_all_w_t_and_m_t":"5>include the entry as the time spent with no PSCell since entering the current PCell in RRC_CONNECTED;","paragraph_zero_based":6626},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":6627},{"literal_text_all_w_t_and_m_t":"5>include the time spent with no PSCell since last PSCell release since entering the current PCell in RRC_CONNECTED;","paragraph_zero_based":6628},{"literal_text_all_w_t_and_m_t":"1>If the UE supports PSCell mobility history information and upon change, or release of a PSCell while being connected to the current PCell:","paragraph_zero_based":6629},{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedPSCellInfoList of the variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":6630},{"literal_text_all_w_t_and_m_t":"3>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":6631},{"literal_text_all_w_t_and_m_t":"4>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":6632},{"literal_text_all_w_t_and_m_t":"5>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":6633},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6634},{"literal_text_all_w_t_and_m_t":"4>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":6635},{"literal_text_all_w_t_and_m_t":"2>for the included entry:","paragraph_zero_based":6636},{"literal_text_all_w_t_and_m_t":"3>if the global cell identity of the previous PSCell is available:","paragraph_zero_based":6637},{"literal_text_all_w_t_and_m_t":"4>include the global cell identity of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6638},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6639},{"literal_text_all_w_t_and_m_t":"4>include the physical cell identity and carrier frequency of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6640},{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry as the time spent in the previous PSCell while being connected to the current PCell;","paragraph_zero_based":6641},{"literal_text_all_w_t_and_m_t":"1>Upon change of suitable cell, consisting of PCell in RRC_CONNECTED (for NR or E-UTRA cell) or serving cell in RRC_INACTIVE (for NR cell) or in RRC_IDLE (for NR or E-UTRA cell), to another NR or E-UTRA cell, or when entering any cell selection' state from 'camped normally' state in NR or LTE or when entering 'any cell selection' state from a suitable cell in RRC_CONNECTED state in NR or LTE:","paragraph_zero_based":6642},{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedCellInfoList of the variable VarMobilityHistoryReport possibly after removing the oldest entry, if necessary, according to following:","paragraph_zero_based":6643},{"literal_text_all_w_t_and_m_t":"3>if the global cell identity of the previous PCell/serving cell is available:","paragraph_zero_based":6644},{"literal_text_all_w_t_and_m_t":"4>include the global cell identity of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6645},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6646},{"literal_text_all_w_t_and_m_t":"4>include the physical cell identity and carrier frequency of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["cc84bcefd3e0e350625fe308c977e9c03d2c2083baaded924b335d60305bc336","fb1c50bc9a39517d80a2291c7959902c71af683e69cd69925e9dd9d493bf3c25","8072da28e1099c8cef4d5ac4e0b4efe8edde3fd3d6b3172fe465cd0f81fa5b44","5252e2189f612c5b3f9d10c990356ad2409be78d508950d84dd9a9aa2d39f56a","4fff9d22be33d7677e8dcc459ee53084fb8a11d7ce5b0ff12d4c5bd5318e33f7","bdf17164f6397bb5f50e5991637fd497864c86bc3fc4052a0e8581e28c24050f","4d4d82293f1a387dcc13a54be4d8eb74a61581472fc0444de83c5329c7ac42b8","276c54a0cf27f737c77bb24aa69f843677b3dbb58a72f0acdf5ce7b311527f69","58c26483bb295059e4d30c9d91e62b0e685d50d81f2413d854029844aa46b352","ac636b0cc7c6090575a286c79cae14006b9a50ba8593110a9a549775272c7893","6f386b3eaeaffaf92c93860c2c960554510eeebf44babfa500acc3ce62313014","f28d57177d1f559838b27f3a73e7e11614e05fac70cf99e892c95f1eaff9e8df","c28aaad8cdf5d3611e27d94ee2ac8414c1f20c2c4714223098e46e16991d67c1","ae3eb0bfaf1495dd101e1534bb501b936250968687fb5225c630da94a2a4682f","63d21c5548331f860b657306fea8c7f68c8674534d5e39cdd2b64f32baf6b952","f7675f3e4ac74e0d527dbf09a8e3e815c45979239fb5b56a0f08119c34d5e689","012dd5e6b1112e4b1e9126a6dd2bc773c3a78987c96a5a75c9a0afa572b1d135","ab92019580d4660e6f835e44d218a4bc5317e1168fded70cfddf5ece3fb7fc58","55dd61ba9f3bd1a19de43284b18235b00e6ef92d5f6766fccae8fffb6fdfc0d3","7ff778e2130ec0ddabf882f0403435892a5120898c263800f1e6923fe603ce19","03302ad33dc516204e3f49466d468991d63db50769b4bd80c81e30dd673d1490","f71da49b999c59b9c32baca2ebf5735bebd914d305a02d2b271155b11bf94616","5d958ae046b7dd9fe0217801ea95c3e4b6e5b5af1d9d080f8c7745352bfb351d","3b4c2949597e1e92f312743dd6fc25fbfeff55b9729f597a7e96f5520ce3ad43"],"paragraph_range_zero_based":[6624,6647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx:p6624"}
{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry as the time spent in the previous PCell/serving cell;","paragraph_zero_based":6648},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the UE continues to be connected to the same PSCell during the change of the PCell in RRC_CONNECTED; or","paragraph_zero_based":6649},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the UE changes PSCell at the same time as the change of the PCell in RRC_CONNECTED; or","paragraph_zero_based":6650},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the PSCell is released at the same time as the change of the PCell in RRC_CONNECTED:","paragraph_zero_based":6651},{"literal_text_all_w_t_and_m_t":"4>include an entry in visitedPSCellInfoList of the variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":6652},{"literal_text_all_w_t_and_m_t":"5>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":6653},{"literal_text_all_w_t_and_m_t":"6>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":6654},{"literal_text_all_w_t_and_m_t":"7>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":6655},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6656},{"literal_text_all_w_t_and_m_t":"6>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":6657},{"literal_text_all_w_t_and_m_t":"4>for the included entry:","paragraph_zero_based":6658},{"literal_text_all_w_t_and_m_t":"5>if the global cell identity of the PSCell (in case the UE continues to be connected to the same PSCell) or the previous PSCell (in case the UE changes PSCell, or in case PSCell is released) is available:","paragraph_zero_based":6659},{"literal_text_all_w_t_and_m_t":"6>include the global cell identity of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6660},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6661},{"literal_text_all_w_t_and_m_t":"6>include the physical cell identity and carrier frequency of that cell in the field visitedCellId of the entry;","paragraph_zero_based":6662},{"literal_text_all_w_t_and_m_t":"5>set the field timeSpent of the entry as the time spent in the PSCell, while being connected to previous PCell;","paragraph_zero_based":6663},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the UE was not configured with a PSCell at the time of change of PCell in RRC_CONNECTED:","paragraph_zero_based":6664},{"literal_text_all_w_t_and_m_t":"4>include an entry in visitedPSCellInfoList after performing the following, if necessary;","paragraph_zero_based":6665},{"literal_text_all_w_t_and_m_t":"5>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":6666},{"literal_text_all_w_t_and_m_t":"6>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":6667},{"literal_text_all_w_t_and_m_t":"7>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":6668},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6669},{"literal_text_all_w_t_and_m_t":"6>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":6670},{"literal_text_all_w_t_and_m_t":"4>for the included entry:","paragraph_zero_based":6671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9eac236dba16ec19e0fc4d10a162c508120454d48c77504c8358ddde7505ae1e","1ffaf33d4fd9eb4615e5b5ebca8209b09d20d11a8a0d1c04aa1936d934b870e4","990232823c35972398094e29ff0d4f0c4dead39c370c1dd970d4e3a7ea12cfd1","b6d26a73dc7466d546d6d215e3c6fb711db47d9c151deaac370cb7c4c942b242","93d17843a60ccc87d88e0409e4df91b3706d92592697828e86cfb60aa6434d1c","1b277d934ca3a1d11ff63170428993800b0230fa7a1f4296d7f2943b54a3535c","dbb569fbc042fcb14c09d1c533ec1cda1f32536f92c7ddbfc5365b5d6c26ee4c","daaaa70c9c22aa641d3117c79331279a944d1eecb10eefefab92478964014d96","455a99c7e94d2ca412b2342b5075a8679486431ce5093ec960bf220b5bf6843d","da2df0a7f47b1692520f098a946b00697ab9225fd56aacf276fe0ac6bdf2b736","3268a573db0b177555e39b837fba047e222346c6709826b1c88a8bf665027134","75eb626b15ea0afca5e30da33bfd59678e75eed754a6fc3adca11b8289b0b0a2","b49041fd73721f85333ae0da246b5f956e35e64d291163628b769ffe77768ae9","e2ede7acdb87375482fba611d388b02b3e9224424a2f057e087a675b5e2b3ad4","1021e5f9861c1542563763a4feee725dab985b726e210ef087a611d85e8500a0","d6eaa2d56d14c02a64a363c10f7993962363b576cc76d564a006974946454746","a44b2f2dcf3f0a4cdf20ce0057e3af8c1c35414257a23b91c8b37c91217f99c3","98f80811812c57abe16a9b373810e27f6895963def373ad0d765afa5de339e19","4bda1b023ad0acab9d8028a991b795cb16e00b7130760c8adacdd001a5c44f8c","49c438d3dd17791004c306c83c13d3e2ad0e99c4458dd9a9384915303cac477a","2d6199ca9818e918190d16b5be5e65da0a01b64965913d2cfb038c9b90ca314d","271a95f1459fe25addff6c80770b1d8006b81d4080f9ee3ff3e4cf2cddbc7d07","72b8cd8e34b3891c9c3028eb0cc908b065f3fdc1d292b48cdcea3d8135b77c44","996904f8bb46394846e907894716921c185eba2d47f069b0fcc60d2f77791a91"],"paragraph_range_zero_based":[6648,6671],"projection":"All w:t and m:t including tracked insertion/deletion 