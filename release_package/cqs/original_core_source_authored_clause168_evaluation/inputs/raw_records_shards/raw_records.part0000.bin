      CHOICE {","paragraph_zero_based":24781},{"literal_text_all_w_t_and_m_t":"        l571                                    INTEGER (0..569),","paragraph_zero_based":24782},{"literal_text_all_w_t_and_m_t":"        l1151                                   INTEGER (0..1149)","paragraph_zero_based":24783},{"literal_text_all_w_t_and_m_t":"    }   OPTIONAL   -- Need R","paragraph_zero_based":24784},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":24785},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24786},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationForSlicing-r17         RA-PrioritizationForSlicing-r17                          OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":24787},{"literal_text_all_w_t_and_m_t":"    featureCombinationPreamblesList-r17     SEQUENCE (SIZE(1..maxFeatureCombPreamblesPerRACHResource-r17)) OF FeatureCombinationPreambles-r17 OPTIONAL -- Cond AdditionalRACH","paragraph_zero_based":24788},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bf8173202b85c8aa6b54c36a478a4292a633ae5f9f1bca7f306d74fa233e4ee9","f01649cc690ecae3ac51460c5299effd3994e0cbaa2a13487df90e5e4b9498d9","cc802ffabad923eef43217bd79a183dbaa858604801d81ee54ee9035c53d779d","bd68e337416d2c42d0122234cd6a329be9dd8db9b91f53dbefd1df256d69b7e4","f0736bd8e1110ecbb0b2fe8642486f5bb9b3ade171ef852a8f561811a67be2b9","5a33983c1ce1264399f8e5037ef0e2183a012f2daff3bde9f0fdba13cfd53d5b","31d0304babd3b674d2c80bbd429f89b1e4ff7d4cdceaaddcf61abb8c8602e04f","60b095f4fd4114f746963104671eb5835081067899ab2363e40eab09a209b8bf","c64c22ec18c0e7dcfaa2c9468f637081b7723810018c26c9485aab7964a40c04","024eed3619ee4a129ddb7ef647f3fa1441090e45d9fe3f7182e562163a2cf5e5","3c6e52b563920f6d005c13a5b97927f41160d85fa5a6c1337e8a572c23a4220f","bf6ccc9ecfb548b38b82af861c94d9a907884c31420e54c31470f2229ce005b6","7528d1de295f8692f438d2c636c46eb78c8b9be650491011cc1dc6b16bf0e599","e4a9e605898fcae4ce873202be57001855c59da391f36c97d5c6846dc90642df","3aeda574759380cc6758eedadc2752d4e18da3f1ea6aa8e2391eb73b455de858","d9c4e5f2a5a2690c986c7687c0d9f103bdd35b5c3de349b09061c2298e03775a","d27485143e6c052ba83e5ab7993208894d7cffd042e3f0a1567fdffac2a4df4f","6d7058fa8c6b74bc9b93d52f13081a52bfcb6b695d64a3c5be827da78f15a361","404f22241261bfb1a269fa4a9e4dbc6e715efe8aeffcc6363d1588b1d7df4a54","fc75cbfac2ba2645b824ddb241f126c3a8f0891363da43412341b2f4868fe162","95755e90be786ab0bdf7ca302be6ce5070cdf40f24362879429d82a7221d805e","d979be06de9dcb19a623c4dfc8a3750c1da278256b28f6ce7be1aee82858a7a7","5737c11e402b989efc53027764fe8f7c286a8c5d49ad9f0cbe0bc12d13d4e974","0a7167a7ea1383b6bf035b46677458307d95b05e249787827059efab1e2c173e"],"paragraph_range_zero_based":[24768,24791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24768"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMON-STOP","paragraph_zero_based":24792},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24794},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommon field descriptions","paragraph_zero_based":24795},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":24796},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 4-step RA. The network does not configure this list to have more than 16 entries.","paragraph_zero_based":24797},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":24798},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on. (see TS 38.321 [3], clause 5.1.2)","paragraph_zero_based":24799},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":24800},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":24801},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":24802},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":24803},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":24804},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":24805},{"literal_text_all_w_t_and_m_t":"If absent, the UE applies the SCS as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]). The value also applies to contention free random access (RACH-ConfigDedicated), to SI-request and to contention-based beam failure recovery (CB-BFR). But it does not apply for contention free beam failure recovery (CF-BFR) (see BeamFailureRecoveryConfig).","paragraph_zero_based":24806},{"literal_text_all_w_t_and_m_t":"msg3-transformPrecoder","paragraph_zero_based":24807},{"literal_text_all_w_t_and_m_t":"Enables the transform precoder for Msg3 transmission according to clause 6.1.3 of TS 38.214 [19]. If the field is absent, the UE disables the transformer precoder (see TS 38.213 [13], clause 8.3).","paragraph_zero_based":24808},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":24809},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A. This determines implicitly the number of CB preambles per SSB available in group B. (see TS 38.321 [3], clause 5.1.1). The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB.","paragraph_zero_based":24810},{"literal_text_all_w_t_and_m_t":"prach-RootSequenceIndex","paragraph_zero_based":24811},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1). The value range depends on whether L=839 or L=139 or L=571 or L=1151. The length of the root sequence corresponding with the index indicated in this IE should be consistent with the one indicated in prach-ConfigurationIndex in the RACH-ConfigDedicated (if configured). If prach-RootSequenceIndex-r16 is signalled, UE shall ignore the prach-RootSequenceIndex (without suffix).","paragraph_zero_based":24812},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":24813},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":24814},{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":24815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a7af188df1d1aafb0e06419cd3ba950803d31ede74031f10204f3ff5b8b3d690","c7f85253a081281302bc03b0d00ecbfdd6a2bb8bcafa5aefef5219e8c7dcf759","0c08f9c7b180a4c63f7a3be09f6b6e1c6f8987901fd9aa4f4f4cff5b2bff37e3","f09a177f960e9ad305aca6f869f2e8ed62c5dbdf19b89807084a5d94aef2567b","9f4cc2704e7b32985fd5271c5d0d970fbf9c1662774f507f9482594ac22c929a","7fc5ddce29429cb4e5e43d12408521b8ee7e222d9a4e8bbfe7404175494560b4","800d72ce06ea41e6b280f493aefecc095f252682cfb74d6f3151f7322c2c727f","638433ae8b480ef98620a484a9a7fba9190c8706609895701eb54cc005721995","21fc828859425575b23468aa7d4b43ea1c97b911015beec4125c0115bd975065","0cfda2a1ea6e82955ad481a6ef7f0475b80dcd5a000c9ac03061102a3d2d645d","2e63ccc5673d9fd0ee38e07c1c4ffb278faa13f9f8b69a3e107feb5cb55da33c","0a23dc6fe8cdd81c8ad84eab8c7357c970625dcd0b6d2e0f84dc6731c079a4ba","94369dcd1ca14dc16bed5ad3a3a6f7457991c98435b158f6cbe63833d710032d","3ac5db3fbef44bc26fdee44f9d2bb16c409ea0b79304e327144239eeda78261a","39c020a14276b98bfcc239220672ae0e4215524538020cdf589d7e7103071d5c","f8b01f7178b1cd88666c962bd9b2841e650a2f2501542b654269fab59b042df7","85683ae3f1b470d0b8b2dc38e53006b7a6132214f2264dd4cff4359101c03abc","c4975f42b9c9862490f2e8d203fcd9016afeeb9254a5445fd659b7965a2d9a13","433b41657a6d1b4c75be9fd767c7cad8c3011123c013d832ba7ae244f056de95","335f3024ba3d8fd2971b9436a617b7663cfedbf82d32ddd09e4a0e9d4eb11606","6ac6d5a3a28ea85f31d79bdda415c06fa8440b6d511909b5a192cf83614ffb6e","b359574b7bbc68feb6f441cdbd3de6583220b71d210155593c9879526b7626f9","4f3417276a74b44d87b06d7bb174ebd528f8ba5dc34515fa7ccfc64ef43eae5d","ca4af8e174c93ecb2659431c4b4934e3ab7b155352baba17c73eb7d2040dec55"],"paragraph_range_zero_based":[24792,24815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24792"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":24816},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":24817},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on.","paragraph_zero_based":24818},{"literal_text_all_w_t_and_m_t":"ra-Msg3SizeGroupA","paragraph_zero_based":24819},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.2).","paragraph_zero_based":24820},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":24821},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":24822},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":24823},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 indicates that the field ra-Prioritization-r16 applies otherwise the field does not apply (see TS 23.501 [32]).","paragraph_zero_based":24824},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicing","paragraph_zero_based":24825},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 4-step random access type for slicing.","paragraph_zero_based":24826},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":24827},{"literal_text_all_w_t_and_m_t":"RACH parameters for both regular random access and beam failure recovery.","paragraph_zero_based":24828},{"literal_text_all_w_t_and_m_t":"restrictedSetConfig","paragraph_zero_based":24829},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets, see TS 38.211 [16], clause 6.3.3.1.","paragraph_zero_based":24830},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":24831},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":24832},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB-SUL","paragraph_zero_based":24833},{"literal_text_all_w_t_and_m_t":"The UE selects SUL carrier to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). The value applies to all the BWPs and all RACH configurations.","paragraph_zero_based":24834},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":24835},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEighth corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). See TS 38.213 [13].","paragraph_zero_based":24836},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":24837},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention based and contention free 4-step or 2-step random access in the RACH resources defined in RACH-ConfigCommon, excluding preambles used for other purposes (e.g. for SI request). If the field is absent, all 64 preambles are available for RA. The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":24838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bedc2aaaa941ffd8394e593a8dfad2d10821f83d729fe6801b920669ce33c5c8","9c3bde0c1563ed1740d93588c7486aa51bcf7feb176ef06352d0a6b1973d3127","2417feb44027dbf19029eb30c636fd155bb57f67e310f3002ca326d8eb895600","c9a9b74d0e902f4f82f85236b3db4ecba8f445929b0bab037790090f7e139074","4ad68158b5d7a1afb2adf51d5a9741ded19cf3589ecd2383f6cacda3e6526c94","b5203b5fde4fc7d88c1afbbef62a5d439ea879889bac4e4129127023825489e7","fd398c44332c3e8d4bd67e48a6f19917c23dd516208a2cff9d25cbe7623216a3","c5daa0a29a3a5d5f867500b23cb726fabbe2835f5ab14f40c87fc494c70e83d6","db2bb61a7bf89b4b4c60d7e90765b38064e6b1bb01e3aeb92e6a6acf13bb049c","4411be89d552e15ee926ec7a0f17b2e7e3fa15189a6ece0066b9e9870b9ae190","dfcab6362edd136ee9702c89b3a70ee001e39f4bf66a2db3f399c3ca13ebf9d2","3ae7e753042b3f2b92982db560caf711e6ac43a7e21d0d7a433cffa94ef98927","829f3ee8a3942e13e2daa66432665facec62f1ee6f6c00f437cb03fb6640cd04","ec0a089233fe29683f5f8b01122f0c965dd8113960ba43fae7e36a82bcc3728b","4a9284958510267b5927896aa36d82b8efbced993a49cdea0739c6660d703ea6","d363d8ddc726f595a7e189f987b471cfe90fba01df899694b5c0ac0f2540075d","f4e9095a3a4346d11ec694dff20ed3deea81507009e5e4b67a278b09c5469583","5dc9cc618cc42cded725a5fab2136a182cf0ffe132466994d3a9c8a3ffc8e388","adda20328aeed76111483a54e4860b7409af78d4ef69f787194c818e70378a00","01924097c9e7d6cf496c52eca4a8a3fe56082f39ad0799ea444c5fe896f2c957","7080c15dc1099e4131d346c2613256c3ea356afc98ae24dbb752dad030af9dfd","c75ad05b5a8565c7253ed30f163c11c3873a5e3908005d325a7bea10db279306","b2e6516ab84f6a86f1b927a0c64eed909249257497b264bc30fbb838c5a072fb","9d20a3789efaf5a8fba0b35136885f7553a7a4e8a9f8813f4cdc38ec779e13f4"],"paragraph_range_zero_based":[24816,24839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p24816"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24840},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24841},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":24842},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the RACH-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap, this field is mandatory present with at least two FeatureCombinationPreambles list entries: one list entry indicating only redcap and the other(s) indicating both redcap and one or multiple other feature(s) (e.g. smallData, nsag or msg3-Repetitions).","paragraph_zero_based":24843},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":24844},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":24845},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":24846},{"literal_text_all_w_t_and_m_t":"L139","paragraph_zero_based":24847},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if prach-RootSequenceIndex L=139, otherwise the field is absent, Need S.","paragraph_zero_based":24848},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":24849},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in rach-ConfigCommon in initialUplinkBWP if supplementaryUplink is configured in ServingCellConfigCommonSIB or if supplementaryUplinkConfig is configured in ServingCellConfigCommon; otherwise, the field is absent. This field is not configured in additionalRACH-Config.","paragraph_zero_based":24850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24851},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigCommonTwoStepRA","paragraph_zero_based":24852},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigCommonTwoStepRA is used to specify cell specific 2-step random-access type parameters.","paragraph_zero_based":24853},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA information element","paragraph_zero_based":24854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24855},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-START","paragraph_zero_based":24856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24857},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA-r16 ::=                   SEQUENCE {","paragraph_zero_based":24858},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGenericTwoStepRA-r16                      RACH-ConfigGenericTwoStepRA-r16,","paragraph_zero_based":24859},{"literal_text_all_w_t_and_m_t":"    msgA-TotalNumberOfRA-Preambles-r16                   INTEGER (1..63)                                    OPTIONAL, -- Need S","paragraph_zero_based":24860},{"literal_text_all_w_t_and_m_t":"    msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB-r16   CHOICE {","paragraph_zero_based":24861},{"literal_text_all_w_t_and_m_t":"        oneEighth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":24862},{"literal_text_all_w_t_and_m_t":"        oneFourth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":24863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0bb2b1416fe257484