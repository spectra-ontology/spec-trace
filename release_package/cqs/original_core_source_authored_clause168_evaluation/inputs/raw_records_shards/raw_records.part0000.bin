ased":34696},{"literal_text_all_w_t_and_m_t":"    naics-Capability-List               SEQUENCE (SIZE (1..maxNrofNAICS-Entries)) OF NAICS-Capability-Entry         OPTIONAL,","paragraph_zero_based":34697},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":34698},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34699},{"literal_text_all_w_t_and_m_t":"    spCellPlacement                     CarrierAggregationVariant                                                   OPTIONAL","paragraph_zero_based":34700},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":34701},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34702},{"literal_text_all_w_t_and_m_t":"    -- R1 18-3b: Semi-statically configured LTE UL transmissions in all UL subframes not limited to tdm-pattern in case of TDD PCell","paragraph_zero_based":34703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f87bb5e503e66be10a5d0d621e8cd10423e57e774e5334545a74308d7efa38d7","93ac8b350d4d56282a099339ef3383610e296330604436c28040da5a8fd6a29a","3ba154c66f3547a25653a258644ff8adf1a79ea243ad357fc734873456fbf97d","d52bc79e791c5a1219ee44254fbad6cc7fa86b3a3c7980544c685d1a73e80d68","99b79d64d033c84ee66990e8758d6e341c2fe2b69278e071b1f38a99981affd5","e74b656f9231f3b902e5de354f409e1adf002f3c7b0e509b86471d11d9b2e76e","1a3cafb4c690011a7ea8b515de85c0f6f8e6ac6015eee46aaa36feb0268d7d01","d91371e213136d8b8ccd255ee4a047b9bd87e962cdf1b7802bac15626f4587b0","2d4147ac390895b332d89339423753672034a150d6716f1e57f9864557fbce29","16ef9d2994388af97d59e3c253b7bd6f80e2d8a508306680bd68b716ac900a62","5404185aa755add271ed21649e27e01e1a4b548c54ffb2b960498c104991bde0","ae93f5200404e82df2d973954f9dafbde