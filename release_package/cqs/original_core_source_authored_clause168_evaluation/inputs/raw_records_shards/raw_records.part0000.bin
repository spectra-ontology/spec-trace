{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-MaxNumConsecutiveDTX-r16          ENUMERATED {n1, n2, n3, n4, n6, n8, n16, n32}                          OPTIONAL,    -- Need R","paragraph_zero_based":2304},{"literal_text_all_w_t_and_m_t":"    sl-SSB-PriorityNR-r16                INTEGER (1..8)                                                         OPTIONAL     -- Need R","paragraph_zero_based":2305},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2307},{"literal_text_all_w_t_and_m_t":"SL-NR-AnchorCarrierFreqList-r16 ::=  SEQUENCE (SIZE (1..maxFreqSL-NR-r16)) OF ARFCN-ValueNR","paragraph_zero_based":2308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2309},{"literal_text_all_w_t_and_m_t":"SL-EUTRA-AnchorCarrierFreqList-r16 ::= SEQUENCE (SIZE (1..maxFreqSL-EUTRA-r16)) OF ARFCN-ValueEUTRA","paragraph_zero_based":2310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2311},{"literal_text_all_w_t_and_m_t":"SL-DiscConfigCommon-r17 ::=   SEQUENCE {","paragraph_zero_based":2312},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-ConfigCommon-r17   SL-RelayUE-Config-r17,","paragraph_zero_based":2313},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ConfigCommon-r17  SL-RemoteUE-Config-r17","paragraph_zero_based":2314},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2315},{"literal_text_all_w_t_and_m_t":"SL-DiscConfigCommon-v18xy ::=   SEQUENCE {","paragraph_zero_based":2316},{"literal_text_all_w_t_and_m_t":"    sl-RelayUE-ConfigCommonU2U-r18   SL-RelayUE-ConfigU2U-r18,","paragraph_zero_based":2317},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ConfigCommonU2U-r18  SL-RemoteUE-ConfigU2U-r18","paragraph_zero_based":2318},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2320},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB12-STOP","paragraph_zero_based":2321},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2322},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2323},{"literal_text_all_w_t_and_m_t":"SIB12 field descriptions","paragraph_zero_based":2324},{"literal_text_all_w_t_and_m_t":"segmentContainer","paragraph_zero_based":2325},{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB12-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB12 is broadcast.","paragraph_zero_based":2326},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":2327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["bab91531054e028e395dcf4198e8f0ee3bcbce923941f252314b16d3a22acd1b","3fe190781775419f0ed9beebc986b26b37f9907176c36ee377b5ea53a57f1db9","c37521df2f348fa74644ca0e09b2186c08cd2d133a069183fb82350044d2574d","46ac8b4ec61fdc04e8f2e12e934192bfe89c29352d897442626853484144ea4e","a86967741153044c2076b46eb233e92b7e69015827d2376e104dbf94b616f72a","7da7525adc19e765326a8e69c95a39feff9874b17f5a0bf623ef0d0c42dd1e90","2ae79d7a02b78580748d2df4a933ba3f80f0c50e080801f6bb80ad53f69a4509","ef498ad216cd713b731d43878fb2047345613ef5553f9c6bc8f50002f3a54846","fec4d040edc8a22b784f396ad10322ed4b9cbb7c786e19c22637ef16d00c9d14","94f67666c0bce69d492be1b761206af868bc411a283c4c03ad00e43100acad48","b7caa98b1601f89c6a9fce2ed15c3a720bd882f7b482f34444cc764acdd2bb4a","dd2ef18c04856227bd81b6fa198434ca5d1db3e859d519e01ac1e74b7570aaf0","60e53738272c0b2bae2a8f78cd259f82a5279011b04be35b897fc7f719de574a","53137ab03c638f7e56da3429e5d4115f32b5e9b4647c3830dc661b4c5fdc3f18","59e3adcccb0c26f97e5cd0b2e42106c2f290a3bfbc96a8c8e48f12827c58b478","a46338e63e86043a9c1c4cffb801dbd8ab4074ff21ccd3eb3d63a4dc7b6d4b37","6eb5112f3c0c8a089447f69acb9abe3ec186a49e4e0cc470149c0deb96f5bed0","758ef9834697720968c46d0544579fe8dfaca53066f936a0369c7ce080bf8694","5fab9893f04c5e266d8ffacac746b819a43bf981929bcef3f043e3728f641282","9219075870b32105a9ebcc9b46d20b124f8179b589c54233382a9dbdfb8cae8b","38d3b89cd28cb39a415b1a7a935e7bf0c289d4650f7b9a66907dd7b671f33734","135740bbaae08c2196776880f855cfc7d28ed0c98f33bd15be31283a506e2d14","076c17efd8d315e62681b1966c3baca9d826e9cc582d1d5401fef030bfdae2bd","6170e21b7f71540e24cda5fd32d1cd8d388240af66d05f609cab8b4394c5b02d"],"paragraph_range_zero_based":[2304,2327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx:p2304"}
{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB12-IEs. A segment number of zero corresponds to the first segment, A segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":2328},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":2329},{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":2330},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":2331},{"literal_text_all_w_t_and_m_t":"This field indicates whether CSI reporting is enabled in sidelink unicast. If not set, SL CSI reporting is disabled.","paragraph_zero_based":2332},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigCommonGC-BC","paragraph_zero_based":2333},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3]. This field, if present, also indicates the gNB is capable of sidelink DRX.","paragraph_zero_based":2334},{"literal_text_all_w_t_and_m_t":"sl-EUTRA-AnchorCarrierFreqList","paragraph_zero_based":2335},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configurations.","paragraph_zero_based":2336},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoList","paragraph_zero_based":2337},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication/discovery configuration on some carrier frequency (ies). In this release, only one entry can be configured in the list.","paragraph_zero_based":2338},{"literal_text_all_w_t_and_m_t":"sl-L2U2N-Relay","paragraph_zero_based":2339},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink Layer-2 relay.","paragraph_zero_based":2340},{"literal_text_all_w_t_and_m_t":"sl-L3U2N-RelayDiscovery","paragraph_zero_based":2341},{"literal_text_all_w_t_and_m_t":"This field indicates the support of L3 U2N relay AS-layer capability, i.e. NR sidelink relay discovery.","paragraph_zero_based":2342},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":2343},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":2344},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigCommon","paragraph_zero_based":2345},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement configurations (e.g. RSRP) for NR sidelink communication.","paragraph_zero_based":2346},{"literal_text_all_w_t_and_m_t":"sl-NonRelayDiscovery","paragraph_zero_based":2347},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink non-relay discovery.","paragraph_zero_based":2348},{"literal_text_all_w_t_and_m_t":"sl-NR-AnchorCarrierFreqList","paragraph_zero_based":2349},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication/discovery configurations.","paragraph_zero_based":2350},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":2351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["2145428230a4b21bfb809f15f74171015fe3bb0007655e7fd44088108768e353","4e499af260c9659dda447b3d9b7809d78c09c6b00dd2b4dd2d3a8083aec5bd4b","5d6c9b607fe9da93e390e2cc8f0ccc19ced0f3d75387e9c6855