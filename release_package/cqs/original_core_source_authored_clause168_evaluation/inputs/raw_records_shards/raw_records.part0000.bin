{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR1 in the cell group;","paragraph_zero_based":6480},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR1 in the cell group;","paragraph_zero_based":6481},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":6482},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":6483},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-1 in the cell group;","paragraph_zero_based":6484},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-1 in the cell group;","paragraph_zero_based":6485},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":6486},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR1 and reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":6487},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-PreferenceFR2-2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6488},{"literal_text_all_w_t_and_m_t":"2>include maxBW-PreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":6489},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":6490},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":6491},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-2 in the cell group;","paragraph_zero_based":6492},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-2 in the cell group;","paragraph_zero_based":6493},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":6494},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":6495},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxCC-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6496},{"literal_text_all_w_t_and_m_t":"2>include maxCC-Preference in the UEAssistanceInformation message;","paragraph_zero_based":6497},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers for the cell group:","paragraph_zero_based":6498},{"literal_text_all_w_t_and_m_t":"3>include reducedMaxCCs in the MaxCC-Preference IE;","paragraph_zero_based":6499},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsDL to the number of maximum SCells the UE desires to have configured in downlink in the cell group;","paragraph_zero_based":6500},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsUL to the number of maximum SCells the UE desires to have configured in uplink in the cell group;","paragraph_zero_based":6501},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of secondary component carriers for the cell group):","paragraph_zero_based":6502},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs in the MaxCC-Preference IE;","paragraph_zero_based":6503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d0953be5c5a2b6e6ecfc91a8015fe0bd3d3538839cf9240611694deab5a68f26","7484a92b6810972915e1e0ff2ed7c44fa67c1760e17583bf085ecb4affed4cf0","3ab6b0cf192b26ecc1a386e489c5a08be4dc6c60e3689afbdbf4c77efe291cfa","eb77c44c271c4a2a9fc19b81b356031132e9909cc632410518b88294e52edf96","1332a6c696f09921e62c7280b3c0420098b6f17d540c542363bc5658fe8241e5","f136caf9cc4357b83e521d3cf7ecee5342c42fd3efacbac780d9a2df5d0d060e","a89351dae302b908a51d1aa0f0cdd3a960f8839f89d2646b6fa32167278377e8","ba8c3f1d1c27b93ed6a8e2bd5b5d2bc5d1cbd7341242cd02d34a05acce7978e2","650f06564324c2fad4ac1d51a21ac643087623964a4051166eece1c715130cdd","83991a47fb4e359bcd300ce3e8a9ae0156bf221bf390c131044ddec5d7fc6c7f","e0dbd3feae559243a19c64fa2dbbc47b2cd19cf750975b426185432ae4aec00c","0af6a178af3111cd2185f139f1eb73eba217ba90043d0008be9a35e71a59b1fd","15dc210ff834a17d074aa41d17302a7df481cb65169546daaf8ba11844adf5c1","a94be91a56242217ac0c9f76ef8d0032ff7b6a7eced229011a884b1c2fee519f","b0f86e173808fd9db2994ee9d017f26910668bc7c70817a5825401c7140d71ab","e2484eaa76587fd1318055f32187aa15f1409991734926393e0b7e63edee0bac","1547230982becff8a67fb31ee17f12fcc40820e8dc5d75e4e55937f0e5b9caaa","29f4386bb23a3b22aa0cc3fd510500cc922b74580b6e9fce5c73921d3ce30b08","22bc8005835fb6d47fea9c9ead8916fa2288ee62ccbc0a27e4bf21a85ff133b6","3c4e1c376d838e4a0d1f3e9db54b916f74724ffe70ef69657b396a05befb6625","9a8c9af89389c0fcc1de4d308624332aa4de30bcfefd686e2198f26e017177af","1526253648814964dd50ae1ed89d3c6be03cc60f8156a3a6556af18dbd6e4034","d461cecf3de775a1001492bb6244193a9b0a00c1cfbf722e97ef88a40ea19d37","72c3d946ce2973516ab1cb8deae2b1eadcf4e7dc9bed31cd8a3f2d65457c4cd4"],"paragraph_range_zero_based":[6480,6503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p6480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 3:The UE can implicitly indicate a preference for NR SCG release by reporting the maximum aggregated bandwidth preference for power saving of the cell group, if configured, as zero for both FR1 and FR2, and by reporting the maximum number of secondary component carriers for power saving of the cell group, if configured, as zero for both uplink and downlink.","paragraph_zero_based":6504},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxMIMO-LayerPreference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6505},{"literal_text_all_w_t_and_m_t":"2>include maxMIMO-LayerPreference in the UEAssistanceInformation message;","paragraph_zero_based":6506},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers for the cell group:","paragraph_zero_based":6507},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":6508},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":6509},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6510},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the preferred maximum number of uplink MIMO layers of each FR1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6511},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":6512},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":6513},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR2-1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6514},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the preferred maximum number of uplink MIMO layers of each FR2-1 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6515},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":6516},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR1 and reducedMaxMIMO-LayersFR2 in the MaxMIMO-LayerPreference IE;","paragraph_zero_based":6517},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxMIMO LayerPreferenceFR2 2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6518},{"literal_text_all_w_t_and_m_t":"2>include maxMIMO-LayerPreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":6519},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of MIMO layers for the cell group for FR2-2:","paragraph_zero_based":6520},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the number of maximum MIMO layers of each serving cell operating on FR2 2:","paragraph_zero_based":6521},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2 2 IE;","paragraph_zero_based":6522},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the preferred maximum number of downlink MIMO layers of each BWP of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6523},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the preferred maximum number of uplink MIMO layers of each FR2-2 serving cell that the UE operates on in the cell group;","paragraph_zero_based":6524},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of MIMO layers for the cell group):","paragraph_zero_based":6525},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxMIMO-LayersFR2-2 in the MaxMIMO-LayerPreferenceFR2-2 IE;","paragraph_zero_based":6526},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide minSchedulingOffsetPreference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":6527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["aa54bc9159ee915058593ad20acb53a68d1df54b31baadd6aa94692975499ada","cbfd2a2b9dad9b2981023faded1b2fe6a2fc6d06efdff55cece07a905cc6b682","835331cfab703f4acf871ee34a21d9c78f7a5f6fd374ddd1c64ecd17debc5ce3","06f7b65683f5ccf9c23ff2033732531c5ca36ef5bd017ad503c42bff1f79d304","c89472b9ab4fe372c242db17d9c36f65cfac290b533298efa7dd27e60c629898","d80e7aaf60bbce4cc752b4ac69014b139c9e21f63c5cb4d2a2cf253f5596af94","7d6cbf616f47e454a5b892df6cee8eaa301d3d112a5d57a1dea34822fbffff1a","0a1ee32225fef639d4067e9a622353501060e7006a8d7429dfc54a42a0f08a66","32ee7776432e3f83a48c5bea2673514214580c1806f6d9627eedfe8c1c452da2","48919c7b8534d122f5a9cac1cd9dd44e299f7d1a1d0c5328a88cc647a482da72","8df4a5e22f962eed9c82f075e02c660347c1800541a10fbcba0eff3330bc3b33","27c2874d68ef36e7de5743144874d5561ee29a364fd0859c5426808c8040fbbf","a2ef9fdabdb79a6872cc0cc7cf7777a94f7c341b005e59280