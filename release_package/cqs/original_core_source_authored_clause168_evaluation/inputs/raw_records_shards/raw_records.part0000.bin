{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rxTxTimeDiff-gNB-r17                RxTxTimeDiff-r17                    OPTIONAL,   -- Need N","paragraph_zero_based":8856},{"literal_text_all_w_t_and_m_t":"    ta-PDC-r17                          ENUMERATED {activate,deactivate}    OPTIONAL,   -- Need N","paragraph_zero_based":8857},{"literal_text_all_w_t_and_m_t":"    sib9Fallback-r17                    ENUMERATED {true}                   OPTIONAL,   -- Need N","paragraph_zero_based":8858},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                         OPTIONAL","paragraph_zero_based":8859},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":8860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8861},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFER-STOP","paragraph_zero_based":8862},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":8863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8864},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer field descriptions","paragraph_zero_based":8865},{"literal_text_all_w_t_and_m_t":"rxTxTimeDiff-gNB","paragraph_zero_based":8866},{"literal_text_all_w_t_and_m_t":"Indicates the Rx-Tx time difference measurement at the gNB (see clause 5.2.3, TS 38.215 [9]). Upon receiving this field, the UE calculates the propagation delay based on the RTT-based PDC mechanism method as described in TS 38.300 [2]. The network does not configure this field, if the UE is configured with ta-PDC with value activate.","paragraph_zero_based":8867},{"literal_text_all_w_t_and_m_t":"sib9Fallback","paragraph_zero_based":8868},{"literal_text_all_w_t_and_m_t":"Indicates that the UE fallbacks to receive referenceTimeInfo in SIB9.","paragraph_zero_based":8869},{"literal_text_all_w_t_and_m_t":"ta-PDC","paragraph_zero_based":8870},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE-side TA-based propagation delay compensation (PDC) is activated or de-activated. The network does not configure this field with activate, if the field rxTxTimeDiff-gNB is configured.","paragraph_zero_based":8871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":8872},{"literal_text_all_w_t_and_m_t":"–DLInformationTransferMRDC","paragraph_zero_based":8873},{"literal_text_all_w_t_and_m_t":"The DLInformationTransferMRDC message is used for the downlink transfer of RRC messages during fast MCG link recovery.","paragraph_zero_based":8874},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB3","paragraph_zero_based":8875},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":8876},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":8877},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":8878},{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC message","paragraph_zero_based":8879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["e28ea206fbe200f928383cebcd5bf349d192776883a48a110a004028338c1ce0","e2d6f866289e4fbc2ad7ce147f2c6c3a8b241729eb19c6a28102fe71277b17b4","7c5fd2c89393fbdaf3b3c4b9e388abb918ada5fa719b89c8ab097eff962ad673","f87e7eef2a9a6db8f63bd92045fef9437c5f790d71aff3b579e33a9b5229d3ed","9c3522e76544dbc15149a89a0f46fa3144e377a7238777abc04420fb3a1f7920","0376a58e1372207b10e4f99daaad47f320dd67806bb48a8cc38bdd1fa443063f","6da7d6c852397f6fdfbd19ed9e3a85a0dae851b2cc484792bf0d37dba6e2b856","6d22c8db902ce966c28d980710271d172b3b691746b7a5330b61af65a688d60d","72e166e65900c6eeca16704087209261fe61