{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"E5b Signal Health Status","paragraph_zero_based":1008},{"literal_text_all_w_t_and_m_t":"E1-B Signal Health Status","paragraph_zero_based":1009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1010},{"literal_text_all_w_t_and_m_t":"–StandardClockModelList","paragraph_zero_based":1011},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1013},{"literal_text_all_w_t_and_m_t":"StandardClockModelList ::= SEQUENCE (SIZE(1..2)) OF StandardClockModelElement","paragraph_zero_based":1014},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1015},{"literal_text_all_w_t_and_m_t":"StandardClockModelElement ::= SEQUENCE {","paragraph_zero_based":1016},{"literal_text_all_w_t_and_m_t":"stanClockTocINTEGER (0..16383),","paragraph_zero_based":1017},{"literal_text_all_w_t_and_m_t":"stanClockAF2INTEGER (-32..31),","paragraph_zero_based":1018},{"literal_text_all_w_t_and_m_t":"stanClockAF1INTEGER (-1048576..1048575),","paragraph_zero_based":1019},{"literal_text_all_w_t_and_m_t":"stanClockAF0INTEGER (-1073741824..1073741823),","paragraph_zero_based":1020},{"literal_text_all_w_t_and_m_t":"stanClockTgdINTEGER (-512..511)OPTIONAL,-- Need ON","paragraph_zero_based":1021},{"literal_text_all_w_t_and_m_t":"sisaINTEGER (0..255),","paragraph_zero_based":1022},{"literal_text_all_w_t_and_m_t":"stanModelIDINTEGER (0..1)OPTIONAL,-- Need ON","paragraph_zero_based":1023},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1024},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1026},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1028},{"literal_text_all_w_t_and_m_t":"StandardClockModelList field descriptions","paragraph_zero_based":1029},{"literal_text_all_w_t_and_m_t":"standardClockModelList","paragraph_zero_based":1030},{"literal_text_all_w_t_and_m_t":"gnss-ClockModel Model-1 contains one or two clock model elements. If included, clock Model-1 shall be included once or twice depending on the target device capability.","paragraph_zero_based":1031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["fa390fe683cd3822afae07d1ed76cd3883778066baf249b8926bc95a47e837c8","be53298b7637907985e6248dc6f584ebc6cf54eb0f03f4a82d10de29dffd2cc7","1588bbbb3b0ed47c380b600106bcd318b5d5bdd851780ea851ac3d4ce49fcb0f","1c8cafd536ef7b62b146a900db0428c021e97ce38bfb73cdb133e4ec423078a6","88890fc5fc59398ea01bdf8070aa07981b7305d1158b0b15ea0817a06ae2a277","b55f2457bb1f1ae344a5bb09f66b355ed0b69dc0efe365ca5886463f17bde693","b3230119ddfd3df8afea06ab79885a19aa3dcc934db0394e4046f05e2c85b54a","f7641cb94da43c04e94bdcded41c7d86746edca92a96772106062b594736bd30","a28c39dd9f9226d41f5f9b5e4a18791c7d42983a8c70f3658fda8da305a1dc7d","201c048f5207287ac1d9f19eb177f96ea2475699c67fd815bb35e53c7590185e","ffb8280cd170e3d4d23035e44e6abada370c7077f3ecac881985f14183e8cb3e","e225e25fc2c0ac6eb736e49f899aecc05af8dec0e65d1af92513ee254f23006f","006ca68934e806d7be9faac25ce59b83fe5c6e54f6c5d89340a4f4377fe8ef74","79ee239194cdda062bbffe32bdf3a0584b99966f409204180d294aab234f28fe","6ee5e261c8bc881cf80c4cd09fc02a0d9adfc8b2b81bf2bada9f100f2d19ecce","78933cacd279c4909588cc565d4c8976f3effaa71b57809ca1afa72cdf499817","c48306c231c5aa1a3928f252d3cb865c3d7627a914c580c9939f28074a8b8727","f0fb8f0e3f16231cddb73a71987e3ac7dfcf9aced021f90928c680952301190e","37757541472a4492e34b744a9c