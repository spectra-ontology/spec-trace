{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the GNSSID = sbas; otherwise it is not present.","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"GNSSIDBDS","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"The field may be present if the GNSSID = bds; otherwise it is not present.","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"GNSS-ID-GLO","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, if the GNSS ID = glonass; otherwise it is not present.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"GNSS-ID-NAVIC","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, if the GNSSID = navic; otherwise it is not present","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"End of changes","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"Start of changes","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"6.5.2.2GNSS Assistance Data Elements","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"[…]","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"–LOS-NLOS-GridPoints","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"The IE LOS-NLOS-GridPoints is used by the location server to provide a list of grid point coordinates or an array of correction points (\"grid\") for which the GNSS-LOS-NLOS-GriddedIndications are valid.","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-GridPoints-r18 ::= SEQUENCE {","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"gridPointsSetID-r18INTEGER (0..16383),","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"horizontalGridPoints-r18        ArrayOfGridPoints-r18,","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine-r18INTEGER (0..9)   OPTIONAL, -- Need OP,","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"verticalGridPoints-r18        VerticalGridPoints-r18 OPTIONAL -- Cond 3D,","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["042487721c4915115558d0dbc9e1cdf1ede9aa941fb526a5e18725400228f9ae","1664c3a8b41a1ed897b3acc8becd76b2c528b549e59a026a14b863e5a91f6bda","92853c27985919e16fe5ee8b7825a054375dd788a377c3267ea65988b84c3593","13d34c09b7990136d06f51ba7b85c293ffe0a06825d7a58f24fd75d78d1c2354","dd7746d400af33ee92ac55535888af042a5e3064142e80150886e8fc31f0fef6","2f8263d6f9a49f0bcd8085b3b68effdc79466128dcaaf5195d1cad75458eb75f","78e2c74d7335d3c62d8845a938eead21c6302d0dabd3d5ec91791ebbc306ad11","988af82e0808a066a20445a978020e54b9499951abb88af20daf070b2e9ba165","352722110c67ab24a8a8071a30fd662de11a6cce931d5686e731cda6cea1fd3a","34730bc977f86da06658752eea38ef744e682408af27d7040684727a3e63d826","8db21c23c19d1c30516d829d8cdf5379d3754d99f48380cb3d5f133126280842","b2136f9f4e34d43aa77a56cd934d70e9e5614fd4657aa6cb5b6bfefe72727276","db33b44b6556fb66edf57c533bac6e46732d75e0c14f3fc403f81faa89e03ece","33c872af69d50dd4cb0b5a89c5f1ad69ceb0ce0e19423fa08f8a49764c449cd7","119669053820f8634919b2c3c0b83d517fd31f7cc7bafd1b609c746dce595b13","90a4fbe5c71f93349c112d5cb9ad8eaf8526