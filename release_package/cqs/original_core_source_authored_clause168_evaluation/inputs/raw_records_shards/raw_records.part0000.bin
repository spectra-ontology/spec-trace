{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BWP-Id information element","paragraph_zero_based":15120},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15121},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-START","paragraph_zero_based":15122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15123},{"literal_text_all_w_t_and_m_t":"BWP-Id ::=                          INTEGER (0..maxNrofBWPs)","paragraph_zero_based":15124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15125},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-STOP","paragraph_zero_based":15126},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15128},{"literal_text_all_w_t_and_m_t":"–BWP-Uplink","paragraph_zero_based":15129},{"literal_text_all_w_t_and_m_t":"The IE BWP-Uplink is used to configure an additional uplink bandwidth part (not for the initial BWP).","paragraph_zero_based":15130},{"literal_text_all_w_t_and_m_t":"BWP-Uplink information element","paragraph_zero_based":15131},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15132},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-START","paragraph_zero_based":15133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15134},{"literal_text_all_w_t_and_m_t":"BWP-Uplink ::=                      SEQUENCE {","paragraph_zero_based":15135},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":15136},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-UplinkCommon                                            OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":15137},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-UplinkDedicated                                         OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":15138},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":15139},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15141},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-STOP","paragraph_zero_based":15142},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8804513e61ad6ea3214fda288f3e8a55db9005c82d0e4770f8d852457a3de706","8e18b80cd2f388b70957287374afa5d1c2376c9347f03c9e94e3e494e2dd53a6","d65f2d3d96cbaa19631f3a73eb8cc9e6837fceeb1581831346fc4e2ae985cf98","908397972eff5577bd5755df5a9f842059f6b6f6bf09a592b1ddf8c5ceee6955","f0a82445fed9c27de078947d6466162285d338b076943c9330b4ab500c7e4c34","a660cbb0a48388c6d1096ec2cf3ff187fdc04fd995d0285036f100ca2f5e0517","52e3b0631331c63b8886306a325dab7e39c9d76ef4d4c3a88f96c6d998dd27c0","87ecdf5bbcb7bd2b270c2d6a922838523585dc8c0988fe4bf5b9338f75876ec5","f38b16d9bc2728e460944b2142e3cc708cbab7dde59d65c3a90baa1c57a7a1a6","7eb2a6338d537f670d626b657424c3009b967e0bf10019e6dd9f9ca10e46d79e","1b855bca5b981c0b93ed2c2fa53e89e8d686c553e54fb7970347b2deab37c55f","590861b1a3e9b00668c4392ac30efb77f2fb5af4ae56bff8dc1280366fd41ee6","f8eaa3e7bbe3a75aca0414d32ba16737b559e75278ba8fe9cd3c281159a4c9b3","388f1eab00613942574b4fcadbfea0b0c8a30751efc7abc00cc1e0e464c1e83b","7b38afe98b448e9692233b9b98323a91ecca6f38ebf026d75addb21966f60739","1e5cdc87880207586eb6f809a91010a4818f6492bccfd19732c9fd2c777c7f89","c7eeb55f0e22d95a69275eda8337a61fe578c9ccf684caf644d99c0311203211","3c2edeedac9cd036890d5f2e5fd176898cd69c8d45c9242e9b7ccab2e13a73dc","a0f2fb39bc102efcf84cf3449542228106627c9a857f9ed673dbde889f721bb9","4b96efa53d248da70cfaa98ea3f9f04b166dd2846ad19f3b5afcfe0e4387b017","fff1197b573ed9eadeaeb00b2591de245a28dafa365a21a72d939aceaf179e4c","efca78ca0d3348a371e0cadc223d5c04437de0cb7a9e6e3c94f327580e28124b","4ff4c0a5bf56b41f0ae3d2a4805264bea6003bac55ba9c9b7007256ab90d8881","4221748f366d011050e541753f4a27d413051ecb98324ca4d08057c2ab36808d"],"paragraph_range_zero_based":[15120,15143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15120"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15144},{"literal_text_all_w_t_and_m_t":"BWP-Uplink field descriptions","paragraph_zero_based":15145},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":15146},{"literal_text_all_w_t_and_m_t":"An identifier for this bandwidth part. Other parts of the RRC configuration use the BWP-Id to associate themselves with a particular bandwidth part.","paragraph_zero_based":15147},{"literal_text_all_w_t_and_m_t":"The network configures the BWPs with consecutive IDs from 1. The Network does not include the value 0, since value 0 is reserved for the initial BWP.","paragraph_zero_based":15148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15149},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15150},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15151},{"literal_text_all_w_t_and_m_t":"SetupOtherBWP","paragraph_zero_based":15152},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new UL BWP. The field is optionally present, Need M, otherwise. ","paragraph_zero_based":15153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15154},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkCommon","paragraph_zero_based":15155},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkCommon is used to configure the common parameters of an uplink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":15156},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon information element","paragraph_zero_based":15157},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15158},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-START","paragraph_zero_based":15159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15160},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon ::=                SEQUENCE {","paragraph_zero_based":15161},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":15162},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon                   SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":15163},{"literal_text_all_w_t_and_m_t":"    pusch-ConfigCommon                  SetupRelease { PUSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15164},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigCommon                  SetupRelease { PUCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":15165},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15166},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1bcf01c037441544a3840dadc0e51f6f742bd72060569d826ca59caecba6dbf5","2401e8e5483e561668995b19023571c136b0c3c30232ad3e14eb5679490b8efc","aaf0a2dc83efa69d6f69273144dadf1a19126de1a68d7a8255045af1fb278496","a0aa6e988b3a7f4d7f8ab7f22fd05c74cc667c6fb19102564e0b663d2557d984","b7a03bf9df3458cb1d550959732a8b04c48eeedab98467bb1cb1b47cd0457e6d","0d1fc330515ef081ea8b0281d9e65dff1c43eae85366ff8a941fc1cce320618c","c7609b88cfa4e8deddabe84009b9fa84e78642f0885bbb2b1fa83f73b6cb9e80","e5ba0859bc2e52cb77dd1508e8d9bdb575db8bf09839e93f71e1600738c5df4c","5263480c952328a3a50b32c01151f3b17c7f7bdff4008076bb10e33dc3653247","9a590f138095805adec26336259890ce302b5b78a90456f07b8d2f5b0e2ceb96","ebf898274a0591b9db1f91132c250e3031ca02945fef4cbbd1fcdb2245d57a0f","c7eab354003899b3d8efb4dd1eb535a65296670b54a3879876888a15eb882085","187e8788d6c10ca1b666b745e39cac4d65249e23e64b347166c3e2ecf9062edc","c276d155d21bcc89f9051ad6ed00bf3eadf3aef9a06467539bc0bb66afb6e94e","2b425958fb42b74fb684ba5753798aded5484924bd45c6bd077d5bf6380aebe1","23d759620d4bd7a5fb6112b0efcdecb0ea573cb6962352cb1303b728d348b92d","e3650c19a8e0ed64505947df850f6bb1861a0ff35abfaf940c305b108cb5156c","0b6432924514b542edf5852f467d95daa73cf521c7d65f3d0296c200bd316f49","17ab980b221469095a2c613d18631abf26c9eb950062080e667feff16e49b4d1","5d583495e88fc0ac98b0341b278c1730b5bd8edea04ed0dbac870e4dee8027c3","00d068e70bb88c4bc5baac43949f321e902b139a6a568544d61f6d8a760e9add","c1b6f45f2f477404a41313c6626b04f7110454bc95ba6fa4f770d849f9aef3c0","2cebecc88c8123bc61ced40d758d25cfda680305bf17eb46aa1eb107cc397d32","3817da5497da2ea0e71ddecaa5ecfe3a8850d751240a8b94465e8930a6fc7ef2"],"paragraph_range_zero_based":[15144,15167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15144"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonIAB-r16            SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":15168},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":15169},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r16               SetupRelease { MsgA-ConfigCommon-r16 }                                  OPTIONAL    -- Cond SpCellOnly2","paragraph_zero_based":15170},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":15171},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":15172},{"literal_text_all_w_t_and_m_t":"    enableRA-PrioritizationForSlicing-r17 BOOLEAN                                                    OPTIONAL, -- Cond RA-PrioSliceAI","paragraph_zero_based":15173},{"literal_text_all_w_t_and_m_t":"    additionalRACH-ConfigList-r17       SetupRelease { AdditionalRACH-ConfigList-r17 }               OPTIONAL, -- Cond SpCellOnly2","paragraph_zero_based":15174},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg3-r17              RSRP-Range                                                   OPTIONAL, -- Need R","paragraph_zero_based":15175},{"literal_text_all_w_t_and_m_t":"    numberOfMsg3-RepetitionsList-r17    SEQUENCE (SIZE (4)) OF NumberOfMsg3-Repetitions-r17                  OPTIONAL,  -- Cond Msg3Rep","paragraph_zero_based":15176},{"literal_text_all_w_t_and_m_t":"    mcs-Msg3-Repetitions-r17            SEQUENCE (SIZE (8)) OF INTEGER (0..31)                               OPTIONAL   -- Cond Msg3Rep","paragraph_zero_based":15177},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":15178},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15180},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-ConfigList-r17 ::=       SEQUENCE (SIZE(1..maxAdditionalRACH-r17)) OF AdditionalRACH-Config-r17","paragraph_zero_based":15181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15182},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-Config-r17 ::=       SEQUENCE {","paragraph_zero_based":15183},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon-r17               RACH-ConfigCommon                                                   OPTIONAL,  -- Need R","paragraph_zero_based":15184},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r17               MsgA-ConfigCommon-r16                                               OPTIONAL,  -- Need R","paragraph_zero_based":15185},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":15186},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":15187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15188},{"literal_text_all_w_t_and_m_t":"NumberOfMsg3-Repetitions-r17::=         ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16}","paragraph_zero_based":15189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15190},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-STOP","paragraph_zero_based":15191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bf2524909d9f9ae06d158ae5cf341eb7c80411c19c014b0de3fb78656efb4e39","c14f1e4f562b7dfbcb891fecbc6c0894aa835638c03a0736ecd33f24a71955ac","667ba25403e088cf186aff2077b7bb7a13cb4d14781f18e22bd67b535cfc171f","5aafeab0981b6d6422da279d69b4c9b3d4258f65bd7de6d38911af3badfde02c","3bc9d9eb1fc4bd691fd7eeb7396d5ed433a79cefe1db9ebae1e82938225137f5","ac1806750f1b6096205675c75af6576af0e16d0ba241922d14c1f3f2124ccb91","f9dd326b831927d6c514977531e3b8b56241380e11080e60f0268924fb08cd6e","b0147ae86ac591b218c1a6b40deafa2c03614390263ec7004e3c5bbfe0846590","366ea43deaa1b5f8dba609415abae03a97d8b903416c3a4dffce508e1a98bebc","0ab42d0c4d6f11b79b9a7b1f23a1163d11a04c5edf1d433865317dbce273522a","a9ab610a2698a9da831e30ffcc40d27ce393a194d7647472867007e037da756f","64c33400dcf076eebc9500dea6adffab7353bb4402b4e5304e6a9794007ffe33","2c03bd522cb40d4911d5be9ea7e5688dcda672affe97c50bdce2b696a2b943d2","58689918519e7172366130a962ab3bdf39025e345910c1528168a3458b5bf789","0451dd6a89f044cb438800b47103d26a0d5ef637031a58c614187ed4c5bb5df1","414d4d0ce611a028f146bf54744243300a3fee0c23a173bf9fdd169801a4b421","a71519baaf67d89b9051987c8a54ce9e573ffce5b6666d40e2b92f91968d941e","2c869f3e6df1260affd2245c16165c94208f6d3e766c3395c7c9f089e3915185","5e58da62d22f15b50c984a4e1c4e760519e839f66594cf2fdb3199474d5bff08","00abd932099e0acaa0f32cbfa69080d4161f1ad268abba214a8ba72b747560f4","c69600b39248a5d3da1c9a6a9f77ed0695a4eae4db5547395349787966f9ebf4","78aa20e62a931f1641bf610fc87eacf5a4c19a6b1c6ec1c88c556a90a0a16ec6","d926e31a0e3e079994ce2f3bf4f22366b7faec90b4a4818dbf1fa3f2e39a6085","fd422dfa24cbed24e3484dcc8701f3d0eb154cd06c8aa2c0bbef41b932d161bf"],"paragraph_range_zero_based":[15168,15191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15168"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15193},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon field descriptions","paragraph_zero_based":15194},{"literal_text_all_w_t_and_m_t":"additionalRACH-ConfigList","paragraph_zero_based":15195},{"literal_text_all_w_t_and_m_t":"List of feature or feature combination-specific RACH configurations, i.e. the RACH configurations configured in addition to the one configured by rach-ConfigCommon and by msgA-ConfigCommon. The network associates all possible preambles of an additional RACH configuration to one or more feature(s) or feature combination(s). The network does not configure this list to have more than 16 entries. If both rach-ConfigCommon and msgA-ConfigCommon are configured for a specific FeatureCombination, the network always provides them in the same additionalRACH-Config.","paragraph_zero_based":15196},{"literal_text_all_w_t_and_m_t":"enableRA-PrioritizationForSlicing","paragraph_zero_based":15197},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep should override the ra-PrioritizationForAccessIdentity. The field is applicable only when the UE is configured by upper layers with both NSAG and Access Identity 1 or 2. If value TRUE is configured, the UE should only apply the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep. If value FALSE is configured, the UE should only apply ra-PrioritizationForAccessIdentity. If the field is absent, whether to use ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep or ra-PrioritizationForAccessIdentity is up to UE implementation.","paragraph_zero_based":15198},{"literal_text_all_w_t_and_m_t":"mcs-Msg3-Repetitions","paragraph_zero_based":15199},{"literal_text_all_w_t_and_m_t":"Configuration of eight candidate MCS indexes for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. Only the first 4 configured or default MCS indexes are used for PUSCH transmission scheduled by RAR UL grant. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {0, 1, 2, 3, 4, 5, 6, 7} (see TS 38.214 [19], clause 6.1.4).","paragraph_zero_based":15200},{"literal_text_all_w_t_and_m_t":"msgA-ConfigCommon","paragraph_zero_based":15201},{"literal_text_all_w_t_and_m_t":"Configuration of the cell specific PRACH and PUSCH resource parameters for transmission of MsgA in 2-step random access type procedure. The NW can configure msgA-ConfigCommon only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or for RedCap UEs DL BWPs associated with nonCellDefiningSSB or the RedCap-specific initial downlink BWP.","paragraph_zero_based":15202},{"literal_text_all_w_t_and_m_t":"numberOfMsg3-RepetitionsList","paragraph_zero_based":15203},{"literal_text_all_w_t_and_m_t":"The number of repetitions for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {n1, n2, n3, n4} (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":15204},{"literal_text_all_w_t_and_m_t":"pucch-ConfigCommon","paragraph_zero_based":15205},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUCCH of this BWP. ","paragraph_zero_based":15206},{"literal_text_all_w_t_and_m_t":"pusch-ConfigCommon","paragraph_zero_based":15207},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUSCH of this BWP.","paragraph_zero_based":15208},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommon","paragraph_zero_based":15209},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free random access as well as for contention based beam failure recovery in this BWP. The NW configures SSB-based RA (and hence RACH-ConfigCommon) only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or for RedCap UEs DL BWPs associated with nonCellDefiningSSB or the RedCap-specific initial downlink BWP. The network configures rach-ConfigCommon, whenever it configures contention free random access (for reconfiguration with sync or for beam failure recovery). For RedCap-specific initial uplink BWP, rach-ConfigCommon is always configured when msgA-ConfigCommon is configured in this BWP.","paragraph_zero_based":15210},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonIAB","paragraph_zero_based":15211},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters for the IAB-MT. The IAB specific IAB RACH configuration is used by IAB-MT, if configured.","paragraph_zero_based":15212},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdMsg3","paragraph_zero_based":15213},{"literal_text_all_w_t_and_m_t":"Threshold used by the UE for determining whether to select resources indicating Msg3 repetition in this BWP, as specified in TS 38.321 [3]. The field is mandatory if both set(s) of Random Access resources with MSG3 repetition indication and set(s) of Random Access resources without MSG3 repetition indication are configured in the BWP. It is absent otherwise.","paragraph_zero_based":15214},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":15215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["45c7c21568a5b35f22378f9b206315c3717f6025f3cec5ba8a1083443855e4ca","0460ba00af534db7cd66686e385d730e2e2540423eec7d08e8d607f224566883","d6886c0dbf21436f53c503cbb4d0b587c5bbc43ba086d012fbc152ca8712a111","e61182a82d87a666d82918413a76180ab2b01ed3fc98812f2d14aa917957b311","b9350d857db51fceef107ca6860f42da7a0eba44ece37be82d5dd38c473ee0b4","f00f9af8da3958a4900a9efa7e6103090e7961ac7d0986fc86505e26345e4311","157ff8253bb669a1d1dc76308ff22ceffdbd470412301180a8172690726360a9","ee38980b93ec0f95a8f05de2ef9dd8c77ed58806d047bdddbcd8ee0abc688692","c3cd66dd3b82eab3e1c15fd53f32202b17a7f661373fc3e0b75f2d3d0ecff3b6","b3145614f5427fbda874c2e4e6b91bc117f96e6e140c328e17e2ee91132856fe","6c275a7502b96c685d261c868143d52ac5aaa0ee52cd4ebc954041d01216e1ca","e9a277b965f59346a80fa3a7bc5c112e2fda3daf36f0b4d6bb1acba2d962fd0d","9380632e2f682da6c2254a36cfeca4dc5a58223e3fb63611df44d73e322583a9","b5794ab2d0550a8bc1dcc4ed588b385e5c767549871cd51a772e18a16dafc1b5","ea7fa2118a2951a861a72e8d067d07c27b7f3ef88126f6d5180a50a1fdb9afe2","3af1ec85e23d7db4548c9063119045c96751f79e526f61e1c949ad70be86c13b","652d2612abd8dbcbb233d7438055bacc8c435edf98dddc064f0a7e6536d82fc8","3cc8e04a6a026970ef35f422eb546f270526f9fa25f760f35e0206a93ea0e6a1","d3799b2b32d3d62954b57c123e7859d6d09ef0fc5af81cad6c6467b311abe91e","a5dd2e30b515efbd1c64c2811b75d5b55ca69e25c25c5ea1fc67766adfaccc44","55d78fabae4817f081fab24c6cf50949862612d6cfc626ba2774f2de4a08dfd8","f249e2c68cbe14067086033c7c90b3fdf7779988897e3a2e10724bc312845392","d5bc5cb56148291c3ceb8f158b5e38a9e3956379d7cf8649aa78ba1f8dc3ea5a","10b056407664ee15afd86a28ebe240c4d91de3ae441770caaaa9364fcb104b84"],"paragraph_range_zero_based":[15192,15215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p15192"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for cell-specific PUSCH, e.g., PUSCH scheduled by RAR UL grant (see TS 38.213 [13] clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0 and 1 for cell-specific PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":15216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15217},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":15218},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":15219},{"literal_text_all_w_t_and_m_t":"Msg3Rep","paragraph_zero_based":15220},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon. It is absent otherwise.","paragraph_zero_based":15221},{"literal_text_all_w_t_and_m_t":"RA-PrioSliceAI","paragraph_zero_based":15222},{"literal_text_all_w_t_and_m_t":"The field is optionally present in SIB1, Need R, if both parameters ra-PrioritizationForAccessIdentity and the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep are present in SIB1. It is absent otherwise.","paragraph_zero_based":15223},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":15224},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":15225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15226},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkDedicated","paragraph_zero_based":15227},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkDedicated is used to configure the dedicated (UE specific) parameters of an uplink BWP.","paragraph_zero_based":15228},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated information element","paragraph_zero_based":15229},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":15230},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-START","paragraph_zero_based":15231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15232},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated ::=             SEQUENCE {","paragraph_zero_based":15233},{"literal_text_all_w_t_and_m_t":"    pucch-Config                        SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15234},{"literal_text_all_w_t_and_m_t":"    pusch-Config                        SetupRelease { PUSCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":15235},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfig               SetupRelease { ConfiguredGrantConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":15236},{"literal_text_all_w_t_and_m_t":"    srs-Config                          SetupRelease { SRS-Config }                                             OPTIONAL,   -- Need M","paragraph_zero_based":15237},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryConfig           SetupRelease { BeamFailureRecoveryConfig }                              OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":15238},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":15239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e71493bbb1b0054ccc31e3028faccb322fe0dd11d3c071421d807f0a289619be","03c6b6bb8a1430686b3588186d9c