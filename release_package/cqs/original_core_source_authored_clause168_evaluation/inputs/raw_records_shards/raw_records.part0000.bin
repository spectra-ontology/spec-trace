{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":505},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":506},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":507},{"literal_text_all_w_t_and_m_t":"Relative","paragraph_zero_based":508},{"literal_text_all_w_t_and_m_t":"This field is present if a relative position is included in the request. It is absent if the field gridPointSetID-Req is absent.","paragraph_zero_based":509},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":510},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-GridPointsReq field descriptions","paragraph_zero_based":511},{"literal_text_all_w_t_and_m_t":"gridPointsSetID-Req","paragraph_zero_based":512},{"literal_text_all_w_t_and_m_t":"This field specifies the ID of the grid point set for which the GNSS-LOS-NLOS-Indication is requested, optionally with relative location information.","paragraph_zero_based":513},{"literal_text_all_w_t_and_m_t":"relativeLocationInfo","paragraph_zero_based":514},{"literal_text_all_w_t_and_m_t":"This field specifies the relative location info in relation to the requested grid. The relative location info can be ","paragraph_zero_based":515},{"literal_text_all_w_t_and_m_t":"Inside to narrow down the grid scope","paragraph_zero_based":516},{"literal_text_all_w_t_and_m_t":"Outside to describe which side (north, west, south, east, above, below) of the specified grid the target device wants new grid data","paragraph_zero_based":517},{"literal_text_all_w_t_and_m_t":"verticalGridType","paragraph_zero_based":518},{"literal_text_all_w_t_and_m_t":"This field specifies the type of vertical grid that is requested by the target device – either a ground level or a 3D grid.","paragraph_zero_based":519},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine","paragraph_zero_based":520},{"literal_text_all_w_t_and_m_t":"The requested fine altitude reference of the grid. Scale factor 1m.","paragraph_zero_based":521},{"literal_text_all_w_t_and_m_t":"referenceAltitudeCoarse","paragraph_zero_based":522},{"literal_text_all_w_t_and_m_t":"This field can only be provided combined with a 3D vertical grid type and specifies the coarse altitude, scale factor 10m, of the upmost layer of the grid relative to the WGS84 ellipsoid.","paragraph_zero_based":523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":525},{"literal_text_all_w_t_and_m_t":"End of changes","paragraph_zero_based":526},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["0b45d2638c97ababde1834e66cb7e8e6690937ce666ccff8258d629eb0fe018e","1b6f5558405a7070d030aeebeae884ccaed12597095f6de3b105e943cf5f48be","570e9791928f46166c02487e6de8f12ac9237b08604e05f2b34c0a75ed86d8af","d6f4d3a9c550c8c39a8f3a6acfd01e5ca3911543a37160e119a2ee2c9dff74af","adcda9d73e89e73ed85ab401a3128e7a801362183ce87816ed7a4fce34cfa8f5","e7dbcb8fbf822098e66ce0ab0909e551b1d5a3beed55e576ce6032b9a545e1dc","b6392310572cecbe0566dc9cbf8c85c08520af64375b43de0c9b5df16d906738","b3c138dc353b825710b5e7908274502f4d56eea94fad7e389efebc9bd1d49bb2","7c7ff3c7c3685445d672a8978c1da4b5589a33e022659858461fabaab79030f0","55a343aec81213c504ae908b396e87678a141ba564e174de0cbedb9c79ca0a30","dcf9eecb14384a73197105ed0c198e7a58332be02e08255757971639a443eec8","fdb3f4a4d40b9b65285e75bb2c0143f33ff6db80ede47f3602d9ac18f96c149a","8de3d00e0cc9302e924cabe525654e97599ac2e94fd0f0335abe