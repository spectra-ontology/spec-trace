{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    messageIdentifier               BIT STRING (SIZE (16)),","paragraph_zero_based":13776},{"literal_text_all_w_t_and_m_t":"    serialNumber                    BIT STRING (SIZE (16)),","paragraph_zero_based":13777},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentType       ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":13778},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentNumber     INTEGER (0..63),","paragraph_zero_based":13779},{"literal_text_all_w_t_and_m_t":"    warningMessageSegment           OCTET STRING,","paragraph_zero_based":13780},{"literal_text_all_w_t_and_m_t":"    dataCodingScheme                OCTET STRING (SIZE (1))                         OPTIONAL,   -- Cond Segment1","paragraph_zero_based":13781},{"literal_text_all_w_t_and_m_t":"    warningAreaCoordinatesSegment   OCTET STRING                                    OPTIONAL,   -- Need R","paragraph_zero_based":13782},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension        OCTET STRING                                    OPTIONAL,","paragraph_zero_based":13783},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13784},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13786},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-STOP","paragraph_zero_based":13787},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13789},{"literal_text_all_w_t_and_m_t":"SIB8 field descriptions","paragraph_zero_based":13790},{"literal_text_all_w_t_and_m_t":"dataCodingScheme","paragraph_zero_based":13791},{"literal_text_all_w_t_and_m_t":"Identifies the alphabet/coding and the language applied variations of a CMAS notification.","paragraph_zero_based":13792},{"literal_text_all_w_t_and_m_t":"messageIdentifier","paragraph_zero_based":13793},{"literal_text_all_w_t_and_m_t":"Identifies the source and type of CMAS notification.","paragraph_zero_based":13794},{"literal_text_all_w_t_and_m_t":"serialNumber","paragraph_zero_based":13795},{"literal_text_all_w_t_and_m_t":"Identifies variations of a CMAS notification.","paragraph_zero_based":13796},{"literal_text_all_w_t_and_m_t":"warningAreaCoordinatesSegment","paragraph_zero_based":13797},{"literal_text_all_w_t_and_m_t":"If present, carries a segment, with one or more octets, of the geographical area where the CMAS warning message is valid as defined in [28]. The first octet of the first warningAreaCoordinatesSegment is equivalent to the first octet of Warning Area Coordinates IE defined in and encoded according to TS 23.041 [29] and so on.","paragraph_zero_based":13798},{"literal_text_all_w_t_and_m_t":"warningMessageSegment","paragraph_zero_based":13799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f471fff9e4a70ce1798a99cfa2d069fad0fdea5e39318654b934ed8e33aebab0","22104b8b5e7ef6953cc392a7963308be7a3615f100cb32070660c45e69237b2b","df7a373ce75cdb60812ec97a231b87ca6d6a6cb7cea31e71a5e1ea9bd70c5538","90a13972e9d3466d2da4ce8ce9c4845694b7c5f353bf1fd0ad54ab9e7c6ad335","aafd519373e14193fa74c01aebad55f9a5aa3285ab01dd015420ad825f1211ff","529172606f0110363f7c5674724bbb24e7c501ebd816b368599e1021f9d6cfd6","7b1973bb46dd884f5089ceef5a9785d16ce894fffe22c4e3126b43a2d0d8465f","5f4fbc164b4b88f4c88672858eac01f06d74101e397d6bd6a9d1452b7d8c7180","55b0251e5a6caddc05bfa9349c69fff540224c88492c8f6da51ddc70bc6a6111","fc12cfcabc2985eb14edf3211113131c81858ae973e7026c20a873dea863d89b","bf5ce3eead1d3973c4c1e6768394efd5e2cb335f1e1f2ff76b0864915aea68b3","f9978ebda97613e2a8c75ba4c2b5317470f20047206a4a50e42909570a43b376","02d9e4a8f0f665ba8f0e068ffeebc64a1a4a23292c515a04d9aa54afd52353d8","2dd0f9e18dec7a90235f3e6f6172aaef51fbc9d6950254683004c9f65ab0197b","75b8ac35ea57e1b3bcab7b5e1dc2fe737cfcb1f04bfc7fdb737eff4a659661aa","a17e6e1ab875cdb1936618e1b36d2df1e6e9560381947cc2b4105297eeac37d8","c568ff4474a07279499d33b304c9741ab60f11917b59d67012c427f7f3196d5a","5e1729184e0170a81301189a6bb3ac150ac1c114a8ae228e677237a0765afde3","3c4854ce680669025931d4e46e1f6cf2869b4fd4aefe74573f6edfc08ab0473c","be8dafa6b2dcbe9cd636d5466899b34afffd3ae79da1aa903049424285cf363f","718fc80676783558c13c82ebd6568a91499b8a981a4fa71767b484235b292a68","51bb2dc97930353b7759125bbec105d42f0468163a768f62abb1093931ca98af","80365379d4a88552ce431a194cb883f45990eea5d289a7de79550f2ce4107868","56c589926cca31973824d7477b178fddc2b0bc52651eb81b3c197f5a2d32356f"],"paragraph_range_zero_based":[13776,13799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p13776"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Carries a segment, with one or more octets, of the Warning Message Contents IE defined in TS 38.413 [42]. The first octet of the Warning Message Contents IE is equivalent to the first octet of the CB data IE defined in and encoded according to TS 23.041 [29], clause 9.4.2.2.5, and so on.","paragraph_zero_based":13800},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentNumber","paragraph_zero_based":13801},{"literal_text_all_w_t_and_m_t":"Segment number of the CMAS warning message segment contained in the SIB. A segment number of zero corresponds to the first segment, one corresponds to the second segment, and so on. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13802},{"literal_text_all_w_t_and_m_t":"warningMessageSegmentType","paragraph_zero_based":13803},{"literal_text_all_w_t_and_m_t":"Indicates whether the included CMAS warning message segment is the last segment or not. If warning area coordinates are provided for the warning message, then this field applies to both warning message segment and warning area coordinates segment.","paragraph_zero_based":13804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13805},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13806},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13807},{"literal_text_all_w_t_and_m_t":"Segment1","paragraph_zero_based":13808},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first segment of SIB8, otherwise it is absent.","paragraph_zero_based":13809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13810},{"literal_text_all_w_t_and_m_t":"–SIB9","paragraph_zero_based":13811},{"literal_text_all_w_t_and_m_t":"SIB9 contains information related to GPS time and Coordinated Universal Time (UTC). The UE may use the parameters provided in this system information block to obtain the UTC, the GPS and the local time.","paragraph_zero_based":13812},{"literal_text_all_w_t_and_m_t":"NOTE:The UE may use the time information for numerous purposes, possibly involving upper layers e.g. to assist GPS initialisation, to synchronise the UE clock.","paragraph_zero_based":13813},{"literal_text_all_w_t_and_m_t":"SIB9 information element","paragraph_zero_based":13814},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13815},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-START","paragraph_zero_based":13816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13817},{"literal_text_all_w_t_and_m_t":"SIB9 ::=                            SEQUENCE {","paragraph_zero_based":13818},{"literal_text_all_w_t_and_m_t":"    timeInfo                            SEQUENCE {","paragraph_zero_based":13819},{"literal_text_all_w_t_and_m_t":"        timeInfoUTC                         INTEGER (0..549755813887),","paragraph_zero_based":13820},{"literal_text_all_w_t_and_m_t":"        dayLightSavingTime                  BIT STRING (SIZE (2))                   OPTIONAL,   -- Need R","paragraph_zero_based":13821},{"literal_text_all_w_t_and_m_t":"        leapSeconds                         INTEGER (-127..128)                     OPTIONAL,   -- Need R","paragraph_zero_based":13822},{"literal_text_all_w_t_and_m_t":"        localTimeOffset                     INTEGER (-63..64)                       OPTIONAL    -- Need R","paragraph_zero_based":13823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1621d6439476df58ef43f0faa42b2db353586553984161035bc022963a12d3d5","f7e09252104833eb4a6402d6aa509eef408decbb426aaac71b36921bfb070c70","b2c755b0b506ffd99683cd7388c479f92f289260e9e091df3d35042f0a1587c7","617b594c0a0410702eb0b199a9fa962e1da036069ff16eae304a53bac0cd2c89","d938544c32d8539685700caecedbfc385b6e71861d4e7d77f6133c24537c79f5","f8f06e8b4382d38e2e70c6e662e63e3862fee69084ac985b7041563fcf5d5f65","e8b5be4640d09de4cd8725cb15a751a0513ff102f7db2bea7955a533ddb03717","7b2ac0cc558ffb2f0b4a6fc77717417b11017629da3e781c84c9df5330e1974e","5b4c10e4248ba9b017e028defc1f9e0f9c4eff916e877ef7ac7b480237fe97ec","ab3c4daf833818c96c3fb2a56d98c4d8479aaf65a806a704cd111fdfad54f3db","ed94cf2b8345cadfc11c6fb5c7100b810b2458d75ba6d0b98bd8def35af0c3d6","fa17331f010125f8dd3f2632990c3f3787c4584bab9c3900e6698fbc07ab7a9c","5d2071f4f8b87e8ac580f9e925c998a601a95dbe68d0740199232d32762f2d8e","54eea358e0ef3ae1e4fe6668df9776ff8e064c1b8ccec4eee6d646f66692583e","5348c1b3a0b7b6541ea7c29df66ff3cae6462d5401f74f6f9209ec96927aa5b0","3b30aaacc3e9792a454d2f6bfdc2359d47316d2eb601b46c7fe3d419df521a5e","97079579fc9e2622222c7f9d77e064ea99220efaee6debdc08547b5b46f04f27","52c8a6e2e752ac102d712e29d0b6b99b4c49ffc57cb1fed1005e7ae0e57a5f9b","0685aa5266958d1c81f2d2027ad0c890f23963004431f46e73634d5473c159e3","b236ae1df87e4d11c5620daf040a67e6160166a61647d1fb0119c8de68f574d2","e5511c5e7fe6ebd4567531f8bacd4798195dac53ca3b835493798bc633e59e57","7cef233c13c8a63689d1bcf8c09b67b5e2c4af5402c5897f0ee9ed60fbce71a2","a36e72958c9e5eeb4258cfae85a5c01819aed20b9a80c0ebfb7db520e770612d","d1a71448518782ba7de7be04ec9df9b8a01ca2df92f2ecf1071264ac9bebcec2"],"paragraph_range_zero_based":[13800,13823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p13800"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":13824},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":13825},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":13826},{"literal_text_all_w_t_and_m_t":"     [[","paragraph_zero_based":13827},{"literal_text_all_w_t_and_m_t":"    referenceTimeInfo-r16           ReferenceTimeInfo-r16                           OPTIONAL    -- Need R","paragraph_zero_based":13828},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":13829},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13831},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB9-STOP","paragraph_zero_based":13832},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13834},{"literal_text_all_w_t_and_m_t":"SIB9 field descriptions","paragraph_zero_based":13835},{"literal_text_all_w_t_and_m_t":"dayLightSavingTime","paragraph_zero_based":13836},{"literal_text_all_w_t_and_m_t":"Indicates if and how daylight-saving time (DST) is applied to obtain the local time. The semantics are the same as the semantics of the Daylight Saving Time IE in TS 24.501 [23] and TS 24.008 [38]. The first/leftmost bit of the bit string contains the b2 of octet 3 and the second bit of the bit string contains b1 of octet 3 in the value part of the Daylight Saving Time IE in TS 24.008 [38].","paragraph_zero_based":13837},{"literal_text_all_w_t_and_m_t":"leapSeconds","paragraph_zero_based":13838},{"literal_text_all_w_t_and_m_t":"Number of leap seconds offset between GPS Time and UTC. UTC and GPS time are related i.e. GPS time -leapSeconds = UTC time.","paragraph_zero_based":13839},{"literal_text_all_w_t_and_m_t":"localTimeOffset","paragraph_zero_based":13840},{"literal_text_all_w_t_and_m_t":"Offset between UTC and local time in units of 15 minutes. Actual value = field value * 15 minutes. Local time of the day is calculated as UTC time + localTimeOffset.","paragraph_zero_based":13841},{"literal_text_all_w_t_and_m_t":"timeInfoUTC","paragraph_zero_based":13842},{"literal_text_all_w_t_and_m_t":"Coordinated Universal Time corresponding to the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted. The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900). See NOTE 1. This field is excluded when determining changes in system information, i.e. changes of timeInfoUTC should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":13843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13844},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may use this field together with the leapSeconds field to obtain GPS time as follows: GPS Time (in seconds) = timeInfoUTC (in seconds) -  2,524,953,600 (seconds) + leapSeconds, where 2,524,953,600 is the number of seconds between 00:00:00 on Gregorian calendar date 1 January, 1900 and 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":13845},{"literal_text_all_w_t_and_m_t":"–SIB10","paragraph_zero_based":13846},{"literal_text_all_w_t_and_m_t":"SIB10 contains the HRNNs of the NPNs listed in SIB1.","paragraph_zero_based":13847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8