{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"AMAcknowledged Mode","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"ARPAddress Resolution Protocol","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"CIDContext Identifier","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"DAPSDual Active Protocol Stack","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"DRBData Radio Bearer carrying user plane data","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"EHCEthernet Header Compression","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"FIFOFirst In First Out","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"gNBNR Node B","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"HFNHyper Frame Number","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"IETFInternet Engineering Task Force","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"IPInternet Protocol","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"MACMedium Access Control","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"MAC-IMessage Authentication Code for Integrity","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"MBSMulticast/Broadcast Services","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"MRBMBS Radio Bearer","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"MTCHMBS Traffic Channel","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"PDCPPacket Data Convergence Protocol","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"PDUProtocol Data Unit","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"PSIPDU Set Importance","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"RBRadio Bearer","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"RFCRequest For Comments","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"RLCRadio Link Control","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"ROHCRObust Header Compression","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["7f904d202c86c79ddcdc4ffe4bd0d621e24c6e7302e9c5044d47a10a5d80c54a","42376afb897ecb1b3864b9181f349e2ece85539efea6264b5edf07d652a2a5a7","66126d306066b73ba517305634d2b099260af1eeb31b9440a0d6decbd479ade8","1b2f7540dd0d8d1e7ee5855aed72be2a018f44294f55b2aa195ef9592e752fb1","8c335c4198601175331e1fdeb75ff0dc3f1d81843d78e210316a7f8186ea7eb8","43c1abfbf0508edf6483132a5ca43f6252056d0af030105c01fdb9c09a09bf8a","b5c8820f806ce8b2f3f7ba253754ca3ae595e64b5fdd7143b393e58287a3b79a","6c23fae8afa5fa0a18568f2ad05d6153fea17f5c63d1f3eb6e89008aa3c44b02","08e931615b633d515601d08ed7acf45417cbe41a515d33d1aef332500d4a9448","97f062358de2ba7aac74e509e805fc1a54c66b1751c55bdf7c51136dc5dcc372","b2debaa268a1d0bef973d11c25af3ffd3090912d7a39b560507dd20441deef9e","6f530d344cae5fcd7b36660b9418b8b5c6cbe006f38c69715e9dd79dc8a9974e","77404bd1f03e4289cc357da7ba6608bda6bc3ec0f10cbe27719966652588c6b2","175ad386b1c09efb7909fbe769985d03639313f37960d750feef33960b816c5c","a74b0ceb89289cada0c43a337998b784546120694f748f531f95754abb0498d6","1f55a65788d40599dcdfc25a7bb4b63571bd5b7fbed70de613571bc46676cc07","dee8b20fc84d83448e5feea336195d170c6cdde9f402c059bcde51def678b7a4","aa2896b0d45fd88609a347924ddd80ad3ba437180b6f613a5dbf72d139c51dc2","d0b76ef4d9b7fb78bbc24efaf3c83b51a77fbf0c4aa60b4584f7966a52f63e0a","aaa1be71acf8a7cd9d6ab9d41678b9b38bd67fb4526a303997522b578a637b23","20675f302438a8eddc5fd3ee1397403867c42420e34c4630a840a54009803be0","b11c6ac25d99d30206e714a96db6d4d31d80c9a72b45b77b9694613f41d56973","b2154d82c74eab8eda529448cb28d91752e605ee0e2e2fa60443046ea5b2819d","05fab6cb45c8acadb2715c429f1befd6334ebf4c53a2ba227b9288ca8cfcf1b2"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p168"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCRadio Resource Control","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"RTPReal Time Protocol","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"SAPService Access Point","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"SCCHSidelink Control Channel","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"SDUService Data Unit","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"SLRBSidelink Radio Bearer carrying NR sidelink communication or NR sidelink discovery","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"SNSequence Number","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"SRAPSidelink Relay Adaptation Protocol","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"SRBSignalling Radio Bearer carrying control plane data","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"STCHSidelink Traffic Channel","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"TCPTransmission Control Protocol","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"UDCUplink Data Compression","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"UDPUser Datagram Protocol","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"UEUser Equipment","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"UMUnacknowledged Mode","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"U2NUE-to-Network","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"X-MACComputed MAC-I","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"Editor's Notes: the need for new abbreviations are FFS.","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"4.4Functions","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"The PDCP layer supports the following functions:","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"-transfer of data (user plane or control plane);","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"-maintenance of PDCP SNs;","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-header compression and decompression using the ROHC protocol;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["02d716a856bd0879bee467cbc18d99b86af6e8e3e7c9d4166e8be19188aae31a","d94f9c24b08dcbed6fe6a13ec5063faff87eae08735976b037bfc3c48207ddcd","cf5a4b3ccbbebc14012e071e5ac4f028bcd4eab224188ee39d2d246f392a54fa","53817ab49e97b663f049410f8a67eb0678d750ab6291db5a8a07d12d1d4a0d67","f2e831343b465a5e10698a1f0bdd34cfe55348087afc9b0e3a93d425542ac49b","993a42708a0dc1f7f3bd7f76f1b88ce71a36e0c92a65c970b5dba6b25336575a","633d3d0f30128bf08b4c6e9436b525d3b961d529670beca26234ed90bb934aca","c180fffec1cee323b5d77cf0231e8e381644b180565208b94e3d1fb33d1bdfee","66bdfa63adb33b6b2e6396147ac687e7ffa98701cdbe3b1c91821d073cd66678","8eb78087ec11c8b1b50b20d3ae9ff5776cf03fb8f49f5a8a6eb17ff3e4709550","f5f6e284fb6058b3ce792cf77f02ddded6a890d9bf512089f370396830853d8e","b1e8bcf0ba78a0126804621ffcc7e4f4c989bbfa7152832717416798debc9f59","39e4b811e98e0decaa19525cfafd7fe7ef87a4367cd91302746c3335958bb276","714780302053c92058d9a9e6106fa2e906be9071879af0f70392c5445864b9fe","3eb42cf007cf821149e164bde7ef59b11f9ecfee7ab01eda755ebe09bb93c833","647e05ddcff25ae5d87db961049bbc3eb6e392724c0a6d569aacef6e2a1c6bab","57b549614b68d5703f2f9274d5b290354c201978bc2edb8dac04452df176b9b2","59909f0c66ecb65ff13659a50bcb84586513d615047daf8ea56d6b498364c779","593c610bc02863ad1d1d373deb836a4d9af9ef27a245e148cae7ab21f4e20ce7","23c5671420b3a020df3840ab42d88b9d1ae64ae777207ce5807ceef4130faf82","da48ff4178c380790e72b8063f58719d178cc7a811fee7cc9bc2392247ca0320","0e07a67a7817c68e07d8c1dd9ae06a60f2e3553f5dd01583739e113b35cf5397","c3e8b615c90f5a837949380b586eb6630a81a38b0defa436297fdbb62c86d5f6","83c1d4aec84c59ec2a83b2b9a32490e9f6f0ac7160cdc3e378b4ef11e5ac3440"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p192"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-header compression and decompression using the EHC protocol;","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"-uplink data compression and decompression using the UDC protocol;","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"-ciphering and deciphering;","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"-integrity protection and integrity verification;","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"-timer based SDU discard;","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"-PDU Set discard;","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"-PSI based SDU discard;","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"-for split bearers and DAPS bearer, routing;","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-duplication;","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-reordering and in-order delivery;","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"-out-of-order delivery;","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"-duplicate discarding.","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"5.1.2PDCP entity re-establishment","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"When upper layers request a PDCP entity re-establishment, the UE shall additionally perform once the procedures described in this clause for Uu or PC5 interface. After performing the procedures in this clause, the UE shall follow the procedures in clause 5.2.","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"When upper layers request a PDCP entity re-establishment, the transmitting PDCP entity shall:","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"-for UM DRBs and AM DRBs, reset the ROHC protocol for uplink and start with an IR state in U-mode (as defined in RFC 3095 [8] and RFC 4815 [9]) if drb-ContinueROHC is not configured in TS 38.331 [3];","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"-for UM DRBs and AM DRBs, reset the EHC protocol for uplink if drb-ContinueEHC-UL is not configured in TS 38.331 [3];","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"-for AM DRBs, reset the UDC compression buffer to all zeros and prefill the dictionary if drb-ContinueUDC is not configured in TS 38.331 [3];","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"-for SRBs and UM DRBs, set TX_NEXT to the initial value;","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-for SRBs, discard all stored PDCP SDUs and PDCP PDUs;","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-apply the ciphering algorithm and key provided by upper layers during the PDCP entity re-establishment procedure;","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"-apply the integrity protection algorithm and key provided by upper layers during the PDCP entity re-establishment procedure;","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"-for UM DRBs, for each PDCP SDU already associated with a PDCP SN but for which a corresponding PDU has not previously been submitted to lower layers, and;","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["1f48fdad7863e6e826ff4110c4e2c5c640db5f88629b6843bad258dd94df585b","29096da7e3163847b48ebc51af87ac9685e3a72d83fc61ea65ad9539517bc821","43e4d1ae39c8f4ca524610531ef5e2434efcdb427f80dc8186a326ed3682b6a0","86122d910670e57a08bc278ba76dd027a2cda92d52e741dd6cf9341177a9c691","8dca28887c78aa1320fa05b56315ce7ce428746de9dee5b377845b3156dae3e7","9cc13f81ec558cf59b7f4545d8c629dda9e5f85835c9d5615b2cf81bf1d67e09","ead169b85e80f4472db1c68acc56260d456d5de9def33f60045e68e7c3692915","33a329842bf04c12f87f75ed4445a41a0d38f2645f8feac92431118d3e1a2364","90cf5038437c913e50c4822f707e4d9fd2413e6671bcf799183f68e6b4ba39fd","f64f7d20b3bd9e12702a597e8fc9fff6cb926f3084c793a2c405eed63049f60b","4a9270994b3ac2b5b391f264e06b0f5d4ab04102122879b05b44cdba22e39816","8e232a322e49f6b4758e169242590f1699ef5bf6cc22dac2ff36c779b8fc885f","cd83d963191ab26bee6822cdfe4522af95f92035f8df27670273f97f8b0ba5a1","f58a61deb99b14986fb64bcbb83a95ffa2a0f7630ced1b996fb2b6823aefc48d","8a83ac6be1701a50405115458e8d1f91001902e28790e983b69a603714839de8","459a913e0326448c81de67bd3383f6486d01b68191e9be223d5068a94f78db96","df3f163b10b179ae33963d39b2ccad41813cd328ece65f4153c3b26d389ffd9e","02b28a36bbba111483de9740693c8ba2e1657f0114571344f8780f7cc9adaf8c","9cc443f9b1ae18ec919c5c86ddbaec58d0fc4f09b9d76ebc2487a0f27dc5aa8a","3e4548590bd710a0ad6ce1932f82943d3d3b8311406b838a776b9693abf5f4e2","7641c9c643070dc45214337eeaca7a792318b3c8654fd1b7330a924bfdf7fb69","009ad01f496b70ec8913268cc420cc27e744bb523f544e36e566ee5f9e790f8e","daf20e940105aec27d271d42f200f8554f569ea3a7ee30b4bbc553eb49b2f7ca","c7560d0b8b91b84301ac2fbf1094167df1bb9c7b791ce90c37ce105988623dd1"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p216"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-for AM DRBs for Uu interface whose PDCP entities were suspended, from the first PDCP SDU for which the successful delivery of the corresponding PDCP Data PDU has not been confirmed by lower layers, for each PDCP SDU already associated with a PDCP SN:","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"-consider the PDCP SDUs as received from upper layer;","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"-perform transmission of the PDCP SDUs in ascending order of the COUNT value associated to the PDCP SDU prior to the PDCP re-establishment without restarting the discardTimer or the discardTimerForLowImportance, as specified in clause 5.2.1;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"-for AM DRBs whose PDCP entities were not suspended, from the first PDCP SDU for which the successful delivery of the corresponding PDCP Data PDU has not been confirmed by lower layers, perform retransmission or transmission of all the PDCP SDUs already associated with PDCP SNs in ascending order of the COUNT values associated to the PDCP SDU prior to the PDCP entity re-establishment as specified below:","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"-perform header compression of the PDCP SDU using ROHC as specified in the clause 5.7.4 and/or using EHC as specified in the clause 5.12.4;","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"-If drb-ContinueUDC is configured and if the PDCP SDU has been compressed before:","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"-submit the PDCP SDU previously compressed to integrity protection and ciphering function;","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"-perform uplink data compression of the PDCP SDU as specified in clause 5.14.4, and submit the PDCP SDU to integrity protection and ciphering function;","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"-perform integrity protection and ciphering of the PDCP SDU using the COUNT value associated with this PDCP SDU as specified in the clause 5.9 and 5.8;","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"-submit the resulting PDCP Data PDU to lower layer, as specified in clause 5.2.1.","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"When upper layers request a PDCP entity re-establishment, the receiving PDCP entity shall:","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"-process the PDCP Data PDUs that are received from lower layers due to the re-establishment of the lower layers, as specified in the clause 5.2.2.1;","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"-for SRBs, discard all stored PDCP SDUs and PDCP PDUs;","paragraph_zero_based":253},{"literal_text_all_w_t_and_m_t":"-for SRBs, UM DRBs and UM MRBs, if t-Reordering is running:","paragraph_zero_based":254},{"literal_text_all_w_t_and_m_t":"-stop and reset t-Reordering;","paragraph_zero_based":255},{"literal_text_all_w_t_and_m_t":"-for UM DRBs and UM MRBs, deliver all stored PDCP SDUs to the upper layers in ascending order of associated COUNT values after performing header decompression;","paragraph_zero_based":256},{"literal_text_all_w_t_and_m_t":"-for AM DRBs and AM MRBs for Uu interface, perform header decompression using ROHC for all stored PDCP SDUs if drb-ContinueROHC is not configured in TS 38.331 [3];","paragraph_zero_based":257},{"literal_text_all_w_t_and_m_t":"-for AM DRBs for PC5 interface, perform header decompression using ROHC for all stored PDCP IP SDUs;","paragraph_zero_based":258},{"literal_text_all_w_t_and_m_t":"-for AM DRBs and AM MRBs for Uu interface, perform header decompression using EHC for all stored PDCP SDUs if drb-ContinueEHC-DL is not configured in TS 38.331 [3];","paragraph_zero_based":259},{"literal_text_all_w_t_and_m_t":"-for UM DRBs, AM DRBs, UM MRBs and AM MRBs, reset the ROHC protocol for downlink and start with NC state in U-mode (as defined in RFC 3095 [8] and RFC 4815 [9]) if drb-ContinueROHC is not configured in TS 38.331 [3];","paragraph_zero_based":260},{"literal_text_all_w_t_and_m_t":"-for UM DRBs, AM DRBs, UM MRBs and AM MRBs, reset the EHC protocol for downlink if drb-ContinueEHC-DL is not configured in TS 38.331 [3];","paragraph_zero_based":261},{"literal_text_all_w_t_and_m_t":"-for SRBs and UM DRBs, set RX_NEXT and RX_DELIV to the initial value;","paragraph_zero_based":262},{"literal_text_all_w_t_and_m_t":"-for UM MRBs and AM MRBs, set RX_NEXT and RX_DELIV to the initial value if initialRX-DELIV is configured in TS 38.331 [3];","paragraph_zero_based":263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["f68bb20373294f17b8a25ac56de1b261d60844f62dc83c387e5c9d9e9155f8cb","2e939eb94c2f049d2d472517405192c1704c1664dcac67cd726a05ad00d167d5","fa5d766cc1b67af85fd56f2a1bdf87f742b75cfe41b2bae6c3d45e2860130558","250c19c69af8b810cd61e0b9c9973b44e9c2d26366f8612207dc551f0b4223e4","ab9fe9ad18bc4acbab5e93d32dcc003c07310cfe55b63b7f76c17a64fdc7f41e","654ad5824386365c259b4ec281ad92d526590f34d97896e751324c88778c8c8c","2f756e14e74e763dea425b1e9dfd7cce58db3e88bcaba69c768714d5f85ec169","5d0adcc84c3e99c21c3c346a4b08f2e4f3e11f714501846eda4c81b5606568cf","e16439e101eccbcf2a3fdc17f0119c62859d2723be841390376b815bf643d84d","00f847415819687de137da262d25b52e8cb9ea3db25ef3bb19daa604cbbc5c52","ded4ea1cf70a7f73b1883deea93935f72d767b49e6da565c25c24defe9686b33","2a978f36b5b8a8cd9213958e3240952ee3980c5022c1e055d4e5230fc5adcd4b","18a82ffd6b8d0ad9499ee93a6296282c077ded6894ccb1aa95e46a5da7032ac9","a4861cd28b45b5d651ba4a3a853521e48db33826c794a3cbac29d57e47f48435","451f24f1a0bb5d04202a68ac62766b43f0b15b43c042c9511b93216d52d476b3","05dee5f5e7dcad5b3bd0ca02f3a14f14eb288c72ac40868462a9c31e86f10f05","b27485211ce6d513ad62e4b1d10ab23ce99eb9ca1cb0bf70dd85f0b7b0453864","bbe319878a67fc3c2cc5f88cb6770fa268ae81fed28a13db1a3bded0464cb699","71fc98d0b76ed89fcf857b31a218d74d0ad3b1a535a287f2622f43980101fd8b","fe6ec6a196d99d52638033dbec7f9795638c16a5844fb208521164ac7a7e47ec","3bf36fe454e7befc6911ee2b49ece27d4ce0c5fca58eddebb6b4d96e4314e3f9","2996ad86220dae501b7f5e5ce1fe2f207f95b126c5cb23141e52f2cd6a4b72a6","0453ced6f2e1eefe9d770e38e0dd7418c29426e1aff068ccb38d3577b0251e8f","0019e3baed2f07ef5a862e0ce2659f7b992bc45126f188f993fc17c8a39698ef"],"paragraph_range_zero_based":[240,263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p240"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-apply the ciphering algorithm and key provided by upper layers during the PDCP entity re-establishment procedure;","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"-apply the integrity protection algorithm and key provided by upper layers during the PDCP entity re-establishment procedure.","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"NOTE 1:After PDCP re-establishment on a sidelink ‎SRB/DRB, UE determines when to transmit and receive with the new key and discard the old key as specified in TS ‎‎33.536 [14].‎","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"NOTE 2:At PDCP re-establishment, the MRB type (i.e. UM MRB or AM MRB) is determined by the target configuration.‎","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"5.2.1Transmit operation","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"At reception of a PDCP SDU from upper layers, the transmitting PDCP entity shall:","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"-if psi-BasedDiscard is configured and PSI based SDU discard is activated, and the PDCP SDU belongs to a low importance PDU Set:","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"-start the discardTimerForLowImportance associated with this PDCP SDU (if configured);","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"-start the discardTimer associated with this PDCP SDU (if configured).","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"NOTE 1:Identification of PSI of a PDU Set and determination of low importance PDU Set are left up to UE implementation.","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"For a PDCP SDU received from upper layers, the transmitting PDCP entity shall:","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"-associate the COUNT value corresponding to TX_NEXT to this PDCP SDU;","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"NOTE 2:Associating more than half of the PDCP SN space of contiguous PDCP SDUs with PDCP SNs, when e.g., the PDCP SDUs are discarded or transmitted without acknowledgement, may cause HFN desynchronization problem. How to prevent HFN desynchronization problem is left up to UE implementation.","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"-perform header compression of the PDCP SDU using ROHC as specified in the clause 5.7.4 and/or using EHC as specified in the clause 5.12.4;","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"-perform uplink data compression of the PDCP SDU as specified in clause 5.14.4;","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"-perform integrity protection, and ciphering using the TX_NEXT as specified in the clause 5.9 and 5.8, respectively;","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"-set the PDCP SN of the PDCP Data PDU to TX_NEXT modulo 2[pdcp-SN-SizeUL];","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"-increment TX_NEXT by one;","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"-submit the resulting PDCP Data PDU to lower layer as specified below.","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"When submitting a PDCP PDU to lower layer, the transmitting PDCP entity shall:","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"-if the transmitting PDCP entity is associated with an SRAP entity:","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"-submit the PDCP PDU to the associated SRAP entity;","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["3fc284e025bd4b79e86bb0b5b89fc9f089421addb5dfda3b9f3d5756a2356165","5352b99bc05630a641278f1065c2aaa34e43f5f260a057ad954a56f0be94479e","0455bc65032dece24542b0bbfbc0f83348a2e907bdd7c909c484e49fe9ab027d","726c93df4d13fee7a241b834262074505748138de5748eb3d466133704944822","4934ec87f8a3c5ceb5b4616799dff083e352ad9418e9a88e1172f7ec388beac7","5e4b543bdf678fe1c283e5a0c24e2a29c9d8e2e4a9659cba875224a6dc946243","03cb74933ddc55e597bcf0c6726a93fcef1dc4944401f59ea74326f29c054166","7754dda36c1c385f2868a763bd0474c593266332381dadb7197f90813b0bfa6c","f874ff7b1bf5a310c80d69796bf75952e7a888540fdf3625edabe3f5bc4cd2f4","723c9f332224506131734e4d6ece31b2429effce0589a6e552263c4b6661fac6","16289b45934276053feeab984fd969476198335b5a57d9bd5737aaee607fd7fb","172656df8895ac3b0080863e02c5387d0a69e1ef272726d2fe0a078865f3bde6","1d16c2ae785628da4065c0df117d670d33c46180d8b4712a280042170c96c5a0","484c877fb1c98c03a4d7263d72ca68f61de1afbe94beeba2b047ea04725023b1","c29f3430f760506c0bdc359cf02f6e67c2303cf14e2b1bd610ffc04071f8643d","e725c9f8b71c013fb7d60e79604d4f94b49125b9d10ede88b8346b385120ff57","84c255447901edd0cb1a90f1ccb895137b8979dc2985802c024a5a5af5ff9c27","75a7fd91329c3091f55a561e990ef81ba1a05e7f21b57f55b918952a4611ddfc","abb043f310e20bd3e7f5f034b6a2be1aaf9c3cdfdbceecd007543a53a4dd75b5","f0d0d0fb1058e859fdf0ab755250f555ab6d901f04d8274d19af27143b59a963","f3b8b2d15209e1ec5496fe0e1f94583d1e6c54a33c50d32eb6534016ab8ea22a","829d7fc1b9d33708c0dcbdb3afad1d8ebd04fcda7d9f2d637d109589d1f815e4","d6e79c0197e8e1f935c2aea7415434dbd3cb7bc5ca624ca83c720ad549418ad4","a21e89a2a050a6e6a9c5c7e9ba52ae2aa25cfaa253d491b018940df47aa0b221"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p264"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-else, if the transmitting PDCP entity is associated with one RLC entity:","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"-submit the PDCP PDU to the associated RLC entity;","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"-else, if the transmitting PDCP entity is associated with at least two RLC entities:","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"-if the PDCP duplication is activated for the RB:","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"-if the PDCP PDU is a PDCP Data PDU:","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"-duplicate the PDCP Data PDU and submit the PDCP Data PDU to the associated RLC entities activated for PDCP duplication;","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"-submit the PDCP Control PDU to the primary RLC entity;","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"-else (i.e. the PDCP duplication is deactivated for the RB or the RB is a DAPS bearer):","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"-if the split secondary RLC entity is configured; and","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"-if the total amount of PDCP data volume and RLC data volume pending for initial transmission (as specified in TS 38.322 [5]) in the primary RLC entity and the split secondary RLC entity is equal to or larger than ul-DataSplitThreshold:","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"-submit the PDCP PDU to either the primary RLC entity or the split secondary RLC entity;","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"-else, if the transmitting PDCP entity is associated with the DAPS bearer:","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"-if the uplink data switching has not been requested:","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"-submit the PDCP PDU to the RLC entity associated with the source cell;","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"-if the PDCP PDU is a PDCP Data PDU:","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"-submit the PDCP Data PDU to the RLC entity associated with the target cell;","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"-if the PDCP Control PDU is associated with source cell:","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"-submit the PDCP Control PDU to the RLC entity associated with the source cell;","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"-submit the PDCP Control PDU to the RLC entity associated with the target cell;","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["d1d805def754f4466aa0ad92664717ff41a95505515951a3dd64cffdb509fa74","e5227803db739535365ac05c7d5cd48bcf1fac036a97bad59ba99e3b7dfabce9","765c7cdc03436669cc3dd28e21d6be5cfde79c29a34b75a26301ee5184e1c162","337559c4c0fbbaf0a3b507d129bc08b00d6a71e23aabf17317939af8a7604687","9247bdfa7e2a21e011db07b61b24a35d9ce8c22a0d050f662c5975d96062388b","63693547cd4b31d1ae4dd86aa6a23a3ac1d13faf0f34bb5d64939af280882df6","75545615d25de88b3e743737242aa54c88ceb31efcee4a3326f7e25c1fff16b1","79805b5925d38ff18ae203bc4387af80990ea0726aa67f6d2323389da7f83258","b7b6fab28298f8587a927cc23c4289330b003a7a0a6862712dd647b960de2a71","b19754534b4d43c41f3931f554fff68fd09f0ba61244f0a32e2e06c5bfd5cc80","d3fa253297b44c81acfd06375bfabb1b1d266a16aa33b3a26111d4cfea22db34","e30c52f6f99d04e16afc1ad33aa59938688ede9064f0922dcd0fcd414a95b98b","80cfeb4ec00c20015e3c837cc16577228fa44e1e98147b3ce9a1fc6f3463981a","db92a706a16852bb935ef2371e5860ef2da98301e0a11e4753861e05df5c9cd9","16a01cc0a22543988925456279ae6f33f2b81de8c6213ebc7cf43e92679df832","f18c597b82966ccc9931ce38dc33d7cf0ee93b169e7e225ae76d27267cbd3739","b236f827c397c6702383d2e8c57847bba66deb03d3a3542923d4ad4bee72c113","fbf1293a4f69d512f5d187a105235b182550f7e0e97cd19fe0fc54d61fc56c84","af11c597dfa34346531af2d93958bf89075d47a8c5c2a2208026e1dc07282aa6","48aefe3de50da786b931c950ba43f6d4e1946ac14acb06e99c085103cd60672f","4ab408a2bbd407eb9366563621be61858d0ced0b6d2a81b2111180aa45daa5b5","451d8049f73ecd3a77520482b8a03ca50d0739d4973bfaf7bc2541654b13a0f2","064509f9e95bd44cb96bcc43277ae1d0cb6dfe944c518e25424f3c58fb71a9a6","29d9d3578c64dbcdad657e4bbe848f07945398366fd3e16a90c9bb8847cd3aa7"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p288"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-submit the PDCP PDU to the primary RLC entity.","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the transmitting PDCP entity is associated with two RLC entities, the UE should minimize the amount of PDCP PDUs submitted to lower layers before receiving request from lower layers and minimize the PDCP SN gap between PDCP PDUs submitted to two associated RLC entities to minimize PDCP reordering delay in the receiving PDCP entity.","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"5.3SDU discard","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"When the successful delivery of a PDCP SDU is confirmed by PDCP status report, the transmitting PDCP entity shall discard the PDCP SDU along with the corresponding PDCP Data PDU. ","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"When the discardTimer or discardTimerForLowImportance expires for a PDCP SDU, the transmitting PDCP entity shall:","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"-if pdu-SetDiscard is configured:","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"-discard all PDCP SDUs belonging to the PDU Set to which the PDCP SDU belongs along with the corresponding PDCP Data PDUs;","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"-discard the PDCP SDU along with the corresponding PDCP Data PDU.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"If the corresponding PDCP Data PDU has already been submitted to lower layers, the discard is indicated to lower layers.","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"For SRBs, when upper layers request a PDCP SDU discard, the PDCP entity shall discard all stored PDCP SDUs and PDCP PDUs.","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"NOTE:Discarding a PDCP SDU already associated with a PDCP SN causes a SN gap in the transmitted PDCP Data PDUs, which increases PDCP reordering delay in the receiving PDCP entity. It is up to UE implementation how to minimize SN gap after SDU discard.","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"5.6Data volume calculation","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"For the purpose of MAC buffer status reporting, the transmitting PDCP entity shall consider the following as PDCP data volume:","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"-the PDCP SDUs for which no PDCP Data PDUs have been constructed;","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"-the PDCP Data PDUs that have not been submitted to lower layers;","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"-the PDCP Control PDUs;","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"-for AM DRBs, the PDCP SDUs to be retransmitted according to clause 5.1.2 and clause 5.13;","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"-for AM DRBs, the PDCP Data PDUs to be retransmitted according to clause 5.5.","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"[For the purpose of MAC delay status reporting, the transmitting PDCP entity shall consider the following as delay-critical PDCP data volume]:","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"-if pdu-SetDiscard is configured:","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"-the PDCP SDUs belonging to the delay-critical PDU Sets for which no PDCP Data PDUs have been constructed;","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["5d0afa0010222e0d73325e19de0419b1c28270b9d12875c83da8f73d041e1b2f","1e2ef26335d2fab2eac35bf6c1ee19d534be3cc234a289a53546d2d47bb2df41","af76f8b7833c3ef35707976274b6dfe3e1a4894da10469ec5bfe05233ab95446","0c902ee1d322614aa48e76d23da7be7b4035476caad9133919a487b362c9f935","1f3bee8193ef2f00a2dd61a3bb68693246b9966be771edd5dfa8164daf93a35c","e87386c46edaa3d099f76e634e06e5818f84b384a0754d50d0a376504e1f806d","b1144ac00be6390f3501052666baf764fab5e550698fb506242522e52b74e4e2","253a8c5d2a522e2e9adee35b863c2c0a9e8df3d09f5c8cb4e2192bc0f74070a0","7eb3d3204fd1fa43cb82b1522345d397abdd7dabe2eeb42518b9f58a17a30234","9c4d87a294ff1d4953b9fe3934af6aaeb752791b07f1a0d44755fea8c9e53e1d","1e03f310003a82e76f4f7aa16a43664a72e6075e4dfa14683264ead4a319715b","5954aa8a923d65498193962ea54b705458fe06975da28b93ff994caa942b945b","7d95d3ddfdc6e17b992afc86d64cdd59bbf9d8103a2bc3afec956d5e520a4ad8","7f53bfc8271f9c7a82d0b46ed3dc2851b124edbd5f6d25c9c4aba2ef7ca81ad9","4eeeadff32c0c882766bb271cc493608d3294b59aa18e612cb0aca8e3b5c9bfd","024210ddf923d24a2e3b0b447d4c2013aa2c822ba7c5cd7c3622309f30defab2","036f9919d1effa3ade2652433149ca99fc52d75acb18a2b9ecd2b0ca1f53b4c0","ce107d95336c5fd3d206e48ed7611b0e962a63bb88c5455e6ca4f29b19435520","f04b58983021c137bf112536c0c8824206fab4b84b5a333028ee81bc801962bd","ac7bb18f7c9598049988d2ee353c2ac85e326f2e6c97c1c6a2b5b54cfb0c060d","a1fc984aefd7ed6f690f492cc01a6eb2f81a6286377ad01587ef35d6d5b47abd","92615d72d20cd05dd64aecad78563555ee2cc4514d99361a7c491b78ac4b49a1","235f090dbc193fc889fdfb5738c56c8eea3d8d235bd186328e6a1d6a8db27e45","906f6e0e6ca1ee3ad3a6ce4d3734b97796d188cc7f6b63e533827f0ec7dd1480"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p312"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-the PDCP Data PDUs that contain the PDCP SDUs belonging to the delay-critical PDU Sets and have not been submitted to lower layers;","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"[-else:","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"-the delay-critical PDCP SDUs for which no PDCP Data PDUs have been constructed;","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"-the PDCP Data PDUs that contain the delay-critical PDCP SDUs and have not been submitted to lower layers.]","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"Editor's Notes: it is a placeholder for new mechanism. Depending on further progress, the exact procedure and location of this text may need to be changed.","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Editor's Notes: it is FFS whether the PDCP Control PDUs, the PDCP SDUs and PDCP Data PDUs to be retransmitted for AM DRBs are considered for delay-critical PDCP data volume.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"If the transmitting PDCP entity is associated with at least two RLC entities, when indicating the PDCP data volume to a MAC entity for BSR triggering and Buffer Size calculation (as specified in TS 38.321 [4] and TS 36.321 [12]), the transmitting PDCP entity shall:","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"-if the PDCP duplication is activated for the RB:","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume to the MAC entity associated with the primary RLC entity;","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume excluding the PDCP Control PDU to the MAC entity associated with the RLC entity other than the primary RLC entity activated for PDCP duplication;","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume as 0 to the MAC entity associated with RLC entity deactivated for PDCP duplication;","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"-else (i.e. the PDCP duplication is deactivated for the RB or the RB is a DAPS bearer):","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"-if the split secondary RLC entity is configured; and","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"-if the total amount of PDCP data volume and RLC data volume pending for initial transmission (as specified in TS 38.322 [5]) in the primary RLC entity and the split secondary RLC entity is equal to or larger than ul-DataSplitThreshold:","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume to both the MAC entity associated with the primary RLC entity and the MAC entity associated with the split secondary RLC entity;","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume as 0 to the MAC entity associated with RLC entity other than the primary RLC entity and the split secondary RLC entity;","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"-else, if the transmitting PDCP entity is associated with the DAPS bearer:","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"-if the uplink data switching has not been requested:","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume to the MAC entity associated with the source cell;","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume excluding the PDCP Control PDU for interspersed ROHC feedback associated with the source cell to the MAC entity associated with the target cell;","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume of PDCP Control PDU for interspersed ROHC feedback associated with the source cell to the MAC entity associated with the source cell;","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume to the MAC entity associated with the primary RLC entity;","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["0e1f3c1f73318dd00169dfc6566131229b465edb6987e096ae3ad07635004223","948f4dd5532540948699ddae2331335a20ab3a15de5c39232cb35e61ca92b091","330b11fe5ee0a42db13bf34cac96e6a394d7d2f151321f54d1180ff795b5e614","4009122ce0ead86040ae0960dcb60cbb262f4a38f12c80c0ffdc443f6f13f709","3a40e48b772f1ba7c5c2441f6e218630ab935cf8e1ca807f33ccf6ce750c05f0","92f6fed8b6665e472ad34a114de2813702a866da6cd1533af22f8d66f3a5db41","b9ffb123fafd144057b1a90df78a08c2bd1122b6387e264ea3abd0a4d35929cc","8c520f3436ac4d1e052e5f3d90b48b9619877e849a91d029061011d564044087","c282a0a24133cd802fa4d2a4c129b55c7a0d9267b7f4c27e0fa1c040f818c665","81e2bc255bee955fff09bc5070c9bbcfa8c5ab99c20f6787a02488eb888ac5e1","c10631776d739a6c8883025252bca7e15957269da9d90b6d81e7a5c2e6346627","1686a601ffa9ddf436431d21c9336d60a934d4785d6343d596b3471659822b8f","0fabb08078e51e1a6a1337d808cc6b220cea66e08426e1901a4804007717a649","e42513b556180308116bab0d47d88ad757b75fcad6e8891c6a061dc7b9de9ef7","bdfe4b227eadcdf0c04388c2dff32302a0bae170b7497d6eb3ebcec1c1ef3f91","2d3a14fcb2a63f4a580c55d2f4831fdec5cfe3c5ceac3f9514dcabe5bdec7ef3","6380aa58666288d85c842a41cc5a34ca051bd137a70f281e56ba112ecdd418f3","c8afdb3a53c056745c85802108f717f168967986ecb8ecd12773cca43c041c87","5c61b5ee5b58062a314300a70eba4539553dc30efb7ee98230e9981ceb775788","d34e7d6550b4479b4a0d979b5bbb770a143a1986f34976af3fbff56245b3221e","deaa3a16dedff4e286a2b86b57112223daf79df347d423672e63d31b91c3178a","575ca93af9acafa5faecf2ce627ffc6ed0633bad4b4a03b5ece7b1cc311b7aa5","7dbcd756a514df45b082cc811a71ad8fceb8fed2ba81a240cc89cd17f9791e59","5856bb13557579b6751491575f1a3ccc4eee9fd5b8e8000c52639dbb278079b4"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx:p336"}
{"fields":{"filename":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of XR Enhancements.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-indicate the PDCP data volume as 0 to the MAC entity associated with the RLC entity other than the primary RLC entity.","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"7.3Timers","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"The transmitting PDCP entity shall maintain the following timers:","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"a) discardTimer","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"This timer is configured only for DRBs. The duration of the timer is configured by upper layers TS 38.331 [3]. In the transmitter, a new timer is started upon reception of an SDU from upper layer.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"b) discardTimerForLowImportance","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"This timer is configured only for DRBs. The duration of the timer is configured by upper layers TS 38.331 [3]. In the transmitter, a new timer is started upon reception of an SDU belonging to a low importance PDU Set from upper layer if psi-BasedDiscard is configured and PSI based SDU discard is activated.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"The receiving PDCP entity shall maintain the following timers:","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"c) t-Reordering","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"The duration of the timer is configured by upper layers TS 38.331 [3], except for the case of NR sidelink communication or sidelink SRB4. For NR sidelink communication or sidelink SRB4, the t-Reordering timer is determined by the UE implementation. This timer is used to detect loss of PDCP Data PDUs as specified in clause 5.2.2. If t-Reordering is running, t-Reordering shall not be started additionally, i.e. only one t-Reordering per receiving PDCP entity is running at a given time.","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"====================================CHAGNE STOP====================================","paragraph_zero_based":373}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"10e5cb38b37b0dfb8f12c0c9cfbbe0bf8e332eae9de43cc451d00082f067088b","original_member_sha256":"eb546e95813d17061e2f2e29046594609d54b33f198e181aef2aa863719d00e5","paragraph_ElementTree_utf8_XML_sha256":["9880de9fd0d4be55a5f38f76f736835b7bbfa8049b7f1f5e35bfca2873b41931","7aee10f7a999246d18e599a81068d44719e9805fbff9d0681a5146835d1fc2f5","b00885ac9cf0cdf6a63a40dfc617f9c71b9c8911c34cc7714f61bc81d3d6937b","e5f8fc909b2f133b27d8408f85d8cf3cf084bad3786ec65bc9c6521c0c3c0f51","587cb7506246f82c05c39d68d39c9a0f0a48d15fc38ec1ddc38659bdf830b5c0","170346641ef4bed77a83fc2fd51059dc48e261a1e462bb119da30f7bd30935da","18c7527e9712f327f537e9fbc2a42ed1894cb015874f0a0bdafb87f285ff917a","fab019f320c2e876d606950ff14f9b79582d114430a9c6875a8f499a8e0b7188","574201a49210c858cd1a35220c39e997b1d76be6077572a2fe26a2204ecbc2e9","e647108c320866f30c65bb0b103be548983a4514654dac8a0b012a1303debc15","e0f4eedc016bedc4a346df4bc617d605fde076e27f52beb664287362c9e6d756","9192252741d8dd77c433a2e73718ba363251a7cea94f09cf2bb731fee2df7030","976d830dba3a4f18d281582ca8af23446fdec4584e92e6e1c143f78c484c176b","9eafb6b3e9b51003ef5ec67cbee9bd7ffc16114ac640854c6819e0ed4fbf9c31"],"paragraph_range_zero_based":[360,373],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312192.zip::R2-2312192 38323 CR0128 Introduction of X