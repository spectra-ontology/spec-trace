{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB11 contains information related to idle/inactive measurements.","paragraph_zero_based":13872},{"literal_text_all_w_t_and_m_t":"SIB11 information element","paragraph_zero_based":13873},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13874},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB11-START","paragraph_zero_based":13875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13876},{"literal_text_all_w_t_and_m_t":"SIB11-r16 ::=                    SEQUENCE {","paragraph_zero_based":13877},{"literal_text_all_w_t_and_m_t":"    measIdleConfigSIB-r16            MeasIdleConfigSIB-r16                       OPTIONAL, -- Need S","paragraph_zero_based":13878},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension         OCTET STRING                                OPTIONAL,","paragraph_zero_based":13879},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":13880},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13882},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB11-STOP","paragraph_zero_based":13883},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13884},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13885},{"literal_text_all_w_t_and_m_t":"SIB11 field descriptions","paragraph_zero_based":13886},{"literal_text_all_w_t_and_m_t":"measIdleConfigSIB","paragraph_zero_based":13887},{"literal_text_all_w_t_and_m_t":"Indicates measurement configuration to be stored and used by the UE while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":13888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13889},{"literal_text_all_w_t_and_m_t":"–SIB12","paragraph_zero_based":13890},{"literal_text_all_w_t_and_m_t":"SIB12 contains NR