{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mt>Thresh1","paragraph_zero_based":5160},{"literal_text_all_w_t_and_m_t":"Inequality T1-2 (Leaving condition)","paragraph_zero_based":5161},{"literal_text_all_w_t_and_m_t":"Mt>Thresh1+Duration","paragraph_zero_based":5162},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5163},{"literal_text_all_w_t_and_m_t":"Mt is the time measured at UE.","paragraph_zero_based":5164},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. t1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":5165},{"literal_text_all_w_t_and_m_t":"Duration is the duration parameter for this event (i.e. duration as defined within reportConfigNR for this event).","paragraph_zero_based":5166},{"literal_text_all_w_t_and_m_t":"Mt is expressed in ms.","paragraph_zero_based":5167},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mt.","paragraph_zero_based":5168},{"literal_text_all_w_t_and_m_t":"Duration is expressed in the same unit as Mt.","paragraph_zero_based":5169},{"literal_text_all_w_t_and_m_t":"5.5.4.17Event X1 (Serving L2 U2N Relay UE becomes worse than threshold1 and NR Cell becomes better than threshold2)","paragraph_zero_based":5170},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5171},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition X1-1 and condition X1-2, as specified below, are fulfilled;","paragraph_zero_based":5172},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition X1-3 or condition X1-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":5173},{"literal_text_all_w_t_and_m_t":"Inequality X1-1 (Entering condition 1)","paragraph_zero_based":5174},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh1","paragraph_zero_based":5175},{"literal_text_all_w_t_and_m_t":"Inequality X1-2 (Entering condition 2)","paragraph_zero_based":5176},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh2","paragraph_zero_based":5177},{"literal_text_all_w_t_and_m_t":"Inequality X1-3 (Leaving condition 1)","paragraph_zero_based":5178},{"literal_text_all_w_t_and_m_t":"Mr – Hys > Thresh1","paragraph_zero_based":5179},{"literal_text_all_w_t_and_m_t":"Inequality X1-4 (Leaving condition 2)","paragraph_zero_based":5180},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh2","paragraph_zero_based":5181},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5182},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the serving L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ef71a0795edca67a95d4aa9a740a67de822403f80c06a4ddd3ca679c28d56eba","913140c85f502af55ed9675c5e5f17af531a03cad8abc30a2fb71e53ae480341","01953aa5ebd147f50bc2436e6a7c979b2b2c4f4043f246006813b2ee9880814b","cdf5c03cc3731c2ed24608b2f2206e4a9d75a082c2d41461bab0b0d1ec4e4253","24d1d6538ee008823cd5e321ffcec8384f54c95e7220969333a9b65b709aaf83","a6d72971b9d1cffe9c68d04a5bfbc93affe22a1b924a611f490daaef13798890","b28239b58d08196b273d176452d1edf6fd4e27d658ff3effa1e65a80532ba3f2","f87a0338d21ccbc193c35946e959a590b5ffca436515abd6532a690afa313d8f","39cac51f64c778fe1a18bdf71d982d258ef95fb0a6c7c01df7c907e0d28643a9","084aa9d4219fc24c7ca6c839881825f1a192cc9dd4f932ef17899da8e62b7188","aba56009220e55868cf643005ff27bbee637995b87cae0425912379d3197cfa8","bee99ba8f55658f0570cc80641a2f95d615e98f2228d2860561dd7800760c73d","bdbc6f9beee07e231ce9b95b8a6ad4873c1237fe112cba5c9b17d54628cc9e73","dd49d088e156c21bf55f1fa8cf0d391bf92f377a3727df75121a46a3afd5c406","dae60f0fee962ec073e66f7da95810e5e7c474c9a97275e3d5182f6523b17418","ce33366e6b5918d2d87e925a110669f6af75f52c09387d73dd8a812c2f4af8f4","33e9009db673ded88a6329d7e6e514684ca0a7a9ee6cac3bb84303d72658b06c","ddd4521015b53465899904569738ffeb5296d106350ac9b76de49991c19c3c09","e744c2358c95e2ce8ed4f4e76481df1a15efcd09ac85917767c019bd270049a4","1f626ddda84f2eb63f88b91815c97590e49c6b8b2b4b9ec07ca2cb606d5ec520","9c4962ec04f317ebb50a7c64ceee1e44a82aea278d7570ea33392a98a7302fe7","85d68ae30a1e719a9209bff36c1cd4c0e3b45f0fc1dee0e643fa9bd809356e5e","a14affe83feac6b8102e55f952466a3ab1e4f64a2cc9bf711153652c84f7d225","71d11d08a62ec971c2b68db8c1d9991af1824d0fed8ccaf91bcaca3280dddbec"],"paragraph_range_zero_based":[5160,5183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the NR cell, not taking into account any offsets.","paragraph_zero_based":5184},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the reference signal of the NR cell (i.e. offsetMO as defined within measObjectNR corresponding to the NR cell).","paragraph_zero_based":5185},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the NR cell (i.e. cellIndividualOffset as defined within measObjectNR corresponding to the frequency of the NR cell), and set to zero if not configured for the cell.","paragraph_zero_based":5186},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event.","paragraph_zero_based":5187},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. x1-Threshold1-Relay as defined within reportConfigNR for this event).","paragraph_zero_based":5188},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. x1-Threshold2 as defined within reportConfigNR for this event).","paragraph_zero_based":5189},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm.","paragraph_zero_based":5190},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":5191},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":5192},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mr.","paragraph_zero_based":5193},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":5194},{"literal_text_all_w_t_and_m_t":"5.5.4.18Event X2 (Serving L2 U2N Relay UE becomes worse than threshold)","paragraph_zero_based":5195},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5196},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition X2-1, as specified below, is fulfilled;","paragraph_zero_based":5197},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition X2-2, as specified below, is fulfilled;","paragraph_zero_based":5198},{"literal_text_all_w_t_and_m_t":"Inequality X2-1 (Entering condition)","paragraph_zero_based":5199},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh","paragraph_zero_based":5200},{"literal_text_all_w_t_and_m_t":"Inequality X2-2 (Leaving condition)","paragraph_zero_based":5201},{"literal_text_all_w_t_and_m_t":"Mr – Hys > Thresh","paragraph_zero_based":5202},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5203},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the serving L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5204},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event.","paragraph_zero_based":5205},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. x2-Threshold-Relay as defined within reportConfigNR for this event).","paragraph_zero_based":5206},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm.","paragraph_zero_based":5207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7def197c1253b969840f758c1c04e8d17c58d60291053e38f4cf219ed63e8289","be0347783bbc01cdf859ea1906faea50ee37d3a1b12c2e8c5b03cc686d2828bb","a8acbfa68893c29cfa825cddd4d3e95c41674e0a18c3bc668ee95860f39aa12e","d1a48f292a077c9052c0cd26f2b3abbef214849921bf05a1373ccf103893ebfa","881606fcaa18eeb2c8c097560467be365d7fefde60e18c57f39f573adfe2e93e","c4a229f0b7aa347baf0a2c2e1a51fcc1ea5eae502329bcd287891df99d166b65","db3118bd2175079558e60ff373c25df439585f834df28b64557eb979e238d20b","20276eb50edcc00310283c07415ac9744defd4bf4466db969501d9bf96dcfbaf","d296fca8dae161d76fade8f1b64af1813114ced34f1afb9135a2e494329804b5","4298642790eac366ad0ac6852d9224081d6abdaccb00202859aaf66eff7d6f27","0240a13e8f1134f249404032d745f509886065d789ef6dc8a36f445003230349","677e4aa348ae07590214c4be600782ccf45bf23fdb072d85fd97b258d2d42b6e","91773f7cc365117da6208b215e0ce4e2172156574a671c3009b19ffa076523a7","94890f85929b2018954dad0f1aefa61b977b6278109073dd11d70521a21fde08","9ef7df61622b3c6b32af2fb9b56113ee8929cdec078d5808d18693776babd63a","f05e28b7940733ea774871accfa03ea37b78a0749624ee0dda99a1b157661ff7","128ee67d9500a79fd1a5d37c42559ed97fc9d151dff808d78202dadd6da26968","86cbc1f0dc59440c63bb1598f80efc53a698f427907797bd04dd7f32b0523fd7","07ff6f3c57400b8f938bd71231f67fdf012fbd105f0e2d69cd2813911b32adaa","068b1b19b96fa2bf5220bd63e3a030a91c53be5df9fdf3ebfb25b4f304bb8faf","a4c55d531593e0f63cd963a63227aee2a4944adcd641d761572a16e185573964","6c51073a04603d7d556bec6b0b1c36cb7d9b3d71f20026952e5a6d40a77e3094","a2bdd60ff548a6b73c8f0584b49ae140274b5995fd942359f4988cd7761f585e","9372f5e94284e5b6d7d2475e41172da2ada994b18670a58bfe3dbfff592dc358"],"paragraph_range_zero_based":[5184,5207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5184"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":5208},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Mr.","paragraph_zero_based":5209},{"literal_text_all_w_t_and_m_t":"5.5.4.19Event Y1 (PCell becomes worse than threshold1 and candidate L2 U2N Relay UE becomes better than threshold2)","paragraph_zero_based":5210},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5211},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition Y1-1 and condition Y1-2, as specified below, are fulfilled;","paragraph_zero_based":5212},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition Y1-3 or condition Y1-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":5213},{"literal_text_all_w_t_and_m_t":"Inequality Y1-1 (Entering condition 1)","paragraph_zero_based":5214},{"literal_text_all_w_t_and_m_t":"Mp + Hys < Thresh1","paragraph_zero_based":5215},{"literal_text_all_w_t_and_m_t":"Inequality Y1-2 (Entering condition 2)","paragraph_zero_based":5216},{"literal_text_all_w_t_and_m_t":"Mr– Hys > Thresh2","paragraph_zero_based":5217},{"literal_text_all_w_t_and_m_t":"Inequality Y1-3 (Leaving condition 1)","paragraph_zero_based":5218},{"literal_text_all_w_t_and_m_t":"Mp – Hys > Thresh1","paragraph_zero_based":5219},{"literal_text_all_w_t_and_m_t":"Inequality Y1-4 (Leaving condition 2)","paragraph_zero_based":5220},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh2","paragraph_zero_based":5221},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5222},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the PCell, not taking into account any offsets.","paragraph_zero_based":5223},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the candidate L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5224},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5225},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. y1-Threshold1 as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5226},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. y1-Threshold2-Relay as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5227},{"literal_text_all_w_t_and_m_t":"Mp is expressed in dBm in case of RSRP, or in dB in case of RSRQ and SINR.","paragraph_zero_based":5228},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm or dB, depending on the measurement quantity of candidate L2 U2N Relay UE.","paragraph_zero_based":5229},{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":5230},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mp.","paragraph_zero_based":5231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c8734866161fd5c5e5d6598ed053b55024345820cd868559952106a219597bfb","304c3e2363331e2779ed57cbeaa31893e7c156b7e0ede26f5c1c5a6ab5c6e0cd","88357f72d910487ffb4cc8ccae610b276f8e75465d75d44daf158b7beb07f89f","4dd7fbfdf518206b0d949353d4aaca86d6d889325a5a69b3bffefc7d7db01074","990b89632b4ba926a3dc7b41307c4cc06e46226661f52d5a2d14f802f7f9617f","b78d99e0a8f36f9cb3307b4fb89097586624c0601821d684655d8bada40ccab2","c18acd6a48acff9b395e5aeaa806334e57c9aa596b4929e89630b9d0e31cfd29","53c67e853cb5ca1a67a34f38c84461432bce9e9151a45a20595e6bb15c3a41f2","22cde642a3f41924a27dfee9cb275ff3f05252eb8670c462739e022cb16d9ac3","2760e14d6de427f1b4daf2b8967af0256b51ca36b9e62fe7744c4252577969e1","c05c903ea635be16fd5f16209f9a6e70c41ec9f5cc9225d70763c67e058ecf71","622c5b0e3b67c3f0c1cc735d4ba618c6509952a9b25fa573fd9cd3ecfae0515d","24b38c83b4a082484a06ef5badfbb07f7b27fd0dff1205b5c77c1fd8eefc4924","a7cf0c8541c335cab667e6fc2e3bb2f471878e3752473fd27faec0a2df95d917","3bf68967203c0fb1cd2c42c16560876518b61ce218eb79722df28a38c95d00ce","c4e3b9b5eebab7b8ed688373dfcdefcfb11c64cada12f4b3f91f5d808b90270e","cb6e5ba487dfdee82a6d0b9bf90459956e0a5a575859b8bce33d700e024eda4d","05c2878b7d44f14cf8443d22a1aeeb5ecd7a68ee0252163cb0acfea0f5b66855","b3b4c9d89fb922a42fddd9987bb7fff0fdca98df9ac479fba045949470132ffb","546343976d220ab08a919e99c71ba180c7bfdc26781c560cd6c0558ded685a0c","f942d1ea9f23894116bfa7baa1684cca557197bbccc308bbba17409191cead13","562edfecd425bd5ae0658e2b4afce7bd39bd9d041e9befcbaa9c704cdf2775f6","771ed7ce99c148a628d1e648fab3f6fdedd7a0cc44ece1fb5f255fae48183025","8bec31ef384e5267408489c5edce928ba03b63bf8feef403569181104dd38d9d"],"paragraph_range_zero_based":[5208,5231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p5208"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mr.","paragraph_zero_based":5232},{"literal_text_all_w_t_and_m_t":"5.5.4.20Event Y2 (Candidate L2 U2N Relay UE becomes better than threshold)","paragraph_zero_based":5233},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5234},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition Y2-1, as specified below, is fulfilled;","paragraph_zero_based":5235},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition Y2-2, as specified below, is fulfilled;","paragraph_zero_based":5236},{"literal_text_all_w_t_and_m_t":"Inequality Y2-1 (Entering condition)","paragraph_zero_based":5237},{"literal_text_all_w_t_and_m_t":"Mr– Hys > Thresh2","paragraph_zero_based":5238},{"literal_text_all_w_t_and_m_t":"Inequality Y2-2 (Leaving condition)","paragraph_zero_based":5239},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh2","paragraph_zero_based":5240},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":5241},{"literal_text_all_w_t_and_m_t":"Mr is the measurement result of the candidate L2 U2N Relay UE, not taking into account any offsets.","paragraph_zero_based":5242},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5243},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. y2-Threshold-Relay as defined within reportConfigInterRAT for this event).","paragraph_zero_based":5244},{"literal_text_all_w_t_and_m_t":"Mr is expressed in dBm or dB, depending on the measurement quantity of candidate L2 U2N Relay UE.","paragraph_zero_based":5245},{"literal_text_all_w_t_and_m_t":"Hys are expressed in dB.","paragraph_zero_based":5246},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Mr.","paragraph_zero_based":5247},{"literal_text_all_w_t_and_m_t":"5.5.4.aEvent H1 (The Aerial UE altitude becomes higher than a threshold)","paragraph_zero_based":5248},{"literal_text_all_w_t_and_m_t":"Editor’s Note: FFS: Whether to clarify any behavior for the case of multiple Hx or AxHy events being satisfied simultaneously.","paragraph_zero_based":5249},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5250},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition H1-1, as specified below, is fulfilled;","paragraph_zero_based":5251},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition H1-2, as specified below, is fulfilled;","paragraph_zero_based":5252},{"literal_text_all_w_t_and_m_t":"Inequality H1-1 (Entering condition)","paragraph_zero_based":5253},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":5254},{"literal_text_all_w_t_and_m_t":"Inequality H1-2 (Leaving condition)","paragraph_zero_based":5255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ec3550e82bab23526a8068166d778c4393a274ea14fc3e7595299f1e11337bd9","35178c759cb19455de8bf9318513fc70c359f19228467e92c9ca1d6165118f7f","56d91b4e99f5585b049604da0ff3aad4745226e8a7d8508b47e57638b5fabbce","99f506dc90904fd477549453eb65722906997325753b9214b190fb88b0bfd8d0","3603a9e610b5a4f1e88b8a6baed284d2bbc190a2f601a7f57e450553a1e121f2","258b332359ef95021abc09fc1