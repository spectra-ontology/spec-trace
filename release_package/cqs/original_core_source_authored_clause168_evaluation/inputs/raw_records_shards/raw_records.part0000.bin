{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TimeUntilReconnection-r16 ::= INTEGER (0..172800)","paragraph_zero_based":12336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12337},{"literal_text_all_w_t_and_m_t":"TimeSinceCHO-Reconfig-r17 ::= INTEGER (0..1023)","paragraph_zero_based":12338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12339},{"literal_text_all_w_t_and_m_t":"TimeConnSourceDAPS-Failure-r17 ::= INTEGER (0..1023)","paragraph_zero_based":12340},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12341},{"literal_text_all_w_t_and_m_t":"UPInterruptionTimeAtHO-r17 ::= INTEGER (0..1023)","paragraph_zero_based":12342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12343},{"literal_text_all_w_t_and_m_t":"-- TAG-UEINFORMATIONRESPONSE-STOP","paragraph_zero_based":12344},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12346},{"literal_text_all_w_t_and_m_t":"UEInformationResponse-IEs field descriptions","paragraph_zero_based":12347},{"literal_text_all_w_t_and_m_t":"coarseLocationInfo","paragraph_zero_based":12348},{"literal_text_all_w_t_and_m_t":"Parameter type Ellipsoid-Point defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit. The least significant bits of degreesLatitude and degreesLongitude are set to 0 to meet the accuracy requirement corresponds to a granularity of approximately 2 km.","paragraph_zero_based":12349},{"literal_text_all_w_t_and_m_t":"It is up to UE implementation how many LSBs are set to 0 to meet the accuracy requirement.","paragraph_zero_based":12350},{"literal_text_all_w_t_and_m_t":"connEstFailReport","paragraph_zero_based":12351},{"literal_text_all_w_t_and_m_t":"This field is used to provide connection establishment failure or connection resume failure information.","paragraph_zero_based":12352},{"literal_text_all_w_t_and_m_t":"connEstFailReportList","paragraph_zero_based":12353},{"literal_text_all_w_t_and_m_t":"This field is used to provide the list of connEstFailReport that are stored by the UE for the past up to maxCEFReport-r17.","paragraph_zero_based":12354},{"literal_text_all_w_t_and_m_t":"logMeasReport","paragraph_zero_based":12355},{"literal_text_all_w_t_and_m_t":"This field is used to provide the measurement results stored by the UE associated to logged MDT. ","paragraph_zero_based":12356},{"literal_text_all_w_t_and_m_t":"measResultIdleEUTRA","paragraph_zero_based":12357},{"literal_text_all_w_t_and_m_t":"EUTRA measurement results performed during RRC_INACTIVE or RRC_IDLE.","paragraph_zero_based":12358},{"literal_text_all_w_t_and_m_t":"measResultIdleNR","paragraph_zero_based":12359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["9f8b3c335feb402cac4dcedce68f2f2d20b98dcaa0ac9ef169cae83e7a7f1482","26d820b658b569ad6a57f4e5d75a6b925df8670d636645f5f7adcb8a540fba21","37c70cefc82f87b6ba32bf572dbcdaf6886a73393f3c50f9cfeba91d1141836a","152ad48d2f3c65d3b00363ba1dcbd16f56b01b7f680b57e663b6cfabc7d17599","6f80620ddfce372799abc5e589f659a16986925f5ef3f5f449e3ae182b3e3963","2eabae118ee2c871bd17e1d06aab1f2733c9c9bc2fa3d4f2bdca8ee843a828a8","44c005509da4e1748080ca9b8bd7144f00e46f0b5452120f78b67b540216b957","7e18ca3ef09148672a6c808581fb3c2467b7321b074c9186e6f2d7e834c712ec","873bfdc984adfa13573b6a5b451c0586318b8482c4bb218265db2e6cc66c03c3","ebce03977d93268859426629a10cba3f177f3fa8c2c4cec04c10cb162b7bd649","90108abfcaaa58e3e49304c9e237845f8952dcec3c7566320b3990c422630c8c","2ba8e392f4