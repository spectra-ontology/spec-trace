{"fields":{"filename":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Miscellaneous corrections for Stage 2 NR sidelink enhancements","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Apple","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"NR_SL_enh-Core","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2023-03-27","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3746189976dcbdbcfc068e07738e7ba47cccc8530b4966b5eb51329c9d150e0d","original_member_sha256":"8c4911026f8b1d8dd5fa80868a15466bc3f6a7fbbfd03b7bff3cbddbac5d0056","paragraph_ElementTree_utf8_XML_sha256":["296eef63aac1ee5edab54ca5ba84a33a64032e932f4ae4ef1f52a18c462560c0","4328dbc2e9ed59984edad9da9f918a037222a8bc1d4a7f801e449d0bf4e71fd0","1b57abbb250ccf0e7dbcfaad8666dd22e39df29408dc1d6e61b3298df1a31533","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","8460c6833f70d39d37d8d24dafa71298d13932cd9736de6d86c564d28ed18619","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","b5876ad1dfcd8838c0ec43b28e474601b1350fea0ff2d6d2925ac4aa4ed9fa4a","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","3691bd2b900ba67ea5f7e8beb1287b997977dfc03e96353e312bcf1ff9d2105e","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","350c3022897d2520ce527d856b5988d3adb7433cd732e0b17c2e8e27a1e2e876","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","d8f8c452e113806dcb1614cc5b815456a30bf1341cedb28a2f598e42cb16e028","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx:p24"}
{"fields":{"filename":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":" Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"The CR intends to fix the following issues in Stage 2 spec for R17 SL:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"Issue 1: “NR Sidelink communication” is defined to cover both V2X services and ProSe services, however the description of the cell reselection priority in clause 16.9.4.3 only mentioned “UE interested in V2X services” and left the behavior of “UE interested in ProSe services” unspecified.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"Issue 2: “Sidelink discovery” is not a term defined in clause 3 in TS 38.300, only “NR sidelink discovery” term is defined to cover both non-relay and relay cases., so we cannot assume “sidelink discovery” is equivalent to non-relay discovery. So, it is better to clarify the “non-relay” part in the sentence in 16.9.5.","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Issue 3: U2N remote UE only use mode 2 for sidelink discovery transmissions but this restriction is not applicable to non-relay discovery, which has not been included in the exceptions mentioned in 16.9.5.","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Issue 4: Both “SL retransmission timer” and “SL HARQ retransmission timer” are used in the clauses for SL-DRX, which may be misunderstood that those are two different types of ReTx timers used for SL-DRX. The names needs to be aligned.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Add the description for UE interested in ProSe services to treat the frequency providing NR SL configuraiton as the highest priority.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Change d“Sidelink discovery” to “non-relay sidelink discovery”.","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3746189976dcbdbcfc068e07738e7ba47cccc8530b4966b5eb51329c9d150e0d","original_member_sha256":"8c4911026f8b1d8dd5fa80868a15466bc3f6a7fbbfd03b7bff3cbddbac5d0056","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","285a8c8799db0481a805d2aec7ce7fc209db7244f09ed6018ec158f8b79d2b31","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","00ee39c600afe9a761abfcf39e312e8b7f5977bbaf8ee20f2e5ceb80676f1e4a","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","c7f154badb51090dd578312419bcf46f1ff9111557a952165c0ca920b2e5af4d","1257bef6de0d6fbcb35da4ad9e5d1d2efb40539d216438a199be822d1e60e855","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","6318240db9ef9ff789b2c42279fc4a12aa709d231c796ced014c8a9651101984","4ef26c4754ab16470259df6b41c8855ed2226d691eb22aff13c3b7a33d87420c","732bdce4471c8ad6019613053ba7e29b47ec69e35fa17b5794c358e733bafa98","35b7960050ce56539d373062196682ebe81b80f40fff7261cdc723ff9fb907e6","ec0d1d9fe8c127dba87c6f2af3a56d5d0ce806cdc173cdc4a5fb667cfb83850e","08e707cd9284f63895e90d63a13c795b773cc2c1686181b5988da57734e2aff9","82c90685c979bedb78d0aa35435ed7ed75675b1ab6e98149d2bcf73cd03d8f51","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","23f72e0c265876ec7c094dba0b8ef65e4ec99050844e6cc3478fc6f193f9d14b","1c7f2f34b2a6df595e473b7646bbf8c7163be8686418e670b03dd42e195911f8"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx:p48"}
{"fields":{"filename":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Added the “U2N Relay specific resource allocation mode restriction“ as an exception for NR sidelink discovery.","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Changed name “SL Retransmission timer” to “SL HARQ retransmission timer”.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"The description in the current spec is imprecise and confusing.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"16.9.4.3, 16.9.5, 16.9.6.1, 16.9.6.3, 16.9.8","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"affected:","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3746189976dcbdbcfc068e07738e7ba47cccc8530b4966b5eb51329c9d150e0d","original_member_sha256":"8c4911026f8b1d8dd5fa80868a15466bc3f6a7fbbfd03b7bff3cbddbac5d0056","paragraph_ElementTree_utf8_XML_sha256":["e8b2ecd846310b95788c1227cde83763e6750d2b85251100aed1682430d2f6b4","a8555758262ae03c8a580c1d700982f55c8e1ed429b4d83264a300ab536fd189","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","81eed922a2303f8c427ce01d906ce49484c3a4a7a89ec02f00fdc6435fd36094","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","3699bb6e2d1a216fbb1002b33bf65e2a7c67a8271b556e8408067917734b9628","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a4e","cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032","13a296cdc0117fe8fab98180233cab30f64a0cefa9202305e6800261ccf44a19","5a13fceff94c505bcc5a761d985dc17eb1bfcf9724f7626d3bae06c87b37acc0","f204aa7a2ae2c45a76efe09d7d6844b1a58ab58c27a8bcba750ff1e4fd34ece4","7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","6e82949a1e28ade627ca9370613d603e1d65df7230c77e81df85bd9e56490891","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2"],"paragraph_range_zero_based":[72,95],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx:p72"}
{"fields":{"filename":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":" Test specifications","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":"(show related CRs)","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"START OF FIRST CHANGE","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"16.9.4.3Control of idle/inactive UEs","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"The UE in RRC_IDLE or RRC_INACTIVE performs NR sidelink communication and/or V2X sidelink communication, as configured by the upper layers. NG-RAN may provide common sidelink configuration to the UE in RRC_IDLE or RRC_INACTIVE via system information for NR sidelink communication and/or V2X sidelink communication. UE receives resource pool configuration and SL DRB configuration via SIB12 for NR sidelink communication as specified in TS 38.331 [12], and/or resource pool configuration via SIB13 and SIB14 for V2X sidelink communication as specified in TS 38.331 [12].","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"When the UE performs cell reselection, the UE interested in V2X service(s) considers at least whether NR sidelink communication and/or V2X sidelink communication are supported by the cell. The UE may consider the following carrier frequency as the highest priority frequency, except for the carrier only providing the anchor carrier:","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"-the frequency providing both NR sidelink communication configuration and V2X sidelink communication configuration, if configured to perform both NR sidelink communication and V2X sidelink communication;","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"-the frequency providing NR sidelink communication configuration, if configured to perform only NR sidelink communication.","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3746189976dcbdbcfc068e07738e7ba47cccc8530b4966b5eb51329c9d150e0d","original_member_sha256":"8c4911026f8b1d8dd5fa80868a15466bc3f6a7fbbfd03b7bff3cbddbac5d0056","paragraph_ElementTree_utf8_XML_sha256":["215ec34d9ca2bdd05c1b65f9a92889bb7ca26213d1a676ed59890e0b89ebe5d4","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","edd5f1436b418f127f4de842ebe3fcb39852189ac6497df1a8595fa0a8b97855","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","5e6e78c509901ae3936d881dd0c9b12c94a02c1a5b9226ba72b61bcdd6bc46b1","97864fba050d73e119a112b9b93e52fba5a967d7af701f9bc2df8e8af5169c02","1f35e823abd36d9813a574b369701d8399541f0ad5c8318f3feab090d07f0de5","2644f9970d1c417f3f9cbdfe7a2a66c0bb5eed6b957dcb5c227a9b8fc62411b2","114a09021d1cc04bc184a59413a36a641f85cc4831149d2df77eb806565da585","080d124fda4e370aa091a93c79439ab9e0bfe85c6af4dbec21c655b713213b4b","4061f2382777043f5f17c4426683d83f4a688dc1e51dd8c2dff5995e2b549341"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx:p96"}
{"fields":{"filename":"R2-2303383.zip::R2-2303383 38300_Correction_for_NR_sidelink_communication_v2.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-the frequency providing V2X sidelink communication configuration, if configured to perform only V2X sidelink communication.","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"When the UE performs cell reselection, the UE interested in ProSe service(s) considers at least whether NR sidelink communication are supported by the cell. The UE may consider the carrier frequency providing NR sidelink communication configuration as the highest priority frequency, except for the carrier only providing the anchor carrier.","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"16.9.5Sidelink Discovery","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"The UE may perform NR sidelink discovery while in-coverage or out-of-coverage for non-relay operation.","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"The Relay discovery mechanism described in clause 16.12.3 (except the U2N Relay specific threshold based discovery message transmission and U2N Relay specific resource allocation mode restriction) is also applied to non-relay sidelink discovery.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"16.9.6.1General","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"Sidelink supports SL DRX for unicast, groupcast, and broadcast. Similar parameters as defined in clause 11 for Uu (on-duration, inactivity-timer, retransmission-timer, cycle) are defined for SL to determine the SL active time for SL DRX. During the SL active time, the UE performs SCI monitoring for data reception (i.e., PSCCH and 2nd stage SCI on PSSCH). The UE may skip monitoring of SCI for data reception during SL DRX inactive time.","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"The actual parameters supported for each cast type (unicast, groupcast, broadcast) are specified in the following clauses.","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"The SL active time of the RX UE includes the time in which any of its applicable SL on-duration timer(s), SL inactivity-timer(s) or SL HARQ retransmission timer(s) (for any of unicast, groupcast, or broadcast) are running. In addition, the slots associated with announced periodic transmissions by the TX UE and the time in which a UE is expecting CSI report following a CSI request (for unicast) are considered as SL active time of the RX UE. The time for the unicast link establishment procedure and the time for the PC5 RRC reconfiguration with initial SL DRX configuration procedure as specified in clause 5.28.2 of TS 38.321 [6] are considered as SL active time of the RX UE.","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"The TX UE maintains a set of timers corresponding to the SL DRX timers in the RX UE(s) for each pair of source/destination L2 ID for unicast or destination L2 ID for groupcast/broadcast. When data is available for transmission to one or more RX UE(s) configured with SL DRX, the TX UE selects resources taking into account the active time of the RX UE(s) determined by the timers maintained at the TX UE.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"The UE can determine from SIB12 whether the gNB supports SL DRX or not.","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"16.9.6.3Groupcast/Broadcast","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"For groupcast/broadcast, SL DRX is configured commonly among multiple UEs based on QoS profile and Destination L2 ID. Multiple SL DRX configurations can be supported for each of groupcast/broadcast.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"SL on-duration timer, SL inactivity-timer, SL HARQ RTT and SL HARQ retransmission timers are supported for groupcast. Only SL on-duration timer is supported for broadcast. SL DRX cycle, SL on-duration, and SL inactivity timer (only for groupcast) are configured per QoS profile. The starting offset and slot offset of the SL DRX cycle is determined based on the destination L2 ID. The SL HARQ RTT timer (only for groupcast) and SL HARQ retransmission timer (only for groupcast) are not configured per QoS profile or per destination L2 ID. For groupcast, the RX UE maintains a SL inactivity timer for each destination L2 ID, and selects the largest SL inactivity timer value if multiple SL inactivity timer values associated with different QoS profiles are configured for that L2 ID. For groupcast and broadcast, the RX UE maintains a single SL DRX cycle (selected as the smallest SL DRX cycle of any QoS profile of that L2 ID) and single SL on-duration (selected as the largest SL on-duration of any QoS profile of that L2 ID) for each destination L2 ID when multiple QoS profiles are configured for that L2 ID.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"For groupcast, SL HARQ RTT timer and SL HARQ retransmission timer are maintained per SL process at the RX UE. SL HARQ RTT timer can be set to different values to support both HARQ enabled and HARQ disabled transmissions.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"A default SL DRX configuration, common between groupcast and broadcast, can be used for a QoS profile which is not mapped onto any non-default SL DRX configuration(s). The default SL DRX configuration for groupcast and broadcast can also be used for discovery message in sidelink discovery in clause 16.9.5 and relay discovery messages in clause 16.12.3, and for Direct Link Establishment Request message as specified in TS 24.587 [53].","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"In-coverage TX and RX UEs in RRC_IDLE/RRC_INACTIVE obtain their SL DRX configuration from SIB. UEs (TX or RX) in RRC_CONNECTED can obtain the SL DRX configuration from SIB, or from dedicated RRC signalling during handover. For the out of coverage case, the SL DRX configuration is obtained from pre-configuration.","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"For groupcast, the TX UE restarts its timer corresponding to the SL inactivity timer for the destination L2 ID (used for determining the allowable transmission time) upon reception of new data with the same destination L2 ID.","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"TX profile is introduced to ensure compatibility for groupcast and broadcast communication between UEs supporting/not-supporting SL DRX functionality. A TX profile is provided by upper layers to AS layer and identifies one or more sidelink feature group(s). Multiple TX profiles with the support of SL DRX and without the support of SL DRX can be associated to a destination L2 ID. For a given destination L2 ID, all TX and RX UEs should be configured with the same set of TX profile(s). A UE only assumes SL DRX for the given destination L2 ID when all the associated TX profiles correspond to support of SL DRX. A UE assumes no SL DRX for the given destination L2 ID if there is no associated TX profile. An RX UE determines that SL DRX is used if all destination L2 IDs of interest are assumed to support SL DRX. For groupcast, when the UE is in RRC_CONNECTED and using mode 1 resource allocation, the UE reports each destination L2 ID and associated SL DRX on/off indication to the gNB supporting SL DRX.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"END OF THE CHANGE","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3746189976dcbdbcfc068e07738e7ba47cccc8530b4966b5eb51329c9d150e0d","original_member_sha256":"8c4911026f8b1d8dd5fa80868a15466bc3f6a7fbbfd03b7bff3cbddbac5d0056","paragraph_ElementTree_utf8_XML_sha256":["3d6db227b5045f0b758134377b799a364ff9890ca03dd003a7fa1da809bd325a","5fc81e818b23e56175f97a8ee8521c93a6a0e4ee87088edc638a51711a819e4d","491bc990d5f00a5bd4ebdbfcf4566da15c40d1649d57ec4aa027ff2addd5ffb2","d2006674108f4b5f1d98c16bd9a126c987c1e606dfcba1b1d750998f75459c23","c19c2041f20b1acd788be0f9cea23c724d329a9722ee5bc82798688372d111f2","356c5d59b6a919acbdb45e4a3632da31f2ca683356f58dc7421349531848d83f","36853470d610393bad721bb322a5965e4a247040b312aaa82f9d868f33a0c564","5e1b72c21f4c401d1e8568f2dc26cce8118d66c344377518787263c9fa2363bd","f9e21b8b2df0c68823b7ded5c425a6c4ca76e5dea75de6e68051ddb2a76a8f2e","b9111411ef62a928e9c4e58a5b3f1563b5706aacceeceb65b86520070991d732","9805b58c0d749d2891a84d3ecb9aa6cffa752f86af4c7ca187142117b8dbfee0","a94a125aa1595c79396f82fa949e36c8dc7e2da49c4170b472142ebb8527b4d8","8d2d09ec8c877c8862cd8a804432fc7b42260a005795872097ca4893d4205684","733a67b3758fe1413f8477913b3ef5e710b779eb1b9a526f4dbf221bf78f06c9","2c76570ecd7e4f197c805882f7264df2b00f015e8aeb01daec79c3c8608568f3","78e29ce322d19b3ed4dab8e012cecb8cf594e92882292ba5d33618f0fb72a2ed","e1d40da731fb801923ca2d4fdc4fc42892031dd5b7294e12afe19aecda43950d","c2169c5af1216632f41256f9119b75181d28558ad80994ab16cbd47225d5aa90","e6e2d533add224a8f99d77e59cf79378390bd12edbb20fa34e28303496777b6c","7ea9c3a78fc2d9372441c58ed2deb667b9162b344b9c48a7d13e24c6f4e2a83a","b8e7250da2e85934cb822420432861e526a8ff27f8b8bdb8a602e34c9c7eda7d","c50172224ac946a47ea0a6eeef0efbc2ab7c41db0fabc33a2c50a890a10a3362","40fb38c31ca528b44266f60bb38bdef9cc1ef3f036e6427a8d5453b57831e4e5","adaebccf423c26a59f5418cbd273a5b98162d024e8be7375907ad79586ac9c55"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"