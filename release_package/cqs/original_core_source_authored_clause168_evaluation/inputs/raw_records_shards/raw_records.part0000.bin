{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-BeamInfo","paragraph_zero_based":1608},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-BeamInfo is used by the location server to provide spatial direction information of the DL-PRS Resources.","paragraph_zero_based":1609},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1611},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-BeamInfo-r16 ::= SEQUENCE (SIZE (1..nrMaxFreqLayers-r16)) OF","paragraph_zero_based":1612},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-BeamInfoPerFreqLayer-r16","paragraph_zero_based":1613},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1614},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-BeamInfoPerFreqLayer-r16 ::= SEQUENCE (SIZE (1..nrMaxTRPsPerFreq-r16)) OF","paragraph_zero_based":1615},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-BeamInfoPerTRP-r16","paragraph_zero_based":1616},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1617},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-BeamInfoPerTRP-r16 ::= SEQUENCE {","paragraph_zero_based":1618},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID-r16INTEGER (0..255),","paragraph_zero_based":1619},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r16NR-PhysCellID-r16OPTIONAL,-- Need ON","paragraph_zero_based":1620},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r16NCGI-r15OPTIONAL,-- Need ON","paragraph_zero_based":1621},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r16ARFCN-ValueNR-r15OPTIONAL,-- Need ON","paragraph_zero_based":1622},{"literal_text_all_w_t_and_m_t":"associated-DL-PRS-ID-r16INTEGER (0..255)OPTIONAL,-- Need OP","paragraph_zero_based":1623},{"literal_text_all_w_t_and_m_t":"lcs-GCS-TranslationParameter-r16LCS-GCS-TranslationParameter-r16","paragraph_zero_based":1624},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Need OP","paragraph_zero_based":1625},{"literal_text_all_w_t_and_m_t":"dl-PRS-BeamInfoSet-r16DL-PRS-BeamInfoSet-r16OPTIONAL,-- Need OP","paragraph_zero_based":1626},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1627},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1629},{"literal_text_all_w_t_and_m_t":"DL-PRS-BeamInfoSet-r16 ::= SEQUENCE (SIZE(1..nrMaxSetsPerTrpPerFreqLayer-r16)) OF","paragraph_zero_based":1630},{"literal_text_all_w_t_and_m_t":"DL-PRS-BeamInfoResourceSet-r16","paragraph_zero_based":1631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["7c90b7fa2a31f5a6ea864ec12b0ea8e7129cd81635e25147ac2542ab9ac723b6","2c0c86a88cbc224b33cf67c4b8cdad3778f7207096498e22dfc00950eedf4628","78070ab66e5b4253e5804c65207085eaca277cfd32200c51d50f4c4d96fecd46","d0ddfda9067352ab32caa7b6b8584b887e9d855bdf10258226c7baafc8f58068","353feb7c0ea50b1192d245a4ef6db9aa91210e46ad47395298b1a296c21532ee","63cbc92597aedbc9876647ce137313ed5f0346db57ce97de364d054e87b74f64","b2b93e9936951a148646d67e15514ecc19d334e94dd2cffed3ecca0e6bce6d77","94eebd481cde1a13852ecabd2d836f5e5600dba89f37cc70a0bb0bddb5a7175e","8dad7e84961d62ca80d5cf3294340465c9138f781b1d525efc015100ef445cff","ea4927082aa122c6094678703b2507dc6b9ead8c1846fbcf12ef5dce4480a018","a49c0d7be0533196af091d7f2ab623ba0f8b7f3fdaa9fcade4f32d05a543d1fc","8f14d876efd79d122cf60b3633bf3510f07f4b665caddba84b3225c210463b69","c386914b8b021ad57a8b1b1c410ce78720314bcade45359ad149fec3c244dd91","e3792c0430ef5a6b177b8d684eec976401366fc9f3db15ae6f99b8df2fca73b8","c80659a76277766f1def51adc85044b01c47c503207cc81018b11665c569d81d","4459d352cc61f622