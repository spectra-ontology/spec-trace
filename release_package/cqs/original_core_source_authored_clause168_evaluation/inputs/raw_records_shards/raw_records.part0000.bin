{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":37200},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37201},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":37202},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":37203},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfigExt","paragraph_zero_based":37204},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":37205},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceProhibitTimer","paragraph_zero_based":37206},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred minimumSchedulingOffset assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37207},{"literal_text_all_w_t_and_m_t":"musim-GapAssistanceConfig","paragraph_zero_based":37208},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for gap preference.","paragraph_zero_based":37209},{"literal_text_all_w_t_and_m_t":"musim-GapProhibitTimer","paragraph_zero_based":37210},{"literal_text_all_w_t_and_m_t":"Prohibit timer for MUSIM assistance information reporting for gap preference.","paragraph_zero_based":37211},{"literal_text_all_w_t_and_m_t":"musim-LeaveAssistanceConfig","paragraph_zero_based":37212},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for leaving RRC_CONNECTED for MUSIM purpose.","paragraph_zero_based":37213},{"literal_text_all_w_t_and_m_t":"musim-LeaveWithoutResponseTimer","paragraph_zero_based":37214},{"literal_text_all_w_t_and_m_t":"Indicates the timer for the UE to enter RRC_IDLE for MUSIM purpose as defined in clause 5.3.8.6.","paragraph_zero_based":37215},{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":37216},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":37217},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":37218},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":37219},{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":37220},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":37221},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":37222},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":37223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["478cded19c3ce0da13c7e797bf452d6ec64d1b8d145343c2c1ce9b8a58ae8405","13381cb2c2c5379307e8c3189e0c268fbb841abd33d3f53efc00ec398387301a","edb4c8b120ad514f18306dd1cb811ab4cc83fcd0d1ad92c31c454a5cc20993d6","e32715f4184bc3b4f081c8f376c76dd49e90273f81054d3363d5f364eb7854e6","086962dafabdf9a6b8955a9a4aa92e5e31084181616d7de2ee5d7af0f7690d34","8f11e01712be3281ee732a24bda509888836abddc5901d0a101900c2f0a59c8f","4c599327e79b33ce0bf231677402a6b515b43fa01a8ac0e315c9c150947c8aac","a35802a3eaaa9cec4063de69511ab0143e617e0db9fb2e2c690a89f7feb3ce68","5eebeef2bed411b56934d8a29dd443598de9a2c1ece6a0a55ed923cc91455e0c","7ee566e4e68cc731e51fe243ea262ee0308e9b379833e6e0f1a697a35d1e79a6","a201be741bddfc636eec1a53b9c73b0a07e06bc381f123d571a5c60fc998f769","3f6908ab58e30e3e790b85b855e8feb383ff69c83f2d26fc61b37f290efe7c8b","366679434ace1fee18e831a78d965311b48685585dd26cf529d814e748ccdadc","7242fcfa04bcff6c6f6a89b4dc1bc378565ffe28c0fdc823e35a195017fc49fe","53524d117ad0feaac611b74cef71806d4e01ce8a5692144ae088436957493abe","f1e18c84640c7879be9fbee4c8308df3bd786605567eb104d1f1e6e9c67cccb7","846705de1abc4356696bfae3cd9d0b23a3707bc6eddc721b6b8b00e29cf50c89","a1f0a0767997ec14ef295dd6aa0a9f98db95669c4286fc30d9a7dce63ac1373c","ccb3ee69f8c517b774b5dfdddf823617f780421b7c0df748d1eb4ef1b04d7317","aec1d3145d033196becedbbfb00076aa29384014a417af853a44a6991d65c683","c00c08e1a748a31250741f5967430c7af9efe2fdf269ff54bf8e7dd1da3fa0f4","61b8bea6c13016c0391e675f06e3df8ec358c52d21b7929e07d920a53f144f22","86b5f210e3d2c49a239ef3c3839272c3018466a5376c923f81027f1daf099b0e","c9f5d0be877e50376a48808a0737b96a9357ec159a6797ef1742c0d