{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The CSI-SemiPersistentOnPUSCH-TriggerStateList IE is used to configure the UE with list of trigger states for semi-persistent reporting of channel state information on L1. See also TS 38.214 [19], clause 5.2.","paragraph_zero_based":17664},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList information element","paragraph_zero_based":17665},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17666},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-START","paragraph_zero_based":17667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17668},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList ::= SEQUENCE(SIZE (1..maxNrOfSemiPersistentPUSCH-Triggers)) OF CSI-SemiPersistentOnPUSCH-TriggerState","paragraph_zero_based":17669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17670},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerState ::=     SEQUENCE {","paragraph_zero_based":17671},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfo                     CSI-ReportConfigId,","paragraph_zero_based":17672},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":17673},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":17674},{"literal_text_all_w_t_and_m_t":"    sp-CSI-MultiplexingMode-r17                ENUMERATED {enabled}                                           OPTIONAL   -- Need R","paragraph_zero_based":17675},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":17676},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17678},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-STOP","paragraph_zero_based":17679},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17681},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList field descriptions","paragraph_zero_based":17682},{"literal_text_all_w_t_and_m_t":"sp-CSI-MultiplexingMode","paragraph_zero_based":17683},{"literal_text_all_w_t_and_m_t":"Indicates if the behavior of transmitting SP-CSI on the first PUSCH repetitions corresponding to two SRS resource sets configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' is enabled or not.","paragraph_zero_based":17684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17685},{"literal_text_all_w_t_and_m_t":"–CSI-SSB-ResourceSet","paragraph_zero_based":17686},{"literal_text_all_w_t_and_m_t":"The IE CSI-SSB-ResourceSet is used to configure one SS/PBCH block resource set which refers to SS/PBCH as indicated in ServingCellConfigCommon and ServingCellConfig.","paragraph_zero_based":17687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4a606b65ec25ef32611f7ecdc237012abf8f4572fd2d1c3fe34c1a512cbdba98","0ef0ad3094865486465cc3dbe665e6da50ec8d682e919360e0b6e455f5cffc1f","5b8ff15640708e6b8b02490a12b23e32aff3952f446c143af8d3bc6d3268afd9","30ec45e574da3f33405c3c8cc0fa3f465dcaf9ffd90f9449e52d8b2be8905645","4dd9f6d7355895996039832818bc4d70ce5161d58723eba52de302beac7ec133","f64653fc27b236c14dcf21e4b23beda57a03d190b16109e3d84c591933c75461","1215d2e54c6e83339d9f184454e97b14c81cb10e0734b4dfee260e9f1c238aee","6f8c513a2cada51c7c1624ebc880eb037085e0682b9524927bd6b99cbae06663","45b21f08a1b6d975986fa1b597