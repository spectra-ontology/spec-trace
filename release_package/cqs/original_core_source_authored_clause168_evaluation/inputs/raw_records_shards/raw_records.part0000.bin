{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42816},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":42817},{"literal_text_all_w_t_and_m_t":"IMPORTS","paragraph_zero_based":42818},{"literal_text_all_w_t_and_m_t":"    CellAccessRelatedInfo,","paragraph_zero_based":42819},{"literal_text_all_w_t_and_m_t":"    SL-ServingCellInfo-r17","paragraph_zero_based":42820},{"literal_text_all_w_t_and_m_t":"FROM NR-RRC-Definitions;","paragraph_zero_based":42821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42822},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N-r17 ::=             SEQUENCE {","paragraph_zero_based":42823},{"literal_text_all_w_t_and_m_t":"    cellAccessRelatedInfo-r17               CellAccessRelatedInfo,","paragraph_zero_based":42824},{"literal_text_all_w_t_and_m_t":"    sl-ServingCellInfo-r17                  SL-ServingCellInfo-r17,","paragraph_zero_based":42825},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":42826},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42828},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":42829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42830},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ACCESSINFO-L2U2N-STOP","paragraph_zero_based":42831},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42833},{"literal_text_all_w_t_and_m_t":"10Generic error handling","paragraph_zero_based":42834},{"literal_text_all_w_t_and_m_t":"10.1General","paragraph_zero_based":42835},{"literal_text_all_w_t_and_m_t":"The generic error handling defined in the subsequent clauses applies unless explicitly specified otherwise e.g. within the procedure specific error handling.","paragraph_zero_based":42836},{"literal_text_all_w_t_and_m_t":"The UE shall consider a value as not comprehended when it is set:","paragraph_zero_based":42837},{"literal_text_all_w_t_and_m_t":"-to an extended value that is not defined in the version of the transfer syntax supported by the UE;","paragraph_zero_based":42838},{"literal_text_all_w_t_and_m_t":"-to a spare or reserved value unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved value.","paragraph_zero_based":42839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3cd0b6b0ba9946f4ae08d4c567b182448a93af6f221bc8d1acdcb046d9c3364a","ef7e6378bb26fd5942d812a3a6296f774c5416648fd495e71c14f9fce06ad06e","2e3d4675e2ebb64bfe1d3b1095eebe588e2ad3730e394e75a7155f33bca763cc","49d266ad723f69e2a66cb4c1bf9e2f5e1953bb2b183f379ff5d9f713e1eaa843","18c36cfdabb40eb33922dc59566644cc99ca58488c92480ee01c1bc0124c9fc1","3035477102098c987c5d0ed96d79e8a469131802f4c82daa1734f3af310e295b","875ad8d413ec52beb6d1d73ab201cdf416007a13929f61efe265837ab5f0de41","89f19eb9fb55855884bc235731ffc0644ec3e9941c94550e0f3632ab2a873bc1","3598ca5b938f3a827156285373139e64d9297054a1125dbf4f2f668b01d84471","98276ec391d0835c8c67e2acd4f2c7d543ebfa2da2bc068baeb94c8a3729b9e2","11f91816d067c34dda4f75a61935b608a2d61874ba05d5f0c3e508a20acb7da0","f0e7697b0b5958917b1d148dde66d493a15c45ab5c42572f7c7d253ba5805417","62e7a324f8add610f641149af89c16903aefe2b78f2c65f2d696fd901cfaf04f","3da1cffba95f89e967746e0854b3ed792cf20a4c2bda777de620b664e174afbe","29a8a41de403f3868d4ca8390abcf1780a83a52465a58953e520e33e55cc5f22","5db2695b56e1158f6ce8c9ec2257bae11f6a0e42b301127947c3705f7d71e733","4d33f455a368a909fa08c2ea835c6bbfa3a57318ed8e97ae7536995b7546bf90","ff7fdb0d1f9dd9a5f49cb1e0243a2eea4b68d06a6d89947496edcd296e7792ce","cdc1dd18fb87f06197f2a9b34aa0f3f02ba8b9efd700a7272868a9a21511e930","eeae2ba88186aaad73779cb5a88fbd86d2576188c221b5c96d5d3256e67ebad3","579677aa5af1859c86013ced58e04e013ee6ae0e7cea61922c0d4a7165d78e78","4a7573a1869d897fe321ada9f4c0c0e506dd3f902c1277bdda38917f36479818","d76d4b922caa2a331a67cc01f291dc13dcb51fa79afc7b70a802e2c1fddf7744","05c40dd1683656b6159eed50da74e4753a2e854e219bdd321967248b80d6fb5e"],"paragraph_range_zero_based":[42816,42839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p42816"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall consider a field as not comprehended when it is defined:","paragraph_zero_based":42840},{"literal_text_all_w_t_and_m_t":"-as spare or reserved unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved field.","paragraph_zero_based":42841},{"literal_text_all_w_t_and_m_t":"10.2ASN.1 violation or encoding error","paragraph_zero_based":42842},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":42843},{"literal_text_all_w_t_and_m_t":"1>when receiving an RRC message on the BCCH, CCCH, PCCH, MCCH or a PC5 RRC message on SBCCH for which the abstract syntax is invalid [6]:","paragraph_zero_based":42844},{"literal_text_all_w_t_and_m_t":"2>ignore the message.","paragraph_zero_based":42845},{"literal_text_all_w_t_and_m_t":"NOTE:This clause applies in case one or more fields is set to a value, other than a spare, reserved or extended value, not defined in this version of the transfer syntax. E.g. in the case the UE receives value 12 for a field defined as INTEGER (1..11). In cases like this, it may not be possible to reliably detect which field is in the error hence the error handling is at the message level.","paragraph_zero_based":42846},{"literal_text_all_w_t_and_m_t":"10.3Field set to a not comprehended value","paragraph_zero_based":42847},{"literal_text_all_w_t_and_m_t":"The UE shall, when receiving an RRC message or PC5 RRC message on any logical channel:","paragraph_zero_based":42848},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that has a value that the UE does not comprehend:","paragraph_zero_based":42849},{"literal_text_all_w_t_and_m_t":"2>if a default value is defined for this field:","paragraph_zero_based":42850},{"literal_text_all_w_t_and_m_t":"3>treat the message while using the default value defined for this field;","paragraph_zero_based":42851},{"literal_text_all_w_t_and_m_t":"2>else if the concerned field is optional:","paragraph_zero_based":42852},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with the need code for absence of the concerned field;","paragraph_zero_based":42853},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":42854},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with clause 10.4.","paragraph_zero_based":42855},{"literal_text_all_w_t_and_m_t":"10.4Mandatory field missing","paragraph_zero_based":42856},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":42857},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that is mandatory to include in the message (e.g. because conditions for mandatory presence are fulfilled) and that field is absent or treated as absent:","paragraph_zero_based":42858},{"literal_text_all_w_t_and_m_t":"2>if the RRC message was not received on DCCH or CCCH; or","paragraph_zero_based":42859},{"literal_text_all_w_t_and_m_t":"2>if the PC5 RRC message was not received on SCCH:","paragraph_zero_based":42860},{"literal_text_all_w_t_and_m_t":"3>if the field concerns a (sub-field of) an entry of a list (i.e. a SEQUENCE OF):","paragraph_zero_based":42861},{"literal_text_all_w_t_and_m_t":"4>treat the list as if the entry including the missing or not comprehended field was absent;","paragraph_zero_based":42862},{"literal_text_all_w_t_and_m_t":"3>else if the field concerns a sub-field of another field, referred to as the 'parent' field i.e. the field that is one nesting level up compared to the erroneous field:","paragraph_zero_based":42863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5516a19020b7e852242aa2d52caf39e6eb77a4a56269625073b5ad10bd48d570","57ee4df829cde71f7733a686e7331cbb7a526bb0f010f5988dd520b6896da642","b7f5379370863172488c2aaf73ee2502f0ba1c9b2c63835a7d32af260b379265","e37bd18a314eea954d6316732e5d34adfeb8b1a88cbcd833158fc61fb2b307f2","ada7c5b5a7c0958e319e0bd6bce01a6b8fbce91658bab0100c3019f00e43e3d1","6c1be55ad5b112e06d7f767d2c3f05bb192d212f6f842993941013e416583e7c","c2cbb183f856da447707d5e470ab226aa10169e2f8c0f2e7da526f54af7b0958","0b40077cc5ee7c54c26db68d88ba123dbe495c2e827289086cdcd20665c2e62b","ccf5842916b9d021beadaed0347e5b245665c8df4c58eb0953c5fb51480f5129","d5e378aee3005217b358a501fee2e4c5d4648335f75c34c60a31e6a1464bfc7c","34f8dcd661c8071c953a314d7ed0484294ea0de87c457556eb5aa34e59f4c837","93c09179621938e75fe1ef4167b272d4974ce6856cc6a7b92f6332c3b0106c00","72e8a049131c3110042e91d8fe27925bd1b26f7de1e7fbbd6f6b89788813e426","8c1f59b772cb85aedbeec6c9fdf8b7db87829427e5b9279c825adbf4a630e303","f0297ab50644900cc71d4dd5bda9058bd9c16b3d8e8ef64955290fc781a92e76","c96cce48c4bcfc6cc8ea4f51a162b19a4410b68131a5cc4da4edcbcde02c56f2","256e7c7480e571ad7d78fcea23bde94b8402f74ea06d5dbd3f50f410527abc6b","e982f49de84e48a14feda2ea89632a66eacef3cba14dadb80fc4639fb8632d7c","514a1ab8bfe1f3742d47ebfdc34209768fae561e9586b47b1b3ce508b7519d6a","678c8cc39854438ae7853ba5c97706211e986c42d3be2321c5549a3e030760c9","5138ebee517321ce1511e720673889d415f0688ac70567efeacfe8ac9c18e873","9759cee9274b26244ae6ad11fa62f2845d2fccfd07cb88d52111904778780c6c","66c1c2d7b54f8a40441a3875b56d1f69028ad6381256082a47379163bec7ae54","24a6250e24fee69833a209930e913d869ed5af96458ddfcfc94faa07c144a267"],"paragraph_range_zero_based":[42840,42863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p42840"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>consider the 'parent' field to be set to a not comprehended value;","paragraph_zero_based":42864},{"literal_text_all_w_t_and_m_t":"4>apply the generic error handling to the subsequent 'parent' field(s), until reaching the top nesting level i.e. the message level;","paragraph_zero_based":42865},{"literal_text_all_w_t_and_m_t":"3>else (field at message level):","paragraph_zero_based":42866},{"literal_text_all_w_t_and_m_t":"4>ignore the message.","paragraph_zero_based":42867},{"literal_text_all_w_t_and_m_t":"NOTE 1:The error handling defined in these clauses implies that the UE ignores a message with the message type or version set to a not comprehended value.","paragraph_zero_based":42868},{"literal_text_all_w_t_and_m_t":"NOTE 2:The nested error handling for messages received on logical channels other than DCCH, CCCH and SCCH applies for errors in extensions also, even for errors that can be regarded as invalid network operation e.g. the network not observing conditional presence.","paragraph_zero_based":42869},{"literal_text_all_w_t_and_m_t":"NOTE 3:UE behaviour on receipt of an RRC message on DCCH or CCCH or a PC5 RRC message on SCCH that does not include a field that is mandatory (e.g. because conditions for mandatory presence are fulfilled) is unspecified.","paragraph_zero_based":42870},{"literal_text_all_w_t_and_m_t":"The following ASN.1 further clarifies the levels applicable in case of nested error handling for errors in extension fields.","paragraph_zero_based":42871},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":42872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42873},{"literal_text_all_w_t_and_m_t":"-- Example with extension addition group","paragraph_zero_based":42874},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42875},{"literal_text_all_w_t_and_m_t":"ItemInfoList ::=                    SEQUENCE (SIZE (1..max)) OFItemInfo","paragraph_zero_based":42876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42877},{"literal_text_all_w_t_and_m_t":"ItemInfo ::=                        SEQUENCE {","paragraph_zero_based":42878},{"literal_text_all_w_t_and_m_t":"    itemIdentity                        INTEGER (1..max),","paragraph_zero_based":42879},{"literal_text_all_w_t_and_m_t":"    field1                              Field1,","paragraph_zero_based":42880},{"literal_text_all_w_t_and_m_t":"    field2                              Field2                  OPTIONAL,           -- Need N","paragraph_zero_based":42881},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":42882},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":42883},{"literal_text_all_w_t_and_m_t":"    field3-r9                       Field3-r9               OPTIONAL,              -- Cond Cond1","paragraph_zero_based":42884},{"literal_text_all_w_t_and_m_t":"    field4-r9                       Field4-r9               OPTIONAL               -- Need N","paragraph_zero_based":42885},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":42886},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["141fc27eb84efc9e9952f9ec837efb753e64df71b179a8c5b1369bc777d65877","c558b66a54f5344bcfd536eab74cc0a0048b0ad652eb75941111c06ee9dc5cb2","6f7809ccaa393ebf94e3c2c8cc7ef51dd0a1dfa1478a90f9039442d3ccf3fb1d","2a8d0117a8c08b4061e0d388a7ed77ef9d257e7974489bf3965c10b5e55a014b","7e455d23429dfa64b4727b74ab9ad30d8e259f397ba