{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18456},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-START","paragraph_zero_based":18457},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18458},{"literal_text_all_w_t_and_m_t":"FeatureCombination-r17 ::= SEQUENCE {","paragraph_zero_based":18459},{"literal_text_all_w_t_and_m_t":"    redCap-r17                 ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18460},{"literal_text_all_w_t_and_m_t":"    smallData-r17              ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18461},{"literal_text_all_w_t_and_m_t":"    nsag-r17                   NSAG-List-r17                                        OPTIONAL,  -- Need R","paragraph_zero_based":18462},{"literal_text_all_w_t_and_m_t":"    msg3-Repetitions-r17       ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18463},{"literal_text_all_w_t_and_m_t":"    spare4                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18464},{"literal_text_all_w_t_and_m_t":"    spare3                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18465},{"literal_text_all_w_t_and_m_t":"    spare2                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":18466},{"literal_text_all_w_t_and_m_t":"    spare1                     ENUMERATED {true}                                    OPTIONAL   -- Need R","paragraph_zero_based":18467},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18468},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18469},{"literal_text_all_w_t_and_m_t":"NSAG-List-r17 ::= SEQUENCE (SIZE (1.. maxSliceInfo-r17)) OF NSAG-ID-r17","paragraph_zero_based":18470},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18471},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-STOP","paragraph_zero_based":18472},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18473},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18474},{"literal_text_all_w_t_and_m_t":"FeatureCombination field descriptions","paragraph_zero_based":18475},{"literal_text_all_w_t_and_m_t":"redCap","paragraph_zero_based":18476},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that RedCap is part of this feature combination.","paragraph_zero_based":18477},{"literal_text_all_w_t_and_m_t":"smallData","paragraph_zero_based":18478},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that Small Data is part of this feature combination.","paragraph_zero_based":18479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["bb700ba5cd27cb8b831647f8a4b829aec9d093b393b78788592c4193d18a8c2a","dd7db5d8d1cb07e36d92404418fb41ebc9059112a876cc8defa69693454ab9d0","7d82c7b9514aa64c1cbc1845e6d5d4d21dd6cbfe54da90d263ba0046d1715c6a","a21a52730300d0f74d12fd577b11ed6b6dbabe4bb83c2929fe6fd805b09b453a","cff0faaad43a75fbb6cd4824e065015791a7ff89d5c1148f8ec3c38748aa3b5e","54bf7746b18bab7c2d9871b8ccbc8ffc48e522078bf6b43fba90af00c5c9c53d","7d65fc06c654dad74ca16e61862d1a017b2ddba004e8673b475026ff40e41994","0976b4f3863de323812a065e969322c0bca8dc01989a6d33051c310092e66d10","0db39fb53eefdb6abfcd0bea27331cc883b58f83658f41774d42e6f127c443bb","ea54f2869c050e68f5a74e13f23707fb12856f0274e8c8722351b82499c17d86","a150744063359534b0c227a6000c82f03638d973d524dbb7074bde12e681bfc3","b8c5f1fe603bbc02b2e1990492ffff63da77b2d7b5ee2f2ccd7f208b3310266a","b40278067a8a2e389ceae891895091db75cf3aa0edc6e67ef7645b7608bf927f","024037fae46f0bd576a7360b8dfd84127e26b1149a76ec624b1eca70204de9e7","ad75c567e4c9b8b72d457b77edc2427a083d8f2e5c8470b484447ab06aec9980","9ff546f8beac7790ac1befe57a3f600af7170f657f581032cd871ef97ca3a481","8aee41ba2ec05dcdc588e1df6686f7f4990a624e04457292c7ab873843014a4c","3150eb7443f0cc193322d55fd3ab499ab2af5412301e224924695a608e7b528a","96d4ef44162534925d9fae9421da9a17bc8d298e31becb379c7474d5802d49ec","6c331b2f9a0df1a8d5dbd83b476c6efa000a95b4e12b0bfb6cb4c16dca669728","003ba8f66889065b12afe244d8ec63bae2f11c78d32cfada98372f2f740a329a","9ec531fd455d3680734b59ad1ea9a6ae0c0b936c64e40c781c87c111e15531e4","4a457005568c9dbd488f19cf2b6374f5fbe6be15b2feba39c7413e5c38319ae0","cd89c992e8c76d6cd30a24b46cd88d31d3c23b8627651c76373e1dee999cd124"],"paragraph_range_zero_based":[18456,18479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18456"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nsag","paragraph_zero_based":18480},{"literal_text_all_w_t_and_m_t":"If present, this field indicates NSAG(s) that are part of this feature combination.","paragraph_zero_based":18481},{"literal_text_all_w_t_and_m_t":"msg3-Repetitions","paragraph_zero_based":18482},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that signalling of msg3 repetition is part of this feature combination. This field is not configured in a set of preambles that is configured with 2-step random-access type.","paragraph_zero_based":18483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18484},{"literal_text_all_w_t_and_m_t":"–FeatureCombinationPreambles","paragraph_zero_based":18485},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombinationPreambles associates a set of preambles with a feature combination. For parameters which can be provided in this IE, the UE applies this field value when performing Random Access using a preamble in this featureCombinationPreambles, otherwise the UE applies the corresponding value as determined by applicable Need Code, e.g. Need S. On a specific BWP, there can be at most one set of preambles associated with a given feature combination per RA Type (i.e. 4-step RACH or 2-step RACH).","paragraph_zero_based":18486},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles information element","paragraph_zero_based":18487},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18488},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-START","paragraph_zero_based":18489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18490},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles-r17 ::=   SEQUENCE {","paragraph_zero_based":18491},{"literal_text_all_w_t_and_m_t":"    featureCombination-r17                FeatureCombination-r17,","paragraph_zero_based":18492},{"literal_text_all_w_t_and_m_t":"    startPreambleForThisPartition-r17     INTEGER (0..63),","paragraph_zero_based":18493},{"literal_text_all_w_t_and_m_t":"    numberOfPreamblesPerSSB-ForThisPartition-r17 INTEGER (1..64),","paragraph_zero_based":18494},{"literal_text_all_w_t_and_m_t":"    ssb-SharedRO-MaskIndex-r17            INTEGER (1..15)                                           OPTIONAL, -- Need S","paragraph_zero_based":18495},{"literal_text_all_w_t_and_m_t":"    groupBconfigured-r17                  SEQUENCE {","paragraph_zero_based":18496},{"literal_text_all_w_t_and_m_t":"        ra-SizeGroupA-r17                     ENUMERATED {b56, b144, b208, b256, b282, b480, b640,","paragraph_zero_based":18497},{"literal_text_all_w_t_and_m_t":"                                                        b800, b1000, b72, spare6, spare5,spare4, spare3, spare2, spare1},","paragraph_zero_based":18498},{"literal_text_all_w_t_and_m_t":"        messagePowerOffsetGroupB-r17          ENUMERATED { minusinfinity, dB0, dB5, dB8, dB10, dB12, dB15, dB18},","paragraph_zero_based":18499},{"literal_text_all_w_t_and_m_t":"        numberOfRA-PreamblesGroupA-r17        INTEGER (1..64)","paragraph_zero_based":18500},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Need R","paragraph_zero_based":18501},{"literal_text_all_w_t_and_m_t":"    separateMsgA-PUSCH-Config-r17         MsgA-PUSCH-Config-r16                                     OPTIONAL, -- Cond MsgAConfigCommon","paragraph_zero_based":18502},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-Threshold-r17               RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":18503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f95c266274d795f4c3aeb52b74c86d58dc92d245f105f766fc4b269b518868b5","e3c94b7f785bcd180fb3d2299c19b376b0bcb679af7f63d79ea416364bb13e6b","0f30287d9c4341cbf5a827232879dabd532a89b4d27789966b7de8aae40e0daf","95e173e47ed97f0dfcde6566593b252135aec1281966e5f4ac0633b71d39774a","ae945282194509d34cf3d696c87230762781ac5504282b2fd84934c7e715b399","5c0ecb25718afc462a4eaf333d956b8c5e273727df26170b0247d30c05a73f82","c226e6c71956cffc8d87010aeaaf4c8ba871201ed3502da4c2c46e2ac0fa478b","0a065b3bf975a7652ea5a0ddb0531c639367b113eda598bd788be9b767e9aa8e","1f5a1ab16c75d9721637190697883faaefac0e99e32c9ee7372174e400b8f7d4","79aa97aea7dc770252ebfe4e2edf302f7fc910b1bec252fc6e6eb14cd38ffad1","c78d556b9bb7bafa9bd09cb4ead22de8424f47b90db39f753541af7aa9500fc3","7ff284a840a84e805403503362e02fc69472beb8d318bb7d2c38d448e28e5b7a","01ac8451be623965306b592ff65d61a428bb7fc77737516ed31dbb327e09efc7","a63bd99abb2021184a40e10b616ff4115463d89c9f915b22db6c5f1a089fd706","54b726b8f736da2c6743101779009537e1baaa62ebf19b4bbd78962b7190c4ce","002daba6f28308adc5b089c06ccc904c541f8510b461c656c78c5a2c1e468add","e55db7d434bf8463dadb9a7cae657f0a7460d61d6f5ec51a96e76ea39953bbe2","4342520953ed0eb344a6327f7536c52bf127e6161dac40a45819a87b759ea5d6","4dbf7b4ebe417ef6851c275635343d2862f33ace6f45d3bdca542d8094a4242e","28a8e46a4b34e04d37758c600b2b9b273fe991b51ef0eb2332548b44f0870804","81cb46364940eec21a4401900b280ddbadd66b790bad2dfca307fd538c61060d","db4c52bc890650aa45cdc0181603f4bb6ec54c80ba229d789c7d170552e87f6a","51716057c83e984e32001df01db2edaaf526fa19f9e757209e34a6cb5194a57c","f2511bb8c8d7c3e29532f8fcc8898e025b7b98c6c9e239df1e18dd7c29304e05"],"paragraph_range_zero_based":[18480,18503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdSSB-r17                 RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":18504},{"literal_text_all_w_t_and_m_t":"    deltaPreamble-r17                     INTEGER (-1..6)                                           OPTIONAL, -- Need R","paragraph_zero_based":18505},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18506},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18508},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-STOP","paragraph_zero_based":18509},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18511},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles field descriptions","paragraph_zero_based":18512},{"literal_text_all_w_t_and_m_t":"deltaPreamble","paragraph_zero_based":18513},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 or msgA-PUSCH and RACH preamble transmission. If configured, this parameter overrides msg3-DeltaPreamble or msgA-DeltaPreamble, Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1). If msgA-DeltaPreamble is configured in separateMsgA-PUSCH-Config-r17, this field is absent.","paragraph_zero_based":18514},{"literal_text_all_w_t_and_m_t":"featureCombination","paragraph_zero_based":18515},{"literal_text_all_w_t_and_m_t":"Indicates which combination of features that the preambles indicated by this IE are associated with. The UE ignores a RACH resource defined by this FeatureCombinationPreambles if any feature within the featureCombination is not supported by the UE or if any of the spare fields within the featureCombination is set to true.","paragraph_zero_based":18516},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":18517},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on (see TS 38.321 [3], clause 5.1.2).","paragraph_zero_based":18518},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-Threshold","paragraph_zero_based":18519},{"literal_text_all_w_t_and_m_t":"The UE selects 2-step random access type to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). This field is only present if both 2-step and 4-step RA type are configured for the concerned feature combination in the BWP. If configured, this parameter overrides msgA-RSRP-Threshold-r16. If absent, the UE applies msgA-RSRP-Threshold-r16, if configured","paragraph_zero_based":18520},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesPerSSB-ForThisPartition","paragraph_zero_based":18521},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles are associated to the Feature Combination starting from the starting preamble(s) per SSB.","paragraph_zero_based":18522},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":18523},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles per SSB are associated to Group A starting from the starting preamble(s). The remaining preambles associated to the Feature Combination are associated to Group B","paragraph_zero_based":18524},{"literal_text_all_w_t_and_m_t":"ra-SizeGroupA","paragraph_zero_based":18525},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.2). If this feature combination preambles are associated to a RACH-ConfigCommon-twostepRA, this field correspond to ra-MsgA-SizeGroupA, otherwise it corresponds to ra-Msg3SizeGroupA.","paragraph_zero_based":18526},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":18527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["131e815c8f74a37e21d1a86515a9bd068183462de9dda5703905feda9125460f","41db937950b163e2ca52aff9732f49f2aa116fe795a61af332343691419526e2","eb212f18f3593092315d8c20c6727487ff0096b8ea3bb11e5b4067679f0fd301","d065fdf4aed706b69cc5b32a94c163e303cd03aa4aa88504eed19cd7078d64d7","89cb8c3c6ae1c31952897f19b77b5ca5d9dfb45334a605ecab80f6cfc738e975","f6644c4af77f68a13d6b4fe4839acc17f33e982255f841817889b6b4f19621d2","668c89fe6935eb6b97071d86438d00a20588961d6deefb656f77ffc901aba57c","372cad69a11f9f6ebebcc15cb36f2a5546a834175c680fe87afdfdc733d5601e","d1e5cc9b06cc91165ab04dd5dc6999accaa8c87c1da0f0f4cee5ba8b3cfe47c5","194c08db8079ee618194a4c88d968846afc7f980b58b34d8ac92732051a6c54d","4354ec98bd5497331e972f80d7a0459b6fd96a7b0c812486cdc33155a92611d4","d51fa604494a7e0e37a702be6851048348f793f7869d702cd6ebd9802347c2ec","d778916881aff6cd012abc621bb09c9c57634b42c4c12b9d30d3578b68867ee4","84009ebdd0330301d3a1d3f4de30ddd99f924a42c757f64cb91fe55fe7ab62b2","fd2d53b889c98eb3c89659d32c796537c459468d86dcfd7e1e2fadeab11cdd45","7c243eb5ddbe5243736870054929187e221c091e7536cfffa659a4b663f28ba5","c2fa9a3da627edf199a79ef1163f3c40cdebd523cf7e4c6b3fcea74fc7e77e72","77873989b58c81103ef63956b14ca54837cc628f4b082df3ec102609a9c8ec4b","b8db4a1467a3ca22410721d5e57ee8112b18e12e66bee02d713b979173bc7a8f","793c52272ebf3bac681fc77418d798b8762a36493fd79411d9335385e6292f6f","fbe9724468e5762e88245ca6db732ba5881f77365be007d3b436af0365e055bc","cae8afe20b4b07da8f3e31a6bab615edf1f977eb10f6564e6ebc329693da1960","11ed57a65449b6c9312d3ff9079bc0fd73ec7d7b6adca27c06c6b45753b20ed9","653c03d6f8007dd2c76ec2c34387fb2f3fbb8b4f23a8833ff0ee001937e909da"],"paragraph_range_zero_based":[18504,18527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18504"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be used by the UE. If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA, it corresponds to msgA-RSRP-ThresholdSSB, as defined in TS 38.321 [3]. If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommon, it it corresponds to rsrp-ThresholdSSB, as defined in TS 38.321 [3].","paragraph_zero_based":18528},{"literal_text_all_w_t_and_m_t":"separateMsgA-PUSCH-Config","paragraph_zero_based":18529},{"literal_text_all_w_t_and_m_t":"If present it specifies how the 2-step RACH preambles identified by this FeatureCombinationPreambles are mapped to a PUSCH slot separate from the one defined in MsgA-ConfigCommon-r16. If the field is absent, the UE should apply the corresponding parameter in the RACH-ConfigCommonTwoStepRA of the BWP which includes the FeatureCombinationPreambles IE.","paragraph_zero_based":18530},{"literal_text_all_w_t_and_m_t":"ssb-SharedRO-MaskIndex","paragraph_zero_based":18531},{"literal_text_all_w_t_and_m_t":"Mask index (see TS 38.321 [3]).","paragraph_zero_based":18532},{"literal_text_all_w_t_and_m_t":"Indicates a subset of ROs where preambles are allocated for this feature combination.","paragraph_zero_based":18533},{"literal_text_all_w_t_and_m_t":"If this field is configured within FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA:","paragraph_zero_based":18534},{"literal_text_all_w_t_and_m_t":"-in case of separate ROs are configured for 4-step and 2-step random access, this field indicates a subset of ROs configured within this RACH-ConfigCommonTwoStepRA;","paragraph_zero_based":18535},{"literal_text_all_w_t_and_m_t":"-in case shared ROs are used for 4-step and 2-step random access, it indicates the subset of ROs configured within RACH-ConfigCommon, which are the subset of ROs configured for 2-step random access.","paragraph_zero_based":18536},{"literal_text_all_w_t_and_m_t":"This field is configured when there is more than one RO per SSB. If the field is absent, all ROs configured in RACH-ConfigCommon or RACH-ConfigCommonTwoStepRA containing this FeatureCombinationPreambles are shared.","paragraph_zero_based":18537},{"literal_text_all_w_t_and_m_t":"startPreambleForThisPartition","paragraph_zero_based":18538},{"literal_text_all_w_t_and_m_t":"It defines the first preamble associated with the Feature Combination. If the UE is provided with a number N of SSB block indexes associated with one PRACH occasion, and N<1, the first preamble in each PRACH occasion is the one having the same index as indicated by this field. If N>=1, N blocks of preambles associated with the Feature Combination are defined, each having start index + startPreambleForThisPartition, where n refers to SSB block index (see TS 38.213 [13], clause 8.1).","paragraph_zero_based":18539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18540},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18541},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18542},{"literal_text_all_w_t_and_m_t":"MsgAConfigCommon","paragraph_zero_based":18543},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if FeatureCombinationPreambles is included in RACH-ConfigCommonTwoStepRA. Otherwise, it is absent. If the field is absent in FeatureCombinationPreambles included in RACH-ConfigCommonTwoStepRA, the UE applies MsgA-PUSCH-Config included in the corresponding MsgA-ConfigCommon.","paragraph_zero_based":18544},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18545},{"literal_text_all_w_t_and_m_t":"–FilterCoefficient","paragraph_zero_based":18546},{"literal_text_all_w_t_and_m_t":"The IE FilterCoefficient specifies the measurement filtering coefficient. Value fc0 corresponds to k = 0, fc1 corresponds to k = 1, and so on.","paragraph_zero_based":18547},{"literal_text_all_w_t_and_m_t":"FilterCoefficient information element","paragraph_zero_based":18548},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18549},{"literal_text_all_w_t_and_m_t":"-- TAG-FILTERCOEFFICIENT-START","paragraph_zero_based":18550},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["125bfdf597206d1aef48f1c25767c667a396eca688d7d62dcf50926f1fdbd64f","d20fe0c514074ae44ae99119a669267ab7353303d304c6f8eb29cb429426e579","1a0b154ba1fef3575100bf7c6060b0909491f6840676ad6513495137fd78da74","9f0e8294764e398374de1760ee531283696a4776a538518e233f94fc34cc4a31","c946437d6ec1c54f90e772e91bada5a8ad625b97825a17e79824a9a82bb14f32","eabb760526c7d4ac261cafe970e3ed201f9388dd79698dfe245c558f0293724b","87bb9b88c75e140d89f322b4bd496f7a005e03c586231c47bd42b8f792cf4a8b","0ca70bc566995f55f9ec35a2bf3881aa0f1845458b69bfe8442826ce964cfac3","921dabb46589484a4a924d9796f4b338d79c1ae45539c21edd50a65e8c767581","b90db8dfd78c64f25cd81489e89384a8f427123deebb946286c0c2514ae8be39","aa7352145c103fdba3f47fd86593f02d99def6d02d1ed2d6e1ec9f44db689c06","1b6424367484355e2cdead6ebf4a3f57db8ab7eaae8d7f69da5cacf1a77a217e","5e1e70cb4fa621179b5779d798485da9e81eae64bec4a5f588b65ec130f3298a","159817c79128d5476833cb137abd5640bb3c2235c99c71002f7a44fe31945820","76dc811f5e3b9ea7aa878e033a18271212d93d2f5d124ffee0e8264707a8576c","e498fa381a9f28ea42c9ffec82f6c6467730f80bc392eea5f8b46963648e22c0","7bd720eb0955996e25e27791e212b0c744e92a0b1107aa8cbb7a3757285cd5e9","7a13a8c0676bfd3e926669aa8112b21a6a6c0fc6edaa88f2e9f5664f7a822b26","26e2b2d80eba47dea66d5e8a585885acb2d7aca50588f4e4529e14a89274d5da","d7a4f1c551319b7390286fe1d611675fb09098709e97b1a575406b63db2e6aef","a1ae412756eafb475f6e9686bb1bd836c083052ae5a5b8f2aa6af32404879bfe","9b298a9b3385a0c2af8a50beb5fdb37e8bf50d754e2b104e7cf144c4b0b10968","42f2f7eafe02eb45b6bfc3be0b6fe95e6c3219b68440ef9c1893680d8e10ff3b","b7bfff955ca2b14d89767c828665132e8e8a1f3936054e313c45be804bfacb77"],"paragraph_range_zero_based":[18528,18551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p18528"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FilterCoefficient ::=       ENUMERATED { fc0, fc1, fc2, fc3, fc4, fc5, fc6, fc7, fc8, fc9, fc11, fc13, fc15, fc17, fc19, spare1, ...}","paragraph_zero_based":18552},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18553},{"literal_text_all_w_t_and_m_t":"-- TAG-FILTERCOEFFICIENT-STOP","paragraph_zero_based":18554},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18557},{"literal_text_all_w_t_and_m_t":"–FreqBandIndicatorNR","paragraph_zero_based":18558},{"literal_text_all_w_t_and_m_t":"The IE FreqBandIndicatorNR is used to convey an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39] and TS 38.101-5 [75].","paragraph_zero_based":18559},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorNR information element","paragraph_zero_based":18560},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18561},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATORNR-START","paragraph_zero_based":18562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18563},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorNR ::=             INTEGER (1..1024)","paragraph_zero_based":18564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18565},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATORNR-STOP","paragraph_zero_based":18566},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18567},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18568},{"literal_text_all_w_t_and_m_t":"–FreqPriorityListDedicatedSlicing","paragraph_zero_based":18569},{"literal_text_all_w_t_and_m_t":"The IE FreqPriorityListDedicatedSlicing provides dedicated cell reselection priorities for slicing in RRCRelease.","paragraph_zero_based":18570},{"literal_text_all_w_t_and_m_t":"FreqPriorityListDedicatedSlicing information element","paragraph_zero_based":18571},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18572},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTDEDICATEDSLICING-START","paragraph_zero_based":18573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18574},{"literal_text_all_w_t_and_m_t":"FreqPriorityListDedicatedSlicing-r17 ::= SEQUENCE (SIZE (1.. maxFreq)) OF FreqPriorityDedicatedSlicing-r17","paragraph_zero_based":18575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3d9d75d393a4f678e45889d626c1b952b375b9600f3653b0424cdeabb6d02d1f","c71f72de37eb173b27603451c9c249d53a4d1da861bfa47fcfb4166a9dcfd040","1a98d0458aa119187e59842c981a5838f4a38bd5b99c8f22a97b1489225113b5","5472d7c5c68b5dd92a41720cd6b8ca7fb0138569a84fd85753a40d9e79470b42","a671227b8ca713b20ecb5488198904ce062673af2e5ff4f3af767410e0a32a1d","c27cf390984f857fa2826d0601acf33d0e84520aad9475e7d59ebb3b9c765f4b","80240d2bdc46e5eaa1e9e1d0e1864f518b173d990485188de105a70beeb0fc2c","69a3f747f076404c8b01eb155c30ac15626cc60556ac9bea9f4ac617e158e1ca","b96f9e67760d026968c8a7fefcf731c5065ce61eea565f114137f6b92dd5c04e","5dfa5877a29cf3b48b86c72e998a100457f527f167170ab33517ec19b92200ec","a70d444a4405973cb08f21efda97b5d8b0ff631a6e630f80ec915da240eb1b04","bb8d0b0ffc1cdb842980c0f61b913b581cdcee6aef5d93b214ec8e25400b43bb","8d20519305365570c108ee6fc5df2c136f02095863a601b2743911ae11b52ba0","1334d0088ea8650d425d0044f63ac5e7cfc5e3c630daf0099eed989014fa8a05","e8c9645db88812dad729f879dbc3da28ec1c2a77ead2dd40ffec4f40a9df55f8","c57a223079eda77f076dc8927addf