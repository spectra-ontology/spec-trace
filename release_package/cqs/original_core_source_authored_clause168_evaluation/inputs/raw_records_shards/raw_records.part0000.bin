{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-SRAP-Config is used to set the configurable SRAP parameters used by L2 U2N Relay UE and L2 U2N Remote UE as specified in TS 38.351 [66].","paragraph_zero_based":39552},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config information element","paragraph_zero_based":39553},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39554},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-START","paragraph_zero_based":39555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39556},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config-r17 ::=                  SEQUENCE {","paragraph_zero_based":39557},{"literal_text_all_w_t_and_m_t":"    sl-LocalIdentity-r17                    INTEGER (0..255)                                                 OPTIONAL, -- Need M","paragraph_zero_based":39558},{"literal_text_all_w_t_and_m_t":"    sl-MappingToAddModList-r17              SEQUENCE (SIZE (1..maxLC-ID)) OF SL-MappingToAddMod-r17          OPTIONAL, -- Need N","paragraph_zero_based":39559},{"literal_text_all_w_t_and_m_t":"    sl-MappingToReleaseList-r17             SEQUENCE (SIZE (1..maxLC-ID)) OF SL-RemoteUE-RB-Identity-r17     OPTIONAL, -- Need N","paragraph_zero_based":39560},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39561},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39563},{"literal_text_all_w_t_and_m_t":"SL-MappingToAddMod-r17 ::=              SEQUENCE {","paragraph_zero_based":39564},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-RB-Identity-r17             SL-RemoteUE-RB-Identity-r17,","paragraph_zero_based":39565},{"literal_text_all_w_t_and_m_t":"    sl-EgressRLC-ChannelUu-r17              Uu-RelayRLC-ChannelID-r17                                        OPTIONAL, -- Cond L2RelayUE","paragraph_zero_based":39566},{"literal_text_all_w_t_and_m_t":"    sl-EgressRLC-ChannelPC5-r17             SL-RLC-ChannelID-r17                                             OPTIONAL, -- Need N","paragraph_zero_based":39567},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39568},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39570},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-RB-Identity-r17 ::=         CHOICE {","paragraph_zero_based":39571},{"literal_text_all_w_t_and_m_t":"    srb-Identity-r17                        INTEGER (0..3),","paragraph_zero_based":39572},{"literal_text_all_w_t_and_m_t":"    drb-Identity-r17                        DRB-Identity,","paragraph_zero_based":39573},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39574},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["04554f7c01d662e2a1a71cd8e43d114284f5c67f3393aad7d3ee7eca32ca24b1","dfe5565c50a2bf99a7c9668af081c2b2989a96a3128ca5b7f6cab219f139c3b4","51edc0d06080a530c113c06bcbe4c6efc8a680435289efa7ae11668fb17ce4cb","bd97ff9df799b877842722d1790948e66b398be002baf021a09b64d2f6b64641","8e5e2931fc010f51f894967fa6eca8b35707ee4a1e6557326aedb54e5035d02d","56acd26bf4b1b6f8321820ff4a53455c1a74db3ededab200572cd9cb4f891eed","3fe1bc7ae6ed594ba64c55490336b62d77d408e79d30db90fea36ee703f87d1f","131eb34c800e22e0ad54ea82947d3df0a789422d456f01102ee76417490b7bea","037a1239c3023fdc5cf0e76f00fdadd596a34cf88ea5094b1307d9bf72a0fa70","660fde94a949b798bf9016fe9ad472ed3ee67769045b89729aa51dd605ca75ff","8b698d3563d0