{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl320                               INTEGER(0..319),","paragraph_zero_based":19776},{"literal_text_all_w_t_and_m_t":"    s1640                               INTEGER(0..639),","paragraph_zero_based":19777},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":19778},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19779},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19780},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTCLI-STOP","paragraph_zero_based":19781},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19782},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19783},{"literal_text_all_w_t_and_m_t":"CLI-ResourceConfig field descriptions","paragraph_zero_based":19784},{"literal_text_all_w_t_and_m_t":"srs-ResourceConfig","paragraph_zero_based":19785},{"literal_text_all_w_t_and_m_t":"SRS resources to be used for CLI measurements.","paragraph_zero_based":19786},{"literal_text_all_w_t_and_m_t":"rssi-ResourceConfig","paragraph_zero_based":19787},{"literal_text_all_w_t_and_m_t":"CLI-RSSI resources to be used for CLI measurements.","paragraph_zero_based":19788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19789},{"literal_text_all_w_t_and_m_t":"MeasObjectCLI field descriptions","paragraph_zero_based":19790},{"literal_text_all_w_t_and_m_t":"cli-ResourceConfig","paragraph_zero_based":19791},{"literal_text_all_w_t_and_m_t":"SRS and/or CLI-RSSI resource configuration for CLI measurement.","paragraph_zero_based":19792},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19793},{"literal_text_all_w_t_and_m_t":"SRS-ResourceConfigCLI field descriptions","paragraph_zero_based":19794},{"literal_text_all_w_t_and_m_t":"refBWP","paragraph_zero_based":19795},{"literal_text_all_w_t_and_m_t":"DL BWP id that is used to derive the reference point of the SRS resource (see TS 38.211[16], clause 6.4.1.4.3)","paragraph_zero_based":19796},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":19797},{"literal_text_all_w_t_and_m_t":"The index of the reference serving cell that the refBWP belongs to. If this field is absent, the reference serving cell is PCell.","paragraph_zero_based":19798},{"literal_text_all_w_t_and_m_t":"srs-SCS","paragraph_zero_based":19799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7b916c767962883a0f424f89e4e43814ae584d0138fa23a20a5453d0588fb606","e8cd1489785f3d5d5cbe6aadd8845f3c9651ea4e61a5637881da62206dd78126","1debe55f4bcc651ccbc43fa0bac82a9cbc92351033499926c815e96e663d7b0a","ed8a8fef42e3df693cb1dd1e6f0142022617891fb4cca736a7553122e8064fec","feb4ccb8dedcae092d224a189d88a1c7210cbd9d3a5b880c55f61407acd88a60","4b200f710795ab3bd89b1f53433d4ec63e37c41c130d74b3f3b28dd2c77b43de","11b54a3f10f70f77b491dcf1e094ee2b435640f7701b61531b160fffa156ce9e","3e7a4c6011f2aa5d4639fb232b486f404f69fe4a82e06c41a25851e09cd05e97","e6a83fbc36e14adfa499cc1244d75beaad43b4748faec9979cb91e0ce217eff2","d512df622a6a7b4d9f11f38aacc0ea09b819342229827f8e89385974d2f2a577","576c732474b444f347b51db444a16cdbb3f0b433611093e526a33f33b77f25c9","ac17eb49a7a48d2b6850488c6e6c865e5d0cea4bda2facb9d6ee84103f41f0d6","b8a66cc4281b13b40b1541a1c6dd02ae6e360a9cdbbe8521dfaf37f6fbd99875","aedef1dd2b75ff79638e80733e83bc901c57653184edc6a7992debfb2c3c9929","99b470b9a3fc79d38072c55656f55e099feb6f28a39792a77925fff7c27f5b8c","34c381bd99378e488585088507655759a2f44d47691e725b60b9e2b5bcb1307d","f0f9ba37663386d5fa954bfbe170719730b53a0a7efb5f9d5ba3e01396ead557","e90fee2969dcdec297794a82450bfc62a16636753f8319610817b8e77d2428fe","208b1523c7ec4d1586ea3ba938d67cc12b36efec0cc895ff0a33abcdf6a2bee5","2ca285e823231895215bde9c32fb7d53421c431e81627a48d79abe4077e66a94","b0ca603b99e8308077c2e3e0c50870c50d98bf6dffaf5cc4e2ad31a6730561c7","a03dfa19ca7761c137648a297e8d6f17821333d6d3006081ac9873a3f401a176","334a7ab20555f7f4a75ab41969143534c398d27dfe6d113b52ea47c16ac88de1","169467cf0da1f68dda5835179310c0cc97edc6b801abc5904a030e3c6682b809"],"paragraph_range_zero_based":[19776,19799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19776"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for SRS.","paragraph_zero_based":19800},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19801},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":19802},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":19803},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19805},{"literal_text_all_w_t_and_m_t":"RSSI-ResourceConfigCLI field descriptions","paragraph_zero_based":19806},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":19807},{"literal_text_all_w_t_and_m_t":"Allowed size of the measurement BW. Only multiples of 4 are allowed. The smallest configurable number is the minimum of 4 and the width of the active DL BWP. If the configured value is larger than the width of the active DL BWP, the UE shall assume that the actual CLI-RSSI resource bandwidth is within the active DL BWP.","paragraph_zero_based":19808},{"literal_text_all_w_t_and_m_t":"nrofSymbols","paragraph_zero_based":19809},{"literal_text_all_w_t_and_m_t":"Within a slot that is configured for CLI-RSSI measurement (see slotConfiguration), the UE measures the RSSI from startPosition to startPosition + nrofSymbols - 1. The configured CLI-RSSI resource does not exceed the slot boundary of the reference SCS. If the SCS of configured DL BWP(s) is larger than the reference SCS, network configures startPosition and nrofSymbols such that the configured CLI-RSSI resource not to exceed the slot boundary corresponding to the configured BWP SCS. If the reference SCS is larger than SCS of configured DL BWP(s), network ensures startPosition and nrofSymbols are integer multiple of reference SCS divided by configured BWP SCS.","paragraph_zero_based":19810},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":19811},{"literal_text_all_w_t_and_m_t":"The index of the reference serving cell. Frequency reference point of the RSSI resource is subcarrier 0 of CRB0 of the reference serving cell. If this field is absent, the reference serving cell is PCell.","paragraph_zero_based":19812},{"literal_text_all_w_t_and_m_t":"rssi-PeriodicityAndOffset","paragraph_zero_based":19813},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this CLI-RSSI resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots.","paragraph_zero_based":19814},{"literal_text_all_w_t_and_m_t":"rssi-SCS","paragraph_zero_based":19815},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for CLI-RSSI measurement.","paragraph_zero_based":19816},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":19817},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":19818},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":19819},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":19820},{"literal_text_all_w_t_and_m_t":"UE performs CLI-RSSI measurement with the SCS of the active bandwidth part within the configured CLI-RSSI resource in the active BWP regardless of the reference SCS of the measurement resource.","paragraph_zero_based":19821},{"literal_text_all_w_t_and_m_t":"startPosition","paragraph_zero_based":19822},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CLI-RSSI resource within a slot.","paragraph_zero_based":19823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["eeffaa9495d016e2f72ec744be1ccc28495f337bff91e7d3d4a25f78cd9a7c56","240c58114f926f64f42d3de88a2d535d8156569a183b721b2f9ef11bbcf3417c","545884749f6812a1fe2afa9d605700f04682a063d236cda18ebb5bc3bcd14ad3","64f95a4dee68b34a7f778154a51845d773da577ce4c563ed6ca231900ac7137a","93407c9205d114a86df594f4497892312766db46e83d61192f2af3770f6c267a","fa13f00ffeb0a962b9621cf95cd162c2d53d7cc97a9339b4f824032641c52eb5","10c42277e2bd027645e72a8b77de4458ab5b2a3b218356014f9da0215b3ec101","11ecddd8e86405dddfb595ae1f1780847a466fd4cda1f3022aea31e116199f38","6ce8babd58e7aacc3ee45de26de900653ad71671aada9f1e6754a848b4ec8c97","b5e8f09a316a18ef03ef1d111e8e882ba266fc7b1757ddd1fcb0c946602bcbfd","fa848c711d1275e2df6a6998627ed981dc241532fb8f86bad44f1751a60afd84","e494c0b452f6889aab188da5299e0d1d38b721affa53101ebdf51588be389d92","ce218dbf7e8b9dd7ffd7610beeb2f0b087481ab871d147b20d201740765d046a","0b2efe8ced52c6cc0040d18582b6776addac0ec705e924f0622d6c44266dd0f4","783bd24f317206137e9287bdd410a66943ced2ed3de90d56be41a84875edbbf7","32ef5559b3c13a51a62bdc3a99c69102d840e136d3fff24a609ce4b58b6b00b2","f6fa4a8a3b2f6cde940cefc32a610168f2392028aeb7e6b1475d31e0f84fe5a2","f5459de431e33cb42d61ed1a869580a82ae460afacc3e06533d9614e21981371","96aea2304f05ba02878c3cfa66b9e173db3cefb0e206201cc0f81bf818c704e2","964ca94173a1b06c0ac3ec38a55ed2fdde6c58811a7e1c90a48619f22a2ce93e","8bec21613dfeaed7197685c23cfe5eed0e14df2a6149fedd784d1e0e2869f01a","c7ece09460f52c95e215fb9ff828f403a0ca9a4a0415b96c81493adf59edca21","1d97955f80f814cf06f0aa35bd1f23460217cd7c5ef2ba7d709e4594146cec5e","2fa7288b2654900d2d1fa3992a0b0e4a37d9752d1d58951c3cdb3a4a24d47390"],"paragraph_range_zero_based":[19800,19823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p19800"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":19824},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. For the case where the reference subcarrier spacing is smaller than subcarrier spacing of active DL BWP(s), network configures startPRB and nrofPRBs are as a multiple of active BW SCS divided by reference SCS.","paragraph_zero_based":19825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19826},{"literal_text_all_w_t_and_m_t":"–MeasObjectEUTRA","paragraph_zero_based":19827},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectEUTRA specifies information applicable for EUTRA cells.","paragraph_zero_based":19828},{"literal_text_all_w_t_and_m_t":"MeasObjectEUTRA information element","paragraph_zero_based":19829},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19830},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTEUTRA-START","paragraph_zero_based":19831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19832},{"literal_text_all_w_t_and_m_t":"MeasObjectEUTRA::=                          SEQUENCE {","paragraph_zero_based":19833},{"literal_text_all_w_t_and_m_t":"    carrierFreq                                 ARFCN-ValueEUTRA,","paragraph_zero_based":19834},{"literal_text_all_w_t_and_m_t":"    allowedMeasBandwidth                        EUTRA-AllowedMeasBandwidth,","paragraph_zero_based":19835},{"literal_text_all_w_t_and_m_t":"    cellsToRemoveListEUTRAN                     EUTRA-CellIndexList                                         OPTIONAL,    -- Need N","paragraph_zero_based":19836},{"literal_text_all_w_t_and_m_t":"    cellsToAddModListEUTRAN                     SEQUENCE (SIZE (1..maxCellMeasEUTRA)) OF EUTRA-Cell         OPTIONAL,    -- Need N","paragraph_zero_based":19837},{"literal_text_all_w_t_and_m_t":"    excludedCellsToRemoveListEUTRAN             EUTRA-CellIndexList                                         OPTIONAL,    -- Need N","paragraph_zero_based":19838},{"literal_text_all_w_t_and_m_t":"    excludedCellsToAddModListEUTRAN             SEQUENCE (SIZE (1..maxCellMeasEUTRA)) OF EUTRA-ExcludedCell    OPTIONAL,    -- Need N","paragraph_zero_based":19839},{"literal_text_all_w_t_and_m_t":"    eutra-PresenceAntennaPort1                  EUTRA-PresenceAntennaPort1,","paragraph_zero_based":19840},{"literal_text_all_w_t_and_m_t":"    eutra-Q-OffsetRange                         EUTRA-Q-OffsetRange                                         OPTIONAL,    -- Need R","paragraph_zero_based":19841},{"literal_text_all_w_t_and_m_t":"    widebandRSRQ-Meas                           BOOLEAN,","paragraph_zero_based":19842},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19843},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19844},{"literal_text_all_w_t_and_m_t":"    associatedMeasGap-r17                       MeasGapId-r17                                               OPTIONAL     -- Need R","paragraph_zero_based":19845},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19846},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f79fc93fa5a365eede0f389da97724f8b28ef00b2c5d1205bbc49b4bbbf9d92c","023eab2792f346ec0fb544e825f68515b08974585538604df79b3b4b26606611","6551664043c583ab8934be33f3f44eab57c5483bb5454ddc845d694ba63903fd","d8878a581d8cb3a30e4faf8fe5d4d71e4435f7efe9ea06adb1bbd6b52a808590","79a42fe54755c757097afc5a83d765def144ee5fb117de234fc3c21fa6592d22","671efdcca23ff286