12230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p16824"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–ControlResourceSetZero","paragraph_zero_based":16848},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSetZero is used to configure CORESET#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":16849},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero information element","paragraph_zero_based":16850},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16851},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-START","paragraph_zero_based":16852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16853},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero ::=                  INTEGER (0..15)","paragraph_zero_based":16854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16855},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-STOP","paragraph_zero_based":16856},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16858},{"literal_text_all_w_t_and_m_t":"–CrossCarrierSchedulingConfig","paragraph_zero_based":16859},{"literal_text_all_w_t_and_m_t":"The IE CrossCarrierSchedulingConfig is used to specify the configuration when the cross-carrier scheduling is used in a cell.","paragraph_zero_based":16860},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig information element","paragraph_zero_based":16861},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16862},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-START","paragraph_zero_based":16863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16864},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig ::=        SEQUENCE {","paragraph_zero_based":16865},{"literal_text_all_w_t_and_m_t":"    schedulingCellInfo                      CHOICE {","paragraph_zero_based":16866},{"literal_text_all_w_t_and_m_t":"        own                                     SEQUENCE {                  -- Cross carrier scheduling: scheduling cell","paragraph_zero_based":16867},{"literal_text_all_w_t_and_m_t":"            cif-Presence                            BOOLEAN","paragraph_zero_based":16868},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":16869},{"literal_text_all_w_t_and_m_t":"        other                                   SEQUENCE {                  -- Cross carrier scheduling: scheduled cell","paragraph_zero_based":16870},{"literal_text_all_w_t_and_m_t":"            schedulingCellId                        ServCellIndex,","paragraph_zero_based":16871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4c4381de5f623229fc3365799e05388a5b7d293cb3ef034243eeeaefb6f1b31d","fe496b6b1b0696a73e5b6b26c42aeacab7521a93b07c3eba51cc0fba5c93d045","bf55d63df94dd0392ee46f4fb72d54c2438de5bc186382cd3a8ad52511c3692f","40e5902575634cedfc29a984124eae440daa12a9eefb3b1a8659835a4fe9d4f9","68a8c6d8fa41c30790c4ecf44424656e9f38711866ba4168e5ff42ca817e7c32","6f06d2aeb404fff2b0a40c0cd57e9887f2ea5355ea4cf2622cbb4873c888a82f","be33590415c81e764e9a4f6a6da3e0c9877d08559781b2c8d2428a352651326e","7c6725fb422e12ee7799fb90183c773849bd03cb88a7e970c4e0a60346403032","5a8a6845558ae9c2d98ff3d64466fc34ac607e27360bfe980f906a76b3c82ac9","c5893eb1ee589a65182c4829c17d34d84f522626fa5755abc8b8b11bfee3559a","573b872711bdae3d11766a3547056389e0c7bbe18fdeb7805948f97bbdb0a66f","033d88c28697585436eb47b0675e82e2bc033098561dc3b6b0018630a841e15b","086bfd559454cc7d387ce87857d68b4a13c88bccf0ff9a