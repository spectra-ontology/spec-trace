{"fields":{"filename":"R2-2300389.zip::R2-2300389.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommon","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommon is used to configure cell specific parameters of a UE's serving cell. The IE contains parameters which a UE would typically acquire from SSB, MIB or SIBs when accessing the cell from IDLE. With this IE, the network provides this information in dedicated signalling when configuring a UE with a SCells or with an additional cell group (SCG). It also provides it for SpCells (MCG and SCG) upon reconfiguration with sync.","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon information element","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-START","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon ::=         SEQUENCE {","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"    physCellId                          PhysCellId                                                          OPTIONAL,   -- Cond HOAndServCellAdd,","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommon                                                OPTIONAL,   -- Cond HOAndServCellAdd","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommon                                                  OPTIONAL,   -- Need M","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    supplementaryUplinkConfig           UplinkConfigCommon                                                  OPTIONAL,   -- Need S","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                                   OPTIONAL,   -- Need S","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                CHOICE {","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"        shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"        mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"        longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond AbsFreqSSB","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"    ssb-periodicityServingCell          ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }   OPTIONAL, -- Need S","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround               SetupRelease { RateMatchPatternLTE-CRS }                            OPTIONAL, -- Need M","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList        SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL, -- Need N","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL, -- Need N","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"    ssbSubcarrierSpacing                SubcarrierSpacing                                                   OPTIONAL, -- Cond HOAndServCellWithSSB","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"c7e60e196f658e3187eac15b2334b6457ddd7091cde40f923c6d5d20e088fd75","original_member_sha256":"1523b9101b790ceb291307f49f9833fb440bf047f8e1a28422ad262497223b44","paragraph_ElementTree_utf8_XML_sha256":["b7f148d3a56339746110ce798eff45fc47ee83a49b4533e49a76358a7b2a5b95","602655a0e81d162564f442f50e6ffc969fe61889e83266157e0502d61e572ac6","f7105f1b7ccf1d3be053d2620aaf19728e29b338cced3cfa02d9db78c291ca4e","cfc8a917b9b7327603eeb55e05f24c7125cf092e63eda8573d1ed001844fb0ca","0c80214d4a1f17aa1cee390d4bbb013cd73fa62b7a27d44f8bf8831722f38c73","7690f7cb9bc3b2e97063f5e0831c836ed1e69c3947df19d232785971015f82a5","3f9cdecea7677e68eb2d9a064fac1246fd08a353842d36911e1458ca43e11522","df95581b69235d21d14de7683209e18a504e9c63d3e5bc02ad9670cb8f12021c","0916c873576ab2a235abcfc3433592a3d4e0ca5faa3d647488fd2c9f114ab299","fb7bca11f222dc756f35f9a446abbf96eb12986b7e1cf80650d6c627fd859c07","d0daf3766356e27f14b851b81dec69d5eb13646def7c31d920a6f3d2a3f0920a","effedc1d6810541457894a3eb6a39d1627159b36f6c1eeaf8a5e0e088598bf6f","dba33cfcd70bd5321a2585a24ef07e7f8070393bea4b22ea85fab98826316722","1d90efc38afb1d3b0e0c1872ceb2cad4e4e42d736724e8db73ca0f34fbb514f5","26a3774d98384cdf730ceb31308523fbbe417865dbb5e9bc8fc235f9ba379479","38c767c23df55e65dae08dddc4f4fea8334a952ded031ebf69057a25fa80dae1","d7db32b7786d3d235f9669b730eb3e6aad57ee8637945107f6b2142edf2dbb5a","c876730a343f57b413ded048fa48400573a96d49e640f2a6d67a3b35e75369ff","bee03e65101f8269498288124fff5335fd1f3bb16617445357c8222867336198","7dcf79e5eb2ad530a38720c67013f078e4e29c8538e589d3b567a8d6ed38eec4","43ce9d0cb7b112a19d9858a14dcdd74b87a5a81a674cda9cebcdd0246b322956","f128b59b0e47c28599c1defd6b4cfe2059d68330a193c217cf7e400199373429","d16889c1ee4127b8a14075caeee6b2108d7a7df96e1f316470f8c11702cf31d8","c946fa18f96bf3b62df4ab2fbe2b8930f90533f70d24ec6c9a0a413f3f2