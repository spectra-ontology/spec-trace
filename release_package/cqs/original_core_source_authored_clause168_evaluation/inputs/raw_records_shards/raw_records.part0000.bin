6ae6fb02903dfe87","94ca3870bdd6d28739b67283c03abaaa4a53c5359d14346571e2877ebf0be138","113378e2ebcddc40a8871dcb7b63f78a4902e999a448575a0a62fa363e55b69e","09a17a96a91ca30cdbffd81ac435378cbc2ff7d67e4bccde6762fa8ee4e551f3","3eb8a83049260a17f4db27ac7e6d971a433091b5ce1064d45c76705a8f569d17","aaca6aef3e4c684060551f805aedac466ebde6f85bbac0fa12b3d7554f5c584b","0633dc807216af319a73674ec4cb111f8e6be20523f9cf620dc78af8763dfc4d","574badbb2f70bf7b1a9984d37e65b07aa3f6da9b52b405f41d37b731ed016a2b","bc98a921113e68aa35bf2c0ffa423507b2ab30f3b6462259800c11bd6821c283","d7abb7d24fd3d6856eb2a92f815a45639725727e62fed9be3582001fae9a688b","43b73553d7af4d8a6a50137804c7894a65e81fe7a7396d5257ac956432e8f5fe","1ee49290c58dc7a5e5ef65760748d3f92eb4d038c1a2dceaa194eabe49d115c1","65a79e2a5e2ba45249dfb17368c17b559d2bbc0fbd10edc0ed973df10d3279fc","ee8e6df6fc2395c6a636cea5c09397025e1c810ce7014fb1ed4c57dc751b68e6","f90c35f9dc6176cab64e2c1cbc3d9b48742b476a65a493fca6bf924f3c999f56","bcfe4aa971b619aaeee24f0a96f4bc638b36f037cb04e86c6f0482b1849cc1a4","636b51901f8afc541ac1a2c6021633919e244ab764dac5c2216bb790a5e49711","bcea0a97e344757f4efbf00a1b8231a8a188e90aaba61f846826f7d59dbf7017","6289ceb2c0feb481c4b477fcdcb29d1796cf731d0e87ca410abd33a255306b69","771fa967267e99e8da568eb511276b837fcc62bc303543b1be6e332fd1dad1a9","46f134f6794b8fbd57bbe18cbd80b53dc795bec991bc8191ffac148dc206f6a8"],"paragraph_range_zero_based":[11424,11447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11424"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11449},{"literal_text_all_w_t_and_m_t":"FeaturePriority-r17 ::= INTEGER (0..7)","paragraph_zero_based":11450},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11451},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB1-STOP","paragraph_zero_based":11452},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11454},{"literal_text_all_w_t_and_m_t":"SIB1 field descriptions","paragraph_zero_based":11455},{"literal_text_all_w_t_and_m_t":"cellBarredNTN","paragraph_zero_based":11456},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to NTN, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to NTN. If not present, the UE considers the cell is not allowed for connectivity to NTN, as defined in TS 38.304 [20]. This field is only applicable to NTN-capable UEs.","paragraph_zero_based":11457},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap1Rx","paragraph_zero_based":11458},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":11459},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap2Rx","paragraph_zero_based":11460},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":11461},{"literal_text_all_w_t_and_m_t":"cellSelectionInfo","paragraph_zero_based":11462},{"literal_text_all_w_t_and_m_t":"Parameters for cell selection related to the serving cell.","paragraph_zero_based":11463},{"literal_text_all_w_t_and_m_t":"eCallOverIMS-Support","paragraph_zero_based":11464},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports eCall over IMS services as defined in TS 23.501 [32]. If absent, eCall over IMS is not supported by the network in the cell.","paragraph_zero_based":11465},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedIdle","paragraph_zero_based":11466},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for CN paging is allowed in the cell for UEs in RRC_IDLE or RRC_INACTIVE. The UE shall stop using extended DRX for CN paging in RRC_IDLE or RRC_INACTIVE if eDRX-AllowedIdle is not present.","paragraph_zero_based":11467},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedInactive","paragraph_zero_based":11468},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive is not present.","paragraph_zero_based":11469},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":11470},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as RedCap, Slicing, SDT and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":11471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7b48f81d7e61ca68c590540f39696ceb6ec3ceada976e78eaeb74ae56f6750b3","6802d44cc6129145a39647e1d437aa03b88dfa760d4944fb90fe1a93993adef9","03d88902077d6559375600a16b3766e4594e82f3834195acd3525dcfb4cc0b77","3699c709a692a96c4ff9bb9b11d2b4d6bccf5e8dcef1c85e4f612db6340ebdae","4310013d43de827f4c52fac4e2f7d9cc41af65ef9e0eca00493bef8d744f0eb4","b34fd203e162e292b7ed48bbce0bd8c49e685d36166a11554ca6a47b60073f26","ea318887efac3a88ce0d64ed2fa2c22fb670c560df111c08b95f372bb9f2bcf7","43e1f55a18ad80bf9b819e473be3483a27f6269ae111c8247ed7e7998d51af0a","b793b73e768c6dd41e83f19fbcf60a201d9ffd584303a96b4428635ae901804d","00c70eb3bb455943ced556c784f43d46cb15f26e033900fe85de1820ce8e16ad","f29fc7d9080b4b20dbe874c2cb8fde977da95fee1db7a11a3266bf9e252bbff5","3f5cce92630bdda23a64606994a86b2a40c48913a0734e55dee106f5ac9042dd","3052abcf2e4a3bb712c54a0a9d2d28c44a9f5899a2129b6abd3ba406e05bce40","e9ff1fe5a3c23ce0c6c1adfa63b839c960744428733a3bc67262f1f6381ee0a3","15a14f5d641b9fc5f110bae58ff34387f062f7c636126a995408dbb1d760d2fe","c4c56b712d7dc9e0a2bd6d4ca3c5e8a3a97888ab162adc958ee4b0935fe6ad91","0cc834cafce770bbd4fdebcefa0d65a8c791f56c7db96cdaa8137630e7fc1f57","d31eb038d43a07edeca2025cf1f9bca807ee5b3230040fa5f721368cb5b98c9f","f7b87fdcabe10facff3f32046d180d5582259e85a42fccbc937bbc857ff96b89","7adb0bc826bbf2859ff8b1c2d24f129ef48f3b062eb42f0dec26bb10b275544f","da8d7b5cdca5adfc0fee7c5007220bc330cfcb772ce04cea477abfda284b9dc0","a061df20fde582762bab2841ecb05d2c030dea391830aaf5dcd0879e9b5492c1","2bb04aa5d6ff2197d48b0647d1573d0bbec68d4f8e7cd0031ae67d8e5c997c4d","cb7cebd842ff762baab32d13414284b4321368a8b449e241715c5ceb0078a934"],"paragraph_range_zero_based":[11448,11471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11448"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"halfDuplexRedCap-Allowed","paragraph_zero_based":11472},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the cell supports half-duplex FDD RedCap UEs.","paragraph_zero_based":11473},{"literal_text_all_w_t_and_m_t":"hsdn-Cell","paragraph_zero_based":11474},{"literal_text_all_w_t_and_m_t":"This field indicates this is a HSDN cell as specified in TS 38.304 [20].","paragraph_zero_based":11475},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":11476},{"literal_text_all_w_t_and_m_t":"Indicates hyper SFN which increments by one when the SFN wraps around. This field is excluded when determining changes in system information, i.e. changes of hyper SFN should not result in system information change notifications.","paragraph_zero_based":11477},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsEUTRA","paragraph_zero_based":11478},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for EUTRA idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform EUTRA idle/inactive measurements.","paragraph_zero_based":11479},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsNR","paragraph_zero_based":11480},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform NR idle/inactive measurements.","paragraph_zero_based":11481},{"literal_text_all_w_t_and_m_t":"ims-EmergencySupport","paragraph_zero_based":11482},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports IMS emergency bearer services for UEs in limited service mode. If absent, IMS emergency call is not supported by the network in the cell for UEs in limited service mode.","paragraph_zero_based":11483},{"literal_text_all_w_t_and_m_t":"intraFreqReselectionRedCap","paragraph_zero_based":11484},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for RedCap UEs when this cell is barred, or treated as barred by the RedCap UE, as specified in TS 38.304 [20]. If not present, a RedCap UE treats the cell as barred, i.e.,the UE considers that the cell does not support RedCap.","paragraph_zero_based":11485},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":11486},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for serving cell. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":11487},{"literal_text_all_w_t_and_m_t":"q-QualMinOffset","paragraph_zero_based":11488},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffset\" in TS 38.304 [20]. Actual value Qqualminoffset = field value [dB]. If the field is absent, the UE applies the (default) value of 0 dB for Qqualminoffset. Affects the minimum required quality level in the cell.","paragraph_zero_based":11489},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":11490},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":11491},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffset","paragraph_zero_based":11492},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffset\" in TS 38.304 [20]. Actual value Qrxlevminoffset = field value * 2 [dB]. If absent, the UE applies the (default) value of 0 dB for Qrxlevminoffset. Affects the minimum required Rx level in the cell.","paragraph_zero_based":11493},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":11494},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":11495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["44d003fc0127d8fbbb858ba0793b0805c91fdaa10255e096d6d188d433fa4096","03596d9c0d75c858ebd5a667ba1048d887719d11c239e6e3919fe5bc0f3ccf41","9d69290870b9f1c974b1e9d83f30dbdff03ff7ad97602db2425491fb517956d8","1779cfee71608b1e6213968091909210fa681b5e4ff45f5cb45aad9d616ff3e1","b785bde351c6d39e4df37a083004f8fdc8b3e872a140722b3dd2209c4a09cdb3","9be41c0d4d59c7df3fe57897d2c54fe70be39db38324276a1403fedb0987aecd","20413e2e50eb92317d3b027f7db84eea9a3ef0c840525e3e9f193642feb1a8f3","853a36a2a7f55c21e25ebc59c88941c7f37c8c23303414888b2f73fca4038ef6","1fb6e9b410c8d8b452f8088154e51ad284473626717983b222cd331fdf7f257b","90a4d74bbf781180d0493c6ef12114980177035636ad79e4ac278d7f66c89906","6598ceb79f4f95bf0c1a9a160acb205def2d40e544ae6c2bee007ab78e5dba19","705905ccf84bc5f71a363753735a08f8b84a64adaaabc92804abcfd669237ef4","f4c87b4ca15391f68103c1ae975c293a95d96ee5ae7ee823193bf289c9116e1c","b839975d625638b28aedc3d0fc3115b53cae5e4fcb48276b8a80cf3cac7c901e","ea0e7d334ef20a63633db2be66de51433824ecc5dc0546ba5eaffea5902def0c","77532d6ddb95b3459eee566351bbd1cbc9ae91462d531286588b8dd9feb04966","4e27008a9607e45bf77c8dfac662e5bc674c47d3ab82b591e8f8f054bfa8f8c7","76de0ab6b7c1e9995a2d85ea170562cc3e2869af1dc1816fc4383a28b0700687","0d42b50f6215ccff899dc7920dc9e7a541d70fa1689a6194715da8002baf5441","02bf81a93847f187f1250427f899254619208109332daa1bd82756341c285286","bc8c37f24504a27d9b6de96b03e07675b11809225cee7b0f917483f5a1a3a04c","a094cf2c193af2932182316184ce478a1c2290d004e4e64c470823d7a3817214","251af56efaebe1f19e34ad4876db850d4ef1f200e8f8fc6f46b95805def2c4fa","39cae5a09b8a2831c69f023fe312d36fa58455081000d538cff318f365013166"],"paragraph_range_zero_based":[11472,11495],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11472"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sdt-RSRP-Threshold","paragraph_zero_based":11496},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether SDT procedure can be initiated, as specified in TS 38.321 [3].","paragraph_zero_based":11497},{"literal_text_all_w_t_and_m_t":"sdt-DataVolumeThreshold","paragraph_zero_based":11498},{"literal_text_all_w_t_and_m_t":"Data volume threshold used to determine whether SDT can be initiated, as specified in TS 38.321 [3]. Value byte32 corresponds to 32 bytes, value byte100 corresponds to 100 bytes, and so on.","paragraph_zero_based":11499},{"literal_text_all_w_t_and_m_t":"sdt-LogicalChannelSR-DelayTimer","paragraph_zero_based":11500},{"literal_text_all_w_t_and_m_t":"The value of logicalChannelSR-DelayTimer applied during SDT for logical channels configured with SDT, as specified in TS 38.321 [3]. Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on. If this field is not configured, then logicalChannelSR-DelayTimer is not applied for SDT logical channels.","paragraph_zero_based":11501},{"literal_text_all_w_t_and_m_t":"servingCellConfigCommon","paragraph_zero_based":11502},{"literal_text_all_w_t_and_m_t":"Configuration of the serving cell.","paragraph_zero_based":11503},{"literal_text_all_w_t_and_m_t":"t319a","paragraph_zero_based":11504},{"literal_text_all_w_t_and_m_t":"Initial value of the timer T319a used for detection of SDT failure. Value ms100 corresponds to 100 milliseconds, value ms200 corresponds to 200 milliseconds and so on.","paragraph_zero_based":11505},{"literal_text_all_w_t_and_m_t":"uac-AccessCategory1-SelectionAssistanceInfo","paragraph_zero_based":11506},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. If plmnCommon is chosen, the UAC-AccessCategory1-SelectionAssistanceInfo is applicable to all the PLMNs and SNPNs in plmn-IdentityInfoList and npn-IdentityInfoList. If individualPLMNList is chosen, the 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. If uac-AC1-SelectAssistInfo-r16 is present, the UE shall ignore the uac-AccessCategory1-SelectionAssistanceInfo.","paragraph_zero_based":11507},{"literal_text_all_w_t_and_m_t":"uac-AC1-SelectAssistInfo","paragraph_zero_based":11508},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. The 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. Value notConfigured indicates that Access Category1 is not configured for the corresponding PLMN/SNPN.","paragraph_zero_based":11509},{"literal_text_all_w_t_and_m_t":"uac-BarringForCommon","paragraph_zero_based":11510},{"literal_text_all_w_t_and_m_t":"Common access control parameters for each access category. Common values are used for all PLMNs/SNPNs, unless overwritten by the PLMN/SNPN specific configuration provided in uac-BarringPerPLMN-List. The parameters are specified by providing an index to the set of configurations (uac-BarringInfoSetList). UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":11511},{"literal_text_all_w_t_and_m_t":"ue-TimersAndConstants","paragraph_zero_based":11512},{"literal_text_all_w_t_and_m_t":"Timer and constant values to be used by the UE. The cell operating as PCell always provides this field.","paragraph_zero_based":11513},{"literal_text_all_w_t_and_m_t":"useFullResumeID","paragraph_zero_based":11514},{"literal_text_all_w_t_and_m_t":"Indicates which resume identifier and Resume request message should be used. UE uses fullI-RNTI and RRCResumeRequest1 if the field is present, or shortI-RNTI and RRCResumeRequest if the field is absent.","paragraph_zero_based":11515},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11516},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":11517},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":11518},{"literal_text_all_w_t_and_m_t":"EDRX-RC","paragraph_zero_based":11519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8408a063cfb38a42fe7e4ca62b16c42674352432d205fac432080d37469138c2","f92917dc0e39f4c66be3908cc2206dfe7ffbc33747daee6cbfc2d7d079301d47","c117d2aa2c7af4ab51a57dc9a7f2ec9f348ba4582b30b6356f70ceb8f2cc2578","3b246e7510b47d552c0a00fc2dd54d9377fdb6b0a3298cafd3d28a2ba7f1ae04","62ef068fa6961dd97b02eeb6ab49c1ab29794421530a690e7646f9dc10a60cb7","298232ca48ec7dcdfe1fea324ea1efc3f992f975b75a7c9cea04c86f0f04bc8f","b734b909dda8ff5aa87f50b26c6a11c60cffe99a2874c65f9b2d1ffe8b365219","2f301266068c3bf3d08a44dcce10e7d90b2cd0d2d253fc959f5c9857c136797c","a32e3b4d834517a93e3abf215c82c93180a0fa721f3b969a425cb0ddce9bfec3","fd4ff55f7fecdb975a6828b23dbfe6b79ef694fc43a99ca7940749ba616a444d","5afd2cb206fbce6beafce928f7875e6362ccbd57735c47dae24a9b6fd33c9a18","68db81cca9bb9e83c8a3a1ba37170eeab76249ecbc93a4dc63cddde4612e2d37","9d67870d308c3cd280ecd79d44b10ee46b9d382fe4644ced0a33d9eb3d503eab","c747084e41b57f84377519d12ad9c90a857dc73df513897638781f1d8a294d90","101198b4c703ca895733eea1f352c26e262f975bb0ddf2f4c79ee641cf28713d","8b4a92ba9902432872ebf5b99225af1ea5c77fead3500dcc28b77b765b97c805","bd2155d66dacf9841d07aab35582eaaf0233cc8909f815747d15a7b2c124adf4","23f25475863d0ad2d42eb635adf8ef9ece62b1e1cd5a952fcc5bca48a7733576","5e64b6c7abd688689616e1149a88bb255b1898088745b42dcde064b7fc950b71","9cd92f3b6dd98941930b42e1804c3e78fff1b5effcf8ab45b95212bb34b0f1aa","ac74b1efb0effb5ccc6c536ebc4c469048367cc69f5c0b1a5232125ca8673780","99201d907889731b05e546f7495c688799dd3549463421529953c484a022a1dd","a50b406c904e16f93c406cbefdff0f583c12ad484705c011ec636becaa180c8c","b841271939cad5740869d0470d35ddbc2ba1068b7aea3d152c4a2230cdada32d"],"paragraph_range_zero_based":[11496,11519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p11496"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that enables eDRX-AllowedIdle, otherwise it is absent.","paragraph_zero_based":11520},{"literal_text_all_w_t_and_m_t":"MINT","paragraph_zero_based":11521},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that provides a configuration for disaster roaming, otherwise it is absent, Need R.","paragraph_zero_based":11522},{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":11523},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":11524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11525},{"literal_text_all_w_t_and_m_t":"–SidelinkUEInformationNR","paragraph_zero_based":11526},{"literal_text_all_w_t_and_m_t":"The SidelinkUEinformationNR message is used for the indication of NR sidelink UE information to the network.","paragraph_zero_based":11527},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11528},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11529},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11530},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":11531},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR message","paragraph_zero_based":11532},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11533},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-START","paragraph_zero_based":11534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11535},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR-r16::=         SEQUENCE {","paragraph_zero_based":11536},{"literal_text_all_w