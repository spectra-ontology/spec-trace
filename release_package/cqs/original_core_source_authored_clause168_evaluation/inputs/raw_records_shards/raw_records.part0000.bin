{"fields":{"filename":"R2-2311934.zip::R2-2311934_Introduction of NR sidelink U2U relay.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r17               SL-LogicalChannelConfig-r16                       OPTIONAL,   -- Need M","paragraph_zero_based":2568},{"literal_text_all_w_t_and_m_t":"    sl-PacketDelayBudget-r17                      INTEGER (0..1023)                                 OPTIONAL,   -- Need M","paragraph_zero_based":2569},{"literal_text_all_w_t_and_m_t":"    ...}","paragraph_zero_based":2570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2571},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNEL-CONFIG-STOP","paragraph_zero_based":2572},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2574},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig field descriptions","paragraph_zero_based":2575},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":2576},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":2577},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelID","paragraph_zero_based":2578},{"literal_text_all_w_t_and_m_t":"Indicates the PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":2579},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":2580},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":2581},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":2582},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a PC5 Relay RLC channel. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":2583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2584},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelID","paragraph_zero_based":2585},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelID is used to identify a PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE.","paragraph_zero_based":2586},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID information element","paragraph_zero_based":2587},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2588},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CHANNELID-START","paragraph_zero_based":2589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2590},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID-r17 ::=    INTEGER (1..maxSL-LCID-r16)","paragraph_zero_based":2591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ffe6aa9e169eee2e55d5910307b90f1a0088b587d5b1b62ff44829994c9db517","original_member_sha256":"470fa87ca234afd3cdd6813f454487933839ab990f95bcfa5c1735fcd90b61bf","paragraph_ElementTree_utf8_XML_sha256":["8a217f948b01df1fb8c48db4575a42547cd1663b5a917e5b35e37637b714d9bc","877ea0f1db530bc8530ba1ee48a7952e1a77d10fc5ec2f72b5718f36df29dce5","94348784de0037def45db20576bc893407f258ff7058663fce04f8757858eddc","48b52deb6442390e0daa14d061b46b44e9339ffba7597e5fba71c786f6a13a68","0d1429ba81b9efb726622daae7d79e58f640bf0cf1fb06fc4591ef45ecd294f8","0aac68229cddfec29f5b0b0fdc9251c73906ce1fb572439a2d2dcf7521a38e4f","9383cd6683fc3eda1daac568d16f8c8cfd267a1b9117410fb1f2dee3756dd749","e5d005ac08791d81bd4b820937ef2715c4739ed323b8b9cde341ec9e00877c7e","16f757a87c8d8247818a302faaf1bff75866a578fa8a050d0ae05cc783ff3293","47f240ba34e25b3f70a85abcaf3defb47641f7bc5b0aaef265611ed60b087c6c","641878a036bd7d1d9bcb46e2e3620ea93150b43c52db1cdd674f30acbeb11878","e067c64310469cfda1b3099d7f31ab6d786e4b6a6169c3f34c02ced422c143b3","211cf99c79351850aaeefcc45f392d46639c1f561345d8ad9053fc948e