{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if, for the selected frequency band, the UE supports at least one additionalSpectrumEmission in the nr-NS-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":960},{"literal_text_all_w_t_and_m_t":"6>if the UE is aerial UE and it supports at least one additionalSpectrumEmission values in nr-NS-PmaxListAerial within the frequencyBandListAerial:","paragraph_zero_based":961},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxListAerial within frequencyBandListAerial;","paragraph_zero_based":962},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":963},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in NR-NS-PmaxList within frequencyBandList;","paragraph_zero_based":964},{"literal_text_all_w_t_and_m_t":"6>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within NR-NS-PmaxList or nr-NS-PmaxListAerial:","paragraph_zero_based":965},{"literal_text_all_w_t_and_m_t":"7>apply the additionalPmax;","paragraph_zero_based":966},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":967},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":968},{"literal_text_all_w_t_and_m_t":"6>if frequencyBandListSUL is present in SIB4 and, for the frequency band selected in frequencyBandListSUL, the UE supports at least one additionalSpectrumEmission in the NR-NS-PmaxList within FrequencyBandListSUL:","paragraph_zero_based":969},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in NR-NS-PmaxList within frequencyBandListSUL;","paragraph_zero_based":970},{"literal_text_all_w_t_and_m_t":"7>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within NR-NS-PmaxList:","paragraph_zero_based":971},{"literal_text_all_w_t_and_m_t":"8>apply the additionalPmax;","paragraph_zero_based":972},{"literal_text_all_w_t_and_m_t":"7>else:","paragraph_zero_based":973},{"literal_text_all_w_t_and_m_t":"8>apply the p-Max;","paragraph_zero_based":974},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":975},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":976},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":977},{"literal_text_all_w_t_and_m_t":"6>apply the p-Max;","paragraph_zero_based":978},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or RRC_INACTIVE, and T331 is running:","paragraph_zero_based":979},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.1a;","paragraph_zero_based":980},{"literal_text_all_w_t_and_m_t":"5.2.2.4.6Actions upon reception of SIB5","paragraph_zero_based":981},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of this SIB5 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/ or within the corresponding field descriptions.","paragraph_zero_based":982},{"literal_text_all_w_t_and_m_t":"5.2.2.4.7Actions upon reception of SIB6","paragraph_zero_based":983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4c64a3a617a811c4b9c5fbea85be16d4a14a44270a300e4ff2909df4b4aa9071","a06ef099c7d0b020ecd1a26e3f579d14c47f660da65be36acaaaea591aafa387","96591300c0292dbb21168e4cf30e42925f74757e8ec885a00bfd90adf39a00ee","7fffa4233b975ce0d267f77c43688a62f9d9e8a87aa575e5e8d582480fe1db86","c2db6dd01717f9995db922c704d9a0913519422bf4ecbfdc9cdf2dae822d04f6","3d5f2c5c36db1952e5ff0b4cd3164ea2505599d15558d152f8d6511443dde634","7172bcaa62a9424d53f41123a703aa065836a7f57b9c06bfa0b69f5cbfb9824f","04ee65eebeca1fb301b790fa192486a22915710a56c392598e7af88819310c3a","ea72a85a1f7b3af7076a91518ae2e8784b05e55d5bc2aa7bdb1e68d784de7b5e","6d10b1356dbf4ee53037c89391406cfa3e6652a596c9b6d18f6a105b3788a863","ee6a3f183d71fdf0edea1a2114ddc2911775fd5324ba72aedcb4fd2c39fd3e51","5bff4db530c01b50b58bd2b92508b42c31b9f3772a76f51f8291428c19062b32","efa80c20aeec0241f172131c31eb734a6f1ef5aa7f71dc7a4dd617e266761d39","a84ece093880c29dee35cd28d95284d1a42e61ab75b2082c7084344f42eb5fc0","0b2c9639471fa1e9c9fc14aa03ca3a0c705be392c4e527b800c531fc2226725f","0d0354d8cdb9da54ade7ca049bc84d62448a136331639797c104baba81e73d2a","be2cbd849316d5d94ce8f16c0c02b3cd19907047064331d0c0c3ee4984bb7dd9","f2a469a008046b79ff15598a4e6d5023c34d14ce7572524904592178db7f97e6","6f44b6caf13298a8d007f076e268610ac9496131151fdd87b3e779caa22bf575","62e5d4157cabd1f8fbc46236b54e3940635eb4106171144bd7aabc3c3ff0e459","b2324235c6e6519cb3e6b8043b532ac8eb3008d9ec9093fd17c2e9f08410246d","0602f643281903b14c3cd8d353684cead5b149e3ba35cbca6e9bf5e9746536fa","d0726d0eb2d25f86498c1fcc579cfa61f0d74c64277da111e9032a31beeb0886","9830e37fe21ef688bc5a8bbbcb8eae1c2d38a8e2ee520265609329f429cfdcba"],"paragraph_range_zero_based":[960,983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p960"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB6 the UE shall:","paragraph_zero_based":984},{"literal_text_all_w_t_and_m_t":"1>forward the received warningType, messageIdentifier and serialNumber to upper layers;","paragraph_zero_based":985},{"literal_text_all_w_t_and_m_t":"5.2.2.4.8Actions upon reception of SIB7","paragraph_zero_based":986},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB7 the UE shall:","paragraph_zero_based":987},{"literal_text_all_w_t_and_m_t":"1>if there is no current value for messageIdentifier and serialNumber for SIB7; or","paragraph_zero_based":988},{"literal_text_all_w_t_and_m_t":"1>if either the received value of messageIdentifier or of serialNumber, or of both messageIdentifier and serialNumber are different from the current values of messageIdentifier and serialNumber for SIB7:","paragraph_zero_based":989},{"literal_text_all_w_t_and_m_t":"2>use the received values of messageIdentifier and serialNumber for SIB7 as the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":990},{"literal_text_all_w_t_and_m_t":"2>discard any previously buffered warningMessageSegment;","paragraph_zero_based":991},{"literal_text_all_w_t_and_m_t":"2>if all segments of a warning message have been received:","paragraph_zero_based":992},{"literal_text_all_w_t_and_m_t":"3>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":993},{"literal_text_all_w_t_and_m_t":"3>forward the received warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":994},{"literal_text_all_w_t_and_m_t":"3>stop reception of SIB7;","paragraph_zero_based":995},{"literal_text_all_w_t_and_m_t":"3>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":996},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":997},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":998},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB7;","paragraph_zero_based":999},{"literal_text_all_w_t_and_m_t":"1>else if all segments of a warning message have been received:","paragraph_zero_based":1000},{"literal_text_all_w_t_and_m_t":"2>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":1001},{"literal_text_all_w_t_and_m_t":"2>forward the received complete warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1002},{"literal_text_all_w_t_and_m_t":"2>stop reception of SIB7;","paragraph_zero_based":1003},{"literal_text_all_w_t_and_m_t":"2>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1004},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1005},{"literal_text_all_w_t_and_m_t":"2>store the received warningMessageSegment;","paragraph_zero_based":1006},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB7;","paragraph_zero_based":1007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ad77be84e716ff8df6a0b46b2206f703ed1621d20b69a2fcb26583b8db6e2706","215bdf75fb526bab5b08bcfd49c0ff77b6b4926305d1ea9568640dc7547d1549","0a99e2eb8ddcfe372c39bb05e94f21c00e256e6187fc8630bfac0650f7753eb9","4634e701ec81728e575c36439a67c8649578f71b8b845ff0e64820dcc0772da9","1745c560ad69e517eed59628153992de66820e6b029066a9147482f6ab8270ed","fa5b131b8ab5e5257b037b97a7343f623831af90c1f5ab2e9e5335f7da4470ad","259b4522be439ee613b063be34dee8737cfda6abeaa56eb8288a92879eb4259b","736d38a9487781964b690d51a80ff6b731658253de929a61794296a3faa96165","6d100a972a291f5e36edeb430e5d1f66b94a9bfad1a416e9916abff1b0e26cda","76811c5c78666460a3658ce1fa41f6ee65a591b017d4beee0971a39c2c660260","ea16fb767c4e7ef2cf697ea224ec42d5a08c1a954e2b37652935d9da79595639","88940c0f07795481582dbb9372a50cb93a48e0cf713f41b03b61335cc1de0b14","bfa673f2860410646cd89454f61b7cbe7927909924c7f547f6e8ca51568b0da6","e4ffc9751cfa222dcd4b6c88665afc8635856f2f596e38cfcb7616076a828194","5369888560a0de06c1a922ab5ffc92b617a220f39d088304a525c2d7adf75e40","eddf8cfc5ee5dbcb814d5759e6e8ecd7a40de9e60ce5b49be056c49904295710","9cab7a6cf2bd76a300dacf920cc4f2d6c47370f8aac3be57cb7dbdfd0ac7e9fc","34f28f4659ef2f280fe3adea731cbefa53c1e3734b4c62669ee965c7b095892a","de7e43c80c1f7aaae733fdd0b5831ac0e125464c8f0282b86591d0462c05df64","3c7970815988eea2692a80178edc5ee10b756d71527b75945555f4437fb21d3b","08c4583e979f73c3e1196a5b83670b8eb0f0288722c33c17ff493d4bcce947ee","ecc4b26bba4ecb42519ffec970280f5952fecb361833f8f022bc3d084a5887d6","33e038e47179ec2a7cf8a137618f29b863c8079ffbd5ea1c3507dda28e0875e9","51738ab33d3cca3a3997670577e57c29b9ba066d5e25ba0bf0c86e6c72f240f3"],"paragraph_range_zero_based":[984,1007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p984"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE should discard any stored warningMessageSegment and the current value of messageIdentifier and serialNumber for SIB7 if the complete warning message has not been assembled within a period of 3 hours.","paragraph_zero_based":1008},{"literal_text_all_w_t_and_m_t":"5.2.2.4.9Actions upon reception of SIB8","paragraph_zero_based":1009},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB8 the UE shall:","paragraph_zero_based":1010},{"literal_text_all_w_t_and_m_t":"1>if the SIB8 contains a complete warning message and the complete geographical area coordinates (if any):","paragraph_zero_based":1011},{"literal_text_all_w_t_and_m_t":"2>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and the geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1012},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB8;","paragraph_zero_based":1013},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1014},{"literal_text_all_w_t_and_m_t":"2>if the received values of messageIdentifier and serialNumber are the same (each value is the same) as a pair for which a warning message and the geographical area coordinates (if any) are currently being assembled:","paragraph_zero_based":1015},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1016},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1017},{"literal_text_all_w_t_and_m_t":"3>if all segments of a warning message and geographical area coordinates (if any) have been received:","paragraph_zero_based":1018},{"literal_text_all_w_t_and_m_t":"4>assemble the warning message from the received warningMessageSegment;","paragraph_zero_based":1019},{"literal_text_all_w_t_and_m_t":"4>assemble the geographical area coordinates from the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1020},{"literal_text_all_w_t_and_m_t":"4>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1021},{"literal_text_all_w_t_and_m_t":"4>stop assembling a warning message and geographical area coordinates (if any) for this messageIdentifier and serialNumber and delete all stored information held for it;","paragraph_zero_based":1022},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB8;","paragraph_zero_based":1023},{"literal_text_all_w_t_and_m_t":"2>else if the received values of messageIdentifier and/or serialNumber are not the same as any of the pairs for which a warning message is currently being assembled:","paragraph_zero_based":1024},{"literal_text_all_w_t_and_m_t":"3>start assembling a warning message for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1025},{"literal_text_all_w_t_and_m_t":"3>start assembling the geographical area coordinates (if any) for this messageIdentifier and serialNumber pair;","paragraph_zero_based":1026},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1027},{"literal_text_all_w_t_and_m_t":"3>store the received warningAreaCoordinatesSegment (if any);","paragraph_zero_based":1028},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB8;","paragraph_zero_based":1029},{"literal_text_all_w_t_and_m_t":"The UE should discard warningMessageSegment and warningAreaCoordinatesSegment (if any) and the associated values of messageIdentifier and serialNumber for SIB8 if the complete warning message and the geographical area coordinates (if any) have not been assembled within a period of 3 hours.","paragraph_zero_based":1030},{"literal_text_all_w_t_and_m_t":"NOTE:The number of warning messages that a UE can re-assemble simultaneously is a function of UE implementation.","paragraph_zero_based":1031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["13ddd71f327b49fc16bda95953fa9c7ac10bea7b40a7fc2c10eeff79fe2cbc55","d2d881cd3e3910ca69a0480c7769e27001ee05cb998cb3d5ed61c3980c9bede7","771db86381a5774414c99809413897c5be4cc61d610677c9a66bd2649a920df3","0e18ebf1e6a12351d75807fbabe549ed8ccd47f23cb7a0c4863631896f7237c7","3cd113aa903fe27b2df3ddcb83542f267e3da880e1d14c923560da465d3f490a","d53a257c35fa5a9f618d10fe15b95ad8e21de7b9b9b1c4af35ec723f8b7db8aa","2c031e7b0b475ee92e36f2c3158a0f373f80b2be73e0941c034a297a180c9879","08393a8f8fdc4cda7097bd4c5e34bffbed32676520738e0bfdba4fa82f8c4ea8","80d14555ee1d5b812f87e3026854335900f9b4227d3f1ac7dd9d0601d6ed56d4","09809be573c512b99ca5f6e2cff16e383a5ac7b72c95350cecab4c78bdddc1f6","7673fb9ef33e5fb88f90049a8ee2e0f5e6aea8023c2ed9f7915870303eb3e483","3643d155006c82714831b5588d9ede061f82a50165f2e3360e9c066912cc7e72","52691addd0f4881dc15570b837db484a2138726e43cbc4d93c04942ba274f6ed","62c252f7ee36c19edc28afac17f6852a41c4900b873d6c44ff858aa574d3c709","85a0765ef138bda6881e2ec4bbb61276dc8edfe61a961a459a00c967c734f099","af3854658a705aa1760566d29fb7ef7fb8968c5e39d56065b0a87cee55f4449d","2cf07cafc9aae243b1c4d043585a0e41c4e7cfa7c865ae6da3cf775f7e3e1fb1","bdeb195875365d569ffcc564548fd99353bfe0eb0f4da36490c522f29a5dc203","5896a3e1a0e52a41fb46c4a074463abc0746f1ef53026ea8663d24bd36feafcc","572147b3c312ad41d5852ba9dcd3a81d16c8985e92cfb2356a9c9bd7682fc2a9","fb871b8e865b788a9a35b56a37352cae3ea3c32558ef757a321efd3e2a2b8441","7fb5ca21de654270fa808921082658ada8aaf7f8ab53df30bee7acae09147ec2","ef451e8d6c95c8e0541128dd1433cfa35d772acdf31230ddc184307f34f3fc8d","1655863c4d03fd177c50423d31bbf236786cdbb8d5fb9dc305d9cbdbd17478cf"],"paragraph_range_zero_based":[1008,1031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1008"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2.4.10Actions upon reception of SIB9","paragraph_zero_based":1032},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB9 with referenceTimeInfo, the UE may perform the related actions except for the action of ignoring all further referenceTimeInfo received in SIB9 as specified in clause 5.7.1.3.","paragraph_zero_based":1033},{"literal_text_all_w_t_and_m_t":"5.2.2.4.11Actions upon reception of SIB10","paragraph_zero_based":1034},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB10, the UE shall:","paragraph_zero_based":1035},{"literal_text_all_w_t_and_m_t":"1>Forward the HRNN-list entries with the corresponding PNI-NPN and SNPN identities to upper layers;","paragraph_zero_based":1036},{"literal_text_all_w_t_and_m_t":"5.2.2.4.12Actions upon reception of SIB11","paragraph_zero_based":1037},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB11, the UE shall:","paragraph_zero_based":1038},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or RRC_INACTIVE, and T331 is running:","paragraph_zero_based":1039},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.1a;","paragraph_zero_based":1040},{"literal_text_all_w_t_and_m_t":"5.2.2.4.13Actions upon reception of SIB12","paragraph_zero_based":1041},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB12, the UE shall:","paragraph_zero_based":1042},{"literal_text_all_w_t_and_m_t":"1>if the UE has stored at least one segment of SIB12 and the value tag of SIB12 has changed since a previous segment was stored:","paragraph_zero_based":1043},{"literal_text_all_w_t_and_m_t":"2>discard all stored segments;","paragraph_zero_based":1044},{"literal_text_all_w_t_and_m_t":"1>store the segment;","paragraph_zero_based":1045},{"literal_text_all_w_t_and_m_t":"1>if all segments have been received:","paragraph_zero_based":1046},{"literal_text_all_w_t_and_m_t":"2>assemble SIB12-IEs from the received segments;","paragraph_zero_based":1047},{"literal_text_all_w_t_and_m_t":"2>if sl-FreqInfoList is included in sl-ConfigCommonNR:","paragraph_zero_based":1048},{"literal_text_all_w_t_and_m_t":"3>if configured to receive NR sidelink communication:","paragraph_zero_based":1049},{"literal_text_all_w_t_and_m_t":"4>use the resource pool(s) indicated by sl-RxPool for NR sidelink communication reception, as specified in 5.8.7;","paragraph_zero_based":1050},{"literal_text_all_w_t_and_m_t":"3>if configured to transmit NR sidelink communication:","paragraph_zero_based":1051},{"literal_text_all_w_t_and_m_t":"4>use the resource pool(s) indicated by sl-TxPoolSelectedNormal, or sl-TxPoolExceptional for NR sidelink communication transmission, as specified in 5.8.8;","paragraph_zero_based":1052},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on the transmission resource pool(s) indicated by sl-TxPoolSelectedNormal or sl-TxPoolExceptional for NR sidelink communication transmission, as specified in 5.5.3.1;","paragraph_zero_based":1053},{"literal_text_all_w_t_and_m_t":"4>use the synchronization configuration parameters for NR sidelink communication on frequencies included in sl-FreqInfoList, as specified in 5.8.5;","paragraph_zero_based":1054},{"literal_text_all_w_t_and_m_t":"3>if configured to receive NR sidelink discovery:","paragraph_zero_based":1055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e4da634211490dd9510feefd1f7689c5765b2ad3e6a2c29db748347226a84d3b","eb317768c461c6a8db3dbb21c2324e50f04e3ab4b5cb992c6cf0b03f7ff9e384","aaf8bfa88455bb32e4bef6767ee3719aa03f25b0fa60e1007e4892b7318fe661","aff9bb057106ba992b585066e8bd0733f2a7c49e80b2666cc8dd33c86f110d90","ea36b61f7e85880b0a3bcfaa8811696a4a8f41134409ea5dcba7295db3d77f47","e75b73af20244a13c50369e14dcad196fa509f3a7bdcb2c5b24473b2b3efa47b","c7f3918b2b1555758ac9219f2f402bf9d204582c96b617597ffad5ebddd68713","aed28b3288160f5254ec131f994416b383b12649ef6c269d10119fbb92da6d63","f95c0dbed9aa3692f2b16fc622545113c02e6a7dfb6dcdb643c65633f8409e3c","14ec7168667c0e14376e945fdedc97f2f7a4475ae79d8ef940cb284933be2078","d69fd3592f78bd5016c93224a85916e278aec764cafb0b80d5e5f87020ffcb41","1dc8fca412e300fb72d91db5d556e8fbcb8f199c6bb16853af7fb48b80b3d913","8b618affbca7b0143ac5f25c5381c72cbadfdcff642ca940281cd688a7124446","cdf55303779b8cba7bae657a7b19157973ba601b4a172f288b6a4b56def22196","4b87d3195b4269e0bf704ca74fb31cbf733191aa029b29667025f5bb6ceffe41","d0f85ecf9878bd280b88b1b2da44a53e38eb1add0125142ab5e23181e5bcb88a","d4b2bfb39ab8baf47ab217b50eec095a3751e0507caa503d692f14eb3a516762","138852f56120b6228b3a88e26556b24d00c354f8c28f8ea58b348d5cc47daddb","c980e7a4704e44a26b0ee97fc84d65f232b248dd0d9aa3cd13b8a533eba2293d","2b46508d9147b9c69ccda522e647cd7f55f348da703f29b0bc0378da293ed190","4f40fdf82261096f72ccbdf573b9e0196fe898c452ad506e848741a2f835fbdb","4ef5e544b46fb33697ceb032b89a4db86d80114d3243eccf4efc51571e33295d","f8939739d62005470e9c17b44093b02ba6bd18a898f3750644a9e893a6e00eea","bdc3173b8085dea1d7a50bf145ca940c4d80873c9678f1c77989b8baaa741ece"],"paragraph_range_zero_based":[1032,1055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1032"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>use the resource pool(s) indicated by sl-DiscRxPool or sl-RxPool for NR sidelink discovery reception, as specified in 5.8.13.2;","paragraph_zero_based":1056},{"literal_text_all_w_t_and_m_t":"3>if configured to transmit NR sidelink discovery:","paragraph_zero_based":1057},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":1058},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":1059},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":1060},{"literal_text_all_w_t_and_m_t":"5>use the resource pool(s) indicated by sl-DiscTxPoolSelected, sl-TxPoolExceptional or sl-TxPoolSelectedNormal for NR sidelink discovery transmission, as specified in 5.8.13.3;","paragraph_zero_based":1061},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on the transmission resource pool(s) indicated by sl-TxPoolSelectedNormal, sl-DiscTxPoolSelected or sl-TxPoolExceptional for NR sidelink discovery transmission, as specified in 5.5.3.1;","paragraph_zero_based":1062},{"literal_text_all_w_t_and_m_t":"5>use the synchronization configuration parameters for NR sidelink discovery on frequencies included in sl-FreqInfoList, as specified in 5.8.5;","paragraph_zero_based":1063},{"literal_text_all_w_t_and_m_t":"2>if sl-RadioBearerConfigList or sl-RLC-BearerConfigList is included in sl-ConfigCommonNR:","paragraph_zero_based":1064},{"literal_text_all_w_t_and_m_t":"3>perform sidelink DRB addition/modification/release as specified in 5.8.9.1a.1/5.8.9.1a.2;","paragraph_zero_based":1065},{"literal_text_all_w_t_and_m_t":"2> if sl-MeasConfigCommon is included in sl-ConfigCommonNR:","paragraph_zero_based":1066},{"literal_text_all_w_t_and_m_t":"3> store the NR sidelink measurement configuration;","paragraph_zero_based":1067},{"literal_text_all_w_t_and_m_t":"2>if sl-DRX-ConfigCommonGC-BC is included in SIB12-IEs:","paragraph_zero_based":1068},{"literal_text_all_w_t_and_m_t":"3>store the NR sidelink DRX configuration and configure lower layers to perform sidelink DRX operation for groupcast and broadcast as specified in TS 38.321 [3];","paragraph_zero_based":1069},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":1070},{"literal_text_all_w_t_and_m_t":"2>if the sl-TimersAndConstantsRemoteUE is included in SIB12:","paragraph_zero_based":1071},{"literal_text_all_w_t_and_m_t":"3>use values for timers T300, T301 and T319 as included in the sl-TimersAndConstantsRemoteUE received in SIB12;","paragraph_zero_based":1072},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1073},{"literal_text_all_w_t_and_m_t":"3>use values for timers T300, T301 and T319 as included in the ue-TimersAndConstants received in SIB1;","paragraph_zero_based":1074},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored segments for SIB12 if the complete SIB12 has not been assembled within a period of 3 hours. The UE shall discard any stored segments for SIB12 upon cell (re-)selection.","paragraph_zero_based":1075},{"literal_text_all_w_t_and_m_t":"5.2.2.4.14Actions upon reception of SIB13","paragraph_zero_based":1076},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB13, the UE shall perform the actions upon reception of SystemInformationBlockType21 as specified in 5.2.2.28 in TS 36.331 [10].","paragraph_zero_based":1077},{"literal_text_all_w_t_and_m_t":"5.2.2.4.15Actions upon reception of SIB14","paragraph_zero_based":1078},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB14, the UE shall perform the actions upon reception of SystemInformationBlockType26 as specified in 5.2.2.33 in TS 36.331 [10].","paragraph_zero_based":1079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["02c906e87c4858a7969c61235b816e00f339cbb983690b65844e502ac77d1ea2","7857a9660d6b8623a780f893714260a0d0833c87a00d66536886d6b4a0c394aa","06c193df98f4a6c1bdde17c76857a682fe33bffe08918204c5172b906a4df2be","c21a5f73116789303cca7f50329a3af15a5b5002b2e6d340f3f8dc337d1aae90","0b144bb1a9a4109726aabc7fcbd579f76306e40991287b09279c0baf27f9ea11","3c2e8f411be39b9ad23d4569c5c1d1b32ac031b524af19f0428d3afb683803c1","6a74abcc69952a8f62e348b87af2c8d78e361eeb701ea1d537c5631beacc5a9b","65994e1eeecf539d832d9c59fb61ba3f885c0682f55c2a3ddd04159131d606c2","2ea6030c9284c85355b0e0c57cef9199d216c2bc99bb77876d0ef0f2ed361e10","17015b02dfe04f27e8427cb0852192518b7fbc1b38e22aa581a7080722afa31f","4326fde29b6249f80838bd1fcec3b9f46e1e76e23be2fa631e119012b63912f2","1fa2df90d43d7c796fbdd2435e8351442c09894b75fc26ddd5f765a8a32b4597","a573a6883dcb2d5aba6cacbb0b8e3ef4408625debe17ef3fb8a7c21607bf3485","2ab4a68f2198c993be3384b5bfe0ad1dc836e27ca7dd0597e3219fee0eafd4e1","b555573d4be3a789d3c555058600f702ead185e625fc33dd997f1d208d3f92f2","25e52dcd6940994666b8202aba03232b61b8d946bf043ea01a47025953b6069e","4b4422ce13220829c8f626ca3a4a6e7414b6d835ea96064655e3a85cf5f67303","49ce860bb009475f80e78779d57983cf2c2b71dcf563625b1a6941ea673820a7","b47eca5ce652762fa679451f775cf2c53ed13ec31404ebb438f5a89a2fca8b7d","783b6d3a49039cedbd324ed0193b81affff0d5fbe5a9175b791ce55669e80aa5","adabab31e1550bdf7ede858256b6b50cd78a3dd0e343060752e5ea1036b52df1","af48e79691bdecea9e9bcfe728a1f2c5de5ef82c8a128606dfec98677ca0f5e6","a3f1592caa1e32e1ffc75e44e90f075d0082e9d3a27c731b6f7600e9813921de","46d1fe4ebe9abd7dd1f9094b5457a2b74dc5beffdfda1ccfca2c0ede308a3751"],"paragraph_range_zero_based":[1056,1079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1056"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2.4.16Actions upon reception of SIBpos","paragraph_zero_based":1080},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of the SIBpos apply other than those specified elsewhere e.g. within TS 37.355 [49], and/or within the corresponding field descriptions.","paragraph_zero_based":1081},{"literal_text_all_w_t_and_m_t":"5.2.2.4.17Actions upon reception of SIB15","paragraph_zero_based":1082},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB15, the UE shall:","paragraph_zero_based":1083},{"literal_text_all_w_t_and_m_t":"1>forward the applicable disaster roaming information for each PLMN sharing the cell to upper layers.","paragraph_zero_based":1084},{"literal_text_all_w_t_and_m_t":"5.2.2.4.18Actions upon reception of SIB16","paragraph_zero_based":1085},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB16 with cell reselection priorities for slicing, the UE shall perform the actions as specified in TS 38.304 [20].","paragraph_zero_based":1086},{"literal_text_all_w_t_and_m_t":"5.2.2.4.19Actions upon reception of SIB17","paragraph_zero_based":1087},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB17, the UE shall:","paragraph_zero_based":1088},{"literal_text_all_w_t_and_m_t":"1>if the UE has stored at least one segment of SIB17 and the value tag of SIB17 has changed since a previous segment was stored:","paragraph_zero_based":1089},{"literal_text_all_w_t_and_m_t":"2>discard all stored segments;","paragraph_zero_based":1090},{"literal_text_all_w_t_and_m_t":"1>store the segment;","paragraph_zero_based":1091},{"literal_text_all_w_t_and_m_t":"1>if all segments have been received:","paragraph_zero_based":1092},{"literal_text_all_w_t_and_m_t":"2>assemble SIB17-IEs from the received segments.","paragraph_zero_based":1093},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored segments for SIB17 if the complete SIB17 has not been assembled within a period of 3 hours. The UE shall discard any stored segments for SIB17 upon cell (re-) selection.","paragraph_zero_based":1094},{"literal_text_all_w_t_and_m_t":"5.2.2.4.20Actions upon reception of SIB18","paragraph_zero_based":1095},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB18, the UE shall:","paragraph_zero_based":1096},{"literal_text_all_w_t_and_m_t":"1>forward the Group IDs for Network selection (GINs) in SIB18 with the corresponding SNPN identities to upper layers;","paragraph_zero_based":1097},{"literal_text_all_w_t_and_m_t":"5.2.2.4.21Actions upon reception of SIB19","paragraph_zero_based":1098},{"literal_text_all_w_t_and_m_t":"Upon receiving SIB19, the UE in RRC_CONNECTED shall:","paragraph_zero_based":1099},{"literal_text_all_w_t_and_m_t":"1>start or restart T430 for serving cell with the timer value set to ntn-UlSyncValidityDuration for the serving cell from the subframe indicated by epochTime for the serving cell;","paragraph_zero_based":1100},{"literal_text_all_w_t_and_m_t":"NOTE:UE should attempt to re-acquire SIB19 before the end of the duration indicated by ntn-UlSyncValidityDuration and epochTime by UE implementation.","paragraph_zero_based":1101},{"literal_text_all_w_t_and_m_t":"5.2.2.4.22Actions upon reception of SIB20","paragraph_zero_based":1102},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of SIB20 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/or within the corresponding field descriptions.","paragraph_zero_based":1103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d09fe321f49dd02f4877df63bda8f3522831c98586acf617bd09780845e7458c","2139b7ace32882457f26726a1ca9d48b4b5c709cd5b35dd956e5ef21d9ab98bb","cf6de71b4bb934160be2ac0ad0f8124169e9f338da40c958ce66bd7c407789fc","ae2d6f6815d4a605587e92eadcb2c430651d6005f67a42a296d2f12e151e076f","37e8c92cba18f80f36739bea14f69ba7833989d14f17061c610c4a3637ccfa89","94e03d45dfcdfa659e5dddde12f87756320d4a759a67f4d74ad97afd56993d29","00400a098743ac944d78494f2889762a0474b8e7dd15f895ccb0bf5d3587f514","d391274ff6bf5c28cd3c943948259bf73fd6ad53fcf35d6e75fedecf50c5b242","c159e1d7d785f2bf9e42b547fdd38281d15b7f98a004a7f432b1d71ed18098c0","66b02a0293846adf4ff7981c0cade08a17900124278b56051812ac9e3c1c7920","8a531f6adb8c663c42c5072288fe8a0eb99e3f2332111ab695f4e7ae857d63a2","136516b1648840b69ba6a6b7fa3513edd9f6a5c6998332210920fa1fe0d3ffe2","c0ac47527cb2fafada6d8dbe08f1d02610d462cbf43b6ab35a2eae82e8a56408","cb5336ff4b084f3548a855984db9b214ad0a464b224384eee0899dc0ede6f260","0dc6c030be09ab1b88812c9127285323dd18f4d7c9ab1ed383d38f45e10906e1","b2d3612e16940457af80fb8754927b817c1297a38b6d2d6caf4b666c15998290","fe5282b7722718ef3c98117d38153ebe3a1b78d66cf3dc543770c47f445bfd12","a02a66d0d6af4f532e89ce9cfaea3ad318f294dc27dfbba60f0447f6bc8e777e","1c7b265e6012c38a677f9cc589f10f8e29424e0695c31a3d1b325328ae0e11e7","bcbf77fbd3f489117c612829502b9f9c7f49d06e96a299ba02d787a04f2e8958","40ac844139f4f720b2bd540bb39ce8fa633fee8e704e41e2795ca7c474eac921","6b597bff40c6af8f36897157b1dfa82e4ce56e0458ede4bdd631e66399f94da2","212099e6721f0b663ea1960b56092280ea0794acc7b515c6598f8144b57ad2ae","ec8662359ec5b8e60f71a14475b4a74768254875cca3f97bb49b97a7cba29661"],"paragraph_range_zero_based":[1080,1103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1080"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.2.2.4.23Actions upon reception of SIB21","paragraph_zero_based":1104},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of SIB21 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/or within the corresponding field descriptions.","paragraph_zero_based":1105},{"literal_text_all_w_t_and_m_t":"5.2.2.5Essential system information missing","paragraph_zero_based":1106},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1107},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or in RRC_INACTIVE or in RRC_CONNECTED while T311 is running:","paragraph_zero_based":1108},{"literal_text_all_w_t_and_m_t":"2>if the UE is unable to acquire the MIB:","paragraph_zero_based":1109},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":1110},{"literal_text_all_w_t_and_m_t":"3>perform barring as if intraFreqReselection, or intraFreqReselectionRedCap for RedCap UEs, is set to allowed;","paragraph_zero_based":1111},{"literal_text_all_w_t_and_m_t":"2>else if the UE is unable to acquire the SIB1:","paragraph_zero_based":1112},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":1113},{"literal_text_all_w_t_and_m_t":"3>if the UE is a RedCap UE:","paragraph_zero_based":1114},{"literal_text_all_w_t_and_m_t":"4>perform barring as if intraFreqReselectionRedCap is set to allowed;","paragraph_zero_based":1115},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1116},{"literal_text_all_w_t_and_m_t":"4>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20].","paragraph_zero_based":1117},{"literal_text_all_w_t_and_m_t":"NOTE:The SIB19 is essential for NTN access. If UE is unable to acquire the SIB19 for NTN access, the action is up to UE implementation (e.g., cell re-selection to other cells).","paragraph_zero_based":1118},{"literal_text_all_w_t_and_m_t":"5.2.2.6T430 expiry","paragraph_zero_based":1119},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1120},{"literal_text_all_w_t_and_m_t":"1>if T430 for serving cell expires and if in RRC_CONNECTED:","paragraph_zero_based":1121},{"literal_text_all_w_t_and_m_t":"2>inform lower layers that UL synchronisation is lost;","paragraph_zero_based":1122},{"literal_text_all_w_t_and_m_t":"2>acquire SIB19 as defined in clause 5.2.2.3.2;","paragraph_zero_based":1123},{"literal_text_all_w_t_and_m_t":"2>upon successful acquisition of SIB19:","paragraph_zero_based":1124},{"literal_text_all_w_t_and_m_t":"3>inform lower layers when UL synchronisation is obtained;","paragraph_zero_based":1125},{"literal_text_all_w_t_and_m_t":"NOTE:The exact time when UL synchronisation is obtained (after SIB19 is acquired) is left to UE implementation, which can be from the subframe indicated by epochTime and optionally before the subframe indicated by epochTime.","paragraph_zero_based":1126},{"literal_text_all_w_t_and_m_t":"5.3Connection control","paragraph_zero_based":1127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["e508b61b36529fa1b5da8fed7972d07717eac125f1b5221f859bc2387f5a9b2f","af5b576c6bcfbc7ea6fb5e18b8ea18e4b1f11453ab88a8156e85c45b286e4d74","69467d5b82fad2542cce380242362b82f42cf241c398c5b962b0d82505ad8a07","cc8b5d6fa08745a46d4ec5161b6889cdc49bed10181c3b70747e3908034566cc","df7b0e0717e275025ce4172854464423557a8738c58b08617d1602811b14e756","3a00fc210ee95cf8b228fc0d416e18f89d441fa707216b822df7ee24e7233aa4","57834a74e408fcd540b9165f0eaeef3ec0745c305efd9444045e4e8761c78a57","1fe1fa11e2b09fb52ad577434dd3924d9fb5fb5bb2075711ecd2b1fa887fee13","ef03d73cf280e065cfb0926a7607847cb1674a87a3415c1ea483965dbfba09b7","f9531b3f4ad1146630ee8034b10d5f1d1d390070b7419a3dcf36ef4b412a76cf","be2b3c643f4d8e2d78479c3f1fba802d86b6187a1e6a659ce572413da3c1f854","7b8cb89ece898f555c6b5c79d0d3f3eb1ccf014ef3b952267214979824caaf07","cf3f5120b77659f5c18662201652e2e19028568967e3b0c1eecaf4d5b47beab2","83aed26cc6d4544550237b045e35ee5b3fa531a4d9dfdcae1e433dbfa410ef49","cbc31159e0f52a83bfe6d323a1ea6e0136e97869543a7a6a7477f1dd57b6dda8","7131d6463e3f10d960823286262e29f413ffd429aeb3b7e54b2d961e63d255ba","82d5a1c37666c90feb0f897d644abca3fc31d261cb30ade78fae92557470905f","90d8b8880deb14a46e5013c7de1569706168b2951340d7f46023698a99f86e14","c01e3a2f1795b0dd669cc11fbf43b8a91e9015282b4ff1dd36f30ee9b8db414b","212b8f8e1c0aedf351ee554944bf73027a98ade9e2745f446584b4a27c03c881","1a52ad0af00f442029f2b19a4860629ac554f44498531bc9903945da9333c603","c6bb14bff07107b6239da75eade27b0df2ee88db8e878c0b4af58e4ceae9d453","0e8f72a4f9715dc0ad35bbd65ce3738b338a3237ff2d59ec40a530eb2ae144f2","f08a2794ccd8ac5fe3105e2466b61c6ef999cd8ab6e51d6a57cceab7a17c58d5"],"paragraph_range_zero_based":[1104,1127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1104"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.1Introduction","paragraph_zero_based":1128},{"literal_text_all_w_t_and_m_t":"5.3.1.1RRC connection control","paragraph_zero_based":1129},{"literal_text_all_w_t_and_m_t":"RRC connection establishment involves the establishment of SRB1. The network completes RRC connection establishment prior to completing the establishment of the NG connection, i.e. prior to receiving the UE context information from the 5GC. Consequently, AS security is not activated during the initial phase of the RRC connection. During this initial phase of the RRC connection, the network may configure the UE to perform measurement reporting, but the UE only sends the corresponding measurement reports after successful AS security activation. However, the UE only accepts a re-configuration with sync message when AS security has been activated.","paragraph_zero_based":1130},{"literal_text_all_w_t_and_m_t":"Upon receiving the UE context from the 5GC, the RAN activates AS security (both ciphering and integrity protection) using the initial AS security activation procedure. The RRC messages to activate AS security (command and successful response) are integrity protected, while ciphering is started only after completion of the procedure. That is, the response to the message used to activate AS security is not ciphered, while the subsequent messages (e.g. used to establish SRB2, DRBs and multicast MRBs) are both integrity protected and ciphered. After having initiated the initial AS security activation procedure, the network may initiate the establishment of SRB2 and DRBs and/or multicast MRBs, i.e. the network may do this prior to receiving the confirmation of the initial AS security activation from the UE. In any case, the network will apply both ciphering and integrity protection for the RRC reconfiguration messages used to establish SRB2, DRBs and/or multicast MRBs. The network should release the RRC connection if the initial AS security activation and/ or the radio bearer establishment fails. A configuration with SRB2 without DRB or multicast MRB, or with DRB or multicast MRB without SRB2 is not supported (i.e., SRB2 and at least one DRB or multicast MRB must be configured in the same RRC Reconfiguration message, and it is not allowed to release all the DRBs and multicast MRBs without releasing the RRC Connection). For IAB-MT, a configuration with SRB2 without any DRB/MRB is supported.","paragraph_zero_based":1131},{"literal_text_all_w_t_and_m_t":"The release of the RRC connection normally is initiated by the network. The procedure may be used to re-direct the UE to an NR frequency or an E-UTRA carrier frequency.","paragraph_zero_based":1132},{"literal_text_all_w_t_and_m_t":"The suspension of the RRC connection is initiated by the network. When the RRC connection is suspended, the UE stores the UE Inactive AS context and any configuration received from the network, and transits to RRC_INACTIVE state. The RRC message to suspend the RRC connection is integrity protected and ciphered.","paragraph_zero_based":1133},{"literal_text_all_w_t_and_m_t":"The resumption of a suspended RRC connection is initiated by upper layers when the UE needs to transit from RRC_INACTIVE state to RRC_CONNECTED state or by RRC layer to perform a RNA update or by RAN paging from NG-RAN or for SDT. When the RRC connection is resumed, network configures the UE according to the RRC connection resume procedure based on the stored UE Inactive AS context and any RRC configuration received from the network. The RRC connection resume procedure re-activates AS security and re-establishes SRB(s) and DRB(s) and/or multicast MRB(s), if configured.","paragraph_zero_based":1134},{"literal_text_all_w_t_and_m_t":"Upon initiating the resume procedure for SDT, AS security (both ciphering and integrity protection) is re-activated for SRB2 (if configured for SDT) and for SRB1. In addition, AS security is also re-activated (if security is configured) for all the DRBs configured for SDT. Further, the PDCP entities of SRB1 and PDCP entities of the radio bearers configured for SDT are re-established and resumed whilst the UE remains in RRC_INACTIVE state. Transmission and reception of data and/or signalling messages over radio bearers configured for SDT can happen whilst the UE is in RRC_INACTIVE state and SDT procedure is ongoing.","paragraph_zero_based":1135},{"literal_text_all_w_t_and_m_t":"In response to a request to resume the RRC connection or in response to a resume procedure initiated for SDT, the network may resume the suspended RRC connection and send UE to RRC_CONNECTED, or reject the request to resume and send UE to RRC_INACTIVE (with a wait timer), or directly re-suspend the RRC connection and send UE to RRC_INACTIVE, or directly release the RRC connection and send UE to RRC_IDLE, or instruct the UE to initiate NAS level recovery (in this case the network sends an RRC setup message).","paragraph_zero_based":1136},{"literal_text_all_w_t_and_m_t":"NOTE:In case the UE receives the configurations for NR sidelink communication via the E-UTRA, the configurations for NR sidelink communication in SIB12 and sl-ConfigDedicatedNR within RRCReconfiguration used in clause 5.3 are provided by the configurations in SystemInformationBlockType28 and sl-ConfigDedicatedForNR within RRCConnectionReconfiguration as specified in TS 36.331[10], respectively.","paragraph_zero_based":1137},{"literal_text_all_w_t_and_m_t":"5.3.1.2AS Security","paragraph_zero_based":1138},{"literal_text_all_w_t_and_m_t":"AS security comprises of the integrity protection and ciphering of RRC signalling (SRBs) and user data (DRBs).","paragraph_zero_based":1139},{"literal_text_all_w_t_and_m_t":"RRC handles the configuration of the AS security parameters which are part of the AS configuration: the integrity protection algorithm, the ciphering algorithm, if integrity protection and/or ciphering is enabled for a DRB and two parameters, namely the keySetChangeIndicator and the nextHopChainingCount, which are used by the UE to determine the AS security keys upon reconfiguration with sync (with key change), connection re-establishment and/or connection resume.","paragraph_zero_based":1140},{"literal_text_all_w_t_and_m_t":"The integrity protection algorithm is common for SRB1, SRB2, SRB3 (if configured), SRB4 (if configured) and DRBs configured with integrity protection, with the same keyToUse value. The ciphering algorithm is common for SRB1, SRB2, SRB3 (if configured), SRB4 (if configured) and DRBs configured with the same keyToUse value. Neither integrity protection nor ciphering applies for SRB0.","paragraph_zero_based":1141},{"literal_text_all_w_t_and_m_t":"NOTE 0:All DRBs related to the same PDU session have the same enable/disable setting for ciphering and the same enable/disable setting for integrity protection, as specified in TS 33.501 [11].","paragraph_zero_based":1142},{"literal_text_all_w_t_and_m_t":"RRC integrity protection and ciphering are always activated together, i.e. in one message/procedure. RRC integrity protection and ciphering for SRBs are never de-activated. However, it is possible to switch to a 'NULL' ciphering algorithm (nea0).","paragraph_zero_based":1143},{"literal_text_all_w_t_and_m_t":"The 'NULL' integrity protection algorithm (nia0) is used only for SRBs and for the UE in limited service mode, see TS 33.501 [11] and when used for SRBs, integrity protection is disabled for DRBs. In case the ′NULL' integrity protection algorithm is used, 'NULL' ciphering algorithm is also used.","paragraph_zero_based":1144},{"literal_text_all_w_t_and_m_t":"NOTE 1:Lower layers discard RRC messages for which the integrity protection check has failed and indicate the integrity protection verification check failure to RRC.","paragraph_zero_based":1145},{"literal_text_all_w_t_and_m_t":"The AS applies four different security keys: one for the integrity protection of RRC signalling (KRRCint), one for the ciphering of RRC signalling (KRRCenc), one for integrity protection of user data (KUPint) and one for the ciphering of user data (KUPenc). All four AS keys are derived from the KgNB key. The KgNB key is based on the KAMF key (as specified in TS 33.501 [11]), which is handled by upper layers.","paragraph_zero_based":1146},{"literal_text_all_w_t_and_m_t":"The integrity protection and ciphering algorithms can only be changed with reconfiguration with sync. The AS keys (KgNB, KRRCint, KRRCenc, KUPint and KUPenc) change upon reconfiguration with sync (if masterKeyUpdate is included), and upon connection re-establishment and connection resume.","paragraph_zero_based":1147},{"literal_text_all_w_t_and_m_t":"For each radio bearer an independent counter (COUNT, as specified in TS 38.323 [5]) is maintained for each direction. For each radio bearer, the COUNT is used as input for ciphering and integrity protection.","paragraph_zero_based":1148},{"literal_text_all_w_t_and_m_t":"It is not allowed to use the same COUNT value more than once for a given security key. As specified in TS 33.501 clause 6.9.4.1 [11], the network is responsible for avoiding reuse of the COUNT with the same RB identity and with the same key, e.g. due to the transfer of large volumes of data, release and establishment of new RBs, and multiple termination point changes for RLC-UM bearers and multiple termination point changes for RLC-AM bearer with SN terminated PDCP re-establishment (COUNT reset) due to SN only full configuration whilst the key stream inputs (i.e. bearer ID, security key) at MN have not been updated. In order to avoid such re-use, the network may e.g. use different RB identities for RB establishments, change the AS security key, or an RRC_CONNECTED to RRC_IDLE/RRC_INACTIVE and then to RRC_CONNECTED transition.","paragraph_zero_based":1149},{"literal_text_all_w_t_and_m_t":"In order to limit the signalling overhead, individual messages/ packets include a short sequence number (PDCP SN, as specified in TS 38.323 [5]). In addition, an overflow counter mechanism is used: the hyper frame number (HFN, as specified in TS 38.323 [5]). The HFN needs to be synchronized between the UE and the network.","paragraph_zero_based":1150},{"literal_text_all_w_t_and_m_t":"For each SRB, the value provided by RRC to lower layers to derive the 5-bit BEARER parameter used as input for ciphering and for integrity protection is the value of the corresponding srb-Identity with the MSBs padded with zeroes.","paragraph_zero_based":1151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["98f1776e4ce3008aa68da97d7d1014fe1d1eab122c796a4b8217c5e1aa9654b0","6b31ce5dde3e43b07645547522a413ee7263375a972d45e99af114d59e20cd77","c18ac8a0572eecb4219bb79c5acd57d7b2f8b9e86595a50d22da4ed04a9814f1","d14689aff04e4af7e828a3e16b2434d7489e91feaa37a2ac43256d4c385dd2df","6acc0f2f7109152f232469d5da1a3f2d13ddd6c86d8f620da31b076a3e282bb7","65e7ada55d43e76f7e2e97853302669b58a0ba4e4566c12e28372931ab33f7a5","4bd5313f5607ccfed9f5d73fea2a758046cad3b8cf0e5c6a336393648ec53031","fe54993f912648e972cde6c3069da235b507dba732c7e2aeb3f70e351834fa2a","a4b24c34e260e738947d24872638b4fb844963cb01f00474932f590bb6642c11","9f20b252ab06e3eebe14a1183f1ad1e53e25845291ab66dc0088862a73338f60","ffbb761160eed092c0c247506f3951c8efd2cee7ad9b650e014f805a61ba43bf","26ee438fb4bfafe7f97b70c35f1cc161c942656fda153c002cbfc7f56206f577","5d99ba81e68c0c96f7cb914d3372f8caa7f8ef14f67a9e2ce84b846eec857089","0f08c495d61770be7e027356433d625353e9918a0d8e6c1b00dabfc9cdaa6579","479db2568e4a9ce28bcbdc03f33418170c7feb27f8f729f580a4b5e16995a7bf","f0a11fdfa978672b66553bce0f47a5c05430c28f574b6e0f753c8e84df0a3d87","0b4b7e0bd4301128ea735979de77f1ecf1476096b098a125460fc6a4ec16e22e","7bd328708dfde1313439239bc6a2863dc95f3f6d0f679a3440a177c5e5da8b22","ffaa3e193514c9de57148ed40997cbf9acce4d4a040ecc663f7e5b44e42c4022","0176e1173fd248573227918b5d5d20e7324e53c80c55578ae295a3399cc7c0e5","ac1ea334ea2bcdf66a7449369fb1ec4faf4ee9624d1190d291c45fa39a63d5f0","bf8cf19f6f6abebb9072ca25a5fb690812447df2746f000947a7eee3c775a92d","2cbfea19490ca549535e04002a9a53b2343d51cc70af1d9135f627022d2264b6","12efe113a49399f94baefde20ec9f0c3cba3b6d0d9c5fb22c62c14cacc8c18a5"],"paragraph_range_zero_based":[1128,1151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1128"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For a UE provided with an sk-counter, keyToUse indicates whether the UE uses the master key (KgNB) or the secondary key (S-KeNB or S-KgNB) for a particular DRB. The secondary key is derived from the master key and sk-Counter, as defined in TS 33.501[11]. Whenever there is a need to refresh the secondary key, e.g. upon change of MN with KgNB change or to avoid COUNT reuse, the security key update is used (see 5.3.5.7). When the UE is in NR-DC, the network may provide a UE configured with an SCG with an sk-Counter even when no DRB is setup using the secondary key (S-KgNB) in order to allow the configuration of SRB3. The network can also provide the UE with an sk-Counter, even if no SCG is configured, when using SN terminated MCG bearers.","paragraph_zero_based":1152},{"literal_text_all_w_t_and_m_t":"5.3.2Paging","paragraph_zero_based":1153},{"literal_text_all_w_t_and_m_t":"5.3.2.1General","paragraph_zero_based":1154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1155},{"literal_text_all_w_t_and_m_t":"Figure 5.3.2.1-1: Paging","paragraph_zero_based":1156},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is:","paragraph_zero_based":1157},{"literal_text_all_w_t_and_m_t":"-to transmit paging information to a UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":1158},{"literal_text_all_w_t_and_m_t":"-to transmit paging information for a L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE to its serving L2 U2N Relay UE in any RRC state.","paragraph_zero_based":1159},{"literal_text_all_w_t_and_m_t":"5.3.2.2Initiation","paragraph_zero_based":1160},{"literal_text_all_w_t_and_m_t":"The network initiates the paging procedure by transmitting the Paging message at the UE's paging occasion as specified in TS 38.304 [20]. The network may address multiple UEs within a Paging message by including one PagingRecord for each UE. The network may also include one or multiple TMGI(s) in the Paging message to page UEs for specific MBS multicast session(s).","paragraph_zero_based":1161},{"literal_text_all_w_t_and_m_t":"5.3.2.3Reception of the Paging message by the UE or PagingRecord by the L2 U2N Remote UE","paragraph_zero_based":1162},{"literal_text_all_w_t_and_m_t":"Upon receiving the Paging message by the UE or receiving PagingRecord from its connected L2 U2N Relay UE by a L2 U2N Remote UE, the UE shall:","paragraph_zero_based":1163},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for each of the PagingRecord, if any, included in the Paging message, or","paragraph_zero_based":1164},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for the PagingRecord, if any, included in the UuMessageTransferSidelink message received from the connected L2 U2N Relay UE:","paragraph_zero_based":1165},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1166},{"literal_text_all_w_t_and_m_t":"3>if upper layers indicate the support of paging cause:","paragraph_zero_based":1167},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity, accessType (if present) and paging cause (if determined) to the upper layers;","paragraph_zero_based":1168},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1169},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity and accessType (if present) to the upper layers;","paragraph_zero_based":1170},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE, for each of the PagingRecord, if any, included in the Paging message, or","paragraph_zero_based":1171},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE, for the PagingRecord, if any, included in the UuMessageTransferSidelink message received from the connected L2 U2N Relay UE:","paragraph_zero_based":1172},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord matches the UE's stored fullI-RNTI:","paragraph_zero_based":1173},{"literal_text_all_w_t_and_m_t":"3>if the UE is configured by upper layers with Access Identity 1:","paragraph_zero_based":1174},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mps-PriorityAccess;","paragraph_zero_based":1175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["a87c4c99ced3f276660e8f90d0ff6b7d50b40466bb57ce5625fa8f67d0b6ba1d","cd8d4331ec0b39f799489b888f427cb9775a16669668c4275b28d4b533d15e33","018968336e2de0baf140012934d7b8aa146c9b7408675d00459bfbd442f74f02","feb56956104846c77b5e386a2f0d372e3bafc8de8af48d3f716addffb866b0cb","405a49b3ef40d449a0528cd7278e0a3359fdf634db1b132679c04e1d38a223b6","0ae84a9ebf4f7bcea2afbd4f37cdcdea7627289fa3547b8db3a0709008ac145d","555203d351c6135e9e657a3bb33a89205b10d7f94d878efceec81b97ef3911be","febb680f7491c69ffbde43df5803f53a666a77ed285f215ec17fc60265faa42e","34a8bed193c99e36d69d36f21c7e15432eddcf432ac036fdd7a25db149a5b091","fea97dbb61dc8ebfda7e57a4a9808ae58449a05cb9094d24f8224dbaf33e1955","d4f9e915e0b5a19f16ea8093a37941c665942bc4260b94e17882ebc4a375ef5a","ba54e28bfc0ab4a282b5579609100650db96cd2b4ebdf3a020b5f1e273157cbb","0990352fa5e702e74be8fc383852afae494da0c51a2604ef94238f0470c993da","b6d7dcb1e4044cead902478a00aa4acdeefac1b4e37df89ba8f54f60dd8a22e6","53b74886d1f70bd46f5a8697ca898eb81f732b13fc8a6139af3552a2ab656817","47d56cd56c4d0b92798827cb215d4dda47b60a249ef3fb76db2f4d6672533c86","f43fb052aaf4891e415052ab72af4687205bca065e108b116bef8b231d7545c7","a41579fa39f36cf94b31979280673df2b915e64c79aa29cae17a92612daa9c11","b5d7bf280cc4265c2649f08bb47e6a69fd6126c6ed4e02960b720e28f7d80f7b","168d2e0969ff81fc30df0105b9616f48d3b2bec77595e624b761bb98747ce841","510495749f461dac919e442cfab0bba16607a219b23b1558b36f80e273b535cb","552cfcec1fda0f4b8c78e3713c30ef9ee355fb52eaf499e6a10d22211eff7b69","2c2a43404997666233bfdc328e15ac4e76ca65f7d36f8d348c7da62d1bb1c6a9","8be2a99e8f71819184cccd35bef920bbfae98a92587cbc87415aba59bf78e062"],"paragraph_range_zero_based":[1152,1175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1152"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if the UE is configured by upper layers with Access Identity 2:","paragraph_zero_based":1176},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mcs-PriorityAccess;","paragraph_zero_based":1177},{"literal_text_all_w_t_and_m_t":"3>else if the UE is configured by upper layers with one or more Access Identities equal to 11-15:","paragraph_zero_based":1178},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to highPriorityAccess;","paragraph_zero_based":1179},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1180},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mt-Access;","paragraph_zero_based":1181},{"literal_text_all_w_t_and_m_t":"NOTE:A MUSIM UE may not initiate the RRC connection resumption procedure, e.g. when it decides not to respond to the Paging message due to UE implementation constraints as specified in TS 24.501 [23].","paragraph_zero_based":1182},{"literal_text_all_w_t_and_m_t":"2>else if the ue-Identity included in the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1183},{"literal_text_all_w_t_and_m_t":"3>if upper layers indicate the support of paging cause:","paragraph_zero_based":1184},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity, accessType (if present) and paging cause (if determined) to the upper layers;","paragraph_zero_based":1185},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1186},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity and accessType (if present) to the upper layers;","paragraph_zero_based":1187},{"literal_text_all_w_t_and_m_t":"3>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with release cause 'other';","paragraph_zero_based":1188},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for each TMGI included in pagingGroupList, if any, included in the Paging message:","paragraph_zero_based":1189},{"literal_text_all_w_t_and_m_t":"2>if the UE has joined an MBS session indicated by the TMGI included in the pagingGroupList:","paragraph_zero_based":1190},{"literal_text_all_w_t_and_m_t":"3>forward the TMGI to the upper layers;","paragraph_zero_based":1191},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE and the UE has joined one or more MBS session(s) indicated by the TMGI(s) included in the pagingGroupList:","paragraph_zero_based":1192},{"literal_text_all_w_t_and_m_t":"2>if PagingRecordList is not included in the Paging message; or","paragraph_zero_based":1193},{"literal_text_all_w_t_and_m_t":"2>if none of the ue-Identity included in any of the PagingRecord matches the UE identity allocated by upper layers or the UE's stored fullI-RNTI:","paragraph_zero_based":1194},{"literal_text_all_w_t_and_m_t":"3>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set as below:","paragraph_zero_based":1195},{"literal_text_all_w_t_and_m_t":"4>if the UE is configured by upper layers with Access Identity 1:","paragraph_zero_based":1196},{"literal_text_all_w_t_and_m_t":"5>set resumeCause to mps-PriorityAccess;","paragraph_zero_based":1197},{"literal_text_all_w_t_and_m_t":"4>else if the UE is configured by upper layers with Access Identity 2:","paragraph_zero_based":1198},{"literal_text_all_w_t_and_m_t":"5>set resumeCause to mcs-PriorityAccess;","paragraph_zero_based":1199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["21c2b174b1af5f35d32bd9af74464ddcf50eb58ac5101a6d30468f70a46bfb3d","343420a490d1b0be86de2ce3cd942e3c3dc09b1f000c6ccfe30a6cf6c6cc418c","63cfc0acedf25f5519939fa4dd08d0d98e29c12909d2a557b8cd7b388ef91b63","3b4b939872d2cca036189c3ebb4d60112699bd911e75061b06a4254c5685a6e0","da25000832045dee411577887798d985e05abef1e96eb7ae48235398f8f749cf","98de23d2d2e3fe5a389bbabc05853b7fa8c5349534015a19cb032c326678681f","384191c50b01b9fa5a9257d2c6b2d46268837ba3439a1f2821f50b14fcbe6a75","68d3282563921b002c2cf83a36d0ae3c9b70fe27ac8aaf4320a824a9874d7647","8d3e3b7f26cb5198846282c8dd4cb95b3226c5e2fc66c7d3e7fb3fc071a82085","f82930663d948e2a7fde23ea9814a27359cc0cba0178e562b5cfb6f70eaaa6df","9b015d510687440f60be0856c12cfc9865a2f5fded845e0e9b81f33a24453b4a","51e0964f123c025c7c5989eef61e55a691b43df4d47e332d48fcb435730d7598","6fc5af5175fca15d344d41c76ef2c1d18ba9e0f60bc6345720a43b9d5fae688b","6df504c12516e36342226b2892e90d26cbec129268475d195423889003857ea8","4c1d72c7d29cd606d50b321f57e879127f712980124d2588507d4b4fa7475809","42cae01e3e28453cfab45931c6e64ab23c627424e3247a0a5a2487764f8da781","a7de260b7bdb0091cf0a1036a9324879ad8f50579802cea22aa9e578a251ad08","c16d32e25e38de95cba984a2c91ba5c77f4eada7dcc90dab6272235716d3d101","fa94ac8c9432c8450e32457e54988577441bbd2d54b9b66f21b9eb981b3279d5","0412662b1d00a5840e89b116e9edfb6fe5f1c6c3a8a7943abcff1832f7b6d8f1","0d3e7a4ee966b067fc1247867a4203694b02f4282afb83915045c7d9ffddfd0c","85e45087fd09a0a2e2fb66338e0817c61fdb524de09c4a12df8c9accd227c234","186d27092afe6ce9521a014f46619cb4e8e10be10c66693f0468ea6faa098f0a","220b7152e6d1389268979d01753538543c3788930126b7ae8ef2f3c05e1af250"],"paragraph_range_zero_based":[1176,1199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1176"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>else if the UE is configured by upper layers with one or more Access Identities equal to 11-15:","paragraph_zero_based":1200},{"literal_text_all_w_t_and_m_t":"5>set resumeCause to highPriorityAccess;","paragraph_zero_based":1201},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":1202},{"literal_text_all_w_t_and_m_t":"5>set resumeCause to mt-Access;","paragraph_zero_based":1203},{"literal_text_all_w_t_and_m_t":"2>else if the ue-Identity included in any of the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1204},{"literal_text_all_w_t_and_m_t":"3>forward the TMGI(s) to the upper layers;","paragraph_zero_based":1205},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as a L2 U2N Relay UE, for each of the PagingRecord, if any, included in the Paging message:","paragraph_zero_based":1206},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord in the Paging message matches the UE identity in sl-PagingIdentityRemoteUE included in sl-PagingInfo-RemoteUE received in RemoteUEInformationSidelink message from a L2 U2N Remote UE:","paragraph_zero_based":1207},{"literal_text_all_w_t_and_m_t":"3>inititate the Uu Message transfer in sidelink to that UE as specified in 5.8.9.9;","paragraph_zero_based":1208},{"literal_text_all_w_t_and_m_t":"5.3.3RRC connection establishment","paragraph_zero_based":1209},{"literal_text_all_w_t_and_m_t":"5.3.3.1General","paragraph_zero_based":1210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1211},{"literal_text_all_w_t_and_m_t":"Figure 5.3.3.1-1: RRC connection establishment, successful","paragraph_zero_based":1212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1213},{"literal_text_all_w_t_and_m_t":"Figure 5.3.3.1-2: RRC connection establishment, network reject","paragraph_zero_based":1214},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to establish an RRC connection. RRC connection establishment involves SRB1 establishment. The procedure is also used to transfer the initial NAS dedicated information/ message from the UE to the network.","paragraph_zero_based":1215},{"literal_text_all_w_t_and_m_t":"The network applies the procedure e.g.as follows:","paragraph_zero_based":1216},{"literal_text_all_w_t_and_m_t":"-When establishing an RRC connection;","paragraph_zero_based":1217},{"literal_text_all_w_t_and_m_t":"-When UE is resuming or re-establishing an RRC connection, and the network is not able to retrieve or verify the UE context. In this case, UE receives RRCSetup and responds with RRCSetupComplete.","paragraph_zero_based":1218},{"literal_text_all_w_t_and_m_t":"5.3.3.1aConditions for establishing RRC Connection for NR sidelink communication/discovery/V2X sidelink communication","paragraph_zero_based":1219},{"literal_text_all_w_t_and_m_t":"For NR sidelink communication/discovery, an RRC connection establishment is initiated only in the following cases:","paragraph_zero_based":1220},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink communication and related data is available for transmission:","paragraph_zero_based":1221},{"literal_text_all_w_t_and_m_t":"2>if the frequency on which the UE is configured to transmit NR sidelink communication is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":1222},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink discovery and related data is available for transmission:","paragraph_zero_based":1223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3c793d3f9085bfc856563045965c04fda6312d860f7b8569aa19b63a2e34df72","7662f546927aecb197a8309b642b0badfadf70247af2cda35a5b88637826e1e0","029a2b0d645d509806883a5b652ba074c51aae106d31d46985d19eec747e8455","378da8502cd870459931e4a2694b4c1ec3e9eb6b9c20634a9f010aebd36cee3d","c31670a1e7bc70828e0ad6ca34fecd84a9bb1f4287663124d62be06da16c5fc2","3632fa03d6888177c7eab6342ce13f6af146a796d0b6d4c720ebdb0cac615611","09fa047f61a1583794d2d9d6bae36def189666f71e471a586f10919fd649d206","096072b6f3956472361f47c56695028df4ae57d60af8c0178ee1cf37d6a3f810","d465c6cd671f091fd4bd025495ba4745384543710a48751561f80437693ab56a","34ec69cd82c34b2ae2f68a1e9d0598c78377cfe569ab34fa49c30bddc25d97a9","3c0143dbf4b9ea42cc3140a7cc90ec7683389b396d9f11d46c7dbc1bf5807a3f","0b5497065848a5904b37d9785437eedfcdbce7b56b4cbbd34c87cd0c35031043","ff79a07e16ef61f9ba61398b193bbe92865afc6e6dbed3e1b48cd5f4d7084ce6","11d93704c396d76541ca12479daeebacb61577166f99e9fea48fba136969d7f2","13820c296350b671a097bd1c0af38de84ad0a2dfba1d46617f2c1cba33389fdf","4801ce07686f36254e0f185406c34f29cb4cada46526c61e7e90d56ae4562581","69b96e3dd5892593f238032e9e1bd18e6981ad91c3974bc6e85c86cf6eef568e","882b65a299a0d55b8875a6ad52ca0843381d631bc066093b2e61d8b512b0cca6","00838a46755f430c37f2c8da2c17fdaaf04d63d16938bf7789ae054dabd45b40","04b813dcd8d1a342e6955bb3be42d11f1d818d5d1d1af15772d5faa89cb60038","e895645d525a9f3abdcd683c67942a97a3f20e9e44bf8b956a2d24a04149c4b7","cfb711bd7d126878cc98788fc30a82bce344f6de318467fc6e4723d470e872ff","568ef43db843f458c9db17d2692fe76aaa0d08ac208d5c23bd5eb276455ce536","a8ed3fc191b2cffe8612f8f457ec0fd22c1b3f831fe74cf4a4a662a4794da2e6"],"paragraph_range_zero_based":[1200,1223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1200"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":1224},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":1225},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":1226},{"literal_text_all_w_t_and_m_t":"3>if the frequency on which the UE is configured to transmit NR sidelink discovery is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 includes neither sl-DiscTxPoolSelected nor sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":1227},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE in RRC_IDLE, an RRC connection establishment is initiated in the following cases:","paragraph_zero_based":1228},{"literal_text_all_w_t_and_m_t":"1>if any message is received from a L2 U2N Remote UE via SL-RLC0 as specified in 9.1.1.4 or SL-RLC1 as specified in 9.2.4;","paragraph_zero_based":1229},{"literal_text_all_w_t_and_m_t":"For V2X sidelink communication, an RRC connection is initiated only when the conditions specified for V2X sidelink communication in clause 5.3.3.1a of TS 36.331 [10] are met.","paragraph_zero_based":1230},{"literal_text_all_w_t_and_m_t":"NOTE:Upper layers initiate an RRC connection (except if the RRC connection is initiated at the L2 U2N Relay UE upon reception of a message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1). The interaction with NAS is left to UE implementation.","paragraph_zero_based":1231},{"literal_text_all_w_t_and_m_t":"5.3.3.2Initiation","paragraph_zero_based":1232},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when upper layers request establishment of an RRC connection while the UE is in RRC_IDLE and it has acquired essential system information, or for sidelink communication as specified in clause 5.3.3.1a.","paragraph_zero_based":1233},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having valid and up to date essential system information as specified in clause 5.2.2.2 before initiating this procedure.","paragraph_zero_based":1234},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":1235},{"literal_text_all_w_t_and_m_t":"1>if the upper layers provide an Access Category and one or more Access Identities upon requesting establishment of an RRC connection:","paragraph_zero_based":1236},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the Access Category and Access Identities provided by upper layers;","paragraph_zero_based":1237},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred, the procedure ends;","paragraph_zero_based":1238},{"literal_text_all_w_t_and_m_t":"1>if the upper layers provide NSAG information and one or more S-NSSAI(s) triggering the access attempt (TS 23.501 [32] and TS 24.501 [23]):","paragraph_zero_based":1239},{"literal_text_all_w_t_and_m_t":"2>apply the NSAG with highest NSAG priority among the NSAGs that are included in SIB1 (i.e., in FeatureCombination and/or in RA-PrioritizationSliceInfo), and that are associated with the S-NSSAI(s) triggering the access attempt, in the Random Access procedure (TS 38.321 [3], clause 5.1);","paragraph_zero_based":1240},{"literal_text_all_w_t_and_m_t":"NOTE:If there are multiple NSAGs with the same highest NAS-provided NSAG priority identified for access attempt as above, it is left to UE implementation to select the NSAG to be applied in the Random Access procedure.","paragraph_zero_based":1241},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":1242},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":1243},{"literal_text_all_w_t_and_m_t":"2>apply the specified configuration of SL-RLC0 as specified in 9.1.1.4;","paragraph_zero_based":1244},{"literal_text_all_w_t_and_m_t":"2>apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":1245},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1246},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":1247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c47b79cb91ed1ffd998fb52d08b1586aefc0205c2427d340c2848fb20f008d7e","67728a4a362c3844d0032f965f84eebe49f8065f2d825f289fd3d190e95c31cd","2a9098421e230421bbf898ef1e60bbf3e526ae7c96fe2cc479fdc763c0215792","ca8bac7e7732889f2d7089a633cac8aff2b38c677f33b4d0201ca42e187f3689","c81f3441972b9884082da06a11f4a66118c54e75581b83113d5fb0da6896d3db","3accd2de1af39dc0427fe855197b2e6b4f265a919a80f6449ccfb002b44578e5","c4f0b7f76ec7e991ec88a775731218049536c3af0ef118bb547f40ede611bce8","55a836a03305f39f89ab3f35e2ac5649b420e10f98bc91eadea15de010ec2713","aa467ec700d2b177747d69c9d0c49de618def3c525ec589a15d463fea55754e2","6213bcb3f7214d4e577e102027019aee17cfc292831d15ba161c203f749a1858","996287a678b23b6af0575cfcbdf859cc79689fb45ac892fe92e797de1293362d","f59bbb8bcd12edf9d1e4174610f6c40d4fa80b0c9b7799ec19ab806092308b55","68f8ac78e79acb8b437d12b27ccba914a58e30c87ac38eb3796d4e1b096511d9","9b1255e4e7dbd8fa784d95e63c49743d098deeafec07aa124a136a905e68cdd1","283dad1e57d7a022ccc6a0d01a228e94fe611396ae66bcb43ee5ebc3312ab03c","b8dea360bad9370299c0980fe515266e25385d4e6ef4106313bf11d13dc9c22b","32f4bbafe01d62966c8f09abe6594b933b178cb3a4ebd4fcc4e1ac0b8b7ea9f8","a74668cc051b46ea0b33371cc4fa3a012eafc7eaf7430f228fbdea91a18f9b32","8e87762710bf852e2930a64a9e65b73a4c6d0b90492e2271c80e61d15eadc453","0eca343ca33dd5104d268acac53e8656035d195cd2c92fb780fe8ad8861e9485","e775039e78cf254fa4fa6aabd5522097a1026d27795cd163e397b04529060dc2","e243263d2aaa43d281eb0fc4565749822db115603055e929cb519c56159bde72","09b745b79b464c6b5b32be54902ad447191aed644cf852b4b7ea4b81f50fe61e","754764b16230451c0b625c4e357e3707be206fef3074eacdf11e9ab8f3b4c719"],"paragraph_range_zero_based":[1224,1247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1224"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":1248},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":1249},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":1250},{"literal_text_all_w_t_and_m_t":"1>start timer T300;","paragraph_zero_based":1251},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCSetupRequest message in accordance with 5.3.3.3;","paragraph_zero_based":1252},{"literal_text_all_w_t_and_m_t":"5.3.3.3Actions related to transmission of RRCSetupRequest message","paragraph_zero_based":1253},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCSetupRequest message as follows:","paragraph_zero_based":1254},{"literal_text_all_w_t_and_m_t":"1>set the ue-Identity as follows:","paragraph_zero_based":1255},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide a 5G-S-TMSI:","paragraph_zero_based":1256},{"literal_text_all_w_t_and_m_t":"3>set the ue-Identity to ng-5G-S-TMSI-Part1;","paragraph_zero_based":1257},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1258},{"literal_text_all_w_t_and_m_t":"3>draw a 39-bit random value in the range 0..239-1 and set the ue-Identity to this value;","paragraph_zero_based":1259},{"literal_text_all_w_t_and_m_t":"NOTE 1:Upper layers provide the 5G-S-TMSI if the UE is registered in the TA of the current cell.","paragraph_zero_based":1260},{"literal_text_all_w_t_and_m_t":"1>if the establishment of the RRC connection is the result of release with redirect with mpsPriorityIndication (either in NR or E-UTRAN):","paragraph_zero_based":1261},{"literal_text_all_w_t_and_m_t":"2>set the establishmentCause to mps-PriorityAccess;","paragraph_zero_based":1262},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1263},{"literal_text_all_w_t_and_m_t":"2>set the establishmentCause in accordance with the information received from upper layers;","paragraph_zero_based":1264},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the L2 U2N Relay UE initiates RRC connection establishment triggered by reception of message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1 as specified in 5.3.3.1a, the L2 U2N Relay UE sets the establishmentCause by implementation, but it can only set the emergency, mps-PriorityAccess, or mcs-PriorityAccess as establishmentCause if the same cause value is in the message received from the L2 U2N Remote UE via SL-RLC0.","paragraph_zero_based":1265},{"literal_text_all_w_t_and_m_t":"1>if ta-Report is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":1266},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":1267},{"literal_text_all_w_t_and_m_t":"The UE shall submit the RRCSetupRequest message to lower layers for transmission.","paragraph_zero_based":1268},{"literal_text_all_w_t_and_m_t":"If the UE is a RedCap UE and the RedCap-specific initial downlink BWP is not associated with CD-SSB, the UE may continue cell re-selection related measurements as well as cell re-selection evaluation, otherwise the UE shall continue cell re-selection related measurements as well as cell re-selection evaluation. If the conditions for cell re-selection are fulfilled, the UE shall perform cell re-selection as specified in 5.3.3.6.","paragraph_zero_based":1269},{"literal_text_all_w_t_and_m_t":"NOTE 3:For L2 U2N Remote UE in RRC_IDLE, the cell (re)selection procedure as specified in TS 38.304 [20] and relay (re)selection procedure as specified in 5.8.15.3 are performed independently and up to UE implementation to select either a cell or a L2 U2N Relay UE.","paragraph_zero_based":1270},{"literal_text_all_w_t_and_m_t":"5.3.3.4Reception of the RRCSetup by the UE","paragraph_zero_based":1271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["61d1c6e4706accaeb48596df99d63d224fe0617cdea2809a605a0468b590349b","b27a531233a6fb79593824b7a5cda11e4292a59beb34db292ca8e3f014255e85","1a51e8dbc04faae1c5ad4dd303ac649649dab9c77548092cd8cb0bf3cd2889fe","6279befff4ef0ff8f0711a99df4b64ae023b0b28075e0fd13a7577281f850b06","71ebae4bf25cae3fe4b3b188ee4ca18d65f4febc46503c8ca77c319fbf5210ca","d8ec62c315d48c554f0a10501e1baa0ebf0bee7ffd622ca2b91a679260d9e9d3","cc2c9ce83d2b8bd682d8fc3c02877f6dc96744c67360660580d311cc9e69fb8c","4238651295cf77ee2d2efd22a40e4a84d69cfe77da94ff232d9cb963a684d3e8","6165c317cf44f83c6baec6dea992263ddc0ff64ba417c6a75ea234ad36a111e6","823814ea38986ced1b6c4b6d88ef0cb6642badec3165a8cba0b638102c5609c3","64be6aa95e79bd9eccf8fa6568c585a29a1b39cff05fe4dced7bc6585e9c81c5","5cbf1ffe44435a8fa27e6e4f46c16e2f66764b5d0248994d8f40fb2ff02fda09","d01907eeb0e736fc2d8a0e330e418c71eb599464c819cc83742ae50a010313db","0f71b1f3d561b7f2001c9ce10dcae343690e0d148fe58d74ba1e98ec73a1115b","c5bfd50f49798754187e9dfecd9780b81a47d02b53a582d2537148ca583e610c","420550671e7a38cdb10eddf3bbf83b5c9c05f30089d1d4c1cce7df14003287e3","8b2c914c08a1e3c5450a5090bfae78568ea976bcf7922bae2f2deffe6f0ae5e5","cbdc490ea5e3da3287ef46cd566d56adcd0c5786f0dfb45a64b2ac1ec10ce25e","9130c851ac2596327118401a99c777fd038cb7975d6567a0ca7e815cb6161ccd","baa04b7e138e3a13f40ffde461b5f28c4b2ca646ed043d71f3b5c94b08d3b4f3","a3f8790cd1f87f434902c9bcf848e583b47a5a40ebedcd63eb4551130c65374f","38b667effee13662c0d08dce23ad89152f81a929571fd25c760b77665bebd265","fa17a7577f672de3a0e1c36044d4fe6439a4534475592007176f87e805ec995c","9a0f6d6bc818f261f35e7beaa114eff76561ffdca20ab953bc24c9a033b47aad"],"paragraph_range_zero_based":[1248,1271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1248"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall perform the following actions upon reception of the RRCSetup:","paragraph_zero_based":1272},{"literal_text_all_w_t_and_m_t":"1>if the RRCSetup is received in response to an RRCReestablishmentRequest; or","paragraph_zero_based":1273},{"literal_text_all_w_t_and_m_t":"1>if the RRCSetup is received in response to an RRCResumeRequest or RRCResumeRequest1:","paragraph_zero_based":1274},{"literal_text_all_w_t_and_m_t":"2>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":1275},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":1276},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to start the timeAlignmentTimer associated with the PTAG, if it is not running;","paragraph_zero_based":1277},{"literal_text_all_w_t_and_m_t":"2>if srs-PosRRC-InactiveConfig is configured:","paragraph_zero_based":1278},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the inactivePosSRS-TimeAlignmentTimer, if it is running;","paragraph_zero_based":1279},{"literal_text_all_w_t_and_m_t":"2>discard any stored UE Inactive AS context and suspendConfig;","paragraph_zero_based":1280},{"literal_text_all_w_t_and_m_t":"2>discard any current AS security context including the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key;","paragraph_zero_based":1281},{"literal_text_all_w_t_and_m_t":"2>release radio resources for all established RBs except SRB0 and broadcast MRBs, including release of the RLC entities, of the associated PDCP entities and of SDAP;","paragraph_zero_based":1282},{"literal_text_all_w_t_and_m_t":"2>release the RRC configuration except for the default L1 parameter values, default MAC Cell Group configuration, CCCH configuration and broadcast MRBs;","paragraph_zero_based":1283},{"literal_text_all_w_t_and_m_t":"2>indicate to upper layers fallback of the RRC connection;","paragraph_zero_based":1284},{"literal_text_all_w_t_and_m_t":"2>discard any application layer measurement reports which were not transmitted yet;","paragraph_zero_based":1285},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the release of all application layer measurement configurations;","paragraph_zero_based":1286},{"literal_text_all_w_t_and_m_t":"2>stop timer T380, if running;","paragraph_zero_based":1287},{"literal_text_all_w_t_and_m_t":"1>perform the cell group configuration procedure in accordance with the received masterCellGroup and as specified in 5.3.5.5;","paragraph_zero_based":1288},{"literal_text_all_w_t_and_m_t":"1>perform the radio bearer configuration procedure in accordance with the received radioBearerConfig and as specified in 5.3.5.6;","paragraph_zero_based":1289},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities or inherited from another RAT;","paragraph_zero_based":1290},{"literal_text_all_w_t_and_m_t":"1>stop timer T300, T301, T319;","paragraph_zero_based":1291},{"literal_text_all_w_t_and_m_t":"1>if T319a is running:","paragraph_zero_based":1292},{"literal_text_all_w_t_and_m_t":"2>stop T319a;","paragraph_zero_based":1293},{"literal_text_all_w_t_and_m_t":"2>consider SDT procedure is not ongoing;","paragraph_zero_based":1294},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":1295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7247fd2f86fbce7fb7e798bc76de3a01ad2568678cb320e0c72bdfcbe6910dff","ee5a8e474d0009ea64ee50f544690f89fd28ee93ecbf6ec2335a872978ca492a","2ebb66611702d7461534b002ddc0b239062b37aa03ca7f3372821776ce2ca599","832d0908c932f752aa20861dcb63e0d7bbf5bcd185a34c7f0a68238b080833fa","c89ae0cbc3a39a3d1761ef01370d8c6912bfea2998ff7ad83581d1083ad10eb6","c401b9fa9a6a2b3079532486d546e2b4509f71587005b6ff7a446ecb0fcdba3a","b72838e85e80792328d83d4bb3b564e4693676d560cc0503b461a8447db24a8a","dcc4966d21a3d95a0cc9e7ede7a4dec4d9490d00a357d14ddbd4faefd2f1d5ef","292df748c05a56c2cf494d361bab43b6ebba58a9f9c22833203e85f904cc1e61","ac269c9f0a42cfe1828c61402698482f8a6ac12c3d7c053670ffb3381f46518c","05e3e02775806d3b1b5cf53977005124b2d4584384db3cdd13647376a6789d04","9dd6468a0e0d4eef05e80e0906e5dca14f2450d7d31afa49725d67ca61bba8e0","ed15a996e4aaf6b013bdc74f64f88f89280a29622622957704f724e54929d756","85b7e0adbac7f29bd1942e62abab2051fc8e431e3c884bea9fd477f7f9dfa62c","895cfa4e134fb196dd87fcd51446cf921f82858872854712d688823e6675415f","230308e5e27005efb156bd577392d3beded642bd530989e4b6aeabd720877605","ab4fabf18718fe531afbf7818c2d309c28f22ab668bc072b35d0b5c796ca2db9","37414b66b132dde9743e56d6bbe74365c2520839e652bf54d4777fe1da132364","ff2254457553c5a9c4166297b4727f05a0135a62443885b5878a5d034b12d803","7f26b299003f58a3afcfa39adba9e5e0d5ee003b33e299d4ebc102d681e3039d","17efaac76ee1d16abb4f8a23eba1d10301e61fc89f729196422799a8fbfb2291","dfa35c3cf8b85333c51e7b4bbd19c54b7bcded5a2555dc65c3af8be78b918be4","ad0badb275bb4e0933b16ee90a437af01723b4707cbb1b351929f10f034d00da","cf3d4b326aaf4e16c2d8735c420babe462684456c05296ceaff5d621e38f1083"],"paragraph_range_zero_based":[1272,1295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1272"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":1296},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":1297},{"literal_text_all_w_t_and_m_t":"1>if T302 is running:","paragraph_zero_based":1298},{"literal_text_all_w_t_and_m_t":"2>stop timer T302;","paragraph_zero_based":1299},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":1300},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":1301},{"literal_text_all_w_t_and_m_t":"1>if the RRCSetup is received in response to an RRCResumeRequest, RRCResumeRequest1 or RRCSetupRequest:","paragraph_zero_based":1302},{"literal_text_all_w_t_and_m_t":"2>if T331 is running:","paragraph_zero_based":1303},{"literal_text_all_w_t_and_m_t":"3>stop timer T331;","paragraph_zero_based":1304},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":1305},{"literal_text_all_w_t_and_m_t":"2>enter RRC_CONNECTED;","paragraph_zero_based":1306},{"literal_text_all_w_t_and_m_t":"2>stop the cell re-selection procedure;","paragraph_zero_based":1307},{"literal_text_all_w_t_and_m_t":"2>stop relay (re)selection procedure if any for L2 U2N Remote UE;","paragraph_zero_based":1308},{"literal_text_all_w_t_and_m_t":"1>consider the current cell to be the PCell;","paragraph_zero_based":1309},{"literal_text_all_w_t_and_m_t":"1>perform the L2 U2N Remote UE configuration procedure in accordance with the received sl-L2RemoteUE-Config as specified in 5.3.5.16;","paragraph_zero_based":1310},{"literal_text_all_w_t_and_m_t":"1>perform the sidelink dedicated configuration procedure in accordance with the received sl-ConfigDedicatedNR as specified in 5.3.5.14;","paragraph_zero_based":1311},{"literal_text_all_w_t_and_m_t":"1>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report:","paragraph_zero_based":1312},{"literal_text_all_w_t_and_m_t":"2>if reconnectCellId in VarRLF-Report is not set after failing to perform reestablishment and if this is the first RRCSetup received by the UE after declaring the failure:","paragraph_zero_based":1313},{"literal_text_all_w_t_and_m_t":"3>if the UE supports RLF-Report for conditional handover and if choCellId in VarRLF-Report is set:","paragraph_zero_based":1314},{"literal_text_all_w_t_and_m_t":"4>set timeUntilReconnection in VarRLF-Report to the time that elapsed since the radio link failure or handover failure experienced in the failedPCellId stored in VarRLF-Report;","paragraph_zero_based":1315},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1316},{"literal_text_all_w_t_and_m_t":"4>set timeUntilReconnection in VarRLF-Report to the time that elapsed since the last radio link failure or handover failure;","paragraph_zero_based":1317},{"literal_text_all_w_t_and_m_t":"3>set nrReconnectCellId in reconnectCellId in VarRLF-Report to the global cell identity and the tracking area code of the PCell;","paragraph_zero_based":1318},{"literal_text_all_w_t_and_m_t":"1>if the UE supports RLF report for inter-RAT MRO NR as defined in TS 36.306 [62], and if the UE has radio link failure or handover failure information available in VarRLF-Report of TS 36.331 [10] and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]:","paragraph_zero_based":1319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["c76555b36c8e876a8451eaae914af1b7dcf8f5d3e427e78eb73e30265b6b240d","6fd2f7d86f7381b79be0b95ebe4ca713029083fcac6936b0501d8d8c09e1f760","02e38dc1886a30b3db4d2aaad1964ca04fdb08ea9528bc60990782af83dc252a","e7ada6ee9a54d99706c569bba95e55042ae247e44320a637c9aa03be7dda9b3f","aed2c9382bef16c66c982707e6ba9581198117d340c40614f880d5ae224120e6","38e89cec721a58e91b8f62bfe6df6e056761e60c943aa124ea8dff34136ed3d6","3ff5a1e61b191a4409b44bd21b0554e94469b82233a4c53e996b55a2f4abcc54","000b6f05b8f8b83faa749e8abdf7cbe6eb701d9877469d67308ae8c0116fb439","9fae7b280e019bec9d6aa6cd068cf690719b223f630676d5bb36955e71667fb2","366bfb2a4ba5609de09800539980605d58f6b601672b12d13ce5a1cd638358c9","3ea782073c1f6c0ad10b41b901a6cbeee2db4c04701012b100bcd24fed83d2e6","6ff1e548c0453d5508228a4fc3ca4724f08a1647f9aedcea904f4d57561cd49d","4a36ead1a7711e0b7b9117c04b859c166433d7843eca9c9176d6759f1d552e67","69cd9ee2b44b0a95921e668966378ea42b229edfd0c902f247a493e28e02ccf6","1eda3b7d95a334427230b01fd99cf3f8afa49036d86535e7892e8111b0b2d834","381dd3a590b3fa36b4ed30ba9660180e1e6c92bc0cbca302552108fff2fa219e","cf49d47f658ad93734ff461a16c7372226aceb2d890bb0cf2c5173f7a78a9813","24f045f9e411170bd44ef1c3f72fe02bcdcc3ba32a79dc99f76ba938fda7d058","7cbe942a9e104e1f08d49d890a62136f1b7dab8cbfcc80812876038fafb9c6e9","11ef1e19ba582000c1891e766ea2166ed29236218f08d2801725fe464d6827be","d48414bc4f3b0d805fa7b1020e34126d0a5823056ad3ce60ed3844ca3fb17505","78aca21fe4ef409e7388d94b3eaa5347c3c56a3d2827b772a55aff530d83b3cd","521f968574a8d7a04fa75c9924a40a9265cc9bea7fcd50d65687e7f3cf23c51f","cbee0e140364f8bc418d86595a02059a69ad8ea7cc45ffe857e5dc889fd7be28"],"paragraph_range_zero_based":[1296,1319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1296"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if reconnectCellId in VarRLF-Report of TS 36.331[10] is not set after failing to perform reestablishment and if this is the first RRCSetup received by the UE after declaring the failure:","paragraph_zero_based":1320},{"literal_text_all_w_t_and_m_t":"3>set timeUntilReconnection in VarRLF-Report of TS 36.331[10] to the time that elapsed since the last radio link failure or handover failure in LTE;","paragraph_zero_based":1321},{"literal_text_all_w_t_and_m_t":"3>set nrReconnectCellId in reconnectCellId in VarRLF-Report of TS 36.331[10] to the global cell identity and the tracking area code of the PCell;","paragraph_zero_based":1322},{"literal_text_all_w_t_and_m_t":"1>set the content of RRCSetupComplete message as follows:","paragraph_zero_based":1323},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide a 5G-S-TMSI:","paragraph_zero_based":1324},{"literal_text_all_w_t_and_m_t":"3>if the RRCSetup is received in response to an RRCSetupRequest:","paragraph_zero_based":1325},{"literal_text_all_w_t_and_m_t":"4>set the ng-5G-S-TMSI-Value to ng-5G-S-TMSI-Part2;","paragraph_zero_based":1326},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1327},{"literal_text_all_w_t_and_m_t":"4>set the ng-5G-S-TMSI-Value to ng-5G-S-TMSI;","paragraph_zero_based":1328},{"literal_text_all_w_t_and_m_t":"2>if upper layers selected an SNPN or a PLMN and in case of PLMN UE is either allowed or instructed to access the PLMN via a cell for which at least one CAG ID is broadcast:","paragraph_zero_based":1329},{"literal_text_all_w_t_and_m_t":"3>set the selectedPLMN-Identity from the npn-IdentityInfoList;","paragraph_zero_based":1330},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1331},{"literal_text_all_w_t_and_m_t":"3>set the selectedPLMN-Identity to the PLMN selected by upper layers from the plmn-IdentityInfoList;","paragraph_zero_based":1332},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide the 'Registered AMF':","paragraph_zero_based":1333},{"literal_text_all_w_t_and_m_t":"3>include and set the registeredAMF as follows:","paragraph_zero_based":1334},{"literal_text_all_w_t_and_m_t":"4>if the PLMN identity of the 'Registered AMF' is different from the PLMN selected by the upper layers:","paragraph_zero_based":1335},{"literal_text_all_w_t_and_m_t":"5>include the plmnIdentity in the registeredAMF and set it to the value of the PLMN identity in the 'Registered AMF' received from upper layers;","paragraph_zero_based":1336},{"literal_text_all_w_t_and_m_t":"4>set the amf-Identifier to the value received from upper layers;","paragraph_zero_based":1337},{"literal_text_all_w_t_and_m_t":"3>include and set the guami-Type to the value provided by the upper layers;","paragraph_zero_based":1338},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide one or more S-NSSAI (see TS 23.003 [21]):","paragraph_zero_based":1339},{"literal_text_all_w_t_and_m_t":"3>include the s-NSSAI-List and set the content to the values provided by the upper layers;","paragraph_zero_based":1340},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide onboarding request indication:","paragraph_zero_based":1341},{"literal_text_all_w_t_and_m_t":"3>include the onboardingRequest;","paragraph_zero_based":1342},{"literal_text_all_w_t_and_m_t":"2>set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":1343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7e8d26cb848c0ea06fa0fbb15384006f1641b882eeac4cc76caa5776c17e0105","5de6f9fa2eb36ecea31be2ea3f3e8a9e8ac9815eb68168a66855f71c139094ea","ab5b64770f44cfaab23fa255fc8c5c0ad2f65761ad7acfc5991808c41692e668","0bdd8985f642ccaa7077416c464e17115ab4ae5c52841585d2ef0372f41b57dc","f27e046a419fd456dc5c5152c004b52717e3d1091ee14372b1dd6f501f1ac66f","3fc18cc216245041fbab54e9d84d7435957351b8ffa9b489e536cc902683a2ea","16d64826594f5d2fc3c9485c9bee18610c9881898a7e0e7ad79b8f1b76388360","9a10596c4b6da613d9665492d6ab595d77ca6d186132526aea93079be302f390","3f306d2733b25ec3b92b01fb40a18661e9e2e88372fffadbcd30b5ca63c78d18","1f13cc370bb4cdb2c4a65c9c6727f0904097786f01b82d2fd4a23e718a73edd8","679720a4d7c010e62e93520aae1a08137c54d028ead3684ff0873e13f7502d6f","5f78b9439ffb1dd8344c0a54b3febf188ca87f3194acfe627f5cd523c4267b03","44e002045d0caa0812da742c779c4b8dbfceafb8657a1d97d54ad6c8dc25a370","6e9a406d328749b02c2f20c1e66beb6bd6df864bc62f71217287cf9a97ed9447","929050f9930ff177e54e4cd68dc7f4118d07df9de2650f8a18ca9162c959e165","70671c31971d14d466d1d502eec10ed41563e97124ff42d74192b5ceb327580c","3d59451a190d5ef9588f6bea675a151789382f6a85e4736decb5049b54aae53e","e7693821775de0c03791c0facc43862ddc875eed4ad0a0572eff075ed42e6b0b","ad6b40244853d2b3e4c488809167f295d1631e7580d773a26c1f2ab40e630293","c09e2c6e752193ef59cb4d806200554aec55543a9554e331081519d80480b4d1","06b54147e82a5c9bdd2c4c45ee7d8681b0eb4cfcaddea72a6ba4ad2ca0f84e0d","83544ac82401e3c748bf1591d01a8c93e0249fdbff4842d33e5440fd5e1dc822","671e18d279e1aeb30ae1ab813988dcf059e50596a17320aa901f7e38e84a3925","900faea4527993e7900aeef5d0d6a0043f39494579bdaf02d85d317e1bc784c1"],"paragraph_range_zero_based":[1320,1343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1320"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if connecting as an IAB-node:","paragraph_zero_based":1344},{"literal_text_all_w_t_and_m_t":"3>include the iab-NodeIndication;","paragraph_zero_based":1345},{"literal_text_all_w_t_and_m_t":"2>if the SIB1 contains idleModeMeasurementsNR and the UE has NR idle/inactive measurement information concerning cells other than the PCell available in VarMeasIdleReport; or","paragraph_zero_based":1346},{"literal_text_all_w_t_and_m_t":"2>if the SIB1 contains idleModeMeasurementsEUTRA and the UE has E-UTRA idle/inactive measurement information available in VarMeasIdleReport:","paragraph_zero_based":1347},{"literal_text_all_w_t_and_m_t":"3>include the idleMeasAvailable;","paragraph_zero_based":1348},{"literal_text_all_w_t_and_m_t":"2>if the UE has logged measurements available for NR and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport:","paragraph_zero_based":1349},{"literal_text_all_w_t_and_m_t":"3>include the logMeasAvailable in the RRCSetupComplete message;","paragraph_zero_based":1350},{"literal_text_all_w_t_and_m_t":"3>if Bluetooth measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1351},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableBT in the RRCSetupComplete message;","paragraph_zero_based":1352},{"literal_text_all_w_t_and_m_t":"3>if WLAN measurement results are included in the logged measurements the UE has available for NR:","paragraph_zero_based":1353},{"literal_text_all_w_t_and_m_t":"4>include the logMeasAvailableWLAN in the RRCSetupComplete message;","paragraph_zero_based":1354},{"literal_text_all_w_t_and_m_t":"2>if the sigLoggedMeasType in VarLogMeasReport is included:","paragraph_zero_based":1355},{"literal_text_all_w_t_and_m_t":"3>if T330 timer is running and the logged measurements configuration is for NR:","paragraph_zero_based":1356},{"literal_text_all_w_t_and_m_t":"4>set sigLogMeasConfigAvailable to true in the RRCSetupComplete message;","paragraph_zero_based":1357},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1358},{"literal_text_all_w_t_and_m_t":"4>if the UE has logged measurements available for NR:","paragraph_zero_based":1359},{"literal_text_all_w_t_and_m_t":"5>set sigLogMeasConfigAvailable to false in the RRCSetupComplete message;","paragraph_zero_based":1360},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure or connection resume failure information available in VarConnEstFailReport or VarConnEstFailReportList and if the RPLMN is equal to plmn-Identity stored in VarConnEstFailReport or in at least one of the entries of VarConnEstFailReportList:","paragraph_zero_based":1361},{"literal_text_all_w_t_and_m_t":"3>include connEstFailInfoAvailable in the RRCSetupComplete message;","paragraph_zero_based":1362},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report, or","paragraph_zero_based":1363},{"literal_text_all_w_t_and_m_t":"2>if the UE has radio link failure or handover failure information available in VarRLF-Report of TS 36.331 [10], and if the UE is capable of cross-RAT RLF reporting and if the RPLMN is included in plmn-IdentityList stored in VarRLF-Report of TS 36.331 [10]:","paragraph_zero_based":1364},{"literal_text_all_w_t_and_m_t":"3>include rlf-InfoAvailable in the RRCSetupComplete message;","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"2>if the UE has successful handover information available in VarSuccessHO-Report and if the RPLMN is included in plmn-IdentityList stored in VarSuccessHO-Report:","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"3>include successHO-InfoAvailable in the RRCSetupComplete message;","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7e181ad8ee2d17d57d2aae6c885a41d6ab6ef2a813d7144d752ba5893d138844","15e9a912b8537df792c50612c61f928838ae9252c4c6e47ae22ec1fea161a2e7","80c83a987a3b9a5d24f2becc5b7b4d19e3aebedfe484d4f29712c47e254ba6d7","e0ef083c411228cf8e96d9d6ede43102c546728257567f16d3a29d3507cfed62","6841a30547fe71fa5af20edb9cac526ef1d912119fae00cf41e5cd00699186be","d4ce241bccbb694f14f9d2b23044bac4dfc4fbea0740d3a890613b9ceb60118a","fe90b25f6fbf508d3444841281dc16cb8a5c30bfc3bcb7eb5cb889553f03b0c0","a34d4d7804b12a81f6f229d5f056904dfc46749a8a5666142f407f31cf684794","c32dda411f2963c9a351a7f556785653ef18421f8cab14d989e6c2f69ae923e4","07005058c22dbc0186e66fe7eb35fdbacf46fdb8059fbf0ed3b00bb5f779394c","cf068c2006739258af1d8b1a37e50732d7d0c2cf7929dbd8fc2f414f32f4f81e","19cc3c57b0d4a80ea45bbab3a2ffd2bb1be6921b79e4e6ade497203738e006e9","f72d848fdc0f7e310305678e025e8287b2e50effbc966105fb1e14ac2c59da93","2510b044f31920794917ea299c34917ea3e4b943f541c853a23ceadd15ef0b66","0c50f127b8c1b8ccd7f33650f0cfd6ab8870fc8903df0c7061eeacc4faddf7ad","f8c31e7458613cb567a6f712966d1ba8ade4eafa9d5b2173a00b04ad9aed34a0","b98bc45c4b2d886cc4ec945fd090c948423a2a811eed411062069fd39c765607","464c71619a8bbe8ea66e2e5763dd4dcfec3ea6ea858e3fcee009b279a7879b07","1e276fb6edc2109edfb5a172804a5818d77ade11c1bd55c8978019f17bec98b5","501e447e041244e6b09f2a7e2933a892198ed34327f723d7356299ecb9bb0417","9faac3e5404f8b034b8c93e93e44b5ba32505875add98cd8393db51f2ea1f8e5","bbaec703fd8ad423feb0d9c706c540cb87e3f09d0939c839f346f6a4bf0863a9","0f3e4d5fe0101852c65856711a1f418ed9ea4e252fcea32a0a8d24e795a30c92","976e3a6caac980e79afa8fcb112d46faa1149c17cf4d9acc9068eb4e63f954ab"],"paragraph_range_zero_based":[1344,1367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1344"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE supports storage of mobility history information and the UE has mobility history information available in VarMobilityHistoryReport:","paragraph_zero_based":1368},{"literal_text_all_w_t_and_m_t":"3>include the mobilityHistoryAvail in the RRCSetupComplete message;","paragraph_zero_based":1369},{"literal_text_all_w_t_and_m_t":"2>if the UE supports uplink RRC message segmentation of UECapabilityInformation:","paragraph_zero_based":1370},{"literal_text_all_w_t_and_m_t":"3>may include the ul-RRC-Segmentation in the RRCSetupComplete message;","paragraph_zero_based":1371},{"literal_text_all_w_t_and_m_t":"2>if the RRCSetup is received in response to an RRCResumeRequest, RRCResumeRequest1 or RRCSetupRequest:","paragraph_zero_based":1372},{"literal_text_all_w_t_and_m_t":"3>if speedStateReselectionPars is configured in the SIB2:","paragraph_zero_based":1373},{"literal_text_all_w_t_and_m_t":"4>include the mobilityState in the RRCSetupComplete message and set it to the mobility state (as specified in TS 38.304 [20]) of the UE just prior to entering RRC_CONNECTED state;","paragraph_zero_based":1374},{"literal_text_all_w_t_and_m_t":"2>if the UE has flight path information available:","paragraph_zero_based":1375},{"literal_text_all_w_t_and_m_t":"3>include flightPathInfoAvailable;","paragraph_zero_based":1376},{"literal_text_all_w_t_and_m_t":"1>submit the RRCSetupComplete message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":1377},{"literal_text_all_w_t_and_m_t":"5.3.3.5Reception of the RRCReject by the UE","paragraph_zero_based":1378},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1379},{"literal_text_all_w_t_and_m_t":"1>perform the actions as specified in 5.3.15;","paragraph_zero_based":1380},{"literal_text_all_w_t_and_m_t":"5.3.3.6Cell re-selection or cell selection or relay (re)selection while T390, T300 or T302 is running (UE in RRC_IDLE)","paragraph_zero_based":1381},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1382},{"literal_text_all_w_t_and_m_t":"1>if cell reselection occurs while T300 or T302 is running; or","paragraph_zero_based":1383},{"literal_text_all_w_t_and_m_t":"1>if relay reselection occurs while T300 is running; or","paragraph_zero_based":1384},{"literal_text_all_w_t_and_m_t":"1>if cell changes due to relay reselection while T302 is running:","paragraph_zero_based":1385},{"literal_text_all_w_t_and_m_t":"2>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with release cause 'RRC connection failure';","paragraph_zero_based":1386},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1387},{"literal_text_all_w_t_and_m_t":"2>if cell selection or reselection occurs while T390 is running; or","paragraph_zero_based":1388},{"literal_text_all_w_t_and_m_t":"2>cell change due to relay selection or reselection occurs while T390 is running:","paragraph_zero_based":1389},{"literal_text_all_w_t_and_m_t":"3>stop T390 for all access categories;","paragraph_zero_based":1390},{"literal_text_all_w_t_and_m_t":"3>perform the actions as specified in 5.3.14.4.","paragraph_zero_based":1391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["ec97e4149cc6970da3b870763a5fa2f397f113c0b375f8df634c3db2724e4270","29ca3b7d1224a531a86a55659b0b465f08e22787de8ae6940b9f7cf4d6866a2a","a81a12c1e932aec56791c7a0ceab962cb36fc9166f4a6960dbbdfab78284b3f2","b54c53cea565e0bed9bba5085caaacbcdd56c715d015751ee3c8b051b43cd761","41875ee204f9c706bbe804295ad0929d6ee6d3da511be830f33da95e4db3c4ff","6dcb4e5e706a8bcc8047b482f7d954591f7fcc3ff7f54b7010ef9558406020aa","9cb0373fbe2e233ca23b0c74e348c46d2457d7a559996b5358ab5760203e852c","a3966ea0bff18a491df598f164e743c96bc6daa79c93f87eefeb4a74cbc1b2a8","78e93e6668c389ddd9b6879a856c044452dffc67b761637e4aaabb44a8e792cb","864cb5f285c666a653ef1ccc0cbfc01bf558076915fc0f168815ae7c225e171c","4b843dc75f278212461ab179b2e78b76c428fb0e90a642b3419183625105f112","bd954cf298c16322994616ed58ef8ad4467553f15ff517cc6836ba34eecd1056","4a31aeafdb245811db7f76f7d761f285b131658f537ee7f3fa475b326fe0d7c3","ff8326661ca150831ca9ecb99ebef9398100678008d5a1cae1a964afb9fd1d98","2f4cf794c12d39496f0c52d87460082d16e9c593fc0e1877939ea0f395b3cee9","c40ce3c119a8b42e868e3704e1b059f7e0ab066e1f3116ae7a79e42f107304cc","89d541c987a527cd9571e9c086fc5e6cc37da9e4d0a4a5c6626bb916d489c7f0","3fa2d7d4bf33812c3e2403eff1f9cc8e7728ae131b26cfc3982c828086ed2fbe","e52bdb39ff6aced54df2fdd3e97c500598dd23042cda2bccfd94bd9f0d3ef8e3","224f655398f54df98dc97ac04fbc4287f0630ecdf1daf8aa953b4fb8d1bb5b14","eb10066402cb73a6b99228d416bf4bcf9b91a36124084759a0189d62f85b6412","aaa1dbdf5c8940788c12c5784b7090eb05e058c38f747d8161a45d9a94df5b8c","2221c0f646976c168e23e41f5d4d1bb408ecc53b3bed51a49c1284caed15066e","220d190c09f88981144576affcd53163d0ec6b125bd74da455e6264def55fd65"],"paragraph_range_zero_based":[1368,1391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1368"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.3.7T300 expiry","paragraph_zero_based":1392},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1393},{"literal_text_all_w_t_and_m_t":"1>if timer T300 expires:","paragraph_zero_based":1394},{"literal_text_all_w_t_and_m_t":"2>reset MAC, release the MAC configuration and re-establish RLC for all RBs that are established (except broadcast MRBs);","paragraph_zero_based":1395},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RRC Connection Establishment failure with temporary offset and the T300 has expired a consecutive connEstFailCount times on the same cell for which connEstFailureControl is included in SIB1:","paragraph_zero_based":1396},{"literal_text_all_w_t_and_m_t":"3>for a period as indicated by connEstFailOffsetValidity:","paragraph_zero_based":1397},{"literal_text_all_w_t_and_m_t":"4>use connEstFailOffset for the parameter Qoffsettemp for the concerned cell when performing cell selection and reselection according to TS 38.304 [20] and TS 36.304 [27];","paragraph_zero_based":1398},{"literal_text_all_w_t_and_m_t":"NOTE 1:When performing cell selection, if no suitable or acceptable cell can be found, it is up to UE implementation whether to stop using connEstFailOffset for the parameter Qoffsettemp during connEstFailOffsetValidity for the concerned cell.","paragraph_zero_based":1399},{"literal_text_all_w_t_and_m_t":"2>if the UE supports multiple CEF report:","paragraph_zero_based":1400},{"literal_text_all_w_t_and_m_t":"3>if the UE has connection establishment failure information or connection resume failure information available in VarConnEstFailReport and if the RPLMN is equal to plmn-identity stored in VarConnEstFailReport; and","paragraph_zero_based":1401},{"literal_text_all_w_t_and_m_t":"3>if the cell identity of current cell is not equal to the cell identity stored in measResultFailedCell in VarConnEstFailReport and if the maxCEFReport-r17 has not been reached:","paragraph_zero_based":1402},{"literal_text_all_w_t_and_m_t":"4>append the VarConnEstFailReport as a new entry in the VarConnEstFailReportList;","paragraph_zero_based":1403},{"literal_text_all_w_t_and_m_t":"2>if the UE has connection establishment failure information or connection resume failure information available in VarConnEstFailReport and if the RPLMN is not equal to plmn-identity stored in VarConnEstFailReport; or","paragraph_zero_based":1404},{"literal_text_all_w_t_and_m_t":"2>if the cell identity of current cell is not equal to the cell identity stored in measResultFailedCell in VarConnEstFailReport:","paragraph_zero_based":1405},{"literal_text_all_w_t_and_m_t":"3>reset the numberOfConnFail to 0;","paragraph_zero_based":1406},{"literal_text_all_w_t_and_m_t":"2>if the UE supports multiple CEF report and if the UE has connection establishment failure informatoin or connection resume failure information available in VarConnEstFailReportList and if the RPLMN is not equal to plmn-identity stored in any entry of VarConnEstFailReportList:","paragraph_zero_based":1407},{"literal_text_all_w_t_and_m_t":"3>clear the content included in VarConnEstFailReportList;","paragraph_zero_based":1408},{"literal_text_all_w_t_and_m_t":"2>clear the content included in VarConnEstFailReport except for the numberOfConnFail, if any;","paragraph_zero_based":1409},{"literal_text_all_w_t_and_m_t":"2>store the following connection establishment failure information in the VarConnEstFailReport by setting its fields as follows:","paragraph_zero_based":1410},{"literal_text_all_w_t_and_m_t":"3>set the plmn-Identity to the PLMN selected by upper layers (see TS 24.501 [23]) from the PLMN(s) included in the plmn-IdentityInfoList in SIB1;","paragraph_zero_based":1411},{"literal_text_all_w_t_and_m_t":"3>set the measResultFailedCell to include the global cell identity, tracking area code, the cell level and SS/PBCH block level RSRP, and RSRQ, and SS/PBCH block indexes, of the failed cell based on the available SSB measurements collected up to the moment the UE detected connection establishment failure;","paragraph_zero_based":1412},{"literal_text_all_w_t_and_m_t":"3>if available, set the measResultNeighCells, in order of decreasing ranking-criterion as used for cell re-selection, to include neighbouring cell measurements for at most the following number of neighbouring cells: 6 intra-frequency and 3 inter-frequency neighbours per frequency as well as 3 inter-RAT neighbours, per frequency/ set of frequencies per RAT and according to the following:","paragraph_zero_based":1413},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":1414},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE includes the latest results of the available measurements as used for cell reselection evaluation, which are performed in accordance with the performance requirements as specified in TS 38.133 [14].","paragraph_zero_based":1415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["6518df821279f06235f9429c4653dfc2cb93a1802748c543e8b3cc1b80f51caa","c37478e0fd7fd2c58029c206398cbc186aebc9845d5d4a760813cb45bc8cfa4c","16c2d08f47c4e6625fab93a9b685a0d5063b2a57965645e5a4ab32efe8f7858c","194c5a8096f61f003a4d00f62bdcc3ae9d64b4092a4b4f6426176fd1ad4f1e42","d25fa2264eb4f64b00abd7f1d440e3f72621fd0b91d08d703c66971d306dcd69","989ef8ec4ebd4ec0f4a51f0cf80eee077979adf9cd57087b5d18f0ebb02a77c4","4ab8fb93c3fdec32a302079d5ca1521aa475af684a5c41ee89860f6b837a44ba","4c996190fabafc153d587c3e9c0421cdbb4a9c8be1ec42f06ab4a127b0189856","bdcf2d09102ce2ef61ec0e0e2e2306fe091636a7c992232c2027f066412b8492","5385090dd79c688c7c2f3109608d88fd166bba77708bad65604fdf72170c75f5","ce98c41d79a4d10abf1853bd20eab9139ef6c94e19eaac61727ccad05672f7dd","c3878c1b969c8c7c8b00e56f7475e5dd47520098c27c287f5c25c79543d7f288","35cf2a0574b7acc108fbb1bba81efc6dc056e2c8eb7b1616584bce3b2d31e841","eae8a59043fa7b50353d7c673ab2e1187dcfd8e48ed7e20a937ac9cade389b31","90b73a7b6c8562d1da6775833b6edfa1d7e1a8b94c1dc9629c994d808087bb8c","03d066c0cb05172b53124a2280e6a831f696ff9b447b4526fa453e3068b4de75","4f2a93a094278bf62711807e5bc5eb202a0634c02bf2d442d48db6251115259d","16f4aed0f96f79516966e0261faadf4097700138c316a3ab7bf5c7b158cd149a","709d510aa0283eedd2e03fd52a7ebfa35e23836c0c4826a3a1d65c0971e21560","329b4a3441c13657231961feb903a589b1a5cef0388e2965ffa2d83268cb6faa","42bb3278375ccb41d0d7bf4ca490e0008c4401c1b29fe5947fc956410bd6efd2","323f79e78ff43aa194c469a6c4a140d137880ed0e719021e9f1bc4aaf5caf19f","d16fca531b35bd9cb2dcbd9292bb2f100e8ab4e3ce07e199096dbe2a1d6dbaac","58e44c13211411c5b6d4e33a6bf74cbda05907d09dbffb8d60a72cd5e5cac10c"],"paragraph_range_zero_based":[1392,1415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1392"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if available, set the locationInfo as follows:","paragraph_zero_based":1416},{"literal_text_all_w_t_and_m_t":"4>if available, set the commonLocationInfo to include the detailed location information;","paragraph_zero_based":1417},{"literal_text_all_w_t_and_m_t":"4>if available, set the bt-LocationInfo to include the Bluetooth measurement results, in order of decreasing RSSI for Bluetooth beacons;","paragraph_zero_based":1418},{"literal_text_all_w_t_and_m_t":"4>if available, set the wlan-LocationInfo to include the WLAN measurement results, in order of decreasing RSSI for WLAN APs;","paragraph_zero_based":1419},{"literal_text_all_w_t_and_m_t":"4>if available, set the sensor-LocationInfo to include the sensor measurement results as follows;","paragraph_zero_based":1420},{"literal_text_all_w_t_and_m_t":"5>if available, include the sensor-MeasurementInformation;","paragraph_zero_based":1421},{"literal_text_all_w_t_and_m_t":"5>if available, include the sensor-MotionInformation;","paragraph_zero_based":1422},{"literal_text_all_w_t_and_m_t":"NOTE 3:Which location information related configuration is used by the UE to make the locationInfo available for inclusion in the VarConnEstFailReport is left to UE implementation.","paragraph_zero_based":1423},{"literal_text_all_w_t_and_m_t":"3>set perRAInfoList to indicate the performed random access procedure related information as specified in 5.7.10.5;","paragraph_zero_based":1424},{"literal_text_all_w_t_and_m_t":"3>if the numberOfConnFail is smaller than 8:","paragraph_zero_based":1425},{"literal_text_all_w_t_and_m_t":"4>increment the numberOfConnFail by 1;","paragraph_zero_based":1426},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the failure to establish the RRC connection, upon which the procedure ends;","paragraph_zero_based":1427},{"literal_text_all_w_t_and_m_t":"The UE may discard the connection establishment failure or connection resume failure information, i.e. release the UE variable VarConnEstFailReport and the UE variable VarConnEstFailReportList, 48 hours after the last connection establishment failure is detected.","paragraph_zero_based":1428},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE either indicates to upper layers (to trigger PC5 unicast link release) or sends NotificationMessageSidelink message to the connected L2 U2N Remote UE(s) in accordance with 5.8.9.10.","paragraph_zero_based":1429},{"literal_text_all_w_t_and_m_t":"5.3.3.8Abortion of RRC connection establishment","paragraph_zero_based":1430},{"literal_text_all_w_t_and_m_t":"If upper layers abort the RRC connection establishment procedure, due to a NAS procedure being aborted as specified in TS 24.501 [23], while the UE has not yet entered RRC_CONNECTED, the UE shall:","paragraph_zero_based":1431},{"literal_text_all_w_t_and_m_t":"1>stop timer T300, if running;","paragraph_zero_based":1432},{"literal_text_all_w_t_and_m_t":"1>reset MAC, release the MAC configuration and re-establish RLC for all RBs that are established (except broadcast MRBs).","paragraph_zero_based":1433},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE either indicates to upper layers (to trigger PC5 unicast link release) or sends NotificationMessageSidelink message to the connected L2 U2N Remote UE(s) in accordance with 5.8.9.10.","paragraph_zero_based":1434},{"literal_text_all_w_t_and_m_t":"The L2 U2N Remote UE indicates to upper layers to trigger PC5 unicast link release with its connected L2 U2N Relay UE.","paragraph_zero_based":1435},{"literal_text_all_w_t_and_m_t":"5.3.4Initial AS security activation","paragraph_zero_based":1436},{"literal_text_all_w_t_and_m_t":"5.3.4.1General","paragraph_zero_based":1437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1438},{"literal_text_all_w_t_and_m_t":"Figure 5.3.4.1-1: Security mode command, successful","paragraph_zero_based":1439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fa0784f43fa3254c8231d4683d225d0cacdb44f813a38453afeff1d896130460","aa9d1a6ee9cfc18fd90707953fcae6c8ba9ce58cedfb85e72b098ca58db914bd","fc848d1ef66b021eedd2d003053b0f29a2699fd7461382a945b1c033a18ae0e9","62a56b14bfb33505a3316f8609375b8ece1dfb696f1d7a3a13e259dc3363d3d7","ae9163274a5d0816c131013834a2561c0713122eab35bf58312313319e2614cb","e4ab19120fd50def5fca3129ea7b666b3fcb9201cde788bd1e3fff053082886d","06bb67415ed75ad29a472249d5cc43ac23256784b7c7d1f87ef53b6e879a9935","84093c6e3146bf22c352157128b7f97dd8e987e91a3570b3655791d18fc7e2ed","9ea13d5d7ce6e0b715e86a294f482ef731be14208ef9b232b901ebbb1ac760fb","e132818906c6f0cbdb7d6b168a10c36e68b28fe139a015242d7206badec85f29","18e2a8565fe7a4cc8c8eca5170373ab87e19d4070e3cc706ee8734d57ffc4aaf","c9a88c0fcb1dd5f3bf1b1b4ae5d2ca52e2e919994a631ce6d170e737a36dfb67","de4af9d729aeb2a7b808bed20c46a8e04d559de02166bf6f0da69cf0d5dd914e","4f5fd18cba6623bea1c61765d2056f64906b1b4aed3d9ae02b65cef90614f596","481e8d422b08feea83ed3771570c780327f27bdccd34d688de00512c7a0065f1","6974bc8d108d0b018e4f075f106c45f96eb4c440bec667b1a469bb930b4b2acd","b8bb2c3b8ce07987857167316974df5a0c059a252776ebd1870954fca6d75059","534244775deecaad743bb43039306a17cc4aebc82ced879fea3752ea5acbc159","22c6ca6e0dfd207c010fae08b3fc8493e9ca1167c2f0d5caf3f68daf0adefabc","303ebc99005918387f257d5dcdf8f8f64da55c32c4f15b708602d755b5037745","9013e2d7e5f86755034e6e0659186c90abae8200a18982fa54f02ef3e32bae02","99f22c7f9446889e066233b98db598e1c9ec78552ae41de8372f513495aa3c0d","979f73e4c60e83d2dbefb1eda0d4345795366541e1fe1a11dae531abc4708890","fc7c9492b3a79fd2e7c7e19d13b85515f85ce4084851c1d56aa88c19feb8f927"],"paragraph_range_zero_based":[1416,1439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1416"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1440},{"literal_text_all_w_t_and_m_t":"Figure 5.3.4.1-2: Security mode command, failure","paragraph_zero_based":1441},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to activate AS security upon RRC connection establishment.","paragraph_zero_based":1442},{"literal_text_all_w_t_and_m_t":"5.3.4.2Initiation","paragraph_zero_based":1443},{"literal_text_all_w_t_and_m_t":"The network initiates the security mode command procedure to a UE in RRC_CONNECTED. Moreover, the network applies the procedure as follows:","paragraph_zero_based":1444},{"literal_text_all_w_t_and_m_t":"-when only SRB1 is established, i.e. prior to establishment of SRB2, multicast MRBs and/ or DRBs.","paragraph_zero_based":1445},{"literal_text_all_w_t_and_m_t":"5.3.4.3Reception of the SecurityModeCommand by the UE","paragraph_zero_based":1446},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1447},{"literal_text_all_w_t_and_m_t":"1>derive the KgNB key, as specified in TS 33.501 [11];","paragraph_zero_based":1448},{"literal_text_all_w_t_and_m_t":"1>derive the KRRCint key associated with the integrityProtAlgorithm indicated in the SecurityModeCommand message, as specified in TS 33.501 [11];","paragraph_zero_based":1449},{"literal_text_all_w_t_and_m_t":"1>request lower layers to verify the integrity protection of the SecurityModeCommand message, using the algorithm indicated by the integrityProtAlgorithm as included in the SecurityModeCommand message and the KRRCint key;","paragraph_zero_based":1450},{"literal_text_all_w_t_and_m_t":"1>if the SecurityModeCommand message passes the integrity protection check:","paragraph_zero_based":1451},{"literal_text_all_w_t_and_m_t":"2>derive the KRRCenc key and the KUPenc key associated with the cipheringAlgorithm indicated in the SecurityModeCommand message, as specified in TS 33.501 [11];","paragraph_zero_based":1452},{"literal_text_all_w_t_and_m_t":"2>derive the KUPint key associated with the integrityProtAlgorithm indicated in the SecurityModeCommand message, as specified in TS 33.501 [11];","paragraph_zero_based":1453},{"literal_text_all_w_t_and_m_t":"2>configure lower layers to apply SRB integrity protection using the indicated algorithm and the KRRCint key immediately, i.e. integrity protection shall be applied to all subsequent messages received and sent by the UE, including the SecurityModeComplete message;","paragraph_zero_based":1454},{"literal_text_all_w_t_and_m_t":"2>configure lower layers to apply SRB ciphering using the indicated algorithm, the KRRCenc keyafter completing the procedure, i.e. ciphering shall be applied to all subsequent messages received and sent by the UE, except for the SecurityModeComplete message which is sent unciphered;","paragraph_zero_based":1455},{"literal_text_all_w_t_and_m_t":"2>consider AS security to be activated;","paragraph_zero_based":1456},{"literal_text_all_w_t_and_m_t":"2>submit the SecurityModeComplete message to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":1457},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1458},{"literal_text_all_w_t_and_m_t":"2>continue using the configuration used prior to the reception of the SecurityModeCommand message, i.e. neither apply integrity protection nor ciphering.","paragraph_zero_based":1459},{"literal_text_all_w_t_and_m_t":"2>submit the SecurityModeFailure message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":1460},{"literal_text_all_w_t_and_m_t":"5.3.5RRC reconfiguration","paragraph_zero_based":1461},{"literal_text_all_w_t_and_m_t":"5.3.5.1General","paragraph_zero_based":1462},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["0a15702426cd260b0c0ecc7f6022a8a43887bedb511b984986c9678100e697bb","7aea28a51e9fb54c78f0705bc5e9866d583b96cc521d4c7b04877f490cc7b1dc","8098370930df7ee9d9003ce35a42b4ea94b6532fe3ebd14126663f891393b561","a6ed53b8f2e29c6d1c5d62f5391a4df9654f2238b70468bb4d03f7773a35cc1f","47d79fbe226a7aa870b8c635f637c82e3d7ad6d3e0b56b4f6766546464e9e416","78c9b9911b52950c659ba9bc56f4bc40e16675594c0029b48967743bd235cb32","0e347c6d7487d021746566b18219fc9c5460045bdaf6dde0933fe4c3c44764cf","3c182a74d8b22fc7e74abba40436a63ed2eeea564cd47a20b0ec8b730f959568","3a38e378e21cd328d86dad98d418c2c07e9139efe3f1717f9bd93bdd6496ca05","66c0883a8bda52fa5f112bd378e0a101094969d476fb3e60a2bf4040069f623c","b3fedf903835647e7ccfde3cc1fc4bf824a4174abaeff1bcc5f790f0958eb07d","fc63a729f01769bd02c8388d4cbaeede182f44a6f1f0e3b0c9eefd9fb7fc3171","7a67f45df73981eb348ebf479ed8fc14935adda1e621dd82158eeb33fdee54bb","fb616b8ad1565f78d329f3c5f54ba1dce1a3fa0c03d36cf2dfcc836c30dae65c","2ada70e71db30f2d0497c74fc696d54001a03661f992b7c5d1dac0a8215835ca","c643fbf1f3c6bdc3db313d39eb034b4bb2921c2b92456445ae3512caa6fae056","15a9a85ec32d5a1b5233d49c46980fd4c1d425f519b48673fa8f630be8ddf315","53ee5efaa91e71b61388271a19a50695c2558a58c3e6e56fb3d50935acf79fab","1e13be7546646f37c47c062bb1483aaa8cb7b11182db0325d7def123b9769f5d","077e46623983d46fe2a87c336455ddf229147bbe14f9a03f9bcc22e74a594b8e","682e7652f2cce23ff5cd1c0ea22b433b3ebdb7f0dd53a54f7fa0269fe68fee8a","533e3e0a4522e370b9f9003ebc402a0dfc442f4d95b437015dd6161faa35698e","deeecef5547ffe0a67c5b2ad0e8e62b28226edbc201184d646b0b312c54ca2bc","451720f655be133be73db9ebd0d844ed25841c40df53376e7b322276eef8ab85"],"paragraph_range_zero_based":[1440,1463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1440"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Figure 5.3.5.1-1: RRC reconfiguration, successful","paragraph_zero_based":1464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1465},{"literal_text_all_w_t_and_m_t":"Figure 5.3.5.1-2: RRC reconfiguration, failure","paragraph_zero_based":1466},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to modify an RRC connection, e.g. to establish/modify/release RBs/BH RLC channels/Uu Relay RLC channels/PC5 Relay RLC channels, to perform reconfiguration with sync, to setup/modify/release measurements, to add/modify/release SCells and cell groups, to add/modify/release conditional handover configuration, to add/modify/release conditional PSCell change or conditional PSCell addition configuration. As part of the procedure, NAS dedicated information may be transferred from the Network to the UE.","paragraph_zero_based":1467},{"literal_text_all_w_t_and_m_t":"RRC reconfiguration to perform reconfiguration with sync includes, but is not limited to, the following cases:","paragraph_zero_based":1468},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync and security key refresh, involving RA to the PCell/PSCell, MAC reset, refresh of security and re-establishment of RLC and PDCP triggered by explicit indicators;","paragraph_zero_based":1469},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync but without security key refresh, involving RA to the PCell/PSCell, MAC reset and RLC re-establishment and PDCP data recovery (for AM DRB or AM MRB) triggered by explicit indicators.","paragraph_zero_based":1470},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync for DAPS and security key refresh, involving RA to the target PCell, establishment of target MAC, and","paragraph_zero_based":1471},{"literal_text_all_w_t_and_m_t":"-for non-DAPS bearer: refresh of security and re-establishment of RLC and PDCP triggered by explicit indicators;","paragraph_zero_based":1472},{"literal_text_all_w_t_and_m_t":"-for DAPS bearer: establishment of RLC for the target PCell, refresh of security and reconfiguration of PDCP to add the ciphering function, the integrity protection function and ROHC function of the target PCell;","paragraph_zero_based":1473},{"literal_text_all_w_t_and_m_t":"-for SRB: refresh of security and establishment of RLC and PDCP for the target PCell;","paragraph_zero_based":1474},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync for DAPS but without security key refresh, involving RA to the target PCell, establishment of target MAC, and","paragraph_zero_based":1475},{"literal_text_all_w_t_and_m_t":"-for non-DAPS bearer: RLC re-establishment and PDCP data recovery (for AM DRB or AM MRB) triggered by explicit indicators.","paragraph_zero_based":1476},{"literal_text_all_w_t_and_m_t":"-for DAPS bearer: establishment of RLC for target PCell, reconfiguration of PDCP to add the ciphering function, the integrity protection function and ROHC function of the target PCell;","paragraph_zero_based":1477},{"literal_text_all_w_t_and_m_t":"-for SRB: establishment of RLC and PDCP for the target PCell.","paragraph_zero_based":1478},{"literal_text_all_w_t_and_m_t":"-reconfiguration with sync for direct-to-indirect path switch, not involving RA at target side, involving re-establishment of PDCP /PDCP data recovery (for AM DRB) triggered by explicit indicators.","paragraph_zero_based":1479},{"literal_text_all_w_t_and_m_t":"In (NG)EN-DC and NR-DC, SRB3 can be used for measurement configuration and reporting, for UE assistance (re-)configuration and reporting for power savings, for IP address (re-)configuration and reporting for IAB-nodes, to (re-)configure MAC, RLC, BAP, physical layer and RLF timers and constants of the SCG configuration, and to reconfigure PDCP for DRBs associated with the S-KgNB or SRB3, and to reconfigure SDAP for DRBs associated with S-KgNB in NGEN-DC and NR-DC, and to add/modify/release conditional PSCell change configuration, provided that the (re-)configuration does not require any MN involvement, and to transmit RRC messages between the MN and the UE during fast MCG link recovery. In (NG)EN-DC and NR-DC, only measConfig, radioBearerConfig, conditionalReconfiguration, bap-Config, iab-IP-AddressConfigurationList, otherConfig and/or secondaryCellGroup are included in RRCReconfiguration received via SRB3, except when RRCReconfiguration is received within DLInformationTransferMRDC.","paragraph_zero_based":1480},{"literal_text_all_w_t_and_m_t":"5.3.5.2Initiation","paragraph_zero_based":1481},{"literal_text_all_w_t_and_m_t":"The Network may initiate the RRC reconfiguration procedure to a UE in RRC_CONNECTED. The Network applies the procedure as follows:","paragraph_zero_based":1482},{"literal_text_all_w_t_and_m_t":"-the establishment of RBs (other than SRB1, that is established during RRC connection establishment) is performed only when AS security has been activated;","paragraph_zero_based":1483},{"literal_text_all_w_t_and_m_t":"-the establishment of BH RLC Channels for IAB is performed only when AS security has been activated;","paragraph_zero_based":1484},{"literal_text_all_w_t_and_m_t":"-the establishment of Uu Relay RLC channels and PC5 Relay RLC channels (other than SL-RLC0 and SL-RLC1) for L2 U2N Relay UE is performed only when AS security has been activated, and the establishment of PC5 Relay RLC channels for L2 U2N Remote UE (other than SL-RLC0 and SL-RLC1) is performed only when AS security has been activated;","paragraph_zero_based":1485},{"literal_text_all_w_t_and_m_t":"-the addition of Secondary Cell Group and SCells is performed only when AS security has been activated;","paragraph_zero_based":1486},{"literal_text_all_w_t_and_m_t":"-the reconfigurationWithSync is included in secondaryCellGroup only when at least one RLC bearer or BH RLC channel is setup in SCG;","paragraph_zero_based":1487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["280b07631fa07ecaed24a700794bb7bea2fc54ac3998aa22029cda62e0d4e98c","031947e2c11d551fc2cf062f99ccb64993fb8a960995448ab816f36fe7d08711","2772e6136b0561208f92ba583553c9611fe2f09b8b1914b26fdda64228e4e56b","08e3b693f4d640e5be029eae9ceb917e0d1a5a00f11cde4d8564f7e3b78b2330","c1c4ec726e7737dd9be6b8b1c9b94057c0c7dde810a44cd65e334e72201da7be","4d8604e309728003b07a0e378db409d178aaa321e7dff08a49593783cfeca6a3","13933b03cfb1735d5c4722e918b4c157b600d72c6257a4d574c8ebae08fcd632","210eb84c60416f4bb5e7f652e03b2c4c52a492e03754eeb7c51bad1f5b019cba","206efa6a30bf0a4de85dfd16a5f2e9482e54569d0aab93f23d6bc4d899084c54","ef62eb9634f0361e6155c7504cb874af90aac36fc6bbd070f0a3a2d4929a6b55","970a1c946ddc1e9082e5caf082e4d27996fbf81f0b45f294c1f7929ed13c78ad","7492ae945330d3237316051d8e1cf42c2a9ab381770de06b19a0ce5722db019e","175079062fa3115f4986cc415faa80b6a740b2b3405cc91138b82903165c428e","aa499b2b0967beeb62177ba6b0c4714f44976e40f9d427b90bc37d10e231360b","27fe0755fbc4b895915f3af8296bd72167be6bb9bfa797952c533e3d2f0f6d1c","7ac151f2c05245bb7f55441d0ffcda7caf901cf3d3c6cb87e8ef57b0cf2a8847","88c1bf1db523404395fb2003e47e5964a76e52a358487395993afdd1f457a13d","2cc1f8c33e8b746064fb6dd228acc96fdc069d0de3e6bd9b12ebcfb41e607656","d5f28a927423a53e4879abf16078ed74f8edc750f359481ea12a3fa797945aa0","e71d13d8458f0b3c66b315815dfebace839a14ac954f2971d2a14141d0fc982d","2912231a233efdc1b737fa61aebc4ebc6e7f6578a90520ada163dec58b62cb34","7364d8544b1a394a0a393a5991e9d42be7374b8ea2b0bf48350523ab9ca6a230","84e8c99bf2ae207c3c008c1037c07038b71de801ce5fd1150b7709f4979d5232","03ac4e4315e74fbc33cfc4b1de28a3456e8af64f1cc750699f0130eccf6389cd"],"paragraph_range_zero_based":[1464,1487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1464"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-the reconfigurationWithSync is included in masterCellGroup only when AS security has been activated, and SRB2 with at least one DRB or multicast MRB or, for IAB, SRB2, are setup and not suspended;","paragraph_zero_based":1488},{"literal_text_all_w_t_and_m_t":"-the conditionalReconfiguration for CPC is included only when at least one RLC bearer is setup in SCG;","paragraph_zero_based":1489},{"literal_text_all_w_t_and_m_t":"-the conditionalReconfiguration for CHO or CPA is included only when AS security has been activated, and SRB2 with at least one DRB or multicast MRB or, for IAB, SRB2, are setup and not suspended.","paragraph_zero_based":1490},{"literal_text_all_w_t_and_m_t":"5.3.5.3Reception of an RRCReconfiguration by the UE","paragraph_zero_based":1491},{"literal_text_all_w_t_and_m_t":"The UE shall perform the following actions upon reception of the RRCReconfiguration, or upon execution of the conditional reconfiguration (CHO, CPA or CPC):","paragraph_zero_based":1492},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration is applied due to a conditional reconfiguration execution upon cell selection performed while timer T311 was running, as defined in 5.3.7.3:","paragraph_zero_based":1493},{"literal_text_all_w_t_and_m_t":"2>remove all the entries within the MCG and the SCG VarConditionalReconfig, if any;","paragraph_zero_based":1494},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the daps-SourceRelease:","paragraph_zero_based":1495},{"literal_text_all_w_t_and_m_t":"2>reset the source MAC and release the source MAC configuration;","paragraph_zero_based":1496},{"literal_text_all_w_t_and_m_t":"2>for each DAPS bearer:","paragraph_zero_based":1497},{"literal_text_all_w_t_and_m_t":"3>release the RLC entity or entities as specified in TS 38.322 [4], clause 5.1.3, and the associated logical channel for the source SpCell;","paragraph_zero_based":1498},{"literal_text_all_w_t_and_m_t":"3>reconfigure the PDCP entity to release DAPS as specified in TS 38.323 [5];","paragraph_zero_based":1499},{"literal_text_all_w_t_and_m_t":"2>for each SRB:","paragraph_zero_based":1500},{"literal_text_all_w_t_and_m_t":"3>release the PDCP entity for the source SpCell;","paragraph_zero_based":1501},{"literal_text_all_w_t_and_m_t":"3>release the RLC entity as specified in TS 38.322 [4], clause 5.1.3, and the associated logical channel for the source SpCell;","paragraph_zero_based":1502},{"literal_text_all_w_t_and_m_t":"2>release the physical channel configuration for the source SpCell;","paragraph_zero_based":1503},{"literal_text_all_w_t_and_m_t":"2>discard the keys used in the source SpCell (the KgNB key, the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key), if any;","paragraph_zero_based":1504},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration is received via other RAT (i.e., inter-RAT handover to NR):","paragraph_zero_based":1505},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration does not include the fullConfig and the UE is connected to 5GC (i.e., delta signalling during intra 5GC handover):","paragraph_zero_based":1506},{"literal_text_all_w_t_and_m_t":"3>re-use the source RAT SDAP and PDCP configurations if available (i.e., current SDAP/PDCP configurations for all RBs from source E-UTRA RAT prior to the reception of the inter-RAT HO RRCReconfiguration message);","paragraph_zero_based":1507},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1508},{"literal_text_all_w_t_and_m_t":"2>if the RRCReconfiguration includes the fullConfig:","paragraph_zero_based":1509},{"literal_text_all_w_t_and_m_t":"3>perform the full configuration procedure as specified in 5.3.5.11;","paragraph_zero_based":1510},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the masterCellGroup:","paragraph_zero_based":1511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["18b04a02e13247248e75f48f8120d8ba3318e9628cca877f789fafc1787807a4","3d03360ee7b593fa0a23380a3b4c21ab8471e0638b309d2a014eb9347d2d4abe","0f61376b5563f8374044d761daf40c24f311eb7b8599ce0dd9b87426c8de5837","c7653787ede29295a57d23b840298f13dfba44106757d57e0aa50da78677d43e","ee8c791a816d5e451448e3a50f0a10578f7ed9d322a158465f447230f3a37f58","75a8e90c7475ac0140d1e8a01adf3a2833c52486826c398a342b322e9b243c65","cfe3a18bc6811e8f0c80b70462513a245c6509df0e5c31723de255ee3fc198e9","62fc389228304d7c4f862d8a765ab41d9c08eba0cf7d31501651c7a46f93ba19","3838ef854b0de251b16c3f08d11859d7f73090fd32054a8a0562810ce2f8ab42","86a2d2ffc31464ebfa8b836973216833f888223b110adaf6e779da4a99164bcb","76495b95fd0493505cc58718b5e699500d6f5b5b54654d7e934e8006049cf634","849b632584a4d6abc52e6a72dae57a729f6b0edcf0d835bd33879d62a167b2d6","45a8c6ee4da5e818b80c7b0547d3bd6fd01f97e2dd7bae337184272fb6abb570","b7de743bfb68cc8835eb4db99ae123643e22356e6247f24cee67f4eb84a48d9f","7f77e9f969cd96e916af27a25a97587813023245a672c0a463c295037321a540","5c235545a5a07b0616e624db36b8b62bd68492a03153338e0af14ca214e018ea","2a8c3e34ad50d01076fdb1d4d1987803e7e558cfee704ebd0e5620ac4456286a","49de0e0d6831043f57b32708c80dabb86cfb3b358956e306aae109492b6d9a8f","8a4700ca202fff52d60aa501d2bed825079ab04d495d46a0bdb445ccf2230e76","56a64845654773e6118b49102297edd8e2f0bf8066fc00c541334785dba70bfa","e8264c419d974ca3681ff1a06cce18547d59d94433b77ba1d56e87d244932e55","cb70674e0b238fe2aa23cfe6fd0f7dcd95331a0630109a23220aaaf75f8b07b4","4f1318abecafcef201554635f03995d35a1fafdc9e786979376ae27eeda83233","9d522fc994db83138833a0d1239df5b34f51bd3959afa6ad3f4e49d501b8237f"],"paragraph_range_zero_based":[1488,1511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1488"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>perform the cell group configuration for the received masterCellGroup according to 5.3.5.5;","paragraph_zero_based":1512},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the masterKeyUpdate:","paragraph_zero_based":1513},{"literal_text_all_w_t_and_m_t":"2>perform AS security key update procedure as specified in 5.3.5.7;","paragraph_zero_based":1514},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the sk-Counter:","paragraph_zero_based":1515},{"literal_text_all_w_t_and_m_t":"2>perform security key update procedure as specified in 5.3.5.7;","paragraph_zero_based":1516},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the secondaryCellGroup:","paragraph_zero_based":1517},{"literal_text_all_w_t_and_m_t":"2>perform the cell group configuration for the SCG according to 5.3.5.5;","paragraph_zero_based":1518},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration includes the mrdc-SecondaryCellGroupConfig:","paragraph_zero_based":1519},{"literal_text_all_w_t_and_m_t":"2>if the mrdc-SecondaryCellGroupConfig is set to setup:","paragraph_zero_based":1520},{"literal_text_all_w_t_and_m_t":"3>if the mrdc-SecondaryCellGroupConfig includes mrdc-ReleaseAndAdd:","paragraph_zero_based":1521},{"literal_text_all_w_t_and_m_t":"4>perform MR-DC release as specified in clause 5.3.5.10;","paragraph_zero_based":1522},{"literal_text_all_w_t_and_m_t":"3>if the received mrdc-SecondaryCellGroup is set to nr-SCG:","paragraph_zero_based":1523},{"literal_text_all_w_t_and_m_t":"4>perform the RRC reconfiguration according to 5.3.5.3 for the RRCReconfiguration message included in nr-SCG;","paragraph_zero_based":1524},{"literal_text_all_w_t_and_m_t":"3>if the received mrdc-SecondaryCellGroup is set to eutra-SCG:","paragraph_zero_based":1525},{"literal_text_all_w_t_and_m_t":"4>perform the RRC connection reconfiguration as specified in TS 36.331 [10], clause 5.3.5.3 for the RRCConnectionReconfiguration message included in eutra-SCG;","paragraph_zero_based":1526},{"literal_text_all_w_t_and_m_t":"2>else (mrdc-SecondaryCellGroupConfig is set to release):","paragraph_zero_based":1527},{"literal_text_all_w_t_and_m_t":"3>perform MR-DC release as specified in clause 5.3.5.10;","paragraph_zero_based":1528},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the radioBearerConfig:","paragraph_zero_based":1529},{"literal_text_all_w_t_and_m_t":"2>perform the radio bearer configuration according to 5.3.5.6;","paragraph_zero_based":1530},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the radioBearerConfig2:","paragraph_zero_based":1531},{"literal_text_all_w_t_and_m_t":"2>perform the radio bearer configuration according to 5.3.5.6;","paragraph_zero_based":1532},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the measConfig:","paragraph_zero_based":1533},{"literal_text_all_w_t_and_m_t":"2>perform the measurement configuration procedure as specified in 5.5.2;","paragraph_zero_based":1534},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the dedicatedNAS-MessageList:","paragraph_zero_based":1535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["41467ad3090e5cad29cf9a566041a9a2d90cc203b9794f98e85fce5d48c83e1c","d7c7da0bae7fa1f62a470d9b68fb8aba7d14d75a0234aa0e3c41ed76f5e59c49","a75458c2347eb5a2b62418b9dd0ab87b3001ae1c7051496113334bc9463895f6","068d3b23e6f45eb0167d718cf284fd2dde114f4573f37deb9ad2f6e7a7965a71","5104f3120f2b0ddb7f496400dc6dbb6f2e0cb52709aaabf3670f8c2471885336","d9f396f0522c2f0535639e5c8f099255a21edfca46f1a0e4a19921a5137809ad","50021627c02230cb5276cb8e4c06132db460d0cba8a198f0d611f962d30053bf","90a73fcd082c578709a84be0ccab53783743aed0dc2c1d9f587bdbc3bceff8ae","49886759126d7eeed0005bc65871b44461d209aaf9c71a43a2f9759934641af9","902d9b2105d37ca526411b1eb31d18ad69785db00726e402060b0d22e57bae71","3db5b65db2e4f37ecef781eac06a9c222b37dbfd8430c993dc9f0ae6d4567e9d","8a3bc004d15e2c61754993b542a2be30a1a07e51c061ce03d446d965f64abe2a","ad8e9598cf29080f0a330bd5108c9fd4c6ab4b24e68d642b1fe3a7d112af66e1","39cadffe448a74fef1dea3c7df53d4af011a23b6ea44611a9bc9750aff9802c0","c612b2043e113fffe93e45d20565884a39d3a1f36b23033c7c56d4eae1392761","93ac66b35417c82bc1253a1940a961aab0695805c2d09dc84c58bd379850f748","87245ed896873c8c17c8d9da7e12579cd9853fad7d71c77c61a6573a1b260a9c","cce4c22b78f972e8f0fb3d65b2ed5159efbd2d008d7ed7ff2198662f2c847df5","e3cf2865701c9836064071852d0b53a67d392e4dc7fc7f1477261aaf031a817d","cd9f265d045d0015daa1f7cd1bc66709ceabf1da8c4f5eb9dc16075cad351380","250c4b1b1b9a54d0e93db02d256f5faf4641e1e5fcd167d4071b5dcb8f6293ae","4fd7dd44642dae53a2f4a44ac7743c2db49c05626f8de90cbd007b66b8abcade","ef501814a21f4d325cb820adec165331de30ba92304603af62aaf3148efdc726","f052179607232fc43bb5b2fa02ab8f8dff97008e960e2edb696b964939332595"],"paragraph_range_zero_based":[1512,1535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p1512"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>forward each element of the dedicatedNAS-MessageList to upper layers in the same order as listed;","paragraph_zero_based":1536},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the dedicatedSIB1-Delivery:","paragraph_zero_based":1537},{"literal_text_all_w_t_and_m_t":"2>perform the action upon reception of SIB1 as specified in 5.2.2.4.2;","paragraph_zero_based":1538},{"literal_text_all_w_t_and_m_t":"NOTE 0:If this RRCReconfiguration is associated to the MCG and includes reconfigurationWithSync in spCellConfig and dedicatedSIB1-Delivery, the UE initiates (if needed) the request to acquire required SIBs, according to clause 5.2.2.3.5, only after the random access procedure towards the target SpCell is completed.","paragraph_zero_based":1539},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the dedicatedSystemInformationDelivery:","paragraph_zero_based":1540},{"literal_text_all_w_t_and_m_t":"2>perform the action upon reception of System Information as specified in 5.2.2.4;","paragraph_zero_based":1541},{"literal_text_all_w_t_and_m_t":"2>if all the SIB(s) and/or posSIB(s) requested in DedicatedSIBRequest message have been acquired:","paragraph_zero_based":1542},{"literal_text_all_w_t_and_m_t":"3>stop timer T350, if running;","paragraph_zero_based":1543},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the dedicatedPosSysInfoDelivery:","paragraph_zero_based":1544},{"literal_text_all_w_t_and_m_t":"2>perform the action upon reception of the contained posSIB(s), as specified in clause 5.2.2.4.16;","paragraph_zero_based":1545},{"literal_text_all_w_t_and_m_t":"2>if all the SIB(s) and/or posSIB(s) requested in DedicatedSIBRequest message have been acquired:","paragraph_zero_based":1546},{"literal_text_all_w_t_and_m_t":"3>stop timer T350, if running;","paragraph_zero_based":1547},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the otherConfig:","paragraph_zero_based":1548},{"literal_text_all_w_t_and_m_t":"2>perform the other configuration procedure as specified in 5.3.5.9;","paragraph_zero_based":1549},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the bap-Config:","paragraph_zero_based":1550},{"literal_text_all_w_t_and_m_t":"2>perform the BAP configuration procedure as specified in 5.3.5.12;","paragraph_zero_based":1551},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the iab-IP-AddressConfigurationList:","paragraph_zero_based":1552},{"literal_text_all_w_t_and_m_t":"2>if iab-IP-AddressToReleaseList is included:","paragraph_zero_based":1553},{"literal_text_all_w_t_and_m_t":"3>perform release of IP address as specified in 5.3.5.12a.1.1;","paragraph_zero_based":1554},{"literal_text_all_w_t_and_m_t":"2>if iab-IP-AddressToAddModList is included:","paragraph_zero_based":1555},{"literal_text_all_w_t_and_m_t":"3>perform IAB IP address addition/update as specified in 5.3.5.12a.1.2;","paragraph_zero_based":1556},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the conditionalReconfiguration:","paragraph_zero_based":1557},{"literal_text_all_w_t_and_m_t":"2>perform conditional reconfiguration as specified in 5.3.5.13;","paragraph_zero_based":1558},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message includes the needForGapsConfigNR:","paragraph_zero_based":1559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["5d222eee759311