{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6.4.3Common NR Positioning Information Elements","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"–AreaID-CellList","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"The IE AreaID-CellList provides the NR Cell-IDs of the TRPs belonging to a particular network area where the associated assistance data are valid. Each cell is included in only one area.","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"AreaID-CellList-r17 ::= SEQUENCE (SIZE(1..maxCellIDsPerArea-r17)) OF NR-Cell-IDs-r17","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"NR-Cell-IDs-r17 ::= SEQUENCE {","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r17NCGI-r15OPTIONAL,-- Need ON","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r17NR-PhysCellID-r16OPTIONAL,-- Need ON","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r17ARFCN-ValueNR-r15OPTIONAL,-- Need ON","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"AreaID-CellList field descriptions","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"This field specifies the NR Cell Global ID of the TRP belonging to a particular network area where the associated assistance data are applicable.","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the TRP belonging to a particular network area where the associated assistance data are applicable.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["2a9b4c4cef942db083b698ff506a81d6bd93475ace505ffe6f8e3041725d2ddf","abd882045ee2c8eeab1350a50c93b696fed185a3bd4e949ba975e386cdd21b07","50912e9ccc1336ba609016388d50ff197293ba198a2995d5082701508273d13f","5e1992286177b9094678bd48ab9638927470b4a081024a82751bc8f64ae4de87","be6de4defab6c294bd43088b58073cd4064666a4fa641f502ac3b0228ed7ac03","faa8d7309c6f990df9d3193c9d6c28fbae34d5971283c32d4a13d60154b9d5ec","a333ccd7f4cb7336f6145709f482c0a4848710c74e9f8010e22f9a4658c5d217","2454a68483cb0bc40e0133fcd64011a1c1589cc5b488451015e88a1d7928c812","6dd22d447774bfdd24cccc14ce99c7cdaffcfde639f4d8db844ce73a840218a8","96325c84c84ae4f6c1109b27c4b303a3b9b5b98e0c3fa0412d9e58c49b82cdaa","92856fe5836853bb17907bc057b15fde2670fb46177e4548f8a289205fa44036","b28875545697432858b52b0ea530f80459c3918837aeadd2d7615d1f27a96221","8d4b23234ec09d855e0b6f48bb341eed9438c72d2f77bed50046fb1a64bb05c2","7e081779a29940af1aa616df0adf27488e050713bd6148c56845a71dc89b68d6","4ab99fef