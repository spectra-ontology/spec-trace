{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKMACCorrectionDifferences; otherwise it is not present.","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"Res-Sup","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKResiduals; otherwise it is not present.","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"FKP-Sup","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSRTKFKPGradients; otherwise it is not present.","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"OC-Sup","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSROrbitCorrections; otherwise it is not present.","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"CC-Sup","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSRClockCorrections; otherwise it is not present.","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"CB-Sup","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSRCodeBias; otherwise it is not present.","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"URA-Sup","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-URA; otherwise it is not present.","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"PB-Sup","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-PhaseBias; otherwise it is not present.","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"STEC-Sup","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-SSR-STEC-Correction; otherwise it is not present.","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"Grid-Sup","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSSSSRGriddedCorrection; otherwise it is not present. Note, support for GNSSSSRGriddedCorrection implies support for GNSS-SSR-CorrectionPoints as well.","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"DNavIC-Sup","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports NavIC-DifferentialCorrections; otherwise it is not present. This field may only be present if the gnss-ID indicats 'navic'.","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"NavIC-GridModSup","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports NavIC-GridModel; otherwise it is not present. This field may only be present if the gnss-ID indicats 'navic'.","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-Grid-Sup","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["9fd23e90cdc816aa86abc62397cc02ae1a7ad6af5fab8517799d557ab2e31af4","d81c80b3c8b169a1acb086a5e482f84bd43e8f82dcede99ac746cd125c409ec9","7f83db4caea883db3fad9c36b43b355194e3a4fc980325a0fed8185b995c2b0d","4138e56de321a3239506caa5144efe155d5249d217cdb530fddb986af95772b2","3b43572bc3743c3aeb1598babad6ca19e7da90cccef60488