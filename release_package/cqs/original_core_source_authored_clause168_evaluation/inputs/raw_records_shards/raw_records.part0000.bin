{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–MeasObjectRxTxDiff","paragraph_zero_based":20232},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectRxTxDiff is used to configure the measurement object for UE Rx-Tx time difference measurement.","paragraph_zero_based":20233},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff information element","paragraph_zero_based":20234},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20235},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTRXTXDIFF-START","paragraph_zero_based":20236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20238},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff-r17 ::=      SEQUENCE {","paragraph_zero_based":20239},{"literal_text_all_w_t_and_m_t":"    dl-Ref-r17      CHOICE {","paragraph_zero_based":20240},{"literal_text_all_w_t_and_m_t":"        prs-Ref-r17             NULL,","paragraph_zero_based":20241},{"literal_text_all_w_t_and_m_t":"        csi-RS-Ref-r17          NULL,","paragraph_zero_based":20242},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":20243},{"literal_text_all_w_t_and_m_t":"    }                               OPTIONAL,   -- Need R","paragraph_zero_based":20244},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":20245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20247},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTRXTXDIFF-STOP","paragraph_zero_based":20248},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20250},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff field descriptions","paragraph_zero_based":20251},{"literal_text_all_w_t_and_m_t":"dl-Ref","paragraph_zero_based":20252},{"literal_text_all_w_t_and_m_t":"configures the DL references signals to measure Rx-Tx time difference. prs-Ref-r17 indicates PRS is chosen, and csi-RS-Ref-r17 indicates that CSI-RS for tracking is chosen.","paragraph_zero_based":20253},{"literal_text_all_w_t_and_m_t":"Only one PRS resource set is configured by the network. Only one NZP-CSI-RS-ResourceSet can be configured with pdc-Info-r17 set to true and it is used for UE Rx-Tx time difference measurement. Only reference signals from the PCell of the MCG can be configured by the network.","paragraph_zero_based":20254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["8ab093b093e18f867501cc0f9c9b87aa018d8d51f9fda3eb262206648499161b","ed0bb9c9d48cdde1c8151bc5f08ee4e38b998e953088e2b3624f0d0b1ca861ce","5788834146696a2994c1f411f5854611868725432ded535f69cb533e4d0f6560","529c09fae47fe50334e951095f76865167c7bab1f6709ea6d4f27741bdababc5","84d946091e35835af312ce8a411d1966514fbbd2476cdfef11458e3daafb9f90","13400ec4d93aabb4435a463beb001875470509c8aa4db666f4994faf0c6a39c7","49aeb7ea63454c34d515a46028981c7c92f0d372644ed9cb2b3dea3333992dd0","fb4cb8a93ce534f94620e298a8cebc82d73f72a7a5eb8f08d1e7e55a60a238e8","c1a7e7b757c6b5a52b8c4e82ce70db9a1ffe747a3b19df9f5f2132c367116b74","53154437728874b2cfeddc1096376e4da37db5576a1c0dd40ba5f153bc2c706c","f50e3cb56d1d2fea657485c748fceadb8871389c649209556e05ef1444caf533","11b955a871c8309cb2a73daa64a47bf69cb15cfb1acbd7251d2b3357b5704391","2978f0495dfee721796e055ee0f9dcd48cb173fa3cdbb80cef67e2cec43decbe","3f9ef2ba08b692477399c614371463245bc0282ad653cd66621b2e4f1b88440e","e60d02743