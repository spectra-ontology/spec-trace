45},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2947},{"literal_text_all_w_t_and_m_t":"RemoteUEInformationSidelink-r17-IEs ::=       SEQUENCE {","paragraph_zero_based":2948},{"literal_text_all_w_t_and_m_t":"    sl-RequestedSIB-List-r17                     SetupRelease { SL-RequestedSIB-List-r17}          OPTIONAL, -- Need M","paragraph_zero_based":2949},{"literal_text_all_w_t_and_m_t":"    sl-PagingInfo-RemoteUE-r17                    SetupRelease { SL-PagingInfo-RemoteUE-r17}         OPTIONAL, -- Need M","paragraph_zero_based":2950},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                      OCTET STRING                                       OPTIONAL,","paragraph_zero_based":2951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"cfd1aef054dea290a9770e5c2de1b12f4cc7358b773882ae43663cec7a0c7249","original_member_sha256":"eb486990e07cad7e16d78b726e76051d7652abe5c7bb2e34c237c431cbcb3180","paragraph_ElementTree_utf8_XML_sha256":["b6bf5ab70f8ef44ea1c105c7a4aeb9301739001502f09196aca4ebf03eb799f5","bed5fd576becc4f29f564acd87dae48e3246225a4d29bd2f7839bd07c084be5d","4866cd325dec258b1ba5e449b7714db6c3430f79e620158e7d31e939ce712416","95dcc7476a1684f578ecf31c54e57d80573d52713ff49cd26afddf2ce881b8e0","f83ac735dc2dc922a557246526742f00e764c929086377f216c0524c071939e5","be9cad38a87d16bb1eb6e8450139f4e3d2a351d93e19ad74beaf6d31bf04b9e5","c33ff60575866a192ca0900741697a2df8a667db358a6faba0a6648a53f28e5f","59f5a25db554fadad5b7af68f966dbb6a929c045ea4bf1cc7c6b335a767ae059","fa0fdc2d00ca6c3cdf9e475482f9d216405195a0b2668c73336b8a60ff7d77ed","b78a6cf9f6216cd28ec5092fe06246d60b7727d2bd26356626fd8b0f695940a4","c3d52edfb6e04035e7aa57cf9c3816f229b1179e44156ed0f3d728abf0f49a65","f691f2de16f65a23c7792181d79bce1aa876bcfb84aefbadbb680fc9af06cdf8","cd6671453ef9ca152e1697d0e0da82ed9dca3989863a20fa4