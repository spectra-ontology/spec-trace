{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GriddedIndications-r18 ::= SEQUENCE {","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"gridPointSetID-r18INTEGER (0..16383),","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"expirationTime-r18UTCTimeOPTIONAL,-- Cond NotAlreadyProvided","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"gridList-r18GridList-r18,","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"GridList-r18 ::= SEQUENCE (SIZE(1..1024)) OF GridElement-r18","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"GridElement-r18 ::= SEQUENCE {","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"gnss-LOS-InfoList-r18GNSS-LOS-InfoList-r18OPTIONAL, -- Need ON","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-InfoList-r18 ::= SEQUENCE (SIZE(1..64)) OF GNSS-LOS-InfoElement-r18","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-InfoElement-r18 ::= SEQUENCE {","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"svID-r18SV-ID,","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"los-r18ENUMERATED{true, false, uncertain},","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"…","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["44afd44228fdca79602a2a112636575f348f396839ab869e6aadd8cc2cde7a49","f3006f00906c727d920ef7884ff4c92d2f0347a495b96e0ee10d7a0ac0169e68","b2c1f95c2193d3c5fe6ed6368a455a458c864a4850b55b8f1b1431e92de34788","be2e1466cd3dbbaf53ad2838e45875918aef2af6e829745ef142e3d3b09fab36","09302e0b940642b769c28f96363e6ea88ebfbce2b22254f0dc8ceb5c00f0c16e","0e794ef8c9be801e742359ee838c0a1f5ae916d64a7a36d8d56d8817d8c3709b","c5ef1c238a9221cfe67d276b3da5c977c0558204fdd9fc464b9da3bd07d41f6f","498bc16c3b3e176f4a74bcefa8a57bc30e6afc0dcd8765589b84e222e4c31107","c5451141d37f30dcfef6eda5e18d2f84eaa54e86c492d748312ac1ca8bc65079","27fc369ef770a113f9bc4a8044ea4a0c449c0f5f1c848920faf38688538b12cf","fc8f8a4a42c50d5f2b0177cbfac0832ff3a2e26023586ab5a805b7ee5e0b2dc7","a4266b9a1cef13289e79809e8739294231afde81e8838af45e7a0dc425680bdc","8f0685381ec5ae44a550e318f8fa641d3b9e8254b36ff573bc7340e0eecd0c0c","c56c30925a195f77afd8ffbf77574728e0c83f84be98e906574eefb4e71807e0","70e8440b062d6df11e964ff6544825a370907d84a1268bd19a77db65dd3d863d","b48bbad1cf00131c42f2a786a26e7490de51798e975d4778646e0541d8c02ce8","3dc71c26e923aaa9a1e1fa431e60fc201523c755376f44bd9b00d1975d02912c","ad8ed934cce3c3c5a031f3b5453822bdedcb56250404971885c5b2294b2709e8","24d77c84dd25cd98b12b6d8d21c0ec0ff57f71bffd90fdb463712894f8f9cdcb","64d937426e79547734b49056928e954574faa04da526fa910faec368e31f495a","99bbb61f5d33218f83431045f6039f07ff7f88ac52f46fbd1f66ab6d2a89b238","a56fefd7f0d446e882cc7e2f14c52c1e244604ad2ae01b20d6c2d9c2c74e76a1","bb55b5ceb991f85f4c347b60b935c2b3adfba238b89a88367f3b2d326ff75d76","0e88bd46b96ed5f0747c5b1adac273ca0185193aebc23729ab4f9cb18bb2e405"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2306788.zip::R2-2306788.docx:p312"}
{"fields":{"filename":"R2-2306788.zip::R2-2306788.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"NotAlreadyProvided","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"This field is absent if ","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"this IE is provided as part of an AssistanceDataSIBelement IE with a present expirationTime field","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"the field expirationTime is already present in this IE for a different GNSS ","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"In both these cases, the expiration time inherited to apply to the data of associated gridList.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GriddedIndications field descriptions","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"gridPointsSetID","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the LOS-NLOS Grid Point set. It is a regionally unique arbitrary number that is used by the UE to ensure that the GNSS LOS-NLOS indications are being applied to the correct set of points.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"gridList","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"This field provides the GNSS LOS-NLOS indications for up to 1024 grid points (up to 256 grid points per altitude layer) defined in IE GNSS-LOS-NLOS-GridPoints.","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GridPoints, which belongs to this gridPointSetID, includes the same number of entries as in the gridList, and listed in the same order, as defined by the enabled bits in the bitmaskOfGrids. The upmost grid layer is populated first, followed by the lower layer.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"svID","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"This field specifies the GNSS satellite for which the LOS-NLOS indications are provided.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"LOS","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"This field represents a LOS indication per svID per GNSS for a specific grid point, and can take the following values:","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"true – the satellite vehicle is in line of sight","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"false – the satellite vehicle is not in line of sight","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"uncertain – satellite vehicle can either be in line of sight or not ","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"expirationTime","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fbeae976bbc8edc7e0539a44d8a9b6b2c07a41ac0fd1f467f708ab937e86c132","original_member_sha256":"c0174c5d396f424131389c93eb406a63cf72606d587a8789eb6e851ef38bfc98","paragraph_ElementTree_utf8_XML_sha256":["66005ae989a52d94d60bafa540e581612cdcd745ad3da1191ca617e4da6dec48","7627bb77031b5cc21e9c56d75d2434ec1eed030cead561be5f8ce4db9b4cf713","f9ed551f8d061c70269ce20667e442a7e5db917131450baa176c6919e3f29c9e","23e144ffa74fe9e68ccd7c4af71674bcb7f14007add52284bc82e87429ce0c10","ae0f10c5412718dd4d9d47654116a2e21a6c7d0fb58fab4bf551d21eaa32bb5b","c4bfaca2bee1399ea31bbd1219689b74c318f8ecd8f9c89d033f081668181e12","0d44bbad4b9248559f5d27be2d66d4cf2909ae158c69157a8019a674924b2566","73d4d02bc24987a21f75c24de8904d373e2675f