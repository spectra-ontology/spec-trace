{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-DLDEDICATEDMESSAGESEGMENT-START","paragraph_zero_based":9048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9050},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment-r16 ::=       SEQUENCE {","paragraph_zero_based":9051},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":9052},{"literal_text_all_w_t_and_m_t":"        dlDedicatedMessageSegment-r16           DLDedicatedMessageSegment-r16-IEs,","paragraph_zero_based":9053},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":9054},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9055},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9057},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment-r16-IEs ::=   SEQUENCE {","paragraph_zero_based":9058},{"literal_text_all_w_t_and_m_t":"    segmentNumber-r16                       INTEGER(0..4),","paragraph_zero_based":9059},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentContainer-r16         OCTET STRING,","paragraph_zero_based":9060},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentType-r16              ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":9061},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                  OPTIONAL,","paragraph_zero_based":9062},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    SEQUENCE {}                                   OPTIONAL","paragraph_zero_based":9063},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9065},{"literal_text_all_w_t_and_m_t":"-- TAG-DLDEDICATEDMESSAGESEGMENT-STOP","paragraph_zero_based":9066},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9068},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment field descriptions","paragraph_zero_based":9069},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":9070},{"literal_text_all_w_t_and_m_t":"Identifies the sequence number of a segment within the encoded DL DCCH message. The network transmits the segments with continuously increasing segmentNumber order so that the UE's RRC layer may expect to obtain them from lower layers in the correct order. Hence, the UE is not required to perform segment re-ordering on RRC level.","paragraph_zero_based":9071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["b8e3ff228f158315470fc8d163c6ba5afe866a1e6b37b093b1b9c9cdc9296207","ec2507cce9bf096cedd9cf8807dc36bd711941f2606ab2db156cd57490071f19","3686a05160dafdb7b4de3fc4537bb15608b6a5fe27133c9a13d0c5d57486812b","5a3985dabcaefc8ebde2b90225cf49dfd5944ed52da5ca06c58235c87670a616","49b62675a2c749cc8150ae3e72db5ef609057acfe0029eb0746a64949df4d992","c4b00f107b535fc61a5cf4a12dfc552edff944f77ecc6075dda7de8e0310d427","f2d0aa42a2214458c8ee70d98abe38fe2ebb1acdd233892591aa20d8a2858983","e7dfc9ebd442aa330d640292a2443e88b20ef2ead7a6e59473dad7c62f00660e","550396c7460835243f87b213a2d86760aa5377617e9f25803d963e12f634d3fa","c3fb6e384569c82740d33783d0ae14416fc7c0e04cc2325492b0819cecfbbd20","af2f293f78905ff6dadc68d00651264d1dc0c99e24c9c1505dbe53c8f87dc372","e8460ea13789c006581185c34c4632b025cf11ce06fa33c106450ba10d13dbdc","c0565d30a65f8922380f4dd59c604d833c1bb256b978e35d406efd44293dd5d8","861d5ffacf047aab6d09b2fb973c287bee0eb34eb5f57f89891a8edd51469f2c","28cd955532df5ce9634cebc8011d089b9de741a2b50cae1b5270f928913f2293","3f021863e20c16ae8cf5c68f19570f2856ca4b247ee6fd6cf3b397ae06983d1d","e9ec516e0740cd7e8d0ff7c058890b661f430a8bb08652ddba70fab50a4ece09","5982494bb4bcab2e487c2d760e1d12708fb3442baf1c7e5443b1958d9f37bd73","6920f2c2a2900377419271cd1aa21b3a367aef22ce5a51d3eb0192a8c31bbab7","b165339cea3e139c7ef85bcce3c107df3cde213b2884fd50ceeafeba88758416","7bd543d788711ff2a3fb2975668ceb176481bd2ad924ce8644b3a2200dac0a92","2a85cd0f841de8e8e34d259522306468b0dc9e1299eff5f85beadebf4a80084f","79c79a4257017ee013687710a0453b4378f03d87ddbde39c0673304b1791f80b","a2edcf5934c4b51dd5d5e28dbfafd1293907a4d508cc12f6257d3b7ce25b50bc"],"paragraph_range_zero_based":[9048,9071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p9048"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentContainer","paragraph_zero_based":9072},{"literal_text_all_w_t_and_m_t":"Includes a segment of the encoded DL DCCH message. The size of the included segment in this container should be small enough so the resulting encoded RRC message PDU is less than or equal to the PDCP SDU size limit.","paragraph_zero_based":9073},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentType","paragraph_zero_based":9074},{"literal_text_all_w_t_and_m_t":"Indicates whether the included DL DCCH message segment is the last segment of the message or not.","paragraph_zero_based":9075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9076},{"literal_text_all_w_t_and_m_t":"–DLInformationTransfer","paragraph_zero_based":9077},{"literal_text_all_w_t_and_m_t":"The DLInformationTransfer message is used for the downlink transfer of NAS dedicated information, timing information for the 5G internal system clock, or IAB-DU specific F1-C related information.","paragraph_zero_based":9078},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB2 or SRB1 (only if SRB2 not established yet). If SRB2 is suspended, the network does not send this message until SRB2 is resumed. If only dedicatedInfoF1c is included, SRB2 is used.","paragraph_zero_based":9079},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9080},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9081},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9082},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer message","paragraph_zero_based":9083},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9084},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFER-START","paragraph_zero_based":9085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9086},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer ::=           SEQUENCE {","paragraph_zero_based":9087},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":9088},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":9089},{"literal_text_all_w_t_and_m_t":"        dlInformationTransfer           DLInformationTransfer-IEs,","paragraph_zero_based":9090},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":9091},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":9092},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":9093},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9094},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer-IEs ::=       SEQUENCE {","paragraph_zero_based":9095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["fbeab5c80ad99d874434f5cf3cd4d75a36c31fa8c2e2c92f15a60973f45a0c88","75e44cda6e1abf0df2d9050e6e973ef66cd963483bb5ad199df4a3134f797ab3","973e417496b77e7eed9ba12708e9d064253ec9e0f65d71c77fc63e3e5019b2a4","68bde326202c1a176d3b872bb27bc491752dd3710fc1044cbf19af0088a93cc2","71793b0b2bdcabecd6b8fce94670fa2a9c0cd10c8f12bc9269b64f4f24f19d9b","50b0b0b0eea0923d86fa47f83f063ba9e7b781507bd6d5b2804a3a860c22fee6","f1ce3cf5bb065ae45698748f4ae4e6d3cae6bda1c3fe3bd1e7475c3d4a0d33a1","71afa5f22f17d0a0c48bc6567345252b64b5f97d44598849394488191fcf25b1","0c2999beb06ece6be543142daff21e89c36cf12209451c1b5874a5635a50b997","a65d544f87f03042c4dc5f82e8d2d51fb727fce7d97209c4eb389cabc4b8f199","01acd0233e46