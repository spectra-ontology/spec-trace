{"fields":{"filename":"R2-2312499.zip::R2-2312499_38.331_Rel-18_SL_relay_service_continuity.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":600},{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":601},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":602},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells).","paragraph_zero_based":603},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":604},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":605},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":606},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":607},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":608},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":609},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":610},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToAddModList                     SEQUENCE (SIZE(1..maxLC-ID)) OF RLC-BearerConfig                        OPTIONAL,   -- Need N","paragraph_zero_based":611},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToReleaseList                    SEQUENCE (SIZE(1..maxLC-ID)) OF LogicalChannelIdentity                  OPTIONAL,   -- Need N","paragraph_zero_based":612},{"literal_text_all_w_t_and_m_t":"    mac-CellGroupConfig                        MAC-CellGroupConfig                                              