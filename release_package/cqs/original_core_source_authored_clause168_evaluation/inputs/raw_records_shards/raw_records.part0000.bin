{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to request the numbers of IP address for non-F1 traffic.","paragraph_zero_based":9048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9049},{"literal_text_all_w_t_and_m_t":"IAB-IP-AddressPrefixReq-IEs field descriptions","paragraph_zero_based":9050},{"literal_text_all_w_t_and_m_t":"all-Traffic-PrefixReq","paragraph_zero_based":9051},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for all traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9052},{"literal_text_all_w_t_and_m_t":"f1-C-Traffic-PrefixReq","paragraph_zero_based":9053},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for F1-C traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9054},{"literal_text_all_w_t_and_m_t":"f1-U-Traffic-PrefixReq","paragraph_zero_based":9055},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for F1-U traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9056},{"literal_text_all_w_t_and_m_t":"non-F1-Traffic-PrefixReq","paragraph_zero_based":9057},{"literal_text_all_w_t_and_m_t":"This field is used to request the IPv6 address prefix for non-F1 traffic. The length of allocated IPv6 prefix is fixed to 64.","paragraph_zero_based":9058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9059},{"literal_text_all_w_t_and_m_t":"IAB-IP-AddressAndTraffic-IEs field descriptions","paragraph_zero_based":9060},{"literal_text_all_w_t_and_m_t":"all-Traffic-IAB-IP-Address","paragraph_zero_based":9061},{"literal_text_all_w_t_and_m_t":"This field is used to report to IAB-donor-CU the IP address(es) or IPv6 address prefix for all traffic.","paragraph_zero_bas