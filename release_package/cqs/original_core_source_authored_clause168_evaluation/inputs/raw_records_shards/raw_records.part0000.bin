{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39480},{"literal_text_all_w_t_and_m_t":"–SL-SDAP-Config","paragraph_zero_based":39481},{"literal_text_all_w_t_and_m_t":"The IE SL-SDAP-Config is used to set the configurable SDAP parameters for a Sidelink DRB.","paragraph_zero_based":39482},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config information element","paragraph_zero_based":39483},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39484},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-START","paragraph_zero_based":39485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39486},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config-r16 ::=                  SEQUENCE {","paragraph_zero_based":39487},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Header-r16                      ENUMERATED {present, absent},","paragraph_zero_based":39488},{"literal_text_all_w_t_and_m_t":"    sl-DefaultRB-r16                        BOOLEAN,","paragraph_zero_based":39489},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-Flows-r16                  CHOICE {","paragraph_zero_based":39490},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsList-r16              SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16,","paragraph_zero_based":39491},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsListDedicated-r16     SL-MappedQoS-FlowsListDedicated-r16","paragraph_zero_based":39492},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":39493},{"literal_text_all_w_t_and_m_t":"    sl-CastType-r16                        ENUMERATED {broadcast, groupcast, unicast, spare1}                   OPTIONAL,   -- Need M","paragraph_zero_based":39494},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":39495},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39496},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39497},{"literal_text_all_w_t_and_m_t":"SL-MappedQoS-FlowsListDedicated-r16 ::= SEQUENCE {","paragraph_zero_based":39498},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToAddList-r16         SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":39499},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-FlowsToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-FlowIdentity-r16  OPTIONAL     -- Need N","paragraph_zero_based":39500},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":39501},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39502},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-STOP","paragraph_zero_based":39503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4335befcfc287b49532887a803223ddec7ea98a3e1d47d27c52853f6a6cf06da","5f0de0ea6546644a0b2feda2b61c773705edcbd6d0dc7bdc013a06627a7608b2","93fca8c0e2a3d0c7b291ae508fadbcfc2674074052378da8da2753daed302d9d","f65fbd91c32cfc1134f23daf52e7985ee88715c289a90c366af8ca2e31e6db4e","db21cdcb1dd8cfd1836d3a3d745b435c39e76e8a720c4d81d37e38556661afdc","e99390b97d1d6f1db75a06e0eb34ee909fa3f93da69fa330dfb04723645ed544","4848a40fa8f0eae80789ddc35a3bc7df8c31a90f5a9ccbe32c968db783c7a778","804dd2811299d82cc0f04371d35c1f8ae582e65b838730596aad22a4ae2696fc","66d1b9cc47ef13a3fdaee0c808e82524be958111344238670ff5392b4cc4627e","66a393193165ce23c1efd89f44955c1796f27b43372a8f839f4ab001c7183fb8","b8e425c7851dd19cf1473f2323be82ec8cd36ee1667aa633968df4a8460f8a9c","5106f3feacb3811aa081f0ddd0d61477014730fef3e9dfed667a36ac4ff3d371","ffa38a6d923a01239bedcbb83a82539d96c7524783ade8856a2c2ae9e6e58f74","de14a469fae46aa0c72ba8efb26676e032a23a968920f01de1f064c6b2dcc939","3ad4b8cf792140b269da700720b9239481c23cd6ecf462f697d234afbe2fbd1c","bd8093e82c54244583277a633184efac564205a6360f782f08dc5c7bdc0906f6","ff44a4173bf4f27db0a3926d97ec88b922de036a3a6b10365ad5bdbe2c9c5585","330bb70b4aaf2b4d6b029f34a42a86d08203b13790a8e6b515c2a497ccf399eb","151a7d68e7f69ba4e7643acfc1618134f7ec233429a4a9753c8a706107437d54","3bd0f3ceef990e034362f2d1ffd2caabc93bc2f11019769176cd5c523f53f0a1","34fe4ba67103533e177209c0dabefb01061bb72c8741782476f81e665c835433","948bc24e7b79ff1f080d98c97b5ce2d8b3fd0f3682d42b71c17e12f0ec7cb6e7","419d8e9dfb8c12aeeb1bd0d6dd546ef585299cb4e1c420ff4129a867156c5a28","9eab9a7df319ea300bbee807cfb09df83693127901b83f433bfba7fc8b133628"],"paragraph_range_zero_based":[39480,39503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p39480"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39505},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config field descriptions","paragraph_zero_based":39506},{"literal_text_all_w_t_and_m_t":"sl-DefaultRB","paragraph_zero_based":39507},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default sidelink DRB for this NR sidelink communication transmission destination. Among all configured instances of SL-SDAP-Config for this destination, this field shall be set to true in at most one instance of SL-SDAP-Config and to false in all other instances.","paragraph_zero_based":39508},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-Flows","paragraph_zero_based":39509},{"literal_text_all_w_t_and_m_t":"Indicates QoS flows to be mapped to the sidelink DRB. If the field is included in dedicated signalling, it is set to sl-MappedQoS-FlowsListDedicated; otherwise, it is set to sl-MappedQoS-FlowsList.","paragraph_zero_based":39510},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsList","paragraph_zero_based":39511},{"literal_text_all_w_t_and_m_t":"Indicates the list of QoS profiles of the NR sidelink communication transmission destination mapped to this sidelink DRB.","paragraph_zero_based":39512},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToAddList","paragraph_zero_based":39513},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be additionally mapped to this sidelink DRB.","paragraph_zero_based":39514},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":39515},{"literal_text_all_w_t_and_m_t":"Indicates the list of SL QoS flows ID of the NR sidelink communication transmission destination to be released from existing QoS flow to SLRB mapping of this sidelink DRB. ","paragraph_zero_based":39516},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":39517},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB. The field cannot be changed after a sidelink DRB is established. This field is set to present if the field sl-DefaultRB is set to true.","paragraph_zero_based":39518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39519},{"literal_text_all_w_t_and_m_t":"–SL-ServingCellInfo","paragraph_zero_based":39520},{"literal_text_all_w_t_and_m_t":"The IE SL-ServingCellInfo is used to indicate the L2 U2N Relay UE's PCell/camping cell, which is considered as PCell/camping cell by the L2 U2N Remote UEs connecting with this L2 U2N Relay UE.","paragraph_zero_based":39521},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo information element","paragraph_zero_based":39522},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39523},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SERVINGCELLINFO-START","paragraph_zero_based":39524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39525},{"literal_text_all_w_t_and_m_t":"SL-ServingCellInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":39526},{"literal_text_all_w_t_and_m_t":"    sl-PhysCellId-r17              PhysCellId,","paragraph_zero_based":39527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["1eb692b24f930199a8ff2806147fc4921104fc5ee276358af5349bb9c4a0eeb2","08ce9209637de63158316bca0b8b428dd48c5819c0f6db8628aa7ccc4e2f276a","bc05e6ebb210555b2538b1b58dd8f990b1b0d25c161d339b0e3aeb1fca02cee8","088a830420fdc27502e0c