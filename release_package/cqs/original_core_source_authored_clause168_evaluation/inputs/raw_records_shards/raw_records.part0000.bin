{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCResume-IEs ::=                   SEQUENCE {","paragraph_zero_based":10680},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                   RadioBearerConfig                                               OPTIONAL, -- Need M","paragraph_zero_based":10681},{"literal_text_all_w_t_and_m_t":"    masterCellGroup                     OCTET STRING (CONTAINING CellGroupConfig)                       OPTIONAL, -- Need M","paragraph_zero_based":10682},{"literal_text_all_w_t_and_m_t":"    measConfig                          MeasConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":10683},{"literal_text_all_w_t_and_m_t":"    fullConfig                          ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10684},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                    OPTIONAL,","paragraph_zero_based":10685},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1560-IEs                                             OPTIONAL","paragraph_zero_based":10686},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10687},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10688},{"literal_text_all_w_t_and_m_t":"RRCResume-v1560-IEs ::=             SEQUENCE {","paragraph_zero_based":10689},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig2                  OCTET STRING (CONTAINING RadioBearerConfig)                     OPTIONAL, -- Need M","paragraph_zero_based":10690},{"literal_text_all_w_t_and_m_t":"    sk-Counter                          SK-Counter                                                      OPTIONAL, -- Need N","paragraph_zero_based":10691},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1610-IEs                                             OPTIONAL","paragraph_zero_based":10692},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10694},{"literal_text_all_w_t_and_m_t":"RRCResume-v1610-IEs ::=             SEQUENCE {","paragraph_zero_based":10695},{"literal_text_all_w_t_and_m_t":"    idleModeMeasurementReq-r16          ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10696},{"literal_text_all_w_t_and_m_t":"    restoreMCG-SCells-r16               ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10697},{"literal_text_all_w_t_and_m_t":"    restoreSCG-r16                      ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":10698},{"literal_text_all_w_t_and_m_t":"    mrdc-SecondaryCellGroup-r16         CHOICE {","paragraph_zero_based":10699},{"literal_text_all_w_t_and_m_t":"        nr-SCG-r16                          OCTET STRING (CONTAINING RRCReconfiguration),","paragraph_zero_based":10700},{"literal_text_all_w_t_and_m_t":"        eutra-SCG-r16                       OCTET STRING","paragraph_zero_based":10701},{"literal_text_all_w_t_and_m_t":"    }                                                                                                   OPTIONAL, -- Cond RestoreSCG","paragraph_zero_based":10702},{"literal_text_all_w_t_and_m_t":"    needForGapsConfigNR-r16             SetupRelease {NeedForGapsConfigNR-r16}                          OPTIONAL, -- Need M","paragraph_zero_based":10703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_m