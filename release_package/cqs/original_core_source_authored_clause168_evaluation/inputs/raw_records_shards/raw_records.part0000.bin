{"fields":{"filename":"R2-2306676.zip::R2-2306676_(Misc LPP corrections).docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1776},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-BeamInfo-r17NR-DL-PRS-BeamInfo-r16OPTIONAL,-- Cond UEA","paragraph_zero_based":1777},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-r17","paragraph_zero_based":1778},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Configurations-r17","paragraph_zero_based":1779},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Need ON","paragraph_zero_based":1780},{"literal_text_all_w_t_and_m_t":"nr-On-Demand-DL-PRS-Configurations-Selected-IndexList-r17","paragraph_zero_based":1781},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Configurations-Selected-IndexList-r17","paragraph_zero_based":1782},{"literal_text_all_w_t_and_m_t":"OPTIONAL,-- Need ON","paragraph_zero_based":1783},{"literal_text_all_w_t_and_m_t":"assistanceDataValidityArea-r17AreaID-CellList-r17OPTIONAL-- Need ON","paragraph_zero_based":1784},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1785},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1787},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1789},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":1790},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":1791},{"literal_text_all_w_t_and_m_t":"UEB","paragraph_zero_based":1792},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, for UE based NR DL-AoD; otherwise it is not present.","paragraph_zero_based":1793},{"literal_text_all_w_t_and_m_t":"UEA","paragraph_zero_based":1794},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, for UE-assisted NR DL-AoD; otherwise it is not present.","paragraph_zero_based":1795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1796},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-ProvideAssistanceData field descriptions","paragraph_zero_based":1797},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-AssistanceData","paragraph_zero_based":1798},{"literal_text_all_w_t_and_m_t":"This field specifies the assistance data reference and neighbour TRPs and provides the DL-PRS configuration for the TRPs.","paragraph_zero_based":1799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e4e44ee677ed4051201972f11f51bb54396e91b31bb2136139e5ab06d90870d5","original_member_sha256":"7e17bac3b5b722159fad6bbbdc973ced135f72f2a32bb2bedf6473afad53255e","paragraph_ElementTree_utf8_XML_sha256":["deb686a46d4639fa4e6d2c33e5fdba7c7af6b7a5a699609e07cf3749793b35f0","a6684125819f335fa800cec7e47333a220669a24f32e2628620d96d8a44e01a6","97abb926b1376c495ff616467cddb674c520b3c5d474963f8f81fa746e60bf2f","59e898954629a2f50dc308c91eabdfd5d5c5b469a6d358589f195ad0332a71d6","7f6bda8be02c2d08bae4b90b91bdb6d8cef6651fbc2473019bc31420e862eadb","394dee7d2c237e6562354da9bf894da49afbfc56cf65529c0dcec08b690f8643","f2bd1c3d6dfce9f5aaecda0dae085e62e205abfbf8530e36d56d707772012cc2","14ad5e9ce1861b36ab8954ede6582ceeccb9b802b596bbe37a6e437bde3358ad","39d8f29d32ed7702bcd4da39400cc39cd2fe074136a8f090c17051147bcdc2bf","f0626d7ff1d8d54e3ca7e3b11e09c8ac2a28f2ad549df30bbde7de711755b60f","f54fe64d05f6127c58c24da5cdd7482fd2895ba5e6bc15a0f6d7a6994b64829a","21648f290823abdf933330584cc814fe3899d09e1791bfc4ddfe143a1c004658","283da7ea73141b0b996bc2b906f5b78c0ea8114961268bb1743613ab04fa9ee5","afbc00ed1763d29b686c3f782348e348374b9c7c3da7f5db747d15711d2e464e","df6be1fffa785d13cf3b87fabddf0e8df7195c0d992ec28fcd093f7ab2b33132","44d5ee2714ebb44e6578d68b2bd22e702c52ea1183c48346f9c9232e7b3e56c1","1e48f4642653233072829ff02489ed4705f75e5f285f059bc3a62aa85291f85a","1e9