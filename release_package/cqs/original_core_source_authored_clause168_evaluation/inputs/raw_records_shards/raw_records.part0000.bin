{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DL-PRS periodicity in dl-PRS-Periodicity-and-ResourceSetSlotOffset, dl-PRS-ResourceRepetitionFactor, dl-PRS-NumSymbols, comb-size in dl-PRS-CombSizeN-AndReOffset, dl-PRS-QCL-Info.","paragraph_zero_based":2352},{"literal_text_all_w_t_and_m_t":"The target device shall ignore the remaining fields in IE NR-DL-PRS-Info.","paragraph_zero_based":2353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2354},{"literal_text_all_w_t_and_m_t":"–NR-On-Demand-DL-PRS-Information","paragraph_zero_based":2355},{"literal_text_all_w_t_and_m_t":"The IE NR-On-Demand-DL-PRS-Information defines the requested on-demand DL-PRS.","paragraph_zero_based":2356},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2357},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2358},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-Information-r17 ::= SEQUENCE (SIZE (1..nrMaxFreqLayers-r16)) OF","paragraph_zero_based":2359},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-PerFreqLayer-r17","paragraph_zero_based":2360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2361},{"literal_text_all_w_t_and_m_t":"NR-On-Demand-DL-PRS-PerFreqLayer-r17 ::= SEQUENCE {","paragraph_zero_based":2362},{"literal_text_all_w_t_and_m_t":"dl-prs-FrequencyRangeReq-r17ENUMERATED { fr1, fr2, ...},","paragraph_zero_based":2363},{"literal_text_all_w_t_and_m_t":"dl-prs-ResourceSetPeriodicityReq-r17ENUMERATED { p4, p5, p8, p10, p16, p20, p32, p40,","paragraph_zero_based":2364},{"literal_text_all_w_t_and_m_t":"p64, p80, p160, p320, p640, p1280, p2560,","paragraph_zero_based":2365},{"literal_text_all_w_t_and_m_t":"p5120, p10240, p20480, p40960, p81920, ...}","paragraph_zero_based":2366},{"literal_text_all_w_t_and_m_t":"OPTIONAL,","paragraph_zero_based":2367},{"literal_text_al