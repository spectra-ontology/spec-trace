{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29088},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29090},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-STOP","paragraph_zero_based":29091},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29093},{"literal_text_all_w_t_and_m_t":"SRS-Config field descriptions","paragraph_zero_based":29094},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":29095},{"literal_text_all_w_t_and_m_t":"If the field is absent, UE applies TPC commands via accumulation. If disabled, UE applies the TPC command without accumulation (this applies to SRS when a separate closed loop is configured for SRS) (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29096},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29097},{"literal_text_all_w_t_and_m_t":"SRS-Resource, SRS-PosResource field descriptions","paragraph_zero_based":29098},{"literal_text_all_w_t_and_m_t":"cyclicShift-n2","paragraph_zero_based":29099},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29100},{"literal_text_all_w_t_and_m_t":"cyclicShift-n4","paragraph_zero_based":29101},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29102},{"literal_text_all_w_t_and_m_t":"cyclicShift-n8","paragraph_zero_based":29103},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29104},{"literal_text_all_w_t_and_m_t":"enableStartRBHopping","paragraph_zero_based":29105},{"literal_text_all_w_t_and_m_t":"When this RRC parameter is configured, start RB location hopping is enabled for partial frequency sounding in different SRS frequency hopping periods for periodic/semi-persistent/aperiodic SRS as described in Clause 6.4.1.4 in TS 38.211.","paragraph_zero_based":29106},{"literal_text_all_w_t_and_m_t":"freqHopping","paragraph_zero_based":29107},{"literal_text_all_w_t_and_m_t":"Includes parameters capturing SRS frequency hopping (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, the network always configures this field such that b-hop > b-SRS.","paragraph_zero_based":29108},{"literal_text_all_w_t_and_m_t":"groupOrSequenceHopping","paragraph_zero_based":29109},{"literal_text_all_w_t_and_m_t":"Parameter(s) for configuring group or sequence hopping (see TS 38.211 [16], clause  6.4.1.4.2). For CLI SRS-RSRP measurement, the network always configures this parameter to 'neither'.","paragraph_zero_based":29110},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports","paragraph_zero_based":29111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["aca392781d73c0cb59ea8397514527060ad8c89b888d249dc6f060f733d8dc26","6b6c8f81df53b2d4ad623bd5557f89e855329313559d7a316570d22c7d9846ff","bbf58770e01a084c982b02874833c4c30dc83d7c1e4a1177440d8bf285f59451","f4625629bcddd03f78e7aa9d0d030f4062421b36e09a56be6434487d210ca347","4444c49baa031f4f11f544575bc463421ba692a3d5927c12719c195387fd6bed","34001d1ba75cd65f8efa0f358e40c1e657a0d9e29bcc33e9741b052dbcdd0fb2","005aca2b1f2e0329319cd318c29afd6364386de79bbc2a21616c17cd65be1782","d86b5d6a8571fa68afcc92681131c49fb788595576170c27b778c2f9a298ada1","c27f092ea654ad2b4a80e44ca6d871f45ec4679dfde1de34cab93be6d3b55fe5","7b821e313e04793855ed9e4b8635aaeea9af8594114cbde03a87828b7a47cb6d","860de408df2bc3ff7cc20d7afbc911afb0aaf9560e9eeab89a1038a203052ed1","25e640cf1981833250154c951f66323ef62025ffad7eec969640eb4e66b6a75e","35034c36271185b974a1eb888c810b0a88546a7f784feb1ef49491f98fd08295","1dcf3f990ce3e6ac11a1d3c8b3f7a7d95a23d531cb6e9aa27a7b573d16abfea1","ba2201d46bb3ed0957252f48b46995533e2a9a0eee31b46d20adae43afb80c23","aa39d767a93458a8d832d8987d4bbc63caf695437bb64d4b609d35251d303af4","c315ba66b74d8f5dc8222a275840c0356e6aa10d568a28a21b869a56077651e9","49e9f0c913923a6f29209315bfb5e6f7011678476d1e5d252f03a204b6eaa826","9f530bccc8d666ba5230b59f2ab8a13fb9733591b0a26ef2d84e57d52696b9c7","b2d1aa6af85f124fd8b849cbc922eb9b3e07a898ce2a6e3e840158145510f69c","124e7b0e68f7e71dcc65a4dc51ebf9b23e2d5b908d5099b9463013adf7dcc463","3bd285ffeecb5d621d5a5d4b45970e51a4ee86f24df722d6dbec29a29fa6bfd9","569ab0340cadb89fa84078ea53289547f145e3edd42c0e9e30f59ef1aac868f9","58bffb90f9b3a8f71512872419afaa0028ff6e2e8d5c7771cebaff6e1315a7ae"],"paragraph_range_zero_based":[29088,29111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29088"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of ports. For CLI SRS-RSRP measurement, the network always configures this parameter to 'port1'.","paragraph_zero_based":29112},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-p, periodicityAndOffset-p-Ext","paragraph_zero_based":29113},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, sl1280 and sl2560 cannot be configured. For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":29114},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-p-Ext is present, periodicityAndOffset-p shall be ignored by the UE.","paragraph_zero_based":29115},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-sp, periodicityAndOffset-sp-Ext","paragraph_zero_based":29116},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":29117},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-sp-Ext is present, periodicityAndOffset-sp shall be ignored by the UE.","paragraph_zero_based":29118},{"literal_text_all_w_t_and_m_t":"ptrs-PortIndex","paragraph_zero_based":29119},{"literal_text_all_w_t_and_m_t":"The PTRS port index for this SRS resource for non-codebook based UL MIMO. This is only applicable when the corresponding PTRS-UplinkConfig is set to CP-OFDM. The ptrs-PortIndex configured here must be smaller than the maxNrofPorts configured in the PTRS-UplinkConfig (see TS 38.214 [19], clause 6.2.3.1). This parameter is not applicable to CLI SRS-RSRP measurement.","paragraph_zero_based":29120},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":29121},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the SRS resource within a slot including nrofSymbols (number of OFDM symbols), startPosition (value 0 refers to the last symbol, value 1 refers to the second last symbol, and so on) and repetitionFactor (see TS 38.214 [19], clause 6.2.1 and TS 38.211 [16], clause 6.4.1.4). The configured SRS resource does not exceed the slot boundary. If resourceMapping-r16 is signalled, UE shall ignore the resourceMapping (without suffix). If resourceMapping-r17 is signalled, resourceMapping-r16 is not signalled and the UE shall ignore the resourceMapping (without suffix) and only the values of nrofSymbols which are integer multiples of the configured repetitionFactor can be configured. The network can only signal repetitionFactor-v1730 if resourceMapping-r17 is signalled. When repetitionFactor-v1730 is signalled, the UE shall ignore repetitionFactor-r17. For CLI SRS-RSRP measurement, the network always configures nrofSymbols and repetitionFactor to 'n1'.","paragraph_zero_based":29122},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":29123},{"literal_text_all_w_t_and_m_t":"Periodicity and offset for semi-persistent and periodic SRS resource, or slot offset for aperiodic SRS resource for positioning (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, only 'periodic' is applicable for resourceType.","paragraph_zero_based":29124},{"literal_text_all_w_t_and_m_t":"sequenceId","paragraph_zero_based":29125},{"literal_text_all_w_t_and_m_t":"Sequence ID used to initialize pseudo random group and sequence hopping (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29126},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo","paragraph_zero_based":29127},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS (see TS 38.214 [19], clause 6.2.1). This parameter is not applicable to CLI SRS-RSRP measurement. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":29128},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo-PDC","paragraph_zero_based":29129},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS-PDC (see TS 38.214 [19], clause 6.2.1). The field is present in case of resourceType=periodic and usagePDC-r17=true in the SRS-ResourceSet, otherwise the field is absent.","paragraph_zero_based":29130},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoPos","paragraph_zero_based":29131},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29132},{"literal_text_all_w_t_and_m_t":"If the IE srs-ResourceId-Ext is present, the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 63. Otherwise the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 31.","paragraph_zero_based":29133},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-0-2","paragraph_zero_based":29134},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\"in DCI format 0_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 0_2 is applied. If the parameter srs-RequestDCI-0-2 is configured to value 1, 1 bit is used to indicate one of the first two rows of Table 7.3.1.1.2-24 in TS 38.212 [17] for triggered aperiodic SRS resource set. If the value 2 is configured, 2 bits are used to indicate one of the rows of Table 7.3.1.1.2-24 in TS 38.212 [17]. When UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication.","paragraph_zero_based":29135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7c5ee51a3bc8a31e414257a2bb4365861b6e8035967b2d87fab8f357695f36fc","fc3ed47085854f89befb326d5c38abeaf2b4ba8d2a62a899695a4a0961d23d00","f18b042b1901b0fa1485ecc428891c93783cc97eb9fce8be251ee836f068cfd9","9ada003b2efcdefce21ddcb27e9f3d3f81ea7b1514319b5190c6b8e515fc487c","973f914f209c21bdabf3d843d2118c51c5569a030ddaa4459dd14113af77e3a3","db296d2e6051e1b59064d77e017a0aac2c93c2c0f2cc6c2c2ebffedb0d7ca4c5","39e145d486af179b344ab14ceb352f079ec3d684aed97f13d93841537ea201f8","f929d2f2c98f9d006489f99971b251853f5aa79d5995a12d14eb84db5a1b2a66","2867ac175bc06647478d20ef979839e3df6c8f6c3fe5d0d576f51c11da1333b2","b1ba3d85d7d8da720b4bdf293b078cc3cab8c919bbbba9e7982ba352e0f6a77e","4033435f64850475fd133546a3c4dfe48934106db89b01d3390825c9c77458d5","141008c0d7b8064d27462ede0417c56ceafb26889cd9a2c9143f2040fd933df9","a9fd6aca96c700be2431926b4def764ddde287a4ea1e1c38e1c3a415442b7851","55ccee19266dda4422fa84cdc7a39453987a53890fbb0b22f11f0f77e52fd379","96d3ff3721c7fa9606c61ee808651e1d6870141013915d367997d21c8a4b8380","6760d79d5856635d61385cbedfaf9ff7439a4aba82b46ed8f25396183737bb05","a5bc3efdbe5ed1547c09087cbc74ecbfdd4e2832e8db3956e16d916a2b6e51f6","dfb2a54569fcb84086e9b27352b555bd23f39035e26fde6fd6face6aee340962","c04a23ab394de73a613f9f4ad9a7c10d5084eb78a401129d18d55cc69a2b4fe9","9a67c2be698195dd9a5251d48cf04f14fcce7fa77e20420e3246d2c1d02dae3a","ff7d644d764f2320f3329fc2e9f6d6c149275ed987c3c7329697d638f102a482","3a27847298cbc233bf889a50117521dfe283577200e074e9ce11f55ab759b06f","8b54b2faa827a1b690f02cda0111f1e307a8db364eddca4ce2e1af7c1b767f39","20a2f5223165623910b2c5e4dc4a294e1bf5b364acd9d08d8145b48a16161623"],"paragraph_range_zero_based":[29112,29135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29112"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-1-2","paragraph_zero_based":29136},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\" in DCI format 1_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 1_2 is applied. When the UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29137},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToAddModListDCI-0-2","paragraph_zero_based":29138},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be added or modified for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29139},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToReleaseListDCI-0-2","paragraph_zero_based":29140},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be released for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29141},{"literal_text_all_w_t_and_m_t":"srs-TCI-State","paragraph_zero_based":29142},{"literal_text_all_w_t_and_m_t":"Configuration of either a UL TCI state or a joint TCI state for the SRS resource. In case of UL TCI-State, refers to the TCI state defined in ul-TCI-StateList in the BWP-UplinkDedicated where the SRS-Config is configured. In case of joint TCI state, refers to a TCI state defined in dl-OrJointTCI-StateList in pdsch-Config of the BWP-DownlinkDedicated and serving cell indicated by cellAndBWP. This field is absent when the SRS resource is in an SRS-ResourceSet configured with followUnifiedTCI-StateSRS-r17 or when the field unifiedTCI-StateType is not configured to the serving cell which the SRS resource is located in.","paragraph_zero_based":29143},{"literal_text_all_w_t_and_m_t":"startRBIndexAndFreqScalingFactor","paragraph_zero_based":29144},{"literal_text_all_w_t_and_m_t":"Configures the UE with the startRBIndex and freqScalingFactor for partial frequency sounding as described in Clause 6.4.1.4 in TS 38.211. The startRBIndexForFScaling2 gives the startRBIndex when freqScalingFactor is 2 and the startRBIndexForFScaling4 gives the startRBIndex when FreqScalingFactor is 4 ","paragraph_zero_based":29145},{"literal_text_all_w_t_and_m_t":"transmissionComb, transmissionComb-n8","paragraph_zero_based":29146},{"literal_text_all_w_t_and_m_t":"Comb value (2 or 4 or 8) and comb offset (0..combValue-1) (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":29147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29148},{"literal_text_all_w_t_and_m_t":"SRS-ResourceSet, SRS-PosResourceSet field descriptions","paragraph_zero_based":29149},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":29150},{"literal_text_all_w_t_and_m_t":"alpha value for SRS power control (see TS 38.213 [13], clause 7.3). When the field is absent the UE applies the value 1.","paragraph_zero_based":29151},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTriggerList","paragraph_zero_based":29152},{"literal_text_all_w_t_and_m_t":"An additional list of DCI \"code points\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6). When the field is not included during a reconfiguration of SRS-ResourceSet of resourceType set to aperiodic, UE maintains this value based on the Need M; that is, this list is not considered as an extension of aperiodicSRS-ResourceTrigger for purpose of applying the general rule for extended list in clause 6.1.3.","paragraph_zero_based":29153},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTrigger","paragraph_zero_based":29154},{"literal_text_all_w_t_and_m_t":"The DCI \"code point\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6).","paragraph_zero_based":29155},{"literal_text_all_w_t_and_m_t":"associatedCSI-RS","paragraph_zero_based":29156},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set in non-codebook based operation (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29157},{"literal_text_all_w_t_and_m_t":"availableSlotOffset","paragraph_zero_based":29158},{"literal_text_all_w_t_and_m_t":"Indicates the number of available slots from slot n+k to the slot where the aperiodic SRS resource set is transmitted, where slot n is the slot with the triggering DCI, and k is the legacy triggering offset (slotOffset, not based on available slot) as described in clause 6.2.1 of TS 38.214 [19].","paragraph_zero_based":29159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["7a7d49b36c23171127f5d21b928778127ae3d5ed6e35e3ecc30db5fa95520d0e","35d75142ae3830d06566ed56b6701d1d11a40df63c17edcc005cef4eba6883e9","99360c87c884d6b141a45d0fac110cab3362466a5eae66abc4bbc920c80db371","9c99c35e109d0679d641a8a1d6cc564942b94bd854d79c88fb20a05994794b94","056d3c528d94422e2103a78135807117e73f9b6d8fb0a09bd41ca9b0492d928b","979491e17726f725c19b9fde4f09afe30251ba7da66dcbc18c4b8b21cff73265","33272da1e471a7ed20e67f37de5552afc65aa0ee0fd618c21d2c2ff2b4ee0728","55d2b214065e3fd1ea9c316981215fff47f90f36872c039983f4074b27c08e18","aac9150fdaff911b4a7aa100705a51bc6e339040585e1efdd176b10e9b6ed1bf","6d6f4ec71ca152497f8c8e5ba7d4b7f4ffac994579391d060e5e2fc1be75cd33","6232292bd8448e47f92401b8297df04bed6496dd14c2d9f8cbfadb7ac4b7b5d0","d3c3361dddff1337617c7e68c937f86d6e94f70895e2384fdae09fd9216c734c","39a36577ca01eff62b082f1f1aa1a2627495ab7389f73ba012a84f9487580a65","229e7ce6f2d16d4f018f1ccd735aa4adffae36348d612aba8e916e45c7244543","f72f6fa31dbaf5c3c5b4a41c94bb96ca9e4d8b2d1ac9b26581cfd501c5b6d032","3f21e03d5e888ddaed57443d74c412ff893519bd30ad649f7106320db62ba9c9","acf1a8e92c511127665141ac6f7e270924282a990cf415707cae668c1d1ea31d","51a699d725d6874260bc060e2a0344dd3a681fe8c2275ad1ca293ab7f9a82bb0","f0105795d7dc4af23ed8523ffc8b149b62744e2d1bcda2a17f88df02e7e65f3f","7bd66d433ae0083397b5148bb3dbbe9953f46d06f99b726d5e86b81e10f5070d","c93964b8e27339d603ff99f53a7528e992b2b47bbf2bf79f86badbae25e07b87","a995fd68fc549042e4a2a25152a4c6fafa64bf20fda77ce8fa753a5d2fdb12c9","cb5493cd86ecc9e43f9a05ae9ad045c2f35d97f18a7b93e27c79c29a62e96f3b","6dd245a7d10dd9fea9e4697082489bf9148b616c54bb5e18b438163c7277b3d3"],"paragraph_range_zero_based":[29136,29159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29136"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":29160},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":29161},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":29162},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":29163},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-StateSRS","paragraph_zero_based":29164},{"literal_text_all_w_t_and_m_t":"When set to enabled, for SRS resource Set, the UE applies the \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5. This parameter may be configured for aperiodic SRS for BM or SRS of any time-domain behavior for codebook, non-codebook, and antenna switching.","paragraph_zero_based":29165},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":29166},{"literal_text_all_w_t_and_m_t":"P0 value for SRS power control. The value is in dBm. Only even values (step size 2) are allowed (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29167},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS","paragraph_zero_based":29168},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a CSI-RS config or a SS block) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29169},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Pos","paragraph_zero_based":29170},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a SS block or a DL-PRS config) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29171},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSList","paragraph_zero_based":29172},{"literal_text_all_w_t_and_m_t":"Multiple candidate pathloss reference RS(s) for SRS power control, where one candidate RS can be mapped to SRS Resource Set via MAC CE (clause 6.1.3.27 in TS 38.321 [3]). The network can only configure this field if pathlossReferenceRS is not configured in the same SRS-ResourceSet.","paragraph_zero_based":29173},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":29174},{"literal_text_all_w_t_and_m_t":"Time domain behavior of SRS resource configuration, see TS 38.214 [19], clause 6.2.1. The network configures SRS resources in the same resource set with the same time domain behavior on periodic, aperiodic and semi-persistent SRS. The aperiodic SRS is not applicable for the UE in RRC_INACTIVE.","paragraph_zero_based":29175},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":29176},{"literal_text_all_w_t_and_m_t":"An offset in number of slots between the triggering DCI and the actual transmission of this SRS-ResourceSet. If the field is absent the UE applies no offset (value 0).","paragraph_zero_based":29177},{"literal_text_all_w_t_and_m_t":"srs-PowerControlAdjustmentStates","paragraph_zero_based":29178},{"literal_text_all_w_t_and_m_t":"Indicates whether hsrs,c(i) = fc(i,1) or hsrs,c(i) = fc(i,2) (if twoPUSCH-PC-AdjustmentStates are configured) or separate close loop is configured for SRS. This parameter is applicable only for Uls on which UE also transmits PUSCH. If absent or release, the UE applies the value sameAs-Fci1 (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":29179},{"literal_text_all_w_t_and_m_t":"srs-ResourceIdList, srs-PosResourceIdList","paragraph_zero_based":29180},{"literal_text_all_w_t_and_m_t":"The IDs of the SRS-Resources/SRS-PosResource used in this SRS-ResourceSet/SRS-PosResourceSet. If this SRS-ResourceSet is configured with usage set to codebook, the srs-ResourceIdList contains at most 2 entries. If this SRS-ResourceSet is configured with usage set to nonCodebook, the srs-ResourceIdList contains at most 4 entries.","paragraph_zero_based":29181},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetId, srs-PosResourceSetId","paragraph_zero_based":29182},{"literal_text_all_w_t_and_m_t":"The ID of this resource set. It is unique in the context of the BWP in which the parent SRS-Config is defined.","paragraph_zero_based":29183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["f5be346a6e3109f4787c4bc253fac78831b5c945a531a2551c6f588c379fd69c","d31b749299f4ba050b7de9cb52bb52c3dd3a8d29edb8011b8ad01349d11b8109","e6a0f4b889729d91053cffcc29e5f82805c2036a1b4b72ad36972679ef1b7382","2def1a2a3d9fbd7f51e4e41237ade10ad3aca95083e951409b5a8f2a5388d716","9b07686c6ffffcb4c646ecbe5129ddca194cb769b4482fd2486433df66a40deb","2662b85ed7ae2bc51d689b58b7235d8b9387358c870367eabd54c543b41b0ced","67c3fa34fa7995e0d61fedb09a20f22d3c65e99c8b717c10dd8d5b418b85c39a","ec13b74fcbc785c98b817295d5c77fea02ee168c9d9b582e5a8743b28ef47a4e","0979c8ba6f945e1a543e7f205ed2c26d3ffb90bcd66434288a1f7d9851433d6e","fa7d0a9b78d328ec0461da3d8ba07f551f670fe87383a89336064277948bcfd4","ef624036d3f5348bb990a04cc188451e116ec52e0a906db6ce7657f668a391a7","b56c70d2cd433db0eaead58e564628ef9ad327f41202536369ad508ef3c32a88","45ff14e37012caf0bc0292514680605e9859e792437785368507a271778ab819","7f9b630f6cd0f432a1158c659a0dfd91117d6c0f07cf972644051e9bf68a33f8","a329c356a4b427f58cac16cc1378246ab3e64e21c95df2eb303a969fbd4be305","aaf083921cfc236e2646fa422da8deac8f84d3cee92809be1ae2e13f81c37ece","af40b97ebd70c9a66386a4254f79a9708e0d87488faa7f14c8a67777e8fa421b","3e430a14a5cd5846535f2c28478c0a1c14e4cb57eee3b9401ca2e78b7cd92d3e","4481016648da704cd00324462cabf30b09564bf76990b3cbbaf71cd56702c602","2bbd829f460c59061fab008a8a58558c74970387b60d763ed9606e5abd0d5564","f872499b4f8bc5e6045e63838616478339a1343dafbcd94e72fa11389fb73005","3780f6dd522e51c167d2f545174703bb647451f886a3d8e239e1814eafa8e383","c865afb25c9271ba3c1c90712be4cfa3ebb6d35fd13dc8a27157e32ad4da8a9b","733c49b1ddbc784b77034533c1bacb178d0695b55c85aed0b78e879fc2db4ca2"],"paragraph_range_zero_based":[29160,29183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29160"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":29184},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell where the SRS is configured.","paragraph_zero_based":29185},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":29186},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":29187},{"literal_text_all_w_t_and_m_t":"usage","paragraph_zero_based":29188},{"literal_text_all_w_t_and_m_t":"Indicates if the SRS resource set is used for beam management, codebook based or non-codebook based transmission or antenna switching. See TS 38.214 [19], clause 6.2.1. Reconfiguration between codebook based and non-codebook based transmission is not supported.","paragraph_zero_based":29189},{"literal_text_all_w_t_and_m_t":"usagePDC","paragraph_zero_based":29190},{"literal_text_all_w_t_and_m_t":"If configured, it indicates that this SRS resource set is used for propagation delay compensation. The field can be present in only one SRS-ResourceSet.","paragraph_zero_based":29191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29192},{"literal_text_all_w_t_and_m_t":"SRS-SpatialRelationInfoPos field descriptions","paragraph_zero_based":29193},{"literal_text_all_w_t_and_m_t":"csi-RS-IndexServing","paragraph_zero_based":29194},{"literal_text_all_w_t_and_m_t":"Indicates CSI-RS index belonging to a serving cell.","paragraph_zero_based":29195},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":29196},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":29197},{"literal_text_all_w_t_and_m_t":"resourceSelection","paragraph_zero_based":29198},{"literal_text_all_w_t_and_m_t":"Indicates whether the configured SRS spatial relation resource is a SRS-Resource or SRS-PosResource.","paragraph_zero_based":29199},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29200},{"literal_text_all_w_t_and_m_t":"The serving Cell ID of the source SSB, CSI-RS, or SRS for the spatial relation of the target SRS resource. If this field is absent the SSB, the CSI-RS, or the SRS is from the same serving cell where the SRS is configured.","paragraph_zero_based":29201},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":29202},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell.","paragraph_zero_based":29203},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":29204},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":29205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29206},{"literal_text_all_w_t_and_m_t":"SSB-InfoNCell field descriptions","paragraph_zero_based":29207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["917d71498cba173cfbae0209970b09d7829526c31c8ab4c2bd80cb8a409407c2","35df948660f4ccc53fad191add1c91541b943f193c9920fbc69eaf93c2457666","14c9c79820e4a1be6b281a88843992dca94b327623430819666a6314ed8a6a98","fd49c520766615767b40ffc9af9f0ee381c5d11752cf937da778642006b10ec4","295148c5f1d46ca482e129f5eb2dbd354880e8765f727747328b5b6d9df48e69","ae35e47a40cb85ab051f5a31a2a2ccfd6ba2c588bb2feed54e5fcb5ba0ed6283","feae6f8dff466608995ab973dcc9bb76fddb5320cee9c96b9d4e92ae0b70e696","84495d5d57199b3ce7aad7099c78bf0898a8ce4e4a63e3a46cdcb79ad5e70eb2","f851239ffeb294ddbdaafd8c0f24176152b1709169ab3fc531c3566832c20bd6","65f85bb1729523d56439b3bd7dcd207751f84d2a3324f84c61f8337bb0927a93","c6551ca60d31fe897134417edeeea75a35eb68b94ee00c25fefaecc0ba785a49","af96a3e6002c6fc469eba7eb96a8b61ca37e7d8506af6761c494c9889a018291","a8d2c1a03cecb71febe8b39f4946b2165759e7c681d3180719e89f8491df16e7","e683fe21d018ea27c45d959a0512ad360224da9cf67ae3f13587106bc4ae6310","3358d1c2c7a754fcf8f32f3b90d7bbc8e126339cde297573a2d92998ca353177","d89e9c35893b834546278e3b6f507aef1c4d1a15fe3ed7824f03a7c45885899f","daafe59f8ae87b2db4d8bcdeff9216eb57b37c3e5b24c0307695dc9c00a656b6","e30e220c6c47a7812b52e4c1307df5684c431f5022a496574c3b39c488c571dd","0ddea3c5a6b669b5c66aa28e989fe265a0d407b0ae1c7b3f81ebf760c1bd845b","90df10505b4c3e8520bb1e650eeb0ca70ad3f0024c5c684cc37b8875e616c0c4","42e211f4c7656a74d5c03a1d915cdae9f9771e6459b786db01b34af2533121bf","6b09b46985f66c68549276fccc914e4f684434855ad820a0a9d4c2eb7d8f77d1","2f97837a0d5224d91f6be35d7503a7c0e1a162f3556648bd5ae5bad3e6631a38","d972a0982f2762a2c312ccf8f379f49279d22bb8bbe3751b468cf62ca380cbd5"],"paragraph_range_zero_based":[29184,29207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29184"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"physicalCellId","paragraph_zero_based":29208},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell ID of the neighbour cell for which SSB configuration is provided.","paragraph_zero_based":29209},{"literal_text_all_w_t_and_m_t":"ssb-IndexNcell","paragraph_zero_based":29210},{"literal_text_all_w_t_and_m_t":"This field specifies the index of the SSB for a neighbour cell. See TS 38.213 [13]. If this field is absent, the UE determines the ssb-IndexNcell of the physicalCellId","paragraph_zero_based":29211},{"literal_text_all_w_t_and_m_t":"based on its SSB measurement from the cell.","paragraph_zero_based":29212},{"literal_text_all_w_t_and_m_t":"ssb-Configuration","paragraph_zero_based":29213},{"literal_text_all_w_t_and_m_t":"This field specifies the full configuration of the SSB. If this field is absent, the UE obtains the configuration for the SSB from nr-SSB-Config received as part of DL-PRS assistance data in LPP, see TS 37.355 [49], by looking up the corresponding SSB configuration using the field physicalCellId.","paragraph_zero_based":29214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29215},{"literal_text_all_w_t_and_m_t":"DL-PRS-Info field descriptions","paragraph_zero_based":29216},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":29217},{"literal_text_all_w_t_and_m_t":"This field specifies the UE specific TRP ID (see TS 37.355 [49]) for which PRS configuration is provided. ","paragraph_zero_based":29218},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSetId","paragraph_zero_based":29219},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-ResourceSet ID of a PRS resourceSet.","paragraph_zero_based":29220},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceId","paragraph_zero_based":29221},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-Resource ID of a PRS resource. If this field is absent, the UE determines the dl-PRS-ResourceID based on its PRS measurement from the TRP (see TS 37.355 [49]) and DL-PRS Resource Set.","paragraph_zero_based":29222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29223},{"literal_text_all_w_t_and_m_t":"SSB-Configuration field descriptions","paragraph_zero_based":29224},{"literal_text_all_w_t_and_m_t":"halfFrameIndex","paragraph_zero_based":29225},{"literal_text_all_w_t_and_m_t":"Indicates whether SSB is in the first half or the second half of the frame. Value zero indicates the first half and value 1 indicates the second half.","paragraph_zero_based":29226},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset","paragraph_zero_based":29227},{"literal_text_all_w_t_and_m_t":"Indicates the subframe boundary offset of the cell in which SSB is transmited.","paragraph_zero_based":29228},{"literal_text_all_w_t_and_m_t":"sfn0-Offset","paragraph_zero_based":29229},{"literal_text_all_w_t_and_m_t":"Indiactes the time offset of the SFN0 slot 0 for the cell with respect to SFN0 slot 0 of serving cell.","paragraph_zero_based":29230},{"literal_text_all_w_t_and_m_t":"sfn-Offset","paragraph_zero_based":29231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["726d8a23f6ce34e2e088bec6d1eb750b145c6e1d6cf587e44376081171f4e1c5","e685abd86da24772407f02deb6fc9423f2251a80f7ddb025fd1e59bb29797b1c","f7319ae838bfeb2f6cf9f84a96db2c37af20e4b4185d7ef6c822ca899430eb31","7f29413b84fa88e5deae382f1c5be7a292aecc695a3b8605620b8265a101121e","85a89b62c897c883299706f3893de3239f1be3446321acd51b34dc3982111bd5","12dd667f6349b3aa26387ecb1170cfc7415fd32929ce6731f112bf91b489ac67","cabf83fa38fda238b41979f68d0530f72301083b72b77e4cc9449c9bda124358","5103b1ef82a8ff7037d316bb46cc3e5a1849324a3f7bf0b487382071b7af5b7e","68f8515674348350e824af099b46ca91e7b6adad5607a9a51387fdb558da921e","559a38f26cc6d08aa6d5da26ee5b8b24493449b504f7f5417f17d4c4811b2a5a","0937538e2d3e7f719608daaf2ef8f7f49e2bf9c565d340c35df1b2202e525662","d06695a80590bf051ac9a30fc5deb9f1da0bcd7ab3a40459bcef4526cda3ebd0","e826fbbf53d287e66400d726e3db0e6b3fbbc3ada0391ba3e5fe76e457721ab8","1fa652d50e54ed782d15133cadcf7ebdf4d49cff09bc1ba7fa71be20665c7a92","e5f545f3ba103de378aa82262145bb7024413d3fd84ed22dea244e5671407ee4","d1b7c548f5dfc3b708ce2e9832f6ff5920c9bfc6bf130ab3415e5043ece58d8d","cc18752dfd41a0db702e92283d33b293437b3114efd376c825077255e67342c0","ce0d5fa0165955067a5fcf8452e09ecdd72b32486de283c28c4b02849ee66955","12bcd14bb02d09411d757447c399d8043fd9caca827906680454c94472d50a18","3c52a43bfda27208581dd33d9cda2b91210eb1fb95999dc6fc8f61dfcf0edbae","40a6407dcaec7c7e422ceb9b65fc31c8aea504fb1b33b488cca473262eb718eb","a99abff40f48d81ee0d23e83d6a946f00642d5de99a10155e7cfe4a733a7f9de","796e2c7acf65878833d614e031b161d085639b2dfb3af23074cae4034264e695","75cf27b59203eb28b81068e57f2dd9aad5b2c22c1ada63dda7a0c3749bf49ccd"],"paragraph_range_zero_based":[29208,29231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29208"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Specifies the SFN offset between the cell in which SSB is transmited and serving cell. The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of serving cell to the beginning of the closest subsequent radio frame #0 of the cell in which SSB is transmitted.","paragraph_zero_based":29232},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset","paragraph_zero_based":29233},{"literal_text_all_w_t_and_m_t":"Indicates the SFN offset of the transmitted SSB relative to the start of the SSB period. Value 0 indicates that the SSB is transmitted in the first system frame, value 1 indicates that SSB is transmitted in the second system frame and so on. The network configures this field according to the field ssb-Periodicity such that the indicated system frame does not exceed the configured SSB periodicity.","paragraph_zero_based":29234},{"literal_text_all_w_t_and_m_t":"ssb-Freq","paragraph_zero_based":29235},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the SSB.","paragraph_zero_based":29236},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":29237},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":29238},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":29239},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the SSB. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":29240},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":29241},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":29242},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":29243},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":29244},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":29245},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":29246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29247},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29248},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29249},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":29250},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon configuration of SRS-ResourceSet or SRS-Resource and optionally present, Need M, otherwise.","paragraph_zero_based":29251},{"literal_text_all_w_t_and_m_t":"NonCodebook","paragraph_zero_based":29252},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in case of non-codebook based transmission, otherwise the field is absent.","paragraph_zero_based":29253},{"literal_text_all_w_t_and_m_t":"Pathloss","paragraph_zero_based":29254},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE SSB-InfoNcell is included in pathlossReferenceRS-Pos; otherwise it is optionally present, Need R","paragraph_zero_based":29255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d47379eb7ca7748c6e1040a2689aa091494faf4c879641037c657972152fe294","31cd853b8c40688c67620b2df8332d90f86bc2d88e68a1ad3c76116a8679a52f","a6b89058d344356394808d39cff23a719c0ac2eb3d1219f8109e3ff146005bf3","0ef6697d051a7de036d74cb93cc3a1003eac3da51e95595fd32d41aefe46fb90","59c65def19b5e0bfbd0e0d809e07b30978a005f76766d8c1c4665e9bcd533550","37b2933e608872715f5e007121fe98c6e81dcecfedc6993fc1e28d87492581a5","05d19cc65cf061e82af1e6d971ecf46255db09e16a60401c5bcbc5659fa07895","0d2189f6561c1e07a2dd3a154d96654bbf70a45d14c7a9e0e6363da83557bc5c","348f67b7f355fad0c6518312cb1a1db98b658f05b67e05ad20558cc2b211f910","a5442f5ac463df92cb3a319f90abfafeb8ada2cfdccee3fd53033009999a4215","73ffa68c2c3cbb05ae9d3eaf44d8a872b65bd60fd512af7fcd2d1f332296f25c","96cdb346271c064f0e86f84101f9dfe1cd3d5b882f5283e4eaa41e3ff1955bdd","758f8eeb363707688e1234133d494d019335f3e6870c0788dd830a85dd0b2dc5","f672d2a8d6937acaee0321c6aaf089a27d56ded3af3991951d5ba1e120ef0e6c","1b728106b3c655d82675a43f55453ed408122529dd9914abdc8703ed52810618","2bad8b790a4a2ea992f7d0f9b422c60099c95212d28a82e0c70561713b1c22ec","ec617bc0e9738de532db2b4abb7cf76f4dadd325520b095787f5bfffd84af0c7","05cbcb5cb0c9d48fd2c1b811cc1550a05926742931062b7547d32d6c03a33ff0","c147bbf127ac4939e851f39f946bf381de4f739d6b205d3ebe55714c5ab4eae3","9c2308cf31ac3308dc2471a0c14b5cc9ae1d7dff04461a540570b2170fed9ecb","66cfc6f7bb13e50cc6327b888ddefc0726fef8aee7a5e536da3a744d92293bc1","188be13b14317857262c344ac85c94b71b371479758eeec37e016218cea9d501","cab82f08ef923f064563c692678fc0f7960751d8e64849a3c16ad8a8279deee4","59cf54137810275822c6a3e1b242db6acd92273204ad73a77c33ef7b88d8110f"],"paragraph_range_zero_based":[29232,29255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29232"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DLorJointTCI-SRS","paragraph_zero_based":29256},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if srs-DLorJointTCI-State is configured, otherwise it is absent Need R.","paragraph_zero_based":29257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29258},{"literal_text_all_w_t_and_m_t":"–SRS-RSRP-Range","paragraph_zero_based":29259},{"literal_text_all_w_t_and_m_t":"The IE SRS-RSRP-Range specifies the value range used in SRS-RSRP measurements and thresholds. The integer value for SRS-RSRP measurements is according to Table 10.1.22.1.2-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value –140) dBm, except for the IE value 98, in which case the actual value is infinity.","paragraph_zero_based":29260},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range information element","paragraph_zero_based":29261},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29262},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-START","paragraph_zero_based":29263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29264},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range-r16 ::=                      INTEGER(0..98)","paragraph_zero_based":29265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29266},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-STOP","paragraph_zero_based":29267},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29269},{"literal_text_all_w_t_and_m_t":"–SRS-TPC-CommandConfig","paragraph_zero_based":29270},{"literal_text_all_w_t_and_m_t":"The IE SRS-TPC-CommandConfig is used to configure the UE for extracting TPC commands for SRS from a group-TPC messages on DCI","paragraph_zero_based":29271},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig information element","paragraph_zero_based":29272},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29273},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-TPC-COMMANDCONFIG-START","paragraph_zero_based":29274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29275},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig ::=               SEQUENCE {","paragraph_zero_based":29276},{"literal_text_all_w_t_and_m_t":"    startingBitOfFormat2-3                  INTEGER (1..31)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":29277},{"literal_text_all_w_t_and_m_t":"    fieldTypeFormat2-3                      INTEGER (0..1)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":29278},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["d7f695472786ff93feb1c1abe1f589b08e5cab12fac940d0368b2cd8b9dedb52","0343dfbce588401b363b630a33337b78c458231fae0e0d37526ad8ddfc861802","f36974f773d8f9e586e15bd00aa1ca17cedd1a1f9974d82aa694808bd95bf4cc","8c5acbc8a064d4a011d1e68d167454040cfed5d2ed47b4e7abed588975bcbb24","04cfc7706ff807da1b9c4e3dcaa4a0fbe8eb9a24c42a442ee1cc2cbf7b7ce3af","f07389eefd7a3120f98c617cd40b21d68ade3d7a448448051ea7477d58a3ba40","70607bde3c4f7a7168548812074372f7247ed44245282a936e7669df6d9a8ca1","009d50cab7220ac568a9486871f3b2c4b8783839a6a900910bb7d8daaa2e1baf","7bb31c8f5539a84da9ac3dd945b4689ac988cb9aca6d071db3ed83d12fd96cb1","f4c52c5dee1594eb729b2052fa8ca7ba695b55488be8eefde908ef237854c77f","8376e9f4c5acfa007577f978c8098a02339a202687a265771df7440ceb4514a7","1b5addb07c730b38cf0c6f18a36a46d9487a3036531a2c267c7441ff248d6dcf","2178d69f0f01b97a9a58af71701573cd673a37bd2957a7b3b078c22c09029091","f5a8957eb12ab6a28f8fe5d2df2475c1b4c24293d6c1c0c03a29ac188ff84d38","75f90f1e2fe761dc1f49fb7a49e6b5832374858c13b4f86497bb588a7ceade1d","ccb8c0c512d87426654e7e2ef9e92459aece15452e4a509c57f6d8d7ef3dbc09","01176f239cff3655dcd87cae14f8fbc320b4f809aefecedb0acda04afbbd9ba9","72404a321c8d5b04da6e8ddf0079a3ced121a43cd629beca1d94415e142159ec","43aa37a6a5ca8284421bac90692231c2d3fa9bd70b573ebe67bfc533be935171","2602549fa2eb2702193a5266ddf1bba79f47f3f5d9e0f3e2d546d196958b4c6d","298e079e7c2b0f2e6fc3a09ee7acee546e23417e5b13b2ca59ec46a18a51eb10","eb606f78878510af62ea562c12089162ac84cb14a0eb8893c181e09365e7e654","cc5e67b5e0c76122e40bb103193b2262f3c296ef13b45158cb38671699c9c128","fd0b29c57ec4dd2f73b4d5005e5bba51c62e385d53ff9a5dda44e7b38ee21e3f"],"paragraph_range_zero_based":[29256,29279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p29256"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29280},{"literal_text_all_w_t_and_m_t":"    startingBitOfFormat2-3SUL               INTEGER (1..31)                                                     OPTIONAL    -- Need R","paragraph_zero_based":29281},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29282},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29284},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":29285},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29287},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig field descriptions","paragraph_zero_based":29288},{"literal_text_all_w_t_and_m_t":"fieldTypeFormat2-3","paragraph_zero_based":29289},{"literal_text_all_w_t_and_m_t":"The type of a field within the group DCI with SRS request fields (optional), which indicates how many bits in the field are for SRS request (0 or 2).","paragraph_zero_based":29290},{"literal_text_all_w_t_and_m_t":"Note that for Type A, there is a common SRS request field for all SCells in the set, but each SCell has its own TPC command bits. See TS 38.212 [17] clause 7.3.1 and , TS 38.213 [13], clause 11.3.","paragraph_zero_based":29291},{"literal_text_all_w_t_and_m_t":"startingBitOfFormat2-3","paragraph_zero_based":29292},{"literal_text_all_w_t_and_m_t":"The starting bit position of a block within the group DCI with SRS request fields (optional) and TPC commands. The value 1 of the field corresponds to the first/left most bit of format2-3. The value 2 of the field corresponds to the second bit format2-3, and so on (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11.3).","paragraph_zero_based":29293},{"literal_text_all_w_t_and_m_t":"startingBitOfFormat2-3SUL","paragraph_zero_based":29294},{"literal_text_all_w_t_and_m_t":"The starting bit position of a block within the group DCI with SRS request fields (optional) and TPC commands for SUL carrier (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 11.3).","paragraph_zero_based":29295},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29296},{"literal_text_all_w_t_and_m_t":"–SSB-Index","paragraph_zero_based":29297},{"literal_text_all_w_t_and_m_t":"The IE SSB-Index identifies an SS-Block within an SS-Burst. See TS 38.213 [13], clause 4.1.","paragraph_zero_based":29298},{"literal_text_all_w_t_and_m_t":"SSB-Index information element","paragraph_zero_based":29299},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29300},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-INDEX-START","paragraph_zero_based":29301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29302},{"literal_text_all_w_t_and_m_t":"SSB-Index ::=                       INTEGER (0..maxNrofSSBs-1)","paragraph_zero_based":29303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["686055e33a8d2ecd96bf2a1a3b8a286053f652c1e78f97102c01022a5afec20d","abad03d7847c1ba4b7fe08ab0ffaa8212dde92ae83d2b83136e164a9f4cd24cd","d90f619e876c1e52549abc2e575139a5abcd3215c8641c8f5bb98cb7353c9281","1e9d77d01e7b348e9a046962520f3401418548dc6c24ee74823348579a8087da","d64f8e0e91c6cfc8fbd71dfd73559f4d595f6746879ed1c421f8435e8d63d254","d8253422ac6dece5bb939dcadfe83fc5f77aeb7ff8451c7b7e42be2051b3c94e","877ca55cead92c7ec6cdf739aab7b0c9670b8c71dcef747d919ec4be8a35df3f","f7af1cbd1b7846a7ddc0b7e8f0051b076510cd983058dd5a1