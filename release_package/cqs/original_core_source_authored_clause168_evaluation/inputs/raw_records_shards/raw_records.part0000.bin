{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP. This field does not include sl-TxPoolScheduling.","paragraph_zero_based":37488},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigPS","paragraph_zero_based":37489},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":37490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37491},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic field descriptions","paragraph_zero_based":37492},{"literal_text_all_w_t_and_m_t":"sl-LengthSymbols","paragraph_zero_based":37493},{"literal_text_all_w_t_and_m_t":"This field indicates the number of symbols used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":37494},{"literal_text_all_w_t_and_m_t":"sl-StartSymbol","paragraph_zero_based":37495},{"literal_text_all_w_t_and_m_t":"This field indicates the starting symbol used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":37496},{"literal_text_all_w_t_and_m_t":"sl-TxDirectCurrentLocation","paragraph_zero_based":37497},{"literal_text_all_w_t_and_m_t":"The sidelink Tx/Rx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding sidelink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":37498},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37499},{"literal_text_all_w_t_and_m_t":"–SL-BWP-ConfigCommon","paragraph_zero_based":37500},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-ConfigCommon is used to configure the cell-specific configuration information on one particular sidelink bandwidth part.","paragraph_zero_based":37501},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon information element","paragraph_zero_based":37502},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37503},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-START","paragraph_zero_based":37504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37505},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon-r16 ::=              SEQUENCE {","paragraph_zero_based":37506},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                         OPTIONAL,    -- Need R","paragraph_zero_based":37507},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommon-r16              SL-BWP-PoolConfigCommon-r16                                OPTIONAL,    -- Need R","paragraph_zero_based":37508},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":37509},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":37510},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonPS-r17            SL-BWP-PoolConfigCommon-r16                                OPTIONAL,    -- Need R","paragraph_zero_based":37511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["47a4faca3da658de488e17b50b281bba547b0a3f6b57da568207ab4fd4965cc1","de139b48f23abb9266d9c426