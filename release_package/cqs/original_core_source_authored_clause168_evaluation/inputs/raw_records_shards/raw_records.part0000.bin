},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28094},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon-v1760          DownlinkConfigCommonSIB-v1760                               OPTIONAL, -- Need R","paragraph_zero_based":28095},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1760            UplinkConfigCommonSIB-v1760                                 OPTIONAL  -- Need R","paragraph_zero_based":28096},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28097},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28099},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-STOP","paragraph_zero_based":28100},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28102},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB field descriptions","paragraph_zero_based":28103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["043056fe4422bfa86089fb1c77e140610c8c06aa2bda0b62d9f4e15b75aaccf0","6c5ee8680604385a22527759c543946c41a9e7d5d19e165484d48b52c893b6a7","7d7a315d3e71ee61f36270bf57260202399c55a545fc1d257c6170ea3e368d59","51e6c6c7dd4e8b47b2359e1ed099f1f21fa1e0840d2cd58306c743c530bf7ed0","30e91c2e3e931dc93486f86c15592baad5092390a6af060d675090eca208431d","074c700ebf4ea0b6bcfde9cd6b14f4ceafe0d772e4a3901fc61033ee1251dfdb","96dc4eed1e8a2132f401bd878d801673c2fed155511ef958a100cdbcd8fb7456","169a4cd6877186b26a5bfc62c2e4865a2987e04b6cd3ec672572747d29667be3","99a613009859f3ac2f362347ff36854f973994f9414cc0379a85b40cfb74ba3d","18279d0bf081f5f34feb420098e99df668601527b089b5ca7fa0e0ff4b8f9636","616eb1d01beccfd45fa001b64a9d40e19dad05e0e8063c8803183d2fd9373d23","aa7457e7c8ab679ea2d1e23a0cee523effa66aa74ca77ed9eaf85688c6dd3775","e7237e5f9648f956a520a27b9ea448c9f061f0dc89da1286581659bcf51333c7","0f32ea574d1d587cb2ef009f6fc7cba4b76c29908792e68d94e527950045a550","e799393d887e5f2f3465a0af1851a9f1f59134df14019c945b41313f12f4dbeb","245700548b1a1654ce2188b5c6c4db2108b96fd087dcfb64a712fdf0c261f76b","367de1e6f0de8d22df399c9f3d37e57f792b39ba09ec15ce62c44c448335b809","949c832fde8200b714757c9f645e1e5e02dd652bb9cacdd2c5ea9e60fd11212d","9001bcfc1c86b74d81fcbfa1571b9c5cd2fb6251b99bc335de96a352055665fe","573882dac45a50528f28a080b471a731c7765b119585b3d21b49f6766e1d9726","387687b437ba8346445f7cfb9af6105a935c3306b3109fd45f989583601970bf","d910b3743a261f03577849788f90d1704d323fbcbf6becd89fa338da0591dbed","f8c0d698ae448abc8eceddcd1be01a076a983dbd08540a58b2e569ef8a6ad1ff","b465dc9596fb81908716656aec3d08d856f83d552a16621eaca961858aa01124"],"paragraph_range_zero_based":[28080,28103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx:p28080"}
{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":28104},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":28105},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":28106},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":28107},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":28108},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":28109},{"literal_text_all_w_t_and_m_t":"enhancedMeasurementLEO","paragraph_zero_based":28110},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports the enhanced cell reselection requirements for NTN LEO in RRC_IDLE/RRC_INACTIVE, the UE shall apply the enhanced cell reselection requirements for NTN LEO as specified in TS 38.133 [14], clauses 4.2C.2.3 and 4.2C.2.4.","paragraph_zero_based":28111},{"literal_text_all_w_t_and_m_t":"groupPresence","paragraph_zero_based":28112},{"literal_text_all_w_t_and_m_t":"This field is present when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to the SS/PBCH index 0-7, the second bit corresponds to SS/PBCH block 8-15, and so on. Value 0 in the bitmap indicates that the SSBs according to inOneGroup are absent. Value 1 indicates that the SS/PBCH blocks are transmitted in accordance with inOneGroup.","paragraph_zero_based":28113},{"literal_text_all_w_t_and_m_t":"inOneGroup","paragraph_zero_based":28114},{"literal_text_all_w_t_and_m_t":"When maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1, only the 4 leftmost bits are valid; the UE ignores the 4 rightmost bits. When maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1, all 8 bits are valid. The first/ leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. When maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1, all 8 bit are valid; The first/ leftmost bit corresponds to the first SS/PBCH block index in the group (i.e., to SSB index 0, 8, and so on); the second bit corresponds to the second SS/PBCH block index in the group (i.e., to SSB index 1, 9, and so on), and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":28115},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":28116},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for random access on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":28117},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":28118},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":28119},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":28120},{"literal_text_all_w_t_and_m_t":"Time domain positions of the transmitted SS-blocks in an SS-burst as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28121},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, only inOneGroup is used and the UE interprets this field same as mediumBitmap in ServingCellConfigCommon. The UE assumes that a bit in inOneGroup at position k > NSSBQCL is 0, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, the m-th bit in groupPresence is set to 0 for m > NSSBQCL/8, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":28122},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":28123},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":28124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28125},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28126},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["4e47f3acc4070f41341c2e4494a1d683bde48a9712412ea834808cda40360ed4","d2556a4b0a0c696bf743fa5c93b4654faa652e2400287f8ebbe16bf6955122fd","f7435a650ac5f6daebc7f2b26875c2b411323b5e0adbfaa9d49d31973034b82f","cbca2b06fa2e923d886116b1a6f9e37d3f9b9d17f9e897003f4b919b7be7fdeb","20ad1698ab63945d7f6c7c43252ba08e377489c96db42e785e154a4fe1b0c314","3e2ee653ed12a2d2998f24210efb68dd509e2b19b23537c5c1c707692066a2ab","2dde288c9120fad684b37c4b16fa8b68812c68a1b2ebbf4364370d763fc1bd62","fd85115dd32c0d06a0ca9a517235f07053a46d4dc1c13711a17ecebe2dbcdb4c","e9282d78acf5eff9785f9dc8c83d4ce27a8f47b0a250710fb93492a3174e044d","8033932911b8094d11599b71f95a4492219cd181180761a49018707dc393e1cd","d6a9c0c438cedbe709b856694e707d66e1ef41c81bc050a774cad58d9f3b0a40","5c671e50adbf203383a789e62e2fb5031f8b6a250d57f0fbc4414f1ab84e0e05","cbf18886cc8bbdffc4592ccc2d6be06fdf6daac518fc993905efb0aadc46aad9","071cb761934227a29b84c7e7330f358e5e0a35a3e403ec184e7084c05de915f7","419a8319b803cb50eace87089d14317f85a22baf81b39d89b6c464c3ed88d324","32a629afc8ea7f8d31cf00398e4c66f8a7b6ad307d4b1f0415d286f0f4a684b0","142d9e7d5c2d9e42b15ee402f493387ca969fae0f661e457bbe3a907199b1a4f","473f7f39e06d611a76f88a6017efed7eb36742083d9facb0883b077e0a189834","a9487f28748fb10d540b9a306039e5559b5b5dc8fa47a0efd29bfd382e714684","16772135bc2673c853b71e969152dbf79ac98455ba1b391475afc915a5b544d9","09465000534cec065d61d73bb93ac9cb5600b3583325eb2bfe783cbfa0a02fb9","26033c660b1eb12adb542e7adf1f804a70115d0bf65abaeeefe605f6de12ef50","bdd9a735ad816e89b752f4b9c23395de0140f7ea888dd9658ec8e08bfcb50b88","44d74f421953f637adf6653c18fee35691d41ce323774f035ae276045ac0286a"],"paragraph_range_zero_based":[28104,28127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-231