nt_XML_sha256":"402880a9d8f08f91fe24b048856b9780e089d79cd12536aba800d266be1e632a","original_member_sha256":"7cb6fb3149876999a30042fc450d0b566e79a928f6263bf65b46f1ac1a712180","paragraph_ElementTree_utf8_XML_sha256":["7ae559ec2991ca97b15292717e994fec32dd6bb2702fd82d71df5f6d3449fc80","59190e70ece9ffb806e9984eb0949613812c790031ebd2f417b07742101bcec3","5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","f684beac080383fdf0daab5027242fe0bdb32cd9093a8b54a6aeab23e7a76860","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","c895125d54c3f46741d160601f04409646b6e7ae054a21090de4e195368c05e4","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","c7d75ae879615aa89e4c700820c2b14fa1c559b9c743959237011856e18c8556","ec5446a0f161ea9fa47512adc5567bbdac75317718781de1b4b95eb9833f0ece","ee8a4a9ba4bfbd3c25c32f489e79ca876df319fd583fc3a347d3cdbbc6177f30","32f629e82d47796d8195248bf8a3d84e086dcb373788c033e2ed42391b57b6f5"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"s