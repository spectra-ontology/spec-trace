{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41880},{"literal_text_all_w_t_and_m_t":"NOTE:RRC will perform padding, if required due to the granularity of the TF signalling, as defined in 8.5.","paragraph_zero_based":41881},{"literal_text_all_w_t_and_m_t":"9.1.1.2CCCH configuration","paragraph_zero_based":41882},{"literal_text_all_w_t_and_m_t":"Parameters","paragraph_zero_based":41883},{"literal_text_all_w_t_and_m_t":"Name","paragraph_zero_based":41884},{"literal_text_all_w_t_and_m_t":"Value","paragraph_zero_based":41885},{"literal_text_all_w_t_and_m_t":"Semantics description","paragraph_zero_based":41886},{"literal_text_all_w_t_and_m_t":"Ver","paragraph_zero_based":41887},{"literal_text_all_w_t_and_m_t":"SDAP configuration","paragraph_zero_based":41888},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":41889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41890},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41891},{"literal_text_all_w_t_and_m_t":"PDCP configuration","paragraph_zero_based":41892},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":41893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41895},{"literal_text_all_w_t_and_m_t":"RLC configuration","paragraph_zero_based":41896},{"literal_text_all_w_t_and_m_t":"TM","paragraph_zero_based":41897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41899},{"literal_text_all_w_t_and_m_t":"Logical channel configuration","paragraph_zero_based":41900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41902},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_bas