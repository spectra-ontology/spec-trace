{"fields":{"filename":"R2-2306537.zip::R2-2306537.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-DifferentialCorrections; otherwise it is not present.","paragraph_zero_based":624},{"literal_text_all_w_t_and_m_t":"NavModSup","paragraph_zero_based":625},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-NavigationModel; otherwise it is not present.","paragraph_zero_based":626},{"literal_text_all_w_t_and_m_t":"RTISup","paragraph_zero_based":627},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-RealTimeIntegrity; otherwise it is not present.","paragraph_zero_based":628},{"literal_text_all_w_t_and_m_t":"DataBitsSup","paragraph_zero_based":629},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-DataBitAssistance; otherwise it is not present.","paragraph_zero_based":630},{"literal_text_all_w_t_and_m_t":"AcquAssistSup","paragraph_zero_based":631},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-AcquisitionAssistance; otherwise it is not present.","paragraph_zero_based":632},{"literal_text_all_w_t_and_m_t":"AlmanacSup","paragraph_zero_based":633},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-Almanac; otherwise it is not present.","paragraph_zero_based":634},{"literal_text_all_w_t_and_m_t":"UTCModSup","paragraph_zero_based":635},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-UTC-Model; otherwise it is not present.","paragraph_zero_based":636},{"literal_text_all_w_t_and_m_t":"AuxInfoSup","paragraph_zero_based":637},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-AuxiliaryInformation; otherwise it is not present.","paragraph_zero_based":638},{"literal_text_all_w_t_and_m_t":"DBDS-Sup","paragraph_zero_based":639},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports BDS-DifferentialCorrections; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":640},{"literal_text_all_w_t_and_m_t":"BDS-GridModSup","paragraph_zero_based":641},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports BDS-GridModel; otherwise it is not present. This field may only be present if gnss-ID indicates 'bds'.","paragraph_zero_based":642},{"literal_text_all_w_t_and_m_t":"RTK-OSR-Sup","paragraph_zero_based":643},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GNSS-RTK-Observations; otherwise it is not present. Note, support for GNSS-RTK-Observations implies support for GNSS-RTK-CommonObservationInfo as well.","paragraph_zero_based":644},{"literal_text_all_w_t_and_m_t":"GLO-CPB-Sup","paragraph_zero_based":645},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the target device supports GLORTKBiasInformation; otherwise it is not present. This field may only be present if gnss-ID indicats 'glonss'.","paragraph_zero_based":646},{"literal_text_all_w_t_and_m_t":"MAC-Sup","paragraph_zero_based":647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"7ea3ea011934f6c0dae39181d4a24ce5ca5bc379d48c0313eb5c481ec4a3b095","original_member_sha256":"7e5d65269c396c98b3a6de240a7cc5f08aa736e14c814be48fe93773a39ba42f","paragraph_ElementTree_utf8_XML_sha256":["5c8fa35cb6f82d407322ec7f5e111334a5300c8d6ec64c6e3f76273f3faa879e","974951664e9e0626649097e4f72efe931570b801cfbbdc44a4090bed063b4c25","4bf1a32233625d385df6180d4e405a68d6b4017c6eb1c17ffb87872a43a1a3fa","a21032119af9f68f3b97da2aad635879f30c5685b0c69