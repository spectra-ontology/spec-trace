he cell ID is shorter, the first bits of the string are set to 0.","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"–CellGlobalIdGERAN","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"The IE CellGlobalIdGERAN specifies the global Cell Identifier for GERAN, the globally unique identity of a cell in GERAN.","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["24306bec153f76e433dcbed83e7d9ed0e4d185a8ac84af55a2d1fea9d981e829","e3320ea2c7dede8c17d2cd8bdee174feddbaf7af6729159defb75d631e20d6b5","52706e4b39eb70487200a4e30348fa9eaaf1dc2a44c978040bf17de625d09d0a","7b73e67196e1a06f189eb04f8427988d3ecde87cd87ef0ea75f6001b9e3c49d4","dadda2f13ea2f6598269716980772c45407c0a54108682554bf0e1f4a84eb6e7","b23da26ff30f945d90a09d74b723d44fd44c02fead93706adacf0c6a1ea1b67c","28c00136181e9823ae41939d181177c450980c0b09ef9d8a1de0cef0efdb6631","8093919c87e8293720df89483a1828cbab9d8efbcae9edc85f50b93cc30a8c03","3c0864e26d9c1de89cbf139c64d197689f728bfd2950aaa309701e9bfb0d729b","919798db747238c7ad7b694afc9d6cb78b763788882595e69181389ce7930c4b","1545fc775917c01fc3c4995eff890234147dac8d36541c3ad0c55c0661f9ed52","5f142af29f5c66f39db73d5462f8aed142b9fcec07dd34dae7085c20d68de460","54d66b7c3e9e4049bc1bc76880c118de8a12164dab091fe9a17f35ecbe4951dc","7556cbefac14193fb6919435642d4f2a8f6c01757b376353652f50e2558df5f2","b4be8d465085b1b2c3e5e82335249769115771e6828e61cf1bc18ded32321784","693bc4cf3eef208a67bf575e631aef093f66d79fa010a6d54f8d0aaefbe1e3fb","6b98dba4500986e68c97158dc022e98463d272a3cc9b9d122457027c88df1719","a2aa8d75e