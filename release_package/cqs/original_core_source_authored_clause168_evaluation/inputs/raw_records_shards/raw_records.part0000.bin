},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-ResourceID-r17NR-DL-PRS-ResourceID-r16,","paragraph_zero_based":2779},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-RelativePower-r17INTEGER (0..30),","paragraph_zero_based":2780},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-RelativePowerFine-r17INTEGER (0..9)OPTIONAL,-- Need ON","paragraph_zero_based":2781},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2782},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["d7d2a1f4bdf16d852d80df01aa12073d084c055074162596077c109f4157d401","8bf291f003710b175def510dfa95f256ad60653fd7f535b605729e0117039c83","8e2adb04f5572ec386b11909aa2d7e40d1a9bc30f4e86f5e2c58d5384df8aa52","a0989994db19815d167890bf93c64c443c4f7e7530cfe5a85e12270da0573471","f442441c6296c2e30a6b374072324703f2047e4ea81230856da58b160df974c7","cc3b6f5b375b8b9aff358796b056fc8082ffdf0cf9b2b93d3e92ba9e6152cad5","39fe8aaf91dff43b4468da4d1ff2a03c4a8b889e5c6852a6cce7308fa558dca2","03e3f1179962e4d50e901eb2ef763755ed928653f067c3ce1610c055ccb0c664","fe43b8617dfbe5a05f65dc5dec71e6a960c6e8f3f85cbbc0445e6de61dd693fc","e7224752708f90abbb61eff582e2df53ca443b23a0221a91fc4879c043513b93","3fa5ae8b562994a006401b28eae903e741c07d922d5312f79d95a2e43d034c5b","d57c5a1a6635738878b9cd4bd8918b32a3331884eb66fd3b59e2cd206d047e4f","16986257b47b2da613c89437f95322e885212b568d5c0bca42253935f34c7770","d4151e3d53734b28319e51ddf9f9d3342edfb3613b61310448df08cc4ed83494","878fe290bb5856f5ddb2c87c5af50e261540c86520c3060da832f04acc49f045","80911a5ca8f3477f10cd9670897a7af4f2ee6e943c9cc2132b0357587a19f646","201a60867c3a4c815bd7088e480aca30b00f7654e74957eb9183e788f0547e8f","45fc09187a191fb2949569bff87445562c83d8ad3ac9447966632650d14220ad","cf4eb2f3352d994281c653cacfcc924ec832af26085f2bac0a4fa1fd0185441c","7173a49c2c3019046706859e7b4dc4ddd8fb7348b8a841c7b81a43f34d299c58","fa6b7f7b7b8b3428dd732f92c7b0acccf920fc762dddbda16016bff3aa8a2809","0d2e62772cae6fb2544433eb119edd4f82bb9708513bfdc7a35f64b71ccd332b","0abc8472ed4395ef6e84391cf85e5862d72d019f437b7efb231c46abf12d041c","6a85dcd5a593064285da688b92b0234f97dd66424be0128797b219234798f9f5"],"paragraph_range_zero_based":[2760,2783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2760"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2784},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":2785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2786},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":2787},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":2788},{"literal_text_all_w_t_and_m_t":"Az","paragraph_zero_based":2789},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the field elevation is absent; otherwise it is optionally present, need ON.","paragraph_zero_based":2790},{"literal_text_all_w_t_and_m_t":"AzOpt","paragraph_zero_based":2791},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, when azimuth is present; otherwise it is not present.","paragraph_zero_based":2792},{"literal_text_all_w_t_and_m_t":"El","paragraph_zero_based":2793},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the field azimuth is absent; otherwise it is optionally present, need ON.","paragraph_zero_based":2794},{"literal_text_all_w_t_and_m_t":"ElOpt","paragraph_zero_based":2795},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, when elevation is present; otherwise it is not present.","paragraph_zero_based":2796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2797},{"literal_text_all_w_t_and_m_t":"NR-TRP-BeamAntennaInfo field descriptions","paragraph_zero_based":2798},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":2799},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS ID of the TRP for which the Beam Antenna Information is provided.","paragraph_zero_based":2800},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":2801},{"literal_text_all_w_t_and_m_t":"This field specifies the physical Cell-ID of the TRP for which the Beam Antenna Information is provided, as defined in TS 38.331 [35].","paragraph_zero_based":2802},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":2803},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the TRP for which the Beam Antenna Information is provided, as defined in TS 38.331 [35]. ","paragraph_zero_based":2804},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":2805},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":2806},{"literal_text_all_w_t_and_m_t":"associated-DL-PRS-ID","paragraph_zero_based":2807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["618d6554536833fe0d4cc34577ef2ef9367c8b48f200982700484256caf8be94","2602db322001e49b0f8c706ad1c0874b7dac20141a3b17e7d55bfe82d34cd678","f00abeee000fe4fc1c00b2c6b9b2d140d951e77f62803a0edc0ce0afb02e3a41","0505e28f4debd755291dedb1416841e01e55628832d68217a56b0251dc834f70","bf7d7409b848247aaa85d7c8f89d30d0bf2f30b33822237f7f53be47d6900fbf","4135da2e9d7aad1c1f166dfbe226ea659b6cfd1d5eb668c0f8cdb4d440dba97c","13d88a77a837a557c08b4cf66003f3d72f4897844e05deaef9d63fbe5164a1c9","f37c6880b4bec81df3995d90d0c97a58789206e4c40f2c82be8dcbcae75d6e45","2c5269c241500d304e526d92c9d166bd478c15df56beb18dca1f0ce42f6d963d","0f40dc0c2e823ac669382405ab55ac71b3c860a016763ad16c78ca7f7d6bd221","b802a94cd91792a7ee78e6349c72692d515ca4adc1e0382ff8be0d2a6aa03b56","7d88298b2ea817d2ae66c48c6593d89863b93ce2b38313600acbe9266d10771a","bccd4421286abd9d4362208e6b7b47c65ffd66e77f205bead94f2d667d56802c","fa4ba0165560a6c31f315a9dc7dab54890f8805aef45e3596053f1c52ab8d797","45534109dfb1086a3285b887e94d5c97ba765b1c0d51f4b53c0de89a282ff6c0","ac16d049ad8a20b8c1e03877126ac593db7779685fbb1c1d74656b02f448923c","c789d0a98ed2141e0e13616e25d44f1000cc0531e981792ed9141ae2e30f08d8","16279f89c171dabc30deaff00e881123d7e02f7e9dfb9c8fcb0a06c671d0889a","ab3bd7b5a0ba8c95ec9f0c09acc8d32047d966ded755cd318993c961b5c78a5e","af2d5cb2f52045bee19abf660c48d15a3eea98e7c31ea7d08e704f5df9bf5c9d","21a6bfadf45664e78bf69a000890228b2110e33d11d0c6b21faa03861bdd4836","6bb6714f1cd5ff27c9212c3fee09037eaeb7f9f247c9404bec7ea9df014c9f6f","f94269328ebddb65122cf8e84548b618dc9a068e17a76a3c79981868cc5af0c0","19b05228b752ca4f15c5fc0e349e8356203345a1bd7cc8276b2d90cd9e6308c8"],"paragraph_range_zero_based":[2784,2807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2784"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the dl-PRS-ID of the associated TRP from which the beam antenna information is obtained. See the field descriptions for nr-TRP-BeamAntennaAngles and lcs-GCS-TranslationParameter.","paragraph_zero_based":2808},{"literal_text_all_w_t_and_m_t":"lcs-GCS-TranslationParameter","paragraph_zero_based":2809},{"literal_text_all_w_t_and_m_t":"This field provides the angles α (bearing angle), β (downtilt angle) and γ (slant angle) for the translation of a Local Coordinate System (LCS) to a Global Coordinate System (GCS) as defined in TR 38.901 [44]. If this field and the associated-DL-PRS-ID field are both absent, the azimuth and elevation are provided in a GCS. If this field is absent and the associated-DL-PRS-ID field is present, then the lcs-GCS-TranslationParameter for this TRP is obtained from the lcs-GCS-TranslationParameter of the associated TRP.","paragraph_zero_based":2810},{"literal_text_all_w_t_and_m_t":"nr-TRP-BeamAntennaAngles","paragraph_zero_based":2811},{"literal_text_all_w_t_and_m_t":"This field provides the relative power between DL-PRS Resources per angle per TRP. If this field is absent and the field associated-DL-PRS-ID is present, the nr-TRP-BeamAntennaAngles for this TRP are obtained from the nr-TRP-BeamAntennaAngles of the associated TRP.","paragraph_zero_based":2812},{"literal_text_all_w_t_and_m_t":"azimuth","paragraph_zero_based":2813},{"literal_text_all_w_t_and_m_t":"This field specifies the azimuth angle for which the relative power between DL-PRS Resources is provided.","paragraph_zero_based":2814},{"literal_text_all_w_t_and_m_t":"For a Global Coordinate System (GCS), the azimuth angle is measured counter-clockwise from geographical North.","paragraph_zero_based":2815},{"literal_text_all_w_t_and_m_t":"For a Local Coordinate System (LCS), the azimuth angle is measured counter-clockwise from the x-axis of the LCS.","paragraph_zero_based":2816},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 359 degrees.","paragraph_zero_based":2817},{"literal_text_all_w_t_and_m_t":"azimuth-fine","paragraph_zero_based":2818},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the azimuth.","paragraph_zero_based":2819},{"literal_text_all_w_t_and_m_t":"The total azimuth angle is given by azimuth + azimuth-fine.","paragraph_zero_based":2820},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":2821},{"literal_text_all_w_t_and_m_t":"elevation","paragraph_zero_based":2822},{"literal_text_all_w_t_and_m_t":"This field specifies the elevation angle for which the relative power between DL-PRS Resources is provided for the given azimuth.","paragraph_zero_based":2823},{"literal_text_all_w_t_and_m_t":"For a Global Coordinate System (GCS), the elevation angle is measured relative to zenith and positive to the horizontal direction (elevation 0 deg. points to zenith, 90 deg to the horizon).","paragraph_zero_based":2824},{"literal_text_all_w_t_and_m_t":"For a Local Coordinate System (LCS), the elevation angle is measured relative to the z-axis of the LCS (elevation 0 deg. points to the z-axis, 90 deg to the x-y plane).","paragraph_zero_based":2825},{"literal_text_all_w_t_and_m_t":"Scale factor 1 degree; range 0 to 180 degrees.","paragraph_zero_based":2826},{"literal_text_all_w_t_and_m_t":"elevation-fine","paragraph_zero_based":2827},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the elevation.","paragraph_zero_based":2828},{"literal_text_all_w_t_and_m_t":"The total elevation angle is given by elevation + elevation-fine.","paragraph_zero_based":2829},{"literal_text_all_w_t_and_m_t":"Scale factor 0.1 degrees; range 0 to 0.9 degrees.","paragraph_zero_based":2830},{"literal_text_all_w_t_and_m_t":"beamPowerList","paragraph_zero_based":2831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["e10e9e058f5804a509bae39be78edad3f3e98b8f434f979cd4fabf1a56052648","9eb9f76e993903b0a126021b86c4e21fa41a29c8fe4ba579cdeeb5d6b9b8eba8","f3406e18f5a0d3ca9e996b30cb307b7d4249ceebd978b3568a2f68c9e1803531","3e6787a95cdbb15b7fcc28c160954566ddfcd7b29e0a719e74bffed961a58da6","d6fb59035ec00cc45b3ad1e0c62c003bcc8b4ee0949fda2e661046d9a9bda575","b414a623fe6e0db8149dc89a00bc0b11c3948080567e4fd51d8251b8e9d9a87c","5fcabdc9b45618afa95e7d13a193c9e24bb67abb0d0fccbd47ed80a5f6e42572","45fc74a40cb64439a085f5d0f01b52d64291d09f1c26ab107d1410f536ad773b","66cabb3357c8b6a655d9898f2130e27c1aabcfad644a86acb3fc84157083db64","81bb198f1f8bb684b28697a3e86504b9fed1b36f7343c2351c151aa2a9575ce1","de1e39372a95cf6a0fd0a7adfe6bec4267dd427e641c25833adaf7ad3160ba9b","6a64ff31a9e76bbc2d1a47e4bfa0fab60e141dce7f61670c03111edf030bf4c6","251d4eff1172b828d14809ab665d0e34f204cfe5ad6495f23c88f00d4d510406","879eb4ead674b0431dcce543d4ef31ea7019ce1a4b85c472b4b89fe8b1b8e9f7","2bebe141f22c10fddf82cbcba41a731c25c30d11fa2fe875082562c91a45a35d","e4ef6e66fc995c00719f2166206433f9b0d1b49889a4de2ade6cb93b199d6130","c4d3c24b0e9d9a4d74a059a43b8b55b49c72c52e3af59e052f22693ecb8ae21e","1fdcb9a199dcb026287a68b1c3a1f88e7d72252e5c3bbd3e4aa833c569976626","e318641c58355823d13b8220fc368c5f753127ef38ce0cddd450fcdd02d4acf0","28a789be2457e08c2938914153a24ae33b130208abfd43f4fb71ac9ea541bd44","d3639203f179a8d3393f434dc99ad9d78eecbdba500692259e2679d0b770ff2d","f0bf54de82280ba1fa88383a27dd8f990acff0e218f4b0e1eba44c900065b35b","3e7d7f81cf1de4c5247207e977c5b4c290b6e30d67a64a39bc06f7f420402d16","a294ceafa7d426d485a14030ad19b0c8bc9c6917f6292d228e977108f23c54e9"],"paragraph_range_zero_based":[2808,2831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2808"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides the relative power between DL-PRS Resources for the angle given by azimuth and elevation.","paragraph_zero_based":2832},{"literal_text_all_w_t_and_m_t":"The first BeamPowerElement in this list provides the peak power for this angle and is defined as 0dB power; i.e., the first value is set to '0' by the location server. All the remaining BeamPowerElement's in this list provide the relative DL-PRS Resource power relative to this first element in the list.","paragraph_zero_based":2833},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-ResourceSetID","paragraph_zero_based":2834},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resource Set ID of the DL-PRS Resource for which the nr-dl-prs-RelativePower is provided. If this field is absent, the DL-PRS Resource Set ID for this instance of the beamPowerList is the same as the DL-PRS Resource Set ID of the previous instance in the beamPowerList. This field shall be included at least in the first instance of the beamPowerList.","paragraph_zero_based":2835},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-ResourceID","paragraph_zero_based":2836},{"literal_text_all_w_t_and_m_t":"This field specifies the DL-PRS Resource for which the nr-dl-prs-RelativePower is provided.","paragraph_zero_based":2837},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-RelativePower","paragraph_zero_based":2838},{"literal_text_all_w_t_and_m_t":"Except for the first element in beamPowerList, this field provides the relative power of the DL-PRS Resource, relative to the first element in the beamPowerList.","paragraph_zero_based":2839},{"literal_text_all_w_t_and_m_t":"For the first element in beamPowerList, this field provides the peak power for this angle normalised to 0 dB.","paragraph_zero_based":2840},{"literal_text_all_w_t_and_m_t":"Scale factor 1 dB; range 0..-30 dB.","paragraph_zero_based":2841},{"literal_text_all_w_t_and_m_t":"nr-dl-prs-RelativePowerFine","paragraph_zero_based":2842},{"literal_text_all_w_t_and_m_t":"This field provides finer granularity for the nr-dl-prs-RelativePower.","paragraph_zero_based":2843},{"literal_text_all_w_t_and_m_t":"The total relative power of the DL-PRS Resource is given by nr-dl-prs-RelativePower + nr-dl-prs-RelativePowerFine.","paragraph_zero_based":2844},{"literal_text_all_w_t_and_m_t":"Scale factor -0.1 dB; range 0 to -0.9 dB.","paragraph_zero_based":2845},{"literal_text_all_w_t_and_m_t":"NOTE:For the first element in beamPowerList, this field is not needed.","paragraph_zero_based":2846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2847},{"literal_text_all_w_t_and_m_t":"–NR-TRP-LocationInfo","paragraph_zero_based":2848},{"literal_text_all_w_t_and_m_t":"The IE NR-TRP-LocationInfo is used by the location server to provide the coordinates of the antenna reference points for a set of TRPs. For each TRP, the ARP location can be provided for each associated PRS Resource ID per PRS Resource Set.","paragraph_zero_based":2849},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":2850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2851},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfo-r16 ::= SEQUENCE (SIZE (1..nrMaxFreqLayers-r16)) OF","paragraph_zero_based":2852},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfoPerFreqLayer-r16","paragraph_zero_based":2853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2854},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfoPerFreqLayer-r16 ::= SEQUENCE {","paragraph_zero_based":2855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"ad5861da0dccef1291129531d32d787af0fd13713ef27f554120fd6d7dfa3c8b","original_member_sha256":"85e43ed4cce9951e9169dd51891e9ea74001bd66e886c9b8fd4a0c481e900934","paragraph_ElementTree_utf8_XML_sha256":["4a39041593a1a8f81690622fd6258ab55de40bdc3148078dca0179b132dab104","5bb9e3d8da225ec9e32dde10e9d5d2a631ede2f512186c834f24cc52675a5cbc","ae4fe6a10bd68b050f6ad4e5ed7c3661ee0dc15a00d41f4f57599bb29aae1a19","32b2213625aeefdce2ef21de261eeb306748cdb44dc3df889ee397f7b2752409","01ee25bf71825428f4b5bc7f172ece864200320942ab70694ff3b3ef95165c21","79a2913cf84428f6dc95a10792a36c5c44954c160c65735b0b03e279c2f65c74","480bde298203e1f935ec826d58a937e05e63238396ca567635b897939ea928b6","318a7db3944e9474323b3e9e3a85e9c9830b43e4cd07e28d9b8f31913b6fc402","815d6161140e0cdfb1c44efd037530e4ef9f6b890af71845cd69146801536619","2bfee3413f7362f6f3bfbe14c245bdcd79275af5ef633625859a2197fa5fc541","eb93c77679e943e303220036bc749b3134bc26257d635b42cc297a17d2de24c1","ae1591d5e93f1fb568972e2ac7890f7e028ec44087c1ebc65dc7430acc3962da","723439a49ca2e1f60f4e5755c389f85690d9f4d999dba73397836fe07579651e","18b9f4b9a03e412bca732e6629b0271a4c52a835b8896608084a55f0b53917f0","1e10477a28a03496087167d6dfecfc8ee4e501792e1ccb9e9ac558f17f4b16bd","eef8110633e11d1111d6b7fe9369e4c79a85b8ed61d12e94b57d28c044b2743c","4b2abd443d3d63c1ecd58e3baf57d2f2d8581919f5981fc15cd6b96a8d00a4a0","aa3eb3ff585a04c36067b4c4300d4d51f47c18c6620fc3c98bfb8c054706cc15","74d8d93e7fd03ec76d8a2e8958c671af03c6d893474c858b0d2e6ebe4e9d51de","e5c97b309b0b836c336935849af612701c67cf888af1f6d4ece3cffcb389bce2","015fa9a0a207488d6525764b97db55e51275b9f03d3de6819cd542804eeb14b2","24515c8a59a8aec7d16e9113e8a14bd472ee4ac6cdb3a55b986ef9d131c8a406","29d431e628c14507ae02fde47dca385bb726b7a61b1b9ffd5d4a249ff928d131","2d059ff62024307760b92f0d2b5bc64cfc51f650269157faa6a3b72b8975d68d"],"paragraph_range_zero_based":[2832,2855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p2832"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"referencePoint-r16ReferencePoint-r16OPTIONAL,-- Cond NotSameAsPrev","paragraph_zero_based":2856},{"literal_text_all_w_t_and_m_t":"trp-LocationInfoList-r16SEQUENCE (SIZE (1..nrMaxTRPsPerFreq-r16)) OF","paragraph_zero_based":2857},{"literal_text_all_w_t_and_m_t":"TRP-LocationInfoElement-r16,","paragraph_zero_based":2858},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":2859},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":2860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":2861},{"literal_text_all_w_t_and_m_t":"TRP-LocationInfoElement-r16 ::= SEQUENCE {","paragraph_zero_based":2862},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID-r16INTEGER (0..255),","paragraph_zero_based":2863},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r16NR-PhysCellID-r16OPTIONAL,-- Need ON","paragraph_zero_based":2864},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r16NCGI-r15OPTIONAL,-- Need ON","paragraph_zero_based":2865},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r16ARFCN-ValueNR-r15OPTIONAL,-- Need ON","paragraph_zero_based":2866},{"literal_text_all_w_t_and_m_t":"associated-DL-PRS-ID-r16INTEGER (0..255)OPTIONAL,-- Need OP","paragraph_zero_based":2867},{"literal_text_all_w_t_and_m_t":"trp-Location-r16RelativeLocation-r16OPTIONAL,-- Need OP","paragraph_zero_based":2868},{"literal_text_all_w_t_and_m_t":"trp-DL-PRS-ResourceSets-r16SEQUENCE (SIZE(1..nrMaxSetsPerTrpPerFreqLayer-r16)) OF","paragraph_zero_based":2869},{"literal_text_all_w_t_and_m_t":"DL-PRS-ResourceSets-TRP-Element-r16OPTIONAL,-- Need OP","paragraph_zero_based":2870},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":2871},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":2872},{"literal_text_all_w_t_and_m_t":"trp-LocationCartesian-r18RelativeCartesianLocation-r18OPTI