 annotation."},"source_row":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx:p3384"}
{"fields":{"filename":"R2-2305891.zip::R2-2305891_(LPP CR on local coordinates)_v01.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ProcessingCapability-r16NR-DL-PRS-ProcessingCapability-r16,","paragraph_zero_based":3408},{"literal_text_all_w_t_and_m_t":"periodicalReporting-r16PositioningModesOPTIONAL,","paragraph_zero_based":3409},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":3410},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":3411},{"literal_text_all_w_t_and_m_t":"ten-ms-unit-ResponseTime-r17PositioningModesOPTIONAL,","paragraph_zero_based":3412},{"literal_text_all_w_t_and_m_t":"nr-PosCalcAssistanceSupport-r17BIT STRING {trpLocSup (0),","paragraph_zero_based":3413},{"literal_text_all_w_t_and_m_t":"beamInfoSup(1),","paragraph_zero_based":3414},{"literal_text_all_w_t_and_m_t":"rtdInfoSup(2),","paragraph_zero_based":3415},{"literal_text_all_w_t_and_m_t":"beamAntInfoSup(3)","paragraph_zero_based":3416},{"literal_text_all_w_t_and_m_t":"}(SIZE (1..8))OPTIONAL,","paragraph_zero_based":3417},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-AssistanceDataSupport-r17SEQUENCE {","paragraph_zero_based":3418},{"literal_text_all_w_t_and_m_t":"type-r17LOS-NLOS-IndicatorType2-r17,","paragraph_zero_based":3419},{"literal_text_all_w_t_and_m_t":"granularity-r17LOS-NLOS-IndicatorGranularity2-r17,","paragraph_zero_based":3420},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":3421},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,","paragraph_zero_based":3422},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedAoD-or-AoA-Sup-r17BIT STRING {eAoD (0),","paragraph_zero_based":3423},{"literal_text_all_w_t_and_m_t":"eAoA(1)","paragraph_zero_based":3424},{"literal_text_all_w_t_and_m_t":"}(SIZE (1..8))OPTIONAL,","paragraph_zero_based":3425},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-BeamInfoSup-r17ENUMERATED { sameSet, differentSet, sameOrDifferentSet }","paragraph_zero_