a52d04a20ae928b42a5fa643e6677c3d314b652a4309cde06","original_member_sha256":"18536e53a580a3c3e340d54874eeb9406a7cf49faf8633e5de53d7de7c7fa610","paragraph_ElementTree_utf8_XML_sha256":["686f6945abd102ba0ffe5b79ba43836778f61f7aef17a07273dbe4cdc730874a","91e52e6eb680a98232b3d98ce4975ade610609d99fe97b9ad873f76818be184e","f6a3dc2f82c506e670822e36199366d4c7016804dd8f18d600d59d29400226ac","87e261a4fe9a4e44e784863f99e5efc829c19a16243ea77350864c873c0df226","393706177df2100ce59c6ecf8fc246670fae06a549ebbad13181f9861f04296b","8470ea2573fd0db966a0b45506954f5ca66caf78aa090f1b11943115d7096eff","b0ca5df916c21f5e0e9247cd9c1b9d6d0a4656b418ff6969974d01d46cc2ef37","80e8da23152d52f2ec37f545a945b94d5803b86f4f2a9ab39d45a220f13e93d2","bde739416edb4e69849e437258bb008bbf1c206d790db657d4a50ff9eb3adfce","9a705d30399fb1f59a390e556457a23bf3393ae6a1ef9ba721a7f39567243a4b","5d91eb5ee58da8a3e792d21d2305fbbe02d7434eea7880745118a01b256211d9","5a8fb6c2879184924b79543ce0ea22c012a199de75fd5c32c36e819d668a8d6d","458f03f3d63c4322ffd93a8d5d1a60d7133256e615ff02f0e43b4dbd3753d000","83bff799c0019ed1bb5e51cdb10fe12ef32d7ea3612085f6ce3dadde282fcfec","4bc4e29e2ba24cc277d9c6bafad3d96a4ae9c53af2c41b2f2b80123d0ab7c6d1","d6530ba082f95e0b42c25557978a77639eaad59e0a14e8ef741e4f28a4274b38","55a24e63d5c0b2d736901378079faeae23e3dae2ff2544b3e5914b6bc084b7cb","c7c4395d5b53a49afac1e764a7f54dc8f2ca096eb8ef4a46090b5d326d6e7682","7c18da1c4b70c868c423a67e457b59d150520416b7a41ab12952058f6b809122","fa021a1ebbfcecf69cbd0c396b42ab6920147c37654279cf010c92b76c1d84d4","d2e1827a8fc4c75095d5d4e6891db81d015efda1e4f7b382b7c297f116907548","b831d2d3e124a96571e2507a6569aff3cdae755fbf3c8e345b7bd874bad25637","13c933124b635d0c4f93b7bf419f32f20cc7350b74eb62b89564be529169fcf1","ab11f334dca9d78b4089d55503aeebdb983fa410d5ce82446c02f2eefdbc17dc"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2302839.zip::R2-2302839 - 38300_CR0649_Rel-17_Correction to 38.300 on IUC Terminologies.docx:p24"}
{"fields":{"filename":"R2-2302839.zip::R2-2302839 - 38300_CR0649_Rel-17_Correction to 38.300 on IUC Terminologies.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-17","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-15(Release 15)Rel-16(Release 16)Rel-17(Release 17)Rel-18(Release 18)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"     Rel-19(Release 19)","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"The two terminogies “UE-A” and “UE-B” are used in the description texts on IUC. However, the two teminlgoies are not defined, and therefore should be avoided being used. ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"The changes were discussed in RAN2#121, see the below chairman notes","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"[Apple]: If we use “UE” and “Peer UE”, it may bring more confusion because “UE” and “Peer UE” can be switched in the role. [CATT]: In our view, no UE vendor would like to see UE A or UE B in the spec. [IDC]: Agree with Apple. [Session chair]: Let’s agree with the principle, and see the corresponding corrections next meeting. ","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"“UE A” is changed to “UE” and “UE B” is changed to “Peer UE”","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Correction is invited next meeting. ","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5acf77e0c3f4b05a52d04a20ae928b42a5fa643e6677c3d314b652a4309cde06","original_member_sha256":"18536e53a580a3c3e340d54874eeb9406a7cf49faf8633e5de53d7de7c7fa610","paragraph_ElementTree_utf8_XML_sha256":["6c14188b935b71c193d6e88beab856351147c70ff8d4348a6e87fcd8c73e7fb9","b0a809ef3d489b75d5885f0fd106c2212f09a2f99dc066d4f6f3a4e7a42a5f14","55e2bda6c9596d29300468ee28cbff2b65a3344f6596140bf712e5e027ee1166","b10cc07f5fd694b129fbbc5076893a354db3ef9208ec057f546d2901bf4c71e8","6800356d20b56d6e56cd4bc8f075b32b66392d20291e93fb5b543d9ff25e3528","7ea33120eaa33c256662eda67c055565e1877b94ad96a6c6390c1a6223c7f914","224417853c2536e2e9a02f1beb0ac2155a24bb8e4b9bcb45112811525a765a67","b809d4fe2f6f4214d409c8e352af1f3edae0e4e400b8e328cc0fd3230716121d","db883d8887470c61e71d3b42715abaa4c86b364edaa57d2316437a4b9908a3b1","49193f0680870b23ee68f45f6ebde151d353198122730dc52f031120fcb76ddb","20ece7df4fcc561e6207ff53152a190af027fc33b1abcb0ccb58d347a8e43ee4","b9bc6977f1abedcd15b18b762ea84d40304107eba31a1727be490b4c2b061c04","10dddf03bf6a9eb1ac12a281a941a328b81d01279928a7469aa9d025e7c671c2","d91f7f26bf6342647586c7ce2c38f0895d71be2eef20adddd59f3d5267fa0ecb","a7dbf7677782a66444d5af632d5dbd6192f16beb274d64458e736069facff779","3bf574222ae22b640a75b7a284e32e1ce49a9ffec23070ded80bef433a896e6f","e8b1a38c20be9c6c6ec2443a18f8cd1678c2d05e91d87bd33d0d69da76d2d479","702bc481b6a4dfa5c2c60a2c25cea0f7ca57d1fd351d93ef4be2376e4dc97d44","f71f2381bfccbf56ad92ab76c38ee4059343e0f9543c02ac39a0289843334a04","90a3c84e4c64b3a694505a4e6ef61a4b8fcad3c174be0d2f02d867a5cc309155","f81cc4fafe26d5148abf54e34180cfd1a57ebe6d9c64467dfde6c4c3ac6ea84c","ec96597b06cfe9e514c2abfbff525e4a9eb2d8b5892c63369ccd416493506308","0c050a72c03e8c896afb0566ebf23a69a75f9ea82c9a8cf6ec4991968bcffb9e","4d77ec1a9866eb8f55adce89a3212e7e79d1b8b2ac27b65d68da4b06e9a25c09"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2302839.zip::R2-2302839 - 38300_CR0649_Rel-17_Correction to 38.300 on IUC Terminologies.docx:p48"}
{"fields":{"filename":"R2-2302839.zip::R2-2302839 - 38300_CR0649_Rel-17_Correction to 38.300 on IUC Terminologies.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Removal of terminologies “UE-A” and “UE-B”. ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"This CR has captured the same changes as what have been presented in RAN2#121 with additional slight changes highlighted in the below","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"In scheme 1, the transmission of IUC information from a UE can be triggered by a condition at this UE, or by an explicit request from a peer UE or by a condition at UE","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"We swap the order of the text “by a condition at the UE”, so that it is clearer which “the UE” is with regards of “a condition of the UE”","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"Impact Analysis","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options: NR SA ","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"SL IUC","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Inter-operability:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"If the network implemens the changes according to the CR, but not the UE, there is no inter-operability issue, since the changes concern only UE action.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"If the UE implemens the changes according to the CR but not the network, there is no inter-operability issue, since the changes concern only UE action.","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"If one UE implements the changes according to the CR but not another UE, the both UEs may have different interpretation to IUC functions as captured in clause 16.9.8. This may affect IUC trigger and report between UEs.","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"UEs may have different interpretation to IUC functions as captured in clause 16.9.8. This may affect IUC trigger and report between UEs.","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5acf77e0c3f4b05a52d04a20ae928b42a5fa643e6677c3d314b652a4309cde06","original_member_sha256":"18536e53a580a3c3e340d54874eeb9406a7cf49faf8633e5de53d7de7c7fa610","paragraph_ElementTree_utf8_XML_sha256":["2af6227200b7c74405234d0735a87058bdf487ebc370c4f6a040c516ecdc1620","8573f219ed945c2a90dad86226b9eb27b1543ba77791fb19f03c7483805c24d9","82e59579b0a4f07618f859b870afebc1e8fc9adf62844e08d78f43cdb4140841","514e47b1c35576d44190bae82b347c3e3a8bffad1fe06a575a6d8114c7d64a1f","87036da42776086a40c8a5c5f666dbee1533b1a8adf476f6587d5e58171edd5d","5682da232684dddfbc1a91267c2aca7ae4fac4c82b87f500667e3d1c870f2413","be487edae45997031a2749669527e93596447589532ce530d3c267d32dda8a56","d5283c03eac1b132686b2a5fdec2ff8e6f8950647a3f5a0f5044b319ab0a384f","c77f9e89bbf46fefda28028a31d60801a5f88fa6496e85e439ff6476477f3050","767f2ae3f4aa7edc0537c744421c62fdca77e85de3af94fd3b24ece43