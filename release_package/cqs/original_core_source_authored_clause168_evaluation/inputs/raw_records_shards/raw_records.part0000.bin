{"fields":{"filename":"R2-2312910.zip::R2-2312910 38331-h60 NES merged CR.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9552},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-STOP","paragraph_zero_based":9553},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":9554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9555},{"literal_text_all_w_t_and_m_t":"PagingRecord field descriptions","paragraph_zero_based":9556},{"literal_text_all_w_t_and_m_t":"accessType","paragraph_zero_based":9557},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to the PDU sessions from the non-3GPP access.","paragraph_zero_based":9558},{"literal_text_all_w_t_and_m_t":"pagingRecordList","paragraph_zero_based":9559},{"literal_text_all_w_t_and_m_t":"If the network includes pagingRecordList-v1700, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix).","paragraph_zero_based":9560},{"literal_text_all_w_t_and_m_t":"pagingCause","paragraph_zero_based":9561},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to IMS voice. If this field is present, it implies that the corresponding paging entry is for IMS voice. If upper layers indicate the support of paging cause and if this field is not present but pagingRecordList-v1700 is present, it implies that the corresponding paging entry is for a service other than IMS voice. Otherwise, paging cause is undetermined.","paragraph_zero_based":9562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9563},{"literal_text_all_w_t_and_m_t":"–RRCReestablishment","paragraph_zero_based":9564},{"literal_text_all_w_t_and_m_t":"The RRCReestablishment message is used to re-establish SRB1.","paragraph_zero_based":9565},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":9566},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":9567},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":9568},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":9569},{"literal_text_all_w_t_and_m_t":"RRCReestablishment message","paragraph_zero_based":9570},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":9571},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCREESTABLISHMENT-START","paragraph_zero_based":9572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":9573},{"literal_text_all_w_t_and_m_t":"RRCReestablishment ::=              SEQUENCE {","paragraph_zero_based":9574},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":9575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e6da965682bd316cba86572597901ea384f59f1fc16f9cae6cc2322c6ca66446","original_member_sha256":"98ba9f2b5573fe46d64ecaac42249cc03885c5438afddaea698dae3590b59c3c","paragraph_ElementTree_utf8_XML_sha256":["bb4bef2810b0192f0ad54aa713784e380625a3c8b7407e1e97244f3c9498cba0","6fb5f1494fb38a9ba8016a77e5418a4b355d9bbf0e223a56bd8c9e182009ab40","dcd26223d34930df1a95b4d41e35ced446ec25bafff4777d5ec2156be0a02e1d","209905d36805514f1ca35c66834b96ad557ca7f6d61897301ba9ee78c6781d95","dd5d5b026bd0aa65865f79b6e681f89bc76bb0e2abdb40594f2720801e13b894","a891756dc34cc295c275ac1b7773b6d5fff8f854547e2593690672f725a4b8d1","8d0dba2b2614b043b0c5f41e678a37273c48b7b2f42b058cfb87ac24232ad59b","de57c14a6f4641366ab15249f007208d716fa9190418a427d7d6fa590a759fff","241f3c78d8b97a1e41f17103f15b49d84edbdab7c0cc9661eed59afa6026f3fa","9dfa380be67715a3eff6bc79bf88f6b1e7c3282c8aa34c410c08aa5bd43da3fb","3395839e281ccef2a2c2741dd620cacac26eb02e521f1f5ab2248a75cacaf243","94c2aa6701c064ddb8c5917bda02071969c1c80723b09dbe83c041fe71517822","6b9983220e7401e122a