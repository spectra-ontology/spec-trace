{"fields":{"filename":"R2-2312230.zip::R2-2312230-UAV-RRC-CR-Update-v07-rapp-cl.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be mapped to the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40920},{"literal_text_all_w_t_and_m_t":"sl-MappedQoS-FlowsToReleaseList","paragraph_zero_based":40921},{"literal_text_all_w_t_and_m_t":"Indicate the QoS flows to be released from the configured sidelink DRB. Each entry is indicated by the SL-PQFI, which is used between UEs, as defined in TS 23.287 [55].","paragraph_zero_based":40922},{"literal_text_all_w_t_and_m_t":"sl-MeasConfig","paragraph_zero_based":40923},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink measurement configuration for the unicast destination.","paragraph_zero_based":40924},{"literal_text_all_w_t_and_m_t":"sl-OutOfOrderDelivery","paragraph_zero_based":40925},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the sidelink radio bearer is established.","paragraph_zero_based":40926},{"literal_text_all_w_t_and_m_t":"sl-PDCP-SN-Size","paragraph_zero_based":40927},{"literal_text_all_w_t_and_m_t":"Indicates the PDCP SN size of the configured sidelink DRB.","paragraph_zero_based":40928},{"literal_text_all_w_t_and_m_t":"sl-Resetconfig","paragraph_zero_based":40929},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration should be applicable for the RRCReconfigurationSidelink message.","paragraph_zero_based":40930},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Header","paragraph_zero_based":40931},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present on this sidelink DRB.","paragraph_zero_based":40932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40933},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationCompleteSidelink","paragraph_zero_based":40934},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationCompleteSidelink message is used to confirm the successful completion of a PC5 RRC AS reconfiguration. It is only applied to unicast of NR sidelink communication.","paragraph_zero_based":40935},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SL-SRB3","paragraph_zero_based":40936},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":40937},{"literal_text_all_w_t_and_m_t":"Logical channel: SCCH","paragraph_zero_based":40938},{"literal_text_all_w_t_and_m_t":"Direction: UE to UE","paragraph_zero_based":40939},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationCompleteSidelink message","paragraph_zero_based":40940},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40941},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETESIDELINK-START","paragraph_zero_based":40942},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"88ac48b8abb8e582293899eb6fcf429cfe666bf19f2b5195cc18f96b95e0fc00","original_member_sha256":"b9eae4c3bdf5a2993a73f949e5986a1204cf998aea465f31f717a8289e1b579d","paragraph_ElementTree_utf8_XML_sha256":["3a24db023796b31e053a396f73e33afda1c086669c1cbb336cd8a4d02a4d31f1","26e9c041a608d506a916d7b8afe853f44a67329002507f58554aaa159c50c7e6","d341233e7aeb0cc21f8a0c9e4be46776ebdd3ac8528780bc7362632848eabfd7","ace65612905db872df7fbaa2e2cae4dae46c0aeffb92ae775084c9869ea934d9","0132e2df278ce0cae7f9fda4fe40f05fff906fb7609d1a931c938982808ec538","834a9a1876801836f69ca39833913c0474572ea8465c44339a127ef90c21f5a5","2be502eb654ecbb9e8b7ad91accc956122fde9bdf3cadb08230326ea0561ea24","69a6e8bb895fefd1e957678321a62ee7921630401f87f17291af16beca6375b4","5c44436651213c46625fe06e4656