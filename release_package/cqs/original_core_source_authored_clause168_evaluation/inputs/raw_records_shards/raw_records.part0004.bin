a25fedf3b11032afb3708a04bd8e407a78d29c40ebc87","78b9c5c8c2aff7e41018e0f91c9590c6f69c66f5558713bbcaf189d914d37e44","e31eaf8e1ba046d9a5df3ff07cfd2cc8e56057a7904a6b266a1e6de0e1f18112","2e539a63b976fb58834a09afc7ee94cd626cddea87ee4a7eadca6287b2604147","4f6cb468f19739bcf51ba0d9abc829de7c83f77fea483bf1bf8201da60d8e62f","c10e322f3dc672597bf7cffaf0b00b392f354a110393f63b0dbd415062f49b01","f1483fbe80cc709ba617af72ff5bc16132c5e903fe1f973024d50d95130c9e55"],"paragraph_range_zero_based":[14496,14519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14496"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14520},{"literal_text_all_w_t_and_m_t":"SidelinkUEinformationNR field descriptions","paragraph_zero_based":14521},{"literal_text_all_w_t_and_m_t":"sl-PosRxInterestedFreqList","paragraph_zero_based":14522},{"literal_text_all_w_t_and_m_t":"Indicates the index of frequency on which the UE is interested to receive NR sidelink positioning. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB23, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB23 and so on. In this release, only value 1 can be included in the interested frequency list.","paragraph_zero_based":14523},{"literal_text_all_w_t_and_m_t":"sl-PosTxResourceReqList","paragraph_zero_based":14524},{"literal_text_all_w_t_and_m_t":"List of parameters to request the transmission resources for NR sidelink positioning for the associated destination.","paragraph_zero_based":14525},{"literal_text_all_w_t_and_m_t":"sl-RxDRX-ReportList","paragraph_zero_based":14526},{"literal_text_all_w_t_and_m_t":"Indicates the accepted DRX configuration that is received from the peer UE and reported to the network for NR sidelink unicast communication.","paragraph_zero_based":14527},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedFreqList","paragraph_zero_based":14528},{"literal_text_all_w_t_and_m_t":"Indicates the index of frequency on which the UE is interested to receive NR sidelink communication. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":14529},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedGC-BC-DestList","paragraph_zero_based":14530},{"literal_text_all_w_t_and_m_t":"Indicates the reported QoS profile and associated destination for which UE is interested in reception to the network for NR sidelink groupcast and broadcast communication, or for NR sidelink discovery or ProSe Direct Link Establishment Request as described in TS 24.554 [72], or for Direct Link Establishment Request (TS 24.587 [57]).","paragraph_zero_based":14531},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRemoteUE","paragraph_zero_based":14532},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the Source Layer-2 ID to be used to establish PC5 link with the target L2 U2N Relay UE for path switch.","paragraph_zero_based":14533},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReq","paragraph_zero_based":14534},{"literal_text_all_w_t_and_m_t":"Parameters to request the transmission resources for NR sidelink communication to the network in the Sidelink UE Information report.","paragraph_zero_based":14535},{"literal_text_all_w_t_and_m_t":"sl-TxResourceReqList","paragraph_zero_based":14536},{"literal_text_all_w_t_and_m_t":"List of parameters to request the transmission resources for NR sidelink communication for the associated destination. If sl-TxResourceReqList-v1700 is present, it shall contain the same number of entries, listed in the same order as in sl-TxResourceReqList-r16.","paragraph_zero_based":14537},{"literal_text_all_w_t_and_m_t":"ue-Type","paragraph_zero_based":14538},{"literal_text_all_w_t_and_m_t":"Indicates the UE is acting as U2N Relay UE or U2N Remote UE.","paragraph_zero_based":14539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14540},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReq field descriptions","paragraph_zero_based":14541},{"literal_text_all_w_t_and_m_t":"sl-CapabilityInformationSidelink","paragraph_zero_based":14542},{"literal_text_all_w_t_and_m_t":"Includes the UECapabilityInformationSidelink message (which can be also included in ueCapabilityInformationSidelink-r16 in UECapabilityEnquirySidelink from peer UE) received from the peer UE.","paragraph_zero_based":14543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0b65ebc27393dd32e101fbd0984d439b4ded331570928a0c2d314bb1c7c260c1","ed01f18f54d4a1a1a82515351a8bd3eed115a3efe429783eb2ae234b03f01c6c","a8bfcef306f8cf71fc2e555e2b3278397f400470c742a3f5db7915fb64ff8a24","cf0b276ff6e8b6bfe18d30a47f37ffa07a17f095eb0fcb3700f09d133c6831c0","c9489bbe58b118189f0486a79eddf7145e18a63644cfaab0129b5796119bbb7c","2c0ba1a82caa555638d464e15434048b84d5e97f1500f4252fc60e04b48ce4ef","1c4c300c66990c38d82dcafe603489e6cf0e5d6944f064a3007103fc54f65951","f062407926ff5830aa6f045d2a5bcc1f0b68f8026466b870080c28da4b4ad359","987ff6be45090c55e878e1b9bead7c8a526a3897608c7283a86d5a91d39d164d","10b66eb7063f2b1a25af8c43f3c068d12742f5725be8244f0bf1689d2d4ebbca","47c6f003bb54198f5d26484400499ee3d81e7584813aca862dfc19e71333a6ff","917f4d5502ad74cacb79afc5627cf017fc32407d9fe3f03c2045884279a5e049","45ddddd996451776d5bb6f11aea832333bf603d646668e7f062939c0b312877f","e395ab97ba4a6ed6b3e30a0309e686775ec1cee0beb8ee83f1e221b8f35ca459","73da41ec361f6b5797827da542aadbecdd977b2ef9e7573f43b614f52f247042","23473f87633db3fada8e31a1658b4adb79bdb70b7792645652d0df6bdf0b1d1b","1136611e9c3824b931856eb6125c5171f596fe65897cfb79fa3a18c56e1e7269","2eb6d14cc780924bd28f52219148df2320ef3c8bca58d13919cf9773dbc4eeea","9737049d4c0f4c50bb266bcfa5fd7564d1e36055fd740012cdbb419bf7ab438a","d2e063495850912c6aa876d59525ab1244431f33d7b9abd69324b034c1512dcb","71988adb796be3f19e0a4069d578e63f3904263b02c5537e4078fd19a61a07fd","69f00942dc46c4fde340f24daf71df1a82c2254c3fa4b065af16ded100b143be","e38df978cf3375f5bd2019f85dde39329e0bed546ed5a9f645a4bd93aa1b1ecd","0c098f73a086e5d2ea81d4c7d187718dfaa38b3adb63cfe801d93746e0d98a8c"],"paragraph_range_zero_based":[14520,14543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14520"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-CastType","paragraph_zero_based":14544},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the corresponding destination for which to request the resource.","paragraph_zero_based":14545},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":14546},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the TX resource request and allocation from the network are concerned.","paragraph_zero_based":14547},{"literal_text_all_w_t_and_m_t":"sl-DRX-Indication","paragraph_zero_based":14548},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX is applied (value on) or not applied (value off) for the associated destination. This field is only valid for NR sidelink groupcast communication.","paragraph_zero_based":14549},{"literal_text_all_w_t_and_m_t":"sl-DRX-InfoFromRxList","paragraph_zero_based":14550},{"literal_text_all_w_t_and_m_t":"Indicates list of the sidelink DRX configurations as assistance information received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":14551},{"literal_text_all_w_t_and_m_t":"sl-QoS-InfoList","paragraph_zero_based":14552},{"literal_text_all_w_t_and_m_t":"Includes the QoS profile of the sidelink QoS flow as specified in TS 23.287 [55]. If sl-QoS-InfoList-v1800 is included, shall include the same number of entries, and listed in the same order, as in sl-QoS-InfoList-r16.","paragraph_zero_based":14553},{"literal_text_all_w_t_and_m_t":"sl-QoS-FlowIdentity","paragraph_zero_based":14554},{"literal_text_all_w_t_and_m_t":"This identity uniquely identifies one sidelink QoS flow between the UE and the network in the scope of UE, which is unique for different destination and cast type.","paragraph_zero_based":14555},{"literal_text_all_w_t_and_m_t":"sl-RLC-ModeIndication","paragraph_zero_based":14556},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC mode and optionally the related QoS profiles for the sidelink radio bearer, which has not been configured by the network and is initiated by another UE in unicast. The RLC mode for one sidelink radio bearer is aligned between UE and NW by the sl-QoS-FlowIdentity.","paragraph_zero_based":14557},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqList","paragraph_zero_based":14558},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication/positioning, for each destination. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12/SIB23, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12/SIB23, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12/SIB23 and so on.","paragraph_zero_based":14559},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSyncList","paragraph_zero_based":14560},{"literal_text_all_w_t_and_m_t":"A list of synchronization reference used by the UE. The UE shall include the same number of entries, listed in the same order, as in sl-TxInterestedFreqList, i.e. one for each carrier frequency included in sl-TxInterestedFreqList.","paragraph_zero_based":14561},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14562},{"literal_text_all_w_t_and_m_t":"SL-Failure field descriptions","paragraph_zero_based":14563},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":14564},{"literal_text_all_w_t_and_m_t":"Indicates the destination for which the SL failure is reporting for unicast.","paragraph_zero_based":14565},{"literal_text_all_w_t_and_m_t":"sl-Failure","paragraph_zero_based":14566},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink cause for the sidelink RLF (value rlf), sidelink AS configuration failure (value configFailure) and the rejection of sidelink DRX configuration (value drxReject-v1710) for the associated destination for unicast.","paragraph_zero_based":14567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3254769b5f2adc6c97550ae4ce5595e152d1a52478e33570e5c2d03e6cc6b9c3","f59743859dc6c1d9c417b222b54cd0352ae28816c28b68479b723be01bd47290","779328af90b1b3995b48535bf4a5e3eabaa1c565cd813f3ba763a5a6f4c3e787","8943a881549a8cee7b094655e7ab66415cc589cf819a8ecc88589f2475401050","7fcffb981e7c866e13dfbdb23f4250430068d15a0ed5ce007abbc17e018fd347","b6aeb22b86739090df7d06de06799661d9de2ce91a42c6dfd9b973f77815bc1f","a2149e2685fbbc03df525dd8ec2836b5108e9c7ac0faa27e7d78ce46d93dae0d","2a08881699a2b4397bac8a842680651a0c4bae1a0200100ad380a30b9bdaf3d7","ed16fa0a8d955a8432c485e06bf1a3e660ec88114b90828286c11e67e7a7ae70","71b5d3b8a0fc1fa3923e600f1977f1d81a025c2e325d63cfafd697817eee1476","2a4648c1eaad6a62c2a0c6310371caff4d9f556ad4b0217e6435c09216a9fb0c","12ad1f9895847103780dbc3b2c5b8b21647aa4c8cef48eb4247bb2c9d3fb6584","7f113902698a2dd85657d353db9c6bae3e5c44200c2668a4224e7f1d15b63337","8c9341b139389dfd65eb5fdd391f71496f5fe3f8ba00db6a129e574e48947312","e93dd4a8d67f16192bf10b147036b221f4de5d990121af971a316999aba30552","00de5aad78d6912f9c0bac03d07aabc8bcf364753c624710d6306d7b3bedfca3","2882b6b6ef81d409e81543648d95da9643120540b19e45420f7f71a47c53b11e","7a7d88bb450f3b21f2bd2b8e8c6759a112c9c381128ad9abc2d572441528f5a5","ab58e380cc01a04f24cd0a5bbf4ef24c9bb1cb4b78ddad6630602dd2df575d83","4a04de77709cbf38347342707336d4fade76ce41abd7463300b3ca8ef69e638d","272ad0fd97d9e32974dfecdf27d2886b59520382794d52f750cf937ea8b31ee9","5c04cfe31227095ffdd2ffe3e64d96316e8534d95ad9f9cd097df675576d3b0a","f86672d070b02ef15ee0c55dd215a78cea76e1ae81b6d9a1653fd2b92ef142c0","8c636c6087c1c5d1e094e57a48b0653a6fa40eb445d932383cdd70935d0d1b14"],"paragraph_range_zero_based":[14544,14567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14544"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14568},{"literal_text_all_w_t_and_m_t":"SL-RxDRX-Report field descriptions","paragraph_zero_based":14569},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigFromTx","paragraph_zero_based":14570},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink DRX configuration received from the peer UE for NR sidelink unicast communication.","paragraph_zero_based":14571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14572},{"literal_text_all_w_t_and_m_t":"SL-RxInterestedGC-BC-Dest field descriptions","paragraph_zero_based":14573},{"literal_text_all_w_t_and_m_t":"sl-RxInterestedQoS-InfoList","paragraph_zero_based":14574},{"literal_text_all_w_t_and_m_t":"Indicates the QoS profile for which UE reports its interested service to which SL DRX is applied to the network, for NR sidelink groupcast or broadcast reception.","paragraph_zero_based":14575},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14576},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqDisc field descriptions","paragraph_zero_based":14577},{"literal_text_all_w_t_and_m_t":"sl-CastTypeDisc","paragraph_zero_based":14578},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the NR sidelink discovery messages. Only value broadcast can be set in this release.","paragraph_zero_based":14579},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityDisc","paragraph_zero_based":14580},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for relay discovery and non-relay discovery.","paragraph_zero_based":14581},{"literal_text_all_w_t_and_m_t":"sl-SourceIdentityRelayUE","paragraph_zero_based":14582},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source L2 ID of relay-related discovery transmission by L2 U2N Relay UE.","paragraph_zero_based":14583},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListDisc","paragraph_zero_based":14584},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink discovery. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":14585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14586},{"literal_text_all_w_t_and_m_t":"SL-PosTxResourceReq field descriptions","paragraph_zero_based":14587},{"literal_text_all_w_t_and_m_t":"sl-CapabilityInformationSidelink","paragraph_zero_based":14588},{"literal_text_all_w_t_and_m_t":"Includes the UECapabilityInformationSidelink message (which can be also included in ueCapabilityInformationSidelink-r16 in UECapabilityEnquirySidelink from peer UE) received from the peer UE.","paragraph_zero_based":14589},{"literal_text_all_w_t_and_m_t":"sl-PosCastType","paragraph_zero_based":14590},{"literal_text_all_w_t_and_m_t":"Indicates the cast type for the SL-PRS transmission.","paragraph_zero_based":14591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ffc36b9916c0881f6ac73517961d4edcc78a22d034ecf42232423120b54fff79","040ea0625640d6e05fe19b05756be2e15e2d16aea4ba2dd06c968118c0cada30","3be88bc25c64af125c8093844b474c93288aa535b5f23a03a5aff972a446399a","28ee5f3671da8952aa45f05ab418f052b5cb75b64b2f4983c9a4506fa5798182","23055cad86460bdd5ec36cdf87f0dec3c1ea0e53167944b1aa342f7d161ab7c6","9c099d6171cb63000890b160c2d981004fbb16e1e125935082818a6ee59ecb8d","8d459db69c0ad4f9349f2a2cda02c69d077c620f0b055f5359ce000e67d4e34c","fc6616aef6b86171ef421c86aadf83f10f178b4c2253f7db4fc785bb4401f9f0","d3e6cdcf3bc1a3ef08aea7ff038fc8b697b11041ef41b2ea368548590ec3d1be","e292a5a87546afc02b6648b92f303fffc8f8b279c13f1483d7c3533405cc1132","28727662306d49fd86532d6155c33e3bb86d492ea7e7432481c7b1391ea77487","130478f7cd191da695ea95baeeca2192859483c95583d2f69e9ee1e8802e1c72","a6c09e4faaa81bd1030beb73ebd451bba45792ba99dc3e7723fe77cd1cc75be7","43a076c8aa68adbaa914d7d14a92a5e5d739b22e37df1622bbddfc5970588eb0","de159058d47cface6ff56f4d4d3f3c96e5f4d54f5b989555c6b612e7b6f95a19","9d485f620943c89dd701ab577f221a493abc8bc010d5c6a9c41aa017cd66ecfb","43b95abd207431ca367a2f1d1bf592d16c1777e5d83d04a66fa369ee13d6fec2","a6db5802328dcc57ad3f299396bb070bdb2791e19b216a22af353ba1b9ba32ec","77689525511597602313917820a2efad214194f86adb5ac39744dfcba225b074","ff48644dc2b62aad00389578eaf6e74fe9b2530524e1a29e485c0fcc5dc9bb84","86a3aa2fab9f52d059a56e0dba835fb9f9e5bb5b798bd11e7228c58dc997cd34","24f93fbc0cee4eb96f9ebb7753221ebef16e4794675b1974e8daf3c31d4c4900","c1468afa9ae876e1792ca49d271b8a23919a71b66d979fe313263cdc4f895219","2536972cc253f1cb3a894af499c2632068b8b0502acb04b4770a48189081a18f"],"paragraph_range_zero_based":[14568,14591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14568"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PosDestinationIdentity","paragraph_zero_based":14592},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for SL-PRS transmission","paragraph_zero_based":14593},{"literal_text_all_w_t_and_m_t":"sl-PosQoS-InfoList","paragraph_zero_based":14594},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the QoS information for SL-PRS transmission.","paragraph_zero_based":14595},{"literal_text_all_w_t_and_m_t":"sl-PosTxInterestedFreqList","paragraph_zero_based":14596},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit SL-PRS. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB23, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB23 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":14597},{"literal_text_all_w_t_and_m_t":"sl-PosTypeTxSyncList","paragraph_zero_based":14598},{"literal_text_all_w_t_and_m_t":"A list of synchronization reference used by the UE. The UE shall include the same number of entries, listed in the same order, as in sl-TxInterestedFreqList, i.e. one for each carrier frequency included in sl-TxInterestedFreqList.","paragraph_zero_based":14599},{"literal_text_all_w_t_and_m_t":"sl-PRS-DelayBudget","paragraph_zero_based":14600},{"literal_text_all_w_t_and_m_t":"Indicates the SL-PRS delay budget. Upper bound value for the associated response time provided by upper layers (see TS 38.214 [19]], clause 8.2.4.2).","paragraph_zero_based":14601},{"literal_text_all_w_t_and_m_t":"sl-PRS-Priority","paragraph_zero_based":14602},{"literal_text_all_w_t_and_m_t":"Indicates the priority of SL-PRS. Value 1 is the highest priority whereas value 8 is the lowest priority.","paragraph_zero_based":14603},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14604},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqCommRelayInfo field descriptions","paragraph_zero_based":14605},{"literal_text_all_w_t_and_m_t":"sl-RelayDRXConfig","paragraph_zero_based":14606},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the applied sidelink DRX configuration for the relay related communication.","paragraph_zero_based":14607},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityL2U2N","paragraph_zero_based":14608},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for the established PC5 link for relay by L2 U2N Relay UE.","paragraph_zero_based":14609},{"literal_text_all_w_t_and_m_t":"sl-LocalID-Request","paragraph_zero_based":14610},{"literal_text_all_w_t_and_m_t":"This field is used to request local UE ID for the corresponding destination by the L2 U2N Relay UE.","paragraph_zero_based":14611},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListL2U2N","paragraph_zero_based":14612},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication for established PC5 link for relay. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":14613},{"literal_text_all_w_t_and_m_t":"sl-PagingIdentityRemoteUE","paragraph_zero_based":14614},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the paging UE ID(s) for the corresponding destination(s) by the L2 U2N Relay UE.","paragraph_zero_based":14615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a1bcf086c6d88336049961beb1510fc86389d9d0866cc1a6d8449fe00bfc7d1c","68c60e92a414406bdb56399a2371ca9e2b9b0857e4ae27d1a432887fe93f1089","726c59792beb41f9dca65c3d179a443e12f370477885478c0bfbaa525630ff2f","0f25734ba2a844f54c789f9c6deeadba328ed2e2713ecd501dde210f2ed3f312","248aea30bbaef4d78b8c12e28a74bd597982846a339050bdbada030b599d68b2","0ebc63a27ed6c1451edcc8a683b62aa24c2305c7e44232b5b09746f3d42d6525","800dacc4e036d471a72f81bc92afe4a40cad1b1ed5d6f1aa3fed5a087fcea84e","989d2efeab9aa8c586e8a91cc09a44c2e8f0cce715116379ec3ab15b12a47e56","4dee57233b3d1a9a640e0e5fe0157dacea4574e35f14e4cb1b76167806f67361","3d2d814bc98b5d91eddeab7c0272d8cc3ee006248faba01f5d87b4279728afd3","01eab3f223cd6341c34c30a1476d5c7f4e76b7f662d29f4a317410054bf8d964","f87db34e825737aaa911126629f7f1c106ba941712d40554b4c1080b63c9b585","3a115a5c9801a3aa721e29668c810ecd45beed7a6fed3055cbed335ae441feba","b854a8f3c97433a4d2770f589b02153f1ffcd3dda0cce2395938646f49b45d16","b6fb67898e3049ec27602a6e5c7d42b1411f00e8bf5ff87c0ca0439cfb18d181","45315ad042ee00674aa5deab9cc573e813f68a1e90de7ac1f0b6e5ed06f407ac","916693501c74c1986f3ea483ee6b86cb3b12dd682e289b0a95f521639a6b8f18","d83eab73c9f0e15652a0ce34a340f2da1266d86b98a7637fd4959b52237f94c9","14486fe73ee20b3994d7b3692595aaaab63a880a7b8868baa8610890c85a6af6","a864879b7643e8a739d6fee154c3fd40599152e28c8365337c0d09f63089b6de","5115c1b2e32d6a27e24c0706916354b13f6d889cce9434badd1b4d1093b09c82","141a0e15edf3922e201f4e213d29cf34845b68e82b162a1e8fd3a00c8f6e8974","5c64103db8fe1e82cf7b49f713a89f7fed6f58e7df45ffd6487cbdb21e54c06d","7db03d05ae3b8e90eed31dbc0c4fd50c3841c1ad936dbce80efef28953d6b30d"],"paragraph_range_zero_based":[14592,14615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14592"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14616},{"literal_text_all_w_t_and_m_t":"SL-QoS-Info field descriptions","paragraph_zero_based":14617},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqList","paragraph_zero_based":14618},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication, for each QoS flow. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":14619},{"literal_text_all_w_t_and_m_t":"sl-TxProfile","paragraph_zero_based":14620},{"literal_text_all_w_t_and_m_t":"Indicating Tx profile for each QoS flow, i.e., compatibility of supporting SL CA operation. The IE of SL-TxProfile is referred by upper layer signaling as specified TS 24.588 [78].","paragraph_zero_based":14621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14622},{"literal_text_all_w_t_and_m_t":"SL-CarrierFailure field descriptions","paragraph_zero_based":14623},{"literal_text_all_w_t_and_m_t":"sl-CarrierFailure","paragraph_zero_based":14624},{"literal_text_all_w_t_and_m_t":"Indicate the carrier(s) where the per-carrier RLF has been indicated by lower layer. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":14625},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentity","paragraph_zero_based":14626},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the per-carrier RLF report is concerned.","paragraph_zero_based":14627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14628},{"literal_text_all_w_t_and_m_t":"SL-TxResourceReqL2-U2U field descriptions","paragraph_zero_based":14629},{"literal_text_all_w_t_and_m_t":"sl-DestinationIdentityL2-U2U","paragraph_zero_based":14630},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the destination L2 ID for which the TX resource request and allocation from the network are concerned for the established per-hop PC5 link between the L2 U2U Remote UE and L2 U2U Relay UE.","paragraph_zero_based":14631},{"literal_text_all_w_t_and_m_t":"sl-TxInterestedFreqListL2-U2U","paragraph_zero_based":14632},{"literal_text_all_w_t_and_m_t":"Each entry of this field indicates the index of frequency on which the UE is interested to transmit NR sidelink communication for established per-hop PC5 link. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of second entry in sl-FreqInfoList broadcast in SIB12 and so on. In this release, only value 1 can be included in the interested frequency list. In this release, only one entry can be included in the list.","paragraph_zero_based":14633},{"literal_text_all_w_t_and_m_t":"sl-U2U-InfoList","paragraph_zero_based":14634},{"literal_text_all_w_t_and_m_t":"This field indicates the information related to a list of end-to-end PC5 links. ","paragraph_zero_based":14635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14636},{"literal_text_all_w_t_and_m_t":"SL-U2U-Info field descriptions","paragraph_zero_based":14637},{"literal_text_all_w_t_and_m_t":"sl-E2E-QoS-InfoList","paragraph_zero_based":14638},{"literal_text_all_w_t_and_m_t":"This field is used by L2 U2U Remote UE to indicate a list of end-to-end QoS info.","paragraph_zero_based":14639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["235d984bf51fa440b6ee80298c057231eee408d0deaa1841a62162de44d4e021","f27d553c73550b41646749f879fb93352ac199081ae6c9c4b19882eda598d83e","bd918ba49c95f1976fc4caea6f57cf3114e416306b677b2e923194bd727687e7","d2c28a74357ef51443c58d8a428768f6539fd5d317eb1cec42cd561470be9f95","bee2f6c1f94cae98b63f242ee92c452d15b61a05d6b9479a5870830f5f6308e8","f2fb2141b83970fb45aa6b259fe48de5f120fee240c3f8341dacfdec7ee2a69b","31e7c71fd186974acf6920101fa2152b484ca229c557d7c8b90ec60a02b0f368","06fb7cac958821be3d0f458cdb16c6ef5fae18f15afa77483f136db2dba8669a","3c784c8d979cfe21f0c2a05b4e13d7f24e6bfa95906bb4d694f7ad7080522a71","5cb3ba375d470b6990d1cdf012c39b8b91cacd2ed36c1ea3084dadf4fd13eefa","ce67e15ea3129c554298f03d865469d41218647822173c56af70c8f42cf04b6a","37cb06289bac18a34e24a893716eabcfc1bbf0075efdb9c27a397512d1b2784e","7a28c6ba08c48715d60693d0e998ce5f222d4333f718e0c6559da61208969082","3585565239851074f79d821fb0fe551de737e1d15adf7d44ce995ce1c185103e","47786d60f7b3d919091824910ab2be08c7f1071a256df1fe3551fc2b767bb583","1b2eb2314a725abf3597c85790a313d61139da5baec6a3148b2c78b986978498","15c9403163d5299919ac2910d3406e563f7a9a991ce6c57fea7041a909701dbe","51eccf533472d6b05085057d260dde9144686170c83fa9b57afef28922b5a638","8f8aa16306132cd9756dec73a3d71636c4ff8039f212509e8e33ac9b82135534","c433e2f9f6a2290a9308a3918bef82ed51c3f2b5afc9d5c0d966df337aeed2f5","ff8edc3376aaf4b2de5d97f221d7c7947185eec651688c67ca824ed9c4b52ed9","6c3523d69baad9ff6bff7dcd18d8faa63e249341735c087b92c7cb0184fa7219","bcd16dbb2c6459ddb1e3e884f3d08e8207a3dd3a799341c68d36b512c1354865","dab03e46e21a8eeee9d316bd650450a3dc9f7bce376c36a6cdf55a1