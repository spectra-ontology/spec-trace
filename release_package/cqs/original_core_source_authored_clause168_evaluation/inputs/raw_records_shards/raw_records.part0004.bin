},{"literal_text_all_w_t_and_m_t":"2>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":7870},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the minimum scheduling offset for cross-slot scheduling for the cell group for FR2-2:","paragraph_zero_based":7871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0a62937083bec16e4268ccbca464d15b5a313959c553c3a26111d32fef40e85e","08b57af689118d81d722fcf165946a470e7210836a04b8830ce47b2f4fcd314f","92f6d841418e04187567355c3c05e4b0527f24040b95ef9c5af0be771131e4a5","88964998883b80b6eca7057bf0670bcec2bac0d73820dc16feb91def1782ff69","647cc6ce7683979cad13ce1c7966ffd90277dd911969597ec0f01fc34ed4f0cf","7ac18887162c36967a45fdf8a32972d66905085df13984502b5dc2916433ea77","0b5eb5a22e4e29bf5fd879c13a9fe6bebee6e790acd498d254e49341c32699ec","d56794d42772897454d81446d415d82be8000cc3983be612d4dd789f67218841","496f1fa3c7ffdc738980678ef218fd99548b9e5a55a86d686a5600e8175603f8","9b96a09a9ec5882161dcf034d8c9cd850971a0d93543542a8f210acd04abdd24","99c53cbb542141be43a193abc686a21f4a7a54fdb892845768298c6f107929e1","066163a3be7bfab41228140e43232e55dd76746bf33a9b93934bba916e808191","911805a21139f41e63c100203e1f2caa68edc75c0553c983d9730985f133c2fb","5db1843537cf11aafadb537681b35d209c3f48e2ec749c6bbb77aee2a62ea618","f1b3d344b4275a74e50f429b642e6d46a42e66f6b533707f50419bbc928872eb","80341b9199c5a10487e24167748628e40c4cf173b2b77aaac515a531ca527202","3ddee291854296e3852cd0aa78779667b8c74f9341ed0b06d6a6871aaecc14b3","067e24973e5c0d9e939bb6bcc5da90188a19a22d2d1d609a22a031091c9cbaca","875208fe1b4b86b4b8f13cedab577b433df4751e04feec2236a8942bd5600f97","daf693cd2efb451037d866fc6f52982c3af940355428