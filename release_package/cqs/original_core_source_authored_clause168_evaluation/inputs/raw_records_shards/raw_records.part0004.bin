docx:p24072"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToAddModList","paragraph_zero_based":24096},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to add or modify. Up to 8 G-CS-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":24097},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI-ConfigToReleaseList","paragraph_zero_based":24098},{"literal_text_all_w_t_and_m_t":"List of G-CS-RNTI configurations to release.","paragraph_zero_based":24099},{"literal_text_all_w_t_and_m_t":"intraCG-Prioritization","paragraph_zero_based":24100},{"literal_text_all_w_t_and_m_t":"Used to enable HARQ process ID selection based on LCH-priority for one CG as specified in TS 38.321 [3].","paragraph_zero_based":24101},{"literal_text_all_w_t_and_m_t":"lch-BasedPrioritization","paragraph_zero_based":24102},{"literal_text_all_w_t_and_m_t":"If this field is present, the corresponding MAC entity of the UE is configured with prioritization between overlapping grants and between scheduling request and overlapping grants based on LCH priority, see TS 38.321 [3]. The network does not configure lch-BasedPrioritization with enhancedSkipUplinkTxDynamic simultaneously nor lch-BasedPrioritization with enhancedSkipUplinkTxConfigured simultaneously.","paragraph_zero_based":24103},{"literal_text_all_w_t_and_m_t":"posMG-Request","paragraph_zero_based":24104},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to send UL MAC CE for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":24105},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR-SCell","paragraph_zero_based":24106},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for BFR on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":24107},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR","paragraph_zero_based":24108},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet1 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet2 of the same serving cell.","paragraph_zero_based":24109},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-BFR2","paragraph_zero_based":24110},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration (SchedulingRequestConfig) that the UE shall use upon detecting a beam failure on the detection resources configured in failureDetectionSet2 of a serving cell while beam failure is not detected on resources configured in failureDetectionSet1 of the same serving cell.","paragraph_zero_based":24111},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-LBT-SCell","paragraph_zero_based":24112},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for consistent uplink LBT recovery on SCell, as specified in TS 38.321 [3].","paragraph_zero_based":24113},{"literal_text_all_w_t_and_m_t":"schedulingRequestID-PosMG-Request","paragraph_zero_based":24114},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for Positioning Measurement Gap Activation/Deactivation Request, as specified in TS 38.321 [3].","paragraph_zero_based":24115},{"literal_text_all_w_t_and_m_t":"skipUplinkTxDynamic, enhancedSkipUplinkTxDynamic, enhancedSkipUplinkTxConfigured","paragraph_zero_based":24116},{"literal_text_all_w_t_and_m_t":"If set to true, the UE skips UL transmissions as described in TS 38.321 [3]. If the UE is configured with enhancedSkipUplinkTxDynamic or enhancedSkipUplinkTxConfigured with value true, REPETITION_NUMBER (as specified in TS 38.321 [3], clause 5.4.2.1) of the corresponding PUSCH transmission of the uplink grant shall be equal to 1. The network does not configure enhancedSkipUplinkTxDynamic or enhancedSkipUplinkTxConfigured with value true together with numberOfSlotsTBoMS-r17.","paragraph_zero_based":24117},{"literal_text_all_w_t_and_m_t":"tag-Config","paragraph_zero_based":24118},{"literal_text_all_w_t_and_m_t":"The field is used to configure parameters for a time-alignment group. The field is not present if any DAPS bearer is configured.","paragraph_zero_based":24119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a98cf57a46ef7820b07f843fdaa897c8adae70df2e511635b8daea425b34b6dc","033199ecb317f5066d4646cb4853b7a2d712f586dc2046d99d75a2c3a17446f1","0f69a2920201efc2afc4d376bf4c7b18a046ffc8cf41f224b257c69e92da7324","d61069d9f63dec3b0f22442cbf2a711131f2d93701e9d4bd69b48d12a5d30cb6","3cc533a718bd95e1140568bc357d2e692d9d00bf02b4c6293cb0f92f4263106c","334de4c0ca58d22734dd6f48f5ac5d10f93c53ea47b24755e175df85e4615cad","8dd22097ad7d22b817fea5cd912c6ee82dec0de86a3fb5486625fa754d6e01be","38c7163403991b8b676813d445773b5b67e8dbf3c8632f2c9f4a892b9c61129d","3de9138803f7ed15f1c127b1fb1f426766b2335ea688373088eab22a27829148","fca7a7df7b6d410ecaf0ed08b5e932cf8803e9b496a86c279745ffa6eb106403","d8b50d6810942e09c460aba71a57b0504f793efb93a4ec1f7f1b742133620912","0000e62603000bb5fd17e8ff31c946902ca94ab0b2a98ce6b2225f29fbd11428","17f6348a095edfa14543e95246487d56bcbd0ddc10514e842ba324a2d6ce93fb","8ee177c110f9f80f6cf3ef14031e8094614d345b64dfbbd23fa7a70fb98bc126","de366df86fe261ed5dbef6eeeed4da2f2767d2522abaebb5bcd6c810eb008ca9","b8db352ccbaad6ec78857bc938ab421e71a04fcca721895367f1e6f43613c061","66bf7363f89adc33526e9f956fc48cfb2e30b02d18617bf6cfac62dbedd01800","cc77fad178050e74bc341401761feb147bad92bcf4fee34ac9102e7dd436e922","bfa300338fd8bd81133c3c2fbf562e1ef6a1f1928851d501aff0cdd21a7206f7","6f4f6341196fdd8cd226406bd4ab5bdbfbe4468d9cf79f5b2a368d13c176214d","d0a5118ffc3506713f42231d3f06a034bac44ecfa5c739d79c9bcd6bf0d37344","71f993873da45ce3f0a164abc659dcbf883abd70d7c9cdc3f53f5aebf1aba4e5","b2e6598e1573fb61f82545e9c5094ae2cd25c918b8e84f645b4898b459560fea","db167628ed75bed9de462f73e90c82d0f9f68b51093ac854740973318bae4f10"],"paragraph_range_zero_based":[24096,24119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24096"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"usePreBSR","paragraph_zero_based":24120},{"literal_text_all_w_t_and_m_t":"If set to true, the MAC entity of the IAB-MT may use the Pre-emptive BSR, see TS 38.321 [3].","paragraph_zero_based":24121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24122},{"literal_text_all_w_t_and_m_t":"MBS-RNTI-SpecificConfig field descriptions","paragraph_zero_based":24123},{"literal_text_all_w_t_and_m_t":"drx-ConfigPTM","paragraph_zero_based":24124},{"literal_text_all_w_t_and_m_t":"Used to configure DRX for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":24125},{"literal_text_all_w_t_and_m_t":"g-CS-RNTI","paragraph_zero_based":24126},{"literal_text_all_w_t_and_m_t":"Used to scramble the SPS group-common PDSCH and activation/deactivation of SPS group-common PDSCH for one or more MBS multicast services.","paragraph_zero_based":24127},{"literal_text_all_w_t_and_m_t":"g-RNTI","paragraph_zero_based":24128},{"literal_text_all_w_t_and_m_t":"Used to scramble the scheduling and transmission of PTM for one or more MBS multicast services.","paragraph_zero_based":24129},{"literal_text_all_w_t_and_m_t":"groupCommon-RNTI","paragraph_zero_based":24130},{"literal_text_all_w_t_and_m_t":"Used to configure g-RNTI or g-CS-RNTI.","paragraph_zero_based":24131},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablerMulticast","paragraph_zero_based":24132},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall provide HARQ feedback for MBS multicast. Value dci-enabler means that whether the UE shall provide HARQ feedback for MBS multicast is indicated by DCI as specified in TS 38.213 [13]. Value enabled means the UE shall always provide HARQ feedback for MBS multicast. When the field is absent, the UE behavior is specified in TS 38.213 [13].","paragraph_zero_based":24133},{"literal_text_all_w_t_and_m_t":"harq-FeedbackOptionMulticast","paragraph_zero_based":24134},{"literal_text_all_w_t_and_m_t":"Indicates the feedback mode for MBS multicast dynamically scheduled PDSCH or SPS PDSCH.","paragraph_zero_based":24135},{"literal_text_all_w_t_and_m_t":"mbs-RNTI-SpecificConfigId","paragraph_zero_based":24136},{"literal_text_all_w_t_and_m_t":"An identifier of the RNTI specific configuration for MBS multicast.","paragraph_zero_based":24137},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":24138},{"literal_text_all_w_t_and_m_t":"Number of repetitions for dynamically scheduled MBS multicast data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent and groupCommon-RNTI is set to g-RNTI, the UE applies the value 1.","paragraph_zero_based":24139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24140},{"literal_text_all_w_t_and_m_t":"LCG-DSR-Config field descriptions","paragraph_zero_based":24141},{"literal_text_all_w_t_and_m_t":"lcg-Id","paragraph_zero_based":24142},{"literal_text_all_w_t_and_m_t":"Identifier of the Logical Channel Group which the DSR configuration refers to.","paragraph_zero_based":24143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6f681b17f33814888af8cc8e7459cf0777c817ee6be69716616f0cb937f759cc","0765cc56b7495d000458db733e48dc29ac4f138e36cccedf943170ddb80583cf","f92bd33d0b093fdfd566be0cc6c2a005d304ab3da45664574d909ebc52e9b2cf","0116b89dcc3551dc24ecc34a0796e0ba70ece8ef0c7e32de578a8490b9600fb2","318588ef1715021ba01842cfe2e91c3216f39e58bc6fa4ac40bae668b2e0c4b5","4d70a1d02c7ae04bfa695cfe7cfafd6e03bef9b6d233633af89e3cf37a147ae1","b0d04da6207ef9b669a597c71cc28e311ee655b6b254ae1ff3916b2d87241fe5","903c4268d951ff7cf494dfbb5837f614e48bb59651cf476ffea786d58c06af4a","347687fa97ea1efbfa8013c58ac3cd6768f3a28543515b4d2cd1caa4165e5bba","7b9189601647aee080bcb6bcc1f498b8280f5f616ecccc56d856d4d40ad7cb3c","fb5430fdf27b1cd8c38a76b3bc05c8ae6031e44a7952552356d59958ceba38de","17a7baa109e1d5fccdd744a917847d51abc099076b7e8228b5fc406f269dda85","33e2c79d3ed54632e4e74c0925f3b8a4225ad70e981f67805608b46c1a15905c","8ad2ef874d968ca93c18b24c9aeb114969bdb5d251b9639b40ca52fea4970e82","8a0a06b9e4ffd1f0c1d8eec3ce97f836df141246e078009778f099c3a6b96d52","1e641e66c5257415ecb8318bb7a99421aec34f973d8f9df0b92b80dae2747e30","945136fa3a0f87202d3290ef8a0f7490224883a943544550ed2ddf971d2b25fb","83e0f7ebeb0c8ba9390937230371838e0979fb6446fbe7368039c76bc09c70c4","9f125f56b913bd0801506d34f7393e6a923ab739fe04c3c2ae07c3222517aeac","61b937a00618270b66fc22313b685354ba263e4fe1ee330d78d02c3b40397aee","6db6f528708c5b356d57d158169d431278cc339a226ecea7f998ad060d96741e","043b358da3e4699006d42232feffa140b75ed3fe30ea42ed647aea92db03da38","4c5e4b05f69a65146be3d25bf2386fd2deca0509ec755510acd9a88102221068","3d5e80a104b41ac3b751a7eabaf316c1369f26f3121ce4176b79791323ef7641"],"paragraph_range_zero_based":[24120,24143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"remainingTimeThreshold","paragraph_zero_based":24144},{"literal_text_all_w_t_and_m_t":"Remaining time threshold used for triggering DSR for the Logical Channel Group, as specified in TS 38.321 [3]. Value in number of miliseconds.","paragraph_zero_based":24145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24146},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24147},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24148},{"literal_text_all_w_t_and_m_t":"G-RNTI","paragraph_zero_based":24149},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if groupCommon-RNTI is set to g-RNTI. The field is absent when groupCommon-RNTI is set to g-CS-RNTI.","paragraph_zero_based":24150},{"literal_text_all_w_t_and_m_t":"HARQFeedback","paragraph_zero_based":24151},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when harq-FeedbackEnablerMulticast is present. It is absent otherwise. ","paragraph_zero_based":24152},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":24153},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, for the MAC-CellGroupConfig of the MCG. It is absent otherwise.","paragraph_zero_based":24154},{"literal_text_all_w_t_and_m_t":"LCH-PrioWithReTxTimer","paragraph_zero_based":24155},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if lch-BasedPrioritization-r16 is configured in this MAC entity and cg-RetransmissionTimer-r16 is configured for any configured grant configuration associated with this MAC entity. It is absent otherwise, Need R.","paragraph_zero_based":24156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24157},{"literal_text_all_w_t_and_m_t":"–MeasConfig","paragraph_zero_based":24158},{"literal_text_all_w_t_and_m_t":"The IE MeasConfig specifies measurements to be performed by the UE, and covers intra-frequency, inter-frequency and inter-RAT mobility as well as configuration of measurement gaps.","paragraph_zero_based":24159},{"literal_text_all_w_t_and_m_t":"MeasConfig information element","paragraph_zero_based":24160},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24161},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASCONFIG-START","paragraph_zero_based":24162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24163},{"literal_text_all_w_t_and_m_t":"MeasConfig ::=                      SEQUENCE {","paragraph_zero_based":24164},{"literal_text_all_w_t_and_m_t":"    measObjectToRemoveList              MeasObjectToRemoveList                                              OPTIONAL,   -- Need N","paragraph_zero_based":24165},{"literal_text_all_w_t_and_m_t":"    measObjectToAddModList              MeasObjectToAddModList                                              OPTIONAL,   -- Need N","paragraph_zero_based":24166},{"literal_text_all_w_t_and_m_t":"    reportConfigToRemoveList            ReportConfigToRemoveList                                            OPTIONAL,   -- Need N","paragraph_zero_based":24167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e58c0f5c8bf63bc5e185ac70f054bcf44b6163ba336eb010bce7cc3c40bcf50f","be71654e51ec9365289d187feca287c4e949e22081d819beab1f29751045ab10","9c41803085e3c43f2775750235335204bde4367c495d8147ed59d04279ec5742","e9b06b5bb21011219b986eac3a2a48fd54455be35842da0a0a36057e9fe8c609","b41bdb2a2f22f9247e7c8fe3d10f4ae2eba1848dbf370f6d7dd5ce465b8f1bbf","7397364d941f45942fa6a45864f90ef5ba71edf2b4