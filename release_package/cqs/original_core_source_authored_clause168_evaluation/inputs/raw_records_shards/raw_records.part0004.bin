{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":34728},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34730},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-STOP","paragraph_zero_based":34731},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34733},{"literal_text_all_w_t_and_m_t":".","paragraph_zero_based":34734},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34735},{"literal_text_all_w_t_and_m_t":"SRS-Config field descriptions","paragraph_zero_based":34736},{"literal_text_all_w_t_and_m_t":"dci-TriggeringPosResourceSetLink","paragraph_zero_based":34737},{"literal_text_all_w_t_and_m_t":"Indicates whether the single DCI-triggering SRS positioning resource sets across the linked carriers is enabled or not for bandwidth aggregation.","paragraph_zero_based":34738},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":34739},{"literal_text_all_w_t_and_m_t":"If the field is absent, UE applies TPC commands via accumulation. If disabled, UE applies the TPC command without accumulation (this applies to SRS when a separate closed loop is configured for SRS) (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":34740},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34741},{"literal_text_all_w_t_and_m_t":"SRS-Resource, SRS-PosResource field descriptions","paragraph_zero_based":34742},{"literal_text_all_w_t_and_m_t":"cyclicShift-n2","paragraph_zero_based":34743},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":34744},{"literal_text_all_w_t_and_m_t":"cyclicShift-n4","paragraph_zero_based":34745},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":34746},{"literal_text_all_w_t_and_m_t":"cyclicShift-n8","paragraph_zero_based":34747},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":34748},{"literal_text_all_w_t_and_m_t":"combOffsetHopping","paragraph_zero_based":34749},{"literal_text_all_w_t_and_m_t":"Configures UE with comb offset hopping. The hoppingId is used to initialize pseudo random comb offset hopping. If UE is configured with both comb offset and cyclic shift hopping, only one hoppingId is configured. The hoppingWithRepetition configures time-domain hopping behavior for repetition factor R>1. ","paragraph_zero_based":34750},{"literal_text_all_w_t_and_m_t":"cyclicShiftHopping","paragraph_zero_based":34751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a25b933062ea00253a11eddac17fbab5628376b7dfa1d6641689d237f36e7adb","a028fd19fb94760f684696d8080000b2814839d954de833ca8c2cd986df9411a","2b8c57c267ce849958b990a2397550db3f43ad3491a981c591791bdb8b6bbc66","42463212d62fd6e7c8f9eb776ce38ff08bab71380502b9681c4ed5fd769f2634","1c9ab6a1b79f136513a19d16a3edea0f0c90b8ccec1f1409c32ee0502c18dab8","45921b308bf5e92ecb76afebbdd9c59db36554cbd132dd2196cd1bf47dc757ca","31e2ce81c9395418da62937d1dfbe8a9cad48f5a1555bdb6414b0533e4400562","8000388be3e0731ccb4701b160ad150b38119d22800975be36bdb1f623447dba","fc8903f665ba9971f7ab7920b7c8c5eddd10551b04b036f94f0f26f8f0681fe6","f402f15cd294e198687385469fae44af9c588283cd2c8f61be034ae001dac34d","a4f4186c2dd874c3ef5ebd3ba641d9100ca7ea520f50adae5ec565fab33988c8","23dd4117a812c70d047e556e5f4308ed8b3e193da4a5c9bfbcf6de81e55493e1","7824f8cf94690d26a8dce128c443f7ada4577e9e7e322b057377a66aedf818e6","09787afe447cc25154b72e156c2db806ebdd34e98d2ad5b6af8a3e8e8cb3af8b","9118c218f3aef282feb1157a2b9e328082fb94285af391032c9be360b40303fc","5c791bc3211fbec1283a716e350a73b4f7fe0f4798cfd0f3949d6cfd65f0d674","48506ba3d68d6916a98b6010c0ebde0e1cfbbd44a8b071542bd391e740267520","5e2f639208d942259ddab5bef694b493bcb2ac485147d28963e3e1d0a850bcb5","ea0514f81d379963b1dc475214f7e54bff38649c3a93a43963a982e58061ac5b","280dbb2faa34c1c37e99ad1553fc579a70d6cff2f96586db66bb523486d7e7a6","bf351db95ff9e7e27542bcc794871f2f9d4339b60a9ff46c553b5d0c7e66e3a5","877bdce0d1723d4e6f0783bf8a667c4eae65788a04d0df4ba0d91c68276dcbd1","661c751c441895a5fe8dff2758a562c0967e0452ce1fc8d21dd0e7253be3e2c8","25887dcd4050c387436ec46819794dc7666c62604af63eefbd83ef5b82ab24d3"],"paragraph_range_zero_based":[34728,34751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34728"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures UE with cyclic shift hopping. The hoppingId is used to initialize pseudo random cyclic shift hopping. If UE is configured with both comb offset and cyclic shift hopping, only one hoppingId is configured. The hoppingFinerGranularity enables finer granular hopping, see TSxxxxx. If hoppingSubset is configured, hoppingFinerGranularity is not configured.","paragraph_zero_based":34752},{"literal_text_all_w_t_and_m_t":"enableStartRBHopping","paragraph_zero_based":34753},{"literal_text_all_w_t_and_m_t":"When this RRC parameter is configured, start RB location hopping is enabled for partial frequency sounding in different SRS frequency hopping periods for periodic/semi-persistent/aperiodic SRS as described in clause 6.4.1.4 in TS 38.211.","paragraph_zero_based":34754},{"literal_text_all_w_t_and_m_t":"freqHopping","paragraph_zero_based":34755},{"literal_text_all_w_t_and_m_t":"Includes parameters capturing SRS frequency hopping (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, the network always configures this field such that b-hop > b-SRS. For SRS for positioning configuration in multiple cells the value of this field applies to all cells in the validity area. c-SRS Indicates the maximum bandwidth. When TxHoppingConfig is configured the valid values for c-SRS are such that the maximum bandwidth is: 104 PRBs, 48 PRBs, 132 PRBs, 64 PRBs, for 15,30,60,120 KHz respectively. The same value for c-SRS is configured for all the hops when TxHoppingConfig is configured.","paragraph_zero_based":34756},{"literal_text_all_w_t_and_m_t":"groupOrSequenceHopping","paragraph_zero_based":34757},{"literal_text_all_w_t_and_m_t":"Parameter(s) for configuring group or sequence hopping (see TS 38.211 [16], clause  6.4.1.4.2). For CLI SRS-RSRP measurement, the network always configures this parameter to 'neither'. For SRS for positioning configuration in multiple cells the value of this field applies to all cells in the validity area.","paragraph_zero_based":34758},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports","paragraph_zero_based":34759},{"literal_text_all_w_t_and_m_t":"Number of ports. For CLI SRS-RSRP measurement, the network always configures this parameter to 'port1'.","paragraph_zero_based":34760},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports-n8","paragraph_zero_based":34761},{"literal_text_all_w_t_and_m_t":"Number of ports if the number of antenna ports is 8. The value 'ports8' configures UE with 8 antenna ports and the value 'ports8tdm' configures the UE with 8 antenna ports which are partitioned into 2 subsets with each subset having 4 different ports, and the subsets are mapped to different OFDM symbols, see Reference XXX. If combOffsetHopping-r18 or cyclicShiftHopping-r18 is configured, this field is not set to ports8tdm. If this field is present UE ignores the field nrofSRS-Ports.","paragraph_zero_based":34762},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-p, periodicityAndOffset-p-Ext","paragraph_zero_based":34763},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, sl1280 and sl2560 cannot be configured. For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz except when periodicity of 20480ms is configured.","paragraph_zero_based":34764},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-p-Ext is present, periodicityAndOffset-p shall be ignored by the UE.","paragraph_zero_based":34765},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-sp, periodicityAndOffset-sp-Ext","paragraph_zero_based":34766},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":34767},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-sp-Ext is present, periodicityAndOffset-sp shall be ignored by the UE.","paragraph_zero_based":34768},{"literal_text_all_w_t_and_m_t":"ptrs-PortIndex","paragraph_zero_based":34769},{"literal_text_all_w_t_and_m_t":"The PTRS port index for this SRS resource for non-codebook based UL MIMO. This is only applicable when the corresponding PTRS-UplinkConfig is set to CP-OFDM. The ptrs-PortIndex configured here must be smaller than the maxNrofPorts configured in the PTRS-UplinkConfig (see TS 38.214 [19], clause 6.2.3.1). This parameter is not applicable to CLI SRS-RSRP measurement.","paragraph_zero_based":34770},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":34771},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the SRS resource within a slot including nrofSymbols (number of OFDM symbols), startPosition (value 0 refers to the last symbol, value 1 refers to the second last symbol, and so on) and repetitionFactor (see TS 38.214 [19], clause 6.2.1 and TS 38.211 [16], clause 6.4.1.4). The configured SRS resource does not exceed the slot boundary. If resourceMapping-r16 is signalled, UE shall ignore the resourceMapping (without suffix). If resourceMapping-r17 is signalled, resourceMapping-r16 is not signalled and the UE shall ignore the resourceMapping (without suffix) and only the values of nrofSymbols which are integer multiples of the configured repetitionFactor can be configured. The network can only signal repetitionFactor-v1730 if resourceMapping-r17 is signalled. When repetitionFactor-v1730 is signalled, the UE shall ignore repetitionFactor-r17. For CLI SRS-RSRP measurement, the network always configures nrofSymbols and repetitionFactor to 'n1'. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area. nrofSymbols is same for all the hops when TxHoppingConfig is configured","paragraph_zero_based":34772},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":34773},{"literal_text_all_w_t_and_m_t":"Periodicity and offset for semi-persistent and periodic SRS resource, or slot offset for aperiodic SRS resource for positioning (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, only 'periodic' is applicable for resourceType. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34774},{"literal_text_all_w_t_and_m_t":"sequenceId","paragraph_zero_based":34775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cd41f1cb19b0838f65ed9fcc909bc68d3f69f6d10a6918f5b8bb23beddabdc61","1c843169dab7317bec4b32f40393bc1031f69f057f631966a4475ef7498558c2","0a48f5a861a93a1b1908f94781bc039744c5e5ea7faaffd2aec5a639dea82aa6","e3ecfcdae0dbe12ddffe2cc9c89919af2bb25a2428bfbf256c9190b4f44c708d","78eca080a3fd50a99eee17877900c7b8aa8b8cafa27c7d47a36372d3c91c09d9","0c603f5b2226b91baa18d7efce0ec5aa0b15e0afd0bfabffec54aecd4f149fb3","2e4c231ab085464556e49fa20cf0b614be7a59aca94aeb1bb2a1267bf1f233c1","70a8af688b1fd689dcd161ae15caa4167ada6bb990db633b6312a5fef96e3a45","07466222facfa55477b3db08b7c108d45dd87efd2cb6d1ad2eed9badc10594bc","2d9dccf743c1755d55dbf3dca6b2fd0c1c1c3160094da8703f114215f677439f","fa4d6c4006d82b17aeb22ab7fb2118e2a4e8bfa6c1a7ffe4440748989e402eb8","1dde6ef64bff59846885b4db0c4ab465a7a2417a3d8c05360b379ee47fb03c5a","46e3227b563b7d3993c70419354e7f6cc0dab8e60ee1719762c6e87e24072d32","ef117d55fe4926089c966e4c9e7f320981a503f1fbc82566ae74a1640d90848a","e52a9a5fa7c079f88cf8f474fa9f60da58d167c3d69d1f16deb1bcf561ff6d34","ce29bb1b2afb1c44bfcf92a4dc857ec6c8f3ffbb642eea6b6285697172d23bbd","d18498d7784ce7ddb11a2488b21cf11fda83f4cebf149b999921bad816ed55d1","5affe619aeccea605a07899cd9552319cb96a4d033d138c04c81b0097304617b","3481a6feb055fad58e11d751829cabbacffd0de62c1a86a1eeb4d8eab853c125","3b990f89f62c902d55845929874daf18a5ef7c50ad9e7977e1859a6213fb4797","2cca01be2f07f8f8b66db7d2e58a976d059e84c4b518186855fe83a2c5a42b29","da1e33a1edaf9fe671068009b6b58a3d2365ea6f7c9db985c38eee76404ecbf2","41745f9fa96cb2309062b651b4df82bcb6147eb4bda4608ea5b79fc1cf8cc0d5","130e802a82e9d5470805fdbc9a5f78dc928e7737bda53d8627c1f0202371362c"],"paragraph_range_zero_based":[34752,34775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34752"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Sequence ID used to initialize pseudo random group and sequence hopping (see TS 38.214 [19], clause 6.2.1). If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34776},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo","paragraph_zero_based":34777},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS (see TS 38.214 [19], clause 6.2.1). This parameter is not applicable to CLI SRS-RSRP measurement. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":34778},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo-PDC","paragraph_zero_based":34779},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS-PDC (see TS 38.214 [19], clause 6.2.1). The field is present in case of resourceType=periodic and usagePDC-r17=true in the SRS-ResourceSet, otherwise the field is absent.","paragraph_zero_based":34780},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoPos","paragraph_zero_based":34781},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":34782},{"literal_text_all_w_t_and_m_t":"If the IE srs-ResourceId-Ext is present, the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 63. Otherwise the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 31.","paragraph_zero_based":34783},{"literal_text_all_w_t_and_m_t":"srs-PosPeriodicConfigHyperSFN-Index","paragraph_zero_based":34784},{"literal_text_all_w_t_and_m_t":"Indicates whether the current Hyper SFN is even or odd HSFN for SRS for Positioning transmission. If this field is not configured, the UE assumes that SRS for positioning periodictity longer than one Hyper SFN is not configured.","paragraph_zero_based":34785},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-0-2","paragraph_zero_based":34786},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\"in DCI format 0_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 0_2 is applied. If the parameter srs-RequestDCI-0-2 is configured to value 1, 1 bit is used to indicate one of the first two rows of Table 7.3.1.1.2-24 in TS 38.212 [17] for triggered aperiodic SRS resource set. If the value 2 is configured, 2 bits are used to indicate one of the rows of Table 7.3.1.1.2-24 in TS 38.212 [17]. When UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication.","paragraph_zero_based":34787},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-1-2","paragraph_zero_based":34788},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\" in DCI format 1_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 1_2 is applied. When the UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":34789},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToAddModListDCI-0-2","paragraph_zero_based":34790},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be added or modified for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":34791},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToReleaseListDCI-0-2","paragraph_zero_based":34792},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be released for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":34793},{"literal_text_all_w_t_and_m_t":"srs-TCI-State","paragraph_zero_based":34794},{"literal_text_all_w_t_and_m_t":"Configuration of either a UL TCI state or a joint TCI state for the SRS resource. In case of UL TCI-State, refers to the TCI state defined in ul-TCI-StateList in the BWP-UplinkDedicated where the SRS-Config is configured. In case of joint TCI state, refers to a TCI state defined in dl-OrJointTCI-StateList in pdsch-Config of the BWP-DownlinkDedicated and serving cell indicated by cellAndBWP. This field is absent when the SRS resource is in an SRS-ResourceSet configured with followUnifiedTCI-StateSRS-r17 or applyIndicatedTCI-State, or when the field unifiedTCI-StateType is not configured to the serving cell which the SRS resource is located in.","paragraph_zero_based":34795},{"literal_text_all_w_t_and_m_t":"startRBIndexAndFreqScalingFactor","paragraph_zero_based":34796},{"literal_text_all_w_t_and_m_t":"Configures the UE with the startRBIndex and freqScalingFactor for partial frequency sounding as described in Clause 6.4.1.4 in TS 38.211. The startRBIndexForFScaling2 gives the startRBIndex when freqScalingFactor is 2 and the startRBIndexForFScaling4 gives the startRBIndex when FreqScalingFactor is 4 ","paragraph_zero_based":34797},{"literal_text_all_w_t_and_m_t":"transmissionComb, transmissionComb-n2, transmissionComb-n4, transmissionComb-n8","paragraph_zero_based":34798},{"literal_text_all_w_t_and_m_t":"Comb value (2 or 4 or 8) and comb offset (0..combValue-1) (see TS 38.214 [19], clause 6.2.1). If network configures field transmissionComb-n8, the UE ignores transmissionComb. If srs-PosRRC-InactiveValidityAreaPreConfig or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8426af753e2d6077c8a1a7da550d590f747391a68621d2ae0fbc1727259e4dbb","68e79bdb7c5289efe744763ecbb9bb316dd40e02beb34b7393b050187514e2e6","ae0b4bed55aac13f2a9b3ae97aa7b13608a9b9044fad767b3c1724499f607489","dacb72d479edd28c5011e000275bb461faf718678ea00282dc6a5ca3d9c023e2","ce81fbc7f70e71b6de7cf5ca2835f108f619c7674f4456fbe52d1059ae729b6b","1fd5775ed53c894a0abe2bc27a89eb864392f18b47787b40facb29a3d0d98dd5","729c112d863bf4bf35bb3a7e6652f420640e7901c8347a620b162b8c8d8bf877","204ef63fd458773819effab723be090a6f990c7d0be5a9669a6172d32e1086ae","e32ede405512076174d06e1897e35ff54bcee200817d355361e2012db6430a70","f81c0619599d2b83a4cc2780dfa3769e20fafc86a184ad8452a55d86ccc24169","d737977550bb4e4261c0c6f11c11eb8c8be405687abef576ca95aa273b69d333","3c3ce61fbda7897d7c8734a544ae288600cc5b55e6cb2b2d8e720a42f14fa315","05efa8ca0ff053b769c9318db4c40613d647c2bed8ccdb326cb1cf9962786aae","1a87f6d9c6ad7a025fd5055cfab0af445f88f5552f6540074dd01f7dca4e6d0d","2a09bdd12cfd9f575776daf30e2bcec541cdc80d0fa5b4b39e4012765a057e15","b4d540571500384db071bdc4a1718b1a87a677cb8b750889fdc32444eaa4eb80","8658ba977aab6b4de6ec2f25625275899c6ce1142cda600a667f4e42da8b9551","31af526a701140eec9975c7491d7270cd03fc657bb7aad31c234b6fb6f3ba8f4","c843b9ff307b321920d9559054f48daeeba651fd2b0d57bdef447070307afc33","33b9ac7370812a7db92207f42fcc50472492fe6b5683917cf6e90d8638fd1223","781062194b4a84bd74368f19f9d90c90fe3560d23e9cb89c4cf71eba18710fad","eadddafd87d9111790febd1d0564e9f37af0f84c7db288ee69ea01552241808b","4f48f85a69c5bf44f137a7ceafff48f86f7bcf1b4ab850c029ad9dcfe633e901","c14e8c7199c58daf59a53cdf29d6a5aa79dd9e3251af17326067939bcbfcfcb5"],"paragraph_range_zero_based":[34776,34799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34776"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34800},{"literal_text_all_w_t_and_m_t":"SRS-ResourceSet, SRS-PosResourceSet field descriptions","paragraph_zero_based":34801},{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":34802},{"literal_text_all_w_t_and_m_t":"alpha value for SRS power control (see TS 38.213 [13], clause 7.3). When the field is absent the UE applies the value 1. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34803},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTriggerList","paragraph_zero_based":34804},{"literal_text_all_w_t_and_m_t":"An additional list of DCI \"code points\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6). When the field is not included during a reconfiguration of SRS-ResourceSet of resourceType set to aperiodic, UE maintains this value based on the Need M; that is, this list is not considered as an extension of aperiodicSRS-ResourceTrigger for purpose of applying the general rule for extended list in clause 6.1.3.","paragraph_zero_based":34805},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTrigger","paragraph_zero_based":34806},{"literal_text_all_w_t_and_m_t":"The DCI \"code point\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6).","paragraph_zero_based":34807},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":34808},{"literal_text_all_w_t_and_m_t":"This field indicates, for an SRS-ResourceSet, if UE applies the first or the second \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 6.2.1. If more than one value for the field coresetPoolIndex is configured in IE controlResourceSet for the BWP, the value 'first' corresponds to the \"indicated\" joint/UL TCI states specific to coresetPoolIndex value 0 and the value 'second' correspond to the value 1, respectively. When UE is configured with two SRS resource sets with usage set to Codebook or nonCodebook, network does not configure the first set with value 'second' or second set with value 'first'.","paragraph_zero_based":34809},{"literal_text_all_w_t_and_m_t":"associatedCSI-RS","paragraph_zero_based":34810},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set in non-codebook based operation (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":34811},{"literal_text_all_w_t_and_m_t":"availableSlotOffsetList","paragraph_zero_based":34812},{"literal_text_all_w_t_and_m_t":"Indicates a list of up to four different available slot offset values from slot n+k to the slot where the aperiodic SRS resource set is transmitted, where slot n is the slot with the triggering DCI, and k is the slotOffset (without suffix) as described in clause 6.2.1 of TS 38.214 [19].","paragraph_zero_based":34813},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":34814},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":34815},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":34816},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":34817},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-StateSRS","paragraph_zero_based":34818},{"literal_text_all_w_t_and_m_t":"When set to enabled, for SRS resource Set, the UE applies the \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5. This parameter may be configured for aperiodic SRS for BM or SRS of any time-domain behavior for codebook, non-codebook, and antenna switching.","paragraph_zero_based":34819},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":34820},{"literal_text_all_w_t_and_m_t":"P0 value for SRS power control. The value is in dBm. Only even values (step size 2) are allowed (see TS 38.213 [13], clause 7.3). If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34821},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS","paragraph_zero_based":34822},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a CSI-RS config or a SS block) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":34823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2992e53994f164a098fae7e069952f779643f0e713df5985e38a0d682afda64a","151d3fb969b9a7eb24cd95e1e8409c9f976443ed0ba21054adfeb65c22d5aa9e","f339a81466df88053d9b164c0571f15592807bdb275c1408f1d4b992a1ee236e","c8bd2eda61897508878e3cc47e75970acf44dc05f1989aea05e85519056cb52a","fe2f0c89be5bc5502f3f88f0240b579d252f6897202831312ffb9a22ee41d304","8658f514e2e3aaaf6a5f55fce3df85bb07e70227f97ed0a6700d21c1467fb839","39b6e21a44da4716e7b7b46ceed12f2c3470b6aaf7b79bab14024d771cb75ad3","9ce9cad3d2e95b75e55c45f7059543aa5e93a3d9af21f82a2c0eaeb8d6e99d77","73321174a6a721b697eea9509b0fe6e05a67998b58c7e84c441e8a90d557954c","ee5c399c22ef9891a1af57f2ce0b4d15427940f009b3e223010e47d2217fbe97","489fe18a2d8c8463498eb21ca1125b785a3aa3038cf536a7d3544a6559550f91","0a590af7415eeca2971e0358bb293febef4d7ba800c6271dbe750a8ec91a830d","60d548b7dcb73fcf96a670f4b5d2fce0e800ad31d9dca11b08ac6497fda3daf4","ad68ef065743a1685f71636976b1790b7e253b149a28141cdd7947272419be97","c87d2287307e3902e6cef5d1d3f88b6e4f0126f67c49bbf3900fb11a6cdcf023","3b108397904b46acc50ae13adb753794eba4978b2f0cf8901ac0857bacbf7fb8","a0a111e1d9aaed89f1ca799c94cf06313f43faaa5500975918b9d0926606ded3","815897c40ef1c8a164bd3173e30c40c56566246afca54ba4a7793f1d8849575a","31dcd34eaa7043f99574c7c179a22f1474a657ade42d9426b3f2ac9109d73ccf","6af7d985ef131903d53880a2acd7fd083b0999e1ddb088e0278332d4aa1c04fd","f56d79888a50bac17fcec6a069f679387434a299fad63bfe944e02443182bfa1","8a5fa9a20f8a1277b82033f1c334c15973b2391d3a955a90b6b36f7ed0d01fac","6774ec00ce0d66176034d48d4f8239244148c4807b3470831cc38798a9d39507","2cf2c0ff500b9037ae9e623519f27d3fbc5477b14fc882489ff9a0d0de85b957"],"paragraph_range_zero_based":[34800,34823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34800"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Pos","paragraph_zero_based":34824},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a SS block or a DL-PRS config) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":34825},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSList","paragraph_zero_based":34826},{"literal_text_all_w_t_and_m_t":"Multiple candidate pathloss reference RS(s) for SRS power control, where one candidate RS can be mapped to SRS Resource Set via MAC CE (clause 6.1.3.27 in TS 38.321 [3]). The network can only configure this field if pathlossReferenceRS is not configured in the same SRS-ResourceSet.","paragraph_zero_based":34827},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":34828},{"literal_text_all_w_t_and_m_t":"Time domain behavior of SRS resource configuration, see TS 38.214 [19], clause 6.2.1. The network configures SRS resources in the same resource set with the same time domain behavior on periodic, aperiodic and semi-persistent SRS. The aperiodic SRS is not applicable for the UE in RRC_INACTIVE. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, the value of this field applies to all cells in the validity area.","paragraph_zero_based":34829},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":34830},{"literal_text_all_w_t_and_m_t":"An offset in number of slots between the triggering DCI and the actual transmission of this SRS-ResourceSet. If the field is absent the UE applies no offset (value 0).","paragraph_zero_based":34831},{"literal_text_all_w_t_and_m_t":"srs-PowerControlAdjustmentStates","paragraph_zero_based":34832},{"literal_text_all_w_t_and_m_t":"Indicates whether hsrs,c(i) = fc(i,1) or hsrs,c(i) = fc(i,2) (if twoPUSCH-PC-AdjustmentStates are configured) or separate close loop is configured for SRS. This parameter is applicable only for Uls on which UE also transmits PUSCH. If absent or release, the UE applies the value sameAs-Fci1 (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":34833},{"literal_text_all_w_t_and_m_t":"srs-ResourceIdList, srs-PosResourceIdList","paragraph_zero_based":34834},{"literal_text_all_w_t_and_m_t":"The IDs of the SRS-Resources/SRS-PosResource used in this SRS-ResourceSet/SRS-PosResourceSet. If this SRS-ResourceSet is configured with usage set to codebook, the srs-ResourceIdList contains at most 2 entries. If this SRS-ResourceSet is configured with usage set to nonCodebook, the srs-ResourceIdList contains at most 4 entries. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, srs-PosResourceIdList is commonly configured across cells within the validity area.","paragraph_zero_based":34835},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetId, srs-PosResourceSetId","paragraph_zero_based":34836},{"literal_text_all_w_t_and_m_t":"The ID of this resource set. It is unique in the context of the BWP in which the parent SRS-Config is defined. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, srs-PosResourceSetId is commonly configured across cells within the validity area.","paragraph_zero_based":34837},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":34838},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell where the SRS is configured.","paragraph_zero_based":34839},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":34840},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":34841},{"literal_text_all_w_t_and_m_t":"usage","paragraph_zero_based":34842},{"literal_text_all_w_t_and_m_t":"Indicates if the SRS resource set is used for beam management, codebook based or non-codebook based transmission or antenna switching. See TS 38.214 [19], clause 6.2.1. Reconfiguration between codebook based and non-codebook based transmission is not supported.","paragraph_zero_based":34843},{"literal_text_all_w_t_and_m_t":"usagePDC","paragraph_zero_based":34844},{"literal_text_all_w_t_and_m_t":"If configured, it indicates that this SRS resource set is used for propagation delay compensation. The field can be present in only one SRS-ResourceSet.","paragraph_zero_based":34845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34846},{"literal_text_all_w_t_and_m_t":"SRS-SpatialRelationInfoPos field descriptions","paragraph_zero_based":34847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["94a202c3c53b3437bf066fa6a7779bb3f9c278997a0d914e22b3373f695cb237","b07bc590aa5ca8177a255a606384d18ca36c1750f39b09ddaffad92fc73693d7","f3e036d9bdb91e9bde83cc18a87fac29395d26f79ddb51b9b9bc69225e435577","279fff1f39f74217b8fb5384dfc72066b7ff14fa84d3d62b3ecf2cd215a8e2a5","162cf5d66669214b7788c55f775f2f7a651b2c32bd5fe5d7752b8500e9bd2ebf","c5e6736e74d31d99d172b2b0856f99577957ebfb4eba31e96295c9a2827bb1a1","382a7a9419af580cca3417893254c9d0f027749f47950648684e7b316ce74965","cea81f04da17c8cfbb8b1456df45fb2b6e83ba48ea7465a6df8070d964296f35","9509bd77c30a161e10030e606c063a621b0ef543c6e151e98069f5b75851bc5c","45527c537fce84a70f01be05e177e410bb89ff320496655440b4994ef64ccbcd","c35d243a0e2edf2a575a909b0659018126856f5292557edc02f9a8165ae45387","ba1ed0702a5c5df402997707b220b409962c959d9ce5d58f759c4197e5a4be24","692839c454de314dc76fab344cfc04fb28f84b49054cfffc5e998c9c1576bbe0","0b12db66fdb4b5be3aac06e12791cf10e4971e2afd2cf4f5d9f3f75227795acf","4239784797095cfa1cbcf0741c102b6dd2c1efa92ec7d902ffbfb56686fe522b","be3a71d6e99365fabdc6721780f9215ff34b9fbb2f0a5054490f02d890d77f21","173e2c736c84f71ff65458f9f2de3d9c18debfc40f04c7e1b5ba220bf88c581b","7839d7ee1b26938a8536d05e77b2917656f520eb77fd6faaf480089a8d838997","4684590ec3016655397af6d4c252d91598b73db389a09a39b5a6d5ead06765b2","8c5bc0ead14a6ee36bd978b4ccea1b85c8b74e0babc688c844d31b06640654a0","51dbded92e1d5c0728b371337be3cb2d524346773ffaf32a421aaa62e1e5faaf","131f303a5634dc0502ac3cabe39f7d679c86e6fddf72b6d8ae1fd6884ee5df27","5aea227e29c335b9c3e600223ba2279741f64819c5d4e73e661a0fd5c7e6aa4e","5ebcb5c0cca133db636ee362631090024c84a5a569709dc116b4fa10c13d1273"],"paragraph_range_zero_based":[34824,34847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34824"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-RS-IndexServing","paragraph_zero_based":34848},{"literal_text_all_w_t_and_m_t":"Indicates CSI-RS index belonging to a serving cell.","paragraph_zero_based":34849},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":34850},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":34851},{"literal_text_all_w_t_and_m_t":"resourceSelection","paragraph_zero_based":34852},{"literal_text_all_w_t_and_m_t":"Indicates whether the configured SRS spatial relation resource is a SRS-Resource or SRS-PosResource.","paragraph_zero_based":34853},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":34854},{"literal_text_all_w_t_and_m_t":"The serving Cell ID of the source SSB, CSI-RS, or SRS for the spatial relation of the target SRS resource. If this field is absent the SSB, the CSI-RS, or the SRS is from the same serving cell where the SRS is configured.","paragraph_zero_based":34855},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":34856},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell.","paragraph_zero_based":34857},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":34858},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":34859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34860},{"literal_text_all_w_t_and_m_t":"SSB-InfoNCell field descriptions","paragraph_zero_based":34861},{"literal_text_all_w_t_and_m_t":"physicalCellId","paragraph_zero_based":34862},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell ID of the neighbour cell or NCD-SSB of the serving cell for which SSB configuration is provided.","paragraph_zero_based":34863},{"literal_text_all_w_t_and_m_t":"ssb-IndexNcell","paragraph_zero_based":34864},{"literal_text_all_w_t_and_m_t":"This field specifies the index of the SSB for a neighbour cell or NCD-SSB of the serving cell. See TS 38.213 [13]. If this field is absent, the UE determines the ssb-IndexNcell of the physicalCellId","paragraph_zero_based":34865},{"literal_text_all_w_t_and_m_t":"based on its SSB measurement from the cell.","paragraph_zero_based":34866},{"literal_text_all_w_t_and_m_t":"ssb-Configuration","paragraph_zero_based":34867},{"literal_text_all_w_t_and_m_t":"This field specifies the full configuration of the SSB. If this field is absent, the UE obtains the configuration for the SSB from nr-SSB-Config received as part of DL-PRS assistance data in LPP, see TS 37.355 [49], by looking up the corresponding SSB configuration using the field physicalCellId.","paragraph_zero_based":34868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34869},{"literal_text_all_w_t_and_m_t":"DL-PRS-Info field descriptions","paragraph_zero_based":34870},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":34871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a565f09f210c78c143b55b70603fc12f59d902be95c9ab2d3b04d023fb5f7cab","60465ec017bf75ee5a5068f973ada523ce19d505475d00ab5bd2d3ee653c80db","d5bd802223cd7503c28fb9349d3de54131cb7842db9f01ce8d597f4bc493f441","77f582543084dfd1901b81e82d9f83305175dcc3ee861e42aaf3e818b92c6011","2305031e5a5caa81be32be09705abf6d56b244f57c76a2c65e8b47af0c112f9d","d200e366949ebfa033e341facc06853f7fcc53d7ec8220e2320cbd85715977b0","9d3a22f3454193020e06954108748940225475a66c0cdd1d0e4b87bb2f6e36bf","743869acb19c45243485fb50a7cdc9363f08883f87dc7fa2cca738cfa35b174a","a9e01161433678901ee8b54973230ef593ab7dee0c8076846af42478ce8c512e","765f1ed5a0e37588d8561d72b1f8cd84da16c33a59b5342db549c8133c00c62a","38c7dbd7411f26a9d9addd11577bc6d473aba29a76a7c05ef749055f16a54b8f","2d422bd0f4564117ec2394d4ae61ac203e277b9a829fcc3e79f6ee855b574ac1","7ca346d149aaadd478b36e7976d13adea5dc6c115f7a75cb0d55513a35d98562","1a471c99144bbbc049bc7bbbcec35f43273291f0959df8294ca1f65bc12004ce","fba10f917683a6630a2fba6d9a20240d61fc75d08d62e2f040082ddde78012a9","47b30e89c8e490c553302258cc7c53df94acfab592896d40fe4bd45f1c462c14","3a80228107758111bfe8f01b4e33d8921be0763b79aa36e4c9d4b2ba4b190653","51323e23970b4bad60481658736fe4305b81f0aa1e040a8566cd4bc2fde1915b","3e9fc68602a416dcac2c5e1eeaf0b4b9b9811abe0b81a67a133ec54e4b67ba9f","de3e592f6ce081b8d61196eec6205af17c3e6a8346cf921cdac22c261a4e9896","41361bd722ac46a1b08e5e10d6d26f66d51a4456300cd45f6e86dd3062eb5ff7","7f538eda759c7d51f7ebbb084ce4901673d18899277b31443f3e01463f963c96","656e892b619fbffc331d8b5a1e858dfd68b13357a721b0329ddff60c5888fa5c","9c4a7e947c410b3f20cb1d28bc9c8a5f83182411db5441219323e367736406a1"],"paragraph_range_zero_based":[34848,34871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34848"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the UE specific TRP ID (see TS 37.355 [49]) for which PRS configuration is provided. ","paragraph_zero_based":34872},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSetId","paragraph_zero_based":34873},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-ResourceSet ID of a PRS resourceSet.","paragraph_zero_based":34874},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceId","paragraph_zero_based":34875},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-Resource ID of a PRS resource. If this field is absent, the UE determines the dl-PRS-ResourceID based on its PRS measurement from the TRP (see TS 37.355 [49]) and DL-PRS Resource Set.","paragraph_zero_based":34876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34877},{"literal_text_all_w_t_and_m_t":"SSB-Configuration field descriptions","paragraph_zero_based":34878},{"literal_text_all_w_t_and_m_t":"halfFrameIndex","paragraph_zero_based":34879},{"literal_text_all_w_t_and_m_t":"Indicates whether SSB is in the first half or the second half of the frame. Value zero indicates the first half and value 1 indicates the second half.","paragraph_zero_based":34880},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset","paragraph_zero_based":34881},{"literal_text_all_w_t_and_m_t":"Indicates the subframe boundary offset of the cell in which SSB is transmited.","paragraph_zero_based":34882},{"literal_text_all_w_t_and_m_t":"sfn0-Offset","paragraph_zero_based":34883},{"literal_text_all_w_t_and_m_t":"Indiactes the time offset of the SFN0 slot 0 for the cell with respect to SFN0 slot 0 of serving cell.","paragraph_zero_based":34884},{"literal_text_all_w_t_and_m_t":"sfn-Offset","paragraph_zero_based":34885},{"literal_text_all_w_t_and_m_t":"Specifies the SFN offset between the cell in which SSB is transmited and serving cell. The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of serving cell to the beginning of the closest subsequent radio frame #0 of the cell in which SSB is transmitted.","paragraph_zero_based":34886},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset","paragraph_zero_based":34887},{"literal_text_all_w_t_and_m_t":"Indicates the SFN offset of the transmitted SSB relative to the start of the SSB period. Value 0 indicates that the SSB is transmitted in the first system frame, value 1 indicates that SSB is transmitted in the second system frame and so on. The network configures this field according to the field ssb-Periodicity such that the indicated system frame does not exceed the configured SSB periodicity.","paragraph_zero_based":34888},{"literal_text_all_w_t_and_m_t":"ssb-Freq","paragraph_zero_based":34889},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the SSB.","paragraph_zero_based":34890},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":34891},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":34892},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":34893},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the SSB. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":34894},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":34895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1f1420a2e5b2a97da7dbe4ecc8a96a744889322806b654a2af8413100931e0c0","e1becae3a76f067a47d27f7199cb7c62ed8b43dd37bc8f7d9f54b0780fcd6965","c5e2f028b385638203000c6acacadeb5c8e504b51ae75bebfba54300c676ffa7","0310b46d10c2ab892c862f2d3c853f972f48861f23bb89a6ee64ee5dc5173a97","74f80f7d7ef4c86cc40fb5a14fc72432ec182f02cfdc91d024c55e2ac2ad81de","88448cde0e72d44b22f4400d62b6e84e8ccc0be83038d909a7d23f654c7a87ba","605d579cbba6f4d99624f04e2354a76cb11e08b4f877e6148d93036acfa9f73f","5fec10af168ae004b7f169ae9aad810ba1e732e0a8a02b3f09311cda2978c7bd","7580725d74573d9005b8d6a4e6200ebd32c166c787f32df2da1a3110cc9d2915","59f961bc55d09a88f7fc955bef2f304efb2c4be9ea966bda08a0e43a3aa678ff","66760b5b8d7bf7348adb1c9e6f1d5ac032519f7826d45845d1dffc70f3b1db32","ea9d6cd6665ccdd22cededb6f795133cb62a2d6c73996462634f73dc861e073d","87cfbaba7d240e1019734a6e98953bea644b3dd6799f9f34b86881451fbb7b86","695ac2754e98f52ce72c3eecc2841a4690d7ca250de5e3ba0e8aa4fde463825a","d9a0df5b1c9e64c79cfa5c3db8bf3244f6c3bb9cbe211de85cc94a96c9cf1a01","804870d67e4c9aec31720ee6fb3b2569ff6c17e429c2b706a0d705fe6a8ed49f","095d5e2f17526eefddcb6a1f35c914b204885ba030fdbca9379fa5bff1f96ff6","8d908ad87d374bed9a57e98c365acd51760ba07a83c0fcde6656ad90483bea21","b8b79b69ccc390e5d23b79fe76163da5aed13d41a75bfbc7e0cd205820a50e18","1db0c47fbee41767e518a2d96f8f2020b9ffe0154cb9920f7b7ca73b0cbaf9fe","8dc5e59313c22e308a5bbc26a75c94d11482dfa5173350f1da50031393c82890","d6321450d085513b3974382c8e322432c6dfa5e4785fc49d7ea1d4c0b2ef7b6e","b8bed2130c64adbd111dc262af62288e283df238e797af9a91edc799e634b4e2","f9214c9c369c7f062175c88f1a45c1bcf7d4d370cb54b43922468aa89254958d"],"paragraph_range_zero_based":[34872,34895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34872"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":34896},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":34897},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":34898},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":34899},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":34900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34901},{"literal_text_all_w_t_and_m_t":"TxHoppingConfig field descriptions","paragraph_zero_based":34902},{"literal_text_all_w_t_and_m_t":"numberOfHops","paragraph_zero_based":34903},{"literal_text_all_w_t_and_m_t":"This field specifies the number of hops. The configured values are 2,3,4,5,6.","paragraph_zero_based":34904},{"literal_text_all_w_t_and_m_t":"overlapValue","paragraph_zero_based":34905},{"literal_text_all_w_t_and_m_t":"This field specifies the overlap during SRS transmission in terms of number of resource blocks. Value zeroRB implies 0 RB, value oneRB corresponds to 1 RB, value twoRB corresponds to 2 RBs and so on. The same value for the overlapValue is configured to all the hops.","paragraph_zero_based":34906},{"literal_text_all_w_t_and_m_t":"slotOffsetForRemainingHopsList","paragraph_zero_based":34907},{"literal_text_all_w_t_and_m_t":"This field specifies the starting slot offset and starting symbol for the SRS resource with tx hopping for different resource types (aperiodic, semi-persistent or periodic SRS transmission). Each hop is configured with the same periodcity.","paragraph_zero_based":34908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34909},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":34910},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34911},{"literal_text_all_w_t_and_m_t":"DLorJointTCI-SRS","paragraph_zero_based":34912},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if srs-DLorJointTCI-State is configured, otherwise it is absent Need R.","paragraph_zero_based":34913},{"literal_text_all_w_t_and_m_t":"FollowUTCI","paragraph_zero_based":34914},{"literal_text_all_w_t_and_m_t":"The field is absent if the field followUnifiedTCI-State is present. Otherwise, it is optionally present, Need R.","paragraph_zero_based":34915},{"literal_text_all_w_t_and_m_t":"NonCodebook","paragraph_zero_based":34916},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in case of non-codebook based transmission, otherwise the field is absent.","paragraph_zero_based":34917},{"literal_text_all_w_t_and_m_t":"Pathloss","paragraph_zero_based":34918},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE SSB-InfoNcell is included in pathlossReferenceRS-Pos; otherwise it is optionally present, Need R","paragraph_zero_based":34919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cf85284bb6a8c035c2f62f315d5b5180ac67b88025e6149bdf6d3340783cad65","3a34894b53c17599c1c6cdcf933a6f157a37cc78e2553447ba411ce67cffa211","12668b2eb445b9ca057c1eae4a00ace6ff84cfecea14c48589486095a88c662e","ca7570c78344337c24c47f9928c3569820e67a05ff7599b76f7b87a59f99fdc9","6ac40545b57f77c4e17b69406a1db956a2715affa2a033f21b18360f9f2e8217","294853fab4a331391e7fd69c8d1235aa634676545aa8b9b689a658f4a056728d","5252ff9e20f85d4060be915bcb7f1a97e95899f4a7b8d70f08656bf1094cffc6","2c62432dd5a217855ad84b06b040297827d29e7ccf29c27530055c64d6b7130d","fb1491c85df37211c