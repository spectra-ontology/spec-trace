3b13605e8cc8d42c2b5b02e124bec","64f1dfdc9dc8b1cf9a95bec6dd2333c0b734b6aa737bfb15773512b5b1d3baea","8126443c9cbe4ce76086614a5a3c423da44c20f7edd4e819c8d64b092917bff0","9a64585228e94c4583acc4a321312428d8523d2b546e58e15e1b1f50b5a51883","59a31599327207a2e82ab8c35a3fabe571ddfd8a60c95ef419d703cea91b1a75","1be5f8a8c946a40433fe5a3f142ed47cc09d65c662996c1f072a3e27640c1ebe","8ad87bbe0d4ab263ca95f9c9c6cc1b7808d5fc2f39ddf01dfac6307fb8b4bd15","7e1572adf49eee65902824a471cba98c5f2cd4e8fc601a689112bd4671e216b1","6580736dd59e189ae71fa60ee8bfda002b08e63ffe3cd86c64f911feeadc9061","27255944ff0bc64bf4cb192d2058e9c6b837a934b93a2cbf797286f8aa1b20fe","d0c8b22b6e4f0e6cb92659791caf9e7e7c9bb715761b0c45394867aaa2a1b126","beb0acb63fcdb73f3e945ebac9bf3f9a5bb0ddf9c28c8223206593de0f53effe","74bd7e7c5ece663ad49364f8ad7618c2a872d8da6fe499aa56ec28db4a54eff3","2e47674637ea9ac3fcdc31403aed6bc384af66d0ed98c6f5c4ea4655aa9f24d6"],"paragraph_range_zero_based":[12576,12599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12576"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RRCReconfiguration-IEs field descriptions","paragraph_zero_based":12600},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":12601},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access or if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":12602},{"literal_text_all_w_t_and_m_t":"bap-Config","paragraph_zero_based":12603},{"literal_text_all_w_t_and_m_t":"This field is used to configure the BAP entity for IAB nodes.","paragraph_zero_based":12604},{"literal_text_all_w_t_and_m_t":"bap-Address","paragraph_zero_based":12605},{"literal_text_all_w_t_and_m_t":"Indicates the BAP address of an IAB-node. The BAP address of an IAB-node cannot be changed once configured for the cell group to the BAP entity.","paragraph_zero_based":12606},{"literal_text_all_w_t_and_m_t":"conditionalReconfiguration","paragraph_zero_based":12607},{"literal_text_all_w_t_and_m_t":"Configuration of candidate target SpCell(s) and execution condition(s) for conditional handover, conditional PSCell addition or conditional PSCell change. The field is absent if any DAPS bearer is configured or if the masterCellGroup includes ReconfigurationWithSync or if the sl-L2RemoteUE-Config or sl-L2RelayUE-Config is configured. For conditional PSCell change, the field is absent if the secondaryCellGroup includes ReconfigurationWithSync. The RRCReconfiguration message contained in DLInformationTransferMRDC cannot contain the field conditionalReconfiguration for conditional PSCell change or for conditional PSCell addition.","paragraph_zero_based":12608},{"literal_text_all_w_t_and_m_t":"daps-SourceRelease","paragraph_zero_based":12609},{"literal_text_all_w_t_and_m_t":"Indicates to UE that the source cell part of DAPS operation is to be stopped and the source cell part of DAPS configuration is to be released.","paragraph_zero_based":12610},{"literal_text_all_w_t_and_m_t":"dedicatedNAS-MessageList","paragraph_zero_based":12611},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for each PDU in the list. ","paragraph_zero_based":12612},{"literal_text_all_w_t_and_m_t":"dedicatedPagingDelivery","paragraph_zero_based":12613},{"literal_text_all_w_t_and_m_t":"This field is used to transfer Paging message for the associated L2 U2N Remote UE to the L2 U2N Relay UE in RRC_CONNECTED.","paragraph_zero_based":12614},{"literal_text_all_w_t_and_m_t":"dedicatedPosSysInfoDelivery","paragraph_zero_based":12615},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBPos to the UE in RRC_CONNECTED.","paragraph_zero_based":12616},{"literal_text_all_w_t_and_m_t":"dedicatedSIB1-Delivery","paragraph_zero_based":12617},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the UE (including L2 U2N Remote UE). The field has the same values as the corresponding configuration in servingCellConfigCommon.","paragraph_zero_based":12618},{"literal_text_all_w_t_and_m_t":"dedicatedSystemInformationDelivery","paragraph_zero_based":12619},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB6, SIB7, SIB8, SIB19, SIB20, SIB21, SIB25 to the UE with an active BWP with no common search space configured or the L2 U2N Remote UE in RRC_CONNECTED. For UEs in RRC_CONNECTED (including L2 U2N Remote UE), this field is also used to transfer the SIBs requested on-demand.","paragraph_zero_based":12620},{"literal_text_all_w_t_and_m_t":"defaultUL-BAP-RoutingID","paragraph_zero_based":12621},{"literal_text_all_w_t_and_m_t":"This field is used for IAB-node to configure the default uplink Routing ID, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BAP-RoutingID can be (re-)configured when IAB-node IP address for F1-C related traffic changes. This field is mandatory only for IAB-node bootstrapping.","paragraph_zero_based":12622},{"literal_text_all_w_t_and_m_t":"defaultUL-BH-RLC-Channel","paragraph_zero_based":12623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["df63a7cb746063afc9bc188c59c98aa0360dcebda9ac650f85b9f099d1af96f0","0e893def81ca27c3b080d4c6718395ff41a0c02f062812f51ea0da27dc505c96","ecd0e38b848c6be0e1c337d94663305895f584d580ae0c2b5e252c9cb8a51d3e","e18c3cbfaaad6fd3774119952f219f56134afb8d7906c28dfd738ecead16f417","c5ea4daed8b764dd98d9135a6d6e87484c573fd9bf6f60a8101cab28e214c118","a050581ca35be0ebe385c6da5f2fe946ca572cc48cddcd03c2047f3ed4d869f8","b6344d7b9811c3bbd58c2feb86ecfa059487192384fe29574b29e2d00eab82fc","f9bbdf2691cf4a7d30c5fdeb6e6fd939e6e73d71a1d17c37f9a1e3e45084024e","9396e09720599a8b543ea23c4a3855a6b042ba369ac6320174fbe4d724de7ec6","ce638d8b20e3a2e8a4c810dd332e188995c52338d3f3fae178c2ae4c255496bd","f76f82ddd032c39c2b9d5e835b1da042dc0800610fe4b622ddbc777592351b8f","fb1c06f7986253ab5286be8ba90b44548dd2551ab819702861d2cd0d0196e18e","acc6e23236b688bd8f9b099c59226cc7d2f1131528fab38572e0f6f342486b6a","eb2d28cbb7307b6360add1146eea0b3be13c3512014f770bea9a5782ce591839","35fcb7f3080e5862d40da01ab8336a829ce1cdf77b793d706fb617abd933f9d8","9bbdfd54db08b85aa8ae5a891ea9a11a2388a1c9c2591e621147f1fb519497db","0688d896ad313d0ceac8d2dd124dc5635a3610e4539063aed48d6c435b8f0112","7cfdf7567f253c17e2d9027e3149bc865ab41a9309bcbac238306b8a04cdc6e2","ae53440c31fe0d293efe76422690f0454229db6912a841073466ea8902378b36","820ba836791a3af83362e835f9fc67f28a34fe1de8f18a08737fa854c42bb465","007a80e326b6a91630b37be9d8de1c559bd61558aa0496e750b0ae9b37c4f074","3dd0d5f1e81c5108163378da86143699f609b4bdf53ea3725c03160b7fd0495f","9d3362c72a2fa19da9a50789c9c1d8796510e544c68f3c10a4bde052acf5b345","2bf6c702808a25fde8bc67148a74599af4b7220708587ffb3e8da9d337c7a831"],"paragraph_range_zero_based":[12600,12623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12600"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used for IAB-nodes to configure the default uplink BH RLC channel, which is used by IAB-node during IAB-node bootstrapping, migration, IAB-MT RRC resume and IAB-MT RRC re-establishment for F1-C and non-F1 traffic. The defaultUL-BH-RLC-Channel can be (re-)configured when IAB-node IP address for F1-C related traffic changes, and the new IP address is anchored at a different IAB-donor-DU. This field is mandatory for IAB-node bootstrapping. If the IAB-MT is operating in EN-DC, the default uplink BH RLC channel is referring to an RLC channel on the SCG; Otherwise, it is referring to an RLC channel either on the MCG or on the SCG depending on whether the MN or the SN configures this field.","paragraph_zero_based":12624},{"literal_text_all_w_t_and_m_t":"flowControlFeedbackType","paragraph_zero_based":12625},{"literal_text_all_w_t_and_m_t":"This field is only used for IAB-node that support hop-by-hop flow control to configure the type of flow control feedback. Value perBH-RLC-Channel indicates that the IAB-node shall provide flow control feedback per BH RLC channel, value perRoutingID indicates that the IAB-node shall provide flow control feedback per routing ID, and value both indicates that the IAB-node shall provide flow control feedback both per BH RLC channel and per routing ID.","paragraph_zero_based":12626},{"literal_text_all_w_t_and_m_t":"fullConfig","paragraph_zero_based":12627},{"literal_text_all_w_t_and_m_t":"Indicates that the full configuration option is applicable for the RRCReconfiguration message for intra-system intra-RAT HO. For inter-RAT HO from E-UTRA to NR, fullConfig indicates whether or not delta signalling of SDAP/PDCP from source RAT is applicable. This field is absent if any DAPS bearer is configured or when the RRCReconfiguration message is transmitted on SRB3, and in an RRCReconfiguration message for SCG contained in another RRCReconfiguration message (or RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1.","paragraph_zero_based":12628},{"literal_text_all_w_t_and_m_t":"iab-IP-Address","paragraph_zero_based":12629},{"literal_text_all_w_t_and_m_t":"This field is used to provide the IP address information for IAB-node.","paragraph_zero_based":12630},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressIndex","paragraph_zero_based":12631},{"literal_text_all_w_t_and_m_t":"This field is used to identify a configuration of an IP address.","paragraph_zero_based":12632},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToAddModList","paragraph_zero_based":12633},{"literal_text_all_w_t_and_m_t":"List of IP addresses allocated for IAB-node to be added and modified.","paragraph_zero_based":12634},{"literal_text_all_w_t_and_m_t":"iab-IP-AddressToReleaseList","paragraph_zero_based":12635},{"literal_text_all_w_t_and_m_t":"List of IP address allocated for IAB-node to be released.","paragraph_zero_based":12636},{"literal_text_all_w_t_and_m_t":"iab-IP-Usage","paragraph_zero_based":12637},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the usage of the assigned IP address. If this field is not configured, the assigned IP address is used for all traffic.","paragraph_zero_based":12638},{"literal_text_all_w_t_and_m_t":"iab-donor-DU-BAP-Address","paragraph_zero_based":12639},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BAP address of the IAB-donor-DU where the IP address is anchored.","paragraph_zero_based":12640},{"literal_text_all_w_t_and_m_t":"keySetChangeIndicator","paragraph_zero_based":12641},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall derive a new KgNB. If reconfigurationWithSync is included, value true indicates that a KgNB key is derived from a KAMF key taken into use through the latest successful NAS SMC procedure, or N2 handover procedure with KAMF change, as described in TS 33.501 [11] for KgNB re-keying. Value false indicates that the new KgNB key is obtained from the current KgNB key or from the NH as described in TS 33.501 [11].","paragraph_zero_based":12642},{"literal_text_all_w_t_and_m_t":"ltm-Config","paragraph_zero_based":12643},{"literal_text_all_w_t_and_m_t":"This field includes the configuration related to LTM.","paragraph_zero_based":12644},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":12645},{"literal_text_all_w_t_and_m_t":"Configuration of master cell group.","paragraph_zero_based":12646},{"literal_text_all_w_t_and_m_t":"mrdc-ReleaseAndAdd","paragraph_zero_based":12647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bde6f285d03521ad89ca241e115578551e108eb09b9a8618c4c16b9eb24fbcb6","3d0006d9c7b7cfa073359763fa817ae1beea957a6f5c7216dc2192ed1d773153","8d4a27a04985a16abed2280a65b8070af7feadec48c0b78acbb221f7484c34b8","a094e50991a6f2248c2cc37dc0d41de0b5a5068338e895df2ea6eb6e885780c5","67eff6f0e8b21b041cd85aa1b5cda07e1a9760c1c4e1a7f8241aa1efa7d9c0d8","51fc2fd888571d0d5394a9b75bda5b08aa5b9337eca4c669cdeba5b7a6467195","49c0a54e03fc3db5ae0ad304eb77c32d0a9db02ccc11db811a4f1eb4acffedf6","23d80707afca3fecac104aef09db4bb9739fd451bf7191e254809cfbc4975bfb","cb9aec846e6af697a1ad5fb514cbfc943846733930488ef45dfe701fd894e76f","88a6f068fcdb566c537be0da4626ac83fae8dafddd2a536d93d0d4093e2c27a5","752da2bbce040ee6b91e6573e95ffe9a601bd8d32e30e8e9ac5cfb804972c796","75cd977fe8b5b841ce991d20f37c07b05ebe00d4131ef9c5cb446ebcfbe686de","ccfa1ac598f9a86d38c27d1f7316ad65b6dd9e2b82bc6e93c29cc6a5114aa7f9","fdc513e6dae79841669abcce7bcc1f788656fa1839a88ae095415a9340b445ee","feb258696b8d9fa298c0c9f2c8705c5f680311d4a29d47521816d1a07db23fb4","af2619422b513751d36df7cc59185b4ad1bab1da933936dd4f3723e0614015ab","087f10d78ff73f1a104e7fdc1bc203e1c964dc4b2482d03dbe63a4d53272a955","96ec0477d04ba12e8b3a4ed0a57b07911f331968e7b271498f10d654aa846646","b7e18b4d8a6ed237fcb59912e5382c83475b18ffb1659fcd274bc75a4d101a6c","f5fcdbbab6ff5051528d434f1924a9a3b764c95c25474a046641301e0a1ca4c5","03d8276398097db2417706295674e010e85931db6b2361aa2e2df10433400b74","1549997ec7d917c84172dcb899d59e5c1fe2f817707d6519a3a826db883cfa47","f5dbfad519bc0888dddb21f30380e640169ef275a20ddc79a9d94c69ed51c63b","b46497a82d4d2f5495aeacc1cdd17cae406dda6d6c977f4a1b2167fe213d3583"],"paragraph_range_zero_based":[12624,12647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12624"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates that the current SCG configuration is released and a new SCG is added at the same time.","paragraph_zero_based":12648},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":12649},{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup, otherConfig, conditionalReconfiguration, ltm-Config, measConfig, bap-Config, IAB-IP-AddressConfigurationList and appLayerMeasConfig.","paragraph_zero_based":12650},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration.","paragraph_zero_based":12651},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroupConfig","paragraph_zero_based":12652},{"literal_text_all_w_t_and_m_t":"This field is used to configure and release an SCG in NR-DC and NE-DC. In case the RRCReconfiguration message is part of an LTM-Candidate IE associated with the MCG, if this field is present its value can only be set to release.","paragraph_zero_based":12653},{"literal_text_all_w_t_and_m_t":"musim-GapConfig","paragraph_zero_based":12654},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration and controls setup/release of MUSIM gaps. In this version of the specification, the network does not configure MUSIM gap together with concurrent measurement gap or preconfigured measurement gap for positioning.","paragraph_zero_based":12655},{"literal_text_all_w_t_and_m_t":"nas-Container","paragraph_zero_based":12656},{"literal_text_all_w_t_and_m_t":"This field is used to transfer UE specific NAS layer information between the network and the UE. The RRC layer is transparent for this field, although it affects activation of AS  security after inter-system handover to NR. The content is defined in TS 24.501 [23].","paragraph_zero_based":12657},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":12658},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":12659},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":12660},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":12661},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":12662},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":12663},{"literal_text_all_w_t_and_m_t":"needForInterruptionConfigNR","paragraph_zero_based":12664},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report interruption requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message. The network sets this field to enabled only if the needForGapsConfigNR is configured. The network sets this field to disabled if the needForGapsConfigNR is released.","paragraph_zero_based":12665},{"literal_text_all_w_t_and_m_t":"nextHopChainingCount","paragraph_zero_based":12666},{"literal_text_all_w_t_and_m_t":"Parameter NCC: See TS 33.501 [11]","paragraph_zero_based":12667},{"literal_text_all_w_t_and_m_t":"onDemandSIB-Request","paragraph_zero_based":12668},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE is allowed to request SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5.","paragraph_zero_based":12669},{"literal_text_all_w_t_and_m_t":"onDemandSIB-RequestProhibitTimer","paragraph_zero_based":12670},{"literal_text_all_w_t_and_m_t":"Prohibit timer for requesting SIB(s) on-demand while in RRC_CONNECTED according to clause 5.2.2.3.5. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":12671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9efe7ee5a9e71e7da9e7db18510797315d31a87631d1fe3595f638bb236360d2","5f08daa090235be3fa5ba1e6c026645001c1c0a2b4cab173e84621e0f2dd65ab","89ddc1ae6466f02728c84ea9a8dfe2aecf299325665f7a20b3c6b823040fa347","641dbd62117e8a6c9258b55496e2f2f4791f3cc73442d03426556090d5a66e9f","df175ae17d2594fcc276d95984e24e6911f7d0c27f59b3656bd589c860e56402","fe08102922dfebd7990a6f3f16e3e57bf99d0483502ec05d9168d681c0137027","8440577e8e48fddbd44380c3a64af92f2c742fb8b17c6368d58668e34af8be43","d72bb687405b7b3dc9b66df6a2596915b42a37c2740d73d2282ed9cd1fdab0bb","e571f330f753aca25b24b60dd0fd5d4a9a18643e93f9dd500106cf8f7cb71ffe","cf9af81b636f2fe8d5552d558d8329752f65bf024c73e1c61bb8e48a4ad371bc","f148190062ee3bbd7ece7a3d15c7a302097836a68e309508226daaff5e9185aa","ac2e1835e4662e846afdf642d4ab37c3726ea206cdf449a4245aa65a29d94997","de2abf88531fc00b82470223e65cc17960d2b2160200732e55a832435fb3d176","b6604131e1abc0aedabdfebdd5c46927639d1172c3c5a0e39015d96f42455a0f","940d833cbf3252eab9c1da6728562c822a36469e73af63e13263cdedf6ff3821","d02bb166168ca02e881430dc1e492b92530d6e90b0638e493d786ad15046f82e","542ac0a14442c64b0f1eea7e1fce0f576d8cf09c0a3d0af0acd2cc43fc16a591","016c536079a17f0d462e050598f759d9943f076a76d30d5873c1ce663b9d5517","9f7b157bf3c8a4a9f7cbdd25752d46eac9ced8aa4f63865950b4558c16bde6cb","cbbaea11077b0db59a2ca0695e1d98e708fa5d157d65aafbf33efe8e1fee26c8","334b337bfbfb657a37af7f6e0afbe01845cf1572c7dd4b0dbdd23e3c34c6ac00","378dcedc02e2cd57c07a61828d8c9a888d16881759d6a43dc507083300cb2342","6267b766facbe2ab5144860ec0b1c01aaf2fca748147e171db2bbcfe69b4e504","2ee2f0f4131797a69c7e9c418f92bea13c716326fd127f31d9d6d84cedac078a"],"paragraph_range_zero_based":[12648,12671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12648"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"otherConfig","paragraph_zero_based":12672},{"literal_text_all_w_t_and_m_t":"Contains configuration related to other configurations. When configured for the SCG, only fields drx-PreferenceConfig, maxBW-PreferenceConfig, maxBW-PreferenceConfigFR2-2, maxCC-PreferenceConfig, maxMIMO-LayerPreferenceConfig, maxMIMO-LayerPreferenceConfigFR2-2, minSchedulingOffsetPreferenceConfig, minSchedulingOffsetPreferenceConfigExt, rlm-RelaxationReportingConfig, bfd-RelaxationReportingConfig, btNameList, wlanNameList, sensorNameList, obtainCommonLocation, idc-AssistanceConfig, multiRx-PreferenceReportingConfigFR2, ul-TrafficInfoReportingConfig, n3c-RelayUE-InfoReportConfig, successPSCell-Config and sn-InitiatedPSCellChange can be included.","paragraph_zero_based":12673},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":12674},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP. In (NG)EN-DC this field may only be present if the RRCReconfiguration is transmitted over SRB3. SRB4 should not be configured if sl-L2RemoteUE-Config-r17 is configured or not released.","paragraph_zero_based":12675},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":12676},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":12677},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":12678},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":12679},{"literal_text_all_w_t_and_m_t":"This field is not used","paragraph_zero_based":12680},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received:","paragraph_zero_based":12681},{"literal_text_all_w_t_and_m_t":"-within mrdc-SecondaryCellGroup, or","paragraph_zero_based":12682},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionReconfiguration message, or","paragraph_zero_based":12683},{"literal_text_all_w_t_and_m_t":"-in an E-UTRA RRCConnectionResume message or","paragraph_zero_based":12684},{"literal_text_all_w_t_and_m_t":"-in an RRCReconfiguration message received via SRB3, except if the RRCReconfiguration message is included in DLInformationTransferMRDC.","paragraph_zero_based":12685},{"literal_text_all_w_t_and_m_t":"The field is absent if CPA, CPC, or subsequent CPAC is configured for the UE, or if the RRCReconfiguration message is contained in CondRRCReconfig, or PSCell is configured with tag2, or if the RRCReconfiguration message is included within an LTM-Config IE.","paragraph_zero_based":12686},{"literal_text_all_w_t_and_m_t":"sl-L2RelayUE-Config","paragraph_zero_based":12687},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Relay UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Relay UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO.","paragraph_zero_based":12688},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":12689},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by a UE acting as or to be acting as a L2 U2N Remote UE or L2 U2U relay operation related configuration used by a UE acting as a L2 U2U Remote UE. In case of L2 U2N relay operation, the field is absent if conditionalReconfiguration is configured for CHO, or if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":12690},{"literal_text_all_w_t_and_m_t":"secondaryCellGroup","paragraph_zero_based":12691},{"literal_text_all_w_t_and_m_t":"Configuration of secondary cell group ((NG)EN-DC or NR-DC).","paragraph_zero_based":12692},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":12693},{"literal_text_all_w_t_and_m_t":"A counter used upon initial configuration of S-KgNB or S-KeNB, as well as upon refresh of S-KgNB or S-KeNB. This field is always included either upon initial configuration of an NR SCG or upon configuration of the first RB with keyToUse set to secondary, whichever happens first. This field is absent if there is neither any NR SCG nor any RB with keyToUse set to secondary.","paragraph_zero_based":12694},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":12695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d5b37938f14af05b5c5a80ee60cde765d56794328373503b3485bb0d399332d2","6acab4235f5f81cbd8cdfa0d0dbcfcba10ab30e4bb53fc1a82f003b48f4242b0","33a32aca48eb9d40fff8050f81b7351fe680ac059cd3698b245db4ee286dff52","cdef6062fab8268a39a91affb9ee2dee5bd7f298767df103552903f7aaaa05a8","730a50493304124901176550fd49515aed312c0028628b0149202bc5e5170426","e4409d68d3a034da6c1a57a4b1e2157940e0ed6908cb587722392d6dfb570dee","ca30f595d2f73c53bab695c5fa89f6575c61881e5d440197f0e15ae9646bcaaf","202a50b6c7b8e331acd82b9af2e8466b6ed9d54ae136b5815a6d6f3b5f4e26b3","0e47faad050c23c4c19bc08ce358bbe42a66584bbd85eb6619a3bea8a89e894b","34a980bd54de71c3cec0d5d61d5c4a17544e56929a42e6bda0ef340052888167","ffed07ce556cc5e6ead08d3154841ea82e7f670df084a3de469a0e3e261ac7c0","fe3e0e5e8f6d8ff92c98ce5b25d0017d9306ad9ebd338a0cc66e39c0d4719593","2b8f1ecb26efdb8a579205f2be5558d939bc519506d9dc2c0b5434eefc713f6e","cee635638a0cba347a36defdd7970999f08830bc504e932e89db1b9c5ae85230","17b68ea1f9b61c74a9fe16c43f4ea6be8eb481383b21997544c1bb4fb85419b3","6f505b6f7f538842de4549ce77c68c5d8d0c39eefa79933badcdbcca0d5efd1d","c03a4fea65d38dbd65fbd573ac1c85290405bef9f2429e2b3f2f16c097ac2a1d","88d2fdf926777c0a14b89505d4f6455e1b5a12a0cc5c0000d4af1c90f63776f1","9a8474d543d9e964c3bca6122a8b1191ed2dda2217e5d4e27222fd99f1633e2e","a37446742443b3ffd8dc39c201baaf75c3c6976f4b59983c0154b9faba28321a","7d0cc8ad20895c47e7c058720d6152e894b427eeabec388f0639f42865f272cf","441a580e6e3eaab711752baf641ee997c3af02c490434bbef02b5f5786cf5b15","91a055f4058091ae122e265592f215a8c5dc69b4b863163354c28bfd108f1f9d","a24b55a0685857ae126971a599a8ed808bd895ae012dfc6861dd28a6f770f311"],"paragraph_range_zero_based":[12672,12695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12672"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery/positioning.","paragraph_zero_based":12696},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedEUTRA-Info","paragraph_zero_based":12697},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA RRCConnectionReconfiguration as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRCConnectionReconfiguration can only includes sidelink related fields for V2X sidelink communication, i.e. sl-V2X-ConfigDedicated, sl-V2X-SPS-Config, measConfig and/or otherConfig.","paragraph_zero_based":12698},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetLinkedForAggBWList","paragraph_zero_based":12699},{"literal_text_all_w_t_and_m_t":"This field indicates the SRS resource sets across two or three carriers which are linked for SRS bandwidth aggregation in RRC_CONNECTED state as defined in clause 6.2.1.4 of TS 38.214 [19].","paragraph_zero_based":12700},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetEUTRA","paragraph_zero_based":12701},{"literal_text_all_w_t_and_m_t":"This field indicates the possible time offset to (de)activation of V2X sidelink transmission after receiving DCI format 3_1 used for scheduling V2X sidelink communication. Value ms0dpt75 corresponds to 0.75ms, ms1 corresponds to 1ms and so on. The network includes this field only when sl-ConfigDedicatedEUTRA is configured.","paragraph_zero_based":12702},{"literal_text_all_w_t_and_m_t":"targetCellSMTC-SCG","paragraph_zero_based":12703},{"literal_text_all_w_t_and_m_t":"The SSB periodicity/offset/duration configuration of target cell for NR PSCell addition and SN change. When UE receives this field, UE applies the configuration based on the timing reference of NR PCell for PSCell addition and PSCell change for the case of no reconfiguration with sync of MCG, and UE applies the configuration based on the timing reference of target NR PCell for the case of reconfiguration with sync of MCG. If both this field and the smtc in secondaryCellGroup -> SpCellConfig -> reconfigurationWithSync are absent, the UE uses the SMTC in the measObjectNR having the same SSB frequency and subcarrier spacing, as configured before the reception of the RRC message.","paragraph_zero_based":12704},{"literal_text_all_w_t_and_m_t":"t316","paragraph_zero_based":12705},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T316 as described in clause 7.1. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on. This field can be configured only if the UE is configured with split SRB1 or SRB3.","paragraph_zero_based":12706},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-RequestUL-TDOA-Config","paragraph_zero_based":12707},{"literal_text_all_w_t_and_m_t":"Configures the periodicity of UE reporting for the association between Tx TEG and SRS Positioning resources. When configured with oneShot UE reports the association only one time. When configured with periodicReporting UE reports the association periodically and the periodicReporting indicates the periodicity. Value ms160 corresponds to 160ms, value ms320 corresponds to 320ms and so on.","paragraph_zero_based":12708},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-Config","paragraph_zero_based":12709},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 UL gap configuration to UE. In EN-DC and NGEN-DC, the SN decides and configures the FR2 UL gap pattern. In NE-DC, the MN decides and configures the FR2 UL gap pattern. In NR-DC without FR2-FR2 band combination, the network entity which is configured with FR2 serving cell(s) decides and configures the FR2 UL gap pattern.","paragraph_zero_based":12710},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12711},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":12712},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":12713},{"literal_text_all_w_t_and_m_t":"nonHO","paragraph_zero_based":12714},{"literal_text_all_w_t_and_m_t":"The field is absent in case of reconfiguration with sync within NR or to NR; otherwise it is optionally present, need N.","paragraph_zero_based":12715},{"literal_text_all_w_t_and_m_t":"securityNASC","paragraph_zero_based":12716},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover. Otherwise the field is optionally present, need N.","paragraph_zero_based":12717},{"literal_text_all_w_t_and_m_t":"MasterKeyChange","paragraph_zero_based":12718},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case masterCellGroup includes ReconfigurationWithSync and RadioBearerConfig includes SecurityConfig with SecurityAlgorithmConfig, indicating a change of the AS security algorithms associated to the master key. If ReconfigurationWithSync is included for other cases, this field is optionally present, need N. If ReconfigurationWithSync is part of an LTM-Candidate IE associated with the MCG, the field is absent. Otherwise the field is absent.","paragraph_zero_based":12719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["230644a97ace19022ac0f33c85417817bf83750ae8c293c139a7eff5c2067967","5e4fb7042a0d1cdf0a51c07b849b0d396da1b46afed2c54b442c8b40e8f68fb0","181ab8e83d3c46ce89392532d2ab0b00f4a0b900f5f22cd3997e25d1dbfa1f73","747341f1e50b9e40a6d1d524c1a3bf04fd870c13d382914353009bbaf784e7bc","43aee094177e7345b7544aca1eaa6eb4eeebb0332b80bd687492ead9bdb0a803","483a75d81e5263c69d22624f7c1864c0e0493df72f8dcffbb3b6f637a05cea61","372ccb9c090e646b3b2c3cf3ff6e65f75bc5a9da3598eec19b0d3d966031efbe","c480558660bba06dc8b38630021c2d6de5db0f8e3cdc42c8cb7ab6fe71fd41df","65b04dc336ad6e45f02398f4a0da9d0612de89acc41975556072ade2aa1959bb","c74755fae451134565559dd4c860d283f6e1e8af650d83be71e9102ec1075f99","2b47c4d0a603b323fcf459dd24a62c963c388696438188560f77f1bd314c10e5","70fee9a321b305508b85e99564eb99f3a659e84415fd4ec754761cfd4ff6fbdd","64c5d7ccfd4cb2b9286f979e121fcf630ee1fddd1a207af5670a3d9b0a2a2020","3dc59bf153135242539f43166f6e905eb725916126bf3564e2c5c9d9af2303ae","0df0aef8b095c8c2ab5d9b3e555c6526b6b254ab0eaad25c5593258316470e5c","8202d133049c10673a48d21fcfc484ece463ee99283e90d5f3d3828eb508e75c","28a7ca4c7900661c797aa34f6dade72b8e4f1bfc18310adfe6883d5ee4ca6fa1","83db5b30d4158d9a170a85827ee34d75d19886dedac9c7f0daf7d362cc91225c","ff5a12bc3a4f96658f0f814932885a2cc67ea36f352336e1b154b1e94a77d937","ec5febac5f51c3953da10d32456439820123fdb7cb4d309dbe284b21953c27a4","6d163d7adcacb9c6ecc4caa9229a6d730d8d38534241b57117fae78f6f3892ed","e6ee7b1f161234d59821342d24b3690aee25be2ee592576b8f0a7a35e86f7160","acdcc216786d1137b3f005579f7e735f5369b2a4c56db16b8c2e0945970a9be6","8a47091fd38bad8099cfae8a8092af4188745785d811ec24506aae08b11c7d2b"],"paragraph_range_zero_based":[12696,12719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12696"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FullConfig","paragraph_zero_based":12720},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of inter-system handover from E-UTRA/EPC to NR. It is optionally present, Need N, during a reconfiguration with sync which is not related to an LTM cell switch or subsequent CPAC, and also in first reconfiguration after reestablishment; or for intra-system handover from E-UTRA/5GC to NR. It is absent otherwise.","paragraph_zero_based":12721},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":12722},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in:","paragraph_zero_based":12723},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCResume message (or in an RRCConnectionResume message, see TS 36.331 [10]),","paragraph_zero_based":12724},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in an RRCConnectionReconfiguration message, see TS 36.331 [10], which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":12725},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need M, in:","paragraph_zero_based":12726},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message transmitted on SRB3,","paragraph_zero_based":12727},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message (or in an RRCConnectionReconfiguration message, see TS 36.331 [10]) transmitted on SRB1","paragraph_zero_based":12728},{"literal_text_all_w_t_and_m_t":"-an RRCReconfiguration message contained in another RRCReconfiguration message which is contained in DLInformationTransferMRDC transmitted on SRB3 (as a response to ULInformationTransferMRDC including an MCGFailureInformation).","paragraph_zero_based":12729},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent.","paragraph_zero_based":12730},{"literal_text_all_w_t_and_m_t":"PagingRelay","paragraph_zero_based":12731},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need N. Otherwise, it is absent.","paragraph_zero_based":12732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12733},{"literal_text_all_w_t_and_m_t":"–RRCReconfigurationComplete","paragraph_zero_based":12734},{"literal_text_all_w_t_and_m_t":"The RRCReconfigurationComplete message is used to confirm the successful completion of an RRC connection reconfiguration.","paragraph_zero_based":12735},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1 or SRB3","paragraph_zero_based":12736},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12737},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12738},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":12739},{"literal_text_all_w_t_and_m_t":"RRCReconfigurationComplete message","paragraph_zero_based":12740},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12741},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRECONFIGURATIONCOMPLETE-START","paragraph_zero_based":12742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f75800550be2e92b11733104878be3d45504afa7ac8f7ce01dcfaa83586212a7","a8fdd21ef9f6b7d49eddeabbacb91c660a9cf0fe4767e51b81cddbbbbe6ae7d7","349522717c54035ecd47746a137341f268e8811c55130980e7854fca3bb8e1