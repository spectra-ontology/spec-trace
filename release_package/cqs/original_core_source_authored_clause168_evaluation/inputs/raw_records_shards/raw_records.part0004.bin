{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    dl-P0-PSFCH-r17            INTEGER (-202..24)                                                                 OPTIONAL    -- Need M","paragraph_zero_based":46776},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46777},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46779},{"literal_text_all_w_t_and_m_t":"SL-PRS-ResourceSharedSL-PRS-RP-r18::= SEQUENCE {","paragraph_zero_based":46780},{"literal_text_all_w_t_and_m_t":"    sl-PRS-ResourceID-r18                 INTEGER (0..16),","paragraph_zero_based":46781},{"literal_text_all_w_t_and_m_t":"    mNumberOfSymbols-r18                  INTEGER (1..9),","paragraph_zero_based":46782},{"literal_text_all_w_t_and_m_t":"    sl-PRS-starting-symbol-r18            INTEGER (4..12),","paragraph_zero_based":46783},{"literal_text_all_w_t_and_m_t":"    sl-PRS-CombSizeN-AndReOffset-r18  CHOICE {","paragraph_zero_based":46784},{"literal_text_all_w_t_and_m_t":"        n2-r18                           INTEGER (0..1), ","paragraph_zero_based":46785},{"literal_text_all_w_t_and_m_t":"        n4-r18                           INTEGER (0..3), ","paragraph_zero_based":46786},{"literal_text_all_w_t_and_m_t":"        n6-r18                           INTEGER (0..5), ","paragraph_zero_based":46787},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":46788},{"literal_text_all_w_t_and_m_t":"    }                                                                                                              OPTIONAL         -- Need M","paragraph_zero_based":46789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46791},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RESOURCEPOOL-STOP","paragraph_zero_based":46792},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46794},{"literal_text_all_w_t_and_m_t":"Editor's note: The value range of sl-PSFCH-PowerOffset may need to be updated based on RAN4 reply LS.","paragraph_zero_based":46795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46796},{"literal_text_all_w_t_and_m_t":"SL-ZoneConfigMCR field descriptions","paragraph_zero_based":46797},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":46798},{"literal_text_all_w_t_and_m_t":"Indicates the communication range requirement for the corresponding sl-ZoneConfigMCR-Index. The unit is meter.","paragraph_zero_based":46799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1b488a79c50fc0073b716c7d11c7696d2fea8fecfe9b3fce997cd517c7183085","e01bf1a3f86d0f4a3ca556682abbf140ecfbd8181e2a62a1edea58f51b063bd9","5bf93ee5a26decec6241698564e23fd812e5ad576819bbcbb6a23d4485402b35","ccf73c2a5e5d0a6d12d6adc1d39bd9a023541fa779f2823311836ea02ae59182","01aaae7f97767c1676e4c8dad93160951637b00d24460264bb7f9dfe6bd857ad","0e80e919643aa27daea7429f129cc63e70ad328998becc1fdaeeb0330b54377b","4154e0db0507cc2823b381f23963c6e7e2b14f66fe0d19f474234b05ca937540","574ad8e30502ef69a3610d6438e2f4e7aee4b6b8c30eec6ef53e076bd701f1e4","af9828aed9b0c4e170c35ee39ea43842fc636501d01a79d6dfc970d390eec93c","d514cbb8ca84c49f2c6025ad29709f0703324a4ee4d656642f039a62545f9b2d","25f377af4d2289f94d3f65ed9d02674ee3a118b6e2f9739a8c90fb4b9236cf88","750890b63a6cee096e59a77d643a2026eec7986f372e68fde5598b9333acca7a","278557bb6f84a11107b6558e05b9fc1c48dd20409da21e51a18a37200a6a7f4a","6bd51bd43ea10d5bd2a35519e171e5c9d22bc17019cb0813bedfe6ccafdd9860","74949d39ce35ea5d2d959c16f1893e5ed6f86e5b8ed4717dfb01f526df3f6589","7cbf6ca3e3f8e63300a5c52b5f3fc48ac58e69a6a1674c64324782fbb7d580b5","0620ec035a129c8868a6fa3773cfbec733a39db3031fae25949963f6df274d65","676fb7cfcc20ba4a0f93672cd5a2e1390edf71c8674875e00cf3b32005f121d0","26266db7046f61288bd2da607b6b89cd0d05bccc5784d93d7e3b717d6560f272","3bf1869f69861e403dd475058e9b4b8d1d0c10e5a0f9d10098543490699df9b0","07a32f1afa32aef96aa77c1318a1ecc37260fd5fcdce9e1d11151798403fd6d8","39a38fb9fc8e2c41d15159ea37065349922f4a0aa8e3a1cb6a807a63e9272a38","dc0bad21033b14099cf7c4cd169cd27d1cbb80ce998e8f0f8b0dd8559566e83f","b08691f691c976af40f49c3241797dfb3a95a079bd304a66499bc0cbf53ef70b"],"paragraph_range_zero_based":[46776,46799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46776"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-ZoneConfig","paragraph_zero_based":46800},{"literal_text_all_w_t_and_m_t":"Indicates the zone configuration for the corresponding sl-ZoneConfigMCR-Index.","paragraph_zero_based":46801},{"literal_text_all_w_t_and_m_t":"sl-ZoneConfigMCR-Index","paragraph_zero_based":46802},{"literal_text_all_w_t_and_m_t":"Indicates the codepoint of the communication range requirement field in SCI.","paragraph_zero_based":46803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46804},{"literal_text_all_w_t_and_m_t":"SL-ResourcePool field descriptions","paragraph_zero_based":46805},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":46806},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":46807},{"literal_text_all_w_t_and_m_t":"numSym-SL-PRS-2ndStageSCI","paragraph_zero_based":46808},{"literal_text_all_w_t_and_m_t":"Indicates the number symbols to be assumed for SL PRS in determining the number of coded modulation symbols for second stage SCI in a slot of a shared SL PRS resource pool.","paragraph_zero_based":46809},{"literal_text_all_w_t_and_m_t":"sl-A2X-Service","paragraph_zero_based":46810},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the resource pool is dedicated for A2X service, i.e., not to be used for other than A2X service. Value brid indicates the resource pool is for BRID, value daa indicates the resource pool is for DAA, and value bridAndDAA indicates the resource poos is for both BRID and DAA. If this field is absent in all the configured resource pools, the UE may choose non-dedidcated resource pool for A2X service.","paragraph_zero_based":46811},{"literal_text_all_w_t_and_m_t":"sl-Additional-MCS-Table","paragraph_zero_based":46812},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table(s) additionally used in the resource pool. 64QAM table is (pre-)configured as default. Zero, one or two can be additionally (pre-)configured using the 256QAM and/or low-SE MCS tables. If two MCS tables are indicated, 256QAM MCS table is the 1st table and qam64lowSE MCS table is the 2nd table as specified in TS 38.214 [19], clause 8.1.3.1.","paragraph_zero_based":46813},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-InitiateCOT-Default","paragraph_zero_based":46814},{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position index for the default CPE starting position, to be used for PSCCH/PSSCH transmission when UE initiating a COT.","paragraph_zero_based":46815},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-InitiateCOT-List","paragraph_zero_based":46816},{"literal_text_all_w_t_and_m_t":"Indicates a set of selected indices that correspond to multiple candidate CPE starting positions to be used for PSCCH/PSSCH transmission when UE initiating a COT, associated per L1 priority of PSSCH.","paragraph_zero_based":46817},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-WithinCOT-Default","paragraph_zero_based":46818},{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position index for the default CPE starting position, to be used by UE for PSCCH/PSSCH transmission within a COT.","paragraph_zero_based":46819},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionsPSCCH-PSSCH-WithinCOT-List","paragraph_zero_based":46820},{"literal_text_all_w_t_and_m_t":"Indicates a set of one or multiple selected indices that correspond to one or multiple candidate CPE starting positions to be used by UE for PSCCH/PSSCH transmission within a COT, associated per L1 priority of PSSCH.","paragraph_zero_based":46821},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionPSFCH","paragraph_zero_based":46822},{"literal_text_all_w_t_and_m_t":"Indicates CPE starting position within the GP symbol before PSFCH transmission. The value is an index of the set of all candidate CPE starting positions specified in Table 5.3.1-3 of [16, TS38.211] for Ci=1 and the corresponding SCS of the SL BWP.","paragraph_zero_based":46823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b651c54f840d928b61597925172a36c7b1af4d321f88416ba7d6dd34a40b203d","72c8d862a6ee3faef72161ac1b8d5773613181e8f4ca0a3c26ece6264ff466a0","e2f89df2f6e2581c3030957700f39461ae30e6168d99e6e34f1b23ef855d6c90","6ab8cb3e572ad79bc9f011f55b425f7c6bd499229135df009da2afcceae34ecd","cb3383861cf8941e93047433c031306cf50a89edc849bd11c6f0361520494175","0b6c12ef0fc5f8baa19840f061581b937f6e3470731fa0050569b50678c10bae","da1095d7d1cd81e8e25aaf9f1997df6a0eccca340371be9d2a5985ac38e5fecf","3a8a8b06269d89ec163a72f85f7d4241ab6703e119e457490a1aebb6930e5429","bd3db63521f0ff4bf0afdabff6da2295e5f8f210152255aa04aee8615e0b10c2","dd5bb67e8bec5d68015bf482195df72d916741e0c2ca8b22c6c682bc91312e24","29cec0fc44aa6b678fe693830b9248cafad32556e40adeaaee17001945fc9ae3","a6647d3a955621ac77f3000b19281c6b73b818d76d40b89906a909fbf3d3f1d4","fc817a606ee569712fb7436b0d2bdc4dbed0215e792cc5efc3a3a90e2bb2875d","880a8b854f4643058c5b5cc358ac57d35266b0eae27ba66bb0780f317eb15bee","e47f7c3ba0a2b31dc443a2058dcb8b8d5c83cf55f71d1682485afc790a1088a6","39fa411f29ae840d9e79290a7bb1970190ea935ba3c4973fd5dbba2dd0e5f5ea","aab1f3d0175b0780030c8c7fb6733c6e8eb441c1a2c103447ad0f0e8aed2dc0f","02e46b440d0ea846fcf6d7e81b547fde885627fd4dd2060e8127fdc56ac7e88a","cab58c7262b3f32da380650b7b779e2e59874028bd1c9a021313d6983d526ede","1d13f9b4d4acc9bda90593a5f027f8dfbcbc7c4a8c178558d46b6f33105442b6","8cf91ac6e31efe517f3b3f580e74301844396c8217092e46b0e6a8db6e475d95","f167d98fa339ce6d2b2b70c4178034a1cd9c9ce332ee6b9b86362c29b41f4c64","77cdf60e0ba1e4cd5cd48e38ddff74929b437ccd2ed063d3426dd44aba352654","5cff466d90e763b90d8a6b76acdd315e3dc23c34ce6149680cff10d23180d067"],"paragraph_range_zero_based":[46800,46823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46800"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":46824},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":46825},{"literal_text_all_w_t_and_m_t":"sl-InterUE-CoordinationConfig","paragraph_zero_based":46826},{"literal_text_all_w_t_and_m_t":"Indicates the configured sidelink inter-UE coordination parameters.","paragraph_zero_based":46827},{"literal_text_all_w_t_and_m_t":"sl-IUC-RB-SetList","paragraph_zero_based":46828},{"literal_text_all_w_t_and_m_t":"The n-th value in the list indicates the set of PRBs that are actually used for inter-UE coordination information transmission and reception in Scheme 2. It shall be (pre-)configured such that N candidate PSFCH occasion(s) are associated with N different PRB sets. PRBs within intra-cell guard band are not used for PSFCH transmission. The length of this list is aligned with sl-NumPSFCH-Occasions. For each PSFCH occasion, the set of PRBs are indicated in the same format as in sl-PSFCH-RB-Set.","paragraph_zero_based":46829},{"literal_text_all_w_t_and_m_t":"sl-NumDedicatedPRBs-ForPSFCH","paragraph_zero_based":46830},{"literal_text_all_w_t_and_m_t":"Indicates the value of K3 when each PSFCH transmission occupies \"1 common interlace and K3 dedicated PRB(s)\" (as indicated by sl-TransmissionStructureForPSFCH). Value prb1 corresponds to K3=1, value prb2 corresponds to K3=2, and so on. UE expects the same (pre-)configured value of sl-NumDedicatedPRBs-ForPSFCH across all resource pools.","paragraph_zero_based":46831},{"literal_text_all_w_t_and_m_t":"sl-NumInterlacePerSubchannel","paragraph_zero_based":46832},{"literal_text_all_w_t_and_m_t":"Indicates the number of (K) interlaces per sub-channel within a resource pool. Value sc1 corresponds to 1 interlace per sub-channel, and value sc2 corresponds to 2 interlaces per sub-channel. The applicable values are related to the subcarrier spacing as below:","paragraph_zero_based":46833},{"literal_text_all_w_t_and_m_t":"For SCS = 15 kHz: K=1 or 2","paragraph_zero_based":46834},{"literal_text_all_w_t_and_m_t":"For SCS = 30 kHz: K=1","paragraph_zero_based":46835},{"literal_text_all_w_t_and_m_t":"sl-NumPSFCH-Occasions","paragraph_zero_based":46836},{"literal_text_all_w_t_and_m_t":"Indicates one PSCCH/PSSCH transmission has N associated candidate PSFCH occasion(s). Value o1 corresponds to N=1, value o2 corresponds to N=2, and so on. If the field is not configured, the UE shall use value o1.","paragraph_zero_based":46837},{"literal_text_all_w_t_and_m_t":"sl-NumReferencePRBs-OfInterlace","paragraph_zero_based":46838},{"literal_text_all_w_t_and_m_t":"Indicate reference number of PRBs of one interlace within 1 RB set. Value prb10 corresponds to 10 PRBs, and value prb11 corresponds to 11 PRBs.","paragraph_zero_based":46839},{"literal_text_all_w_t_and_m_t":"sl-NumRefSymbolLength","paragraph_zero_based":46840},{"literal_text_all_w_t_and_m_t":"Indicates a reference number of symbols for TBS determination.","paragraph_zero_based":46841},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannel","paragraph_zero_based":46842},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":46843},{"literal_text_all_w_t_and_m_t":"sl-PBPS-CPS-Config","paragraph_zero_based":46844},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource allocation schemes of full sensing only, partial sensing only, random resource selection only, or any combination(s), and the related configuration for power saving resource allocation schemes. This field is absent for sl-TxPoolExceptional.","paragraph_zero_based":46845},{"literal_text_all_w_t_and_m_t":"sl-PreemptionEnable","paragraph_zero_based":46846},{"literal_text_all_w_t_and_m_t":"Indicates whether pre-emption is disabled or enabled in a resource pool. If the field is present and the value is pl1, pl2, and so on (but not enabled), it means that pre-emption is enabled and a priority level p_preemption is configured. If the field is present and the value is enabled, the pre-emption is enabled (but p_preemption is not configured) and pre-emption is applicable to all levels.","paragraph_zero_based":46847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["be149a0eb3009c0e9e7255ae5bfd3e5c6da3e16a720549eb9e00e6c57e923553","f824a48f690fea81cea1ac68ed539e229ad6fda3a7ce114328011539a663735c","a3e3c86fa658d0aa24afd68487685807d25e091ab17b6699d4d3f919a0d92097","38361b1aaff63e58ec28c51d3f1618448246b30b9370c187c7150057b2d9524d","caf728664f2f144410552d082991b272df0c03bb7aca977ea6c913d050efd633","75c3c6bcca66ed479210abb40088b9f31fcf3d99be16bf3e7a12d1bbcbf3f841","132a96e3d1aa1c281644a300e9e7032c509427433fe36a824906ef519ee62030","4ace12ae8ba133bab54d31b8011442f7f3f253fd3353c89ae1e94ee0b44e7c3e","42c733fcd06e9ebb79ac8ee155a1e503ee1afc39d17a05095dc1c88040641616","d47a689b5f90a0117544ffc2fbae994ac0378588d44e12dabf1c42fecca7f1de","a9b32b9403853929712c355d6eddbd145312110ab37f1657c7547977f8090a73","713476fc99244e7747d98f05178b4ec96889979a5940e89730311640ee881996","d322aef0576fb4debc201f0824d4599307177b6694041b57e6553f021392e03e","b9b7a2dcc014baa59ada1fb991e3fd3b7d6d31cfe2bd19ff903a1db468526b41","e61db3db421c985c1c30f5065a4322495f8537098376334b204ea4a6bd543e66","7601ab3ec28e661c1492712f808d12688e29c4ae3e1f26d481ccad62d38d3136","80a7c0f322562c727e6f087cb0f5f83eebdd6cad2253373865a2fa480da28994","b0ec0dacd0918e283c804e1f1b3efee0baa89994371d342559379ea170e4706f","60f24de828e2e6fa8f2918e5151bca2c98067f0eabae30b291679812ba4fef15","a73e2a536a2854ee38067ec038feddcabbb1bc3f262f07ce4158a5022ab92927","367be4320978670cbe6b8c72f1c8dcf741a767abeaf1bf5bd7fdd1b1adb6d1cc","9bc936edfe62854fcc3ffb2b6739f3b796f45309f6bc3983be1d22457c341fef","bc6c828198c965cda59888f05021f572ecce4885fc898c7768248b472dd34452","5187ebaf7da1667df33d9eaf6640e7b0a85f98356767651d6eca3392f3025aa7"],"paragraph_range_zero_based":[46824,46847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46824"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold-UL-URLLC","paragraph_zero_based":46848},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":46849},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":46850},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":46851},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourcesSharedSL-PRS-RP","paragraph_zero_based":46852},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS resources in a slot of shared SL PRS resource pool as defined in TS 38.211 [16].","paragraph_zero_based":46853},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CommonInterlaceIndex","paragraph_zero_based":46854},{"literal_text_all_w_t_and_m_t":"Indicate the index of common interlace to meet OCB requirements when transmissionStructureForPSFCH is set to common interlace. Value 0 corresponds to interlace 0 is used as common interlace, value 1 corresponds to interlace 1 is used as common interlace and so on.","paragraph_zero_based":46855},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-PowerOffset","paragraph_zero_based":46856},{"literal_text_all_w_t_and_m_t":"Indicates the power offset between Tx power on one common PRB (P_common) and Tx power on one dedicated PRB (P_dedicated) when sl-TransmissionStructureForPSFCH  is (pre-)configured as commonInterlace, i.e., P_common = P_dedicated - offset. UE expects the same (pre-)configured value of sl-PSFCH-PowerOffset across all resource pools. The unit is dB.","paragraph_zero_based":46857},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-SetList","paragraph_zero_based":46858},{"literal_text_all_w_t_and_m_t":"The n-th value in the list indicates the set of PRBs that are actually used for PSFCH transmission and reception of n-th PSFCH occasion of a PSCCH/PSSCH transmission.","paragraph_zero_based":46859},{"literal_text_all_w_t_and_m_t":"It shall be (pre-)configured such that N candidate PSFCH occasion(s) are associated with N different PRB sets. PRBs within intra-cell guard band are not used for PSFCH transmission. The length of this list is aligned with sl-NumPSFCH-Occasions. For each PSFCH occasion, the set of PRBs are indicated in the same format as in sl-PSFCH-RB-Set.","paragraph_zero_based":46860},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":46861},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding resource pool, which consists of contiguous PRBs only. The remaining RB cannot be used (See TS 38.214[19], clause 8).","paragraph_zero_based":46862},{"literal_text_all_w_t_and_m_t":"sl-RBSetIndexOfResourcePool","paragraph_zero_based":46863},{"literal_text_all_w_t_and_m_t":"For interlace RB based PSCCH/PSSCH, indicates the RB set index(s) included in the resource pool. Contiguous RB sets are (pre-)configured for a resource pool.","paragraph_zero_based":46864},{"literal_text_all_w_t_and_m_t":"sl-SCI-based-SL-PRS-Tx-Trigger-SCI2-D","paragraph_zero_based":46865},{"literal_text_all_w_t_and_m_t":"Indicates presence of a bit-field in SCI format 2-D to trigger SL-PRS transmission by a receiving UE.","paragraph_zero_based":46866},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":46867},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has SL-PRS to be transmitted to UE-A.","paragraph_zero_based":46868},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel","paragraph_zero_based":46869},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the subchannel with the lowest index in the resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":46870},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSize","paragraph_zero_based":46871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["878998d77d7f7809b638d70e21bc4425602bf666cd1f1756fa1d7667d6085282","f3c5509580718e12ea53b106257d21bfea1e5c72ce273eed97a9bacfa898a0e3","502865e24aa5da458576c377c8540bea62d84b03192d9d6874a3cce9fbac07ae","e571ed4a798aa47e5d2c52711addf67a32dce6ec18608d7ce29c41a0fbb73729","7190772688199f90ea3e5d3ad972445cf3794a192add70b9bce04e62f48ff3d3","7288108dc8cf8a0663c4de5ce73472edcbdc33a583ca4eef9e3b4590e49d67e1","30e366adc25655894d14994ce18365188be9c4a60fc8d0fe57f4e2215ad7be56","6f5fb23a081b8b3cc78c6be787f15c75aba43d95295242bba0c5b5344e8d1d76","9cd5408d99ff476acf1226ad475e7840020ce41ba4c91b18e99a3d7073d49460","a3e6e077b8e4f9a677b67079d885cd8337d65f1c9dcc3eb94c7bc165bfec377a","45f46583b34c389d564cbc60cc5c67192d2806ca45d45bb9874ce867ad3ca484","a89e6dae18460a4136b4e3e6a52a64d2907d5d592741ddb54352be4a226a7d1c","57252023b004aa36e167448253712d159ecf85c31417c59fa3e822174b6a58f6","f5cde9f36c0f3e1455d1a1cb1b4873c5276789f3531afca60b7882886f9f513f","73895eb4b70e65d634db011d18ea354f4d2d29dfbf29e22a866efc9af5053b1b","26f10e5cc865892ee4446b9a375e732d10af4d9939a139fe51e9e0d793aaefc5","33fbee880b40c8175c54dff8923861788820a7e7a95bce3a33a8b7ac88532278","1eae4692b63d432c6223493d647ff031551e98fa25d484b99a25d22a4f363502","b0fa845f1da6a7083b0bea87f3e15f2330af2d058070d704bf3c10a37d8344ec","95c2b2e15ce9bf62201eaea1dbc86ec87b2e345140b36dcb92a94f38af440098","7a898e24a48c039c957683a344365785dc3be2a7f8fc53999764d01772395beb","8b0f87c904f77af1f40a20bb466b22977c86e5db2cd70d14f8a1ac787bc1b5c8","4bc4fc2f2933939376c1a618461a3f2ebbe3a3a3b13ee4815163eaaa1a4e4922","b990a2e10f6792ba56759fac7844d0bf018acde67f7b0fa3252faea7bc15681f"],"paragraph_range_zero_based":[46848,46871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46848"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the minimum granularity in frequency domain for the sensing for PSSCH resource selection in the unit of PRB.","paragraph_zero_based":46872},{"literal_text_all_w_t_and_m_t":"sl-SyncAllowed","paragraph_zero_based":46873},{"literal_text_all_w_t_and_m_t":"Indicates the allowed synchronization reference(s) which is (are) allowed to use the configured resource pool.","paragraph_zero_based":46874},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigIndex","paragraph_zero_based":46875},{"literal_text_all_w_t_and_m_t":"Indicates the synchronisation configuration that is associated with a reception pool, by means of an index to the corresponding entry SL-SyncConfigList of in SIB12 for NR sidelink communication.","paragraph_zero_based":46876},{"literal_text_all_w_t_and_m_t":"sl-TDD-Configuration","paragraph_zero_based":46877},{"literal_text_all_w_t_and_m_t":"Indicates the TDD configuration associated with the reception pool of the cell indicated by sl-SyncConfigIndex.","paragraph_zero_based":46878},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-CBR","paragraph_zero_based":46879},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the CBR measurement. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":46880},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":46881},{"literal_text_all_w_t_and_m_t":"Indicates the bitmap of the resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":46882},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR","paragraph_zero_based":46883},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement.","paragraph_zero_based":46884},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR","paragraph_zero_based":46885},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation.","paragraph_zero_based":46886},{"literal_text_all_w_t_and_m_t":"sl-TransmissionStructureForPSFCH","paragraph_zero_based":46887},{"literal_text_all_w_t_and_m_t":"Indicate each PSFCH transmission occupies \"1 common interlace and K3 dedicated PRB(s)\", or \"1 dedicated interlace\". Value commonInterlace corresponds to \"1 common interlace and K3 dedicated PRB(s)\", and value dedicatedInterlace corresponds to \"1 dedicated interlace\". UE expects the same (pre-)configured value of transmissionStructureForPSFCH across all resource pools.","paragraph_zero_based":46888},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageList","paragraph_zero_based":46889},{"literal_text_all_w_t_and_m_t":"Indicates the portion of candidate single-slot PSSCH resources over the total resources. Value p20 corresponds to 20%, and so on.","paragraph_zero_based":46890},{"literal_text_all_w_t_and_m_t":"sl-Type1-LBT-BlockingOption1","paragraph_zero_based":46891},{"literal_text_all_w_t_and_m_t":"Indicates UE may avoid selection of N consecutive resource(s) before a reserved resource when the L1 SL priority value for the transmission is higher than the L1 SL priority value of the reserved resource, and UE may also avoid selection of M consecutive resource(s) after a reserved resource when the transmitting symbols of the reserved resource overlap with LBT of the selected resource. The selection of the value N is up to UE implementation from {0, 1, 2}. M is determined based on UE implementation (at least including 0).","paragraph_zero_based":46892},{"literal_text_all_w_t_and_m_t":"sl-Type1-LBT-BlockingOption2","paragraph_zero_based":46893},{"literal_text_all_w_t_and_m_t":"Indicates UE may prioritize/select resource(s) in the slot(s) for transmission, if UE's transmission in slot(s) before a reserved resource is able to share its initiated COT to the reservation.","paragraph_zero_based":46894},{"literal_text_all_w_t_and_m_t":"sl-X-Overhead","paragraph_zero_based":46895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fb737661de5f5a5ffae5f83c59aec46aa30a6a13479bb12524b5b684478f0297","c3c6555282cfe65c79c89c5ebc8175d474edb9728eca038c95457c2ab04ab1e8","875a7133dfa67bff51487ab539340215326df152aac69e1dfda8bdb45e980a54","14ed1937ee8dcc6e3a5775152902f90b17a2adba04b43ce1c0c06ad2b4b213cf","684b8f18811c023db0ef2faf355549762811af00f21535769e33cf965907d280","1614e90e247a603d621ff0c6f93efaab6be3e59e09c448cff57835dfd3fd30c1","b792e7cd1d5ab9f6ea2877b59da8e859af3260654a947a92758d1d9efe5ae9d6","ffa01168f5a72f95f5d87fa0eb676fecdb50bce6acd9dc19fc360641722dff09","87a0eea84066377e3c01a1a835a1258fd9ff92d5c16470dce00cd3cc59849084","3c1f2a431804057cb76c3fef012964f8091a4fadc448e86503a254cac39c4e3f","1e6ac956cbf9d51006dc718c94da4202469800a5b6eefec9d303ef90cd8d0b62","42b15211a3088c4f4a8f310815382e0583596086cff7849a4394bf1b218a7f33","a279bbfa0837dc297deb43dbd48e762088fe2d041aa0da40173b3ba7cebd4593","f4b897927f728e5d6371fc697275ad7bfe40a4b6b32b6c9444061f4f527e5ec0","90489180abe354492f1ba5053b71c9af2f2cc8acad4a2b3886c8f43d29bc31d7","f4aff1a147ab27cf09ea94cecc3e89386143df7667576051418f3b9274b8716e","6d83d056adec36a1850fce948304acbc1e1c3d45246528a82a3c00087d8ac711","6b7200ff1b3914207bb2749dae2cdb98feed6ab0ab3fd1e0e399ff2876babc0e","91963e6abf61908132afbebacda80ad52552b304b774663c742a656e6a8fb4a5","0d6b301e802fccb8de8d709e731de1445c9a1760281bab7b76de261de50cd931","b7cc675c708ba9f8d0bc5f5f53afed893adfb9319e4d366464b5b090753b77d8","598cfe5f33fa81e4a5f18fdebfbd09410977b329ef4888e9a17b89717851d81e","38975fe579ed0e0cb966d4e9e21f3d7dbbd88303196af5201d01db10cb1cbf40","5459ae53b578bfc569783464cd4e8a06931caaaae553860922cad53e5e4ced91"],"paragraph_range_zero_based":[46872,46895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46872"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, PT-RS. If the field is absent, the UE applies value n0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":46896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46897},{"literal_text_all_w_t_and_m_t":"SL-SyncAllowed field descriptions","paragraph_zero_based":46898},{"literal_text_all_w_t_and_m_t":"gnbEnb-Sync","paragraph_zero_based":46899},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to eNB or gNB (i.e., synchronized to a reference UE which is directly synchronized to eNB or gNB).","paragraph_zero_based":46900},{"literal_text_all_w_t_and_m_t":"gnss-Sync","paragraph_zero_based":46901},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is directly or indirectly synchronized to GNSS (i.e., synchronized to a reference UE which is directly synchronized to GNSS).","paragraph_zero_based":46902},{"literal_text_all_w_t_and_m_t":"ue-Sync","paragraph_zero_based":46903},{"literal_text_all_w_t_and_m_t":"If configured, the (pre-) configured resources can be used if the UE is synchronized to a reference UE which is not synchronized to eNB, gNB and GNSS directly or indirectly.","paragraph_zero_based":46904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46905},{"literal_text_all_w_t_and_m_t":"SL-PSCCH-Config field descriptions","paragraph_zero_based":46906},{"literal_text_all_w_t_and_m_t":"sl-FreqResourcePSCCH","paragraph_zero_based":46907},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a resource pool where it is not greater than the number PRBs of the subchannel.","paragraph_zero_based":46908},{"literal_text_all_w_t_and_m_t":"sl-DMRS-ScrambleID","paragraph_zero_based":46909},{"literal_text_all_w_t_and_m_t":"Indicates the initialization value for PSCCH DMRS scrambling.","paragraph_zero_based":46910},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBits","paragraph_zero_based":46911},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in first stage SCI.","paragraph_zero_based":46912},{"literal_text_all_w_t_and_m_t":"sl-TimeResourcePSCCH","paragraph_zero_based":46913},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols of PSCCH in a resource pool.","paragraph_zero_based":46914},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46915},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-Config field descriptions","paragraph_zero_based":46916},{"literal_text_all_w_t_and_m_t":"sl-BetaOffsets2ndSCI","paragraph_zero_based":46917},{"literal_text_all_w_t_and_m_t":"Indicates candidates of beta-offset values to determine the number of coded modulation symbols for second stage SCI. The value indicates the index of Table 9.3-2 of TS 38.213 [13].","paragraph_zero_based":46918},{"literal_text_all_w_t_and_m_t":"sl-PSSCH-DMRS-TimePatternList","paragraph_zero_based":46919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d7ca9cf4000393923c874e388a9357fd149d2d8f9fe8670e030c28fbbb4b19e7","172dac2f69a3347139f298d955d0d42678c92e1c59fcabdd56e3f6dad6367af6","cae2e8428cefba0edb367c5d0e2160f369c336b91b703bd7fd739691a5691e38","e4997919e3b6a637f0cb16e9934c79e36b56b76eac0c3579d48ebe957b0d4957","908f2ed822745e114227bd03ed4303c61551db899f2eadf2b9d63b7dda23ae73","ccdbd02df3e3751f64f063077ba7836db83c982b7c0c45232ae0e6a59af34dbb","6863bb17813db0e6be373956f86b0b8b953d3af559b1ead32cb3d6da5bf0c194","6ca8f378b6c1d9f84663169a6c00bc36f9916528154e9d04ce524845f0615819","44349fb48869040cb6513546da48a8c014c16fe9903ccaa33efd77cb352d340f","f11584875408614cb9edb27b63dee9b9d72ee7cc52f9c4118bc5427870750a9c","e6dafd61cf7725dace82fa712d784f8e86d7927517c585e202d1488d05a8868e","a09e1deef971a979eb850beafadbe8ae5263d6bca24cc180aab041103442b37e","89f1ed6b52eec64b9d6d28563cb7cd7a216addb307451425a2f6b6c834f39bfd","91279019e59696beecce19d9b778ac3c1973a34ccedb50427d05f334c28cf6dc","393343df641f1b3b276a387cafd4da61f3cc799d3054afbd73e8a046a3777c83","7aaf16ec1ef25b6c086b92ff0cf3cc4833b337d54d6b84828c3892a96db7aeea","0888902a7b846145061ab4c34677c5e9b0761a304cb654e9536536d4a4d45bb7","c7ab9d60afadc5b443bbdc70a02aed9cfa99aab70efb7346746d9ea3ea5c6fbd","49cb742c8b00dd0c9a3d146df5ba68060dee1ea1b277daac19bf21fda56de2cf","9fd69bb3223acd8ba02fcf62ecd1a701618c0aad83cdf30513f51de687c13efa","bf800934b6d06c4e6c4d76b1e13d4602531d85f13f338eaf80bff6e3e44053f9","75e1962fce80a8a3c89f34ff18204cd480d62364cc7dbce69bbf5b1e7a8ee4f9","7e727ca954de0a42ae43447bc78e7f1dfc8964472547f5a8f06312fa09eec2a7","5961e1ffccbd569cc3c1b33cd1c0a1942fec582b113551077316ccab4757f045"],"paragraph_range_zero_based":[46896,46919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46896"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the set of PSSCH DMRS time domain patterns in terms of PSSCH DMRS symbols in a slot that can be used in the resource pool.","paragraph_zero_based":46920},{"literal_text_all_w_t_and_m_t":"sl-Scaling","paragraph_zero_based":46921},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to the second stage SCI on PSSCH. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on.","paragraph_zero_based":46922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46923},{"literal_text_all_w_t_and_m_t":"SL-PSFCH-Config field descriptions","paragraph_zero_based":46924},{"literal_text_all_w_t_and_m_t":"sl-MinTimeGapPSFCH","paragraph_zero_based":46925},{"literal_text_all_w_t_and_m_t":"The minimum time gap between PSFCH and the associated PSSCH in the unit of slots.","paragraph_zero_based":46926},{"literal_text_all_w_t_and_m_t":"sl-NumMuxCS-Pair","paragraph_zero_based":46927},{"literal_text_all_w_t_and_m_t":"Indicates the number of cyclic shift pairs used for a PSFCH transmission that can be multiplexed in a PRB.","paragraph_zero_based":46928},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-CandidateResourceType","paragraph_zero_based":46929},{"literal_text_all_w_t_and_m_t":"Indicates the number of PSFCH resources available for multiplexing HARQ-ACK information in a PSFCH transmission (see TS 38.213 [13], clause 16.3).","paragraph_zero_based":46930},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-HopID","paragraph_zero_based":46931},{"literal_text_all_w_t_and_m_t":"Scrambling ID for sequence hopping of the PSFCH used in the resource pool.","paragraph_zero_based":46932},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Period","paragraph_zero_based":46933},{"literal_text_all_w_t_and_m_t":"Indicates the period of PSFCH resource in the unit of slots within this resource pool. If set to sl0, no resource for PSFCH, and HARQ feedback for all transmissions in the resource pool is disabled.","paragraph_zero_based":46934},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-RB-Set","paragraph_zero_based":46935},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for PSFCH transmission and reception. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on. Value 0 in the bitmap indicates that the corresponding PRB is not used for PSFCH transmission and reception while value 1 indicates that the corresponding PRB is used for PSFCH transmission and reception (see TS 38.213 [13]).","paragraph_zero_based":46936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46937},{"literal_text_all_w_t_and_m_t":"SL-PTRS-Config field descriptions","paragraph_zero_based":46938},{"literal_text_all_w_t_and_m_t":"sl-PTRS-FreqDensity","paragraph_zero_based":46939},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of SL PT-RS  as a function of scheduled BW. If the field is not configured, the UE uses K_PT-RS = 2","paragraph_zero_based":46940},{"literal_text_all_w_t_and_m_t":"sl-PTRS-TimeDensity","paragraph_zero_based":46941},{"literal_text_all_w_t_and_m_t":"Presence and time density of SL PT-RS  as a function of MCS. If the field is not configured, the UE uses L_PT-RS = 1","paragraph_zero_based":46942},{"literal_text_all_w_t_and_m_t":"sl-PTRS-RE-Offset","paragraph_zero_based":46943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7d696f7b82783824adcfad568a0eee699687e696e4621c00c6a147d7c8abbf12","de9ab1b9700a48c76c395f3585b4b19519fadd25977b668130f86b10a45ed143","4f6384b0ddcb539df8416cb29b59729e78e6f4480543cc49cac717bb2b699090","0c9026776ea6fe587a2af082a20c2e5970f51d57923f9e3ed165503ae1302ead","6c72ecd9347179fb7dabe3a896476ff855979cfc6f454f2b85f4aa326703a485","3f0df235ca4873d43b0ba725d58999e3eafc7d279c3042b85e869b6bdb980f30","c406e9ed9c4d4bf6db3ec970534761e714e5d06b8b2e820d7f2064a2218313db","714afaca9fae65e3873022eb52c366d4d20e6af840d4b3a4401883fc9483a7ce","7923402e3024d076be37a0a08335cf24811d000497cf6c08b17454bc38f85278","c2eee436c3a61cda99c024b3ce947f75439fa56a9d2fb442d4454196daf41885","463f935c1b9905a9c5a1a8be5f7089ebe1496127d867e491643bd1a1a5fe28b8","d0b3c7587f061f77889f7d213530a866afa6caec1e2a46df9628564d5e7e38e1","db7ebe28957a20f10c6ca32fee8c1f3f58717f5af7635a5d163697ee9452e782","1ddc9231e5b2220818a90f6a0060d76d25bcec469ef3b07ef5070c845474516e","d81f65f047d2e85587f3f1ac44ac27b007b2be7ae09416a654d782981a58198f","9c4a43a051f86365664155d05ffddcc90beb1a898f12208ae7ddda05037f5ed6","ed1792d5e901ab329573df04070a0fc2bb5531829df057573e8e5c1c3255fec6","aec2a200883c980a51fbb41baffa879513ffc078d28c8b9b31b8f732a0dfa2bd","8dec972e2a273a41de622c9f8160a34bc9a03b1175cb48ee934f02f588dc6907","11023e734ecab43b43c2562d1f14e8e94d4ab5899d9d7fc47f1bafb9edad0bf7","e71372d9df0b70f1152c28dc665cb66ef68f49aeeab72dd45c6cb68a63d649a2","beee0a37d1c60613a70160a8e1b060a406df3ac03b6689ed7dfe1b22c9e6e348","da878d1e074e41601eaad3b0708d78abbb2652a9b0157a96fa6e96ba645bac05","4a6967abc04a3cc4d7c0876ef732b8e9152e9b07130c8d8b73e91d2a072da3d1"],"paragraph_range_zero_based":[46920,46943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46920"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for SL PT-RS . If the field is not configured, the UE applies the value offset00 (see TS 38.211 [16], clause 8.4.1.2.2).","paragraph_zero_based":46944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46945},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfigRP field descriptions","paragraph_zero_based":46946},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigList","paragraph_zero_based":46947},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between PSSCH transmission parameter (such as MCS, PRB number, retransmission number, CR limit) sets by using the indexes of the configurations in sl-CBR-PSSCH-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-RangeConfigList, and priority ranges. It also indicates the default PSSCH transmission parameters to be used when CBR measurement results are not available, and MCS range for the MCS tables used in the resource pool. The field sl-CBR-PriorityTxConfigList-v1650 is present only when sl-CBR-PriorityTxConfigList-r16 is configured.","paragraph_zero_based":46948},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserve","paragraph_zero_based":46949},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of reserved PSCCH/PSSCH resources that can be indicated by an SCI.","paragraph_zero_based":46950},{"literal_text_all_w_t_and_m_t":"sl-MultiReserveResource","paragraph_zero_based":46951},{"literal_text_all_w_t_and_m_t":"Indicates if it is allowed to reserve a sidelink resource for an initial transmission of a TB by an SCI associated with a different TB, based on sensing and resource selection procedure.","paragraph_zero_based":46952},{"literal_text_all_w_t_and_m_t":"sl-NRPSFCH-EUTRA-ThresRSRP-List","paragraph_zero_based":46953},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds from which a threshold should be selected based on the priority in the decoded EUTRA SCI and the priority in the NR SCI to be transmitted. A NR SL resource is excluded if the corresponding PSFCH transmission occasions overlap with resources indicated or reserved by the decoded EUTRA SCI in time domain and EUTRA PSSCH RSRP in the associated data resource is above the threshold. If the field is present, the UE shall perform the dynamic co-channel coexistence of LTE sidelink and NR sidelink as specified in TS 38.214; otherwise it shall not perform it.","paragraph_zero_based":46954},{"literal_text_all_w_t_and_m_t":"Sl-NRPSSCH-EUTRA-ThresRSRP-List","paragraph_zero_based":46955},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and a threshold should be selected based on the priority in the decoded EUTRA SCI and the priority in the NR SCI to be transmitted. A NR SL resource is excluded if it is indicated or reserved by the decoded EUTRA SCI and EUTRA PSSCH RSRP in the associated data resource is above the threshold.","paragraph_zero_based":46956},{"literal_text_all_w_t_and_m_t":"sl-ResourceReservePeriodList","paragraph_zero_based":46957},{"literal_text_all_w_t_and_m_t":"Set of possible resource reservation period allowed in the resource pool in the unit of ms. Up to 16 values can be configured per resource pool. The value ms0 is always configured.","paragraph_zero_based":46958},{"literal_text_all_w_t_and_m_t":"sl-RS-ForSensing","paragraph_zero_based":46959},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS of PSCCH or PSSCH is used for L1 RSRP measurement in the sensing operation.","paragraph_zero_based":46960},{"literal_text_all_w_t_and_m_t":"sl-SensingWindow","paragraph_zero_based":46961},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the start of the sensing window.","paragraph_zero_based":46962},{"literal_text_all_w_t_and_m_t":"sl-SelectionWindowList","paragraph_zero_based":46963},{"literal_text_all_w_t_and_m_t":"Parameter that determines the end of the selection window in the resource selection for a TB with respect to priority indicated in SCI. Value n1 corresponds to 1*2µ, value n5 corresponds to 5*2µ, and so on, where µ = 0,1,2,3 refers to SCS 15,30,60,120 kHz respectively.","paragraph_zero_based":46964},{"literal_text_all_w_t_and_m_t":"sl-Thres-RSRP-List","paragraph_zero_based":46965},{"literal_text_all_w_t_and_m_t":"Indicates a list of 64 thresholds, and the threshold should be selected based on the priority in the decoded SCI and the priority in the SCI to be transmitted. A resource is excluded if it is indicated or reserved by a decoded SCI and PSSCH/PSCCH RSRP in the associated data resource is above a threshold.","paragraph_zero_based":46966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["38ca9fbe32c8740adf88ee815e0e032bbdcf6f39d9e6ffccfb8c3f3585d908c3","b6c91831e2a845a49d89da41c580f296df8d61b8518bb41af9bd9f141eba63cc","884dcaca8b4104962985878c7feacf2e99b79f4bb955f4743dcac9e7ab183926","d7b9142f6dd3fc7b182117e78db788b8d4c819dbed1fec2bb8f76b69ba717c9c","976dc864003cdcba288370796e5454644ef78e259fa95b881e86a24cd3703319","017ca228a8133fd606fe551393b1e24a62f67acb920aac8903b8116795dd37b2","b3c0b3cfbf424d4b2bfed0881c33acb795479e195351397de536c08c06fac254","0818622e6c509d17cf0d37fae4396183913087fbced02e407b96981fedd54428","05c07aa877d6edf1849c93bad4920cc21334032ae4d48579def6364de4f8d36b","cbddbc8bbb0f3c45764e299b17c57c437e6897be8716c63d261477155684d57a","eb2f276e5bc661f266f84adb066d2c5a33350a27d3914fd7f23cad1ebfcd75b0","a0337010e997dbcfb7a4c092af4ea89d516a15697de3272719535784c4c4604d","af54d1ff0dadb8ba75192bd3f7674a895a1e503a7960b8310a5623299ebc39f2","ae2c9a613aebbec92d5cbf3c1ab716dbc660e43cd87095786b483f3b6c84257b","1e195975e5855eed883e65b81edb4dd37766ed491592c68c249198ccd219bcd0","8c18660f75882c4b72af8f123f923834a915628db8809c8f0b2e487421f8b227","201fd2b3713e2d8072205e7ed6fd10e5b8ec6a7509838e4b66a67137acab86d7","0db853e454c22494b036822b75288b797e9dc22e7ff6765cd93a2c11b9ddca38","5116868d8ce936c5b77bc4450f365ff66cabf91830574af7f149cc0c39a96e7b","8ee631e57eae03c4c01f351672198a8f0ffc9bbca961b9767d89442b0c77d451","b6ed1ff3f04ae902d05e17b18cb9764f9d6b82fe0574b661baeb1f907a27ac66","1c46aeefe1688abb59fc6533c7997113a17d8ff193cbecc8f15f8e8262b8392e","540a7b798d11873ad50aa0520e68a9ee84f145049e7f42cbc279ab48ff9b52de","fb9d236f36060f3be67a05f54c4b67bfe5e5437c9d27822f647701eb04f936c7"],"paragraph_range_zero_based":[46944,46967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46944"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-PowerControl field descriptions","paragraph_zero_based":46968},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPower","paragraph_zero_based":46969},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the UE's sidelink transmission power on this resource pool when the sidelink transmission is performed only on this resource pool. The unit is dBm. If the sidelink transmission is PSFCH, and multiple resource pools are used, the maximum transmission power for PSFCH is configured as sum of fields sl-maxTransPower over multiple resource pools, as specified in TS 38.101-1 [15].","paragraph_zero_based":46970},{"literal_text_all_w_t_and_m_t":"sl-Alpha-PSSCH-PSCCH","paragraph_zero_based":46971},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for sidelink pathloss based power control for PSCCH/PSSCH when sl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":46972},{"literal_text_all_w_t_and_m_t":"sl-P0-PSSCH-PSCCH","paragraph_zero_based":46973},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for sidelink pathloss based power control for PSCCH/PSSCH. If not configured, sidelink pathloss based power control is disabled for PSCCH/PSSCH. When sl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores sl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":46974},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSSCH-PSCCH","paragraph_zero_based":46975},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1. ","paragraph_zero_based":46976},{"literal_text_all_w_t_and_m_t":"dl-P0-PSSCH-PSCCH","paragraph_zero_based":46977},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSCCH/PSSCH. If not configured, downlink pathloss based power control is disabled for PSCCH/PSSCH. When dl-P0-PSSCH-PSCCH-r17 is configured, the UE ignores dl-P0-PSSCH-PSCCH-r16.","paragraph_zero_based":46978},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured.","paragraph_zero_based":46979},{"literal_text_all_w_t_and_m_t":"dl-Alpha-PSFCH","paragraph_zero_based":46980},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSFCH when dl-P0-PSFCH is configured. When the field is absent the UE applies the value 1. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":46981},{"literal_text_all_w_t_and_m_t":"dl-P0-PSFCH","paragraph_zero_based":46982},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for downlink pathloss based power control for PSFCH. If not configured, downlink pathloss based power control is disabled for PSFCH. When dl-P0-PSFCH-r17 is configured, the UE ignores dl-P0-PSFCH-r16. For resource pools configured with PSFCH resources overlapping in time, this field is either not configured in any of the resource pools or configured with the same value for all the resource pools.","paragraph_zero_based":46983},{"literal_text_all_w_t_and_m_t":"A Remote UE which is out of coverage, considers downlink pathloss based power control is disabled for PSFCH when dl-P0-PSFCH is configured.","paragraph_zero_based":46984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46985},{"literal_text_all_w_t_and_m_t":"SL-MinMaxMCS-Config field descriptions","paragraph_zero_based":46986},{"literal_text_all_w_t_and_m_t":"sl-MaxMCS-PSSCH","paragraph_zero_based":46987},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":46988},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH","paragraph_zero_based":46989},{"literal_text_all_w_t_and_m_t":"Indicates the minimum MCS value when using the associated MCS table. If no MCS is configured, UE autonomously selects MCS from the full range of values.","paragraph_zero_based":46990},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cba1a6c5cb4dd851c0961dc5ac22883c4582c91517ca3fee94b8bdc60e82f9bd","bc6a3b850dc26ea7e9e3cbeb0fe9f3f9e3b05b80847631d4ffe8c814ee0ff4d0","44f0ff1c19f1b2bff6821baddde806d75a945236c371169744da448bd876da9b","f4740db518ce46844a368cbab9d6b695711d16d91647d17c70b2913d723056cf","11aba925b2ac1c2fc10434da8cbaf39ab6f5580334938dd4eda5e3d63cca205a","93bfc9f5fd98f58e13899237f68408a7a6749d5cccef553c9ecb4b3d69526570","2a94c72767b00da50ccae04f8f94d43ded60b12eccb0104c4a2667e244c88225","cb664ae6fa0c1cf425a6ac21c8536b46361db6f125c4be47579f657fb399ff33","c5951973407c5f65d2e945480eaa77a6f8eefdbea7563a1b9afcbfd9d39079ba","6eae43796f0892fc893fda92272d3e5035d4411b1884fae515a092a80762d21b","25f26ecffdbde037462d3a8f523869ee505aee2f80dbc3e2fdeac0a0b08aaf4d","4fef17b686426a99878c4fbc3826393e48fa615b60e42159a742f47d5ae805a8","ebbabbf91cf8b2efc3d41f09361dd8b179758c889545b106ddc9f9242c04544d","a53813c6850e7fa75ee8eaf76ea2e7aef4542e44a317f29ac6ddc04c17e2cf93","b22c3a5057ca3e20e1efcffc6af1ea0b48cbc4a5757a73ede3e97d432337ff1d","334956052d49414dfe2b5872e53302564524ed2cdfc213a86b3d9971a4e25d53","99d9a2ddc4bbd6c9f8cc8448f624fea0161a71706bc6db599af893f0842a3883","ea654b80385085f322f05aee01d191012d6594c84abe844c5e4ef8ac30601f2c","1d1b68fb0eb77f5b3893333fe574e06d0208c5b88b0db4833a2d6d75e7d59333","f426d9348cd223c149bdd851aef0ebe0ceb1078705913a0d661e04ee8e9c1323","8225d4b42eecd7926fff9613901cc1e3f109c93409a2235dcddbf6f98be93834","5e9b1cb377809ce29f63d240e96c55616b25466b0ca37a7a9d66261f49872643","524bd1fc51bf3fbada36f0dcc2fb3646261701ff5869b358bfa5ffbcfc356437","002e4deb5dc9904ed78d0ea98d0ccf7ab04f73ad74255e8b5f601632cad5d744"],"paragraph_range_zero_based":[46968,46991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46968"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CPE-StartingPositionsPSCCH-PSSCH field descriptions","paragraph_zero_based":46992},{"literal_text_all_w_t_and_m_t":"sl-Priority","paragraph_zero_based":46993},{"literal_text_all_w_t_and_m_t":"Indicates L1 priority of PSSCH.","paragraph_zero_based":46994},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositions","paragraph_zero_based":46995},{"literal_text_all_w_t_and_m_t":"Indicates a set of candidate CPE starting positions specified in Table 5.3.1-3 [16, TS38.211],","paragraph_zero_based":46996},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46997},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfig","paragraph_zero_based":46998},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfig specifies the SL RLC bearer configuration information for NR sidelink communication.","paragraph_zero_based":46999},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig information element","paragraph_zero_based":47000},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47001},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-START","paragraph_zero_based":47002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47003},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":47004},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-r16                  SL-RLC-BearerConfigIndex-r16,","paragraph_zero_based":47005},{"literal_text_all_w_t_and_m_t":"    sl-ServedRadioBearer-r16                      SLRB-Uu-ConfigIndex-r16                          OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":47006},{"literal_text_all_w_t_and_m_t":"    sl-RLC-Config-r16                             SL-RLC-Config-r16                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":47007},{"literal_text_all_w_t_and_m_t":"    sl-MAC-LogicalChannelConfig-r16               SL-LogicalChannelConfig-r16                      OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":47008},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":47009},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":47010},{"literal_text_all_w_t_and_m_t":"    sl-RLC-BearerConfigIndex-v1800                SL-RLC-BearerConfigIndex-v1800                   OPTIONAL    -- Need S","paragraph_zero_based":47011},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":47012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47014},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIG-STOP","paragraph_zero_based":47015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7d5d25afa9b3b24e2cb2517d9ec13a49b2d2366ac381cf4b2ea719a4738567f5","8d1e93c27b34c65459a9aef381e412040679457c2e4650bd21ff3e2a3e99e768","f25118d5a347f53bd3059cc3b4bc21cc0eb240bda32749c4307d949e72485293","ca4be340ebc74d68e3d95311ec8ced0e98cc4c1e205ab1259330cdd6c072737b","4064cefa5e2e7a6e714256c9f49898552792ecb20f508534c1e7935db43d6307","56db832f7f3cffe05d060bc8eaf0492931d1ae5db84f52043313490e8dca9e74","0337eacff034fbe5d12b611cb4953a36073aa793163373c621097095e9c4bbd0","03acc7511dc69e87dc6b6543ccba0f83dab5c60f52468027b60d77902efd8970","03a7bc06f4cde63ba69b02e6bd3a26a51cf0e6d01278abdd1b6c122b575274d0","81a50fd6731537eab044a07b379627c89d245e0a8e282a5882395ea9f0dc9a26","37112d07d1a98847033a11b6474741e3a1f4cd4abffa8f59f0d594e2e7c80fc1","c63dba3d812ea6562c8c8bbde9780a81af721a622519577c592804616fa5b973","a952fbed9b87d9f7e5323eecf9375e5bc811fa5c77a1620d8226cf9dea83589f","8203f40dfe704c88c34ffbff09276b790817177440f5179f5e99e536d3a5f713","d0f530f378beb0c4cad3a0526c2fd22b67b74903a49c5fcc87972b711d9e5ffe","88910a5c8ee1d3334ae1b0aa0c3e733e66b3cbcb717a0436393df6935a863f1a","5f38213967ecdbccbfe4074a8a257f42401c2bfc1378b03ae617fa76a1767fb3","e5d16b795f47340d9df517a09f036c5c6de3bbde9334165fd7bb60d1a6c82d2c","61cc939a743b42472a5d31b16ed0f20e35baf53e77a16ccd94cabdf6429640bb","387c9e7ef7fc579bb38a7679e666b500c709416621aad3262d284a8faa4148d7","c78911ca3982c5fdb615aca1d2476b9a4398c32fa6334f636d31454a02ba23db","aaf514ed5e9d35dc39f9c8a54d7c8c37cecdcaf7e73a17b1184d687794b7ee87","1e125e91be253c12718735f9eb12844c6abc7e5d71684e79aefbd96620f0005d","34671bc9283466a41cda69ad0e6095be49d7920dbe52b720de304c91d8ed4ee8"],"paragraph_range_zero_based":[46992,47015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46992"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47017},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfig field descriptions","paragraph_zero_based":47018},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":47019},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":47020},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigIndex","paragraph_zero_based":47021},{"literal_text_all_w_t_and_m_t":"The index of the RLC bearer configuration. If the field sl-RLC-BearerConfigIndex-v1800 is present, the UE shall ignore the sl-RLC-BearerConfigIndex-r16 field.","paragraph_zero_based":47022},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":47023},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":47024},{"literal_text_all_w_t_and_m_t":"sl-ServedRadioBearer","paragraph_zero_based":47025},{"literal_text_all_w_t_and_m_t":"Associates the sidelink RLC Bearer with a sidelink DRB. It indicates the index of SL radio bearer configuration, which is corresponding to the RLC bearer configuration.","paragraph_zero_based":47026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47027},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47028},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47029},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":47030},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, Need M.","paragraph_zero_based":47031},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":47032},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new sidelink logical channel via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration. Otherwise, it is absent, Need M.","paragraph_zero_based":47033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47034},{"literal_text_all_w_t_and_m_t":"–SL-RLC-BearerConfigIndex","paragraph_zero_based":47035},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-BearerConfigIndex is used to identify a SL RLC bearer configuration.","paragraph_zero_based":47036},{"literal_text_all_w_t_and_m_t":"SL-RLC-BearerConfigIndex information element","paragraph_zero_based":47037},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47038},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-BEARERCONFIGINDEX-START","paragraph_zero_based":47039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5b3228341b10ccb3502fb34fe0d340606bec040d7f135a93e2fae2938817e1c3","43d6817a777be3c4d52536ad14f68ca9335ce78cc92e79873c4ae773233eba47","52e57d551e61c88782c582c85f4f0081921b580dd0ea6977b934a515c95f4f14","fac8e9f6944d018fc1ba3b26429bbc2dff98f5ae796431ca01e1caf2bde02c69","2c437f1927a055e5e453253fb5001fd40b4dc4875bcc8bf6f4375ff552c87fc3","0c584e5f3b588b5c4b3eeacd07fbcf1fd1d2b980f69e0925f34f6a075435a371","56193444b722153b02a69e4c7a9e2012e916ced0ea7b50fb5b5ff938557a49b3","e8bd11c096bb93e69f43c12597e23ebed5b6728d3f2cf53d70a2e1106760a000","72c2845b3150b85fb61ece33d1bfcd94fd83b80d0f786c991de2bbd8ce2d41d9","b4eefd599