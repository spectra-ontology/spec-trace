a4a00be740e475709bf7b90d71","a7df8a1878af604a9a11156bedbf80ad8146aa52630c3e17745d0091f8dc7a33","5326fd66a40f1449261b8ade52aaeb781eff0189f050d0d9accdad664d3f906e","5fbc992d7411d8bd5cdf06d53a1e90f411ae1ed11b25592fd3fd01b929c6d5d4","4d0d4548cd8f26c34d9c66ddf22d6ca684cae1639b82e5e74865eda2b5fdc26e","52c3307329d6b7fdd6282f46e477cdfdd45d9db734fec580980017353e2e708e","1e4b04862eefeae4e51d42e816b4e7da528d05688b5b026765c165a228b5f460","64a2fb349e68fea501392159e95534ffeda734ab1f9d40d34ba1853a741e6951","f6d63a6d064d21fe8186ee2245fa05d3b81d4455405d5587487d1f45e24e5e5e","34321e29e1f6c3567d5fc6a8bdd82bf5348c0e8e003afd615933b2016bd73500"],"paragraph_range_zero_based":[35712,35735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35712"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-ACTIVATEDCONFIG-STOP","paragraph_zero_based":35736},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35737},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35738},{"literal_text_all_w_t_and_m_t":"TCI-ActivatedConfig field descriptions","paragraph_zero_based":35739},{"literal_text_all_w_t_and_m_t":"pdcch-TCI","paragraph_zero_based":35740},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state for PDCCH for each configured CORESET of the DL BWP to be activated at SCell activation, to be activated for the PSCell at SCG activation and/or to be used for BFD, RLM and measurements while the SCG is deactivated. The list includes exactly as many entries as CORESETs configured in this BWP, ordered by increasing values of ControlResourceSet-Id, i.e. the first entry indicates the TCI state for the configured CORESET with the lowest ControlResourceset-Id value, the second value indicates the TCI states for the configured CORESET with the second lowest ControlResourceset-Id value, and so on.","paragraph_zero_based":35741},{"literal_text_all_w_t_and_m_t":"pdsch-TCI","paragraph_zero_based":35742},{"literal_text_all_w_t_and_m_t":"Indicates TCI states for PDSCH reception at SCell addition/activation or of the PSCell at SCG activation. This field indicates activated TCI state(s) for this BWP ordered by increasing values of TCI-StateId, i.e. the first bit indicates the activation state of the TCI state with the lowest TCI-StateId value, the second value indicates the activation status of the TCI state with the second lowest TCI-State-Id value, and so on. A bit set to 0 indicates that the corresponding TCI state is deactivated, a bit set to 1 indicates that the TCI state is activated.","paragraph_zero_based":35743},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35744},{"literal_text_all_w_t_and_m_t":"–TCI-State","paragraph_zero_based":35745},{"literal_text_all_w_t_and_m_t":"The IE TCI-State associates one or two DL reference signals with a corresponding quasi-colocation (QCL) type.","paragraph_zero_based":35746},{"literal_text_all_w_t_and_m_t":"TCI-State information element","paragraph_zero_based":35747},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35748},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-START","paragraph_zero_based":35749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35750},{"literal_text_all_w_t_and_m_t":"TCI-State ::=                       SEQUENCE {","paragraph_zero_based":35751},{"literal_text_all_w_t_and_m_t":"    tci-StateId                         TCI-StateId,","paragraph_zero_based":35752},{"literal_text_all_w_t_and_m_t":"    qcl-Type1                           QCL-Info,","paragraph_zero_based":35753},{"literal_text_all_w_t_and_m_t":"    qcl-Type2                           QCL-Info                                                    OPTIONAL,   -- Need R","paragraph_zero_based":35754},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35755},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35756},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                      OPTIONAL,   -- Need R","paragraph_zero_based":35757},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17          PathlossReferenceRS-Id-r17                                  OPTIONAL,   -- Cond JointTCI1","paragraph_zero_based":35758},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                 Uplink-powerControlId-r17                                   OPTIONAL    -- Cond JointTCI","paragraph_zero_based":35759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["53f7da0f776b2e7f1c305c01c0894859a549ef282e3ec17cfb66bb7d0d712d32","7933a533af2e3e3b672c6f04657ac49ee4530b2e4dc0211778290feb8722f1c7","1581495ca79a98bd94d26a80403a71d135c54137f92dd065680818114415adf2","51807ad15e53aa220fd7083935b508dd29d197c8549a69fef184ccaa7ff2a9fb","45db29965677f7c7a4baa9053f56af2abe8d835921017f016bb43ef5570d91d6","2d7da7e643409c6af1d7cb66d4d8398a36454b88a9899f5ae3895e140fad17f7","9a4418bda629f70253ecac9610694ff9d0436f46bfb540c595fc59d94de207ed","946c5cfc99c91cd9956ae25a66a563f47eafc8d09776bf1be6e6a41221032bc0","5dd5256652388e6561fdc0089b0c977dd52cb35c7d42051485d3f6cec2a77cc6","cb49364b17dfccae8d86da26fa0302b0165f04c73522d8d4e9d796b8977aebd6","5c50a0a9e9432128ebefba066419730441e96c45133ed2d1004f157a88003716","005fb8ba30f5ac6d8686576999a3aada25054f9b2377645fdb0290ae69fb5bff","a8c79c21657bee0f73d56b0d6c82194529452f16114d88210976706b014df47d","aa06eb5620f8a72de56d6d8026f5c06a3b649e552b3062da1c682cb265da39d5","3bd2bec984ab78a2cdf81586cbd5b42702794c660b6c7bd12c17624b53a70fd0","3fd2e0231dbaf0b45c7dc855c7a8c8ca5981bb4a4dca1673176013302e52b43b","743a0d60611bcd8980491d3258637c289f4817097ba7cd76a9f412a444c5a35d","b9cacdd6411b501065aa5724f027602575bdbf330d8f25fde72cde487850bbd5","110eef80b410ffb3a2e630604d12a0c4a6fe4e8478c0603dba213637a4288fdd","d2f4f8cef500c3d4e7268fd18a079e5af33cb9faeef94f27745c29a34444f8cc","a495df06717519fe9986076cb87022f8cd3b45f4924cec262cb3b1b515d6cfa4","b9e6fef7b8cae490070879d4753d52de6f32db13ac8f7b5792d585b97e354e58","efafd9c3802ba580d6214b0c71729dcd8bcfdd9e8820dc2cd07af838a455cca4","9ae620ace8c4bc76880be3ce2c4893dfb519c6911cb45e7412fd1f2abb54afa0"],"paragraph_range_zero_based":[35736,35759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"so