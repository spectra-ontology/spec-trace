{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27744},{"literal_text_all_w_t_and_m_t":"DiscardTimerExt2-r17 ::= ENUMERATED {ms2000, spare3, spare2, spare1}","paragraph_zero_based":27745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27746},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression-r17 ::= CHOICE {","paragraph_zero_based":27747},{"literal_text_all_w_t_and_m_t":"    newSetup                      SEQUENCE {","paragraph_zero_based":27748},{"literal_text_all_w_t_and_m_t":"        bufferSize-r17                ENUMERATED {kbyte2, kbyte4, kbyte8, spare1},","paragraph_zero_based":27749},{"literal_text_all_w_t_and_m_t":"        dictionary-r17                ENUMERATED {sip-SDP, operator}                            OPTIONAL    -- Need N","paragraph_zero_based":27750},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":27751},{"literal_text_all_w_t_and_m_t":"    drb-ContinueUDC           NULL","paragraph_zero_based":27752},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27754},{"literal_text_all_w_t_and_m_t":"DiscardTimerForLowImportance-r18 ::= ENUMERATED {ms0, ms2, ms4, ms6, ms8, ms10, ms12, ms14, ms18, ms22, ms26, ms30, ms40, ms50, ms75, ms100}","paragraph_zero_based":27755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27756},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-STOP","paragraph_zero_based":27757},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27759},{"literal_text_all_w_t_and_m_t":"PDCP-Config field descriptions","paragraph_zero_based":27760},{"literal_text_all_w_t_and_m_t":"cipheringDisabled","paragraph_zero_based":27761},{"literal_text_all_w_t_and_m_t":"If included, ciphering is disabled for this DRB regardless of which ciphering algorithm is configured for the SRB/DRBs. The field may only be included if the UE is connected to 5GC. Otherwise the field is absent. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":27762},{"literal_text_all_w_t_and_m_t":"discardTimer","paragraph_zero_based":27763},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms and so on. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":27764},{"literal_text_all_w_t_and_m_t":"discardTimerExt","paragraph_zero_based":27765},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms0dot5 corresponds to 0.5 ms, value ms1 corresponds to 1ms and so on. If this field is present, the field discardTimer is ignored and discardTimerExt is used instead.","paragraph_zero_based":27766},{"literal_text_all_w_t_and_m_t":"discardTimerExt2","paragraph_zero_based":27767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["44e8d3f3c1ecd2eee3d8d197c44811745b8cd6798674d997983de85bba3173fc","5540fda843d1fe9d57462b4b18d5ff3cda2ba15b58feca299fe8f712c8387070","6f44ad4f915fbc7207257068cf8b2ce0833138d957c53e189cc8237875639f2a","868008975f445f8f4c4054983b93fdf6201e4312f7448b2489b7e9ea81ac1769","978fd1fcefe162f62ede1efb16d567749501fe3d2f8a2d19e2283f5b6d75338b","5959d30e4dfea0b24ad923ea987a395b4fd7f0a3ad7a820dd4baee59bbe439b4","f8a5b9b133636bcc80be0f0bad1e5a235e95b74fe150d5fb35101a54575b0480","fc81a9834e8812a5ff6d4edad79829448efe0c859e5349f152acb78bb3e408e4","4ec69fb0075d6649278e88adc2903f3677dc712fda53dd7e1a40ec6f42683300","ab265d5ceaf0a93036a6ab63c6bfa22fbd4d89efeb7241f2882eecd307a37937","ca090eaffad5f3d23407c64c4c62ffe11bf73b2fcd9c54047d823687ef6f04f3","3a937060b62e5e6b4271022680a2cd935fd9c81b8e044f7c64917ac660a078ef","ac73767efa6fa43bb65a9b5cfdc54bbbe78044b641bf4a453748919a536125ae","d08d8d71657e3b8146327f96a011e4d9ec8093184d621eaef474a64591fc94b3","1cfad248f5f07cb8a4134f1e8ba5fa6c9b0de211203d2f0b217d44eaa0845366","f5b08373275d81228f04ffe0105988e074f7adac3c73f51b54db2f89460bfa03","af98ab0887d34d8b9bc3e5bd6a2033a6f553f1788c91d44b16299bd621c3eef9","1eefaac3173437060c44651756df2373cc68ce68703cd150cbd663e6613ddba7","32ad1d7606e18b7f177384f6135cd0544a57839ee74ba03931f4a1e63ba0fd1e","15bcb69d5ab60404746be170da9bc050c32985ee0621acb2ef662d6e370f099b","2e5ca2016ec25a3675943358d0b4ccb7114161c5464dd5848f821c462dc67955","7bae775871e208aa92b36c28ab21bf36233419436ab30de8f884fb38a203873c","e7a3677c1a347a18ba6798d5ec592a1625bb26a9d2698e6007f08d922ddf7d8b","9cefeb72603c2b375236d64a009b932e976ad2bc82b90cb52b9204ea65a8fccd"],"paragraph_range_zero_based":[27744,27767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27744"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimerExt specified in TS 38.323 [5]. Value ms2000 corresponds to 2000 ms. If this field is present, the field discardTimer and discardTimerExt are ignored and discardTimerExt2 is used instead.","paragraph_zero_based":27768},{"literal_text_all_w_t_and_m_t":"discardTimerForLowImportance","paragraph_zero_based":27769},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimerForLowImportance specified in TS 38.323 [5]. Value ms0 corresponds to 0 ms, value ms2 corresponds to 2 ms and so on. The value of this timer for a PDCP entity is always configured shorter than discardTimer, discardTimerExt or discardTimerExt2, whichever is used for the PDCP entity. The presence of this field indicates that PSI-based SDU discard is configured for a DRB. The network configures at most 8 DRBs with discardTimerForLowImportance.","paragraph_zero_based":27770},{"literal_text_all_w_t_and_m_t":"drb-ContinueROHC","paragraph_zero_based":27771},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the ROHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. This field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated. The network does not include the field if the bearer is configured as DAPS bearer. This field can be configured for both DRB and multicast MRB.","paragraph_zero_based":27772},{"literal_text_all_w_t_and_m_t":"duplicationState","paragraph_zero_based":27773},{"literal_text_all_w_t_and_m_t":"This field indicates the uplink PDCP duplication state for the associated RLC entities at the time of receiving this IE. If set to true, the PDCP duplication state is activated for the associated RLC entity. The index for the indication is determined by ascending order of logical channel ID of all RLC entities other than the primary RLC entity indicated by primaryPath in the order of MCG and SCG, as in clause 6.1.3.32 of TS 38.321 [3]. For MP, the index for the indication is determined by ascending order of direct path (where i is ascending order of logical channel ID of secondary RLC entities) and indirect path, as in clause 6.1.3.32 of TS 38.321 [3]. If the number of associated RLC entities other than the primary RLC entity is two or if the associated with one RLC entity and the N3C, UE ignores the value in the largest index of this field. If the field is absent, the PDCP duplication states are deactivated for all associated RLC entities. ","paragraph_zero_based":27774},{"literal_text_all_w_t_and_m_t":"ethernetHeaderCompression","paragraph_zero_based":27775},{"literal_text_all_w_t_and_m_t":"This fields configures Ethernet Header Compression. This field can only be configured for a bi-directional DRB or a bi-directional multicast MRB. The network reconfigures ethernetHeaderCompression only upon reconfiguration involving PDCP re-establishment and with neither drb-ContinueEHC-DL nor drb-ContinueEHC-UL configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":27776},{"literal_text_all_w_t_and_m_t":"headerCompression","paragraph_zero_based":27777},{"literal_text_all_w_t_and_m_t":"If rohc is configured, the UE shall apply the configured ROHC profile(s) in both uplink and downlink. If uplinkOnlyROHC is configured, the UE shall apply the configured ROHC profile(s) in uplink (there is no header compression in downlink). ROHC can be configured for any bearer type. ROHC and EHC can be both configured simultaneously for a DRB or a multicast MRB. The network reconfigures headerCompression only upon reconfiguration involving PDCP re-establishment or involving PDCP entity reconfiguration to configure DAPS bearer(s), and without any drb-ContinueROHC. Network configures headerCompression to notUsed when outOfOrderDelivery is configured. Network only configures this field when uplinkDataCompression is not configured.","paragraph_zero_based":27778},{"literal_text_all_w_t_and_m_t":"initialRX-DELIV","paragraph_zero_based":27779},{"literal_text_all_w_t_and_m_t":"Indicates the initial value of RX_DELIV during PDCP window initialization for multicast MRB as specified in TS 38.323 [5].","paragraph_zero_based":27780},{"literal_text_all_w_t_and_m_t":"integrityProtection","paragraph_zero_based":27781},{"literal_text_all_w_t_and_m_t":"Indicates whether or not integrity protection is configured for this radio bearer. The network configures all DRBs with the same PDU-session ID with same value for this field. The value for this field cannot be changed after the DRB is set up.","paragraph_zero_based":27782},{"literal_text_all_w_t_and_m_t":"maxCID","paragraph_zero_based":27783},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID parameter as specified in TS 38.323 [5].","paragraph_zero_based":27784},{"literal_text_all_w_t_and_m_t":"The total value of MAX_CIDs across all bearers for the UE should be less than or equal to the value of maxNumberROHC-ContextSessions parameter as indicated by the UE.","paragraph_zero_based":27785},{"literal_text_all_w_t_and_m_t":"moreThanOneRLC","paragraph_zero_based":27786},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than one RLC entity is associated with the PDCP entity. This field is not present if the bearer is configured as DAPS bearer.","paragraph_zero_based":27787},{"literal_text_all_w_t_and_m_t":"moreThanTwoRLC-DRB","paragraph_zero_based":27788},{"literal_text_all_w_t_and_m_t":"This field configures UL data transmission when more than two RLC entities are associated with the PDCP entity for DRBs.","paragraph_zero_based":27789},{"literal_text_all_w_t_and_m_t":"outOfOrderDelivery","paragraph_zero_based":27790},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":27791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["65080e5bdb1be3aa3d3edeac876007577eae9b351cd3ef7932f6b85f2b62f8c3","3e67e6ab92853c20bf8413ae934ad43c0d638287fd2ed8f85b9bfe4f4b07abaa","5ad50570f82d2231f1443f96aab283be660acc6245905fb9bc4ab7e0f9005d1c","34ba2b480a7b6c0f84f10a863b6a7c3fffe66f212b91a1986151a8ad82397541","fd221fa54f001168a1ee76a77123d561d6d433d1d2a84ead13e26aad8a48e4b4","239fff575e8f85e91df56b0604c4af8d8426b0d024c0a74289b1d92503c6ff1e","8ec0072bbbeafaa0dc0406a535fb4f830c9ff21bfd3ba4272422fa6a2fb9fd51","4a7ffd6c6f93d999289cfaefc3140571a019b70f2d7df02d86a855e7d07bfa78","983a011a8fa75520fd16128354ecba567510a0da2250e5705427507470248d7c","eb4dde7be16ee6831f164b971a7212228b6b4074673529c0ccad68578cd2ed64","4b3a62400d7f06d9b448a204d02e75954953560dfc6d34a95b0e4c668e1c346d","35df6f062f01990d368b16575a6c6d7aa679c3f9dbb590d901c286ad3cd80ff4","22ed3fc9bce997b4f16bffe6e7abc2515fe84bc7c1ccf60f31a95c75b68e27a6","5193d6e372d5a89aa4482490aa132873bed7d09303b27bd8392f45674d29dbbb","633a6d559a5d3760acb28c1c589a810d019cff98f4624b6a4ee966ee30606e3a","90906079b6be2fe00a8574b8a959010319531c4e2f154b1822ca74393cadc8a8","e6c445991ff0be33ef738beda4b4e857862bc80dc6db7d515d25cfe5ec8bff76","ef4b5c14a593685894cae6873e2078452b2a4e9e604cab9e9e753197c37cada2","50598679745adb72352337ca64c99424926d988231dbdbf7e07473fd2942c07c","af6fbe73e13b67fd4250f293a67cd2f33bb41c4322f365b3554eda3aae09527d","887c0c64b377fd60b1d53c59cfcc0e58b74f483f68b152ebbd98409ced3f9ad2","2aead121cc6b6405c230f6c94909ded2391677a2b12c0760ff2059932a59e0a6","f3d24381014e4919ea4c80cdf4bfbcefa99bb0b211265505891ead2d222add59","e25167c139426946a6c477b24bb36594d582465d8314c93761518bf79162599c"],"paragraph_range_zero_based":[27768,27791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27768"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdcp-Duplication","paragraph_zero_based":27792},{"literal_text_all_w_t_and_m_t":"Indicates whether or not uplink duplication status at the time of receiving this IE is configured and activated as specified in TS 38.323 [5]. The presence of this field indicates that duplication is configured. PDCP duplication is not configured for CA packet duplication of LTE RLC bearer. The value of this field, when the field is present, indicates the state of the duplication at the time of receiving this IE. If set to true, duplication is activated. The value of this field is always true, when configured for a SRB. For PDCP entity with more than two associated RLC entities for UL transmission, this field is always present. If the field moreThanTwoRLC-DRB is present, the value of this field is ignored and the state of the duplication is indicated by duplicationState. For PDCP entity with more than two associated RLC entities, only NR RLC bearer is supported.","paragraph_zero_based":27793},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeDL","paragraph_zero_based":27794},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for downlink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":27795},{"literal_text_all_w_t_and_m_t":"pdcp-SN-SizeUL","paragraph_zero_based":27796},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for uplink, 12 or 18 bits, as specified in TS 38.323 [5]. For SRBs only the value len12bits is applicable. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":27797},{"literal_text_all_w_t_and_m_t":"pdu-SetDiscard","paragraph_zero_based":27798},{"literal_text_all_w_t_and_m_t":"If set to true, the UE shall perform PDU Set based discarding for this PDCP entity, as specified in TS 38.323 [5]. This field is only configured for a DRB.","paragraph_zero_based":27799},{"literal_text_all_w_t_and_m_t":"primaryPath","paragraph_zero_based":27800},{"literal_text_all_w_t_and_m_t":"Indicates the cell group ID and LCID of the primary RLC entity as specified in TS 38.323 [5], clause 5.2.1 for UL data transmission when more than one RLC entity is associated with the PDCP entity. In this version of the specification, only cell group ID corresponding to MCG is supported for SRBs, except for the split SRB2 of the IAB-MT, and except when the UE is required to set the primaryPath to refer to the SCG or indirect path as specified in clause 5.7.3b.4. In this last case, if the network sends an RRCReconfiguration message (in NR-DC) or an EUTRA RRCConnectionReconfiguration message (in (NG)EN-DC) keeping SRB1 as split SRB, the network explicitly configures the primaryPath for the PDCP entity of SRB1 to refer to the MCG. In this version of the specification, only cell group ID corresponding to MCG is supported for DRBs when the SCG is deactivated. In MR-DC, the NW indicates cellGroup for split bearers using logical channels in different cell groups. The NW always indicates logicalChannel if CA based PDCP duplication is configured in the cell group indicated by cellGroup of this field. This field is also used for configuring Multi-path Primary Path defined in [5] for MP operation. In MP, when the primary path is indirect path, the field cellGroup and logicalChannel are absent, and the field primaryPathOnIndirectPath is set to true.","paragraph_zero_based":27801},{"literal_text_all_w_t_and_m_t":"primaryPathOnIndirectPath","paragraph_zero_based":27802},{"literal_text_all_w_t_and_m_t":"Indicates that the primary RLC entity is on SL indirect path, or primary path is associated with the N3C indirect path, for DRB when MP is configured.","paragraph_zero_based":27803},{"literal_text_all_w_t_and_m_t":"splitSecondaryPath","paragraph_zero_based":27804},{"literal_text_all_w_t_and_m_t":"Indicates the LCID of the split secondary RLC entity as specified in TS 38.323 [5] for fallback to split bearer operation when UL data transmission with more than two RLC entities is associated with the PDCP entity. This RLC entity belongs to a cell group that is different from the cell group indicated by cellGroup in the field primaryPath. This RLC entity belongs to the cell group of the direct path if primaryPathOnIndirectPath is set to true in MP case.","paragraph_zero_based":27805},{"literal_text_all_w_t_and_m_t":"statusReportRequired","paragraph_zero_based":27806},{"literal_text_all_w_t_and_m_t":"For AM DRBs, AM MRBs and DAPS UM DRBs, indicates whether the DRB or the multicast MRB is configured to send a PDCP status report in the uplink, as specified in TS 38.323 [5]. For DAPS AM DRBs, it also indicates whether the DRB is configured to send a second PDCP status report in the uplink, as specified in TS 38.323 [5].","paragraph_zero_based":27807},{"literal_text_all_w_t_and_m_t":"survivalTimeStateSupport","paragraph_zero_based":27808},{"literal_text_all_w_t_and_m_t":"Indicates whether the DRB associated with this PDCP entity has survival time state support. If this field is configured to be true, all associated RLC entities are activated for PDCP duplication upon reception of a retransmission grant addressed to CS-RNTI, as specified in TS 38.321 [3].","paragraph_zero_based":27809},{"literal_text_all_w_t_and_m_t":"t-Reordering","paragraph_zero_based":27810},{"literal_text_all_w_t_and_m_t":"Value in ms of t-Reordering specified in TS 38.323 [5]. Value ms0 corresponds to 0 ms, value ms20 corresponds to 20 ms, value ms40 corresponds to 40 ms, and so on.  When the field is absent the UE applies the value infinity. The value for this field cannot be changed in case of reconfiguration with sync, if the bearer is configured as DAPS bearer.","paragraph_zero_based":27811},{"literal_text_all_w_t_and_m_t":"ul-DataSplitThreshold","paragraph_zero_based":27812},{"literal_text_all_w_t_and_m_t":"Parameter specified in TS 38.323 [5]. Value b0 corresponds to 0 bytes, value b100 corresponds to 100 bytes, value b200 corresponds to 200 bytes, and so on. The network sets this field to infinity for UEs not supporting splitDRB-withUL-Both-MCG-SCG and when the SCG is deactivated. If the field is absent when the split bearer is configured for the radio bearer first time, then the default value infinity is applied.","paragraph_zero_based":27813},{"literal_text_all_w_t_and_m_t":"uplinkDataCompression","paragraph_zero_based":27814},{"literal_text_all_w_t_and_m_t":"Indicates the UDC configuration that the UE shall apply. Network does not configure uplinkDataCompression for a DRB, if headerCompression or ethernetHeaderCompression is already configured or outOfOrderDelivery or DAPS is configured for the DRB. The maximum number of DRBs where uplinkDataCompression can be applied is two. The network reconfigures uplinkDataCompression only upon reconfiguration involving PDCP re-establishment. If the field is set to drb-ContinueUDC, the PDCP entity continues the uplink data compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is set to drb-ContinueUDC only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":27815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["63f3cf0072d612309d9028bf98c64024eac20db5c29c8093468f897a68b8e57c","8c1d906055c4e3b9c4a4adf69e4ce99b550dfb4b9fb7db076ec4cfbc957f4b19","9adc5007aef8f726d8e3a42debf1940179f588019697fab64c24941d4f820e2c","51d75fb4b2d74c557f144fb9c650ad8ce448e7f18549a711990cc92a35fb965b","0687482a192143aa050119ee61f78eb9780c7f0d8110620b4af4a06cfa18a1a4","005755a54ed478fa173fc666ef41b3d19f54bceb0090a4e7c4d912026aaccc2c","822a8f1072b6b5d9bcb8ebc3287f205d00b2cc23b307630781ca4424831f4578","f6dfb532aee756db8f0b9741cda81f6b4473110a09dec3f7714667135a47b4fc","f0ec28ca536950692e5894b80677b55ca8d255aaa5eb94ae669faaf04a17be07","c0539130adccbdeaac1954c5ae0298fbf234a38cd65957749e9495de270a1c0b","a61e8185673747690b99a767065e3c44d512d6ee161df16f373dc3c0bd05141e","e83c810652cc0bb4b701a8533e53f7656f6921017a897643d588b10d64c202a6","2a6d60151275ce086cdfa160547b4b6be5084c894c995c02e1b44445b2747d8e","a1cd2c2493e188ba40b40c21485fd5fac58a9c68c08174974c63df83baa12ec6","752b653d760aff5cd0a38b8572be763e4ba7c7dc0c8f40cf87049e2cedc8f874","f9a4d6a554e36fd8673e3d9c8f2b55e749433fd3cec916acaa822faccedf8142","50474660ca0dc3537bff49771a813d914002ba362daeec7379c721be0413c02e","23bdfb7dbbb902ed4f0e249065070123e34a9b301c667c0f1f75024efbeccbf9","db11ccdcb5c46df685c34f21a1695f1ef646b48437ddf280081fd349932285c4","568e88e6c8e12dca638fe8ec1df7797fe1e9e07b0a8f52403a8436d1da14cc25","0dc251226fc8ef26aabd436025a41cb31dac0256a0579e77dc83e1cef39922be","b50df59482b00b47214fc764c815188cb9a6cb80dd4a69748c298cd61a7a7122","bba6aa7a6a73415e285287a48815d42a108e647ce8db77aa3db5318550249105","56007231c0b6828463591620af1d9351a9ccfc65638ae31f94ebb12e6e1b8a14"],"paragraph_range_zero_based":[27792,27815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27816},{"literal_text_all_w_t_and_m_t":"EthernetHeaderCompression field descriptions","paragraph_zero_based":27817},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-DL","paragraph_zero_based":27818},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the downlink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":27819},{"literal_text_all_w_t_and_m_t":"drb-ContinueEHC-UL","paragraph_zero_based":27820},{"literal_text_all_w_t_and_m_t":"Indicates whether the PDCP entity continues or resets the uplink EHC header compression protocol during PDCP re-establishment, as specified in TS 38.323 [5]. The field is configured only in case of resuming an RRC connection or reconfiguration with sync, where the PDCP termination point is not changed and the fullConfig is not indicated.","paragraph_zero_based":27821},{"literal_text_all_w_t_and_m_t":"ehc-CID-Length","paragraph_zero_based":27822},{"literal_text_all_w_t_and_m_t":"Indicates the length of the CID field for EHC packet. The value bits7 indicates the length is 7 bits, and the value bits15 indicates the length is 15 bits. Once the field ethernetHeaderCompression-r16 is configured for a DRB or a multicast MRB, the value of the field ehc-CID-Length for this DRB or multicast MRB is not reconfigured to a different value.","paragraph_zero_based":27823},{"literal_text_all_w_t_and_m_t":"ehc-Common","paragraph_zero_based":27824},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for both downlink and uplink.","paragraph_zero_based":27825},{"literal_text_all_w_t_and_m_t":"ehc-Downlink","paragraph_zero_based":27826},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only downlink. If the field is configured, then Ethernet header compression is configured for downlink. Otherwise, it is not configured for downlink.","paragraph_zero_based":27827},{"literal_text_all_w_t_and_m_t":"ehc-Uplink","paragraph_zero_based":27828},{"literal_text_all_w_t_and_m_t":"Indicates the configurations that apply for only uplink. If the field is configured, then Ethernet header compression is configured for uplnik. Otherwise, it is not configured for uplink.","paragraph_zero_based":27829},{"literal_text_all_w_t_and_m_t":"maxCID-EHC-UL","paragraph_zero_based":27830},{"literal_text_all_w_t_and_m_t":"Indicates the value of the MAX_CID_EHC_UL parameter as specified in TS 38.323 [5]. The total value of MAX_CID_EHC_UL across all bearers for the UE should be less than or equal to the value of maxNumberEHC-Contexts parameter as indicated by the UE.","paragraph_zero_based":27831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27832},{"literal_text_all_w_t_and_m_t":"UplinkDataCompression field descriptions","paragraph_zero_based":27833},{"literal_text_all_w_t_and_m_t":"bufferSize","paragraph_zero_based":27834},{"literal_text_all_w_t_and_m_t":"This field indicates the buffer size applied for UDC as specified in TS 38.323 [5]. Value kbyte2 means 2048 bytes, kbyte4 means 4096 bytes and so on.","paragraph_zero_based":27835},{"literal_text_all_w_t_and_m_t":"dictionary","paragraph_zero_based":27836},{"literal_text_all_w_t_and_m_t":"This field indicates which pre-defined dictionary is used for UDC as specified in TS 38.323 [5]. The value sip-SDP means that UE shall prefill the buffer with standard dictionary for SIP and SDP defined in TS 38.323 [5], and the value operator means that UE shall prefill the buffer with operator-defined dictionary.","paragraph_zero_based":27837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27838},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":27839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3c17d220f3a4decb1152fdd219aade508d821fc7af177fd2a61ad4491659cc05","eff3275ceb70a5f8225ae7571d1598f96de5fb97cc4389b4b5831c8aadaa875f","08a0c5702f05db6f615972b3b271e24bc552379756b2e64b26c718bebf85a69b","75180795a91b7399029a02a228434afaeb9e7dc82663b3f32aa3881a6fcd79ce","dff03d584b0283ee8ea3ff81b02ce97efef70c691bcd838614112f5c26b7664a","2d3c41c2bb7971c977504753515cc353c285a50550f59945d078d9287339d873","026919fe788901073f1e1595cfdf993aafad4f864dee358dd2788a1097f00197","0c577ab0703732b8dab02fecdee75d2945c401de1dc8dda26b134951927bfcec","47651f7f1aa9f096097355e1f6d5e140c002666ca4547833731a9d4029ec5dd4","8a30c1c692bc9955d256308132bf7617fef66fd38a4ab03290b2126eb2e8129d","dbfe25c617e6d303e8900bfdff40cce7dfd0a005e67993d1eeb1038fb8091245","1832dda3b6b4bd631ea6fdbee3ca2eeb87578cae1ccd1dc793ca6980af025c99","0577168d6875418a678ae44986fe7e0dd76c699b922ac94d36d629c64243c6fe","98e643428ef3dc2279247a82f0c9d90649196b842cd6c5ec9e11193693bd43d4","5efb5a607b809186af4ffb2ba4435ecaddd4bfeeae924f311ef3bb8034148dc1","1b27e3fedc966630fb53b3b1a0bf5000b249c96c3e41fe99f9ae696584002975","bad16f4f5cc64ea6b9bb1e1af649fa6731587fc7980823ce472a47df2fb323e0","b35ae9fff67e7f688ad4e8ee7290cbd1c2ce47c1afe3e6db4d83b2bb98bf6505","622d5befd9f864f1b1fdbbf6e9e391ee9254794b36c812ca875002905a89aee1","c058e8fa51e81aba8e61dbe60fac1d1c7ad0eaaab92b5b6934dbb662187be1c0","e13b271c8c637f28eed013038ad9d48d8e271aa7078f5ca99573a74d214dcd9b","d21ab2dea791d122b5b7e373b6f32074e03911b88b9fd8e3a6573fa0eceb7ceb","ae21e55f47f09ad655a16c1d3da89d29167a48fa82ba6025f4fd7b1194d396b5","37407287a837bc47f69ec2f26cbf7aa73e8f067bc718116d35da1d60ed1557fe"],"paragraph_range_zero_based":[27816,27839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27816"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27840},{"literal_text_all_w_t_and_m_t":"DRB","paragraph_zero_based":27841},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the corresponding DRB/multicast MRB is being set up, absent for SRBs. Otherwise this field is optionally present, need M.","paragraph_zero_based":27842},{"literal_text_all_w_t_and_m_t":"DRB2","paragraph_zero_based":27843},{"literal_text_all_w_t_and_m_t":"This field is optionally present in case of DRB, need M. Otherwise, it is absent for SRBs and MRBs.","paragraph_zero_based":27844},{"literal_text_all_w_t_and_m_t":"Drb-Duplication","paragraph_zero_based":27845},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent. For DRBs, this field is absent if duplication is not configured. Otherwise, this field is optional, need R.","paragraph_zero_based":27846},{"literal_text_all_w_t_and_m_t":"MoreThanOneRLC","paragraph_zero_based":27847},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer (except for multicast MRB) with more than one associated logical channel and upon RRC reconfiguration with the association of additional logical channels to the PDCP entity.","paragraph_zero_based":27848},{"literal_text_all_w_t_and_m_t":"The field is also mandatory present in case the field moreThanTwoRLC-DRB is included in PDCP-Config.","paragraph_zero_based":27849},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with multiple logical channels, this field is optionally present need M. Otherwise, this field is absent. Need R.","paragraph_zero_based":27850},{"literal_text_all_w_t_and_m_t":"MoreThanTwoRLC-DRB","paragraph_zero_based":27851},{"literal_text_all_w_t_and_m_t":"For SRBs, this field is absent.","paragraph_zero_based":27852},{"literal_text_all_w_t_and_m_t":"For DRBs, this field is mandatory present upon RRC reconfiguration with setup of a PDCP entity for a radio bearer with more than two associated logical channels and upon RRC reconfiguration with the association of one or more additional logical channel(s) to the PDCP entity so that the PDCP entity has more than two associated logical channels.","paragraph_zero_based":27853},{"literal_text_all_w_t_and_m_t":"Upon RRC reconfiguration when a PDCP entity is associated with more than two logical channels, this field is optionally present, Need M. Otherwise, the field is absent, Need R.","paragraph_zero_based":27854},{"literal_text_all_w_t_and_m_t":"Rlc-AM","paragraph_zero_based":27855},{"literal_text_all_w_t_and_m_t":"For RLC AM, the field is optionally present, need M. Otherwise, the field is absent.","paragraph_zero_based":27856},{"literal_text_all_w_t_and_m_t":"Rlc-AM-UM","paragraph_zero_based":27857},{"literal_text_all_w_t_and_m_t":"In case of DRB, for RLC UM (if the UE supports DAPS handover) or RLC AM, the field is optionally present, need R. In case of multicast MRB, if multicast MRB is associated with at least one RLC AM entity, the field is optionally present, need R. Otherwise, the field is absent.","paragraph_zero_based":27858},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":27859},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of DRB setup. Otherwise the field is optionally present, need M.","paragraph_zero_based":27860},{"literal_text_all_w_t_and_m_t":"SplitBearer","paragraph_zero_based":27861},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optional present, need M, in case of radio bearer with more than one associated RLC mapped to different cell groups.","paragraph_zero_based":27862},{"literal_text_all_w_t_and_m_t":"SplitBearer2","paragraph_zero_based":27863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f015bd57c356782722ba3bbfd1dad5de66b36b880ffaff704052dd01fe032864","e63cc0675ad15e5d8e6f5e2252ac9f210398295470bc1e6352669de9280e083e","719159ccdf436021fdfce39fb57d25d3ccb6b311056509a5e08b37f2caf0d0d2","cec4ecf3c15c8161b3e7f852eac5c7cca87f73456ecedb22ef370b94e6e737c6","11eaf042e8505561ac00dff904bb1bb2cebab1f7a0f114e77a8088280eea74d1","3d7326600f52b297e197b5425d765d322b3048f17dcbe0a142da33f90446e100","416655d1d69352d8c89e5332ccc1320963244ebe1dc0511748d570ebd876e6ff","44a7020872bd63c9bfde437b024ce495d01f03dd8881c00e80515b823beaf2f5","9d2937769ac561463d1d506eddd9abb98d5f96d43c298cb7c104c836418d1979","3bb94e7dd5079b5d7ba723636886cbff0cdea570638e35ed97424725e353b9a3","347aaddd064d7bd088a69582f4e7b507849ce84dec6557cc65efaf5534fc7b52","dcb9d0d5aefcaae56a1fe39efad53200373f3498622817da5dd0a28fd283de41","300436c1d40138be1412bcd37304603cc110bb4dadb2013e6381f7f9570ea434","d223d260c85862db1cd54312e72e8e98c6f1a5a828182faae52105abb0de5306","ad841a16e1a22b593fcb45bd2d8e208c9f74ed890163134c783cec0ec235a18c","b25251ff95c3253cc2198a43e75e269a3e15476f1467517049763e85fcd8c028","fc4d7bb19a83fbc9d9fe947e7e63847d5163e64a415fbce8635365d83a9a607e","e9bc245901b6b0f99bea9774da9fdc05b109d10f0274a1031c86e22de0811241","b8e217ff0ef01c1a2367e395a768e6a688d1e8bc433083b743c9427387e5795c","c1d9fc18db7d7c835a4907cc4df4eb5d6098f35cc8f0dcff37b55b578ab2a83d","682da532f5752bc0315bb0ba25fa28c1c0f7d00f267ddd08fddfe63837b5c404","5f2ad95e86070b7fabb8f74849dbbbb65c8f71d988b79e4a73c77e0ef7e5152b","e19ff02e1882e5a34432aa4ae90053f865b6779d3abd1fcf2a65047c86f2a5d8","98b87d45d655b1ef4f0e5629d9f64ae2d6942a019feb37de9feb2718cd105b2c"],"paragraph_range_zero_based":[27840,27863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27840"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present, in case of a split bearer. Otherwise the field is absent.","paragraph_zero_based":27864},{"literal_text_all_w_t_and_m_t":"SplitBearerMP","paragraph_zero_based":27865},{"literal_text_all_w_t_and_m_t":"The field is absent for SRBs. Otherwise, the field is optionally present, need R, when MP is configured.","paragraph_zero_based":27866},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC","paragraph_zero_based":27867},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to 5GC. Otherwise the field is absent.","paragraph_zero_based":27868},{"literal_text_all_w_t_and_m_t":"ConnectedTo5GC1","paragraph_zero_based":27869},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is connected to NR/5GC or if the UE supports user plane integrity protection when connected to E-UTRA/EPC (as specified in TS 33.401 [30]). Otherwise the field is absent.","paragraph_zero_based":27870},{"literal_text_all_w_t_and_m_t":"Setup1","paragraph_zero_based":27871},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of DRB setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":27872},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":27873},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case for radio bearer setup for RLC-AM and RLC-UM. Otherwise, this field is absent, Need M.","paragraph_zero_based":27874},{"literal_text_all_w_t_and_m_t":"MRB-Initialization","paragraph_zero_based":27875},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of multicast MRB setup or in case UE configured with multicast reception in RRC_INACTIVE resumes the RRC connection. In case of PDCP re-establishment for multicast MRB, this field is optionally present, Need N. Otherwise, this field is absent, Need N.","paragraph_zero_based":27876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27877},{"literal_text_all_w_t_and_m_t":"–PDSCH-Config","paragraph_zero_based":27878},{"literal_text_all_w_t_and_m_t":"The PDSCH-Config IE is used to configure the UE specific PDSCH parameters. If this IE is used for MBS CFR, the following fields shall be absent: tci-StatesToAddModList, tci-StatesToReleaseList, zp-CSI-RS-ResourceToAddModList, minimumSchedulingOffsetK0, antennaPortsFieldPresenceDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToAddModListDCI-1-2, aperiodicZP-CSI-RS-ResourceSetsToReleaseListDCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2, dmrs-SequenceInitializationDCI-1-2, harq-ProcessNumberSizeDCI-1-2, mcs-TableDCI-1-2, numberOfBitsForRV-DCI-1-2, pdsch-AggregationFactor, pdsch-TimeDomainAllocationListDCI-1-2, prb-BundlingTypeDCI-1-2, priorityIndicatorDCI-1-2, rateMatchPatternGroup1DCI-1-2, rateMatchPatternGroup2DCI-1-2, resourceAllocationType1GranularityDCI-1-2, vrb-ToPRB-InterleaverDCI-1-2, referenceOfSLIVDCI-1-2, resourceAllocationDCI-1-2, dataScramblingIdentityPDSCH2-r16, repetitionSchemeConfig, pdsch-ConfigDCI-1-3.","paragraph_zero_based":27879},{"literal_text_all_w_t_and_m_t":"PDSCH-Config information element","paragraph_zero_based":27880},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27881},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-START","paragraph_zero_based":27882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27883},{"literal_text_all_w_t_and_m_t":"PDSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":27884},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPDSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":27885},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeA      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27886},{"literal_text_all_w_t_and_m_t":"    dmrs-DownlinkForPDSCH-MappingTypeB      SetupRelease { DMRS-DownlinkConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":27887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cf381e9aef5a57ed9dd160b1b7c1a2ab2958595cfb8d2e11fdb9d156b0f2d711","6041cdc998058a54edbd5e4b9a68c1b22afa09ea9dcff04bea46ab7d817c6ad0","fc930fbbcf928e0930160b1acb15a67f7e435d7f0fe0bf04982d726f37c272be","5f8532c7709e7c90cbaab2817cc8fa517651e2f79ed55eea3c446c6d4c4c20ed","a213f3400744351d3b8abc5480c3d0611a640ae04186e20de6b4574bea8d93d0","079a11c26a02202d29e0d26876e94445cf5212fb2acddbb10c78891f44de5c8b","4db4b401bbc2bc1ef0639a92772e2c67cf56f90e0da14976740e9f6958d94d5c","8fd49a7914c2c80397c59db7636765f1b01a1db6343464b5c90a02775f7f7f4b","cc4c5cee0cb5ebbf7bbb61aae1b865b556a8374e8b6eef9604d59df3379e3654","a671a03cefa3de5bd40dac173f0d5fe58de328c11851033b0e142420d524af66","1dd91ced07096ded9318b8bb746a5b5de4872b040e8d7fa3befb07ff4a6c3cbf","07c1ffdae5c7c703730cb8f1784b58e53516cbca5ba7182216bde6d7c42466de","c10ab2bb6eff0d31fa3134b01c9cc3a51d7c2f624839b117f4b378c5d3da39e8","d999741b0a02e759e1658399c3e63def56131eecaa5798c870b97aa84b56ae27","0d540e1fa4e5d0bb091ef5157ffcc854b943dc54edb532dda846ed90175e35b1","566d99499b0a29e0309974d5aa509d8b358bd19f6a76baeadfece99dfc3b4ad9","7210b41f48b61effcce9424a724dac2f5e411ac86417e345315487233fcda9f7","cbd3ae097994125867ad7e50438041ded7a2dcd9e04ae4d443f5dd71a9a9b64d","5ea3e5f082df00831c19a9162fff93812fdb9e7fe41664d9db48b14f4a85c711","c7ee15cf8f5c924