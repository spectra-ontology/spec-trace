{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NPN-Identity field descriptions","paragraph_zero_based":26328},{"literal_text_all_w_t_and_m_t":"cag-Identity","paragraph_zero_based":26329},{"literal_text_all_w_t_and_m_t":"A CAG-ID as specified in TS 23.003 [21]. The PLMN ID and a CAG ID in the NPN-Identity identifies a PNI-NPN.","paragraph_zero_based":26330},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":26331},{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":26332},{"literal_text_all_w_t_and_m_t":"manualCAGselectionAllowed","paragraph_zero_based":26333},{"literal_text_all_w_t_and_m_t":"The manualCAGselectionAllowed indicates that the CAG ID can be selected manually even if it is outside the UE's allowed CAG list.","paragraph_zero_based":26334},{"literal_text_all_w_t_and_m_t":"NID","paragraph_zero_based":26335},{"literal_text_all_w_t_and_m_t":"A NID as specified in TS 23.003 [21]. The PLMN ID and a NID in the NPN-Identity identifies a SNPN.","paragraph_zero_based":26336},{"literal_text_all_w_t_and_m_t":"nid-List","paragraph_zero_based":26337},{"literal_text_all_w_t_and_m_t":"The nid-List contains one or more NID.","paragraph_zero_based":26338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26339},{"literal_text_all_w_t_and_m_t":"–NPN-IdentityInfoList","paragraph_zero_based":26340},{"literal_text_all_w_t_and_m_t":"The IE NPN-IdentityInfoList includes a list of NPN identity information.","paragraph_zero_based":26341},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList information element","paragraph_zero_based":26342},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26343},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-START","paragraph_zero_based":26344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26345},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList-r16 ::=     SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-IdentityInfo-r16","paragraph_zero_based":26346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26347},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26348},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":26349},{"literal_text_all_w_t_and_m_t":"    npn-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-Identity-r16,","paragraph_zero_based":26350},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode,","paragraph_zero_based":26351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["756a565ae53e7e22dc779a8d8b11857540b22d6255408074a752350c9986dcf5","298209200140c08c47d9fe2e875de1b56d003a57ef234d2c30ce6a07adec6a1b","5e6736aeb8c2536ffd9ea0ee2d5c8cbca4f04c982efc4c2136133d3f7d671275","12b1d34a5f3e34cbf803390f6a8ae8f6fcabc5cc6d63fdfe078703fbd3226850","1a79a823f5af58e5b0c3e374afb4c092e6a6a040f2caa93b18ec01e0cb31676f","4873d9676f3e09e9c43c3c9fc6c299a36c913e9b0f0272f323d484e775d1797e","9b314c606c1a57c57fbbdbf13e6c8f28bfcea62722fcfd42824d3fb26fb98032","03e662a440f8df4aacb19b5593d96c5d04cb8f06bacdf3cbcf8a23fa6a179977","600e872a8b1371f6ef27c1ddec4e06a9627e628724a3b1316db67ea5cefe974b","ad98150ecd49cf669c47ef1aab84b120484d895228a4b909f41c68f5c4afc283","a5d915a36cd84bd6743772c157e3f5b4f614b12d55326c44e5cbad0174342126","e398559457d963c617513829e72b97a1a89f1c526fbe66debf1280840f051d2c","3569e070cf2bf0b9828e009347e455f8e6a7064a157bce9726ded96fd453b81b","418b2