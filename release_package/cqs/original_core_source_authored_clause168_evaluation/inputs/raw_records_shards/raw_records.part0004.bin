ationFactor-r16     ENUMERATED {n1, n2, n4, n8 }                                                OPTIONAL    -- Need S","paragraph_zero_based":34139},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":34140},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34141},{"literal_text_all_w_t_and_m_t":"    sps-HARQ-Deferral-r17           INTEGER (1..32)                                                             OPTIONAL,   -- Need R","paragraph_zero_based":34142},{"literal_text_all_w_t_and_m_t":"    n1PUCCH-AN-PUCCHsSCell-r17      PUCCH-ResourceId                                                            OPTIONAL,   -- Need R","paragraph_zero_based":34143},{"literal_text_all_w_t_and_m_t":"    periodicityExt-r17              INTEGER (1..40960)                                                          OPTIONAL,   -- Need R","paragraph_zero_based":34144},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-Processes-v1710        INTEGER(9..32)                                                              OPTIONAL,   -- Need R","paragraph_zero_based":34145},{"literal_text_all_w_t_and_m_t":"    harq-ProcID-Offset-v1700        INTEGER (16..31)                                                            OPTIONAL    -- Need R","paragraph_zero_based":34146},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":34147},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34149},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-STOP","paragraph_zero_based":34150},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["acc31bcecc2d8758cd64cb7b49a9f8c7c0c4952eb19bf6d09706860527a30dc5","049a0501c841060165974f7ae9f1cffcb5be86d7c87ad82effdc97b37647d178","37017646a24d37b4b7952e8e4bbe2ef6c6058a0bbed6975b9c213de31b93a9cd","f2d11840d438365903849ae6a0edf6508451cf1e70529cb6fb829fe74622a594","c1cf9049260ae6c5add723fa6b62b829d91e9e4df37abb852628e1acfbfc7241","9061b1b11107bc45b63a391e3dcc525a56f2b4ff16fdccc7ab7eb7fb49199414","448a43021d70a42a8e06fc1b0df159640d5b671ccfc870d14b2b1cb6b6c3438d","89af4f5d9438e0720aa259139b3307b4653080ea470c738db1f054c7b1cbdcdb","42fab0e7d420dc1c37cd865c12f04d808d3ff84f8aa0b5ccda79279dc6d88a85","a78907a656a43f920d52c63f4fa79497a7eb55b5586db1269386d223d28df99d","aedb9d17e6899192060b8104523b39d9685cc41c902e790ade6a2031d65a6398","50b72650276c442f98b761d94b8e03a21b88ee79d767272da798fc4011118157","07253007db918493d2104b14ed425cdaba7709f2f8e4575bc3846e597492c21e","1f984187dbc5412f3784de689a672a301a4304904c0f1f1b6c048c3fa211dfc1","ab308cf22586fbd147a3e511817cb0072131f98a950200af3565247f979d43eb","2a98f3228b4c9dc78c5501c4587a5062e2ff45cb5cf0b5bd47c8a30720314ff9","a87c8067f1520bc1ae649e99b85df4fe65173173df25a85a9ea615b3a803cb9c","4660b98b303ca27db42787d96acec64c158caf2f8c7133cf5433a67f5f632908","d3c78414b67c53f9863ca4d9ea742517dac9a8b8849d9a868ada8aa6389d8690","7ad24ccf0ffeacea763fb1e9acb1e26cb1ef06c3b9e266d02679ba09a9ab0470","7394f61f549dcaa395160b2c40941727a48b8fa25be2335985dc1b9176d62a1d","6d1325837d90fc009383c3e3a0745a52d68eb6e782e51a762bf478e1426dba72","27dd318cc026863d5af178c633d62979f74cbfbc7e2b43cc6abad3d1fcaf6503","77ae2dfe7934d10dac6a7de14e02f34d72dcb50d68205d62a0b097b754418c76"],"paragraph_range_zero_based":[34128,34151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34128"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34152},{"literal_text_all_w_t_and_m_t":"SPS-Config field descriptions","paragraph_zero_based":34153},{"literal_text_all_w_t_and_m_t":"harq-CodebookID","paragraph_zero_based":34154},{"literal_text_all_w_t_and_m_t":"Indicates the HARQ-ACK codebook index for the corresponding HARQ-ACK codebook for SPS PDSCH and ACK for SPS PDSCH release.","paragraph_zero_based":34155},{"literal_text_all_w_t_and_m_t":"harq-ProcID-Offset","paragraph_zero_based":34156},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process IDs, see TS 38.321 [3], clause 5.3.1.","paragraph_zero_based":34157},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":34158},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table the UE shall use for DL SPS (see TS 38.214 [19],clause 5.1.3.1. If present, the UE shall use the MCS table of low-SE 64QAM table indicated in Table 5.1.3.1-3 of TS 38.214 [19]. If this field is absent and field mcs-table in PDSCH-Config is set to 'qam256' and the activating DCI is of format 1_1, the UE applies the 256QAM table indicated in Table 5.1.3.1-2 of TS 38.214 [19]. If this field is absent and the field mcs-Table-r17 in PDSCH-Config is set to 'qam1024' and the activating DCI is format 1_1, the UE applies the 1024QAM table indicated in Table 5.1.3.1-4 of TS 38.214 [19]. Otherwise, the UE applies the non-low-SE 64QAM table indicated in Table 5.1.3.1-1 of TS 38.214 [19].","paragraph_zero_based":34159},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN","paragraph_zero_based":34160},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH for DL SPS. The network configures the resource either as format0 or format1. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":34161},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN-PUCCHsSCell","paragraph_zero_based":34162},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH on PUCCH switching SCell (sSCell) for DL SPS. The network configures the resource either as format 0 or format 1. The actual PUCCH-Resource is configured in PUCCH-Config of the PUCCH sSCell and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":34163},{"literal_text_all_w_t_and_m_t":"nrofHARQ-Processes","paragraph_zero_based":34164},{"literal_text_all_w_t_and_m_t":"Number of configured HARQ processes for SPS DL (see TS 38.321 [3], clause 5.8.1). If UE is configured with nrofHARQ-Processes-v1710 UE shall ignore nrofHARQ-Processes (without suffix).","paragraph_zero_based":34165},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":34166},{"literal_text_all_w_t_and_m_t":"Number of repetitions for SPS PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent, the UE applies the value 1 for MBS multicast data and the pdsch-AggregationFactor in pdsch-Config for other data.","paragraph_zero_based":34167},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":34168},{"literal_text_all_w_t_and_m_t":"Periodicity for DL SPS (see TS 38.214 [19] and TS 38.321 [3], clause 5.8.1).","paragraph_zero_based":34169},{"literal_text_all_w_t_and_m_t":"periodicityExt","paragraph_zero_based":34170},{"literal_text_all_w_t_and_m_t":"This field is used to calculate the periodicity for DL SPS (see TS 38.214 [19] and see TS 38.321 [3], clause 5.8.1). If this field is present, the field periodicity is ignored.","paragraph_zero_based":34171},{"literal_text_all_w_t_and_m_t":"The following periodicities are supported depending on the configured subcarrier spacing [ms]:","paragraph_zero_based":34172},{"literal_text_all_w_t_and_m_t":"15 kHz:periodicityExt, where periodicityExt has a value between 1 and 640.","paragraph_zero_based":34173},{"literal_text_all_w_t_and_m_t":"30 kHz:0.5 x periodicityExt, where periodicityExt has a value between 1 and 1280.","paragraph_zero_based":34174},{"literal_text_all_w_t_and_m_t":"60 kHz with normal CP.0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":34175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb5e64734e9fd21d29ce82bdcff61bf581b7893321a4e8162b9e45a6c507bb5a","aacd01eed9503e4b3dc30c9fe38d258bd39d4db01a8710e5a260ed8070fb37a9","56b8d7a6e002f65dd074e77eba806c4ef3720982601845db0420f4c0cc805e5b","6226ff7f3f1393fc098fa5caf212ca6111158551fb9e4acda1d10a6737aa7c7d","8ad96bd41c92210a0319df718eecef164a325b2a275e1a30b7db9800983bfff5","78bad4eba37acc987bbdd7d5d0be524a416283ee523ea219f87031457ec3462c","1d15aaf621a28d2652c235d2006148a1dc6454de8b70d397bd45a9279e44f44f","97d633db0db9d1760f7c19c6312c11393c119ec90fd758318d0a9ed1224e4663","f3b924a8bafb8f3ecf9a01e5537e87d9be9c56960a917d25bb0b1e08fdf0fbdb","c854bc9e7c6d5aa5c58b9ae538141584c4854f83eb1d57031bb439d57412c358","cfb59638ca13090b5d418b60b5947aec00f7cd1dacf28d91c2257e6e630c3902","2a81d59ded3a9bed41c2ef59c975299983ce4d6d0baae5118cefe2dc8f96b685","9fd22a554a3f097ea07edefd8bd19551cf489f42a66a3665024cc3c071f71b48","1c78f412b8931820beee06b9b749a861cde6190704203480fc582188d570f401","2de9dc982a9c77706786d0a1249364413a02ccee3a3a11712bc295906922c66a","14318c272b4b512b6a61fb9d82322519fed2ec4eed6c4dad5d27586eccd5ff79","02446e587b66cc7c5418cab01a4e2d345bfb0dcac01b0a1dc69d9acf46c36cd2","fa866801ea11aeb8a9954e3d2cc7f05b331b6ca4801210fa8b31c4862f165498","3f0c113c2cf480ff19edf4d51b70ac55378a56ece57c2c3e76d77ae9756fdcfb","6ae0a8fb87e96c0367063ef5a9cd71714ef3167d5ebd7a1bbae957b08f2444aa","50508a6314bce05fdea83040b45401cae6c085c8c3a7eab718b57532363d1792","8760aa2fbcdc4785a75ec2b5e5530e2de9d58d7a0bcf15f8de1a48ea30b18d90","5c9c41750c9745d40fefc23bebf5599fd05443c6ab7c67b874504590c41ca962","c19904f4de49a6497324b16e8d4421246adc55266f89987b7198b526c167ec39"],"paragraph_range_zero_based":[34152,34175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34152"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"60 kHz with ECP:0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":34176},{"literal_text_all_w_t_and_m_t":"120 kHz:0.125 x periodicityExt, where periodicityExt has a value between 1 and 5120.","paragraph_zero_based":34177},{"literal_text_all_w_t_and_m_t":"480 kHz:0.03125 x periodicityExt, where periodicityExt has a value between 1 and 20480.","paragraph_zero_based":34178},{"literal_text_all_w_t_and_m_t":"960 kHz:0.015625 x periodicityExt, where periodicityExt has a value between 1 and 40960.","paragraph_zero_based":34179},{"literal_text_all_w_t_and_m_t":"periodicityExt-r17 is only applicable for SCS 480 kHz and 960 kHz.","paragraph_zero_based":34180},{"literal_text_all_w_t_and_m_t":"sps-ConfigIndex","paragraph_zero_based":34181},{"literal_text_all_w_t_and_m_t":"Indicates the index of one of multiple SPS configurations.","paragraph_zero_based":34182},{"literal_text_all_w_t_and_m_t":"sps-HARQ-Deferral","paragraph_zero_based":34183},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of slots or subslots the transmission of DL SPS HARQ-ACK in a slot or subslot can be deferred (see TS 38.213 [13], clause 9.2.5.4).","paragraph_zero_based":34184},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34185},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":34186},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34187},{"literal_text_all_w_t_and_m_t":"SPS-List","paragraph_zero_based":34188},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when included in sps-ConfigToAddModList-r16 or sps-ConfigMulticastToAddModList-r17, otherwise the field is absent.","paragraph_zero_based":34189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34190},{"literal_text_all_w_t_and_m_t":"–SPS-ConfigIndex","paragraph_zero_based":34191},{"literal_text_all_w_t_and_m_t":"The IE SPS-ConfigIndex is used to indicate the index of one of multiple DL SPS configurations in one BWP.","paragraph_zero_based":34192},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex information element","paragraph_zero_based":34193},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34194},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-START","paragraph_zero_based":34195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34196},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex-r16             ::= INTEGER (0.. maxNrofSPS-Config-1-r16)","paragraph_zero_based":34197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34198},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-STOP","paragraph_zero_based":34199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["78a34d1486b6a2c98080b443cbc44d2b0e90b67d3c3288052ec7b031b2beaee2","31dedd3f09f9bc252b2e14da7cd191834ec3a8507b25b403b545cf37a068b974","8b0a2205ed6e09ef7ef7a5b88205ef77b94aff918f79cb282ff9da8aa06bc61a","9de7abca251b8c4bb72a2c5bd3d6227871db901ba293647b9eb086f3990573bd","899ac6c17988dcb3378c7f270c3b4d5376481ce0070ce9d5e0ec8a61b9aee865","ac3a62b550e4897ed4e63b00c3e764cbcb45e5f74a19bab7dd4cb91a973bdd6c","aa49f23f6f88843ef8973595145467829b82e028dd97ae9b603b62e98afaa248","53485775bfb9956e263a7fd18d7ca34f66b1a8b067ae03c6fa59eeb30d1ca46e","58b873104ab4cc180769c117c03a6cc7bd95f8a5527e551b5a22fca42ea0e080","8c9a48f73e82dca69108c541bb9b9a7675f19ea32898e2edafb00ed1a8fe3274","7d68b7e9396ef5d191b003ed50c358117a25ca9acbe51ae3a68b509a2442c61e","e47485a67614b79c50e93a57bc6dadd60eff522afac81d564267