{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"trp-BeamAntennaInfoErrorCorrelationTime","paragraph_zero_based":576},{"literal_text_all_w_t_and_m_t":"This field specifies the Mean Beam Power Error Correlation Time which is the upper bound of the correlation time of the mean beam power error.","paragraph_zero_based":577},{"literal_text_all_w_t_and_m_t":"The time is calculated using:","paragraph_zero_based":578},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":579},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":580},{"literal_text_all_w_t_and_m_t":"nr-PRU-DL-Info","paragraph_zero_based":581},{"literal_text_all_w_t_and_m_t":"This field provides the measurements reported by a PRU to the target UE.","paragraph_zero_based":582},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":583},{"literal_text_all_w_t_and_m_t":"–NR-PRU-DL-Info","paragraph_zero_based":584},{"literal_text_all_w_t_and_m_t":"The IE NR-PRU-DL-Info is used by the location server to provide the carrier phase measurements with associated measurements and additional information reported by a PRU for UE-based DL-TDOA to a target UE.","paragraph_zero_based":585},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":587},{"literal_text_all_w_t_and_m_t":"NR-PRU-DL-Info-r18 ::= SEQUENCE {","paragraph_zero_based":588},{"literal_text_all_w_t_and_m_t":"nr-PRU-LocationInfo-r18LocationCoordinatesOPTIONAL, -- Need ON","paragraph_zero_based":589},{"literal_text_all_w_t_and_m_t":"nr-PRU-DL-TDOA-MeasInfo-r18NR-DL-TDOA-SignalMeasurementInformation-r16","paragraph_zero_based":590},{"literal_text_a