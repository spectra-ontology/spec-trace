{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53304},{"literal_text_all_w_t_and_m_t":"Counter check","paragraph_zero_based":53305},{"literal_text_all_w_t_and_m_t":"CounterCheck","paragraph_zero_based":53306},{"literal_text_all_w_t_and_m_t":"CounterCheckResponse","paragraph_zero_based":53307},{"literal_text_all_w_t_and_m_t":"5","paragraph_zero_based":53308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53309},{"literal_text_all_w_t_and_m_t":"UE information","paragraph_zero_based":53310},{"literal_text_all_w_t_and_m_t":"UEInformationRequest","paragraph_zero_based":53311},{"literal_text_all_w_t_and_m_t":"UEInformationResponse","paragraph_zero_based":53312},{"literal_text_all_w_t_and_m_t":"15","paragraph_zero_based":53313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53314},{"literal_text_all_w_t_and_m_t":"DL Information transfer MR-DC","paragraph_zero_based":53315},{"literal_text_all_w_t_and_m_t":"DLInformationTransferMRDC","paragraph_zero_based":53316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53317},{"literal_text_all_w_t_and_m_t":"NA","paragraph_zero_based":53318},{"literal_text_all_w_t_and_m_t":"The UE shall apply the performance requirements of the RRC message included within the DLInformationTransferMRDC message.","paragraph_zero_based":53319},{"literal_text_all_w_t_and_m_t":"IAB other information","paragraph_zero_based":53320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53321},{"literal_text_all_w_t_and_m_t":"IABOtherInformation","paragraph_zero_based":53322},{"literal_text_all_w_t_and_m_t":"NA","paragraph_zero_based":53323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53324},{"literal_text_all_w_t_and_m_t":"Sidelink UE information","paragraph_zero_based":53325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53326},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR","paragraph_zero_based":53327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c5db5b30c32cd747b05d851048611480ab6f5307812d7a15766845c06848b700","8336d181ebae97565ac2c2104db72d30d1496e1fcd6ea689a9d0c24aa0de6680","883023f28ee60b47c662b6d8aea72f8c9a33f477b0cd15a32aca10fdd81f7d4e","3a8e975c998af6670f4e2997106fce040af5267a14a5b5c8fdabf436162eb492","623e8b41cc5ae8e0f13a3b22b8992c4cc09e535772823d055b6464e3090df9bd","41156fa568aaf6071c9d69d57973195679f48338d43ae737891f4fcfc8775cea","3caed0816d6dd24b5b07b6027ce186ab133ba601274ba4ca7b0e95bfda56aede","0a82416f4a97fc46ac27c0efdeab2256ea29d0da10a4db12fc35e9bcfa3918fd","74c12b7bd588f3d0a041eb9f0879771f22d6d063f74208b71aa9ddcf987adad3","cbebdb47c5977e20abf3d047967a153992702ee9f3fb8fd13bef93062b46c427","0420332a70b84ec9d1bb4f0788de701fa50ec76fda9fb1210f97f9e5581c44ef","860410ae7d879b31564627f4db8c60b73d188d7ada14845d701bd8620ea9601f","d33dcfca27f1f0e280f93bcd48ac12de2744f66b697e5ceba670128468de2806","c96d25e3c783518efa59e2becfb1f87ad09823066e9cb3698b9b17e698bbf443","889e431fe756ea325f5005e816fd23a7e6abe34fffa82f02ff495330ad792eda","26ee2a2bbc4a1997345c63ba002d9d22ed0c49b20a4b7406957484e84166d1ae","0236e558d7138def8dd2ffc6444ceca6b8ee10056d73fc474a30fb660fc2af8c","d52301054319f1c5d05b479f648b328b485a5e01e6debcb2e300c5e7e9775423","318cbd25ba8fe19a157422f2039c195dd8f59cee4c8eb2ea50c5eaca9f586d60","7644915b5d4cfa16c188078d1b5c2db19200d1d82d55cb59fea293a775959af3","9e6667306d87469b1a3a862e8b10fe1cea7b09d0deea3c5494712d1ba1da78ff","bb49607303f0f3680de0ca8f7e282956fe7074bb875f47ef7c283863b6ae518e","f56ec3847a036c434ff27366093b03a66aaa7f28764479f8418d244eadc02725","c70a9f666822b1cc1410644c6aacf461ca286d215b3b41ef177e99e9adac8377"],"paragraph_range_zero_based":[53304,53327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p53304"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NA","paragraph_zero_based":53328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53329},{"literal_text_all_w_t_and_m_t":"UE Positioning assistance information","paragraph_zero_based":53330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53331},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo","paragraph_zero_based":53332},{"literal_text_all_w_t_and_m_t":"NA","paragraph_zero_based":53333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53335},{"literal_text_all_w_t_and_m_t":"Annex A (informative):Guidelines, mainly on use of ASN.1","paragraph_zero_based":53336},{"literal_text_all_w_t_and_m_t":"A.1Introduction","paragraph_zero_based":53337},{"literal_text_all_w_t_and_m_t":"The following clauses contain guidelines for the specification of RRC protocol data units (PDUs) with ASN.1.","paragraph_zero_based":53338},{"literal_text_all_w_t_and_m_t":"A.2Procedural specification","paragraph_zero_based":53339},{"literal_text_all_w_t_and_m_t":"A.2.1General principles","paragraph_zero_based":53340},{"literal_text_all_w_t_and_m_t":"The procedural specification provides an overall high level description regarding the UE behaviour in a particular scenario.","paragraph_zero_based":53341},{"literal_text_all_w_t_and_m_t":"It should be noted that most of the UE behaviour associated with the reception of a particular field is covered by the applicable parts of the PDU specification. The procedural specification may also include specific details of the UE behaviour upon reception of a field, but typically this should be done only for cases that are not easy to capture in the PDU clause e.g. general actions, more complicated actions depending on the value of multiple fields.","paragraph_zero_based":53342},{"literal_text_all_w_t_and_m_t":"Likewise, the procedural specification need not specify the UE requirements regarding the setting of fields within the messages that are sent to the network i.e. this may also be covered by the PDU specification.","paragraph_zero_based":53343},{"literal_text_all_w_t_and_m_t":"A.2.2More detailed aspects","paragraph_zero_based":53344},{"literal_text_all_w_t_and_m_t":"The following more detailed conventions should be used:","paragraph_zero_based":53345},{"literal_text_all_w_t_and_m_t":"-Bullets:","paragraph_zero_based":53346},{"literal_text_all_w_t_and_m_t":"-Capitals should be used in the same manner as in other parts of the procedural text i.e. in most cases no capital applies since the bullets are part of the sentence starting with 'The UE shall:'","paragraph_zero_based":53347},{"literal_text_all_w_t_and_m_t":"-All bullets, including the last one in a clause, should end with a semi-colon i.e. an ';.","paragraph_zero_based":53348},{"literal_text_all_w_t_and_m_t":"-Conditions:","paragraph_zero_based":53349},{"literal_text_all_w_t_and_m_t":"-Whenever multiple conditions apply, a semi-colon should be used at the end of each conditions with the exception of the last one, i.e. as in 'if cond1, or cond2.","paragraph_zero_based":53350},{"literal_text_all_w_t_and_m_t":"A.3PDU specification","paragraph_zero_based":53351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["be02e13891403aca935c1bd2b5601b01fb324d76a556e6dd8c3e29b88e423f8a","7c98cab092f8db8f70cf50036dc6ea751a930af7a783ededc80b157dc48b6078","b77dc002dcaa8234b0d4649146f87d439978236117ddf802912942b2d2e465be","52fd1ecf79a40689a4f56ca4e9f1d42bf0389a1a5a250955b8e73f422cc968ae","3e57bb272ca28b595160eab375705d21ec359e22b48e6ba83b08feeea270f3da","0b8a5ba77083cec1dfde61bdd97d728974cd084e63b6c755f15a9aa124996636","635447d5720fdf246b66e3e58eb49195a686bf5875ca5d48317960b02d00f342","c600f486c992b925ec3f27384443358d2f081a3ccd9768103659903251d4d4c2","3cf4d86dc84722743a2413418c4b986bddca9717fc1661f8408f2f656cd11b4a","e44c819d83e6c0073329d3c140c44179539fde53f06fd9fda62bad362cdf6b04","800ac43689173e10791e2a94aaaa4f6ef43fa5d040e920a8a585fbd372b1436b","f3ebe591b037d0d032087388270369214849350e5007f80b459a75eeef3d7a5d","46558254e3640d124a9a0134d188dd27898f9e7662c46274d78eb7f507900aa6","15b8cd1ee6129d7f32690df55320864a5581410288ab8ddf0104a5760a2b17ee","3b2008d643886123449ceb16229c98dda782906c0c4cc558193ff0305a339108","851389f3fc8ccca70e99b08ae1bcaf1cf5d963572a28d2d59c304bb52fc6b271","e89789bc0bbaadc64b6b7e3545596beb0f1ff9f657408a82d972df584c668fa4","58321af34efb66f4cbb51931f3d0613d4554121e27dc68eff2dba22423735502","647ca676ef8ac2f9fabdb84c7efe91a9663a7a93b0890ea86a615d9771084095","f115041d6b590ed5086e0468da588b49b90417fbac542003421f8ba95f9aeec4","9867651ffc15cadb26c3048287b9db47f7af0cef6921a9b818ad5006b70eedee","4330dec4d96c2ed36cd95863c840745e2cf0a77267f027bf584080009a6e7b5e","56205daedce6f3526971e74e43abce88222a911e1e8ac60b3b58e20c8cfeb7ea","4b44af298e7fc513898db7a989e72ed6a23bd388fe07e986615bf14f1d0042d5"],"paragraph_range_zero_based":[53328,53351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p53328"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A.3.1General principles","paragraph_zero_based":53352},{"literal_text_all_w_t_and_m_t":"A.3.1.1ASN.1 clauses","paragraph_zero_based":53353},{"literal_text_all_w_t_and_m_t":"The RRC PDU contents are formally and completely described using abstract syntax notation (ASN.1), see X.680 [6], X.681 [7].","paragraph_zero_based":53354},{"literal_text_all_w_t_and_m_t":"The complete ASN.1 code is divided into a number of ASN.1 clauses in the specifications. In order to facilitate the extraction of the complete ASN.1 code from the specification, each ASN.1 clause begins with the following:","paragraph_zero_based":53355},{"literal_text_all_w_t_and_m_t":"-a first text paragraph consisting entirely of an ASN.1 start tag, which consists of a double hyphen followed by a single space and the text string \"ASN1START\" (in all upper case letters);","paragraph_zero_based":53356},{"literal_text_all_w_t_and_m_t":"-a second text paragraph consisting entirely of a block start tag is included, which consists of a double hyphen followed by a single space and the text string \"TAG-NAME-START\" (in all upper case letters), where the \"NAME\" refers to the main name of the paragraph (in all upper-case letters).","paragraph_zero_based":53357},{"literal_text_all_w_t_and_m_t":"Similarly, each ASN.1 clause ends with the following:","paragraph_zero_based":53358},{"literal_text_all_w_t_and_m_t":"-a first text paragraph consisting entirely of a blockstop tag, which consists of a double hyphen followed by a single space and the text string \"TAG-NAME-STOP\" (in all upper-case letters), where the \"NAME\" refers to the main name of the paragraph (in all upper-case letters);","paragraph_zero_based":53359},{"literal_text_all_w_t_and_m_t":"-a second text paragraph consisting entirely of an ASN.1 stop tag, which consists of a double hyphen followed by a singlespace and the text \"ASN1STOP\" (in all upper case letters).","paragraph_zero_based":53360},{"literal_text_all_w_t_and_m_t":"This results in the following tags:","paragraph_zero_based":53361},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":53362},{"literal_text_all_w_t_and_m_t":"-- TAG-NAME-START","paragraph_zero_based":53363},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53364},{"literal_text_all_w_t_and_m_t":"-- TAG-NAME-STOP","paragraph_zero_based":53365},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":53366},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53367},{"literal_text_all_w_t_and_m_t":"The text paragraphs containing either of the start and stop tags should not contain any ASN.1 code significant for the complete description of the RRC PDU contents. The complete ASN.1 code may be extracted by copying all the text paragraphs between an ASN.1 start tag and the following ASN.1 stop tag in the order they appear, throughout the specification.","paragraph_zero_based":53368},{"literal_text_all_w_t_and_m_t":"NOTE:A typical procedure for extraction of the complete ASN.1 code consists of a first step where the entire RRC PDU contents description (ultimately the entire specification) is saved into a plain text (ASCII) file format, followed by a second step where the actual extraction takes place, based on the occurrence of the ASN.1 start and stop tags.","paragraph_zero_based":53369},{"literal_text_all_w_t_and_m_t":"A.3.1.2ASN.1 identifier naming conventions","paragraph_zero_based":53370},{"literal_text_all_w_t_and_m_t":"The naming of identifiers (i.e., the ASN.1 field and type identifiers) should be based on the following guidelines:","paragraph_zero_based":53371},{"literal_text_all_w_t_and_m_t":"-Message (PDU) identifiers should be ordinary mixed case without hyphenation. These identifiers, e.g., the RRCConnectionModificationCommand, should be used for reference in the procedure text. Abbreviations should be avoided in these identifiers and abbreviated forms of these identifiers should not be used.","paragraph_zero_based":53372},{"literal_text_all_w_t_and_m_t":"-Type identifiers other than PDU identifiers should be ordinary mixed case, with hyphenation used to set off acronyms only where an adjacent letter is a capital, e.g., EstablishmentCause, SelectedPLMN (not Selected-PLMN, since the \"d\" in \"Selected\" is lowercase), InitialUE-Identity and MeasSFN-SFN-TimeDifference.","paragraph_zero_based":53373},{"literal_text_all_w_t_and_m_t":"-Field identifiers shall start with a lowercase letter and use mixed case thereafter, e.g., establishmentCause. If a field identifier begins with an acronym (which would normally be in upper case), the entire acronym is lowercase (plmn-Identity, not pLMN-Identity). The acronym is set off with a hyphen (ue-Identity, not ueIdentity), in order to facilitate a consistent search pattern with corresponding type identifiers.","paragraph_zero_based":53374},{"literal_text_all_w_t_and_m_t":"-Identifiers should convey the meaning of the identifier and should avoid adding unnecessary postfixes (e.g. abstractions like 'Info') for the name.","paragraph_zero_based":53375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6e2b4ac8bb01472d8d9a2b0c2e1413cc3176d1f21053261d09e2109987a66749","d175e93af453d8fb6d2c16125b9bb1c93a8017934958a633b7dcfa3a1c3cd756","fa3aa723fe972784c661306249e6dc768b583f883e30562397e667124768803b","42c1cdae3a4b64c4bff7545e73514caee4a5d56b4561ed7cfbde17a978b85768","a85b8f28460b6570ec8f43fd05ce39150b0a858e91ff74b03bdcb6860e9d240e","7e95b3a9eaf93bbb2efc46967d2b4b18208c9012fd4b0f6d719f163f5b47000a","f8278144a6fcc3b7892730647bc09405cb40a712d7b0da8dca9fe22991e4a886","4b86175f34d65e071bb3ac46fe9064cc899d92c59f457a093b903d16e7bc0e55","fd863f8474adc39f1b91d465cdab163bb484c80daf39ca00c4d4acb85f9f5236","69a4052b56497a6cd7c5966fb65a13648a3f436442bd2127970da70c2f23517b","78385e27fdd362a7d059e3efa8b85f473ecff10595ac4db7297f23ea4bc2ff9d","01b89ed6e3b1675271d206017d7e2d8f0856dd0b8fa38dd092048339a7bca65a","ac9a2868a528c965a7484619ca855222709ae74298c383beb702565da6ae1283","77e60524cd42fabf11be5a083fd9eb167a0f9fa528e67ac9c6e46dd6d557a43d","a153b6c7525d687680dd626501d1384e48c6bd1d2f4f388ac3ad5de2bd75ac46","073f23ee37b9fe4a7291d9e6aea5c13f250ab8407cbe2c787b0d849ed88c68bf","aa9958decfe4b26067a1fbc827df6f9e3650604cefcda819f535125a604cc5dc","380e4c51963a2f66632cb5afdfb0b49e50b8e19d913d2262d18cb1fdb1319533","31d4f71c29e411b3ac23ca56b3ac5a95c8e4b5c4b751aa00761a2a2661743281","ffe8ed0d5483d9808d0929ffc583b1947f166743c4c78ea18e0925bc5d661160","cee2689830393d62ecb5679b2a79241905a438ee7ccc39f1f14ce59cdbd12b5a","6831fd830ccd462d3ad3489dd1aa0f4e53b8947b0ca80fda342e46284122fd48","5fcbeec34d35be80e3d17bccddb718b650706a3b6fda9f1e70751d17b4cdd33f","4d0758b385f54a8a6717bb3fc2a6811e33169db440c1dbd8c30385cd53f6296a"],"paragraph_range_zero_based":[53352,53375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p53352"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Identifiers that are likely to be keywords of some language, especially widely used languages, such as C++ or Java, should be avoided to the extent possible.","paragraph_zero_based":53376},{"literal_text_all_w_t_and_m_t":"-Identifiers, other than PDU identifiers, longer than 25 characters should be avoided where possible. It is recommended to use abbreviations, which should be done in a consistent manner i.e. use 'Meas' instead of 'Measurement' for all occurrences. Examples of typical abbreviations are given in table A.3.1.2.1-1 below.","paragraph_zero_based":53377},{"literal_text_all_w_t_and_m_t":"-For future extension: When an extension is introduced a suffix is added to the identifier of the concerned ASN.1 field and/or type. A suffix of the form \"rX\" is used, with X indicating the release, for ASN.1 fields or types introduced in a later release (i.e. a release later than the original/first release of the protocol) as well as for ASN.1 fields or types for which a revision is introduced in a later release replacing a previous version, e.g., Foo-r9 for the Rel-9 version of the ASN.1 type Foo. A suffix of the form \"rXb\" is used for the first revision of a field that it appears in the same release (X) as the original version of the field, \"rXc\" for a second intra-release revision and so on. A suffix of the form \"vXYZ\" is used for ASN.1 fields or types that only are an extension of a corresponding earlier field or type (see clause A.4), e.g., AnElement-v10b0 for the extension of the ASN.1 type AnElement introduced in version 10.11.0 of the specification. A number 0...9, 10, 11, etc. is used to represent the first part of the version number, indicating the release of the protocol. Lower case letters a, b, c, etc. are used to represent the second (and third) part of the version number if they are greater than 9. In the procedural specification, in field descriptions as well as in headings suffices are not used, unless there is a clear need to distinguish the extension from the original field.","paragraph_zero_based":53378},{"literal_text_all_w_t_and_m_t":"-More generally, in case there is a need to distinguish different variants of an ASN.1 field or IE, a suffix should be added at the end of the identifiers e.g. MeasObjectUTRA, ConfigCommon. When there is no particular need to distinguish the fields (e.g. because the field is included in different IEs), a common field identifier name may be used. This may be attractive e.g. in case the procedural specification is the same for the different variants.","paragraph_zero_based":53379},{"literal_text_all_w_t_and_m_t":"-It should be avoided to use field identifiers with the same name within the elements of a CHOICE, including using a CHOICE inside a SEQUENCE (to avoid certain compiler errors).","paragraph_zero_based":53380},{"literal_text_all_w_t_and_m_t":"Table A.3.1.2-1: Examples of typical abbreviations used in ASN.1 identifiers","paragraph_zero_based":53381},{"literal_text_all_w_t_and_m_t":"Abbreviation","paragraph_zero_based":53382},{"literal_text_all_w_t_and_m_t":"Abbreviated word","paragraph_zero_based":53383},{"literal_text_all_w_t_and_m_t":"Config","paragraph_zero_based":53384},{"literal_text_all_w_t_and_m_t":"Configuration","paragraph_zero_based":53385},{"literal_text_all_w_t_and_m_t":"DL","paragraph_zero_based":53386},{"literal_text_all_w_t_and_m_t":"Downlink","paragraph_zero_based":53387},{"literal_text_all_w_t_and_m_t":"Ext","paragraph_zero_based":53388},{"literal_text_all_w_t_and_m_t":"Extension","paragraph_zero_based":53389},{"literal_text_all_w_t_and_m_t":"Freq","paragraph_zero_based":53390},{"literal_text_all_w_t_and_m_t":"Frequency","paragraph_zero_based":53391},{"literal_text_all_w_t_and_m_t":"Id","paragraph_zero_based":53392},{"literal_text_all_w_t_and_m_t":"Identity","paragraph_zero_based":53393},{"literal_text_all_w_t_and_m_t":"Ind","paragraph_zero_based":53394},{"literal_text_all_w_t_and_m_t":"Indication","paragraph_zero_based":53395},{"literal_text_all_w_t_and_m_t":"Meas","paragraph_zero_based":53396},{"literal_text_all_w_t_and_m_t":"Measurement","paragraph_zero_based":53397},{"literal_text_all_w_t_and_m_t":"MIB","paragraph_zero_based":53398},{"literal_text_all_w_t_and_m_t":"MasterInformationBlock","paragraph_zero_based":53399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["13093175bb09dc1c1db0f2340643a3ff8eb57909bf061144e7c8cb4935e13060","35d8ed216ed1f4bb27c4cad23249da56c9dc622f0330f1c14a43a3865289a533","fd9aebf0984b49b49e8323c083c8ae775cce19c8dd2067bbfe9217d3406d3aef","93228816133a46d28190f9196c073645bb9318faf19358bcb31f910248765613","4d89363a98b69f8f58ba90ca10547b2243dadedeb470bde02f13e466e303d658","a3a2509bb79bb35e84a47776178c5a2bcb648be07df28bb4011402497932d05d","82d7274b44c4f9193623facc9b85862d70497d4c6db17d01d2ae426f08b36877","e17e59dcf878c5d477fdcf58c1a502c209c4d623982bdeddbb5cd7e010fac9d8","748cd6f2dafead491ee9fc2f5a86f9bb018d92fa22b06f69bba456ce1ab442ec","8be76d623eabc5656c98ba28e614bb3f0b0fe44f1fa7466d5a79f8e5109977da","2166c1cf6b0bd7200b308bb7eae175459a6de76f5faaef49c48c7adb16d3c871","645c608be81b7876116682feb075ed56c138ca934658906416a12c68c5708939","99a8b7042003685078b325d3ef13f6092eef4e049cf2483e9ddc4eb08295e61e","bbfe92268e13a75ebcddcadff25f338c670a4a3edd52c2190b33df524bf3ad58","cb39726d216ea84a01d8dcf67a2b7c5b3a5b95a6d2f9c018b187f1bc0149c88b","9cd4e38513cb9b883cbdeca2c66ffa4e786f0f7046d2f21efb3cf2ae40a6642f","0f5f9be7aef062ebb86bce9ac5bb54fd26c8b8b66cc39af04796501f6c908f0c","5c8d146d43c3201c365dbbb792390e994dcf27b4e743