2a1ac8aa7c5ad368c65551289e33a4c49aaf73278826b03130086d9457ae1dc","0ae3ab057e085828037c4c1cd4cd4e2f287cc31422c7a2ddd0b5a7b1c8ad639f","88e55654233c4fae410925d60145cf91ba376d9665257134e63fa894446772e0","d0ddc684939e98a0bb0f57e49d2d0624f8b0f31f29792f8985fc02a30bf16bff","d0dd995c92dd439d0f22639210bcb250f1b639bd45b790becb3506ffad221ce1","f0019ec160eb42e4b5bd4b3d909e048cb3af4e7ac7d069c9b5bfd31ef82c82ba","d1716177c202d5ea75d3161f28ae9bd922b791b117cd96322608683eaf7cd6b3","c53a4b81258d5c8300f044fc7e852675126f32a89772a7231abf543501982aa5","885ccc66c5b77fcf392e241380462031e5af1036c7e192239d7f767660cd4bd1"],"paragraph_range_zero_based":[43704,43727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p43704"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43728},{"literal_text_all_w_t_and_m_t":"LogMeasResultListWLAN field descriptions","paragraph_zero_based":43729},{"literal_text_all_w_t_and_m_t":"Bssid","paragraph_zero_based":43730},{"literal_text_all_w_t_and_m_t":"Basic Service Set Identifier (BSSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":43731},{"literal_text_all_w_t_and_m_t":"Hessid","paragraph_zero_based":43732},{"literal_text_all_w_t_and_m_t":"Homogenous Extended Service Set Identifier (HESSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":43733},{"literal_text_all_w_t_and_m_t":"rssiWLAN","paragraph_zero_based":43734},{"literal_text_all_w_t_and_m_t":"Measured WLAN RSSI result in dBm. The IE WLAN-RSSI-Range specifies the value range used in WLAN RSSI measurements and thresholds. Integer value for WLAN RSSI measurements is according to mapping table in TS 36.133 [40]. Value 0 corresponds to –infinity, value 1 to -100dBm, value 2 to -99dBm, and so on (i.e. in steps of 1dBm) until value 140, which corresponds to 39dBm, while value 141 corresponds to +infinity.","paragraph_zero_based":43735},{"literal_text_all_w_t_and_m_t":"rtt-WLAN","paragraph_zero_based":43736},{"literal_text_all_w_t_and_m_t":"This field provides the measured roundtrip time between the target device and WLAN AP and optionally the accuracy expressed as the standard deviation of the delay. Units for each of these are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":43737},{"literal_text_all_w_t_and_m_t":"rttValue","paragraph_zero_based":43738},{"literal_text_all_w_t_and_m_t":"This field specifies the Round Trip Time (RTT) measurement between the target device and WLAN AP in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":43739},{"literal_text_all_w_t_and_m_t":"rttUnits","paragraph_zero_based":43740},{"literal_text_all_w_t_and_m_t":"This field specifies the Units for the fields rttValue and rttAccuracy. The available Units are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":43741},{"literal_text_all_w_t_and_m_t":"rttAccuracy","paragraph_zero_based":43742},{"literal_text_all_w_t_and_m_t":"This field provides the estimated accuracy of the provided rttValue expressed as the standard deviation in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":43743},{"literal_text_all_w_t_and_m_t":"Ssid","paragraph_zero_based":43744},{"literal_text_all_w_t_and_m_t":"Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":43745},{"literal_text_all_w_t_and_m_t":"Wlan-Identifiers","paragraph_zero_based":43746},{"literal_text_all_w_t_and_m_t":"Indicates the WLAN parameters used for identification of the WLAN for which the measurement results are applicable.","paragraph_zero_based":43747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43748},{"literal_text_all_w_t_and_m_t":"–MeasConfigAppLayerId","paragraph_zero_based":43749},{"literal_text_all_w_t_and_m_t":"The IE MeasConfigAppLayerId identifies the application layer measurement.","paragraph_zero_based":43750},{"literal_text_all_w_t_and_m_t":"MeasConfigAppLayerId information element","paragraph_zero_based":43751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7cb38af99ff3d01e0821beeb9fbb8b1668197de02cf919ab5c7de171ed868e09","e088c02599586e6ce4ef12b8f1ce2d3bc6b0be81f1a6837ae33e9385eea0a402","e70bcc137e6702ea5da557cf32847062d14f86a20259a4e037d4960c