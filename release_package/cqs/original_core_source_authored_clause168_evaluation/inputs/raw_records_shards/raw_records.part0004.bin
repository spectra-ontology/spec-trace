{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22440},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22441},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22442},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":22443},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover, and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":22444},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":22445},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":22446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22447},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommonSIB","paragraph_zero_based":22448},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommonSIB provides common downlink parameters of a cell.","paragraph_zero_based":22449},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB information element","paragraph_zero_based":22450},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22451},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMONSIB-START","paragraph_zero_based":22452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22453},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommonSIB ::=     SEQUENCE {","paragraph_zero_based":22454},{"literal_text_all_w_t_and_m_t":"    frequencyInfoDL                 FrequencyInfoDL-SIB,","paragraph_zero_based":22455},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP              BWP-DownlinkCommon,","paragraph_zero_