{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release sl-L2RelayUE-Config for L2 U2N relay operation, if configured;","paragraph_zero_based":3792},{"literal_text_all_w_t_and_m_t":"1>release sl-L2RemoteUE-Config for L2 U2N relay operation, if configured;","paragraph_zero_based":3793},{"literal_text_all_w_t_and_m_t":"1>release the SRAP entity for L2 U2N relay operation, if configured;","paragraph_zero_based":3794},{"literal_text_all_w_t_and_m_t":"1>release ncr-FwdConfig, if configured;","paragraph_zero_based":3795},{"literal_text_all_w_t_and_m_t":"1>if the UE is NCR-MT:","paragraph_zero_based":3796},{"literal_text_all_w_t_and_m_t":"2>indicate to NCR-Fwd to cease forwarding;","paragraph_zero_based":3797},{"literal_text_all_w_t_and_m_t":"1>if SL indirect path is configured:","paragraph_zero_based":3798},{"literal_text_all_w_t_and_m_t":"2>release cell identity and relay UE ID configured in sl-IndirectPathAddChange;","paragraph_zero_based":3799},{"literal_text_all_w_t_and_m_t":"2>indicate upper layers to trigger PC5 unicast link release of the SL indirect path;","paragraph_zero_based":3800},{"literal_text_all_w_t_and_m_t":"1>if N3C indirect path is configured:","paragraph_zero_based":3801},{"literal_text_all_w_t_and_m_t":"2>release n3c-IndirectPathAddChange;","paragraph_zero_based":3802},{"literal_text_all_w_t_and_m_t":"2> consider the non-3GPP connection is not used;","paragraph_zero_based":3803},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as a N3C relay UE:","paragraph_zero_based":3804},{"literal_text_all_w_t_and_m_t":"2>release n3c-IndirectPathConfigRelay;","paragraph_zero_based":3805},{"literal_text_all_w_t_and_m_t":"2> consider the non-3GPP connection is not used;","paragraph_zero_based":3806},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE and MP via L2 U2N Relay UE is not configured:","paragraph_zero_based":3807},{"literal_text_all_w_t_and_m_t":"2>if the PC5-RRC connection with the U2N Relay UE is determined to be released:","paragraph_zero_based":3808},{"literal_text_all_w_t_and_m_t":"3>indicate upper layers to trigger PC5 unicast link release;","paragraph_zero_based":3809},{"literal_text_all_w_t_and_m_t":"3>perform either cell selection in accordance with the cell selection process as specified in TS 38.304 [20], or relay selection as specified in clause 5.8.15.3, or both;","paragraph_zero_based":3810},{"literal_text_all_w_t_and_m_t":"2>else (i.e., maintain the PC5 RRC connection):","paragraph_zero_based":3811},{"literal_text_all_w_t_and_m_t":"3>consider the connected L2 U2N Relay UE as suitable and perform actions as specified in clause 5.3.7.3a;","paragraph_zero_based":3812},{"literal_text_all_w_t_and_m_t":"NOTE 1:It is up to Remote UE implementation whether to release or keep the current PC5 unicast link.","paragraph_zero_based":3813},{"literal_text_all_w_t_and_m_t":"1> else:","paragraph_zero_based":3814},{"literal_text_all_w_t_and_m_t":"2>if the UE is capable of L2 U2N Remote UE:","paragraph_zero_based":3815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["729dda492fb37f5abcf4ea1fd61c97f130ef592bf7c05b9bf9b0dc14f34667bf","7f7a4d12873f5b344a81e15c3e806047ff69466ee83d2d45789060894052ab74","b74dd5fe6a5a6bc4c4cdbe4c00195a9ac6d57d06f8d3bac1d09e8c26c27b2f91","25fd12005586838b9df59d1f019debfceef63a1cfadd4588779f89a15ce9dc4f","31a5a5a3461e29cdb7a6645be8dfec748c44f3db3acb893360e7ce981a1e9b7c","b10bc0d6b155466fe807fd14dc76e357cefeda750339523a882bfede7704b762","a9ead218a7fb3226fb16d907749cb9af465ab69b34a2349c6f865b25955c0b98","ed035880cc4b3ff27cf46f5472c413c4d8fb59d49eb2e59b5989bab4591eb360","4c4db823b5654b9325fbccdab5f94aaedebf6c95c9d74ac23aac92eaad679373","56a9f2351b6556b38b75a1004b9ca4241521355cfcdbbfd0dc26ad6eee99c8c1","0165f1afe2e40aa3d5b169e9955d67f6bd21ee09ef53fbad7def6090b42efad2","261879ae85c8e9689857015e5492ad196909cdb476d380d0f42c714b4ac18f02","3e986efa54a5d020d6dd139132277c69f449f3beba697cad00adad1049710043","e01f0dca534d2003c1c8f99ab7f9f6c0c3f6b8f6dd7b264f4136956d23b0f9db","be4de94ea3db32356aca86a831aaa46a0a480733cbf68869cdbd12485cbf0022","0f2c003a4b6106d53358c94b2f7c303c6f03764271dfb48638474e44701d2f7d","7c76f90dcb2fa84030fec1cad1007d916d85a7ac7656224bf40f296a05245600","ff724bcfd2655a54372ce129a821709e8930e0cdc2eb1cdd801558f4da94d2a1","b51b83e4e92339920b70bb3644dbc314369d94af7066d59a84cee3a85fcb0e0f","d953e125aed1d01ff9900d5d28d2d73c7a01785daa652438d18a2e2ab8628225","11c1e95bfa7e88ec49bbe813b8bc683bf46eeb1468aa964f154fc0fa515e81e8","dbe46f524f4ebc7e2ae97bcf0139b4c547cb3ce229661f862c6587042baba817","001fce13482a774afe4aa824e8fd6384e05d89bcda23d095aed83d704c304d59","0ebf1ed6a7c824d3a58d1a2fe2b9724b313df5b3aa8882e4818e54f5322e89be"],"paragraph_range_zero_based":[3792,3815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p3792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>perform either cell selection as specified in TS 38.304 [20], or relay selection as specified in clause 5.8.15.3, or both;","paragraph_zero_based":3816},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":3817},{"literal_text_all_w_t_and_m_t":"3>perform cell selection in accordance with the cell selection process as specified in TS 38.304 [20].","paragraph_zero_based":3818},{"literal_text_all_w_t_and_m_t":"NOTE 2:For L2 U2N Remote UE, if both a suitable cell and a suitable relay are available, the UE can select either one based on its implementation.","paragraph_zero_based":3819},{"literal_text_all_w_t_and_m_t":"5.3.7.3Actions following cell selection while T311 is running","paragraph_zero_based":3820},{"literal_text_all_w_t_and_m_t":"Upon selecting a suitable NR cell, the UE shall:","paragraph_zero_based":3821},{"literal_text_all_w_t_and_m_t":"1>ensure having valid and up to date essential system information as specified in clause 5.2.2.2;","paragraph_zero_based":3822},{"literal_text_all_w_t_and_m_t":"1>stop timer T311;","paragraph_zero_based":3823},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":3824},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":3825},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":3826},{"literal_text_all_w_t_and_m_t":"1>stop the relay (re)selection procedure, if ongoing;","paragraph_zero_based":3827},{"literal_text_all_w_t_and_m_t":"1>if the cell selection is triggered by detecting radio link failure of the MCG or re-configuration with sync failure of the MCG or mobility from NR failure, and","paragraph_zero_based":3828},{"literal_text_all_w_t_and_m_t":"1>if attemptCondReconfig is configured; and","paragraph_zero_based":3829},{"literal_text_all_w_t_and_m_t":"1>if the selected cell is not configured with CondEventT1, or the selected cell is configured with CondEventT1 and leaving condition has not been fulfilled; and","paragraph_zero_based":3830},{"literal_text_all_w_t_and_m_t":"1>if the selected cell is one of the candidate cells for which the reconfigurationWithSync is included in the masterCellGroup in the MCG VarConditionalReconfig and the condExecutionCondPSCell is not configured for the corresponding condReconfigId in the MCG VarConditionalReconfig:","paragraph_zero_based":3831},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RLF-Report for conditional handover, set the choCellId in the VarRLF-Report to the global cell identity, if available, otherwise to the physical cell identity and carrier frequency of the selected cell;","paragraph_zero_based":3832},{"literal_text_all_w_t_and_m_t":"2>apply the stored condRRCReconfig associated to the selected cell and perform actions as specified in 5.3.5.3;","paragraph_zero_based":3833},{"literal_text_all_w_t_and_m_t":"NOTE 1:It is left to network implementation to how to avoid keystream reuse in case of CHO based recovery after a failed handover without key change.","paragraph_zero_based":3834},{"literal_text_all_w_t_and_m_t":"1>if the cell selection is triggered by detecting radio link failure of the MCG or re-configuration with sync failure of the MCG or mobility from NR failure; and","paragraph_zero_based":3835},{"literal_text_all_w_t_and_m_t":"1>if attemptLTM-Switch is configured; and","paragraph_zero_based":3836},{"literal_text_all_w_t_and_m_t":"1>if the selected cell is one of the LTM candidate cells in the LTM-Candidate IE within ltm-Config associated with the MCG:","paragraph_zero_based":3837},{"literal_text_all_w_t_and_m_t":"2>perform the LTM cell switch procedure for the selected LTM candidate cell according to the actions specified in 5.3.5.18.6;","paragraph_zero_based":3838},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case both attemptCondReconfig and attemptLTM-Switch are configured, it is left to the UE implementation which procedure to execute.","paragraph_zero_based":3839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["742f09dd608b535a22037e0f21576775f71516663c5e668fa211172060a45565","1025be4bc057efce17ec4938a4931cf784376ad017a9535ae147f63e575c2baf","0d0ba82c5b3d7f18e7479819777261de26aedfaad2aa9a7e28bca64ed4c9b73e","159a4de82b6a7afea2282d5d6261680956a5c39e0411fcfaacb4be348b77d448","83c074d180e4ecd833d3baf6b4c4c1a9b1bb55fea49901afd9fdec8262ce7237","fa875b5428219d4690e773ffa95efeade022e9f439e1fcbf29fb35507aa3bfd8","0ffb445b616268cc4cac758a24b1c4b3cfbedebed54c9c87b7f7bf92e1ab5586","44a5a7b0444fa3fb4052dc2ac4c2ff5b9fdaf89b860d77aa528dfb0748e1e7fe","627672590e298cc483db2dd498d41cea2c6752ac19ef18f283a082c87840092f","9889ccfd70c59d0e746940748ef54a42fe0904b72e5255e3d9f473c6667fdf41","8732c7c530474825089998cb92608b14ea00c899aef99eac4384e195c94cde27","616ada3cd5562e702d5fee7fd855f745dd42faf76836961d7a0406f819f7e176","1a8a856e0730c9358c65031e577d42c5f709b3d98f14ccd3832e9aade3c4196c","b346b554cd35e01b13d3e450ca3a8ea0f2003bf68ffc424c2c94b867a1ea6279","2a70dee2381431b73672792f8239db3b19e66a26405482bb379292d164be3386","c03bce5caf2ab440acd4b65961f2626210ae7ca90346d0971796090d32c4e567","9177690acb3d6e8200e68fff4cc27ae34f14995aee7c02981ed82ed3b6cc55a3","34983e60d70b166e51c78c576901d27af9a9df8c62fd27eca27177db6f05fca3","d12a34d6c6865142b8484469cd295b1b9e2169b77fd4752df1d470a5655c9654","8c4c3c21e27a0eda77d56917a67caffcfc029c92be94a4822c4d9a1e8076665c","76d35f07d10a7b3fab06744ad0b36e8455f37d252e306c467f0879c0c9a7186e","49a5cd8039a1419d9c3af09ac7a615a0a9a55f86e