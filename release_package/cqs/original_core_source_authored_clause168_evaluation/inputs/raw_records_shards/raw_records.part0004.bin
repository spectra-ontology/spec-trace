{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47161},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicatedSL-PRS-RP-List-r18 ::= SEQUENCE {","paragraph_zero_based":47162},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigDedicatedSL-PRS-RPToReleaseList-r18  SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfigIndexCG-r16","paragraph_zero_based":47163},{"literal_text_all_w_t_and_m_t":"                                                                                                               OPTIONAL, -- Need N","paragraph_zero_based":47164},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantConfigDedicatedSL-PRS-RPToAddModList-r18","paragraph_zero_based":47165},{"literal_text_all_w_t_and_m_t":"        SEQUENCE (SIZE (1..maxNrofCG-SL-r16)) OF SL-ConfiguredGrantConfigDedicatedSL-PRS-RP-r18                OPTIONAL  -- Need N","paragraph_zero_based":47166},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47167},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47168},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-STOP","paragraph_zero_based":47169},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47171},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig field descriptions","paragraph_zero_based":47172},{"literal_text_all_w_t_and_m_t":"sl-CS-RNTI","paragraph_zero_based":47173},{"literal_text_all_w_t_and_m_t":"Indicate the RNTI used to scramble CRC of DCI format 3_0, see TS 38.321 [3].","paragraph_zero_based":47174},{"literal_text_all_w_t_and_m_t":"sl-DCI-ToSL-Trans","paragraph_zero_based":47175},{"literal_text_all_w_t_and_m_t":"Indicate the time gap between DCI reception and the first sidelink transmission scheduled by the DCI (see TS 38.214 [19], clause 8.1.2.1). Value 1 included in this field corresponds to 1 slot, value 2 corresponds to 2 slots and so on, based on the numerology of sidelink BWP.","paragraph_zero_based":47176},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH","paragraph_zero_based":47177},{"literal_text_all_w_t_and_m_t":"For dynamic grant and configured grant type 2, this field configures the values (in number of slot lengths) of the PSFCH to PUCCH gap. The field PSFCH-to-HARQ_feedback timing indicator in DCI format 3_0 selects one of the configured values of the PSFCH to PUCCH gap.","paragraph_zero_based":47178},{"literal_text_all_w_t_and_m_t":"sl-RNTI","paragraph_zero_based":47179},{"literal_text_all_w_t_and_m_t":"Indicate the SL-RNTI used for monitoring the network scheduling to transmit NR sidelink communication (i.e. the mode 1).","paragraph_zero_based":47180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47181},{"literal_text_all_w_t_and_m_t":"MAC-MainConfigSL field descriptions","paragraph_zero_based":47182},{"literal_text_all_w_t_and_m_t":"sl-BSR-Config","paragraph_zero_based":47183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb68db453b3bdfb3adbc98499499b505dc4363ac479cf0eae9dd2caee076f8f5","997bd94de765cfefb5c53e399c4b3f1fe97eeaefa854895e643612a1fdd7623d","246f3692a4ba29d5ddb8bcf5203c095bbb112c1db2a0a266d3d2536f35f5ab70","cf85326c04cb50b01631fe848a52d2e509257ea1b42d4868a0267982d647e552","5df287f5e93a57a793e956572cc6dfe95f82b3d1f2216bf8d6657a086d342032","3cf8f312dc59deb4f971bd9b46c0c9d4e030079495f79f7fef8b76bbb03b0beb","74525e99b1ca6721c0e65c62537b2c46ff121d5d029e5e9dbd552dc37b56d968","031fe67801d91aad03b907896e7d4ed87a7731bed871292f4bf2d7014d19fbe5","e2bc6f91a2c0e0328e61d1ff494480068067b7985ac17dc551c4aca3c2266a50","e9932648f2b37809699acc2bc411bb648e8f6e7fef53405acf2e76fa1aa42838","1f82b4e37021c59dd14f94369ae300677d70a235de1c674e2d73b174f22c78d1","15d0b32a242b20e86e8e86bb4294339152f8834ce660d2ef0813a030042444df","da44915a6057b370a061e47d1b867d63d8477a7b69e33c5af191297742837d61","09971b2d831973018389d2ebe2fec83b383eb2e26311faf8c53954a9711b7658","e204d5b1af48bfdc95ab705ce5dba1032e65a9d331a67c8dfd854f8bbb9a991f","ac171d72767b88c184c9a8b550b2561700dada8d9d75066a771ce398a2c16a2a","6f004ffb6564b155268a252b39012ec59b252c858ed03fb27ae52d5582d461f6","3f42d65fa68f4d7903aa0a9a58fc910ca2af86808b72621eadea85af6ac062a1","aea3deaa12bfe6cd6f4997df5a328f8f104726e0ae1b4459734afa7daf861952","a4bcaf813d1a011773da2b243cf9970f0b05532987a933da199183b2404a5612","ab78783535a7854ccaa16660d34b1cdb6ac461a5a429d74a463999fc7d392bd2","920b9700a53e510ec22b36e4f04c47909a90ee5bc0d3282bbb7e43d7a1792f6a","c65b95ce79e24e8bedc89993723d8f011aa26ed4f7d7177d4959f8f529fc9f08","44b3879c0a4b983fe5a1e6f73c8f922f5da1d26566f782d383f5dfab0f3f1f60"],"paragraph_range_zero_based":[47160,47183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p47160"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is to configure the sidelink buffer status report.","paragraph_zero_based":47184},{"literal_text_all_w_t_and_m_t":"sl-PrioritizationThres","paragraph_zero_based":47185},{"literal_text_all_w_t_and_m_t":"Indicates the SL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":47186},{"literal_text_all_w_t_and_m_t":"ul-PrioritizationThres","paragraph_zero_based":47187},{"literal_text_all_w_t_and_m_t":"Indicates the UL priority threshold, which is used to determine whether SL TX is prioritized over UL TX, as specified in TS 38.321 [3]. Network does not configure the sl-PrioritizationThres and the ul-PrioritizationThres to the UE separately.","paragraph_zero_based":47188},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47189},{"literal_text_all_w_t_and_m_t":"–SL-SDAP-Config","paragraph_zero_based":47190},{"literal_text_all_w_t_and_m_t":"The IE SL-SDAP-Config is used to set the configurable SDAP parameters for a Sidelink DRB.","paragraph_zero_based":47191},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config information element","paragraph_zero_based":47192},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47193},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SDAP-CONFIG-START","paragraph_zero_based":47194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47195},{"literal_text_all_w_t_and_m_t":"SL-SDAP-Config-r16 ::=                  SEQUENCE {","paragraph_zero_based":47196},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Header-r16                      ENUMERATED {present, absent},","paragraph_zero_based":47197},{"literal_text_all_w_t_and_m_t":"    sl-DefaultRB-r16                        BOOLEAN,","paragraph_zero_based":47198},{"literal_text_all_w_t_and_m_t":"    sl-MappedQoS-Flows-r16                  CHOICE {","paragraph_zero_based":47199},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsList-r16              SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16,","paragraph_zero_based":47200},{"literal_text_all_w_t_and_m_t":"        sl-MappedQoS-FlowsListDedicated-r16     SL-MappedQoS-FlowsListDedicated-r16","paragraph_zero_based":47201},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,   -- Need M","paragraph_zero_based":47202},{"literal_text_all_w_t_and_m_t":"    sl-CastType-r16                        ENUMERATED {broadcast, groupcast, unicast, spare1}                   OPTIONAL,   -- Need M","paragraph_zero_based":47203},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47204},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47206},{"literal_text_all_w_t_and_m_t":"SL-MappedQoS-FlowsListDedicated-r16 ::= SEQUENCE {","paragraph_zero_based":47207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["797dcb8c2d90a3edc83bab4e7a192da78ea552458a58d720d38344475a5a22de","adc1f028d24598907fd001ddc7083347bc455077e7eda19034f6f22c0b0794cb","192ec5074340a028f406de8bf91bc5852fff785156d2661598d8b16f21eaa095","93a65e4b3d50fc9ed3e9ccdf13f891a0d6b031ae400c630284fd77bffe93a06d","3cde3f18581d1defde8cde282ae06b5769edc7f45b592bb5c5d4c25ccbddf5b5","ab8ef6f764dd16ae40c707618a07b434749c660ec3450f5cda89fb5a6c907257","b1c4b35762e84e395d29236