{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40008},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorEUTRA ::=  INTEGER (1..maxBandsEUTRA)","paragraph_zero_based":40009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40010},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATOREUTRA-STOP","paragraph_zero_based":40011},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40013},{"literal_text_all_w_t_and_m_t":"–FreqBandList","paragraph_zero_based":40014},{"literal_text_all_w_t_and_m_t":"The IE FreqBandList is used by the network to request NR CA, NR non-CA and/or MR-DC band combinations for specific NR and/or E-UTRA frequency bands and/or up to a specific number of carriers and/or up to specific aggregated bandwidth. This is also used to request feature sets (for NR) and feature set combinations (for NR and MR-DC). For NR sidelink communication, this is used by the initiating UE to request sidelink UE radio access capabilities from the peer UE. This is also used to request lower MSD capability for specific NR frequency bands for the UE supporting lower MSD.","paragraph_zero_based":40015},{"literal_text_all_w_t_and_m_t":"FreqBandList information element","paragraph_zero_based":40016},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40017},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDLIST-START","paragraph_zero_based":40018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40019},{"literal_text_all_w_t_and_m_t":"FreqBandList ::=                SEQUENCE (SIZE (1..maxBandsMRDC)) OF FreqBandInformation","paragraph_zero_based":40020},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40021},{"literal_text_all_w_t_and_m_t":"FreqBandInformation ::=         CHOICE {","paragraph_zero_based":40022},{"literal_text_all_w_t_and_m_t":"    bandInformationEUTRA            FreqBandInformationEUTRA,","paragraph_zero_based":40023},{"literal_text_all_w_t_and_m_t":"    bandInformationNR               FreqBandInformationNR","paragraph_zero_based":40024},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":40025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40026},{"literal_text_all_w_t_and_m_t":"FreqBandInformationEUTRA ::=    SEQUENCE {","paragraph_zero_based":40027},{"literal_text_all_w_t_and_m_t":"    bandEUTRA                       FreqBandIndicatorEUTRA,","paragraph_zero_based":40028},{"literal_text_all_w_t_and_m_t":"    ca-BandwidthClassDL-EUTRA       CA-BandwidthClassEUTRA                  OPTIONAL,   -- Need N","paragraph_zero_based":40029},{"literal_text_all_w_t_and_m_t":"    ca-BandwidthClassUL-EUTRA       CA-BandwidthClassEUTRA                  OPTIONAL    -- Need N","paragraph_zero_based":40030},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":40031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d99b8b135675aba2ff56da30414e95c94a660d7a47137f91496ceb182b5ee618","d51371e810add0fb7867befdaff6d3492970080342025a02c28d202e7c64e0d8","396ca53c792147508dded5ed83e4f97488791117ab73be4134d757c464329c22","14b6c78b080d96f7277640bb60d51af9327bf2ae845bc5a8447a7965ca4d0f91","fd1626ee48674d7629b2e361ce15c6ae4612ad6c9df46e60a99e82e970d354a7","49a7724565ba448990d6b9f739e8037528c35111a3771a5f84f5f4e6b69aea58","48fa34ee639f0db60dd455480bd40a32f9d1b57c2904c03e27019c4572b4d599","e4853159e6cf4e1a2d45f01915f2ebacf91f426894db4288ab5943525bc3bce4","f870c5b2f74d7a08b281c9e7d230b640772f164e6ed993dc9c89c8b22b33fab1","2a3