agraph_zero_based":27356},{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndexList","paragraph_zero_based":27357},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndexList concerns a list of indexes of physical cell id ranges, which may be used for different purposes.","paragraph_zero_based":27358},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndexList information element","paragraph_zero_based":27359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6673a3e8548912688d36ad45318bd4e04a40f50a8781d55c630bc4d51f17b868","c89c25abc1acc301ca5f06b5b37104b8624385d834a39cafebc9f421b2577102","c9fccaf7a10e25e3a42fce90e15af9cd4fdce26fafefa111ea608aa5c1de74aa","5cd29dcaa5dfe14731742210a2fa8e330f7158ea6b5e5a76567c96d1bea93788","d34760cdaac46c478c5b34e89a171d02442383150ab9f1a1129b2e09f6e263f6","4c7a09a1585060b44c8bc3df959a120dfd0c3a8d73fa9340244f01c71e6de1d0","3d8b7bcd5852f3358f701f6f563759270521f2eb9369dba5914dd535fed6df8b","6d28384ef3171925244c631920cec9f6a004c2acd40af0f442317d89ad115171","22b1c834ba700196e6362571887038140e4ef407f50e32e529c7dc9eb008dbc6","28d1dd623f4098861143bcd283253c492f127074c5864ab85e61fe4f2f2b3538","826964ce0847b2d40184023382312350eb392ee6e599ba4eef7bcd734733c605","d475f157db42b51956d651a2a3970bcf78ad2c7873ec0d13368a200d0e20fa87","0522b7325bd3256823f5a9ced18b435165bbca1c91b4e48294b399895afbbcd0","5ddc029e121a792fed3c5a9e4a53f1a40ba73a3909345ba3730c37d8ffd23245","2714c2e82549b9c79572652042636e72fc6bf5948139deb88cec68ae290aad0b","17aa5d2c2d385577dd50443914cf04f1cfc11986669cf40d8bcfbc9a29f4be26","046ca83c70e4ce8f9bbe42ee5ae3a4d6bec12283f5d96320e1f7684d3df4dab2","b5bc694dd1f05c66f15ea4cb204c93222d7d8543f2899c66c941ef96dad113dc","abfccc7d260da493f1726ebed39e0942b827f757