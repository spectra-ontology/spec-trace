{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the PDCP parameters for the sidelink DRB.","paragraph_zero_based":46320},{"literal_text_all_w_t_and_m_t":"sl-SDAP-Config","paragraph_zero_based":46321},{"literal_text_all_w_t_and_m_t":"This field indicates how to map sidelink QoS flows to sidelink DRB.","paragraph_zero_based":46322},{"literal_text_all_w_t_and_m_t":"slrb-Uu-ConfigIndex","paragraph_zero_based":46323},{"literal_text_all_w_t_and_m_t":"This field indicates the index of sidelink DRB configuration.","paragraph_zero_based":46324},{"literal_text_all_w_t_and_m_t":"sl-TransRange","paragraph_zero_based":46325},{"literal_text_all_w_t_and_m_t":"This field indicates the transmission range of the sidelink DRB. The unit is meter.","paragraph_zero_based":46326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46327},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46328},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46329},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":46330},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":46331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46332},{"literal_text_all_w_t_and_m_t":"–SL-RBSetConfig","paragraph_zero_based":46333},{"literal_text_all_w_t_and_m_t":"The IE SL-RBSetConfig specifies the configuration information for RB set for NR Sidelink Communication.","paragraph_zero_based":46334},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig information element","paragraph_zero_based":46335},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46336},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RBSETCONFIG-START","paragraph_zero_based":46337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46338},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig-r18 ::=             SEQUENCE {","paragraph_zero_based":46339},{"literal_text_all_w_t_and_m_t":"    sl-RBSetIndex-r18                  INTEGER (0..4),","paragraph_zero_based":46340},{"literal_text_all_w_t_and_m_t":"    sl-NumOfSSSBRepetition-r18         INTEGER (2..9)                          OPTIONAL,     -- Need M","paragraph_zero_based":46341},{"literal_text_all_w_t_and_m_t":"    sl-GapBetweenSSSBRepetition-r18    INTEGER (1..84)                         OPTIONAL      -- Need M","paragraph_zero_based":46342},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["01f6d176cd0b619380957b6f5941f53a4c909bb53c91d7f36d00e80aefdb5897","a45a23aaf60928e2ffeeeb8f92d90cfcef1a0f0f8e58d93a637c0e68a7a9d283","9b97a15288919cf30976f640bcc95877b3421a0fc18bce6982c1c80b778dce36","b5e82f73f8e8d4d68430f34eb765a6d73c5e49316ec2aba763a4aa76abb74077","fd84f58eb66705e77530ec0270570482d32fdebebe42f3f7ef6c534efcb888c1","8284d40b2b18a326255c0c503dd344ae87755e988697085e9e3fa308ff6f5c41","552a64ccd95c186d58b487497b51a8b74137cd590ae02a13138b21dcbd7764c4","57c7cf92ca0a3d1b7693b19c57ac8e18324d4b73142def59e4b76499e547fa48","916fa2bf69a460a8ee27c661ac57d831f22ea9bb93ad6ae0343bed03b82a5ea1","fb4ee667b25e1077410c94f0c321f432b71233ba7f1c7ba88233e37d18dfdefa","803f6eadaf9415300ca88ee1c3c6a50eb9b4d172eb120302120f3652f1c5fd72","c2e064b21a8eee87e4c28c6d62451c14a2f13d92a6d7f94c45b09410f917e2e3","87ae6bc281b04b28ffb7d78b87007f307236d6152dcd9a10f