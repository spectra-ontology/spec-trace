1a013214325221a234d7e7f2bb29798b2ddfab6be86","ca0e3774e58ab22b362b4c21219b2a3f1f35f0fce8e82e511d969569d95155c5","46d78f614cae257ffc811a73cf03ceac63cbbfbdb741eccd44d05e4831cce2c7","9fd10f3f8f62862d48c251a8f528c6ca849889741433fb4334d67c23d5504fe0","08159c4c83c9d214ae1794439f682d1354680666b2f0b81cdaec6a3efa5c5468","eb69a9faf71bf5d1429bfb61e0d88488a9ce5f906428fe818d40dfa49fb36a61","a213853dcae4ccd06bb86941efbf5c783bab53b9ca871876f635be975199fb6d","163c9dcce334bc594769461289c9557bf1569f60f98e3c845228c37f29788839","3337caa76e4cfdf9bbdc98f7436370200429c2abe3164ce6f70a75cf95216227","d16a15b736f794daca93348a733f41de762701283ecf9623d86ff3a801c358b6"],"paragraph_range_zero_based":[624,647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p624"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-PRU-LocationInfo","paragraph_zero_based":648},{"literal_text_all_w_t_and_m_t":"This field provides the location coordinates of the PRU.","paragraph_zero_based":649},{"literal_text_all_w_t_and_m_t":"nr-PRU-DL-TDOA-MeasInfo","paragraph_zero_based":650},{"literal_text_all_w_t_and_m_t":"This field specifies the list of carrier phase measurement RSCPD together with the other measurement information in DL-TDOA by the PRU.","paragraph_zero_based":651},{"literal_text_all_w_t_and_m_t":"nr-PRU-DL-AoD-MeasInfo","paragraph_zero_based":652},{"literal_text_all_w_t_and_m_t":"This field specifies the list of other measurement information in DL-AoD by the PRU.","paragraph_zero_based":653},{"literal_text_all_w_t_and_m_t":"nr-PRU-RSCP-MeasInfo","paragraph_zero_based":654},{"literal_text_all_w_t_and_m_t":"This field specifies the list of carrier phase measurement RSCP measured by the PRU, together with DL-PRS RSRP, and/or DL-PRS RSRPP measurement(s) associated with the RSCP measurements.","paragraph_zero_based":655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":656},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":657},{"literal_text_all_w_t_and_m_t":"–NR-TRP-LocationInfo","paragraph_zero_based":658},{"literal_text_all_w_t_and_m_t":"The IE NR-TRP-LocationInfo is used by the location server to provide the coordinates of TRPs and coordinates of the antenna reference points for a set of TRPs together with integrity information. For each TRP, the ARP location can be provided for each associated DL-PRS Resource ID per DL-PRS Resource Set.","paragraph_zero_based":659},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":661},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfo-r16 ::= SEQUENCE (SIZE (1..nrMaxFreqLayers-r16)) OF","paragraph_zero_based":662},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfoPerFreqLayer-r16","paragraph_zero_based":663},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":664},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfoPerFreqLayer-r16 ::= SEQUENCE {","paragraph_zero_based":665},{"literal_text_all_w_t_and_m_t":"referencePoint-r16ReferencePoint-r16OPTIONAL,-- Cond NotSameAsPrev","paragraph_zero_based":666},{"literal_text_all_w_t_and_m_t":"trp-LocationInfoList-r16SEQUENCE (SIZE (1..nrMaxTRPsPerFreq-r16)) OF","paragraph_zero_based":667},{"literal_text_all_w_t_and_m_t":"TRP-LocationInfoElement-r16,","paragraph_zero_based":668},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":669},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["a90b644e7281e7b9e0c01305d77cbf813e2e82740c2077daa6fc962ec98a56eb","5548c32a4325f0e9de2b2c4d6b8a5707c2e1795382228f88c98f72f403fcabec","d93ce5d6242d8a1614ca162c438f8520d4eac4b2564b6f5eb278c11f17c85906","13eb3b3f90c58941ad50ba4429449c7c954de8169b341cb06fd261aea6ae6ef4","ba18546f428ee1a6f0cb89bd0ec3ea0f2416caf8ebd8a930e84e2104795b93b4","ecb105a7241ab0c1a65d193f30bb175c6eff030f8c43a0c5205fdbaa3bb02a5d","5abac3d72545b88fa7c7629ca8e9133a43420c38ca05496ac2ecb4a8c90e143c","dc58dbe5973122e557282dcc8751994fc0e131ec3780e2220a43bacf2d0b0505","f00a1239cf6af02dc0a1d442a3cacbc624b31694f5979d43430e376bdf425713","9aaed0b770d85ef630e3b7c7d5f7dba81501cf6e259ac8b6c423eb39cee2898a","8ffdf74a292b941c6e2f25364743aad1e85ff4d0a6d6952d54afe4f48e7f8e1f","049f603074