{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo field descriptions","paragraph_zero_based":25704},{"literal_text_all_w_t_and_m_t":"musim-GapLength","paragraph_zero_based":25705},{"literal_text_all_w_t_and_m_t":"Indicates the length of the UE's MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for both periodic gap and aperiodic gap preference indication.","paragraph_zero_based":25706},{"literal_text_all_w_t_and_m_t":"musim-GapRepetitionAndOffset","paragraph_zero_based":25707},{"literal_text_all_w_t_and_m_t":"Indicates the gap repetition period in ms and gap offset in number of subframes for the periodic MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for the periodic MUSIM gap preference indication.","paragraph_zero_based":25708},{"literal_text_all_w_t_and_m_t":"musim-Starting-SFN-AndSubframe","paragraph_zero_based":25709},{"literal_text_all_w_t_and_m_t":"Indicates gap starting position for the aperiodic MUSIM gap. This field is optionally present for the aperiodic MUSIM gap preference indication.","paragraph_zero_based":25710},{"literal_text_all_w_t_and_m_t":"starting-SFN","paragraph_zero_based":25711},{"literal_text_all_w_t_and_m_t":"Indicates gap starting SFN number for the aperiodic MUSIM gap.","paragraph_zero_based":25712},{"literal_text_all_w_t_and_m_t":"startingSubframe","paragraph_zero_based":25713},{"literal_text_all_w_t_and_m_t":"Indicates gap starting subframe number for the aperiodic MUSIM gap.","paragraph_zero_based":25714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25715},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25716},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25717},{"literal_text_all_w_t_and_m_t":"aperiodic","paragraph_zero_based":25718},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of aperiodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":25719},{"literal_text_all_w_t_and_m_t":"gapSetup","paragraph_zero_based":25720},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new MUSIM gap. The field is optionally present, Need M, otherwise.","paragraph_zero_based":25721},{"literal_text_all_w_t_and_m_t":"periodic","paragraph_zero_based":25722},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of periodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":25723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25724},{"literal_text_all_w_t_and_m_t":"–N3C-IndirectPathConfigRelay","paragraph_zero_based":25725},{"literal_text_all_w_t_and_m_t":"The IE N3C-IndirectPathConfigRelay indicates the N3C indirect path related configuration used by N3C relay UE in MP.","paragraph_zero_based":25726},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay information element","paragraph_zero_based":25727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4aae4273f767a58edc125c744d9a40be993d1f61fc91a5a2eaa560f1e3013dd4","d27eae39b66d0c2923c13df82e0b7d13386b69f96b9e7a2594672c826b627bf0","8335f1edc309c27a2c95c541e84fd24b7721c1b59f819fd6ffebef96e30e26b2","fa250585273744f7746fa0b5ffebc70a7268d34fed37cdadb49fe87de95cfb20","5167c8f40e67ae4bfcf25f28cd36480916571f6fb18737bbda71d753f6604220","134bf40c93f4231bd317dfb9d0f42e47f9dc0f47e559d6bc2aac327455dea514","5e47f71a664ea91cee7d1a55045d1af63cd5b5ed95c028c4e8db32596a21b966","8c6f29668d0bbfa94473d071ed8a0f3441478b5a2c4b938e69c0a132af3954ce","7116051