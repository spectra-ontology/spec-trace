{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19824},{"literal_text_all_w_t_and_m_t":"CellGroupId ::=                             INTEGER (0.. maxSecondaryCellGroups)","paragraph_zero_based":19825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19826},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPID-STOP","paragraph_zero_based":19827},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19829},{"literal_text_all_w_t_and_m_t":"–CellIdentity","paragraph_zero_based":19830},{"literal_text_all_w_t_and_m_t":"The IE CellIdentity is used to unambiguously identify a cell within a PLMN/SNPN.","paragraph_zero_based":19831},{"literal_text_all_w_t_and_m_t":"CellIdentity information element","paragraph_zero_based":19832},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19833},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-START","paragraph_zero_based":19834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19835},{"literal_text_all_w_t_and_m_t":"CellIdentity ::=                         BIT STRING (SIZE (36))","paragraph_zero_based":19836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19837},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLIDENTITY-STOP","paragraph_zero_based":19838},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19840},{"literal_text_all_w_t_and_m_t":"–CellReselectionPriority","paragraph_zero_based":19841},{"literal_text_all_w_t_and_m_t":"The IE CellReselectionPriority concerns the absolute priority of the concerned carrier frequency, as used by the cell reselection procedure. Corresponds to parameter \"priority\" in TS 38.304 [20]. Value 0 means lowest priority. The UE behaviour for the case the field is absent, if applicable, is specified in TS 38.304 [20].","paragraph_zero_based":19842},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority information element","paragraph_zero_based":19843},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19844},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-START","paragraph_zero_based":19845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19846},{"literal_text_all_w_t_and_m_t":"CellReselectionPriority ::=             INTEGER (0..7)","paragraph_zero_based":19847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2ff08dd5c881ca24235d8fcfff4ba27abd42216759885e02ff8dfb452b521f3a","2e5dc876026968b77bccf3235865ea7c7f2cf8a528f21658ff691729ace583f0","1a806b866efc05cfc37b43fdffc0dcad00769f2c339b49ee6c9eec1f04bd65c0","efeee8c2bd6b62fbe96391716ad3324389624a17dbfdb9544a34946842715e51","9f1b9827aa2d2b9affa8a19671b08b83b1b68fd0a41fb37739171dec95b7688f","509a2d4de4cdabcb6d733d25ee1dc304516a2bd380db4497a2c4baef07100d12","5592cac0779a19c41e94fe7d1790ddac42104ad7f1c22544584f0293a5f9ffb4","b65d37764672fd0d99b57f30ae76f27d402dab76a60d9878e3773612f30fd3e8","6ccbb596270a33a437a5caf496cdc4fc3ff2a2081d617d02631e7771ce46a5d1","88818cda63501a984195d15dc6b5a3ac29643889229d684c9d95f262cb30aafb","a64a4adf68a5ec3225b0960ff440cc68b084c3773b5cd4c3812be00dc425a366","b9774f463fffdfebdae2459b15c63ceaa2eb96910b3dcdaae99dec9d678fc585","0777233c4434662df6a088f89e52ba5fe76b313098ab67b73c40bdbf226c7b61","9beabfeb4c9e26032a32622d79439e03fd8601a62237ff5dfd0e80d2dff5da34","f601ee5587d30056a8063f6d941e13f6659d4615a60a852f1b484f20d2aee729","06573f4710902e6859333e4fcb55bebf8ecec