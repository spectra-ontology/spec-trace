{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33912},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-START","paragraph_zero_based":33913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33914},{"literal_text_all_w_t_and_m_t":"SK-Counter ::=  INTEGER (0..65535)","paragraph_zero_based":33915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33916},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-STOP","paragraph_zero_based":33917},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33919},{"literal_text_all_w_t_and_m_t":"–SlotFormatCombinationsPerCell","paragraph_zero_based":33920},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatCombinationsPerCell is used to configure the SlotFormatCombinations applicable for one serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":33921},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell information element","paragraph_zero_based":33922},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33923},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-START","paragraph_zero_based":33924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33925},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell ::=   SEQUENCE {","paragraph_zero_based":33926},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":33927},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":33928},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing2                  SubcarrierSpacing                                                         OPTIONAL, -- Need R","paragraph_zero_based":33929},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinations              SEQUENCE (SIZE (1..maxNrofSlotFormatCombinationsPerSet)) OF SlotFormatCombination","paragraph_zero_based":33930},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need M","paragraph_zero_based":33931},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER(0..maxSFI-DCI-PayloadSize-1)                                      OPTIONAL, -- Need M","paragraph_zero_based":33932},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":33933},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33934},{"literal_text_all_w_t_and_m_t":"    enableConfiguredUL-r16              ENUMERATED {enabled}                                                      OPTIONAL  -- Need R","paragraph_zero_based":33935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cb208e389affb939fe420d8c861310533c4a42a7cafb55c3c0494cfea8b1add9","bfc2cbe60ddc44b9f161b318eaa1ab026f78528fd7ee87fd9b6bd5d115e068d9","799a7054f9ec807734d53e12cb5caf1f702c3bbe0e271d968199ef5cffc70b5c","33114f0afbe0fd55a8bf022c2dd05e7051344f26fad234ac1e8860c85b44f21a","738775cfa51c8cf4f682595f7acc4031d768106cadcb0dfe567e2ebf6196ee67","bc92bea794c273f7c0b224fd87c91e920acb284e2e5cf0006efef186f02342f4","22d2a4a7cf43fac342b3c360a701f38548386c8a61a1b5e0f4ead7e8106577e7","4795e0e15919d68d922def5f0046a0da53d49eba3614516517db7d0d0e8ba1cd","47206cade816185164980ea8f3d51b89d9932a33dd67464eaf35f0c7c4797764","4c082f3fd0b96c48ba9ce66f802483b66ec485082351008598276ef696e64361","2924d3274efb3e517df3ecd984a1f5972889fba2c7e32d3d3f228c