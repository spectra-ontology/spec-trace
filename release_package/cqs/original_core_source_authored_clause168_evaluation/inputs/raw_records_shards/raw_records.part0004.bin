{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T346e (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":49560},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with minSchedulingOffsetPreference.","paragraph_zero_based":49561},{"literal_text_all_w_t_and_m_t":"Upon releasing minSchedulingOffsetPreferenceConfig during the connection re-establishment/resume procedures, upon receiving minSchedulingOffsetPreferenceConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":49562},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":49563},{"literal_text_all_w_t_and_m_t":"T346f","paragraph_zero_based":49564},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with releasePreference.","paragraph_zero_based":49565},{"literal_text_all_w_t_and_m_t":"Upon releasing releasePreferenceConfig during the connection re-establishment/resume procedures, or upon receiving releasePreferenceConfig set to release.","paragraph_zero_based":49566},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":49567},{"literal_text_all_w_t_and_m_t":"T346g","paragraph_zero_based":49568},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-PreferredRRC-State.","paragraph_zero_based":49569},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease, or upon receiving musim-LeaveAssistanceConfig set to release.","paragraph_zero_based":49570},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.8.6.","paragraph_zero_based":49571},{"literal_text_all_w_t_and_m_t":"T346h","paragraph_zero_based":49572},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with musim-GapPreferenceList or musim-GapPriorityPreferenceList Information.","paragraph_zero_based":49573},{"literal_text_all_w_t_and_m_t":"Upon releasing musim-GapAssistanceConfig during the connection re-establishment/resume procedures, or upon receiving musim-GapAssistanceConfig set to release.","paragraph_zero_based":49574},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":49575},{"literal_text_all_w_t_and_m_t":"T346i","paragraph_zero_based":49576},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with scg-DeactivationPreference","paragraph_zero_based":49577},{"literal_text_all_w_t_and_m_t":"Upon releasing scg-DeactivationPreferenceConfig during RRC connection re-establishment/resume or upon receiving scg-DeactivationPreferenceConfig set to release.","paragraph_zero_based":49578},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":49579},{"literal_text_all_w_t_and_m_t":"T346j (The UE maintains one instance of this timer per cell group)","paragraph_zero_based":49580},{"literal_text_all_w_t_and_m_t":"Upon transmitting UEAssistanceInformation message with rlm-RelaxationReportingConfig.","paragraph_zero_based":49581},{"literal_text_all_w_t_and_m_t":"Upon releasing rlm-RelaxationReportingConfig during the connection re-establishment/resume procedures, upon receiving rlm-RelaxationReportingConfig set to release, or upon performing MR-DC release.","paragraph_zero_based":49582},{"literal_text_all_w_t_and_m_t":"No action.","paragraph_zero_based":49583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1410522f421a9e34b7d408efc79e2983a839b075505b5d00fda934b5fddb88d7","4a40a37ae3e939cac679e26bee586974faae413f2ff9cc8767b5c3332c99fe01","065dea79ae6f0cf62d269da46d19b9ddbdbc31ab3c620ac16e1fe99bfc3