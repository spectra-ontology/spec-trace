{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    bandEUTRA-r17                      FreqBandIndicatorEUTRA,","paragraph_zero_based":26160},{"literal_text_all_w_t_and_m_t":"    gapIndication-r17                  ENUMERATED {gap, ncsg, nogap-noncsg}","paragraph_zero_based":26161},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26163},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-STOP","paragraph_zero_based":26164},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26166},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA field descriptions","paragraph_zero_based":26167},{"literal_text_all_w_t_and_m_t":"needForNCSG-EUTRA","paragraph_zero_based":26168},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for E-UTRA measurement.","paragraph_zero_based":26169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26170},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA field descriptions","paragraph_zero_based":26171},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":26172},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA target band to be measured.","paragraph_zero_based":26173},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":26174},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform measurements on the concerned EUTRA target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration message or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that NCSG is needed, value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26176},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-InfoNR","paragraph_zero_based":26177},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-InfoNR indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":26178},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR information element","paragraph_zero_based":26179},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26180},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-START","paragraph_zero_based":26181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26182},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR-r17 ::=     SEQUENCE {","paragraph_zero_based":26183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2cf7c3982339ddc7a6fc317a494e6706c67bdb368ae8fdd0371fc142ac95ca66","c9cfa06d5c4b7f29695e45d9599dd47acd1faca50a6c7d7f6d8e3ac5fe19113c","1b45e174a3a1973d595bc2af92dc2407798433aa5bc30f28897ceded67caed39","71204a815b3c16511fc8859ad644b0a4c8c3fba27a22bab9a77e84d8e59ee530","e1d610037070e447de9c3f612d4695e410abaa5ac2c489e1cb34bd475905a447","e5ece48f16792a7c305e49a969b2a6ef88149f58fd62c90ca8efbd0df48b787f","a75988ab18f98a59b223466638082eb74fb8fc95fd60dbba9708767e118895b1","1374f1f267e8e55e0c60f1612a9b77260fe7643672d32fce3100f6f9d1ebabac","cb0fadbe8d8e80ab0e75f3a6f5e97198c936c98f7c2060682f18bfa93f85cc63","2