d908f33d1bc779ce493ad9af99b4f55","054e73cae9863efaf60e8715775da96fd03db99cee6117781f55d6b7c7048b2a","2931d01d2cf4aad9d3b952478dcf96cf47b2034f7e912ba7016bd70cb742d59a","a52e71b2d266c8e0bfad6c6e7ffad719d1ffa0e284895f9ebc1229e95044f85b","528dba718bde61a04b20a90a61b78ae3df25ba274064290e5f069ad34274670a","8a2c5c2534f64f5dd9109b1fc97a1b1771ffaa7adb57599b00f508b9637de68e","8cb9a69349c75b5baa0c34d58f75ec3c39f20c2761cb990c44d63cfc5ffe68fb","ae25d707ebc93f87174def057d412c5f071b31b9f15d2bec0bc944b8f25aeff2","666a226209dc15a5f2a091b207dcecc1dd6d25c8369660957a227944f3bd122a","e045b4074727a4b415c7ca3a543c3a41a849f5fcbf7ac1c4f641fdc80c1ebae2","50be12315e0b418ba220fe83916c97654a5cc135add0d272e0d4f88e1c9318e8","c439e8bcdda404851695ec5bbf07e15ce63877c841dc40128c7ec8580826c5b2"],"paragraph_range_zero_based":[44496,44519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44496"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolConfig-r16 ::=    SEQUENCE {","paragraph_zero_based":44520},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePoolID-r16            SL-ResourcePoolID-r16,","paragraph_zero_based":44521},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePool-r16              SL-ResourcePool-r16                                                  OPTIONAL    -- Need M","paragraph_zero_based":44522},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44524},{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolID-r16 ::=        INTEGER (1..maxNrofPoolID-r16)","paragraph_zero_based":44525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44526},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-STOP","paragraph_zero_based":44527},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44529},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig field descriptions","paragraph_zero_based":44530},{"literal_text_all_w_t_and_m_t":"sl-RxPool","paragraph_zero_based":44531},{"literal_text_all_w_t_and_m_t":"Indicates the receiving resource pool on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SL-ResourcePool entries is considered to be newly created.","paragraph_zero_based":44532},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":44533},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":44534},{"literal_text_all_w_t_and_m_t":"sl-TxPoolScheduling","paragraph_zero_based":44535},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":44536},{"literal_text_all_w_t_and_m_t":"sl-TxPoolSelectedNormal","paragraph_zero_based":44537},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission by UE autonomous resource selection on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":44538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44539},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44540},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44541},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":44542},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":44543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2030ae3593138e475d584a06bcb1c31068e1d6a673e71b63430ee3da7b828772","7b1ba34ad5504726e582434bde534a12b4b2d5fded0e0d48feb5a47d5602cedd","6f8631db66c6beff76a3e9a499e637e5050717ddb155d74173a0a240da596b95","113c44d9698b32cbe59bbd408a5361c8d6c373820586a51afb3c64cde434677f","3f