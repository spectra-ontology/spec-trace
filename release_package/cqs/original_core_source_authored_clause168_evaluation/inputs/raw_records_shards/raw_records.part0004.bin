{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36457},{"literal_text_all_w_t_and_m_t":"-- TAG-UU-RELAYRLC-CHANNELCONFIG-STOP","paragraph_zero_based":36458},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36460},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig field descriptions","paragraph_zero_based":36461},{"literal_text_all_w_t_and_m_t":"uu-LogicalChannelIdentity","paragraph_zero_based":36462},{"literal_text_all_w_t_and_m_t":"Indicates the logical channel id for Uu Relay RLC channel of the L2 U2N Relay UE.","paragraph_zero_based":36463},{"literal_text_all_w_t_and_m_t":"uu-RelayRLC-ChannelID","paragraph_zero_based":36464},{"literal_text_all_w_t_and_m_t":"Indicates the Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":36465},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":36466},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established.","paragraph_zero_based":36467},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":36468},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":36469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36470},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36471},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36472},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":36473},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":36474},{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":36475},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":36476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36477},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelID","paragraph_zero_based":36478},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelID is used to identify a Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":36479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["98e82de32b96ea8bbfeb17f0c6b9bde0d1245c120190f068237903e8805645b5","5d1219c657398a1f5c28e4c000654ad4df8e033fe3eaa574c0dfe4369cac9d30","493400dd90495ae40227c14ba18cdda87e790f5b70113f2545424effbb05c5b5","e30095c0a84a0998d3325b5f72a16c585438dc2d2a7a4238cc90a96e038a633e","bd9c9fd775c5ddecc4f1bdb4f473345989bb855aa77945c48ca34375560dc2a4","3b1432172228b190bdb6e974ee445e09462381394866cb4c340877b113f90377","5d1f34adecfaec3d1876abb1f0c48ccfb6610023d137e4dfaa30f845f04fc887","6990a4b3f5365bcac34e8972c5ed075eca862dadda326860517a723e044ddcaf","3216bde2f61f21951cf7c14c04981b323ec193c6881256e68799febb6c3756a2","27a32ce7ea41d3d4c1953e59f75115fc37b63834a827de85940967ac7bcafa04","b2fde8031067d41ecf2c190945916babd829043bc9d48fcdbbf53c402ec04ce8","c2cc5966b70baac47ad8ff2e3fd56ce57b9fb31ebd0e8da88e5639142c952c5a","c48ee1dcea6101240fc81a42ab828c5cd1fbdc8be421dda8186bb7df85c99577","be1d9e2125f8991198910ddab944f6d598fc8052dd0b18b6c9ce391b225c37e3","9b1f7644580ab99f0a1a6db66d3ab586b533d0e32395a6d561af13444694b