{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a BH RLC channel. It is absent, Need M otherwise.","paragraph_zero_based":18624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18625},{"literal_text_all_w_t_and_m_t":"–BH-RLC-ChannelID","paragraph_zero_based":18626},{"literal_text_all_w_t_and_m_t":"The IE BH-RLC-ChannelID is used to identify a BH RLC channel in the link between IAB-MT of the IAB-node and IAB-DU of the parent IAB-node or IAB-donor-DU.","paragraph_zero_based":18627},{"literal_text_all_w_t_and_m_t":"BH-RLC-ChannelID information element","paragraph_zero_based":18628},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18629},{"literal_text_all_w_t_and_m_t":"-- TAG-BHRLCCHANNELID-START","paragraph_zero_based":18630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18631},{"literal_text_all_w_t_and_m_t":"BH-RLC-ChannelID-r16 ::=    BIT STRING (SIZE (16))","paragraph_zero_based":18632},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18633},{"literal_text_all_w_t_and_m_t":"-- TAG-BHRLCCHANNELID-STOP","paragraph_zero_based":18634},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18636},{"literal_text_all_w_t_and_m_t":"–BSR-Config","paragraph_zero_based":18637},{"literal_text_all_w_t_and_m_t":"The IE BSR-Config is used to configure buffer status reporting.","paragraph_zero_based":18638},{"literal_text_all_w_t_and_m_t":"BSR-Config information element","paragraph_zero_based":18639},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18640},{"literal_text_all_w_t_and_m_t":"-- TAG-BSR-CONFIG-START","paragraph_zero_based":18641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18642},{"literal_text_all_w_t_and_m_t":"BSR-Config ::=                      SEQUENCE {","paragraph_zero_based":18643},{"literal_text_all_w_t_and_m_t":"    periodicBSR-Timer                   ENUMERATED { sf1, sf5, sf10, sf16, sf20, sf32, sf40, sf64,","paragraph_zero_based":18644},{"literal_text_all_w_t_and_m_t":"                                                        sf80, sf128, sf160, sf320, sf640, sf1280, sf2560, infinity },","paragraph_zero_based":18645},{"literal_text_all_w_t_and_m_t":"    retxBSR-Timer                       ENUMERATED { sf10, sf20, sf40, sf80, sf160, sf320, sf640, sf1280, sf2560,","paragraph_zero_based":18646},{"literal_text_all_w_t_and_m_t":"                                                        sf5120, sf10240, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":18647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c4e4e6d8ab7b999d0cce92a454805772a1c4948d511af5c5efb1c481f1da3b6b","c1e9971006c110b63d61d6ec264d3cffb5275cac96aced46c26ef75a29f85df6","051062d6e6a74162c188bdfce242c6d4f1817e1ee3b1e3830b9e5c16f45bdff3","00ec5a282ff1f92a4bac053a3007528345a83321d6e38afb6a4bec7ba3dffc43","dcc546cc8a547ef61300dd5444a90d9d2f4767127f64ebc44f38952848505827","1dd6ae136684ee5055199fba871d96ec7380690de5bf290a5c7ee117b596629a","6bb68c949948958a52d6898de113f0a33038f495304612495dc6e99fff90f361","2b623e9970a76e7d04f84e4fabcaa0c3600f10686da8f5986b9890b739bf9865","b77831258a02cbdf5278a5429b34df4fb47e6cee4fd08895de55056a98a77cc0","fa05223fc2d09e82538445aeb9a267014ce5d6553ba3476ee40d1cfc0d3780a5","a4edcd0161cc31c3a004ff6c3ad7384aa8aee078b45ebffa25762ea6588464a2","adbc838afb65817aaf25f95a4e908f4a74d66f1f6b4f047a74b92ac190687ab1","76ff849db4815204de893c53