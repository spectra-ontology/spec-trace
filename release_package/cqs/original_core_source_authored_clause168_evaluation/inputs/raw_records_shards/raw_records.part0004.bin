{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28752},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":28753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28754},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":28755},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28756},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":28757},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":28758},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":28759},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":28760},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":28761},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":28762},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28763},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28764},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":28765},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28766},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28767},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":28768},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL    -- Cond eventID-TSS","paragraph_zero_based":28769},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28770},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28771},{"literal_text_all_w_t_and_m_t":"    mobileIAB-Support-r18               ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":28772},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28773},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28774},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":28775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9ed9c366747e229a6ecd17fb3c3eb48b23f5409c2fc89f57dddb9aa02702c778","78c9a55aeeee87101e5826bd0f2e0fba2bb7f7c1c0767d6f1e701bb85235b0ef","b92f6f36af5dfafc004bcae24fd08e7f412c0583930c6afe5fb2b678b282c0ca","bac8c15e271cc6a2fabe850b40ae1178338b5de92e592fd37020d2c5b496f294","75ff56353bfa032b87394c2f8644df2ede4406c94dea1266b29b038d7fde76fd","6dbbf6d7d891a23533831a62232a75676df2bc09032fe82d12241e9c6aa00038","c7860ade0713a9435b9e144f1b8b13bff3d48e74485e62e3576ca06982167288","1290adc10e0485dd9edba250adf4762f4886d575d58148957a8d038a74ccb76d","7caf1a54d142fdbc4df93dacb4462bff0c3ad202ebc54fe6628cd41042ea5ff3","c53329029c9ef8e101ea47ed7c5258fb3218eb62098bbff8c36fe8409753bdfc","46fcaa3324226502c040bcd32118de4c22e83d4c58e74d2dd9a3b8212f8b9958","9b5a3865a6356e79eb69271642657c57768a10f41643e0a9d047507fd0657534","4111753ecd915d37c2007c064153acf81476c54b50f985606551e9e872692300","21a90aaf4f5264b0d03619d4af9a2200b25770e618f5e1f3f478f80245024bc9","712fc581c87643be9bea3ce539cffaeed198dc8c02694ccec3f2ad74f9f421a9","1ed8abb0159550c17daeede5a0a0c87c9a7c607f54b8e1c893a4a2db2097e52e","9ad523126a5a7a566ba31c850380d52188e7fcae01a8d75d2cf207a6e7ec2bbe","228ecd41068097112e73b49d5735d3fecce0984934bff8f6fe3178c004220e4f","ed1c2e823c73a1ec4299a4c8f2153556d500a7f805a6b8a9dedddd8aac8072fd","b8b515b42e51bd6fbee799810565003ae82751d041f80e3cf9a40f813cefe7fc","17cad30834f877feb1574cdecf731b7c67108c6e095232f6b1b062cf2838b198","6ecd6dee0301256c620c849bcc7db62e8e4d9e028d416d33e6195490616a2fc7","fa6e8096e0a2aa99d1380611873484dea130577a06d44986324a4c36ffdfa548","e7edebc124417d18bf84fa8d24a26f3e9d4b54d8cac193ed77e80b2cb781237c"],"paragraph_range_zero_based":[28752,28775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28752"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28776},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28777},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":28778},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":28779},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20]. This field is ignored by IAB-MT and NCR-MT.","paragraph_zero_based":28780},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":28781},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity. This field is always present if the mobileIAB-Support is broadcasted in a cell.","paragraph_zero_based":28782},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":28783},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node. This field is absent if mobileIAB-Cell is broadcasted in the cell.","paragraph_zero_based":28784},{"literal_text_all_w_t_and_m_t":"mobileIAB-Support","paragraph_zero_based":28785},{"literal_text_all_w_t_and_m_t":"This field indicates the support of mobile IAB and whether the cell can be considered as a candidate for cell (re)selection for mobile IAB-node. This field is absent if mobileIAB-Cell is broadcasted in the cell. If the field is absent, the cell is barred for mobile IAB-node.","paragraph_zero_based":28786},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":28787},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs. The absence of the field indicates that the cell only supports PSCell/SCell functionality (per PLMN) or is an NTN cell.","paragraph_zero_based":28788},{"literal_text_all_w_t_and_m_t":"trackingAreaList","paragraph_zero_based":28789},{"literal_text_all_w_t_and_m_t":"List of Tracking Areas to which the cell indicated by cellIdentity field belongs. If this field is present, network does not configure trackingAreaCode. Total number of different TACs across different PLMN-IdentityInfos shall not exceed maxTAC. This field is only present in an NTN cell.","paragraph_zero_based":28790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28791},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28792},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28793},{"literal_text_all_w_t_and_m_t":"eventID-TSS","paragraph_zero_based":28794},{"literal_text_all_w_t_and_m_t":"If eventID-TSS is present in SIB9, this field is mandatory present in the PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1. Otherwise, the field is optionally present, Need R.","paragraph_zero_based":28795},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28796},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityList2","paragraph_zero_based":28797},{"literal_text_all_w_t_and_m_t":"Includes a list of PLMN identities.","paragraph_zero_based":28798},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2 information element","paragraph_zero_based":28799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7dff906e8e56efbda1b875f67b