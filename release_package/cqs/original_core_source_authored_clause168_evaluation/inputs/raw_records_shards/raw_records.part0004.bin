IG-START","paragraph_zero_based":32655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32656},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config-r17 ::= SEQUENCE {","paragraph_zero_based":32657},{"literal_text_all_w_t_and_m_t":"    scellActivationRS-Id-r17         SCellActivationRS-ConfigId-r17,","paragraph_zero_based":32658},{"literal_text_all_w_t_and_m_t":"    resourceSet-r17                  NZP-CSI-RS-ResourceSetId,","paragraph_zero_based":32659},{"literal_text_all_w_t_and_m_t":"    gapBetweenBursts-r17             INTEGER (2..31)                                                            OPTIONAL, -- Need R","paragraph_zero_based":32660},{"literal_text_all_w_t_and_m_t":"    qcl-Info-r17                     TCI-StateId,","paragraph_zero_based":32661},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32662},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["137cc169f61e88a82efb5813c9cb2f186198f37bd3461d1cca619e23ef1d2716","8faff71f56508f73580110b6c4a6cfa299f3ccb3ac99d6c4aed4abc6cf69f300","25576cd6b015ab047f615dcacaa8cce0654ae118a6eb8f8d6e5d980ef2a52067","b5c952feaf0cefeb6f63199827a1ec95810a46632eaa2e51577ca7dc85d064ed","6708df62e0caa24a73f18009b9d73bb94bd345aaf6d739ec6b0b2931c6379628","015c60c2510a972d77b9d5f6719aa9667141aa9e11b5aab7c7b80a546b3072a0","216786fe93b1213375e65fdcee14fadf7b5e983aace5ad1b3741b8e3ee26fc06","4fea1dfd92b3fbc429e82c88964c9bb1e4993a69be3f2534b496bf9854cdc541","89319171fa825eb5a0ee538f7872c10c6e14975a95ee48f0ca1f33ff58c6f752","a0aa3c0f2606186e2a5977344a6db88649de19446a41430c0606e65424d56443","dfb4c95aa1431ba31357adeb4282faf5320ab39d105d212ad777dc0e0dfb4e84","1e5284e0932d18776c46412e11fe72378c2f20d9f78f5b52cb5c1d452ea1c010","c3f1bb666a79304a7652ad6e8178703d202746bb7bab31939a05568a7e20bc16","fc85a70c55505b78e6cf431237f8f63b0f517647ee047287f224e5654123b238","c937a748fec07c27f54c75da0889e61e0cfe9220d0ec1e85c98c003f4b2bb494","f87e414905c1bfa3e3603d43119edbae774c00d6d02d576e42b0831389bbe4c8","e4d7cff3835985a820c032c92a92ce0ab3f434c03e02defee799c7e00bb2b147","06a843fc1581b1519f1807e4f63b466b06829cef0ab4845a99e12899b8093270","e2c13804c16ca63f7318de6f70746b6722cbdfe23d76dc7e740fab40131dd882","f658d441b523f21c7b0ee72ef02990d74ded3b7ed8e7b3e98ee2d7c995e45d42","b2d89a981e2b38e340021b297dfc6e05515f8425a59ce8ffe17a5a3d243be1ae","b812067721358e4ad2ad38186dae8d97f6e8d2ffe6eacc6e5074d9a11dac9f4f","7605e6608ff0529d5fd545d7ba78e86669976feadc96a500e8d68265fb4ac4dc","7ea483c1b74837c33b9d9cb214e2a544fbcc3d8c3117f4756b32de2034ec2da6"],"paragraph_range_zero_based":[32640,32663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32640"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32664},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIG-STOP","paragraph_zero_based":32665},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32667},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config field descriptions","paragraph_zero_based":32668},{"literal_text_all_w_t_and_m_t":"gapBetweenBursts","paragraph_zero_based":32669},{"literal_text_all_w_t_and_m_t":"When this field is present, there are two bursts and it indicates the gap between the two bursts in number of slots. When this field is absent, there is a single burst.","paragraph_zero_based":32670},{"literal_text_all_w_t_and_m_t":"qcl-Info","paragraph_zero_based":32671},{"literal_text_all_w_t_and_m_t":"Reference to TCI-State for providing the QCL source and QCL type for each NZP-CSI-RS-Resource listed in nzp-CSI-RS-Resources of the NZP-CSI-RS-ResourceSet indicated by resourceSet (see TS 38.214 [19], clause 5.1.6.1.1.1). TCI-StateId refers to the TCI-State which has this value for tci-StateId and is defined in tci-StatesToAddModList or dl-OrJointTCI-StateList in the PDSCH-Config included in the BWP-Downlink of this serving cell indicated by firstActiveDownlinkBWP-Id in the ServingCellConfig in which this IE is included.","paragraph_zero_based":32672},{"literal_text_all_w_t_and_m_t":"resourceSet","paragraph_zero_based":32673},{"literal_text_all_w_t_and_m_t":"nzp-CSI-ResourceSetId of the NZP-CSI-RS-ResourceSet of this serving cell used as resource configuration for one or two bursts for SCell activation. This NZP-CSI-RS-ResourceSet consists of four NZP CSI-RS resources in two consecutive slots with two NZP CSI-RS resources in each slot (see TS 38.214 [19], clause 5.1.6.1.1.1). The CSI-RS associated with this NZP-CSI-RS-ResourceSet are located in the BWP addressed by firstActiveDownlinkBWP-Id.","paragraph_zero_based":32674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32675},{"literal_text_all_w_t_and_m_t":"–SCellActivationRS-ConfigId","paragraph_zero_based":32676},{"literal_text_all_w_t_and_m_t":"The IE SCellActivationRS-ConfigId is used to identify one SCellActivationRS-Config.","paragraph_zero_based":32677},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-ConfigId information element","paragraph_zero_based":32678},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32679},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIGID-START","paragraph_zero_based":32680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32681},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-ConfigId-r17 ::=        INTEGER (1.. maxNrofSCellActRS-r17)","paragraph_zero_based":32682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32683},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIGID-STOP","paragraph_zero_based":32684},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32686},{"literal_text_all_w_t_and_m_t":"–SCellIndex","paragraph_zero_based":32687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["01b6a00d78347718ddaef1f3207ef49636f51407693c7a5641c3c50b50de74a3","4ab0fdae7e16f012433e67b64364351bdc33ad408ab02e83e0e3aedc232a07c1","350b79f96f0af59d293de159e6147a60f2f226382de41ddd23a5995036ca2a6b","9aa187968df2c61bb5b8a3c0dc22ff714264d9bddeee0aa1696f6b6c22ac2a21","d82509e95715c8cefe0ea3dece33edde3e50cbb