{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19848},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONPRIORITY-STOP","paragraph_zero_based":19849},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19851},{"literal_text_all_w_t_and_m_t":"–CellReselectionSubPriority","paragraph_zero_based":19852},{"literal_text_all_w_t_and_m_t":"The IE CellReselectionSubPriority indicates a fractional value to be added to the value of cellReselectionPriority to obtain the absolute priority of the concerned carrier frequency for E-UTRA and NR. Value oDot2 corresponds to 0.2, value oDot4 corresponds to 0.4 and so on.","paragraph_zero_based":19853},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority information element","paragraph_zero_based":19854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19855},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-START","paragraph_zero_based":19856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19857},{"literal_text_all_w_t_and_m_t":"CellReselectionSubPriority ::=          ENUMERATED {oDot2, oDot4, oDot6, oDot8}","paragraph_zero_based":19858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19859},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLRESELECTIONSUBPRIORITY-STOP","paragraph_zero_based":19860},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19862},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMulticast","paragraph_zero_based":19863},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMulticast indicates UE specific common frequency resource configuration for multicast for one dedicated BWP.","paragraph_zero_based":19864},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast information element","paragraph_zero_based":19865},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19866},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-START","paragraph_zero_based":19867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19868},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast-r17::= SEQUENCE {","paragraph_zero_based":19869},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthMulticast-r17              INTEGER (0..37949)                       OPTIONAL,    -- Need S","paragraph_zero_based":19870},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigMulticast-r17                      PDCCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":19871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["295b3b5686772ac27ff84ccfadeb44b51571b07487907a3fcd4a1e390065a087","9dfb514cb696be051ab54e7112c224e73b0600e75e35e4f29b046e670817af66","35aefec31824a6ff220b3855bd36842e1e1c52d94b5a501076ddde83ec590c53","65a42c4af930e91e0ec5da2dad291ed83b2c24c1a9e3aa625e5d557d213a0504","61c22358bf752091a07ff3d1b6f32a842abb27bf88b5fa86d67bbd9376d5e821","e5a88adbeeb36c040d815af2d735603e454bd5826a246de3e32fda25fc9b0e06","93e3dc773502b01b0d7e2fa272e41851dbc61cc2b84dae8fd4c641ca0ef8a63f","632dc9cbe50310046479d1ae1697032f7b532dfda8ad050d855191a19eb52183","998fbd3de4eff3a6227ec6d8da4dd2eb4aed1462a7af465188716f0141564c2b","49f105285abb7a93ed00cac31a546e8089271c56a2d97be37a29bf5a7e398e5d","7440c61e4e0f1e37377fa1fd19be401e1a48c659c72f394d1ebe21ce1d450fc6","4a8560c62a7bd29bf6cc251cd9ef6e38b5fd158d536882198e3b6ab8c74c0688","d5589889b146cd493e60e78ac3d7d73272480a1131