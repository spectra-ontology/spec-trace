{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":44064},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":44065},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":44066},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44067},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":44068},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific sensors. NG-RAN configures the field if includeSensor-Meas is configured for one or more measurements.","paragraph_zero_based":44069},{"literal_text_all_w_t_and_m_t":"sl-AssistanceConfigNR","paragraph_zero_based":44070},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink communication.","paragraph_zero_based":44071},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":44072},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure included in the RRCReconfiguration message is SN initiated or not.","paragraph_zero_based":44073},{"literal_text_all_w_t_and_m_t":"sourceDAPS-FailureReporting","paragraph_zero_based":44074},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall generate the SHR upon successfully completing the DAPS handover to the target cell and if a radio link failure was experienced in the source PCell while executing the DAPS handover. This field is set in the otherConfig configured by the source cell of the DAPS handover.","paragraph_zero_based":44075},{"literal_text_all_w_t_and_m_t":"successHO-Config","paragraph_zero_based":44076},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful handover information to the network.","paragraph_zero_based":44077},{"literal_text_all_w_t_and_m_t":"successPSCell-Config","paragraph_zero_based":44078},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful PSCell change or addition information to the network.","paragraph_zero_based":44079},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":44080},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":44081},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":44082},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":44083},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":44084},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":44085},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":44086},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":44087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d734503b9d9e689bc2862a6f01465510fb13e6fd9fe8d234cbf971362e22e0eb","d0ade6e66fa13f314ba3c169771f4c7742635a730df36f5f3b04df76a8013116","e3abcfa4e32bb74bf135ea43559d08a4fce1204c7bf6b6a2760281f42e69e6f9","447972a8cde611a7fb4452ba34ecfe2f31110210e39d35d22fbb7368ef17cb5c","6f889a422c53ac30b9105a148d8e9db65298cccfccf9b5c47becf3e182984df3","adf9c69c1fe985209e0aae4f324ce22ebb5bea3ec72e3fc8802cb746076ac9eb","0df50cff8019d1c5795e3d7a0ef09542247f87809e77a58ee17e408f34d6be1c","4d5fda5c3ceaa0c42c3c35e22bfc839d72bd067a15ee6f8ad71e4a9b0e5e2dd1","4dda5d64aecf08ef3f441d6664679b67a4e599abb24f4261b78bd0e030af4f6e","3b72e42815777a1093170a9a3feda0c017d72605e6536eb54dfb3d7962e81fd4","ad0adf10d6befc8eb9308970c16f15b8068a293dd8cb30d9ced58d301ca5074f","411f23b5d7de355235e83ef2dc55d9d1bdb8c0918e793220fcc2dd0ec3b3cc15","7599dd78d3dff3595114f335c73cd6057cf2fa71e748c8178afbe6931d082a7f","d1693a6008cc2475bd4dfcdf7197d91a32e5f640cca31f0880e82d36bee4eb39","efcecc68027a0331c23d40b659352840e22fafe95e34a471aceff02e0dcbd6e3","e88f903dcb323a995edd725819b6449f9fe42ae1bdefd03ed726980f254e3a8c","35f38e5fa3d2b74e1d8429ea9282eb8a8ff239f41aacf84ab624a8be50c47b07","2c7b47297d83d4df0820bbb757561eb034a94816e54daf15b40eba33c6083da8","f42ca13f73bef823c36330496a125aa1f27851ecc5b98803adb851b4225da33e","980f106753efda592bf768e1718459934e07d1f9c60325fb14ce9e491256a0c9","c888608dad94122c4b163355063a740a6328783559df7d00fc368d343fea14df","78a0af45910dd1c39719dc839c7732a33d2d833ea4831596ea9f96408e1565fb","fdecbc1e808c40b8030d4094c4aff5a6952a584cda78d01f018cef5d551729d3","7022e624168229084796699139df4ee60ec067b0b0aef2a79f2dbadad8a4af0b"],"paragraph_range_zero_based":[44064,44087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44064"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304-SCG","paragraph_zero_based":44088},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer associated to the target PSCell and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target PSCell of the PSCell change or addition.","paragraph_zero_based":44089},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310-SCG","paragraph_zero_based":44090},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer associated to the source PSCell and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change, or in the otherConfig configured by the PCell for the PSCell change.","paragraph_zero_based":44091},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312-SCG","paragraph_zero_based":44092},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer associated to the measurement identity of the target PSCell and the configured value of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change, or in the otherConfig configured by the PCell for the PSCell change.","paragraph_zero_based":44093},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":44094},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":44095},{"literal_text_all_w_t_and_m_t":"uav-FlightPathAvailabilityConfig","paragraph_zero_based":44096},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to indicate the availability of flight path information for Aerial UE operation.","paragraph_zero_based":44097},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":44098},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":44099},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":44100},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":44101},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoProhibitTimer","paragraph_zero_based":44102},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UL traffic information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44103},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoReportingConfig","paragraph_zero_based":44104},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report UL traffic information.","paragraph_zero_based":44105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44106},{"literal_text_all_w_t_and_m_t":"NeighbourCellInfo field descriptions","paragraph_zero_based":44107},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":44108},{"literal_text_all_w_t_and_m_t":"Indicates the epoch time used along with the ephemerisInfo to derive the propagation delay difference for the associated neighbour cell. The UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is used based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell.","paragraph_zero_based":44109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44110},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["17c6f5037f4cb7237ac95a009f85de1547c016948afb87b74b0ade990400c45a","905340c8d3fd18d7b14ebf1f220bfc7f56582e2b758950fb9c27c322c4c43cd0","043c29c4b21a8a67d7c93e54c73b3295b8060d719e87277239f27277e55d9d1a","347db59f5b51590b50cb822b293e3eefafa7a825d1594877a58ef2faa467504c","27cac77680ebdaca7d75413ac279e3073dc5a669d74bfc36bfc61bc9efc1c4bc","6e3d9bbfbfde195ba56e18efab1ccd9caf032788fca2aceec99d2a0c67024599","ee35c8002c308d062de50fa633c6ff9fbdff1fa3140393dabaf05ed4306968de","de59fa00028db2376b6cadd89b9a225d08db9222493cee00320f22706e3c2b36","d65654c8c442483aeb7430c8f5399f0b13140d1ec72635b72c570a7fcaedf540","46ebc0a75200399db250544a984596cd9e3cc2a222d6a5172cbccd4d7158f5f6","847d929f1b13010ea591b04e9a467936f2acaa0aeb6648595a9a7d1d70a0c9b6","d8d6bb0e16e03edb96a1296d6a9b98bdaca49c82990ccf33b1540999b45180fb","7c0cbf0f59ad841ce87ae8845c5a29d7c9327d4053ba580fadf1b94432998283","611e8994c0ff845b80ec7e82b5765648c4e5df9b74356bb1877b63467fb941e8","1144f3c1cb97650d0b216bf290c332698b5a30f2545c0f8e1ac61d6592eb9b50","84058f359e03b0aa446e844197d1c512cb5ed111d7f6979324fb37b26c17f7e2","f6dbcc1388015a8f1b920f02aaa4856b37d884652b377be3444ba3e5a60744c9","1deca0d9e1027147c1668785bf1a8662e58134b9ded5f694ca6f2132f0c14615","debd89d59d087985842a0588a4aaf81f3bc554dc01ef53e6b60297413df26a8e","22e7908eb750549b7e9a2742aa8cbbacadfb0424b944e48a1add82d2aa1e86d6","5140be6e747a2343fe98f5e848064406af3ca7e99972eb2c13cb16c6ffd778da","9be55f5af96b5363a9ed1e1332dfa8479f02546970576ebee560a89c4769f06b","3857180452e39aa83df9a2cf0d00c1e5fc87c75af9f436bd0c6eef302b5d6604","130df19135788b245a07a5b8a00630f2a452a5c3ab083da30950efd1aa9dfdf5"],"paragraph_range_zero_based":[44088,44111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44088"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44112},{"literal_text_all_w_t_and_m_t":"FDM","paragraph_zero_based":44113},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, if idc-AssistanceConfig-r16 or idc-FDM-AssistanceConfig is setup. Otherwise, it is absent, need R.","paragraph_zero_based":44114},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":44115},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":44116},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":44117},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":44118},{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":44119},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":44120},{"literal_text_all_w_t_and_m_t":"musimGapConfig","paragraph_zero_based":44121},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if musim-GapAssistanceConfig-r17 is configured; otherwise it is absent, need R.","paragraph_zero_based":44122},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":44123},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":44124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44125},{"literal_text_all_w_t_and_m_t":"–PhysCellIdUTRA-FDD","paragraph_zero_based":44126},{"literal_text_all_w_t_and_m_t":"The IE PhysCellIdUTRA-FDD is used to indicate the physical layer identity of the cell, i.e. the primary scrambling code, as defined in TS 25.331 [45].","paragraph_zero_based":44127},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD information element","paragraph_zero_based":44128},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44129},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-START","paragraph_zero_based":44130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44131},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD-r16 ::=        INTEGER (0..511)","paragraph_zero_based":44132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44133},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-STOP","paragraph_zero_based":44134},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b6d6bbb3d2004a3f0a166c2616245293bd6e72b0f4570f2f92e26bbae58edcc3","73724e5cf18bcb6fc46a23bbdcd0138ba5f62364fbc0eba04b9ffe3b37e8c33b","b0d415bcb1058d267ff22bef65468ca0915c08793b4870ad2f4928f1317e3342","fabad908d228c9ca5057d57cea010ea6bd506f94172fc537a017e3d87c1aa38f","ef78bf6e4e01b9f70df04b10f98141f86e5b345be6a0e5c42258e0df00e886e5","9b829b033401fb78bf20959bd0388433c1ef999e622a1437be856fb680685c2b","ae8dcaccf548d27801359f50a9f782c305b46f4bb724a0341d51aebec24e7999","23a01e178faac6c6557051cd813246d73cc1d4168e4f3b92c48584832d86d0e4","454e9cf02888b059e9e889228430d910ab5762816e5d2b873ec8b8d6e9cdf51b","209fe51b0ac455b6b0afcce4c75d3c7f635b7d2ba6d6f31556e9c83f00849e41","8d0b1315b1e8fcab67210f97634c77f8342cf45879