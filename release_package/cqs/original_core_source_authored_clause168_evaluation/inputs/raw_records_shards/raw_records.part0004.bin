{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UERadioPagingInformation field descriptions","paragraph_zero_based":53040},{"literal_text_all_w_t_and_m_t":"supportedBandListNRForPaging","paragraph_zero_based":53041},{"literal_text_all_w_t_and_m_t":"Indicates the UE supported NR frequency bands which are derived by the gNB from UE-NR-Capability.","paragraph_zero_based":53042},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-FDD-FR1","paragraph_zero_based":53043},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in FDD FR1.","paragraph_zero_based":53044},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR1","paragraph_zero_based":53045},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR1.","paragraph_zero_based":53046},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeA-TDD-FR2","paragraph_zero_based":53047},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type A in TDD FR2.","paragraph_zero_based":53048},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-FDD-FR1","paragraph_zero_based":53049},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in FDD FR1.","paragraph_zero_based":53050},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR1","paragraph_zero_based":53051},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR1.","paragraph_zero_based":53052},{"literal_text_all_w_t_and_m_t":"dl-SchedulingOffset-PDSCH-TypeB-TDD-FR2","paragraph_zero_based":53053},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports DL scheduling slot offset (K0) greater than 0 for PDSCH mapping type B in TDD FR2.","paragraph_zero_based":53054},{"literal_text_all_w_t_and_m_t":"halfDuplexFDD-TypeA-RedCap","paragraph_zero_based":53055},{"literal_text_all_w_t_and_m_t":"Indicates whether the (e)RedCap UE only supports half-duplex operation for FDD in the indicated band(s).","paragraph_zero_based":53056},{"literal_text_all_w_t_and_m_t":"inactiveStatePO-Determination","paragraph_zero_based":53057},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE supports to use the same i_s to determine PO in RRC_INACTIVE state as in RRC_IDLE state.","paragraph_zero_based":53058},{"literal_text_all_w_t_and_m_t":"numberOfRxERedCap","paragraph_zero_based":53059},{"literal_text_all_w_t_and_m_t":"Indicates the number of Rx branches supported by an eRedCap UE.","paragraph_zero_based":53060},{"literal_text_all_w_t_and_m_t":"numberOfRxRedCap","paragraph_zero_based":53061},{"literal_text_all_w_t_and_m_t":"Indicates the number of Rx branches supported by a RedCap UE.","paragraph_zero_based":53062},{"literal_text_all_w_t_and_m_t":"ue-RadioPagingInfo","paragraph_zero_based":53063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a667f686ee98cd56e082cce6b4d381383948ddd217ab112198566772cc2095f0","f2f636ba683c5dc2f53e7d18fdfccfe70385b59a402d2201e94fbd39c44fe1b4","4110e4d4cdaca77b4636ce77a79b54631f494f70c5f0ce993ddd36dbb16d599a","69e7582a9b1e65aa8fcce22e1e55a924f1f09b443e8fb862ad79d709f8800c40","2ab9589895a4e02d7231ce3759b01c3bf15edc17b9bb7175e2871040fbfe183e","db47d5828afd8cbc70e2d27418408dc9e7df5ab4c7832ccd34cacb5