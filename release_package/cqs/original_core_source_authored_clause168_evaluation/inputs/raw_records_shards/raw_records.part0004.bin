},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA-r17 ::=   SEQUENCE {","paragraph_zero_based":26561},{"literal_text_all_w_t_and_m_t":"    needForNCSG-EUTRA-r17              SEQUENCE (SIZE (1..maxBandsEUTRA)) OF NeedForNCSG-EUTRA-r17","paragraph_zero_based":26562},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26563},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26564},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA-r17  ::=         SEQUENCE {","paragraph_zero_based":26565},{"literal_text_all_w_t_and_m_t":"    bandEUTRA-r17                      FreqBandIndicatorEUTRA,","paragraph_zero_based":26566},{"literal_text_all_w_t_and_m_t":"    gapIndication-r17                  ENUMERATED {gap, ncsg, nogap-noncsg}","paragraph_zero_based":26567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2aa6b8fc49d4aa99aebc042a87e2746c99aaec14fcfadf9f80e464b9c115302c","59c21dfae0a3dd69535d8c5055840cfd8c205c4340efbce22924053562123279","69528ee51918331aa4c589a512bff63967e5fbc6076e873d7ebfda161e5a81db","3900f6517d6206b8a4adffc627cbb87b0f9db737a32578d87936b54575e9f6db","cbb694660ed5ea548310c4ebec5101f1b91469bc4706679f6e0fe6d54859a1a1","86849c8315b531480f05a1bafcc8c219c2de1597d8b65bd8acf642e9c4fb1734","86edfcc1aaf9caee0f9656dc79f8ad2830e9605855d412198c48d6995f7a1ca5","f2cb7bc3220d125965d3152e90faacfd9780d93f4ca7cc0e74d2b1576b7073ef","bafb9c08fdf2c73e9aa1e5bbfde9b57f12dc595bba0d624cd3673f7b9f60b0ce","8aa990507f2fcccbe0a3302954b879c4fb842b45087a7952ae6a982eeb57e5b4","61d1f92bd2617415e38b4ab81b9aec72a3df8270089d860e5e6a0bd3e67b4dde","73d90a481d3483d297d0ee4d9868c00a5a3d8d931b559c01ffbcdbda2ef07ad7","e58abfc5c104bf623d5a702f0db6add2ad2eebdd984791ad385968d0b24