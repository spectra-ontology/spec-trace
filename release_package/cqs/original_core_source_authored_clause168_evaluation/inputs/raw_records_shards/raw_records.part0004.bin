{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical or cli-Periodical or rxTxPeriodical:","paragraph_zero_based":6792},{"literal_text_all_w_t_and_m_t":"3>remove the entry within the VarMeasReportList for this measId;","paragraph_zero_based":6793},{"literal_text_all_w_t_and_m_t":"3>remove this measId from the measIdList within VarMeasConfig;","paragraph_zero_based":6794},{"literal_text_all_w_t_and_m_t":"1>if the measurement reporting was configured by a sl-ConfigDedicatedNR received within the RRCConnectionReconfiguration:","paragraph_zero_based":6795},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":6796},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":6797},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6798},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":6799},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6800},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via E-UTRA embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":6801},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":6802},{"literal_text_all_w_t_and_m_t":"2>if the measurement configuration that triggered this measurement report is associated with the SCG:","paragraph_zero_based":6803},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":6804},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB3 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":6805},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6806},{"literal_text_all_w_t_and_m_t":"4>submit the MeasurementReport message via SRB1 embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":6807},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6808},{"literal_text_all_w_t_and_m_t":"3>submit the MeasurementReport message via SRB1 to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":6809},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6810},{"literal_text_all_w_t_and_m_t":"2>submit the MeasurementReport message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6811},{"literal_text_all_w_t_and_m_t":"5.5.5.2Reporting of beam measurement information","paragraph_zero_based":6812},{"literal_text_all_w_t_and_m_t":"For beam measurement information to be included in a measurement report the UE shall:","paragraph_zero_based":6813},{"literal_text_all_w_t_and_m_t":"1>if reportType is set to eventTriggered or reportOnScellActivation:","paragraph_zero_based":6814},{"literal_text_all_w_t_and_m_t":"2>consider the trigger quantity as the sorting quantity if available, otherwise RSRP as sorting quantity if available, otherwise RSRQ as sorting quantity if available, otherwise SINR as sorting quantity;","paragraph_zero_based":6815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a18c74f7bf14f286b7e11ff73af7bd2ca709471a28e3fa0f1ecce80f95743952","8c7913d373581d77f4b00cf39b838dc73702c2b0545835d65af162173bdc7bda","7da147e0e82a4bf07ce56799a54609a3ebf067218e3a575c7d1c99415971b02e","6f134c66ac229c3a48f2f6a0f4acce45704526836ff5e5497e938b8b6e175664","7665b99703712a205a7e543acf267204fd7dd68106ede14b48597cba8ab5c8a2","b70280d506dcdbe2d18dc6fc018735f4a960b39d60f672d3c972d7601b7f15a1","a0fb18453faf4ea6e9b2580d1d971b77a6dbb0f1246d76a075af489562631c19","8f1224b10c6d9d4d91b85b41963c320169f845ad31fee9dca0b57eb68077d13c","d3406f4fd7537f426ef495c8d1709f024a8d67b0d671728f71021225cc67f043","eef28dd6cac2b3a919e4da3657b36e2a458c76ae6e9de9d55d036807fe6306f8","aba9de3f59698bae65a9d4b4521d0738e9bac3d8510b8c4d5fb008aa5c6469d2","41404586277dd1ea7fb99bad09252ec60c30c4e17d869a2c6007b1ff228cc387","24c6b7d6af0b4d49fce469d3c1fb4a22dde54a5f2872eb51eeb4ba5c61c4e44e","67e5c360e83c66e404cd9c7360e7748abc14a2f011fc936f83b159cc7569ee64","d46c1b592be577c847d90fa56eff87a8a8df92ee3f39e6b0b24d21391a050ab1","ce6111713300801213360a622c5ecd1f87085a6381d1b081828910ba12f3ed88","354183e28736a174a7123941b63aa10e17826cee77d757627ee02c9ce688c18c","6450b96558a051824ba08c89df72a2abce0a7d25814db84a7cb4b1d9a55c3284","5675d6c12287575f2150e5025d345ccc15aab07cd5e7dd7f58d99a79f5038485","f7a38d25538fdd0843e16403a69c3ff35597d5aa1449b3e14d47280ca11e597f","dd2908b7c88886e69c6dcd0c4600ccff62544a386b0d7ed673f592cda7881a32","712113c6d2cc433d70c7cfa07d00cba445d2f24f65fc6ee31c03954e3228e111","37e9f742c557fb33787d73acf6114cd193f3b57aad9a6de9baf902193e530644","30ec02243f27d9f0b9f759936a36d74550ee34b4c765ca7c387ae3663ef85462"],"paragraph_range_zero_based":[6792,6815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if reportType is set to periodical:","paragraph_zero_based":6816},{"literal_text_all_w_t_and_m_t":"2>if a single reporting quantity is set to true in reportQuantityRS-Indexes;","paragraph_zero_based":6817},{"literal_text_all_w_t_and_m_t":"3>consider the configured single quantity as the sorting quantity;","paragraph_zero_based":6818},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6819},{"literal_text_all_w_t_and_m_t":"3>if rsrp is set to true;","paragraph_zero_based":6820},{"literal_text_all_w_t_and_m_t":"4>consider RSRP as the sorting quantity;","paragraph_zero_based":6821},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6822},{"literal_text_all_w_t_and_m_t":"4>consider RSRQ as the sorting quantity;","paragraph_zero_based":6823},{"literal_text_all_w_t_and_m_t":"1>set rsIndexResults to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes or CSI-RS indexes in order of decreasing sorting quantity as follows:","paragraph_zero_based":6824},{"literal_text_all_w_t_and_m_t":"2>if the measurement information to be included is based on SS/PBCH block:","paragraph_zero_based":6825},{"literal_text_all_w_t_and_m_t":"3>include within resultsSSB-Indexes the index associated to the best beam for that SS/PBCH block sorting quantity and if absThreshSS-BlocksConsolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":6826},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the SS/PBCH based measurement results for the quantities in reportQuantityRS-Indexes for each SS/PBCH block index;","paragraph_zero_based":6827},{"literal_text_all_w_t_and_m_t":"2>else if the beam measurement information to be included is based on CSI-RS:","paragraph_zero_based":6828},{"literal_text_all_w_t_and_m_t":"3>include within resultsCSI-RS-Indexes the index associated to the best beam for that CSI-RS sorting quantity and, if absThreshCSI-RS-Consolidation is included in the VarMeasConfig for the measObject associated to the cell for which beams are to be reported, the remaining beams whose sorting quantity is above absThreshCSI-RS-Consolidation;","paragraph_zero_based":6829},{"literal_text_all_w_t_and_m_t":"3>if includeBeamMeasurements is set to true, include the CSI-RS based measurement results for the quantities in reportQuantityRS-Indexes for each CSI-RS index.","paragraph_zero_based":6830},{"literal_text_all_w_t_and_m_t":"5.5.5.3Sorting of cell measurement results","paragraph_zero_based":6831},{"literal_text_all_w_t_and_m_t":"The UE shall determine the sorting quantity according to parameters of the reportConfig associated with the measId that triggered the reporting:","paragraph_zero_based":6832},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to eventTriggered:","paragraph_zero_based":6833},{"literal_text_all_w_t_and_m_t":"2>for an NR cell, consider the quantity used in the aN-Threshold (for eventA1, eventA2, eventA4, eventA4H1 and eventA4H2) or in the a5-Threshold2 (for eventA5, eventA5H1 and eventA5H2) or in the aN-Offset (for eventA3, eventA3H1, eventA3H2 and eventA6) or in the x1-Threshold2 (for eventX1) as the sorting quantity;","paragraph_zero_based":6834},{"literal_text_all_w_t_and_m_t":"2>for an E-UTRA cell, consider the quantity used in the bN-ThresholdEUTRA as the sorting quantity;","paragraph_zero_based":6835},{"literal_text_all_w_t_and_m_t":"2>for an UTRA-FDD cell, consider the quantity used in the bN-ThresholdUTRA-FDD as the sorting quantity;","paragraph_zero_based":6836},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the y1-Threshold2-Relay (for eventY1-Relay) or y2-Threshold-Relay (for eventY2-Relay) or z1-Threshold2-Relay (for eventZ1) as the sorting quantity;","paragraph_zero_based":6837},{"literal_text_all_w_t_and_m_t":"1>if the reportType is set to periodical:","paragraph_zero_based":6838},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityCell for an NR cell, and according to reportQuantity for an E-UTRA cell, as below:","paragraph_zero_based":6839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5db3be2ff34395ea81f1244eec6de2a9c1c5644ffeca497514946304bcb22faf","f66e1de9eabb00e2492b1b46a94a371ed76172147d9f29014489a7580a01fa98","12e6ba36855af3d0e0a09ceeef2c8b715a56ef99b1d2b4c6f781209f2e998749","cc880ba607dcbf87c83afe8151baf3354611b9eb29844b20de02a05c692cdb3f","d674aa58469d9457217d534730e1043300ff850ed906e03ec0e33decbfe54a45","88b9fbdcc555b82c508e0648f764a9a24d792140b5ad9b1cf02c71fdfb3e1aad","60c2be48d04b3c38080e35de01f50ada4778d723aee4f0e7b2649fde31db20be","ee6bf5b438c726d87381c69b440ab26e333428abf6bd0573a2a911df2000223f","141689828fd0ea55f0d3393a1b6c52b02e0db72c9ba3f5286a1d716d0a85ffd7","4ed965f7476689f9814936c008c30dae62e51ad101347dcf67c3a60e7fb0b495","a12e2eaa45860b63c8b0c7abda58fab2bede04e74e11dfeb0005c43a2f6339c0","d138057e2ca0a980b27eda3c949bf032e0b8828955225399efdbdeb543fd9d1e","56c0387d3b4ee45b94572c6a6a7c03c000286afefe45bdf602c3f9ce05ee2929","688fb6fa5640a6322066f3066f7bb6c7dc93c4cba2aeaeedbfa983386e6fd185","dfddb035b138ff4d6cc3916dfdbe0d9a7e8f849c982ffb553dea85190498c4a9","e6391ee01589edee1059b2ce89778c5da3ebec4a209c38e930aa9096af1fc830","f37b80030471c31e7b7480effe881b1b9de59fd6f1bfa0c0644404562a06540e","ad3524179833d22a4084ecafa0cadd374f1dead1c4e53f62f7960096dd85559a","44c50c9f6b6a534fb356baf23e1c42359f0f77e6a6af56a3c54f258dfb0f5367","3d7a30c989432a4cf4a31f79cc328f4ed371263315a76d5c57c96e98b944d0b5","1c17cbd3966fb1bcd87fdd3c282e4fcd3102e7aca79b590ffc16ec21b1c80aaa","b5e4628d436ab5ea95fc706acca4e3d58219d2da19b991073b88a9d547fbb5f6","f7a68d58a285660ff33eaf31a3ce96d8c6c8f9beb91361c1958eee2aee9c6db4","3bcde86d56b46756127b0eb23b94f3d0f16359c58c4c0d1aefb44f0f14b20b0d"],"paragraph_range_zero_based":[6816,6839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6816"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":6840},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":6841},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6842},{"literal_text_all_w_t_and_m_t":"4>if rsrp is set to true;","paragraph_zero_based":6843},{"literal_text_all_w_t_and_m_t":"5>consider RSRP as the sorting quantity;","paragraph_zero_based":6844},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":6845},{"literal_text_all_w_t_and_m_t":"5>consider RSRQ as the sorting quantity;","paragraph_zero_based":6846},{"literal_text_all_w_t_and_m_t":"2>determine the sorting quantity according to reportQuantityUTRA-FDD for UTRA-FDD cell, as below:","paragraph_zero_based":6847},{"literal_text_all_w_t_and_m_t":"3>if a single quantity is set to true:","paragraph_zero_based":6848},{"literal_text_all_w_t_and_m_t":"4>consider this quantity as the sorting quantity;","paragraph_zero_based":6849},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6850},{"literal_text_all_w_t_and_m_t":"4>consider RSCP as the sorting quantity.","paragraph_zero_based":6851},{"literal_text_all_w_t_and_m_t":"2>for a candidate L2 U2N Relay UE, consider the reportQuantityRelay as the sorting quantity;","paragraph_zero_based":6852},{"literal_text_all_w_t_and_m_t":"5.5.6Location measurement indication","paragraph_zero_based":6853},{"literal_text_all_w_t_and_m_t":"5.5.6.1General","paragraph_zero_based":6854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6855},{"literal_text_all_w_t_and_m_t":"Figure 5.5.6.1-1: Location measurement indication","paragraph_zero_based":6856},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to indicate to the network that the UE is going to start/stop location related measurements towards E-UTRA or NR which require measurement gaps or start/stop detection of subframe and slot timing towards E-UTRA (eutra-FineTimingDetection) which requires measurement gaps. UE shall initiate this procedure only after successful AS security activation.","paragraph_zero_based":6857},{"literal_text_all_w_t_and_m_t":"NOTE:It is a network decision to configure the measurement gap.","paragraph_zero_based":6858},{"literal_text_all_w_t_and_m_t":"5.5.6.2Initiation","paragraph_zero_based":6859},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6860},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to start performing location measurements towards E-UTRA or NR or start subframe and slot timing detection towards E-UTRA, and the UE requires measurement gaps for these operations while measurement gaps are either not configured or not sufficient:","paragraph_zero_based":6861},{"literal_text_all_w_t_and_m_t":"2>if preconfigured measurement gaps for positioning and posMG-Request are configured and the UE considers that at least one of the preconfigured measurement gaps for positioning is sufficient for the location measurement when activated:","paragraph_zero_based":6862},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to initiate the measurement gap activation request using UL MAC CE as specified in TS 38.321 [3];","paragraph_zero_based":6863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ae75d518215ca3959c339ed60ae828020c77b924237eaa3957eb809b13ecd67a","7dd1537d788045a0e8d5f0561f1e317f01ad20019ca695d383bb42c24d682287","876ec66078c61dabb323ecadf065ff4c9333ed47ab08f15657114a8b8bdf2f1b","fb6b4769723cedf62f10d95bd79201f3c11f5e78ccd5c2627abe39f07023e201","a591d5cb2faa88b76c78093133dab05b93061b940ebb450500fd2d8002e9b349","83cb480c973c956521ea8554c6ed04819604179bed906ea5aeb59a0bca02387f","f8adaaa60ea2e6d309c596144a0a5de6a187a810d03638853128083f5f4f77eb","3b08f5d0ec1a3d59641677b27c75664dec813d11a742ef81fe960de111169ae9","78b4e042644e8319830bb38bfa411f961ba38d155848e8849528b432a0483cf0","07cbe4d84b0b2d478ad5f1a36e317f8e6b35c8f8c22f1a6332e15b72f2af9053","8df560d75c06c71d3a3f5fe30eb47c738f5394f0288d9b8eb19a4c0669ff71f4","be6b79319688c8bf9b05b8bfa2cc1729f2104cce2d2ceb9285668a83f06d6156","a5ea562ceb87a932043c68f959a8a4fdd44e8c6e2cd1bbd754232d12ae6cd28e","f23926850b7dc06410d192efb1a9751cd83a4f570172be5399b9d230b2cfcb8c","aa4d7094ec258d0d7f6c79a1689ba460fb6a9fe4dd5b0b7e9955739a08ce3bb7","d1892ffd9fc3d1c1616436398966a85528234f9c976ca47768d45b35bb3ca4ee","b216a947259142e4fa5e25d9e9dd6ef6bbf767f76eb0261586a0745ef66f69d7","96564b3a8dd311e4f3fe40a5328ddf21d64e9d2d03e328ac666d739f6967f681","0d6cda49751e7cb55d26d9c7e128a1cf6181db2b9a03671b6c1a26a6f61cf3fe","c53f56b5aa945fe63230ffcd2e7c267ddce1703cc2584bb5841c902b964427a4","629ef0de6306a19122f44bbc73a2561a051229a9f4100dcf1f3c9735578cbd88","eb1b4df8cfec4f7dfac0d34b377871ad0627255e2124af37b6d25cd19f1230a2","882ae8cc6618a9cc9872c199377bff43b595af42a92a1ecddbd7eb119f7e4c68","9edf8fd8138a027caaef686c368d07007353a6ffe51f07430b2567967252f970"],"paragraph_range_zero_based":[6840,6863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6840"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":6864},{"literal_text_all_w_t_and_m_t":"3>initiate the procedure to indicate start as specified in clause 5.5.6.3;","paragraph_zero_based":6865},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE verifies the measurement gap situation only upon receiving the indication from upper layers. If at this point in time sufficient gaps are available, the UE does not initiate the procedure. Unless it receives a new indication from upper layers, the UE is only allowed to further repeat the procedure in the same PCell once per frequency of the target RAT if the provided measurement gaps are insufficient.","paragraph_zero_based":6866},{"literal_text_all_w_t_and_m_t":"NOTE 1a:When indication is received from upper layers for performing location measurement and there is pre-configured measurement gap configured (not preconfigured measurement gap for positioning), the UE considers this preconfigured measurement gap to be not sufficient if the measurement gap is not considered to be always activated according to clause 9.1.7.2 of TS 38.133 [14].","paragraph_zero_based":6867},{"literal_text_all_w_t_and_m_t":"1>if and only if upper layers indicate to stop performing location measurements towards E-UTRA or NR or stop subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":6868},{"literal_text_all_w_t_and_m_t":"2>if there is no activated preconfigured measurement gap for positioning:","paragraph_zero_based":6869},{"literal_text_all_w_t_and_m_t":"3>if there is previously triggered UL MAC CE transmission for the measurement gap activation for positioning:","paragraph_zero_based":6870},{"literal_text_all_w_t_and_m_t":"4>indicate to the lower layers to cancel the triggered UL MAC CE transmission for the measurement gap activation as specified in TS 38.321 [3];","paragraph_zero_based":6871},{"literal_text_all_w_t_and_m_t":"2>else if there is activated preconfigured measurement gap for positioning:","paragraph_zero_based":6872},{"literal_text_all_w_t_and_m_t":"3>trigger the lower layers to deactivate all the activated measurement gap(s) for positioning as specified in TS 38.321 [3].","paragraph_zero_based":6873},{"literal_text_all_w_t_and_m_t":"2>if there is configured measurement gap used for positioning and the measurement gap is not the activated preconfigured measurement gap for positioning:","paragraph_zero_based":6874},{"literal_text_all_w_t_and_m_t":"3>initiate the procedure to indicate stop as specified in 5.5.6.3.","paragraph_zero_based":6875},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE may initiate the procedure to indicate stop even if it did not previously initiate the procedure to indicate start.","paragraph_zero_based":6876},{"literal_text_all_w_t_and_m_t":"5.5.6.3Actions related to transmission of LocationMeasurementIndication message","paragraph_zero_based":6877},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of LocationMeasurementIndication message as follows:","paragraph_zero_based":6878},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of location related measurements:","paragraph_zero_based":6879},{"literal_text_all_w_t_and_m_t":"2>if the procedure is initiated for RSTD measurements towards E-UTRA:","paragraph_zero_based":6880},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the eutra-RSTD according to the information received from upper layers;","paragraph_zero_based":6881},{"literal_text_all_w_t_and_m_t":"2>else if the procedure is initiated for positioning measurement towards NR:","paragraph_zero_based":6882},{"literal_text_all_w_t_and_m_t":"3>set the measurementIndication to the nr-PRS-Measurement according to the information received from upper layers;","paragraph_zero_based":6883},{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of location related measurements:","paragraph_zero_based":6884},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":6885},{"literal_text_all_w_t_and_m_t":"1>if the procedure is initiated to indicate start of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":6886},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value eutra-FineTimingDetection;","paragraph_zero_based":6887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c3d610edb41c7d3fba5aaccb42cb61777870ea196d704f0202d9510d2295a5d4","8e4ba4d408a2cb576d833bcc412a6a98a9f6df500fdb91f35eeb3351d4d71369","8bbba6bad7452f35106f831273a41a08df3cf7449c0d28afccf1dbce6ccb6047","1719588cbb2582cffccd7147c4f605e0d1e46e51be914f74c50390ff84ff880b","a03836d88757e02bbd0663972b37bb2fd78e2103fd8cacb5d9de80bdb489cb7b","f5247a12cc3548f31062a901cbdcc4b0aa929db7fe4b1e8068366430ab34e3af","771f8f429b2fc782ad6dcb40e7718fb9783dc8c5960e8f80db593ae197cc43a1","9e63f75c224cec8a4fc3afb339dfdfaabf488481641e1a6121d56b6c392a91e7","9659a1a73208795a9e7f3e44aa28c1bc67da9fa2bc746f6d1781b76ef90eea7a","687c67e5456709c0e6f9aa8c0c1357d31153cadadc9036764fd0c5a2cb54e1f2","23a2a84273330e030c04605e0fed9b22e3137d2fa173c5cf3bb7b25f278c87b7","6af9e00fb1d48ad71652226980c23981b20dd02b2e83ca264df1db1dfbd3b596","2275902d5d697f8c249c6298ef1484ac0061c61634584c39d82cbe0cb78c2821","27fe72782323403a63ae16443f7c7ca41d7918dfddb71fed4fb3125aad9ea706","9a068cdf301db5ba5f599cfe07e7011fbf905f1d985b1c22a75661965bd23f49","4d1ce2ed10d64619bb69298e5c5651ee4f50214b60452fa7993a4582ce281b41","1ebd29f22d4a1b5477850ae2374c5fc5e86bdb7c4a7cb923fefec20996a1712a","25d83f6cefcd1acabdcb41c452cc27cc1126c4aaf9fa33d15629a1972d58351e","f75efc74459fc35d2f970046c841b94cec7e2bbc161c4b3b6ec128f07a9dae53","d2b366100bb9ea3d7029550bcf02bfab3e2ee35994c0e0e033103affe8905164","8e42925d7ddfdc77c77a65654b576b18a15657d499bd62b661aa9f2f4749881b","60272fffa0581d19fb7fc1067b0b6034cb10a0f9df7e684c1587bc3d0c2a24d1","7ec92191f41f8ed08ea0f2f18b2af6660577e86f9e6cf114860167c2999c0d3a","d1721bdc784e312a27598f963d30c9aca6d49c49e18263bd430afefb57b74cc4"],"paragraph_range_zero_based":[6864,6887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6864"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else if the procedure is initiated to indicate stop of subframe and slot timing detection towards E-UTRA:","paragraph_zero_based":6888},{"literal_text_all_w_t_and_m_t":"2>set the measurementIndication to the value release;","paragraph_zero_based":6889},{"literal_text_all_w_t_and_m_t":"1>submit the LocationMeasurementIndication message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":6890},{"literal_text_all_w_t_and_m_t":"5.5aLogged Measurements","paragraph_zero_based":6891},{"literal_text_all_w_t_and_m_t":"5.5a.1Logged Measurement Configuration","paragraph_zero_based":6892},{"literal_text_all_w_t_and_m_t":"5.5a.1.1General","paragraph_zero_based":6893},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6895},{"literal_text_all_w_t_and_m_t":"Figure 5.5a.1.1-1: Logged measurement configuration","paragraph_zero_based":6896},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to configure the UE to perform logging of measurement results while in RRC_IDLE and RRC_INACTIVE. The procedure applies to logged measurements capable UEs that are in RRC_CONNECTED.","paragraph_zero_based":6897},{"literal_text_all_w_t_and_m_t":"NOTE:NG-RAN may retrieve stored logged measurement information by means of the UE information procedure.","paragraph_zero_based":6898},{"literal_text_all_w_t_and_m_t":"5.5a.1.2Initiation","paragraph_zero_based":6899},{"literal_text_all_w_t_and_m_t":"NG-RAN initiates the logged measurement configuration procedure to UE in RRC_CONNECTED by sending the LoggedMeasurementConfiguration message.","paragraph_zero_based":6900},{"literal_text_all_w_t_and_m_t":"5.5a.1.3Reception of the LoggedMeasurementConfiguration by the UE","paragraph_zero_based":6901},{"literal_text_all_w_t_and_m_t":"Upon receiving the LoggedMeasurementConfiguration message the UE shall:","paragraph_zero_based":6902},{"literal_text_all_w_t_and_m_t":"1>discard the logged measurement configuration as well as the logged measurement information as specified in 5.5a.2;","paragraph_zero_based":6903},{"literal_text_all_w_t_and_m_t":"1>store the received loggingDuration, reportType and areaConfiguration, if included, in VarLogMeasConfig;","paragraph_zero_based":6904},{"literal_text_all_w_t_and_m_t":"1>If the UE is in SNPN access mode:","paragraph_zero_based":6905},{"literal_text_all_w_t_and_m_t":"2>if the LoggedMeasurementConfiguration message includes snpn-ConfigList:","paragraph_zero_based":6906},{"literal_text_all_w_t_and_m_t":"3>set the snpn-ConfigIDList in VarLogMeasReport to include the current registered SNPN identity as well as SNPN identities in snpn-ConfigList;","paragraph_zero_based":6907},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":6908},{"literal_text_all_w_t_and_m_t":"3>set the snpn-ConfigIDList in VarLogMeasReport to include the current registered SNPN identity;","paragraph_zero_based":6909},{"literal_text_all_w_t_and_m_t":"1>else if the LoggedMeasurementConfiguration message includes plmn-IdentityList:","paragraph_zero_based":6910},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN as well as the PLMNs included in plmn-IdentityList;","paragraph_zero_based":6911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d564d553d96c7a5d846ed1b71fc5eb980387270467cebd378a33c7580f6120da","0eeb57c0bd62ada3c7eff72ce41fb3a74a5fe3f57cfa6ae7d52763c5ede1ff38","00d0254506c1cb9626d23247d775031be53401a49ea1cbc17f8daebc250ff5a5","f80d263f584d01f62fbf1593ea714ffcf050355e05518df41e6542ead9b1b8fd","37b7c3939a31e227fbb671c6b98013b9d7269bdf72640466ec90dc789ecbe8d5","f67b3fd21cf8b7d6ec17bfbe0a7522ac21c524705a7086f643d2a9e13e0141c4","91b448295f941787f83a0960927af10b11cdb0aa8b542948f90ff8712e47a637","8c7eaf4e908648258580cafbb65409fd6f13f29a816069e7811bd325aa85e096","1c4ad8bd60e1101ee93f1fa8698d7220e12c0439ed4254ec7af950e604c9c47c","a99e6728d37e23c117bbc8a95e3a5a7e235eaa7b8d346e45c8ae95f3aa6d0d21","7f65194be87da9d2960176e76ebb2f78a795d91120851810bcf4aa926449bbc7","0cba06e8aa7f1062759309b0025b3d0a2b0e176d8951229b50920b7b39ad08f1","59b31c26b613c2ddf6767f1a1e5387cb45cd21bb217cb31f19f5d4a2fa76a9b4","eaeda7d38601b735d5de7580447c93c69a69950a27b2c9b58a218c5fe0fd0125","cf2d5ec428a7208e6aa128a7569b2c4911ff7f1b5fb57dbf585591fe85f8b762","5c4bfe5f62cf3ae12c0a04944fff8652243508f62f128de523d290572ae91434","c28fea61079b9a40e3620fbe1bdc7119d2738d24ca90626b4dce9ecd4faee382","3374ee3643eec47ed4c57441d7924ebf66068ab8683ad9f0480c8f2645dc979f","04d82d7da858c87f7973b5bd250432fde4b5a86f9c43cceeb1bf9b26d318c422","ca2f34a8fb4990bd3082fa00c2de0f108d5206c8a01c74ccb31d8bcd9ce2443a","320a1a60eb9a93aac16303a3a076bcf9d012b4b32e6951a0645bcdaee8f20db0","667264c32af766119218198153df52f792a1e5e33e9de5811b344cc17ccc0d0e","9056050e511540504385247f360d4ba64c3ccba08eae17377a31d4fe8c2eca63","7ed7b05136db30deef0362d952b75baf4760eb6c9e778a10e1070bca570d7dbd"],"paragraph_range_zero_based":[6888,6911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6888"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":6912},{"literal_text_all_w_t_and_m_t":"2>set plmn-IdentityList in VarLogMeasReport to include the RPLMN;","paragraph_zero_based":6913},{"literal_text_all_w_t_and_m_t":"1>store the received absoluteTimeInfo, traceReference, traceRecordingSessionRef, and tce-Id in VarLogMeasReport;","paragraph_zero_based":6914},{"literal_text_all_w_t_and_m_t":"1>store the received bt-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":6915},{"literal_text_all_w_t_and_m_t":"1>store the received wlan-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":6916},{"literal_text_all_w_t_and_m_t":"1>store the received sensor-NameList, if included, in VarLogMeasConfig;","paragraph_zero_based":6917},{"literal_text_all_w_t_and_m_t":"1>start timer T330 with the timer value set to the loggingDuration;","paragraph_zero_based":6918},{"literal_text_all_w_t_and_m_t":"1>store the received sigLoggedMeasType, if included, in VarLogMeasReport;","paragraph_zero_based":6919},{"literal_text_all_w_t_and_m_t":"1>store the received earlyMeasIndication, if included, in VarLogMeasConfig;","paragraph_zero_based":6920},{"literal_text_all_w_t_and_m_t":"5.5a.1.4T330 expiry","paragraph_zero_based":6921},{"literal_text_all_w_t_and_m_t":"Upon expiry of T330 the UE shall:","paragraph_zero_based":6922},{"literal_text_all_w_t_and_m_t":"1>release VarLogMeasConfig;","paragraph_zero_based":6923},{"literal_text_all_w_t_and_m_t":"The UE is allowed to discard stored logged measurements, i.e. to release VarLogMeasReport, 48 hours after T330 expiry.","paragraph_zero_based":6924},{"literal_text_all_w_t_and_m_t":"5.5a.2Release of Logged Measurement Configuration","paragraph_zero_based":6925},{"literal_text_all_w_t_and_m_t":"5.5a.2.1General","paragraph_zero_based":6926},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to release the logged measurement configuration as well as the logged measurement information.","paragraph_zero_based":6927},{"literal_text_all_w_t_and_m_t":"5.5a.2.2Initiation","paragraph_zero_based":6928},{"literal_text_all_w_t_and_m_t":"The UE shall initiate the procedure upon receiving a logged measurement configuration in same or another RAT. The UE shall also initiate the procedure upon power off or upon deregistration.","paragraph_zero_based":6929},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6930},{"literal_text_all_w_t_and_m_t":"1>stop timer T330, if running;","paragraph_zero_based":6931},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the logged measurement configuration as well as the logged measurement information, i.e. release the UE variables VarLogMeasConfig and VarLogMeasReport.","paragraph_zero_based":6932},{"literal_text_all_w_t_and_m_t":"5.5a.3Measurements logging","paragraph_zero_based":6933},{"literal_text_all_w_t_and_m_t":"5.5a.3.1General","paragraph_zero_based":6934},{"literal_text_all_w_t_and_m_t":"This procedure specifies the logging of available measurements by a UE in RRC_IDLE and RRC_INACTIVE that has a logged measurement configuration. The actual process of logging within the UE, takes place in RRC_IDLE state could continue in RRC_INACTIVE state or vice versa.","paragraph_zero_based":6935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c776ab0115ca6de1ce88894ac609c9ff781ec194cdf9bcb08aab8b01b744c73e","ed653143361eb0f288e3d419a8aefe16ac784965629cf58e794a5b725cd359f5","e1b5f1cfaaf0ee1802f30f755162652e52d16fed6180a65e19177752a8b11c70","b55de2f65384e3a32afc67d9f10f9b022eec9903b0d7ca26452c344e2fef1269","5d46235d7a1f4a6208d7084ead529e17e3b50911da048bbdd5ff6fbfaaa073cc","b2bf058ead6fce30c897da646a06f90e908ece01125b3bcb88fda1c69961a43c","e10835ce4a332d9fb85a37047dd3a549c6f581b62e793769cf06d91d9be1b4b4","e7f3200f1800d99550eb6b066a62f99903a29d311327002b15e9243bc3e117c9","185de6c9d9110b73adca71a9e541047f694d4e20d545596ace489f7cdd78fb5b","87eca28495765b531bceda78ed839b8a75abdb892253093fda9e7857e65faaf5","bf3e96a9a38b9638cf123667d4e2ea8e6f6ce91850a6eda54ee95c83088db493","4cf224ae5be1504df50110879c152be5d7dd612b98770eba7cd4431b3b575078","aacec85e33891006adf7e67caa6054a744c90f8f1fb9b56716b3a5cc873391d0","d087e0781eb0afb453ede51e1c8f948b74256c52a399eda47e44791351ec7c83","3bc425900c1e48b21bc2856a225e3f0285cc0d585c1cff8a52c74d9e5e471845","2799066a7ba6a0bbef15c55e17a18dfe63c4fa1ad2072732d6d91ccae9463674","3628901984e5648aa3456d47aebcde8890cedb9ff884308c3e039e14ae4a8ced","0a43d6404dfd11f733e489d0295e7693d2522c6ff61bec42783259b7b6aca7aa","3e4d77d8674627db268cb7121de15c0d8763abff7c87e214856c30537be89a75","f9caf185a3543052689adb64374797f134bb6a27f2f22c8a36c08c2e678e3918","e8893f1de7b6788ebfac30878862427a415198ac29de9d49ff6930507a778caf","4e85bec88625320fbe913a8691cc4e4d99c3f49c4ce258a31d8d9c77a45688ee","a08fde1fb6483768e28e18013fdff31ef508b5dd44140c036c4ff663f8257b3f","7a4d3a0d25ed1022533537fda8ec7278af0a96bdec43e128179cd078acf95846"],"paragraph_range_zero_based":[6912,6935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6912"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5a.3.2Initiation","paragraph_zero_based":6936},{"literal_text_all_w_t_and_m_t":"While T330 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":6937},{"literal_text_all_w_t_and_m_t":"1>if measurement logging is suspended:","paragraph_zero_based":6938},{"literal_text_all_w_t_and_m_t":"2>if during the last logging interval the IDC problems detected by the UE is resolved, resume measurement logging;","paragraph_zero_based":6939},{"literal_text_all_w_t_and_m_t":"1>if not suspended, perform the logging in accordance with the following:","paragraph_zero_based":6940},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":6941},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":6942},{"literal_text_all_w_t_and_m_t":"4>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":6943},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; or","paragraph_zero_based":6944},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the registered SNPN identity is included in snpn-ConfigIDList stored in VarLogMeasReport:","paragraph_zero_based":6945},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":6946},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig; or","paragraph_zero_based":6947},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by cag-ConfigList in areaConfiguration in VarLogMeasConfig; or","paragraph_zero_based":6948},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by snpn-ConfigList in areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":6949},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals, as defined by the loggingInterval in the VarLogMeasConfig;","paragraph_zero_based":6950},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered, and eventType is set to outOfCoverage:","paragraph_zero_based":6951},{"literal_text_all_w_t_and_m_t":"3>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the UE is in any cell selection state;","paragraph_zero_based":6952},{"literal_text_all_w_t_and_m_t":"3>upon transition from any cell selection state to camped normally state in NR:","paragraph_zero_based":6953},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport, or if the registered SNPN identity is included in snpn-ConfigIDList stored in VarLogMeasReport; and","paragraph_zero_based":6954},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the current camping cell is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig, or if the current camping cell is part of the area indicated by cag-ConfigList of areaConfiguration in VarLogMeasConfig, or if the current camping cell is part of the area indicated by snpn-ConfigList of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":6955},{"literal_text_all_w_t_and_m_t":"5>perform the logging;","paragraph_zero_based":6956},{"literal_text_all_w_t_and_m_t":"2>else if the reportType is set to eventTriggered and eventType is set to eventL1:","paragraph_zero_based":6957},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the RPLMN is included in plmn-IdentityList stored in VarLogMeasReport; or","paragraph_zero_based":6958},{"literal_text_all_w_t_and_m_t":"3>if the UE is in camped normally state on an NR cell and if the registered SNPN identity is included in snpn-ConfigIDList stored in VarLogMeasReport:","paragraph_zero_based":6959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f5d234a67e3da6198d0e2cbd9012fa6df1d1fc073bff44f83e5249a6a81ef845","50caae0d21d727178b401387bbc279a5c9905aae1b881372ba97f8b3bbc91b18","45f29ba7cda5defe0c5f1114a6222ddb29d9e3b129a79bba7b595ee21f08dec5","aa1fca29bb148f61063bb22b8ede9e59387cd14b2fb0aed5b9c2fc6273aa2696","f026b5ff4fc8366cea20722a13abc5e8ebc54fcc773d43a73c647b5b52966d30","d8d0fd2176f42f9780d36a9c5db0cd824e7bff20a6c70eb3f3bc08a52c35e3b7","cab0af6fd6df0a86216d73b43b35854d60bbe7adc2dc48d27ef98dc67a9c84d3","1abf571b3adab4e330e9b68e8fa85bc58517a1005edc2a6eb32c795bb5a40feb","0fde29db2eb72557afd88e4661c1a44c67c064fcd2a9f88b9d60779b78f2f351","6a6e33497659630ac1090b780603362a204d05217d3eabc08903c60d71c6b650","94ee018049cfb14e8e2ef8b677334061b1552e47b77ecd4841be1a093fc5808b","e914747ed0edefa50e600324a8af092b93dda265f124dea14df0ad5038dff6dd","659e2fead8573c980f4f4af12a9b01fc1628094211a385bb4960c7da8ea7d690","a20c1738a628e09fe1dc49fd3a52d763f86c1d9a021d0ff322f6bdd327951789","b0820ad200fb4e64afd0411a96da89bac3aa0a6c6b1a524980337d14d130de80","7071f5bb4e8e98925b05b6b1ec52d57dd76717714f3d0f1efe94e2862c51f703","3c577d787f727371de9b43cd3e9c6e2937a22fe14a8e28d7601541190785fe13","f21c6d52e91c09568564f6e02c6c41193bc0296ac33622608da33228793b0f72","d98c804d4030c63138a166005787e97a443073bca2c94f957adb6b9f7a157dde","eb29d35678a34571028b030ccf2194d55647d01bd684533305d049ac02481bd8","d6a121d7429d064805f26a0680f21a39bdd371ce5770c03e95d7a7cefa71c7b4","a4b979836e93a2e90ad0a9b4254096a48e887204bd89dd602afda519ba977c68","28baaf9ff05cf77bba351977b8220c97ba9b93cb62fd43237def0ae5c6ca3971","8f9470c4f82501d38ad72ebbdabad96a99ef423b0eb0c06949a63f0a09848559"],"paragraph_range_zero_based":[6936,6959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6936"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig; or","paragraph_zero_based":6960},{"literal_text_all_w_t_and_m_t":"4>if the serving cell is part of the area indicated by areaConfig in areaConfiguration in VarLogMeasConfig; or","paragraph_zero_based":6961},{"literal_text_all_w_t_and_m_t":"4>if the current serving cell is part of the area indicated by cag-ConfigList of areaConfiguration in VarLogMeasConfig, or if the current camping cell is part of the area indicated by snpn-ConfigList of areaConfiguration in VarLogMeasConfig;","paragraph_zero_based":6962},{"literal_text_all_w_t_and_m_t":"5>perform the logging at regular time intervals as defined by the loggingInterval in VarLogMeasConfig only when the conditions indicated by the eventL1 are met;","paragraph_zero_based":6963},{"literal_text_all_w_t_and_m_t":"2>when performing the logging:","paragraph_zero_based":6964},{"literal_text_all_w_t_and_m_t":"3> if InterFreqTargetInfo is configured and if the UE detected IDC problems on at least one of the frequencies included in InterFreqTargetInfo or any inter-RAT frequency during the last logging interval, or","paragraph_zero_based":6965},{"literal_text_all_w_t_and_m_t":"3>if InterFreqTargetInfo is not configured and if the UE detected IDC problems during the last logging interval:","paragraph_zero_based":6966},{"literal_text_all_w_t_and_m_t":"4>if measResultServingCell in the VarLogMeasReport is not empty:","paragraph_zero_based":6967},{"literal_text_all_w_t_and_m_t":"5>include inDeviceCoexDetected;","paragraph_zero_based":6968},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging from the next logging interval;","paragraph_zero_based":6969},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":6970},{"literal_text_all_w_t_and_m_t":"5>suspend measurement logging;","paragraph_zero_based":6971},{"literal_text_all_w_t_and_m_t":"3>set the relativeTimeStamp to indicate the elapsed time since the moment at which the logged measurement configuration was received;","paragraph_zero_based":6972},{"literal_text_all_w_t_and_m_t":"3>if location information became available during the last logging interval, set the content of the locationInfo as in 5.3.3.7:","paragraph_zero_based":6973},{"literal_text_all_w_t_and_m_t":"3>if the UE is in any cell selection state (as specified in TS 38.304 [20]):","paragraph_zero_based":6974},{"literal_text_all_w_t_and_m_t":"4>set anyCellSelectionDetected to indicate the detection of no suitable or no acceptable cell found;","paragraph_zero_based":6975},{"literal_text_all_w_t_and_m_t":"4>if the reportType is set to eventTriggered in the VarLogMeasConfig; and","paragraph_zero_based":6976},{"literal_text_all_w_t_and_m_t":"4>if the RPLMN at the time of entering the any cell selection state is included in plmn-IdentityList stored in VarLogMeasReport or if the registered SNPN identity at the time of entering the any cell selection state is included in snpn-ConfigIDList stored in VarLogMeasReport; and","paragraph_zero_based":6977},{"literal_text_all_w_t_and_m_t":"4>if areaConfiguration is not included in VarLogMeasConfig or if the last suitable cell that the UE was camping on is part of the area indicated by areaConfig of areaConfiguration in VarLogMeasConfig, or if last suitable cell that the UE was camping on is part of the area indicated by cag-ConfigList of areaConfiguration in VarLogMeasConfig, or if last suitable cell that the UE was camping on is part of the area indicated by snpn-ConfigList of areaConfiguration in VarLogMeasConfig:","paragraph_zero_based":6978},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last suitable cell that the UE was camping on;","paragraph_zero_based":6979},{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last suitable cell the UE was camping on;","paragraph_zero_based":6980},{"literal_text_all_w_t_and_m_t":"4>else if the reportType is set to periodical in the VarLogMeasConfig:","paragraph_zero_based":6981},{"literal_text_all_w_t_and_m_t":"5>set the servCellIdentity to indicate global cell identity of the last logged cell that the UE was camping on;","paragraph_zero_based":6982},{"literal_text_all_w_t_and_m_t":"5>set the measResultServingCell to include the quantities of the last logged cell the UE was camping on;","paragraph_zero_based":6983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8c288aacb233637af58dad8ebf557b8ec9c477cb98a4eb879850212454d8bc57","64d9aa7d21e573a8970976d50da57780881310ee74b4044b73a1eda81c6247f9","450e25382c93e406d471338a1012c04766336396f1065e11224cae7f6a7efdc9","1fbaf50b72241d72f0c1251e0d7273a659a82d57c89f3bc44579ec0c2caf995c","edbd31009d9b7d83a9a2d719bdf31118179cf5158a79bb7554095caa73a0ae2c","9007d50ce209c0137baa019a34f29498aecdf3befee84faa9503ded3db162719","c559a7814058fe0cb1ba102e2a0aef6cd5675e8de7b823eed949c3f46da83633","155ae173e85d2e84cc17a9e07fbbc791aeae3c843a946614542e3d4f4caf054a","db08557015aff87e61eddae9e9340f8f5e334dda05b336a3de1fb76e297a3337","bbef950b76eec4c92f4109cd0a62fec637dd4893c309248ca358ea9c2fecaee0","6a11cc20df515acbe99d9141553c955b8c4120d84ef2e6120ca112666d9af053","4d865b720624276081c5ae8c9cf18ffbb675566ee876b984823443e775260736","718d03d2cc71f0a71077bf0163aeb584a6bce46cea26f6581a11c47e3cbaa83f","ef2379fc7a416835894060af421310807a1a38c0fb668b382b25e1754f331085","dbb98db36d392a3e4580736e1c0a514c0a4d5eac180acc802dba1e4c08b4c484","87f8c296259e0cb849bc7c6d3b30f32fb3577ff9d05f039f813edc63a91c403c","b2c32dbe347c4cf49ca6eb9a06f3d6d5523ee74a8328a79c87aa64ff730c10ff","67d60bba2059136e194b0ad31fbabbb7d5e76ca51a13b52915e45042d938531e","b2504abaddb8c84fba8df23ca8c4b33707d58cb4e90f8fc1e7a0b8e903977f7f","a3a8dfd1e412416cc859bec723a29fb09cbb4f0e24a2cf99aaf808c5ebc6c904","6dbea457ed555dcc9882e8943a0d8a4c16edc0af6fcaf684a7e7192a01ff3c39","e7b273e44f6128e352ed6d84e92ac52e27ae67eae4d4d36e74de08993d1e25e2","ac3b598a071b202b44832da9fe4e6c263862f1dd2bc11eab853409727e68e39e","f88c2fb21d0b3dc0f85939940409d2c49928b9adfadd48f5618ab0704492e6e3"],"paragraph_range_zero_based":[6960,6983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":6984},{"literal_text_all_w_t_and_m_t":"4>set the servCellIdentity to indicate global cell identity of the cell the UE is camping on;","paragraph_zero_based":6985},{"literal_text_all_w_t_and_m_t":"4>set the measResultServingCell to include the quantities of the cell the UE is camping on;","paragraph_zero_based":6986},{"literal_text_all_w_t_and_m_t":"3>if available, set the measResultNeighCells, in order of decreasing ranking-criterion as used for cell re-selection, to include measurements of neighbouring cell that became available during the last logging interval and according to the following:","paragraph_zero_based":6987},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 6 neighbouring cells on the NR serving frequency and for at most 3 cells per NR neighbouring frequency and for the NR neighbouring frequencies in accordance with the following:","paragraph_zero_based":6988},{"literal_text_all_w_t_and_m_t":"5>if interFreqTargetInfo is included in VarLogMeasConfig:","paragraph_zero_based":6989},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":6990},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and either in measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":6991},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6992},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in both interFreqTargetInfo and SIB4;","paragraph_zero_based":6993},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":6994},{"literal_text_all_w_t_and_m_t":"6>if earlyMeasIndication is included in VarLogMeasConfig;","paragraph_zero_based":6995},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in either measIdleCarrierListNR (within the VarMeasIdleConfig) or SIB4;","paragraph_zero_based":6996},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":6997},{"literal_text_all_w_t_and_m_t":"7>include measurement results for NR neighbouring frequencies that are included in SIB4;","paragraph_zero_based":6998},{"literal_text_all_w_t_and_m_t":"4>include measurement results for at most 3 neighbours per inter-RAT frequency in accordance with the following:","paragraph_zero_based":6999},{"literal_text_all_w_t_and_m_t":"5>if earlyMeasIndication is included in VarLogMeasConfig:","paragraph_zero_based":7000},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT neighbouring frequencies that are included in either measIdleCarrierListEUTRA (within the VarMeasIdleConfig) or SIB5;","paragraph_zero_based":7001},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":7002},{"literal_text_all_w_t_and_m_t":"6>include measurement results for inter-RAT frequencies that are included in SIB5;","paragraph_zero_based":7003},{"literal_text_all_w_t_and_m_t":"4>for each neighbour cell included, include the optional fields that are available;","paragraph_zero_based":7004},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE includes the latest results of the available measurements as used for cell reselection evaluation in RRC_IDLE or RRC_INACTIVE, which are performed in accordance with the performance requirements as specified in TS 38.133 [14].","paragraph_zero_based":7005},{"literal_text_all_w_t_and_m_t":"NOTE 2:For logging the measurements on frequencies (indicated in measIdleCarrierListNR/ measIdleCarrierListEUTRA) in the logged measurement, the qualityThreshold in measIdleConfig should not be applied, and how the UE logs the measurements on the frequencies is left to the UE implementation.","paragraph_zero_based":7006},{"literal_text_all_w_t_and_m_t":"2>when the memory reserved for the logged measurement information becomes full, stop timer T330 and perform the same actions as performed upon expiry of T330, as specified in 5.5a.1.4.","paragraph_zero_based":7007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9e3580f0016212df4ba91008b9e4c5425a3bf74a911749b08e519d90b31c9add","a952bbc352726bc954856c030c4f1f02b89c6f6622d7ee25ebafc18063c5d0b9","4d512bc601616aee97f33c88ae56804cba057b033506c02ee132ee7f53371587","a1eacad0bf77afadbeb8e71b750688943357f419b958e39cf2af3bcc8dc42acd","f656d1b9fd18004b7c7a5c1006173a2c3597ea3e66992ab860032d5c3edd6a4e","35cbb8095360565e2230a63857c84513970d27f7a30d2027da2e002c1058c956","e8a4d9a31457c4b5f936f95c307167ebd4fc63989f3f1b3bd875ade7a662267b","1ddcb79528b2ba08de843bfa6bc756c041c588ba80d10eabf5aa79a5aaceaaf3","6a6b28ee7434dfb8babcf3c13adf1cd163ffaba1cbe911776b360e5fc9891646","92fd538004ee6adcd7e723c1a98b27ec4db650efbf18c58338ed4f24cf2b265e","559f5c9a6953664de8c4cfa11257d85d6e6b32ae6c696c415496043d1ffde475","6d61ca82530a1cfb1378b74439d7027fa62ed987b51132e2bfd9860086ae5a4f","699589a0f5a92e930b2bd15a133eb5aa64b29b9650344469dea2b962ecf14119","2879a2b800cd9c365cc21c6ac7d0c0b3265f37bb054fab7efb5de2721c492f20","19330f981e624d34f45714dda1781986aa0d38d101c1a540312e394f5ff08824","3978bbc652b8cf18b68644879d11b51fd4fffc230961b6e6b0a1f80f1570249a","c658f868b0460593b368d942578e9cdf28764a041ddbbed151c184d34b027eaa","6fa4ce84076e9627aa5a30b42c3427a596be37214930a7bd8e6f03e2d7c419c9","802c0631a4bbf827b7cf1e17134b6e8b8596e66d6141189fdc4ad8fee0bc5a18","61556500c5817254d7e562b36eb4221bd3fa97a2a7b52979204a2f20f4168fa1","ec32714fb1f724deb44212857ec034e1e42483882c1971ee89853312aff06f66","1c3a5025da662fdba8b46d33ee433b2482d3723403ab56762038bd40c3d3550f","d6013c52fb77b81ce51930f76ca07b5229f013192f9c1601444b1dfad615a69a","85a34e0971c804b70539ced459867ecfd533c4336e50eebcda808057cff4f5e2"],"paragraph_range_zero_based":[6984,7007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6984"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5bApplication Layer Measurements in RRC_IDLE/RRC_INACTIVE","paragraph_zero_based":7008},{"literal_text_all_w_t_and_m_t":"5.5b.1Area handling and storing of Application Layer Measurement reports in RRC_IDLE/RRC_INACTIVE","paragraph_zero_based":7009},{"literal_text_all_w_t_and_m_t":"5.5b.1.1General","paragraph_zero_based":7010},{"literal_text_all_w_t_and_m_t":"This procedure specifies the area handling and storing of application layer measurement report containers by a UE in RRC_IDLE and RRC_INACTIVE that has an application layer measurement configuration with appLayerIdleInactiveConfig configured.","paragraph_zero_based":7011},{"literal_text_all_w_t_and_m_t":"5.5b.1.2Initiation","paragraph_zero_based":7012},{"literal_text_all_w_t_and_m_t":"While in RRC_INACTIVE and RRC_IDLE state, the UE shall:","paragraph_zero_based":7013},{"literal_text_all_w_t_and_m_t":"1>store any previously or subsequently received application layer measurement report containers associated with the measConfigAppLayerId for which not all segments, or full message, has been submitted to lower layers for transmission;","paragraph_zero_based":7014},{"literal_text_all_w_t_and_m_t":"NOTE:The UE continues storing application layer measurement report containers for MBS broadcast service in RRC_CONNECTED as long as stored application layer measurement configurations/reports have not been retrieved.","paragraph_zero_based":7015},{"literal_text_all_w_t_and_m_t":"1>if the memory reserved for storing application layer measurement report containers becomes full:","paragraph_zero_based":7016},{"literal_text_all_w_t_and_m_t":"2>if the reports are associated with a configuration including appLayerMeasPriority:","paragraph_zero_based":7017},{"literal_text_all_w_t_and_m_t":"3>discard reports in priority order where reports with the lowest priority are discarded first, and among reports with equal associated priority, discard reports in the order they were received, where older reports are discarded first;","paragraph_zero_based":7018},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7019},{"literal_text_all_w_t_and_m_t":"3>discard reports in the order they were received, where older reports are discarded first;","paragraph_zero_based":7020},{"literal_text_all_w_t_and_m_t":"1>if qoe-AreaScope is configured:","paragraph_zero_based":7021},{"literal_text_all_w_t_and_m_t":"2>if the cell where the UE receives the service when the UE transits from RRC_CONNECTED state to RRC_INACTIVE or RRC_IDLE state is part of the area indicated by qoe-AreaScope:","paragraph_zero_based":7022},{"literal_text_all_w_t_and_m_t":"3>inform upper layers of being inside the area;","paragraph_zero_based":7023},{"literal_text_all_w_t_and_m_t":"2>if the cell where the UE receives the service when the UE transits from RRC_CONNECTED state to RRC_INACTIVE or RRC_IDLE state is not part of the area indicated by qoe-AreaScope:","paragraph_zero_based":7024},{"literal_text_all_w_t_and_m_t":"3>inform upper layers of being outside the area.","paragraph_zero_based":7025},{"literal_text_all_w_t_and_m_t":"2>if the UE re-selects to a new cell which is part of the area indicated by qoe-AreaScope and the previous cell was not part of the area indicated by qoe-AreaScope:","paragraph_zero_based":7026},{"literal_text_all_w_t_and_m_t":"3>inform upper layers of being inside the area;","paragraph_zero_based":7027},{"literal_text_all_w_t_and_m_t":"2>if the UE re-selects to a new cell which is not part of the area indicated by qoe-AreaScope and the previous cell was part of the area indicated by qoe-AreaScope:","paragraph_zero_based":7028},{"literal_text_all_w_t_and_m_t":"3>inform upper layers of being outside the area.","paragraph_zero_based":7029},{"literal_text_all_w_t_and_m_t":"5.6UE capabilities","paragraph_zero_based":7030},{"literal_text_all_w_t_and_m_t":"5.6.1UE capability transfer","paragraph_zero_based":7031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4df39baf110bbb8a45924d57e45444265414cd156eab18d17afb1a511ebb660a","a01f18d8ebb7181771194ddaa6a60d4b47ccd86ec9c74e0c4861c4dfa521b0c6","d43f9411160098321f8acd0a9475c4af25338b6f9c8bdf1888fb40b3379900e5","a3639956d11025f435427f8e5f2f11f1f986ae2df511fffd96176939f864a4ee","33d5f302087e49127efaac4c3ca54966a635b4e285dc2c0428fbcd19f307314c","d597c91da47fd0b5bbc1b8e2769d1208764e67f3db47aeeb9acb2ee178fcb805","f6ea55ae0464bccd5789fa51bbe39351fce7b352e6a22ba7bafc03ae928a2e2e","fc62d687f9f0cff7f3267de8915856ef845e34c1394aa73b648fc3770b5df217","3ce9208fee0d5336e1dde4c97fb79533c5a466c1ce051204e1b594a9f21d85d7","046401a26969b956c28d7625602586c2ea71a2a02d328c9fe30adb5864a67b38","325ba8c6bc84de47e4ab52440ff223325236c4175c846ff51b9ae2f5bb2a64b2","0cce9b83dc8190de7c442332332b2b096600e9ce4a1c114fc63f027cd7cab4d1","703d32db38f3a4c9fd977955e7f88d9b6f216b0aa472b2f53991422f3a0bc29f","234dc79b5d2d6068c1b931c899b1d33932ed48eb943909d003d6893b85087f48","596571949ef70c7a4e5db015d81a8f969462fe8d21d9fc831a7aa6ed03819cec","875ece58de25ccfc51da0edfbbab1bdeb897f00bfc46a6bcfb2211099d021670","837b8d0a82a2073c17696961039df8f7de913cd31871fe30a60030ba767bdce8","e29af3ffe55f97ae2a52d363f391a3b33169d8cf1a3ff70a55debebc8f32e9c6","c099ee7ce0b4dcdb882261886a95b8d5ca9e25d3bae9b46684ef7ebb1d537560","eba4a9bad5ca211174d7e2b42fa51fa8b3cbedf92448c757a3291b2ee2a96265","d832e489ea8f7bad9cfc8ab600eadbfc850e73a9e91bda110d441a49de3f542d","7d54dce382442c7558c9608c700b2157e6acc7d02b97740a27532fc326807384","2f16f1c6adb8f13e13a78fe117a2652be268e82ac24ce5583072b51fa7fbbc22","62d03fca30f60521b48dea5071e119c2fa4c3997469e960ca5bb6ab0aaf90240"],"paragraph_range_zero_based":[7008,7031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7008"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.6.1.1General","paragraph_zero_based":7032},{"literal_text_all_w_t_and_m_t":"This clause describes how the UE compiles and transfers its UE capability information upon receiving a UECapabilityEnquiry from the network.","paragraph_zero_based":7033},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7034},{"literal_text_all_w_t_and_m_t":"Figure 5.6.1.1-1: UE capability transfer","paragraph_zero_based":7035},{"literal_text_all_w_t_and_m_t":"5.6.1.2Initiation","paragraph_zero_based":7036},{"literal_text_all_w_t_and_m_t":"The network initiates the procedure to a UE in RRC_CONNECTED when it needs (additional) UE radio access capability information. The network should retrieve UE capabilities only after AS security activation. Network does not forward UE capabilities that were retrieved before AS security activation to the CN.","paragraph_zero_based":7037},{"literal_text_all_w_t_and_m_t":"5.6.1.3Reception of the UECapabilityEnquiry by the UE","paragraph_zero_based":7038},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of UECapabilityInformation message as follows:","paragraph_zero_based":7039},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to nr:","paragraph_zero_based":7040},{"literal_text_all_w_t_and_m_t":"2>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-NR-Capability and with the rat-Type set to nr;","paragraph_zero_based":7041},{"literal_text_all_w_t_and_m_t":"2>include the supportedBandCombinationList, featureSets and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":7042},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra-nr:","paragraph_zero_based":7043},{"literal_text_all_w_t_and_m_t":"2> if the UE supports (NG)EN-DC or NE-DC:","paragraph_zero_based":7044},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a UE-CapabilityRAT-Container of the type UE-MRDC-Capability and with the rat-Type set to eutra-nr;","paragraph_zero_based":7045},{"literal_text_all_w_t_and_m_t":"3>include the supportedBandCombinationList and featureSetCombinations as specified in clause 5.6.1.4;","paragraph_zero_based":7046},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to eutra:","paragraph_zero_based":7047},{"literal_text_all_w_t_and_m_t":"2>if the UE supports E-UTRA:","paragraph_zero_based":7048},{"literal_text_all_w_t_and_m_t":"3>include in the ue-CapabilityRAT-ContainerList a ue-CapabilityRAT-Container of the type UE-EUTRA-Capability associated with the terrestrial network and with the rat-Type set to eutra as specified in TS 36.331 [10], clause 5.6.3.3, according to the capabilityRequestFilter, if received;","paragraph_zero_based":7049},{"literal_text_all_w_t_and_m_t":"1>if the ue-CapabilityRAT-RequestList contains a UE-CapabilityRAT-Request with rat-Type set to utra-fdd:","paragraph_zero_based":7050},{"literal_text_all_w_t_and_m_t":"2>if the UE supports UTRA-FDD:","paragraph_zero_based":7051},{"literal_text_all_w_t_and_m_t":"3>include the UE radio access capabilities for UTRA-FDD within a ue-CapabilityRAT-Container and with the rat-Type set to utra-fdd;","paragraph_zero_based":7052},{"literal_text_all_w_t_and_m_t":"1>if the RRC message segmentation is enabled based on the field rrc-SegAllowed received, and the encoded RRC message is larger than the maximum supported size of a PDCP SDU specified in TS 38.323 [5]:","paragraph_zero_based":7053},{"literal_text_all_w_t_and_m_t":"2>initiate the UL message segment transfer procedure as specified in clause 5.7.7;","paragraph_zero_based":7054},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":7055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4fe0885ee91fe231a09c8a076c2da337b89743a5b4a4fa568532c6831cd5babe","40b047e9a59f63505f82420ebfa52c52392f573b5b3037bad1a6d34a4d760aa1","092e6bc50a807d345511f584d2b6f7442336efc315193ac5f341a3572c815986","f74aafaedb2c44578dc3e7206369f75443c69820344a313691e405c6b873f306","badf9ed212961aa9d379f6b6787656adf5c7e0f2e66b93f30c52cefa683203fa","d74b417ef3471f618aeee1d6d96f533262292d836db2fb099b12155664897f4e","d38b181fd2b8fc772b22ae77bf3d2f865282b7a4f2a3a1ef58ae45464e853a45","f7aa54223030d85b9fed14efcb7e9b224c5a8c61db253a5910553d6caf4fc7d3","469111d2b590417b152c61735c771c5c16763837bcd38f916747dcbea54ca3f0","3b4f54b16ba470088625bf3b63ab5143a4d8a958d1fcc3456ab082efba5855c7","c79e3ece853764c06d8db0bd53c29c76841f2769fa86d2143e21ef9e84670556","eabca87c843bd315d25b8c17e736e323f872a99779b4367440f42359201dc008","a1d15fe8c79f7834f0f1ef2fdbf048b2f8efbccb9e52b3197b7adbee46bb364d","b3a027fbccf3e98a5a3ca6b812ae1ef152b0cc82ae933e6302725f9541856cf5","1130a35819270ef4d0044ae632a4b7a44756f2b57c1d54ed78ab440c009bc96f","54d69c239661ef8ce632d9c4cbb69e0846c1d98261e45423e2c81aef2426e21d","5a348dd440609c6054c0eb8a3e86ff71a191761a1b3f9c4bfc23f338cedbc5e7","2e45360e956fec812d79842280433689eac5113ffee1b5e15c9e29908f5f2f49","82fac53b866588e4ee2d300ca17c0df4d1595de2cd420063b1622106537d0987","5ce8c3267c045646a0692422a767b7adcdc03a7dfbd1d59f8ffcb86ee54d7e3e","32935fa338a21a171a4bad650aae04e6fa6748dac236425526aa7bc0ec89f614","0dfcd83952f08d6a0ed0a995f5e8fbede0f100243e817c80cc237ced38f58941","9d2c68c995e282504a0775f9ad50b5444f9644094c7ee16889bbf4206fd44fa3","3fcea3a80ffd90e2ab87b3779bc49804f7c0cb1de0f3c3c052a10ee3eb04c53e"],"paragraph_range_zero_based":[7032,7055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7032"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>submit the UECapabilityInformation message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":7056},{"literal_text_all_w_t_and_m_t":"5.6.1.4Setting band combinations, feature set combinations and feature sets supported by the UE","paragraph_zero_based":7057},{"literal_text_all_w_t_and_m_t":"The UE invokes the procedures in this clause if the NR or E-UTRA network requests UE capabilities for nr, eutra-nr or eutra. This procedure is invoked once per requested rat-Type (see clause 5.6.1.3 for capability enquiry by the NR network; see TS 36.331 [10], clause 5.6.3.3 for capability enquiry by the E-UTRA network). The UE shall ensure that the feature set IDs are consistent across feature sets, feature set combinations and band combinations in all three UE capability containers that the network queries with the same fields with the same values, i.e. UE-CapabilityRequestFilterNR, UE-CapabilityRequestFilterCommon, rrc-SegAllowed and fields in UECapabilityEnquiry message (i.e. requestedFreqBandsNR-MRDC, requestedCapabilityNR, eutra-nr-only flag, requestedCapabilityCommon, and rrc-SegAllowed) as defined in TS 36.331 [10], where applicable.","paragraph_zero_based":7058},{"literal_text_all_w_t_and_m_t":"NOTE 1:Capability enquiry without frequencyBandListFilter is not supported.","paragraph_zero_based":7059},{"literal_text_all_w_t_and_m_t":"NOTE 2:In (NG)EN-DC, the gNB needs the capabilities for RAT types nr and eutra-nr and it uses the featureSets in the UE-NR-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the NR UE capabilities for the supported MRDC band combinations. Similarly, the eNB needs the capabilities for RAT types eutra and eutra-nr and it uses the featureSetsEUTRA in the UE-EUTRA-Capability together with the featureSetCombinations in the UE-MRDC-Capability to determine the E-UTRA UE capabilities for the supported MRDC band combinations. Hence, the IDs used in the featureSets must match the IDs referred to in featureSetCombinations across all three containers. The requirement on consistency implies that there are no undefined feature sets and feature set combinations.","paragraph_zero_based":7060},{"literal_text_all_w_t_and_m_t":"NOTE 3:If the UE cannot include all feature sets and feature set combinations due to message size or list size constraints, it is up to UE implementation which feature sets and feature set combinations it prioritizes.","paragraph_zero_based":7061},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":7062},{"literal_text_all_w_t_and_m_t":"1>if the UE is an eRedCap UE and the UE supports eRedCapIgnoreCapabilityFiltering, the UE, in the remainder of this procedure, assumes frequencyBandListFilter to be the filter containing all the supported bands of the UE;","paragraph_zero_based":7063},{"literal_text_all_w_t_and_m_t":"1>compile a list of \"candidate band combinations\" according to the filter criteria in capabilityRequestFilterCommon (if included), only consisting of bands included in frequencyBandListFilter, and prioritized in the order of frequencyBandListFilter (i.e. first include band combinations containing the first-listed band, then include remaining band combinations containing the second-listed band, and so on), where for each band in the band combination, the parameters of the band do not exceed maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL, maxCarriersRequestedUL, ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":7064},{"literal_text_all_w_t_and_m_t":"1>for each band combination included in the list of \"candidate band combinations\":","paragraph_zero_based":7065},{"literal_text_all_w_t_and_m_t":"2>if the network (E-UTRA) included the eutra-nr-only field, or","paragraph_zero_based":7066},{"literal_text_all_w_t_and_m_t":"2>if the requested rat-Type is eutra:","paragraph_zero_based":7067},{"literal_text_all_w_t_and_m_t":"3>remove the NR-only band combination from the list of \"candidate band combinations\";","paragraph_zero_based":7068},{"literal_text_all_w_t_and_m_t":"NOTE 4:The (E-UTRA) network may request capabilities for nr but indicate with the eutra-nr-only flag that the UE shall not include any NR band combinations in the UE-NR-Capability. In this case the procedural text above removes all NR-only band combinations from the candidate list and thereby also avoids inclusion of corresponding feature set combinations and feature sets below.","paragraph_zero_based":7069},{"literal_text_all_w_t_and_m_t":"2>if it is regarded as a fallback band combination with the same capabilities of another band combination included in the list of \"candidate band combinations\", and","paragraph_zero_based":7070},{"literal_text_all_w_t_and_m_t":"2>if this fallback band combination is generated by releasing at least one SCell or uplink configuration of SCell or SUL according to TS 38.306 [26]:","paragraph_zero_based":7071},{"literal_text_all_w_t_and_m_t":"3>remove the band combination from the list of \"candidate band combinations\";","paragraph_zero_based":7072},{"literal_text_all_w_t_and_m_t":"NOTE 5:Even if the network requests (only) capabilities for nr, it may include E-UTRA band numbers in the frequencyBandListFilter to ensure that the UE includes all necessary feature sets needed for subsequently requested eutra-nr capabilities. At this point of the procedure the list of \"candidate band combinations\" contains all NR- and/or E-UTRA-NR band combinations that match the filter (frequencyBandListFilter) provided by the NW and that match the eutra-nr-only flag (if RAT-Type nr is requested by E-UTRA). In the following, this candidate list is used to derive the band combinations, feature set combinations and feature sets to be reported in the requested capability container.","paragraph_zero_based":7073},{"literal_text_all_w_t_and_m_t":"1>if the requested rat-Type is nr:","paragraph_zero_based":7074},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList as many NR-only band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":7075},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":7076},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":7077},{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":7078},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":7079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["98bdea610295807047c811c02cf5f47ce40943a2af611664f685e24e4068b4b9","983be9a706a2e9c5ea5ac15997cf421233a0609b10d426533bef9e345d9e8fd7","47815f36beb9d562ae4a77af76995ba97d112f73511595611c8e7d3c687603d2","1077ecfa858792602590377d1dbc742f0418be54b39caed4101063ee726e65a6","023b42d07643fb9411cc26fb2293e344ddcb295934a638b822a4da78820c6a1b","ff314c2d8bd28476954e23de285f697298cb9c146ce957a20160b0b94a5d9f94","47b2ae8c2092649bf938e5682db303a488cb0bd2a8b0fbf4f166f20e8a6b3906","1d7b21b9e0178f6f13dacf0f690a0ce2b67a3f21c5ae9aba8a1c3fb8e0797b08","bf695acbc7d4f40c373f2b860ebefb86a85d6369ed812f0254bcf624c3e491f1","89953e089215155b6d4df79f6b42ad5035f74f03ac7caae57277434474af1c9c","fc9c4340bbbb046f90fb459ea3afc9059141e1c7d2124c644e4e29e6f73db34a","d14a9e06ed06421560e1e23fce4e99568f20c76c3a24fa232dfcff2b79c0ca9b","26a396a54551e994b939a177ebb1e998564323ddbb0c410297f130d13c4623d8","20fdb01c1211ecf3f217d463c027aa634ca04262f5b92a74372508660180fbe8","182253e18c3674ab759153facf0536b0842aaa7e1daa7dcb0d5d615445445430","7f6e53c0f53fc056874416c7b0038e7d2dfd98341f4368761b56f1b58032416a","86a0cb7c6b438e4932987b1ecd0e1465ac9135b5e9876513665ed937daa40aee","82b7a052ffee1a8910885654d787c67b3317eae746500ec26478d49898f6e36c","de8f33d6e3f58a5d5c4018b0fbd6815b76e89fcf9423cccfe040ea94703193f0","27b0545e81101754d60e5485f47c9bf975a10aec98cc2148fcc8235be2501cbb","09c818233fe4e39d3fb3bb2d6b711961bfa93c87fb920cdc20cf5866b3120281","cd79bcf89ecaf3cce66b791035cebe2d4111fddf0512ffe081bb3bf54b016824","378831b66921fba43fd5b375f1a93943751219b155eaf1929674c35c08b9b2af","47821f4e9fa70051587040a20e990cdadf2bd1379cb6baec67f99fd4e6195841"],"paragraph_range_zero_based":[7056,7079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7056"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":7080},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":7081},{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":7082},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many NR-only band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":7083},{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":7084},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":7085},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":7086},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":7087},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":7088},{"literal_text_all_w_t_and_m_t":"NOTE 6:This list of \"candidate feature set combinations\" contains the feature set combinations used for NR-only as well as E-UTRA-NR band combinations. It is used to derive a list of NR feature sets referred to from the feature set combinations in the UE-NR-Capability and from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":7089},{"literal_text_all_w_t_and_m_t":"2>if sidelinkRequest is received:","paragraph_zero_based":7090},{"literal_text_all_w_t_and_m_t":"3>for a sidelink band combination the UE included in supportedBandCombinationListSidelinkEUTRA-NR, supportedBandCombinationListSL-RelayDiscovery, supportedBandCombinationListSL-U2U-RelayDiscovery or supportedBandCombinationListSL-NonRelayDiscovery:","paragraph_zero_based":7091},{"literal_text_all_w_t_and_m_t":"4>if the UE supports partial sensing for a band of the sidelink band combination, include the partial sensing capabilities for the band using the sl-TransmissionMode2-PartialSensing-r17;","paragraph_zero_based":7092},{"literal_text_all_w_t_and_m_t":"3>set sidelinkRequested to true;","paragraph_zero_based":7093},{"literal_text_all_w_t_and_m_t":"2>include into featureSets the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed any of maxBandwidthRequestedDL, maxBandwidthRequestedUL, maxCarriersRequestedDL or maxCarriersRequestedUL, whichever are received;","paragraph_zero_based":7094},{"literal_text_all_w_t_and_m_t":"1>else, if the requested rat-Type is eutra-nr:","paragraph_zero_based":7095},{"literal_text_all_w_t_and_m_t":"2>include into supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only as many E-UTRA-NR band combinations as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":7096},{"literal_text_all_w_t_and_m_t":"3>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":7097},{"literal_text_all_w_t_and_m_t":"4>if SRS carrier switching is supported;","paragraph_zero_based":7098},{"literal_text_all_w_t_and_m_t":"5>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":7099},{"literal_text_all_w_t_and_m_t":"4>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":7100},{"literal_text_all_w_t_and_m_t":"2>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList according to the previous;","paragraph_zero_based":7101},{"literal_text_all_w_t_and_m_t":"2>if uplinkTxSwitchRequest is received:","paragraph_zero_based":7102},{"literal_text_all_w_t_and_m_t":"3>include into supportedBandCombinationList-UplinkTxSwitch as many E-UTRA-NR band combinations that supported UL TX switching as possible from the list of \"candidate band combinations\", starting from the first entry;","paragraph_zero_based":7103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["44282824f2b1bb731b6b66cd8684cef9fd3016e6a04c98c65ceec9aa84e70769","f0f11d3bbdac4589cb7859ad6860531bb5563fe5ef5db3a1a94ad1488cb71bee","5d61c2e41a2822f09fec0d1caa3c7516e5143cd619bd01383e560382f6cff21d","ad40de43aca109fb2b8ecd68ee1394573dd86b03321e43398901147594bf6af7","a24ef352fe35d3302409ffccae2d5117f71a8a792eff0ebb145175ae2935b38f","e39cbeadfbeadf76fffcfe66dcab287616302fd6af7f205df27212316ff55d90","4f84ad6424c01833cbe84888ff2ca3332a087040d75ad34f96426c0b3f8e8e6a","5f49f4633ed4b5186ba9cee2dc882a89d63d6ecf490039fe4a37543efcf5571a","50f34936634aa147265c6f50ab2c421c5f74ba924308a709647a31819d8f4163","24d38f74d40cbe270dc86881303550c7d8f1ce8f6284835d53ba7f1f28f3c8d5","d6ab0a5e613f92287dd0e2edcd83c1cff174014fbc80cb3d8eca30d855d6a4ec","102a531a809338415cfe07dd02f0b631550f00ca6f7021a24fc99b1cffaf1193","6c679645c52b4c314f0c3180220f4b9128e44a19dc18760fbd78e3d007494f05","d836272950c9cfefbc7849ca306ed5e2dcc5910c517ce9ce82d677060f01b107","822f116067278574ea22249a27759988bcc27bda55d3fb8a40e995183ac5d8ca","8491c82693dd37845ad607943717c1ed437e968b2904a4a7d5a4442d214feac1","6d84ba8737b8d3fdebd90483f11ec570a29c25cf6250b3b6990ab13708404413","5e375bd434ca9088375012cac85217c05d5e1871a23b1f107b933a910a68a917","d5d88ebcd49c586d6ad7e75de537cf95af4b800b804210abe4ce6d631392d959","e68263bf72fa5b0ee33b7cb40e634f5e9ff556fa8ed68a6449384b2416345518","7f3e4ecdf13b8e932d4f9d6c608fb2075ebb7a9d633550cd50a36573af8de8e1","6c50bcb104b0670238b38f2db6fb6d6c7412387e83b9b64f10f68b027753722f","558fca753de478fae8b6ad89528ceaa8cbdef782c76f05004f037cc65bb2145d","b3b37871cd04e409f4de9fc74307dfe85236c093598472c894505dd19b8356d2"],"paragraph_range_zero_based":[7080,7103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7080"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if srs-SwitchingTimeRequest is received:","paragraph_zero_based":7104},{"literal_text_all_w_t_and_m_t":"5>if SRS carrier switching is supported;","paragraph_zero_based":7105},{"literal_text_all_w_t_and_m_t":"6>include srs-SwitchingTimesListNR, srs-SwitchingTimesListEUTRA and srs-SwitchingAffectedBandsListNR for each band combination;","paragraph_zero_based":7106},{"literal_text_all_w_t_and_m_t":"5>set srs-SwitchingTimeRequested to true;","paragraph_zero_based":7107},{"literal_text_all_w_t_and_m_t":"3>include, into featureSetCombinations, the feature set combinations referenced from the supported band combinations as included in supportedBandCombinationList-UplinkTxSwitch according to the previous;","paragraph_zero_based":7108},{"literal_text_all_w_t_and_m_t":"1>else (if the requested rat-Type is eutra):","paragraph_zero_based":7109},{"literal_text_all_w_t_and_m_t":"2>compile a list of \"candidate feature set combinations\" referenced from the list of \"candidate band combinations\" excluding entries (rows in feature set combinations) with same or lower capabilities;","paragraph_zero_based":7110},{"literal_text_all_w_t_and_m_t":"NOTE 7:This list of \"candidate feature set combinations\" contains the feature set combinations used for E-UTRA-NR band combinations. It is used to derive a list of E-UTRA feature sets referred to from the feature set combinations in a UE-MRDC-Capability container.","paragraph_zero_based":7111},{"literal_text_all_w_t_and_m_t":"2>include into featureSetsEUTRA (in the UE-EUTRA-Capability) the feature sets referenced from the \"candidate feature set combinations\" and may exclude the feature sets with the parameters that exceed ca-BandwidthClassDL-EUTRA or ca-BandwidthClassUL-EUTRA, whichever are received;","paragraph_zero_based":7112},{"literal_text_all_w_t_and_m_t":"1>if the UE is an eRedCap UE and the UE supports eRedCapIgnoreCapabilityFiltering, i.e., it assumes frequencyBandListFilter to be the filter containing all the supported bands of the UE:","paragraph_zero_based":7113},{"literal_text_all_w_t_and_m_t":"2>include all the supported bands of the UE in the field appliedFreqBandListFilter, except if the requested rat-Type is nr and the network included the eutra-nr-only field;","paragraph_zero_based":7114},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":7115},{"literal_text_all_w_t_and_m_t":"2>include the received frequencyBandListFilter in the field appliedFreqBandListFilter of the requested UE capability, except if the requested rat-Type is nr and the network included the eutra-nr-only field;","paragraph_zero_based":7116},{"literal_text_all_w_t_and_m_t":"1>if the network included ue-CapabilityEnquiryExt:","paragraph_zero_based":7117},{"literal_text_all_w_t_and_m_t":"2>include the received ue-CapabilityEnquiryExt in the field receivedFilters;","paragraph_zero_based":7118},{"literal_text_all_w_t_and_m_t":"5.6.1.5Void","paragraph_zero_based":7119},{"literal_text_all_w_t_and_m_t":"5.7Other","paragraph_zero_based":7120},{"literal_text_all_w_t_and_m_t":"5.7.1DL information transfer","paragraph_zero_based":7121},{"literal_text_all_w_t_and_m_t":"5.7.1.1General","paragraph_zero_based":7122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7123},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1.1-1: DL information transfer","paragraph_zero_based":7124},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from NG-RAN to a UE in RRC_CONNECTED or to a UE in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB Donor-CU to IAB-DU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":7125},{"literal_text_all_w_t_and_m_t":"5.7.1.2Initiation","paragraph_zero_based":7126},{"literal_text_all_w_t_and_m_t":"The network initiates the DL information transfer procedure whenever there is a need to transfer NAS dedicated information, or F1-C related information to an IAB-node. The network initiates the DL information transfer procedure by sending the DLInformationTransfer message.","paragraph_zero_based":7127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["154ef6f68a425c029b5a4bb0904a7d0dacebf6d06619d42e7e977355bd881609","49c1e55d2bd8993d22fd7a996522fe3da3998e1fcb18378d40ceae6ed57f0d2a","80130fe9e013287be6430e05735df916d675bfc2ebdca4ca79fe6cb4d0d6d89d","1bf7188bce85e8087385fcbc6136b36335a2df2c1bc93c3499da7a8de4171c3e","eb18f4e959b68c9f01520d9baff61b3cc021add597840a6829ecad3770c4cdfd","586a3d7df6eb9daadeec09af33bd59e1407b1a74ad2bc9e504dfa79ede72e51a","9374cde0460c1a5264d23afcdc7c939b8691742fbcd0e45bc5112b792caac0f4","7d95a8386ba728d0295030ef2005f5c1bf5a91a20a2b34663e71af748868b698","3be9be489193dcf6c136e60d8622a23f01764e76e94ee328a2ca8a57e35d508e","872f4cedbeb5b0388c06258d801fd0fee93768d94233195f7b3ef26c572fff41","e98a01967b0d70b2c5d154b6a41e458e942ce61925d4fc1df2b644bbf9339ffc","8a3773a8fd3f6b623d884c786c7e1a40621221460ab979b0a6f8784a37170e1d","53d3e99b6a6dc360d92e1070d6c3de2d906eae75bd4e93c9e43ef931dfea5e2d","2ad43c10db161e91effdec572ae9e8bdc3d93412e1ef83434e53769f8e6ccd83","40a6ed212df51e6eca482f8e24907fdbdff5476e853ed55a8876ec3edcb1819f","fd130f32b514032aa68d6e9cdb218828cff709f41ab0a450047240ed7ede71fa","46489b67cb643bb403fa3ec52a36290e8ad7dce6b560f20699f571cf6cb79b75","b4465436c76d12981dbdaefdbeec145bd94bbf9b9dbb197fd3cad5fc8b6110ad","c29047dbae70583cb0bfb741cc3ef84e7631a6e5fb658e08d221bca65e77d4cb","e8a5f045579e678814e2cb57fff20476fc49fe1dfac4160a3e37624dfc1d61a3","3dda1774aa769a97dbfa4b0d7220d945a0c6e0b16c8faa9b53a048af7ade4d04","1a0fe6fc279f9e976305184e9b2ad96c2b42ab65166cb5952274e21948fbf4d5","a8f67d933d15dc7e8b734e7b310f99de624b9bb6621a00a7580ac53a9bd6de4c","aa0fc436efd1cb18fc06cedf61aef6709057d289f9c52356e4cd2d15616b54f2"],"paragraph_range_zero_based":[7104,7127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7104"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.1.3Reception of the DLInformationTransfer by the UE","paragraph_zero_based":7128},{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the UE shall:","paragraph_zero_based":7129},{"literal_text_all_w_t_and_m_t":"1>if dedicatedNAS-Message is included:","paragraph_zero_based":7130},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedNAS-Message to upper layers.","paragraph_zero_based":7131},{"literal_text_all_w_t_and_m_t":"1>if referenceTimeInfo is included:","paragraph_zero_based":7132},{"literal_text_all_w_t_and_m_t":"2>calculate the reference time based on the time, referenceSFN and timeInfoType if it is included;","paragraph_zero_based":7133},{"literal_text_all_w_t_and_m_t":"2>calculate the uncertainty of the reference time based on the uncertainty, if uncertainty is included;","paragraph_zero_based":7134},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the reference time and, if uncertainty is included, of the uncertainty;","paragraph_zero_based":7135},{"literal_text_all_w_t_and_m_t":"2>ignore all further referenceTimeInfo received in SIB9, if any.","paragraph_zero_based":7136},{"literal_text_all_w_t_and_m_t":"1>if sib9Fallback is included:","paragraph_zero_based":7137},{"literal_text_all_w_t_and_m_t":"2>apply referenceTimeInfo in SIB9.","paragraph_zero_based":7138},{"literal_text_all_w_t_and_m_t":"1>if rxTxTimeDiff-gNB is included:","paragraph_zero_based":7139},{"literal_text_all_w_t_and_m_t":"2>calculate the propagation delay based on the UE Rx-Tx time difference measurement and the received Rx-Tx time difference measurement at the gNB;","paragraph_zero_based":7140},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay.","paragraph_zero_based":7141},{"literal_text_all_w_t_and_m_t":"1>if ta-PDC is set to activate:","paragraph_zero_based":7142},{"literal_text_all_w_t_and_m_t":"2>inform upper layers of the propagation delay determined by the accumulated Timing Advance commands.","paragraph_zero_based":7143},{"literal_text_all_w_t_and_m_t":"1>if clockQualityDetailsLevel is included:","paragraph_zero_based":7144},{"literal_text_all_w_t_and_m_t":"2>store the eventID-TSS as the storedEventID within VarTSS-Info;","paragraph_zero_based":7145},{"literal_text_all_w_t_and_m_t":"2>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":7146},{"literal_text_all_w_t_and_m_t":"3>derive the the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of NPN-IdentityInfoList in SIB1 as defined in TS 38.413 [42];","paragraph_zero_based":7147},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7148},{"literal_text_all_w_t_and_m_t":"3>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, and PLMN-Identity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, as defined in TS 38.413 [42];","paragraph_zero_based":7149},{"literal_text_all_w_t_and_m_t":"2>store the gNB identity derived from SIB1 as the storedGnbID within VarTSS-Info;","paragraph_zero_based":7150},{"literal_text_all_w_t_and_m_t":"2>forward clockQualityDetailsLevel to upper layers.","paragraph_zero_based":7151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["36cb26866d5ce2a3debaaf327c1ac042b7251610d6019c521237147071e6aac0","718befc39d466fed77f76c7b26e78e00acc563d0cc75d5986cc4c7922a7a7b57","afa8182e33affd592ea7a04a862539aa7ebc47a410311c734233fc9f7b75092a","c1d9ed76032b3ca386a40da9b70220ed2ce34e12dd8003660bc7ff987685d83c","a24ceb699281b0f774fb86ca75091a51792618c4621336ec9c3cd69fd2513c69","7edee4a6088c7abafe7cbea21d22a7ca729ee16f6751b0692345438c3d308a90","fb5715e540da90e6848ab8c68676648853f2ead2020ed9fb7e14b04fc7b5ab72","74730e2971765797ce8b6694ef972227384372628dd4b013c0f999443e4587c7","03f0ba3df28e5c7b26ceea57b9af5c60cfe7d22e22330383b108def399aadb0b","347b5009bdd3ea85cb6faa0684d311398afe6fd945c42209ac46c89eabe80395","8327e8f2446f461116426d7cb5ecf0a4b9d934f8ffe7b3f525b784bd9d05472f","955eb3eacdbc959b5bdcc835d62dbe7c83edec3f7d03baed1bece9d4ee550a6f","a6953db4de8d85f3ea8702ad5f702d809c460b771932112cf5bbd562e2b46cc2","63b136f77e53cfdf2688c0b201a9146763afbfc014a0360a4fd409369409e811","94314b26504ad582dbe48a611a9b0ace067e6a2ee01dc2ba84eb35d1ca80cb50","8b840d38f0d098e9bede5bae80486a0c05153dcbd4613f8c777c0d5b7347b0f3","57473ab11ac1824bea0c0cdc173f25ffadb66ee81b2f528087234de113596fc0","ddb00fedbcbc6034a7239ddd6e5d060a416715967186f80b101a91af46adbdbc","3892b581d0bc6a6973020b7da8dcc2466505b43c2118bc056d1a740e262a3f9a","e93c1dff446842d250a6240245288607a50f1147f7ceaf571c2c7e9840908dd9","e3d5ca289774ebc293bad573727d4b0a7d4bb9d17f66342e38a04cf419986980","bc2613a02ace23f5f777e08329b9d6168e205627615116c72b1fc2f7b1f8d1d2","ad49c9f845964151e935938a3da84f0d5d0ba19d4d62c0721c208553d095f821","146dfd689f94e0c55555b4276271612e7e9285f72f6613844a93b19d0b55e7b8"],"paragraph_range_zero_based":[7128,7151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7128"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon receiving DLInformationTransfer message, the IAB-MT shall:","paragraph_zero_based":7152},{"literal_text_all_w_t_and_m_t":"1>if dedicatedInfoF1c is included:","paragraph_zero_based":7153},{"literal_text_all_w_t_and_m_t":"2>forward dedicatedInfoF1c to the collocated IAB-DU.","paragraph_zero_based":7154},{"literal_text_all_w_t_and_m_t":"5.7.1aDL information transfer for MR-DC","paragraph_zero_based":7155},{"literal_text_all_w_t_and_m_t":"5.7.1a.1General","paragraph_zero_based":7156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7157},{"literal_text_all_w_t_and_m_t":"Figure 5.7.1a.1-1: DL information transfer MR-DC","paragraph_zero_based":7158},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer RRC messages from the network to the UE over SRB3 (e.g. an NR RRC reconfiguration message including reconfigurationWithSync, an E-UTRA RRC connection reconfiguration message including mobilityControlInfo, an RRC connection release message, a MobilityFromNRCommand message, or a MobilityFromEUTRACommand message) during fast MCG link recovery.","paragraph_zero_based":7159},{"literal_text_all_w_t_and_m_t":"5.7.1a.2Initiation","paragraph_zero_based":7160},{"literal_text_all_w_t_and_m_t":"The network initiates this procedure whenever there is a need to transfer an RRC message during fast MCG link recovery.","paragraph_zero_based":7161},{"literal_text_all_w_t_and_m_t":"5.7.1a.3Actions related to reception of DLInformationTransferMRDC message","paragraph_zero_based":7162},{"literal_text_all_w_t_and_m_t":"Upon receiving the DLInformationTransferMRDC, the UE shall:","paragraph_zero_based":7163},{"literal_text_all_w_t_and_m_t":"1>if the RRCReconfiguration message is included in dl-DCCH-MessageNR:","paragraph_zero_based":7164},{"literal_text_all_w_t_and_m_t":"2>perform the RRC reconfiguration procedure according to 5.3.5.3;","paragraph_zero_based":7165},{"literal_text_all_w_t_and_m_t":"1>else if the RRCRelease message is included in dl-DCCH-MessageNR:","paragraph_zero_based":7166},{"literal_text_all_w_t_and_m_t":"2>perform the RRC release procedure according to 5.3.8;","paragraph_zero_based":7167},{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromNRCommand message is included in the dl-DCCH-MessageNR:","paragraph_zero_based":7168},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from NR procedure according to 5.4.3.3;","paragraph_zero_based":7169},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionReconfiguration message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":7170},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection reconfiguration procedure as specified in TS 36.331 [10], clause 5.3.5.4;","paragraph_zero_based":7171},{"literal_text_all_w_t_and_m_t":"1>else if the E-UTRA RRCConnectionRelease message is included in dl-DCCH-MessageEUTRA:","paragraph_zero_based":7172},{"literal_text_all_w_t_and_m_t":"2>perform the RRC connection release as specified in TS 36.331 [10], clause 5.3.8;","paragraph_zero_based":7173},{"literal_text_all_w_t_and_m_t":"1>else if the MobilityFromEUTRACommand message is included in the dl-DCCH-MessageEUTRA:","paragraph_zero_based":7174},{"literal_text_all_w_t_and_m_t":"2>perform the mobility from E-UTRA procedure as specified in TS 36.331 [10], clause 5.4.3.3;","paragraph_zero_based":7175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["03617ac46d2c7ed93b03fce84599b1de196c9ec3521b39de425c16246b0ba377","13d887650bd6bb40dad03b98ad9bcecb2933cc07d3b38b806ac74b41b008d43c","47d28002f50ffa9c33830e8f54f7107052f80268f38f0a9a1d279771653a5d3c","0575fa54fab2361df60218abc423b747bbe71400f8b86bab57a727781e885fda","91a92c14ae717b8f11f4a9efe15857e66c9585a997d8c6c835d21d1b8e2809ab","0180bb682d7641a5670828cb7d630f9221be291a6ca771a074bb1a1adcd135cf","39323c14b1dea1793efca82072fd47ab410eef9cf9e133879a5cc53317fec8dc","45ccfdc13762dc381a3c62604a9ebbdf9c6d0dd39a748a7a8970d2514ffb2813","76b54e7ad84406e2b3565195101b14a5cc70399770a55ad4a35597e8506788d5","9c9a8380c15210a305a30343b4125ba6df9bc629bcec736db3f8bddae4e58572","438ba5e67ffcdda74ca043c4f6a8a28377c817d011997d55a02acea7eedf951a","26f83e0c5e1c3bb35b6a86a6d879928c27bcf4cfe93f0ccb674085efb7d962e8","cd213109c4a6766eacb1e2812869ec9b8b5d760a6b32af2abd576b90eff5f51d","f70c32dba93cc7f679feb6104021ecbc4ed3d9a2765fd6a7cdebc11e00b0d700","01653dd407e01e39b61f84efad0ef0e391d39b5b1896ce624bee5a26dcbdab5e","6852c461a3391599d3af97d2ac2a298b3d964714ab36353870952d551f9c5897","89d24dc8b82f636801063482d7ffbc0f07980edaf80a8eb7bd62e5b6e57924f4","768f3b5629691045aacc48063b79247249cc32dd30a934284e49af1cadcb83e7","9f7b69e39269ad994f3adc8d74460063788890538bc24cd06ac11e187a08c29e","860d38d0049e14f44d1c11497721bf6d15907bb1a93dc38ee39a620ade8d353d","d2260de3e6a42d2e5bad275831437cfa4f9506678c65d5916ebfcee88c7774bf","dc149e613e23d15744195d4148a3a54d75fa4aebb546962a3e8663dd1fba6e4b","aff136f50e681c4f90a4cf4def2d159bdd459a9de2d0bcafbba47fd0dd6c9237","85a4735d600a3a4de0b04d637aa654fac02ea65940cc47c5d7a9cda07b9912d5"],"paragraph_range_zero_based":[7152,7175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7152"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.2UL information transfer","paragraph_zero_based":7176},{"literal_text_all_w_t_and_m_t":"5.7.2.1General","paragraph_zero_based":7177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7178},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2.1-1: UL information transfer","paragraph_zero_based":7179},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer NAS dedicated information from the UE to the network in RRC_CONNECTED or in RRC_INACTIVE during SDT, or to transfer F1-C related information from IAB-DU to IAB Donor-CU via the collocated IAB-MT in RRC_CONNECTED.","paragraph_zero_based":7180},{"literal_text_all_w_t_and_m_t":"5.7.2.2Initiation","paragraph_zero_based":7181},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED or a UE in RRC_INACTIVE during SDT initiates the UL information transfer procedure whenever there is a need to transfer NAS dedicated information. The UE initiates the UL information transfer procedure by sending the ULInformationTransfer message. In addition, an IAB-MT in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer F1-C related information. When F1-C related information has to be transferred, the IAB-MT shall initiate the procedure only if SRB2 or split SRB2 is established.","paragraph_zero_based":7182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7183},{"literal_text_all_w_t_and_m_t":"5.7.2.3Actions related to transmission of ULInformationTransfer message","paragraph_zero_based":7184},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransfer message as follows:","paragraph_zero_based":7185},{"literal_text_all_w_t_and_m_t":"1>if the upper layer provides NAS PDU:","paragraph_zero_based":7186},{"literal_text_all_w_t_and_m_t":"2>set the dedicatedNAS-Message to include the information received from upper layers;","paragraph_zero_based":7187},{"literal_text_all_w_t_and_m_t":"1>for the IAB-MT, if there is a need to transfer F1-C related information:","paragraph_zero_based":7188},{"literal_text_all_w_t_and_m_t":"2>include the dedicatedInfoF1c;","paragraph_zero_based":7189},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransfer message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":7190},{"literal_text_all_w_t_and_m_t":"5.7.2.4Failure to deliver ULInformationTransfer message","paragraph_zero_based":7191},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":7192},{"literal_text_all_w_t_and_m_t":"1>if AS security is not started and radio link failure occurs before the successful delivery of ULInformationTransfer messages has been confirmed by lower layers; or","paragraph_zero_based":7193},{"literal_text_all_w_t_and_m_t":"1>if PDCP re-establishment or release/addition (e.g due to key refresh upon PCell or PSCell change, or RRC connection re-establishment, or failure of resume procedure initiated for SDT) occurs on an SRB on which ULInformationTransfer messages were submitted for transmission but successful delivery of these messages was not confirmed by lower layers:","paragraph_zero_based":7194},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the possible failure to deliver the information contained in the concerned ULInformationTransfer messages, unless the messages only include dedicatedInfoF1c.","paragraph_zero_based":7195},{"literal_text_all_w_t_and_m_t":"5.7.2aUL information transfer for MR-DC","paragraph_zero_based":7196},{"literal_text_all_w_t_and_m_t":"5.7.2a.1General","paragraph_zero_based":7197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7198},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2a.1-1: UL information transfer MR-DC","paragraph_zero_based":7199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2c8e3d046f63d1c51fa56ab076598b50e030921aaeb6f4bbbc8ed5b39016885f","f505e37a2fe90b551014bf41598758c8946710bd23fbb49e0662be6bfa4e538d","4d33b518be42455a82d744f3350a71e7cfaf019840d998344e71a64a5be85ab5","610b9af2443c23b0ea006770e3d927d9bcf9c286fa489136a374ec00b8b9886d","cbc513735e7f7ad1ab1181b282b4c8aa263d315140e496cea41873946fe1fbd1","4debf07185c81ad21a8d7f8fd4ccf7de95fdc326bba548aa5a1b7ac1eaf1b784","d484671a7331410de550dc3a8c53a6b8e70d98e2ed605d90df8833a33726198c","877e8959a90b686c8f8959fd5eebae149024a80c493c6b8ba824dfae2ed43f17","d8f6a9bca0a0e2adf20b8c59e6a79f5760a921b189b5ed4680435e9cf37feeed","67a2b9900e2ee894dbdc83d1a9d12adc0754437772148886f8aac988ff68b805","bcaf7fb2b8250fda2fb71a98d6d4e435eb7a2b8105b34df5cb59afa42954a644","494342d351c3e69fc078abaaf43cafad9327e8e96e49a2e738407efa2eaa1c6b","4234d0c4b21c1f20fc490f59bd3a3f325a11e70521c2bc71b230ed3f933f1f4a","049fde299b50538b22edddbee45becd00af6c0ba1d9b5b9359ecec99b8973505","804a564c8244dc92f7fad9854287904f720d3c89d410bc7d788445d90436cce1","5f87b445efa87933f3daae5c43eed5e01c857e7143fe9c10fbda79afdbf31ecc","14846c144b22307af4be48430a6098bb72e48e6dc6d7247fbc1078b7691049a5","2b9de7c4f401ce39d33b4af73031eae92c1a7e61855df79f0fa0dc4930228f07","ad9a61c5fa683189a63bb0b438be041dac1d98ddba7058a556004fa894a18a56","118240c291458e828089ebb40cff2ffa4cd9886717fc864971def414dc3e96d5","c7f3777f8371a91b5f627f418eb1c6d968b210bc3015d6cde5b005ac803f112c","5e719103d5a8a6cac275e53ac1b4e09166830c37b91c72a889830b1d6297f9bb","ce3fdb256e8125947d7bed8eb2abccf18ab1996ec62282b7b2715e109dece7f0","4259199ccd17da63fc755c04812f97b37080a23c9e29bbec27bfbe5a5aa4f059"],"paragraph_range_zero_based":[7176,7199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7176"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer MR-DC dedicated information from the UE to the network e.g. the NR or E-UTRA RRC MeasurementReport, FailureInformation, UEAssistanceInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message.","paragraph_zero_based":7200},{"literal_text_all_w_t_and_m_t":"5.7.2a.2Initiation","paragraph_zero_based":7201},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer for MR-DC procedure whenever there is a need to transfer MR-DC dedicated information. I.e. the procedure is not used during an RRC connection reconfiguration involving NR or E-UTRA connection reconfiguration, in which case the MR DC information is piggybacked to the RRCReconfigurationComplete message, except in the case the UE executes an intra-SN CPC.","paragraph_zero_based":7202},{"literal_text_all_w_t_and_m_t":"5.7.2a.3Actions related to transmission of ULInformationTransferMRDC message","paragraph_zero_based":7203},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferMRDC message as follows:","paragraph_zero_based":7204},{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer MR-DC dedicated information related to NR:","paragraph_zero_based":7205},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageNR to include the NR MR-DC dedicated information to be transferred (e.g., NR RRC MeasurementReport, UEAssistanceInformation, FailureInformation, RRCReconfigurationComplete, MCGFailureInformation, or IABOtherInformation message);","paragraph_zero_based":7206},{"literal_text_all_w_t_and_m_t":"1>else if there is a need to transfer MR-DC dedicated information related to E-UTRA:","paragraph_zero_based":7207},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the E-UTRA MR-DC dedicated information to be transferred (e.g., E-UTRA RRC MeasurementReport, or MCGFailureInformation message);","paragraph_zero_based":7208},{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferMRDC message to lower layers for transmission, upon which the procedure ends.","paragraph_zero_based":7209},{"literal_text_all_w_t_and_m_t":"5.7.2bUL transfer of IRAT information","paragraph_zero_based":7210},{"literal_text_all_w_t_and_m_t":"5.7.2b.1General","paragraph_zero_based":7211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7212},{"literal_text_all_w_t_and_m_t":"Figure 5.7.2b.1-1: UL transfer of IRAT information","paragraph_zero_based":7213},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to transfer from the UE to NR MCG dedicated information terminated at the NR MCG but specified by another RAT e.g. the E-UTRA MeasurementReport message, the E-UTRA SidelinkUEInformation message or the E-UTRA UEAssistanceInformation message. The specific information transferred in this message is set in accordance with:","paragraph_zero_based":7214},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.6.10 of TS 36.331 [10] for E-UTRA UEAssistanceInformation message;","paragraph_zero_based":7215},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.10.2 of TS 36.331 [10] for E-UTRA SidelinkUEInformation message;","paragraph_zero_based":7216},{"literal_text_all_w_t_and_m_t":"-the procedure specified in 5.5.5 of TS 36.331 [10] for E-UTRA MeasurementReport Message.","paragraph_zero_based":7217},{"literal_text_all_w_t_and_m_t":"5.7.2b.2Initiation","paragraph_zero_based":7218},{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED initiates the UL information transfer procedure whenever there is a need to transfer dedicated inter-RAT information as specified in TS 36.331 [10].","paragraph_zero_based":7219},{"literal_text_all_w_t_and_m_t":"5.7.2b.3Actions related to transmission of ULInformationTransferIRAT message","paragraph_zero_based":7220},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the ULInformationTransferIRAT message as follows:","paragraph_zero_based":7221},{"literal_text_all_w_t_and_m_t":"1>if there is a need to transfer dedicated LTE information related to V2X sidelink communications:","paragraph_zero_based":7222},{"literal_text_all_w_t_and_m_t":"2>set the ul-DCCH-MessageEUTRA to include the V2X sidelink communication information to be transferred (e.g. the E-UTRA RRC MeasurementReport message, the E-UTRA RRC SidelinkUEInformation message, or the E-UTRA RRC UEAssistanceInformation message);","paragraph_zero_based":7223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5b133ef9463bca9cb6104a817651f9fd09403dd57e4141d285dc34ed1384705a","bd5204a418f3a112fb9cf9fcd7856dbbea91cfe2487cd0a0309c7959ad563d52","7f48a87a2b235cfbf9ac9ae85219e24c0d48307c2d54396c28b5a6f8b300d23c","8a7fed857abf35fe1147e4139d69a3ad2b795409598d0bd6ab85e452f6eabf32","5b5e6105377b4a0a8fdc68d594f36cb1553bd6063b6b492105c8b63f1a754779","74181043341d9903b20f17143187a5e014d518c3caa10676c532fe15398ec49a","16866bd5343db10c893459a64473a0081584394cf7c4b035cd6bf1497c9634f9","7ccfd93621a5800b6e34ab3067f89eaf89f762fae2a4d06c1e174c0eb72c25b2","0f771b6b05850ed541413897817abc9c52eda377ee3d1cb390dc4139d2f2e754","15270c89785be530dce871913154ff8f3c3516d9fbac8a5d334d32c97cbbf047","5399f65e65c7dba30fa9cbe995fd9a92b843216e3e56e1b54a0ee86004e2d1e1","ae583200f6f06ce725cbb17801b22b1f21da1b15674e188fe2f472b604a7f5d6","083791800d682d0e3be0f7a9d988f0b93b6c863be7f66604d239166cccc52984","370b5acaf3862da52ffe28a0ce28947654624fe732950bab62f61669f5862071","c7e63f9b532d41ef586bcfbbe68a0fe5cc791d4d5e496d2a9fc2ffbbceed8b4b","84b7dfcebd91d1da8df0c696d9d560323313ba94be228328b5301659a84eae4c","42378fb6f078c04dbe388a0d8fe5bc4468ce34748b3e585c612a38294a6db46f","e04eccbe122640db34f833babf2df3a88864b11809ab3e2531778635eb069a24","b15e221bb6feeac1978f529ed3079066cf411820ab91270fe5cf9966bf46d690","1a301bb4d39ca1e833e0645c88440144c9f6adac219df219365dc807e652fa23","2e8fb8e40d1ad3f353d976607a9c7d56f70d24c07d67dcc7e416f472c5475fc3","816cc7d0df37ae73d94c150b247eeacd40e5beb6cac09993adb13958664de618","d39cbb210f26a9ca56db575157e605a61d5042511ca6538fde8ec4113f46102f","d4b0fc6dbbf979992f669d80fd07be28f53a990a5b4a242344bf9fb356adf111"],"paragraph_range_zero_based":[7200,7223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>submit the ULInformationTransferIRAT message to lower layers for transmission, upon which the procedure ends;","paragraph_zero_based":7224},{"literal_text_all_w_t_and_m_t":"5.7.3SCG failure information","paragraph_zero_based":7225},{"literal_text_all_w_t_and_m_t":"5.7.3.1General","paragraph_zero_based":7226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":7227},{"literal_text_all_w_t_and_m_t":"Figure 5.7.3.1-1: SCG failure information","paragraph_zero_based":7228},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to inform E-UTRAN or NR MN about an SCG failure the UE has experienced i.e. SCG radio link failure, beam failure of the PSCell while the SCG is deactivated, failure of SCG reconfiguration with sync, SCG configuration failure for RRC message on SRB3, SCG integrity check failure, and consistent uplink LBT failures on PSCell for operation with shared spectrum channel access.","paragraph_zero_based":7229},{"literal_text_all_w_t_and_m_t":"5.7.3.2Initiation","paragraph_zero_based":7230},{"literal_text_all_w_t_and_m_t":"A UE initiates the procedure to report SCG failures when neither MCG nor SCG transmission is suspended and when one of the following conditions is met:","paragraph_zero_based":7231},{"literal_text_all_w_t_and_m_t":"1>upon detecting radio link failure for the SCG, in accordance with clause 5.3.10.3;","paragraph_zero_based":7232},{"literal_text_all_w_t_and_m_t":"1>upon detecting beam failure of the PSCell while the SCG is deactivated, in accordance with TS 38.321[3];","paragraph_zero_based":7233},{"literal_text_all_w_t_and_m_t":"1>upon reconfiguration with sync failure of the SCG, in accordance with clause 5.3.5.8.3;","paragraph_zero_based":7234},{"literal_text_all_w_t_and_m_t":"1>upon SCG configuration failure, in accordance with clause 5.3.5.8.2;","paragraph_zero_based":7235},{"literal_text_all_w_t_and_m_t":"1>upon integrity check failure indication from SCG lower layers concerning SRB3.","paragraph_zero_based":7236},{"literal_text_all_w_t_and_m_t":"Upon initiating the procedure, the UE shall:","paragraph_zero_based":7237},{"literal_text_all_w_t_and_m_t":"1>if the procedure was not initiated due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":7238},{"literal_text_all_w_t_and_m_t":"2>suspend SCG transmission for all SRBs, DRBs and, if any, BH RLC channels;","paragraph_zero_based":7239},{"literal_text_all_w_t_and_m_t":"2>reset SCG MAC;","paragraph_zero_based":7240},{"literal_text_all_w_t_and_m_t":"1>stop T304 for the SCG, if running;","paragraph_zero_based":7241},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for CPC, CPA, or subsequent CPAC, if configured;","paragraph_zero_based":7242},{"literal_text_all_w_t_and_m_t":"1>stop conditional reconfiguration evaluation for each CHO configuration that includes condExecutionCondPSCell, if configured;","paragraph_zero_based":7243},{"literal_text_all_w_t_and_m_t":"1>if the UE is in (NG)EN-DC:","paragraph_zero_based":7244},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformationNR message as specified in TS 36.331 [10], clause 5.6.13a.","paragraph_zero_based":7245},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":7246},{"literal_text_all_w_t_and_m_t":"2>initiate transmission of the SCGFailureInformation message in accordance with 5.7.3.5.","paragraph_zero_based":7247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2340899cb61cd4ddb70300df72874761c90719eae18dc2ffdadbc78c825aa78f","1e434b26b80923738d76dfa88161f265e330728e761054462d8436dc51cfe6e6","e4d38200cfd57d12ec85432c80a80716489555d4f205b03b9f6ec2f761e1032e","569f71cd830ae1710d1b1457d6a27be7a3a2bf4d1b57f6afa007ff700e239555","5db4ee05f3076f019b44c8bc2e8827061476eed636b0b4495cb60f8d470e86f0","42fda435058dbb3b3e669c59f05216f255d38ed75f6993b383e6bce1e31160e5","69007dc9bfe2653d82880aaa3bd4fa2254934a8471a9a143e787b2fa5d6f13d5","1eb839167c790bf4a65e6ae21ba24bc4ddab7803425acc808e70c2b537f45881","6383ab96dd069a8dfd479fa536ab76444db1710b5c492ca8805a9ebe1f879dbf","acca80231f887ff5d5d0976091dca47054af2482db06cf78fef68653ee8cc489","3b50a915e8d410def8d27edbc79dad0d3caa68c637dd307231f361e18cf13d2e","d939e380be880c5265a165627e44377afac9c723d0334b06b96e074a589aad5c","14ac67e7515a705cc2ddc439d05fb9af43c0f9c8ef6e4eb0475329cc15277ba3","d4edd0c8ebae810d4c6fad62b51f2b52a28e5e51daf627ee35bbf9070c2fd9ee","a1ccf1151d7e68db7ec667bff9c72fe7bf807e276187eb5b50b5fe069a456fda","d5286eb8c9d9fff3084e029ff254badea5eea11c9bd1d05da7020090d82e5c61","0983beadee08edbc85be7185af78917ac7891eb624f2e9945367abbc4de60f2c","0b491c82e8867eb52c02085cfb81d189ac6e421ad0c7d6a0a6287184526558b9","367fd5277375a117abe6faa9a144612b062638c9417b861466c27f81a6d6956d","32282ec4414ae9f50b0fb2d2788c9235f8a7328ef42e64612a5025cf36e0b27d","6ec43af93f9a7302d4176640375597eab57728b7915aa54abb4d3ef9fd9bceef","e7d10685495745be58297b3002ba53c01ea59a68055829aca0d00f88b0a27bea","01cd1a6f2232379225167c24f50f6e6bc6599ef1a679cd76ce7430638d395f51","0b54c5bb2eb1d7608e80c526b250c7b7cc2128ecbcdd72debfd19aba3f2bf392"],"paragraph_range_zero_based":[7224,7247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7224"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.7.3.3Failure type determination for (NG)EN-DC","paragraph_zero_based":7248},{"literal_text_all_w_t_and_m_t":"The UE shall set the SCG failure type as follows:","paragraph_zero_based":7249},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformationNR message due to T310 expiry:","paragraph_zero_based":7250},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":7251},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to T312 expiry:","paragraph_zero_based":7252},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as t312-Expiry;","paragraph_zero_based":7253},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide reconfiguration with sync failure information for an SCG:","paragraph_zero_based":7254},{"literal_text_all_w_t_and_m_t":"2>set the failureType as synchReconfigFailureSCG;","paragraph_zero_based":7255},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide random access problem indication from SCG MAC:","paragraph_zero_based":7256},{"literal_text_all_w_t_and_m_t":"2>if the random access procedure was initiated for beam failure recovery:","paragraph_zero_based":7257},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem and set the failureType-v1610 as beamFailureRecoveryFailure;","paragraph_zero_based":7258},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7259},{"literal_text_all_w_t_and_m_t":"3>set the failureType as randomAccessProblem;","paragraph_zero_based":7260},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message to provide indication from SCG RLC that the maximum number of retransmissions has been reached:","paragraph_zero_based":7261},{"literal_text_all_w_t_and_m_t":"2>set the failureType as rlc-MaxNumRetx;","paragraph_zero_based":7262},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to SRB3 integrity check failure:","paragraph_zero_based":7263},{"literal_text_all_w_t_and_m_t":"2>set the failureType as srb3-IntegrityFailure;","paragraph_zero_based":7264},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to Reconfiguration failure of NR RRC reconfiguration message:","paragraph_zero_based":7265},{"literal_text_all_w_t_and_m_t":"2>set the failureType as scg-reconfigFailure;","paragraph_zero_based":7266},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to consistent uplink LBT failures:","paragraph_zero_based":7267},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set the failureType-v1610 as scg-lbtFailure;","paragraph_zero_based":7268},{"literal_text_all_w_t_and_m_t":"1> else if connected as an IAB-node and the SCGFailureInformationNR is initiated due to the reception of a BH RLF indication on BAP entity from the SCG:","paragraph_zero_based":7269},{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as bh-RLF.","paragraph_zero_based":7270},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformationNR message due to beam failure of the PSCell while the SCG is deactivated:","paragraph_zero_based":7271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7bfca560da0e5c659bdcc60b1ff130a9fdd3fcde259d41a357c3d58c82cfa028","c4902b95ceca86e81beac9b11741a7e41c7dfdc567d623019078a98632966fef","5cb885413a31835cd0af95c001c186407ebe8bf67e2567a3cf2e9579f5d6a0a0","73ebc820663042760e6aebccafd9022ef830ff0eefe38ce71f4621cf959866c1","a84d059d7f9f95bd7299a4dffc08df69285914f540a38434d3eedf12ce4a68e8","4d546548452a9a5e7f135ac268abb565c609f6103741f2810ee21568693df679","afb962e141be33161ad76995f425f5d16124df9153cfa01144d08e590bbc6de7","94aef50b35c10762586bce0bbd0964b558a5112cc6a2eaf124ea018bed33dcf9","0de81d0862a4fffd335b609bb30d2fe666fe060e27bbb836f3c854d46d15de46","e9e0d1f0b7dbd63160bcdd86696c0d29a49dbfe84ae58ef06d0d52ecdd277fb6","5cea02dfafd21456d11f7c9c119e80bf10e846269dd4ba7f4807d4b10ce723f2","e4aad7d27b71197d8ca24da5c87a48ae1f0c0d176189b389159c85b5b161d7bc","ce6d877dad92a9706bb473d3c824992f54e724edcf2f38b1419212ca1285b74c","74f8b69bf3a3cf86ff9bfaeb0514247cbf8f515c3cf26d1ec440d39dd63c4949","1d188cc7979698c9bb3f2d3df36fae330fdddf126542e4397f47a2f0b9836b6e","11a361cb6c85d462f1fcf3bb612e32f09fff388989ce86a6e3693742e26061ea","1e4f274936fcabcf73e152471ad90c874f6df53a562ed6b90296e015f0e807c0","887a530b594033a8ff2c0dcb67c4bea6db71d2f70ab37e59fc5acea678823f1f","080ef7a808695b11d0436efb03b58b84e20c84ff47f1af9390bf2b25eed88508","6b97d1045f3d9e17b25c145457f2ef717485eee94839d919d36a9d7a370936ec","51dce78c4fc025dee3cdcd8758c25ee22b35337b3e8ea7781f690b3a04b0071e","756076944d4f3e336cd38e55fd0a1af06028ba44e9c94509ddeea10359bb8f78","07a10dbff7c9e6b8f5556644e08dd00a06c355b0b9079057c1e4708750984212","54047acb3cd95629ecd52103ab7f85ae671134e4fc977bb6bf9508d2d2c00263"],"paragraph_range_zero_based":[7248,7271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set the failureType as any value and set failureType-v1610 as beamFailure.","paragraph_zero_based":7272},{"literal_text_all_w_t_and_m_t":"5.7.3.4Setting the contents of MeasResultSCG-Failure","paragraph_zero_based":7273},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the MeasResultSCG-Failure as follows:","paragraph_zero_based":7274},{"literal_text_all_w_t_and_m_t":"1>for each MeasObjectNR configured on NR SCG for which a measId is configured and measurement results are available:","paragraph_zero_based":7275},{"literal_text_all_w_t_and_m_t":"2>include an entry in measResultPerMOList;","paragraph_zero_based":7276},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to ssb:","paragraph_zero_based":7277},{"literal_text_all_w_t_and_m_t":"3>set ssbFrequency to the value indicated by ssbFrequency as included in the MeasObjectNR;","paragraph_zero_based":7278},{"literal_text_all_w_t_and_m_t":"2>if there is a measId configured with the MeasObjectNR and a reportConfig which has rsType set to csi-rs:","paragraph_zero_based":7279},{"literal_text_all_w_t_and_m_t":"3>set refFreqCSI-RS to the value indicated by refFreqCSI-RS as included in the associated measurement object;","paragraph_zero_based":7280},{"literal_text_all_w_t_and_m_t":"2>if a serving cell is associated with the MeasObjectNR:","paragraph_zero_based":7281},{"literal_text_all_w_t_and_m_t":"3>set measResultServingCell to include the available quantities of the concerned cell and in accordance with the performance requirements in TS 38.133 [14];","paragraph_zero_based":7282},{"literal_text_all_w_t_and_m_t":"2>set the measResultNeighCellList to include the best measured cells, ordered such that the best cell is listed first, and based on measurements collected up to the moment the UE detected the failure, and set its fields as follows;","paragraph_zero_based":7283},{"literal_text_all_w_t_and_m_t":"3>ordering the cells with sorting as follows:","paragraph_zero_based":7284},{"literal_text_all_w_t_and_m_t":"4>based on SS/PBCH block if SS/PBCH block measurement results are available and otherwise based on CSI-RS;","paragraph_zero_based":7285},{"literal_text_all_w_t_and_m_t":"4>using RSRP if RSRP measurement results are available, otherwise using RSRQ if RSRQ measurement results are available, otherwise using SINR;","paragraph_zero_based":7286},{"literal_text_all_w_t_and_m_t":"3>for each neighbour cell included:","paragraph_zero_based":7287},{"literal_text_all_w_t_and_m_t":"4>include the optional fields that are available.","paragraph_zero_based":7288},{"literal_text_all_w_t_and_m_t":"NOTE:The measured quantities are filtered by the L3 filter as configured in the mobility measurement configuration. The measurements are based on the time domain measurement resource restriction, if configured. Exclude-listed cells are not required to be reported.","paragraph_zero_based":7289},{"literal_text_all_w_t_and_m_t":"1>if available, set the locationInfo as in 5.3.3.7 according to the otherConfig associated with the NR SCG.","paragraph_zero_based":7290},{"literal_text_all_w_t_and_m_t":"5.7.3.5Actions related to transmission of SCGFailureInformation message","paragraph_zero_based":7291},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the SCGFailureInformation message as follows:","paragraph_zero_based":7292},{"literal_text_all_w_t_and_m_t":"1>if the UE initiates transmission of the SCGFailureInformation message due to T310 expiry:","paragraph_zero_based":7293},{"literal_text_all_w_t_and_m_t":"2>set the failureType as t310-Expiry;","paragraph_zero_based":7294},{"literal_text_all_w_t_and_m_t":"1>else if the UE initiates transmission of the SCGFailureInformation message due to T312 expiry:","paragraph_zero_based":7295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["87fb40a67279b9cbd69bd88e3ec67a5fed1bf222216658446d9b6b0eafe631de","230edec363d8a1f2c60a15440c2660b41a16dd162ac829e00fe73cf24c6a41cf","46c463f086868ad9a4525dea7f9859d9a5d15abccf8c63c2de07f9e94e5817f8","218ee81afe0cdcd4cff0fea7fe5a654187a86df0bbcfdd8d392fd21c1036816d","ec9bcb772ad13a3a30fbc394d25dfc4fbd16bc948c5fcb6629358ff2ae9b00c1","52e5922312a501935508cf159444aa70122804cfdc2f428a4c9b59881659d8c3","798f8635bff9fa027de024ac9a98915e63ff256accd52c2d5bb93615c3209b6a","040b3cb34760b1445380f5e70f3de83df27f2d24336e4723eb4aef08f5843761","5715e1fa84ce4829c747e8006d090642273b37049ecdf47224fe55a20b3496c3","54c63d28c12aaba227617fa54e6eb7b73a2e84f15d917a1995b0ade4b69bd552","d35fbe921363686a2aab648821b7bca45cafea18a4dc65e314d244680aa28ace","ef3745366b099f9b6d2bc72dcc6c729c029adbfed4b540c3473c7fe916d4e37d","e907a986922c4af6dfa227cddb1ef4d9153b048a6006093ec43a6fe730cff906","4d7d60bf34f0d746b1076a3ef052f519debc5b281912ee37576443aca123538c","24fc9e6ca2adb374ca3ec959b6e32d7c103e78da9af894c927653090d0f73891","ab30d47e4a344c9f8f89b3b02969e91ec092648b7220b671911a38147dec9fa1","1b271a769e970991a069e2fc1e408d510d18c4fcf89539b02481d9c1076e00a7","eb625059c90a5dfdf230e35f8402f0496fe92cec7d26c71df3a06d107de9c136","15932e779dd80a66d748ae7b7a018db11a9e889e2f6c9cbfbcac0b5ac24a93e9","793158f7d62aaec2cdb87b53802d396e075e4503944c39be07212694f96c4981","4157c3aa17aec9dbc63cc81cb2586ae38aa64d6475158c8fc602d0acbf41971e","d20c798e0412efe6e61fe5f54345e7e76c5a69d6078b6b177a9a219915eba89d","c5d68992e9b96e3b6f59d9bd8c89cf682c6c3c99ee7ce8e81bb97ef396a8501c","631dd31b71a8fe10a1555e86876061d1b2ac97ea6d966f156e827093301644c5"],