notation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p15960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the latest number of consecutive failed RRCSetup or RRCResume procedures in the same cell independent of RRC state transition.","paragraph_zero_based":15984},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":15985},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (establishment or resume) failure. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":15986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15987},{"literal_text_all_w_t_and_m_t":"RA-InformationCommon field descriptions","paragraph_zero_based":15988},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":15989},{"literal_text_all_w_t_and_m_t":"This field indicates the absolute frequency position of the reference resource block (Common RB 0).","paragraph_zero_based":15990},{"literal_text_all_w_t_and_m_t":"allPreamblesBlocked","paragraph_zero_based":15991},{"literal_text_all_w_t_and_m_t":"This field is included when the all the preamble transmission attempts in the corresponding beam (SSB or CSI-RS) are blocked by failed LBT.","paragraph_zero_based":15992},{"literal_text_all_w_t_and_m_t":"attemptedBWP-InfoList","paragraph_zero_based":15993},{"literal_text_all_w_t_and_m_t":"This field indicates locationAndBandwidth and subcarrierSpacing of all the bandwidth parts in which the consistent LBT failures are triggered at the moment of successful RA completion.","paragraph_zero_based":15994},{"literal_text_all_w_t_and_m_t":"locationAndBandwidth","paragraph_zero_based":15995},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth of the bandwidth part associated to the random-access resources used by the UE or of the bandwidth part in which the consistent LBT failures is triggered and not cancelled prior to successful completion of random access procedure (if this field is included in attemptedBWP-InfoList) or prior to RLF/HOF (if this field is included in attemptedBWP-InfoList or bwp-Info).","paragraph_zero_based":15996},{"literal_text_all_w_t_and_m_t":"numberOfLBTFailures","paragraph_zero_based":15997},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of preamble transmission attempts for which LBT failure indication is received in the RA procedure. If the number of LBT failure indications received from lower layers during the RA procedure exceeds or equals to 128, UE sets the field to 128.This field is optional present when there is at least one preamble transmission attempt for which LBT failure indication is received during the RA procedure, otherwise it is absent.","paragraph_zero_based":15998},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesPerSSB-ForThisPartition","paragraph_zero_based":15999},{"literal_text_all_w_t_and_m_t":"This field determines how many consecutive preambles are associated to the used feature or combination of features starting from the starting preamble(s) per SSB.","paragraph_zero_based":16000},{"literal_text_all_w_t_and_m_t":"perRAInfoList, perRAInfoList-v1660","paragraph_zero_based":16001},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about each of the random access attempts in the chronological order of the random access attempts. If perRAInfoList-v1660 is present, it shall contain the same number of entries, listed in the same order as in perRAInfoList-r16.","paragraph_zero_based":16002},{"literal_text_all_w_t_and_m_t":"sdt-Failed","paragraph_zero_based":16003},{"literal_text_all_w_t_and_m_t":"This field is included when the RA report entry is included because of SDT and if the SDT transmission failed. Otherwise, the field is absent.","paragraph_zero_based":16004},{"literal_text_all_w_t_and_m_t":"startPreambleForThisPartition","paragraph_zero_based":16005},{"literal_text_all_w_t_and_m_t":"This field indicates the first preamble associated with the used feature or combination of features.","paragraph_zero_based":16006},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":16007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8592a114a2107b31ff74081cedec29048c6afd196710bf63f1bc92d4c3749487","ae66c5fb4e9af530e5048bc34b20f2f5c90025f294839dffaf8c26ee1778fb70","77d8df9cf4dc169a4d563fc2af56904b5d47dd80916b2918fab7e145e242b63e","4c67753aafb9b02d56779ec23597f659630d7e01c31c51ad408bd890f3dc99cf","2f756db8be5eca7c6660a8cbf343697711f1e99a74027334b4921c35775ae38f","23bbccfac9300c578ebe6ada998bb383e56122a6f714053ff785b4bd2511b598","7497d2a9b55910d7668b520f61334e3d0432cc47b8d036fb11694b9632efdf21","6d6bf2690aec84345fe10f8bae18c1fcbf1da407069851623e45bcd2c8c326d4","21202c27fb05f13bba426031633682929bc90d5c1663602483a39f15ef51ace3","3638fa1708011d4a0e67211b18dc7606d0440c3f21c8dc5369737aefcc0bed7e","98a997a22da8073a0d60cbbcd43daf262411ad56e30ce3987cc43351f8f9790e","3f00b60d94905043f246481597d4d28b8a7608b3499898fac5049dacacbbc71e","87f4af72c24cc3b0177d4a3cad7e528fb3a7d87cbc512b03287f631011e21779","399855c34ff8d6c5e3d5d305eb99f96c36aa2449b2e65e6539bf0f50a00eedf0","85b42a168ebfd0efcdadb84905befdce2091e6ea0319e7c87dc07027b6e8b2c0","57f6bb622f4db644ea4df1489f531afcf3f8af440a7470a3a7ea056082b0e2b4","20e05f38029ebce902f3e09eeb060fc946de647b4a01d624eab3f235e1bae11b","4a9a18abe6459393db0eb92c401b2ed5c18619bab271e1cde94835af72654643","439f0210a9f10a9e06c041eafe26adbad261a54ce8deb5619936ce5840e60714","d449e98355f6bf5e4e5e6af0a49d415dc0ec5839cf8510c5c00d7bb306777e34","2efd50e157acbbc117528465622a255fabf0c0fc72b132bc93bbbc5236fb3736","9224bf175751925ef04714ae5ac68d0828e7dae94b15c2e7b9d9168109824084","034a0bc215b31f7d433924d8556d5a926f02bf008cb895c4cfa0ae74e9dd5a9a","46a6c8c7e2352a02fa5c3dce6b139037dc57c2950ef1a04c358175da0209cd1f"],"paragraph_range_zero_based":[15984,16007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p15984"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing used in the bandwidth part associated to the random-access resources used by the UE or of the bandwidth part in which the consistent LBT failures is triggered and not cancelled prior to successful completion of random access procedure (if this field is included in attemptedBWP-InfoList) or prior to RLF/HOF (if this field is included in attemptedBWP-InfoList or bwp-Info).","paragraph_zero_based":16008},{"literal_text_all_w_t_and_m_t":"triggeredFeatureCombination","paragraph_zero_based":16009},{"literal_text_all_w_t_and_m_t":"One or more features (e.g., RedCap, Slicing, SDT and MSG3 repetition) that triggers the random-access procedure. When triggered feature is Slicing, UE includes all the S-NSSAIs associated to the slices triggering the access attempt in the random-access procedure.","paragraph_zero_based":16010},{"literal_text_all_w_t_and_m_t":"usedFeatureCombination","paragraph_zero_based":16011},{"literal_text_all_w_t_and_m_t":"The feature or combination of features (e.g., redCap, smallData, nsag and msg3-Repetitions) associated to the used random-access resources as specified in TS 38.321[3].","paragraph_zero_based":16012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16013},{"literal_text_all_w_t_and_m_t":"RA-Report field descriptions","paragraph_zero_based":16014},{"literal_text_all_w_t_and_m_t":"cellID","paragraph_zero_based":16015},{"literal_text_all_w_t_and_m_t":"This field indicates the CGI of the cell in which the associated random access procedure was performed.","paragraph_zero_based":16016},{"literal_text_all_w_t_and_m_t":"contentionDetected","paragraph_zero_based":16017},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that contention was detected for the transmitted preamble in the given random access attempt or not. This field is not included when the UE performs random access attempt is using contention free random-access resources or when the raPurpose is set to requestForOtherSI or when the RA attempt is a 2-step RA attempt and fallback to 4-step RA did not occur (i.e. fallbackToFourStepRA is not included).","paragraph_zero_based":16018},{"literal_text_all_w_t_and_m_t":"csi-RS-Index, csi-RS-Index-v1660","paragraph_zero_based":16019},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CSI-RS index corresponding to the random access attempt.","paragraph_zero_based":16020},{"literal_text_all_w_t_and_m_t":"If the random access procedure is for beam failure recovery, the field indicates the NZP-CSI-RS-ResourceId. For CSI-RS index larger than maxNrofCSI-RS-ResourcesRRM-1, the index value is the sum of csi-RS-Index (without suffix) and csi-RS-Index-v1660.","paragraph_zero_based":16021},{"literal_text_all_w_t_and_m_t":"dlPathlossRSRP","paragraph_zero_based":16022},{"literal_text_all_w_t_and_m_t":"Measeured RSRP of the DL pathloss reference obtained at the time of RA_Type selection stage of the RA procedure as captured in TS 38.321 [3].","paragraph_zero_based":16023},{"literal_text_all_w_t_and_m_t":"dlRSRPAboveThreshold","paragraph_zero_based":16024},{"literal_text_all_w_t_and_m_t":"In 4 step random access procedure, this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold rsrp-ThresholdSSB in beamFailureRecoveryConfig in UL BWP configuration of UL BWP selected for random access procedure initiated for beam failure recovery; Otherwise, if the UE has received rsrp-ThresholdSSB in FeatureCombinationPreambles used for the feature specific random access, the field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below this rsrp-ThresholdSSB-r17, else rsrp-ThresholdSSB in rach-ConfigCommon in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":16025},{"literal_text_all_w_t_and_m_t":"In 2 step random access procedure, if the UE has received msgA-RSRP-ThresholdSSB in FeatureCombinationPreambles used for the feature specific random access, the field is used to indicate whether DL beam (SSB) quality associated to the random access attempt was above or below this rsrp-ThresholdSSB-r17, else this field is used to indicate whether the DL beam (SSB) quality associated to the random access attempt was above or below the threshold msgA-RSRP-ThresholdSSB in rach-ConfigCommonTwoStepRA in UL BWP configuration of UL BWP selected for random access procedure.","paragraph_zero_based":16026},{"literal_text_all_w_t_and_m_t":"fallbackToFourStepRA","paragraph_zero_based":16027},{"literal_text_all_w_t_and_m_t":"This field indicates if a fallback indication in MsgB is received (according to TS 38.321 [3]) for the 2-step random access attempt.","paragraph_zero_based":16028},{"literal_text_all_w_t_and_m_t":"intendedSIBs","paragraph_zero_based":16029},{"literal_text_all_w_t_and_m_t":"This field indicates the SIB(s) the UE wanted to receive as a result of the on demand SI request (when the RA procedure is a used as a SI request) initiated by the UE. That is, it indicates the one(s) of the SIB(s) in the SI message(s) requested to be broadcast that the UE was interested in.","paragraph_zero_based":16030},{"literal_text_all_w_t_and_m_t":"lbt-Detected","paragraph_zero_based":16031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0f5c18262c2d4fc3e964eb5de2a05d96364e43ba246041069bcfc3ee173bf2f6","cd2a557e2de12e8b928c5974740827adf595c744a56c7d2e2f361dca490b162c","1b6b2ab5b5d52591d00eaeee34cadeab227945d591f3fb0ecf494437defe6f70","96c4066f71bda4831ad874147b620d6b69150465dc0aa9937cda8fc7df4e13e9","687f4e14b59f857549620a8d93715ca330047d2ba951faadd08348baa9155662","8e5bf1badef8e60d61a91a70566df6ee29dc7bfc9e20068784b41f2d4b5b7f7a","037b4067cb5ea62194ac471ec409adc409a11ddd3fcb00433bea41171fad4614","62da26efa2f50ad607d029253e65b982b6a017b3361b9acb0bcbc0141eb87b48","828b5005312c08bd0872fc578d9e1c8bd2ab987c22ad6560d288ba161aff1973","46d4570f2dda5a1032787b1d1469a0d7d1ca37ac3f4428c9aa588a4cac692181","4150b82482b58e90a0649cf6c17d7888d2edec826fb4f2f386161b1b7395121d","3ea749a166e8e90845ba2a5573780114ef966e0ae3962a05fd28f66a24533f4c","3caa55773a77d56a8edd1f663e95d69b4d71825406fb196e527dc1fbaf9b3e33","3d950a85a5ba2507e182eb5f3d4f8ced16266d73c581f9ade8d597c79a213808","1cd85980e3547a866abbbccdd02505f36c3c06e57db378217d16bd5284a5eae2","f387c00d741a20c0b0fe32a5757f0ece2e7efb1bd19842f70a8b891829ac3bf2","7a8892aaab3b0a31e686ffc3a203474c416c51a586ba11e00cdb4b87b22f284f","9f6f9cce560cf0b71c31640ff765e58707d745bcc1c2ebccb05ddf89fa788b51","5483313efffe27054018f6bb8a19fdc3ef048ca9693f5a82c04e86bc9dd76a7c","2d982f7cbbc27022606d543e78d52268454acde85daa5448c94bb159d9539ecd","be8688a8175c8d394c58ae1e849fcf90dcca8583665b3ccc49cd17bcb4f908c5","1610880d327b20dea330691bd433bfe2f4dd5a595f7d468c19068366b5141887","e35fb7e6c08e2501c9e3cda69a365cb36e1c99efac191fc047f310756eff2e0e","3194067ea76a085d09917ae9491fb8c98b9d786e0fb30222ea646c214b55e10f"],"paragraph_range_zero_based":[16008,16031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16008"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is included when there is at least one LBT failure indication received prior to change of beam for preamble transmission during RA procedure, otherwise this field is absent.","paragraph_zero_based":16032},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":16033},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CBRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":16034},{"literal_text_all_w_t_and_m_t":"msg1-SCS-From-prach-ConfigurationIndexCFRA","paragraph_zero_based":16035},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS for CFRA as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric when the msg1-SubcarrierSpacing is absent; otherwise, this field is absent.","paragraph_zero_based":16036},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-PayloadSize","paragraph_zero_based":16037},{"literal_text_all_w_t_and_m_t":"This field indicates the size of the overall payload available in the UE buffer at the time of initiating the 2 step RA procedure. The value refers to the index of TS 38.321 [3], table 6.1.3.1-1, corresponding to the UE buffer size.","paragraph_zero_based":16038},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":16039},{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CBRA..","paragraph_zero_based":16040},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDMCFRA","paragraph_zero_based":16041},{"literal_text_all_w_t_and_m_t":"This field indicates the number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance for the PRACH resources configured for 2-step CFRA.","paragraph_zero_based":16042},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":16043},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention based random-access resources for 2-step CBRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":16044},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStartCFRA","paragraph_zero_based":16045},{"literal_text_all_w_t_and_m_t":"This field indicates the lowest resource block of the contention free random-access resources for the 2-step CFRA in the random-access procedure. The indication has the form of the offset of the lowest PRACH transmissions occasion with respect to PRB 0 in the frequency domain.","paragraph_zero_based":16046},{"literal_text_all_w_t_and_m_t":"msgA-SCS-From-prach-ConfigurationIndex","paragraph_zero_based":16047},{"literal_text_all_w_t_and_m_t":"This field is set by the UE with the corresponding SCS as derived from the msgA-PRACH-ConfigurationIndex in RACH-ConfigGenericTwoStepRA (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]) when the msgA-SubcarrierSpacing is absent and when only 2-step random-access resources are available in the UL BWP used in the random-access procedure; otherwise, this field is absent.","paragraph_zero_based":16048},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnCSI-RS","paragraph_zero_based":16049},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding CSI-RS.","paragraph_zero_based":16050},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesSentOnSSB","paragraph_zero_based":16051},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the total number of successive RA preambles that were transmitted on the corresponding SS/PBCH block.","paragraph_zero_based":16052},{"literal_text_all_w_t_and_m_t":"onDemandSISuccess","paragraph_zero_based":16053},{"literal_text_all_w_t_and_m_t":"This field is set to true when the RA report entry is included because of either msg1 based on demand SI request or msg3 based on demand SI request and if the on-demand SI request is successful. Otherwise, the field is absent.","paragraph_zero_based":16054},{"literal_text_all_w_t_and_m_t":"perRAAttemptInfoList","paragraph_zero_based":16055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["136e6b669ed601c5ed57351774ee33607e0da2d6ea65c51b5842516c21b52c94","4c99c39606eb6981eeaa2a4dd4b13f2a26051a61b1bcff831d9972e3750db8a4","960b985985a4e756a6c4ef970769e6ac13d1ce20dd6dee958b55d211ccd86f74","9633e4950c83afa2dcd5a223fdc93cc29a6e31a27139772a6f5227660d04d68a","e0b73d88afa3c48ac46a06ae35246bcc8a7e922464ebf5e6a3d2baa5066326ce","49c7244979cbba8404ec2481c14f8d21504ec305503ac1304af8243d6eddbcf5","dfa3a251696c8fc897c4d578cef1540ddd73fe6944c040dce0501145deac769b","a60f793b8474e2feac8953895c0e6dd7f1eded40eccf4a63b34052c41bdf09d3","dacae2eb9763fd8c06214be6d4386ccd16ba71f20a0308c6662641349d69cdfd","248d8b5e39dcce8c9ca5fe028536c7959025e66fc6e7ac3c75cf20d329f0c454","c176f309c089226098584919b12f4f364309d0931f2e77867ce20cb93c53b13d","1e309ec8eeddb14946f7ff3c4766d2da687e77574017171b80982fba0ac099d2","6deba8ca1876cbac1cc2fc1f4ee2822daaf873bffe3877efc62905383819eccb","cde2aacffd96a024a370afe831c94f175f15a9c2521ff9a46b7ccb4e1634f8f3","0bbee8ff0f206ce25ec23a2f64b1629f7c12a74c37c67c935dde818ab8803004","eddce4bda36059f2dbf800c985276e1427242af44571c5af5f6334486eb98e43","e92c82f0b541128ab83a95857affbd572f7a04bdd2e0d65b5daea3934158d65d","a93af13219e8a15925b7a82e79a08129a25e54dc7231016de99424c6c41db09a","b4e20f83822cbb6c33778ba4ab8c44751492a742a0bbb7dfb485bcc2deca41c7","79a4c3a298a7402c389d83aac3a2c7095e9cbf94a9bb838b6bec97c32ca3ee28","6670a466a0ae166544b9e7dd0feb25859bdf1edd5fa9a1b5614b54e9d62c5b7a","9918fde1a9bc6019d5f1390b8b8d8ca030634f4324663f7c98f08d846ae1116b","6944343dc4969381b228b39445aa9868c98b6603fec806df91faf492448ad0af","2b06c0cf3a7fad803b4a3fe81063a0500a369cea51316c6469c4adab75b60bf0"],"paragraph_range_zero_based":[16032,16055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16032"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field provides detailed information about a random access attempt.","paragraph_zero_based":16056},{"literal_text_all_w_t_and_m_t":"perRACSI-RSInfoList","paragraph_zero_based":16057},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same CSI-RS.","paragraph_zero_based":16058},{"literal_text_all_w_t_and_m_t":"perRASSBInfoList","paragraph_zero_based":16059},{"literal_text_all_w_t_and_m_t":"This field provides detailed information about the successive random access attempts associated to the same SS/PBCH block.","paragraph_zero_based":16060},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":16061},{"literal_text_all_w_t_and_m_t":"This field is used to provide information on random access attempts. This field is mandatory present.","paragraph_zero_based":16062},{"literal_text_all_w_t_and_m_t":"raPurpose","paragraph_zero_based":16063},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the RA scenario for which the RA report entry is triggered. The RA accesses associated to Initial access from RRC_IDLE, RRC re-establishment procedure, transition from RRC-INACTIVE. The indicator beamFailureRecovery is used in case of successful beam failure recovery related RA procedure in the SpCell [3]. The indicator reconfigurationWithSync is used if the UE executes a reconfiguration with sync. The indicator ulUnSynchronized is used if the random access procedure is initiated in a SpCell by DL or UL data arrival during RRC_CONNECTED when the timeAlignmentTimer is not running in the PTAG or if the RA procedure is initiated in a serving cell by a PDCCH order [3]. The indicator schedulingRequestFailure is used in case of SR failures [3]. The indicator noPUCCHResourceAvailable is used when the UE has no valid SR PUCCH resources configured [3]. The indicator requestForOtherSI is used for MSG1 based on demand SI request. The indicator msg3RequestForOtherSI is used in case of MSG3 based SI request. The indication lbtFailure is used when the UE initiates RACH in SpCell due to consistent uplink LBT failures [3]. The field can also be used for the SCG-related RA-Report when the raPurpose is set to beamFailureRecovery, reconfigurationWithSync, ulUnSynchronized, schedulingRequestFailure, noPUCCHResourceAvailable and lbtFailure.","paragraph_zero_based":16064},{"literal_text_all_w_t_and_m_t":"spCellID","paragraph_zero_based":16065},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the CGI of the SpCell of the cell group associated to the SCell in which the associated random access procedure was performed. If the UE performs RA procedure on a SCell associated to the MCG, then this field is set to the CGI of the PCell and if the UE performs RA procedure on a SCell associated to the SCG, then this field is set to the CGI of the PSCell. If the CGI of the PSCell is not available at the UE for the RA procedure performed on a SCell associated to the SCG or for the RA procedure on the PSCell, this field is set to the CGI of the PCell. Otherwise, the field is absent.","paragraph_zero_based":16066},{"literal_text_all_w_t_and_m_t":"ssb-Index","paragraph_zero_based":16067},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH index of the SS/PBCH block corresponding to the random access attempt.","paragraph_zero_based":16068},{"literal_text_all_w_t_and_m_t":"ssbsForSI-Acquisition","paragraph_zero_based":16069},{"literal_text_all_w_t_and_m_t":"This field indicates the SSB(s) (in the form of SSB index(es)) that the UE used to receive the requested SI message(s). The field is present if the purpose of the random access procedure was to request on-demand SI (i.e. if the raPurpose is set to requestForOtherSI or msg3RequestForOtherSI). Otherwise, the field is absent.","paragraph_zero_based":16070},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16071},{"literal_text_all_w_t_and_m_t":"RLF-Report field descriptions","paragraph_zero_based":16072},{"literal_text_all_w_t_and_m_t":"bwp-Info","paragraph_zero_based":16073},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the BWP information in which the UE detected consistent uplink LBT failure. This field is set only when the detected consistent uplink LBT failure did not trigger the random access procedure.","paragraph_zero_based":16074},{"literal_text_all_w_t_and_m_t":"choCandidateCellList","paragraph_zero_based":16075},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the list of candidate target cells for conditional handover included in condRRCReconfig at the time of connection failure. The field does not include the candidate target cells included in measResultNeighCells.","paragraph_zero_based":16076},{"literal_text_all_w_t_and_m_t":"choCellId","paragraph_zero_based":16077},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the candidate target cell for conditional handover included in condRRCReconfig that the UE selected for CHO based recovery while T311 is running.","paragraph_zero_based":16078},{"literal_text_all_w_t_and_m_t":"connectionFailureType","paragraph_zero_based":16079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ff83337849f59c3cd7b8db511f72d1e342e4006684a011f0c3a26c230214e9c1","847f0682e7a59c5a9606a0c907a8f13249e8e0a2d667b22648ad47118a4e66cd","713b15f9b9c5fc4be581f1e2af4e68ec3950cca13ee898ecdae4d3a5f2098f9c","6751b7994ea50d26f69f0263c6169231dc4aaa4de93fb8f6cb6ca9b0d7f37220","bc057d9d2b590f76d0d6a8655f0eb1996bfc13038f4c751ce9208fac79fb62ca","f0074d33c2008ac93dc74727c06c485ce8392389e952785dfb93c37af8be6200","0ec6b4c0706757aba7c50e1a45517bbfd731c451346e2b34b30be31bbfc6b9b1","93bd30640b0b37edac66f0cc122fdafe5413a29720278ad60b54e2a35afcd23b","d95261ec19ed594167201976ec45be367ddd69fdaad44be815250ca42c251a47","66b65ca36b1164621b96b6815f51332d85d1d5fd22df1e40b07fea7b9a2c6031","702a730f05972f6924ecfb7822a231fcc6b742add324286c3245ac2f9a085699","755d4e36b596a40c80a53cb563a853e73a10933fe1934fc4ab980f9268983d61","06296edf9764bc61f2e8ca46338383329e7f424b4946f30e8887a709385367bf","e7805e410cc507d53e08d8b3edb6b9d8cf84d80e27c01092a97e1be33b3be0f5","e6a4064dcd937fd95871daf2d6c24354f7a3e99c8782a19bfb83057b7c5807b4","e665037344e2762c8ee72242428d72ebe04bb4423f9eee6aaca08c4ebae24e47","76e6ab00bdd82d1499ed15f8e91f531df37e82fa199ac09c52287d6a5ea5753f","ad678773022580906f33ae0c810bfb2416fafc3e53f5a3dbeafa51dadbdf7910","e7b9b79e6dd74a23baef4b71c313d814ce081be782c6f3b4a868bdef5989f79d","529e5f1a57c48030af473f978401f422f0929040b4822343d45fa4ee3631bd8c","02a5073d155dabec9cfb9d4b6a78128c0985a2cfb4299d9675de2e9bd7de1266","22efa897b941544fb5d56888a15a39bc5a4ae8b1850adaf0bbce4c11424c66bb","bf876f3b99831c17063ee4067dadf08b8eef51d8f45fb53097d8d544bb0a78b2","49082105823a2f78ab55d9f084cbc72fcaab4ea17c2cb177c38bdf321393511e"],"paragraph_range_zero_based":[16056,16079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16056"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the connection failure is due to radio link failure or handover failure.","paragraph_zero_based":16080},{"literal_text_all_w_t_and_m_t":"csi-rsRLMConfigBitmap,csi-rsRLMConfigBitmap-v1650","paragraph_zero_based":16081},{"literal_text_all_w_t_and_m_t":"These fields are used to indicate the CSI-RS indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF. The UE first fills in the csi-rsRLMConfigBitmap-r16 to indicate the first 96 CSI-RS indexes and then csi-rsRLMConfigBitmap-v1650 to indicate the latter 96 CSI-RS indexes. The first/leftmost bit in csi-rsRLMConfigBitmap-r16 corresponds to CSI-RS index 0, the second bit corresponds to CSI-RS index 1. The first/leftmost bit in csi-rsRLMConfigBitmap-v1650 corresponds to CSI-RS index 96, the second bit corresponds to CSI-RS index 97. These fields are included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":16082},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":16083},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI used in the PCell upon detecting radio link failure or the C-RNTI used in the source PCell upon handover failure.","paragraph_zero_based":16084},{"literal_text_all_w_t_and_m_t":"elapsedTimeSCGFailure","paragraph_zero_based":16085},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the SCG failure and the MCG failure. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":16086},{"literal_text_all_w_t_and_m_t":"elapsedTimeT316","paragraph_zero_based":16087},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the value of the elapsed time of the timer T316. Value in milliseconds.","paragraph_zero_based":16088},{"literal_text_all_w_t_and_m_t":"failedPCellId","paragraph_zero_based":16089},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the target PCell of the failed handover. For intra-NR handover nrFailedPCellId is included and for the handover from NR to EUTRA eutraFailedPCellId is included. The UE sets the ARFCN according to the frequency band used for transmission/ reception when the failure occurred.","paragraph_zero_based":16090},{"literal_text_all_w_t_and_m_t":"failedPCellId-EUTRA","paragraph_zero_based":16091},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell in which RLF is detected or the source PCell of the failed handover in an E-UTRA RLF report.","paragraph_zero_based":16092},{"literal_text_all_w_t_and_m_t":"lastHO-Type","paragraph_zero_based":16093},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the type of the last executed handover before the last detected connection failure. The field is set to cho if the last executed handover was initiated by a conditional reconfiguration execution. The field is set to daps if the last executed handover was a DAPS handover.","paragraph_zero_based":16094},{"literal_text_all_w_t_and_m_t":"mcgRecoveryFailureCause","paragraph_zero_based":16095},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the fast MCG recovery failure.","paragraph_zero_based":16096},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":16097},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring EUTRA Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":16098},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":16099},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells, when the radio link failure or handover failure happened.","paragraph_zero_based":16100},{"literal_text_all_w_t_and_m_t":"measResultLastServCell","paragraph_zero_based":16101},{"literal_text_all_w_t_and_m_t":"This field refers to the log measurement results taken in the PCell upon detecting radio link failure or the source PCell upon handover failure.","paragraph_zero_based":16102},{"literal_text_all_w_t_and_m_t":"measResultLastServCell-RSSI","paragraph_zero_based":16103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["86c684cd74236fcb5ad7a5951a42f2f129647e56fbf17f1804ee61d9d365a20c","e8e217b5e7b97a8713110b7e4a376aee513a39dd456788c564c762031c3f92c4","f3d995d0e2307176f5276ab1c9c32a402733ba630e68f1af49d5bc5facfd578e","ea4e3a2527a2c9d16aa806345b605698bc112277de8c1c9721165ec3f42085fd","2a960b748e017ef18375c15298d3e64e4e65c048c6c22e7a0bfcd7f0f3db6071","24810d925a3f9b684747341243d62e029a260e6b45301ca0abc210c5897de017","a7873bd1affb3d1fb2bc513fad41b28b6deb79fa6c07cb436f96b338b72bda95","1796f98331f92ccb3570500809838925cbfbd92c6c6d0ca7bdff5959169b89c2","a78d65bbd7d7ad9a73ccebc8e617d4ffb3e02b953ce6c2384bbdc12dbaf66ff4","36a8f54d8a6826c9c558b6ebe2fcfb8fcb8ed2f902673682739b950af00eea20","bce44293748f8939e46a6877b949e40bfab5f303a69ba040ef8970e8befe48c0","72f87a4f399325883d935af6c83edf1ad0a6fc450ede45122f92922241e2b552","b72bf93ea38bfd0a49d23cf294e54e2bef96a8fb9e2f57e8203c7703d7af1134","58cf97addb60b40a5ff333a6271d6d0b0df10e4f48a613b09b956adadc2e0a7a","7437223278c570e69739b60eea57eb381fcd030c60a425c4493a8c8df7361018","ed34ac0a1c630f7322afb8ba2131855bc817075096d5af85b892713af0eb5a6b","5f9b3a3ed6fb4997daaebd29dba5467c340031175767f5d6403fe6dcfb3159eb","b623ec0cc90361354b6d083b54c05eb5f4b315c95b8861d0711aed12599a7ddd","72762544d1d27f60cc0ec81bf97def558909b942f3a8e8aa5378c95089a96f63","5118b760703f0ea41cff45492e1419dcd42e3fe5f4fe0c74292e693fe56fefc0","783e9980ee1f59858e93a3770e9407c8ed8a16141573c2686b79bb243a3153e5","7f2f5865710c7e6de17afef10fdb83bd8c5405f54566fe45b10b6eccde1652e1","61d331111cc835b8332d7448dacae009a1ab5dc05f8a8cf258a90113bec75cc4","229f10a4f6e81170cbf500682f77b633cf27fb96671a908c73d59b26b98a8679"],"paragraph_range_zero_based":[16080,16103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16080"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field refers to the log RSSI measurement results in dBm (see TS 38.215 [9]) taken for the frequency of the PCell upon detecting radio link failure or handover failure.","paragraph_zero_based":16104},{"literal_text_all_w_t_and_m_t":"measResultNeighFreqList-RSSI","paragraph_zero_based":16105},{"literal_text_all_w_t_and_m_t":"This field is used to log the RSSI measurement results in dBm (see TS 38.215 [9]) taken for the neighbouring frequencies upon detecting radio link failure or handover failure, when UE operates in unlicensed spectrum.","paragraph_zero_based":16106},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA","paragraph_zero_based":16107},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-r9 IE as specified in TS 36.331 [10].","paragraph_zero_based":16108},{"literal_text_all_w_t_and_m_t":"measResult-RLF-Report-EUTRA-v1690","paragraph_zero_based":16109},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RLF-Report-v9e0 IE as specified in TS 36.331 [10].","paragraph_zero_based":16110},{"literal_text_all_w_t_and_m_t":"noSuitableCellFound","paragraph_zero_based":16111},{"literal_text_all_w_t_and_m_t":"This field is set by the UE when the T311 expires.","paragraph_zero_based":16112},{"literal_text_all_w_t_and_m_t":"previousPCellId","paragraph_zero_based":16113},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of the last handover (source PCell when the last executed RRCReconfiguration message including reconfigurationWithSync was received). For intra-NR handover nrPreviousCell is included and for the handover from EUTRA to NR eutraPreviousCell is included.","paragraph_zero_based":16114},{"literal_text_all_w_t_and_m_t":"pSCellId","paragraph_zero_based":16115},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PSCell in which the UE failed to perform fast MCG recovery procedure or the UE successfully performed fast MCG recovery procedure.","paragraph_zero_based":16116},{"literal_text_all_w_t_and_m_t":"ra-InformationCommon","paragraph_zero_based":16117},{"literal_text_all_w_t_and_m_t":"This field is optionally included when connectionFailureType is set to 'hof' or when connectionFailureType is set to 'rlf' and the rlf-Cause equals to 'randomAccessProblem' or 'beamRecoveryFailure'; otherwise this field is absent.","paragraph_zero_based":16118},{"literal_text_all_w_t_and_m_t":"reconnectCellId","paragraph_zero_based":16119},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cell in which the UE comes back to connected after connection failure and after failing to perform reestablishment, or to indicate the suitable cell in which the UE reconnects after failure in performing MobilityFromNRCommand for voice fallback (without initiating re-establishment procedure). If the UE comes back to RRC CONNECTED in an NR cell then nrReconnectCellID is included and if the UE comes back to RRC CONNECTED in an LTE cell then eutraReconnectCellID is included.","paragraph_zero_based":16120},{"literal_text_all_w_t_and_m_t":"reestablishmentCellId","paragraph_zero_based":16121},{"literal_text_all_w_t_and_m_t":"If the UE was not configured with conditionalReconfiguration at the time of re-establishment attempt, or if the cell selected for the re-establishment attempt is not a candidate target cell for conditional reconfiguration, this field is used to indicate the cell in which the re-establishment attempt was made after connection failure.","paragraph_zero_based":16122},{"literal_text_all_w_t_and_m_t":"rlf-Cause","paragraph_zero_based":16123},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the last radio link failure that was detected. In case of handover failure information reporting (i.e., the connectionFailureType is set to 'hof'), the UE is allowed to set this field to any value, except for the case in which a radio link failure was detected in the source PCell while performing a DAPS handover..","paragraph_zero_based":16124},{"literal_text_all_w_t_and_m_t":"ssbRLMConfigBitmap","paragraph_zero_based":16125},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the SS/PBCH block indexes configured in the RLM configurations for the active BWP when the UE declares RLF or HOF.The first/leftmost bit corresponds to SSB index 0, the second bit corresponds to SSB index 1. This field is included only if the RadioLinkMonitoringConfig for the respective BWP is configured.","paragraph_zero_based":16126},{"literal_text_all_w_t_and_m_t":"timeConnFailure","paragraph_zero_based":16127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["53806987a6847b51c89c8d026ffb1a2f665886f30bd492b0fd426676ad012304","5a9556b31dde95e1fb93744545c52285bcdfb79ea7fdaab65e7b6bc3cb9175d1","ac47eaf7f44624f0603df31cad899c0e50ef081e2d785a45428136485f6e1c90","f9338846d0618fee47a77f45df17241c232ffce83b53a9be8fcf1d6c36d6b194","4b3ddb14f5729668381e0ee4f1e488158f21312203c5ffb3bfa650c3ba6ce1f3","91538058b2ece60099ac0cef662de2d3e83e9d3575f3f0ed0bbd1c45318d0b19","3ce5b841ed16dd7b52589b2ac35217bc2161578863476c2299aba94dd617c658","50e57a9fe3db5cad18205e5f85449368072805dd408323adc6f5ece5c83d4fb7","2c31c6148aed5f862de2dfaca51253b6c8a37461241d91565b3bc9b7589f233a","997db378d12510fae0567fc069a969a30dcd2417db8e93aa04244438d208d2ed","e358759502b20da949ba68c4566a3fdac93570012a54a5d6582cebc59aedce59","3eeeac14974ba25d6063e37bbf1b23a25094a01849e278efcd0298a053250fd0","f8531a778a94b09caed49a3b8d60523d04eff6e241825032d91dfa9aa4c81ccc","3fc0fbcfb59e766566dc1833a7d5620a96199e35d1e4a3579f25c5b2d91b11a2","a4efd3764e120e21fae55076640a78f2e1fbf29bf41d13ac101d172d12349245","7f5bc68c4dfdbc684c35a44cae9d51bfe6b9e0480f11558a61b19f1362135524","eb33ffe66e9a5996be3f2d25a9ace92cdef103a60c1cf595ebfc5063b73a7a7f","beb6afc4206b0bdda49e0163a38ddd8a1d426baf71c66ae0aef1d035b5ed87f7","9517dce3f11702cc7a279ca0f333e674cb08e488bee4b96f25361e9a22e388a1","d3e4df0cbba0d6c32a7975b67667469bcc5772a013984c9c9f5dd28fa54f4db8","721e590f811e70819bd25a0e4a1ca610d2383829cda5f7a4f094fa46fd71650b","262e7809972c17ebac0bb1bc6321a4f7bc9c28639af0b7dfc79b59b07bbaa71b","c0788651f908ef157cbd666b9d3e9918c6860dced6af12fb8175792d5b611e6a","e14f8dd0c82ea9e85d029977991f27c00ed2da2daf9e44756b1e5a0e55c5b6a9"],"paragraph_range_zero_based":[16104,16127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16104"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last HO execution until connection failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":16128},{"literal_text_all_w_t_and_m_t":"timeConnSourceDAPS-Failure","paragraph_zero_based":16129},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the last DAPS handover execution and the radio link failure detected in the source cell while T304 is running. Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":16130},{"literal_text_all_w_t_and_m_t":"timeSinceFailure","paragraph_zero_based":16131},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed since the connection (radio link or handover) failure. Value in seconds. The maximum value 172800 means 172800s or longer. In the case of failure(s) (either at source or at target or at both) associated to DAPS handover, this field indicates the time elapsed since the latest connection (radio link or handover) failure.","paragraph_zero_based":16132},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":16133},{"literal_text_all_w_t_and_m_t":"In case of handover failure, this field is used to indicate the time elapsed between the initiation of the last handover execution towards the target cell and the reception of the latest conditional reconfiguration. In case of radio link failure, this field is used to indicate the time elapsed between the radio link failure and the reception of the latest conditional reconfiguration while connected to the source PCell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":16134},{"literal_text_all_w_t_and_m_t":"timeUntilReconnection","paragraph_zero_based":16135},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time that elapsed between the connection (radio link or handover) failure and the next time the UE comes to RRC CONNECTED in an NR or EUTRA cell, after failing to perform reestablishment. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":16136},{"literal_text_all_w_t_and_m_t":"voiceFallbackHO","paragraph_zero_based":16137},{"literal_text_all_w_t_and_m_t":"This field is set if for the failed mobility from NR, the voiceFallbackIndication was included in the MobilityFromNRCommand message.","paragraph_zero_based":16138},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16139},{"literal_text_all_w_t_and_m_t":"SuccessHO-Report field descriptions","paragraph_zero_based":16140},{"literal_text_all_w_t_and_m_t":"c-RNTI","paragraph_zero_based":16141},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the target PCell of the handover for which the successful HO report was generated.","paragraph_zero_based":16142},{"literal_text_all_w_t_and_m_t":"eutraTargetCellInfo","paragraph_zero_based":16143},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target EUTRA PCell and the last measurement results of the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":16144},{"literal_text_all_w_t_and_m_t":"eutra-C-RNTI","paragraph_zero_based":16145},{"literal_text_all_w_t_and_m_t":"This field indicates the C-RNTI assigned by the E-UTRA target PCell of the mobility from NR command for which the successful HO report was generated.","paragraph_zero_based":16146},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":16147},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the neighboring NR Cells when a successful handover is executed.","paragraph_zero_based":16148},{"literal_text_all_w_t_and_m_t":"measResultNeighFreqList-RSSI","paragraph_zero_based":16149},{"literal_text_all_w_t_and_m_t":"This field is used to log the RSSI measurement results in dBm (see TS 38.215 [9]) taken for the neighbouring frequencies upon successful handover execution.","paragraph_zero_based":16150},{"literal_text_all_w_t_and_m_t":"measResultServCell-RSSI","paragraph_zero_based":16151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f8b1df38ec8818d061fedcd05ef610c843f8111e9f7683041fce24b894e4fc17","b5db1430bd36c630fc34fbb8135ff47950c0f058150f6fa5381c0c36bef05ebd","06b3cf3e46c083ac30a0e2fe06a1554db90230786c00c7f8ca7a2756f2922c24","bae22555afbd63e2cebd1e5272acf1bf1758290042b0f66290634473f9fb6baf","45df3c988da5263f0c4fd0965e3cb88a35697d209d16e97fc887dc605a611a98","04a89a29f6f3cb884f9fe14ad6abf1654ad81bf8bd651be9d6dec2c96e4360c5","6f38da4a14ad6d671a7f16d212cbc05ec5c59e835f3817e5c2a75e85cebf7136","0060eec750104766c65f7e887e9e5412ae01226278aaa9a76c267301bd604c70","3a2527e3374adbc11241a65c1781ab53210e6fdfc59627e7a0ada610b83ec740","41e9c23a92ffef67dc129dfd1ff7bdec7e0cf3e19c8eda6d4310d22a15c6fa6c","a9103d6413ccadd7bd990ba7770289525902b951def3b2eee03e80bb0c642f75","6870c44dca87121bf989d09d1d605efcf193ac7cba961c38921632642fd62855","1308654d773753c8971ef03edb7ac05052d53a64ac033a9aeef5fa80b64357b9","5b20b7cfd16ed5f7761008016f3d8761be18272f820f1f7e01eb10f54d4b93ed","f16b07809bb8c3a4f4ddb2c1da47c50dcc88409eeed8f9eec023686d90d85540","36d9b0216e0316d5a61f2efda3599d1010ae8ee5a53373c491f33b8672cad1fa","0171a6e1a579aa478b0bbf60b8203cb9c526ff9869ac406894fe18dea0cc99bc","b2ddf9b5aac907378f9a195e5f4dac30ccf8483f85f028791ddbe63f90456ebe","d5599f8e1e0f17b26c51679e61c55b7cc57882ce5d021d47f80a21fbcf3ee4d5","76ed9f29ba5c58fd2105a2d5f56ad6132ec18e913abf1e5fb689c43048b42d0a","6d5707180603f771abd197a22678640e08ab7b2a2d913446f63ad90b05172403","4c74ad9525aeaecba02574780008533109446f82e18141c2152ce7a4aff11087","85a3d221c145e897ffabcf68522092c08235ccf1af512837f95fe19ef67859fc","49f8202cab6bfc2860acb7174304e772f92872ed89b17db80e46f7ea071df682"],"paragraph_range_zero_based":[16128,16151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16128"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field refers to the log RSSI measurement results in dBm (see TS 38.215 [9]) taken for the frequency of the source PCell upon successful handover execution.","paragraph_zero_based":16152},{"literal_text_all_w_t_and_m_t":"rlf-InSourceDAPS","paragraph_zero_based":16153},{"literal_text_all_w_t_and_m_t":"This field indicates whether a radio link failure occurred at the source cell while T304 was running.","paragraph_zero_based":16154},{"literal_text_all_w_t_and_m_t":"shr-Cause","paragraph_zero_based":16155},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the successful HO report.","paragraph_zero_based":16156},{"literal_text_all_w_t_and_m_t":"sourceCellMeas","paragraph_zero_based":16157},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":16158},{"literal_text_all_w_t_and_m_t":"sourcePCellId","paragraph_zero_based":16159},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":16160},{"literal_text_all_w_t_and_m_t":"targetPCellId","paragraph_zero_based":16161},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":16162},{"literal_text_all_w_t_and_m_t":"targetCellMeas","paragraph_zero_based":16163},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the target PCell of a handover in which the successful handover triggers the SuccessHO-Report.","paragraph_zero_based":16164},{"literal_text_all_w_t_and_m_t":"timeSinceCHO-Reconfig","paragraph_zero_based":16165},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the initiation of the last conditional reconfiguration execution towards the target cell and the reception of the latest conditional reconfiguration for this target cell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":16166},{"literal_text_all_w_t_and_m_t":"timeSinceSHR","paragraph_zero_based":16167},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the execution of the last MobilityFromNRCommand towards the target EUTRA cell. Value in seconds. The maximum value 172800 means 172800s or longer.","paragraph_zero_based":16168},{"literal_text_all_w_t_and_m_t":"upInterruptionTimeAtHO","paragraph_zero_based":16169},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the time of arrival of the last PDCP PDU received from the source cell for any data radio bearer and the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer, and it is measured at the time of arrival of the first non-duplicate PDCP PDU received from the target cell for any data radio bearer. The field is set only in case of DAPS handover.Value in milliseconds. The maximum value 1023 means 1023ms or longer.","paragraph_zero_based":16170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16171},{"literal_text_all_w_t_and_m_t":"FlightPathInfoReport field descriptions","paragraph_zero_based":16172},{"literal_text_all_w_t_and_m_t":"timeStamp","paragraph_zero_based":16173},{"literal_text_all_w_t_and_m_t":"Time stamp that describes estimated time of arrival, if available, of the UE at the corresponding wayPointLocation.","paragraph_zero_based":16174},{"literal_text_all_w_t_and_m_t":"wayPointLocation","paragraph_zero_based":16175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["130586c83573a69b005d6c882c8a24e352fe60a56f12e917efb81073c2cbd538","646698f8092673853821edaa8b1094e29008b94d9f78dbdb54bfc3ee72b5fd02","df1a2b69037d51c2d93adafa0a3b4b7e928bcb8b57e43021fff0c8b990bdab0c","c16c2ae50ce71a0cd521544531a9771294cb8da1093750730f92136beb03cb38","fddd5737fa701f33c6ca5d39dd1f69cf32bfc2d808694706b5d7e57a86c81ac4","c67e33286dbc2fc34d4ad63b4a697bb9039552dd16e2e7d460c4d7b533eee918","91541f624eb3b5b0113b70b94a5e3a37f25c21091105218fd45a6c217986290a","927ff96d976f571ef0e94721cbdab3c99fb87c401d4ddbea7e39a42c444b2dce","41a7dd85262214356ec6d9552f0a47f21c036e05712e33c911529af4acafbc8a","4e93c645c57681cf9c99c7f153ce524ed4267f62835c863749c5af6e1efbcdfc","6a32c33b6f127e8f19c97dbf9dee72f5feb52e21bb0a9241cad14bf056480d77","c27e9bfc3b7e0f1c4813dc482475a52d373a1b1b4330d16bea0f6922c8f1d491","37078a59cc1b86242588bb330d713322daaec18926d664ad66b79aa00fffed1d","a6256b6d37770b6cfd0d232232180fd39564893a9bf337957da9f8fa450d36c7","de5a9a175b5224c9b46facc52e3675b3b348b0138d6c107e76a9c0f86962af0b","b4193014f6007ec16663b4050ee7189dc58823ec808f701a1bc3066579ad0f98","315434a69ea7e9467737b16eb58744c9b2b46a69fe3f88277f21c448a99d30fc","fd6a6154972b4cd05ef59aa777ee18c3634e49286bf0fd8c0f3965b75361a79d","b7273f676dda8fb501fb6d978d5a2c6156129ed36f69ee04a0ba431fbc0a0cfd","b6a4eb064e2d71c4905b76328ad1deb3b761f6ba74092ae29c251a278c33b8a1","e2bd85a723d9ad46a7f57ee427c73af37525a79771d6bca5bcb8443a044dbec3","e82f01add487b79941c87af6fce4a0b3568d08e84d8bcc4418f71d2e45e4b24f","19e70c4d8acd3e79f7035347a1409db57c33be9e62362066c7aabcba26834feb","e056939a6dbe053171010c380550f70aaaebb3c060b0155e0077a9de27daaca6"],"paragraph_range_zero_based":[16152,16175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16152"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Location coordinates of the planned waypoint. Parameter type LocationCoordinates defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":16176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16177},{"literal_text_all_w_t_and_m_t":"SuccessPSCell-Report field descriptions","paragraph_zero_based":16178},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":16179},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results according to the initiating node configuration taken in the neighboring NR Cells when a successful PSCell change/addition is executed.","paragraph_zero_based":16180},{"literal_text_all_w_t_and_m_t":"pCellId","paragraph_zero_based":16181},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the PCell to which the UE was connected when the successful PSCell change or addition triggers the SuccessPSCell-Report.","paragraph_zero_based":16182},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":16183},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure for which the successful PSCell change report is logged is SN initiated or not.","paragraph_zero_based":16184},{"literal_text_all_w_t_and_m_t":"spr-Cause","paragraph_zero_based":16185},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the cause of the successful PSCell change or addition report.","paragraph_zero_based":16186},{"literal_text_all_w_t_and_m_t":"sourcePSCellId","paragraph_zero_based":16187},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the source PSCell of a PSCell change in which the successful PSCell change triggers the SuccessPSCell-Report.","paragraph_zero_based":16188},{"literal_text_all_w_t_and_m_t":"sourcePSCellMeas","paragraph_zero_based":16189},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the source PSCell of a PSCell change in which the successful PSCell change triggers the SuccessPSCell-Report.","paragraph_zero_based":16190},{"literal_text_all_w_t_and_m_t":"targetPSCellId","paragraph_zero_based":16191},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the target PSCell of a PSCell change/addition in which the successful PSCell change or addition triggers the SuccessPSCell-Report.","paragraph_zero_based":16192},{"literal_text_all_w_t_and_m_t":"targetPSCellMeas","paragraph_zero_based":16193},{"literal_text_all_w_t_and_m_t":"This field refers to the last measurement results taken in the target PSCell of a PSCell change/addition in which the successful PSCell change or addition triggers the SuccessPSCell-Report.","paragraph_zero_based":16194},{"literal_text_all_w_t_and_m_t":"timeSinceCPAC-Reconfig","paragraph_zero_based":16195},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed between the initiation of the last conditional reconfiguration execution towards the target PSCell and the reception of the latest conditional reconfiguration for this target PSCell. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":16196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16197},{"literal_text_all_w_t_and_m_t":"–UEPositioningAssistanceInfo","paragraph_zero_based":16198},{"literal_text_all_w_t_and_m_t":"The UEPositioningAssistanceInfo message is used to provide positioning assistance information as requested by the Network.","paragraph_zero_based":16199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed",