{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32400},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier ::=             SEQUENCE {","paragraph_zero_based":32401},{"literal_text_all_w_t_and_m_t":"    offsetToCarrier                     INTEGER (0..2199),","paragraph_zero_based":32402},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":32403},{"literal_text_all_w_t_and_m_t":"    carrierBandwidth                    INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":32404},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32405},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32406},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation         INTEGER (0..4095)                                       OPTIONAL            -- Need S","paragraph_zero_based":32407},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":32408},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32410},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-STOP","paragraph_zero_based":32411},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32413},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier field descriptions","paragraph_zero_based":32414},{"literal_text_all_w_t_and_m_t":"carrierBandwidth","paragraph_zero_based":32415},{"literal_text_all_w_t_and_m_t":"Width of this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier) (see TS 38.211 [16], clause 4.4.2).","paragraph_zero_based":32416},{"literal_text_all_w_t_and_m_t":"offsetToCarrier","paragraph_zero_based":32417},{"literal_text_all_w_t_and_m_t":"Offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier). The maximum value corresponds to 275*8-1. See TS 38.211 [16], clause 4.4.2.","paragraph_zero_based":32418},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":32419},{"literal_text_all_w_t_and_m_t":"Indicates the downlink Tx Direct Current location for the carrier. A value in the range 0..3299 indicates the subcarrier index within the carrier. The values in the value range 3301..4095 are reserved and ignored by the UE. If this field is absent for downlink within ServingCellConfigCommon and ServingCellConfigCommonSIB, the UE assumes the default value of 3300 (i.e. \"Outside the carrier\"). (see TS 38.211 [16], clause 4.4.2). Network does not configure this field via ServingCellConfig or for uplink carriers.","paragraph_zero_based":32420},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":32421},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of this carrier. It is used to convert the offsetToCarrier into an actual frequency.","paragraph_zero_based":32422},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":32423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b2e09c3fa399f72faf2c4e8e61a129c9ea9ad8268330948b1924adfd465f9057","8f776797495ec0869eae977caea09275cc2404d2bb2569ce67ecbab6fab098b0","22c57edc8511a550ca7e4d52efe26ef200d7992b7b53b431a2728e05dfff6364","ba49d0db4f6b384c64950c7ce25027015437eb4521f9f380fae5503136bc1206","09229e710fc762e9ab7c2dfab6a951e2c8c1c0d26c22fe5cb75af19f27eefc7a","6832f6aa064945f3b3111f55dddfbb92aa5454d4783adff9cd2f8e169b99298a","b31b8dd6fc6d7cdad6de000f1ec8131538f95c438cdd93dd6b98773243197efe","c4f895575da1ab501d5ed56e78b7ddcf30fbb751b3f833ddd47a687b730e3d87","d1b6b5b0307c706cf8d9bc4127bb6bca00b099a1960f11203b0ebbda903a3202","f1ad6e7ad4d93a0c99450c267972e5681170372b95a5e16f63f8f11379e04db2","eb92402c2d7abf88ca39beb75cb8cf38162614b228cc2bcf708488aa477f9f23","edaab59ce810ad1adda0da4cb86a9516543afff1303300e411b5459cb402e382","0a00c3978557ff889d814c35757cf392384b2436084f71bbaed8202ce352132f","67ed6a74d3b845152c2a4c3a9165cc907e955238a81c6dfcaeb71f9b5d63b0c5","166380577ac6fff6d2bb84b0dfd34e71cc629604a90ed23237726a365a86ed7c","8d6e3f69de6fdef64e0f4a9dcbc920282849c117f5f57c8c71a49ad555fc61e5","1316f1bac610afb6b6c6023c3c3806629e4d8272a0218a041245a83d3025713d","b8b36addec0a54752ae84a2b0488d84ecfa65d30154ae889234d9750ba624a2a","2ebefaf9144765ae1f3d1eb74c378cd688006aff1b51a55946b99e696d3b06fb","a4c47323e55eed388e7071f6ea0845f60940432c66502c1f89c6b84eddd36e2d","3d0dc8131d6e534bef8555d58b99eb5674ff8e1ebbb96881c17bd4cc481ce60b","fa715e0e33639dc0124c7b0b979b522691d139c8975b4f100c9ad64dba1fb4ac","0ad6426e3405100288efbbde85ff5b2effd06565abdf354eabc5c9f77b8d0eff","d8857c695def8d0318e8b0540b9af75d2192618bd27ef4d15d8bbca366e1d312"],"paragraph_range_zero_based":[32400,32423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32400"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":32424},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":32425},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":32426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32427},{"literal_text_all_w_t_and_m_t":"–SDAP-Config","paragraph_zero_based":32428},{"literal_text_all_w_t_and_m_t":"The IE SDAP-Config is used to set the configurable SDAP parameters for a data radio bearer. All configured instances of SDAP-Config with the same value of pdu-Session correspond to the same SDAP entity as specified in TS 37.324 [24].","paragraph_zero_based":32429},{"literal_text_all_w_t_and_m_t":"SDAP-Config information element","paragraph_zero_based":32430},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32431},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-START","paragraph_zero_based":32432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32433},{"literal_text_all_w_t_and_m_t":"SDAP-Config ::=                     SEQUENCE {","paragraph_zero_based":32434},{"literal_text_all_w_t_and_m_t":"    pdu-Session                         PDU-SessionID,","paragraph_zero_based":32435},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderDL                       ENUMERATED {present, absent},","paragraph_zero_based":32436},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderUL                       ENUMERATED {present, absent},","paragraph_zero_based":32437},{"literal_text_all_w_t_and_m_t":"    defaultDRB                          BOOLEAN,","paragraph_zero_based":32438},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToAdd                SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":32439},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToRelease            SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":32440},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32441},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32443},{"literal_text_all_w_t_and_m_t":"QFI ::=                             INTEGER (0..maxQFI)","paragraph_zero_based":32444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32445},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-STOP","paragraph_zero_based":32446},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4660415f2d115aee55e665d1679e9bd9be68715eda43f61693df6486bd67d791","86d56d84a37e4af31ef5a0a512bb2507a0a4e3953c05c46d0ee3a12c6553459a","9ace960336d486fe24c920b54bc14e6d420e5e435d3d5014577ddaeb183c8d96","ea3ec367365dc85a80840e2b8c00a40f91d1ddbd4db083df49cc37ee87289c9e","a34c3807f6587fd48d39c25c8aff78c21444a151fcb5fc17aebab25249a2a9cc","54f1a140aeb6662b35617724759b6fb503fb3b3e281bad8196e2d82277113a1b","0206ab4644ac6c776525da8e230831f00f928622a90e5545947460e9709b775b","e44ca27ad014f56f53ccbf4f729bc9b7f71dbacb3921b866124d60524712a04f","bfc09d15b1ca17537f17d2d2f8d595b0d446ae3195b3257973b048643bb0f32e","4fa53e34369e75d98ee9b4de760397e94ac3fec967a37c27ddc11c7b4fab9b66","3756e3f65e896a9a4db759d2013a3085af92afc6fceaae8e1c1d033720b379e2","1b464064ea3dce864995e7a980a0e0b77621e0055c6d3d762d0140b5b4752a39","88f38dbf404cbda0cdda271f9a3d900c9aaa7f132c994075ec94ea9fdada7350","e98403333a426c0ea5749e7742e1c7c219a1e248274cb15c584d5be3b0c6a389","ea3ea1ec44d74b8d6771dc32a263088626f338c60068e687d6064fb4c7f4a569","e24d657d6e28a28fa3795688daea0cdea9a817da86473832f9706a71d36ce8a7","121d6fe4658396b9020af850adcc1ca03da494b6dc0b0d89d9222eafc59ca511","f208aa896e9fe5366fd742b54c8dd192c2c3fe4001b35abda83d433320692986","e22029dd74d8fd63760a72938a432ea8e002458a29714121e1268f8cba462537","3e39bb37c5d82b9b7de24bc762490a16d4e908009f8c11c3f1fd7a7b896e43b0","bcae3715bcf578fe5001c2d16981dfc60f8f5753d14b08dd89f943aff780539e","c05768220560896798526b199a217793ead29e723ac3f54e2b67836114ed69df","c06b064126d83920174d0a65d23ba885d236769169a37bdeb2484af45f282ff5","5ec48b3a0664fdb21173a99da9c812cb47db729dae5b2a6df03f26bc6108de36"],"paragraph_range_zero_based":[32424,32447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32424"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32448},{"literal_text_all_w_t_and_m_t":"SDAP-Config field descriptions","paragraph_zero_based":32449},{"literal_text_all_w_t_and_m_t":"defaultDRB","paragraph_zero_based":32450},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default DRB for this PDU session. Among all configured instances of SDAP-Config with the same value of pdu-Session, this field shall be set to true in at most one instance of SDAP-Config and to false in all other instances.","paragraph_zero_based":32451},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToAdd","paragraph_zero_based":32452},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of UL QoS flows of the PDU session to be additionally mapped to this DRB. A QFI value can be included at most once in all configured instances of SDAP-Config with the same value of pdu-Session. For QoS flow remapping, the QFI value of the remapped QoS flow is only included in mappedQoS-FlowsToAdd in sdap-Config corresponding to the new DRB and not included in mappedQoS-FlowsToRelease in sdap-Config corresponding to the old DRB.","paragraph_zero_based":32453},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToRelease","paragraph_zero_based":32454},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of QoS flows of the PDU session to be released from existing QoS flow to DRB mapping of this DRB. ","paragraph_zero_based":32455},{"literal_text_all_w_t_and_m_t":"pdu-Session","paragraph_zero_based":32456},{"literal_text_all_w_t_and_m_t":"Identity of the PDU session whose QoS flows are mapped to the DRB.","paragraph_zero_based":32457},{"literal_text_all_w_t_and_m_t":"sdap-HeaderUL","paragraph_zero_based":32458},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for UL data on this DRB. The field cannot be changed after a DRB is established. The network sets this field to present if the field defaultDRB is set to true.","paragraph_zero_based":32459},{"literal_text_all_w_t_and_m_t":"sdap-HeaderDL","paragraph_zero_based":32460},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for DL data on this DRB. The field cannot be changed after a DRB is established.","paragraph_zero_based":32461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32462},{"literal_text_all_w_t_and_m_t":"–SearchSpace","paragraph_zero_based":32463},{"literal_text_all_w_t_and_m_t":"The IE SearchSpace defines how/where to search for PDCCH candidates. Each search space is associated with one ControlResourceSet. For a scheduled SCell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent (regardless of their presence conditions). For a scheduled SpCell in the case of the cross carrier scheduling, if the search space is linked to another search space in the scheduling SCell, all the optional fields of this search space in the scheduled SpCell are absent (regardless of their presence conditions) except for nrofCandidates.","paragraph_zero_based":32464},{"literal_text_all_w_t_and_m_t":"SearchSpace information element","paragraph_zero_based":32465},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32466},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-START","paragraph_zero_based":32467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32468},{"literal_text_all_w_t_and_m_t":"SearchSpace ::=                         SEQUENCE {","paragraph_zero_based":32469},{"literal_text_all_w_t_and_m_t":"    searchSpaceId                           SearchSpaceId,","paragraph_zero_based":32470},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                    ControlResourceSetId                                        OPTIONAL,   -- Cond SetupOnly","paragraph_zero_based":32471}],"sourc