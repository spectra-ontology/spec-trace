2c20bf","1ea090099a9f285ea7375c859618da5618f965bc65ed97f962c0e451331f4ad9","059c209eedc78ea0afdc7b789db5f5e29eebc3b6a015e8eee3014cb72cd850ae","b070665986e6986e4c036625851867b4358855f4a2b7caa767baf7df6e91e5b3","18c2b9634342136fe5ccdec8cbff25a63b20e4aff9da2a21ad3b9c30838e86b8"],"paragraph_range_zero_based":[17328,17351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p17328"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB12-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB12 is broadcast.","paragraph_zero_based":17352},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":17353},{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB12-IEs. A segment number of zero corresponds to the first segment, A segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":17354},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":17355},{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":17356},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":17357},{"literal_text_all_w_t_and_m_t":"This field indicates whether CSI reporting is enabled in sidelink unicast. If not set, SL CSI reporting is disabled.","paragraph_zero_based":17358},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigCommonGC-BC","paragraph_zero_based":17359},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3]. This field, if present, also indicates the gNB is capable of sidelink DRX.","paragraph_zero_based":17360},{"literal_text_all_w_t_and_m_t":"sl-EUTRA-AnchorCarrierFreqList","paragraph_zero_based":17361},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configurations.","paragraph_zero_based":17362},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoList, sl-FreqInfoListSizeExt","paragraph_zero_based":17363},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication/discovery configuration on some carrier frequency (ies). In this release, only one entry can be configured in sl-FreqInfoList. More entries can be configured in sl-FreqInfoListSizeExt.","paragraph_zero_based":17364},{"literal_text_all_w_t_and_m_t":"sl-L2U2N-Relay","paragraph_zero_based":17365},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink Layer-2 U2N relay operation.","paragraph_zero_based":17366},{"literal_text_all_w_t_and_m_t":"sl-L2-U2U-Relay","paragraph_zero_based":17367},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink Layer-2 U2U relay operation.","paragraph_zero_based":17368},{"literal_text_all_w_t_and_m_t":"sl-L3U2N-RelayDiscovery","paragraph_zero_based":17369},{"literal_text_all_w_t_and_m_t":"This field indicates the support of L3 U2N relay AS-layer capability, i.e. NR sidelink L3 U2N relay discovery.","paragraph_zero_based":17370},{"literal_text_all_w_t_and_m_t":"sl-L3-U2U-RelayDiscovery","paragraph_zero_based":17371},{"literal_text_all_w_t_and_m_t":"This field indicates the support of L3 U2U relay AS-layer capability, i.e. NR sidelink L3 U2U relay discovery.","paragraph_zero_based":17372},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":17373},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":17374},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPowerCA","paragraph_zero_based":17375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["56c868118a0f9a09d91577cd100e1ed9607642324d35852349c67e0de5ccca17","1b06f9e5b0fdc37817e1fb74a6600165b5cc02dca23c255b879d304caa6632b1","f2b9e7b2a02097939bd795583be94d8a4fec858ea3271f19e8345cea86cf0b6e","7853ed7b5792d10cbad4e9b75d96ce923fed1cc3ccfcdf7b55ae6edc4c0b9647","3401c6d48509057e004d402fb637616eb6963752b41dfe94ca498ca49f858472","3873aae3b3a65613dfe2de35873e250a98007d0e510dbc516cc60458f77a9bb2","c8ac79297bcf6c7bc49fbfd4b5177285f07cf7c353fc903a653b6f829482ac6c","4b5fc856ed572c2c27690b484a816da76c972ee31aec746e1ba2e418fb76ca63","09b47c71c11a2833681534f6598835bdbe5a3cbfd4de20d2da880b7c50c8dcd6","5fb139a3e424011a6454cc0ac79d525db4c5a5045243e433645b79a455442c33","50606834594f14aa6cfa1e4f5aa9200a00af171208323fd5c21745addeab5e7b","564252e55f37a6dc54a991ae56ad8a2670d29fa5f7c16db0fed34cfb35151f3d","4d61bb94a6ad9964a15e9603a2008eb103725a7da0935182ee419e5424f161b5","4690b0fc75db9283e61ca82a75ee2a8241f15075d2d0845280986022fe55bcc2","058fcae48befaf74b2034419c9f547d12e22d3e803397103de65734c4edcc973","0379fdf21979a11a7b59551700b6e84ac00d432cf69e7e00e6b83d8c4b42ac7f","3b0d4380142b20334b577eff879639d2a95cee95391a8b3c8b5060fec7681f2b","7c97d49cbf23e1870d21be961c5e5024f38d727440ceb6571c904409f7af12d5","786951f6880e9abba66366d3d2da397f43b8b726dfb938c69ad8965b63c7011b","b7eb3a19b5ce78c4d10dd8b2eecd9c7564be5d6a39760059a3e74a3c78f8a386","296747b30f6e10d773e35584902cc7e59d2ab1f71a818a2a07f87485d3013b52","2907e49f7310f73b55591daa76a439ad4d01a80847aa32aabc2c23ceea15dc62","74b9bb4611b25cca0f0ad04a9d9794357515a73a46c66eec4c7d785ccc89171c","e7bf3f4f23555f45237b0dc609e6b1fe9923380c5400e201d3a8f8abf40b27f2"],"paragraph_range_zero_based":[17352,17375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p17352"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all sidelink carriers.","paragraph_zero_based":17376},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigCommon","paragraph_zero_based":17377},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement configurations (e.g. RSRP) for NR sidelink communication.","paragraph_zero_based":17378},{"literal_text_all_w_t_and_m_t":"sl-NonRelayDiscovery","paragraph_zero_based":17379},{"literal_text_all_w_t_and_m_t":"This field indicates the support of NR sidelink non-relay discovery.","paragraph_zero_based":17380},{"literal_text_all_w_t_and_m_t":"sl-NR-AnchorCarrierFreqList","paragraph_zero_based":17381},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication/discovery configurations.","paragraph_zero_based":17382},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":17383},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on.","paragraph_zero_based":17384},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerConfigList","paragraph_zero_based":17385},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":17386},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerConfigList, sl-RLC-BearerConfigListSizeExt","paragraph_zero_based":17387},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations. For L2 U2U operation, sl-RLC-BearerConfigList also indicates the PC5 Relay RLC Channel configurations.","paragraph_zero_based":17388},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":17389},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":17390},{"literal_text_all_w_t_and_m_t":"sl-SyncFreqList","paragraph_zero_based":17391},{"literal_text_all_w_t_and_m_t":"Indicates a list of candidate carrier frequencies that can be used for the synchronisation of NR sidelink communication. For SL-Freq-Id-r16, the value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":17392},{"literal_text_all_w_t_and_m_t":"sl-SyncTxMultiFreq","paragraph_zero_based":17393},{"literal_text_all_w_t_and_m_t":"Indicates that the UE transmits S-SSB on multiple carrier frequencies for NR sidelink communication. If this field is absent, the UE transmits S-SSB only on the synchronisation carrier frequency.","paragraph_zero_based":17394},{"literal_text_all_w_t_and_m_t":"t400","paragraph_zero_based":17395},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 as described in clause 7.1. Value ms100 corresponds to 100 ms, value ms200 corresponds to 200 ms and so on.","paragraph_zero_based":17396},{"literal_text_all_w_t_and_m_t":"t400-U2U","paragraph_zero_based":17397},{"literal_text_all_w_t_and_m_t":"Indicates the value for timer T400 to be applied for end-to-end PC5 connection in sidelink U2U relay operation as described in clause 7.1. Value ms200 corresponds to 200 ms, value ms400 corresponds to 400 ms and so on.","paragraph_zero_based":17398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"docu