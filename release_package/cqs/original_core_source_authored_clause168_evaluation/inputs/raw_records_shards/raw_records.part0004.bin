{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33216},{"literal_text_all_w_t_and_m_t":"–SearchSpaceZero","paragraph_zero_based":33217},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceZero is used to configure SearchSpace#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":33218},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero information element","paragraph_zero_based":33219},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33220},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-START","paragraph_zero_based":33221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33222},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero ::=                 INTEGER (0..15)","paragraph_zero_based":33223},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33224},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-STOP","paragraph_zero_based":33225},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33227},{"literal_text_all_w_t_and_m_t":"–SecurityAlgorithmConfig","paragraph_zero_based":33228},{"literal_text_all_w_t_and_m_t":"The IE SecurityAlgorithmConfig is used to configure AS integrity protection algorithm and AS ciphering algorithm for SRBs and DRBs.","paragraph_zero_based":33229},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig information element","paragraph_zero_based":33230},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33231},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-START","paragraph_zero_based":33232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33233},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig ::=         SEQUENCE {","paragraph_zero_based":33234},{"literal