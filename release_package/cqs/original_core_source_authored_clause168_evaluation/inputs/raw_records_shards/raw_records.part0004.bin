,"3957845fd8232bae2dece8d4d8bc671f58c9d32604f35d4a085e731ca6c5ff28","a74d7b462787855e3a1a18772eb0dc156ea52d9121c95cb08cd47506dad4a8e7","e475412f96f1b10e50314a152aa698e97be912b1f2256577af0b0fdd2d102dba","e83e50c28afb2971f592d80d4bbed5e1c44b9a81a6ae15336ecc24d185a6d31a","085c2da64d63a7dcb34206f40428afe0e8a62bbe68ed41d9d1d804efea1eac0d","5857590bb729f72efc1ee9a63564a0dd661069f3f629b27cf70cc9a9a897e981","6c5d72016a2676bc31732f36bda5e52a87128f0c52da777c5a43c83b56082edb","82e820926f0a5cbd6eb7659717e2951b286d029a9e97980f30a533085ea7f7af","046c728ca6aea48e2433e5af5deeb81f6d852c737f561d1516a7b89fcade53e5","026231cd17254713d9eb650c1bf2b9b945d13ba20f17d4e0142dbed309f172fc"],"paragraph_range_zero_based":[25584,25607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p25584"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":25608},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-Aerial","paragraph_zero_based":25609},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number for aerial UE(s), as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":25610},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxList","paragraph_zero_based":25611},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values. If the field is absent the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63]. If nr-NS-PmaxList-v1760 is present, it shall contain the same number of entries, listed in the same order as in nr-NS-PmaxList (without suffix).","paragraph_zero_based":25612},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxListAerial","paragraph_zero_based":25613},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values for aerial UE(s). If the field is absent, the value indicated by the corresponding field within frequencyBandList for the corresponding NR frequency band number applies, if present. Otherwise (i.e. the field is not present for the corresponding NR frequency band number in any of the nr-NS-PmaxList, nr-NS-PmaxList-v1760 or nr-NS-PmaxListAerial), the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":25614},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25615},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25616},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25617},{"literal_text_all_w_t_and_m_t":"OptULNotSIB2","paragraph_zero_based":25618},{"literal_text_all_w_t_and_m_t":"The field is absent for SIB2 and is mandatory present in SIB4 and frequencyInfoDL-SIB. Otherwise, if the field is absent in frequencyInfoUL-SIB in UplinkConfigCommonSIB, the UE will use the frequency band indicated in frequencyInfoDL-SIB in DownlinkConfigCommonSIB.","paragraph_zero_based":25619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25620},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapConfig","paragraph_zero_based":25621},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapConfig specifies the MUSIM gap configuration and controls setup/release of MUSIM gaps.","paragraph_zero_based":25622},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig information element","paragraph_zero_based":25623},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25624},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-START","paragraph_zero_based":25625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25626},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":25627},{"literal_text_all_w_t_and_m_t":"    musim-GapToReleaseList-r17           SEQUENCE (SIZE (1..3)) OF MUSIM-GapId-r17               OPTIONAL, -- Need N","paragraph_zero_based":25628},{"literal_text_all_w_t_and_m_t":"    musim-GapToAddModList-r17            SEQUENCE (SIZE (1..3)) OF MUSIM-Gap-r17                 OPTIONAL, -- Need N","paragraph_zero_based":25629},{"literal_text_all_w_t_and_m_t":"    musim-AperiodicGap-r17               MUSIM-GapInfo-r17                                       OPTIONAL, -- Need N","paragraph_zero_based":25630},{"literal_text_all_w_t_and_m_t":"   ...,","paragraph_zero_based":25631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["52a33c2e227877c4f147a0170652be428e9f1876b781b64425486aac0ba982f8","6e8558ea31f4cea207637f1b492f9fc153473f830ecb89d6ebd014fec2fa4329","76096cdd7784b9321553abb99f1ff95ad486645874e0d182d74ef8de3610bbd7","a206814a632174ed0ee3bc64128d4db03935457c399bff4f3cd542077f626230","3c31300ce87cbdae6181a42c08d75c69d7f7db2f86bb3042e1af7566434efa18","208a3981f54712ad58116107d98495462173161f41d6064712610b1d95aee75c","238ef535ba6fa4f8d3915b4dd5428edc3aab8e8ded8068f3b9a762da3c24bafb","a0ffeb5bab80c6b568a444f4db8f92cc739ccd57240b56fd5366afa9ce4d7b17","54c0080d296682ad193de1be2ba59049f15c8fcb5a23420fa38129b6008fc8f6","2c2c32197072938d3634a6018e19b78b35fec4d02f134cc468da8da08b6476a8","b252427b492472478b0a1d29e4dbf38581592404c772a10352a0e4e4d1ff4d57","75d1dfe430f47ac257a57d3436885611e40aee8900ed66d0bb330221e9cbe698","36592adba523c7cfe6f5f64025d246d73d8f29a478e75b8bcfebd51030dfd6f3","e586d7f27592e161858dc673fd6097dfe29f265a610a7f4fe34fc2f3d708bf30","1b2f2a5cacfbe66f56edf8c6e65150075badc679a3dedbf3cdb833ddb580a721","bf4f78a36af19c8ddeb71e9512c6d69fdda0b1d32fc6b25c0de7971391fee596","3a921c0ea49c3d6d13dcaf832b8eba1fb6cdf69f8373a61532067ecb6c5c4591","da3900a94ea6c48301ea9e5bfca089b3bf9367eebc9dcdd57f7c74dfbcb07367","f5cdc56b92178c6e8159b227a76404f0bfe8628d8d04e95409044abf8d2c044f","c153c6e574bf0fa7984c3403f5a4c53fc54557e6b2feb1cc26dac10ad44be3fa","cc2c824677ae56d74ac48416d12bef46e0f4beeffeafa2de0a1359dfe9d40776","b330bc133ac59af0c639116f5009440ab48143a1f35072c0e22743aefa7ca504","972e7869adf127d077f4251c4d8d6f6ef11a6d8ca969125e2bea345775cbb270","0d622ac5a400cd7164ad8949cf6ec820a636c22a8813b14f4e36b1de9dd2e2d0"],"paragraph_range_zero_based":[25608,25631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p25608"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":25632},{"literal_text_all_w_t_and_m_t":"    musim-GapPriorityToAddModList-r18    SEQUENCE (SIZE (1..3)) OF GapPriority-r17                  OPTIONAL, -- Need N","paragraph_zero_based":25633},{"literal_text_all_w_t_and_m_t":"    musim-GapKeep-r18                        ENUMERATED {true}                                      OPTIONAL  -- Need R","paragraph_zero_based":25634},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":25635},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25636},{"literal_text_all_w_t_and_m_t":"MUSIM-Gap-r17 ::=          SEQUENCE {","paragraph_zero_based":25637},{"literal_text_all_w_t_and_m_t":"    musim-GapId-r17                        MUSIM-GapId-r17,","paragraph_zero_based":25638},{"literal_text_all_w_t_and_m_t":"    musim-GapInfo-r17                      MUSIM-GapInfo-r17","paragraph_zero_based":25639},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25640},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25642},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-STOP","paragraph_zero_based":25643},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25645},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig field descriptions","paragraph_zero_based":25646},{"literal_text_all_w_t_and_m_t":"musim-AperiodicGap","paragraph_zero_based":25647},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM aperiodic gap as specified in TS 38.133 [14] clause 9.1.10. If UE indicates the musim-Starting-SFN-AndSubframe when requesting aperiodic gap the network can only configure the aperiodic gap with the same start point or no aperiodic gap. If the field musim-Starting-SFN-AndSubframe is absent for aperiodic gap, network can configure any timing as the starting point for aperiodic gap or configure no aperiodic gap.","paragraph_zero_based":25648},{"literal_text_all_w_t_and_m_t":"musim-GapInfo","paragraph_zero_based":25649},{"literal_text_all_w_t_and_m_t":"Indicates the values for musim-GapLength and musim-GapRepetitionAndOffset. When network provides periodic gap, network always signals the musim-GapLength and musim-GapRepetitionAndOffset as indicated by the UE's preferred MUSIM gap configuration.","paragraph_zero_based":25650},{"literal_text_all_w_t_and_m_t":"musim-GapKeep","paragraph_zero_based":25651},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to use \"keep solution\" for collided MUSIM periodic gaps. If \"keep solution\" is not granted, priority based solution is used as fallback solution) as specified in TS 38.133[14].","paragraph_zero_based":25652},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityToAddModList","paragraph_zero_based":25653},{"literal_text_all_w_t_and_m_t":"Indicates the priority of MUSIM periodic gap(s).","paragraph_zero_based":25654},{"literal_text_all_w_t_and_m_t":"If the network includes musim-GapPriorityToAddModList-r18, it includes the same number of entries, and listed in the same order, as in musim-GapToAddModList-r17.","paragraph_zero_based":25655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1ec671a8153a3c616423a7793b564c4dc2950f6d908dda98755b213a6f5815bc","618022b997f7387855d3b9d4ce93b025ef436a7a0f19fbb02aef077400b4339e","ba902512f9e554f72d9c909d77b1b9cbda12bc79d38678ef3e20a249d676e810","6946cad17c5b045b8fbd8db842aa522a196184285ece8b13c32d11c26acad972","eb52b1b16724211a4cd98d67d2d65b451f095835bc580d183cc88b878da746f4","707278fc8f78f956642589b01c7881017c9c0d90ab52fbf6574377013223e3cd","af5ada5830458081cd9cc505110bd42f0dbf71e46d6a77f56c726a9c4c135411","6ff2aa9188781bd68ff3019393b35adec10e6257395ad1822c9f88a75aa0e2e7","011185396f342230e940556746fab9603a8cc062daad467cddb4908036516999","4e22c02d344899eda032a5156a12507f71aa2327ee8a5556b8a1642cbc3cda67","ccefb497d7c6ac9fd87439d4121f67efee4d25629a7bd02376c02974476a1f5e","17d940d8606983860801f781cbe21b45b27958ec470beececc3d35cff8c2f08b","79a6f4d2ea4b3da8d47b221ce7b08302e56e4e9d31691042694f764d5349b058","6659836a021bd724e89fb8734ac7af635f67a264527f73ae96b67701cc8bbe88","02687ad02ce34ef2784c9f29155ca5fd2cdfadec067b16f0daaadb32b78be183","50485705d9b531f893bf9a8b01ad6098041e1a5436954ccd6d75141444da1886","9e0ade471afbbdada5f916a0d5c6c4e8b97a81f1b70c9d8676655a1217c2e2b2","bcdb101a2b37bd2eb591b51fa1e5fdc571351ca950a158cf39e44b48ca79b975","b8d134ab6bfa37091d8493fd501cf7c30758c374d3f23f57417f1bfcc1e7a4ab","9241fc1566e863609de4b50c47dbd5365e0665423b1bf3ab94621b2a41c2f785","4202bc61f6a2139dbb2c479c585b21a0531be022fb06c7a505abaab87a169571","a01136d761a2adef1f1707c6e23f6390050fdc716ba04d414dad0e12ced588f5","27431aeb7aea40aae397dbe1e0cbeffa8d47a747b9d2aec4314d2425d16a01f3","0384580b314b66a00202166189eb1812f6c25184442253c182452190fadd08a1"],"paragraph_range_zero_based":[25632,25655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p25632"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For the priority of MUSIM aperiodic gap, the MUSIM aperiodic gap is always kept (not dropped) from UE perspective in case of collisions with other gaps (i.e. all gaps including MUSIM gaps, etc).","paragraph_zero_based":25656},{"literal_text_all_w_t_and_m_t":"musim-GapToAddModList","paragraph_zero_based":25657},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to add or modify.","paragraph_zero_based":25658},{"literal_text_all_w_t_and_m_t":"musim-GapToReleaseList","paragraph_zero_based":25659},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to release.","paragraph_zero_based":25660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25661},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapId","paragraph_zero_based":25662},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapId is used to identify UE periodic MUSIM gap(s) to add, modify or release.","paragraph_zero_based":25663},{"literal_text_all_w_t_and_m_t":"MUSIM-GapId information element","paragraph_zero_based":25664},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25665},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPID-START","paragraph_zero_based":25666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25667},{"literal_text_all_w_t_and_m_t":"MUSIM-GapId-r17 ::=                  INTEGER (0..2)","paragraph_zero_based":25668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25669},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPID-STOP","paragraph_zero_based":25670},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25672},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapInfo","paragraph_zero_based":25673},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapInfo is used to indicate MUSIM gap parameters.","paragraph_zero_based":25674},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo information element","paragraph_zero_based":25675},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25676},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-START","paragraph_zero_based":25677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25678},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo-r17 ::=               SEQUENCE {","paragraph_zero_based":25679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["df5dcb070a7fe0fe78c6102aaaa99c6e7d5b8db7ae6607f18185e81e36cc41a4","b532d990c6d420f893b143bfaeb74b6a24f71429a15f69137bc8acce87756527","8f595bc3dbbb63c6e16517e45d681b164aa716df1243d5662832f91d16f37962","17e1050a965908174818df5206815efc32cf9c60afbe07eee266a8ccb1e30bc0","ac2f01fe8f870187c3854c61e257d31aa70d8da3746c1cf905f46a74848b3870","0ed0934f5b28482c5de8e7e69a8fd1e93d6f82fc56dc2e53b538ba1c42db9936","4c8f7c029eb651bfee574659cb166620002389149f9f7ccaec0375a4ec6aba8b","ff21376d37daf6861b55ae50bd6c01a4995529c61f3489523343374f9e8d4128","280c9016c7d476354c05466b70072405fc36d3f844cbc245b37ad086a2c90f0a","c207636f99b4d766623476c7a7d006722f3ea2dfe4b2396e1bfee1b54f421351","95f4fc07bf67fd6011deb545ec7c534deccc874cea1de66d3430bc255f99b148","ebb2a49ec8fdff1564b68d78140cc51ea0a27ac984f356388530032a7b161562","4eec399a606cb3594b58bc821f4a12f0828c43b3747b32d241baf4568f5f0cbc","203fd650d948a3d17257f99ac5d76b4f76e199fe4725cbc207f218acf354cfcb","84d77accba7cd0ec83f6f2f47e4e36f1b0a750807ddcab04d6f27cb30c6666f3","1701e3526c44d61ee12c8f751546608dd31e12ab59782ac088f15130fffb5013","33c543f1280cd3fdceff0d22dc70ed025937dcf97b4e9f8b57af95f97f44cf5f","215807d0f209