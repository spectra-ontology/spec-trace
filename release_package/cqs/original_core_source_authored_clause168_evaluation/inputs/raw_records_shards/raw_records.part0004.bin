dateInfoId","paragraph_zero_based":51808},{"literal_text_all_w_t_and_m_t":"SSB frequency and Physical Cell Identity of the candidate target cell.","paragraph_zero_based":51809},{"literal_text_all_w_t_and_m_t":"candidateCG-Config","paragraph_zero_based":51810},{"literal_text_all_w_t_and_m_t":"CG-Config message corresponding to the cell indicated by cg-CandidateInfoId.","paragraph_zero_based":51811},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51812},{"literal_text_all_w_t_and_m_t":"–HandoverCommand","paragraph_zero_based":51813},{"literal_text_all_w_t_and_m_t":"This message is used to transfer the handover command as generated by the target gNB.","paragraph_zero_based":51814},{"literal_text_all_w_t_and_m_t":"Direction: target gNB to source gNB/source RAN.","paragraph_zero_based":51815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a657aa8c804218dce0da1fce78b500a6e23339d7d97e1f7f65b83e9e059adfcf","b943dba4870579d0bb1ddb79bacca7c1e48790b3a4c930db9889eed5032f7024","31ce4e6ed01a4a77c6de17e7896d48b92c291eb6aad229cc1a57577e3c4f6768","87de889cfff97c0dd5021b8f72339e97e2cea22bacfadd1341cd973df6818adc","1f0f881e41b3f075d47de33ec41ce87d7a227263e7a8a42ccf9338111c1a0c5a","e4c234dd475228a53993701dd02c83be365c4ceb1055d47a200a94ec78b92455","a8251d4d91163c74de63c259d862f0ca1ab885ba81ec5f3600cab63458d12c5f","ff836e1d860acef89c4039085113d0c83729d7d0fc968c8dc1bb26272cef7dac","2def4706b3a40e12b36924377e97bb35035814f2c7bf7e3c6a20d8cdc13c927a","547ebd158f31e58096439b6424d7dd8d571883bc34b383136ff5861ffcd0d438","6a8a061395cd5bf08a1aee899bef95d806fbdf9a10b31022b5d6e701ccd0d800","beba5448a4ea4cfa10c01a4e84538e368face8bdd9ca6155a880703b2bece74e","e37eba4303a6c75e4005ab884f0261a6a