9}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"708f3bf17b8f6a9f223c3643ac2f82eb0fdb59a9de57fd5ab548b451f4c0e913","original_member_sha256":"59dbe1574ec38535648563015e0ce60a339298c8b5b70ba400618d7a85382db0","paragraph_ElementTree_utf8_XML_sha256":["5b9d3e94b2e2469a162f36c651ac6802b31fcc4b4fed4f8769f27295b66f32e3","0e47661d68410752894205dee6a9bbbad763c4fb8f938472f606caa30fd5b3b2","31987b5741c927300ef53ce2d79aeaf6d72bbfe83cbed6034fffe90abd3e587a","046072d789da32203b2dbdc5bf6faf7ce0947321bf61b1475c3867e7f07b4f28","ad7c58beb1d9e90fb0849bcd216a0fa195ed528b17181f725cf2b49a179cb8f1","826ddaefbd35bf5941dd0ba7402603c67afa4054d718e9bc0124542ef7dca6de","f93659204248bf7212a2a073874fa6ef6bab855e1f334d94d95f69bdfcb0d978","27bd932f46422e1d7df5207cbfe5444a21adbbe6da2200a59481ebd5390d6da0","84cfffd8b170c458e9fd1f937758338e77952052a138c7c60120dc1e8ee9c412","f7b3a7bb9ad97a828da3323273c2deac8004729d61d7f2c7a25185dd92d4eb66","623edfeb67c2d41b2b9e147012100dce2f709456a108863b11db12637e74c692","972c89243ea25b912af8179a8be8c77ab6d50347dd064fa94fff2d9d947bbd4b","022031e640f79d734e0c0078695b4546709c7cc0e2d4b09f740c852d83464850","90739a9b5718a75a6036a95b91a37f44f1e9aef38922942dfe97f431acb1a425","6c4b79aee2df9417fdcf7ff053d8ed2a9ea25e31efedf31e6292500ff9c4b627","8a2054446422db10127b53522c244dd671006eed469081cd46119e9103434846","09696b54939497a8ca2ba620420c03c7479c8446d64fb680ae1962b6d211066f","c002616492b1923e46d6fa95a25dac7944411eca88ccdcee2199f265ed726678","d02e8cbd697ae1810074c3012247d88e70339f7889a7482c352e21eca4a8f878","c5f38d6a91832c9a8e38d2325da0f42b92f52ae01630cd5b416fc1fb05444f01","c12009d1a4069bd875093c24d7d7a73ec7b911c9959ea6de75c006463a8b99ec","33e4949ac9ce20ea3d61df90775f877061484e77ec9a361bf5bf49b63f24e968","876bbe3661a3ddb165fb5d05779a16cfc7293e4cb4c4e37ee606eff5a8971d9c","1779b83bbca6b17ad500d566087c3a1920349a95b02927e5aa2c86d32d4ba747"],"paragraph_range_zero_based":[96,11