3595d4174cc8c8c9","4b32a2344e4cedf943c2f9c750de6356f77f86b2ebd334c30a4c99ba084a418e","c7f17d43f7e9f83fcc55a80d42bbf9a6c75b384da76c7ae83c5a47637844336f","1abfca4b302abc129aeb36591483874e51635e702d41cda342e54c3f2e6680cc","6c12025340c57c0f70bf862c457ce5580ac22d17f847b92077ec02f315df3d9b","715abb775ed11c9f1544e1cfce533cf2596150e40dc4acf9898961416e8427fc","8e9c82fecae0efb92911e01503cde263bd38760876f2aa295c9b648fae5d05cb"],"paragraph_range_zero_based":[12288,12311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12288"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"inactiveReceptionAllowed","paragraph_zero_based":12312},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE with a valid PTM configuration for a TMGI in the PagingGroupList stays in RRC_INACTIVE to receive the corresponding MBS multicast session.","paragraph_zero_based":12313},{"literal_text_all_w_t_and_m_t":"mt-SDT","paragraph_zero_based":12314},{"literal_text_all_w_t_and_m_t":"Mobile Terminated SDT indication. The network includes mt-SDT indication in paging message only if the UE's I-RNTI is included in the paging message.","paragraph_zero_based":12315},{"literal_text_all_w_t_and_m_t":"pagingRecordList","paragraph_zero_based":12316},{"literal_text_all_w_t_and_m_t":"If the network includes pagingRecordList-v1700, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix). If the network includes pagingRecordList-v1800, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix).","paragraph_zero_based":12317},{"literal_text_all_w_t_and_m_t":"pagingCause","paragraph_zero_based":12318},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to IMS voice. If this field is present, it implies that the corresponding paging entry is for IMS voice. If upper layers indicate the support of paging cause and if this field is not present but pagingRecordList-v1700 is present, it implies that the corresponding paging entry is for a service other than IMS voice. Otherwise, paging cause is undetermined.","paragraph_zero_based":12319},{"literal_text_all_w_t_and_m_t":"pagingGroupList","paragraph_zero_based":12320},{"literal_text_all_w_t_and_m_t":"If the network includes pagingGroupList-v1800, it includes the same number of elements, and listed in the same order, as in pagingGroupList-r17. The first element corresponds to the first TMGI in pagingGroupList-r17. The second element corresponds to the second TMGI in pagingGroupList-r17, and so on.","paragraph_zero_based":12321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12322},{"literal_text_all_w_t_and_m_t":"–RRCReestablishment","paragraph_zero_based":12323},{"literal_text_all_w_t_and_m_t":"The RRCReestablishment message is used to re-establish SRB1.","paragraph_zero_based":12324},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12325},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12326},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12327},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":12328},{"literal_text_all_w_t_and_m_t":"RRCReestablishment message","paragraph_zero_based":12329},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12330},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCREESTABLISHMENT-START","paragraph_zero_based":12331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12332},{"literal_text_all_w_t_and_m_t":"RRCReestablishment ::=              SEQUENCE {","paragraph_zero_based":12333},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":12334},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a68b9130e154ad3f022930cb9dfa98a56be5a2f42b1a258619b09e2d9673770c","22db0938c33bcffbee6924008dd3