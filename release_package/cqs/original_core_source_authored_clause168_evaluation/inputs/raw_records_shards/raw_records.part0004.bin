{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE RxTxTimeDiff contains the Rx-Tx time difference measurement at either the UE or the gNB.","paragraph_zero_based":32184},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff information element","paragraph_zero_based":32185},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32186},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-START","paragraph_zero_based":32187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32188},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff-r17  ::= SEQUENCE {","paragraph_zero_based":32189},{"literal_text_all_w_t_and_m_t":"    result-k5-r17         INTEGER (0..61565)                 OPTIONAL, -- Need N","paragraph_zero_based":32190},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32191},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32193},{"literal_text_all_w_t_and_m_t":"-- TAG-RXTXTIMEDIFF-STOP","paragraph_zero_based":32194},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32196},{"literal_text_all_w_t_and_m_t":"RxTxTimeDiff field descriptions","paragraph_zero_based":32197},{"literal_text_all_w_t_and_m_t":"result-k5","paragraph_zero_based":32198},{"literal_text_all_w_t_and_m_t":"This field indicates the Rx-Tx time difference measurement, see TS 38.215 [9], clause 10.1.25.3.1 of TS 38.133 [14] for UE Rx-Tx time difference and clause 13.2.1 of TS 38.133 [14] for gNB Rx-Tx time difference.","paragraph_zero_based":32199},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32200},{"literal_text_all_w_t_and_m_t":"–SCellActivationRS-Config","paragraph_zero_based":32201},{"literal_text_all_w_t_and_m_t":"The IE SCellActivationRS-Config is used to configure a Reference Signal for fast activation of the SCell where the IE is included (see TS 38.214 [19], clause 5.2.1.5.3. Usage of an SCellActivationRS-Config is indicated by including its scellActivationRS-Id in the Enhanced SCell activation MAC CE (see TS 38.321 [3] clause 6.1.3.55).","paragraph_zero_based":32202},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config information element","paragraph_zero_based":32203},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32204},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLACTIVATIONRS-CONFIG-START","paragraph_zero_based":32205},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32206},{"literal_text_all_w_t_and_m_t":"SCellActivationRS-Config-r17 ::= SEQUENCE {","paragraph_zero_based":32207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9508d782d2a80462c957801eabe6c7fe87c60dfa8d616130c199828b596f053b","738237afe4114591590476b8f2c828a6011c0b15207bdb28003f63524eb34d01","777ffe1c75e8b9055cd003eb7d3d2fbfec08b6bc3192822b7dc831c22801e0f0","2b5c97950c487a009a65f6ee61a5494e4eac8524151f8977f2b58b527178e288","6dcafb4ba95dffb2ce4b835214361c6202f7fb3f60a283fada716b6fe0bb0d60","bde7309d670e6f2d68c308fe6432069b92e0a7753631babee6fd72e2de0ef391","137cc169f61e88a82efb5813c9cb2f186198f37bd3461d1cca619e23ef1d2716","8faff71f56508f73580110b6c4a6cfa299f3ccb3ac99d6c4aed4abc6cf69f300","25576cd6b015ab047f615dcacaa8cce0654ae118a6eb8f8d6e5d980ef2a52067","b5c952feaf0cefeb6f63199827a1ec95810a46632eaa2e51577ca7dc85d064ed","6708df62e0caa24a73f18009b9d73bb94bd345aaf6d739ec6b0b2931c6379628","015c60c2510a972d77b9d5f6719aa9667141aa9e11b5aab7c7b80a546b3072a0","216786fe93b1213375e65fdcee14fadf7b5e983aace5ad1b3741b8e3ee26fc06","