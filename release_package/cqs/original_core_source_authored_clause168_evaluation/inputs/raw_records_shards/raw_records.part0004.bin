 or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p24"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"It is not possible for a UE to make an emergency call if the cell is barred. A network may enable the access for RedCap UEs in a cell, yet bar those UEs based on whether the RedCap UE uses 1Rx or 2Rx branches. The motivation for this functionality was to introduce control for the network over which device to access due to potential impact on, for example, performance.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"If the cell enables access for RedCap UEs but the RedCap UEs consider this cell as barred based on the 1Rx or 2Rx support or both, it would be beneficial to introduce an exception for those UEs to have access to the cell to make an emergency call or receive emergency information broadcast when possible if the cell enables access for RedCap UEs.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"This CR introduces a mechanism to allow RedCap UEs to have access to the cell to make an emergency call or receive emergency information broadcast, when possible, if the cell enables access for RedCap UEs but the RedCap UEs consider this cell as barred based on the 1Rx or 2Rx support .","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"The following logic is added to UE cell selection/re-selection procedure:","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"If the cell supports RedCap UEs and is not barred for any purposes, except for barring the RedCap UEs due to only supporrting 1Rx or 2Rx branches, then the Redcap can consider this as acceptable cell (for eg., for emergency calls), if the cell allows this by the relevant SIB1 IEs.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["33ceb419e32573a1af11f7b677a8172003c7327c6a45bbf194ed2fadf882a55e","7adc6737affbba35c1fcdff8eabeb4c707a83d0e987be2f0b909752df469213e","1148b62f39eaeeb805bdb3a0169257caef34913e949c17bbb13113d7f3c80d5e","e9e96f1daaee0cf5de537f3de521a2c2f4601a9c4bff4af3081e32c9069f4025","2d3372f6e27ae8700d827b9cf53d419ea419e256511427b10b0adaf59043ed19","ab7a835aa5cfc85a701b2f4aa2dfcc0441486fb0011e0055476118cc6e626905","3f81185c233f1a49a6ae8724ff06fbc452b578d457238efdbc8a3d7c6c33ae5d","1d1b38f38cc62e9d49294336d36b21ba910d7acbef8aa8aa99b5da8f862fb8f7","085119c2c73f84cdb8a53a28d88cdf73156fa9c50d7fe321fda51c4a12269d34","d66919cb6040671ecb60749ac77776a6f22b884cc8e56d6762a281a8c2781c6a","90f88ff8f6dd5c3e0aaf80e9fa268a5c6105418055ea0c317fcfcef6dd4a3637","4a94c2a7013926951b1c7b4cf109c8091325e4bd904359a797df7992d283fed0","43383b95948ac98500db5fe88bcd54daea792525188a532f1c079a62f3c1c8e9","ffe68acf83aa886cb7927aa1d89b7b6ffeb8f6ff685a9fcbdccac74a11348450","d55508b92d7c2700cfea727d6406f99e1561f632af2cab4a3b45977bd6de8be4","bd868e968769b89712c4397f5b1909349611e142c880a23d495a8449dbfa766f","e7def30bdc06f5ae142804ea2c6c354d0f9b43938e59faa39e9e952f9dcf3d93","58a28a1fa1f7547dbd08103a9f311180ee5d8f60ca1709d3aa870714add140f1","3195c99317b11dd68cb1f64b1e5b55c7f0da48594e487d5e5ee8438a77f6c6cb","de0152c1aa873035bc63890bcb15359fae691a6d382dd2d5ae4398981dada33e","2393712ce75754a53369a9a93ec9b998c450b3ab1a3e1f6f70e54d1d8248aff5","5ab21569dd55b69860db742914e4338d76d003eddd1da23f044f958864b1d66f","2377af58ac743aafdcb31fa0c9d6d26e8426142e743a9d5a4bd59704ca1cee15","7f2745d5883f44ce7a8610e69c9b8541fcf1c50d9883e84e5e6760a8f9e43a19"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p48"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NR-SA","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Cell selection/reselection in IDLE mode and Emergency call functionality","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"If the UE is implemented with the CR while the NW is not, there is no inter-operability issue, as the UE cannot initiate an emergency call in such a case.","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"If the NW is implemented with the CR while the UE is not, there is no inter-operability issue as the UE behaves as legacy device.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"Implementation of this CR by a Release 17 UE, after R18 ASN.1 is frozen, will not cause compatibility issues.","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"A RedCap UE cannot make emergency calls in a cell where access for RedCap UEs is enabled but RedCap UEs with 1Rx or 2Rx branches are barred.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"4.5, 5.3.1 ","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["ffaa09366560eee12c3831b931fb7827e4d2e4dd89b84e5ffa14cce0ad2c3618","9ab421da6b48b4c98f907baad0f929d1d9e045a9c62b56fe5496a44fc0dac57c","ff45ba87735cf2b06a9d5894949a03208ddeebfa2002274ea7be0e877e8ddcc8","8374ffd6e9f6195c643d0d7c704d162e22faf7fd2f8b187e887c946b422d6eb9","425b109039770b44716e33bb2a4c6f4b0c69bf953d4a3e4b7a375b0e938d9bf9","356d2eb829a39cbb709fc145c36857884c38c9b35156b400e064e352272d2405","fa149fcffd7436a101b40463151895ac1c687a413ad364dfe77dcf154a53a401","d2d64b243ce1f7ea1543873fc9922759fac85b85793ccb3ae2f66d0194e4fe59","570eb5240f1c9a5be7f4185177cca852229046a0df86f15cf54e870735ed9463","6aed5d9fbc5b8ae42ee8f58e542db36da4cad33d0c20790f32bb902a77cac3a2","c9ddca635c11a437e3c751d89c6ba8ab96d05b36cb84b0ec934f28d8a014a888","82dd21bdb9097fe6282580082500e781abd43734090434d6303ec63832b33b2e","7811c050093451af36b8b839b9d21ec6819cb83dd365a78d4f2240cf1a90ef78","487d6f7a72fc0f7818f6f5b859497389dba2fd8bb4deeddcbef824991528a1df","e799ae52175939c9cac282f118ed47d15ddb14644ea5bae6284d0e4c75fcc2fa","e364a8e8adfb4621b23f0ce594a7739ab282db01b2b892a558b7fd00c6326369","d44fb6de4cb5a126f32268edd1f399dd07476b73a1afe9c304c7598d8f74dec0","a3ac6bbe7fa13e90e69c4f2a46fabc3318ce8dda9871e195caccf36fe1814e63","3a39c6c0815d164add2150297f45cf5d029efa4c3000781c4c3f411df3cf8e25","9f88a54d5e071c