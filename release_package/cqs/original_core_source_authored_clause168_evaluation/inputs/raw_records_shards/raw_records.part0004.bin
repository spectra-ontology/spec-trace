975},{"literal_text_all_w_t_and_m_t":"HandoverPreparationInformation field descriptions","paragraph_zero_based":51976},{"literal_text_all_w_t_and_m_t":"as-Context","paragraph_zero_based":51977},{"literal_text_all_w_t_and_m_t":"Local RAN context required by the target gNB or DU.","paragraph_zero_based":51978},{"literal_text_all_w_t_and_m_t":"rrm-Config","paragraph_zero_based":51979},{"literal_text_all_w_t_and_m_t":"Local RAN context used mainly for RRM purposes.","paragraph_zero_based":51980},{"literal_text_all_w_t_and_m_t":"sourceConfig","paragraph_zero_based":51981},{"literal_text_all_w_t_and_m_t":"The radio resource configuration as used in the source cell.","paragraph_zero_based":51982},{"literal_text_all_w_t_and_m_t":"ue-CapabilityRAT-List","paragraph_zero_based":51983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1b67442af3f3e5407957b26ffdf5f887e20fae5583ffc7c575b4d02bfcdbaf2d","1abbaf50f61dd66a86cf7f2bc6156987fd49baed0b3af8f620bd72da57d7aa35","5d3067641c53c37eae972016c120973ad6283b5f98c0f1ec2b74b5c28b41d17e","48254170f544ad2bb1c76af9df0a9b4a2d31b467c14aae789e6cb40f3cb6b2b7","f5c050dfdafa43c33bbae25d6ae4cce4bb4f9f98304d82e3ca5f354390d903d1","2a7c11b3e617e2c42fc6cbccca69647c502b9068643b8e7fd1e59c84a73c8c09","d554ea04917c1af51b50d74afeb3b138dae8e7e54a176aa133c40b63cc465658","1a26808cdc6b42ef041f44ad1726cf3a261363283543db435c746736ae86903e","ef61758a47ed4a0c0fc287a3832ad75a038512dba77ed1c3334be7b1b5cac29f","8d48f4a39a729673f0b03632d67859bbb2b43b1ea930b59d5f447e694e4eb7f0","e21a613ee4062a171af1d34d16811833ed14bf548bd757bfe9aa35313fa245cf","9b497a7d8c251b9c4e17e74f97796220470eb6cd1afcea4c7de48e945ad8d694","2ae9c085674d8f653019bbcd2dcb98b8ce6c545f8e2ce5069d53f5e7e