845dd28ea531a26f5ff7972712e3f9ad","8ea0b3727f49c4b18f4f830ac943a914bd81e79f6210d66974f67912791d9d5c","a6b9f68d335685a178e4d3535568ddd5dcc542f6a9990aa129bc27ae0811cd7c","c048fe6c61a25fe2c81cffb83e4952eeb6791699e3bfd6c0b4b7fff51c5dd31d","46792c813c3cd577dbeb43e45af32e0e7f8b84b5a671c6cab990fa8879252de3","f996d894a7abd1e234879c363cec25440777143b9f5af4ca2c07e05b42a02908","0a50055054a77f0cbe0c6e86fea7cf246e2deb3c3818297aa79394a1e336806b","30b8ff0ae54e5484194ed63e5767d0384f93f8742a2e360848cd416fef4dd75c","c7fdcd6146c1c37487af2f1bd2725fec13f102140b19b2adb9d154142d25371b","ec40931a6f71a9c757996d975cbb1cba37bbbcfe77d1579d706500ba3f76676f","ac09f7c6ef5908884e981e32a205bb00b97721a83e3422e082d0901166eea9e1","82ea406e9b572d7376ffd8a887eab4559e69a96a4fbc09965ff10faf00edb971","49302b5a0323e0a834b3ea47f19278700ff495a45c6b02be2ad360fe3b83db2a","12aec139a9b58f94ca27953f8ad45db8f6b5920e2efaf52fc55a23e19a9a6e68","1292fc18809428ba252f3747d98a704aa3da8cc6e4e6940475bbe7e1e287e2ce","d3f51597b6a1b7f883e5fd154918a5b8f565f9c1c65e9f4e8c4c706b6d76a8a1","195794e51658cb2d0eac36bd23283e4ec44a43f1cb28537a82d0f6e1d4d29a28","75c51d67a558aae2680972a55ec7782fddb8d0e944cbb007bacffc476587426f","cd910fdba155493f076dac40b3a3ea663afde96f19480c7b507454663b07f4b8","902ebd2153013ea58d00b1162da7fcacb67a2938acd3907d35a5d5b60dd76456","55e62fcce3bcf7ce02d98c76a106ee55cd9da98577675c80e70cb85747a8edd0","01649c292cd00e81ad56d20da96db1bb7cfb55217130c5082677670b2c87f1ac"],"paragraph_range_zero_based":[33120,33143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33120"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33144},{"literal_text_all_w_t_and_m_t":"TDRA-FieldIndexDCI-0-3-r18 ::=         SEQUENCE (SIZE (2.. maxNrofBWPsInSetOfCells-r18)) OF INTEGER (0..maxNrofUL-Allocations-1-r18)","paragraph_zero_based":33145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33146},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-STOP","paragraph_zero_based":33147},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33149},{"literal_text_all_w_t_and_m_t":"ChannelAccessConfig field descriptions","paragraph_zero_based":33150},{"literal_text_all_w_t_and_m_t":"absenceOfAnyOtherTechnology","paragraph_zero_based":33151},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates absence on a long term basis (e.g. by level of regulation) of any other technology sharing the carrier; absence of this field indicates the potential presence of any other technology sharing the carrier, as specified in TS 37.213 [48] clauses 4.2.1 and 4.2.3.","paragraph_zero_based":33152},{"literal_text_all_w_t_and_m_t":"energyDetectionConfig","paragraph_zero_based":33153},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the maxEnergyDetectionThreshold or the energyDetectionThresholdOffset (see TS 37.213 [48], clause 4.2.3).","paragraph_zero_based":33154},{"literal_text_all_w_t_and_m_t":"energyDetectionThresholdOffset","paragraph_zero_based":33155},{"literal_text_all_w_t_and_m_t":"Indicates the offset to the default maximum energy detection threshold value. Unit in dB. Value -13 corresponds to -13dB, value -12 corresponds to -12dB, and so on (i.e. in steps of 1dB) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":33156},{"literal_text_all_w_t_and_m_t":"maxEnergyDetectionThreshold","paragraph_zero_based":33157},{"literal_text_all_w_t_and_m_t":"Indicates the absolute maximum energy detection threshold value. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm) as specified in TS 37.213 [48], clause 4.2.3.","paragraph_zero_based":33158},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset2","paragraph_zero_based":33159},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset2 to be applied for all uplink transmissions on this serving cell associated to tag2. If absent, n-TimingAdvanceOffset is applied for all uplink transmissions on this serving cell associated to tag2.","paragraph_zero_based":33160},{"literal_text_all_w_t_and_m_t":"ul-toDL-COT-SharingED-Threshold","paragraph_zero_based":33161},{"literal_text_all_w_t_and_m_t":"Maximum energy detection threshold that the UE should use to share channel occupancy with gNB for DL transmission as specified in TS 37.213 [48], clause 4.1.3 for downlink channel access and clause 4.2.3 for uplink channel access. This field is not applicable in semi-static channel access mode.","paragraph_zero_based":33162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33163},{"literal_text_all_w_t_and_m_t":"ServingCellConfig field descriptions","paragraph_zero_based":33164},{"literal_text_all_w_t_and_m_t":"additionalPCI-ToAddModList","paragraph_zero_based":33165},{"literal_text_all_w_t_and_m_t":"List of information for the additional SSB with different PCI than the serving cell PCI. The additional SSBs with different PCIs are not used for serving cell quality derivation.","paragraph_zero_based":33166},{"literal_text_all_w_t_and_m_t":"bwp-InactivityTimer","paragraph_zero_based":33167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["706ce286fa41c6de869089031c35ceec471e52efec839157aafa8334f550cdfe","324760eafe88e7f3e15f31c9a255c0714c30af9819d84a1f166b55075006e7d3","205e1b99fcca32201651a42a5a4d8f2c69846e0ffb4d8471ee1a7148ac660e7d","117cdd9945ba318ba436202c20decedfbab84e3425d4b36fc876c14d7974e0ff","4d26eb8e401600d50f93d992640b626f892d0a0bc4543041a2b761a5ec58848a","37961952f68e136b82d125d06f8aef50809f0309843285ec4e6e3a5312156a79","d671478539d578136506fdef1723fa4d2ecebbb9846a18533389715bdf1ca04e","098410199b7ae02d71496046d96a4740a47e79997cd0840fad762d52ea56c40f","424861e678a9d9d00e3afe3686072f47fe1ebfcd43aca263c94c8312e3180710","2d795891b40d2bc58a0bc8ef49aeb0a3d6dd3f7bd7593507ad6571c837afc88d","479fa3c5b347366ecabc7088fa8454f66935f781a9a547278894b3f8c025e7a1","a4f0befb71c927b70e33d96dbaf2f66fda9c7e4dcab6d89832e1dc13071b7f3f","602a38db35224b42962559f61723cd616fb64b80c15540bfcd8bbb633ac90fdf","ed3bd8774e5f8349caa5c0ed54fb1e651841920e5f6e031b649f46e9d1aa3aad","6f7814f943fd8ac42400aad853eb29f0909513783e845970bcbcbed5781176a5","87a90b2c93eaa611fdccb5a4fb1000efa92989f4a26a29893b6c4bc80a38c108","9ec2bc79dc2548e5b3cbc89558bbde0aa6579bb23db7b6ffb9f0d7da71d27ce1","4da823e71ccd9266e62d3af35c177619d770bcef69b4068ee916e02bb8884aac","62887a6353f1f71f94cd2a04f66c10b97299116ae901aa2f1862ecdf8b30611c","65deb58371c6ae55eb94f22fe4788f966d3510026f6a7ecf18017ed64eeec442","e9b9db9e9c7ae4d56b9299566270034f9e0df98713a05762bf7d23289e1323d0","c90702f0d87e177ea432889f94798272316e8246494364a813af9f2e2b1c884f","e44122a3459b3643591f4559e27eb4ac141bc1e18ed17c1cd528dde506aa7788","e95bdd0649f7fec81f486312f023efb0caa139c7719d86844bc287baf7653c06"],"paragraph_range_zero_based":[33144,33167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33144"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The duration in ms after which the UE falls back to the default Bandwidth Part (see TS 38.321 [3], clause 5.15). When the network releases the timer configuration, the UE stops the timer without switching to the default BWP.","paragraph_zero_based":33168},{"literal_text_all_w_t_and_m_t":"ca-SlotOffset","paragraph_zero_based":33169},{"literal_text_all_w_t_and_m_t":"Slot offset between the primary cell (PCell/PSCell) and the SCell in unaligned frame boundary with slot alignment and partial SFN alignment inter-band CA. Based on this field, the UE determines the time offset of the SCell as specified in clause 4.5 of TS 38.211 [16]. The granularity of this field is determined by the reference SCS for the slot offset (i.e. the maximum of PCell/PSCell lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB and this serving cell's lowest SCS among all the configured SCSs in DL/UL SCS-SpecificCarrierList in ServingCellConfigCommon or ServingCellConfigCommonSIB).","paragraph_zero_based":33170},{"literal_text_all_w_t_and_m_t":"The Network configures at most single non-zero offset duration in ms (independent on SCS) among CCs in the unaligned CA configuration. If the field is absent, the UE applies the value of 0. The slot offset value can only be changed with SCell release and add.","paragraph_zero_based":33171},{"literal_text_all_w_t_and_m_t":"cbg-TxDiffTBsProcessingType1, cbg-TxDiffTBsProcessingType2","paragraph_zero_based":33172},{"literal_text_all_w_t_and_m_t":"Indicates whether processing types 1 and 2 based CBG based operation is enabled according to Rel-16 UE capabilities.","paragraph_zero_based":33173},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-Config","paragraph_zero_based":33174},{"literal_text_all_w_t_and_m_t":"Used to configure cell DTX/DRX for the serving cell, as specified in TS 38.321 [3]. A maximum of two cell DTX/DRX patterns can be configured per MAC entity for different serving cells. The two configured patterns are aligned, that the start and slot offset are common and the periodicity of one pattern is an integer multiple of the other.","paragraph_zero_based":33175},{"literal_text_all_w_t_and_m_t":"cjt-Scheme-PDSCH","paragraph_zero_based":33176},{"literal_text_all_w_t_and_m_t":"This field is used to configure CJT Tx scheme cjtSchemeA or cjtSchemeB for PDSCH reception, see Reference XXX.","paragraph_zero_based":33177},{"literal_text_all_w_t_and_m_t":"channelAccessConfig","paragraph_zero_based":33178},{"literal_text_all_w_t_and_m_t":"List of parameters used for access procedures of operation with shared spectrum channel access (see TS 37.213 [48).","paragraph_zero_based":33179},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":33180},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE does not apply these channel access procedures. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":33181},{"literal_text_all_w_t_and_m_t":"Overwrites the corresponding field in ServingCellConfigCommon or ServingCellConfigCommonSIB for this serving cell.","paragraph_zero_based":33182},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfig","paragraph_zero_based":33183},{"literal_text_all_w_t_and_m_t":"Indicates whether this serving cell is cross-carrier scheduled by another serving cell or whether it cross-carrier schedules another serving cell. If the field other is configured for an SpCell (i.e., the SpCell is cross-carrier scheduled by another serving cell), the SpCell can be additionally scheduled by the PDCCH on the SpCell.","paragraph_zero_based":33184},{"literal_text_all_w_t_and_m_t":"crossCarrierSchedulingConfigRelease","paragraph_zero_based":33185},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the cross carrier scheduling configuration configured by crossCarrierSchedulingConfig. The network may only include either crossCarrierSchedulingConfigRelease or crossCarrierSchedulingConfig at a time.","paragraph_zero_based":33186},{"literal_text_all_w_t_and_m_t":"crs-RateMatch-PerCORESETPoolIndex","paragraph_zero_based":33187},{"literal_text_all_w_t_and_m_t":"Indicates how UE performs rate matching when both lte-CRS-PatternList1-r16 and lte-CRS-PatternList2-r16 are configured or when both lte-CRS-PatternList3-r18 and lte-CRS-PatternList4-r18 are configured as specified in TS 38.214 [19], clause 5.1.4.2.","paragraph_zero_based":33188},{"literal_text_all_w_t_and_m_t":"csi-RS-ValidationWithDCI","paragraph_zero_based":33189},{"literal_text_all_w_t_and_m_t":"Indicates how the UE performs periodic and semi-persistent CSI-RS reception in a slot. The presence of this field indicates that the UE uses DCI detection to validate whether to receive CSI-RS (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":33190},{"literal_text_all_w_t_and_m_t":"defaultDownlinkBWP-Id","paragraph_zero_based":33191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["af7f22ac22b110cbd6234d9fa98e09178be5339e0f79fe074eed32fd1ad609f9","17d655bf12636f7ddd2da96d3938588c8d2fdb9bd8a0e662387f1d329043c8de","5dcc3e4123566555904c8f17ddc47039d5ac7226c4f705e60112adfe8f718bb4","e7f87b4cf03af5d80c578cfc0963df333435b17918eab5db8c1b0f5ee44e4a11","6c2ccfcd6af7e26f87c1624f131963897498dfed13a00b171ec75bdcd40ed35a","86211082e025bb49863013fd5bbbd6c2733ced8c8836316a0c0576985512915d","30a45feb32d28e8b48ce65e9d7c49badbc726220545d0781639ce366d8bcfeb7","4e4bf682d31a7907c7100cb42de50cc9d8a3cc88ca83c6faab4e9597cbdd8a2f","3682b401d4ae98911ba05b7134a5a288d774ccbb0e1c7cc0e073b507da645d0f","2dd1565f9eadaddb91df6988b59660b646957640d510c5d7186639407f8c5adc","10401e45b947d378a7556908e189879d44ae0d14ec172e226a881548a12a620e","e2335bb1fdd82c6aaac4d928ab5c6169528df6f5abf776641e59a16b65a6fbeb","de0561d3d5d0d67dd380ec1e653471fdb43915fdb0362e450e2aca2203add45f","5a26cbdcdfde68961f41c4e233f2bd623f607a62fa0ca90e4a414a293c0ba375","bfc029ecbd719a972a0c7ba7bc0fbfce5b658beb0390069e69be146ad6c48277","474ded33cc831da794f5de68f9609ee47d370fc3227949a1e674f65f8a1f9b1d","b8674f99bff5f30494a59b4b09c898525e7f14f582d1a9a4c1e15d602b1eed9c","bdc63f627305353333cbc1e4f37cf29cecbe2c4992244b44c4c1fd75ec18bebc","90028a93d1c410c12ca0ad6472864d71120f569208b8a29762e8032bb1aae02d","3b64a15f251edd52c56baa94c450fde4506f6d2396536a2d8b30c61c76e617f1","382219af5b4d43c4e6b51bee33bb154ecddebfacef6aab55015ef007e87a7c28","0dadfde6935ea2d607223d837d59390b6e65e94aed5e5e21ac4ed92a132eb8c5","9dcd5ae1781f456626c97c38fa0109918f0a4bb2b7f82d7baa6ded65a896a21e","a559823f65cf10e7c237d5d4b4d793d667fbe8c182b8ffbfdf05455d2595c051"],"paragraph_range_zero_based":[33168,33191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33168"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The initial bandwidth part is referred to by BWP-Id = 0. ID of the downlink bandwidth part to be used upon expiry of the BWP inactivity timer. This field is UE specific. When the field is absent the UE uses the initial BWP as default BWP. (see TS 38.213 [13], clause 12 and TS 38.321 [3], clause 5.15).","paragraph_zero_based":33192},{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling","paragraph_zero_based":33193},{"literal_text_all_w_t_and_m_t":"Indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD CA with same SCS as specified in TS 38.213 [13], clause 11.1. The half-duplex operation only applies within the same frequency range and cell group.The network only configures this field for TDD serving cells that are using the same SCS.","paragraph_zero_based":33194},{"literal_text_all_w_t_and_m_t":"directionalCollisionHandling-DC","paragraph_zero_based":33195},{"literal_text_all_w_t_and_m_t":"For the IAB-MT, it indicates that this serving cell is using directional collision handling between a reference and other cell(s) for half-duplex operation in TDD NR-DC with same SCS within same cell group or cross different cell groups.","paragraph_zero_based":33196},{"literal_text_all_w_t_and_m_t":"dormantBWP-Config","paragraph_zero_based":33197},{"literal_text_all_w_t_and_m_t":"The dormant BWP configuration for an SCell. This field can be configured only for a (non-PUCCH) SCell.","paragraph_zero_based":33198},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToAddModList","paragraph_zero_based":33199},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be added or modified. (see TS 38.213 [13], clause 12).","paragraph_zero_based":33200},{"literal_text_all_w_t_and_m_t":"downlinkBWP-ToReleaseList","paragraph_zero_based":33201},{"literal_text_all_w_t_and_m_t":"List of additional downlink bandwidth parts to be released. (see TS 38.213 [13], clause 12).","paragraph_zero_based":33202},{"literal_text_all_w_t_and_m_t":"downlinkChannelBW-PerSCS-List","paragraph_zero_based":33203},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in DownlinkConfigCommon / DownlinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75]. If the UE is a RedCap UE and needs to autonomously switch to its initial downlink bandwidth part to perform a random access procedure but its current UE specific channel bandwidth does not cover the initial downlink bandwidth part, the UE autonomously changes its UE specific channel bandwidth to cover the initial downlink bandwidth part. In that case, after completion of the random access procedure, the network ensures that the UE specific channel bandwidth fully covers the UE's active downlink bandwidth part in subsequent bandwidth part switch operations.","paragraph_zero_based":33204},{"literal_text_all_w_t_and_m_t":"dummy1, dummy 2","paragraph_zero_based":33205},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":33206},{"literal_text_all_w_t_and_m_t":"enableBeamSwitchTiming","paragraph_zero_based":33207},{"literal_text_all_w_t_and_m_t":"Indicates the aperiodic CSI-RS triggering with beam switching triggering behaviour as defined in clause 5.2.1.5.1 of TS 38.214 [19].","paragraph_zero_based":33208},{"literal_text_all_w_t_and_m_t":"enableDefaultTCI-StatePerCoresetPoolIndex","paragraph_zero_based":33209},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of default TCI state per CORESETPoolindex when the UE is configured by higher layer parameter PDCCH-Config that contains two different values of CORESETPoolIndex in ControlResourceSet is enabled.","paragraph_zero_based":33210},{"literal_text_all_w_t_and_m_t":"enableTwoDefaultTCI-States","paragraph_zero_based":33211},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall follow the release 16 behavior of two default TCI states for PDSCH when at least one TCI codepoint is mapped to two TCI states is enabled","paragraph_zero_based":33212},{"literal_text_all_w_t_and_m_t":"fdmed-ReceptionMulticast","paragraph_zero_based":33213},{"literal_text_all_w_t_and_m_t":"Indicates the Type-1 HARQ codebook generation as specified in TS 38.213 [13], clause 9.1.2.1.","paragraph_zero_based":33214},{"literal_text_all_w_t_and_m_t":"firstActiveDownlinkBWP-Id","paragraph_zero_based":33215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["71c1baf32217d496dd7b11dabd7a0b4052d536b0811885880af856970b3e7a75","76307c8d9df209a70ee91d08c75c1d4cb210cbcdf29cad607135ab4277fde3a6","c9fc10559ad16002325b0d2ef6b38f98182dea30a76538f93959261ba22aef2c","f531823e0547b636d96de2bf72c25356b63bf2b22ae2ed7f34b959cb30be1751","128edc608247f7d05cb93dd2734071cbe45c1764af9071c249362c47aa240d73","eaede40bc6301089ece1208d77b5b4b184881a10acd2016e9b493559b010166e","da2a744226e9ea4dfe5f19bd8c72cfee509505b371e73c2a0d4f6dc9c7054f1e","0bf2a9136ba8aca1249be7ec49e9a910618e14bccc10a0c48f1f9e5c2c0e8e7a","d876c8747d7537f81c69190498511d50bc430a04ab63bd535792116340ef2a52","dddba74f1bc770c2ab84c700b1862459a6ca3e783b88eb56933db9eb85822ea4","b6272e42e786205863e804a3b88b719fa552ecf7fabc41935c75d30bee0feb37","a79e94b3c26cf1097eb91713e9d49f8c3152d719afaf75c74b7e95e71a9d88ce","3637ac2de86f6a951134c4731abbd4df3af0c143f1f6319e96f2ae9a2ca7c733","6d579f870b1569e3f5035fae7cd25ac17a57acdd24789beddab78b322a056f61","566636672310feab48644acbf6b94740d236fa9fd274e701bf0313e0430fbf75","b64cf428c1afc01c0c52e0bb4fa34101c06bef82a3442457145520d6510e0698","cbd5845210b7a50c868aa44a327ff7ade5a8b4326a4843427c460bf0f5e2f1f3","5575f4076b8dae9c23a01ed3ee04a7f33bbd23c8287e15d673662680ee211754","576bdfb112731e3afb21ecd00fa9aa13eff1be0d8c5349a222adc1c53cf28b50","c41cfa84ef59b7485672e1e8e5760cb14b0b2d3223d0f99455567c0f545b2ee4","1656fa9da089756750ee7bc05d9ce21cc6e78e168a0d543159dc2f21894e9250","d191f5ac251d7e95b3efd5e550dbd042f43bf489435f24bfb55c46a7f2158ed3","c6424c87e09fc10a0e4f8fbfce059d8e71b6889d73bb01e7407c320205f99701","97a9af382b4d5335aeea19d8c9e0f07c0f289a68d38e6fa8c5a71f1418987636"],"paragraph_range_zero_based":[33192,33215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33192"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the DL BWP to be activated or to be used for RLM, BFD and measurements if included in an RRCReconfiguration message contained in an NR or E-UTRA RRC message indicating that the SCG is deactivated, upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch. If the field is absent for the PSCell at SCG deactivation, the UE considers the previously activated DL BWP as the BWP to be used for RLM, BFD and measurements. If the field is absent for the PSCell at SCG activation, the DL BWP to be activated is the DL BWP previously to be used for RLM, BFD and measurements.","paragraph_zero_based":33216},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the downlink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BWP-Id = 0.","paragraph_zero_based":33217},{"literal_text_all_w_t_and_m_t":"Upon reconfiguration with reconfigurationWithSync, the network sets the firstActiveDownlinkBWP-Id and firstActiveUplinkBWP-Id to the same value.","paragraph_zero_based":33218},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":33219},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial downlink bandwidth-part (i.e., DL BWP#0). If any of the optional IEs are configured within this IE, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":33220},{"literal_text_all_w_t_and_m_t":"intraCellGuardBandsDL-List, intraCellGuardBandsUL-List","paragraph_zero_based":33221},{"literal_text_all_w_t_and_m_t":"List of intra-cell guard bands in a serving cell for operation with shared spectrum channel access in FR1. If not configured, the guard bands are defined according to 38.101-1 [15], see TS 38.214 [19], clause 7. For operation in licensed spectrum, this field is absent, and no UE action is required.","paragraph_zero_based":33222},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList1","paragraph_zero_based":33223},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH. The LTE CRS patterns in this list shall be non-overlapping in frequency. The network does not configure this field and lte-CRS-ToMatchAround simultaneously.","paragraph_zero_based":33224},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList2","paragraph_zero_based":33225},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH scheduled with a DCI detected on a CORESET with CORESETPoolIndex configured with 1. This list is configured only if CORESETPoolIndex configured with 1. The first LTE CRS pattern in this list shall be fully overlapping in frequency with the first LTE CRS pattern in lte-CRS-PatternList1, The second LTE CRS pattern in this list shall be fully overlapping in frequency with the second LTE CRS pattern in lte-CRS-PatternList1, and so on. Network configures this field only if the field lte-CRS-ToMatchAround is not configured and there is at least one ControlResourceSet in one DL BWP of this serving cell with coresetPoolIndex set to 1.","paragraph_zero_based":33226},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList3","paragraph_zero_based":33227},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH. The LTE CRS patterns in this list shall be non-overlapping in frequency. The network does not configure this field and lte-CRS-ToMatchAround, or this field and lte-CRS-PatternList1, or this field and lte-CRS-PatternList2 simultaneously.","paragraph_zero_based":33228},{"literal_text_all_w_t_and_m_t":"lte-CRS-PatternList4","paragraph_zero_based":33229},{"literal_text_all_w_t_and_m_t":"A list of LTE CRS patterns around which the UE shall do rate matching for PDSCH. The LTE CRS patterns in this list shall be non-overlapping in frequency. The first LTE CRS pattern in this list shall be fully overlapping in frequency with the first LTE CRS pattern in lte-CRS-PatternList3. The second LTE CRS pattern in this list shall be fully overlapping in frequency with the second LTE CRS pattern in lte-CRS-PatternList3, and so on. Network configures this field only if the field lte-CRS-ToMatchAround is not configured and the field lte-CRS-PatternList3 is configured.","paragraph_zero_based":33230},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":33231},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":33232},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-AssistInfoList","paragraph_zero_based":33233},{"literal_text_all_w_t_and_m_t":"A list of LTE neighbour cells configuration information which is used to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]). If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the LTE-NeighCellsCRS-AssistInfo entries is considered to be newly created and the conditions and Need codes for setup of the entry apply.","paragraph_zero_based":33234},{"literal_text_all_w_t_and_m_t":"lte-NeighCellsCRS-Assumptions","paragraph_zero_based":33235},{"literal_text_all_w_t_and_m_t":"If the field is not configured, the following default network configuration assumptions are valid for all LTE neighbour cells for the purpose of CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR (see TS 38.101-4 [59]).","paragraph_zero_based":33236},{"literal_text_all_w_t_and_m_t":"-The CRS port number is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":33237},{"literal_text_all_w_t_and_m_t":"-The CRS port number is 4 if RateMatchPatternLTE-CRS is not configured for the serving cell.","paragraph_zero_based":33238},{"literal_text_all_w_t_and_m_t":"-The channel bandwidth and centre frequency are the same as the ones indicated in RateMatchPatternLTE-CRS if configured for the serving cell.","paragraph_zero_based":33239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["aade91fda709033a0476a2f13600d1be2165c7c3d02f9c835f227db3ec16bfa4","a6967f11d1d3b07125f3d2d47caae69d4736cb87ab2bc9e41e6cff6bf4438309","d8101049691af188a646d00f3fc87f7669ee9400fdd236b7bed5a065109cb2de","53567677f50767d9ca5dc23312641d105ecaec42cea433af65db14cf59dd70c5","53db1f7db554ee3f061fec82bdaf69c62fb020d74a4d2ef483abbfab6c53c797","d5c7200bd243d08da144a1ca41172f04851a12c58871ed677aa97dff80f1bbeb","3eb4f939615de8dcbceec0b8b9962b9260fde42840b37364ccff58fd8c71c3cb","9cc04ddc127c66bf08e1796c4d04163f7c55c2bcd540c4412d2a4db05dd7d3cc","597b4216fcc7277d838acd4bde1d973643ba29a58234ee21d71680becbd88956","14ae86bbb9c55c45ac957683ee83a6662e3ce62455d0ec762cc8fb527fa7ca6b","1f20114317e1b1e3bbf18864f56bb0327aa8ee52f59f832348c214257e0ad00d","de4c5c8a29ab92cc8bcbf27d4f556089941b297b69d290266ae4e968864d8940","eb8496f350e6015e867397eac6eb01fca933c338e943373805c122aa09a700ba","e849b04f96d2b90b5b485b4256a281fbd5a8d00b1681fe1ebc80f145adcbafd5","cf51f34c7354cba958a7b31a15035626f66748b0f5e4e33641d46592361cd1e8","8bc6faeb85bf5428c473648eb592fa378db4928a609e7c549d13f7f2c3192c94","ca6c8dc930356dee50f078bd9357f43cb33375801aaf8b8e93e2eb83261f21f4","f613c1e42038ac2a47fd03afd3732e22b003fb3517bd4ecd8ba17506409eac3a","10cb12164b30299d03c515ef3fb39c449b819733a445f7a6620b811e519dff34","a0ee6d5fa82fba4db7b60fa109e20d89e1a3b19aa5338f3aa73aa7049e28fa5a","2a6b0a80fbd1ddf01b3308f21f358816c8cbb1b51d149828f98a683438da7009","a8d12a7aeaf8809e98dc836876a3cdc629b9c41f707736ee0c029debbf2796c3","dd0422083e7ff0eb8f2f97f74bb09910a6ae00d1af9b587d8bea0251468bc0de","abfb1bb2c2193c415c07d38aed4cd2980e1a268d57cb3c3700bb038f15bf8249"],"paragraph_range_zero_based":[33216,33239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33216"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-The MBSFN configuration is the same as the one indicated in RateMatchPatternLTE-CRS if configured for the serving cell. If RateMatchPatternLTE-CRS is not configured for the serving cell, MBSFN subframe is not configured.","paragraph_zero_based":33240},{"literal_text_all_w_t_and_m_t":"-Network-based CRS interference mitigation (i.e., CRS muting), as in crs-IntfMitigConfig specified in TS 36.331 [10], is not enabled.","paragraph_zero_based":33241},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is configured, the configuration provided in LTE-NeighCellsCRS-AssistInfoList overrides the default network configuration assumptions.","paragraph_zero_based":33242},{"literal_text_all_w_t_and_m_t":"If the field is configured (i.e. false) and LTE-NeighCellsCRS-AssistInfoList is not configured, it is up to the UE implementation whether to apply CRS-IM operation.","paragraph_zero_based":33243},{"literal_text_all_w_t_and_m_t":"mc-DCI-SetOfCellsToAddModList","paragraph_zero_based":33244},{"literal_text_all_w_t_and_m_t":"List of up to N (N<=4) configurations of set(s) of cells for multi-cell PDSCH/PUSCH scheduling from the serving cell, where N is reported as UE capability and up to 4 sets of cells can be configured per PUCCH group. When this field is configured to a SCell, PCell cannot be included in either ScheduledCellListDCI-1-3 or ScheduledCellListDCI-0-3.","paragraph_zero_based":33245},{"literal_text_all_w_t_and_m_t":"multiPDSCH-PerSlotType1-CB","paragraph_zero_based":33246},{"literal_text_all_w_t_and_m_t":"Configures the UE behaviour for Type1 codebook HARQ ACK generation regarding the number of PDSCHs per slot on a serving cell as specified in TS 38.213 [13], clause 9.1.2.1.","paragraph_zero_based":33247},{"literal_text_all_w_t_and_m_t":"When this parameter is configured and set to disabled for a serving cell, the network does not schedule UE with more than one PDSCH in a slot on the serving cell if HARQ-ACKs of any two PDSCHs in the slot on the serving cell are supposed to be reported on one PUCCH resource in the same PUCCH slot. If two coresetPoolIndex values are configured, the number of received PDSCHs is per coresetPoolIndex value per slot for a serving cell. If the UE generates two HARQ-ACK codebooks for two priorities, the number of received PDSCHs is per priority per slot for a serving cell. If fdmed-ReceptionMulticast is configured, the number of received PDSCHs is per traffic type (unicast / multicast) per slot for a serving cell.","paragraph_zero_based":33248},{"literal_text_all_w_t_and_m_t":"nr-dl-PRS-PDC-Info","paragraph_zero_based":33249},{"literal_text_all_w_t_and_m_t":"Configures the DL PRS for propagation delay compensation. When configured, the UE measures the UE Rx-Tx time difference based on the reference signals configured in this field.","paragraph_zero_based":33250},{"literal_text_all_w_t_and_m_t":"nrofHARQ-BundlingGroups","paragraph_zero_based":33251},{"literal_text_all_w_t_and_m_t":"Indicates the number of HARQ bundling groups for type2 HARQ-ACK codebook.","paragraph_zero_based":33252},{"literal_text_all_w_t_and_m_t":"pathlossReferenceLinking","paragraph_zero_based":33253},{"literal_text_all_w_t_and_m_t":"Indicates whether UE shall apply as pathloss reference either the downlink of SpCell (PCell for MCG or PSCell for SCG) or of SCell that corresponds with this uplink (see TS 38.213 [13], clause 7).","paragraph_zero_based":33254},{"literal_text_all_w_t_and_m_t":"pdcch-CandidateReceptionWith-CRS-Overlap","paragraph_zero_based":33255},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates the UE shall monitor PDCCH candidates that overlap with LTE CRS RE(s).","paragraph_zero_based":33256},{"literal_text_all_w_t_and_m_t":"pdsch-ServingCellConfig","paragraph_zero_based":33257},{"literal_text_all_w_t_and_m_t":"PDSCH related parameters that are not BWP-specific.","paragraph_zero_based":33258},{"literal_text_all_w_t_and_m_t":"positionInDCI-cellDTRX","paragraph_zero_based":33259},{"literal_text_all_w_t_and_m_t":"The starting bit position of an information block of DCI format 2_9 for this serving cell (see TS 38.212 [17], clause 7.3.1.3.10).","paragraph_zero_based":33260},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":33261},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology. See TS 38.214 [19], clause 5.1.4.1. If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration shall be the same, including the set of RBs/REs indicated by the patterns for the rate matching around, and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":33262},{"literal_text_all_w_t_and_m_t":"sCellDeactivationTimer","paragraph_zero_based":33263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["578bc4b14b79ecb8eddab88cae3bdf73df4855de5772c3c8113149c3d57dc4c9","82c9765d3a47defec2350549f3f7ff6fc766f740b0d921a0e75c4819ea590de7","bca79173312736fe879f08d0eba1df4564fd79cf8839edce599c138344752cf2","af88180c27eea6e925ae8ab4c3a70d01012226ceed36ee498bfe1ea96d8eaf63","d13911ff54654e446f0f9eaa53fa516f104ccf3c096acf2721995ab51053de8e","8c3324e9daf361dd2254c31f6537c670fbe5cdb3b1da403d1d627519376b3f6c","db3ed61d34181e8c05bfd63061b1d59114895bf3855ee5272cdc0fbd52b062b8","657bc88dcc6c7dd4fc03cee5c17c6d7ccdf362a3ae3f6134ea1573f68e32ca56","f508a63231399ba94b03ab2105181f1c6533863ff0e3a98232f19740088106d9","dc9acd0ee1952f461b8a468fa0bf5086c252a87d69c58feb3d652baba4db92ed","99dad1329822fca015d6b645b7d6dc661909f39a4469179149617ac0fdcfef2b","57bfa72dabf1609f98968dcf62282391780b9983b8d84081b57f6f87c21394a8","98ddb8de989853f9c4c4075f70c21953b76ee2d46f7a79a6c46a561d9a1e96f9","707fc7a4dca8a03a2ba7e0ada6adb6b80456173c26130a2222128384f7e07cb8","29dac11f8bd700468acd3431479e808de044eba084e1387388645f2fa2b4e62b","bc97e44ade956bbfcb3952d38f5830c538722bf1bd067b3889d50bc0dbdf8a19","b19485adbf0814548199f6b8b5ba108479aa81e10ea3ac97978e3060c2910ddc","2ced5a0b89b2ecb59c20f510bb901b7742e9a947db7f6b7560800e1c0fd4da3b","4857c45d7cff3b1c3c2226a7f2c04041942c3761ee96d2eda98427ba7a976320","e59a182b903b471fe3f7189e3d928f70cf73a623cd49e0e864108c9ae2650fd9","e8d368d481b06c1469fcac80b5b63bb8812911fc49548bc4cfedeb6d3e8efe61","add4f3a0592377aa8313f9432c14bf5d9034e9c00745724a14f1a55c9a934074","0ebd5e77531be67400f848bb1083ed99409829becf19340f4ae0e13b44096fd6","80841a0eafe18c7676c97bc02c3b1c986ac50ed02446f911afff382c1d3ab3cc"],"paragraph_range_zero_based":[33240,33263],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33240"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SCell deactivation timer in TS 38.321 [3]. If the field is absent, the UE applies the value infinity.","paragraph_zero_based":33264},{"literal_text_all_w_t_and_m_t":"sfnSchemePDCCH","paragraph_zero_based":33265},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure single frequency network scheme for PDCCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured.","paragraph_zero_based":33266},{"literal_text_all_w_t_and_m_t":"sfnSchemePDSCH","paragraph_zero_based":33267},{"literal_text_all_w_t_and_m_t":"This parameter is used to configure single frequency network scheme for PDSCH: sfnSchemeA or sfnSchemeB as specified (see TS 38.214 [19], clause 5.1). If network includes both sfnSchemePDCCH and sfnSchemePDSCH, same value shall be configured. The network does not configure this parameter and repetitionSchemeConfig in PDSCH-Config simultaneously in the same serving cell.","paragraph_zero_based":33268},{"literal_text_all_w_t_and_m_t":"semiStaticChannelAccessConfigUE","paragraph_zero_based":33269},{"literal_text_all_w_t_and_m_t":"When this field is configured and when channelAccessMode-r16 (see IE ServingCellConfigCommon and IE ServingCellConfigCommonSIB) is configured to semiStatic, the UE operates in semi-static channel access mode and can initiate a channel occupancy periodically (see TS 37.213 [48], Clause 4.3).","paragraph_zero_based":33270},{"literal_text_all_w_t_and_m_t":"The period can be configured independently from period configured in SemiStaticChannelAccessConfig-r16 if the UE indicates the corresponding capability. Otherwise, the periodicity configured by periodUE-r17 is an integer multiple of or an integer factor of the periodicity indicated by period in SemiStaticChannelAccessConfig-r16.","paragraph_zero_based":33271},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":33272},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and frequencyInfoDL in ServingCellConfigCommon/ServingCellConfigCommonSIB of the serving cell: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB and if csi-rs-ResourceConfigMobility is configured, the value of its subcarrierSpacing is present in one entry of the scs-SpecificCarrierList, csi-RS-CellListMobility includes an entry corresponding to the serving cell (with cellId equal to physCellId in ServingCellConfigCommon) and the frequency range indicated by the csi-rs-MeasurementBW of the entry in csi-RS-CellListMobility is included in the frequency range indicated by in the entry of the scs-SpecificCarrierList.","paragraph_zero_based":33273},{"literal_text_all_w_t_and_m_t":"supplementaryUplink","paragraph_zero_based":33274},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when supplementaryUplinkConfig is configured in ServingCellConfigCommon or supplementaryUplink is configured in ServingCellConfigCommonSIB.","paragraph_zero_based":33275},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkRelease","paragraph_zero_based":33276},{"literal_text_all_w_t_and_m_t":"If this field is included, the UE shall release the uplink configuration configured by supplementaryUplink. The network only includes either supplementaryUplinkRelease or supplementaryUplink at a time.","paragraph_zero_based":33277},{"literal_text_all_w_t_and_m_t":"tag-Id, tag2-Id","paragraph_zero_based":33278},{"literal_text_all_w_t_and_m_t":"Timing Advance Group ID, as specified in TS 38.321 [3], which this cell or set of TCI-States of this cell belongs to. The tag2-Id is optionally configured in a serving cell if and only if the serving cell is configured with more than one value for the coresetPoolIndex","paragraph_zero_based":33279},{"literal_text_all_w_t_and_m_t":"tag2-flag","paragraph_zero_based":33280},{"literal_text_all_w_t_and_m_t":"If this field is set to true, the tag2-Id is associated to value 0 and tag-Id is associated to value 1 of field TI bit in RAR , fallbackRAR and in the absolute TAC MAC CE, see TS 38.321 [3]. Otherwise, the tag2-Id is associated to value 1 and tag-Id is associated to value 0 of field R bit in RAR, fallbackRAR and in the absolute TAC MAC CE, see TS 38.321 [3].","paragraph_zero_based":33281},{"literal_text_all_w_t_and_m_t":"tci-ActivatedConfig","paragraph_zero_based":33282},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, or if configured for the PSCell when the SCG is being activated upon the reception of the containing message, the UE shall consider the TCI states provided in this field as the activated TCI states for PDCCH/PDSCH reception on this serving cell.","paragraph_zero_based":33283},{"literal_text_all_w_t_and_m_t":"If configured for the PSCell when the SCG is indicated as deactivated in the containing message:","paragraph_zero_based":33284},{"literal_text_all_w_t_and_m_t":"- the UE shall consider the TCI states provided in this field as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":33285},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the TCI states provided in this field for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":33286},{"literal_text_all_w_t_and_m_t":"When this field is absent for the PSCell and the SCG is being deactivated:","paragraph_zero_based":33287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["333266e43c00bff165fb7a45c3aa765550756b07cd6d99dcf23c8fbc2ccdf490","ad1fcf2fbeca73cb8eb88738e663a6ac3e7d60eb2e23708cc55d8cb0133989a8","ee03d9a837a0af882977d85e4f7c572b2a063dc19f3cbe51fef397a8452f7009","aface5bdf327a9b5ae7d8bf0407954075c87d1504d708023ed359cb8f6785855","67a6cedae483d4a590c9b0ae2b94f8e7714263bff34ede9edafa3aa1288a9fbb","34b7b0fc5fba6529ab65d000693e60043b03c172d7d83d111028101676b55c14","42a69e4d8d5b1c4824860a860e124fcdcce016baee5ae5e7dce50c29c160920a","78e9b1cd5250489af5c2e73403f623cc623fed6697ec69a558a2a4ef8ba1cf20","3c705f57021050ff39a12b6d0ada817b19c3e71bb3f4b65ca7bde6f8f264ed35","3b87b85ab690f145310c65ba8e0a7af0cc3de43133ae31bdb819db9c7c37b3f8","a4ee4f3224f29714957314cb9bdb2a7e58014573a7194480388ab9aea3da4365","3b37ea85f9291694f1c9c2a963fc6222229bd51eeefb7c302fb83596c6f600eb","8bab75af037ae1f26f9081478b386120a9f052deb623bbb7077d4ce1927b2515","41c6d22bc10dbbcc30c1d05e25cd0995a96a938efe90fd96311b74a8c34ce027","d070b412abec8f38ae19eef5984b764dae6971ef4b0e79d8cebedc39bced8b5c","a3ee106de0cd0776816375b19cf4c9133f50627957724681df9ff4ff0168fdfa","0c02a8078fd6b0208c13b01d272d150d6f1124319d3f439ee039ca1fdd0ec6d6","72464c3eab2b51d139413e5facde8300fbb2e7fad0d1787263697e91f75fe213","834cbaf4b22a30c3fd26255e3144f951be2d3ec565f22d4851dc9865f2afb3f5","44c8c37cdcc772b907c5437201dab76693f1d9060919362705351ceef7ad2ab3","13de1b184f950d04087c612104990b3152396b1943766677c1478c7281a3dddd","e3ad67e3aeeb0ac1a673017ee06cf1e76745c90fcf0cbcb8ee03373310f00fc5","a40dfe635be16f92de919d4382ff86768248d818267895242fb47b972d02c4d4","c23c1bed5da0550ef1f7816a7b784bd9c5ea8e5fceb2431e99ddd2c4bc566800"],"paragraph_range_zero_based":[33264,33287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33264"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- the UE shall consider the previously activated TCI states as the TCI states to be activated for PDCCH/PDSCH reception upon a later SCG activation in which tci-ActivatedConfig is absent","paragraph_zero_based":33288},{"literal_text_all_w_t_and_m_t":"- if bfd-and-RLM is configured and no RS is configured in RadioLinkMonitoringConfig for RLM, respectively for BFD, the UE shall use the previously activated TCI states for PDCCH as RS for RLM, respectively for BFD.","paragraph_zero_based":33289},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationDedicated-IAB-MT","paragraph_zero_based":33290},{"literal_text_all_w_t_and_m_t":"Resource configuration per IAB-MT D/U/F overrides all symbols (with a limitation that effectively only flexible symbols can be overwritten in Rel-16) per slot over the number of slots as provided by TDD-UL-DL ConfigurationCommon.","paragraph_zero_based":33291},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateType","paragraph_zero_based":33292},{"literal_text_all_w_t_and_m_t":"Indicates the unified TCI state type the UE is configured for this serving cell. The value separate means this serving cell is configured with dl-OrJointTCI-StateList for DL TCI state and ul-TCI-ToAddModList for UL TCI state. The value joint means this serving cell is configured with dl-OrJointTCI-StateList for joint TCI state for UL and DL operation.","paragraph_zero_based":33293},{"literal_text_all_w_t_and_m_t":"uplinkConfig","paragraph_zero_based":33294},{"literal_text_all_w_t_and_m_t":"Network may configure this field only when uplinkConfigCommon is configured in ServingCellConfigCommon or ServingCellConfigCommonSIB. Addition or release of this field can only be done upon SCell addition or release (respectively).","paragraph_zero_based":33295},{"literal_text_all_w_t_and_m_t":"uplink-PowerControlToAddModList","paragraph_zero_based":33296},{"literal_text_all_w_t_and_m_t":"Configures UL power control parameters for PUSCH, PUCCH and SRS when field unifiedTCI-StateType is configured for this serving cell.","paragraph_zero_based":33297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33298},{"literal_text_all_w_t_and_m_t":"UplinkConfig field descriptions","paragraph_zero_based":33299},{"literal_text_all_w_t_and_m_t":"carrierSwitching","paragraph_zero_based":33300},{"literal_text_all_w_t_and_m_t":"Includes parameters for configuration of carrier based SRS switching (see TS 38.214 [19], clause 6.2.1.3.","paragraph_zero_based":33301},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamPL-ForPUSCH0-0, enableDefaultBeamPL-ForPUCCH, enableDefaultBeamPL-ForSRS","paragraph_zero_based":33302},{"literal_text_all_w_t_and_m_t":"When the parameter is present, UE derives the spatial relation and the corresponding pathloss reference Rs as specified in 38.213, clauses 7.1.1, 7.2.1, 7.3.1 and 9.2.2. The network only configures these parameters for FR2.","paragraph_zero_based":33303},{"literal_text_all_w_t_and_m_t":"enablePL-RS-UpdateForPUSCH-SRS","paragraph_zero_based":33304},{"literal_text_all_w_t_and_m_t":"When this parameter is present, the Rel-16 feature of MAC CE based pathloss RS updates for PUSCH/SRS is enabled. Network only configures this parameter when the UE is configured with sri-PUSCH-PowerControl. If this field is not configured, network configures at most 4 pathloss RS resources for PUSCH/PUCCH/SRS transmissions per BWP, not including pathloss RS resources for SRS transmissions for positioning. (See TS 38.213 [13], clause 7).","paragraph_zero_based":33305},{"literal_text_all_w_t_and_m_t":"firstActiveUplinkBWP-Id","paragraph_zero_based":33306},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field contains the ID of the UL BWP to be activated upon performing the RRC (re-)configuration. If the field is absent, the RRC (re-)configuration does not impose a BWP switch.","paragraph_zero_based":33307},{"literal_text_all_w_t_and_m_t":"If configured for an SCell, this field contains the ID of the uplink bandwidth part to be used upon activation of an SCell. The initial bandwidth part is referred to by BandiwdthPartId = 0.","paragraph_zero_based":33308},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":33309},{"literal_text_all_w_t_and_m_t":"The dedicated (UE-specific) configuration for the initial uplink bandwidth-part (i.e. UL BWP#0). If any of the optional IEs are configured within this IE as part of the IE uplinkConfig, the UE considers the BWP#0 to be an RRC configured BWP (from UE capability viewpoint). Otherwise, the UE does not consider the BWP#0 as an RRC configured BWP (from UE capability viewpoint). Network always configures the UE with a value for this field if no other BWPs are configured. NOTE1","paragraph_zero_based":33310},{"literal_text_all_w_t_and_m_t":"moreThanOneNackOnlyMode","paragraph_zero_based":33311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fec7eb511095ad349c9bb3fbeffb888cf5642b2e01d12fcc26ce69315312e1f1","894a28370750aac5ad4c08dacb053752e258e4d8205255fcfedbe7ed647b987c","d5972cf35c573781bb99f1fb260b305bcab7e8a050887529268a5ff65389409a","f890b10e21c64bb83e54cb379246ee4ce9c7e5b5c60588b5f989938a42595e06","8f64e09537703742ab274874bcc468789deb7e6e27e798b2c79680b35e88fee5","c95f18740b8695760f93e185ac15639a3c7f15fd4f60c8955ec72b1af8221f1d","056a58b087fb77cd9d74c8bf7a1843c7af9718b7e189a8bf9cdc2f06f723e989","5adfd2970a521aa3a74170c23e39d853dd82052dc0201e9641d98f79da04116a","920cc9978f7e684e03634735a8d967079ec9e9cb806f977cf590d6247eb40a08","921e35dd25def2ce927b120749b03acc2e90f756ee1b81f4996992f6d103f395","9e0b294dfeb974395a274dc2cd3e7a628bf4285a25e170118487500e3bf3d9a0","52f29132a2b8dca5fc01ead831596a623c60aaeb11799ce4b130efe2aa8603b4","365c371869155621e9e449cb215d491b2f3b69364afaf81cff0e27a23edf8266","bcaecbd9bbf24149f2a062f103ddae7efdc6d4879791d22f33b3b5299ea13a73","ea60b800e99f2a747fe2f1d64a7d2e461edf71b063e889b62c47c2c36f3a8719","3863bf66cd228358a07bc58b8349bf4c3eb9b35a95a4c4aa854e3a68e9a21f56","860a0b46e53a69260a79417295e34a13f2d7c307f9ff10be6088957cd4e0cb05","6103ccca3378645726b6c8eed76ee5838d7c333af089d184c70632f6a59fd23b","2fbbaa4aadec94e25eaa052853235aaae1bf376aff851a00a0cd5c7e3dc47275","c9685fb4c08ce5f68ae28a4acba52f086aec491d200b7fc952ff2b6c0e876ff0","696d798408f3a94a885a32333aaa206a8e1a0626ddba819babb1b9b0a8dfd637","d1c0735d7fac58a36aeec9e7c2376a431718d33013a0577635bb7dbb7e2697ac","994ef10a1e9665748780a3cfc61a878f6aac147bde60e317c5e90c4362148b10","a3477e5783acca8634b63a5916c4f38b451d7352d0a2fec8f9463259d95b730f"],"paragraph_range_zero_based":[33288,33311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33288"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the mode of NACK-only feedback in the PUCCH transmission, as specified in TS 38.213 [13], clause 18. If multicast CFR is not configured, this field is not included. Otherwise, if the field is absent, UE uses mode 1 for multicast CFR.","paragraph_zero_based":33312},{"literal_text_all_w_t_and_m_t":"mpr-PowerBoost-FR2","paragraph_zero_based":33313},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is allowed to boost uplink transmission power by suspending in-band emission (IBE) requirements as specified in TS 38.101-2 [39]. Network only configures this field for FR2 serving cells.","paragraph_zero_based":33314},{"literal_text_all_w_t_and_m_t":"powerBoostPi2BPSK","paragraph_zero_based":33315},{"literal_text_all_w_t_and_m_t":"If this field is set to true, the UE determines the maximum output power for PUCCH/PUSCH transmissions that use pi/2 BPSK modulation according to TS 38.101-1 [15], clause 6.2.4.","paragraph_zero_based":33316},{"literal_text_all_w_t_and_m_t":"pusch-ServingCellConfig","paragraph_zero_based":33317},{"literal_text_all_w_t_and_m_t":"PUSCH related parameters that are not BWP-specific.","paragraph_zero_based":33318},{"literal_text_all_w_t_and_m_t":"srs-PosTx-Hopping","paragraph_zero_based":33319},{"literal_text_all_w_t_and_m_t":"Contains configuration related to the SRS for Positioning with frequency hopping for RRC_CONNETCED state.","paragraph_zero_based":33320},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToAddModList","paragraph_zero_based":33321},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be added or modified. In case of TDD uplink- and downlink BWP with the same bandwidthPartId are considered as a BWP pair and must have the same center frequency.","paragraph_zero_based":33322},{"literal_text_all_w_t_and_m_t":"uplinkBWP-ToReleaseList","paragraph_zero_based":33323},{"literal_text_all_w_t_and_m_t":"The additional bandwidth parts for uplink to be released.","paragraph_zero_based":33324},{"literal_text_all_w_t_and_m_t":"uplinkChannelBW-PerSCS-List","paragraph_zero_based":33325},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. If absent, UE uses the configuration indicated in scs-SpecificCarrierList in UplinkConfigCommon / UplinkConfigCommonSIB. Network only configures channel bandwidth that corresponds to the channel bandwidth values defined in TS 38.101-1 [15], TS 38.101-2 [39], and TS 38.101-5 [75]. If the UE is a RedCap UE and needs to autonomously switch to its initial uplink bandwidth part to perform a random access procedure but its current UE specific channel bandwidth does not cover the initial uplink bandwidth part, the UE autonomously changes its UE specific channel bandwidth to cover the initial uplink bandwidth part. In that case, after completion of the random access procedure, the network ensures that the UE specific channel bandwidth fully covers the UE's active uplink bandwidth part in subsequent bandwidth part switch operations.","paragraph_zero_based":33326},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingPeriodLocation","paragraph_zero_based":33327},{"literal_text_all_w_t_and_m_t":"Indicates whether the location of UL Tx switching period is configured in this uplink carrier in case of inter-band UL CA, SUL, or (NG)EN-DC, as specified in TS 38.101-1 [15] and TS 38.101-3 [34].","paragraph_zero_based":33328},{"literal_text_all_w_t_and_m_t":"In case of (NG)EN-DC, network always configures this field to TRUE for NR carrier (i.e. with (NG)EN-DC, the UL switching period always occurs on the NR carrier).","paragraph_zero_based":33329},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures this field to TRUE for the uplink carrier(s) on one band and configures this field to FALSE for the uplink carrier(s) on the other band. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":33330},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingCarrier","paragraph_zero_based":33331},{"literal_text_all_w_t_and_m_t":"Indicates that the configured carrier is carrier1 or carrier2 for dynamic uplink Tx switching, as defined in TS 38.101-1 [15] and TS 38.101-3 [34]. In case of (NG)EN-DC, network always configures the NR carrier as carrier 2.","paragraph_zero_based":33332},{"literal_text_all_w_t_and_m_t":"In case of inter-band UL CA or SUL, for dynamic uplink Tx switching between 2 bands with 2 uplink carriers or 3 uplink carriers as defined in TS 38.101-1 [15], network configures the uplink carrier(s) on one band as carrier1 and the uplink carrier(s) on the other band as carrier2. This field is set to the same value for the carriers on the same band.","paragraph_zero_based":33333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33334},{"literal_text_all_w_t_and_m_t":"DormantBWP-Config field descriptions","paragraph_zero_based":33335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e01b713f90fca3b057f99590ed6e71271c4b6f330c9070cec8a16b9f2a7c20af","bc1f4db69d4087791fecb2f301884180aa77af48f52920bb017a508e90261b8a","1af995503c53e62c8ee40f46703e281ed766f6620a6625ebc4f42a849293dbde","fe06817e07b12075e308e1affc2b7bd9bcab3c65346be7c8171e0a069fc8c126","1fc562c5e7818ca0bc015dfeab56a81cbbbfa37b8bf7ecb5605a02b8240849f4","31723d556e7beaeab73098d8e0b1e3129783332e23a2a8af17fa366bc10992c5","1a94908155736df6d009599a67ef35a190fa66bfe8b7158f5584c20b07621d16","1b3a45395be20d8214675711d19972f29ca7eeb9c0221b3653bf3435815ff674","a802de9422e4572d9c6d90eb15819dffbd84d49623f015baab4112f25ca15583","17b4d426fa6f0de72b1812118528f57a299873c703135087e3a7e2b117818405","49ea3ee01a36f13dc921f1d2c26961df509026d2ca4d67af1937f512430ad6d9","a23fba109285b6dc227b3095749969b37379648196d3985979bfd8e58a679483","aaae26db5e2ce68e04835b8d44c5a39ef67ab7392010b68cf2b0b6de64e94efe","73577f269982f5fac726ee974a2408026333874e1c5a0248393c2c8932931971","f71bf43be3e1cd08f568e79db72832c0ee37310b3e02ee66deece24962b6f530","47844dbd655db91ee271e23fc9838b19f0a1b8e3f4635e9edadce403b9823f8c","5e8352a96b0c0be52ad1bb9ade13b897f502ba2e1da74a405aca54fee4550df0","e2cf4c245e79d3655a5ec92b9e24d92a92f477d0d69ed96dcc828c4dae439ea3","d69539b47866a6434128cff1d6c9acb6ce2479fd2644e254f70fee5f4d4350ac","aa2fb6f781ddc47a29a4eaa9f6e2d9de4bd81ae3d0170225507a6f6723ff55ca","e03253a54b6a6d2073f27ae24c4c0b05330e27f7e82ad6611f679ea507723594","dc20301fe8acf5efbdc0ba3d09c55edd6d663ea37cb5e015203ce9c4839e6411","aa7c7af5d56d305e42f3698ad30fb6bb618419cd68c6a77f65a49448ef51007d","ed4606f0088cd09b9a8a07aeeb5301af197e8df23f4beee77e39fe94f79059e2"],"paragraph_range_zero_based":[33312,33335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33312"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dormancyGroupWithinActiveTime","paragraph_zero_based":33336},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy within active time, to which this SCell belongs. The use of the Dormancy within active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":33337},{"literal_text_all_w_t_and_m_t":"dormancyGroupOutsideActiveTime","paragraph_zero_based":33338},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy outside active time, to which this SCell belongs. The use of the Dormancy outside active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":33339},{"literal_text_all_w_t_and_m_t":"dormantBWP-Id","paragraph_zero_based":33340},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be used as dormant BWP. If this field is configured, its value is different from defaultDownlinkBWP-Id, and at least one of the withinActiveTimeConfig and outsideActiveTimeConfig should be configured.","paragraph_zero_based":33341},{"literal_text_all_w_t_and_m_t":"firstOutsideActiveTimeBWP-Id","paragraph_zero_based":33342},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy outside active time.","paragraph_zero_based":33343},{"literal_text_all_w_t_and_m_t":"firstWithinActiveTimeBWP-Id","paragraph_zero_based":33344},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy within active time.","paragraph_zero_based":33345},{"literal_text_all_w_t_and_m_t":"outsideActiveTimeConfig","paragraph_zero_based":33346},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy outside active time, as specified in TS 38.213 [13]. The field can only be configured when the cell group the SCell belongs to is configured with dcp-Config.","paragraph_zero_based":33347},{"literal_text_all_w_t_and_m_t":"withinActiveTimeConfig","paragraph_zero_based":33348},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy within active time, as specified in TS 38.213 [13]. ","paragraph_zero_based":33349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33350},{"literal_text_all_w_t_and_m_t":"GuardBand field descriptions","paragraph_zero_based":33351},{"literal_text_all_w_t_and_m_t":"startCRB","paragraph_zero_based":33352},{"literal_text_all_w_t_and_m_t":"Indicates the starting RB of the guard band.","paragraph_zero_based":33353},{"literal_text_all_w_t_and_m_t":"nrofCRB","paragraph_zero_based":33354},{"literal_text_all_w_t_and_m_t":"Indicates the length of the guard band in RBs. When set to 0, zero-size guard band is used.","paragraph_zero_based":33355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33356},{"literal_text_all_w_t_and_m_t":"MC-DCI-SetOfCells field descriptions","paragraph_zero_based":33357},{"literal_text_all_w_t_and_m_t":"antennaPortsDCI1-3, antennaPortsDCI0-3","paragraph_zero_based":33358},{"literal_text_all_w_t_and_m_t":"Configure the indication type for antenna port(s) field in DCI format 1_3 and DCI format 0_3, respectively (See TS 38.212, clause 7.3.1.2.4).","paragraph_zero_based":33359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["33155155156512addba9e42cdad6d4aa3b9ab09fd385aa9720c5f30b374c920d","bf99dd25f4ecd6de3ae4ddfbadef65b919f1b2dd6d366b0b30e420bc193a8a78","d2327a3302f013f0c044e6ae4b4a0e889b4872566d427dc4b149a67ec8215872","13ed1c5450cf4e17ea8c96568e3b23fb58af2853595ded1197bb66cf85a000d7","a53bba52426902bd4b49c9df9f4cc1f88d4a63580c6e2c6fd851710ef6eab2a5","49e36118afe8a48ac4106ddb7b27e92577be4b244d8b18bf3e1321dd82a1e86c","d3b250e3a9207b6468a5ffe930a4702d2cebddcf6a99471aaa7a3c2815773194","b129578da92ba469308fbc0f96719110806c74540af592a08588abbf32cba388","d92a3260f95acea7d6e901ec701a4cd46d1e1f447f65a0c6c478c5aaae425495","a0b2cf0f2b13823b402000f5711cdd7026f4f77ce08daae25564e181d542c172","6d8ea4f50cd2b906f444e6c162febfd4f0c0c975728d98cf530ba61da22f0a77","322d7d7555be9e177890d8b2fc79acc6654dfce3bca0df6399c7517b9986eb47","66cb4286bdbb90989642bb251d129e935fde27f7903b085419370e6d3d5bd739","4ce34c11d0590384ea209ec62dd4e0347f02fdf9c810dc4ca4cd7dffbd4cf4be","26d5d1f6752486344a81009ba074a983e5466c05e5664524309d3ee1bc98eea6","c61d2d6555637432d8ed05177c43ca6a0b1ba4d0b622e6dace254dc5bab4bd75","13ea993a2efa51107d9a9db4a36126aca97381b77c178291e86932710e78e49a","aa6134a0ab0e708f657f0e9fb4dc6d5d29380c93fea6f36d56d32dd541e927f5","839df962c5306936fda32976b859ad1c9145586f6c3054169b0972a7acf16036","5cb7fbe0aa02d81191f853053e813b38ba4a7da937114ae5c92627a0b254f5ab","e632438f619f7656e261ad2145e9a0c741f271807a10c98512727e1898e47646","ca79961829c72860aacabd3a7aec9af7143b13fbc51c570840dc0b3e1465f647","7c255269c4c05f3b9904505e12d07d34a7951502baed8e3e2ed446c9388118ae","5532ee2f5fdc04acae6a4e977a9af9088d06c45fec27ff161603904edebc471a"],"paragraph_range_zero_based":[33336,33359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33336"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dormancyDCI-1-3, dormancyDCI-0-3","paragraph_zero_based":33360},{"literal_text_all_w_t_and_m_t":"Configure the presence of Scell dormancy indication field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33361},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK0DCI-1-3, minimumSchedulingOffsetK0DCI-0-3","paragraph_zero_based":33362},{"literal_text_all_w_t_and_m_t":"Configure the presence of minimum applicable scheduling offset indicator field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33363},{"literal_text_all_w_t_and_m_t":"nCI-Value","paragraph_zero_based":33364},{"literal_text_all_w_t_and_m_t":"Configure n_CI value used for the set of cells, where unique n_CI value is configured for each set of cells.","paragraph_zero_based":33365},{"literal_text_all_w_t_and_m_t":"pdcchMonAdaptDCI-1-3, pdcchMonAdaptDCI-0-3","paragraph_zero_based":33366},{"literal_text_all_w_t_and_m_t":"Configure the presence of PDCCH monitoring adaptation indication field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33367},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-enhType3DCI-1-3","paragraph_zero_based":33368},{"literal_text_all_w_t_and_m_t":"Enable the enhanced Type 3 HARQ-ACK codebook triggering using DCI format 1_3.","paragraph_zero_based":33369},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-enhType3DCIfieldDCI-1-3","paragraph_zero_based":33370},{"literal_text_all_w_t_and_m_t":"Enables the enhanced Type 3 CB through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in DCI format 1_3 if the more than one enhanced Type HARQ-ACK codebook is configured for the primary PUCCH cell group.","paragraph_zero_based":33371},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackDCI-1-3","paragraph_zero_based":33372},{"literal_text_all_w_t_and_m_t":"When configured, the DCI_format 1_3 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group.","paragraph_zero_based":33373},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-retxDCI-1-3","paragraph_zero_based":33374},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_3 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource.","paragraph_zero_based":33375},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-1-3, priorityIndicatorDCI-0-3","paragraph_zero_based":33376},{"literal_text_all_w_t_and_m_t":"Configure the presence of priority indicator field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33377},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDynDCI-1-3","paragraph_zero_based":33378},{"literal_text_all_w_t_and_m_t":"Configure the UE with PUCCH cell switching based on dynamic indication in DCI format 1_3.","paragraph_zero_based":33379},{"literal_text_all_w_t_and_m_t":"RateMatchDCI-1-3","paragraph_zero_based":33380},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint rate matching indication table for DL scheduling via DCI format 1_3, where bitmap for a cell points to a corresponding rate matching indication applicable for DCI format 1-1 (i.e., MSB and LSB of bitmap refer rateMatchPatternGroup1 and rateMatchPatternGroup2 for a cell, respectively), the order of rate matching indication bitmap in each row refers the order of cells in ScheduledCell-ListDCI-1-3, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP (i.e., first bitmap is for the first cell in ScheduledCell-ListDCI-1-X, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP and so on), the number of entries in a row of rateMatchDCI-1-3 should be the same as the number of cells, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP, included in ScheduledCell-ListDCI-1-3, and entries for co-scheduled cells in a row of rateMatchDCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33381},{"literal_text_all_w_t_and_m_t":"rateMatchListDCI-1-3","paragraph_zero_based":33382},{"literal_text_all_w_t_and_m_t":"Configure joint rate matching indication table for DL scheduling via DCI format 1_3.","paragraph_zero_based":33383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1a07492883923ccc78c7a2197587c264394696137268048edf8b9433998d65ef","c13a0232db7ca255cc5a97c57024db794384b1ab4bacda250945dc2eb4cfc2e4","81616a462508757bc6c5f8b04e5d30f6f4ea019fe177d5a51852a838cbcb4ebe","d2b07775a6391b271f93533443817eef06fd9e3a3fbb5c7978df9079500f1b99","4efc46d81560c30caaf1a5ebc25a9eec36b0d5fa5ace504beaff5344d7fa2a67","674635cfe58fd7c73ada2b61c67ad813f46b2236a89d6a741fa497977a3a7ede","6e23656e6bf97eff6979e1c4e3d341386c30acd58f8e27e6164c244559ac0011","71884e447b3d3b4fbe04b12e90cb2ac9836df30afde5b8cfcbf59fb3d09877de","64b828a02a710fd6909b0b6734be8f7c0091f4062d3f6f511d40d1571ab2a6e2","93bbfd7c8892b3c8fbf9f6ac5bf02ed9bbc049afb2a769a4b83adfd6490edace","d51866288e09e2116730e28b2b488480d0124b687ac19aea163d8e75a47a9c9f","07eacb075759c451bda14b847b61c522f68781ae768322ad084d5a28ea5ba018","92245d330f7d82d98109214bd92d4b85d4fa3b8f93f05aecf5fc1ffdcd526a6f","2933e198fbeade740b474493fed397f6f80688844a0d32c5395b029be003ee49","64d46bd1295f427d57388cd8821be268306aa16c7605bbf64ce50546128d4776","a613b3edee4285c9de417ea45c6f3a453d426d8acd91c33adc90209c2eb4f63d","01eeb058f918fc8a9e8c20ee4f8e3ee0a5258a8754b10f4884d6726b2064455f","d1b180dd454a2213524babd96e0e6a37c7994fea6e9fd9acab49184e28e6afe2","7fc5eb9240cac15089f6898f4d6019574812f9d6ef78c3231bd77c206ca96344","682b5cd1533e9724b4e516af3015a37fdfd2711ce8daa2990c84d4ca93cd648c","7b4ba8683737599ce7fcb914b10748a807bda30d3e1d6536fced76c38b6b995b","3640baf840d66e0022bfe71df376fda832dc4530a3bdb02ae4b85f68d68957fe","d8b6ee7f23b82cb4a86a447a9e13911a58a83d0dba1f329c27d7788be5e4ba82","f107ea1e56ccf92ac1e977166b4aab13a1a85ea00d86f40594e2d9eafaf3374e"],"paragraph_range_zero_based":[33360,33383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33360"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ScheduledCellCombo","paragraph_zero_based":33384},{"literal_text_all_w_t_and_m_t":"Configure each row of the table for combinations of co-scheduled cells for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index with value INTEGER (0...3) of co-scheduled cell refers to ScheduledCell-ListDCI-1-3 for DL and ScheduledCell-ListDCI-0-3 for UL.","paragraph_zero_based":33385},{"literal_text_all_w_t_and_m_t":"scheduledCellComboListDCI-1-3, scheduledCellComboListDCI-0-3","paragraph_zero_based":33386},{"literal_text_all_w_t_and_m_t":"Configure the table for combinations of co-scheduled cells for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33387},{"literal_text_all_w_t_and_m_t":"scheduledCellListDCI-1-3, scheduledCellListDCI-0-3","paragraph_zero_based":33388},{"literal_text_all_w_t_and_m_t":"Configure the list of possible co-scheduled cells in the set for DL scheduling via DCI format 1_3 and DCI format 0_3 respectively, where the serving cells in the list are in ascending order of serving cell indices and are mapped to index {0, 1, 2, 3} in the set. Total number of cells within the same set of cells i.e., in ScheduledCell-ListDCI-1-3 and ScheduledCell-ListDCI-0-3, is up to 4.","paragraph_zero_based":33389},{"literal_text_all_w_t_and_m_t":"When a cell is included in either or both of ScheduledCell-ListDCI-1-3 or ScheduledCell-ListDCI-0-3 for one set of cells MC-DCI-SetofCells, the cell cannot be included in any of ScheduledCell-ListDCI-1-3 or ScheduledCell-ListDCI-0-3 for any other set of cells.","paragraph_zero_based":33390},{"literal_text_all_w_t_and_m_t":"setOfCellsId","paragraph_zero_based":33391},{"literal_text_all_w_t_and_m_t":"Configure index of the set of cells to be indicated in DCI format 0_3/1_3.","paragraph_zero_based":33392},{"literal_text_all_w_t_and_m_t":"sri-DCI0-3","paragraph_zero_based":33393},{"literal_text_all_w_t_and_m_t":"Configure the indication type for SRS resource indicator field in DCI format 0_3 (See TS 38.212, clause 7.3.1.1.4).","paragraph_zero_based":33394},{"literal_text_all_w_t_and_m_t":"SRS-OffsetCombo","paragraph_zero_based":33395},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint SRS offset indicator table for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index for a cell points to a corresponding SRS offset indicator applicable for DCI format 1-1 and 0-1, and the order of SRS offset indicator index in each row refers the order of cells in ScheduledCell-ListDCI-1-3 (i.e., first index is for the first cell in ScheduledCell-ListDCI-1-3, that are configured with more than one entry in availableSlotOffsetList for at least one aperiodic SRS resource set on at least one UL BWP and so on) for DL and ScheduledCell-ListDCI-0-3 for UL, included in ScheduledCell-ListDCI-1-3 for srs-OffsetListDCI-1-3 and ScheduledCell-ListDCI-0-3 for srs-OffsetListDCI-0-3, and entries for co-scheduled cells in a row of SRS-OffsetCombo are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3/0_3.","paragraph_zero_based":33396},{"literal_text_all_w_t_and_m_t":"srs-OffsetListDCI-1-3, srs-OffsetListDCI-0-3","paragraph_zero_based":33397},{"literal_text_all_w_t_and_m_t":"Configure joint SRS offset indicator table for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33398},{"literal_text_all_w_t_and_m_t":"SRS-RequestCombo","paragraph_zero_based":33399},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint SRS request table for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index for a cell points to a corresponding SRS request applicable for DCI format 1-1 and 0-1, and the order of SRS request index in each row refers the order of cells in ScheduledCell-ListDCI-1-3 (i.e., first index is for the first cell in ScheduledCell-ListDCI-1-3 and so on) for DL and ScheduledCell-ListDCI-0-3 for UL. The number of entries in a row of SRS-RequestCombo should be the same as the number of cells included in ScheduledCell-ListDCI-1-3 for srs-RequestListDCI-1-3 and ScheduledCell-ListDCI-0-3 for srs-RequestListDCI-0-3, and entries for co-scheduled cells in a row of SRS-RequestCombo are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3/0_3.","paragraph_zero_based":33400},{"literal_text_all_w_t_and_m_t":"srs-RequestListDCI-1-3, srs-RequestListDCI-0-3","paragraph_zero_based":33401},{"literal_text_all_w_t_and_m_t":"Configure joint SRS request table for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33402},{"literal_text_all_w_t_and_m_t":"TCI-DCI-1-3","paragraph_zero_based":33403},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TCI table for DL scheduling via DCI format 1_3, where index for a cell points to a corresponding TCI applicable for DCI format 1-1, and the order of TCI index in each row refers the order of cells in ScheduledCell-ListDCI-1-3 (i.e., first index is for the first cell in ScheduledCell-ListDCI-1-3 that configured with tci-StatesToAddModList and so on), the number of entries in a row of TCI-DCI-1-3 should be the same as the number of cells that configured with tci-StatesToAddModList on at least one DL BWP, included in ScheduledCell-ListDCI-1-3, and entries for co-scheduled cells in a row of TCI-DCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33404},{"literal_text_all_w_t_and_m_t":"tci-ListDCI-1-3","paragraph_zero_based":33405},{"literal_text_all_w_t_and_m_t":"Configure joint TCI table for DL scheduling via DCI format 1_3","paragraph_zero_based":33406},{"literal_text_all_w_t_and_m_t":"TDRA-FieldIndexDC-0-3","paragraph_zero_based":33407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["21e0bd9739f9bc39c23921de397d58a07c190581b4df7217119a68d87219b2e7","d04792ce994bd3364ade67f7648e04b366e7f35bf04374d63b426c3e744125d3","7d42701cd8832ae538f5940b62bb6ba93b348081e7445d6d03270a102f984050","90bf276988f785562aaff683c8f743b2f8dbc3a297a70c13c8ec49f3c5475c70","ebcdda295ba4a7dd9b8612f577b549cc1b7c28e597674451f5e954aca7ed2838","47d4668109449c84b7b1227e0a1581c1ac51a1a0c137d2197efe8b5a330884b1","38294f37e57b437d751e7683e1035968214d550c3ba1e6d8b36e5cccfdaf722e","9fea33a03128242672dcb5278477c0cd54863839d78a9867d0050e783d8e5cdc","28b30449ba16928dfbbb6f5109d2d8b1736ff1ced4f5bf2720046ac8d45f7a90","11a69fa8af979cf05c522839707edc5b49c5253469b163db890784d643959c69","3892ee66e6a69b7714725727bc12f5e2d99aae113b4ccdd63ddf5d98145eb7c1","dbbbf98591f49111c264924175f5b800eb45a7ac0f68720ea656faa81b52e10a","437f880e8089f0c49cb9df25e48c02c6f785c7416e4761a6184d1de2566b40b1","1f1998d52840b314c2f3807d61a84dc6158aa196dd9d6c0f4802a3e89a6251e0","ca90a54f57316a155aeffe7f85f8bdc062f899ddb8dc91eda1494501c257646d","14c9e3f0e8b7391718a90a20ff260840c885a540c15de146e4a4157c79d7aa10","5e6816a660d76ee0da92c13478ed9a6e5556b2b4339b31446bfde2ab0f349062","292ef82f91aaa6526e5158da7b02452d71c1063c2c411951e8c449d853c98651","7882c02cf8c1f29e5debd6898f9c7b46a219c6bbdb3b7090da778a26dd2d4bee","78e90341f65cae74199a0e600315433f7d63734d525744eab39958e230e36c9a","1a3844c4a879a028ed3492e42dae7d59142dd2a5f64fcffbb511177b73825e02","3042b4ee7f516c23252ea5bfb2c75df573748cf92de47b18831388e541d4836f","14cde498fa630a150138f895886cd7dd5f6bb42a23a1c63e43768bee8ac07c83","f140e1440650490ea9eda86127c99529e2b0e8fe60efd8793c93338e849e7f34"],"paragraph_range_zero_based":[33384,33407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33384"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TDRA field table for UL scheduling via DCI format 0_3 containing the applicable TDRA field indexes for multiple BWPs/cells, where the TDRA index for a BWP of a cell points to a corresponding TDRA in the TDRA table applicable for DCI format 0-1, the order of TDRA index in each row refers the BWP-Id for a cell and the order of cells in ScheduledCell-ListDCI-0-3 (i.e., first TDRA index in a row is for the smallest BWP-Id that can be scheduled by the DCI format 0-3, as specified in 38.212, of the first cell in ScheduledCell-ListDCI-0-3, second TDRA index in a row is for the second smallest BWP-Id 1 that can be scheduled by the DCI format 0-3, as specified in 38.212, of the first cell and so on), and the number of TDRA indices in a row of TDRA-FieldIndexDCI-0-3 should be the same as the total number of BWPs that can be scheduled by the DCI format 0-3, as specified in 38.212, across cells included in ScheduledCell-ListDCI-0-3.","paragraph_zero_based":33408},{"literal_text_all_w_t_and_m_t":"TDRA-FieldIndexDCI-1-3","paragraph_zero_based":33409},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TDRA field table for DL scheduling via DCI format 1_3 containing the applicable TDRA field indexes for multiple BWPs/cells, where the TDRA index for a BWP of a cell points to a corresponding TDRA in the TDRA table applicable for DCI format 1-1, the order of TDRA index in each row refers the BWP-Id for a cell and the order of cells in ScheduledCell-ListDCI-1-3  (i.e., first TDRA index in a row is for the smallest BWP-Id that can be scheduled by the DCI format 1-3, as specified in 38.212, of the first cell in ScheduledCell-ListDCI-1-3, second TDRA index in a row is for the second smallest BWP-Id that can be scheduled by the DCI format 1-3, as specified in 38.212, of the first cell and so on ), and the number of TDRA indices in a row of TDRA-FieldIndexDCI-1-3 should be the same as the total number of BWPs that can be scheduled by the DCI format 1-3, as specified in 38.212, across cells included in ScheduledCell-ListDCI-1-3.","paragraph_zero_based":33410},{"literal_text_all_w_t_and_m_t":"tdra-FieldIndexListDCI-1-3, tdra-FieldIndexListDC-0-3","paragraph_zero_based":33411},{"literal_text_all_w_t_and_m_t":"Configure joint TDRA table for UL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33412},{"literal_text_all_w_t_and_m_t":"tpmi-DCI0-3","paragraph_zero_based":33413},{"literal_text_all_w_t_and_m_t":"Configure the indication type for precoding information and number of layers field in DCI format 0_3 (See TS 38.212, clause 7.3.1.1.4).","paragraph_zero_based":33414},{"literal_text_all_w_t_and_m_t":"ZP-CSI-DCI-1-3","paragraph_zero_based":33415},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint ZP-CSI-RS trigger table for DL scheduling via DCI format 1_3, where index for a cell points to a corresponding ZP-CSI-RS trigger applicable for DCI format 1-1, and the order of ZP-CSI-RS trigger index in each row refers the order of cells in ScheduledCell-ListDCI-1-3 (i.e., first index is for the first cell in ScheduledCell-ListDCI-1-3, that are configured with aperiodic-ZP-CSI-RS-ResourceSetsToAddModList on at least one DL BWP and so on), the number of entries in a row of ZP-CSI-DCI-1-3 should be the same as the number of cells, that are configured with aperiodic-ZP-CSI-RS-ResourceSetsToAddModList on at least one DL BWP, included in ScheduledCell-ListDCI-1-3, and entries for co-scheduled cells in a row of ZP-CSI-DCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33416},{"literal_text_all_w_t_and_m_t":"zp-CSI-RSListDCI-1-3","paragraph_zero_based":33417},{"literal_text_all_w_t_and_m_t":"Configure joint ZP-CSI-RS trigger table for DL scheduling via DCI format 1_3.","paragraph_zero_based":33418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33419},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the dedicated part of initial UL/DL BWP configuration is absent, the initial BWP can be used but with some limitations. For example, changing to another BWP requires RRCReconfiguration since DCI format 1_0 doesn't support DCI-based switching.","paragraph_zero_based":33420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33421},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":33422},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":33423},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":33424},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for SCells whose slot offset between the SpCell is not 0. Otherwise it is absent, Need S.","paragraph_zero_based":33425},{"literal_text_all_w_t_and_m_t":"MeasObject","paragraph_zero_based":33426},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for the SpCell if the UE has a measConfig, and it is optionally present, Need M, for SCells. For (e)RedCap UEs, this field is optionally present, Need M.","paragraph_zero_based":33427},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":33428},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for SCells. It is absent otherwise. ","paragraph_zero_based":33429},{"literal_text_all_w_t_and_m_t":"ServingCellWithoutPUCCH","paragraph_zero_based":33430},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, for SCells except PUCCH SCells. It is absent otherwise.","paragraph_zero_based":33431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7e2c9927b6408f5e8e061aaa5ff71fcd2a24e368337a19d75652c4dbc216fdac","e5e8ca49a7acb1a1bef56ea7d18869c4f1400abf8779f0da03cc33439360cc0a","77fd6afdbf65170be3c9e5c6a996d09a3d9e36c084b77dac72c6048d26e22826","88c0d941814c412af6ec2db27d4976649c468279c5d8f1a22be8528e702fb71c","2cfb4fdc338df385db02db50215c975ee77556d22800053780e901cc548a5cff","c122be3a89dc0f1843f77f0ef48f0ce5a31f4c6627416c0998c120bc4a41ac57","e4b8d64ff263510062a647960b4e25defe6c537cf575f8b1455e406e0be6cc31","c67fd64fc31b380ec218a9c533d23e0b39e6c66e43b9d5efd08a1b22a81131ec","dd5f7af4757817829dbcc0ed9e60719fa5c86c345e7e8a54a3684ee145d1a560","5c6a8153c8cd42470715aa9217aeb6de625c5c7ae77c235ce3702c3ba79f0ed1","876b05b2a5410a807beb4494c14a0e7ec72e41a7b4cbda7e10d6fe18cea5c6d5","e8a145127a563fce503ee59818065708a2763e75c000c493f2072f9bac7aa7f0","79e04ec77fd91d4ce6a1c65c1f800dd0ee05014d97e005eaaa1aaa9a028cefc9","a3b21fadba52cc64603545411c4559c038957842d9026612b145a93b0a82ffca","a42e08e397a471c5f6fc6b1f0a095c6efae90e03ba4279f315ff0f0dc122b5b5","709bfc9f52d7806af4db795ab07f1587ec3a4736aaea862020215c917db7a882","644227838a12052c29a1f0f39f42e05b7a620cd32a43e967e595a5c62f61a36d","dad08fc804497c7c725d31b896586bdbe4cb4448f01efadfa43b5bb54be5a1b6","31cf29394287c7295187afd3b8927c4c91ac82686c95c980f6b0a9ae66e1ada3","072c29a1e3d1cba0bfffa38a57d8a7102ca39ba018616f7450e716cc66c0e313","6de5c3955d077b29d1fd3fb23de5a6724d3d8b5dab3a5b850d0759af6f7dee7d","ce0ed345bcf508fa67092c899dc7cf45c307c4b8ddfd420bc7f7de02d580f3d5","765bb707bab7ad4d647efb5b502d40eeac6bbf1712f992fe08c4b6ed667f2a18","ddc515a458baa69ae004f0825a0f581114e69d82e8acaf58305a50a41f70f459"],"paragraph_range_zero_based":[33408,33431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33408"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SyncAndCellAdd","paragraph_zero_based":33432},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for a SpCell upon reconfiguration with reconfigurationWithSync and upon RRCSetup/RRCResume.","paragraph_zero_based":33433},{"literal_text_all_w_t_and_m_t":"The field is optionally present for an SpCell, Need N, upon reconfiguration without reconfigurationWithSync.","paragraph_zero_based":33434},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for an SCell upon addition, and absent for SCell in other cases, Need M.","paragraph_zero_based":33435},{"literal_text_all_w_t_and_m_t":"Tag2","paragraph_zero_based":33436},{"literal_text_all_w_t_and_m_t":"This field is optional present, Need R, if tag2 is present. Otherwise it shall be absent.","paragraph_zero_based":33437},{"literal_text_all_w_t_and_m_t":"TCI_ActivatedConfig","paragraph_zero_based":33438},{"literal_text_all_w_t_and_m_t":"This field is optional Need N for SCells if sCellState is configured, otherwise it is absent.","paragraph_zero_based":33439},{"literal_text_all_w_t_and_m_t":"This field is optional Need S for the PSCell when the SCG is indicated as deactivated or is being activated, otherwise it is absent.","paragraph_zero_based":33440},{"literal_text_all_w_t_and_m_t":"This field is absent for the PCell.","paragraph_zero_based":33441},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":33442},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":33443},{"literal_text_all_w_t_and_m_t":"TDD_IAB","paragraph_zero_based":33444},{"literal_text_all_w_t_and_m_t":"For IAB-MT, this field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":33445},{"literal_text_all_w_t_and_m_t":"TypeDCI0-3","paragraph_zero_based":33446},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ScheduledCellListDCI-0-3 is configured, otherwise it is absent.","paragraph_zero_based":33447},{"literal_text_all_w_t_and_m_t":"TypeDCI1-3","paragraph_zero_based":33448},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ScheduledCellListDCI-1-3 is configured, otherwise it is absent.","paragraph_zero_based":33449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33450},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommon","paragraph_zero_based":33451},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommon is used to configure cell specific parameters of a UE's serving cell. The IE contains parameters which a UE would typically acquire from SSB, MIB or SIBs when accessing the cell from IDLE. With this IE, the network provides this information in dedicated signalling when configuring a UE with a SCells or with an additional cell group (SCG). It also provides it for SpCells (MCG and SCG) upon reconfiguration with sync.","paragraph_zero_based":33452},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon information element","paragraph_zero_based":33453},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33454},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-START","paragraph_zero_based":33455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0617d52f7844be21b783c0ff531f7d3aa4f4c44799c4bd0f3861144843e5329a","fc895b08266eec31e3f30390f6a3ce4dbc2baba2b13a5ff3238412ba007e2f9e","592e65839c72475768fd27312becfafc4d0e765249654d156df960bf09bf4fe9","d322fd39ea121f237c4a41ad9b7e4542790aea74062db123eed94f8746f20bfb","da49f19559ef428561c8db25cd129c33e292b1bde5cda4636a9b2696374de428","5837e05fdaf98333d8d19a83ce76e3bfa942156437f4585db54f990ece4f8951","382a778019a85ac922756bbf1113468c542d0d09fb38ddecab44e3b34becc415","f5ec9d9bfc53a74bb502ed7352f8c29ef9282b86fcb2bc8db6c8da6f02eaf111","89a60bb6986a321a1e14f9d12f702d608fecec316bf1125cde15581b8517aede","7b406486dbda9bcadf95337053b60ca9f609c92464dbb82ee098792e5f83cd6c","a807d186d1e069181efd0186d20ac681cdff326d74cc2dbb107e1a92360e7f9a","d1f85e5b0ff317433855c46c2bac8d947b00d99f8da71bea2d84fdd13e9b7b63","798e07b11c170f88c1f1eaa2401692e9ae0eb418af7124bad4874dc0583d97a2","d5ed43b227131e2ba57922242c7398f0369f607e0317245be50b7cfffb863f13","6e1848b7428a3176a1e1b7362ff5d475172c76974e32e0989d1d82598a7cc9df","0055fc94728e6cff7268932c16205fb1bbd1ff471dbe55d8bccb303e1a703fac","8ac13c6874670a825dd74f301bec9a927797145945f3ad5be4fc4aaa3810a535","70ea57c8387e2956eb174ed1339129bc7bf8ad05fc6998748492addaec160496","84f4cc6ca2a890e4a63c9bbbab64f3a1bd141b44c8bf2a0af02df6ebd3b711dd","2b8ecb20ad219b5338057f5081342760d723b855bee9594d28375a906bf9aee8","82de0728de42f5e161a1a7cab66943aa584ca3e7bd2eb026d1338268f99a6a75","ca59429818626b04d534ffac892c430385c58ece84dfac2611d8eb2b45588c1c","0eda32e3b4068fe2ed657640015e1aa2f4015210cbd9d28c993d3d4fb1283c32","47acf7f4a8f533934388761505f38ef29442024ac02180e68850ae6d810e0b56"],"paragraph_range_zero_based":[33432,33455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33432"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33456},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon ::=         SEQUENCE {","paragraph_zero_based":33457},{"literal_text_all_w_t_and_m_t":"    physCellId                          PhysCellId                                                          OPTIONAL,   -- Cond HOAndServCellAdd,","paragraph_zero_based":33458},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommon                                                OPTIONAL,   -- Cond HOAndServCellAdd","paragraph_zero_based":33459},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommon                                                  OPTIONAL,   -- Need M","paragraph_zero_based":33460},{"literal_text_all_w_t_and_m_t":"    supplementaryUplinkConfig           UplinkConfigCommon                                                  OPTIONAL,   -- Need S","paragraph_zero_based":33461},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                                   OPTIONAL,   -- Need S","paragraph_zero_based":33462},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                CHOICE {","paragraph_zero_based":33463},{"literal_text_all_w_t_and_m_t":"        shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":33464},{"literal_text_all_w_t_and_m_t":"        mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":33465},{"literal_text_all_w_t_and_m_t":"        longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":33466},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond AbsFreqSSB","paragraph_zero_based":33467},{"literal_text_all_w_t_and_m_t":"    ssb-periodicityServingCell          ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }   OPTIONAL, -- Need S","paragraph_zero_based":33468},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":33469},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround               SetupRelease { RateMatchPatternLTE-CRS }                            OPTIONAL, -- Need M","paragraph_zero_based":33470},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList        SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL, -- Need N","paragraph_zero_based":33471},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL, -- Need N","paragraph_zero_based":33472},{"literal_text_all_w_t_and_m_t":"    ssbSubcarrierSpacing                SubcarrierSpacing                                                   OPTIONAL, -- Cond HOAndServCellWithSSB","paragraph_zero_based":33473},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                              OPTIONAL, -- Cond TDD","paragraph_zero_based":33474},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":33475},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":33476},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33477},{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":33478},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":33479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf