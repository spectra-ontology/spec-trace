{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    plmn-Identity                       PLMN-Identity                                   OPTIONAL,","paragraph_zero_based":13704},{"literal_text_all_w_t_and_m_t":"    amf-Identifier                      AMF-Identifier","paragraph_zero_based":13705},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13706},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13707},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSETUPCOMPLETE-STOP","paragraph_zero_based":13708},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13710},{"literal_text_all_w_t_and_m_t":"RRCSetupComplete-IEs field descriptions","paragraph_zero_based":13711},{"literal_text_all_w_t_and_m_t":"guami-Type","paragraph_zero_based":13712},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the GUAMI included is native (derived from native 5G-GUTI) or mapped (from EPS, derived from EPS GUTI) as specified in TS 24.501 [23].","paragraph_zero_based":13713},{"literal_text_all_w_t_and_m_t":"iab-NodeIndication","paragraph_zero_based":13714},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that the connection is being established by an IAB-node as specified in TS 38.300 [2]. If this field is included, the UE shall not include the field mobileIAB-NodeIndication.","paragraph_zero_based":13715},{"literal_text_all_w_t_and_m_t":"idleMeasAvailable","paragraph_zero_based":13716},{"literal_text_all_w_t_and_m_t":"Indication that the UE has idle/inactive measurement report available.","paragraph_zero_based":13717},{"literal_text_all_w_t_and_m_t":"measConfigReportAppLayerAvailable","paragraph_zero_based":13718},{"literal_text_all_w_t_and_m_t":"Indication that the UE has at least one application layer measurement configuration with appLayerIdleInactiveConfig configured.","paragraph_zero_based":13719},{"literal_text_all_w_t_and_m_t":"mobileIAB-NodeIndication","paragraph_zero_based":13720},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that the connection is being established by a mobile IAB-node as specified in TS 38.300 [2]. If this field is included, the UE shall not include the field iab-NodeIndication.","paragraph_zero_based":13721},{"literal_text_all_w_t_and_m_t":"mobilityState","paragraph_zero_based":13722},{"literal_text_all_w_t_and_m_t":"This field indicates the UE mobility state (as defined in TS 38.304 [20], clause 5.2.4.3) just prior to UE going into RRC_CONNECTED state. The UE indicates the value of medium and high when being in Medium-mobility and High-mobility states respectively. Otherwise the UE indicates the value normal.","paragraph_zero_based":13723},{"literal_text_all_w_t_and_m_t":"musim-CapRestrictionInd","paragraph_zero_based":13724},{"literal_text_all_w_t_and_m_t":"This field indicates the UE temporary capability restriction due to MUSIM operation.","paragraph_zero_based":13725},{"literal_text_all_w_t_and_m_t":"ncr-NodeIndication","paragraph_zero_based":13726},{"literal_text_all_w_t_and_m_t":"This field is used to indicate that the connection is being established by an NCR-node as specified in TS 38.300 [2].","paragraph_zero_based":13727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9cfd0820ce792d4ee4de650d10e9f742c2035c790304ea17118fa4734bc553a4","6d3018a49fb806f958c57a3098bd8a0ae7cd21b3a9333001118d6fd1519e24f4","e2172f8a179a1dfb6d0117022a54dc34ca19833368df4fb22d0fb5f2f5862c5e","fceb9e6fcd512f76da8410265f801ace73f0183462bc8