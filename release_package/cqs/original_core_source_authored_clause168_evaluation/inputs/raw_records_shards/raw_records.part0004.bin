-2403537.zip::R2-2403537 RRC.docx:p46104"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-P0-SL-PRS","paragraph_zero_based":46128},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for DL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool.","paragraph_zero_based":46129},{"literal_text_all_w_t_and_m_t":"dl-AlphaSL-PRS","paragraph_zero_based":46130},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for DL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool. ","paragraph_zero_based":46131},{"literal_text_all_w_t_and_m_t":"sl-P0-SL-PRS","paragraph_zero_based":46132},{"literal_text_all_w_t_and_m_t":"Indicates P0 value for SL pathloss based open loop power control for SL PRS transmission in dedicated SL PRS resource pool.","paragraph_zero_based":46133},{"literal_text_all_w_t_and_m_t":"sl-AlphaSL-PRS","paragraph_zero_based":46134},{"literal_text_all_w_t_and_m_t":"Indicates alpha value for downlink pathloss based power control for PSCCH/PSSCH when dl-P0-PSSCH-PSCCH is configured. When the field is absent the UE applies the value 1.","paragraph_zero_based":46135},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46136},{"literal_text_all_w_t_and_m_t":"–SL-PSBCH-Config","paragraph_zero_based":46137},{"literal_text_all_w_t_and_m_t":"The IE SL-PSBCH-Config indicates PSBCH transmission parameters on each sidelink bandwidth part.","paragraph_zero_based":46138},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config information element","paragraph_zero_based":46139},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46140},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSBCH-CONFIG-START","paragraph_zero_based":46141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46142},{"literal_text_all_w_t_and_m_t":"SL-PSBCH-Config-r16 ::= SEQUENCE {","paragraph_zero_based":46143},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r16         INTEGER (-16..15)                                                                   OPTIONAL,    -- Need M","paragraph_zero_based":46144},{"literal_text_all_w_t_and_m_t":"    dl-Alpha-PSBCH-r16      ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}   OPTIONAL,    -- Need M","paragraph_zero_based":46145},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46146},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46147},{"literal_text_all_w_t_and_m_t":"    dl-P0-PSBCH-r17         INTEGER (-202..24)                                                                  OPTIONAL     -- Need M","paragraph_zero_based":46148},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46149},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46150},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["10fbbcde666ce17d009a5e05addfd15cc867eb73be3f2d258c3a8e08c70d8043","9f6cb2e2574ed2fb95c06b3974edde5c15293f9887af8fbddff588cc4caca1e9","f5b8e8172f9375dfce4ab87819af4bf2b6c63a193cfab69c3219a673d56ef986","02d5e13a7108b918bc2003ed156d8144c51a56d2e4840849e094e75d850a5c19","9d343a42e146138fd35ffbf57aff7f493e454a3e517c7d39923c85148b4675bd","0c021146137d6383bf971e601f481d49da0dba45c928604c06b31b9fd86cc9de","bae4b31b40436862bfb15ad4651cc6c763b7593cea72bda3dae4592b4d27ccbe","3899a00c5e773d81a79d6e3f809d559f24b5e4157d275d52fae22054b986e0f9","c86a3cebacb07ed65bb88781b98fff1f5cf27449b097dbbc289da68316c7b752","6784c338fed2f3e9a6b10b6a42b97b3941bf8c856bc6392d1f97d5a0f87b3364","eb1875f766502c4b187e96cb871