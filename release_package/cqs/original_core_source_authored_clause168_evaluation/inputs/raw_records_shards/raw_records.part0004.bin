{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36936},{"literal_text_all_w_t_and_m_t":"–CA-BandwidthClassNR","paragraph_zero_based":36937},{"literal_text_all_w_t_and_m_t":"The IE CA-BandwidthClassNR indicates the NR CA bandwidth class as defined in TS 38.101-1 [15], table 5.3A.5-1 and TS 38.101-2 [39], table 5.3A.4-1.","paragraph_zero_based":36938},{"literal_text_all_w_t_and_m_t":"CA-BandwidthClassNR information element","paragraph_zero_based":36939},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36940},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-BANDWIDTHCLASSNR-START","paragraph_zero_based":36941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36942},{"literal_text_all_w_t_and_m_t":"-- R4 17-6: new CA BW Classes R2-R12","paragraph_zero_based":36943},{"literal_text_all_w_t_and_m_t":"-- R4 17-7: new CA BW Classes V, W","paragraph_zero_based":36944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36945},{"literal_text_all_w_t_and_m_t":"CA-BandwidthClassNR ::=             ENUMERATED {a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, ...,r2-v1730, r3-v1730, r4-v1730, r5-v1730, r6-v1730, r7-v1730, r8-v1730, r9-v1730, r10-v1730, r11-v1730, r12-v1730,v-v1770, w-v1770 }","paragraph_zero_based":36946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36947},{"literal_text_all_w_t_and_m_t":"CA-BandwidthClassNR-r17 ::=         ENUMERATED {r, s, t, u, ...}","paragraph_zero_based":36948},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36949},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-BANDWIDTHCLASSNR-STOP","paragraph_zero_based":36950},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36951},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36952},{"literal_text_all_w_t_and_m_t":"–CA-ParametersEUTRA","paragraph_zero_based":36953},{