{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–End of NR-RRC-Definitions","paragraph_zero_based":48480},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":48481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48482},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":48483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48484},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":48485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48486},{"literal_text_all_w_t_and_m_t":"6.5Short Message","paragraph_zero_based":48487},{"literal_text_all_w_t_and_m_t":"Short Messages can be transmitted on PDCCH using P-RNTI with or without associated Paging message using Short Message field in DCI format 1_0 (see TS 38.212 [17], clause 7.3.1.2.1).","paragraph_zero_based":48488},{"literal_text_all_w_t_and_m_t":"Table 6.5-1 defines Short Messages. Bit 1 is the most significant bit.","paragraph_zero_based":48489},{"literal_text_all_w_t_and_m_t":"Table 6.5-1: Short Messages","paragraph_zero_based":48490},{"literal_text_all_w_t_and_m_t":"Bit","paragraph_zero_based":48491},{"literal_text_all_w_t_and_m_t":"Short Message","paragraph_zero_based":48492},{"literal_text_all_w_t_and_m_t":"1","paragraph_zero_based":48493},{"literal_text_all_w_t_and_m_t":"systemInfoModification","paragraph_zero_based":48494},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of a BCCH modification other than SIB6, SIB7, SIB8 and posSIBs.","paragraph_zero_based":48495},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":48496},{"literal_text_all_w_t_and_m_t":"etwsAndCmasIndication","paragraph_zero_based":48497},{"literal_text_all_w_t_and_m_t":"If set to 1: indication of an ETWS primary notification and/or an ETWS secondary notification and/or a CMAS notification.","paragraph_zero_based":48498},{"literal_text_all_w_t_and_m_t":"3","paragraph_zero_based":48499},{"literal_text_all_w_t_and_m_t":"stopPagingMonitoring","paragraph_zero_based":48500},{"literal_text_all_w_t_and_m_t":"This bit can be used for only operation with shared spectrum channel access and if nrofPDCCH-MonitoringOccasionPerSSB-InPO is present.","paragraph_zero_based":48501},{"literal_text_all_w_t_and_m_t":"If set to 1: indication that the UE may stop monitoring PDCCH occasion(s) for paging in this Paging Occasion as specified in TS 38.304 [20], clause 7.1.","paragraph_zero_based":48502},{"literal_text_all_w_t_and_m_t":"4","paragraph_zero_based":48503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5baafc9461b8b5f8417a7c3805b8e3f3533db70c89582cdeb48ee4fa1a46a66a","9fbf26974b595ee9f1a880cde9849c74ec3e200735c9a2f9c521ca325d7643ea","a557dca73660b7bcb838bb48c19a0c94d25cc7a587ad5775c77c2015780486a0","58f3d40b038a1c833967262a5a2498e322e8cc7ab214d5b894c0076718eca161","129842a1b266f0e492b878058c3feccc727f3f4de915083b45dd97ec3ad22310","31050fabaa8226ba6fac3bd6e1b4ec33817876a384f8b9c5533eb8f0d00c33c7","cf5e66f3d2a0bce57dbf0fd7ce0deec7c1c1bd766adbd2bac65a696d5c98a3ee","aeb6324f36d037ecaea1ec92ae8a30c0ec4ba574190b3ea56695845eac180c70","2bb280c5c16ad5ebcea3e15f164b6671e8c7a347fe91e64e462d6de3413bbf2c","51cb247c615137f48a2906b73fb1bf4ebc3ad687df5508bbe0578bc9c64eb46f","08690c5c789b5f5934e93cffb6c57e4a532422e48bcc8d8066c401238711af30","08a40cb07ba2c45b2e5ea01404c432b4656129acf176817704bf7bd7965e396b","fb3983ff096d2296523d2fe89c08c2b70ee7f5d7353a65ea44fe9f1243a3c7c8","e2b3ae1c59181573f9031710afb4f9f91ffd89c9665d444b56a3ae79b8f1f9fb","e9ee0ea3f3e961cf25a241cd28c5c7b5e3b1f7205a3350ddd6b0c09968b15359","c17197b