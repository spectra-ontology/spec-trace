{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH, and SIB20, this field is absent.","paragraph_zero_based":27888},{"literal_text_all_w_t_and_m_t":"Otherwise, in pdsch-TimeDomainResourceAllocationList-r16, this field is optionally present, Need R.","paragraph_zero_based":27889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27890},{"literal_text_all_w_t_and_m_t":"–PDU-SessionID","paragraph_zero_based":27891},{"literal_text_all_w_t_and_m_t":"The IE PDU-SessionID identifies the PDU Session.","paragraph_zero_based":27892},{"literal_text_all_w_t_and_m_t":"PDU-SessionID information element","paragraph_zero_based":27893},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27894},{"literal_text_all_w_t_and_m_t":"-- TAG-PDU-SESSIONID-START","paragraph_zero_based":27895},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27896},{"literal_text_all_w_t_and_m_t":"PDU-SessionID ::=   INTEGER (0..255)","paragraph_zero_based":27897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27898},{"literal_text_all_w_t_and_m_t":"-- TAG-PDU-SESSIONID-STOP","paragraph_zero_based":27899},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27901},{"literal_text_all_w_t_and_m_t":"–PHR-Config","paragraph_zero_based":27902},{"literal_text_all_w_t_and_m_t":"The IE PHR-Config is used to configure parameters for power headroom reporting.","paragraph_zero_based":27903},{"literal_text_all_w_t_and_m_t":"PHR-Config information element","paragraph_zero_based":27904},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27905},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-START","paragraph_zero_based":27906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27907},{"literal_text_all_w_t_and_m_t":"PHR-Config ::=                      SEQUENCE {","paragraph_zero_based":27908},{"literal_text_all_w_t_and_m_t":"    phr-PeriodicTimer                   ENUMERATED {sf10, sf20, sf50, sf100, sf200,sf500, sf1000, infinity},","paragraph_zero_based":27909},{"literal_text_all_w_t_and_m_t":"    phr-ProhibitTimer                   ENUMERATED {sf0, sf10, sf20, sf50, sf100,sf200, sf500, sf1000},","paragraph_zero_based":27910},{"literal_text_all_w_t_and_m_t":"    phr-Tx-PowerFactorChange            ENUMERATED {dB1, dB3, dB6, infinity},","paragraph_zero_based":27911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["03530b762ee246800693d38ee922a304ace905868bbf72d50752fb231721614f","4752b3396fdcde45f50294696a3a292973c52b8ca9d4ffe33c3ac7bb10ce9966","a1dc80b775aad7725fb1fe2855aa542570617fe6bae2ae9bd7a85cb8e6f8eb56","6fcd84881b1bb10e27e7cd5ed9ea119069cb6ab0980ebaf21a4da35fe58aeea0","e82a350d8c0c3a258a0c9d063e9494e2dfa8fdca94dc5a9f7b8f1938673be03c","a636bc300a1b8eb85b1d1de44f26c0318dcc8e20918b729a60aef6f9a5bae908","a0d6347b91cc07118e0400b4b9bd009a17adbe184b519d9cc49daa02e24a928a","4d9f60918dfac23870549384f3c686717ce646a73145891e70c7637ebd7f888a","5085fa94aa75eb6a2fd6a2895f8beeef7bffc47cafcc3baebeeedeb9fdfddfb3","15aeef3ecd6552f3235a2ea6750510c0daada6df3c405cc0aabf70824d2330b1","c369b5b28edcea30099bdb173d636cc5f68bd47af5b1fde13670bfad0e517750","7891d47b7da7fffdc3d3621e7bb079cdd4bcb7d45345da34f4968948bdddf8e2","380c0fbcd2b943b3f1106ab7345524a4bdc005c6edc5db51f837080cf75492e3","ae0ce54b28f59fd3ecf1c58488241ef11751db99441dadfa5d417eaa0bf5bdbe","bd9b747699439d8bbc1d011883f6baebd9b2e65b626e72d5c1d40c49f5847aca","7e0757d9c0390f994b