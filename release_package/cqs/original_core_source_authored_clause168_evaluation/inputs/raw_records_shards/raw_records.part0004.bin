{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-DL-AoD-ReportConfig-r16NR-DL-AoD-ReportConfig-r16,","paragraph_zero_based":1152},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1153},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1154},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":1155},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1165},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-ReportConfig-r16 ::= SEQUENCE {","paragraph_zero_based":1166},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRP-MeasurementsPerTRP-r16INTEGER (1..8)OPTIONAL, -- Need ON","paragraph_zero_based":1167},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1168},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1169},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRP-MeasurementsPerTRP-r17INTEGER (9..24)OPTIONAL, -- Need ON","paragraph_zero_based":1170},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRPP-MeasurementsPerTRP-r17INTEGER (1..24)OPTIONAL, -- Need ON","paragraph_zero_based":1171},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest-r17SEQUENCE {","paragraph_zero_based":1172},{"literal_text_all_w_t_and_m_t":"type-r17LOS-NLOS-IndicatorType1-r17,","paragraph_zero_based":1173},{"literal_text_all_w_t_and_m_t":"granularity-r17","paragraph_zero_based":1174},{"literal_text_all_w_t_and_m_t":"LOS-NLOS-IndicatorGranularity1-r17,","paragraph_zero_based":1175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["4818858de04ca4a7442ccab8f66f1f248a69a97c334acd54d3a0b7bddea9d5fa","c90640ad54f5e21b2000399a690c97d0271081bdddb35eaf81696fda3a8f6a40","66a66cbe9db5fe86982eb507e383a3523f8653f602ba986f0fc48e8a0051374e","af5fb64d24b10a1ffb96df5655bf5a397516d508f3290d919b207bf3c15f5963","4f53012f74e9d75a2e94f6ca1d8a5d8277446357d3c057aec26dff244a8edda2","bb02253bf45275c93993f1d77533ee539de72a1bc598d458516ca1cabd444fe4","c00e79f95e6f75caba2742dd283e177720a117306e78883e81b76e1bee784215","d26aa770184ddd994753eb1efd889a1f936bd2635c2f1ee63c75e3367a3bbaaf","5c6055e747b9267536d84cb343055f6e5287e58e1d813dd6a265daf5abab9a8c","2075515d3dc7990bf8a8a03fb03f8fa683ae66654dd74070ca036fe58d78db5c","204672c7d2b0d94ce1dc73c9ec233413fa0c696bab447333299ac35cf4a8973d","6b5c158263cfbaf42aaf9f6964541b8b564ef912c1b98bfc12f71cc91132f780","c598461582d514615c7911bebafbcfce926bccad72f5fabc8a9a976aa3a75839","6bdbafa8b0b284e2a7512ca797a07c54dd5a809fc3c69ffdcdefd649a3d75c14","5d99b420a0311763a541043f41224ee40540122651fe913ed792e12902ca13a5","b96c62d9cab83c5eba549eef371fde73a222477c8903c61381f932c3152bcf20","327d157cbf43d7c998600b27eb54d49d1557a4f4db086119155480de1487e768","b97672ae8fd81177f15ccdb2d1db406eb483d76cff5bbfecc879b14a4e6b2c1f","286566724f552cedaef9cc82971a08ebb9602309b053c15a3467372ea3a69e16","85aa6c90a87c0e0e09e39e1d1ba1083e65759e80692c499257210ae01c55db05","98d1560256fd40026dd49c91a9865fe85f75e052a3df0fafe3c45a8a372c22b7","c0c8ab715