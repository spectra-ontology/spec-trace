{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28176},{"literal_text_all_w_t_and_m_t":"    pdsch-CodeBlockGroupTransmissionList-r16 SetupRelease { PDSCH-CodeBlockGroupTransmissionList-r16 }     OPTIONAL    -- Need M","paragraph_zero_based":28177},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28178},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28179},{"literal_text_all_w_t_and_m_t":"    downlinkHARQ-FeedbackDisabled-r17       SetupRelease { DownlinkHARQ-FeedbackDisabled-r17 }              OPTIONAL,   -- Need M","paragraph_zero_based":28180},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH-v1700        ENUMERATED {n32}                                               OPTIONAL    -- Need R","paragraph_zero_based":28181},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28182},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28184},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":28185},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":28186},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupFlushIndicator            BOOLEAN,","paragraph_zero_based":28187},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28188},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28190},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmissionList-r16 ::=    SEQUENCE (SIZE (1..2)) OF PDSCH-CodeBlockGroupTransmission","paragraph_zero_based":28191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28192},{"literal_text_all_w_t_and_m_t":"DownlinkHARQ-FeedbackDisabled-r17 ::= BIT STRING (SIZE (32))","paragraph_zero_based":28193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28194},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":28195},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28197},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":28198},{"literal_text_all_w_t_and_m_t":"codeBlockGroupFlushIndicator","paragraph_zero_based":28199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["83abbb4ab93ed59ac88772b94cd87bd5600fa3737163433becea72966974f7c8","45e0171244de51ff55fc04b4ffdf66f2f883814204d51a64197a7609a47dc1aa","c5be320a65080fc1e6562d2ad74f77243715a8abe089b2d482644813041106ad","081d1e4372859e8fa8c97b35ca8290fd8f80a43fa25e6f5fcd850f81219e2998","dec4402376f5980ee5c09feb411a460ad92033d2036ece06c4df1ae8977b57cb","44eea0a21b81406a490e0da3c191cf371bc7a4417e48daa012c2b1edb0973935","8184e45ceb2621e1a5a334120dea0f391c3354e99609d659a442985e59f934e7","138e9e7a3f930252c5346bf7bd2728a16eabcb6a3088c0b05ffcccb5381d503e","47709d1b50673f207fcda43894963d7ea6dd281e8b7c6570f1fd83a179594b3c","5a5a54a6d18711dd7584018aab0e5aa7a86383d8eaebf9854f2ab3f6b1611385","ed2d51418ea78d96cd463be6533a6f5f9d99ea3702663153640e8cc827370c1d","d529b05f2e3d10d2cc34b3d5bfd7f9f245e851b2f8ecd2907ea1976ef9fe2c44","619e1207e48ac60497d18663fbb56b05a04df4479b2895b20965cba5b45bb4d8","3c4364c0b03c1abc39faaf1c3da579be24c06ad385d3a052a6bc1ec5a572299d","0c6cfff7c5f1ff2b041ac090be21175e3131d5add5ceb4d336013a0e823ef246","ec6fa96575faefa2ee1b2374e7d9ff5362ac45d623b8f02cdcc440c5bf5ef662","8ad8e4ddb25fe1d3f8fd906e3f98a5d7b0452f1cb396e009bb8ec9342b0cb044","a541f459fb26f6855aeb2b379d1beb31eb849717449be5b2a5b97ccbc44c76cc","41bd47bcace027915ef1aae84cde9148b3ba57f2caff7c903cc0394a94edfca4","cabeee3e860b1fef76696291d8e59f20aa41c2a38b2f9ac203e4d604c190756f","017e7e20b8049b0b381c0e86785e5451d44e10c13c96d9b7658636551287674b","8449aa7b91cf9198a33273c8f47db7f7f26111e9566da65d72fe49a147e5f9e5","97f06ddc41dfb5c5a2595052ce1c63e58741e25129ea69653a6d10ed0556c078","56bf37a35dd03c7c9780336fe392b3bf0854c6a46a9a9c01b28f15550ce91c3b"],"paragraph_range_zero_based":[28176,28199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28176"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether CBGFI for CBG based (re)transmission in DL is enabled (true). (see TS 38.212 [17], clause 7.3.1.2.2).","paragraph_zero_based":28200},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":28201},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB. In case of multiple CW, the maximum CBG is 4 (see TS 38.213 [13], clause 9.1.1).","paragraph_zero_based":28202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28203},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig field descriptions","paragraph_zero_based":28204},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":28205},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.213 [13], clause 9.1.1). Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":28206},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if - the SCS of at least one DL BWP configured in the cell is 480 or 960 kHz - Type-1 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH) - Type-2 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for any cell in the same PUCCH cell group associated with this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH)","paragraph_zero_based":28207},{"literal_text_all_w_t_and_m_t":"downlinkHARQ-FeedbackDisabled","paragraph_zero_based":28208},{"literal_text_all_w_t_and_m_t":"Used to disable the DL HARQ feedback, sent in the uplink, per HARQ process ID. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. The bit(s) set to one identify HARQ processes with disabled DL HARQ feedback and the bit(s) set to zero identify HARQ processes with enabled DL HARQ feedback.","paragraph_zero_based":28209},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":28210},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in all BWPs of this serving cell. (see TS 38.212 [17], clause 5.4.2.1).","paragraph_zero_based":28211},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPDSCH","paragraph_zero_based":28212},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PDSCH of a serving cell. Value n2 corresponds to 2 HARQ processes, value n4 to 4 HARQ processes, and so on. If both nrofHARQ-ProcessesForPDSCH and nrofHARQ-ProcessesForPDSCH-v1700 are absent, the UE uses 8 HARQ processes (see TS 38.214 [19], clause 5.1).","paragraph_zero_based":28213},{"literal_text_all_w_t_and_m_t":"pdsch-CodeBlockGroupTransmissionList","paragraph_zero_based":28214},{"literal_text_all_w_t_and_m_t":"A list of configurations for up to two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":28215},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":28216},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PDSCH (see 38.214 [19], clause 5.3).","paragraph_zero_based":28217},{"literal_text_all_w_t_and_m_t":"pucch-Cell","paragraph_zero_based":28218},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell (of the same cell group) to use for PUCCH. If the field is absent, the UE sends the HARQ feedback on the PUCCH of the SpCell of this cell group, or on this serving cell if it is a PUCCH SCell.","paragraph_zero_based":28219},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":28220},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, CORESET, etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":28221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28222},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["24c0788dc085939c937475844e644e9c372a0d032280093de0731ac90d1d1778","bcbdd3a962b1dc67006c34c95369756c49346c4216593dfe4e57f49617314365","79566a79fc6f361e601a83dfaf565f75f0f353ebeeec4b730a674c636302be4f","88c8a4e209006abc1ec0bb19e77e7d5b69f457ac58593a8b10ae8dda678d801c","8abfe10176e800bbc2403b9cc7c602a577e170246eacd545627579c1ba8c2839","f6112846db68893caaa962e907194da734aa2b7c4fd4e5142d75cfe703a10dda","f04e4b990adc0f4d3e12c161cf5804ca80bdef121610c38f7c4e3afc09b45122","c0e8d4b4621462714261b480e5f4ea218afa438eb6d397afdf245564c36cc171","73a6b1545f6a4929827bf99ce5bab485a01403c35a820c6807334214ef0869cb","bafe24e475b098a29f07ebb6f83e6f0745177e942234ebb8a410d89223f3c1ae","e27246ed5d69befc7fca6c8a396ac9cdecfec2883c4e3708166efe3876130869","a59c0c27ef04006ab6354f0a1e17962d27dc597ce409513769c6bf5d749f9647","7f69640fecc81bb072a97fa59cabe502c97a3ee3971e43f3c6b7b1bcc473d638","502f84a2cfba9bec375bf837c1b95fcb887385aba5345d58030c46458bd054fb","48a5659307acaa599242839e9061fa6dd165b283598890813d1047997c5980f5","75430110164c5c100e7bd58b9b9632e3b895ef68de692054eb35ea3091133bab","c48fa7d0c35a1acb33342d19c051485b08433a21e5580eee68c7d44369828a32","47213c7f67d26f5f94b14f988057dfba17afe74a296292f2bffa1557a1ea1cb9","5fed5b8bb4f36cb5f479986104970084216fa44bac55caad61676f84c520ce2f","94c96a7df6ac08d12c8caae7b27c9c1df2303b39fd905cb5fa430144a97314f3","c5a265bb56d30616d85abee7e35df0a6d497de97527a2c0dd855b27a6351227b","8feb28df9b93e3893098469cf3a552028aead36028dc98866f0ab2a8b792c00d","f75ceb75a4c846a1e14e7e9457779cf6fd90bf50baf03d7abf361dd455bd82cd","adf7e2bb0a5d0714fbc8e147f021e21712889255312dbd444d5a93cfd55ae227"],"paragraph_range_zero_based":[28200,28223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28224},{"literal_text_all_w_t_and_m_t":"SCellAddOnly","paragraph_zero_based":28225},{"literal_text_all_w_t_and_m_t":"It is optionally present, Need S, for (non-PUCCH) SCells when adding a new SCell. The field is absent, Need M, when reconfiguring SCells. The field is also absent for the SpCells as well as for a PUCCH SCell.","paragraph_zero_based":28226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28227},{"literal_text_all_w_t_and_m_t":"–PDSCH-TimeDomainResourceAllocationList","paragraph_zero_based":28228},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PDSCH. The PDSCH-TimeDomainResourceAllocationList contains one or more of such PDSCH-TimeDomainResourceAllocations. The network indicates in the DL assignment which of the configured time domain allocations the UE shall apply for that DL assignment. The UE determines the bit width of the DCI field based on the number of entries in the PDSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":28229},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList information element","paragraph_zero_based":28230},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28231},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":28232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28234},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation","paragraph_zero_based":28235},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28236},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation ::=   SEQUENCE {","paragraph_zero_based":28237},{"literal_text_all_w_t_and_m_t":"    k0                                      INTEGER(0..32)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":28238},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":28239},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":28240},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28242},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":28243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28244},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":28245},{"literal_text_all_w_t_and_m_t":"    k0-r16                                     INTEGER(0..32)                                              OPTIONAL,   -- Need S","paragraph_zero_based":28246},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                            ENUMERATED {typeA, typeB},","paragraph_zero_based":28247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["eea2d35993d06eb7cfdbbf30de64ea58f42b531094ffb0dcd4c22af860498ddc","bcb82b4