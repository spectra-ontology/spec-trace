{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    carrierFreqDL                       INTEGER (0..16383),","paragraph_zero_based":30816},{"literal_text_all_w_t_and_m_t":"    carrierBandwidthDL                  ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1},","paragraph_zero_based":30817},{"literal_text_all_w_t_and_m_t":"    mbsfn-SubframeConfigList            EUTRA-MBSFN-SubframeConfigList                                          OPTIONAL,   -- Need M","paragraph_zero_based":30818},{"literal_text_all_w_t_and_m_t":"    nrofCRS-Ports                       ENUMERATED {n1, n2, n4},","paragraph_zero_based":30819},{"literal_text_all_w_t_and_m_t":"    v-Shift                             ENUMERATED {n0, n1, n2, n3, n4, n5}","paragraph_zero_based":30820},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30822},{"literal_text_all_w_t_and_m_t":"LTE-CRS-PatternList-r16 ::=         SEQUENCE (SIZE (1..maxLTE-CRS-Patterns-r16)) OF RateMatchPatternLTE-CRS","paragraph_zero_based":30823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30824},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-STOP","paragraph_zero_based":30825},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30827},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30828},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS field descriptions","paragraph_zero_based":30829},{"literal_text_all_w_t_and_m_t":"carrierBandwidthDL","paragraph_zero_based":30830},{"literal_text_all_w_t_and_m_t":"BW of the LTE carrier in number of PRBs (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30831},{"literal_text_all_w_t_and_m_t":"carrierFreqDL","paragraph_zero_based":30832},{"literal_text_all_w_t_and_m_t":"Center of the LTE carrier (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30833},{"literal_text_all_w_t_and_m_t":"mbsfn-SubframeConfigList","paragraph_zero_based":30834},{"literal_text_all_w_t_and_m_t":"LTE MBSFN subframe configuration (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30835},{"literal_text_all_w_t_and_m_t":"nrofCRS-Ports","paragraph_zero_based":30836},{"literal_text_all_w_t_and_m_t":"Number of LTE CRS antenna port to rate-match around (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30837},{"literal_text_all_w_t_and_m_t":"v-Shift","paragraph_zero_based":30838},{"literal_text_all_w_t_and_m_t":"Shifting value v-shift in LTE to rate match around LTE CRS (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":30839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1dc711b397890c33b9bc5026f450164b5f588b131fa2a5e61e946913886b7f4c","656f3239e8e912e6054abb7251dc205b76fc5e845f29595e26c8e3c3c4f7303f","5f09693f830716e44251b8e110d890a7f41a814052e74aba86becabbc3f06e03","c86c1755a7282f27cf927de5deffc0e0772c078b1d64afa8a6d8c819a3380d05","b2c23973d6241ed9aa09131707149d1da6c8958940adf3691d8fbe8c208ec915","fe1c421da92f8b5c83ab50fdd514cc5db93ee7c54df383a4bdc5d100ca470385","d404f6bbc60e306008c345f9d53b3d902422440940d7e13f4c3317362768f314","8776d82eb5d3b59ba0619737b22fcd01286d7b8699f019a7e91cc15c62b76506","b216cd0cdd481476d5fdfcf0b3854806fa9699ee2581319caba31567a11f1640","ebb05b3175bfd0cea8ebfe7d18b027506a669049c2723d6946f3d3af37455385","c013fa40eb45198dd619488fd077eca69ef8e01484b093502ecec3f147a7aaa7","8433ce780afbe07d48fcf61bb4cd8b6b811a8e44d68382129485c0e93c9ca7ca","9099f299fcd84677b72feaaf6b62a43f84d7