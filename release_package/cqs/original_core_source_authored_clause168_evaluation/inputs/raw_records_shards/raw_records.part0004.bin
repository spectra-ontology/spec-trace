{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SCellIndex concerns a short identity, used to identify an SCell. The value range is shared across the Cell Groups.","paragraph_zero_based":32688},{"literal_text_all_w_t_and_m_t":"SCellIndex information element","paragraph_zero_based":32689},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32690},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLINDEX-START","paragraph_zero_based":32691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32692},{"literal_text_all_w_t_and_m_t":"SCellIndex ::=                      INTEGER (1..31)","paragraph_zero_based":32693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32694},{"literal_text_all_w_t_and_m_t":"-- TAG-SCELLINDEX-STOP","paragraph_zero_based":32695},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32697},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestConfig","paragraph_zero_based":32698},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestConfig is used to configure the parameters, for the dedicated scheduling request (SR) resources.","paragraph_zero_based":32699},{"literal_text_all_w_t_and_m_t":"SchedulingRequestConfig information element","paragraph_zero_based":32700},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32701},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTCONFIG-START","paragraph_zero_based":32702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32703},{"literal_text_all_w_t_and_m_t":"SchedulingRequestConfig ::=         SEQUENCE {","paragraph_zero_based":32704},{"literal_text_all_w_t_and_m_t":"    schedulingRequestToAddModList       SEQUENCE (SIZE (1..maxNrofSR-ConfigPerCellGroup)) OF SchedulingRequestToAddMod","paragraph_zero_