{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the configuration is for cell DTX only, cell DRX only, or joint cell DTX/DRX configuration.","paragraph_zero_based":19344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19345},{"literal_text_all_w_t_and_m_t":"–CellGroupConfig","paragraph_zero_based":19346},{"literal_text_all_w_t_and_m_t":"The CellGroupConfig IE is used to configure a master cell group (MCG) or secondary cell group (SCG). A cell group comprises of one MAC entity, a set of logical channels with associated RLC entities and of a primary cell (SpCell) and one or more secondary cells (SCells). For an NCR-MT, the CellGroupConfig IE is also used to provide the configuration of side control information for the NCR-Fwd access link.","paragraph_zero_based":19347},{"literal_text_all_w_t_and_m_t":"CellGroupConfig information element","paragraph_zero_based":19348},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19349},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLGROUPCONFIG-START","paragraph_zero_based":19350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19351},{"literal_text_all_w_t_and_m_t":"-- Configuration of one Cell-Group:","paragraph_zero_based":19352},{"literal_text_all_w_t_and_m_t":"CellGroupConfig ::=                        SEQUENCE {","paragraph_zero_based":19353},{"literal_text_all_w_t_and_m_t":"    cellGroupId                                CellGroupId,","paragraph_zero_based":19354},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToAddModList                     SEQUENCE (SIZE(1..maxLC-ID)) OF RLC-BearerConfig                        OPTIONAL,   -- Need N","paragraph_zero_based":19355},{"literal_text_all_w_t_and_m_t":"    rlc-BearerToReleaseList                    SEQUENCE (SIZE(1..maxLC-ID)) OF LogicalChannelIdentity                  OPTIONAL,   -- Need N","paragraph_zero_based":19356},{"literal_text_all_w_t_and_m_t":"    mac-CellGroupConfig                        MAC-CellGroupConfig                                                     OPTIONAL,   -- Need M","paragraph_zero_based":19357},{"literal_text_all_w_t_and_m_t":"    physicalCellGroupConfig                    PhysicalCellGroupConfig                                                 OPTIONAL,   -- Need M","paragraph_zero_based":19358},{"literal_text_all_w_t_and_m_t":"    spCellConfig                               SpCellConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":19359},{"literal_text_all_w_t_and_m_t":"    sCellToAddModList                          SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellConfig                       OPTIONAL,   -- Need N","paragraph_zero_based":19360},{"literal_text_all_w_t_and_m_t":"    sCellToReleaseList                         SEQUENCE (SIZE (1..maxNrofSCells)) OF SCellIndex                        OPTIONAL,   -- Need N","paragraph_zero_based":19361},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19362},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19363},{"literal_text_all_w_t_and_m_t":"    reportUplinkTxDirectCurrent                ENUMERATED {true}                                                   OPTIONAL    -- Cond BWP-Reconfig","paragraph_zero_based":19364},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19365},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19366},{"literal_text_all_w_t_and_m_t":"    bap-Address-r16                            BIT STRING (SIZE (10))                                                  OPTIONAL,   -- Need M","paragraph_zero_based":19367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930e