{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config information element","paragraph_zero_based":25848},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25849},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-START","paragraph_zero_based":25850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25851},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config-r16 ::=                      SEQUENCE {","paragraph_zero_based":25852},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupA-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond InitialBWPConfig","paragraph_zero_based":25853},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupB-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond GroupBConfigured","paragraph_zero_based":25854},{"literal_text_all_w_t_and_m_t":"    msgA-TransformPrecoder-r16                    ENUMERATED {enabled, disabled}                                 OPTIONAL, -- Need R","paragraph_zero_based":25855},{"literal_text_all_w_t_and_m_t":"    msgA-DataScramblingIndex-r16                   INTEGER (0..1023)                                             OPTIONAL, -- Need S","paragraph_zero_based":25856},{"literal_text_all_w_t_and_m_t":"    msgA-DeltaPreamble-r16                         INTEGER (-1..6)                                               OPTIONAL  -- Need R","paragraph_zero_based":25857},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25859},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource-r16 ::=                    SEQUENCE {","paragraph_zero_based":25860},{"literal_text_all_w_t_and_m_t":"    msgA-MCS-r16                                   INTEGER (0..15),","paragraph_zero_based":25861},{"literal_text_all_w_t_and_m_t":"    nrofSlotsMsgA-PUSCH-r16                        INTEGER (1..4),","paragraph_zero_based":25862},{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-PerSlot-r16                        ENUMERATED {one, two, three, six},","paragraph_zero_based":25863},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainOffset-r16                INTEGER (1..32),","paragraph_zero_based":25864},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainAllocation-r16            INTEGER (1..maxNrofUL-Allocations)                            OPTIONAL, -- Need S","paragraph_zero_based":25865},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLengthMsgA-PO-r16                INTEGER (0..127)                                              OPTIONAL, -- Need S","paragraph_zero_based":25866},{"literal_text_all_w_t_and_m_t":"    mappingTypeMsgA-PUSCH-r16                      ENUMERATED {typeA, typeB}                                     OPTIONAL, -- Need S","paragraph_zero_based":25867},{"literal_text_all_w_t_and_m_t":"    guardPeriodMsgA-PUSCH-r16                      INTEGER (0..3)                                                OPTIONAL, -- Need R","paragraph_zero_based":25868},{"literal_text_all_w_t_and_m_t":"    guardBandMsgA-PUSCH-r16                        INTEGER (0..1),","paragraph_zero_based":25869},{"literal_text_all_w_t_and_m_t":"    frequencyStartMsgA-PUSCH-r16                   INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":25870},{"literal_text_all_w_t_and_m_t":"    nrofPRBs-PerMsgA-PO-r16                        INTEGER (1..32),","paragraph_zero_based":25871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8