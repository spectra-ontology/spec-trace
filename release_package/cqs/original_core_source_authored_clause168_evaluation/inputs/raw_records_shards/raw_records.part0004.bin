{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CO-DurationsPerCell field descriptions","paragraph_zero_based":34056},{"literal_text_all_w_t_and_m_t":"co-DurationList","paragraph_zero_based":34057},{"literal_text_all_w_t_and_m_t":"A list of Channel Occupancy duration in symbols.","paragraph_zero_based":34058},{"literal_text_all_w_t_and_m_t":"The maximum duration that can be configured for the following SCS:","paragraph_zero_based":34059},{"literal_text_all_w_t_and_m_t":"-15 kHz: 280.","paragraph_zero_based":34060},{"literal_text_all_w_t_and_m_t":"-30 kHz: 560.","paragraph_zero_based":34061},{"literal_text_all_w_t_and_m_t":"-60 kHz: 1120.","paragraph_zero_based":34062},{"literal_text_all_w_t_and_m_t":"-120 kHz: 560.","paragraph_zero_based":34063},{"literal_text_all_w_t_and_m_t":"-480 kHz: 2240.","paragraph_zero_based":34064},{"literal_text_all_w_t_and_m_t":"-960 kHz: 4480.","paragraph_zero_based":34065},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34066},{"literal_text_all_w_t_and_m_t":"Position in DCI of the bit field indicating Channel Occupancy duration for UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34067},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":34068},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":34069},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":34070},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for the list of Channel Occupancy durations (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34071},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency range:","paragraph_zero_based":34072},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":34073},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":34074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34075},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchTrigger field descriptions","paragraph_zero_based":34076},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34077},{"literal_text_all_w_t_and_m_t":"The position of the bit within DCI payload containing a search space switching flag (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34078},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":34079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ccb61f306b52db318b911688238a2b865161c440a1f15e3f6cb26b3178edea34","d04f651dfa28a7150212a6b703cfedc5a0898e24df4167f3aaef390fed7c73f3","7fe145f75ab8cdb0c3f926fd77497bc6834bdcd270b824aad01c3de43b803d33","7ebe33fac6194e1aab3ef4c5c0c4176ad2ac0c29faa13993290995204df4b821","c7a440fa12e2704764c0f4a6f6ed3fb3830a15e4b0ad017221ed4877f18aafc0","28714793b236173a705eaac082de64bc9253043175185f950cbf875c2c45dade","5aecc6df6216baf1b07b8c7a03f2ac7d56fcdf2847fab54b1f7636e2169ccd6b","528146cd639e2d141c67101cf7fac1f11629072247463f96038269eaf08cb1b9","d5be171648defa6d000d65ac29df7ea760fe3a6688247e921ec82f57cf36e860","6b75ba9323a63fb5aac476184d334da53efadeb1acb9d83844fd19f5a2dfb0c7","60f1ae7f235907b6f398657331fa652d3ce976204faf9cbfff3959fe2d34e8b2","ee32ae792b14466c5a7ce0b294bbb6b1b104e18b348cdf42a69fdc305051f45e","fb7fba20a89165cc79275c4abc47aef0c463ff21f515bf32b1782f10cde310de","e7503e3657b61614e009edaaaf8480c70d23c6bfa3270568649b4c222d533879","c293fb3800c933e48f621a277abd2c5795adb834cdf8641ea6dbe6782b06f26a","d8bd083