{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":19008},{"literal_text_all_w_t_and_m_t":"        unifiedTCI-StateRef-r17         ServingCellAndBWP-Id-r17","paragraph_zero_based":19009},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL,  -- Need R","paragraph_zero_based":19010},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17                Uplink-powerControlId-r17                                                OPTIONAL,  -- Cond NoTCI-PC","paragraph_zero_based":19011},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast1-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL,  -- Need M","paragraph_zero_based":19012},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationListMulticast2-r17  SetupRelease { PUCCH-ConfigurationList-r16 }                         OPTIONAL   -- Need M","paragraph_zero_based":19013},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19014},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19015},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigMulticast1-r17          SetupRelease { PUCCH-Config }                                           OPTIONAL,  -- Need M","paragraph_zero_based":19016},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigMulticast2-r17          SetupRelease { PUCCH-Config }                                           OPTIONAL   -- Need M","paragraph_zero_based":19017},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19018},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19019},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToAddModList-r17     SEQUENCE (SIZE (1..maxNrofPathlossReferenceRSs-r17)) OF PathlossReferenceRS-r17","paragraph_zero_based":19020},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL, -- Need N","paragraph_zero_based":19021},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToReleaseList-r17    SEQUENCE (SIZE (1..maxNrofPathlossReferenceRSs-r17)) OF PathlossReferenceRS-Id-r17","paragraph_zero_based":19022},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL  -- Need N","paragraph_zero_based":19023},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19024},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19025},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19026},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigToAddModList-r16    ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfig","paragraph_zero_based":19027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19028},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigToReleaseList-r16   ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":19029},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19030},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationState-r16 ::= SEQUENCE (SIZE (1..maxNrofConfiguredGrantConfig-r16)) OF ConfiguredGrantConfigIndex-r16","paragraph_zero_based":19031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["05c810a9d17326c455c323f7b8f11cac12ca75bccdd56441de262698b54c272a","fb24b383aedc3ed97610cb43f9bd940bad2fe9dad8687849cb8b29fa852d72d6","1d250dc6936c37dffd0d05f2c37a22b0d1b9f58a8a3f06e69b2dbadb76cd0a98","3a1e5373d81a5891624c8c01758cdc47c8f8a2b41ea76ad24755398c5cf353df","d71fa0e8480ee479bc9d909e14a281915f92d1bb6a6e033fdcacd2690fe3f727","e5d5037bd072099cf8a93edce7ab5761dba115e6f0e040e3eae3daae2336d1f1","36166aed011bc01a726b2dd24668b068eb198cc9907c286815d322583105e4e0","b8ea0bde69513c9641bfa58131cf3dd3bda23a401d4d8203460040f4a637ae91","8281a36903fc43f236e596d1e14ca3a6e7e814aeb728f0e65230a9a5b0decb33","36594c257dd06d1803c96fa5281e6d5ddcbcd991af5d623bb329f627faadd7a6","824301e446c92d6f0d9338ac4168823bd7dc5076dc941ca905d1317324fa58c4","3862abb8da06c8e434b8981f29fdc6d0b1afabb19d8857ae9b1ec0be00d330bb","0bc14322e4cc608d796e70880418153210c1f693fcd19011c6df5e3984922981","9dbffb738efd1d981aad8aebeccd48db70b7f1367f63042d861da1690522136a","640d7ef5105bf5f5c3ecf377b49074a08680ea5670c94a9dd4acbfaf9ac82172","eca0f9370a33cb31b7971e5fb1bc371c8433674a1ad02656c320d612abb55ba6","7c907f5c3c8e9e7d19ab1c48ee5fdcc5d45b95d2103b91138d0e965b68ee7b74","e73e1d04a59846cb1acb0753abb5b706f161d7a405411ad914e2ab40ff7d4d0a","d480f35025612010f1243a1341e002e03f1421635a366cdad3c4ca91ca06e6df","ca23af8ecf23183c1169cfa100128ed81a27ef112df4982000960d844939c849","1347ed0d56d32a98378e04b2195dd71062e3823013eb95625e13beaa849aa355","7528d2b0fcff9daa11c8cc3e169ad976468ecb565ab62235b7f4dcf799d7421e","b9c2acfd70eeaf15a3eccbcfda00977d8eba5d9e80666cc398d48632847fd432","14218b30a0bbb3c33e40897d99064be066619ec3ca9643a728fdf2078fdc74ba"],"paragraph_range_zero_based":[19008,19031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p19008"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19032},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigType2DeactivationStateList-r16  ::=","paragraph_zero_based":19033},{"literal_text_all_w_t_and_m_t":"                             SEQUENCE (SIZE (1..maxNrofCG-Type2DeactivationState)) OF ConfiguredGrantConfigType2DeactivationState-r16","paragraph_zero_based":19034},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19035},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-STOP","paragraph_zero_based":19036},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19038},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated field descriptions","paragraph_zero_based":19039},{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryConfig","paragraph_zero_based":19040},{"literal_text_all_w_t_and_m_t":"Configuration of beam failure recovery. If supplementaryUplink is present, the field is present only in one of the uplink carriers, either UL or SUL.","paragraph_zero_based":19041},{"literal_text_all_w_t_and_m_t":"configuredGrantConfig","paragraph_zero_based":19042},{"literal_text_all_w_t_and_m_t":"A Configured-Grant of type1 or type2. It may be configured for UL or SUL but in case of type1 not for both at a time. Except for reconfiguration with sync, the NW does not reconfigure configuredGrantConfig when there is an active configured uplink grant Type 2 (see TS 38.321 [3]). However, the NW may release the configuredGrantConfig at any time. Network can only configure configured grant in one BWP using either this field or configuredGrantConfigToAddModList.","paragraph_zero_based":19043},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToAddModList","paragraph_zero_based":19044},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more configured grant configurations to be added or modified for one BWP. Except for reconfiguration with sync, the NW does not reconfigure a Type 2 configured grant configuration when it is active (see TS 38.321 [3]). The network configures multiple CG configurations for one BWP with either all configurations or no configuration configured with cg-RetransmissionTimer-r16.","paragraph_zero_based":19045},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigToReleaseList","paragraph_zero_based":19046},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more UL Configured Grant configurations to be released. The NW may release a configured grant configuration at any time.","paragraph_zero_based":19047},{"literal_text_all_w_t_and_m_t":"configuredGrantConfigType2DeactivationStateList","paragraph_zero_based":19048},{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple Configured Grant type 2 configurations to be deactivated when the corresponding deactivation DCI is received, see clause 7.3.1 in TS 38.212 [17] and clause 10.2 in TS 38.213 [13].","paragraph_zero_based":19049},{"literal_text_all_w_t_and_m_t":"cp-ExtensionC2, cp-ExtensionC3","paragraph_zero_based":19050},{"literal_text_all_w_t_and_m_t":"Configures the cyclic prefix (CP) extension (see TS 38.211 [16], clause 5.3.1). For 15 kHz SCS, {1..28} are valid for both cp-ExtensionC2 and cp-ExtensionC3. For 30 kHz SCS, {1..28} are valid for cp-ExtensionC2 and {2..28} are valid for cp-ExtensionC3. For 60 kHz SCS, {2..28} are valid for cp-ExtensionC2 and {3..28} are valid for cp-ExtensionC3.","paragraph_zero_based":19051},{"literal_text_all_w_t_and_m_t":"lbt-FailureRecoveryConfig","paragraph_zero_based":19052},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection of consistent uplink LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":19053},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSToAddModList","paragraph_zero_based":19054},{"literal_text_all_w_t_and_m_t":"A list of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation. If unifiedTCI-StateType is not configured for the serving cell, no element in this list is configured.","paragraph_zero_based":19055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["59947a6981a82f796ddd2d9dcd0c10bbf41329fc6fc4f2688d1ee0103481a164","39da7c82be642a0ec48dd47c0a958ed2fb84ab068f03935357a97081b9aab2ea","5f82ae67d4e2941e074cd9a27f661c13201f0f0233bca3b23c09e14a976846a7","cf21057576d4efe45da34c48864ca33e28d001a55bfbd70a02e1994296bc0481","1ba4b1f6b3567b41b1deb0e3776f0700ac75158fb7152adbf61070da48438f71","77a9a9e37662c6c727ec94f8cae366b82a4d6359e7115e93823f7c9a86074d88","b0ca8d16b92511c12a0ec89d81a42c609558d80b1a4a650032a2184c98eae105","6820debfe2232499173bb3aea922e4435e2a1dd2028e98b64d96cef4caf23d2b","cb4d65483b2ad347303b6d29106f24aa3eeb925ebe75466466f8124fbcd2af79","98446fcd1deb5186b13220f98ae35eeb46b54394f0e836046e3def9c0f3a7fd8","7ecfe0ec0e71a2ee1fb4ef03a3568794715219419bfb69bc11df8052125f9152","9fe155cd9117d109de22d22c77abac65cc64d78e4cdfe4feb5c04d2e60f104a2","3ca25ffbbcf7fc604ef605730850a089433b9fe93e3085d2552d9e063c6acfbc","b305a9d86acd8030ca3e0d75743287b8dc571c0f8a0ed8c41d7054d1bff11b27","69afaff310b2eedcb0e146bf72361cf147b89d52aa5f80c83dcf9de064395f3e","d64dc68eb6457f1192e32577344cb5e6ca290300dd93fa17e73eb304d3b20af1","91456d1c9caf940c4bf9cf572e8e104bdf6d687db72586ca57afb20bb7b4b3cf","67e0e3616734c2919b3a86ecab66dab6e1a32d89683736d85a173a2e16eb4d0d","0e80774c2b1fea746a05873db11552cdfc79f1089c94c95816cd820656980ab4","09f901538a7e2a9aedc73a794b040b233414bd2d1f2bc11ace660e0c6c3adcd9","9b62b9cf55bf38fddc013a323103f2022394097407f8aa6e809869f4aab4ed42","588a1f8a22b9db7be851ada699871099f14394bfabefacf132e10eff1de7bbf7","813074a5a0d5312e04686142b8bc36b36d7bdc743d208ca02bfe345d17823e88","0a8972316dd315659a4e0163f5a3b123aa117a06a7786ac88f5ea8749e3fb220"],"paragraph_range_zero_based":[19032,19055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p19032"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-Config","paragraph_zero_based":19056},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL, the network configures PUCCH only on the BWPs of one of the uplinks (normal UL or SUL). The network configures PUCCH-Config at least on non-initial BWP(s) for SpCell and on all BWP(s) for PUCCH SCell. If supported by the UE, the network may configure at most one additional SCell of a cell group with PUCCH-Config (i.e. PUCCH SCell). If PUCCH cell switching is supported by the UE, the network may configure two TDD serving cells with PUCCH-Config within each PUCCH group. For supporting PUCCH cell switching in the PUCCH group with the SpCell, the TDD SpCell and one TDD SCell shall have PUCCH-Config on their normal UL. For supporting PUCCH cell switching in the PUCCH group with only SCells, two TDD SCells shall have PUCCH-Config on their normal UL.","paragraph_zero_based":19057},{"literal_text_all_w_t_and_m_t":"In (NG)EN-DC and NE-DC, the NW configures at most one serving cell per frequency range with PUCCH. In (NG)EN-DC and NE-DC, if two PUCCH groups are configured, the serving cells of the NR PUCCH group in FR2 use the same numerology. For NR-DC, the maximum number of PUCCH groups in each cell group is one, and only the same numerology is supported for the cell group with carriers only in FR2.","paragraph_zero_based":19058},{"literal_text_all_w_t_and_m_t":"The NW may configure PUCCH for a BWP when setting up the BWP. The network may also add/remove the pucch-Config in an RRCReconfiguration with reconfigurationWithSync (for SpCell or PUCCH SCell) or with SCell release and add (for PUCCH SCell) to move the PUCCH between the UL and SUL carrier of one serving cell. In other cases, only modifications of a previously configured pucch-Config are allowed.","paragraph_zero_based":19059},{"literal_text_all_w_t_and_m_t":"If one (S)UL BWP of a serving cell is configured with PUCCH, all other (S)UL BWPs must be configured with PUCCH, too.","paragraph_zero_based":19060},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationList","paragraph_zero_based":19061},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.1). Different PUCCH Resource IDs are configured in different PUCCH-Config within the pucch-ConfigurationList if configured.","paragraph_zero_based":19062},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast1","paragraph_zero_based":19063},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed HARQ-ACK codebooks for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":19064},{"literal_text_all_w_t_and_m_t":"pucch-ConfigurationListMulticast2","paragraph_zero_based":19065},{"literal_text_all_w_t_and_m_t":"PUCCH configurations for two simultaneously constructed NACK-only feedback for MBS multicast (see TS 38.213, clause 9).","paragraph_zero_based":19066},{"literal_text_all_w_t_and_m_t":"pusch-Config","paragraph_zero_based":19067},{"literal_text_all_w_t_and_m_t":"PUSCH configuration for one BWP of the normal UL or SUL of a serving cell. If the UE is configured with SUL and if it has a PUSCH-Config for both UL and SUL, an UL/SUL indicator field in DCI indicates which of the two to use. See TS 38.212 [17], clause 7.3.1.","paragraph_zero_based":19068},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast1","paragraph_zero_based":19069},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the HARQ-ACK codebook for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":19070},{"literal_text_all_w_t_and_m_t":"pucch-ConfigMulticast2","paragraph_zero_based":19071},{"literal_text_all_w_t_and_m_t":"PUCCH configuration for the NACK-only feedback for MBS multicast when multicast feedback is not configured with a priority value (see TS 38.213 [13], clause 9). If the field is not configured, pucch-Config applies.","paragraph_zero_based":19072},{"literal_text_all_w_t_and_m_t":"sl-PUCCH-Config","paragraph_zero_based":19073},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PUCCH configurations used for the HARQ-ACK feedback reporting for NR sidelink communication.","paragraph_zero_based":19074},{"literal_text_all_w_t_and_m_t":"srs-Config","paragraph_zero_based":19075},{"literal_text_all_w_t_and_m_t":"Uplink sounding reference signal configuration.","paragraph_zero_based":19076},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":19077},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS when UE is configured with unifiedTCI-StateType for this serving cell. For each serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated or it is not configured in any BWP-UplinkDedicated. When unifiedTCI-StateRef in the BWP-UplinkDedicated or in the PDSCH-Config if the unifiedTCI-StateType is set to joint, of a serving cell refers to another serving cell, ul-powerControl is either configured in all BWP-UplinkDedicated of these two serving cells or it is not configured in any BWP-UplinkDedicated of these two serving cells.","paragraph_zero_based":19078},{"literal_text_all_w_t_and_m_t":"ul-TCI-StateList","paragraph_zero_based":19079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["67bfee58a0bbdb0cd01c7b71ff56633946f3278aeed50aed6081d42da42e5c79","4de68b5430c098b57e85fbf6f4e6b4ed5602f610a282b0980aafa99b1622e856","e42e2ccc01a0377eb7a3af200979a092cf6867ffe94240af1a39ce620212f7aa","855fc4e43c5f975485fbed1a5f91dc2768364251e89d6443354833a355b04e37","12b8c4d815443e993c6f4aa2256e1952258642657f5b972d243f2389cb26a0d4","58b77a079dbc58240a8fb080236ad1f9442dfaba5a5d4fe1b2a84ffa14c1f872","45891c612d32eee143f346fa5aacbe33f2b1899021803e8b5510fc14bcdc495a","2a6e5a63dc71052697cc068dccedb5ccc962f14d506561b783452c06798ca4a8","8cb097e77935f58e29e9c5ce4175e52e00f0f90d21ee241b92ba0e61ce7a6b44","7e598978981e6623c3d4b9d23f4d69c63a2664eb136ebe77cac9ec4071708cff","7bd032501839191092f18d6cca90f9b2e4fefa0a5d21970bdd10f523ca7cb96e","667b187e9dfc1a3efda8145dfbebb63c4380c897e0213ec26641d7625fb6ad93","d2d7183939d25f794769924c8debbfe88cf298053472e60217e52224dc977940","5b52da900648723d93f87b4e2e6a8350ac75b5e9b89b4c182630a55b6f0ade41","4b59d0ad139099aac6cd0e65775a56d9cf46cc76a5d22d55bf14a6793e923b52","ee9cc2751ddecfb02dcd2ac2f940deb10a9f65f3ea0148855ec16c43f5a24252","0fbf188809e5e950d829b20b9ff2d2fbc0e427fd3315f47aa69138a206d9174d","23d382b23fd076c6506213d7188a486b7f2b47e58804a8e9fd82489aae82f886","8f00971bd56d8fdda9648872c8742046ea89c4ce6c9aebd11aee0f1af07c2c84","2c17c098c74549789443b20f142ce6f047bdfde3aeb24378ef60a57efe04c8e2","c4ed6d9e28b8d8499647f168761f117f0cf303da569bd8635bd10778cf484d4a","9f94f890857e70503e378a4495e2a69a918562e8e91b0e64ef953790e6c8edb7","e3bc903282202c0950765842710f4940a1c474936529001a4e56894500eb7656","a6cbd14b7b6e12feba84feac2889dea25b2f7afe6b711012425241ab93909a0f"],"paragraph_range_zero_based":[19056,19079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p19056"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the applicable UL TCI states for PUCCH, PUSCH and SRS.","paragraph_zero_based":19080},{"literal_text_all_w_t_and_m_t":"ul-TCI-ToAddModList","paragraph_zero_based":19081},{"literal_text_all_w_t_and_m_t":"Indicates a list of UL TCI states.","paragraph_zero_based":19082},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":19083},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and UL BWP where UL TCI states applicable to this UL BWP are defined. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":19084},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":19085},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for PUSCH (see TS 38.213 [13], clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0, 1, 2, and 3 for PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":19086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19087},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":19088},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":19089},{"literal_text_all_w_t_and_m_t":"NoTCI-PC","paragraph_zero_based":19090},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if unifiedTCI-StateType is configured for this serving cell and ul-powerControl is not configured for any UL TCI state or joint TCI state of this serving cell. Otherwise it is absent, Need R","paragraph_zero_based":19091},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":19092},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkDedicated of an SpCell. It is absent otherwise. ","paragraph_zero_based":19093},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19094},{"literal_text_all_w_t_and_m_t":"NOTE 1:In case of RRCReconfiguration with reconfigurationWithSync, the UE performs a MAC reset, which involves releasing the PUCCH-CSI/SRS/SR configuration in accordance with clause 5.3.12 and TS 38.321 [3], clauses 5.12 and 5.2. Hence, for these parts of the dedicated radio resource configuration, delta signalling is not supported in the message when reconfigurationWithSync is included.","paragraph_zero_based":19095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19096},{"literal_text_all_w_t_and_m_t":"–CandidateBeamRS","paragraph_zero_based":19097},{"literal_text_all_w_t_and_m_t":"The IE CandidateBeamRS inlcudes candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":19098},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS information element","paragraph_zero_based":19099},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19100},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-START","paragraph_zero_based":19101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bccd69ef4326f2ab15ec9932318b317f2e68c206c11a0b231c9a1000e7a3bc66","6e860164932234177261f8f55271baddf72da08079d75ce290eb1b645b90cd06","f11a856942a3249c9385ec2cae8b5439c0e71857f7acd5a6ddd05769e3ad7b67","010355819dc84d4fc99ed2a9658e99b8c9671af947467dc2234ec6145e8c2