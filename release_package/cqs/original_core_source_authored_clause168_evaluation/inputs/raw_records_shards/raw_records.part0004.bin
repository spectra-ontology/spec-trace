{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":34392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34393},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34395},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination ::=           SEQUENCE {","paragraph_zero_based":34396},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinationId             SlotFormatCombinationId,","paragraph_zero_based":34397},{"literal_text_all_w_t_and_m_t":"    slotFormats                         SEQUENCE (SIZE (1..maxNrofSlotFormatsPerCombination)) OF INTEGER (0..255)","paragraph_zero_based":34398},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34400},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationId ::=         INTEGER (0..maxNrofSlotFormatCombinationsPerSet-1)","paragraph_zero_based":34401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34402},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-STOP","paragraph_zero_based":34403},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34405},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination field descriptions","paragraph_zero_based":34406},{"literal_text_all_w_t_and_m_t":"slotFormatCombinationId","paragraph_zero_based":34407},{"literal_text_all_w_t_and_m_t":"This ID is used in the DCI payload to dynamically select this SlotFormatCombination (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34408},{"literal_text_all_w_t_and_m_t":"slotFormats","paragraph_zero_based":34409},{"literal_text_all_w_t_and_m_t":"Slot formats that occur in consecutive slots in time domain order as listed here (see TS 38.213 [13], clause 11.1.1 and TS 38.213 [13], clause 14 for IAB-MT).","paragraph_zero_based":34410},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34411},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell field descriptions","paragraph_zero_based":34412},{"literal_text_all_w_t_and_m_t":"enableConfiguredUL","paragraph_zero_based":34413},{"literal_text_all_w_t_and_m_t":"If configured, the UE is allowed to transmit uplink signals/channels (SRS, PUCCH, CG-PUSCH) in the set of symbols of the slot when the UE does not detect a DCI format 2_0 providing a slot format for the set of symbols (see TS 38.213 [13], 11.1.1). This field is applicable only if cg-RetransmissionTimer-r16 is configured.","paragraph_zero_based":34414},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d27423ab074a8f9adc1aedde6c23abc9d8c6497fc8c0ad007fb8d112a95091a5","be2168e3958906e74cb89d6b313d5854ef9f29468472afa0dddc56f89f9f81e3","dc03ec7671f9dce88ec628278ad7b1f35679f0d9016105e2ca5b5923c0cc1686","a88d379e41f75862f02278485d478ede71794b3b7cceef9a71a8d87175ff56d4","e456fe69ae9a2f5071c24dbd8206f38d7d18605d148a777f18d95ec02e8228bb","857dc438414bb8ba5c9c6c0d00ab35a68029eb590be9bdec29c539ad8cdc2660","376f911d4c7c765019e16e4f43199899014f9dc79fc2635205195684ca98858d","3bb8ee2c271ce32b64cb0cbf66c28651bf4eb860edd3f6c4350b3032fe23599a","9d7316e48dad9e65b84f8fa6fad178334ca70d5c73ffdd3df398d170c73e427e","28b87248c073a974b211b1cc442289b9017daf6d6891f768daf51c8710af52c9","2d726e8308c66cd71218fbe340e2a0d691b82e9b25c437c400bdb9e634ba626e","92351bd1c74d4e6ef52beeaf5b08f08012dc009e602e8298d25805ea3f141589","ed955efa0bfcd7f55f179b2b226d81154ff7ad226d71847b8a4ba543a4b33446","8f14b0c1e1fa730d65c4babe949428f9bbbb5217832fcd504629b1ee15631bc2","0b3caf654af859820dffd44ba6cfd6089e0760c6f29bcbde8bad8184ada1bbfa","f29867759413210286fc718dfbbb235b225568d1ab8596c5978ee5449f33edf5","af66ded01b0fd53e6516d8f46b5eb67958c257981b3c989e304fadacae053857","03cf83e4aaebe2b4f08405ec0c946815dbb07fc08168f04ada6bd18d5bf16452","4b508797b56fd04c663684464626b455d55ac05145255f56cb73b84e490fe98f","9ed8935e6da4aaffb1273cec29102664af46c574aea9f1d864987be675ace54d","35de484270eab1240de622a398089866ed212ff6ae88475a67e9ddee6045c3ec","250b52558b489588ebcde097c776171a61cd6cdde5fb5434a57bd0c577344a26","3d18c651492d76d62bc5c8670f6f82de53a6824a89aabfbc3e817bbd2785a4d1","d42110b570bee267bb8a2ca8f5b396ecaef36843fa29d2929efe06151bcb0695"],"paragraph_range_zero_based":[34392,34415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34392"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The (starting) position (bit) of the slotFormatCombinationId (SFI-Index) for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34416},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":34417},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the slotFormatCombinations are applicable.","paragraph_zero_based":34418},{"literal_text_all_w_t_and_m_t":"slotFormatCombinations","paragraph_zero_based":34419},{"literal_text_all_w_t_and_m_t":"A list with SlotFormatCombinations. Each SlotFormatCombination comprises of one or more SlotFormats (see TS 38.211 [16], clause 4.3.2). The total number of slotFormats in the slotFormatCombinations list does not exceed 512. ","paragraph_zero_based":34420},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing2","paragraph_zero_based":34421},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for a Slot Format Combination on an FDD or SUL cell (see TS 38.213 [13], clause 11.1.1). For FDD, subcarrierSpacing (SFI-scs) is the reference SCS for DL BWP and subcarrierSpacing2 (SFI-scs2) is the reference SCS for UL BWP. For SUL, subcarrierSpacing (SFI-scs) is the reference SCS for non-SUL carrier and subcarrierSpacing2 (SFI-scs2) is the reference SCS for SUL carrier. The network configures a value that is smaller than or equal to any SCS of configured BWPs of the serving cell that the command applies to. And the network configures a value that is smaller than or equal to the SCS of the serving cell which the UE monitors for SFI indications.","paragraph_zero_based":34422},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":34423},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for this Slot Format Combination. The network configures a value that is smaller than or equal to any SCS of configured BWPs of the serving cell that the command applies to. And the network configures a value that is smaller than or equal to the SCS of the serving cell which the UE monitors for SFI indications (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34425},{"literal_text_all_w_t_and_m_t":"–SlotFormatIndicator","paragraph_zero_based":34426},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatIndicator is used to configure monitoring a Group-Common-PDCCH for Slot-Format-Indicators (SFI).","paragraph_zero_based":34427},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator information element","paragraph_zero_based":34428},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34429},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATINDICATOR-START","paragraph_zero_based":34430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34431},{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator ::=     SEQUENCE {","paragraph_zero_based":34432},{"literal_text_all_w_t_and_m_t":"    sfi-RNTI                    RNTI-Value,","paragraph_zero_based":34433},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSize             INTEGER (1..maxSFI-DCI-PayloadSize),","paragraph_zero_based":34434},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToAddModList  SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF SlotFormatCombinationsPerCell","paragraph_zero_based":34435},{"literal_text_all_w_t_and_m_t":"                                                                                                                              OPTIONAL, -- Need N","paragraph_zero_based":34436},{"literal_text_all_w_t_and_m_t":"    slotFormatCombToReleaseList SEQUENCE (SIZE(1..maxNrofAggregatedCellsPerCellGroup)) OF ServCellIndex                       OPTIONAL, -- Need N","paragraph_zero_based":34437},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":34438},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7024c5ca1c55bf4975fa2c3f8b0368be40fd56f2bb9cc01bb55d6bc5a4178564","0331b6d44ecfd6bdef99ff95765be0be5af9601454888d1e09b67647b1967b4f","87f5899158c30e26bad2ddf15c58e26fddf77fc3986a5c73b8ee8f204ebf63d6","60e20f8df51cc4fe0bf7a45a87bb80f00d04eca7764701a6729e1b8b3d386a49","662a0c42b89faa1cc842b6d9963ee63f44b5ad7c224c52fabe836bf50109c7d0","cc0b7d43193bc057466c11ae6a02cce079424b84b66f7a557b3ed5b52d3e64a3","9c01f5f91cd16eead9c98c5affe42f38f168edbc1ce148bff0561ec6f9f05d9b","f56a13721ca0bd159390e9763e99f0f001d8c088a969d58991ea94f0f3e626b1","b4bcd340057ae4dd8a6cd8d78d1f08b6464270b0ac010de161075f7579f6eb4b","575c39d8d4ccfb5b73481a9ed3644f712e3440733e8f7692670a655e3698dd20","2f97f704466cb5352839a8ff739c69cbc3ac2c47ccc0f06365b1ad048e75a2c5","4ce0991564f90f727d6ba58a6f76ac8f22137241cef9e4f6f6f30b95e296349d","16ed6c5e48076901376bd160d7b8bb458a2b77255de672b5de62e5f6e0642a43","4e3ed476111c3fde8d199cbe4037b8e0bafa8984b21ee4fed03ed37511a934e2","9da7f1d9882745aed5bdd7fc2b649936445b54717f9379b9278b46f19bd6c411","d37d7df78a4226ed7b2b75e0800a43c59e27440a5bd7e08ddeb8a3f36d827d91","87fec3b8c953fdfd06a40d421b0947b949e0cfa789368fb65151efe7060dbcd7","35b30db2a961e70509c64f0a8374d707f53e150637724fad4adc11fe185a5ba9","4d032396b43eff07bf6b77dc4123860571bd34ae990e89854b6f22ed03030bdf","1117bfcba08b5253ce1c9236c3bc1a27c222cac0690774347ec365d83773bbac","f6081066aa6f7576e6880d95b6ff742338a5f53ae0cb4d3f355b99e868a417c6","fb4fa7c22631057fa15c85b3e4cba8fc5f1c4dda4497357a5463f61c98675fcf","2aa5c61b795905076847dbc0f1d48494a8321452d9abce7