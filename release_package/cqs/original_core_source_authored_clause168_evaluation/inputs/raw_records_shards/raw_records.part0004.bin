_t":"TRS-ResourceSet-r17 ::=                SEQUENCE {","paragraph_zero_based":17512},{"literal_text_all_w_t_and_m_t":"    powerControlOffsetSS-r17               ENUMERATED {db-3, db0, db3, db6},","paragraph_zero_based":17513},{"literal_text_all_w_t_and_m_t":"    scramblingID-Info-r17                  CHOICE {","paragraph_zero_based":17514},{"literal_text_all_w_t_and_m_t":"        scramblingIDforCommon-r17              ScramblingId,","paragraph_zero_based":17515},{"literal_text_all_w_t_and_m_t":"        scramblingIDperResourceListWith2-r17   SEQUENCE (SIZE (2)) OF ScramblingId,","paragraph_zero_based":17516},{"literal_text_all_w_t_and_m_t":"        scramblingIDperResourceListWith4-r17   SEQUENCE (SIZE (4)) OF ScramblingId,","paragraph_zero_based":17517},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17518},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b43f56e4ba5a1068e38155229ca51f37383bfc3e777277d3f522a1e48ed92ffd","8194a1b2c20b86ecef5131f6f4244550241482d3f0e4866897240af23b668ef2","562ca0177d883b3fb6e451925ba1bcb204bfff7bbad2eb20b2c4655b7fb3820b","40fddbe5ad1891addb6db3e56eed2cdc586a646064756985a02af0a918d88996","bf5928390ace6f9885e899a04bee9e5ecc6827f12959cc298cb355ef630ccb53","abcb38058866f716d6c24aa274d9dcff8726365fa07e82f5b3d201746cb7b18c","aedec455675a03b6b8123cc91f7adcde45b45d65dcfde1a2f2fe01ae3a8f7eb2","3d62ecdb8ccdece6da65ce2794756fc43d15d229c942a664616f910fe48471ca","6dd1e10b2b23f4cec4e22333e15c1356b68f72152617803269ab4f762945b4e8","a9a7d54b0f70223e5f0f3aedc574b8530f6c117f649b1f2ba4e946a6c7a6edbf","69bc4b4249c42ce81b90243bf814992754a666e2f620d4f2d968bcf372bce513","28