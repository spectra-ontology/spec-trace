eral_text_all_w_t_and_m_t":"}","paragraph_zero_based":28335},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28336},{"literal_text_all_w_t_and_m_t":"MPE-Config-FR2-r17 ::=              SEQUENCE {","paragraph_zero_based":28337},{"literal_text_all_w_t_and_m_t":"    mpe-ProhibitTimer-r17               ENUMERATED {sf0, sf10, sf20, sf50, sf100, sf200, sf500, sf1000},","paragraph_zero_based":28338},{"literal_text_all_w_t_and_m_t":"    mpe-Threshold-r17                   ENUMERATED {dB3, dB6, dB9, dB12},","paragraph_zero_based":28339},{"literal_text_all_w_t_and_m_t":"    numberOfN-r17                       INTEGER(1..4),","paragraph_zero_based":28340},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28341},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7f8dac5cc04cd0223556db6e12a54faaf1ded71733657178f7b379a67011eada","6488387be5b4b432f3882936099cb87db68d26b2c907c722c5644deecdc73581","e6b012b1909d47dbdf515593fa669b7dcb71c85bd0a8580aa9a351a8749633c4","b620b613098fed15ca07058ef115f17269a024b1492ddbeef82af4f53a434795","c285edcfa21002c24461250ddd5d4f02cc9dc80533f0fd696c103840e6cad522","756680b2fede524a8a46a91214827d7be062440c02e965b604e827b98e3c4b55","224217d048ae5722feea058f36db32327479b3384930c83ba4c65ec5a5379bef","98f582ad86c673dc5c8ab5a715a7a6e86ced2077e07462f03f7b888e09a4a65e","8b2c96ce9220baf2ef0bab258f2fb6d67dcd49371a6e3326960a5efe6a252bbb","317d4f8207a8f4ca8b493a896c3520e4e3d4da2b1c5fe15b5da7592228020a6d","567b076cb03529a633d683784b0e663cf4e41b974febe0bae3d8e9d2f4b33f7e","c01c330ea00af59987416855a2251d8b69dd355f0ee