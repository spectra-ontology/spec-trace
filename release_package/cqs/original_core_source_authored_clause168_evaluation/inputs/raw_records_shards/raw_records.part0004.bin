{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-Config is used to specify the RLC configuration of sidelink DRB. RLC AM configuration is only applicable to the unicast NR sidelink communication.","paragraph_zero_based":47088},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config information element","paragraph_zero_based":47089},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47090},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-START","paragraph_zero_based":47091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47092},{"literal_text_all_w_t_and_m_t":"SL-RLC-Config-r16 ::=                        CHOICE {","paragraph_zero_based":47093},{"literal_text_all_w_t_and_m_t":"    sl-AM-RLC-r16                                SEQUENCE {","paragraph_zero_based":47094},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthAM-r16                      SN-FieldLengthAM                               OPTIONAL,   -- Cond SLRBSetup","paragraph_zero_based":47095},{"literal_text_all_w_t_and_m_t":"        sl-T-PollRetransmit-r16                      T-PollRetransmit,","paragraph_zero_based":47096},{"literal_text_all_w_t_and_m_t":"        sl-PollPDU-r16                                   PollPDU,","paragraph_zero_based":47097},{"literal_text_all_w_t_and_m_t":"        sl-PollByte-r16                                  PollByte,","paragraph_zero_based":47098},{"literal_text_all_w_t_and_m_t":"        sl-MaxRetxThreshold-r16                          ENUMERATED { t1, t2, t3, t4, t6, t8, t16, t32 },","paragraph_zero_based":47099},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47100},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":47101},{"literal_text_all_w_t_and_m_t":"    sl-UM-RLC-r16                                SEQUENCE {","paragraph_zero_based":47102},{"literal_text_all_w_t_and_m_t":"        sl-SN-FieldLengthUM-r16                      SN-FieldLengthUM                               OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":47103},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47104},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":47105},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47106},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47108},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RLC-CONFIG-STOP","paragraph_zero_based":47109},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b2516fb8b83bb60d7a03fddf19d00ce4047e39baee1d6c007f240e5b9b914266","ca1112a27dd4f7f853ce91f32a3da2526f1333e88642133ec40c92fc85a6cd84","5f3073b12b2ba22086da30807951ab33b6a37b959f0754ef1a67338761788dbf","e7bff3a684ee314a670fbdeed5ba8f1a3072ea22c7e82e710b67d7905d5ff11f","b9784deb49b0e176b67b3f3d82d361c1f0042b5e7a08ef5a4d42bc08329f26d7","a00c1e2835ac6d664c099761efa783dca2416c2e18ac477b44febe55c871a8d9","628e7e49c7e7056ed0d274c268ca242da30ebe0f27eaa98df6d74ea4ed7f3df6","08c1b6df54fb9b929a69f6e778faa941d9d537dcbf9803b5712859380a1270e0","8fe7d6ef3063e779e60a4661f423c4e957b5b51e3b7efd42972c9ea3ad995d53","5cdb136ac1b4ce783d5e5b067920fdbc03d22e16efbdd09e356f14cebf7786ed","ed9bc4e7198ea8bb0e12ef13dd50eb71b7fe5b0265eb52d082f39485fdd24474","7369c6d612c6a86c2f7fb83e99f92e1ca5db1ad7db77e070dd0c2f9f484d5f6b","acb9093b2a2dff54de8fa22b4f011e799582596e8157dccdfa765eea706e8eb9","54d151eb18ca548f77bfe4f0cec53ed7de969bb73c86dceb94b083c95ce144a2","7d4eefced37b5b163373227dd4d40086c4eb03ef34679c0bf64428455d35db2f","668d2ff4d363a2033f3fe22824dcf0f05461f812b50a6b50656e4ad53bb56741","754d0a889ce05fefdae009ac02159cd7964a75b6d87cbd89c21ad2c580ca941d","6b307d286617bf6686d096bc75c6b6a1f5cff0d5468e21db0bc11fe134ec5cc1","72f74856a79fcfc69a83458e9bdd1a4570daf30a46fe080469ed33a0e722b5bb","5f2dfae6fb48e3dd082134f3bf04163a836b3dea659684c356bc7bcba2a3641a","aa1bf9394f9aaec2cfddab856f11cf3fa62d59c9fb8b2585efd9662a1bedb88c","a81523278a4dae89d9e339356ffec78661f7f069830ab1d6bd9e037140f22f04","b18f707170f6b627be4282151ad3ec284e1f66f64be098b1ba35d72cd859eb89","727e0ef0f83757340f0d3219bd671fe6761b709e92893c300407b13e9b647a20"],"paragraph_range_zero_based":[47088,47111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p47088"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RLC-Config field descriptions","paragraph_zero_based":47112},{"literal_text_all_w_t_and_m_t":"sl-MaxRetxThreshold","paragraph_zero_based":47113},{"literal_text_all_w_t_and_m_t":"Parameter value of maxRetxThreshold for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value t1 corresponds to 1 retransmission, value t2 corresponds to 2 retransmissions and so on.","paragraph_zero_based":47114},{"literal_text_all_w_t_and_m_t":"sl-PollByte","paragraph_zero_based":47115},{"literal_text_all_w_t_and_m_t":"Parameter value of pollByte for RLC AM for NR sidelink communications, see TS 38.322 [4]. Value kB25 corresponds to 25 kBytes, value kB50 corresponds to 50 kBytes and so on. infinity corresponds to an infinite amount of kBytes.","paragraph_zero_based":47116},{"literal_text_all_w_t_and_m_t":"sl-PollPDU","paragraph_zero_based":47117},{"literal_text_all_w_t_and_m_t":"Parameter value of pollPDU for RLC AM for NR sidelink communications, seeTS 38.322 [4]. Value p4 corresponds to 4 PDUs, value p8 corresponds to 8 PDUs and so on. infinity corresponds to an infinite number of PDUs.","paragraph_zero_based":47118},{"literal_text_all_w_t_and_m_t":"sl-SN-FieldLength","paragraph_zero_based":47119},{"literal_text_all_w_t_and_m_t":"This field indicates the RLC SN field size for NR sidelink communication, see TS 38.322 [4]. For groupcast and broadcast, only value size6 (6 bits) is configured for the field sl-SN-FieldLengthUM.","paragraph_zero_based":47120},{"literal_text_all_w_t_and_m_t":"sl-T-PollRetransmit","paragraph_zero_based":47121},{"literal_text_all_w_t_and_m_t":"Timer value of t-PollRetransmit for RLC AM for NR sidelink communications, see TS 38.322 [4], in milliseconds. Value ms5 means 5 ms, value ms10 means 10 ms and so on.","paragraph_zero_based":47122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47123},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47124},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47125},{"literal_text_all_w_t_and_m_t":"SLRBSetup","paragraph_zero_based":47126},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via the dedicated signalling and in case of sidelink DRB  configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":47127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47128},{"literal_text_all_w_t_and_m_t":"–SL-ScheduledConfig","paragraph_zero_based":47129},{"literal_text_all_w_t_and_m_t":"The IE SL-ScheduledConfig specifies sidelink communication/positioning configurations used for network scheduled NR sidelink communication/positioning.","paragraph_zero_based":47130},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig information element","paragraph_zero_based":47131},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47132},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SCHEDULEDCONFIG-START","paragraph_zero_based":47133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47134},{"literal_text_all_w_t_and_m_t":"SL-ScheduledConfig-r16 ::=                   SEQUENCE {","paragraph_zero_based":47135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["01f09127e7fad4621ad9ff195d1700c81c3b7f119d53807515fd850bfc6206fb","fbe4dc11dcdb5e1c8fde1dea9d5212bc60215aeca520cb12d722b45dc12a6684","4e1e5afac71c4e3b447d8145c3b7006e0578875a62fa3f5c06ba488bf8d550e0","d33c58ac78e8dd190d5652c084cf63e78fc258e5d99086c5efd7e5b64