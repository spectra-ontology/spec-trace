{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46561},{"literal_text_all_w_t_and_m_t":"SL-ReportConfig field descriptions","paragraph_zero_based":46562},{"literal_text_all_w_t_and_m_t":"sl-ReportType","paragraph_zero_based":46563},{"literal_text_all_w_t_and_m_t":"Type of the configured sidelink measurement report.","paragraph_zero_based":46564},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46565},{"literal_text_all_w_t_and_m_t":"SL-EventTriggerConfig field descriptions","paragraph_zero_based":46566},{"literal_text_all_w_t_and_m_t":"sl-EventId","paragraph_zero_based":46567},{"literal_text_all_w_t_and_m_t":"Choice of sidelink measurement event triggered reporting criteria.","paragraph_zero_based":46568},{"literal_text_all_w_t_and_m_t":"sl-ReportAmount","paragraph_zero_based":46569},{"literal_text_all_w_t_and_m_t":"Number of sidelink measurement reports applicable for sl-EventTriggered report type.","paragraph_zero_based":46570},{"literal_text_all_w_t_and_m_t":"sl-ReportInterval","paragraph_zero_based":46571},{"literal_text_all_w_t_and_m_t":"Indicates the interval between periodical reports (i.e., when sl-ReportAmount exceeds 1) for sl-EventTriggered report type.","paragraph_zero_based":46572},{"literal_text_all_w_t_and_m_t":"sl-ReportOnLeave","paragraph_zero_based":46573},{"literal_text_all_w_t_and_m_t":"indicates whether or not the UE shall initiate the sidelink measurement reporting procedure when the leaving condition is met for a frequency in sl-FrequencyTriggeredList, as specified in 5.8.10.4.1.","paragraph_zero_based":46574},{"literal_text_all_w_t_and_m_t":"sl-ReportQuantity","paragraph_zero_based":46575},{"literal_text_all_w_t_and_m_t":"The sidelink measurement quantities to be included in the sidelink measurement r