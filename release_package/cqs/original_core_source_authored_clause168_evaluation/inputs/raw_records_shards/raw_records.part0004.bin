{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–CSI-RS-ResourceConfigMobility","paragraph_zero_based":21888},{"literal_text_all_w_t_and_m_t":"The IE CSI-RS-ResourceConfigMobility is used to configure CSI-RS based RRM measurements.","paragraph_zero_based":21889},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility information element","paragraph_zero_based":21890},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21891},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCECONFIGMOBILITY-START","paragraph_zero_based":21892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21893},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility ::=   SEQUENCE {","paragraph_zero_based":21894},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":21895},{"literal_text_all_w_t_and_m_t":"    csi-RS-CellList-Mobility            SEQUENCE (SIZE (1..maxNrofCSI-RS-CellsRRM)) OF CSI-RS-CellMobility,","paragraph_zero_based":21896},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21897},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21898},{"literal_text_all_w_t_and_m_t":"    refServCellIndex                    ServCellIndex                                                           OPTIONAL    -- Need S","paragraph_zero_based":21899},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21901},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21902},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21903},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21904},{"literal_text_all_w_t_and_m_t":"CSI-RS-CellMobility ::=             SEQUENCE {","paragraph_zero_based":21905},{"literal_text_all_w_t_and_m_t":"    cellId                              PhysCellId,","paragraph_zero_based":21906},{"literal_text_all_w_t_and_m_t":"    csi-rs-MeasurementBW                SEQUENCE {","paragraph_zero_based":21907},{"literal_text_all_w_t_and_m_t":"        nrofPRBs                            ENUMERATED { size24, size48, size96, size192, size264},","paragraph_zero_based":21908},{"literal_text_all_w_t_and_m_t":"        startPRB                            INTEGER(0..2169)","paragraph_zero_based":21909},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21910},{"literal_text_all_w_t_and_m_t":"    density                             ENUMERATED {d1,d3}                                                      OPTIONAL,   -- Need R","paragraph_zero_based":21911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4d2e61b7f79902ca837e11b5903ec7cb6ce498e5d7f54348bd764acecf705569","68d3870af8ffbb8eb8a3abf7f4f82f0649dfc993bcb0ab1f214beb1275f4ff82","6e3fab7e5270b1381abc6ab3759065217685d82933599abdd4d80600faa75592","1d7099c4ca7232455ce057073598091b2ac522482450920cc60413c4ccad4b5f","5b9b426328e69a8bcf3a214ce5c50f9051b3c47ec6da3a87b764875c02a9e9ba","2dacd7521959493df01176a4cf491b9f42bddc6ab92e8834cd2177cc7251f172","74e8af3296acba4621fa52b8ddc1fea4e51797d3672523a5e936361e97beb05a","130c40e7e9e850673c2dfc8f0f434ee8b12dbeaf92f631d2216896d315518bce","05fee7709bf140551ccc2e0376f724b5981c214dd5ea79482a43998197d88e0b","5b0dd3bb94cc46949ea18595a7e049a7bac9ccc6fc7d7ee4a375cc197cae2090","1ea66e3bc737080b828efc95934c0710fb94db1387b0b50be680fa4ce6d0dffd","685cf7a12b33b446ab0b5581ae434bac412d48d9686d7fa73297c267ba1b491c","774cefa53d4875701e3bcec112cc6c8f466e4d70f523bdd1f35f8d4e571a8060","5cd807d43