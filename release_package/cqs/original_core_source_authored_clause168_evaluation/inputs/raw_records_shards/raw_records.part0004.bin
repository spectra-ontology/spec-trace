{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        sl-MaxDataBurstVolume-r16     INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":46248},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46249},{"literal_text_all_w_t_and_m_t":"   }","paragraph_zero_based":46250},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46252},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-STOP","paragraph_zero_based":46253},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46255},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile field descriptions","paragraph_zero_based":46256},{"literal_text_all_w_t_and_m_t":"sl-GFBR","paragraph_zero_based":46257},{"literal_text_all_w_t_and_m_t":"Indicate the guaranteed bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":46258},{"literal_text_all_w_t_and_m_t":"sl-MFBR","paragraph_zero_based":46259},{"literal_text_all_w_t_and_m_t":"Indicate the maximum bit rate for a GBR QoS flow. The unit is: Kbit/s","paragraph_zero_based":46260},{"literal_text_all_w_t_and_m_t":"sl-PQI","paragraph_zero_based":46261},{"literal_text_all_w_t_and_m_t":"This field indicates either the PQI for standardized PQI or non-standardized QoS parameters.","paragraph_zero_based":46262},{"literal_text_all_w_t_and_m_t":"sl-Range","paragraph_zero_based":46263},{"literal_text_all_w_t_and_m_t":"This field indicates the range parameter of the Qos flow, as defined in clause 5.4.1.1.1, TS 23.287 [55]. It is present only for groupcast. The unit is meter.","paragraph_zero_based":46264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46265},{"literal_text_all_w_t_and_m_t":"SL-PQI field descriptions","paragraph_zero_based":46266},{"literal_text_all_w_t_and_m_t":"sl-AveragingWindow","paragraph_zero_based":46267},{"literal_text_all_w_t_and_m_t":"Indicates the Averaging Window for a QoS flow, and applies to GBR QoS flows only. Unit: ms. The default value of the IE is 2000ms.","paragraph_zero_based":46268},{"literal_text_all_w_t_and_m_t":"sl-MaxDataBurstVolume","paragraph_zero_based":46269},{"literal_text_all_w_t_and_m_t":"Indicates the Maximum Data Burst Volume for a QoS flow, and applies to delay critical GBR QoS flows only. Unit: byte.","paragraph_zero_based":46270},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":46271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5a4331e2cd023ad88c316e475cbabbc62f8e48b308f39fa6a9dbce68a1bd5723","4a46ae9174b6150d004a44845fe72882f5dc573dd9e8f18b370b891a7fd48a7a","af9ef5cfec26a13f08dff46746cd83ff91b024bfc18478174ae00082342d5a38","af2c6603538762c61cc051ff5d3fc42ad00be0e06ff1201cfb41598d9783d240","6c375b9947683309c028c0a8d840a4b07c4b19382e24952e2a10bfa0dd485869","ce4651e4d509574e47aabde404d56659fcb76e261044aa2b555b30a6017c82b3","36f36c216867ba21c8734321cd9a291beddaf62486d90c4079f4fdf4174cc277","e63d30aae65daf59e26a8b0d0eb046457d8ba5800fc8be6794b508f5bf06ebee","d2af6f2b37ccfa04757b8cb43876750c0aa68ed04e4e419088edc8f065ea614e","6f0e5cb11b1fb93046c05bd22d7235ab0aeb1473d0db146337fa07d4e92ed4a2","e3479249fb3589fcb9427b3c260413f0d87077a717194b1d2ccae2d844176313","bab20bb3bddebe5e52eb048df9ac51712cac29a98d7b224442859aeb49ad25d9","04e1014380fc16638405608e27d37822b80f81c3cea6600952d9367506b6a464","7b2d155f8c0662ae0c0286339c09dc2a024237330fafe0d836d3a39a8e97a76e","7459a4bc20ff3e7398aedda048971559d16b32d8af490891711b6f9aec4f2616","6b85d4299847f1170705c6b8a5ce15befa4acb8aead0f32a5ef546bb69d0aceb","a9a9cde24afdc9ec6f0420db7e09c973600362f465ebbf35656e3e1f6c050545","426b4bad1bc768e23463d10acc091316c5d7ac08782adc3091122caa8eda4483","16219f90e73785d4e19430c465d2b232749e4f6cb22e4d6aba949d8204681644","86079b139fa6e2a0442e0fefab6c7f8eda40223c83bca91399621417936613bc","a2ebadbd3a6866f591754d25a990bae340bf030990d950fb9726ea042257cf72","73270c5fe2bf7854f7ae3d46271b99f2d20ec66ccf5eb9139f56a3968637c1df","0f78345ac4113675aa9552f16f7edda97361d3ce274d9ef5e85e55e2290f3959","5514b83361f363d9bbb5348066e92eef0fac33470102a3a93097d07460e8839b"],"paragraph_range_zero_based":[46248,46271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46248"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a QoS flow. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":46272},{"literal_text_all_w_t_and_m_t":"sl-PacketErrorRate","paragraph_zero_based":46273},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Error Rate for a QoS flow. The packet error rate is expressed as Scalar x 10-k where k is the Exponent.","paragraph_zero_based":46274},{"literal_text_all_w_t_and_m_t":"sl-PriorityLevel","paragraph_zero_based":46275},{"literal_text_all_w_t_and_m_t":"Indicates the Priority Level for a QoS flow. Values ordered in decreasing order of priority, i.e. with 1 as the highest priority and 8 as the lowest priority.","paragraph_zero_based":46276},{"literal_text_all_w_t_and_m_t":"sl-StandardizedPQI","paragraph_zero_based":46277},{"literal_text_all_w_t_and_m_t":"Indicate the PQI for standardized PQI.","paragraph_zero_based":46278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46279},{"literal_text_all_w_t_and_m_t":"–SL-QuantityConfig","paragraph_zero_based":46280},{"literal_text_all_w_t_and_m_t":"The IE SL-QuantityConfig specifies the layer 3 filtering coefficients for NR SL RSRP measurement for a destination.","paragraph_zero_based":46281},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig information element","paragraph_zero_based":46282},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46283},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QUANTITYCONFIG-START","paragraph_zero_based":46284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46285},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig-r16 ::=               SEQUENCE {","paragraph_zero_based":46286},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientDMRS-r16            FilterCoefficient                             DEFAULT fc4,","paragraph_zero_based":46287},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46288},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46290},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QuantityConfig-STOP","paragraph_zero_based":46291},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46293},{"literal_text_all_w_t_and_m_t":"SL-QuantityConfig field descriptions","paragraph_zero_based":46294},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficientDMRS","paragraph_zero_based":46295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f6c2c491c0b3dd3fdb0cb4154c471bd134d3e8fe6f1750051b0d5319791ef3aa","f44772f5a00fd3d9eff45b88dd45f1048ca2c59513347028238faf9a842d7555","b443d18f496a0737cc6f0f0bd3ed77a05f91f9aae370b08140d7230ef35d81d8","6c428a4eeb999b346b575c3aa9991e87d2b08d82362016e0715130c517e12b1a","5524faba02e1b2c36d78777252cc09d949ba23418235a229fe2e229be2ee59e2","d8d0375a51442cbf19671ec029d152c4fc45e0df5958dbb530446a9366ca2b4f","ca68bc5802d2a0e09e21765d84355e79785edace02b2654a0770df33e0e800b8","2c033c430d9d732173b96c2b0947e092811f11e983ad5ede43348ecc2ac3cb83","108faf2a98f24462a6af3ce0618abe23ec6335eb55c0bd169af825f79f9979b7","e6021f560f4f6bb2318dc317bf477c6b1ac9fd75300b404b917fba5a6729c03d","075867df991b824938116e30801f550a2e99e730ce30b7ad382d95a6b1c9a5aa","3aa0c7a7082929ed00c45492d41e47116220157d1dfc63017034744854d880da","743409e693107fd4dbce8cc62095e047d814fcde7afcc21d6a795f41baaf6838","235e0b9898b3d6d71890cd29da1d5c302fab698970da614babea4557e38e3fae","6a27b6cadf1d946