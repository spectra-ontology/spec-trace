ased":36040},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":36041},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":36042},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36043},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36044},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36045},{"literal_text_all_w_t_and_m_t":"RelayLCH-Setup","paragraph_zero_based":36046},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":36047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c95c5fc50c518717366ecdd596f0eae92ab263adfae24bca5f782e0d8654e41e","51160407a93748469384cb8755efb3f48b5901a836ce8bf389936cdb8e6da796","86151c870f45b5a3c43a74097c7d3e87d4992f570ba2485931faa5ae0650fc82","ca6b92fc90363cd90577db6f865d46b809fc6b7a554c282cb20109ea8ae41312","71d639d0018d39d7e9ccde90ce8d026b3ffe0c9ab8c8feac8cc47920cf930f35","98e82de32b96ea8bbfeb17f0c6b9bde0d1245c120190f068237903e8805645b5","5d1219c657398a1f5c28e4c000654ad4df8e033fe3eaa574c0dfe4369cac9d30","493400dd90495ae40227c14ba18cdda87e790f5b70113f2545424effbb05c5b5","e30095c0a84a0998d3325b5f72a16c585438dc2d2a7a4238cc90a96e038a633e","bd9c9fd775c5ddecc4f1bdb4f473345989bb855aa77945c48ca34375560dc2a4","a1e753113c88b291a0c2e4277e0e98377bebd4649290bcde80bc458daa04fa9b","960744de4b229eac02c982c3b656bd003942dc7839cff053588df0b16401f0da","29850888928c7742c4e65779bd061248a24bfb79c438bf39ea0df033e18ab955","6285543fdc08a430af62c8407925caaa313ef6