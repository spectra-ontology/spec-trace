{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to send delay budget reports in accordance with 5.7.4;","paragraph_zero_based":2712},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2713},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to send delay budget reports and stop timer T342, if running.","paragraph_zero_based":2714},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the overheatingAssistanceConfig:","paragraph_zero_based":2715},{"literal_text_all_w_t_and_m_t":"2>if overheatingAssistanceConfig is set to setup:","paragraph_zero_based":2716},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide overheating assistance information in accordance with 5.7.4;","paragraph_zero_based":2717},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2718},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide overheating assistance information and stop timer T345, if running;","paragraph_zero_based":2719},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the idc-AssistanceConfig:","paragraph_zero_based":2720},{"literal_text_all_w_t_and_m_t":"2>if idc-AssistanceConfig is set to setup:","paragraph_zero_based":2721},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide IDC assistance information in accordance with 5.7.4;","paragraph_zero_based":2722},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2723},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide IDC assistance information;","paragraph_zero_based":2724},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the drx-PreferenceConfig:","paragraph_zero_based":2725},{"literal_text_all_w_t_and_m_t":"2>if drx-PreferenceConfig is set to setup:","paragraph_zero_based":2726},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on DRX parameters for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2727},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2728},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide its preference on DRX parameters for power saving for the cell group and stop timer T346a associated with the cell group, if running;","paragraph_zero_based":2729},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the maxBW-PreferenceConfig:","paragraph_zero_based":2730},{"literal_text_all_w_t_and_m_t":"2>if maxBW-PreferenceConfig is set to setup:","paragraph_zero_based":2731},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide its preference on the maximum aggregated bandwidth for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2732},{"literal_text_all_w_t_and_m_t":"3>if otherConfig includes maxBW-PreferenceConfigFR2-2:","paragraph_zero_based":2733},{"literal_text_all_w_t_and_m_t":"4>consider itself to be configured to provide its preference on the maximum aggregated bandwidth for FR2-2 for power saving for the cell group in accordance with 5.7.4;","paragraph_zero_based":2734},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["40098628c7cd0a5a5fc87700e58ea3af89223412b76de7766040eb59024cd645","27d30a638daea54608c79383fc5ac413638b586e6b23fd1739cb841364984ca8","1f92ca2aca31a533aa05971a19b623b64e