{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5496},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":5497},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the reportConfigToRemoveList includes any reportConfigId value that is not part of the current UE configuration.","paragraph_zero_based":5498},{"literal_text_all_w_t_and_m_t":"5.5.2.7Reporting configuration addition/modification","paragraph_zero_based":5499},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5500},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToAddModList:","paragraph_zero_based":5501},{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching reportConfigId exists in the reportConfigList within the VarMeasConfig, for this entry:","paragraph_zero_based":5502},{"literal_text_all_w_t_and_m_t":"3>reconfigure the entry with the value received for this reportConfig;","paragraph_zero_based":5503},{"literal_text_all_w_t_and_m_t":"3>for each measId associated with this reportConfigId included in the measIdList within the VarMeasConfig, if any:","paragraph_zero_based":5504},{"literal_text_all_w_t_and_m_t":"4>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5505},{"literal_text_all_w_t_and_m_t":"4>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":5506},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5507},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received reportConfig to the reportConfigList within the VarMeasConfig.","paragraph_zero_based":5508},{"literal_text_all_w_t_and_m_t":"5.5.2.8Quantity configuration","paragraph_zero_based":5509},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5510},{"literal_text_all_w_t_and_m_t":"1>for each RAT for which the received quantityConfig includes parameter(s):","paragraph_zero_based":5511},{"literal_text_all_w_t_and_m_t":"2>set the corresponding parameter(s) in quantityConfig within VarMeasConfig to the value of the received quantityConfig parameter(s);","paragraph_zero_based":5512},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":5513},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5514},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":5515},{"literal_text_all_w_t_and_m_t":"5.5.2.9Measurement gap configuration","paragraph_zero_based":5516},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5517},{"literal_text_all_w_t_and_m_t":"1>if gapFR1 is set to setup:","paragraph_zero_based":5518},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap configuration configured by gapFR1 is already setup, release the FR1 measurement gap configuration;","paragraph_zero_based":5519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc