{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if MR-DC is configured:","paragraph_zero_based":3744},{"literal_text_all_w_t_and_m_t":"3>perform MR-DC release, as specified in clause 5.3.5.10;","paragraph_zero_based":3745},{"literal_text_all_w_t_and_m_t":"2>perform the LTM configuration release procedure for the MCG and the SCG as specified in clause 5.3.5.18.7;","paragraph_zero_based":3746},{"literal_text_all_w_t_and_m_t":"2>release delayBudgetReportingConfig, if configured and stop timer T342, if running;","paragraph_zero_based":3747},{"literal_text_all_w_t_and_m_t":"2>release overheatingAssistanceConfig, if configured and stop timer T345, if running;","paragraph_zero_based":3748},{"literal_text_all_w_t_and_m_t":"2>release idc-AssistanceConfig, if configured;","paragraph_zero_based":3749},{"literal_text_all_w_t_and_m_t":"2>release btNameList, if configured;","paragraph_zero_based":3750},{"literal_text_all_w_t_and_m_t":"2>release wlanNameList, if configured;","paragraph_zero_based":3751},{"literal_text_all_w_t_and_m_t":"2>release sensorNameList, if configured;","paragraph_zero_based":3752},{"literal_text_all_w_t_and_m_t":"2>release drx-PreferenceConfig for the MCG, if configured and stop timer T346a associated with the MCG, if running;","paragraph_zero_based":3753},{"literal_text_all_w_t_and_m_t":"2>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":3754},{"literal_text_all_w_t_and_m_t":"2>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":3755},{"literal_text_all_w_t_and_m_t":"2>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":3756},{"literal_text_all_w_t_and_m_t":"2>release minSchedulingOffsetPreferenceConfig for the MCG, if configured stop timer T346e associated with the MCG, if running;","paragraph_zero_based":3757},{"literal_text_all_w_t_and_m_t":"2>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":3758},{"literal_text_all_w_t_and_m_t":"2>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":3759},{"literal_text_all_w_t_and_m_t":"2>release releasePreferenceConfig, if configured stop timer T346f, if running;","paragraph_zero_based":3760},{"literal_text_all_w_t_and_m_t":"2>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":3761},{"literal_text_all_w_t_and_m_t":"2>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":3762},{"literal_text_all_w_t_and_m_t":"2>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":3763},{"literal_text_all_w_t_and_m_t":"2>release obtainCommonLocation, if configured;","paragraph_zero_based":3764},{"literal_text_all_w_t_and_m_t":"2>release musim-GapAssistanceConfig, if configured and stop timer T346h, if running;","paragraph_zero_based":3765},{"literal_text_all_w_t_and_m_t":"2>release musim-GapPriorityAssistanceConfig, if configured;","paragraph_zero_based":3766},{"literal_text_all_w_t_and_m_t":"2>release musim-LeaveAssistanceConfig, if configured;","paragraph_zero_based":3767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["836a37ad623614ddb7dbae5364198a27a57c8e08dfbc85247e1df743ca18cc6a","