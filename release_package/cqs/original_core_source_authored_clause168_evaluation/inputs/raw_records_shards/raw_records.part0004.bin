{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if either the received value of messageIdentifier or of serialNumber, or of both messageIdentifier and serialNumber are different from the current values of messageIdentifier and serialNumber for SIB7:","paragraph_zero_based":1032},{"literal_text_all_w_t_and_m_t":"2>use the received values of messageIdentifier and serialNumber for SIB7 as the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1033},{"literal_text_all_w_t_and_m_t":"2>discard any previously buffered warningMessageSegment;","paragraph_zero_based":1034},{"literal_text_all_w_t_and_m_t":"2>if all segments of a warning message have been received:","paragraph_zero_based":1035},{"literal_text_all_w_t_and_m_t":"3>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":1036},{"literal_text_all_w_t_and_m_t":"3>forward the received warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1037},{"literal_text_all_w_t_and_m_t":"3>stop reception of SIB7;","paragraph_zero_based":1038},{"literal_text_all_w_t_and_m_t":"3>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1039},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1040},{"literal_text_all_w_t_and_m_t":"3>store the received warningMessageSegment;","paragraph_zero_based":1041},{"literal_text_all_w_t_and_m_t":"3>continue reception of SIB7;","paragraph_zero_based":1042},{"literal_text_all_w_t_and_m_t":"1>else if all segments of a warning message have been received:","paragraph_zero_based":1043},{"literal_text_all_w_t_and_m_t":"2>assemble the warning message from the received warningMessageSegment(s);","paragraph_zero_based":1044},{"literal_text_all_w_t_and_m_t":"2>forward the received complete warning message, messageIdentifier, serialNumber and dataCodingScheme to upper layers;","paragraph_zero_based":1045},{"literal_text_all_w_t_and_m_t":"2>stop reception of SIB7;","paragraph_zero_based":1046},{"literal_text_all_w_t_and_m_t":"2>discard the current values of messageIdentifier and serialNumber for SIB7;","paragraph_zero_based":1047},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1048},{"literal_text_all_w_t_and_m_t":"2>store the received warningMessageSegment;","paragraph_zero_based":1049},{"literal_text_all_w_t_and_m_t":"2>continue reception of SIB7;","paragraph_zero_based":1050},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored warningMessageSegment and the current value of messageIdentifier and serialNumber for SIB7 if the complete warning message has not been assembled within a period of 3 hours.","paragraph_zero_based":1051},{"literal_text_all_w_t_and_m_t":"5.2.2.4.9Actions upon reception of SIB8","paragraph_zero_based":1052},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB8 the UE shall:","paragraph_zero_based":1053},{"literal_text_all_w_t_and_m_t":"1>if the SIB8 contains a complete warning message and the complete geographical area coordinates (if any):","paragraph_zero_based":1054},{"literal_text_all_w_t_and_m_t":"2>forward the received warning message, messageIdentifier, serialNumber, dataCodingScheme and the geographical area coordinates (if any) to upper layers;","paragraph_zero_based":1055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f8f92c6b25bad94d054406d9becfbb4d2d1d82831d5d8303ddce68706a25f201","c3a946d542027f1a9d85af8206b3ab6c819b1f09452ad7e0104be5f74a488365","5fe