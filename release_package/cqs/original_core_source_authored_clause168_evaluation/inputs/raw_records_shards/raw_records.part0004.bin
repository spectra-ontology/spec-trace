{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46056},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46057},{"literal_text_all_w_t_and_m_t":"SL-PRS-TxConfigIndex-r18 ::=    INTEGER (0.. maxNrofSL-PRS-TxConfig-r18)","paragraph_zero_based":46058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46059},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PRS-RESOURCEPOOL-STOP","paragraph_zero_based":46060},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46061},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46062},{"literal_text_all_w_t_and_m_t":"SL-PRS-ResourcePool field descriptions","paragraph_zero_based":46063},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficient","paragraph_zero_based":46064},{"literal_text_all_w_t_and_m_t":"This field indicates the filtering coefficient for long-term measurement and reference signal power derivation used for sidelink open-loop power control.","paragraph_zero_based":46065},{"literal_text_all_w_t_and_m_t":"sl-ThreshS-RSSI-PRS-CBR","paragraph_zero_based":46066},{"literal_text_all_w_t_and_m_t":"Indicates the S-RSSI threshold for determining the contribution of a sub-channel to the SL-PRS CBR measurement in a dedicated SL-PRS resource pool. Value 0 corresponds to -112 dBm, value 1 to -110 dBm, value n to (-112 + n*2) dBm, and so on.","paragraph_zero_based":46067},{"literal_text_all_w_t_and_m_t":"sl-RB-Number","paragraph_zero_based":46068},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs in the corresponding SL PRS dedicated resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":46069},{"literal_text_all_w_t_and_m_t":"sl-StartRB-Subchannel-DedicatedSL-PRS-RP","paragraph_zero_based":46070},{"literal_text_all_w_t_and_m_t":"Indicates the lowest RB index of the SL PRS dedicated resource pool with respect to the lowest RB index of a SL BWP.","paragraph_zero_based":46071},{"literal_text_all_w_t_and_m_t":"sl-TimeResource","paragraph_zero_based":46072},{"literal_text_all_w_t_and_m_t":"This field indicates the bitmap of the SL PRS dedicated resource pool, which is defined by repeating the bitmap with a periodicity during a SFN or DFN cycle.","paragraph_zero_based":46073},{"literal_text_all_w_t_and_m_t":"sl-PosAllowedResourceSelectionConfig","paragraph_zero_based":46074},{"literal_text_all_w_t_and_m_t":"Indicates allowed resource allocation method configured per resource pool.","paragraph_zero_based":46075},{"literal_text_all_w_t_and_m_t":"C1: only sensing allowed","paragraph_zero_based":46076},{"literal_text_all_w_t_and_m_t":"c2: only random resource selection allowed","paragraph_zero_based":46077},{"literal_text_all_w_t_and_m_t":"c3: sensing and random resource selection allowed","paragraph_zero_based":46078},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourceReservePeriodList","paragraph_zero_based":46079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fbd782e4761710747d96aabeafe1aaf731c1c297ec6ca584c96f44ddb908a194","62f8003fde0c95acbcc687bcbc1cbf902765faf1a35c6a44cde729bc51ee38e3","15faa0593c4d986ed07364a9dd8c6764e2b2cde89c5369bfb78f89cd3cba3e66","1c428e987683329a0144730ba8d0f0c9272378adf4ed99b9dab99a5b1757dfc0","69b2c5f8c98635b80377995fdd844b7185c5336e882e1ca999fe232b9505a1de","6cbf40b184159dd0bbfd4d8ec74feac34f8f25f4ba2f30c6ab0d442fd56ea987","4cb28f8bd5385f5ba483d64f23617d5959f4dc5ea838f9f0956b5d4ea602fce5","b2203e4c25bd94d140379816ddfd5bca8ebac37c4d03c6fa8828e636e189bc7d","13ad108e39b6657a1ced2db85cd083966a418b9335c24d0fe5fe876db7b62da7","d80cdfdbb0f05f3bf0c1eb3156023f39f3d3a7d9b85ce447b1d7cac37659e33d","cdfa716e3fe67018fa912d78841e20b02c05afd3739ac1cbaac5e8fe7df49f66","3be3b370933a0d6b13ce2edc94bd5edaf41fdc076c26e4eb4972b204c4ef2da5","983abbe2de7dfc1204ebdea3b92539c5b4be0166927a6bde7d3a0c3859734f11","87c0569b1325fdf170a303ff9c21be6a0699e797ed8ee92e051088b4149020e8","ce4c1fa394e8eadbf0090f3136ed4acce853b53934f849608a10a424aac7c76f","0ea33ce153f79aaba977f52781f4b9553f7b006cc035f47849c6ac4ef0c102ca","c187161cf9a44ac4c9b17f3356d1ee31947bfa3b31230de70202a15d17331449","db0bd11d44f38dfc4847248085657f1850c556a86786e9cd3958614b70521ab1","a5cc66e79bced91d39dc6e048f71c5fe29aaec7a071110adb60f24af214e706c","29c0cd5ce4f81df15e1cfe6fae4560fcade13bc49a96a8b64b28e9150aa10aa7","bcf93a35ccefadf8ab65725a0a27b2b757e4ff79e5c26534dececc2fa6998448","b424491696702738b6bf83177b26685a24c448bc8be807ed571bcf1f7f41aca1","42b7bcdfb124ce5dba78aeb42f305f5410c83903ef0962f90af6cf68023e6f5d","73237bdde37e12d5841b8a69cb02382c730b3a1487974ea60cbef8be44f2e40d"],"paragraph_range_zero_based":[46056,46079],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46056"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates set of possible resource reservation period in the unit of ms allowed in the resource pool. Up to 16 values can be configured per resource pool. The possible resource reservation period are periodicities for SL communication and the ones defined for DL-PRS.","paragraph_zero_based":46080},{"literal_text_all_w_t_and_m_t":"sl-PRS-ResourcesDedicatedSL-PRS-RP","paragraph_zero_based":46081},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS resources in a slot of dedicated SL PRS resource pool as defined in TS 38.211 [16].","paragraph_zero_based":46082},{"literal_text_all_w_t_and_m_t":"sl-SensingWindowDedicated-SL-PRS-RP","paragraph_zero_based":46083},{"literal_text_all_w_t_and_m_t":"Indicates Parameter that indicates the start of the sensing window for SL PRS in a dedicated resource pool.","paragraph_zero_based":46084},{"literal_text_all_w_t_and_m_t":"sl-TxPercentageDedicatedSL-PRS-RP-List","paragraph_zero_based":46085},{"literal_text_all_w_t_and_m_t":"Indicates List of minimum Tx percentage (list per priority)","paragraph_zero_based":46086},{"literal_text_all_w_t_and_m_t":"sl-SCI-basedSL-PRS-TxTriggerSCI1-B","paragraph_zero_based":46087},{"literal_text_all_w_t_and_m_t":"Indicates presence of a bit-field in SCI format 1-B to trigger SL-PRS transmission by a receiving UE.","paragraph_zero_based":46088},{"literal_text_all_w_t_and_m_t":"sl-NumSubchannelDedicatedSL-PRS-RP","paragraph_zero_based":46089},{"literal_text_all_w_t_and_m_t":"Indicates the number of subchannels in the corresponding resource pool, which consists of contiguous PRBs only.","paragraph_zero_based":46090},{"literal_text_all_w_t_and_m_t":"sl-SubchannelSizeDedicatedSL-PRS-RP","paragraph_zero_based":46091},{"literal_text_all_w_t_and_m_t":"Indicates size of a subchannel for PSCCH in number of RBs.","paragraph_zero_based":46092},{"literal_text_all_w_t_and_m_t":"sl-MaxNumPerReserveDedicatedSL-PRS-RP","paragraph_zero_based":46093},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of SL PRS reservations that can be indicated by an SCI.","paragraph_zero_based":46094},{"literal_text_all_w_t_and_m_t":"sl-NumReservedBitsSCI1B-DedicatedSL-PRS-RP","paragraph_zero_based":46095},{"literal_text_all_w_t_and_m_t":"Indicates the number of reserved bits in SCI format 1-B.","paragraph_zero_based":46096},{"literal_text_all_w_t_and_m_t":"sl-SRC-ID-LenDedicatedSL-PRS-RP","paragraph_zero_based":46097},{"literal_text_all_w_t_and_m_t":"Indicates the number of bits used for the source ID in SCI format 1-B.","paragraph_zero_based":46098},{"literal_text_all_w_t_and_m_t":"sl-CBR-PriorityTxConfigDedicatedSL-PRS-RP-List","paragraph_zero_based":46099},{"literal_text_all_w_t_and_m_t":"Indicates the mapping between SL-PRS transmission parameter (such as transmission power, etc.) sets by using the indexes of the configurations","paragraph_zero_based":46100},{"literal_text_all_w_t_and_m_t":"in sl-CBR-SL-PRS-TxConfigList, CBR ranges by using the indexes to the entry of the CBR range configurations in sl-CBR-SL-PRS-RangeConfigList, and priority ranges. It also indicates the default SL-PRS transmission parameters to be used when CBR measurement results are not available.","paragraph_zero_based":46101},{"literal_text_all_w_t_and_m_t":"sl-PriorityThresholdDedicatedSL-PRS-RP","paragraph_zero_based":46102},{"literal_text_all_w_t_and_m_t":"Indicates the upper bound of priority range which is associated with the configurations in sl-CBR-ConfigIndex-Dedicated-SL-PRS-RP and in sl-PRS-Tx-ConfigIndex. The upper bounds of the priority ranges are configured in ascending order for consecutive entries of SL-PriorityTxConfigIndex-Dedicated-SL-PRS-RP in SL-PriorityTxConfigList-Dedicated-SL-PRS-RP. For the first entry of sl-PriorityThreshold-Dedicated-SL-PRS-RP, the lower bound of the priority range is 1.","paragraph_zero_based":46103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["06d3893af344bc398d4b432b19613f7acccdb8e2f5e2657d46354dd80a92beb1","4be6d3f6f0b9c76574baf647cc977c40f1b52da61952f6e6f91beabc0f061e79","6ee0d3d940985657d769875d305e89c95374be3c918a02c1efbf7906fd91d354","c69a4c07f1ca17d2ccca3efae9162b87fcbbae546492c407dca85c2ce6fd8257","41c9b2a7197a9beb655b9491a9ee90ee2a97a00cbfd02f9ac7dbfd1e7dd8bcdc","8d415d26e92dc70fa09a47b56537a285dcce89256f81bde07a7bb9ba55d677dd","0669cd9742d7fbb7168baf966d188632dfc8188378560496c5d59c39dd3a5d77","8c6dd355a76c55445e7c962044d256f26ed9f81ec6e54b066f92473d7f0cc05a","97d503f4163fdb6783ec0c54fd044c8b8aae34fc45fb67d2e50ec3b166a9a5d6","8a93f9af4c5f87e4f354820cc4aa345d94c1db95fec2e9b483215abc69bf8ae1","a3c57922c5229096ff137e23a853c033e23d1156143af802a0af9be3189fc0bf","8b32ebc1a16e4d401106c21de98db0045b744037805bf1b1b9597bb4ab89c49e","8d80038d733770c68e651ed7bdc66fa56ae686a3f8852a1c94db2ec83e4b41bd","9fdbdfc0af698c70f5c5c2653539525a0f09ab0f3f1796c1f7d3f86b0620ad99","cc85ea9ae804b300aa6af3ecfeec05da76eb63599cff4138e963abe6be26ae9f","e17aa9fe112d73de4ef2ec47db2ed18e59d5d14080f71f1e49d5f0172ef1aa7d","754dbcb4c025adb0f31e30f1160d4f5f306e63d81187e1ba2fa7ebdba76e3b7a","fa0b2d813dfa37d598d82a05d67cd5808784068863b97238ce05b837a7108384","cba214f4c946f526b5269ae717dba7821e5442c2deba58bb04366e194a693c2e","a162d187ec59439382a68564294fd4b3172bfbf21ce1bada3eb713fcb98ba776","54d930d75d1ca7e0433e776092589147cf9d8ed29f2ced28989e69a9fc29bb68","b6e256bb408dfc893cb32733c333a1267b3c4be4b895a43ce278d804fdb346df","bcbe1e4f452e0c71f89907736214643dbd80ccee94db37b6b0ae7597f54e19a4","a20bc3c30866807e269b03934e9b78e85a810e73e198d44ea135bb414860d602"],"paragraph_range_zero_based":[46080,46103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46080"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCBR-DedicatedSL-PRS-RP","paragraph_zero_based":46104},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CBR measurement in a dedicated SL-PRS resource pool.","paragraph_zero_based":46105},{"literal_text_all_w_t_and_m_t":"sl-TimeWindowSizeCR-DedicatedSL-PRS-RP","paragraph_zero_based":46106},{"literal_text_all_w_t_and_m_t":"Indicates the time window size for CR evaluation in a dedicated SL-PRS resource pool.","paragraph_zero_based":46107},{"literal_text_all_w_t_and_m_t":"sl-DefaultTxConfigIndexDedicatedSL-PRS-RP","paragraph_zero_based":46108},{"literal_text_all_w_t_and_m_t":"Indicates the SL PRS transmission parameters to be used by the UEs which do not have available CBR measurement results, by means of an index to the corresponding entry in sl-PRS-TxConfigIndexList. Value 0 indicates the first entry in sl-PRS-Tx-ConfigIndexList. The field is ignored if the UE has available CBR measurement results.","paragraph_zero_based":46109},{"literal_text_all_w_t_and_m_t":"sl-CBR-ConfigIndexDedicatedSL-PRS-RP","paragraph_zero_based":46110},{"literal_text_all_w_t_and_m_t":"Indicates the CBR ranges to be used by an index to the entry of the CBR range configuration in sl-CBR-RangeConfigList-Dedicated-SL-PRS-RP.","paragraph_zero_based":46111},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxConfigIndexList","paragraph_zero_based":46112},{"literal_text_all_w_t_and_m_t":"Indicates List of sl-PRS-Tx-ConfigIndex indicating the SL PRS transmission index","paragraph_zero_based":46113},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxConfigIndex","paragraph_zero_based":46114},{"literal_text_all_w_t_and_m_t":"Indicates SL PRS transmission Configuration index.","paragraph_zero_based":46115},{"literal_text_all_w_t_and_m_t":"sl-PriorityThreshold","paragraph_zero_based":46116},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission in dedicated SL PRS resource pool is prioritized over uplink transmission of priority index 0 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 0 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":46117},{"literal_text_all_w_t_and_m_t":"sl-PriorityThresholdUL-URLLC","paragraph_zero_based":46118},{"literal_text_all_w_t_and_m_t":"Indicates the threshold used to determine whether NR sidelink transmission in dedicated SL PRS resource pool is prioritized over uplink transmission of priority index 1 as specified in TS 38.213[13], clause 16.2.4.3, or whether PUCCH transmission carrying SL HARQ is prioritized over PUCCH transmission carrying UCI of priority index 1 if they overlap in time as specified in TS 38.213 [13], clause 9.2.5.0.","paragraph_zero_based":46119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46120},{"literal_text_all_w_t_and_m_t":"SL-PRS-PSCCH-Config field descriptions","paragraph_zero_based":46121},{"literal_text_all_w_t_and_m_t":"freqResourcePSCCH-Dedicated-SL-PRS-RP","paragraph_zero_based":46122},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs for PSCCH in a dedicated SL PRS resource pool.","paragraph_zero_based":46123},{"literal_text_all_w_t_and_m_t":"timeResourcePSCCH-Dedicated-SL-PRS-RP","paragraph_zero_based":46124},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols for PSCCH in a dedicated SL PRS resource pool.","paragraph_zero_based":46125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46126},{"literal_text_all_w_t_and_m_t":"SL-PRS-PowerControl field descriptions","paragraph_zero_based":46127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"37