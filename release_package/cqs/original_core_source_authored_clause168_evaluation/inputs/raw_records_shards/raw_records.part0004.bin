{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetToAddModList","paragraph_zero_based":21432},{"literal_text_all_w_t_and_m_t":"Pool of CSI-SSB-ResourceSet which can be referred to from CSI-ResourceConfig.","paragraph_zero_based":21433},{"literal_text_all_w_t_and_m_t":"ltm-CSI-ReportConfigToAddModList","paragraph_zero_based":21434},{"literal_text_all_w_t_and_m_t":"Configured CSI report settings for LTM as specified in TS 38.214 [19].","paragraph_zero_based":21435},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetToAddModList","paragraph_zero_based":21436},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-ResourceSet which can be referred to from CSI-ResourceConfig or from MAC CEs.","paragraph_zero_based":21437},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceToAddModList","paragraph_zero_based":21438},{"literal_text_all_w_t_and_m_t":"Pool of NZP-CSI-RS-Resource which can be referred to from NZP-CSI-RS-ResourceSet.","paragraph_zero_based":21439},{"literal_text_all_w_t_and_m_t":"reportTriggerSize, reportTriggerSizeDCI-0-2","paragraph_zero_based":21440},{"literal_text_all_w_t_and_m_t":"Size of CSI request field in DCI (bits) (see TS 38.214 [19], clause 5.2.1.5.1). The field reportTriggerSize applies to DCI format 0_1 and the field reportTriggerSizeDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 5.2.1.5.1).","paragraph_zero_based":21441},{"literal_text_all_w_t_and_m_t":"scellActivationRS-ConfigToAddModList","paragraph_zero_based":21442},{"literal_text_all_w_t_and_m_t":"Configured RS for fast SCell activation as specified in TS 38.214 [19] clause 5.2.1.5.3.","paragraph_zero_based":21443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21444},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfig","paragraph_zero_based":21445},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfig is used to configure a periodic or semi-persistent report sent on PUCCH on the cell in which the CSI-ReportConfig is included, or to configure a semi-persistent or aperiodic report sent on PUSCH triggered by DCI received on the cell in which the CSI-ReportConfig is included (in this case, the cell on which the report is sent is determined by the received DCI). See TS 38.214 [19], clause 5.2.1.","paragraph_zero_based":21446},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig information element","paragraph_zero_based":21447},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21448},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-START","paragraph_zero_based":21449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21450},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig ::=                SEQUENCE {","paragraph_zero_based":21451},{"literal_text_all_w_t_and_m_t":"    reportConfigId                          CSI-ReportConfigId,","paragraph_zero_based":21452},{"literal_text_all_w_t_and_m_t":"    carrier                                 ServCellIndex                   OPTIONAL,   -- Need S","paragraph_zero_based":21453},{"literal_text_all_w_t_and_m_t":"    resourcesForChannelMeasurement          CSI-ResourceConfigId,","paragraph_zero_based":21454},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourcesForInterference         CSI-ResourceConfigId            OPTIONAL,   -- Need R","paragraph_zero_based":21455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6c545584632e1e3fc2b624d1fb12af351dddca289a16d516b3a780c1b5f244f4","496fb9b06c126e760bd8e43a5e0509b3d357d84c6267d6a921c536c577ee248a","bd0e54fa9f69d93e8ef5eecd9acab2abaf72b3