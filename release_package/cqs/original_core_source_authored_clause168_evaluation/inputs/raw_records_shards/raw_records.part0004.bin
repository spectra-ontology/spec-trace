{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGBROADCAST-START","paragraph_zero_based":47928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47929},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigBroadcast-r17 ::= SEQUENCE {","paragraph_zero_based":47930},{"literal_text_all_w_t_and_m_t":"    pdschConfigList-r17                    SEQUENCE (SIZE (1..maxNrofPDSCH-ConfigPTM-r17) ) OF PDSCH-ConfigPTM-r17,","paragraph_zero_based":47931},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList-r17     PDSCH-TimeDomainResourceAllocationList-r16                          OPTIONAL,   -- Need R","paragraph_zero_based":47932},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList-r17       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL,   -- Need R","paragraph_zero_based":47933},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround-r17              RateMatchPatternLTE-CRS                                             OPTIONAL,   -- Need R","paragraph_zero_based":47934},{"literal_text_all_w_t_and_m_t":"    mcs-Table-r17                          ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":47935},{"literal_text_all_w_t_and_m_t":"    xOverhead-r17                          ENUMERATED {xOh6, xOh12, xOh18}                                     OPTIONAL    -- Need S","paragraph_zero_based":47936},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47937},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47938},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigPTM-r17 ::= SEQUENCE {","paragraph_zero_based":47939},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPDSCH-r17        INTEGER (0..1023)         OPTIONAL,   -- Need S","paragraph_zero_based":47940},{"literal_text_all_w_t_and_m_t":"    dmrs-ScramblingID0-r17                 INTEGER (0..65535)        OPTIONAL,   -- Need S","paragraph_zero_based":47941},{"literal_text_all_w_t_and_m_t":"    pdsch-AggregationFactor-r17            ENUMERATED {n2, n4, n8}   OPTIONAL    -- Need S","paragraph_zero_based":47942},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47944},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGBROADCAST-STOP","paragraph_zero_based":47945},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47947},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigBroadcast field descriptions","paragraph_zero_based":47948},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":47949},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":47950},{"literal_text_all_w_t_and_m_t":"pdschConfigList","paragraph_zero_based":47951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb8b7f075bd9783a88f52b2f11c19c9d52fd4ec9dd512617532f426ebdc271d0","1933a6d729b0a703284bd3c7a1db7babfe19378a439056821b64f33d2abd53ee","ec5394ef16b5e089cd8d75c54281e8b96858ad3cd8f9eefbce69cc1c4ed646b9","2426bdc81a049391efc14cbec5a468ef699e5988e353c810ab393aece7ff8ae7","9a1e1e4199e6cf5dd5c6d8a51ab710743293798386b835e3cca1f1210a505f3d","8a30a5ed2e28e7a28ae8eb292f736ef31b106ab3713eb79d8c296158976d2712","c9700dd8f526a9e22f490fedb52c747be903b591a28c2d5466630f57cc8b0db0","9578649c16ca51fca17ac57d2ccc878159aeacc0640b49ab458c2fa0dbe875eb","5045cc46887fd0f36a95884776c5014b63b369e95705c