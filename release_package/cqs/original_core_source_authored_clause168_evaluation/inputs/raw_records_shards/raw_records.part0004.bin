{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pucch-Cell                              ServCellIndex                                                  OPTIONAL,   -- Cond SCellAddOnly","paragraph_zero_based":27768},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27769},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27770},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..8)                                                 OPTIONAL,   -- Need M","paragraph_zero_based":27771},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                        OPTIONAL    -- Need M","paragraph_zero_based":27772},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27773},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27774},{"literal_text_all_w_t_and_m_t":"    pdsch-CodeBlockGroupTransmissionList-r16 SetupRelease { PDSCH-CodeBlockGroupTransmissionList-r16 }     OPTIONAL    -- Need M","paragraph_zero_based":27775},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27776},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27777},{"literal_text_all_w_t_and_m_t":"    downlinkHARQ-FeedbackDisabled-r17       SetupRelease { DownlinkHARQ-FeedbackDisabled-r17 }              OPTIONAL,   -- Need M","paragraph_zero_based":27778},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH-v1700        ENUMERATED {n32}                                               OPTIONAL    -- Need R","paragraph_zero_based":27779},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27780},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27782},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":27783},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":27784},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupFlushIndicator            BOOLEAN,","paragraph_zero_based":27785},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27786},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27788},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmissionList-r16 ::=    SEQUENCE (SIZE (1..2)) OF PDSCH-CodeBlockGroupTransmission","paragraph_zero_based":27789},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27790},{"literal_text_all_w_t_and_m_t":"DownlinkHARQ-FeedbackDisabled-r17 ::= BIT STRING (SIZE (32))","paragraph_zero_based":27791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["80701c95c73ffe76682cd1bbcbac0fd99f248dee6a5bab3af883902c87f8642f","0e92784c72849161a04c75b3c88dc6d3231441ed80a3b1aeb1126a3d750374d0","5847931a108a9b6eb35228b34ae1704c79249030c1039fb49046db97239fcc70","602ff05d9c9c08fc9008da6b6386c7599d13a030d90ccf3af12e0d107588b6ad","ee49ae7f2e1d45839a5a1ab392605e693784bd57d1b35a5721f681a3400f8f60","b26d58e6fed40c339e0158c581de409693e5627ae394c98a8ea6f32e6c45eaa1","83abbb4ab93ed59ac88772b94cd87bd5600fa3737163433becea72966974f7c8","45e0171244de51ff55fc04b4ffdf66f2f883814204d51a64197a7609a47dc1aa","c5be320a65080fc1e6562d2ad74f77243715a8abe089b2d482644813041106ad","081d1e4372859e8fa8c97b35ca8290fd8f80a43fa25e6f5fcd850f81219e2998","dec4402376f5980ee5c09feb411a460ad92033d2036ece06c4df1ae8977b57cb","44eea0a21b81406a490e0da3c191cf371bc7a4417e48daa012c2b1edb0973935","8184e45ceb2621e1a5a334120dea0f391c3354e99609d659a442985e59f934e7","138e9e7a3f930252c5346bf7bd2728a16eabcb6a3088c0b05ffcccb5381d503e","47709d1b50673f207fcda43894963d7ea6dd281e8b7c6570f1fd83a179594b3c","5a5a54a6d18711dd7584018aab0e5aa7a86383d8eaebf9854f2ab3f6b1611385","ed2d51418ea78d96cd463be6533a6f5f9d99ea3702663153640e8cc827370c1d","d529b05f2e3d10d2cc34b3d5bfd7f9f245e851b2f8ecd2907ea1976ef9fe2c44","619e1207e48ac60497d18663fbb56b05a04df4479b2895b20965cba5b45bb4d8","3c4364c0b03c1abc39faaf1c3da579be24c06ad385d3a052a6bc1ec5a572299d","0c6cfff7c5f1ff2b041ac090be21175e3131d5add5ceb4d336013a0e823ef246","343460d860c70d56aa8ee8185ee0ccd84846569e6a5abae260f3f5c5d9b42f16","8ad8e4ddb25fe1d3f8fd906e3f98a5d7b0452f1cb396e009bb8ec9342b0cb044","a541f459fb26f6855aeb2b379d1beb31eb849717449be5b2a5b97ccbc44c76cc"],"paragraph_range_zero_based":[27768,27791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27768"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27792},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":27793},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27795},{"literal_text_all_w_t_and_m_t":"PDSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":27796},{"literal_text_all_w_t_and_m_t":"codeBlockGroupFlushIndicator","paragraph_zero_based":27797},{"literal_text_all_w_t_and_m_t":"Indicates whether CBGFI for CBG based (re)transmission in DL is enabled (true). (see TS 38.212 [17], clause 7.3.1.2.2).","paragraph_zero_based":27798},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":27799},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB. In case of multiple CW, the maximum CBG is 4 (see TS 38.213 [13], clause 9.1.1).","paragraph_zero_based":27800},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27801},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig field descriptions","paragraph_zero_based":27802},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":27803},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.213 [13], clause 9.1.1). Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":27804},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if - the SCS of at least one DL BWP configured in the cell is 480 or 960 kHz - Type-1 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH) - Type-2 HARQ-ACK codebook is configured and pdsch-TimeDomainAllocationListForMultiPDSCH-r17 for any cell in the same PUCCH cell group associated with this serving cell contains pdsch-AllocationList with multiple entries (multiple PDSCH)","paragraph_zero_based":27805},{"literal_text_all_w_t_and_m_t":"downlinkHARQ-FeedbackDisabled","paragraph_zero_based":27806},{"literal_text_all_w_t_and_m_t":"Used to disable the DL HARQ feedback, sent in the uplink, per HARQ process ID. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. The bit(s) set to one identify HARQ processes with disabled DL HARQ feedback and the bit(s) set to zero identify HARQ processes with enabled DL HARQ feedback.","paragraph_zero_based":27807},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":27808},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in all BWPs of this serving cell. (see TS 38.212 [17], clause 5.4.2.1).","paragraph_zero_based":27809},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPDSCH","paragraph_zero_based":27810},{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PDSCH of a serving cell. Value n2 corresponds to 2 HARQ processes, value n4 to 4 HARQ processes, and so on. If both nrofHARQ-ProcessesForPDSCH and nrofHARQ-ProcessesForPDSCH-v1700 are absent, the UE uses 8 HARQ processes (see TS 38.214 [19], clause 5.1).","paragraph_zero_based":27811},{"literal_text_all_w_t_and_m_t":"pdsch-CodeBlockGroupTransmissionList","paragraph_zero_based":27812},{"literal_text_all_w_t_and_m_t":"A list of configurations for up to two simultaneously constructed HARQ-ACK codebooks (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":27813},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":27814},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PDSCH (see 38.214 [19], clause 5.3).","paragraph_zero_based":27815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["41bd47bcace027915ef1aae84cde9148b3ba57f2caff7c903cc0394a94edfca4","cabeee3e860b1fef76696291d8e59f20aa41c2a38b2f9ac203e4d604c190756f","017e7e20b8049b0b381c0e86785e5451d44e10c13c96d9b7658636551287674b","8449aa7b91cf9198a33273c8f47db7f7f26111e9566da65d72fe49a147e5f9e5","4801266397c0fa49585f7df2ee2f04a10681552dc453d62e1c234cb2bf2555a8","83ce80f38113fabb7c6d310d56697b099fe11d9f08e38eea4f51307295f5fe1e","24c0788dc085939c937475844e644e9c372a0d032280093de0731ac90d1d1778","b8f56f39b5fcd71378dc3ba5adc6f9d39507b2864bbff8dcb43ee45ce715fc74","79566a79fc6f361e601a83dfaf565f75f0f353ebeeec4b730a674c636302be4f","88c8a4e209006abc1ec0bb19e77e7d5b69f457ac58593a8b10ae8dda678d801c","6dc9ba6bfe0901622114e1d101ede0d1de686a3b9e75c710836f5720a4e1f46b","c8ac94c68087e0ec5d04254d61db555abe62c6ec3946ceda713bdccec1f344f7","f0fd937f850a268cc52b83d04b370ec07c3f4dde43d3e31e12cf69f29c1b1975","c1f9079f44c6fb5adb7330b1be950f5e40d94b5f36673f37218c493a52a991ee","4aa0e4409d8a98966395ee2f66a996828768a0b7d05e96536c87fe9e232c49da","bafe24e475b098a29f07ebb6f83e6f0745177e942234ebb8a410d89223f3c1ae","86601c99c834f00bd56bace10a4556f14e22fe96cd63f020dfecac826c1b53b9","a59c0c27ef04006ab6354f0a1e17962d27dc597ce409513769c6bf5d749f9647","d8167f23f7b71bdcfd26d4d7f7b1ea13151002e73d6d2c885ede6cff554faab4","b9e100ac0c9cb4e08b8e7db92a24cbc7ac5af8b6553113739cf12857856c70a3","8152772af899239e27a83427fc6cc34bb9212b5abd5cc20d770f315bd62221ad","75430110164c5c100e7bd58b9b9632e3b895ef68de692054eb35ea3091133bab","c48fa7d0c35a1acb33342d19c051485b08433a21e5580eee68c7d44369828a32","47213c7f67d26f5f94b14f988057dfba17afe74a296292f2bffa1557a1ea1cb9"],"paragraph_range_zero_based":[27792,27815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27792"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pucch-Cell","paragraph_zero_based":27816},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell (of the same cell group) to use for PUCCH. If the field is absent, the UE sends the HARQ feedback on the PUCCH of the SpCell of this cell group, or on this serving cell if it is a PUCCH SCell.","paragraph_zero_based":27817},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":27818},{"literal_text_all_w_t_and_m_t":"Accounts for overhead from CSI-RS, CORESET, etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":27819},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27820},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27821},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27822},{"literal_text_all_w_t_and_m_t":"SCellAddOnly","paragraph_zero_based":27823},{"literal_text_all_w_t_and_m_t":"It is optionally present, Need S, for (non-PUCCH) SCells when adding a new SCell. The field is absent, Need M, when reconfiguring SCells. The field is also absent for the SpCells as well as for a PUCCH SCell.","paragraph_zero_based":27824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27825},{"literal_text_all_w_t_and_m_t":"–PDSCH-TimeDomainResourceAllocationList","paragraph_zero_based":27826},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PDSCH. The PDSCH-TimeDomainResourceAllocationList contains one or more of such PDSCH-TimeDomainResourceAllocations. The network indicates in the DL assignment which of the configured time domain allocations the UE shall apply for that DL assignment. The UE determines the bit width of the DCI field based on the number of entries in the PDSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":27827},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList information element","paragraph_zero_based":27828},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27829},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":27830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27831},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27832},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofDL-Allocations)) OF PDSCH-TimeDomainResourceAllocation","paragraph_zero_based":27833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27834},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation ::=   SEQUENCE {","paragraph_zero_based":27835},{"literal_text_all_w_t_and_m_t":"    k0                                      INTEGER(0..32)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":27836},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":27837},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":27838},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6e6bf6a79fa140569ba55cbfe7c926457a8ffc62963311a5e00bff53e5d710f4","e9e356409943fb0608d2167