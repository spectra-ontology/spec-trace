{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-START","paragraph_zero_based":27744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27745},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":27746},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocationList                  PDSCH-TimeDomainResourceAllocationList          OPTIONAL,   -- Need R","paragraph_zero_based":27747},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27748},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27750},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-STOP","paragraph_zero_based":27751},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27753},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon field descriptions","paragraph_zero_based":27754},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":27755},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data (see table 5.1.2.1.1-1 in TS 38.214 [19]).","paragraph_zero_based":27756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27757},{"literal_text_all_w_t_and_m_t":"–PDSCH-ServingCellConfig","paragraph_zero_based":27758},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ServingCellConfig is used to configure UE specific PDSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":27759},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig information element","paragraph_zero_based":27760},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27761},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":27762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27763},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":27764},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PDSCH-CodeBlockGroupTransmission }              OPTIONAL,   -- Need M","paragraph_zero_based":27765},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED { xOh6, xOh12, xOh18 }                              OPTIONAL,   -- Need S","paragraph_zero_based":27766},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH              ENUMERATED {n2, n4, n6, n10, n12, n16}                         OPTIONAL,   -- Need S","paragraph_zero_based":27767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c3eca75a5f1721e97777a27a04bb0133181e4da03f814d3c43d2901c6e9d18a4","c5aff9096b7e9e52975fa0738c1f481f84446918007855027c637f536ea29d3a","518a977b62ed8afee3707a37995a3625d0214c82dc889391310a5c7447440f18","3710c242271e3c6c35131073474e52b5bf89fa451308503cb5b775dcdfdbf5a1","64d7be74ac5a7402fe266ea5ce0a732842e3b93a904d0f2e4ba849dc9f1d2ff0","fe8a5ee31fb41e31e15d9d22c93d137e18a1dd9249fadea4031919648bfced00","2655512040d3ae17d3ce4f55f66b62fdb9a7d6d39e17ccc230a78dd3367c44c5","071af4370fd51e73dc6d3d802bd10be1f326deea543caa4a8f9f8cdf1574530c","df2376e6a7b9952e0b5ef15f7b2f28eda5718f57e4f0066d6dffd06c274dcc72","ea934c814f3288d03a0c3bd1e73c39e9e95934ce1c72ccf8e1f25e2b345b178a","57affc0bf3c08a6637ee73193b76e7226fd75ab7392930ca1c8592669a8d0e2f","49f75f985f5024a3cfed42a16193dc890a19eff6e98dfbc90ac24948c25cc735","fee322f6df