{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44665},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-STOP","paragraph_zero_based":44666},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44668},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig field descriptions","paragraph_zero_based":44669},{"literal_text_all_w_t_and_m_t":"appLayerMeasPriority","paragraph_zero_based":44670},{"literal_text_all_w_t_and_m_t":"The field indicates the priority of the application layer measurement configuration, where a higher value indicates lower priority. If the field is not configured, the application layer measurement configuration has the lowest priority.","paragraph_zero_based":44671},{"literal_text_all_w_t_and_m_t":"idleInactiveReportAllowed","paragraph_zero_based":44672},{"literal_text_all_w_t_and_m_t":"The field indicates whether transmission of application layer measurement reports collected in RRC_IDLE and/or RRC_INACTIVE is allowed and if transmission of application layer measurement configurations applicable to RRC_IDLE and/or RRC_INACTIVE is allowed. If fhe field is not configured, transmission of application layer measurement reports and/or configurations for RRC_IDLE/RRC_INACTIVE is not allowed.","paragraph_zero_based":44673},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerContainer","paragraph_zero_based":44674},{"literal_text_all_w_t_and_m_t":"The field contains configuration of application layer measurements, see Annex L (normative) in TS 26.247 [68], clause 16.5 in TS 26.114 [69] and TS 26.118 [70].","paragraph_zero_based":44675},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerId","paragraph_zero_based":44676},{"literal_text_all_w_t_and_m_t":"The field contains the identity of the application layer measurements. When application layer measurements are configured for an SCG, the measConfigAppLayerId is obtained according to TS 38.423 [37], clauses 8.3.1 and 8.3.3.","paragraph_zero_based":44677},{"literal_text_all_w_t_and_m_t":"pauseReporting","paragraph_zero_based":44678},{"literal_text_all_w_t_and_m_t":"The field indicates whether the transmission of measReportAppLayerContainer is paused or not. Value true indicates the transmission of measReportAppLayerContainer is paused; value false indicates the transmission of measReportAppLayerContainer is not paused.","paragraph_zero_based":44679},{"literal_text_all_w_t_and_m_t":"ran-VisibleParameters","paragraph_zero_based":44680},{"literal_text_all_w_t_and_m_t":"The field indicates whether RAN visible application layer measurements shall be reported or not.","paragraph_zero_based":44681},{"literal_text_all_w_t_and_m_t":"ran-VisibleReportingSRB","paragraph_zero_based":44682},{"literal_text_all_w_t_and_m_t":"The field indicates the SRB to be used for transmission of RAN visible application layer measurement reports.","paragraph_zero_based":44683},{"literal_text_all_w_t_and_m_t":"reportingSRB","paragraph_zero_based":44684},{"literal_text_all_w_t_and_m_t":"The field indicates the SRB to be used for transmission of encapsulated application layer measurement reports.","paragraph_zero_based":44685},{"literal_text_all_w_t_and_m_t":"rrc-SegAllowedSRB4","paragraph_zero_based":44686},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled on SRB4. The field is only configured for an MCG. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message.","paragraph_zero_based":44687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0e9589c2347b4c68223f28a8d9b9a5d914134f192923bd903fcc48ccb5758d26","ab5cb5af0097cee70bcfbbde157b507c90c0891c17d950386791fea65bb8a754","07f6a659d2e13b62202edc5e35732e92a21cb1c23b747299d57c45b2dff62b58","6ddb9c4da00413d572daa916bf810217c16c0763013c9cbfa3985377441e29ed","336d81ad6fa0ab2f02b93967765b8e3235ee0d46d8a9dd6737b142704f996a2d","63a342340cbf83127d0e77455e4feecee9826a8cde3e932111477b1741c77df6","0cf27ae67483bd30105952bc810cd2220f23ebec1792453faa08635b992c6e02","5d50ed3306b907bf4fd6749e3fb7a11d1996d10e30a8af30fb47afd271b0a394","eeeda94fce149837a79d793c512efbb2d3c99c288879cfc2a318de9994689d1f","217102dc373492ffc224ee66cd350984431f1b552efbc3deb3fd7a584bd5a767","7655e3c12d4078242c13548428e052d3c2df8cf8a31ccdfd2a83b8c8633da242","443bdcff1786e97c4349d02b7e8782e66ff14a63b9c0d783268abb8c72251d54","88896937bd915ce85518c977a48eee569a0fa2538f1526c9f400cb0da9ae2707","c9c393cbfcdbef2d504c0d10033c535d83e5021d71e1689d4643d03c8e1747d0","6c4336a75254b4af5790a395f5dfb4c7ab87052c94f3d52e1b5b9f68bdb478b9","aaba3857787ec6bdc826e82fb52a698bba89261ec426aeb0ab22950580ff76ba","f81ade4791d3d6757e3cdac1a753007499b030797e297b51bb6d3aa7313e54ab","ca162e75c54aa2f1db12df7892d5654acb723cd4ac6ae773499c38edc3790711","02edbfb143bf1532a1afbd8e6cf06e83239690cf4dc85e24cc2fcba5b7aaae19","9c39b636337a2d2f22ef7961e5c4b96e77c7986833d9b6749eeb8dd56444eb17","8cdc66400cb25376438a47fd17f17be1dda5c2f0f26d8f9dd531f99483e2aeae","ab363877a7d70a1cbddeecceaea2cc947f94cca422cff83fec306e241eedbe47","7525278e4b9bfdcd1a3fbc979b2e8f426cea001635ccf36f3283f3c4e2db8c68","194aac502c3829577c2fb5bf277b0b06404fc5e7c6243d568e74aa6893229e4b"],"paragraph_range_zero_based":[44664,44687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p44664"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rrc-SegAllowedSRB5","paragraph_zero_based":44688},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled on SRB5. The field is only configured for an SCG. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message.","paragraph_zero_based":44689},{"literal_text_all_w_t_and_m_t":"serviceType","paragraph_zero_based":44690},{"literal_text_all_w_t_and_m_t":"Indicates the type of application layer measurement. Value streaming indicates Quality of Experience Measurement Collection for streaming services (see TS 26.247 [68]), value mtsi indicates Quality of Experience Measurement Collection for MTSI (see TS 26.114 [69]) and value vr indicates Quality of Experience Measurement Collection for VR service (see TS 26.118 [70]). The network always configures serviceType when application layer measurements are initially configured and at fullConfig.","paragraph_zero_based":44691},{"literal_text_all_w_t_and_m_t":"transmissionOfSessionStartStop","paragraph_zero_based":44692},{"literal_text_all_w_t_and_m_t":"Value true indicates that the UE shall transmit indications when the measurement session in the application layer starts and stops. Value false indicates that the UE shall not transmit any session status indications. The UE transmits a session start indication upon configuration of this field set to value true if a session already has started in the application layer.","paragraph_zero_based":44693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44694},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters field descriptions","paragraph_zero_based":44695},{"literal_text_all_w_t_and_m_t":"numberOfBufferLevelEntries","paragraph_zero_based":44696},{"literal_text_all_w_t_and_m_t":"The field contains the maximum number of buffer level entries that can be reported for RAN visible application layer measurements. This field is also used by application layer to calculate the interval of RAN visible buffer level measurement, which is equal to the periodicity of RAN visible application layer measurements reporting divided by numberOfBufferLevelEntries.","paragraph_zero_based":44697},{"literal_text_all_w_t_and_m_t":"ran-VisiblePeriodicity","paragraph_zero_based":44698},{"literal_text_all_w_t_and_m_t":"The field indicates the periodicity of RAN visible application layer measurements reporting. Value ms120 indicates 120 ms, value ms240 indicates 240 ms and so on. If this field is absent, the periodicity of RAN visible application layer measurements reporting is the same as the reporting periodicity indicated in measConfigAppLayerContainer.","paragraph_zero_based":44699},{"literal_text_all_w_t_and_m_t":"reportPlayoutDelayForMediaStartup","paragraph_zero_based":44700},{"literal_text_all_w_t_and_m_t":"The field indicates whether the UE shall report Playout Delay for Media Startup for RAN visible application layer measurements.","paragraph_zero_based":44701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44703},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44704},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44705},{"literal_text_all_w_t_and_m_t":"QoENRDC","paragraph_zero_based":44706},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when QoE for an NR-DC configuration is configured, i.e. when either QoE for an SCG is configured or when SRB5 is configured. Otherwise, it is absent.","paragraph_zero_based":44707},{"literal_text_all_w_t_and_m_t":"ServiceType","paragraph_zero_based":44708},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when serviceType is set to streaming or vr. Otherwise, it is absent.","paragraph_zero_based":44709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44710},{"literal_text_all_w_t_and_m_t":"–AreaConfiguration","paragraph_zero_based":44711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["789f4fca3107a84c7b75ced82d1f2eab0f335c66de9d53e5f3f9f1f15b049770","d45d084f4fac247e458006b64f0a2cb132b155bf8b641b1a03ec43438ed184df","94c5f68c240e37c6c375a548b648aaf28a9503497bd81e38c89f4b27b86e7003","32c30b5f22127e035ffd0cc1f86797dbd2b93edec3257e909a8d770978404758","9bad6f467c8d56b5e9f275b8d815cfdfd5ef169cae92fc6f30c2da41bf06c953","7b3363efa7fb7121d441dee1764cb7f3b0b8323fb299f637eeddac032a8c3dcd","7f3990fe9c78c9aca55d5018921dc0f302b147ad521d76d189cea0b84ec19e5e","814d9a28c70d0653af6782ecda3c9eddb658107cb3d3754030df6e526256f6ef","c677006b9ecc863591798a28558fda64ac8fa64ead9f40b89a057c03bb6e25f7","fc1145ab49e5fb99300dcb0ef4e55eda4618cd011ad3584878b17fa751d51124","58f3d4cfee1df5eeb9a3329669c1c7f42f164d55c647492ca417431d7eca47a4","413b98c0d86427481c789a9b25a05a18865fdabc3b938cde377fb3be59b1b53f","3ff40ab33555ae1d2e19969e110ef75003da6572d34c766ca42da58e3c5ed58d","40dd7c1277b787f4f821b703fcddb799ee96ca36b1ee1204ba1e0309385fe80b","f2b4f788029899913cc6ace281d0044480ce4049df827b6ea39640813e728772","33dfc68057266f29f50ffc8e4db54433a84f2dc311b44eff570b036ba3a0a189","54d8b3e43bf76ba78bcdd17f5bfa1dc2bb7b062892b3657efce7d01032cbea81","a883fbe7c1477822c991400371d45ede1f9a5d2ed45c3e34fd35b7a4fd0b35b1","aa77ad7452c2fded280737962e844eb0775fbae95afbe3f28eaa1c49c2bf7c4b","98640aa6b6b8a0e480a7294081e6a55457e91ff2113680238eee69dc73a352ac","8b67a98d680974f828fd8c2a60122adbd8bc5a0ebda858bfa4eb4d999f16c3b8","234ba1c809c95c376831c0