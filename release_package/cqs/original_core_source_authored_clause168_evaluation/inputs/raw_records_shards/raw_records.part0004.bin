d, the UE shall apply the configured ROHC profile(s) in downlink.","paragraph_zero_based":47778},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":47779},{"literal_text_all_w_t_and_m_t":"Indicates an identifier of the MBS session provided by the MTCH.","paragraph_zero_based":47780},{"literal_text_all_w_t_and_m_t":"mrb-listBroadcast","paragraph_zero_based":47781},{"literal_text_all_w_t_and_m_t":"A list of broadcast MRBs to which the associated broadcast MBS session is mapped to.","paragraph_zero_based":47782},{"literal_text_all_w_t_and_m_t":"mtch-neighbourCell","paragraph_zero_based":47783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["181d0013d7d8ba2c77dc4e89dad7980022e2667bfeeb4808ad118b05d77baafe","5d77802de802ed03a8b9e121fb35e6d6111fc28766df321f04ce81243b8bb43f","dc45d5e305b11530f200b2aea00d907b22e605f1f95584a2e445132f386326c5","30595147630831a4c7c54689c80d394f6f7df4ea0213d185925e5b92c724a49d","9992b9d957bb6b2bc1c73647f59cd94719a64bd81edc24637635363d2904ba0f","47651e9090adc166b208f68cf8583e8030db7e89d4dbef44797f2714facd0ee1","d1b3ce35994eede98359ef7e7dfb94d918ee3d630b8743cc49d9bd696cad52b0","b28c6bbb3965aff9877b0252ce1aad7802c1a899fb0cb0843f2ad0edb15024d8","0828a265cbfe9462b8bed2b3144c541cf687379ff905b1af3a3c5da533c76cad","51cfb1488d1973bacaec4f3be19441c1bfa986d41fe1d9794b65c137e9cc214e","f819bf900d11c767eb721bdd72ff7330de138dbe09a4505abd90a358b4f4afba","f60df84582b0ad112e2043caa47a8216238b17e9aa60f764fe3529a29ff29d44","be2dea8acf886f8b94949c215d9722a8b4960adfc18bcdc2d9a6b3edf06b40e5","d2c4241a62cce87f61f154c1306f0004128bb7ea3139bc682bd2515d74efa0f1","f74c998797580b6d4b1d4a69b59d0f437e115b0237a853ae51ddf06a7657ec46","0aab9b07ec7e44e73bb11d8