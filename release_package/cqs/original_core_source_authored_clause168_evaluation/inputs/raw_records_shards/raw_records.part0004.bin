5be4d8855cae82be6a425d792da6fdf30538e73d","dbf74fe7759ef355e53b19ec6a25560422723fb94fed7a3731ee8ea33a3a6367","fe1da9b30a3d19afab6a7cd468741647ce5c31ee19e9051b0a960aa1595b59fc","a1483342fe8df145c65e21c74aaf6f9e0076e75892f0dc6d0078234c61bb6a74","19c016683dc13bd983b67de5a0acf3e6f0e969b02115a49e33452c70d46c2f32","284e5a621490629d05dec973768a7ffc7144393ead6d9f56057567474993082c","015de05cd444e5d20697c6a0214d327ea97764f5c4bef22ecd1db279f2e5af0a","9221bb6b99348fbf21db45603546a6a621888dabe1b2a355f82dad2ab0e8869d","dea72afdce5abbb0629f95ea16ca5006ca21f19be35da0ffb94ac3ba2472f6de","6d3a5ffc27d79ea2da4f70f294fa22a4b18eae896d823a52350911d6f904f2bb","ecd8e880a2205d7e8ffc5bcbfe747c04c8b9059af4649376fec0801a2b6ec60b","8b7cb21433704c8fa614edaac419d605d6a58cd9e47bf3bffd8f2ff3582daf9a","b3b03611482e67c12ccdac78779af6eb2bbe1d2d5096a04618783dc050f76f01"],"paragraph_range_zero_based":[32328,32351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32328"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SR periodicity and offset in number of symbols or slots (see TS 38.213 [13], clause 9.2.4) The following periodicities may be configured depending on the chosen subcarrier spacing:","paragraph_zero_based":32352},{"literal_text_all_w_t_and_m_t":"SCS =  15 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl","paragraph_zero_based":32353},{"literal_text_all_w_t_and_m_t":"SCS =  30 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl, 160sl","paragraph_zero_based":32354},{"literal_text_all_w_t_and_m_t":"SCS =  60 kHz: 2sym, 7sym/6sym, 1sl, 2sl, 4sl, 8sl, 16sl, 20sl, 40sl, 80sl, 160sl, 320sl","paragraph_zero_based":32355},{"literal_text_all_w_t_and_m_t":"SCS = 120 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl","paragraph_zero_based":32356},{"literal_text_all_w_t_and_m_t":"SCS = 480 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl","paragraph_zero_based":32357},{"literal_text_all_w_t_and_m_t":"SCS = 960 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl, 5120sl","paragraph_zero_based":32358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32359},{"literal_text_all_w_t_and_m_t":"sym6or7 corresponds to 6 symbols if extended cyclic prefix and a SCS of 60 kHz are configured, otherwise it corresponds to 7 symbols.","paragraph_zero_based":32360},{"literal_text_all_w_t_and_m_t":"For periodicities 2sym, 7sym and sl1 the UE assumes an offset of 0 slots.","paragraph_zero_based":32361},{"literal_text_all_w_t_and_m_t":"If periodicityAndOffset-r17 is present, any previously configured periodicityAndOffset (without suffix) is released, and vice versa.","paragraph_zero_based":32362},{"literal_text_all_w_t_and_m_t":"UE indicates support of the following SR periodicities in additionalSR-Periodicities (see TS 38.306, clause 4.2.6):","paragraph_zero_based":32363},{"literal_text_all_w_t_and_m_t":"SCS = 30 kHz: 5sl","paragraph_zero_based":32364},{"literal_text_all_w_t_and_m_t":"SCS = 120 kHz: 5sl, 10sl","paragraph_zero_based":32365},{"literal_text_all_w_t_and_m_t":"phy-PriorityIndex","paragraph_zero_based":32366},{"literal_text_all_w_t_and_m_t":"Indicates whether this scheduling request resource is high or low priority in PHY prioritization/multiplexing handling (see TS 38.213 [13], clause 9.2.4). Value p0 indicates low priority and value p1 indicates high priority.","paragraph_zero_based":32367},{"literal_text_all_w_t_and_m_t":"resource","paragraph_zero_based":32368},{"literal_text_all_w_t_and_m_t":"ID of the PUCCH resource in which the UE shall send the scheduling request. The actual PUCCH-Resource is configured in PUCCH-Config of the same UL BWP and serving cell as this SchedulingRequestResourceConfig. The network configures a PUCCH-Resource of PUCCH-format0 or PUCCH-format1 (other formats not supported) (see TS 38.213 [13], clause 9.2.4)","paragraph_zero_based":32369},{"literal_text_all_w_t_and_m_t":"schedulingRequestID","paragraph_zero_based":32370},{"literal_text_all_w_t_and_m_t":"The ID of the SchedulingRequestConfig that uses this scheduling request resource.","paragraph_zero_based":32371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32372},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestResourceId","paragraph_zero_based":32373},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestResourceId is used to identify scheduling request resources on PUCCH.","paragraph_zero_based":32374},{"literal_text_all_w_t_and_m_t":"SchedulingRequestResourceId information element","paragraph_zero_based":32375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb