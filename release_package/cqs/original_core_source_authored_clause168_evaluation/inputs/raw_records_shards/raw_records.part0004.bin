{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ulDedicatedMessageSegment-r16           ULDedicatedMessageSegment-r16-IEs,","paragraph_zero_based":16272},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":16273},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":16274},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16276},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment-r16-IEs ::=     SEQUENCE {","paragraph_zero_based":16277},{"literal_text_all_w_t_and_m_t":"    segmentNumber-r16                         INTEGER (0..15),","paragraph_zero_based":16278},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentContainer-r16           OCTET STRING,","paragraph_zero_based":16279},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentType-r16                ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":16280},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                  OCTET STRING                                  OPTIONAL,","paragraph_zero_based":16281},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                      SEQUENCE {}                                   OPTIONAL","paragraph_zero_based":16282},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16284},{"literal_text_all_w_t_and_m_t":"-- TAG-ULDEDICATEDMESSAGESEGMENT-STOP","paragraph_zero_based":16285},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16287},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment field descriptions","paragraph_zero_based":16288},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":16289},{"literal_text_all_w_t_and_m_t":"Identifies the sequence number of a segment within the encoded UL DCCH message. ","paragraph_zero_based":16290},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentContainer","paragraph_zero_based":16291},{"literal_text_all_w_t_and_m_t":"Includes a segment of the encoded UL DCCH message. The size of the included segment in this container should be small enough that the resulting encoded RRC message PDU is less than or equal to the PDCP SDU size limit.","paragraph_zero_based":16292},{"literal_text_all_w_t_and_m_t":"rrc-MessageSegmentType","paragraph_zero_based":16293},{"literal_text_all_w_t_and_m_t":"Indicates whether the included UL DCCH message segment is the last segment or not.","paragraph_zero_based":16294},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1cd32cd3d96614901bf3ee48d1ccaa2063ce0dc5a013b3bf9741fe9978bdaca0","bdd1c3067e9dd5e8ecbe419af7fe4d0193b19b48805ef4900688a65ef20bc6ea","43ea2d30ec3cddf123387eafa60681bb85fa15d3e2a3657c60e2433cf4d961d9","24bd2fd5c68bd909b9a8949fbd0ea3443a8f0cd1d3d4427e303b9064bea578b5","95ef139ef5a6787ebdb6c19b0199d5b4e1d9df3dd24e8a5947922d16d7e12f86","6f15c15f871600f2e686ad40f087a59c96b0e3f0543a1b57baee9b3b620fcaf8","fe7029d0ce484735cb1b09f2c3c84991d4e0a9efcf014725de78e6e5024a032b","1be69afefe7694a7ad376d8832218a7fd8a16b67fdc4118a665dcb3cf3b8f046","5cbe9ebdb73286a154a92fdba35a5572948c0e9efeee4f2756817d05506c4c11","cb9327c1779e70365f0a5f64231ab2934d6e7cec22c25a8c4175ffe6715cb5fe","1b3e37158a899991cb24ff6fb2a823a81b36fac058d386ae5893a73dac0e7256","c873f96bb67b5aaeacc439d99cc1050f