57},{"literal_text_all_w_t_and_m_t":"                p32                                     BIT STRING (SIZE (32))","paragraph_zero_based":21758},{"literal_text_all_w_t_and_m_t":"            }                                                                                            OPTIONAL,   -- Need R","paragraph_zero_based":21759},{"literal_text_all_w_t_and_m_t":"            non-PMI-PortIndication-r18              PortIndexFor8Ranks                                   OPTIONAL   -- Need R","paragraph_zero_based":21760},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":21761},{"literal_text_all_w_t_and_m_t":"        a2-parameters                           SEQUENCE {","paragraph_zero_based":21762},{"literal_text_all_w_t_and_m_t":"            nzp-CSI-RS-ResourceList-r18             SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerSet)) OF NZP-CSI-RS-ResourceIndex-r18","paragraph_zero_based":21763},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":21764},{"literal_text_all_w_t_and_m_t":"    }                                                                                                    OPTIONAL,   -- Need R","paragraph_zero_based":21765},{"literal_text_all_w_t_and_m_t":"    powerOffset-r18                         INTEGER(0..23)                                               OPTIONAL    -- Need R","paragraph_zero_based":21766},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["aa6abacd03cf7639c7cbc8abe53dcc1c7a1ba66288cbdc06ad5931cb591ad389","e5d7619bbf106e4dbcfb1dbf91e6b4b34840ebc48c43ceac0b36e9c844aea67f","0a33acf317919a289d8c63ca8ec57abd6be18b11e47893ff04ac0a9105ea0