{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1700                            RLC-Config-v1700                                    OPTIONAL,   -- Need R","paragraph_zero_based":31920},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentityExt-r17               LogicalChannelIdentityExt-r17                       OPTIONAL,   -- Cond LCH-SetupModMRB","paragraph_zero_based":31921},{"literal_text_all_w_t_and_m_t":"    multicastRLC-BearerConfig-r17               MulticastRLC-BearerConfig-r17                       OPTIONAL,   -- Cond LCH-SetupOnlyMRB","paragraph_zero_based":31922},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB4-r17                   SRB-Identity-v1700                                  OPTIONAL    -- Need N","paragraph_zero_based":31923},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":31924},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31925},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31926},{"literal_text_all_w_t_and_m_t":"MulticastRLC-BearerConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":31927},{"literal_text_all_w_t_and_m_t":"    servedMBS-RadioBearer-r17                   MRB-Identity-r17,","paragraph_zero_based":31928},{"literal_text_all_w_t_and_m_t":"    isPTM-Entity-r17                            ENUMERATED {true}                                   OPTIONAL    -- Need S","paragraph_zero_based":31929},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31931},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentityExt-r17 ::=           INTEGER (320..65855)","paragraph_zero_based":31932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31933},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-STOP","paragraph_zero_based":31934},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31936},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig field descriptions","paragraph_zero_based":31937},{"literal_text_all_w_t_and_m_t":"isPTM-Entity","paragraph_zero_based":31938},{"literal_text_all_w_t_and_m_t":"If configured, indicates that the RLC entity is used for PTM reception. When the field is absent the RLC entity is used for PTP transmission/reception.","paragraph_zero_based":31939},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":31940},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer. Value 4 is not configured for DRBs if SRB4 is configured.","paragraph_zero_based":31941},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentityExt","paragraph_zero_based":31942},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID used commonly for the MAC logical channel and for the RLC bearer for PTM reception. If this field is configured, the UE shall ignore logicalChannelIdentity.","paragraph_zero_based":31943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["68e7304b03dcb96234532df22f16b460e97534947b3138c37c9182070d804f00","920b6d4de9f3cc1b0748366fde026fbc8779d31cc850ed6e3c70350c14205f2b","baef6936aae83c71b6b3a528eede48df7f91fd9d55d6867b1aa4eee2e406d8b5","99d6309ccc768c5cb8e292da0dd091efd51461596f135edb87360cdc18b4a7f4","110fc3dc87cacf3f1e70535079cc0c723da8f87374907c9ddd4a34661f582c69","3a62e39d40f0f22403c4f898320b0a9f4d334c5bee797be0033c9c7bd6ba0725","3529a17605a37d62c05192c67f67ca63cd4839f336e1585306f108fc314c59eb","34e5d4e872ae5bc04a088937c1d87ca5cb846924cdc32822b2496644e4bbed68","f4a89fa63cb2c2738361ca0b62710ed53af3f062737d29b9d6b0f4cc31a624ac","947980b6b4d8db5bb2ce95059b396bdc3386ebe8db9fa4dd2936f20649712806","f289d753fa9bd325f813fa1832b172a8a3b51b7c600dcdc066c109bfc307ff2e","522c602978733772a0beb58500c5b3c097d2b635e64877f3180ba2334b82edf1","7f6fef487e9454de63c5be1f1c522d5dc4584de02df876454e34e9ef453dfb55","a42e515cdef23011e0e14ae07cef7becc0736531007bd50c6bb72dcc5013be80","8fb6c6f8e2df1f2373c2c23d3ec185689a8e908f2471e9fb1ee9899911a25f67","6eda04c1a8200de80d8db827a09f72b041f006198952c68d6783d7d7e187b4c1","1eb3d028af6d11164e29c34d2a79e9570cbab76f6f7d61498226cf9ac74618ec","456c05f1bc0f8a0c4e73f93a0a95c8f581186866b0133fd275ceb18756c4a10f","92adaa05cf1e028aefc7ea549569370eb974a3df199ff87e0d3d0b30c1193fe2","68d8046ee234355faddc1c9b46e27b1214cb8199be7b8e14e31767b8ced63dcc","f6ab593bf127128349a63db9466e8d2a001edeb2214491c4c078baf73c680771","b3a739d21006699a9135fbf8549ab0294c31d95b8502da27275328245ab9e5df","367136d40089d684cf2bbc70b81f36d47bdbdfce57f24fa546d93d7a83097250","c49846464a5ec89e9ca97647eca17e096ca36ab2a6393c4d5fdfee9752f40838"],"paragraph_range_zero_based":[31920,31943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31920"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":31944},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established. Network sets this to true at least whenever the security key used for the radio bearer associated with this RLC entity changes. For SRB2, multicast MRBs and DRBs, unless full configuration is used, it is also set to true during the resumption of the RRC connection or the first reconfiguration after reestablishment. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment, the network does not set this field to true. The network does not include this field if the RLC-BearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE","paragraph_zero_based":31945},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":31946},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters. RLC mode reconfiguration can only be performed by DRB/multicast MRB release/addition or full configuration. The network may configure rlc-Config-v1610 only when rlc-Config (without suffix) is set to am.","paragraph_zero_based":31947},{"literal_text_all_w_t_and_m_t":"servedMBS-RadioBearer","paragraph_zero_based":31948},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with a multicast MRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedMBS-RadioBearer.","paragraph_zero_based":31949},{"literal_text_all_w_t_and_m_t":"servedRadioBearer, servedRadioBearerSRB4","paragraph_zero_based":31950},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with an SRB or a DRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedRadioBearer. Furthermore, the UE shall advertise and deliver uplink PDCP PDUs of the uplink PDCP entity of the servedRadioBearer to the uplink RLC entity of this RLC bearer unless the uplink scheduling restrictions (moreThanOneRLC in PDCP-Config and the restrictions in LogicalChannelConfig) forbid it to do so.","paragraph_zero_based":31951},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31952},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":31953},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":31954},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":31955},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or a multicast MRB or SRB4. This field is optionally present, Need S, upon creation of a new logical channel for an SRB except SRB4. It is optionally present, Need M, otherwise.","paragraph_zero_based":31956},{"literal_text_all_w_t_and_m_t":"LCH-SetupModMRB","paragraph_zero_based":31957},{"literal_text_all_w_t_and_m_t":"This field is optionally present upon creation of a new logical channel for PTM reception for a multicast MRB. If this field is included upon creation of a new logical channel for PTM reception for a multicast MRB, it shall be present when modifying this logical channel. The field is absent for logical channels configured for an SRB and a DRB.","paragraph_zero_based":31958},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":31959},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or an SRB (servedRadioBearer). It is absent, Need M otherwise.","paragraph_zero_based":31960},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnlyMRB","paragraph_zero_based":31961},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a multicast MRB and upon modification of MRB-Identity of the served MRB. It is absent, Need M otherwise.","paragraph_zero_based":31962},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31963},{"literal_text_all_w_t_and_m_t":"–RLC-Config","paragraph_zero_based":31964},{"literal_text_all_w_t_and_m_t":"The IE RLC-Config is used to specify the RLC configuration of SRBs, multicast MRBs and DRBs.","paragraph_zero_based":31965},{"literal_text_all_w_t_and_m_t":"RLC-Config information element","paragraph_zero_based":31966},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c546cc263da42d5a66a10a66fe5f628ab859ffbc793b6d176862ea05a8ebec2d","2b151bcb8c91d4259771a1dccb53a2d2d100bfbd921fd7b5b53a29bfe26ecd35","be065e7d8862723927bc6d96cfea88631160aaed79c8e4c71ce66fb12fcadf1a","718980ca3f0a3b5e6de731f548a57ff2ad8dc853893b3871cab831ad98f889af","98ff52708c5291482a4dcd29d496f84122d18eb125096161f480b6ef02f022cd","f101885aa4fcdc8bd058cd86b624a68462e3fe94d4d2039de063ab4f5fbd066a","989b8cc73876a3210f5dcf4285f9cce21cadfa047b70b576a7a5f2fac36551c4","4a1f14ae2a62b6b6f51a8f9e56ea73bbe2f7d18f61ef5cb29545984ac216884f","638ed0ef6cdf3dc332c0af0bc1c22537b5fc521895c37c673aa7d13e6401a199","86328ad4bb4462b4ed014143c245a72a3f44147518e13736f5777291c1682001","1d7d69e2d5da30efba39adfe2970bc969bfdf050684692182a7f37a3c54e66d7","72620098d2c67b962abadac9a7ebcb630192a90f8d07f73b758c9cfba753e61f","60beec66801e6ee3413ad906172bf30e350cf1d76b72b5cf1d3537df0d003489","35f5bea785e0c04e6cece03a4761a6f74ed6d87c82212be0b886c0b1d27594ce","8975ca35d4bd1317baa9969a82c3f9fe45d2c2610f977c5551f662a2e112887a","64c1a03b1a496141ab5234ee54a8f3332a17378c45f3d0ebf62fc535092cadad","741ca594146440b39277fb4f67fc38a4de88dea7a6e0564d2a8