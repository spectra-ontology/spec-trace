h_zero_based":788},{"literal_text_all_w_t_and_m_t":"numberOfStepsDown-r18INTEGER (1..3),","paragraph_zero_based":789},{"literal_text_all_w_t_and_m_t":"stepDown-r18SpatialDelta-r18,","paragraph_zero_based":790},{"literal_text_all_w_t_and_m_t":"upperValidityDeltaAltitude-r18SpatialDelta-r18OPTIONAL, -- Need OP","paragraph_zero_based":791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["1e0b290b4dd57211e35839e9cfbd8fa082dd9344525d643b6f5aa0a9a5de4ccf","bbe20a888a27e42da74da98c0a3b89acb6fb4dc8f8c60f960bea644eec13e6a5","abda1224bdd2f21e07d1a7cc2e5d88fe953bc0b4ccafec79f309148c3ed26ecc","558303b84d25507c8a9e5c2bc1eb6ef4ec6c123a96d6be437b1e5104d8a280c6","eb49897c7790ab4121d53c247f8e65008988ed6bdf407bf4831ab96adc196d65","54023b3919143749ba0b7dfdb6d765c2de39af5eb7e59a40e10b63e902617250","9d0bf5ee280a5ad29e48a0473859c8c2918d4f8d877b4ca96d80cffec3bff338","a78a5786722823b7a6610c82fa6752ed7af7411534b6537e6b563955572ee3d7","a2ebab261a4e7ee72b50a78b6ec257536d11f62e6a1c14d020079a982e05f2c2","c57621876aaeaec37ba794929c0ac2d1c8f586e3e57372c094e13ba40542fc9b","e642f325f9e5cfcf806ec7aa490c8ed89e3b020246587e3fe4bcc2dbccdeb576","b9cc39c5288f9a321f45a754a0216e1510920dc7d66ca639e073d406172a445d","94866877efe425c6e27b49e159cb06a9dc3cd8bf347aa4b28f3c4caa180e970a","84a9758538a3a73ffc5429faa36d0f94d98e72f507676a66aca7bf6f05bcc9e8","ab92b2e8f19d9da6a76e593d26bc66b82a9f181c1b5fcd7edab289d61f5300c7","4702e946ce801e0c91d3796671935dce02416babd2cbf47a3241241d0474cacb","5738e57f1cc15f79798fef9daeaeca76eee1dff78668b44589c19c73ac540d6e","ed2a38760f412f1bb56a311be6bf2e41c5b77086c7d47938ebf3d6bba5bde97f","80725ada6cfe0d43e09c5218016bcb74b6bef1bb3a7e3bd374dc896a35a0e084","08e543a701212e0310ce3d2f03c6d35520