_m_t":"-- ASN1START","paragraph_zero_based":47252},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SOURCEIDENTITY-START","paragraph_zero_based":47253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47254},{"literal_text_all_w_t_and_m_t":"SL-SourceIdentity-r17 ::=   BIT STRING (SIZE (24))","paragraph_zero_based":47255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["46a892617e2a947c1578ab6ff2430e37dd81459df464de29e1c0a34d5519858b","deb09ae42a39eb45d09996dc92fe47cc3185be0b5d4e9709cc75f1c276895993","f18cbdfb015e7eca9a6ca3bc52e1b5e8624854bf30fa053f8881639a84431201","25c5cab63f9247c872c11090b368e3c20205f47f276a49479e0c72ff1046d20e","d4743bb1aeed38c58aff040efc4b77fee587608a5c243e292f21c7d84dfc244c","33fea89d0298e3c4ad6259eed8217164bba6894777e521f3b878cea571eb225c","85071cd7cee4b96387258efaf3cc403914d7caaa2ec1da36b66758303bc966f5","4d81a74a51ea61afa5ef8481b2d851053b9fc1604a0f88c46e9628a9e4cc94c9","ec61fd692febcc0703266ce67833a3dd1d37d301187099fcde1388ce60d0b412","597ef16d52e7c1eedb0a0b2225a1eff60889aa66988123fe70c06afe6a136c4a","c68bcef46e3dc60f86e79269ca1d3adc861e4e382633cd7d6347e246cdc018c9","c51194a11bc8daa9d9687f734831d6642aa59573e12e290ec7637549b1a271af","98d315861256812a9a7a5a572fb9e8ef077da299ebdf56fb59a9a6e1b2e72f80","fb0ac366330f3e948761b89c6803f2d2739cdd15e173f05cc2feba61ebb2c1f8","27be4287d4ee4977e73e08dca35191d1e38570ed7b3efa71b332cc3005c45dd9","b95bb85a386b7a7ed23850624693b3a875865894ddb06e5640d937ad125ffdc6","5719990618ba4891308b3a75e006666815ee803a984f8eab464b9e87eef39d92","6c780985bb6514e110f32fb570d79b4f755c94f61355340059fa8820cc6a73e1","082611a33ab5921971c85c976d3019a20caa746e580ddaebd90324b634aa4d7d","5cdd6e9d8dc7fa7c73a91b6ad32c766e305013eb4fa2099