{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceConfig","paragraph_zero_based":45384},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":45385},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":45386},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":45387},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":45388},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45389},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":45390},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":45391},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":45392},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":45393},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":45394},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45395},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":45396},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":45397},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfigExt","paragraph_zero_based":45398},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":45399},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceProhibitTimer","paragraph_zero_based":45400},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred minimumSchedulingOffset assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45401},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceReportingConfigFR2","paragraph_zero_based":45402},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform gNB about the UE's preference on multi-Rx operation for FR2.","paragraph_zero_based":45403},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceReportingConfigFR2ProhibitTimer","paragraph_zero_based":45404},{"literal_text_all_w_t_and_m_t":"Prohibit timer for multi-Rx operation preference reporting for FR2. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45405},{"literal_text_all_w_t_and_m_t":"musim-CandidateBandList","paragraph_zero_based":45406},{"literal_text_all_w_t_and_m_t":"A list of candidate bands that the network intends to use, e.g., for serving cells and for which the UE is requested to provide information on temporary restricted capabilities for MUSIM operation as specified in clause 5.7.4.3.","paragraph_zero_based":45407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d9112fab877db976c87dfb32c745a50e85dec086bfaf8e160d3a9d658def99d7","845b731f6670ac2ce6c25ebad56bf2adddd156cbbe8efc760e1ab0585f9089e6","71c4616b16562bd2fa48e5e6c28cb3e0700ab9acc9562114189d77e78b7f97bd","1b7c847600819277f2156e09be2eb453de61a1bf34ed4d3a96802206ffcf627a","88eb8f3f97c8105fdfea89d7f007c961af631c710ffa964c1f186cf3d89df425","72dc1e00547da9761bad3012b77ea9f12b01fdcb37e925a36fdc4ce2d769e5cb","717c57d6836cd4ae7eb978e049c24988f34fea71d9821d772a98d2f84891e16d","e19a0f8a2629c95cbca44b1b6afb2496244d84fd335d2c5c2e46676d9e170429","e2eae68e6b61fc4c40b9a7d143925296ebac2a4701019f5e361a002d87c1a8d8","62e072d7c1d47d969f2ae3e7e7b213f6687997a52db42273a2f52cb12cb2fbf6","190959228d64646f84406ad56ee3a1b06ccf32cd0634d6ccac41f1ad8658741e","2d4026735629049e7b0562f1ae16664618a586aedd2594ca2d9dd919f1316f73","557039555ea7eb0db531fba7384dbc8eb99a35c4f5939177816acd593271a815","a2b559a6580e425450e49f65491d921986d322ae55b1a6a6913fe81f0e7c8f82","02c546e2970ff35b2a6fce698904a9750781b04654973dfd81815716ea3b520a","ff1206e2a5ac6a78788e88013d051e13b8779f8a1f0e09348741f9cb011e458e","638498439e86e0f0a858f5ffac1399717835f71ff04d0bee86a0a2238722a24c","