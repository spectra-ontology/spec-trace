{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI-r18                   SEQUENCE {","paragraph_zero_based":33744},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI-r18                      RACH-ConfigGeneric,","paragraph_zero_based":33745},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion-r18               ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":33746},{"literal_text_all_w_t_and_m_t":"    }                                                                                                               OPTIONAL,  -- Need R","paragraph_zero_based":33747},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum2-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":33748},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum4-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":33749},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum8-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":33750},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":33751},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33752},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33753},{"literal_text_all_w_t_and_m_t":"SI-RequestResourcesRepetition-r18 ::=  SEQUENCE {","paragraph_zero_based":33754},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex-r18              INTEGER (0..63),","paragraph_zero_based":33755},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex-r18           INTEGER (0..15)                                                          OPTIONAL   -- Need R","paragraph_zero_based":33756},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33758},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIGREPETITION-STOP","paragraph_zero_based":33759},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33761},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition field descriptions","paragraph_zero_based":33762},{"literal_text_all_w_t_and_m_t":"si-RequestResourcesRepetitionNum2, si-RequestResourcesRepetitionNum4, si-RequestResourcesRepetitionNum8","paragraph_zero_based":33763},{"literal_text_all_w_t_and_m_t":"Indicates the configurations for Msg1-based SI request with Msg1 repetition for repetition number 2, 4 and 8, respectively.","paragraph_zero_based":33764},{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":33765},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfigRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33766},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfigRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["00d9fa2cbce55b6aea59cd171f43fb230954e178d325f469b9e5ceffba9f1b90","5bd45ecc44928e9a9c6679fe9a6951f8409f8b567b2563000368679b29288020","2b4c85915435cf156bb3f81c2a2372407cbca5088aec005f49c7718be992edfd","ead29808a9c3e0a9f0e6d07cd409e7770b5703d37ecd65518bed49390453ec6f","ba20601163e3b66c756b6fe05c7fe79f084dbf6c4c73713f417fc25a93b3eee6","885e133cdf8eba3de7f7b30237f03e135730fb23e381dd09fdab8469a9cb984e","af1d2765bf304c4e93365de009ca41cf9d8dbd84c53713d611fb092c24f8b1ce","61f83a3f79f579be7a005de4ea3736b0f6da9260035465be2cd89c7cc762b2c6","055c0db19401e0e1d18c64b792bcce429562de82c90d0a54a440efd087673d4c","11593fc684a9693ed4850d9795ace54d02357aafd4bd3987dcbc61acef3509d2","c24e7b5c134c5e02462a0a0e65b1ab7d38db93e52c4f23d58de8cb6742df3646","70c004f208e101c63074fd923fab4294ce641542447ccf9f25d1be8e4327e9c6","e5bd403443fc8124bad94fdcb8d32e459c6e1a82a8c0c4a4243b4e88246feed0","040cf4457a758eeafc26c7c7406d7cd9d605f39dec872b9c9902be74efbe4a8d","adec85ea3a7991308fc5a6c306d38ba7be8f44f4b30139b78a1683ef7eec8acc","f0c169fc3f46603d5a50561794afaf5b33e736fe6e9b32fc570a22945d69c7f0","f8fa8fd85e96bab8ce36ad6178aa6301ce2fbc5c4ec7457b998fca2b2fedf8a4","63c5f2f13ed4970962b75c820c900d53c6a75c1efcc773ba2f77fd7e27817cdd","f5a983e49bb968ebcb9aab3bb2751b5237b27d6483cf40bf97ddbd16c0848bde","acc8c137a6e2b878e03794429bab97dfb6556e0408da88716d977efc14e28502","15d50fd7ef68aa5f1cef804fb4b1ce7707c2b421ba906de1d7644616f2289cc2","6d81c8658fb7200454b404cc183f74733e15423dd5de1dea633d9d1c3f7b393e","75f533686a3c2726e3f793113f31fe3cbf5705bcdcdb287be848e510e703570c","f8b58f0a2a0f39e82caa52b9d6ef22f750d85bc33ebfa10dd422f4adb9e581af"],"paragraph_range_zero_based":[33744,33767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33744"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfigRepetitioNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8n is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33768},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResourcesRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 should not result in system information change notification.","paragraph_zero_based":33769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33770},{"literal_text_all_w_t_and_m_t":"–SI-SchedulingInfo","paragraph_zero_based":33771},{"literal_text_all_w_t_and_m_t":"The IE SI-SchedulingInfo contains information needed for acquisition of SI messages.","paragraph_zero_based":33772},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo information element","paragraph_zero_based":33773},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33774},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-START","paragraph_zero_based":33775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33776},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo ::=               SEQUENCE {","paragraph_zero_based":33777},{"literal_text_all_w_t_and_m_t":"    schedulingInfoList                  SEQUENCE (SIZE (1..maxSI-Message)) OF SchedulingInfo,","paragraph_zero_based":33778},{"literal_text_all_w_t_and_m_t":"    si-WindowLength                     ENUMERATED {s5, s10, s20, s40, s80, s160, s320, s640, s1280, s2560-v1710, s5120-v1710 },","paragraph_zero_based":33779},{"literal_text_all_w_t_and_m_t":"    si-RequestConfig                    SI-RequestConfig                                                OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":33780},{"literal_text_all_w_t_and_m_t":"    si-RequestConfigSUL                 SI-RequestConfig                                                OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":33781},{"literal_text_all_w_t_and_m_t":"    systemInformationAreaID             BIT STRING (SIZE (24))                                          OPTIONAL,  -- Need R","paragraph_zero_based":33782},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":33783},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33785},{"literal_text_all_w_t_and_m_t":"SchedulingInfo ::=                  SEQUENCE {","paragraph_zero_based":33786},{"literal_text_all_w_t_and_m_t":"    si-BroadcastStatus                  ENUMERATED {broadcasting, notBroadcasting},","paragraph_zero_based":33787},{"literal_text_all_w_t_and_m_t":"    si-Periodicity                      ENUMERATED {rf8, rf16, rf32, rf64, rf128, rf256, rf512},","paragraph_zero_based":33788},{"literal_text_all_w_t_and_m_t":"    sib-MappingInfo                     SIB-Mapping","paragraph_zero_based":33789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27