{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32616},{"literal_text_all_w_t_and_m_t":"RSRQ-Range ::=                      INTEGER(0..127)","paragraph_zero_based":32617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32618},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-STOP","paragraph_zero_based":32619},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32620},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32621},{"literal_text_all_w_t_and_m_t":"–RSSI-Range","paragraph_zero_based":32622},{"literal_text_all_w_t_and_m_t":"The IE RSSI-Range specifies the value range used in RSSI measurements and thresholds for NR operation with shared spectrum channel access. The integer value for RSSI measurements is according to Table 10.1.34.3-1 in TS 38.133 [14].","paragraph_zero_based":32623},{"literal_text_all_w_t_and_m_t":"RSSI-Range information element","paragraph_zero_based":32624},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32625},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-START","paragraph_zero_based":32626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32627},{"literal_text_all_w_t_and_m_t":"RSSI-Range-r16 ::=                  INTEGER(0..76)","paragraph_zero_based":32628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32629},{"literal_text_all_w_t_and_m_t":"-- TAG-RSSI-RANGE-STOP","paragraph_zero_based":32630},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32631},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32632},{"literal_text_all_w_t_and_m_t":"–RxTxTimeDiff","paragraph_zero_based":32633},{"literal_text_all_w_t_and_m_t":"The IE RxTxTimeDiff contains the Rx-Tx time difference measurement at either the UE or the gNB.","paragraph_zero_based":32634},{"litera