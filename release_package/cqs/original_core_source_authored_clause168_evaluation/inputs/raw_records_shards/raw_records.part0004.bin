:141},{"literal_text_all_w_t_and_m_t":"remoteUE-Indication-r18BOOLEANOPTIONAL,-- Cond NR","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"locationEstimateAndMeasurementReporting-r18ENUMERATED { supported }OPTIONAL","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["332e785e180cf4283762ba7944652fdc3f73978707ecc85936a902600b7472c9","8d6cc6458b03f0d725025c60f090de71d9226ae25c6bc1ef55e0e1a2a3aba2f1","9baef6f7727ba01803aadc77d66f55e814a5d0c1fb31e14ee3a43571d397fdd3","c08382a6f45116b269d1d7298f18d69cf601d4184df89b08c5321dd8fe46ec74","b64f8688eae079b48f29a973e17f76663bb3af9f8bc006d3d3b6643fa06f7987","d43f520dfd009eb8a9d094df61325db1bd159a18653ee6727495acac63d1f474","054a04944bb5957614ad35964d23436886d8bb9224d39f6e7b6369ea1a5cc17c","b3071a5aaf1c3de486d69f003da1cba9fcb0d7c484bb6b1ae84f9f91b6e13c2d","6ddcd8f426c248f5c5930cf092083df961204745c9c0d53df727a3cf7e7513f0","f1a03814b36e71974f863552415eac572f6c892fcb553409b4e88b095e7a39c3","4fe10e1121156be05a2f97c5cf451c0322868d19fb9f3a66562915c229e2a421","43f67cf3307a5c77479d12ba1223af16cc08c83b12a6fb617c092c0782da0139","055dc4046bd327b74cfa82fbf3fc7ee5337e6de9a520e4633d564639e13ec002","d98dab409312cbe98e828c5cb8fa685933306cfea860d1d075e97612fade039f","faa30b6dd5093377f5cc3f0f36c6329b23ac65a52ea9cb1c58306317e1ced3af","8ee8149c2a36981069727fe1f1b5109b9ffcef85638f7aa54e2395dc9b8dad15","2704c31283b35a5464cfd2b3ba9ad58ddd6be6eedfb04479d6b716e97e5ff9cf","1cabbed37aa5c88006191a315fa854a21c5eedaac7eb7521509b313bcb903ce9","dc2026f3ea628dc3f09f05dfb11ec20a07894ba9c717c43933ec52a1d8ee95d6","fe5fa8f4f7fdfaf737e53eb3147e0f1d883859500c784dc2e323fc0e62f9d32c","425e9234abc786e6c01ca7150a3abb6b1e8ce2399bc7a160a669919ee8072fcc","812ee0d2e5a1b5364056e3aa02d999e2f2a7f25eae8009561b312647093fa0f2","41dcb8030c87e2a50bcaacd51c49512526bc018a17ace815ce6547b1c0ba7fb6","503e6efd3a91005168c1feea62b34bbda409a18a5965e5f0c90ad0999fc64b96"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p120"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"Segmentation","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need OP, if lpp-message-segmentation-req has been received from the location server with bit 1 (targetToServer) set to value 1. The field shall be omitted if lppmessagesegmentation-req has not been received in this location session, or has been received with bit 1 (targetToServer) set to value 0.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"This field is optionally present for NR access if remoteUE-IndicationReq has been received from the location server in this location session. Otherwise it is not present.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"CommonIEsProvideCapabilities field descriptions","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"This field indicates whether this ProvideCapabilities message is one of many segments, as specified in clause 4.3.5.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"lpp-message-segmentation","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the target device's LPP message segmentation capabilities. If bit 0 is set to value 1, it indicates that the target device supports receiving segmented LPP messages; if bit 0 is set to value 0 it indicates that the target device does not support receiving segmented LPP messages.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"If bit 1 is set to value 1, it indicates that the target device supports sending segmented LPP messages; if bit 1 is set to value 0 it indicates that the target device does not support sending segmented LPP messages.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"remoteUE-Indication","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device in NR access is configured as a L2 U2N Remote UE. The target device in NR access may transmit a ProvideCapabilities message with an appropriate value of this field when it starts or stops operation as a U2N Remote UE.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"locationEstimateAndMeasurementReporting","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the PRU supports locationEstimateAndMeasurementsRequired in LocationInformationType.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"NOTE: In this version of the specification, this capability is only applicable to PRUs.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["07432682c7b9293ac9fe25645fa942e5e47b3009a51902110c49bf872c99f598","429e0e4fd021a6cd1af13fee8856260c0c3435ec6d1793cb81104c21635ca868","595c