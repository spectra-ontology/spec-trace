{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"drb-Id","paragraph_zero_based":25440},{"literal_text_all_w_t_and_m_t":"Indicates DRB value for which uplink PDCP delay ratio or value is provided, according to TS 38.314 [53].","paragraph_zero_based":25441},{"literal_text_all_w_t_and_m_t":"firstTriggeredEvent","paragraph_zero_based":25442},{"literal_text_all_w_t_and_m_t":"This field is set to condFirstEvent if the execution condition associated to the first entry of choConfig was fulfilled first in time. This field is set to condSecondEvent if the execution condition associated to the second entry of choConfig was fulfilled first in time. This field may be included in rlf-report within UEInformationResponse message or in SCGFailureInformation message.","paragraph_zero_based":25443},{"literal_text_all_w_t_and_m_t":"locationInfo","paragraph_zero_based":25444},{"literal_text_all_w_t_and_m_t":"Positioning related information and measurements.","paragraph_zero_based":25445},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":25446},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the NR cell for which the reporting is being performed.","paragraph_zero_based":25447},{"literal_text_all_w_t_and_m_t":"resultsSSB-Cell","paragraph_zero_based":25448},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":25449},{"literal_text_all_w_t_and_m_t":"resultsSSB-Indexes","paragraph_zero_based":25450},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":25451},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Cell","paragraph_zero_based":25452},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on CSI-RS related measurements.","paragraph_zero_based":25453},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Indexes","paragraph_zero_based":25454},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on CSI-RS related measurements.","paragraph_zero_based":25455},{"literal_text_all_w_t_and_m_t":"rsIndexResults","paragraph_zero_based":25456},{"literal_text_all_w_t_and_m_t":"Beam level measurement results.","paragraph_zero_based":25457},{"literal_text_all_w_t_and_m_t":"timeBetweenEvents","paragraph_zero_based":25458},{"literal_text_all_w_t_and_m_t":"Indicates the time elapsed between fulfilling the conditional execution conditions included in choConfig. Value in milliseconds. The maximum value 1023 means 1023ms or longer. This field may be included in the reports associated to UEInformationResponse message, e.g., rlf-Report or in the SCGFailureInformation message.","paragraph_zero_based":25459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25460},{"literal_text_all_w_t_and_m_t":"MeasResultUTRA-FDD field descriptions","paragraph_zero_based":25461},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":25462},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the UTRA-FDD cell for which the reporting is being performed.","paragraph_zero_based":25463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a410dc1d9719de3c65a1f2b5a3183cc8bfe0f7e0655015a9457c63ed4ba2b974","ee27f4935a084863b9f60200c5f1b5a3feda7068e282138ecb80dae2e805c630","900ea547fda54f830de5f3df0c591f994df2a4c0d1a8d61ce540ed399d450cf1","4b37cd75a53c301998161026152694337e3f9b893f5df0ec0c7bf043a7a68e10","df8f39559f3937b19a66fe5ce24a59f8340a8ca2763cb074c65346a20263d34f","73566ac8c11b7c6c233a850fb2b4f1f65629d99