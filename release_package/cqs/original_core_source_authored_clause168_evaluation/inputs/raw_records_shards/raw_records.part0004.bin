{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CondReconfigToRemoveList-r16 ::=     SEQUENCE (SIZE (1.. maxNrofCondCells-r16)) OF CondReconfigId-r16","paragraph_zero_based":20496},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20497},{"literal_text_all_w_t_and_m_t":"SK-CounterConfiguration-r18      ::= SEQUENCE {","paragraph_zero_based":20498},{"literal_text_all_w_t_and_m_t":"    sk-CounterConfigToReleaseList-r18    SEQUENCE (SIZE (1..maxSecurityCellSet-r18)) OF SecurityCellSetId-r18    OPTIONAL,    -- Need N","paragraph_zero_based":20499},{"literal_text_all_w_t_and_m_t":"    sk-CounterConfigToAddModList-r18     SEQUENCE (SIZE (1..maxSecurityCellSet-r18)) OF SK-CounterConfig-r18     OPTIONAL     -- Need N","paragraph_zero_based":20500},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20501},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20502},{"literal_text_all_w_t_and_m_t":"SK-CounterConfig-r18 ::=             SEQUENCE {","paragraph_zero_based":20503},{"literal_text_all_w_t_and_m_t":"    securityCellSetId-r18                SecurityCellSetId-r18,","paragraph_zero_based":20504},{"literal_text_all_w_t_and_m_t":"    sk-CounterList-r18                   SEQUENCE (SIZE (1..maxSK-Counter-r18)) OF SK-Counter","paragraph_zero_based":20505},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20507},{"literal_text_all_w_t_and_m_t":"SecurityCellSetId-r18 ::= INTEGER (1.. maxSecurityCellSet-r18)","paragraph_zero_based":20508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20509},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-STOP","paragraph_zero_based":20510},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20511},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20512},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration field descriptions","paragraph_zero_based":20513},{"literal_text_all_w_t_and_m_t":"attemptCondReconfig","paragraph_zero_based":20514},{"literal_text_all_w_t_and_m_t":"If present, the UE shall perform conditional reconfiguration if selected cell is a target candidate cell and it is the first cell selection after failure as described in clause 5.3.7.3.","paragraph_zero_based":20515},{"literal_text_all_w_t_and_m_t":"condReconfigToAddModList","paragraph_zero_based":20516},{"literal_text_all_w_t_and_m_t":"List of the configuration of candidate SpCells to be added or modified for CHO, CPA or CPC.","paragraph_zero_based":20517},{"literal_text_all_w_t_and_m_t":"condReconfigToRemoveList","paragraph_zero_based":20518},{"literal_text_all_w_t_and_m_t":"List of the configuration of candidate SpCells to be removed.","paragraph_zero_based":20519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dbf6360ac656651b0032d74c2326f6d791f6d751583ac0bd6f031ac07ed64ed9","6fa133637a94fe59392d8db73e357e1f8efd2f73c68a6b246eb89b23899ce4fe","f827cef8800cfd21b23efee35bd0bbe0ecfec08d507be7068252e66207022669","c8da838b18995acae4f74a6fda0c1ac1a70e80a3f46cf93b33ccc193c2ce0319","a97d60af8e52ed8125126dd2ac2034a0a6511edee726e1e2750a5459ba8eb0ca","38cd096a66438cb6538722a098ac47cb3fdfca388b4ff1d94b5ae1edc41969fa","ce6346515518de338d4513125d4b6ed5fa50af6d0a6946f2985f96e6f6659e7d","de8c80e85c0adb28696b0419c3e47ad07aa481efd920bc5de3b335c1001c5062","e1d43df30a48d60b2cdab69ac93f622e6bf151308c4e3792e467e42c58a8de97","4c0daf1219566837aa0a990d33f80f789490400943e6bf4df77826f0183ca7cd","f044908ab1b302845bd797f7c86a3ef3fd8b0ab387d09dae4105ffa1767315bb","0f84f6c6edc199d6a519532f348765fc72f5f4e7936452dc21a0dcd5c2a2abfb","9aa9c31700d8c6295e60ac1a34d9c141868e2d53beface152f57bf2ccb705ba2","8b96695ea81703c57d04848b19b6aac49c7142019774fa7a33a9d0dc206509f1","09c83e93b8a832dfc87d35d72ba53322a04b10baf227fa53d5758a05a7af600a","8709fdb020d7ac71083c64fd08c7e79da5937b37f2c18b9c28c09ea97d5b888b","2efc2471b569fc41b4e19480392212ce4621adba605febc553c0fa755f8e02bc","210195e7ad5c092b73a3a83f0b5e5170a5fc2c6e9ee819f643b3b02e08e317d1","16136f0751e89b626b4e5b65a1c42f8192271c7c11c6d502c5ca84d2172921d8","ff70b1eef322493bfeb7aa266b1eba67a92c4e6d4e7b0b4ca660c1813083c899","adb5562374c420b1da212b5aa3797326f624669745db500dc0726155e35441fd","c9ee452cb5337fd010e76f4bdb23d0619e118c3edda5fd0c324128e88d8fafc5","7868a7b74cd6b1191f9f5e25048f91d9f66920d25665d9df4927784ffa2562eb","44fbb362682ad9a685bfe98df7ea2c2757fc505de671a8f838b7ffaf206a7222"],"paragraph_range_zero_based":[20496,20519],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p20496"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"scpac-ReferenceConfiguration","paragraph_zero_based":20520},{"literal_text_all_w_t_and_m_t":"Includes the reference configuration for the candidate supporting subsequent CPAC.","paragraph_zero_based":20521},{"literal_text_all_w_t_and_m_t":"securityCellSetId","paragraph_zero_based":20522},{"literal_text_all_w_t_and_m_t":"This field is used to determine whether UE should perform security update when conditional reconfiguration containing subsequentCondReconfig is executed.","paragraph_zero_based":20523},{"literal_text_all_w_t_and_m_t":"servingSecurityCellSetId","paragraph_zero_based":20524},{"literal_text_all_w_t_and_m_t":"This field identifies the security cell set for serving PSCell.","paragraph_zero_based":20525},{"literal_text_all_w_t_and_m_t":"sk-counterConfiguration","paragraph_zero_based":20526},{"literal_text_all_w_t_and_m_t":"Includes a list of sk-Counter from which the UE should select the sk-counter used to derive S-KgNB for inter-SN subsequent CPAC. If this field is configured, the network shall not configure the field sk-Counter within the RRCReconfiguration message for conditional reconfiguration execution for subsequent CPAC.","paragraph_zero_based":20527},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20528},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":20529},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":20530},{"literal_text_all_w_t_and_m_t":"CHO","paragraph_zero_based":20531},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if the UE is configured with at least a candidate SpCell for CHO. Otherwise the field is not present.","paragraph_zero_based":20532},{"literal_text_all_w_t_and_m_t":"condInitialSCPAC","paragraph_zero_based":20533},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon the initial conditional reconfiguration, generated by the MN, which includes at least one inter-SN candidate PSCell supporting subsequent CPAC. The field is absent for any conditional reconfiguration generated by the SN. Otherwise, the field is optional, need M.","paragraph_zero_based":20534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20535},{"literal_text_all_w_t_and_m_t":"–ConfiguredGrantConfig","paragraph_zero_based":20536},{"literal_text_all_w_t_and_m_t":"The IE ConfiguredGrantConfig is used to configure uplink transmission without dynamic grant according to two possible schemes. The actual uplink grant may either be configured via RRC (type1) or provided via the PDCCH (addressed to CS-RNTI) (type2). Multiple Configured Grant configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":20537},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfig information element","paragraph_zero_based":20538},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20539},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":20540},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20541},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfig ::=           SEQUENCE {","paragraph_zero_based":20542},{"literal_text_all_w_t_and_m_t":"    frequencyHopping                    ENUMERATED {intraSlot, interSlot}                                       OPTIONAL,   -- Need S","paragraph_zero_based":20543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["831bfc70154bb056f479de57d42acbfffb088ec75a07edeab9fc05897a01b749","bdbaa222ec6c3d560c7323211908b