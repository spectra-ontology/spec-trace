{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-SchedulingRequestId","paragraph_zero_based":45624},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for this sidelink logical channel, as specified in TS 38.321 [3].","paragraph_zero_based":45625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45626},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45627},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45628},{"literal_text_all_w_t_and_m_t":"CONNECTED","paragraph_zero_based":45629},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in an RRCReconfiguration message, for a SL DRB with additional RLC bearer being configured. The field is absent otherwise.","paragraph_zero_based":45630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45631},{"literal_text_all_w_t_and_m_t":"–SL-L2RelayUE-Config","paragraph_zero_based":45632},{"literal_text_all_w_t_and_m_t":"The IE SL-L2RelayUE-Config is used to configure L2 U2N relay operation related configurations used by L2 U2N Relay UE, or L2 U2U relay operation related configurations used by L2 U2U Relay UE.","paragraph_zero_based":45633},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config information element","paragraph_zero_based":45634},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45635},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-START","paragraph_zero_based":45636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45637},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config-r17 ::=        SEQUENCE {","paragraph_zero_based":45638},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToAddModList-r17       SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-RemoteUE-ToAddMod-r17    OPTIONAL,    -- Need N","paragraph_zero_based":45639},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToReleaseList-r17      SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-DestinationIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":45640},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":45641},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":45642},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToAddModList-r18   SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-U2U-RemoteUE-ToAddMod-r18 OPTIONAL,    -- Need N","paragraph_zero_based":45643},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToReleaseList-r18  SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIdentity-r16   OPTIONAL     -- Need N","paragraph_zero_based":45644},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":45645},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45646},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0c4b3d71ad8da28882ee7901254bea49e8c756738a9b503a84c4d9cba4f03d87","d18db86d68fb76a5f57a9984cd1bfdc43b6ac4c7c799a3f88f943b2dee495512","f1535fbde9c2eb2b389f64416aa652f4a1cd8b61bfbcfea8dbddcfbb138be0f9","a6bf29db4055f23397067bed8098e55f08410361150575839f8cac78af8c341f","3e2ff49389c2e4e81451d9591d9febdd4421805d50f99538236dec0fc5c9c609","8a6695001bc1c793de37872199df9b5dc7768517e311d9f38686ed9262f406a8","16e52e2dca98b3606e27b84f3eb672912bfbe4cac863380eef453d00742f9620","85007b6343435fbcfb0350e3ddf38b8b62f5f04d2cf2b048c0ae58517fd628ca","b130f7fe92be70b2a4f947461282b7ed3f121b0cb99d59282b275c50e801cdcb","8909ba212c6f499916d2db433aedbb09e70412c7e5afb5c53bd6046cfe1fce9b","5fcb809f