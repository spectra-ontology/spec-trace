{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PCI-RangeElement information element","paragraph_zero_based":26928},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26929},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-START","paragraph_zero_based":26930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26931},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement ::=                SEQUENCE {","paragraph_zero_based":26932},{"literal_text_all_w_t_and_m_t":"    pci-RangeIndex                      PCI-RangeIndex,","paragraph_zero_based":26933},{"literal_text_all_w_t_and_m_t":"    pci-Range                           PCI-Range","paragraph_zero_based":26934},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26936},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEELEMENT-STOP","paragraph_zero_based":26937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26939},{"literal_text_all_w_t_and_m_t":"PCI-RangeElement field descriptions","paragraph_zero_based":26940},{"literal_text_all_w_t_and_m_t":"pci-Range","paragraph_zero_based":26941},{"literal_text_all_w_t_and_m_t":"Physical cell identity or a range of physical cell identities.","paragraph_zero_based":26942},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26943},{"literal_text_all_w_t_and_m_t":"–PCI-RangeIndex","paragraph_zero_based":26944},{"literal_text_all_w_t_and_m_t":"The IE PCI-RangeIndex identifies a physical cell id range, which may be used for different purposes.","paragraph_zero_based":26945},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex information element","paragraph_zero_based":26946},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26947},{"literal_text_all_w_t_and_m_t":"-- TAG-PCI-RANGEINDEX-START","paragraph_zero_based":26948},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26949},{"literal_text_all_w_t_and_m_t":"PCI-RangeIndex ::=                  INTEGER (1..maxNrofPCI-Ranges)","paragraph_zero_based":26950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["613fc0ffde3bf895b72971e21ca469a6828aeedc4adc9b9076e2f2b429be90b3","597880f551cecf1190bb61f831fd8b9557d3f53b447d3c71b9391dc6c9413032","20f887d63ed870c798d6634d44db66748251fe3c44d49904fa87d8b8677882ad","f555c0d4028677c24827ca75c98d71bccdc655fb4940fad2b818d01b4e763e0c","a6e89dafa7b8addb235a566c36e5edd95102744ef41f74aa6a05e665d26c2e0d","ae53f4a3964d9d3aa75a87648ebe0666110b0ccf3e57797c529194066677396e","6673a3e8548912688d36ad45318bd4e04a40f50a8781d55c630bc4d51f17b868","c89c25abc1acc301ca5f06b5b37104b8624385d834a39cafebc9f421b2577102","c9fccaf7a10e25e3a42fce90e15af9cd4fdce26fafefa111ea608aa5c1de74aa","5cd29dcaa5dfe14731742210a2fa8e330f7158ea6b5e5a76567c96d1bea93788","d34760cdaac46c478c5b34e89a171d02442383150ab9f1a1129b2e09f6e263f6","4c7a09a1585060b44c8bc3df959a120dfd0c3a8d73fa9340244f01c71e6de1d0","354451c6cdcac7639300b600733095a2291281046d10fd1460c1083a08765ca8","621e4f41a04b29dc7de44f63c4f35c17737ed820a3fb8a005d8f0bd4cccd82db","22b1c834ba700196e6362571887038140e4ef407f50e32e529c7dc9eb008dbc6","28d1dd623f4098861143bcd283253c492f127074c5864ab85e61fe4f2f2b3538","1b3a0b72ba3c34a749bfb439fa91f5e9bb252a1f3f30b16bee26eef14013a818","aa0d6a056e8b50b7f4a19ba8ff188fb2e202e4552c6de201be700755833de6a0","83f4cc0f0e1706285bfde36430e8ad665f52495062d270e8486e07a0ce970506","5ddc029e121a792fed3c5a9e4a53f1a40ba