{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44496},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44497},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44498},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIGCOMMON-STOP","paragraph_zero_based":44499},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44500},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44501},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PoolConfig","paragraph_zero_based":44502},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PoolConfig is used to configure NR sidelink communication resource pool.","paragraph_zero_based":44503},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig information element","paragraph_zero_based":44504},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44505},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-START","paragraph_zero_based":44506},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44507},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig-r16 ::=        SEQUENCE {","paragraph_zero_based":44508},{"literal_text_all_w_t_and_m_t":"    sl-RxPool-r16                    SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16        OPTIONAL,    -- Cond HO","paragraph_zero_based":44509},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolSelectedNormal-r16      SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need M","paragraph_zero_based":44510},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolScheduling-r16          SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need N","paragraph_zero_based":44511},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolExceptional-r16         SL-ResourcePoolConfig-r16                                            O