{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25800},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters field descriptions","paragraph_zero_based":25801},{"literal_text_all_w_t_and_m_t":"n-CellChangeHigh","paragraph_zero_based":25802},{"literal_text_all_w_t_and_m_t":"The number of cell changes to enter high mobility state. Corresponds to NCR_H in TS 38.304 [20].","paragraph_zero_based":25803},{"literal_text_all_w_t_and_m_t":"n-CellChangeMedium","paragraph_zero_based":25804},{"literal_text_all_w_t_and_m_t":"The number of cell changes to enter medium mobility state. Corresponds to NCR_M in TS 38.304 [20].","paragraph_zero_based":25805},{"literal_text_all_w_t_and_m_t":"t-Evaluation","paragraph_zero_based":25806},{"literal_text_all_w_t_and_m_t":"The duration for evaluating criteria to enter mobility states. Corresponds to TCRmax in TS 38.304 [20]. Value in seconds, s30 corresponds to 30 s and so on.","paragraph_zero_based":25807},{"literal_text_all_w_t_and_m_t":"t-HystNormal","paragraph_zero_based":25808},{"literal_text_all_w_t_and_m_t":"The additional duration for evaluating criteria to enter normal mobility state. Corresponds to TCRmaxHyst in TS 38.304 [20]. Value in seconds, value s30 corresponds to 30 seconds and so on.","paragraph_zero_based":25809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25810},{"literal_text_all_w_t_and_m_t":"–MRB-Identity","paragraph_zero_based":25811},{"literal_text_all_w_t_and_m_t":"The IE MRB-Identity is used to identify a multicast MRB used by a UE.","paragraph_zero_based":25812},{"literal_text_all_w_t_and_m_t":"MRB-Identity information element","paragraph_zero_based":25813},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25814},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-START","paragraph_zero_based":25815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25816},{"literal_text_all_w_t_and_m_t":"MRB-Identity-r17 ::=                    INTEGER (1..512)","paragraph_zero_based":25817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25818},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-STOP","paragraph_zero_based":25819},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25820},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25821},{"literal_text_all_w_t_and_m_t":"–MsgA-ConfigCommon","paragraph_zero_based":25822},{"literal_text_all_w_t_and_m_t":"The IE MsgA-ConfigCommon is used to configure the PRACH and PUSCH resource for transmission of MsgA in 2-step random access type procedure.","paragraph_zero_based":25823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f3d4b98d1326322b11949037763499f3e2e6c40860043aa628ed9e96acd27abd","e942596f173e377c2a1bb0307e1c9e9d5735fab5928864ff2620a26917ecde28","5b99b148dca3e8c9a4c38e99977c56343dd7a89c1d1b8ab62614a25aca52af8f","ad1e4d9ab58c8b337c8a040d2a6eb73c7b7feb509e248cdc34a9c70a64cb61cf","b62b711807c5df3073bfeac5a149bd863c3a84469cc851f99a4989585c1ec4a8","a9756b0d74c8ce1668ee549f501e8ec5862f409db25ab1507fc2b3fafa2db97c","cd20a22ef308fc30a502442b152b07359d0444541cba336ef77a2834e9d13573","7741c9e44b08dc83f65c0ca3b26d26502ee17e5edb191636cc4f552efe922a98","67742c2b138f7fc2d49336457527caade1982e641ad33fd80432a5a91b30401a","d5eed840cbdcdb8917d6cc61b82f701feb7789690e08770d52b46133f7234b1c","f55c613996009b443a845542e82c44ca48ce29c6d4c19fb9c70059abda64d1d3","69389fb45eb61d6d779d0d68e1b0506ea47fd4f17b7ec017baa43c5d2c5704f9","14169012b4a30ebfdb5937aafc7a32b101b09c297759341269ce5612cf2a38a0","bd