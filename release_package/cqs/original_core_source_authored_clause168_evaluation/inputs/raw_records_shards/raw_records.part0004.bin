{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdu-Session","paragraph_zero_based":32904},{"literal_text_all_w_t_and_m_t":"Identity of the PDU session whose QoS flows are mapped to the DRB.","paragraph_zero_based":32905},{"literal_text_all_w_t_and_m_t":"sdap-HeaderUL","paragraph_zero_based":32906},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for UL data on this DRB. The field cannot be changed after a DRB is established. The network sets this field to present if the field defaultDRB is set to true.","paragraph_zero_based":32907},{"literal_text_all_w_t_and_m_t":"sdap-HeaderDL","paragraph_zero_based":32908},{"literal_text_all_w_t_and_m_t":"Indicates whether or not a SDAP header is present for DL data on this DRB. The field cannot be changed after a DRB is established.","paragraph_zero_based":32909},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32910},{"literal_text_all_w_t_and_m_t":"–SearchSpace","paragraph_zero_based":32911},{"literal_text_all_w_t_and_m_t":"The IE SearchSpace defines how/where to search for PDCCH candidates. Each search space is associated with one ControlResourceSet. For a scheduled SCell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent (regardless of their presence conditions). For a scheduled SpCell in the case of the cross carrier scheduling, if the search space is linked to another search space in the scheduling SCell, all the optional fields of this search space in the scheduled SpCell are absent (regardless of their presence conditions) except for nrofCandidates.","paragraph_zero_based":32912},{"literal_text_all_w_t_and_m_t":"SearchSpace information element","paragraph_zero_based":32913},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32914},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-START","paragraph_zero_based":32915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32916},{"literal_text_all_w_t_and_m_t":"SearchSpace ::=                         SEQUENCE {","paragraph_zero_based":32917},{"literal_text_all_w_t_and_m_t":"    searchSpaceId                           SearchSpaceId,","paragraph_zero_based":32918},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                    ControlResourceSetId                                        OPTIONAL,   -- Cond SetupOnly","paragraph_zero_based":32919},{"literal_text_all_w_t_and_m_t":"    monitoringSlotPeriodicityAndOffset      CHOICE {","paragraph_zero_based":32920},{"literal_text_all_w_t_and_m_t":"        sl1                                     NULL,","paragraph_zero_based":32921},{"literal_text_all_w_t_and_m_t":"        sl2                                     INTEGER (0..1),","paragraph_zero_based":32922},{"literal_text_all_w_t_and_m_t":"        sl4                                     INTEGER (0..3),","paragraph_zero_based":32923},{"literal_text_all_w_t_and_m_t":"        sl5                                     INTEGER (0..4),","paragraph_zero_based":32924},{"literal_text_all_w_t_and_m_t":"        sl8                                     INTEGER (0..7),","paragraph_zero_based":32925},{"literal_text_all_w_t_and_m_t":"        sl10                                    INTEGER (0..9),","paragraph_zero_based":32926},{"literal_text_all_w_t_and_m_t":"        sl16                                    INTEGER (0..15),","paragraph_zero_based":32927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8cbab56d2ddc932e5c49a42f8a0248b41647c2d131ef430e3dd252da2bebae15","ef583