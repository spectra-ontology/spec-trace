{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Source system","paragraph_zero_based":52056},{"literal_text_all_w_t_and_m_t":"sourceConfig","paragraph_zero_based":52057},{"literal_text_all_w_t_and_m_t":"rrm-Config","paragraph_zero_based":52058},{"literal_text_all_w_t_and_m_t":"as-Context","paragraph_zero_based":52059},{"literal_text_all_w_t_and_m_t":"E-UTRA/EPC","paragraph_zero_based":52060},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52061},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":52062},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52063},{"literal_text_all_w_t_and_m_t":"E-UTRA/5GC","paragraph_zero_based":52064},{"literal_text_all_w_t_and_m_t":"May be included, but only radioBearerConfig is included in the RRCReconfiguration.","paragraph_zero_based":52065},{"literal_text_all_w_t_and_m_t":"May be included","paragraph_zero_based":52066},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52068},{"literal_text_all_w_t_and_m_t":"–CG-Config","paragraph_zero_based":52069},{"literal_text_all_w_t_and_m_t":"This message is used to transfer the SCG radio configuration as generated by the SgNB or SeNB. It can also be used by a CU to request a DU to perform certain actions, e.g. to request the DU to perform a new lower layer configuration.","paragraph_zero_based":52070},{"literal_text_all_w_t_and_m_t":"Direction: Secondary gNB or eNB to master gNB or eNB, alternatively CU to DU.","paragraph_zero_based":52071},{"literal_text_all_w_t_and_m_t":"CG-Config message","paragraph_zero_based":52072},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":52073},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-START","paragraph_zero_based":52074},{"literal_text_all_w_t_and_m_t