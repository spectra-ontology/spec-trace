{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                ...","paragraph_zero_based":33072},{"literal_text_all_w_t_and_m_t":"            }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":33073},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":33074},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":33075},{"literal_text_all_w_t_and_m_t":"    }                                                                                                   OPTIONAL    -- Need R","paragraph_zero_based":33076},{"literal_text_all_w_t_and_m_t":"    ","paragraph_zero_based":33077},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33079},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-STOP","paragraph_zero_based":33080},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33082},{"literal_text_all_w_t_and_m_t":"SearchSpace field descriptions","paragraph_zero_based":33083},{"literal_text_all_w_t_and_m_t":"common","paragraph_zero_based":33084},{"literal_text_all_w_t_and_m_t":"Configures this search space as common search space (CSS) and DCI formats to monitor.","paragraph_zero_based":33085},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":33086},{"literal_text_all_w_t_and_m_t":"The CORESET applicable for this SearchSpace. Value 0 identifies the common CORESET#0 configured in MIB and in ServingCellConfigCommon. Values 1..maxNrofControlResourceSets-1 identify CORESETs configured in System Information or by dedicated signalling. The CORESETs with non-zero controlResourceSetId are configured in the same BWP as this SearchSpace except commonControlResourceSetExt which is configured by SIB20. If the field controlResourceSetId-r16 is present, UE shall ignore the controlResourceSetId (without suffix).","paragraph_zero_based":33087},{"literal_text_all_w_t_and_m_t":"dummy1, dummy2","paragraph_zero_based":33088},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":33089},{"literal_text_all_w_t_and_m_t":"dci-Format0-0-AndFormat1-0","paragraph_zero_based":33090},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI formats 0_0 and 1_0 according to TS 38.213 [13], clause 10.1.","paragraph_zero_based":33091},{"literal_text_all_w_t_and_m_t":"dci-Format2-0","paragraph_zero_based":33092},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_0 according to TS 38.213 [13], clause 10.1, 11.1.1.","paragraph_zero_based":33093},{"literal_text_all_w_t_and_m_t":"dci-Format2-1","paragraph_zero_based":33094},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_1 according to TS 38.213 [13], clause 10.1, 11.2.","paragraph_zero_based":33095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b26c9fd22f4c8bfabc4326097065e17c2b0d13be5efb00f2011bfb000e3c3fd7","6f064cb497d82d536b758fbc118e58b72d016fd4dec3df75334bd65bbdf85e3e","19e8cd0cc2cedb7832352e92db150b0803e7afa8859a43bd0481fb3d63ab057e","e9cf04097e2fdf5f21dafb21d9fcf43aef64dea904e60bd81fabf8f350d2b679","7c00fc8f02d66229a6c5e71e9f85371c8f7ad91376bed8c19cfa04acc578bb0c","85dc554d28af7f75d76b35d72930026258ea105ee793a742fb89e5b2a77f6355","15531364fc86ade69cc4ddb2256b5121566ee0c45415e0daa749b112e6989e51","a70