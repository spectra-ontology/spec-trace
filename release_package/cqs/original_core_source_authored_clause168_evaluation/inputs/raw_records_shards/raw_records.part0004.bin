{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35401},{"literal_text_all_w_t_and_m_t":"SRS-PosTx-Hopping field descriptions","paragraph_zero_based":35402},{"literal_text_all_w_t_and_m_t":"bwp","paragraph_zero_based":35403},{"literal_text_all_w_t_and_m_t":"For RRC_CONNECTED state, indicates the frequency region outside of active BWP for SRS for positioning frequency hopping. For RRC_INACTIVE state indicates the BWP configuration for SRS for Positioning during the RRC_INACTIVE.","paragraph_zero_based":35404},{"literal_text_all_w_t_and_m_t":"srs-PosConfig","paragraph_zero_based":35405},{"literal_text_all_w_t_and_m_t":"Provides the SRS Configuration to be used for frequency hopping.","paragraph_zero_based":35406},{"literal_text_all_w_t_and_m_t":"srs-PosUplinkTransmissionWindowConfig","paragraph_zero_based":35407},{"literal_text_all_w_t_and_m_t":"UL time window for UL SRS for positioning with Tx hopping configured to be periodic with configurable starting SFN, slot and symbol number, periodicity, duration.","paragraph_zero_based":35408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35409},{"literal_text_all_w_t_and_m_t":"SRS-PosUplinkTransmissionWindowConfig field descriptions","paragraph_zero_based":35410},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":35411},{"literal_text_all_w_t_and_m_t":"Indicates the duration of the uplink SRS for positioning transmission window with frequency hopping. Value s1 indicates 1 slot, s2 indicates 2 slot and so on.","paragraph_zero_based":35412},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":35413},{"literal_text_all_w_t_and_m_t":"Indicates the Periodicity and slot offset for uplink SRS for positioning transmission window occurrence with frequency hopping.","paragraph_zero_based":35414},{"literal_text_all_w_t_and_m_t":"startSFN","paragraph_zero_based":35415},{"literal_text_all_w_t_and_m_t":"Indicates the starting SFN of the uplink SRS for positioning transmission window with frequency hopping.","paragraph_zero_based":35416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35417},{"literal_text_all_w_t_and_m_t":"–SRS-PosResourceSetLinkedForAggBW","paragraph_zero_based":35418},{"literal_text_all_w_t_and_m_t":"The IE SRS-PosResourceSetLinkedForAggBW provides the SRS Positioning Resource Sets that are linked for bandwidth aggregation.","paragraph_zero_based":35419},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW information element","paragraph_zero_based":35420},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35421},{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-POSRESOURCESETLINKEDFORAGGBW-START","paragraph_zero_based":35422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2ddd79bad250a11c582654710faf0260a7a9eee6b75aef3406973bc6dfd7f34a","0d68d61716cbd82024a9056ebb176988d4c6de3b6edf293a12200d4f327ed24d","e89252c41da7923094550fa9214823ebea6c9a9703f224be7b449f574208ce2f","b8af433ccfe715339f068a359e1ae53d1eaba989319d73c41c27c62e9548ed4d","ecbc1dad005285b02bf864d7f846e4f43ddb80ba84a0ef4640e61fdb7193213e","fd51ff078b96106c304b95ae75bdcaeca495a3c1f5534ff7b0a73af6d93db3f8","87ab6b260f825fdafab1127915fcc5d3e7829f82e8e4fa064e1b011db397044a","be95ffe3e423e4a3c4d85651911c83cf8994593fc940477c2e6c076652e502e4","290923c3397d7e39ab528a5f46733bbf35d7e2627484e044efdd2ce7272ac2fb","c1522b678