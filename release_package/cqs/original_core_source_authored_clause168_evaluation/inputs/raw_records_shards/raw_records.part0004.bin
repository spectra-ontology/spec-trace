{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors information element","paragraph_zero_based":34560},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34561},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-START","paragraph_zero_based":34562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34563},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors ::=          SEQUENCE {","paragraph_zero_based":34564},{"literal_text_all_w_t_and_m_t":"    sf-Medium                           ENUMERATED {oDot25, oDot5, oDot75, lDot0},","paragraph_zero_based":34565},{"literal_text_all_w_t_and_m_t":"    sf-High                             ENUMERATED {oDot25, oDot5, oDot75, lDot0}","paragraph_zero_based":34566},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34567},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-STOP","paragraph_zero_based":34568},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34569},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34570},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors field descriptions","paragraph_zero_based":34571},{"literal_text_all_w_t_and_m_t":"sf-High","paragraph_zero_based":34572},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in High Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, oDot75 corresponds to 0.75 and so on.","paragraph_zero_based":34573},{"literal_text_all_w_t_and_m_t":"sf-Medium","paragraph_zero_based":34574},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in Medium Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, value oDot75 corresponds to 0.75, and so on.","paragraph_zero_based":34575},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34576},{"literal_text_all_w_t_and_m_t":"–SPS-Config","paragraph_zero_based":34577},{"literal_text_all_w_t_and_m_t":"The IE SPS-Config is used to configure downlink semi-persistent transmission. Multiple Downlink SPS configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":34578},{"literal_text_all_w_t_and_m_t":"SPS-Config information element","paragraph_zero_based":34579},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34580},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-START","paragraph_zero_based":34581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34582},{"literal_text_all_w_t_and_m_t":"SPS-Config ::=                  SEQUENCE {","paragraph_zero_based":34583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9cb96f9d77a3bfe7ad70ea8bcf4e483982dd35bdf12d45322171027416b33e8d","a0f98370910d06d5c2a47017e57ad2294dff380ac969dee7ffeebe6bf7dbefdf","f069148daf761c29ad71d7ae59fcbbc1634d7b3eef813bb02411a588e626d685","d82cf50d0810baea7aad93bd1b23acf532938e857b4221e3e9d7cf2ecd04eda5","64a3732eab17a639dc3bb4dc425d62392a82472b05699c8be85e3495d9241c0f","2287579e847b91f6b5f2783de1163a8de4de10738029646d6f77a67fb6907fe3","68d010fe771f8bd9df10add26d019bf2c6ea7b22ad99a1c8f6af54e7fbb53fea","f98d009f7bf3282359417b5a01a8a360f38011b9079b58ad5c34938ecc8a2beb","73d24393cff1cdf7f29d293f47338f0a6d73390e30ea580e86699121ab5c97ee","e705edba532ad0d6173747402a382d07027e9a8dbb821a4a5fc0dbb1058d2bcb","e93559fd784a45d665901a121ea370c61eade39596cdb58e195cd