{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW-r18::= SEQUENCE {","paragraph_zero_based":35424},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetLinked-r18             SRS-PosResourceSetId-r16,","paragraph_zero_based":35425},{"literal_text_all_w_t_and_m_t":"    freqInfo-r18                             ARFCN-ValueNR                                             OPTIONAL,  -- Need R","paragraph_zero_based":35426},{"literal_text_all_w_t_and_m_t":"    ul-bwp-ID-r18                            BWP-Id                                                    OPTIONAL,  -- Cond ConnectedMode","paragraph_zero_based":35427},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrier-r18                  SCS-SpecificCarrier                                       OPTIONAL,  -- Need R","paragraph_zero_based":35428},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35429},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35431},{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-POSRESOURCESETLINKEDFORAGGBW-STOP","paragraph_zero_based":35432},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35434},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW field descriptions","paragraph_zero_based":35435},{"literal_text_all_w_t_and_m_t":"freqInfo","paragraph_zero_based":35436},{"literal_text_all_w_t_and_m_t":"Indicates the SRS Positioning Resource set carrier frequency that is linked for bandwidth aggregation.","paragraph_zero_based":35437},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrier","paragraph_zero_based":35438},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A and to be used for SRS for positioning bandwidth aggregation.","paragraph_zero_based":35439},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetLinked","paragraph_zero_based":35440},{"literal_text_all_w_t_and_m_t":"Indicates the SRS Positioning Resource set that is linked for bandwidth aggregation.","paragraph_zero_based":35441},{"literal_text_all_w_t_and_m_t":"ul-bwp-ID","paragraph_zero_based":35442},{"literal_text_all_w_t_and_m_t":"Indicates the SRS Positioning Resource set uplink bandwidth ID that is linked for bandwidth aggregation.","paragraph_zero_based":35443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35444},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35445},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35446},{"literal_text_all_w_t_and_m_t":"ConnectedMode","paragraph_zero_based":35447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c60320afa2a4b37e71c5784a91d202445889e0b9b059f99c4cb8779fef5dc6e6","62f912a3b71e03993c43023608336b5086d74161d3f1c858f5e66d05a1c823e5","b86481ed0cf0ddfae7470538536af8b569a47c5449d0b7ce7f54365ac5441974","c0f77c17217c10f9d3be58909406e5a1e905e2bc18b6b0a1906d1bf33f125e37","881ecbf48a0c5e92759c69461ba80be490e38fc33413f28510ffbb24a163f217","2581ce8b47d472e3b6576c646c8646f6378715269f5f0cae373d03ef00b9bc63","0abb6be33b4494cfec7df79a90965cf4650cc07b2b65a98f192184ac1e4dcebd","0925e83d3bfb4c93c7ff8b66e192a0d5173b21214f2eaaf0e121e02939c60bf5","60f37db054268c4cf53ecd506177599c4c1da8f3fd3029fc8920338431dc707d","11b0643f84db6dc2b0945faba0796c65fb86984e631a9b041c930ba29a421418","081fbc30d74e062a43121f