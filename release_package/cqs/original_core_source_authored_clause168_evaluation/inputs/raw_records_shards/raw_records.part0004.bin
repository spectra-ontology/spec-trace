{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FeaturePriority-r17 ::= INTEGER (0..7)","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"MT-SDT-ConfigCommonSIB-r18 ::=       SEQUENCE {","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"    mt-SDT-RSRP-Threshold-r18            RSRP-Range                                                            OPTIONAL, -- Need S","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"    sdt-LogicalChannelSR-DelayTimer-r18  ENUMERATED { sf20, sf40, sf64, sf128, sf512, sf1024, sf2560, spare1}  OPTIONAL, -- Cond MT-SDT1","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"    t319a-r18                            ENUMERATED { ms100, ms200, ms300, ms400, ms600, ms1000, ms2000,","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"                                                      ms3000, ms4000, spare7, spare6, spare5, spare4,","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"                                                      spare3, spare2, spare1}                                  OPTIONAL  -- Cond MT-SDT2","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB1-STOP","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"SIB1 field descriptions","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"barringExemptRedCap","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell allows IMS emergency bearer services for RedCap UEs, if these UEs consider the cell as acceptable cell as specified in TS 38.304 [20].","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"cellBarred2RxXR","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is barred for 2Rx XR UEs. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated as specified in TS 38.101-1 [15]. If this field is absent on a cell operating in a frequency band where 4RX antenna ports are mandated, a 2RX XR UE shall treat the cell as not barred, as specified in TS 38.304 [20].","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"cellBarredATG","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to ATG, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to ATG. If not present, the UE considers the cell is not allowed for connectivity to ATG, as defined in TS 38.304 [20]. This field is only applicable to ATG-capable UEs.","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap1Rx","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["bc1cb5f99d13f868711e622658018d2a566e62e07107da07e7dc91b6ddaffae6","3ab359e1c22c240582334815b531abb16d891caedefd575a373b3d5844dc14f9","0b3f49d5757ab711675fa803ab43ca5d9fc713f3059ef0fae7a4a26f87f9cba9","765b5a38ccb6bb96d9c35c58fa3b17c0d79da17dc08ffb7d46f2df5a983e5be5","0665a2f4baf35a573c87831c9006cb8fb378daf00fd9feaa0e662a0598d6e515","4af3795aea15b206cadded88ec8da217101c32830beb02aa63e5962587f258bd","2aba16806cc8db095bd265b411662431076dcfd9268076917f6416de5aa2b581","bad38575e2037c4ddcf33a284a267bd4d85c5ac6eed49fa346244dc18fc105df","eee57c9b785986a65599e71306295818e67e55ae1b2874441e5026f56dd8aa0e","05de4130baa66c3758931f532a898547d2f9831c4a818d1400b2130f47920f7a","42791d6e20af0ff72c3f9565b31a74ef364a8b9e9859ce16b4816504a5477541","58438be174050bd27824ce848a219fcaba4abb69b5218c800797c8f8e915119d","29aeefd0cb8caf310e97e416809ce813f3ad72b2d90308b8bf464072fea1e379","6c2fe0b3dbb16be29fb3b5d6d3bd9c8bbb7cea05154066c13e3d44723317cb7b","07954e1b2291bcbd932ea6518a9a1348addd6a68b163dce303cacbc1afe07e47","753185f477677b46d317d12ab8dee0eda3e8cd5eaf51a40d28283c9f57e13b8b","8f5e47a7ee91119a09d23210b1d89bf8627e9e74850e4586ccccd59d2a683685","f0334f43cd06c21c7d27974e2264eda404fbaf11f3b85b2f4436cfc3515816ad","945332ab01672504294ddc2b19555bc17ca2e25485b36306f5f0d62f7179c66d","66fbfc8a19a153a263d1e9f02fac6d9a996f315d5586600b0560b0fe676cd96e","7bf5580227d85f07ff75003e93bd69f8f06dc7c7997e23ee2feaeed843ed885f","bd030f7094269223e8dba5434608799c0760e5fe490f54e54c09f1a03c1a3dac","d16b6b014d56cadea49e589c43e3ea46179e01ecdc03b5d0dbfc97d18e5c88cc","e621395d0d9289ff57efa58fe3f2f7e39014dce29644a6393e5048587233ef1b"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p264"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap2Rx","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"cellBarredFixedVSAT","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for fixed VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for fixed VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"cellBarredMobileVSAT","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for mobile VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for mobile VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"cellBarredNES","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"This field indicates the cell barring status for UEs supporting nes-CellDTX-DRX as described in 5.2.2.4.2.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"cellBarredNTN","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to NTN, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to NTN. If not present, the UE considers the cell is not allowed for connectivity to NTN, as defined in TS 38.304 [20]. This field is only applicable to NTN-capable UEs.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap1Rx","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap2Rx","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"cellSelectionInfo","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"Parameters for cell selection related to the serving cell.","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"eCallOverIMS-Support","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports eCall over IMS services as defined in TS 23.501 [32]. If absent, eCall over IMS is not supported by the network in the cell.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedIdle","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for CN paging is allowed in the cell for UEs in RRC_IDLE or RRC_INACTIVE. The UE shall stop using extended DRX for CN paging in RRC_IDLE or RRC_INACTIVE if eDRX-AllowedIdle is not present.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedInactive","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"The presence of eDRX-AllowedInactive-r17 this field indicates that extended DRX cycle equal to or shorter than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle equal to or shorter than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r17 is not present. The presence of eDRX-AllowedInactive-r18 indicates that extended DRX cycle longer than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle longer than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r18 is not present.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as (e)RedCap, Slicing, SDT, MSG1-Repetitions and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["37e16d19bd57dc8c13590e218cdbeda42df980be4fb1901de182ba024b3c6e32","b7a3565bf11be74cbe550f9a779a44b27aab4f5527f20d22ec2dcadabfecf4e9","8c0f46b597a83a65f66c4cdc6b9094fcb3ac88267415804dfff072c4dee61f31","3185480383f1d06928ca06eb49ca766adc5822c76406016c35f5d856ae2367ca","adeb4ad87823a60f0747576c1ad91448cb99e1b51a0cc520e087e4bc8b5503ab","739b3d10fbb7d9d59efe630f3a0d375880d285ad28deed12f5ed9b117ba46129","b1811e2890525d559081fd91a9ab2f1f457409353e7dda3f2ae46bace7707ce6","aa2026a3a78b8a177a1ce67bfa6db3b18268bb7644c27c0597cc65e8bf966c77","e338d0f34462a68e3f983f07d52274aab5495843392e60c273ddcae454fa2d13","89801cef5d28aaf5106d6b42cc77cd3b2e960eb0fa4e627f46c5378e87bd5764","db9dce3d202d35f015bc6b0f023d682df8555f496b565be78c6f5a2ef3fcb440","478057f95fd9fc87fa9ad05907167b83a3a25b146fc217ef45f1edf8f0dd1cb9","ea03e213f69c7d747d19622829de0e232a3cb6fc95c2c23f111f618e383f98b7","2fe3aae7578fdb921d7eb038c91f7623a28fb29bc0bbc4bf71c918a69444cd57","e92c4fc2b139f26b1cf554e85c36c2b115299c94ded008c46e57755b60da5fde","36670e980d65ea4cb96b9eddbd70fbe7ac00dbec9fdd51545affe8b518e8fda7","a8daf2becc5d7f6d29cac4f7275eaccfd90ea2049b3dd2a55e32798049122306","dcb5b51fc7986b31726f6f2985481b2cc9997682b0b63a8ec74a1fbf217c220f","af6f0a5eae38b11ac88e473691a2f427333630045c74fca3d49d057090630f51","f45c0627b502d3b586cd1628bd5920d59c8f2c2e9f342083f226c1a53cb4a9b1","b61ad106fe1ecf1455e2c259a597afe1d06a750c4ac7dbeca4273e8591033358","1a0585f4b5c3ca5b0883d8d548bd28c8f58f005d446b4351bb9df6367f1528fc","87163c0f35ab29b4c27d391ced1339d54d2feac05ae257ea71fa0590731eaade","247afa3e0f304616677b0dc0d8e02ae43a9160ac76972b6dbfcc41692e3d137f"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p288"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"halfDuplexRedCap-Allowed","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the cell supports half-duplex FDD (e)RedCap UEs.","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"hsdn-Cell","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"This field indicates this is a HSDN cell as specified in TS 38.304 [20].","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"Indicates hyper SFN which increments by one when the SFN wraps around. This field is excluded when determining changes in system information, i.e. changes of hyper SFN should not result in system information change notifications.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsEUTRA","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for EUTRA idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform EUTRA idle/inactive measurements.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsNR","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform NR idle/inactive measurements.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"ims-EmergencySupport","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports IMS emergency bearer services for UEs in limited service mode. If absent, IMS emergency call is not supported by the network in the cell for UEs in limited service mode.","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"intraFreqReselection2RxXR","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"This field controls cell selection/reselection to intra-frequency cells for 2Rx XR UEs when this cell is barred or treated as barred by the 2Rx XR UE, as specified in TS 38.304 [20]. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated, as specified in TS 38.101-1 [15].","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"intraFreqReselection-eRedCap","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for eRedCap UEs when this cell is barred, or treated as barred by the eRedCap UE, as specified in TS 38.304 [20]. If not present, an eRedCap UE treats the cell as barred, i.e., the UE considers that the cell does not support eRedCap.","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"intraFreqReselectionRedCap","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for RedCap UEs when this cell is barred, or treated as barred by the RedCap UE, as specified in TS 38.304 [20]. If not present, a RedCap UE treats the cell as barred, i.e.,the UE considers that the cell does not support RedCap.","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"mobileIAB-Cell","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that this is a mobile IAB cell.","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"mt-SDT-RSRP-Threshold","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether MT-SDT procedure can be initiated, as specified in TS 38.321 [3]. If the field is absent, and the field sdt-RSRP-Threshold is present, the UE applies the value in the field sdt-RSRP-Threshold.","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"musim-CapRestrictionAllowed","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to send the musim-CapRestrictionInd in RRCSetupComplete and RRCResumeComplete messages.","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["bc999b5dd9febc2d5b5c876139e6a58079ff73f40539f3dafba6cdb853df7a58","416d37479d75d8cedf44348f1ad66761a043631933f4502d264efab404d87954","c36aabf7cc527316ffb3c7963db8cb3e74f93f74c0954d6d900c147b25daa16d","441f7472747b8d1aeb9ad46c96370ebac7de76610e1f696b6b1b2ed06cd9298b","5d619d4f985caa60140889c6c5cf5388edab5f813bfdba6f351886c65735306a","114c445560ac15369c1a3f8f193c7814657ed71a8b86f912814699258ae75805","30520125af43b9f4e8d932439407b2639413e202dc73567f0eb0e49f3d01f73f","d64d2a3c2174b37c2d23ed1f46d4f4d55a579973ce89db8c9e27f006ed90c2fb","c58544ae9a47b8ff7875f58f56ae8d0a1f3cc0c4225198a9f64d6fb1d4e0c973","8632217d021312428874a8ce19dba1e9363b377f27b493a35e922197bce3c23a","b995a470e13aad69da34cdb488893f35f94f85e6ee790b3bd84a5e4e181682e0","92af9ccab8d782ea37e2376ec47cd9f6a74b0e9c3ce171f6aa34beca8862c8f8","7ac74481c6554be3c2ce718a0efd3d821d80be7a7fd46643778823f98c324194","4e343e6cac8c07bb6d9155a4ec6fbde8b884d41f4172cafe42f14e5f7997a476","076b10d931917db249e43b70502b8ef87f82ef41802df96c9c7b7d64682988b5","137ad088bff70dd7107b1dcd926416756417149c78ad90e0ac3c15546ba68606","a371513ae38fc70ba25fbfc508f0ead7de199b5604e72faaa186a05866d03a5a","9365b150af7e5b239759e88adc27952b59e15e1cf9706b67780f3035bddb22db","24af2142e9cd5bf4a6c964af387833c5ecee975a1ba94462aa09a100b46cbdbe","d1499796ec377b8dfe6e736f0cb10749f4bbf23c83b6e320e574cc18e3bf0ac0","5e104fb9eb1beb0b9418af1e5c3eecf209694859c125fcbbf55e21e011e5cac9","fbd048239ca63e2ad546cbac918d5daf36a37836caee6db8f5cf412654e16331","2d8d1076313fd1c589fb0071d2762c87f27e163b7dc649b70b0ce95fd2fcb17d","f804592f7cb39ca63f0b62c637d67963e2b4ac40e3ade5389333e97536d1f8b0"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p312"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ncr-Support","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"This field combines both the support of NCR and the cell status for NCR. If the field is present, the cell supports NCR and the cell is also considered as a candidate for cell (re)selection for NCR-node; if the field is absent, the cell does not support NCR and/or the cell is barred for NCR-node.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"nonServingCellMII","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Indicates whether the MBSInterestIndication message for MBS broadcast reception on a non-serving cell is allowed to be transmitted to the serving gNB.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for serving cell. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"q-QualMinOffset","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffset\" in TS 38.304 [20]. Actual value Qqualminoffset = field value [dB]. If the field is absent, the UE applies the (default) value of 0 dB for Qqualminoffset. Affects the minimum required quality level in the cell.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffset","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffset\" in TS 38.304 [20]. Actual value Qrxlevminoffset = field value * 2 [dB]. If absent, the UE applies the (default) value of 0 dB for Qrxlevminoffset. Affects the minimum required Rx level in the cell.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"reselectionMeasurementsNR","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR reselection measurements shall report availability of these measurements when establishing or resuming a connection in this cell.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"sdt-BeamFailureRecoveryProhibitTimer","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"The value of the prohibit timer used for RACH for beam failure indication during SDT as specified in TS 38.321 [3]. Value ms50 corresponds to 50 milliseconds, value ms100 corresponds to 100 milliseconds and so on.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"sdt-DataVolumeThreshold","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"Data volume threshold used to determine whether SDT can be initiated, as specified in TS 38.321 [3]. Value byte32 corresponds to 32 bytes, value byte100 corresponds to 100 bytes, and so on.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"sdt-LogicalChannelSR-DelayTimer","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"The value of logicalChannelSR-DelayTimer applied during SDT for logical channels configured with SDT, as specified in TS 38.321 [3]. Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on. If sdt-LogicalChannelSR-DelayTimer-r18 is absent and sdt-LogicalChannelSR-DelayTimer-r17 is present then, the UE applies the value configured in sdt-LogicalChannelSR-DelayTimer-r17 for this field. If this field is not configured, then logicalChannelSR-DelayTimer is not applied for SDT logical channels.","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"sdt-RSRP-Threshold","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether SDT procedure can be initiated, as specified in TS 38.321 [3].","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["8803ea1922ed5be793f6d95916376d90510b44bbb7751e58a53c8665c6a5618d","83bd148aaab4d1b52fa58636389425aa4c36e9533ab3284ac1fc893f96c81d89","1dcbe4cb1c7a895617350492a3ea61106f7cc5eeb3b415b85f5c2c31521dc2e3","5a7d9d6584e798463d430c34220c67ce4c60e136e405f5ad7176eebfdd10f2b3","f2e4b91bffecf4e3da94bcd06939cbc431c9b586683c94c0629ca264520bacad","2f0fdd77964bd5087d20e6b2ed54d899cb6d4e531be9939b008aa77d9a37ce73","39a0b6e1eee8865a044a0f6fe28853e74cffca28e1a6965c4d1bf3fcdce6b8e2","7d4e7973e1e271dc46c8e56386c765527acd9c76a98edbda42c3f9036460dcdb","c6466b36ad4d47a1f67f1de24e7dc0148dbd8a4c2c067e6867fae62af302c282","aa1ab558fee9ddbde4224db910b5338f8ba4a6d6e91e009e4960ba5e00955b34","a94cd539dab7681e68f7129c84ac52f837e74167525f082687195b0dc80e80a3","98e567d3af9b4ab7180143c6b87d545c051cce05a1c8089f316d5c912cd27679","a2a1a0be22cbbeadd0f1882c8df76f06e59104002bfbe0d658cc947e9284250b","81b20e9ca2e016d182feb02473773c000a0170156c2284ad3b28cbf8c79e8bbc","6cf52f69a159813b754b27455e954350365f4f8427a399c6e34ca846213f1f06","4ce1463cbd5fa6e6418bbc8dadd1dd0bc1a98e78b9e8b4ea0608d87ae3131591","3fe51c90599ba19432d78981442bca15c0fe31c8af61a19992688fb14c08383f","8e3bb96e0efa08b696e9e3a8a690d9104ead0a2598077753218b619ebd4fcfa3","e8bd6d7985c9045734e4c3e8977c52fead7759086fb05c451f346066d8cd63fa","fc0ab0a7702e6811e4ef7dc4a59d533ad22303805aa45a8e99a970d24a67d127","9fa2576063ee38aeba6002541b2f8e4842dee4fab1153092decda3045adef9d3","5bddd55a5577f53a2b6cc184f78184191132873133212c43bb68a41a15fbd735","894f5cf9e501255e2a4a23707760a652e201e36fb32de9a644d927bcb4db9c41","065cb97c61f5320a9729b25c274fde9996c7d0cb9b2a162e0f174de16ac06d94"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p336"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"servingCellConfigCommon","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"Configuration of the serving cell.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"t319a","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"Initial value of the timer T319a used for detection of SDT failure. Value ms100 corresponds to 100 milliseconds, value ms200 corresponds to 200 milliseconds and so on. If t319a-r18 is absent, the UE applies the value configured in t319a-r17.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"uac-AccessCategory1-SelectionAssistanceInfo","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. If plmnCommon is chosen, the UAC-AccessCategory1-SelectionAssistanceInfo is applicable to all the PLMNs and SNPNs in plmn-IdentityInfoList and npn-IdentityInfoList. If individualPLMNList is chosen, the 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. If uac-AC1-SelectAssistInfo-r16 is present, the UE shall ignore the uac-AccessCategory1-SelectionAssistanceInfo.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"uac-AC1-SelectAssistInfo","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. The 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. Value notConfigured indicates that Access Category1 is not configured for the corresponding PLMN/SNPN.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"uac-BarringForCommon","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"Common access control parameters for each access category. Common values are used for all PLMNs/SNPNs, unless overwritten by the PLMN/SNPN specific configuration provided in uac-BarringPerPLMN-List. The parameters are specified by providing an index to the set of configurations (uac-BarringInfoSetList). UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"ue-TimersAndConstants","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"Timer and constant values to be used by the UE. The cell operating as PCell always provides this field.","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"useFullResumeID","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"Indicates which resume identifier and Resume request message should be used. UE uses fullI-RNTI and RRCResumeRequest1 if the field is present, or shortI-RNTI and RRCResumeRequest if the field is absent.","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"EDRX-RC","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that enables eDRX-AllowedIdle, otherwise it is absent.","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"MINT","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that provides a configuration for disaster roaming, otherwise it is absent, Need R.","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"MT-SDT1","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["9d54e2a848eca6d30b7e65f6ba0bd0cd3a56b7b58c7f17432e017cf8f40b3303","504368b2704d366fa70e386b5771fd191b598ecc61e479334959d01db5530d55","5d7978b433ae3867c5a87f1d92ca48852b18289db90883c5c97ca13cc55a7412","fd6476950c09d59ee8776fed8e824065527627102a60f49aa270a10df69a16b1","a1b69ba83a58b6ecb9df5d80838689b07a57163c4e5d0377c9c7af5e92bf803a","b7bf89f6cce55276fbdc666f10dcb45354a147ea207741db129b6507f80787f3","9b17ba6657361043af769ccb1045dea3f8b871cf7067b652f16b931860a0d2b6","ae8101e11919e606d0cb354cfc37b0cec8d37006e41cd5c9ee5f236c2ea8708c","28c3c971b700f967f6b39940a7924a562598f9a321a863e941f84f6b8d89de2e","a93fe5c2c122c4bcc770de64d4eebc0467030f3174d37a77fa4902880ae63838","197b3c059ae7e3e6975853b073b9755453d9e822119c34b2b0a4c7f640876c2d","132f3c3952399ac14b6733ff0e0f487ac467356a391c1e6699e105aa2e480b1a","2683432bc213c59a70c655f26aff688b9989b49a4b0f653507373639981f9eed","6b5966adbc5c11ae9b872a42395fa5fe782c745a531411ed827f8da95d801571","ae573167fe86571da8cf1f90936bc15112d1332dc39e00cdc962fdd24c96c3c1","7c85dd73a987c4f03b3faaf5102c769e69805d2eddc226fb1167f2da6a1aaf52","d62e9343d02d245426aca7829f417b6b1ebc06db03704b98d6db9e38f94eda3e","9b86e737b214e1630e83c50e31cf318206b1ff8da5bcd602c751c0cb060176c2","e17e493526bb3acc14f4f37e408efe988437205c86b96959321160077d056d06","45f42d5d5b50d9385c4e561792d19434a59447ece2623aaa06e88a82459793df","2c6769920b715e9e8f789af8e0095e4dabd4ec79921615f97d4fbe4bf44ea29e","047b5cb0e78076505d998b1d6aa8e81555ced2cec6a5a75d0eeeda6698f6f693","dd143ac464279e27312ff21f4af8b5fc5c1e58216e1afef824293bfa0d0c4917","dc22bf9e388e42454a80b902e943e5abbdd10b08745e1aedac3ad9ae9e7703bf"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p360"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MT-SDT2","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"NTN","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, in a cell where cellBarredNTN is included with value notBarred, otherwise it is absent.","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"REDCAP-Barring","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that supports RedCap UE,  otherwise it is absent.","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"Annex C (normative):List of CRs Containing Early Implementable Features and Corrections","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["24c76e508dba17bf8430382a99b46b59c17c7cf4c96ae667dd46f08921a84cea","0ff22d11c4f1c23d9e98296b05d93cb070c32d9e1357a0da154e5ece4d7c64e2","5eca482261798a4a042c66f0eec334c041d7e72e99601699a8b740ee305d3b1d","8ba111f3b0624e18984cb10328e034847f22c2bc107318827fc7a0475cffd597","6fdabbef37e9985bf05959add15b0f89180651687f9d0fdff036f6585787c36d","42db7a68ec4ff9dc4e2d7b225e887fcb55cff887a9e3fadf8d1e226b601686cf","7aafccb1dbaed99e150a4cd884f6531f8c4bbf8ed5202bd16cded9ebca60bfc3","acf6551dbe2a18b6864001a042261f1931ff99cabde3babbad50743f18e780e6","0de83c80d2f7189b095f3bce99f8a05fa1daf168db0e473d7d0fedc3cba1e12a","2d460f260ad00453a15b8d80160c835d946916335ca889076b62e31a3c496403","a28fea6f3d1dae232622f4ccd050d7f70c14a881f79a293c9b82104d70950505","2821b4c77125c287d8eeb48acba23cd2a20208216e99f5799416d41f8ca829e2","e5a4508a563ae0c5a2484c09ece8e171f225b17618f778c371de4a033220a42c","79e2511ece4f35230e4ef5377a25d7de7a81c6d1240faae835041050e42f7d85","1042f2d9963b7bf0e996153457d04bd87c321703d1f65dfda79b51a5cc83ecc5","b683933bb843fd570e4386f246a85a520cf6b5f8de3670b45fba54bed8e0e042","744c3eb6e352beb8e622865de8f146e2ec475d41071ddb1a7ca5fcf8aa0be930","a4c274504bb5fee1a473b37781523d8d6a4c00875e4cb0a77772a9473762d05a","3899f4f65ec9b26dc16a4491e09625acd56dd4164ba52227981c03bb36ae3fcf","b8bf1edcd7e7ddf2387157647ecd64031c60089a53161a1e3b1f12d216a0c583","cf2025644b3f91c149d107657c27963dc0444d1c4bf5cfafc7005be4b