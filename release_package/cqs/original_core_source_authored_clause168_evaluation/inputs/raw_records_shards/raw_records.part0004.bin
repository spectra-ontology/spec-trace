{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18240},{"literal_text_all_w_t_and_m_t":"–ARFCN-ValueUTRA-FDD","paragraph_zero_based":18241},{"literal_text_all_w_t_and_m_t":"The IE ARFCN-ValueUTRA-FDD is used to indicate the ARFCN applicable for a downlink (Nd, FDD) UTRA-FDD carrier frequency, as defined in TS 25.331 [45].","paragraph_zero_based":18242},{"literal_text_all_w_t_and_m_t":"ARFCN-ValueUTRA-FDD information element","paragraph_zero_based":18243},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18244},{"literal_text_all_w_t_and_m_t":"-- TAG-ARFCN-ValueUTRA-FDD-START","paragraph_zero_based":18245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18246},{"literal_text_all_w_t_and_m_t":"ARFCN-ValueUTRA-FDD-r16 ::=                INTEGER (0..16383)","paragraph_zero_based":18247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18248},{"literal_text_all_w_t_and_m_t":"-- TAG-ARFCN-ValueUTRA-FDD-STOP","paragraph_zero_based":18249},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18251},{"literal_text_all_w_t_and_m_t":"–ATG-Config","paragraph_zero_based":18252},{"literal_text_all_w_t_and_m_t":"The IE ATG-Config provides parameters needed for the UE to access NR via ATG access.","paragraph_zero_based":18253},{"literal_text_all_w_t_and_m_t":"ATG-Config information element","paragraph_zero_based":18254},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18255},{"literal_text_all_w_t_and_m_t":"-- TAG-ATG-CONFIG-START","paragraph_zero_based":18256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18257},{"literal_text_all_w_t_and_m_t":"ATG-Config-r18 ::=          SEQUENCE {","paragraph_zero_based":18258},{"literal_text_all_w_t_and_m_t":"   