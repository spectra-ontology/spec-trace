{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    includeBeamMeasurements                     BOOLEAN","paragraph_zero_based":32040},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32042},{"literal_text_all_w_t_and_m_t":"CellIndividualOffsetList-r18 ::=    SEQUENCE {","paragraph_zero_based":32043},{"literal_text_all_w_t_and_m_t":"    physCellId-r18                      PhysCellId,","paragraph_zero_based":32044},{"literal_text_all_w_t_and_m_t":"    cellIndividualOffset-r18            Q-OffsetRangeList","paragraph_zero_based":32045},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32047},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGNR-STOP","paragraph_zero_based":32048},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32050},{"literal_text_all_w_t_and_m_t":"CondTriggerConfig field descriptions","paragraph_zero_based":32051},{"literal_text_all_w_t_and_m_t":"a3-Offset","paragraph_zero_based":32052},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR conditional reconfiguration triggering condition for cond event a3. The actual value is field value * 0.5 dB.","paragraph_zero_based":32053},{"literal_text_all_w_t_and_m_t":"a4-Threshold","paragraph_zero_based":32054},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a4.","paragraph_zero_based":32055},{"literal_text_all_w_t_and_m_t":"a5-Threshold1/ a5-Threshold2","paragraph_zero_based":32056},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a5. In the same condeventA5, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":32057},{"literal_text_all_w_t_and_m_t":"condEventId","paragraph_zero_based":32058},{"literal_text_all_w_t_and_m_t":"Choice of NR conditional reconfiguration event triggered criteria.","paragraph_zero_based":32059},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":32060},{"literal_text_all_w_t_and_m_t":"Distance from a fixed reference location configured with referenceLocation1 or referenceLocation2 or a moving reference location determined by the UE based on the serving cell movingReferenceLocation broadcast in SIB19 or referenceLocation2 and their corresponding satellite ephemeris and epoch time. Each step represents 50m.","paragraph_zero_based":32061},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":32062},{"literal_text_all_w_t_and_m_t":"This field is used for defining the leaving condition T1-2 for conditional HO event condEventT1. Each step represents 100ms.","paragraph_zero_based":32063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7f796b9bf34a8667e9a055e6c2268e529f69ef56a606ac8e4a8ced05d72d9f56","21985036b885cf7897edce8592961ff86acf8671fab8007f3b16ae929d97722e","3992e9d6db25c7052f1982faa1183ccbfa0f77948ca6981bc161900abf56c693","97a131d4e53f84d81151a1d8589cb9ee535488334ad913c79610562551c972df","ff9282cdeaf9c31d2964216bb109293972ff2bc1dc5d91d7b1b31512cf7b0448","767bd8be29c0be181fdfb36a3960535bc38109033f56658354b7d258f6748b91","7d83a3b489bf93cccb36f41271e1fc0b8b6db48c85d9e1a92700c28b5d0c633c","021dce7d2951e70d16d449e15da9a3ea82fe4cd7ffc0c1d68b1d0b8c18465cdb","a104a829a230bfd0574326d9758437fa82196807bef0799d936234397959e9a7","336b600f439ac99a4471e789366f93dbaaec93a9c846f4f6673306f32569fe44","fb8ced4f94e2091c283baf6e4413521139ef267bbbdd244461812c5e4ce56a8f","25e22df2635d8f0c3698570f6c6de412d7e28d0913d6966a356307ebdd7fb51d","4360daef60ce3272ab7dff345c8af0bd32f2976b80efd75a82fb5934a18d6391","7611d2987a5484d4fad05d4f8e466a8e089f5cea86f485095ca277eb6441bab5","011040464bcae22ea8bbaf71c7a27d1d57dc48460db01c8502ef97f76ae93dad","dee995fa497ada2e41abdfc1eb619afbebb8b4ed772a7ebfb00e170a77bac4b6","b94712153047cdc501305100a3ba95e70836894e44ff407e9116fd438a11d1d5","793c800e856ca04ab439a5e9d437681d5f43134ad57a3bd3daa812712359d4ce","199995928c91aa9fb04784028c3bfd01439833530d54d2a44b60eae3f9a6a429","fc4e9d36373f831f471bbe27af491a72dc3fcb304f17c35b3f1ec89976ea60c6","22f663881ad3f46675abcf23a0e479999a9a0c66bccd440f898ec497cc966976","2e7fb70bc8a1a229ccf21ad4af2623f6b4778ac38a78239727160b64ec2783d1","c3d5753f9327db90e69de2d5113f6615b60b2ad8e96d3bfd65c83e18fc118c1d","51901c573da0cbd485873e95462a635834f1dd66cae065a2b8010d1dd79b6bd3"],"paragraph_range_zero_based":[32040,32063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32040"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nesEvent","paragraph_zero_based":32064},{"literal_text_all_w_t_and_m_t":"Indicates the event is a NES-specific CHO event and the event is only considered to be satisfied if indication from lower layers is received indicating the applicability of NES-specific CHO event and the related entry condition(s) is fulfilled. This field can only be configured for condEventA3, condEventA4 or condEventA5. This field cannot be configured for CPAC.","paragraph_zero_based":32065},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":32066},{"literal_text_all_w_t_and_m_t":"For condEventD1, the referenceLocation1 is associated to serving cell and referenceLocation2 is associated to candidate target cell. For condEventD2, the refereceLocation2 is associated to candidate target cell.","paragraph_zero_based":32067},{"literal_text_all_w_t_and_m_t":"t1-Threshold","paragraph_zero_based":32068},{"literal_text_all_w_t_and_m_t":"The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900).","paragraph_zero_based":32069},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":32070},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to execute the conditional reconfiguration evaluation.","paragraph_zero_based":32071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32072},{"literal_text_all_w_t_and_m_t":"ReportConfigNR field descriptions","paragraph_zero_based":32073},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":32074},{"literal_text_all_w_t_and_m_t":"Type of the configured measurement report. In MR-DC, network does not configure report of type reportCGI using SRB3. The condTriggerConfig is used for CHO, CPA or CPC configuration.","paragraph_zero_based":32075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32076},{"literal_text_all_w_t_and_m_t":"ReportCGI field descriptions","paragraph_zero_based":32077},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":32078},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the NR neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":32079},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32080},{"literal_text_all_w_t_and_m_t":"EventTriggerConfig field descriptions","paragraph_zero_based":32081},{"literal_text_all_w_t_and_m_t":"a3-Offset/a6-Offset","paragraph_zero_based":32082},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR measurement report triggering condition for event a3/a6. The actual value is field value * 0.5 dB.","paragraph_zero_based":32083},{"literal_text_all_w_t_and_m_t":"aN-ThresholdM","paragraph_zero_based":32084},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event number aN. If multiple thresholds are defined for event number aN, the thresholds are differentiated by M. In the same eventA5, eventA5H1, eventA5H2, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":32085},{"literal_text_all_w_t_and_m_t":"channelOccupancyThreshold","paragraph_zero_based":32086},{"literal_text_all_w_t_and_m_t":"RSSI threshold which is used for channel occupancy evaluation.","paragraph_zero_based":32087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0dd96985511c4d346bcd796ca33457d4460ef52591258cb8f4c8e683e13249ba","0691fe6b90b403ff0d18891abb7bac842a89b61ad6dbac5a246f3dedfaf168de","272f66b5fd396a5a75dc4344dbbba7a42fb18888c4c2cc265c5c5808c1f84888","c53b86097ac6e97d70a2dd00bab2c87a4207d84b888a5c1d7f2e28ecb8011f77","727325dd16b45562bc21e1e1f6e802992f83c333433a40c8fbdeed8e8c63624a","88fd8c5a62fe1a02e5ab0c4ba4b3897340363048ad8a03c55fecdab0068886ab","f2c0d025d64c516dd0f81a09bf23e2952053932a6175bc0c309d2674230e657c","95e710d6b1cec60b033756a4677628126c94105020429288d5119023404d6ced","852068e35cb3a6e39380fc10fa4c7486e92d4bd88928905382655c33e23e2319","c9998759c0a6818a33797a3a75427cd003cce2dec1aa6146215b93770a572f45","2acd956a60c5ed79b67c54d677cbb45a88dd86336ab351c6910bd8e71e647b1a","bc92b4e5152766772d10c6669bc9cc76194e3bc31618d578231f5a25bd2bbf45","66b060f484f79a4677b510b2522d019249e290647289454ae1a39f21612399d8","051abc68f70e022126d953d1f3af67cc387fcef46e2e50b83bb08a2b49912653","a48eb253f38c1a943bcab460a873d2bd983ce461f88b4197257de5bb6c90b822","bc70f665d6ffe39359f408d89d2dc589a1a5987e588999015d52c1eeffe1809d","36c99fd302c638bf2147b99b35d7cf2770619e5a202e02b9afc1ce86565b7336","db4d6afd52f60ad240731f0018b5567b0385e9a5210dbbcba0df1cbe3958fb2f","159f1dff4b8537c170612aacc213f0e1f8ca15244dc38086faac5fa59a2ddec0","f7eea9c91b63f4a2b305c7a1f82e7fffd09cd4cd04a17f2f073cee634c4cd8ca","411d24347e1a1d0de832294088ad172d1e101ec0e03c94e706546ef02a3948bc","a8128ee620494586207d1d07419757fea36966caa61f9ed5c807be06245367a4","5a034662757b40d554aa92619c549891cdb897bed5d6bf521385378006db625a","88a4fa7e2c457905ab2823eea38d48cf4a9e8d547cab8c4b976721b9cdbe9c0d"],"paragraph_range_zero_based":[32064,32087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32064"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":32088},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":32089},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":32090},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the distance from a reference location configured with referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":32091},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":32092},{"literal_text_all_w_t_and_m_t":"Choice of NR event triggered reporting criteria.","paragraph_zero_based":32093},{"literal_text_all_w_t_and_m_t":"eventXN-SD-Threshold","paragraph_zero_based":32094},{"literal_text_all_w_t_and_m_t":"Indicates the SD-RSRP threshold value for the serving L2 U2N Relay UE in event XN (N equals 1 or 2). If this field is not included, the UE considers the SD-RSRP threshold value equals to the one indicated by x1-Threshold1-Relay/ x2-Threshold-Relay.","paragraph_zero_based":32095},{"literal_text_all_w_t_and_m_t":"includeAltitudeUE","paragraph_zero_based":32096},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report altitude information.","paragraph_zero_based":32097},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":32098},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report for A1-A6 events.","paragraph_zero_based":32099},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":32100},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":32101},{"literal_text_all_w_t_and_m_t":"numberOfTriggeringCells","paragraph_zero_based":32102},{"literal_text_all_w_t_and_m_t":"Indicates the number of cells detected that are required to fulfill an event for a measurement report to be triggered. This field is applicable only for the events concerning neighbor cells, i.e. eventA3, eventA4, eventA5, eventA3H1, eventA3H2, eventA4H1, eventA4H2, eventA5H1, eventA5H2.","paragraph_zero_based":32103},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":32104},{"literal_text_all_w_t_and_m_t":"For eventD1, the referenceLocation1 is associated to serving cell and referenceLocation2 is associated to neighbour cell. For eventD2, the refereceLocation2 is associated to neighbour cell.","paragraph_zero_based":32105},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":32106},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":32107},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":32108},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types.","paragraph_zero_based":32109},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":32110},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":32111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4bd0e040892299afe948eead41d75523b9af150fc29e48b1646fa46e7d45cad8","894214a5be12855ba6399717a1c22525a1f0abebbfe0ef98e9bc68751e1061e5","a287ac89ffdeec7b872884251292ca71ea98ce2250e9f2c9eefada4f7212e3c9","119bf329dc21f8a3dc7669d28811c5336d3af6e250d3bac436ede7ea7330a1af","66fa0245866f76447a525c1fba5424e25eb2034fc8014c08e9fbde3a659c05a9","8c0d19cb10e278ad0f426f55e49038db12891db034c44cb21ace54104f9cf3d4","4fda8d885b68660a1e1a6ca3f6d609f7dbbebeb3d6e284533ff69851ff589c76","43231604a4ba7fc1427b926cb4a33a1f7e51d180aeae700be9562275f222b84d","714c984501c39238e722f6123c988dd6df2583d0351c826abe9f0e00afef2c45","0f7820fb45ce12c6231d83f02577c84cddd49fa196bfa5277f18f381cc7e21c1","1d34c53725cc889210b593b2b61a85f4e8c5492880595e5ffe06b103c4755036","731d374cd47ee9a806f1692d12dbd5b6b1f8941270be4bc21bedb1afa1a08f33","7a6e723f371cea586b1168379366fefcec51030547b95dcff69dc4b85d69917a","f9e90ca3edb69ad03c3c816eb499ec329dcf800e0650cb2fe8b86912574afe73","c17ea056a45c094dc84f42f3c16b2b7fcb65d56ebfe3013acfb6b239a2689c4b","e91bfd4b89199cb99e4ba1ce3212c954a2a5f23eaf8c0da46680cd545f1b274a","8e894580c8dd25968bf848a471c7e14f1c9a91508172c2a022668a62d207c785","62649a528b26b85a16bc0eeba9d0ae5123f522cce178f2c87365c0ef1d7c9439","2c233548892aca0adada46c2c690aff1ce4f261426f41f798eee08c02b6d0505","aadcccdfb64b7cd5ff3ae99d26791f03c4976d04b04a353de158a727af27d426","8819be0a16c12dea377a8dbb308d9267c6da3f58642958a11e247388b7a84b7d","48f1fbab31373981355d00dadeb2f1ec87b003d94c756cf03f6cf9c65aa17604","867a856a073b4506e617daf01be9c3f07ac8b8295b5088fbf510913b7c1a7751","f6cadc187ce9187cfc45f2eebca8ebc1eb3db5c50774a60d25f6e70f42d256a0"],"paragraph_range_zero_based":[32088,32111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32088"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met if configured in eventD1, eventD2, eventH1, eventH2 as specified in 5.5.4.1.","paragraph_zero_based":32112},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":32113},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":32114},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":32115},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":32116},{"literal_text_all_w_t_and_m_t":"simulMultiTriggerSingleMeasReport","paragraph_zero_based":32117},{"literal_text_all_w_t_and_m_t":"Indicates when multiple events with the same eventID satisfy the entering condition(s), whether to consider only the event with the smallest value between the altitude of the UE and the configured altitude threshold.","paragraph_zero_based":32118},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":32119},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":32120},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":32121},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":32122},{"literal_text_all_w_t_and_m_t":"useT312","paragraph_zero_based":32123},{"literal_text_all_w_t_and_m_t":"If value TRUE is configured, the UE shall use the timer T312 with the value t312 as specified in the corresponding measObjectNR. If value FALSE is configured, the timer T312 is considered as disabled. Network configures value TRUE only if reportType is set to eventTriggered.","paragraph_zero_based":32124},{"literal_text_all_w_t_and_m_t":"xN-ThresholdM","paragraph_zero_based":32125},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event xN. If multiple thresholds are defined for event number xN, the thresholds are differentiated by M. x1-Threshold1 and x2-Threshold indicates the threshold value for the serving L2 U2N Relay UE, x1-Threshold2 indicates the threshold value for the NR Cells.","paragraph_zero_based":32126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32127},{"literal_text_all_w_t_and_m_t":"CLI-EventTriggerConfig field descriptions","paragraph_zero_based":32128},{"literal_text_all_w_t_and_m_t":"i1-Threshold","paragraph_zero_based":32129},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. SRS-RSRP, CLI-RSSI) to be used in CLI measurement report triggering condition for event i1.","paragraph_zero_based":32130},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":32131},{"literal_text_all_w_t_and_m_t":"Choice of CLI event triggered reporting criteria.","paragraph_zero_based":32132},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":32133},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":32134},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":32135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_memb