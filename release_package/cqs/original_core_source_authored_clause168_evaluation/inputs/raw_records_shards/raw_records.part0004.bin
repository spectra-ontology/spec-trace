{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-POSRESOURCESETLINKEDFORAGGBW-START","paragraph_zero_based":34968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34969},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW-r18::= SEQUENCE {","paragraph_zero_based":34970},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetLinked-r18             SRS-PosResourceSetId-r16,","paragraph_zero_based":34971},{"literal_text_all_w_t_and_m_t":"    freqInfo-r18                             ARFCN-ValueNR                                             OPTIONAL,  -- Need R","paragraph_zero_based":34972},{"literal_text_all_w_t_and_m_t":"    ul-bwp-ID-r18                            BWP-Id                                                OPTIONAL,   -- Cond ConnectedMode","paragraph_zero_based":34973},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrier-r18                  SCS-SpecificCarrier                                        OPTIONAL,  -- Need R","paragraph_zero_based":34974},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":34975},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34976},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34977},{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-POSRESOURCESETLINKEDFORAGGBW-STOP","paragraph_zero_based":34978},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34980},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":34981},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34982},{"literal_text_all_w_t_and_m_t":"ConnectedMode","paragraph_zero_based":34983},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when bandwidth aggregation is performed in RRC_CONNECTED state and SRS for positioning is configured in the same carrier as data for bandwidth aggregation, otherwise it is absent Need R.","paragraph_zero_based":34984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34985},{"literal_text_all_w_t_and_m_t":"SRS-PosResourceSetLinkedForAggBW field descriptions","paragraph_zero_based":34986},{"literal_text_all_w_t_and_m_t":"freqInfo","paragraph_zero_based":34987},{"literal_text_all_w_t_and_m_t":"Indicates the SRS Positioning Resource set carrier frequency that is linked for bandwidth aggregation.","paragraph_zero_based":34988},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrier","paragraph_zero_based":34989},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A and to be used for SRS for positioning bandwidth aggregation.","paragraph_zero_based":34990},{"literal_text_all_w_t_and_m_t":"srs-PosResourceSetLinked","paragraph_zero_based":34991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["41d08e0d2479a0f3ebfb5456ddb19afcf2c937f9a713f8df56a3db68c2bc4f7f","9ee34a50d08b656889d8e82316916c145567005112dad8f32098b629bafb96f3","b62d6ce013a9d84a2ee7b03fc0553ab0a94b863585798c0bd8e16fea5368e9d8","62f912a3b71e03993c43023608336b5086d74161d3f1c858f5e66d05a1c823e5","b86481ed0cf0ddfae7470538536af8b569a47c5449d0b7ce7f54365ac5441974","2c14c07b664ab4886dc25b8202ab0f844705b07f2ac1f8d3878d2d2fb5a1ef34","61e1f9fef73027eac1be87bd45994139bdd4fa52047ec7e345373a8eb94b6ec3","360c62f681d0bf344c2b47343cd98fb6bef6cec3a3ce9b988e4094a51ab9baa9","0abb6be33b4494cfec7df79a90965cf4650cc07b2b65a98f192184ac1e4dcebd","0925e83d3bfb4c93c7ff8b66e192a0d5173b21214f2eaaf0e