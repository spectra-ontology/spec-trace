and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-START","paragraph_zero_based":26153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26154},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA-r17 ::=   SEQUENCE {","paragraph_zero_based":26155},{"literal_text_all_w_t_and_m_t":"    needForNCSG-EUTRA-r17              SEQUENCE (SIZE (1..maxBandsEUTRA)) OF NeedForNCSG-EUTRA-r17","paragraph_zero_based":26156},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26158},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA-r17  ::=         SEQUENCE {","paragraph_zero_based":26159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b7336a79848c71a38095276579a6841dc3c1135e78f6f26061478a655187329f","89fd4529a9bf2c9cba3192e9dc26cd91ecf609960b63f41a2375809502aa4e87","583058f074128a56d3a0de03da9e0b72feb04c4342acea300ce9259cadbd69a5","59c21dfae0a3dd69535d8c5055840cfd8c205c4340efbce22924053562123279","69528ee51918331aa4c589a512bff63967e5fbc6076e873d7ebfda161e5a81db","3900f6517d6206b8a4adffc627cbb87b0f9db737a32578d87936b54575e9f6db","cbb694660ed5ea548310c4ebec5101f1b91469bc4706679f6e0fe6d54859a1a1","86849c8315b531480f05a1bafcc8c219c2de1597d8b65bd8acf642e9c4fb1734","86edfcc1aaf9caee0f9656dc79f8ad2830e9605855d412198c48d6995f7a1ca5","fede2dd33e0831fd20d64ed14d8a59eb2c4595bb6e01a811c0cf2252bd5988c2","3fd39281459c2aacacfb143e20ab9ab8a7eb89510151595382d05cf82c9cd712","3b1ca7be231332056b8c8a2711ca5b01515507deea3729cbb45427da46a6bdf9","61d1f92bd2617415e38b4ab81b9aec72a3df8270089d860e5e6a0bd3e67b4dde","6e692aceb54c93c5040f714dcff3a1402d873572dfb1ca5971bb1f08a11be86d","a0735b9c2855ecf4e0b73a310442910d2e016d9e60b3751c23