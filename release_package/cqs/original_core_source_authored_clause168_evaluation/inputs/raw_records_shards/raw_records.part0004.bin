{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Introduction of barring exemption for RedCap UEs for emergency calls [RedCap_EM_Call]","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Apple, China Telecom, Vodafone, Verizon, TMobile USA, ZTE, Vivo, Ericsson","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"TEI18","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2024-05-09","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["43bc5048f4b13e50e5b3ae9ff800ae9a97ff5336d27e0d3957b529e82404f523","d99d0a6db4625c650d1ea0b07338dfdfc7169a23cd62aa6fc704361033075071","e4544334ce3c09a076f5bd8443038b81735cfa6c048bc341c74b5eca0f1e2cf4","f72783a14f5d4407ad6ccb38a5eae14ed770b407c950b6a3951967e1a56797b0","c1ccb492787d4d80f5f1badd8b5cd14460fdb3948d94446d330b5ef14ac110ba","3d51ac5d265038cc3f7c34658b6ca954c887fe8fa4baca7b52bab0c097dbd15e","d03966d6ca98972c3a7e6be8a7e2821b47540434f75393ffee9ffde9f0bce8bf","a0bb72453038445da90f5686a056b25638f2687bead8f9568760ab927e710426","3c60283ca9e853e29ef075aa24795dd2eb4918c6ca476d3b5b38431d54016b37","bde13bafc83836c44db969f60c645a6728cddc14af5a7e460fc0486c8a2b263e","0571d45509fd17dd9940f7e19662f978f44876e61ab2942e9a29f0299d1b5b07","1a6cc481d0eff3149fd01a6816e98866e07017a1b91d5c5f389cded264a7702a","a01d822ec7119512cf5ba7f229a598013879b2bc10b7eef180b3b45f0d4c3876","21359ea2e49ee6978be39f8866cef294ec2b1d248dde277798048470c5e578b3","0f0c1af8993ccce8aa349a4dfb23a031c071e57da01f10194cbd012ea9d553a9","5d68004573240aba2b412f8705e447c0e4d1dda94b8bd84811762c2542e3bac7","a4bd72dbdd4984aa8b8b0a221ffa79b5d81cc343c336fa060d435e919c22cdfa","9828c81f6bc62caccbd144b4c21a5e5de3901a3302ac3e0a0aeac56212ae73e0","e905622e3edfa508bba15eafccddf247d1ace7fa313e180572b27ed528961f8b","620d41b7880cc43225902539c2f192ce65953d3a41d5d4c2298e514e2ffea87b","6a5acc895b40fe3fd542149c156f0fd4775d579d970181a7c98dc775ccaa8d32","f30c9cd69015b749e12900c31281be3962b8698a295f48cbaf48722b9847c34b","af06b610a8bd3ee7f1d84cf19a9bc164706cafffcac8b8ff7dd0d3c73ca65738","c85595d71a658edfa0122cdb1bb508f37dc31ed5038e6a009371a1e2a871bcc2"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p24"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"It is not possible for a UE to make an emergency call if the cell is barred. A network may enable the access for RedCap UEs in a cell, yet bar those UEs based on whether the RedCap UE uses 1Rx or 2Rx branches. The motivation for this functionality was to introduce control for the network over which device to access due to potential impact on, for example, performance.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"If the cell enables access for RedCap UEs but the RedCap UEs consider this cell as barred based on the 1Rx or 2Rx support or both, it would be beneficial to introduce an exception for those UEs to have access to the cell to make an emergency call or receive emergency information broadcast when possible if the cell enables access for RedCap UEs.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"This CR introduces a mechanism to allow RedCap UEs to have access to the cell to make an emergency call or receive emergency information broadcast, when possible, if the cell enables access for RedCap UEs but the RedCap UEs consider this cell as barred based on the 1Rx or 2Rx support .","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"The following changes are made:","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Indication in SIB1 on whether a RedCap UE is allowed to make an emergency call if the cell enables access for RedCap UEs but it bars RedCap UEs based on the support of 1Rx or 2Rx branches.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["2647dc7673e3663bf35263469d0e559513b85a4b4af376940b1f36f656cf1af6","f901293762d5d9cfbf266e90bd85ca2521137ab3802b895bf3cedf4b1410ef89","71469abd454cf9880ac8c7041c1347a070c4677dc9bafa5df38f7a579f9b2de6","8b47c7781bba83157be226b765fd647ed062ed713a7162d649054cdcad549cd6","3b12906d882d533ae9188e96b43bcbd644b5bc11b7adc1fe8b4ee8aab08b9b03","532dcdb3a1168ef60172c5c5f4bd8c09c7950671c21e01fec51c68ed0bf3292c","c44301927247626cac8a805f5929478921163396ab9e83d20b6fbf406cec706f","7d9209a01950a9e2e0b51fdb2758a2efe3b5f8332958389a439e396fdee87394","bdcc684e9eaaf792880a5de246a765f0c85c87efb0608b3f4f72fee753b0e320","7797236528f616f156ddbfe5445418ac32915eb58e704513918cfba658f71321","1b4a54bdf83fe619cb2310d1142e22f16c4876cbc3b6f034bcccbaf3d7a867d2","a2fa624aca92879783ee6eb53a5c021af78d5831fd062752b547019cdafa2159","d45b5bf4fa1d2fe33e9624c20fcfe161b92cc32730a60c5bd7c9c9080a30f24f","fdff2483699396adfcbed526a4cfe3ce2813670e6ca774cd10adee5d1a06964d","091e4924929270ba03b921af4d78b52bfdedcb4d9e1a17b09afc43cd6dfd3214","f43286e55b0510c81c635b2cfad94bf71ba10b6c2c4432811d1d2968bd4f841e","f36b424cdbb22a0748ccfd1c911f0725e8c045968d2e06226a729c8ae84a4402","3ba96683d7e465d51c10505a68e28253fddd92f9e9c6b5203b97e3f1588f98f6","74dd12f224fb7f7ea63b00c607fd99aa9ca39a1247640c4db3cb7e43e677e034","f95ec0abfebf6e089ae83fb718656771ae89be2cf77a4fc48fdb31dd0091e8a0","a68f86baa32eaa5e85d9ee5b9e96a4e8964085bd86629ce4be2c223a8d695917","b07e70f327119d1b4d9b7db92289ed9f48b588cf7a8bf7e915dd9d772b3f61d6","e499285361039d08ee50524251bfb6e184fdea5d44bded1fae2cfd4bbe4f33d6","eb3eeefbafe68ab79374ea454c95b3bdc23c397632013a827987be911fa8c1f4"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx:p48"}
{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"NR-SA","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Cell selection/reselection in IDLE mode and Emergency call functionality","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"If the UE is implemented with the CR while the NW is not, there is no inter-operability issue, as the UE cannot initiate an emergency call in such a case.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"If the NW is implemented with the CR while the UE is not, there is no inter-operability issue as the UE behaves as legacy device.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Implementation of this CR by a Release 17 UE, after R18 ASN.1 is frozen, will not cause compatibility issues.","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"A RedCap UE cannot make emergency calls in a cell where access for RedCap UEs is enabled but RedCap UEs with 1Rx or 2Rx branches are barred.","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"6.2.2","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9986aa0d4eac68c7f92866fc9c37b9c00dd6573a612eeb7960af636e73ea451d","original_member_sha256":"2c2b2359458c692391bc427871083b848ce1a4f42492b891a0523630fcdd35b8","paragraph_ElementTree_utf8_XML_sha256":["41fa3d1eef1b125f4bdeccacb12033200bc53d65a1617830db250b957178f155","0d5486ffe1bfe0e9d6d19abf54905f44ba7f6dc7834348ca296bb4ec70bd07ab","4df45d638e991f5a9309e83e02dcb2bd3dbf29464352d588ede2dadc808166d2","c9b62286577b9bffe569998d4f520d20d87c598957f8a137082ce567a5fecfc1","161a0fe0b8ea4b8d875f51e0505a1074c6a0b4014bc7d06409b32ae77000e384","ee6d21d072f09332d0bccfff20c7b6e61d7d7f34cb98164be25ad6bcc5e23305","0921ff2f00ed6a2468671c6ef8a5bc54d075993ea4b1a2110726df004098a8b5","9a222fe2b750d1baff126908f42e81d80c0beafa42b204676f2a0949e6e0a762","568e75250191cc80811fc598ba7fe26cfdda3836831ce5764e7a96539e3ae4ad","1d3d4c43b9eed96347753ab7753d89ac02f974032d9f3c685d480cd0f8fc7136","90974c323393544025a66daf733f72b8dc8ea9798054b52bc41e1327f9ab5323","0e07c26f5495a9bdb9f61a07312d1616dedcd6e892022083a6c12e011602dee0","cf2c8d434f0e9ae55c6912ab991f7c2a7b52dc549db205736fe2c26c42133e7a","4baf7c6d1aa18b90165a40ff10115d06681206ca89fe8dea1fb1f3459e56a8b9","5d53db1791d40f9ebfd81c1ed925cf31550fd7ffac24fcb684cc86d788813130","fda71dd2115ee4964b8cae234861ecff494baa4c37813525e95c048370ddcab9","1310ff237c141a029686fe0b408398ea377c239c789ccfa82884198069a8f855","0c495fbd54700a75d1706c59a5031064a6b8189b9d47dc3d3a1c4c30ca72293c","17a028dc58c846dd7ea152937af875bfd5af03928d4dd6d6f1485b