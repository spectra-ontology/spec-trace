{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30096},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations)) OF PUSCH-TimeDomainResourceAllocation","paragraph_zero_based":30097},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30098},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation ::=  SEQUENCE {","paragraph_zero_based":30099},{"literal_text_all_w_t_and_m_t":"    k2                                      INTEGER(0..32)                                  OPTIONAL,   -- Need S","paragraph_zero_based":30100},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":30101},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":30102},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30104},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations-r16)) OF PUSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":30105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30106},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":30107},{"literal_text_all_w_t_and_m_t":"    k2-r16                                     INTEGER(0..32)          OPTIONAL,   -- Need S","paragraph_zero_based":30108},{"literal_text_all_w_t_and_m_t":"    puschAllocationList-r16                    SEQUENCE (SIZE(1..maxNrofMultiplePUSCHs-r16)) OF PUSCH-Allocation-r16,","paragraph_zero_based":30109},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":30110},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30112},{"literal_text_all_w_t_and_m_t":"PUSCH-Allocation-r16 ::=  SEQUENCE {","paragraph_zero_based":30113},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                           ENUMERATED {typeA, typeB}                     OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":30114},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                  INTEGER (0..127)                              OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":30115},{"literal_text_all_w_t_and_m_t":"    startSymbol-r16                           INTEGER (0..13)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":30116},{"literal_text_all_w_t_and_m_t":"    length-r16                                INTEGER (1..14)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":30117},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitions-r16                   ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16} OPTIONAL,   -- Cond Format01-02","paragraph_zero_based":30118},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2316a4927d9bf0dd348839094d2da94718fc036dcb238b7c1b0480d4b4a03433","43ded33d11a420b56dddd8a06b2e2fec2a5bbcd3c25ab51dd84f4e78cb86100d","de3914903f24f5935bf01dff5ffde9e74ce78f6c1fc79184ecdc854ec6efddb1","95d693472c633ad37442acce5d23c6c09629e0e2fe2eafe7b7e9283396df341f","c0adff3723c03fe673ab0e794028b5c45083b01a87cc4c064279edd9b411b15e","54d18204ba612c6b7119b0166fa292eb95a8bab6165b5bde89f9a25957d2ed0f","49019488743e3