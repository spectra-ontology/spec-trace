3f4b13","e103ee930dea0b0b223aeba15d2e3b26d8aab42ffda7ebef88f8a49dcca8be05","bf3093c6eba4e72aa006fea20573cebc99a2a5311aa3da799b4084351d0c6b46","fdb57f28300149d6204110fa0256a5368e2b9d81e9ff82a5736746b915b9ea5d","b081fd434c3f3db0b64d0dca5e3b119154981cdcba0439ae94610f92bdf3f47c","d94f5c4081f9625a76293b7dd2015ecad5b814a514834b8449f8537f91d878a8","a833daff13ad637636e3049857afa2083e3885f9baa4a3fbeeb29963469e4e15","b89169a71a879b8957eeefeec3d311d6885dc09d82940a38aec84eae09d409ab","aee7a5784e4089a54984bb1694884e1f3ea553a7227f3abb75141a08c7271d77","d5f5c754e39a0058c6fd1b315b37fd02ca2d3894d21c4387508e731f217e536f","c93f2a49dbda6b2bbc36f389bc476c13f6a403a63526c6c108e5e3ec531ffa71","8db12eab05b7cb40063efd125d136688039ccafa700743ce02b65262ac4abc44","42c1ed33b6315e6abeb395a6402ce6a518343ac306a3e4941e6bc477f065a09a","9a097f2b60676fbac5824ced8f3253b90b6b26f7e70adb263b86edd7f05ce248","b80cdfcb91f0393ad6933809fdac10cf912e3856eeeb5969864b16364c747673"],"paragraph_range_zero_based":[44112,44135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p44112"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44136},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERCOMMON-STOP","paragraph_zero_based":44137},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44138},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44139},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterCommon field descriptions","paragraph_zero_based":44140},{"literal_text_all_w_t_and_m_t":"codebookTypeRequest","paragraph_zero_based":44141},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE includes SupportedCSI-RS-Resource supported for the codebook type(s) requested within this field (i.e. type I single/multi-panel, type II and type II port selection) into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC. If this field is present and none of the codebook types is requested within this field (i.e. empty field), the UE includes SupportedCSI-RS-Resource supported for all codebook types into codebookVariantsList, codebookParametersPerBand and codebookParametersPerBC.","paragraph_zero_based":44142},{"literal_text_all_w_t_and_m_t":"fallbackGroupFiveRequest","paragraph_zero_based":44143},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting FR2 CA bandwidth class from fallback group 5 shall include band combinations with FR2 CA bandwidth class from fallback group 5, and shall omit band combinations with FR2 CA bandwidth class from fallback group 2 or 3 (see TS 38.101-2 [39]) with same or lower capabilities.","paragraph_zero_based":44144},{"literal_text_all_w_t_and_m_t":"includeNE-DC","paragraph_zero_based":44145},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NE-DC shall indicate support for NE-DC in band combinations and include feature set combinations which are applicable to NE-DC. Band combinations supporting both NE-DC and (NG)EN-DC shall be included in supportedBandCombinationList, band combinations supporting only NE-DC shall be included in supportedBandCombinationListNEDC-Only.","paragraph_zero_based":44146},{"literal_text_all_w_t_and_m_t":"includeNR-DC","paragraph_zero_based":44147},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting NR-DC shall indicate support for NR-DC in band combinations and include feature set combinations which are applicable to NR-DC.","paragraph_zero_based":44148},{"literal_text_all_w_t_and_m_t":"lowerMSDRequest","paragraph_zero_based":44149},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting lower MSD shall indicate the lower MSD capability for the requested power class if supported. If no power class is explicitly requested, the UE supporting lower MSD shall indicate the lower MSD capability for the highest supported power class of the band combination consisting of victim band and aggressor band(s).","paragraph_zero_based":44150},{"literal_text_all_w_t_and_m_t":"mode","paragraph_zero_based":44151},{"literal_text_all_w_t_and_m_t":"The mode of NR-DC operation that the NW is interested in for this cell grouping. The value sync means that the UE only indicates NR-DC support for band combinations for which it supports synchronous NR-DC with the requested cell grouping. The value async means that the UE only indicates NR-DC support for band combinations for which it supports asynchronous NR-DC with the requested cell grouping.","paragraph_zero_based":44152},{"literal_text_all_w_t_and_m_t":"omitEN-DC","paragraph_zero_based":44153},{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE shall omit band combinations and feature set combinations which are only applicable to (NG)EN-DC.","paragraph_zero_based":44154},{"literal_text_all_w_t_and_m_t":"requestedCellGrouping","paragraph_zero_based":44155},{"literal_text_all_w_t_and_m_t":"The NR-DC cell groupings that the NW is interested in, i.e., the bands that it might use in an MCG and the bands that it might use in an SCG. Only if this field is present, the UE indicates NR-DC support for band combinations for which it supports the requested cell grouping, i.e., in which it supports at least one of the mcg bands on MCG and at least one of the scg bands on the SCG. In its supportedBandCombinationList, the UE indicates which of its NR-DC band combinations supports which of the requested cell groupings. The first element in this list is referred to by ID#0, the second by ID#1 and so on. If this field is absent, the UE only includes band combinations for which it supports NR-DC with only FR1 bands in MCG and only FR2 bands in SCG.","paragraph_zero_based":44156},{"literal_text_all_w_t_and_m_t":"Example 1: requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261]. This assumes that the NW would always use CA among n1, n7, n41 and n66 (depending on which are deployed on a given site) whereas with n78 and/or n261 the NW may need to use DC. With this filter a UE may report a band combination n1A-n7A-n78A for NR-DC only if it supports that serving cells for n1 and n7 are in the MCG and a serving cell for n78 is in the SCG. The UE may also report a band combination n41C-n261M for NR-DC provided that it supports a serving cell for n41 in the MCG and a serving cell for n261 in the SCG.","paragraph_zero_based":44157},{"literal_text_all_w_t_and_m_t":"Example 2: One requestedCellGrouping is set to mcg=[n1, n7, n41, n66] and scg=[n78, n261] and another requestedCellGrouping is set to mcg=[n1, n7, n66] and scg=[ n41, n78, n261]. This assumes that the NW uses sometimes CA among n1, n7, n41 and n66 (as in example 1) and sometimes CA among n1, n7 and n66 but DC towards one or several of n41, n78, n261. If a UE supports n1A-n41A-n78A only if n41A and n78A are in the same cell group, this UE may only indicate cell grouping ID#1 (not #0) in its BC.","paragraph_zero_based":44158},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchRequest","paragraph_zero_based":44159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5c4d950a153783b689b03bfb5f8194dc44237d506a1bd50c4cae41f34e57e61b","bbfe3a9f8582e2fc764d8dd9428b822c510283ce27601a345a98e75a270f6b40","ae5503d9da2158e35f1e731c85542ed8e8dd0e4d88506c7bc5adb2594cb7dc9b","943435c69f4fe932a1fcc9687660523f7172831f794dc119e9ac6b2619c908e8","875f11c12da6f6dffa4bf42661771f4f6992184a3a51151f1eb7ff746b1eb30e","992e8885ff0a6fb589db0b3edd4c63279134432fcbcbe24e2900437c4adc01bd","aa9bb85ef7e0dcc9820bd8a19e697639be6fae98e5084c9db2856d693ad96cab","7b07df2c44bd19c37b06b8c6c2b561e42c936e3ecce050fc1df689004eb6bd25","b093731b86403b1c56e6af50de71fd6d32b053d56be1959e62fe566acf7ebe05","73774ad872e18719d2f0982481fa4c9c419e3d3d0def00b5829d778ba2b0331d","fc54e696099a663d593535453bc3736c15c34f16110d7fe2aa3e9fcb13f022e5","cff615613cc25ea19c477b5f8922bd5fc3512d6b9775da76baab9c1cc1cc971a","3b5b0af03b34b4ca6702f609d28c6f1483d22dc4ef013cff3f9f6b3d4f15a36e","3cea85559bc40796474f6ff1721cbb3e3bda37ad7e1089ab865308b8f339ef46","91cd8a1f27af6e20478ee2489b2ed04f0556755374522c7f2bb69acea3bd14a7","bb46b17849be9df12518511ea27947cd9d126e6977bab1b484622efe2b09753f","bc11eb153d307b58effbf0bb17283f13e095abaa71a2ac8d24a943ae99a49a99","0b3d60856d99480ab5e0b33a4ff69f2c5a7b6a022f5e9df3f258f62a49de2d8b","52fb552d2c8b9627f9ca59b8b07807d7b8b3f557a60043da6fafa81e1aaa3fe6","1afe31147fa2cc2d9b8ae0ae954ec937e86f4f49c247165b66d7a429d1d258bb","44188338e8d899dcb6817722dcb97818536fee66cca91aeb446f1fe304396df1","18c8505f37ad6f9d2ac5cba8f2a53353cf1bdc93abfaba36c8445391696a0aab","c417a3a2fe43b520b2a670392f89c5a5e4c6c7fc3d5c1b51253609f83a599d38","131cafb9143f624140c24f4a4744a3301045fedaff3faa2e8136b157f4e59a7e"],"paragraph_range_zero_based":[44136,44159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p44136"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Only if this field is present, the UE supporting dynamic UL Tx switching shall indicate support for UL Tx switching in band combinations which are applicable to inter-band UL CA, SUL and (NG)EN-DC.","paragraph_zero_based":44160},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44161},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44162},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44163},{"literal_text_all_w_t_and_m_t":"NRDC","paragraph_zero_based":44164},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N, if includeNR-DC is included. It is absent otherwise.","paragraph_zero_based":44165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44166},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRequestFilterNR","paragraph_zero_based":44167},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRequestFilterNR is used to request filtered UE capabilities.","paragraph_zero_based":44168},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR information element","paragraph_zero_based":44169},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44170},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-START","paragraph_zero_based":44171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44172},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR ::=            SEQUENCE {","paragraph_zero_based":44173},{"literal_text_all_w_t_and_m_t":"    frequencyBandListFilter                     FreqBandList                          OPTIONAL,   -- Need N","paragraph_zero_based":44174},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1540    OPTIONAL","paragraph_zero_based":44175},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44177},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1540 ::=      SEQUENCE {","paragraph_zero_based":44178},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingTimeRequest                    ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":44179},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1710    OPTIONAL","paragraph_zero_based":44180},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44182},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1710 ::=      SEQUENCE {","paragraph_zero_based":44183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["28eb73f010c63e2465a9c1aaae94c08a4c9ff886cff07d9b88a3ab6d20e9cc10","8138eedd11672c4629c3ad07fe7e1f5332fa7e11bc71780cea0a3f5336c2fa57","093c3d14b365a18b28a0bdc839e687a0bbe79be69a3e3c941aae141372fc8193","85a0330654d671c16c1257f26e5189af1d054cdb866cb85a2a36669489aee9a0","b04ea1f98bd46114a0cd9ef921f2caa2919bd0ca5390b4a430d8034c772c0050","8d1ddb125bcd30c5cccec43dc828524dca1ad1aabc8c5bb6c5918b319325eb5e","ca16be0076aed1cd5d71191b6a84f74fb9e72a6d3e8f19fc65c716bd1f49f4c2","635b3efe4430351c5d68408c08cf0ffd352ed75b054f32b7f4ace646077f0ee4","9db2965f5df8df40a9866010ede33de3924d50cc7678d7ac7666b3e1b716bc03","76f20d39ae0718755bed6a87899685598b21a19a930416116b09ff518ed685ed","d9225352fba2cd22caff56ffa7ff953a91d747422573d6a9e42ad2abed25c12d","3fd713864d14a0ea14a8e96302130c064395fe32fabf6d01c3ac7343b6138618","3b997d5