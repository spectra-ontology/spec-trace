{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":22920},{"literal_text_all_w_t_and_m_t":"meanAnomaly","paragraph_zero_based":22921},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: Mean anomaly M at epoch time, see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":22922},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":22923},{"literal_text_all_w_t_and_m_t":"periapsis","paragraph_zero_based":22924},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: argument of periapsis , see NIMA TR 8350.2 [71]. Unit is radian.","paragraph_zero_based":22925},{"literal_text_all_w_t_and_m_t":"Step of 2.341* 10-8 rad. Actual value = field value * (2.341* 10-8).","paragraph_zero_based":22926},{"literal_text_all_w_t_and_m_t":"positionX, positionY, positionZ","paragraph_zero_based":22927},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite position state vector in ECEF. Unit is meter.","paragraph_zero_based":22928},{"literal_text_all_w_t_and_m_t":"Step of 1.3 m. Actual value = field value * 1.3.","paragraph_zero_based":22929},{"literal_text_all_w_t_and_m_t":"semiMajorAxis","paragraph_zero_based":22930},{"literal_text_all_w_t_and_m_t":"Satellite orbital parameter: semi major axis , see NIMA TR 8350.2 [71]. Unit is meter.","paragraph_zero_based":22931},{"literal_text_all_w_t_and_m_t":"Step of 4.249 * 10-3 m. Actual value = 6500000 + field value * (4.249 * 10-3).","paragraph_zero_based":22932},{"literal_text_all_w_t_and_m_t":"velocityVX, velocityVY, velocityVZ","paragraph_zero_based":22933},{"literal_text_all_w_t_and_m_t":"X, Y, Z coordinate of satellite velocity state vector in ECEF. Unit is meter/second.","paragraph_zero_based":22934},{"literal_text_all_w_t_and_m_t":"Step of 0.06 m/s. Actual value = field value * 0.06.","paragraph_zero_based":22935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22936},{"literal_text_all_w_t_and_m_t":"–EpochTime","paragraph_zero_based":22937},{"literal_text_all_w_t_and_m_t":"The IE EpochTime is used to indicate the epoch time for the NTN assistance information, and it is defined as the starting time of a DL sub-frame, indicated by a SFN and a sub-frame number signaled together with the assistance information. The reference point for EpochTime of the serving or neighbour NTN payload ephemeris and Common TA parameters is the uplink time synchronization reference point when this field is provided in an NTN cell and the gNB when this field is provided in a TN cell.","paragraph_zero_based":22938},{"literal_text_all_w_t_and_m_t":"EpochTime information element","paragraph_zero_based":22939},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22940},{"literal_text_all_w_t_and_m_t":"-- TAG-EPOCHTIME-START","paragraph_zero_based":22941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22942},{"literal_text_all_w_t_and_m_t":"EpochTime-r17 ::=              SEQUENCE {","paragraph_zero_based":22943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["84a30ac941dca4910a3878392c3771815b43f9fb40ee5941f0d101f999550ada","5c07ec8814039198d1d66bc5231c1165d4e0e66648a55ef86a6445a4b0f9681e","50011040fc72ea00704c085f73df072c9868615b3a2bb5cb3733bc43e3897a5f","13cedaa9e1dfa22bfcb27c0e807cdd5ee31c1fc1c55973424ca3d129d6580516","252546fbffc9c3546934b169d62bd81577242ee6230302452d6e3d05a0144dac","e1b62acf0f7eef56c97fe099b8f07f4024af568e5a482556