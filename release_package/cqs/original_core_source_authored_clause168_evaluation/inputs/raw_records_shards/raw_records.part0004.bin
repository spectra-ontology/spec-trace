{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rb-SetGroups","paragraph_zero_based":18336},{"literal_text_all_w_t_and_m_t":"Indicates the RB set groups configured for the availability combination. Each group includes consecutive RB sets.","paragraph_zero_based":18337},{"literal_text_all_w_t_and_m_t":"rb-Sets","paragraph_zero_based":18338},{"literal_text_all_w_t_and_m_t":"Indicates the one or more RB set indexes associated to one or more RB sets configured for one RB set group.","paragraph_zero_based":18339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18340},{"literal_text_all_w_t_and_m_t":"–AvailabilityIndicator","paragraph_zero_based":18341},{"literal_text_all_w_t_and_m_t":"The IE AvailabilityIndicator is used to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":18342},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator information element","paragraph_zero_based":18343},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18344},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYINDICATOR-START","paragraph_zero_based":18345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18346},{"literal_text_all_w_t_and_m_t":"AvailabilityIndicator-r16 ::=    SEQUENCE {","paragraph_zero_based":18347},{"literal_text_all_w_t_and_m_t":"    ai-RNTI-r16                      AI-RNTI-r16,","paragraph_zero_based":18348},{"literal_text_all_w_t_and_m_t":"    dci-PayloadSizeAI-r16            INTEGER (1..maxAI-DCI-PayloadSize-r16),","paragraph_zero_based":18349},{"literal_text_all_w_t_and_m_t":"    availableCombToAddModList-r16    SEQUENCE (SIZE(1..maxNrofDUCells-r16)) OF AvailabilityCombinationsPerCell-r16          OPTIONAL, -- Need N","paragraph_zero_based":18350},{"literal_text_all_w_t_and_m_t":"    availableCombToReleaseList-r16   SEQUENCE (SIZE(1..m