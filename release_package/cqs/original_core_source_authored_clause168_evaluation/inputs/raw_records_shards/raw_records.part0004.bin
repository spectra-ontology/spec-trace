{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SchedulingRequestConfig field descriptions","paragraph_zero_based":32280},{"literal_text_all_w_t_and_m_t":"schedulingRequestToAddModList, schedulingRequestToAddModListExt","paragraph_zero_based":32281},{"literal_text_all_w_t_and_m_t":"List of Scheduling Request configurations to add or modify. If schedulingRequestToAddModListExt is configured, it contains the same number of entries, and in the same order, as schedulingRequestToAddModList.","paragraph_zero_based":32282},{"literal_text_all_w_t_and_m_t":"schedulingRequestToReleaseList","paragraph_zero_based":32283},{"literal_text_all_w_t_and_m_t":"List of Scheduling Request configurations to release.","paragraph_zero_based":32284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32285},{"literal_text_all_w_t_and_m_t":"SchedulingRequestToAddMod field descriptions","paragraph_zero_based":32286},{"literal_text_all_w_t_and_m_t":"schedulingRequestId","paragraph_zero_based":32287},{"literal_text_all_w_t_and_m_t":"Used to modify a SR configuration and to indicate, in LogicalChannelConfig, the SR configuration to which a logical channel is mapped and to indicate, in SchedulingRequestresourceConfig, the SR configuration for which a scheduling request resource is used.","paragraph_zero_based":32288},{"literal_text_all_w_t_and_m_t":"sr-ProhibitTimer","paragraph_zero_based":32289},{"literal_text_all_w_t_and_m_t":"Timer for SR transmission on PUCCH in TS 38.321 [3]. Value is in ms. Value ms1 corresponds to 1ms, value ms2 corresponds to 2ms, and so on. If sr-ProhibitTimer-v1700 is configured, UE shall ignore sr-ProhibitTimer (without suffix). If both sr-ProhibitTimer (without suffix) and sr-ProhibitTimer-v1700 are absent, the UE applies the value 0.","paragraph_zero_based":32290},{"literal_text_all_w_t_and_m_t":"sr-TransMax","paragraph_zero_based":32291},{"literal_text_all_w_t_and_m_t":"Maximum number of SR transmissions as described in TS 38.321 [3]. Value n4 corresponds to 4, value n8 corresponds to 8, and so on. ","paragraph_zero_based":32292},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32293},{"literal_text_all_w_t_and_m_t":"–SchedulingRequestId","paragraph_zero_based":32294},{"literal_text_all_w_t_and_m_t":"The IE SchedulingRequestId is used to identify a Scheduling Request instance in the MAC layer.","paragraph_zero_based":32295},{"literal_text_all_w_t_and_m_t":"SchedulingRequestId information element","paragraph_zero_based":32296},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32297},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTID-START","paragraph_zero_based":32298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32299},{"literal_text_all_w_t_and_m_t":"SchedulingRequestId ::=             INTEGER (0..7)","paragraph_zero_based":32300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32301},{"literal_text_all_w_t_and_m_t":"-- TAG-SCHEDULINGREQUESTID-STOP","paragraph_zero_based":32302},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["188a54f71d27d62f713172147a974e5b2362015e6670f5e7ab897d844c643c75","511bf5562b330904007dc0d8cb841da1ce5f355e610a798fe1134cdadf48c09a","7aa609828d4b0a593a452c555824aba583422c528a511dfd8b26edfd7140f75b","901ff84547cd7ed088ee38535fa616c4ff125287f5a61c0e9da8f30868381315","66f63e2e9192a454a93c4d38d111cdb06acb141f71529d7b592f2910ea90d48f","b50a6234b0b760911c69dab42db2865ed84dba60bf7a2285a4c3f9c38e0389da","1a4b7df6a93f5a7481d39a3ab144597b