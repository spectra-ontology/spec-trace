{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI-r18                   SEQUENCE {","paragraph_zero_based":34200},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI-r18                      RACH-ConfigGeneric,","paragraph_zero_based":34201},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion-r18               ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":34202},{"literal_text_all_w_t_and_m_t":"    }                                                                                                               OPTIONAL,  -- Need R","paragraph_zero_based":34203},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum2-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":34204},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum4-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":34205},{"literal_text_all_w_t_and_m_t":"    si-RequestResourcesRepetitionNum8-r18  SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResourcesRepetition-r18  OPTIONAL,  -- Need R","paragraph_zero_based":34206},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":34207},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34209},{"literal_text_all_w_t_and_m_t":"SI-RequestResourcesRepetition-r18 ::=  SEQUENCE {","paragraph_zero_based":34210},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex-r18              INTEGER (0..63),","paragraph_zero_based":34211},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex-r18           INTEGER (0..15)                                                          OPTIONAL   -- Need R","paragraph_zero_based":34212},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34214},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIGREPETITION-STOP","paragraph_zero_based":34215},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34217},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition field descriptions","paragraph_zero_based":34218},{"literal_text_all_w_t_and_m_t":"si-RequestResourcesRepetitionNum2, si-RequestResourcesRepetitionNum4, si-RequestResourcesRepetitionNum8","paragraph_zero_based":34219},{"literal_text_all_w_t_and_m_t":"Indicates the configurations for Msg1-based SI request with Msg1 repetition for repetition number 2, 4 and 8, respectively.","paragraph_zero_based":34220},{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":34221},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfigRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34222},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfigRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["00d9fa2cbce55b6aea59cd171f43fb230954e178d325f469b9e5ceffba9f1b90","5bd45ecc44928e9a9c6679fe9a6951f8409f8b567b2563000368679b29288020","2b4c85915435cf156bb3f81c2a2372407cbca5088aec005f49c7718be992edfd","ead29808a9c3e0a9f0e6d07cd409e7770b5703d37ecd65518bed49390453ec6f","ba20601163e3b66c756b6fe05c7fe79f084dbf6c4c73713f417fc25a93b3eee6","885e133cdf8eba3de7f7b30237f03e135730fb23e381dd09fdab8469a9cb984e","af1d2765bf304c4e93365de009ca41cf9d8dbd84c53713d611fb092c24f8b1ce","61f83a3f79f579be7a005de4ea3736b0f6da9260035465be2cd89c7cc762b2c6","055c0db19401e0e1d18c64b792bcce429562de82c90d0a54a440efd087673d4c","11593fc684a9693ed4850d9795ace54d02357aafd4bd3987dcbc61acef3509d2","c24e7b5c134c5e02462a0a0e65b1ab7d38db93e52c4f23d58de8cb6742df3646","70c004f208e101c63074fd923fab4294ce641542447ccf9f25d1be8e4327e9c6","e5bd403443fc8124bad94fdcb8d32e459c6e1a82a8c0c4a4243b4e88246feed0","040cf4457a758eeafc26c7c7406d7cd9d605f39dec872b9c9902be74efbe4a8d","adec85ea3a7991308fc5a6c306d38ba7be8f44f4b30139b78a1683ef7eec8acc","f0c169fc3f46603d5a50561794afaf5b33e736fe6e9b32fc570a22945d69c7f0","f8fa8fd85e96bab8ce36ad6178aa6301ce2fbc5c4ec7457b998fca2b2fedf8a4","63c5f2f13ed4970962b75c820c900d53c6a75c1efcc773ba2f77fd7e27817cdd","505b72975adb468bc21ead5b88167cb73b59d3e955aeb24ffdfc325f266b6d47","4b1c26aaffecce926b915dd6a526ec6a9de8584492e94407412714e4f0b4df69","15d50fd7ef68aa5f1cef804fb4b1ce7707c2b421ba906de1d7644616f2289cc2","3e9aa2bfe8d6426a59d48a995b87632c79dceb27ee923939de6164320d0517d5","7219811857d278896cb426f924010898479eabf840864d145d1b4641a645d900","6674bfaefc8f1405762c0a49b433ed34dd622a746f475f9f82af9a387d8fc35a"],"paragraph_range_zero_based":[34200,34223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfigRepetitioNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8n is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34224},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResourcesRepetitionNum2/SI-RequestConfigRepetitionNum4/SI-RequestConfigRepetitionNum8 should not result in system information change notification.","paragraph_zero_based":34225},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34226},{"literal_text_all_w_t_and_m_t":"–SI-SchedulingInfo","paragraph_zero_based":34227},{"literal_text_all_w_t_and_m_t":"The IE SI-SchedulingInfo contains information needed for acquisition of SI messages.","paragraph_zero_based":34228},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo information element","paragraph_zero_based":34229},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34230},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-START","paragraph_zero_based":34231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34232},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo ::=               SEQUENCE {","paragraph_zero_based":34233},{"literal_text_all_w_t_and_m_t":"    schedulingInfoList                  SEQUENCE (SIZE (1..maxSI-Message)) OF SchedulingInfo,","paragraph_zero_based":34234},{"literal_text_all_w_t_and_m_t":"    si-WindowLength                     ENUMERATED {s5, s10, s20, s40, s80, s160, s320, s640, s1280, s2560-v1710, s5120-v1710 },","paragraph_zero_based":34235},{"literal_text_all_w_t_and_m_t":"    si-RequestConfig                    SI-RequestConfig                                                OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":34236},{"literal_text_all_w_t_and_m_t":"    si-RequestConfigSUL                 SI-RequestConfig                                                OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":34237},{"literal_text_all_w_t_and_m_t":"    systemInformationAreaID             BIT STRING (SIZE (24))                                          OPTIONAL,  -- Need R","paragraph_zero_based":34238},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":34239},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34241},{"literal_text_all_w_t_and_m_t":"SchedulingInfo ::=                  SEQUENCE {","paragraph_zero_based":34242},{"literal_text_all_w_t_and_m_t":"    si-BroadcastStatus                  ENUMERATED {broadcasting, notBroadcasting},","paragraph_zero_based":34243},{"literal_text_all_w_t_and_m_t":"    si-Periodicity                      ENUMERATED {rf8, rf16, rf32, rf64, rf128, rf256, rf512},","paragraph_zero_based":34244},{"literal_text_all_w_t_and_m_t":"    sib-MappingInfo                     SIB-Mapping","paragraph_zero_based":34245},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"c