{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    flightPathAvailabilityIndicationUAI-r18       ENUMERATED {supported}                               OPTIONAL,","paragraph_zero_based":36312},{"literal_text_all_w_t_and_m_t":"    -- Support of numberOfTriggeringCells for eventA3, eventA4, and eventA5, and additionally, if the UE supports eventAxHy-r18,","paragraph_zero_based":36313},{"literal_text_all_w_t_and_m_t":"    -- support of numberOfTriggeringCells for eventA3H1, eventA3H2, eventA4H1, eventA4H2, eventA5H1, and eventA5H2","paragraph_zero_based":36314},{"literal_text_all_w_t_and_m_t":"    multipleCellsMeasExtension-r18                ENUMERATED {supported}                               OPTIONAL,","paragraph_zero_based":36315},{"literal_text_all_w_t_and_m_t":"    -- Support aerial-specific Ns and Pmax list broadcasted by the cell","paragraph_zero_based":36316},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxListAerial-r18                      ENUMERATED {supported}                               OPTIONAL, -- Editor's Note:","paragraph_zero_based":36317},{"literal_text_all_w_t_and_m_t":"    -- Understanding is that a UE that doesn't support any frequency band that requires an aerial specific NS value doesn't need to","paragraph_zero_based":36318},{"literal_text_all_w_t_and_m_t":"    -- implement the procedure for aerial specific NS value. Whether indication is needed is still FFS. This is only shown as","paragraph_zero_based":36319},{"literal_text_all_w_t_and_m_t":"    -- placeholder. Support of reporting only the measurement report corresponding to the event with the smallest value between the","paragraph_zero_based":36320},{"literal_text_all_w_t_and_m_t":"    -- altitude of the UAV and the altitude threshold for which the altitude-related entering condition e.g. A3H1-2 is satisfied, when","paragraph_zero_based":36321},{"literal_t