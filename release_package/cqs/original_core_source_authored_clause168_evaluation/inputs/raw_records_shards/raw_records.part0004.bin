{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Sensor-NameList information element","paragraph_zero_based":45528},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45529},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-START","paragraph_zero_based":45530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45531},{"literal_text_all_w_t_and_m_t":"Sensor-NameList-r16 ::= SEQUENCE {","paragraph_zero_based":45532},{"literal_text_all_w_t_and_m_t":"    measUncomBarPre-r16     ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":45533},{"literal_text_all_w_t_and_m_t":"    measUeSpeed             ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":45534},{"literal_text_all_w_t_and_m_t":"    measUeOrientation       ENUMERATED {true}            OPTIONAL   -- Need R","paragraph_zero_based":45535},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45537},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-STOP","paragraph_zero_based":45538},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45540},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45541},{"literal_text_all_w_t_and_m_t":"Sensor-NameList field descriptions","paragraph_zero_based":45542},{"literal_text_all_w_t_and_m_t":"measUncomBarPre","paragraph_zero_based":45543},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the uncompensated Barometric pressure measurement as defined in TS 37.355 [49].","paragraph_zero_based":45544},{"literal_text_all_w_t_and_m_t":"measUeSpeed","paragraph_zero_based":45545},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the UE speed measurement as defined in TS 37.355 [49].","paragraph_zero_based":45546},{"literal_text_all_w_t_and_m_t":"measUeOrientation","paragraph_zero_based":45547},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the UE orientation information as defined in TS 37.355 [49].","paragraph_zero_based":45548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45549},{"literal_text_all_w_t_and_m_t":"–TraceReference","paragraph_zero_based":45550},{"literal_text_all_w_t_and_m_t":"The TraceReference contains parameter Trace Reference as defined in TS 32.422 [52].","paragraph_zero_based":45551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6c3281c4da9a148ca22ff7caf08d25be048dac0ada1080950ebae94332fb4097","12067a3800e6ff09a7806cbc6ea480a258468a355645768fbaf82dcf6c64cd77","959c198e96cae08ea20d12cad782dc84afadfc92731a0d0d3b1ca6c00803adc8","0ec26edb9274f8567121b9d7908805e0194741d176a98a74ea62b17f1eee563f","ee0547eaa62966e2105b38f92f6869e477c272c2108ef1ec6b024537430999c3","125f06659868ca0104760878440d7fb090847c8835d0b1b8e33912cd2e6bb402","ad7909ac24832ac4347a727fcc4ce6a3b0fbe899043640396be4c978a8fc2e0a","c4ef31adaa7e2db7a0561d3a9f7dfe7aef34379b9029c651897335b2a42fb008","9833661049e4ef4fcbedb12dfbc382a390545d853027577767efa6c1abafaba4","0bd5b91dbc69963a38abfd4b9889e862ddbb3c219690d57051b49eb17fbf1b84","8a007067ae7456559131d74980d055b0e14465e23a91bee6501a2018ddd41ec1","de2c256cf3f0d4a45807eed41a7ce55cfe45055486f81648358327537290c77d","027d655c1e4ba473b6f1f49e6519b2d1bf40d4acb8ebc534c0f024bbfef540c3","e29e7b6e3d1ad50f921a0950bc05fe2acafaf5640e7f60218fae4cf44795c32b","b589895d4d5fcfb3d2d0ba9992808fc590cf008927ea37f14549366cb8a4473c","efec56c402f01f93ca47b7e1cc917bdc0bd3b138a351d5601df2d979e9c8e47c","6e2f