{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RxTxPeriodical field descriptions","paragraph_zero_based":32184},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":32185},{"literal_text_all_w_t_and_m_t":"This field indicates the number of UE Rx-Tx time difference measurement reports. If configured to r1, the network does not configure rxTxReportInterval and only one measurement is reported. If configured to infinity, UE periodically reports measurements according to the periodicity configured by rxTxReportInterval.","paragraph_zero_based":32186},{"literal_text_all_w_t_and_m_t":"rxTxReportInterval","paragraph_zero_based":32187},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement reporting periodicity of UE Rx-Tx time difference.","paragraph_zero_based":32188},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32189},{"literal_text_all_w_t_and_m_t":"other field descriptions","paragraph_zero_based":32190},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantity","paragraph_zero_based":32191},{"literal_text_all_w_t_and_m_t":"SINR is applicable only for CONNECTED mode events.","paragraph_zero_based":32192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32193},{"literal_text_all_w_t_and_m_t":"ReportOnScellActivation field descriptions","paragraph_zero_based":32194},{"literal_text_all_w_t_and_m_t":"rsType","paragraph_zero_based":32195},{"literal_text_all_w_t_and_m_t":"Indicates which RS is used to provide the measurement result. Only value ssb can be set in this release.","paragraph_zero_based":32196},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":32197},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index is used to sort the reported measurement results and is included in the measurement report.","paragraph_zero_based":32198},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":32199},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":32200},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":32201},{"literal_text_all_w_t_and_m_t":"Indicates whether to include the measurement result per RS index in the measurement report.","paragraph_zero_based":32202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32203},{"literal_text_all_w_t_and_m_t":"CellIndividualOffsetList field descriptions","paragraph_zero_based":32204},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":32205},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific measurement event.","paragraph_zero_based":32206},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":32207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["edca6f5d49ce5a28ae41eca51ccbccc36b658842728c19ef067c179f49e9d344","eeba10095c5603fa6e1b4e6fbd8d1a22a281223d19affd27fba1b846df68c65b","b1f29bc2fd7142d168dade25a1cd9e6281cda8429686749bc461163ce98a7816","d6ee18c24cb144f6b794d822e2f35bec972fd0a0e525380b51857b0ce5a389de","9b49ee1d8f37579d0d004159136f0550472acb24a5f028b71f1ca5a19ab919e3","4574c98046e95088f09fc8a485b9304adb47801ab8398e16986443db042359ad","861e3baa6711e4c9a776d4893f40b0f776589f82ae7f7aa15d169da2526ee62f","593585079ec8eb7e6a062de2c391f6b4ca15d7868cca700e9d9ae42a3a4f267a","d1454c26e1b7ae1da69a2d831b29a5f3bcba390d2bbd5a02a50bb19e88483c2c","cf01f6b900def0f053f16aadcbd627ac2400268ef4f6d7050cb7448670c38820","9e5d9fa1c537418b24990