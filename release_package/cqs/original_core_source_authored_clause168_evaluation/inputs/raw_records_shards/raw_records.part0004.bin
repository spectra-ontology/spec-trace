{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap configuration configured by gapUE.","paragraph_zero_based":5544},{"literal_text_all_w_t_and_m_t":"1>for each measGapId included in the received gapToReleaseList:","paragraph_zero_based":5545},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measGapId;","paragraph_zero_based":5546},{"literal_text_all_w_t_and_m_t":"1>for each measPosPreConfigGapId included in the received posMeasGapPreConfigToReleaseList:","paragraph_zero_based":5547},{"literal_text_all_w_t_and_m_t":"2>release the measurement gap configuration associated with the measPosPreConfigGapId;","paragraph_zero_based":5548},{"literal_text_all_w_t_and_m_t":"1>for each GapConfig received in gapToAddModList:","paragraph_zero_based":5549},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the GapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5550},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":5551},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":5552},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":5553},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":5554},{"literal_text_all_w_t_and_m_t":"2>apply the measurement gap as per UE measurement gap, FR1 measurement gap, or FR2 measurement gap according to the gapType indicated by the GapConfig;","paragraph_zero_based":5555},{"literal_text_all_w_t_and_m_t":"2>associate the measurement gap with the measGapId indicated by the GapConfig;","paragraph_zero_based":5556},{"literal_text_all_w_t_and_m_t":"2>if gapSharing in the GapConfig is present:","paragraph_zero_based":5557},{"literal_text_all_w_t_and_m_t":"3>setup the gap sharing configuration for the measurement gap in accordance with the received gapSharing as defined in TS 38.133 [14];","paragraph_zero_based":5558},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5559},{"literal_text_all_w_t_and_m_t":"3>release the gap sharing configuration (if configured) for the measurement gap;","paragraph_zero_based":5560},{"literal_text_all_w_t_and_m_t":"1>for each PosGapConfig received in PosMeasGapPreConfigToAddModList:","paragraph_zero_based":5561},{"literal_text_all_w_t_and_m_t":"2>if a measurement gap configuration associated with the measPosPreConfigGapId indicated by the PosGapConfig is already setup:","paragraph_zero_based":5562},{"literal_text_all_w_t_and_m_t":"3>release the measurement gap configuration;","paragraph_zero_based":5563},{"literal_text_all_w_t_and_m_t":"2>setup measurement gap configuration indicated by the PosGapConfig in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5564},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":5565},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":5566},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":5567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4b27228b23a0e98019f9276a4c84b6ff62fb53466261da20112a9a56e4439360","124b5c0711db41b16bb9f311bebc7f8ee16fb7489be680a426c1c12f2b4b1259","caf7e5fc929ef17b7629774a880a434339db899b786ec03bae4a0c4a5324bedb","5afe839cfb6622b5412ce33476a489fa2cc8580009015fce0f8e0ef380624ef4","fdfacc89cd81e2dfba6368d62c14abbea0290964e5710a193bd7ce7b15f5b742","15ae1d07c1a6c9e6f6c0aea3e9a7af7276d68a80cd21ecca933da17421ded31d","08f0acbf372ea7cc1c99b60b874baa18c0c44e52bb57de21ea293e11c2fc90ee","e209027991c6f79924a69db06ef58702acfa240ca5e05d241bfab73b51f1bab4","9aad75536a0f2512b47e72ec4b2dbfffe50f9d9bbf760ff7ae966fecc9cd8ba1","033ae2e61f2a71efd15d0032d9a41f9a21f1f27d548492869473d975ffb010e0","1111a5b4e54706b838f0dd929c5779743d999e4e28b09dcaf69c7860f4a97f89","4abc4010ceb1452e96e173511487b88a688781dc62a4afed67a7298b6cd1a4e7","51a43f54f7b097f555799d1129f1e2499cc1ec9063bc64db717b0476cf9bd997","443bd6470c50d26b637e47aa03464527d1d55cc2f8f0cce5c95fadb01de56b71","a08c0c41d557830774272ff0eccf851c5c128cf5c853982cff10366244abadb1","6c8a97385b34d19860395a3bfd468d13c8c6fb441e841f631ee55dce6b25922a","242e3a520e7a56abe0c829752b5b6eeebfc8b6f5bb33624a73053465e300b6c6","69fa6fd36c0452a240ad4406cf1e80bf4ab0c4e6f645e20ca45d3db6dadbc075","d7a65798a9a9724e3c7eea3cd2c78f9c3fedf14153cbc8cb0caf45098120328c","dd4d48f34fa69535b9d5d5c6c8e040ca26cd36f2bd9d8c597d2165d05be1e1ff","74073cfd12ecfde7485662069a7d7b0526df7ace4157243eb477757535847d7a","ebef1f5f010a484a2ba31ca31dda7c5e026a3a9bf826dded0deb2bcdd5f0ab66","3fca3eb5e0573dd47cb347038c0f7bcf743c2bb425dfd1d9b0fba0e11755951d","6934087844353202229eaf82e1c9c1c0c5c4c0d42e9fb9a02a16000c7539decd"],"paragraph_range_zero_based":[5544,5567],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5544"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":5568},{"literal_text_all_w_t_and_m_t":"2>configure the measurement gap as indicated by gapType;","paragraph_zero_based":5569},{"literal_text_all_w_t_and_m_t":"1>for each FR1, FR2, and per UE measurement gap that is setup:","paragraph_zero_based":5570},{"literal_text_all_w_t_and_m_t":"2>if the measurement gap is configured by GapConfig and preConfigInd-r17 in the corresponding GapConfig is present:","paragraph_zero_based":5571},{"literal_text_all_w_t_and_m_t":"3>determine whether the measurement gap is activated or not according to TS 38.133 [14];","paragraph_zero_based":5572},{"literal_text_all_w_t_and_m_t":"2>else if the measurement gap is configured by PosGapConfig:","paragraph_zero_based":5573},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be deactivated;","paragraph_zero_based":5574},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5575},{"literal_text_all_w_t_and_m_t":"3>consider the measurement gap to be activated.","paragraph_zero_based":5576},{"literal_text_all_w_t_and_m_t":"NOTE 1:For FR2 gap configuration with synchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency is used in the gap calculation","paragraph_zero_based":5577},{"literal_text_all_w_t_and_m_t":"NOTE 2:For FR1 gap or per UE gap configuration, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator in is used in the gap calculation. Otherwise, the SFN and subframe of the PCell is used in the gap calculation.","paragraph_zero_based":5578},{"literal_text_all_w_t_and_m_t":"NOTE 3:For FR2 gap configuration with asynchronous CA, for the UE in NE-DC or NR-DC, the SFN and subframe of the serving cell indicated by the refServCellIndicator and refFR2ServCellAsyncCA is used in the gap calculation. Otherwise, the SFN and subframe of a serving cell on FR2 frequency indicated by the refFR2ServCellAsyncCA is used in the gap calculation","paragraph_zero_based":5579},{"literal_text_all_w_t_and_m_t":"5.5.2.10Reference signal measurement timing configuration","paragraph_zero_based":5580},{"literal_text_all_w_t_and_m_t":"The UE shall setup the first SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicityAndOffset parameter (providing Periodicity and Offset value for the following condition) in the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":5581},{"literal_text_all_w_t_and_m_t":"SFN mod T = (FLOOR (Offset/10));","paragraph_zero_based":5582},{"literal_text_all_w_t_and_m_t":"if the Periodicity is larger than sf5:","paragraph_zero_based":5583},{"literal_text_all_w_t_and_m_t":"subframe = Offset mod 10;","paragraph_zero_based":5584},{"literal_text_all_w_t_and_m_t":"else:","paragraph_zero_based":5585},{"literal_text_all_w_t_and_m_t":"subframe = Offset or (Offset +5);","paragraph_zero_based":5586},{"literal_text_all_w_t_and_m_t":"with T = CEIL(Periodicity/10).","paragraph_zero_based":5587},{"literal_text_all_w_t_and_m_t":"If smtc2 is present, for cells indicated in the pci-List parameter in smtc2 in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2 configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":5588},{"literal_text_all_w_t_and_m_t":"If smtc2-LP is present, for cells indicated in the pci-List parameter in smtc2-LP in the same frequency (for intra frequency cell reselection) or different frequency (for inter frequency cell reselection), the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received periodicity parameter in the smtc2-LP configuration and use the Offset (derived from parameter periodicityAndOffset) and duration parameter from the smtc configuration for that frequency. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell or serving cell (for cell reselection) meeting the above condition.","paragraph_zero_based":5589},{"literal_text_all_w_t_and_m_t":"If smtc3list is present, for cells indicated in the pci-List parameter in each SSB-MTC3 element of the list in the same MeasObjectNR, the IAB-MT shall setup an additional SS block measurement timing configuration in accordance with the received periodicityAndOffset parameter (using same condition as smtc1 to identify the SFN and the subframe for SMTC occasion) in each SSB-MTC3 configuration and use the duration and ssb-ToMeasure parameters from each SSB-MTC3 configuration.","paragraph_zero_based":5590},{"literal_text_all_w_t_and_m_t":"If smtc4list is present, for cells indicated in the pci-List parameter in each SSB-MTC4 element of the list in the same MeasObjectNR, the UE shall setup an additional SS/PBCH block measurement timing configuration (SMTC) in accordance with the received offset parameter in each SSB-MTC4 configuration and use the duration parameter and periodicity (derived from parameter periodicityAndOffset) from the smtc1 configuration. The first subframe of each SMTC occasion occurs at an SFN and subframe of the NR SpCell meeting the above condition.","paragraph_zero_based":5591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0a024f93b0b6036eba27021eeb9acb8ba7ac8951b50a49542e8b4f570dec38e2","b828654bfcc49c634f1e41404f940f8cd7b6db1abb87071b063e826f3d3d0af0","1effe4ac4a13f028344ee2df512f6a30d5b16f93d9a3413eb45643f0efaeb1e7","666616998bdb343ef856d9da5a174d31fe63321db6d64125344f9667bcd5d956","28372a110d2a60b31e2d131b92f1e2c577d852a933b7ca32030df3debfa91055","a17bef417e451cffaf0b0f52c3039c8858e42c30de930206ef616edd703898e0","e426d587ff8738075e8f00537da961cf1569e4850f0791c9f1886f229dd4c2f4","644229b7677b49778d065dc6988b20852c38b2ec5d06f614261d870d37605ece","316b00ea03862c670f3f5347d718824ab0e10d88b9ddae40692bceaa781e9c23","cc60c4ec18c663cf869feb1a1f89c378f32368c616d0f6bc0993250fa012cc01","823c77f19d931b6b3ecd71dfd0faede51d2b0106c264321e17d45472d9d7df57","1d25cbc102ad2477ceb3a6610ba3761d32bb2b9e069b65d60e7044f73665a66f","9eb4005876efe540d110b55bd3590161b9228bb6dfc7c8829923180f67f7e628","baba6d73e9fa7d75317129db06a8d108d867d8e37e60af50d69a1a60b659358d","f96ebe0612c03dabfed3ed15723257b75d385671424c073d9c763a5f7f965a8a","f3419fecd3a94398cbd978478e249bfd95cefc23bf017cd2c693a19b8e7c5a93","1f6732611aec5508bf88b3b41864789a1b25ef9048b56c7243745c2f23eb1867","d16358b28fe259e5518dabd1042737032947514a77838ed7ba7ecda10b5b3cdb","6ddc78747c976e7fb2c14e26833d071544a034dbc4cbb61d83b7d0ff07bca832","b3f9f16238368b570455fe831691bfe4044b62646964387f1f429b1e7090b799","29fe91f3bf69092bf2d09dade6ee90c71cecad3a13d165c42162a73a880276da","3ab4968c394ec44ef7a65862a0691395866098c1895351b0818c40c4244800a1","3ba685bb1b846ce60f332109ee11285e583b9e44ff044a1369e0bbc285cd1736","b62fb9c0b10e59043210125e14aee6f2ede8ab0a89915b2055ea0bea7db11840"],"paragraph_range_zero_based":[5568,5591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5568"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"On the indicated ssbFrequency, the UE shall not consider SS/PBCH block transmission in subframes outside the SMTC occasion for RRM measurements based on SS/PBCH blocks and for RRM measurements based on CSI-RS except for SFTD measurement (see TS 38.133 [14], clause 9.3.8).","paragraph_zero_based":5592},{"literal_text_all_w_t_and_m_t":"5.5.2.10aRSSI measurement timing configuration","paragraph_zero_based":5593},{"literal_text_all_w_t_and_m_t":"The UE shall setup the RSSI measurement timing configuration (RMTC) in accordance with the received rmtc-Periodicity and, if configured, with rmtc-SubframeOffset i.e. the first symbol of each RMTC occasion occurs at first symbol of an SFN and subframe of the NR SpCell meeting the following condition:","paragraph_zero_based":5594},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(rmtc-SubframeOffset/10);","paragraph_zero_based":5595},{"literal_text_all_w_t_and_m_t":"subframe = rmtc-SubframeOffset mod 10;","paragraph_zero_based":5596},{"literal_text_all_w_t_and_m_t":"with T = rmtc-Periodicity/10;","paragraph_zero_based":5597},{"literal_text_all_w_t_and_m_t":"On the frequency configured by rmtc-Frequency, the UE shall not consider RSSI measurements outside the configured RMTC occasion which lasts for measDurationSymbols for RSSI and channel occupancy measurements.","paragraph_zero_based":5598},{"literal_text_all_w_t_and_m_t":"The UE derives the RSSI measurement duration from a combination of measDurationSymbols and ref-SCS-CP. At least for RSSI measurement confined within the active DL BWP, the UE performs RSSI measurement using the numerology of the active DL BWP during the derived measurement duration. Otherwise, the numerology used by the UE for measurements is up to UE implementation. If configured, the UE performs RSSI measurements on a bandwidth in accordance with the received rmtc-Bandwidth. If configured, the UE performs RSSI measurements according to the TCI state configured by tci-StateId in the reference BWP configured by ref-BWPId of the reference serving cell configured by ref-ServCellId (see TS 38.133 [14], clause 9.2A.7 and clause 9.3A.8).If the UE has no serving cell in FR2-2 and configured with inter-frequency RSSI measurement in FR2-2, it is up to the UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":5599},{"literal_text_all_w_t_and_m_t":"5.5.2.11Measurement gap sharing configuration","paragraph_zero_based":5600},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5601},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR1 is set to setup:","paragraph_zero_based":5602},{"literal_text_all_w_t_and_m_t":"2>if an FR1 measurement gap sharing configuration configured by gapSharingFR1 is already setup:","paragraph_zero_based":5603},{"literal_text_all_w_t_and_m_t":"3>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":5604},{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR1 as defined in TS 38.133 [14];","paragraph_zero_based":5605},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR1 is set to release:","paragraph_zero_based":5606},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap sharing configuration configured by gapSharingFR1;","paragraph_zero_based":5607},{"literal_text_all_w_t_and_m_t":"1>if gapSharingFR2 is set to setup:","paragraph_zero_based":5608},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap sharing configuration configured by gapSharingFR2 is already setup:","paragraph_zero_based":5609},{"literal_text_all_w_t_and_m_t":"3>release the FR2 measurement gap sharing configuration configured by gapSharingFR2;","paragraph_zero_based":5610},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingFR2 as defined in TS 38.133 [14];","paragraph_zero_based":5611},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingFR2 is set to release:","paragraph_zero_based":5612},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap sharing configuration configured by gapSharingFR2.","paragraph_zero_based":5613},{"literal_text_all_w_t_and_m_t":"1>if gapSharingUE is set to setup:","paragraph_zero_based":5614},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap sharing configuration configured by gapSharingUE is already setup:","paragraph_zero_based":5615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a4a28fa033a57149bf4c2329c5f2d2e3d828823b6f74971dfc54d12c1eae1642","1ae55fb6c003ff88e619d55b7141b81b00444668eafe08776df0f03663b787f3","1d3ed8e28fad5465d987769a8db1f39f6abba8fd92d4337e8d28f5ec36c56a70","92c3003a5e14defa8a557e30d36e1eb446786f6fc5ce7f90bc45dee538ac3897","7da67899d128b60903569ab69ad63691e956a0f76479d90f6dc1b0aff7b7fcae","62c1c9e35182bd8c4097dbc6d04bcc444365a783eb51fcf59eac94e10ef0d65c","67e162250c201bfdbe1788ca79cc5be34c290d4231acc94bf3da404128b845b9","efca05a230b357753d258143b186276228afb653aa6e16bb60713e38ebe127c3","382076146c5f292ecae9a2b9beac84a52f0796ccc6ffc005818925f851853e77","c12721946d8dc7e6e68bf6719604853f8a870e0d5cf3e8ff3b016f6e8b898459","66461332032ce4916504ff42626922016b89f576c44dab83a3a4b7b164fb828f","6a6e6486036bb8a15fac8fcdb80803976d4f75a47e93e4d25ae5ade5345be319","2e13c1fdb1e9bd37aff83cebd5a6009ee20cec64196b575d5a3a4cc659a6dc74","3e4680f73350769b390635ce116ac122bbfc3a311668ea05e93db2cfe854327b","07d54365f8d45b0ee1fbe4f07e3c4662f7ef05035852c504266ca951d2ac56eb","f7bcea88a03edc714cb5a92710c703d07f09050dded86dbc239333cebc8c81d1","460ba8e333a2228392fc0afba5368fc688a4448c8cc0ec28b966bdc91d61fb11","d9f1c54a4455211d408e3207cb6859a84ea42fe94109f2f62442e1e2250482aa","a92bc2ee703f01a3e3a4ef2d71708e6fab4fb5b5024f196c2106e9e8481cc79d","62dad846d3a7da21f2ed78bacc493f185104a6613aee84c7b282997e8358a84a","465e8c0082276fa2158bf690403020e383f17fdb305f3079bf17fb75f299febb","d1f5d60768d021e0ba9ba529961e34b758524a9c54dae8d445c4985938acaaad","ef06633e1f2cdccc52c01a15dcc8dcb5d070cf9211f7c40b474a385f2e7edb15","b856c23b53e9b95d4bfa59ee0e710c46c2f4836a1b9a364d230c4b2774a002e2"],"paragraph_range_zero_based":[5592,5615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5592"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release the per UE measurement gap sharing configuration configured by gapSharingUE;","paragraph_zero_based":5616},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap sharing configuration indicated by the measGapSharingConfig in accordance with the received gapSharingUE as defined in TS 38.133 [14];","paragraph_zero_based":5617},{"literal_text_all_w_t_and_m_t":"1>else if gapSharingUE is set to release:","paragraph_zero_based":5618},{"literal_text_all_w_t_and_m_t":"2>release the per UE measurement gap sharing configuration configured by gapSharingUE.","paragraph_zero_based":5619},{"literal_text_all_w_t_and_m_t":"5.5.2.12Effective measurement window configuration","paragraph_zero_based":5620},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5621},{"literal_text_all_w_t_and_m_t":"1>if effectiveMeasWindowConfig is set to setup:","paragraph_zero_based":5622},{"literal_text_all_w_t_and_m_t":"2>if an effective measurement window configuration is already setup:","paragraph_zero_based":5623},{"literal_text_all_w_t_and_m_t":"3>release the effective measurement window configuration;","paragraph_zero_based":5624},{"literal_text_all_w_t_and_m_t":"2>setup an effective measurement window configuration indicated by the effectiveMeasWindowConfig in accordance with the received windowOffsetPeriodicity (providing periodicity and offset for the following condition), i.e., the first subframe of each window occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5625},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(offset/10);","paragraph_zero_based":5626},{"literal_text_all_w_t_and_m_t":"subframe = offset mod 10;","paragraph_zero_based":5627},{"literal_text_all_w_t_and_m_t":"with T = periodicity/10;","paragraph_zero_based":5628},{"literal_text_all_w_t_and_m_t":"1>else if effectiveMeasWindowConfig is set to release:","paragraph_zero_based":5629},{"literal_text_all_w_t_and_m_t":"2>release the effective measurement window configuration;","paragraph_zero_based":5630},{"literal_text_all_w_t_and_m_t":"NOTE:The SFN and subframe of the PCell is used in the effective measurement window calculation.","paragraph_zero_based":5631},{"literal_text_all_w_t_and_m_t":"5.5.3Performing measurements","paragraph_zero_based":5632},{"literal_text_all_w_t_and_m_t":"5.5.3.1General","paragraph_zero_based":5633},{"literal_text_all_w_t_and_m_t":"An RRC_CONNECTED UE shall derive cell measurement results by measuring one or multiple beams associated per cell as configured by the network, as described in 5.5.3.3. For all cell measurement results, except for RSSI, and CLI measurement results in RRC_CONNECTED, the UE applies the layer 3 filtering as specified in 5.5.3.2, before using the measured results for evaluation of reporting criteria, measurement reporting or the criteria to trigger conditional reconfiguration execution. For cell measurements, the network can configure RSRP, RSRQ, SINR, RSCP or EcN0 as trigger quantity. For CLI measurements, the network can configure SRS-RSRP or CLI-RSSI as trigger quantity. For cell and beam measurements, reporting quantities can be any combination of quantities (i.e. only RSRP; only RSRQ; only SINR; RSRP and RSRQ; RSRP and SINR; RSRQ and SINR; RSRP, RSRQ and SINR; only RSCP; only EcN0; RSCP and EcN0), irrespective of the trigger quantity, and for CLI measurements, reporting quantities can be either SRS-RSRP or CLI-RSSI. For conditional reconfiguration execution, the network can configure up to 2 quantities, both using same RS type. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the CBR measurements. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the Rx-Tx time difference measurements. The UE does not apply the layer 3 filtering as specified in 5.5.3.2 to derive the altitude measurements.","paragraph_zero_based":5634},{"literal_text_all_w_t_and_m_t":"The network may also configure the UE to report measurement information per beam (which can either be measurement results per beam with respective beam identifier(s) or only beam identifier(s)), derived as described in 5.5.3.3a. If beam measurement information is configured to be included in measurement reports, the UE applies the layer 3 beam filtering as specified in 5.5.3.2. On the other hand, the exact L1 filtering of beam measurements used to derive cell measurement results is implementation dependent.","paragraph_zero_based":5635},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5636},{"literal_text_all_w_t_and_m_t":"1>whenever the UE has a measConfig, perform RSRP and RSRQ measurements for each serving cell for which servingCellMO is configured as follows:","paragraph_zero_based":5637},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to ssb and ssb-ConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":5638},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to ssb:","paragraph_zero_based":5639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["180a2b98b96c529a9d2de368ef7703e7a4929fd287b544c8512b90d0e3b72b1f","90cee40ded54a00bd02b54c744a6429a5602be6fd22ce723d78b0b3a56e5fc75","48090d42211ff1441e091982305691ffc2d05268d89228d7c2e5140d58028bc9","097dc47d203f87ed0ce248098886433be8a3ddd43d8ccdac9803ec652a5c5073","cfba799ee5d7d45ea59bc97f85f8f654852df410d3d7f331faa5bbf963499718","a079dd51b2908beec8552bb051ef24780ff0dd0ea6994b2b513859995ca72a20","370d39f0413c30d9dc0aef43d6bcf558429f32da2cbbfa673ad28097a4cfb727","902117c3da984fefbf0f22c8e17b8f1bc9134d1f5d8f83ab43780d3a20c78187","878425f472660cb7103446906a352057ade809a26a9d894daf49600722ab8a1d","e5052a9f8dd0fa37984a89d2e907f92e43922d097fb6dcbd21a8b9f07ee491d9","de5c715b1d9dfb58b062e8bad6a3b757a04a5dffaaeee3e2fd2927eb9fee6518","6e9ce7d64093da9302dec42e59c6290a5b0c609204b683b2fa2d492bb7fe5bf5","36b38ed7ec8ae886886fc5c6e16f6a4aaa01b1852b02010ca478c6bc72d86603","5a90c09be123d69325f49c8a107c60d51b2aa6843208ab191761af2091e15154","f73050386bafe81044fc81bf171c8aad936038c80b5426d38b02f749dc111dac","30513188b429ccb46ea3b8ce192dfab06170332bd13710281ca6baf55afb9fec","ef0cced7874584bcc00b676195fbb826f3bd7fcd9cc1373d7e00363c523510dc","193ee4a6c4bbab94aebacb4edb83a6971ae9fc06002e656067c9559481364757","f8c55d8c1c34020a8f190b08f5052860f71a62da7e9fd297f45c79498cc657a0","baa63d6c4f622d73b1aa20e565a445363ac20657d4b6bad0b2d2c018aafc3d62","b56cda74e44d14f124cfeb58f27ebd33037d98d84317f881e085c1c99532c6e8","413e9f8bcedf27918a0a6cda52e0e2d1070a23876259bba3d53f77843eccae1e","7393850eb4804ca94ac2c0264203ad7fc71afe379413217c94e0c33ceee2f85c","6127cfb1f530d1bda1df2364d870a9b3f9e244a93fe93a012820ecc17cff23b2"],"paragraph_range_zero_based":[5616,5639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5616"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":5640},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":5641},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains an rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the measObject indicated by the servingCellMO:","paragraph_zero_based":5642},{"literal_text_all_w_t_and_m_t":"3>if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport and contains an rsType set to csi-rs:","paragraph_zero_based":5643},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered RSRP and RSRQ per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":5644},{"literal_text_all_w_t_and_m_t":"3>derive serving cell measurement results based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":5645},{"literal_text_all_w_t_and_m_t":"1>for each serving cell for which servingCellMO is configured, if the reportConfig associated with at least one measId included in the measIdList within VarMeasConfig contains SINR as trigger quantity and/or reporting quantity:","paragraph_zero_based":5646},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to ssb and ssb-ConfigMobility is configured in the servingCellMO:","paragraph_zero_based":5647},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5648},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on SS/PBCH block, as described in 5.5.3.3a;","paragraph_zero_based":5649},{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on SS/PBCH block, as described in 5.5.3.3;","paragraph_zero_based":5650},{"literal_text_all_w_t_and_m_t":"2>if the reportConfig contains rsType set to csi-rs and CSI-RS-ResourceConfigMobility is configured in the servingCellMO:","paragraph_zero_based":5651},{"literal_text_all_w_t_and_m_t":"3>if the reportConfigcontains a reportQuantityRS-Indexes and maxNrofRS-IndexesToReport:","paragraph_zero_based":5652},{"literal_text_all_w_t_and_m_t":"4>derive layer 3 filtered SINR per beam for the serving cell based on CSI-RS, as described in 5.5.3.3a;","paragraph_zero_based":5653},{"literal_text_all_w_t_and_m_t":"3>derive serving cell SINR based on CSI-RS, as described in 5.5.3.3;","paragraph_zero_based":5654},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":5655},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportCGI and timer T321 is running:","paragraph_zero_based":5656},{"literal_text_all_w_t_and_m_t":"3>if useAutonomousGaps is configured for the associated reportConfig:","paragraph_zero_based":5657},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using autonomous gaps as necessary;","paragraph_zero_based":5658},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5659},{"literal_text_all_w_t_and_m_t":"4>perform the corresponding measurements on the frequency and RAT indicated in the associated measObject using available idle periods;","paragraph_zero_based":5660},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field for the associated measObject is an NR cell and that indicated cell is broadcasting SIB1 (see TS 38.213 [13], clause 13):","paragraph_zero_based":5661},{"literal_text_all_w_t_and_m_t":"4>try to acquire SIB1 in the concerned cell;","paragraph_zero_based":5662},{"literal_text_all_w_t_and_m_t":"3>if the cell indicated by reportCGI field is an E-UTRA cell:","paragraph_zero_based":5663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d0cdaf21f3da923acdd385e6b33a6c09b74d0904010945a2d6874217a0807b45","17676ace37b9a16c4b942aeb05e4ab4bc4698228eeef4efe67d923a5a38d6e1b","20ce44538f06a0501dcfb8dd76fde7722ef9711f0395683af17e6836c2233b9a","2186ae73d8389cb4e3588db0376a6b467333402c4d102b7e0b0bb7646ee1ccf8","3bd07534e75e95b60d806af1bc1dd46fc5e979c32d87deecdafd6f1b842f682a","7c64aeebdbdc2437242edff3a32c88ec34b19299bde0848eb08904e08d2e73cc","6aac5f3c383b93e54e8e428133e29cb16e0f3b419035cd307cee8b81ea235652","7342b510c0a07c4c36165f29eb2d58e387903bc4b0f52b44c5d30ee8ef93aa77","830912074ea26f1180d1e1301f0ceb45d0be4bb2004f6054c27f831f9eea6ee2","331ef9f9713a410e399c4bd1605b73a638ea1a66588bb94032280eb03767068c","c52514afa013af9bcc8264ccc2b097c7ff23e5cbd53d8edf5ea07f406d3464b7","ecf230585b03b1dd793e07550c9f1a18191d19340a2b1bbfee1e8ed7f74efd86","155a2ddd9b948ebe0e52e648f6d257fafd0146fea308d5d89d06ac12ec4bdb89","de05c2ef3ba04edbedfc7da7aa10824508d4ccbe45597b637f2e0440da1cf2a9","07c155cc0ebdc4135bf57184cd3b3523b22c6fbec2807451feb1efe3c48ff026","26890094284842e851a6f7dea8a79594a985f16fd02ba588ff548626b4ccecf2","a19cbe596fd6050cc1ffd0dca9f1af08e38721397d50b1ce898aa34bf0dbfa9f","e7162aef294f814891b0e47634c63b78bc5b2d1eccedd512b2b3c3248ef168b7","8fe26455513a1f8d0d81ccb14fc05e6ccfd11a0952e8afeb438ca87e172c2c49","e3fa2dc99a2c585f8e7b969228ec35e0b5b73218cd294bea797270fc7ec77d85","5b9278ea0e8b67eead39eac36057e5b901539b9116b738ad79ff37156746790d","cfeb1b9ef6df8ec7f5416388e5f9d719be0a8d016b4b309a77876123cac36918","5493c5c454e833e971eed01c8045dd00b54c0bae1f4a5fa89deda98e27f0a877","25fc10a493baec088916974a35c8f1f3aac3d7412a86194f357c04bf92c3e4e4"],"paragraph_range_zero_based":[5640,5663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5640"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>try to acquire SystemInformationBlockType1 in the concerned cell;","paragraph_zero_based":5664},{"literal_text_all_w_t_and_m_t":"2>if the ul-DelayValueConfig is configured for the associated reportConfig:","paragraph_zero_based":5665},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":5666},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding average UL PDCP packet delay measurement per DRB;","paragraph_zero_based":5667},{"literal_text_all_w_t_and_m_t":"2>if the ul-ExcessDelayConfig is configured for the associated reportConfig:","paragraph_zero_based":5668},{"literal_text_all_w_t_and_m_t":"3>ignore the measObject;","paragraph_zero_based":5669},{"literal_text_all_w_t_and_m_t":"3>for each of the configured DRBs, configure the PDCP layer to perform corresponding UL PDCP Excess Packet Delay delay measurement according to the configured threshold per DRB;","paragraph_zero_based":5670},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is periodical, eventTriggered; or","paragraph_zero_based":5671},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the MCG VarMeasConfig and is indicated in the condExecutionCond or in the condExecutionCondPSCell associated to a condReconfigId in the MCG VarConditionalReconfig (for CHO, CPA, MN-initiated inter-SN CPC, or subsequent CPAC in NR-DC); or","paragraph_zero_based":5672},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCond associated to a condReconfigId in the SCG VarConditionalReconfig (for intra-SN CPC or subsequent CPAC); or","paragraph_zero_based":5673},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the condExecutionCondSCG associated to a condReconfigId in the MCG VarConditionalReconfig (for SN-initiated inter-SN CPC or subsequent CPAC in NR-DC); or","paragraph_zero_based":5674},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is condTriggerConfig, the measId is within the SCG VarMeasConfig and is indicated in the triggerConditionSN associated to a condReconfigurationId in VarConditionalReconfiguration as specified in TS 36.331 [10] (for SN-initiated inter-SN CPC in EN-DC):","paragraph_zero_based":5675},{"literal_text_all_w_t_and_m_t":"3>if a measurement gap configuration is setup, or","paragraph_zero_based":5676},{"literal_text_all_w_t_and_m_t":"3>if the UE does not require measurement gaps to perform the concerned measurements:","paragraph_zero_based":5677},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is not configured, or","paragraph_zero_based":5678},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to ssb-RSRP and the NR SpCell RSRP based on SS/PBCH block, after layer 3 filtering, is lower than ssb-RSRP, or","paragraph_zero_based":5679},{"literal_text_all_w_t_and_m_t":"4>if s-MeasureConfig is set to csi-RSRP and the NR SpCell RSRP based on CSI-RS, after layer 3 filtering, is lower than csi-RSRP:","paragraph_zero_based":5680},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to csi-rs:","paragraph_zero_based":5681},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":5682},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 filtered beam measurements only based on CSI-RS for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":5683},{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on CSI-RS for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":5684},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to NR and the rsType is set to ssb:","paragraph_zero_based":5685},{"literal_text_all_w_t_and_m_t":"6>if reportQuantityRS-Indexes and maxNrofRS-IndexesToReport for the associated reportConfig are configured:","paragraph_zero_based":5686},{"literal_text_all_w_t_and_m_t":"7>derive layer 3 beam measurements only based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in 5.5.3.3a;","paragraph_zero_based":5687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cd0e0717194db8b163532089238d8da1a69a2ed1081fe46c9578468b7c3842a4","20ecdfc3f585ec1c880cbc5bff5e870010c10fb2006d5c20d9d5b7733fec1a14","ff2a7b84b2e4778cab6fb49c3f3118a32a44c9de2799c8e29eb6ac5253222f4b","d62fa94666b6a76a54f996bf0e848e869defd1b07be616ab50f51ee65f8caa9b","6d5de45ef3461f122fadfeb268f570ebe6a20436206b641fa4e0b83d3d26d218","bcd881fa1b7b70ee8857aa10dc6f48498638614bcec6e527e7bd3f8461b544c9","ff86a2f6485e0970a92525e2f4dd697e38ea956cac53afa3fd0931fc273a88d7","dcfd369bc26f867fd652e189b22e32aacea575891ddce139a580202b8c266495","ee3926c659f607d2976829691fd878b86357063eb081b3584879676f853a76d9","37f4065a56eec5eb84e4913af321dbc6b9e23d19085298a4670347a0ceeb67be","cf4ddd9ce500891d12d2cb61917d42ba50e9f60acd331a9791d81e29ff14966e","c30ba16edcd690233c743a4c3795dfc74cb6ef198ce4b09484cc358bf730bbb5","93baa1a626a80d72a66d90b27465135c2ac2a9c82f5184040719b6dbec561e95","66df3a881fa3e91d8ad47a7521d38a83e63987adc15c8258ea7b293626101656","c023c843826da66f27130bb6946d128942b5229abb67261642174d475275903b","d89a167e8cbaadf2cec22f87f1fe17296b9dc8393701ac0e8e23a99a0bc45250","b35f2ceb1f2ffc8a51bd31004f69cd7ba9997b988c1752be60b971d9c6dd5338","790dfb442d3d6a88497b25ed70bba35bc6b9bd6f6ae0d87fb5fb670b053902ad","bf2a46758bd94044ccc5d01a139c2adc1e569ae3f6943921cba0786e7d2d6f76","0f177c12a4c9525fafc10985c779fd7a81046700a3572f0de6610ba6d22228ae","6420634ca5c6e42f6454f3ea352aad6d729c27feaf8a2de36a8cc19c0a56a0c6","78191ea9dd619015bce97c8542fac8cef30cb9f7688d07a314a8047cd8339525","c5d96db91daebb07c79c5f968811ace25df50bedbb66ee207e35cfe9ad583971","91c8ce4e6a973bffd87e5060f09aeee47744e75721112fe45b9c3408933b700b"],"paragraph_range_zero_based":[5664,5687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5664"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>derive cell measurement results based on SS/PBCH block for the trigger quantity and each measurement quantity indicated in reportQuantityCell using parameters from the associated measObject, as described in 5.5.3.3;","paragraph_zero_based":5688},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to E-UTRA:","paragraph_zero_based":5689},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":5690},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to UTRA-FDD:","paragraph_zero_based":5691},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to neighbouring cells on the frequencies indicated in the concerned measObject, as described in 5.5.3.2;","paragraph_zero_based":5692},{"literal_text_all_w_t_and_m_t":"5>if the measObject is associated to L2 U2N Relay UE:","paragraph_zero_based":5693},{"literal_text_all_w_t_and_m_t":"6>perform the corresponding measurements associated to candidate Relay UEs on the frequencies indicated in the concerned measObject, as described in 5.5.3.4;","paragraph_zero_based":5694},{"literal_text_all_w_t_and_m_t":"4>if the measRSSI-ReportConfig is configured in the associated reportConfig:","paragraph_zero_based":5695},{"literal_text_all_w_t_and_m_t":"5>perform the RSSI and channel occupancy measurements on the frequency configured by rmtc-Frequency in the associated measObject;","paragraph_zero_based":5696},{"literal_text_all_w_t_and_m_t":"NOTE 0:The network avoids configuring UEs supporting only CHO and/or Rel-16 CPC with measurements not referred to by any execution condition.","paragraph_zero_based":5697},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is set to reportSFTD and the numberOfReportsSent as defined within the VarMeasReportList for this measId is less than one:","paragraph_zero_based":5698},{"literal_text_all_w_t_and_m_t":"3>if the reportSFTD-Meas is set to true:","paragraph_zero_based":5699},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to E-UTRA:","paragraph_zero_based":5700},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the E-UTRA PSCell;","paragraph_zero_based":5701},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":5702},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the E-UTRA PSCell;","paragraph_zero_based":5703},{"literal_text_all_w_t_and_m_t":"4>else if the measObject is associated to NR:","paragraph_zero_based":5704},{"literal_text_all_w_t_and_m_t":"5>perform SFTD measurements between the PCell and the NR PSCell;","paragraph_zero_based":5705},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true;","paragraph_zero_based":5706},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements for the NR PSCell based on SSB;","paragraph_zero_based":5707},{"literal_text_all_w_t_and_m_t":"3>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":5708},{"literal_text_all_w_t_and_m_t":"4>if the measObject is associated to NR:","paragraph_zero_based":5709},{"literal_text_all_w_t_and_m_t":"5>if the drx-SFTD-NeighMeas is included:","paragraph_zero_based":5710},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject using available idle periods;","paragraph_zero_based":5711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["07506701402e6cfcbc59c0e7ef2428f40a92895a1b6b24a5777130a48037c619","00470188c1e1cff6ff0bee0c79806d307d25f54371e9e09b48caf83f2463592e","0e6dee8eb8e8cbe2ebf13987211cffb13aa7e803ed7bce0a8d96cb5b3484f129","bdd7e5366ca5594b1533b66ac2cadabb2069b913d9d355746221b4770320279a","23d4271b61b763540e6dab78f409ec2997346ebe3927cc0cec38b7b4aee41ce9","0f23fc2af3d69c614826ed70a8c29fa900eb424c6635c19a542988d0056d6f67","7f57d463251fd7e50e30b261d9df8c384806bd90984adb474dab5dec32025796","827af76acdd127b8cf23b06f87886d6a2f0d7d299a58b38cd5a6b7393faa6206","a7c71205b0f335442586d21870ecad03997e95f3558f2076ab6d331c23af3db5","41e461833318d9a76728cb2d6a22817064c18f325cb76abf200e86e49dfa99a2","5dd480aa2a7e9464fad7e0e739a5754669c318acc6a965813fd5f407c5037527","df2e7f279a1125bf5f57769801ad51fe8e269d9584969add373ddf685bcd5bbe","05c4f968ebb61e828b328c7eb2fd6a89b1b989b13f92856c6e8800dd5f2abf6b","01f8138a1445f4310229b2c0c66ba605e72c1081e325e6d5770af4d08a86bfec","31160bd1e3a673185f3c303a58ae92cb1ba7cd661a2bb717b88d133d8fdb400b","04b619dcb0d3b08328056bf0501262a8005da96789701c85dee623499f9375be","08a9d13347042e82dd168e649c2fef5f425baeab78df5201f4e01a5af6e7714e","e079114af1b594f6a64f5a9a043e65709c6a65c3f7668f12d67fe7b949912917","a6d6de7eefc0b1d926b8305672ea4a17e572067fb6c9700533936469f5827bff","94d39308d759a7cf78bbf3c6cc9a83aa38d8984045677f98bacec12140e774f5","1dcfe4be140fef500360116565d2f12c67a0b7c648ec4a87145877258d26fc46","8eeb428e6134e70694a39f95270724fd0882f52f78b73e9942e5f3dc93ac1da8","adfc1fa00bf7a743f52374ef33082a7b64e45da7f004754e139d5cd19c3dede9","5f464f5a8de3651223912cb06983d3d6f1d14fa27ad363dbe2ed781d0fb26aa4"],"paragraph_range_zero_based":[5688,5711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5688"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5712},{"literal_text_all_w_t_and_m_t":"6>perform SFTD measurements between the PCell and the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":5713},{"literal_text_all_w_t_and_m_t":"5>if the reportRSRP is set to true:","paragraph_zero_based":5714},{"literal_text_all_w_t_and_m_t":"6>perform RSRP measurements based on SSB for the NR neighbouring cell(s) detected based on parameters in the associated measObject;","paragraph_zero_based":5715},{"literal_text_all_w_t_and_m_t":"2>if the reportType for the associated reportConfig is cli-Periodical or cli-EventTriggered:","paragraph_zero_based":5716},{"literal_text_all_w_t_and_m_t":"3>perform the corresponding measurements associated to CLI measurement resources indicated in the concerned measObjectCLI;","paragraph_zero_based":5717},{"literal_text_all_w_t_and_m_t":"2>perform the evaluation of reporting criteria as specified in 5.5.4, except if reportConfig is condTriggerConfig.","paragraph_zero_based":5718},{"literal_text_all_w_t_and_m_t":"The UE acting as a L2 U2N Remote UE whenever configured with measConfig shall:","paragraph_zero_based":5719},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding measurements associated to the serving L2 U2N Relay UE, as described in 5.5.3.4;","paragraph_zero_based":5720},{"literal_text_all_w_t_and_m_t":"NOTE 1:The evaluation of conditional reconfiguration execution criteria is specified in 5.3.5.13.","paragraph_zero_based":5721},{"literal_text_all_w_t_and_m_t":"The UE capable of Rx-Tx time difference measurement when configured with measObjectRxTxDiff shall:","paragraph_zero_based":5722},{"literal_text_all_w_t_and_m_t":"1>perform the corresponding Rx-Tx time difference measurements associated with downlink reference signals indicated in the concerned measObjectRxTxDiff.","paragraph_zero_based":5723},{"literal_text_all_w_t_and_m_t":"The UE capable of CBR measurement when configured to transmit NR sidelink communication/discovery/positioning shall:","paragraph_zero_based":5724},{"literal_text_all_w_t_and_m_t":"1>If the frequency used for NR sidelink communication/discovery/positioning is included in sl-FreqInfoToAddModList/sl-FreqInfoToAddModListExt in sl-ConfigDedicatedNR within RRCReconfiguration message or included in sl-ConfigCommonNR within SIB12 or included in sl-PosConfigCommonNR within SIB23:","paragraph_zero_based":5725},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_IDLE or in RRC_INACTIVE:","paragraph_zero_based":5726},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":5727},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not include sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":5728},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":5729},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":5730},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":5731},{"literal_text_all_w_t_and_m_t":"3>if configured with NR sidelink positioning and the cell chosen for NR sidelink positioning provides SIB23 which includes sl-PRS-TxPoolSelectedNormal or sl-PRS-TxPoolExceptional for the concerned frequency, or provides SIB12 which includes sl-TxPoolSelectedNormal, sl-TxPoolExceptional:","paragraph_zero_based":5732},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-PRS-TxPoolSelectedNormal, sl-PRS-TxPoolExceptional, sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency;","paragraph_zero_based":5733},{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_CONNECTED:","paragraph_zero_based":5734},{"literal_text_all_w_t_and_m_t":"3>if tx-PoolMeasToAddModList is included in VarMeasConfig:","paragraph_zero_based":5735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1a79b1ae3d62c4ea27ab6b04f6a7f529bcf31f14ccbab7dce6c761519376aa23","8ec5908baf61ef353ebea2556421c94ce82a6280e8102e6e59a1b68aea22d650","f999a2365916fc1856a492238a4c544b777ae56a869d236beda9e827f463541e","5f5ab2fca19a5df584c036a3c3ca5f431633fc739b13261fb0a87c66719d01d5","99562a668e9e5aed6aaf93e86fc395fc812c6a1a4b31a0baa29f4a445c51bfd4","7c56be37bbeb9868f4145b59e713e42e6bf29f326f4e1914e03d5610d3c1abdf","f718736315616d1ab6e3bf9ce702a1c20f4004214e69e5bae580d37ac1cde4b0","7328232cbe558fb7648af3973cf62fa09c691118d475edc78c921300a210be92","1593a887eddaf12d6295b756b9dcdd1e75f714e4c019e7b0985ac80274533676","5fc0ec31ff8dd29c2a8fb50f0afc94590166fdccc2d7a471ff3830ff626c2e9b","0a1aaa9287a3ae6e25a1e15c49ca81b5044bf7d4e0406f94bb93f1e07cc2dce5","f6a635c7cfd09459477f1f48d1375bb9cf1a73ac299132798a9cadcc19b79c07","73f390d87b71b1a7a2878e2da2eeed9d41187570e4e22b680f2504af19aaec52","9475925787b3b4d627015f3385a0b44d6b232ebdc2bebe01c69e28edd4939e17","e0606faa1cc28df95df377d00566824d1e0d50fe6dc1df9e8165e0705fc95b44","fc48a9bd25b69bd455399eaf441118c0ffb12549c60cc605f9be86fcd57b5650","c53b0d991084a8d73da1bab51706845c022faa0b27e527df04865a553c0d211b","b0eb079c02e7bdae31c08ec3698a5ef016ffdafc7f62bad0d79d3aad80b7ea6d","0286f0e30ba54ec79d98859e3bdb26c7df6a2129630d95c1e25459c315d2a973","c5cd3b3e2d49d9e0a8dc21ee64f59bd3ce92ab81542369f386ebc44681eedb08","8a024a571f375f01cb894c6222c6014a0084f5c348328cac876bbdbbe2bdb850","3edafd191a92709e38bab12bce7c742c6f0b757ebc684af7a8d7ee12b0ae304d","dc095b6a2f11b034f9211ba4a8e418e9b011ab78da10fbc0ac107278ac2cf05a","32fd87c4969b5cedf6b49439b8c7018840a814911f5a4d2bd6c4e63c4c512ebc"],"paragraph_range_zero_based":[5712,5735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5712"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>perform CBR measurements on each transmission resource pool indicated in the tx-PoolMeasToAddModList;","paragraph_zero_based":5736},{"literal_text_all_w_t_and_m_t":"3>if sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling, sl-TxPoolExceptional, sl-PRS-TxPoolSelectedNormal, sl-PRS-TxPoolScheduling or sl-PRS-TxPoolExceptional is included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration:","paragraph_zero_based":5737},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on pool(s) in sl-DiscTxPoolSelected, sl-TxPoolSelectedNormal, sl-TxPoolScheduling, sl-TxPoolExceptional, sl-PRS-TxPoolSelectedNormal, sl-PRS-TxPoolScheduling and sl-PRS-TxPoolExceptional if included in sl-ConfigDedicatedNR for the concerned frequency within RRCReconfiguration;","paragraph_zero_based":5738},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5739},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink communication and the cell chosen for NR sidelink communication provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency; or","paragraph_zero_based":5740},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-TxPoolSelectedNormal or sl-TxPoolExceptional but does not provide sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":5741},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":5742},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink discovery and the cell chosen for NR sidelink discovery provides SIB12 which includes sl-DiscTxPoolSelected for the concerned frequency:","paragraph_zero_based":5743},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pools in sl-DiscTxPoolSelected and sl-TxPoolExceptional for the concerned frequency in SIB12;","paragraph_zero_based":5744},{"literal_text_all_w_t_and_m_t":"4>if configured with NR sidelink positioning and the cell chosen for NR sidelink positioning provides SIB23 which includes sl-PRS-TxPoolSelectedNormal or sl-PRS-TxPoolExceptional, or provides SIB12 which includes sl-TxPoolSelectedNormal, sl-TxPoolExceptional for the concerned frequency:","paragraph_zero_based":5745},{"literal_text_all_w_t_and_m_t":"5>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal, sl-TxPoolExceptional, sl-PRS-TxPoolSelectedNormal or sl-PRS-TxPoolExceptional for the concerned frequency;","paragraph_zero_based":5746},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5747},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink communication and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR for the concerned frequency; or","paragraph_zero_based":5748},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-TxPoolSelectedNormal is included in SidelinkPreconfigNR but sl-DiscTxPoolSelected is not included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":5749},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal in SidelinkPreconfigNR for the concerned frequency.","paragraph_zero_based":5750},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink discovery and sl-DiscTxPoolSelected is included in SidelinkPreconfigNR for the concerned frequency:","paragraph_zero_based":5751},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pools in sl-DiscTxPoolSelected if included in SidelinkPreconfigNR.","paragraph_zero_based":5752},{"literal_text_all_w_t_and_m_t":"2>if configured with NR sidelink positioning and sl-TxPoolSelectedNormal or sl-PRS-TxPoolSelectedNormal is included in SL-PreconfigurationNR for the concerned frequency:","paragraph_zero_based":5753},{"literal_text_all_w_t_and_m_t":"3>perform CBR measurement on pool(s) in sl-TxPoolSelectedNormal or sl-PRS-TxPoolSelectedNormal in SidelinkPreconfigNR for the concerned frequency.","paragraph_zero_based":5754},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the configurations for NR sidelink communication and CBR measurement are acquired via the E-UTRA, configurations for NR sidelink communication in SIB12, sl-ConfigDedicatedNR within RRCReconfiguration used in this clause are provided by the configurations in SystemInformationBlockType28, sl-ConfigDedicatedForNR within RRCConnectionReconfiguration as specified in TS 36.331[10], respectively.","paragraph_zero_based":5755},{"literal_text_all_w_t_and_m_t":"NOTE 3:If a UE that is configured by upper layers to transmit V2X sidelink communication is configured by NR with transmission resource pool(s) and the measurement objects concerning V2X sidelink communication (i.e. by sl-ConfigDedicatedEUTRA-Info), it shall perform CBR measurement as specified in clause 5.5.3 of TS 36.331 [10], based on the transmission resource pool(s) and the measurement object(s) concerning V2X sidelink communication configured by NR.","paragraph_zero_based":5756},{"literal_text_all_w_t_and_m_t":"NOTE 4:For V2X sidelink communication, each of the CBR measurement results is associated with a resource pool, as indicated by the poolReportId (see TS 36.331 [10]), that refers to a pool as included in sl-ConfigDedicatedEUTRA-Info or SIB13.","paragraph_zero_based":5757},{"literal_text_all_w_t_and_m_t":"5.5.3.2Layer 3 filtering","paragraph_zero_based":5758},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9f5689578e479dadbdd0e4456931b1fc5afcefc180ae42c4a54b0660376723ae","e606b39de7cb8db73577a1f285c661404c3dd033b469865c9d0bcbdf7c27de3f","3c8c9879e068f4bf2afb43c8807b2a39e2378669a58a4a3b42e95a6e1e21eaab","33ab8966a4587cedc1005d75d0ebaf83bb1f65f7e8a80235bbb90a4c0db4e342","4758b9a7b64b4f19fb8b7a9f74abbd9d91d721d245843f1baa576a143134d46a","63f91770cff24ff6a4a9e13d87df899dcce5e5620b0a4f98ee1c9742c7e7f260","883b7c0ac32211d5f521a59425badfa1252415a42805ae5f037e5d466142cee5","19670bce27464cc263965e7dad412168fb661185cdba9aedc98394e044d3aa9b","2870867bc25dc6c9cb33b8a7f7e10654f536e2e3d8ca12edd3640cad9abf029d","9e7140227327d9cfd174655b72633532d192c2af033b49935380b83ff1f94f39","99b84ef7dc9a13be2862b377191096ef56bae7a984400eee7dab53880dc3f163","996826ae185daba0b629bab235c6b336799384d2ea1514fd8d1f6de906eff5c5","8ceff3eb9db4692c9bd93b2450e8d0c2f7ea08e08d630db3131c7c04300a1813","fa4ae963bacfe3bad838e9daa88afe17e1d723c4453db3d539a53a1b85eae30d","7fe1cc6130e2129a0a641083861c747f8247b85501f4252fdb83027d55a54b29","0640a15d2c47d3273a54272c19a64cca9490a805fb61c465bfed855c1a80d4c8","c60a67be51ab01554d978eed2b16da54213b8c852ab32daa522a477b17be0eb2","b3546e6c6c19f8a1918e4f0df6a6dd16bb61ca5ceb31a265971a35bb96dd8907","98e0038c275f32426eebccb957e750a6f7bd7317d0784f9ac29d53136f10e619","f352f90561e09a3ecd695fff46ffbcca91d9ecfe35e316b7a0dcbea79d5db71d","8642f07c847cdb60a9ec6436b3730108b5c2fe2dfebac39dc5a80bb3427d2a9d","610bc6dca89d82ef9f329a1faf73167e78b300029932b6393152b546121c4436","5c7a1ad0743b613073531bc5cadc000e183afc448e83ae0b5207ff233d0e0e6d","842834e9166befb2c8f45732e76fa815a535d833180dd34580a303d5f0dc6250"],"paragraph_range_zero_based":[5736,5759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5736"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity, each beam measurement quantity, each sidelink measurement quantity as needed in clause 5.8.10, for each CLI measurement quantity that the UE performs measurements according to 5.5.3.1, for each candidate L2 U2N Relay UE measurement quantity according to 5.5.3.4, for evaluating the detected NR sidelink U2N Relay UEs according to 5.8.15.3, for evaluating the SyncRef UE according to 5.8.5 and 5.8.6, for evaluating the NR sidelink U2U Relay/Remote UE threshold conditions according to 5.8.16.2 and 5.8.17.2, for evaluating the conditions for selection and reselection of NR sidelink U2U Relay UE according to 5.8.17.3, and for evaluating the detected NR sidelink U2U Relay UEs according to 5.8.17.4:","paragraph_zero_based":5760},{"literal_text_all_w_t_and_m_t":"2>filter the measured result, before using for evaluation of reporting criteria, for measurement reporting, for U2N/U2U Relay (re)selection evaluation or for evaluating the SyncRef UE, by the following formula:","paragraph_zero_based":5761},{"literal_text_all_w_t_and_m_t":"Fn = (1 – a)*Fn-1 + a*Mn","paragraph_zero_based":5762},{"literal_text_all_w_t_and_m_t":"where","paragraph_zero_based":5763},{"literal_text_all_w_t_and_m_t":"Mn is the latest received measurement result from the physical layer;","paragraph_zero_based":5764},{"literal_text_all_w_t_and_m_t":"Fn is the updated filtered measurement result, that is used for evaluation of reporting criteria, for measurement reporting, for U2N/U2U Relay (re)selection evaluation or for evaluating the SyncRef UE;","paragraph_zero_based":5765},{"literal_text_all_w_t_and_m_t":"Fn-1 is the old filtered measurement result, where F0 is set to M1 when the first measurement result from the physical layer is received; and for MeasObjectNR, a = 1/2(ki/4), where ki is the filterCoefficient for the corresponding measurement quantity of the i:th QuantityConfigNR in quantityConfigNR-List, and i is indicated by quantityConfigIndex in MeasObjectNR; for other measurements, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by the quantityConfig; for UTRA-FDD, a = 1/2(k/4), where k is the filterCoefficient for the corresponding measurement quantity received by quantityConfigUTRA-FDD in the QuantityConfig;","paragraph_zero_based":5766},{"literal_text_all_w_t_and_m_t":"2>adapt the filter such that the time characteristics of the filter are preserved at different input rates, observing that the filterCoefficient k assumes a sample rate equal to X ms; The value of X is equivalent to one intra-frequency L1 measurement period as defined in TS 38.133 [14] assuming non-DRX operation, and depends on frequency range.","paragraph_zero_based":5767},{"literal_text_all_w_t_and_m_t":"NOTE 1:If k is set to 0, no layer 3 filtering is applicable.","paragraph_zero_based":5768},{"literal_text_all_w_t_and_m_t":"NOTE 2:The filtering is performed in the same domain as used for evaluation of reporting criteria, for measurement reporting, for U2N Relay (re)selection evaluation or for evaluating the SyncRef UE, i.e., logarithmic filtering for logarithmic measurements.","paragraph_zero_based":5769},{"literal_text_all_w_t_and_m_t":"NOTE 3:The filter input rate is implementation dependent, to fulfil the performance requirements set in TS 38.133 [14]. For further details about the physical layer measurements, see TS 38.133 [14].","paragraph_zero_based":5770},{"literal_text_all_w_t_and_m_t":"NOTE 4:For CLI-RSSI measurement, it is up to UE implementation whether to reset filtering upon BWP switch.","paragraph_zero_based":5771},{"literal_text_all_w_t_and_m_t":"NOTE 5:For SSB measurements when multiple altitude range-based ssb-ToMeasure are configured, it is up to UE implementation whether to reset filtering upon entering a different altitude range.","paragraph_zero_based":5772},{"literal_text_all_w_t_and_m_t":"5.5.3.3Derivation of cell measurement results","paragraph_zero_based":5773},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_CONNECTED to derive RSRP, RSRQ and SINR measurement results per cell associated to NR measurement objects based on parameters configured in the measObject (e.g. maximum number of beams to be averaged and beam consolidation thresholds) and in the reportConfig (rsType to be measured, SS/PBCH block or CSI-RS).","paragraph_zero_based":5774},{"literal_text_all_w_t_and_m_t":"The network may configure the UE in RRC_IDLE or in RRC_INACTIVE to derive RSRP and RSRQ measurement results per cell associated to NR carriers based on parameters configured in measIdleCarrierListNR within VarMeasIdleConfig for measurements performed according to 5.7.8.2a.","paragraph_zero_based":5775},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5776},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on SS/PBCH block:","paragraph_zero_based":5777},{"literal_text_all_w_t_and_m_t":"2>if nrofSS-BlocksToAverage is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":5778},{"literal_text_all_w_t_and_m_t":"2>if absThreshSS-BlocksConsolidation is not configured in the associated measObject in RRC_CONNECTED or in the associated entry in measIdleCarrierListNR within VarMeasIdleConfig in RRC_IDLE/RRC_INACTIVE; or","paragraph_zero_based":5779},{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshSS-BlocksConsolidation:","paragraph_zero_based":5780},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":5781},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5782},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on SS/PBCH block as the linear power scale average of the highest beam measurement quantity values above absThreshSS-BlocksConsolidation where the total number of averaged beams shall not exceed nrofSS-BlocksToAverage, and where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":5783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a7e41b2ce9ccbae4059fc216e9825759fca82ae56e9b54b0a8190e78e0dbb6aa","c3e2661ad50d8bd1df27d6202e733fa75f79f22122a5630ddd3eadede7cc65f6","3148ea95133e054c87d7d8d14a59e00ffcb5619614cff3e98bebd94295933cd8","26e2132df5bcd1bd2e74f45e9dd44a5ab6e4c4ae23f3fa1fd5ca65fed0292342","622b366f7df8900491cf9de73bcb8196e3260ba81a05544de2f9f944eac8b850","457b302635de6f7ac7542168c11db8d922e74b919d3644f401e0c8460c79252e","9b9e2acd93606be31397cdd1b1cbd85a118eb5d788614a0feb64c33ecf3b6c10","8d5a4c8f670cdd1a21dc2af5394865439d9f749a6239164ee1df62b91371bab2","8802e55521e7ea0bf2ed9c7959dda2e31e64d0ee483649f38c53048fa5f83a5a","6dcc940c22c585c1b54bb1e4f731e5e7f50ed440242ecf90b83c528c5be24f06","11c98826394743113a504a8414478cca36c629d4f7f65ef386011913570d471a","8b1957ac15a99e7bb24d1c4786d32e4115754b95328a86f890192eb9739e8413","c441f3592277c20ab891f4fea3240da1241d86446e99aad8900ff0c015bfa989","27eb00e0c20622fe17de59d403d565b17ecd4328d65e8b77e0703f7c780c7a6a","c8163685edc8afb35157a906a5fbbb50413b3514e39cdcaaa6d965e5f2dc4c04","af24cd3b2b99194533aae4a15282d1474e9115691e6825dcb8bc452af29ddbde","45e9be674d469d67fb49ff8d0a2f86ceac19ad8f9f31244cd45b11d76092c622","fa82c7c389384d5041fd124443bb3478e3aa79d6e944cba53df02a3abd6cbf53","89a8b665bde95266122566bf012ad1fbc09a86a977dc853adbc5c64d4e0c3760","32690673162c6053961b2713e3f884856cf62a99fe29e84f926305c41d14dd73","d307a93af611c17c83b90b6e30cab40e724d9ee08e936933d692303994e97683","aacfa06832ec4d86602272ea9175e7411efc87f5d43b9f5955432c29f285dba5","710510110714c097dd6a383ac0993e42b738da969b1bddc49ab91d4d36a16ba0","c6286fb95cf18a9d9c3c14ffebd37733f37b24ed4a2395bf6d07253b532c1572"],"paragraph_range_zero_based":[5760,5783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5760"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if in RRC_CONNECTED, apply layer 3 cell filtering as described in 5.5.3.2;","paragraph_zero_based":5784},{"literal_text_all_w_t_and_m_t":"1>for each cell measurement quantity to be derived based on CSI-RS:","paragraph_zero_based":5785},{"literal_text_all_w_t_and_m_t":"2>consider a CSI-RS resource to be applicable for deriving cell measurements when the concerned CSI-RS resource is included in the csi-rs-CellMobility including the physCellId of the cell in theCSI-RS-ResourceConfigMobility in the associated measObject;","paragraph_zero_based":5786},{"literal_text_all_w_t_and_m_t":"2>if nrofCSI-RS-ResourcesToAverage in the associated measObject is not configured; or","paragraph_zero_based":5787},{"literal_text_all_w_t_and_m_t":"2>if absThreshCSI-RS-Consolidation in the associated measObject is not configured; or","paragraph_zero_based":5788},{"literal_text_all_w_t_and_m_t":"2>if the highest beam measurement quantity value is below or equal to absThreshCSI-RS-Consolidation:","paragraph_zero_based":5789},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on applicable CSI-RS resources for the cell as the highest beam measurement quantity value, where each beam measurement quantity is described in TS 38.215 [9];","paragraph_zero_based":5790},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5791},{"literal_text_all_w_t_and_m_t":"3>derive each cell measurement quantity based on CSI-RS as the linear power scale average of the highest beam measurement quantity values above absThreshCSI-RS-Consolidation where the total number of averaged beams shall not exceed nrofCSI-RS-ResourcesToAverage;","paragraph_zero_based":5792},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 cell filtering as described in 5.5.3.2.","paragraph_zero_based":5793},{"literal_text_all_w_t_and_m_t":"5.5.3.3aDerivation of layer 3 beam filtered measurement","paragraph_zero_based":5794},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5795},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on SS/PBCH block;","paragraph_zero_based":5796},{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on SS/PBCH block as described in TS 38.215[9], and apply layer 3 beam filtering as described in 5.5.3.2;","paragraph_zero_based":5797},{"literal_text_all_w_t_and_m_t":"1>for each layer 3 beam filtered measurement quantity to be derived based on CSI-RS;","paragraph_zero_based":5798},{"literal_text_all_w_t_and_m_t":"2>derive each configured beam measurement quantity based on CSI-RS as described in TS 38.215 [9], and apply layer 3 beam filtering as described in 5.5.3.2.","paragraph_zero_based":5799},{"literal_text_all_w_t_and_m_t":"5.5.3.4Derivation of L2 U2N Relay UE measurement results","paragraph_zero_based":5800},{"literal_text_all_w_t_and_m_t":"A UE may be configured by network to derive NR sidelink measurement results of serving L2 U2N Relay UE or candidate L2 U2N Relay UEs associated to the measurement objects configured in the measObjectRelay.","paragraph_zero_based":5801},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5802},{"literal_text_all_w_t_and_m_t":"1>for each L2 U2N Relay UE measurement quantity to be derived:","paragraph_zero_based":5803},{"literal_text_all_w_t_and_m_t":"2>derive the corresponding measurement quantity based on PSSCH/PSCCH DMRS as described in TS 38.215 [9];","paragraph_zero_based":5804},{"literal_text_all_w_t_and_m_t":"2>apply layer 3 filtering as described in 5.5.3.2;","paragraph_zero_based":5805},{"literal_text_all_w_t_and_m_t":"5.5.4Measurement report triggering","paragraph_zero_based":5806},{"literal_text_all_w_t_and_m_t":"5.5.4.1General","paragraph_zero_based":5807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["239bf73f8716642f9263eb6bad2c1265f5db640a2bb11ba6133155e62860e2ba","ccf998d338cb9e0d53e6064ff1ec228326b0d445907d023fc32be79cdd593867","feb9172d5e82000a286da57f5ff8d3378d5028fb6764aaa97e3f3f487cc30536","0318a1d68a354f8a07cb3c8329c19cc98416e511dcb9863e95ac9f88eb8359c3","5448e6104fe7119c50c1ab7bbafe54a226fec73ae3be9b099a0135eda4739ced","35b50162c7799bbfa98149c065726150cd34245ee0494e0962ac70414c35122d","91c82e3ea1cdda7b8a3482bc987718a606a589a590e3a7a13b4e146003194e9b","5ec5fe66c0d0760f3116820916841da07b30e97303d57818b0fc50dbbb3d075c","31d585c39bbce5f74d2fcf465018f8595f3fba6548abde3297454bfb3102ccce","a5a7dc4b0558a69c9e5ab3459e87b48ac6e8bca4b4f0a3aab5a9b7e2410f342c","082e5024a4182e32d83c3d041f1f04020f1608a2f7b768e9a9ee46a29af1025c","b764dc7013589d59f52658b4b7e3cc2d86d5bc2fc21bd731fb7a643034e5ca08","020a7d1597fc285590b6d47bd128c4b959b8ecd1ad30555cdcb1c9b96b9563b8","d4d508cd69145bc263e9139f3918aa0775d1ffb722427d0b16aa0e1b636c6b83","dbcee14d959fbaa6602348496c8580467fe5aaf8400528b1207f511fd2ae27f6","fb47af94ad40ff8f054c1d90ed17585d723d5cbcdd4d17121cc09d4fc45f3177","e402d0bd205646f65fdde82c1ee7303a96d4a24f4f4fba08bc358f823ad7db9c","9432f42509fbad0ab414ea89448cd84586969982449e3a9455fc4a44a8c882bb","d3b8f2b613630fec8a6a98f1078755fb0d8c89a65fc770b17a09ddcc60a3152b","cc91c73f1cacd08992c4d7d047673f35784d71676c5b7d7d6efeceb49bbaa2ef","b483b81cfb9ada3f42a69529ce9070d1fa8d5bee78c86945d8ec4ae5ddd5b6c7","c6b3c9930bcae68589e6034c2086fb157d31841bb946477e8c421fd3148d30ea","b9eee746a8ac8f2866af6027c3d89387efaf0db7c68e6784970a6dadf52440a2","3de949047e545fac9873fb26eb40d8b4f97afcf2246c82618096d59c7be00a88"],"paragraph_range_zero_based":[5784,5807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5784"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If AS security has been activated successfully, the UE shall:","paragraph_zero_based":5808},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the measIdList within VarMeasConfig:","paragraph_zero_based":5809},{"literal_text_all_w_t_and_m_t":"2>if the corresponding reportConfig includes a reportType set to eventTriggered or periodical:","paragraph_zero_based":5810},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":5811},{"literal_text_all_w_t_and_m_t":"4>if the corresponding reportConfig includes measRSSI-ReportConfig:","paragraph_zero_based":5812},{"literal_text_all_w_t_and_m_t":"5>consider the resource indicated by the rmtc-Config on the associated frequency to be applicable;","paragraph_zero_based":5813},{"literal_text_all_w_t_and_m_t":"4>if the eventA1 or eventA2 is configured in the corresponding reportConfig:","paragraph_zero_based":5814},{"literal_text_all_w_t_and_m_t":"5>consider only the serving cell to be applicable;","paragraph_zero_based":5815},{"literal_text_all_w_t_and_m_t":"4>if the eventA3 or eventA5 or eventA3H1 or eventA3H2 or eventA5H1 or eventA5H2 is configured in the corresponding reportConfig:","paragraph_zero_based":5816},{"literal_text_all_w_t_and_m_t":"5>if a serving cell is associated with a measObjectNR and neighbours are associated with another measObjectNR, consider any serving cell associated with the other measObjectNR to be a neighbouring cell as well;","paragraph_zero_based":5817},{"literal_text_all_w_t_and_m_t":"4>if the eventX2 is configured in the corresponding reportConfig:","paragraph_zero_based":5818},{"literal_text_all_w_t_and_m_t":"5>consider only the serving L2 U2N Relay UE to be applicable;","paragraph_zero_based":5819},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical; or","paragraph_zero_based":5820},{"literal_text_all_w_t_and_m_t":"4>for measurement events other than eventA1, eventA2, eventD1, eventD2, eventX2, eventH1 or eventH2:","paragraph_zero_based":5821},{"literal_text_all_w_t_and_m_t":"5>if useAllowedCellList is set to true:","paragraph_zero_based":5822},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is included in the allowedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":5823},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5824},{"literal_text_all_w_t_and_m_t":"6>consider any neighbouring cell detected based on parameters in the associated measObjectNR to be applicable when the concerned cell is not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":5825},{"literal_text_all_w_t_and_m_t":"4>if the eventH1 or eventH2 is configured in the corresponding reportConfig:","paragraph_zero_based":5826},{"literal_text_all_w_t_and_m_t":"5>for all the events with the same eventID for which simulMultiTriggerSingleMeasReport is set to true and the entry condition applicable for the event has been satisfied:","paragraph_zero_based":5827},{"literal_text_all_w_t_and_m_t":"6>consider only the event for which the difference between the corresponding altitude threshold and the altitude of the UE is the smallest to be applicable;","paragraph_zero_based":5828},{"literal_text_all_w_t_and_m_t":"4>else if the eventA3H1 or eventA3H2 or eventA4H1 or eventA4H2 or eventA5H1 or eventA5H2 is configured in the corresponding reportConfig:","paragraph_zero_based":5829},{"literal_text_all_w_t_and_m_t":"5>for all the events with the same eventID associated with the same measObjectNR for which simulMultiTriggerSingleMeasReport is set to true and the entry conditions applicable for the event has been satisfied:","paragraph_zero_based":5830},{"literal_text_all_w_t_and_m_t":"6>consider only the event for which the difference between the corresponding altitude threshold and the altitude of the UE is the smallest to be applicable;","paragraph_zero_based":5831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e96d870d6ee33762dbd5e6bf0c7b646129cea10d93e498e12f88f98d6793e583","ebf40eab559d17dfeaf3ab0123f974eac6f521f9869406311e3e4488ba9307b3","99a863e3eb8f4d1957f5115d187e7ae9710448426b280a61a09ee2ba4953a209","9671afc060a047233086b99e910e9cdab6407fe7685e4a07cf5688839ffe9304","05ad754fb0bcfb6f1acec3dc39bec52f4b259ecc0f03097d8e81fef91a54cb80","47f621f57189e1996adafc3311ed8d78cb92d35c05e572675d44b1e6327bb8b6","2141548422e17742fd1289215284ae4b101fd256af3e490450560df2857fd387","115261e2961918e3c94506f7fb289eccb3c103e2450adeed356f2fda399d5b9c","e80077269544f444bc0ad353a70753826bf6ae0e980357a12de5e7c04f0878a2","d387b440d6af9b05b15a615ed9aecc208c2347a0e3950bcb232f27a05c6eb70a","2ff52961ffecbb9b6280a48b6557600462ac2ebea38e2eff23b0bcae661d7eff","69fe679900f2a77f8c81ea62186e023c42a853273a9f9fce9262496caaac4e91","d4434f8effbb95ae1f4b18c1532494f33ec1eec831b60af3eb085e0828e8f27f","31470b95f59686b1a183e0430af08eafe83442daa6a52a0a25e09e0123019a38","e8356e5e2ac74fd3266f30455e0d0df125a0808289df95fe8679088cced79885","fcb1fd9a5329fc31fdd3b5479f131d76b0aa5cef4765aab6fe0a2d3cd41f906b","cf65b7c5dcedd807f50ba97d5db225c572899fc906a6a3b9d667002f3e7384ad","ee71edb5199891a5ad0811f96404fb56fcd9afdcbeda7e1ec94fc0b382651a29","dede459ac0bf5b54f44e5e27db5b68af07904f00b937052ab0e169fece70b7da","9b582dfdc721a56305be9bc1cd849d50700f52d62cc3fedb3c98a26269a03ff3","afc5b2569107c10610059424cda65eb8b540372531646a8617b94b3f3270792c","3c6f95e80d504d0deba93d00a848e6c6db0a5ab0708b0e81d4d5f4763ddf0086","4f2b4d990628c48ea584f73a95a0f362291107dd582ad18134c7dab304247753","33a7f4455765dc7b666c9e7c37847edc5e8fff123af3c6e59e1683a671111850"],"paragraph_range_zero_based":[5808,5831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5808"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":5832},{"literal_text_all_w_t_and_m_t":"4>if eventB1 or eventB2 is configured in the corresponding reportConfig:","paragraph_zero_based":5833},{"literal_text_all_w_t_and_m_t":"5>consider a serving cell, if any, on the associated E-UTRA frequency as neighbour cell;","paragraph_zero_based":5834},{"literal_text_all_w_t_and_m_t":"4>consider any neighbouring cell detected on the associated frequency to be applicable when the concerned cell is not included in the excludedCellsToAddModListEUTRAN defined within the VarMeasConfig for this measId;","paragraph_zero_based":5835},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns UTRA-FDD:","paragraph_zero_based":5836},{"literal_text_all_w_t_and_m_t":"4>if eventB1-UTRA-FDD or eventB2-UTRA-FDD is configured in the corresponding reportConfig; or","paragraph_zero_based":5837},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":5838},{"literal_text_all_w_t_and_m_t":"5>consider a neighbouring cell on the associated frequency to be applicable when the concerned cell is included in the cellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":5839},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns L2 U2N Relay UE:","paragraph_zero_based":5840},{"literal_text_all_w_t_and_m_t":"4>if eventY1-Relay or eventY2-Relay or eventZ1-Relay is configured in the corresponding reportConfig; or","paragraph_zero_based":5841},{"literal_text_all_w_t_and_m_t":"4>if corresponding reportConfig includes reportType set to periodical:","paragraph_zero_based":5842},{"literal_text_all_w_t_and_m_t":"5>consider any L2 U2N Relay UE fulfilling upper layer criteria detected on the associated frequency to be applicable for this measId;","paragraph_zero_based":5843},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportCGI:","paragraph_zero_based":5844},{"literal_text_all_w_t_and_m_t":"3>consider the cell detected on the associated measObject which has a physical cell identity matching the value of the cellForWhichToReportCGI included in the corresponding reportConfig within the VarMeasConfig to be applicable;","paragraph_zero_based":5845},{"literal_text_all_w_t_and_m_t":"2>else if the corresponding reportConfig includes a reportType set to reportSFTD:","paragraph_zero_based":5846},{"literal_text_all_w_t_and_m_t":"3>if the corresponding measObject concerns NR:","paragraph_zero_based":5847},{"literal_text_all_w_t_and_m_t":"4>if the reportSFTD-Meas is set to true:","paragraph_zero_based":5848},{"literal_text_all_w_t_and_m_t":"5>consider the NR PSCell to be applicable;","paragraph_zero_based":5849},{"literal_text_all_w_t_and_m_t":"4>else if the reportSFTD-NeighMeas is included:","paragraph_zero_based":5850},{"literal_text_all_w_t_and_m_t":"5>if cellsForWhichToReportSFTD is configured in the corresponding reportConfig:","paragraph_zero_based":5851},{"literal_text_all_w_t_and_m_t":"6>consider any NR neighbouring cell detected on the associated measObjectNR which has a physical cell identity that is included in the cellsForWhichToReportSFTD to be applicable;","paragraph_zero_based":5852},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5853},{"literal_text_all_w_t_and_m_t":"6>consider up to 3 strongest NR neighbouring cells detected based on parameters in the associated measObjectNR to be applicable when the concerned cells are not included in the excludedCellsToAddModList defined within the VarMeasConfig for this measId;","paragraph_zero_based":5854},{"literal_text_all_w_t_and_m_t":"3>else if the corresponding measObject concerns E-UTRA:","paragraph_zero_based":5855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ee0f8b9b7f00c193bd865200e2977c4fee2d7d805f21950a2f23cb7da8464fad","22c59f619926154d3f56633dcf0b48ed63faca311e793a1729890a79d97c37a8","e248603a388a0e67aaf8429990058c2d837c4961169a27475ea7b4992782850a","2e2d61f0e0f430faf0e7fe324167bf68a0b654dbecc12ba56f808061f0d0c767","4d7fd08c546bcc98c5acd8e05333cdb49c7b93d036b973e111cc38ff0238d630","df03cddcba2be6739c7b269d4fa155859d63c107649d4e6c19ec5af83063ab4b","9c0e20a5b500ccdcd7e4ee5d0d8d6278367f4f60cda1811c6c71b5a8f80ad52d","99612308769259190ccd6acbc3348796516deb139e03661b00d2fd1865b3d565","fa0f2acf9ca0b0ad0fd97603f57d9b74fb419a8a76f63c09b861b1841d2ceb10","ceab0cb36c22db8e971d87cdecccf0e033d24614339b3b465401d5f0ccca55d1","6abeddfead777e701e8c6af7e5d104a01fd6a736b40da504a08ab3c5839bf6a2","331be9a2e61096cf67606d63670f2226d402034577591adf309d67561efd8da5","6ab011bd54391c569f3b6638fb8d144cfaeb4a42fb8dd26ee224250c0e14ef9b","be7aa2a9293f7bcf2a77635401ed7381204f0e18595db5b20919e891f1f3a63f","13302d52592b58f3f28da0fd95f208271a7650a0bf253bed4d9336d00c3d2226","6c105915a713abe85a1232a041a1cf58d965875f60eefe12b9363b5bc5af1f5d","5863e74abd11337a465aceffdbe49cddfa67e3e70323c4fd9c49e450c57d599f","de9dfbe66dc97581f576106d63eef8b892b2170fbdcda9e78536485028581dd3","177f2d2fb366c65ecaf445de3c95097e5a8752cc66fc696dbb30d64f995ad792","cbb59274277046a1f46f6bd7f4ea07b863d7872f4747ca17393973e072e3855e","efafc08a44350bdd2a4977daaefccb3aa43e67bda784d091d0680f121d63399a","592d6dcc5c4e55e39ad5237060b1f3e1d90d14dfc693c910f96727004bb68d3a","9b40236d50a02ce79465f439cbe966b92bd77c78cee802e987daf0afcf6c4864","d3347ff6c7150c87ced1e89fd2f199e4249d1c748f5accf067b3