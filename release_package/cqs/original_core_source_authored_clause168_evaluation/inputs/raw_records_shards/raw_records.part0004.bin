{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the alternative PUCCH cell for PUCCH cell switching) inside the DCI format 2-2 payload, for the primary PUCCH group and the secondary PUCCH group respectively.","paragraph_zero_based":29472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29473},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29474},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29475},{"literal_text_all_w_t_and_m_t":"PDCCH-OfSpcell","paragraph_zero_based":29476},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell. Otherwise, the field is absent, Need R.","paragraph_zero_based":29477},{"literal_text_all_w_t_and_m_t":"PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":29478},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the PUCCH-SCell.","paragraph_zero_based":29479},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is configured with a PUCCH SCell in this cell group and if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell.","paragraph_zero_based":29480},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent, Need R.","paragraph_zero_based":29481},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":29482},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise.","paragraph_zero_based":29483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29484},{"literal_text_all_w_t_and_m_t":"–PUSCH-Config","paragraph_zero_based":29485},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-Config is used to configure the UE specific PUSCH parameters applicable to a particular BWP.","paragraph_zero_based":29486},{"literal_text_all_w_t_and_m_t":"PUSCH-Config information element","paragraph_zero_based":29487},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29488},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-START","paragraph_zero_based":29489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29490},{"literal_text_all_w_t_and_m_t":"PUSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":29491},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPUSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":29492},{"literal_text_all_w_t_and_m_t":"    txConfig                                ENUMERATED {codebook, nonCodebook}                                  OPTIONAL,   -- Need S","paragraph_zero_based":29493},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeA        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":29494},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeB        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":29495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5268e2244506c26cf72c5fbb922f1adb1742680f53e2fde12c7a74cc30980d77","bb4c44c8da906203f170200e41f36719136b2e4c34236ae560d402d939f77fa4","432d3ea9eae2952cdd1faedf815cfc0f576a2ab976e23093f7bfe23f7fa480e3","806e01109b5e6315caaa2f3e