{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25368},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASWINDOWCONFIG-STOP","paragraph_zero_based":25369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25371},{"literal_text_all_w_t_and_m_t":"MeasWindowConfig field descriptions","paragraph_zero_based":25372},{"literal_text_all_w_t_and_m_t":"windowDuration","paragraph_zero_based":25373},{"literal_text_all_w_t_and_m_t":"Value windowDuration is the measurement window length in ms of effective measurement window. Value ms2 corresponds to 2 ms, value ms5 corresponds to 5 ms, and Value ms5dot5 corresponds to 5.5 ms.","paragraph_zero_based":25374},{"literal_text_all_w_t_and_m_t":"windowOffsetPeriodicity","paragraph_zero_based":25375},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity and offset of effective measurement window. The choice determines the periodicity (periodicityMs40 for 40ms and periodicityMs80 for 80 ms). The field value indicates the offset in ms.","paragraph_zero_based":25376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25377},{"literal_text_all_w_t_and_m_t":"–MobilityStateParameters","paragraph_zero_based":25378},{"literal_text_all_w_t_and_m_t":"The IE MobilityStateParameters contains parameters to determine UE mobility state.","paragraph_zero_based":25379},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters information element","paragraph_zero_based":25380},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25381},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYSTATEPARAMETERS-START","paragraph_zero_based":25382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25383},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters ::=         SEQUENCE{","paragraph_zero_b