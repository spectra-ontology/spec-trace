{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSBorAssociatedSSB","paragraph_zero_based":25080},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ssb-ConfigMobility is configured or associatedSSB is configured in at least one cell. Otherwise, it is absent, Need R.","paragraph_zero_based":25081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25082},{"literal_text_all_w_t_and_m_t":"–MeasObjectNR-SL","paragraph_zero_based":25083},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectNR-SL concerns a measurement object including a list of transmission resource pool(s) for which CBR measurement is performed for NR sidelink communication/discovery.","paragraph_zero_based":25084},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL information element","paragraph_zero_based":25085},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25086},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTNR-SL-START","paragraph_zero_based":25087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25088},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL-r16 ::=      SEQUENCE {","paragraph_zero_based":25089},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToRemoveList-r16  Tx-PoolMeasList-r16                           OPTIONAL,       -- Need N","paragraph_zero_based":25090},{"literal_text_all_w_t_and_m_t":"    tx-PoolMeasToAddModList-r16  Tx-PoolMeasList-r16                           OPTIONAL        -- Need N","paragraph_zero_based":25091},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25093},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL-r18 ::=      SEQUENCE {","paragraph_zero_based":25094},{"literal_text_all_w_t_and_m_t":"    sl-Frequency-r18             INTEGER (1..maxNrofFreqSL-r16),","paragraph_zero_base