{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":960},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":962},{"literal_text_all_w_t_and_m_t":"NR-RSCPD-AdditionalMeasurementSamplesElement-r18 ::= SEQUENCE {","paragraph_zero_based":963},{"literal_text_all_w_t_and_m_t":"nr-RSCPD-r18INTEGER (0..3599)OPTIONAL,","paragraph_zero_based":964},{"literal_text_all_w_t_and_m_t":"nr-PhaseQuality-r18NR-PhaseQuality-r18OPTIONAL,","paragraph_zero_based":965},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp-r18NR-TimeStamp-r16OPTIONAL,","paragraph_zero_based":966},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":967},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":969},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":971},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":972},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":973},{"literal_text_all_w_t_and_m_t":"UERxTEG","paragraph_zero_based":974},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OP, if the field nr-UE-Rx-TEG-ID is present; otherwise it is not present.","paragraph_zero_based":975},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":976},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-SignalMeasurementInformation field descriptions","paragraph_zero_based":977},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-TimingErrorMargin","paragraph_zero_based":978},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Rx TEG timing error margin value for all the UE Rx TEGs within one NR-DL-TDOA-SignalMeasurementInformation. If the nr-UE-Rx-TEG-ID is present and this field is absent, the receiver should consider the UE Rx TEG timing error margin value to be the maximum applicable value as defined in TS 38.133 [46].","paragraph_zero_based":979},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":980},{"literal_text_all_w_t_and_m_t":"This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resources ID to uniquely identify a DL-PRS Resource. This ID can be associated with multiple DL-PRS Resource Sets associated with a single TRP.","paragraph_zero_based":981},{"literal_text_all_w_t_and_m_t":"Each TRP should only be associated with one such ID.","paragraph_zero_based":982},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID","paragraph_zero_based":983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["6679847654e42e7b8d8092f701a94bb05c3040e3b5da4447bf63fef539340f01","808d79bf773aed102ecf406e488b4f80b866ed0ddd015a9b48557dde5d64da77","ead29934b92b9dca96bbfb26394604f691b5aa2697f3ecdb235d0a1d6d24a117","769a03314e9c09c8b7cefdc567b3acb4777de69419df47068aa89c412be5f951","d43ed5e93c9d9276741458a6f41e9e238b3d687f10598771e5d77f1f72acdef6","ad2ae0e7424bf493246bf16778319e7429713e845f9eddad476cc541afb9aef9","a2d691f2c92a9b1b02e76a02eaff80028ef6f0446cdcb6ea75ebb8ff8dea261c","1d5e2d3d8a8849209d653f5720b5837aa416a5dd5c51889fee6867b10c97a723","30333b57330c9a1e375ffbd0704c125ab1587c005981f7e6cf5bbc77ac15161e","4a68c8b7b4097b55625d117392f623953f4073984a0139f5bb1e25aa84fa80b3","ef6b654763411c2ee277658f3ecd473d263550d2c6bf41128b1e4269691ad7bc","1abf3921cf03f38de9b3ca180a97241efef900fc304a8c94ac414ec7f9267c64","5e605e0ae2474f13a1eec177614ba492db1bc5341b9035b40a39d8005cfb0a47","085f7b36e8a8d1451d0642803d4ae8ea824a6edf9d6b7fa36a27c76b8281267d","a56a42e2454b7b064254cedc6b6881b49e412adc7a04716abcbcc91b186fee50","99fba00d6d1d87371cc5d1736518b2d1380dd4c7efa3af480c8b64fc7aaca92f","02d330884754e3eda255303b0f09815fdd6fcb0a0d6c282a179573bccd716030","5271a53a7b3d5f822aca646a4065a07c5b178d0b77737881f3bbb639c1ccd5ad","a40fb5b2deb87931c5325b2bb8d0bd24a6e580ff4b103982e3eb82ef93e0e91e","88728af622fa6e47e6ade32422fc39731461bac6b4443f47327e4707b059b71e","d38243d28afa7d3db98b7d09b8d864bab45af7edcbd8f2ea7a67718e11b0eac8","348605536b8e3de978acd51110df3744180b93f01fd815058754a400ef698fd7","34d9d693c1e90e802e73ff83b1af92d5a350435d6907649aca457b8d4d7727d4","45d50627e7680ccdf19a0f5505f2772d8710f1b23c6911e15e33944f48541fac"],"paragraph_range_zero_based":[960,983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p960"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell identity of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":984},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID","paragraph_zero_based":985},{"literal_text_all_w_t_and_m_t":"This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP, as defined in TS 38.331 [35].","paragraph_zero_based":986},{"literal_text_all_w_t_and_m_t":"nr-ARFCN","paragraph_zero_based":987},{"literal_text_all_w_t_and_m_t":"This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":988},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":989},{"literal_text_all_w_t_and_m_t":"This field specifies the time instance at which the TOA, RSCP (if included) and DL PRS-RSRP/RSRPP (if included) measurement is performed. The nr-SFN, nr-Slot and nr-Symbol (if included) in IE NR-TimeStamp correspond to the TRP provided in dl-PRS-ReferenceInfo as specified in TS 38.214 [45]. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":990},{"literal_text_all_w_t_and_m_t":"nr-RSTD","paragraph_zero_based":991},{"literal_text_all_w_t_and_m_t":"This field specifies the relative timing difference between this neighbour TRP and the DL-PRS reference TRP, as defined in TS 38.215 [36].  Mapping of the measured quantity is defined as in TS 38.133 [46].","paragraph_zero_based":992},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathList","paragraph_zero_based":993},{"literal_text_all_w_t_and_m_t":"This field specifies one or more additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-RSTD value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathListExt shall be absent.","paragraph_zero_based":994},{"literal_text_all_w_t_and_m_t":"nr-TimingQuality","paragraph_zero_based":995},{"literal_text_all_w_t_and_m_t":"This field specifies the target device′s best estimate of the quality of the TOA measurement. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":996},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-Result","paragraph_zero_based":997},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-PRS reference signal received power (DL PRS-RSRP) measurement, as defined in TS 38.215 [36]. The mapping of the quantity is defined as in TS 38.133 [46].","paragraph_zero_based":998},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-AdditionalMeasurements","paragraph_zero_based":999},{"literal_text_all_w_t_and_m_t":"This field provides up to 3 additional RSTD measurements per pair of TRPs, with each measurement between a different pair of DL-PRS Resources or DL-PRS Resource Sets of the DL-PRS for those TRPs [45].","paragraph_zero_based":1000},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-DL-TDOA-AdditionalMeasurementsExt shall be absent.","paragraph_zero_based":1001},{"literal_text_all_w_t_and_m_t":"nr-UE-Rx-TEG-ID","paragraph_zero_based":1002},{"literal_text_all_w_t_and_m_t":"This field provides the ID of the UE Rx TEG associated with the TOA measurement. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff. When different UE Rx TEGs for RSTD measurements are requested, the maximum number of reported RSTD measurements associated with different DL-PRS Resources per UE Rx TEG per target TRP is 4.","paragraph_zero_based":1003},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-Result","paragraph_zero_based":1004},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time, as defined in TS 38.215 [36]. The mapping of the measured quantity is defined as in TS 38.133 [46].","paragraph_zero_based":1005},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-Indicator","paragraph_zero_based":1006},{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the TOA measurement for the TRP or resource. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["8dcab84802d407de264978350cbcd28ec6d8b0fb927abb354c315a316586893b","1f87d6e33decb6d323ec0b479d648d31c3bc4ba8b92bbf9c0540d4f5fd27631d","eb82d9f19fe315ed6a7479abc15fcc58d022e2a76e378c18d5d35faeecead9f0","87fb0a377e24f666eded41a96dd326482a97269c15ad358af82be5807990d4b7","d88c1d5e3f14c898ad05a47c96b9041dcd4d80401708e952e79f7ad4a8f122f1","d1aa80a2b8ce1ade4495cb525859b8dd34ca4eca14f2d9d2a6c52176ec20340f","d9be8d0c8890cfc1fe54e56e08806d449d07c1cf6cc1dcced329f5c38e20a972","f4bcc9bc5e62c7375164f79776560079b8f8165eb3547622c85398b8f14f43b5","d57360d8158e0bb8f485d1f9923b9d2d6dba60427126e1cfc40e85b4f6319be8","96ddda33dcf30bfdf75df9cf92709144b6fcf8411a2cb9955162b6171c4049f9","23e63e14ddc8d44271227131d4034623d6ea6408473b87f5177d256afbd67722","507be7b7752b3331b0daa9e7e9af2ece1adfcb54b911b467a3f6afeff96957b0","a36022eaa4eadd2daefdb422f11b436c99b787c9cf80b8df2259ec669b67ce97","4586f038020212f0755624a7c7b29d3c18a857290b9a3f1b2b20eae9bda69b51","d2f854c9736bdf8e0c65f35dc35cb4fe6ac94e419abdb885d3c00512edac3b52","d9bb6d30e8c52e8cc177beb315795a0d100d8d454d8dc6e13ef3f0b82b9a9ab4","5dc6de1be904c566b6e136ab3aa86b364e439614664633fa547cfa3d098061a3","5a4b3fd2feb48e3e0724f7f025c007e9a1b421748e62ecae58e0fafec85dbaac","97ebea994f9cc152ae95c13881a0c56d2196751a722ef64111f799e0c386d8f2","b6240f97d03be576e4e19a3b6f619e6d6a23419d977e69769d63480edf9e2128","e10419a05368c1483104cfce14d2493f0a29862ef385f9858d4b8cd8e15f9400","72be3e7ee70da43659f343628c34486918920ae05c3cca1595aa2eeb915b80b0","0671bebea87fef975ecfcc698b83ead7eb6d165709e7ff2c56dc02db57b7f36a","71d3e70e4028027fe4f9ed33f7a8fa89ef8268b0d918962b596691790326a5e8"],"paragraph_range_zero_based":[984,1007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p984"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field also applies to specify the target device's best estimate of the LOS or NLOS of the RSCP measurement for the TRP or resource. Note, the RSCP measurement refers to the RSCP of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSCPD.","paragraph_zero_based":1008},{"literal_text_all_w_t_and_m_t":"NOTE:If the requested type or granularity in nr-los-nlos-IndicatorRequest is not possible, the target device may provide a different type and granularity for the estimated LOS-NLOS-Indicator.","paragraph_zero_based":1009},{"literal_text_all_w_t_and_m_t":"nr-AdditionalPathListExt","paragraph_zero_based":1010},{"literal_text_all_w_t_and_m_t":"This field provides up to 8 additional detected path timing values for the TRP or resource, relative to the path timing used for determining the nr-RSTD value. If this field was requested but is not included, it means the UE did not detect any additional path timing values. If this field is present, the field nr-AdditionalPathList shall be absent.","paragraph_zero_based":1011},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-AdditionalMeasurementsExt","paragraph_zero_based":1012},{"literal_text_all_w_t_and_m_t":"This field, in addition to the measurements provided in NR-DL-TDOA-MeasElement, provides TOA measurements of up to 4 DL-PRS Resources of a TRP with different UE Rx TEGs. For a certain DL-PRS Resource, there can be up to 8 TOA measurement results with respect to different Rx TEGs.","paragraph_zero_based":1013},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-DL-TDOA-AdditionalMeasurements shall be absent.","paragraph_zero_based":1014},{"literal_text_all_w_t_and_m_t":"nr-MeasBasedOnAggregatedResources","paragraph_zero_based":1015},{"literal_text_all_w_t_and_m_t":"This field indicates whether the RSTD measurement, RSRP measurement (if included), and RSRPP measurement (if included) is based on aggregated DL-PRS Resources.","paragraph_zero_based":1016},{"literal_text_all_w_t_and_m_t":"nr-AggregatedDL-PRS-ResourceSetID-List","paragraph_zero_based":1017},{"literal_text_all_w_t_and_m_t":"This field provides the DL-PRS Resource Set IDs which are used for the aggregated RSTD, RSRP, or RSRPP measurement results. This field is optionally present if the field nr-MeasBasedOnAggregatedResources is present; otherwise, it is not present. If the field is present, the field nr-DL-PRS-ResourceID and nr-DL-PRS-ResourceSetID should not be included, and the dl-PRS-ID in IE NR-DL-TDOA-MeasElement shall be ignored by a receiver.","paragraph_zero_based":1018},{"literal_text_all_w_t_and_m_t":"nr-RSCPD","paragraph_zero_based":1019},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL reference signal carrier phase difference measurement, as defined in TS 38.215 [36].  Mapping of the measured quantity is defined as in TS 38.133 [46]. This neighbour TRP measurement is made using DL-PRS Resources from the same PFL as the reference TRP measurement.","paragraph_zero_based":1020},{"literal_text_all_w_t_and_m_t":"nr-PhaseQuality","paragraph_zero_based":1021},{"literal_text_all_w_t_and_m_t":"This field specifies the target device′s best estimate of the quality of the RSCPD measurement.","paragraph_zero_based":1022},{"literal_text_all_w_t_and_m_t":"nr-RSCPD-AddMeasurementSamples","paragraph_zero_based":1023},{"literal_text_all_w_t_and_m_t":"This field, in addition to the nr-RSCPD measurements provided in NR-DL-TDOA-MeasElement, provides up to 3 RSCPD measurements samples associated with the nr-RSTD in NR-DL-TDOA-MeasElement. ","paragraph_zero_based":1024},{"literal_text_all_w_t_and_m_t":"nr-ReportDL-PRS-MeasBasedOnSingleOrMultiHopRx","paragraph_zero_based":1025},{"literal_text_all_w_t_and_m_t":"This field indicates that the reported measurement is based on DL-PRS receive hopping with either single hop or multiple hops.","paragraph_zero_based":1026},{"literal_text_all_w_t_and_m_t":"nr-RSTD-ResultDiff","paragraph_zero_based":1027},{"literal_text_all_w_t_and_m_t":"This field provides the additional DL RSTD measurement result relative to nr-RSTD. The RSTD value of this measurement is obtained by adding the value of this field to the value of the nr-RSTD field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1028},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RSRP-ResultDiff","paragraph_zero_based":1029},{"literal_text_all_w_t_and_m_t":"This field provides the additional DL-PRS RSRP measurement result relative to nr-DL-PRS-RSRP-Result. The DL-PRS RSRP value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-RSRP-Result field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1030},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-FirstPathRSRP-ResultDiff","paragraph_zero_based":1031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["73ab35f87b2f60e0d245d9164540589cb226362c7c188ad2c8ef28b23bcd7e33","f4ae1214ac7a04bef92264fde1c4abbaf6f391884c4e26c22351a0dc83dc0f23","9d6dabeaf8e1889ad991d1becc6bca01bfe2d247b522b0d1381c5579ccbf206e","99de065ce63a9625b579c8f336d46299f7b2e768b7cbaf955d7df660bbf2f385","cc866f28ce8afbba18f55b8128cd4b629c6bdab280075396007c83d8435ba87c","b4a15d8447b718fdd5c329dcd67910ee270513b747f62d454c8ebbdc353addc4","5f40aeb7adacfaf043d6d07094fce97e250aeea82055d3508ecd8fc4c1ee3f6e","892f1f3eebc3f479e9783c50c79ab7526496beaf59d9fe8aeb05ceac0f24e6bd","7b52d3eb14c870f1c6d953b583fac25358cbd3f3a2df2d18f12a8869afa12f03","0afcad2f0a8e78567b0068c5705ed8eac299054fbb26b23aff2ae1119d13e431","4661ebd5520c6728dae5ba9631586273040bbdeda64b6c45e71134add8434409","8e81a442aa5c864f46f39deb67b5ca1456b2e94a7d1ba1e80e1b186050f11770","b3e10928581230f0d819c2398f20d320a683c28294b955ed65dc36fe61750564","89d77a8adff502e330520d93ee3d82064c61b248050859dc942c8670beae1aab","5d1eab645fd9ad0d95026f673018871934451e7945899c99e2ec09ad248cde2b","cc911bf969147c4df90ab7a223b6e9c34dfc9ac6703cefa4363f5788bb92f404","3dd71d409a29c95f0ce3cde18b1ee674cf3eb1cac5c5fa6e8382d8357753a0e9","ddfbac909aeb25f38f68f0b92a95cea8bf2905f97069fc19b15dfb5649673eab","e59a0173f00989e4d91239daff0494e6209e47c7c41ff575613abfbd8c77f436","74c19492d84ed4718f74cd86ac404c7ca5f9dbca82fc0273227c74be48bb0ba3","536a573bc1d6098f2571387a5d423887db632e461dd415ae3eb09a7812c48edf","aafc09e322b368d07bab22116a55f3f7f3a3d38e952d8d95db1afa6a5f8a54bf","b1d112da6ddd1f658ffdefb713e4b1e985e6dc597154d5a90c74101c0038aced","af24079eaff3186ac0a6bd4a4dede730ddceaac981bb58e1f72dc650c24231a9"],"paragraph_range_zero_based":[1008,1031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1008"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the additional NR DL-PRS reference signal received path power (DL PRS-RSRPP) of the first detected path in time relative to nr-DL-PRS-FirstPathRSRP-Result. The DL-PRS RSRPP of first path value of this measurement is obtained by adding the value of this field to the value of the nr-DL-PRS-FirstPathRSRP-Result field. The mapping of the field is defined in TS 38.133 [46].","paragraph_zero_based":1032},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorPerResource","paragraph_zero_based":1033},{"literal_text_all_w_t_and_m_t":"This field specifies the target device's best estimate of the LOS or NLOS of the TOA measurement for the resource. Note, the TOA measurement refers to the TOA of this neighbour TRP or the reference TRP, as applicable, used to determine the nr-RSTD or nr-RSTD-ResultDiff.","paragraph_zero_based":1034},{"literal_text_all_w_t_and_m_t":"This field may only be present if the field nr-LOS-NLOS-Indicator choice indicates perResource.","paragraph_zero_based":1035},{"literal_text_all_w_t_and_m_t":"nr-RSCPD-AdditionalMeasurementsAddSamples","paragraph_zero_based":1036},{"literal_text_all_w_t_and_m_t":"This field, in addition to the nr-RSCPD measurement provided in NR-DL-TDOA-AdditionalMeasurementElement, provides up to 3 RSCPD measurement samples associated with the RSTD measurement in NR-DL-TDOA-AdditionalMeasurementElement.","paragraph_zero_based":1037},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1038},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1039},{"literal_text_all_w_t_and_m_t":"6.5.10.5NR DL-TDOA Location Information Request","paragraph_zero_based":1040},{"literal_text_all_w_t_and_m_t":"–NR-DL-TDOA-RequestLocationInformation","paragraph_zero_based":1041},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-TDOA-RequestLocationInformation is used by the location server to request NR DL-TDOA location measurements from a target device.","paragraph_zero_based":1042},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1044},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-RequestLocationInformation-r16 ::= SEQUENCE {","paragraph_zero_based":1045},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RstdMeasurementInfoRequest-r16ENUMERATED { true }OPTIONAL,-- Need ON","paragraph_zero_based":1046},{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements-r16BIT STRING { prsrsrpReq (0),","paragraph_zero_based":1047},{"literal_text_all_w_t_and_m_t":"firstPathRsrpReq-r17 (1),","paragraph_zero_based":1048},{"literal_text_all_w_t_and_m_t":"dl-PRS-RSCPD-Request-r18 (2)","paragraph_zero_based":1049},{"literal_text_all_w_t_and_m_t":" } (SIZE(1..8)),","paragraph_zero_based":1050},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability-r16BOOLEAN,","paragraph_zero_based":1051},{"literal_text_all_w_t_and_m_t":"nr-DL-TDOA-ReportConfig-r16NR-DL-TDOA-ReportConfig-r16OPTIONAL, -- Need ON","paragraph_zero_based":1052},{"literal_text_all_w_t_and_m_t":"additionalPaths-r16ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1053},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1054},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["51f835cb71a917cd6ea9fafc84648370822b93e3c55eec018b6d031a6e1a87c8","23e21f0336e135a982c4a305fc90b53e09ba85ab70ca0a6556c722f56348a49b","af4efae713fe98c95dcbc073c65df582aae1981714f9572eb50d2ff5de