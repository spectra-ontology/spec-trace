{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16704},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16705},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16706},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":16707},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this intra-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":16708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16709},{"literal_text_all_w_t_and_m_t":"–SIB4","paragraph_zero_based":16710},{"literal_text_all_w_t_and_m_t":"SIB4 contains information relevant for inter-frequency cell re-selection (i.e. information about other NR frequencies and inter-frequency neighbouring cells relevant for cell re-selection), which can also be used for NR idle/inactive measurements. The IE includes cell re-selection parameters common for a frequency as well as cell specific re-selection parameters.","paragraph_zero_based":16711},{"literal_text_all_w_t_and_m_t":"SIB4 information element","paragraph_zero_based":16712},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16713},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-START","paragraph_zero_based":16714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16715},{"literal_text_all_w_t_and_m_t":"SIB4 ::=                            SEQUENCE {","paragraph_zero_based":16716},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList            InterFreqCarrierFreqList,","paragraph_zero_based":16717},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                OPTIONAL,","paragraph_zero_based":16718},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":16719},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16720},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1610      InterFreqCarrierFreqList-v1610              OPTIONAL   -- Need R","paragraph_zero_based":16721},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16722},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16723},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1700      InterFreqCarrierFreqList-v1700              OPTIONAL   -- Need R","paragraph_zero_based":16724},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":16725},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":16726},{"literal_text_all_w_t_and_m_t":"    interFreqCarrierFreqList-v1720      InterFreqCarrierFreqList-v1720              OPTIONAL   -- Need R","paragraph_zero_based":16727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["623a40540058b4bc775a3ebd14ef4f654d9f68f3a52c03ee068c59f77f89ffd4","0e5ab92b093866c6f0dc34754edfb47c6e5b226a8aedd8f41f2a1ffa8019830c","610d68d1ef4f776191e1003e5a841e51191cd6e71d935b8951aadc1059ea4346","282bcf30c9a2470dc7cc334102ca47013eaa4cbe5fa188126155937d41e18b23","85fac2cd54704b502c01d05d2546947f64d5a03296ce9abd1999f2b214580fb1","6bd0a099ab6ef03279e8304c86df82f3cfd6d3d846e9e958f2ae1d1e6b63d755","af60ef28d7c9232f1f02ff7b30c97aac88c64cc1b590bda3d1aaa29e3a33c561","397d1a658d453c56db8b2c7cd1b3f7eee5adb4f8428cfc26db509d59481dc919","30818f7e049b1102c09659e5997a30b8b0eece04ebb32c35ed12436f74a4f277","1accfa4c83abac94b479bdced7dc9e1bd946941aaeefef75491d4d5282c4fcfd","2f7633f74186bbcd6f4aaa4eee4ef11cab023afc418b1f24024a25e06c