{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CSI-RESOURCECONFIG-STOP","paragraph_zero_based":23928},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23930},{"literal_text_all_w_t_and_m_t":"LTM-CSI-SSB-ResourceSet field descriptions","paragraph_zero_based":23931},{"literal_text_all_w_t_and_m_t":"ltm-CandidateIdList","paragraph_zero_based":23932},{"literal_text_all_w_t_and_m_t":"This field Indicates the LTM candidate cell IDs related to the SSBs in the ltm-CSI-SSB-ResourceList. The list has the same number of entries as ltm-CSI-SSB-ResourceList. The first entry in this list shall be associated to the first entry in ltm-CSI-SSB-ResourceList, the second entry of this list shall be associated to the second entry in ltm-CSI-SSB-ResourceList, and so on.","paragraph_zero_based":23933},{"literal_text_all_w_t_and_m_t":"ltm-CSI-SSB-ResourceList","paragraph_zero_based":23934},{"literal_text_all_w_t_and_m_t":"This field is used to indicate on SS/PBCH block resources from one or more LTM candidate cells.","paragraph_zero_based":23935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23936},{"literal_text_all_w_t_and_m_t":"–LTM-CSI-ResourceConfigId","paragraph_zero_based":23937},{"literal_text_all_w_t_and_m_t":"The IE LTM-CSI-ResourceConfigId is used to identify an LTM-CSI-ResourceConfig.","paragraph_zero_based":23938},{"literal_text_all_w_t_and_m_t":"LTM-CSI-ResourceConfigId information element","paragraph_zero_based":23939},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23940},{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CSI-RESOURCECONFIGID-START","paragraph_zero_based":23941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23942},{"literal_text_all_w_t_and_m_t":"LTM-CSI-ResourceConfigId-r18 ::=            INTEGER (0..maxNrofLTM-CSI-ResourceConfigurations-1-r18)","paragraph_zero_based":23943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23944},{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CSI-RESOURCECONFIGID-STOP","paragraph_zero_based":23945},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23947},{"literal_text_all_w_t_and_m_t":"–LTM-TCI-Info","paragraph_zero_based":23948},{"literal_text_all_w_t_and_m_t":"The IE LTM-TCI-Info is used to configure TCI related information for an LTM candidate configuration.","paragraph_zero_based":23949},{"literal_text_all_w_t_and_m_t":"LTM-TCI-Info information element","paragraph_zero_based":23950},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["65420f955ad401aefbc2cc362dc0f79997bdec0589671b78003bf9057cea3f96","d56493e37d323cb274cc82982ab4c1e800ef7ea0e8951f44308c7165a3b6a14b","c3a52f3b81bef8937923730a9f02a273dd67845f6ea0a4b8f8f6b150d5234a68","e63f476d65b7427164840d67d068d7ae86e10ac5b343be3d3123d15a841a12da","721076e023de1c8d8876931ff6a035d3c1299b7ce2d709942a9e422614f782f6","6d6fd48ce02cc59535e2ca852a9e5da4557536f546a0ab303fb78377db8dce7a","3b6ce0d2dfc0eb312d27e72672bba811fd28f1fa01a0e55c108bb738c2d4c5bd","373388f69975f88166f0cf233d64b92eea8433ef8d655fc597886e1308d1af15","9257c7b652232615d18f2bd16650d25915990209c35c412019bafd98f25cd58c","81e50d09abf24d20d3abed34507430fbd234df26e6f92152d37b9a03c84ce72f","a09a7945f57c41ae94ee992a536d5b22530f886930f2b4bcf600f60da626f7b6","f4e000394eac6c3a95f547bad07de97e115a2ce153630c77235a724c29d09ba0","6a9a55