{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    rf4-r17                                INTEGER(0..3),","paragraph_zero_based":17712},{"literal_text_all_w_t_and_m_t":"    rf8-r17                                INTEGER(0..7),","paragraph_zero_based":17713},{"literal_text_all_w_t_and_m_t":"    rf16-r17                               INTEGER(0..15),","paragraph_zero_based":17714},{"literal_text_all_w_t_and_m_t":"    rf32-r17                               INTEGER(0..31),","paragraph_zero_based":17715},{"literal_text_all_w_t_and_m_t":"    rf64-r17                               INTEGER(0..63),","paragraph_zero_based":17716},{"literal_text_all_w_t_and_m_t":"    rf128-r17                              INTEGER(0..127),","paragraph_zero_based":17717},{"literal_text_all_w_t_and_m_t":"    rf256-r17                              INTEGER(0..255)","paragraph_zero_based":17718},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17719},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17720},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB20-STOP","paragraph_zero_based":17721},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17723},{"literal_text_all_w_t_and_m_t":"SIB20 field descriptions","paragraph_zero_based":17724},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMCCH-MTCH","paragraph_zero_based":17725},{"literal_text_all_w_t_and_m_t":"Common frequency resource used for MCCH and MTCH reception. If the field is absent, the CFR for broadcast has the same location and size as CORESET#0 and PDSCH configuration of MCCH is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":17726},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMCCH-MTCH-RedCap","paragraph_zero_based":17727},{"literal_text_all_w_t_and_m_t":"Common frequency resource used for MCCH and MTCH reception for (e)RedCap UEs. If the field is absent, the (e)RedCap UE can use cfr-ConfigMCCH-MTCH if the UE supports the configured bandwidth.","paragraph_zero_based":17728},{"literal_text_all_w_t_and_m_t":"mcch-WindowDuration","paragraph_zero_based":17729},{"literal_text_all_w_t_and_m_t":"Indicates, starting from the slot indicated by mcch-WindowStartSlot, the duration in slots during which MCCH may be scheduled. Absence of this field means that MCCH is only scheduled in the slot indicated by mcch-WindowStartSlot. The network always configures mcch-WindowDuration to be shorter or equal to the length of MCCH repetition period.","paragraph_zero_based":17730},{"literal_text_all_w_t_and_m_t":"mcch-ModificationPeriod","paragraph_zero_based":17731},{"literal_text_all_w_t_and_m_t":"Defines periodically appearing boundaries, i.e. radio frames for which SFN mod mcch-ModificationPeriod = 0. The contents of different transmissions of MCCH information can only be different if there is at least one such boundary in-between them. Value rf2 corresponds to two radio frames, value rf4 corresponds to four radio frames and so on.","paragraph_zero_based":17732},{"literal_text_all_w_t_and_m_t":"mcch-RepetitionPeriodAndOffset","paragraph_zero_based":17733},{"literal_text_all_w_t_and_m_t":"Defines the length and the offset of the MCCH repetition period. rf1 corresponds to a repetition period length of one radio frame, rf2 corresponds to a repetition period length of two radio frames and so on. The corresponding integer value indicates the offset of the repetition period in the number of radio frames. MCCH is scheduled in the MCCH transmission window starting from each radio frame for which: SFN mod repetition period length = offset of the repetition period.","paragraph_zero_based":17734},{"literal_text_all_w_t_and_m_t":"mcch-WindowStartSlot","paragraph_zero_based":17735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c88cd680004152cebe6a70a7d1369f1b46fbf4e2d46908497ddf6c6db8ecd9a0","7e30363b99addc3c71f96ff0f7fff634643a6311849a4701e8f4e2238f452056","f76f3b452758019c96457151eea561934b2cd988bc676c297d07adcd70dd1ff9","965c4471f415efdf68e96cc83801e2d5f4f9714c8103936f5ea2c41a0e65f5c0","a11bdf992724aff14a37a150173fc328a5f628e2dff40bc5ab85e8b26e6f5b36","218c8589d5f529c5f34dd822b5c2776fe050ec132e80dfcea6ba7f6e7ab7ca8c","9c21b3dd28892ac251202317c9433e88a035c8ace2eb82243a98e3b7fc46ef80","51c09d9684f9bd8add95b5318ee1a633978eb666e4a6df069b9acbefa06e7fc4","775e3b6bc3351c1837a2dfe37d6f854b9c92d95a61b48ecaead3e1b7d8fd5314","3377b24cd9bb81caf46cb52e372ca2e08daaa80617c8b01b68a4407a5b9bbfb0","c37c681196ee8bf5fc4fc5f46e794cf47c16f1a6fb814448ce47ca21464df451","cb330093dbee1b50e77ea5196ed302c4187e327359649ba20f6b4d3615cde3c0","3aead24fb23e0034efbc6d888a695de8d0340aaa6ee5500dcf44d2271b8809a2","718d5a7ea691a2d0d5180ce67c064f72e93a9378e13c6f695eaec06a155910c8","b1d96a6676390485f1c9ade88e602179f220b15a431f61c75114d70bce48028a","aaf9b7f9e1d4443d3fe1c45d2e188f50c226aa259704c5b687f61f82562e6081","720c5de78ee2a92aaf67339dde116ec26931dc7c4784de9e6f55d742a1344f15","07ed908e1fb23821593110000cd8c125fd606332867423e0d73ed689e0a9b1bd","40b4d697e9932565ed31d18b4dda29be582286be5ebfa7a0d872b89bfa366309","a557703a27a726247f5d29360cc74810576d5afc802f1789a929f15a4f003f45","368435befc7cce54d7cc8ee88e014ac19c714cb97ee4b77b5dc53a8e09de2969","c82deb392b235e5b426cac2c37a8a802ad5d3c8c8c06fedc78cd964528e5a21e","b41474bbf59a17da143e7f86286c30a9510dd03e5dcb3c6f8b177211d6fc398a","aa16c539f2059746d828c373038a9fb7530f9bf14d1becd7fa900dd734d656ac"],"paragraph_range_zero_based":[17712,17735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p17712"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the slot in which MCCH transmission window starts.","paragraph_zero_based":17736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17737},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":17738},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":17739},{"literal_text_all_w_t_and_m_t":"CFR-RedCap","paragraph_zero_based":17740},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if the configured bandwidth in cfr-ConfigMCCH-MTCH exceeds the RedCap UE capability. It is absent otherwise.","paragraph_zero_based":17741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17742},{"literal_text_all_w_t_and_m_t":"–SIB21","paragraph_zero_based":17743},{"literal_text_all_w_t_and_m_t":"SIB21 contains the mapping between the current and/or neighbouring carrier frequencies and MBS Frequency Selection Area Identities (FSAI).","paragraph_zero_based":17744},{"literal_text_all_w_t_and_m_t":"SIB21 information element","paragraph_zero_based":17745},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17746},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB21-START","paragraph_zero_based":17747},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17748},{"literal_text_all_w_t_and_m_t":"SIB21-r17 ::= SEQUENCE {","paragraph_zero_based":17749},{"literal_text_all_w_t_and_m_t":"    mbs-FSAI-IntraFreq-r17                   MBS-FSAI-List-r17                OPTIONAL,  -- Need R","paragraph_zero_based":17750},{"literal_text_all_w_t_and_m_t":"    mbs-FSAI-InterFreqList-r17               MBS-FSAI-InterFreqList-r17       OPTIONAL,  -- Need R","paragraph_zero_based":17751},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                 OCTET STRING                     OPTIONAL,","paragraph_zero_based":17752},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17753},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17755},{"literal_text_all_w_t_and_m_t":"MBS-FSAI-List-r17 ::= SEQUENCE (SIZE (1..maxFSAI-MBS-r17)) OF MBS-FSAI-r17","paragraph_zero_based":17756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17757},{"literal_text_all_w_t_and_m_t":"MBS-FSAI-InterFreqList-r17 ::= SEQUENCE (SIZE (1..maxFreq)) OF MBS-FSAI-InterFreq-r17","paragraph_zero_based":17758},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["df9dff140b64c72414f069ddb371a48b1b47ef6107e2a0ad9fb7e86f1d029a3c","59221854982d4ae4630718f6f5e464dff87575847877d541066d7120816d8be5","e983cd368a3c588e01ffbbd09bdbcb089b96aecc0596a5bf96ef343071f37fee","371dd26c4b32fa03f0b407c6556572c09b5d6b966ecbfd4d831b10ad5b14c6de","f24d52a32e33cec284bece02ae33d1455e1e33f7a296df56898e6372770b9fe5","cb063cb7b19b0691ded1519623c489d20918af1537a290c5cbae1f57a65d4921","d1059d08c17b62ee8d7013f1016440bd831a48654698ae313151db9850316ce3","fcc5e5cc20f7f9b33a3abeb2a7308dcac541143e5a6365ea92daf696dfc69b15","9d78e46aa157ffe39b16f9cb22caa767d21c0a0a1c534789838bf28b481089c8","a6c03dc0026a4b805693ec914c96992343a7878eaac0a827b5133b542ae0d82f","0d2f09174a6b42b8dfd0d7bb8d7f5f8466e30b842f4b7b2fc3647d92782d4558","b30c48a4a34e299671999199120e94b1ed791c0f938695141c3451c8de48fccc","12ea8f7083d399131a7add402c7a6215ab93e133dfe08774cd064ff20d0e9f3f","d2dcb3efa866ef24102bf36d59931828cb2f1628aa375900ed5524f30d5417b1","3e5b22a59694b4728125868b588c7721eb3f59d45b7071738d