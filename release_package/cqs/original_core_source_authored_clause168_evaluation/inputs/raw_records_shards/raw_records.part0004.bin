{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    mt-SDT-RSRP-Threshold-r18            RSRP-Range                                                            OPTIONAL, -- Need S","paragraph_zero_based":264},{"literal_text_all_w_t_and_m_t":"    sdt-LogicalChannelSR-DelayTimer-r18  ENUMERATED { sf20, sf40, sf64, sf128, sf512, sf1024, sf2560, spare1}  OPTIONAL, -- Cond MT-SDT1","paragraph_zero_based":265},{"literal_text_all_w_t_and_m_t":"    t319a-r18                            ENUMERATED { ms100, ms200, ms300, ms400, ms600, ms1000, ms2000,","paragraph_zero_based":266},{"literal_text_all_w_t_and_m_t":"                                                      ms3000, ms4000, spare7, spare6, spare5, spare4,","paragraph_zero_based":267},{"literal_text_all_w_t_and_m_t":"                                                      spare3, spare2, spare1}                                  OPTIONAL  -- Cond MT-SDT2","paragraph_zero_based":268},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":271},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB1-STOP","paragraph_zero_based":272},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":273},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":274},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":276},{"literal_text_all_w_t_and_m_t":"SIB1 field descriptions","paragraph_zero_based":277},{"literal_text_all_w_t_and_m_t":"barringExempt-eRedCap","paragraph_zero_based":278},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell allows IMS emergency bearer services for eRedCap UEs, if these UEs consider the cell as acceptable cell as specified in TS 38.304 [20].","paragraph_zero_based":279},{"literal_text_all_w_t_and_m_t":"cellBarred2RxXR","paragraph_zero_based":280},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is barred for 2Rx XR UEs. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated as specified in TS 38.101-1 [15]. If this field is absent on a cell operating in a frequency band where 4RX antenna ports are mandated, a 2RX XR UE shall treat the cell as not barred, as specified in TS 38.304 [20].","paragraph_zero_based":281},{"literal_text_all_w_t_and_m_t":"cellBarredATG","paragraph_zero_based":282},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to ATG, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to ATG. If not present, the UE considers the cell is not allowed for connectivity to ATG, as defined in TS 38.304 [20]. This field is only applicable to ATG-capable UEs.","paragraph_zero_based":283},{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap1Rx","paragraph_zero_based":284},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":285},{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap2Rx","paragraph_zero_based":286},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["eebcd0e95b2c3539e426ccee2d07da1c3202874e8c6e277d5eed7f20efcf7e7d","88c7275a7d754ed95f7d20086bcf35a5eb0b33d315ba2eef84af8ce7e1ada5c9","0c3639f09559ba5b192636b68ed24475017e67c4b055b4a7d6dca745ab894c3e","ee3131ac9821240dcc741fbf3fcfd77f085aeb34a794255c3b66f057116701b7","2c91b743e37c943024dcda76250542e55b34e959e07d7ebb5ecc4e871cd19345","288d75e4ce5405b0433c7cddb9bbf0581c8ba322813ffe617340ebff2f4eb4ef","802f83031b42c84538b7376ca6236357591938abad3c7b01e09274a1b2fad090","58438be174050bd27824ce848a219fcaba4abb69b5218c800797c8f8e915119d","29aeefd0cb8caf310e97e416809ce813f3ad72b2d90308b8bf464072fea1e379","6c2fe0b3dbb16be29fb3b5d6d3bd9c8bbb7cea05154066c13e3d44723317cb7b","8c5da2e385d769b792a90f8aaf4794a0f8ae75d1d0a6c79eb93916843b463a49","243358996f0a95bdc8e4d50c2d0768545c4fb8622e41e9fc75bb4d4f58a615b2","07954e1b2291bcbd932ea6518a9a1348addd6a68b163dce303cacbc1afe07e47","d77ab2e465eecb652308b85408f76d4fb9c1cdb18d6c7390b82b1389556aad45","dca769c443c22056d038953c21671321b718609237b395d254996b8efa771b1f","1e8f2a2e0f2b9a43a71f422b03823c2b199631ff9842be1299a425a06892d9e9","393c16e016f2668a8ffdea52654e8ac7e592fd8b853aac708f63ee406f702d76","e96222cde0383bddbe8010ca7db101f10e8c7b4d575b2d15bd57b55b9423b273","7e54099576d2b4fe0d8a0ecd582e6fb5e3aae7d5933b1e00e9780911627abf48","02f03acfa518647de5765aac5195e43c3b43f1fc0fa40168e8bff3bf36dbf7cb","101c4cc5b43a1513eb0e44d269be26d7a3c5f96172c952d71c324828aeb9c08c","87d10ae372573d1eaf704a02a53d80b164fa1629c5cdc4ac990bb579dcb36775","9add982e95566b9281bd1e431ec2933fd577b80c58240dfc6c0c755d84ff8e15","883ba8a05f3ded55e0d4e9dadb953ec9e9cfddff05b9c5b1eb0001ee41e79487"],"paragraph_range_zero_based":[264,287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p264"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellBarredFixedVSAT","paragraph_zero_based":288},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for fixed VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for fixed VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":289},{"literal_text_all_w_t_and_m_t":"cellBarredMobileVSAT","paragraph_zero_based":290},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for mobile VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for mobile VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":291},{"literal_text_all_w_t_and_m_t":"cellBarredNES","paragraph_zero_based":292},{"literal_text_all_w_t_and_m_t":"This field indicates the cell barring status for UEs supporting nes-CellDTX-DRX as described in 5.2.2.4.2.","paragraph_zero_based":293},{"literal_text_all_w_t_and_m_t":"cellBarredNTN","paragraph_zero_based":294},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to NTN, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to NTN. If not present, the UE considers the cell is not allowed for connectivity to NTN, as defined in TS 38.304 [20]. This field is only applicable to NTN-capable UEs.","paragraph_zero_based":295},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap1Rx","paragraph_zero_based":296},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":297},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap2Rx","paragraph_zero_based":298},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":299},{"literal_text_all_w_t_and_m_t":"cellSelectionInfo","paragraph_zero_based":300},{"literal_text_all_w_t_and_m_t":"Parameters for cell selection related to the serving cell.","paragraph_zero_based":301},{"literal_text_all_w_t_and_m_t":"eCallOverIMS-Support","paragraph_zero_based":302},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports eCall over IMS services as defined in TS 23.501 [32]. If absent, eCall over IMS is not supported by the network in the cell.","paragraph_zero_based":303},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedIdle","paragraph_zero_based":304},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for CN paging is allowed in the cell for UEs in RRC_IDLE or RRC_INACTIVE. The UE shall stop using extended DRX for CN paging in RRC_IDLE or RRC_INACTIVE if eDRX-AllowedIdle is not present.","paragraph_zero_based":305},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedInactive","paragraph_zero_based":306},{"literal_text_all_w_t_and_m_t":"The presence of eDRX-AllowedInactive-r17 this field indicates that extended DRX cycle equal to or shorter than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle equal to or shorter than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r17 is not present. The presence of eDRX-AllowedInactive-r18 indicates that extended DRX cycle longer than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle longer than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r18 is not present.","paragraph_zero_based":307},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":308},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as (e)RedCap, Slicing, SDT, MSG1-Repetitions and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":309},{"literal_text_all_w_t_and_m_t":"halfDuplexRedCap-Allowed","paragraph_zero_based":310},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the cell supports half-duplex FDD (e)RedCap UEs.","paragraph_zero_based":311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["0542de0619776a13ea5b38166d9e8e3be934414b2cfcc9b0bb2520b904ddc0e5","a21099758b998b5a449079170a67a5b775f469491d56407b0bc66c2b49b14a18","6855a2a3359ccf6cc7e276fe29281c170590f4a8dedccadf7a683c8a4fd07a4b","29bbd24285c05829d8e9b0048d6da46fb3b95f2d1051a7f5fbe3359ae42280e5","d414d2cc2072f34fc0f17231e83ae55cd6875edab65db572ca8200c8642796e7","57b538732e1dbae4f52122a751d9ad2d67976056314f6e8fc6b78e3d112de6f8","e41fccaa9691a3ee0966a905a16eb6b44e26e53adf206d1daeef529d13745bd9","a318146ec58cf00b44490827a2561e75061bdae4f7c19aeb19e224e228c122ee","603578e0c473f9b56d53774fb99b11a0f9b7187e5aead5e75f4b00a96fe104a1","742373c06f9422d3af620278f3197e7c225c13c4a02a7f63b10260ba0f67c429","97e1845df0392ea73ffdc09f36683da5558df8e52d358436571d2d056f4af950","03dfa6299af865c75c431a6dc1468225bf61e9bb413048616d46c59e11c01ef5","639d8b3d422c9592f209c17e4b2029301a0374d4dffe5b75b641590b603172f9","5828a2533665e91165529c1a9d40b820819fb1cb1d6eead884831ad518823d58","b0978d5fde247d120e630ac13c8d924a16da1d020fde561dc4fa6d3d4b17ee01","2eb4828df4e569f64f0c31efadfe30e1e88c10c8dda3aa469e7756e175dba33f","369f075429f7b55bc18a3fa3482b11651bb3dcf6384dec7e01b8fe3e4755fe1a","3b71985b6c6f745407b67ac3bd4051fc4ca6ce0277e22a53884fa73235e36710","077649c8fcf7cf3165defd57086a2a7c646e3137711f71fc8af6ee67ec4bc892","3f923210051f7526583fd76e25bb3143efa363ba7e17d9ac12d86d952f52aabc","733e1942c27aaae31eb6969ba18670a71bbb9d31507249a89a579c207ac7a39a","fbab2882c9817778a406b1669f2be87aae82c8d4ac6578c29a594ccc48cc50d9","152464a9b4f4bef9f284dabe7b6f19ccaf2ff016bc6de747437f407adaa49a32","0e83532cf1f9826c9dc181a0bb67ef76b31d19d4efb013f5d555d37682a39041"],"paragraph_range_zero_based":[288,311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p288"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"hsdn-Cell","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"This field indicates this is a HSDN cell as specified in TS 38.304 [20].","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"Indicates hyper SFN which increments by one when the SFN wraps around. This field is excluded when determining changes in system information, i.e. changes of hyper SFN should not result in system information change notifications.","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsEUTRA","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for EUTRA idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform EUTRA idle/inactive measurements.","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsNR","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform NR idle/inactive measurements.","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"ims-EmergencySupport","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports IMS emergency bearer services for UEs in limited service mode. If absent, IMS emergency call is not supported by the network in the cell for UEs in limited service mode.","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"intraFreqReselection2RxXR","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"This field controls cell selection/reselection to intra-frequency cells for 2Rx XR UEs when this cell is barred or treated as barred by the 2Rx XR UE, as specified in TS 38.304 [20]. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated, as specified in TS 38.101-1 [15].","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"intraFreqReselection-eRedCap","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for eRedCap UEs when this cell is barred, or treated as barred by the eRedCap UE, as specified in TS 38.304 [20]. If not present, an eRedCap UE treats the cell as barred, i.e., the UE considers that the cell does not support eRedCap.","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"intraFreqReselectionRedCap","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for RedCap UEs when this cell is barred, or treated as barred by the RedCap UE, as specified in TS 38.304 [20]. If not present, a RedCap UE treats the cell as barred, i.e.,the UE considers that the cell does not support RedCap.","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"mobileIAB-Cell","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that this is a mobile IAB cell.","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"mt-SDT-RSRP-Threshold","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether MT-SDT procedure can be initiated, as specified in TS 38.321 [3]. If the field is absent, and the field sdt-RSRP-Threshold is present, the UE applies the value in the field sdt-RSRP-Threshold.","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"musim-CapRestrictionAllowed","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to send the musim-CapRestrictionInd in RRCSetupComplete and RRCResumeComplete messages.","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"ncr-Support","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"This field combines both the support of NCR and the cell status for NCR. If the field is present, the cell supports NCR and the cell is also considered as a candidate for cell (re)selection for NCR-node; if the field is absent, the cell does not support NCR and/or the cell is barred for NCR-node.","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["48cbd88d47ff0541b60fceda84669a5568e33f1345f2bcf7bea2db464609e980","08a1ec974cb18df16c50d340ca36d5db6855b11ea367e99a6f17acbfc1b694af","6f6be571362edc9f473edfaf403ebbefa561e3bf02e3aca9f48444ff215e3dfb","735cd1bbd87923d8796986ece8ef99047528a5779c575caa56467f4cb41ad785","e64ab8f0e614c63669230695d1574faa9b358d3791604a0d5ec239326ab70105","59e465f24318709f486c54a7061e8d12e2838b067d6ed269e3417c0ef955549b","b1878f4e02579dd95f64abf0302d1443c8929acb915818edb7092d5b1b0c1719","bebcfe9e64f5359aaa536ecb705aa5ca00db51b0f2da1ce19d7f19370b2eba3e","eb34d662b9dbd9fea6efccc304656925a97c41c839b67cefce43612959ecc556","19e9803a500285da416f11b2c187ec9028bc597b5d26330fe1aafde41b0053ba","5509af1b7a2cadc19d53e4511136298d54ebdce0f95e459c163f856fa791f51a","e8e138cf3ab1f0f8f04d97cf9422ed0301995089231e301555be126fc5ed1b7c","06f1f497ba03a845a7a9b4c4ec598ddd6948b70953fa74de1e41c5098123bc20","a4b88b0aa2dfd756e421c9dc4569aecaee24e7167d448571407baf6f08da81ae","d5b1045252d00409185540febdaf4ed57e3d0603f26e51529b1196849dc1692a","5308a63123f178ab466f966b0350689cf904bdd97d541cffdf6953747e17f1b4","df76f06b0f7e1f30aab7bb980bcb581e39b305df279d64960070995c0cc53c8d","03fdba395d28be32f68073e4d02f58b06e33f89edb0cb96c6752f5314d4f0b74","add70398652eda68ed2286e07eb429fee3e67f64efe57c7d5db139f5e4bee096","bc075bfb9e8ba3165ed13354354b65660c1330bf7f1f0d6aeea1716b566f0fff","76539326300278b28094c620f07cd68979102e42e8c4cdaa4c809bc9ef7b3a4d","19b541ebc8a90163dcad1b007eb1dca1b46887eeadb5ddab72d45eab1180a872","d7e8183bd606502f2d4066d0acaa979a07c61189b45b4ca7b28e1eb8499b2a10","920aa671bdcab13ca08f7d0f0d4262032ec73c74dde89655057fa1f8153df7ee"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p312"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nonServingCellMII","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"Indicates whether the MBSInterestIndication message for MBS broadcast reception on a non-serving cell is allowed to be transmitted to the serving gNB.","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for serving cell. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"q-QualMinOffset","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffset\" in TS 38.304 [20]. Actual value Qqualminoffset = field value [dB]. If the field is absent, the UE applies the (default) value of 0 dB for Qqualminoffset. Affects the minimum required quality level in the cell.","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffset","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffset\" in TS 38.304 [20]. Actual value Qrxlevminoffset = field value * 2 [dB]. If absent, the UE applies the (default) value of 0 dB for Qrxlevminoffset. Affects the minimum required Rx level in the cell.","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"reselectionMeasurementsNR","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR reselection measurements shall report availability of these measurements when establishing or resuming a connection in this cell.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"sdt-BeamFailureRecoveryProhibitTimer","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"The value of the prohibit timer used for RACH for beam failure indication during SDT as specified in TS 38.321 [3]. Value ms50 corresponds to 50 milliseconds, value ms100 corresponds to 100 milliseconds and so on.","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"sdt-DataVolumeThreshold","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"Data volume threshold used to determine whether SDT can be initiated, as specified in TS 38.321 [3]. Value byte32 corresponds to 32 bytes, value byte100 corresponds to 100 bytes, and so on.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"sdt-LogicalChannelSR-DelayTimer","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"The value of logicalChannelSR-DelayTimer applied during SDT for logical channels configured with SDT, as specified in TS 38.321 [3]. Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on. If sdt-LogicalChannelSR-DelayTimer-r18 is absent and sdt-LogicalChannelSR-DelayTimer-r17 is present then, the UE applies the value configured in sdt-LogicalChannelSR-DelayTimer-r17 for this field. If this field is not configured, then logicalChannelSR-DelayTimer is not applied for SDT logical channels.","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"sdt-RSRP-Threshold","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether SDT procedure can be initiated, as specified in TS 38.321 [3].","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"servingCellConfigCommon","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"Configuration of the serving cell.","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["a7134d363919408f9141b6c35b1197230f117e8b0f965f39e15f098db5294218","e8092f26c4ebb9586f1ca6d7298dfdcc97cfcfd9678cf19bbbe8cf4e47a2f009","bef22b77c860fd258e79778229493622c58bc8f0065dceada51294e703c14f52","17d3763ddb8a7ed2de2158314902e14521993eac2da213fe8c3b1e2c45336c86","11a7d448e167854fedcb332535acc0db8be99c730366701cca6dabd6143e7bc4","30914817d9c1439d43bc159cd73d9bbef867f6bea241f342fb0ce8063e626d0a","ff5037dc6759e55210c9258fa25bc53f474b0e680bf61fd66f1370cc4798c199","0c39a051f01fdb7fa45823772a9d00be6b1e484ba303f60869cba9f7a44f123a","1125d861990e36b5b7de03ec74a045420c878da72865b85409784778078f67cd","e33fe336869006e1d638b87533343b51e0406345de42c1a006f7423291c3dc61","b63c32a9d3cd083ef1ce67e6543ee1aa2da900a73c58147a0d347f3b0a835917","d06a1d1863fefac352e9ebaf7a0b1f9c905cdf9cfcdd1e01e80f6b7baafce624","ca9a97b4694e692ad25215d293b9f5e740e9d45e2ec2acc8b8482971ab78a0c2","0a6978e707d4c5f206a8af0ee9e4eebb2131693e5f22a3e0a5c1ae98408936fc","2b03cd6514fed8933c306c2c0ba34f33c92ef3ee74345facc59300605a9f02aa","7d0ff873c0297c098d19d2cb6ec2ffd23b4f519567cfcecffc7443b35a3dec07","13d19f141045c9800aa612bf52ca282dff7952e9622b2c5312c584d1f07c5463","a3381730b803beab0b775e1bac04491cb7f1b561f939ec798bc146a32da659ed","e7cd21c104ef946f7f1beefb3700ac92e7c6001ad8f8bb612876dcf06c8b3bd9","4e2fbab8048288b6876ab0362a0b21b5743d75e29e1754a81411b75b55d94f26","2a899edcf989ab730f35fc3a7b8fd8921d55eb4162b04553a7d946702a9baba2","9b00d08f0106a56daa568456b6a86424ad413686ea8949a80230c12dc768089e","1efd3a09880673495a7009e7e568402c85a5e56c1b14ff9b3eeb3f528589405a","8ef5a84c5f0cbbaf184a9fb88247ecdece03eb9bb35a01d65c5ac2736dcd97aa"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p336"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"t319a","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"Initial value of the timer T319a used for detection of SDT failure. Value ms100 corresponds to 100 milliseconds, value ms200 corresponds to 200 milliseconds and so on. If t319a-r18 is absent, the UE applies the value configured in t319a-r17.","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"uac-AccessCategory1-SelectionAssistanceInfo","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. If plmnCommon is chosen, the UAC-AccessCategory1-SelectionAssistanceInfo is applicable to all the PLMNs and SNPNs in plmn-IdentityInfoList and npn-IdentityInfoList. If individualPLMNList is chosen, the 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. If uac-AC1-SelectAssistInfo-r16 is present, the UE shall ignore the uac-AccessCategory1-SelectionAssistanceInfo.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"uac-AC1-SelectAssistInfo","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. The 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. Value notConfigured indicates that Access Category1 is not configured for the corresponding PLMN/SNPN.","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"uac-BarringForCommon","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"Common access control parameters for each access category. Common values are used for all PLMNs/SNPNs, unless overwritten by the PLMN/SNPN specific configuration provided in uac-BarringPerPLMN-List. The parameters are specified by providing an index to the set of configurations (uac-BarringInfoSetList). UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"ue-TimersAndConstants","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"Timer and constant values to be used by the UE. The cell operating as PCell always provides this field.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"useFullResumeID","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"Indicates which resume identifier and Resume request message should be used. UE uses fullI-RNTI and RRCResumeRequest1 if the field is present, or shortI-RNTI and RRCResumeRequest if the field is absent.","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"EDRX-RC","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that enables eDRX-AllowedIdle, otherwise it is absent.","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"EREDCAP-Barring","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that supports eRedCap UE,  otherwise it is absent.","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"MINT","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that provides a configuration for disaster roaming, otherwise it is absent, Need R.","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"MT-SDT1","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["445b4782d87d4067a3beae122135e4741d7ce8461f327978c09baed678b4ac0b","33e0ca5e0ec9202ab25e37ab54664eb5aad555e2db61564dcfac743c1694d226","04efa986c95dad7c8ff3cfdcdaf823d99e253e36a386dd25fed0fbd975dec192","f4e23d9d8aa14f6e459e1385602f65074a9fdc45e36d2220aebfe02be7cf4aeb","0c10688c035e23f53b3db68d082498312ec1878ddbf1b5cb478fa2befe5f5907","8d9ca130f91d2b70eb4562f5b4d28ca2afb7e5f53a0f0da217687383342ef239","6493c202a4621e7f47446331af5df7451154a950bf7a46600d1a31f6097ac439","b2370961911dbbaba46ca2ae82e064bf963354770e94bdef67401c04809535a1","c87ffaff5e219c4735fc8723b652d329aff25ae9ef1658125e981940c0328830","26e7e087f938a010e074b8c9c37bc31821cdc314dfdd470ec2bc12d1d37cfb21","6c4a3aea2ed1aca35766ce8c7bb6293766e8b41a62e5dcca8477072fc5a67c2f","eebb5e88f2c8c0015ec3b84207c8c8c11a0445f3873ecdbf06bd91e8b1cce1b0","2d460f260ad00453a15b8d80160c835d946916335ca889076b62e31a3c496403","6170bfcdbfcbb569f423b4518a06bda4f40923a111c1d3ef789d59b73abb56f1","a1edaa880b9b3167eac5afc622c2bab70f41156fd77f1d1e86e098d745acede2","18b0c84090817b9196f4979f18ceb0a92f3011df7c53324c0bebeb679100f844","e6bb4b740a0de0894d0f6bb244974507b483ffa63682e3fd2518f1e57c1b