{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-EPC indicates cell access related information for an LTE cell connected to EPC.","paragraph_zero_based":19272},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC information element","paragraph_zero_based":19273},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19274},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-START","paragraph_zero_based":19275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19276},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-EPC  ::=    SEQUENCE {","paragraph_zero_based":19277},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList-eutra-epc             PLMN-IdentityList-EUTRA-EPC,","paragraph_zero_based":19278},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-epc              BIT STRING (SIZE (16)),","paragraph_zero_based":19279},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-epc                  BIT STRING (SIZE (28))","paragraph_zero_based":19280},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19281},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19282},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList-EUTRA-EPC::=          SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity","paragraph_zero_based":19283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19284},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-EPC-STOP","paragraph_zero_based":19285},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19287},{"literal_text_all_w_t_and_m_t":"–CellDTXDRX-Config","paragraph_zero_based":19288},{"literal_text_all_w_t_and_m_t":"The IE CellDTXDRX-Config is used to configure cell DTX/