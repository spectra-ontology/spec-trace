{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36672},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":36673},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":36674},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":36675},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent ZP-CSI-RS-Resources (as indicated in PDSCH-Config). The field is absent otherwise.","paragraph_zero_based":36676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36677},{"literal_text_all_w_t_and_m_t":"–ZP-CSI-RS-ResourceSet","paragraph_zero_based":36678},{"literal_text_all_w_t_and_m_t":"The IE ZP-CSI-RS-ResourceSet refers to a set of ZP-CSI-RS-Resources using their ZP-CSI-RS-ResourceIds.","paragraph_zero_based":36679},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet information element","paragraph_zero_based":36680},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36681},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":36682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36683},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet ::=           SEQUENCE {","paragraph_zero_based":36684},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceSetId             ZP-CSI-RS-ResourceSetId,","paragraph_zero_based":36685},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceIdList            SEQUENCE (SIZE(1..maxNrofZP-CSI-RS-ResourcesPerSet)) OF ZP-CSI-RS-ResourceId,","paragraph_zero_based":36686},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36687},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36689},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCESET-STOP","paragraph_zero_based":36690},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36692},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceSet field descriptions","paragraph_zero_based":36693},{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceIdList","paragraph_zero_based":36694},{"literal_text_all_w_t_and_m_t":"The list of ZP-CSI-RS-ResourceId identifying the ZP-CSI-RS-Resource elements belonging to this set.","paragraph_zero_based":36695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d39a25d06f041852ea8519626d1c2e735cbfd70a60cd2cfb8832c8f99b894898","dfe02c78edc26e5f376f81b093b936b3e976e6a43d58ee40cb301b5312dd3ad5","1d2b294ee5dd38b3358b6fdb010d4a9297a3a4fb041ccd962a7d126517ecf3f5","77482b2f58f86337bd49b759e8e0a64be42afbe9b41e904987490cab64340a59","d9e7b622cdd036dfbbaaad52dedca452a01a39d9a33b218dbae9b0625c905751","1dafd411ab273cbd3f9506861ef496a148bf1bc9ff8f2f8e8a8498dd595fe0cb","3d40aff71e17e5c55580c394349713ccc72c4d0eaa373e40dccd5f938775a9c7","01cd8166f46b136329f6a34b2e85f5a35ce8f528345b63e6b68881a5b8db84cc","70f332c5817a252b1ed83630e330ddf8277b3f195d7df52803525479b6ee053f","8884b12c6a6d065e59e7b7f2d98712d4355213a8f81f3d012984af5396b84644","6a757e3b34546cb013c21fa2fd8dcf4729bd877b339169e93438863c4f096d8f","c4a8e59cd06e39deec522627a776fad1aa92de315842ab5aee684bd7abdb7a8b","cd7fe097584aa0c28efaaaae5613e8eaccc5973c8d5d23537915c8857be00458","165a952826bbd87fb437c01eff64142da6345016d46a0cfcc6a186effb13189a","b60cc6f50c0cadcc964542fdbd8c0505e845d87d3e2fc778d25e86d6dfaac714","8d13ce683757f26a3dbdcc5553a25ab221c42ebf83