iteral_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":29942},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29943},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationForSlicing-r17         RA-PrioritizationForSlicing-r17                          OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":29944},{"literal_text_all_w_t_and_m_t":"    featureCombinationPreamblesList-r17     SEQUENCE (SIZE(1..maxFeatureCombPreamblesPerRACHResource-r17)) OF FeatureCombinationPreambles-r17 OPTIONAL -- Cond AdditionalRACH","paragraph_zero_based":29945},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29946},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29947},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29948},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMON-STOP","paragraph_zero_based":29949},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e38e9de5f71ea7fcfb1999bcc565180e234cc90e77395645ba8a011956c69db9","fc203f5b7ee2dceeef54fa78fc4d6795f01441e2bf38bdcd01afa4f47328ac28","12cff7625a86e51185f55bb2b1c3c1aca87f9f0e1be527051351d6bff38086ef","384c2c18b94e96e36b527dd53eb96af5ff63db246e95242f27f28f5934cc53b5","7532ba6189b3d6ad94f7be110205d3f2c18d3d23018e094dd708a8611e6be068","30e6482555844f5c9b0cce6c408a500af83c6ac51e6c921cc1475468243e6dbd","863807245636d6cf6160d1ca399b868c6c44061b69ff8c59b43b87ced565bb3f","b3ce94bf401b5b1cefd7e93bedb94b311235e104ff623133bda9e1d48ec672db","6b09f61f15e9df8eb927885e8951773bbe7ae1381e3ebe2d9bfef8aadcdd19b7","7afcead1fd604956298e564836f3c38b205d69483b8b6b8b4fadad2cc277e71c","d82bd9f68dcba73a95a94ad82accfee870493f8defffeffea8e319163e7d8032","4528d35fbf365aeaa437b48029138c929cd661ef8008e1352b3a3e0ce9e8fb3b","89c37433089d6c7de411cb97f963602483990af5ddca95874bcaf3cf65a94548","941eaa02d7a666b22c94f90f035e66cce15c9713d0476d4a1614c79d005d4c9a","8ae448d77712131ec41f9f9a4c993d479ee8f927f92642c02754a969278e336c","dbf5b1ea4feda8644dffe12f383b5d4258d431ac76ebb52e66155271a9504857","6a03bc1f63d7a5a98185e04f49d714bfdcd60cfdd656d24ea134ee11ef0fa422","1a97090e1357dc0db1a68aaf56af65d0e496466f3625bcea3a0c86370d2bcc24","ca88620e60d9445be54faaf8b95f7aa2de50964195e384c6ed12fc702864a70d","764900266b2806f38595574203fb031eb6adb4d2c988388cd0ac0027c914d6f9","5ed742cde6c00bec7d56e9ca8ad0e4b718a51272cefd18582ac519524cca52e6","42a1213681139544a1ab30741a7597aff534ae34087fe2dea5b31bc6ede8385f","3873702de4ea98135ce03e8949b4a136b2574a8db75c7926e200a7f4cacd0c3a","fe39678039cf5a31a304a9b68829c9cc13c9ff84a51ae207881739babcdd03a9"],"paragraph_range_zero_based":[29928,29951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29928"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommon field descriptions","paragraph_zero_based":29952},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":29953},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 4-step RA. The network does not configure this list to have more than 32 entries.","paragraph_zero_based":29954},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":29955},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on (see TS 38.321 [3], clause 5.1.2). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":29956},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":29957},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":29958},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":29959},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":29960},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":29961},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":29962},{"literal_text_all_w_t_and_m_t":"If absent, the UE applies the SCS as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]). The value also applies to contention free random access (RACH-ConfigDedicated), to SI-request and to contention-based beam failure recovery (CB-BFR). But it does not apply for contention free beam failure recovery (CF-BFR) (see BeamFailureRecoveryConfig).","paragraph_zero_based":29963},{"literal_text_all_w_t_and_m_t":"msg3-transformPrecoder","paragraph_zero_based":29964},{"literal_text_all_w_t_and_m_t":"Enables the transform precoder for Msg3 transmission according to clause 6.1.3 of TS 38.214 [19]. If the field is absent, the UE disables the transformer precoder (see TS 38.213 [13], clause 8.3).","paragraph_zero_based":29965},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":29966},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A. This determines implicitly the number of CB preambles per SSB available in group B. (see TS 38.321 [3], clause 5.1.1). The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB.","paragraph_zero_based":29967},{"literal_text_all_w_t_and_m_t":"prach-RootSequenceIndex","paragraph_zero_based":29968},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1). The value range depends on whether L=839 or L=139 or L=571 or L=1151. The length of the root sequence corresponding with the index indicated in this IE should be consistent with the one indicated in prach-ConfigurationIndex in the RACH-ConfigDedicated (if configured). If prach-RootSequenceIndex-r16 is signalled, UE shall ignore the prach-RootSequenceIndex (without suffix).","paragraph_zero_based":29969},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":29970},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":29971},{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":29972},{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":29973},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":29974},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on.","paragraph_zero_based":29975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f076e91ba5ebb0b000e8472f9bfb24c7d588c719b2e8f761632e3a31c8eddd0f","b7dd5c5c4ba55f1f658783f4c0d10d055e4cdbecdd92e5fdc7a883f08213d733","83c4da36d218231eca10497b7e6b0d8a30a9399359a498e7e0529da8819bdf56","4d2b0bfdcbe9895289514df39ecf07df4720e082fb013a401d16520e5b442ab1","2acd8604e7a78784f52cf367bb9249de54635cd099abe585313d1487167e2b77","bcc5e27058727e035475766d1866b7fd7350ed5fb6f59196b0b54219035cd5d6","68a9ac65d6317a01d95cd5744b693d1b9355c78b16bca2d84167626c75af728e","f302af40c0105c6a0acb4027cd43971c500d78dbaf9a34371330e978e6c570d8","49ed695ee298dde6b4a804e27d22e91ad558cfa43677cf79d89b3a559e509637","aa627377ed74166ce754cc2f04b6e00332e04e81b17338bdeb5ff4e769b81675","f3089156c557c4994df46659a8c1ff9ec985494789591b69fe22168a102bad4b","b018c43c7ae2bfdee40a1cc556862f6967dc31696646639331445b59dfebfcac","432dc6c5e8fa9b18b7d00997757acaeb361b03b611a034b3785f2299c49fe0cf","fc49924343f76e3c51d21909dc4155ff8f4561362b40275bdd86af070fbc0eb1","13d7c6b28feffe0f23bb6765b7cea9cb394d09136b3548a63ed3e8fa807d32b7","6c13598705aea346c449e6c1cbba1ba414d7ca987ea846ce4c5c94e722203068","38b5e2831c24fee762ee38efe7ef90dca64e5094148ab8f0d55e2f2892412f16","c40aaf44abed7575817b313b65dcd176916acf9bbc565db65461c50f3830c1d8","99c1c545f39a86d1bf923ce8e62ed6d994e6ebcd619cac2fc860fe33908b1d16","4e3b02b82a5fc579cbea891c8b1cf7d2d1e474e8a67bd6f31d20cee555cad8f1","d478c22622505b6184df2b017ab11378e0bf10eee01752bbdf72037e0e17c224","6cc1ad1f137fa48cdc2f6664e76d0a011d242d6c2efeaa669b88a294a23e7ce8","bb336b567e812b63754a5b3a3d02f3a167f5017eda83870e1a686829fbba80db","370d2509f83f1eac53a835fad38a075e647ae9f1781d9ae27ddff55b3aa76734"],"paragraph_range_zero_based":[29952,29975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29952"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-Msg3SizeGroupA","paragraph_zero_based":29976},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A (see TS 38.321 [3], clause 5.1.2). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":29977},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":29978},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":29979},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":29980},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 indicates that the field ra-Prioritization-r16 applies otherwise the field does not apply (see TS 23.501 [32]).","paragraph_zero_based":29981},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicing","paragraph_zero_based":29982},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 4-step random access type for slicing.","paragraph_zero_based":29983},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":29984},{"literal_text_all_w_t_and_m_t":"RACH parameters for both regular random access and beam failure recovery.","paragraph_zero_based":29985},{"literal_text_all_w_t_and_m_t":"restrictedSetConfig","paragraph_zero_based":29986},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets, see TS 38.211 [16], clause 6.3.3.1.","paragraph_zero_based":29987},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":29988},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":29989},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB-SUL","paragraph_zero_based":29990},{"literal_text_all_w_t_and_m_t":"The UE selects SUL carrier to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). The value applies to all the BWPs and all RACH configurations.","paragraph_zero_based":29991},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":29992},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEighth corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). See TS 38.213 [13].","paragraph_zero_based":29993},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":29994},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention based and contention free 4-step or 2-step random access in the RACH resources defined in RACH-ConfigCommon, excluding preambles used for other purposes (e.g. for SI request). If the field is absent, all 64 preambles are available for RA. The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":29995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29996},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29997},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29998},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":29999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["49cb0c8f7c685b9805fd8cfd4e53521bd560ed5b07d71cdcae77dae5b7ec245f","a4f75319593d52bcdabdd2e15eb18c2fa5108b748158666b83ba2fdc5402fadd","dd0c481c73e2389acba27a0abaca0a1eaa95a465e4a50c16cba4454d7ccf19de","c5f0219c138b0966b2acef67bf3414f9917152a768f3c59fa37b8d95a2254599","8348f431002e5d5c9ab568f6a9ec5dcd24328ed0fa86b77561193ba996f45925","2751ee98b80e30d8324bae88db09444c04736e0b3b306d297f3cd4b990874d49","ae1a5ed58f3a0c400f619e6b97f8de7be7126326723bfc5d66357ef524baab58","088adc54fbbc997a7d1ea89f7ab6f4b44f60346cb4fbbb8897bd0c2ccb000094","34d4c753c4fe901c599d598f2dec539532b052ff890034bf12c8f0dba3cdbfa8","db3735ac5aab2a997f4257e2850777e2a3b7b4d5a1665f8dd22acbbfb2b99940","0c391af8df658125df61885cb655eb326115169e881340ee0e8acfbb984464bd","c1c411e6c1f1145061dbbc3493b338d3c3d5cf7987cd33f604adf9ffa28e3ffb","65ae8c218bbec823be9b1aa6ceba5e44c9951be3d082c8bd64f6a2eace15d906","b9fb08044440b46ca22a0a7de848a67a476cd9b8cbddf76f44562fe0260f97b8","93d2486c092a60ffd1cd723bba2443b6bbf3ab95953ec959c54cb3d2d40b7b38","d88d00f05944217d5f68788c2c40a938c9512ae44d3a8549cd3af93d09785796","1b8f4356a6557fe84bdf1eaadebfc02e53b1ef7d6b05ccbaed3634a095279b81","ed0f4c1aaa603797e904b13e1b21283c0b0fffc6f5df8f05b1f0e35087be84d7","0a5095d9ffc58e48db230be02c9fa302ccf52e2084e8f3cc78000e2c367ffe3e","7ec5f727b778d80cdafa748d6912011b3d7608914692c8878d1a73b5310feba2","0dbb16cdd2d1e28bcdcccf9550bd3f63e9922bb73cb9d66cb300f2e60ccfb9cd","09a156b2f0b0f1e14bb61a35e2d262946af55cd97e8e3063af0a47a74ca85be0","a48ca53aa22df098375a71ff539ce6940d14264616621f7801f39cc5a6f6acb3","4ba5241c12a420fc1ef7201668c0fe030cfafc3995a896827f8ce5625c4aefcf"],"paragraph_range_zero_based":[29976,29999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29976"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the RACH-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap and eRedCap, this field is mandatory present with at least FeatureCombinationPreambles list entries: the list entry/entries indicating only redcap or eRedCap and the other(s) indicating both redcap or eRedCap and one or multiple other feature(s) (e.g., smallData, nsag or msg3-Repetitions).","paragraph_zero_based":30000},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":30001},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":30002},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":30003},{"literal_text_all_w_t_and_m_t":"L139","paragraph_zero_based":30004},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if prach-RootSequenceIndex L=139, otherwise the field is absent, Need S.","paragraph_zero_based":30005},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":30006},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in rach-ConfigCommon in initialUplinkBWP if supplementaryUplink is configured in ServingCellConfigCommonSIB or if supplementaryUplinkConfig is configured in ServingCellConfigCommon; otherwise, the field is absent. This field is not configured in additionalRACH-Config.","paragraph_zero_based":30007},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30008},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigCommonTwoStepRA","paragraph_zero_based":30009},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigCommonTwoStepRA is used to specify cell specific 2-step random-access type parameters.","paragraph_zero_based":30010},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA information element","paragraph_zero_based":30011},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30012},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-START","paragraph_zero_based":30013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30014},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA-r16 ::=                   SEQUENCE {","paragraph_zero_based":30015},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGenericTwoStepRA-r16                      RACH-ConfigGenericTwoStepRA-r16,","paragraph_zero_based":30016},{"literal_text_all_w_t_and_m_t":"    msgA-TotalNumberOfRA-Preambles-r16                   INTEGER (1..63)                                    OPTIONAL, -- Need S","paragraph_zero_based":30017},{"literal_text_all_w_t_and_m_t":"    msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB-r16   CHOICE {","paragraph_zero_based":30018},{"literal_text_all_w_t_and_m_t":"        oneEighth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30019},{"literal_text_all_w_t_and_m_t":"        oneFourth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30020},{"literal_text_all_w_t_and_m_t":"        oneHalf                                              ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30021},{"literal_text_all_w_t_and_m_t":"        one                                                  ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30022},{"literal_text_all_w_t_and_m_t":"        two                                                  ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32},","paragraph_zero_based":30023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["281ad09b7a950bbb416411f84c292d81ce52e12fbfb540fdbec2b057f685fb19","7c9f09322ee15e2d305bf3fff8f47177a4ab402735105295e10449300e8d1975","37fd0c267375f1d8cda26062d43dfd7ee7174cc9cdf3c3b0c0ba10b4d24663f4","9fd8e89f109d098b3f84abdc634f4bcc4736491bf86bbb38b4a8db985fa233dc","06d334ea6f60aeece84637b8f6fb3bfb4798c2e85e671fdc4c6cf1077d430efe","120a052e7c723615c375535de7de58bcfac1e228087e172c175ea9820da97ebb","0420374b6a11b3b7aeabf03b7ab57bc52e770986d5e500355f5c1cd24f1918a4","3f7fd7ebae5dec5f5e32d522585a4113330e92c8e01b222b2f63899c824c003a","5bc34b02ed14ace282e303e6541dd8883c84b4161bffe5a9ff52a0e9bb4e7d03","db17c377cfb89a04a103893dffc30acf0ce45d445f92325727be0af29bf12847","6b75971c3c716ddbb3c93651fef9ffb45ded626759e8edbda5686e9e299b1130","10b462de547fe42466f02228baffabd2b5661b635e785ec51776d2fc4a15efdb","f119adb20371afdd019ccca75dbe0fd53bfe89c576f7afacf64bc1405089beb3","6c5a597b8d8bd06cd5814817368dbf3198226715d443da278efde2eafac186a4","ede058c42a022625cffc3170bda330517d6c87a69b54213d12ad428602d664c1","ed1da6d56d4dd5fbea01760c3bcf52e24e4317ed65740aeff7d95079b23492bd","794ab07bd9e742c1cf538561422e40712834b488fdf0dd78567115f2cdbda4c5","01e8aaa5cb2009422fd2f2da661de3a84e06b853fd39a032ff1f84ba5a4ea266","01d9802f28bd1983214e2a08ad946676877848d06f8a8848042bda65d3234886","b5a425f214d6aac535bb7e44e75982fe7624d46c4d788877d7397678f747e3cf","f9b4dd60e128cec39ef4969b25da442c089a7f58f6cec48f7aa1c2024661e8f3","84b4a71d9a3ab04c2e6d79107a1750aa263e5e511d4c86ad1ab540b1c6ab4327","baab78aaa3b81282ddd1e0e611cc77893a1403984bf9207dd8ff52e192e2bf09","688d7fcd5ff0d36163b47950461765a6038ab89da264138f04c2a93460a5b47b"],"paragraph_range_zero_based":[30000,30023],"projection":"All w:t 