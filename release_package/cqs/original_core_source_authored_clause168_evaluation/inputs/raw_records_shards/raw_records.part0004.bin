{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6384},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition H1-1, as specified below, is fulfilled;","paragraph_zero_based":6385},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition H1-2, as specified below, is fulfilled;","paragraph_zero_based":6386},{"literal_text_all_w_t_and_m_t":"Inequality H1-1 (Entering condition)","paragraph_zero_based":6387},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":6388},{"literal_text_all_w_t_and_m_t":"Inequality H1-2 (Leaving condition)","paragraph_zero_based":6389},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":6390},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6391},{"literal_text_all_w_t_and_m_t":"Ms is the Aerial UE altitude relative to the sea level.","paragraph_zero_based":6392},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. h1-Hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":6393},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. h1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":6394},{"literal_text_all_w_t_and_m_t":"Ms, Hys, Thresh are expressed in meters.","paragraph_zero_based":6395},{"literal_text_all_w_t_and_m_t":"5.5.4.22Event H2 (The Aerial UE altitude becomes lower than a threshold)","paragraph_zero_based":6396},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6397},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition H2-1, as specified below, is fulfilled;","paragraph_zero_based":6398},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition H2-2, as specified below, is fulfilled;","paragraph_zero_based":6399},{"literal_text_all_w_t_and_m_t":"Inequality H2-1 (Entering condition)","paragraph_zero_based":6400},{"literal_text_all_w_t_and_m_t":"Ms + Hys < Thresh","paragraph_zero_based":6401},{"literal_text_all_w_t_and_m_t":"Inequality H2-2 (Leaving condition)","paragraph_zero_based":6402},{"literal_text_all_w_t_and_m_t":"Ms – Hys > Thresh","paragraph_zero_based":6403},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6404},{"literal_text_all_w_t_and_m_t":"Ms is the Aerial UE altitude relative to the sea level.","paragraph_zero_based":6405},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. h2-Hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":6406},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. h2-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":6407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8042ae2f9964027ceb6a5451881c0d0cfce309f602abd904d43db5fa241e7f04","3f19c3a2d0c87e14de725c3857ff273712f8d69fb9e4672b7304bf923f8231d6","24a752e0f865cfc8d82967e04d4178c569f6ec3f93ba56c2bb1e40ac5b61d14e","f4142b469fe270ffa94aeb1f5f5ea17a1649511a3bdc1f9afbb024a33d4ffadc","2dfac038fd7b1c5cf50cf0e61455c5eda6a2c99d37a685a526f7fb66717fd76d","980113981e58748bde1861455374ead9f3e58fcb1fab1857b59b91f1db687126","8bad020db46c0b6aa9de3bcdb399474