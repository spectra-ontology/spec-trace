{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31296},{"literal_text_all_w_t_and_m_t":"ReferenceLocation-r17 ::= OCTET STRING","paragraph_zero_based":31297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31298},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-STOP","paragraph_zero_based":31299},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31301},{"literal_text_all_w_t_and_m_t":"–ReferenceTimeInfo","paragraph_zero_based":31302},{"literal_text_all_w_t_and_m_t":"The IE ReferenceTimeInfo contains timing information for 5G internal system clock used for, e.g., time stamping, see TS 23.501 [32], clause 5.27.1.2.","paragraph_zero_based":31303},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo information element","paragraph_zero_based":31304},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31305},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-START","paragraph_zero_based":31306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31307},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo-r16 ::= SEQUENCE {","paragraph_zero_based":31308},{"literal_text_all_w_t_and_m_t":"    time-r16                            ReferenceTime-r16,","paragraph_zero_based":31309},{"literal_text_all_w_t_and_m_t":"    uncertainty-r16                     INTEGER (0..32767)          OPTIONAL,   -- Need S","paragraph_zero_based":31310},{"literal_text_all_w_t_and_m_t":"    timeInfoType-r16                    ENUMERATED {localClock}     OPTIONAL,   -- Need S","paragraph_zero_based":31311},{"literal_text_all_w_t_and_m_t":"    referenceSFN-r16                    INTEGER (0..1023)           OPTIONAL    -- Cond RefTime","paragraph_zero_based":31312},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31314},{"literal_text_all_w_t_and_m_t":"ReferenceTime-r16 ::=           SEQUENCE {","paragraph_zero_based":31315},{"literal_text_all_w_t_and_m_t":"    refDays-r16                         INTEGER (0..72999),","paragraph_zero_based":31316},{"literal_text_all_w_t_and_m_t":"    refSeconds-r16                      INTEGER (0..86399),","paragraph_zero_based":31317},{"literal_text_all_w_t_and_m_t":"    refMilliSeconds-r16                 INTEGER (0..999),","paragraph_zero_based":31318},{"literal_text_all_w_t_and_m_t":"    refTenNanoSeconds-r16               INTEGER (0..99999)","paragraph_zero_based":31319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c8c5e13ebbc4fa9af7f8e06bb231863609b780f67bd2e1622b566f0d3f5c098f","1ff5f04ac48679ef5510531a9796954d9ed2ba15b7c7ac07aaaaf84e4359d51e","5467688d85d0ded8ff859f9915d06bc00f09fb5f39fdad5a4747400518b45332","2b33958540865d90efeda41b23aa316fb2efe88540efe6bfd7fbe0e064ba5b48","9e3a06ec1a061103156771453aaffb7bf086389b82cb3ce9eeb6db5b38d32d71","28f3ef80364a3c7c0ffef87a460908749126fad4745aaa0c0e4f06f4a44322b4","227e4fa016cdf9a0b4f8edb801cb61440053a6161b9334984989c71080a73027","44b23a1dd9353f9a995103d9f4dc6d944079293b0336c1effb81ec1d6be2e56a","d30ccc962c37bf670ca5dc3b34ddd70a11380bc02c3ac62805f769c1fa3b9ffb","fcfb10086a379eba59e1b45f723801b2a5df8da41c96cb5db13127b7d3c0f0da","c970b2ac7cbb950318c7a04e818ac28e0f8984249abae000d7d0f189986ce985","1b890290caa24c48faa59911466545fb6efd3dea7d941d504e8405300b9fe131","8811544dc808135ca681e7be7df8df89912ca2d0165898a1098a289644fe9cd8","f0afb12bde6431aae95dd7b7c0bba9c8aedd0014dbc0ff2508bcf4654c7469cd","6f64ecb5ca28aaba31c4ed2f401e8df9e1c6c0249a4622ae1213a8d65f30c553","7c4b3f9fa66fb3e492f575dbcaa9da42368e051b7a8c77754d725ec8ba47288e","d8e36cacdeead72199c40d67f69c33c195e7524f516e3e5924e0c5f62e32c396","ed950bb01ed3fc9c195cffda04bd9035b4f6c838df6a27f062d36ef3efee4477","08e8455a0cb531c08a1890a3a74e1dc710cc98f24163bc1e9452312def08e8bd","3dc1fd52312317ff8b20528c35bd710ab5003f8fd4521b62a62fb0b6787a0fe8","3c6e7b9a7f1009449e1e8f1a0a40c593a60ff117876d4dc7ac758236c33905ee","cecffef4ac830081509faedd1f92ef9deb00f7b6150d0a90da36dc17e04f0f59","0a9c4a55e8059ed71ce28fe55e66626fdabe04abc6d0e747d8cad054f6e81c87","801131037d528ce2ced4057c1772bd3b8b3f4a2ee37f07acf1904d7b0b32cbae"],"paragraph_range_zero_based":[31296,31319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p31296"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31321},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-STOP","paragraph_zero_based":31322},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31323},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31324},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo field descriptions","paragraph_zero_based":31325},{"literal_text_all_w_t_and_m_t":"referenceSFN","paragraph_zero_based":31326},{"literal_text_all_w_t_and_m_t":"This field indicates the reference SFN corresponding to the reference time information. If referenceTimeInfo field is received in DLInformationTransfer message, this field indicates the SFN of PCell.","paragraph_zero_based":31327},{"literal_text_all_w_t_and_m_t":"time","paragraph_zero_based":31328},{"literal_text_all_w_t_and_m_t":"This field indicates time reference with 10ns granularity. If included in DLInformationTransfer and if UE-side TA PDC is de-activated, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. If included in DLInformationTransfer and if UE is requested to transmit UE Rx-Tx time difference measurement, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. Otherwise, the indicated time is referenced at the network, i.e., without compensating for RF propagation delay. In an NTN cell, the indicated time is referenced at the uplink time synchronization reference point (RP), i.e., UE should take into account the propagation delay between UE and RP when determining the UTC time at the UE.","paragraph_zero_based":31329},{"literal_text_all_w_t_and_m_t":"The indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from the origin of the time field.","paragraph_zero_based":31330},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in DLInformationTransfer message, the time field indicates the time at the ending boundary of the system frame indicated by referenceSFN. The UE considers this frame (indicated by referenceSFN) to be the frame which is nearest to the frame where the message is received (which can be either in the past or in the future).","paragraph_zero_based":31331},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in SIB9, the time field indicates the time at the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted.","paragraph_zero_based":31332},{"literal_text_all_w_t_and_m_t":"If referenceTimeInfo field is received in SIB9, this field is excluded when determining changes in system information, i.e. changes of time should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":31333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31334},{"literal_text_all_w_t_and_m_t":"NOTE:The estimated time in an NTN-cell may be less accurate than the estimated time in a TN-cell.","paragraph_zero_based":31335},{"literal_text_all_w_t_and_m_t":"timeInfoType","paragraph_zero_based":31336},{"literal_text_all_w_t_and_m_t":"If timeInfoType is not included, the time indicates the GPS time and the origin of the time field is 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time). If timeInfoType is set to localClock, the origin of the time is unspecified.","paragraph_zero_based":31337},{"literal_text_all_w_t_and_m_t":"uncertainty","paragraph_zero_based":31338},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty of the reference time information provided by the time field. The uncertainty is 25ns multiplied by this field. If this field is absent, the uncertainty is unspecified.","paragraph_zero_based":31339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31340},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":31341},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":31342},{"literal_text_all_w_t_and_m_t":"RefTime","paragraph_zero_based":31343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be32d2ab0bce0980be0855d020474d0eade0625780d187bbf348bb152f5bed93","6d853e67d6dfc91e53d4ca78ab271dc3aeaaf725e68ed5e373fbad8fc8da325f","8402d6d4f7afeb2add388b8f599abffba28c12f2677f0a22e159235653660693","d15e8809a32c1207f5e1d35ed677f59c68a4ad3f4451b3c56c4e455ca46a1014","92e229e59caac6931e764f812fa072ffdb30c090d71f46357f4f12d66af863c6","62f8c9d03430906013554a07a1ad9b6bf48aeada151f5a203332e81c56f81e30","b4485fe6e45f70ecee6ec20ce00f78459a7580fb135fb2b97c7b33dfe14947eb","02a7969b36ed9faa30f9bf0f57c8ff07bd9530bf117615649b64e876449f8363","d2b5fecb425bdd1cc5dffe76e506027dd681b785de72626465ac2cb66de72b20","9eaf86872d79dee4010b9e2ccff433c985a26858c8d53708686c300399e726c7","68f88c38a4d3b0a15a475df0f61dd598385a0ce89dc98f80bbe4fa59a53d2308","8515310a03fe175ca4b09d8dfc097fa3015a4c7d0152d81e868b6b0376feb518","22e8d3ba87c0ca1ecbdc1a924f5792da4b3a4325a44659095d7090f17c31334b","bc4ca9cd2869d49dd545a091ee96fa35a3b026d6155b0a77a5011987bda3fbfa","86d1b28f04cd63bdbf9abb30aaa81f89599cad56b8e8faef6db22fbae3aff9d6","1dc6152c2b5abe613645f709704271d341dfe26a6000e40511c759110ae24884","d8f264ff4f1bc3a5e814c662bec955f2dd20160cc615c439cc7293a1ac9093a9","3a1b7b838462720162c73fc45ee15b1574420dac73a548bb4dab768a8b4487c9","98f8aafeee2a8cc18acb6a7069551af19f5ca0bcdb2a66c31db5d27559b53f7f","e55ebfe79a529f3a1201b10f1650f6d471e9ec655dbd42cedd0e766692887ad6","29370d52a7ad6675110e641d712bbf853c17f86de724912146902eadc3d8e680","f705842f72db563398a733c5c6798632610696d87f169b54a31bd01211c7933d","bdd33687b475b19f26ee1987e68990fbfd4430b15f4e209c46e67dd6ea6aee7d","31df88e9baa9d1a242e0d2758c51f041ca5da6077560ea48ae66a78fb74007c1"],"paragraph_range_zero_based":[31320,31343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p31320"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present if referenceTimeInfo is included in DLInformationTransfer message; otherwise the field is absent.","paragraph_zero_based":31344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31345},{"literal_text_all_w_t_and_m_t":"–RejectWaitTime","paragraph_zero_based":31346},{"literal_text_all_w_t_and_m_t":"The IE RejectWaitTime is used to provide the value in seconds for timer T302.","paragraph_zero_based":31347},{"literal_text_all_w_t_and_m_t":"RejectWaitTime information element","paragraph_zero_based":31348},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31349},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-START","paragraph_zero_based":31350},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31351},{"literal_text_all_w_t_and_m_t":"RejectWaitTime ::=                  INTEGER (1..16)","paragraph_zero_based":31352},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31353},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-STOP","paragraph_zero_based":31354},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31356},{"literal_text_all_w_t_and_m_t":"–RepetitionSchemeConfig","paragraph_zero_based":31357},{"literal_text_all_w_t_and_m_t":"The IE RepetitionSchemeConfig is used to configure the UE with repetition schemes as specified in TS 38.214 [19] clause 5.1.","paragraph_zero_based":31358},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig information element","paragraph_zero_based":31359},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31360},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-START","paragraph_zero_based":31361},{"literal_text_all_w_t_and_m_t":"","pa