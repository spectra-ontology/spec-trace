{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR information element","paragraph_zero_based":42792},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42793},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-START","paragraph_zero_based":42794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42795},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR ::=            SEQUENCE {","paragraph_zero_based":42796},{"literal_text_all_w_t_and_m_t":"    frequencyBandListFilter                     FreqBandList                          OPTIONAL,   -- Need N","paragraph_zero_based":42797},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1540    OPTIONAL","paragraph_zero_based":42798},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42799},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42800},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1540 ::=      SEQUENCE {","paragraph_zero_based":42801},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingTimeRequest                    ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":42802},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UE-CapabilityRequestFilterNR-v1710    OPTIONAL","paragraph_zero_based":42803},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42805},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterNR-v1710 ::=      SEQUENCE {","paragraph_zero_based":42806},{"literal_text_all_w_t_and_m_t":"    sidelinkRequest-r17                         ENUMERATED {true}                     OPTIONAL,  -- Need N","paragraph_zero_based":42807},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        SEQUENCE {}                           OPTIONAL","paragraph_zero_based":42808},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42810},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERNR-STOP","paragraph_zero_based":42811},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42813},{"literal_text_all_w_t_and_m_t":"–UE-MRDC-Capability","paragraph_zero_based":42814},{"literal_text_all_w_t_and_m_t":"The IE UE-MRDC-Capability is used to convey the UE Radio Access Capability Parameters for MR-DC, see TS 38.306 [26].","paragraph_zero_based":42815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["25c2bf8b73ba740b96eb166f2cb383a5c3371d55c15cf352bfd5e3e60db53714","d9225352fba2cd22caff56ffa7ff953a91d747422573d6a9e42ad2abed25c12d","3fd713864d14a0ea14a8e96302130c064395fe32fabf6d01c3ac7343b6138618","3b997d564be006a00502a1c81661704ce9b86af352de9fa39b5eca8e3a05feb3","0c2f3ca263595d95982f67008ff6cac2d8d2088574a0b1e1e2708b76ccca3818","5e3328b9de03632d7eb866cc7d2a603260698b9770ba0a5379d23cb8b8425114","6369389198ad1964e4bdc6cdc8268a871d9c7edbf5c1903790f37637251e15f1","b6ac09c087819975c94ada70a868083c9d9eaf938ac16ce09859da808229f436","1f04d0afa8b1d68787f0b4a1782caee4793ddf5520f2183f856246894853cef6","870d851b589034debb523304acaa9dc92792b47aafb4a140336778429f375def","b8ca0d247a58177d6e2388588e11dac511013334fd39bac1f3f275472a2e8bb9","64e93e12b2aae0f9aa1b221f74cfcd11e22ec601371ca0da1b90f5c5d0561e30","d12220868190d40db7905c83f56c7c4f5cdd98ddd2c9f287726fb3bc01c1197b","7c55b392299