{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfig contains configuration for Msg1 based SI request without Msg1 repetition.","paragraph_zero_based":33696},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig information element","paragraph_zero_based":33697},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33698},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-START","paragraph_zero_based":33699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33700},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig ::=                SEQUENCE {","paragraph_zero_based":33701},{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI                    SEQUENCE {","paragraph_zero_based":33702},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI                       RACH-ConfigGeneric,","paragraph_zero_based":33703},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":33704},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":33705},{"literal_text_all_w_t_and_m_t":"    si-RequestPeriod                    ENUMERATED {one, two, four, six, eight, ten, twelve, sixteen}       OPTIONAL,   -- Need R","paragraph_zero_based":33706},{"literal_text_all_w_t_and_m_t":"    si-RequestResources                 SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResources","paragraph_zero_based":33707},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33708},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33709},{"literal_text_all_w_t_and_m_t":"SI-RequestResources ::=             SEQUENCE {","paragraph_zero_based":33710},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex               INTEGER (0..63),","paragraph_zero_based":33711},{"literal_text_all_w_t_and_m_t":"    ra-AssociationPeriodIndex           INTEGER (0..15)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":33712},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                     OPTIONAL    -- Need R","paragraph_zero_based":33713},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33715},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-STOP","paragraph_zero_based":33716},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33718},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig field descriptions","paragraph_zero_based":33719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e7134e14a980f011b445f34d76658199f63eabf4380041a3b4bc24b8d18e65fa","883ac5c1767aa4ec2eedb20f2b3b9f7fbee5be3f8307963a93ddbe7b136f4ebc","84b8d831cca871ff251b2e451cfb5c4da450df3b1cc7f714a0503cfd90ac4e20","98779e8121c2dc69f87371ca9568e530bedc87cb8af5c1688d15ab9546818cea","c2fc1cc760de6f25485b01bac827975bf80af3c5187ddca19de75bb1894315c7","39b716ed16fe74cdcea5b3703050cdd06f91c8c4c69a683890676d1b0e9d55b4","0654b79557a1f827969e9f6d36196efd58d02a5024951ca6e96237265f58a255","5ef77add960ed2e83d2e2bdc1e2775b596f1e3263a86eda9c358be4d47dea91e","736ecbc3bad5525c062a6f54180b161de3b63dadc5cc213e814990b0be8d580f","93d5c6c10a5a06d568f03224973ca9d2a3fb6175c4fa641d60f9a5c1692a2a01","e351f449e65b68e66b88fab85ffc87479ddd9fd7d699f5796a4d47e58d6c7233","236b6d4e84708668e85b5ddc35c6f4d1158d63b8850a2815bba175dad3500fec","5b4c5be236f241c44390c2dd23d0a041c4fcbcde28b1f09590f07f063cde94d2","a3a5da2beeb572208a90812b082a28f8d610b09b46d3751ed1c369a23e56f7f6","2c02500aaf8e8c7ff8ebe3edd80834437c58cc5e1920ff49df2e6a93d3973589","83a54c144911d2698d6edfb9d20a8f64e28b2cb57cd26fb2d940951705c78b98","5a6be75d6b3fdd6bd9312900c0f2f0c7b729239438579ba9670127719e90ed97","8cfe06b130c78a99a6495da3e3ede90766c98c4127c1a72cd6f1ca9118283aa1","b845ab3f57cb25808ee117f42b97cb2c69665edcad553fe64963c8dc07b8d415","4383ad627a801729bfe894af69f7f85b9f9afa7f2cd712df8c45b9cd1d962c6f","c2c250325bd4eef881065b71c64fc5033858c1ed6979c63a5b129d59d3bb54a9","cb878e83f17ab16ef0b10fe22f626cd34d03f9c2926b8bb8b4317bd47d72c91b","7c0f7c84149b8cd4063142f82a2a6e84333efa18bcf48c5016ea147a8912ab9f","bffc9d139a43698ed7d7206ba49e4327e126e88fb886b38ea177b0771ef22673"],"paragraph_range_zero_based":[33696,33719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33696"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rach-OccasionsSI","paragraph_zero_based":33720},{"literal_text_all_w_t_and_m_t":"Configuration of dedicated RACH Occasions for SI. If the field is absent, the UE uses the corresponding parameters configured in rach-ConfigCommon of the initial uplink BWP.","paragraph_zero_based":33721},{"literal_text_all_w_t_and_m_t":"si-RequestPeriod","paragraph_zero_based":33722},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-Request configuration in number of association periods.","paragraph_zero_based":33723},{"literal_text_all_w_t_and_m_t":"si-RequestResources","paragraph_zero_based":33724},{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":33725},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfig is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33726},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33727},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":33728},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResources should not result in system information change notification.","paragraph_zero_based":33729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33730},{"literal_text_all_w_t_and_m_t":"SI-RequestResources field descriptions","paragraph_zero_based":33731},{"literal_text_all_w_t_and_m_t":"ra-AssociationPeriodIndex","paragraph_zero_based":33732},{"literal_text_all_w_t_and_m_t":"Index of the association period in the si-RequestPeriod in which the UE can send the SI request for SI message(s) corresponding to this SI-RequestResources, using the preambles indicated by ra-PreambleStartIndex and rach occasions indicated by ra-ssb-OccasionMaskIndex.","paragraph_zero_based":33733},{"literal_text_all_w_t_and_m_t":"ra-PreambleStartIndex","paragraph_zero_based":33734},{"literal_text_all_w_t_and_m_t":"If N SSBs are associated with a RACH occasion, where N > = 1, for the i-th SSB (i=0, …, N-1) the preamble with preamble index = ra-PreambleStartIndex + i is used for SI request; For N < 1, the preamble with preamble index = ra-PreambleStartIndex is used for SI request.","paragraph_zero_based":33735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33736},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfigRepetition","paragraph_zero_based":33737},{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfigRepetition contains configuration for Msg1 based SI request with Msg1 repetition.","paragraph_zero_based":33738},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition information element","paragraph_zero_based":33739},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33740},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIGREPETITION-START","paragraph_zero_based":33741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33742},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition-r18 ::=     SEQUENCE {","paragraph_zero_based":33743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b4fbfce9983dd6cb13945e4f170696763ffa7a74583ef0d309abf125ade56338","6d73649e64955cdb90d1fe66bc55babaeb183eeed55c428443035bdcd1b87986","b78ed203c285835570248085525d1f4d5696ef08de8c66439d352f4ab815cf9f","3c6e9a2e0bd98409c96db0071a4048b8091c16f02f8d542eb5332e2122f91119","bc570a6d01b989d001e00639548abb1ac6c7e7993409893d53fd5f93f6e75627","ce672baa3a5534a4f7d5bbaf4581f8b24d5746cb9f6a5c0c3f9f82881ba96b34","a050b2d21312e28338c5f879454e7131b903267952cd0c8bf0a3ba8e1649752a","1f3eac6265e783438fd6413c5420eb3ba9c04796a9cc500e9b0c8ad1f93df00e","c466910c1c1ca5c524870594b05fce14af95b0f61da7464b902f4fe210a46622","f223ec0ba1cf1a2d0834d464e148954163a3baeb092ee9969cc8a57bb1b1fc77","db37bc