3064f6f04aef297a0664a2b351737eb9c80e0d7ad7f6eef72","eb41e9a8f1c69e277bf18808b2f0597a9ecb0786406fb5e9d0df3f9417089219","91d3b76b66b033dca83a902f4581b2a30a18713da382b14f35df876678007eb2","de9a06d0e77a0b8601a09ce9c4ea292a087e5b0be5995cffe40c3c1e47746800","ed9ae658ff26cdc3566601c4cf1bf7fde978d3c4dcaf83c25baef10e10055fae","974fa938f55e38cae0007228d7f305003ea4a38243876c9d255ca30a23bec9ed","cd02071796470051603824798bf9ee49c3d4f82efe28c8792c257a0ad3c9fbad","af9a4fa6d08724e96f9e77ac25ec0e1c6f556fe96a9f00fa7db749f2f8185a95","41c346dad7ab679e73be140f080eb97da5e4f8f7e75c72e76c923c8d42340b87"],"paragraph_range_zero_based":[32832,32855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32832"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"periodUE","paragraph_zero_based":32856},{"literal_text_all_w_t_and_m_t":"Indicates the period of a channel occupancy that the UE can initiate as described in TS 37.213 [48], clause 4.3. Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":32857},{"literal_text_all_w_t_and_m_t":"offsetUE","paragraph_zero_based":32858},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols from the beginning of the even indexed radio frame to the start of the first period within that radio frame that the UE can initiate a channel occupancy (see TS 37.213 [48], clause 4.3), based on the smallest SCS among the configured SCSs in the serving cell. The offset duration indicated by this field is less than the period duration indicated by periodUE. The maximum value is 139, 279 and 559 for 15, 30 and 60 kHz subcarrier spacing, respectively.","paragraph_zero_based":32859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32860},{"literal_text_all_w_t_and_m_t":"–Sensor-LocationInfo","paragraph_zero_based":32861},{"literal_text_all_w_t_and_m_t":"The IE Sensor-LocationInfo is used by the UE to provide sensor information.","paragraph_zero_based":32862},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo information element","paragraph_zero_based":32863},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32864},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-START","paragraph_zero_based":32865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32866},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo-r16 ::= SEQUENCE {","paragraph_zero_based":32867},{"literal_text_all_w_t_and_m_t":"    sensor-MeasurementInformation-r16    OCTET STRING    OPTIONAL,","paragraph_zero_based":32868},{"literal_text_all_w_t_and_m_t":"    sensor-MotionInformation-r16         OCTET STRING    OPTIONAL,","paragraph_zero_based":32869},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32870},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32872},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORLOCATIONINFO-STOP","paragraph_zero_based":32873},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32874},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32875},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo field descriptions","paragraph_zero_based":32876},{"literal_text_all_w_t_and_m_t":"sensor-MeasurementInformation","paragraph_zero_based":32877},{"literal_text_all_w_t_and_m_t":"This field provides barometric pressure measurements as Sensor-MeasurementInformation defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":32878},{"literal_text_all_w_t_and_m_t":"sensor-MotionInformation","paragraph_zero_based":32879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7bf89c28d128bbd717664cc83e980c92803d9b9b12381ebe20e2816bf7727907","9d90d4301ed626cdb62c0f93b54be80021d3d3921be31becbd955382ccad22cd","b168a78938a07596f144c594213274a9ea0cc94d507f7b0bf4e9a2fa73d428f3","e857202ad3d24bf8f051cf7d72b266d57da258d8aca47d0e7568136fe18a1913","b36a7c3583932cc9d144d4032929db7d3b6de29dc9c0f9f6604da469562d6a9c","740b2438212e793925d31c79e389e210cc1fef8d71ecf39a7c778b7279896ba7","b4ef780a8b27f52ad7ee976acbab5d30fa1a6acb0ee3ae21a653b991a2908206","0e6632a15b27971221ae9b273374697ddca729c073596f3ad32d848a18636f7b","