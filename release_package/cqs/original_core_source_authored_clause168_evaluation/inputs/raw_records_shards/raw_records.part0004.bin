_all_w_t_and_m_t":"Release 15","paragraph_zero_based":54525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54526},{"literal_text_all_w_t_and_m_t":"RP-212598: Distinguishing support of extended band n77","paragraph_zero_based":54527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1159728cbe751d5f757d663de16b71455d56ff13704386272a556dd0439d5509","fb6e55baf48272467ee9bfb6ade96b56daed73575e89ec57dc7b889dda629589","bc581981c59a0373e1725795ed83f4a088c0053f24051d6c4f6438f7d51f4095","b91787b79302d44b88a57a9bfb1d6882ff51b75357397f29fa14e4330d1a59a7","e84995126600e8c409514029a4989d3c84f2872037098285481fab0a39eae111","f1e73058576c77f70312238d160cc8d001d07fdbbcceec1ac4b22ad22ab52726","d36e96586e5311f23287ec5e30b9cc3bc86254d164b9b04bdeb1caf5014a1fd0","279babd4a9c79990ea58d133e5e63b3bd1c14f479165b12ca5ef9af7c880b17c","2ffbdb9028a640d370d14bbe443f99b0fc71de63d6ddbdc8aa5a9e653478b8de","ebd4eb39f27e74a3d1ff45262233ee075abfca6ddbddae4b70668f2359138cde","2a21cb23eef31f6d293ffff94507b04796a9dd5557abbfdc38849b1cca98e252","5aaadf790e77080661fbfa58bbc20444297a2d5d191878ef9e3b5a02665cb3e6","12751e458e3cf6b4dfc312bf6c6008bece6aa163950e9a72ba451d01e3c9a48f","fc9d8e9e2166df9064985be71a2a98abd51309826bb469a00c7ff89d582c19a2","a29a5044503ec12d4066190a6aa63869fc8a31f7b730e399fc75327cc51917ce","d1a6a6c3f27d736e6ad6ef68fb4fbb972147138f1c557ce8a4745fcc73393fc7","a6c2b8c77585478112790c5d57761012ea6e9a2232fe3ede2712e1aafc9839ca","39aa00e04c70907898cf30638b5f5f8b355b96148537c5182ea89bf68da4f303","71989a1dc11b5155260b192be33a0001b1392eb6e986c659fea2856184e7a338","360e9a9099b48348714a274e105af83926385c4459d013be64a6da959f5ef89e","546396e934df25c6f3f762668d97e14326063d07348a95157025232e71b2a