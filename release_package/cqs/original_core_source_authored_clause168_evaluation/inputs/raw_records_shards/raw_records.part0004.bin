{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-U2U-RemoteUE-ToAddModList","paragraph_zero_based":47016},{"literal_text_all_w_t_and_m_t":"List of target L2 U2U Remote UEs for which the related configuration is to be added and modified to the L2 U2U Relay UE.","paragraph_zero_based":47017},{"literal_text_all_w_t_and_m_t":"sl-U2U-RemoteUE-ToReleaseList","paragraph_zero_based":47018},{"literal_text_all_w_t_and_m_t":"List of target L2 U2U Remote UEs for which the related configuration is to be released by the L2 U2U Relay UE.","paragraph_zero_based":47019},{"literal_text_all_w_t_and_m_t":"sl-U2U-SourceRemoteUE-ToAddModList","paragraph_zero_based":47020},{"literal_text_all_w_t_and_m_t":"List of Source L2 U2U Remote UEs for which the related configuration is to be added and modified relative to the destination L2 U2U Remote UE identified by the sl-L2IdentityRemoteUE.","paragraph_zero_based":47021},{"literal_text_all_w_t_and_m_t":"sl-U2U-SourceRemoteUE-ToReleaseList","paragraph_zero_based":47022},{"literal_text_all_w_t_and_m_t":"List of Source L2 U2U Remote UEs for which the related configuration is to be released relative to the destination L2 U2U Remote UE identified by the sl-L2IdentityRemoteUE.","paragraph_zero_based":47023},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47024},{"literal_text_all_w_t_and_m_t":"–SL-L2RemoteUE-Config","paragraph_zero_based":47025},{"literal_text_all_w_t_and_m_t":"The IE SL-L2RemoteUE-Config is used to configure L2 U2N relay operation related configurations used by L2 U2N Remote UE, or L2 U2U relay operation related configurations used by L2 U2U Remote UE.","paragraph_zero_based":47026},{"literal_text_all_w_t_and_m_t":"SL-L2RemoteUE-Config information element","paragraph_zero_based":47027},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47028},{"