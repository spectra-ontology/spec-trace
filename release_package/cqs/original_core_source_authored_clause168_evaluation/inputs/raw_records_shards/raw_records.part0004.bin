{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29064},{"literal_text_all_w_t_and_m_t":"–PUSCH-Config","paragraph_zero_based":29065},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-Config is used to configure the UE specific PUSCH parameters applicable to a particular BWP.","paragraph_zero_based":29066},{"literal_text_all_w_t_and_m_t":"PUSCH-Config information element","paragraph_zero_based":29067},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29068},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-START","paragraph_zero_based":29069},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29070},{"literal_text_all_w_t_and_m_t":"PUSCH-Config ::=                        SEQUENCE {","paragraph_zero_based":29071},{"literal_text_all_w_t_and_m_t":"    dataScramblingIdentityPUSCH             INTEGER (0..1023)                                                   OPTIONAL,   -- Need S","paragraph_zero_based":29072},{"literal_text_all_w_t_and_m_t":"    txConfig                                ENUMERATED {codebook, nonCodebook}                                  OPTIONAL,   -- Need S","paragraph_zero_based":29073},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeA        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":29074},{"literal_text_all_w_t_and_m_t":"    dmrs-UplinkForPUSCH-MappingTypeB        SetupRelease { DMRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":29075},{"literal_text_all_w_t_and_m_t":"    pusch-PowerControl                      PUSCH-PowerControl                                                  OPTIONAL,   -- Need M","paragraph_zero_based":29076},{"literal_text_all_w_t_and_m_t":"    frequencyHopping                        ENUMERATED {intraSlot, interSlot}                                   OPTIONAL,   -- Need S","paragraph_zero_based":29077},{"literal_text_all_w_t_and_m_t":"    frequencyHoppingOffsetLists             SEQUENCE (SIZE (1..4)) OF INTEGER (1.. maxNrofPhysicalResourceBlocks-1)","paragraph_zero_based":29078},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need M","paragraph_zero_based":29079},{"literal_text_all_w_t_and_m_t":"    resourceAllocation                      ENUMERATED { resourceAllocationType0, resourceAllocationType1, dynamicSwitch},","paragraph_zero_based":29080},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          SetupRelease { PUSCH-TimeDomainResourceAllocationList }             OPTIONAL,   -- Need M","paragraph_zero_based":29081},{"literal_text_all_w_t_and_m_t":"    pusch-AggregationFactor                 ENUMERATED { n2, n4, n8 }                                           OPTIONAL,   -- Need S","paragraph_zero_based":29082},{"literal_text_all_w_t_and_m_t":"    mcs-Table                               ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":29083},{"literal_text_all_w_t_and_m_t":"    mcs-TableTransformPrecoder              ENUMERATED {qam256, qam64LowSE}                                     OPTIONAL,   -- Need S","paragraph_zero_based":29084},{"literal_text_all_w_t_and_m_t":"    transformPrecoder                       ENUMERATED {enabled, disabled}                                      OPTIONAL,   -- Need S","paragraph_zero_based":29085},{"literal_text_all_w_t_and_m_t":"    codebookSubset                          ENUMERATED {fullyAndPartialAndNonCoherent, partialAndNonCoherent,nonCoherent}","paragraph_zero_based":29086},{"literal_text_all_w_t_and_m_t":"                                                                                                          OPTIONAL, -- Cond codebookBased","paragraph_zero_based":29087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8b6645fe4c08789dc952ed0645bf6e52b82a27d0fa511a388f69f94c3dd75d32","c6990c01143fcd9ffed6de7cd228f4aa8c989fe24eec3e265a58c64695239123","65036a73fa512c6798293f0c3264511fdf66ce7a2a1f9fee5867f3264d20f6a4","fcaced73c94627a00dcc9d25189dee37675fd38e807e6778db5bbaaa4695f404","8bb4a05dddfd47df2c357009ac8cb416131d2896d5eb44fee24df62431eaf1f2","012dbf8b461a1e57b1597fcb1ea652036d40071d499515d1f3b990cfcd10238a","6d7280fd80237fcd42096cc2446f1f986e43b5d1b2c8b95be58d4675a4a4249e","206bdc7833085bd0771baf033c2ecaa27db630e62dd5737d0633dda34128e50a","d6b191e894941d0bac9e5784e87d6869244ee8ac37c7d8270cc784f7d9ecd872","41868af372ccf99714436a47097760b25e5dbd387bcbf7e2acba3547eb0deade","c1c83ac0953ca61f976c19714e0070f88fe7ea5a4893483801e90a92a2b227ab","2b7a78727c5b266e5af82ad7cc8e1350fd00fc486dd2618ef200670bc1e1a80c","a9e3743fe8c655e02f17791db67dcac53ead9c791970db0f3afd010be692747e","7f80b2f8ec0ef0eb03285bcb1053939771c46a40952b0ef8bdde2183fe9ca30c","3c8bb720f2a4a9ec751068bd8afc2706a323cb2f3aaf0b84fec8e726d377450f","01e63fe9e80dd8a53434f85922d325ae612f68f944a4278675462a286023c979","4602e7ac1da232ccb005df5890f16d76af579002151ce3e54a64b9e278e26431","5ee2e0eb83aa29a7112cb8853d948f8c61af5a6ecd20eeb2bd346a7dbf3f011c","6aa4db6751933bf39583e4b1d994f981fcbe123b5a0d93262952dac826b51581","60c4b967cc0d27b42fa8033686415d24ddffdc7d33a4fefc2c151bf66577959d","91921d9db10deebcaf9b8bbacbfb6b60bb3466b175a0a323f5e7c02479a60d95","aaa308a74262af4eb9d5a245a889425ccd8769ae7ae533e4e953fca208815555","183fa0b4a80220bcadf6439508f68c24eeb7978abf6d68217d5c37ac9efd67d2","1cd5d43cf3bba6484bc8014312bfe5a968f732ca379ab28f0340d128afb612ce"]