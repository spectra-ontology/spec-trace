{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicatedSL-PRS-RP information element","paragraph_zero_based":44976},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44977},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIGDEDICATEDSL-PRS-RP-START","paragraph_zero_based":44978},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44979},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicatedSL-PRS-RP-r18 ::=     SEQUENCE {","paragraph_zero_based":44980},{"literal_text_all_w_t_and_m_t":"    sl-PRS-ConfigIndexCG-r18                               SL-ConfigIndexCG-r16,","paragraph_zero_based":44981},{"literal_text_all_w_t_and_m_t":"    sl-PRS-PeriodCG-r18                                    SL-PeriodCG-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":44982},{"literal_text_all_w_t_and_m_t":"    sl-PRS-ResourcePoolID-r18                              SL-ResourcePoolID-r16                                       OPTIONAL, -- Need M","paragraph_zero_based":44983},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrantDedicatedSL-PRS-RP-r18     SEQUENCE {","paragraph_zero_based":44984},{"literal_text_all_w_t_and_m_t":"        sl-TimeOffsetCG-Type1-r18                              INTEGER (0..7999)                                       OPTIONAL, -- Need R","paragraph_zero_based":44985},{"literal_text_all_w_t_and_m_t":"        sl-TimeReferenceSFN-Type1-r18                          ENUMERATED {sfn512}                                     OPTIONAL, -- Need S","paragraph_zero_based":44986},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r18                            INTEGER (0..496)                                        OPTIONAL, -- Need M","paragraph_zero_based":44987},{"literal_text_all_w_t_and_m_t":"        sl-PRS-ResourceIndicationFirstType1-r18                INTEGER(0..11)                                          OPTIONAL, -- Need M","paragraph_zero_based":44988},{"literal_text_all_w_t_and_m_t":"        sl-PRS-ResourceIndicationFutureType1-r18               INTEGER(0..143)                                         OPTIONAL  -- Need M","paragraph_zero_based":44989},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":44990},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44991},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44992},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIGDEDICATEDSL-PRS-RP-STOP","paragraph_zero_based":44993},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44995},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicatedSL-PRS-RP field descriptions","paragraph_zero_based":44996},{"literal_text_all_w_t_and_m_t":"sl-PRS-ConfigIndexCG","paragraph_zero_based":44997},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant for SL-PRS transmission. The field value shares the same indexing space with sl-ConfigIndexCG in IE SL-ConfiguredGrantConfig.","paragraph_zero_based":44998},{"literal_text_all_w_t_and_m_t":"sl-PRS-PeriodCG","paragraph_zero_based":44999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a4590179ec90aeda8b90fd38f72f443f45b84b167bcc27f078d44bbd6722de98","5ec135783839c920b441bbab8e58b4289e9b4c7bb9c23de717e84fddba28c123","02bbb9e607f59e720947f17081ea4bf645743022c690f05f3cb7490abcd86045","0d11ba323be08817a0e549954ec28c30e58b807440d7a2b53e935de84d2ea2b4","5