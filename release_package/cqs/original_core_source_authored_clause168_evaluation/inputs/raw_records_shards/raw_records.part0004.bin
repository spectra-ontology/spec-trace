{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52704},{"literal_text_all_w_t_and_m_t":"AffectedCarrierFreqCombEUTRA ::= SEQUENCE (SIZE (1..maxNrofServingCellsEUTRA)) OF ARFCN-ValueEUTRA","paragraph_zero_based":52705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52706},{"literal_text_all_w_t_and_m_t":"AffectedCarrierFreqCombNR ::= SEQUENCE (SIZE (1..maxNrofServingCells)) OF ARFCN-ValueNR","paragraph_zero_based":52707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52708},{"literal_text_all_w_t_and_m_t":"CandidateCellListCPC-r17 ::= SEQUENCE (SIZE (1..maxFreq)) OF CandidateCellCPC-r17","paragraph_zero_based":52709},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52710},{"literal_text_all_w_t_and_m_t":"CandidateCellCPC-r17 ::=           SEQUENCE {","paragraph_zero_based":52711},{"literal_text_all_w_t_and_m_t":"    ssbFrequency-r17                   ARFCN-ValueNR,","paragraph_zero_based":52712},{"literal_text_all_w_t_and_m_t":"    candidateCellList-r17              SEQUENCE (SIZE (1..maxNrofCondCells-r16)) OF PhysCellId","paragraph_zero_based":52713},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":52714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52715},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-INFO-STOP","paragraph_zero_based":52716},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":52717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52718},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo field descriptions","paragraph_zero_based":52719},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqCombList","paragraph_zero_based":52720},{"literal_text_all_w_t_and_m_t":"This field is signalled upon MN not addressing IDC issue and contains the list of NR carrier frequency combinations reported by UE to MN for IDC problem caused by the NR-DC frequency combination.","paragraph_zero_based":52721},{"literal_text_all_w_t_and_m_t":"affectedCarrierFreqRangeCombList","paragraph_zero_based":52722},{"literal_text_all_w_t_and_m_t":"This field is signalled upon MN not addressing IDC issue and contains the list of NR carrier frequency range combinations reported by UE to MN for IDC problem caused by the NR-DC frequency combination.","paragraph_zero_based":52723},{"literal_text_all_w_t_and_m_t":"alignedDRX-Indication","paragraph_zero_based":52724},{"literal_text_all_w_t_and_m_t":"This field is signalled upon MN triggered CGI reporting by the UE that requires aligned DRX configurations between the MCG and the SCG (i.e. same DRX cycle and on-duration configured by MN completely contains on-duration configured by SN).","paragraph_zero_based":52725},{"literal_text_all_w_t_and_m_t":"allowedBC-ListMRDC","paragraph_zero_based":52726},{"literal_text_all_w_t_and_m_t":"A list of indices referring to band combinations in MR-DC capabilities from which SN is allowed to select the SCG band combination. Each entry refers to:","paragraph_zero_based":52727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["97fb2edf3183393c186f7c239b8d71926e73b9285b8988ff1e594bf85b9cf8c8","bc9b91d30216305e640cac4f0ae1293b55a78593eb5c6eb8b5c12a12824dac9f","edcacb0cb7c1ebb0de767be893f62c1d5990830fa90d777cc69ab24dcd9f21e5","01d589e8e3ea48cad5cc0bf79c0556b70d601e19cd0ff5090a00ce30e46d8b9f","60905caf5480080f647cf1f925bdd3e9dce6eeb72aeb4c07fe74e10c33dc42e7","b7905e5d60626b4903762b47bc38c3b452725bf22e4f07b8da0028803e0f68d4","657c9cd4dc59f913f10766f8d2ec1387a61fe4992d1a8b90e15e9514bc9836fe","743bb69bf87d4f785802df5bfb3916a78105d569bbf7a6c616bc7b6b54667c82","8487250120ecd15767b93177edcfdecdd86cf6eaeada183936f928fa168c3b33","4af59a1d86bcf1e761d42244630ad84b1ce3d67e3f2d5592ad04fd4b3a27efaa","f4e98373c107ced809ae89f67bd72d0719cbf0afd9d4db2fec24c71cf0616575","ff6402bd49b51ba4d4efdffac344659b4a954eeaf5332021839c0886d79f2a5a","d89972061a17bb55d2d2ead628d688cbac5a00bc2dc09c9f59114219e52b4f6b","465aedba6c75b50e7dc617b84a044709ae81b1ed916a230b063cf84a6572784a","dc6f48b59f301c0fdc53a5f1048d6d9f892b3af123f52def6112158b021ca85c","7bca32718e0abc95809814edd8713cb6d33328c32914553dc29fcae1cfa1b64d","910af74ed11c3f06aeb6ca2d8a02211aeb921ec2b533ff7bbeca4b187c794a0d","9c37947d6b056580451fdd625172c5fc8582ee614c67caade3f0e514b2495ff1","3d3b6bbea054ce708a68f9cdbcabe756c066d8166ff304e1041840c27eb3e1de","5e8aab030cb352f198c1bb511b40e6da999b273f0be1e6af1dd30cb8aa8ce140","b88485173c5c393551bad7633040e22bb5909d442d4f2c2d1219e9ad6c0362e3","7bb3f29111ddcc51386bab4c592a2a55283004870eead064c4856193e047b630","c4b1f151d3df16465b518b3195530a7c0d513ea4e7a6f7e6c549ce2ff834e013","95df8ea791422d63771fe859494e63329a057e308b8403ea1790cdb8b477e294"],"paragraph_range_zero_based":[52704,52727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52704"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- a band combination numbered according to supportedBandCombinationList and supportedBandCombinationList-UplinkTxSwitch in the UE-MRDC-Capability (in case of (NG)EN-DC), or according to supportedBandCombinationList and supportedBandCombinationListNEDC-Only in the UE-MRDC-Capability (in case of NE-DC), or according to supportedBandCombinationList in the UE-NR-Capability (in case of NR-DC),","paragraph_zero_based":52728},{"literal_text_all_w_t_and_m_t":"- and the Feature Sets allowed for each band entry. All MR-DC band combinations indicated by this field comprise the MCG band combination, which is a superset of the MCG band(s) selected by MN.","paragraph_zero_based":52729},{"literal_text_all_w_t_and_m_t":"allowedReducedConfigForOverheating","paragraph_zero_based":52730},{"literal_text_all_w_t_and_m_t":"Indicates the reduced configuration that the SCG is allowed to configure.","paragraph_zero_based":52731},{"literal_text_all_w_t_and_m_t":"reducedMaxCCs in allowedReducedConfigForOverheating indicates the maximum number of downlink/uplink PSCell/SCells that the SCG is allowed to configure. This field is used in (NG)EN-DC and NR-DC.","paragraph_zero_based":52732},{"literal_text_all_w_t_and_m_t":"reducedMaxBW-FR1 and reducedMaxBW-FR2 in allowedReducedConfigForOverheating indicates the maximum aggregated bandwidth across all downlink/uplink carriers of FR1 and FR2-1, respectively that the SCG is allowed to configure. reducedMaxBW-FR2-2 in allowedReducedConfigForOverheating-r17 indicates the maximum aggregated bandwidth across all downlink/uplink carriers of FR2-2 that the SCG is allowed to configure. This field is only used in NR-DC.","paragraph_zero_based":52733},{"literal_text_all_w_t_and_m_t":"reducedMaxMIMO-LayersFR1 and reducedMaxMIMO-LayersFR2 in allowedReducedConfigForOverheating indicates the maximum number of downlink/uplink MIMO layers of each serving cell operating on FR1 and FR2-1, respectively that the SCG is allowed to configure. reducedMaxMIMO-LayersFR2-2 in allowedReducedConfigForOverheating-r17 indicates the maximum number of downlink/uplink MIMO layers of each serving cell operating on FR2-2 that the SCG is allowed to configure. This field is only used in NR-DC.","paragraph_zero_based":52734},{"literal_text_all_w_t_and_m_t":"allowedResourceConfigNRDC","paragraph_zero_based":52735},{"literal_text_all_w_t_and_m_t":"Used to indicate the maximum number of resources reserved for the SCG. This field is only used in NR-DC.","paragraph_zero_based":52736},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListMN, candidateCellInfoListSN","paragraph_zero_based":52737},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the master node or the source node suggests the target gNB or DU to consider configuring. In case of MN initiated CPA, CPC or CHO with candidate SCG(s), the field candidateCellInfoListMN contains information regarding cells that the MN suggests the candidate target secondary node to consider configuring for MN initiated CPA, CPC, CHO with candidate SCG(s), or subsequent CPAC.","paragraph_zero_based":52738},{"literal_text_all_w_t_and_m_t":"For (NG)EN-DC, including CSI-RS measurement results in candidateCellInfoListMN is not supported in this version of the specification. For NR-DC, including SSB and/or CSI-RS measurement results in candidateCellInfoListMN is supported.","paragraph_zero_based":52739},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListMN-EUTRA, candidateCellInfoListSN-EUTRA","paragraph_zero_based":52740},{"literal_text_all_w_t_and_m_t":"Includes the MeasResultList3EUTRA as specified in TS 36.331 [10]. Contains information regarding cells that the master node or the source node suggests the target secondary eNB to consider configuring. These fields are only used in NE-DC.","paragraph_zero_based":52741},{"literal_text_all_w_t_and_m_t":"candidateCellListCPC","paragraph_zero_based":52742},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the source secondary node suggests the candidate target secondary node to consider configuring for SN initiated Conditional PSCell Change (CPC) or SN initiated inter-SN subsequent CPAC.","paragraph_zero_based":52743},{"literal_text_all_w_t_and_m_t":"configRestrictInfo","paragraph_zero_based":52744},{"literal_text_all_w_t_and_m_t":"Includes fields for which SgNB is explicitly indicated to observe a configuration restriction.","paragraph_zero_based":52745},{"literal_text_all_w_t_and_m_t":"drx-ConfigMCG","paragraph_zero_based":52746},{"literal_text_all_w_t_and_m_t":"This field contains the complete DRX configuration of the MCG. This field is only used in NR-DC.","paragraph_zero_based":52747},{"literal_text_all_w_t_and_m_t":"drx-InfoMCG","paragraph_zero_based":52748},{"literal_text_all_w_t_and_m_t":"This field contains the DRX long and short cycle configuration of the MCG. This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":52749},{"literal_text_all_w_t_and_m_t":"drx-InfoMCG2","paragraph_zero_based":52750},{"literal_text_all_w_t_and_m_t":"This field contains the drx-onDurationTimer configuration of the MCG. This field is only used in (NG)EN-DC.","paragraph_zero_based":52751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0ae3fc8997031cf0ec892413e0ff9699809c2676db0a7f3f0dd38b5008743992","b5bf256a10da0bd6d52c8606d691732980028f8b3b9f009ca5762154c849471c","0eac759f0c282f3483f71b0395ccabac6b1a5c8da159b3020415f37d7cbe0bf7","ad04cb4be742be81006de3ed61f73de1952dd4114823a178ec158887bba609c3","08b91fb1110e0a7e1f00fe47f1f37a16e8286e5373cbcd0f51b8b3bbdf54b5f3","9a439cec08d5c9ee6683e80f6736237f827784896d00c64f9fa0c54bdd377085","0806c5138f0d52d22d7c544ef026941063ba2c781bc3e069618140169a39962e","3fa3657cd236d856c3ce19829ebb2dbf94dc017ba91f167fe9c70955fa85c68a","467c122318b16c513c35fefb2a915bb9fcf8bf5eff5557f70f52db15bc3b0438","3658235a9d0cea48746ae687b17831e08b4daa5784b8a5d2ff821ca4aec6cbd3","3a2b97594aa04d8bfd29fcb0943e80aa5c3a544a749efb7b6a3294e5acbbefe3","fa39e2f73a641aa9664b39c7f98a6e1d8b7f815f27ca40765b8113433e6029d4","e9d55ff9de8f7e1e23af8e35e76c4a3c671ac4220ce29002c53d3bb4932165f8","b8133399de08d1fd8225d222fd1805beebc8da6f58cf5fa4930ea3c33acc9e9a","a17bc1fedf18ff49d525477a8cc4ae398717b42658975f9d8004b3d49f7c14ef","8d3d5d9557a08acfe8d112147422828c7cfbca34dd0d95936e1f9bc49f446ac6","b7d03ec76822480e566c8f067a0e60c1bd80e0a4fb27527601ffd63a195efc41","f6288a74d5d6b323b4fb7aa854a0b2abf9a0ee79b9b5a7e28cd409eae6d6c9b9","9a4d0769c4694810962d59cef840fbae25b1ce88c70fa5a730bdd6327e731463","44b74b3066dd1a68961d0348801b196f03d33a314f5110dcfd2f73f7f54a1072","af5fd18ae90d95792c0b2fd9b16e4805ab8c5c90d78a6a208b1ddb42b3403d8f","706381f07c689714cc0872148614cb96f9e2bdf9595ce05a89a0b3f1fb1da4f3","dda029e78666ccdecd43ac8be7874fa04d87b963b0af8aa2adc42eb2a0e858b7","27bf97dbf3ac994b1ff59d981ead0304d7ed619f974e96b2116da455a437c3a6"],"paragraph_range_zero_based":[52728,52751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52728"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dummy, dummy1","paragraph_zero_based":52752},{"literal_text_all_w_t_and_m_t":"These fields are not used in the specification and SN ignores the received value(s).","paragraph_zero_based":52753},{"literal_text_all_w_t_and_m_t":"fr-InfoListMCG","paragraph_zero_based":52754},{"literal_text_all_w_t_and_m_t":"Contains information of FR information of serving cells that include PCell and SCell(s) configured in MCG.","paragraph_zero_based":52755},{"literal_text_all_w_t_and_m_t":"fr1-Carriers-MCG, fr2-Carriers-MCG","paragraph_zero_based":52756},{"literal_text_all_w_t_and_m_t":"Indicates the number of FR1 or FR2 serving cells configured in MCG.","paragraph_zero_based":52757},{"literal_text_all_w_t_and_m_t":"idc-TDM-Assistance","paragraph_zero_based":52758},{"literal_text_all_w_t_and_m_t":"This field is signalled upon MN not addressing IDC issue and contains IDC TDM assistance information reported by UE to MN for IDC problem.","paragraph_zero_based":52759},{"literal_text_all_w_t_and_m_t":"interFreqNoGap","paragraph_zero_based":52760},{"literal_text_all_w_t_and_m_t":"Indicates that the field interFrequencyConfig-NoGap-r16 has been included within the MeasConfig IE generated by the MN.","paragraph_zero_based":52761},{"literal_text_all_w_t_and_m_t":"lowMobilityEvaluationConnectedInPCell","paragraph_zero_based":52762},{"literal_text_all_w_t_and_m_t":"Indicates if low mobility criterion has been configured in NR PCell.","paragraph_zero_based":52763},{"literal_text_all_w_t_and_m_t":"maxInterFreqMeasIdentitiesSCG","paragraph_zero_based":52764},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of allowed measurement identities that the SCG is allowed to configure for inter-frequency measurement. The maximum value for this field is 10. If the field is absent, the SCG is allowed to configure inter-frequency measurements up to the maximum value. This field is only used in NR-DC.","paragraph_zero_based":52765},{"literal_text_all_w_t_and_m_t":"maxIntraFreqMeasIdentitiesSCG","paragraph_zero_based":52766},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of allowed measurement identities that the SCG is allowed to configure for intra-frequency measurement on each serving frequency. The maximum value for this field is 9 (in case of (NG)EN-DC or NR-DC) or 10 (in case of NE-DC). If the field is absent, the SCG is allowed to configure intra-frequency measurements up to the maximum value on each serving frequency.","paragraph_zero_based":52767},{"literal_text_all_w_t_and_m_t":"maxMeasCLI-ResourceSCG","paragraph_zero_based":52768},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of CLI RSSI resources that the SCG is allowed to configure.","paragraph_zero_based":52769},{"literal_text_all_w_t_and_m_t":"maxMeasFreqsSCG","paragraph_zero_based":52770},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of NR inter-frequency carriers the SN is allowed to configure with PSCell for measurements.","paragraph_zero_based":52771},{"literal_text_all_w_t_and_m_t":"maxMeasSRS-ResourceSCG","paragraph_zero_based":52772},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of SRS resources that the SCG is allowed to configure for CLI measurement.","paragraph_zero_based":52773},{"literal_text_all_w_t_and_m_t":"maxNumberCPCCandidates","paragraph_zero_based":52774},{"literal_text_all_w_t_and_m_t":"Indicates the maximum numbers of conditional reconfigurations the SN is allowed to configure for SN initiated CPC. Value 0 indicates that the SN is not allowed to configure SN initiated CPC. If the field is absent, the SN is allowed to configure up to maxNrofCondCells-r16 conditional reconfigurations for SN-initiated CPC.","paragraph_zero_based":52775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["272760e7869687da2015fd73f67b8b95be6fe83d0cbc60d1756a38030dca8ca8","e0225d8e633d47a71b98564caa8b7076e85c6d0f4684858d3dd7b92bad5574e8","0f3b2d05c40b3c4c3665e67fb9cbb3d70edc025a4a263a272356e80719a6c04a","f4861d8cb927b1250a551c44da4a098c8e957e4b3261d0d7c236adc25f63bc12","4392e073b2ceb670fca8b90f49f6e7389078eca2f9b2b95b095f35bd2afdf04a","25c5d7d64fbb39a438a607b7cd4a64b8eede0c368558a37530b66a4600e16b7f","7e18784520b018393f15dbd22163044c1e602bbc26d7cf858b027e1b54e6344b","af99a53fdd7d60361e5252fbf153479a563ffe4432323c9153b4fbe58c34000f","23b4e27aae37486fdd645ccb7efb66abe06147198b3a7fbffa3ed1957f14fa01","54c5932e0ba197aa00c27ab7a45eda24b2ff2fd7031a797d74b72b7cfc76dc67","9d8a46f72f2435508921847de77d288f2a023f312939d245a636d0a116f57544","1e6ebd293360727e8f7dab57f5dfcf98e55d72279d8ebbfa0938bc34563363b0","1098f4df78e050647dc2e6ffe034dd1bb73363cb9078fc31ccde1215b0e53a93","9d9280a3462c73f2fb66bf1eabe34ade9acba42ce6bc6815217590962c8077a1","88e975ee54d1f968b4e1ea0c855c0350d2a0302b737545fbab7f79dfcfb0190a","ffc03b1208c74a977de3de1a579a08b52e153d9621afe8f95b10b37e0625fa08","237ed283e41b51f7677e1437747f8d6b05d844d2cb68434005e4c83955973ca4","f2d1cd688176815c3a30695538c422e32e99097a78aaeb69b44d62758a137b57","4cb3ac4390e8d1fe76ec4a924a4eb62b124459160289fd2ca16cc71c0eff9154","bb1ec19753e05da281509e464007461e1f82128e054288436e4d953863b8df61","b8c3803d24b213128d6916d7a08207d518281f4e3e1c9a738e36d8c221733245","93bf6cb2ead4ca9925a70a1df605c59623f2963a97d3a54ddc9d454dc84405ac","1aef771d1bb7243dfd20626cc249ead8f8640cf20ed9db7ffda7bce59df69a61","99a3e628cc6b0db5208524f37fe31444d7edb3a2d08ea5c3f781076ed4f0c779"],"paragraph_range_zero_based":[52752,52775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52752"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxNumberROHC-ContextSessionsSN","paragraph_zero_based":52776},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of ROHC context sessions allowed to SN terminated bearer, excluding context sessions that leave all headers uncompressed.","paragraph_zero_based":52777},{"literal_text_all_w_t_and_m_t":"maxNumberEHC-ContextsSN","paragraph_zero_based":52778},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of EHC contexts allowed to the SN terminated bearer. The field indicates the number of contexts in addition to CID = \"all zeros\", as specified in TS 38.323 [5].","paragraph_zero_based":52779},{"literal_text_all_w_t_and_m_t":"maxNumberUDC-DRB","paragraph_zero_based":52780},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of UDC DRBs allowed to SN terminated bearer. This field is used in NGEN-DC, NR-DC and NE-DC.","paragraph_zero_based":52781},{"literal_text_all_w_t_and_m_t":"maxToffset","paragraph_zero_based":52782},{"literal_text_all_w_t_and_m_t":"Indicates the maximum Toffset value the SN is allowed to use for scheduling SCG transmissions (see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1 ms and so on.","paragraph_zero_based":52783},{"literal_text_all_w_t_and_m_t":"measuredFrequenciesMN","paragraph_zero_based":52784},{"literal_text_all_w_t_and_m_t":"Used by MN to indicate a list of frequencies measured by the UE.","paragraph_zero_based":52785},{"literal_text_all_w_t_and_m_t":"measGapConfig","paragraph_zero_based":52786},{"literal_text_all_w_t_and_m_t":"Indicates the FR1 and perUE measurement gap configuration configured by MN.","paragraph_zero_based":52787},{"literal_text_all_w_t_and_m_t":"measGapConfigFR2","paragraph_zero_based":52788},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 measurement gap configuration configured by MN.","paragraph_zero_based":52789},{"literal_text_all_w_t_and_m_t":"mcg-RB-Config","paragraph_zero_based":52790},{"literal_text_all_w_t_and_m_t":"Contains all of the fields in the IE RadioBearerConfig used in MN, used by the SN to support delta configuration to UE (i.e. when MN does not use full configuration option), for bearer type change between MN terminated bearer with NR PDCP to SN terminated bearer. It is also used to indicate the PDCP duplication related information for MN terminated split bearer (whether duplication is configured and if so, whether it is initially activated) in SN Addition/Modification procedure. Otherwise, this field is absent.","paragraph_zero_based":52791},{"literal_text_all_w_t_and_m_t":"measResultReportCGI, measResultReportCGI-EUTRA","paragraph_zero_based":52792},{"literal_text_all_w_t_and_m_t":"Used by MN to provide SN with CGI-Info for the cell as per SN′s request. In this version of the specification, the measResultReportCGI is used for (NG)EN-DC and NR-DC and the measResultReportCGI-EUTRA is used only for NE-DC.","paragraph_zero_based":52793},{"literal_text_all_w_t_and_m_t":"measResultSCG-EUTRA","paragraph_zero_based":52794},{"literal_text_all_w_t_and_m_t":"This field includes the MeasResultSCG-FailureMRDC IE as specified in TS 36.331 [10]. This field is only used in NE-DC.","paragraph_zero_based":52795},{"literal_text_all_w_t_and_m_t":"measResultSFTD-EUTRA","paragraph_zero_based":52796},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the E-UTRA PScell in NE-DC. This field is only used in NE-DC.","paragraph_zero_based":52797},{"literal_text_all_w_t_and_m_t":"mrdc-AssistanceInfo","paragraph_zero_based":52798},{"literal_text_all_w_t_and_m_t":"Contains the IDC assistance information for MR-DC reported by the UE (see TS 36.331 [10]).","paragraph_zero_based":52799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5837dff2dc0239b5eac11240ece9c23dc8312c114a2bbfc2219f80dbd2115ab5","414f59ee5b3374cd8b07c6ecaf74962b9aecd24acdd8876c91a02a755a7b4a9b","84ae27ed731d5189d2435d1317ea91a1eae77e59489fe2d38801578370213897","e7d81c14a4fdd474e2a8ee69f7a1ec6d4fb97c47783c9c0a132b7f991bf62842","217ed2271cf10c6c32139e2f0f2c9f595ad54e9a76041bcdea55286bb8ad2424","1cfa917c0625605648ae73e90fec3c957f98244e962eb36d86d93f8cd3aa226f","1788c33f27fcc90cb8180bda5506a3aa421d7d71c77da1098df32cfed30dfbc8","e70846a706f7b7651072f32e8c8f6b4317ab13d43bde1067c1f1e33e5daa4742","a74bb5a3cd8f066d9bd954b8047d0e0a50bce6993abb50c232a4d8a8a9c6d18c","4badb540db25d023f7557d95f0277bc87c466017ebf0c5bb9df4f1a716f11c7f","d8af1f961f818fc6aa03a7438e09688dc12a79caa004f1b12dc8b98925209422","2dc5652ff7629a5bdfa8b2d6861bb7824932fde61b08db6d29ec27e44e2e02ac","0dddadaabc310bc163968ae198cf1a0a0e9c777f7527ffb93ed7a54703bcfbe4","344d76c386882506bb39d26f6f8266c38f13445d07a21d945d2ea37a983bf4ae","bdf1a901b21857824457f478f28947d0cc833bc35b4a0fc477febcbd61790368","5566fa3e6fbd68b16ff677878bb4167df5a4c64919fde6dff6d0c815669abf50","466308e460f0d5127d938c71f8e65b2c5c74790b90a61400780be0773921e728","202919ea75e8d17d22bf7291fc6b4656a713936f9c7f60bbbdcb8d9dffab2a59","76c765084dcc8f2a1a2af66ddc429562c607ef6852b24dd083723e50cdf7c000","9e9fd84c682e5d6b6573078549c0d52053059c2cf7c02dcde574399f6160804a","239e013aa2db517e15793b1f0b5547cdaa6c1bddc062f9492da0987b17a40690","2866a60bc9c2224b75a756a186c9d69bc3fd066808eb4f66bca83fc86da44809","28682fadaa1ae68fa7054b23d0952e76e48a08612f4ae332204ce2e01c2f4866","78dce03d71a0459a1a94b529fd193f29d68e0298ca5e9131a16f9d42f8f85e47"],"paragraph_range_zero_based":[52776,52799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52776"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-CapRestrictionInfo","paragraph_zero_based":52800},{"literal_text_all_w_t_and_m_t":"Indicates the UE's preference on SCell(s) to be released, band(s) or combination(s) of bands with restricted capability, or band(s) or band combination(s) to be avoided for UE temporary capabilities restriction purpose with the musim-candidateBandList-r18 only for musim-AffectedBandsList-r18 and musim-AvoidedBandsList -r18.","paragraph_zero_based":52801},{"literal_text_all_w_t_and_m_t":"musim-GapConfigInfo","paragraph_zero_based":52802},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM gap configuration configured by MN.","paragraph_zero_based":52803},{"literal_text_all_w_t_and_m_t":"nrdc-PC-mode-FR1","paragraph_zero_based":52804},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC FR1 (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":52805},{"literal_text_all_w_t_and_m_t":"nrdc-PC-mode-FR2","paragraph_zero_based":52806},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC FR2 (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":52807},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceSCG","paragraph_zero_based":52808},{"literal_text_all_w_t_and_m_t":"Contains the UE's preference on reduced configuration for NR SCG to address overheating. This field is only used in (NG)EN-DC.","paragraph_zero_based":52809},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceSCG-FR2-2","paragraph_zero_based":52810},{"literal_text_all_w_t_and_m_t":"Contains the UE's preference on reduced configuration for NR SCG on FR2-2 to address overheating. This field is only used in (NG)EN-DC.","paragraph_zero_based":52811},{"literal_text_all_w_t_and_m_t":"p-maxEUTRA","paragraph_zero_based":52812},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the E-UTRA cell group (see TS 36.104 [33]). This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":52813},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR1","paragraph_zero_based":52814},{"literal_text_all_w_t_and_m_t":"For (NG)EN-DC and NE-DC, the field indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]). For NR-DC, it indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":52815},{"literal_text_all_w_t_and_m_t":"p-maxUE-FR1","paragraph_zero_based":52816},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1).","paragraph_zero_based":52817},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR1-MCG","paragraph_zero_based":52818},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 1 (FR1) (see TS 38.104 [12]) the UE can use in NR MCG. This field is only used in NR-DC.","paragraph_zero_based":52819},{"literal_text_all_w_t_and_m_t":"p-maxNR-FR2-SCG","paragraph_zero_based":52820},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 2 (FR2) (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":52821},{"literal_text_all_w_t_and_m_t":"p-maxUE-FR2","paragraph_zero_based":52822},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2).","paragraph_zero_based":52823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8d450b7788073fa1734a73eb6b207eeced726f9a14bd48b5f1815b5fc093e058","00e928bd1ee1deeb33e9b7c7cfd3d2ab3d5f60df7a629fa9f67d58d5c244d682","e5fb45fb1ced81966e7ba9ce87e851b7d6d66cf1e1fc1c42f2508e50fc288fa4","de751b7f222e527d25ed2923d7bfa3381c286de774954428b4e031fe6ac521f8","6e4b85efde369d5e52cbff094272e78136722e8034f2d6a79f64b71cb15f8d13","65305f35c29a45b7295bf0d5feb8292f882441a85bcd3f6dd28762849fdd12e3","f00d4fde9403a3972806972dea9c0471bd501cb0e4e694f423fa4ca01559bda7","02e57a3a7dba0b6900b226d141568aa54a2e0bf117e67411ef8ab7eda92634e2","fdce485d5cb4a279d33693e2d951bbfc08b567307d53e9d4d8b8e6a449f94d7c","61e07732e5e4c5eba7370deaa759575e83ef6e1b9b2867d33cded002e6169a3d","aff02e25dae9586f4df1433c43fa36103070b3609eed51107b725b8271b22dad","888f44446057a7033bba174aebc49d3773d5db561119f934c8af5b0e89b858d1","d832a876b6ce141d649d6e4020684149fe6e38fa19f790e0ca4750782dbac034","be242d109c8239767d831791bfcb75edcce3a479801c55d1285f645e8e9b5dc7","925845125cc39ffc15dd4e64ef32742ed749f4d3c58f8c0aa50424f2c54636e0","44cc1b8f60fc596d9e1a50774de20599296e9afe7ddf5e812836ec2e03554bad","dfc4b585b1c4d9efeb87e8302cdf159741eb5c133f82dedfbf730ab4ed1fc0fd","57f7692ddaafa02001f129aa1db04d2a92586f7617b200627bee824b31ff52c7","7ecdd8dc16ae895c87c078d6a2223e8e6ac82a17032cedf3a864b9801ab79163","0065896df43f9f1bf8929866c0388c4d08c8bf097bb1489f3d2d43d85e101445","2120c9505b17e00904ad641512e91de8ef962aefd4e5bcd8c80ec48df78fbd45","ea1cc568c181c505d2dac3fc854299129028e85f8d88024f5a2c2739821bd44f","27c786a4cc42f62b0a09ce44a32ae59388624f19d221a0cb79bb8321c14ae83a","eb8951af886274270cfbd818fa545715dc44e184464e655b628d826ea4289bec"],"paragraph_range_zero_based":[52800,52823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52800"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"p-maxNR-FR2-MCG","paragraph_zero_based":52824},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total transmit power to be used by the UE in the NR cell group across all serving cells in frequency range 2 (FR2) (see TS 38.104 [12]) the UE can use in NR MCG.","paragraph_zero_based":52825},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionSCG","paragraph_zero_based":52826},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of the reference number of cells for PDCCH blind detection allowed to be configured for the SCG.","paragraph_zero_based":52827},{"literal_text_all_w_t_and_m_t":"ph-InfoMCG","paragraph_zero_based":52828},{"literal_text_all_w_t_and_m_t":"Power headroom information in MCG that is needed in the reception of PHR MAC CE in SCG.","paragraph_zero_based":52829},{"literal_text_all_w_t_and_m_t":"ph-SupplementaryUplink","paragraph_zero_based":52830},{"literal_text_all_w_t_and_m_t":"Power headroom information for supplementary uplink. For UE in (NG)EN-DC, this field is absent.","paragraph_zero_based":52831},{"literal_text_all_w_t_and_m_t":"ph-Type1or3","paragraph_zero_based":52832},{"literal_text_all_w_t_and_m_t":"Type of power headroom for a serving cell in MCG (PCell and activated SCells). type1 refers to type 1 power headroom, type3 refers to type 3 power headroom. (See TS 38.321 [3]). ","paragraph_zero_based":52833},{"literal_text_all_w_t_and_m_t":"ph-Uplink","paragraph_zero_based":52834},{"literal_text_all_w_t_and_m_t":"Power headroom information for uplink.","paragraph_zero_based":52835},{"literal_text_all_w_t_and_m_t":"powerCoordination-FR1","paragraph_zero_based":52836},{"literal_text_all_w_t_and_m_t":"Indicates the maximum power that the UE can use in FR1.","paragraph_zero_based":52837},{"literal_text_all_w_t_and_m_t":"powerCoordination-FR2","paragraph_zero_based":52838},{"literal_text_all_w_t_and_m_t":"Indicates the maximum power that the UE can use in frequency range 2 (FR2). This field is only used in NR-DC.","paragraph_zero_based":52839},{"literal_text_all_w_t_and_m_t":"scgFailureInfo","paragraph_zero_based":52840},{"literal_text_all_w_t_and_m_t":"Contains SCG failure type and measurement results. In case the sender has no measurement results available, the sender may include one empty entry (i.e. without any optional fields present) in measResultPerMOList. This field is used in (NG)EN-DC and NR-DC.","paragraph_zero_based":52841},{"literal_text_all_w_t_and_m_t":"scg-RB-Config","paragraph_zero_based":52842},{"literal_text_all_w_t_and_m_t":"Contains all of the fields in the IE RadioBearerConfig used in SN, used to allow the target SN to use delta configuration to the UE, e.g. during SN change. The field is signalled upon change of SN unless MN uses full configuration option. Otherwise, the field is absent.","paragraph_zero_based":52843},{"literal_text_all_w_t_and_m_t":"scpac-ReferenceConfiguration","paragraph_zero_based":52844},{"literal_text_all_w_t_and_m_t":"Includes the reference configuration accociated with the SCG for the candidate supporting subsequent CPAC.","paragraph_zero_based":52845},{"literal_text_all_w_t_and_m_t":"selectedBandEntriesMNList","paragraph_zero_based":52846},{"literal_text_all_w_t_and_m_t":"A list of indices referring to the position of a band entry selected by the MN, in each band combination entry in allowedBC-ListMRDC IE. BandEntryIndex 0 identifies the first band in the bandList of the BandCombination, BandEntryIndex 1 identifies the second band in the bandList of the BandCombination, and so on. This selectedBandEntriesMNList includes the same number of entries, and listed in the same order as in allowedBC-ListMRDC. The SN uses this information to determine which bands out of the NR band combinations in allowedBC-ListMRDC it can configure in SCG in NR-DC. The SN can use this information to determine for which band pair(s) it should check SimultaneousRxTxPerBandPair.","paragraph_zero_based":52847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6a58976c098b5f9be2678a13845a1491821d8ce1bb66df1ab80a2d17fc7664a0","2341418ace46e3d4a583dbe2b3b56f13f7fa1ad46f6ecb864d3faec33c2bc11c","397185dfe64b68f68a72a827ac2250e1a4c1fdacaf54e46ea7ece75fbab505d3","d9591e7ea90451a98a1f2e22f7318fe1c1abf15de343118708ace841e541c50b","c8f0174334f63d210684e4ae026cfb39aa33156a6259ec1fa5f90315771744fd","76fbc892bd5e1cc066dbb3e9c2080c036036c43d0ed17722088bc8590ee85972","31e1ed1293a56c409a34d2f5e17bac2e8df2acbeaafee41fab5a46040260f052","321ab2d2f89fdcbb36e7bf3506de00e229c054d522464101f7712c7eab4a9607","0c1b379227591e66e3f038243ff837280b0509a1399b931ebdb558e343ca6ca1","1df7fe1eea836ef30ca2264e03d3173bbbc18a8c133429a632b71a84284a4dcf","f3290379afaf6aaebc2c0e179c5c8174fdff3bbc522b14afeb88983a02a100fe","b0977d09bc692a61b9cdc4ae5d89bae43fdcc46450cd60efdae8ffd359cbe49a","d2ceb037a389b1f0c5701c47a5af98e1c38308d6f13c35708e8fb6070bce3b75","c89bd71414091f63ea8c130d3db7a376499973716eb4bcd1a8a83313fb286139","d2c44d9e93c1e85e0473be960f68dcee13ef0b77987389112f2eef9bbbeb58bd","ef831be0fbc1489680efbf1935b06fc56f4bd04c24f5248dbb8a6ee6ecbfdc0d","989567b4820e386d40f1ad906d44376e069fd187f801d8f01c30ad06366b51d7","d81ace827b6749ddb069cccd153eca41c5831e884d1e9c96eb042348aa09f481","179d4538bed2d7d2b24325a8d3166586cedf7e5b2d1f9b6775232a3c479551f8","15a2badc260807187709fd793ac187d51a5c8956e7c6841c3ee0a494354e3451","a8c8b8bbbc3db8e4ed62a645998a07f7ba3a2f8383fc78e26a73c4167f117510","49c23e9af146755f7649775a10a4e5e8dba608b02cbd8cd16dea1c2c03fe5826","bdabfb45ff6596a02339b8af35af756f28f3fc42ee9a1b709eda85811f51918c","de3698ed32135fd9bcdcbf5a8b93fe330a206a3637dfd3b1496928e332f1ee58"],"paragraph_range_zero_based":[52824,52847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52824"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"servCellIndexRangeSCG","paragraph_zero_based":52848},{"literal_text_all_w_t_and_m_t":"Range of serving cell indices that SN is allowed to configure for SCG serving cells.","paragraph_zero_based":52849},{"literal_text_all_w_t_and_m_t":"servCellInfoListMCG-EUTRA","paragraph_zero_based":52850},{"literal_text_all_w_t_and_m_t":"Indicates the carrier frequency and the transmission bandwidth of the serving cell(s) in the MCG in intra-band (NG)EN-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in (NG)EN-DC.","paragraph_zero_based":52851},{"literal_text_all_w_t_and_m_t":"servCellInfoListMCG-NR","paragraph_zero_based":52852},{"literal_text_all_w_t_and_m_t":"Indicates the frequency band indicator, carrier center frequency, UE specific channel bandwidth and SCS of the serving cell(s) in the MCG in intra-band NE-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in NE-DC.","paragraph_zero_based":52853},{"literal_text_all_w_t_and_m_t":"servFrequenciesMN-NR","paragraph_zero_based":52854},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of all serving cells that include PCell and SCell(s) with SSB configured in MCG. This field is only used in NR-DC. servFrequenciesMN-NR indicates absoluteFrequencySSB.","paragraph_zero_based":52855},{"literal_text_all_w_t_and_m_t":"sftdFrequencyList-NR","paragraph_zero_based":52856},{"literal_text_all_w_t_and_m_t":"Includes a list of SSB frequencies. Each entry identifies the SSB frequency of a PSCell, which corresponds to one MeasResultCellSFTD-NR entry in the MeasResultCellListSFTD-NR.","paragraph_zero_based":52857},{"literal_text_all_w_t_and_m_t":"sftdFrequencyList-EUTRA","paragraph_zero_based":52858},{"literal_text_all_w_t_and_m_t":"Includes a list of E-UTRA frequencies. Each entry identifies the carrier frequency of a PSCell, which corresponds to one MeasResultSFTD-EUTRA entry in the MeasResultCellListSFTD-EUTRA.","paragraph_zero_based":52859},{"literal_text_all_w_t_and_m_t":"sidelinkUEInformationEUTRA","paragraph_zero_based":52860},{"literal_text_all_w_t_and_m_t":"This field contains the E-UTRA SidelinkUEInformation message as specified in TS 36.331 [10].","paragraph_zero_based":52861},{"literal_text_all_w_t_and_m_t":"sidelinkUEInformationNR","paragraph_zero_based":52862},{"literal_text_all_w_t_and_m_t":"This field contains the NR SidelinkUEInformationNR message.","paragraph_zero_based":52863},{"literal_text_all_w_t_and_m_t":"sourceConfigSCG","paragraph_zero_based":52864},{"literal_text_all_w_t_and_m_t":"Includes all of the current SCG configurations used by the target SN to build delta configuration to be sent to UE, e.g. during SN change. The field contains the RRCReconfiguration message, i.e. including secondaryCellGroup and measConfig. The field is signalled upon change of SN, unless MN uses full configuration option. Otherwise, the field is absent.","paragraph_zero_based":52865},{"literal_text_all_w_t_and_m_t":"sourceConfigSCG-EUTRA","paragraph_zero_based":52866},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration. In this version of the specification, this field is absent when master gNB uses full configuration option. This field is only used in NE-DC.","paragraph_zero_based":52867},{"literal_text_all_w_t_and_m_t":"twoPHRModeMCG","paragraph_zero_based":52868},{"literal_text_all_w_t_and_m_t":"Indicates if the power headroom for MCG shall be reported as two PHRs (each PHR associated with a SRS resource set) is enabled or not.","paragraph_zero_based":52869},{"literal_text_all_w_t_and_m_t":"twoSRS-PUSCH-Repetition","paragraph_zero_based":52870},{"literal_text_all_w_t_and_m_t":"Indicates whether the indicated serving cell is configured for PUSCH repetition corresponding to two SRS resource sets configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":52871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["98f603719869fa5695c15650f0dc6ca00007187c87823e7982004cada09428de","acaadb2fa142b618750ec7bcf95e26111b9cee56c3272b5e13f1c9a32618430d","e6b83958a41bdffa4a2e917ddfc155b557dd4f996a8b1c9f3632471c257436f3","ced1a26c9d76f5fdb4648c1ca9ce21582c7ae3797fc070b9f010ff3c0915a914","3f71994690ced9be4d2c3f34df4f9fe1d37c21530ad7034f1f8d56e7ef07bafe","e13223cb940213dc6509ec054c1d8318b64efdd27da9c4db905324f077de7274","326663c6fbe3ba59626c632ecb3c2d3fc82845ee5fb41f91f925872c6d458f5c","868aba224b3d546f4f600c4a3c4e2e02bce32fe44a797c132a7ac9ae096cd4d7","89fac6a75cb3d5e16b2a6f62513054eb3d0a6f8c086f516fcd36150229402271","e6df376607b18eb662aa0f2e2c00165de32cb51426896e58d2dc15d8f8747abb","d0ef4cb82c69eea0d9a39819cea9519d702b82cbfc3b7da51892d5a59595fdf5","15bc55a5e0710b5c198d0ad2720d04152d107be22198e44a6aff69a6f37b6974","5d33c2972f5f7ccfd2ae5180b1381543c2d678f2437391c26f11d86ad49ac86a","64ccbdf9af13f764421cc9a5978cd1559e6f6f09ffcd9655c95022e0dbcd3af7","5805816dfbebd98dbdf6f134d6c85d62f5904f02b3bcc74d0c3456b38ac9adae","7fca2dfb35f81fc29ba1b721c56fa3f374d06aba8ced2fd6802466ad90e40609","70588a23a17279aca3c82f9d29c24d19b374792636eef82fd6edcf35ff016cf3","67b964d73c89d865e9a0039ea4b3380bd2683f1af32fde22cd76c4b4cce793b8","eaa78896bc98af015939be4f220a5610d09dea2a15bea05d9853a4484df5494a","52408d4fc04a3be9087f4116f3be86ff1ae897ed7ea3684508a5e127ae16cf25","451bed6e9b470ab745e00d71252f11b2a5d398cf1aa9c2c3ba8326c485c25b42","805115d09601d1616f96262e357650449fe582fd29311c220e88ba973d570349","03e902474f47c920cf7d6e7c855aac6266b0de9081d106b88a5043c9f2886a9c","7caf96077db4a9e4024925949736b854ca0e03f12809710a355ae102273e07fb"],"paragraph_range_zero_based":[52848,52871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52848"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ueAssistanceInformationSourceSCG","paragraph_zero_based":52872},{"literal_text_all_w_t_and_m_t":"Includes for each UE assistance feature associated with the SCG, the information last reported by the UE in the NR UEAssistanceInformation message for the source SCG, if any.","paragraph_zero_based":52873},{"literal_text_all_w_t_and_m_t":"ue-CapabilityInfo","paragraph_zero_based":52874},{"literal_text_all_w_t_and_m_t":"Contains the IE UE-CapabilityRAT-ContainerList supported by the UE (see NOTE 3). A gNB that retrieves MRDC related capability containers ensures that the set of included MRDC containers is consistent w.r.t. the feature set related information.","paragraph_zero_based":52875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52876},{"literal_text_all_w_t_and_m_t":"BandCombinationInfo field descriptions","paragraph_zero_based":52877},{"literal_text_all_w_t_and_m_t":"allowedFeatureSetsList","paragraph_zero_based":52878},{"literal_text_all_w_t_and_m_t":"Defines a subset of the entries in a FeatureSetCombination. Each index identifies a position in the FeatureSetCombination, which corresponds to one FeatureSetUplink/Downlink for each band entry in the associated band combination.","paragraph_zero_based":52879},{"literal_text_all_w_t_and_m_t":"bandCombinationIndex","paragraph_zero_based":52880},{"literal_text_all_w_t_and_m_t":"In case of NR-DC, this field indicates the position of a band combination in the supportedBandCombinationList. In case of NE-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only. In case of (NG)EN-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationList-UplinkTxSwitch. Band combination entries in supportedBandCombinationList are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList. Band combination entries in supportedBandCombinationListNEDC-Only are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationListNEDC-Only increased by the number of entries in supportedBandCombinationList. Band combination entries in supportedBandCombinationList-UplinkTxSwitch are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList-UplinkTxSwitch increased by the number of entries in supportedBandCombinationList.","paragraph_zero_based":52881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52882},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":52883},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":52884},{"literal_text_all_w_t_and_m_t":"SN-AddMod","paragraph_zero_based":52885},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon SN addition and SN change. It is optionally present upon SN modification and inter-MN handover without SN change. Otherwise, the field is absent.","paragraph_zero_based":52886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52887},{"literal_text_all_w_t_and_m_t":"NOTE 3:The following table indicates per MN RAT and SN RAT whether RAT capabilities are included or not in ue-CapabilityInfo.","paragraph_zero_based":52888},{"literal_text_all_w_t_and_m_t":"MN RAT","paragraph_zero_based":52889},{"literal_text_all_w_t_and_m_t":"SN RAT","paragraph_zero_based":52890},{"literal_text_all_w_t_and_m_t":"NR capabilities","paragraph_zero_based":52891},{"literal_text_all_w_t_and_m_t":"E-UTRA capabilities","paragraph_zero_based":52892},{"literal_text_all_w_t_and_m_t":"MR-DC capabilities","paragraph_zero_based":52893},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":52894},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":52895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e69270f1833c74a7ed641e62ab6e9771d29cd7c3e1628f0b310f7b14322c8ddd","46b125d34cf07994b52422662ebdcd517eb2a42191c097597ed1778b0071ab33","5bbe085aa1dd5ea6fd163128099f5eb5c98f9686b910a52ff8517c2510266e9a","2ceaa55836bc35aec5eafab0281d9d03d533c8c7ff419b29690b8a9f2c82df32","dd6e362c22c11f4bdb34febe126ebb93d50c2320a395996008c92cc6587c4233","9a8edfa8b690f86f8a67242f962aab874331b2de40552da8f743c903d2438829","7667871f98e4afe141ec650386c0c5e224d608a9523d973436b8546506375e99","d3ad4026a36e528e28116bf5ebffa848cc8f798e437536dab16355c8193dc371","827c164aefba27dace73ed15a7336145460633623cca22f9b0775920e5263285","7ade97bee48898d62c78f4c958988bee0137ca5be8e7fe2f4a2034b8ee91ca6d","1fca302dacdb17cef564258a0fed16222bcc390de8c3ce364375b048501bddd6","d64c11536ac166e5a71fbcfa300df3226eb0178789b05b62d67e6fc783c8fc75","cc23fdb25bab53ae71980be3a73ad053995fd2d3fca0b6aa582bc6666e19310a","67a6f97d0611d89a2dd9bda63a31fdd5403a6654442bd62b361af0d14582b1e8","12e4e116058b9dc90c90bf25a70c87c2d222e928ae8224ccddb162f8cbe340ef","669606a708cec3ec1bdf744feedf61adcb560bf2f85466b5460750b3e4e3d9b6","fe3a0f7a444b508d732ec516552afcb7795896e6bcfb4e672f986dd96f8dda06","0830e2eac04cd97e565ee005b422c4dccd4eb0eda689b7253ace02545caf3b3c","2a95dd9da5497c540a5b16c28545b76a8d89e402fa1dcfc9e08cfb252ab46b7a","c4efa75f03f3ace926140095372176232bb0c8bc8a31dc0a8df0eaffd067a7e7","9f5f92440fc29bd14f21885b9297467fed980008530c8e825089b613c6c42d8f","5d2593b4bc02177fd385800a3e210ddd13977f0b8813d4f4236dc1212cc7fe95","cdd75b797fd2e87c22b0c25c2b14832306bac33c7a6cf8b368974446da3ca6a7","e53b68cf7fc6ab011fe51fee0572a029951767600f73a4fe341bee57e59f7b