{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sri-P0-PUSCH-AlphaSetId","paragraph_zero_based":29592},{"literal_text_all_w_t_and_m_t":"The ID of a P0-PUSCH-AlphaSet as configured in p0-AlphaSets in PUSCH-PowerControl.","paragraph_zero_based":29593},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-ClosedLoopIndex","paragraph_zero_based":29594},{"literal_text_all_w_t_and_m_t":"The index of the closed power control loop associated with this SRI-PUSCH-PowerControl.","paragraph_zero_based":29595},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PathlossReferenceRS-Id","paragraph_zero_based":29596},{"literal_text_all_w_t_and_m_t":"The ID of PUSCH-PathlossReferenceRS as configured in the pathlossReferenceRSToAddModList in PUSCH-PowerControl.","paragraph_zero_based":29597},{"literal_text_all_w_t_and_m_t":"sri-PUSCH-PowerControlId","paragraph_zero_based":29598},{"literal_text_all_w_t_and_m_t":"The ID of this SRI-PUSCH-PowerControl configuration. It is used as the codepoint (payload) in the SRI DCI field.","paragraph_zero_based":29599},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29600},{"literal_text_all_w_t_and_m_t":"–PUSCH-ServingCellConfig","paragraph_zero_based":29601},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ServingCellConfig is used to configure UE specific PUSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":29602},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig information element","paragraph_zero_based":29603},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29604},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":29605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29606},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":29607},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PUSCH-CodeBlockGroupTransmission }       OPTIONAL,   -- Need M","paragraph_zero_based":29608},{"literal_text_all_w_t_and_m_t":"    rateMatching                            ENUMERATED {limitedBufferRM}                            OPTIONAL,   -- Need S","paragraph_zero_based":29609},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED {xoh6, xoh12, xoh18}                         OPTIONAL,   -- Need S","paragraph_zero_based":29610},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29611},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29612},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..4)                                          OPTIONAL,   -- Need M","paragraph_zero_based":29613},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                 OPTIONAL    -- Need M","paragraph_zero_based":29614},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":29615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["59be21f1d96bb70c54882cac76d0d62217e43694398d9ede034141a909ad176b","d5e3e6766bd073ce55570553d6946ad6ba03fa5503f3da0834a7769b758f8014","b9bb5157cdc6dc9a64e58b0f93c412fd1f781559a30000ec98cf1694112f00e1","25dfdc914c193b38272959b1ea395f43f63b6be93bb0335455cfab4006d57f92","ac02f00c3dcdb26d09de96e26324d4af2a06a600eb61888c72496b5cc08329d1","f4f17e41764141595990416664a7a0250d9f0252b1c1c94e093d2370fd8e1708","187918d11c3e601ce1b401ed90b673aff3ffc2aa0a13fc13a8195f52013a2d56","d6e7d6cda41a493b944ebb4e760b318193971dc05