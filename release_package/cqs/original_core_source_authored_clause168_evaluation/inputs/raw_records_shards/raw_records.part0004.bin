{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23448},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-START","paragraph_zero_based":23449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23450},{"literal_text_all_w_t_and_m_t":"HysteresisLocation-r17 ::=          INTEGER (0..32768)","paragraph_zero_based":23451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23452},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISLOCATION-STOP","paragraph_zero_based":23453},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23455},{"literal_text_all_w_t_and_m_t":"–InvalidSymbolPattern","paragraph_zero_based":23456},{"literal_text_all_w_t_and_m_t":"The IE InvalidSymbolPattern is used to configure one invalid symbol pattern for PUSCH transmission repetition type B applicable for both DCI format 0_1 and 0_2, see TS 38.214 [19], clause 6.1.","paragraph_zero_based":23457},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern information element","paragraph_zero_based":23458},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23459},{"literal_text_all_w_t_and_m_t":"-- TAG-INVALIDSYMBOLPATTERN-START","paragraph_zero_based":23460},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23461},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern-r16 ::=     SEQUENCE {","paragraph_zero_based":23462},{"literal_text_all_w_t_and_m_t":"    symbols-r16                      CHOICE {","paragraph_zero_based":23463},{"literal_text_all_w_t_and_m_t":"        oneSlot                          BIT STRING (SIZE (14)),","paragraph_zero_based":23464},{"literal_text_all_w_t_and_m_t":"        twoSlots                         BIT STRING (SIZE (28))","paragraph_zero_based":23465},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":23466},{"literal_text_all_w_t_and_m_t":"    periodicityAndPattern-r16        CHOICE {","paragraph_zero_based":23467},{"literal_text_all_w_t_and_m_t":"        n2                               BIT STRING (SIZE (2)),","paragraph_zero_based":23468},{"literal_text_all_w_t_and_m_t":"        n4                               BIT STRING (SIZE (4)),","paragraph_zero_based":23469},{"literal_text_all_w_t_and_m_t":"        n5                               BIT STRING (SIZE (5)),","paragraph_zero_based":23470},{"literal_text_all_w_t_and_m_t":"        n8                               BIT STRING (SIZE (8)),","paragraph_zero_based":23471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4dd6e1508e48a0005a1f781d17987aaf4c33a1482ed4d35f58307b5643c89866","4c66cd927bc523572fbd602e31e900663c18544b322c4cc07993c7e2e5b7b674","ea1442b77dad91392164debbb2eee171256d6ba9b9102b4886b3f0ea32c3f0ca","34c847ec4114444488feef5c873a031c16945757afe2ede3bd29678eb1693b8b","a26d3fa374251e12ebfc1254c25841f13e92ae1de774bfef5ac0cfa7afeaf718","c1c1021cdd9b692762d2b7714cab5b920f95ae7a75f8cc29df283bf45782b541","34b44b1dd3acc385630bfb0a8f09cf0cd053034daffa0f7a92fe290c36581fe7","aa58b5d4543cbffbd9b0ccc31caaca8ae1085418deb26a4e9aa4b961c0e45231","eeb1f9946c55aeb87c4e4c1921d291b6415ab73f42aaa4199ac035568b2da156","e647e563a3a804703614a9602b3606d3487f0a6e6ab283cc482ca7e24bcb7af3","6cf9a689837633e08d30fb1ac963373914e96867fa6dc0383de2eb4daab06e99","3de37c31380e01539371b21e66a3b105dbcc3d09549a92fb790f27ef7987b4f0","ddc88215ea73d5acda22e2927f9419246eb8a7ad8d5a801ed8be3eeca197cc94","5811dc9ca422187687da62e2e39bbfe9e8e6a4aeec270b62f9a1cd52991c2519","84941268651bb77926cbeadf54318a58787ebb082ba531c6a179bea1b4ff73fd","5c557140416ef41af8087c661611467e5a229d538e3bf619ff4bd1a8135e1a61","3a6350733e4fe28d8d98cbe146ecfd42ff8200925207b6ac37839b242ac767ba","8c5ccee941b3d0a304c7083db6471838f2bdf694916f7c667baf5170481d10be","f8c07a4b80e4735d6a5100b8f42f01f7a12f06ff28cd434248a2affd05e03526","38c71b1f27730011bae49c97b4983dfbde47a3554cf15dd0c00bb430cec61c81","a3d68cbcd76db1830870808d52a5b149aef2f1ecca371142e10c9eb03e16a1d4","d04a4991bda3b7a0769eb86d4cafd9a3be09be84818dc80f2b976a48d44dd187","71925ac2fd132554aef64727f05dca636d9772e13203b8e3a88d4e287da383a0","6c630ec965d64a131ea4a64dbfa19c5f6413f038232dd8fa6396fedb7d9d5115"],"paragraph_range_zero_based":[23448,23471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23448"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        n10                              BIT STRING (SIZE (10)),","paragraph_zero_based":23472},{"literal_text_all_w_t_and_m_t":"        n20                              BIT STRING (SIZE (20)),","paragraph_zero_based":23473},{"literal_text_all_w_t_and_m_t":"        n40                              BIT STRING (SIZE (40))","paragraph_zero_based":23474},{"literal_text_all_w_t_and_m_t":"    }                                                                OPTIONAL,   -- Need M","paragraph_zero_based":23475},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23476},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23478},{"literal_text_all_w_t_and_m_t":"-- TAG-INVALIDSYMBOLPATTERN-STOP","paragraph_zero_based":23479},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23481},{"literal_text_all_w_t_and_m_t":"InvalidSymbolPattern field descriptions","paragraph_zero_based":23482},{"literal_text_all_w_t_and_m_t":"periodicityAndPattern","paragraph_zero_based":23483},{"literal_text_all_w_t_and_m_t":"A time domain repetition pattern at which the pattern defined by symbols recurs. This slot pattern repeats itself continuously. When the field is not configured, the UE uses the value n1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":23484},{"literal_text_all_w_t_and_m_t":"symbols","paragraph_zero_based":23485},{"literal_text_all_w_t_and_m_t":"A symbol level bitmap in time domain (see TS 38.214[19], clause 6.1).","paragraph_zero_based":23486},{"literal_text_all_w_t_and_m_t":"For oneSlot, if ECP is configured, the first 12 bits represent the symbols within the slot and the last two bits within the bitstring are ignored by the UE; Otherwise, the 14 bits represent the symbols within the slot.","paragraph_zero_based":23487},{"literal_text_all_w_t_and_m_t":"For twoSlots, if ECP is configured, the first 12 bits represent the symbols within the first slot and the next 12 bits represent the symbols in the second slot and the last four bits within the bit string are ignored by the UE; Otherwise, the first 14 bits represent the symbols within the first slot and the next 14 bits represent the symbols in the second slot.","paragraph_zero_based":23488},{"literal_text_all_w_t_and_m_t":"For the bits representing symbols in a slot, the most significant bit of the bit string represents the first symbol in the slot and the second most significant bit represents the second symbol in the slot and so on.","paragraph_zero_based":23489},{"literal_text_all_w_t_and_m_t":"This pattern recurs (in time domain) with the configured periodicityAndPattern.","paragraph_zero_based":23490},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23491},{"literal_text_all_w_t_and_m_t":"–I-RNTI-Value","paragraph_zero_based":23492},{"literal_text_all_w_t_and_m_t":"The IE I-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE.","paragraph_zero_based":23493},{"literal_text_all_w_t_and_m_t":"I-RNTI-Value information element","paragraph_zero_based":23494},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cbfa42acf6d292cef31d39db4d1343ea6f6b6c44460531d62fc7b86185deeca3","94b4ea54d198e706639d521aa70aa8f4eff1d0d5dc74f0e8e0145dc31924e7e2","27c1d7c38c85bb96bbd8b86c7f8a48a4c19748eb923a7d09f173820657fc9294","2