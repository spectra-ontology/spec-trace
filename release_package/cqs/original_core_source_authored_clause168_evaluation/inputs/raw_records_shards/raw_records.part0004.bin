{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30816},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigTwoTA","paragraph_zero_based":30817},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigTwoTA is used to specify random access parameters for each additional PCI configured for the serving cell.","paragraph_zero_based":30818},{"literal_text_all_w_t_and_m_t":"RACH-ConfigTwoTA information element","paragraph_zero_based":30819},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30820},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGTWOTA-START","paragraph_zero_based":30821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30822},{"literal_text_all_w_t_and_m_t":"RACH-ConfigTwoTA-r18 ::=     SEQUENCE {","paragraph_zero_based":30823},{"literal_text_all_w_t_and_m_t":"    rach-ConfigTwoTAIndex-r18    RACH-ConfigTwoTAIndex-r18,","paragraph_zero_based":30824},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGeneric-r18       RACH-ConfigGeneric,","paragraph_zero_based":30825},{"literal_text_all_w_t_and_m_t":"    ssb-perRACH-Occasion-r18     ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}   OPTIONAL,   -- Need M","paragraph_zero_based":30826},{"literal_text_all_w_t_and_m_t":"    prach-RootSequenceIndex-r18  CHOICE {","paragraph_zero_based":30827},{"literal_text_all_w_t_and_m_t":"        l839                         INTEGER (0..837),","paragraph_zero_based":30828},{"literal_text_all_w_t_and_m_t":"        l139                         INTEGER (0..139)","paragraph_zero_based":30829},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":30830},{"literal_text_all_w_t_and_m_t":"    msg1-SubcarrierSpacing-r18   SubcarrierSpacing                                                            OPTIONAL,   -- Cond L139","paragraph_zero_based":30831},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30832},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30834},{"literal_text_all_w_t_and_m_t":"RACH-ConfigTwoTAIndex-r18  ::=  INTEGER(1.. maxNrofAdditionalPRACHConfigs-r18)","paragraph_zero_based":30835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30836},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGTWOTA-STOP","paragraph_zero_based":30837},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d1bd0cc4f8c5261295b535883fb791b9014083a3d5d954ccc5daa2909c4df03d","0a99484ed9e547493ad7a8de229a84726a9ea4d9a9020d924784f7057850b730","87883cf693fa6f0f6329a87fdcacfcc0b35ea6ba646a535f088bdcead3999c16","2ea61b225fe175f5ab7072344affcc38d0bddf505d7846b817ea35958678472b","aafd578d9ef500ac0b3b9f2d05810b0147507b759987fb2d71afc7412c8bd558","bebdf2483188b0bdfdd9418dffdb6a51bf247b3a856cc9418598758bdd68b18a","7f35f72d86d988d75cb9a96176cb6e53b1623e40523ef3471bcb14b4560e43a5","5fe3e45268d08ccacf575c5bf7ff13b520aba11487c7a61e50d694a3b49ef5aa","b6e3119d0c1140a63b3370a6eec3853ed9883839d38c41c417e0b5838e40e1fa","05f019a08c59166dfcb06d8c4ec89b650a911410ab4e55620a77defb0a59035d","9b1c4996a63e249046a245fed7b9f3706daa8331aed4ca28c05d82980ba082b3","609b1e264ca790f8f36bd3a2f77dc45f5239cc5edc2f2281f36b92da5db176c6","d9898ac9627701fdd6b908ddd47876b7ba006ec0d73ba0f54a657143d617530d","07c36a43d7c007cd66008d6ee1e4fc9fab2ff085ae337df7afe7b1b41c81050c","91efbde58552ce08dc4fc90f99494abe6b411069a0ea610747dc1081e7f34