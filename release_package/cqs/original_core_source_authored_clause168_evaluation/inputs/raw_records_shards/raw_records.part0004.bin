{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A counter used to derive S-KgNB or S-KeNB based on the newly derived KgNB during RRC Resume. The field is only included when there is one or more RB with keyToUse set to secondary or mrdc-SecondaryCellGroup is included.","paragraph_zero_based":13416},{"literal_text_all_w_t_and_m_t":"sl-ConfigDedicatedNR","paragraph_zero_based":13417},{"literal_text_all_w_t_and_m_t":"This field is used to provide the dedicated configurations for NR sidelink communication/discovery used by L2 U2N Remote UE.","paragraph_zero_based":13418},{"literal_text_all_w_t_and_m_t":"sl-L2RemoteUE-Config","paragraph_zero_based":13419},{"literal_text_all_w_t_and_m_t":"Contains L2 U2N relay operation related configurations used by L2 U2N Remote UE. The field is absent if appLayerMeasConfig or SRB4 is configured/not released.","paragraph_zero_based":13420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13421},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":13422},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":13423},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":13424},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for L2 U2N Remote UE; otherwise it is absent.","paragraph_zero_based":13425},{"literal_text_all_w_t_and_m_t":"RestoreSCG","paragraph_zero_based":13426},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if restoreSCG is included. It is optionally present, Need M, otherwise.","paragraph_zero_based":13427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13428},{"literal_text_all_w_t_and_m_t":"–RRCResumeComplete","paragraph_zero_based":13429},{"literal_text_all_w_t_and_m_t":"The RRCResumeComplete message is used to confirm the successful completion of an RRC connection resumption.","paragraph_zero_based":13430},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":13431},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":13432},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":13433},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":13434},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete message","paragraph_zero_based":13435},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13436},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUMECOMPLETE-START","paragraph_zero_based":13437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13438},{"literal_text_all_w_t_and_m_t":"RRCResumeComplete ::=                   SEQUENCE {","paragraph_zero_based":13439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4604c1581e38e70c267f1e31dc7cbd6b22bb95c769596acf20d586b53305c299","2456c965ae9060ef7d40f909efb22a89bded74cd37fab50edda383e69404ee6b","db2e2dac5558de32380d03e7fbe0602dc2321782b682dbb634e5ac5f8a4d9887","6ec221e8f9e0de113f5a31d99d7616425b8f97f8517c0068000ba5412082e5d8","caa1c5add996bafe1bc85465bb51f8787f2195cc04ba22a5a461d1c5db4aa1a1","b54ce1ba585620a957022b3345a21d640f20d006e103bd8f3bb17366a6a63267","ca1f11569794f1e6f1db0d046a93a136dd4c750a5ab0ddaab20592e5fc107a7d","9daf9da79389335472a8f74493445a912612e396ee69c6336f8ebb8509161726","fd0b73e5df41615542746c9673c519e9bc73ae87d760a3a9c479385ab60d647f","752bf713c6d2ee821e6ab180d29c363f3f0c6f60c95129fdc54ef06ee1c00d90","3ccb5854d07ebd8b994f5ade1031a4f826e12e31e60403d4888e8e72e82de6d3","2d2c476ac21a3a684fe8f8427cc3014cec3dfdcfa5f18c0f725bb2f26ca0816f","93b4ae959d