{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46608},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIG-STOP","paragraph_zero_based":46609},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46611},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig field descriptions","paragraph_zero_based":46612},{"literal_text_all_w_t_and_m_t":"absenceOfAnyOtherTechnology","paragraph_zero_based":46613},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates absence on a long term basis (e.g. by level of regulation) of any other technology sharing the carrier; absence of this field indicates the potential presence of any other technology sharing the carrier, as specified in TS 37.213 [48] clauses 4.5. This parameter is not expected to be provided if the sidelink carrier is overlapped with uplink carrier.","paragraph_zero_based":46614},{"literal_text_all_w_t_and_m_t":"sl-EnergyDetectionConfig","paragraph_zero_based":46615},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the maxEnergyDetectionThreshold or the energyDetectionThresholdOffset (see TS 37.213 [48], clause 4.5.5).","paragraph_zero_based":46616},{"literal_text_all_w_t_and_m_t":"sl-EnergyDetectionThresholdOffset","paragraph_zero_based":46617},{"literal_text_all_w_t_and_m_t":"Indicates the offset to the default maximum energy detection threshold value. Unit in dB. Value -13 corresponds to -13dB, value -12 corresponds to -12dB, and so on (i.e. in steps of 1dB) as specified in TS 37.213 [48], clause 4.5.5.","paragraph_zero_based":46618},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khzSL","paragraph_zero_based":46619},{"literal_text_all_w_t_and_m_t":"Enable the NR SL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":46620},{"literal_text_all_w_t_and_m_t":"harq-ACK-FeedbackRatioforCW-AdjustmentGC-Option2","paragraph_zero_based":46621},{"literal_text_all_w_t_and_m_t":"Indicates the ratio threshold for contention window adjustment for SL groupcast option 2 as specified in TS 37.213 [48], clause 4.5.4. Unit is percentage.","paragraph_zero_based":46622},{"literal_text_all_w_t_and_m_t":"sl-MaxEnergyDetectionThreshold","paragraph_zero_based":46623},{"literal_text_all_w_t_and_m_t":"Indicates the absolute maximum energy detection threshold value. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm) as specified in TS 37.213 [48], clause 4.5.5.","paragraph_zero_based":46624},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencyPointA","paragraph_zero_based":46625},{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A.","paragraph_zero_based":46626},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB","paragraph_zero_based":46627},{"literal_text_all_w_t_and_m_t":"Indicates the frequency location of sidelink SSB. The transmission bandwidth for sidelink SSB is within the bandwidth of this sidelink BWP.","paragraph_zero_based":46628},{"literal_text_all_w_t_and_m_t":"sl-BWP-ToAddModList","paragraph_zero_based":46629},{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration is to be added or reconfigured. In this release, only one BWP is allowed to be configured for NR sidelink communication.","paragraph_zero_based":46630},{"literal_text_all_w_t_and_m_t":"sl-BWP-ToReleaseList","paragraph_zero_based":46631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6b5334a86aaeb16454d6b1fa06221e5e7e2dbcd4b9f59cc0b9c2365ec6cced95","706220d974b82be7998c2be457a072c7e8b00e63cfa34dea88e567500078aa67","074fe25067704997c9a092c19436e04188fbecede08b44c98dacaa029a2b9aed","f97893ccb058d36ac6ba16f665a2ee654e20337bfa56358ba3263679861ad051","e028b7d0155238021795203adc1b0d210db3d8c36c7675797b205adb9aa7ae5c","76ecfc4a8b552ac035eb327341df830866e74f196fed866119ea1524a44400ae","712e5add53b0ce6838ef8f017dbcdcf84cb254af96b460f6dae0ab0ddd69bba4","d10b4ca7e5105c19884a59c0502240c6a8655102fb4ccc8269ffac4d94c79679","76b35f73f0ff44793e60823b6fcf747f948ddf070d3c4e7a86c1068150618e28","ef1c7ce73234f20c2d3659fe632267a9bbbea8c8d794240b665e5c2333f718a5","bc49e5eecf21ba630cbf954e965fe73fb05d12d248026af689eeb477781bf5f3","15f85406a08f167a659a8c45e04dc43dcb4c24082b6846f08611e801e274c5e6","f984724b64283a5e76f1c754d674d8e7b2d3e5cf7becdaf34885f5fd57221b52","0f9cad958c8ebc14049024641e083447f48204722ed9079739e4400236f6e2aa","74c3a9f71d924b681811ae85ccbc089fe1fa819e470a61283d4328cef2f0530c","6b37ae018ab6413c082938604571a644416035c62b41c04b9ee3c2a815e09055","28e273e98f0b09a16dfc8ec1479ef1b5535c87fd8b165d6f3368e39a06c52b0e","2314eee0cd0d6b5d26cb53464ea2512fe3cb7f07f10c1f5460267608d77e50c4","197e7a2f0314c3b840f613c2cd8f4752f7ac1563285f5f2f2b5191000a3e5dac","c08816bf8bf53264a270372e646d5e602f9e51fbbdd06ce2376e3de734de2a1b","6e256fabd16c627288c6ceab517806f488db1c0662c5e0e08e9f0596070a2661","ab2df49c3a8409f5a75c13a48208056a9a1079a95fbeafb076fa1253652a738b","d1d965cb6bf71cd8cef213ba29ad80eda6996d6fdb6528771901c5ff16aeea59","8cf12d4644e887d85a3d94d14757f28c721c9a36670d7be990ce18eeac384651"],"paragraph_range_zero_based":[46608,46631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46608"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration is to be released. ","paragraph_zero_based":46632},{"literal_text_all_w_t_and_m_t":"sl-Freq-Id","paragraph_zero_based":46633},{"literal_text_all_w_t_and_m_t":"This field indicates the identity of the dedicated configuration information on the carrier frequency for NR sidelink communication.","paragraph_zero_based":46634},{"literal_text_all_w_t_and_m_t":"sl-SCS-SpecificCarrierList","paragraph_zero_based":46635},{"literal_text_all_w_t_and_m_t":"A set of UE specific channel bandwidth and location configurations for different subcarrier spacings (numerologies). Defined in relation to Point A. The UE uses the configuration provided in this field only for the purpose of channel bandwidth and location determination. In this release, only one SCS-SpecificCarrier is allowed to be configured for NR sidelink communication.","paragraph_zero_based":46636},{"literal_text_all_w_t_and_m_t":"sl-SyncTxDisabled","paragraph_zero_based":46637},{"literal_text_all_w_t_and_m_t":"Indicates that the carrier, even though equipped with synchronisation resources, cannot be used as a synchronisation carrier frequency to transmit S-SSB.","paragraph_zero_based":46638},{"literal_text_all_w_t_and_m_t":"sl-SyncPriority","paragraph_zero_based":46639},{"literal_text_all_w_t_and_m_t":"This field indicates synchronization priority order, as specified in clause 5.8.6. sl-SyncPriority is configured with the same value across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies.","paragraph_zero_based":46640},{"literal_text_all_w_t_and_m_t":"ue-ToUE-COT-SharingED-Threshold","paragraph_zero_based":46641},{"literal_text_all_w_t_and_m_t":"Indicates the energy detection threshold that a UE uses to initiate a channel occupancy with other UE(s), and the other UE(s) that shares the initiated channel occupancy shall use this configured parameter for accessing the channel(s) as specified in TS 37.213 [48], clause 4.5.5 for sidelink channel access. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm).","paragraph_zero_based":46642},{"literal_text_all_w_t_and_m_t":"valueN","paragraph_zero_based":46643},{"literal_text_all_w_t_and_m_t":"Indicate the NR SL transmission with a valueN *5kHz shift to the LTE raster. (see TS 38.101-1 [15], clause 5.4E.2).","paragraph_zero_based":46644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46645},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46646},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46647},{"literal_text_all_w_t_and_m_t":"V2X-SL-Shared","paragraph_zero_based":46648},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the carrier frequency configured for NR sidelink communication is shared by V2X sidelink communication. It is absent, Need R, otherwise.","paragraph_zero_based":46649},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46650},{"literal_text_all_w_t_and_m_t":"–SL-FreqConfigCommon","paragraph_zero_based":46651},{"literal_text_all_w_t_and_m_t":"The IE SL-FreqConfigCommon specifies the cell-specific configuration information on one particular carrier frequency for NR sidelink communication.","paragraph_zero_based":46652},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon information element","paragraph_zero_based":46653},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46654},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-START","paragraph_zero_based":46655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4a3204a4c70511fe5cbb5b1f94b51b7b80e0520b25aa003fdedee0646d6f86c7","4c9c470e0a213515921db0309575c7d601081ca668a0bea3ffc9ed8363bf0616","cea9d7eb58eb692624954e1914d3dd7526b5263cf6a2a5fe271ca49413031106","8c02795429077ae948615acae09b84522bc347bb935e24cd09c20f5619c26b4d","2cf67bb2991f152511a21c8728f90458a42f2eaec9bb1678ba9934425769911a","373f1f49592c9b4e8ad3b668eb520f243a2db3425f52d7b547f00897f9e8c1ce","11fb54905ec359aac0ff330dd0d0c04e42de2edd1efed96e2fca64e8b376f6e8","574794e557ef19a1147d769c41fd971161aed8cb93c84f065563f6f264df15a0","433e7b29a18260fbbefbf43d34a1d05742c5bc57400b3eafcbb66fee562a02eb","1bee2bfc0451bdc94312b6b635ce3191d91b3ff41bc137e88acaae0fbad1ff95","a3a34a2b27296e16fb2c820e1e708474c4d814598facbd792f721c51cab4860a","a40a740a0f155a3329cee5e9e4e5eddcfc9772cf78188dd47bf3f96968ce7202","193e3133e30fcbe5cdb8ee2e10821d6538d91656d870115864501164038f06cd","2296a635ceaab254e90809fc7a87a0ddf74fa3a918d8b6a764de94cfae58ade3","201b18eb5fd999ae4c17f0124af751e4272d5e86516c6be117237b2faa94dadc","70a433c3f1a96a522e3cbaa2d88fa47d3d59f0e241da609e5790de8b07299def","ee7f612806b64bc292acd83c976e8245709098438c170073409830ab12750c3b","e4a56031d9691f9705fef88801b3f5030a6f5a67d4f740c56aafc0cae23b2c49","72dca088e854451e2259115385686bc285c95ffc8a67dcf820a56841a71703ef","b1e5b29d3682f1fbe38c2b09dac1123f4581fa9e2f5be0cb2e3b91e1402f2dae","2e1de6b7026dfa44005795da4a71b97514c349ecbc9cae4af15fb631e21ff092","082b8a9a4c2799ee0ac18729c25b1df55c36e8d8e099f3c8075b93d1047fedd9","6d808a837b2d3f903584825ccf26df7604d80fafa2dcd1fb55e59006301fb371","29b84eece4ec08386aa3e35ef514b8316033b03506cdc0e07e7babeba65c87bc"],"paragraph_range_zero_based":[46632,46655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46632"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46656},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon-r16 ::=       SEQUENCE {","paragraph_zero_based":46657},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16    SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":46658},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16    ARFCN-ValueNR,","paragraph_zero_based":46659},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16       ARFCN-ValueNR                                                      OPTIONAL, -- Need R","paragraph_zero_based":46660},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16        ENUMERATED {true}                                                  OPTIONAL, -- Cond V2X-SL-Shared","paragraph_zero_based":46661},{"literal_text_all_w_t_and_m_t":"    valueN-r16                        INTEGER (-1..1),","paragraph_zero_based":46662},{"literal_text_all_w_t_and_m_t":"    sl-BWP-List-r16                   SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-ConfigCommon-r16 OPTIONAL, -- Need R","paragraph_zero_based":46663},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16               ENUMERATED {gnss, gnbEnb}                                          OPTIONAL, -- Need R","paragraph_zero_based":46664},{"literal_text_all_w_t_and_m_t":"    sl-NbAsSync-r16                   BOOLEAN                                                            OPTIONAL, -- Need R","paragraph_zero_based":46665},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16             SL-SyncConfigList-r16                                              OPTIONAL, -- Need R","paragraph_zero_based":46666},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46667},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46668},{"literal_text_all_w_t_and_m_t":"    sl-UnlicensedFreqConfigCommon-r18     SEQUENCE {","paragraph_zero_based":46669},{"literal_text_all_w_t_and_m_t":"        absenceOfAnyOtherTechnology-r18       ENUMERATED {true}                                           OPTIONAL, -- Need R","paragraph_zero_based":46670},{"literal_text_all_w_t_and_m_t":"        sl-FreqSelectionConfigList-r18        SEQUENCE (SIZE (1..8)) OF SL-FreqSelectionConfig-r18        OPTIONAL, -- Need R","paragraph_zero_based":46671},{"literal_text_all_w_t_and_m_t":"        sl-SyncTxDisabled-r18                 ENUMERATED {true}                                           OPTIONAL, -- Need R","paragraph_zero_based":46672},{"literal_text_all_w_t_and_m_t":"        sl-EnergyDetectionConfig-r18          CHOICE {","paragraph_zero_based":46673},{"literal_text_all_w_t_and_m_t":"            sl-MaxEnergyDetectionThreshold-r18    INTEGER (-85..-52),","paragraph_zero_based":46674},{"literal_text_all_w_t_and_m_t":"            sl-EnergyDetectionThresholdOffset-r18 INTEGER (-13..20)","paragraph_zero_based":46675},{"literal_text_all_w_t_and_m_t":"        }                                                                                                 OPTIONAL, -- Need R","paragraph_zero_based":46676},{"literal_text_all_w_t_and_m_t":"        ue-ToUE-COT-SharingED-Threshold-r18      INTEGER (-85..-52)                                       OPTIONAL, -- Need R","paragraph_zero_based":46677},{"literal_text_all_w_t_and_m_t":"        harq-ACK-FeedbackRatioforCW-AdjustmentGC-Option2-r18 INTEGER (10..100)                            OPTIONAL  -- Need R","paragraph_zero_based":46678},{"literal_text_all_w_t_and_m_t":"    }                                                                                                        OPTIONAL, -- Cond SIB12","paragraph_zero_based":46679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{