{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra-nr: the encoding of UE capabilities is defined in UE-MRDC-Capability.","paragraph_zero_based":44064},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of UE capabilities is defined in UE-EUTRA-Capability specified in TS 36.331 [10].","paragraph_zero_based":44065},{"literal_text_all_w_t_and_m_t":"For rat-Type set to utra-fdd: the octet string contains the INTER RAT HANDOVER INFO message defined in TS 25.331 [45].","paragraph_zero_based":44066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44067},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRAT-RequestList","paragraph_zero_based":44068},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-RequestList is used to request UE capabilities for one or more RATs from the UE.","paragraph_zero_based":44069},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList information element","paragraph_zero_based":44070},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44071},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-START","paragraph_zero_based":44072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44073},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList ::=        SEQUENCE (SIZE (1..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Request","paragraph_zero_based":44074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44075},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Request ::=            SEQUENCE {","paragraph_zero_based":44076},{"literal_text_all_w_t_and_m_t":"    rat-Type                                RAT-Type,","paragraph_zero_based":44077},{"literal_text_all_w_t_and_m_t":"    capabilityRequestFilter                 OCTET STRING                    OPTIONAL,   -- Need