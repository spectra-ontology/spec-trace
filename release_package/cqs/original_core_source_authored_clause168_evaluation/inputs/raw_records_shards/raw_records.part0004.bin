{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TAG-Id ::=                          INTEGER (0..maxNrofTAGs-1)","paragraph_zero_based":35232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35233},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-STOP","paragraph_zero_based":35234},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35235},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35236},{"literal_text_all_w_t_and_m_t":"TAG field descriptions","paragraph_zero_based":35237},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":35238},{"literal_text_all_w_t_and_m_t":"Indicates the TAG of the SpCell or an SCell, see TS 38.321 [3]. Uniquely identifies the TAG within the scope of a Cell Group (i.e. MCG or SCG).","paragraph_zero_based":35239},{"literal_text_all_w_t_and_m_t":"timeAlignmentTimer","paragraph_zero_based":35240},{"literal_text_all_w_t_and_m_t":"The timeAlignmentTimer for TAG with ID tag-Id, as specified in TS 38.321 [3].","paragraph_zero_based":35241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35242},{"literal_text_all_w_t_and_m_t":"–TAR-Config","paragraph_zero_based":35243},{"literal_text_all_w_t_and_m_t":"The IE TAR-Config is used to configure Timing Advance reporting in non-terrestrial networks and ATG network.","paragraph_zero_based":35244},{"literal_text_all_w_t_and_m_t":"TAR-Config information element","paragraph_zero_based":35245},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35246},{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-START","paragraph_zero_based":35247},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35248},{"literal_text_all_w_t_and_m_t":"TAR-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":35249},{"literal_text_all_w_t_and_m_t":"    offsetThresholdTA-r17               ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5, ms6 ,ms7, ms8, ms9, ms10, ms11, ms12,","paragraph_zero_based":35250},{"literal_text_all_w_t_and_m_t":"                                                   ms13, ms14, ms15, spare13, spare12, spare11, spare10, spare9, spare8, spare7,","paragraph_zero_based":35251},{"literal_text_all_w_t_and_m_t":"                                                   spare6, spare5, spare4, spare3, spare2, spare1}          OPTIONAL,    -- Need R","paragraph_zero_based":35252},{"literal_text_all_w_t_and_m_t":"    timingAdvanceSR-r17                 ENUMERATED {enabled}                                                OPTIONAL,    -- Need R","paragraph_zero_based":35253},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35254},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e96a5d9da40965a33fc287cf665c763ad9dbd757634d1e5dc4ada1d73ce2882d","e9a2ffdfed7ff17d815fa0c1afe0c5dec116cd21ae60e812916c9713fb3bc8b6","7dcc3fdbc328382cabba7dad3a4fe0021601cda74c559bf4f8777887f1e2ad98","e58633bb9e9393cb74049daba26f25ebab0dcb10472572ca7b018296a7cb6ac5","5d26aef0ed69eeddc39f315c29d1f5988da3286ad9fc25e6a9f740e96c5881c6","4935dce8b7d0f2d83526b574f267ab7cc1cb41a4180716e67187cb5ea863d807","6b2d8d282525b91423e49bf3e2d2879460590c04851048f898bd228578936af0","fc46a4ad68ed7857056421cae7ded21d917ad8578c07d87ed800960a9b78e92b","50a03a6c4ad9a2584e042d19c3c20636851a4ed2b19742286237c8e3108ef9ee","18f3636c0b700509e048c1bd8630d15b179054a45bb5fb4cc2dcbbc2f79265c3","a87b46f2f57b77e933a71d383cebe15294cc7ab331ea7f36f38cbf3266736491","052faf3fede8e92b2880647b7881ec01330070cd5d515a4f28719d4af7148861","4712d2a3f5db705b2