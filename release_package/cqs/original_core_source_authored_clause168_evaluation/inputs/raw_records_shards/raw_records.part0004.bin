{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":3840},{"literal_text_all_w_t_and_m_t":"2>if UE is configured with attemptCondReconfig; or","paragraph_zero_based":3841},{"literal_text_all_w_t_and_m_t":"2>if UE is configured with attemptLTM-Switch:","paragraph_zero_based":3842},{"literal_text_all_w_t_and_m_t":"3>reset MAC;","paragraph_zero_based":3843},{"literal_text_all_w_t_and_m_t":"3>release spCellConfig, if configured;","paragraph_zero_based":3844},{"literal_text_all_w_t_and_m_t":"3>release the MCG SCell(s), if configured;","paragraph_zero_based":3845},{"literal_text_all_w_t_and_m_t":"3>release delayBudgetReportingConfig, if configured and stop timer T342, if running;","paragraph_zero_based":3846},{"literal_text_all_w_t_and_m_t":"3>release overheatingAssistanceConfig , if configured and stop timer T345, if running;","paragraph_zero_based":3847},{"literal_text_all_w_t_and_m_t":"3>if MR-DC is configured:","paragraph_zero_based":3848},{"literal_text_all_w_t_and_m_t":"4>perform MR-DC release, as specified in clause 5.3.5.10;","paragraph_zero_based":3849},{"literal_text_all_w_t_and_m_t":"3>release idc-AssistanceConfig, if configured;","paragraph_zero_based":3850},{"literal_text_all_w_t_and_m_t":"3>release btNameList, if configured;","paragraph_zero_based":3851},{"literal_text_all_w_t_and_m_t":"3>release wlanNameList, if configured;","paragraph_zero_based":3852},{"literal_text_all_w_t_and_m_t":"3>release sensorNameList, if configured;","paragraph_zero_based":3853},{"literal_text_all_w_t_and_m_t":"3>release drx-PreferenceConfig for the MCG, if configured and stop timer T346a associated with the MCG, if running;","paragraph_zero_based":3854},{"literal_text_all_w_t_and_m_t":"3>release maxBW-PreferenceConfig for the MCG, if configured and stop timer T346b associated with the MCG, if running;","paragraph_zero_based":3855},{"literal_text_all_w_t_and_m_t":"3>release maxCC-PreferenceConfig for the MCG, if configured and stop timer T346c associated with the MCG, if running;","paragraph_zero_based":3856},{"literal_text_all_w_t_and_m_t":"3>release maxMIMO-LayerPreferenceConfig for the MCG, if configured and stop timer T346d associated with the MCG, if running;","paragraph_zero_based":3857},{"literal_text_all_w_t_and_m_t":"3>release minSchedulingOffsetPreferenceConfig for the MCG, if configured and stop timer T346e associated with the MCG, if running;","paragraph_zero_based":3858},{"literal_text_all_w_t_and_m_t":"3>release rlm-RelaxationReportingConfig for the MCG, if configured and stop timer T346j associated with the MCG, if running;","paragraph_zero_based":3859},{"literal_text_all_w_t_and_m_t":"3>release bfd-RelaxationReportingConfig for the MCG, if configured and stop timer T346k associated with the MCG, if running;","paragraph_zero_based":3860},{"literal_text_all_w_t_and_m_t":"3>release releasePreferenceConfig, if configured and stop timer T346f, if running;","paragraph_zero_based":3861},{"literal_text_all_w_t_and_m_t":"3>release onDemandSIB-Request if configured, and stop timer T350, if running;","paragraph_zero_based":3862},{"literal_text_all_w_t_and_m_t":"3>release referenceTimePreferenceReporting, if configured;","paragraph_zero_based":3863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4300868f3bc6b72aaf63740a558446bf39265ef655d8465ab8ddbcc4748fffb5","6d60c23090289e5e30b64742468098a91701b062e6e06707556e6ebaee559051","846172cf37190fbaa5432e68cd2c076bb14825c95c450248e73149f203bafd33","1cf8131e44cfd126a486c226e334a707c65f893b3cd7f3bfb5fdeab6c769