{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25824},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGACONFIGCOMMON-START","paragraph_zero_based":25825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25826},{"literal_text_all_w_t_and_m_t":"MsgA-ConfigCommon-r16 ::=           SEQUENCE {","paragraph_zero_based":25827},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonTwoStepRA-r16      RACH-ConfigCommonTwoStepRA-r16,","paragraph_zero_based":25828},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-Config-r16               MsgA-PUSCH-Config-r16                                      OPTIONAL --Cond InitialBWPConfig","paragraph_zero_based":25829},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25831},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGACONFIGCOMMON-STOP","paragraph_zero_based":25832},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25834},{"literal_text_all_w_t_and_m_t":"MsgA-ConfigCommon field descriptions","paragraph_zero_based":25835},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-Config","paragraph_zero_based":25836},{"literal_text_all_w_t_and_m_t":"Configuration of cell-specific MsgA PUSCH parameters which the UE uses for contention-based MsgA PUSCH transmission of this BWP. If the field is not configured for the selected UL BWP, the UE shall use the MsgA PUSCH configuration of initial UL BWP.","paragraph_zero_based":25837},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonTwoStepRA","paragraph_zero_based":25838},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free 2-step random access type procedure as well as for 2-step RA type contention based beam failure recovery in this BWP.","paragraph_zero_based":25839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25840},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25841},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25842},{"literal_text_all_w_t_and_m_t":"InitialBWPConfig","paragraph_zero_based":25843},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when MsgA-ConfigCommon is configured for the initial uplink BWP, or when MsgA-ConfigCommon is configured for a non-initial uplink BWP and MsgA-ConfigCommon is not configured for the initial uplink BWP, otherwise the field is optionally present, Need S.","paragraph_zero_based":25844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25845},{"literal_text_all_w_t_and_m_t":"–MsgA-PUSCH-Config","paragraph_zero_based":25846},{"literal_text_all_w_t_and_m_t":"The IE MsgA-PUSCH-Config is used to specify the PUSCH allocation for MsgA in 2-step random access type procedure.","paragraph_zero_based":25847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bcd9858b9e1951c95126501853e6b2fb434dcc17d02998fb329581ddc611141b","48162891cc724f489083e328274955327b2c1858ab368387ad27385e01316521","93f2ca50257108e307814c1788819f55d3d55318858f9c677b1dc8e6ad7c745a","6b3a2588c1963fdacb6676a941a6f42a946988201dbe740fb5293e36f2b569ad","8312617c4c11c9d0b68cae1529a64ee641e906ef40dc0c1ad525c6cdf27950b4","53cf8a346db9100cb54f5d931a6f3ea2bd4b2ef950c134d514a5064ae65f3a7b","a8e97e0ddf089312fd10088857c40d80e5b003d0c0437d61330a7f8e9741843d","f7ba1718680b50d72a2c652d3ad432cae431fb26948d78c96537e3eaddc15a02","9f7a1f979bc0a8a9309a9f934