fInterlacesPerMsgA-PO-r16                   INTEGER (1..10)                                               OPTIONAL, -- Need R","paragraph_zero_based":25475},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25476},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25478},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config-r16 ::=                       SEQUENCE {","paragraph_zero_based":25479},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-AdditionalPosition-r16               ENUMERATED {pos0, pos1, pos3}                                 OPTIONAL, -- Need S","paragraph_zero_based":25480},{"literal_text_all_w_t_and_m_t":"    msgA-MaxLength-r16                             ENUMERATED {len2}                                             OPTIONAL, -- Need S","paragraph_zero_based":25481},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-DMRS-CDM-Group-r16                  INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":25482},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-NrofPorts-r16                       INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":25483},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID0-r16                         INTEGER (0..65535)                                            OPTIONAL, -- Need S","paragraph_zero_based":25484},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID1-r16                         INTEGER (0..65535)                                            OPTIONAL  -- Need S","paragraph_zero_based":25485},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f37445