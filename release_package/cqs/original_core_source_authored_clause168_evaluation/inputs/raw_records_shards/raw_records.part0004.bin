{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE MeasIdToAddModList concerns a list of measurement identities to add or modify, with for each entry the measId, the associated measObjectId and the associated reportConfigId.","paragraph_zero_based":24552},{"literal_text_all_w_t_and_m_t":"MeasIdToAddModList information element","paragraph_zero_based":24553},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24554},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDTOADDMODLIST-START","paragraph_zero_based":24555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24556},{"literal_text_all_w_t_and_m_t":"MeasIdToAddModList ::=              SEQUENCE (SIZE (1..maxNrofMeasId)) OF MeasIdToAddMod","paragraph_zero_based":24557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24558},{"literal_text_all_w_t_and_m_t":"MeasIdToAddMod ::=                  SEQUENCE {","paragraph_zero_based":24559},{"literal_text_all_w_t_and_m_t":"    measId                              MeasId,","paragraph_zero_based":24560},{"literal_text_all_w_t_and_m_t":"    measObjectId                        MeasObjectId,","paragraph_zero_based":24561},{"literal_text_all_w_t_and_m_t":"    reportConfigId                      ReportConfigId","paragraph_zero_based":24562},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24563},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24564},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDTOADDMODLIST-STOP","paragraph_zero_based":24565},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24567},{"literal_text_all_w_t_and_m_t":"–MeasObjectCLI","paragraph_zero_based":24568},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectCLI specifies information applicable for SRS-RSRP measurements an