{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    n3c-BearerAssociated-r18                ENUMERATED{true}                                        OPTIONAL    -- Cond N3C MP","paragraph_zero_based":30960},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30961},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30962},{"literal_text_all_w_t_and_m_t":"DRB-ToReleaseList ::=                   SEQUENCE (SIZE (1..maxDRB)) OF DRB-Identity","paragraph_zero_based":30963},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30964},{"literal_text_all_w_t_and_m_t":"SecurityConfig ::=                      SEQUENCE {","paragraph_zero_based":30965},{"literal_text_all_w_t_and_m_t":"    securityAlgorithmConfig                 SecurityAlgorithmConfig                                 OPTIONAL,   -- Cond RBTermChange1","paragraph_zero_based":30966},{"literal_text_all_w_t_and_m_t":"    keyToUse                                ENUMERATED{master, secondary}                           OPTIONAL,   -- Cond RBTermChange","paragraph_zero_based":30967},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30968},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30970},{"literal_text_all_w_t_and_m_t":"MRB-ToAddModList-r17 ::=                SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-ToAddMod-r17","paragraph_zero_based":30971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30972},{"literal_text_all_w_t_and_m_t":"MRB-ToAddMod-r17 ::=                    SEQUENCE {","paragraph_zero_based":30973},{"literal_text_all_w_t_and_m_t":"    mbs-SessionId-r17                       TMGI-r17                                                OPTIONAL,   -- Cond MRBSetup","paragraph_zero_based":30974},{"literal_text_all_w_t_and_m_t":"    mrb-Identity-r17                        MRB-Identity-r17,","paragraph_zero_based":30975},{"literal_text_all_w_t_and_m_t":"    mrb-IdentityNew-r17                     MRB-Identity-r17                                        OPTIONAL,   -- Need N","paragraph_zero_based":30976},{"literal_text_all_w_t_and_m_t":"    reestablishPDCP-r17                     ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":30977},{"literal_text_all_w_t_and_m_t":"    recoverPDCP-r17                         ENUMERATED{true}                                        OPTIONAL,   -- Need N","paragraph_zero_based":30978},{"literal_text_all_w_t_and_m_t":"    pdcp-Config-r17                         PDCP-Config                                             OPTIONAL,   -- Cond PDCP","paragraph_zero_based":30979},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30980},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30982},{"literal_text_all_w_t_and_m_t":"MRB-ToReleaseList-r17 ::=               SEQUENCE (SIZE (1..maxMRB-r17)) OF MRB-Identity-r17","paragraph_zero_based":30983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4a68e3fd9f77bc22b50b2f9f7ef7f897937b1e42eb79ff14d635f174f58e6b0e","131f940f8087ff74116725c7ea116d7cfe428d19a3f75e75b49dc21feef7ea23","e4f7c64014544412569258a22ab22319397e3a879234dc381aa83c34d8649fa3","cb87984ba33477fb44e560d80d1136eed891d8c03e3889417ec72c5ad6068685","956a5317a3aa1d3a3c1401ec3e4aedd82f99359e9c72a3c9e7869bd09bfa9d40","4d596b6be9ea58f6f533d6ddd1f3292a43614a2347a1a48a0e9ac31da300c057","4d78613ab9984b3e0492dd17c5004125fc306795dec4c712a69847