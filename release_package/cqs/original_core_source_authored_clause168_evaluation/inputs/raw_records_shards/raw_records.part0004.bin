sed":36902},{"literal_text_all_w_t_and_m_t":"        harq-TxProcessModeTwoSidelink-r17        ENUMERATED {n8, n16},","paragraph_zero_based":36903},{"literal_text_all_w_t_and_m_t":"        scs-CP-PatternTxSidelinkModeTwo-r17      CHOICE {","paragraph_zero_based":36904},{"literal_text_all_w_t_and_m_t":"            fr1-r17                                  SEQUENCE {","paragraph_zero_based":36905},{"literal_text_all_w_t_and_m_t":"                scs-15kHz-r17                            BIT STRING (SIZE (16))                OPTIONAL,","paragraph_zero_based":36906},{"literal_text_all_w_t_and_m_t":"                scs-30kHz-r17                            BIT STRING (SIZE (16))                OPTIONAL,","paragraph_zero_based":36907},{"literal_text_all_w_t_and_m_t":"                scs-60kHz-r17                            BIT STRING (SIZE (16))                OPTIONAL","paragraph_zero_based":36908},{"literal_text_all_w_t_and_m_t":"            },","paragraph_zero_based":36909},{"literal_text_all_w_t_and_m_t":"            fr2-r17                                  SEQUENCE {","paragraph_zero_based":36910},{"literal_text_all_w_t_and_m_t":"                scs-60kHz-r17                            BIT STRING (SIZE (16))                OPTIONAL,","paragraph_zero_based":36911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c68d007a7468d512ea868de83532bd5199454345f3180df7da299329b67b49da","488712c1ea4961995fc57aaac72df5c8e4fc7908d9a7b6acc921b8e9f384c821","09fcfbccf0b2755146a818bd20a3e7b48ddac2058376a7c3856cf4e474dcac92","9a5ef429d54740b9ee9003266baa30e54e88b75a978c26047c970e41ee7b7a61","7cabe0940288374b095323b5c30cc40b652ac22b25c130cb6f7f92d830aa4d4f","e843f703fbcf52e2b5c3d12a2d339425