{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36505},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP ::=            SEQUENCE {","paragraph_zero_based":36506},{"literal_text_all_w_t_and_m_t":"    bwp-Id                                  BWP-Id,","paragraph_zero_based":36507},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz                           BOOLEAN,","paragraph_zero_based":36508},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation                 INTEGER (0..3301)","paragraph_zero_based":36509},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36511},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-STOP","paragraph_zero_based":36512},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36514},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP field descriptions","paragraph_zero_based":36515},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":36516},{"literal_text_all_w_t_and_m_t":"The BWP-Id of the corresponding uplink BWP.","paragraph_zero_based":36517},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":36518},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":36519},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":36520},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding uplink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":36521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36522},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell field descriptions","paragraph_zero_based":36523},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":36524},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell corresponding to the uplinkDirectCurrentBWP.","paragraph_zero_based":36525},{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP","paragraph_zero_based":36526},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":36527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ff99e2bef40edfbb86c3305ae851383c2527a25dcaf93fd0fdbd0d1c36c52374","cf8bc625d6cfe6578eff69acfa58fba09e7831aaf916b7feea829df8015ca54e","9ca360969a4a84bc13d14a5b887f421a439092cef8f67b5b24f483c66b69f7c4","d234d2518a299046c244ce5ec487f3203ff3f88f2467c108cdd39d7ff4d36e4b","3ef2f91a6c1748c5481c3a126c2cdee2fb467661135b68c11a8f629747673793","2601ad74077d3c3714b8582f9ec63f0e1e6bcff7b4774bedcf679c6d4035cdf4","f8f6e3f74b9e6c6594dc8076871ec6c283d0c5ef5eda1d793c7f809c7159b63c","5b553a2e26a683f388aebc7184c2808e21dca6a1bda2982f3ef7d71fd12f3fe0","429dc72b4fc129aa7fafc5717619f9741526545759524ff7c0eb325550270b06","934bddc5210a494000d5689443b08e0ad6c688ea0d7ab897a87d05a4c1fcb29d","80abd18c7b74bc4270b847e17