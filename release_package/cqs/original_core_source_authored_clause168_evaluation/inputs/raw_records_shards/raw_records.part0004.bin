text_all_w_t_and_m_t":"PosMeasGapPreConfigToReleaseList-r17 ::= SEQUENCE (SIZE (1..maxNrofPreConfigPosGapId-r17)) OF MeasPosPreConfigGapId-r17","paragraph_zero_based":24276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24277},{"literal_text_all_w_t_and_m_t":"PosGapConfig-r17 ::=                SEQUENCE {","paragraph_zero_based":24278},{"literal_text_all_w_t_and_m_t":"    measPosPreConfigGapId-r17           MeasPosPreConfigGapId-r17,","paragraph_zero_based":24279},{"literal_text_all_w_t_and_m_t":"    gapOffset-r17                       INTEGER (0..159),","paragraph_zero_based":24280},{"literal_text_all_w_t_and_m_t":"    mgl-r17                             ENUMERATED {ms1dot5, ms3, ms3dot5, ms4, ms5dot5, ms6, ms10, ms20},","paragraph_zero_based":24281},{"literal_text_all_w_t_and_m_t":"    mgrp-r17                            ENUMERATED {ms20, ms40, ms80, ms160},","paragraph_zero_based":24282},{"literal_text_all_w_t_and_m_t":"    mgta-r17                            ENUMERATED {ms0, ms0dot25, ms0dot5},","paragraph_zero_based":24283},{"literal_text_all_w_t_and_m_t":"    gapType-r17                         ENUMERATED {perUE, perFR1, perFR2},","paragraph_zero_based":24284},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":24285},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cf450ef38bf061d66675c21e52e5a5f78245a2a91503341f31d844807fc64da4","8f98c3132ed8c18a88f557a9e13a17c4634736a23b226b847a999e3615dac103","908aee4213948bb6a0e08e42101091230946fbf84b9ebc4b3779d9acdcdbfa11","c679ea5e5453e7b8739763c37735e0262ff14ca9390f72825312d5f218c5dd5d","35df449b387ca16452c89e82c7de583fee03452ab641414fee1e8fbdbde29a77","25c813f758bc8b6975399dcd38996a538e3743674d7d35224f8cea90ebd707e8","4cdd8d40c1d616a5221d43ba72b68e23fc4eb21159c5f153fbace6a595060337","77290306826f767089dfcf7280f2be9c1bdf7bc07588c34df1428972cb0d86a6","79f3f7613bfd61d74b373b4ba0dbadecbf7b74b014bfda56f57272a1223ca2f2","b4d607cc543fbd052a274dc8bafb47d8eaa418bf2127079af9beed5b1eea5d6a","d4d8e4fa907e7017f2bd94a6e055c42433c5145c543db38fae25c70f162062a6","4a6a8f0bd0d1b955fdd64e0ccf8c96af1b7c46e0c66f2215e01a31b7fadeb23d","487df7a6ff8e56f583776867503cad2f6e4e1183b71198644769ff21694a5c2b","38b74c662c83a00c0665e1d5f7c99cc55a99fe8e537b3ffc61fa4325671c332c","8ff9741ec0764f0f13c16b5e33c49c777e7c6deb300442981ae41ee7830379dc","3a3088454454aee03e1dbf4f696dbcae6c35bba330ebd8cb1fe0f8acde3a5028","cec060d3f206f5cd672af0064a1ca16e8d3e7fe2c4f34b0a47ed121cd27705e7","7a6d2a585da4dbef6aa0dc4edfb75b1d8011963dfb09bdda6582b9c4713db38c","c7fd7c8340a5313655500d2dca8a7685ab12996fd7f9ac26d9daff25eb1766f9","f4c1dd42bc577a659d35e7521b29e92d213f45eda8991b99ef144ca7a186d513","847d93d274b94d9f82ad30fb3cd2758ba23bbe3c450d59b4d22e1bf62969e4c6","939b9d7070de9e4679812c2b68c2b3f9c4d4c85be713c7e56be514bd3b87274d","4431bab190b51371d831e105b4d845df7f17d768ee20cad3da591412265550bb","b57b105e7f2d7c666899e71baa5bdac901949c873fe5a73db1b5badecd2d71bd"],"paragraph_range_zero_based":[24264,24287],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24264"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasPosPreConfigGapId-r17 ::= INTEGER (1..maxNrofPreConfigPosGapId-r17)","paragraph_zero_based":24288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24289},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPCONFIG-STOP","paragraph_zero_based":24290},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24292},{"literal_text_all_w_t_and_m_t":"MeasGapConfig field descriptions","paragraph_zero_based":24293},{"literal_text_all_w_t_and_m_t":"gapAssociationPRS","paragraph_zero_based":24294},{"literal_text_all_w_t_and_m_t":"Indicates that PRS measurement is associated with this measurement gap. The network only includes this field for one per-UE gap or for one per-FR gap. If concurrent gap (i.e. one of the gap combination as defined in Table 9.1.8-1 in TS 38.133 [14]) is configured and no gap is configured with this field, the PRS measurement is associated with the gap configured via GapConfig (without suffix), if available. If both per-UE gap and per-FR gap are configured via GapConfig and/or GapConfig-r17, the PRS measurement is always associated with the per-UE gap.","paragraph_zero_based":24295},{"literal_text_all_w_t_and_m_t":"gapFR1","paragraph_zero_based":24296},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration that applies to FR1 only. In (NG)EN-DC, gapFR1 cannot be set up by NR RRC (i.e. only LTE RRC can configure FR1 measurement gap). In NE-DC, gapFR1 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR1 gap). In NR-DC, gapFR1 can only be set up in the measConfig associated with MCG. gapFR1 can not be configured together with gapUE. The applicability of the FR1 measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":24297},{"literal_text_all_w_t_and_m_t":"gapFR2","paragraph_zero_based":24298},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration applies to FR2 only. In (NG)EN-DC or NE-DC, gapFR2 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR2 gap). In NR-DC, gapFR2 can only be set up in the measConfig associated with MCG. gapFR2 cannot be configured together with gapUE. The applicability of the FR2 measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":24299},{"literal_text_all_w_t_and_m_t":"gapOffset","paragraph_zero_based":24300},{"literal_text_all_w_t_and_m_t":"Value gapOffset is the gap offset of the gap pattern with MGRP indicated in the field mgrp. The value range is from 0 to mgrp-1. If ncsgInd-r17 is present, this offset value refers to the starting point of VIL1 (the visible interruption length before the ML).","paragraph_zero_based":24301},{"literal_text_all_w_t_and_m_t":"gapPriority","paragraph_zero_based":24302},{"literal_text_all_w_t_and_m_t":"Indicates the priority of this measurement gap (see TS 38.133 [14], clause 9.1.8.3). Value 1 indicates highest priority, value 2 indicates second level priority, and so on.","paragraph_zero_based":24303},{"literal_text_all_w_t_and_m_t":"gapSharing","paragraph_zero_based":24304},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to this GapConfig. For applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":24305},{"literal_text_all_w_t_and_m_t":"gapToAddModList","paragraph_zero_based":24306},{"literal_text_all_w_t_and_m_t":"A list of of measurement gap configuration to be added or modified. If more than one measurement gap is configured (i.e. concurrent measurement gap as specified in TS 38.133[14], clause 9.1.8), the maximum number of configured measurement gap is limited by the gap combinations defined in Table 9.1.8-1 in TS 38.133 [14]. In this version of the specification, the network configures this field only in NR standalone. This field is used only for a UE that supports pre-configured measurement gap, concurrent measurement gap, or NCSG. In this version of the specification, the network does not configure concurrent measurement gap together with MUSIM gap or preconfigured measurement gap for positioning.","paragraph_zero_based":24307},{"literal_text_all_w_t_and_m_t":"gapToReleaseList","paragraph_zero_based":24308},{"literal_text_all_w_t_and_m_t":"A list of measurement gap configuration to be released.","paragraph_zero_based":24309},{"literal_text_all_w_t_and_m_t":"gapType","paragraph_zero_based":24310},{"literal_text_all_w_t_and_m_t":"Indicates the type of this measurement gap. Value perUE indicates that it is a per UE measurement gap, value perFR1 indicates that it is an FR1 measurement gap, and value perFR2 indicates that it is an FR2 measurement gap.","paragraph_zero_based":24311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["61fc232dcf90ff27ad1d13072c72be5c06837f30ad11b8a9ddd275c1255faafc","2fa54e82615519aa119476df9757501d8a1696b055bdceda8ba528d6b957e729","ecc75e198ee791dddd55908062ddd3e3ac9f4ed2ea69afe211b11d301ba7a96f","30089aafcd71d4c522cc4dddffb2c65cbdfddeb63fca35f625dae514fac81153","d40085b7771742c7a5ae601e38c362a295c144e55153530e94393af1849de75d","b8e5d10e187c535a0f574e5e14aa7e3acd710a09e2157249c30a7dbf02f82304","33cfdbd5d278e03bb29d69671b761c3b1642d34c4e3edfda557a04371c691fd9","84081de9b67dbbd40992cc9b0e35286d666de8564f4c7f12ef0e598b3be43960","5e5414642b647e891180107321e6ac460f88cd571fb77a7a4ee7a9bbe9647361","4f5bb1fa5a4414627cf96ba4d6906971e9b837cb89bdf4cf7c5ec2204decbeee","2097145bad9e70b3811f6d97a956839c4a245c0b6a8d226a5178af59455751e6","6db1f03566b8bff5461f5bdc743eb484df77a926b728d3a7335af48f8d9d80a2","81b08e35481e0ad590fd95d275266bd71137a71efdc1eadc37fb8bf1186b1cb1","5ccfc68f87d6a363a8aba66a4e26ce8452f3df39b08890fafb9098d328b0a307","7b71e849d4eaffd0ac5e8aa394addb11640da0fa91dfc59ea12bbc0bfc470ea4","48c4e750d71511ec29eaead2c72f3f692416b47ab237daa6f0327c502590eda5","567cc3c30a495a4ee221ef9751855c52ee83c2085c3ed0e1437b65974333bed9","df03b17a07036dd65c1846cc8108d07967e5190e157d0449d6df3a21b59353c8","04a65033586c0a0e1805b7654eadf0d20ed733fa97e1b69d29b805003a03a2f8","35349c8a4a3f583dad91f01bda01086599b4eccc7367894898254944effc9d1d","cb5304f68b5ab7fa85ef694dc8f4393daaf46fb3f270429cd4d205df12a0c1a1","bf6ffba5e7fbee1b06d743cd2edbcc950ea7572a4551875850edeb4b0e66f7b6","0fb74e53b12fc38e17c95b6e71a72dbdf8c2d1d9976a92fa2ba3d34776a8fe9a","97fb93a0e05e05f947a568483f70f3ac238c29cc7c82165e60e1ecf495ed2abc"],"paragraph_range_zero_based":[24288,24311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24288"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"gapUE","paragraph_zero_based":24312},{"literal_text_all_w_t_and_m_t":"Indicates measurement gap configuration that applies to all frequencies (FR1 and FR2). In (NG)EN-DC, gapUE cannot be set up by NR RRC (i.e. only LTE RRC can configure per UE measurement gap). In NE-DC, gapUE can only be set up by NR RRC (i.e. LTE RRC cannot configure per UE gap). In NR-DC, gapUE can only be set up in the measConfig associated with MCG. If gapUE is configured, then neither gapFR1 nor gapFR2 can be configured. The applicability of the per UE measurement gap is according to Table 9.1.2-2 and Table 9.1.2-3 in TS 38.133 [14].","paragraph_zero_based":24313},{"literal_text_all_w_t_and_m_t":"measGapId","paragraph_zero_based":24314},{"literal_text_all_w_t_and_m_t":"The ID of this measurement gap configuration.","paragraph_zero_based":24315},{"literal_text_all_w_t_and_m_t":"mgl","paragraph_zero_based":24316},{"literal_text_all_w_t_and_m_t":"Value mgl is the measurement gap length in ms of the measurement gap. If ncsgInd-r17 is not present, the measurement gap length is according to in Table 9.1.2-1 in TS 38.133 [14]. If ncsgInd-r17 is present, this field indicates the measurement length (ML) in NCSG pattern and is configured according to Table 9.1.9.3-1 in TS 38.133 [14]. Value ms1dot5 corresponds to 1.5 ms, ms3 corresponds to 3 ms and so on. If mgl-r16 is present, UE shall ignore the mgl (without suffix). Value ms1, ms2, and ms5 can only be configured if ncsgInd is present.","paragraph_zero_based":24317},{"literal_text_all_w_t_and_m_t":"mgrp","paragraph_zero_based":24318},{"literal_text_all_w_t_and_m_t":"If ncsgInd-r17 is not present, the mgrp field indicates the measurement gap repetition period in (ms) of the measurement gap according to Table 9.1.2-1 in TS 38.133 [14]. If ncsgInd-r17 is present, the mgrp field indicates the Visible Interruption Repetition Period (VIRP) of NCSG pattern and is configured according to Table 9.1.9.3-1 in TS 38.133 [14].","paragraph_zero_based":24319},{"literal_text_all_w_t_and_m_t":"mgta","paragraph_zero_based":24320},{"literal_text_all_w_t_and_m_t":"Value mgta is the measurement gap timing advance in ms. The applicability of the measurement gap timing advance is according to clause 9.1.2 of TS 38.133 [14], or according to clause 9.1.9 of TS 38.133 [14] if ncsgInd is present. Value ms0 corresponds to 0 ms, ms0dot25 corresponds to 0.25 ms, ms0dot5 corresponds to 0.5 ms and ms0dot75 corresponds to 0.75 ms. For FR2, the network only configures 0 ms and 0.25 ms if ncsgInd is not present. If ncsgInd is present, the network only configures 0ms for per-UE NCSG and FR1 NCSG and only configures 0ms or 0.75ms for FR2 NCSG. Value ms0dot75 can only be configured if ncsgInd is present.","paragraph_zero_based":24321},{"literal_text_all_w_t_and_m_t":"ncsgInd","paragraph_zero_based":24322},{"literal_text_all_w_t_and_m_t":"Indicates that the measurement gap is a NCSG as specified in 38.133 [14].","paragraph_zero_based":24323},{"literal_text_all_w_t_and_m_t":"posMeasGapPreConfigToAddModList","paragraph_zero_based":24324},{"literal_text_all_w_t_and_m_t":"List of preconfigured measurement gap for positioning to add and/or modify. All the gaps configured are associated with the measurement of PRS for RSTD, UE-RxTx Time Difference, PRS-RSRP and PRS-RSRPP as defined in TS 38.215 [9]. In this version of the specification, the network does not configure preconfigured measurement gap for positioning together with concurrent measurement gap or MUSIM gap.","paragraph_zero_based":24325},{"literal_text_all_w_t_and_m_t":"posMeasGapPreConfigToReleaseList","paragraph_zero_based":24326},{"literal_text_all_w_t_and_m_t":"List of preconfigured measurement gap for positioning to release.","paragraph_zero_based":24327},{"literal_text_all_w_t_and_m_t":"preConfigInd","paragraph_zero_based":24328},{"literal_text_all_w_t_and_m_t":"Indicates whether the measurement gap is a pre-configured measurement gap.","paragraph_zero_based":24329},{"literal_text_all_w_t_and_m_t":"refFR2ServCellAsyncCA","paragraph_zero_based":24330},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 serving cell identifier whose SFN and subframe is used for FR2 gap calculation for this gap pattern with asynchronous CA involving FR2 carrier(s).","paragraph_zero_based":24331},{"literal_text_all_w_t_and_m_t":"refServCellIndicator","paragraph_zero_based":24332},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell whose SFN and subframe are used for gap calculation for this gap pattern. Value pCell corresponds to the PCell, pSCell corresponds to the PSCell, and mcg-FR2 corresponds to a serving cell on FR2 frequency in MCG.","paragraph_zero_based":24333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24334},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":24335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["fccef423ad55190fd5dc8506baba91a52d85f5df4b95962fffad2a0b4ada93f2","f0d947811654dc9cbb18251c7111bb9c606cfbd14abe245c46434b2d3ea24a2b","7ef9af7bee836a8274046ed2aa08cf8267ed488b3d4f92b5fb2e7b457f6a8289","97dfc329981d4705d124c7e59aa9fbe53d51cfca249a625ce71849415f682ad0","c548a5f8047f7e441e7252cc2410d1894363157cf8a231697e28250dcc674b34","7404fcee9cd8ac38ab77e96d3b94777ab764d1c2f10a7e059a0fc28c91b2dd6b","67143c100f256ca5a7b49f31c4cbab506c9a17589f56e2250ff737b514a88139","56b865ca6d1db690731f6bf6490221cd1d8698b4e8485bf86622f096edd28b2d","409389d4356f4ca4cddf5f2a86940abf3f4257e681551e2270f8e9d7c6707279","2a6e6d32ec713886a5719a16f990ca36f37f4531ff3a76994f294f1734db1cf0","8fdd3f135c87a478350a6bc94972fbabd7cf527fa1eef40ccc5768d5a2136990","13cf14aee975becf7f7f84e5c472e1cd684f6b3a524cf957b9b6bf6fb684b8b1","43f2487bac7a01f700b4c4304eb0bdb78fe3c08ae19d9025639b75c5900a926c","0e8614332cfb147376d1454bdd18ccb408d8eb6d9316b4a3d06cc2277c371571","59d847b01f0a618e3e1fcbe22c329f56abb07eaffa4cd6d99bcf3511211b8c80","94009235bfae30cbed53c1af2296937166dbf001dfd7f3ba4d08c8951af02e55","e5337bd30fcd6c38881af1776febdfe338f72edc3a3f09a253150cad1dc82936","f02bbb343530bd13befee9bfda60cbd4bb9d02542e6c7210cd246b9e4ea75706","9995bbc4fbb1f90c9c18d42128a87bbbed97de662d21b240c95511c3cbb7ab1a","67a9b30e1264adaa8a0f85a3b9fbfbe689f08bbf2618276fc5c15b9d090faf2b","ffd6240f71722ad8d6ff9d59c02e795753b5a23c00612ebb242cd50109fe95d3","9218a594602ef67b2411ce1cf20f657eceb3e44b344040340dca96c84f477259","b57151f8b60ce2dee19c656c63958f0af171130b557fa64f7fbd6c1f4c4a415c","e7596f6c7362c43d9ec14e5704548359c1bdfa965bee93aa8938a143bd52b1f6"],"paragraph_range_zero_based":[24312,24335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24312"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":24336},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":24337},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring and reconfiguring FR2 gap pattern to UE in:","paragraph_zero_based":24338},{"literal_text_all_w_t_and_m_t":"- (NG)EN-DC or NR SA with asynchronous CA involving FR2 carrier(s);","paragraph_zero_based":24339},{"literal_text_all_w_t_and_m_t":"- NE-DC or NR-DC with asynchronous CA involving FR2 carrier(s), if the field refServCellIndicator is set to mcg-FR2.","paragraph_zero_based":24340},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent, Need R.","paragraph_zero_based":24341},{"literal_text_all_w_t_and_m_t":"NEDCorNRDC","paragraph_zero_based":24342},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring and reconfiguring gap pattern to UE in NE-DC or NR-DC. Otherwise, it is absent, Need R.","paragraph_zero_based":24343},{"literal_text_all_w_t_and_m_t":"PRS","paragraph_zero_based":24344},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, when configuring gap pattern to UE for measurements of DL-PRS configured via LPP (TS 37.355 [49]). Otherwise, it is absent.","paragraph_zero_based":24345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24346},{"literal_text_all_w_t_and_m_t":"–MeasGapId","paragraph_zero_based":24347},{"literal_text_all_w_t_and_m_t":"The IE MeasGapId used to identify a per UE or per FR measurement gap configuration.","paragraph_zero_based":24348},{"literal_text_all_w_t_and_m_t":"MeasGapId information element","paragraph_zero_based":24349},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24350},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPID-START","paragraph_zero_based":24351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24352},{"literal_text_all_w_t_and_m_t":"MeasGapId-r17 ::=                       INTEGER (1..maxNrofGapId-r17)","paragraph_zero_based":24353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24354},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPID-STOP","paragraph_zero_based":24355},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24357},{"literal_text_all_w_t_and_m_t":"–MeasGapSharingConfig","paragraph_zero_based":24358},{"literal_text_all_w_t_and_m_t":"The IE MeasGapSharingConfig specifies the measurement gap sharing scheme and controls setup/ release of measurement gap sharing.","paragraph_zero_based":24359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0ed277f0c21626153df84dc50b7d6ca1b7bb2edfbb12d28bcd23fe6afdca0581","88ed311bdfedd82336c666219e27c0288dba8766a5586d88876de36cb33033a5","e981f0d03b257254afe6797b905468ac878b3fbd71c6a9c5e3d749faaf3ba460","e473918639ab862fd23e178f823153042670c27d8301f0fe76e0460d067751b4","24e24ecbc043f62e28f940cf7a63d75739ca6b90de38e4ff76410f82b5c2cb7b","57bd235e368adb8107388d7b45982a2b9418ec1a09dd3d6aba84c6fac0f2ec18","d1df55c738419a088c1495f269a16dcdf51a5c4a409e935fe144ea6c8372a6f2","e0af8d4b393aac3ff933b7e4cf533a9c4829c8674fc1a684cbcf74cd3ef8fc5d","77db72ad4d2de30c9d7237bcf5c9254870dd0bd2bcf2e017dcf13e4159d0da7c","f00fb1471355069d701d0de4bb6ec47f6ce5dfb7db6290e68de0b2ef97554874","0fac564bc27df813b211fd726fff5f7cba876968253fbd34e1908ef8fa8d5747","b394fa286b977f04a0c7c27f0a1719bdc7326cd845cab73d61ad74ccc489ca74","9fb395470661bf77fc4d3d92700dddebe6fe8e90f63ca32a0e9c9cfb17c9ef46","8b01e55b1f44e01450d0cebf76c9eee2d8bf8e165f3d84c35494755bc45e7cbd","4728a21f6e711da81467fe15cded9bf5393720dfc5e674330e884a9bc6f5a7e6","e9b38a96c61e5b143594617ba037c36dc181fc63a41c29d6402f20b88f529cc8","64abd2f87f841bc394321a73336fd75f77b9cde5ff5cde83e791cc284d547a25","9d3771093c1990c1544e22e6ee3d745123c2a603ca1f7a51805b668ad92f7c2f","b799089566289d6b0f306281ce74435db3aaaf1f3c06638ac9dcc1cc2eefc963","33830b6460d8e9dceb892acd35e2d89ebb7e2900447770dcbeb9ca58d611b4ee","a712c517146cad3a0ac7daa94d3c8b592bf16f5c25204d36385c9db39bc0f13f","87f9a846bdce3fd5088cf143729a4381eb4446cba74e78a42a4b33c4ccb1c39b","096ceca70d504a6dc79b77beab19df9d077a3990f11814695a15e22745e39300","2f75431f11ea4fc58d71d4a9e7308bc90123e2ec1371edc1c4bec778d28fa404"],"paragraph_range_zero_based":[24336,24359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24336"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig information element","paragraph_zero_based":24360},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24361},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-START","paragraph_zero_based":24362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24363},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig ::=        SEQUENCE {","paragraph_zero_based":24364},{"literal_text_all_w_t_and_m_t":"    gapSharingFR2                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   -- Need M","paragraph_zero_based":24365},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24366},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24367},{"literal_text_all_w_t_and_m_t":"    gapSharingFR1                   SetupRelease { MeasGapSharingScheme }       OPTIONAL,   --Need M","paragraph_zero_based":24368},{"literal_text_all_w_t_and_m_t":"    gapSharingUE                    SetupRelease { MeasGapSharingScheme }       OPTIONAL    --Need M","paragraph_zero_based":24369},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":24370},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":24371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24372},{"literal_text_all_w_t_and_m_t":"MeasGapSharingScheme::=         ENUMERATED {scheme00, scheme01, scheme10, scheme11}","paragraph_zero_based":24373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24374},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPSHARINGCONFIG-STOP","paragraph_zero_based":24375},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24377},{"literal_text_all_w_t_and_m_t":"MeasGapSharingConfig field descriptions","paragraph_zero_based":24378},{"literal_text_all_w_t_and_m_t":"gapSharingFR1","paragraph_zero_based":24379},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR1. In (NG)EN-DC, gapSharingFR1 cannot be set up by NR RRC (i.e. only LTE RRC can configure FR1 gap sharing). In NE-DC, gapSharingFR1 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR1 gap sharing). In NR-DC, gapSharingFR1 can only be set up in the measConfig associated with MCG. gapSharingFR1 can not be configured together with gapSharingUE. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":24380},{"literal_text_all_w_t_and_m_t":"gapSharingFR2","paragraph_zero_based":24381},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapFR2. In (NG)EN-DC or NE-DC, gapSharingFR2 can only be set up by NR RRC (i.e. LTE RRC cannot configure FR2 gap sharing). In NR-DC, gapSharingFR2 can only be set up by MCG in the measConfig associated with MCG. gapSharingFR2 cannot be configured together with gapSharingUE. For applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":24382},{"literal_text_all_w_t_and_m_t":"gapSharingUE","paragraph_zero_based":24383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7c0d4f0d3f7ce9421f98e334d436838411b17cacbf077ad5e22e2ceeae4c65b8","225114d767602ce413c04f354495a744230b2d992697d2293906a3dc73423f56","ed248e466323b6916fa624305b8fbd4a8f3d7c35f55be7850f8094dd1840db72","9fdaa40ef93ce2710c08c19c470f1820ee6a0887d3161ef0eb6c0d724f98b99e","0aee850c571faaeb7d78334e411b50c965dc2958ad22b8c04a34c7462b827a9d","78ffaa9b56d4a577f1a311ea96a384ce72053b8f35aa229c210c25221241db08","5c0308100ba126fcd3d8f9cfb19814fae7e60e92df54e41d8e4ea202b59bb1f9","d042c2c1f546686b29fec1aa1967ae6da4ba2989ec6e147fda60039631a766ca","bcdfb0366637e7f663c2cf08fe0eaf9b9d30dbb60583e90c5943ee771b4a6146","d6ecf9bc1643d758231932dec321d3d5181a7bd40ec516980deaf2538b03004b","88ef467f0e7191365c8dc3c9953b489432318e9e4e11a419a0a2853de1fd9a16","4a4ca6b255d45ed4a534e748b6f510c551eb993958b2697cef72986b67187955","5a43f56e373148207344208c25d2d455c877dd4c5c9e0c1958aaa99a96de8fec","42e10cca0bacea14ae9a01be00dca6d102cdb01ced00a5a2e2eb3a3ec0d1b75f","57300f6e744f397cccbfc65fc8cea15370b5a1fc1bb43f88402af3202530ce45","6e09d2985d8a3e6cc94a294379349b9afefdec99f7d2de60d3dd03093805c9fa","0cfcfb6eb6945a88f41a1d16df15af5af9c5b39414c59638a29e766bf52e40e7","a5e67ebbd4680feba3bc8a7501dc3bd82ada418d900688875aafc55dfea9c8cb","d13ef201317fabc0978453760ccc951c6488fefe83f91de101a89ebe70cccfc9","3650949179489affcdf190ce3260d614533554ba33e5f4eb3480e4800bb15eea","fc8a51e5883a14b7a89a233152cb63c22258c582a0b75913d759fa2e93d1a8be","9893dfffc54cb1657ec26cf29365c75eee2bba9ad5813612bd69cb098fd60c73","2a24d21af739ff5233238774457de3ac33394f89b9a29b56d20940c90766aa28","706b746495b0031fefcf1028c789c6adff844d9cd4d5f63e41da58379c628832"],"paragraph_range_zero_based":[24360,24383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24360"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap sharing scheme that applies to the gap set via gapUE. In (NG)EN-DC, gapSharingUE cannot be set up by NR RRC (i.e. only LTE RRC can configure per UE gap sharing). In NE-DC, gapSharingUE can only be set up by NR RRC (i.e. LTE RRC cannot configure per UE gap sharing). In NR-DC, gapSharingUE can only be set up in the measConfig associated with MCG. If gapSharingUE is configured, then neither gapSharingFR1 nor gapSharingFR2 can be configured. For the applicability of the different gap sharing schemes, see TS 38.133 [14]. Value scheme00 corresponds to scheme \"00\", value scheme01 corresponds to scheme \"01\", and so on.","paragraph_zero_based":24384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24385},{"literal_text_all_w_t_and_m_t":"–MeasId","paragraph_zero_based":24386},{"literal_text_all_w_t_and_m_t":"The IE MeasId is used to identify a measurement configuration, i.e., linking of a measurement object and a reporting configuration.","paragraph_zero_based":24387},{"literal_text_all_w_t_and_m_t":"MeasId information element","paragraph_zero_based":24388},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24389},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-START","paragraph_zero_based":24390},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24391},{"literal_text_all_w_t_and_m_t":"MeasId ::=                          INTEGER (1..maxNrofMeasId)","paragraph_zero_based":24392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24393},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASID-STOP","paragraph_zero_based":24394},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":24395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24396},{"literal_text_all_w_t_and_m_t":"–MeasIdleConfig","paragraph_zero_based":24397},{"literal_text_all_w_t_and_m_t":"The IE MeasIdleConfig is used to convey information to UE about measurements requested to be done while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":24398},{"literal_text_all_w_t_and_m_t":"MeasIdleConfig information element","paragraph_zero_based":24399},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24400},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASIDLECONFIG-START","paragraph_zero_based":24401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24402},{"literal_text_all_w_t_and_m_t":"MeasIdleConfigSIB-r16 ::= SEQUENCE {","paragraph_zero_based":24403},{"literal_text_all_w_t_and_m_t":"    measIdleCarrierListNR-r16       SEQUENCE (SIZE (1..maxFreqIdle-r16)) OF MeasIdleCarrierNR-r16          OPTIONAL,     -- Need S","paragraph_zero_based":24404},{"literal_text_all_w_t_and_m_t":"    measIdleCarrierListEUTRA-r16    SEQUENCE (SIZE (1..maxFreqIdle-r16)) OF MeasIdleCarrierEUTRA-r16       OPTIONAL,     -- Need S","paragraph_zero_based":24405},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24406},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["885634e5d76076f9ca488ae8db35bb47d8fc6b03f6d825ddf51aaa1884e1575c","c0e6eb1d67ca845e9baf30a6fda925d3d6a959b27357d260b455ef7c6b178a93","3e022fdc2d57442b4fc0254f1dabdbc785fa79cd67402aae9a6745b3c92e66f5","a6814276c781921fbb97cd466081af81405bee0f3064ab9060d274d960d2f7dd","752650b94d89a09cbbbfae97e6a3a99ef2f221bb66d0110e9db55379f4440946","d7f6018f304d0e3f32214bb2349c5eabb6777f1e3fba8177f8207402109f9513","67a3468919b3563a77aa315dfda37f1f16ea96245