{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringRS-Id ::=            INTEGER (0..maxNrofFailureDetectionResources-1)","paragraph_zero_based":31152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31153},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOLINKMONITORINGRS-ID-STOP","paragraph_zero_based":31154},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31156},{"literal_text_all_w_t_and_m_t":"–RAN-AreaCode","paragraph_zero_based":31157},{"literal_text_all_w_t_and_m_t":"The IE RAN-AreaCode is used to identify a RAN area within the scope of a tracking area.","paragraph_zero_based":31158},{"literal_text_all_w_t_and_m_t":"RAN-AreaCode information element","paragraph_zero_based":31159},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31160},{"literal_text_all_w_t_and_m_t":"-- TAG-RAN-AREACODE-START","paragraph_zero_based":31161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31162},{"literal_text_all_w_t_and_m_t":"RAN-AreaCode ::=                INTEGER (0..255)","paragraph_zero_based":31163},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31164},{"literal_text_all_w_t_and_m_t":"-- TAG-RAN-AREACODE-STOP","paragraph_zero_based":31165},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31167},{"literal_text_all_w_t_and_m_t":"–RateMatchPattern","paragraph_zero_based":31168},{"literal_text_all_w_t_and_m_t":"The IE RateMatchPattern is used to configure one rate matching pattern for PDSCH, see TS 38.214 [19], clause 5.1.4.1.","paragraph_zero_based":31169},{"literal_text_all_w_t_and_m_t":"RateMatchPattern information element","paragraph_zero_based":31170},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31171},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERN-START","paragraph_zero_based":31172},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31173},{"literal_text_all_w_t_and_m_t":"RateMatchPattern ::=                SEQUENCE {","paragraph_zero_based":31174},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternId                  RateMatchPatternId,","paragraph_zero_based":31175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a8c911846af0fec72c9a4f78e362633d076e53738f730d1f1e563ce6b8920f29","e5aa8bd69a4c743801a3cbd4b89271594427fc2dd604aeb96124c07119e19bc8","a246a71d929b507e913ab69842fcbc4ae71f5dbb62d74c8fa24fb351eec66e7f","361ac07d3724a37285974cecd67bb2d03e81b2708fe55950f3deef1bdf915675","db3e75634dc5943bfbc3a4e6e24327e0f743f26f960642403e62843473f41f5d","1ef3352c5296685786935e36753484ee925412715df4e13ca6ff291ce628cada","4c9c4224bab62fdf26bf1b3aa997413467fc2842d06efd373c62e7231225b80c","4acd9a42ede6829998950a4487e646b477fb3d534d3da2c95a5178deb1687cd6","a207a5b86d8746145ab8219e6d0d232dd7e192dccf7ee76c2bd98846b3875351","4698d0a4e1d5f1f04b6e74125f72b4eef460d0e96948608306a97d1aa2820aca","212f23972a57f1f24d15f6b74895b63f18c4f64eb763a9127975469827f50301","51ac0cf57d838f723a9edc15da7ed0bc73ed6da9c6f84d56925411fbf822bfb9","02de537164c7bc93cc223a24dcbd0e122ee36294b8b5bfb82910c25ddb6dbb7f","3b6ce7e2da9a70dcdba3c2262e3b1e1901d06665246051594550091ef4e558af","901e60a483b4e335b86fa5337637274b664d74dbb1d61f6734cb69e3ccd05bdb","a4f46d7ecee3d8c68b7fd48a0aacd81bbf5ca6392b71e13d68d85cb049bd147f","f9d03dc13cffefc2e3d38b24bde0be67a70ceeb41d6f3e4e9ed7e1d32ac575bb","e6e6f17804cab6aad2d1f56d4d91b7bd58a36a424643cded04bcd00f106537af","f6a