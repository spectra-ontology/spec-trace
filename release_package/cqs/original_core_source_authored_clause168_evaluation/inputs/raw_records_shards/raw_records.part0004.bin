{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28296},{"literal_text_all_w_t_and_m_t":"-- TAG-PDU-SESSIONID-START","paragraph_zero_based":28297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28298},{"literal_text_all_w_t_and_m_t":"PDU-SessionID ::=   INTEGER (0..255)","paragraph_zero_based":28299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28300},{"literal_text_all_w_t_and_m_t":"-- TAG-PDU-SESSIONID-STOP","paragraph_zero_based":28301},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28303},{"literal_text_all_w_t_and_m_t":"–PHR-Config","paragraph_zero_based":28304},{"literal_text_all_w_t_and_m_t":"The IE PHR-Config is used to configure parameters for power headroom reporting.","paragraph_zero_based":28305},{"literal_text_all_w_t_and_m_t":"PHR-Config information element","paragraph_zero_based":28306},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28307},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-START","paragraph_zero_based":28308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28309},{"literal_text_all_w_t_and_m_t":"PHR-Config ::=                      SEQUENCE {","paragraph_zero_based":28310},{"literal_text_all_w_t_and_m_t":"    phr-PeriodicTimer                   ENUMERATED {sf10, sf20, sf50, sf100, sf200,sf500, sf1000, infinity},","paragraph_zero_based":28311},{"literal_text_all_w_t_and_m_t":"    phr-ProhibitTimer                   ENUMERATED {sf0, sf10, sf20, sf50, sf100,sf200, sf500, sf1000},","paragraph_zero_based":28312},{"literal_text_all_w_t_and_m_t":"    phr-Tx-PowerFactorChange            ENUMERATED {dB1, dB3, dB6, infinity},","paragraph_zero_based":28313},{"literal_text_all_w_t_and_m_t":"    multiplePHR                         BOOLEAN,","paragraph_zero_based":28314},{"literal_text_all_w_t_and_m_t":"    dummy                               BOOLEAN,","paragraph_zero_based":28315},{"literal_text_all_w_t_and_m_t":"    phr-Type2OtherCell                  BOOLEAN,","paragraph_zero_based":28316},{"literal_text_all_w_t_and_m_t":"    phr-ModeOtherCG                     ENUMERATED {real, virtual},","paragraph_zero_based":28317},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28318},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a0d6347b91cc07118e0400b4b9bd009a17adbe184b519d9cc49daa02e24a928a","4d9f60918dfac23870549384f3c686717ce646a73145891e70c7637ebd7f888a","5085fa94aa75eb6a2fd6a2895f8beeef7bffc47cafcc3baebeeedeb9fdfddfb3","15aeef3ecd6552f3235a2ea6750510c0daada6df3c405cc0aabf70824d2330b1","c369b5b28edcea30099bdb173d636cc5f68bd47af5b1fde13670bfad0e517750","7891d47b7da7fffdc3d3621e7bb079cdd4bcb7d45345da34f4968948bdddf8e2","380c0fbcd2b943b3f1106ab7345524a4bdc005c6edc5db51f837080cf75492e3","ae0ce54b28f59fd3ecf1c58488241ef11751db99441dadfa5d417eaa0bf5bdbe","23f16a57f1e13d64c9f04274126b09f01c73ceeaad0a08aac46717b934934564","7e0757d9c0390f994be0500a34bc8c5ad78f8ba2ee18618a63b7c9ef68151ec8","a43ed44a9c8c05f6d7990398ca5c032b24af9c6446320847c66f2f2a6609fff1","4446961b65acce2afbfcfff9d199f160abe0d71a397ca074d2b801329070c8eb","324fffe4d53afc6e996058bd797ac59f763bff3875b4a287db13b5f16cc06779","46917190952951e075b0af5c7092b47cf39102878677d0365fd94b586325fa7d","7a9f601b4e0487bd7e53c35245aaa88e731c288edc6be6d9acb2390f7b163fc8","27edc3573b64a6c6939c1202148f7fca7c74df5e2e689966e796333c7d00857b","89cf78bc01a3ce5