sed":35823},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config information element","paragraph_zero_based":35824},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35825},{"literal_text_all_w_t_and_m_t":"-- TAG-UL-GAPFR2-CONFIG-START","paragraph_zero_based":35826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35827},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config-r17 ::=      SEQUENCE {","paragraph_zero_based":35828},{"literal_text_all_w_t_and_m_t":"    gapOffset-r17                 INTEGER (0..159),","paragraph_zero_based":35829},{"literal_text_all_w_t_and_m_t":"    ugl-r17                       ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms1},","paragraph_zero_based":35830},{"literal_text_all_w_t_and_m_t":"    ugrp-r17                      ENUMERATED {ms5, ms20, ms40, ms160},","paragraph_zero_based":35831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c351450cad6493b0c9ab5d48d3ce51247bcde44f5c0baeefae4ef89589d45f28","ec14d393d804d04117f35f377f78cb04cb02c032e946bd9cf7690a1ca04a7599","db69fbd5e187fbbbf861ad42950b2e7aef9222088f16c5aa181f8b637e4ae08b","2e9935c9edfcb3a09e6e63c355112dae49810560ff55028929ecbcd726a7b87f","ffc46015d3e02a92208b5cbd3062a8b200a5b7feb7f3b66d5ffad69ebc6ee8df","b6433bc7f903f743318a64eea672bc49b9c8b9d9912ce725cc427e249db356ef","a2f1eee6315bfa50203f4d472ccabe1e40b5e4a48be0f3f07aa05c0129dfec6a","6b76a3747f71f1fc30a44603a7b79c07670b54b556ae9fea23bc1dad67411c46","fd493d5d13352aa12dc68d5e72c20c185c6034607932d3d0209d5a44404b9f76","4f5a1f52f26fe3f56d67a751f234d02c798b695120e002a96e8588e638edb13a","d1008d6f92f003d54d250902e95e49a0725be3038ab2c15197019858017dd6c4","434dc72e0d39964e23bfdaacd01f2a8e112e8229b7335d8968e07647ab