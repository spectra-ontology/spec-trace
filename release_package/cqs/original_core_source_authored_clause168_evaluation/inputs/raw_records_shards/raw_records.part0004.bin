{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"noSIB1","paragraph_zero_based":19968},{"literal_text_all_w_t_and_m_t":"Contains ssb-SubcarrierOffset and pdcch-ConfigSIB1 fields acquired by the UE from MIB of the cell for which report CGI procedure was requested by the network in case SIB1 was not broadcast by the cell.","paragraph_zero_based":19969},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":19970},{"literal_text_all_w_t_and_m_t":"Contains cellReservedForOtherUse field acquired by the UE that supports nr-CGI-Reporting-NPN from SIB1 of the cell for which report CGI procedure was requested by the network.","paragraph_zero_based":19971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19972},{"literal_text_all_w_t_and_m_t":"–CGI-Info-Logging","paragraph_zero_based":19973},{"literal_text_all_w_t_and_m_t":"The IE CGI-Info-Logging indicates the NR Cell Global Identifier (NCGI) for logging purposes (e.g. RLF report), the globally unique identity, and the TAC information of a cell in NR.","paragraph_zero_based":19974},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging information element","paragraph_zero_based":19975},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19976},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-START","paragraph_zero_based":19977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19978},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging-r16 ::=     SEQUENCE {","paragraph_zero_based":19979},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-r16                    PLMN-Identity,","paragraph_zero_based":19980},{"literal_text_all_w_t_and_m_t":"    cellIdentity-r16                     CellIdentity,","paragraph_zero_based":19981},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16                 TrackingAreaCode               OPTIONAL","paragraph_zero_based":19982},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19984},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFO-LOGGING-STOP","paragraph_zero_based":19985},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19987},{"literal_text_all_w_t_and_m_t":"CGI-Info-Logging field descriptions","paragraph_zero_based":19988},{"literal_text_all_w_t_and_m_t":"cellIdentity","paragraph_zero_based":19989},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN-IdentityInfo IE of PLMN-IdentityInfoList in SIB1.","paragraph_zero_based":19990},{"literal_text_all_w_t_and_m_t":"plmn-Identity","paragraph_zero_based":19991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f64307452d35f2b3ba00a2b7ca05ba59ddaf74959c9ae653472696b74ece2fd7","0b7d5436264854d21843ebda567d5fa8618e0b93622e3c0b13b4f9e7228d0edd","53230f315af6096be8182fc26625077772cafa332da0abd113018e997e9e62e2","f09cda594f97326f71a6ebd7038a7a8328bdf6431988fb0834fedec0e0c428c7","1a06f4671a78d858f4e71be4194d5274a538c0d3db01d28600d7e31c512e8334","f24618885cacd305f51fbbf5df23c9381cadbeb042d4679da764249cb034696b","20299e02646c6bd6e59dabe85d523a91198394c6d109beff71c2157225692de4","0ffc852d54ff38295bd39e7997e31700501e625d778a06010195768e1a1553f3","b9c51e0676d0d5998f71b4d139691979a6cbac4dfc7ad4c4b2aa0029c950534c","8260120825da8124cd9582d5c0c4d1569b073a0c40cec9d8e727ccfd4c5de47f","b2f6d635898f1f54ccb94f0d095eb9a8e97f72a4d0772bc40f806e570b9df749","91b499f083ccd2a545990587f8428