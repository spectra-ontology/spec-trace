{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22344},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig ::=               SEQUENCE {","paragraph_zero_based":22345},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                  OPTIONAL,   -- Need S","paragraph_zero_based":22346},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                       OPTIONAL,   -- Need S","paragraph_zero_based":22347},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-UplinkConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":22348},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":22349},{"literal_text_all_w_t_and_m_t":"    transformPrecodingDisabled          SEQUENCE {","paragraph_zero_based":22350},{"literal_text_all_w_t_and_m_t":"        scramblingID0                       INTEGER (0..65535)                                              OPTIONAL,   -- Need S","paragraph_zero_based":22351},{"literal_text_all_w_t_and_m_t":"        scramblingID1                       INTEGER (0..65535)                                              OPTIONAL,   -- Need S","paragraph_zero_based":22352},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":22353},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":22354},{"literal_text_all_w_t_and_m_t":"        dmrs-Uplink-r16                     ENUMERATED {enabled}                                            OPTIONAL    -- Need R","paragraph_zero_based":22355},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":22356},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":22357},{"literal_text_all_w_t_and_m_t":"    transformPrecodingEnabled           SEQUENCE {","paragraph_zero_based":22358},{"literal_text_all_w_t_and_m_t":"        nPUSCH-Identity                     INTEGER(0..1007)                                                OPTIONAL,   -- Need S","paragraph_zero_based":22359},{"literal_text_all_w_t_and_m_t":"        sequenceGroupHopping                ENUMERATED {disabled}                                           OPTIONAL,   -- Need S","paragraph_zero_based":22360},{"literal_text_all_w_t_and_m_t":"        sequenceHopping                     ENUMERATED {enabled}                                            OPTIONAL,   -- Need S","paragraph_zero_based":22361},{"literal_text_all_w_t_and_m_t":"        ...,","paragraph_zero_based":22362},{"literal_text_all_w_t_and_m_t":"        [[","paragraph_zero_based":22363},{"literal_text_all_w_t_and_m_t":"        dmrs-UplinkTransformPrecoding-r16   SetupRelease {DMRS-UplinkTransformPrecoding-r16}                OPTIONAL    -- Need M","paragraph_zero_based":22364},{"literal_text_all_w_t_and_m_t":"        ]]","paragraph_zero_based":22365},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":22366},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["71d4d7a00385516b