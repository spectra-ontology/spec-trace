{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        ms2560                                 INTEGER(0..2559),","paragraph_zero_based":19320},{"literal_text_all_w_t_and_m_t":"        ms5120                                 INTEGER(0..5119),","paragraph_zero_based":19321},{"literal_text_all_w_t_and_m_t":"        ms10240                                INTEGER(0..10239)","paragraph_zero_based":19322},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":19323},{"literal_text_all_w_t_and_m_t":"    cellDTXDRX-SlotOffset-r18                  INTEGER (0..31),","paragraph_zero_based":19324},{"literal_text_all_w_t_and_m_t":"    cellDTXDRXconfigType-r18                   ENUMERATED {dtx, drx, dtxdrx},","paragraph_zero_based":19325},{"literal_text_all_w_t_and_m_t":"    cellDTXDRXactivationStatus-r18             ENUMERATED {activated, deactivated}           OPTIONAL   -- Need N","paragraph_zero_based":19326},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19327},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19328},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLDTXDRX-CONFIG-STOP","paragraph_zero_based":19329},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19331},{"literal_text_all_w_t_and_m_t":"CellDTXDRX-Config field descriptions","paragraph_zero_based":19332},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-CycleStartOffset","paragraph_zero_based":19333},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-Cycle in ms and cellDTXDRX-StartOffset in multiples of 1 ms.","paragraph_zero_based":19334},{"literal_text_all_w_t_and_m_t":"The configured cellDTXDRX-Cycle is an integer multiple of configured drx-longCycle or vice versa.","paragraph_zero_based":19335},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-onDurationTimer","paragraph_zero_based":19336},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":19337},{"literal_text_all_w_t_and_m_t":"cellDTXDRX-SlotOffset","paragraph_zero_based":19338},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":19339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19340},{"literal_text_all_w_t_and_m_t":"cellDTXDRXactivationStatus","paragraph_zero_based":19341},{"literal_text_all_w_t_and_m_t":"Initial activation status of cell DTX/DRX indicating whether the UE shall activate the configuration according to the received parameters. This field is only used upon setup of a cell DTX/DRX configuration.","paragraph_zero_based":19342},{"literal_text_all_w_t_and_m_t":"cellDTXDRXconfigType","paragraph_zero_based":19343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e5adbe86ca205cb4946e1f939fb30c46ce618f0300bb76418138a763fc5c341e","e8d93fc92d8a5f914cd3373704b4dab7e33804cc33f15ed7740ff822559f0295","b5e0bd83111e4b7a4c253589d1f3066178915f2823944ee8f7a7f846f03ef913","a6657a12236a7afc84a0e517cc2e07b05b6bf61769a584f3231c9a7375236780","3c32c68b9ff297e4d12e6afc15ec586808e69f40535fbcc2e3e99c003fd0fc0c","893b758a59b248902f3fab581cd9b8cb102bbe09ef510ed2001136be40713b22","645cf248771f6314f475253bc72b2b995d1372d20bc2ea66a2a2d4847adaa121","ac9b944c59c92b3191265bb458c5216ed9f632c745bb91c9cc596187d6b01fc7","f3ecfedf658c9aae139ba27b356f97cdc6fa98c7e93f99c97d9532281ab92831","f2b89