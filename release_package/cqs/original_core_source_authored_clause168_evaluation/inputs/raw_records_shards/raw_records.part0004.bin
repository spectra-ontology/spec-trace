{"literal_text_all_w_t_and_m_t":"maxNumberResAcrossCC-AcrossFR","paragraph_zero_based":53151},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of configured CSI-RS resources. Corresponds to the UE capability maxNumberResAcrossCC-AcrossFR-r16 in maxTotalResourcesForAcrossFreqRanges-r16.","paragraph_zero_based":53152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53153},{"literal_text_all_w_t_and_m_t":"ResourceConfigPerFR field descriptions","paragraph_zero_based":53154},{"literal_text_all_w_t_and_m_t":"bm-MaxNumberAperiodicCSI-RS-Resource","paragraph_zero_based":53155},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of aperiodic CSI-RS resources that the SCG is allowed to configure for the UE to measure L1-RSRP. Corresponds to the UE capability maxNumberAperiodicCSI-RS-Resource in beamManagementSSB-CSI-RS.","paragraph_zero_based":53156},{"literal_text_all_w_t_and_m_t":"bm-MaxNumberCSI-RS-Resource","paragraph_zero_based":53157},{"literal_text_all_w_t_and_m_t":"Indicates the maximum total number of NZP-CSI-RS resources that can be configured for the UE to measure L1-RSRP. Corresponds to the UE capability maxNumberCSI-RS-Resource in beamManagementSSB-CSI-RS.","paragraph_zero_based":53158},{"literal_text_all_w_t_and_m_t":"cg-MaxNumberConfigsAllCC","paragraph_zero_based":53159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2f7ba2cfef82f926502e4ebae5aef632073d1bad59f5229f3dbf3aa6352aa797","2a528544509774c21873c7c45db97bb138ca105b3a40cde20aca4cc00d65d3be","d5157d9b2b33b56cec694a71550d6b59c65395248d1f89305e67d3662c051da9","9ff085393bba7d3b9b63dede52da523c07fe3ac922e5382b3f9104dd219615b7","dbcd717a21fe945612bcef1550a678fafa5d92cef359b8