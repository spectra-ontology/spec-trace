{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            sbas-id-r17                         SBAS-ID-r16                                             OPTIONAL  -- Cond GNSS-ID-SBAS","paragraph_zero_based":34296},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":34297},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":34298},{"literal_text_all_w_t_and_m_t":"    valueTag-r17                            INTEGER (0..31)                                             OPTIONAL, -- Cond NonPosSIB","paragraph_zero_based":34299},{"literal_text_all_w_t_and_m_t":"    areaScope-r17                           ENUMERATED {true}                                           OPTIONAL  -- Need S","paragraph_zero_based":34300},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34302},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-STOP","paragraph_zero_based":34303},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34305},{"literal_text_all_w_t_and_m_t":"SchedulingInfo field descriptions","paragraph_zero_based":34306},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":34307},{"literal_text_all_w_t_and_m_t":"Indicates that a SIB is area specific. If the field is absent, the SIB is cell specific.","paragraph_zero_based":34308},{"literal_text_all_w_t_and_m_t":"si-BroadcastStatus","paragraph_zero_based":34309},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of si-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting. When SIB19 is scheduled in an NTN cell, the si-BroadcastStatus for the mapped SIB19 is set to broadcasting.","paragraph_zero_based":34310},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with si-BroadcastStatus set to notBroadcasting in the list of concatenated SI messages configured by schedulingInfoList in si-SchedulingInfo and SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when si-RequestConfig, si-RequestConfigRedCap or si-RequestConfigSUL is configured.","paragraph_zero_based":34311},{"literal_text_all_w_t_and_m_t":"si-Periodicity","paragraph_zero_based":34312},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames. Value rf8 corresponds to 8 radio frames, value rf16 corresponds to 16 radio frames, and so on.","paragraph_zero_based":34313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34314},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo field descriptions","paragraph_zero_based":34315},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":34316},{"literal_text_all_w_t_and_m_t":"This field is not used in this specification. If received, it is ignored by the UE.","paragraph_zero_based":34317},{"literal_text_all_w_t_and_m_t":"si-RequestConfig","paragraph_zero_based":34318},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":34319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["17693e605dd6d7c94a97c1dd739729b3992d47e4d8463af58eb8baa01c769767","1225deca527fe484e5754f99e595529502f7fdf73bdd41a396fdca27f84802c1","84e43f938263450debf31b0d65c10ffdf03f302e04c96eb929921787ab0fc4be","a38fb9e3c061d666f1fb6e734c10fe3de07098f56a6bc63e91f17648eaf6f276","2f291d0e8e67a27a08baf3f27a367413cc6b6b68b6d5047fbaa0a0d6f0a29ecd","72f7b2cc2288f1cccfb1ba60cad4f32a41e0f4e146dc108a889f6a4298bdb98f","bc2f3b2cb68b970976f1225bfbc4b8dc669d24b4c5222af6ce44c6ddd22dda67","054df6d0b332117180e5af729e6b0950cdee9a2829f1bf63f8ed9c22ecb21d4e","ff58e5080e400452d447bba5f7c71004a50ef9eb6d95c054340ce7cea8d9de15","fa0629517fdbd837563dda99a1b72ad54a3ab9a48ca5d62528eebbe0a643db3f","ce82f1e860846daa26b35394eb2401a67ab3b0226f6b325bc87851ba1ebab2c7","eefe384d6dd5a4a7361b438c2236a35c16a53dea0954b7e3273a7b8bb2b82f72","2207d780563c8cb52a988299b2192383b361bd81d1b29e04e39eacae83ebbf06","76b50617fdcd8561b48ec13e78d07266f488cc5cc8ba9e1048a68163d1021d6f","c87542081a89a95d704d34969eb309074aedb6d5ffcf91910ef90ea6762f62f7","8ddc1bfdbd3b5a160a1aaf5a38f4304ede8c4162159a7522b200206282bafe9c","deeb0e8fe5e80e38f8de7c03983202b3018f4ece784fb2ed03884b28fb48f6e3","66b5878f4b2981ac8bd54a5efb87ae07fa2922e0a294de16f5bcd530fd23de37","9de0a1a3d0f924f702c6516badedcdbd0d6e6eb949597dde84470d870731e6a4","e8cd22619977bd5ef4bad69f6b6fef8a81da5db1d828d9babd4811cb7875fb7b","46c3262e02439ea7ac7d5943e8b796d653b6b4dc73967775c15b63997a1e83f1","1c681ece049f7b1d2ec20fbf79ba3a7b0bb673ecac28246180c001c4ce68e4f3","a8fbcc2775c811e0c1f856259edf3b5dd46e9a9082cd3503039edf7968bf7bbf","2372d1248b281dec3f01c6d8587440d2927d9d9b2a1d62e546afc265cedfdb27"],"paragraph_range_zero_based":[34296,34319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34296"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"si-RequestConfigMSG1-Repetition","paragraph_zero_based":34320},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources on NUL that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":34321},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap","paragraph_zero_based":34322},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the (e)RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":34323},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap-MSG1-Repetition","paragraph_zero_based":34324},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources for initialUplinkBWP-RedCap that the (e)RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":34325},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL","paragraph_zero_based":34326},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":34327},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL-MSG1-Repetition","paragraph_zero_based":34328},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources on SUL that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":34329},{"literal_text_all_w_t_and_m_t":"si-WindowLength","paragraph_zero_based":34330},{"literal_text_all_w_t_and_m_t":"The length of the SI scheduling window. Value s5 corresponds to 5 slots, value s10 corresponds to 10 slots and so on. The network always configures si-WindowLength to be shorter than or equal to the si-Periodicity. The values s2560-v1710 and s5120-v1710 are only applicable for SCS 480 kHz.","paragraph_zero_based":34331},{"literal_text_all_w_t_and_m_t":"systemInformationAreaID","paragraph_zero_based":34332},{"literal_text_all_w_t_and_m_t":"Indicates the system information area that the cell belongs to, if any. Any SIB with areaScope within the SI is considered to belong to this systemInformationAreaID. The systemInformationAreaID is unique within a PLMN/SNPN.","paragraph_zero_based":34333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34334},{"literal_text_all_w_t_and_m_t":"SchedulingInfo2 field descriptions","paragraph_zero_based":34335},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":34336},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":34337},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":34338},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":34339},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":34340},{"literal_text_all_w_t_and_m_t":"The posSIBs as defined in TS 37.355 [49] mapped to SI for scheduling using schedulingInfoList2. ","paragraph_zero_based":34341},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":34342},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":34343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["06b922e2128f24cf97d7b23b808cd61815a8eeb957c9ae7d760875f84769f945","71c9e652696750b84936ed519dc74a3ad9672ce4affa44b4de9aea8f5b042285","59d668e4fa761e1603b1fd8d45e6227f203f523e908d7fc20374063847c1777f","4c6d0444c81ca44c5b92f3aae439743a747aa0af4f297a0d816dbb0e7e56011f","2690d17ca8249cfdc9d556948ec20e1deb46de7f1054c1b47548ebf2a698376e","d7e88c23b22a96041e42f76980873c8dad9d8c8062664ac6fe38a6e858a4f25e","e489a1217476f297be445a5af09aa09d9dd710210248fba79dae20c328bc5d50","987d4111b7a00e821c72f16de397688d619f3e61df9a09bd5fd89fd05f1cfe72","e2dbc25c5053d7404508fcf572c9e3f14ed08066e8964dc1a07a2bd8db828b8b","0c6866b1c3ab3706289b0cdbb2c1c60fc58fa96fe67ee68abc6c27a9d070cae3","2a1dc6fd3a7489efbac77aa7c6b38b317f68a52f85fcca98dc10a99712326f2a","c1974376df1bdd7558a6d51da276023d1719fdcd4af9a7dafab260ab1c54a6b7","8262eee263bac050c0e9424194d7c67c6787f30b3123cef11cd13f243d8f785f","66793f119a5315a2b519cc18dd369dc37f87c09eeaf20806493bf39bed9d8191","440160fafdff8ee6eb316c67e1ff29bd915e3cbbd3ba701b136eccbc0e125ace","7f3a454048fa60d91723102869c3f5d2384cee069a9cb5d988401d02694f5e38","e2686955df08743eaf61a0df286af24c6c7008f30b2ec97a069dc707529fa210","6acf78efcacbc4249f8532d62947e5fbaa340a6f89ec14c8267fb9023da1bc83","7634c30551be849b72910867de1c149631b06850943ff534f43be24040ac6396","d12548e8596aa0d855d53973416c52745f31ae663a71bae582c58e8323e3018b","e8f6997f790865875eb197108a22f9d2f5babe2f2de90465272cd6151b882a63","b4aa91f4e60bc0e0a9a83341e84e15e62d4b38a4bd5b50f1001cc0e59acf4026","33a2c499a10d30b3c90d6a053dcb68d1ba594603eca08fc8790a1768321c9934","d93b8f6a9ebc3807960776a3b6de9b0150f14635368b0050dc8580e95ee95d29"],"paragraph_range_zero_based":[34320,34343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34320"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"si-WindowPosition","paragraph_zero_based":34344},{"literal_text_all_w_t_and_m_t":"This field indicates the SI window position of the associated SI-message. The network provides si-WindowPosition in an ascending order, i.e. si-WindowPosition in the subsequent entry in schedulingInfoList2 has always value higher than in the previous entry of schedulingInfoList2. The network configures this field in a way that ensures that SI messages scheduled by schedulingInfoList and/or posSchedulingInfoList do not overlap with SI messages scheduled by schedulingInfoList2.","paragraph_zero_based":34345},{"literal_text_all_w_t_and_m_t":"sib-MappingInfo","paragraph_zero_based":34346},{"literal_text_all_w_t_and_m_t":"Indicates which SIBs or posSIBs are contained in the SI message.","paragraph_zero_based":34347},{"literal_text_all_w_t_and_m_t":"sibType","paragraph_zero_based":34348},{"literal_text_all_w_t_and_m_t":"The type of SIB(s) mapped to SI for scheduling using schedulingInfoList2. Value type1 indicates SIBs and value type2 indicates posSIBs.","paragraph_zero_based":34349},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34350},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":34351},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34352},{"literal_text_all_w_t_and_m_t":"GNSS-ID-SBAS","paragraph_zero_based":34353},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if gnss-id is set to sbas. It is absent otherwise.","paragraph_zero_based":34354},{"literal_text_all_w_t_and_m_t":"MSG-1","paragraph_zero_based":34355},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":34356},{"literal_text_all_w_t_and_m_t":"SIB-TYPE","paragraph_zero_based":34357},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is different from SIB6, SIB7 or SIB8. For SIB6, SIB7 and SIB8 it is absent.","paragraph_zero_based":34358},{"literal_text_all_w_t_and_m_t":"NonPosSIB","paragraph_zero_based":34359},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the SIB type is type1. For type2 it is absent.","paragraph_zero_based":34360},{"literal_text_all_w_t_and_m_t":"SUL-MSG-1","paragraph_zero_based":34361},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":34362},{"literal_text_all_w_t_and_m_t":"REDCAP-MSG-1","paragraph_zero_based":34363},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if initialUplinkBWP-RedCap is configured in UplinkConfigCommonSIB and if si-BroadcastStatus is set to notBroadcasting for any SI-message included in schedulingInfoList or any SI-message containing type1 SIB included in schedulingInfoList2. It is absent otherwise.","paragraph_zero_based":34364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34365},{"literal_text_all_w_t_and_m_t":"–SK-Counter","paragraph_zero_based":34366},{"literal_text_all_w_t_and_m_t":"The IE SK-Counter is a counter used upon initial configuration of SN security for NR-DC and NE-DC, as well as upon refresh of S-KgNB or S-KeNB based on the current or newly derived KgNB during RRC Resume or RRC Reconfiguration, as defined in TS 33.501 [11].","paragraph_zero_based":34367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d7cd5a71126711472d04b08aa660f62450e0303b8d4babf624cc85e0e40d0273","dc1292610b67e4eed44a0203ab79b588a58dd497345bbb56f2d0b1620bfb6e46","25c1676f24f1da7328e81d5c103e2f1770f68f32c18f378956170b4e6fc46542","6aaae11dc36412f3edddbe55121d73ce12dbe3b17e157a5256145e3f5d501366","c9067f2d8dc21f6993049c0179e8d2b7807fccb7252c69f3a288960a9e3c97f5","40bbf0508aa115a03db181d78a141269d674a6ee787bde05e7e7b6c316936b70","07dbdfb82f6e0d364257ea3e788825bb6a9fdb904eac7df79abe1444aed87c81","be7c13119667ff52bd41c07754fcb1b0cb47e4ce30b6ce02b48485388ba195ae","fabafeba58157f49dd794228747debed8d9e95562b49567e60bdfff3adf2fa13","d7b8e63c589db9ac825ecb1fccc4b1b46be3f26f1822381f34ba120dbc0b177d","95b6e0c78d39dba0770066c2fc1675eafaaf0596d11fe06f8885dea56ca57f96","17e8d6b31fbdd4979f524aebf1248dcff24aa1c44b4389ea62f850e4ace36861","e0f3fb36ae2099927dd925b94ef4e54c7b3532bd2f3d562c740914eec27dd2ed","0340c1e5598db90e46ad65d1dc7e9fa4470a1acf2e2292ddd90168fe8bc87cc6","0c66e4f0409280660d806c3f303027db7f94d1de96452f4fc0bc20a5572ed6bc","feb394a7432e06dea6c29382a09cf443e4bd5aa179336498467e953641fde4b0","9257d50c26b450e966d18d96ef7f8cdb675d1ed80bdf56006497949dbfb4e518","14839f0e89ccbe4bd03a6ff6682b05ee8b55010c83a9de7091664024f637fa55","c7db8e85b04443a7b61bc9afed4b03a27921d85db73139901da260bb7114ea59","5f17d4f231bca01a5c4bedd1805ab9b348b51342a824693dc65fd9def56f0205","aa5449647d287c6020f898b340ba7d216af4e1ce3264666fe41d0936b5800187","d9f40056e42ceb6c952d63f5b71c389c61e77f706d0adca433169b30ca8ece19","74d385c481f33f2d7c5427064686078d945d4e0cfdb1698971921efaa429e537","b1ed204592c6c683187a8c01e0b619bf5cdbf0b7b93c10e314a7d70ca98a6998"],"paragraph_range_zero_based":[34344,34367],"projection":"All w:t and m:t including tracked insertion/dele