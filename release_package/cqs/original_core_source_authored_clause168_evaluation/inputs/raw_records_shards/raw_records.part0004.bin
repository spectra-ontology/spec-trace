{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18192},{"literal_text_all_w_t_and_m_t":"Alpha ::=                       ENUMERATED {alpha0, alpha04, alpha05, alpha06, alpha07, alpha08, alpha09, alpha1}","paragraph_zero_based":18193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18194},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-STOP","paragraph_zero_based":18195},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18197},{"literal_text_all_w_t_and_m_t":"–Altitude","paragraph_zero_based":18198},{"literal_text_all_w_t_and_m_t":"The IE Altitude is used to indicate altitude relative to sea level. The actual value is the field value in meters.","paragraph_zero_based":18199},{"literal_text_all_w_t_and_m_t":"Altitude information element","paragraph_zero_based":18200},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18201},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-START","paragraph_zero_based":18202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18203},{"literal_text_all_w_t_and_m_t":"Altitude-r18 ::=              INTEGER (minAltitude-r18..maxAltitude-r18)","paragraph_zero_based":18204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18205},{"literal_text_all_w_t_and_m_t":"-- TAG-ALTITUDE-STOP","paragraph_zero_based":18206},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18207},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18208},{"literal_text_all_w_t_and_m_t":"–AMF-Identifier","paragraph_zero_based":18209},{"literal_text_all_w_t_and_m_t":"The IE AMF-Identifier (AMFI) comprises of an AMF Region ID, an AMF Set ID and an AMF Pointer as specified in TS 23.003 [21], clause 2.10.1.","paragraph_zero_based":18210},{"litera