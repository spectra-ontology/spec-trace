{"fields":{"filename":"R2-2403724.zip::R2-2403724_sdtAsn1Cr.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PagingRecord-v1800 ::=              SEQUENCE {","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"    mt-SDT                              ENUMERATED {true}       OPTIONAL    -- Need N","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"PagingUE-Identity ::=               CHOICE {","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"    ng-5G-S-TMSI                        NG-5G-S-TMSI,","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"    fullI-RNTI                          I-RNTI-Value,","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"GroupPaging-r18 ::=                 SEQUENCE {","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"    inactiveReceptionAllowed-r18        ENUMERATED {true}       OPTIONAL    -- Need N","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-STOP","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"PagingRecord field descriptions","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"accessType","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to the PDU sessions from the non-3GPP access.","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"inactiveReceptionAllowed","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE with a valid PTM configuration for a TMGI in the PagingGroupList stays in RRC_INACTIVE to receive the corresponding MBS multicast session.","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"mt-SDT","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"Mobile Terminated SDT indication. The network includes mt-SDT indication in paging message only if the UE's I-RNTI is included in the paging message.","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a7fbbad25f5e61406c00d893a00048429d2f65e919559dad8207277498aaf84c","original_member_sha256":"326259c3d4e9adcd33421f2abacaa9ec944d0ccf157ae0fe09123bf12588c1c0","paragraph_ElementTree_utf8_XML_sha256":["4623fc1e809917dbba60a4af959797a40c2792be6e1876a1590fe716a12309be","7d78b8b615601912017d7929c757ca03b783c05e5b8575767e22c8418522ec99","e43e5b6265ef42b176a456947f5b6b33e618365d2a387b685e0c1b592344f490","63ab7fd8b0a8b6265d7370a2e0f7e91f4a7871cf6d8362448a5604d2dfb648c3","6ad0cc7f68b8d78f172e4119559628fbcad998dcd9288766c84cc1f375246a58","332dabc945aa1afb3ec844e32a059dc0128e64f1a0ba2429b054ac6c15e83d43","0ee121ca3c4501c70ab0dbe4cdf9ca3e531d53bad5556d1e088b4c5c911fd98b","8cd20b323d6bd89d930f39bd5de2ada4e5bb6180395b6f4d4ffbf4e3c7e7ee78","42d72f32c83fb086f9d3aa51e61da06ce175736821bf972dccd721eecfc811a2","5705496b05258186fe5325b8fd3bf15578dfce390e226123bca68f7ee4686c65","70398c638819c1af7f315a760ef04d434bc577c5454f265f4be19b2ddc9a4393","1e43783b7c4fbd469b322a909882c0b07807066f652765b36c90a5357f91bb81","191af00b820f146fc2b24da2ef5a08901652838c095b9134b4083b32189d0260","5308c4844abb4d84cf1c87345b3a5c768634944d8033c1b112931d9d7ebf73a5","f654ee1bd00ec3a25f063145aefd05302e0e3b8168ddbd54a59161a8c7880285","d83890507d347bce86f4e0c0db575e4c05b3c96caa3f0ca3b6691263cf26dce2","a8be5b0a94c2d6a09f6ee90c600bf7d57aa2b3f1b0fde515c9e443c43288c93f","1e39ab59275c5d33bbeb4edffc7a3da4c25e72c139d98121ec4fd3125fd73db6","6e968979c84beb9d4852fbb884975c09fe75e4b2f957521de77227cb05ccc761","2d792d4b100514a0c19f6a435b9c36ef6315a5c866c369c5f95aff66808e76c2","dea25dec9e033f2328929038218a916a1fc8f972a0771ecc1e8589f4e36db2b7","dd9544a48fec3b3674f37f03746b7c71766c90812545a5f94425a8ebfaea8b6c","89b094c1e6cedee7a2e7b2517acc7b88014cfdfbc4703109f6ac9b5b24c3d502","70b44a6d69a94019abe1e7e3e4bcd3ab6e9142e3b2b65bb678a4cdfe66a8b4a8"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403724.zip::R2-2403724_sdtAsn1Cr.docx:p168"}
{"fields":{"filename":"R2-2403724.zip::R2-2403724_sdtAsn1Cr.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pagingRecordList","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"If the network includes pagingRecordList-v1700, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix). If the network includes pagingRecordList-v1800, it includes the same number of entries, and listed in the same order, as in pagingRecordList (i.e. without suffix). The first element in pagingRecordList-v1700 / pagingRecordList-v1800 corresponds to the first UE identity in pagingRecordList (i.e. without suffix). The second element in pagingRecordList-v1700 / pagingRecordList-v1800 corresponds to the second UE identity in pagingRecordList (i.e. without suffix), and so on.","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"pagingCause","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"Indicates whether the Paging message is originated due to IMS voice. If this field is present, it implies that the corresponding paging entry is for IMS voice. If upper layers indicate the support of paging cause and if this field is not present but pagingRecordList-v1700 is present, it implies that the corresponding paging entry is for a service other than IMS voice. Otherwise, paging cause is undetermined.","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"pagingGroupList","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"If the network includes pagingGroupList-v1800, it includes the same number of elements, and listed in the same order, as in pagingGroupList-r17. The first element corresponds to the first TMGI in pagingGroupList-r17. The second element corresponds to the second TMGI in pagingGroupList-r17, and so on.","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":198}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a7fbbad25f5e61406c00d893a00048429d2f65e919559dad8207277498aaf84c","original_member_sha256":"326259c3d4e9adcd33421f2abacaa9ec944d0ccf157ae0fe09123bf12588c1c0","paragraph_ElementTree_utf8_XML_sha256":["82a437eb8089586353ca79c89e2e97fbe98e5dad31cc06de36e1d0a86674e2d3","f8e504d73f5db85fb9b871e2d2f61aafec10214f22a68d87f9dd44f1daaeb849","d29df2070de269782940f4cd06361cb0bf92a448f592e753bcfb6807a3d87bde","c071882e4981820c0f572d4271a83039fa4be85550d85613f9ec2523412f524d","b61176eec04a91296e1d53f29e4c0de3eaee22b9bdefa915f599e002b1daf514","c3d63ada80b87361f12f934784b6a5a3f770d6a4b18dbdc8d403e177d2d6d212","e8a3ab28d06f7a808a75bd5e40298834e1f99bf0630172470093304915c85edb"],"paragraph_range_zero_based":[192,198],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403724.zip::R2-2403724_sdtAsn1Cr.docx:p192"}
