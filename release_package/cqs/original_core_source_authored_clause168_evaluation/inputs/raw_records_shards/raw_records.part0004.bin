{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":34032},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":34033},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":34034},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34035},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommonSIB","paragraph_zero_based":34036},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommonSIB is used to configure cell specific parameters of a UE's serving cell in SIB1.","paragraph_zero_based":34037},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB information element","paragraph_zero_based":34038},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34039},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-START","paragraph_zero_based":34040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34041},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB ::=      SEQUENCE {","paragraph_zero_based":34042},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommonSIB,","paragraph_zero_based":34043},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":34044},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":34045},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                           OPTIONAL, -- Need S","paragraph_zero_based":34046},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                SEQUENCE {","paragraph_zero_based":34047},{"literal_text_all_w_t_and_m_t":"        inOneGroup                          BIT STRING (SIZE (8)),","paragraph_zero_based":34048},{"literal_text_all_w_t_and_m_t":"        groupPresence                       BIT STRING (SIZE (8))                                   OPTIONAL  -- Cond FR2-Only","paragraph_zero_based":34049},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":34050},{"literal_text_all_w_t_and_m_t":"    ssb-PeriodicityServingCell          ENUMERATED {ms5, ms10, ms20, ms40, ms80, ms160},","paragraph_zero_based":34051},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                      OPTIONAL, -- Cond TDD","paragraph_zero_based":34052},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":34053},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":34054},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["502df2101d6583f923355c6850e084f52f101d606435bb0131e3590edc79b179","2c425ad3c0089a1bbb9b9f8a5c3770a87a05c77db40135484fcbf7c6d3074355","35c4e67ea8f4dee783a9e38f4aba1defcc58d3716fafdae804f78407ec5153a5","a7851834070a7e1ecb7a4b7c5732b98e0d37957aa484ecaaecddcf24ee81d536","09d6ad9e9b198dc638bd82994c686e4f972c27d715e808cbb8f3412028350350","69513ad2e21b954c81540a99e02a162635400690e2d3d08ec66787fefb867c4f","c48528b8ed2143d8caa2f2adf9898100bb6237880a37fda758d4093