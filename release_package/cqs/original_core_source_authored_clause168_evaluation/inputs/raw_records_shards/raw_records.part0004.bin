{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    mpe-ProhibitTimer-r17               ENUMERATED {sf0, sf10, sf20, sf50, sf100, sf200, sf500, sf1000},","paragraph_zero_based":27936},{"literal_text_all_w_t_and_m_t":"    mpe-Threshold-r17                   ENUMERATED {dB3, dB6, dB9, dB12},","paragraph_zero_based":27937},{"literal_text_all_w_t_and_m_t":"    numberOfN-r17                       INTEGER(1..4),","paragraph_zero_based":27938},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":27939},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27940},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27941},{"literal_text_all_w_t_and_m_t":"-- TAG-PHR-CONFIG-STOP","paragraph_zero_based":27942},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27944},{"literal_text_all_w_t_and_m_t":"PHR-Config field descriptions","paragraph_zero_based":27945},{"literal_text_all_w_t_and_m_t":"dpc-Reporting-FR1","paragraph_zero_based":27946},{"literal_text_all_w_t_and_m_t":"Indicates if the delta power class (DPC) is reported, as specified in TS 38.321 [3].","paragraph_zero_based":27947},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":27948},{"literal_text_all_w_t_and_m_t":"This field is not used in this version of the specification and the UE ignores the received value.","paragraph_zero_based":27949},{"literal_text_all_w_t_and_m_t":"mpe-ProhibitTimer","paragraph_zero_based":27950},{"literal_text_all_w_t_and_m_t":"Value in number of subframes for MPE reporting, as specified in TS 38.321 [3]. Value sf10 corresponds to 10 subframes, and so on.","paragraph_zero_based":27951},{"literal_text_all_w_t_and_m_t":"mpe-Reporting-FR2","paragraph_zero_based":27952},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report MPE P-MPR in the PHR MAC control element, as specified in TS 38.321 [3].","paragraph_zero_based":27953},{"literal_text_all_w_t_and_m_t":"mpe-Threshold","paragraph_zero_based":27954},{"literal_text_all_w_t_and_m_t":"Value of the P-MPR threshold in dB for reporting MPE P-MPR when FR2 is configured, as specified in TS 38.321 [3]. The same value applies for each serving cell (although the associated functionality is performed independently for each cell).","paragraph_zero_based":27955},{"literal_text_all_w_t_and_m_t":"multiplePHR","paragraph_zero_based":27956},{"literal_text_all_w_t_and_m_t":"Indicates if power headroom shall be reported using the Single Entry PHR MAC control element or Multiple Entry PHR MAC control element defined in TS 38.321 [3]. True means to use Multiple Entry PHR MAC control element and False means to use the Single Entry PHR MAC control element defined in TS 38.321 [3]. The network configures this field to true for MR-DC and UL CA for NR, and to false in all other cases.","paragraph_zero_based":27957},{"literal_text_all_w_t_and_m_t":"numberOfN","paragraph_zero_based":27958},{"literal_text_all_w_t_and_m_t":"Number of reported P-MPR values in a PHR MAC CE.","paragraph_zero_based":27959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["730dc0641675be241808b3ff31f0796db29f1b019ad3a30adc021439562f3ec7","7086dcdadd53edfe8fa8ceb5e11c24a3f9b0fc2ac699b5dbc3745e95b23546a5","c1d132037216ace95b12f6ae6cd520c9bf2529a1093bbf72342a04bd3c3e6a94","41ab43ad4cd512431b5880c1f2fa0ef6ef7a5a2b30b6b759dba03ad7cf6091c9","9dbad210cda858093da8789874b6d593d7df115c73ce35ebe2a495f2424f50c1","f5b3bca0e542b44a060118025bf5eb58e2740e85cf2e3bdc1aa14c6d6ac693b6","df8839a0f4442d23b874afe7359be7c67159c06d759f481e5e1d2bbae0c9c9b6","0e2983079d1af9c31f148b20046fbf59f9d657a3e757eceb60ed9801a34b7d19","6e7b14c9c51e0b661413eac7053c0ef014b16d55d798c8b473b0261b72bac36e","3c7ed2f229b6b2c5638c2d70395ff1e09983f0a4aabda1aea318262296272adb","9b7e07ad4ae92d3df46ffe9a96e0431e758d407abfb80f0ce662ade39eeda5c1","4cabed550638bafa24f1151619f65952624ae8ac98db7a8ad51cc47b9249986f","68ce4fa65c10a87d1882d434b1fe46863fb4919397ca4eff0006da8c3bd5c24f","75328f83480813c2f68d5639b815bd7a15975cf55c3befe1cd9a78e7585b8c4e","6cb0d91991f3f65550d88e4ca789cb80008affa399babdb88f855e3f00e2a956","dcb3b687ac54b55b4bd6e18ca32ff7b6d8fe2208868130ff4c31f32a6fe0d498","d2c1503975a5bffced240a7366cebaaff4346124cc23aaf909f8e9ade4c3ea4e","0e16ad59ccb776c21b0ea4c6d813ea56e7b3c5d7a99b4febbb84c960ec79c4d0","0368669703ff2a9b4008559be7f5259751eb479995141fb4f4519bc013838b34","fb2916cbefd4180f6923fc1cfb0f0cb4c9cddaad5cba376bfb5612998f2c7d0c","6d57e1689ac4a15259b6ff56fcd387df0c89d33e3c7b90f19282ae2882f3348d","abb0866da6e85994aba21cdbb73ac43cb65d73e31b2d68c05db0ece5248465e7","f8ad2c4f947ac4e4e58dd794846ae8be92cdb6ea51be339b596cf5ede4562100","1b3686e0b6c4acfbe1fcd965228b018fb85bc689de652b3c6768aa510fd313c0"],"paragraph_range_zero_based":[27936,27959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27936"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"phr-AssumedPUSCH-Reporting","paragraph_zero_based":27960},{"literal_text_all_w_t_and_m_t":"Indicates if the PHR with an assumed PUSCH is reported, as specified in TS 38.321 [3].","paragraph_zero_based":27961},{"literal_text_all_w_t_and_m_t":"phr-ModeOtherCG","paragraph_zero_based":27962},{"literal_text_all_w_t_and_m_t":"Indicates the mode (i.e. real or virtual) used for the PHR of the activated cells that are part of the other Cell Group (i.e. MCG or SCG), when DC is configured. If the UE is configured with only one cell group (no DC), it ignores the field.","paragraph_zero_based":27963},{"literal_text_all_w_t_and_m_t":"phr-PeriodicTimer","paragraph_zero_based":27964},{"literal_text_all_w_t_and_m_t":"Value in number of subframes for PHR reporting as specified in TS 38.321 [3]. Value sf10 corresponds to 10 subframes, value sf20 corresponds to 20 subframes, and so on.","paragraph_zero_based":27965},{"literal_text_all_w_t_and_m_t":"phr-ProhibitTimer","paragraph_zero_based":27966},{"literal_text_all_w_t_and_m_t":"Value in number of subframes for PHR reporting as specified in TS 38.321 [3]. Value sf0 corresponds to 0 subframe, value sf10 corresponds to 10 subframes, value sf20 corresponds to 20 subframes, and so on.","paragraph_zero_based":27967},{"literal_text_all_w_t_and_m_t":"phr-Tx-PowerFactorChange","paragraph_zero_based":27968},{"literal_text_all_w_t_and_m_t":"Value in dB for PHR reporting as specified in TS 38.321 [3]. Value dB1 corresponds to 1 dB, dB3 corresponds to 3 dB and so on. The same value applies for each serving cell (although the associated functionality is performed independently for each cell).","paragraph_zero_based":27969},{"literal_text_all_w_t_and_m_t":"phr-Type2OtherCell","paragraph_zero_based":27970},{"literal_text_all_w_t_and_m_t":"If set to true, the UE shall report a PHR type 2 for the SpCell of the other MAC entity. See TS 38.321 [3], clause 5.4.6. Network sets this field to false if the UE is not configured with an E-UTRA MAC entity.","paragraph_zero_based":27971},{"literal_text_all_w_t_and_m_t":"twoPHRMode","paragraph_zero_based":27972},{"literal_text_all_w_t_and_m_t":"Indicates if the power headroom shall be reported as two PHRs (each PHR associated with a SRS resource set) is enabled or not.","paragraph_zero_based":27973},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27974},{"literal_text_all_w_t_and_m_t":"–PhysCellId","paragraph_zero_based":27975},{"literal_text_all_w_t_and_m_t":"The PhysCellId identifies the physical cell identity (PCI).","paragraph_zero_based":27976},{"literal_text_all_w_t_and_m_t":"PhysCellId information element","paragraph_zero_based":27977},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27978},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLID-START","paragraph_zero_based":27979},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27980},{"literal_text_all_w_t_and_m_t":"PhysCellId ::=                      INTEGER (0..1007)","paragraph_zero_based":27981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27982},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLID-STOP","paragraph_zero_based":27983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5c91edf2d1c019f04e1f47bb502f819d0a712a19412281dd4732c0dffd954a35","da1be6115d7ca901bba361eee41565865fe91bdeef537048661f8587924796c2","248a8d9aed7bb30d8da38aabfcb3f22fc93c76482209ed11b643e17adf54d31f","89c8aa8c2ca64c1f1aad66e614d0787fb5b4eead66052bdee8a44c08d5e3f990","be56df83072f644b49eb7e95ec9a84360c4f53612f