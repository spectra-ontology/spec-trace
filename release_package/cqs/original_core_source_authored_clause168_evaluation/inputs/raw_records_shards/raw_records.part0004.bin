{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":52896},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52897},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":52898},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":52899},{"literal_text_all_w_t_and_m_t":"E-UTRA","paragraph_zero_based":52900},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52901},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":52902},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":52903},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":52904},{"literal_text_all_w_t_and_m_t":"NR","paragraph_zero_based":52905},{"literal_text_all_w_t_and_m_t":"Need not be included if the UE Radio Capability ID as specified in 23.502 [43] is used. Included otherwise","paragraph_zero_based":52906},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52907},{"literal_text_all_w_t_and_m_t":"Not included","paragraph_zero_based":52908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52909},{"literal_text_all_w_t_and_m_t":"–MeasurementTimingConfiguration","paragraph_zero_based":52910},{"literal_text_all_w_t_and_m_t":"The MeasurementTimingConfiguration message is used to convey assistance information for measurement timing.","paragraph_zero_based":52911},{"literal_text_all_w_t_and_m_t":"Direction: en-gNB to eNB, eNB to en-gNB, gNB to gNB, ng-eNB to gNB, gNB to ng-eNB, ng-eNB to ng-eNB, gNB DU to gNB CU, and gNB CU to gNB DU.","paragraph_zero_based":52912},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration message","paragraph_zero_based":52913},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":52914},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASUREMENT-TIMING-CONFIGURATION-START","paragraph_zero_based":52915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52916},{"literal_text_all_w_t_and_m_t":"MeasurementTimingConfiguration ::=      SEQUENCE {","paragraph_zero_based":52917},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":52918},{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":52919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7c3545dcef1f58bbb88d2323aafb0d9cd326343e4651d071e45ac1468a8e189b","bed526d26331d1e79212b0b85c6cce4e9139ead94e11d35dc5639b3784fd45ec","0fae67f5b4f116c48a63fca2681972612207e93fd14ea6d73a020a56a5cf1f01","4b13a3d8bd24816b1932dd0962411bb3612da8386009d1d4912246c7dea701b6","249c9dd1fb9de6ed12cd85295d080883c512c8f635e1194f69f3482cfaec0c6f","7a49fef838f383a2544b52b0200f6a62c21d15c3e6bc30219a60a6f27793cf2b","5d21045e6100b0b18c4a42246dad3119a19503fdbb363f758693707a827c8a29","cadb89e36c1a93902597340f6b47d679014815dbf5706297a6107f4e3f5197d0","ee5d9625e7c5435e327ada8c6df945cbd60cc8b2de1c4544d82841985b6faec9","cf8620845c36d8514af705b89d3535873fc794da90e16a6c83e6e0dd2c75d4d8","b29a0d8d2cf3cf303c069cbfef48a0aba1dd9c46f87c86f5bc9c36272b4ac1f5","11630be5838a89eec44ba878714dfbee828f62424f76e5870a547ca5c47589da","f45c9206dea