ed":18424},{"literal_text_all_w_t_and_m_t":"BFR-SSB-Resource ::=                SEQUENCE {","paragraph_zero_based":18425},{"literal_text_all_w_t_and_m_t":"    ssb                                 SSB-Index,","paragraph_zero_based":18426},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                    INTEGER (0..63),","paragraph_zero_based":18427},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18428},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18430},{"literal_text_all_w_t_and_m_t":"BFR-CSIRS-Resource ::=              SEQUENCE {","paragraph_zero_based":18431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c59c85cabd11c06afc18fe970dc231f552e4793679f96cd43984b1ba2cd40cb8","cf5b27bf862265ae16e396268321f80b75cb8c2bc4102c5fd1ee40bb268da272","f4f6674382f8a455cc4776f277666830a5e4a05845a4c0c5bd56df2f9f45d643","d9903015ec8541dba4c1dd81d6d37d82299945b4aedc06cf729bd8473e032854","1d8eff0d85279ad7ec14e9504085e6b3898b9e5045ed6041ed32510eb5df46e6","dd43562e593ac63dbf02acebdcc63bcc5d7d1e9062e0fe01166faaf2d88384b9","d2e76eac823b3d54457f3630780492c277844d1062eba375876db1f81a2a7370","9e159147ffa7647c1edf1f3122c3ae0c23d462deeb8ecc98755b5a969814bcc3","b68d9db858c2cc76435406440ef7bc9580177184bffcfddd4fd32c22858b8c18","865a92a24d9b5a60d53842a1124e11dd036d0f70da864e7253fdd5cc4969c572","9ceb9ac649355a4b2ce85e5bd3f5d14463282b7fd8fdedf38aa9d48e4703a3a8","08ad5cf57f00016d9d379d298a067e23e073ed839a091a5b1411b017e2e11cf5","297af7e9a90bf79c8da63bc1536c4822ec8ed50ef5cbe9375cbfb764b9dedd12","9cd5c65cdcca5f576e7e746ea326038c2729bd5c41437bf5531e434a1842e9d6","cd1d867897aa9018ac79ab74559c26a9bb270b5954f51800645efc1049ad3ad9","9d4075b89b1836df76300a09d75add1fe1a74c7961332a83e8a862aceebca870","d867232d288bc240c3eb08bcfa6111ef4ee4c426ac5f60281be9d638fc4f051c","1f68ac409c5472bc3f7a7486c84a6863ff07f6b24037c01e5997b49323a0f579","03339746f5efb0ddef54a5e3a560433ece0fd69b71d46f1b402d2a2d5e59dcbd","7206489935c10de3c8ed0ebaf27ddf9a6c754489ff2b44d1f8d724e9755a396a","9ee8c541ce2574e1886009f81d866b699b3fe48a15018789d422ba4fa16c81f5","f8a21cd59dffa4dc8f3e6911c682baad4aa483e46d7ab6a3aad0f3ceb8116e8f","46b36303b10c7bb32b4bf704781f76aa532e2889285b824b37abb675012989ba","1672ba2832d2332b14138b1fccf4d29ee4fe594c0868e3218930bd4bcc386b18"],"paragraph_range_zero_based":[18408,18431],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18408"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    csi-RS                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":18432},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                     SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1)   OPTIONAL,   -- Need R","paragraph_zero_based":18433},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                    INTEGER (0..63)                                                                 OPTIONAL,   -- Need R","paragraph_zero_based":18434},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18435},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18437},{"literal_text_all_w_t_and_m_t":"CandidateBeamRSListExt-r16::=       SEQUENCE (SIZE(1.. maxNrofCandidateBeamsExt-r16)) OF PRACH-ResourceDedicatedBFR","paragraph_zero_based":18438},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18439},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYCONFIG-STOP","paragraph_zero_based":18440},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18442},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryConfig field descriptions","paragraph_zero_based":18443},{"literal_text_all_w_t_and_m_t":"beamFailureRecoveryTimer","paragraph_zero_based":18444},{"literal_text_all_w_t_and_m_t":"Timer for beam failure recovery timer. Upon expiration of the timer the UE does not use CFRA for BFR. Value in ms. Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":18445},{"literal_text_all_w_t_and_m_t":"candidateBeamRSList, candidateBeamRSListExt-v1610","paragraph_zero_based":18446},{"literal_text_all_w_t_and_m_t":"Set of reference signals (CSI-RS and/or SSB) identifying the candidate beams for recovery and the associated RA parameters. This set includes all elements of candidateBeamRSList (without suffix) and all elements of candidateBeamRSListExt-v1610. The UE maintains candidateBeamRSList and candidateBeamRSListExt-v1610 separately: Receiving candidateBeamRSListExt-v1610 set to release releases only the entries that were configured by candidateBeamRSListExt-v1610, and receiving candidateBeamRSListExt-v1610 set to setup replaces only the entries that were configured by candidateBeamRSListExt-v1610 with the newly signalled entries. The network configures these reference signals to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. ","paragraph_zero_based":18447},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":18448},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for contention free beam failure recovery (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":18449},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":18450},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":18451},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":18452},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":18453},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":18454},{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be used by the UE to attempt contention free random access to recover from beam failure (see TS 38.213 [13], clause 6).","paragraph_zero_based":18455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["80043a0c497ee3619590094173d4df3833495566241ff118474ac74233fa1b11","333f1e2396c5bf87321be5756337a9cea0a307ce6a7b04eee8ebb8eea55e0239","927fffeccccb2f0cf9a9ffe9703247fc52f40ef13b4382f51de7188d5a58697d","774fab0dd39544073aa8dc564dc728a166dbb278efb7fc4ac88916c8ac81b1d3","364976610724968d1a4eba9f2a641b5bfa7cd1a27ab18292e81516ad6e7977f7","1a8f98d570d03df4be28b1401340caae8683baedf527ae1997364d329ae53305","d206544c8363f983d4ea456c54bfeb989ea82b07dd3647683e605389560764a0","27e2c0082dfeaa75045cb09b3dbabd1ad4a2f73bcf0d30d701491a39ab75f097","9d1bc0470faadab9e06274a31546f5528a301f413bf71fa17c139278dffc90a8","fe439cceed93084b9520f427a67310ed852f94e658fe01bd65e02631069a70fd","4e3d3e317752749bd00d9d68254bc586498a9038a1352626fd8a28ee2b727039","789223a93fc101957ce6688adef02c65547f60aeed8dc02f453c89acfb69deba","401bcc11e43499c64206a3b474b962ad151bae4c0c2fff6495e7681fb9ee2a52","9dad44b67037a2707d924df23abb40afb8d1a2db0254218142220acb59e0208a","fc4d829823b98ac0272a659542562c899de820e327eda4241aceb263c85ec73e","7ebeb6e82f4ad7095b9dd3cb94fbb2c41f292aa44f337022195b1ed5571e2c5b","8d014ad8211a40e4e04fca2ca8b51e06c3384b3b1f6afe057d1ccc0c86cda05a","519290421498a407dc28c8fbd0fa1213a45fd08700437a510949fb30f995724b","46c4d546925274138c8de52296881d2f1f9ccfc3883e6bff130f152927d6e221","9947098a01af439458924d0d6f903f431557348602ac4d9ae1448bc4fdb27761","917967f833a8588a12b48b92867d841d1a74a85d689429a66faf5d9ea1350efb","990bde1bd7bdba232964b149aa1aaff1e27acf555ce4c660d9cef96dec057cc9","c7b62d9305b2ccb9f1bf1f4c6001545b6916d5d104f3eb34970bdb295bcd38ad","0a3f1a2e5293df6bfb1fa22928a90bbcca6986db783f40cb3cb9f9d10d57f1da"],"paragraph_range_zero_based":[18432,18455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18432"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":18456},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":18457},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationTwoStep","paragraph_zero_based":18458},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access procedure for BFR (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":18459},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":18460},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources.","paragraph_zero_based":18461},{"literal_text_all_w_t_and_m_t":"rach-ConfigBFR","paragraph_zero_based":18462},{"literal_text_all_w_t_and_m_t":"Configuration of random access parameters for BFR.","paragraph_zero_based":18463},{"literal_text_all_w_t_and_m_t":"recoverySearchSpaceId","paragraph_zero_based":18464},{"literal_text_all_w_t_and_m_t":"Search space to use for BFR RAR. The network configures this search space to be within the linked DL BWP (i.e., within the DL BWP with the same bwp-Id) of the UL BWP in which the BeamFailureRecoveryConfig is provided. The CORESET associated with the recovery search space cannot be associated with another search space. Network always configures the UE with a value for this field when contention free random access resources for BFR are configured.","paragraph_zero_based":18465},{"literal_text_all_w_t_and_m_t":"rootSequenceIndex-BFR","paragraph_zero_based":18466},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1) for beam failure recovery.","paragraph_zero_based":18467},{"literal_text_all_w_t_and_m_t":"spCell-BFR-CBRA","paragraph_zero_based":18468},{"literal_text_all_w_t_and_m_t":"Indicates that UE is configured to send MAC CE for SpCell BFR as specified in TS38.321 [3].","paragraph_zero_based":18469},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":18470},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for CF-BFR, see TS 38.213 [13], clause 8.1.","paragraph_zero_based":18471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18472},{"literal_text_all_w_t_and_m_t":"BFR-CSIRS-Resource field descriptions","paragraph_zero_based":18473},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":18474},{"literal_text_all_w_t_and_m_t":"The ID of a NZP-CSI-RS-Resource configured in the CSI-MeasConfig of this serving cell. This reference signal determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":18475},{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":18476},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing BFR upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":18477},{"literal_text_all_w_t_and_m_t":"If the field is absent the UE uses the RA occasion associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":18478},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":18479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"sourc