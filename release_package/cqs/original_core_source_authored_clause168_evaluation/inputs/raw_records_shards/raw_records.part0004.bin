{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    logicalChannelSR-DelayTimer         ENUMERATED { sf20, sf40, sf64, sf128, sf512, sf1024, sf2560, spare1}                OPTIONAL, -- Need R","paragraph_zero_based":18648},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18649},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18651},{"literal_text_all_w_t_and_m_t":"-- TAG-BSR-CONFIG-STOP","paragraph_zero_based":18652},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18654},{"literal_text_all_w_t_and_m_t":"BSR-Config field descriptions","paragraph_zero_based":18655},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-DelayTimer","paragraph_zero_based":18656},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on.","paragraph_zero_based":18657},{"literal_text_all_w_t_and_m_t":"periodicBSR-Timer","paragraph_zero_based":18658},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf1 corresponds to 1 subframe, value sf5 corresponds to 5 subframes and so on.","paragraph_zero_based":18659},{"literal_text_all_w_t_and_m_t":"retxBSR-Timer","paragraph_zero_based":18660},{"literal_text_all_w_t_and_m_t":"Value in number of subframes. Value sf10 corresponds to 10 subframes, value sf20 corresponds to 20 subframes and so on.","paragraph_zero_based":18661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18662},{"literal_text_all_w_t_and_m_t":"–BWP","paragraph_zero_based":18663},{"literal_text_all_w_t_and_m_t":"The IE BWP is used to configure generic parameters of a bandwidth part as defined in TS 38.211 [16], clause 4.5, and TS 38.213 [13], clause 12.","paragraph_zero_based":18664},{"literal_text_all_w_t_and_m_t":"For each serving cell the network configures at least an initial downlink bandwidth part and one (if the serving cell is configured with an uplink) or two (if using supplementary uplink (SUL)) initial uplink bandwidth parts. Furthermore, the network may configure additional uplink and downlink bandwidth parts for a serving cell.","paragraph_zero_based":18665},{"literal_text_all_w_t_and_m_t":"The uplink and downlink bandwidth part configurations are divided into common and dedicated parameters.","paragraph_zero_based":18666},{"literal_text_all_w_t_and_m_t":"BWP information element","paragraph_zero_based":18667},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18668},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-START","paragraph_zero_based":18669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18670},{"literal_text_all_w_t_and_m_t":"BWP ::=                             SEQUENCE {","paragraph_zero_based":18671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f80ffad6d720e864079e70b6e78ed1e6df6e7a1ea300c84d422c9bac5b11b557","ff3815328b08a28f42e9f3f3b636c25aa35e3232112688b8ca8ae41964515c30","df623a2bf0a13242e9f0dbdbfd2ba677e0e334744f670e26eee7c9d4e258782a","b588f2c75ee4eb76098072c993cb06fcdef388480ef212718a8fe57355ff32e4","9a07880c5addf6bbba5ae8fbf65f4abcca7cad8823b0ee8709fbfe1f5ce0077c","25dccbc0cffc13d81975491e179922ea19342a5a4c171a5a95bc102c402eae12","4bbd537d758381c773afc288a21f6ad92ac9360ca117bdde4e49bbee420ce42a","09342150e1f10192c1d8d71a9c15c174bf68de7b8c5fec314144727e18d901d1","2b4928cf4c0167176ee943fb2b0af627fe8493e4677c42e0db4a181fed51007f","dfc310196d6ff3673bec2269b584f08c7471e6d6ed2d4240a38fe48f94029413","54c87f0bc04f8bfdb622859ab5aab3d243476c30f2eb7fa626ed5b19c40b6e0b","546c56d448b1a52323785701cd883d39c1246fc39b322b47e3c320e0317cfefa","29f435669238845fce451959c9f9c782784d31476d47d4a21fb84fb4dc114ef3","255c51642cdc06232ecd7b9e2fefc0c20f28d6c8de48b457838f3829479de0ef","023092f8c89aa387e6a5065885070c444b709ca6c695d2d0307a43d2811abb0a","94d874e8e8cdcf48bcd2f845d06b7c4d626a544680980faf945f699824c98fbd","0f1f81eac35e7ab9c8dfeeffb4569d3f230191d517bb0ad9a32d1c3e0dabbee3","e50ad7c4ca25339ea19a313a0e3a81b2a84ebbe25256aab776ab4c29fd31190d","9e027ff99a8b51ebe57f3885ec886f4d557a28033648f1fbf4b50972080e5076","c2643a4e6b580d214b15f0d2366ba811cce3a83d1fa51bc958ab029bb48f7b5c","69a1d136606fc7b6b301f6cb6bba6d41fe4e68c8b9bc6a68c34ab5f0791848d5","4d418f52a506ca6f7a7ae767516e778214395b9bd06984270a68ec69a5f16cc5","866eecce17a5cbba25b2d793d577f9f54092d2cc7bb4d7d2e82add707278d03a","395117e36a5990f1893d88785b1e8a159ae37f90b8a3c9ec6e26d763ff51d225"],"paragraph_range_zero_based":[18648,18671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18648"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    locationAndBandwidth                INTEGER (0..37949),","paragraph_zero_based":18672},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":18673},{"literal_text_all_w_t_and_m_t":"    cyclicPrefix                        ENUMERATED { extended }                                                 OPTIONAL    -- Need R","paragraph_zero_based":18674},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18675},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18676},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-STOP","paragraph_zero_based":18677},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18679},{"literal_text_all_w_t_and_m_t":"BWP field descriptions","paragraph_zero_based":18680},{"literal_text_all_w_t_and_m_t":"cyclicPrefix","paragraph_zero_based":18681},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the extended cyclic prefix for this bandwidth part. If not set, the UE uses the normal cyclic prefix. Normal CP is supported for all subcarrier spacings and slot formats. Extended CP is supported only for 60 kHz subcarrier spacing. (see TS 38.211 [16], clause 4.2). Except for SUL, the network ensures the same cyclic prefix length is used in active DL BWP and active UL BWP within a serving cell.","paragraph_zero_based":18682},{"literal_text_all_w_t_and_m_t":"locationAndBandwidth","paragraph_zero_based":18683},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth of this bandwidth part. The value of the field shall be interpreted as resource indicator value (RIV) as defined TS 38.214 [19] with assumptions as described in TS 38.213 [13], clause 12, i.e. setting =275. The first PRB is a PRB determined by subcarrierSpacing of this BWP and offsetToCarrier (configured in SCS-SpecificCarrier contained within FrequencyInfoDL / FrequencyInfoUL / FrequencyInfoUL-SIB / FrequencyInfoDL-SIB within ServingCellConfigCommon / ServingCellConfigCommonSIB) corresponding to this subcarrier spacing. In case of TDD, a BWP-pair (UL BWP and DL BWP with the same bwp-Id) must have the same center frequency (see TS 38.213 [13], clause 12)","paragraph_zero_based":18684},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":18685},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing to be used in this BWP for all channels and reference signals unless explicitly configured elsewhere. Corresponds to subcarrier spacing according to TS 38.211 [16], table 4.2-1. The value kHz15 corresponds to µ=0, value kHz30 corresponds to µ=1, and so on.","paragraph_zero_based":18686},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":18687},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":18688},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":18689},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":18690},{"literal_text_all_w_t_and_m_t":"For the initial DL BWP and operation in licensed spectrum this field has the same value as the field subCarrierSpacingCommon in MIB of the same serving cell. Except for SUL, the network ensures the same subcarrier spacing is used in active DL BWP and active UL BWP within a serving cell. For the initial DL BWP and operation with shared spectrum channel access, the value of this field corresponds to the subcarrier spacing of the SSB associated to the initial DL BWP.","paragraph_zero_based":18691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18692},{"literal_text_all_w_t_and_m_t":"–BWP-Downlink","paragraph_zero_based":18693},{"literal_text_all_w_t_and_m_t":"The IE BWP-Downlink is used to configure an additional downlink bandwidth part (not for the initial BWP).","paragraph_zero_based":18694},{"literal_text_all_w_t_and_m_t":"BWP-Downlink information element","paragraph_zero_based":18695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dbf683b2f240110c090a2299b7149bb51a6dc97ab27e29ecd1ac1f36f540dbba","f30b9933b4a7395438678393e0371487f71da612508f2b919bb211ea60da8cab","bfe3ab7e8aa184d1710942f1953bee9b953b503925f06a54bf94055f5c3f2217","fc6b95d04890a525e472318f2cfaab4b1b18e59ee798efa0f525c4b860c2546a","dafd9f979e7b45d108c156f145c3a9d6717c17010e62d96161b445b17f01fc97","22ffe409f426461258468166820152ea9d2ba7f1c6fe572a3fa27102eb2ccc6d","84dcae8987e23f8e31bf08b4bc45eeb60176d6af9804f4a1021a19081645e4af","8d273ec9f87658243ae358450d3e31e338de31ce393ef2b5ecabd29e4b6474ff","b9bfcf63e24c89de2585a0e4779409c02387888d6495b4b5e4eefe5d65ead2b2","2ecae102e7a1fefde4be16717ab10878130940fb9d4511ece01a5797b94da37a","c685aa531c8303b65a3e76ba0d2f10e8423e071a43dc2363d15c12c647349829","d2b76c05c83e761f539a60620ed56223498fedb6f9ce9df20c004ad49e146e6b","a45d4df307654cfcd3905f0687f4e71ade45dd17e983d7b58268a573ee2446be","63e0016e1e09635eee0be0535b16ad97048af6a2aa7fe4c8251c69c289dcd35a","d18e0e8057592ef931421396793d331989bc0f0533eb891aa35f32db09a8c84a","4205910d0cde0d222dc9995ab3d3d2de182af2dff98cd7c00122888bc0eb6efa","6cad1b64069cfe49ef2479727a8ad60277eefb4ea48f33941e3964a148975a10","7c271145d7785c0a700ef1a6d9f33e4e73b23b6018599e5530ec87957632f153","27e2da6db3c100b386c012907d1ca12f6d2a50fde404dd6f1c8a2fbb9681966c","a5afc3aa7ff2a03329c77aff850036b9a58c60e5750d3945a970d2d475c7a756","a74751d8a72849499687bbd208bbdb27c53020618894ff25699e4667c6e