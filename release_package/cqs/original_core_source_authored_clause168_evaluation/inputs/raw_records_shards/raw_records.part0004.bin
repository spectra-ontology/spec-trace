{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52272},{"literal_text_all_w_t_and_m_t":"CandidateCell-r17 ::=            SEQUENCE {","paragraph_zero_based":52273},{"literal_text_all_w_t_and_m_t":"    physCellId-r17                   PhysCellId,","paragraph_zero_based":52274},{"literal_text_all_w_t_and_m_t":"    condExecutionCondSCG-r17         OCTET STRING (CONTAINING CondReconfigExecCondSCG-r17)               OPTIONAL","paragraph_zero_based":52275},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":52276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52277},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-STOP","paragraph_zero_based":52278},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":52279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52280},{"literal_text_all_w_t_and_m_t":"CG-Config field descriptions","paragraph_zero_based":52281},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListCPC","paragraph_zero_based":52282},{"literal_text_all_w_t_and_m_t":"Contains information regarding candidate target cells for Conditional PSCell Change (CPC) that the source secondary gNB suggests the target secondary gNB to consider configuring for CPC.","paragraph_zero_based":52283},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN","paragraph_zero_based":52284},{"literal_text_all_w_t_and_m_t":"Contains information regarding cells that the source secondary node suggests the target secondary gNB to consider configuring.","paragraph_zero_based":52285},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSN-EUTRA","paragraph_zero_based":52286},{"literal_text_all_w_t_and_m_t":"Includes the MeasResultList3EUTRA as specified in TS 36.331 [10]. Contains information regarding cells that the source secondary node suggests the target secondary eNB to consider configuring. This field is only used in NE-DC.","paragraph_zero_based":52287},{"literal_text_all_w_t_and_m_t":"candidateCellInfoListSubsequentCPC","paragraph_zero_based":52288},{"literal_text_all_w_t_and_m_t":"Contains information regarding candidate target cells for subsequent CPAC that the master gNB or source secondary gNB suggests the target secondary gNB to consider configuring for subsequent CPAC.","paragraph_zero_based":52289},{"literal_text_all_w_t_and_m_t":"candidateServingFreqListNR, candidateServingFreqListEUTRA","paragraph_zero_based":52290},{"literal_text_all_w_t_and_m_t":"Indicates frequencies of candidate serving cells for In-Device Co-existence Indication (see TS 36.331 [10]).","paragraph_zero_based":52291},{"literal_text_all_w_t_and_m_t":"candidateServingFreqListNR-r16","paragraph_zero_based":52292},{"literal_text_all_w_t_and_m_t":"indicates the candidate frequencies configured by SN for IDC. This field is only used in NR-DC.","paragraph_zero_based":52293},{"literal_text_all_w_t_and_m_t":"candidateServingFreqRangeListNR","paragraph_zero_based":52294},{"literal_text_all_w_t_and_m_t":"indicates the candidate frequency ranges configured by SN for IDC. This field is only used in NR-DC.","paragraph_zero_based":52295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9cf8a34a9402e663cc6294d9f1d37b1fcc294a467d7e4f0bd0336c9dbac79f93","faad8f86abfb5f4e68f5aa1040d750ef14a3b90398c42198cd44646385572e3d","cfb1bc0060e2ad4f4a3e4a05cc2e0145d9f7502200f673218724d60d964398a4","672fdc0fe37812762b1c58b2b60f84aa5791b379ed71978efcf23a0702d96246","9c0723bdaf1f2b9d6e83e8487bee0a1ca515357212eff082e9f4bbeef8a2c2ee","8c772a9e2c966399f112744ea56b46dabee2e1f627b8cf7ffdf9443290c6f03d","fb256227247f4dc401d1e89f90feab1ea5a66387855e4cd6ece76a8926cd89e2","ba1e38d1b1627768164196d40ced609207649f1f09c9a01902c9e6f63e698e81","28079f49f00c31615bc8bc64519257f15840da8b9bc580f73ca36820180d8ee9","73d576756b2f83437388054b9f82353de7fa763e5145ff5cc0af7e45694e9002","156921369b04129d348f4e9584efcce84298235be92987940293f9ce0a133928","8f01d9be99514a6d9a09610ba8d64e217910233ee815f7fefbbeca221d33422b","0cd7bbf2d807999f5f99b97c2f576d2e63af716c57758681c43aaa971ee6597c","307f3f46b4412b86caf08740b30addc91df6a539b253847b03e325b77233eb21","c1e894c1399474a5f5408e5adb81836331abd9453e5157a4ec847a7adb1d30c8","efa68fce7320c2866bfc9cda805b5d6ff0b9595c3da9417c5f338883771a5fb8","20dd4e552c1ecdebff1c9c547076477133b6fce8e747c9a638928887fcd05bca","73303f3a63b1528b54d1c9773851652772fa3ec37d29c4dd0a7f4ac79937e34b","eb732f03fbfc92e045a0f389a1e5908755654de686e384550b49be6563ed12f2","e32c7c67ab4e55f59560f31a62f15d403cdea38234ef71ef70371fd68ffece3f","8f684360ec50543241a79b5c736d6194b05d0f3d9301dbb70c75c747f9aca209","0af56e647a34bd462a36472d3b4de3b6409b15b42b1769d3da6bd3486548dde9","f4798f14a9eca1a82660ba2f11239dfe2f55e4e330ae71f3ea53cd4cdaf96475","a18e0b854d9511f6da2e3c918cd45e084f15983dc915c4fe49de81ca2d9030bf"],"paragraph_range_zero_based":[52272,52295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52272"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"configRestrictModReq","paragraph_zero_based":52296},{"literal_text_all_w_t_and_m_t":"Used by SN to request changes to SCG configuration restrictions previously set by MN to ensure UE capabilities are respected. E.g. can be used to request configuring an NR band combination whose use MN has previously forbidden. SN only includes this field in SN-initiated procedures.","paragraph_zero_based":52297},{"literal_text_all_w_t_and_m_t":"drx-ConfigSCG","paragraph_zero_based":52298},{"literal_text_all_w_t_and_m_t":"This field contains the complete DRX configuration of the SCG. This field is only used in NR-DC.","paragraph_zero_based":52299},{"literal_text_all_w_t_and_m_t":"drx-InfoSCG","paragraph_zero_based":52300},{"literal_text_all_w_t_and_m_t":"This field contains the DRX long and short cycle configuration of the SCG. This field is used in (NG)EN-DC and NE-DC.","paragraph_zero_based":52301},{"literal_text_all_w_t_and_m_t":"drx-InfoSCG2","paragraph_zero_based":52302},{"literal_text_all_w_t_and_m_t":"This field contains the drx-onDurationTimer configuration of the SCG. This field is only used in (NG)EN-DC.","paragraph_zero_based":52303},{"literal_text_all_w_t_and_m_t":"fr-InfoListSCG","paragraph_zero_based":52304},{"literal_text_all_w_t_and_m_t":"Contains information of FR information of serving cells that include PScell and SCells configured in SCG.","paragraph_zero_based":52305},{"literal_text_all_w_t_and_m_t":"fr1-Carriers-SCG, fr2-Carriers-SCG","paragraph_zero_based":52306},{"literal_text_all_w_t_and_m_t":"Indicates the number of FR1 or FR2 serving cells configured in SCG.","paragraph_zero_based":52307},{"literal_text_all_w_t_and_m_t":"idc-TDM-AssistanceConfig","paragraph_zero_based":52308},{"literal_text_all_w_t_and_m_t":"Indicates if the IDC TDM reporting is enabled for the UE by SN. This field is only used in NR-DC.","paragraph_zero_based":52309},{"literal_text_all_w_t_and_m_t":"measuredFrequenciesSN","paragraph_zero_based":52310},{"literal_text_all_w_t_and_m_t":"Used by SN to indicate a list of frequencies measured by the UE.","paragraph_zero_based":52311},{"literal_text_all_w_t_and_m_t":"needForGaps","paragraph_zero_based":52312},{"literal_text_all_w_t_and_m_t":"In NE-DC, indicates whether the SN requests gNB to configure measurements gaps.","paragraph_zero_based":52313},{"literal_text_all_w_t_and_m_t":"ph-InfoSCG","paragraph_zero_based":52314},{"literal_text_all_w_t_and_m_t":"Power headroom information in SCG that is needed in the reception of PHR MAC CE of MCG","paragraph_zero_based":52315},{"literal_text_all_w_t_and_m_t":"ph-SupplementaryUplink","paragraph_zero_based":52316},{"literal_text_all_w_t_and_m_t":"Power headroom information for supplementary uplink. In the case of (NG)EN-DC and NR-DC, this field is only present when two UL carriers are configured for a serving cell and one UL carrier reports type1 PH while the other reports type 3 PH.","paragraph_zero_based":52317},{"literal_text_all_w_t_and_m_t":"ph-Type1or3","paragraph_zero_based":52318},{"literal_text_all_w_t_and_m_t":"Type of power headroom for a certain serving cell in SCG (PSCell and activated SCells). Value type1 refers to type 1 power headroom, value type3 refers to type 3 power headroom. (See TS 38.321 [3]).","paragraph_zero_based":52319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a3b206a7f62c12169fe9ddff4263c5da35fadd2db9e4c449004eaf94b59669cf","61ad25741408dd79fd2ba530649bf21b47ed3b4143e5cb6466bcebc94896a8dd","18cf6773d836c57d47f31fdb4131d6e2e7d4526f173e1d430042066d07a8fb7f","60a29b45473462fae3d661e1dabc131b3b1d14d13a68a589d5d23e768e6b82ae","6d5ae7893d2b59831785e029d24bbb5f69ed0bf83a8b32ac11e8f8aa2d169b18","b7bb885802d0c3a691a0a89dfbca2cd9b7258318e1201bede82f7680952ca827","8f268788b9f3edf52ef8abae326aa612cba8abea552400f1d0c82fbfa53a045c","6a9720aaa5cf43886c2e98263687af793debc492dfec0db68b021a01efe5e12a","7923d14b33558d3d19000ea0edcb92b3db5115e8a3e60a04a542d2130e6c4e0b","4a04e0bb1614d4b24c53ee6844fc0a1c3b7ca2ce9cf1ecc827aa438e98a8fb0f","46ac8a220e1ee9974d22e27388ee0bf29f6a5db9f950b9e5d44848ae0278e747","be25a862b0cc5748373d14eac4cd8e818fe133db3baf0b44bd6d2836f2a9f425","55acf8883efa6a27cd6b378d7af1b7d4b6af0d7744705ab7c51286aa36bb97c4","fbcec3f731d7eb784b9c0affe5eea13ff7093e5d4a1342895f25faef617fb195","56a949c2a001359d16a55bd45b2ba869f57b32af1080775da53d953099ecb3a9","064f641094a687d679a1953a4c7cfda0a2b65b140b70950d695689f099c60d54","0243450874748fc434cf32995bea17be51fc9728057775a3be25844e2bdc2f7d","45bef0706468fdf57987a9867172fc98f5d497c644bc4938f1e3652a7dfd7069","654a323b01629327014569ed8850edeff0fd9a23788b5d3e296ac97534a6328a","f7583804656d9a8bc7fb07fff41b07d9b3d7279b082baec9cce162e29c79e653","14394e256a5ef6dd4c7f98691fcc2012a265935325c27a89ae4d83284b475fc5","c2ec6a200bd7753e9fce9d88e7bc1906c825e9bf261f23e153c1153ec0cdfa89","80e2cb794b61c8ab7ffd553164d27ea2d523386f4f25c8b0f7a202e49240eb34","0fdc99e5846ee7ce72c3a0a91ad4ef718a2f1bd1dc648381f113610b1ed7fb65"],"paragraph_range_zero_based":[52296,52319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52296"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ph-Uplink","paragraph_zero_based":52320},{"literal_text_all_w_t_and_m_t":"Power headroom information for uplink.","paragraph_zero_based":52321},{"literal_text_all_w_t_and_m_t":"pSCellFrequency, pSCellFrequencyEUTRA","paragraph_zero_based":52322},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of PSCell in NR (i.e., pSCellFrequency) or E-UTRA (i.e., pSCellFrequencyEUTRA). In this version of the specification, pSCellFrequency is not used in NE-DC whereas pSCellFrequencyEUTRA is only used in NE-DC. pSCellFrequency indicates the absoluteFrequencySSB.","paragraph_zero_based":52323},{"literal_text_all_w_t_and_m_t":"reportCGI-RequestNR, reportCGI-RequestEUTRA","paragraph_zero_based":52324},{"literal_text_all_w_t_and_m_t":"Used by SN to indicate to MN about configuring reportCGI procedure. The request may optionally contain information about the cell for which SN intends to configure reportCGI procedure. In this version of the specification, the reportCGI-RequestNR is used in (NG)EN-DC and NR-DC whereas reportCGI-RequestEUTRA is used only for NE-DC.","paragraph_zero_based":52325},{"literal_text_all_w_t_and_m_t":"requestedBC-MRDC","paragraph_zero_based":52326},{"literal_text_all_w_t_and_m_t":"Used to request configuring a band combination and corresponding feature sets which are forbidden to use by MN (i.e. outside of the allowedBC-ListMRDC) to allow re-negotiation of the UE capabilities for SCG configuration.","paragraph_zero_based":52327},{"literal_text_all_w_t_and_m_t":"reservedResourceConfigNRDC","paragraph_zero_based":52328},{"literal_text_all_w_t_and_m_t":"Used to request or indicate the maximum number of resources reserved for the SCG. This field is only used in NR-DC.","paragraph_zero_based":52329},{"literal_text_all_w_t_and_m_t":"requestedMaxInterFreqMeasIdSCG","paragraph_zero_based":52330},{"literal_text_all_w_t_and_m_t":"Used to request the maximum number of allowed measurement identities to configure for inter-frequency measurement. This field is only used in NR-DC.","paragraph_zero_based":52331},{"literal_text_all_w_t_and_m_t":"requestedMaxIntraFreqMeasIdSCG","paragraph_zero_based":52332},{"literal_text_all_w_t_and_m_t":"Used to request the maximum number of allowed measurement identities to configure for intra-frequency measurement on each serving frequency.","paragraph_zero_based":52333},{"literal_text_all_w_t_and_m_t":"requestedPDCCH-BlindDetectionSCG","paragraph_zero_based":52334},{"literal_text_all_w_t_and_m_t":"Requested value of the reference number of cells for PDCCH blind detection allowed to be configured for the SCG.","paragraph_zero_based":52335},{"literal_text_all_w_t_and_m_t":"requestedP-MaxEUTRA","paragraph_zero_based":52336},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells the UE can use in E-UTRA SCG. This field is only used in NE-DC.","paragraph_zero_based":52337},{"literal_text_all_w_t_and_m_t":"requestedP-MaxFR1","paragraph_zero_based":52338},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells on frequency range 1 (FR1) in this secondary cell group (see TS 38.104 [12]) the UE can use in NR SCG.","paragraph_zero_based":52339},{"literal_text_all_w_t_and_m_t":"requestedP-MaxFR2","paragraph_zero_based":52340},{"literal_text_all_w_t_and_m_t":"Requested value for the maximum power for the serving cells on frequency range 2 (FR2) in this secondary cell group the UE can use in NR SCG. This field is only used in NR-DC.","paragraph_zero_based":52341},{"literal_text_all_w_t_and_m_t":"requestedToffset","paragraph_zero_based":52342},{"literal_text_all_w_t_and_m_t":"Requests the new value for the time offset restriction used by the SN for scheduling SCG transmissions (i.e. Tproc,SCG,max see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1ms and so on.","paragraph_zero_based":52343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f1ffb984c5d39f36cbbe1e6e5b513b38273db404f03d54da7220d07990cdf199","41622c6328fb2e462267a6f2d5e00ab8c8c83750ed6b04e77861097d7aeeec23","6fa101de3bb199c8307e09eb80e9345ec871e7188796b940303a28b569774618","4d2aa16651dd01880fa73461106696e921ea6807c7726b5c746e10acf117796f","6f4c4495e93de4b24c2af267c5c3b6ce3df33a9b24e9d1fcc7f85c01097b067e","e7d3f1f8aea98cb0f0838168130d200759c5399d415313a93573d109c207c059","ef37c42e7cb58a1008ad3d8024109c09cc56b024695ff1bcdf9a54f30b96ee8d","5e724d94828a384edec1e59517dd79aba3a82c30335721b315c7ba37967307c8","6a131e0ac39da60b8f6232fbe9079ac6e9da20cb0611cb14c3caf9b0e58eece2","3e142f75cefebd5c634bf2085fa93e91ac30db2f6754d607f8ef99ee49f36704","81a2f135780345b95f01ed1e911f45f5d48cba2606834130a687af7b76ffd224","203db0f9553ec8275ebeb3216f2326d6e011dfcac20c406f0c45333b725aa5cb","205293d6f85afe1d47e0a0007a8a3e7b196c81520bdb966bb95cd064ad0cfe12","611400e22e3e155a5e636d3448c021fc2de11d51dfd0ec803cc83cbb9fbee1e9","b99b42c4dec71b7cd30dab85046235ec6e787c4eeaec4f6f79be2bbad2e5e73c","2996021fd2c72da531163577c56c702a69e6eb73aa92013a366547a0b7525231","8a8e57fc61589702296f0cccc19fd7614619ebae6d0f354b30e5df09eec3042c","e1d2071f1e79e45de4f9efb56ca9e026fc6b1479f861e6950c945540c8b2708d","6431a425e37ab16349a2f4aed53c77c06af78a7c7fcf3fecf2e0ca13bcd53547","ece1a3d05bcb19fe8fdf25313c4ef74f4a4097e357dffba5bb69c8d751c30d3e","24615c0736235eeed5c9b76a27844e28071d1b53201bea51357d39377e74a825","95988a633de2486ba7188134f999a75045b0bfab82dcb38f99ea1203699d1456","eecc56cddd367ca81ace13a7fa4f8999ca6518622bfde30254df39c06d025429","9e6ff6f40d8d9e84cfe00600c9068c635925f2783b796a77c12f14a0a09f813e"],"paragraph_range_zero_based":[52320,52343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52320"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"scellFrequenciesSN-EUTRA, scellFrequenciesSN-NR","paragraph_zero_based":52344},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of all SCells with SSB configured in SCG. The field scellFrequenciesSN-EUTRA is used in NE-DC; the field scellFrequenciesSN-NR is used in (NG)EN-DC and NR-DC. In (NG)EN-DC, the field is optionally provided to the MN. scellFrequenciesSN-NR indicates absoluteFrequencySSB.","paragraph_zero_based":52345},{"literal_text_all_w_t_and_m_t":"scg-CellGroupConfig","paragraph_zero_based":52346},{"literal_text_all_w_t_and_m_t":"Contains the RRCReconfiguration message (containing only secondaryCellGroup and/or measConfig and/or otherConfig and/or appLayerMeasConfig and/or conditionalReconfiguration and/or bap-Config and/or iab-IP-AddressConfigurationList):","paragraph_zero_based":52347},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used upon SCG establishment or modification (only when the SCG is not released by the SN), as generated (entirely) by the (target) SgNB. In this case, the SN sets the RRCReconfiguration message in accordance with clause 6 e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":52348},{"literal_text_all_w_t_and_m_t":" or","paragraph_zero_based":52349},{"literal_text_all_w_t_and_m_t":"-including the current SCG configuration of the UE, when provided in response to a query from MN, or in SN triggered SN change in order to enable delta signaling by the target SN, or in SN triggered modification procedure in order to coordinate CHO or MN-initiated CPC with SCG reconfigurations (see TS 38.423 [35]). In this case, the SN sets the RRCReconfiguration message in accordance with clause 11.2.3.","paragraph_zero_based":52350},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered modification procedure in order to coordinate CHO or MN-initiated CPC with SCG reconfigurations (see TS 38.423 [35]) nor SN triggered SN change is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG (re)configuration towards the UE. The field is also absent upon an SCG release triggered by the SN. This field is not applicable in NE-DC.","paragraph_zero_based":52351},{"literal_text_all_w_t_and_m_t":"scg-CellGroupConfigEUTRA","paragraph_zero_based":52352},{"literal_text_all_w_t_and_m_t":"Includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message can only include the field scg-Configuration:","paragraph_zero_based":52353},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used to (re-)configure the SCG configuration upon SCG establishment or modification (only when the SCG is not released by the SN), as generated (entirely) by the (target) SeNB. In this case, the SN sets the scg-Configuration within the EUTRA RRCConnectionReconfiguration message in accordance with clause 6 in TS 36.331 [10] e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":52354},{"literal_text_all_w_t_and_m_t":"or","paragraph_zero_based":52355},{"literal_text_all_w_t_and_m_t":"-including the current SCG configuration of the UE, when provided in response to a query from MN, or in SN triggered SN change in order to enable delta signalling by the target SN.","paragraph_zero_based":52356},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered SN change is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG (re)configuration towards the UE. The field is also absent upon an SCG release triggered by the SN. This field is only used in NE-DC.","paragraph_zero_based":52357},{"literal_text_all_w_t_and_m_t":"scg-RB-Config","paragraph_zero_based":52358},{"literal_text_all_w_t_and_m_t":"Contains the IE RadioBearerConfig:","paragraph_zero_based":52359},{"literal_text_all_w_t_and_m_t":"-to be sent to the UE, used to (re-)configure the SCG RB configuration upon SCG establishment or modification, as generated (entirely) by the (target) SgNB or SeNB. In this case, the SN sets the RadioBearerConfig in accordance with clause 6, e.g. regarding the \"Need\" or \"Cond\" statements.","paragraph_zero_based":52360},{"literal_text_all_w_t_and_m_t":" or","paragraph_zero_based":52361},{"literal_text_all_w_t_and_m_t":"-including the current SCG RB configuration of the UE, when provided in response to a query from MN or in SN triggered SN change or in SN triggered SN release or bearer type change between SN terminated bearer to MN terminated bearer in order to enable delta signaling by the MN or target SN. In this case, the SN sets the RadioBearerConfig in accordance with clause 11.2.3.","paragraph_zero_based":52362},{"literal_text_all_w_t_and_m_t":"The field is absent if neither SCG (re)configuration nor SCG configuration query nor SN triggered SN change nor SN triggered SN release is performed, e.g. at inter-node capability/configuration coordination which does not result in SCG RB (re)configuration.","paragraph_zero_based":52363},{"literal_text_all_w_t_and_m_t":"scpac-ReferenceConfigurationSCG","paragraph_zero_based":52364},{"literal_text_all_w_t_and_m_t":"Includes the reference configuration associated with the SCG for the candidate supporting subsequent CPAC.","paragraph_zero_based":52365},{"literal_text_all_w_t_and_m_t":"selectedBandCombination","paragraph_zero_based":52366},{"literal_text_all_w_t_and_m_t":"Indicates the band combination selected by SN in (NG)EN-DC, NE-DC, and NR-DC. The SN should inform the MN with this field whenever the band combination and/or feature set it selected for the SCG changes (i.e. even if the new selection concerns a band combination and/or feature set that is allowed by the allowedBC-ListMRDC)","paragraph_zero_based":52367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2161ef42e0047c7ffaca724607cf6ce023b0b2398416d465988adb042b448d61","d4a46b2b941b2711271161a0ec688ec0070a83e3702a54e3c0d056e69f30d44c","a8cae0f48ab9184897a2e196799525c4d3244390dc7e34ed7091d5502230f305","c7753914826ba61e9cc36893d64814d2695631e38ffdffffbe87d03eb2930ca9","027a1b1a30ff93af0e68d9c58189daa0f4c7a7e173ab10a0337c925be429d8f6","b420ebd63dc8919cfb3ecc1b54072f8d9b9b55172264a1ffc5b70169b51e977d","10ddacbf7d2af70ec9e5f2d62bd01fec43ffc360d9d07b5334ce6899afcf411a","d3fee4a31e0f72214fa65083ca1b5d5120d89213099d9f58693906710cdddb11","c4a93a3027a33510b80aece8f234364543bfcc66f7bc52155499cc01857b93ec","0c9647b9b73cb98fd3cb51b7947c1aed2afceafa950834eb5c03903eb4029188","f3508b981ec68d09ac423f4c35e9877984680375af0cb8742f2614d2bf9a84ca","d7731b91fbcb49091f7815fc87dbcda8d4580462d43a700344035b48639ffbe7","1020cabfc253fb6ddd9f7f6ff3c988d0dd01547c5933d81431c3a050279c345a","2cc02297a0db5b1397364528b3a09f26b64521ead203620b037351684826843a","3971509ebe67366524985c96f9c1714131f80e5e9f87ac3fbb4df1d8144e1352","da959f7500fef6f5449abda9523f9168438d39b821cd4077646f2121d2e84cbb","6a6f8d66968f18fbe96b44b6d930ac0f1665e70aab24624553215a9d2b568035","df8173c46f3a523646130272bacbeeeceb284bbb42ab58c5e21dfe9106a67819","aabe0359c7667d1f29912edbceda51ce8db1d2896a555211cd91cf402e13a283","6e93a5c64bbd83d8005b5786b3d318f5aac980badb94a687b69b9805f3221b9e","06320911a7da2e490a7b09f08f07a98f9cc7bbdc737b26ab4c506f40612b937e","85a8ddedb16720cfa82a942dd8e0decbb65fdf453dbb162678b6527e9ff4b9e0","83c0c8fbfa94992a401534b70e9ca1525388b8780b9fe2373b8d210814ad543d","cdec8af714558af894db8a6d4596d2300284f8b8b8822b1a7796495094180705"],"paragraph_range_zero_based":[52344,52367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p52344"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"selectedToffset","paragraph_zero_based":52368},{"literal_text_all_w_t_and_m_t":"Indicates the value used by the SN for scheduling SCG transmissions (i.e. Tproc,SCGmax, see TS 38.213 [13]). This field is used in NR-DC only when the fields nrdc-PC-mode-FR1-r16 or nrdc-PC-mode-FR2-r16 are set to dynamic. The SN can only indicate a value that is less than or equal to maxToffset received from MN. This field is used in NR-DC only when MN has included the field maxToffset in CG-ConfigInfo. Value ms0dot5 corresponds to 0.5 ms, value ms0dot75 corresponds to 0.75 ms, value ms1 corresponds to 1ms and so on.","paragraph_zero_based":52369},{"literal_text_all_w_t_and_m_t":"servCellInfoListSCG-EUTRA","paragraph_zero_based":52370},{"literal_text_all_w_t_and_m_t":"Indicates the carrier frequency and the transmission bandwidth of the serving cell(s) in the SCG in intra-band NE-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in NE-DC.","paragraph_zero_based":52371},{"literal_text_all_w_t_and_m_t":"servCellInfoListSCG-NR","paragraph_zero_based":52372},{"literal_text_all_w_t_and_m_t":"Indicates the frequency band indicator, carrier center frequency, UE specific channel bandwidth and SCS of the serving cell(s) in the SCG in intra-band (NG)EN-DC. The field is needed when MN and SN operate serving cells in the same band for either contiguous or non-contiguous intra-band band combination or LTE NR inter-band band combinations where the frequency range of the E-UTRA band is a subset of the frequency range of the NR band (as specified in Table 5.5B.4.1-1 of TS 38.101-3 [34]) in (NG)EN-DC.","paragraph_zero_based":52373},{"literal_text_all_w_t_and_m_t":"twoPHRModeSCG","paragraph_zero_based":52374},{"literal_text_all_w_t_and_m_t":"Indicates if the power headroom for SCG shall be reported as two PHRs (each PHR associated with a SRS resource set) is enabled or not.","paragraph_zero_based":52375},{"literal_text_all_w_t_and_m_t":"twoSRS-PUSCH-Repetition","paragraph_zero_based":52376},{"literal_text_all_w_t_and_m_t":"Indicates whether the indicated serving cell is configured for PUSCH repetition corresponding to two SRS resource sets configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":52377},{"literal_text_all_w_t_and_m_t":"transmissionBandwidth-EUTRA","paragraph_zero_based":52378},{"literal_text_all_w_t_and_m_t":"Indicates the transmission bandwidth on an E-UTRA carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" TS 36.104 [33]. The values rb6, rb15, rb25, rb50, rb75, rb100 indicate 6, 15, 25, 50, 75 and 100 resource blocks respectively.","paragraph_zero_based":52379},{"literal_text_all_w_t_and_m_t":"ueAssistanceInformationSCG","paragraph_zero_based":52380},{"literal_text_all_w_t_and_m_t":"Includes for each UE assistance feature associated with the SCG, the information last reported by the UE in the NR UEAssistanceInformation message for the SCG, if any.","paragraph_zero_based":52381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52382},{"literal_text_all_w_t_and_m_t":"BandCombinationInfoSN field descriptions","paragraph_zero_based":52383},{"literal_text_all_w_t_and_m_t":"bandCombinationIndex","paragraph_zero_based":52384},{"literal_text_all_w_t_and_m_t":"In case of NR-DC, this field indicates the position of a band combination in the supportedBandCombinationList. In case of NE-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationListNEDC-Only. In case of (NG)EN-DC, this field indicates the position of a band combination in the supportedBandCombinationList and/or supportedBandCombinationList-UplinkTxSwitch. Band combination entries in supportedBandCombinationList are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList. Band combination entries in supportedBandCombinationListNEDC-Only are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationListNEDC-Only increased by the number of entries in supportedBandCombinationList. Band combination entries in supportedBandCombinationList-UplinkTxSwitch are referred by an index which corresponds to the position of a band combination in the supportedBandCombinationList-UplinkTxSwitch increased by the number of entries in supportedBandCombinationList.","paragraph_zero_based":52385},{"literal_text_all_w_t_and_m_t":"requestedFeatureSets","paragraph_zero_based":52386},{"literal_text_all_w_t_and_m_t":"The position in the FeatureSetCombination which identifies one FeatureSetUplink/Downlink for each band entry in the associated band combination","paragraph_zero_based":52387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52388},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":52389},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":52390},{"literal_text_all_w_t_and_m_t":"FDD","paragraph_zero_based":52391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6f3011d96c215f42816d9ad316b545ad98bd456541e65a2a38b01fa8579f31b0","f41fc53dbc3f1004b7af