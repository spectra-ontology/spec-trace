{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"TCI-UL-State-r17 ::=             SEQUENCE {","paragraph_zero_based":35832},{"literal_text_all_w_t_and_m_t":"    tci-UL-StateId-r17              TCI-UL-StateId-r17,","paragraph_zero_based":35833},{"literal_text_all_w_t_and_m_t":"    servingCellId-r17                ServCellIndex                                         OPTIONAL,   -- Need R","paragraph_zero_based":35834},{"literal_text_all_w_t_and_m_t":"    bwp-Id-r17                       BWP-Id                                                OPTIONAL,   -- Cond CSI-RSorSRS-Indicated","paragraph_zero_based":35835},{"literal_text_all_w_t_and_m_t":"    referenceSignal-r17              CHOICE {","paragraph_zero_based":35836},{"literal_text_all_w_t_and_m_t":"        ssb-Index-r17                    SSB-Index,","paragraph_zero_based":35837},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index-r17                 NZP-CSI-RS-ResourceId,","paragraph_zero_based":35838},{"literal_text_all_w_t_and_m_t":"        srs-r17                          SRS-ResourceId","paragraph_zero_based":35839},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":35840},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                AdditionalPCIIndex-r17                                OPTIONAL,   -- Need R","paragraph_zero_based":35841},{"literal_text_all_w_t_and_m_t":"    ul-powerControl-r17              Uplink-powerControlId-r17                             OPTIONAL,   -- Need R","paragraph_zero_based":35842},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRS-Id-r17       PathlossReferenceRS-Id-r17                            OPTIONAL,   -- Cond Mandatory","paragraph_zero_based":35843},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35844},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35845},{"literal_text_all_w_t_and_m_t":"    tag-Id-ptr-r18                   ENUMERATED {n0,n1}                                    OPTIONAL    -- Cond 2TA","paragraph_zero_based":35846},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":35847},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35849},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-STOP","paragraph_zero_based":35850},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35852},{"literal_text_all_w_t_and_m_t":"TCI-UL-State field descriptions","paragraph_zero_based":35853},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":35854},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB. In case the servingCellId is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field servingCellId. Otherwise, it refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell where the ul-TCI-StateList is applied by the UE.","paragraph_zero_based":35855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["116d7931273469dd2b4d6db9c35b8001d8af037c201ee8f39d552f09dd0b6b1c","035a33e9575155fa3c3693c4adea07abd135b9f0250c353b2249b4a3f522ff4f","3029043a240959c9d5f9cc957b1d52582868351d5474528c8286b9ebdf0481dc","608e63347441d81f926c4384fb754c5743eb085637527ed2b84530b40d8f6d9a","03e18507156355e8a60d13bb8472bfbddfc93ed24255c019d53c47ad