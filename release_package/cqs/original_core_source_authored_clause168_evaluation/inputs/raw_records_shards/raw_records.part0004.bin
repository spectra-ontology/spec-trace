{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-START","paragraph_zero_based":21000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21001},{"literal_text_all_w_t_and_m_t":"ControlResourceSet ::=              SEQUENCE {","paragraph_zero_based":21002},{"literal_text_all_w_t_and_m_t":"    controlResourceSetId                ControlResourceSetId,","paragraph_zero_based":21003},{"literal_text_all_w_t_and_m_t":"    frequencyDomainResources            BIT STRING (SIZE (45)),","paragraph_zero_based":21004},{"literal_text_all_w_t_and_m_t":"    duration                            INTEGER (1..maxCoReSetDuration),","paragraph_zero_based":21005},{"literal_text_all_w_t_and_m_t":"    cce-REG-MappingType                 CHOICE {","paragraph_zero_based":21006},{"literal_text_all_w_t_and_m_t":"        interleaved                         SEQUENCE {","paragraph_zero_based":21007},{"literal_text_all_w_t_and_m_t":"            reg-BundleSize                      ENUMERATED {n2, n3, n6},","paragraph_zero_based":21008},{"literal_text_all_w_t_and_m_t":"            interleaverSize                     ENUMERATED {n2, n3, n6},","paragraph_zero_based":21009},{"literal_text_all_w_t_and_m_t":"            shiftIndex                          INTEGER(0..maxNrofPhysicalResourceBlocks-1)       OPTIONAL -- Need S","paragraph_zero_based":21010},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":21011},{"literal_text_all_w_t_and_m_t":"        nonInterleaved                      NULL","paragraph_zero_based":21012},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21013},{"literal_text_all_w_t_and_m_t":"    precoderGranularity                 ENUMERATED {sameAsREG-bundle, allContiguousRBs},","paragraph_zero_based":21014},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToAddList           SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":21015},{"literal_text_all_w_t_and_m_t":"    tci-StatesPDCCH-ToReleaseList       SEQUENCE(SIZE (1..maxNrofTCI-StatesPDCCH)) OF TCI-StateId OPTIONAL, -- Cond NotSIB-initialBWP","paragraph_zero_based":21016},{"literal_text_all_w_t_and_m_t":"    tci-PresentInDCI                        ENUMERATED {enabled}                                  OPTIONAL, -- Need S","paragraph_zero_based":21017},{"literal_text_all_w_t_and_m_t":"    pdcch-DMRS-ScramblingID                 INTEGER (0..65535)                                    OPTIONAL, -- Need S","paragraph_zero_based":21018},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21019},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21020},{"literal_text_all_w_t_and_m_t":"    rb-Offset-r16                       INTEGER (0..5)                                            OPTIONAL, -- Need S","paragraph_zero_based":21021},{"literal_text_all_w_t_and_m_t":"    tci-PresentDCI-1-2-r16              INTEGER (1..3)                                            OPTIONAL, -- Need S","paragraph_zero_based":21022},{"literal_text_all_w_t_and_m_t":"    coresetPoolIndex-r16                INTEGER (0..1)                                            OPTIONAL, -- Need S","paragraph_zero_based":21023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["38448354870f4bc37eb9974421afeea6eeb92b359b2e90f9b0db0f9f77e393b7","92c7e08230e6f84a77fb885c471e57040157e2145cc821bd3a2393c3f75d2cbe","6efa112798d2e4a7ac4f463bf085cdff58e4e9a4381aaf0a6a3b92d9e99e19c0","c09e307569b63a315d065aab501ab39c09ac29ef3f4ac177da69c5be3615e38c","dc574dbb7b422a377023b43bfec01bb0893e5f9ce31f4e5f9852a66214df248a","185ea92c13d3d3e31e68894d81bc3ac26d4bb4e679a252c1da0e5f3a9a94e61f","c923d804a4a8337578b168542bb36142efebad5e4846dbe455e20d6457e03760","40e84008abe9a19daccb878a7a336bc7595b17348d4f709e5ca45929456bc717","a23aadd52edf110b8e889e67537687cb5b3dc7ae7ca47fbe42b86cf20e5af322","f7b087ca211512e14ae0142ff02892c45c22cd1679960220439f67e514d863b1","1df7b5e304a46de976fc348b6dfa790d711a54e9981e81d9640fe34cb1bf5924","b5d078700fe4ea81029b384abe420476092989c8c0b667bcfaa98f15cae3c0cd","e0469a6dbf1fd09f35cd4633e593294aebbdc633a4d612aa7e0275c427b79d97","98947bfe6f68af3147d3fe8ddf1d18fb31ccab0990cfb2d70606579cdec1ea2e","f7daa0fc91faf8f1765413ea4594f838dd1ca9cfb679ba6b9aa617cc4b075351","452a5a065e0c621499097e9e652ad1b384bf34f39110ebf1b203e2096d9d67ba","857c8412453a182a3cecfc4c571235cbe1828e8f3f5a75d5a8e484887104b77a","eb896c391f66e8bc2938db5c4cd293a1fb8f7d7593f610d4ad3b2b1df956d997","5271d54ff0e6a6ee575ba6ba00c03b1ab46abc6774939da188fe5518cf8ac3fc","222423a6e9098c658eb90ddd3f53d737bbbae6f2317c398a63cbf5ba981d137a","dfcf4dd332999d4e5be948ce5f029048ce71dc61b1827735eccb6f760fa41fe0","b74b1f96793483d30f3afd07bc8ad98f37acd8aefef0f6d632ef675821cfa81e","d38d287137d493a1d5b4d6cee485e89b3671bec5117723c44c4e85009b737fab","1add80789af2f4e1c38047b43b3d1bdbeacf404309e8f3e1fbe01f2e002d350b"],"paragraph_range_zero_based":[21000,21023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21000"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    controlResourceSetId-v1610          ControlResourceSetId-v1610                                OPTIONAL  -- Need S","paragraph_zero_based":21024},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21025},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21026},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-r17          ENUMERATED {enabled}                                      OPTIONAL  -- Need R","paragraph_zero_based":21027},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21028},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21029},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-State-r18         ENUMERATED {first, second, both,  none}                   OPTIONAL  -- Cond FollowUTCI","paragraph_zero_based":21030},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21031},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21032},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21033},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESET-STOP","paragraph_zero_based":21034},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21035},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21036},{"literal_text_all_w_t_and_m_t":"ControlResourceSet field descriptions","paragraph_zero_based":21037},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":21038},{"literal_text_all_w_t_and_m_t":"This field indicates, for PDCCH reception on this CORESET, if UE applies the first, the second, both or none \"indicated\" DL only TCI or joint TCI as specified in TS 38.213 [13], clause 10.1.","paragraph_zero_based":21039},{"literal_text_all_w_t_and_m_t":"cce-REG-MappingType","paragraph_zero_based":21040},{"literal_text_all_w_t_and_m_t":"Mapping of Control Channel Elements (CCE) to Resource Element Groups (REG) (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":21041},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":21042},{"literal_text_all_w_t_and_m_t":"Identifies the instance of the ControlResourceSet IE. Value 0 identifies the common CORESET configured in MIB and in ServingCellConfigCommon (controlResourceSetZero) and is hence not used here in the ControlResourceSet IE. Other values identify CORESETs configured by dedicated signalling or in SIB1 or SIB20. The controlResourceSetId is unique among the BWPs of a serving cell.","paragraph_zero_based":21043},{"literal_text_all_w_t_and_m_t":"If the field controlResourceSetId-v1610 is present, the UE shall ignore the controlResourceSetId field (without suffix).","paragraph_zero_based":21044},{"literal_text_all_w_t_and_m_t":"coresetPoolIndex","paragraph_zero_based":21045},{"literal_text_all_w_t_and_m_t":"The index of the CORESET pool for this CORESET as specified in TS 38.213 [13] (clauses 9 and 10) and TS 38.214 [19] (clauses 5.1 and 6.1). If the field is absent, the UE applies the value 0.","paragraph_zero_based":21046},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":21047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5c9f77e780050fe5d592ffafbe0b17429ee5e07ed0aa5303207acd6deda1cd59","c187fbe71658edc41e0bfbd01e0276c2489206bb2467ffc132d5c0eac1fd8b62","482833f5c50133f841ebceac068e283dcca31a04349239c0cec8eff79a604a3b","95bb93c2ac97e421d109ed70fc01e082e8a5bb1e26e9cd20af69971d9256dded","c1748ad0a4b4ea620d392189df1abb425f1b1261b501f0706645c76e8dfc885c","8e47dc03654d360b1b74aef5a01218ac49c59e507cbc965a8508f4abacca4793","f847c7b6bc7ad4f431d0f9481db9ed8efb44a6989ab724a4466cda6d41447b4d","d8f5d58b2bed7e8685cb2b5d98397951b33a0ae1e29c1cdfbe6814dcda5e7f3a","bc8df26c533444c66968682a6c41958cf1ae4ac0b5ccd4e20b823bb34aa37b28","09bae87cb6a859814c2a24439e812aa4c06328a5cf45b3742ab7258edcfd17b1","62bba56e08f7322c115b828eab15c0b4830946930750a80b98ebb5d4df82b7b8","651f631a1ff9a3f182b42893c01d1c950faace8a5134921f1ab87da4444ce072","d33d77707da61b9fcd0c5fa6dc65800e091238d436e9b7f0323b8e2719075e3b","244d12ba30a9730fc5ba014495130b8d0c8de3a3740a441aa93ca194e0452231","29808fbe33174392f11bbac254dd4c912d48b70cba95e8241fc897b90551384a","2db25e0ee63cf263b20efa7ce0cc21f10c4d6b3856f673bb86ed9737779b5665","561822af48352764f46ee795c2e1d907d87088e311d98c481d61fb4191cee256","158d029d0fb9baebe5985783f5b9ac4690e59d838f42bd16e4ceb4e46935bae9","1956126bf7d548adfa85203ac6a6bec286926429dacbd5c07da4405cc9841363","295df30fb753fe0bc411558d78df1fd643ffb0deb7a839cd026e7ac4a72ed8be","c9d561af0217a4547c869044d4043680e8fe277f8de510debff451b812f1d32c","142973a96d15011f84b4f442763f1f39f831d1de6e0084c7f57e17935ff8ae0a","4bb1f1ed8f9635deef36969e5ad01445366aeef3fc690886ccf70c14c221fa3d","36eb246e6382677d0d454a54ffe0a1bf88853fc0a001288f10cdb4cdf5742ba7"],"paragraph_range_zero_based":[21024,21047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21024"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Contiguous time duration of the CORESET in number of symbols (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":21048},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":21049},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception on this CORESET, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":21050},{"literal_text_all_w_t_and_m_t":"frequencyDomainResources","paragraph_zero_based":21051},{"literal_text_all_w_t_and_m_t":"Frequency domain resources for the CORESET. Each bit corresponds a group of 6 RBs, with grouping starting from the first RB group in the BWP or MBS CFR where the CORESET is configured. When at least one search space is configured with freqMonitorLocation-r16, only the first NRBG,set0size bits are valid (see TS 38.213 [13], clause 10.1). The first (left-most / most significant) bit corresponds to the first RB group in the BWP or MBS CFR where the CORESET is configured, and so on. A bit that is set to 1 indicates that this RB group belongs to the frequency domain resource of this CORESET. Bits corresponding to a group of RBs not fully contained in the bandwidth part within which the CORESET is configured are set to zero (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":21052},{"literal_text_all_w_t_and_m_t":"interleaverSize","paragraph_zero_based":21053},{"literal_text_all_w_t_and_m_t":"Interleaver-size (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":21054},{"literal_text_all_w_t_and_m_t":"pdcch-DMRS-ScramblingID","paragraph_zero_based":21055},{"literal_text_all_w_t_and_m_t":"PDCCH DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.3.1). When the field is absent the UE applies the value of the physCellId configured for this serving cell.","paragraph_zero_based":21056},{"literal_text_all_w_t_and_m_t":"precoderGranularity","paragraph_zero_based":21057},{"literal_text_all_w_t_and_m_t":"Precoder granularity in frequency domain (see TS 38.211 [16], clauses 7.3.2.2 and 7.4.1.3.2).","paragraph_zero_based":21058},{"literal_text_all_w_t_and_m_t":"rb-Offset","paragraph_zero_based":21059},{"literal_text_all_w_t_and_m_t":"Indicates the RB level offset in units of RB from the first RB of the first 6RB group to the first RB of BWP (see 38.213 [13], clause 10.1).","paragraph_zero_based":21060},{"literal_text_all_w_t_and_m_t":"reg-BundleSize","paragraph_zero_based":21061},{"literal_text_all_w_t_and_m_t":"Resource Element Groups (REGs) can be bundled to create REG bundles. This parameter defines the size of such bundles (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":21062},{"literal_text_all_w_t_and_m_t":"shiftIndex","paragraph_zero_based":21063},{"literal_text_all_w_t_and_m_t":"When the field is absent the UE applies the value of the physCellIdconfigured for this serving cell (see TS 38.211 [16], clause 7.3.2.2).","paragraph_zero_based":21064},{"literal_text_all_w_t_and_m_t":"tci-PresentInDCI","paragraph_zero_based":21065},{"literal_text_all_w_t_and_m_t":"This field indicates if TCI field is present or absent in DCI format 1_1 and DCI format 4_2. When the field is absent the UE considers the TCI to be absent/disabled. In case of cross carrier scheduling, the network sets this field to enabled for the ControlResourceSet used for cross carrier scheduling in DCI format 1_1 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":21066},{"literal_text_all_w_t_and_m_t":"tci-PresentDCI-1-2","paragraph_zero_based":21067},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Transmission configuration indicator\" in DCI format 1_2. When the field is absent the UE applies the value of 0 bit for the \"Transmission configuration indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.5). In case of cross carrier scheduling, the network configures this field for the ControlResourceSet used for cross carrier scheduling in DCI format 1_2 in the scheduling cell if enableDefaultBeamForCCS is not configured (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":21068},{"literal_text_all_w_t_and_m_t":"tci-StatesPDCCH-ToAddList","paragraph_zero_based":21069},{"literal_text_all_w_t_and_m_t":"A subset of the TCI states defined in pdsch-Config, either with tci-StatesToAddModList or dl-OrJointTCI-StateList, included in the BWP-DownlinkDedicated corresponding to the serving cell and to the DL BWP to which the ControlResourceSet belong to. They are used for providing QCL relationships between the DL RS(s) in one RS Set (TCI-State) and the PDCCH DMRS ports (see TS 38.213 [13], clause 6.). The network configures at most maxNrofTCI-StatesPDCCH entries. The QCL relationships defined herein do not apply to MBS broadcast.","paragraph_zero_based":21070},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8e6e68af1580278a9e4520d409845a5762e3a82448f2dd4d7ac171fc50f5303e","377fda74fdabbbc54791bdadd539e6b07d3d40f9d3e2544a69eb17f6c731d01a","9e4f7f2349dd36ef8352ba26e269dd3b8b8dafc0dafa8a8058961df59a730608","32d6fd742786a05b0e103149643438d6ec4c906a9d0094c5ad56de7d9a8b36d8","022da3c18a28d7c831ecda1bcc2be5f71bf000683d9061065692151edecd7c0c","9546701b45a3f2b84f27c6bba6e3924a704a48a2334fcd8aadf00c01b010ba66","46c6353ea321fb315787eb64f32a792cb78beecdf8b78e222081cf7e077ac5b3","d04c8db3b14dee602aa13eb9008fbe421f09fc9a5c46cbce36f4a24c9d40a15a","7f2aade0cd7b085dfe287a04c073152225f133bc358caeac94bbd18d83a65130","5ce9fb3ec5689eb735fe330442bb3698fbd5bf348b019d7f36d7bf0bb8609a4c","19be485e44993d21fef4d3a7273e288850221defb1a8742de4ffdbbf6b76e2e5","b18f1b6f030b8d8397a2bcb2672e03213e799104f90a46a747bf4cf4b94d5587","ffa799565de1d77ccfe58dd5b393f8ed6db0fd52fc00c22864828104e5596477","c6afb35881bf1faa724491ede8656e7af611562b8de1c00c44115744b60a4ed2","b24270e92a7ec6571d3322d2573ddba14af92899d567d0857c2bdd1c2e6b0132","05f49d869d217846941821925ce5eb02ed8d34f14067aef955f963cb63292246","345391f2b869870be318088a632f5fbe3f026ef78d2892f0340d7bb02607d63a","a786339ecdfa716665e383fc7dcdfee73ad8198855906760db0ebf3a65b25683","1b427c02c7836e58ccc09f869268bfd4662389b32a696bfe16a93ea45e1dac27","cface61e0c4bd6aaa42de45f688ea7d7fd2814191f1f938d86e7e886c87cdc29","ce8e7e378816d58769d587dcff0feb77046556f1cd51b61d718695c14271f67a","8a17659689019e687a92e279fa9099b1ee3c3a5570ef74550c9ed3a7c6f1ba51","b5e661ef149bbfe6786eb1b14fd14fbb7b3e39b74c22b75bb859e29681badd93","85e80212c0b5b51b2e9d912df87209125ed25dbb78635286a2182ab65883a179"],"paragraph_range_zero_based":[21048,21071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21048"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21072},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21073},{"literal_text_all_w_t_and_m_t":"FollowUTCI","paragraph_zero_based":21074},{"literal_text_all_w_t_and_m_t":"The field is absent if the field followUnifiedTCI-State is present or if more than one value for the field coresetPoolIndex is configured in controlResourceSet for the same bandwidthpart. Otherwise, it is optionally present, Need R.","paragraph_zero_based":21075},{"literal_text_all_w_t_and_m_t":"NotSIB-initialBWP","paragraph_zero_based":21076},{"literal_text_all_w_t_and_m_t":"The field is absent in SIB1/SIB20 and in the PDCCH-ConfigCommon of the initial BWP in ServingCellConfigCommon, if SIB1/SIB20 is broadcasted. Otherwise, it is optionally present, Need N.","paragraph_zero_based":21077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21078},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetId","paragraph_zero_based":21079},{"literal_text_all_w_t_and_m_t":"The ControlResourceSetId IE concerns a short identity, used to identify a control resource set within a serving cell. The ControlResourceSetId = 0 identifies the ControlResourceSet#0 configured via PBCH (MIB) and in controlResourceSetZero (ServingCellConfigCommon). The ID space is used across the BWPs and MBS CFRs of a Serving Cell.","paragraph_zero_based":21080},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId information element","paragraph_zero_based":21081},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21082},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-START","paragraph_zero_based":21083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21084},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId ::=                INTEGER (0..maxNrofControlResourceSets-1)","paragraph_zero_based":21085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21086},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-r16 ::=            INTEGER (0..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":21087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21088},{"literal_text_all_w_t_and_m_t":"ControlResourceSetId-v1610 ::=          INTEGER (maxNrofControlResourceSets..maxNrofControlResourceSets-1-r16)","paragraph_zero_based":21089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21090},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETID-STOP","paragraph_zero_based":21091},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21093},{"literal_text_all_w_t_and_m_t":"–ControlResourceSetZero","paragraph_zero_based":21094},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSetZero is used to configure CORESET#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":21095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be47e762baa4efbbafbe866ebb2260586c5ba7e74e3728cb6a1140b4b409e700","a95c3783df37a36109a8b326b8ca8db1fe246bc670ff8b901ba36f9dd8e0228e","cdf9b5ffe7a856903d7c24f71126b34ca8ea68f39c2c6780ed82c4e3e1cf07c1","34fa90a72f58e72d6021191bb08d120e0f2ae54e359b493337801128ff29ca37","9e5800e646178f0c2147d97638948f1b9c9be92256aedf5fadda16ce71a764c2","e5261474105d99a157e0328c398f19ae0b918ccec95be6f3b5bf52a938ac2b82","f17d0091315909a81ab35242a71333ba99c8fe4c35e129d4667129fdb907590b","31bcfc31f1868ba0b6d43bbfcb57d28c72bedd456ba1d541705d4232964a1a9b","57f4c7