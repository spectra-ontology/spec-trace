{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18505},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig field descriptions","paragraph_zero_based":18506},{"literal_text_all_w_t_and_m_t":"candidateBeamRS-List","paragraph_zero_based":18507},{"literal_text_all_w_t_and_m_t":"A list of reference signals (CSI-RS and/or SSB) identifying the candidate beams for recovery. The network always configures this parameter in every instance of this IE.","paragraph_zero_based":18508},{"literal_text_all_w_t_and_m_t":"candidateBeamRS-List2","paragraph_zero_based":18509},{"literal_text_all_w_t_and_m_t":"A list of reference signals (CSI-RS and/or SSB) identifying the candidate beams for recovery.","paragraph_zero_based":18510},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdBFR","paragraph_zero_based":18511},{"literal_text_all_w_t_and_m_t":"L1-RSRP threshold used for determining whether a candidate beam may be included by the UE in MAC CE for BFR (see TS 38.321 [3] and TS 38.213 [13], clause 6). The network always configures this parameter in every instance of this IE.","paragraph_zero_based":18512},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18513},{"literal_text_all_w_t_and_m_t":"–BetaOffsets","paragraph_zero_based":18514},{"literal_text_all_w_t_and_m_t":"The IE BetaOffsets is used to configure beta-offset values, see TS 38.213 [13], clause 9.3.","paragraph_zero_based":18515},{"literal_text_all_w_t_and_m_t":"BetaOffsets information element","paragraph_zero_based":18516},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18517},{"literal_text_all_w_t_and_m_t":"-- TAG-BETAOFFSETS-START","paragraph_zero_based":18518},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18519},{"literal_text_all_w_t_and_m_t":"BetaOffsets ::=                     SEQUENCE {","paragraph_zero_based":18520},{"literal_text_all_w_t_and_m_t":"    betaOffsetACK-Index1                INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18521},{"literal_text_all_w_t_and_m_t":"    betaOffsetACK-Index2                INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18522},{"literal_text_all_w_t_and_m_t":"    betaOffsetACK-Index3                INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18523},{"literal_text_all_w_t_and_m_t":"    betaOffsetCSI-Part1-Index1          INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18524},{"literal_text_all_w_t_and_m_t":"    betaOffsetCSI-Part1-Index2          INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18525},{"literal_text_all_w_t_and_m_t":"    betaOffsetCSI-Part2-Index1          INTEGER(0..31)                                                          OPTIONAL, -- Need S","paragraph_zero_based":18526},{"literal_text_all_w_t_and_m_t":"    betaOffsetCSI-Part2-Index2          INTEGER(0..31)                                                          OPTIONAL  -- Need S","paragraph_zero_based":18527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["90f61d0c34257c1c109eb60e2584fa5a1bccf6d962ba20bdd47eeb91f4dd91ba","55b1aca6a4b4659324039e898cb35f500197435bddff4713efaa42e306e43e9e","62ba8076da41eec60dde8ab43373a2127fba