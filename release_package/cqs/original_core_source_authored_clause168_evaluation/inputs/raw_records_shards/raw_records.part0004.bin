{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–FeatureSetCombinationId","paragraph_zero_based":38136},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetCombinationId identifies a FeatureSetCombination. The FeatureSetCombinationId of a FeatureSetCombination is the position of the FeatureSetCombination in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability). The FeatureSetCombinationId = 0 refers to the first entry in the featureSetCombinations list (in UE-NR-Capability or UE-MRDC-Capability).","paragraph_zero_based":38137},{"literal_text_all_w_t_and_m_t":"NOTE:The FeatureSetCombinationId = 1024 is not used due to the maximum entry number of featureSetCombinations.","paragraph_zero_based":38138},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId information element","paragraph_zero_based":38139},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38140},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-START","paragraph_zero_based":38141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38142},{"literal_text_all_w_t_and_m_t":"FeatureSetCombinationId ::=         INTEGER (0.. maxFeatureSetCombinations)","paragraph_zero_based":38143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38144},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETCOMBINATIONID-STOP","paragraph_zero_based":38145},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38147},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlink","paragraph_zero_based":38148},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlink indicates a set of features that the UE supports on the carriers corresponding to one band entry in a band combination.","paragraph_zero_based":38149},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink information element","paragraph_zero_based":38150},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38151},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINK-START","paragraph_zero_based":38152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38153},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink ::=                  SEQUENCE {","paragraph_zero_based":38154},{"literal_text_all_w_t_and_m_t":"    featureSetListPerDownlinkCC             SEQUENCE (SIZE (1..maxNrofServingCells)) OF FeatureSetDownlinkPerCC-Id,","paragraph_zero_based":38155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38156},{"literal_text_all_w_t_and_m_t":"    intraBandFreqSeparationDL               FreqSeparationClass                                                     OPTIONAL,","paragraph_zero_based":38157},{"literal_text_all_w_t_and_m_t":"    scalingFactor                           ENUMERATED {f0p4, f0p75, f0p8}                                          OPTIONAL,","paragraph_zero_based":38158},{"literal_text_all_w_t_and_m_t":"    dummy8                                  ENUMERATED {supported}                                                  OPTIONAL,","paragraph_zero_based":38159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fcedc181829c634bb767f87095afd5b25885998bd1a3bc8f2e56b9d23de926ae","1575bfdb22a4011f8c0b85baa5749700b3bcfd0466cb0aa96e88586cbfe2380f","e1b4f872ec1003c212f56314702a48bae01990cd0476f8d241a22b1c4c1be134","1d4e0958262cc8cda19976a07c1a156fcdeda27e3f2f298c5bf93736f04b8801","b6f4e6031e7135e2e6d90b3b12301f7c3afd3ce20e1f5e65a7c6fcf9f8034abf","50cee0ab15f7665e2603b879f784d17dd75495dba8c536a172435c4d595e5587","b7150976448106a6d1