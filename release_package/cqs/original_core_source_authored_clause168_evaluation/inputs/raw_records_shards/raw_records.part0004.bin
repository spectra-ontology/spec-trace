{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44593},{"literal_text_all_w_t_and_m_t":"SL-BWP-PRSPoolConfig field descriptions","paragraph_zero_based":44594},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxPoolSelectedNormal","paragraph_zero_based":44595},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform SL-PRS transmission by UE autonomous resource selection on the configured BWP.","paragraph_zero_based":44596},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxPoolScheduling","paragraph_zero_based":44597},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform SL-PRS transmission based on network selection on the configured BWP.","paragraph_zero_based":44598},{"literal_text_all_w_t_and_m_t":"sl-PRS-TxPoolExceptional","paragraph_zero_based":44599},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform SL-PRS transmission in exceptional conditions on the configured BWP.","paragraph_zero_based":44600},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44601},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44602},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44603},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":44604},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":44605},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44606},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PRS-PoolConfigCommon","paragraph_zero_based":44607},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PRSPoolConfigCommon is used to configure the cell-specific NR sidelink PRS dedicated resource pool.","paragraph_zero_based":44608},{"literal_text_all_w_t_and_m_t":"SL-BWP-PRS-PoolConfigCommon information element","paragraph_zero_based":44609},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44610},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-PRS-POOLCONFIGCOMMON-START","paragraph_zero_based":44611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44612},{"literal_text_all_w_t_and_m_t":"SL-BWP-PRS-PoolConfigCommon-r18 ::= SEQUENCE {","paragraph_zero_based":44613},{"literal_text_all_w_t_and_m_t":"    sl-PRS-RxPool-r18                 SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-PRS-ResourcePool-r18              OPTIONAL, -- Need R","paragraph_zero_based":44614},{"literal_text_all_w_t_and_m_t":"    sl-PRS-TxPoolSelectedNormal-r18   SEQUENCE (SIZE (1..maxNrofSL-PRS-TxPool-r18)) OF SL-PRS-ResourcePoolConfig-r18 OPTIONAL, -- Need R","paragraph_zero_based":44615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f1f4f683fbf0f205ac58fa2f909d67277acac2268ba805f57886df095506264e","74424b48354fc55e2e4883fbcd233c400fea347bb391026c4e955b831f46ea1e","87eaf3d013198eb023d1e2b41281abdd222560c9481465a185b01c8ef895d211","0395b360bca8cc407b5873271252bdbfb7bec9b5389b09834820fda6de801ef7","66ac496d86dda43ebf4ded020a98db9197c77448e670ef46abc9a30d36719d48","47be97d3653f7fbff2e27d5e557855767daa278ec8bd66b7443965aa37ca05e1","4d9893d320f40609aeb3e14a6848a59990b09a010ff217e45456158f258e4256","43c60e9bb4243e39721c837dbe8599aab70a226f58a4cbc628df22a8201cd891","dc5957437cf0909f7c7ae922139ea23b9925c327c12a28b6114e3d6bf43df5f2","41c8a07bd6b1a1001ec497ba63d299f6696b983fbf906343b9a1b9e987ef4a54","e1eaee3eb189fda91b3