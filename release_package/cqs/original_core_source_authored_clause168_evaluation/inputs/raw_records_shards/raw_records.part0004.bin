{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList                              NR-NS-PmaxList              OPTIONAL    -- Need S","paragraph_zero_based":25992},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25994},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB-v1760 ::=      SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo-v1760","paragraph_zero_based":25995},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25996},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo-v1760 ::=                  SEQUENCE {","paragraph_zero_based":25997},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList-v1760                        NR-NS-PmaxList-v1760        OPTIONAL    -- Need S","paragraph_zero_based":25998},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25999},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26000},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-Aerial-SIB-r18 ::= SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfoAerial-r18","paragraph_zero_based":26001},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26002},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfoAerial-r18 ::=              SEQUENCE {","paragraph_zero_based":26003},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR-Aerial-r18              FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":26004},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxListAerial-r18                    NR-NS-PmaxListAerial-r18    OPTIONAL    -- Need S","paragraph_zero_based":26005},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26007},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-STOP","paragraph_zero_based":26008},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26010},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo field descriptions","paragraph_zero_based":26011},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":26012},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":26013},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR-Aerial","paragraph_zero_based":26014},{"literal_text_all_w_t_and_m_t":"Provides an NR frequency band number for aerial UE(s), as defined in TS 38.101-1 [15], TS 38.101-2 [39], table 5.2-1, and TS 38.101-5 [75], table 5.2.2-1.","paragraph_zero_based":26015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["43b528276135ea3c556b3a3d0981a4e99d6c0bf7d7420881d5d1db7be87ac311","f5f04bdfed2fdf6041cea481fa2a0750a78f881544bc26c1678daedadaa17627","6f17b6da466c90d2c8d4d63f5e7e17934baf6ee1c1a81c9df0d4c32b76560953","6b3de18aeccc00cfd9565cd03bc0e1a27a89c04bbba93a843acc857fe3df6d50","32915c4b9c396e7708cc8d9b822ff6e9a1cfb90c064e0754922768c45b1ce66c","9a10ff054bbc49984961390e58c77b051911a80c56488c69b26645867ec58a12","6deebfdcb3b7d65ba0260401e5c4e58a51c971811dd51c3a22e34c2e20bb6953","87400686c81dd560d6f5ce1ee933c3e0941922b14b843a4979b0ce89da013dfb","1baf31ecb56caae909bb43f047c36e584354bc24deed6a4782b6337c60eb2d22","b505b2f2153c0a3b944d3ec9f494c79633d080ec592604ff63f6af8551cbc384","44c69bd43a6a72e251d3ee5f600f0cadb3761d04da06dfcfd545a33c3a46c257","3957845fd8232bae2dece8d4d8bc671f58c9d32604f35d4a085e731ca6c5ff28","a74d7b462787855e3a1a18772eb0dc156ea52d9121c95cb08cd47506dad4a8e7","e475412f96f1b10e50314a152aa698e97be912b1f2256577af0b0fdd2d102dba","e83e50c28afb2971f592d80d4bbed5e1c44b9a81a6ae15336ecc24d185a6d31a","085c2da64d63a7dcb34206f40428afe0e8a62bbe68ed41d9d1d804efea1eac0d","5857590bb729f72efc1ee9a63564a0dd661069f3f629b27cf70cc9a9a897e981","6c5d72016a2676bc31732f36bda5e52a87128f0c52da777c5a43c83b56082edb","82e820926f0a5cbd6eb7659717e2951b286d029a9e97980f30a533085ea7f7af","de326f058e2ba6acc5c4e73069e9eb2177e03f3766f52fb14ab9c4c9db52c287","21a87d12128eec0abf2c55332bfeca29f73926062d3506996878c941c22c51b0","52a33c2e227877c4f147a0170652be428e9f1876b781b64425486aac0ba982f8","1c0172f9f9b833a6dcbadce67c225f3d2bdb8c1aa4f476bf331e3f4dddfa72a5","76096cdd7784b9321553abb99f1ff95ad486645874e0d182d74ef8de3610bbd7"],"paragraph_range_zero_based":[25992,26015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25992"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxList","paragraph_zero_based":26016},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values. If the field is absent the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63]. If nr-NS-PmaxList-v1760 is present, it shall contain the same number of entries, listed in the same order as in nr-NS-PmaxList (without suffix).","paragraph_zero_based":26017},{"literal_text_all_w_t_and_m_t":"nr-NS-PmaxListAerial","paragraph_zero_based":26018},{"literal_text_all_w_t_and_m_t":"Provides a list of additionalPmax and additionalSpectrumEmission values for aerial UE(s). If the field is absent, the value indicated by the corresponding field within frequencyBandList for the corresponding NR frequency band number applies, if present. Otherwise (i.e. the field is not present for the corresponding NR frequency band number in any of the nr-NS-PmaxList, nr-NS-PmaxList-v1760 or nr-NS-PmaxListAerial), the UE uses value 0 for the additionalSpectrumEmission (see TS 38.101-1 [15] table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A). This field is ignored by IAB-MT, the IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":26019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26020},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26021},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26022},{"literal_text_all_w_t_and_m_t":"OptULNotSIB2","paragraph_zero_based":26023},{"literal_text_all_w_t_and_m_t":"The field is absent for SIB2 and is mandatory present in SIB4 and frequencyInfoDL-SIB. Otherwise, if the field is absent in frequencyInfoUL-SIB in UplinkConfigCommonSIB, the UE will use the frequency band indicated in frequencyInfoDL-SIB in DownlinkConfigCommonSIB.","paragraph_zero_based":26024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26025},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapConfig","paragraph_zero_based":26026},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapConfig specifies the MUSIM gap configuration and controls setup/release of MUSIM gaps.","paragraph_zero_based":26027},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig information element","paragraph_zero_based":26028},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26029},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-START","paragraph_zero_based":26030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26031},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig-r17 ::=                  SEQUENCE {","paragraph_zero_based":26032},{"literal_text_all_w_t_and_m_t":"    musim-GapToReleaseList-r17               SEQUENCE (SIZE (1..3)) OF MUSIM-GapId-r17               OPTIONAL, -- Need N","paragraph_zero_based":26033},{"literal_text_all_w_t_and_m_t":"    musim-GapToAddModList-r17                SEQUENCE (SIZE (1..3)) OF MUSIM-Gap-r17                 OPTIONAL, -- Need N","paragraph_zero_based":26034},{"literal_text_all_w_t_and_m_t":"    musim-AperiodicGap-r17                   MUSIM-GapInfo-r17                                       OPTIONAL, -- Need N","paragraph_zero_based":26035},{"literal_text_all_w_t_and_m_t":"   ...,","paragraph_zero_based":26036},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26037},{"literal_text_all_w_t_and_m_t":"    musim-GapPriorityToAddModListExt-v1800   SEQUENCE (SIZE (1..3)) OF GapPriority-r17               OPTIONAL, -- Need N","paragraph_zero_based":26038},{"literal_text_all_w_t_and_m_t":"    musim-GapKeep-r18                        ENUMERATED {true}                                       OPTIONAL  -- Need R","paragraph_zero_based":26039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9a186f2c8f4e1cebd4056c0324e293d4adf5aada91789036c2fe48366934f8cb","8ea0282634a2a81df65bade3c6ca68500111c5dc05defcf9bd02bbb653dc6403","9639fdd9c0e2e5b4f56e7dab15f0ace88a0f5730859f70fce7d19446477dccd8","195c161c375e97373ebf045844786bc02855bb7c35180a6133366b88ba489079","a0ffeb5bab80c6b568a444f4db8f92cc739ccd57240b56fd5366afa9ce4d7b17","54c0080d296682ad193de1be2ba59049f15c8fcb5a23420fa38129b6008fc8f6","2c2c32197072938d3634a6018e19b78b35fec4d02f134cc468da8da08b6476a8","b252427b492472478b0a1d29e4dbf38581592404c772a10352a0e4e4d1ff4d57","f5963c3f37284791041c149fde5647e3cc6df01b9283a3079654505c984ab703","36592adba523c7cfe6f5f64025d246d73d8f29a478e75b8bcfebd51030dfd6f3","c524e4220541b6d241d016696283c40363b0931d9a7e649f2423deb778742868","f0ceabbd1dfab8f1a395d0685bfd718c28a30ba1487cedf65f45fe8e831d448c","a83f029776988ad8426e1ce005dbc80ae9dc609f331c34ef7d2f5e412350e2b9","3a921c0ea49c3d6d13dcaf832b8eba1fb6cdf69f8373a61532067ecb6c5c4591","da3900a94ea6c48301ea9e5bfca089b3bf9367eebc9dcdd57f7c74dfbcb07367","f5cdc56b92178c6e8159b227a76404f0bfe8628d8d04e95409044abf8d2c044f","c153c6e574bf0fa7984c3403f5a4c53fc54557e6b2feb1cc26dac10ad44be3fa","71169cd7629657d25be96ca8c22e8b43f91994c29494c5b0c26e6a4a19a8245f","b2df5b2ee479d43b4098abdc01a405b457bdde898251803a1e106d4592912522","50f087d137b44307bddfd9bb9193575a7151c88e77b75dcbb0090cb83dd689c5","0d622ac5a400cd7164ad8949cf6ec820a636c22a8813b14f4e36b1de9dd2e2d0","1ec671a8153a3c616423a7793b564c4dc2950f6d908dda98755b213a6f5815bc","91671fb1787e200fd7bdab2b32c240e848d94e95e90db74de931c087bc3a3b92","3e42807a258e5b25ebcd36d1c4942c505031871258cc483a4d901980de24ec70"],"paragraph_range_zero_based":[26016,26039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p26016"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26040},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26042},{"literal_text_all_w_t_and_m_t":"MUSIM-Gap-r17 ::=                        SEQUENCE {","paragraph_zero_based":26043},{"literal_text_all_w_t_and_m_t":"    musim-GapId-r17                          MUSIM-GapId-r17,","paragraph_zero_based":26044},{"literal_text_all_w_t_and_m_t":"    musim-GapInfo-r17                        MUSIM-GapInfo-r17","paragraph_zero_based":26045},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26046},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26047},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPCONFIG-STOP","paragraph_zero_based":26048},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26050},{"literal_text_all_w_t_and_m_t":"MUSIM-GapConfig field descriptions","paragraph_zero_based":26051},{"literal_text_all_w_t_and_m_t":"musim-AperiodicGap","paragraph_zero_based":26052},{"literal_text_all_w_t_and_m_t":"Indicates the MUSIM aperiodic gap as specified in TS 38.133 [14] clause 9.1.10. If UE indicates the musim-Starting-SFN-AndSubframe when requesting aperiodic gap the network can only configure the aperiodic gap with the same start point or no aperiodic gap. If the field musim-Starting-SFN-AndSubframe is absent for aperiodic gap, network can configure any timing as the starting point for aperiodic gap or configure no aperiodic gap.","paragraph_zero_based":26053},{"literal_text_all_w_t_and_m_t":"musim-GapInfo","paragraph_zero_based":26054},{"literal_text_all_w_t_and_m_t":"Indicates the values for musim-GapLength and musim-GapRepetitionAndOffset. When network provides periodic gap, network always signals the musim-GapLength and musim-GapRepetitionAndOffset as indicated by the UE's preferred MUSIM gap configuration.","paragraph_zero_based":26055},{"literal_text_all_w_t_and_m_t":"musim-GapKeep","paragraph_zero_based":26056},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to use \"keep solution\" for collided MUSIM periodic/aperiodic gaps. If \"keep solution\" is not granted, collisions between MUSIM periodic gaps are resolved based on the assigned MUSIM gap priorities as specified in TS 38.133[14].","paragraph_zero_based":26057},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityToAddModListExt","paragraph_zero_based":26058},{"literal_text_all_w_t_and_m_t":"Indicates the priority of MUSIM periodic gap(s).","paragraph_zero_based":26059},{"literal_text_all_w_t_and_m_t":"If the network includes musim-GapPriorityToAddModList-r18, it includes the same number of entries, and listed in the same order, as in musim-GapToAddModList-r17.","paragraph_zero_based":26060},{"literal_text_all_w_t_and_m_t":"For the priority of MUSIM aperiodic gap, the MUSIM aperiodic gap is always kept (not dropped) from UE perspective in case of collisions with other gaps (i.e. all gaps including MUSIM gaps, etc).","paragraph_zero_based":26061},{"literal_text_all_w_t_and_m_t":"musim-GapToAddModList","paragraph_zero_based":26062},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to add or modify.","paragraph_zero_based":26063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6946cad17c5b045b8fbd8db842aa522a196184285ece8b13c32d11c26acad972","1f5a9dec36f8a7561e14e2405c73fd29779d537c98b7374b36062685dd4a7fdd","8ad44e071e8d07cda811f96574cf7da9