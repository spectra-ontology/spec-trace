 (SIZE (20)),","paragraph_zero_based":31190},{"literal_text_all_w_t_and_m_t":"                n40                                 BIT STRING (SIZE (40))","paragraph_zero_based":31191},{"literal_text_all_w_t_and_m_t":"            }                                                                                           OPTIONAL,   -- Need S","paragraph_zero_based":31192},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":31193},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":31194},{"literal_text_all_w_t_and_m_t":"        controlResourceSet                  ControlResourceSetId","paragraph_zero_based":31195},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":31196},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing                                               OPTIONAL,   -- Cond CellLevel","paragraph_zero_based":31197},{"literal_text_all_w_t_and_m_t":"    dummy                               ENUMERATED { dynamic, semiStatic },","paragraph_zero_based":31198},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":31199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b4d54aca7e3b0bd56ddf8a6a63d9d9bc0c0c40f05a25299c88c8e349343b0b07","d0988c14ce9ad5b2f3bce273f1a62036f5e8cfa89c1bda6cec1774cdc754ced1","c5ecdeb81a04c726f9417ca46b7472c1193ec194bd581d67f3f86904e097ab37","b60f9fd44199c57c8f74fedaae8471e17a902b75aab107054b57a9f693f1e432","1c7b04b2c7ad311f1a72fd44732ef42cc57752960cc727a7a3284febd0cb5981","2d853505b63f6a378e3e2def22c3763a8d667aca7f1c10ff3d1fb0e3e09a4895","1d3fce373d7a98b9437c147c6bda4a2380e1fd0f42b00b3c95497f33f76457c8","1a1fa29d716b2f196d2144f21a24219f859a4