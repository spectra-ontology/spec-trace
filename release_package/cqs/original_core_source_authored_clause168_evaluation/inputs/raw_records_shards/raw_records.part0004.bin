{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE Hysteresis is a parameter used within the entry and leave condition of an event triggered reporting condition. The actual value is field value * 0.5 dB.","paragraph_zero_based":23424},{"literal_text_all_w_t_and_m_t":"Hysteresis information element","paragraph_zero_based":23425},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23426},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-START","paragraph_zero_based":23427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23428},{"literal_text_all_w_t_and_m_t":"Hysteresis ::=                      INTEGER (0..30)","paragraph_zero_based":23429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23430},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESIS-STOP","paragraph_zero_based":23431},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23433},{"literal_text_all_w_t_and_m_t":"–HysteresisAltitude","paragraph_zero_based":23434},{"literal_text_all_w_t_and_m_t":"The IE HysteresisAltitude is a parameter used within the entry and leave condition of an altitude-based event triggered reporting condition and within altitude range based parameter configuration. The actual value is field value in meters.","paragraph_zero_based":23435},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude information element","paragraph_zero_based":23436},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23437},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-START","paragraph_zero_based":23438},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23439},{"literal_text_all_w_t_and_m_t":"HysteresisAltitude-r18 ::=                      INTEGER (0..64)","paragraph_zero_based":23440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23441},{"literal_text_all_w_t_and_m_t":"-- TAG-HYSTERESISALTITUDE-STOP","paragraph_zero_based":23442},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23444},{"literal_text_all_w_t_and_m_t":"–HysteresisLocation","paragraph_zero_based":23445},{"literal_text_all_w_t_and_m_t":"The IE HysteresisLocation is a parameter used within entry and leave condition of a location based event triggered reporting condition. The actual value is field value * 10 meters.","paragraph_zero_based":23446},{"literal_text_all_w_t_and_m_t":"HysteresisLocation information element","paragraph_zero_based":23447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["78e827221828990c8615932b2d5bb84bc10c0a07f1c0e9070bd3401c2b7e6677","eadfe2a1b860f82a2a46ba551eb6c494d05da1dd95a1adcf235602bbabfdc1a9","bbf9327a2c682dcc0be3af5788954acc78e5ca0c6bc344a3fbb6b1d094ac08d5","daa83cf75911c92bddfd3afc9612005d5cf8d51cdaaee68f0b783bbfd5814aed","2e2f3841938262e76d1918920071e6a884fda766e8314136b55d09babc181681","cfe0c939ae0c60efd3808d6a5aba4a0f8741eae09e9b068940dad5e5bb1a2a5b","5f7bcf16c92597d26b3eb854dc2b49de539322903b5daa79ea7b4fcc657917bc","ab9afdf7e9c4b44c8d93ac10d1efcd50f16bc617408c84bd6f26ce2ef6dfd513","406cd6500743375f6bfec00af92aa8698e3b0b3cf94d44a4ff6d9044ba33423e","6a1336f983e217012a628c44f62ed6f9ccbf2a077982ac6a87d813d0044e0ecc","ca3ae222f968ce9e88058c03e6117c9317e49065ad0647bf4c453748c326d20b","8a3ab9c20df470b69638a3adc2d8782fa83df7be9ebfdb4f380a5021f45e1c4d","80913f66b95358289b93a014a97aa0e7d7c5810a16c43641ec03089f6f6e8e66","c37b36c2cd11a4481e2c895a9b15ea63c088386cddd7968a39e0