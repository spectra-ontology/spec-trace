{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    refFR2-ServCellAsyncCA-r17    ServCellIndex                                                      OPTIONAL -- Cond AsyncCA","paragraph_zero_based":35832},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35834},{"literal_text_all_w_t_and_m_t":"-- TAG-UL-GAPFR2-CONFIG-STOP","paragraph_zero_based":35835},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35837},{"literal_text_all_w_t_and_m_t":"UL-GapFR2-Config field descriptions","paragraph_zero_based":35838},{"literal_text_all_w_t_and_m_t":"gapOffset","paragraph_zero_based":35839},{"literal_text_all_w_t_and_m_t":"Value gapOffset is the gap offset of the FR2 UL gap pattern with UGRP indicated in the field ugrp. The value range is from 0 to ugrp-1.","paragraph_zero_based":35840},{"literal_text_all_w_t_and_m_t":"refFR2-ServCellAsyncCA","paragraph_zero_based":35841},{"literal_text_all_w_t_and_m_t":"Indicates the FR2 serving cell identifier whose SFN and subframe is used for FR2 UL gap calculation for this gap pattern with asynchronous CA involving FR2 carrier(s).","paragraph_zero_based":35842},{"literal_text_all_w_t_and_m_t":"ugl","paragraph_zero_based":35843},{"literal_text_all_w_t_and_m_t":"Value ugl is the gap length in ms of the FR2 UL gap. The FR2 UL gap length is according to Table 9.1.11-1 in TS 38.133 [14]. Value ms0dot125 corresponds to 0.125 ms, ms0dot25 corresponds to 0.25 ms and so on. ","paragraph_zero_based":35844},{"literal_text_all_w_t_and_m_t":"ugrp","paragraph_zero_based":35845},{"literal_text_all_w_t_and_m_t":"Value ugrp is the gap repetition period in (ms) of the FR2 UL gap. The FR2 UL gap repetition period is according to Table 9.1.11-1 in TS 38.133 [14].","paragraph_zero_based":35846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35847},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35848},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35849},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":35850},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when configuring FR2 UL gap pattern to UE in:","paragraph_zero_based":35851},{"literal_text_all_w_t_and_m_t":"- (NG)EN-DC, NR SA, NE-DC or NR-DC without FR2-FR2 band combination, with asynchronous CA involving FR2 carriers.","paragraph_zero_based":35852},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent.","paragraph_zero_based":35853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35854},{"literal_text_all_w_t_and_m_t":"–UplinkCancellation","paragraph_zero_based":35855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["eb2fbf87caa1a1441798c682e471aff7d24824a172d28fd6513095b930bfc651","95f8524c6ace48fab20bc4b43c7b820bd41a8e8349ea7ae19837f07cdc7e1b47","b6f9a1f0cc9dd10ac2a767dfb018abf248a312c2b4d10961cbf848fddc802fdf","f29498a49cacb18d3efa386dc47fdccad7c09314cb66910d6515f3e6db11c7f0","9365f01b74fe5b1d0676dcb12fa05adb19f4bb976d27a1baf6991e399de172cc","0abec42bb1f54b15dd492dae2ea9507807f0ae6ecd2fdb5701673ffe774a6ce3","2665d845a2eebc4a75961938dff85080c4eff2ecae1fd515625b2f2583dc817f","a47b002c2b4925dc0a87d955d9453ee38a310cc94249309d3ad68c931db7e895","c6694d70b6921e7c8c57133f5140d9ca30d961dd86b977068b73e6e0cf22bbb9","ed6c9857574d7e85159e9ef463b41ba594eaf4c839e4ba610de617100c523ec7","dba6fec0746b82bddf85700af1920f75649432e522b5ea9fbcdaad7a5c5c0622","82e19386d789a836d5832b98f0a4b