{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSL-RelayDiscovery","paragraph_zero_based":43272},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR sidelink relay discovery. The encoding is defined in PC5 BandCombinationListSidelinkNR-r16.","paragraph_zero_based":43273},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSL-U2U-DiscoveryExt","paragraph_zero_based":43274},{"literal_text_all_w_t_and_m_t":"This field indicates the band parameter in BandCombinationListSL-Discovery-r17 that the UE supports for NR U2U sidelink relay discovery in a band included in supportedBandCombinationListSL-U2U-RelayDiscovery.","paragraph_zero_based":43275},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListSL-U2U-RelayDiscovery","paragraph_zero_based":43276},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for NR U2U sidelink relay discovery. The encoding is defined in PC5 BandCombinationListSidelinkNR-r16.","paragraph_zero_based":43277},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":43278},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic uplink Tx switching for NR UL CA and SUL. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-NR-Capability IE. The UE does not include this field if the UE capability is requested by E-UTRAN and the network request includes the field eutra-nr-only [10].","paragraph_zero_based":43279},{"literal_text_all_w_t_and_m_t":"supportedBandListNR","paragraph_zero_based":43280},{"literal_text_all_w_t_and_m_t":"A list of NR bands supported by the UE. If supportedBandListNR-v16c0 is included, the UE shall include the same number of entries, and listed in the same order, as in supportedBandListNR (without suffix).","paragraph_zero_based":43281},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43282},{"literal_text_all_w_t_and_m_t":"–RF-ParametersMRDC","paragraph_zero_based":43283},{"literal_text_all_w_t_and_m_t":"The IE RF-ParametersMRDC is used to convey RF related capabilities for MR-DC.","paragraph_zero_based":43284},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC information element","paragraph_zero_based":43285},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43286},{"literal_text_all_w_t_and_m_t":"-- TAG-RF-PARAMETERSMRDC-START","paragraph_zero_based":43287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43288},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC ::=                   SEQUENCE {","paragraph_zero_based":43289},{"literal_text_all_w_t_and_m_t":"    supportedBandCombinationList            BandCombinationList                             OPTIONAL,","paragraph_zero_based":43290},{"literal_text_all_w_t_and_m_t":"    appliedFreqBandListFilter               FreqBandList                                    OPTIONAL,","paragraph_zero_based":43291},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":43292},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":43293},{"literal_text_all_w_t_and_m_t":"    srs-SwitchingTimeRequested              ENUMERATED {true}                               OPTIONAL,","paragraph_zero_based":43294},{"literal_text_all_w_t_and_m_t":"    supportedBandCombinationList-v1540      BandCombinationList-v1540                       OPTIONAL","paragraph_zero_based":43295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragrap