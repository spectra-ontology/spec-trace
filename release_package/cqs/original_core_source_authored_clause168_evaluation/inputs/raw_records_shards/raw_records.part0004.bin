{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchDelay","paragraph_zero_based":27048},{"literal_text_all_w_t_and_m_t":"Indicates the value to be applied by a UE for Search Space Set Group switching; corresponds to the P value in TS 38.213 [13], clause 10.4. The network configures the same value for all BWPs of serving cells in the same CellGroupForSwitch. For 120/480/960 kHz SCS, only values 40,41, ... 52 are valid and the actual value = field value  * SCS/120 kHz i.e. field value 40 corresponds to 40 with 120 kHz SCS, 160 with 480 kHz SCS and 320 with 960 kHz SCS, and so on.","paragraph_zero_based":27049},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":27050},{"literal_text_all_w_t_and_m_t":"Timer (in unit of slots) to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. For the 15kHz SCS, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":27051},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27052},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigCommon","paragraph_zero_based":27053},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigCommon is used to configure cell specific PDCCH parameters provided in SIB as well as in dedicated signalling.","paragraph_zero_based":27054},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon information element","paragraph_zero_based":27055},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27056},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-START","paragraph_zero_based":27057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27058},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":27059},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero                                  OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":27060},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSet            ControlResourceSet                                      OPTIONAL,   -- Need R","paragraph_zero_based":27061},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero                                         OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":27062},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceList               SEQUENCE (SIZE(1..4)) OF SearchSpace                    OPTIONAL,   -- Need R","paragraph_zero_based":27063},{"literal_text_all_w_t_and_m_t":"    searchSpaceSIB1                     SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27064},{"literal_text_all_w_t_and_m_t":"    searchSpaceOtherSystemInformation   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27065},{"literal_text_all_w_t_and_m_t":"    pagingSearchSpace                   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27066},{"literal_text_all_w_t_and_m_t":"    ra-SearchSpace                      SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27067},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27068},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27069},{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO   CHOICE {","paragraph_zero_based":27070},{"literal_text_all_w_t_and_m_t":"        sCS15KHZoneT                                                             SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..139),","paragraph_zero_based":27071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["706b006ba2662e9d08c497f6220cba350d517c13b7793e5f9774a51116c332dc","3bdf29975fb10031bead585594caf38a6fd66dfbcad997ee06bc037004d2c35f","e3c6117019a08684459271e9aec7ba22ef157f2c5e6484bb80ceb45c32ecacef","307cb3b4c819b9dec174511fdd3c7085dbbc27bd8718ed26ef7120ba3ff426da","335d202c2c7d4267942cc4277c203091e8df51e54da4945a2ee04814a50a62a7","f17715bd6c92695d6f77e4b88fffcfa405b124562f4aeebee754e88d61e438f9","d6c259931e14a93efca09703ed1ea91a6fa6812bebbbea6b7def6e4d7f9d1bf9","7cf1042477c95b144494042f56842799767c4f007fbd8e68423d2b985efbf880","31a316fe92f54316ae18c1124a11a6f5f88d5fbabc4f266339a97c2491c14ab5","01cc4e9a0a8f14da61de73d6a53604b22ee3e0eb8b91adf4a02eede743c9f806","237c596904266a2d68438352f3ce39740318dce70eadb8bbf194a7e979de48f4","673895ce033ca1c1e855aefbd1080949eade40c1dd0136a2adb6892e1d013c18","6420e9a2026339ec42f3bf4df991b09aad1f209361bdf65f9ab359b5062d817c","1e5664e77c30de92760498190f1e33958f467464e923018eed556db8791dc172","9d81c604d693c94780b54b5ab2be7a281708248f71d8bdbbb41a3c4099a54a17","1766d2ddc826f3304cca8c52ab8cd446034b839e418e6e90f71960f127f8d811","9d97cea6575c2d5adb8f10d7f80504ab274fd4f453ba002958889a1fe03b35c4","99ef6235e09a5979d4e91f322e93c3