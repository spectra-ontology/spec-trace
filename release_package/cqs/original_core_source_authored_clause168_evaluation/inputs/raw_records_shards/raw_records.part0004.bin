d83a3b489bf93cccb36f41271e1fc0b8b6db48c85d9e1a92700c28b5d0c633c","021dce7d2951e70d16d449e15da9a3ea82fe4cd7ffc0c1d68b1d0b8c18465cdb","a104a829a230bfd0574326d9758437fa82196807bef0799d936234397959e9a7","336b600f439ac99a4471e789366f93dbaaec93a9c846f4f6673306f32569fe44","fb8ced4f94e2091c283baf6e4413521139ef267bbbdd244461812c5e4ce56a8f","c7efdabe167b50913c783339dd97e384c5711e64554f8df0ec58407d35497f59","4360daef60ce3272ab7dff345c8af0bd32f2976b80efd75a82fb5934a18d6391","72bf5c6e367df4c3f8341cb794a9ab676bc7d50c724bab994928f601620c7b15","011040464bcae22ea8bbaf71c7a27d1d57dc48460db01c8502ef97f76ae93dad","f0ebff67ffdd365c68fa8f16dcd35109839ef779653920d3dcbfb5c09b3243fa"],"paragraph_range_zero_based":[31584,31607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31584"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"a5-Threshold1/ a5-Threshold2","paragraph_zero_based":31608},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR conditional reconfiguration triggering condition for cond event a5. In the same condeventA5, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":31609},{"literal_text_all_w_t_and_m_t":"condEventId","paragraph_zero_based":31610},{"literal_text_all_w_t_and_m_t":"Choice of NR conditional reconfiguration event triggered criteria.","paragraph_zero_based":31611},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":31612},{"literal_text_all_w_t_and_m_t":"Distance from a fixed reference location configured with referenceLocation1 or referenceLocation2 or a moving reference location determined by the UE based on referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":31613},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":31614},{"literal_text_all_w_t_and_m_t":"This field is used for defining the leaving condition T1-2 for conditional HO event condEventT1. Each step represents 100ms.","paragraph_zero_based":31615},{"literal_text_all_w_t_and_m_t":"nesEvent","paragraph_zero_based":31616},{"literal_text_all_w_t_and_m_t":"Indicates the event is a NES-specific CHO event and the event is only considered to be satisfied if indication from lower layers is received indicating the applicability of NES-specific CHO event and the related entry condition(s) is fulfilled. This field can only be configured for condEventA3, condEventA4 or condEventA5.","paragraph_zero_based":31617},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":31618},{"literal_text_all_w_t_and_m_t":"Reference locations used for condEventD1 and condEventD2. The referenceLocation1 is associated to serving cell and referenceLocation2 is associated to candidate target cell.","paragraph_zero_based":31619},{"literal_text_all_w_t_and_m_t":"t1-Threshold","paragraph_zero_based":31620},{"literal_text_all_w_t_and_m_t":"The field counts the number of UTC seconds in 10 ms units since 00:00:00 on Gregorian calendar date 1 January, 1900 (midnight between Sunday, December 31, 1899 and Monday, January 1, 1900).","paragraph_zero_based":31621},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":31622},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to execute the conditional reconfiguration evaluation.","paragraph_zero_based":31623},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31624},{"literal_text_all_w_t_and_m_t":"ReportConfigNR field descriptions","paragraph_zero_based":31625},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":31626},{"literal_text_all_w_t_and_m_t":"Type of the configured measurement report. In MR-DC, network does not configure report of type reportCGI using SRB3. The condTriggerConfig is used for CHO, CPA or CPC configuration.","paragraph_zero_based":31627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31628},{"literal_text_all_w_t_and_m_t":"ReportCGI field descriptions","paragraph_zero_based":31629},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":31630},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the NR neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":31631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b94712153047cdc501305100a3ba95e70836894e44ff407e9116fd438a11d1d5","d0bba69b22e669bbed5fcaf4438a167286ab0a12704faab45e7726d0d60225d5","2931a4b2ee924b5da57909edc7b6f7a7e5f50b19eafa55c179d84d3d4f44aea2","fc4e9d36373f831f471bbe27af491a72dc3fcb304f17c35b3f1ec89976ea60c6","22f663881ad3f46675abcf23a0e479999a9a0c66bccd440f898ec497cc966976","eee21946d50bb4051fab99fe0413f8d623602386c0a1e3f65c71996db27f8192","c3d5753f9327db90e69de2d5113f6615b60b2ad8e96d3bfd65c83e18fc118c1d","51901c573da0cbd485873e95462a635834f1dd66cae065a2b8010d1dd79b6bd3","f40d541e2371b3b290e5bd78553e4a49ab0ba763b72fe86fe145d335147ece00","bf38981ee2818e90925441ae93bb08cb69659f8556999f88da9f9ca43c76ff0b","272f66b5fd396a5a75dc4344dbbba7a42fb18888c4c2cc265c5c5808c1f84888","ffa72cd1776641170f8ac9466879c69d969345d8a8ee155ccbadf127e7c3706b","727325dd16b45562bc21e1e1f6e802992f83c333433a40c8fbdeed8e8c63624a","cdc43c5e022783b77c3ff70528549070383fc9d8eb80ee33f7a8dea7eb40f681","7bcc416add3717c52f8862198ee67a670dcd078e15b38d9c8495112772462d56","95e710d6b1cec60b033756a4677628126c94105020429288d5119023404d6ced","852068e35cb3a6e39380fc10fa4c7486e92d4bd88928905382655c33e23e2319","a6fc61ee69cff399bf5187f01a71c8b0f57e507cd0b5b113e4c98d64876822af","36b5f6644d7101b94416876a7ddf12a6952e344409a926af8b1192f28474eec7","88ccad78e41a2e854012389aa15fb61481e7ffa13bcc4925802c796b9581e6db","66b060f484f79a4677b510b2522d019249e290647289454ae1a39f21612399d8","c49b621e06a919383b41bdefe23d908e41c9c993b1e2bc0b7137cad5bb4a3237","33d08fb8f604ddb8355c4a30282522a7309ae7b2186747868f62ec71c74c47c4","bc70f665d6ffe39359f408d89d2dc589a1a5987e588999015d52c1eeffe1809d"],"paragraph_range_zero_based":[31608,31631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31608"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31632},{"literal_text_all_w_t_and_m_t":"EventTriggerConfig field descriptions","paragraph_zero_based":31633},{"literal_text_all_w_t_and_m_t":"a3-Offset/a6-Offset","paragraph_zero_based":31634},{"literal_text_all_w_t_and_m_t":"Offset value(s) to be used in NR measurement report triggering condition for event a3/a6. The actual value is field value * 0.5 dB.","paragraph_zero_based":31635},{"literal_text_all_w_t_and_m_t":"aN-ThresholdM","paragraph_zero_based":31636},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event number aN. If multiple thresholds are defined for event number aN, the thresholds are differentiated by M. In the same eventA5, eventA5H1, eventA5H2, the network configures the same quantity for the MeasTriggerQuantity of the a5-Threshold1 and for the MeasTriggerQuantity of the a5-Threshold2.","paragraph_zero_based":31637},{"literal_text_all_w_t_and_m_t":"channelOccupancyThreshold","paragraph_zero_based":31638},{"literal_text_all_w_t_and_m_t":"RSSI threshold which is used for channel occupancy evaluation.","paragraph_zero_based":31639},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":31640},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":31641},{"literal_text_all_w_t_and_m_t":"distanceThreshFromReference1, distanceThreshFromReference2","paragraph_zero_based":31642},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the distance from a reference location configured with referenceLocation1 or referenceLocation2. Each step represents 50m.","paragraph_zero_based":31643},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":31644},{"literal_text_all_w_t_and_m_t":"Choice of NR event triggered reporting criteria.","paragraph_zero_based":31645},{"literal_text_all_w_t_and_m_t":"includeAltitudeUE","paragraph_zero_based":31646},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report altitude information.","paragraph_zero_based":31647},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":31648},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report for A1-A6 events.","paragraph_zero_based":31649},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":31650},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":31651},{"literal_text_all_w_t_and_m_t":"numberOfTriggeringCells","paragraph_zero_based":31652},{"literal_text_all_w_t_and_m_t":"Indicates the number of cells detected that are required to fulfill an event for a measurement report to be triggered. This field is applicable only for the events concerning neighbor cells, i.e. eventA3, eventA4, eventA5, eventA3H1, eventA3H2, eventA4H1, eventA4H2, eventA5H1, eventA5H2.","paragraph_zero_based":31653},{"literal_text_all_w_t_and_m_t":"referenceLocation1, referenceLocation2","paragraph_zero_based":31654},{"literal_text_all_w_t_and_m_t":"Reference locations used for eventD1. The referenceLocation1 is associated to serving cell and referenceLocation2 is associated to neighbour cell.","paragraph_zero_based":31655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["36c99fd302c638bf2147b99b35d7cf2770619e5a202e02b9afc1ce86565b7336","b2555ccf9105b85ea6968582fe45de72929cba6139cabc7d4761db772221d40b","159f1dff4b8537c170612aacc213f0e1f8ca15244dc38086faac5fa59a2ddec0","478174fac99ab3a03ad72fd36cc0eeeeaad7a700a122079df25b84f9959ef106","5e949dcab33329eb0ddaf29d1fc451f2efa5ee89e61d07048bad0f68f2dfd564","de85f2abf285fed9e4bed926376bd022e3c9a50ad3cd0990332ff2cfc62ac1a4","278eac2a5085cc288eb8323449d3184fe8de1913eb71fd0d4acd8cca484b8b21","88a4fa7e2c457905ab2823eea38d48cf4a9e8d547cab8c4b976721b9cdbe9c0d","f97354f1e99de45234c90775f181ed4422499ba742c7c7e13ad2101b4c2a16f7","894214a5be12855ba6399717a1c22525a1f0abebbfe0ef98e9bc68751e1061e5","a287ac89ffdeec7b872884251292ca71ea98ce2250e9f2c9eefada4f7212e3c9","119bf329dc21f8a3dc7669d28811c5336d3af6e250d3bac436ede7ea7330a1af","4b5351f1d45a6c48ad02c55201d39e032f498043d7940aa866c86007a51f89f6","8c0d19cb10e278ad0f426f55e49038db12891db034c44cb21ace54104f9cf3d4","4451d31b150b7b36ac519b5d4d7be27a94b3a11973e0c94b7a949fea4571921c","0f7820fb45ce12c6231d83f02577c84cddd49fa196bfa5277f18f381cc7e21c1","84f47fe3d6dc0a691e6412d7b8c81906b97f3a518f7ce02ec7a3d18c2f6db613","731d374cd47ee9a806f1692d12dbd5b6b1f8941270be4bc21bedb1afa1a08f33","5f8018d45f77425e320378394f507c16e30796a08793fd8d7428586e68458d91","f9e90ca3edb69ad03c3c816eb499ec329dcf800e0650cb2fe8b86912574afe73","2a5f10ba49763a62c67505331e08cf7c42718d3aa50e7662ff4e40559bd82a9f","0806125fc0fef65c30cab9475c24a0bac6df18a586d813776ca5d2b610d20f1c","8e894580c8dd25968bf848a471c7e14f1c9a91508172c2a022668a62d207c785","b47d3c27c053a8a7b13b76c7e4dcc4cbb9e377343e39da6bcd04f81b5e0f6632"],"paragraph_range_zero_based":[31632,31655],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31632"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":31656},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":31657},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31658},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types.","paragraph_zero_based":31659},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":31660},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":31661},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met if configured in eventD1, eventH1, eventH2 as specified in 5.5.4.1.","paragraph_zero_based":31662},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":31663},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":31664},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":31665},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":31666},{"literal_text_all_w_t_and_m_t":"simulMultiTriggerSingleMeasReport","paragraph_zero_based":31667},{"literal_text_all_w_t_and_m_t":"Indicates when multiple events of the same type satisfy the entering condition(s), whether to consider only the event with the smallest value between the altitude of the UE and the configured altitude threshold.","paragraph_zero_based":31668},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":31669},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":31670},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":31671},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":31672},{"literal_text_all_w_t_and_m_t":"useT312","paragraph_zero_based":31673},{"literal_text_all_w_t_and_m_t":"If value TRUE is configured, the UE shall use the timer T312 with the value t312 as specified in the corresponding measObjectNR. If value FALSE is configured, the timer T312 is considered as disabled. Network configures value TRUE only if reportType is set to eventTriggered.","paragraph_zero_based":31674},{"literal_text_all_w_t_and_m_t":"xN-ThresholdM","paragraph_zero_based":31675},{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. RSRP, RSRQ, SINR) per RS Type (e.g. SS/PBCH block, CSI-RS) to be used in NR measurement report triggering condition for event xN. If multiple thresholds are defined for event number xN, the thresholds are differentiated by M. x1-Threshold1 and x2-Threshold indicates the threshold value for the serving L2 U2N Relay UE, x1-Threshold2 indicates the threshold value for the NR Cells.","paragraph_zero_based":31676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31677},{"literal_text_all_w_t_and_m_t":"CLI-EventTriggerConfig field descriptions","paragraph_zero_based":31678},{"literal_text_all_w_t_and_m_t":"i1-Threshold","paragraph_zero_based":31679}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d3