{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2N Relay UE and L2 U2N Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":46224},{"literal_text_all_w_t_and_m_t":"U2URelayUE","paragraph_zero_based":46225},{"literal_text_all_w_t_and_m_t":"For U2U Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":46226},{"literal_text_all_w_t_and_m_t":"U2URemoteUE","paragraph_zero_based":46227},{"literal_text_all_w_t_and_m_t":"For U2U Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":46228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46229},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfig","paragraph_zero_based":46230},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfig specifies the configured grant configuration information for NR sidelink communication.","paragraph_zero_based":46231},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig information element","paragraph_zero_based":46232},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46233},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":46234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46235},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig-r16 ::=           SEQUENCE {","paragraph_zero_based":46236},{"literal_text_all_w_t_and_m_t":"    sl-ConfigIndexCG-r16                       SL-ConfigIndexCG-r16,","paragraph_zero_based":46237},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG-r16                            SL-PeriodCG-r16                                                       OPTIONAL, -- Need M","paragraph_zero_based":46238},{"literal_text_all_w_t_and_m_t":"    sl-NrOfHARQ-Processes-r16                  INTEGER (1..16)                                                       OPTIONAL, -- Need M","paragraph_zero_based":46239},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-ProcID-offset-r16                  INTEGER (0..15)                                                       OPTIONAL, -- Need M","paragraph_zero_based":46240},{"literal_text_all_w_t_and_m_t":"    sl-CG-MaxTransNumList-r16                  SL-CG-MaxTransNumList-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":46241},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrant-r16            SEQUENCE {","paragraph_zero_based":46242},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r16                INTEGER (0..496)                                                  OPTIONAL, -- Need M","paragraph_zero_based":46243},{"literal_text_all_w_t_and_m_t":"        sl-StartSubchannelCG-Type1-r16             INTEGER (0..26)                                                   OPTIONAL, -- Need M","paragraph_zero_based":46244},{"literal_text_all_w_t_and_m_t":"        sl-FreqResourceCG-Type1-r16                INTEGER (0..6929)                                                 OPTIONAL, -- Need M","paragraph_zero_based":46245},{"literal_text_all_w_t_and_m_t":"        sl-TimeOffsetCG-Type1-r16                  INTEGER (0..7999)                                                 OPTIONAL, -- Need R","paragraph_zero_based":46246},{"literal_text_all_w_t_and_m_t":"        sl-N1PUCCH-AN-r16                          PUCCH-ResourceId                                                  OPTIONAL, -- Need M","paragraph_zero_based":46247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree