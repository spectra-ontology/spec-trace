{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Timer for consistent uplink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":23520},{"literal_text_all_w_t_and_m_t":"lbt-FailureInstanceMaxCount","paragraph_zero_based":23521},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers uplink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":23522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23523},{"literal_text_all_w_t_and_m_t":"–LocationInfo","paragraph_zero_based":23524},{"literal_text_all_w_t_and_m_t":"The IE LocationInfo is used to transfer available detailed location information, Bluetooth, WLAN and sensor available measurement results at the UE.","paragraph_zero_based":23525},{"literal_text_all_w_t_and_m_t":"LocationInfo information element","paragraph_zero_based":23526},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23527},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-START","paragraph_zero_based":23528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23529},{"literal_text_all_w_t_and_m_t":"LocationInfo-r16 ::=      SEQUENCE {","paragraph_zero_based":23530},{"literal_text_all_w_t_and_m_t":"    commonLocationInfo-r16    CommonLocationInfo-r16          OPTIONAL,","paragraph_zero_based":23531},{"literal_text_all_w_t_and_m_t":"    bt-LocationInfo-r16       LogMeasResultListBT-r16         OPTIONAL,","paragraph_zero_based":23532},{"literal_text_all_w_t_and_m_t":"    wlan-LocationInfo-r16     LogMeasResultListWLAN-r16       OPTIONAL,","paragraph_zero_based":23533},{"literal_text_all_w_t_and_m_t":"    sensor-LocationInfo-r16   Sensor-LocationInfo-r16         OPTIONAL,","paragraph_zero_based":23534},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23535},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23537},{"literal_text_all_w_t_and_m_t":"-- TAG-LOCATIONINFO-STOP","paragraph_zero_based":23538},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23540},{"literal_text_all_w_t_and_m_t":"–LocationMeasurementInfo","paragraph_zero_based":23541},{"literal_text_all_w_t_and_m_t":"The IE LocationMeasurementInfo defines the information sent by the UE to the network to assist with the configuration of measurement gaps for location related measurements.","paragraph_zero_based":23542},{"literal_text_all_w_t_and_m_t":"LocationMeasurementInfo information element","paragraph_zero_based":23543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7e743116050061e9ca58699d9725a67d9e61d286f2ee9ef682b1ef86a6cb93c2","28b2e94f4bb8cc998be3f6a4414bded66a5b6cba2e7515db950561db57d911cc","0ad81fc951248bc94db7699bd2a15102bf3e551f2154ccaa3975bfd63d57f1c5","2d520fb44c25209ff7e98f83b51a79abd9239f7e1f4a2b9366506a371d6c6793","556cc365fc0fcb4d8e19279f8e930a0a3d87e7ef80361d880fb085dd7a756b79","7efd46b7da9350a46d12318f5cfdb2cf4e797648e85ef4d92cf9a6a83f9145ed","182b4afff5a4f63d40d8d0a137117a6959b860e5696ece735965ccd5235a19c5","5f5147966bb7b1e4e243bf7fe57eeb90d46bb4fb8a2c7ffa8fa5e08cb7fdd2a7","e259162629b4bda335a9b937347326a03052486488aebcf20dd24613897428b7","b17e922d273d38c436d68681b110e812a9bf396907fb38dab41dd21c0597912f","cb675884f8f1