1cc7ad4e50b132b2774164f59d29","38da4253628ca8170c809646a4984423f4eb5ff30e1ace2bf0d49bcea0e89bb3","6097961e4eb10c1b0835075ea69c675179a535c1ba625d97f3f0a07f0bc5b3fc","2261d8fa894d9f1fbabf46a068636d50caa19f230e6c36a85a4d055971d6b638","ade2b370b9338ad1ecee2b3578b48578044c536096395314b13e0a5d6dc1724b","28651f68e64cff8a2af3dc80d53cd6ccfd3a8ea16e8514f8964baed74af3638b","1ccbe3eda6f2e2ed7d0052c5f9115850f5c68cc5aca2babd27741010a79d2db9","2eb2728fb1cc428afbf7428a633cc4403f248cc4bce638cd67f167a790c99245","8981c177616fec1918bb7560361a3db72f28f2a2ef5fdde2baf965cd10d6a445","1f425b469ab29759fb4ca8192ed755eb74ae3ce13e7b3326fb154e2f30d531b8","f62ccd94be7036edb902be44867f894b3b92a05b4c4cf4c1eb0b8a38ff1f71a3"],"paragraph_range_zero_based":[24048,24071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24048"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalBS-TableAllowed","paragraph_zero_based":24072},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is allowed to utilize the refined buffer size levels, as specified in TS 38.321 [3], for a certain Logical Channel Group. The leftmost bit corresponds to LCG ID=0, second leftmost bit to LCG ID=1 and so on. The UE is allowed to utilize the refined buffer size levels for a Logical Channel Group only when the corresponding bit is set to 1.","paragraph_zero_based":24073},{"literal_text_all_w_t_and_m_t":"allowCSI-SRS-Tx-MulticastDRX-Active","paragraph_zero_based":24074},{"literal_text_all_w_t_and_m_t":"Used to control the CSI/SRS transmission during MBS multicast DRX ActiveTime, see TS 38.321 [3].","paragraph_zero_based":24075},{"literal_text_all_w_t_and_m_t":"csi-Mask","paragraph_zero_based":24076},{"literal_text_all_w_t_and_m_t":"If set to true, the UE limits CSI reports to the on-duration period of the DRX cycle, see TS 38.321 [3].","paragraph_zero_based":24077},{"literal_text_all_w_t_and_m_t":"dataInactivityTimer","paragraph_zero_based":24078},{"literal_text_all_w_t_and_m_t":"Releases the RRC connection upon data inactivity as specified in clause 5.3.8.5 and in TS 38.321 [3]. Value s1 corresponds to 1 second, value s2 corresponds to 2 seconds, and so on.","paragraph_zero_based":24079},{"literal_text_all_w_t_and_m_t":"drx-Config, drx-ConfigExt, drx-ConfigExt2","paragraph_zero_based":24080},{"literal_text_all_w_t_and_m_t":"Used to configure DRX as specified in TS 38.321 [3]. Network only configures drx-ConfigExt or drx-ConfigExt2 when drx-Config is configured.","paragraph_zero_based":24081},{"literal_text_all_w_t_and_m_t":"drx-ConfigSecondaryGroup","paragraph_zero_based":24082},{"literal_text_all_w_t_and_m_t":"Used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3]. The network does not configure secondary DRX group with DCP simultaneously nor secondary DRX group with a dormant BWP simultaneously.","paragraph_zero_based":24083},{"literal_text_all_w_t_and_m_t":"drx-ConfigSL","paragraph_zero_based":24084},{"literal_text_all_w_t_and_m_t":"Used to configure additional DRX parameters for the UE performing sidelink operation with resource allocation mode 1, as specified in TS 38.321 [3]. Network only configures this field if sl-ScheduledConfig is configured and drx-Config is configured.","paragraph_zero_based":24085},{"literal_text_all_w_t_and_m_t":"drx-LastTransmissionUL","paragraph_zero_based":24086},{"literal_text_all_w_t_and_m_t":"If this field is present, the start of the drx-HARQ-RTT-TimerUL is after the last transmission within a bundle, see TS 38.321 [3].","paragraph_zero_based":24087},{"literal_text_all_w_t_and_m_t":"dsr-ConfigToAddModList","paragraph_zero_based":24088},{"literal_text_all_w_t_and_m_t":"List of LCG-specific DSR configurations to add or modify.","paragraph_zero_based":24089},{"literal_text_all_w_t_and_m_t":"dsr-ConfigToReleaseList","paragraph_zero_based":24090},{"literal_text_all_w_t_and_m_t":"List of LCG-specific DSR configurations to release.","paragraph_zero_based":24091},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToAddModList","paragraph_zero_based":24092},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to add or modify. Up to 8 G-RNTIs can be configured in total in this release based on the UE capability.","paragraph_zero_based":24093},{"literal_text_all_w_t_and_m_t":"g-RNTI-ConfigToReleaseList","paragraph_zero_based":24094},{"literal_text_all_w_t_and_m_t":"List of G-RNTI configurations to release.","paragraph_zero_based":24095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f8