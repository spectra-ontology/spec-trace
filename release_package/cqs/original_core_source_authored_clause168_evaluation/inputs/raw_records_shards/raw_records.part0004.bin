{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present when a condReconfigId is being added. Otherwise the field is optional, need M.","paragraph_zero_based":20472},{"literal_text_all_w_t_and_m_t":"condReconfigCHO-WithSCG","paragraph_zero_based":20473},{"literal_text_all_w_t_and_m_t":"This field is optional present, need M, if the RRCReconfiguration message contained in corresponding condRRCReconfig includes the nr-SCG and condExecutionCond is configured. Otherwise, it is absent.","paragraph_zero_based":20474},{"literal_text_all_w_t_and_m_t":"CPAC","paragraph_zero_based":20475},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need M, when the conditional reconfiguration includes at least one candidate PSCell supporting subsequent CPAC. Otherwise, the field is absent, need R.","paragraph_zero_based":20476},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20477},{"literal_text_all_w_t_and_m_t":"–ConditionalReconfiguration","paragraph_zero_based":20478},{"literal_text_all_w_t_and_m_t":"The IE ConditionalReconfiguration is used to add, modify and release the configuration of conditional reconfiguration.","paragraph_zero_based":20479},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration information element","paragraph_zero_based":20480},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20481},{"literal_text_all_w_t_and_m_t":"-- TAG-CONDITIONALRECONFIGURATION-START","paragraph_zero_based":20482},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20483},{"literal_text_all_w_t_and_m_t":"ConditionalReconfiguration-r16 ::=   SEQUENCE {","paragraph_zero_based":20484},{"literal_text_all_w_t_and_m_t":"    attemptCondReconfig-r16              ENUMERATED {true}              OPTIONAL,   -- Cond CHO","paragraph_zero_based":20485},{"literal_text_all_w_t_and_m_t":"    condReconfigToRemoveList-r16         CondReconfigToRemoveList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":20486},{"literal_text_all_w_t_and_m_t":"    condReconfigToAddModList-r16         CondReconfigToAddModList-r16   OPTIONAL,   -- Need N","paragraph_zero_based":20487},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":20488},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":20489},{"literal_text_all_w_t_and_m_t":"    scpac-ReferenceConfiguration-r18     SetupRelease {ReferenceConfiguration-r18}          OPTIONAL,   -- Need M","paragraph_zero_based":20490},{"literal_text_all_w_t_and_m_t":"    servingSecurityCellSetId-r18         SecurityCellSetId-r18                              OPTIONAL,   -- Cond condInitialSCPAC","paragraph_zero_based":20491},{"literal_text_all_w_t_and_m_t":"    sk-CounterConfiguration-r18          SK-CounterConfiguration-r18                        OPTIONAL    -- Cond condInitialSCPAC","paragraph_zero_based":20492},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":20493},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20494},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["24798091b12cba2b3cff337e4aad245ee38b988624dafb278439b8789ad30b67","d85be00c7ffc87f2b4177ea7c8145e8a9415bb6c36f9b2183f163ac05f158162","637a69ec9d5e318cd08af831e6f3c1b39f2caf7050ffe08c55f94dcbc691c286","5fc95edc9d5779ef71105beb7dcb9e289a3cdc1c47194cc6f269a234cd03c1b3","e5038e4bd8163a0f52a83bedf27baabc8839be045cd44d9f1a6e6bedd6bd0013","9ffe0d4f5f96e123a9299d0d0af3724e95d47f19683e1b48d06d8cb0102e02e3","ed23731b1fdecd3bff9d02441a46dcc