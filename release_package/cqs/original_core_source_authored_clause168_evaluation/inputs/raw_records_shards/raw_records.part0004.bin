{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    flightPathUpdateThrConfig-r18     SEQUENCE {","paragraph_zero_based":18168},{"literal_text_all_w_t_and_m_t":"        flightPathUpdateDistanceThr-r18   SetupRelease { FlightPathUpdateDistanceThr-r18 }        OPTIONAL, -- Need M","paragraph_zero_based":18169},{"literal_text_all_w_t_and_m_t":"        flightPathUpdateTimeThr-r18       SetupRelease { FlightPathUpdateTimeThr-r18 }            OPTIONAL  -- Need M","paragraph_zero_based":18170},{"literal_text_all_w_t_and_m_t":"    }                                                                                             OPTIONAL, -- Need M","paragraph_zero_based":18171},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18172},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18174},{"literal_text_all_w_t_and_m_t":"FlightPathUpdateDistanceThr-r18 ::=   INTEGER (0..1023)","paragraph_zero_based":18175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18176},{"literal_text_all_w_t_and_m_t":"FlightPathUpdateTimeThr-r18 ::=       INTEGER (0..16383)","paragraph_zero_based":18177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18178},{"literal_text_all_w_t_and_m_t":"-- TAG-AERIAL-CONFIG-STOP","paragraph_zero_based":18179},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18180},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18181},{"literal_text_all_w_t_and_m_t":"Aerial-Config field descriptions","paragraph_zero_based":18182},{"literal_text_all_w_t_and_m_t":"flightPathUpdateDistanceThr","paragraph_zero_based":18183},{"literal_text_all_w_t_and_m_t":"Distance threshold for triggering flight path update indication. Actual value is 5 x field value in meters.","paragraph_zero_based":18184},{"literal_text_all_w_t_and_m_t":"flightPathUpdateTimeThr","paragraph_zero_based":18185},{"literal_text_all_w_t_and_m_t":"Time threshold for triggering flight path update indication. Value in seconds.","paragraph_zero_based":18186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18187},{"literal_text_all_w_t_and_m_t":"–Alpha","paragraph_zero_based":18188},{"literal_text_all_w_t_and_m_t":"The IE Alpha defines possible values of a the pathloss compensation coefficient for uplink power control. Value alpha0 corresponds to the value 0, Value alpha04 corresponds to the value 0.4, Value alpha05 corresponds to the value 0.5 and so on. Value alpha1 corresponds to value 1. See also clause 7.1 of TS 38.213 [13].","paragraph_zero_based":18189},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18190},{"literal_text_all_w_t_and_m_t":"-- TAG-ALPHA-START","paragraph_zero_based":18191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ba648260f100ce12f7e518a2d2aaf71489763556efa8fc3bdef5ea250363b5e2","112e7b4dc363a11b1588eac142352613430ebcb2c6d3413754f36b0bd6cbae02","bd7a50f61377d5367017b340d04118e1c7a6d41c4c8c200e4687d55ceb0ad6ca","3c5e886a82e473cc761c334fa973026f52da9b2247bcfe36cd8b214a43de5f99","89d3a606c0b86e9db86373c141f42a0fd8f778c09c8cec871fbe4ed7dd78b88d","9d85c4ec36239afdb48f8dc552fde91516fd377f63679b4f6d3b43d018f1faee","4c72ec35c1fe78084b15262c4735e62ab5a4f246f6424613284f840984285754","0daf05666bc9de4ea513b9ebc0a7d3d1e5aa51bd17d3400694e2ed77aa5d5c63","fa9514e93520d7b3d2adf2b7220b6ff4d512b8871ada791331ec1b597d60c407","9909cedaf8706ddf799a1345bc2a7c0cb30c7ccc05142a091b04ac7c9d32a3e2","9ff51e023f5d772411f5d171cfe5f0afd16d9cca188685a0c07c5b06b78b28a9