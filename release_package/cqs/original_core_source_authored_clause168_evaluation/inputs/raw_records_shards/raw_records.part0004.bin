{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25776},{"literal_text_all_w_t_and_m_t":"MeasWindowConfig field descriptions","paragraph_zero_based":25777},{"literal_text_all_w_t_and_m_t":"windowDuration","paragraph_zero_based":25778},{"literal_text_all_w_t_and_m_t":"Value windowDuration is the measurement window length in ms of effective measurement window. Value ms2 corresponds to 2 ms, value ms5 corresponds to 5 ms, and Value ms5dot5 corresponds to 5.5 ms.","paragraph_zero_based":25779},{"literal_text_all_w_t_and_m_t":"windowOffsetPeriodicity","paragraph_zero_based":25780},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity and offset of effective measurement window. The choice determines the periodicity (periodicityMs40 for 40ms and periodicityMs80 for 80 ms). The field value indicates the offset in ms.","paragraph_zero_based":25781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25782},{"literal_text_all_w_t_and_m_t":"–MobilityStateParameters","paragraph_zero_based":25783},{"literal_text_all_w_t_and_m_t":"The IE MobilityStateParameters contains parameters to determine UE mobility state.","paragraph_zero_based":25784},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters information element","paragraph_zero_based":25785},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25786},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYSTATEPARAMETERS-START","paragraph_zero_based":25787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25788},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters ::=         SEQUENCE{","paragraph_zero_based":25789},{"literal_text_all_w_t_and_m_t":"    t-Evaluation                        ENUMERATED {","paragraph_zero_based":25790},{"literal_text_all_w_t_and_m_t":"                                            s30, s60, s120, s180, s240, spare3, spare2, spare1},","paragraph_zero_based":25791},{"literal_text_all_w_t_and_m_t":"    t-HystNormal                        ENUMERATED {","paragraph_zero_based":25792},{"literal_text_all_w_t_and_m_t":"                                            s30, s60, s120, s180, s240, spare3, spare2, spare1},","paragraph_zero_based":25793},{"literal_text_all_w_t_and_m_t":"    n-CellChangeMedium                  INTEGER (1..16),","paragraph_zero_based":25794},{"literal_text_all_w_t_and_m_t":"    n-CellChangeHigh                    INTEGER (1..16)","paragraph_zero_based":25795},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25797},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYSTATEPARAMETERS-STOP","paragraph_zero_based":25798},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6445d3b50f8c492826b71e1f1a66ed920a57d6290c539ac470661be9dca3e0f7","5f722f9c27e35e85b920664d708289eac06bb909403751b59b2d11ea67bb6e57","e307c6b0784e75dfbdbe5509d3e89c9139a28ea50a54954e2accd065b6d0fac0","1835da3c9b7c62cedc2bc728e47072f29ea6babd1be71d1b7b6c0656e6901e10","d6f5460d8f6c9dbf008da41c8126447a20566dcc19d005860d9fa49535b43a9d","ae25be89afda4dd8ba9fdefeaee2568434269d98b92c23e9b806a5ffbc48a9a0","45a85f246aa9e8ef1b9345348959327ee5c27fdd63cf687cda489564148059a9","47db509a0e9105617eef5d409ed71911afcc4d24b3c6f021edd8fbef9f92e179","db1d9c07232c98c2ba27dcaae10b6ac9caacc75fd1434a94c5ee7fea87cbb0f2","6182132177d721dc453d5edcc40532e3385b95aaee07eaf1ab73dbe6203c8f2c","6cff7f101bdf7cbb5b1c4d5b47c1048a35567dea332a2a571b06b89a74f063f0","12