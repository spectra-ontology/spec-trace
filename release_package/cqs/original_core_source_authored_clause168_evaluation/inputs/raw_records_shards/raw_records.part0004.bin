{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–Q-OffsetRange","paragraph_zero_based":30216},{"literal_text_all_w_t_and_m_t":"The IE Q-OffsetRange is used to indicate a cell, beam or measurement object specific offset to be applied when evaluating candidates for cell re-selection or when evaluating triggering conditions for measurement reporting. The value is in dB. Value dB-24 corresponds to -24 dB, dB-22 corresponds to -22 dB and so on.","paragraph_zero_based":30217},{"literal_text_all_w_t_and_m_t":"Q-OffsetRange information element","paragraph_zero_based":30218},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30219},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-OFFSETRANGE-START","paragraph_zero_based":30220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30221},{"literal_text_all_w_t_and_m_t":"Q-OffsetRange ::=                   ENUMERATED {","paragraph_zero_based":30222},{"literal_text_all_w_t_and_m_t":"                                                dB-24, dB-22, dB-20, dB-18, dB-16, dB-14,","paragraph_zero_based":30223},{"literal_text_all_w_t_and_m_t":"                                                dB-12, dB-10, dB-8, dB-6, dB-5, dB-4, dB-3,","paragraph_zero_based":30224},{"literal_text_all_w_t_and_m_t":"                                                dB-2, dB-1, dB0, dB1, dB2, dB3, dB4, dB5,","paragraph_zero_based":30225},{"literal_text_all_w_t_and_m_t":"                                                dB6, dB8, dB10, dB12, dB14, dB16, dB18,","paragraph_zero_based":30226},{"literal_text_all_w_t_and_m_t":"                                                dB20, dB22, dB24}","paragraph_zero_based":30227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30228},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-OFFSETRANGE-STOP","paragraph_zero_based":30229},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30231},{"literal_text_all_w_t_and_m_t":"–Q-QualMin","paragraph_zero_based":30232},{"literal_text_all_w_t_and_m_t":"The IE Q-QualMin is used to indicate for cell selection/ re-selection the required minimum received RSRQ level in the (NR) cell. Corresponds to parameter Qqualmin in TS 38.304 [20]. Actual value Qqualmin = field value [dB].","paragraph_zero_based":30233},{"literal_text_all_w_t_and_m_t":"Q-QualMin information element","paragraph_zero_based":30234},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30235},{"literal_text_all_w_t_and_m_t":"-- TAG-Q-QUALMIN-START","paragraph_zero_based":30236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30237},{"literal_text_all_w_t_and_m_t":"Q-QualMin ::=                       INTEGER (-43..-12)","paragraph_zero_based":30238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["579dcfe0b549f1b6f61cc94dedeacaa6069ef649e329c1a87c21d5cf96f171bd","05195c3447ae32ba881cbbffa35e1a1cf1f6ab2b4192f91c1bf9baedc80fa48d","836caa8b3e95de066acaaf78b5d8c8f923bee62046d2b6b0af5d75673a2718de","ef7efc615e31876a8446aec523804a327aa781a72cfbd00d5a9c6263db0248c5","2e3513370042c93ab9de85afaf2f414bbf8e60497e0c8c00ff98eb8af9322fbf","a2d8f32a471915a7aacd28b702853f9f7a16979addff5ac67dcd4bec7de9c01d","2493ad329b4015c4f496ae33e6f0e4168bff723e56adc3bb7df522de59c8355c","33c9d9e6d5fe59fb3926a035a0e1413dcccc64989080ca664b730ffd9bc78aa2","1aef3b8f2f0a370d54bb5104a6c7598744937190f3d9a300cc5947692e957aee","21dd0c2ed5d75d6513f1e6ba0ee3e5e0083b1e648330ca1b0dc7