{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigCommon is used to configure cell specific PDCCH parameters provided in SIB as well as in dedicated signalling.","paragraph_zero_based":27456},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon information element","paragraph_zero_based":27457},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27458},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-START","paragraph_zero_based":27459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27460},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":27461},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero                                  OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":27462},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSet            ControlResourceSet                                      OPTIONAL,   -- Need R","paragraph_zero_based":27463},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero                                         OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":27464},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceList               SEQUENCE (SIZE(1..4)) OF SearchSpace                    OPTIONAL,   -- Need R","paragraph_zero_based":27465},{"literal_text_all_w_t_and_m_t":"    searchSpaceSIB1                     SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27466},{"literal_text_all_w_t_and_m_t":"    searchSpaceOtherSystemInformation   SearchSpaceId                                           OPTIONAL,   -- Need S","paragraph_zero_based":27467},{"literal_text_all_w_t_and_m_t":"    pagingSearchSpace     