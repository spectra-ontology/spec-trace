{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54288},{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54290},{"literal_text_all_w_t_and_m_t":"MeasurementReport","paragraph_zero_based":54291},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54292},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54293},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54294},{"literal_text_all_w_t_and_m_t":"Measurement configuration may be sent prior to AS security activation. But: In order to protect privacy of UEs, MeasurementReport is only sent from the UE after successful AS security activation.","paragraph_zero_based":54295},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand","paragraph_zero_based":54296},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54297},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54298},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54300},{"literal_text_all_w_t_and_m_t":"Paging","paragraph_zero_based":54301},{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54302},{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54303},{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54305},{"literal_text_all_w_t_and_m_t":"RRCReconfiguration","paragraph_zero_based":54306},{"literal_text_all_w_t_and_m_t":"+","paragraph_zero_based":54307},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54308},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54309},{"literal_text_all_w_t_and_m_t":"The message shall not be sent unprotected before AS security activation if it is used to perform handover or to est