{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSB-MTC field descriptions","paragraph_zero_based":35112},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":35113},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":35114},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":35115},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":35116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35117},{"literal_text_all_w_t_and_m_t":"SSB-MTC2 field descriptions","paragraph_zero_based":35118},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35119},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":35120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35121},{"literal_text_all_w_t_and_m_t":"SSB-MTC3 field descriptions","paragraph_zero_based":35122},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":35123},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":35124},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35125},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC, used for IAB-node discovery.","paragraph_zero_based":35126},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":35127},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":35128},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":35129},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS block index 0, the second bit corresponds to SS block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS block is not to be measured while value 1 indicates that the corresponding SS block is to be measured (see TS 38.215 [9]). When the field is not configured the IAB-MT measures on all SS blocks. Regardless of the value of this field, SS blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":35130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35131},{"literal_text_all_w_t_and_m_t":"SSB-MTC4 field descriptions","paragraph_zero_based":35132},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35133},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":35134},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":35135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["809dd5b2b36a0290e14fb04a3d9073fe8b95bef6274704bea6d9472449910f4a","9b318b689a42c38c9ef6202c16035f31f6e10d79e282ed6fa775304e4a285c5a","8c78eed390e60016ded7ee3fe02fa1d4e73622ad62836404b6b2e8184d32fc65","ec071a25996f2c15c1e9ad36f625c1ffa766c5e41aa11a6cc99c16756aef194d","a66b2dd02d0fb144b66ecda90295a693aac48c6a13852dd13f000644d53ede50","3a9bbfef0476d919fda3caa12a07a6ebfa6c653058a5d9df5118658bbb85a96a","13fe82b0a0ef1088f5147aba90012c3baa9ae9ef75ef60c64b00fa60ad8e5220","574ca5ca4814d08123072ca69694a7648fde5827a790198640e0b3431342366c","3af0f7fe876f454e6b4150ffe071792ae31804484189bee2384710a5b779b00f","758d6184e35ae0928d7dff6a3dfe2f4c06233e99c68e3ddc37b28b8610cbf0ed","f6480e4256abfeeb55d0cd6ddcaac5d969c0347ffaf4fb1f448d09fa8b8ddb4a","b0cf985c8ff7298379ad85d5eaf0d46189b2fc2d3230fc3bdc5ba14e600339b3","18b4af27ebee9948d4258adcafb4f212271128715dbff68d472bfaea5f4dfecd","b3ab2c1b3a9528fd61b6d4dfd70089a2781b11900706ddb12c424cc15b568810","35d105fb435bdf4e8609909465f59249373fb4981440e04e12d63731a4e932d3","cd864394af754d167a356836fe07b025f3872d04896c01944e519ecb1f1e5714","f75c5b716293f96c0e475a32dcc1a9eb0257e2f5e37c130770232ebeca5a3b42","b672c5d67cbf0bfe026318360da1f577c27984b7d484d01530ad93f96e8277db","0faa7e26560cbd2607aa24960d09d22da4d677e66a76ad49bfce2f3e7a799de9","fececa0bb4375bb05b41342b68b6b6d6787c8b8ee8f6b1f32732dc6085553073","156e716f14de1c07bf33f35b07e2594059d3a361cacce16b945357936b4ff4a2","8d558c2e3ad86378e24aff8b3709e5e3f8471fd3c87e18a87d9c4f1292f56cf1","ba899670e77e60a4c1b62984cad3ec7cd47590a705d2ef45bd594f7ed180fcca","7da613d892d161ea83aadd50d91fde66777f145092c861d80ec61582e9b572c0"],"paragraph_range_zero_based":[35112,35135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35112"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Offset is given in number of subframes.","paragraph_zero_based":35136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35137},{"literal_text_all_w_t_and_m_t":"SSB-MTC-AdditionalPCI field descriptions","paragraph_zero_based":35138},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":35139},{"literal_text_all_w_t_and_m_t":"PCI of the additional SSB different from serving cell PCI.","paragraph_zero_based":35140},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":35141},{"literal_text_all_w_t_and_m_t":"Periodicity of the SS/PBCH blocks, see 5.5.2.10. Periodicity is given in number of subframes.","paragraph_zero_based":35142},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":35143},{"literal_text_all_w_t_and_m_t":"Indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":35144},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":35145},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":35146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35147},{"literal_text_all_w_t_and_m_t":"–SSB-PositionQCL-Relation","paragraph_zero_based":35148},{"literal_text_all_w_t_and_m_t":"The IE SSB-PositionQCL-Relation is used to indicate the QCL relationship between SSB positions on the frequency indicated by ssbFrequency (see TS 38.213 [13], clause 4.1) for operation with shared spectrum channel access. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":35149},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation information element","paragraph_zero_based":35150},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35151},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-START","paragraph_zero_based":35152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35153},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r16 ::=  ENUMERATED {n1,n2,n4,n8}","paragraph_zero_based":35154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35155},{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-Relation-r17 ::=  ENUMERATED {n32, n64}","paragraph_zero_based":35156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35157},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-POSITIONQCL-RELATION-STOP","paragraph_zero_based":35158},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["13dabbf5cd56566147781dc830644909fe4bb9295922e9e9d365a3a9c792f4c2","0e039eed181814edd30c9fca67d318487d253e9da1244a13747ff17b22c26e49","857844cacc2fdc4f2bb1f294d2e20569cb3ff7191c622882b2bc9245c0c04cfa","023e61a6bdc766ec3d90a5f0ce8bdfed5f683c3313b120eeeb04d8fae30a3de0","fea5e4945824bbcdafbc7b1a00c02f945318c054c5b3546c610061cd1edd04c0","66de6e966a0fd0d1eb66621eb01ff8c12818db9a1b16858e193443c70e873d8f","6977e2a4ec4eca026399d2b826ef7243601d25c327a59921a7b92372876959e4","01a07799c3d6280d69204249a33ebe4bf7fa3b926a10cc57cc1f23890322ed88","c6c0a10f7db1fb54955d5b5899d7aaeffa1d8ef9caf4de1508e2f281656fe485","2f6790363f737a1c306e229085355a9552736e48f51480d276d5994400f4af09","30a56fd5e2ef510560b394b5b5731ff5d0528fe6c1142dda307e07f0bf2c5584","afd43818a5c8c3da089e78b3ddf0c0129b22c1e91a199836ec1afa1399ea79a8","4409ea487da80346ff46cc43922e72d0a8d74106913874f370c2ea6d1e66f6d5","e148c80080b3dae1300d033ccb2230619c61553674a1b2672f9ef97b837d94c5","b8cc7add96b199c3718589651e724b7886bcbd9e74ec3128148385f10a7a3343","badbdfdd83477d58fb5ce2b574be6184beed910b28e0796e333b0ee81f9b2599","fdff7d9b7a3504c5db7f7d06928c7fbe56d24d363185729625c9601bb3d136e2","faf9235aec43aac57ab1b5d8efdcc7b1b55b8a09eb5ca0a95f9cf0e49e8431f1","d227bf9cc7c1da6fb885165a7e0fbffae26564078213e6b40585f3f10e5c751d","61b8fcc186a3a803d5e9569143d6721c922562b7ddc23b51fcc79be16801e9c3","8ba170332e7866735f36d02341c5bfb557a59927a8fbfb92c744e4ed2608c464","1181957d10133ceb1cda91e69c06b83f0a879ad3afde3c71afd2721791318725","8e2f2c8b187219e3b48ef17337262f059dba1d60352f3b60ca557bd4390b1602","b6c551c5e7690427a3ff64e2ef960c0d2ec237fc53ecc8990b668eff6e261508"],"paragraph_range_zero_based":[35136,35159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35136"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35160},{"literal_text_all_w_t_and_m_t":"–SSB-ToMeasure","paragraph_zero_based":35161},{"literal_text_all_w_t_and_m_t":"The IE SSB-ToMeasure is used to configure a pattern of SSBs. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":35162},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure information element","paragraph_zero_based":35163},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35164},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-START","paragraph_zero_based":35165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35166},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure ::=                   CHOICE {","paragraph_zero_based":35167},{"literal_text_all_w_t_and_m_t":"    shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":35168},{"literal_text_all_w_t_and_m_t":"    mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":35169},{"literal_text_all_w_t_and_m_t":"    longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":35170},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35172},{"literal_text_all_w_t_and_m_t":"-- TAG-SSB-TOMEASURE-STOP","paragraph_zero_based":35173},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35175},{"literal_text_all_w_t_and_m_t":"SSB-ToMeasure field descriptions","paragraph_zero_based":35176},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":35177},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to (k– 1) may be transmitted; if the k-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted.","paragraph_zero_based":35178},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":35179},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access, if the k-th bit is set to 1, the UE assumes that one or more SS/PBCH blocks within the SMTC measurement duration with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL-Common and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. If ssb-PositionQCL is configured with a value smaller than ssb-PositionQCL-Common, only the leftmost K bits (K = ssb-PositionQCL) are applicable for the corresponding cell.","paragraph_zero_based":35180},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":35181},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":35182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0a0b444193a56e3c3cfe311a8f24c1062fff19dfe055b74a0e66310718e9d480","92d848cde8eaac9b669abc1eec82079798307d30b869e627de808a7088fac082","a79c47e655c9fda728ddc60b9b199b792144cb3be25a92e136c56fdc498d1f60","878c1a4eac3dc581355fe0a6787b662e6038c351c16525cc8a7424a7a0149293","4f09f8bc69aff5d1253387f96c6969d5ae10ad41f53dcfcd144865b6ca1df901","bc726a4270a50d51826e3528efe619d21066cca2baf2a8c623da901f596ebf4b","06c500b2f3f0b060e55fd74b248af78838e3d0119d09ceba491f4b5a36543e54","188602663879400707369e0b995bf02cc8c722d661e7b60b838ed89e8d4022a8","1fc6a26350b9b054cb8606c76ee710291d2d74c64552f828404eff32a11fa2a6","2682785244a4f512e095ba5cbcd0085cbd62a46141e3c1c28ec128ddee7d36c2","8689dfa9d07aa7839cdad9b24cca71418d0a1df5a775a953c5c3d017a1edbec4","6916549cbb9a899a02e4dddb6032f80d1dfaa79a8a54e4379c31a80c511e0f66","9268d040aa9bba98d6c4c623c7677265ea9ee9a8d43f96d69edbf57e3ad9d670","1dd50e1088701419a6820c58e0db92343bb5337e450321e740a6917ecae37d26","3825239cc22fe55126c0f2ed5a65964fbc046f6a0cc7e7518b12338631f0343d","1fb6eeb656f21e62fdcca3c2b5b1bc20d3bda8a3f80fd44c1b1ba48875c12f4f","abc25666392ee07890bcbb626dbf87f25a1527f74df4659c21cc39b1e4407696","8af71b659fe247bf419ec320d03961c27587e5cec7526d5a9f0a402974f848ee","96815d96e6f016644362ee7120a75f128e19d4f06833b35448d4573056d2f456","9f90afb6dd1ac286bfb79341e94b85a4cce03d166a925d334aa57dd42523853d","0d571669485e491edbd780cb15cbf678b0faa1621387ea06519cf26bfe2b6c03","f635e3c31c28054a2e6987fb2749c5213c62a99f93b3b4fbe917e8cf04c6e5b2","e7cf623a8e6c16f169fdcd7c4eb19dd2627624fdade6b7ce5b8f71bb478cb46d","dd9bd9177a05426ab4b2af8f03f5b7d1b107c72d7ac07b862eb653c1588fe6c2"],"paragraph_range_zero_based":[35160,35183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35160"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SS-RSSI-Measurement","paragraph_zero_based":35184},{"literal_text_all_w_t_and_m_t":"The IE SS-RSSI-Measurement is used to configure RSSI measurements based on synchronization reference signals.","paragraph_zero_based":35185},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement information element","paragraph_zero_based":35186},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35187},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-START","paragraph_zero_based":35188},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35189},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement ::=             SEQUENCE {","paragraph_zero_based":35190},{"literal_text_all_w_t_and_m_t":"    measurementSlots                    BIT STRING (SIZE (1..80)),","paragraph_zero_based":35191},{"literal_text_all_w_t_and_m_t":"    endSymbol                           INTEGER(0..3)","paragraph_zero_based":35192},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35194},{"literal_text_all_w_t_and_m_t":"-- TAG-SS-RSSI-MEASUREMENT-STOP","paragraph_zero_based":35195},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35197},{"literal_text_all_w_t_and_m_t":"SS-RSSI-Measurement field descriptions","paragraph_zero_based":35198},{"literal_text_all_w_t_and_m_t":"endSymbol","paragraph_zero_based":35199},{"literal_text_all_w_t_and_m_t":"Within a slot that is configured for RSSI measurements (see measurementSlots) the UE measures the RSSI from symbol 0 to symbol endSymbol. This field identifies the entry in Table 5.1.3-1 in TS 38.215 [9], which determines the actual end symbol.","paragraph_zero_based":35200},{"literal_text_all_w_t_and_m_t":"measurementSlots","paragraph_zero_based":35201},{"literal_text_all_w_t_and_m_t":"Indicates the slots in which the UE can perform RSSI measurements. The length of the BIT STRING is equal to the number of slots in the configured SMTC window (determined by the duration and by the subcarrierSpacing). The first (left-most / most significant) bit in the bitmap corresponds to the first slot in the SMTC window, the second bit in the bitmap corresponds to the second slot in the SMTC window, and so on. The UE measures in slots for which the corresponding bit in the bitmap is set to 1. In case this field is configured for a SCell with ca-SlotOffset-r16, the bits in the bitmap corresponds to the slots that are fully contained in the SMTC window.","paragraph_zero_based":35202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35203},{"literal_text_all_w_t_and_m_t":"–SubcarrierSpacing","paragraph_zero_based":35204},{"literal_text_all_w_t_and_m_t":"The IE SubcarrierSpacing determines the subcarrier spacing. Restrictions applicable for certain frequencies, channels or signals are clarified in the fields that use this IE.","paragraph_zero_based":35205},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing information element","paragraph_zero_based":35206},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["adbe0e9f259ca0c44d671c13d32ff5a1f70b1ae7e97ec6c8f46f4401f5f229af","059c7de5a300fd38276127bf28dd02451fbf68ce7312938402fa723d369ba9d5","672d0fc499fb9ada18deabb414a787956bc96ab55b319330738cef900b12f70a","f2b9cdbb880b13dc28ab07a4b6748f1da1b155da05d493cb72cc9b69cfb9ae36","bad56e876599dd791d34d9435902fa15e1202a9a3c594b56035e03e9024718ce","1c38e1ce4666ee8f16e9de23ced53d8b84903bd3fdab879270fdf3c5b962411c","2105602593a2e3f4543dbc40080c92dfdcf4c72f9f083120c65dfc4877ec6544","7eb27ab5fa7e6cc41d1606c94de9c8dcd1ac2bc4fa8e665cf7ea682424a0ab82","f41981dfbb8446ad536e4cfb0f96f74761a5d1933694cc9ee1a97cd3b5722f1c","67849c5d6619b5c88df3cfc7e8f53cbaa6c5144a5742d4561d2f7514eca22e3c","1555fd61faea41b1727a649908e49ffdf90de0549d2fdebfedfc102a7469bfda","3bf5c9ec83265802838ba6c65f4d47d7f3a1b5a4600249fa43aeee321f15beb0","84573f3a88ae49366e55fb704849d734395f93d46c6b5c64db8e0ab75ea77aa9","c39e351e5567ec0781687ffcb3c0eff44e27b447e91ccbeba4595fe5dff49de5","90f641dcf5b2456da2d6b87dc2bfdab6fdbe0e14f10c76ddd1f27b8684c757e1","9af7356af7f2818b0e97a4d40449e7492c1829e41a544dbbfd01bf83dd434ee3","7b757df6965efe03e9d55de67557001efe9bff0b62d4ea9a159035ff27a2d935","5fa4c185b7cb7de137e53216afdecb63f9e381d6374634aaa5e001eff5d10702","0aae3842984c8cf382799d6199895e43d215d5f5ef0b5cdd2c29e2e6b0426f1f","f631ae95ae42920b9a1d2143df6106c34557b2c469d534c774dc8eea7fc4061a","30fc96fb78f964650390a48d7cee57091cdb207fb0a85ccf3bfd46141f0f76d0","d5cafc5931855e1378937832792cf60cdef3ee8d4e973b79f1367d65386afbf3","189831f7600112db27c29d0d29d2e18c89ab0badc06892e30a92d07cf25d527a","c77f5ad8be486c48d3d5d951e19d1f048c1d61fcef94a2199ef5c1058c705c51"],"paragraph_range_zero_based":[35184,35207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35184"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-START","paragraph_zero_based":35208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35209},{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing ::=               ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, kHz480-v1700, kHz960-v1700, spare1}","paragraph_zero_based":35210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35211},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-STOP","paragraph_zero_based":35212},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35214},{"literal_text_all_w_t_and_m_t":"–TAG-Config","paragraph_zero_based":35215},{"literal_text_all_w_t_and_m_t":"The IE TAG-Config is used to configure parameters for a time-alignment group.","paragraph_zero_based":35216},{"literal_text_all_w_t_and_m_t":"TAG-Config information element","paragraph_zero_based":35217},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35218},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-START","paragraph_zero_based":35219},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35220},{"literal_text_all_w_t_and_m_t":"TAG-Config ::=                      SEQUENCE {","paragraph_zero_based":35221},{"literal_text_all_w_t_and_m_t":"    tag-ToReleaseList                   SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG-Id                          OPTIONAL,   -- Need N","paragraph_zero_based":35222},{"literal_text_all_w_t_and_m_t":"    tag-ToAddModList                    SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG                             OPTIONAL    -- Need N","paragraph_zero_based":35223},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35224},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35225},{"literal_text_all_w_t_and_m_t":"TAG ::=                             SEQUENCE {","paragraph_zero_based":35226},{"literal_text_all_w_t_and_m_t":"    tag-Id                              TAG-Id,","paragraph_zero_based":35227},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimer                  TimeAlignmentTimer,","paragraph_zero_based":35228},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35229},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1ab5fb34a94de482d027e8a35e74add2f9d9ef2f3aa0cb2cb06f37ac4036199e","dba00b21a63fc318109be9d76b9a9605f878c0ac785f88cfc35ec9a31d96d3eb","dc92ae5fee2f072e5611ed809609be5093a7c1af13e4de961ada2d5dca51b07e","1cc320d45b6bab102aa9d009e05250ad77d33d4edc6c33ddb91e1ca5a21bfb60","815ebb999a9031b7747783e3cb197d6258692ffdc9c8b5295fc8e119bfd542d6","afb2329fca7b7f4f665b0a64f9b0116a04713377ac2187b914314bafa9866ad2","e7395c229d1daee94a11c4f91c97d902f868179088a886cee0fd276d169bee20","88bb234e74503a54978f056efabd33ddc5139bc27c3819b863a3f9e1b7cd46d9","579543a8bb9cefa60031e2bd3db058ce95c4f9ff4556c17088986abfbfe6dc6a","dc2b950ca578f11327ad648f5248306840e124a96116398a2fc95611f0eea8f4","8b0624d3865aebc5f413e62018165453fa1b13f18f487a526c3d419daa2397f7","9f590561c500b3f1c16fd8fb4c6a358f4bc43ffaa4f94eebbad4a5737e4434d7","918c1a185d4a9e272dedb651aff6ffb54e0da3c4d21d685840728e2980aa0bbb","dba70db3dde149d7808e1ba4ccd89a93b66074998598dc480e34c9fd5efc4243","3e393fdafa1af50747e24d502117ccdc4eb8fa15df713455e8e54bf6c4eb5074","57529022e4889211f8690d4c656c8cc8e4ff8f1742a1465f76485befae6241fc","cdc6cdcbb16fce814d8c1c45e6e2d8d904b6db48392057dd6a37478