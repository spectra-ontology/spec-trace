{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within nr-NS-PmaxList or nr-NS-PmaxListAerial:","paragraph_zero_based":1008},{"literal_text_all_w_t_and_m_t":"7>apply the additionalPmax;","paragraph_zero_based":1009},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":1010},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":1011},{"literal_text_all_w_t_and_m_t":"6>if frequencyBandListSUL is present in SIB4 and, for the frequency band selected in frequencyBandListSUL, the UE supports at least one additionalSpectrumEmission in the nr-NS-PmaxList within FrequencyBandListSUL:","paragraph_zero_based":1012},{"literal_text_all_w_t_and_m_t":"7>apply the first listed additionalSpectrumEmission which it supports among the values included in nr-NS-PmaxList within frequencyBandListSUL;","paragraph_zero_based":1013},{"literal_text_all_w_t_and_m_t":"7>if the additionalPmax is present in the same entry of the selected additionalSpectrumEmission within nr-NS-PmaxList:","paragraph_zero_based":1014},{"literal_text_all_w_t_and_m_t":"8>apply the additionalPmax;","paragraph_zero_based":1015},{"literal_text_all_w_t_and_m_t":"7>else:","paragraph_zero_based":1016},{"literal_text_all_w_t_and_m_t":"8>apply the p-Max;","paragraph_zero_based":1017},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":1018},{"literal_text_all_w_t_and_m_t":"7>apply the p-Max;","paragraph_zero_based":1019},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":1020},{"literal_text_all_w_t_and_m_t":"6>apply the p-Max;","paragraph_zero_based":1021},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or RRC_INACTIVE, and T331 is running:","paragraph_zero_based":1022},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.1a;","paragraph_zero_based":1023},{"literal_text_all_w_t_and_m_t":"5.2.2.4.6Actions upon reception of SIB5","paragraph_zero_based":1024},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of this SIB5 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/ or within the corresponding field descriptions.","paragraph_zero_based":1025},{"literal_text_all_w_t_and_m_t":"5.2.2.4.7Actions upon reception of SIB6","paragraph_zero_based":1026},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB6 the UE shall:","paragraph_zero_based":1027},{"literal_text_all_w_t_and_m_t":"1>forward the received warningType, messageIdentifier and serialNumber to upper layers;","paragraph_zero_based":1028},{"literal_text_all_w_t_and_m_t":"5.2.2.4.8Actions upon reception of SIB7","paragraph_zero_based":1029},{"literal_text_all_w_t_and_m_t":"Upon receiving the SIB7 the UE shall:","paragraph_zero_based":1030},{"literal_text_all_w_t_and_m_t":"1>if there is no current value for messageIdentifier and serialNumber for SIB7; or","paragraph_zero_based":1031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be4bdd359932f66c3f2b3e660e77e59a07aebb983cd4d1148f457e8b212fbc1e","aa887547b657ec69ce8d4df0b895b4b3e2f7bb2022c9d9805ac213a681bba6e9","078f34aae1bb3c4db83ee2dfa0c0e08ed7556e417d3142f79c0f3b40910246b3","51c0db234f70051e5073d23a121728af4a393a9bbaec20dafd6c974d51c943ff","cf83c0d8504a8c33b14c2a04d837258fc2ce22ad96cc29cf1e9529acb712714a","2d90855412164864dcb911e6f96634ce347ec5d79629530898853d7829dda652","8a9550cb2c97d70a471beb7531b5eee844a5551f9bc7ad822228d3daaf6b76fd","770797921856d51342e32c