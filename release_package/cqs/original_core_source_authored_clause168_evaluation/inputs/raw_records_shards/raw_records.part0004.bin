{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":43272},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":43273},{"literal_text_all_w_t_and_m_t":"    reportingSRB-r18                     ENUMERATED {srb4, srb5, spare2, spare1}                                    OPTIONAL, -- Need M","paragraph_zero_based":43274},{"literal_text_all_w_t_and_m_t":"    appLayerMeasPriority-r18             INTEGER (1..16)                                                            OPTIONAL, -- Need M","paragraph_zero_based":43275},{"literal_text_all_w_t_and_m_t":"    appLayerIdleInactiveConfig-r18       AppLayerIdleInactiveConfig-r18                                             OPTIONAL  -- Need M","paragraph_zero_based":43276},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":43277},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43279},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters-r17 ::=        SEQUENCE {","paragraph_zero_based":43280},{"literal_text_all_w_t_and_m_t":"    ran-VisiblePeriodicity-r17           ENUMERATED {ms120, ms240, ms480, ms640, ms1024}                            OPTIONAL, -- Need S","paragraph_zero_based":43281},{"literal_text_all_w_t_and_m_t":"    numberOfBufferLevelEntries-r17       INTEGER (1..8)                                                             OPTIONAL, -- Need R","paragraph_zero_based":43282},{"literal_text_all_w_t_and_m_t":"    reportPlayoutDelayForMediaStartup-r17 BOOLEAN                                                                   OPTIONAL, -- Need M","paragraph_zero_based":43283},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":43284},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":43285},{"literal_text_all_w_t_and_m_t":"    ran-VisibleReportingSRB-r18          ENUMERATED {srb4, srb5, spare2, spare1}                                    OPTIONAL  -- Need M","paragraph_zero_based":43286},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":43287},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43289},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-STOP","paragraph_zero_based":43290},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43292},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig field descriptions","paragraph_zero_based":43293},{"literal_text_all_w_t_and_m_t":"appLayerMeasPriority","paragraph_zero_based":43294},{"literal_text_all_w_t_and_m_t":"The field indicates the priority of the application layer measurement configuration, where a higher value indicates lower priority. If the field is not configured, the application layer measurement configuration has the lowest priority.","paragraph_zero_based":43295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8bf8dcdeb9a073fd6ec0e2b9b596d16d4ccbc3bfd6102e97e310783de883eb47","27ec209ce93340e4dd47bfec95532cb42449b84e2029a1c43b599676d02de762","252e286c92eb0224fb4c2ed451f5d4dea8c4cb502d4ccbff8eb8412b1c203f66","1cd2a1f8d07c3c6152761d7e8117af12e834d9062cb8bc9f1fdca1c457c68197","0ce683d71c36aeeb35ef91f5be15cb8ece3cd39572518154e9dcf26ee9f71f44","89a0e2b9688ba87a8146cf8d401dd6382ef18343e2b45af719a22f54e53ba366","22b401f0b27a9cb1ad22e053814f9f40ce873792eb85d6a16b4f2e0465fe0925","ff5b495d2c54611484b5a0ff542a8b4033208bbe788de8c5e77b766a5c952604","4dd5111d00a08553643bb80886ef916c80a565579e7d6cf88beeaa8b2a794f60","791792787e9451457ba28ed4465a10cdfcf33352dd11d583a8ce628cd19dfc36","215d9c342fafa9addaa7d01e3ead7f199824d1258aeecb4f73d9da430cb7ab52","4db0d8397c567f2a18906637d8c57af0fe5f843f12e679550b52d696c88d0362","04ab0ae4ff4047902675b90569487142ad7a314d056e795d405d97f9404682fe","c3f241c29142eb122a77875cbda60f33806f685163d8e3e83ea2be6898fa7247","8c6102ff2ae6722c8597bff9a1326e08fe171b5c6f4433bdfd9ae9c08ec11fbe","2f77bcaba0454181305d6bd194430a864c715ab680c08a3ddb3d4ee3ed0586cf","0e9589c2347b4c68223f28a8d9b9a5d914134f192923bd903fcc48ccb5758d26","ab5cb5af0097cee70bcfbbde157b507c90c0891c17d950386791fea65bb8a754","07f6a659d2e13b62202edc5e35732e92a21cb1c23b747299d57c45b2dff62b58","6ddb9c4da00413d572daa916bf810217c16c0763013c9cbfa3985377441e29ed","336d81ad6fa0ab2f02b93967765b8e3235ee0d46d8a9dd6737b142704f996a2d","f5aead3f602d0d5e5500b250da297f4534a7acec513c56e86e3ccb2268e43e9a","6477524fbdd3c01383bdfacedc76e5de1c6d84d9d05f68666286e740f49ba03e","4fd1bd3c7e255615955478130d00badfc7564a72603e4413ad73362e3daf83ca"],"paragraph_range_zero_based":[43272,43295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p43272"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"idleInactiveReportAllowed","paragraph_zero_based":43296},{"literal_text_all_w_t_and_m_t":"The field indicates whether transmission of application layer measurement reports collected in RRC_IDLE and/or RRC_INACTIVE is allowed and if transmission of application layer measurement configurations applicable to RRC_IDLE and/or RRC_INACTIVE is allowed. If fhe field is not configured, transmission of application layer measurement reports and/or configurations for RRC_IDLE/RRC_INACTIVE are not allowed.","paragraph_zero_based":43297},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerContainer","paragraph_zero_based":43298},{"literal_text_all_w_t_and_m_t":"The field contains configuration of application layer measurements, see Annex L (normative) in TS 26.247 [68], clause 16.5 in TS 26.114 [69] and TS 26.118 [70].","paragraph_zero_based":43299},{"literal_text_all_w_t_and_m_t":"measConfigAppLayerId","paragraph_zero_based":43300},{"literal_text_all_w_t_and_m_t":"The field contains the identity of the application layer measurements. When application layer measurements are configured for an SCG, the measConfigAppLayerId is obtained according to TS 38.423 [37], clauses 8.3.1 and 8.3.3.","paragraph_zero_based":43301},{"literal_text_all_w_t_and_m_t":"pauseReporting","paragraph_zero_based":43302},{"literal_text_all_w_t_and_m_t":"The field indicates whether the transmission of measReportAppLayerContainer is paused or not. Value true indicates the transmission of measReportAppLayerContainer is paused; value false indicates the transmission of measReportAppLayerContainer is not paused.","paragraph_zero_based":43303},{"literal_text_all_w_t_and_m_t":"ran-VisibleParameters","paragraph_zero_based":43304},{"literal_text_all_w_t_and_m_t":"The field indicates whether RAN visible application layer measurements shall be reported or not.","paragraph_zero_based":43305},{"literal_text_all_w_t_and_m_t":"ran-VisibleReportingSRB","paragraph_zero_based":43306},{"literal_text_all_w_t_and_m_t":"The field indicates the SRB to be used for transmission of RAN visible application layer measurement reports.","paragraph_zero_based":43307},{"literal_text_all_w_t_and_m_t":"reportingSRB","paragraph_zero_based":43308},{"literal_text_all_w_t_and_m_t":"The field indicates the SRB to be used for transmission of encapsulated application layer measurement reports. If application layer measurement reports are received and the configured SRB is not available, the UE stores the reports until the SRB is available or the QoE configuration is released.","paragraph_zero_based":43309},{"literal_text_all_w_t_and_m_t":"rrc-SegAllowedSRB4","paragraph_zero_based":43310},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled on SRB4. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message.","paragraph_zero_based":43311},{"literal_text_all_w_t_and_m_t":"rrc-SegAllowedSRB5","paragraph_zero_based":43312},{"literal_text_all_w_t_and_m_t":"This field indicates that RRC segmentation of MeasurementReportAppLayer is enabled on SRB5. The field is configured for an SCG. It may be present only if the UE supports RRC segmentation of the MeasurementReportAppLayer message.","paragraph_zero_based":43313},{"literal_text_all_w_t_and_m_t":"serviceType","paragraph_zero_based":43314},{"literal_text_all_w_t_and_m_t":"Indicates the type of application layer measurement. Value streaming indicates Quality of Experience Measurement Collection for streaming services (see TS 26.247 [68]), value mtsi indicates Quality of Experience Measurement Collection for MTSI (see TS 26.114 [69]) and value vr indicates Quality of Experience Measurement Collection for VR service (see TS 26.118 [70]). The network always configures serviceType when application layer measurements are initially configured and at fullConfig.","paragraph_zero_based":43315},{"literal_text_all_w_t_and_m_t":"transmissionOfSessionStartStop","paragraph_zero_based":43316},{"literal_text_all_w_t_and_m_t":"Value true indicates that the UE shall transmit indications when the measurement session in the application layer starts and stops. Value false indicates that the UE shall not transmit any session status indications. The UE transmits a session start indication upon configuration of this field set to value true if a session already has started in the application layer.","paragraph_zero_based":43317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43318},{"literal_text_all_w_t_and_m_t":"RAN-VisibleParameters field descriptions","paragraph_zero_based":43319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d1a32bfb1b85939468aefe87cb0dcf3e33fe646129f55ba2256c3ddeaacd5023","957af2b9b3e947e529bf6455f4737d1de3986186c0f03101da695ee86848e627","9dab108c718efd34115e2702e6215f0f1a31c97fc28e5c007b03745d225233bb","443bdcff1786e97c4349d02b7e8782e66ff14a63b9c0d783268abb8c72251d54","a6ed9a7dfe2830d3437ddba48fb0f68248c320ec5867a92b025a560eed6119e8","ee15d23779cb846fa8cbfa64f7423c62867212d3f0cdb4179f571846acfc1563","bebb89fb057f53c437c140d13a4cdc76d52b47a628b0f960daa98a95f2448ba8","5e9eb7de7cdd7d23fda7e6f0e53688e34aa57c840cce5606c4cad79a336f56a0","3c0e7888c3af647fce2b0c5fc57d12988e1f47248fe84d1af5dd5d995a66ada6","ca162e75c54aa2f1db12df7892d5654acb723cd4ac6ae773499c38edc3790711","776a714f3b613f3c1213bb7c84a4a2a68b24ade9f4331f04e3aad69e66ab6a69","1883496c7b165346b3244467d90ac7e67cef789c1d3e6442ef650e563e710350","e757a5bdab0ca59309ad059122feea519a45a0184138089dcf0d1b34b713b8c2","75946234a571c0261bea2bb0f0e1399c4201bc45a1d566e073086361db9fb53e","7525278e4b9bfdcd1a3fbc979b2e8f426cea001635ccf36f3283f3c4e2db8c68","c958c84b225dfd063b2db59232858d45d561bce33f494b80003a04702e432f36","789f4fca3107a84c7b75ced82d1f2eab0f335c66de9d53e5f3f9f1f15b049770","70b8903e4914bc61504baac3d20d53aff72f61f5cae8a80b516daee38769140a","92984defbc549c0d3297a64bf16da8c94704556bdf6010aa1c1f968795da87f1","21cfcafbebe31e5b4f96b8d8cd7f7d58fce4162266552bba565157a2ca303025","0b0126e9167536e034cbfe9d9b3220a7688acb001443cf2bcdcfd585afdf5b4e","973235e6865e154f5a7517328318750df4bb9b3ab1aa376ba22ef6196605cbdb","7f3990fe9c78c9aca55d5018921dc0f302b147ad521d76d189cea0b84ec19e5e","c1e4b8afd4086c6f0372e59ef94ad60a72f909e41dca23f1aee16640efa98345"],"paragraph_range_zero_based":[43296,43319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p43296"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"numberOfBufferLevelEntries","paragraph_zero_based":43320},{"literal_text_all_w_t_and_m_t":"The field contains the maximum number of buffer level entries that can be reported for RAN visible application layer measurements. This field is also used by application layer to calculate the interval of RAN visible buffer level measurement, which is equal to the periodicity of RAN visible application layer measurements reporting divided by numberOfBufferLevelEntries.","paragraph_zero_based":43321},{"literal_text_all_w_t_and_m_t":"ran-VisiblePeriodicity","paragraph_zero_based":43322},{"literal_text_all_w_t_and_m_t":"The field indicates the periodicity of RAN visible application layer measurements reporting. Value ms120 indicates 120 ms, value ms240 indicates 240 ms and so on. If this field is absent, the periodicity of RAN visible application layer measurements reporting is the same as the reporting periodicity indicated in measConfigAppLayerContainer.","paragraph_zero_based":43323},{"literal_text_all_w_t_and_m_t":"reportPlayoutDelayForMediaStartup","paragraph_zero_based":43324},{"literal_text_all_w_t_and_m_t":"The field indicates whether the UE shall report Playout Delay for Media Startup for RAN visible application layer measurements.","paragraph_zero_based":43325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43327},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":43328},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":43329},{"literal_text_all_w_t_and_m_t":"ServiceType","paragraph_zero_based":43330},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, when serviceType is set to streaming or vr. Otherwise, it is absent.","paragraph_zero_based":43331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43332},{"literal_text_all_w_t_and_m_t":"–AreaConfiguration","paragraph_zero_based":43333},{"literal_text_all_w_t_and_m_t":"The AreaConfiguration indicates area for which UE is requested to perform measurement logging. If not configured, measurement logging is not restricted to specific cells or tracking areas but applies as long as the RPLMN is contained in plmn-IdentityList stored in VarLogMeasReport.","paragraph_zero_based":43334},{"literal_text_all_w_t_and_m_t":"AreaConfiguration information element","paragraph_zero_based":43335},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43336},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-START","paragraph_zero_based":43337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43338},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r16 ::=        SEQUENCE {","paragraph_zero_based":43339},{"literal_text_all_w_t_and_m_t":"    areaConfig-r16                   AreaConfig-r16,","paragraph_zero_based":43340},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r16          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":43341},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43342},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5439aed99a6b78c29ba405c66a23b3b5251667d0a0c561dbc67beb0e982f026b","75487705235ef555dee79f40f8fa96e373b5e1c70890d0c87c282b3043c03715","cee4ff8a92e37386f3be804d5163674ec9d3b61d4f68e9bba87cbead02ab630e","f48687a485ee57007138082270ac620667bd454ebe45ad988371a95facabdf