{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":50304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50305},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50307},{"literal_text_all_w_t_and_m_t":"NOTE:RRC will perform padding, if required due to the granularity of the TF signalling, as defined in 8.5.","paragraph_zero_based":50308},{"literal_text_all_w_t_and_m_t":"9.1.1.2CCCH configuration","paragraph_zero_based":50309},{"literal_text_all_w_t_and_m_t":"Parameters","paragraph_zero_based":50310},{"literal_text_all_w_t_and_m_t":"Name","paragraph_zero_based":50311},{"literal_text_all_w_t_and_m_t":"Value","paragraph_zero_based":50312},{"literal_text_all_w_t_and_m_t":"Semantics description","paragraph_zero_based":50313},{"literal_text_all_w_t_and_m_t":"Ver","paragraph_zero_based":50314},{"literal_text_all_w_t_and_m_t":"SDAP configuration","paragraph_zero_based":50315},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":50316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50318},{"literal_text_all_w_t_and_m_t":"PDCP configuration","paragraph_zero_based":50319},{"literal_text_all_w_t_and_m_t":"Not used","paragraph_zero_based":50320},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50322},{"literal_text_all_w_t_and_m_t":"RLC configuration","paragraph_zero_based":50323},{"literal_text_all_w_t_and_m_t":"TM","paragraph_zero_based":50324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50326},{"literal_text_all_w_t_and_m_t":"Logical channel configuration","paragraph_zero_based":50327}],"sourc