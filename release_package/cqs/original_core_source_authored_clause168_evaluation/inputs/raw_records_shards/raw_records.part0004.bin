{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46992},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46993},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46994},{"literal_text_all_w_t_and_m_t":"SL-U2U-RemoteUE-ToAddMod-r18 ::=    SEQUENCE {","paragraph_zero_based":46995},{"literal_text_all_w_t_and_m_t":"    sl-L2IdentityRemoteUE-r18           SL-DestinationIdentity-r16,","paragraph_zero_based":46996},{"literal_text_all_w_t_and_m_t":"    sl-SourceRemoteUE-ToAddModList-r18  SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-SourceRemoteUE-ToAddMod-r18 OPTIONAL,    -- Need N","paragraph_zero_based":46997},{"literal_text_all_w_t_and_m_t":"    sl-SourceRemoteUE-ToReleaseList-r18 SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-SourceIdentity-r17          OPTIONAL,    -- Need N","paragraph_zero_based":46998},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46999},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47001},{"literal_text_all_w_t_and_m_t":"SL-SourceRemoteUE-ToAddMod-r18 ::= SEQUENCE {","paragraph_zero_based":47002},{"literal_text_all_w_t_and_m_t":"    sl-SourceUE-Identity-r18           SL-SourceIdentity-r17,","paragraph_zero_based":47003},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigU2U-r18              SL-SRAP-ConfigU2U-r18,","paragraph_zero_based":47004},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47005},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47007},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-STOP","paragraph_zero_based":47008},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47009},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47010},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config field descriptions","paragraph_zero_based":47011},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-ToAddModList","paragraph_zero_based":47012},{"literal_text_all_w_t_and_m_t":"List of L2 U2N Remote UEs to be added and modified to the L2 U2N Relay UE.","paragraph_zero_based":47013},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-ToReleaseList","paragraph_zero_based":47014},{"literal_text_all_w_t_and_m_t":"List of L2 U2N Remote UEs to be released by the L2 U2N Relay UE.","paragraph_zero_based":47015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9412684d1356c4391b116cbdca14b261693fa1422be7b92793e5d2c53e115580","26343922627ebc933df9098958c0423a6e5ea6a39b2027680c53d501ef57ede0","fb62c5af980e93894ef459a04f01d0ad106c6aae763baf458025a3438e292e34","13ec9247374918e1b016a689ad68a1df147f7cead1b4f9585f9d18c053f63fb7","e221c2739a5b131d68e9b913a7b8247186d6d3cc87c094df81f8d38dd9b84be6","d88fe2fcab261b8d99e02259e6980139bc63fd6746979669b2b48abfa48ad81b","5002b5e1399ecdc679a1f52d4b79ced225855625e475035ff71dfd7f781e5250","1a57b421ae59df415c0535c253e3bb21e209722491d2d64c49a208ccce8132fe","11ae4fb421f9d837fab40857d17b38a09f0bd7d8746d4c63735b0f1b938afeda","9bc0a2bfd26809d2af1f13fb1fc834a391be203e458b56fdab0dd7fc8750d349","f1b1586ae15e7f16ac6111ddc5c59f87ce3a79a11308908474c1eb43f171e9b7","c74ff19237ed819c449f5e66aba3bdf8983fbac36e83d0b56f4ad6bea879bf71","10eff8a4bc555cf71472b465f2e315929a985b5996fd5e917a974d5103275c2a","017ccdc5bf17ea0b9da509a2f013faa6c58bd3af01619a0474816578299649ad","ba07053fba49fe1e33a441dffadc31e0c3d974d098033c739bfeb5970eba9682","6b0bc8b47a1320080dea99813927399b6ac3ccd40eb53b54f677d68fa1f5765