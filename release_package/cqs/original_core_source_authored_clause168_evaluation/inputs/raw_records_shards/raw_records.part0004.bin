{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":33936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33937},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33939},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination ::=           SEQUENCE {","paragraph_zero_based":33940},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinationId             SlotFormatCombinationId,","paragraph_zero_based":33941},{"literal_text_all_w_t_and_m_t":"    slotFormats                         SEQUENCE (SIZE (1..maxNrofSlotFormatsPerCombination)) OF INTEGER (0..255)","paragraph_zero_based":33942},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33943},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33944},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationId ::=         INTEGER (0..maxNrofSlotFormatCombinationsPerSet-1)","paragraph_zero_based":33945},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33946},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-STOP","paragraph_zero_based":33947},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33948},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33949},{"literal_text_all_w_t_and_m_t":"SlotFormatCombination field descriptions","paragraph_zero_based":33950},{"literal_text_all_w_t_and_m_t":"slotFormatCombinationId","paragraph_zero_based":33951},{"literal_text_all_w_t_and_m_t":"This ID is used in the DCI payload to dynamically select this SlotFormatCombination (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":33952},{"literal_text_all_w_t_and_m_t":"slotFormats","paragraph_zero_based":33953},{"literal_text_all_w_t_and_m_t":"Slot formats that occur in consecutive slots in time domain order as listed here (see TS 38.213 [13], clause 11.1.1 and TS 38.213 [13], clause 14 for IAB-MT).","paragraph_zero_based":33954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33955},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell field descriptions","paragraph_zero_based":33956},{"literal_text_all_w_t_and_m_t":"enableConfiguredUL","paragraph_zero_based":33957},{"literal_text_all_w_t_and_m_t":"If configured, the UE is allowed to transmit uplink signals/channels (SRS, PUCCH, CG-PUSCH) in the set of symbols of the slot when the UE does not detect a DCI format 2_0 providing a slot format for the set of symbols (see TS 38.213 [13], 11.1.1). This field is applicable only if cg-RetransmissionTimer-r16 is configured.","paragraph_zero_based":33958},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":33959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d27423ab074a8f9adc1aedde6c23abc9d8c6497fc8c0ad007fb8d112a95091a5","be2168e3958906e74cb89d6b313d5854ef9f29468472afa0dddc56f89f9f81e3","dc03ec7671f9dce88ec628278ad7b1f35679f0d9016105e2ca5b5923c0cc1686","a88d379e41f75862f02278485d478ede71794b3b7cceef9a71a8d87175ff56d4","e456fe69ae9a2f5071c24dbd8206f38d7d18605d148a777f18d95ec02e8228bb","857dc438414bb8ba5c9c6c0d00ab35a68029eb590be9bdec29c539ad8cdc2660","376f911d4c7c765019e16e4f43199899014f9dc79fc2635205195684ca98858d","3bb8ee2c271ce32b64cb0cbf66c28651bf4eb860edd3f6c4350b3032fe23599a","9d7316e48dad9e65b84f8fa6fad178334ca70d5c73ffdd3df398d170c73e427e","28b87248c073a974b211b1cc442289b9017daf6d6891f768daf51c8710af52c9","2d726e8308c66cd71218fbe340e2a0d691b82e9b25c437c400bdb9e634ba626e","92351bd1c74d4e6ef52beeaf5b08f08012dc009e602e8298d25805ea3f141589","ed955efa0