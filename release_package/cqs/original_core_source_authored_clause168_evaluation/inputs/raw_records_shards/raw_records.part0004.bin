{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PUCCH-TPC-CommandConfig is used to configure the UE for extracting TPC commands for PUCCH from a group-TPC messages on DCI.","paragraph_zero_based":29448},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig information element","paragraph_zero_based":29449},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29450},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-START","paragraph_zero_based":29451},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29452},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig ::=             SEQUENCE {","paragraph_zero_based":29453},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPCell                          INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-OfSpcell","paragraph_zero_based":29454},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-SCell                    INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":29455},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29456},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29457},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sSCell-r17                             INTEGER (1..15)                         OPTIONAL,  -- Need R","paragraph_zero_based":29458},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sScellSecondaryPUCCHgroup-r17          INTEGER (1..15)                         OPTIONAL   -- Cond twoPUCCHgroup","paragraph_zero_based":29459},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29460},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29462},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":29463},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29465},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig field descriptions","paragraph_zero_based":29466},{"literal_text_all_w_t_and_m_t":"tpc-IndexPCell","paragraph_zero_based":29467},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the SpCell) inside the DCI format 2-2 payload.","paragraph_zero_based":29468},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-SCell","paragraph_zero_based":29469},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the PUCCH SCell) inside the DCI format 2-2 payload.","paragraph_zero_based":29470},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-sSCell, tpc-IndexPUCCH-sSCellSecondaryPUCCHgroup","paragraph_zero_based":29471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b32603a763195f7819609dabf0919edfc961d3c73daeedc42350c0d1da9a538d","8c6d89c748e030a8e4860541e7bd94215a325c5fc657590002cf29341427f991","8f57480cd7d36c346c4483fab9da766e0903be0105cb33aaa08fac45df4e8378","a0f9700dcea7758521af345bca811fb5e060bcbbd96a6aebf465047e50061919","82b980d2bbc067f78ab313424a40890dccc26304185582e0cd918d800b51fdc6","82ec6d01d9185f8a7231d1233087e34f63e8c3c7e2efc4809145e4b367a837e2","9bd7da77431b47bc0889426d39377b98d1b18cff6e6a8ef22ce857deb18e21bd","7410ee0406fa99d4330dd0fdfd7a22f9ee0c2961853c2ea7d3c0ec74b404d7f9","0a10e1c9e0cfd9210825a60f19a710ea675b681d0aaddf52add3b43e700c2858","ec5b914ee5226d915882c9ef666171401591fc08e411e6c8a889c9bf2e0bb3d4","5fbfd0b9