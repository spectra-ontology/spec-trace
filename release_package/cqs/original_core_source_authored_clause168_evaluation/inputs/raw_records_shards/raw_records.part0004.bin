tTree_utf8_XML_sha256":["acc31bcecc2d8758cd64cb7b49a9f8c7c0c4952eb19bf6d09706860527a30dc5","049a0501c841060165974f7ae9f1cffcb5be86d7c87ad82effdc97b37647d178","37017646a24d37b4b7952e8e4bbe2ef6c6058a0bbed6975b9c213de31b93a9cd","f2d11840d438365903849ae6a0edf6508451cf1e70529cb6fb829fe74622a594","c1cf9049260ae6c5add723fa6b62b829d91e9e4df37abb852628e1acfbfc7241","9061b1b11107bc45b63a391e3dcc525a56f2b4ff16fdccc7ab7eb7fb49199414","448a43021d70a42a8e06fc1b0df159640d5b671ccfc870d14b2b1cb6b6c3438d","89af4f5d9438e0720aa259139b3307b4653080ea470c738db1f054c7b1cbdcdb","42fab0e7d420dc1c37cd865c12f04d808d3ff84f8aa0b5ccda79279dc6d88a85","a78907a656a43f920d52c63f4fa79497a7eb55b5586db1269386d223d28df99d","aedb9d17e6899192060b8104523b39d9685cc41c902e790ade6a2031d65a6398","50b72650276c442f98b761d94b8e03a21b88ee79d767272da798fc4011118157","07253007db918493d2104b14ed425cdaba7709f2f8e4575bc3846e597492c21e","1f984187dbc5412f3784de689a672a301a4304904c0f1f1b6c048c3fa211dfc1","ab308cf22586fbd147a3e511817cb0072131f98a950200af3565247f979d43eb","2a98f3228b4c9dc78c5501c4587a5062e2ff45cb5cf0b5bd47c8a30720314ff9","a87c8067f1520bc1ae649e99b85df4fe65173173df25a85a9ea615b3a803cb9c","4660b98b303ca27db42787d96acec64c158caf2f8c7133cf5433a67f5f632908","d3c78414b67c53f9863ca4d9ea742517dac9a8b8849d9a868ada8aa6389d8690","7ad24ccf0ffeacea763fb1e9acb1e26cb1ef06c3b9e266d02679ba09a9ab0470","7394f61f549dcaa395160b2c40941727a48b8fa25be2335985dc1b9176d62a1d","6d1325837d90fc009383c3e3a0745a52d68eb6e782e51a762bf478e1426dba72","27dd318cc026863d5af178c633d62979f74cbfbc7e2b43cc6abad3d1fcaf6503","77ae2dfe7934d10dac6a7de14e02f34d72dcb50d68205d62a0b097b754418c76"],"paragraph_range_zero_based":[34584,34607],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34584"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34608},{"literal_text_all_w_t_and_m_t":"SPS-Config field descriptions","paragraph_zero_based":34609},{"literal_text_all_w_t_and_m_t":"harq-CodebookID","paragraph_zero_based":34610},{"literal_text_all_w_t_and_m_t":"Indicates the HARQ-ACK codebook index for the corresponding HARQ-ACK codebook for SPS PDSCH and ACK for SPS PDSCH release.","paragraph_zero_based":34611},{"literal_text_all_w_t_and_m_t":"harq-ProcID-Offset","paragraph_zero_based":34612},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process IDs, see TS 38.321 [3], clause 5.3.1.","paragraph_zero_based":34613},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":34614},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table the UE shall use for DL SPS (see TS 38.214 [19],clause 5.1.3.1. If present, the UE shall use the MCS table of low-SE 64QAM table indicated in Table 5.1.3.1-3 of TS 38.214 [19]. If this field is absent and field mcs-table in PDSCH-Config is set to 'qam256' and the activating DCI is of format 1_1, the UE applies the 256QAM table indicated in Table 5.1.3.1-2 of TS 38.214 [19]. If this field is absent and the field mcs-Table-r17 in PDSCH-Config is set to 'qam1024' and the activating DCI is format 1_1, the UE applies the 1024QAM table indicated in Table 5.1.3.1-4 of TS 38.214 [19]. Otherwise, the UE applies the non-low-SE 64QAM table indicated in Table 5.1.3.1-1 of TS 38.214 [19].","paragraph_zero_based":34615},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN","paragraph_zero_based":34616},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH for DL SPS. The network configures the resource either as format0 or format1. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":34617},{"literal_text_all_w_t_and_m_t":"n1PUCCH-AN-PUCCHsSCell","paragraph_zero_based":34618},{"literal_text_all_w_t_and_m_t":"HARQ resource for PUCCH on PUCCH switching SCell (sSCell) for DL SPS. The network configures the resource either as format 0 or format 1. The actual PUCCH-Resource is configured in PUCCH-Config of the PUCCH sSCell and referred to by its ID. See TS 38.213 [13], clause 9.2.3.","paragraph_zero_based":34619},{"literal_text_all_w_t_and_m_t":"nrofHARQ-Processes","paragraph_zero_based":34620},{"literal_text_all_w_t_and_m_t":"Number of configured HARQ processes for SPS DL (see TS 38.321 [3], clause 5.8.1). If UE is configured with nrofHARQ-Processes-v1710 UE shall ignore nrofHARQ-Processes (without suffix).","paragraph_zero_based":34621},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":34622},{"literal_text_all_w_t_and_m_t":"Number of repetitions for SPS PDSCH (see TS 38.214 [19], clause 5.1.2.1). When the field is absent, the UE applies the value 1 for MBS multicast data and the pdsch-AggregationFactor in pdsch-Config for other data.","paragraph_zero_based":34623},{"literal_text_all_w_t_and_m_t":"periodicity","paragraph_zero_based":34624},{"literal_text_all_w_t_and_m_t":"Periodicity for DL SPS (see TS 38.214 [19] and TS 38.321 [3], clause 5.8.1).","paragraph_zero_based":34625},{"literal_text_all_w_t_and_m_t":"periodicityExt","paragraph_zero_based":34626},{"literal_text_all_w_t_and_m_t":"This field is used to calculate the periodicity for DL SPS (see TS 38.214 [19] and see TS 38.321 [3], clause 5.8.1). If this field is present, the field periodicity is ignored.","paragraph_zero_based":34627},{"literal_text_all_w_t_and_m_t":"The following periodicities are supported depending on the configured subcarrier spacing [ms]:","paragraph_zero_based":34628},{"literal_text_all_w_t_and_m_t":"15 kHz:periodicityExt, where periodicityExt has a value between 1 and 640.","paragraph_zero_based":34629},{"literal_text_all_w_t_and_m_t":"30 kHz:0.5 x periodicityExt, where periodicityExt has a value between 1 and 1280.","paragraph_zero_based":34630},{"literal_text_all_w_t_and_m_t":"60 kHz with normal CP.0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":34631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bb5e64734e9fd21d29ce82bdcff61bf581b7893321a4e8162b9e45a6c507bb5a","aacd01eed9503e4b3dc30c9fe38d258bd39d4db01a8710e5a260ed8070fb37a9","952aabda6471f469de75a8b20da87c4eb8c245c7cef2f547d81f273514552114","6226ff7f3f1393fc098fa5caf212ca6111158551fb9e4acda1d10a6737aa7c7d","441e303d101f455e4dd82fc47e60f80cbd1a802b224f7427d03f00808b188c82","78bad4eba37acc987bbdd7d5d0be524a416283ee523ea219f87031457ec3462c","994cd47bdf98e35bd08ae3bc76c911e121bccc4b2734ac3ba61e85a5ca6e5075","7f957652643df24eb2a8502704dcc563922bdf9d8f6a72761bdefd23160e3341","f3b924a8bafb8f3ecf9a01e5537e87d9be9c56960a917d25bb0b1e08fdf0fbdb","c854bc9e7c6d5aa5c58b9ae538141584c4854f83eb1d57031bb439d57412c358","cfb59638ca13090b5d418b60b5947aec00f7cd1dacf28d91c2257e6e630c3902","c5292ba1fa673d8daec27d89eb1e1846a59a6e7ab2e18753aae07e6b5daddbb7","444ffda297edf445540579bfba6ebc682b75eca199b077443f5d090469a1b5dc","1e01e1f082e760dd731905d5675ba410538b961a34d98420fae95da65089939d","ee653a214deb194655a880faaa3ad4191fafe28d09f6aef63df49789bad5e1e9","7ef8064b263db21473a0c137a13b4394df06237f7323b7f4f29aa6e5e4cbe96b","02446e587b66cc7c5418cab01a4e2d345bfb0dcac01b0a1dc69d9acf46c36cd2","fa866801ea11aeb8a9954e3d2cc7f05b331b6ca4801210fa8b31c4862f165498","054969ccfa2765ec2aa50346cffc3f26c077c45fc440fef37da54223cf5005dc","6ae0a8fb87e96c0367063ef5a9cd71714ef3167d5ebd7a1bbae957b08f2444aa","10442137b2fb55696425a1a6c7873f2c5a11796f896d105060bb9a4baf98d744","ac87f3bba79056f6586a9cb6e0b2a5ebb7d16da55448e8c67d4c8d16c6cd9ab8","3ec86d0fbd964b6d61a064c72483bfa6eb9ebbdf5fc49ed052129e6552b1a0d6","7ef4537bd12600834d45c65e34605129fc013c0e064b51bdd954c07b9b967b64"],"paragraph_range_zero_based":[34608,34631],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34608"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"60 kHz with ECP:0.25 x periodicityExt, where periodicityExt has a value between 1 and 2560.","paragraph_zero_based":34632},{"literal_text_all_w_t_and_m_t":"120 kHz:0.125 x periodicityExt, where periodicityExt has a value between 1 and 5120.","paragraph_zero_based":34633},{"literal_text_all_w_t_and_m_t":"480 kHz:0.03125 x periodicityExt, where periodicityExt has a value between 1 and 20480.","paragraph_zero_based":34634},{"literal_text_all_w_t_and_m_t":"960 kHz:0.015625 x periodicityExt, where periodicityExt has a value between 1 and 40960.","paragraph_zero_based":34635},{"literal_text_all_w_t_and_m_t":"periodicityExt-r17 is only applicable for SCS 480 kHz and 960 kHz.","paragraph_zero_based":34636},{"literal_text_all_w_t_and_m_t":"sps-ConfigIndex","paragraph_zero_based":34637},{"literal_text_all_w_t_and_m_t":"Indicates the index of one of multiple SPS configurations.","paragraph_zero_based":34638},{"literal_text_all_w_t_and_m_t":"sps-HARQ-Deferral","paragraph_zero_based":34639},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of slots or subslots the transmission of DL SPS HARQ-ACK in a slot or subslot can be deferred (see TS 38.213 [13], clause 9.2.5.4).","paragraph_zero_based":34640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34641},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":34642},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34643},{"literal_text_all_w_t_and_m_t":"SPS-List","paragraph_zero_based":34644},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when included in sps-ConfigToAddModList-r16 or sps-ConfigMulticastToAddModList-r17, otherwise the field is absent.","paragraph_zero_based":34645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34646},{"literal_text_all_w_t_and_m_t":"–SPS-ConfigIndex","paragraph_zero_based":34647},{"literal_text_all_w_t_and_m_t":"The IE SPS-ConfigIndex is used to indicate the index of one of multiple DL SPS configurations in one BWP.","paragraph_zero_based":34648},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex information element","paragraph_zero_based":34649},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34650},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-START","paragraph_zero_based":34651},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34652},{"literal_text_all_w_t_and_m_t":"SPS-ConfigIndex-r16             ::= INTEGER (0.. maxNrofSPS-Config-1-r16)","paragraph_zero_based":34653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34654},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIGINDEX-STOP","paragraph_zero_based":34655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4148518e8d3e6023af96b91054940c292d4fdefe6dbe5bc80d61765ebea135da","e589b6eb77ee25e8f2f1340f6219f3b64ee29eddb2bd9bcc3c20de55afc6508a","adc8474c63177529a1c50bbf3462fcf9c83ee3fb426da32a8f357c8b08c7de4a","4e6f5a47603994f52b5268b9a52fcad0135c16f2a51d0f10bce5db9cf09f1a5e","899ac6c17988dcb3378c7f270c3b4d5376481ce0070ce9d5e0ec8a61b9aee865","6ae85903c8e3a04ab35b1a6c87bdcd841590a10dc7bfd5f5e1473c8aeff5315e","aa49f23f6f88843ef8973595145467829b82e028dd97ae9b603b62e98afaa248","9979a93c2daf3ee8a17290ed0f0da46684e92023628202ae561b25e351d67790","bc4acaaf02953f9462a0f2be02a255ad77677ff524119d7daaf39cce282bc2b5","8c9a48f73e82dca69108c541bb9b9a7675f19ea32898e2edafb00ed1a8fe3274","7d68b7e9396ef5d191b003ed50c358117a25ca9acbe51ae3a68b509a2442c61e","e47485a67614b79c50e93a57bc6d