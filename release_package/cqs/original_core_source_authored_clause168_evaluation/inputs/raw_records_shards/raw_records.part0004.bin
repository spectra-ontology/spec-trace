{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB-Mapping-v1700  ::=              SEQUENCE (SIZE (1..maxSIB)) OF SIB-TypeInfo-v1700","paragraph_zero_based":34272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34273},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo ::=                    SEQUENCE {","paragraph_zero_based":34274},{"literal_text_all_w_t_and_m_t":"    type                                ENUMERATED {sibType2, sibType3, sibType4, sibType5, sibType6, sibType7, sibType8, sibType9,","paragraph_zero_based":34275},{"literal_text_all_w_t_and_m_t":"                                                     sibType10-v1610, sibType11-v1610, sibType12-v1610, sibType13-v1610,","paragraph_zero_based":34276},{"literal_text_all_w_t_and_m_t":"                                                     sibType14-v1610, spare3, spare2, spare1,... },","paragraph_zero_based":34277},{"literal_text_all_w_t_and_m_t":"    valueTag                            INTEGER (0..31)                                                 OPTIONAL, -- Cond SIB-TYPE","paragraph_zero_based":34278},{"literal_text_all_w_t_and_m_t":"    areaScope                           ENUMERATED {true}                                               OPTIONAL -- Need S","paragraph_zero_based":34279},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34280},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34281},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo-v1700 ::=              SEQUENCE {","paragraph_zero_based":34282},{"literal_text_all_w_t_and_m_t":"    sibType-r17                         CHOICE {","paragraph_zero_based":34283},{"literal_text_all_w_t_and_m_t":"        type1-r17                           ENUMERATED {sibType15, sibType16, sibType17, sibType18, sibType19, sibType20, sibType21,","paragraph_zero_based":34284},{"literal_text_all_w_t_and_m_t":"                                                        sibType22-v1800, sibType23-v1800 ,sibType24-v1800, sibType25-v1800,","paragraph_zero_based":34285},{"literal_text_all_w_t_and_m_t":"                                                        spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":34286},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":34287},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":34288},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-4, posSibType6-5, posSibType6-6, posSibType2-17a-v1770,","paragraph_zero_based":34289},{"literal_text_all_w_t_and_m_t":"                                                            posSibType2-18a-v1770, posSibType2-20a-v1770, posSibType1-11-v1800,","paragraph_zero_based":34290},{"literal_text_all_w_t_and_m_t":"                                                            posSibType1-12-v1800, posSibType2-26-v1800, posSibType2-27-v1800,","paragraph_zero_based":34291},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-7-v1800, posSibType7-1-v1800,...,","paragraph_zero_based":34292},{"literal_text_all_w_t_and_m_t":"                                                            posSibType7-2-v1800, posSibType7-3-v1800, posSibType7-4-v1800},","paragraph_zero_based":34293},{"literal_text_all_w_t_and_m_t":"            encrypted-r17                       ENUMERATED { true }                                     OPTIONAL, -- Need R","paragraph_zero_based":34294},{"literal_text_all_w_t_and_m_t":"            gnss-id-r17                         GNSS-ID-r16                                             OPTIONAL, -- Need R","paragraph_zero_based":34295}],"source":"Whole authentic original CR source member;