f6f870afec66b59fbf8500","d0abea919341ebd8f6d519755fb062ca2a107dbe4be24e8e6c1bf42fde941ba4","2222b64aa1464e1dd52a8a82bebb7c7225d3db77c0e9910e914870234352e2ca","0f594ca8af4fac82c11b2ef74b15da4b994c0ddb30e80d363c58b37034b52316","09ad81e2f9b80ac8c1a26382702bb5d6b2e0606ba9ff25c5f593276b52aba57e","0d2f97afc73a37885a55e345e70b318026223b27110da3e3ba60bb8a4a015c96","64f65de21f3ece598bfef8ea3e6bf7abc3d0ef4108d3a4f5ea4ce64f24de306c"],"paragraph_range_zero_based":[34008,34031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34008"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SlotFormatIndicator field descriptions","paragraph_zero_based":34032},{"literal_text_all_w_t_and_m_t":"availableRB-SetsToAddModList","paragraph_zero_based":34033},{"literal_text_all_w_t_and_m_t":"A list of AvailableRB-SetsPerCell objects (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34034},{"literal_text_all_w_t_and_m_t":"co-DurationsPerCellToAddModList","paragraph_zero_based":34035},{"literal_text_all_w_t_and_m_t":"A list of CO-DurationsPerCell objects. If not configured, the UE uses the slot format indicator (SFI), if available, to determine the channel occupancy duration (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34036},{"literal_text_all_w_t_and_m_t":"co-DurationsPerCellToReleaseList","paragraph_zero_based":34037},{"literal_text_all_w_t_and_m_t":"A list of CO-DurationsPerCell objects to be released. An entry created using co-DurationsPerCellToAddModList-r16 or co-DurationsPerCellToAddModList-r17 can be deleted using co-DurationsPerCellToReleaseList.","paragraph_zero_based":34038},{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":34039},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with SFI-RNTI (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34040},{"literal_text_all_w_t_and_m_t":"sfi-RNTI","paragraph_zero_based":34041},{"literal_text_all_w_t_and_m_t":"RNTI used for SFI on the given cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34042},{"literal_text_all_w_t_and_m_t":"slotFormatCombToAddModList","paragraph_zero_based":34043},{"literal_text_all_w_t_and_m_t":"A list of SlotFormatCombinations for the UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34044},{"literal_text_all_w_t_and_m_t":"switchTriggerToAddModList, switchTriggerToAddModListSizeExt","paragraph_zero_based":34045},{"literal_text_all_w_t_and_m_t":"A list of SearchSpaceSwitchTrigger objects. Each SearchSpaceSwitchTrigger object provides position in DCI of the bit field indicating search space switching flag for a serving cell or, if cellGroupsForSwitchList is configured, group of serving cells (see TS 38.213 [13], clause 10.4). If cellGroupsForSwitchList is configured, only one of the cells belonging to the same cell group is added/modified, and the configuration applies to all cells belonging to the cellGroupsForSwitchList (see TS 38.213 [13], clause 10.4). The network configures more than 4 SearchSpaceSwitchTrigger objects only if cellGroupsForSwitchList is not configured. The UE shall consider entries in switchTriggerToAddModList and in switchTriggerToAddModListSizeExt as a single list, i.e. an entry created using switchTriggerToAddModList can be modifed using switchTriggerToAddModListSizeExt and vice-versa.","paragraph_zero_based":34046},{"literal_text_all_w_t_and_m_t":"switchTriggerToReleaseModList, switchTriggerToReleaseListSizeExt","paragraph_zero_based":34047},{"literal_text_all_w_t_and_m_t":"A list of SearchSpaceSwitchTriggers to be released. If cellGroupsForSwitchList is configured, the SearchSpaceSwitchTrigger is released for all serving cells belonging to the same CellGroupForSwitch. The UE shall consider entries in switchTriggerToReleaseList and in switchTriggerToReleaseListSizeExt as a single list, i.e. an entry created using switchTriggerToAddModList or switchTriggerToAddModListSizeExt can be deleted using switchTriggerToReleaseList or switchTriggerToReleaseListSizeExt.","paragraph_zero_based":34048},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34049},{"literal_text_all_w_t_and_m_t":"AvailableRB-SetsPerCell field descriptions","paragraph_zero_based":34050},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34051},{"literal_text_all_w_t_and_m_t":"The (starting) position of the bits within DCI payload indicating the availability of the RB sets of a serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34052},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":34053},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":34054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["08e65b3c70e01316de2f32169c52b3a5e9027f39dab5319fa3fa84d8ee495b97","f0b037407db18a6bd3c76b8284f2a4d7686e5034d16ddb077b580da736b1cd8a","6cc649b3c208999c8797a37c6c5f63b1e9acdf44ae89964ffbb867f85e3d00fa","0f382fb302a46bc787bf3deafa44a97ac9155580a5ae7c276292d6a6253fa76a","672d1aed6310fd8daba7210385bfaa6804d3df43de0ef225c1b867b330d632cc","670cb00909eda7d177d016a62bff5b9089c53d53d0fcf05d3a54734052891e35","d93b2068df13ac579ec0290a1316d1d33e516d60ba62ea993d08372a1e427ef1","cb60c95dfc7c99652b89d502a915a56e1a33bb982421349a7a76844fc9a3e2b5","ade38c9804d751dcbd45b88c6c1aaec5f1f19cddb24002ba42ba0c9311f1ac88","0047b1e78d632c09a5a3090e70deea649adb345e47d37c3e83ab0339146a0e2b","552816658a81b4277be375efae933d24ab93ed346b3a2545e06d6a4bfd90b3d4","202f1c4d5b24e0807a1e7e89b55f13e3ba9d9aacdfa7e15e215a993f709c7926","f1e28f0e0ef69755282d3c40d0f919884340c884fcd8e8c0b9213b85d7168ff3","9072926b23e06e4fc80cc10faafca94c7bb6a642e024afc7f1d1370ed64a584b","ae023c7fe3728e8f73d71c67e32580f7c1f6586165458bb663dc33d82d257f61","7355010b93c0d6468c1ecf186b429000482f876b6a32035b61c66b96967c0bcd","65a1f221d41b1524b61c4b5b216f54649546461f7daceb8f3e79c36ac5a7b04f","cdf36c967bbfab055602f263849c041be38d1f90727b319e3f6f5b7e1a84d1f9","ec79f1c59b1bfc5f405fb80905