{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":35184},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35185},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35186},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-STOP","paragraph_zero_based":35187},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35188},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35189},{"literal_text_all_w_t_and_m_t":"SRS-Config field descriptions","paragraph_zero_based":35190},{"literal_text_all_w_t_and_m_t":"dci-TriggeringPosResourceSetLink","paragraph_zero_based":35191},{"literal_text_all_w_t_and_m_t":"Indicates whether the single DCI-triggering SRS positioning resource sets across the linked carriers is enabled or not for bandwidth aggregation.","paragraph_zero_based":35192},{"literal_text_all_w_t_and_m_t":"tpc-Accumulation","paragraph_zero_based":35193},{"literal_text_all_w_t_and_m_t":"If the field is absent, UE applies TPC commands via accumulation. If disabled, UE applies the TPC command without accumulation (this applies to SRS when a separate closed loop is configured for SRS) (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":35194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35195},{"literal_text_all_w_t_and_m_t":"SRS-Resource, SRS-PosResource field descriptions","paragraph_zero_based":35196},{"literal_text_all_w_t_and_m_t":"cyclicShift-n2","paragraph_zero_based":35197},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":35198},{"literal_text_all_w_t_and_m_t":"cyclicShift-n4","paragraph_zero_based":35199},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":35200},{"literal_text_all_w_t_and_m_t":"cyclicShift-n8","paragraph_zero_based":35201},{"literal_text_all_w_t_and_m_t":"Cyclic shift configuration (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":35202},{"literal_text_all_w_t_and_m_t":"combOffsetHopping","paragraph_zero_based":35203},{"literal_text_all_w_t_and_m_t":"Configures UE with comb offset hopping. The hoppingId is used to initialize pseudo random comb offset hopping. If UE is configured with both comb offset and cyclic shift hopping, only one hoppingId is configured. The hoppingWithRepetition configures time-domain hopping behavior for repetition factor R>1. The hoppingSubset indicates a set of comb offset by a bit string (see clause 6.4.1.4.3 of TS 38.211 [16]). The i-th bit in the bit string is set to 1 to indicate the scohSRSt=i-1, where t is determined by its ordinary position among the positive bits in bit string, i.e., if the i-th bit is a first positive bit, t=0; if the i-th bit is a second positive bit, t=1 , and so on.","paragraph_zero_based":35204},{"literal_text_all_w_t_and_m_t":"cyclicShiftHopping","paragraph_zero_based":35205},{"literal_text_all_w_t_and_m_t":"Configures UE with cyclic shift hopping. The hoppingId is used to initialize pseudo random cyclic shift hopping. If UE is configured with both comb offset and cyclic shift hopping, only one hoppingId is configured. The hoppingFinerGranularity enables finer granular hopping, see TS 38.211 [16], clause 6.4.1.4.2. If hoppingSubset is configured, hoppingFinerGranularity is not configured. The hoppingSubset indicates a set of cyclic shift by a bit string (see clause 6.4.1.4.2 of TS 38.211 [16]). The i-th bit in the bit string is set to 1 to indicate the scshSRSt=i-1, where t is determined by its ordinary position among the positive bits in bit string, i.e., if the i-th bit is a first positive bit, t=0; if the i-th bit is a second positive bit, t=1 , and so on.","paragraph_zero_based":35206},{"literal_text_all_w_t_and_m_t":"enableStartRBHopping","paragraph_zero_based":35207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a25b933062ea00253a11eddac17fbab5628376b7dfa1d6641689d237f36e7adb","a028fd19fb94760f684696d8080000b2814839d954de833ca8c2cd986df9411a","2b8c57c267ce849958b990a2397550db3f43ad3491a981c591791bdb8b6bbc66","42463212d62fd6e7c8f9eb776ce38ff08bab71380502b9681c4ed5fd769f2634","1c9ab6a1b79f136513a19d16a3edea0f0c90b8ccec1f1409c32ee0502c18dab8","45921b308bf5e92ecb76afebbdd9c59db36554cbd132dd2196cd1bf47dc757ca","fc8903f665ba9971f7ab7920b7c8c5eddd10551b04b036f94f0f26f8f0681fe6","620dd96520bf05bd97a9b2fb65c52ccec8fa298925420e32d4d03f01aaa40c8f","a4f4186c2dd874c3ef5ebd3ba641d9100ca7ea520f50adae5ec565fab33988c8","d5b494b568c1358f9fd0ac9ec68ba09b64d58dca2f952bbd6e4c3bd340f31a12","7824f8cf94690d26a8dce128c443f7ada4577e9e7e322b057377a66aedf818e6","09787afe447cc25154b72e156c2db806ebdd34e98d2ad5b6af8a3e8e8cb3af8b","a1a800fffb7f1027958e632deae0a0a1f9d3a1476f35cc3318740fc73eaa084a","5c791bc3211fbec1283a716e350a73b4f7fe0f4798cfd0f3949d6cfd65f0d674","48506ba3d68d6916a98b6010c0ebde0e1cfbbd44a8b071542bd391e740267520","5e2f639208d942259ddab5bef694b493bcb2ac485147d28963e3e1d0a850bcb5","ea0514f81d379963b1dc475214f7e54bff38649c3a93a43963a982e58061ac5b","454fc622a27f7245c403e921c66f41882106fbe7a3ff1f289c650e584075e60e","bf351db95ff9e7e27542bcc794871f2f9d4339b60a9ff46c553b5d0c7e66e3a5","93cfa9fd5306a13b4d391f9eb17a6b5ba7a6129b2d2776b23838dd496d0a78ae","20cbb9bb4060872a928103b0daff071f61fb8a499221c9775161ee1cdf081fc6","23068e1f53053ee9c8d3e165b4d2a962f50a37dbabc1c59d1063067ec5103c6d","d146ef3c8b19245a4fbd3112c5b060680494e3f3f1a5568ebc008f7076e0490f","916627122a9561f6e02f9612f395fe131fb77478735c0c1bc23646908b50ba32"],"paragraph_range_zero_based":[35184,35207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When this RRC parameter is configured, start RB location hopping is enabled for partial frequency sounding in different SRS frequency hopping periods for periodic/semi-persistent/aperiodic SRS as described in clause 6.4.1.4 in TS 38.211.","paragraph_zero_based":35208},{"literal_text_all_w_t_and_m_t":"freqHopping","paragraph_zero_based":35209},{"literal_text_all_w_t_and_m_t":"Includes parameters capturing SRS frequency hopping (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, the network always configures this field such that b-hop > b-SRS. For SRS for positioning configuration in multiple cells this field is commonly configured across cells within the validity area. c-SRS Indicates the maximum bandwidth. When TxHoppingConfig is configured the valid values for c-SRS are such that the maximum bandwidth is: 104 PRBs, 48 PRBs, 132 PRBs, 64 PRBs, for 15,30,60,120 KHz respectively. The same value for c-SRS is configured for all the hops when TxHoppingConfig is configured.","paragraph_zero_based":35210},{"literal_text_all_w_t_and_m_t":"groupOrSequenceHopping","paragraph_zero_based":35211},{"literal_text_all_w_t_and_m_t":"Parameter(s) for configuring group or sequence hopping (see TS 38.211 [16], clause  6.4.1.4.2). For CLI SRS-RSRP measurement, the network always configures this parameter to 'neither'. For SRS for positioning configuration in multiple cells this field is commonly configured across cells within the validity area.","paragraph_zero_based":35212},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports","paragraph_zero_based":35213},{"literal_text_all_w_t_and_m_t":"Number of ports. For CLI SRS-RSRP measurement, the network always configures this parameter to 'port1'.","paragraph_zero_based":35214},{"literal_text_all_w_t_and_m_t":"nrofSRS-Ports-n8","paragraph_zero_based":35215},{"literal_text_all_w_t_and_m_t":"Number of ports if the number of antenna ports is 8. The value 'ports8' configures UE with 8 antenna ports and the value 'ports8tdm' configures the UE with 8 antenna ports which are partitioned into 2 subsets with each subset having 4 different ports, and the subsets are mapped to different OFDM symbols, see TS 38.211 [16], clause 6.4.1.4.2. If combOffsetHopping-r18 or cyclicShiftHopping-r18 is configured, this field is not set to ports8tdm. If this field is present UE ignores the field nrofSRS-Ports.","paragraph_zero_based":35216},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-p, periodicityAndOffset-p-Ext","paragraph_zero_based":35217},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, sl1280 and sl2560 cannot be configured. For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz except when periodicity of 20480ms is configured.","paragraph_zero_based":35218},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-p-Ext is present, periodicityAndOffset-p shall be ignored by the UE.","paragraph_zero_based":35219},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset-sp, periodicityAndOffset-sp-Ext","paragraph_zero_based":35220},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for this SRS resource. All values are in \"number of slots\". Value sl1 corresponds to a periodicity of 1 slot, value sl2 corresponds to a periodicity of 2 slots, and so on. For each periodicity the corresponding offset is given in number of slots. For periodicity sl1 the offset is 0 slots (see TS 38.214 [19], clause 6.2.1). For SRS-PosResource, values sl20480, sl40960 and sl81920 cannot be configured for SCS=15kHz, values sl40960 and sl81920 cannot be configured for SCS=30kHz, and value sl81920 cannot be configured for SCS=60kHz.","paragraph_zero_based":35221},{"literal_text_all_w_t_and_m_t":"When periodicityAndOffset-sp-Ext is present, periodicityAndOffset-sp shall be ignored by the UE.","paragraph_zero_based":35222},{"literal_text_all_w_t_and_m_t":"ptrs-PortIndex","paragraph_zero_based":35223},{"literal_text_all_w_t_and_m_t":"The PTRS port index for this SRS resource for non-codebook based UL MIMO. This is only applicable when the corresponding PTRS-UplinkConfig is set to CP-OFDM. The ptrs-PortIndex configured here must be smaller than the maxNrofPorts configured in the PTRS-UplinkConfig (see TS 38.214 [19], clause 6.2.3.1). This parameter is not applicable to CLI SRS-RSRP measurement.","paragraph_zero_based":35224},{"literal_text_all_w_t_and_m_t":"resourceMapping","paragraph_zero_based":35225},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the SRS resource within a slot including nrofSymbols (number of OFDM symbols), startPosition (value 0 refers to the last symbol, value 1 refers to the second last symbol, and so on) and repetitionFactor (see TS 38.214 [19], clause 6.2.1 and TS 38.211 [16], clause 6.4.1.4). The configured SRS resource does not exceed the slot boundary. If resourceMapping-r16 is signalled, UE shall ignore the resourceMapping (without suffix). If resourceMapping-r17 is signalled, resourceMapping-r16 is not signalled and the UE shall ignore the resourceMapping (without suffix) and only the values of nrofSymbols which are integer multiples of the configured repetitionFactor can be configured. The network can only signal repetitionFactor-v1730 if resourceMapping-r17 is signalled. When repetitionFactor-v1730 is signalled, the UE shall ignore repetitionFactor-r17. For CLI SRS-RSRP measurement, the network always configures nrofSymbols and repetitionFactor to 'n1'. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area. nrofSymbols is same for all the hops when TxHoppingConfig is configured.","paragraph_zero_based":35226},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":35227},{"literal_text_all_w_t_and_m_t":"Periodicity and offset for semi-persistent and periodic SRS resource, or slot offset for aperiodic SRS resource for positioning (see TS 38.214 [19], clause 6.2.1). For CLI SRS-RSRP measurement, only 'periodic' is applicable for resourceType. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35228},{"literal_text_all_w_t_and_m_t":"sequenceId","paragraph_zero_based":35229},{"literal_text_all_w_t_and_m_t":"Sequence ID used to initialize pseudo random group and sequence hopping (see TS 38.214 [19], clause 6.2.1). If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35230},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo","paragraph_zero_based":35231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0a48f5a861a93a1b1908f94781bc039744c5e5ea7faaffd2aec5a639dea82aa6","48a3c5bfc4b735be6194d659b26e6cd0d70dbeec7e4e038058183068682e83a3","aad8af429d9247702b72a68eded0a844b29ca0e1656af031036b8e702753e47f","4bd8145c334f9aa69d3e238e191526884bc7b8df59038a1268ed6664d8c296db","268a8f463ce59d1b0685993b191bf7f6d9a89668d5c5bd169efb6dbfad02f32c","808c0f2bca9f55e98d0b3f6573d10c6a157453728ad258828c48b6bf59c2409e","07466222facfa55477b3db08b7c108d45dd87efd2cb6d1ad2eed9badc10594bc","2d9dccf743c1755d55dbf3dca6b2fd0c1c1c3160094da8703f114215f677439f","40fafcd555f98601572b2ed8b108ff0c7b4a42ced8e6b26cf480902b203821a5","13e3f4e97240a6f41b4a55f72de8d7d7bc42ecf8f2490672b320278b7e4ca972","976e8c7b87fdde8615b2f0c9362487347b8434c81afcd90254827e308a94d066","11e5693466ebb12bc52e600939b5fa629f58260394fc884e5fa25fc3ad8caafc","ff8e858eadd4f1dd4933868d93b9c2e2dd9ed8443c7d2d69afccdf55adb36d2e","fac7d67e5e493537f2cfb38ace4b3ebff03343162c844c86dea66e183613c924","fe372d67d0ed89b03609196d92b5e88cc28bc31e49ffab4893a77f0310669a7b","e56850e40645acd2531326cf6527f23de72476f9cd9a5fe2b26d3833cfc393bb","2e537b12947c1ffc17fb6356be150e15293d2994f14f396146a9d57547c0da6d","47bf84dab39e8c82207f6092c1186c7e582d92c7314f8c0a21b5e34a515690d1","b714cf28a97b8d71b25c58e8a40dde01c55c11dd7cd549944f97d57aa5fdcdbc","931907b623a356121c8cb809868987dc907d240bbd49f63a67d9f63ca674615d","e19437c7012b456bc94ba2f83d8d557d2aa3a16c54e83f9c7da380c2aa09f0ae","4ae274d0d4ae88e81b500adc75ca3d3a0395e004217e73040d8031a0032a7db5","9d975e5b4d3791f691ee44f640dadea18405001610f1faee27c40e21306af68e","6ea1a657eadbe31f4c45e50dd7f03f57ad659ffafd80aabc2b5d2208f79a5caf"],"paragraph_range_zero_based":[35208,35231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS (see TS 38.214 [19], clause 6.2.1). This parameter is not applicable to CLI SRS-RSRP measurement. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":35232},{"literal_text_all_w_t_and_m_t":"spatialRelationInfo-PDC","paragraph_zero_based":35233},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS-PDC (see TS 38.214 [19], clause 6.2.1). The field is present in case of resourceType=periodic and usagePDC-r17=true in the SRS-ResourceSet, otherwise the field is absent.","paragraph_zero_based":35234},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoPos","paragraph_zero_based":35235},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and the target SRS. Reference RS can be SSB/CSI-RS/SRS/DL-PRS (see TS 38.214 [19], clause 6.2.1).","paragraph_zero_based":35236},{"literal_text_all_w_t_and_m_t":"If the IE srs-ResourceId-Ext is present, the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 63. Otherwise the IE srs-ResourceId in spatialRelationInfoPos represents the index from 0 to 31.","paragraph_zero_based":35237},{"literal_text_all_w_t_and_m_t":"srs-PosPeriodicConfigHyperSFN-Index","paragraph_zero_based":35238},{"literal_text_all_w_t_and_m_t":"Indicates whether the current Hyper SFN is even or odd HSFN for SRS for Positioning transmission. If this field is not configured, the UE assumes that SRS for positioning periodictity longer than one Hyper SFN is not configured.","paragraph_zero_based":35239},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-0-2","paragraph_zero_based":35240},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\" in DCI format 0_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 0_2 is applied. If the parameter srs-RequestDCI-0-2 is configured to value 1, 1 bit is used to indicate one of the first two rows of Table 7.3.1.1.2-24 in TS 38.212 [17] for triggered aperiodic SRS resource set. If the value 2 is configured, 2 bits are used to indicate one of the rows of Table 7.3.1.1.2-24 in TS 38.212 [17]. When UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication.","paragraph_zero_based":35241},{"literal_text_all_w_t_and_m_t":"srs-RequestDCI-1-2","paragraph_zero_based":35242},{"literal_text_all_w_t_and_m_t":"Indicate the number of bits for \"SRS request\" in DCI format 1_2. When the field is absent, then the value of 0 bit for \"SRS request\" in DCI format 1_2 is applied. When the UE is configured with supplementaryUplink, an extra bit (the first bit of the SRS request field) is used for the non-SUL/SUL indication (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":35243},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToAddModListDCI-0-2","paragraph_zero_based":35244},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be added or modified for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":35245},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetToReleaseListDCI-0-2","paragraph_zero_based":35246},{"literal_text_all_w_t_and_m_t":"List of SRS resource set to be released for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":35247},{"literal_text_all_w_t_and_m_t":"srs-TCI-State","paragraph_zero_based":35248},{"literal_text_all_w_t_and_m_t":"Configuration of either a UL TCI state or a joint TCI state for the SRS resource. In case of UL TCI-State, refers to the TCI state defined in ul-TCI-StateList in the BWP-UplinkDedicated where the SRS-Config is configured. In case of joint TCI state, refers to a TCI state defined in dl-OrJointTCI-StateList in pdsch-Config of the BWP-DownlinkDedicated and serving cell indicated by cellAndBWP. This field is absent when the SRS resource is in an SRS-ResourceSet configured with followUnifiedTCI-StateSRS-r17 or applyIndicatedTCI-State, or when the field unifiedTCI-StateType is not configured to the serving cell which the SRS resource is located in.","paragraph_zero_based":35249},{"literal_text_all_w_t_and_m_t":"startRBIndexAndFreqScalingFactor","paragraph_zero_based":35250},{"literal_text_all_w_t_and_m_t":"Configures the UE with the startRBIndex and freqScalingFactor for partial frequency sounding as described in Clause 6.4.1.4 in TS 38.211. The startRBIndexForFScaling2 gives the startRBIndex when freqScalingFactor is 2 and the startRBIndexForFScaling4 gives the startRBIndex when FreqScalingFactor is 4 ","paragraph_zero_based":35251},{"literal_text_all_w_t_and_m_t":"transmissionComb, transmissionComb-n2, transmissionComb-n4, transmissionComb-n8","paragraph_zero_based":35252},{"literal_text_all_w_t_and_m_t":"Comb value (2 or 4 or 8) and comb offset (0..combValue-1) (see TS 38.214 [19], clause 6.2.1). If network configures field transmissionComb-n8, the UE ignores transmissionComb. If srs-PosRRC-InactiveValidityAreaPreConfig or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35254},{"literal_text_all_w_t_and_m_t":"SRS-ResourceSet, SRS-PosResourceSet field descriptions","paragraph_zero_based":35255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b298241b6bee97506f49a2d0b3205155d49d87cf5eb9561438be16c410728912","7083e469506ae4f48bf6cef65625089096008bba6b324c4d2353e1a18f645548","5bf48634524e712533850753c11540f32d492c609ebcded6357b2e438cd1a31f","5498040a9fd80108698df609ef577911ce3adbe0d7b19ec7297810556141e4a8","729c112d863bf4bf35bb3a7e6652f420640e7901c8347a620b162b8c8d8bf877","604cd9ceea34359754bf451c6d0004880e4376558d46cbf3706e6960750f1ca7","362c7db93afcdb5f96d2de242e4d92d37747f9aeb86c068a1c209a9b509bc056","4cd6265857f6aefbe27698f62612d2fccb0073eb84ad052949d378c83a615373","d737977550bb4e4261c0c6f11c11eb8c8be405687abef576ca95aa273b69d333","9e6e30ca580bea58ce46800272b68cb4b93bf99569ea221e36330f4aa4c73c2f","05efa8ca0ff053b769c9318db4c40613d647c2bed8ccdb326cb1cf9962786aae","c9242ee8c4a828323b98e170344240919ff96a507aa58d20752db975f9900ebc","2a09bdd12cfd9f575776daf30e2bcec541cdc80d0fa5b4b39e4012765a057e15","b4d540571500384db071bdc4a1718b1a87a677cb8b750889fdc32444eaa4eb80","8658ba977aab6b4de6ec2f25625275899c6ce1142cda600a667f4e42da8b9551","31af526a701140eec9975c7491d7270cd03fc657bb7aad31c234b6fb6f3ba8f4","6ae2e4c4dafb2a265af63d89d312dbf044591bbc062fad72a4b12999089708e6","f08998f374bdc8f4651eda294dbc8107ac9f9ebfe9a7c77d9352b86a85910c26","565b2e3260844fb92f10a84c5427fa0e413b66251962470051d46862d0430862","9f4a0509d592c85fdb346aa6e43814180966cbf33c93441bbc822a8cef0d3927","92092007c06dce108e49b67fcf6b63f9c3e8c5142ef0c79b3b60792c9e11c535","ab36afe498767d8639fe8db91817051ea95561bd9097923d66245b51f561138b","2992e53994f164a098fae7e069952f779643f0e713df5985e38a0d682afda64a","10e3799b047c8f1e34afabccf294cdc1cae662f3bbc8342b8bcf29cfb89d849b"],"paragraph_range_zero_based":[35232,35255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"alpha","paragraph_zero_based":35256},{"literal_text_all_w_t_and_m_t":"alpha value for SRS power control (see TS 38.213 [13], clause 7.3). When the field is absent the UE applies the value 1. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35257},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTriggerList","paragraph_zero_based":35258},{"literal_text_all_w_t_and_m_t":"An additional list of DCI \"code points\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6). When the field is not included during a reconfiguration of SRS-ResourceSet of resourceType set to aperiodic, UE maintains this value based on the Need M; that is, this list is not considered as an extension of aperiodicSRS-ResourceTrigger for purpose of applying the general rule for extended list in clause 6.1.3.","paragraph_zero_based":35259},{"literal_text_all_w_t_and_m_t":"aperiodicSRS-ResourceTrigger","paragraph_zero_based":35260},{"literal_text_all_w_t_and_m_t":"The DCI \"code point\" upon which the UE shall transmit SRS according to this SRS resource set configuration (see TS 38.214 [19], clause 6).","paragraph_zero_based":35261},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":35262},{"literal_text_all_w_t_and_m_t":"This field indicates, for an SRS-ResourceSet, if UE applies the first or the second \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 6.2.1. If more than one value for the field coresetPoolIndex is configured in IE controlResourceSet for the BWP, the value 'first' corresponds to the \"indicated\" joint/UL TCI states specific to coresetPoolIndex value 0 and the value 'second' correspond to the value 1, respectively. When UE is configured with two SRS resource sets with usage set to Codebook or nonCodebook, network does not configure the first set with value 'second' or second set with value 'first'.","paragraph_zero_based":35263},{"literal_text_all_w_t_and_m_t":"associatedCSI-RS","paragraph_zero_based":35264},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set in non-codebook based operation (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":35265},{"literal_text_all_w_t_and_m_t":"availableSlotOffsetList","paragraph_zero_based":35266},{"literal_text_all_w_t_and_m_t":"Indicates a list of up to four different available slot offset values from slot n+k to the slot where the aperiodic SRS resource set is transmitted, where slot n is the slot with the triggering DCI, and k is the slotOffset (without suffix) as described in clause 6.2.1 of TS 38.214 [19].","paragraph_zero_based":35267},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":35268},{"literal_text_all_w_t_and_m_t":"ID of CSI-RS resource associated with this SRS resource set (see TS 38.214 [19], clause 6.1.1.2).","paragraph_zero_based":35269},{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":35270},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":35271},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-StateSRS","paragraph_zero_based":35272},{"literal_text_all_w_t_and_m_t":"When set to enabled, for SRS resource Set, the UE applies the \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5. This parameter may be configured for aperiodic SRS for BM or SRS of any time-domain behavior for codebook, non-codebook, and antenna switching.","paragraph_zero_based":35273},{"literal_text_all_w_t_and_m_t":"p0","paragraph_zero_based":35274},{"literal_text_all_w_t_and_m_t":"P0 value for SRS power control. The value is in dBm. Only even values (step size 2) are allowed (see TS 38.213 [13], clause 7.3). If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35275},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS","paragraph_zero_based":35276},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a CSI-RS config or a SS block) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":35277},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Pos","paragraph_zero_based":35278},{"literal_text_all_w_t_and_m_t":"A reference signal (e.g. a SS block or a DL-PRS config) to be used for SRS path loss estimation (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":35279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f339a81466df88053d9b164c0571f15592807bdb275c1408f1d4b992a1ee236e","e351439f210aa2837032e60c440dbdae300010a4801ebc2719a504efcfefbb9b","72cc66d7a8c8e23adb3cbec6aab1737caff80ae925edd9341d3eeab9280d0078","2629258faa2085e65b71b13fbde04323f8a9efb48b8d5b6cf1286ece213145e5","dcdda78a8ec856982f5a3da8117d9608a1e4103fc2c5ac17ebe93f4f664fcf21","9ce9cad3d2e95b75e55c45f7059543aa5e93a3d9af21f82a2c0eaeb8d6e99d77","5c00b7bcfe2cb0c606bfe65112072808ba3d3cc29d9603037e05abf1fe352568","a8e56161f85dd2bd149cc52383cf9470b527ca8b62ee9c3388eb9fb9d3de59e6","d5cb0edee99a9b5719fa914c14ae431718a266c3391bfb7ad1cb53c639c3a9b5","0a590af7415eeca2971e0358bb293febef4d7ba800c6271dbe750a8ec91a830d","cd201159804e854a65e3c2a8de66d74fdca09fdddce7b62a1d2ad0ec17b01d7e","244c878154af529cef35861678c23eb2278d353061e1a7ffaa69fddbe8aba859","602e520bd769e94cfe2e8e5aba4964166b3d5b78e241f58dd2d39d4cdf472f4d","3b108397904b46acc50ae13adb753794eba4978b2f0cf8901ac0857bacbf7fb8","212c228f976cba47fb8cb236295a4866fd260c9acc084d12849131b31256cea0","17c9f4ba48b0184e34ed029227829da5d0a53edf27dfaf109396be845ae169db","490f9a161b74572981437e02bda79b9e4441c8a80ffbaf5d14cd2219fefe22a0","cd67808bdef5e35fbef59b97cb3724eb09bf39af3d5e1f05d45f6bf564518f14","f56d79888a50bac17fcec6a069f679387434a299fad63bfe944e02443182bfa1","1423d217e80f9c8acc9050993be00ecaa9faff41c0f77dcb456389a82e8ad9dd","6a7a5c534257d05ea938b30badafd1300f22157d53816ae8c302411ce7922e39","2cf2c0ff500b9037ae9e623519f27d3fbc5477b14fc882489ff9a0d0de85b957","de0808a9c0cfbd20b18beba320e98956f3bfce55ff12356e634a6a6310befd75","b07bc590aa5ca8177a255a606384d18ca36c1750f39b09ddaffad92fc73693d7"],"paragraph_range_zero_based":[35256,35279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35256"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSList","paragraph_zero_based":35280},{"literal_text_all_w_t_and_m_t":"Multiple candidate pathloss reference RS(s) for SRS power control, where one candidate RS can be mapped to SRS Resource Set via MAC CE (clause 6.1.3.27 in TS 38.321 [3]). The network can only configure this field if pathlossReferenceRS is not configured in the same SRS-ResourceSet.","paragraph_zero_based":35281},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":35282},{"literal_text_all_w_t_and_m_t":"Time domain behavior of SRS resource configuration, see TS 38.214 [19], clause 6.2.1. The network configures SRS resources in the same resource set with the same time domain behavior on periodic, aperiodic and semi-persistent SRS. The aperiodic SRS is not applicable for the UE in RRC_INACTIVE. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, this field is commonly configured across cells within the validity area.","paragraph_zero_based":35283},{"literal_text_all_w_t_and_m_t":"slotOffset","paragraph_zero_based":35284},{"literal_text_all_w_t_and_m_t":"An offset in number of slots between the triggering DCI and the actual transmission of this SRS-ResourceSet. If the field is absent the UE applies no offset (value 0).","paragraph_zero_based":35285},{"literal_text_all_w_t_and_m_t":"srs-PowerControlAdjustmentStates","paragraph_zero_based":35286},{"literal_text_all_w_t_and_m_t":"Indicates whether hsrs,c(i) = fc(i,1) or hsrs,c(i) = fc(i,2) (if twoPUSCH-PC-AdjustmentStates are configured) or separate close loop is configured for SRS. This parameter is applicable only for Uls on which UE also transmits PUSCH. If absent or release, the UE applies the value sameAs-Fci1 (see TS 38.213 [13], clause 7.3).","paragraph_zero_based":35287},{"literal_text_all_w_t_and_m_t":"srs-ResourceIdList, srs-PosResourceIdList","paragraph_zero_based":35288},{"literal_text_all_w_t_and_m_t":"The IDs of the SRS-Resources/SRS-PosResource used in this SRS-ResourceSet/SRS-PosResourceSet. If this SRS-ResourceSet is configured with usage set to codebook, the srs-ResourceIdList contains at most 2 entries. If this SRS-ResourceSet is configured with usage set to nonCodebook, the srs-ResourceIdList contains at most 4 entries. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, srs-PosResourceIdList is commonly configured across cells within the validity area.","paragraph_zero_based":35289},{"literal_text_all_w_t_and_m_t":"srs-ResourceSetId, srs-PosResourceSetId","paragraph_zero_based":35290},{"literal_text_all_w_t_and_m_t":"The ID of this resource set. It is unique in the context of the BWP in which the parent SRS-Config is defined. If srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured, srs-PosResourceSetId is commonly configured across cells within the validity area.","paragraph_zero_based":35291},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":35292},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell where the SRS is configured.","paragraph_zero_based":35293},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":35294},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":35295},{"literal_text_all_w_t_and_m_t":"usage","paragraph_zero_based":35296},{"literal_text_all_w_t_and_m_t":"Indicates if the SRS resource set is used for beam management, codebook based or non-codebook based transmission or antenna switching. See TS 38.214 [19], clause 6.2.1. Reconfiguration between codebook based and non-codebook based transmission is not supported.","paragraph_zero_based":35297},{"literal_text_all_w_t_and_m_t":"usagePDC","paragraph_zero_based":35298},{"literal_text_all_w_t_and_m_t":"If configured, it indicates that this SRS resource set is used for propagation delay compensation. The field can be present in only one SRS-ResourceSet.","paragraph_zero_based":35299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35300},{"literal_text_all_w_t_and_m_t":"SRS-SpatialRelationInfoPos field descriptions","paragraph_zero_based":35301},{"literal_text_all_w_t_and_m_t":"csi-RS-IndexServing","paragraph_zero_based":35302},{"literal_text_all_w_t_and_m_t":"Indicates CSI-RS index belonging to a serving cell.","paragraph_zero_based":35303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["63fb67b1bac3594e95aea9dc8fde741506e975a06f8cf1c2d354e79df9ed0ace","b84c2a08b2ab4f5c5185e1fb808f0d8791b63e40bc17026b3182ecc5268b8d3a","09c2e27d3e901efb84c28d6c5170f091ce4023ee70e4195e7e9c81edd764c120","7cda90c97d98d119d5cfd32931c54c34f8ef1dd6766ed1ed786c898b54aea606","fe390ce8f1ead49a6609775b19f7570f3b63984db02b5555ecee6502818e098e","8e3cf2e9a93bc478192c0a26f652e739ebefca6f6d46178c7319545e3d67d056","8d0c689995e119c4cbe02926d708eff399d53358ba8e46241648e287a32f41f4","30d14b9d40e5053c7c511f0df1621a0bb8b9c293ece0e62e5a990785a842d733","98d895ded5e9e5bcc3c01a7850a52c50f60aa4d7c3f58c354c6805d471c6a39d","0620e39d8dede943fadd3984149927723f3e171e6c4b6115be7422635c111091","ddc0d38f9f2928fbccdfead67ac7b932b93a672cd58cf4cc538cc3a58f5bd3f9","c5d431468979439aa98d0ead476c1d92049e041df23a4b5a9ad6b766cb10655c","e35cd731d31c12587cf9506715d0d0989b17b073b2dbcb7563aea7078cc14ea1","d621e1cfbfa8352250ba81bb363689b8e9d4248e3a964d5353f8978857ce06f9","028f5066a559e2f5d118af8d0ad5dcb414cd04c44fd4e3b0f80e01175f4d8dfe","78c9675fffb9d31e9ff4d501843ad2afcab5d44db7db4bc07b6c7be598537e03","4684590ec3016655397af6d4c252d91598b73db389a09a39b5a6d5ead06765b2","8c5bc0ead14a6ee36bd978b4ccea1b85c8b74e0babc688c844d31b06640654a0","3dfe6751c2551e89dfdfb5b5ad7b947eb7a78a3e1e053c7b593dc2a1deb3f048","0e23d219a7f54b97980777243c08d054e7c91da46b4048e4d75a0e0beff7ca58","5aea227e29c335b9c3e600223ba2279741f64819c5d4e73e661a0fd5c7e6aa4e","54315f80f7234e6282d7b8f89d1e354a6335cf19888ab89b182da45c7a7e0359","5dbf616c3ee50a1fc313a0839cff4d90302f186c641fbef5d2373ae37e746ee5","5ab8c717b3385828036087bd17ed8c50f3781c47891ee2b2b2b641f458864373"],"paragraph_range_zero_based":[35280,35303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35280"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-PRS","paragraph_zero_based":35304},{"literal_text_all_w_t_and_m_t":"This field indicates a PRS configuration.","paragraph_zero_based":35305},{"literal_text_all_w_t_and_m_t":"resourceSelection","paragraph_zero_based":35306},{"literal_text_all_w_t_and_m_t":"Indicates whether the configured SRS spatial relation resource is a SRS-Resource or SRS-PosResource.","paragraph_zero_based":35307},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":35308},{"literal_text_all_w_t_and_m_t":"The serving Cell ID of the source SSB, CSI-RS, or SRS for the spatial relation of the target SRS resource. If this field is absent the SSB, the CSI-RS, or the SRS is from the same serving cell where the SRS is configured.","paragraph_zero_based":35309},{"literal_text_all_w_t_and_m_t":"ssb-IndexServing","paragraph_zero_based":35310},{"literal_text_all_w_t_and_m_t":"Indicates SSB index belonging to a serving cell.","paragraph_zero_based":35311},{"literal_text_all_w_t_and_m_t":"ssb-Ncell","paragraph_zero_based":35312},{"literal_text_all_w_t_and_m_t":"This field indicates a SSB configuration from neighboring cell.","paragraph_zero_based":35313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35314},{"literal_text_all_w_t_and_m_t":"SSB-InfoNCell field descriptions","paragraph_zero_based":35315},{"literal_text_all_w_t_and_m_t":"physicalCellId","paragraph_zero_based":35316},{"literal_text_all_w_t_and_m_t":"This field specifies the physical cell ID of the neighbour cell or NCD-SSB of the serving cell for which SSB configuration is provided.","paragraph_zero_based":35317},{"literal_text_all_w_t_and_m_t":"ssb-IndexNcell","paragraph_zero_based":35318},{"literal_text_all_w_t_and_m_t":"This field specifies the index of the SSB for a neighbour cell or NCD-SSB of the serving cell. See TS 38.213 [13]. If this field is absent, the UE determines the ssb-IndexNcell of the physicalCellId","paragraph_zero_based":35319},{"literal_text_all_w_t_and_m_t":"based on its SSB measurement from the cell.","paragraph_zero_based":35320},{"literal_text_all_w_t_and_m_t":"ssb-Configuration","paragraph_zero_based":35321},{"literal_text_all_w_t_and_m_t":"This field specifies the full configuration of the SSB. If this field is absent, the UE obtains the configuration for the SSB from nr-SSB-Config received as part of DL-PRS assistance data in LPP, see TS 37.355 [49], by looking up the corresponding SSB configuration using the field physicalCellId.","paragraph_zero_based":35322},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35323},{"literal_text_all_w_t_and_m_t":"DL-PRS-Info field descriptions","paragraph_zero_based":35324},{"literal_text_all_w_t_and_m_t":"dl-PRS-ID","paragraph_zero_based":35325},{"literal_text_all_w_t_and_m_t":"This field specifies the UE specific TRP ID (see TS 37.355 [49]) for which PRS configuration is provided. ","paragraph_zero_based":35326},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSetId","paragraph_zero_based":35327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c9787fee3159c7a7469b29d0daa6f0f573e3fc396b13c1f8ea9e671f5db444b4","5db8a8d9f5bd56aabeb16f06e980cb44cfc8698d48a35afda575c3013173099f","ede5ed7ea82d633cde61e5cde37c186077f2a9e6e48f91eeb32315b0536cb1b2","151ae7df71d73b15b91569f00efef958a48aaaab315c53dddbe165a387b0ba6c","99d9c85b4a6dcc796698c670d376383044cf329d5eb839cef26f5f92933b63c0","9c05c691dfe746702f2fe9587a424d0c45cff5bf96431f8abd71ae2fe067be1a","a6b2690ae9ee2cc1b3c820a593d93a3984af18a91ad05de91854b3b18274d9a7","765f1ed5a0e37588d8561d72b1f8cd84da16c33a59b5342db549c8133c00c62a","1d6b0d2696040a1a72a3d7ba9c82b123ed2b141f88d88ac3eb164b33ca8384d2","6a1affb61c808d71b22b2a64381377aec15dc5ccdc7a4faab9f892661791393f","7ca346d149aaadd478b36e7976d13adea5dc6c115f7a75cb0d55513a35d98562","fa2009dbf9cba5eb75ace85445e4965cf933b2bacf02bbc05269d4c76414081e","7bc86235e7dcecca1b87d8ff45113f6f1185d3937ffc491801dded96621b9988","47b30e89c8e490c553302258cc7c53df94acfab592896d40fe4bd45f1c462c14","10b56c6736692980a7d876e031774bdadb301d68df55a63361b559c4601fe52d","06e5bf47c4ef8b55bd8760025de4d408039ca891c3d96f7f0aad4384585110ed","3e9fc68602a416dcac2c5e1eeaf0b4b9b9811abe0b81a67a133ec54e4b67ba9f","11296cc56e26685aba8e81e4197a8598b4d81d4f145e2be0b0a94c26fe4c34b2","eb377d8ca8a37f26e49663b51e530b4a37bee0b13004ca220bf04b6023d43c4a","7f538eda759c7d51f7ebbb084ce4901673d18899277b31443f3e01463f963c96","656e892b619fbffc331d8b5a1e858dfd68b13357a721b0329ddff60c5888fa5c","9c4a7e947c410b3f20cb1d28bc9c8a5f83182411db5441219323e367736406a1","1f1420a2e5b2a97da7dbe4ecc8a96a744889322806b654a2af8413100931e0c0","7ccf2833927ed7ffdadde0994889fc680cab8722236534326058c13021930a0e"],"paragraph_range_zero_based":[35304,35327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35304"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-ResourceSet ID of a PRS resourceSet.","paragraph_zero_based":35328},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceId","paragraph_zero_based":35329},{"literal_text_all_w_t_and_m_t":"This field specifies the PRS-Resource ID of a PRS resource. If this field is absent, the UE determines the dl-PRS-ResourceID based on its PRS measurement from the TRP (see TS 37.355 [49]) and DL-PRS Resource Set.","paragraph_zero_based":35330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35331},{"literal_text_all_w_t_and_m_t":"SSB-Configuration field descriptions","paragraph_zero_based":35332},{"literal_text_all_w_t_and_m_t":"halfFrameIndex","paragraph_zero_based":35333},{"literal_text_all_w_t_and_m_t":"Indicates whether SSB is in the first half or the second half of the frame. Value zero indicates the first half and value 1 indicates the second half.","paragraph_zero_based":35334},{"literal_text_all_w_t_and_m_t":"integerSubframeOffset","paragraph_zero_based":35335},{"literal_text_all_w_t_and_m_t":"Indicates the subframe boundary offset of the cell in which SSB is transmited.","paragraph_zero_based":35336},{"literal_text_all_w_t_and_m_t":"sfn0-Offset","paragraph_zero_based":35337},{"literal_text_all_w_t_and_m_t":"Indiactes the time offset of the SFN0 slot 0 for the cell with respect to SFN0 slot 0 of serving cell.","paragraph_zero_based":35338},{"literal_text_all_w_t_and_m_t":"sfn-Offset","paragraph_zero_based":35339},{"literal_text_all_w_t_and_m_t":"Specifies the SFN offset between the cell in which SSB is transmited and serving cell. The offset corresponds to the number of full radio frames counted from the beginning of a radio frame #0 of serving cell to the beginning of the closest subsequent radio frame #0 of the cell in which SSB is transmitted.","paragraph_zero_based":35340},{"literal_text_all_w_t_and_m_t":"sfn-SSB-Offset","paragraph_zero_based":35341},{"literal_text_all_w_t_and_m_t":"Indicates the SFN offset of the transmitted SSB relative to the start of the SSB period. Value 0 indicates that the SSB is transmitted in the first system frame, value 1 indicates that SSB is transmitted in the second system frame and so on. The network configures this field according to the field ssb-Periodicity such that the indicated system frame does not exceed the configured SSB periodicity.","paragraph_zero_based":35342},{"literal_text_all_w_t_and_m_t":"ssb-Freq","paragraph_zero_based":35343},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the SSB.","paragraph_zero_based":35344},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":35345},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":35346},{"literal_text_all_w_t_and_m_t":"ssb-Periodicity","paragraph_zero_based":35347},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the SSB. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":35348},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":35349},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":35350},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":35351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f1673e3d49edb308ab0530055d0571114ddf68b3e47801c8f0b97ddd7779dd24","90e2011c963c0de24b9449bc0c48c1202029051940d26ca1f65b5af6731a4290","87929ba48b4c72641c811baa1b0f8d12b79f4d994865d8910c4563c9bc9dea35","88448cde0e72d44b22f4400d62b6e84e8ccc0be83038d909a7d23f654c7a87ba","605d579cbba6f4d99624f04e2354a76cb11e08b4f877e6148d93036acfa9f73f","45839577244c11759dc4db133efd3e37807e55482b7819bda57efef7e293f43e","7580725d74573d9005b8d6a4e6200ebd32c166c787f32df2da1a3110cc9d2915","fe79596f67a71c0deb88c0c052e524684eae0f59329d6f24c1780e4d57485d34","fb5df1cacbe8ff5f256e727e39bd84b8f1d6cd6fa2738738fc2e754e49f1dddf","ea9d6cd6665ccdd22cededb6f795133cb62a2d6c73996462634f73dc861e073d","87cfbaba7d240e1019734a6e98953bea644b3dd6799f9f34b86881451fbb7b86","9e5380f1adea8fb72c4dcd5b045e357bc614f86a32bc50bad70610558e4260bd","030dae39777b8aa550b7a6cd3f7835698b674a5b59e7571c86d3fcf85a8c7417","c3581a3df738495b6cb8211b3bbadeb4142207f25f1261590464a5ed91fb80bd","0e3343e548e7f66ba0543da440f39d32adaaa8d904ecc429115a833d9ab3b9ec","53dd39db28b6f942af8ebbd3d1e580eb248fdad66ea8e580241bb1d6a7858aff","5e62fa213909f9254a6d6076a6d8bb45ed6e4b592488669a7ac67d38628bd6e9","e18bb904168651e6dfbbc2172bb6684dd0924ad4973629bbaf65d932abb95d31","1927005e2023352f7ce025f328273561d17015b73055b7077aa6dfcd1eee5c8b","d482ff71d7dc131fd44776d5562c8b2c86e37e5ae9f478ecaf64ce493c8a1712","1a81fabb76273fc6cd2310a983a4d7071dc3a6d365296fdd20799ec27d7f36ac","3ea2785b54f3063d278dd908ebd4b57d88ba2f63f29fa24d000e594e86c54a2e","cf85284bb6a8c035c2f62f315d5b5180ac67b88025e6149bdf6d3340783cad65","3a34894b53c17599c1c6cdcf933a6f157a37cc78e2553447ba411ce67cffa211"],"paragraph_range_zero_based":[35328,35351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35328"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":35352},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":35353},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":35354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35355},{"literal_text_all_w_t_and_m_t":"TxHoppingConfig field descriptions","paragraph_zero_based":35356},{"literal_text_all_w_t_and_m_t":"numberOfHops","paragraph_zero_based":35357},{"literal_text_all_w_t_and_m_t":"This field specifies the number of hops. The configured values are 2,3,4,5,6.","paragraph_zero_based":35358},{"literal_text_all_w_t_and_m_t":"overlapValue","paragraph_zero_based":35359},{"literal_text_all_w_t_and_m_t":"This field specifies the overlap during SRS transmission in terms of number of resource blocks. Value zeroRB implies 0 RB, value oneRB corresponds to 1 RB, value twoRB corresponds to 2 RBs and so on. The same value for the overlapValue is configured to all the hops.","paragraph_zero_based":35360},{"literal_text_all_w_t_and_m_t":"slotOffsetForRemainingHopsList","paragraph_zero_based":35361},{"literal_text_all_w_t_and_m_t":"This field specifies the starting slot offset and starting symbol for the SRS resource with tx hopping for different resource types (aperiodic, semi-persistent or periodic SRS transmission). Each hop is configured with the same periodcity.","paragraph_zero_based":35362},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35363},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35364},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35365},{"literal_text_all_w_t_and_m_t":"DLorJointTCI-SRS","paragraph_zero_based":35366},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if srs-DLorJointTCI-State is configured, otherwise it is absent Need R.","paragraph_zero_based":35367},{"literal_text_all_w_t_and_m_t":"FollowUTCI","paragraph_zero_based":35368},{"literal_text_all_w_t_and_m_t":"The field is absent if the field followUnifiedTCI-State is present. Otherwise, it is optionally present, Need R.","paragraph_zero_based":35369},{"literal_text_all_w_t_and_m_t":"NonCodebook","paragraph_zero_based":35370},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in case of non-codebook based transmission, otherwise the field is absent.","paragraph_zero_based":35371},{"literal_text_all_w_t_and_m_t":"Pathloss","paragraph_zero_based":35372},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the IE SSB-InfoNcell is included in pathlossReferenceRS-Pos; otherwise it is optionally present, Need R","paragraph_zero_based":35373},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":35374},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon configuration of SRS-ResourceSet or SRS-Resource and optionally present, Need M, otherwise.","paragraph_zero_based":35375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["12668b2eb445b9ca057c1eae4a00ace6ff84cfecea14c48589486095a88c662e","ca7570c78344337c24c47f9928c3569820e67a05ff7599b76f7b87a59f99fdc9","6ac40545b57f77c4e17b69406a1db956a2715affa2a033f21b18360f9f2e8217","294853fab4a331391e7fd69c8d1235aa634676545aa8b9b689a658f4a056728d","cd3c7dbb341c481ebadd49d4c5967ca0dd065a1ba3e50722fadd155fd8c23dc3","30c83e6cf958badaaaba1a6a25a2e64b30199a596f4d555525fecd427d329051","fb1491c85df37211cea05005e7a8a3e28eb456a616065562a5d2ebcafbca4877","f435f92ef604a6744f62cdd218e59f01e41d8b2b66fc1ea4dc8e0773a645d088","108a0d8d2c9073967299274c32b864833d256d08017b13b9a545c26dfbc227ee","1444d776c30e2900214bb47b3e30d7c05992fcaf0fd0b6c3aedcf6e6d6033749","bf26a93cf3efeee3791ee7f7b46d2465d50c7e835caa711f4f35f93360fb60a3","b39b309aa49d87216c7f2e38c18e74e146b5b74a051aceefb4560c8db4ce1618","dda33888eee4c012b49d5c693913485f93c8d58862d5725844a3c3bf035e463e","91bfa03c0684f32ec618bdebeacee57be804619bedc89ad5d952452a7ed80837","916be68e1da24588c540529d43d97466fcbfef66854497e15863cc03d05045b8","060cdc9e407f8bcc3a6ccb8fe996c29d61ae03d457fdf61c8aaeceb289db4874","f8a156ba33624f71673a5214d8f00c9b37ec4f22e77fc8179368c8b89c57f15a","abd31338920074155957452829a1ba02b3a94cebe831c55b9c2beac6929136fd","62ff9dabe7d17ac7da0ffe5a900eef2ed51f6439d9fff2f0386e0b549da30feb","77126c0c53e7b9bc6c9fe67d383f4098403b12136c4e36f4489b76757b9118d2","f6e398296726b818632b391c2e824db13a84bc67a3f0fdb82f49105e04833411","5a46a77abef23ba58ce24dd3506847d5fdb468aa643cbce9862cb4b9853740ae","8c1fe80234db2f3bddef68ed7dbcb67f817c5220f295844847008a827cd0d8f4","77d59f448a02e8c8fb89b150fd6eef18a7f721afa666b5b90c5fb5eb2919a952"],"paragraph_range_zero_based":[35352,35375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35352"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35376},{"literal_text_all_w_t_and_m_t":"–SRS-PosTx-Hopping","paragraph_zero_based":35377},{"literal_text_all_w_t_and_m_t":"The IE SRS-PosTx-Hopping specifies the frequency hopping configuration for SRS for Positioning transmission.","paragraph_zero_based":35378},{"literal_text_all_w_t_and_m_t":"SRS-PosTx-Hopping information element","paragraph_zero_based":35379},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35380},{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-PosTx-Hopping-START","paragraph_zero_based":35381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35382},{"literal_text_all_w_t_and_m_t":"SRS-PosTx-Hopping-r18 ::=                       SEQUENCE {","paragraph_zero_based":35383},{"literal_text_all_w_t_and_m_t":"    srs-PosConfig-r18                               SRS-PosConfig-r17,","paragraph_zero_based":35384},{"literal_text_all_w_t_and_m_t":"    bwp-r18                                         BWP                                                              OPTIONAL, -- Need R","paragraph_zero_based":35385},{"literal_text_all_w_t_and_m_t":"    srs-PosUplinkTransmissionWindowConfig-r18       SetupRelease { SRS-PosUplinkTransmissionWindowConfig-r18 }       OPTIONAL  -- Need M","paragraph_zero_based":35386},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35388},{"literal_text_all_w_t_and_m_t":"SRS-PosUplinkTransmissionWindowConfig-r18 ::=   SEQUENCE {","paragraph_zero_based":35389},{"literal_text_all_w_t_and_m_t":"    startSFN-r18                                    INTEGER(0..1023),","paragraph_zero_based":35390},{"literal_text_all_w_t_and_m_t":"    windowPeriodicityAndOffset-r18                  CHOICE {","paragraph_zero_based":35391},{"literal_text_all_w_t_and_m_t":"        periodicityAndOffset-r18                        SRS-PeriodicityAndOffset-r16,","paragraph_zero_based":35392},{"literal_text_all_w_t_and_m_t":"        periodicityAndOffset-Ext-r18                    SRS-PeriodicityAndOffsetExt-r16","paragraph_zero_based":35393},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":35394},{"literal_text_all_w_t_and_m_t":"    duration-r18                                    ENUMERATED {s1,s2,s4,s6},","paragraph_zero_based":35395},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35396},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35398},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-PosTx-Hopping-STOP","paragraph_zero_based":35399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e9c10e4bea18c9b7cdc561a661ecdd0abf5dec1e7665fa172f77c53e8dbb5343","2efdcc35df37804e2110457f81da7876d29230609c100da3a2cbffe2f3c98a44","24380e6638c6cd68307abdb2fcfa590901f44a8c1bf9e51827d7e3bec6672df9","8861b5d46792fdfcdcc6b90aeb943f1049965ca491ddf7210020fdc46acc3a77","c712a6bdf3cc6ad3e916c03d8f8c7fb09b398ac346fe79bbfa7c4ea76919f4a8","2e6d59d24ff7ac69dc9f396ece462063cf94772dd8aebeb0033841d2fdc29884","09599b00505ffb31d60801059009228f8849eaff67d3459eabb9b7ce52c1d9c2","e28fa5271e3016f1f5bca4d6a3c49bef6d1fa79c1f6456e10aa244c23372fc56","87d9786ec2f8df62c2d83cbce085376d927d756df3970c0a01bd4720d10044cb","06af613db03c78050d481d7d01a9cb0aeb43a7ad97c161c77b9e09a66652fc10","aa4dc384f60667effe5e53846e236321cbc9c679830e0bf78d9f12bff9257c46","7af25b35ff94d72a3be64ebce3ba9e9e2f510e7afbbff9d06994a92bccf3657c","02e8279f6d2d3903cc214