{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourcePeriodicityAndOffset is used to configure a periodicity and a corresponding offset for periodic and semi-persistent CSI resources, and for periodic and semi-persistent reporting on PUCCH. both, the periodicity and the offset are given in number of slots. The periodicity value slots4 corresponds to 4 slots, value slots5 corresponds to 5 slots, and so on.","paragraph_zero_based":21864},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset information element","paragraph_zero_based":21865},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21866},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCEPERIODICITYANDOFFSET-START","paragraph_zero_based":21867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21868},{"literal_text_all_w_t_and_m_t":"CSI-ResourcePeriodicityAndOffset ::=    CHOICE {","paragraph_zero_based":21869},{"literal_text_all_w_t_and_m_t":"    slots4                                  INTEGER (0..3),","paragraph_zero_based":21870},{"literal_text_all_w_t_and_m_t":"    slots5                                  INTEGER (0..4),","paragraph_zero_based":21871},{"literal_text_all_w_t_and_m_t":"    slots8                                  INTEGER (0..7),","paragraph_zero_based":21872},{"literal_text_all_w_t_and_m_t":"    slots10                                 INTEGER (0..9),","paragraph_zero_based":21873},{"literal_text_all_w_t_and_m_t":"    slots16                                 INTEGER (0..15),","paragraph_zero_based":21874},{"literal_text_all_w_t_and_m_t":"    slots20                                 INTEGER (0..19),","paragraph_zero_based":21875},{"literal_text_all_w_t_and_m_t":"    slots32                                 INTEGER (0..31),","paragraph_zero_based":21876},{"literal_text_all_w_t_and_m_t":"    slots40                                 INTEGER (0..39),","paragraph_zero_based":21877},{"literal_text_all_w_t_and_m_t":"    slots64                                 INTEGER (0..63),","paragraph_zero_based":21878},{"literal_text_all_w_t_and_m_t":"    slots80                                 INTEGER (0..79),","paragraph_zero_based":21879},{"literal_text_all_w_t_and_m_t":"    slots160                                INTEGER (0..159),","paragraph_zero_based":21880},{"literal_text_all_w_t_and_m_t":"    slots320                                INTEGER (0..319),","paragraph_zero_based":21881},{"literal_text_all_w_t_and_m_t":"    slots640                                INTEGER (0..639)","paragraph_zero_based":21882},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21884},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCEPERIODICITYANDOFFSET-STOP","paragraph_zero_based":21885},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["56acc678603c3c4938ad86ac614f76e7c687da285325de88730afa5e201415f9","64a20c4a9a16d8f461941eefe0b14841ae782e275b30bf8b6b000e6bdc493298","459623eb88c3138782076af3f8e0c242a811598e40401e537619173006a5428c","4ebe113621e1ba86f3ed34c04246b8201d892008fc1f132bd86a810d9626b4db","1cfeabf58b65e5f9662f56444bd0722752b6ed82ce8c4b902641757113ae208a","65c222698c5c533ae2ad763c6f2dbed8a6ea3db8a544c563252e47d264d5ee3c","efc2f8095e62490c80bbb8f5291d6e125f950af1b647375a0dfc18ea3cd5209e","092c88cd14a2799e32e064f6abee8380f3c9deb9e0db25d8bced564709b8b7cc","2234e85d7f