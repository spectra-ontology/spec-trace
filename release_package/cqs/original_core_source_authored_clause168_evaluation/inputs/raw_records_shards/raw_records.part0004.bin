eb65b0913878e293edfe5fab23d00b741","61507653fe76d9df7652dff9d309861a4767ca60e8d38b809249785bee833162","3f7c7029ccbaebbec5e3ea5b2af1953815b5b32adafa07438a8eded2e90435a4","ea689b3cd3f4a7d04ab3c80a0b19a0f61716f437b62048f6d9d6fc58f2958b91","00b75dc6209c828845d139d003ac073adb09610efbd3a468bb1f6d07e41a99ff","52f81a45163a7ba2641ed28fbb10af04e3a76fd1a0b33d00429daccf7a004f71","27db08a456c21ca72cea152e37ce879fade57700d5864f53aa5437931a8c23f0"],"paragraph_range_zero_based":[33216,33239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33216"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"IntegrityProtAlgorithm ::=          ENUMERATED {","paragraph_zero_based":33240},{"literal_text_all_w_t_and_m_t":"                                        nia0, nia1, nia2, nia3, spare4, spare3,","paragraph_zero_based":33241},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":33242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33243},{"literal_text_all_w_t_and_m_t":"CipheringAlgorithm ::=              ENUMERATED {","paragraph_zero_based":33244},{"literal_text_all_w_t_and_m_t":"                                        nea0, nea1, nea2, nea3, spare4, spare3,","paragraph_zero_based":33245},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":33246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33247},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-STOP","paragraph_zero_based":33248},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33250},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig field descriptions","paragraph_zero_based":33251},{"literal_text_all_w_t_and_m_t":"cipheringAlgorithm","paragraph_zero_based":33252},{"literal_text_all_w_t_and_m_t":"Indicates the ciphering algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nea0-nea3 are identical to the LTE algorithms eea0-3. The algorithms configured for all bearers using master key shall be the same, and the algorithms configured for all bearers using secondary key, if any, shall be the same. If UE is connected to E-UTRA/EPC, this field indicates the ciphering algorithm to be used for RBs configured with NR PDCP, as specified in TS 33.501 [11].","paragraph_zero_based":33253},{"literal_text_all_w_t_and_m_t":"integrityProtAlgorithm","paragraph_zero_based":33254},{"literal_text_all_w_t_and_m_t":"Indicates the integrity protection algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nia0-nia3 are identical to the E-UTRA algorithms eia0-3. The algorithms configured for all bearers using master key shall be the same and the algorithms configured for all bearers using secondary key, if any, shall be the same. The network does not configure nia0 except for unauthenticated emergency sessions for unauthenticated UEs in LSM (limited service mode).","paragraph_zero_based":33255},{"literal_text_all_w_t_and_m_t":"If UE is connected to E-UTRA/EPC, this field indicates the integrity protection algorithm to be used for SRBs configured with NR PDCP as specified in TS 33.501 [11], and DRBs configured with integrity protection as specified in TS 33.401 [30]. The network does not configure nia0 for SRB3.","paragraph_zero_based":33256},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33257},{"literal_text_all_w_t_and_m_t":"–SelectedPSCellForCHO-WithSCG","paragraph_zero_based":33258},{"literal_text_all_w_t_and_m_t":"The IE SelectedPSCellForCHO-WithSCG is used to indicate the information of the selected target PSCell to target MN at execution of a conditional reconfiguration for CHO with candidate SCG(s).","paragraph_zero_based":33259},{"literal_text_all_w_t_and_m_t":"SelectedPSCellForCHO-WithSCG information element","paragraph_zero_based":33260},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33261},{"literal_text_all_w_t_and_m_t":"-- TAG-SELECTEDPSCELLFORCHO-WITHSCG-START","paragraph_zero_based":33262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc32