{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"IAB-IP-Usage information element","paragraph_zero_based":43632},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43633},{"literal_text_all_w_t_and_m_t":"-- TAG-IAB-IP-USAGE-START","paragraph_zero_based":43634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43635},{"literal_text_all_w_t_and_m_t":"IAB-IP-Usage-r16 ::= ENUMERATED {f1-C, f1-U, non-F1, spare}","paragraph_zero_based":43636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43637},{"literal_text_all_w_t_and_m_t":"-- TAG-IAB-IP-USAGE-STOP","paragraph_zero_based":43638},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43639},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43640},{"literal_text_all_w_t_and_m_t":"–LoggingDuration","paragraph_zero_based":43641},{"literal_text_all_w_t_and_m_t":"The LoggingDuration indicates the duration for which UE is requested to perform measurement logging. Value min10 corresponds to 10 minutes, value min20 corresponds to 20 minutes and so on.","paragraph_zero_based":43642},{"literal_text_all_w_t_and_m_t":"LoggingDuration information element","paragraph_zero_based":43643},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43644},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGGINGDURATION-START","paragraph_zero_based":43645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43646},{"literal_text_all_w_t_and_m_t":"LoggingDuration-r16 ::=   ENUMERATED {","paragraph_zero_based":43647},{"literal_text_all_w_t_and_m_t":"                              min10, min20, min40, min60, min90, min120, spare2, spare1}","paragraph_zero_based":43648},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43649},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGGINGDURATION-STOP","paragraph_zero_based":43650},{"literal_text_all_