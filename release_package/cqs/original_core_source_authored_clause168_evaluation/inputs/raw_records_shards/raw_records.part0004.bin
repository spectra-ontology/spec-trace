{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the CBR threshold based on which UE determines whether the UE can keep using the carrier which was selected for the transmission of NR sidelink. See TS 38.321 [3].","paragraph_zero_based":45408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45409},{"literal_text_all_w_t_and_m_t":"–SL-IndirectPathAddChange","paragraph_zero_based":45410},{"literal_text_all_w_t_and_m_t":"The IE SL-IndirectPathAddChange specifies the configuration information of SL indirect path for SL indirect path addition/change in MP.","paragraph_zero_based":45411},{"literal_text_all_w_t_and_m_t":"SL-IndirectPathAddChange information element","paragraph_zero_based":45412},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45413},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INDIRECTPATHADDCHANGE-START","paragraph_zero_based":45414},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45415},{"literal_text_all_w_t_and_m_t":"SL-IndirectPathAddChange-r18 ::=          SEQUENCE {","paragraph_zero_based":45416},{"literal_text_all_w_t_and_m_t":"    sl-IndirectPathRelayUE-Identity-r18       SL-SourceIdentity-r17,","paragraph_zero_based":45417},{"literal_text_all_w_t_and_m_t":"    sl-IndirectPathCellIdentity-r18           CellIdentity,","paragraph_zero_based":45418},{"literal_text_all_w_t_and_m_t":"    t421-r18                                  ENUMERATED {ms50, ms100, ms150, ms200, ms500, ms1000, ms2000, ms10000},","paragraph_zero_based":45419},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45420},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45422},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INDIRECTPATHADDCHANGE-STOP","paragraph_zero_based":45423},{"literal_text_all_w_t_and_m_t":"-- ASN1STO