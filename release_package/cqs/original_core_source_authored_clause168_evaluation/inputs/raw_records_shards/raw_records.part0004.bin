{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-AllowedCarrierFreqSet1-r18        SEQUENCE (SIZE (1..maxNrofFreqSL-r16)) OF INTEGER (1..maxNrofFreqSL-r16),","paragraph_zero_based":44808},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCarrierFreqSet2-r18        SEQUENCE (SIZE (1..maxNrofFreqSL-r16)) OF INTEGER (1..maxNrofFreqSL-r16)","paragraph_zero_based":44809},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44810},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44811},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-STOP","paragraph_zero_based":44812},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44814},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR field descriptions","paragraph_zero_based":44815},{"literal_text_all_w_t_and_m_t":"sl-LBT-SchedulingRequestId","paragraph_zero_based":44816},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for sidelink consistent LBT failure report, as specified in TS 38.321 [3].","paragraph_zero_based":44817},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPowerCA","paragraph_zero_based":44818},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all sidelink carriers.","paragraph_zero_based":44819},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToAddModList","paragraph_zero_based":44820},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to add and/or modify.","paragraph_zero_based":44821},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToReleaseList","paragraph_zero_based":44822},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to remove.","paragraph_zero_based":44823},{"literal_text_all_w_t_and_m_t":"sl-PHY-MAC-RLC-Config","paragraph_zero_based":44824},{"literal_text_all_w_t_and_m_t":"This field indicates the lower layer sidelink radio bearer configurations.","paragraph_zero_based":44825},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToAddModList","paragraph_zero_based":44826},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to add and/or modify. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":44827},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToReleaseList","paragraph_zero_based":44828},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to remove. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":44829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44830},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config field descriptions","paragraph_zero_based":44831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e637011de0864569cefd8548b659632467a52ffea2fe066f6d02ea515da64694","c2cfd270909f940756862f47c2c0bc8eac147facb7a130399e4e6974d1c975c8","f6591b7895b9c498c448283f55b69609482269f2b026a0bb5c931db56ef2af32","8a0f2e79c03b82f77362a6f0e6b0b9e5237d8fbf01fe309e8ed8210601968e61","9a4cfde4715fafcc73d59d52daa4664d4746d63cd04f6f73a5405fa32bc9c321","d7c8d1d15bf3ebb28bfdd219d63d5712a890a64a11d484f10fdac6ce961226d3","b501391453f39dfc0b70a7412879f961ff81f1472786ad0f092e5b44dd4ef207","d1f66e88b16af636c2fda85591649abba29d6814cbf834770f0526738da99494","f2ddcd8836e9874d725b8acff235112dfd76942308cac4d06c7c347cdb787bf6","fd47ae46bddad7b19ff00c4a493d3b37cc8b0bb6dff63a41ba112b48f23f40a4","889aca0b93fa859c2ff6f62945efe945f912e1bd0352b47b7420710fdcb7b562","1deba45a4a11d0e337c444799d9b80c6771ce1b7df1e25cd9883d8ba874db20e","d6ff33da1b348a922b63ab2ebe0efe96b8443b31434f11d1ded3c716be8a044e","a48e93820c1e481e2846c37f66ddc8a42be47fdb28cf72e81042441c5c39cd7a","4754ed81ebd93e65bda9aa3f4d1157aea159694168a858f97fe67a6b32507f07","bc00b9803dc79a10fcac724e7625a9899f9f21a634623f071f77854aefbdd6f3","b38b35e51c56beece9cb67aff4f6345dcc22808611440c80ab36a3683f1d51cb","32686aa452f0e06f24f8c8b8d9f0deba59f92ce1f3d4cec2362594e0565e5d69","78e5a445f4c81a7c47e3b93e1c42b5ced4445b7b8d574a556300ea3d4736ec42","3b981a3066f9f12da0b302b50d2dc8788d993adcc8c159ecf9cc69190b8ec229","dc3da3dc383de71cf08055cdb6a7d6470374697e96c66418f8a6c8f8fe2d514f","91ac077d692444e7791ba1a15ed00af9c8110cf91c45dfacc4efe910129be308","861109c25f665be6dc2f64e123168005fb375073d7f906563379cf3bde5fc8e5","eb2e977b51b1f4535b1a8393429450dd266cbe5f8c8431012bbcd61833fb7cb3"],"paragraph_range_zero_based":[44808,44831],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44808"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"networkControlledSyncTx","paragraph_zero_based":44832},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall transmit synchronisation information (i.e. become synchronisation source). Value on indicates the UE to transmit synchronisation information while value off indicates the UE to not transmit such information.","paragraph_zero_based":44833},{"literal_text_all_w_t_and_m_t":"sl-DRX-Config","paragraph_zero_based":44834},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration(s) for unicast, groupcast and/or broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":44835},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":44836},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":44837},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToAddModList, sl-FreqInfoToAddModListExt","paragraph_zero_based":44838},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to add and/or modify. If the network includes sl-FreqInfoToAddModListExt, it includes the same number of entries, and listed in the same order, as in sl-FreqInfoToAddModList.","paragraph_zero_based":44839},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToReleaseList","paragraph_zero_based":44840},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to remove. In this release, only one entry can be configured in the list.","paragraph_zero_based":44841},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToAddModList, sl-RLC-BearerToAddModListSizeExt","paragraph_zero_based":44842},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to add and/or modify.","paragraph_zero_based":44843},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToReleaseList, sl-RLC-BearerToReleaseListSizeExt","paragraph_zero_based":44844},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to remove.","paragraph_zero_based":44845},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToAddModList","paragraph_zero_based":44846},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to add and/or modify. Each PC5 Relay RLC channel configuration provided by network to L2 U2N Relay UE is uniquely associated with one L2 U2N Remote UE.","paragraph_zero_based":44847},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList","paragraph_zero_based":44848},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to remove.","paragraph_zero_based":44849},{"literal_text_all_w_t_and_m_t":"sl-ScheduledConfig","paragraph_zero_based":44850},{"literal_text_all_w_t_and_m_t":"Indicates the configuration for UE to transmit NR sidelink communication based on network scheduling. This field is not configured simultaneously with sl-UE-SelectedConfig. This field is not configured to a L2 U2N Remote UE.","paragraph_zero_based":44851},{"literal_text_all_w_t_and_m_t":"sl-UE-SelectedConfig","paragraph_zero_based":44852},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection. This field is not configured simultaneously with sl-ScheduledConfig.","paragraph_zero_based":44853},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":44854},{"literal_text_all_w_t_and_m_t":"Indicates whether CSI reporting is enabled in sidelink unicast. If the field is absent, sidelink CSI reporting is disabled.","paragraph_zero_based":44855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ede9ff093488d4d8af0498051acc554872e4ddd8f79c0a0cba493cf3f023d122","6fd6b9df89e93c558cc2eabb1fac13d4cdbace5d64a7d7025a1df4b9ca13a325","1e7cbecb2cf06dcd65c305ee059b78468ca69382e7dbab53dadf06098c7dda16","b511891f46544560d7d9dc7b906bdc3ed303df6315be6d6089e3d091fe3908b7","9b3281108a98c444856351ae5a10794e1867421601e349e614ce574421c27234","108865a33b7c15bf98051ac1bd016961077c3f4ede0b3a887eb9b9f61c22176b","11e48b2c4deca2c9e9073a05eddd9dfac8d29a43303be349330bab04f87188a5","126d945e8ebc113151549ce019796d07376f2923bb156be741c34b7270b75693","0cce9361be2f678b1c44f9e9e8a0c2d7244b99fa719b942bd5595e83d4eb7383","0bdc8ff0a251d45efa5ed5bba75731a311b383aca3e9e54f462e360c2451eaee","cf3ceeb9f9c00068358e2efc1ff24ea8b3668add9c5af36f5d55cf7a4250cf5e","412546e5f8ec652a538bd582d1d85ffb165909bcdb0ff8741919b0d48e3bccd4","33f6e3c9f0535be55312b23375364bd3797decbfbfca28f7be76d8401c43268a","81e14fa30347e23f236097551d9314bda2f997cc4addc5d69150c0516c5a9acb","b56be0f973056de900e20c223ed70049f9f573462617099852126eca987c5d3b","33437b534c3e89f0ffcb74f597420472a41f0a6872993eba66f76dacf6441a52","8c856ea31f1163fde9125d3d7212a81c3973131f64b4a201890c52a980e27fff","dec2281e2eac0ebcf6d7234b636354721bd35a28d9790c21238418ab7f657d5c","bb1f9bc263e10ba3025c682c41b94d1f6fdf413892bcb1fbb799bab38d4b38f6","9d2c09387e7fb31bb5e9996ce1dd465fa072a7e1451237f436b5d5dfe831274a","6a9070fd2dfac4278460f8fee96ff9dab40cbaa43ebf93c71f3935a2469fcf70","16d715516b02ea64356ec04ae71a101f64aceb22c5d003ade413fccbd0095b41","8a71707c2e7f5b7962f8c23a05d20502ba07a500b9d11e41bd958a5881e7fe6c","2c26350569989be263640f4c51609c4be76ce05cd573eaec00c0f57abde431dc"],"paragraph_range_zero_based":[44832,44855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44832"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-CSI-SchedulingRequestId","paragraph_zero_based":44856},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink CSI Reporting MAC CE and Sidelink DRX Command MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":44857},{"literal_text_all_w_t_and_m_t":"sl-PRS-SchedulingRequestId","paragraph_zero_based":44858},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink PRS Request MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":44859},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":44860},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":44861},{"literal_text_all_w_t_and_m_t":"sl-SyncFreqList","paragraph_zero_based":44862},{"literal_text_all_w_t_and_m_t":"Indicates a list of candidate carrier frequencies that can be used for the synchronisation of NR sidelink communication.","paragraph_zero_based":44863},{"literal_text_all_w_t_and_m_t":"sl-SyncTxMultiFreq","paragraph_zero_based":44864},{"literal_text_all_w_t_and_m_t":"Indicates that the UE transmits S-SSB on multiple carrier frequencies for NR sidelink communication. If this field is absent, the UE transmits S-SSB only on the synchronisation carrier frequency.","paragraph_zero_based":44865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44866},{"literal_text_all_w_t_and_m_t":"SL-SCCH-CarrierSetConfig field descriptions","paragraph_zero_based":44867},{"literal_text_all_w_t_and_m_t":"sl-AllowedCarrierFreqSet1, sl-AllowedCarrierFreqSet2","paragraph_zero_based":44868},{"literal_text_all_w_t_and_m_t":"Indicates the set of carrier frequencies applicable for the transmission of the MAC SDUs from the sidelink SRB logical channels whose associated destination is included in sl-destinationList. If present, network ensures allowedCarrierFreqSet1 and allowedCarrierFreqSet2 do not include the same carrier frequency. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":44869},{"literal_text_all_w_t_and_m_t":"sl-DestinationList","paragraph_zero_based":44870},{"literal_text_all_w_t_and_m_t":"This field indicates the list of destination identify that the allowedCarrierFreqSet1 and allowedCarrierFreqSet2 apply. Only destination identity for unicast link can be included in this field.","paragraph_zero_based":44871},{"literal_text_all_w_t_and_m_t":"sl-SRB-Identity","paragraph_zero_based":44872},{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink SRB identities that the allowedCarrierFreqSet1 and allowedCarrierFreqSet2 apply.","paragraph_zero_based":44873},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44874},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44875},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44876},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":44877},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":44878},{"literal_text_all_w_t_and_m_t":"L2RemoteUE","paragraph_zero_based":44879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912