{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CodebookVariantsList-r16 ::= SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesAlt-r16)) OF SupportedCSI-RS-Resource","paragraph_zero_based":38832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38833},{"literal_text_all_w_t_and_m_t":"SupportedCSI-RS-Resource ::=     SEQUENCE {","paragraph_zero_based":38834},{"literal_text_all_w_t_and_m_t":"    maxNumberTxPortsPerResource      ENUMERATED {p2, p4, p8, p12, p16, p24, p32},","paragraph_zero_based":38835},{"literal_text_all_w_t_and_m_t":"    maxNumberResourcesPerBand        INTEGER (1..64),","paragraph_zero_based":38836},{"literal_text_all_w_t_and_m_t":"    totalNumberTxPortsPerBand        INTEGER (2..256)","paragraph_zero_based":38837},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38839},{"literal_text_all_w_t_and_m_t":"SupportedCSI-RS-ReportSetting-r18 ::= SEQUENCE {","paragraph_zero_based":38840},{"literal_text_all_w_t_and_m_t":"     maxN4-r18                            ENUMERATED {n1, n2, n4, n8},","paragraph_zero_based":38841},{"literal_text_all_w_t_and_m_t":"     maxNumberTxPortsPerResource-r18      ENUMERATED {p2, p4, p8, p12, p16, p24, p32},","paragraph_zero_based":38842},{"literal_text_all_w_t_and_m_t":"     maxNumberResourcesPerBand-r18        INTEGER (1..64),","paragraph_zero_based":38843},{"literal_text_all_w_t_and_m_t":"     totalNumberTxPortsPerBand-r18        INTEGER (2..256)","paragraph_zero_based":38844},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38846},{"literal_text_all_w_t_and_m_t":"-- TAG-CODEBOOKPARAMETERS-STOP","paragraph_zero_based":38847},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38849},{"literal_text_all_w_t_and_m_t":"CodebookParameters field descriptions","paragraph_zero_based":38850},{"literal_text_all_w_t_and_m_t":"supportedCSI-RS-ResourceListAlt","paragraph_zero_based":38851},{"literal_text_all_w_t_and_m_t":"This field indicates the alternative list of SupportedCSI-RS-Resource supported for each codebook type. The supported CSI-RS resource is indicated by an integer value which pinpoints SupportedCSI-RS-Resource defined in CodebookVariantsList. The value 0 corresponds to the first entry of CodebookVariantsList. The value 1 corresponds to the second entry of CodebookVariantsList, and so on. For each codebook type, the field shall be included in both codebookParametersPerBC (but optional for single CC) and codebookParametersPerBand.","paragraph_zero_based":38852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38853},{"literal_text_all_w_t_and_m_t":"–DL-PRS-MeasurementWithRxFH-RRC-Connected","paragraph_zero_based":38854},{"literal_text_all_w_t_and_m_t":"The IE DL-PRS-MeasurementWithRxFH-RRC-Connected is used to convey the capabilities supported by the UE for PRS measurement with Rx frequency hopping within a measurement gap and measurement reporting in RRC_CONNECTED for RedCap UEs.","paragraph_zero_based":38855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e803b20e08829f5a3e60ed6ff0b9c1a43f9d0a78865d1681ee9b74db54e2f884","083b35e0024d137d9bffd986430ff4bc0e1ab9b7cf18d77b89174737c94594c9","430294161d25fcff05f38f3ea5a2770db154edca090efc1c5351bc681ade52d7","3e4c47fab7a02b7d9257c8f6d0637a926f5e25e79ab857d024ad8fc0bbf94ef6","45fdcf427c969cd51b78b11196c7cd049f5ed2c38d009c201fc32dd0f4a81b06","75