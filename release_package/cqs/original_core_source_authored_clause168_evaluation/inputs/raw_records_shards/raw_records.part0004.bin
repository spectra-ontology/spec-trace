{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–FreqPriorityListSlicing","paragraph_zero_based":23136},{"literal_text_all_w_t_and_m_t":"The IE FreqPriorityListSlicing indicates cell reselection priorities for slicing in SIB16.","paragraph_zero_based":23137},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing information element","paragraph_zero_based":23138},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23139},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTSLICING-START","paragraph_zero_based":23140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23141},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing-r17 ::= SEQUENCE (SIZE (1..maxFreqPlus1)) OF FreqPrioritySlicing-r17","paragraph_zero_based":23142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23143},{"literal_text_all_w_t_and_m_t":"FreqPrioritySlicing-r17 ::=     SEQUENCE {","paragraph_zero_based":23144},{"literal_text_all_w_t_and_m_t":"     dl-ImplicitCarrierFreq-r17            INTEGER (0..maxFreq),","paragraph_zero_based":23145},{"literal_text_all_w_t_and_m_t":"    sliceInfoList-r17                     SliceInfoList-r17                                               OPTIONAL  -- Cond Mandatory","paragraph_zero_based":23146},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23148},{"literal_text_all_w_t_and_m_t":"SliceInfoList-r17 ::=             SEQUENCE (SIZE (1..maxSliceInfo-r17)) OF SliceInfo-r17","paragraph_zero_based":23149},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23150},{"literal_text_all_w_t_and_m_t":"SliceInfo-r17 ::=                 SEQUENCE {","paragraph_zero_based":23151},{"literal_text_all_w_t_and_m_t":"    nsag-IdentityInfo-r17             NSAG-IdentityInfo-r17,","paragraph_zero_based":23152},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionPriority-r17  CellReselectionPriority                                             OPTIONAL,  -- Need R","paragraph_zero_based":23153},{"literal_text_all_w_t_and_m_t":"    nsag-CellReselectionSubPriority-r17 CellReselectionSubPriority                                        OPTIONAL,  -- Need R","paragraph_zero_based":23154},{"literal_text_all_w_t_and_m_t":"    sliceCellListNR-r17               CHOICE {","paragraph_zero_based":23155},{"literal_text_all_w_t_and_m_t":"        sliceAllowedCellListNR-r17        SliceCellListNR-r17,","paragraph_zero_based":23156},{"literal_text_all_w_t_and_m_t":"        sliceExcludedCellListNR-r17       SliceCellListNR-r17","paragraph_zero_based":23157},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL  -- Need R","paragraph_zero_based":23158},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["95396eaa5e0be80cc19326e2eaaf9fd6605d9e13e4adeae46315cb137760622d","a03a2f28a9e7fc78bf4ad2fc5c880bfc04f7f1ec406979a3bb52732be98973cf","734ba5ef1e09cd32dc0318901435a1fa78d2aa8849370dd37a7fee4761470a3f","2a58943074014b1b2d4915daec52b2ac63309a57ada3f22f6f4341ab94a10346","cc4255f4b3535593591e8ea0f1463f3af4a5a54fad7fb8ba9e613023c5977f2b","36fe949d0e4ae227ed5eb6c7bcf730256fa1f9c12a6e63077643b176394c3db0","a1fe0ab67d57bca657163ce9e1e6f10c96e71d062c3ea5c3247ce04f259c84ab","5f409eb4d58021904a0406422343913975ffaa9091800a061cd7982cbd7c906e","f1c399d91c2f2437d65aaf0114c34a52ec2d83368cd42ac8419cbdfdf82ba6b3","55ce73337665161973065f73517cdcdbf926256bef6d3132286a149b1147cc1c","98388c4a58cd1efb03f824f7d27ab01fd16fc63937e9885d9469e80d81dadb27","29278d613252b183507b55f7c21f7199c927dc840aa6eed45c8ea92caa44a83b","c33833a1f6dcfdff5c156e445406ec9a4234e34981a3e346a31c62df9202659e","1ad3ab9e980cdc48fae8fa7aa1699ab7deed0121ba44c0120f53775a2e07b282","214b9b708871e55d8a2c52b7e56e6467901dbea969c47b7f2301387739008d78","be82c323c4d17e01243ff03169feb94fdf5202f3d86803fa385a75862bf7f907","6f39781d235c27069d9f816c31cc3c3951fe750bacdd8dd94892e3cd0550e4a0","473fa73d629dc8bbb45017898a392d129fce5d48573dabd4eda3a51b921c995e","7b50f52f87d33d65a7084047904069310b869cded794cba7f622bf43365a5679","6e43bd0eab031f8ac960b41f6e42d70afb015fe649bc8f9c7f91a72043491578","03b840a15cc9be4489e4100bad29fb630dfafdcb35ea544bfd5fdc0cbd6a3012","cf3923dbbbfe6b87ecc0d8d5717137f4aa7768feef550b2a3978e639663c31e6","c503af7e54cbd54814b2abff373f39ce286f6aedfc3f7f2aed08a9bb353a0f4d","d5688f6827d9153b1580b42c5848d00c3d678221414bbe832bf0ad205775e97c"],"paragraph_range_zero_based":[23136,23159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23136"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23160},{"literal_text_all_w_t_and_m_t":"SliceCellListNR-r17 ::=           SEQUENCE (SIZE (1..maxCellSlice-r17)) OF PCI-Range","paragraph_zero_based":23161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23162},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQPRIORITYLISTSLICING-STOP","paragraph_zero_based":23163},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23165},{"literal_text_all_w_t_and_m_t":"FreqPriorityListSlicing field descriptions","paragraph_zero_based":23166},{"literal_text_all_w_t_and_m_t":"dl-ImplicitCarrierFreq","paragraph_zero_based":23167},{"literal_text_all_w_t_and_m_t":"Indicates the downlink carrier frequency to which sliceInfoList is associated with. The frequency is signalled implicitly, value 0 corresponds to the serving frequency, value 1 corresponds to the first frequency indicated by the InterFreqCarrierFreqList in SIB4, and value 2 corresponds to the second frequency indicated by the InterFreqCarrierFreqList in SIB4, and so on.","paragraph_zero_based":23168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23169},{"literal_text_all_w_t_and_m_t":"SliceInfo field descriptions","paragraph_zero_based":23170},{"literal_text_all_w_t_and_m_t":"sliceAllowedCellListNR","paragraph_zero_based":23171},{"literal_text_all_w_t_and_m_t":"List of allow-listed cells for slicing. If present, the cells listed in this list support the corresponding nsag-frequency pair, and the cells not listed in this list do not support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":23172},{"literal_text_all_w_t_and_m_t":"sliceCellListNR","paragraph_zero_based":23173},{"literal_text_all_w_t_and_m_t":"Contains either the list of allow-listed or exclude-listed cells for slicing. If absent, it implies all the cells support the corresponding nsag-frequency pair, according to 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":23174},{"literal_text_all_w_t_and_m_t":"sliceExcludedCellListNR","paragraph_zero_based":23175},{"literal_text_all_w_t_and_m_t":"List of exclude-listed cells for slicing. If present, the cells listed in this list do not support the corresponding nsag-frequency pair, and the cells not listed in this list support the corresponding nsag-frequency pair, according to TS 38.304 [20], clause 5.2.4.11.","paragraph_zero_based":23176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23177},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23178},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23179},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":23180},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":23181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23182},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL","paragraph_zero_based":23183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0c131596c532c6a55a2ff5782a0ab2fd4a41baf177f82ae02998b5cc0b050980","48c0441bff9f82cd94364ffb2a3659740ffa3aa15f5fc38834d12145f6023a24","770d2269c69b964f84bba6d726a82e29f5c055a966a4a9676bedaffabebb3e9e","4d240e02e4eee21c0770dd2bb911745c17c0731f1024216153ae128672b48da6","6aa838023ae17b8513193c92cd0b1579c11369e40defa9a6d046cbd513dd7f23","22271bfd99ebe6905cd40c5a053fe407ca88f7d5a201457a7235052cfcc1242f","c88d3caa619b1b325c43d9cd5ff3faf33446b1a4f51172870dafa97d2b34a66c","d565bea3dd27b388e2bff8a47f116c9e35b5fc3bf17f91919238f55dd2570ff5","969db5bb5cc8e8423f87386aa6fe701be7611844d6a9ce3e4fd7f1e9e148fd25","96e78fc1a9bb9d7c06bd0b1042be6c80088ce83bba55178d73bead71922396c0","3bd11c35efcd6d810e8bc5ca61d832239230e49d59aaa2be6dec3d6154f75b64","ede2b93db18b9810799cbb572f8a790961190c1b6589b056ef1464d960a4be9f","9e10b46ccecd84da0d083c88fdabff9a2e05e96008f61a1d96382008f7d8e325","9e5fd99dbe1177834f23a572ed8e099c809ada550ff1d7dd2719f3eb84b586e9","a45dafe2475c5c4dbba4d0544ed659cfd521c7c2c421243b14c9ad052818dd44","35a5ed55d19ba38de638f175a74c635088201c53e5f71d36effbad745702029d","c14ac9f636819e2b1398630c7adffd833218697d5784b75a7d1b0ce592d25382","453d3c10a247f4e518dd82aef704953629da0db1691f7f7b20b95b42e1a0d617","a24f2613e88b25a3d84c99df0d6658fa0166fbe7c3d0a8cf7c61cff68fc6186f","1212122132d2089a1220c0c864d6cee4f7f5e4078a553b2423f108ba1f23738e","dd238a9f8091dbe338094b7aed6af5a0d8c14bfa7e5ccb25f17806b01378522e","33f8530a66761b9da37b63c76be84d20fc7f7f60b165f84be98178e212589daa","e043d1cba953cf72697927c1715efe448e3e9f73570127dbbfd16bcf32624627","d0d62b15d58a7e704c27e1a4ff6b996496e3da60e28a6b583799a830f3c08942"],"paragraph_range_zero_based":[23160,23183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23160"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":23184},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL information element","paragraph_zero_based":23185},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23186},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-START","paragraph_zero_based":23187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23188},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL ::=                 SEQUENCE {","paragraph_zero_based":23189},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencySSB                ARFCN-ValueNR                                                   OPTIONAL,   -- Cond SpCellAdd","paragraph_zero_based":23190},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR,","paragraph_zero_based":23191},{"literal_text_all_w_t_and_m_t":"    absoluteFrequencyPointA             ARFCN-ValueNR,","paragraph_zero_based":23192},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":23193},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23194},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23195},{"literal_text_all_w_t_and_m_t":"    referenceCell-r18                   ServCellIndex                                                   OPTIONAL    -- Cond SSBlessSCell","paragraph_zero_based":23196},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23197},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23198},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23199},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-STOP","paragraph_zero_based":23200},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23202},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL field descriptions","paragraph_zero_based":23203},{"literal_text_all_w_t_and_m_t":"absoluteFrequencyPointA","paragraph_zero_based":23204},{"literal_text_all_w_t_and_m_t":"Absolute frequency position of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A (see TS 38.211 [16], clause 4.4.4.2). Note that the lower edge of the actual carrier is not defined by this field but rather in the scs-SpecificCarrierList.","paragraph_zero_based":23205},{"literal_text_all_w_t_and_m_t":"absoluteFrequencySSB","paragraph_zero_based":23206},{"literal_text_all_w_t_and_m_t":"Frequency of the SSB to be used for this serving cell. SSB related parameters (e.g. SSB index) provided for a serving cell refer to this SSB frequency unless mentioned otherwise. The CD-SSB of the PCell is always on the sync raster. Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15] or TS 38.101-5 [75]). If the field is absent, the SSB related parameters should be absent, e.g. ssb-PositionsInBurst, ssb-periodicityServingCell and subcarrierSpacing in ServingCellConfigCommon IE. If the field is absent, the UE obtains timing reference from the intra-band SpCell or intra-band SCell if applicable as described in TS 38.213 [13], clause 4.1, or from the SpCell or an SCell indicated by referenceCell, or from the \"default cell\" defined in TS [xx]. This is supported in case the SCell for which the UE obtains the timing reference is in the same or different frequency band as the cell (i.e. the SpCell or the SCell, respectively) from which the UE obtains the timing reference.","paragraph_zero_based":23207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0ab25d44746050dd30ca98bb749f3413907df2cfb4a51d317bc3fb74e583d516","83e6cbc6e55649f6e7de4238f153a0532cda421e27e4a1c10d53e058512420c2","b70c9dad0e49a42ab16b69e01eb31873a96e7dce9d9f0e482ba7611ce0728d76","69d207de57dd6394db29cad9651dc4c350cc390cbd79567f335c2831e0d251ad","5df2cf8fecaeaf62ef52cda577cc8ec43a78c505eb8d522b97509a30722d1b0f","63bd89ef2334acd7fff5df925b1ca75249857352883cc24bacf4587995f3128e","bde6c7b2d0e787e172315a22351427dfffee1f0777cc9ba480c071d0c9a77f22","859d6bc0690609d3e86ccfc793af631023bdaa76cf09399185e35d1a59870e3b","425ad3959e752f6782400c5d34111fbf8fa0c1333057d429f14018bca4592972","82f685c9595d3a0c8e3f32128dcf6ce88c5519b16d00688bfcf1aaf9f5a814c4","c0cadd4b41d533027f50e722df333d4b2ac81cf6aff0be0c5ec577ac9de69d33","ff82aa69ec27f28bbe633b691819b3870d2983869731f49baf8d97ccf6053f04","c60c3a942871cdfaf42c5507e69f430fc79fa610002dd2dd66e781f21021e923","967854985655c5c986469246b4de46162b0573f9236fe3a15679272c1c88ca05","ca62e8b8acdb9ef090ead2c753d990b95ac039f627393afe554572cbc4608ea8","d67ddf082dc6e40bf012ffcc850837df0c37c8412a7e1da26b772b58f67f533a","bbd6f84d1851edc3425f53fd1622a3a8300c39cb4730b6f8bc213dba55b2ed8e","812c79f00580983a44cbbfcf7212a157c4f8c1e224a7d763113efd7c5d8d6778","4039f1d47674db8a3fdea72a7c9f43df78b7663497d74311de9253d67997cf3d","0d4959e6ea6741ed4bca975f7a4b368ce76f47628cfcc3b0d49211cbf864b3ae","856b296da4f3492e410c1cad246bb615497b578a0185197cb4cf8e2ffbf60b25","8d72e839ed8b7aae7eb8e6509ecd6d5d3f5e57377cafa4676d0d8dde10ebb391","75e41c975ec8fa24d34f4b4829bc420735892673a0b884b948c91a94fca467df","85e5e7ff0670dbcf194d3d188211a64d0842546225936672940dffd01ec74e74"],"paragraph_range_zero_based":[23184,23207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For cells supporting (e)RedCap, this field corresponds to the CD-SSB.","paragraph_zero_based":23208},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":23209},{"literal_text_all_w_t_and_m_t":"List containing only one frequency band to which this carrier(s) belongs. Multiple values are not supported.","paragraph_zero_based":23210},{"literal_text_all_w_t_and_m_t":"referenceCell","paragraph_zero_based":23211},{"literal_text_all_w_t_and_m_t":"Indicates the reference cell, i.e. the cell which provides the timing reference and AGC source for the inter-band SSB-less SCell. If the reference cell is an SCell or PSCell, it should be an activated SCell or activated PSCell.","paragraph_zero_based":23212},{"literal_text_all_w_t_and_m_t":"If this field is absent a \"default cell\" is the reference cell as defined in TS 38.133 [14].","paragraph_zero_based":23213},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":23214},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A. The network configures a scs-SpecificCarrier at least for each numerology (SCS) that is used e.g. in a BWP (see TS 38.211 [16], clause 5.3).","paragraph_zero_based":23215},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23216},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23217},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23218},{"literal_text_all_w_t_and_m_t":"SpCellAdd","paragraph_zero_based":23219},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if this FrequencyInfoDL is for SpCell. Otherwise the field is optionally present, Need S.","paragraph_zero_based":23220},{"literal_text_all_w_t_and_m_t":"SSBlessSCell","paragraph_zero_based":23221},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if the inter-band SSB-less SCell is configured for this cell and absoluteFrequencySSB is absent. It is absent otherwise.","paragraph_zero_based":23222},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23223},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoDL-SIB","paragraph_zero_based":23224},{"literal_text_all_w_t_and_m_t":"The IE FrequencyInfoDL-SIB provides basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":23225},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB information element","paragraph_zero_based":23226},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23227},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-START","paragraph_zero_based":23228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23229},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB ::=             SEQUENCE {","paragraph_zero_based":23230},{"literal_text_all_w_t_and_m_t":"    frequencyBandList                   MultiFrequencyBandListNR-SIB,","paragraph_zero_based":23231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["17970a4de5871438bfa5309655808a769ae165f3a9595a874db3637557cd9ed0","51f77f259d9a405788e445bf5c6404b7cc742ab8b8602a1998e80be316111913","5ec499e4986fbb76013f851bec6b759e0b8bddba89a1d17fd565a9b68408cb95","c50d3b9e1ca8e297b8dcd5b59762d8ccead8f2cbc96960f3c3ec1ce53a19ffff","65cc472b79bb61ea5b9cc54af17a6f7ea57867487ce8a2c7344bf50c09be39ed","b5b6888723b942f1c059fda520cad4fce6e7ecb8b1d703bf312165d183995b3a","13da0ee7a69057f4c6f2e3e76e0b0810c938715ea3ba0dd52eccb54123664689","f5d1c1d72e83eca9ba70ef98cad053c22645ac5df980e07fe8c8456d5b11c239","908bb0c19f0fb5dca07151b9245b5f54d45e8976b78a04ebe1223391744d283b","c52f1b6bd01576622efd92d94b3dcc96caa67724b4d52f2e2efb1158a8e0dbd0","1d3784154c971ebdb6d473a07f4b33517e104053a1e4a5cdaeb4739b141cf745","c0d3eeeed5157a05578a1138fb488f2c9eda893de1f80ed6a74194b5313b4706","8c901dcc0e8402d8e41771d4bae75cdfd866d10173b1a1a282d838389fc38b07","166116a573be937349ddd0ea19aed1f6db78bf651433cb2a97689d710e2dcb98","bb51f581e571a663d856db90b41f039190280d67079ea2dc8731aa6f51ff1558","80f03d8edbd1ba34708b300886397471affe1b9b368c0f142413c30e60ea835e","5467fcbca49ab18d70bc7319065bb9d2661b2396a985f1e65aa4be6da5a5b475","1aa1b99d49e33e587a6e9e4d7d728b504c639a0bc72cc4af35e7df2aea98a4a9","aaa573bb4eb2316546831212c375ef727bdf6d1f604d31b8a381b1c5de6ae7ae","cbc549cb13ef5ae5faa585ec1ffd051b5532da7d78c26b9e1525516e5412fa67","d772988b848904865f48eb2620e3e55b27f3394837ea010a9f001b49ece7b3ad","53af7c59b45a487dddd7f320c89b6690155150258b8b3ddfcadcb2c75f7f612f","3fba984b1220e581246ab4be4a61725ec5fd498afc5d1cc3c99d14ed50a17542","a36a527210115cc22a438542800bb084ba8ff1e5f12dae69611801a12bf7b63c"],"paragraph_range_zero_based":[23208,23231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    offsetToPointA                      INTEGER (0..2199),","paragraph_zero_based":23232},{"literal_text_all_w_t_and_m_t":"    scs-SpecificCarrierList             SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier","paragraph_zero_based":23233},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23235},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v1760 ::=       SEQUENCE {","paragraph_zero_based":23236},{"literal_text_all_w_t_and_m_t":"    frequencyBandList-v1760             MultiFrequencyBandListNR-SIB-v1760","paragraph_zero_based":23237},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23239},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB-v1800 ::=       SEQUENCE {","paragraph_zero_based":23240},{"literal_text_all_w_t_and_m_t":"    frequencyBandListAerial-r18         MultiFrequencyBandListNR-Aerial-SIB-r18","paragraph_zero_based":23241},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23243},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQUENCYINFODL-SIB-STOP","paragraph_zero_based":23244},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23245},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23246},{"literal_text_all_w_t_and_m_t":"FrequencyInfoDL-SIB field descriptions","paragraph_zero_based":23247},{"literal_text_all_w_t_and_m_t":"offsetToPointA","paragraph_zero_based":23248},{"literal_text_all_w_t_and_m_t":"Represents the offset to Point A as defined in TS 38.211 [16], clause 4.4.4.2.","paragraph_zero_based":23249},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":23250},{"literal_text_all_w_t_and_m_t":"List of one or multiple frequency bands to which this carrier(s) belongs. If frequencyBandList-v1760 is present, it shall contain the same number of entries, listed in the same order as in frequencyBandList (without suffix).","paragraph_zero_based":23251},{"literal_text_all_w_t_and_m_t":"scs-SpecificCarrierList","paragraph_zero_based":23252},{"literal_text_all_w_t_and_m_t":"A set of carriers for different subcarrier spacings (numerologies). Defined in relation to Point A (see TS 38.211 [16], clause 5.3). The network configures this for all SCSs that are used in DL BWPs in this serving cell.","paragraph_zero_based":23253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23254},{"literal_text_all_w_t_and_m_t":"–FrequencyInfoUL","paragraph_zero_based":23255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cc348a7ea2e9a7ff84667e5f77358277e8038197ae37da084abb6e3651ab7923","48bdc383ef825254cdc21517f7447d769649249d88855b6ee873a1757f281583","3236d83ea3b7105a0e3d1f97516d964916553f7c7d10d2276b4728483243b6c6","f83746ed2dbe22305fe33337332c79399492414d7d5d5df36b000f730358d11c","ee88a16302ea8991ad3f5981d18f34f3ee062b6bfc515b1117d5f9c2ebf9c6f4","f55fa6690ef72e2b97ce129fb0c20636388cf6f444648b90318fe3fe8224b364","3c313aca79f2a3ff41da80528de554cc9a103781fd5f5754b38130edaae79c79","e0cf3c8779297231f7477c4858129a7f27760628ffd632fb71e4d3ad1a8235aa","6577d369e9e77d4eab7b4a98a926dcef0920e8c64dc13e0cd39be5d2c37b9621","e1c4ae268263d3618c7c3d698eefe2984f58e62cfb123f9c8aaecfdb78306b8f","913817d8676e839d137b037b242ef9356568cee4c3fb772f5bc97db1198a38d0","ac103e93def8f5afb7156efc49e0f4b00d1118385d5cc23d76f7a800589945e8","d45991940d1d5159255f02ecb35b91bf0c3bac