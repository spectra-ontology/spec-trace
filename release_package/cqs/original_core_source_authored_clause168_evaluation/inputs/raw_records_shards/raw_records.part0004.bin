{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalPaths-r16ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1488},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1489},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1490},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTEG-Request-r17ENUMERATED { case1, case2, case3, ... }","paragraph_zero_based":1491},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":1492},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTxTEGs-r17","paragraph_zero_based":1493},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n0, n2, n3, n4, n6, n8, ... }","paragraph_zero_based":1494},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":1495},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs-r17","paragraph_zero_based":1496},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n0, n2, n3, n4, n6, n8, ... }","paragraph_zero_based":1497},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":1498},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples-r17","paragraph_zero_based":1499},{"literal_text_all_w_t_and_m_t":"ENUMERATED { requested, ... }OPTIONAL, -- Need ON","paragraph_zero_based":1500},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest-r17SEQUENCE {","paragraph_zero_based":1501},{"literal_text_all_w_t_and_m_t":"type-r17LOS-NLOS-IndicatorType1-r17,","paragraph_zero_based":1502},{"literal_text_all_w_t_and_m_t":"granularity-r17LOS-NLOS-IndicatorGranularity1-r17,","paragraph_zero_based":1503},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":1504},{"literal_text_all_w_t_and_m_t":"}OPTIONAL, -- Need ON","paragraph_zero_based":1505},{"literal_text_all_w_t_and_m_t":"additionalPathsExt-r17ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1506},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request-r17","paragraph_zero_based":1507},{"literal_text_all_w_t_and_m_t":"ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1508},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport-r17ENUMERATED { requested }OPTIONAL, -- Need ON","paragraph_zero_based":1509},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":1510},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":1511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["6e5e1d3f027e14b8be8573c731c3b4aa9a8b3c2e1bdb70cfd0a0319f9706b95f","9ab44c8f4c002dfeb377ac9da7dea713673089f5ac43b156bb03e4280553cba7","4394d12da274b3a7d4b7edaadbed4b1f26c06b3fd856c4e8cffe88dc1984b504","aa48cac8a0cdf791ecb01bf31bd434b44ecb83962f44e737238886246a1a135f","e74b8ae2840f53ce7bfd9b0dbbc94432ebf3a75add71342a83e94ae9245cf377","9f3d95cd768c53520cf7a05c21fa763270f191979d39e96d6f36c15f72e19707","23b2711c827905bc1c9ba949b8f79cf28b8bb5aee16188951933e7999d6dc6c1","27c74b83b197829121d1e70d1b1c52629f3b432917849baeb904ca8f354c8a07","087b36a082b36e98fd7acd5a8221eb3c1baed1e29df49b604f8a2146934ab707","0455d64156475565fb5f48a69168cca1bbcc91660292608b890a52a4a339e31b","012dadadb216e4035143906f3d9925c4151adc1bd4ddfaa6a90689c68b8a866e","a1309d40a79ce08a5aa9f8095885d06285121b35914529e6b680df5c825e0eae","5c816f5722bc89822700e97f96bcf2251043eb56cedf6fc9e2d5a72874f4226e","2a0a20673f4be9c4fba29d69e094770f6394821a7634d6602532e45f2425ebc7","792cdcf444ebd357c112f7a4cff7c338a8754448cfbb1504bd74a061ecb04933","094652c0bbef81cf51e4f841bd3f69a7f8f64686c307fc67c369a8f89a2c0179","6c54ee7d54ffa615cf751f3ccf71e046413a99732d4cdda2ebc24ab63e472093","7f29bcf3e14fe637fd0e9ae76c8b43d8237a4f8643a5cc5c91f716129a88e361","75bdd9073edd9dcfe0a39320cbb77c4055901769491be498d4368194d693a232","b50d735ffd0aae953b46704ef22e4f6fd788cdc1ce0d45db617e71585cbec7ff","83376c9a7db30e8fae72ff3e89e41303b9d361e9e3fc78697fd40e38413515e9","1382c8842e5b884d38ae3d3ac3f99e3c491350c76e72754c039538980d2221c7","d7c0f151804a3fc178ad29f76aa6937507bd41c887908441eb7f3a160e2494a9","b2d082b15b3ed6e9f7682b7503516a9e572440e7f2916736ca637ef974e6bb7b"],"paragraph_range_zero_based":[1488,1511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1488"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1512},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest-r18SEQUENCE {","paragraph_zero_based":1513},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth-r18CHOICE {","paragraph_zero_based":1514},{"literal_text_all_w_t_and_m_t":"fr1ENUMERATED {mhz40, mhz50, mhz80, mhz100},","paragraph_zero_based":1515},{"literal_text_all_w_t_and_m_t":"fr2ENUMERATED {mhz100, mhz200, mhz400}","paragraph_zero_based":1516},{"literal_text_all_w_t_and_m_t":"}OPTIONAL-- Need ON","paragraph_zero_based":1517},{"literal_text_all_w_t_and_m_t":"}OPTIONAL, -- Need ON","paragraph_zero_based":1518},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactorExt-r18INTEGER (-6..-1)OPTIONAL,-- Need ON","paragraph_zero_based":1519},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequest-r18SEQUENCE {","paragraph_zero_based":1520},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequestedPFL-List-r18SEQUENCE (SIZE (2..3)) OF","paragraph_zero_based":1521},{"literal_text_all_w_t_and_m_t":"INTEGER (0..nrMaxFreqLayers-1-r16)OPTIONAL-- Need ON","paragraph_zero_based":1522},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1523},{"literal_text_all_w_t_and_m_t":"} OPTIONAL, -- Need ON","paragraph_zero_based":1524},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig-r18","paragraph_zero_based":1525},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig-r18OPTIONAL-- Need ON","paragraph_zero_based":1526},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1527},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1528},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1529},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-ReportConfig-r16 ::= SEQUENCE {","paragraph_zero_based":1530},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RxTxTimeDiffMeasPerTRP-r16INTEGER (1..4)OPTIONAL, -- Need ON","paragraph_zero_based":1531},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor-r16INTEGER (0..5)OPTIONAL  -- Need ON","paragraph_zero_based":1532},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1534},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["1c46ebb997170202832353e1cabe0435f106f380b611a35c1f525e09a9bf8a7d","e1a0bfbd5f4194999a24175d62a1e15df31f78ac1346b256fb294cae1188edad","6103010133521fa7f16256a3ae7eb8ba0d11c3ca3aed48abb3850863786e9109","d20e7dee882f3f1c55776232584b6ca1fd8c584206529cc7c72cd4017e25e20f","a85d45a205e242781ef24b3e5b5ec24dc046e8bbc2b65c8766132f5bc40d606c","efeb119fe6adb51976e721457604c934ec1cd2634fc252f4bc9639bc40b87889","c33b57a04517087eb4769d3a727c347cfc6fb4ae82e102b8e3142559c2d0e460","e15a5fa5125ec1a5658606bf73bc7426ad7bde889f286578033ccd1e75bbf879","ee969721a0c07df8d297a8eba4fb9f611fad1223a05d10ba33cadf684cfcbedd","6e0a8667277d7fd4283df9c8d2eaf349a74ae1b7bb34adc854182439bfd7b01e","b73e6c25089a5b0136fc19ba79959516d0f3f3a1c5b705ded7fb92b00c966971","19f79e8f7a7d7f692373b099f5cda7f5ae0eaef5d970fab6c352fd6ce9f8bb52","04b18750f7459215bc949342284539cc91d12d1a85f0c59de7db3298b8582227","7c4309a7cc1f84aa6f21d5b1985fb40459a2dc06773c860d7c37a2e11437c9e2","4701036596158ed31fab507b29e6716472040dafb606167d2551d71bcafc938d","f520d105d63077c024c5f8acb323a4425b8ac94f15c78bbc32b5ca4f79384e40","cbd0e1c91d49ab1312089f9ba3e039753bb51dd55b316a2bc6c7f0b2ef142d3b","605832dfaeffcd36727ed34e33b6d0ec46b5c2cc5dc91dcc2af0460240d1d734","e2a1960aca42d5e1ad47edd03b2b608871464f013ae4776dc7cb31bb696302d3","99570e3489bd33cd547524e34a9a16f3c94b8f91983cf777398cbe8fd073bb42","566aa288bd8643b21f0324563f97d8071fba70b1ed953b3d5e81e90e4b93b938","eaa52ed0bc0ef5984b3e35d5c1c55346786e6b79af79904c9c771f200dd5649f","d6cb530cf303b1e4ab8aa42858fb50ff81526c0b31a6a80a3741ebbf94e64d85","9cc569fd9b3d04d1dd792360995adc498fc5c8da993587431e886d89cbf6a871"],"paragraph_range_zero_based":[1512,1535],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1512"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1536},{"literal_text_all_w_t_and_m_t":"NR-Multi-RTT-RequestLocationInformation field descriptions","paragraph_zero_based":1537},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTimeDiffMeasurementInfoRequest","paragraph_zero_based":1538},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to report the DL-PRS Resource ID(s) or DL-PRS Resource Set ID(s) associated with the DL-PRS Resources(s) or the DL-PRS Resource Set(s) which are used in determining the UE Rx-Tx time difference measurements.","paragraph_zero_based":1539},{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements","paragraph_zero_based":1540},{"literal_text_all_w_t_and_m_t":"This field specifies the NR Multi-RTT measurements requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested. The dl-PRS-RSCP-Request means that the target device is requested to provide DL RSCP measurement.","paragraph_zero_based":1541},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability","paragraph_zero_based":1542},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device may request additional DL-PRS assistance data from the server. TRUE means allowed and FALSE means not allowed.","paragraph_zero_based":1543},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RxTxTimeDiffMeasPerTRP","paragraph_zero_based":1544},{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of UE-Rx-Tx time difference measurements for different DL-PRS Resources or DL-PRS Resource Sets per TRP. ","paragraph_zero_based":1545},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor, timingReportingGranularityFactorExt","paragraph_zero_based":1546},{"literal_text_all_w_t_and_m_t":"This field specifies the recommended reporting granularity for the UE Rx-Tx time difference measurements. Value (0..5) corresponds to (k0..k5) and value (-6..-1) corresponds to (kMinus6..kMinus1) used for nr-UE-RxTxTimeDiff and nr-UE-RxTxTimeDiffAdditional in NR-Multi-RTT-MeasElement. The UE may select a different granularity value for nr-UE-RxTxTimeDiff and nr-UE-RxTxTimeDiffAdditional. The timingReportingGranularityFactorExt should not be included by the location server and shall be ignored by the target device if timingReportingGranularityFactor is included. The timingReportingGranularityFactor should not be included by the location server and shall be ignored by the target device if timingReportingGranularityFactorExt is included.","paragraph_zero_based":1547},{"literal_text_all_w_t_and_m_t":"additionalPaths","paragraph_zero_based":1548},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathList in IE NR-Multi-RTT-SignalMeasurementInformation. If this field is present, the field additionalPathsExt shall be absent.","paragraph_zero_based":1549},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTxTEG-Request","paragraph_zero_based":1550},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the NR-UE-RxTx-TEG-Info in IE NR-Multi-RTT-SignalMeasurementInformation. Enumerated value 'case1' indicates that the target device is requested to provide the case1 choice in NR-UE-RxTx-TEG-Info, enumerated value 'case2' indicates that the target device is requested to provide the case2 choice in NR-UE-RxTx-TEG-Info, and so on.","paragraph_zero_based":1551},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTxTEGs","paragraph_zero_based":1552},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with N different UE RxTx TEGs and with the same UE Tx TEG. Enumerated value 'n0' indicates that the number N of different UE RxTx TEGs to measure the same DL-PRS Resource can be determined by the target device, value 'n2' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 2 different UE RxTx TEGs, value 'n3' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 3 different UE RxTx TEGs, and so on. When the location server requests aggregated measurements, this field indicates a request for configuring the target device to measure the same aggregated DL-PRS Resources of a TRP with N different UE RxTx TEGs.","paragraph_zero_based":1553},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-UE-RxTxTEG-Request should also be present.","paragraph_zero_based":1554},{"literal_text_all_w_t_and_m_t":"If this field is present, the field measureSameDL-PRS-ResourceWithDifferentRxTEGs should not be present.","paragraph_zero_based":1555},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs","paragraph_zero_based":1556},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with N different UE Rx TEGs. Enumerated value 'n0' indicates that the number N of different UE Rx TEGs to measure the same DL-PRS Resource can be determined by the target device, value 'n2' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 2 different UE Rx TEGs, value 'n3' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 3 different UE Rx TEGs, and so on. When the location server requests aggregated measurements, a request for configuring the UE to measure the same aggregated DL-PRS Resources of a TRP with N different UE Rx TEGs.","paragraph_zero_based":1557},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-UE-RxTxTEG-Request should also be present.","paragraph_zero_based":1558},{"literal_text_all_w_t_and_m_t":"If this field is present, the field measureSameDL-PRS-ResourceWithDifferentRxTxTEGs should not be present.","paragraph_zero_based":1559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["890791d0e440692a4f417e45eb135d623b0b4a036ca6a781eff3a56c3a7df5bb","7c4a8dd950e215db7fce5aa62bbacea3ebc3fd325521bfecfc41590fd98d2bc1","5c0f5da2efd499b9cc8f3b1cc8a12c0d4713263e02d1e6f6efbea078f8826306","35ecec09075018e8a50f05c5c271482d0f6bb279f9c214ab857df92a77be563a","afb2ed4b5580c8f881189184529b9a2709292a8ae559d2dabf2c01244f1e93f7","1c99f83bc10b1ab7502c5235e0b7b6a0599353ea463655838cd1cb1ab28b0ae3","40f68a3c8558a751e68c3821499a92fcf70f074af8959cb7b524a4656d5f30ed","c792b500f18670eced503df88bdb7a16f56bf04ede712a15d58d05d60f2c14f4","d7055325bbb99f20270be700bbccda1de7dce3edca0fda7238cea5a6a3c2564f","5b2cfc1fdb0e1dc71f8707ce4e953778c4b6b56cf1501f0fad875ed0e17b50b6","0236ebd145558514d06de3b9094bc0aebaf438bb66ac173e186c1061c9f78704","f88f6f169d27f2a8ef286b8dc8f6a30e03b8aa70ababf077436b3c1e413de29b","ffd6e360f4f8c6c36f5962961fd6759e0125fc31f8d2e059a72fbc206d080948","b4d4a0acd9e56c4813e3966e6fc98f0e1141751e14d1c18890cd6cb0dbe5b6a2","fe9a8cc23b1e96cd365fec1851120f940290f100a9b1ce58ed74f26607746d8a","afc52187c9f24102d6841db9265d06e815b4af157a14a3e80c51ae7efdfb9291","4f3f298e7ab0d56e2fa353365096d01d8da53cb59c09f36e7dff36c33f92b6a2","4a886c509f0156cc506c21094d186f7c4f2c9a1bce81f6b5d3b3c095e37abc44","7d4f17735a217408f817a6c0b8da8bcde5bb0acbe3f795ebf33e25a611c52e09","4bb31fb131bf4b0176e79980731145395d7134bec4bb453a97cb3c55e184b050","f11d25fd5a94ce9c72a9f579938f4fca8f3c53c3f047f046ab8846363a30e908","6d6c26a4efb2e1a3d661842cf31dd005678e331ef1bbf8e6c70ab93d13423ef0","d286154f8d94aaac8aa9c5c41547242e9656d7735b580679e0c7779e054597c7","a930989b741a8fdb2230c4c51132530ea8b214bc1c0413088dc20d41014c171d"],"paragraph_range_zero_based":[1536,1559],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1536"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples","paragraph_zero_based":1560},{"literal_text_all_w_t_and_m_t":"This field, if present and set to 'requested', indicates that the target device is requested to perform the requested measurements with reduced number of samples (M=1 or M=2) as specified in TS 38.133 [46]. When requested for aggregated measurements by the location server, this field indicates processing of reduced number of samples for the aggregated measurements.","paragraph_zero_based":1561},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest","paragraph_zero_based":1562},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the indicated type and granularity of the estimated LOS-NLOS-Indicator in the NR-Multi-RTT-SignalMeasurementInformation. ","paragraph_zero_based":1563},{"literal_text_all_w_t_and_m_t":"additionalPathsExt","paragraph_zero_based":1564},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathListExt in IE NR-Multi-RTT-SignalMeasurementInformation. If this field is present, the field additionalPaths shall be absent.","paragraph_zero_based":1565},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request","paragraph_zero_based":1566},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-DL-PRS-RSRPP for the additional paths in the field nr-AdditionalPathList or nr-AdditionalPathListExt. ","paragraph_zero_based":1567},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport","paragraph_zero_based":1568},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide multiple measurement instances in a single measurement report; i.e., include the nr-Multi-RTT-SignalMeasurementInstances in IE NR-Multi-RTT-ProvideLocationInformation.","paragraph_zero_based":1569},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2","paragraph_zero_based":1570},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability. When requested for aggregated measurements by the location server, this field indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability for the aggregated measurements.","paragraph_zero_based":1571},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest","paragraph_zero_based":1572},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use DL-PRS Rx hopping for performing UE-Rx-Tx time difference, RSRP (if requested in nr-RequestedMeasurements), or RSRPP measurements (if requested in nr-RequestedMeasurements) and report the hopping information used for performing the measurements. This field is not included when dl-PRS-RSCP-Request or nr-DL-PRS-JointMeasurementRequestis is included.","paragraph_zero_based":1573},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth","paragraph_zero_based":1574},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the total bandwidth in MHz across all hops for the DL-PRS measurement. If the configured value nr-DL-PRS-RxHoppingTotalBandwidth is larger than the configured DL-PRS bandwidth in the provided assistance data, the UE shall assume that the actual nr-DL-PRS-RxHoppingTotalBandwidth is equal to the width of the configured DL-PRS in the provided assistance data.","paragraph_zero_based":1575},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequest","paragraph_zero_based":1576},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to perform joint measurement across aggregated PFLs.","paragraph_zero_based":1577},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequestedPFL-List","paragraph_zero_based":1578},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to perform joint measurements on the indicated two or three PFLs that are linked for DL-PRS BW aggregation. Value 0 corresponds to the first frequency layer provided in nr-DL-PRS-AssistanceDataList, value 1 to the second frequency layer in nr-DL-PRS-AssistanceDataList, and so on.","paragraph_zero_based":1579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1580},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1581},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig","paragraph_zero_based":1582},{"literal_text_all_w_t_and_m_t":"This field indicates DL-PRS Resource Set(s) occurring within time window(s) for performing measurements where the time window is indicated by a start time, periodicity, offset and duration.","paragraph_zero_based":1583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["6be5f6f22024982b925b442b2df7d1188e7b220bda83f3e34b55d6e4e8b52e9a","e7ab22fa904552b76215940f127f09233012a0d0019cb8fd42f94b62a8a66424","2a201ae0d47e07ac6bfeec856be93fecff9a10096388652b73e0eced8d8283e5","0e05cc4554f63b22b28165dfd194e42f77c032d6958c1e76c969914466fd9de8","d13bac67306cf295381a31423fdd192d23210032cb40c4737ba066148611616a","c9a2a7951da7667eb663ee172fe8cf503d80c1e4499e9d602891ff35b4b72681","f4483ed84b9a9e9a7ff6c1cc947b5c6b506df46d980a8206af6ea28fe277309f","7adfaf702578631eccb6134bfbf09aa7ce18d2efff0905d1d176a87bfb9f4587","5b21abe24765ba2d218494e057c72b69633b0a8dd233ab8dc3c44937e263b379","e46a97bdf2fabaa3f4d295157e727bf68b068ff8ab24c52cc1c49e88d4ec5877","3945b3e91f29544ade9aff0b6c43ca107f123d2a9723debb2acb6d1e9965c90d","b9810dbac9a33e40efc22504912320ad26e464a6eb13d67fa0805d24a8cbaef9","76edbb0aa88aeef7baace013901d24e8748f9a5e6fdbe5977213865154f8148d","20a16f46ad25d0ce83f138ce1045b17b995db184afaa33a6a68781f22daff556","bfcad9d6881e3c57ff86eab46c79cab253542407c6cb35c589c74a3b29820904","25981ccb96579d264127aec056577f0bc29048af1eaacd7ad0c0364b0ef92d98","83faaaed86f07d765606de66b5024693576672f1f4a05ee207af1fb170fd118c","bece0e0a84617f3ab8e9220ee151562b93363bc43f9bca59ea29289166893fb1","c826861caf15138d7b31f794c411a999b507db6660a217f2b136887faea9bf25","e14066d4cf8eab94988075bae4a8ad9606419be391a3794b819063ad46003db3","309e0e9a035988ccfd885cfab1a7d08abbe30e27ec2ee29dd426020546c285af","4ffbfc2b524bc8a6cf31630da43cb78b88b9a30f42c90bce9b91742337adf8f7","5810b110eca906698f61004f15e584e0870840676db7604336a09b2b5d715df8","86e28f6f5228bad31f8b1826dcd8bfd15ea5961e354f986d7d8dd9641a0a1bf8"],"paragraph_range_zero_based":[1560,1583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1560"}
