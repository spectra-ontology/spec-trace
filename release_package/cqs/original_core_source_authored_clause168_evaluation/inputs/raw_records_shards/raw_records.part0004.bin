{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        }                                                                                                    OPTIONAL, -- Need R","paragraph_zero_based":45336},{"literal_text_all_w_t_and_m_t":"        ue-toUE-COT-SharingED-Threshold-r18     INTEGER (-85..-52)                                               OPTIONAL, -- Need R","paragraph_zero_based":45337},{"literal_text_all_w_t_and_m_t":"        harq-ACKFeedbackRatioforCW-AdjustmentGC-Option2-r18 INTEGER (10..100)                   OPTIONAL  -- Need R","paragraph_zero_based":45338},{"literal_text_all_w_t_and_m_t":"    }                                                                                                        OPTIONAL, -- Cond sib12","paragraph_zero_based":45339},{"literal_text_all_w_t_and_m_t":"    sl-PosBWP-List-r18                SEQUENCE ( SIZE (1..maxNrofSL-BWPs-r16)) OF SL-PosBWP-ConfigCommon-r18 OPTIONAL  -- Cond sib23","paragraph_zero_based":45340},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":45341},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45342},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-STOP","paragraph_zero_based":45343},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45344},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45345},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon field descriptions","paragraph_zero_based":45346},{"literal_text_all_w_t_and_m_t":"absenceOfAnyOtherTechnology","paragraph_zero_based":45347},{"literal_text_all_w_t_and_m_t":"Presence of this field indicates absence on a long term basis (e.g. by level of regulation) of any other technology sharing the carrier; absence of this field indicates the potential presence of any other technology sharing the carrier, as specified in TS 37.213 [48] clauses 4.5.5. This parameter is not expected to be provided if the sidelink carrier is overlapped with uplink carrier.","paragraph_zero_based":45348},{"literal_text_all_w_t_and_m_t":"sl-EnergyDetectionConfig","paragraph_zero_based":45349},{"literal_text_all_w_t_and_m_t":"Indicates whether to use the maxEnergyDetectionThreshold or the energyDetectionThresholdOffset (see TS 37.213 [48], clause 4.5.5).","paragraph_zero_based":45350},{"literal_text_all_w_t_and_m_t":"sl-EnergyDetectionThresholdOffset","paragraph_zero_based":45351},{"literal_text_all_w_t_and_m_t":"Indicates the offset to the default maximum energy detection threshold value. Unit in dB. Value -13 corresponds to -13dB, value -12 corresponds to -12dB, and so on (i.e. in steps of 1dB) as specified in TS 37.213 [48], clause 4.5.5.","paragraph_zero_based":45352},{"literal_text_all_w_t_and_m_t":"frequencyShift7p5khzSL","paragraph_zero_based":45353},{"literal_text_all_w_t_and_m_t":"Enable the NR SL transmission with a 7.5 kHz shift to the LTE raster. If the field is absent, the frequency shift is disabled.","paragraph_zero_based":45354},{"literal_text_all_w_t_and_m_t":"harq-ACKFeedbackRatioforCW-AdjustmentGC-Option2","paragraph_zero_based":45355},{"literal_text_all_w_t_and_m_t":"Indicates the ratio threshold for contention window adjustment for SL groupcast option 2 as specified in TS 37.213 [48], clause 4.5.4. Unit is percentage.","paragraph_zero_based":45356},{"literal_text_all_w_t_and_m_t":"sl-MaxEnergyDetectionThreshold","paragraph_zero_based":45357},{"literal_text_all_w_t_and_m_t":"Indicates the absolute maximum energy detection threshold value. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm) as specified in TS 37.213 [48], clause 4.5.5.","paragraph_zero_based":45358},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencyPointA","paragraph_zero_based":45359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5a2d02a327143be332c70f1206e89141bbe48c7999dbbb1b3f6fe3335a5389ba","bfcf573d0371066c4cbc9f2542770373fe9bd6e7588bae5105e3dfd0325fea7c","6b6d14cc429a3ff19fed6bfa5b779d8f2df9e74460c9d320ebe9827bf24387e3","0a23eb0847ac7e003034e7c2be5da514288386eb1a8fb1c596274a1fc6ce513e","6f1da9cd63e7c83465fd246405bd414a8c5b31279c666810ed93123a95d350c4","7194edbdc66b40b76e041e57c711ee0a72c6ded5272c98f70b72217b0baf5cbf","a59ab5c1254875ece8c0f0f574b1bd002d813e35ebfce5364632f26ca51809b3","13bf7ae8c5b5e846dd45c8307728aaed719ef69bbd101086dfc512166c80ee4f","996da19a6a8e436d4cb2136c6c8fc8ffe347fa16f54a3a1d165c1356f9307167","6ae172496a2e35de153f6b14d127cbe1f8d8f67bd78c15c3ffdb2d1c40080123","e27f774bbef6228ccb05f88ddf44c8622d43d082029944524881aac1984da5a7","d3478ac68bc8ffda2ecd4f0f21aac58b24b51d0791c73fce6c388cdbea193276","de695b3e2b248e8f0fa0a72ab130cbb116bf92ec712caba61451c10c7457baea","6c94f8cdd88b6a11777c6a3555e7b8f25fb72826e633bc36f490883595abe8ad","8fbcf6ca09798bca805aa94a2e6894121ee872a2fe194d71df8280057db3a72e","4f8e28e2f21835a429dad9a75b23602e95dc57787d3e67c8c2801709eab7601d","8b1302514f8cde829c7f8d7aa2366768731f2b2cc5114c4fd713caa4db0d2147","3c14346461daf5a56561773e83dab0bb5e79c1e6f56e3c057496a033a2baba8d","2a61c5798a2b847b722d40e648873e6e6c53d5fd3e6cc218cd14e30a4363bddd","4466a71f4cfaadf2d02b52a82a5b193d6a7716cad7ce7f1e8067190f9a59cd36","2797a50cb6ed733402ed2bef39b2b3f175591527852e7b211e8d289e17e4ac14","c4cd0b5beee2c7769acae285ebbf39530da94a8fb9ea468b5c6ee62ed564ffd2","85294bc2aa2c383c92cfc3ac5c2ddd9664c491fd9aeace473c288d98f732c975","b3d515658cb6fc76b8c3346784f5aae561ed3750d9c3b933e06b621123c346cd"],"paragraph_range_zero_based":[45336,45359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p45336"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Absolute frequency of the reference resource block (Common RB 0). Its lowest subcarrier is also known as Point A.","paragraph_zero_based":45360},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB","paragraph_zero_based":45361},{"literal_text_all_w_t_and_m_t":"Indicates the frequency location of sidelink SSB. The transmission bandwidth for sidelink SSB is within the bandwidth of this sidelink BWP.","paragraph_zero_based":45362},{"literal_text_all_w_t_and_m_t":"sl-BWP-List","paragraph_zero_based":45363},{"literal_text_all_w_t_and_m_t":"This field indicates the list of sidelink BWP(s) on which the NR sidelink communication configuration. In this release, only one BWP is allowed to be configured for NR sidelink communication.","paragraph_zero_based":45364},{"literal_text_all_w_t_and_m_t":"sl-NbAsSync","paragraph_zero_based":45365},{"literal_text_all_w_t_and_m_t":"This field indicates whether the network can be selected as synchronization reference directly/indirectly only, if sl-SyncPriority is set to gnss. If this field is set to TRUE, the network is enabled to be selected as synchronization reference directly/indirectly. The field is only present in SidelinkPreconfigNR. Otherwise it is absent. All values in sl-NbAsSync are same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies.","paragraph_zero_based":45366},{"literal_text_all_w_t_and_m_t":"sl-SyncTxDisabled","paragraph_zero_based":45367},{"literal_text_all_w_t_and_m_t":"Indicates that the carrier, even though equipped with synchronisation resources, cannot be used as a synchronisation carrier frequency to transmit S-SSB.","paragraph_zero_based":45368},{"literal_text_all_w_t_and_m_t":"sl-SyncPriority","paragraph_zero_based":45369},{"literal_text_all_w_t_and_m_t":"This field indicates synchronization priority order, as specified in clause 5.8.6. All values in sl-SyncPriority are same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies.","paragraph_zero_based":45370},{"literal_text_all_w_t_and_m_t":"sl-SyncConfigList","paragraph_zero_based":45371},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration by which the UE is allowed to receive and transmit synchronisation information for NR sidelink communication. Network configures sl-SyncConfig including txParameters when configuring UEs to transmit synchronisation information. If this field is configured in SL-PreconfigurationNR-r16, only one entry is configured in sl-SyncConfigList.","paragraph_zero_based":45372},{"literal_text_all_w_t_and_m_t":"ue-toUE-COT-SharingED-Threshold","paragraph_zero_based":45373},{"literal_text_all_w_t_and_m_t":"Indicates the energy detection threshold that is to be used by a UE to initiate a channel occupancy to be shared to other UE(s), and another UE that shares the initiated channel occupancy shall use this configured parameter for accessing the channel(s) as specified in TS 37.213 [48], clause 4.5.5 for sidelink channel access. Unit in dBm. Value -85 corresponds to -85 dBm, value -84 corresponds to -84 dBm, and so on (i.e. in steps of 1dBm).","paragraph_zero_based":45374},{"literal_text_all_w_t_and_m_t":"valueN","paragraph_zero_based":45375},{"literal_text_all_w_t_and_m_t":"Indicate the NR SL transmission with a valueN *5kHz shift to the LTE raster (see TS 38.101-1 [15], clause 5.4E.2).","paragraph_zero_based":45376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45377},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45378},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45379},{"literal_text_all_w_t_and_m_t":"V2X-SL-Shared","paragraph_zero_based":45380},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the carrier frequency configured for NR sidelink communication is shared by V2X sidelink communication. It is absent, Need R, otherwise.","paragraph_zero_based":45381},{"literal_text_all_w_t_and_m_t":"sib12","paragraph_zero_based":45382},{"literal_text_all_w_t_and_m_t":"This field is optional present if included within SIB12, need R. Otherwise, the field is absent.","paragraph_zero_based":45383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9327daa309f0908f2e6d27c932e0841df3260b255a092ce56b0b298debec26c8","aa7ebc7ea95efc2e1b489c6772d22f3d9d7257fb60525c04b7607270c7ecdcda","7f9248147eb0a923884d18155633096c1b58c8c7f65902fecbdaaa44c1f602c0","e1a6ea75a4e874ea5a521465fea8e93ef9516c3d9607d8c48a8ac2a2c817e126","363470bb565b03a04ad03dc189833a412db3c0420aef252276ac7b6a17103bab","105aab13df420fd830b5184f2571fc02ea55a08c3b1d03249b49a2385a233f38","9ca539baf31a702f9e0f86d78279c62797c753838e083cb2af8939d1d23e0e12","54f6de9a749d6acb324afc9070d96ca2f6f3897d8178ee3355c79a94690f1ccb","87ec5fc1b0c1530cc93191b9f2fb124e171e3f22d05e0343e4f1519f912fc665","a283818ab0bef35ecec7f30b863752e1aed82b24b5aaf62020a97050e2c8f559","e77d4806198a5a53a53438313d61f9e07843349cba5ee4402f18d56948771b00","09d79e5e572e43a2ccc2463d71ba2b7a699762ec70e3d60f669d039376dc1f17","44c7a0679d7197b4806fe8c88b091c52d557c03a2de51f1a8a13b99ba5fb4241","71819917a8a2699d56ab4086d7c64b8efe1547d50c9141ae9fd90cfd67f739e9","be96d6be011fa1d4b40f2840617c379eb5dbc59ee2a0de19e7ed9e792b3274e7","77140a67e22d7245ecf41a904f20b0511e649f815c37d8ceab54a64dc8aa50b7","44ff0229e7705ff05f180ffbc1c10fb28608607719161645b1502b41307f5ea7","a49122942e062fb9feeea669cf1120bc7caa6d8b99e0222ec637364d3d8e6cea","c42587f40ea0a9c7cbc77f75eb0c28e3e1453de12cbade3c4898d585a556aba1","141aa12b76df637290d014e99a6d5a5c45705712f8519f03c8edf41102518ee7","06b95392c74d7f8782ae96e27fc93c98409094cea75b1d045da9b0e5c83cc2db","307ecfbfddf93e10bef32828454c0d1cc384e43d1f2756775692b1b950409463","4f75f7f6a099c3dc62d9742381504e46f1932741a9573910b3b7fe8ec7f1f37f","557f5a77f17c578df3c4f494abc458e02e816527865bc5129f7f2fb7d6d5b7f8"],"paragraph_range_zero_based":[45360,45383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p45360"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sib23","paragraph_zero_based":45384},{"literal_text_all_w_t_and_m_t":"This field is optional present if included within SIB23, need R. Otherwise, the field is absent.","paragraph_zero_based":45385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45386},{"literal_text_all_w_t_and_m_t":"–SL-FreqSelectionConfig","paragraph_zero_based":45387},{"literal_text_all_w_t_and_m_t":"The IE SL-FreqSelectionConfig specifies the configuration information for carrier selection for NR sidelink transmission using UE autonomous resource selection.","paragraph_zero_based":45388},{"literal_text_all_w_t_and_m_t":"SL-FreqSelectionConfig information element","paragraph_zero_based":45389},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45390},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQSELECTIONCONFIG-START","paragraph_zero_based":45391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45392},{"literal_text_all_w_t_and_m_t":"SL-FreqSelectionConfig-r18 ::=   SEQUENCE {","paragraph_zero_based":45393},{"literal_text_all_w_t_and_m_t":"    sl-priorityList-r18              SEQUENCE (SIZE (1..8)) OF INTEGER (1..8),","paragraph_zero_based":45394},{"literal_text_all_w_t_and_m_t":"    sl-threshCBR-FreqReselection-r18 SL-CBR-r16                                                          OPTIONAL, -- Need R","paragraph_zero_based":45395},{"literal_text_all_w_t_and_m_t":"    sl-threshCBR-FreqKeeping-r18     SL-CBR-r16                                                          OPTIONAL  -- Need R","paragraph_zero_based":45396},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45398},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQSELECTIONCONFIG-STOP","paragraph_zero_based":45399},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45401},{"literal_text_all_w_t_and_m_t":"SL-FreqSelectionConfig field descriptions","paragraph_zero_based":45402},{"literal_text_all_w_t_and_m_t":"sl-priorityList","paragraph_zero_based":45403},{"literal_text_all_w_t_and_m_t":"Indicates the list of sidelink logical channel priority which is associated with the configurations in sl-threshCBR-FreqReselection and in sl-threshCBR-FreqKeeping. ","paragraph_zero_based":45404},{"literal_text_all_w_t_and_m_t":"sl-threshCBR-FreqReselection","paragraph_zero_based":45405},{"literal_text_all_w_t_and_m_t":"Indicates the CBR threshold based on which UE determines whether the carrier frequency can be (re)selected for the transmission of NR sidelink. See TS 38.321 [3].","paragraph_zero_based":45406},{"literal_text_all_w_t_and_m_t":"sl-threshCBR-FreqKeeping","paragraph_zero_based":45407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6a37296687c5d3eb8841edd004c3955f8b12b156581b14186d6a1547dcaba904","57d1201a1a560bc9c2b7892d7cd3c2229d0e666c9fb3e11d31a00202e504fdcd","f7e00b1051c374191bc74619d55d80e38afcbced5b90257de47d3b79b3bdf513","b1b269469a11aadb0ab4631cd240954c327a0aed7a61c155513c5b367ac31d6c","2a0a03aaed4ffa66f539da3ff0095350abd982a3e903755281d3aa516d52e59e","03fb34b2a66e7b1467d841c750fb35d47f8199ff188de329c21f53040ea055db","aa71c7ace911adcb5e4a7faf2901c32fbc7c79275f2cbd2dfed2b7b73eb4ae4f","ce85fd79234eb8dcec2a04d3740562b913034bf5426fe29e62efcaabb3cfb5ab","a9d82c4d856756e9bfe36f6a2258446cff366d88280b81081b5b15949aea3699","dfef478e1923ce74d9c0828b1f3f758a60d27633275b35064494c6e0010f7510","669536766aa36c95cefb667894c7d02eebae23b5b1