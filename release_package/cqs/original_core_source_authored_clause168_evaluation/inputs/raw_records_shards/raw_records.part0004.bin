{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28008},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28009},{"literal_text_all_w_t_and_m_t":"RateMatchPatternGroup ::=               SEQUENCE (SIZE (1..maxNrofRateMatchPatternsPerGroup)) OF CHOICE {","paragraph_zero_based":28010},{"literal_text_all_w_t_and_m_t":"    cellLevel                               RateMatchPatternId,","paragraph_zero_based":28011},{"literal_text_all_w_t_and_m_t":"    bwpLevel                                RateMatchPatternId","paragraph_zero_based":28012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28014},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r16 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r16)","paragraph_zero_based":28015},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28016},{"literal_text_all_w_t_and_m_t":"MinSchedulingOffsetK0-Values-r17 ::=    SEQUENCE (SIZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r17)","paragraph_zero_based":28017},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28018},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDL-r16 ::=                INTEGER (1..8)","paragraph_zero_based":28019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28020},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigDCI-1-3-r18 ::=                    SEQUENCE {","paragraph_zero_based":28021},{"literal_text_all_w_t_and_m_t":"    resourceAllocationDCI-1-3-r18                  ENUMERATED {resourceAllocationType0, resourceAllocationType1, dynamicSwitch}","paragraph_zero_based":28022},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need M","paragraph_zero_based":28023},{"literal_text_all_w_t_and_m_t":"    rbg-SizeDCI-1-3-r18                            ENUMERATED {config1, config2, config3, spare1}               OPTIONAL, -- Cond DCI-1-3","paragraph_zero_based":28024},{"literal_text_all_w_t_and_m_t":"    resourceAllocationType1GranularityDCI-1-3-r18  ENUMERATED {n2,n4,n8,n16}                                    OPTIONAL,   -- Need S","paragraph_zero_based":28025},{"literal_text_all_w_t_and_m_t":"    numberOfBitsForRV-DCI-1-3-r18                  INTEGER (0..2)                                               OPTIONAL,   -- Need R","paragraph_zero_based":28026},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-1-3-r18              INTEGER (0..5)                                               OPTIONAL    -- Need R","paragraph_zero_based":28027},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28028},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28029},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-STOP","paragraph_zero_based":28030},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6228c1faa818bc0ca2198deae796771396a22be5cc22814109087bb45f65c7fb","86fbf0f8cbf410c81558fba2dc6a6baacf9fbe8ab4c373364d7aaa5cd243aec7","4e66b2578983fd9fbb6bae5a523b025f8c1f0736e41c9f7b5f9c4a1d93c8edcd","91da6d0be9c271712dabeee0b5413809820a588927be7538dd77a934f328d772","bbf8d7d0a5e8f9f069ee309ef654b1f2d6274cedc5999dd018f6275ed1d72020","287d84a0a69ace444b31769059a907aab8b74b45613b7b0090e3d777972e82ab","daa0c5de0b2c6ffd3599e96c7b04631abaa0334aec24aa097e85cd