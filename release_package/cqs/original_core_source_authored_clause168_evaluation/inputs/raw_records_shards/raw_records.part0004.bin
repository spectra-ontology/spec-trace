{"fields":{"filename":"R2-2404644.zip::R2-2404644_R17_RedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This annex lists the Change Requests (CRs) whose changes may be implemented by a UE of an earlier release than which the CR was approved in (i.e. CRs that contain on their coversheets the sentence \"Implementation of this CR from Rel-N will not cause interoperability issues\").","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"Table C-1: List of CRs Containing Early Implementable Features and Corrections","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"TDoc Number (RP-xxxxxx): CR Title","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"CR Number(s)","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"CR Revision Number(s)","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"Earliest Implementable Release","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"Additional Information","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"RP-200335: Correction on usage of access category 2 for UAC for RNA update","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"1141","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"Release 15","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"RP-201185: Introduction of signalling for high-speed train scenarios","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"1464","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"5","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"Release 15","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"RP-201216: Release-16 UE capabilities based on RAN1, RAN4 feature lists and RAN2","parag