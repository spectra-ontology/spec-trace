{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46262},{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNumList-r16 ::=     SEQUENCE (SIZE (1..8)) OF SL-CG-MaxTransNum-r16","paragraph_zero_based":46263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46264},{"literal_text_all_w_t_and_m_t":"SL-CG-MaxTransNum-r16 ::=                  SEQUENCE {","paragraph_zero_based":46265},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":46266},{"literal_text_all_w_t_and_m_t":"    sl-MaxTransNum-r16                         INTEGER (1..32)","paragraph_zero_based":46267},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46269},{"literal_text_all_w_t_and_m_t":"SL-PeriodCG-r16 ::=            CHOICE{","paragraph_zero_based":46270},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG1-r16               ENUMERATED {ms100, ms200, ms300, ms400, ms500, ms600, ms700, ms800, ms900, ms1000, spare6,","paragraph_zero_based":46271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2cd88eaa7b42fcb8c3488a536c76881557920f5983b25afe42c01d72404e8be8","4b72c9d00321c3e04eda0689ffccb4b7e58aa740c41731ca16eb84d20905f90b","adb51667266f52119b1456dbda76b18adf6d019f462ccade6a20fb30870abde1","bd78d1d3b9fbd8c81db972f16f297ca808697f17d7a8beadd34585c9271656d4","a9364f3e497d2cda4864bc6902c63c4251fa0b55f8a6172f4cdd92107fa187c4","5bcbfa91999fd7cc86500c4b378b340eba4660db7bef54d1df564d301c1c2578","7c24dbb69f9c379b63abc260f3ca4f2d3c3e281604e78606e92d44764c3f1662","b07dcdac9822a53320a6956c4a9859d5930192f5058074dcf37b4b013c6ee097","ccb7d60f3d62cab6153a5c648ae930f3e4b75b