{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates a sidelink DRX configuration for groupcast communication, which is applicable to any QoS profile or any Destination Layer-2 ID.","paragraph_zero_based":45120},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-InactivityTimer","paragraph_zero_based":45121},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms, ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. This field is only valid for groupcast communication.","paragraph_zero_based":45122},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-RetransmissionTimer","paragraph_zero_based":45123},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the sidelink BWP where the transport block was received. Value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":45124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45125},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigUC","paragraph_zero_based":45126},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigUC is used to configure sidelink DRX related parameters for unicast communication.","paragraph_zero_based":45127},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC information element","paragraph_zero_based":45128},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45129},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGUC-START","paragraph_zero_based":45130},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45131},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC-r17 ::=                 SEQUENCE {","paragraph_zero_based":45132},{"literal_text_all_w_t_and_m_t":"    sl-drx-onDurationTimer-r17              CHOICE {","paragraph_zero_based":45133},{"literal_text_all_w_t_and_m_t":"                                                subMilliSeconds INTEGER (1..31),","paragraph_zero_based":45134},{"literal_text_all_w_t_and_m_t":"                                                milliSeconds    ENUMERATED {","paragraph_zero_based":45135},{"literal_text_all_w_t_and_m_t":"                                                    ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":45136},{"literal_text_all_w_t_and_m_t":"                                                    ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":45137},{"literal_text_all_w_t_and_m_t":"                                                    ms1600, spare8, spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":45138},{"literal_text_all_w_t_and_m_t":"                                            },","paragraph_zero_based":45139},{"literal_text_all_w_t_and_m_t":"    sl-drx-InactivityTimer-r17              ENUMERATED {","paragraph_zero_based":45140},{"literal_text_all_w_t_and_m_t":"                                                ms0, ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60, ms80,","paragraph_zero_based":45141},{"literal_text_all_w_t_and_m_t":"                                                ms100, ms200, ms300, ms500, ms750, ms1280, ms1920, ms2560, spare9, spare8,","paragraph_zero_based":45142},{"literal_text_all_w_t_and_m_t":"                                                spare7, spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":45143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["36b456ce90f1e9e94756611d6728d9e799c0baf36f02a850b0f474c2cfd30a2a","b2239e381e83124a568ae2a3442e8594bad65ffeb2