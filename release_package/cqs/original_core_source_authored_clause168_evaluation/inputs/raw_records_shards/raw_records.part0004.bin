{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18312},{"literal_text_all_w_t_and_m_t":"RB-SetGroup-r17 ::=       SEQUENCE {","paragraph_zero_based":18313},{"literal_text_all_w_t_and_m_t":"    resourceAvailability-r17  SEQUENCE (SIZE (1..maxNrofResourceAvailabilityPerCombination-r16)) OF INTEGER (0..7) OPTIONAL, -- Need R","paragraph_zero_based":18314},{"literal_text_all_w_t_and_m_t":"    rb-Sets-r17                SEQUENCE (SIZE (1..maxNrofRB-Sets-r17)) OF INTEGER (0..7)                             OPTIONAL  -- Need R","paragraph_zero_based":18315},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18317},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYCOMBINATIONSPERCELL-STOP","paragraph_zero_based":18318},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18320},{"literal_text_all_w_t_and_m_t":"AvailabilityCombination field descriptions","paragraph_zero_based":18321},{"literal_text_all_w_t_and_m_t":"availabilityCombinationId","paragraph_zero_based":18322},{"literal_text_all_w_t_and_m_t":"This ID is used in the DCI Format 2_5 payload to dynamically select this AvailabilityCombination, see TS 38.213 [13], clause 14.","paragraph_zero_based":18323},{"literal_text_all_w_t_and_m_t":"resourceAvailability","paragraph_zero_based":18324},{"literal_text_all_w_t_and_m_t":"Indicates the resource availability of soft symbols for a set of consecutive slots in the time domain. The meaning of this field is described in TS 38.213 [13], Table 14.3. If included in RB-SetGroup within AvailabilityCombinationRB-Groups-r17, it indicates the availability of soft resources for an RB set group. If included in AvailabilityCombinationRB-Groups-r17 when the rb-SetGroups is not configured, it indicates the availability of soft resources in one or multiple slots for all RB sets of a DU cell.","paragraph_zero_based":18325},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18326},{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationsPerCell field descriptions","paragraph_zero_based":18327},{"literal_text_all_w_t_and_m_t":"iab-DU-CellIdentity","paragraph_zero_based":18328},{"literal_text_all_w_t_and_m_t":"The ID of the IAB-DU cell for which the availabilityCombinations are applicable.","paragraph_zero_based":18329},{"literal_text_all_w_t_and_m_t":"positionInDCI-AI","paragraph_zero_based":18330},{"literal_text_all_w_t_and_m_t":"The (starting) position (bit) of the availabilityCombinationId for the indicated IAB-DU cell (iab-DU-CellIdentity) within the DCI payload. If positionInDCI-AI-RBGroups is not configured, it applies to the availabilityCombinationId included in availabilityCombinations and in availabilityCombinationsRB-Groups. If positionInDCI-AI-RBGroups is configured, it applies to the availabilityCombinationId included in availabilityCombinations.","paragraph_zero_based":18331},{"literal_text_all_w_t_and_m_t":"positionInDCI-AI-RBGroups","paragraph_zero_based":18332},{"literal_text_all_w_t_and_m_t":"The (starting) position (bit) of the availabilityCombinationId associated to the availabilityCombinationsRB-Groups for the indicated IAB-DU cell (iab-DU-CellIdentity) within the DCI payload.","paragraph_zero_based":18333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18334},{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationRB-Groups field descriptions","paragraph_zero_based":18335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","p