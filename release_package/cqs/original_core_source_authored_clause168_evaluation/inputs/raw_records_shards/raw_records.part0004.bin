{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"HRNN-List","paragraph_zero_based":17256},{"literal_text_all_w_t_and_m_t":"The same amount of HRNN (see TS 23.003 [21]) elements as the number of NPNs in SIB 1 are included. The n-th entry of HRNN-List contains the human readable network name of the n-th NPN of SIB1. The hrnn in the corresponding entry in HRNN-List is absent if there is no HRNN associated with the given NPN.","paragraph_zero_based":17257},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17258},{"literal_text_all_w_t_and_m_t":"–SIB11","paragraph_zero_based":17259},{"literal_text_all_w_t_and_m_t":"SIB11 contains information related to idle/inactive measurements.","paragraph_zero_based":17260},{"literal_text_all_w_t_and_m_t":"SIB11 information element","paragraph_zero_based":17261},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17262},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB11-START","paragraph_zero_based":17263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17264},{"literal_text_all_w_t_and_m_t":"SIB11-r16 ::=                    SEQUENCE {","paragraph_zero_based":17265},{"literal_text_all_w_t_and_m_t":"    measIdleConfigSIB-r16            MeasIdleConfigSIB-r16                       OPTIONAL, -- Need S","paragraph_zero_based":17266},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension         OCTET STRING                                OPTIONAL,","paragraph_zero_based":17267},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17268},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17270},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB11-STOP","paragraph_zero_based":17271},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17273},{"literal_text_all_w_t_and_m_t":"SIB11 field descriptions","paragraph_zero_based":17274},{"literal_text_all_w_t_and_m_t":"measIdleConfigSIB","paragraph_zero_based":17275},{"literal_text_all_w_t_and_m_t":"Indicates measurement configuration to be stored and used by the UE while in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":17276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17277},{"literal_text_all_w_t_and_m_t":"–SIB12","paragraph_zero_based":17278},{"literal_text_all_w_t_and_m_t":"SIB12 contains NR sidelink communication/discovery configuration.","paragraph_zero_based":17279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d591482677c4e895ca6ca57505ea959b674224092731290b1d3dbbabf4b674db","6bb984bfb7c135979ba345fc02750723ae83a2afdfa39725bee4f3fe2a49fc87","aeed6814e9ef8562b5de8a41a0d58eed1a52fd5f7e820dcf4430696e6b75f5d2","ca0b6d44c64ab3eec687659bf77ff4bf46c9297e57b1786d4b74198ec626a3d4","e21add0bd4cacf759db03a7e92eb1c6cb5f08a575c103aa24e86bb02d5b27c56","40e5ac6d80517e8cb89b3b7366f9ae85d45def4ab4c2a1e23e8ee6d6b56e3fe7","33892574ed8661e77f02386ecaeb481ca630be41d6aa587a69a9a3588e5b0a09","e1154c2bb5f27fae8449da360d7d292096437627a3977450c8ea68d3fb8ada46","8508ceee81515a28e60845fa3871c40c57e3c45a05219f7a203972ab8794ec2a","726b07b6b3f31a75da046be0a68d18487082f9a571204bc8f16572f73aa40a2c","6395f2fa71bc1374d095337a4bd3b2f6d087d1e30703096e41ea05e629882924","16ac61bd424308f54b2b74d2376f86e967fe3150a529b890d41560a4c0eb4b63","5f0ad26d34957403868f54bec7c2f77d61451dccf662be6095948f92a6c5a3dd","3097d5874473c2e628f46c09e7e3b77a29c74253cc6735ad77e7ffffdecc50e0","4b371ff6a030e9d7329791921f73c8dfe40a53dffd18ca05fc32f