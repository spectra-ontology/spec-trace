{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If present, this field indicates that signalling of msg1 repetition is part of this feature combination. This field is not configured in a set of preambles that is configured with 2-step random-access type.","paragraph_zero_based":22992},{"literal_text_all_w_t_and_m_t":"msg3-Repetitions","paragraph_zero_based":22993},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that signalling of msg3 repetition is part of this feature combination. This field is not configured in a set of preambles that is configured with 2-step random-access type.","paragraph_zero_based":22994},{"literal_text_all_w_t_and_m_t":"nsag","paragraph_zero_based":22995},{"literal_text_all_w_t_and_m_t":"If present, this field indicates NSAG(s) that are part of this feature combination.","paragraph_zero_based":22996},{"literal_text_all_w_t_and_m_t":"redCap","paragraph_zero_based":22997},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that RedCap is part of this feature combination.","paragraph_zero_based":22998},{"literal_text_all_w_t_and_m_t":"smallData","paragraph_zero_based":22999},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that Small Data is part of this feature combination.","paragraph_zero_based":23000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23001},{"literal_text_all_w_t_and_m_t":"–FeatureCombinationPreambles","paragraph_zero_based":23002},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombinationPreambles associates a set of preambles with a feature combination. For parameters which can be provided in this IE, the UE applies this field value when performing Random Access using a preamble in this featureCombinationPreambles, otherwise the UE applies the corresponding value as determined by applicable Need Code, e.g. Need S. On a specific BWP, there can be at most one set of preambles associated with a given feature combination per RA Type (i.e. 4-step RACH or 2-step RACH) per MSG1 repetition number.","paragraph_zero_based":23003},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles information element","paragraph_zero_based":23004},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23005},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-START","paragraph_zero_based":23006},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23007},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles-r17 ::=   SEQUENCE {","paragraph_zero_based":23008},{"literal_text_all_w_t_and_m_t":"    featureCombination-r17                FeatureCombination-r17,","paragraph_zero_based":23009},{"literal_text_all_w_t_and_m_t":"    startPreambleForThisPartition-r17     INTEGER (0..63),","paragraph_zero_based":23010},{"literal_text_all_w_t_and_m_t":"    numberOfPreamblesPerSSB-ForThisPartition-r17 INTEGER (1..64),","paragraph_zero_based":23011},{"literal_text_all_w_t_and_m_t":"    ssb-SharedRO-MaskIndex-r17            INTEGER (1..15)                                           OPTIONAL, -- Need S","paragraph_zero_based":23012},{"literal_text_all_w_t_and_m_t":"    groupBconfigured-r17                  SEQUENCE {","paragraph_zero_based":23013},{"literal_text_all_w_t_and_m_t":"        ra-SizeGroupA-r17                     ENUMERATED {b56, b144, b208, b256, b282, b480, b640,","paragraph_zero_based":23014},{"literal_text_all_w_t_and_m_t":"                                                        b800, b1000, b72, spare6, spare5,spare4, spare3, spare2, spare1},","paragraph_zero_based":23015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8d86beca55ec6caf947704a0b14f19592ef7d4323f6463a8e35165943f257626","f60bd76ba0d4af821e73cbc0cea90d6dadf4380303693e8cfb8cd800b5cbaa9a","ad7e5fb942a584c108e7589eeab964234213d0cf996ce1787a83b01d7e29335c","f2bd6ab6a694e3e47b76c29d82cde591b290b30b1d9c7c37dafa7fe5de30494e","6b999c4bf45384aa52eb56a159082a21d809ec68e93e357c80c0ea84a95ba185","875118a95e867cd6065f417e0ce3037d12218aea59105adcce2e8c7da881bd28","78e3c71d199a1183b38b8937c669783c18b5d254cf1576fbfc017d9887fe90fb","687f933da86cc3329589e236841039a074b738aad99a64a716b77c5b5dc3034d","9225b87cc49a03ba1ae590969a9f7bb8b4398ca2ac926f47bf04722f1675daba","a025129b1132511a05fc85542a9ea902ecd715d2fbf6af33cc0356b6ae067513","4345cdaba54f2e66fba25820f013cc191c824125e7a5b4562715c9dac27ad754","27d1caacb3662bf353f17494068192e36d60b10c3e8c9783e3aed7051296c348","8b5b9206a4263792096b9ebc8900acbedc869bee52be2d6e1f57fbbb6c32c901","51df164fdb84e6f6ab2fdff164a3a225a63b16f71f3639313a9a6236ffcd6d6a","2e874086b99411dcdd493d667b2762ef743598ad6561ff9760b8a09d0fc5c910","a58e71cafc6d7c2c9e6d0bf168909575be5df070bce9b8723b881a0d41b27f5f","c050bca787d43d0000d39453060f0ae64c6133ff054df7f58933929b1cdca3b4","ceb89c776161df6452ccbf762b34d36d47a931073e4fcf3780c85af2d9fac599","c6e5cf7da419e50e01047c0dca067518f25b631ab0877c24f6d7520a93812078","30a5748fbf2cd19d55029622c9a5cfea5cccd3aa144559a5859242562dff9322","04dccb8a0c01380671944ff902eacd4039974e6a8a2da65f5b645a613383111d","3402d203a2c04e1f93dacd70af7549773f09e584af9c53e17f2fd5439d98d535","ea15a12d3ef6dd6a3e500e0df9799c0d45bbed1cc8764094f536113139572d48","49f85e49cd3303616d15ceed5e9345cd3595d4fd3cf4cac2503545accf21dca4"],"paragraph_range_zero_based":[22992,23015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22992"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        messagePowerOffsetGroupB-r17          ENUMERATED { minusinfinity, dB0, dB5, dB8, dB10, dB12, dB15, dB18},","paragraph_zero_based":23016},{"literal_text_all_w_t_and_m_t":"        numberOfRA-PreamblesGroupA-r17        INTEGER (1..64)","paragraph_zero_based":23017},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Need R","paragraph_zero_based":23018},{"literal_text_all_w_t_and_m_t":"    separateMsgA-PUSCH-Config-r17         MsgA-PUSCH-Config-r16                                     OPTIONAL, -- Cond MsgAConfigCommon","paragraph_zero_based":23019},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-Threshold-r17               RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":23020},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdSSB-r17                 RSRP-Range                                                OPTIONAL, -- Need R","paragraph_zero_based":23021},{"literal_text_all_w_t_and_m_t":"    deltaPreamble-r17                     INTEGER (-1..6)                                           OPTIONAL, -- Need R","paragraph_zero_based":23022},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23023},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23024},{"literal_text_all_w_t_and_m_t":"    msg1-RepetitionNum-r18                ENUMERATED {n2, n4, n8, spare1}                                   OPTIONAL, -- Cond Msg1Rep2","paragraph_zero_based":23025},{"literal_text_all_w_t_and_m_t":"    msg1-RepetitionTimeOffsetROGroup-r18  ENUMERATED {n4, n8, n16, spare1}                             OPTIONAL  -- Cond Msg1Rep3","paragraph_zero_based":23026},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23027},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23028},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23029},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATIONPREAMBLES-STOP","paragraph_zero_based":23030},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23031},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23032},{"literal_text_all_w_t_and_m_t":"FeatureCombinationPreambles field descriptions","paragraph_zero_based":23033},{"literal_text_all_w_t_and_m_t":"deltaPreamble","paragraph_zero_based":23034},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 or msgA-PUSCH and RACH preamble transmission. If configured, this parameter overrides msg3-DeltaPreamble or msgA-DeltaPreamble, Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1). If msgA-DeltaPreamble is configured in separateMsgA-PUSCH-Config-r17, this field is absent. This field is set to the same value for all FeatureCombinationPreambles for MSG1 repetitions.","paragraph_zero_based":23035},{"literal_text_all_w_t_and_m_t":"featureCombination","paragraph_zero_based":23036},{"literal_text_all_w_t_and_m_t":"Indicates which combination of features that the preambles indicated by this IE are associated with. The UE ignores a RACH resource defined by this FeatureCombinationPreambles if any feature within the featureCombination is not supported by the UE or if any of the spare fields within the featureCombination is set to true.","paragraph_zero_based":23037},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":23038},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on (see TS 38.321 [3], clause 5.1.2).","paragraph_zero_based":23039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bb2ff998a2321d8ede2bb154fcb505aa33dd013727fed394da7d06c9a377fbea","5959581de55fc74b7147fae3083252ec7662c38fe68386fefb637b10d7bad9a6","c308361b66948806e86e42f49636092023676f81231402e4a46912b2c2cf99db","ad54f995d4473b43ee4c9c14e2d8362c2de2cd9c875975f5cac6772f5544e7ed","4a4b718d38ea2be49b900026e6e05f87233671b79560f158a40af95554578a26","913e1931a79279a12c1cbe471145fd4d2514c053e30ce97605e44af2d0a9f3b1","402d412ddb1e82a4f97537aea2fed88e9ef479b1d5348de02a7d5651061e9b94","b78e25f0f0999df826eaa77864f0b4ffcb25012532cf3f27666aad4bb1486df1","46fa4c47390326d783c9314151d75b8c4ed861c40495b4e157904115a6a2c0d6","1ba764c832b19160e4939b3d42ab65ccc88b1517974c3467edb8c87f64015d2e","c2fa47949783b6e0699cdcf211c8a1d75391e58d71f79dff40ed7601296a0534","bb1ed72aeca80d2eae6d0b6ffdcf69e2dd73913cdb0c435712fddb16d35718fe","e384fce048e4dd5795b55eece67d7c61a0cd96316f2eb8d48b8110f952a6d2a3","cafe546d497d1523fdccfea7c50296ba02f9b9716cedb5ce2d56f915d0352d89","ce06daa48a7c8317e99f2c73e56250e5d4c38ae46e67b88e812f7ef77bd897f4","0f4dc7c7795b731f13b9f98c8ebcc84497a4c7856a0f24f008d9ec7ad82f642c","ddd949cb01554e7d4e853a4862c8deb0fc11c3a398f36458b712a035502e69ee","7912e777ecfdb2b416af4720d20ac7aa2464f630c61ee9694a98efb61fde7efc","1da695f96a57e40e719d7fff044fc9d7301a0733a6ab18fcaa3a44ba765ace46","42f26432368b32c4dc79cf2379149a7e415aa3a0662f579b5dd2aedff97a298e","2dd7b8c20ea8df38182fbeec2b5986dd9d76e57a6aec9e94c7a240002cfb407a","693a0967d5a96e1e768ac9c1baa03c7cba97e0b8162d8fecd9f9188466e170b2","5b56bc9f4d2f38fa72a4365a8256dc528aba08b1164d192f1c0706a1bc5a08de","b824d944d2a7c6d08e4bdfd7c5ada667e8a2d78741a4aeb63d914f667673cf5d"],"paragraph_range_zero_based":[23016,23039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23016"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msg1-RepetitionNum","paragraph_zero_based":23040},{"literal_text_all_w_t_and_m_t":"Indicates which MSG1-repetition number that this FeatureCombinationPreambles is associated with.","paragraph_zero_based":23041},{"literal_text_all_w_t_and_m_t":"msg1-RepetitionTimeOffsetROGroup","paragraph_zero_based":23042},{"literal_text_all_w_t_and_m_t":"Indicates a time offset of the starting ROs between two successive RO groups for a given repetition number (2, 4 or 8) associated with this FeatureCombinationPreambles for each frequency resource index within a time period (see TS 38.213 [13]). If this field is absent, the time offset is implicitly determined (see TS 38.213 [13]).","paragraph_zero_based":23043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23044},{"literal_text_all_w_t_and_m_t":"For each MSG1 repetition number, the following values are applicable.","paragraph_zero_based":23045},{"literal_text_all_w_t_and_m_t":"•{n16}, for RO groups for MSG1 repetition number 8","paragraph_zero_based":23046},{"literal_text_all_w_t_and_m_t":"•{n8, n16}, for RO groups for MSG1 repetition number 4","paragraph_zero_based":23047},{"literal_text_all_w_t_and_m_t":"•{n4, n8, n16}, for RO groups for MSG1 repetition number 2","paragraph_zero_based":23048},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-Threshold","paragraph_zero_based":23049},{"literal_text_all_w_t_and_m_t":"The UE selects 2-step random access type to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). This field is only present if both 2-step and 4-step RA type are configured for the concerned feature combination in the BWP. If configured, this parameter overrides msgA-RSRP-Threshold-r16. If absent, the UE applies msgA-RSRP-Threshold-r16, if configured","paragraph_zero_based":23050},{"literal_text_all_w_t_and_m_t":"numberOfPreamblesPerSSB-ForThisPartition","paragraph_zero_based":23051},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles are associated to the Feature Combination starting from the starting preamble(s) per SSB.","paragraph_zero_based":23052},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":23053},{"literal_text_all_w_t_and_m_t":"It determines how many consecutive preambles per SSB are associated to Group A starting from the starting preamble(s). The remaining preambles associated to the Feature Combination are associated to Group B","paragraph_zero_based":23054},{"literal_text_all_w_t_and_m_t":"ra-SizeGroupA","paragraph_zero_based":23055},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.2). If this feature combination preambles are associated to a RACH-ConfigCommon-twostepRA, this field correspond to ra-MsgA-SizeGroupA, otherwise it corresponds to ra-Msg3SizeGroupA.","paragraph_zero_based":23056},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":23057},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]). If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA, it corresponds to msgA-RSRP-ThresholdSSB, as defined in TS 38.321 [3]. If this parameter is included in FeatureCombinationPreambles which is included in RACH-ConfigCommon, it it corresponds to rsrp-ThresholdSSB, as defined in TS 38.321 [3].","paragraph_zero_based":23058},{"literal_text_all_w_t_and_m_t":"separateMsgA-PUSCH-Config","paragraph_zero_based":23059},{"literal_text_all_w_t_and_m_t":"If present it specifies how the 2-step RACH preambles identified by this FeatureCombinationPreambles are mapped to a PUSCH slot separate from the one defined in MsgA-ConfigCommon-r16. If the field is absent, the UE should apply the corresponding parameter in the RACH-ConfigCommonTwoStepRA of the BWP which includes the FeatureCombinationPreambles IE.","paragraph_zero_based":23060},{"literal_text_all_w_t_and_m_t":"ssb-SharedRO-MaskIndex","paragraph_zero_based":23061},{"literal_text_all_w_t_and_m_t":"Mask index (see TS 38.321 [3]).","paragraph_zero_based":23062},{"literal_text_all_w_t_and_m_t":"Indicates a subset of ROs where preambles are allocated for this feature combination.","paragraph_zero_based":23063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3804cec47aae8f5e8142e4cfb3f02cf6526112aca3c775022f1cbabd969b7e76","673a2f9eb406ac757ecaf304041ffdd3b7c5d9e368d003e367c9f87fadde0534","3b164e7cbca49d337ae93e28145cc5b2e8ccdb9ce2a20122269bddbb6326efe9","a16cbda22858e155122cb697142d6609d31f70f17463c9a050cb6a74ea5e9ccd","035c934a781e5791ce1cf87766cbd5c4e1d5ff0aac629635673a44326927b01c","afdfeb63ab6447ce029cc1dd6a53751e8d75fef3ad104b91d425f718b2e49271","585ea2904a87626f1680d73a87bc4849d4e16dedf02c9c7de4928b1b19f98e9c","1c5df5a09cd4172912b1d3cda40c5e0c508b7ee1b87f5b436c30498f7071c2aa","459bccb8f9437614cbfbc73aeba76f0fac892c7587f44303883071f4a61da8ea","f45ea0e1141c6544845e4d424434a458d47c32d5c8340df3eaa4ea401533e37b","1896e0cdf1e0e52e1995a584cc8e8973218111cd26de8ec10dca0b1611f6b774","a5554375fd985fd91ce44a75d2cadceb0bc409334a5ea5a8c6ee5dd81b58e6fa","254754f395edcdab11c6c7170d449e91475e9654a9f9c845f4059283041becd9","c596ce469fecafab4172bc77b40ac2d28d13bdaccf6e7b6365439419d523f641","0a319d66f484186b5d1da1ba45b9ecf9c9a7098394049400957a9e4ee96804ff","1fd1eef18fb8847355ed97e79f0995927ed1fbddd2ddad99972a7ed061d20124","5a579a61eb17251847dcd0cbe6aae1c27bf42b78949bb13f2f2271ecbb05f540","31f6b06e6479db7b210f4737c38a29b1488545fd732ebf34a0514c3192563e26","8f5249e2d6ccd8aa4ff2cd3a8ac02001768997c3d56987047f21c7fa45767f69","90366aadbd94527e75d824227abc3f471258a53ee657967cc409b3ec5daf2fa7","c2b27ff4568e7ce295ef21472eeac02c51ebb80fb0967c1e5c09c4ba6a807151","a051cdea88c90c5bd01143e292d1ec09154c5eb3f1861b733906adf204910b29","43d119e68c483070b1b3f91db1a5ca8e5f4d46a9996445fb4ad3f5498138e5c1","855498c370a216e763ab89626083cf1f43baac0d9fcdf9e9f64a5962d6b9428b"],"paragraph_range_zero_based":[23040,23063],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23040"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If this field is configured within FeatureCombinationPreambles which is included in RACH-ConfigCommonTwoStepRA:","paragraph_zero_based":23064},{"literal_text_all_w_t_and_m_t":"-in case of separate ROs are configured for 4-step and 2-step random access, this field indicates a subset of ROs configured within this RACH-ConfigCommonTwoStepRA;","paragraph_zero_based":23065},{"literal_text_all_w_t_and_m_t":"-in case shared ROs are used for 4-step and 2-step random access, it indicates the subset of ROs configured within RACH-ConfigCommon, which are the subset of ROs configured for 2-step random access.","paragraph_zero_based":23066},{"literal_text_all_w_t_and_m_t":"This field is configured when there is more than one RO per SSB. If the field is absent, all ROs configured in RACH-ConfigCommon or RACH-ConfigCommonTwoStepRA containing this FeatureCombinationPreambles are shared.","paragraph_zero_based":23067},{"literal_text_all_w_t_and_m_t":"startPreambleForThisPartition","paragraph_zero_based":23068},{"literal_text_all_w_t_and_m_t":"It defines the first preamble associated with the Feature Combination. If the UE is provided with a number N of SSB block indexes associated with one PRACH occasion, and N<1, the first preamble in each PRACH occasion is the one having the same index as indicated by this field. If N>=1, N blocks of preambles associated with the Feature Combination are defined, each having start index + startPreambleForThisPartition, where n refers to SSB block index (see TS 38.213 [13], clause 8.1).","paragraph_zero_based":23069},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23070},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23071},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23072},{"literal_text_all_w_t_and_m_t":"MsgAConfigCommon","paragraph_zero_based":23073},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if FeatureCombinationPreambles is included in RACH-ConfigCommonTwoStepRA. Otherwise, it is absent. If the field is absent in FeatureCombinationPreambles included in RACH-ConfigCommonTwoStepRA, the UE applies MsgA-PUSCH-Config included in the corresponding MsgA-ConfigCommon.","paragraph_zero_based":23074},{"literal_text_all_w_t_and_m_t":"Msg1Rep2","paragraph_zero_based":23075},{"literal_text_all_w_t_and_m_t":"The field is mandatory present, Need R, if msg1-Repetitions is included in FeatureCombination for this concerned FeatureCombinationPreambles. Otherwise, it is absent.","paragraph_zero_based":23076},{"literal_text_all_w_t_and_m_t":"Msg1Rep3","paragraph_zero_based":23077},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if msg1-Repetitions is included in FeatureCombination for this concerned FeatureCombinationPreambles. Otherwise, it is absent.","paragraph_zero_based":23078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23079},{"literal_text_all_w_t_and_m_t":"–FilterCoefficient","paragraph_zero_based":23080},{"literal_text_all_w_t_and_m_t":"The IE FilterCoefficient specifies the measurement filtering coefficient. Value fc0 corresponds to k = 0, fc1 corresponds to k = 1, and so on.","paragraph_zero_based":23081},{"literal_text_all_w_t_and_m_t":"FilterCoefficient information element","paragraph_zero_based":23082},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23083},{"literal_text_all_w_t_and_m_t":"-- TAG-FILTERCOEFFICIENT-START","paragraph_zero_based":23084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23085},{"literal_text_all_w_t_and_m_t":"FilterCoefficient ::=       ENUMERATED { fc0, fc1, fc2, fc3, fc4, fc5, fc6, fc7, fc8, fc9, fc11, fc13, fc15, fc17, fc19, spare1, ...}","paragraph_zero_based":23086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0e78316adaf47d79bfbd8d9d5efe75ba332aaf399131c8d9b8322d754045a87f","eabb170f0b9ea20055e808f2e136533996fc43f981405e4e1da80cc29a7ac299","8d240dffc00b26d676ac274035e620b719a0f936679191fbda134f80eb4d91ab","12093e980c5f9052e98383a1bcc04ee5878e3d332dae36a72be72c7b61b2d15a","145bb357791af9a9ae82845314bf91c82eb15cace66809acec946d83b99f8dd5","0d6c5807a1f4b833471a825ebd631ae0e7481e712f9a64f7c28beed5eba8f963","e7c3bc641e0fe773738f9e94c2e788b39746db1d01140273c1cb762a8c8aa559","7424bba35d04208e5c7c3e5aa8ededbed03327e6a3e3e2d691f79e6b4ef7b46d","76b9934079262485a938d7b652c4d903bb6e807a9b3cea870defe95ed31e6b65","9ddd6d747fd978c5a6a8a9b83568ca2ac13df6763e0ae2686d7d0888b57a5921","c7392db1171381441839ff522ee838c5a26436e54de97e322ff71437e2722270","04483253647d0271a7500520b78329f668269a18938ee77bd40c4d689bae6c95","406c40eadfa449b53cf3c072783c97ee4920cfca406a68b945e2f413699cc694","ed0c9689277b4232fb651d7b508cebf75cd07a5f6f98abf30259a270b10b5802","9f8f8354c20f0278f3c8c650cf11ada59f74e3ac8b94818e9fcf408ca6642340","759162c82a12f17d529cc18163d9a5676d38865a81e1f04b034e53c6563425d2","e166189d694a81b30dd00d85100ba10a80f0469fccdef38100658afad0eaa386","ede45e2ccb3a7fdd98fd4efd767a1e9e2c351344a5f163b2a2189883e12d0f9a","84cbe311c5eb458daa74bf8785a9206d09583bfac3327c2d8a577c890a728dd7","4857fa001d8e953cb846f128e6174486eb7e4ef61616706dca6a923c912526d2","93efbb71f5d9542fb47029c60684a5b6529355f113d0ce284bdea6c2951db245","e9470f6a47be7d8601980401f38c1aabaeca7b149622f0aee9e3025f734b12b5","90b61972eae56489b653c8f6c90e468379cc09cb92924120aa5c3f27720a57d5","4b02db80e17f4933dbdb0035f80dd244142a4d8ff41e3975eed693e878e2ded0"],"paragraph_range_z