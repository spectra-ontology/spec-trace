0","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["2bbd61e8aa2a007deb390acdc43efebd44fccb1c0df504bad2a851bcfa5ec8ce","d64d821f5cf70c7bc6c1e525c57f573544f18d5b25c3f1f3cd7e5da191191cd0","5e39b0937bf011e8fdda748639e22a433f8e931dfcd37486c0fc88fb9a9e30d6","3a2f59db4f1e79868534923b5d6bef352e9d646a6ef4621e4c95c2e88700e77f","cad46b0ce95c6d9b6011f9dc5427177ce72407d76aaaa70a981f41d163fc1a8d","de25561520bd96dbc752e1b2cb024e962475df951271a0514afb5bec61fe6497","ddd474e19007024516bce95a858f61ecc205c33609c6dd095029703f612391df","0b3c7472c8fd88cfc6d498615a1652f436ea53bae2839de6fe5aa9d9785413d0","d5c4ea1961a3b6e49d55e1c63c5d45b019bd344999be9cb6f80451543f965697","08e61c8f64ff4ea790c40288f4aec83ffdab3edd42a12385cfcd268ea2e41253","469eb23205107e6d44aa7523cc87e7112b6a5ae8723d9ee008d9b584da82637c","08f198e10835802236ac69a46069189939d438d31ff449b41bf6184c47d7355e","f7e927c9e7492ca736a7e4d26b77fb8aa896741bf9d68f437383627d21b2a6ef","6c0320e7c547463f3b427c0917abf2e7c934797269209fbe47dcc30abb85fd36","971f55d4c6fab8a413c0c641fed02d4686c83ab228391736f199c5bc0dc84bfb","42fa8e72e1632039f48bcc1c2529d09e6b865507c4111f72496c3fab2b7b6230","fb9ab46fad6640e68d4d64d71a79e5b8b0e010c8baa7e422772e899e85b061d6","4c8d6991b30fc477df775beedbe3127bab1d9bbaa5bf73916da0b8de61895901","56cd3913f80c773f7de71f594f6f8502a1e3422d9939920dda942c3a9b3ad4c6","40ae08ab2d464111c469f8d31ed60fcc23748ede2957a5f02ea34e0f1dba6bc1","283c7653801f79d9f06f286c10daf25ed47ad5c6955a5920af16a102545e876d","8b5313278294a4349d6e0870ec32158edb80f1713c9218ea502b6206cd40652c","c82428988e99ccbc9dc50a663222b2c9f1ff0a8964a84d27c0fb04aa42b7135d","9eea7acc4ffd3825443fa97194d9b28b51066f720c7c12b450824afceba4b5c2"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p24"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"1.Fix the issues according to the LS from RAN4 in R4-2403363 on the report format of RSCPD. ","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"2.Updates according to the LS from RAN1 in R1- 2401801 on the bandwidth used in measurements for positioning of RedCap UEs ","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"3. Updates according to the agreement at RAN2#125bis:","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"Agreement:","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Stage 3 impact is not specified any more to align PRS to fixed (e)DRX.  Can consider towards next meeting if some modification is needed to the related NOTE in stage 2.","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"In this release, the new capability on location+measurements is only for PRUs.","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"Keep the existing IE structure for LocationInformationType.","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"When location+measurements are reported by a PRU, the measurements are valid at the reported location.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["f1d268457c0771de988180d74db7cecfc46b97d658e736ae4e1b952f40824ffd","c20d5472706e054db83d683a3abda6e952ef950a2183e5b5cbbffbd0091e5b1a","7894ef0767c16ecc6e691257f257c72a2aac69c41be614ce742e1f1913ab0902","28f021f4dd6580573e0f0e8b60be163b9c86a31baa0a7163ad589bf19ee5072d","86a278c8eced34a99d10d21b5b389385020fc2ace4673408a7fb2539f10f89c0","37ef221a35178eb4448875b32c482fea3c20f4d05675b55fef18200e7b236237","fa4585e0cd71db8ebdde56c61a17f8bc8fe037b9973a8fed61903386b1ab0248","2c28146ca541f77c910d43d064df83c8271d36b83baadf1dbed99b4ef7f391cc","6178037b81977bd9741950c37e3c943c5f85cecf3a069cadd8cc6b7686415bb2","964368e3e0aadefbda6c745db2018f9066323068d400310e4b28e18f9afe68eb","1d523042fa426508b9fce6b07d219911d0258dd2a56769700effa63f8447c71e","aea1a3c8a943ae82adbdc5758339304cd2553d2ed8e29440f324e93bb6a9cbed","1e452342970efc74f90b2d25bb93a30ff92a933803d600b4e07d69f32e9e7f16","4935f8ffbadf0a742f01156bc164b4e38b1da27eab1eefa476eb1d2e8ee4ddb3","2461e12365a3898a3ecae96f2b1cb59e93095826f205c2a1594f15a0ff5e55ef","40a948c6df4f250958d04726979d250ac6de54bbe319d674cf0f9ba78a0bb5dd","7e326082be42b12ac7acf0163c2bba4c39b2edad12d819994c46d32077999379","6fd9a54226a7e57180e76c525315c51a756faeb680c677248aef606ce5af4967","3228306ddb3a2b7bc1425729dac420f2d0cbfeebdf08436d63cda7754040c107","5dca44dbeec77089cf1b06a1de12c49fe45be968375eb318035b3a813bed9a21","5854d926701b63b3f25e59f72d8e88e865c796a5298a51bc31c8177543975836","b568f18bdb62c182b83d39b5896627d61d0fec41a789a84dbe9b6175e8bc10dd","3952ac26bc12943759a489dc10e4a75790819179bf4f30dd6bce2ed49794259f","e5c18aa2dd61d097097c46c648232ebf69973171698a4978a6ce1dc1c7e67f93"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p48"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"The TP from R2-2403796 is merged into the rapporteur CR.","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"The term “PRU” can be used in 37.355.  FFS if a definition is needed (possibly just a pointer to an existing definition).","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"M001 remains ToDo.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Agreements:","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"TPs from R2-2403190 are agreeable in principle and can be taken into the rapporteur CR discussion.  The corresponding RILs go to Agreed.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"DL-AoD aspects will not be captured until we have a reply from RAN1; the existing DL-AoD part can be removed pending the reply.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"Agreement:","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig should support one-shot window configuration.  How to capture this in ASN.1 and field descriptions can be discussed in CR implementation. ","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"1.Updates according to the LS from RAN4 in R4-2403363 and R1- 2401801.","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"2.Updates according to the agreement at #125bis.","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"Not fix the issues of CPP and Redcap","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["292b4fe5371c948695ac474e0b26a96e0245993b484ae386826b193a9270e763","f7695c7b53aeae7e04c232d28db01cbae1835a448b7962b065be9281a08bef0d","1e5519716575afa8e0101489ec21da2ebd1d7e329c8e45d26ed14213706e49e2","6d8fc67c989fecb073070128f3e19ddf888f8c881cc7e16eb89c7c10df502adf","80682fbfcf7b036f4a482ee462a5f8b3884ff311ad45768997e6b3b504fa4bb5","c6f21d17580f7fa95441d37ebdf0c8885a4840ca93737a46e1434dd33197170b","ec9f637cc66e5d4faf927ff659323fce4e122379bd9ba9da759221ca7935f91e","859d38a122916a155b80a4a28035dfeef65fd3d3537e4d5b7285820887d0f614","72367b194f93a487033210d35f76ee93fcc6f452f8dd149caabd1a7fad363430","d388a45a70608f26947c68678935253aa7610ce590142635278c209286639722","088c50cb2af686afa14a6b7c3db5f2f0b6a083b68880a2b84d881f661f6fda77","ad821ce35b4d8d4c7b1cca78dabe0f5d2ce9d24b4738c250483ac3f50278c6af","79ce6a54698b1658764640add8586ee232e22873f71c24e7d68bacc21a8634db","827c20398a071aaf87b002644f2de006b482097ab0e85378ae86ee0782e6aa58","89ff6fef123c94849fd6aeecf54db1f65fde05c9f6450ec3ae0f15b6b5479112","28d0f4903b5fde9d85aab231b0998605f8aaba310ff15817da0bebd9bfe67e1a","454d0f026ef77feec42e3a5c10965