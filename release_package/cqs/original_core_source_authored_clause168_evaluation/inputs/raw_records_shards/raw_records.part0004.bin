{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27384},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModListSizeExt-v1610 SEQUENCE (SIZE (1..2)) OF ControlResourceSet             OPTIONAL,   -- Need N","paragraph_zero_based":27385},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseListSizeExt-r16 SEQUENCE (SIZE (1..5)) OF ControlResourceSetId-r16        OPTIONAL,   -- Need N","paragraph_zero_based":27386},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-r16     SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-r16                     OPTIONAL,   -- Need N","paragraph_zero_based":27387},{"literal_text_all_w_t_and_m_t":"    uplinkCancellation-r16              SetupRelease { UplinkCancellation-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":27388},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-r16      ENUMERATED { r15monitoringcapability,r16monitoringcapability }   OPTIONAL,   -- Need M","paragraph_zero_based":27389},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r16         SearchSpaceSwitchConfig-r16                                      OPTIONAL    -- Need R","paragraph_zero_based":27390},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27391},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27392},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1700   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1700                   OPTIONAL,   -- Need N","paragraph_zero_based":27393},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-v1710    ENUMERATED { r17monitoringcapability }                           OPTIONAL,   -- Need M","paragraph_zero_based":27394},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r17         SearchSpaceSwitchConfig-r17                                      OPTIONAL,   -- Need R","paragraph_zero_based":27395},{"literal_text_all_w_t_and_m_t":"    pdcch-SkippingDurationList-r17      SEQUENCE(SIZE (1..3)) OF SCS-SpecificDuration-r17                OPTIONAL    -- Need R","paragraph_zero_based":27396},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27397},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27398},{"literal_text_all_w_t_and_m_t":"    pdcch-MonitoringResumptionAfterNack-r18 ENUMERATED {true}                                            OPTIONAL,   -- Need R","paragraph_zero_based":27399},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1800   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1800                   OPTIONAL    -- Need N","paragraph_zero_based":27400},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27401},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27402},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27403},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig-r16 ::=     SEQUENCE {","paragraph_zero_based":27404},{"literal_text_all_w_t_and_m_t":"    cellGroupsForSwitchList-r16         SEQUENCE(SIZE (1..4)) OF CellGroupForSwitch-r16                  OPTIONAL,   -- Need R","paragraph_zero_based":27405},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchDelay-r16          INTEGER (10..52)                                                 OPTIONAL    -- Need R","paragraph_zero_based":27406},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b568a62b5450e0d3b7c6e6388043959fedffa70bdc63837fe91d4a470916d