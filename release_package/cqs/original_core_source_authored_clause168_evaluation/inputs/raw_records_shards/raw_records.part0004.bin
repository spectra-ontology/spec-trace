mmonSearchSpaceListExt2-r17       SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-v1700           OPTIONAL,   -- Need R","paragraph_zero_based":27493},{"literal_text_all_w_t_and_m_t":"    firstPDCCH-MonitoringOccasionOfPO-v1710 CHOICE {","paragraph_zero_based":27494},{"literal_text_all_w_t_and_m_t":"       sCS480KHZoneEighthT                      SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..35839),","paragraph_zero_based":27495},{"literal_text_all_w_t_and_m_t":"       sCS480KHZoneSixteenthT                   SEQUENCE (SIZE (1..maxPO-perPF)) OF INTEGER (0..71679)","paragraph_zero_based":27496},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":27497},{"literal_text_all_w_t_and_m_t":"    pei-ConfigBWP-r17      SEQUENCE {","paragraph_zero_based":27498},{"literal_text_all_w_t_and_m_t":"        pei-SearchSpace-r17                 SearchSpaceId,","paragraph_zero_based":27499},{"literal_text_all_w_t_and_m_t":"        firstPDCCH-MonitoringOccasionOfPEI-O-r17  CHOICE {","paragraph_zero_based":27500},{"literal_text_all_w_t_and_m_t":"            sCS15KHZoneT                                                     SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..139),","paragraph_zero_based":27501},{"literal_text_all_w_t_and_m_t":"            sCS30KHZoneT-SCS15KHZhalfT                                       SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..279),","paragraph_zero_based":27502},{"literal_text_all_w_t_and_m_t":"            sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                      SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..559),","paragraph_zero_based":27503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216b