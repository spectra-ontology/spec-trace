{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the MaxBW-Preference IE;","paragraph_zero_based":7800},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR1 in the cell group;","paragraph_zero_based":7801},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR1 in the cell group;","paragraph_zero_based":7802},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":7803},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":7804},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-1 in the cell group;","paragraph_zero_based":7805},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-1 in the cell group;","paragraph_zero_based":7806},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":7807},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR1 and reducedMaxBW-FR2 in the MaxBW-Preference IE;","paragraph_zero_based":7808},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-PreferenceFR2-2 of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7809},{"literal_text_all_w_t_and_m_t":"2>include maxBW-PreferenceFR2-2 in the UEAssistanceInformation message;","paragraph_zero_based":7810},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":7811},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":7812},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE desires to have configured across all downlink carriers of FR2-2 in the cell group;","paragraph_zero_based":7813},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE desires to have configured across all uplink carriers of FR2-2 in the cell group;","paragraph_zero_based":7814},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum aggregated bandwidth for the cell group):","paragraph_zero_based":7815},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxBW-FR2-2 in the MaxBW-PreferenceFR2-2 IE;","paragraph_zero_based":7816},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxCC-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7817},{"literal_text_all_w_t_and_m_t":"2>include maxCC-Preference in the UEAssistanceInformation message;","paragraph_zero_based":7818},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum number of secondary component carriers for the cell group:","paragraph_zero_based":7819},{"literal_text_all_w_t_and_m_t":"3>include reducedMaxCCs in the MaxCC-Preference IE;","paragraph_zero_based":7820},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsDL to the number of maximum SCells the UE desires to have configured in downlink in the cell group;","paragraph_zero_based":7821},{"literal_text_all_w_t_and_m_t":"3>set reducedCCsUL to the number of maximum SCells the UE desires to have configured in uplink in the cell group;","paragraph_zero_based":7822},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on the maximum number of secondary component carriers for the cell group):","paragraph_zero_based":7823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1eab6b005dc2a6c069f04543a94887f552c5bf93ae7227a59d5a9b0b31ce0616","7878d7a7658e5b8c8c22cff2f69de4a9c037e0d3516db4aafe9ec8e9016049a7","eb4a6beb00f4975ffecada2091c51e20b1e4e2ba4bc771fbdccff073aa11c6be","1b225ddf6ed7ad5296ad68881d2cc31c53c5cb2070379360b0d1cea45471922b","5d2c32f38c7b9a62dacb5279e3b145dd16ef3af7cbf372f9d44506aa6c67726e","428e66fb4cfd507c6eaac9aad4bfa8a2ed7cddab0acccc80326d14497548bde4","5f32761ad7b716fbaeddd8e54ceeaa85d7e8ee778f99e5c7289c435220ce72ae","0e679b190fba08148622cf51d049f9a98b436898518e5bd2fc8e94bea12897e4","90374a06c754928046e4a3100b413e7d12b31f4868103c4fdb7df6ca05e84ce5","3f07f9b91c17593952661043a97787a7c022d4da996582394484de43a51c33ec","d50667b2ccd0434459136c4a7e43d9ba51e6522f457406d5c19af2f184d12977","49e02c372ac9b5dea4b815366c7b63f5019a8ad2e4b52bf306af405ce726d056","472c55a7d1939ffb2542f421a937cdbc0bcb0c6267f61759486d13e6576f1a18","d600111e6683d6d2b54c0b896a6804dde4dd12c9f516e8b8c92142e9745db9fc","759e645ea73e24d421d7736da8637bb618901f9201defaa9b8f0bd9676cadd35","27399d9298eb3cd6853774287d6873ad85777a0f5df602d146e6c12b97db936f","301c443bda249f2a2da92e6c4932d525c98dd271afd8adf66d10e52a40f4d324","6783d8557ef38f8c7606f60b390cc3b93876d8fc1e3223a2d0c6482f18ea26b9","35c8a5c5f5960d76ab7daa356b04808389b9b2ea7c3660bfc65538c772ee67e8","4dc48059f324c50274cc3624879bf0f062fef78e13e6434a850c2c3661cb3e33","be64327c82d9dea1ad5ef2c11627e7b956d2020caa35e0ef0854bbc0b4526504","e8e39165378a6f31cc2c9186b3617bbfe86b358ba0f005859e