{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SearchSpaceId information element","paragraph_zero_based":32760},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32761},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-START","paragraph_zero_based":32762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32763},{"literal_text_all_w_t_and_m_t":"SearchSpaceId ::=                   INTEGER (0..maxNrofSearchSpaces-1)","paragraph_zero_based":32764},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32765},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-STOP","paragraph_zero_based":32766},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32767},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32768},{"literal_text_all_w_t_and_m_t":"–SearchSpaceZero","paragraph_zero_based":32769},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceZero is used to configure SearchSpace#0 of the initial BWP (see TS 38.213 [13], clause 13).","paragraph_zero_based":32770},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero information element","paragraph_zero_based":32771},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32772},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-START","paragraph_zero_based":32773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32774},{"literal_text_all_w_t_and_m_t":"SearchSpaceZero ::=                 INTEGER (0..15)","paragraph_zero_based":32775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32776},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEZERO-STOP","paragraph_zero_based":32777},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32779},{"literal_text_all_w_t_and_m_t":"–SecurityAlgorithmConfig","paragraph_zero_based":32780},{"literal_text_all_w_t_and_m_t":"The IE SecurityAlgorithmConfig is used to configure AS integrity protection algorithm and AS ciphering algorithm for SRBs and DRBs.","paragraph_zero_based":32781},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig information element","paragraph_zero_based":32782},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["859fb50cb968b04afbd4786b48a31cec72c00230bcff0e64537320a6a20bfcfa","7f3ef2b05742136b9c262581c681b3b3de084421d42c70fb59ec0f018df4f78c","894883bc95ce9da4d7b987c47ed9c899fd52250e2b2d5ef4b9bafe3b101a8bd0","af88df2c9c230a31f5e51f0ffd489d3590a28275722c29d882cc6397a680a2a7","8045a0e327635e141737f0e8c56389cce594aaf843a1f41ce1cac56964a4bb7a","c6281bb9aa59314dd4755ed429d3fa49ef13353a7278edfbc7d8cc4967f36ea8","30839f174a1a1169af0c2de5c5141047e35c9b24557f43bfee63d68520a0641f","77989f76a7ea62bc4eb7601f85b1ca1b0496d45743e26465e18452dfd6aed051","81cd27a5e8283a42a111bcde87bb49c4cca6eb32a0d29b37d7e925248d6f03a2","f3ceb1345ca3f9608df0d31dd6d8902d591cf50696d8ee32872ee1bf765854dc","feae56b2e96e1b8f671f0a3b4039bbc53e2deb0e289d5cc3a44f0e06088d4659","c7ee921a5ef57e23fa8f2f1724030f3de4717594ece3474efdbeba262086a42f","1d3fd1ab90212be0ef443369bcf65f9d5a92183b2e383226d38eba9248cf4807","789ddb20e36a297d04686465b01ad7d8682fe804f29c816fb591b9ce9be5368a","ec51708175116f2d9456b8e11edf216cca1dc5169270c8e31fbf77339686a831","dd2687daf6a7004106ab54c5ab5caa36842764a7239a0a642a4f347bfe24e0a2","f9289fb1b8338e1f5e02ab0963a2403718b9ac1d517abe249d8f225cd091e659","1863915527a8b51eac849657ad12e4add9d4fbb4ed88f63e15647bced3a563f9","0d781778a1ebcd1d4a21e5471f1b1c881209a3387446e41a1dc5f82dd675d2fe","032b28fb6a64edd1c50d5caa9d7887eaab083dec061b02b41b184947300c4f74","1002341ede09c23e043dbfd6995e082488dca644c18b384935f1d934e6bd5203","1273f2d9904e10bad3421f667f0814a89bb5442a938e29d94774a938bb0085d6","8ef1b02e3b18eae4ca3eeb70dd51557087f245244f638afc9a015757cf4b4178","3ec31e30a228c27841c2ba567eae065ddf204a6a4aedea91d133340c115d3394"],"paragraph_range_zero_based":[32760,32783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32760"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-START","paragraph_zero_based":32784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32785},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig ::=         SEQUENCE {","paragraph_zero_based":32786},{"literal_text_all_w_t_and_m_t":"    cipheringAlgorithm                  CipheringAlgorithm,","paragraph_zero_based":32787},{"literal_text_all_w_t_and_m_t":"    integrityProtAlgorithm              IntegrityProtAlgorithm          OPTIONAL,   -- Need R","paragraph_zero_based":32788},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32789},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32790},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32791},{"literal_text_all_w_t_and_m_t":"IntegrityProtAlgorithm ::=          ENUMERATED {","paragraph_zero_based":32792},{"literal_text_all_w_t_and_m_t":"                                        nia0, nia1, nia2, nia3, spare4, spare3,","paragraph_zero_based":32793},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":32794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32795},{"literal_text_all_w_t_and_m_t":"CipheringAlgorithm ::=              ENUMERATED {","paragraph_zero_based":32796},{"literal_text_all_w_t_and_m_t":"                                        nea0, nea1, nea2, nea3, spare4, spare3,","paragraph_zero_based":32797},{"literal_text_all_w_t_and_m_t":"                                        spare2, spare1, ...}","paragraph_zero_based":32798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32799},{"literal_text_all_w_t_and_m_t":"-- TAG-SECURITYALGORITHMCONFIG-STOP","paragraph_zero_based":32800},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32802},{"literal_text_all_w_t_and_m_t":"SecurityAlgorithmConfig field descriptions","paragraph_zero_based":32803},{"literal_text_all_w_t_and_m_t":"cipheringAlgorithm","paragraph_zero_based":32804},{"literal_text_all_w_t_and_m_t":"Indicates the ciphering algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nea0-nea3 are identical to the LTE algorithms eea0-3. The algorithms configured for all bearers using master key shall be the same, and the algorithms configured for all bearers using secondary key, if any, shall be the same. If UE is connected to E-UTRA/EPC, this field indicates the ciphering algorithm to be used for RBs configured with NR PDCP, as specified in TS 33.501 [11].","paragraph_zero_based":32805},{"literal_text_all_w_t_and_m_t":"integrityProtAlgorithm","paragraph_zero_based":32806},{"literal_text_all_w_t_and_m_t":"Indicates the integrity protection algorithm to be used for SRBs and DRBs, as specified in TS 33.501 [11]. The algorithms nia0-nia3 are identical to the E-UTRA algorithms eia0-3. The algorithms configured for all bearers using master key shall be the same and the algorithms configured for all bearers using secondary key, if any, shall be the same. The network does not configure nia0 except for unauthenticated emergency sessions for unauthenticated UEs in LSM (limited service mode).","paragraph_zero_based":32807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["90d386b1f4290e95df830953de537ff2fb458f2a5de5b1fdd3728e6c7edf4da7","45fd25b03b2f5142331d47dfba1cab5eb65b0913878e293edfe5fab23d00b741","61507653fe76d9df7652dff9d309861a4767ca60e8d38b809249785bee833162","3f7c7029ccbae