{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18696},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINK-START","paragraph_zero_based":18697},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18698},{"literal_text_all_w_t_and_m_t":"BWP-Downlink ::=                    SEQUENCE {","paragraph_zero_based":18699},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":18700},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-DownlinkCommon                                         OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":18701},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-DownlinkDedicated                                      OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":18702},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18703},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18705},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINK-STOP","paragraph_zero_based":18706},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18708},{"literal_text_all_w_t_and_m_t":"BWP-Downlink field descriptions","paragraph_zero_based":18709},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":18710},{"literal_text_all_w_t_and_m_t":"An identifier for this bandwidth part. Other parts of the RRC configuration use the BWP-Id to associate themselves with a particular bandwidth part.","paragraph_zero_based":18711},{"literal_text_all_w_t_and_m_t":"The network configures the BWPs with consecutive IDs from 1. The Network does not include the value 0, since value 0 is reserved for the initial BWP.","paragraph_zero_based":18712},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18713},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18714},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18715},{"literal_text_all_w_t_and_m_t":"SetupOtherBWP","paragraph_zero_based":18716},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new DL BWP. The field is optionally present, Need M, otherwise. ","paragraph_zero_based":18717},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18718},{"literal_text_all_w_t_and_m_t":"–BWP-DownlinkCommon","paragraph_zero_based":18719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4ad7af7adc742ca635829b92d60419d8e03e22302c99b3801356e44ff358b72a","4c18f4892f9e5b0e1e3e9296b15636343d8b2ccb16a91ff794f289fcffa5ac5e","55c87278a860548ab328d4aac84e4de26b922f6cdf687b137f1c333aec04e24b","3d1ebc012a48e284ceef416129ccc7c3dc614fe0864e381ab47d24a9de0b2602","b885a5df685bd09463ec676950757115f37295f7d13b6deef61d2274bf6b4bd3","784adb19a0aa88d3c5cec24989c31e4b5a1b06cdf6ca4e2b71acfdd8fc12bafb","62e3d7656ff1619caf3ada3d0a1d2464372d2afa11d3eb4e86e40975b7603b8e","fb7f57575b57b61a82619e6c8a5bfbc277ca66dff695e764585f582694af172c","bd88f5a54699f37cfc27ec09e18749802f1b057a2254925c2d0550173e42500c","ed3183571df29bd70ec3391916d028cad781c7da8d0442763f61a6bbc2329f23","1eac40c6758f998443144b416ecaa9b4906735a02fadf8b830f1c98b1f61cc8b","d746f0f6c13723f674b0f21958d58e9bca1f5f5cff542e8b59345aee46bc111f","75c0e1a208d170fd2246f2894e27f43fb827da30c0d6dae306833eb937c41c0a","6b407533ac9149dc3ef2119a349fb5f7ec98a0838816313130d1cd1d55afd211","fdf2bf7e056e0ba56cb1