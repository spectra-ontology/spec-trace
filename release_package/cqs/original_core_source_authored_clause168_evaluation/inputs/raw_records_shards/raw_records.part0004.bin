{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ReportInterval indicates the interval between periodical reports. The ReportInterval is applicable if the UE performs periodical reporting (i.e. when reportAmount exceeds 1) when reportType is set to either eventTriggered, periodical, cli-EventTriggered or cli-Periodical. Value ms120 corresponds to 120 ms, value ms240 corresponds to 240 ms and so on, while value min1 corresponds to 1 min, min6 corresponds to 6 min and so on.","paragraph_zero_based":32304},{"literal_text_all_w_t_and_m_t":"ReportInterval information element","paragraph_zero_based":32305},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32306},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-START","paragraph_zero_based":32307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32308},{"literal_text_all_w_t_and_m_t":"ReportInterval ::=                  ENUMERATED {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960,","paragraph_zero_based":32309},{"literal_text_all_w_t_and_m_t":"                                                    min1,min6, min12, min30 }","paragraph_zero_based":32310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32311},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-STOP","paragraph_zero_based":32312},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32314},{"literal_text_all_w_t_and_m_t":"–ReselectionThreshold","paragraph_zero_based":32315},{"literal_text_all_w_t_and_m_t":"The IE ReselectionThreshold is used to indicate an Rx level threshold for cell reselection. Actual value of threshold = field value * 2 [dB].","paragraph_zero_based":32316},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold information element","paragraph_zero_based":32317},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32318},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLD-START","paragraph_zero_based":32319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32320},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold ::=                INTEGER (0..31)","paragraph_zero_based":32321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32322},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLD-STOP","paragraph_zero_based":32323},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32325},{"literal_text_all_w_t_and_m_t":"–ReselectionThresholdQ","paragraph_zero_based":32326},{"literal_text_all_w_t_and_m_t":"The IE ReselectionThresholdQ is used to indicate a quality level threshold for cell reselection. Actual value of threshold = field value [dB].","paragraph_zero_based":32327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4e52326044533395f48b5ffeb57889b9914255f1a8b5e2181e2a19b3a4a75ebb","36ba39c84f1f11189ee1f487246f1e2339c9744b49ed583b5c08eafb79b2d245","94c5f89c6445de0b9afa0705ddd698a8a7030608f6dc43175e9c62b5c902fa08","ecbd0aabb96a73bc072a09751613273de3942e5b5a85d667f3bf0db795411ba3","411485f88078d3c7ab8e3f36fb9ce3c6559a46e726dde03fa8fc6793a0cc0762","0a7c3b6661578f4535da8a8b5922e03fd42487301df3e8a54a8bfdc4d2657123","2fd978cff53ab4400877cfc697fee4d15053ff448344060ab6f5c15ebaa1fabb","f167008350ce027acd83d0bf8bb2890178cd684364f18948a33f82a0623c502d","010f387e120442534b071543da1ca5254039896b991eedc32dea4997649e79de","3da3e3d0411d0a692857b37814d73bc13fd432c18f269b23f29