{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32833},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIG-STOP","paragraph_zero_based":32834},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32836},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfig field descriptions","paragraph_zero_based":32837},{"literal_text_all_w_t_and_m_t":"period","paragraph_zero_based":32838},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity of the semi-static channel access mode (see TS 37.213 [48], clause 4.3). Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":32839},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32840},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfigUE","paragraph_zero_based":32841},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfigUE is used to configure channel access parameters for UE initiated semi-static channel access.","paragraph_zero_based":32842},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE information element","paragraph_zero_based":32843},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32844},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-START","paragraph_zero_based":32845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32846},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE-r17 ::=    SEQUENCE {","paragraph_zero_based":32847},{"literal_text_all_w_t_and_m_t":"    periodUE-r17                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10, spare2, spare1},","paragraph_zero_based":3284