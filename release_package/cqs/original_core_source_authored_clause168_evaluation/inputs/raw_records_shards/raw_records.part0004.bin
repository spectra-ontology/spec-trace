{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-GapRepetitionAndOffset","paragraph_zero_based":26112},{"literal_text_all_w_t_and_m_t":"Indicates the gap repetition period in ms and gap offset in number of subframes for the periodic MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for the periodic MUSIM gap preference indication.","paragraph_zero_based":26113},{"literal_text_all_w_t_and_m_t":"musim-Starting-SFN-AndSubframe","paragraph_zero_based":26114},{"literal_text_all_w_t_and_m_t":"Indicates gap starting position for the aperiodic MUSIM gap. This field is optionally present for the aperiodic MUSIM gap preference indication.","paragraph_zero_based":26115},{"literal_text_all_w_t_and_m_t":"starting-SFN","paragraph_zero_based":26116},{"literal_text_all_w_t_and_m_t":"Indicates gap starting SFN number for the aperiodic MUSIM gap.","paragraph_zero_based":26117},{"literal_text_all_w_t_and_m_t":"startingSubframe","paragraph_zero_based":26118},{"literal_text_all_w_t_and_m_t":"Indicates gap starting subframe number for the aperiodic MUSIM gap.","paragraph_zero_based":26119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26120},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26121},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26122},{"literal_text_all_w_t_and_m_t":"aperiodic","paragraph_zero_based":26123},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of aperiodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":26124},{"literal_text_all_w_t_and_m_t":"gapSetup","paragraph_zero_based":26125},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new MUSIM gap. The field is optionally present, Need M, otherwise.","paragraph_zero_based":26126},{"literal_text_all_w_t_and_m_t":"periodic","paragraph_zero_based":26127},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of periodic MUSIM gap configuration. Otherwise it is absent.","paragraph_zero_based":26128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26129},{"literal_text_all_w_t_and_m_t":"–N3C-IndirectPathConfigRelay","paragraph_zero_based":26130},{"literal_text_all_w_t_and_m_t":"The IE N3C-IndirectPathConfigRelay indicates the N3C indirect path related configuration used by N3C relay UE in MP.","paragraph_zero_based":26131},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay information element","paragraph_zero_based":26132},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26133},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHCONFIGRELAY-START","paragraph_zero_based":26134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f1d733408d8ee2c020793d6bf6d04e83e4074bdb788fd9835d44e93f6f851db0","928e524029501f276764d113d8eece1359b7318a6dc58eab1075bddc045dbd54","565ffcc5ba902f7fa4139f9f45d94b2d3843cf54be8000222b2082b142e29d85","5e47f71a664ea91cee7d1a55045d1af63cd5b5ed95c028c4e8db32596a21b966","8c6f29668d0bbfa94473d071ed8a0f3441478b5a2c4b938e69c0a132af3954ce","711605157c675bd128242626c32885cfa4c6d136a8becb9dee0aa111b0ee225c","25ec0459dab0175971b331721037751899d09a3ad7d4ac82dade5bc8a96e28ba","97766be0cf5cee4d329f714e2eab4648d9846c716f560ca30188ef6ed4946738","5e1fc4726c85ab30d7d2e0ff208e9d02e5b60985e0fa9340fe11bc84aeb526ec","5a4349b0358e4ecd137e2e1e4b1867d836adcdf8b94594c38bbccbd6a24a0264","83e66ba9eb1ebfe3c97ec45bca1