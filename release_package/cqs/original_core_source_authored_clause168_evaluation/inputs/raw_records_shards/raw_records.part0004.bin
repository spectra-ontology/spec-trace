{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    serialNumber                    BIT STRING (SIZE (16)),","paragraph_zero_based":17160},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentType       ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":17161},{"literal_text_all_w_t_and_m_t":"    warningMessageSegmentNumber     INTEGER (0..63),","paragraph_zero_based":17162},{"literal_text_all_w_t_and_m_t":"    warningMessageSegment           OCTET STRING,","paragraph_zero_based":17163},{"literal_text_all_w_t_and_m_t":"    dataCodingScheme                OCTET STRING (SIZE (1))                         OPTIONAL,   -- Cond Segment1","paragraph_zero_based":17164},{"literal_text_all_w_t_and_m_t":"    warningAreaCoordinatesSegment   OCTET STRING                                    OPTIONAL,   -- Need R","paragraph_zero_based":17165},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension        OCTET STRING                                    OPTIONAL,","paragraph_zero_based":17166},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17167},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17169},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-STOP","paragraph_zero_based":17170},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17172},{"literal_text_all_w_t_and_m_t":"SIB8 field descriptions","paragraph_zero_based":17173},{"literal_text_all_w_t_and_m_t":"dataCodingScheme","paragraph_zero_based":17174},{"literal_text_all_w_t_and_m_t":"Identifies the alphabet/coding and the language applied variations of a CMAS notification.","paragraph_zero_based":17175},{"literal_text_all_w_t_and_m_t":"messageIdentifier","paragraph_zero_based":17176},{"literal_text_all_w_t_and_m_t":"Identifies the source and type of CMAS notification.","paragraph_zero_based":17177},{"literal_text_all_w_t_and_m_t":"serialNumber","paragraph_zero_based":17178},{"literal_text_all_w_t_and_m_t":"Identifies variations of a CMAS notification.","paragraph_zero_based":17179},{"literal_text_all_w_t_and_m_t":"warningAreaCoordinatesSegment","paragraph_zero_based":17180},{"literal_text_all_w_t_and_m_t":"If present, carries a segment, with one or more octets, of the geographical area where the CMAS warning message is valid as defined in [28]. The first octet of the first warningAreaCoordinatesSegment is equivalent to the first octet of Warning Area Coordinates IE defined in and encoded according to TS 23.041 [29] and so on.","paragraph_zero_based":17181},{"literal_text_all_w_t_and_m_t":"warningMessageSegment","paragraph_zero_based":17182},{"literal_text_all_w_t_and_m_t":"Carries a segment, with one or more octets, of the Warning Message Contents IE defined in TS 38.413 [42]. The first octet of the Warning Message Contents IE is equivalent to the first octet of the CB data IE defined in and encoded according to TS 23.041 [29], clause 9.4.2.2.5, and so on.","paragraph_zero_based":17183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f488d40c0f3b9fd29d6fa60bad97a53df93eca990e1c42bd3c6381f9eb4abe2c","0db0c7b89b83e79e19076b6db4be50519a9f4cb12a930f0040684505cb451b83","c2f1238e0cdbbf6e09ada1b8f508faf3026a0e15774c7ae1cd4d7a03dd8aca90","1cbfd3dfcfd45ed38f014790b0dbb0ea4a0ff95abb940bd5639d7ea173599075","0805fa5a42cff56e54fe26cf72bf724b41be4427b3cb1e99b179dfc2ef0e1e1e","5d94f821b5e9d558cfd059a61968253560a752844ac23cdd7a30e8ada68329e3","e047c0597