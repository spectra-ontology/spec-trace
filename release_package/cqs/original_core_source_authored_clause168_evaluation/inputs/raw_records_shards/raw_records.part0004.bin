{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UplinkHARQ-mode-r17 ::=                 BIT STRING (SIZE (32))","paragraph_zero_based":29640},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29641},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":29642},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29643},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29644},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":29645},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":29646},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB (see TS 38.213 [13], clause 9.1).","paragraph_zero_based":29647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29648},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig field descriptions","paragraph_zero_based":29649},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":29650},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":29651},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if the SCS of at least one UL BWP configured in the cell is 480 or 960 kHz.","paragraph_zero_based":29652},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers, maxMIMO-Layers-n8","paragraph_zero_based":29653},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRank to the same value. The field maxMIMO-Layers refers to DCI format 0_1.","paragraph_zero_based":29654},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSDM","paragraph_zero_based":29655},{"literal_text_all_w_t_and_m_t":"Parameter to indicate maximal number of MIMO layers of each panel for PUSCH with SDM scheme for NCB PUSCH","paragraph_zero_based":29656},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSDM-DCI-0-2","paragraph_zero_based":29657},{"literal_text_all_w_t_and_m_t":"Parameter to indicate maximal number of MIMO layers of each panel for PUSCH with SDM scheme for DCI format 0_2 for NCB PUSCH","paragraph_zero_based":29658},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSFN","paragraph_zero_based":29659},{"literal_text_all_w_t_and_m_t":"Parameter to indicate maximal number of MIMO layers of each panel for PUSCH with SFN scheme for NCB PUSCH","paragraph_zero_based":29660},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSFN-DCI-0-2","paragraph_zero_based":29661},{"literal_text_all_w_t_and_m_t":"Parameter to indicate maximal number of MIMO layers of each panel for PUSCH with SFN scheme for DCI format 0_2 for NCB PUSCH","paragraph_zero_based":29662},{"literal_text_all_w_t_and_m_t":"nrofHARQ-ProcessesForPUSCH","paragraph_zero_based":29663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["387188f17dc0c3994636a3740702af65aecc8823fe0c16ad50c13a5361077d29","8af6e832bab3882e38f3ab9a12805906ae51abfd0fb67435b7a4568b6ba2fabc","ae9d734a66dfe7ff40b4eba875fb5b8191dfb0aeccc038bd30e6930093c15301","ddcebcb2dd770ef4a3eac99bd795ec2ff53bdd89112a7d6daaff9e881364d743","304872d3347512b4641b1e9fda8a2430f30f3b7799c336d65e02c6e8413a0b55","960b64f96534939a638225334ad83bb43718d66428cbb1d971f875f4b2ddb5d6","1bb60d6f4078393f38086212b187693e98b4b9f3edb74beebec4c1c3756c8fa1","94dbc3472dd9db71e1cc98dc7cfebe2085d41099db70bfb3751e81b015dcc87e","2c2ba9ff834bd7a9fcce7747bd744b763176d6309aa982211aa4931d489af1c5","2054a6af6290b13e257c63df7e08ad615179c8b59c0ed224502cff15d45e32c4","bc8e57986bdbcb606644bdd9eefacd983abad2a2ddc4e089012de7df862980f6","d006cffc091c752e30851a238bad0692bee4bed6a2f779cce847940f3bb21895","94004b3259b7e7057b21b443bad2a95504f5b05b169651f39d2330c3f0b18155","b1f0cb8b7b157bdc2d751d094b2234545876aa96186c42451dbd11dd07762e1b","be6e4e28d8d9991117e9b18e11d6973a903d8568d29766e2ea90d70ea7eefd1c","35ec4a3b74d25c142209fad820430cfdc0a8a955cd8cd9e640fa0097e4a6038c","00da0eb0ffd36e6f2bd4706a86ddc46591bebb5c239357f197e56b21fb3e2c8d","e692a2e2fa47917659e37f958c313456c8a429e81a720f6b17e72925ee103f6e","b1e21d6e1bd2549d1c25f0537adea374b85ba7052610f240896411135626530d","114c0aceb32e6a51695123bf1371ebe65f550ac1f5c9525d7284da450813ab56","ce0b9827c9a8070339a08bcce2f6332fff5f8d7d52bc1779ac048e88c1e23bdd","562d83e8139cf6178f68aa84b40f6b0c201c75ffb572424f37e813c4abbaee7f","c3c5b6ee705cce57dc13715e233cea86724b26b011b0f9d3c3599c240ff268fd","6e9d1d89210357202a47984acd00b58e05292a3b46ad3c4f7efa92bfac4e73b1"],"paragraph_range_zero_based":[29640,29663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29640"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The number of HARQ processes to be used on the PUSCH of a serving cell. Value n32 corresponds to 32 HARQ processes. If the field is absent, the UE uses 16 HARQ processes (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":29664},{"literal_text_all_w_t_and_m_t":"processingType2Enabled","paragraph_zero_based":29665},{"literal_text_all_w_t_and_m_t":"Enables configuration of advanced processing time capability 2 for PUSCH (see 38.214 [19], clause 6.4).","paragraph_zero_based":29666},{"literal_text_all_w_t_and_m_t":"rateMatching","paragraph_zero_based":29667},{"literal_text_all_w_t_and_m_t":"Enables LBRM (Limited buffer rate-matching). When the field is absent the UE applies FBRM (Full buffer rate-matchingLBRM) (see TS 38.212 [17], clause 5.4.2).","paragraph_zero_based":29668},{"literal_text_all_w_t_and_m_t":"xOverhead","paragraph_zero_based":29669},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the value 'xoh0' (see TS 38.214 [19], clause 5.1.3.2).","paragraph_zero_based":29670},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersDCI-0-2","paragraph_zero_based":29671},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH for DCI format 0_2 in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRankDCI-0-2 to the same value.","paragraph_zero_based":29672},{"literal_text_all_w_t_and_m_t":"uplinkHARQ-mode","paragraph_zero_based":29673},{"literal_text_all_w_t_and_m_t":"Used to set the HARQ mode per HARQ process ID, see TS 38.321 [3]. The first/leftmost bit corresponds to HARQ process ID 0, the next bit to HARQ process ID 1 and so on. Bits corresponding to HARQ process IDs that are not configured shall be ignored. A bit set to one identifies a HARQ process with HARQmodeA and a bit set to zero identifies a HARQ process with HARQ modeB. This field applies for SRBs and DRBs.","paragraph_zero_based":29674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29675},{"literal_text_all_w_t_and_m_t":"–PUSCH-TimeDomainResourceAllocationList","paragraph_zero_based":29676},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TimeDomainResourceAllocation is used to configure a time domain relation between PDCCH and PUSCH. PUSCH-TimeDomainResourceAllocationList contains one or more of such PUSCH-TimeDomainResourceAllocations. The network indicates in the UL grant which of the configured time domain allocations the UE shall apply for that UL grant. The UE determines the bit width of the DCI field based on the number of entries in the PUSCH-TimeDomainResourceAllocationList. Value 0 in the DCI field refers to the first element in this list, value 1 in the DCI field refers to the second element in this list, and so on.","paragraph_zero_based":29677},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation information element","paragraph_zero_based":29678},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29679},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-START","paragraph_zero_based":29680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29681},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations)) OF PUSCH-TimeDomainResourceAllocation","paragraph_zero_based":29682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29683},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation ::=  SEQUENCE {","paragraph_zero_based":29684},{"literal_text_all_w_t_and_m_t":"    k2                                      INTEGER(0..32)                                  OPTIONAL,   -- Need S","paragraph_zero_based":29685},{"literal_text_all_w_t_and_m_t":"    mappingType                             ENUMERATED {typeA, typeB},","paragraph_zero_based":29686},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength                    INTEGER (0..127)","paragraph_zero_based":29687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["86393949259c5d6642bde709ebfc8eae09a85690d976751fcb60da2ae8e0b8d6","ee05e03feedbe020b4940383bec2172b851e2b246722264143e9efef3def9ea7","cc1bef3336aeffad242fc17b09ddd72c120bbe28958ba4e5c66488fbdfdf2064","cd1c1c37f5cbe7f9b2981821701071af4d6de430abc1b086704b1309952eeb78","b11a1a85304752cdb47bdff9bafd750e71ae48492aaec503e4328b688bb2a7a3","e96a2e29b0f6cc945902dd9dee48cdfe7d8e6334b80cc331c7e85f5282e325f2","eef71e2f6107454d90d11d90ef6737cc9edae95b3a86abca234166cfc94c62f3","029caede2e38b4297a5e14ad058cd03fffee7602aab2b4fed80513b70b8e2079","5d8ce09e3fa40a51b985319146ef60ecdc32b3538eee4c786f480b10542572bd","4f4a2d9ab8901787cfd5eb042469c440788f246f4605e14f4d9ec0f0021c7ebf","c1bd24af1b03aad9d5b30bed57c0a32db6f1f42e5e26baca7ed0985d57c05374","8d6bb91db616ad45474563f52300635dd76fe6ebb70a7dff02a30028e7dc9f29","62891d737ed0e181f289bfdf912fb8d8dc8aede44611448ef957bb5fe2adee29","3305f792d7bb4e129f66d1b253ea16a1afafb4a217e562c06e0cf24b0b79eb04","4a6e5f13a50739d080db9ef77d92ff796c74407fcc27940ef2bc5451a80b4b7a","a96ca60e241be7cad18e617589807e719ff856e8b3f5071030db9ea8cdfb023d","7e2bc42dd8490700c1aac9c5e1e1ac7ed3976d8e56cf66405b6e72993467b8a9","2316a4927d9bf0dd348839094d2da94718fc036dcb238b7c1b0480d4b4a03433","43ded33d11a420b56dddd8a06b2e2fec2a5bbcd3c25ab51dd84f4e78cb86100d","de3914903f24f5935bf01dff5ffde9e74ce78f6c1fc79184ecdc854ec6efddb1","95d693472c633ad37442acce5d23c6c09629e0e2fe2eafe7b7e9283396df341f","c0adff3723c03fe673ab0e794028b5c45083b01a87cc4c064279edd9b411b15e","54d