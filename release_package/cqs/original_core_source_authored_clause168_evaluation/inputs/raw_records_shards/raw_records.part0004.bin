fd878086e89f17f5498015612348b5314cbbd440c0299dcc71c","a838e8216913991698dcc6fc437dca3a28da4345bc93fed3e051185946ab6779","7c4a1e35cb0df144357f51f3da702b924c638c89b42c833a6ef3dbdf293c2344","474a9420852347e22c9214aace837445900fd2150403539cc38afa0afc8b1c98","e8cf08709de01a8a2a49b122746f023d01d89519e9ec2b280139e565b52f1401","75f495f9a07e315783cd6ab16784863efff7336e1bf850edd7fda3691ee07b8d","f034e3d624df9e889482988ae92e1904f3a0a1bea566cf095e90338c903dddc1","5867ee04f3196598ba3806546a52681f3ae1ee2fa367dbd2b2c3c78d3bc614c0","18c10be01aa4d6c59dba86bb300ef2a918f6a908f012446bea89f5680f9bfd55","ad4b02d46b02de65a51713f30d2e47129a783096b95f452e7222784fc59bf096","8104f701a96bfeb0293c5be624c178a5861ba498ffec8a020d5df845e27b15ba","c9e6c56ebc2615ec0aee8a20feb5af9061176cfab18ee7d7e1811e209ccd9956","9b86591dd51f691e3ac2f3e1b0c027921f9cc6b958fde96cb2203a4ac90083d4","3e2f3da1ac8569a3d2581989ac390b0e89e20ed363490ba9549ebd4ce78afcb4","29dd0b9fb9f3493dddc76dfb8f7950dd3496013cc4a2a726e5cb32e0c4d483cd","1b5b71478a739c426911554dde6d7b10a2fd5472607716f3657722e726e707f0","74b8699a2a0ccf761c350e354adbdd8e3ff132c1c3b1d9e40bff113c108dcec6","da36d75cb007a0a35f820a94ef04b9f19f7d3aaa74fb208d8936c398c3ea7f13","dc7dba98a9a5b7e0277f0a09520cd29f4ddcd5bd9724936de2ab922b2f76bb43","ad0b23d24f216aaa245864d08b373a5f4e581dc50840c9079ffcb0550adba323"],"paragraph_range_zero_based":[22728,22751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22728"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-TimerUL","paragraph_zero_based":22752},{"literal_text_all_w_t_and_m_t":"Value in number of symbols of the BWP where the transport block was transmitted. drx-HARQ-RTT-TimerUL-r17 is only applicable for SCS 480 kHz and 960 kHz. If configured, the UE shall ignore drx-HARQ-RTT-TimerUL (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":22753},{"literal_text_all_w_t_and_m_t":"drx-InactivityTimer","paragraph_zero_based":22754},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms. ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":22755},{"literal_text_all_w_t_and_m_t":"drx-LongCycleStartOffset","paragraph_zero_based":22756},{"literal_text_all_w_t_and_m_t":"drx-LongCycle in ms and drx-StartOffset in multiples of 1 ms. If drx-ShortCycle is configured, the value of drx-LongCycle shall be a multiple of the drx-ShortCycle value.","paragraph_zero_based":22757},{"literal_text_all_w_t_and_m_t":"drx-NonIntegerLongCycleStartOffset","paragraph_zero_based":22758},{"literal_text_all_w_t_and_m_t":"drx-NonIntegerLongCycle in non-integer number of ms (e.g. ms1001over240 corresponds to 1001/240 ms, ms25over6 corresponds to 25/6 ms and so on) and drx-StartOffset in multiples of 1 ms. If drx-NonIntegerShortCycle is configured, the value of drx-NonInetegerLongCycle shall be a multiple of the drx-NonIntegerShortCycle value. If drx-NonIntegerLongCycleStartOffset-r18 is configured, the UE shall ignore drx-LongCycleStartOffset.","paragraph_zero_based":22759},{"literal_text_all_w_t_and_m_t":"drx-NonIntegerShortCycle","paragraph_zero_based":22760},{"literal_text_all_w_t_and_m_t":"Value in non-integer number of ms, e.g. ms1001over240 corresponds to 1001/240 ms, ms25over6 corresponds to 25/6 ms and so on.","paragraph_zero_based":22761},{"literal_text_all_w_t_and_m_t":"drx-onDurationTimer","paragraph_zero_based":22762},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":22763},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerDL","paragraph_zero_based":22764},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the BWP where the transport block was received. value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":22765},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerUL","paragraph_zero_based":22766},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the BWP where the transport block was transmitted. sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":22767},{"literal_text_all_w_t_and_m_t":"drx-ShortCycleTimer","paragraph_zero_based":22768},{"literal_text_all_w_t_and_m_t":"Value in multiples of drx-ShortCycle or drx-NonIntegerShortCycle (depending on which one is configured). A value of 1 corresponds to drx-ShortCycle or drx-NonIntegerShortCycle, a value of 2 corresponds to 2 * drx-ShortCycle or 2 * drx-NonIntegerShortCycle and so on.","paragraph_zero_based":22769},{"literal_text_all_w_t_and_m_t":"drx-ShortCycle","paragraph_zero_based":22770},{"literal_text_all_w_t_and_m_t":"Value in ms. ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":22771},{"literal_text_all_w_t_and_m_t":"drx-SlotOffset","paragraph_zero_based":22772},{"literal_text_all_w_t_and_m_t":"Value in 1/32 ms. Value 0 corresponds to 0 ms, value 1 corresponds to 1/32 ms, value 2 corresponds to 2/32 ms, and so on.","paragraph_zero_based":22773},{"literal_text_all_w_t_and_m_t":"drx-TimeReferenceSFN","paragraph_zero_based":22774},{"literal_text_all_w_t_and_m_t":"Indicates how the UE initializes the counter DRX_SFN_COUNTER, see TS 38.321 [3], clause 5.7. If the field drx-TimeReferenceSFN is not present, the reference SFN is 0.","paragraph_zero_based":22775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a974d7e1be410ae335df042a8af5039e9af45b94547ac2af4308adc311c1dd15","cfc2e4ea6055bf85985f7dfa338db1d6e9298f7f52fb1c6934caadd5075cdf8a","3c0a4ee4eef02bc4e78520388e2d758879c7bc9ba4f5f1f5f1b5c6626f75c88c","9dd68d86d18f4fda457601af4592e0b7dc0fce573208203ec0fe55b549b87a74","47166d9687744389709799c118fe75c4b3c593b8ca86b8df021e56349feb65c7","d28eeec75178667637888337b069d7b6354df5b26df120a268c20acb9fff3cad","08fbb51ef70531b0fb9dd504dceb61a2a5f5124e2ef266f0f2711bb6157414c5","bebd8d65eeea373f02e76ded56522c073d624dfde9320f5ee0805846c869e2b7","74fe694d38d5e9d378ce7836f264a6474c3230fd39a38c5661dd5015a7545ffd","4f46eb5d02a65001f21a9f16d557040768a3ee6bb228651969268e7e3707adf4","3df3e1310917a7965b645967c824d0bd07aa9f95ea4e22125374332f9f8604dc","879bbae4b2a489657b1e85225070645f1bb94cc0f2dc6c122d8b6fcbc544a516","0565e7a90d1984d4efb6c27f18c7fa5374c5f8458b65aad15cc9af9d29a2c781","3c1ccedd6b535865e355317150281dc7be6fc45a9ecc03ba0a410598196df88a","cbd43a924c8a8a2b6a822978974054371a58d102ce4152661eba817e87efe0bc","b299c71ae237da463b8110958b5786e3dfa85d35099fdec3047d5eff41c20b3a","e677a2738d782f6618ab98b093b1c3ecb1a5ee8b09c0747a455007dc36d4b2fb","9a405671a9284595408190411efedd0ee60ce8ff119a3804a54ad08d0ee3bcda","6231c0ce47564a9e5496e4a6c75f124550219359da7b4bb5cf212bdfcc3b40a1","78c122523e66c7ecfe27deb1e9d57cff33d1508967fb75a30d93a13e51baac14","6689593fcf3af357c874c4de37eedf97786f6df2ee188b29a839fbc3bfb0e5a9","f02d