{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-measResultCellListSFTD;","paragraph_zero_based":53112},{"literal_text_all_w_t_and_m_t":"-measResultSFTD-EUTRA;","paragraph_zero_based":53113},{"literal_text_all_w_t_and_m_t":"-sftdFrequencyList-EUTRA;","paragraph_zero_based":53114},{"literal_text_all_w_t_and_m_t":"-sftdFrequencyList-NR;","paragraph_zero_based":53115},{"literal_text_all_w_t_and_m_t":"-ue-CapabilityInfo;","paragraph_zero_based":53116},{"literal_text_all_w_t_and_m_t":"-servFrequenciesMN-NR.","paragraph_zero_based":53117},{"literal_text_all_w_t_and_m_t":"For other fields in CG-Config and CG-ConfigInfo, the sender shall always signal the appropriate value even if same as indicated in the previous inter-node message, unless explicitly stated otherwise.","paragraph_zero_based":53118},{"literal_text_all_w_t_and_m_t":"11.3Inter-node RRC information element definitions","paragraph_zero_based":53119},{"literal_text_all_w_t_and_m_t":"–ResourceConfigNRDC","paragraph_zero_based":53120},{"literal_text_all_w_t_and_m_t":"The IE is used to indicate or request the maximum values that can be used by the SCG in NR-DC, with each value equal to or lower than the value of the corresponding field in the UE capability, as reported by the UE, unless specified otherwise.","paragraph_zero_based":53121},{"literal_text_all_w_t_and_m_t":"ResourceConfigNRDC information element","paragraph_zero_based":53122},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":53123},{"literal_text_all_w_t_and_m_t":"-- TAG-RESOURCECONFIGNRDC-START","paragraph_zero_based":53124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53125},{"literal_text_all_w_t_and_m_t":"ResourceConfigNRDC-r17 ::= SEQUENCE {","paragraph_zero_based":53126},{"literal_text_all_w_t_and_m_t":"    fr1-ResourceConfig-r17                   ResourceConfigPerFR-r17                               OPTIONAL,","paragraph_zero_based":53127},{"literal_text_all_w_t_and_m_t":"    fr2-ResourceConfig-r17                   ResourceConfigPerFR-r17                               OPTIONAL,","paragraph_zero_based":53128},{"literal_text_all_w_t_and_m_t":"    maxNumberResAcrossCC-AcrossFR-r17        INTEGER (0..256)                                      OPTIONAL,","paragraph_zero_based":53129},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":53130},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":53131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53132},{"literal_text_all_w_t_and_m_t":"ResourceConfigPerFR-r17 ::= SEQUENCE {","paragraph_zero_based":53133},{"literal_text_all_w_t_and_m_t":"    bm-MaxNumberCSI-RS-Resource-r17          INTEGER (0..64)                                       OPTIONAL,","paragraph_zero_based":53134},{"literal_text_all_w_t_and_m_t":"    bm-MaxNumberAperiodicCSI-RS-Resource-r17 INTEGER (0..64)                                       OPTIONAL,","paragraph_zero_based":53135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["72a559c492752a305cec5c629095d6287bed82be1073c3c70a7eed1d0030b3e1","6f49a139f0f1bb43e8713094030e08e92d34f1422a3edd6d8ce50f52f4632b40","28fa8386de7e2269699ae76036eb5f1d8e8663831b518abbae04faeef400c1e0","e9caa5cf0a7cd5ad7aa3cef41da281f4c934c3ff85ca39cec8f2da5897c870db","9d4465accdaf2986a377f62faf9aa2425d684d13d54f85358d5e8392092d45b3","9ea5fb22107d71b9a55b0817417272e187518f86c14ded8604281206082be0ba","a954b39c70b3421848ec771a91e1acb60c2a5756ee3454f7747c8e67cd57d6c9","a35cff591fa5ae32f7358e47677e56c5db214096eb8951531074480600659353","ad1aa9c7dc5743c142c1f27d2cb8d75b6c98f950847c5fcb07