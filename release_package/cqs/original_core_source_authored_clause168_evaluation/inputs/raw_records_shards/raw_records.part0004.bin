IZE (1..maxNrOfMinSchedulingOffsetValues-r16)) OF INTEGER (0..maxK0-SchedulingOffset-r17)","paragraph_zero_based":27615},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27616},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDL-r16 ::=                INTEGER (1..8)","paragraph_zero_based":27617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27618},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigDCI-1-3-r18 ::=                    SEQUENCE {","paragraph_zero_based":27619},{"literal_text_all_w_t_and_m_t":"    resourceAllocationDCI-1-3-r18                  ENUMERATED {resourceAllocationType0, resourceAllocationType1, dynamicSwitch}","paragraph_zero_based":27620},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,   -- Need M","paragraph_zero_based":27621},{"literal_text_all_w_t_and_m_t":"    rbg-SizeDCI-1-3-r18                            ENUMERATED {config1, config2, config3}                      OPTIONAL, -- Cond DCI-1-3","paragraph_zero_based":27622},{"literal_text_all_w_t_and_m_t":"    resourceAllocationType1GranularityDCI-1-3-r18  ENUMERATED {n2,n4,n8,n16}                                    OPTIONAL,   -- Need S","paragraph_zero_based":27623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f19941020753ad2e3f2f2d6a487485cdd416574687615ffe6c7d94edaab96d3c","3ce1c16e38b9ebd11849cb55c2ab28eb76b7a1e94fe73c26ac377b34afaf605e","5995d7e3f4502dfe098058778f585857f4bfc12fbed31a917f3396d282b1ff71","2a413de494bc10e49442e8c1511de7699dd3b026cefe2d90d3c70ae82031801e","f42c0b01dad2e2606a6826a5f3f9d613f4c1ab8608f6773b8e39aa77448c554e","9d5e82614bb9135f6b6ee10a61ad2567d76fe894c314cb8e482dce3ac22a3ac9","6228c1faa818bc0ca2198deae796771396a22be5cc22814109087bb45f65c7fb","86fbf0f8cbf410c81558fba2dc6a6baacf9fbe8ab4c373364d7aaa5cd243aec7","4e66b2578983fd9fbb6bae5a523b025f8c1f0736e41c9f7b5f9c4a1d93c8edcd","91da6d0be9c271712dabeee0b5413809820a588927be7538dd77a934f328d772","bbf8d7d0a5e8f9f069ee309ef654b1f2d6274cedc5999dd018f6275ed1d72020","287d84a0a69ace444b31769059a907aab8b74b45613b7b0090e3d777972e82ab","daa0c5de0b2c6ffd3599e96c7b04631abaa0334aec24aa097e85cd02a630ac8a","0864e0ed22f4dc74957a3ca88c671256ac8d61f905c210b2fa330419a49cc4bc","eea56fade66fc6e48144fea7424e88faaf140feb6a4d3dafaf24ff8ca87fc231","6ce9e5d74586c8df1d859939cf12193c6c4d62ba42e34495eaf8d94890c2cc58","d182d8e532997d0811a73850dc6ee7fce0de2b234768a8aa5896fa71ee80209f","744f4bcb847468fa065cdd200a57b8aecf426621cacdd0b4286a0496ebb02ae0","2845ff3bcd997c122163ba2dcee05a20fd21a377ca057268c3d5566e7bcac8d6","58fc4a09ff164a3fb91b5eb910f01a50edec23177077a28bcff61d017d28be27","9fa3b0bc992b45d785c8cabb28e1b88e4099bfc7707ae2330b39b9cdc0903d3d","f76ba1eb45942fb70e03500d2efcff9892f2ccd8e40993a597e5c232053e3bdf","803d7a58f0f1325369770f79d553dbfc5f6126702c20c8b565d7a62d6a87a1e6","56527b229852dadec7fbeeb92dabacc9acfa723b2b72412a1f1920fe92ed3ecf"],"paragraph_range_zero_based":[27600,27623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27600"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    numberOfBitsForRV-DCI-1-3-r18                  INTEGER (0..2)                                               OPTIONAL,   -- Need R","paragraph_zero_based":27624},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-1-3-r18              INTEGER (0..5)                                               OPTIONAL    -- Need R","paragraph_zero_based":27625},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27627},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIG-STOP","paragraph_zero_based":27628},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27630},{"literal_text_all_w_t_and_m_t":"PDSCH-Config field descriptions","paragraph_zero_based":27631},{"literal_text_all_w_t_and_m_t":"advancedReceiver-MU-MIMO","paragraph_zero_based":27632},{"literal_text_all_w_t_and_m_t":"A set of assistance information for R-ML (reduced complexity ML) receivers with enhanced inter-user interference suppression for MU-MIMO transmissions.","paragraph_zero_based":27633},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-1-2","paragraph_zero_based":27634},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 1_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 1_2. Otherwise, the field size is set to 0 for DCI format 1_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 nor dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 is configured, this field is absent.","paragraph_zero_based":27635},{"literal_text_all_w_t_and_m_t":"aperiodic-ZP-CSI-RS-ResourceSetsToAddModList, aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2","paragraph_zero_based":27636},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring aperiodically triggered zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network configures the UE with at most 3 aperiodic ZP-CSI-RS-ResourceSets and it uses only the ZP-CSI-RS-ResourceSetId 1 to 3. The network triggers a set by indicating its ZP-CSI-RS-ResourceSetId in the DCI payload. The DCI codepoint '01' triggers the resource set with ZP-CSI-RS-ResourceSetId 1, the DCI codepoint '10' triggers the resource set with ZP-CSI-RS-ResourceSetId 2, and the DCI codepoint '11' triggers the resource set with ZP-CSI-RS-ResourceSetId 3 (see TS 38.214 [19], clause 5.1.4.2). The field aperiodic-ZP-CSI-RS-ResourceSetsToAddModList applies to DCI format 1_1 and the field aperiodic-ZP-CSI-RS-ResourceSetsToAddModListDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.2 and TS 38.212 [17] clause 7.3.1).","paragraph_zero_based":27637},{"literal_text_all_w_t_and_m_t":"beamAppTime","paragraph_zero_based":27638},{"literal_text_all_w_t_and_m_t":"Indicates the first slot to apply the unified TCI indicated by DCI as specified in TS 38.214 Clause 5.1.5. The value n1 means 1 symbol, n2 two symbols and so on. The first slot is at least Y symbols indicated by beamAppTime parameter after the last symbol of the acknowledgment of the joint or separate DL/UL beam indication. The same value shall be configured for all serving cells in any one of the simultaneousU-TCI-UpdateListN configured in IE CellGroupConfig based on the smallest SCS of the active BWP.","paragraph_zero_based":27639},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPDSCH, dataScramblingIdentityPDSCH2","paragraph_zero_based":27640},{"literal_text_all_w_t_and_m_t":"Identifier(s) used to initialize data scrambling (c_init) for PDSCH as specified in TS 38.211 [16], clause 7.3.1.1. The dataScramblingIdentityPDSCH2 is configured if coresetPoolIndex is configured with 1 for at least one CORESET in the same BWP.","paragraph_zero_based":27641},{"literal_text_all_w_t_and_m_t":"dl-OrJointTCI-StateToAddModList","paragraph_zero_based":27642},{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports, PDCCH DMRS ports, and CSI-RS, and in case of join mode, also the PUSCH, PUCCH and SRS (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":27643},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeA, dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2","paragraph_zero_based":27644},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type A (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeA applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeA-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27645},{"literal_text_all_w_t_and_m_t":"dmrs-DownlinkForPDSCH-MappingTypeB, dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2","paragraph_zero_based":27646},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PDSCH transmissions using PDSCH mapping type B (chosen dynamically via PDSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-DownlinkForPDSCH-MappingTypeB applies to DCI format 1_1 and the field dmrs-DownlinkForPDSCH-MappingTypeB-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6db1af4deee70397d90ffdffe4938a570e77934937feb7bedb569b0a6da8d94b","961360951e404d19a07a67131901de8256dd8a2f51621d10813f2f41e87546b7","d3d216907fba1a1dcebe538a7c04aedc4cea26ef85fd70b95f4a29a1fc35efd1","8dbb936ad2c37fb0ddeed1b4c1c6111508cb22c9783406fb40b1ef32cdee065d","d1cd3b480300529880ea59850f92cc37643baf8cccfb76dd8342bc911b15815c","b432a3a48769e7c5742f5c62f06b8a092d564ce2e7e436b2b4bc4b0eec5a0cc0","1801bb60e2b915ae398da24e410b7551c826fb62aaa77afa2113454b633d0ba1","1acaf8eba335e31079a38ae65d05c0c2d80639d3a783b4461213e21e79d252d4","86a50f1a318606d31d0a8d83aa8eec64dc28991f410d897b90f5b70681a00ab2","8e2316034a7049b42b8eccc43d00585fc40cbb83a730840db5ec6421dc4d7baa","401297379c0cbe758fbb54a27605ff35e559e304f6887784c552584ac6dd5878","5402b611c09221e0cdc7e3a5b2b692ee40d9ca9e6e84baa2d0367ca86c31a9cf","2c52a755d3706cfac49ccace0613813e9d3309365c394104bfbe3bffbb27d5c3","c3bc6ce7c38e9ba2458a0178d4952ee2cc1cb45c0a26707d55cf33879d820a9f","1c127832ce0ae522335df3c5baa9e5272295feb1ba56428ed85ad72870063902","d8c3353ef099a4fd0e34422735f819f5915d525a376ba62be8c850ac82f539dc","7c9f942fc0be2e99ababbb8414ad489df1e06c6246d33264d8da0ba653b80abd","39eaeb54f5b89d9cda2a8cd91754b0b2d36d448ec94bf07f4bae8c08a765f1fd","41ed2fd9d2ae13f58ccf57f179767d0093b51b2110bf0306256984e0416add95","f708238449578cc870ab8cf95cae2926eb26c6ec3714b69e3bd0209de0b36d69","5b5d6af24218d89f420960e0a6152a26571a3ba00594c0217468cf867a0a7e41","92514a594ea7f1e8829bc30b0f7a2797a475a1df04167bc58a98623da47b755d","cdfdb737ccffcbc5200a906a0323ded6aca441507473f4784219214e8854c8e6","a7ea5f3ae0ad1b77b10632aa334ee6cab9a4d18a09600d2d68daa26f37763a36"],"paragraph_range_zero_based":[27624,27647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27624"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dmrs-FD-OCC-DisabledForRank1-PDSCH","paragraph_zero_based":27648},{"literal_text_all_w_t_and_m_t":"If configured, the UE may assume that the set of remaining orthogonal antenna ports, which are within the same code division multiplexing (CDM) group and have different frequency domain orthogonal cover codes (FD-OCC), are not associated with the PDSCH of another UE (see TS 38.214 [19], clause 5.1.6.2). It is applicable for PDSCH SCS of 480 and 960 kHz when rank 1 PDSCH with type-1 or type-2 DMRS is scheduled. If dmrs-TypeEnh-r18 is configured, this field is not configured.","paragraph_zero_based":27649},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-1_2","paragraph_zero_based":27650},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 1_2 If the field is absent, then the UE applies the value of 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 1_2. If the field is present, then the UE applies the value of 1 bit as in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27651},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":27652},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":27653},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-1-2","paragraph_zero_based":27654},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27655},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":27656},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of MIMO layers to be used for PDSCH in this DL BWP. If not configured, the UE uses the maxMIMO-Layers configuration in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs, when the UE operates in this BWP. The value of maxMIMO-Layers for a DL BWP shall be smaller than or equal to the value of maxMIMO-Layers configured in IE PDSCH-ServingCellConfig of the serving cell to which this BWP belongs.","paragraph_zero_based":27657},{"literal_text_all_w_t_and_m_t":"For MBS multicast, indicates the maximum number of MIMO layers to be used for group-common PDSCH of MBS multicast in this CFR. If not configured for CFR, the UE applies value 1. The value of maxMIMO-Layers for a CFR shall be smaller than or equal to the value of maxMIMO-Layers configured in PDSCH-ServingCellConfig IE of the serving cell to which this CFR belongs.","paragraph_zero_based":27658},{"literal_text_all_w_t_and_m_t":"maxNrofCodeWordsScheduledByDCI","paragraph_zero_based":27659},{"literal_text_all_w_t_and_m_t":"Maximum number of code words that a single DCI may schedule. This changes the number of MCS/RV/NDI bits in the DCI message from 1 to 2.","paragraph_zero_based":27660},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":27661},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI formats 1_0 and 1_1 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-Table-r17 is present for DCI format 1_1, the network does not configure the field mcs-Table (without suffix). For an (e)RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":27662},{"literal_text_all_w_t_and_m_t":"mcs-TableDCI-1-2","paragraph_zero_based":27663},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PDSCH for DCI format 1_2 (see TS 38.214 [19], clause 5.1.3.1). If all fields are absent the UE applies the value 64QAM. If the field mcs-TableDCI-1-2-r17 is present, the network does not configure the field mcs-TableDCI-1-2-r16. For an (e)RedCap UE, the 256QAM MCS table for PDSCH is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":27664},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK0","paragraph_zero_based":27665},{"literal_text_all_w_t_and_m_t":"List of minimum K0 values. Minimum K0 parameter denotes minimum applicable value(s) for the TDRA table for PDSCH and for A-CSI RS triggering Offset(s) (see TS 38.214 [19], clause 5.3.1).","paragraph_zero_based":27666},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-1-2","paragraph_zero_based":27667},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":27668},{"literal_text_all_w_t_and_m_t":"pdsch-AggregationFactor","paragraph_zero_based":27669},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 5.1.2.1). When the field is absent in PDSCH-Config which is not used for MBS CFR, the UE applies the value 1.","paragraph_zero_based":27670},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-1-2","paragraph_zero_based":27671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a5e54f9d13cb7a95dfb419323f36305c068c5cc939879e656cf76b11d5c84b40","2aac517a6d4bc5fdaab8509b9b3086c3ff4758067f67898bd1ec65e8d3020dba","97b2252dd31307fe67926583f7d14859945b0553f21d2bc1b3198a19bc4aef2d","7134b0e76f04c4c629ee87109d29094fa46774ce84d067579cbef7889cfe8965","19a085ecc587dbf9db1d6caa0bc691dc8482fb79d805a951bd102e417d7a591f","d101b3409945e400086ad4096fed3c4b10a61bb079c64a61dff1e8ff3d2ddca0","5c102c6257c2791a871d1f79299ba6177e9a0db04bab338bf3d1d4a155ee83ba","82693ca4d4bbccb1b31797caa4134283053e3fd4c5592dbaf58aa568b899e7fa","ab489efa334f7264adf17dd40e5499e66c2efd4f145e7d0e228b8f332436a43a","6cafd40784618721a121abe880d9e21efaea14ac0017b7d0ba92d4423b77a6d2","0e036c8c3a413a6582082201ce2e4bcbdf129096a526f517a65ec11fccff5ed5","0c74c9136e57f479f03e76d2670fafed412c708588dc59f8ef4b643833eb5943","8f1dc0ec3d60217f2550366bb73920ea4b437088b81fd22cdbc29d94bd68f97e","4c173f0b82c9fc0db064138d7f05278b16c6a5e083b22faa25a79d41d772c7e0","8374fca484ac8c704a0cc6a2f5d9f46b8756d7caaef950196a20f83ec8d17c2a","a82fdb0f067b5cfca4169d8e60c9874e9c70ac9618161146347632e2b4576057","9fe059c0b86e36dd54a7bc38be1541ced519a19d119c75c9bd4958d1dd7fa6e6","c2c91c56d0d325dcfa01d96ed0a5a931c964f1d2ebacde3ae04d2ff32ec7eb83","b0b62928a9f528ac7bf857300f3e12f6050e6fd1425cf2c81bbf78438773bb5a","38532d14b29b7e3c35c01ce361d759ab2c9a524762ac0cc92133498e35f818cc","50d11592cd0e38eb55738507e6cf50836a35b6892a800ca135c2cdb805fc099c","140f3845bbfc7cfef754998492d3e1b4749b75dd043adc5e4627604eeae2fb10","92b7c7e3dcc2296e831910d1b39b335b4bd5bfaef67a1e9409e512d26ffe7484","3fda3170820eb0bae5405464306f3c4a89a1f3db8b78228458f822436b9c6e83"],"paragraph_range_zero_based":[27648,27671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27648"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When configured, enhanced Type 3 HARQ-ACK codebook triggering by DCI format 1_2 is enabled.","paragraph_zero_based":27672},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field-1-2","paragraph_zero_based":27673},{"literal_text_all_w_t_and_m_t":"Enables the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in DCI format 1_2 if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH cell group.","paragraph_zero_based":27674},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackDCI-1-2","paragraph_zero_based":27675},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to report A/N for all HARQ processes and all component carriers configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27676},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-RetxDCI-1-2","paragraph_zero_based":27677},{"literal_text_all_w_t_and_m_t":"When configured, DCI format 1_2 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":27678},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList, pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH","paragraph_zero_based":27679},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data.","paragraph_zero_based":27680},{"literal_text_all_w_t_and_m_t":"The field pdsch-TimeDomainAllocationList (with or without suffix) applies to DCI format 1_0 and DCI format 1_1 (see table 5.1.2.1.1-1 in TS 38.214 [19]), and if the field pdsch-TimeDomainAllocationListDCI-1-2 is not configured, to DCI format 1_2. If the field pdsch-TimeDomainAllocationListDCI-1-2 is configured, it applies to DCI format 1_2 (see table 5.1.2.1.1-1A in TS 38.214 [19]). The field pdsch-TimeDomainAllocationListForMultiPDSCH applies to DCI format 1_1.","paragraph_zero_based":27681},{"literal_text_all_w_t_and_m_t":"The network does not configure the pdsch-TimeDomainAllocationList-r16 simultaneously with the pdsch-TimeDomainAllocationList (without suffix) in the same PDSCH-Config.","paragraph_zero_based":27682},{"literal_text_all_w_t_and_m_t":"prb-BundlingType, prb-BundlingTypeDCI-1-2","paragraph_zero_based":27683},{"literal_text_all_w_t_and_m_t":"Indicates the PRB bundle type and bundle size(s) (see TS 38.214 [19], clause 5.1.2.3). If dynamic is chosen, the actual bundleSizeSet1 or bundleSizeSet2 to use is indicated via DCI. Constraints on bundleSize(Set) setting depending on vrb-ToPRB-Interleaver and rbg-Size settings are described in TS 38.214 [19], clause 5.1.2.3. If a bundleSize(Set) value is absent, the UE applies the value n2. The field prb-BundlingType applies to DCI format 1_1, and the field prb-BundlingTypeDCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.3).","paragraph_zero_based":27684},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-1-1, priorityIndicatorDCI-1-2, priorityIndicatorDCI-4-2","paragraph_zero_based":27685},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"priority indicator\" in DCI format 1_1/1_2/4_2. When the field is absent in the IE, then 0 bit for \"priority indicator\" in DCI format 1_1/1_2/4_2. The field priorityIndicatorDCI-1-1 applies to DCI format 1_1, the field priorityIndicatorDCI-1-2 applies to DCI format 1_2 and the field priorityIndicatorDCI-4-2 applies to DCI format 4_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":27686},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDynDCI-1-2","paragraph_zero_based":27687},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_2 is enabled (see TS 38.213 [13], clause 9.A).","paragraph_zero_based":27688},{"literal_text_all_w_t_and_m_t":"p-ZP-CSI-RS-ResourceSet","paragraph_zero_based":27689},{"literal_text_all_w_t_and_m_t":"A set of periodically occurring ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList). The network uses the ZP-CSI-RS-ResourceSetId=0 for this set.","paragraph_zero_based":27690},{"literal_text_all_w_t_and_m_t":"If p-ZP-CSI-RS-ResourceSet is configured in both PDSCH-Config for MBS CFR and PDSCH-Config for the assoicated BWP, it is subject to UE capability whether the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for MBS CFR can be different from the p-ZP-CSI-RS-ResourceSet configured in PDSCH-Config for the assoicated BWP.","paragraph_zero_based":27691},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup1, rateMatchPatternGroup1DCI-1-2","paragraph_zero_based":27692},{"literal_text_all_w_t_and_m_t":"The IDs of a first group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup1 applies to DCI format 1_1, and the field rateMatchPatternGroup1DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":27693},{"literal_text_all_w_t_and_m_t":"rateMatchPatternGroup2, rateMatchPatternGroup2DCI-1-2","paragraph_zero_based":27694},{"literal_text_all_w_t_and_m_t":"The IDs of a second group of RateMatchPatterns defined in PDSCH-Config->rateMatchPatternToAddModList (BWP level) or in ServingCellConfig ->rateMatchPatternToAddModList (cell level). These patterns can be activated dynamically by DCI (see TS 38.214 [19], clause 5.1.4.1). The field rateMatchPatternGroup2 applies to DCI format 1_1, and the field rateMatchPatternGroup2DCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.4.1).","paragraph_zero_based":27695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b9addbf91787db45f045096362da8e4e25dd32470079e24e69fe9ec4bb8ddf3e","c5954a65245b4e06a666a462603da4a144a6a74aacbebba134fc377e1339a07b","163bc7df111d273768682dd8820d8d40e0414ae8196cd24f42cdaa2455364fbe","e7d89e4a775a6df78a32f0de48f8f9da60f6c2a5d3770044f454fe932e48707f","821723f9afa7a5a8d0ebf35db5c0bf7c87da2ae06fa162a5cd5f0ea1da614e35","56afc9e7f3b8aaf663e297c0c6d1d1f9b93c92d1813ffc9e57afe56e9c6fc978","d63dfdf5ca0a1c258827c7cec448ca1ae79c6af114e87b41b7c8a7629127f650","d6cc100d36f5348b8a8686cc315f80ff700ccc337f6520b3831de0f45a859b89","f22c3b6d695806f8c643a3f8e9d46d7d31372ee6fad8378ea79521fc5f74c051","b3598d259acc26fb1724c1c4dbd0b33190a5d8b6513e96c76346910f819297ee","df9cb531b4530e5f05c6257e73221142c4b74f1ec31ba8009095b563832195bf","91428fd1f3c9d50d4f8aa040c3447dbf6d9ac50e1b33cfaed77f8af3eb315092","798f804541d3dcd4a509ab3069230179ee8adfe68fc0b3e9e599feb940790a70","225e8841ccf8246c64a330568b3e14a4c8624f27ecc8e092a81d2434f555fe1d","d16165125b83d98f65e97faac92bb7cd4973c6accb6fb6a1626775f15f68b57d","7c78e5b9b083d334ae4bdfcaf69177875aaa2b384a3315df76385f632757b7c2","73336238c8289d1bc58c804a30465d18d1d042302cdc19ed2c076056bdc527b2","df331bbac5b4b1fab4df1af61a08d177c1026dcf636862b3ff453d581ab52203","b4a8bdec0c3a1c539adad585e2e0e5ce4d6d8a22fdca991962fa3d5f2e5f7c85","0390114f29d17a5f20ef137d279ecc699b66e99ce59a2f32ca6bc2997995919a","a4ea0245343deedd89c6a3d066c6cc5ef350af80d1bc94db5932b059eb50439f","6596e5dd2d5fdf4d277fc3d817591ab352bc0c5d1b39ce539fa579bcb0149eb6","b97934f0c84f20750bcbd19eba90471efcea6f6f1479b05a2744c0e1279fc948","2470104e3d5b5e9a35024fb4021e8ac0b9ffa7dbe14dcddf3f79a61e271098fb"],"paragraph_range_zero_based":[27672,27695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27672"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":27696},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both MBS CFR and its associated BWP, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":27697},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":27698},{"literal_text_all_w_t_and_m_t":"Selection between config 1 and config 2 for RBG size for PDSCH. The UE ignores this field if resourceAllocation is set to resourceAllocationType1 (see TS 38.214 [19], clause 5.1.2.2.1).","paragraph_zero_based":27699},{"literal_text_all_w_t_and_m_t":"referenceOfSLIVDCI-1-2","paragraph_zero_based":27700},{"literal_text_all_w_t_and_m_t":"Enable using the starting symbol of the PDCCH monitoring occasion in which the DL assignment is detected as the reference of the SLIV for DCI format 1_2. When the RRC parameter enables the utilization of the new reference, the new reference is applied for TDRA entries with K0=0. For other entries (if any) in the same TDRA table, the reference is slot boundary as in Rel-15. PDSCH mapping type A is not supported with the new reference. The new reference of SLIV is not configured for a serving cell configured to be scheduled by cross-carrier scheduling on a scheduling cell with different numerology (see TS 38.212 [17] clause 7.3.1 and TS 38.214 [19] clause 5.1.2.1).","paragraph_zero_based":27701},{"literal_text_all_w_t_and_m_t":"repetitionSchemeConfig","paragraph_zero_based":27702},{"literal_text_all_w_t_and_m_t":"Configure the UE with repetition schemes. The network does not configure repetitionSchemeConfig-r16 and repetitionSchemeConfig-v1630 simultaneously to setup in the same PDSCH-Config. The network does not configure this parameter and sfnSchemePDSCH in MIMOParam-r17 simultaneously in the same serving cell.","paragraph_zero_based":27703},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-1-2","paragraph_zero_based":27704},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 5.1.2.2). The field resourceAllocation applies to DCI format 1_1, and the field resourceAllocationDCI-1-2 applies to DCI format 1_2 (see TS 38.214 [19], clause 5.1.2.2).","paragraph_zero_based":27705},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-1-2","paragraph_zero_based":27706},{"literal_text_all_w_t_and_m_t":"Configure the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 1_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 5.1.2.2.2).","paragraph_zero_based":27707},{"literal_text_all_w_t_and_m_t":"sizeDCI-4-2","paragraph_zero_based":27708},{"literal_text_all_w_t_and_m_t":"Indicates the size of DCI format 4-2 (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":27709},{"literal_text_all_w_t_and_m_t":"sp-ZP-CSI-RS-ResourceSetsToAddModList","paragraph_zero_based":27710},{"literal_text_all_w_t_and_m_t":"AddMod/Release lists for configuring semi-persistent zero-power CSI-RS resource sets. Each set contains a ZP-CSI-RS-ResourceSetId and the IDs of one or more ZP-CSI-RS-Resources (the actual resources are defined in the zp-CSI-RS-ResourceToAddModList) (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":27711},{"literal_text_all_w_t_and_m_t":"tci-StatesToAddModList","paragraph_zero_based":27712},{"literal_text_all_w_t_and_m_t":"A list of Transmission Configuration Indicator (TCI) states indicating a transmission configuration which includes QCL-relationships between the DL RSs in one RS set and the PDSCH DMRS ports (see TS 38.214 [19], clause 5.1.5). If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":27713},{"literal_text_all_w_t_and_m_t":"unifiedTCI-StateRef","paragraph_zero_based":27714},{"literal_text_all_w_t_and_m_t":"Provides the serving cell and BWP where the configuration for dl-OrJointTCI-StateToAddModList-r17 are defined. When this field is present, dl-OrJointTCI-StateToAddModList and dl-OrJointTCI-StateToReleaseList are not present. The value of unifiedTCI-StateType of current serving cell is the same in the serving cell indicated by unifiedTCI-StateRef.","paragraph_zero_based":27715},{"literal_text_all_w_t_and_m_t":"vrb-ToPRB-Interleaver, vrb-ToPRB-InterleaverDCI-1-2","paragraph_zero_based":27716},{"literal_text_all_w_t_and_m_t":"Interleaving unit configurable between 2 and 4 PRBs (see TS 38.211 [16], clause 7.3.1.6). When the field is absent, the UE performs non-interleaved VRB-to-PRB mapping.","paragraph_zero_based":27717},{"literal_text_all_w_t_and_m_t":"xOverheadMulticast","paragraph_zero_based":27718},{"literal_text_all_w_t_and_m_t":"Accounts for an overhead from CSI-RS, CORESET etc. If the field is absent, the UE applies value xOh0 (see TS 38.214 [19]).","paragraph_zero_based":27719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f6a97073de8ca227a2cefa28dc8a120c91cf903cf853b9abdee399155e7b3be6","d4fc2f22fde00021dc0d86785841c591b78433cbc295223ec7cced0df4391554","95d2f8eeff0d4f12610f81544d1c567439bbdd266f84605a66dc85671939cef1","eb86b5b82e1f5e3a1e281a386442d3e34efb9e52b38982b3b6adcb70ce060f18","78c8c2f28522349d6e4cb4835d13b925a6641640af54237b7a9d1df1520808ea","a8d91abdec2532bdea47b8dc07c69289b2196b3a46f500acde255f23ce0af314","72399801a22add183353f9fa634a0c5899d9aeb9b7f8e3cea2509654379eeac8","69a50ed6c8dc08cfac9c8086905420d8ddec9db12241b0005d74f8b2886de485","1c0cf5bcabb65c1795d1643fb6c3a3891640eba194aef76948f1ae4fdd65df64","2228ac80ba0075aeed127dfa4043006c028d9cbb09e9b12c35fcba762eefe076","a2bdf46b951f1459ee8e09d65792d030490bd258a857010240f42e227bd7f403","dbe90ffde7315cf994046ebe5fc1c0d007d51fb270207532921f4314050a8610","bd2355d9690efd3690eb23e43775c81bc126150dd81cb378e6cf3136085a7e75","13ce0db1a01b3d86bd2043151aace3d5b50a0f4e3eea6726ec16f97e4fb56b41","195dd2c7d5ffa1a02a972a2a885cd99ff6be44ac13bc3b90d237b5ce25451fa7","968fc3ce86abec7b5a83d10cf8ea37df723737019411423c3b47bd5ce25786c1","d78c2d362121ea83f9f47dc88a0c518cf24f2b68f893017040490c0bc9a0a391","1a5f4870107e5faa57f8f0725a8d10277100b6292ad9b646e64206167b4bc08f","35e37316d9ec220d9ea5e048903534bedd881c1369bbb025d5d4431216e483fa","96f723078ee08c8628584d00aba339553e6482a8706aa822f94a70fc5e9ab190","1f89ac505e469e50538df01c117e35150433696a2419dcfb263e7e70df5d5b83","c0dbdec41b23debdd475e6092d5e1d9f2402aede7b1352befd7d8dfe4b93098b","31ee8c215dc7fed12a66286547ece092791209f4784ac061614c50362273e576","440fb127fc990433ab19a38f055ab0bb2e43ecdcbe01bb0c534f5e73c8c48a2a"],"paragraph_range_zero_based":[27696,27719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27696"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"zp-CSI-RS-ResourceToAddModList","paragraph_zero_based":27720},{"literal_text_all_w_t_and_m_t":"A list of Zero-Power (ZP) CSI-RS resources used for PDSCH rate-matching. Each resource in this list may be referred to from only one type of resource set, i.e., aperiodic, semi-persistent or periodic (see TS 38.214 [19]).","paragraph_zero_based":27721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27722},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigDCI-1-3 field descriptions","paragraph_zero_based":27723},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-1-3","paragraph_zero_based":27724},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 1_3 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":27725},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-1-3","paragraph_zero_based":27726},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 1_3 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":27727},{"literal_text_all_w_t_and_m_t":"rbg-SizeDCI-1-3","paragraph_zero_based":27728},{"literal_text_all_w_t_and_m_t":"Selection among config 1, config 2 and config 3 for RBG size for PDSCH. The UE ignores this field if resurceAllocationDCI-1-3 is set to resourceAllocationType1. (see TS 38.214 [19], clause 5.1.2.2.1).","paragraph_zero_based":27729},{"literal_text_all_w_t_and_m_t":"resourceAllocationDCI-1-3","paragraph_zero_based":27730},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 5.1.2.2).","paragraph_zero_based":27731},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-1-3","paragraph_zero_based":27732},{"literal_text_all_w_t_and_m_t":"Configure the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 1_3. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 5.1.2.2.2).","paragraph_zero_based":27733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27734},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27735},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27736},{"literal_text_all_w_t_and_m_t":"DCI-1-3","paragraph_zero_based":27737},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when ScheduledCellListDCI-1-3 is configured to the serving cell. It is absent otherwise.","paragraph_zero_based":27738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27739},{"literal_text_all_w_t_and_m_t":"–PDSCH-ConfigCommon","paragraph_zero_based":27740},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ConfigCommon is used to configure cell specific PDSCH parameters.","paragraph_zero_based":27741},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon information element","paragraph_zero_based":27742},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6ba62322d9d54ba2b9ec7fd996814b2c698127a33f789bedf30d748f9d71db15","acf4a5ee3c611a87fec111fd9bc7af0e27d66a2ec9d9b5e4e0a3444ca5182ae7","0ab1578548f929610123af174488c081b818b4243a35ae47c29063ac1aa70da2","c21f2885f3438c8625024827a58c1033248b110ecc91fba8fd94b093dbcf9005","d140856fabebce2f61317a65439e3df15c71023fc9c974f331894b15ca7c884c","ac3e7124c77876e0314432e4a19f8723