{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-Format2-2","paragraph_zero_based":33096},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_2 according to TS 38.213 [13], clause 10.1, 11.3.","paragraph_zero_based":33097},{"literal_text_all_w_t_and_m_t":"dci-Format2-3","paragraph_zero_based":33098},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_3 according to TS 38.213 [13], clause 10.1, 11.4","paragraph_zero_based":33099},{"literal_text_all_w_t_and_m_t":"dci-Format2-4","paragraph_zero_based":33100},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_4 according to TS 38.213 [13], clause 11.2A.","paragraph_zero_based":33101},{"literal_text_all_w_t_and_m_t":"dci-Format2-5","paragraph_zero_based":33102},{"literal_text_all_w_t_and_m_t":"If configured, IAB-MT monitors the DCI format 2_5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":33103},{"literal_text_all_w_t_and_m_t":"dci-Format2-6","paragraph_zero_based":33104},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_6 according to TS 38.213 [13], clause 10.1, 10.3. DCI format 2_6 can only be configured on the SpCell.","paragraph_zero_based":33105},{"literal_text_all_w_t_and_m_t":"dci-Format2-7","paragraph_zero_based":33106},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_7 according to TS 38.213 [13], clause 10.1, 10.4A.","paragraph_zero_based":33107},{"literal_text_all_w_t_and_m_t":"dci-Format2-9","paragraph_zero_based":33108},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_9 according to TS 38.213 [13], clause 10.1, 11.5.","paragraph_zero_based":33109},{"literal_text_all_w_t_and_m_t":"dci-Format4-0","paragraph_zero_based":33110},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_0 with CRC scrambled by MCCH-RNTI/G-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":33111},{"literal_text_all_w_t_and_m_t":"dci-Format4-1-AndFormat4-2","paragraph_zero_based":33112},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 and 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [11.1].","paragraph_zero_based":33113},{"literal_text_all_w_t_and_m_t":"dci-Format4-1","paragraph_zero_based":33114},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":33115},{"literal_text_all_w_t_and_m_t":"dci-Format4-2","paragraph_zero_based":33116},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":33117},{"literal_text_all_w_t_and_m_t":"dci-Formats","paragraph_zero_based":33118},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1.","paragraph_zero_based":33119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["85f0630c1368cd62bf71b6daa7fc3f89682af9755bfbeed58f39ab4b2cd1c0c2","4f9160c27e50ec3a03e6c533bfcb4b5fd748c67007981a1c5a8ef2b1031849fe","f7b4065a6dd5eea46e74aaca8e06542bffb9a9850f0d19711e8d7f34a81bc43a","6d13ee7540f327b2412f37522b83295a43c987c84526930bbd05e3cf09d88488","a6408b59a58386992d2a9bfd217e8801e1f370763bed96738d60041b505d4c3d","5ad487d798c7fe85cae6d005b2babe390462aa5ff1ac60d33b1f8b5d11417fe3","9aab5ce557dc33a0a78be85413c38a460baba10229ce7c74f9ba09ec16615494","4d9ea32b44b32b2a8f673672fe4ff17c0981956cb4cf961a889fd577d83c4ea2","c9de20fc18a6befff4cae21e0303022ae2d71e8bb92c3ba5c92cc040eb2197d6","b42295325f4879fcf79a137e92407aee80f4b9bc550141cb2e45de28c1b2ca8a","348b34315bd486fd6b24098c02c34da8ef64d08704166847a3ec6b3ba851cb67","e11ebd0b2909b64786b308f7a8173c50842541a6ccd62dfe6b494cc7006c1bf7","e089a327874898315e697f715fc09c51f851532999fbaaeb0ca265e9706e4f80","cc43ed0a2e84a7b118dbbb4b1ca334340b538edc7f30b504ada5060acb93891c","cf0b2e78680b6bd09b2338521640814d748580a92217fed8bdf0ba476112aae7","91e2abfa5c61bf139a8408370ed6cb816caaee8be079e669722c1cfc2ca3c242","edacc78595672e9fafe2bd83ee56f3b5e37533c3844c6f0be0b1a52ca22b69b8","44d31d16fc1ed59a2b63d476443c728e44baa1f5ab0565ef7bc143dfea7a30ec","c6b73cf71158d5aa98cce8dfdf390bc4edcdb1c6b7ee98902092e9f2ee5e1dd6","3d3b057977bf0d20841ee0657d3159687b5aa5421a3c948f16f3abb65fff1199","12e8b739e79d8b98e9be28c38c2bc3b41d04f77f8cf521b858a48605a33bd328","88841898f3b4bb8989ff5f66c179cd782729109129c18a75b380e9df8ec64b43","de8252c4e75f27117b0b5d9471689ec28fd19c0b29260f11f7811ab60a29da5c","f1720ed951e6f382dd109131176b0f607ed8b850e7cc6b8326dda8feded96567"],"paragraph_range_zero_based":[33096,33119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33096"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-FormatsExt","paragraph_zero_based":33120},{"literal_text_all_w_t_and_m_t":"If this field is present, the field dci-Formats is ignored and dci-FormatsExt is used instead to indicate whether the UE monitors in this USS for DCI format 0_2 and 1_2 or formats 0_1 and 1_1 and 0_2 and 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1). This field is not configured for operation with shared spectrum channel access in this release.","paragraph_zero_based":33121},{"literal_text_all_w_t_and_m_t":"dci-FormatsMC","paragraph_zero_based":33122},{"literal_text_all_w_t_and_m_t":"Indicate whether the UE monitors in this USS for DCI format 0_3 or for format 1_3 or for formats 0_3 and 1_3. Separate search space sets for DCI format 0_3/1_3 and legacy DCI formats are independently configured. If this field is present, the field dci-Formats is ignored.","paragraph_zero_based":33123},{"literal_text_all_w_t_and_m_t":"NOTE:This parameter is used only for SearchSpace configured to the scheduling cell, while another SearchSpace configured to the reference scheduled cell (if any) configures only nrofCandidates (i.e., all other optional fields are absent) with same serachSpaceId with that for scheduling cell.","paragraph_zero_based":33124},{"literal_text_all_w_t_and_m_t":"dci-Formats-MT","paragraph_zero_based":33125},{"literal_text_all_w_t_and_m_t":"Indicates whether the IAB-MT monitors the DCI formats 2-5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":33126},{"literal_text_all_w_t_and_m_t":"dci-FormatsNCR","paragraph_zero_based":33127},{"literal_text_all_w_t_and_m_t":"Indicates whether the NCR-MT monitors the DCI formats 2-8 according to TS 38.213 [13], clause 20.","paragraph_zero_based":33128},{"literal_text_all_w_t_and_m_t":"dci-FormatsSL","paragraph_zero_based":33129},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1 or for format 3-0 or for format 3-1 or for formats 3-0 and 3-1. If this field is present, the field dci-Formats is ignored and dci-FormatsSL is used.","paragraph_zero_based":33130},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":33131},{"literal_text_all_w_t_and_m_t":"Number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the UE applies the value 1 slot, except for DCI format 2_0. The UE ignores this field for DCI format 2_0. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":33132},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, duration-r17 is used, and the configured duration is restricted to be an integer multiple of L slots and smaller than periodicity, where L is the configured length of the bitmap monitoringSlotsWithinSlotGroup-r17. If duration-r17 is absent, the UE assumes the duration in slots is equal to L. The maximum valid duration is periodicity-L.","paragraph_zero_based":33133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33134},{"literal_text_all_w_t_and_m_t":"For IAB-MT, duration indicates number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the IAB-MT applies the value 1 slot, except for DCI format 2_0 and DCI format 2_5. The IAB-MT ignores this field for DCI format 2_0 and DCI format 2_5. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":33135},{"literal_text_all_w_t_and_m_t":"freqMonitorLocations","paragraph_zero_based":33136},{"literal_text_all_w_t_and_m_t":"Defines an association of the search space to multiple monitoring locations in the frequency domain and indicates whether the pattern configured in the associated CORESET is replicated to a specific RB set, see TS 38.213, clause 10.1. Each bit in the bitmap corresponds to one RB set, and the leftmost (most significant) bit corresponds to RB set 0 in the BWP. A bit set to 1 indicates that a frequency domain resource allocation replicated from the pattern configured in the associated CORESET is mapped to the RB set.","paragraph_zero_based":33137},{"literal_text_all_w_t_and_m_t":"monitoringSlotPeriodicityAndOffset","paragraph_zero_based":33138},{"literal_text_all_w_t_and_m_t":"Slots for PDCCH Monitoring configured as periodicity and offset.","paragraph_zero_based":33139},{"literal_text_all_w_t_and_m_t":"For SCS 15, 30, 60, and 120 kHz and if the UE is configured to monitor:","paragraph_zero_based":33140},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable.","paragraph_zero_based":33141},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213 [13], clause 10).","paragraph_zero_based":33142},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl1', 'sl2', 'sl4', 'sl5', 'sl8' and 'sl10' are applicable.","paragraph_zero_based":33143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["19b344addd81ec83bb6a8d23a01d62d9b77e0f4528614e8859dd0519b78f3831","8745e4c7ba230cb0133d5a83af84c6c309267f8fcc0b84dc6b3a70e4b1b83b84","c4f64b3a737d0ae718476d7733dc7df8ea1d002120f2d440cdac4bbfd02b207f","6ca79827b9b7b62a27f4ccaf04d85769fa5a3459b0d5d95c8723fa86725da06b","0224d0ad4bc22791d4c39a089563d03dca3865c5341c0e23128c142e62c55a4e","c8bd9428f9f34425ee470e93137c0f4759aad0cb6deca7f7590416fe0cd4435b","32e24a58681f8460f42ceb7821a2eeba065921cc56fda54031ae544a3bac2bca","077451b78f21bf67b4166f500653951d1a8437cacfb978c3718b7414fbdbd2a5","b99e5b3c304cc81aa525431689b82f64f0248239731c27f78a146a893e72c147","739602ac4624a867a1e8c389338aa90917f82b1dcdd09b3e6f748033a0cc219d","bb5e206de05fa6a9b716f091cf87d2fd68b522c31b2a0cc7cde276db4f15b939","6936e4143bec36811ce86698d3ee3a4c7eedf7a61648c0c6a39d5190ae66c964","7f9fc20d4619d827eae83b7f8f1155cbdeb61537a3f7876217d18d36ff68db37","e9f3a86d2cb87f5b6b63caf1c2b6ad8af9dd58373355396d309ad29edf08d4c2","539c1c751ae08906d6fb14a0d570b857d029c0c260f37247d9f6fc32dcfd3317","fe127d4e7d47896910e77da920c61e864a4201263286002de817a68d25ef0744","4062df2405255804469f8711937df68f66834cb99d39633bfc986e431debcf74","9a7a42328ded1bfca532413a9a3f2d0ce67bbd2826780941f5dbcce999685d1f","3095fa18d18e1db8d362bd01d08b4ec5a60c51117164afdc5c5115090dab32da","a71127279e034822cb25a7628c5aebee560d7f7a98c667c3426e142a2bffc604","12d96736518391789d3bae5d69a9019e98f3ced62906cd3d35ccce3bb365cd09","5f35fcf3d59c30e343056a2ff6679bf9bb81d0b1cac9f1e21c3709f9aee20380","0db4873a251690978371f4cb267bf27d7a212b6416b86b30cfb2555908b301eb","2cdc0520db9ee1713f9d245ab7f5fd25fd880d65a41e600082ded0b357284f97"],"paragraph_range_zero_based":[33120,33143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and if the UE is configured to monitor:","paragraph_zero_based":33144},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40', 'sl64', and 'sl80' are applicable.","paragraph_zero_based":33145},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl4′, ′sl8′, and ′sl16′ are applicable.","paragraph_zero_based":33146},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40' are applicable.","paragraph_zero_based":33147},{"literal_text_all_w_t_and_m_t":"For SCS 960 kHz and if the UE is configured to monitor:","paragraph_zero_based":33148},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80', 'sl128', and 'sl160' are applicable.","paragraph_zero_based":33149},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl8′, ′sl16′, and 'sl32' are applicable.","paragraph_zero_based":33150},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80' are applicable.","paragraph_zero_based":33151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33152},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, and the configured periodicity and offset are restricted to be an integer multiple of L slots, where L is the configured length of the bitmap provided by monitoringSlotsWithinSlotGroup-r17, i.e. for a given periodicity, the offset has a range of {0, L, 2*L, …, L*FLOOR(1/L*(periodicity-1))}.","paragraph_zero_based":33153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33154},{"literal_text_all_w_t_and_m_t":"For IAB-MT, If the IAB-MT is configured to monitor DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable. If the IAB-MT is configured to monitor DCI format 2_0 or DCI format 2_5, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213, clause 10).","paragraph_zero_based":33155},{"literal_text_all_w_t_and_m_t":"If monitoringSlotPeriodicityAndOffset-v1710 is present, any previously configured monitoringSlotPeriodicityAndOffset is released, and if monitoringSlotPeriodicityAndOffset is present, any previously configured monitoringSlotPeriodicityAndOffset-v1710 is released.","paragraph_zero_based":33156},{"literal_text_all_w_t_and_m_t":"monitoringSlotsWithinSlotGroup","paragraph_zero_based":33157},{"literal_text_all_w_t_and_m_t":"Indicates which slot(s) within a slot group are configured for multi-slot PDCCH monitoring. The first (leftmost, most significant) bit represents the first slot in the slot group, the second bit represents the second slot in the slot group, and so on. A bit set to '1' indicates that the corresponding slot is configured for multi-slot PDCCH monitoring (see TS 38.213 [13], clause 10). The number of slots for multi-slot PDCCH monitoring is configured according to clause 10 in TS 38.213 [13].","paragraph_zero_based":33158},{"literal_text_all_w_t_and_m_t":"monitoringSymbolsWithinSlot","paragraph_zero_based":33159},{"literal_text_all_w_t_and_m_t":"The first symbol(s) for PDCCH monitoring in the slots configured for (multi-slot) PDCCH monitoring (see monitoringSlotPeriodicityAndOffset and duration). The most significant (left) bit represents the first OFDM in a slot, and the second most significant (left) bit represents the second OFDM symbol in a slot and so on. The bit(s) set to one identify the first OFDM symbol(s) of the control resource set within a slot. If the cyclic prefix of the BWP is set to extended CP, the last two bits within the bit string shall be ignored by the UE or IAB-MT.","paragraph_zero_based":33160},{"literal_text_all_w_t_and_m_t":"For DCI format 2_0, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":33161},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":33162},{"literal_text_all_w_t_and_m_t":"For IAB-MT: For DCI format 2_0 or DCI format 2_5, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":33163},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":33164},{"literal_text_all_w_t_and_m_t":"nrofCandidates-CI","paragraph_zero_based":33165},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-4 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":33166},{"literal_text_all_w_t_and_m_t":"nrofCandidates-PEI","paragraph_zero_based":33167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["488173665460e3a021edbe1d12b961ff71e73b517260201352a905dcd6c1f1d9","a0cd2da4c0dcf76d3de4f4f4ccf2c973180f02f2e7571509d82ddfd794b8e561","337d2b223f876c7a746249f9f92e9b3488626cce735c671eeb046ca255212133","8273f2413668b69933a85fb1dc11fe6971957e94dfa7f8706e6ab18ece5cdb25","f1bef16f4b75a53c0910f943e05dea548143fa04c8b93f8aa608e91ed0592f5d","e314814598db70e41b57454dc78d8619cbdd783b2607250c70f2e88c2db7fdeb","05d8f2ae780fa3372bb2b46deb813416d9ed291af9e3789fb470a8224ccb0393","44f7bb775737e8dbbb771ecc8b6dc5531b5f6cacde5bd443271c00cd36848418","5abf555abfd7c0ace25e92c7c288dfbfc893b05a739ff3c46caa09bbb8129b78","e25b927834e979d7e72b3e3a31c4ef3a45b40c782c188a82d75ea9d202193fa6","6ee184eec16e927f2417d87ccaa9de3401bc02a028b3f0db820eecb2481a298c","889122e5a65e6d1bcf725959e31b7f7bcb36c9809cd0d3b0fd0ecb633e96c303","7d331c8bd944a9b6d9f4d95886fab1ded9d3830539124f2055888bab2710139f","1e8bee9675c43981931fdafcc88776eb3be519ce2f900efd081f42aeb38bcbd2","b19bf49402e5d18078b0cbf429ff6770537425ab289b82af5937e4def0d37b29","b67e2c7ee7f24080bc9cba807db1e85c798f83302ff96b228aa820e71457c60d","7ccfb55db01a338348cafcf45d6f514881164cfc1f6d29d15c26a238d20f5bda","9ada52efc18e909a2c725a8923f78c0879e0eac560be6bd6165b553052f98d69","dab0a028d762cd6480dd7117658d25509a0f747fc6c4816aed214faa1cb3cca3","f16a1f42bd284798fca817a9e69b5873e6bf02147f7e303a5281b292baa69ad4","84068777d73f5ab81b07ef4c84d9bdddd7cbd633fa5142e26b369ec2283a4479","996b7c1d531dd27e51be8f0add932d349cdbdc2ffa4fa59c97c00289e2aa85f3","722ba01efed32cada56c8352de340f9762929742f1e6b4ec25982279f743eb5e","bace828eda263ec063e83eb85e25757454a40cf47d634175fecfbe53ad13533c"],"paragraph_range_zero_based":[33144,33167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33144"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-7 for the configured aggregation level.","paragraph_zero_based":33168},{"literal_text_all_w_t_and_m_t":"nrofCandidates-SFI","paragraph_zero_based":33169},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-0 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 11.1.1). For a search space configured with freqMonitorLocations-r16, only value ′n1′ is valid.","paragraph_zero_based":33170},{"literal_text_all_w_t_and_m_t":"nrofCandidates","paragraph_zero_based":33171},{"literal_text_all_w_t_and_m_t":"Number of PDCCH candidates per aggregation level. The number of candidates and aggregation levels configured here applies to all formats unless a particular value is specified or a format-specific value is provided (see inside searchSpaceType). If configured in the SearchSpace of a cross carrier scheduled cell, this field determines the number of candidates and aggregation levels to be used on the linked scheduling cell (see TS 38.213 [13], clause 10).","paragraph_zero_based":33172},{"literal_text_all_w_t_and_m_t":"searchSpaceGroupIdList-r16, searchSpaceGroupIdList-r17","paragraph_zero_based":33173},{"literal_text_all_w_t_and_m_t":"List of search space group IDs which the search space is associated with. The network configures at most 2 search space groups per BWP where the group ID is either 0 or 1 if searchSpaceGroupIdList-r16 is included. The network configures at most 3 search space groups per BWP where the group ID is either 0, 1 or 2 if searchSpaceGroupIdList-r17 is included. And if searchSpaceGroupIdList-r17 is included, searchSpaceGroupIdList-r16 is ignored.","paragraph_zero_based":33174},{"literal_text_all_w_t_and_m_t":"searchSpaceId","paragraph_zero_based":33175},{"literal_text_all_w_t_and_m_t":"Identity of the search space. SearchSpaceId = 0 identifies the searchSpaceZero configured via PBCH (MIB) or ServingCellConfigCommon and may hence not be used in the SearchSpace IE. The searchSpaceId is unique among the BWPs of a Serving Cell. In case of cross carrier scheduling, search spaces with the same searchSpaceId in scheduled cell and scheduling cell are linked to each other. The UE applies the search space for the scheduled cell only if the DL BWPs in which the linked search spaces are configured in scheduling cell and scheduled cell are both active.","paragraph_zero_based":33176},{"literal_text_all_w_t_and_m_t":"For an IAB-MT, the search space defines how/where to search for PDCCH candidates for an IAB-MT where each search space is associated with one ControlResearchSet and for a scheduled cell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent.","paragraph_zero_based":33177},{"literal_text_all_w_t_and_m_t":"SearchSpaceLinkingId","paragraph_zero_based":33178},{"literal_text_all_w_t_and_m_t":"This parameter is used to link two search spaces of same type in the same BWP. If two search spaces have the same SearchSpaceLinkingId UE assumes these search spaces are linked to PDCCH repetition REF. When PDCCH repetition is monitored in two linked search space (SS) sets, the UE does not expect a third monitored SS set to be linked with any of the two linked SS sets. The two linked SS sets have the same SS set type (USS/CSS). The two linked SS sets have the same DCI formats to monitor. For intra-slot PDCCH repetition: The two SS sets should have the same periodicity and offset (monitoringSlotPeriodicityAndOffset), and the same duration. For linking monitoring occasions across the two SS sets that exist in the same slot: The two SS sets have the same number of monitoring occasions within a slot and n-th monitoring occasion of one SS set is linked to n-th monitoring occasion of the other SS set. The following SS sets cannot be linked with another SS set for PDCCH repetition: SS set 0, searchSpaceSIB1, searchSpaceOtherSystemInformation, pagingSearchSpace, ra-SearchSpace, searchSpaceMCCH, searchSpaceMTCH, peiSearchSpace, and sdt-SearchSpace. SS set configured by recoverySearchSpaceId cannot be linked to another SS set for PDCCH repetition. When a scheduled serving cell is configured to be cross-carrier scheduled by a scheduling serving cell, two PDCCH candidates (with the same AL and candidate index associated with the scheduled serving cell) are linked only if the corresponding two SS sets in the scheduling serving cell are linked and two SS sets in the scheduled serving cell with the same SS set IDs are also linked.","paragraph_zero_based":33179},{"literal_text_all_w_t_and_m_t":"This parameter is not applicable to search space configured with dci-FormatsSL for monitoring format 3-0 or format 3-1 or for monitoring formats 3-0 and format 3-1.","paragraph_zero_based":33180},{"literal_text_all_w_t_and_m_t":"searchSpaceType","paragraph_zero_based":33181},{"literal_text_all_w_t_and_m_t":"Indicates whether this is a common search space (present) or a UE specific search space as well as DCI formats to monitor for.","paragraph_zero_based":33182},{"literal_text_all_w_t_and_m_t":"ue-Specific","paragraph_zero_based":33183},{"literal_text_all_w_t_and_m_t":"Configures this search space as UE specific search space (USS). The UE monitors the DCI format with CRC scrambled by C-RNTI, CS-RNTI (if configured), and SP-CSI-RNTI (if configured)","paragraph_zero_based":33184},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33185},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":33186},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":33187},{"literal_text_all_w_t_and_m_t":"DedicatedOnly","paragraph_zero_based":33188},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present, Need R. Otherwise it is absent, Need R.","paragraph_zero_based":33189},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":33190},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is optionally present, Need M, otherwise.","paragraph_zero_based":33191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["40956020e49b9ef0d15dfd3bffe79addf0baa05c844279a2a27a8437ad17fa77","d2f4c9e92069394e7e777cde99048ec438df43b56165a32a47478280071dfaa6","c5a263ed0da3f1773b1d361f9f6a1beb7e5198041356c2c173bc6e94de8916c3","994225db89723c5d62f6d6c4d98958a09993a9185d9136d7151f2eb8a90dfb1e","a1cbc0182dcf4cdc4a224a7e63702da261ceeea54ada6547b70c5cad5bd5d2b3","c348d77d224bf747a294d2d15121cd4792e47f4066c78f07bbb09b0b0cb7c185","f7a65b432cee03da53b9cbcef74b89fb5050e6f178b3f41d491a78811c237b3d","4539e29f4ad1bc5868960346543cda62fd2742bde1ce8053184b5c40e1a99a29","9609333eca49821bf0a6da5f86ba5aa5795d78e43133f08754f7c1d287370071","9466fc0d28b603f807150eeb74df254221a9ca88fb9985b2405f5e130f86f69a","d320188571abb532142babe520674e59fab94dd927da6f89a812970cb7c38f1e","36869e98042ff7fd805c1db167f27ce842a0486b4ad01be4a2db160bb28a3648","f6f2e679e8cf25e4bbecc31947e0aae794c8f17a73943ac828317817d0444f95","12f9a5c02f07c266e9739db5d98cade15121f631c6224c309afd168d51c81d60","0f6ae310414edd636cb3ac4cf217eee734e1864e22cd49a01cce7d0395c07ada","3a8129adbe4f6161e883302c083c0443dfe66fbdb0dd4ef40eb77e2e6be3607f","95060891679a08c622c11ceeda5c7e201ae19bc04876dd6ceff3cf0952d10202","bc30d948247371d74d3b591180c1fc87d4e0118277e6467fef00dd3980147c0a","ae24117ecdcbb47cc78371ecbab7740b101a6b2fa2eeed0d76134cb3d9e7c815","c389d7fe398089b39660e2131497a44f6e2aef791be3218be9ff4a28871edac6","84c0a395c41589e91f3d12d88d1844fafb49bb4b4652a62f4029231fb979dd9d","b35dab2fcc19d8fc5aaba324c401d076549819099049136e2a18ec0af8a7f853","04a1404fa676c6f61898a1a596fc3d669267baceb03d40feef98da77adfa8d49","4100948959e7599d31f0e65e90e41102546113315fdd995327136c30501e2fc6"],"paragraph_range_zero_based":[33168,33191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33168"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":33192},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt-r16 of the parent IE with the field searchSpaceType-r16 or searchSpaceType-r17 included. Otherwise it is optionally present, Need M.","paragraph_zero_based":33193},{"literal_text_all_w_t_and_m_t":"Setup3","paragraph_zero_based":33194},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt (without suffix) of the parent IE with the field searchSpaceType (without suffix) included.  Otherwise it is optionally present, Need M.","paragraph_zero_based":33195},{"literal_text_all_w_t_and_m_t":"Setup4","paragraph_zero_based":33196},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset-v1710 is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":33197},{"literal_text_all_w_t_and_m_t":"Setup5","paragraph_zero_based":33198},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset (without suffix) is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":33199},{"literal_text_all_w_t_and_m_t":"SetupOnly","paragraph_zero_based":33200},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is absent, Need M, otherwise.","paragraph_zero_based":33201},{"literal_text_all_w_t_and_m_t":"SetupOnly2","paragraph_zero_based":33202},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present upon creation of a new SearchSpace and absent, Need M upon reconfiguration of an existing SearchSpace.","paragraph_zero_based":33203},{"literal_text_all_w_t_and_m_t":"In PDCCH-ConfigCommon, the field is absent.","paragraph_zero_based":33204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33205},{"literal_text_all_w_t_and_m_t":"–SearchSpaceId","paragraph_zero_based":33206},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceId is used to identify Search Spaces. The ID space is used across the BWPs of a Serving Cell. The search space with the SearchSpaceId = 0 identifies the search space configured via PBCH (MIB) and in ServingCellConfigCommon (searchSpaceZero). The number of Search Spaces per BWP is limited to 10 including the common and UE specific Search Spaces.","paragraph_zero_based":33207},{"literal_text_all_w_t_and_m_t":"SearchSpaceId information element","paragraph_zero_based":33208},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33209},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-START","paragraph_zero_based":33210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33211},{"literal_text_all_w_t_and_m_t":"SearchSpaceId ::=                   INTEGER (0..maxNrofSearchSpaces-1)","paragraph_zero_based":33212},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33213},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACEID-STOP","paragraph_zero_based":33214},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5c769fd1d20859005e05aaf31078e498dbb049b5746585e451b208228991fa69","f2d5dfdf8a10c91e5cc1a460acbd3ce9d12ebe71ec950b418