}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":46811},{"literal_text_all_w_t_and_m_t":"    sl-PSFCH-Occasion-r17                     INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":46812},{"literal_text_all_w_t_and_m_t":"    sl-SlotLevelResourceExclusion-r17         ENUMERATED {enabled}                                                 OPTIONAL,   -- Need R","paragraph_zero_based":46813},{"literal_text_all_w_t_and_m_t":"    sl-OptionForCondition2-A-1-r17            INTEGER (0..1)                                                       OPTIONAL,   -- Need M","paragraph_zero_based":46814},{"literal_text_all_w_t_and_m_t":"    sl-IndicationUE-B-r17                     ENUMERATED {enabled, disabled}                                       OPTIONAL,   -- Need M","paragraph_zero_based":46815},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46816},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46817},{"literal_text_all_w_t_and_m_t":"    sl-DeltaRSRP-Thresh-v1720                 INTEGER (-30..30)                                                    OPTIONAL    -- Need M","paragraph_zero_based":46818},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46819},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46820},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46822},{"literal_text_all_w_t_and_m_t":"SL-ThresholdRSRP-Condition1-B-1-r17 ::=   SEQUENCE {","paragraph_zero_based":46823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4d7a4d9de6a2c515a35c2f6b4401624793a77b5ab3ea59e45ad3ecdcd7529b84","ae008641fa300c02a447cd79eb4a7112a2f5811beeb43f4b418c5e8cb52f3379","4189145c1f37c2098f4b6127670358fc2a87c1519dcd73f3a4f8defa61a4d8a2","0dfea2d9691687553b34ad768c7e5bf5a3548b82e83a6ba889b73ebed9e20f02","97785119ed274e2e558b0c093a361c0316341bf003930cdc64a8fd74281b193f","2ead7e98f3bdc32e0f6c50954c576e55e5b2a0596ca0ae035b86607c0fb2d020","eeeb01a3c49a82c7dae451972365567867e2a8dff7bb651efb896b97079e8cf4","1a28ac31a336ccce8dd31d39dbf4afc87e48b1eb4b8fac3ddea2a474e9dc98fd","b7e7a452ba84ae550e191319157ba5fb463be70f2f16c34cd801624dd1cbbd16","0b4f2eb3c1b60c7db12385fb9a85c96fd55dc64c4670b95b6f4a48436fbfac42","5f433056aff082c710922a910ca647b1e9e0ea263574321ee9cf8b8d626477fd","7c7714663b987f7234e6aa2526b80cb8e20bdb10efe440137bc6839b317489ff","009336db602c2d8671122fce794be35f2f6bf8e72a8eb7e414f99e673a38dd66","9b74d161720efb4dfd2b39d8645b476e8f4b356641d1594c1e6ee50cee92751d","ae08df1ea129afe16b956a7628e96799c1c29d34fa9fe880b633dabd7dc1f768","b4b0320c9ea37186689cc8c002b4326dad258aea84a2bcfcce265db50dd537fa","d570fc0b02076aae870610a51443d22343ba1931fc748f050a35d2166903895e","1682fe4114890f167fda5d61faea7d8ab346226e199eaeb00e43e632a006d13b","789b289ae6e2d70c90a7a1f07700fcbd7fe9bafb6de08379bb7c5203e6195f00","a84566fcbd63ef402c67fe79f594d4c1eaae0b5909a376f5c8d42eb0e6ac92a1","d3ae2924a86adde4140a11f8dbc0b12bd9d8009f5aced21d4b57386bdebe1d87","b18120e3a5a03c86936673da50785774feee8f7437ba09c689e94ddaa8facb25","28cb119368af9d3a981d8a9487709639f05784f9062009f8ac19c4999c086a35","9f4f4bb637180b704a08e864de3b553a58706bd9541408fed424f0bd3e576473"],"paragraph_range_zero_based":[46800,46823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46800"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-Priority-r17                           INTEGER (1..8),","paragraph_zero_based":46824},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-r17       INTEGER (0..66)","paragraph_zero_based":46825},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46827},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-STOP","paragraph_zero_based":46828},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46829},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46830},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1 field descriptions","paragraph_zero_based":46831},{"literal_text_all_w_t_and_m_t":"sl-Condition1-A-2","paragraph_zero_based":46832},{"literal_text_all_w_t_and_m_t":"Indicates disabling the use of condition of excluding from preferred resource set resource(s) in slot(s) where UE-A, when it is intended receiver of UE-B, does not expect to perform SL reception from UE-B due to half duplex operation.","paragraph_zero_based":46833},{"literal_text_all_w_t_and_m_t":"sl-ContainerCoordInfo","paragraph_zero_based":46834},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of inter-UE coordination information transmission from UE-A to UE-B in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":46835},{"literal_text_all_w_t_and_m_t":"sl-ContainerRequest","paragraph_zero_based":46836},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of an explicit request for inter-UE coordination information transmission from UE-B to UE-A in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":46837},{"literal_text_all_w_t_and_m_t":"sl-DetermineResourceType","paragraph_zero_based":46838},{"literal_text_all_w_t_and_m_t":"Indicates how to determine the resource set type to be provided by inter-UE coordination information transmission. Value \"uea\" means the resource set type is determined by UE-A's implementation. Value \"ueb\" means the resource set type is determined by UE-B's request.","paragraph_zero_based":46839},{"literal_text_all_w_t_and_m_t":"sl-IUC-Condition","paragraph_zero_based":46840},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by a condition is enabled or not other than explicit request reception.","paragraph_zero_based":46841},{"literal_text_all_w_t_and_m_t":"sl-IUC-Explicit","paragraph_zero_based":46842},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by an explicit request is enabled or not. ","paragraph_zero_based":46843},{"literal_text_all_w_t_and_m_t":"sl-MaxSlotOffsetTRIV","paragraph_zero_based":46844},{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of logical slot offset with respect to a reference slot that is used for representing the first resource location of each TRIV to indicate the set of resources in Scheme 1 as specified in TS 38.214 [19].","paragraph_zero_based":46845},{"literal_text_all_w_t_and_m_t":"sl-NumSubCH-PreferredResousrceSet","paragraph_zero_based":46846},{"literal_text_all_w_t_and_m_t":"Indicates the number of sub-channels used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":46847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0048ee015e8a81b829ac082b392cef1dba54f9792d4bcba0afa6b755acba254b","097499a224139b2ad7ab3167b0b77bec4655b2d7eb5b15070d93a00057d9878f","82070c32950ad2487fcaeaa7d0734f5f52b04551d8900926a4526df7893b4f52","57cc29f0dd0421a7ac536fd0d984c7255c44b27d6acbdfa0f9934e85f55246a5","7fb9f46fc242be104fd8a88e601cd5defa82e9cde13aa151761425bb86053aa5","becb16af1f0b39b940439e407c8b7eaf83187a66494ada65b31c120749f4d0f2","53f07a82154980fbf9fb587d22f1135b0a9ba76c592e5473b62677792bf31d93","fd9c2d5df61d4e41d5b75f863bd92449a284d0d691a2c9a3bc4e912fbdaec244","0669d7b65d6451a75ba98f6fbb8c78cb919857417d6bd6ecd3d718c2bc7b4860","ba2977ec01aa3b7f812c286c86a2b4936f83551d988b81cbeff1ec1b92abb1c5","ff33af57c3bc7ebb10da6e5a1ae5d448ce2a6fcc787cbee9094b1bc96f524c6c","a8329a2a333f6a5d408981e327b4dc8af5430b1acb7a256d8cb6cd5de80155fc","f33b766efbb1cd16de9cb9efcc99e788fb4517bc2623b85ed3834f143e43201d","e4a5a7a2aacacf72f9f8e99e5c5886105fba9fe58c93ba37c91cfd01ac08e473","9daaf75c080713a889548ccbd8b6df3ea0eb656990b42bc4c212cd91f79b9a48","0c844a95465a4e13e181b02e05140a7010092788fdbafedfc07b6e76ecfce319","af922c2b1d1aaaab89512a1738ef6484d31a67e083a67f683f8cb2bc92486147","c64ba25d96ee93b182e37585b01d6db977b7ad27912b1a55b59917092f62076e","78f3b4fd084c7219549bde3b837f5248f415d9f2ab628147a70849aecfef20e1","b67b677674e2e8822878e0274a5c30a0d8ab34cb92d15d66e748182f0c9baee5","c75c97d56c92880dbd86f1ec28810f740fa15b30ede06517021abc4a9c426ef0","dc1dc58868d41c0b40fffc8f9be5494778717b7da7f47fe02b365f33db9ed229","563239c6289adbdd7e2ecaedb4b0420e4b23e2d496895b5c616a16c995ef3bfd","5de88bbd12cb988329c606bbd05856d386e094cbd524ff02f1118742c70c64ea"],"paragraph_range_zero_based":[46824,46847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46824"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoCondition","paragraph_zero_based":46848},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by a condition other than explicit request reception in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":46849},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoExplicit","paragraph_zero_based":46850},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by an explicit request in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":46851},{"literal_text_all_w_t_and_m_t":"sl-PriorityPreferredResourceSet","paragraph_zero_based":46852},{"literal_text_all_w_t_and_m_t":"Indicates the priority value used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":46853},{"literal_text_all_w_t_and_m_t":"sl-PriorityRequest","paragraph_zero_based":46854},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC request MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC request MAC CE, in an explicit request for inter-UE coordination information in Scheme 1. The priority value of IUC request MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":46855},{"literal_text_all_w_t_and_m_t":"sl-ReservedPeriodPreferredResourceSet","paragraph_zero_based":46856},{"literal_text_all_w_t_and_m_t":"Indicates the resource reservation interval used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition, by means of an index to the corresponding entry of sl-ResourceReservePeriodList-r16. ","paragraph_zero_based":46857},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionCoordInfo","paragraph_zero_based":46858},{"literal_text_all_w_t_and_m_t":"Indicates the additional alternative trigger condition of inter-UE coordination information triggered by a condition rather than request reception in Scheme-1 from UE-A to UE-B. Value 0 means inter-UE coordination information is triggered by UE-A's implementation. Value 1 means inter-UE coordination information can be triggered only when UE-A has data to be transmitted together with the inter-UE coordination information to UE-B.","paragraph_zero_based":46859},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":46860},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has data or SL-PRS to be transmitted to UE-A.","paragraph_zero_based":46861},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option1List","paragraph_zero_based":46862},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is larger than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":46863},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option2List","paragraph_zero_based":46864},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is smaller than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":46865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46866},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme2 field descriptions","paragraph_zero_based":46867},{"literal_text_all_w_t_and_m_t":"sl-DeltaRSRP-Thresh","paragraph_zero_based":46868},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold delta value corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13] and used to determine reserved resource(s) of other UE(s). Value in dB. Only even values (step size 2) allowed.","paragraph_zero_based":46869},{"literal_text_all_w_t_and_m_t":"sl-IndicationUE-B","paragraph_zero_based":46870},{"literal_text_all_w_t_and_m_t":"Indicates whether to enable or disable the usage of 1 LSB of reserved bits of a SCI format 1-A to indicate of whether UE scheduling a conflict TB can be UE-B or not.","paragraph_zero_based":46871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["92d1b6df2bb0e956030d898979a7e9d573f3c1a5eec260deb190ed8e18e00dea","2cba11a5ab5f856d4d54855ff0cbcd994b5e75d790a96abc4e846a69ece61c5e","754e8c40c2a6053ca9384894d0fb1cc9e45811fd2bfb5f8efa29c242f3e689b4","86bd22ee832f3351aeab94278a732c3af09249c6a362d0ca10aff9ec1b14a64d","bc24102ff76e6bc9c690eff6202a098b8e8a775c89cbbe6a51a42ce3e834e755","09cce8803abfccecf429db197ddcffde6f1d369398c5824446242dec48cd4ee8","40fcbca82023899ac3e59462b0af60212f0c0bcf15b40bcdd4447720596fa6a4","bc888d58c95de265595d4de80fede362674a5377a092e74e722640e24bc66fe1","2a9d16b155e25756786a34d4bf5cb216f1f22a2d7b36bda95d22148c0d44391c","e1c2236eff8bfa5d027072ede6c2cc77fb99d91889fa087ae8bae87b9a24c873","5153ff5b254523e4ba5ce5ae5b9620bcfefaf26a77464009c499e2046f52586d","dba0c46b3085c3229317ea0e1ee19138ee151b013193f15200d4603a32de9ba4","52316d8a0aa063125a704d5cc9367807238b672ded430c7a76cc3897a072f11c","ab0fc6c076bbb03b58e60592abda76dcb2551212baf07f4b77a62f702286b144","b6356c8967f0e4338b7d9e6cc313e8c437f3593d88e35f24ad68cd5bd6c1c2a5","0975c58033383fc17b014c5ef74e601c46fc0ebfc40ec81d67126d5e3ab077b1","b0ea452dd726ad88c4d16470e474df92faaa4e925495630b22b3192f9ab7baee","0529ebc99549eacca596068027fb06c939ebe360857ea5c1cc87ca0b3456a614","172a0deb61018ab207548a27621dfd635147aed54f6d1dd2e3400e456dc91c5f","9db14d1236c0d9642d871f2039c80ce1c22563a023b4e50ab98f567936f7184b","7cbc65c7b9fa2f9b135e68453e436bc2ce1004b2c29c4fc99c4d6225245033d1","cc9e53415b3e411eff28e69c62f1334282397fa11e85b43c5fae9e72dc4b465a","22a65841a84068260d2bf86529f70271189bd5534431f283fcca63d397eb6f34","fe0050fd98e968b22fd7a4d9c4076337fd3b8fbae8d386543bf06c367eef45ae"],"paragraph_range_zero_based":[46848,46871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46848"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-IUC-Scheme2","paragraph_zero_based":46872},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination Scheme 2 is enabled or not.","paragraph_zero_based":46873},{"literal_text_all_w_t_and_m_t":"sl-OptionForCondition2-A-1","paragraph_zero_based":46874},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to consider additional criteria for condition 2-A-1. Value 0 corresponds to using the RSRP threshold according to the priorities included in the SCI, UE uses thresholds sl-Thres-RSRP-List, in its resource pool configuration sl-UE-SelectedConfigRP, corresponding to ThresPSSCH-RSRP-List specified in clause 16.3.0 of TS 38.213 [13]. Value 1 corresponds to using a (pre)configured RSRP threshold delta value sl-DeltaRSRP-Thresh, corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13].","paragraph_zero_based":46875},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Occasion","paragraph_zero_based":46876},{"literal_text_all_w_t_and_m_t":"Indicates the reference slot from which a PSFCH occasion for inter-UE coordination information transmission is derived. Value 0 corresponds to the slot where UE-B's SCI is transmitted and value 1 corresponds to the slot where expected/potential resource conflict occurs on PSSCH resource indicated by UE-B's SCI.","paragraph_zero_based":46877},{"literal_text_all_w_t_and_m_t":"sl-RB-SetPSFCH","paragraph_zero_based":46878},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for inter-UE coordination information transmission and reception in Scheme 2. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on.","paragraph_zero_based":46879},{"literal_text_all_w_t_and_m_t":"sl-SlotLevelResourceExclusion","paragraph_zero_based":46880},{"literal_text_all_w_t_and_m_t":"Indicates that physical layer of UE-B reports resources in a slot including the next reserved resource indicated by the corresponding UE-B's SCI to higher layer.","paragraph_zero_based":46881},{"literal_text_all_w_t_and_m_t":"sl-TypeUE-A","paragraph_zero_based":46882},{"literal_text_all_w_t_and_m_t":"Indicates that a non-destination UE of a TB transmitted by UE-B can be UE-A which sends inter-UE coordination information to UE-B, when UE-A is a destination UE of another TB conflicting with the TB transmitted by UE-B.","paragraph_zero_based":46883},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46884},{"literal_text_all_w_t_and_m_t":"–SL-LBT-FailureRecoveryConfig","paragraph_zero_based":46885},{"literal_text_all_w_t_and_m_t":"The IE SL-LBT-FailureRecoveryConfig-r18 is used to configure the parameters used for detection and cancellation of sidelink consistent LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":46886},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig information element","paragraph_zero_based":46887},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46888},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LBT-FAILURERECOVERYCONFIG-START","paragraph_zero_based":46889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46890},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig-r18 ::=    SEQUENCE {","paragraph_zero_based":46891},{"literal_text_all_w_t_and_m_t":"    sl-lbt-FailureInstanceMaxCount-r18      ENUMERATED {n4, n8, n16, n32, n64, n128, spare2, spare1}              OPTIONAL,   -- Need M","paragraph_zero_based":46892},{"literal_text_all_w_t_and_m_t":"    sl-lbt-FailureDetectionTimer-r18        ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320, spare2, spare1}     OPTIONAL,   -- Need M","paragraph_zero_based":46893},{"literal_text_all_w_t_and_m_t":"    sl-lbt-RecoveryTimer-r18                ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320, spare2, spare1}     OPTIONAL,   -- Need M","paragraph_zero_based":46894},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dc0cc3be82bb4620f6398a81e938e226e6bcee25b1116388039e32a946f9f257","91d653a284e8e0a8b589f004d6294fd73b1ad2ef10b1adda2d7618d0164be099","eab828380e9ea1ac79c93ac23f9bdf3a3dd526d2b2a6b0ba1e64269296f89ae7","4962af55302031e965215a3a61d94615d72442bccaa53a2150ed214cb5194733","f163f742839b068325f102037dc34445d8c90ab99081cd3304f00dea0b03747c","166aac1970aee60b5885a3b63079d81761ac1270a0d49050392b3509cdac615d","1120106416d4ad336dbcf128a85fb02847a4f859af31eb6649dcecd80fe8f114","b49151f19d8918fca021441c52bd9d9b73f473331814b4e18f20eacebc1e92e4","f2fa51a502f865e1687741b501c873bab556fa96bca2fd5562a7bba70f3b63e1","72422cba08ab507ca31a4355715d657ec9de6af23b6f2988e93384f7ad3459a9","6a7b260beb77516aa1b3ed19a944be5e6947c16a2d1de90bcb8b9f8d35072af4","9ac53bb3ffd29197ddc9f5083c4a49909a5582312d13b3082366e4a3c3f235fd","593e2f252c18d733da02f3a272606485e5c624f038eaef0cc90c54a6a67da395","d8880475d12876a44b340fa0b911bb3b7e99368672fefd823156e24a9a25719b","3ab004baea7bd50dfeaf2984d1d9240793afbb7d2d5153136aa8b8c9c7187131","1907851871c4b78d470359ba9e5ee8e7403de30cb3ee55c8602d92aee429c6ae","df668ffccdf489d28fd11cb6c11963f9c2f79caf722e50e70743dd8faaa8a98f","aa18f2a425a400351f467bdb6a45227fdb6df9e8c0b16ee3e9a4d23c8e2bfc16","a1649dc136d6ec75441a2e25fd125393cd3cb690229a7ad105737bddf4de0039","ed7a7d8269e56242e5af871455fd31f25dd63cfcef0e00fd02ccb4da8717b6b3","5abe62e20b6f6837a1558471f446fd0720101eb31399f2cbeacda82722ce4584","90fd2b7b007b394f5335850b3046e265e95d8845a0b57d7c2baeb3