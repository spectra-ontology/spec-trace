{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40368},{"literal_text_all_w_t_and_m_t":"-- TAG-MIMO-PARAMETERSPERBAND-STOP","paragraph_zero_based":40369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40371},{"literal_text_all_w_t_and_m_t":"MIMO-ParametersPerBand field descriptions","paragraph_zero_based":40372},{"literal_text_all_w_t_and_m_t":"codebookParametersPerBand","paragraph_zero_based":40373},{"literal_text_all_w_t_and_m_t":"For a given frequency band, this field this field indicates the alternative list of SupportedCSI-RS-Resource supported for each codebook type. The supported CSI-RS resources indicated by this field are referred by codebookParametersperBC in CA-ParametersNR to indicate the supported CSI-RS resource per band combination.","paragraph_zero_based":40374},{"literal_text_all_w_t_and_m_t":"csi-RS-IM-ReceptionForFeedback/ csi-RS-ProcFrameworkForSRS/ csi-ReportFramework","paragraph_zero_based":40375},{"literal_text_all_w_t_and_m_t":"CSI related capabilities which the UE supports on each of the carriers operated on this band. If the network configures the UE with serving cells on both FR1 and FR2 bands these values may be further limited by the corresponding fields in fr1-fr2-Add-UE-NR-Capabilities.","paragraph_zero_based":40376},{"literal_text_all_w_t_and_m_t":"supportNewDMRS-Port","paragraph_zero_based":40377},{"literal_text_all_w_t_and_m_t":"Presence of this field set to supported1, supported2 or supported3 indicates that the UE supports the new DMRS port entry {0,2,3}.","paragraph_zero_based":40378},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40379},{"literal_text_all_w_t_and_m_t":"–ModulationOrder","paragraph_zero_based":40380},{"literal_text_all_w_t_and_m_t":"The IE ModulationOrder is used to convey the maximum supported modulation order.","paragraph_zero_based":40381},{"literal_text_all_w_t_and_m_t":"ModulationOrder information element","paragraph_zero_based":40382},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40383},{"literal_text_all_w_t_and_m_t":"-- TAG-MODULATIONORDER-START","paragraph_zero_based":40384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40385},{"literal_text_all_w_t_and_m_t":"ModulationOrder ::= ENUMERATED {bpsk-halfpi, bpsk, qpsk, qam16, qam64, qam256}","paragraph_zero_based":40386},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40387},{"literal_text_all_w_t_and_m_t":"-- TAG-MODULATIONORDER-STOP","paragraph_zero_based":40388},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40390},{"literal_text_all_w_t_and_m_t":"–MRDC-Parameters","paragraph_zero_based":40391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6f5d4c2bb07d0988e87a163b43ce2d39460c54ec80a90c453d7fe2cb190f3904","9526b81da41bed5a835d111f137cb4f9937debd8f1a27b33ec6519b760bcfd33","94d205200c2ee95a0357687c80eb95c3d768e72749e54e2f874b150f5ed310e4","4185c0f33a016c14d0123661d99b67d18fc12a2414f69b1e9122b43ac5ecd274","022ad3a2903b5f7b64fedef0d9951ffea1f42ee54157deaa0d8a21054aa18816","fe917b6ff5bdf1a38632dbd35f3f1e6fead6fc176ee1294e27bbee8affba25ac","2e7e1024b8d76b428614a80f0d52f39f1152f9c0d7646fa729901d04a9ab8bcf","7fb7434983710cd723e2449a3e4e54b7f7dbd19615c1f31b4a28e95ca5ec216c","4bff4677c0430ff784e77882e336ce27210a44020d343459798a76cb7bf216c0","d38d3abbce73b3624ac14fb3016587759127f2113a8cb636efb737c4c9bdb89b","f50d08564d212b561bf7ad08efef520a1