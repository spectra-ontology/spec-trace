{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationForAccessIdentity-r16  SEQUENCE {","paragraph_zero_based":30360},{"literal_text_all_w_t_and_m_t":"        ra-Prioritization-r16                   RA-Prioritization,","paragraph_zero_based":30361},{"literal_text_all_w_t_and_m_t":"        ra-PrioritizationForAI-r16              BIT STRING (SIZE (2))","paragraph_zero_based":30362},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":30363},{"literal_text_all_w_t_and_m_t":"    prach-RootSequenceIndex-r16             CHOICE {","paragraph_zero_based":30364},{"literal_text_all_w_t_and_m_t":"        l571                                    INTEGER (0..569),","paragraph_zero_based":30365},{"literal_text_all_w_t_and_m_t":"        l1151                                   INTEGER (0..1149)","paragraph_zero_based":30366},{"literal_text_all_w_t_and_m_t":"    }   OPTIONAL   -- Need R","paragraph_zero_based":30367},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":30368},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30369},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationForSlicing-r17         RA-PrioritizationForSlicing-r17                          OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":30370},{"literal_text_all_w_t_and_m_t":"    featureCombinationPreamblesList-r17     SEQUENCE (SIZE(1..maxFeatureCombPreamblesPerRACHResource-r17)) OF FeatureCombinationPreambles-r17 OPTIONAL -- Cond AdditionalRACH","paragraph_zero_based":30371},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30372},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30374},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMON-STOP","paragraph_zero_based":30375},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30377},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommon field descriptions","paragraph_zero_based":30378},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":30379},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 4-step RA. The network does not configure this list to have more than 32 entries.","paragraph_zero_based":30380},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":30381},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on (see TS 38.321 [3], clause 5.1.2). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":30382},{"literal_text_all_w_t_and_m_t":"msg1-SubcarrierSpacing","paragraph_zero_based":30383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["863807245636d6cf6160d1ca399b868c6c44061b69ff8c59b43b87ced565bb3f","b3ce94bf401b5b1cefd7e93bedb94b311235e104ff623133bda9e1d48ec672db","6b09f61f15e9df8eb927885e8951773bbe7ae1381e3ebe2d9bfef8aadcdd19b7","7afcead1fd604956298e564836f3c38b205d69483b8b6b8b4fadad2cc277e71c","d82bd9f68dcba73a95a94ad82accfee870493f8defffeffea8e319163e7d8032","4528d35fbf365aeaa437b48029138c929cd661ef8008e1352b3a3e0ce9e8fb3b","89c37433089d6c7de411cb97f963602483990af5ddca95874bcaf3cf65a94548","941eaa02d7a666b22c94f90f035e66cce15c9713d0476d4a1614c79d005d4c9a","8ae448d77712131ec41f9f9a4c993d479ee8f927f92642c02754a969278e336c","dbf5b1ea4feda8644dffe12f383b5d4258d431ac76ebb52e66155271a9504857","6a03bc1f63d7a5a98185e04f49d714bfdcd60cfdd656d24ea134ee11ef0fa422","1a97090e1357dc0db1a68aaf56af65d0e496466f3625bcea3a0c86370d2bcc24","ca88620e60d9445be54faaf8b95f7aa2de50964195e384c6ed12fc702864a70d","764900266b2806f38595574203fb031eb6adb4d2c988388cd0ac0027c914d6f9","5ed742cde6c00bec7d56e9ca8ad0e4b718a51272cefd18582ac519524cca52e6","42a1213681139544a1ab30741a7597aff534ae34087fe2dea5b31bc6ede8385f","3873702de4ea98135ce03e8949b4a136b2574a8db75c7926e200a7f4cacd0c3a","fe39678039cf5a31a304a9b68829c9cc13c9ff84a51ae207881739babcdd03a9","b7b6e3f38091951a538204cd812e176e8ea4eeada464c5d3a9d15c5e7f8f3ecf","960a2d81cb1b1674e84066f925112c9c00c2c34392f8e79060b75e43fb1f0d91","83c4da36d218231eca10497b7e6b0d8a30a9399359a498e7e0529da8819bdf56","a8b38452f6fcc1b2f4467c24b49fb9a8f8f66a17e47c4a91908971de3d06e47a","5356b0bc339d277dbadbda092e198fdda7515b7245c192bc70bbe0f6b294489b","bcc5e27058727e035475766d1866b7fd7350ed5fb6f59196b0b54219035cd5d6"],"paragraph_range_zero_based":[30360,30383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30360"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":30384},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":30385},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":30386},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":30387},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":30388},{"literal_text_all_w_t_and_m_t":"If absent, the UE applies the SCS as derived from the prach-ConfigurationIndex in RACH-ConfigGeneric (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]). The value also applies to contention free random access (RACH-ConfigDedicated), to SI-request and to contention-based beam failure recovery (CB-BFR). But it does not apply for contention free beam failure recovery (CF-BFR) (see BeamFailureRecoveryConfig).","paragraph_zero_based":30389},{"literal_text_all_w_t_and_m_t":"msg3-transformPrecoder","paragraph_zero_based":30390},{"literal_text_all_w_t_and_m_t":"Enables the transform precoder for Msg3 transmission according to clause 6.1.3 of TS 38.214 [19]. If the field is absent, the UE disables the transformer precoder (see TS 38.213 [13], clause 8.3).","paragraph_zero_based":30391},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":30392},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A. This determines implicitly the number of CB preambles per SSB available in group B. (see TS 38.321 [3], clause 5.1.1). The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB.","paragraph_zero_based":30393},{"literal_text_all_w_t_and_m_t":"prach-RootSequenceIndex","paragraph_zero_based":30394},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index (see TS 38.211 [16], clause 6.3.3.1). The value range depends on whether L=839 or L=139 or L=571 or L=1151. The length of the root sequence corresponding with the index indicated in this IE should be consistent with the one indicated in prach-ConfigurationIndex in the RACH-ConfigDedicated (if configured). If prach-RootSequenceIndex-r16 is signalled, UE shall ignore the prach-RootSequenceIndex (without suffix).","paragraph_zero_based":30395},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":30396},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":30397},{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":30398},{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":30399},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":30400},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on.","paragraph_zero_based":30401},{"literal_text_all_w_t_and_m_t":"ra-Msg3SizeGroupA","paragraph_zero_based":30402},{"literal_text_all_w_t_and_m_t":"Transport Blocks size threshold in bits below which the UE shall use a contention-based RA preamble of group A (see TS 38.321 [3], clause 5.1.2). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":30403},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":30404},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":30405},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":30406},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 indicates that the field ra-Prioritization-r16 applies otherwise the field does not apply (see TS 23.501 [32]).","paragraph_zero_based":30407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["68a9ac65d6317a01d95cd5744b693d1b9355c78b16bca2d84167626c75af728e","f302af40c0105c6a0acb4027cd43971c500d78dbaf9a34371330e978e6c570d8","49ed695ee298dde6b4a804e27d22e91ad558cfa43677cf79d89b3a559e509637","aa627377ed74166ce754cc2f04b6e00332e04e81b17338bdeb5ff4e769b81675","f3089156c557c4994df46659a8c1ff9ec985494789591b69fe22168a102bad4b","1efd953ea002ae9337acf9e856f653885e465fc0b31071e20a7ecdc70634e32a","432dc6c5e8fa9b18b7d00997757acaeb361b03b611a034b3785f2299c49fe0cf","fc49924343f76e3c51d21909dc4155ff8f4561362b40275bdd86af070fbc0eb1","68ed9a7c58ae15617c287ffeedff582a6aa51a5fac4a91c814f08987e5b815c4","678d6722fa8f124cf90006acddb56fa7e889dcbdf37eac2943c0318c96a81b0c","a6802766009e6e8ab659677238965c48a323bf7270a3e231e170d38313001d1b","607337c33cc587690d9944bc2e1a71fb3d452746b11c6baedca7ab5dd2fc6eeb","99c1c545f39a86d1bf923ce8e62ed6d994e6ebcd619cac2fc860fe33908b1d16","4e3b02b82a5fc579cbea891c8b1cf7d2d1e474e8a67bd6f31d20cee555cad8f1","d478c22622505b6184df2b017ab11378e0bf10eee01752bbdf72037e0e17c224","6cc1ad1f137fa48cdc2f6664e76d0a011d242d6c2efeaa669b88a294a23e7ce8","545780a284100c0147c6ea478a26de67b19725641b9473e5e8acf3dc3e322e29","370d2509f83f1eac53a835fad38a075e647ae9f1781d9ae27ddff55b3aa76734","49cb0c8f7c685b9805fd8cfd4e53521bd560ed5b07d71cdcae77dae5b7ec245f","5f231cfb12f4b8996b6e52d6dcb6d0892744a28da9252cb606b37887c3517672","6f6d9f366e96e04ca4a068c52127d58aa74ce2b41af4e24081ac631076177b9e","0763c0275ba30912da901c27fc67f8956191614ca490be62af0d2b4a8d129042","84697a25c5e81a310823b7af7f09b3451447476ce6c91bc6c2ed12f777dd161b","2751ee98b80e30d8324bae88db09444c04736e0b3b306d297f3cd4b990874d49"],"paragraph_range_zero_based":[30384,30407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30384"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicing","paragraph_zero_based":30408},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 4-step random access type for slicing.","paragraph_zero_based":30409},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":30410},{"literal_text_all_w_t_and_m_t":"RACH parameters for both regular random access and beam failure recovery.","paragraph_zero_based":30411},{"literal_text_all_w_t_and_m_t":"restrictedSetConfig","paragraph_zero_based":30412},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets, see TS 38.211 [16], clause 6.3.3.1.","paragraph_zero_based":30413},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB","paragraph_zero_based":30414},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":30415},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdSSB-SUL","paragraph_zero_based":30416},{"literal_text_all_w_t_and_m_t":"The UE selects SUL carrier to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). The value applies to all the BWPs and all RACH configurations.","paragraph_zero_based":30417},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":30418},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEighth corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). See TS 38.213 [13].","paragraph_zero_based":30419},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":30420},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention based and contention free 4-step or 2-step random access in the RACH resources defined in RACH-ConfigCommon, excluding preambles used for other purposes (e.g. for SI request). If the field is absent, all 64 preambles are available for RA. The setting should be consistent with the setting of ssb-perRACH-OccasionAndCB-PreamblesPerSSB, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":30421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30422},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30423},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30424},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":30425},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the RACH-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap and eRedCap, this field is mandatory present with at least FeatureCombinationPreambles list entries: the list entry/entries indicating only redcap or eRedCap and the other(s) indicating both redcap or eRedCap and one or multiple other feature(s) (e.g., smallData, nsag or msg3-Repetitions).","paragraph_zero_based":30426},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":30427},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":30428},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":30429},{"literal_text_all_w_t_and_m_t":"L139","paragraph_zero_based":30430},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if prach-RootSequenceIndex L=139, otherwise the field is absent, Need S.","paragraph_zero_based":30431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["60abd60c8530530c5f759b6f7f8a9205debc8f38c3999e62475692c01aecad47","088adc54fbbc997a7d1ea89f7ab6f4b44f60346cb4fbbb8897bd0c2ccb000094","8dacfd7bb11ab69778c9b6ccbdbc9133cf1abde72dda8e0f05b9edf493614488","db3735ac5aab2a997f4257e2850777e2a3b7b4d5a1665f8dd22acbbfb2b99940","572a5d8c3bfa8e565e40327ee2386c9e1b600bcc7a8fd71e1ad5c17e0426d3b2","c1c411e6c1f1145061dbbc3493b338d3c3d5cf7987cd33f604adf9ffa28e3ffb","39e2f98273a27ee184c3d0532d27387c59148a5e8761617970586208b61ad509","b9fb08044440b46ca22a0a7de848a67a476cd9b8cbddf76f44562fe0260f97b8","cb8596fcc3d2788a01f6f0d0082a1d4588cb0cd2f2643337857a9132b0a2b330","d88d00f05944217d5f68788c2c40a938c9512ae44d3a8549cd3af93d09785796","d781668812d5f896494f22fa91a1efad45ace2dbb6f6bd13aa467d4b87ad3aec","04e15d9494cb9588ea2841a341f9bb2011693690eefbd533d9cc6740ffbf5214","cc565879eb210090e6a5f0880f3de1765dc987fd156ffb5a844050376cd2aa40","ffc2e809e668aed92db6b18238d3099bb26c9421fad15e765aac7a0fb79c7029","0dbb16cdd2d1e28bcdcccf9550bd3f63e9922bb73cb9d66cb300f2e60ccfb9cd","09a156b2f0b0f1e14bb61a35e2d262946af55cd97e8e3063af0a47a74ca85be0","a48ca53aa22df098375a71ff539ce6940d14264616621f7801f39cc5a6f6acb3","4d8f5aa79b157aadfa0b1bc72a84c86b86275e51d06a8dffa6ac678d2eeba6d6","6a45649d35c06b41860e064e0170f5f2fb6a9ba41913ebae173330