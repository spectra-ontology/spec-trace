{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-List information element","paragraph_zero_based":34224},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34225},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-LIST-START","paragraph_zero_based":34226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34227},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-List-r16 ::=      SEQUENCE (SIZE(1..4)) OF SPS-PUCCH-AN-r16","paragraph_zero_based":34228},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34229},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-LIST-STOP","paragraph_zero_based":34230},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34232},{"literal_text_all_w_t_and_m_t":"–SRB-Identity","paragraph_zero_based":34233},{"literal_text_all_w_t_and_m_t":"The IE SRB-Identity is used to identify a Signalling Radio Bearer (SRB) used by a UE.","paragraph_zero_based":34234},{"literal_text_all_w_t_and_m_t":"SRB-Identity information element","paragraph_zero_based":34235},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34236},{"literal_text_all_w_t_and_m_t":"-- TAG-SRB-IDENTITY-START","paragraph_zero_based":34237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34238},{"literal_text_all_w_t_and_m_t":"SRB-Identity ::=                    INTEGER (1..3)","paragraph_zero_based":34239},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34240},{"literal_text_all_w_t_and_m_t":"SRB-Identity-v1700 ::=              INTEGER (4)","paragraph_zero_based":34241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34242},{"literal_text_all_w_t_and_m_t":"SRB-Identity-v1800 ::=              INTEGER (5)","paragraph_zero_based":34243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34244},{"literal_text_all_w_t_and_m_t":"-- TAG-SRB-IDENTITY-STOP","paragraph_zero_based":34245},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["152d528fca68ec43a3b85792f0c2879e955b009d397fdaef5fe4b330856ef5b8","3bc7ae40ffb0cfd87ac16bc4a4a1b62d477106b205290863f2d8426d79dd0bf2","6bc49b942c7a7a1a81498cc07ffd06c10a073bc6de40c49d2422100b9e2855b4","a9ae9bcf07f8b553ab47b61538bf40256c5c578d903078267603b944ba0f602e","e36dd83853a3ff53b8ce950dedee5bbd70c80cda2b76c5f9628e22df541e100b","b280c5cd0880cb8d2d963d6d2076a66669dd0bd626b8315d920730ce8b648094","adf239670d0be9d4762b5a69ab2ac1c73337420d6145a657dd2396ccb4421bfd","8c63d9789fc611c55b209b14f940a7e43095bc89e4571baa1eaefb71ac066956","596d9e14257536e10250793979971b9ee2946015f52a41fd82b60a5d9936f39b","999b7c3abaa376e7cfc2c709117943395b4dcab5bcf2d75c837304317b28a8bc","0d858c3be821b646ab21bdc2d453d33eaa4e097dcbeebd2a45cec0a105f8a3b5","b83dc4c618820af69fb34f36e1241df54a30a1faa0f31b7ece488d3f2df66902","a5d6a0ade7ecbd6f052cb7244dee79b28e018db29c018c44e60f035a664e1ad0","1493376eb8d7d31dfc12245c4027d0f02d99b06624eef81c405348e81626ed82","56dc4d3c9f6cc33181a0b30ba7aded7e626fb3d689dcf267c52fdb80cffbfeea","a7e5ea6aaa53c36cc9039cc0fa122211965797d51dc757d6abec92a4178396f4","21ba6941986cf07d090b4c83ad18203c4f1ffb2a06750bbfebf4cd0ee78c5463","cd75b32161006a1244bf6abad4cabe5d7a5bb1782a23d03418e19f4d8cdf963b","c0ffb0b93c01d02a9d2496fc6d6dc979dfc2612192e505f4d8b5cd2a377dc4cb","3e8ed1f3c65dcd54bc5b0f98683d6550b7a4c0190f7dc4e9699e409fe3d0f58d","592ec4c0f45a44d6264332ed9ca96cbf358ab9ef9d80fd88ca16d02656