{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ScalingFactorSidelink-r16 ::=       ENUMERATED {f0p4, f0p75, f0p8, f1}","paragraph_zero_based":36768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36769},{"literal_text_all_w_t_and_m_t":"IntraBandPowerClass-r16 ::=         ENUMERATED {pc2, pc3, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":36770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36771},{"literal_text_all_w_t_and_m_t":"SRS-SwitchingAffectedBandsNR-r17 ::= BIT STRING (SIZE (1..maxSimultaneousBands))","paragraph_zero_based":36772},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36773},{"literal_text_all_w_t_and_m_t":"-- TAG-BANDCOMBINATIONLIST-STOP","paragraph_zero_based":36774},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36776},{"literal_text_all_w_t_and_m_t":"BandCombination field descriptions","paragraph_zero_based":36777},{"literal_text_all_w_t_and_m_t":"BandCombinationList-v1540, BandCombinationList-v1550, BandCombinationList-v1560, BandCombinationList-v1570, BandCombinationList-v1580, BandCombinationList-v1590, BandCombinationList-v15g0, BandCombinationList-v15n0, BandCombinationList-v1610, BandCombinationList-v1630, BandCombinationList-v1640, BandCombinationList-v1650, BandCombinationList-v1680, BandCombinationList-v1690, BandCombinationList-v16a0, BandCombinationList-v1700, BandCombinationList-v1720, BandCombinationList-v1730, BandCombinationList-v1760, BandCombinationList-v1770, BandCombinationList-v1800","paragraph_zero_based":36778},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix). If the field is included in supportedBandCombinationListNEDC-Only-v1610, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":36779},{"literal_text_all_w_t_and_m_t":"If the field is included in supportedBandCombinationListNEDC-Only-v15a0, the UE shall include the same number of entries, and listed in the same order, as in BandCombinationList (without suffix) of supportedBandCombinationListNEDC-Only (without suffix) field.","paragraph_zero_based":36780},{"literal_text_all_w_t_and_m_t":"BandCombinationList-UplinkTxSwitch-r16, BandCombinationList-UplinkTxSwitch-v1630, BandCombinationList-UplinkTxSwitch-v1640, BandCombinationList-UplinkTxSwitch-v1650, BandCombinationList-UplinkTxSwitch-v1690, BandCombinationList-UplinkTxSwitch-v16a0, BandCombinationList-UplinkTxSwitch-v16e0, BandCombinationList-UplinkTxSwitch-v1700, BandCombinationList-UplinkTxSwitch-v1720, BandCombinationList-UplinkTxSwitch-v1730, BandCombinationList-UplinkTxSwitch-v1760, BandCombinationList-UplinkTxSwitch-v1770, BandCombination-UplinkTxSwitch-v1800","paragraph_zero_based":36781},{"literal_text_all_w_t_and_m_t":"The UE shall include the same number of entries, and listed in the same order, as in BandCombinationList-UplinkTxSwitch-r16.","paragraph_zero_based":36782},{"literal_text_all_w_t_and_m_t":"For the field of supportedBandCombinationList-UplinkTxSwitch-v1700, if the UE does not support 2Tx-2Tx switching for a given band combination, the field of supportedBandPairListNR-v1700 in the corresponding entry is absent.","paragraph_zero_based":36783},{"literal_text_all_w_t_and_m_t":"ca-ParametersNRDC","paragraph_zero_based":36784},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the NR capability container, the field indicates support of NR-DC. Otherwise, the field is absent.","paragraph_zero_based":36785},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDAPS","paragraph_zero_based":36786},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when any DAPS bearer is configured.","paragraph_zero_based":36787},{"literal_text_all_w_t_and_m_t":"ne-DC-BC","paragraph_zero_based":36788},{"literal_text_all_w_t_and_m_t":"If the field is included for a band combination in the MR-DC capability container, the field indicates support of NE-DC. Otherwise, the field is absent.","paragraph_zero_based":36789},{"literal_text_all_w_t_and_m_t":"supportedBandPairListNR-r16, supportedBandPairListNR-v1700","paragraph_zero_based":36790},{"literal_text_all_w_t_and_m_t":"Indicates a list of band pair supporting UL Tx switching as defined in TS 38.101-1 [15] for a given band combination.","paragraph_zero_based":36791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["812dbe1edf016646138aceee956a63c5f208e280de14badbd1197dcc5fafe7cc","7d7a15d442923e1b009f4b0381e5c3faea6cd4ba80bfdad632c630f19b8ffc8d","a3ea00237a4237a018fa2c84ba1d519576cdf13dd870a7b163307f333868897d","cd455b57009cf7d74cb31fd36ae669736340d4a1fc16d3606d6275514ec2cff1","dd55a0b080af7e2cf79be543f365d5d5f6b20ea07074fa4c4ce6a7dac53aae07","761cbf9e6550674d3d163d1aef37727f7d578ebd737e9c3e9afba6134da392d3","85194ea035a440ae5d3d65746dbc06599e09d9abf4c2c58deed6849c37ec128c","697fcf12a60c0160e8e5556671596b23df0e890341c1122fad7c6b99299536ca","1ecef292daa069041e08333d9cd20ed35e92f9a879e7ab70462384bf3032a72d","81b24cddcca6099af930a05069b49789468a4784fe80f67ab29b33e67dc86485","9e36c50bfe38486dc4916b9453253392ee251615bbf4a833b0e97b7e4db0a1ec","4391e93fd0c7cb2a51b5cc16f74d5832eafe81e5829693b302827ee0efed52e7","73439df68c7118d153238829a5ac21b7ad1f1539f9335e5c129d168e995e1943","57166e9f7df65525f52e827d946a630288d1dccacd5ba5871b24448449387ba5","eb1483eb3e1cf009c50d14b74beb91bbc0f59d6402cfd69206512bbb3343401a","8321dc1bf1c701850848a4f80907d61875ba83421aa9db9c9a949c28ad7b9cf4","b75cd6dae2ffa75185848bf33e5571e23b5d25f1a7fbe32c62e452f4d993412a","827832894cd0c7c46530da036021b3a6a5a57e32897a4a4052024310c9dee39a","eb1a0560d06ad748985927ac2c41ca41e9dd4beb3758fb01f52482d168e48f10","5b0f7617399edc01d9db0b29373cb9289d4a6cf9513ef78a41dd5d5e0488eb44","dcd913e7e514dc3485b3535592eddc0fbd1ef6536fe09570195c26e61acca931","260eb7738faf9aed3c2c7f30de65ca27f1e5194ab31059fdf598f06f259cacdc","b5158af939b6a9ff1152f242d974c44b312c81ba5b69a144230d6ee5ba5e11ad","07572f3459384a66a61ec3f5cab775b03e8d9351ce89f923da7a6043ea33551d"],"paragraph_range_zero_based":[36768,36791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p36768"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE supporting 2Tx-2Tx switching should include both of supportedBandPairListNR-r16 and supportedBandPairListNR-v1700. And the UE shall include the same number of entries listed in the same order as in supportedBandPairListNR-r16.","paragraph_zero_based":36792},{"literal_text_all_w_t_and_m_t":"If the UE does not support 2Tx-2Tx switching for a given band pair, the field of uplinkTxSwitchingPeriod2T2T in the corresponding entry is absent.","paragraph_zero_based":36793},{"literal_text_all_w_t_and_m_t":"supportedBandPairListNR-r18","paragraph_zero_based":36794},{"literal_text_all_w_t_and_m_t":"Indicates a list of band pair supporting UL Tx switching up to 4 bands as defined in TS 38.101-1 [15] for a given band combination. The UE shall include all the possible band pairs.","paragraph_zero_based":36795},{"literal_text_all_w_t_and_m_t":"For a band pair only supporting 1Tx-1Tx switching, the UE should include switchingPeriodFor1T in ULTxSwitchingBandPair-r18.","paragraph_zero_based":36796},{"literal_text_all_w_t_and_m_t":"For a band pair supporting 1Tx-2Tx switching, the UE always supports 1Tx-1Tx switching, and the UE should include switchingPeriodFor1T in ULTxSwitchingBandPair-r18.","paragraph_zero_based":36797},{"literal_text_all_w_t_and_m_t":"For a band pair supporting 2Tx-2Tx switching, the UE always supports 1Tx-2Tx switching and 1Tx-1Tx switching, the UE should include switchingPeriodFor2T as well as switchingPeriodFor1T in ULTxSwitchingBandPair-r18.","paragraph_zero_based":36798},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListNR","paragraph_zero_based":36799},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular pair of NR bands, the RF retuning time when switching between a NR carrier corresponding to this band entry and another (PUSCH-less) NR carrier corresponding to the band entry in the order indicated below:","paragraph_zero_based":36800},{"literal_text_all_w_t_and_m_t":"-For the first NR band, the UE shall include the same number of entries for NR bands as in bandList, i.e. first entry corresponds to first NR band in bandList and so on,","paragraph_zero_based":36801},{"literal_text_all_w_t_and_m_t":"-For the second NR band, the UE shall include one entry less, i.e. first entry corresponds to the second NR band in bandList and so on","paragraph_zero_based":36802},{"literal_text_all_w_t_and_m_t":"-And so on","paragraph_zero_based":36803},{"literal_text_all_w_t_and_m_t":"srs-SwitchingTimesListEUTRA","paragraph_zero_based":36804},{"literal_text_all_w_t_and_m_t":"Indicates, for a particular pair of E-UTRA bands, the RF retuning time when switching between an E-UTRA carrier corresponding to this band entry and another (PUSCH-less) E-UTRA carrier corresponding to the band entry in the order indicated below:","paragraph_zero_based":36805},{"literal_text_all_w_t_and_m_t":"-For the first E-UTRA band, the UE shall include the same number of entries for E-UTRA bands as in bandList, i.e. first entry corresponds to first E-UTRA band in bandList and so on,","paragraph_zero_based":36806},{"literal_text_all_w_t_and_m_t":"-For the second E-UTRA band, the UE shall include one entry less, i.e. first entry corresponds to the second E-UTRA band in bandList and so on","paragraph_zero_based":36807},{"literal_text_all_w_t_and_m_t":" -And so on","paragraph_zero_based":36808},{"literal_text_all_w_t_and_m_t":"srs-TxSwitch","paragraph_zero_based":36809},{"literal_text_all_w_t_and_m_t":"Indicates supported SRS antenna switch capability for the associated band. If the UE indicates support of SRS-SwitchingTimeNR, the UE is allowed to set this field for a band with associated FeatureSetUplinkId set to 0 for SRS carrier switching.","paragraph_zero_based":36810},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingBandParametersList-v1700","paragraph_zero_based":36811},{"literal_text_all_w_t_and_m_t":"Indicates a list of per band per band combination capabilities for UL Tx switching.","paragraph_zero_based":36812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36813},{"literal_text_all_w_t_and_m_t":"–BandCombinationListSidelinkEUTRA-NR","paragraph_zero_based":36814},{"literal_text_all_w_t_and_m_t":"The IE BandCombinationListSidelinkEUTRA-NR contains a list of V2X sidelink and NR sidelink band combinations.","paragraph_zero_based":36815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["70705d129407713ada82fa6626864a4c1799b5546bf5ce4155dc59d4552dd929","6cbf45cee50caffe4af7a1b8dc6c1903ee193ba9c172f9e8026c0d88e8d8a94d","59c6dbd1f2670de9e632ae1c67f882a1ebd07508fc0631cd8220ace1d7826e0c","564ccf3b56fd1b9a3f8d35214b788a605c932030a8c384d16d95bc2bd809b0a8","5a3fd8c4a7c04b9521f07f707211a56ea7bf71ceea2dc38ce05228964647c232","363c4da93a1fc992de45a8744eabb187688adfe3e685ab15d5bd9dd57a8d933d","3b81d68534f874268cc7089869e28edf9074c73b8198e0832b17e8895516dcb7","5da7125bc30bdc6a7270faba38e0596130885728e48386d4308a0f8438acba90","80e33054ce4d2a712e87e5d79cd7a2b92464e312e0283d43da31f26267ecf40c","670f4f9c9f15bfc3ae68175ccd2daa4edbdbaa256f0fc2f79254a01518ad3d13","a25cccb8f46612b05e601689fda88297947b8b0a3bd95c1090bf5960442b6ab9","9b7e2ca434158a00d23f4dac27031f3ca63378334215738b18bef7f5ca9edf65","479abae2df3a7e2d5fd9d93543ee8652abde9d34acbe2f31d49b31cdccb6e440","323746279e367b5c3c3e1a33c245ac4b5cfa10a374d7b08d487ba88335fc7a6b","e77649fe6620e48661aa2c7be8683019f173580634ec87a8120fc7ab39f0b5cc","bd7ce61e487c0cc59798a204dd00dfaac1521aebab31fb0cb40903c6191f7046","52311f13a72582ee049cbba7f27c1fa446fdcc1a264a7ca714cede0090fd100f","2cd51cd8