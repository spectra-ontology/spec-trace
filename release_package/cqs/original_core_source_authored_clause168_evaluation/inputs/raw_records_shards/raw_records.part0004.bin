{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-STOP","paragraph_zero_based":45720},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45722},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config field descriptions","paragraph_zero_based":45723},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfig","paragraph_zero_based":45724},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":45725},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":45726},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":45727},{"literal_text_all_w_t_and_m_t":"sl-BWP-Id","paragraph_zero_based":45728},{"literal_text_all_w_t_and_m_t":"An identifier for this sidelink bandwidth part.","paragraph_zero_based":45729},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfig","paragraph_zero_based":45730},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":45731},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigA2X","paragraph_zero_based":45732},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP. This field does not include sl-TxPoolScheduling. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":45733},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigPS","paragraph_zero_based":45734},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":45735},{"literal_text_all_w_t_and_m_t":"sl-BWP-PRS-PoolConfig","paragraph_zero_based":45736},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink PRS dedicated resource pool configurations for SL-PRS on the configured sidelink BWP. This field does not include sl-PRS-TxPoolExceptional.","paragraph_zero_based":45737},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45738},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic field descriptions","paragraph_zero_based":45739},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB-NonAnchorList","paragraph_zero_based":45740},{"literal_text_all_w_t_and_m_t":"Indicates the lowest S-SSB in a non-anchor RB set via each parameter in this list. Anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates.","paragraph_zero_based":45741},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionS-SSB","paragraph_zero_based":45742},{"literal_text_all_w_t_and_m_t":"Indicates the CPE starting position within the GP symbol before S-SSB transmission. The value is an index of the set of all candidate CPE starting positions specified in Table 5.3.1-3 of [16, TS 38.211] for Ci=1 and the corresponding SCS of the SL BWP.","paragraph_zero_based":45743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f68ac9f4d37604095cf6b829b5e4e9ba5033f4297587b6385ef6249cc2c26a0f","2e8223a13481aed15aee4c4f79c663d6d547c4634fa72d75567987dd2e2ccc20","7cdd097dba4a200e4b3b2f92a09185af404eab5c68ef924e53d52c5281ee4f8d","bd6c57975d8eedf70a400470eeadb4534bbdcfc25c217200d20cfd0aea57afaa","26fb85ebe461f9852ea1e47b8fdf1780d7cabc7a8185ff7bbe208d8f84467035","eda3cf72b2183c9fa74ee105299ca90a9049809cb308e7664000b96242f46422","64e1b130e0086e022a763ce6b02306a0201bee4b6a3c11aebb3c05dc7b395621","e7416140e15d2dc7af6db50e91687dbaafb266154e2d2a33fbbf333d674bfa47","1df329466f430949021cf672326131cf9e888ce7f6dcb2257bbdf8405781a943","32b22aef3ae977dcf83cedcce3f931de75799cc9686396a3ef8d9bfe1387d100","56aa9a29fc9dc5240feb5a14907b27131a7e7f674a3226d17c8e1bca162b2026","848eae1bce0a44875d3de1849bc09e6a0b28404b45130ace07af0751f92c2add","9739aa6ba38795be695886b1c5feaef355dd4c6aeeace4feb6c5b23d3235d176","834b9265dd49500914da9be95772da04bd3a358fd14bac4d8199b5a4e183debc","08b4e55140a0af83d01d5f243b8325f1a34319c53fa0ea80d7ed02b7236d6c99","dc57561f549ee40c2b7cdcba7f89852973542b202ccb0a68a997b94a0f106f67","4a4bad9eee21f4a2af4338330ef4fd07ef199a250a503d735577d2d3781becc9","9af008773d0da29ff600bdba1a967a4634a5ea95eeedf7d92d5d04d5530b38db","0b6f0cf3158f6b46910a7655003d9655f611186e9ac8f5b9e33a0078feadd71f","5224a201f50ac8566759ddfc71708419b849dc4e9461783582902c2a39908d58","3dbe2f028cdd1068e289e98307a88bb389b4cf2a90bb056633593e1ede61c23b","7f5a79a2b19cf41c2a5939f63624a4470a955791796e231dee8aa9b889f9fb7b","019b39183220712ae64c983a646bd3de2b9f854b378b7eeb5ab829db94397f78","9054090f11f9fe00dbd1e1ab8ccf92d09c4c0fe1979ade17d5fb80d51469bd10"],"paragraph_range_zero_based":[45720,45743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p45720"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-CWS-ForPsschWithoutHarqAck","paragraph_zero_based":45744},{"literal_text_all_w_t_and_m_t":"The latest CW_p is autonomously increased to the next higher allowed value for every priority class p of {1,2,3,4} if the same CW_p which is different from CW_(max,p) is consecutively used for general of N_init in SL Type 1 LBT for a number of times indicated by this parameter. This operation is restricted only to PSCCH/PSSCH transmission(s) with \"HARQ feedback enabled/disabled indicator\" in the 2nd stage SCI set to disabled, regardless of whether PSFCH resources being configured in a resource pool.","paragraph_zero_based":45745},{"literal_text_all_w_t_and_m_t":"sl-GapOfAdditionalSSSB-Occasion","paragraph_zero_based":45746},{"literal_text_all_w_t_and_m_t":"Indicate the gap between each R16/R17 NR SL S-SSB slot and its first corresponding additional candidate S-SSB occasion, and the gap between adjacent two additional candidate S-SSB occasions corresponding to a R16/R17 NR SL S-SSB slot.","paragraph_zero_based":45747},{"literal_text_all_w_t_and_m_t":"sl-IntraCellGuardBandsSL-List","paragraph_zero_based":45748},{"literal_text_all_w_t_and_m_t":"List of intra-cell guard bands for operation with shared spectrum channel access. If not configured, the guard bands are defined according to 38.101-1 [15], see TS 38.214 [19], clause 7. For operation in licensed spectrum, this field is absent, and no UE action is required.","paragraph_zero_based":45749},{"literal_text_all_w_t_and_m_t":"NOTE:Value '0' is not expected to be (pre-)configured for nrofCRBs when the SL BWP is larger than UE supported RF bandwidth for SL-U operation.","paragraph_zero_based":45750},{"literal_text_all_w_t_and_m_t":"sl-LBT-FailureRecoveryConfig","paragraph_zero_based":45751},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection and cancellation of sidelink consistent LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":45752},{"literal_text_all_w_t_and_m_t":"sl-LengthSymbols","paragraph_zero_based":45753},{"literal_text_all_w_t_and_m_t":"This field indicates the number of symbols used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":45754},{"literal_text_all_w_t_and_m_t":"sl-NumOfAdditionalSSSBOccasion","paragraph_zero_based":45755},{"literal_text_all_w_t_and_m_t":"Indicate the number of additional candidate S-SSB occasion(s) for each R16/R17 NR SL S-SSB slot.","paragraph_zero_based":45756},{"literal_text_all_w_t_and_m_t":"sl-SSSBPowerOffsetOfAnchorRBSet","paragraph_zero_based":45757},{"literal_text_all_w_t_and_m_t":"Indicate the power offset for one S-SSB transmission on anchor RB set, where anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates. Value value1 corresponds to the power offset of 10lg(N), where N is the number of S-SSB repetitions within the anchor RB set, and value2 corresponds to the power offset of 10leg(W), where W is the maximum total number of S-SSB repetitions on RB sets within the SL-BWP.","paragraph_zero_based":45758},{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolFirst","paragraph_zero_based":45759},{"literal_text_all_w_t_and_m_t":"Indicates the location of first starting symbol within a slot. Value sym0 corresponds to first symbol, value sym1 corresponds to the second symbol and so on. If the field is not configured, the UE shall use value sym0.","paragraph_zero_based":45760},{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolSecond","paragraph_zero_based":45761},{"literal_text_all_w_t_and_m_t":"Indicates the location of second starting symbol within a slot. Value sym3 corresponds to fourth symbol, value sym4 corresponds to the fifth symbol and so on.","paragraph_zero_based":45762},{"literal_text_all_w_t_and_m_t":"The number of symbols used for PSCCH/PSSCH transmission from second starting symbol is not smaller than 6. Within a slot, the second starting symbol is later than the first starting symbol. PSCCH/PSSCH transmission starting from first or second starting symbol shall have the same ending symbol within a slot.","paragraph_zero_based":45763},{"literal_text_all_w_t_and_m_t":"sl-StartSymbol","paragraph_zero_based":45764},{"literal_text_all_w_t_and_m_t":"This field indicates the starting symbol used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":45765},{"literal_text_all_w_t_and_m_t":"sl-TransmissionStructureForPSCCHandPSSCH","paragraph_zero_based":45766},{"literal_text_all_w_t_and_m_t":"Indicate a SL-BWP is (pre-)configured with contiguous RB-based or interlace RB-based PSCCH/PSSCH transmission. Contiguous RB-based PSCCH/PSSCH are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":45767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5ef96da755fbe19ca24bac52af6d5d0a4696dd36abf773e7df414281d796fd85","84445a9154072fe9ed1ae9af3d1f8e4baf5f87ca14be25292cdb56702899f716","c2999897d4d872490405ebfe42b960b998458025173046a94b8a2fc055b3e8ad","3673c27855a5b3c2d3a81880428ee0d838f9148367f1296ba3a00963092c0fa1","3db629556d31fc09ddf7ace5aeb215e8ca786aae97dfdf5a405f8bdfd16651b7","4dc7974a6c6df22afa40449ab66e029aabe82ce509cb34a7b824db4b8844294b","e465104a2322c2f1cbeaa4e01bb8fa1741a9d66c6ce555ae1ef4c9ddf1cef459","1952ef91482b19c7e86847c92546c84e3f17b87e3cfbfde49fb92b08353fbe8e","4c3dee6cd4