{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pei-ConfigBWP-r17      SEQUENCE {","paragraph_zero_based":27096},{"literal_text_all_w_t_and_m_t":"        pei-SearchSpace-r17                 SearchSpaceId,","paragraph_zero_based":27097},{"literal_text_all_w_t_and_m_t":"        firstPDCCH-MonitoringOccasionOfPEI-O-r17  CHOICE {","paragraph_zero_based":27098},{"literal_text_all_w_t_and_m_t":"            sCS15KHZoneT                                                     SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..139),","paragraph_zero_based":27099},{"literal_text_all_w_t_and_m_t":"            sCS30KHZoneT-SCS15KHZhalfT                                       SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..279),","paragraph_zero_based":27100},{"literal_text_all_w_t_and_m_t":"            sCS60KHZoneT-SCS30KHZhalfT-SCS15KHZquarterT                      SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..559),","paragraph_zero_based":27101},{"literal_text_all_w_t_and_m_t":"            sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT  SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..1119),","paragraph_zero_based":27102},{"literal_text_all_w_t_and_m_t":"            sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..2239),","paragraph_zero_based":27103},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..4479),","paragraph_zero_based":27104},{"literal_text_all_w_t_and_m_t":"            sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..8959),","paragraph_zero_based":27105},{"literal_text_all_w_t_and_m_t":"            sCS480KHZquarterT-SCS120KHZoneSixteenthT                         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..17919),","paragraph_zero_based":27106},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneEighthT                                           SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..35839),","paragraph_zero_based":27107},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneSixteenthT                                        SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..71679)","paragraph_zero_based":27108},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":27109},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL     -- Cond InitialBWP-Paging","paragraph_zero_based":27110},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27111},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27112},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-v1720           ENUMERATED {enabled}                                  OPTIONAL     -- Need R","paragraph_zero_based":27113},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27114},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27115},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-State-r18            ENUMERATED {first, second, both, none}                OPTIONAL,   -- Cond FollowUTCI","paragraph_zero_based":27116},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt-r18           SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-v1800         OPTIONAL,   -- Need R","paragraph_zero_based":27117},{"literal_text_all_w_t_and_m_t":"    searchSpaceMulticastMCCH-r18           SearchSpaceId                                         OPTIONAL,   -- Need R","paragraph_zero_based":27118},{"literal_text_all_w_t_and_m_t":"    searchSpaceMulticastMTCH-r18           SearchSpaceId                                         OPTIONAL    -- Need S","paragraph_zero_based":27119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ccdb81ed6a2439defd78323c6f1e91554a8e28a2da6b515997fd3279cd482fe3","22646ba2fdcfdd2c8034b93b4b8717f1dea262f8b584beb02ff8e33ae822d4f8","80bb4eecf7480458e0d545c8049c48a48e6cc5b80f4450f5c78d15a8260bde91","b0ef4d8ec96ba74b30f91ccf98bfb8438754f4bc9181c48d1290c436a7c3cbee","747fc45f1436d3b4eff083b3a0613b7b3c69bd0599df9dce02e5e86673da7361","2290bbb07148094f52c015c7f73a1025904dacdb6c86f17c34fec372d9c97f41","e9a6ee1a58e5cfe57ad740d097dbb571b1c34d71942f2d68f077991bbba11830","d7d63f86334cf31e132e0155938cb8a6e41335ee82822cf4dd8af1766fab2365","c91340663cc3ce0b8717d6c4fa6aa14886c37af189e571a24e9faa7890c2499a","5d19ccc9012795920b8fb728db9f2ffe5b1ce8951222b2b2a5d6b9605c8c9fb5","c1767aac3e03de04cd4d5f6f6a5ddd6b1d9d745c16efcb6229341fe93a766a6f","05a825e1061756a1ff48c582342b8d9a284e2e78f7d6e18489860483897400ad","489ea1d6ba1f2c7720e4fd710737c7dba69e3e0c28dd23e60820eb0e902af0f2","09b789596e46e238b43ecc45888a3fe07df10797fff7bf65de679ea26f1ca78f","4b2a47c5588e8d0786c841ca4952c44a1b420d6c4f6b67bbfbd087c5e373803e","617221702e21b0c082cbfe19aebf2862e77d3cd9f30b923a73a1ebd4dd1eb124","27494bbde4d5a6b92c461266b1f39f4f8ac9ab3373f558b2c499b4a20115ad8b","58f4c9ada007b0e19336645a320fe9bd4a730c85aa62fe5818ad9ca37e08bc0f","ab08e79683ed1b4d6bb1f00debac94b525d947fb5f8b494c1291ba33b23ba660","107d3a371bb7c76bbd432319052641711d800b24fdddb7736296c5eb8ac0a7dc","76f6cf6fc8fdef3c977f0dd0b9a97753f563649b4e4eeecf339debf29da441b5","68cb6f6d5f5cbb0e84346d171c1f6feff0186158b0acb05d76536acf04029018","562478e1e095bb2ac8e2d4d713c02937df81e8b5a9dddabf04b6bcd1d8c69ffb","bb9334ed0d5475eb604f2ae71c03b52dd0a883973da8a2c8ed5427f581aa6b63"],"paragraph_range_zero_based":[27096,27119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27096"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27120},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27122},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-STOP","paragraph_zero_based":27123},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27125},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon field descriptions","paragraph_zero_based":27126},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":27127},{"literal_text_all_w_t_and_m_t":"This field indicates, for PDCCH reception in CORESET #0, if UE applies the first, the second, both or none of the \"indicated\" DL only TCI or joint TCI as specified in TS 38.213 [13], clause 10.1.","paragraph_zero_based":27128},{"literal_text_all_w_t_and_m_t":"commonControlResourceSet","paragraph_zero_based":27129},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for any common or UE-specific search space. If the network configures this field, it uses a ControlResourceSetId other than 0 for this ControlResourceSet. The network configures the commonControlResourceSet in SIB1 so that it is contained in the bandwidth of CORESET#0. If the (e)RedCap-specific initial downlink BWP does not contain the entire CORESET#0, the network configures the commonControlResourceSet in the (e)RedCap-specific initial downlink BWP in SIB1 for (e)RedCap such that it does not have to be contained in the bandwidth of CORESET#0.","paragraph_zero_based":27130},{"literal_text_all_w_t_and_m_t":"commonSearchSpaceList, commonSearchSpaceListExt, commonSearchSpaceListExt2","paragraph_zero_based":27131},{"literal_text_all_w_t_and_m_t":"A list of additional common search spaces. If the network configures this field, it uses the SearchSpaceIds other than 0. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SearchSpace entries is considered to be newly created and the conditions and Need codes for setup of the entry apply. If the network includes commonSearchSpaceListExt/commonSearchSpaceListExt2, it includes the same number of entries, and listed in the same order, as in commonSearchSpaceList.","paragraph_zero_based":27132},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":27133},{"literal_text_all_w_t_and_m_t":"Parameters of the common CORESET#0 which can be used in any common or UE-specific search spaces. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0) controlResourceSetZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions defined in TS 38.213 [13], clause 10 are satisfied.","paragraph_zero_based":27134},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPEI-O","paragraph_zero_based":27135},{"literal_text_all_w_t_and_m_t":"Offset, in number of symbols, from the start of the reference frame for PEI-O to the start of the first PDCCH monitoring occasion of PEI-O on this BWP, see TS 38.213 [13], clause 10.4A. For the case po-NumPerPEI is smaller than Ns, UE applies the (floor(i_s/po-NumPerPEI)+1)-th value out of (N_s/po-NumPerPEI) configured values in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset. When po-NumPerPEI is one or multiple of Ns, UE applies the first configured value in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset.","paragraph_zero_based":27136},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":27137},{"literal_text_all_w_t_and_m_t":"Indicates the first PDCCH monitoring occasion of each PO of the PF on this BWP, see TS 38.304 [20]. The field sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS120KHZoneSixteenthT can be applied for SCS 480kHz, corresponding to sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS480KHZquarterT-SCS120KHZoneSixteenthT in IE DownlinkConfigCommonSIB respectively.","paragraph_zero_based":27138},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":27139},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception in CORESET #0, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":27140},{"literal_text_all_w_t_and_m_t":"pagingSearchSpace","paragraph_zero_based":27141},{"literal_text_all_w_t_and_m_t":"ID of the search space for paging (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive paging in this BWP (see TS 38.213 [13], clause 10). This field is absent for the (e)RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing, shall monitor paging in the initial DL BWP that includes CORESET#0.","paragraph_zero_based":27142},{"literal_text_all_w_t_and_m_t":"pei-ConfigBWP","paragraph_zero_based":27143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["21843f89848d36f4f6b2555d6c3cfb02b6e95c6d04f62783b571132cd09b9f49","21eb85459313f0ff8db02bb05cfdb4c171db53a026fcfd44bc8c1e9e94cade72","91597b8e1cdf2d0b1ea0e61ffd57081e8bb9eda30f86c53f9505bb2909c742c1","9e64cdb16102ba6c6600fb34ef48184da6d055a733faaa359dca9bb47003ca27","0fc3ace7994cfa316be42328625b9cb74de070c0fb5f96b63fe2939c83992040","8eb972f953fbfe8c5a06724a338cdb6b44659f6e4bb110f70f9d9121766184b1","cc2eb068fe5e8466f088122f92d4bd0a7b515985754d3e2b6f8818fc94c88b9b","d54632919ab8aff19c53803ecbfc7aaa3fa28f8c44756651a846edc60e64aa1a","be76cdf2e0fa171f06b3b3d8dca1dcef7ebb30392e0faf50799523dfba8b4a76","e13b87e92451d768c7387bc1c004a6e790ec1d2e6bcf26edb7476343c23df0ea","28e9ea8b856cf67f2de06fd55579290bd94e70d097160fe1b86fd3877e91d24f","1e8e030d1bff310ab890335d7c45fb60e8bf8a6bb1f1a25ff12a3dc49f49779c","0bc5da44d7dc77ae140239861c4c0698f438a6b5a9ded98eebe36c8e6b2cc79d","2f13f277d8e0d81c9a06126ec8f28751193472c4b7a676220c989587dda4db27","7d9b1e48bbdd9c657c7c83ce28ba30de97b0cc8e730dc3e079147009ac6edf3d","460cc118649bd045df907bc0e7cd42e609833268841153b40d670ad4b7de5c6c","b67f05ec359b04b3aae5dca1e7dcb2b4f8ea4a3b8b87820d5146acfeaf282e73","de7f15fcec0cc0ea30eaf3ce08920f9576338e47d7f03f7fe1c8f10f868d3a65","91494452e64f293f408853d52e75390f9a05257eb9f35fb2e5380154f707b011","5e6007534ef244abdc863621de7cb968de9ef821539096f2e7c6182397ab6b98","cc4eef83a62bfc2328f7c53aed527bb2d8ac329cb9445d3ee9518374c3c8e4d2","d4d9850ded7a1a455bf57cab288f5f5a76038865e0e3c00f6b99a514d23b3f39","e2d2ba33220bc8d027e1589f94c429bd28134ee19d098952d6f3fc0102868a37","acf91e6a6d4af0d438e987d1cc4e9087c02d4c3fcaabf67ba8eebfeef09ec171"],"paragraph_range_zero_based":[27120,27143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27120"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Provides the configuration for PEI reception in this BWP. If the field is absent, the UE does not receive PEI in this BWP. For the initialDownlinkBWP-RedCap not including CD-SSB and the entire CORESET#0, a RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing monitors PEI in the initialDownlinkBWP that includes CORESET#0, if the initialDownlinkBWP is configured with pei-ConfigBWP.","paragraph_zero_based":27144},{"literal_text_all_w_t_and_m_t":"pei-SearchSpace","paragraph_zero_based":27145},{"literal_text_all_w_t_and_m_t":"ID of dedicated search space for PEI. It can be configured to one of up to 4 common SS sets configured by commonSearchSpaceList with SearchSpaceId > 0. The CCE aggregation levels and maximum number of PDCCH candidates per CCE aggregation level follows Table 10.1-1 of TS38.213 [13]. SearchSpaceId = 0 can be configured for the case of SS/PBCH block and CORESET multiplexing pattern 2 or 3.","paragraph_zero_based":27146},{"literal_text_all_w_t_and_m_t":"ra-SearchSpace","paragraph_zero_based":27147},{"literal_text_all_w_t_and_m_t":"ID of the Search space for random access procedure (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive RAR in this BWP. This field is mandatory present in the DL BWP(s) if the conditions described in TS 38.321 [3], clause 5.15 are met.","paragraph_zero_based":27148},{"literal_text_all_w_t_and_m_t":"sdt-SearchSpace","paragraph_zero_based":27149},{"literal_text_all_w_t_and_m_t":"Common search space for CG-SDT and RA-SDT (see TS 38.213 [13]). If an existingSearchSpace is used, the network only signals the search space ID of the ra-SearchSpace.","paragraph_zero_based":27150},{"literal_text_all_w_t_and_m_t":"searchSpaceMCCH","paragraph_zero_based":27151},{"literal_text_all_w_t_and_m_t":"ID of the search space for MCCH. If the field is absent, the UE does not receive MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the (e)RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27152},{"literal_text_all_w_t_and_m_t":"searchSpaceMTCH","paragraph_zero_based":27153},{"literal_text_all_w_t_and_m_t":"ID of the search space for MTCH of MBS broadcast. If the field is absent, the UE applies searchSpaceMCCH also for MTCH, (see TS 38.213 [13], clause 10). This field is absent for the (e)RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27154},{"literal_text_all_w_t_and_m_t":"searchSpaceMulticastMCCH","paragraph_zero_based":27155},{"literal_text_all_w_t_and_m_t":"ID of the search space for multicast MCCH. If the field is absent, the UE does not receive multicast MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27156},{"literal_text_all_w_t_and_m_t":"searchSpaceMulticastMTCH","paragraph_zero_based":27157},{"literal_text_all_w_t_and_m_t":"ID of the search space for multicast MTCH. If the field is absent, the UE applies searchSpaceMulticastMCCH also for multicast MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27158},{"literal_text_all_w_t_and_m_t":"searchSpaceOtherSystemInformation","paragraph_zero_based":27159},{"literal_text_all_w_t_and_m_t":"ID of the Search space for other system information, i.e., SIB2 and beyond (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive other system information in this BWP. This field is absent for the (e)RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive other system information using searchSpaceOtherSystemInformation in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":27160},{"literal_text_all_w_t_and_m_t":"searchSpaceSIB1","paragraph_zero_based":27161},{"literal_text_all_w_t_and_m_t":"ID of the search space for SIB1 message. In the initial DL BWP of the UE′s PCell, the network sets this field to 0. If the field is absent, the UE does not receive SIB1 in this BWP. (see TS 38.213 [13], clause 10). This field is absent for the (e)RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive SIB1 using searchSpaceSIB1 in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":27162},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":27163},{"literal_text_all_w_t_and_m_t":"Parameters of the common SearchSpace#0. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0), searchSpaceZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions described in TS 38.213 [13], clause 10, are satisfied.","paragraph_zero_based":27164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27165},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27166},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9c513fdfdf12181dee42d7d792b7cacb4f29b8de3f83cad5fdef95a175d61a01","4a6a911eafcfb78a53db08656397de465e01779e777855fbb041a146f390cedb","414a545d16418ea87513cb4a2f0b8778c226b8ede99746bf3e3093d932f644b9","92b679917ba831db661a10a8c2b509dbcd4934ac4c4ebc8baa25b280417f7dd5","062360d4b12fa7f9359d407c3c2a64dd1206c12ccf40b882ba98881067b8ac24","2a9ee7e137bacbc4b328d6a1f4b8e6d5aea5bc713ef431c0a795bc8303b1e257","a01b789c65b82edab26d304e4fd135ac84347d4d17bde1740cad62566adee1cd","5d181bb44537f206c442507db59c73d837c10673df7685a152d890ee4d6a2e88","78a4fd018d213618e14de313687d5e6f4eeb24502f1ac2bccdb6e8479624f47e","32a6a83043cd5f873af1c2dbed5661e96e74bd912aa52ad0e34fd20d98f2ee02","f052f7fde5c1597a194e449d37f9c7a96184105588ba2abc9e7cf7ca00de5ea0","636d341d3c8e11cfe04cd883c154458fc870df725edd452fa3c2c07a1074701d","8d55abf9a850c8848c8ea2b00c7e71cae3cd4e044e6628ef959c1dcc996cdcbf","99a7958bbdbbab18a99b6d6e6927224d8661e25c1342ea8131e0dc76cb1b4fb0","415a81e064ab23dfa3e1f26641c841c7b0968802f0b7dee26a001a4c94e2f737","b27383a1a8aa8b9ca0ddc3c43f6701f810199db807470377bad476359ecd8fe9","9e7ca0c49b426d593873d52746c8343c470c96670a59c025f04a795ac7c0af24","f999f3753fc1fac56663b141dd25ba488547e8c5be7449e5fcde46b7fd659834","51f504a1e25313f84d78623c02330349169180311b6a5cc686af708652fea72b","859fd3a60b204cd68e75eb8c24263b70b5b1aabcab5348549336752e6c8266cc","b6f7f77c34f6bc9c12b0239360c11623432e90dff9e2fc772f06aff5191cd6b2","70084b9f7fd0f7127df45fc116a625291194fd35613a217f53eff3a2aed8114c","0272f5f44fc7d89741cec863d04be9407e287869049f193bcbd8aa9be18aebbb","7ba8102f96435898c96f685cebebfe8efb2c11c671199b3f7a20b1d132fbbf4a"],"paragraph_range_zero_based":[27144,27167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27144"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FollowUTCI","paragraph_zero_based":27168},{"literal_text_all_w_t_and_m_t":"The field is absent if the field followUnifiedTCI-State is present. Otherwise, it is optionally present, Need R.","paragraph_zero_based":27169},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":27170},{"literal_text_all_w_t_and_m_t":"If SIB1 is broadcast the field is mandatory present in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon except it is the (e)RedCap-specific initial BWP not including CD-SSB and the entire CORESET#0; it is absent in other BWPs and when sent in system information. If SIB1 is not broadcast and there is an SSB associated to the cell, the field is optionally present, Need M, in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon (still with the same setting for all UEs). In other cases, the field is absent.","paragraph_zero_based":27171},{"literal_text_all_w_t_and_m_t":"InitialBWP-Paging","paragraph_zero_based":27172},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initialDownlinkBWP or initialDownlinkBWP-RedCap including CD-SSB and the entire CORESET#0, and pei-Config is configured in DownlinkConfigCommonSIB. Otherwise, this field is absent.","paragraph_zero_based":27173},{"literal_text_all_w_t_and_m_t":"OtherBWP","paragraph_zero_based":27174},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is not the initialDownlinkBWP and pagingSearchSpace is configured in this BWP. Otherwise this field is absent.","paragraph_zero_based":27175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27176},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigSIB1","paragraph_zero_based":27177},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigSIB1 is used to configure CORESET#0 and search space#0.","paragraph_zero_based":27178},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 information element","paragraph_zero_based":27179},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27180},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-START","paragraph_zero_based":27181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27182},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 ::=                SEQUENCE {","paragraph_zero_based":27183},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero,","paragraph_zero_based":27184},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero","paragraph_zero_based":27185},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27186},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27187},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-STOP","paragraph_zero_based":27188},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27190},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 field descriptions","paragraph_zero_based":27191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bcbc8bba43aefa1399cc946c6573c2874216b4c204b6cc6ff636e7e9b222a4af","45facb86a148aa0cd51f267073adf0af450885ffce6a117cf85dfcb8ec6e79da","5b710b74f183bb6c3d9dbc24e429b3f348fd6c214e0fd432645b6ea7e39c7960","f1d6dbaa4ec3cf62ba180fc6e5678f8c982300ab9fcf8602bcde625c42850515","3ab11820436ec13ba7d88dbafc2a05294760eda353c5e5c793d950e9769c1d51","1b6e52b07aa8b68f887608e60b0eae387ac24eaf44d50c69007d1c0fba09cbae","b1cbc3324a9df368248cb07eb49d26188ed93a884fe8b4dc4d34e0bcc81c28e6","72310f2564b7da41c44be4626593c606417900aa511683601e5a0c4096b2fc57","2dd0819e50b3f9b37dc5b8473c3ab722cff9925b135f6f7674ebd443b34f83f9","9b669e4df6a1d7507175315119b55d9f32de6d01c0ab05b7f111a463bcacb29b","fbe1e5b769befb411db7520afa51668a230fce80d76a75947033c4fa8701e86b","8075c445f75ec08da80271a67a6402daf3d6cfc2d2d7340c40d01968fcdc7d26","c29b87a14dedc93bfb21bf1538e6eceed5b91b2a6ed74ccef7dc2e488f4aafe1","c502fcf03443cc79be8297b6e17a962ac7bdbd4b1e6d910d3b91077e71143d36","d6d11898582535f35e97003e905c2d7d3f2aa19d4fbe76f92e734e601a2ff875","e95b5a9018e8402bd32a4be4819c33b5f03b824d80789c7d18aa48a9b8a9493e","ed7db67155cb7c7dcea1596c966f636c45d6427129ee2d2b520bb53dc14df1d1","4002c4b9150f37a86c8f876f235717ad6b1c211ac98c635f01b18eaa4ee8633b","65e3ac25505dc184c9982f69820bc80e924969c35aa09e635773a47629f9b87f","8d095d3dd29d8adf1f9ee1441d490140d158f79e26da55ed9e55e08b4acd7d00","673e622d621fa68403bfb2c79ae2653b10b93b127014756f61f1d0783e79688b","b8ff6639cc2be0db1306c49f4d3777d29c84a85681346e4f0c370ff139c2edb9","c7ca2bb0f194626afcad75ea3e99759f0dad0667bbf80406429194ad3bf7f1a6","f8c7c19068f218f88e340083fbd14c848cdeb2ffc55edeb04730b4919e0ffc47"],"paragraph_range_zero_based":[27168,27191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27168"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":27192},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET) with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":27193},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":27194},{"literal_text_all_w_t_and_m_t":"Determines a common search space with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":27195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27196},{"literal_text_all_w_t_and_m_t":"–PDCCH-ServingCellConfig","paragraph_zero_based":27197},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ServingCellConfig is used to configure UE specific PDCCH parameters applicable across all bandwidth parts of a serving cell.","paragraph_zero_based":27198},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig information element","paragraph_zero_based":27199},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27200},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-START","paragraph_zero_based":27201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27202},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig ::=         SEQUENCE {","paragraph_zero_based":27203},{"literal_text_all_w_t_and_m_t":"    slotFormatIndicator                 SetupRelease { SlotFormatIndicator }                                OPTIONAL,   -- Need M","paragraph_zero_based":27204},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27205},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27206},{"literal_text_all_w_t_and_m_t":"    availabilityIndicator-r16           SetupRelease {AvailabilityIndicator-r16}                            OPTIONAL,   -- Need M","paragraph_zero_based":27207},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-r16          INTEGER (1..80)                                                     OPTIONAL    -- Need R","paragraph_zero_based":27208},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27209},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27210},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-v1710        INTEGER (81..1280)                                                  OPTIONAL    -- Need R","paragraph_zero_based":27211},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27212},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27214},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":27215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["29f3746f7abbfa859b52b86dfc800887897428cc416aa7fe44db8e425551da82","2df68cf4f109e8ddf0ffe09d4c3afd4e58cfe28674d6eba8ea263e6a2d916a1f","92982f8c3449181fc2233c8550e4ca089dd5f10d37c1feef131d38ce8a65cb2c","5442996e57e30ce826358f1a14081069601302fcdc15f15d502c5f906dbad6ef","9e818619c8b41302df22ca744aafbd69c3cf7992bdef04996a3a52393e78e6a8","0463b97422cc54fe420332811c67a0f5b5c2486d9c907b1866c9939b74ea3ec7","7e9c656da430e41ff978616ee28f4fc0d97db37c33873980ea1a9240d36d05b0","d9310a6b31671328bacb676278835423dff5671f8151cc591ec9075fec141f8b","49d861ec946db9b1432e1b6fd0528ce7f079cb59fe0b62d577e57f0c6f299cf6","d4b5790c5eab21e0aa413f9da3fed28a5ca1bb65aa2bdf6030bc5917eb8babb4","f7c342e11b8a59b51ede916084f6172fe11ccf7f44f8beda832e19c204ce1196","66b865ffeb456f176d1d2066e42f428f140cc77f0078fa58ea5a09662972b22c","107f640b1a2acfac68b2b8e28ee069bf1582f49d6b8df7952e795b9e2bfa5bb5","61c2b4f07ddd9d6c7019ffb3307e21b1244afd17eb5b28e3d5608337941c1df4","25c432415a06e9adfc281f6a04d3ec2d12b2219d59eec3fd31460a805d8ba371","441519336fdcac546400a57b6c6210868721fce53d02ae0b46f45809f2f1d9e2","8f1c8458e9ea8e01e1f45ae0db869e0ef6913e603a6ec13c947717cc3829acd0","26558a8b23ec6b54c5a428a4ee2d1114afd673e50816a78a9b2219b726c42a24","8c6d55c83ed3fe80d7315b6f5aae4a0853775ac34d8af498aad783b802de0962","6c57e4f4910a42731610f414fe8fb7a0e6987b5e955af9cd70808e1662cc41a9","364af2ef0007f0255dff3f2dbaca8ae83ee615d42bf072b1f82cf12e0c4159b1","8e29d154a38811ae02f4579f3c32a9a0c07b174434c8f3fb890a6f1d1111f9ef","6427516eef3661962803e0c901591db0a1d7eba0a9a3cf7e0a531f7b34dd170d","c5791c91010a91622808c73db7b2ccf13905eb27a08c37a6d4ddee95d9ffc380"],"paragraph_range_zero_based":[27192,27215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27192"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27217},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig field descriptions","paragraph_zero_based":27218},{"literal_text_all_w_t_and_m_t":"availabilityIndicator","paragraph_zero_based":27219},{"literal_text_all_w_t_and_m_t":"Use to configure monitoring a PDCCH for Availability Indicators (AI).","paragraph_zero_based":27220},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchTimer","paragraph_zero_based":27221},{"literal_text_all_w_t_and_m_t":"The value of the timer in slots for monitoring PDCCH in the active DL BWP of the serving cell before moving to the default search space group (see TS 38.213 [13], clause 10.4).","paragraph_zero_based":27222},{"literal_text_all_w_t_and_m_t":"For 15 kHz SCS, {1..20} are valid.","paragraph_zero_based":27223},{"literal_text_all_w_t_and_m_t":"For 30 kHz SCS, {1..40} are valid.","paragraph_zero_based":27224},{"literal_text_all_w_t_and_m_t":"For 60kHz SCS, {1..80} are valid.","paragraph_zero_based":27225},{"literal_text_all_w_t_and_m_t":"For 120 kHz SCS, {1..160} are valid.","paragraph_zero_based":27226},{"literal_text_all_w_t_and_m_t":"For 480 kHz SCS, {1..640} are valid.","paragraph_zero_based":27227},{"literal_text_all_w_t_and_m_t":"For 960 kHz SCS, {1..1280} are valid.","paragraph_zero_based":27228},{"literal_text_all_w_t_and_m_t":"The network configures the same value for all serving cells in the same CellGroupForSwitch.","paragraph_zero_based":27229},{"literal_text_all_w_t_and_m_t":"slotFormatIndicator","paragraph_zero_based":27230},{"literal_text_all_w_t_and_m_t":"Configuration of Slot-Format-Indicators to be monitored in the correspondingly configured PDCCHs of this serving cell.","paragraph_zero_based":27231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27232},{"literal_text_all_w_t_and_m_t":"–PDCP-Config","paragraph_zero_based":27233},{"literal_text_all_w_t_and_m_t":"The IE PDCP-Config is used to set the configurable PDCP parameters for signalling, MBS multicast and data radio bearers.","paragraph_zero_based":27234},{"literal_text_all_w_t_and_m_t":"PDCP-Config information element","paragraph_zero_based":27235},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27236},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCP-CONFIG-START","paragraph_zero_based":27237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27238},{"literal_text_all_w_t_and_m_t":"PDCP-Config ::=         SEQUENCE {","paragraph_zero_based":27239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["52769f00f21b85dd6c341b1da057e6124643a6a234e4102ff87d4b1e1cd6364a","55507f5682e6cd5d8845bcef745779588d33a7ffe3e47b64759feceac659af8c","dfd53f4fadbdcf850e76681df379a4af2be659872babd865689d66cebddaab30","cc0c534df19ec3fb41e2c63de8b8fcd6195433abef0a95efa87ccc720a1c9080","ff45f31a0b6a8a9174c2ba0e8f10ab1fafca025f8d8fa9edade4e9d89598a1f8","266b9246d1ef6d8d022e20bb6ca413d72e7f87619f6b23b726717c61c7cc235a","b78a4876b7c7510746df460788388d7f4b963896f05d3b01380a534fad25d3fc","bec979076e8697b7740f0aa19d3d825128bacde15bb0156cbcd67910deb75d9a","adede386934aa6b0ed8ab97f085fa3510e6202e903537e976735ae8300173e46","f2325830810fbd7b300d46b0789f5946a2d16eba34e220f1ddab0da85ee6727e","2260b4d52030cea2706bb89f60df31570c789e99402e2c9c8fd4ec9495b99b0d","914f8824a90b3cef5061abd726f40bf840caddc02129d25138fb34334ab4a467","e2cbce92d01b0f33ac81f92c7e2947b8587e4808856f8ed8cc794ac70f6b2464","9b613525c9450d6f46dd0f00d00d19435fef794bbba214662dac