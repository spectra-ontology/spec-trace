ea8c846be3ae9434d14d21744ea815795d2442","94423ade7b77ae772acc4f7d7287b3e03e8fabb4f68f5e24e057d661f4fd9c06","e1c94386ab1ad9ff1831d683c51fc20bdf8e637b383e6a4d0c58f78fe176af63","de7a9951aaebfdfe1b75a6517dcac5a5a2eb5e97dac52abc0a90dfbba0ea2b78","92dea8e3e9b1dd4b56a9bd7346f5f06bf3313fab4f41ac9beecf81ddbc7d5972","3c37a5abc07feed417b981c2a2789dd502f517e76ed85cd055810d646d01d16f","22bcdd5619ac263fb4834bd43363c7a257edf10d9811a95190c9a2a5e5aa5d8e","36f5ce86b8a9b1a630cbf2a9dbf199e87427df433b80dbffd0d37b1897b92ef5","70f4a1a04e4ac4c6689e394271b9e2fb0586eed71b05686fb83ec6b0d3b04248","4ffe035c756373e2c559c0d7a64a52f955f67e8add353d1cdcbb9bccb484227d"],"paragraph_range_zero_based":[16224,16247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16224"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16248},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16249},{"literal_text_all_w_t_and_m_t":"UEPositioningAssistanceInfo field descriptions","paragraph_zero_based":16250},{"literal_text_all_w_t_and_m_t":"nr-TimeStamp","paragraph_zero_based":16251},{"literal_text_all_w_t_and_m_t":"This field specifies the latest time instance at which the association is valid prior to the reporting.","paragraph_zero_based":16252},{"literal_text_all_w_t_and_m_t":"servCellID","paragraph_zero_based":16253},{"literal_text_all_w_t_and_m_t":"This field indicates the serving cell information of SRS for positioning resources associated to the UE Tx TEG report.","paragraph_zero_based":16254},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-ID","paragraph_zero_based":16255},{"literal_text_all_w_t_and_m_t":"Identifies the ID of UE Tx TEG.","paragraph_zero_based":16256},{"literal_text_all_w_t_and_m_t":"ue-TxTEG-TimingErrorMarginValue","paragraph_zero_based":16257},{"literal_text_all_w_t_and_m_t":"This field specifies the UE Tx TEG timing error margin value of all the UE Tx TEGs within one UEPositioningAssistanceInfo. Value tc0 corresponds to 0 Tc, tc2 corresponds to 2 Tc and so on (see TS 37.355 [49]).","paragraph_zero_based":16258},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16259},{"literal_text_all_w_t_and_m_t":"–ULDedicatedMessageSegment","paragraph_zero_based":16260},{"literal_text_all_w_t_and_m_t":"The ULDedicatedMessageSegment message is used to transfer segments of the UECapabilityInformation or MeasurementReportAppLayer message. SRB1 is used at transfer of segments of UECapabilityInformation and SRB4 or SRB5 is used at transfer of segments of MeasurementReportAppLayer.","paragraph_zero_based":16261},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1, SRB4 or SRB5","paragraph_zero_based":16262},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":16263},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":16264},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":16265},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment message","paragraph_zero_based":16266},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16267},{"literal_text_all_w_t_and_m_t":"-- TAG-ULDEDICATEDMESSAGESEGMENT-START","paragraph_zero_based":16268},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16269},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment-r16 ::=       SEQUENCE {","paragraph_zero_based":16270},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":16271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f8d383987f31251c48ead7fe5aa81b5fb8d44a8bc7769f740bbcf06d3670e582","74eabc14bbce0d520476be34d70659a273b095a07299a48716e404c0f908bd6d","dadd22d975f9230702a1f72bc30a4c6f5adbd22f5859d7a4c4ada3828ddaa6f1","eef55e8a6a967dbd3f3ccaad7d15bf613051c426eab1d914ce5d7028add2efe6","f417835e36ee01c11fa698cd3787b23967be1e554b0ff99357c66e6ad2e7e62a","257b13f970ea5005540f680922edd4dd801504a831e78df9b4a7e426d6d2925a","4052e26b0b89d626c3e92d6938705315523997d5e79ac64944fe8cd6adf0ba6a","c9a5d67cf553808973f258a78b1a792210ab255cae3a4bb048d98e7a23c790ec","663bc6b78b20a29d6398bbbed4f545a1cbcb6d442003d76286fe1e175d54a8f8","6def8bb424dc65422471084ffbbf0ba42f98470a333cd9664b6f03bb336bab3e","55f9866181af9b02ad3dfaba956e284ffbb60732cf175a4021af1cb88289adf4","91fd