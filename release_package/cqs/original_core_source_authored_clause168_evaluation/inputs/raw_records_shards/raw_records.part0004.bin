{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34368},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-START","paragraph_zero_based":34369},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34370},{"literal_text_all_w_t_and_m_t":"SK-Counter ::=  INTEGER (0..65535)","paragraph_zero_based":34371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34372},{"literal_text_all_w_t_and_m_t":"-- TAG-SKCOUNTER-STOP","paragraph_zero_based":34373},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34374},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34375},{"literal_text_all_w_t_and_m_t":"–SlotFormatCombinationsPerCell","paragraph_zero_based":34376},{"literal_text_all_w_t_and_m_t":"The IE SlotFormatCombinationsPerCell is used to configure the SlotFormatCombinations applicable for one serving cell (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34377},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell information element","paragraph_zero_based":34378},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34379},{"literal_text_all_w_t_and_m_t":"-- TAG-SLOTFORMATCOMBINATIONSPERCELL-START","paragraph_zero_based":34380},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34381},{"literal_text_all_w_t_and_m_t":"SlotFormatCombinationsPerCell ::=   SEQUENCE {","paragraph_zero_based":34382},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":34383},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":34384},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing2                  SubcarrierSpacing                                                         OPTIONAL, -- Need R","paragraph_zero_based":34385},{"literal_text_all_w_t_and_m_t":"    slotFormatCombinations              SEQUENCE (SIZE (1..maxNrofSlotFormatCombinationsPerSet)) OF SlotFormatCombination","paragraph_zero_based":34386},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need M","paragraph_zero_based":34387},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER(0..maxSFI-DCI-PayloadSize-1)                                      OPTIONAL, -- Need M","paragraph_zero_based":34388},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":34389},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34390},{"literal_text_all_w_t_and_m_t":"    enableConfiguredUL-r16              ENUMERATED {enabled}                                                      OPTIONAL  -- Need R","paragraph_zero_based":34391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cb208e389affb939fe420d8c861310533c4a42a7cafb55c3c0494cfea8b1add9","bfc2cbe60ddc44b9f161b318eaa1ab026f78528fd7ee87fd9b6bd5d115e068d9","799a7054f9ec807734d53e12cb5caf1f702c3bbe0e271d968199ef5cffc70b5c","33114f0afbe0fd55a8bf022c2dd05e7051344f26fad234ac1e8860c85b44f21a","738775cfa51c8cf4f682595f7acc4031d768106cadcb0dfe567e2ebf6196ee67","bc92bea794c273f7c0b224fd87c91e920acb284e2e5cf0006efef186f02342f4","1707291a48e4f57d3a5c7d7dd889c374fdd5372f6932e07b752717c11d2f56c6","4795e0e15919d68d922def5f0046a0da53d49eba3614516517db7d0d0e8ba1cd","c05cb9cb5af3572c9fb521c23c22248b69991e14d8375196f43dacfcc4da3825","e93da0602eda8ddee6a2f20588fcc0213bb561978d4bbb445da60f63a041c439","bf8731cd3abbc3099c255526ddede7