{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–RateMatchPatternLTE-CRS","paragraph_zero_based":31248},{"literal_text_all_w_t_and_m_t":"The IE RateMatchPatternLTE-CRS is used to configure a pattern to rate match around LTE CRS. See TS 38.214 [19], clause 5.1.4.2.","paragraph_zero_based":31249},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS information element","paragraph_zero_based":31250},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31251},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-START","paragraph_zero_based":31252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31253},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS ::=         SEQUENCE {","paragraph_zero_based":31254},{"literal_text_all_w_t_and_m_t":"    carrierFreqDL                       INTEGER (0..16383),","paragraph_zero_based":31255},{"literal_text_all_w_t_and_m_t":"    carrierBandwidthDL                  ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1},","paragraph_zero_based":31256},{"literal_text_all_w_t_and_m_t":"    mbsfn-SubframeConfigList            EUTRA-MBSFN-SubframeConfigList                                          OPTIONAL,   -- Need M","paragraph_zero_based":31257},{"literal_text_all_w_t_and_m_t":"    nrofCRS-Ports                       ENUMERATED {n1, n2, n4},","paragraph_zero_based":31258},{"literal_text_all_w_t_and_m_t":"    v-Shift                             ENUMERATED {n0, n1, n2, n3, n4, n5}","paragraph_zero_based":31259},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31261},{"literal_text_all_w_t_and_m_t":"LTE-CRS-PatternList-r16 ::=         SEQUENCE (SIZE (1..maxLTE-CRS-Patterns-r16)) OF RateMatchPatternLTE-CRS","paragraph_zero_based":31262},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31263},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERNLTE-CRS-STOP","paragraph_zero_based":31264},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31267},{"literal_text_all_w_t_and_m_t":"RateMatchPatternLTE-CRS field descriptions","paragraph_zero_based":31268},{"literal_text_all_w_t_and_m_t":"carrierBandwidthDL","paragraph_zero_based":31269},{"literal_text_all_w_t_and_m_t":"BW of the LTE carrier in number of PRBs (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":31270},{"literal_text_all_w_t_and_m_t":"carrierFreqDL","paragraph_zero_based":31271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["35a8b1b7b1608adb40a6603859fb0c1cb6f206c6b8349cacfb805f012790f57e","16025fc21cf0abe88529980b6e15abfd16742b06a030ccfd798b2f1d1652dd1b","554efdd876bd939f8172edfa1af8260b41d71733d48543ecef72215dc0cb09cf","f41a749fefb3651cb70365f0d1dbf484ceebecc06fcf822428b18e1c6796df21","930b3ff03762d82949d670f598e0dc24be7e1942de3031886c894f43a1c2ba10","fe346ad13eb25b92c08cc90679342eeeca8e9a49c02896999425fc436bc96bf6","a9f72fa67b69c5ecc7210a992e6d7b73d7844a07b91bbc6f9f90b65b0ae3f91e","1dc711b397890c33b9bc5026f450164b5f588b131fa2a5e61e946913886b7f4c","656f3239e8e912e6054abb7251dc205b76fc5e845f29595e26c8e3c3c4f7303f","5f09693f830716e44251b8e110d890a7f41a814052e74aba86becabbc3f06e03","c86c1755a7282f27cf927de5deffc0e0772c078b1d64afa8a6d8c819a3380d05","b2c23973d6241ed9aa09131707149d1da6c8958940adf3691d8fbe8c208ec915","fe1c421da92f8b5c83ab50fdd514cc5db93ee7c54df383a4bdc5d100ca470385","d404f6bbc60e306008c345f9d53b3d902422440940d7e13f4c3317362768f314","8776d82eb5d3b59ba0619737b22fcd01286d7b8699f019a7e91cc15c62b76506","b216cd0cdd481476d5fdfcf0b3854806fa9699ee2581319caba31567a11f1640","ebb05b3175bfd0cea8ebfe7d18b027506a669049c2723d6946f3d3af37455385","c013fa40eb45198dd619488fd077eca69ef8e01484b093502ecec3f147a7aaa7","8433ce780afbe07d48fcf61bb4cd8b6b811a8e44d68382129485c0e93c9ca7ca","9099f299fcd84677b72feaaf6b62a43f84d7884ff14ba1edf721a64a6eac6c2c","4aee751abb6655714f5a0ba6e6f2c818b0633e43b69f454c535547f7724b04f8","338fdb77f76aa53bd04336980d5b11be31958ad203388689d93d261980713db4","804300dd043397c565cc4281f7a256cb3cf7e0e5b6157e9c85894746ba60ba72","eaf8018b1fe2041c2a42aef5d6fc330798a4c57be9ff0f0e7fd06578a5693890"],"paragraph_range_zero_based":[31248,31271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p31248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Center of the LTE carrier (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":31272},{"literal_text_all_w_t_and_m_t":"mbsfn-SubframeConfigList","paragraph_zero_based":31273},{"literal_text_all_w_t_and_m_t":"LTE MBSFN subframe configuration (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":31274},{"literal_text_all_w_t_and_m_t":"nrofCRS-Ports","paragraph_zero_based":31275},{"literal_text_all_w_t_and_m_t":"Number of LTE CRS antenna port to rate-match around (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":31276},{"literal_text_all_w_t_and_m_t":"v-Shift","paragraph_zero_based":31277},{"literal_text_all_w_t_and_m_t":"Shifting value v-shift in LTE to rate match around LTE CRS (see TS 38.214 [19], clause 5.1.4.2).","paragraph_zero_based":31278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31279},{"literal_text_all_w_t_and_m_t":"–ReferenceConfiguration","paragraph_zero_based":31280},{"literal_text_all_w_t_and_m_t":"The IE ReferenceConfiguration is used provide a configuration that is common, within the same cell group, to all configured non-complete candidate configurations.","paragraph_zero_based":31281},{"literal_text_all_w_t_and_m_t":"ReferenceConfiguration information element","paragraph_zero_based":31282},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31283},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCECONFIGURATION-START","paragraph_zero_based":31284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31285},{"literal_text_all_w_t_and_m_t":"ReferenceConfiguration-r18 ::= OCTET STRING (CONTAINING RRCReconfiguration)","paragraph_zero_based":31286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31287},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCECONFIGURATION-STOP","paragraph_zero_based":31288},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31290},{"literal_text_all_w_t_and_m_t":"–ReferenceLocation","paragraph_zero_based":31291},{"literal_text_all_w_t_and_m_t":"The IE ReferenceLocation contains location information used as a reference location. The value of the field is same as Ellipsoid-Point defined in TS37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":31292},{"literal_text_all_w_t_and_m_t":"ReferenceLocation information element","paragraph_zero_based":31293},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31294},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-START","paragraph_zero_based":31295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["acd6e72c12963dbfe851cf64338b885bd237027415e1a4292cfbcef59069c6b3","3ef0c41d11966705cf3bf8feab3210be8dcd82abef348f6862150492307255d3","3318e06c22b7b2b503e332ca37ba667158bab816559bc73f5eef323ae6180128","79906870068194005ef61d5baff43510d4ccebc881885be8b7d57fd79402d2fd","e33e8e47791b8a3883cba20fa8922b7f3e703f041025d3b8e0a3c71f57905dcb","2e96462bf5c7e16df67fa56bc27b86a3b00f9cf1052c684362888db86ffcac88","02c9bc3f69f9264b94ab96390667bdb4a1681b0239aad97dbff39632414daeab","993d26acaf045a7761dfdc91159589ee1d57d9d3302f32981a2a0d137da90a23","b9365f7dd87624544a5a692cf4ac240fd84d1ffb347828c90b2d199df6ddbe89","15169879398d041460b6bb359c11675a47e4907846f11e61f55983a8c5159a43","a286e858a429ae5e193cbdf7527e7c6fa43ba8258e704f3e5ee7e5c1fd376cc1","c68aadf930b1efb7ce99af6d89ab798ac40973feb302b2d46b403df01cbd9bb4","eacc45a370ea24f20