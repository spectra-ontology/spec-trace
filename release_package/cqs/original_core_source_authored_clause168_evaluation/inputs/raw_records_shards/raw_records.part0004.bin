{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-STOP","paragraph_zero_based":35688},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35689},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35690},{"literal_text_all_w_t_and_m_t":"TAG field descriptions","paragraph_zero_based":35691},{"literal_text_all_w_t_and_m_t":"tag-Id","paragraph_zero_based":35692},{"literal_text_all_w_t_and_m_t":"Indicates the TAG of the SpCell or an SCell, see TS 38.321 [3]. Uniquely identifies the TAG within the scope of a Cell Group (i.e. MCG or SCG).","paragraph_zero_based":35693},{"literal_text_all_w_t_and_m_t":"timeAlignmentTimer","paragraph_zero_based":35694},{"literal_text_all_w_t_and_m_t":"The timeAlignmentTimer for TAG with ID tag-Id, as specified in TS 38.321 [3].","paragraph_zero_based":35695},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35696},{"literal_text_all_w_t_and_m_t":"–TAR-Config","paragraph_zero_based":35697},{"literal_text_all_w_t_and_m_t":"The IE TAR-Config is used to configure Timing Advance reporting in non-terrestrial networks and ATG network.","paragraph_zero_based":35698},{"literal_text_all_w_t_and_m_t":"TAR-Config information element","paragraph_zero_based":35699},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35700},{"literal_text_all_w_t_and_m_t":"-- TAG-TAR-CONFIG-START","paragraph_zero_based":35701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35702},{"literal_text_all_w_t_and_m_t":"TAR-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":35703},{"literal_text_all_w_t_and_m_t":"    offsetThresholdTA-r17               ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5, ms6 ,ms7, ms8, ms9, ms10, ms11, ms12,","paragraph_zero_based":35704},{"literal_text_all_w_t_and_m_t":"                               