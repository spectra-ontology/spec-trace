{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            mobilityFromNRCommand           MobilityFromNRCommand-IEs,","paragraph_zero_based":12192},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture        SEQUENCE {}","paragraph_zero_based":12193},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":12194},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12196},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-IEs ::=       SEQUENCE {","paragraph_zero_based":12197},{"literal_text_all_w_t_and_m_t":"    targetRAT-Type                      ENUMERATED { eutra, utra-fdd-v1610, spare2, spare1, ...},","paragraph_zero_based":12198},{"literal_text_all_w_t_and_m_t":"    targetRAT-MessageContainer          OCTET STRING,","paragraph_zero_based":12199},{"literal_text_all_w_t_and_m_t":"    nas-SecurityParamFromNR             OCTET STRING                                                OPTIONAL,   -- Cond HO-ToEPCUTRAN","paragraph_zero_based":12200},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                OPTIONAL,","paragraph_zero_based":12201},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                MobilityFromNRCommand-v1610-IEs                             OPTIONAL","paragraph_zero_based":12202},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12204},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-v1610-IEs ::=     SEQUENCE {","paragraph_zero_based":12205},{"literal_text_all_w_t_and_m_t":"    voiceFallbackIndication-r16             ENUMERATED {true}                                       OPTIONAL,   -- Need N","paragraph_zero_based":12206},{