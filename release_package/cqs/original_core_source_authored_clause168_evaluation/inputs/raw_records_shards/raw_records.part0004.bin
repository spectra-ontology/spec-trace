{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28104},{"literal_text_all_w_t_and_m_t":"    perHARQ-Ext-r17                     SEQUENCE (SIZE (1..maxNrofServingCells)) OF BIT STRING (SIZE (32)) OPTIONAL -- Need R","paragraph_zero_based":28105},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28106},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28108},{"literal_text_all_w_t_and_m_t":"PDSCH-HARQ-ACK-EnhType3Index-r17 ::=    INTEGER (0..maxNrofEnhType3HARQ-ACK-1-r17)","paragraph_zero_based":28109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28110},{"literal_text_all_w_t_and_m_t":"PDCCH-BlindDetection ::=                INTEGER (1..15)","paragraph_zero_based":28111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28112},{"literal_text_all_w_t_and_m_t":"DCP-Config-r16 ::=                  SEQUENCE {","paragraph_zero_based":28113},{"literal_text_all_w_t_and_m_t":"    ps-RNTI-r16                         RNTI-Value,","paragraph_zero_based":28114},{"literal_text_all_w_t_and_m_t":"    ps-Offset-r16                       INTEGER (1..120),","paragraph_zero_based":28115},{"literal_text_all_w_t_and_m_t":"    sizeDCI-2-6-r16                     INTEGER (1..maxDCI-2-6-Size-r16),","paragraph_zero_based":28116},{"literal_text_all_w_t_and_m_t":"    ps-PositionDCI-2-6-r16              INTEGER (0..maxDCI-2-6-Size-1-r16),","paragraph_zero_based":28117},{"literal_text_all_w_t_and_m_t":"    ps-WakeUp-r16                       ENUMERATED {true}                                               OPTIONAL,   -- Need S","paragraph_zero_based":28118},{"literal_text_all_w_t_and_m_t":"    ps-TransmitPeriodicL1-RSRP-r16      ENUMERATED {true}                                               OPTIONAL,   -- Need S","paragraph_z