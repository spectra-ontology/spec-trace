{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Threshold for NR SpCell RSRP measurement controlling when the UE is required to perform measurements on non-serving cells. Choice of ssb-RSRP corresponds to cell RSRP based on SS/PBCH block and choice of csi-RSRP corresponds to cell RSRP of CSI-RS. ","paragraph_zero_based":24216},{"literal_text_all_w_t_and_m_t":"measGapSharingConfig","paragraph_zero_based":24217},{"literal_text_all_w_t_and_m_t":"Specifies the measurement gap sharing scheme and controls setup/ release of measurement gap sharing.","paragraph_zero_based":24218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24219},{"literal_text_all_w_t_and_m_t":"–MeasGapConfig","paragraph_zero_based":24220},{"literal_text_all_w_t_and_m_t":"The IE MeasGapConfig specifies the measurement gap configuration and controls setup/release of measurement gaps.","paragraph_zero_based":24221},{"literal_text_all_w_t_and_m_t":"MeasGapConfig information element","paragraph_zero_based":24222},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":24223},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASGAPCONFIG-START","paragraph_zero_based":24224},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24225},{"literal_text_all_w_t_and_m_t":"MeasGapConfig ::=                   SEQUENCE {","paragraph_zero_based":24226},{"literal_text_all_w_t_and_m_t":"    gapFR2                              SetupRelease { GapConfig }                                              OPTIONAL,   -- Need M","paragraph_zero_based":24227},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":24228},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":24229},{"literal_text_all_w_t_and_m_t":"    gapFR1                              SetupRelease { GapConfig }                                              OPTIONAL,  