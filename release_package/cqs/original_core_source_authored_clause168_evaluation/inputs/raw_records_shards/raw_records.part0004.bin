{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to remove.","paragraph_zero_based":46392},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToAddModList","paragraph_zero_based":46393},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to add and/or modify.","paragraph_zero_based":46394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46395},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46396},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46397},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":46398},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":46399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46400},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigGC-BC","paragraph_zero_based":46401},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigGC-BC is used to configure DRX related parameters for NR sidelink groupcast and broadcast communication, unicast/broadcast based communication of Direct Link Establishment Request (TS 24.587 [57]), and discovery message (TS 24.554 [72]).","paragraph_zero_based":46402},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC information element","paragraph_zero_based":46403},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46404},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGGC-BC-START","paragraph_zero_based":46405},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46406},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC-r17 ::=      SEQUENCE {","paragraph_zero_based":46407},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-BC-PerQoS-List-r17    SEQUENCE (SIZE (1..maxSL-GC-BC-DRX-QoS-r17)) OF SL-DRX-GC-BC-QoS-r17        OPTIONAL,    -- Need M","paragraph_zero_based":46408},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-generic-r17           SL-DRX-GC-Generic-r17                                                       OPTIONAL,    -- Need M","paragraph_zero_based":46409},{"literal_text_all_w_t_and_m_t":"    sl-DefaultDRX-GC-BC-r17         SL-DRX-GC-BC-QoS-r17                                                        OPTIONAL,    -- Need M","paragraph_zero_based":46410},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46411},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46413},{"literal_text_all_w_t_and_m_t":"SL-DRX-GC-BC-QoS-r17 ::=            SEQUENCE {","paragraph_zero_based":46414},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-BC-MappedQoS-FlowList-r17 SEQUENCE (SIZE (1..maxNrofSL-QFIs-r16)) OF SL-QoS-Profile-r16       OPTIONAL,    -- Need M","paragraph_zero_based":46415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["182520e538077793d3c4c5ae0ce4d94dcd270fcf4a9e995e2278a982f0a8621a","e5c6e5e9f4ff4dac608318614939f6bfeaf6784c7c0e6700c84187eece4bdcd2","18eebfa7bbc4da340db13496a488283056ccadd544b2d5a9a3611fea5bd0f43c","0c07164879ee363af02b669e63caeb45964d1e57cc9f68b3888e011f9f61b68a","febd1574fc1c488fb4d0b6e0d09e9eb978e59b994613bcef3020dbd1ec60843a","227fe9d2c46b0cbdf926155abf46d1bed023f993f786970e97e43fc328a2ece0","d7126679bbcc3e291ca1830810eeb340c440602057f727b62d3c29d73d232a3c","99d5dbb6ea786070450f0863c38a01dc3349bcdf