{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42696},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Request ::=            SEQUENCE {","paragraph_zero_based":42697},{"literal_text_all_w_t_and_m_t":"    rat-Type                                RAT-Type,","paragraph_zero_based":42698},{"literal_text_all_w_t_and_m_t":"    capabilityRequestFilter                 OCTET STRING                    OPTIONAL,   -- Need N","paragraph_zero_based":42699},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":42700},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42702},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-STOP","paragraph_zero_based":42703},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42704},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42705},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Request field descriptions","paragraph_zero_based":42706},{"literal_text_all_w_t_and_m_t":"capabilityRequestFilter","paragraph_zero_based":42707},{"literal_text_all_w_t_and_m_t":"Information by which the network requests the UE to filter the UE capabilities.","paragraph_zero_based":42708},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr or eutra-nr: the encoding of the capabilityRequestFilter is defined in UE-CapabilityRequestFilterNR.","paragraph_zero_based":42709},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of the capabilityRequestFilter is defined by UECapabilityEnquiry message defined in TS36.331 [10], in which RAT-Type in UE-CapabilityRequest includes only 'eutra'.","paragraph_zero_based":42710},{"literal_text_all_w_t_and_m_t":"rat-Type","paragraph_zero_based":42711},{"literal_text_all_w_t_and_m_t":"The RAT type for which the NW requests UE capabilities.","paragraph_zero_based":42712},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42713},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRequestFilterCommon","paragraph_zero_based":42714},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRequestFilterCommon is used to request filtered UE capabilities. The filter is common for all capability containers that are requested.","paragraph_zero_based":42715},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRequestFilterCommon information element","paragraph_zero_based":42716},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42717},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYREQUESTFILTERCOMMON-START","paragraph_zero_based":42718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1d975e9298dc32662c1a7a5d2df7dd951abaab9250d4370bc0698e843b837ac2","8a1226597cbdd211f0e6cadee87146a2f9c255cd67f7d958b675d357a52f0855","6a6d353a131aaec208ddb7b4a990d1b16e427dcf1450a53201be357ab70bef1a","ff4548d124a1ac26ffbfce0b7eb93092f9885110ff70e1378c15ff259ca133a6","6d97ff0da102cc977cfc9b72529b85a889fd5b347ae92501af03e4eb0f31bb9b","820aef81469d74a0ceba7b382517a90f7fcce50aa6a2572b9c2e22161074bcbe","74e83063496af92eb4e8bf4875fb783783f7cd963a7e8a668ecfb0f520e1d339","6e01ae8b179e17f7a50a0f08c1dfafc5ab9537bb50ea623ae8a75faa72d85ec5","e0b2b31c04652f86e7b97407b7cbcfed9e1486e5c88797c36336eb4571cb87b4","80b0132f10fdbe1dbdae25578b18b1e31986dda3f528462f5cce70a693671de8","a26c807a7436d8abbe8551c5018c36e2e53ba1b1f927e55bdd45e6546c25872b","e5d6803e330bdd9008a49e7ef93b3e26fd8494a16028c65a3037f8f564cbc716","a1ce3ce647d80a4e6f9c679325bf084bc0b1a63a5