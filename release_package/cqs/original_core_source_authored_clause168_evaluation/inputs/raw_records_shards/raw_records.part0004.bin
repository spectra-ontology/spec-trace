{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–WLAN-NameList","paragraph_zero_based":44280},{"literal_text_all_w_t_and_m_t":"The IE WLAN-NameList is used to indicate the names of the WLAN AP for which the UE is configured to measure.","paragraph_zero_based":44281},{"literal_text_all_w_t_and_m_t":"WLAN-NameList information element","paragraph_zero_based":44282},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44283},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-START","paragraph_zero_based":44284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44285},{"literal_text_all_w_t_and_m_t":"WLAN-NameList-r16 ::= SEQUENCE (SIZE (1..maxWLAN-Name-r16)) OF WLAN-Name-r16","paragraph_zero_based":44286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44287},{"literal_text_all_w_t_and_m_t":"WLAN-Name-r16 ::= OCTET STRING (SIZE (1..32))","paragraph_zero_based":44288},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44289},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44290},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-STOP","paragraph_zero_based":44291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44292},{"literal_text_all_w_t_and_m_t":"WLAN-NameList field descriptions","paragraph_zero_based":44293},{"literal_text_all_w_t_and_m_t":"WLAN-Name","paragraph_zero_based":44294},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs WLAN measurements according to the names identified. For each name, it refers to Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":44295},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44296},{"literal_text_all_w_t_and_m_t":"6.3.5Sidelink information elements","paragraph_zero_based":44297},{"literal_text_all_w_t_and_m_t":"–SL-BWP-Config","paragraph_zero_based":44298},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-Config is used to configure the UE specific NR sidelink communication/discovery/positioning on one particular sidelink bandwidth part.","paragraph_zero_based":44299},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config information element","paragraph_zero_based":44300},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44301},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-START","paragraph_zero_based":44302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["57e19a0952a7498fc13d61f5555896902add037ab52f7b756e97fe4811218aab","c77ede615983d3ffe28325c39c1a7bf3550a3e472f011a930b0bcdf8182fa290","bf409180274b8f53cae4a1dd1ddbd4e2cd6a4263c0b4c5b2ad2f2a8b74a1acd3","5c87e071a55da5e5d6b51e2d5bb1cfffd14226aed53c7422811f82e20b1f9892","412070e7dc8603f54e4fd4a27c04c7fe196ef3cac760486fc0b2459e6a686629","2b68c8dd9249aa5e22a9baa2c4eb2a31e20dc6461bf5c662834b3c4a77e192dc","27df59bf5178ca42d3951666884ee2642e358163d05a101827f1eaddd32f02fa","1fa776439e851bd8f7b35483de8910ccabd771fa86ff2a5a39be1deb3b86b433","77c4f243963391c51af4d1428d2fd22c699f17983b80501f9f329ee4ff84cb07","689c0f7c222078df4e326732e18450ae8ba3a66737eede29ce4a0deb559e332a","aafbf31ba1cb9317c40c84448fd2e65a2a3a80f86ca59146c9e764bd522bd4a6","b17df3614333e5b3c3934a346abb2b42cb4ebb40d8527fd99f88787ffeb842fc","79cd6698a6c1b7d6eab7ecfc2f029cced59622869c19490b128472e965eca4ca","474d21469846dc4b56a44827b242e38c0bcbcb25a7433f5202e38b34dcdd501f","7dba2238ba66b409cf6c92ea518b802347016afa26a39d971477e889a195bf92","70b1f8c8a431d57e37c919121b91faf77eb84e78d286b7da48239c623b47f1f1","b23e66f96e5ab4125e92730097a