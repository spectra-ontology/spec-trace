{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"measResultCellListSFTD-NR","paragraph_zero_based":25080},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the NR neighbour cell(s) in NR standalone.","paragraph_zero_based":25081},{"literal_text_all_w_t_and_m_t":"measResultCLI","paragraph_zero_based":25082},{"literal_text_all_w_t_and_m_t":"CLI measurement results.","paragraph_zero_based":25083},{"literal_text_all_w_t_and_m_t":"measResultEUTRA","paragraph_zero_based":25084},{"literal_text_all_w_t_and_m_t":"Measured results of an E-UTRA cell.","paragraph_zero_based":25085},{"literal_text_all_w_t_and_m_t":"measResultForRSSI","paragraph_zero_based":25086},{"literal_text_all_w_t_and_m_t":"Includes measured RSSI result in dBm (see TS 38.215 [9]) and channelOccupancy which is the percentage of samples when the RSSI was above the configured channelOccupancyThreshold for the associated reportConfig.","paragraph_zero_based":25087},{"literal_text_all_w_t_and_m_t":"measResultListEUTRA","paragraph_zero_based":25088},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an E-UTRA measurement identity.","paragraph_zero_based":25089},{"literal_text_all_w_t_and_m_t":"measResultListNR","paragraph_zero_based":25090},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for an NR measurement identity.","paragraph_zero_based":25091},{"literal_text_all_w_t_and_m_t":"measResultListUTRA-FDD","paragraph_zero_based":25092},{"literal_text_all_w_t_and_m_t":"List of measured results for the maximum number of reported best cells for a UTRA-FDD measurement identity.","paragraph_zero_based":25093},{"literal_text_all_w_t_and_m_t":"measResultNR","paragraph_zero_based":25094},{"literal_text_all_w_t_and_m_t":"Measured results of an NR cell.","paragraph_zero_based":25095},{"literal_text_all_w_t_and_m_t":"measResultServFreqListEUTRA-SCG","paragraph_zero_based":25096},{"literal_text_all_w_t_and_m_t":"Measured results of the E-UTRA SCG serving frequencies: the measurement result of PSCell and each SCell, if any, and of the best neighbouring cell on each E-UTRA SCG serving frequency.","paragraph_zero_based":25097},{"literal_text_all_w_t_and_m_t":"measResultServFreqListNR-SCG","paragraph_zero_based":25098},{"literal_text_all_w_t_and_m_t":"Measured results of the NR SCG serving frequencies: the measurement result of PSCell and each SCell, if any, and of the best neighbouring cell on each NR SCG serving frequency.","paragraph_zero_based":25099},{"literal_text_all_w_t_and_m_t":"measResultServingMOList","paragraph_zero_based":25100},{"literal_text_all_w_t_and_m_t":"Measured results of measured cells with reference signals indicated in the serving cell measurement objects including measurement results of SpCell, configured SCell(s) and best neighbouring cell within measured cells with reference signals indicated in on each serving cell measurement object. If the sending of the MeasurementReport message is triggered by a measurement configured by the field sl-ConfigDedicatedForNR received within an E-UTRA RRCConnectionReconfiguration message (i.e. CBR measurements), this field is not applicable and its contents is ignored by the network.","paragraph_zero_based":25101},{"literal_text_all_w_t_and_m_t":"measResultSFTD-EUTRA","paragraph_zero_based":25102},{"literal_text_all_w_t_and_m_t":"SFTD measurement results between the PCell and the E-UTRA PScell in NE-DC.","paragraph_zero_based":25103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_Elemen