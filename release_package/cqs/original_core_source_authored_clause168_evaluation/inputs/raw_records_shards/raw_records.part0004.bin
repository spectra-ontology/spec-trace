ency:","paragraph_zero_based":24641},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":24642},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":24643},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":24644},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24645},{"literal_text_all_w_t_and_m_t":"RSSI-ResourceConfigCLI field descriptions","paragraph_zero_based":24646},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":24647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5780873da730e7fc0f08964e59ce5466daf08bd4e93dbcb86a56913aec0cfbcb","832050b16b693b53f0da7f676b57fbd68d5c5c901a882ba78e03270c1078bb76","0a40deae27cd11f4f977c3b860a1b03b536f3008eb699335239b6410aabc4ba7","b1eb2fab409514f437b5f9a4bca03e67ae39b32508ceda64c3bbaeeec8b98a7d","2de9687dc21cb59e2c247bf4dfe7d1edbee31214a61d055c5996e18ac4accb5c","7a5e391c76e4a0abc6fdc208cb2d014fdc0851e679f1d568c381ff6deed704c7","e7d90b42fb9cdbd120db780e5eb7e8c4a1025aa6c91774343db8a1463edb0b6b","c26dc361d9b5b3a8e2ed140588d4a4d1f84417af999768cf18852e59a4fff55d","fd98079e267c7234b537127f8d1e9c89372c15bb1e2ce91d48cf7ac4eea48abf","114e2a8d1abe7043aa30ee2a3d28327830f943e3ede42f0a9383e1ab5b6a30f0","3c31f5b4580fc2a272a29e20cb97e304ac78f118e86eaa24cee4d043d81103c3","f551ab7639cf4b41fe13f4ebf722ed07bd1b887b8266204754ce93efe38f80dd","4744863d739c65ae90f48b66c4e30a44fda93de6be95aec5350dcc1c6d1e9530","da998f1668457e3c3c25ba26a621ef948e4d7e4c0dd145eb60bda34f0bff881f","3303e23a9a56d97d4658071aa5f93fb9798cbf7e222b937ff1c2b754dcdc0b1a","3f45eed5bd2a5bdb1ca1edb1620edbe6082606093def2188f527c250f9d79b4c","355bb097977cf5c684da59aa