{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfig contains configuration for Msg1 based SI request without Msg1 repetition.","paragraph_zero_based":34152},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig information element","paragraph_zero_based":34153},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34154},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-START","paragraph_zero_based":34155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34156},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig ::=                SEQUENCE {","paragraph_zero_based":34157},{"literal_text_all_w_t_and_m_t":"    rach-OccasionsSI                    SEQUENCE {","paragraph_zero_based":34158},{"literal_text_all_w_t_and_m_t":"        rach-ConfigSI                       RACH-ConfigGeneric,","paragraph_zero_based":34159},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":34160},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL,   -- Need R","paragraph_zero_based":34161},{"literal_text_all_w_t_and_m_t":"    si-RequestPeriod                    ENUMERATED {one, two, four, six, eight, ten, twelve, sixteen}       OPTIONAL,   -- Need R","paragraph_zero_based":34162},{"literal_text_all_w_t_and_m_t":"    si-RequestResources                 SEQUENCE (SIZE (1..maxSI-Message)) OF SI-RequestResources","paragraph_zero_based":34163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34165},{"literal_text_all_w_t_and_m_t":"SI-RequestResources ::=             SEQUENCE {","paragraph_zero_based":34166},{"literal_text_all_w_t_and_m_t":"    ra-PreambleStartIndex               INTEGER (0..63),","paragraph_zero_based":34167},{"literal_text_all_w_t_and_m_t":"    ra-AssociationPeriodIndex           INTEGER (0..15)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":34168},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                     OPTIONAL    -- Need R","paragraph_zero_based":34169},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34171},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIG-STOP","paragraph_zero_based":34172},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34174},{"literal_text_all_w_t_and_m_t":"SI-RequestConfig field descriptions","paragraph_zero_based":34175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f1b8cce2462993c06c91b20ffe49052e6d5ccd2a1070764b3a2fd98c71384c8f","209d120c5c10f83447672631264db5e82bddb2ea7c3995cf70a2da99c536b338","84b8d831cca871ff251b2e451cfb5c4da450df3b1cc7f714a0503cfd90ac4e20","98779e8121c2dc69f87371ca9568e530bedc87cb8af5c1688d15ab9546818cea","c2fc1cc760de6f25485b01bac827975bf80af3c5187ddca19de75bb1894315c7","39b716ed16fe74cdcea5b3703050cdd06f91c8c4c69a683890676d1b0e9d55b4","0654b79557a1f827969e9f6d36196efd58d02a5024951ca6e96237265f58a255","5ef77add960ed2e83d2e2bdc1e2775b596f1e3263a86eda9c358be4d47dea91e","736ecbc3bad5525c062a6f54180b161de3b63dadc5cc213e814990b0be8d580f","93d5c6c10a5a06d568f03224973ca9d2a3fb6175c4fa641d60f9a5c1692a2a01","e351f449e65b68e66b88fab85ffc87479ddd9fd7d699f5796a4d47e58d6c7233","236b6d4e84708668e85b5ddc35c6f4d1158d63b8850a2815bba175dad3500fec","5b4c5be236f241c44390c2dd23d0a041c4fcbcde28b1f09590f07f063cde94d2","a3a5da2beeb572208a90812b082a28f8d610b09b46d3751ed1c369a23e56f7f6","2c02500aaf8e8c7ff8ebe3edd80834437c58cc5e1920ff49df2e6a93d3973589","83a54c144911d2698d6edfb9d20a8f64e28b2cb57cd26fb2d940951705c78b98","5a6be75d6b3fdd6bd9312900c0f2f0c7b729239438579ba9670127719e90ed97","8cfe06b130c78a99a6495da3e3ede90766c98c4127c1a72cd6f1ca9118283aa1","b845ab3f57cb25808ee117f42b97cb2c69665edcad553fe64963c8dc07b8d415","4383ad627a801729bfe894af69f7f85b9f9afa7f2cd712df8c45b9cd1d962c6f","c2c250325bd4eef881065b71c64fc5033858c1ed6979c63a5b129d59d3bb54a9","cb878e83f17ab16ef0b10fe22f626cd34d03f9c2926b8bb8b4317bd47d72c91b","7c0f7c84149b8cd4063142f82a2a6e84333efa18bcf48c5016ea147a8912ab9f","dc830270f851dff3fb8399937574576341485e466343428a358ea5bb8fc2bec0"],"paragraph_range_zero_based":[34152,34175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34152"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rach-OccasionsSI","paragraph_zero_based":34176},{"literal_text_all_w_t_and_m_t":"Configuration of dedicated RACH Occasions for SI. If the field is absent, the UE uses the corresponding parameters configured in rach-ConfigCommon of the initial uplink BWP.","paragraph_zero_based":34177},{"literal_text_all_w_t_and_m_t":"si-RequestPeriod","paragraph_zero_based":34178},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-Request configuration in number of association periods.","paragraph_zero_based":34179},{"literal_text_all_w_t_and_m_t":"si-RequestResources","paragraph_zero_based":34180},{"literal_text_all_w_t_and_m_t":"If there is only one entry in the list, the configuration is used for all SI messages for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting. Otherwise:","paragraph_zero_based":34181},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is not present and the SI-RequestConfig is used for on-demand SI request in SI-SchedulingInfo or PosSI-SchedulingInfo, the 1st entry in the list corresponds to the first SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message in schedulingInfoList or posSchedulingInfoList for which si-BroadcastStatus or posSI-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34182},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in SI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by schedulingInfoList in si-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34183},{"literal_text_all_w_t_and_m_t":"-If si-SchedulingInfo-v1700 is present and SI-RequestConfig is configured in PosSI-SchedulingInfo for on-demand SI request, the UE generates a list of concatenated SI messages by appending the SI messages containing type2 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 to the SI messages configured by posSchedulingInfoList in posSI-SchedulingInfo. The 1st entry in the list corresponds to the first SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting, 2nd entry in the list corresponds to the second SI message for which posSI-BroadcastStatus or si-BroadcastStatus is set to notBroadcasting and so on.","paragraph_zero_based":34184},{"literal_text_all_w_t_and_m_t":"Change of si-RequestResources should not result in system information change notification.","paragraph_zero_based":34185},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34186},{"literal_text_all_w_t_and_m_t":"SI-RequestResources field descriptions","paragraph_zero_based":34187},{"literal_text_all_w_t_and_m_t":"ra-AssociationPeriodIndex","paragraph_zero_based":34188},{"literal_text_all_w_t_and_m_t":"Index of the association period in the si-RequestPeriod in which the UE can send the SI request for SI message(s) corresponding to this SI-RequestResources, using the preambles indicated by ra-PreambleStartIndex and rach occasions indicated by ra-ssb-OccasionMaskIndex.","paragraph_zero_based":34189},{"literal_text_all_w_t_and_m_t":"ra-PreambleStartIndex","paragraph_zero_based":34190},{"literal_text_all_w_t_and_m_t":"If N SSBs are associated with a RACH occasion, where N > = 1, for the i-th SSB (i=0, …, N-1) the preamble with preamble index = ra-PreambleStartIndex + i is used for SI request; For N < 1, the preamble with preamble index = ra-PreambleStartIndex is used for SI request.","paragraph_zero_based":34191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34192},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfigRepetition","paragraph_zero_based":34193},{"literal_text_all_w_t_and_m_t":"The IE SI-RequestConfigRepetition contains configuration for Msg1 based SI request with Msg1 repetition.","paragraph_zero_based":34194},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition information element","paragraph_zero_based":34195},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34196},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-REQUESTCONFIGREPETITION-START","paragraph_zero_based":34197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34198},{"literal_text_all_w_t_and_m_t":"SI-RequestConfigRepetition-r18 ::=     SEQUENCE {","paragraph_zero_based":34199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["401c11b6743ccf4b5486ad4db3d2abc100c486476e02c59c7e11ad5bc44018e8","9231bb0192f740d95c0907b3b747e10c443a49649a6787bd41139b68d3d89754","fd6702713016fb0d0e3e90a94e515fc833a1e7d36eb39cb08ac5cee1081ea105","3c6e9a2e0bd98409c96db0071a4048b8091c16f02f8d542eb5332e2122f91119","acc840f2b18c255d1ac1335ae997aae6e3ab603c31829c44af55e95aeacee464","4f2b100fdd407d17a35c91e759ec6245dd3ee71932af0118be19523d16299858","06494b07ca4bfd5b9a38264d35f330a8847d3d0c3a44ac5e74b896da9952d04b","fb5c417e4ad31daccf04dde5136722d160609cf3551340c4a9001d4f48abd012","bba79a76b0445a404e52a3210961d02075bb42f3ff45b251a2032f8cf3d93d3e","ea428aaddf0f4b7e441a18bd1c969e8c631f080b01c806663