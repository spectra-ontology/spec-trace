{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList information element","paragraph_zero_based":46008},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46009},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-START","paragraph_zero_based":46010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46011},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList-r16 ::=     SEQUENCE {","paragraph_zero_based":46012},{"literal_text_all_w_t_and_m_t":"    sl-CBR-RangeConfigList-r16            SEQUENCE (SIZE (1..maxCBR-Config-r16)) OF SL-CBR-LevelsConfig-r16     OPTIONAL,   -- Need M","paragraph_zero_based":46013},{"literal_text_all_w_t_and_m_t":"    sl-CBR-PSSCH-TxConfigList-r16         SEQUENCE (SIZE (1.. maxTxConfig-r16)) OF SL-CBR-PSSCH-TxConfig-r16    OPTIONAL    -- Need M","paragraph_zero_based":46014},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46015},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46016},{"literal_text_all_w_t_and_m_t":"SL-CBR-LevelsConfig-r16 ::=           SEQUENCE (SIZE (1..maxCBR-Level-r16)) OF SL-CBR-r16","paragraph_zero_based":46017},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46018},{"literal_text_all_w_t_and_m_t":"SL-CBR-PSSCH-TxConfig-r16 ::=         SEQUENCE {","paragraph_zero_based":46019},{"literal_text_all_w_t_and_m_t":"    sl-CR-Limit-r16                       INTEGER(0..10000)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":46020},{"literal_text_all_w_t_and_m_t":"    sl-TxParameters-r16                   SL-PSSCH-TxParameters-r16                                             OPTIONAL    -- Need M","paragraph_zero_based":46021},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46022},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46023},{"literal_text_all_w_t_and_m_t":"SL-CBR-r16 ::=                        INTEGER (0..100)","paragraph_zero_based":46024},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46025},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-STOP","paragraph_zero_based":46026},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46027},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46028},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList field descriptions","paragraph_zero_based":46029},{"literal_text_all_w_t_and_m_t":"sl-CBR-RangeConfigList","paragraph_zero_based":46030},{"literal_text_all_w_t_and_m_t":"Each entry in sl-CBR-RangeConfigList is SL-CBR-LevelsConfig containing the list of CBR ranges. The values within each SL-CBR-LevelsConfig indicate the upper bound of the each CBR range (and implicitly indicate the lower bound of next CBR range) and are configured in ascending order. For the first CBR range of each SL-CBR-LevelsConfig, the lower bound of the CBR range is 0. Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":46031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ea41b69f0d5ac577733eb1b83f0a7171d5acf233dd0986a56d0412ce90c759d6","0b1e243326efbdd9eac6e623edd6997ad7b77ff9cea901029c05c45b30bf5081","0d365fee0243a30342384ef38ec2ebac7084771cac1b39d1ef4e9a09db41e9d1","3b2262ceaa5704f10dfda22e5b22b38386b470d5abaed6f6225cd80fa9a94407","3618bcf83079b2100c043e2d8013de4492d18a7fb05116c48e492cd44823eb49","635af544268b86102f7fcaa0ac35f873833fd573ee76660f476117882158d57e","45542a850040924dfc3bfceda2f44d8ab2194f7b14eb1f9119d4c40f91e46c27","1780fa27949663