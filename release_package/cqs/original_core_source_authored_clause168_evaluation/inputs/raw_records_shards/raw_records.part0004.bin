{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44856},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44858},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MBSFN-SUBFRAMECONFIGLIST-STOP","paragraph_zero_based":44859},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44861},{"literal_text_all_w_t_and_m_t":"EUTRA-MBSFN-SubframeConfig field descriptions","paragraph_zero_based":44862},{"literal_text_all_w_t_and_m_t":"radioframeAllocationOffset","paragraph_zero_based":44863},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10].","paragraph_zero_based":44864},{"literal_text_all_w_t_and_m_t":"radioframeAllocationPeriod","paragraph_zero_based":44865},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where SFN refers to the SFN of the NR serving cell.","paragraph_zero_based":44866},{"literal_text_all_w_t_and_m_t":"subframeAllocation1","paragraph_zero_based":44867},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":44868},{"literal_text_all_w_t_and_m_t":"subframeAllocation2","paragraph_zero_based":44869},{"literal_text_all_w_t_and_m_t":"Field as defined in MBSFN-SubframeConfig-v1430 in TS 36.331 [10], where the UE assumes the duplex mode (FDD or TDD) of the NR cell for which the E-UTRA-MBSFN-SubframeConfig is provided.","paragraph_zero_based":44870},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44871},{"literal_text_all_w_t_and_m_t":"–EUTRA-MultiBandInfoList","paragraph_zero_based":44872},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-MultiBandInfoList indicates the list of frequency bands in addition to the band represented by CarrierFreq for which cell reselection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":44873},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList information element","paragraph_zero_based":44874},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44875},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-MULTIBANDINFOLIST-START","paragraph_zero_based":44876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44877},{"literal_text_all_w_t_and_m_t":"EUTRA-MultiBandInfoList ::=     SEQUENCE (SIZE (1..maxMultiBands)) OF EUTRA-MultiBandInfo","paragraph_zero_based":44878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5ecc9f02f462fea4373c2239aef020ee4935b24be29e76fb7d227ea3bf80e6d8","cc472eb0ba412cfab294f955bb6c7dbf08a6bf4f6f61a46f43f2cf11ef4bb63b","04e949e4983a4c0deecc2235b5a4e1e0aa7e6be8d2938dacc589303ecd97ce36","3268690927e6a44ed2a37c73def9cb1e38753173de511e364a9bac7dda498c54","f7702cb3aedc1e3df5829f37806e819d3b11dda06f00650e77fa50e1875e59a5","8c56a062ca2c9866d0efa04a157060e17727cd7527b4bc9764664cd457ed287b","fe5b85514735293b05fc7f071c1cbab4fa7eefe6438934131528ead87de5768f","52cbd2062b96966b7d54ea4e231f29d60bf751913ccae42975a968b5eaee7357","5b6f95da120b45696d4bec3e87bffd82ce271eec5ccd2aedc740efd9131aad76","85dc1f336f1e3e4f13fd6275e04ea8984b2f17cae26139b59770a5163a4aea71","3ce523929efc1a033c8b25326b15e8119b1614858fd0ac264d39c9df7e1d6d6b","5116b11341