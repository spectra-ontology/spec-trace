{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46897},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LBT-FAILURERECOVERYCONFIG-STOP","paragraph_zero_based":46898},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46899},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46900},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig field descriptions","paragraph_zero_based":46901},{"literal_text_all_w_t_and_m_t":"sl-lbt-FailureDetectionTimer","paragraph_zero_based":46902},{"literal_text_all_w_t_and_m_t":"Timer for consistent sidelink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":46903},{"literal_text_all_w_t_and_m_t":"sl-lbt-FailureInstanceMaxCount","paragraph_zero_based":46904},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers sidelink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":46905},{"literal_text_all_w_t_and_m_t":"sl-lbt-RecoveryTimer","paragraph_zero_based":46906},{"literal_text_all_w_t_and_m_t":"Timer for consistent sidelink LBT failure cancellation (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":46907},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46908},{"literal_text_all_w_t_and_m_t":"–SL-LogicalChannelConfig","paragraph_zero_based":46909},{"literal_text_all_w_t_and_m_t":"The IE SL-LogicalChannelConfig is used to configure the sidelink logical channel parameters.","paragraph_zero_based":46910},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig information element","paragraph_zero_based":46911},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46912},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-START","paragraph_zero_based":46913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46914},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig-r16 ::=            SEQUENCE {","paragraph_zero_based":46915},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":46916},{"literal_text_all_w_t_and_m_t":"    sl-PrioritisedBitRate-r16                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":46917},{"literal_text_all_w_t_and_m_t":"                                               kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":46918},{"literal_text_all_w_t_and_m_t":"    sl-BucketSizeDuration-r16                  ENUMERATED {ms5, ms10, ms20, ms50, ms100, ms150, ms300, ms500, ms1000,","paragraph_zero_based":46919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["55d8b660ec2ac895a4ef37b135d9b5ef326aa7733fbd145f0e250cb087fff8d8","cb3d450937c7658556b84cb533bab4a61ec2aa1b119480cd5b839fb827881d1c","3235d2c12de16364996b341f834fdae916977871ff05c743cb97f405804a77ed","d1b71ecb2e80b2f53f1f8554575b4ff889d8160af18d810cdda75e2ca1dc11bc","2530e5040e3bc66e769443910cc4afdc846a11acf0065718ef5971221a5be5f6","963d12135200d4f1db6f40ca943b44490e3a1ed3720741a5993a9c5219e6a0b7","633dee8fa57a2c2e197006012b82f8156708bfbe8f28e28f0da637bc8dbca634","ad11be27a0e847f0f7e97b2e48e5ac57ad290fddeb8172b