{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":54072},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":54073},{"literal_text_all_w_t_and_m_t":"    -- Parallel list","paragraph_zero_based":54074},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListExt-vNxy     SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementExt-vNxy     OPTIONAL     -- Need N","paragraph_zero_based":54075},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":54076},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":54077},{"literal_text_all_w_t_and_m_t":"-- Second parallel list from a later spec version","paragraph_zero_based":54078},{"literal_text_all_w_t_and_m_t":"listElementToAddModListExt-vNwzSEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementExt-vNwz     OPTIONAL    -- Need N","paragraph_zero_based":54079},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":54080},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54082},{"literal_text_all_w_t_and_m_t":"ListElement ::=                      SEQUENCE {","paragraph_zero_based":54083},{"literal_text_all_w_t_and_m_t":"    elementId                            ListElementId,","paragraph_zero_based":54084},{"literal_text_all_w_t_and_m_t":"    field1                               INTEGER (0..3),","paragraph_zero_based":54085},{"literal_text_all_w_t_and_m_t":"    field2                               ENUMERATED { value1, value2, value3 }","paragraph_zero_based":54086},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54088},{"literal_text_all_w_t_and_m_t":"ListElementExt-vNxy ::=              SEQUENCE {","paragraph_zero_based":54089},{"literal_text_all_w_t_and_m_t":"    field3-rN                            BIT STRING (SIZE (8))                                              OPTIONAL     -- Need R","paragraph_zero_based":54090},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54092},{"literal_text_all_w_t_and_m_t":"ListElementExt-vNwz ::=              SEQUENCE {","paragraph_zero_based":54093},{"literal_text_all_w_t_and_m_t":"    field4-rN                            INTEGER (0..255)                                                   OPTIONAL     -- Need R","paragraph_zero_based":54094},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a5a04c2037b40a83a1e4035eaf51340880ee786dcd13f7e797ecd6a16cbd9494","ff854ac1975de8da1a1a4fb35386d5c2c5d19202fa4341f73e24e90412e6bedc","a0a5c814b62b9f2bb73e428b805ac34438dd8481c8fb2a9fee92797d5106dc95","f365059dc6d343dae052c2f94df05e61187002cbf3d5275b4182dc3688b8bd1e","e83808a53689913f88560dce39d515ab5e2172ec56578035a609c0d3b14df13c","733e43766de63e974afcb3b08d5a2514be0e04e6849c8b6b41aa08bd31a96a32","41560f005463ab39bfc93a8fddb5843ef6993f37a54db2978236cc8436e66e9e","fa538c2ceaedbc94da74abf61b09c415d90409fff3e989362f100f2e0eb8b132","af69beaa778a48cf606d48c2f3433e62da11cf187bbb0fcc183b5cb470f0fc42","956531fc4a013137112cbfe2462cfccebc2ff915b02f44d4af5a4a14b45484d1","3e1dc75808c94f3e129f30a8bce435520a8775bdb897e01632a326fc11368310","05ed60ab1857072cda4b8f66a12ec6d911b048b00de74032cd8a7e4940f3e008","4d715e19a5115757a307ec24a7a8150a1ae1e18326c87acc35477121683cbb82","8d5a5cd9eb62d64b36010d5fa58e63faf7d4da66ba6424331178743e71ec310c","a553afe21b9a2213f834c6fbf219c644a16f2c0e86d8e42baef25028080e781d","b4fab4ba2b07649a5c9af8167c66a798b164bb19a8701e62901d14f7854b607a","8ebdc02a48b1820164ac53597104a39c4f314026b7c37f848d0f17616b4a0f37","1e1caccc7a9302ce3cf6b0c564f6d8f906745cd40c34f34e1769857d28e8b2e9","f808b44e022a25316c7e0e4a3c48b8bc9a0ec1ecfa66e7f856f7322a2e92f8fc","af988300b9aa21cbd2bae152a9f342535fbecbceb1891bc35fddfcfe1d31376b","f8319892bd2e3ebaa5f4a9f4f0e5bea810f7d65d8439e40b03bd08297a482c24","7bce8e691a8731bddb1c8a4ea4e9da3a73907d7a87e561314b0814a0fdd7edd3","6a27b7094e671ba95995d1cd5aea6116d11ee81f29f61b0c086a5b08307055e3","beaa1d7d8d4cf63b8f2dc419e6e24cdbab5eced9d2da4864286d89be9c208da8"],"paragraph_range_zero_based":[54072,54095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54072"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":54096},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54097},{"literal_text_all_w_t_and_m_t":"–When the size of a list is extended and fields are added to the list element structure, an extension marker should normally be used for the added fields if available, and the list extended with the non-critical mechanism as described in example 1 above. Note that if the list element ID type changes in this case, the new ID can be added after the extension marker, and the entries of the size-extended ToRelease list should have the type of the new ID (e.g. ListElementId-vNxy). If no extension marker is available or if overhead or other considerations prevent using the extension marker, an extension structure should be created for the new fields and a parallel list with ToAddMod introduced to hold the extension structures, as in the second example above, for entries of the original list and for entries of the extension list holding new entries. The field description table should indicate that the parallel list contains the same number of entries, and in the same order, as the concatenation of the original list and the extension list. An extended ToRelease list is needed, but no additional parallel ToRelease list is needed (i.e. there is no listElementToReleaseListExt-vNxy in the example below), as the original and extended ToRelease lists suffice to release any element of the combined list. The extended element ID type should be captured as a non-critical extension of the original element ID type, with the field description indicating that if the extended ID is present, the original ID is ignored. The result is as shown in the following example:","paragraph_zero_based":54098},{"literal_text_all_w_t_and_m_t":"-- /example 3/ ASN1START","paragraph_zero_based":54099},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54100},{"literal_text_all_w_t_and_m_t":"ContainingStructure ::=             SEQUENCE {","paragraph_zero_based":54101},{"literal_text_all_w_t_and_m_t":"    listElementToAddModList               SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElement                 OPTIONAL,    -- Need N","paragraph_zero_based":54102},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseList              SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementId               OPTIONAL,    -- Need N","paragraph_zero_based":54103},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":54104},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":54105},{"literal_text_all_w_t_and_m_t":"    -- Non-critical extension lists","paragraph_zero_based":54106},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListSizeExt-vNxy  SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElement           OPTIONAL,    -- Need N","paragraph_zero_based":54107},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseListSizeExt-vNxy SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElementId-vNxy    OPTIONAL,    -- Need N","paragraph_zero_based":54108},{"literal_text_all_w_t_and_m_t":"    -- Parallel list with maxNrofListElements-rN = maxNrofListElements + maxNrofListElementsDiff-rN","paragraph_zero_based":54109},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListExt-vNxy      SEQUENCE (SIZE (1..maxNrofListElements-rN)) OF ListElementExt-vNxy       OPTIONAL     -- Need N","paragraph_zero_based":54110},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":54111},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54113},{"literal_text_all_w_t_and_m_t":"ListElement ::=                      SEQUENCE {","paragraph_zero_based":54114},{"literal_text_all_w_t_and_m_t":"    elementId                            ListElementId,","paragraph_zero_based":54115},{"literal_text_all_w_t_and_m_t":"    field1                               INTEGER (0..3),","paragraph_zero_based":54116},{"literal_text_all_w_t_and_m_t":"    field2                               ENUMERATED { value1, value2, value3 }","paragraph_zero_based":54117},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54118},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c42bc4c8f2e7d844acb0805f7c4e1b181fffd4fecebfec525744e9c9490338df","ab842d0524c51ea050bd05faa49885d13fa46d35161d0fea23fa7aa5009d9ddb","a0e7f3fc03ee54fabf1ef6205b998e6fd6c0b4f602c1a480b4f96730e75f52ba","627feca35af15ff8602d9eafa40c076859a2faee475157b132822ffc09eac4d2","1a28019cd4c867be3941696d1c9e06b5b8583ffa08575c760cae69c675e7acc7","f8a4b5ac071477af8678d72f06729e82552bf1ff2b4245d37bc51f5ede14fce1","04882bec1afec39bed7c7341d505bcf5655bebfd1f61446b49d68318434b66d8","72ed5d9b909b19193e59b62a8849a9ff9f1a93c93af3d140d2e7ef7f84e39fcb","e1a6433377b54db9239ab79a343ddc41cdc193872cae268812d7faff1e55abdd","1f72e4802cebfa420b2cef84b91fb90ea867ad7ca579ef9dc55bb2453f732709","e3b7956b9fac374032c26257eaee8a274a45f78fcff2b9d287e6298a98ceb73b","c8d1d60d6262ef9331887c0b33ab6cf1d1fbe113fb4ada296ba58e648d2cc279","1262102b80e8f754b3b92c001ae674888377ce47ad3368c61b4dcc7f21ccf527","0a44341358b6be5b3293b6113a7285a4c742a943f94f8fdc9c959fc31ce6e02f","123e5726b5471e3d2e798ef18b28c55c88496a39c974a18e1e1240f6e352f2e8","584844c6444bf61133f32f6504e14082b56983637a1f509213a26a460e5797d4","d395eb035b3c790dacfb9b3bfb351258846013f5139ca0fdec1e51cde2d86d11","1c013d28c610f68349f860964adbd9c2d5fc3d8c0fba4bb10de12d8c88effa5c","0ac2e96b69d8102bd21c379c954f1b9d75f30e15be1ab7763d98c2c717ae196c","4b1d01cd970c62e4e78b9d69eb5e1c99425d10f59b32bc2e0b541474655f3b1e","6210758cc9a57c63b3d6ceca90a4fade039bbf33eca1cad0182b03312afd80a4","0a618ce7ea90f25cc4bc634239cde8a7e6430fb9078d26fddf768e7b02f81af3","29a2c67d303d242580aa79ffb97261ee405e6353eb5c83afed4a80b1a8f1f754","276ace184070c099feabf7f79e4a64ba1c9c2237fbacbb3e36f10a0c2b87d571"],"paragraph_range_zero_based":[54096,54119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54096"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ListElementExt-vNxy ::=              SEQUENCE {","paragraph_zero_based":54120},{"literal_text_all_w_t_and_m_t":"    -- Field description should indicate that if the elementId-vNxy is present, the elementId (without suffix) is ignored","paragraph_zero_based":54121},{"literal_text_all_w_t_and_m_t":"    elementId-vNxy                       ListElementId-vNxy                                                 OPTIONAL,    -- Need S","paragraph_zero_based":54122},{"literal_text_all_w_t_and_m_t":"    field3-rN                            BIT STRING (SIZE (8))                                              OPTIONAL     -- Need R","paragraph_zero_based":54123},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54125},{"literal_text_all_w_t_and_m_t":"ListElementId ::= INTEGER (0..maxNrofListElements-1)","paragraph_zero_based":54126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54127},{"literal_text_all_w_t_and_m_t":"ListElementId-vNxy ::= INTEGER (maxNrofListElements..maxNrofListElements-1-rN)","paragraph_zero_based":54128},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":54129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54130},{"literal_text_all_w_t_and_m_t":"–When different extensions are made to a list in separate releases, the extension mechanisms described above may interact. In case fields are added in Rel-M (listElementToAddModListExt-vMxy) and later the list size is extended in Rel-N (listElementToAddModListSizeExt-vNwz), the size-extended list in Rel-N should be a single list extending the combination of listElementToAddModList and listElementToAddModListExt-vMxy. This requires creating a new type (ListElement-rN) to contain the combined fields of ListElement and ListElementExt-vMxy. A corresponding ToRelease list is needed. The result is as shown in the following example:","paragraph_zero_based":54131},{"literal_text_all_w_t_and_m_t":"-- /example 4/ ASN1START","paragraph_zero_based":54132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54133},{"literal_text_all_w_t_and_m_t":"ContainingStructure ::=             SEQUENCE {","paragraph_zero_based":54134},{"literal_text_all_w_t_and_m_t":"    listElementToAddModList              SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElement             OPTIONAL,    -- Need N","paragraph_zero_based":54135},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseList             SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementId           OPTIONAL,    -- Need N","paragraph_zero_based":54136},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":54137},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":54138},{"literal_text_all_w_t_and_m_t":"    -- Parallel list (Rel-M)","paragraph_zero_based":54139},{"literal_text_all_w_t_and_m_t":"    listElementToAddModListExt-vMxy      SEQUENCE (SIZE (1..maxNrofListElements)) OF ListElementExt-vMxy     OPTIONAL     -- Need N","paragraph_zero_based":54140},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":54141},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":54142},{"literal_text_all_w_t_and_m_t":"-- Size-extended list (Rel-N) with maxNrofListElements-rN = maxNrofListElements + maxNrofListElementsDiff-rN","paragraph_zero_based":54143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5e5b5484e902176bc7d73d4341555dd6e889deec29d15131884d4dffcc4fc830","5b0a6ff496df7a15713f3d65a7873ccb4b09396c4f3