{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The index of reference SSB with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":17568},{"literal_text_all_w_t_and_m_t":"startingRB","paragraph_zero_based":17569},{"literal_text_all_w_t_and_m_t":"The PRB index where corresponding TRS resource starts in relation to common resource block #0 (CRB#0) on the common resource block grid.","paragraph_zero_based":17570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17571},{"literal_text_all_w_t_and_m_t":"–SIB18","paragraph_zero_based":17572},{"literal_text_all_w_t_and_m_t":"SIB18 contains Group IDs for Network selection (GINs) to support access using credentials from a Credentials Holder or to support UE onboarding.","paragraph_zero_based":17573},{"literal_text_all_w_t_and_m_t":"SIB18 information element","paragraph_zero_based":17574},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17575},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB18-START","paragraph_zero_based":17576},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17577},{"literal_text_all_w_t_and_m_t":"SIB18-r17 ::=               SEQUENCE {","paragraph_zero_based":17578},{"literal_text_all_w_t_and_m_t":"    gin-ElementList-r17         SEQUENCE (SIZE (1..maxGIN-r17)) OF GIN-Element-r17            OPTIONAL,   -- Need R","paragraph_zero_based":17579},{"literal_text_all_w_t_and_m_t":"    gins-PerSNPN-List-r17       SEQUENCE (SIZE (1..maxNPN-r16)) OF GINs-PerSNPN-r17           OPTIONAL,   -- Need S","paragraph_zero_based":17580},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                                  OPTIONAL,","paragraph_zero_based":17581},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":1758