{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26736},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSet","paragraph_zero_based":26737},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSet is a set of Non-Zero-Power (NZP) CSI-RS resources (their IDs) and set-specific parameters.","paragraph_zero_based":26738},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet information element","paragraph_zero_based":26739},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26740},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-START","paragraph_zero_based":26741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26742},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet ::=          SEQUENCE {","paragraph_zero_based":26743},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-ResourceSetId               NZP-CSI-RS-ResourceSetId,","paragraph_zero_based":26744},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-Resources                SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourcesPerSet)) OF NZP-CSI-RS-ResourceId,","paragraph_zero_based":26745},{"literal_text_all_w_t_and_m_t":"    repetition                          ENUMERATED { on, off }                                                  OPTIONAL,   -- Need S","paragraph_zero_based":26746},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset           INTEGER(0..6)                                                           OPTIONAL,   -- Need S","paragraph_zero_based":26747},{"literal_text_all_w_t_and_m_t":"    trs-Info                            ENUMERATED {true}                                                       OPTIONAL,   -- Need R","paragraph_zero_based":26748},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":26749},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26750},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r16       INTEGER(0..31)                                                          OPTIONAL   -- Need S","paragraph_zero_based":26751},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":26752},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26753},{"literal_text_all_w_t_and_m_t":"    pdc-Info-r17                        ENUMERATED {true}                                                       OPTIONAL,  -- Need R","paragraph_zero_based":26754},{"literal_text_all_w_t_and_m_t":"    cmrGroupingAndPairing-r17           CMRGroupingAndPairing-r17                                               OPTIONAL,  -- Need R","paragraph_zero_based":26755},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r17       INTEGER (0..124)                                                        OPTIONAL,  -- Need S","paragraph_zero_based":26756},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffsetL2-r17     INTEGER(0..31)                                                          OPTIONAL   -- Need R","paragraph_zero_based":26757},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":26758},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["803baf020a3568e5de8ae26d5deb49385178bca700a9c5e6724f1a3e4e0dd9b9","cfb3240134b996f12e2de4d7be3b8fe73fa99d68b66841729dbf6bcddb2b6995","bde2b971f57dbbc2724162ad2008c3189a2e5f1e3e51ea3baf4979d008231edb","691217724860f9a554c0bac8291274e41f9f56edbd03757a6e44747a169091fe","f632d57ba45a363b2bc4d9b250e72984a030d54ff23fb8a0f7dda9cee036b69f","c1cbe423ea697ddbb46bd4db86aae3378d4dfe