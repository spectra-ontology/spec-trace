{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1-2: 1 TD CQI, ref = 1st and last slots, and 1st and last W2","paragraph_zero_based":20352},{"literal_text_all_w_t_and_m_t":"2: 2 TC CQIs","paragraph_zero_based":20353},{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":20354},{"literal_text_all_w_t_and_m_t":"unitDurationDD","paragraph_zero_based":20355},{"literal_text_all_w_t_and_m_t":"DD/TD unit duration (in slots), for AP-CSI-RS only. Note: For P/SP-CSI-RS, d is set to CSI-RS periodicity (see TS 38.214 [19], clause 5.2.1.4). If the value of aperiodicResourceOffset is '1', network configures value 'm1' for this field.","paragraph_zero_based":20356},{"literal_text_all_w_t_and_m_t":"vectorLengthDD","paragraph_zero_based":20357},{"literal_text_all_w_t_and_m_t":"Doppler-/time-domain (DD/TD) basis vector length; See TS 38.214 [19], clause 5.2.1.4.","paragraph_zero_based":20358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20359},{"literal_text_all_w_t_and_m_t":"–CommonLocationInfo","paragraph_zero_based":20360},{"literal_text_all_w_t_and_m_t":"The IE CommonLocationInfo is used to transfer detailed location information available at the UE to correlate measurements and UE position information.","paragraph_zero_based":20361},{"literal_text_all_w_t_and_m_t":"CommonLocationInfo information element","paragraph_zero_based":20362},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20363},{"literal_text_all_w_t_and_m_t":"-- TAG-COMMONLOCATIONINFO-START","paragraph_zero_based":20364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20365},{"literal_text_all_w_t_and_m_t":"CommonLocationInfo-r16 ::= SEQUENCE {","paragraph_zero_based":20366},{"literal_text_all_w_t_and_m_t":"    gnss-TOD-msec-r16          OCTET STRING     OPTIONAL,","paragraph_z