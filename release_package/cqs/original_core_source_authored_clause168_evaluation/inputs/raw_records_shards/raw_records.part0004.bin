based":53300},{"literal_text_all_w_t_and_m_t":"UECapabilityEnquiry","paragraph_zero_based":53301},{"literal_text_all_w_t_and_m_t":"ULDedicatedMessageSegment","paragraph_zero_based":53302},{"literal_text_all_w_t_and_m_t":"80","paragraph_zero_based":53303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7494f5ad5fd2ae756b33475acddffc24310deae21f377ffc136fbcd593d2457a","783ae66a069f699d1bbdcbbe94609c57ddc459e7ed42b1b339163bd82bb24f5d","ab8f8bed97dac9217313e465a49a84276092ff41db336e7b2e9fde6f70f7d4be","b5ef0bf4f983fe49d75523ce38b8eb1f58837832cdaa51e0c00f6a122b295979","b1a7b1a4618abbb9c2dc2b5b478c2f5086738ca221b093bc3c3c3cc7a8ccb31b","5f73e1ed333af9b9e5ac6fb7aa9ffc0defabb357ddcd0fc558e706dc5d539e75","ef85ad6dc833c82306074b1a6c1a921566a85d7a98f3df726000105ff50e892a","7e65c8fa85d5d7cebdfaccce0df32a1ee328dcf39862c3385e0757da5ae86976","4a085c9eaf3c0de599fe7479c5c2a6d2b3f44d8fe9dde13f1586a4e9af5f08c9","8d5df21c031fd47c0771b6d20258336f2f9bb0d5767dae7ee2433a9bc7eb4bdd","c94ad5529c904f6eb7c758bab3deaf689d99b19d9115e300f4fb4abb3f371a35","d05309de6551ba58d474cc4b90eb7be893a3a139c57eef51a6467f7002823368","69782e2a7b930a69648b8aa76c63e5e071b07b9323e766da58661712ec7ee204","501e7c6d466ea6c7308570afe07d00c5289b79ac7070c08865bb430ce072ba25","74e6b4f955d746b62f7c36f09e6599d756904ab8963020166aaeaa7d8eba9a9c","152f4b8ad14823684466536ad04aec895ffa3d8d19cfd86549d243a9ed8f392a","c41f7d1cc8465be4061d93fed65b934c2b2cb203c06d429aef273bdbc3ea4216","abf421da6a2f918bdc75ef966ae0a5839b289558f93d258b8d62b6731b29d911","663946ca11083bdff5f0be97b3d754509d0d5ae8fc3f918f7ca1039e7c710084","adc63139052a2df1f1c51f43d53f13d27829e64a10eef0642710a87ffa6f8cc6","83b889ebc8a231e21c28de4aebb5250ee47cf9ac00bc166abdb