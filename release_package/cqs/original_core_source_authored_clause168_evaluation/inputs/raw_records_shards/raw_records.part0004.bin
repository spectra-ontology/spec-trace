{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CandPSCellExecutionConditionInfo-r18 ::= SEQUENCE {","paragraph_zero_based":51840},{"literal_text_all_w_t_and_m_t":"    candPSCellExecCondReportConfigNR-r18     ReportConfigNR,","paragraph_zero_based":51841},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":51842},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":51843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51844},{"literal_text_all_w_t_and_m_t":"-- TAG-HANDOVER-COMMAND-STOP","paragraph_zero_based":51845},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":51846},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51847},{"literal_text_all_w_t_and_m_t":"HandoverCommand field descriptions","paragraph_zero_based":51848},{"literal_text_all_w_t_and_m_t":"candPSCellExecCondReportConfigNR","paragraph_zero_based":51849},{"literal_text_all_w_t_and_m_t":"Contains execution condition parameters of candidate PSCells in case of CHO with candidate SCG(s). This fields can include only a4-Threshold, hysteresis, timeToTrigger, and rsType.","paragraph_zero_based":51850},{"literal_text_all_w_t_and_m_t":"handoverCommandMessage","paragraph_zero_based":51851},{"literal_text_all_w_t_and_m_t":"Contains the RRCReconfiguration message used to perform handover within NR or handover to NR, as generated (entirely) by the target gNB.","paragraph_zero_based":51852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51853},{"literal_text_all_w_t_and_m_t":"–HandoverPreparationInformation","paragraph_zero_based":51854},{"literal_text_all_w_t_and_m_t":"This message is used to transfer the NR RRC information used by the target gNB during handover preparation or UE context retrieval, e.g. in case of resume or re-establishment, including UE capability information. This message is also used for transferring the information between the CU and DU.","paragraph_zero_based":51855},{"literal_text_all_w_t_and_m_t":"Direction: source gNB/source RAN to target gNB or CU to DU.","paragraph_zero_based":51856},{"literal_text_all_w_t_and_m_t":"HandoverPreparationInformation message","paragraph_zero_based":51857},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":51858},{"literal_text_all_w_t_and_m_t":"-- TAG-HANDOVER-PREPARATION-INFORMATION-START","paragraph_zero_based":51859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51860},{"literal_text_all_w_t_and_m_t":"HandoverPreparationInformation ::=      SEQUENCE {","paragraph_zero_based":51861},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":51862},{"literal_text_all_w_t_and_m_t":"        c1                                      CHOICE{","paragraph_zero_based":51863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["20901e71f1c5225c5f119ea681a4f2a01d5ed35bd2e1d4da46824e154f10cd92","06194cfa2eb630b90d8be66e62d91853b72b613993693e59ddc51fa82f13e31d","abdff308b7ac2523ff613633b3c764294cef99d49935fc3887c0ddac79ba9c9e","1a17f1453e519822d0bdf131ce6b93563c9221135280b29141722a3132ca846e","6a9f1b6fb5ed0214388e364498a78f008a92daf568e9c4017fd7542bddefc745","ef7359f30f09d8950dc3c87ddaca959222b21270d9e9c4bcbd2c5cce78403fb9","07dc98448463a5dbe48e5128e3c70945d71bb9683b5f29a0015bdf190d53e8f9","a21b736e7f186aa1b4eb1e0a578606745d6dcf7693b819300fa6a6b33f33e228","c324625c5f8b2a4db20022e86b75e9eb060078bfe7b02a9131c91c2f15161cbf","d7f74babacfa92548567adfd98b737dbc796be05319f335152d5b6f4540eaf03","b048a4431b699045f0c6a567a209cf300109ba96e1008e2d9dd2d996df21bb05","