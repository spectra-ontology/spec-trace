d descriptions","paragraph_zero_based":32800},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":32801},{"literal_text_all_w_t_and_m_t":"SR periodicity and offset in number of symbols or slots (see TS 38.213 [13], clause 9.2.4) The following periodicities may be configured depending on the chosen subcarrier spacing:","paragraph_zero_based":32802},{"literal_text_all_w_t_and_m_t":"SCS =  15 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl","paragraph_zero_based":32803},{"literal_text_all_w_t_and_m_t":"SCS =  30 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 20sl, 40sl, 80sl, 160sl","paragraph_zero_based":32804},{"literal_text_all_w_t_and_m_t":"SCS =  60 kHz: 2sym, 7sym/6sym, 1sl, 2sl, 4sl, 8sl, 16sl, 20sl, 40sl, 80sl, 160sl, 320sl","paragraph_zero_based":32805},{"literal_text_all_w_t_and_m_t":"SCS = 120 kHz: 2sym, 7sym, 1sl, 2sl, 4sl, 5sl, 8sl, 10sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl","paragraph_zero_based":32806},{"literal_text_all_w_t_and_m_t":"SCS = 480 kHz: 1sl, 2sl, 4sl, 8sl, 16sl, 40sl, 80sl, 160sl, 320sl, 640sl, 1280sl, 2560sl","paragraph_zero_based":32807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["855828c321379758294a0d1a8fb457ec6925a2255836d38cfbdf234bd0f2d6eb","14c88176a06c86a1f4aa8a232109ba616aeb15c0fbca9f2d83273be2767eaa3f","956fe6ad0420747b91196b91cc283a7c04197b126a513de157e2df82f235b605","86d217459c18cab13cd025b90d606d5ffa7f37ffdfabbe89dadd57498e0ee4cf","83f7d6915745b1cb77f3ec3b8e37411d1d546a278900480d88aaa7eccbc2c3ed","03d9e1db3462295c1a8ee0185be4d8855cae82be6a425d792da6fdf30538e73d","dbf74fe7759ef355e53b19ec6a25560422723fb94fed7a3731ee8ea33a3a6367","fe1da9b30a3d19afab6a7cd468741647ce5c31