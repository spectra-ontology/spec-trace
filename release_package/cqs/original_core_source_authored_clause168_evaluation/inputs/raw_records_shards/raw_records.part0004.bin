{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present for inter-frequency handover and upon serving cell (PSCell/SCell) addition. Otherwise, the field is optionally present, Need M.","paragraph_zero_based":35952},{"literal_text_all_w_t_and_m_t":"ServCellAdd","paragraph_zero_based":35953},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon serving cell addition (for PSCell and SCell) and upon handover from E-UTRA to NR. It is optionally present, Need M otherwise.","paragraph_zero_based":35954},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35955},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommonSIB","paragraph_zero_based":35956},{"literal_text_all_w_t_and_m_t":"The IE UplinkConfigCommonSIB provides common uplink parameters of a cell.","paragraph_zero_based":35957},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB information element","paragraph_zero_based":35958},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35959},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMONSIB-START","paragraph_zero_based":35960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35961},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB ::=               SEQUENCE {","paragraph_zero_based":35962},{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL                         FrequencyInfoUL-SIB,","paragraph_zero_based":35963},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP                        BWP-UplinkCommon,","paragraph_zero_based":35964},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimerCommon                TimeAlignmentTimer","paragraph_zero_based":35965},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35967},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommonSIB-v1