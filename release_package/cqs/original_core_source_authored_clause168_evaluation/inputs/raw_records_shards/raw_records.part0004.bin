{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIB1 to the L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":49440},{"literal_text_all_w_t_and_m_t":"sl-SystemInformationDelivery","paragraph_zero_based":49441},{"literal_text_all_w_t_and_m_t":"This field is used to transfer SIBs and posSIBs to the L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":49442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49443},{"literal_text_all_w_t_and_m_t":"–End of PC5-RRC-Definitions","paragraph_zero_based":49444},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":49445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49446},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":49447},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49448},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49449},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49450},{"literal_text_all_w_t_and_m_t":"7Variables and constants","paragraph_zero_based":49451},{"literal_text_all_w_t_and_m_t":"7.1Timers","paragraph_zero_based":49452},{"literal_text_all_w_t_and_m_t":"7.1.1Timers (Informative)","paragraph_zero_based":49453},{"literal_text_all_w_t_and_m_t":"Timer","paragraph_zero_based":49454},{"literal_text_all_w_t_and_m_t":"Start","paragraph_zero_based":49455},{"literal_text_all_w_t_and_m_t":"Stop","paragraph_zero_based":49456},{"literal_text_all_w_t_and_m_t":"At expiry","paragraph_zero_based":49457},{"literal_text_all_w_t_and_m_t":"T300","paragraph_zero_based":49458},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCSetupRequest.","paragraph_zero_based":49459},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCSetup or RRCReject message, cell re-selection, relay reselection, and upon abortion of connection establishment by upper layers.","paragraph_zero_based":49460},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.3.7. ","paragraph_zero_based":49461},{"literal_text_all_w_t_and_m_t":"T301","paragraph_zero_based":49462},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCReestabilshmentRequest","paragraph_zero_based":49463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f671ecb1414077240d967dbd697fbffb2ce1a1d8c0053644bfee82c86c056a93","e9983cda2d2be9144bc7a882f47e9c679fb9dca03ada0f49c5a1a1d04308596e","ca9e489c3fc71da5b4a6aaae1ef2fa0e7e4fc602387789b7c5d9eeb330917046","b403ff1977e179dbdaf3be82e23c63ced026ef17cd730b826dac6a3db5139569","c2d8e70c94d1a99d6db86273e87225540fe42444886a5468201c960b84494990","17aae61a4faeb3a37cc03ac1e382b2712486b7e78061a165dfd53a51dd1cd89f","1145932ba647d2ec8cf8e8a4aa654242e22ac9e2edf6d228e011e1ec250a61b0","969d9f101161409f1ffbe14b293ec4de47c89228ec0ba76ace0fe8fd0418519d","ae5f7dd554f26fc665dda4f5adac71646dccad2c4690a4fd19e2ae10fe1bc509","a81350d37206388ddf5ab8cf0e456b76d0d008ffe864eb98fdbbf5ac7643cc21","c810d95c05f644fe17303e7ba0d11ba4f3fadb5a20a9e387399e5920efa12467","f68056797adcf5f5d181957449afa64831b13313e8a72a334901d3e74887b983","32e88bb6171d6b9c4b34d4994744689cf995c9be0e403b883ad0687b236e07b2","9fbca01dcdbb89770adc9fcd2a5460dd3169d0c8a18eb2e979165abfd2606000","6b1d34c2d866cdcd2d90766d7472255bc1a0e16373d37c6d6aa7615f2703b664","db6922af59b43dbff64118c87251afb56910cbf1ee5793d08409c88da8fef6d6","0b2767e1b3eb7f7ee8e68b493672f1bc9d3afb9fcfaa83cbca8eafe090370f66","51186486760ad26c7b4fedf3c18a80678540cb01878f990f7c1535dbf14c22c8","a536afb9a784fd359d21df76ad8eb46b0316e22a7754dab31d4fc1fcd6b970fe","1e59a18761cc028ec03f6d277d74293fe0056d20e184bd3f44480b2c1409ec27","ca98882776093693794c6840b8db2d8d69350814b2a1de579f5b547c74f9c139","6a8f45116fb7c8ef44522c366c527336d0b4cee4fe53eeedd80d8999e99d2406","f36a67c3806181a6d83f4bc1f1977a4b86e8f25625afdf627e78f5b24cf2b299","ca639ccde293d5f58bdc1a51f969411cd1965c24d1c599e9b6f33dcfadb060f4"],"paragraph_range_zero_based":[49440,49463],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p49440"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReestablishment or RRCSetup message as well as when the selected cell becomes unsuitable or the (re)selected L2 U2N Relay UE becomes unsuitable, upon reception of NotificationMessageSidelink indicating relayUE-HO or relayUE-CellReselection.","paragraph_zero_based":49464},{"literal_text_all_w_t_and_m_t":"Go to RRC_IDLE","paragraph_zero_based":49465},{"literal_text_all_w_t_and_m_t":"T302","paragraph_zero_based":49466},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReject while performing RRC connection establishment or resume, upon reception of RRCRelease with waitTime.","paragraph_zero_based":49467},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED or RRC_IDLE, upon cell re-selection, upon cell change due to relay (re)selection, and upon reception of RRCReject message.","paragraph_zero_based":49468},{"literal_text_all_w_t_and_m_t":"Inform upper layers about barring alleviation as specified in 5.3.14.4","paragraph_zero_based":49469},{"literal_text_all_w_t_and_m_t":"T304","paragraph_zero_based":49470},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCReconfiguration message including reconfigurationWithSync for the MCG which does not include sl-PathSwitchConfig, or upon reception of RRCReconfiguration message including reconfigurationWithSync for the SCG not indicated as deactivated in the NR or E-UTRA message containing the RRCReconfiguration message or upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync.","paragraph_zero_based":49471},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49472},{"literal_text_all_w_t_and_m_t":"Also, for the MCG and SCG upon an indication from lower layer that an LTM cell switch procedure is triggered and, for the MCG, upon performing an LTM cell switch procedure following cell selection performed while timer T311 is running.","paragraph_zero_based":49473},{"literal_text_all_w_t_and_m_t":"Upon successful completion of random access on the corresponding SpCell.","paragraph_zero_based":49474},{"literal_text_all_w_t_and_m_t":"In case of a reconfiguration with sync without performing random access procedure, upon receiving a PDCCH transmission addressed to C-RNTI after first UL transmission, for the same HARQ process.","paragraph_zero_based":49475},{"literal_text_all_w_t_and_m_t":"In case of an LTM cell switch without performing a random access procedure, upon receiving a PDCCH transmission addressed to C-RNTI after first UL transmission, for the same HARQ process.","paragraph_zero_based":49476},{"literal_text_all_w_t_and_m_t":"Upon receiving an indication from lower layers of successful completion of Rach-less handover.","paragraph_zero_based":49477},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49478},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, upon SCG release.","paragraph_zero_based":49479},{"literal_text_all_w_t_and_m_t":"For T304 of MCG, in case of the handover from NR or intra-NR handover, or path switch from a L2 U2N Relay UE to a NR cell, or a reconfiguration with sync without performing random access procedure, or an LTM cell switch procedure, initiate the RRC re-establishment procedure; In case of handover to NR, perform the actions defined in the specifications applicable for the source RAT. If any DAPS bearer is configured and if there is no RLF in source PCell, initiate the failure information procedure.","paragraph_zero_based":49480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49481},{"literal_text_all_w_t_and_m_t":"For T304 of SCG, inform network about the reconfiguration with sync failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":49482},{"literal_text_all_w_t_and_m_t":"T310","paragraph_zero_based":49483},{"literal_text_all_w_t_and_m_t":"Upon detecting physical layer problems for the SpCell i.e. upon receiving N310 consecutive out-of-sync indications from lower layers.","paragraph_zero_based":49484},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, upon receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the connection re-establishment procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon initiating the MCG failure information procedure.","paragraph_zero_based":49485},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T310 is kept in SCG.","paragraph_zero_based":49486},{"literal_text_all_w_t_and_m_t":"If the T310 is kept in MCG: If AS security is not activated: go to RRC_IDLE else: initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure as specified in 5.3.7 or the procedure as specified in 5.3.10.3 if any DAPS bearer is configured.","paragraph_zero_based":49487}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["19ed762543c2fa7c3617df7f4ec3df0cfd2454ca8ffc3d9ad89ca3ee3fe9bc4f","3867b2799db664b9f30052b84a54ed8cd2c37d3c68ff1a053f3342a1fd0c5c19","f601f29e234ed14c7e925c102295bc2c6af5d6ce3f89bf8a40ac4cd4f93ac168","4c785bd35ba0a5f756c36e5cdeb58c7062f144efaf504b41914e6ef144f1dbd4","52fd59d4f6d9cfd684a028b39963579ffee654d992053572b104449ae167de77","b2ef063d9eaa4fa54f7ee0ffed6ef15231eec8554d17dffc3f41886e09d5edfa","e4237b5f5e618df27f80fb8fe682a3123feff5c629de81da205fa8093aaf2337","c79c2d15cd52d64063048160221c98407f7a4f400a7fc9c38a2aad173c553fb1","e877e9818fb8c85e4f6ef510fbdd64abff0586dc9a0ebe7d5903250ce61f16c8","6c2d6e4f60bd6a1a949aafc979a30d51357518b88c5e60f1956b761e768ae1e5","e3b524729297b853811b968a2aa4f20888f555c50aa35be817257be8fc622f1a","f3eb0b60d0059948c606154c080cd875ed136fb576e80032f120339a06525d65","44888befa865f0aa5fc7a2a5caad407fcbc8d9e5442bd07dc27e320ac8189ae5","08647247809466e2393556834dec5bd9a0571656ea6d510d77f4946649de4ac0","e8112be564f841fe47ac2fd5314d0e7610609c5f03fa299389420e655488d938","eef721fcdde2dea531bfc501d722bd88767c9d99f23a84bffbb3cac4361ce857","7e2ac472f6fdd2f64fdef39cf3df048665b893239b8aff3e40f419345672473d","b609a0891b1c60d0a684ead48548bae6fcff797e001028fd1b7828028e743c0b","ed709859621a3f2213eb43e92c293476e52c5f47da8bc2db7e7f2b804a00d4db","b41b0f0fe801d0bc82547db1981e4f949b5cb93494f326cd97eaafb72037d8bf","9245fcaf5eecd01b459f92e1a9bfae39d06caea6e0bb690c19f3e2ca0e2f7308","96a6f9155a6089ea5e9a9f305353d67c0a445be224002421f77b8283bf724edd","0e3afa49fa3d0b2603722d62ed2005da2a25cdd580fd3e9f2479088f519ad092","878402c518054781b49aa030ba72ecf79b3961ba92df64130255423153ac435a"],"paragraph_range_zero_based":[49464,49487],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p49464"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If the T310 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure as specified in 5.7.3.","paragraph_zero_based":49488},{"literal_text_all_w_t_and_m_t":"T311","paragraph_zero_based":49489},{"literal_text_all_w_t_and_m_t":"Upon initiating the RRC connection re-establishment procedure","paragraph_zero_based":49490},{"literal_text_all_w_t_and_m_t":"Upon selection of a suitable NR cell, or upon selection of a suitable L2 U2N Relay UE, or a cell using another RAT.","paragraph_zero_based":49491},{"literal_text_all_w_t_and_m_t":"Enter RRC_IDLE","paragraph_zero_based":49492},{"literal_text_all_w_t_and_m_t":"T312","paragraph_zero_based":49493},{"literal_text_all_w_t_and_m_t":"If T312 is configured in MCG: Upon triggering a measurement report for a measurement identity for which T312 has been configured and useT312 has been set to true, while T310 in PCell is running.","paragraph_zero_based":49494},{"literal_text_all_w_t_and_m_t":"If T312 is configured in SCG and useT312 has been set to true: Upon triggering a measurement report for a measurement identity for which T312 has been configured, while T310 in PSCell is running.","paragraph_zero_based":49495},{"literal_text_all_w_t_and_m_t":"Upon receiving N311 consecutive in-sync indications from lower layers for the SpCell, receiving RRCReconfiguration with reconfigurationWithSync for that cell group, upon reception of MobilityFromNRCommand, upon initiating the connection re-establishment procedure, upon the reconfiguration of rlf-TimersAndConstant, upon initiating the MCG failure information procedure, upon conditional reconfiguration execution i.e. when applying a stored RRCReconfiguration message including reconfigurationWithSync for that cell group, and upon the expiry of T310 in corresponding SpCell.","paragraph_zero_based":49496},{"literal_text_all_w_t_and_m_t":"Upon SCG release, if the T312 is kept in SCG","paragraph_zero_based":49497},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in MCG initiate the MCG failure information procedure as specified in 5.7.3b or the connection re-establishment procedure.","paragraph_zero_based":49498},{"literal_text_all_w_t_and_m_t":"If the T312 is kept in SCG, Inform E-UTRAN/NR about the SCG radio link failure by initiating the SCG failure information procedure.as specified in 5.7.3.","paragraph_zero_based":49499},{"literal_text_all_w_t_and_m_t":"T316","paragraph_zero_based":49500},{"literal_text_all_w_t_and_m_t":"Upon transmission of the MCGFailureInformation message","paragraph_zero_based":49501},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease,  RRCReconfiguration with reconfigurationwithSync for the PCell, MobilityFromNRCommand, or upon initiating the re-establishment procedure","paragraph_zero_based":49502},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.3b.5.","paragraph_zero_based":49503},{"literal_text_all_w_t_and_m_t":"T319","paragraph_zero_based":49504},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is not initiated for SDT.","paragraph_zero_based":49505},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCRelease with suspendConfig or RRCReject message, upon cell re-selection or upon relay (re)selection.","paragraph_zero_based":49506},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":49507},{"literal_text_all_w_t_and_m_t":"T319a","paragraph_zero_based":49508},{"literal_text_all_w_t_and_m_t":"Upon transmission of RRCResumeRequest or RRCResumeRequest1 when the resume procedure is initiated for SDT.","paragraph_zero_based":49509},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCResume, RRCSetup, RRCRelease, RRCReject message or upon failure to resume RRC connection for SDT as specified in 5.3.13.5 or upon cell reselection.","paragraph_zero_based":49510},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.3.13.5.","paragraph_zero_based":49511}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["07601b575c86178b699d24c67ce0e8aaf9864b52bf667dd374368e3f9d717390","5172f2046520f0531127111887cf12af9041705a4fa5e8e784cc64eabe74cd44","8bd071943f03d29f522b6abd37313e1ea7a0eceb821197ebfb50390b786cd054","874535f7e5f90d67c06669735125465746d6f8a1c82b446312985b2f2dfc8d59","b4800f229e07378166eea622010bf2dc87a5d5a42837b650cf297c9215a94922","be6725cfa7bd91a85ac77b2d2907051956b00e38fdbe076e246164537f7c60f0","781508d737439a5a79d76b2d7ebfdc9b15c1e6f96e5b3dda7b1ce20244842928","d0f9882dc3b4ba893f728158af1b03d391b2a1a9dc0db42d6f24eb7dfed083fd","f5b42be5fd21668983e0ee56f4ad45ef6903d518b889da8a197389592612cbe4","04d71a87348859198222bb57c3a65267dba783fa63b0c3ee5d96902b75b1ce7d","94aecd021974d344d31bcbe8bdd789dc79f8bed35d20e5d7670e607f1f358520","68125be122b4ff8b35a4e2141945a9d607d1058ed8883af3b74bf9cbad488dfd","71cf5e6276d70c0f5449055a69de236b5b50670882e83d4adb633cbc285d1d1e","350a0478e64d0e6b079e459c88625516d6d0b85162dae2aafce02c328f7e5798","8fe7496c9b982d69e2fbcecf5b0924bb9078df7dab10d353fa76d919fd7fdef5","a0d162948dcdabc4d60ac35ca5477f1f6d4249cfd52f663e3f2322f9dc653583","d11e3539f5b16617373e560d7f054b0d14a31ff9cd6530f3820a2e130d45407a","a4196208f2ce271f80b742ed4b73619067d51f347273370b0777503a0d2b43e7","1737bb697d4860cac889d24abff005f423b98ee82461c089239a367fb3958ece","2274cd32c75fc9958eb4c5cbe009d7f0430c20b71f19799608ae3ebc68837915","0a650bfcbc71899ba52f87c61f05eca600eb9cc301820d8f44cf83266adf2f18","5decf96a065d02e517f7a723523ee2417596aa668437371370f361d752303169","ae43e24895c2c6431d2120c268d631e33c618d853de4840cb21d1b392bfc5131","16c5034c098a564d1d21146d53f890d0776cf77f4bb89374c565c1392e81caeb"],"paragraph_range_zero_based":[49488,49511],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p49488"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"T320","paragraph_zero_based":49512},{"literal_text_all_w_t_and_m_t":"Upon reception of t320 or upon cell (re)selection to NR from another RAT with validity time configured for dedicated priorities (in which case the remaining validity time is applied).","paragraph_zero_based":49513},{"literal_text_all_w_t_and_m_t":"Upon entering RRC_CONNECTED, upon reception of RRCRelease, when PLMN selection or SNPN selection is performed on request by NAS, when the UE enters RRC_IDLE from RRC_INACTIVE, or upon cell (re)selection to another RAT (in which case the timer is carried on to the other RAT).","paragraph_zero_based":49514},{"literal_text_all_w_t_and_m_t":"Discard the cell reselection priority information provided by dedicated signalling.","paragraph_zero_based":49515},{"literal_text_all_w_t_and_m_t":"T321","paragraph_zero_based":49516},{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including a reportConfig with the reportType set to reportCGI","paragraph_zero_based":49517},{"literal_text_all_w_t_and_m_t":"Upon acquiring the information needed to set all fields of cgi-info, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportCGI and upon detecting that a cell is not broadcasting SIB1.","paragraph_zero_based":49518},{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":49519},{"literal_text_all_w_t_and_m_t":"T322","paragraph_zero_based":49520},{"literal_text_all_w_t_and_m_t":"Upon receiving measConfig including reportConfigNR with the reportType set to reportSFTD and drx-SFTD-NeighMeas is set to true.","paragraph_zero_based":49521},{"literal_text_all_w_t_and_m_t":"Upon acquiring the SFTD measurement results, upon receiving measConfig that includes removal of the reportConfig with the reportType set to reportSFTD.","paragraph_zero_based":49522},{"literal_text_all_w_t_and_m_t":"Initiate the measurement reporting procedure, stop performing the related measurements.","paragraph_zero_based":49523},{"literal_text_all_w_t_and_m_t":"T325","paragraph_zero_based":49524},{"literal_text_all_w_t_and_m_t":"Upon reception of RRCRelease message with deprioritisationTimer.","paragraph_zero_based":49525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49526},{"literal_text_all_w_t_and_m_t":"Stop deprioritisation of all frequencies or NR signalled by RRCRelease.","paragraph_zero_based":49527},{"literal_text_all_w_t_and_m_t":"T330","paragraph_zero_based":49528},{"literal_text_all_w_t_and_m_t":"Upon receiving LoggedMeasurementConfiguration message","paragraph_zero_based":49529},{"literal_text_all_w_t_and_m_t":"Upon log volume exceeding the suitable UE memory, upon initiating the release of LoggedMeasurementConfiguration procedure","paragraph_zero_based":49530},{"literal_text_all_w_t_and_m_t":"Perform the actions specified in 5.5a.1.4","paragraph_zero_based":49531},{"literal_text_all_w_t_and_m_t":"T331","paragraph_zero_based":49532},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCRelease message with measIdleDuration","paragraph_zero_based":49533},{"literal_text_all_w_t_and_m_t":"Upon receiving RRCSetup, RRCResume, RRCRelease with idle/inactive measurement configuration, upon cell selection/reselection to a cell that does not belong to the validityArea (if configured), or upon cell re-selection to another RAT.","paragraph_zero_based":49534},{"literal_text_all_w_t_and_m_t":"Perform the actions as specified in 5.7.8.3.","paragraph_zero_based":49535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a