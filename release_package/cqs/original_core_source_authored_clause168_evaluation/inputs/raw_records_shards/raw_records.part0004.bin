,{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46431},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-REMOTEUE-CONFIG-STOP","paragraph_zero_based":46432},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46434},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-Config field descriptions","paragraph_zero_based":46435},{"literal_text_all_w_t_and_m_t":"sl-ReselectionConfig","paragraph_zero_based":46436},{"literal_text_all_w_t_and_m_t":"Includes the parameters used by the U2N remote UE when selecting/ reselecting a U2N relay UE.","paragraph_zero_based":46437},{"literal_text_all_w_t_and_m_t":"thresHighRemote","paragraph_zero_based":46438},{"literal_text_all_w_t_and_m_t":"Indicates the threshold of Uu RSRP for a UE that is in network coverage to evaluate AS layer conditions for U2N remote UE operation.","paragraph_zero_based":46439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["93010850406c57a2d7a36f3c4a16f242d6dc5c9a813f9e1456794f756b389076","d5d00b98d37d905ea929f6bc6099b91d5c14a495dc03bf25c295d0d4c75abf79","561825981645f815ff9244d8a1d4fcb2d115011327b09d10bc5d1c97c13a480d","465a05b3ebd0c1f24bfdfe6840af609a01431c22aa1bb0fb9d8b6d173bba7ec6","6fbb7d3098988c909dac62e8818875f42c7d161f9c9651031283b720c3612871","88334371defba6fdfdb03162269d6679097a0179c5cec79078931bbb05df8840","ffc36f03c6b6ce29818172c4ac934fba6139a1e2d48d4300c6c9c09ab13a81a0","b04718c4a733bb736ed8b4e14c0182ce4fb1ddd6cde9047ebb2deb663a5a43d2","3850fb64b164970d05ffc2b63a7f80e9125af6f33b8695cb738d504e841c2282","8c24a8810e97eb13544b92c43b5533558037ead0583501115f2ae8a7ae1d369e","4b4abad491a457a48d2ae8678ae05c4fed09787ce830b1bd19c2