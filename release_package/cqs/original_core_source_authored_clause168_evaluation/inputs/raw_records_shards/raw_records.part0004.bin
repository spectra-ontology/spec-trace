ocument_XML_sha256":"708f3bf17b8f6a9f223c3643ac2f82eb0fdb59a9de57fd5ab548b451f4c0e913","original_member_sha256":"59dbe1574ec38535648563015e0ce60a339298c8b5b70ba400618d7a85382db0","paragraph_ElementTree_utf8_XML_sha256":["28567a0993886d972ea917290a79587f835d16e909db17108ba58048229879c8","e8fc5a3e26060c55f69cae32e4e203b4879eec3a7452d6663b1ddaa42523d165","f9e60563cbd30239959a4dfd5856c3df3b8d8980af173abe48e47cb28acfa025","dca27312d7a1517d19ed558671871fab25e9b549c607883b97a78f9f3628f08a","6d3fba1314de1001e3753ed4f16b9c74cdf0271805f61b17dcc5b42bd590842f","617785343afc34ff86d7085e070e5171c849cf65b766df069d11ae4921b43535","9953a0a243d1604ccf24e0c58b977b28d52611973aabcc25bdb0524e740b1019","cb9646e53a961acadd8b9d1cbe9977f71385aded0c0dd84e225defb7e8545ad8","e434e65a10e838afc9f35a37c5efebc215fd9aedc21692d7cc12941674744e85","48f27d1f338f2e6cabf1ff384625f9d1a5e67ab8190bf0af224f5e9fd5a2044d","ae047b5bff89a3e1ff48121c383764b0693ed10d3ee54abf7ca118f0937cbfd7","731cd85286f824ffc8ab15b3e076faaf16231b040ec58d5b982eb0b04411f518","8c9e1cc4f551da9266725c4308f504816e777704b3e96de8fcca8a7e127729cd","15446e336e26f8e8542354aaa67cefc1b9b0d8b4af76558f1b7e96594ab3e72b","032e9f858d3d59ab048f1c6847f25e5b233bb6ba0c88c96eee40690f328745ca","1ac810a1cab11c95a1df934fbe11d17d0c7b90f828c877e62a98a07ed58b7dfa","f85eec82466c19e4d2f27b1a85a175459c60d7943a12a31a9289c1342d9700c8","b3f8ba76ec829a0eac6003bc8cbccaed17d41a62756dd1214cc8a7fa8c87c76d","ebb18e058d1fac3e0efc9941e530e6c9327f91af82e47a50969e70a111afea2a","82c650d693e614473a904a14608b165daa877c3a594b383531c99eb322278671","dcb00a9e6c6c316c0088d2dc5f1b8ad2617b4424352762cd9029642ce44b55be","adf91afec1ef44a2388772bd7103ea6e4f36004e933a3b58dc00af5209fde022","500ae1e95311986e752b9be027e0c22a78d267c2f0de2c686523828721158b14","1cef444d894cdacbe559bb45e53c3b2ef7f77da82c45f0f24d784d4541645307"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404430.zip::R2-2404430_CR5000_36.331 Correction on redirection to GERAN.docx:p24"}
{"fields":{"filename":"R2-2404430.zip::R2-2404430_CR5000_36.331 Correction on redirection to GERAN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"F","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"1.  According to the current procedure of reception of the RRCEarlyDataComplete, under the case that NW indicates UE redirect to GERAN or UTRAN and upper layers indicate that redirect to GERAN or UTRAN without AS security is not allowed, UE shall perform redirection to GERAN or UTRAN, which is against the intention of the redir-policy bit.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"2. According to the current procedure of reception of the RRCEarlyDataComplete, under the case that idleModeMobilityControlInfo including freqPriorityListGERAN or freqPriorityListUTRA-FDD or freqPriorityListUTRA-TDD and upper layers indicate that redirect to GERAN or UTRAN without AS security is not allowed, UE shall apply the cell reselection frequency priorities in idleModeMobilityControlInfo, which is against the intention of the redir-policy bit.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Add clarification that UE should ignore the content of RRCEarlyDataComplete message when the message indicates redirection to GERAN or UTRAN.","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"Add clarification that UE should ignore the content of RRCEarlyDataComplete message when the message includes idleModeMobilityControlInfo including freqPriorityListGERAN or freqPriorityListUTRA-FDD or freqPriorityListUTRA-TDD.","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Impacted functionality: ","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Redirection to GERAN or UTRAN; cell reselection priority handing","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"708f3bf17b8f6a9f223c3643ac2f82eb0fdb59a9de57fd5ab548b451f4c0e913","original_member_sha256":"59dbe1574ec38535648563015e0ce60a339298c8b5b70ba400618d7a85382db0","paragraph_ElementTree_utf8_XML_sha256":["e4ea5591218aa96d0cd407936b651eb165fb4c75e229dab64ec9de6be991cb96","2d00e3b1a82065155328ddd802c3d4a8ebff11f4a0d6da9ecf9b1e34dc8ebfc8","0d8e8c3fd71374617f165eb0ba4393195b5a62eba985de50c3e51c3f3779e30d","761fa4d36b282591b5f5bb5ee554c6086f6eb9d5925f257d405f142f9e3a17e1","9ee3a8ef1b4d8b5d23ae68c79878f83d9a7ffdf02ec93cff53f7b1de6029f4d6","dccf4ea1e2d2337ae143f3b32192619a1d2ad44aef2a277bd1368f475154a72e","b08252b53f111fda758564f01d6aeb287a86ceee9730eba0ca5fcf7c7dadb00e","5397ebe3cc2afa3393b897343a62f60e5b485315d8236802a715ec930f5cc336","9179ba236853e4a73f15d3d408619f0f62540850e6daa878c17cdc8a8f26dbb9","dd3de490bf00baf5087f33777fa272abbec9623033d71526d5355fb97ee7f36f","16c8d70f7d429c511b56c375317337c5d5c75b5a185ec91bf088b77069963fb7","acd6206245de4b9556a4853ff1b8b41875944834aa76df6c7d72af763f365262","3c4c80e1e11044a4d07c2d065ab1badcf74a3b84af6435503a27154aade28f9b","c027c8c6e4d006c0fe064149b5417c6ac0af716a44e8c26595403b0903b9ea00","91bf6dfe65cf2984aeb0b3a779462856cbfd0edad8c99990d6a41a7748852e4f","8b24573e0133d1c5ee95e1377545628b16380b4d3d980bde5296376e8173041e","7423559940944ed0cc1fe176b76253cf9035dcdbfc0fac2f3e385feb311a2329","288cc60197c635a28716a1c3a9133085106b36b1009fb0a2849670c1b99dfd9f","5d4a3395aceae9c0e859a6db3fa20b37bd0650a55ac9ae57e920767a6efda4ab","39b11ffbec6a550b52cde8b74542f70a3a4a74a9b4e8dde94aa364087a759ee4","5f21726c8d8479b79a0731253c7208b989146c91982059c9e93fee98b30b8f06","430dbd09b24c2dd47353ab9b6628dbc8e688297ab615ed86257ab99e16171580","d51b3326e29796cbd69298c3a45da0862a166416604bac5b5f28dbe82225f021","d30548267de0778d9be5ad3ac748bd388c514fa36a7422dff688441350999cb7"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404430.zip::R2-2404430_CR5000_36.331 Correction on redirection to GERAN.docx:p48"}
{"fields":{"filename":"R2-2404430.zip::R2-2404430_CR5000_36.331 Correction on redirection to GERAN.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"If the network is implemented according to the CR and the UE is not, the UE may do the redirection to GERAN or UTRAN, UE may apply the cell reselection priorities configured by fake BS, which may cause security issues.","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"If the UE is implemented according to the CR and the network is not, there are no interoperability issues.","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"The specification erroneously allows UE to accept unsecured redirection towards GERAN or UTRAN. The specification erroneously allows UE to apply unsecured cell reselection priorities of GERAN or UTRAN.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"5.3.3.4b","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"Y","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"N","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_t":"Other specs","paragraph_zero_based":91},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":92},{"literal_text_all_w_t_and_m_t":"x","paragraph_zero_based":93},{"literal_text_all_w_t_and_m_t":" Other core specifications","paragraph_zero_based":94},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":95}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"708f3bf17b8f6a9f223c3643ac2f82eb0fdb59a9de57fd5ab548b451f4c0e913","original_member_sha256":"59dbe1574ec38535648563015e0ce60a339298c8b5b70ba400618d7a85382db0","paragraph_ElementTree_utf8_XML_sha256":["7929fada8dc84e88b0f3cd588b61e72c582b570cacf9d9cdc9a8a7809447d540","25a1d3bd0e65a66a89f4126612f6f2d45184caee6b9b24b15d419906092b1886","ae081a6e37fb402125e0d80eae4156e9f1554091de7c4aa7b95ab070c0632375","96d155da5b0d77d717f33526f1447d9c44e6c6b8bd114b5b01aebd01c4b723e7","23da18bbbcbc650fad7a07ef8006251a7a06ae59113986d1a2b8d37f6d71a8d1","85f9fe225bf206da5b28016fbb39c62cb1368eb1244f4f20547ea6629294dc69","378adf0aa423995360841de5b3ff121413a3320bd55a44c2044b1a4823324310","1a47a8fddfdc7b91479a5a41ce6ff8e7cfdcc490120248c41d6bcb8933b419d1","d3098623b4dfc23a1a4b383cc6c305d01a4c1c56ac54d5853c2f6542bbe0ad3e","d88bc81b05cdcb5373fcefe52e78f5e5b7ea4e37e19c0d9ebb00bb2abbe8ad2d","61cf31ccb32ca743f815831546a63f3d4f37ea5f4ff7e02e623d0e686dc91277","36ab49f3bbf77c4508440a22b5c3eea60b8890973be15e9a2bc7290aa2b371e3","d3262b1816fab55992cffb02c05a6ffa91b6523e243fbbc95fea56d1d4a60b90","c3683d587e9395b4366df402366a37ae834beabe3792a5a1f587771601d39ee1","ed998830d31c45491e1e0440155b1f04906345d5cf11cf124da3b8514b084b6e","906013edb57524be9364140bb342f747d25cd914a658ac9688cc0e1c36c48a4e","cab89597302c5ba322c3b7522dfdc53fa38c04425d13ef616d215a001889c126","cb1f68c3cb7a527ab8d0f7a4b7dbf74587c5012a7899a22e9846e53e203421fe","65ac2483d208b50090003208e2b80a9b3ba9afa4b052a079f5511890803e3032","13a296cdc0117fe8fab98180233cab30f6