27663","368049f8877aa81b7515a5e466f0ecd4beb43d71f51b1ae627f5198364c6a11d","bba16a74967bb90e3d0d30d05e08cccda31dac561cf8066a063bb3a1dffef568","c7b1a7cbf45bb3faa2ab98436504d5619f28e1d8df927333ef154a097cb0404c","1c2fff70ea18d1e5d2c7b82739e8e0ad1354338bf0d05c928c16cc207c79951a","d946b7decd22514870ecd230b8b6775a3e1db91a19ad196ea8ed4be6c3a5aef2","c2357640194c8c7bc02076ac06fc8f08afa1b015b50c86bf383e9971de23864e","1395300b85d5141a905e74146045808f6bdae95077b54a38269331068f0f1027"],"paragraph_range_zero_based":[31368,31391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p31368"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures UE with a repetition scheme among fdmSchemeA, fdmSchemeB and tdmSchemeA as specified in clause 5.1 of TS 38.214 [19]. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release slotBased if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":31392},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":31393},{"literal_text_all_w_t_and_m_t":"For slot-based repetition scheme, selected RV sequence is applied to transmission occasions associated to the first TCI state. The RV sequence associated to the second TCI state is determined by a RV offset from that selected RV sequence.","paragraph_zero_based":31394},{"literal_text_all_w_t_and_m_t":"slotBased","paragraph_zero_based":31395},{"literal_text_all_w_t_and_m_t":"Configures UE with slot-based repetition scheme. Network always configures this field when the parameter repetitionNumber is present in IE PDSCH-TimeDomainResourceAllocationList. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release fdm-TDM if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":31396},{"literal_text_all_w_t_and_m_t":"startingSymbolOffsetK","paragraph_zero_based":31397},{"literal_text_all_w_t_and_m_t":"The starting symbol of the second transmission occasion has K symbol offset relative to the last symbol of the first transmission occasion. When UE is configured with tdmSchemeA, the parameter startingSymbolOffsetK is present, otherwise absent.","paragraph_zero_based":31398},{"literal_text_all_w_t_and_m_t":"tciMapping","paragraph_zero_based":31399},{"literal_text_all_w_t_and_m_t":"Enables TCI state mapping method to PDSCH transmission occasions.","paragraph_zero_based":31400},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31401},{"literal_text_all_w_t_and_m_t":"–ReportConfigId","paragraph_zero_based":31402},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigId is used to identify a measurement reporting configuration.","paragraph_zero_based":31403},{"literal_text_all_w_t_and_m_t":"ReportConfigId information element","paragraph_zero_based":31404},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31405},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-START","paragraph_zero_based":31406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31407},{"literal_text_all_w_t_and_m_t":"ReportConfigId ::=                          INTEGER (1..maxReportConfigId)","paragraph_zero_based":31408},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31409},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-STOP","paragraph_zero_based":31410},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31412},{"literal_text_all_w_t_and_m_t":"–ReportConfigInterRAT","paragraph_zero_based":31413},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigInterRAT specifies criteria for triggering of an inter-RAT measurement reporting event, or an L2 U2N relay measurement reporting event. The inter-RAT measurement reporting events for E-UTRA and UTRA-FDD are labelled BN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled YN with N equal to 1, 2 and so on, and Z1.","paragraph_zero_based":31414},{"literal_text_all_w_t_and_m_t":"Event B1:Neighbour becomes better than absolute threshold;","paragraph_zero_based":31415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9