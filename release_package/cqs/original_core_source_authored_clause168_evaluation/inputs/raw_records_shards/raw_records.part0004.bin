{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    resourceType-r18                    ENUMERATED {periodic}                                                   OPTIONAL   -- Cond LTM","paragraph_zero_based":26760},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26761},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26762},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26763},{"literal_text_all_w_t_and_m_t":"CMRGroupingAndPairing-r17 ::=        SEQUENCE {","paragraph_zero_based":26764},{"literal_text_all_w_t_and_m_t":"    nrofResourcesGroup1-r17              INTEGER (1..7),","paragraph_zero_based":26765},{"literal_text_all_w_t_and_m_t":"    pair1OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL,  -- Need R","paragraph_zero_based":26766},{"literal_text_all_w_t_and_m_t":"    pair2OfNZP-CSI-RS-r17                NZP-CSI-RS-Pairing-r17                                                 OPTIONAL   -- Need R","paragraph_zero_based":26767},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26769},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Pairing-r17  ::=          SEQUENCE {","paragraph_zero_based":26770},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId1-r17           INTEGER (1..7),","paragraph_zero_based":26771},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId2-r17           INTEGER (1..7)","paragraph_zero_based":26772},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26774},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESET-STOP","paragraph_zero_based":26775},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26776},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26777},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSet field descriptions","paragraph_zero_based":26778},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffset, aperiodicTriggeringOffset-r16, aperiodicTriggeringOffset-r17","paragraph_zero_based":26779},{"literal_text_all_w_t_and_m_t":"Offset X between the slot containing the DCI that triggers a set of aperiodic NZP CSI-RS resources and the slot in which the CSI-RS resource set is transmitted. For aperiodicTriggeringOffset, the value 0 corresponds to 0 slots, value 1 corresponds to 1 slot, value 2 corresponds to 2 slots, value 3 corresponds to 3 slots, value 4 corresponds to 4 slots, value 5 corresponds to 16 slots, value 6 corresponds to 24 slots. For aperiodicTriggeringOffset-r16 and aperiodicTriggeringOffset-r17, the value indicates the number of slots. aperiodicTriggeringOffset-r17 is applicable to SCS 480 kHz and 960 kHz, and only the values of integer multiples of 4 are valid, i.e. 0, 4, 8, and so on. The network configures only one of the fields. When neither field is included, the UE applies the value 0. This field is not present in case NZP-CSI-RS-ResourcesSet is received as part of an LTM-Candidate IE.","paragraph_zero_based":26780},{"literal_text_all_w_t_and_m_t":"aperiodicTriggeringOffsetL2","paragraph_zero_based":26781},{"literal_text_all_w_t_and_m_t":"Indicates triggering offset of aperiodic NZP CSI-RS resources used for fast activation of the SCell (see clause 5.2.1.5.3 of TS 38.214 [19]), when the NZP CSI-RS resources are activated by the MAC CE (see clause 5.9 of TS 38.321 [3]). The value indicates the number of slots. This field is not present in case NZP-CSI-RS-ResourcesSet is received as part of an LTM-Candidate IE.","paragraph_zero_based":26782},{"literal_text_all_w_t_and_m_t":"cmrGroupingAndPairing","paragraph_zero_based":26783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["44a4c32afc2413d6167ebb9f02fa56341e8cc9c2a3f47e2dfc175b3e72ed9f80","412a2cae7309068ae10095c03ebf4b8f013e8b2cc973069c5eb1314470d2cb6f","2b648671717d1ff1981056307ec271bef66ffb414b69cb58f0de127491bc91f1","7fcb25ed330aaf270e5ba0fc307f1c0ecb55012ef7a0805799341f8b5189e9b8","2b0f02dd60b839bc7c65c9d3ad0dedd40b22e95093e8fc4fcfeb53f3c72cc4e3","1248ff7ffc64e25926be950b30925aa5f99da9e38195644033839aea3b903d43","0de85dbc83665e6cf239c840696c79bf5ea8dc63089c79472b7495141fb3395a","9ee980e70b0aba32196a4d076285aee9785acb8730486a886c80bb96d3b6658c","1d8b97330f1c909b82723cb1f91926dcbec42272e05e93aa10f6537dfb2eb55d","1a226e936e536680dcb0665d5e2d602f04601d85982594620aefe446684c2d4d","f445fd749e23c40a5a9889d4ebb582842d85baf5f7e0092b5fb727c57d8cd278","12cb530359139c563107fd67fd0c8ff2da707b9cb550ad6109ba0a3f4909ef08","b5975979cc962763f5ca194318ec00a357152a3383f0db5474bd225eca860944","3902506267043a8df6908473418f53e73610047ec077a9185fc996beb1de4706","6713c3cd99836c83499e66c5042d308bb55eaedef5cb12259f2352f400c4a520","8b7b4073997b20c6ca57c4e4ef49b9ad4fa29e314c27e15663ba67003cd7b28e","c3b61a048b46e417b911cdbf8e20f9c7b1e3f0f0244242d32b512b79da7e206b","c14370d133560af5bbf1d612b611af5b6f6b8712605cb720e1f88cdcf1ce8376","8ce811ae10b25f0f4c9fb1e0676790f26f76b806ec5684393698d8463c2b5a57","67fc9abaaa99379b5ae353020f431a8afd5b305b90e7fe0c43a3fd386fa976bd","6b6c0734336bbdeb759ac4b3557a758d173d18da641c01f1fd487b7d768c6e84","d898b7cc4925ed9a4bee912403efa2976bb1eceff06b508ff99891bf87fb6e7f","05f92c1f9c00ef865ba729a9c5095f3f2224690c58742a1ad64a05a3e4ba2698","c82ffd6ee75c2ae7cfc71d159828ed6fb285510269cc3fce5f02f55f0b12f91e"],"paragraph_range_zero_based":[26760,26783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p26760"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures CMR groups and pairs. The first nrofResourcesGroup1 resources in the NZP-CSI-RS resource set belong to Group 1 and the remaining resources in the NZP-CSI-RS resource set belong to Group 2. nrofResourcesGroup1 is K1 and the number of remaining resources in the NZP-CSI-RS resource set belonging to Group 2 is K2 as specified in TS 38.214 clause 5.2.1.4.1. Maximum total number in Group 1 and Group 2 is 8 (see TS 38.214 [19], clauses 5.2.1.4.1 and 5.2.1.4.2). This field is not present in case NZP-CSI-RS-ResourcesSet is received as part of an LTM-Candidate IE.","paragraph_zero_based":26784},{"literal_text_all_w_t_and_m_t":"pair1OfNZP-CSI-RS, pair2OfNZP-CSI-RS","paragraph_zero_based":26785},{"literal_text_all_w_t_and_m_t":"A pair of NZP CSI-RS resources. In one pair, one resource shall belong to group 1 and the other resource shall belong to group 2 (see TS 38.214 [19], clause 5.2.1.4.1).","paragraph_zero_based":26786},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-Resources","paragraph_zero_based":26787},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resources associated with this NZP-CSI-RS resource set (see TS 38.214 [19], clause 5.2). For CSI, there are at most 8 NZP CSI RS resources per resource set. For Doppler or Doppler-PS codebook operation there are at most 1 P/SP NZP CSI-RS resource and 4, 8 or 12 AP NZP CSI-RS resources and for CJT or CJT-PS, there are 1, 2, 3, or 4 AP/P/SP NZP-CSI-RS resources, see TS 38.214 5.2.1.4.","paragraph_zero_based":26788},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceId1, nzp-CSI-RS-ResourceId2","paragraph_zero_based":26789},{"literal_text_all_w_t_and_m_t":"The nzp-CSI-RS-ResourceId1-r17 represents the index of the NZP CSI-RS resource in Resource Group 1, and nzp-CSI-RS-ResourceId2-r17 represents the index of the NZP CSI-RS resource in Resource Group 2.","paragraph_zero_based":26790},{"literal_text_all_w_t_and_m_t":"pdc-Info","paragraph_zero_based":26791},{"literal_text_all_w_t_and_m_t":"Indicates that this NZP-CSI-RS-ResourceSet, if configured also with trs-Info, is used for propagation delay compensation. The field can be present only if trs-info is present. The field can be present in only one NZP-CSI-RS-ResourceSet. If network configures this field for an NZP-CSI-RS-ResourceSet, the UE measures the UE Rx-Tx time difference based on resources configured in this resource set. This field is not present in case NZP-CSI-RS-ResourcesSet is received as part of an LTM-Candidate IE.","paragraph_zero_based":26792},{"literal_text_all_w_t_and_m_t":"repetition","paragraph_zero_based":26793},{"literal_text_all_w_t_and_m_t":"Indicates whether repetition is on/off. If the field is set to off or if the field is absent, the UE may not assume that the NZP-CSI-RS resources within the resource set are transmitted with the same downlink spatial domain transmission filter (see TS 38.214 [19], clauses 5.2.2.3.1 and 5.1.6.1.2). It can only be configured for CSI-RS resource sets which are associated with CSI-ReportConfig with report of L1 RSRP, L1 SINR or \"no report\". This field is not present in case NZP-CSI-RS-ResourcesSet is received as part of an LTM-Candidate IE.","paragraph_zero_based":26794},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":26795},{"literal_text_all_w_t_and_m_t":"Time domain behavior of resource configuration (see TS 38.214 [19], clause 5.2.1.2).","paragraph_zero_based":26796},{"literal_text_all_w_t_and_m_t":"trs-Info","paragraph_zero_based":26797},{"literal_text_all_w_t_and_m_t":"Indicates that the antenna port for all NZP-CSI-RS resources in the CSI-RS resource set is same. If the field is absent or released the UE applies the value false (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":26798},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26799},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":26800},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":26801},{"literal_text_all_w_t_and_m_t":"LTM","paragraph_zero_based":26802},{"literal_text_all_w_t_and_m_t":"The field is optionally present in case NZP-CSI-RS-ResourcesSet is part of an LTM-Candidate IE. Otherwise, the field is absent, Need R.","paragraph_zero_based":26803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26804},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceSetId","paragraph_zero_based":26805},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceSetId is used to identify one NZP-CSI-RS-ResourceSet.","paragraph_zero_based":26806},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId information element","paragraph_zero_based":26807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2cff9bb11f705878a00cb9aa1969444275bd3c5ffe1a07fb882cede6ec4c6f1c","9f863c8ffbb56baec17d21a2c0a5333d39591e0d65a04efa4ea262bde522c6e5","69edbb35b3d1b79dcb1ba38b7654557a1733eeceb1394ebbe753fc81567bd0e0","9fdb02d39a23c19691177fa32342115eba7a0a2789af4113375401053061d9a6","f09a1884355aeaf5ab83e320e81ac1da6242ae5ab91a50d22221a69bd8f2019c","ae1d603f26734f195f4c0a2d64bbc75200937c5ed5231f9ad6012cc4b9d2cd86","b6337bd5f4bc6871ba95dba00d87d4109c7120e14a2d914b0c3089b8a3bdf679","faddd99d2ec1bc7c87ceae8960df3b321cfc3b2dc1e4aa51b4b6e626bcece84f","0b54191e5f99fd2f65353627616ac3170e4539e65b20979ed0a36b14bd647898","57aaf4f33d116e032229909324865e7f9c18179b74a1043a2492bb96c40050fb","d210e45693fecf75367e6b15a26867c9537992568cbc68b3b670cb9179b496a8","3cd530284b2a20ddf19898b2b01f3ffc4bad9a7b8bb0a476c23ca84f51e30ed4","cd3d21c2ddfb0b1d4a86996ca3dcee007ce411e7283d121219a4c8aedee27e7a","28f9722bf8b91eac5ded980095382714b4e580a4ea0011decfe48d15850180b3","3f3435ef147962b8811315bb4bd70b902d96f7f46c6a096fbd32f1c91b16adc2","dc7f70e07f4f9cebc2be8e23b4ca1b1f7a3c927794823cfe20c0970cf6d1b47a","526619fee99e8fe4207b4b8640bb6dd80ed414b0391b525d96360e61c3eb2d74","687af9283c2107296f06f0fb49e923cd2053725a4bce1013f9d39fca2c15b07c","d9be193715f11de7b8e7bdd6ff29f10543c20dcfa1d63bc25e9c9e6b41ce5cce","3705fda059ed9b1d0fb4a8849bb51109d8a1be00a376f0facec25893f26833ef","d0559c3d24dba39a5e14b276bc87d1de139e22ac7db778b7641e5dab88c4d148","6cdabb751d35026d7d265884a0731ba0208ef4bc8de562bc2d99d3695c644128","79e04f895eaae6a9abb15f0da82f28af8664c272869029808399177ee8748dbd","1fb82f0e9e4c9ec9334605ae69a598f7ae5708aed2bb11341fb403e559a077f5"],"paragraph_range_zero_based":[26784,26807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p26784"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26808},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-START","paragraph_zero_based":26809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26810},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceSetId ::=        INTEGER (0..maxNrofNZP-CSI-RS-ResourceSets-1)","paragraph_zero_based":26811},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26812},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCESETID-STOP","paragraph_zero_based":26813},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26814},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26815},{"literal_text_all_w_t_and_m_t":"–P-Max","paragraph_zero_based":26816},{"literal_text_all_w_t_and_m_t":"The IE P-Max is used to limit the UE's uplink transmission power on a carrier frequency, in TS 38.101-1 [15] and in TS 38.101-5 [75], and is used to calculate the parameter Pcompensation defined in TS 38.304 [20]. In ATG cell, actual value of P-Max = 9 + field value [dBm].","paragraph_zero_based":26817},{"literal_text_all_w_t_and_m_t":"P-Max information element","paragraph_zero_based":26818},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26819},{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-START","paragraph_zero_based":26820},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26821},{"literal_text_all_w_t_and_m_t":"P-Max ::=                           INTEGER (-30..33)","paragraph_zero_based":26822},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26823},{"literal_text_all_w_t_and_m_t":"-- TAG-P-MAX-STOP","paragraph_zero_based":26824},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26826},{"literal_text_all_w_t_and_m_t":"–PathlossReferenceRS","paragraph_zero_based":26827},{"literal_text_all_w_t_and_m_t":"The IE PathlossReferenceRS is used to configure a Reference Signal (e.g. a CSI-RS config or a SS block) to be used for path loss estimation for PUSCH, PUCCH and SRS for unified TCI state operation.","paragraph_zero_based":26828},{"literal_text_all_w_t_and_m_t":"PathlossReferenceRS information element","paragraph_zero_based":26829},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26830},{"literal_text_all_w_t_and_m_t":"-- TAG-PATHLOSSREFERENCERS-START","paragraph_zero_based":26831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["81863b48e186c85e738d5c0f594af5f2b367efc4fb4f811058ad355fa3727553","2cbaa0deba1317db90278caf00c441758c970845bb4e1616b0a1f6704521cc8a","8872134a3b7da8fb52c0dc462fab5d65057681dfafbd29c3900924d5ecd9e1e3","7d600d64df5dfb89fb620046222ce67de197091a6580c15b4755284b7b2250dc","0a306f0c5d908184ab3c95eaa90048471843629f242c0f3bdcac666c5388056f","af5d68e5e9265e646c362e0de91501c152a78593a0b7ba4b797d83e5d0930c57","e447a5e8981499bddee163d6322f2436b2944c9523c8b95f62a704e22debb5cd","b2a93fcfbafb8bff36af64f94aacfaddbed20fb38babc00dfb1acf75d1e7ee3b","9134cfeb260d293e5e9c0fbc2621b0f986cff37decf1569114cb50f51257ef25","a6604d64d8e108d498da224a0170308c3dd2eff33c2eca3af0a26088953f3aa4","3a7f90247f588a55c12d7e20f0dbabcb631f748622928a84c2c799041fcfb8ac","3e7deeb8df1ff00467af60981525c38b3ba783930e5ffa7ba8f4d217cf779a86","602b2b8b15cad7a35230a21823d9377573b476f4e15d03f4337add5cb890f960","bd167643b1220f6ca649c3de6e61ec078bae948dc1dbeb818c9122d50116978a","211bb43eab3baa28cefe2bafe5ecf5b89ccf1047faf1cf1f3785838dd4347811","df421743c2b9f25dc8b2c46175e26967ccc8a7