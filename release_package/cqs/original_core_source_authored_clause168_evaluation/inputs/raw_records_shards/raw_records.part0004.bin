{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MBS-FSAI-InterFreq-r17 ::= SEQUENCE {","paragraph_zero_based":17760},{"literal_text_all_w_t_and_m_t":"    dl-CarrierFreq-r17         ARFCN-ValueNR,","paragraph_zero_based":17761},{"literal_text_all_w_t_and_m_t":"    mbs-FSAI-List-r17          MBS-FSAI-List-r17","paragraph_zero_based":17762},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17764},{"literal_text_all_w_t_and_m_t":"MBS-FSAI-r17 ::= OCTET STRING (SIZE (3))","paragraph_zero_based":17765},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17766},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB21-STOP","paragraph_zero_based":17767},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17768},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17769},{"literal_text_all_w_t_and_m_t":"SIB21 field descriptions","paragraph_zero_based":17770},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-InterFreqList","paragraph_zero_based":17771},{"literal_text_all_w_t_and_m_t":"Contains a list of neighboring frequencies including additional bands, if any, that provide MBS services and the corresponding MBS FSAIs.","paragraph_zero_based":17772},{"literal_text_all_w_t_and_m_t":"mbs-FSAI-IntraFreq","paragraph_zero_based":17773},{"literal_text_all_w_t_and_m_t":"Contains the list of MBS FSAIs for the current frequency. For MBS service continuity, the UE shall use all MBS FSAIs listed in mbs-FSAI-IntraFreq to derive the MBS frequencies of interest.","paragraph_zero_based":17774},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17775},{"literal_text_all_w_t_and_m_t":"–SIB22","paragraph_zero_based":17776},{"literal_text_all_w_t_and_m_t":"SIB22 contains ATG assistance information for ATG access.","paragraph_zero_based":17777},{"li