{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    portIndex1                          NULL","paragraph_zero_based":21624},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21626},{"literal_text_all_w_t_and_m_t":"PortIndex8::=                       INTEGER (0..7)","paragraph_zero_based":21627},{"literal_text_all_w_t_and_m_t":"PortIndex4::=                       INTEGER (0..3)","paragraph_zero_based":21628},{"literal_text_all_w_t_and_m_t":"PortIndex2::=                       INTEGER (0..1)","paragraph_zero_based":21629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21630},{"literal_text_all_w_t_and_m_t":"TDCP-r18 ::=                        SEQUENCE {","paragraph_zero_based":21631},{"literal_text_all_w_t_and_m_t":"    delayDSetofLengthY-r18              SEQUENCE (SIZE (1.. maxNrofdelayD-r18)) OF DelayD,","paragraph_zero_based":21632},{"literal_text_all_w_t_and_m_t":"    phaseReporting-r18                  ENUMERATED {enable}                                                 OPTIONAL    -- Need R","paragraph_zero_based":21633},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21635},{"literal_text_all_w_t_and_m_t":"DelayD ::=                          ENUMERATED { symb4, slot1, slot2, slot3, slot4, slot5, slot6, slot10 }","paragraph_zero_based":21636},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21637},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIG-STOP","paragraph_zero_based":21638},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21639},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21640},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfig field descriptions","paragraph_zero_based":21641},{"literal_text_all_w_t_and_m_t":"carrier","paragraph_zero_based":21642},{"literal_text_all_w_t_and_m_t":"Indicates in which serving cell the CSI-ResourceConfig indicated below are to be found. If the field is absent, the resources are on the same serving cell as this report configuration.","paragraph_zero_based":21643},{"literal_text_all_w_t_and_m_t":"codebookConfig","paragraph_zero_based":21644},{"literal_text_all_w_t_and_m_t":"Codebook configuration for Type-1 or Type-2 including codebook subset restriction. Network can only configure one of codebookConfig, codebookConfig-r16 or codebookConfig-r17 or codebookConfig-r18 to a UE. The network includes codebookConfig-v1730 only if codebookConfig-r17 is configured.","paragraph_zero_based":21645},{"literal_text_all_w_t_and_m_t":"cqi-BitsPerSubband","paragraph_zero_based":21646},{"literal_text_all_w_t_and_m_t":"This field can only be present if cqi-FormatIndicator is set to subbandCQI. If the field is configured with bits4, the UE uses 4-bit sub-band CQI. If the field is not present and cqi-FormatIndicator is set to subbandCQI, the UE uses 2-bit sub-band differential CQI.","paragraph_zero_based":21647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["48b11ef1d8b0c567dd74f0f0a1ef83e89da8a2e738d76a4853a06789a8eb8995","cb83e99166dbce9cd4ff75ff54430acbe34e86599271bae676fe274c584e54bb","489ef8a18e01ccc2de54e3e1a90eb1a74eabd1e7543b235820ed04ff268805c8","be159ad4f04b8ce5609d540a6c3e4f8e7eeaefda9c4908346ae9a2498f56f088","9b4be0b06e11d3f0e57772f1a8215e6f367ef4ffce76aeca4edfcadf4aa03b2e","d05bcf365df4bb45a6d00249a13cc70258e6fba49a1cd05b99a12d775c8d957f","eb751d024a43c6380f02de376608183ba69f520ba78658f9abc4332b12fe7daa","f2e6e7343fc8663bd6861a54c4ca5861b5edfd6667360b9635879a49ff5f9478","8a059598bf78461534e1154813b47d1db6c2ae08928f6ed5b78e0f3460c89fd5","1779b735a24a0b043e072e94fd625e2679b07e233bb29e8da15cb20890c02512","812ee7be7d32431d5faaac34804cee82fe30bbd1c0fc13e2d6ed7dacaeb286dd","8cd07e6262acabc1a2ed097300e37f8ba3a1fbf179433c3de4982b91b0a0400e","0f31e17af9ca2a735c9e4296a3c61ceb2da6e69b96fb84ac6296fc7d97248beb","6f66186488eccf8f619c8b1ed6c7e5c9fe48f094735cf2d97f18acae49e251f5","df24627919feb83c0bf334cf5e09faca92055e64ea92e03d597115730dc82dbd","acc73136b1e4ab3cc18be87ec2f07be8c2a1f49068f4141bc2437a34f1066c72","548cebdfdd43e395ef90d35a555e07f749472493f8b61850f0dbc8d5fe729063","65cce0828bc6b91d216c4d0a52405516db63f55e286708fff317012b93b9cd5e","fdf78f1ed0b8efbe81321162995cc9beeb4d0789151d512e0250e23fc6ea9e00","c059a5946d449435b4a3656d83f8e07a792c3d0a7a7d90e4ca21f38b502fae00","fe3d177c3e12cdfa92155c34d94a6619a45b91308044e72106c19cd5c12d0003","e0e4a7a5a04754971790f5b6ec7d034cd2b56654a9e50285be659a1f3c2363e7","3c9e6c691c8b588667b649c9a4b779090b06f9da11644bbf31f84415d1aa2d83","5f41b5f2b1ab9dd4213cd7be1f67eff79102eb72061121756039e22c9190eec2"],"paragraph_range_zero_based":[21624,21647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21624"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cqi-FormatIndicator","paragraph_zero_based":21648},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) CQI (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":21649},{"literal_text_all_w_t_and_m_t":"cqi-Table","paragraph_zero_based":21650},{"literal_text_all_w_t_and_m_t":"Which CQI table to use for CQI calculation (see TS 38.214 [19], clause 5.2.2.1). For an (e)RedCap UE, CQI table 2 is only supported if the UE indicates support of 256QAM for PDSCH.","paragraph_zero_based":21651},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourcesForInterference","paragraph_zero_based":21652},{"literal_text_all_w_t_and_m_t":"CSI IM resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only CSI-IM resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":21653},{"literal_text_all_w_t_and_m_t":"csi-ReportingBand","paragraph_zero_based":21654},{"literal_text_all_w_t_and_m_t":"Indicates a contiguous or non-contiguous subset of subbands in the bandwidth part which CSI shall be reported for. Each bit in the bit-string represents one subband in order of frequency position in the BWP. The right-most bit in the bit string represents the lowest subband with the lowest frequency position in the BWP. The choice determines the number of subbands (subbands3 for 3 subbands, subbands4 for 4 subbands, and so on) (see TS 38.214 [19], clause 5.2.1.4). This field is absent if there are less than 24 PRBs (no sub band) and present otherwise (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":21655},{"literal_text_all_w_t_and_m_t":"NOTE:In TS 38.212 [17] clause 6.3.1.1.2 and TS 38.214 [19] clause 5.2.1.4, only subbands to be reported are numbered, e.g. subband #0 is the subband corresponding to the right-most bit set to 1.","paragraph_zero_based":21656},{"literal_text_all_w_t_and_m_t":"csi-ReportMode","paragraph_zero_based":21657},{"literal_text_all_w_t_and_m_t":"Configures the CSI report modes Mode1 or Mode 2 (see TS 38.214 [19], clause 5.2.1.4.2)","paragraph_zero_based":21658},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToAddModList","paragraph_zero_based":21659},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to add or modify. No simultaneous configuration of portSubsetIndicator and a list of nzp-CSI-RS-resources in a same CSI report sub-configuration. The number of elements in a list is at least 2.","paragraph_zero_based":21660},{"literal_text_all_w_t_and_m_t":"csi-ReportSubConfigToReleaseList","paragraph_zero_based":21661},{"literal_text_all_w_t_and_m_t":"List of CSI-ReportSubConfiguration(s) in a CSI report configuration to release.","paragraph_zero_based":21662},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":21663},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":21664},{"literal_text_all_w_t_and_m_t":"groupBasedBeamReporting","paragraph_zero_based":21665},{"literal_text_all_w_t_and_m_t":"Turning on/off group beam based reporting (see TS 38.214 [19], clause 5.2.1.4). If groupBasedBeamReporting (without suffix) is set to disabled, groupBasedBeamReporting-v1710 and groupBasedBeamReporting-v1800 is absent.","paragraph_zero_based":21666},{"literal_text_all_w_t_and_m_t":"non-PMI-PortIndication","paragraph_zero_based":21667},{"literal_text_all_w_t_and_m_t":"Port indication for RI/CQI calculation. For each CSI-RS resource in the linked ResourceConfig for channel measurement, a port indication for each rank R, indicating which R ports to use. Applicable only for non-PMI feedback (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":21668},{"literal_text_all_w_t_and_m_t":"The first entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the CSI-ResourceConfig whose CSI-ResourceConfigId is indicated in a CSI-MeasId together with the above CSI-ReportConfigId; the second entry in non-PMI-PortIndication corresponds to the NZP-CSI-RS-Resource indicated by the second entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig, and so on until the NZP-CSI-RS-Resource indicated by the last entry in nzp-CSI-RS-Resources in the in the NZP-CSI-RS-ResourceSet indicated in the first entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig. Then the next entry corresponds to the NZP-CSI-RS-Resource indicated by the first entry in nzp-CSI-RS-Resources in the NZP-CSI-RS-ResourceSet indicated in the second entry of nzp-CSI-RS-ResourceSetList of the same CSI-ResourceConfig and so on.","paragraph_zero_based":21669},{"literal_text_all_w_t_and_m_t":"nrofReportedGroups","paragraph_zero_based":21670},{"literal_text_all_w_t_and_m_t":"Number of reported resource groups per CSI-report. Value n1 means one resource group, n2 means 2 resource groups, and so on. If nrofReportedGroups is configured, the UE ignores groupBasedBeamReporting (without suffix).","paragraph_zero_based":21671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["279fa2129f7311a6beecedd15a650a068a73031108efd1a7470c1bfc6fcbe3da","b74dbed9b32487313a7b08040659d547fca72491bf322dd4913143fb390823ff","26d225c6d9b7c274c75333f975e08bbe252c52bf502427831e6d75105f63df15","0fccbabb34e74c7f6e35327232bb4fad1b2d1308c5e5792ba6511fc0dc214695","88c6eec82dea69af1d6d0a87364c4448617be3be45821610fb12f2c58205c65a","25a8209c8585bcc6097ce59d575600ace38ee3d5286342070f994d7686ad1ecd","8dd8c86976bd83590ad1fb186decffd05e74aebb88f9231e31f287cd5991fec3","ea638223f42ee5556f56bb8f39d148c8d76003546a4fc806f470d473c5a521df","1f5a7504783068a720f4a112f70498f9209d2833c4e41555d0af1c21982ae37e","2123759eb3f7b669f4451b4f31f73a6596adad5e22030bf884e5d3b9c41d3ad3","71d81a7ea28eaff7effb2336c2b05a1399df0587bf69ef600d22c585f05bbfbd","81a93cd636162b146c1e96e979c87b870035e68db000f1cd4d7946d92f0a8979","c21940dc296d679dceb09a13357b01e948317ffe3d28a50894b29c303c30d33b","8d620aea6841bad80319acffcd56893b2e7a32ad31946af1b7a747c0fceff3c5","62d169d6eea8a4cf954db3b0dccb593bf89a88a4b2a0b11acd9d849ce3ba578a","e382901253e6fa3ce6ae7f936b8f0a7a3a8e7fa32dda04748813021bf4807649","6c86cc7a441fa35ae36caf78fd6a426b7711e693aae216be606cf222bfce1cba","4496d0fcb16ab49ce01d5282e791915df1625b890081f6bb9654a89acb10a27d","58d56985ca26fd66f7a134f0a1e432c20166450486869f4a30dabbcb865f8389","cef5eda8043888cf488a618241ba8a51d9c71d303f2573c00eab95592cd13a23","7bb941b73e66af5a28a4a7a5f14b444f5ac1fda028f112e8ebe5d1c4ed4cba4d","8d5c86b73f3e9ee3ad35a2747c704907b7713c1ae78f68d600adf6ad5510d1e7","f714587659d35573448f67aaba619cde754160ccf2559ff04fe19a9fc60cca29","ad2aa4a4725a07c093bd5b0c9d7415a8196c9097ddde6dc1464d68e0c8468481"],"paragraph_range_zero_based":[21648,21671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21648"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nrofReportedRS","paragraph_zero_based":21672},{"literal_text_all_w_t_and_m_t":"The number (N) of measured RS resources to be reported per report setting in a non-group-based report. N <= N_max, where N_max is either 2 or 4 depending on UE capability.","paragraph_zero_based":21673},{"literal_text_all_w_t_and_m_t":"(see TS 38.214 [19], clause 5.2.1.4) When the field is absent the UE applies the value 1.","paragraph_zero_based":21674},{"literal_text_all_w_t_and_m_t":"numberOfSingleTRP-CSI-Mode1","paragraph_zero_based":21675},{"literal_text_all_w_t_and_m_t":"Configures the number of reported X CSIs when csi-ReportMode is set to 'Mode 1' as described in TS 38.214 [19], clause 5.2.1.4.2. The field is present only if csi-ReportMode configures Mode 1.","paragraph_zero_based":21676},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourcesForInterference","paragraph_zero_based":21677},{"literal_text_all_w_t_and_m_t":"NZP CSI RS resources for interference measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources. The bwp-Id in that CSI-ResourceConfig is the same value as the bwp-Id in the CSI-ResourceConfig indicated by resourcesForChannelMeasurement.","paragraph_zero_based":21678},{"literal_text_all_w_t_and_m_t":"p0alpha","paragraph_zero_based":21679},{"literal_text_all_w_t_and_m_t":"Index of the p0-alpha set determining the power control for this CSI report transmission (see TS 38.214 [19], clause 6.2.1.2).","paragraph_zero_based":21680},{"literal_text_all_w_t_and_m_t":"pdsch-BundleSizeForCSI","paragraph_zero_based":21681},{"literal_text_all_w_t_and_m_t":"PRB bundling size to assume for CQI calculation when reportQuantity is CRI/RI/i1/CQI. If the field is absent, the UE assumes that no PRB bundling is applied (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":21682},{"literal_text_all_w_t_and_m_t":"pmi-FormatIndicator","paragraph_zero_based":21683},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report a single (wideband) or multiple (subband) PMI. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":21684},{"literal_text_all_w_t_and_m_t":"pucch-CSI-ResourceList","paragraph_zero_based":21685},{"literal_text_all_w_t_and_m_t":"Indicates which PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":21686},{"literal_text_all_w_t_and_m_t":"reportConfigType","paragraph_zero_based":21687},{"literal_text_all_w_t_and_m_t":"Time domain behavior of reporting configuration.","paragraph_zero_based":21688},{"literal_text_all_w_t_and_m_t":"reportFreqConfiguration","paragraph_zero_based":21689},{"literal_text_all_w_t_and_m_t":"Reporting configuration in the frequency domain. (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":21690},{"literal_text_all_w_t_and_m_t":"reportQuantity","paragraph_zero_based":21691},{"literal_text_all_w_t_and_m_t":"The CSI related quantities to report. see TS 38.214 [19], clause 5.2.1. If the field reportQuantity-r16, reportQuantity-r17 or reportQuantity-r18 is present, UE shall ignore reportQuantity (without suffix). Network does not configure reportQuantity-r17 or reportQuantity-r18 together with reportQuantity-r16.","paragraph_zero_based":21692},{"literal_text_all_w_t_and_m_t":"reportingMode","paragraph_zero_based":21693},{"literal_text_all_w_t_and_m_t":"Configures the UE with reporting mode for group based reporting.(see TS 38.214 [19] clause 5.2.1.4).","paragraph_zero_based":21694},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":21695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b1c06c159ef2c08c0b7574b5cfecadea63c9c368539e07e466b971648e7cf532","f86cfaf81bd5f63ecf20b1c343a19ae1f88274b667a9d6f394a0158409136a91","e7a65bd2794bd58c591bf23055f857815adba8821b23d420b60e140979f1499e","1aa839b9bda60d1bd006eadf4ded0c53e47127ec60061d87d2540ffd4d25b7ef","ec2a0dcd75aee61f70e98991c7eb5c1c905b77381f7912956c7fdcaa79565d9b","fce7298a4a59a16e12c1d26bb05f9fd4a89d929afddf33183bd401a912bb12c9","fecf6aa6e5ba68d85f10a8abe97396e18258811f8fc69756cd27442ce9688adc","577f347a60a5543b8820c2f6e7ce9aedc9de25c8b5b5a92bc361d448ec27afc7","4fa20c1e86941884e444afe1753ec0a09b77ef4380c0f8af0c020e7490f2c350","e15ebfbfe1b9c983f285484e5dfface4dfa015b11ef2857ea8254b7165bf1ee3","7d4555fa3e59b28767f81dee378d8d0daea82a86c954d1027286d4234aa8a8bf","68d547effb4221980eee96c101abaa9d2ca486e7dee8428b132d8cf946818437","18116ab35b01cd8fa00d4b31ee42fd4ac82d23761c4be67f2e70bcb067168ff0","8dc2b2a895d92b56b7e4261f1282019e432c2f358ec5b8a0b7e1801d737b9812","0550ae56ae168e4016b4795ae7f0d22bf558d2a95b1dad46e0ceace6294fac4e","9e9a594321f6ec15952b7034c8164f1e8087b2523c42371952662acff9c7a5e5","8882c34237d0997238a5cf10d5e37205185303946b76da05869a247978ffbab6","299081f9f77bc0757cb2d9f991051125101268ab96837f7ff6faadd8d0234e22","e049224e89e86664f04d0abadfd854cee5e1661d438536d1babe54ab1c8abc4d","23f409c456a02a53f35a889a17eccbb8f532a0438990c5b029fc94b84192a5a2","5fa6bc280b6733672743cefbb8a57bf9e26b3c75a7f877336ad59fea15228402","c639ae4f2027f3588d8f9c4cf3f187afc8b036f9c780869a331b3c725f0a08dd","3c291a0927894256b63dd8e11168a9165a99eac38cfd486f3559bab8f15b2016","ff6d32a210d155e1835d181ca721f7cac9b34132ada09c172b484def12c2699e"],"paragraph_range_zero_based":[21672,21695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21672"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4). If the field reportSlotConfig-v1530 is present, the UE shall ignore the value provided in reportSlotConfig (without suffix).","paragraph_zero_based":21696},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":21697},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on. The first report is transmitted in slot n+Y, second report in n+Y+P, where P is the configured periodicity.","paragraph_zero_based":21698},{"literal_text_all_w_t_and_m_t":"Timing offset Y for aperiodic reporting using PUSCH. This field lists the allowed offset values. This list must have the same number of entries as the pusch-TimeDomainAllocationList in PUSCH-Config. A particular value is indicated in DCI. The network indicates in the DCI field of the UL grant, which of the configured report slot offsets the UE shall apply. The DCI value 0 corresponds to the first report slot offset in this list, the DCI value 1 corresponds to the second report slot offset in this list, and so on (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":21699},{"literal_text_all_w_t_and_m_t":"The field reportSlotOffsetListDCI-0-1 applies to DCI format 0_1 and the field reportSlotOffsetListDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":21700},{"literal_text_all_w_t_and_m_t":"The fields reportSlotOffsetList-r17, reportSlotOffsetListDCI-0-1-r17 and reportSlotOffsetListDCI-0-2-r17 are only applicable for SCS 480 kHz and 960 kHz and if they are configured, the UE shall ignore the fields reportSlotOffsetList (without suffix), reportSlotOffsetListDCI-0-1 (without suffix) and reportSlotOffsetListDCI-0-2 (without suffix) for SCS 480 kHz and 960 kHz.","paragraph_zero_based":21701},{"literal_text_all_w_t_and_m_t":"resourcesForChannelMeasurement","paragraph_zero_based":21702},{"literal_text_all_w_t_and_m_t":"Resources for channel measurement. csi-ResourceConfigId of a CSI-ResourceConfig included in the configuration of the serving cell indicated with the field \"carrier\" above. The CSI-ResourceConfig indicated here contains only NZP-CSI-RS resources and/or SSB resources. This CSI-ReportConfig is associated with the DL BWP indicated by bwp-Id in that CSI-ResourceConfig.","paragraph_zero_based":21703},{"literal_text_all_w_t_and_m_t":"sharedCMR","paragraph_zero_based":21704},{"literal_text_all_w_t_and_m_t":"Enables sharing of channel measurement resources between different CSI measurement hypotheses when (1) csi-ReportMode is set to 'Mode1' and numberOfSingleTRP-CSI-Mode1 is set to 1 or 2; or (2) csi-ReportMode is set to 'Mode2' (see TS 38.214 [19], clause 5.2.1.4.2).","paragraph_zero_based":21705},{"literal_text_all_w_t_and_m_t":"subbandSize","paragraph_zero_based":21706},{"literal_text_all_w_t_and_m_t":"Indicates one out of two possible BWP-dependent values for the subband size as indicated in TS 38.214 [19], table 5.2.1.4-2 . If csi-ReportingBand is absent, the UE shall ignore this field.","paragraph_zero_based":21707},{"literal_text_all_w_t_and_m_t":"timeRestrictionForChannelMeasurements","paragraph_zero_based":21708},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for the channel (signal) measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":21709},{"literal_text_all_w_t_and_m_t":"timeRestrictionForInterferenceMeasurements","paragraph_zero_based":21710},{"literal_text_all_w_t_and_m_t":"Time domain measurement restriction for interference measurements (see TS 38.214 [19], clause 5.2.1.1).","paragraph_zero_based":21711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21712},{"literal_text_all_w_t_and_m_t":"PortIndexFor8Ranks field descriptions","paragraph_zero_based":21713},{"literal_text_all_w_t_and_m_t":"portIndex8","paragraph_zero_based":21714},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 8. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":21715},{"literal_text_all_w_t_and_m_t":"portIndex4","paragraph_zero_based":21716},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 4. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":21717},{"literal_text_all_w_t_and_m_t":"portIndex2","paragraph_zero_based":21718},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for up to rank 2. If present, the network configures port indexes for at least one of the ranks.","paragraph_zero_based":21719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["aa46dbbf24981d94020acdb6e90a18671d715a08590126c6fae904cc4e2ddc5c","1a3334920bd6f10cdfcefc75de9ad6f0c41aa9732b62dc3ed3377246554bf930","b677d0272ca98fc17e897c7ffc4197f057a69b40ba17953f27bc1e23d52220ec","249b1db3ee0c22d37b462fdd5cc61cad6b10a3bda46c1c71af66921fd24172fc","48b9302db36eaee02e57c3d17f68f0f80fe0636c14efa96df0cfbe12090cff1e","57f29f13fdb51e3b1107fd7b6a0965b02ea0b5065ff56031fc3344bd2699749f","02a03be3f31907a8961ee8d5b9ac94aada82ce3117670dd743ee97bece461c15","0f1a28d8b31db9dfea6aa515bbba3e08642b48d5e0d3430ce91735c8634e1d0d","b3426d20c9d5c316f53c43900acd1bfc773a32bbfee5dbba89e6f849138c8c68","51831e57b05e7d06756482f65fd0f487db4d067722fa5990ab57f49ef295a62c","ab6d675914912582a28768597bc39ad56cf67eef826121823aee1283303b71d2","2b692f8a2043ed9b0f9e76a77894e9f20d0e43e4782eb70b019b8adc7b907a2c","0c5460233cb07d5333927a481f83bbe7d359e719eb5cce0cf10076e9e79259d4","bbc8045ce8182b7bbd43dd3787a32b79c09f10465b69dc07710d457106a805ea","c7731eaa5334050b680584bfcf758538ad9806d72b170dbdc43b0368bf50955e","ff105327ab5a86c7d0c00239e0b83b03674547776926b4cf3fa3718fa6350d28","0b3ed57541a3e1071b9d13d4a9d564888abca91df63a181ee1db12cc3aedd954","ad47d8b7ebdcf16664c046100492aba0d8f0ef35a0611c15a7e645d214313445","d17df0c85a1f27ad0969ed56417140f8cfd33aa53d58c43faf06cb31be82998c","2f33287536c47f33c66bb7248fca0a5ca2c028046aec110f9003c2aba9caf1bc","908aacb871e4d740a304797c99940f7bdfd2435c7ebb3f39ecb23a8687a839c5","5c8cbe1ca97e6820dd0ac80c32ec9881fa8dc48d29ea7a3eb24a834c870d67b0","769acacd476faf48af578a9724243903453ffd66035f28f0ddffffdd53e4ff53","0861847a8081968a962c4d5334de93c1b671c156d476ea86430baac70b9f6545"],"paragraph_range_zero_based":[21696,21719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21696"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"portIndex1","paragraph_zero_based":21720},{"literal_text_all_w_t_and_m_t":"Port-Index configuration for rank 1.","paragraph_zero_based":21721},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21722},{"literal_text_all_w_t_and_m_t":"TDCP field descriptions","paragraph_zero_based":21723},{"literal_text_all_w_t_and_m_t":"delayDSetofLengthY","paragraph_zero_based":21724},{"literal_text_all_w_t_and_m_t":"Configures a set of Y delay values for TDCP reporting, see reference TS 38.214 clause 5.2.1.4. The symb4 denotes 4 symbols, the slot1 denotes 1 slot, the slot2 denotes 2 slots and so on. The value slot10 is applicable only to SCS >=30kHz. The parameter Y, see reference TS38.214 clause 5.2.1.4, is given by the length of the set of D values.","paragraph_zero_based":21725},{"literal_text_all_w_t_and_m_t":"phaseReporting","paragraph_zero_based":21726},{"literal_text_all_w_t_and_m_t":"Configures the UE for phase reporting for TDCP reporting see reference TS 38.214 clause 5.2.1.4","paragraph_zero_based":21727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21728},{"literal_text_all_w_t_and_m_t":"–CSI-ReportConfigId","paragraph_zero_based":21729},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportConfigId is used to identify one CSI-ReportConfig.","paragraph_zero_based":21730},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId information element","paragraph_zero_based":21731},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21732},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-START","paragraph_zero_based":21733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21734},{"literal_text_all_w_t_and_m_t":"CSI-ReportConfigId ::=              INTEGER (0..maxNrofCSI-ReportConfigurations-1)","paragraph_zero_based":21735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21736},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTCONFIGID-STOP","paragraph_zero_based":21737},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21739},{"literal_text_all_w_t_and_m_t":"–CSI-ReportSubConfig","paragraph_zero_based":21740},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportSubConfig is used to configure parameters in one sub-configuration within a CSI report configuration.","paragraph_zero_based":21741},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfig information element","paragraph_zero_based":21742},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6a710b2477f339a05baa52cd650c379436be766c9ba3614b9e33d9121fc13bda","f1153f9673dec7cf9230eff5e221b64cd1cf1d09766244b43da312e27e071e12","e8df7713dbb1c08b8c23ad0a19574bed8c889f25a7bb96b6d38769c60554f82b","bc9518b44b6c83d7966a9cc26ee58b01fca4fb2d8828fb81bdb201b755ddcd28","2c6312e9581dc215f618c83bbe81f32ee52a059c4dd0c6680d959badfe202a58","61042a1badb5c6965173421d180e523cef81a6c32dcad194c5c1510e888acd28","7cc4bb423ceb1fd45e96c20ed713cf3df65891b6ed16dcbc2cae53377ba4d0ab","7350c87d8f4764dac29f6a2f882da4deeb5db889063406c7a0f5648f4725a950","91b0fdfd75976f7a595eb889ee00e645604970c46f6ba887e7eba0f1e7a30326","4c710ba950b283bf0bc8a20d105c6bd2fea6d5178c786069f970eb64a317e35f","cd996a13fef4a42e82314feb7d920e6b49d358ced96cee78c73817a559d3cdfd","c14d7f074dd308ad9920af340307970b85e665dfe9ad38ed7f4c2a96ffaf1ee6","3b1980df26c596fed2d3e02cefc3bba24aabbd8bf439cd3bb88bc7dce75c9f3d","71186ccf36d39d9056a81ff6