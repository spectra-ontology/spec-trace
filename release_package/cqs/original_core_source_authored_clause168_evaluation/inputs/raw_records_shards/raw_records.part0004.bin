{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45648},{"literal_text_all_w_t_and_m_t":"-- TAG-VISITEDCELLINFOLIST-STOP","paragraph_zero_based":45649},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45651},{"literal_text_all_w_t_and_m_t":"VisitedCellInfoList field descriptions","paragraph_zero_based":45652},{"literal_text_all_w_t_and_m_t":"timeSpent","paragraph_zero_based":45653},{"literal_text_all_w_t_and_m_t":"This field indicates the duration of stay in the cell or in any cell selection state and/or camped on any cell state in NR or E-UTRA approximated to the closest second. If included in VisitedPSCellInfo, it indicates the duration of stay in the PSCell or without any PSCell. If the duration of stay exceeds 4095s, the UE shall set it to 4095s.","paragraph_zero_based":45654},{"literal_text_all_w_t_and_m_t":"visitedCellId","paragraph_zero_based":45655},{"literal_text_all_w_t_and_m_t":"This field indicates the visited cell id including NR and E-UTRA cells.","paragraph_zero_based":45656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45657},{"literal_text_all_w_t_and_m_t":"–WLAN-NameList","paragraph_zero_based":45658},{"literal_text_all_w_t_and_m_t":"The IE WLAN-NameList is used to indicate the names of the WLAN AP for which the UE is configured to measure.","paragraph_zero_based":45659},{"literal_text_all_w_t_and_m_t":"WLAN-NameList information element","paragraph_zero_based":45660},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45661},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-START","paragraph_zero_based":45662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45663},{"literal_text_all_w_t_and_m_t":"WLAN-NameList-r16 ::= SEQUENCE (SIZE (1..maxWLAN-Name-r16)) OF WLAN-Name-r16","paragraph_zero_based":45664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45665},{"literal_text_all_w_t_and_m_t":"WLAN-Name-r16 ::= OCTET STRING (SIZE (1..32))","paragraph_zero_based":45666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45667},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45668},{"literal_text_all_w_t_and_m_t":"-- TAG-WLANNAMELIST-STOP","paragraph_zero_based":45669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45670},{"literal_text_all_w_t_and_m_t":"WLAN-NameList field descriptions","paragraph_zero_based":45671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f0c5d3ca5f474797ededa98c81c3d0dd1b136e68cae4af0b691ef13c803729ec","97f72a354df81afab19a4f677f0769411fed4e89f591ca4faaf5510259052f8a","3d233af0b8826a90eacf2698cc95ad53c7790d96dd8023a1aebc0fa17ae7b397","f6f7566622b0083361d2bef75bb3b743180c5caba234720a3545e4651de113e0","cf2d41a0af688e7b33707e65a2f3e592d71f887796b96942d9442cfcc7ff34ba","e29eb612495a42c70fdc84f3959a4c9a702b2417bb1a28f0fe593871dce91152","912a76d0f8342a06a75a185e9f43f19aac0fd4f0d9255d21a6963b7897a4ce63","e139927de9316657ece8791f7b6aa1486871e1c6b3c9184c7462fd5522333683","d3d9f27033383783807a6c1a62bfdd64087c52e7c6cb917efce0091db5e3a683","5ecfedbefc6026f75a1006b9d2370d6420c8d4b614b7224eeab10cdf14c4740c","7a43258041a65478faddf74b6fda906ca516a3d990cff981767b8c4f5f14a6f0","23e0c03a18ff7fea0a4773fd1051414f83a52a8b432906ee0ada60a3acc4b015","de1e4aeeacd9eb3b61ebe2e87832ac7c660317abfb4f2733380ebd1e29b20bba","5c87e071a55da5e5d6b51e2d5bb1cfffd14226aed53c7422811f82e20b1f9892","412070e7dc8603f54e4fd4a27c04c7fe196ef3cac760486fc0b2459e6a686629","2b68c8dd924