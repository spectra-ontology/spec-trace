{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"qfi-ToReportUL-TrafficInfoList","paragraph_zero_based":45432},{"literal_text_all_w_t_and_m_t":"A list of QFIs of a PDU session for which the UE shall report UL traffic information.","paragraph_zero_based":45433},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":45434},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":45435},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":45436},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":45437},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":45438},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":45439},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":45440},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":45441},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":45442},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":45443},{"literal_text_all_w_t_and_m_t":"scg-DeactivationPreferenceConfig","paragraph_zero_based":45444},{"literal_text_all_w_t_and_m_t":"Configuration of the UE to indicate its preference for SCG deactivation.","paragraph_zero_based":45445},{"literal_text_all_w_t_and_m_t":"scg -StatePreferenceProhibitTimer","paragraph_zero_based":45446},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UE indication of its preference for SCG deactivation. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45447},{"literal_text_all_w_t_and_m_t":"sensorNameList","paragraph_zero_based":45448},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific sensors. NG-RAN configures the field if includeSensor-Meas is configured for one or more measurements.","paragraph_zero_based":45449},{"literal_text_all_w_t_and_m_t":"sl-AssistanceConfigNR","paragraph_zero_based":45450},{"literal_text_all_w_t_and_m_t":"Indicate whether UE is configured to provide configured grant assistance information for NR sidelink communication.","paragraph_zero_based":45451},{"literal_text_all_w_t_and_m_t":"sn-InitiatedPSCellChange","paragraph_zero_based":45452},{"literal_text_all_w_t_and_m_t":"This field indicates whether the PSCell change procedure included in the RRCReconfiguration message is SN initiated or not.","paragraph_zero_based":45453},{"literal_text_all_w_t_and_m_t":"sourceDAPS-FailureReporting","paragraph_zero_based":45454},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall generate the SHR upon successfully completing the DAPS handover to the target cell and if a radio link failure was experienced in the source PCell while executing the DAPS handover. This field is set in the otherConfig configured by the source cell of the DAPS handover.","paragraph_zero_based":45455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6268c8daf619357f6487fabb81fed7963c4bc17c214e182ad18ddf1a45f58c1f","95f5bfd79c0307c3b53e9a9cdf91a9d93c75220c71309d2dfec35ab950cfc785","806e7fe2189aa62807ae8142c2896af1028fec67657dd596fc08f892e0e1ba3f","c371b617e9900dacc7db1e78fda82702332ae211674221347beb441bf07bf00c","d714f10a392043b6fa1a18ecdeea4cbd76e6696125f86063bc1df31c6ad776c6","4a6e6d64e32bf0e0419b2484fd49470f53c353a40b60270fae11cf4934f1356d","1e9fb8a399fd9e8afaf8676249c10512924243b95de4858d845e5d56336fe6ae","bc3e27e9b741c9abdb86ab5072c0e1aa99d6396468b17a38a4fd4a44918289d1","0c99be42cb047f5781b96579090528de33735dd8132a6d604a992f601589d0ad","91ce6efaab861bcc75f62afe27c48556f0cbc994947398e20f7791c731d04a1a","87d9d589ef70cc2ff9870bb9aa33f54c20e448130391d3b0aaa5cb1d85b51d55","09fd5f41e1c32c0da74543d36d2a4d9ce03edb3dfc1205709bd1a5afaa2ec0e1","a5cad1d86b09a6aed738955dcead8684395ba98a187915d4fd9b5ea204b3de2f","d0ade6e66fa13f314ba3c169771f4c7742635a730df36f5f3b04df76a8013116","0c033eedc7adf5d9dc7355eb81557b0f187b3ea9ff264eda710ebc5dd6b67fd0","447972a8cde611a7fb4452ba34ecfe2f31110210e39d35d22fbb7368ef17cb5c","625bc03daf04a48c406009ec7effc31c4f7263bd93e9e4b7ece4d438a7b51b83","ea11b7f57cc497f8fdc1e6f19dc3b74c806ee3cbf24e666570965d45fc632d51","0df50cff8019d1c5795e3d7a0ef09542247f87809e77a58ee17e408f34d6be1c","4d5fda5c3ceaa0c42c3c35e22bfc839d72bd067a15ee6f8ad71e4a9b0e5e2dd1","525cda68feb3877b31e89d31bc94befa014419f8902a7ece1c4e3ef14621c337","1e7783b3e3c3ed855bb0c0dfdcce018be4fd389ba819d53650ce4d60091fed63","31335cedd1ceac3e8b74db523174995e68d7026421055c13e401e82ecdb614fe","f29f6b686f40f6c4c503601625ae6c38292c1c7361b4c88d7ca0b81c199bba40"],"paragraph_range_zero_based":[45432,45455],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p45432"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"successHO-Config","paragraph_zero_based":45456},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful handover information to the network.","paragraph_zero_based":45457},{"literal_text_all_w_t_and_m_t":"successPSCell-Config","paragraph_zero_based":45458},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the successful PSCell change or addition information to the network. When this field is configured in CG-Config, the thresholdPercentageT304-SCG is absent.","paragraph_zero_based":45459},{"literal_text_all_w_t_and_m_t":"t-SearchDeltaP-Stationary","paragraph_zero_based":45460},{"literal_text_all_w_t_and_m_t":"Parameter \"TSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value in seconds. Value s5 means 5 seconds, value s10 means 10 seconds and so on.","paragraph_zero_based":45461},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304","paragraph_zero_based":45462},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target cell of the handover.","paragraph_zero_based":45463},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310","paragraph_zero_based":45464},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":45465},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312","paragraph_zero_based":45466},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer and the configured value(s) of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source cell of the handover.","paragraph_zero_based":45467},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT304-SCG","paragraph_zero_based":45468},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T304 timer associated to the target PSCell and the configured value of the T304 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the target PSCell of the PSCell change or addition.","paragraph_zero_based":45469},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT310-SCG","paragraph_zero_based":45470},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T310 timer associated to the source PSCell and the configured value of the T310 timer. Value p40 corresponds to 40%, value p60 corresponds to 60% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change, or in the otherConfig configured by the PCell for the PSCell change.","paragraph_zero_based":45471},{"literal_text_all_w_t_and_m_t":"thresholdPercentageT312-SCG","paragraph_zero_based":45472},{"literal_text_all_w_t_and_m_t":"This field indicates the threshold for the ratio in percentage between the elapsed T312 timer associated to the measurement identity of the target PSCell and the configured value of the T312 timer. Value p20 corresponds to 20%, value p40 corresponds to 40% and so on. This field is set in the otherConfig configured by the source PSCell of the PSCell change, or in the otherConfig configured by the PCell for the PSCell change.","paragraph_zero_based":45473},{"literal_text_all_w_t_and_m_t":"threshPropDelayDiff","paragraph_zero_based":45474},{"literal_text_all_w_t_and_m_t":"Threshold for one-way service link propagation delay difference report as specified in 5.7.4.2.","paragraph_zero_based":45475},{"literal_text_all_w_t_and_m_t":"ul-GapFR2-PreferenceConfig","paragraph_zero_based":45476},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is configured to request for FR2 UL gap activation/deactivation and preferred FR2 UL gap pattern.","paragraph_zero_based":45477},{"literal_text_all_w_t_and_m_t":"wlanNameList","paragraph_zero_based":45478},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurements from specific WLAN APs. NG-RAN configures the field if includeWLAN-Meas is configured for one or more measurements.","paragraph_zero_based":45479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ad53401df36bbca93ba3f36c1ecd280e33696bb74ab999cbca9d01c18c0075b1","d1693a6008cc2475bd4dfcdf7197d91a32e5f640cca31f0880e82d36bee4eb39","086da8ec7e3b3ca252f8cc4019863985ac24b5c8a87232d3b2b7c136bd156a7b","da228e9d2d0afa9c9cb49971600a314fc5016e8ffaf28bdfe475daf9da65f858","b9a87b31475fec43a818ec512257bc196ce79beca73ff0ceba61d0f7ee1e3614","303466c6a647845dfe4a3bb9a954788d006a4612b58e92a1812ae5556508b750","f42ca13f73bef823c36330496a125aa1f27851ecc5b98803adb851b4225da33e","79aa64726c2e86ccd87b8ab776481099e0bf30123f2644ed34d3906adc1bbb79","c888608dad94122c4b163355063a740a6328783559df7d00fc368d343fea14df","c81878b786bd0ddf6f77c0d6134107aff9e0e1b792a3f3da07ccb70596591eb0","fdecbc1e808c40b8030d4094c4aff5a6952a584cda78d01f018cef5d551729d3","c0e1fae86199a1d443631898f971e2058d03af633b56e585e9bc33a2113a3188","17c6f5037f4cb7237ac95a009f85de1547c016948afb87b74b0ade990400c45a","ed3615fca2b677fb791538decaa52119d09eeffdaa265658a6616608815388f7","043c29c4b21a8a67d7c93e54c73b3295b8060d719e87277239f27277e55d9d1a","c159ea70bc21d6d73793aafc610aff4b3b74cd8aa8bcc54aa161b290d7528f54","27cac77680ebdaca7d75413ac279e3073dc5a669d74bfc36bfc61bc9efc1c4bc","2fe5aefbb2dbb3a0a3a3fc4411fe0d58e60e217fa5abeca48d5276c98024b8a0","67412daee986216900ab3aa7d504c8556020109a70fc11b132bb656d3c8df340","de59fa00028db2376b6cadd89b9a225d08db9222493cee00320f22706e3c2b36","847d929f1b13010ea591b04e9a467936f2acaa0aeb6648595a9a7d1d70a0c9b6","d8d6bb0e16e03edb96a1296d6a9b98bdaca49c82990ccf33b1540999b45180fb","7c0cbf0f59ad841ce87ae8845c5a29d7c9327d4053ba580fadf1b94432998283","611e8994c0ff845b80ec7e82b5765648c4e5df9b74356bb1877b63467fb941e8"],"paragraph_range_zero_based":[45456,45479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p45456"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoProhibitTimer","paragraph_zero_based":45480},{"literal_text_all_w_t_and_m_t":"Prohibit timer for UL traffic information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45481},{"literal_text_all_w_t_and_m_t":"ul-TrafficInfoReportingConfig","paragraph_zero_based":45482},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report UL traffic information.","paragraph_zero_based":45483},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45484},{"literal_text_all_w_t_and_m_t":"NeighbourCellInfo field descriptions","paragraph_zero_based":45485},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":45486},{"literal_text_all_w_t_and_m_t":"Indicates the epoch time used along with the ephemerisInfo to derive the propagation delay difference for the associated neighbour cell. The UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is used based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell.","paragraph_zero_based":45487},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45488},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45489},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45490},{"literal_text_all_w_t_and_m_t":"FDM","paragraph_zero_based":45491},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, if idc-AssistanceConfig-r16 or idc-FDM-AssistanceConfig is setup. Otherwise, it is absent, need R.","paragraph_zero_based":45492},{"literal_text_all_w_t_and_m_t":"maxBW","paragraph_zero_based":45493},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxBW-PreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":45494},{"literal_text_all_w_t_and_m_t":"maxMIMO","paragraph_zero_based":45495},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if maxMIMO-LayerPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":45496},{"literal_text_all_w_t_and_m_t":"minOffset","paragraph_zero_based":45497},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if minSchedulingOffsetPreferenceConfig-r16 is setup; otherwise it is absent, need R.","paragraph_zero_based":45498},{"literal_text_all_w_t_and_m_t":"musimGapConfig","paragraph_zero_based":45499},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need R, if musim-GapAssistanceConfig-r17 is configured; otherwise it is absent, need R.","paragraph_zero_based":45500},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":45501},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message not within mrdc-SecondaryCellGroup and received, either via SRB3 within DLInformationTransferMRDC or via SRB1. Otherwise, it is absent.","paragraph_zero_based":45502},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b99da2a5718433e3e46c8b164ed65af642b29894941b926072f0671f276fe089","84058f359e03b0aa446e844197d1c512cb5ed111d7f6979324fb37b