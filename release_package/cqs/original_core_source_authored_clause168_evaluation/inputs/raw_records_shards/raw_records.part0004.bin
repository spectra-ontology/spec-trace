       OPTIONAL,   -- Cond UL","paragraph_zero_based":23628},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":23629},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":23630},{"literal_text_all_w_t_and_m_t":"    channelAccessPriority-r16           INTEGER (1..4)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":23631},{"literal_text_all_w_t_and_m_t":"    bitRateMultiplier-r16               ENUMERATED {x40, x70, x100, x200}                                   OPTIONAL    -- Need R","paragraph_zero_based":23632},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":23633},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23635},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":23636},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23638},{"literal_text_all_w_t_and_m_t":"LogicalChannelConfig field descriptions","paragraph_zero_based":23639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8d3f2a5b75d84fa0b78a47c082cc6e5cef13a52a65e0aa4933eae227f8e1630c","bd5e6b7781db42d63219c76538ebcacd114080ccd0da74d929e0241d1ba4cbf6","b0b3ece5b58ca562e7cc1aa8c86da030fd12c28039ef7351e66da51b7ee3b668","0dfa43d29f6e7f00f96df0460c42e487ee9339d804d8175a2f4251d4f120a034","50a97a1f8265076c0bd16863a24a2a7b0b570815a2dc2a2e4e73dbb67dbe5ca2","a3f573e0da478ea7ace766f5b492c21323b1d2cce8d583d7b2628533e817e16b","02ac1d1bb4c244768319c87b02d1b19ac8432a90418d8b9ab73427c8ce0a1b94","3138970ce2c42f6906cc8f3efa92ffc8f5e7de38634e3af42c25e8fd8f9dc0f8","89269c940c92e8e1d0f2e840d0bf34b4c5dfd1cdf2cf95402d713f10a1fd0e8a","9ee48da8ecf199a9ae5090658233d178a5f5fa5fc02638b583d432d899f08bab","0e78a3b5ae830d9bbed8031db985f70620b504d970849a9a21343314973b7e7b","18d164b6cb7a078cabe9ea3b92ad04cf8c99d3b7245ee7acf239f3b7b77c8af5","c1b21f7287e73c6c02676a91c47ed4d8f27361af596cff47a79c7e3af07e4372","a97fd93946a4379ef857add12447a93d6d0b558157b1348044656bcac097ca1b","d814477e110812b5d8ba8e0cc4753134d178b390383221fe2f5160d5cb867f73","72ef23dac4ee0436e3d7355a1190f1a5aaec435c2b70bf7620fe1d02355418e0","954021a9e5fe6882a4d7bd22a795373ca7339da7661fdf88197651cab65c9a5a","bca1a56e452ca9acf52dbc9cd4493168cad476f830444b9acfdd0c906eb584f9","1549657916afef420b7fa0d77bf977466e0e5197a1519d9f93f4f55b0ee26ba4","076a7ed4b2c3af8fa8cb1b21fba8464bcc3534d5bad6b9ae0dab8c68372b28c8","f1fc221bb1fe4ca90067cc3797caa66dcbe210a222bfe159fcf76938f877fbcd","382baf2ddfbf53099b33b12962035ed8375d15a9cf900596e3f6a6e579a4179d","02004ac7f7946b2371a6d6b1c83f9163052cd93990632564d2c9c389d7344e6b","e4b776aee8c4d838c7e406c2e87d03f30c3181f49d79a1471def2c179f818d22"],"paragraph_range_zero_based":[23616,23639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23616"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"allowedCG-List","paragraph_zero_based":23640},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a configured grant. If present, UL MAC SDUs from this logical channel can only be mapped to the indicated configured grant configuration. If the size of the sequence is zero, then UL MAC SDUs from this logical channel cannot be mapped to any configured grant configurations. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any configured grant configurations. If the field configuredGrantType1Allowed is present, only those configured grant type 1 configuration indicated in this sequence are allowed for use by this logical channel; otherwise, this sequence shall not include any configured grant type 1 configuration. Corresponds to \"allowedCG-List\" as specified in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":23641},{"literal_text_all_w_t_and_m_t":"allowedHARQ-mode","paragraph_zero_based":23642},{"literal_text_all_w_t_and_m_t":"Indicates the allowed HARQ mode of a HARQ process mapped to this logical channel. If the parameter is absent, there is no restriction for HARQ mode for the mapping. This field applies to SRB1, SRB2, SRB4 and DRBs.","paragraph_zero_based":23643},{"literal_text_all_w_t_and_m_t":"allowedPHY-PriorityIndex","paragraph_zero_based":23644},{"literal_text_all_w_t_and_m_t":"This restriction applies only when the UL grant is a dynamic grant. If the field is present and the dynamic grant has a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to the dynamic grants indicating PHY-priority index equal to the values configured by this field. If the field is present and the dynamic grant does not have a PHY-priority index, UL MAC SDUs from this logical channel can only be mapped to this dynamic grant if the value of the field is p0, see TS 38.213 [13], clause 9. If the field is not present, UL MAC SDUs from this logical channel can be mapped to any dynamic grants. Corresponds to \"allowedPHY-PriorityIndex\" as specified in TS 38.321 [3].","paragraph_zero_based":23645},{"literal_text_all_w_t_and_m_t":"allowedSCS-List","paragraph_zero_based":23646},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the indicated numerology. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured numerology. Corresponds to 'allowedSCS-List' as specified in TS 38.321 [3].","paragraph_zero_based":23647},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":23648},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":23649},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":23650},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":23651},{"literal_text_all_w_t_and_m_t":"allowedServingCells","paragraph_zero_based":23652},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be mapped to the serving cells indicated in this list. Otherwise, UL MAC SDUs from this logical channel can be mapped to any configured serving cell of this cell group. Corresponds to 'allowedServingCells' in TS 38.321 [3].","paragraph_zero_based":23653},{"literal_text_all_w_t_and_m_t":"bitRateMultiplier","paragraph_zero_based":23654},{"literal_text_all_w_t_and_m_t":"Bit rate multiplier for recommended bit rate MAC CE as specified in TS 38.321 [3]. Value x40 indicates bit rate multiplier 40, value x70 indicates bit rate multiplier 70 and so on.","paragraph_zero_based":23655},{"literal_text_all_w_t_and_m_t":"bitRateQueryProhibitTimer","paragraph_zero_based":23656},{"literal_text_all_w_t_and_m_t":"The timer is used for bit rate recommendation query in TS 38.321 [3], in seconds. Value s0 means 0 s, s0dot4 means 0.4 s and so on.","paragraph_zero_based":23657},{"literal_text_all_w_t_and_m_t":"bucketSizeDuration","paragraph_zero_based":23658},{"literal_text_all_w_t_and_m_t":"Value in ms. ms5 corresponds to 5 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":23659},{"literal_text_all_w_t_and_m_t":"channelAccessPriority","paragraph_zero_based":23660},{"literal_text_all_w_t_and_m_t":"Indicates the Channel Access Priority Class (CAPC), as specified in TS 38.300 [2], to be used on uplink transmissions for operation with shared spectrum channel access in FR1. The network configures this field only for SRB2 and DRBs.","paragraph_zero_based":23661},{"literal_text_all_w_t_and_m_t":"configuredGrantType1Allowed","paragraph_zero_based":23662},{"literal_text_all_w_t_and_m_t":"If present, or if the capability lcp-Restriction as specified in TS 38.306 [26] is not supported, UL MAC SDUs from this logical channel can be transmitted on a configured grant type 1. Otherwise, UL MAC SDUs from this logical channel cannot be transmitted on a configured grant type 1. Corresponds to 'configuredGrantType1Allowed' in TS 38.321 [3]. This field is ignored when SDT procedure is ongoing.","paragraph_zero_based":23663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["585805a6719df97afb8d8deccb610254d4c263d611c434115722376b5aa490f8","69670132c67af37a0c379abda291220196de9aa042ae42b023bb2d47f275684f","7aee8699b1b63b126b3ae02456e5d118aa36c25137a1933e85fe3282de63e908","d9c2d78a7ff7807b7946ff596049bb35b008f66acc1b68997418881f25aa1013","3d1dba9c035ab313994408310140338315a5aad52948a79349efd16ce854c007","f0234fb43b337a0d05ff1f6ad5827d6ea89a69ced815830aff841fe34aff4056","ac968b226f435969bbae84f9740f440e47401dc92f9e2b38e1ed79e043750e25","5df3cf877f6efc3b55d608d6523a8a4bf1e93a171cd9ff142c681137cba2530a","83b7bd66af19aba7cf23bebf406693736bf68ca0e082cc12a8e01e3da10d3022","9e0236686d4fa94467d65ab97ef4fbcc1ffcd5cca3d79bcf0f81b32977a0fcd2","c3d6f2aa42f1d0cf5f54036de3889367402364dcad1257b8a8d8406152f90575","1313ccd88b3f8c878aa65078a5431f256fe892f2f39b81a1de5a2341626a66f0","c8192997a404730dc90bf86bbc40bfa24d16fe080635e75a2be5603193d13f4b","6978fed2085c842d003e7f1a414c68e55c921cdab2ef53d1d4d3f2b2567ea287","6e75c68c5d4921e2a670ad2c0df067ea8de40464c48232816001ce8002a4330c","27a42d8864cc6a62eba0f557cc869276b5fbd8a1ed7cd435ecfdc11debeb238b","a519ad637022abb4ec6787b70b44fbf5584f9aa655df80727f434681b1ae4e46","3d181863a253de1112c06799d65b74b84e9f432d591a4c38427d220e21e2be0f","702c5a989c5356f98e35a4879f0a9cd09a4545cd411bb30f82884db98ef45d4e","4f557ea7aa46ed4baf3e0c5e0ed3c4459bf87266df075a2eea4c1c6f668281f9","22408de5adcb2529063635c9e6ecad7768a9ce103b7a2a13dd614dee9d96c471","0b4863fcd551e0df7b392794aa9be619bc74497ffd9044059f9f2f6e3e30ed48","290f09cb4b6c932ea2362ebcf296c5355b1e6d80c03e8bbe0045294b64581a8f","955c04fbaccc0cfbb1db37ffc776a6ea56b68abd64f90bb7ef63ad48531bd550"],"paragraph_range_zero_based":[23640,23663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23640"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"logicalChannelGroup, logicalChannelGroupIAB-Ext","paragraph_zero_based":23664},{"literal_text_all_w_t_and_m_t":"ID of the logical channel group, as specified in TS 38.321 [3], which the logical channel belongs to. The logicalChannelGroupIAB-Ext is only applicable to the IAB-MT. When logicalChannelGroupIAB-Ext is configured, logicalChannelGroup shall be ignored.","paragraph_zero_based":23665},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-Mask","paragraph_zero_based":23666},{"literal_text_all_w_t_and_m_t":"Controls SR triggering when a configured uplink grant of type1 or type2 is configured. true indicates that SR masking is configured for this logical channel as specified in TS 38.321 [3].","paragraph_zero_based":23667},{"literal_text_all_w_t_and_m_t":"logicalChannelSR-DelayTimerApplied","paragraph_zero_based":23668},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the delay timer for SR transmission for this logical channel. Set to false if logicalChannelSR-DelayTimer is not included in BSR-Config.","paragraph_zero_based":23669},{"literal_text_all_w_t_and_m_t":"maxPUSCH-Duration","paragraph_zero_based":23670},{"literal_text_all_w_t_and_m_t":"If present, UL MAC SDUs from this logical channel can only be transmitted using uplink grants that result in a PUSCH duration shorter than or equal to the duration indicated by this field. Otherwise, UL MAC SDUs from this logical channel can be transmitted using an uplink grant resulting in any PUSCH duration. Corresponds to \"maxPUSCH-Duration\" in TS 38.321 [3]. The PUSCH duration is calculated based on the same length of all symbols, and the shortest length applies if the symbol lengths are different.","paragraph_zero_based":23671},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":23672},{"literal_text_all_w_t_and_m_t":"Logical channel priority, as specified in TS 38.321 [3].","paragraph_zero_based":23673},{"literal_text_all_w_t_and_m_t":"prioritisedBitRate","paragraph_zero_based":23674},{"literal_text_all_w_t_and_m_t":"Value in kiloBytes/s. Value kBps0 corresponds to 0 kiloBytes/s, value kBps8 corresponds to 8 kiloBytes/s, value kBps16 corresponds to 16 kiloBytes/s, and so on. For SRBs, the value can only be set to infinity.","paragraph_zero_based":23675},{"literal_text_all_w_t_and_m_t":"schedulingRequestId","paragraph_zero_based":23676},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for this logical channel, as specified in TS 38.321 [3].","paragraph_zero_based":23677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23678},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23679},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23680},{"literal_text_all_w_t_and_m_t":"PDCP-CADuplication","paragraph_zero_based":23681},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the DRB/SRB associated with this logical channel is configured with PDCP CA duplication in UL in the cell group in which this IE is included (i.e. the PDCP entity is associated with multiple RLC entities belonging to this cell group). Otherwise the field is optionally present, need R.","paragraph_zero_based":23682},{"literal_text_all_w_t_and_m_t":"UL","paragraph_zero_based":23683},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for a logical channel with uplink if it serves DRB or multicast MRB. It is optionally present, Need R, for a logical channel with uplink if it serves an SRB. Otherwise it is absent.","paragraph_zero_based":23684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23685},{"literal_text_all_w_t_and_m_t":"–LogicalChannelIdentity","paragraph_zero_based":23686},{"literal_text_all_w_t_and_m_t":"The IE LogicalChannelIdentity is used to identify one logical channel (LogicalChannelConfig) and the corresponding RLC bearer (RLC-BearerConfig) or BH RLC channel (BH-RLC-ChannelConfig) or Uu Relay RLC channel (Uu-RelayRLC-ChannelConfig) or PC5 Relay RLC channel (SL-RLC-ChannelConfigPC5).","paragraph_zero_based":23687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8d24b61e411ddda0ba728cfec16d1bbfe62cdb1dbdf09c6dbad4a21191651031","28ebdf91dbb690b32c2996974e78cdda86195cd352389b00382997f18958ef0c","186ef505ec28313d9cd07ff4f4adb46b13d27f92fa0b1f83edeba090856a1c57","5bdb69fa9c32c6db7dce506dd84fbd08683c7c87b635cf10d42b57d0f6d24007","aaeb759df591a80751c7ba33651d4ad3696633c0d6933d27a0fc214aacf4be48","4c7b914628baa1aadc90df8882d87e732775761666787ffccf88799e280dca16","f3aa1da3ccd1e5f4c705ed8140dd9121273eb649dd915c26897c30f807036154","1282cf9d84feae329cbccf88bf140e2a567d5c97f5af801fe1bcf8fa553d38df","699c6c2c89c13d203d629c9e35cfb79f97765cffbe6b29ff511abe07ed5eb4e5","a5743a81fda6994d9e23a084ed518308530eec5c52482fdb9bfc7141747cd77e","e79f31aeb1bc16cf5f86042ecb7249d6e2599ffde26655412731d7a217a33f86","bd6f62a3b894cc5c21006225efb50165f35ebe55dcb40d87600e6e1082f99834","18f286340c9c663544596de2c7b0b8b866e9f0466a3bfeb2e0efbe25189b6b10","b788201e054eb25e4cf4cf6ab5dc259cdf76ca9e639d6280b445898a1772a60b","ebbc7811bbf2145f6806b5daba1b2aa887b968f4a3c6b6cbe5aa4a0fce42646d","f08554bc71a47fa75a018b043259c20bdaf69ac145e2e4367550c7e8b67b2182","548959f4f6051eb601210ff88e69eaa81ba606afcffe03a30c736bcdd5837b0b","a9dc429ee4576ca63cffb64d461f81193e3381698a42563329366ae5812c31e7","3bf7891d42c0f0c6c75075b3063b62f78659f2b24d1996d194775df5f149e3a9","ae9e05a4f3965c7882480c620cb01e9bf437a1abb06583b54bc8630601808a6f","3f5238201b3db153e1e3f1e9f84718cef2ca8dd43dcc4d2de1b47b6f42babe44","f8baa4d606180c285109369a7af8a052c326da87633e45cf5932074bd7b2d998","508004645704d340ec09dac8cc56fe3cf86b24ff310218d1b13c09cf166d1b14","c0c3832b207eac47062d97a274b450c191e00dbd84ce71c153a0f06fe6bd55ec"],"paragraph_range_zero_based":[23664,23687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23664"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity information element","paragraph_zero_based":23688},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23689},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-START","paragraph_zero_based":23690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23691},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentity ::=          INTEGER (1..maxLC-ID)","paragraph_zero_based":23692},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23693},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGICALCHANNELIDENTITY-STOP","paragraph_zero_based":23694},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23695},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23696},{"literal_text_all_w_t_and_m_t":"–LTE-NeighCellsCRS-AssistInfoList","paragraph_zero_based":23697},{"literal_text_all_w_t_and_m_t":"The IE LTE-NeighCellsCRS-AssistInfoList-r17 is used to provide configuration information of neighbour LTE cells to assist the UE to perform CRS interference mitigation (CRS-IM) in scenarios with overlapping spectrum for LTE and NR.","paragraph_zero_based":23698},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList information element","paragraph_zero_based":23699},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23700},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-START","paragraph_zero_based":23701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23702},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfoList-r17 ::= SEQUENCE (SIZE (1..maxNrofCRS-IM-InterfCell-r17)) OF LTE-NeighCellsCRS-AssistInfo-r17","paragraph_zero_based":23703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23704},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo-r17 ::=     SEQUENCE {","paragraph_zero_based":23705},{"literal_text_all_w_t_and_m_t":"    neighCarrierBandwidthDL-r17              ENUMERATED {n6, n15, n25, n50, n75, n100, spare2, spare1}   OPTIONAL,   -- Cond CRS-IM","paragraph_zero_based":23706},{"literal_text_all_w_t_and_m_t":"    neighCarrierFreqDL-r17                   INTEGER (0..16383)                                          OPTIONAL,   -- Need S","paragraph_zero_based":23707},{"literal_text_all_w_t_and_m_t":"    neighCellId-r17                          EUTRA-PhysCellId                                            OPTIONAL,   -- Need S","paragraph_zero_based":23708},{"literal_text_all_w_t_and_m_t":"    neighCRS-muting-r17                      ENUMERATED {enabled}                                        OPTIONAL,   -- Need R","paragraph_zero_based":23709},{"literal_text_all_w_t_and_m_t":"    neighMBSFN-SubframeConfigList-r17        EUTRA-MBSFN-SubframeConfigList                              OPTIONAL,   -- Need S","paragraph_zero_based":23710},{"literal_text_all_w_t_and_m_t":"    neighNrofCRS-Ports-r17                   ENUMERATED {n1, n2, n4}                                     OPTIONAL,   -- Need S","paragraph_zero_based":23711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["71baf71c455aeb4e4f3cb9f4b66b0157edae3fe22b1379dd8e53fff221236359","1f1bfb111bcff99a8f952982e27bfbb80a60ebd5edc151cd8e6c2bf99f34ec5b","2cf6fd173756a77f8bf646f3472e7071e020a7affa65a8178344b3464294be90","861898cbe498c0d9bb9a6684487cbda65a234a054e82437b750d0dd72aa69e5b","ee9d2157ddbbf4ddc798c81314f66345decaa527e74da4ce8cdacedcd006df45","28b8d8ab494907e4126fb9df36fc68a4852a78846ca26515832e7cc2893f8db2","0e8f100d12de2da1edd38ec3d005db3b7cce4f0886aa09f170b9df419bbdf2fa","cf91f04004a6d97668fc0e57cbc29b177a49b6b86c86abad9d11c35288776b46","9df7329996496f5184c4c498176df7c35fb2abb63d5fd4069b8b78c9296dafdb","e87dbabb5bdfd0da69a618f1a4c4816061fa2595391ecee4b2f3d171dadb0036","f27424e42fd0e9182cf846aa6806c8431b85fc8031134dd65d3631fc1b802306","fe174cc35eadd0aa35bb872240d7009a5ce109a14b444e51691a2d522e1c6cc5","37f373ca5c31de1e67b5050f69e6b15b7f332597014f9fa041e551dcd0314377","9c1705c80deedc24fab3912a645a5901e65ae5959c08f88786aca3c634e4e39f","65eb6b804abdac25607c30aa1478e575ece5157be8b1f49e7e35cd6e61594344","bfccd973cdab8800ec127b87fc6e2dc9611ff62baab13ddc8c9df990f915761c","c1491472e25a0e01417fb7b838b66bd6430feb369c8fb30d2e0589cff62686a8","e9c5f8213317e16896fbdb3db8669688db434090e5cf7407724d003ea26809b9","1be85474927a5c8a8551abc87d25f2972f478693e728a722ad0d7bd63eb610ab","3b716cedfe2f65ea5456e8b05ccf0fa3bc60f6741972c879096efb1100fca182","8ebb92489a252b6e3831eb8dc7cc3104afc78336dfd37c07d0acd72f70b07ed0","2a31fbef67ee894617251f5f829c6886be138a099c5bae548a316a7184f52498","3c45302eb7adf0c84a9f9b7c72224ca65913277a5b4b447d43bf58e8f0ab2503","6ffdd019122fabc5f44ca7a93f3c5be385a596896726bd6f94af9ea164363208"],"paragraph_range_zero_based":[23688,23711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23688"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    neighV-Shift-r17                         ENUMERATED {n0, n1, n2, n3, n4, n5}                         OPTIONAL    -- Cond NotCellID","paragraph_zero_based":23712},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23713},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23714},{"literal_text_all_w_t_and_m_t":"-- TAG-LTE-NEIGHCELLSCRS-ASSISTINFOLIST-STOP","paragraph_zero_based":23715},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23716},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23717},{"literal_text_all_w_t_and_m_t":"LTE-NeighCellsCRS-AssistInfo field descriptions","paragraph_zero_based":23718},{"literal_text_all_w_t_and_m_t":"neighCarrierBandwidthDL","paragraph_zero_based":23719},{"literal_text_all_w_t_and_m_t":"Indicates the channel bandwidth of the neighbour LTE cell in number of PRBs. If the field is absent, the UE applies the value of carrierBandwidthDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":23720},{"literal_text_all_w_t_and_m_t":"neighCarrierFreqDL","paragraph_zero_based":23721},{"literal_text_all_w_t_and_m_t":"Indicates the downlink centre frequency of the neighbour LTE cell. If the field is absent, the UE applies the value of carrierFreqDL indicated in RateMatchPatternLTE-CRS for this serving cell, if configured.","paragraph_zero_based":23722},{"literal_text_all_w_t_and_m_t":"neighCellId","paragraph_zero_based":23723},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell ID of the neighbour LTE cell for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":23724},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, either this field or neighV-Shift is included in each instance.","paragraph_zero_based":23725},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries, the entry with neighV-Shift is only used for neighbour LTE cells for which neighCellId is not provided (i.e. the entry with neighCellId takes precedence over the entry with neighV-Shift, if provided).","paragraph_zero_based":23726},{"literal_text_all_w_t_and_m_t":"If the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry with neither this field nor neighV-Shift, the information within the entry applies to all neighbour LTE cells.","paragraph_zero_based":23727},{"literal_text_all_w_t_and_m_t":"neighCRS-muting","paragraph_zero_based":23728},{"literal_text_all_w_t_and_m_t":"Indicates whether the CRS interference mitigation is enabled in the neighbour LTE cell, as specified in TS 36.133 [40], clause 3.6.1.1.","paragraph_zero_based":23729},{"literal_text_all_w_t_and_m_t":"neighMBSFN-SubframeConfigList","paragraph_zero_based":23730},{"literal_text_all_w_t_and_m_t":"Indicates the MBSFN subframe configuration of the neighbour LTE cell. If RateMatchPatternLTE-CRS is configured for this serving cell and the field is absent, the UE applies the value of mbsfn-SubframeConfigList indicated in RateMatchPatternLTE-CRS for this serving cell if configured; otherwise, if the field is absent, the UE assumes MBSFN is not configured in the neighbour LTE cell.","paragraph_zero_based":23731},{"literal_text_all_w_t_and_m_t":"neighNrofCRS-Ports","paragraph_zero_based":23732},{"literal_text_all_w_t_and_m_t":"Indicates the CRS antenna ports number of the neighbour LTE cell. If the field is absent, the UE applies the value of nrofCRS-Ports indicated in RateMatchPatternLTE-CRS for this serving cell, if configured. If RateMatchPatternLTE-CRS is not configured for this serving cell and the field is absent, the UE applies the default value n4.","paragraph_zero_based":23733},{"literal_text_all_w_t_and_m_t":"neighV-Shift","paragraph_zero_based":23734},{"literal_text_all_w_t_and_m_t":"Indicates the shifting value v-shift of neighbour LTE cells for which the other fields within the same LTE-NeighCellsCRS-AssistInfo apply.","paragraph_zero_based":23735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["863f6e8d95ee6b0fe76f54d460024e8f2c5b2ee84f2db0816ee2a3b8f4ac2cb5","f76823d091d98ab62048d2854a2512cf958a2aad278f2df9dc8516039581efb4","51d8873918ee10161f4451b3b28a1fd8e0b8e42ee56a3c39bed37e26d50db954","4f7f1565a054d874746d19b92df89e98ba0c215ad2af7ec8e57b626393eb0da3","d36595d601fe7bd767d280437400ffd36a2a4130356fea73477fdabe1ee6a211","8ec4a5b76c896f9fe961dd78efaa95cbe1982734d9b0b0559230842e7f0eca76","a665f5ea4200a40d96a334a7e2cc3a560a2fde0d589fb71fd01370d4c3d270ba","238a6f40c415ca2077b2ccafc33b3d9374eae49be828627adbd6a78152dd0266","a5f9eb73e42188e3e0fa2cb12ce4e8e8a0370980672e7f8430c0847b401b8ba9","306fb5db9aba5c292b88a56174bc2b7c7733dcb595a7c59c2fb3d1d6dc6df775","9c6302c031ad17b47336ce9a8a61a972e21c26c7dbefbe451a596f5c259c3fbf","b4820ed35ab79fcb4f21ff5e267f33cf39c61effee43764bf9cba2d9a1cf0ffd","2f05d7d9a551213afb330f8ab69e68d98847a793b4c06d51b23f75c172ac5bde","f84ef97c1bc9e0713476270d5c4d5c762586fe9c48732231b4d1cf2c4117f85e","b30b0c722d8132edd49d500c32da2b87017714621046f0bd9a0e1ddfb17c8374","1362cb01a1777a004382d1f5ad54a6b09841309d6fd59c881b88618a92cbd404","5382e4a7a5fbe5f8bcb7952160ff2cf5677506e09e32d21d55b11fbd55e794fb","c2c4f2440ddb1f590ee8e6fe4fe32964e3050cda4798919e02b62a6f7fb605c2","07608e83fd6184d943d8ee6242a375915e05d31236ac56d0b84af047e7b8de9c","27cba2b0a5413b50f04d08477d1b07bf6acb27e66a4ec34d9da872c9cb8c96d0","8267dcbb371dd88293613cb0de01ec3349e9d515cf3d910a86c456102f4ee