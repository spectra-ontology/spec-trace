{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29232},{"literal_text_all_w_t_and_m_t":"SDM-Scheme-r18   ::=        SEQUENCE {","paragraph_zero_based":29233},{"literal_text_all_w_t_and_m_t":"    maxRankSDM-r18              INTEGER (1..2)                                                        OPTIONAL,    -- Need R","paragraph_zero_based":29234},{"literal_text_all_w_t_and_m_t":"    maxRankSDM-DCI-0-2-r18      INTEGER (1..2)                                                        OPTIONAL     -- Need R","paragraph_zero_based":29235},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29238},{"literal_text_all_w_t_and_m_t":"SFN-Scheme-r18   ::=        SEQUENCE {","paragraph_zero_based":29239},{"literal_text_all_w_t_and_m_t":"    maxRankSFN-r18              INTEGER (1..2)                                                        OPTIONAL,    -- Need R","paragraph_zero_based":29240},{"literal_text_all_w_t_and_m_t":"    maxRankSFN-DCI-0-2-r18      INTEGER (1..2)                                                        OPTIONAL     -- Need R","paragraph_zero_based":29241},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29244},{"literal_text_all_w_t_and_m_t":"CodebookTypeUL-r18 ::=      CHOICE {","paragraph_zero_based":29245},{"literal_text_all_w_t_and_m_t":"    codebook1-r18               ENUMERATED {ng1n4n1, ng1n2n2},","paragraph_zero_based":29246},{"literal_text_all_w_t_and_m_t":"    codebook2-r18               ENUMERATED {ng2},","paragraph_zero_based":29247},{"literal_text_all_w_t_and_m_t":"    codebook3-r18               ENUMERATED {ng4},","paragraph_zero_based":29248},{"literal_text_all_w_t_and_m_t":"    codebook4-r18               ENUMERATED {ng8}","paragraph_zero_based":29249},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29251},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigDCI-0-3-r18 ::=                   SEQUENCE {","paragraph_zero_based":29252},{"literal_text_all_w_t_and_m_t":"    resourceAllocationDCI-0-3-r18                 ENUMERATED {resourceAllocationType0, resourceAllocationType1, dynamicSwitch}","paragraph_zero_based":29253},{"literal_text_all_w_t_and_m_t":"                                                                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":29254},{"literal_text_all_w_t_and_m_t":"    rbg-SizeDCI-0-3-r18                           ENUMERATED {config2, config3}                                  OPTIONAL,   -- Need S","paragraph_zero_based":29255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["65f6b81937ac15546af43adc0c92a5c6d9dcb5056679346ed9f85de8570488c2","a9114f8f3bb504984860bc9834f4ea9c9a9b8e65bb96c6614ddce01c7bde310a","8ba38543406092cef47d057b819daa5fdea5e7304f4c03849adc84a121c145d8","c2f32e7be8d80f0303b384f8f94c09aea8652dc03926b121f65a62d0584c3c95","50aeb3648c87ec1015586c6bdb9259282d406c380003d19dd8c24ce5b35f9f40","c79c559c746760faec3d1e856d8a41af5d150010d6032370e12633300fa5d27a","b440df6422550a9db36dc60c44fdce5600206288ed3878e8e3aabdf155ce773f","5c714e828d042ebfb7fb29083bdeaf6e31722493a1cf6303f2abf41774f31c72","b3a8ef3e6e45277607ffd7fe0ab8b943883c4c2eb4f85e3ee9550f04b55c6386","fdcd75e76a77b2f3765041277160852feca4d26d2de2d2feba69e963bc37281e","1b4dc548eec40ec2d577700485bddf866b4fe6f68860eb60492416e57084c148","3a7ec4edf11a9150240649894a5bc4a403bdd27792d6541b0a258b83400602e0","7cd203c128b419c216e857cc32d6f3e37d7f358087ec223b90a36d901e226b01","25d46d8185101aaeb6db5d3a1d88efa87be689c003c5791b95bf0c24b5e0687b","d38388506efadfaebd69377f835ae9102f44b878cfbf34138b061cfec6c59c15","2067f83a3c1b28c7b3f6b4322ae7fc32af237d51f1c0bb3423917485b7d7efda","c0e29e1dcbfb31653049ccac0bd524f3f346427e7b6260d3a7ce94f9d54c8d26","aeb7596f919b9afd12d1a77cdce694b3e1bf1c40a2a140a483bcd0da83b3dfad","e6d4be1c7bd795470df29834515a12bef475be2efd9470b3e58eacd378b56bcc","549c44521b6a22e55a3d546c3f6e38415d720105f22ea352a2f05ec8355cc7c6","5ddae3223929c3d6b788cf236499ee25d58c97e5c49f9602d81a073f09a417c3","022c330aa592979820cb95c5fac66724f715c7f80cf2226733f43cf83f9ff5b3","be20f7aa41822f6709f0dbe2d0650145fed08f7d4d6abdd15778e160e2764df4","d6f3e4c1448ac1dd7c3f816b079154ea2507f9c09bcf8e51d0c1c8e0be2b0d10"],"paragraph_range_zero_based":[29232,29255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29232"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    resourceAllocationType1GranularityDCI-0-3-r18 ENUMERATED {n2,n4,n8,n16}                                      OPTIONAL,   -- Need S","paragraph_zero_based":29256},{"literal_text_all_w_t_and_m_t":"    numberOfBitsForRV-DCI-0-3-r18                 INTEGER (0..2)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":29257},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-0-3-r18             INTEGER (0..5)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":29258},{"literal_text_all_w_t_and_m_t":"    uci-OnPUSCH-ListDCI-0-3-r18                   SetupRelease { UCI-OnPUSCH-ListDCI-0-1-r16  }                  OPTIONAL    -- Need M","paragraph_zero_based":29259},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29260},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29261},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-STOP","paragraph_zero_based":29262},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29264},{"literal_text_all_w_t_and_m_t":"PUSCH-Config field descriptions","paragraph_zero_based":29265},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-0-2","paragraph_zero_based":29266},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 0_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 0_2. Otherwise, the field size is set to 0 for DCI format 0_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 nor dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 is configured, this field is absent.","paragraph_zero_based":29267},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":29268},{"literal_text_all_w_t_and_m_t":"This field indicates, for a PUSCH transmission, if UE applies the first or the second \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 6.2.1.","paragraph_zero_based":29269},{"literal_text_all_w_t_and_m_t":"availableSlotCounting","paragraph_zero_based":29270},{"literal_text_all_w_t_and_m_t":"Indicate whether PUSCH repetitions counted on the basis of available slots is enabled. If the field is absent, PUSCH repetitions counted on the basis of available slots is disabled.","paragraph_zero_based":29271},{"literal_text_all_w_t_and_m_t":"betaOffsetsCrossPri0, betaOffsetsCrossPri1, betaOffsetsCrossPri0DCI-0-2, betaOffsetsCrossPri1DCI-0-2","paragraph_zero_based":29272},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for multiplexing HARQ-ACK on dynamically scheduled PUSCH with different priorities, see TS 38.213 [13], clause 9.3.","paragraph_zero_based":29273},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0 indicates multiplexing low priority (LP) HARQ-ACK on dynamically scheduled high priority (HP) PUSCH.","paragraph_zero_based":29274},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH.","paragraph_zero_based":29275},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0DCI-0-2 indicates multiplexing LP HARQ-ACK on dynamically scheduled HP PUSCH by DCI format 0_2.","paragraph_zero_based":29276},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1DCI-0-2 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH by DCI format 0_2.","paragraph_zero_based":29277},{"literal_text_all_w_t_and_m_t":"codebookSubset, codebookSubsetDCI-0-2","paragraph_zero_based":29278},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TPMI, where PMIs are those supported by UEs with maximum coherence capabilities (see TS 38.214 [19], clause 6.1.1.1). The field codebookSubset applies to DCI format 0_1 and the field codebookSubsetDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1).","paragraph_zero_based":29279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["760cab712eb26a865e172b77b9fc4bfb8b8e911e6cfe279329fad746e9258c84","d8b32e92842bcdf1c8572d1d5d443b45f075e1669c830db71c9980e0a4bf055e","8e9d70d5556b046aa5a643adc93643bd09d76a47dc7a6f27ca7d115f42eb7399","d0d5a1cc4074007d6b819eb5e063db9d4345529074f5981ba0fbc96aa3b6de84","620a3c0a7466ced622b00b4b6c184797b523c83c969a529c6a5c83e22ea2a449","118efcf72a6371aaee03083bcf296c6e8a835cceb17d90c300b61b14d1daa2d4","dffd72778d33a44ddc0100cf87ff7fee76cb760918e7010aa8b3475ae918c1e5","14adeb583819bd0180d6286ceeb45fa11ec1d93d659d745704470ba20f6107db","381a34c303d94ab405f89496972fbb75de3ee2b58fb424d0782f8f33e63f8975","2723f6752ef327942e83666aadb59af465294368199ac00584bdb4f3f31db2d4","5aca93d101d0b3e6487dd725a93fd12a3cdac23b957f166615c62f6c6f7d4bd7","aaf30357820ca5550988caf1f98e34026c6d26dfc01d8a8e03b8200eae776402","434bf4cae7eef539c3eb561cac39c14ee7e183b6fe2a1adb7c8a2564469431f2","445026e77ed4ee2561a195ffcc57955be4e5c41239a3e2b8ef72be0118928f13","bc22ce04255d14472662a71c0350b2b7cff3b95fc5468f4342ebd936b9220797","85f3959abe40ba39c0b0c6017883a4b400eff3fd10d5033fa8cba8d220970817","cca585bbe22e0ed88bd7980ebda908ac5f05d79848e973c80223b542e9b1416f","678f07bbbbf5a726feb9f7c76a26300b3199e3ca180970a27217ffa4a5159611","12cbc6de400af05a9e990604428a8e0202a72f0ec13cd02fe184100a450c8458","f19e2ca3313491bb885c6105be09e1a7c7873e23825e4a2dc280757a5fc3a9f2","845b3bda6e25b659aa52e4fcfd62d9a31f954fa7cbe27179a07b6b04dac50f4a","a1f96b7ce7fba9394fd3b0a546b5128502717583eddce1b520458081c9b4b83f","3130477e219bbc0ecf42a970f864b460c1ddd8acab5b6b0efafc6736069827cc","ab36ff0b45c1cef2d97a9f30c443cd216c61cb047a9f6e08cc0fcd7611cae192"],"paragraph_range_zero_based":[29256,29279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29256"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"codebookTypeUL","paragraph_zero_based":29280},{"literal_text_all_w_t_and_m_t":"Configures codebooktype for PUSCH, see Reference XXX.","paragraph_zero_based":29281},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPUSCH","paragraph_zero_based":29282},{"literal_text_all_w_t_and_m_t":"Identifier used to initialise data scrambling (c_init) for PUSCH. If the field is absent, the UE applies the physical cell ID. (see TS 38.211 [16], clause 6.3.1.1).","paragraph_zero_based":29283},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUSCH-Config","paragraph_zero_based":29284},{"literal_text_all_w_t_and_m_t":"Configure the parameters for DMRS bundling for PUSCH (see TS 38.214 [19], clause 6.1.7). In this release, this is not applicable to FR2-2.","paragraph_zero_based":29285},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-0-2","paragraph_zero_based":29286},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 0_2. If the field is absent, then 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 0_2. If the field is present, then the number of bits is determined in the same way as DCI format 0_1 (see TS 38.212 [17], clause 7.3.1).  ","paragraph_zero_based":29287},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeA, dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2","paragraph_zero_based":29288},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type A (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeA applies to DCI format 0_1 and the field dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29289},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeB, dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2","paragraph_zero_based":29290},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type B (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeB applies to DCI format 0_1 and the field dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29291},{"literal_text_all_w_t_and_m_t":"dynamicTransformPrecoderFieldPresenceDCI-0-1","paragraph_zero_based":29292},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Dynamic Transform Precoder\" field in DCI format 0_1. When the field is configured, then the \"Dynamic Transform Precoder\" field is present in DCI format 0_1. Otherwise, the field size is set to 0 for DCI format 0_1 (See TS 38.212 [17]).","paragraph_zero_based":29293},{"literal_text_all_w_t_and_m_t":"dynamicTransformPrecoderFieldPresenceDCI-0-2","paragraph_zero_based":29294},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Dynamic Transform Precoder\" field in DCI format 0_2. When the field is configured, then the \"Dynamic Transform Precoder\" field is present in DCI format 0_2. Otherwise, the field size is set to 0 for DCI format 0_2 (See TS 38.212 [17]).","paragraph_zero_based":29295},{"literal_text_all_w_t_and_m_t":"frequencyHopping","paragraph_zero_based":29296},{"literal_text_all_w_t_and_m_t":"The value intraSlot enables 'Intra-slot frequency hopping' and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for 'pusch-RepTypeA' (see TS 38.214 [19], clause 6.3). The field frequencyHopping applies to DCI format 0_0 and 0_1 for 'pusch-RepTypeA'.","paragraph_zero_based":29297},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-1","paragraph_zero_based":29298},{"literal_text_all_w_t_and_m_t":"Indicates the frequency hopping scheme for DCI format 0_1 when pusch-RepTypeIndicatorDCI-0-1 is set to 'pusch-RepTypeB', The value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for DCI format 0_1 for 'pusch-RepTypeB' (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":29299},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-2","paragraph_zero_based":29300},{"literal_text_all_w_t_and_m_t":"Indicate the frequency hopping scheme for DCI format 0_2. The value intraSlot enables 'intra-slot frequency hopping', and the value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. When pusch-RepTypeIndicatorDCI-0-2 is not set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'intra-slot frequency hopping and 'inter-slot frequency hopping' if enabled. When pusch-RepTypeIndicatorDCI-0-2 is set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'inter-repetition frequency hopping' and 'inter-slot frequency hopping' if enabled. If the field is absent, frequency hopping is not configured for DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":29301},{"literal_text_all_w_t_and_m_t":"frequencyHoppingOffsetLists, frequencyHoppingOffsetListsDCI-0-2","paragraph_zero_based":29302},{"literal_text_all_w_t_and_m_t":"Set of frequency hopping offsets used when frequency hopping is enabled for granted transmission (not msg3) and type 2 configured grant activation (see TS 38.214 [19], clause 6.3). The field frequencyHoppingOffsetLists applies to DCI format 0_0 and DCI format 0_1 and the field frequencyHoppingOffsetListsDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":29303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c1b6546d9ca3711581a81d3f0480e3f0dadc82a3157bcda38dad7e7ff0bc4e06","df3fac61f209aa5334cf839c036fd83b6c71c9a7e1ab1d885858a736ca9bb78e","a240a0bfbb871ab40e9558385b10ff4ea8d476343a400eab31a155fe465c2dec","a3a2fa607631ce22694fae11b7dfb27a8ba217808b030e83ca4d8882c15e9c29","42d654e787f2b61cdc369c540783c4960542d767c49674b9d0dcb6a6f2038b29","f3d4c56ddaf8736a35786a1c6b66fb6cd0417f7e0a68072b7ce39085de8ed437","a61901f87efcc062965e368b2613e336fb72bf60656310219bdb8efa43ae4094","eb3dc68691cc50abb16e6beb9b15d3e1e2db0e578d46d1cef4d7c0464b15228d","443e3714cdfb28722477919a5391209ec5875186cb932b19120c99078fdf9bb9","99c631e5ac65180b5f95c8f5828f92ff38c8dc43767bf3142bb76412542f7971","4fa57272d0fe479073164c2fc01821b25b0cc3feb1f84c8b0b4db75f7b502e37","e526ca6ceaee998a0855f910f23901068d609860a487fc626fca910152575de5","371534c267e4e6cfcd23ddfbfe040c23f0cfa5095d2ae2b2978521058d13457a","baafc4f5ddb8b96ee2258022020d5c97aa28fdfe970b70ae933c4a1fdc45b424","51a563b7ca5a53348c3a04110a88104a54473403533b228b39904166af306c4b","c452dca680f508f9b7611970cfecf936af386f4cc987c5218dc71e154bf1aba4","f9be819784b3af4f42ec139651d626cab501e2c9a06ce6921fcb2809a6fdd015","eb29ec33869dc88b1027fa228ab1fd96584915b1e2fa662da5eed1e00df49319","792af950deed4a4652cea62a1ac5cc0b09d8b2171a88e575a67facd4dd7c56a8","ffd01b338c4fcc42be63d0f7e26c0d7665723a5aa8a3007d88ba7c9ab964b227","23fa55091be8491eadc4928e9cb533695ad100355148cdd23912618713e91b90","5e52bb78510f315ffed2d5937797c5226f9abdb9d30ed88672af771e1e789cd5","befd29c5a8c9dab80dfa0c95794429def968f08d17e894c91ba5a2ceebcb5df2","51d032434ddefcc19b58444c28f60ae00768721bc0918ee192cc6920e97e0a45"],"paragraph_range_zero_based":[29280,29303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29280"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-0-2","paragraph_zero_based":29304},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29305},{"literal_text_all_w_t_and_m_t":"invalidSymbolPattern","paragraph_zero_based":29306},{"literal_text_all_w_t_and_m_t":"Indicates one pattern for invalid symbols for PUSCH transmission repetition type B applicable to both DCI format 0_1 and 0_2. If InvalidSymbolPattern is not configured, semi-static flexible symbols are used for PUSCH. Segmentation occurs only around semi-static DL symbols (see TS 38.214 [19] clause 6.1).","paragraph_zero_based":29307},{"literal_text_all_w_t_and_m_t":"invalidSymbolPatternIndicatorDCI-0-1, invalidSymbolPatternIndicatorDCI-0-2","paragraph_zero_based":29308},{"literal_text_all_w_t_and_m_t":"Indicates the presence of an additional bit in the DCI format 0_1/0_2. If invalidSymbolPattern is absent, then both invalidSymbolPatternIndicatorDCI-0-1 and invalidSymbolPatternIndicatorDCI-0-2 are absent. The field invalidSymbolPatternIndicatorDCI-0-1 applies to the DCI format 0_1 and the field invalidSymbolPatternIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19] clause 6.1). If the field is absent, the UE behaviour is specified in TS 38.214 [19], clause 6.1.2.1.","paragraph_zero_based":29309},{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":29310},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when two SRS resource sets are configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' for PUSCH transmission and the PUSCH transmission occasions are associated with both SRS resource sets.","paragraph_zero_based":29311},{"literal_text_all_w_t_and_m_t":"maxRank, maxRankDCI-0-2, maxRank-n8","paragraph_zero_based":29312},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TRIs from 1 to ULmaxRank (see TS 38.214 [19], clause 6.1.1.1). The fields maxRank and maxRank-n8 apply to DCI format 0_1, and the field maxRankDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1).","paragraph_zero_based":29313},{"literal_text_all_w_t_and_m_t":"mcs-Table, mcs-TableFormat0-2","paragraph_zero_based":29314},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH without transform precoder (see TS 38.214 [19], clause 6.1.4.1). If the field is absent the UE applies the value 64QAM. The field mcs-Table applies to DCI format 0_0 and DCI format 0_1 and the field mcs-TableDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":29315},{"literal_text_all_w_t_and_m_t":"mcs-TableTransformPrecoder, mcs-TableTransformPrecoderDCI-0-2","paragraph_zero_based":29316},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH with transform precoding (see TS 38.214 [19], clause 6.1.4.1) If the field is absent the UE applies the value 64QAM. The field mcs-TableTransformPrecoder applies to DCI format 0_0 and DCI format 0_1 and the field mcs-TableTransformPrecoderDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":29317},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK2","paragraph_zero_based":29318},{"literal_text_all_w_t_and_m_t":"List of minimum K2 values. Minimum K2 parameter denotes minimum applicable value(s) for the Time domain resource assignment table for PUSCH (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29319},{"literal_text_all_w_t_and_m_t":"mpe-ResourcePoolToAddModList","paragraph_zero_based":29320},{"literal_text_all_w_t_and_m_t":"List of SSB/CSI-RS resources for P-MPR reporting. Each resource is configured with serving cell index where the resource is configured for the UE. The additionalPCI is configured only if the resource is SSB. For each resource, if neither cell nor additionalPCI is present, the SSB/CSI-RS resource is from the serving cell where the PUSCH-Config is configured.","paragraph_zero_based":29321},{"literal_text_all_w_t_and_m_t":"multipanelScheme","paragraph_zero_based":29322},{"literal_text_all_w_t_and_m_t":"Configures UE with a multiple panel simultaneous uplink transmission SDM or SFN scheme for PUSCH.","paragraph_zero_based":29323},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-0-2","paragraph_zero_based":29324},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29325},{"literal_text_all_w_t_and_m_t":"numberOfInvalidSymbolsForDL-UL-Switching","paragraph_zero_based":29326},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols after the last semi-static DL symbol that are invalid symbols for PUSCH repetition Type B. If it is absent, no symbol is explicitly defined for DL-to-UL switching (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":29327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["46746530cc42d4b0e0f9e258a5af087103a0de8373673e1758c47fc1cece3aef","897101a2031375c08cd5d105071d584398b8f385bf0abc08df3396e6baa86aec","6ac0e0a1140ae8d51267fe61643f0c3583f9def7bb4586685e0ac7a46579eb81","43c299de04028d018c73dafd8081324242aa87969a7df3cb8f482dbdb0823d49","85f81c8939f01a3b645b71ec91de69dc06de2b423fb46f9a5e813d5486a94448","8ee65173f4b1d0e3a7f2b09485a7c0e0e4398c8d5117596ca7bebaf6b8a87074","d5c2db675a70401063f23d5ae764f654ccf33577d2a9084d2104d4ed24c8adac","c9a2c7c4ea32ea5baa39df1a796d9eee713f343b0ff649ca33a272ca1ba3d1a0","76948972740bba3bfe85d7fc39d8032922cf14081add7f6c28dfd1e3005b0970","053495dc5cebe16e398bf41c625a2ee804e5ba91972156fa408ea5b019b116ed","9ac132e7f4a83a4c1ea6a250c48942461dd27be3a3d58b4ecc164a05526fedf2","2d0f7d7868cd44e3865210374a1e9d2a9313d76ecb0078f11a2d5ca67bf28f89","885ff23f4877787dd65895f02b313f28d7f886719f9479b6be6f253255a25cc6","6dccc49d2fc0ed59b6569581dfd52699a642e39b1d6b78162c78a26a477ee958","8c9adad1a80716ee6c9a54c8d78e15b61d3b4be4c163dc0a694369ab79be8461","cb4ee6d15255e068f341d3ab67db96c39887453c6647ca64f909ea2002a2a288","f69f7c9bb21597500a7c11c7d02926a96326659418b7553bdf13d90e9df5dffa","8ca768e4d724bb8519669b0bea6709077ca63198dde9a2e91e74f1eecbd6740d","e6ac9f5f9a2904b03889c1c27e9e8b97a13730bbf74c3271d6da88f6251263f9","03181eacdd7ea3d07eeb8ed4530eeaf3062b5c601023b2de634a969275eed6bd","61d2938564ada278f5193d707c4ade2c9549b2cac62c1874d2664159b01c698c","45348a6858f48cf2bd1de4a711eb743bda4e74a53faf71a68e4b4c8a649e9ae4","05558ee53be3be8f35159376ddf0baf776795d361361b34f45b3f53582b7b97c","6615d644686bcf9c5f17413a1851f145a76efb1502a11128437c75c9810020b8"],"paragraph_range_zero_based":[29304,29327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29304"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-0-1, priorityIndicatorDCI-0-2","paragraph_zero_based":29328},{"literal_text_all_w_t_and_m_t":"Configures the presence of \"priority indicator\" in DCI format 0_1/0_2. When the field is absent in the IE, then the UE shall apply 0 bit for \"Priority indicator\" in DCI format 0_1/0_2. The field priorityIndicatorDCI-0-1 applies to DCI format 0_1 and the field priorityIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":29329},{"literal_text_all_w_t_and_m_t":"pusch-AggregationFactor","paragraph_zero_based":29330},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 6.1.2.1). If the field is absent the UE applies the value 1.","paragraph_zero_based":29331},{"literal_text_all_w_t_and_m_t":"pusch-PowerControl","paragraph_zero_based":29332},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUSCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":29333},{"literal_text_all_w_t_and_m_t":"pusch-RepTypeIndicatorDCI-0-1, pusch-RepTypeIndicatorDCI-0-2","paragraph_zero_based":29334},{"literal_text_all_w_t_and_m_t":"Indicates whether UE follows the behavior for \"PUSCH repetition type A\" or the behavior for \"PUSCH repetition type B\" for the PUSCH scheduled by DCI format 0_1/0_2 and for Type 2 CG associated with the activating DCI format 0_1/0_2.The value pusch-RepTypeA enables the 'PUSCH repetition type A' and the value pusch-RepTypeB enables the 'PUSCH repetition type B'. The field pusch-RepTypeIndicatorDCI-0-1 applies to DCI format 0_1 and the field pusch-RepTypeIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29335},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":29336},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1). The field pusch-TimeDomainAllocationList applies to DCI formats 0_0 or DCI format 0_1 when the field pusch-TimeDomainAllocationListDCI-0-1 is not configured (see TS 38.214 [19], table 6.1.2.1.1-1 and table 6.1.2.1.1-1A). The network does not configure the pusch-TimeDomainAllocationList (without suffix) simultaneously with the pusch-TimeDomainAllocationListDCI-0-2-r16 or pusch-TimeDomainAllocationListDCI-0-1-r16 or pusch-TimeDomainAllocationListForMultiPUSCH-r16.","paragraph_zero_based":29337},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-1","paragraph_zero_based":29338},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI format 0_1 (see TS 38.214 [19], clause 6.1, table 6.1.2.1.1-1A).","paragraph_zero_based":29339},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-2","paragraph_zero_based":29340},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI format 0_2 (see TS 38.214 [19], clause 6.1.2, table 6.1.2.1.1-1B).","paragraph_zero_based":29341},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListForMultiPUSCH","paragraph_zero_based":29342},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for multiple PUSCH (see TS 38.214 [19], clause 6.1.2). The network configures at most 64 rows in this TDRA table in PUSCH-TimeDomainResourceAllocationList-r16 configured by this field. This field is not configured simultaneously with pusch-AggregationFactor. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the pusch-TimeDomainAllocationListDCI-0-1-r16. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the numberOfSlotsTBoMS-r17.","paragraph_zero_based":29343},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":29344},{"literal_text_all_w_t_and_m_t":"Selection between configuration 1 and configuration 2 for RBG size for PUSCH. The UE does not apply this field if resourceAllocation is set to resourceAllocationType1. Otherwise, the UE applies the value config1 when the field is absent (see TS 38.214 [19], clause 6.1.2.2.1).","paragraph_zero_based":29345},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-0-2","paragraph_zero_based":29346},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 6.1.2). The field resourceAllocation applies to DCI format 0_1 and the field resourceAllocationDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2).","paragraph_zero_based":29347},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-0-2","paragraph_zero_based":29348},{"literal_text_all_w_t_and_m_t":"Configures the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 0_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 6.1.2.2.2).","paragraph_zero_based":29349},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-0-1, secondTPCFieldDCI-0-2","paragraph_zero_based":29350},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-0-1 and DCI-0-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1,","paragraph_zero_based":29351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["40bb19a89cf71098df390015f849d1e8deb2766aaf70567ed67b324e0cc41d9d","4d55b00c4ae1477316f5c1ace211946a5d6383586f00a6169362ec0b23bc55da","b56c1816293dd6b46faec9ad7862565437ce113034c6a4fd0a00b491a77a736a","aa8ad3dd0c7e789522e238cf846ac14ef57b5d87a188acad77a0117a2e3a544f","0fbea4fe11f9035ff12dd0846f34d2d9e7c546e7b35231604e8efe60c44074fd","2d11b415c6e1ab4e90e7112f0acbbf27334877fbf3ec35506d8514c0cb739c69","b2c02de700c82a776b107c895a2af77cb835d80e8bbbb4b537cc2efa52ac8113","16df34659fd6aec15f519193403507e4a01ededd896dbdfe5f689a2ba5210619","16c0a679fb988b87984008c549b50d5161f5756fea034242473887c80cd4d535","9ca6378a975c9116dca2b73db293cff6eb4872bbe08fe44732a2103ea9f0d7c4","d87880a77cd56875ad391b9a71db7e74b97962229ca5e38517ebb352bf1a4d60","822d78869a0d119d40ebb6bc652677781245a91c75e468af519f091edc95688e","8aafd7fbf87df502129552d32f96bca175e4cd89c4934c4bb2a15b5686d07f16","baff1c90ff00a8230fb53b9a245e2fe8bacc8b8ea1302a55b9c7f2f0a09d9750","f2072fea3b5143698ac9c208a8bcc6d7b142e55d8c52f574783a3369547a52f8","c5219ad7def6de0d360e74d477c80e7acd4523ebc0c9a42ac744015ea8da9b7f","9f4cc7c2514f643f8b66f769e9e2d2ff0fc4fd5aabbbb7c74d586857dae037f5","553548050e801bc3ed6334dfe797f51198c4a089e072b912c95d262057dc70e1","69631eac22b12b863df0830e1f4f9a41e125cc3c2e09bedea03d12b623ebc4d8","d5e56ee5612e24cea031f2a83b9005dad25c074ec1088cbfd804ca6332d31290","4d37269f3da7d972545fbfa61451d4df456573b54f7da01a28fd830b3d7c5efb","5c9681b549bb850f3c41a5e14befaaf1c34b20fbaa43552f7a51b380366f4aec","43870e67fa20ceff4fc8ba6829d6eb05498814ff5a08894c71bb3692d2cf0a75","0eeed0292a891ab3b6de3a8e6b89564c68dea08531a8ee00f0b1adb5b1ac13a6"],"paragraph_range_zero_based":[29328,29351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29328"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":29352},{"literal_text_all_w_t_and_m_t":"Configures the RV offset for the starting RV for the first repetition (first actual repetition in PUSCH repetition Type B) towards the second 'SRS resource set' for PUSCH configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":29353},{"literal_text_all_w_t_and_m_t":"stx2-Panel","paragraph_zero_based":29354},{"literal_text_all_w_t_and_m_t":"Parameter to enable PUSCH+PUSCH multiple panel simultaneous uplink transmission in multi-DCI based mTRP system. When this paramater is configured, two coresetPoolindex values are configured and two SRS resource sets for CB or NCB are configured, the multi-DCI based STxMP PUSCH+PUSCH is configured.","paragraph_zero_based":29355},{"literal_text_all_w_t_and_m_t":"tp-pi2BPSK","paragraph_zero_based":29356},{"literal_text_all_w_t_and_m_t":"Enables pi/2-BPSK modulation with transform precoding if the field is present and disables it otherwise. ","paragraph_zero_based":29357},{"literal_text_all_w_t_and_m_t":"transformPrecoder","paragraph_zero_based":29358},{"literal_text_all_w_t_and_m_t":"The UE specific selection of transformer precoder for PUSCH (see TS 38.214 [19], clause 6.1.3). When the field is absent the UE applies the value of the field msg3-transformPrecoder from rach-ConfigCommon included directly within BWP configuration (i.e., not included in additionalRACH-ConfigList).","paragraph_zero_based":29359},{"literal_text_all_w_t_and_m_t":"txConfig","paragraph_zero_based":29360},{"literal_text_all_w_t_and_m_t":"Whether UE uses codebook based or non-codebook based transmission (see TS 38.214 [19], clause 6.1.1). If the field is absent, the UE transmits PUSCH on one antenna port, see TS 38.214 [19], clause 6.1.1.","paragraph_zero_based":29361},{"literal_text_all_w_t_and_m_t":"uci-OnPUSCH-ListDCI-0-1, uci-OnPUSCH-ListDCI-0-2","paragraph_zero_based":29362},{"literal_text_all_w_t_and_m_t":"Configuration for up to 2 HARQ-ACK codebooks specific to DCI format 0_1/0_2. The field uci-OnPUSCH-ListDCI-0-1 applies to DCI format 0_1 and the field uci-OnPUSCH-ListDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":29363},{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-0-1, ul-AccessConfigListDCI-0-2","paragraph_zero_based":29364},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension, channel access priority class (CAPC), and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable for DCI format 0_1 and DCI format 0_2, respectively. The fields ul-AccessConfigListDCI-0-1-r16 and ul-AccessConfigListDCI-0-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.1.2-35). The field ul-AccessConfigListDCI-0-1-r17 only contains a list of UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.1.2-35A).","paragraph_zero_based":29365},{"literal_text_all_w_t_and_m_t":"ul-FullPowerTransmission","paragraph_zero_based":29366},{"literal_text_all_w_t_and_m_t":"Configures the UE with UL full power transmission mode as specified in TS 38.213 [13]. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":29367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29368},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigDCI-0-3 field descriptions","paragraph_zero_based":29369},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-0-3","paragraph_zero_based":29370},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 0_3 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29371},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-0-3","paragraph_zero_based":29372},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 0_3 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29373},{"literal_text_all_w_t_and_m_t":"rbg-SizeDCI-0-3","paragraph_zero_based":29374},{"literal_text_all_w_t_and_m_t":"Selection among configuration 1, configuration 2 and configuration 3 for RBG size for PUSCH. The UE does not apply this field if resourceAllocationDC-0-3 is set to resourceAllocationType1. Otherwise, the UE applies the value config1 when the field is absent (see TS 38.214 [19], clause 6.1.2.2.1).","paragraph_zero_based":29375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["539356e949122fcf375729586c49e2b0ba8322be41ac4e0ec86abfd6bc3268c6","a97fe8005b3c21f454cc1bbae4bd885cd54cac6c29bd19d7955e98dc2901ea16","dfd3fdd51ca0474400c5bd877bfc356e65485bc12688fa8f453aa9a806d0841f","0c193fea7693fd9291ef1243ce11459ae3136c8896eef54a08272c5474f42741","0734c28556bb0867adb5be5e12d808c37843344b6db82eadbf784da3ecfb25da","f5d099aa0a2f33c89761f71285d982350f124df3371b9f33b94ed176b7288370","9e99408b511bdff55649625cbed1ab6d5882f3125e14d54243244bfc8d403413","43b4b160a22d5c5535fd8446d467db9e17276a2a18f7586b8e4553c2b180ed30","3bace0c316756d5d364511117e4c053c6bc3a0f86dc0562e7f7e4b83d660eb7d","2daeb03bb6ebe15aa95e6ecc0fe9d997890fa1a1d5730a24090eb5a8f8ea0327","51bf680b20e52f94896dc2032f7d8a03d68fec7504166f9d27b49ee7dff3154f","0c81c17c84833543804328bbeb7bcedbcaae5179c7299ea9d1b0e995a2c25cd7","4646a5548a7266e5c8ead93be55eb312c52487bd9a075223c43afdaf95fbf705","a2aced326c059f15041186943aaa37c35378f497e4d821b61a568b80d99ac676","8ad8e120ef6682766e0261ce68f3f435d606e8f7190b13832a570f9e83735bb0","b10642284382d5332f1938bcfd80401eeb77d4180f3098ea57bb38609981472f","ce7b6065b0cdbec863623216f1225d0252f35e0cdb181734e07f1d83de89201d","4798a8d9c1d32429dd3e8de9d9588222d9f9993154d19c694d364801e26d06f7","2a068fb23035559fac0c74b074315bc450a111818c7f3ae9615925fbdd90dee8","d1634b88928597586002a5f165bf0639cd437cdda65f8853e2299e0d75729484","b989caf53a1d6ba9a947c84654c48581ad8a7fe38d69276721919f13ca468a02","44652335c9c1ad09b48bc392753e846cf908941cc4e8536e25861903627f9013","5a9c24d242452fb61fee2338b6fe899e7524c73b55fbadbca7ccdb452068a215","ca4d9450c8e32e8bd13169c2a8d47f8e813fdd46ac3a001b05c4ae3270393e45"],"paragraph_range_zero_based":[29352,29375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29352"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"resourceAllocationDCI-0-3","paragraph_zero_based":29376},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 6.1.2).","paragraph_zero_based":29377},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-0-3","paragraph_zero_based":29378},{"literal_text_all_w_t_and_m_t":"Configures the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 0_3. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 6.1.2.2.2).","paragraph_zero_based":29379},{"literal_text_all_w_t_and_m_t":"uci-OnPUSCH-ListDCI-0-3","paragraph_zero_based":29380},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for DCI format 0_3.","paragraph_zero_based":29381},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29382},{"literal_text_all_w_t_and_m_t":"SDM-Scheme field descriptions","paragraph_zero_based":29383},{"literal_text_all_w_t_and_m_t":"maxRankSDM, maxRankSDM-DCI-0-2","paragraph_zero_based":29384},{"literal_text_all_w_t_and_m_t":"configure maximal number of MIMO layers of each panel in SDM scheme for codebook based PUSCH or for DCI 0_2 for codebook based PUSCH.","paragraph_zero_based":29385},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSDM","paragraph_zero_based":29386},{"literal_text_all_w_t_and_m_t":"Indicates the maximal number of MIMO layers of each panel for PUSCH with SDM scheme for non-codebook based PUSCH.","paragraph_zero_based":29387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29388},{"literal_text_all_w_t_and_m_t":"SFN-Scheme field descriptions","paragraph_zero_based":29389},{"literal_text_all_w_t_and_m_t":"maxRankSFN, maxRankSFN-DCI-0-2","paragraph_zero_based":29390},{"literal_text_all_w_t_and_m_t":"configure maximal number of MIMO layers of each panel in SFN scheme for codebook based PUSCH or for DCI 0_2 for codebook based PUSCH.","paragraph_zero_based":29391},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSFN","paragraph_zero_based":29392},{"literal_text_all_w_t_and_m_t":"Indicates the maximal number of MIMO layers of each panel for PUSCH with SFN scheme for non-codebook based PUSCH.","paragraph_zero_based":29393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29394},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH field descriptions","paragraph_zero_based":29395},{"literal_text_all_w_t_and_m_t":"betaOffsets","paragraph_zero_based":29396},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for DCI formats other than DCI format 0_2. If the field is not configured, the UE applies the value 'semiStatic' (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":29397},{"literal_text_all_w_t_and_m_t":"scaling","paragraph_zero_based":29398},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI formats other than DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on. The value configured herein is applicable for PUSCH with configured grant (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":29399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e181dc56a7c8e3057c32a31c36093079493216191a7e860a2ab0f0e0310f489b","2efe139a0eb60b6d46dc78391e7269a14db2f90d14ce1692031eed541daed8c9","6cc9c214a274241aa9c63f6ecc9c73444cded1873ba878eb1b2a19f26f402c29","3be44369a4ec0c82c279e53666fd974a0d4f50a99fffa13ee2663cf7233178cc","1d138b27b91385ae66ec53372771750d4afa75712922c72e3ed4252a37242cb0","1dd05fc1bdf3015e23199cee37cbf8959b5cceeb42fd0629ec1d4feb55416f37","2ccf55a67953747d95121e933cf51e3fe3e7c2a2da6033cff65712f4360c9eff","71bfd4ee7ba3ac3c3a55b2f2200bdd6c1bbdf5d4ede563f1e7ca30e322048ef7","135e494ebc33f58c608866b6614bbff7e5790d5c4e91785ed6f0f5a843d4c3d5","7c9d4a112550f92e414551aa75b8f4be6374751f4eeddac13ca6d406abfd1bed","c4869cee167f8b839c14f4271270050ccd5e1aba5bf7cef7bf16a6a083dabfe2","0b7794c1536cbe088ac43652aa46dd6aaec1cef5b8664550dfe787636a18c99a","4c193c6ee3fdec9a969a89e3a8ce2bc9dd3691b3ed46e1d2d07cff6ae55a5291","39f33464a1a0b98dd1c8d213aff487f8af18da11a53665ddebf6081fab77d9aa","42074fb3e1c8e13b3990d7857cd1669e5f81b02d9e37b3e0897498a02009dbd0","98abffbe29a160664b8cdcc57a8fd6edf6c4af5dcff140c56b3495b3e2fb3785","af2b589f7e5423117b0bfc4393d87871ad86e4eba26f7f57d7d22f0fc4af7c11","fe0e9943dcf83cc1772ce1a7e0b9db0609a204c43d067d0cd9b0888a07ca7021","a88fd4427528ba8102c75d37a4a1eda5befe7078f436309b1fe7efbb2ad8b45f","50d7c189fad9492c55c258ddd611bdd10791b2510518868a6750e8d369397ea5","7dea50134a7681f292904a54ac4ab728444e4e307b475d08fb9ddb5d66c530cd","ce828f24e9960d45e1c0647a9b267e4a529af4ff1b6fe2a2b8fc02c9bfb4fd3a","eac6ac8ca68d29a0c6111891dbfde30851224bead7d92829b1e56ecd050f216b","4fed420861a07de7ba20f61c25c0bc02d18712a28fc7b3f1cc62b80a8793285b"],"paragraph_range_zero_based":[29376,29399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29376"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29400},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH-DCI-0-2 field descriptions","paragraph_zero_based":29401},{"literal_text_all_w_t_and_m_t":"betaOffsetsDCI-0-2","paragraph_zero_based":29402},{"literal_text_all_w_t_and_m_t":"Configuration of beta-offset for DCI format 0_2. If semiStaticDCI-0-2 is chosen, the UE shall apply the value of 0 bit for the field of beta offset indicator in DCI format 0_2. If dynamicDCI-0-2 is chosen, the UE shall apply the value of 1 bit or 2 bits for the field of beta offset indicator in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":29403},{"literal_text_all_w_t_and_m_t":"dynamicDCI-0-2","paragraph_zero_based":29404},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'dynamic' for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.3).","paragraph_zero_based":29405},{"literal_text_all_w_t_and_m_t":"semiStaticDCI-0-2","paragraph_zero_based":29406},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'semiStatic' for DCI format 0_2. (see TS 38.212 [17], clause 7.3.1 and see TS 38.213 [13], clause 9.3).","paragraph_zero_based":29407},{"literal_text_all_w_t_and_m_t":"scalingDCI-0-2","paragraph_zero_based":29408},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":29409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29410},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29411},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29412},{"literal_text_all_w_t_and_m_t":"codebookBased","paragraph_zero_based":29413},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if txConfig is set to codebook and absent otherwise.","paragraph_zero_based":29414},{"literal_text_all_w_t_and_m_t":"RepTypeB","paragraph_zero_based":29415},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":29416},{"literal_text_all_w_t_and_m_t":"RepTypeB2","paragraph_zero_based":29417},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 or pusch-RepTypeIndicatorDCI-0-2 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":29418},{"literal_text_all_w_t_and_m_t":"SRSsets","paragraph_zero_based":29419},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when UE is configured with two SRS sets in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage codebook or non-codebook.","paragraph_zero_based":29420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29421},{"literal_text_all_w_t_and_m_t":"–PUSCH-ConfigCommon","paragraph_zero_based":29422},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ConfigCommon is used to configure the cell specific PUSCH parameters.","paragraph_zero_based":29423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bc98fb1269520865af49dbd7aa74120707ba747157c0ce766fe14d7397c5508b","8c05b62ad65418fb56b0c9c383f8ed55694dbfc32f6426bf84ee309581bb93ac","12be4d19b7889522ee395096a4437c2171dd875695e9893a1e4402f4a8af57ff","756d9831a96a4d204dd1b2b42a83e59448f7600fa997223740da86edf841e8a3","1a302a2a612764f30f5d6325aaed6eebc131ef47b2ee3e40e7f3295c15e44ed7","11fd632b2d14838af7e789e6de7fe0b9cf85c893fb37debbd7924fac4a5ee3af","eed9614d12960686d4c2d71c1827d4d25a2af341b7a7151ba8b4090ff791e747","0e36d84f231ecbd3f24d00e50fc664c6c7aed4a4ecc7fc940d502049a3fb21eb","3be68451d925fd5a599347c1aa362280243e5a27023f2e3dbd766bee3512d72e","9db9ac1771e79bafcc69e3d2ce2bd07cba5a1099894b793b98f424b57d4dbe87","5968f278f0b3b2de1fc5d8c3b64f31a0b8e7eed1a774f6211a4204281e8fa94a","7cc688772e7725bf437f2ed10b0c60a612f006d6d094d50de12d921b53111568","a76f18d6d20f71547751e9f315e5abef908494795f834da53b2a8e32811f0789","3f17f9f0b022c9b9893795f7b7024816fd3109ace0137f27391a7d1ab8c60dfa","06a3d67ecdf8d20073d72c73e82bed7ecd6c33c29a703a887f18b59bff75d0f1","4910c0c48360d4805ca2dee0b381e17ba15f7834aec23cc86089d8840410e337","219ec4e4432a0826c8a0e4b9f73b1dfc40dac893f797e994f34adffdf5881555","b39a3f1d5f4520e08fbc8a78dff4c8fea26984adf9e4980ab60bbd1020915b12","e2b90b987b597750a0e3a594eb4abfe622fc600182ea4fbf55a9759db17979d3","0d689b9c2d723da1f020ec667604bc78c8c2b90f250e52999ff9be10bc20f6cd","2d010ddc11db3acabcf781f9534cfdc6740225a8592600dc3a5a553086458469","87b77b37ad8463cac371bb46e45091af2c3649286ca50c251d47cbde4388b975","39aa6abc74cb90ab5d8ac8557686da8c0c33e1192f3d0e068781351647a8ad61","f6f9e7b20ddee15348e3c4decd0894397b918ba75ab2745624e8b630ea1acfaa"],"paragraph_range_zero_based":[29400,29423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29400"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon information element","paragraph_zero_based":29424},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29425},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-START","paragraph_zero_based":29426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29427},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":29428},{"literal_text_all_w_t_and_m_t":"    groupHoppingEnabledTransformPrecoding   ENUMERATED {enabled}                                                OPTIONAL,   -- Need R","paragraph_zero_based":29429},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          PUSCH-TimeDomainResourceAllocationList                              OPTIONAL,   -- Need R","paragraph_zero_based":29430},{"literal_text_all_w_t_and_m_t":"    msg3-DeltaPreamble                      INTEGER (-1..6)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":29431},{"literal_text_all_w_t_and_m_t":"    p0-NominalWithGrant                     INTEGER (-202..24)                                                  OPTIONAL,   -- Need R","paragraph_zero_based":29432},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29433},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29435},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-STOP","paragraph_zero_based":29436},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29438},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon field descriptions","paragraph_zero_based":29439},{"literal_text_all_w_t_and_m_t":"groupHoppingEnabledTransformPrecoding","paragraph_zero_based":29440},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder, the NW may configure group hopping by this cell-specific parameter, see TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":29441},{"literal_text_all_w_t_and_m_t":"msg3-DeltaPreamble","paragraph_zero_based":29442},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 and RACH preamble transmission. Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1)","paragraph_zero_based":29443},{"literal_text_all_w_t_and_m_t":"p0-NominalWithGrant","paragraph_zero_based":29444},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3). Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1) This field is cell specific","paragraph_zero_based":29445},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":29446},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1).","paragraph_zero_based":29447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["62a17a64af648886cccc2ed21cdd4ecb5cd6519dcdfbc80cb86129f443331dcf","d5ba0e9da3c1dc999206b4de4b8a20662d3e32672349950dfa0b26dc3eaaeb8e","f224ab549498c6bc746e5e4f2b1821fe17fb467dd174d507ebac66959863c678","c7deea1cb62d78636296a43d043070a06a0344574643863ec88dfbe739512b18","a2344c01bf7ce22ed99e43848aeffdac4331fa6a039c49c4d1c2965bce84c134","ad4f4f3ee21bf23ad0f5a4def444ddcf00e72fcd11ac0d72df924f5b24bf4a8f","ef4d58a9c374f0804cb9e693883b3089938f8feb0c9d7fa40d56b64104f7a5f4","250647166009d5c6e5b40c6870300b5be7d00fcbc6257ffba7f2c007744699b8