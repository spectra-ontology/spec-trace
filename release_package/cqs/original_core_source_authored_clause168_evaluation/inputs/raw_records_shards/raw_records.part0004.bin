{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-PrioritisedBitRate-r16                  ENUMERATED {kBps0, kBps8, kBps16, kBps32, kBps64, kBps128, kBps256, kBps512,","paragraph_zero_based":45576},{"literal_text_all_w_t_and_m_t":"                                               kBps1024, kBps2048, kBps4096, kBps8192, kBps16384, kBps32768, kBps65536, infinity},","paragraph_zero_based":45577},{"literal_text_all_w_t_and_m_t":"    sl-BucketSizeDuration-r16                  ENUMERATED {ms5, ms10, ms20, ms50, ms100, ms150, ms300, ms500, ms1000,","paragraph_zero_based":45578},{"literal_text_all_w_t_and_m_t":"                                               spare7, spare6, spare5, spare4, spare3,spare2, spare1},","paragraph_zero_based":45579},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantType1Allowed-r16         ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":45580},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-FeedbackEnabled-r16                ENUMERATED {enabled, disabled }                                     OPTIONAL,   -- Need R","paragraph_zero_based":45581},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCG-List-r16                      SEQUENCE (SIZE (0.. maxNrofCG-SL-1-r16)) OF SL-ConfigIndexCG-r16","paragraph_zero_based":45582},{"literal_text_all_w_t_and_m_t":"                                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":45583},{"literal_text_all_w_t_and_m_t":"    sl-AllowedSCS-List-r16                     SEQUENCE (SIZE (1..maxSCSs)) OF SubcarrierSpacing                   OPTIONAL,   -- Need R","paragraph_zero_based":45584},{"literal_text_all_w_t_and_m_t":"    sl-MaxPUSCH-Duration-r16                   ENUMERATED {ms0p02, ms0p04, ms0p0625, ms0p125, ms0p25, ms0p5, spare2, spare1}","paragraph_zero_based":45585},{"literal_text_all_w_t_and_m_t":"                                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":45586},{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelGroup-r16                 INTEGER (0..maxLCG-ID)                                              OPTIONAL,   -- Need R","paragraph_zero_based":45587},{"literal_text_all_w_t_and_m_t":"    sl-SchedulingRequestId-r16                 SchedulingRequestId                                                 OPTIONAL,   -- Need R","paragraph_zero_based":45588},{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelSR-DelayTimerApplied-r16  BOOLEAN                                                             OPTIONAL,   -- Need R","paragraph_zero_based":45589},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":45590},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":45591},{"literal_text_all_w_t_and_m_t":"    sl-ChannelAccessPriority-r18               INTEGER (1..4)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":45592},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCarriers-r18           SEQUENCE (SIZE (1..maxNrofFreqSL-r16)) OF INTEGER (1..maxNrofFreqSL-r16) OPTIONAL -- Cond CONNECTED","paragraph_zero_based":45593},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":45594},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45595},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":45596},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45598},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig field descriptions","paragraph_zero_based":45599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_c