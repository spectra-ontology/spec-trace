{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36048},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-START","paragraph_zero_based":36049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36050},{"literal_text_all_w_t_and_m_t":"TimeToTrigger ::=                   ENUMERATED {","paragraph_zero_based":36051},{"literal_text_all_w_t_and_m_t":"                                        ms0, ms40, ms64, ms80, ms100, ms128, ms160, ms256,","paragraph_zero_based":36052},{"literal_text_all_w_t_and_m_t":"                                        ms320, ms480, ms512, ms640, ms1024, ms1280, ms2560,","paragraph_zero_based":36053},{"literal_text_all_w_t_and_m_t":"                                        ms5120}","paragraph_zero_based":36054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36055},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMETOTRIGGER-STOP","paragraph_zero_based":36056},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36058},{"literal_text_all_w_t_and_m_t":"–TN-AreaId","paragraph_zero_based":36059},{"literal_text_all_w_t_and_m_t":"The IE TN-AreaId is used to identify a TN coverage area in an NTN system.","paragraph_zero_based":36060},{"literal_text_all_w_t_and_m_t":"TN-AreaId information element","paragraph_zero_based":36061},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36062},{"literal_text_all_w_t_and_m_t":"-- TAG-TN-AREAID-START","paragraph_zero_based":36063},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36064},{"literal_text_all_w_t_and_m_t":"TN-AreaId-r18 ::=                  INTEGER (1..maxTN-AreaInfo-r18)","paragraph_zero_based":36065},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36066},{"literal_text_all_w_t_and_m_t":"-- TAG-TN-AREAID-STOP","paragraph_zero_based":36067},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36068},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36069},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetIndex","paragraph_zero_based":36070},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetIndex provides the index of the entry in uac-BarringInfoSetList. Value 1 corresponds to the first entry in uac-BarringInfoSetList, value 2 corresponds to the second entry in this list and so on. An index value referring to an entry not included in uac-BarringInfoSetList indicates no barring.","paragraph_zero_based":36071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e0be780e20a9d3ac6005ac424ac76475b70f65b6d44ead53c2dfb03615c5b907","1527aa286025ff2ac14dbda6823d8e62498a44f69f036a4700453cea6a027417","faeaca6f0bdb8a6ab2c670f8078fe2892e2caaebbce13c4890aa1b183cfa0009","3322ce759c345ffe8dd9f1e379e398e1d2e23a5af9b31e5bdad3ae3af4b12297","f60be9942efd668677e940ca42251c528f49176bf2329edcbd20a540e603cf6c","7bb45db036108467669285c17becc6772fef10320c29a0aa0b6438c3ad9ff4d8","3813bfec3a1f54a4cd115fea405102243230084497e72bca4b17b00e37c31df1","d8d58b2bf587656b81fdff15996a3d807191682473f52b7241c0c0ff62a431cb","63c35bef0a14e72a2b0bbe6ebf08250d7e4a24b410acd5eef7e2e8fbaba77467","d355c9a3af98043e10b7e1edf232af187227f81b4896becf9c4e1f2bb83653cd","d542d23f38a9b06688de78502141fb68cb99044ba8e08bdfc013f2010063ef0a","4552f85122e6d60926a73e325d83721ce024beee5ed680988e626f4584a44ff2","84fe465b0d9380f4954644ec77503e2fdbc5fc7f64fa68b4975aa6c6e13d8971","8e08e23f8f964f600bd2f866100f1f3f793f8491ff3e5c0e1ccead669de6664d","3e13c18c6948fa9eb634754fc19218f4c04927