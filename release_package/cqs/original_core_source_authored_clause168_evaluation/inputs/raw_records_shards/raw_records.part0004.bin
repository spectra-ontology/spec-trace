{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is mandatory present if dl-FreqInfo-NR is included and concerns an FDD carrier; otherwise the field is absent.","paragraph_zero_based":52392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52393},{"literal_text_all_w_t_and_m_t":"–CG-ConfigInfo","paragraph_zero_based":52394},{"literal_text_all_w_t_and_m_t":"This message is used by master eNB or gNB to request the SgNB or SeNB to perform certain actions e.g. to establish, modify or release an SCG. The message may include additional information e.g. to assist the SgNB or SeNB to set the SCG configuration. It can also be used by a CU to request a DU to perform certain actions, e.g. to establish, or modify an MCG or SCG.","paragraph_zero_based":52395},{"literal_text_all_w_t_and_m_t":"Direction: Master eNB or gNB to secondary gNB or eNB, alternatively CU to DU.","paragraph_zero_based":52396},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo message","paragraph_zero_based":52397},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":52398},{"literal_text_all_w_t_and_m_t":"-- TAG-CG-CONFIG-INFO-START","paragraph_zero_based":52399},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":52400},{"literal_text_all_w_t_and_m_t":"CG-ConfigInfo ::=               SEQUENCE {","paragraph_zero_based":52401},{"literal_text_all_w_t_and_m_t":"    criticalExtensions              CHOICE {","paragraph_zero_based":52402},{"literal_text_all_w_t_and_m_t":"        c1                              CHOICE{","paragraph_zero_based":52403},{"literal_text_all_w_t_and_m_t":"            cg-ConfigInfo               CG-ConfigInfo-IEs,","paragraph_zero_based":52404},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":52405},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_