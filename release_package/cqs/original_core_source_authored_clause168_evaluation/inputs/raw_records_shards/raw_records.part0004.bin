{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB24 field descriptions","paragraph_zero_based":17880},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMCCH-MTCH","paragraph_zero_based":17881},{"literal_text_all_w_t_and_m_t":"Common frequency resource used for multicast MCCH and/or multicast MTCH reception. If the field is absent, the CFR for multicast has the same location and size as CORESET#0 and PDSCH configuration of multicast MCCH, if present, is the same as PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":17882},{"literal_text_all_w_t_and_m_t":"multicastMCCH-Config","paragraph_zero_based":17883},{"literal_text_all_w_t_and_m_t":"Indicates MCCH configuration for MBS multicast reception in RRC_INACTIVE. This field is always included if it is provided via broadcast signalling in SIB24.","paragraph_zero_based":17884},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17885},{"literal_text_all_w_t_and_m_t":"–SIB25","paragraph_zero_based":17886},{"literal_text_all_w_t_and_m_t":"SIB25 contains TN coverage information to assist neighbour cell measurements for the UEs in an NTN cell.","paragraph_zero_based":17887},{"literal_text_all_w_t_and_m_t":"SIB25 information element","paragraph_zero_based":17888},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17889},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB25-START","paragraph_zero_based":17890},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17891},{"literal_text_all_w_t_and_m_t":"SIB25-r18 ::=                  SEQUENCE {","paragraph_zero_based":17892},{"literal_text_all_w_t_and_m_t":"    coverageAreaInfoList-r18       CoverageAreaInfoList-r18         OPTIONAL,  -- Need R","paragraph_zero_based":17893},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension       OCTET STRING                     OPTIONAL,","paragraph_zero_based":17894},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17895},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17896},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17897},{"literal_text_all_w_t_and_m_t":"CoverageAreaInfoList-r18 ::=   SEQUENCE (SIZE (1..maxTN-AreaInfo-r18)) OF CoverageAreaInfo-r18","paragraph_zero_based":17898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17899},{"literal_text_all_w_t_and_m_t":"CoverageAreaInfo-r18 ::=       SEQUENCE {","paragraph_zero_based":17900},{"literal_text_all_w_t_and_m_t":"    tn-AreaId-r18                  TN-AreaId-r18,","paragraph_zero_based":17901},{"literal_text_all_w_t_and_m_t":"    tn-ReferenceLocation-r18       ReferenceLocation-r17,","paragraph_zero_based":17902},{"literal_text_all_w_t_and_m_t":"    tn-DistanceRadius-r18          INTEGER(0..65535)","paragraph_zero_based":17903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["058fa91f09225cad1042f3996d2ca58f19d4dac698156038b6123949d9288f95","fd70809f7eedac106efc3362624b51bf1f62f999113804f2917806883ab45bb8","ebd4d5047ac44b83de5598e260ec45fe58721c4d49386ea805dd124176fceaee","ad4d87a02ac84925236aa43b386354c76c1a0626ee1051ef42427b4ee675f72d","7668465bae5770bd3ac10fe086fa58112e28af7667add7b7778ec6a478e91d91","244b3904e4b501a3ec47c77faa6ceb7b8bf303c80df1aa26f084997eccee68ab","522d6d55646ca1722092ee34013503107b9e76f264dbd1dbc59c637c056f82e9","b23742ac76375791db27c5541aafb19cb4228759edd804342fe5e5eede9e9ded","5d72dfc8f75e75893910d6a7f00a02002ba7160800648335278baca0addb0847","f891f2bf5ab5c7472d9745bfce4309afb1bd1d4a68b7ba43e6516e85c4d4f7ef","d2ae3fda3006a3e406488d88ace022de2091a5cf47b104d6