{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the periodicity in slots and the offset of the starting slot with respect to SFN #0 slot #0 of the serving cell where the DL-PRS processing window is configured.","paragraph_zero_based":22224},{"literal_text_all_w_t_and_m_t":"length","paragraph_zero_based":22225},{"literal_text_all_w_t_and_m_t":"Indicates the length of DL-PRS processing window in slots. Value 1 indicates length of one slot, value 2 indicates length of two slots and so on.","paragraph_zero_based":22226},{"literal_text_all_w_t_and_m_t":"priority","paragraph_zero_based":22227},{"literal_text_all_w_t_and_m_t":"Indicates the priority between PDCCH/PDSCH/CSI-RS and PRS as specified in TS 38.214 [19].","paragraph_zero_based":22228},{"literal_text_all_w_t_and_m_t":"type","paragraph_zero_based":22229},{"literal_text_all_w_t_and_m_t":"Indicates the DL-PRS processing window type as specified in TS 38.214 [19].","paragraph_zero_based":22230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22231},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":22232},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":22233},{"literal_text_all_w_t_and_m_t":"MultiType","paragraph_zero_based":22234},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting multiple processing types, otherwise it is absent.","paragraph_zero_based":22235},{"literal_text_all_w_t_and_m_t":"MultiState","paragraph_zero_based":22236},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when the UE reports its capability on supporting option 1 or option 2 for the configured type, otherwise it is absent.","paragraph_zero_based":22237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22238},{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUCCH-Config","paragraph_zero_based":22239},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUCCH-Config-r17 is used to configure DMRS bundling for PUCCH.","paragraph_zero_based":22240},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config information element","paragraph_zero_based":22241},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22242},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-START","paragraph_zero_based":22243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22244},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config-r17 ::=         SEQUENCE {","paragraph_zero_based":22245},{"literal_text_all_w_t_and_m_t":"    pucch-DMRS-Bundling-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":22246},{"literal_text_all_w_t_and_m_t":"    pucch-TimeDomainWindowLength-r17          INTEGER (2..8)                                                  OPTIONAL,   -- Need S","paragraph_zero_based":22247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9c5f5d2b8e86db83413b3f3c8daa9065bfb9c0aae1cb4d74cdf5d0560704ee84","8495ece393d57a58260d743d91e5c37fdcd8fbfea871e8c5bb1c8389c29bc8c8","44c9663045f9867245ad91742c50925ea052c3844885f2ced0691a148259ed6b","3eafa4be07b608593f554faaf83583bb5456b96352636ccb55f0af89c622d8b0","15e1ad99348e815ef51a61ca29742807c62c3e267951ec52ac09c6d884ea0d73","a833c8ed437dbaa4a4d3cc55a8cc9b3398dae391ef8afd80442dd999ce5c54e9","3f6077b33a6b1153772292c1b641f3b970bd941189548b7eae2c6ac7f9becf2e","bceaa8152f457ce90bdcffeac87155bf572b6a032a057642c876d7b6db45106b","7480ff6a05ea8a6f040ed01adcb73bc1d00bf443ceacceea60a7e01ef6377791","7a76729e2e13913ac8a830d51396ae7e5c453eb62e2043e3bd35fd52f8623d8f","fb60382b7559de377f5e8003d041ec306d2ea02446671101b92c07f6de39686b","30d861259338e030d802270f1a0e6d2e5be1b61c65e601641ba12aa6aa64c2a4","ad4afa73ec39361a2ffc123a9ed5f17ecbb747297989710c399354b57caa4744","6670a36fbcd0496405b9e2d25a3ab43ce8d24dc731997d15a78ae86ea35a45fc","50ac2295ffcd49e14f71d933e64bd4dba61824ee8d1e5dd56d5e120e03d1a3c7","d05d01d27c593dfa2ca27a5b2155384f237ac1371ebe47dd71fc74a1ed4129a3","1fe10ceeabcdb38fd0be3a5944c3dfd405df28fc4092899005a5034dbb858ee2","084d74310f216e9236f4e7c2399d0c13f501cc6477587d715185a441c8cadd05","2c26e18e66562548e550a435a623770bbf19273c2b71f06d5f608933093b78c8","017ad9c571c72c80464f175dc8b525fab6e716aff426c0711fd5f1eb9a1eb293","07b9ead25d283ecfeda54a3f735367d08b12b553ffb3861a97fdb7c14f63e7be","e2f883ab7a916e8cfad011441a1b0369d5022713c48af954caf8fba2fae6974e","a34bbd8328a6e876a396e739f93f558be60db62e1cfff2fa82a7db92500c5dd4","86a148681e9f756dc8f72f8e006422a11234106e78bbad6b3c5b14a3350708a8"],"paragraph_range_zero_based":[22224,22247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22224"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pucch-WindowRestart-r17                   ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":22248},{"literal_text_all_w_t_and_m_t":"    pucch-FrequencyHoppingInterval-r17        ENUMERATED {s2, s4, s5, s10}                                    OPTIONAL,   -- Need S","paragraph_zero_based":22249},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22250},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22251},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22252},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUCCH-CONFIG-STOP","paragraph_zero_based":22253},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22255},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUCCH-Config field descriptions","paragraph_zero_based":22256},{"literal_text_all_w_t_and_m_t":"pucch-DMRS-Bundling","paragraph_zero_based":22257},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUCCH are jointly enabled.","paragraph_zero_based":22258},{"literal_text_all_w_t_and_m_t":"pucch-FrequencyHoppingInterval","paragraph_zero_based":22259},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUCCH. When both inter-frequency hopping and DMRS bundling are enabled for PUCCH repetitions, the UE is expected to be configured with at least one pucch-FrequencyHoppingInterval-r17 and pucch-TimeDomainWindowLength-r17. When DMRS bundling for PUCCH is enabled by pucch-DMRS-Bundling-r17, PUCCH frequency hopping interval is only determined by the configuration of PUCCH hopping interval if PUCCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUCCH frequency hopping is indicated by pucch-TimeDomainWindowLength-r17.","paragraph_zero_based":22260},{"literal_text_all_w_t_and_m_t":"pucch-TimeDomainWindowLength","paragraph_zero_based":22261},{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in slots for DMRS bundling for PUCCH. The value shall not exceed the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26]. If this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUCCH repetitions and the maximum duration for DMRS bundling for PUCCH as specified in TS 38.306 [26].","paragraph_zero_based":22262},{"literal_text_all_w_t_and_m_t":"pucch-WindowRestart","paragraph_zero_based":22263},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUCCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":22264},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":22265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22266},{"literal_text_all_w_t_and_m_t":"–DMRS-BundlingPUSCH-Config","paragraph_zero_based":22267},{"literal_text_all_w_t_and_m_t":"The IE DMRS-BundlingPUSCH-Config-r17 is used to configure DMRS bundling for PUSCH.","paragraph_zero_based":22268},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config information element","paragraph_zero_based":22269},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22270},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-START","paragraph_zero_based":22271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["03e6e340138b8df0c924f8094dcbb88a86d1c34ee977f8fc96696fb55c846a8e","d27c1f6888c217707ebaa2973169ce1f9425f011016cfa42b573a377ed8df93c","e992492a605d00979e3c2b46da10e364483e6677aeea658556b8826c9950e0a9","052157af7b1a26e1541f832df585f21fdb945eb68d991a26ef9b7825525d95f4","c3952cd3826ab32b51cdae587f26379a242bdb871d8efca3a255b36fbe94172f","91c481633a8794ba948df41f19a87e0de07731d59e0a7568b3f778a01c89ecc9","168c1f3df0301f74d20f243fdfac0d7f251ccc1dd55c8c05f5193fd5665f519d","079149bf6a29a1009413aa368ac2b33838c3f571a93bfec9a82a92cfab4c90f3","638b78a6aaccc2e734451e344ad65b425d970028038e2545e7aab599c0d441ea","ba50c93f2e36bfaad419102499622c7c5276d1517065632f91db040a0c92ec2c","db933800e3dc3f75a99c1f972a54a0c9743907a201b5616db78579842d372300","85b53ee543704d9dc05e107ff8d7db177fe51f93ad03944254b0e3dfc2606260","1fe1204c8970f062a2d6a4f3b2537a9fde914ace3319e7009e712076fae9cfd1","b2498dcaeab10e25ecbff25db015115cb6f55a0a33f82cdecd122d38c8dc701f","585bebf9a0e5a958833c76064e24ae12bfe5b774c6b359f76380bdf31b7b568c","650848e047a0c7577316004e916144c1f36f6f0bcf52c9ae1a797a0f6c6fae0d","f11f7f85b160b4b47171deafe893d7a2068d69c9544041925eca79e5ba9948ea","04c7990e77624f1b1f0aca5b99778f6f0ac2decfc6741ce10f9931f4721b48f3","77be776649d7211abab9f7463f43387f4070f2637a9e25ebba29ce34c529fadb","b13420b36bf131e6a5fad09f73dc85f54114f9650d6dd97f00ba4c04ad3f0eb5","e260636c6368c961d5e3d014685fc11f951615c42b4ca6a4fc3e4293bac2051e","fabf768dcf7199689cfb60865c829ad9ecd908c0b0da5d4f773a6be413539812","2c6fc458f5d6019a4f462ceabe172b79729b01be1eeb5a118be477f16bc5e238","5847d5bed929bbe15a7e0315d9c72b71f1d7e6d2f125d79f832547f99ec10dc2"],"paragraph_range_zero_based":[22248,22271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22272},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config-r17 ::=          SEQUENCE {","paragraph_zero_based":22273},{"literal_text_all_w_t_and_m_t":"    pusch-DMRS-Bundling-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":22274},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainWindowLength-r17           INTEGER (2..32)                                                 OPTIONAL,   -- Need S","paragraph_zero_based":22275},{"literal_text_all_w_t_and_m_t":"    pusch-WindowRestart-r17                    ENUMERATED {enabled}                                            OPTIONAL,   -- Need R","paragraph_zero_based":22276},{"literal_text_all_w_t_and_m_t":"    pusch-FrequencyHoppingInterval-r17         ENUMERATED {s2, s4, s5, s6, s8, s10, s12, s14, s16, s20}        OPTIONAL,   -- Need S","paragraph_zero_based":22277},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22278},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22280},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-BUNDLINGPUSCH-CONFIG-STOP","paragraph_zero_based":22281},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22283},{"literal_text_all_w_t_and_m_t":"DMRS-BundlingPUSCH-Config field descriptions","paragraph_zero_based":22284},{"literal_text_all_w_t_and_m_t":"pusch-DMRS-Bundling","paragraph_zero_based":22285},{"literal_text_all_w_t_and_m_t":"Indicates whether DMRS bundling and time domain window for PUSCH are jointly enabled.","paragraph_zero_based":22286},{"literal_text_all_w_t_and_m_t":"pusch-FrequencyHoppingInterval","paragraph_zero_based":22287},{"literal_text_all_w_t_and_m_t":"Configures the number of consecutive slots for the UE to perform inter-slot frequency hopping with inter-slot bundling for PUSCH. When both inter-frequency hopping and DMRS bundling are enabled for PUSCH repetitions, the UE is expected to be configured with at least one pusch-FrequencyHoppingInterval-r17 and pusch-TimeDomainWindowLength-r17. This parameter is shared for both DG-PUSCH and CG-PUSCH. When DMRS bundling for PUSCH is enabled by pusch-DMRS-Bundling-r17, PUSCH frequency hopping interval is only determined by the configuration of PUSCH hopping interval if PUSCH hopping interval is configured. If the field is absent, the number of consecutive slots for the UE to perform inter-slot PUSCH frequency hopping is indicated by pusch-TimeDomainWindowLength-r17.","paragraph_zero_based":22288},{"literal_text_all_w_t_and_m_t":"Note: For unpaired spectrum, the UE is not expected to be configured the value of s6, s8, s12, s14 and s16.","paragraph_zero_based":22289},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainWindowLength","paragraph_zero_based":22290},{"literal_text_all_w_t_and_m_t":"Configures the length of a nominal time domain window in number of consecutive slots for DMRS bundling for PUSCH. The value shall not exceed the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For PUSCH repetition type A/B, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the time duration for the transmission of all PUSCH repetitions and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26]. For TBoMS, if this field is absent, the UE shall apply the default value that is the minimum value in the unit of consecutive slots of the duration of TBoMS transmission (including repetition of TBoMS) and the maximum duration for DMRS bundling for PUSCH as specified in TS 38.306 [26].","paragraph_zero_based":22291},{"literal_text_all_w_t_and_m_t":"pusch-WindowRestart","paragraph_zero_based":22292},{"literal_text_all_w_t_and_m_t":"Indicates whether UE bundles PUSCH DMRS remaining in a nominal time domain window after event(s) triggered by DCI or MAC CE that violate power consistency and phase continuity requirements is enabled (see TS 38.214 [19], clause 6.1.7).","paragraph_zero_based":22293},{"literal_text_all_w_t_and_m_t":"NOTE:Events, which are triggered by DCI or MAC CE, but do not require UE capability to resume maintaining power consistency and/or phase continuity as specified in clause 6.1.7 of TS 38.214 [19], are excluded.","paragraph_zero_based":22294},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2def3639e9ff618649ce24de3a5368d19a3e6183f8902ada34e9a05d08feb769","3995aa5452dc2fcaff82903e67d23f70377a71d0598c69220762566cbd33e3cd","351cd34de3df612c233313bc61effcfa0d7033500a36cbf0f0c5af6acc22b56c","21cf6056d11040097e29d8567c61846da55db3d597f78e41c5eefdc4f9a49388","a9020dbb86d2407fd57c67bafeebf7c59b9802b836e31269a6da8389a7220cb1","02deb50c8e6250fb11b98a4fe2ce8d76f8939f84c5d2ef1308bdec46dec28247","f2817f312d3e6985b882dacd30ab76ae4dabe1c5729975e7cbc39e6faa91da40","8982e291ed52c3c86d58cd4ce70f822b3db3461c96bfee242a3dfae00f8cc188","85cae23435a7a66ebe46b8d283564096d5fe84c6fbebc52592cf35c1c5320da7","4d908db18a1548699be0cc13c1a540a3bd2a0720f451ce511c6084c1f123b5ae","c6f0661175440d0c805d573e80b3a18e153c9a6da65f1c0619dffc1df8eb69ab","d3a247a6d9df8398b068815d668c199435e397ef9bbd85cebc73ab40c8da3326","e6c73f2f2d78ed53accccc3302c17f4beb43e4b6b7cb7f6e42363227624787bb","c9fb2537dd504d539c48bf98eeec44b09424cbcfe0650c164d235121404dc197","0dedfdbc154e3cd6264c4b60da6fed36e3807489fdffa169b247fb81f781a6a1","635af641f0077b4a031ce5cd981b4ca574ad1851a3d13d764e03d0d0fff44dda","cf4f29271e4868cb0355e0003c939ac7c184a915a58924b79012359649622b63","00a734d0420008af8b46a1038b87a9e9bc261bedbe3ee63f1c3246b3ac5563b9","8ba3db2eb07b8510c2d47f750876543c4d97f434a51fea2a43c6f9bbd3e19214","57b2b5e798780edee2092cf81df36b516605912bc876968c0876cc568bc49471","a3f60f1f76d5c6db5d3bda31ce5237f6744e3c213f3d6441450202e92d6a83ea","a07fbe7d093e2868f9ddfabb50face8daead465d8e31e2cd3a82236dd21dc95a","0d76005164cd4af7d01aa59432b9d0c39057271050fd0b67df74648f61abb34a","37ca8e739ac7d5ed947654d65479b943558cfbd7462cd2bc422ab25b9c054ee4"],"paragraph_range_zero_based":[22272,22295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22272"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–DMRS-DownlinkConfig","paragraph_zero_based":22296},{"literal_text_all_w_t_and_m_t":"The IE DMRS-DownlinkConfig is used to configure downlink demodulation reference signals for PDSCH.","paragraph_zero_based":22297},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig information element","paragraph_zero_based":22298},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22299},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-DOWNLINKCONFIG-START","paragraph_zero_based":22300},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22301},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig ::=             SEQUENCE {","paragraph_zero_based":22302},{"literal_text_all_w_t_and_m_t":"    dmrs-Type                           ENUMERATED {type2}                                                      OPTIONAL,   -- Need S","paragraph_zero_based":22303},{"literal_text_all_w_t_and_m_t":"    dmrs-AdditionalPosition             ENUMERATED {pos0, pos1, pos3}                                           OPTIONAL,   -- Need S","paragraph_zero_based":22304},{"literal_text_all_w_t_and_m_t":"    maxLength                           ENUMERATED {len2}                                                       OPTIONAL,   -- Need S","paragraph_zero_based":22305},{"literal_text_all_w_t_and_m_t":"    scramblingID0                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":22306},{"literal_text_all_w_t_and_m_t":"    scramblingID1                       INTEGER (0..65535)                                                      OPTIONAL,   -- Need S","paragraph_zero_based":22307},{"literal_text_all_w_t_and_m_t":"    phaseTrackingRS                     SetupRelease { PTRS-DownlinkConfig  }                                   OPTIONAL,   -- Need M","paragraph_zero_based":22308},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22309},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22310},{"literal_text_all_w_t_and_m_t":"    dmrs-Downlink-r16               ENUMERATED {enabled}                                                        OPTIONAL    -- Need R","paragraph_zero_based":22311},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22312},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22313},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeEnh-r18                ENUMERATED {enabled}                                                        OPTIONAL    -- Need R","paragraph_zero_based":22314},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22315},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22317},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":22318},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["70c83f2303c49e3d29df5303375e81bb7abbf10a10658f7b9452d0c975185406","4a889591ea3fccd6b73fdf930738bfe20cdc28af18f5ab8d48e0e02eba2dca48","69e59d5d1a73d4a153063ae92179fd3440b5722383b4fb82d92c16098b364bd9","0dcdcb00cb9e446cf48c8507f239729bf33d6206f95a2473c099c804a866c86c","beb3e12a662fd7a52f586304370329025669e79c13eacbfcc032ca71c7caa25e","a90eb0f2df665165e99ffb6eca34a5fe3b966b36a11fb21f267bef9d0c59ea6c","554aecae6c638b105c15b7d9da585627cbe06f191de954bd5038444d934e81bf","c6b465d7c70524f575d1eaf9384fa0f0eb42ea65f7e7673db45375bb093e995d","8cf3870859fc4dc03e33897e77d0928e4938e4455930575a907d894b772d3d42","5a8b5ee0cdb37132837c7b1df015f0746022f4c872a754ccd8c108efaf7eae17","72b7b83fc25199e1ee623de31d32a85fb575dc060e02c1e10de419a7f5a80c05","5b47599e3547da769f96a71a7c02ec71f92ffe25e003d84f2083167c0dc8a7ff","4e1c6d436812290585e433a338bb81873cbdb4f35e93aeb89951d02edc6ccdd8","8ce9fb1c7cd2b42d5268fbe2848e1c4765c12a82b41a47f400368142c3d9b98d","c1767e856ee01d413ec57014e618f76929d92fd6ea9905aaba7fb8ea80d663c9","4fd550ffaeca6435643d61083c6f2dd31003a8a93b14ac94af65b92b509dc635","ce797eaa7b4b9d68ed2bae0e06be43e778228c1a2afea914c1ed9e5a0776c419","ee3cdb4131d409ffc172d60ecdde2526596479be5a6c6638811dc7077f41dd9c","d84ae4d93cf15cc3b4891b6d77eaad22b9c74933f485603a38c54d2a3f9c4969","a9ef686fed09c5b517b08fa294b5e066b9485e17c7f617ba9db699d9d31afa0c","95fe74a92333a8b7b5803aa05b35f0b06c6060a65699ac759d883b78c892dcb2","bb90c9a258886a678b6a3161b81d35cb3a9890e5825010d8ee6094e9a0000960","7183a9e911ed7c2c1930bbd5733abd31b27dbe2668fc93637fdb178b15b9628c","59a3161a045bd92eec7f7fd6c87c0c89e872e658284e32fa2c98adc6bd272cf0"],"paragraph_range_zero_based":[22296,22319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22296"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22320},{"literal_text_all_w_t_and_m_t":"DMRS-DownlinkConfig field descriptions","paragraph_zero_based":22321},{"literal_text_all_w_t_and_m_t":"dmrs-AdditionalPosition","paragraph_zero_based":22322},{"literal_text_all_w_t_and_m_t":"Position for additional DM-RS in DL, see Tables 7.4.1.1.2-3 and 7.4.1.1.2-4 in TS 38.211 [16]. If the field is absent, the UE applies the value pos2. See also clause 7.4.1.1.2 for additional constraints on how the network may set this field depending on the setting of other fields.","paragraph_zero_based":22323},{"literal_text_all_w_t_and_m_t":"dmrs-Downlink","paragraph_zero_based":22324},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used, as specified in TS38.211 [16], clause 7.4.1.1.1.","paragraph_zero_based":22325},{"literal_text_all_w_t_and_m_t":"dmrs-Type","paragraph_zero_based":22326},{"literal_text_all_w_t_and_m_t":"Selection of the DMRS type to be used for DL (see TS 38.211 [16], clause 7.4.1.1.1). If the field is absent, the UE uses DMRS type 1.","paragraph_zero_based":22327},{"literal_text_all_w_t_and_m_t":"dmrs-TypeEnh","paragraph_zero_based":22328},{"literal_text_all_w_t_and_m_t":"Enables the use of enhanced DMRS type1 or enhanced DMRS type2 with field dmrs-Type (see TS 38.211 [16], clause 7.4.1.1.1). If the field is present and dmrs-Type is absent, the UE uses DMRS eType 1. If the field is present and dmrs-Type is present, the UE uses DMRS eType 2.","paragraph_zero_based":22329},{"literal_text_all_w_t_and_m_t":"maxLength","paragraph_zero_based":22330},{"literal_text_all_w_t_and_m_t":"The maximum number of OFDM symbols for DL front loaded DMRS. len1 corresponds to value 1. len2 corresponds to value 2. If the field is absent, the UE applies value len1. If set to len2, the UE determines the actual number of DM-RS symbols by the associated DCI. (see TS 38.211 [16], clause 7.4.1.1.2).","paragraph_zero_based":22331},{"literal_text_all_w_t_and_m_t":"phaseTrackingRS","paragraph_zero_based":22332},{"literal_text_all_w_t_and_m_t":"Configures downlink PTRS. If the field is not configured, the UE assumes that downlink PTRS are absent. See TS 38.214 [19] clause 5.1.6.3.","paragraph_zero_based":22333},{"literal_text_all_w_t_and_m_t":"scramblingID0","paragraph_zero_based":22334},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":22335},{"literal_text_all_w_t_and_m_t":"scramblingID1","paragraph_zero_based":22336},{"literal_text_all_w_t_and_m_t":"DL DMRS scrambling initialization (see TS 38.211 [16], clause 7.4.1.1.1). When the field is absent the UE applies the value physCellId configured for this serving cell.","paragraph_zero_based":22337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22338},{"literal_text_all_w_t_and_m_t":"–DMRS-UplinkConfig","paragraph_zero_based":22339},{"literal_text_all_w_t_and_m_t":"The IE DMRS-UplinkConfig is used to configure uplink demodulation reference signals for PUSCH.","paragraph_zero_based":22340},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig information element","paragraph_zero_based":22341},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22342},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-START","paragraph_zero_based":22343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a23a0526e741