{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                               spare7, spare6, spare5, spare4, spare3,spare2, spare1},","paragraph_zero_based":46920},{"literal_text_all_w_t_and_m_t":"    sl-ConfiguredGrantType1Allowed-r16         ENUMERATED {true}                                                   OPTIONAL,   -- Need R","paragraph_zero_based":46921},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-FeedbackEnabled-r16                ENUMERATED {enabled, disabled }                                     OPTIONAL,   -- Need R","paragraph_zero_based":46922},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCG-List-r16                      SEQUENCE (SIZE (0.. maxNrofCG-SL-1-r16)) OF SL-ConfigIndexCG-r16","paragraph_zero_based":46923},{"literal_text_all_w_t_and_m_t":"                                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":46924},{"literal_text_all_w_t_and_m_t":"    sl-AllowedSCS-List-r16                     SEQUENCE (SIZE (1..maxSCSs)) OF SubcarrierSpacing                   OPTIONAL,   -- Need R","paragraph_zero_based":46925},{"literal_text_all_w_t_and_m_t":"    sl-MaxPUSCH-Duration-r16                   ENUMERATED {ms0p02, ms0p04, ms0p0625, ms0p125, ms0p25, ms0p5, spare2, spare1}","paragraph_zero_based":46926},{"literal_text_all_w_t_and_m_t":"                                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":46927},{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelGroup-r16                 INTEGER (0..maxLCG-ID)                                              OPTIONAL,   -- Need R","paragraph_zero_based":46928},{"literal_text_all_w_t_and_m_t":"    sl-SchedulingRequestId-r16                 SchedulingRequestId                                                 OPTIONAL,   -- Need R","paragraph_zero_based":46929},{"literal_text_all_w_t_and_m_t":"    sl-LogicalChannelSR-DelayTimerApplied-r16  BOOLEAN                                                             OPTIONAL,   -- Need R","paragraph_zero_based":46930},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46931},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46932},{"literal_text_all_w_t_and_m_t":"    sl-ChannelAccessPriority-r18               INTEGER (1..4)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":46933},{"literal_text_all_w_t_and_m_t":"    sl-AllowedCarriers-r18           SEQUENCE (SIZE (1..maxNrofFreqSL-r16)) OF INTEGER (1..maxNrofFreqSL-r16) OPTIONAL -- Cond CONNECTED","paragraph_zero_based":46934},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46935},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46936},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-STOP","paragraph_zero_based":46937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46939},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig field descriptions","paragraph_zero_based":46940},{"literal_text_all_w_t_and_m_t":"sl-AllowedCarriers","paragraph_zero_based":46941},{"literal_text_all_w_t_and_m_t":"If present, SL MAC SDUs from this logical channel can only be mapped to the sidelink carriers indicated in this list. Otherwise, SL MAC SDUs from this logical channel can be mapped to any configured sidelink carriers. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":46942},{"literal_text_all_w_t_and_m_t":"sl-AllowedCG-List","paragraph_zero_based":46943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ff49c199de2b6b64d9de100282acb50b41ee731f456ab522f6d2e942481f6c99","bd3285d8b26ec9939421110f1bb00bfb3043851ceb44508274f5f33a7ef5f48d","93e9afa83296549ea2571e6ad15613d6d0dc94351caaf5aa5bb3f02dcc0c7231","f01c1a713bd7cda4b7a8153ea6260107f6ae102ff5ba9dfee8aa81662f2c5803","26fce7d693c6faf6d838859abeb7e4705db06371934ac1e0090debaaa74074b2","bd09c16d9a8c9b52a0bf229111029f3a462529fd6c727f23c40f3200d173ae81","4d30c57b3cb41b77abc7f41fefc9b3491186aab0aba74bf5c1c54d1e0bcc578d","a88ce6e200e641a9acaadb28b69b90c5490eac52707e3b3d116e927bfccabba4","17dc62a2e95a7681d49f907c80a2f222fdf7886d5808923c8fa05f735837bdd2","1c83890810f54df9eeb4bfd10ecf8054cc6aaa257a551ce790d4b692394dca14","97119ddc8febb34d41b5333f1804541c64ae1d138774b6455e90f27cb61c3ea6","54b2f0147285f03331d3059575e09dbdc7fa55c694855f196df5727f7e0bd206","3328c9d242dc8ecc93c14ae4fb910c0349f90f37daec4159ba6da29991be906a","b1671bd53808d55d4ecd5383780d2df1b2e3f322647d0b9f91dcca42513db0d7","5c37c5bb2949c86f75bef573c699cb6296c6f2162fb2188907412746b4fc27ee","4ef308be4d9aebb83c509cdb0c63dacfe7103f520d042f62e3ae60bd5b147467","45faacc47417e232e6d6f447ca30635f4f77d2c63a9e8fa7aac0b165d930b0e4","bde647ee7ce5a75bafd64a3ae062c24536869e130f53731dfa25da3bbaf73881","00c6ebda5eaffb4a70918ab3efac26272bc17fc1097aa2915d5018f67fc0c605","259c24ce12e56c0405a13c408799c7211b095c1a5018b30078e2e1074ed68ca2","33e8ef06c3c8ba9dba54efc7d1560f6fbf0b358d625cc379ef64f8cdf27dfcd0","ce2f90846105153de75c146e05d76f7eed527309cd648ceae095977badf3cf8d","c47ab8e3ec55abe390bd0f693630f2e98c89a2492bc41f75b1cfefe4706c8726","2e8d2c253684f98875e1593b975fb805511bd0196b2ab8f0be3d2f7574580d6a"],"paragraph_range_zero_based":[46920,46943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46920"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This restriction applies only when the SL grant is a configured grant. If present, SL MAC SDUs from this logical channel can only be mapped to the indicated configured grant configuration. If the size of the sequence is zero, then SL MAC SDUs from this logical channel cannot be mapped to any configured grant configurations. If the field is not present, SL MAC SDUs from this logical channel can be mapped to any configured grant configurations. If the field sl-ConfiguredGrantType1Allowed is present, only those sidelink configured grant type 1 configurations indicated in this sequence are allowed for use by this sidelink logical channel; otherwise, this sequence shall not include any sidelink configured grant type 1 configuration. Corresponds to \"sl-AllowedCG-List\" as specified in TS 38.321 [3].","paragraph_zero_based":46944},{"literal_text_all_w_t_and_m_t":"sl-AllowedSCS-List","paragraph_zero_based":46945},{"literal_text_all_w_t_and_m_t":"If present, indicate the numerology of UL-SCH resources that this sidelink logical channel is mapped to, when checking the SR trigger condition. Corresponds to ' sl-AllowedSCS-List' in TS 38.321 [3].","paragraph_zero_based":46946},{"literal_text_all_w_t_and_m_t":"sl-BucketSizeDuration","paragraph_zero_based":46947},{"literal_text_all_w_t_and_m_t":"Value in ms. ms5 corresponds to 5 ms, value ms10 corresponds to 10 ms, and so on.","paragraph_zero_based":46948},{"literal_text_all_w_t_and_m_t":"sl-ChannelAccessPriority","paragraph_zero_based":46949},{"literal_text_all_w_t_and_m_t":"Indicates the Channel Access Priority Class (CAPC), as specified in TS 38.300 [2], to be used on sidelink transmissions for operation with shared spectrum channel access in FR1. The network configures this field only for DRBs.","paragraph_zero_based":46950},{"literal_text_all_w_t_and_m_t":"sl-ConfiguredGrantType1Allowed","paragraph_zero_based":46951},{"literal_text_all_w_t_and_m_t":"If present and set to true, or if the capability lcp-RestrictionSidelink as specified in TS 38.306 [26] is not indicated, SL MAC SDUs from this sidelink logical channel can be transmitted on a sidelink configured grant type 1. Otherwise, SL MAC SDUs from this logical channel cannot be transmitted on a sidelink configured grant type 1. Corresponds to 'sl-configuredGrantType1Allowed' in TS 38.321 [3].","paragraph_zero_based":46952},{"literal_text_all_w_t_and_m_t":"sl-HARQ-FeedbackEnabled","paragraph_zero_based":46953},{"literal_text_all_w_t_and_m_t":"Network always includes this field. It indicates the HARQ feedback enabled/disabled restriction in LCP for this sidelink logical channel. If set to enabled, the sidelink logical channel will be multiplexed only with a logical channel which enabling the HARQ feedback. If set to disabled, the sidelink logical channel cannot be multiplexed with a logical channel which enabling the HARQ feedback. Corresponds to 'sl-HARQ-FeedbackEnabled' in TS 38.321 [3]. If this field of at least one sidelink logical channel for the UE is set to enabled, sl-PSFCH-Config should be mandatory present in configuration SL-ResourcePool of at least one of the sidelink resource pools.","paragraph_zero_based":46954},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelGroup","paragraph_zero_based":46955},{"literal_text_all_w_t_and_m_t":"ID of the sidelink logical channel group, as specified in TS 38.321 [3], which the sidelink logical channel belongs to.","paragraph_zero_based":46956},{"literal_text_all_w_t_and_m_t":"sl-LogicalChannelSR-DelayTimerApplied","paragraph_zero_based":46957},{"literal_text_all_w_t_and_m_t":"Indicates whether to apply the delay timer for SR transmission for this sidelink logical channel. Set to false if logicalChannelSR-DelayTimer is not included in sl-BSR-Config.","paragraph_zero_based":46958},{"literal_text_all_w_t_and_m_t":"sl-MaxPUSCH-Duration","paragraph_zero_based":46959},{"literal_text_all_w_t_and_m_t":"If present, indicate the maximum PUSCH duration of UL-SCH resources that this sidelink logical channel is mapped to, when checking the SR trigger condition. Corresponds to \"sl-MaxPUSCH-Duration\" in TS 38.321 [3].","paragraph_zero_based":46960},{"literal_text_all_w_t_and_m_t":"sl-PrioritisedBitRate","paragraph_zero_based":46961},{"literal_text_all_w_t_and_m_t":"Value in kiloBytes/s. Value kBps0 corresponds to 0 kiloBytes/s, value kBps8 corresponds to 8 kiloBytes/s, value kBps16 corresponds to 16 kiloBytes/s, and so on.","paragraph_zero_based":46962},{"literal_text_all_w_t_and_m_t":"sl-Priority","paragraph_zero_based":46963},{"literal_text_all_w_t_and_m_t":"Sidelink logical channel priority, as specified in TS 38.321 [3].","paragraph_zero_based":46964},{"literal_text_all_w_t_and_m_t":"sl-SchedulingRequestId","paragraph_zero_based":46965},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for this sidelink logical channel, as specified in TS 38.321 [3].","paragraph_zero_based":46966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1e9eccf21f72406bc86be34fd770c2cdea8e6665757aed45ede163eeb19c4211","999dbea2b4594760259a7011aefb1679ade68d4a889a5d74ecf95ac65ba8bb62","76ac2e3d1d4225684cf8158798a1c90d5f522a2b586158e00c870cd89f691eaa","145674228c68ee477f0752d6fffd3dd33c5d5ffae1b4a8bf626f3a82de8d95ee","3fe7fce797dc6c02b0f067fa1067d6822fa5019462f7d544aeca5ab2170633c9","fb704d520a9bf8f27824473ec1043fd79bafd3cb49f272d536ec364ce59e2225","fc91301a343b