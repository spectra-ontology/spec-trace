{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    csi-ResourceConfigId        CSI-ResourceConfigId,","paragraph_zero_based":21816},{"literal_text_all_w_t_and_m_t":"    csi-RS-ResourceSetList      CHOICE {","paragraph_zero_based":21817},{"literal_text_all_w_t_and_m_t":"        nzp-CSI-RS-SSB              SEQUENCE {","paragraph_zero_based":21818},{"literal_text_all_w_t_and_m_t":"            nzp-CSI-RS-ResourceSetList  SEQUENCE (SIZE (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig)) OF NZP-CSI-RS-ResourceSetId","paragraph_zero_based":21819},{"literal_text_all_w_t_and_m_t":"                                                                                                                            OPTIONAL, -- Need R","paragraph_zero_based":21820},{"literal_text_all_w_t_and_m_t":"            csi-SSB-ResourceSetList     SEQUENCE (SIZE (1..maxNrofCSI-SSB-ResourceSetsPerConfig)) OF CSI-SSB-ResourceSetId  OPTIONAL  -- Need R","paragraph_zero_based":21821},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":21822},{"literal_text_all_w_t_and_m_t":"        csi-IM-ResourceSetList      SEQUENCE (SIZE (1..maxNrofCSI-IM-ResourceSetsPerConfig)) OF CSI-IM-ResourceSetId","paragraph_zero_based":21823},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21825},{"literal_text_all_w_t_and_m_t":"    bwp-Id                      BWP-Id,","paragraph_zero_based":21826},{"literal_text_all_w_t_and_m_t":"    resourceType                ENUMERATED { aperiodic, semiPersistent, periodic },","paragraph_zero_based":21827},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21828},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21829},{"literal_text_all_w_t_and_m_t":"    csi-SSB-ResourceSetListExt-r17      CSI-SSB-ResourceSetId                                                  OPTIONAL  -- Need R","paragraph_zero_based":21830},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21831},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21833},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIG-STOP","paragraph_zero_based":21834},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21836},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig field descriptions","paragraph_zero_based":21837},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":21838},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS associated with this CSI-ResourceConfig are located in (see TS 38.214 [19], clause 5.2.1.2.","paragraph_zero_based":21839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e4f0626682850bb4f06673ffd11dcd0177b3143dcf53f6489e27d96864e3c1ac","5ca320e7674845d9e28e201bc0049857b32d302932f27095eef75c0059dbb4db","174fbfb5c79fe2c94cd78d46aeb35819bd3ef279a8daad6b7254f4a815a3abfa","312ab24c9e25c3763698c2bb808c68b91443a7710efebea32678226ad1e057c3","24aa49b9e8cbee8e02bf5c2d58be0e950b2c881a55cf81aa68be9513ae64f413","16e7ff1a68f432b91cf31294521c0f23cc72e3f5424d6bfe3f3ac24a666b5148","8a27f36d9004783123e13a216d598d14af64b14e85f21837290eaf838c4e0272","3e0678422e1722fa83129c1f7c3268647c39c9291d7b0f6730fdb9ddc38ec487","1c1ba28b9cfe5f51c70bc47d6f03593c05dca4beb26d6c0b8f17ccd455fb4a20","03d8a73a327ea5e158fbb785c222e64cfdc1c2c57ec7eb3077c311be1f1c6665","d70e2874ba8013c2adba8c0d3e7a0dac75bdf463ff25a9e10cf830f7ad9d7c95","580cf062a80f2104271c6cca3e2d16cc4a5942e5deee4ef135a3fef8606fb4ee","027eed5fe62bfb19b6f85ab1623ed98c9509daca9c855da031a36ec8f9541777","e9c722f1bd2eb00ed795a0f36b99f7988cae877f012aa61785f6713d32e67736","cc9e0228fc029dfb8b70e38f3947e5881f5a611457df5809cb059799c31237bc","acb0eae283e64dda57d25bf1dfe642782aab29945ac6461d64a68c166802baf3","2eb9cbf8372481b4eadca34bc4bb9417d10a5b3028af4d41b9411921947393e7","c83b3e7af0a800a98ddbabccd3bf9c63f66b8b375eb49f9dfae0360ef90fc5bb","6d2b1eadc687b5b876dc1681df3a5d6fa725db60c790f3cb58feb5dd23d202a8","8ff4efbb9408b1cafc8410cb8e38eeeb97727dd93b1cdc97b280ed54043dd97c","ea445976b638875ef383ec033ffb8baf104df8b2c4edf59a510743a72246ce38","6ce7717d31fac8ecafe899abe4e9a88707c5e1fa7221c5d23dab82954f734476","fef8d9f295c909e9d7dcdda26d13183a4d2c7cbec4bdb06be00ce4afd53152f0","90e6890a13f7e266be1e3a092dedfc969ec98da1669ff0a0a74beb1d54b018d5"],"paragraph_range_zero_based":[21816,21839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21816"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceSetList","paragraph_zero_based":21840},{"literal_text_all_w_t_and_m_t":"List of references to CSI-IM resources used for CSI measurement and reporting in a CSI-RS resource set. Contains up to maxNrofCSI-IM-ResourceSetsPerConfig resource sets if resourceType is 'aperiodic' and 1 otherwise (see TS 38.214 [19], clause 5.2.1.2).","paragraph_zero_based":21841},{"literal_text_all_w_t_and_m_t":"csi-ResourceConfigId","paragraph_zero_based":21842},{"literal_text_all_w_t_and_m_t":"Used in CSI-ReportConfig to refer to an instance of CSI-ResourceConfig.","paragraph_zero_based":21843},{"literal_text_all_w_t_and_m_t":"csi-SSB-ResourceSetList, csi-SSB-ResourceSetListExt","paragraph_zero_based":21844},{"literal_text_all_w_t_and_m_t":"List of references to SSB resources used for CSI measurement and reporting in a CSI-RS resource set (see TS 38.214 [19], clause 5.2.1.2). The csi-SSB-ResourceSetListExt provides additional references and can only be configured if csi-SSB-ResourceSetList is configured and groupBasedBeamReporting-v1710 is configured in the CSI-ReportConfig that indicates this CSI-ResourceConfig as resourcesForChannelMeasurement. If groupBasedBeamReporting-v1710 is configured in the IE CSI-ReportConfig that indicates this CSI-ResourceConfig as resourceForChannelMeasurement, the network configures 2 resource sets, which may be two CSI SSB resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1.","paragraph_zero_based":21845},{"literal_text_all_w_t_and_m_t":"nzp-CSI-RS-ResourceSetList","paragraph_zero_based":21846},{"literal_text_all_w_t_and_m_t":"List of references to NZP CSI-RS resources used for beam measurement and reporting in a CSI-RS resource set.","paragraph_zero_based":21847},{"literal_text_all_w_t_and_m_t":"If resourceType is set to 'aperiodic', the network configures up to maxNrofNZP-CSI-RS-ResourceSetsPerConfig resource sets. If resourceType is is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is not configured in IE CSI-ReportConfig, the network configures 1 resource set. If resourceType is set to 'periodic' or 'semiPersistent' and groupBasedBeamReporting-v1710 is configured, the network configures 2 resource sets, which may be two NZP CSI-RS resource sets (see TS 38.214 [19], clause 5.2.1.2 and 5.2.1.4.2). In this case, in TS 38.212 [17] Table 6.3.1.1.2-8B, the first resource set is indicated by a resource set indicator set to 0 and the second resource set by a resource set indicator set to 1. If resourceType is set to 'periodic' and reportQuantity is set to 'TDCP', the network configures up to 3 resource sets, see TS 38.214 [19] clause 5.2.1.2.","paragraph_zero_based":21848},{"literal_text_all_w_t_and_m_t":"resourceType","paragraph_zero_based":21849},{"literal_text_all_w_t_and_m_t":"Time domain behavior of resource configuration (see TS 38.214 [19], clause 5.2.1.2). It does not apply to resources provided in the csi-SSB-ResourceSetList.","paragraph_zero_based":21850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21851},{"literal_text_all_w_t_and_m_t":"–CSI-ResourceConfigId","paragraph_zero_based":21852},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourceConfigId is used to identify a CSI-ResourceConfig.","paragraph_zero_based":21853},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId information element","paragraph_zero_based":21854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21855},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-START","paragraph_zero_based":21856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21857},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfigId ::=            INTEGER (0..maxNrofCSI-ResourceConfigurations-1)","paragraph_zero_based":21858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21859},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIGID-STOP","paragraph_zero_based":21860},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21862},{"literal_text_all_w_t_and_m_t":"–CSI-ResourcePeriodicityAndOffset","paragraph_zero_based":21863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["22fb6b64e7baa14c0a311a624ec3e396aeedbc63973d91ed5486299b7fad0a8b","c6a54fe7006c0c8a5eca4de452f5df190a0902d5154098bf233597b3f62bb123","b4bade438ba68dee3039eb821c28fc8958183035bed45ef28df7c82a0a709337","9971ca5a1e1e2a1921db89ab184a8cf22ae7af70e6fc5a810c35fe267170770f","c13a3848620c0659fdcda88375bea5f01e50457bc34c5cf70f36f30736a6ac5e","968472fb73ac18c6714e998e73a897edce73a6733293c52190d86e24e70ef3bd","35110eb151e63561072660a5356bcea91a2c3ffdb46c187451f3fab2a4661b1c","2039000a1f8400b76c2a965bcb80f76dd1656353f8bbde165927f435bccd86a7","24f3c27be730e3a6822235249171c47f1b3faf11769db2545a85889de115edf9","d24c859e2a61e86e9052cdbd4648d7e86071df12bb3d9c0cbc96d9ef7f218d0e","94eaddebb63e788133f12516b6a4934e5aa3cdefe1482ff0f8f629e054529cea","6d45f15196ce23a08f0f1cd391cdef99620b1e3fc47cc4cbbe762b8750e9c250","c0002ee5788146712c25e0208df1cc525f6c514630bf38a057fcb013e44e97b4","2250c5384f9e9534f3814106585b8b73958dfd669b65c970dce70b39e0e8ce08","1fe04ddd0c677514266dcd3d89bcbfa8bb94300cf50af8e51364f22fe6d67598","82d21bd8c6d1e957f33870db94313cc561ee8ddd127374c7092e287a28c70fba","b8e3e88b3ac7dc807a06