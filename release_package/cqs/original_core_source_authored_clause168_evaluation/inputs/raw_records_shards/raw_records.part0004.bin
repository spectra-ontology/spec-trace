{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":16344},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16346},{"literal_text_all_w_t_and_m_t":"ULInformationTransferIRAT-r16-IEs ::=        SEQUENCE {","paragraph_zero_based":16347},{"literal_text_all_w_t_and_m_t":"    ul-DCCH-MessageEUTRA-r16                           OCTET STRING             OPTIONAL,","paragraph_zero_based":16348},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                           OCTET STRING              OPTIONAL,","paragraph_zero_based":16349},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                                SEQUENCE {}               OPTIONAL","paragraph_zero_based":16350},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16351},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16352},{"literal_text_all_w_t_and_m_t":"-- TAG-ULINFORMATIONTRANSFERIRAT-STOP","paragraph_zero_based":16353},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16355},{"literal_text_all_w_t_and_m_t":"ULInformationTransferIRAT field descriptions","paragraph_zero_based":16356},{"literal_text_all_w_t_and_m_t":"ul-DCCH-MessageEUTRA","paragraph_zero_based":16357},{"literal_text_all_w_t_and_m_t":"Includes the UL-DCCH-Message as defined in TS 36.331 [10]. In this version of the specification, the field is only used to transfer the E-UTRA RRC MeasurementReport, E-UTRA RRC SidelinkUEInformation and the E-UTRA RRC UEAssistanceInformation messages.","paragraph_zero_based":16358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16359},{"literal_text_all_w_t_and_m_t":"–ULInformationTransferMRDC","paragraph_zero_based":16360},{"literal_text_all_w_t_and_m_t":"The ULInformationTransferMRDC message is used for the uplink transfer of MR-DC dedicated information (e.g. for transferring the NR or E-UTRA RRC MeasurementReport message, the FailureInformation message, the UEAssistanceInformation message, the RRCReconfigurationComplete message, the IABOtherInformation message or the NR or E-UTRA RRC MCGFailureInformation message).","paragraph_zero_based":16361},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1, SRB3","paragraph_zero_based":16362},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":16363},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":16364},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":16365},{"literal_text_all_w_t_and_m_t":"ULInformationTransferMRDC message","paragraph_zero_based":16366},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6a5cb96e9954a8ef9611a5eafa9a3e582b023350afe8d337db155d65f1d88c41","58c3be0b952389683c27e31e47338b1997bdca19915c63284b621067ddf2d9ea","1946cfcf47d0f06e99a72e2a526a6782676fe3014afc9f44a63ab04b3688e526","2ebdeb208ea9bbf2e389f64bd6134cf28e00071788742a4862ae34f5f8c424f6","0575f44f697e98c1168c84ee7175462ffad37076a9e08ed1b27b955617ba7ff2","58e349df2c2072bf59d396ae2d5b81990d49b8c0d355bbdcd9858a0a2b3419cc","d5ad03d1d4f296b723383e5eff45d5bc99230fa866c20870189da2546f56a631","56c390e49487b460efe8a3213e1d3d8be21eed9c53cc905ef0a63c4f63edf337","db071e381b1c3396ca25942dc2188a7e8ac345a1ea9c8fe098d356666a291c38","3ffc54c64ff806e1f728993e561f7d222347b94620e0bdd5d87defd729b351a7","338c59d03c85bfab7