{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRALOGGING-START","paragraph_zero_based":19920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19921},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging ::=         SEQUENCE {","paragraph_zero_based":19922},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-eutra-5gc          PLMN-Identity                                          OPTIONAL,","paragraph_zero_based":19923},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-5gc       TrackingAreaCode                                       OPTIONAL,","paragraph_zero_based":19924},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-5gc           BIT STRING (SIZE (28))                                 OPTIONAL,","paragraph_zero_based":19925},{"literal_text_all_w_t_and_m_t":"    plmn-Identity-eutra-epc          PLMN-Identity                                          OPTIONAL,","paragraph_zero_based":19926},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-eutra-epc       BIT STRING (SIZE (16))                                 OPTIONAL,","paragraph_zero_based":19927},{"literal_text_all_w_t_and_m_t":"    cellIdentity-eutra-epc           BIT STRING (SIZE (28))                                 OPTIONAL","paragraph_zero_based":19928},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19930},{"literal_text_all_w_t_and_m_t":"-- TAG-CGI-INFOEUTRALOGGING-STOP","paragraph_zero_based":19931},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19932},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19933},{"literal_text_all_w_t_and_m_t":"CGI-InfoEUTRALogging field descriptions","paragraph_zero_based":19934},{"literal_text_all_w_t_and_m_t":"cellIdentity-eutra-epc, cellIdentity-eutra-5GC","paragraph_zero_based":19935},{"literal_text_all_w_t_and_m_t":"Unambiguously identify a cell within the context of the PLMN. It belongs the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1.","paragraph_zero_based":19936},{"literal_text_all_w_t_and_m_t":"plmn-Identity-eutra-epc, plmn-Identity-eutra-5GC","paragraph_zero_based":19937},{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (when connected to EPC) or of plmn-IdentityList-r15 (when connected to 5GC) in SystemInformationBlockType1 that contained the reported cellIdentity.","paragraph_zero_based":19938},{"literal_text_all_w_t_and_m_t":"trackingAreaCode-eutra-epc, trackingAreaCode-eutra-5gc","paragraph_zero_based":19939},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity-eutra-epc, cellIdentity-eutra-5GC belongs.","paragraph_zero_based":19940},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19941},{"literal_text_all_w_t_and_m_t":"–CGI-InfoNR","paragraph_zero_based":19942},{"literal_text_all_w_t_and_m_t":"The IE CGI-InfoNR indicates cell access related information, which is reported by the UE as part of report CGI procedure.","paragraph_zero_based":19943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bbbd72e001b7480245d7767c80078d258283999235b1e7ec0a9d9426443e6f90","4a1eb7ae73c88cd3d52c93a4e990e43d8290dc7c57e490e12eced9fe2d79735d","4b534a5273ad44d449af912732025d84324a5ab67436dc523198149ae19c71d9","600215a96c6d34d4c833a054971f43b2158f7ed4982ec24df58c6b92491327df","280761551