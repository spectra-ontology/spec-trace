{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"groupHoppingEnabledTransformPrecoding","paragraph_zero_based":29856},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder, the NW may configure group hopping by this cell-specific parameter, see TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":29857},{"literal_text_all_w_t_and_m_t":"msg3-DeltaPreamble","paragraph_zero_based":29858},{"literal_text_all_w_t_and_m_t":"Power offset between msg3 and RACH preamble transmission. Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1)","paragraph_zero_based":29859},{"literal_text_all_w_t_and_m_t":"p0-NominalWithGrant","paragraph_zero_based":29860},{"literal_text_all_w_t_and_m_t":"P0 value for PUSCH with grant (except msg3). Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.1) This field is cell specific","paragraph_zero_based":29861},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":29862},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1).","paragraph_zero_based":29863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29864},{"literal_text_all_w_t_and_m_t":"–PUSCH-PowerControl","paragraph_zero_based":29865},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-PowerControl is used to configure UE specific power control parameter for PUSCH.","paragraph_zero_based":29866},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl information element","paragraph_zero_based":29867},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29868},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-POWERCONTROL-START","paragraph_zero_based":29869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29870},{"literal_text_all_w_t_and_m_t":"PUSCH-PowerControl ::=              SEQUENCE {","paragraph_zero_based":29871},{"literal_text_all_w_t_and_m_t":"    tpc-Accumulation                    ENUMERATED { disabled }                                                 OPTIONAL, -- Need S","paragraph_zero_based":29872},{"literal_text_all_w_t_and_m_t":"    msg3-Alpha                          Alpha                                                                   OPTIONAL, -- Need S","paragraph_zero_based":29873},{"literal_text_all_w_t_and_m_t":"    p0-NominalWithoutGrant              INTEGER (-202..24)                                                      OPTIONAL, -- Need M","paragraph_zero_based":29874},{"literal_text_all_w_t_and_m_t":"    p0-AlphaSets                        SEQUENCE (SIZE (1..maxNrofP0-PUSCH-AlphaSets)) OF P0-PUSCH-AlphaSet     OPTIONAL, -- Need M","paragraph_zero_based":29875},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToAddModList     SEQUENCE (SIZE (1..maxNrofPUSCH-PathlossReferenceRSs)) OF PUSCH-PathlossReferenceRS","paragraph_zero_based":29876},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL, -- Need N","paragraph_zero_based":29877},{"literal_text_all_w_t_and_m_t":"    pathlossReferenceRSToReleaseList    SEQUENCE (SIZE (1..maxNrofPUSCH-PathlossReferenceRSs)) OF PUSCH-PathlossReferenceRS-Id","paragraph_zero_based":29878},{"literal_text_all_w_t_and_m_t":"                                                                                                                OPTIONAL,  -- Need N","paragraph_zero_based":29879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_ut