{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24936},{"literal_text_all_w_t_and_m_t":"CellsToAddMod field descriptions","paragraph_zero_based":24937},{"literal_text_all_w_t_and_m_t":"cellIndividualOffset","paragraph_zero_based":24938},{"literal_text_all_w_t_and_m_t":"Cell individual offsets applicable to a specific cell.","paragraph_zero_based":24939},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":24940},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":24941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":24942},{"literal_text_all_w_t_and_m_t":"MeasObjectNR field descriptions","paragraph_zero_based":24943},{"literal_text_all_w_t_and_m_t":"absThreshCSI-RS-Consolidation","paragraph_zero_based":24944},{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per CSI-RS resource(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per CSI-RS resource as described in 5.5.5.2.","paragraph_zero_based":24945},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":24946},{"literal_text_all_w_t_and_m_t":"Absolute threshold for the consolidation of measurement results per SS/PBCH block(s) from L1 filter(s). The field is used for the derivation of cell measurement results as described in 5.5.3.3 and the reporting of beam measurement information per SS/PBCH block index as described in 5.5.5.2.","paragraph_zero_based":24947},{"literal_text_all_w_t_and_m_t":"allowedCellsToAddModList","paragraph_zero_based":24948},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the allow-list of cells. It applies only to SSB resources.","paragraph_zero_based":24949},{"literal_text_all_w_t_and_m_t":"allowedCellsToRemoveList","paragraph_zero_based":24950},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the allow-list of cells.","paragraph_zero_based":24951},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB","paragraph_zero_based":24952},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":24953},{"literal_text_all_w_t_and_m_t":"associatedMeasGapSSB2","paragraph_zero_based":24954},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for SSB measuring identified by ssb-ConfigMobility in this measurement object for NTN deployments. When multiple MeasObjectNR with the same SSB frequency are configured, the network configures the same measurement gap ID in this field for each MeasObjectNR. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapSSB.","paragraph_zero_based":24955},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS","paragraph_zero_based":24956},{"literal_text_all_w_t_and_m_t":"Indicates the associated measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object. If this field is absent, the associated measurement gap is the gap configured via gapFR1, gapFR2, or gapUE.","paragraph_zero_based":24957},{"literal_text_all_w_t_and_m_t":"associatedMeasGapCSIRS2","paragraph_zero_based":24958},{"literal_text_all_w_t_and_m_t":"Indicates the associated additional measurement gap for CSI-RS measuring identified by csi-rs-ResourceConfigMobility in this measurement object for NTN deployments. If this field is absent, the associated measurement gap is the gap indicated by associatedMeasGapCSIRS. In this release of the specification, this field is not configured for NTN deployments.","paragraph_zero_based":24959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["81ea079db834994a30289e5ef1f6d7e92795214b2073113ba9552a3982130326","8e22d0a1bc89826766a3f98bb843271a68757f23c704b674fde05ac58a821977","1790315b556145720648d2e7b457207ae895fd3394e66d779b84501c4cc20e1b","dc7b4cb928e35155e7bd59d833cec790aabdb9bd49a320a8aab49dc3dc95e4f7","9f1900d7ff0683068471ff70020ec38470872644892e2d4c8b18e6364894a131","96d3ada42c3dd0106b4c200cfa11fc4320819a9f0b12e4e3e77c9bb496a2a1e1","6075573ea801e1db658c8e2abbcc432ab4ce0c2f708a7e5932505b526889affa","ecf674bf933fc4b32f51f700a4f0dabea55a0e4ca79e75289413283197964284","412d4a976485bfe1176a0ffda805efdffafd5429306312dbc4608f853217d158","dac439cc340b0ec953a0581273da907cd5ff92f2e95aaa5882e19e8f67e2e3e6","51594e4d8a40e441a8f39edba61cee2c328454d04257b9998f9767376bbfbdd9","3a66ee9d7a4b5a058eac6eb6f921d4a8df1c96536ee87f61be99dd948b15c110","3e644ac54ec65e303873f9c2b03c7ea876ec2e3f62a1aabad4831326c79377ba","b73f6a861075a495185a28aed8fcb24079b41098bce623a54f23045a34b17103","d3f249045735535d2744b41ebef24d3dc4b1a5e627c84aeca1063385042b4ce7","8dd7a16bfa1aab1320baa4cfd87df6a1324878dabfc1cec818cc90ad0e7925dc","0ee9a3681040cd8a0d524bf94764bf4c77df17bad6ed3f6d3f33682e0cbb8f41","de6c3bd7171ea36b27e8ebcbfc1044d0fe9bf160756a123225b68370a8462f5e","9529cbca954c79657d2d9676262b03d3a8c11d03d5af9b9532f8939e274be054","30a34b3525e01b9b11011f28804f23fef67d9900f24f45b007d68f63e7cda606","963f6394433e614271996b77ee3ff0974823ac4eed88aba0f7d4d13449ea6b62","1afd7e8f60501a45adacfd46e3cec95050294e622d3826e55ad3de19db0a3fff","b0034e3659eb7e0457c54287d5d309ed949d49228f30e71de0bfa93691b14a8b","f45be3388d1ad586e61121bcd9b0ecac05696482d6d58eb750eb620ce203ba83"],"paragraph_range_zero_based":[24936,24959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24936"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellsToAddModList","paragraph_zero_based":24960},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the cell list.","paragraph_zero_based":24961},{"literal_text_all_w_t_and_m_t":"cellsToRemoveList","paragraph_zero_based":24962},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the cell list. ","paragraph_zero_based":24963},{"literal_text_all_w_t_and_m_t":"excludedCellsToAddModList","paragraph_zero_based":24964},{"literal_text_all_w_t_and_m_t":"List of cells to add/modify in the exclude-list of cells. It applies only to SSB resources.","paragraph_zero_based":24965},{"literal_text_all_w_t_and_m_t":"excludedCellsToRemoveList","paragraph_zero_based":24966},{"literal_text_all_w_t_and_m_t":"List of cells to remove from the exclude-list of cells.","paragraph_zero_based":24967},{"literal_text_all_w_t_and_m_t":"freqBandIndicatorNR","paragraph_zero_based":24968},{"literal_text_all_w_t_and_m_t":"The frequency band in which the SSB and/or CSI-RS indicated in this MeasObjectNR are located and according to which the UE shall perform the RRM measurements. This field is always provided when the network configures measurements with this MeasObjectNR.","paragraph_zero_based":24969},{"literal_text_all_w_t_and_m_t":"measCyclePSCell","paragraph_zero_based":24970},{"literal_text_all_w_t_and_m_t":"The parameter is used only when the PSCell is configured on the frequency indicated by the measObjectNR and the SCG is deactivated, see TS 38.133 [14]. The field may also be configured when the PSCell is not configured on that frequency. The network always configures measCyclePSCell for the measObjectNR associated with the PSCell if bfd-and-RLM is set to true and the SCG is deactivated. Value ms160 corresponds to 160 ms, value ms256 corresponds to 256 ms and so on.","paragraph_zero_based":24971},{"literal_text_all_w_t_and_m_t":"measCycleSCell","paragraph_zero_based":24972},{"literal_text_all_w_t_and_m_t":"The parameter is used only when an SCell is configured on the frequency indicated by the measObjectNR and is in deactivated state, see TS 38.133 [14]. gNB configures the parameter whenever an SCell is configured on the frequency indicated by the measObjectNR, but the field may also be signalled when an SCell is not configured. Value sf160 corresponds to 160 sub-frames, value sf256 corresponds to 256 sub-frames and so on.","paragraph_zero_based":24973},{"literal_text_all_w_t_and_m_t":"measSequence","paragraph_zero_based":24974},{"literal_text_all_w_t_and_m_t":"Indicates the recommended sequence for intra/inter-RAT intra/inter-frequency measurement. Value 1 means the corresponding frequency is measured firstly. Value 2 means the corresponding frequency is measured secondly and so on. If more than one frequency is configured with the same value, it means no recommended sequence among these frequencies. If not provided, it means there is no recommended sequence for the corresponding frequency. This field is only configured for NR standalone or if the measObject is associated to the MCG.","paragraph_zero_based":24975},{"literal_text_all_w_t_and_m_t":"nrofCSInrofCSI-RS-ResourcesToAverage","paragraph_zero_based":24976},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on CSI-RS resources to be averaged. The same value applies for each detected cell associated with this MeasObjectNR.","paragraph_zero_based":24977},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":24978},{"literal_text_all_w_t_and_m_t":"Indicates the maximum number of measurement results per beam based on SS/PBCH blocks to be averaged. The same value applies for each detected cell associated with this MeasObject.","paragraph_zero_based":24979},{"literal_text_all_w_t_and_m_t":"ntn-NeighbourCellInfo","paragraph_zero_based":24980},{"literal_text_all_w_t_and_m_t":"Includes satellite assistance information of an NTN neighbour cell.","paragraph_zero_based":24981},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":24982},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":24983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["43fe2335e327a1c7d842a256358fdd05cc47840a990cbfe044cfbf8b0815cb68","54d2da3b75180134b38cd389a766aad709f6627f0a76ae48e4377520d962115f","c5dbea67c37e2ad6714fd60d006b23a233090b0f2c0d1523f8c07873c0958eb3","c39d56dedfb9af5cbaac7f2b43e0cf49b25539fc6db3e108dee8b680b392a286","72d9891345f0260f03494f4ce49a612405cba536f679b3daf4dbe9f8d5d54cee","b41bbcff78a337c57b32558cb33fecc38eca2ad1fad37a51d79b0068f32d3c31","10eb38d24c06a5a283c156b55b747ec5a09e70d5852fc81428db7f9847a50e0e","48322fe218b2fd729a08b68a0fbebecfbd82a968b9c868f6e7b51141a4585eea","439f5fb133205e7ee84d1cc097a736128f50b78fb2d8fbaea2db6df873ea9c59","9afc9609d9284485ee43e8d559c196053686289dc41c4bb9320c30c75329992a","02ad786bc191ee2e12ed4e54f4c33a3986ba0ccff51e9f1a8c17cab9f0520330","8c12ce9be86df802b62bb76b338b4e7e57ea66ffc3efb4c870d7b9f0ae81010d","ce6c1f7d5f1fa9392888286821c3e3f6d6065df9f263517e28159e70ba3ce671","1450a4a682e0374d28a2b7fa2e2c00538782fe1e615c80a827e3dc8fa512f2ec","50fc3e3889bac51333ba83a9ba8fd4ef68a8f81309cf1342c3e9f46eb09a8bae","6f62d2f590ae04bd949c38b6d0ee1b7119d72c910217804a49389f372b00ef18","46cb565f84bca154dba63af695619dd0eb17bd881f1004ad4384aa2014896e82","c9faf095693241be66635223e7c12c8906d7b394491712676d8aeb4c11e6b6c5","488bdccf33645a4344dc25ade56ed80c2c46c2a161136197d336f9df76b74b89","c64a7ba55d302028703cf9ce1c0d788eb9ff497154623ecf3108ec9ee80589f9","749b7d657f552408c6bc0348d3f6ed39df9a6ecd91e0ccd22b82cec87c19123a","26fa0f276dc95193d068185acfb2dd07c2c6434d461d9f366b6594c61e8e8e9d","952d9d0f866e6a43be6230b87f4b50edb35e542bf516f4244bda4ee3e101221e","4be950ee3c3ca63bc8220465d382c11fb9b2a0bde5c4ecf6ec586c363ff45049"],"paragraph_range_zero_based":[24960,24983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":24984},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for uplink transmission on service link. If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":24985},{"literal_text_all_w_t_and_m_t":"offsetMO","paragraph_zero_based":24986},{"literal_text_all_w_t_and_m_t":"Offset values applicable to all measured cells with reference signal(s) indicated in this MeasObjectNR.","paragraph_zero_based":24987},{"literal_text_all_w_t_and_m_t":"quantityConfigIndex","paragraph_zero_based":24988},{"literal_text_all_w_t_and_m_t":"Indicates the n-th element of quantityConfigNR-List provided in MeasConfig.","paragraph_zero_based":24989},{"literal_text_all_w_t_and_m_t":"referenceSignalConfig","paragraph_zero_based":24990},{"literal_text_all_w_t_and_m_t":"RS configuration for SS/PBCH block and CSI-RS.","paragraph_zero_based":24991},{"literal_text_all_w_t_and_m_t":"refFreqCSI-RS","paragraph_zero_based":24992},{"literal_text_all_w_t_and_m_t":"Point A which is used for mapping of CSI-RS to physical resources according to TS 38.211 [16] clause 7.4.1.5.3.","paragraph_zero_based":24993},{"literal_text_all_w_t_and_m_t":"smtc1","paragraph_zero_based":24994},{"literal_text_all_w_t_and_m_t":"Primary measurement timing configuration. (see clause 5.5.2.10).","paragraph_zero_based":24995},{"literal_text_all_w_t_and_m_t":"smtc2","paragraph_zero_based":24996},{"literal_text_all_w_t_and_m_t":"Secondary measurement timing configuration for SS corresponding to this MeasObjectNR with PCI listed in pci-List. For these SS, the periodicity is indicated by periodicity in smtc2 and the timing offset is equal to the offset indicated in periodicityAndOffset modulo periodicity. periodicity in smtc2 can only be set to a value strictly shorter than the periodicity indicated by periodicityAndOffset in smtc1 (e.g. if periodicityAndOffset indicates sf10, periodicity can only be set of sf5, if periodicityAndOffset indicates sf5, smtc2 cannot be configured).","paragraph_zero_based":24997},{"literal_text_all_w_t_and_m_t":"smtc3list","paragraph_zero_based":24998},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for SS corresponding to IAB-MT. This is used for the IAB-node's discovery of other IAB-nodes and the IAB-Donor-DUs.","paragraph_zero_based":24999},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":25000},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10.","paragraph_zero_based":25001},{"literal_text_all_w_t_and_m_t":"ssbFrequencyIndicates the frequency of the SS associated to this MeasObjectNR. For operation with shared spectrum channel access, this field is a k*30 kHz shift from the sync raster where k = 0,1,2, and so on if the reportType within the corresponding ReportConfigNR is set to reportCGI (see TS 38.211 [16], clause 7.4.3.1). Frequencies are considered to be on the sync raster if they are also identifiable with a GSCN value (see TS 38.101-1 [15], or TS 38.101-5 [75]).","paragraph_zero_based":25002},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":25003},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relationship between SS/PBCH blocks for all measured cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":25004},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":25005},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":25006},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":25007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6da068a2bef10038cd9d09325d9a716df3be4cd99b5edc41b56de408008bed94","3cad322719ee99060c60efd4066913bd86e52d0175a6c6c8e451d71414ce51bb","8c53c4995322c9e167d999926131b074209034569c149e8a8fbdf4c276a6d090","e85a0b4a191a0293a8ab7326e649862171b9b222599ff6aac870510aa16497f4","f33ef9f90dc8a202070f72ed19d3c84c37c00b31dd30a5406cb59dbdbef0ba90","f45d266c2109eb09210292d98d39efafa6fbaa9ef1f7b6d652885d2dceee22e7","463749408d0fa4f28329f5b5f14a221f24331ee5bf1bce27fc81960492172fbb","68732e76f853533c058b5d3e6d87c4d2200f1f9f982621e3409260f3db52bfce","62a9ef598b3f4affb7b372470f0fdfce3eafad2a7c622b9bc67db4c4b041b648","9da44b032b4c6cfa75ff726c17d79c5929a8e6fc6eef9ab2e89e66ccc54dff9c","26624d4cec62f5daacb014b0077e1011b4b8f7853517917e28a9be02e37c1373","f70be13155bf6a6cdbdade79196805d5404f3bdb376af6188eba4621d70902ef","340060daac7ec8a8139e9c46b8b2eb7e8b6134e6de43b740d7a445e8dbc45b14","5ef2cfa16d6bda43ddaa35316c54a576ea9b0c64e19ac2792fbc0e4fba5b6889","e7e8629db800a31359e78dd281894d637deddf0dd0596065322845502a4bd8a3","e8daf48549d7a38de2ff82f09d0ff43653177a6781e6842738910df2d36ebaf3","00fb2295844a8e16cd9256798b016f3596c7cac91ff73ffbdaede7ade8caeae5","e099f3929a09c79b8e30eddf8c8dd4025d70b56e66e0d66ecdb57f2fdd0749ec","e4d3a5a203e4cc550f242d976d494007827155db964911732df4fe8a62b55f16","fbe1eb1e56625ed446b4b6e573ed574e1f294ab333fd83d94eab33294fd31bb7","67d7a06329effc66f2a0f58ef04ec811ee01c8fbc77b82d2a5e13eb360f804c4","a649b4eba8f7790beab5f15a37c93ca21f6f3b0669d40fbed0a312d84c2a1cd2","117ec276c48e4e5725cc6d6e94d5570d89be5292a81fb8d780f22eb99bef3150","35e3de8aa8a8b7154098569f09334e9eba0bbd07d0378504d3161c5b29fe666c"],"paragraph_range_zero_based":[24984,25007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p24984"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":25008},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":25009},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":25010},{"literal_text_all_w_t_and_m_t":"t312","paragraph_zero_based":25011},{"literal_text_all_w_t_and_m_t":"The value of timer T312. Value ms0 represents 0 ms, ms50 represents 50 ms and so on.","paragraph_zero_based":25012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25013},{"literal_text_all_w_t_and_m_t":"ReferenceSignalConfig field descriptions","paragraph_zero_based":25014},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceConfigMobility","paragraph_zero_based":25015},{"literal_text_all_w_t_and_m_t":"CSI-RS resources to be used for CSI-RS based RRM measurements.","paragraph_zero_based":25016},{"literal_text_all_w_t_and_m_t":"ssb-ConfigMobility","paragraph_zero_based":25017},{"literal_text_all_w_t_and_m_t":"SSB configuration for mobility (nominal SSBs, timing configuration).","paragraph_zero_based":25018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25019},{"literal_text_all_w_t_and_m_t":"RMTC-Config field descriptions","paragraph_zero_based":25020},{"literal_text_all_w_t_and_m_t":"measDurationSymbols","paragraph_zero_based":25021},{"literal_text_all_w_t_and_m_t":"Number of consecutive symbols for which the Physical Layer reports samples of RSSI (see TS 38.215 [9], clause 5.1.21). Value sym1 corresponds to one symbol, sym14or12 corresponds to 14 symbols of the reference numerology for NCP and 12 symbols for ECP, and so on.","paragraph_zero_based":25022},{"literal_text_all_w_t_and_m_t":"If measDurationSymbols-v1700 is signalled, the UE ignores measDurationSymbols-r16.","paragraph_zero_based":25023},{"literal_text_all_w_t_and_m_t":"ref-BWPId","paragraph_zero_based":25024},{"literal_text_all_w_t_and_m_t":"Indicates the reference BWP for the TCI state indicated in tci-StateInfo. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":25025},{"literal_text_all_w_t_and_m_t":"ref-SCS-CP","paragraph_zero_based":25026},{"literal_text_all_w_t_and_m_t":"Indicates a reference subcarrier spacing and cyclic prefix to be used for RSSI measurements (see TS 38.215 [9]). Value kHz15 corresponds to 15kHz, kHz30 corresponds to 30 kHz, value kHz60-NCP corresponds to 60 kHz using normal cyclic prefix (NCP), and kHz60-ECP corresponds to 60 kHz using extended cyclic prefix (ECP).","paragraph_zero_based":25027},{"literal_text_all_w_t_and_m_t":"If ref-SCS-CP-v1700 is signalled, the UE ignores ref-SCS-CP-r16.","paragraph_zero_based":25028},{"literal_text_all_w_t_and_m_t":"ref-ServCellId","paragraph_zero_based":25029},{"literal_text_all_w_t_and_m_t":"Indicates the FR2-2 reference serving cell index for the TCI state. Network includes this field if tci-StateInfo is present. This field is only applicable for operation with shared spectrum channel access in FR2-2 and network does not configure this if the UE does not have any serving cells in FR2-2.","paragraph_zero_based":25030},{"literal_text_all_w_t_and_m_t":"rmtc-Bandwidth","paragraph_zero_based":25031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8549346356b320f9980b0c727371a334edf7d912e685c49877c436a0290dcc68","0b61b67f45fffe54ef34d62a5ba2ef915d7e176027989e4146844145bb3c4380","a227a3b5c6a1dee9254c68c9852a28d20a95894f35c96cd42674add5a4df1464","e439df6582511f59cdbca1eb3e3584c06564f841cd68311b26732036b45e8485","3a977cac94d71365d594cba13f4e8732bc754d507f567a1c94be47b29b2f03fb","fc299238e383c32c431bbff6c82f0b1c95e62be738e4918673ea4ca92446ad6e","cb389da1b49762e8dc5d44f4e37d41e7381616cc7befaac563a1247c830c9ae7","6a6164b041ba630570ba920b6813bcfef0cd3fa546b6bbd896f5b94078bd1f1b","d9e5d7d10b3b228cd84662b099e3b23c27d30ab05fc1e38079a5efd0dd744425","3a7a966d617f07fb7fdbb06f16edb0e2a5442f2917d5487b1a416ce425402796","a7cc6a27c43ff338159780f5a607141f86b6f67de0548a46340b04c43978331c","a01d861a06623d058808c14183babcd65f966ef8a5b975b22cf7bef57fa8f9c3","90536ee1ab280574e5099de93ce9e6e77eb2992611f8d3ff57c23e140e6c4f79","843e3a65562fc9d05e5385a41c2e933437689eee2113e114bc50f837a929cd18","3b8d3b00e65cdf145537d8f8d02b0ce9ddabcc89513f6a00e1bac956e36ef08d","bd67c072a1d3bc6d5de46b071e3029820f98b9fe946f05711fb319a7bbc1013e","ef9b998cba368d8e80b99c1eceaa8ddafd750986d47c2862540cb8283323ab1c","db099db8db8d3382034574e8b009701087ddb9fc188f443e722aca2c31710c23","f1f2cab51736e8c972f4b8e20aeeb55f2968d4af4073aa7983a46eea10befdae","8510f0fc18c1d0427e9e8b293cb0abac55d0282981174c89082471099b18338f","013bc64952f1c3fd43f92e48b5e94d33a6b2f954458f77e02e96c04cfcd08aa0","9214f7fecd823357bfdcb2c7ec53b5fc73ea6e2158b3ba1ad15dd6487ef55464","cd7185c69b9e8da98e7caf8e48e28577a91248f8931cc85f0c7dbe065d201d90","7dbb1f1ec0632823d03026acd2a413d406809937382743cb9188d4d7b5af60c6"],"paragraph_range_zero_based":[25008,25031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25008"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the bandwidth for the RSSI measurement (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":25032},{"literal_text_all_w_t_and_m_t":"rmtc-Frequency","paragraph_zero_based":25033},{"literal_text_all_w_t_and_m_t":"Indicates the center frequency of the measured bandwidth for a frequency which operates with shared spectrum channel access (see TS 38. 215 [9], clause 5.1.21).","paragraph_zero_based":25034},{"literal_text_all_w_t_and_m_t":"rmtc-Periodicity","paragraph_zero_based":25035},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) periodicity (see TS 38.215 [9], clause 5.1.21).","paragraph_zero_based":25036},{"literal_text_all_w_t_and_m_t":"rmtc-SubframeOffset","paragraph_zero_based":25037},{"literal_text_all_w_t_and_m_t":"Indicates the RSSI measurement timing configuration (RMTC) subframe offset for this frequency (see TS 38.215 [9], clause 5.1.21). For inter-frequency measurements, this field is optional present and if it is not configured, the UE chooses a random value as rmtc-SubframeOffset for measDurationSymbols which shall be selected to be between 0 and the configured rmtc-Periodicity with equal probability.","paragraph_zero_based":25038},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":25039},{"literal_text_all_w_t_and_m_t":"Indicates the TCI state to be used for RSSI measurements. This field is only applicable for shared spectrum channel access in FR2-2. Network does not configure this if the UE does not have any serving cells in FR2-2 and in such a case, it is up to UE implementation how to determine the spatial domain filter for the inter-frequency RSSI measurement in FR2-2.","paragraph_zero_based":25040},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25041},{"literal_text_all_w_t_and_m_t":"SSB-ConfigMobility field descriptions","paragraph_zero_based":25042},{"literal_text_all_w_t_and_m_t":"cca-CellsToAddModList, cca-CellsToRemoveList","paragraph_zero_based":25043},{"literal_text_all_w_t_and_m_t":"Lists of cells to be added or removed from the list of neighbor cells that apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2.","paragraph_zero_based":25044},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":25045},{"literal_text_all_w_t_and_m_t":"If this field is set to true, UE assumes SFN and frame boundary alignment across cells on the same frequency carrier as specified in TS 38.133 [14]. Hence, if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, this field indicates whether the UE can utilize the timing of this serving cell to derive the index of SS block transmitted by neighbour cell. Otherwise, this field indicates whether the UE may use the timing of any detected cell on that target frequency to derive the SSB index of all neighbour cells on that frequency.","paragraph_zero_based":25046},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCellInter","paragraph_zero_based":25047},{"literal_text_all_w_t_and_m_t":"If this field is present, UE assumes SFN and frame boundary alignment between the reference serving cell indicated by ServCellIndex and all neighbour cells in this MeasObjectNR as specified in TS 38.133 [14]. This field also indicates that the UE can utilize the timing of the reference serving cell indicated by ServCellIndex to derive the index of SS block transmitted by all inter-frequency neighbour cells on the frequency indicated by the MeasObjectNR. When this field is included, the network should set deriveSSB-IndexFromCell to true.","paragraph_zero_based":25048},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":25049},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not to be measured while value 1 indicates that the corresponding SS/PBCH block is to be measured (see TS 38.215 [9]). When the field is not configured the UE measures on all SS blocks. Regardless of the value of this field, SS/PBCH blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":25050},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasureAltitudeBasedList","paragraph_zero_based":25051},{"literal_text_all_w_t_and_m_t":"List of altitude-dependent ssb-ToMeasure. When the UE is within an altitude range indicated by altitudeRange, it ignores the ssb-ToMeasure (without suffix), and applies the corresponding ssb-ToMeasure-r18 if present, otherwise (i.e., the UE is within an altitude range indicated by altitudeRange and ssb-ToMeasure-r18 is absent) it measures on all SS-blocks. When the UE is outside all the altitude ranges indicated by altitudeRange (if any), ssb-ToMeasure (without suffix) applies.","paragraph_zero_based":25052},{"literal_text_all_w_t_and_m_t":"For each altitude range, altitudeMin indicates the minimum altitude in meters relative to sea level, altitudeMax indicates the maximum altitude in meters relative to sea level, and if included, altitudeHyst indicates hysteresis in meters for determination of the altitude range. I.e., when altitudeHyst is configured for an altitude range, the UE considers itself to have entered the range if altitudeMin ≤ UE altitude ≤ altitudeMax and after entering the range considers itself to be in the range while (altitudeMin – altitudeHyst) ≤ UE altitude ≤ (altitudeMax + altitudeHyst).","paragraph_zero_based":25053},{"literal_text_all_w_t_and_m_t":"For each altitudeRange, if altitudeMin is absent, value minAltitude-r18 is used and if altitudeMax is absent, value maxAltitude-r18 is used.","paragraph_zero_based":25054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d9dc8bd4c28a2381a398b0ba7a4f67129a51557832137a4c41646604fa8000ea","d0b93a87b8bc8b49bf90d277fc6083eaed030fd78ac94bf3e6356bc21fd4d290","49bc14264c71832f65a22d3722d69b9f52ed970082aa541ccc222af809f9fb6b","03230d716b07bd06270d4979ee5c333672aba0a0514e0184b682f883c437cc00","968573543c8078f3b6df012d1a6a0f697a070ba2d7f198eaee595f32d94209d5","6c139cc2e08ff0fff329b3f0b49c37e5ef6b116c8db179347ab81288ca1198fd","ee5a35487c227078c7533196f196f3983d23b598951ca42759513d8df71343e0","b4271fe2fadcecc7fe31f16775d01a8f34b5e13869c071ce664819827e1d73cb","3e901d9049670ef71bd92b80a26a3ec99a0408e301c12a1c06c4050a05a72186","b1824ed464786a1ff6981fc5f5da28ba9954649b8111dc09f2dc9c25d211545e","432a5fc805d2f0a00fdeee1c3e78cccb3b614ba4c21382ce6fffbe1595e8d5fa","8389a71a28a625fddc94d5db01962584201451ea2d14c534022274b8dba1a904","93a32dffe1fc45f7b3520e56cb560a0155bd5ae6b8e720ddc987bc9b82a978a4","85b9029c1c883f343ca150d231a8000f15efb85500830bacb8986df2f07e2174","bb84cf98d83c25b36c19aaf97efdb6e47443422cd4c7fe4211018a026ceb7565","b33212657af44e3978b866fe6a8648f5afe0deff6b2b6575cba8178872a55b5e","43cdb7212f6ef985bc630dc87dc581c37df6b728a1caff10239e2449f7e8c3b1","6d24092aca8d3d3447e6bee308a456a2b0d02e50c98260c7c00a9462bf548413","8afdcb762d3315625ffd8b60f438d17c81ca239b2a3c9d129cba4a083d9cef2d","7d7580c7771c5f5294f509ef2ea43d21dfa9faa5d221bc5eff0e9432ffc22744","0c879048b1f7a80a5d1564b45321d72c3eba91e470f35602b5b4e1810853dd74","9405f6111811b497a6137e7547404ab0bc6e38cba6230751382d98181b685d55","f5ddba6d06e1482d4eac20203f4ef418fd1b7827e79c320f37bf56964bf312bd","2b801f044765f86e44d16e282a67d9e96f5c811d76857d7409e22e0936e1c09e"],"paragraph_range_zero_based":[25032,25055],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25032"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SSB-PositionQCL-CellsToAddMod field descriptions","paragraph_zero_based":25056},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":25057},{"literal_text_all_w_t_and_m_t":"Physical cell identity of a cell in the cell list.","paragraph_zero_based":25058},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":25059},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the value signalled by ssb-PositionQCL-Common.","paragraph_zero_based":25060},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25061},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25062},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25063},{"literal_text_all_w_t_and_m_t":"AssociatedGapCSIRS","paragraph_zero_based":25064},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapCSIRS is configured, otherwise, it is absent.","paragraph_zero_based":25065},{"literal_text_all_w_t_and_m_t":"AssociatedGapSSB","paragraph_zero_based":25066},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if associatedMeasGapSSB is configured, otherwise, it is absent.","paragraph_zero_based":25067},{"literal_text_all_w_t_and_m_t":"CSI-RS","paragraph_zero_based":25068},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs-ResourceConfigMobility is configured, otherwise, it is absent.","paragraph_zero_based":25069},{"literal_text_all_w_t_and_m_t":"IntraFreqConnected","paragraph_zero_based":25070},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R if the UE is configured with a serving cell for which (absoluteFrequencySSB, subcarrierSpacing) in ServingCellConfigCommon is equal to (ssbFrequency, ssbSubcarrierSpacing) in this MeasObjectNR, otherwise, it is absent.","paragraph_zero_based":25071},{"literal_text_all_w_t_and_m_t":"SCG","paragraph_zero_based":25072},{"literal_text_all_w_t_and_m_t":"This field is optionallly present, Need R, in the measConfig associated with the SCG. It is absent in the measConfig associated with the MCG.","paragraph_zero_based":25073},{"literal_text_all_w_t_and_m_t":"NeighbourCell","paragraph_zero_based":25074},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this MeasObject is configured by the serving cell for a neighbour cell served by a NTN Earth moving system. Otherwise, it is absent.","paragraph_zero_based":25075},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":25076},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":25077},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":25078},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this MeasObject is for a frequency which operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":25079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bede12cf19030fb9fa4c682b2eaa7222b45f9bdef11fbf5a69cbe78c7bce9a87","c885cf63302174d6a8ff201bd5ec00f5487fc546467fc2dd0b2fbe93bec51825","9ec19fa6cd3f9f26b21077315b6efba4d7fba7587f3e98d1d34cb60c710db62c","46805b0508bf2713e2d222d282c1d68