c4a4f5a","d677eb8ceb71bccb1f1372beca82dd0bbcdf6617e3b2ef4c362bc7ddc25af6c3","9a8af5972e59f50f8dc9023bce51cd0689a01f022bbbbcabbb36b0bc164f6e52","a5fa248724e5075154a11551d811fd2556144e843fc5a16a978a4e2736bc866b","db021be76acb5a3fe4b44a10977d765ef858161d5b0b96d122f6a2dd337886fd","49be5fdbe348304d98a12ac72d0ceb693029363e06f45aef974d3206d270a371","78512f190549e181227f34c89939b76ad5f1b954459449a6e6f400175b6e6bc0","3916b831f9e359a9232aed70c46d78277a93dd294806f5138d9698ccbf98105f","f32007ad348a378b5f7a2c33347fadba7a67d6fa2ad51a85dc6b0860fd04c416"],"paragraph_range_zero_based":[26184,26207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p26184"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"interFreq-needForNCSG","paragraph_zero_based":26208},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for NR inter-frequency measurement.","paragraph_zero_based":26209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26210},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-IntraFreq field descriptions","paragraph_zero_based":26211},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":26212},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured.","paragraph_zero_based":26213},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":26214},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value ncsg indicates that a NCSG is needed if any of the UE configured BWPs do not contain the frequency domain resources of the SSB associated to the initial DL BWP. Value nogap-noncsg indicates that neither a measurement gap nor a NCSG is needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not. This field shall be set to 'nogap-noncsg' for the corresponding band(s) where bwpOperationMeasWithoutInterrupt-r18 is supported by the UE. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26215},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26216},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-NR field descriptions","paragraph_zero_based":26217},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":26218},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":26219},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":26220},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that a NCSG is needed, and value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26222},{"literal_text_all_w_t_and_m_t":"–NeedForInterruptionInfoNR","paragraph_zero_based":26223},{"literal_text_all_w_t_and_m_t":"The IE NeedForInterruptionInfoNR indicates whether interruption is needed for the UE to perform SSB based measurements on an NR target band without measurement gap while NR-DC or NE-DC is not configured.","paragraph_zero_based":26224},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR information element","paragraph_zero_based":26225},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26226},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForInterruptionInfoNR-START","paragraph_zero_based":26227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26228},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR-r18 ::=    SEQUENCE {","paragraph_zero_based":26229},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForInterruption-r18    NeedForInterruptionIntraFreqList-r18,","paragraph_zero_based":26230},{"literal_text_all_w_t_and_m_t":"    interFreq-needForInterruption-r18    NeedForInterruptionBandListNR-r18","paragraph_zero_based":26231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2ad712fddbff44ccfe3409fdbadd69c7f8ff816e71706918ccdfa18739ad2f1b","2921631abce34a545d574ded02316350e473767e3f2189b59004f35dc16a123f","ae3b6594fbcefc51ab0a155ce94b8cd5774d14b6cd54b412be32f62ced6e25f2","64b0ca6c43b8acc099ddb932fba2835d9cb7bcd9c50c8265481f2ca94c4c2513","f050870c0a518924ba7dbceed1a80801b54c51644303ea5c7a5502c9c9552011","ce725dff950c6dbe8ede6aa673131e095d75ecbf78995c4257e86791f2ff63b1","25de37d6d0e7f2c582969ffe84aca890f56765e9a9e26d02385249e35d94c5e7","e52dc08fc98908ceaf33fb0c9fde16154b3f5385e12b55f35182ca63be784321","7726d776fba65f8ffb039233d55590d6f969adc1e6dd2b1b2f1605271dd2caf0","b9d5360214b462db4caa13d4ed47d683f929781e87c20565e93c786304a3e3b4","015a9417adae95ddbde8f18a43836d21f42a68f915864598fc504e2c8dbea4f0","7b8c127d08e8963f77f3ef0b15626292d2e4eadc7d801abe7d253be3b4a46f33","298999b19293039a8d7da039de1afe42430ef74dd02f73882ec2f21e7ce12979","62001fd7ac592604251e06f6f5cc8db7affa200875e258229b13b396a7dfb079","3b70d9e4f93ddddfeb314a45a32549fb84fad05eb68ebf45a84e6d6eeb0c5539","e4b61db4bdbf8e85e436b0ab5f04a4cc0bf402aeb30c8ad52dc297e6025cb0f1","28664f44f8025bb3b1a394ed4d20da08c93eeaa8ba173542703633e3b72100c0","a94e1750e8658905cbf17495d0517b29600a313ed7db88de2f0fb17164856740","dfa992636ede30d8c8501385d43cb56f3c7f34ed7a6406550975febe25042aaf","b2109c97372efa4146bf3e3f65ccce34ff675510975010bfe2c41f02f12f48a2","b769d1c6d7eff3289b92b82bd5633da91236ccc416065a323e58c44972e5ddc8","4026119c57ced28e4180fe6acd4b8a835ad570bf094c78937b5d85c506564e2a","f2b068312b3eecb4b9c0a83b780c63bc35390bab70bbce16bd9fa544c2de9c7f","84cdbd4f2a746df85f3a0413d4a132f1b6402131cda65e5285f638ce1f5aaf80"],"paragraph_range_zero_based":[26208,26231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p26208"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26232},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26233},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionIntraFreqList-r18 ::=          SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForInterruptionNR-r18","paragraph_zero_based":26234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26235},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionBandListNR-r18 ::=             SEQUENCE (SIZE (1..maxBands)) OF NeedForInterruptionNR-r18","paragraph_zero_based":26236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26237},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionNR-r18  ::=       SEQUENCE {","paragraph_zero_based":26238},{"literal_text_all_w_t_and_m_t":"    interruptionIndication-r18           ENUMERATED {no-gap-with-interruption, no-gap-no-interruption}                     OPTIONAL","paragraph_zero_based":26239},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26240},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26241},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForInterruptionInfoNR-STOP","paragraph_zero_based":26242},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26243},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26244},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR field descriptions","paragraph_zero_based":26245},{"literal_text_all_w_t_and_m_t":"intraFreq-needForInterruption","paragraph_zero_based":26246},{"literal_text_all_w_t_and_m_t":"Indicates the interruption requirement information for NR intra-frequency measurement. Each entry in the list is associated to the entry in list intraFreq-needForGap-r16 with the same index. This field shall be set to no-gap-no-interruption for the corresponding band(s) where bwpOperationMeasWithoutInterrupt-r18 is supported by the UE.","paragraph_zero_based":26247},{"literal_text_all_w_t_and_m_t":"interFreq-needForInterruption","paragraph_zero_based":26248},{"literal_text_all_w_t_and_m_t":"Indicates the interruption requirement information for NR inter-frequency measurement. Each entry in the list is associated to the entry in list interFreq-needForGap-r16 with the same index.","paragraph_zero_based":26249},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26250},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionNR field descriptions","paragraph_zero_based":26251},{"literal_text_all_w_t_and_m_t":"interruptionIndication","paragraph_zero_based":26252},{"literal_text_all_w_t_and_m_t":"Indicates whether interruption is needed for the UE to perform SSB based measurements without measurement gap. Value no-gap-with-interruption indicates that interruption is needed. Value no-gap-no-interruption indicates interruption is not needed. ","paragraph_zero_based":26253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26254},{"literal_text_all_w_t_and_m_t":"–NextHopChainingCount","paragraph_zero_based":26255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["518ab643ed9b01d1b86a75c46ff66a4804ed053a696ee28d6515dc0a7b39cf4c","5c4d8abccf7ca3a2800d347d92015e2400aa2573d4b491d39866ec7588059783","b813b30cc09778d696ebe94f48c932dabb695e7b64f9d32d806cdb7625d772ae","63ff448a38eb390355cdc35129d7197ea5d21b109944d95c81ac323d959934f3","f208a45ebdf99ee8b9cfd9abfc4deacaec26eb677d35a680bcf7a4e77739d94d","8105e8a4cf2835e7fba96aa9d8acaf14bcf3db4a13f3575b428bd999891f9654","afafb67e26f65f7765dea003f3d08819b9ff75516e70c1437337dc2ba588f0b5","ee1d5a492a69ffe48771969f936027aa08302d280ca21dfc85