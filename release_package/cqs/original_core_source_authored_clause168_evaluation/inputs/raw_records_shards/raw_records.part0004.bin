{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates maximum SL PRS transmission power. The unit is dBm.","paragraph_zero_based":44736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44737},{"literal_text_all_w_t_and_m_t":"–SL-ConfigDedicatedNR","paragraph_zero_based":44738},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfigDedicatedNR specifies the dedicated configuration information for NR sidelink communication/discovery/positioning.","paragraph_zero_based":44739},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR information element","paragraph_zero_based":44740},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44741},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-START","paragraph_zero_based":44742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44743},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR-r16 ::=         SEQUENCE {","paragraph_zero_based":44744},{"literal_text_all_w_t_and_m_t":"    sl-PHY-MAC-RLC-Config-r16            SL-PHY-MAC-RLC-Config-r16                                              OPTIONAL,    -- Need M","paragraph_zero_based":44745},{"literal_text_all_w_t_and_m_t":"    sl-RadioBearerToReleaseList-r16      SEQUENCE (SIZE (1..maxNrofSLRB-r16)) OF SLRB-Uu-ConfigIndex-r16        OPTIONAL,    -- Need N","paragraph_zero_based":44746},{"literal_text_all_w_t_and_m_t":"    sl-RadioBearerToAddModList-r16       SEQUENCE (SIZE (1..maxNrofSLRB-r16)) OF SL-RadioBearerConfig-r16       OPTIONAL,    -- Need N","paragraph_zero_based":44747},{"literal_text_all_w_t_and_m_t":"    sl-MeasConfigInfoToReleaseList-r16   SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIndex-r16     OPTIONAL,    -- Need N","paragraph_zero_based":44748},{"literal_text_all_w_t_and_m_t":"    sl-MeasConfigInfoToAddModList-r16    SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-Meas