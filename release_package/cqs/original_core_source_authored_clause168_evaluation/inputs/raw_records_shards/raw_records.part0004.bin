{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35568},{"literal_text_all_w_t_and_m_t":"–T-Reselection","paragraph_zero_based":35569},{"literal_text_all_w_t_and_m_t":"The IE T-Reselection concerns the cell reselection timer TreselectionRAT for NR and E-UTRA. Value in seconds. For value 0, behaviour as specified in 7.1.2 applies.","paragraph_zero_based":35570},{"literal_text_all_w_t_and_m_t":"T-Reselection information element","paragraph_zero_based":35571},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35572},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-START","paragraph_zero_based":35573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35574},{"literal_text_all_w_t_and_m_t":"T-Reselection ::=                   INTEGER (0..7)","paragraph_zero_based":35575},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35576},{"literal_text_all_w_t_and_m_t":"-- TAG-TRESELECTION-STOP","paragraph_zero_based":35577},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35579},{"literal_text_all_w_t_and_m_t":"–TimeAlignmentTimer","paragraph_zero_based":35580},{"literal_text_all_w_t_and_m_t":"The IE TimeAlignmentTimer is used to configure the time alignment timer as specified in TS 38.321 [3]. The values are in ms.","paragraph_zero_based":35581},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer information element","paragraph_zero_based":35582},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35583},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-START","paragraph_zero_based":35584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35585},{"literal_text_all_w_t_and_m_t":"TimeAlignmentTimer ::=              ENUMERATED {ms500, ms750, ms1280, ms1920, ms2560, ms5120, ms10240, infinity}","paragraph_zero_based":35586},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35587},{"literal_text_all_w_t_and_m_t":"-- TAG-TIMEALIGNMENTTIMER-STOP","paragraph_zero_based":35588},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35590},{"literal_text_all_w_t_and_m_t":"–TimeToTrigger","paragraph_zero_based":35591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b4a4ee3f0918ed8e415132bc485dc6e733ac581ef74bfd7cd29ea26451f9c6a2","3214d7fb0f31d557e8c6d94f5df5734d1de10e98c48920e513fd9b3456e5cb50","a8ed5941b1f2280367bc269b9b5fe1911c1fa8fb19b6d98d90f268bde6ce392b","1c14a425bcdaeb30768cfbe2e32bfa167bdfb607c76a3e68b4a7f83d6bd79d94","22a77cd58748569defad47f35ecb298ffa85854b7c82f22c8efd1bb758dfc476","e065de357ef930b46eb96f90a9d05828730c79f12221ad80d7b8919399a1f75a","ca1d4fef4224cae9b6d3c4fef57ac74ce88b355e3256038c40810285195d1197","5a6c5111f0b0f45ebc4b09ee0823e043f1f6ad3a5af7ba105f4d8e620028871d","9800136793c9c14be14f8317291130286280007ddf0bd7997e0af437b2257adc","a4c2b1bcb1e1c7eea62a44bb903acc24d57269f00e08f010726ba2013afe6e9f","3f7229d0c9bca6db2f2a31fd34f4f5c4985d80f69f809f730d39a963e5fff6ec","c66139ef44e9989acb67e4be6d4fa3da7cb11eab6c42ce9d68e413c8ee6a712b","f837cca410276b924d749a1cd6d43f824bd6f173dd8c49b02bfab6e2a0f9732e","7d63bf7c7ec9a6d85bb9a3521ee547ecc08b75dfd7d88d5fde1c021de6233cc3","8f4c6786b9ad2dfce72f3c87e247d63dc9feea88740bb46d892cc5d7f7c5f9ce","8fdb20965acf90332d47370de2dbca9121fcabf9e0e46223fc06b60d41e6fa09","d05ffc6559b93a803b9cc514ca42225168432ab5367a79677f6ed3becb6c5f4c","08d548be1500a668d538a6f5899d105f60af1134521477df9c727a9ac49c6fd8","f99be6