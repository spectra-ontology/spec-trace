{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-GapToReleaseList","paragraph_zero_based":26064},{"literal_text_all_w_t_and_m_t":"List of MUSIM periodic gap patterns to release.","paragraph_zero_based":26065},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26066},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapId","paragraph_zero_based":26067},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapId is used to identify UE periodic MUSIM gap(s) to add, modify or release.","paragraph_zero_based":26068},{"literal_text_all_w_t_and_m_t":"MUSIM-GapId information element","paragraph_zero_based":26069},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26070},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPID-START","paragraph_zero_based":26071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26072},{"literal_text_all_w_t_and_m_t":"MUSIM-GapId-r17 ::=                  INTEGER (0..2)","paragraph_zero_based":26073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26074},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPID-STOP","paragraph_zero_based":26075},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26077},{"literal_text_all_w_t_and_m_t":"–MUSIM-GapInfo","paragraph_zero_based":26078},{"literal_text_all_w_t_and_m_t":"The IE MUSIM-GapInfo is used to indicate MUSIM gap parameters.","paragraph_zero_based":26079},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo information element","paragraph_zero_based":26080},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26081},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-START","paragraph_zero_based":26082},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26083},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo-r17 ::=               SEQUENCE {","paragraph_zero_based":26084},{"literal_text_all_w_t_and_m_t":"    musim-Starting-SFN-AndSubframe-r17  MUSIM-Starting-SFN-AndSubframe-r17             OPTIONAL, -- Cond aperiodic","paragraph_zero_based":26085},{"literal_text_all_w_t_and_m_t":"    musim-GapLength-r17                 ENUMERATED {ms3, ms4, ms6, ms10, ms20}         OPTIONAL, -- Cond gapSetup","paragraph_zero_based":26086},{"literal_text_all_w_t_and_m_t":"    musim-GapRepetitionAndOffset-r17    CHOICE {","paragraph_zero_based":26087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4a4d481340a856b5611790e9df8a8e7a5dc5db40231add017b159e5fdcfa302f","ac2f01fe8f870187c3854c61e257d31aa70d8da3746c1cf905f46a74848b3870","0ed0934f5b28482c5de8e7e69a8fd1e93d6f82fc56dc2e53b538ba1c42db9936","1e6874ba01ffab4f205120c879a055b6f6de6b8924ff4e4f86b94fba70431ecb","46fbdeac177bc2a3daa1882d7a11eb587ecc49b40a2861b9b742cbf8f422f1bf","9a59b0336ef07c6c5908e6d647f7ba2ce6d18f570430bd1317247deaad87ed9e","c207636f99b4d766623476c7a7d006722f3ea2dfe4b2396e1bfee1b54f421351","95f4fc07bf67fd6011deb545ec7c534deccc874cea1de66d3430bc255f99b148","ebb2a49ec8fdff1564b68d78140cc51ea0a27ac984f356388530032a7b161562","4eec399a606cb3594b58bc821f4a12f0828c43b3747b32d241baf4568f5f0cbc","203fd650d948a3d17257f99ac5d76b4f76e199fe4725cbc207f218acf354cfcb","84d77accba7cd0ec83f6f2f47e4e36f1b0a750807ddcab04d6f27cb30c6666f3","1701e3526c44d61ee12c8f751546608dd31e12ab59782ac088f15130fffb5013","33c543f1280cd3fdceff0d22dc70ed025937dcf97b4e9f8b57af95f97f44cf5f","1f8b9dae966371726f710f0e85a21f4131a4e7e4ba8b6454a630e4bebdd9b86d","2719a1a62d04ecb2533adaff06e454ed2357f103ae79c03cabc85533139357ea","73e988d56977799c9055564414c588b464a5c9c33005e577