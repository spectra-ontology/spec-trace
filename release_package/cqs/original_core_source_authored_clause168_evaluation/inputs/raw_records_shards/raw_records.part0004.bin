a76a5e2bb9","bc0117289872d24a938e631939ba8f5aa2c99e9dfe1bb195bc1bcca660a9404a","903c0be1f012e5260a442c40ebebbccbf5b83392adea1ed717a74edf46a079e3","470191df9cbb3d13a2dd0499d503e6c5cc4ba8c9f26c25a761a956647dcb6753","8d3df09bbb2514e9c99c62a15ba2c6858cedd3a428ef76b1818146c9df400e6c","0ca568d84ec37abb19938aae2dc3a71ac3c0cdb55aa18c7f8533aa6bd96782a5","f720e2b023426c1e003d51d3874bed7c56aff19ac83bba1316e3fbe652024b9c","caf2e99aa11ae441624c677b8ec6ead48c0691f220eb4adafbb1d20b36df68b7","322e100a5e42479b394bfebd8acc5712337cb6156247ba2a1d4dd4f0baf83dd6","31674d119755394eba5ae39db460315289ccb067d158ee149d7be8ca849a5bf9","6098c22a50c5a02ea6e3cfe7243744eacd6c1356bdc2954811133df911e1b7c8","a73de9ae8b93589455448a74f3e70f181745ee0b556daf050b10bb938decb551"],"paragraph_range_zero_based":[28656,28679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28656"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28680},{"literal_text_all_w_t_and_m_t":"UL-AccessConfigListDCI-1-1-r17 ::=         SEQUENCE (SIZE (1..3)) OF INTEGER (0..2)","paragraph_zero_based":28681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28682},{"literal_text_all_w_t_and_m_t":"DL-DataToUL-ACK-MulticastDCI-Format4-1-r17 ::= SEQUENCE (SIZE (1..8)) OF INTEGER (0..15)","paragraph_zero_based":28683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28684},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIG-STOP","paragraph_zero_based":28685},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28687},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28688},{"literal_text_all_w_t_and_m_t":"PUCCH-Config field descriptions","paragraph_zero_based":28689},{"literal_text_all_w_t_and_m_t":"dl-DataToUL-ACK, dl-DataToUL-ACK-DCI-1-2","paragraph_zero_based":28690},{"literal_text_all_w_t_and_m_t":"List of timing for given PDSCH to the DL ACK (see TS 38.213 [13], clause 9.1.2). The field dl-DataToUL-ACK applies to DCI format 1_1 and the field dl-DataToUL-ACK-DCI-1-2 applies to DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3). The dl-DataToUL-ACK-v1700 is applicable for NTN and dl-DataToUL-ACK-r17 is applicable for up to 71 GHz. If dl-DataToUL-ACK-r16 or dl-DataToUL-ACK-r17 or dl-DataToUL-ACK-v1700 is signalled, UE shall ignore the dl-DataToUL-ACK (without suffix). The value -1 corresponds to \"inapplicable value\" for the case where the A/N feedback timing is not explicitly included at the time of scheduling PDSCH. The fields dl-DataToUL-ACK-r17 and dl-DataToUL-ACK-DCI-1-2-r17 are only applicable for SCS of 480 kHz or 960 kHz.","paragraph_zero_based":28691},{"literal_text_all_w_t_and_m_t":"dl-DataToUL-ACK-MulticastDCI-Format4-1","paragraph_zero_based":28692},{"literal_text_all_w_t_and_m_t":"List of timing for given group-common PDSCH to the DL ACK (see TS 38.213 [13], clause 9.1.2). The field dl-DataToUL-ACK-MulticastDciFormat4-1 applies to DCI format 4_1 for MBS multicast (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":28693},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUCCH-Config","paragraph_zero_based":28694},{"literal_text_all_w_t_and_m_t":"Configuration of the parameters for DMRS bundling for PUCCH (see TS 38.214 [19], clause 6.1.7). DMRS bundling for PUCCH is not supported for PUCCH format 0/2. In this release, this is not applicable to FR2-2.","paragraph_zero_based":28695},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecodingPUCCH","paragraph_zero_based":28696},{"literal_text_all_w_t_and_m_t":"This field is used for PUCCH formats 3 and 4 according to TS 38.211, Clause 6.4.1.3.3.1.","paragraph_zero_based":28697},{"literal_text_all_w_t_and_m_t":"format0","paragraph_zero_based":28698},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 0.","paragraph_zero_based":28699},{"literal_text_all_w_t_and_m_t":"format1","paragraph_zero_based":28700},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 1.","paragraph_zero_based":28701},{"literal_text_all_w_t_and_m_t":"format2","paragraph_zero_based":28702},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 2.","paragraph_zero_based":28703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2fc8f47eb1ecdac50d4a6589799a62ba7fd1d710686a99d4f5c6c2a3bbabf4bf","2405d4567922324aeefec96f5135a3ca33a8f4113f018c216d9f4294407ce582","0cc75b5d653655a2982d094d5d68f5d697411e57dccd449678aa8f897597d318","243353da21ea07f921cf6959c0a3339b0428f79c5ac4e674fc237c526f9b6c81","39615dd7f00e7f2058b8d88495520585b473771d35ce4d35e54e3b8acfb66ba5","d98971d83a16e5e9f8ae3739693cea68f0e4556035c117fdd5f9f1e6e4e836ab","2c5c7d06b7a97e491dae66d88190cd5155dfe69b1eaa7a5dc84de8191eaaa2d7","8ba5f0f46ed2510e4b143bdec5defe8eba4568aeccc89a98a24c0631083cb6d4","74586b6b84bfef59c0aa0ed971c14ff468e597f0e1c0ac3ea515a5d218bbf46f","a4cb339a6e0a4d517b576bfffc8b3843139b0a3ff0552246aaabd33e2f971811","dc508f484f43d162ee0184f89a25d32b3e25c9afbb9a87ed8e170aec3e75f986","7be8ec8e07b697d6417357ff3eedd8cd54db590fe798c1e82593641ff32bae98","b7e70e1f75e11b8bc56ef8ee6f5f81490e05f73df300f4d18df25e1eb2198514","773ef60b8e510645e2f73d9a176c471039ebe5b62867f80b0c4f3516d6360b51","a9beb74e1ca370f5b259798c8f6703f98a8acdca9167ecc489a9cd66993cd9a4","93e6f2807abcf5e155a5e75b57b4d4efe96bca17a3d18a6f41d2bd5323ce3bb6","03cd4bc2e6903502d5e814ebd8cc18cc4e8abd6171416dfce4c2a9769ce5818a","2dd7ef3cfe38491ed9b9fec59f4193f787dbd1d5a61fa9caa365304fdc04b395","17dec176dca3a8282b995fe2c16b73b3c84428f410af23413f3707d54e11dd22","422baf0002a6f74b0634206c1ea6cb9d780f93c4f56f321e117d57c0600abe08","f5b61a482afb77241e743d84bb8a4ee46f75733896e6d80bb626a60f50c93827","06764381e825da02a9373117d996684c39ceca358b670c271880f8afd51280e7","551a86189fda84bc803fa5976f3e11aac822866564907cc3b4ad1d24ea4b81eb","1dde9afb4709c05f4e6583e2c2641fe00dbe5ae7448951d6ddb5432d4813e7bf"],"paragraph_range_zero_based":[28680,28703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28680"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"format3","paragraph_zero_based":28704},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 3.","paragraph_zero_based":28705},{"literal_text_all_w_t_and_m_t":"format4","paragraph_zero_based":28706},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 4.","paragraph_zero_based":28707},{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":28708},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when a PUCCH resource used for repetitions of a PUCCH transmission includes first and second spatial settings for FR2, or first and second sets of power control parameters for FR1 (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":28709},{"literal_text_all_w_t_and_m_t":"numberOfBitsForPUCCH-ResourceIndicatorDCI-1-2","paragraph_zero_based":28710},{"literal_text_all_w_t_and_m_t":"Configuration of the number of bits for \"PUCCH resource indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":28711},{"literal_text_all_w_t_and_m_t":"powerControlSetInfoToAddModList","paragraph_zero_based":28712},{"literal_text_all_w_t_and_m_t":"Configures power control sets for repetition of a PUCCH transmission in FR1. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":28713},{"literal_text_all_w_t_and_m_t":"pucch-PowerControl","paragraph_zero_based":28714},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUCCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":28715},{"literal_text_all_w_t_and_m_t":"resourceGroupToAddModList, resourceGroupToReleaseList","paragraph_zero_based":28716},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing groups of PUCCH resources that can be updated simultaneously for spatial relations with a MAC CE.","paragraph_zero_based":28717},{"literal_text_all_w_t_and_m_t":"resourceSetToAddModList, resourceSetToReleaseList","paragraph_zero_based":28718},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resource sets (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":28719},{"literal_text_all_w_t_and_m_t":"resourceToAddModList, resourceToAddModListExt, resourceToReleaseList","paragraph_zero_based":28720},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resources applicable for the UL BWP and serving cell in which the PUCCH-Config is defined. The resources defined herein are referred to from other parts of the configuration to determine which resource the UE shall use for which report. If the network includes of resourceToAddModListExt, it includes the same number of entries, and listed in the same order, as in resourceToAddModList.","paragraph_zero_based":28721},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-1-1, secondTPCFieldDCI-1-2","paragraph_zero_based":28722},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-1-1 and DCI-1-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1.","paragraph_zero_based":28723},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToAddModList, spatialRelationInfoToAddModListSizeExt , spatialRelationInfoToAddModListExt","paragraph_zero_based":28724},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and PUCCH. Reference RS can be SSB/CSI-RS/SRS. If the list has more than one element, MAC-CE selects a single element (see TS 38.321 [3], clause 5.18.8 and TS 38.213 [13], clause 9.2.2). The UE shall consider entries in spatialRelationInfoToAddModList and in spatialRelationInfoToAddModListSizeExt as a single list, i.e. an entry created using spatialRelationInfoToAddModList can be modified using spatialRelationInfoToAddModListSizeExt (or deleted using spatialRelationInfoToReleaseListSizeExt) and vice-versa. If the network includes spatialRelationInfoToAddModListExt, it includes the same number of entries, and listed in the same order, as in the concatenation of spatialRelationInfoToAddModList and of spatialRelationInfoToAddModListSizeExt. If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":28725},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToReleaseList, spatialRelationInfoToReleaseListSizeExt, spatialRelationInfoToReleaseListExt","paragraph_zero_based":28726},{"literal_text_all_w_t_and_m_t":"Lists of spatial relation configurations between a reference RS and PUCCH to be released by the UE.","paragraph_zero_based":28727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8f4217b7a92091eb53fbdfa8866512d282aabdab5eef82c78562f159bd008071","3774b6e24221e38793e9b41e9d0c7f39ccc4ce672bf0565e4323a11ac48eae88","4b974452ceb3b8fc7cb59b2e7212e621e475c356bddc098213085d8dd3dfdd1e","38e8389bce0b82ed2340a7caafb4a1d39c797dde119663162ee171676cb7d79f","e48f5e36d2422dba9cc22860dcbdb89e5baa08b99b1e0826256969f68f2cc984","d4cf13f96d1f9dc5690b5d0416e84d8dea313b97fb8b63bc67a6ee5eb7cc0994","23d683faedb083385e87a7a14359f03a04ee33e5e1b4220e9660735038a39f4b","06f3ee9e3c764c3121bacab8be82138c5196972032d2f4e7284d6c30cbbf3073","8b15e90ac39fb1d5c6ebb427c32c620c4a4d05830ded69357ffa6f4437894de0","2539e6a1c0db3b4dfe2fbfb7e2fffdf4868426c63d8e07e29271e6f506e44504","28d31261b667d247ed07c55fac031bb6076d63e35cb3789203f0a3c0be95b339","3abf160e3d4ebb27b6cbab3bac78384aee55d20b1a7394a4706961d567e9753e","173e7fdb8d00e8a53d72bba61f82c0c253a88f1fd4835c6f6d6c5035c9730e71","3376598691b2756bc22e53071aa5fdfb92584983cba426e86bfe42d57205e928","00d11f896ebc01900a409fa742cead8cb9dfbc8e3a90d80c455e497dcf747a48","02f0ff2bf68bb2218cd2a1a80316f73fb7cc040946663bacf5977a4b32681d6e","096b513216142e75ebe40ee5d9b65ee29c3385e20514f57d6d701b5210f49093","33da59fe8a54cfd3e2b2ab8ede86cf1290b0d3c27d259c4e89c74398e0ec410f","7ec98c605fe656e55daea2e4840ce80e2014273e577fcd5da2a7d5713f72e14f","ab801d9ac77ead371e15f915bdd4c590eb9094fd26926ebfe28500a84d31f211","83f60c24e348f7863851e77d114b2e92bfd6d56005466e1733fd4d0c9181ae28","194362f17a34a05fd36f0b651184c73e963eb7e8d4834c2483df109b19e0bf8e","25b344b2545159e0a9485bfd585ee3c4000ac171f163795f294dc3e62bd4c04b","5bf8868c6b360a864a3a7ce1603cbbf50f5a3b74ab7588a2e3cdb8252bcea337"],"paragraph_range_zero_based":[28704,28727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28704"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-List","paragraph_zero_based":28728},{"literal_text_all_w_t_and_m_t":"Indicates a list of PUCCH resources for DL SPS HARQ ACK. The field maxPayloadSize is absent for the first and the last SPS-PUCCH-AN in the list. If configured, this overrides n1PUCCH-AN in SPS-config.","paragraph_zero_based":28729},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-ListMulticast","paragraph_zero_based":28730},{"literal_text_all_w_t_and_m_t":"The field is used to configure the list of PUCCH resources per HARQ ACK codebook for MBS multicast.","paragraph_zero_based":28731},{"literal_text_all_w_t_and_m_t":"subslotLengthForPUCCH","paragraph_zero_based":28732},{"literal_text_all_w_t_and_m_t":"Indicates the sub-slot length for sub-slot based PUCCH feedback in number of symbols (see TS 38.213 [13], clause 9). Value n2 corresponds to 2 symbols, value n6 corresponds to 6 symbols, value n7 corresponds to 7 symbols. For normal CP, the value is either n2 or n7. For extended CP, the value is either n2 or n6.","paragraph_zero_based":28733},{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-1-1, ul-AccessConfigListDCI-1-2","paragraph_zero_based":28734},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable, respectively, to DCI format 1_1 and DCI format 1_2. The fields ul-AccessConfigListDCI-1-1-r16 and ul-AccessConfigListDCI-1-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.2.2-6). The field ul-AccessConfigListDCI-1-1-r17 indicates a list which only contains UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.2.2-6A).","paragraph_zero_based":28735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28736},{"literal_text_all_w_t_and_m_t":"PUCCH-format3 field descriptions","paragraph_zero_based":28737},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":28738},{"literal_text_all_w_t_and_m_t":"The supported values are 1,2,3,4,5,6,8,9,10,12,15 and 16. The UE shall ignore this field when format-v1610 is configured.","paragraph_zero_based":28739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28740},{"literal_text_all_w_t_and_m_t":"PUCCH-FormatConfig, PUCCH-FormatConfigExt field descriptions","paragraph_zero_based":28741},{"literal_text_all_w_t_and_m_t":"additionalDMRS","paragraph_zero_based":28742},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables 2 DMRS symbols per hop of a PUCCH Format 3 or 4 if both hops are more than X symbols when FH is enabled (X=4). And it enables 4 DMRS symbols for a PUCCH Format 3 or 4 with more than 2X+1 symbols when FH is disabled (X=4). The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.2.","paragraph_zero_based":28743},{"literal_text_all_w_t_and_m_t":"interslotFrequencyHopping","paragraph_zero_based":28744},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables inter-slot frequency hopping when PUCCH Format 0, 1, 2, 3 or 4 is repeated over multiple slots. For a PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":28745},{"literal_text_all_w_t_and_m_t":"maxCodeRate","paragraph_zero_based":28746},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":28747},{"literal_text_all_w_t_and_m_t":"maxCodeRateLP","paragraph_zero_based":28748},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. This field configures additional max code rate in the second entry of PUCCH-ConfigurationList-r16 for multiplexing low-priority (LP) HARQ-ACK and high-priority (HP) UCI in a PUCCH as described Clause 9.2.5.3 of TS 38.213 [13]. The field is absent for the first entry of PUCCH-ConfigurationList-r16.","paragraph_zero_based":28749},{"literal_text_all_w_t_and_m_t":"nrofSlots","paragraph_zero_based":28750},{"literal_text_all_w_t_and_m_t":"Number of slots with the same PUCCH. When the field is absent the UE applies the value n1. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":28751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6c57c916b4cfa984c4e625e10ccb759a4a8203432fdd16095e7fbb3e37448f6f","f78c7715962420b30ded7331dfd1484bf4228f3278eebddbf90d72511c709896","4a49be8d8255a5c2725b2802294f64a709af0414e6765f56f17add0e53624b92","dba55328b7c0bd3eb827a6df5beff6605d71ba99dbc3258d038cf1fb84e83114","ee596fd5a94ffc76b125e69fd19ce59def41acc16a1d8ea8d001899f07a0a724","70c1ee791d2c72eb1dc3a185413d348bfa2efdc162c8677c92f2d251a0754457","9cccae542d710cf7780cb600b91e0981c9f26ff7d5d893656326cb6e0e305b9f","8f0452ad2cfe40039a86b1d930f18ca1e34dbd04f90bbc6b8ead78fa35b54c69","3367836525999b42392c842e417a1dd21e0045cfb723600f97791e453d7dd3c1","b04883fb054cf121ddd48c8de30bd7ceb8cd883dd4c9c673e74a842479496fb2","340422965b45f18813ec66222f60a332cae2b67c824a80a858bb539f4e552de0","6e98b6455e48194f39a5e7a45ebe251631f9b2c0e73746bacc0ff9e2f486823d","e8a1fc0b11be8763c223adbf6fb59ad9fd833c281d57328643a91619de013480","244435ea198f23f3d0925913b3571d4eb4504453ae1641c35a5fbeff6d5b1004","c5e81866157c7c0ec3a0fa4239e18e5fd424340296af8baf2c9c74db78fc9525","6f6c6f5756d05c6c7c0618feb4a2507c87a8f651119d8a62c977545e854d2519","cc17fd6f96a93c86be21f0aafbc775f86fbb88d25c1ece44ff692ee7b617465d","eb6ab69d60c902d7e9c7af421da0203d175cb19bf660de24ca33b37dd22cd44c","356ce461c5ee1097911a094c2b19ddf7bc2fbc4d500792e6578d60238d705fd5","dfb10ad3f6b3efa06247fddf0b0cf6042646d415efee87328132155288074c01","871a99463579a82ef60c34264886b9ab3fd308588a2aa95035914097b5a92d46","20b682a7c235d78f0adf903f2940ceb9aac1c5a61a25aabfeaa136af77fa6af3","2493d17fffc3b4f1cd48c26d67ff1e5fc3f2062464e6106bbedaebc7f8291283","0cfedb7af73a94b2121789937841b5a6e0f42734f3cde709cf479dc797bb58c3"],"paragraph_range_zero_based":[28728,28751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28728"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pi2BPSK","paragraph_zero_based":28752},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses pi/2 BPSK for UCI symbols instead of QPSK for PUCCH. The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":28753},{"literal_text_all_w_t_and_m_t":"rb-SetIndex","paragraph_zero_based":28754},{"literal_text_all_w_t_and_m_t":"Indicates the RB set where PUCCH resource is allocated.","paragraph_zero_based":28755},{"literal_text_all_w_t_and_m_t":"simultaneousHARQ-ACK-CSI","paragraph_zero_based":28756},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses simultaneous transmission of CSI and HARQ-ACK feedback with or without SR with PUCCH Format 2, 3 or 4. See TS 38.213 [13], clause 9.2.5. When the field is absent the UE applies the value off. The field is not applicable for format 0 and 1.","paragraph_zero_based":28757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28758},{"literal_text_all_w_t_and_m_t":"PUCCH-Resource, PUCCH-ResourceExt field descriptions","paragraph_zero_based":28759},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":28760},{"literal_text_all_w_t_and_m_t":"This field indicates, for PUCCH transmission(s) corresponding to this PUCCH resource, if UE applies the first, the second or both \"indicated\" UL only TCI or joint TCI as specified in TS 38.213 9.2.2. For PUCCH resources belonging to a PUCCH group, network configures same value. If more than one value for the field coresetPoolIndex is configured in IE controlResourceSet for the BWP, the value 'first' corresponds to the \"indicated\" joint/UL TCI states specific to coresetPoolIndex value 0 and the value 'second' corresponds to the value 1, respectively. In this case, network does not configure the value 'both'.","paragraph_zero_based":28761},{"literal_text_all_w_t_and_m_t":"format","paragraph_zero_based":28762},{"literal_text_all_w_t_and_m_t":"Selection of the PUCCH format (format 0 – 4) and format-specific parameters, see TS 38.213 [13], clause 9.2. format0 and format1 are only allowed for a resource in a first PUCCH resource set. format2, format3 and format4 are only allowed for a resource in non-first PUCCH resource set. The network can only configure format-v1610 when format is set to format2 or format3. The network only configures format-v1700 when format is set to format0, format1 or format4.","paragraph_zero_based":28763},{"literal_text_all_w_t_and_m_t":"interlace0","paragraph_zero_based":28764},{"literal_text_all_w_t_and_m_t":"This is the only interlace of interlaced PUCCH Format 0 and 1 and the first interlace for interlaced PUCCH Format 2 and 3.","paragraph_zero_based":28765},{"literal_text_all_w_t_and_m_t":"interlace1","paragraph_zero_based":28766},{"literal_text_all_w_t_and_m_t":"A second interlace, in addition to interlace 0, as specified in TS 38.213 [13], clause 9.2.1. For 15kHz SCS, values {0..9} are applicable; for 30kHz SCS, values {0..4} are applicable. For 15kHz SCS, the values of interlace1 shall satisfy interlace1=mod(interlace0+X,10) where X=1, -1, or 5.","paragraph_zero_based":28767},{"literal_text_all_w_t_and_m_t":"intraSlotFrequencyHopping","paragraph_zero_based":28768},{"literal_text_all_w_t_and_m_t":"Enabling intra-slot frequency hopping, applicable for all types of PUCCH formats. For long PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":28769},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":28770},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for the PUCCH format, see TS 38.213 [13], clause 9.2.1. This field is applicable for PUCCH format0, format1, and format4 in FR2-2. The supported values for format4 are 1,2,3,4,5,6,8,9,10,12,15 and 16.","paragraph_zero_based":28771},{"literal_text_all_w_t_and_m_t":"multipanelSFN-Scheme","paragraph_zero_based":28772},{"literal_text_all_w_t_and_m_t":"Parameter to configure multiple panel simultaneous uplink transmission SFN scheme for PUCCH resources Ref XXX.","paragraph_zero_based":28773},{"literal_text_all_w_t_and_m_t":"occ-Index","paragraph_zero_based":28774},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code index (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":28775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3680548644475b5942d2fd5b9939069aae48dbf42665725436d4156b24e8943f","1ff0b8480751ad105095bba13d1d0b51cfd2da6c469abbfeda70f8fcb7b67513","a0580c91f2cf0c6a98034eb4645ffa01b2ddbcf27fac1a64c863fbec14cdb543","adbf9a7eb7efbd7e4b5198d472c4620fb1b9ae25c0b6766365e6e23ceefa24b5","5dde79e64d9032fea707df149aac591e7435ffdfea8b714ca47edc5b27ef20b2","95808ca8b94558b80b357a47e29cfa5fbb210457c5d88f0520aeca1c99ec11a0","c506737e4d35a1c506242585ef7c368cd4a8ec60e0440b02ac620143ed836d2c","8a4e45b9f8dbdd9139edd25429141282854ae81c2d60ab6e44062b135631828a","23c6f127f3a03cc54f13f93d98fec72d6b451d5a26a2b28ad617f4d306e80249","11a2ce117739864b6a53937093a546ef7e5ebb4349300713a1e2e67e35cb350d","cce15fed1ef575e36a7205065f01a04a2b3df7f559874460f58f39a251df505c","2d466e02843b9fbaaa3b3538ade69773adda976446554c7563c61e9899409ea2","2370937cf33255f01b76fcae5087008c3f5bbccf62ecf49cc38df23625ab6448","966cc94a9d2a66b0ef6bf0022c33ccfe81535c6e49b8b5b35dcf8b91931d7afe","d72b818be2c62ee35aeb88257293a0169130a398a763ca325de2a92803d194d2","1d6c8aa1584332e1a29794f9bb196a876b54396708644ce22f9e3bd4416c1747","742b05464120fd9d229652fb5d02c95a6983674e36ef64fc89b21eedd49f1c85","922bcee3021a43157a03aeb885154ce0d5a76c0b010c9b93bc4d0ee0e528988b","b55dea5de98a12cabb5b649c5879f77a76d25156b982d36e0bbcf3b9471d6757","3c43105bcedef67ae7868dc223190cfc5df6ec11904af4be45e9d64d4f81b274","11c0bedbd1421e16b7531e27b61755187c1d2a08001df2dbd43d2932cc6f2295","6a94c084daa36f5e943dd17e3fd13e513271337a27296a36ebc84d2a0b08d789","b1e95c870fb264aada3e43ca0b88440056a742bf30a354206f8a5b025a4b419d","380227bb78e902047a700341bc857b37ddb7424f82a674fe5d9809918cfa9340"],"paragraph_range_zero_based":[28752,28775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28752"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"occ-Length","paragraph_zero_based":28776},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code length (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":28777},{"literal_text_all_w_t_and_m_t":"pucch-RepetitionNrofSlots","paragraph_zero_based":28778},{"literal_text_all_w_t_and_m_t":"Configuration of PUCCH repetition factor per PUCCH resource with associated scheduling DCI corresponding to Rel-17 dynamic PUCCH repetition. For a PUCCH resource, if both the field pucch-RepetitionNrofSlots and the field nrofSlots are present, the field nrofSlots is ignored and apply the value of pucch-RepetitionNrofSlots corresponding to Rel-17 dynamic PUCCH repetition. If this field is absent in a PUCCH resource with associated scheduling DCI, the UE applies the value of field nrofSlots.","paragraph_zero_based":28779},{"literal_text_all_w_t_and_m_t":"pucch-ResourceId","paragraph_zero_based":28780},{"literal_text_all_w_t_and_m_t":"Identifier of the PUCCH resource.","paragraph_zero_based":28781},{"literal_text_all_w_t_and_m_t":"secondHopPRB","paragraph_zero_based":28782},{"literal_text_all_w_t_and_m_t":"Index of first PRB after frequency hopping of PUCCH. This value is applicable for intra-slot frequency hopping (see TS 38.213 [13], clause 9.2.1) or inter-slot frequency hopping (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":28783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28784},{"literal_text_all_w_t_and_m_t":"PUCCH-ResourceSet field descriptions","paragraph_zero_based":28785},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":28786},{"literal_text_all_w_t_and_m_t":"Maximum number of UCI information bits that the UE may transmit using this PUCCH resource set (see TS 38.213 [13], clause 9.2.1). In a PUCCH occurrence, the UE chooses the first of its PUCCH-ResourceSet which supports the number of bits that the UE wants to transmit. The field is absent in the first set (Set0) and in the last configured set since the UE derives the maximum number of UCI information bits as specified in TS 38.213 [13], clause 9.2.1. This field can take integer values that are multiples of 4.","paragraph_zero_based":28787},{"literal_text_all_w_t_and_m_t":"resourceList","paragraph_zero_based":28788},{"literal_text_all_w_t_and_m_t":"PUCCH resources of format0 and format1 are only allowed in the first PUCCH resource set, i.e., in a PUCCH-ResourceSet with pucch-ResourceSetId = 0. This set may contain between 1 and 32 resources. PUCCH resources of format2, format3 and format4 are only allowed in a PUCCH-ResourceSet with pucch-ResourceSetId > 0. If present, these sets contain between 1 and 8 resources each. The UE chooses a PUCCH-Resource from this list as specified in TS 38.213 [13], clause 9.2.3. Note that this list contains only a list of resource IDs. The actual resources are configured in PUCCH-Config.","paragraph_zero_based":28789},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28790},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28791},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28792},{"literal_text_all_w_t_and_m_t":"PI2-BPSK","paragraph_zero_based":28793},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if format3 and/or format4 are configured and pi2BPSK is configured in each of them. It is absent, Need R otherwise.","paragraph_zero_based":28794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28795},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigCommon","paragraph_zero_based":28796},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigCommon is used to configure the cell specific PUCCH parameters.","paragraph_zero_based":28797},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon information element","paragraph_zero_based":28798},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9df2863122848f4504d183d865c8a62ab16c2fad276f5dfa330de9f83c3ec79c","53cc900c3a297a2224717da68c0f0fec44e3754000947ed6f2e8845e4421e808","56cff315a8014142a9cd4151736381e4d44e05e191cec3ffad048bdb57f341af","2c53436f6da9b9b330be81258d6c3276aceddd76726f39562ae01b2e95454627","98c043b86817e0afc7adb8c7bfdca7ea77ada1bf045f7df9f08be87377b1e7c5","cba07b7d98ab2488cae1aaef5edaccd039ac5307caf741ecfcac780518f03500","a07f5f32f9314aa8b723b47c987bf7964d901577d1b1139675cd259b6e415cfd","2da32c0acd5e4cec5183e10c5dcdba1fd8246d307e00fce129b76644cecd991a","3348d7557938bb63843cd07d543b79c9a19e8d3efa97c43df51a5f2b4d483576","a5771d4c2d57eaa92675b9cd99e2cc841210cda6900b62ecad339a2cc97a12b8","4655eed481121707744c6bdda35780210b40024cb91986b7c89a3aab6f6b0164","512c371d47a306def387a90ee112908c9a000e0c72908c04639618df844d95ed","7055a2f1cb914da6f78a3a01815e6514724fba7f1e53a021fcab181bdf411a37","24c887eede77b263deb6c86752ac4ee55652d6bb11986b636a91c5368b0f7c7f","cda110ca070403066a7d59cfabb09487c2a4ded7687695545d3a95a3e3e27f77","08f8cce7b4768915de1b21a8da3c9c4b16388a4a4f929754d7b92647eb89a895","55e09f6b41ee8c49ad7ab845cca4c8cab0b2745930c7a3cf02a87cfd796c4d95","3109dbac178c637b1a0c18525e5f823f8b79ff8e5e3838adc7a0525134fd5606","2b383a3755d07405be2393df0736d6e52ab1173adcc1d7c55c11b7dca602b0bf","d1edf5d9b17baa75878f2dac2f3bbc3dbb0681540905e80339c46a7f3f034634","9fa698f3acd97c8896b47d275e68e410e0d30e321691e81695e8cf5265bcefc8","f64bd66f01837dcd911992f5b781a7f01f0ddecfd4fd2404a84e34758e7318e2","e7bc8d34b7e2aabd86549cba8f87b759c297b1cef745928497b31d10b2aa0535","da8ea313b00158af7fbd8f62e79c4e41947347484c425e78c43c2b4e92c842cc"],"paragraph_range_zero_based":[28776,28799],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28776"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-START","paragraph_zero_based":28800},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28801},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":28802},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommon                INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":28803},{"literal_text_all_w_t_and_m_t":"    pucch-GroupHopping                  ENUMERATED { neither, enable, disable },","paragraph_zero_based":28804},{"literal_text_all_w_t_and_m_t":"    hoppingId                           INTEGER (0..1023)                                    OPTIONAL,   -- Need R","paragraph_zero_based":28805},{"literal_text_all_w_t_and_m_t":"    p0-nominal                          INTEGER (-202..24)                                   OPTIONAL,   -- Need R","paragraph_zero_based":28806},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28807},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28808},{"literal_text_all_w_t_and_m_t":"    nrofPRBs                            INTEGER (1..16)                                      OPTIONAL,   -- Need R","paragraph_zero_based":28809},{"literal_text_all_w_t_and_m_t":"    intra-SlotFH-r17                    ENUMERATED {fromLowerEdge, fromUpperEdge}            OPTIONAL,   -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":28810},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommonRedCap-r17     INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-RedCap","paragraph_zero_based":28811},{"literal_text_all_w_t_and_m_t":"    additionalPRBOffset-r17                 ENUMERATED {n2, n3, n4, n6, n8, n9, n10, n12}        OPTIONAL    -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":28812},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28813},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28814},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28815},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-STOP","paragraph_zero_based":28816},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28818},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon field descriptions","paragraph_zero_based":28819},{"literal_text_all_w_t_and_m_t":"additionalPRBOffset","paragraph_zero_based":28820},{"literal_text_all_w_t_and_m_t":"When intra-slot PUCCH frequency hopping within (e)RedCap-specific initial UL BWP is disabled, each common PUCCH resource is mapped to a single PRB on one side of the UL BWP. This parameter determines an additional PRB offset in the PRB mapping for the PUCCH resource. If the field is not configured, the UE shall assume an additional PRB offset of zero.","paragraph_zero_based":28821},{"literal_text_all_w_t_and_m_t":"hoppingId","paragraph_zero_based":28822},{"literal_text_all_w_t_and_m_t":"Cell-specific scrambling ID for group hopping and sequence hopping if enabled, see TS 38.211 [16], clause 6.3.2.2.","paragraph_zero_based":28823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9d0a8583aaa97fa91b5d40db74c8d9aeb876dcfacd868267b090e5b4bf98bb1d","a40ac5c865263408fe575445bec4d5471df53655dc98e04d76aed1a833256537","3ea4ebebc6fffa88a5d40541f43e730cfc6d45089be5d82ce04e98c38ae49bb0","36f6da67ab9001b840ee207d4190a8b722687e92c56798ad137fe558db6de1e9","9f64940439be3731f7ef1ce2424c4195318dc8ab99ee318ff58e6efd69228d54","013781dc23af7c5562cf90a21663ee34ef8d489c053dd81d648f9d7daee1d927","c714e1667dfda470be57063f8e972bb1d558b9ae0a8efa1a06fd401e46bf84bd","82a4c19c4b63fc2c62204f255bf68ef1e60051a0a09586114dd96c9206f6cbd5","6dc3aa337a894d91d92fa546ff8a7fc79acc17c9f2de81b26aa16e3d74baa4c4","5ad5b04f0549607066f829d9eaff005e081ec189a4062e1b5efcd08a35c83a72","cf80d165a14dca7a0f7c9a7598edb2781ceb124807e0906119d75147f6e0a19f","5e860c5ecf27df0617720b4fdb55ebfa49a3fe353302bbee261dd6247aed7cab","dec6e27ee84353acda51acfccdcd3312d77650b3625a0e3714902df5a08d8976","46e67b21a6f74736a05e3d3bdac8fa376548575b46c4895fc062cf7302b29196","1dac74721c9ef1a14eec35f2889973bcdd581b5894e5d424caceace756e7e9e0","a30d3093d1a27dba9e03570e968739015744fe90f1ae4e5a7fbc3925f6542481","5326ddbaa321f96426b2ae7fa06a64b79abbf5932e0df9169ed0de0fdaf89f92","4cc1d9e7b9a4552833aee2828c50d33b3073f9c116071f9afee634620e2389d3","6b7473ba0478031d1f2c5609dfc096fedfc684856f93dca509270ba07748b6bf","c0c1950d77805f530fe177b0def639ea99cfbf553f2222803724eefe62fde7ef","d76033437bfcdbfa53b84f2332ca31eebd696baf39a29143c50748605e06b09a","d6abe9c00aca7a2838c8cef1819094a3d31ae138752eb7e209c1423eb7b04c6d","ef556e4d7155b403e7b8a3df3394ca9adc4b026964ecf9ad525393013ca0c491","c859b746a9a581fe7f471027a35c9673f588075756363d83606b976bedf509ce"],"paragraph_range_zero_based":[28800,28823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28800"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"intra-SlotFH-r17","paragraph_zero_based":28824},{"literal_text_all_w_t_and_m_t":"In case a separate initial UL BWP is configured for (e)RedCap UEs, the presence of this parameter indicates whether intra-slot PUCCH frequency hopping within the separate initial UL BWP in the common PUCCH resource is enabled for (e)RedCap UEs. If this field is absent, intra-slot PUCCH frequency hopping within (e)RedCap-specific initial UL BWP is enabled. If this field is present, intra-slot PUCCH frequency hopping within (e)RedCap-specific initial UL BWP is disabled and each PUCCH resource is mapped to a single PRB on one side of the UL BWP and this parameter determines whether the PRB index in the PRB mapping is counted in increasing order from the lower edge or in decreasing order from the upper edge of the UL BWP.","paragraph_zero_based":28825},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":28826},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for PUCCH format 0 and format 1 in FR2-2, see TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":28827},{"literal_text_all_w_t_and_m_t":"p0-nominal","paragraph_zero_based":28828},{"literal_text_all_w_t_and_m_t":"Power control parameter P0 for PUCCH transmissions. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":28829},{"literal_text_all_w_t_and_m_t":"pucch-GroupHopping","paragraph_zero_based":28830},{"literal_text_all_w_t_and_m_t":"Configuration of group- and sequence hopping for all the PUCCH formats 0, 1, 3 and 4. Value neither implies neither group or sequence hopping is enabled. Value enable enables group hopping and disables sequence hopping. Value disable disables group hopping and enables sequence hopping (see TS 38.211 [16], clause 6.3.2.2).","paragraph_zero_based":28831},{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommon","paragraph_zero_based":28832},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":28833},{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommonRedCap","paragraph_zero_based":28834},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters for (e)RedCap UEs. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":28835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28836},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28837},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28838},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":28839},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the initial BWP (BWP#0) in SIB1. It is absent in other BWPs including the (e)RedCap-specific initial uplink BWP, if configured.","paragraph_zero_based":28840},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCap","paragraph_zero_based":28841},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the (e)RedCap-specific initial BWP. It is optional present, Need R, in the PUCCH-ConfigCommon of the initial BWP configured by initialUplinkBWP. It is absent in other BWPs.","paragraph_zero_based":28842},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCapOnly","paragraph_zero_based":28843},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need S, in the PUCCH-ConfigCommon of the (e)RedCap-specific initial BWP. It is absent in other BWPs.","paragraph_zero_based":28844},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28845},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigurationList","paragraph_zero_based":28846},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigurationList is used to configure UE specific PUCCH parameters (per BWP) for two simultaneously constructed HARQ-ACK codebooks. See TS 38.213 [13], clause 9.1.","paragraph_zero_based":28847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8574f4271bf51c8f649435fc0009e97b7c60901ea9ddd6f3eff5bc3e54046f0e","6f0cdd5a97da30e8ad7a14d0ea3997ad6ed8161272a33745f20279a0bff4f43c","35f30fe6f0855fdc1e57b638f8f3b1e65090bbb319296a101bdb0770f4499ff6","9c1baa0048a148e4036091d54e5089e762a6723abdecd884921759ae1555507a","7abef9c4be8fbc287347f1b482872cb81c330c58ba1e110f5deab2ea4b1d3d46","17eaa578bb9ae626ce6802a1b4816cc8fb1cd0fc5872b44a9ab9313bffe2f31e","89bfce846f3965b4269b7cf8a545efb5fc01c8296caf93cce9f0cb68467fc62e","5ba806a89bfa627ff7ffaa9b927a41e2e8664571add2b2a1bea51b8ff961dc31","b1020d9c92d652b4021c05d17583be335b2edbb82e5150924c0dd7a5ea2e7ae3","2c8972e10670659c3d52a153c17b92ff8ba262e4efb2ccbe3e4da606f9f3b866","c9bcf2804df146fecbc6f7d354337cde17171a561b32c774c8a6f40a8b9e07d2","c88230ce26c2cb79c7a217b702de5207108866f0251f18db8851aed0b248d3ec","0185a06972167df4097e0a