es the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":18617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18618},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18619},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18620},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":18621},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a BH RLC channel. It is optionally present, Need M, otherwise.","paragraph_zero_based":18622},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":18623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ea4c0686966a3a5e5d60636c6976ee7225b5433a3fc4fa61b49322328c7a11b9","9ce2cf889399ff10a58c5b07c532f9302b567b390982ef853a0e5421598158b4","eda8f56921a24ad5b874143033e232ca2e04d84d4c5ecc8861cc46daabf4a5e1","9123e5ac00fb2ca29122c076b5070ec7dd736944dcd6004e34e451037455c45e","7bea865dc124aa27024e2724d8a5d34140a5fa1b5f07c22e5cab199b4f176d2c","b12f44c44e7529c21c4fcecb14d5e124e9fb78488b2c8acf1362cd6f623358eb","e5416bb881e4610ffdecb6380d3a32e3ef11e947b2362c75a489e5a880ba5f13","b509351b5589237d11479cdd1ef9fc489aa0e48fe42ea00e8e9f7fe2a48fa4dc","458b44f6507f5942bc279573310df1b7d7594133c4acd99a0edeb4ffbf8fcd9a","926286d7bacca05d4f24a2e8f742153c12d6367a2fcb0ee245961457f47690e1","98ce57e668ef103023c453743a9b5b7bbe88dbb54dafefe965d83cc165f0feca","16390e845ae34e4b81ec12c596c81a075eae3622f9181bf629bca3f82516132e","0fbf44ef2f7a7941f53111c73e53805cfe2d90aef44d2de473831c7737580a96","92c132801909b1cfe820fafa8a24928242f2896025e1a1935997cacd5a48297c","7fbc0465d79e1b636cba713b3ee2cc8bb