{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":33936},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":33937},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16          ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}                   OPTIONAL, -- Need R","paragraph_zero_based":33938},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r16                     SSB-PositionQCL-Relation-r16                                    OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":33939},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                     HighSpeedConfig-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":33940},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33941},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33942},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-v1700               HighSpeedConfig-v1700                                               OPTIONAL, -- Need R","paragraph_zero_based":33943},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                                OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":33944},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r17      ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25}  OPTIONAL, -- Need R","paragraph_zero_based":33945},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r17                 SSB-PositionQCL-Relation-r17                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":33946},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                              OPTIONAL, -- Need R","paragraph_zero_based":33947},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommon-v1700                                            OPTIONAL, -- Need R","paragraph_zero_based":33948},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                      NTN-Config-r17                                                      OPTIONAL  -- Need R","paragraph_zero_based":33949},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33950},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33951},{"literal_text_all_w_t_and_m_t":"    featurePriorities-r17               SEQUENCE {","paragraph_zero_based":33952},{"literal_text_all_w_t_and_m_t":"        redCapPriority-r17                  FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33953},{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33954},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33955},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":33956},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":33957},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33958},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b5d0ae42e584b76eddf9ab52dda0155f021a46e3769bfe6ec61d653d78040c2d","89a705255c6cbe13defe0ff0899a202f77673497ef2f939930190db378ca8153","4a0f7b460ca7a2b04bc435737b3b58a8583d4b53f9edd74ef7e8af6d2f2d7157","08da4cdb02a2a68565d692f1b7ef1caabb6201364029074100643109afc1ea31","72300460e5bbe93ba47aa40ef13eb9aba63f940a5c30f86ce69ab57780794a88","0399dfcb9c4777ac7e0267177c5d972af6cee9638e1f7c53efa3e7fc263746fa","d8da9436bc941b4881c6597028dcf6ebd0cce08b59b4d2e71970044a4b59e2df","e2160405738f37e45dc45ad4d8b12e89ffb46c1ea301f6297ece8dafb96be1ec","a5278940ff869cc46dc76b7371524484b32adf3d2356a514b5ce78458832f768","9baa279212ddf0e86d85b0a32079bf3691fed6f1203c24cf6a1a23a907a96201","8d8aa5771d683dff8990433b16b86344d9a348fe572e9b5f57679573db8a4e48","91bfc860e10c4c39d0c391f3e02fec0e2ddf71e0ae6b7459aa66cbcd25341c1d","4b0cbff955c57da02c9fd8bc60283074b3d8ab84a285be926a63bb7e218c5ab2","d5657d338beec563a3475bf2b2ea24fa4940f12fff29672b128f21f9b7ab53ba","1e0b33a2ef92cf30da66c0f89e67a2b43b884c2a256e94be340c6260e6d79666","71bbc410247a9507e80922d0c9e35cbb2bf54b748998a2ea7495d37beff363dc","b43ad10ed42da8b86cfbaebad416fb1784ace57fd32ad7cd0e6f976fddbfcfe8","96d30e6737cea5d96861e279552e3ba3dcbee811d8c36b311cb0942c2ff49d13","6d69ec9b9c6d2fda898d8fe84ac39243fc80f1282b38d245989ed8efe55a34e0","75886d6c05a3943f53ef97ccea411f47a1c99c1eb3611599a8213b3cea19845e","e9507f4c48ef5e533c915e7eff719bcba48692c18cb3d981d7ad0dc13a382059","55db90212b7be90eb1ade8c590c3ef1a643975b2f283e545afd1da174556028e","002a2355a0a073c8453182dda4fc3ea3b654e5ccc363ae53170de3a0401ebe85","6b4128845efbf1ee964775fd3a7be144f422e667ffa2c99639792e65970707ab"],"paragraph_range_zero_based":[33936,33959],"project