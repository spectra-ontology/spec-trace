{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CO-DurationsPerCell field descriptions","paragraph_zero_based":34512},{"literal_text_all_w_t_and_m_t":"co-DurationList","paragraph_zero_based":34513},{"literal_text_all_w_t_and_m_t":"A list of Channel Occupancy duration in symbols.","paragraph_zero_based":34514},{"literal_text_all_w_t_and_m_t":"The maximum duration that can be configured for the following SCS:","paragraph_zero_based":34515},{"literal_text_all_w_t_and_m_t":"-15 kHz: 280.","paragraph_zero_based":34516},{"literal_text_all_w_t_and_m_t":"-30 kHz: 560.","paragraph_zero_based":34517},{"literal_text_all_w_t_and_m_t":"-60 kHz: 1120.","paragraph_zero_based":34518},{"literal_text_all_w_t_and_m_t":"-120 kHz: 560.","paragraph_zero_based":34519},{"literal_text_all_w_t_and_m_t":"-480 kHz: 2240.","paragraph_zero_based":34520},{"literal_text_all_w_t_and_m_t":"-960 kHz: 4480.","paragraph_zero_based":34521},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34522},{"literal_text_all_w_t_and_m_t":"Position in DCI of the bit field indicating Channel Occupancy duration for UE's serving cells (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34523},{"literal_text_all_w_t_and_m_t":"servingCelIId","paragraph_zero_based":34524},{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable.","paragraph_zero_based":34525},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":34526},{"literal_text_all_w_t_and_m_t":"Reference subcarrier spacing for the list of Channel Occupancy durations (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34527},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency range:","paragraph_zero_based":34528},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":34529},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":34530},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34531},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchTrigger field descriptions","paragraph_zero_based":34532},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":34533},{"literal_text_all_w_t_and_m_t":"The position of the bit within DCI payload containing a search space switching flag (see TS 38.213 [13], clause 11.1.1).","paragraph_zero_based":34534},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":34535}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b3fb73b43e3cf7ad668ce348d12e2a33d4564d4359dbedc984102505fb5e1ed6","29038e3e06e247b90c7761020ddb496f50a09d525a6685895e995f341fe33075","7fe145f75ab8cdb0c3f926fd77497bc6834bdcd270b824aad01c3de43b803d33","7ebe33fac6194e1aab3ef4c5c0c4176ad2ac0c29faa13993290995204df4b821","c7a440fa12e2704764c0f4a6f6ed3fb3830a15e4b0ad017221ed4877f18aafc0","28714793b236173a705eaac082de64bc9253043175185f950cbf875c2c45dade","5aecc6df6216baf1b07b8c7a03f2ac7d56fcdf2847fab54b1f7636e2169ccd6b","528146cd639e2d141c67101cf7fac1f11629072247463f96038269eaf08cb1b9","d5be171648defa6d000d65ac29df7ea760fe3a6688247e921ec82f57cf36e860","6b75ba9323a63fb5aac476184d334da53efadeb1acb9d83844fd19f5a2dfb0c7","a7a52bd1e46d6e8f64ac7792469adc8087df0ae69fdc08cca42729141e7405b9","ee32ae792b14466c5a7ce0b294bbb6b1b104e18b348cdf42a69fdc305051f45e","162c1241fada2a223f03b37123b27f9c505493b443356ec70862b688228795dd","e7503e3657b61614e009edaaaf8480c70d23c6bfa3270568649b4c222d533879","7c553651f3357e8235225c3397d0b745b853f53d3b472619c7