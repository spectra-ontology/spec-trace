{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30192},{"literal_text_all_w_t_and_m_t":"CFRA-SSB-Resource ::=           SEQUENCE {","paragraph_zero_based":30193},{"literal_text_all_w_t_and_m_t":"    ssb                             SSB-Index,","paragraph_zero_based":30194},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                INTEGER (0..63),","paragraph_zero_based":30195},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30196},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30197},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-Resource-Index-r16   INTEGER (0..3071)     OPTIONAL  -- Cond 2StepCFRA","paragraph_zero_based":30198},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30199},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30200},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30202},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource ::=         SEQUENCE {","paragraph_zero_based":30203},{"literal_text_all_w_t_and_m_t":"    csi-RS                          CSI-RS-Index,","paragraph_zero_based":30204},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                 SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1),","paragraph_zero_based":30205},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                INTEGER (0..63),","paragraph_zero_based":30206},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30207},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30209},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGDEDICATED-STOP","paragraph_zero_based":30210},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30212},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource field descriptions","paragraph_zero_based":30213},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":30214},{"literal_text_all_w_t_and_m_t":"The ID of a CSI-RS resource defined in the measurement object associated with this serving cell.","paragraph_zero_based":30215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["097c5a40cbaa268398a64b6c57e0b434f1dab493ba4982c9c3b5b849536d2330","9fafe090ad817a9abf865335ae5c3d0d526dfb0e3b8648eb1cf0c6e289edf33b","f51d746b73d5aafecd507faa4d888ce900435760761062e8eec749be7d2142b2","1b7ba78da1652d70d893543ec3184fd260b50bed6b9e2310b383eceaa3efddff","771dfdd0d2b3831b71336f93c582ccc33c7e59e92688b1be0c7ee4d769dd8c0d","d18c935f97b1137e9fa1dcf9620636925269360344ab53491ecc0cd4ed3e390e","d3ed19287dabc5fd436e62917264bf86e8c6c3d4158a3efcf0eafecb07dbce75","3339666899d79588c53badc1dce5e65b06ad31affede47bde2ab60062bebfda8","c95abb0f077c8c0f6025e0dfc3fc9a083959ff4f20b2316f05a596ca55c0b3dc","59088c01cdecd79bb200b79290ac12a4b3d4be5da5ac770e1f84a858d761575e","8517b17f31a5d5205d1f7f38c1fc3b6debbd9c4b6bf4436d0d4d67bc99284c23","687cf6c82953b32aee684627249d003d5f068979e68609cb79427869ba0ea7cf","e5854ac158a0afaa105f8e1c428c0d12d1066d456e92736b1421d2e91e3ad1b7","63d77af0de24dad738bcaaa3d1bf40e15c5f6c777a3e505720cfd6c1588ec5a5","2b401bc7499ff3d8c49ab1559cce342e9874b310286b3f0bcee2fe8501feabe1","2269a8d080d4815bd18d1e643c595d3d0f7a674112430a41d9ad4ac5d1edc0b6","447897ca1ff8e31679c85a3656903db2bf07fc6761b711e1519e98f874532aee","1b12cfae35f934aa423eec08138465c805e46dda0b032b66ebbde3f871582d14","830a9cd18de062da490461a43eb379dd7a030730dc762cff6b33c7e6efd8d0a3","5b233d898ac050d27081960f21c3b8bf8ee15c77c8460a7ce89ed83781c198c5","d543e5befb49d2f2000a971edc50b58176e3588f59dd9783e25cca8144a565e5","5baa72e91ece378a0b1ec84078dc02a1f7c722f6dd39358c1ef9418a127202fe","81f1c6f24c843c735929296aada990e2b518da6ff1db80b63f6fb2f7bac88bdc","34bd436fe736c2500384536e88606779da621b1a70f06ed933617317b0e9ced7"],"paragraph_range_zero_based":[30192,30215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30192"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":30216},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing CF-RA upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":30217},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":30218},{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS.","paragraph_zero_based":30219},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30220},{"literal_text_all_w_t_and_m_t":"CFRA field descriptions","paragraph_zero_based":30221},{"literal_text_all_w_t_and_m_t":"msg1-RepetitionNum","paragraph_zero_based":30222},{"literal_text_all_w_t_and_m_t":"Indicates the MSG1 repetition number used for contention free 4-step random access type in TS 38.321 [3]. If this field is absent, the UE performs contention free 4-step random access without MSG1-Repetitions.","paragraph_zero_based":30223},{"literal_text_all_w_t_and_m_t":"occasions","paragraph_zero_based":30224},{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommon in the first active UL BWP.","paragraph_zero_based":30225},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":30226},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":30227},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":30228},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA. The UE shall ignore preambleReceivedTargetPower, preambleTransMax, powerRampingStep, ra-ResponseWindow signaled within this field and use the corresponding values provided in RACH-ConfigCommon.","paragraph_zero_based":30229},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":30230},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion.","paragraph_zero_based":30231},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":30232},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention free random access in the RACH resources defined in CFRA, excluding preambles used for other purposes (e.g. for SI request). If the field is absent but the field occasions is present, the UE may assume all the 64 preambles are for RA. The setting should be consistent with the setting of ssb-perRACH-Occasion, if present, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":30233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30234},{"literal_text_all_w_t_and_m_t":"CFRA-SSB-Resource field descriptions","paragraph_zero_based":30235},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-Resource-Index","paragraph_zero_based":30236},{"literal_text_all_w_t_and_m_t":"Identifies the index of the PUSCH resource used for MSGA CFRA. The PUSCH resource index indicates a valid PUSCH occasion (as specified in TS 38.213 [13], clause 8.1A) and the associated DMRS resources corresponding to a PRACH slot. The PUSCH resource indexes are sequentially numbered and are mapped to valid PUSCH occasions corresponding to a PRACH slot which are ordered, first, in increasing order of frequency resource indexes for frequency multiplexed PUSCH occasions; second, in increasing order of DMRS resource indexes within a PUSCH occasion, where a DMRSid resource index is determined first in an ascending order of a DMRS port index and then in an ascending order of a DMRS sequence index, third in increasing order of time resource indexes for time multiplexed PUSCH occasions within a PUSCH slot and fourth, in increasing order of indexes for PUSCH slots. For the case of contention free 2-step random access type, if this field is absent, the UE shall use the value 0.","paragraph_zero_based":30237},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":30238},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing CF-RA upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":30239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["23bd4cdf41e9d0eefadc0f29fdf64d51bd36f6ab0e75389b4866fa07efdb77fa","3b0d67fd3f1d5cc2704fa7cfc9488dca78acb4c408342f28573e5e3072d94b21","0881b95e7377f6e5c797d348dcebe9fd63f0f3237169c3e11351a25efa087b2b","92821fd1594c3369bf043a4297bc9e58a8a8f71f3ddb173744884b4ba76207da","ba6cd5e87f333dd9b0a79ae5840af4fb31f94d3c5c72b987ad11aa26b1322f90","a6694789cb5397854b0d7b86fd717f5e015c40ebd077099dd7f625e08028f736","671afd950b1b5f89106755e552386e8562531a803b4ad0a7a250aebd2f698c26","4b0cdabc9174c14af6e79b593e3db35d9befb5b9ec5170f23502681f98dd0655","f8ec2eff3364995d7c7e008861a73ea0911a4716f53b7726b498283f447ecc00","a595808945ab35f357a4e1381f3984f4760e188677cef6ebfc8533510635afa7","117a1f96a33553f114f8c2d8e9030390d282c50e7fa47cd0485666797a84415a","a46d977334393db52e95787603893fbb42b3cf9a00742ba78aa7b6a4da13556f","d55627458d8894b0aaa4090cd7a83309393d7e1d8480ff587c544a0b9577ce27","db32a958c2f943215e1e215f237fde828adadcc4a18dedc3ca390dba91a682f9","b09e663cc209627f05bdb5ed9f2613b333d695a5ed5e5b7da78d819cf519539d","236551a70b8bf28f881062527953bd140d6718814834cc5aac6467cce696859e","66211fb665bd02f9af4360da3b38433d4b66ff91857793bb45b768cd0a4098c5","fa90bca6d956f2c144cad56e702d5eb4823f2d3fb6611ec62d625b2a195b064b","f4156b1806e99d0b414ddb725280464f27d17ca52adc88ae9e0478c29792f7ac","4e8b3c3156c350e95ad77af87a1386299afc0d5feb20d3c92aff6ae55e68718a","5916ee5da6820527a9e4e37eae402f31542adb936f636db33af07175aad966e0","c3150f264c68e8166f8b870569e555b262ebb2afb867db60f2a5fbf12e289040","2c62072c34ece9d778339f94789dbfd7f536cd2b4c82bf4c2d99aa995e020118","644f63ef08f3befe7d0c05dcd624ed8f2dd56bd04c616ae0c54d5311c89341ce"],"paragraph_range_zero_based":[30216,30239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30216"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":30240},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell.","paragraph_zero_based":30241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30242},{"literal_text_all_w_t_and_m_t":"CFRA-TwoStep field descriptions","paragraph_zero_based":30243},{"literal_text_all_w_t_and_m_t":"msgA-CFRA-PUSCH","paragraph_zero_based":30244},{"literal_text_all_w_t_and_m_t":"PUSCH resource configuration(s) for msgA CFRA.","paragraph_zero_based":30245},{"literal_text_all_w_t_and_m_t":"msgA-TransMax","paragraph_zero_based":30246},{"literal_text_all_w_t_and_m_t":"Max number of MsgA preamble transmissions performed before switching to 4-step type random access (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when 2-step and 4-step RA type are configured and switching to 4-step type RA is supported. If the field is absent in cfra-TwoStep, switching from 2-step RA type to 4-step RA type is not allowed.","paragraph_zero_based":30247},{"literal_text_all_w_t_and_m_t":"occasionsTwoStepRA","paragraph_zero_based":30248},{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommonTwoStepRA in the first active UL BWP.","paragraph_zero_based":30249},{"literal_text_all_w_t_and_m_t":"ra-SSB-OccasionMaskIndex","paragraph_zero_based":30250},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":30251},{"literal_text_all_w_t_and_m_t":"rach-ConfigGenericTwoStepRA","paragraph_zero_based":30252},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA 2-step random access type.","paragraph_zero_based":30253},{"literal_text_all_w_t_and_m_t":"ssb-PerRACH-OccasionTwoStep","paragraph_zero_based":30254},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for 2-step random access type.","paragraph_zero_based":30255},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30256},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated field descriptions","paragraph_zero_based":30257},{"literal_text_all_w_t_and_m_t":"cfra","paragraph_zero_based":30258},{"literal_text_all_w_t_and_m_t":"Parameters for contention free random access to a given target cell. If this field and cfra-TwoStep are absent, the UE performs contention based random access.","paragraph_zero_based":30259},{"literal_text_all_w_t_and_m_t":"cfra-TwoStep","paragraph_zero_based":30260},{"literal_text_all_w_t_and_m_t":"Parameters for contention free 2-step random access type to a given target cell. Network ensures that cfra and cfra-TwoStep are not configured at the same time. If this field and cfra are absent, the UE performs contention based random access. This field may only be present if msgA-ConfigCommon is configured on the BWP.","paragraph_zero_based":30261},{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":30262},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":30263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d40212c51ed2cb9d0913ec4a11aa3bd3791935bcbc7fd3ba61d0c292ca527ffa","ed7f4b5dd2d03862054d0370ab8c7978962217d5bcc3702ef5879a32842f6f1c","6275fea8a3f93899d1392571a46a630d5814157f