ide multiple measurement instances in a single measurement report; i.e., include the nr-DL-AoD-SignalMeasurementInstances (in the case of UE-assisted mode is requested) or nr-DL-AoD-LocationInformationInstances (in the case of UE-based mode is requested) in IE NR-DL-AoD-ProvideLocationInformation.","paragraph_zero_based":1194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1195},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1197},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1198},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSRP-MeasurementsPerTRP","paragraph_zero_based":1199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["4aac5b6d94fee63235e3b1feca67c6acd08fc528e8b6d168f0d625304ecd1ba2","1bdcee9e29578bfacf15f06f0cc22cea37985b65d5664254fbcfa53e850317cb","3e1dc818e8e87a1c8166927e5cda02914bc8701ddc38899f800c014c3d636ee6","edfe7fc9bb0c4440653401d4609fd8df5263a4ee3ccf4bc443fae83e5470b884","5e04f267779fd63915b526b7d9a5454c95477bed33467fadaf894fe1b0100177","cf913a7162562255d0bdf6875c34600abe71b2964b29fb1b7117a922719c3ad9","d7b8e2bb6e3997909e54b9d2b10eb5e40ab3f3037c913d7033bfb63ea5aebe9c","11241520ae98e9658a767b29356692c164aa1b10fcd05f764e1b5416001d6847","d38a2448abdb25958611ab39bb264ab7f6d3ab88f1ea97c1abdb64f44408102f","f069e8661bd72db39f5d6cbfda710e91ceb96b5c7f1a3d556d1a08dc088c2aa4","5893a17f9c65b693b2df7ec8b2de3562a3127d4c20ddfe0e40524df6cdc43a99","e053227b301b9b9dba475906ad6efc6c614d02e49fa834b1adf188081e619a24","b6c14512d16bcd60a19d741dc59edfc515d84d0f86bf09e90683d65af41e136e","c6302d63767e0ef902e2f6872bdb972ab61942f049f6847fd8f6f6c8c84d7df6","0b12112227eca8879ba9324b82