{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TxProfileList","paragraph_zero_based":51528},{"literal_text_all_w_t_and_m_t":"List of one or multiple Tx profiles, indicating the compatibility of supporting SL DRX as specified in TS 38.321 [3]. It is up to the UE implementation whether/how to apply this field.","paragraph_zero_based":51529},{"literal_text_all_w_t_and_m_t":"sl-PosPreconfigFreqInfoList","paragraph_zero_based":51530},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink positioning configuration for a set of carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in the list.","paragraph_zero_based":51531},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51532},{"literal_text_all_w_t_and_m_t":"–End of NR-Sidelink-Preconf","paragraph_zero_based":51533},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":51534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51535},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":51536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51537},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":51538},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51539},{"literal_text_all_w_t_and_m_t":"9.4Radio Information Related to Discovery Message","paragraph_zero_based":51540},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC information elements that are transferred in Discovery Message.","paragraph_zero_based":51541},{"literal_text_all_w_t_and_m_t":"–SL-AccessInfo-L2U2N","paragraph_zero_based":51542},{"literal_text_all_w_t_and_m_t":"The IE SL-AccessInfo-L2U2N includes the radio information included in Discovery Message used for L2 U2N relay operation.","paragraph_zero_based":51543},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N information elements","parag