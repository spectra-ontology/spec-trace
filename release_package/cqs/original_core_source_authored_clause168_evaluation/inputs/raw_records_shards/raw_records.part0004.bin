ed":29655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29656},{"literal_text_all_w_t_and_m_t":"SFN-Scheme-r18   ::=        SEQUENCE {","paragraph_zero_based":29657},{"literal_text_all_w_t_and_m_t":"    maxRankSFN-r18              INTEGER (1..2)                                                        OPTIONAL,    -- Need R","paragraph_zero_based":29658},{"literal_text_all_w_t_and_m_t":"    maxRankSFN-DCI-0-2-r18      INTEGER (1..2)                                                        OPTIONAL     -- Need R","paragraph_zero_based":29659},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29661},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29662},{"literal_text_all_w_t_and_m_t":"CodebookTypeUL-r18 ::=      CHOICE {","paragraph_zero_based":29663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["fad4934227122a48ef8c19fb006acaad4689d1b0379929a8127de86578c7e938","56a1ae7e5e808dd14ba31ef59f927dd3c8e6e43cba6d4305a9935ab5f8c4e302","f7feb29ff2bf39ee3406062a08af38f7fa9dd1eb3339d84b177f9bd6e9e57f0f","8ed545ec230f0425732cfadf42ad10c7bc2025c0805a3aa7ba9cb5a367cc65fc","bf30a41a271f80c6deb7a0be95f0cbf9918723c60e1c3c2e41e6519135b5bb68","8823c5ed98483530a549930d028377d76fc6af4de65c5af4e05708a3522b7308","f06b5f141fbd1fdb69f39d88bbc04e10fd701abbc59505586ce8dbb8b6e82241","20fba755f4a6f4911bce3c8ef8431f662acced24bb9fd2fabb456b292a28be83","d5c9ed34a67373fe687acb7c14bcc4a72b52bb3d422ffdcefb307d9225ec63d7","979597261008740f005f8e1bf84ef57b61e7a0f55b6e83497aeccf9995918974","65f6b81937ac15546af43adc0c92a5c6d9dcb5056679346ed9f85de8570488c2","a9114f8f3bb504984860bc9834f4ea9c9a9b8e65bb96c6614ddce01