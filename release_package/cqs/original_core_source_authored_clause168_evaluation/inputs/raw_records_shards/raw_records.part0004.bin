ral_text_all_w_t_and_m_t":"It specifies information applicable for sidelink DMRS, SL-PRS measurement.","paragraph_zero_based":47201},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47202},{"literal_text_all_w_t_and_m_t":"–SL-PagingIdentityRemoteUE","paragraph_zero_based":47203},{"literal_text_all_w_t_and_m_t":"The IE SL-PagingIdentityRemoteUE includes the Remote UE's paging UE ID.","paragraph_zero_based":47204},{"literal_text_all_w_t_and_m_t":"SL-PagingIdentityRemoteUE information element","paragraph_zero_based":47205},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47206},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PAGINGIDENTITYREMOTEUE-START","paragraph_zero_based":47207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["45435fd871233952c2b3e52d08358e7fcfbde00c936649b2ef027d8584dd12b2","be54b82dc1d506d908d3fdc8191f26d0b17fe74c8c1246360219af9f848fad5f","092bd696f55ac32195c4f53165a438b46efa3907a9c3eef6b7536c90b733e420","5280cd62b38aeee678944653334c743fc09475fc6b76445d51c1cb738338a932","dfdefbd45e1b3fcaf5970a806784a5e08b3ac8268dc1bae75bb550c157966d0a","fe1eb3f8170c6b211fffaaabafda054a4b5b32df7eaf216da5ccde3059ad6ea3","0b1be1f12338cdfe7e9b615ebd9e01f8ffdcc5048ebd68a01928424aab584079","d6d8e8734c00f956abae10c63fa06158292cd0f31769359cd8a41ab707ef9919","0e7ff9e4480944332fdc846baea2921c8f12c6d57ba9a96fed6f0af62eb7ce5d","707755d5e80fc21950bd208fdcfd4b6fc2c06adead4cd7eab46203b7b94ee585","777d2a1b9154a279f44629c97d988f5960456f279ece7403cd97ce77f31ee36c","65450834bd120b5cee1caa8136ce4f1aead411a657dbdbedc6df9826539c0b47","753cd71c77b7113d8b360e84151e298f68614ae4f8d26bbce3606a8ffa018019","ad314e5ee757290a0c67c42c7f941271cf91dfa4c274887ab672afaa949a