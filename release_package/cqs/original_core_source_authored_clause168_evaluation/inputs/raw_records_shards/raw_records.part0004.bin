{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–PhysCellIdUTRA-FDD","paragraph_zero_based":45504},{"literal_text_all_w_t_and_m_t":"The IE PhysCellIdUTRA-FDD is used to indicate the physical layer identity of the cell, i.e. the primary scrambling code, as defined in TS 25.331 [45].","paragraph_zero_based":45505},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD information element","paragraph_zero_based":45506},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45507},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-START","paragraph_zero_based":45508},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45509},{"literal_text_all_w_t_and_m_t":"PhysCellIdUTRA-FDD-r16 ::=        INTEGER (0..511)","paragraph_zero_based":45510},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45511},{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSCELLIDUTRA-FDD-STOP","paragraph_zero_based":45512},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45514},{"literal_text_all_w_t_and_m_t":"–RRC-TransactionIdentifier","paragraph_zero_based":45515},{"literal_text_all_w_t_and_m_t":"The IE RRC-TransactionIdentifier is used, together with the message type, for the identification of an RRC procedure (transaction).","paragraph_zero_based":45516},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier information element","paragraph_zero_based":45517},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45518},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-START","paragraph_zero_based":45519},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45520},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier ::=       INTEGER (0..3)","paragraph_zero_based":45521},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45522},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-STOP","paragraph_zero_based":45523},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45525},{"literal_text_all_w_t_and_m_t":"–Sensor-NameList","paragraph_zero_based":45526},{"literal_text_all_w_t_and_m_t":"The IE Sensor-NameList is used to indicate the names of the sensors which the UE is configured to measure.","paragraph_zero_based":45527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0478b2aab19969cdbcdec0bea8fea556ecc17696101bb05efbde285841df07bc","1b6eb8104d8300ec96f03cbeee0151e0a08ac3e5d219e6c65d13f38747e7df84","ee29d2f76fff1df7f18cb3ee70795a653aafd2d6bcd417419872293040e7a171","8762d51237f3ae764a7ee69f5827d7820f6a78b408f58e7d219c0fc87230dbe1","de3437729145107fa10363410ed17af0a7d9f73c630933e36bc9f26ff7e8f9ba","c8cbaf230dc87a24d11f531c07aa209f141eda87c54f89eb8d1b08dd8f119fc4","dd86e803e1e91bab73babc745089e756fd3918171b941fb565ad22ca7bff2e99","bc704c39cdae92e700319222e0c569298bb8f34cab9f489f0d2bbb78119f3129","0edfb0c0fe292cf8677ccbc2101d9d2aecc111fb5c9b30b41e370337bcc0c135","8e7509042c9267cdf80e0c5e60bd3f2ac6d11bba545fe5e71c98a9568b5e4bae","f2e986cd5a1863f538b446c1481134aa77a791245f3ee430a3634ab305720cda","b5e04731ba25e9046125b22681a2392f4fafed243862305e26d2d6dec2b37d28","2315e1e991899a19668eb31cf03c7b6aec09f1494aca87042dd4ae00b49bc5be","b7bca3e6f316011f07d9393aa31efdef3a2f847874ff16eb642413623f5156a3","ca99ff6f9f71bc75338f9dbfad1218a0721ad2f4717b8a360025abebb22016b2","902ae00b5a2e44d6f402e4f3b966dad40e92b50b1b5b4828b652317333481c31","4e8c02841b54c276b60370ab1c