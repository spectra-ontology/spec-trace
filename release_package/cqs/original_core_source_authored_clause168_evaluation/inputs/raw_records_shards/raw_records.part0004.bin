{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                    SEQUENCE {}","paragraph_zero_based":49416},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":49417},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49419},{"literal_text_all_w_t_and_m_t":"UuMessageTransferSidelink-r17-IEs ::=       SEQUENCE {","paragraph_zero_based":49420},{"literal_text_all_w_t_and_m_t":"    sl-PagingDelivery-r17                       OCTET STRING (CONTAINING PagingRecord)                   OPTIONAL,   -- Need N","paragraph_zero_based":49421},{"literal_text_all_w_t_and_m_t":"    sl-SIB1-Delivery-r17                        OCTET STRING (CONTAINING SIB1)                           OPTIONAL,   -- Need N","paragraph_zero_based":49422},{"literal_text_all_w_t_and_m_t":"    sl-SystemInformationDelivery-r17            OCTET STRING (CONTAINING SystemInformation)              OPTIONAL,   -- Need N","paragraph_zero_based":49423},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                    OCTET STRING                                             OPTIONAL,","paragraph_zero_based":49424},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        UuMessageTransferSidelink-v1800-IEs                      OPTIONAL","paragraph_zero_based":49425},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49427},{"literal_text_all_w_t_and_m_t":"UuMessageTransferSidelink-v1800-IEs ::=     SEQUENCE {","paragraph_zero_based":49428},{"literal_text_all_w_t_and_m_t":"    sl-PagingDelivery-r18                       OCTET STRING (CONTAINING PagingRecord-v1700)             OPTIONAL,   -- Need N","paragraph_zero_based":49429},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                        SEQUENCE {}                                              OPTIONAL","paragraph_zero_based":49430},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":49431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49432},{"literal_text_all_w_t_and_m_t":"-- TAG-UUMESSAGETRANSFERSIDELINK-STOP","paragraph_zero_based":49433},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":49434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":49435},{"literal_text_all_w_t_and_m_t":"UuMessageTransferSidelink-IEs field descriptions","paragraph_zero_based":49436},{"literal_text_all_w_t_and_m_t":"sl-PagingDelivery","paragraph_zero_based":49437},{"literal_text_all_w_t_and_m_t":"This field is used to transfer PagingRecord and PagingRecord-v1700 relevant to the L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":49438},{"literal_text_all_w_t_and_m_t":"sl-SIB1-Delivery","paragraph_zero_based":49439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7032140d097ce623bbde24ab658453b45846dbe3887396a9c55e1ff5a5579c80","b0ac89057a1d14b0767a40a228790cee823ad88a15081df8e00e5cfefe9fd76f","e16819e6fffdf6fe62a0c389e8b10f56a1dcea5e8d307de6e1dba67f9f3e4229","6e42cbf9f9d88f980cb21f5a776e7e4f876a77732ecc9fcb6bd9b541bccb1dd8","830ff1117273019321c894a55279e4a62139f272799ff76e01a5a47aeaadcfa2","0de8a3f20c339bc381b77a94c115cd88a3b748261589aa95a8c5ec0ec39c75e2","79d57c7ee828df4e28513d939f1c4490edfefcf7d1c47f9e5a94ee58c7312986","4f8f1091ec1a70238edaa330e3312b803debd0f9d57ff8bd4a35d1f0d9453ce8","c967a17f0e55b614040c260ce299e5871a9eb0d417868a2edd7c0cd875b5be3d","b8c73efc8ac5115d3cf9756cc5f766726572759ab73984d69d8f