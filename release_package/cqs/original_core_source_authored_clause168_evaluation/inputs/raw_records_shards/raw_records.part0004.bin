{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain-r17            INTEGER (0..9),","paragraph_zero_based":17520},{"literal_text_all_w_t_and_m_t":"    startingRB-r17                             INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":17521},{"literal_text_all_w_t_and_m_t":"    nrofRBs-r17                                INTEGER (24..maxNrofPhysicalResourceBlocksPlus1),","paragraph_zero_based":17522},{"literal_text_all_w_t_and_m_t":"    ssb-Index-r17                              SSB-Index,","paragraph_zero_based":17523},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset-r17                   CHOICE {","paragraph_zero_based":17524},{"literal_text_all_w_t_and_m_t":"        slots10                                    INTEGER (0..9),","paragraph_zero_based":17525},{"literal_text_all_w_t_and_m_t":"        slots20                                    INTEGER (0..19),","paragraph_zero_based":17526},{"literal_text_all_w_t_and_m_t":"        slots40                                    INTEGER (0..39),","paragraph_zero_based":17527},{"literal_text_all_w_t_and_m_t":"        slots80                                    INTEGER (0..79)","paragraph_zero_based":17528},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":17529},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation-r17              BIT STRING (SIZE (4)),","paragraph_zero_based":17530},{"literal_text_all_w_t_and_m_t":"    indBitID-r17                               INTEGER (0..5),","paragraph_zero_based":17531},{"literal_text_all_w_t_and_m_t":"    nrofResources-r17                          ENUMERATED {n2, n4}","paragraph_zero_based":17532},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17533},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17534},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB17-STOP","paragraph_zero_based":17535},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17537},{"literal_text_all_w_t_and_m_t":"SIB17 field descriptions","paragraph_zero_based":17538},{"literal_text_all_w_t_and_m_t":"segmentContainer","paragraph_zero_based":17539},{"literal_text_all_w_t_and_m_t":"This field includes a segment of the encoded SIB17-IEs. The size of the included segment in this container should be small enough that the SIB message size is less than or equal to the maximum size of a NR SI, i.e. 2976 bits when SIB17 is broadcast.","paragraph_zero_based":17540},{"literal_text_all_w_t_and_m_t":"segmentNumber","paragraph_zero_based":17541},{"literal_text_all_w_t_and_m_t":"This field identifies the sequence number of a segment of SIB17-IEs. A segment number of zero corresponds to the first segment, a segment number of one corresponds to the second segment, and so on.","paragraph_zero_based":17542},{"literal_text_all_w_t_and_m_t":"segmentType","paragraph_zero_based":17543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a800a9b1259b9107b6e820ee1fd22de21009d7a507c0428d4ca578626ba11818","c2eaf1f7424f6c50df739976755a65bb90927e678f4ede709ddf5a36c0b7457f","bfacce3359d3fe8a35948f3f6bd708166db137bfeef1adc608c505095916a61c","74fb4ed7049942ed4bb463a6c46b6062b205fe90128d18c3b77b3843ec856a7a","8503ca4eb65d8b1cfeec4f2874d16faa87278749019356e1b3916d7f408bf295","e320a257fc1b9f9061fe6f5890a4560de4402f092bde8833567cc1e13f2c37a8","620db8fda1a810dcc37a00d72542457749332936af469334c133c891299a8e9a","01aed6123fd5e79e64aad967a004ab64a9f76ed206bb7f553964d6d324ff7cb0","28cc80718e4bedf3a271c3ff6a3862a6d90494dea3bd707d5481a99c7ed27613","2c6cab940bddfc35ba73b4f1334be52febb59cb3ed292609af58658a375d6ea2","8c672ba4ddea650190ab0df4c0f3e8c5ea2705d9afbefd124ddca15636642c98","1d810a7d7f26ca7fc97220591be45eed6ce01438435877333b7c9bebb9384437","4611162b68ba8fccaaef4914d4ff7cac6c6c2be32ef737876e3b5379914919f6","9cd99062f0d9099da31cf16209a841d2cf0eb189a64ae66d7e40a8a17e9a5b54","9521cd43253928b2cf99407e24a0e6ec337aa3ec9fb97b4710347cc423cbdc30","12eff4c39de0c67f3dcfd0ae5c7d0c8251c076bbcbe80d4371b0f7fd71b45ab8","3729ed9382202ef50ded1954a7f482c192e8bf663f32e6ec2f85a5bbd815bbb2","89742732755a06dd7d5c3c57ea9c0d26955ad40f8345a74932f9c709a85ef7ed","b7c534af9c595a9d57b1668233775d6f8b8d1622b0c35df182f0d239a719b739","d882ce3e70597b5f695d41b80ee291db58e50b744e1c66d8073e9adc3be4e5c7","91b440852484fa48a120aa0d5ac3c6b748396e1b43152b2c192b9a75a55e0e38","059e7134573110d2a7eb7b69db16922985563c870b45d6b216c4bf7b4188a1c3","935c813006608e5302ece787c2634e0680cccecf69c11d505a61ff504608075f","4620873567fe050a747cfed58a6beec698a932928c47e04ec79d80706571a016"],"paragraph_range_zero_based":[17520,17543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p17520"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates whether the included segment is the last segment or not.","paragraph_zero_based":17544},{"literal_text_all_w_t_and_m_t":"trs-ResourceSetConfig","paragraph_zero_based":17545},{"literal_text_all_w_t_and_m_t":"RS configuration of TRS occasion(s) for idle/inactive UE(s), in terms of a list of N>=1 NZP TRS resource set(s). The maximum number of TRS resource sets configured by higher layer is 64. If a TRS resource is configured, the L1 based availability indication is always enabled based on that configuration. A UE which acquired SIB17 with a TRS configuration but did not yet receive an associated L1-based availability indication considers the configured TRS as unavailable. If SIB scheduling indicates that SIB17 has changed, the UE considers its configured TRS(s) as unavailable until it receives the associated L1-based availability indication(s).","paragraph_zero_based":17546},{"literal_text_all_w_t_and_m_t":"validityDuration","paragraph_zero_based":17547},{"literal_text_all_w_t_and_m_t":"The valid time duration for L1 availability indication, time unit is one default paging cycle. When the field is absent, UE assumes a default time duration to be 2 default paging cycles. The field is only valid while the UE has a valid SIB17.","paragraph_zero_based":17548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17549},{"literal_text_all_w_t_and_m_t":"TRS-ResourceSet field descriptions","paragraph_zero_based":17550},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":17551},{"literal_text_all_w_t_and_m_t":"The index of the first OFDM symbol in the PRB used for TRS in a slot. The field indicates the first symbol in a slot for the first TRS resource within the slot, and the symbol for the second TRS resource in the same slot can be derived implicitly with symbol index as firstOFDMSymbolInTimeDomain+4.","paragraph_zero_based":17552},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":17553},{"literal_text_all_w_t_and_m_t":"Indicates the offset of the first RE to RE#0 in a RB in row1.","paragraph_zero_based":17554},{"literal_text_all_w_t_and_m_t":"indBitID","paragraph_zero_based":17555},{"literal_text_all_w_t_and_m_t":"The index of the associated bit in TRS availability indication field in DCI. Each TRS resource set is configured with an ID i for the association with (i+1)-th indication bit in TRS availability indication field in DCI.","paragraph_zero_based":17556},{"literal_text_all_w_t_and_m_t":"nrofRBs","paragraph_zero_based":17557},{"literal_text_all_w_t_and_m_t":"Number of PRBs across which corresponding TRS resource spans.","paragraph_zero_based":17558},{"literal_text_all_w_t_and_m_t":"nrofResources","paragraph_zero_based":17559},{"literal_text_all_w_t_and_m_t":"The number of TRS resources for a TRS resource set.","paragraph_zero_based":17560},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":17561},{"literal_text_all_w_t_and_m_t":"The periodicity and slot offset (slot) for periodic TRS. It is used to determine the location of the first slot of TRS resource set. The periodicity value slots10 corresponds to 10 slots, value slots20 corresponds to 20 slots, and so on.","paragraph_zero_based":17562},{"literal_text_all_w_t_and_m_t":"powerControlOffsetSS","paragraph_zero_based":17563},{"literal_text_all_w_t_and_m_t":"Power offset (dB) of NZP CSI-RS RE to SSS RE.","paragraph_zero_based":17564},{"literal_text_all_w_t_and_m_t":"scramblingID-Info","paragraph_zero_based":17565},{"literal_text_all_w_t_and_m_t":"One or more scrambling IDs are configured for a TRS resource set. If a common scrambling ID is configured, it applies to all the TRS resources within the TRS resource set. Otherwise, each TRS resource within the TRS resource set is provided with a scrambling ID. If the number of TRS resources for the TRS resource set is 2, scramblingIDperResourceListWith2-r17 is configured, while scramblingIDperResourceListWith4-r17 is configured for the case that the number of TRS resources for the TRS resource set is 4.","paragraph_zero_based":17566},{"literal_text_all_w_t_and_m_t":"ssb-Index","paragraph_zero_based":17567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c9fd558e024a502855f2a62534e7dd56a81483ba834d0b2a347e80925a20af32","e2ac43532c1971e863c6937cf2f0bd4578724541aa4faecd2d32af5bbc752380","fe38d15eb4c2b5667316a903eca694be7bbe616f8f7adda6d2497dc2f54ff590","d7d5a87a0f5014244a10612326761c10a042b78f46ee3c96e4d6ccb74c7a0289","d296edb4df152e2c62010dee9afaedb1a4346e606e771d47e7b17f394d0cf91a","bd1fdfdd87d7434ede55c89ac2a5d8389a7c2588d199110465bad60c9d873597","d708e1fe90932eeaa29742cd3f5eecfea742b5187ee08753ef4ff863166ad2df","b8f83063bf1f44fc65c5924c877b351cc37d92ef5cefcaf2ebc00f81a2770595","4abc999c6b38ddacde89b9057353c948904e383a4a9ded588684c9f83d761a46","0a0b25ff3f24657238b5cddff9565cd15f241a249aade945a0d965bc52c6a40f","18a0bc109d0b1529f4ab38def137cf3be626ae2a26c43f6d50c1e1fadfaf11ae","70de680c9b6da46ed6ee0aefdc43b399ace0b89c575b3f14ecf94c75a9296c89","0b1bd0589d4edca8163fb37b6bf7977bfff7fdcec74b1bbe817132385ac92dca","b82993a2b89d8ac57cd5ce99d5011198724a3b850d4139526939f6516ef92a15","45ee6b56d204cba8f8e6e758b74d1b269cd55f8b203dbb22a9a444449f748c7e","e06e3bedbb126538bee88aec4217ebffd8eb5f82fa829c73fd2688632326818b","d19f88726e084ec1556a43587d33d9c7f8c1a771b93766d850392f76c5ae0d7d","187a80fa2641fa6ad8553979f5f244b3349799a80ffdea3caaaa2d0f32c88b8d","ec4029df4a6acfd1e2adaf2287fb78a1923c8d1b9