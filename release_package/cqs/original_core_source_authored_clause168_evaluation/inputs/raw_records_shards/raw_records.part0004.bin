{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE variable VarResumeMAC-Input specifies the input used to generate the resumeMAC-I during RRC Connection Resume procedure.","paragraph_zero_based":50136},{"literal_text_all_w_t_and_m_t":"VarResumeMAC-Input variable","paragraph_zero_based":50137},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":50138},{"literal_text_all_w_t_and_m_t":"-- TAG-VARRESUMEMAC-INPUT-START","paragraph_zero_based":50139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50140},{"literal_text_all_w_t_and_m_t":"VarResumeMAC-Input  ::=     SEQUENCE {","paragraph_zero_based":50141},{"literal_text_all_w_t_and_m_t":"    sourcePhysCellId                        PhysCellId,","paragraph_zero_based":50142},{"literal_text_all_w_t_and_m_t":"    targetCellIdentity                      CellIdentity,","paragraph_zero_based":50143},{"literal_text_all_w_t_and_m_t":"    source-c-RNTI                           RNTI-Value","paragraph_zero_based":50144},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":50145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50146},{"literal_text_all_w_t_and_m_t":"-- TAG-VARRESUMEMAC-INPUT-STOP","paragraph_zero_based":50147},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":50148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50149},{"literal_text_all_w_t_and_m_t":"VarResumeMAC-Input field descriptions","paragraph_zero_based":50150},{"literal_text_all_w_t_and_m_t":"targetCellIdentity","paragraph_zero_based":50151},{"literal_text_all_w_t_and_m_t":"An input variable used to calculate the resumeMAC-I. Set to the cellIdentity of the first PLMN-Identity included in the PLMN-IdentityInfoList broadcasted in SIB1 of the target cell i.e. the cell the UE is trying to resume.","paragraph_zero_based":50152},{"literal_text_all_w_t_a