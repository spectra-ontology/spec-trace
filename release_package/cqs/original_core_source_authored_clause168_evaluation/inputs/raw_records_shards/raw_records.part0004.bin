{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"shortDRX","paragraph_zero_based":22776},{"literal_text_all_w_t_and_m_t":"Configuration of a short DRX cycle. The network configures only one of shortDRX (without a suffix) or shortDRX-r18.","paragraph_zero_based":22777},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22778},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigSecondaryGroup","paragraph_zero_based":22779},{"literal_text_all_w_t_and_m_t":"The IE DRX-ConfigSecondaryGroup is used to configure DRX related parameters for the second DRX group as specified in TS 38.321 [3].","paragraph_zero_based":22780},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup information element","paragraph_zero_based":22781},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22782},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGSECONDARYGROUP-START","paragraph_zero_based":22783},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22784},{"literal_text_all_w_t_and_m_t":"DRX-ConfigSecondaryGroup-r16 ::=   SEQUENCE {","paragraph_zero_based":22785},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimer-r16            CHOICE {","paragraph_zero_based":22786},{"literal_text_all_w_t_and_m_t":"                                           subMilliSeconds INTEGER (1..31),","paragraph_zero_based":22787},{"literal_text_all_w_t_and_m_t":"                                           milliSeconds    ENUMERATED {","paragraph_zero_based":22788},{"literal_text_all_w_t_and_m_t":"                                               ms1, ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30, ms40, ms50, ms60,","paragraph_zero_based":22789},{"literal_text_all_w_t_and_m_t":"                                               ms80, ms100, ms200, ms300, ms400, ms500, ms600, ms800, ms1000, ms1200,","paragraph_zero_based":22790},{"lite