{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether the application layer measurement is signalling based or management based.","paragraph_zero_based":44616},{"literal_text_all_w_t_and_m_t":"qoe-Reference","paragraph_zero_based":44617},{"literal_text_all_w_t_and_m_t":"Indicates the QoE Reference as defined in TS 28.405 [55], clause 5.2.","paragraph_zero_based":44618},{"literal_text_all_w_t_and_m_t":"mce-id","paragraph_zero_based":44619},{"literal_text_all_w_t_and_m_t":"The field contains the Measurement Collection Entity Id.","paragraph_zero_based":44620},{"literal_text_all_w_t_and_m_t":"playoutDelayForMediaStartup","paragraph_zero_based":44621},{"literal_text_all_w_t_and_m_t":"The field defines whether the playout delay for DASH streaming and VR service types can be collected as a RAN visible QoE metric from the UE.","paragraph_zero_based":44622},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44623},{"literal_text_all_w_t_and_m_t":"–AppLayerMeasConfig","paragraph_zero_based":44624},{"literal_text_all_w_t_and_m_t":"The IE AppLayerMeasConfig indicates configuration of application layer measurements.","paragraph_zero_based":44625},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig information element","paragraph_zero_based":44626},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44627},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-START","paragraph_zero_based":44628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44629},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":44630},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToAddModList-r17   SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayer-r17     OPTIONAL, -- Need N","paragraph_zero_based":44631},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToReleaseList-r17  SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayerId-r17   OPTIONAL, -- Need N","paragraph_zero_based":44632},{"literal_text_all_w_t_and_m_t":"    rrc-SegAllowedSRB4-r17               ENUMERATED {enabled}                                                       OPTIONAL, -- Need R","paragraph_zero_based":44633},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44634},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44635},{"literal_text_all_w_t_and_m_t":"    rrc-SegAllowedSRB5-r18               ENUMERATED {enabled}                                                       OPTIONAL, -- Need R","paragraph_zero_based":44636},{"literal_text_all_w_t_and_m_t":"    idleInactiveReportAllowed-r18        ENUMERATED {enabled}                                                       OPTIONAL  -- Need R","paragraph_zero_based":44637},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44638},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1552ef910c15c158072b0fb9ca2affb8936a627fedce1e730577158dc3a84edc","58e8c5cd05d05cb638dbfa72af78465b4e85261eb19dc09aaac6eb816ff53c6e","5030007de4ca2bcb51685222408e1319007cf1050a2b66b86f6b171a7d538112","8f022e5241b02c4f757d4147a660a40325a0945a9fd87fa5d1e2a7022873de56","b569b2884ea73f8817e8c4feecaee61f7389fd78d1de25b9371e7eff7e3e84b2","4efe0a69b7432a8dabed4281b61b97652a76512e6182159f5e35663360cfb6b3","4aada2cb8a0b477f4ce798073045d5877073236e40728a40ba74bb356ebe6582","9b4ba17fb22835bc62948c3df726ee791945c262bc1e0d082df5883db16c898c","3fb220c01edf43a68a74fb95f284d6cf63b9690389ec