{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Identifies the PLMN of the cell for the reported cellIdentity: the first PLMN entry of plmn-IdentityList (in SIB1) in the instance of PLMN-IdentityInfoList that contained the reported cellIdentity.","paragraph_zero_based":19992},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":19993},{"literal_text_all_w_t_and_m_t":"Indicates Tracking Area Code to which the cell indicated by cellIdentity field belongs.","paragraph_zero_based":19994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19995},{"literal_text_all_w_t_and_m_t":"–CLI-RSSI-Range","paragraph_zero_based":19996},{"literal_text_all_w_t_and_m_t":"The IE CLI-RSSI-Range specifies the value range used in CLI-RSSI measurements and thresholds. The integer value for CLI-RSSI measurements is according to Table 10.1.22.2.2-1 in TS 38.133 [14].","paragraph_zero_based":19997},{"literal_text_all_w_t_and_m_t":"CLI-RSSI-Range information element","paragraph_zero_based":19998},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19999},{"literal_text_all_w_t_and_m_t":"-- TAG-CLI-RSSI-RANGE-START","paragraph_zero_based":20000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20001},{"literal_text_all_w_t_and_m_t":"CLI-RSSI-Range-r16 ::=                      INTEGER(0..76)","paragraph_zero_based":20002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20003},{"literal_text_all_w_t_and_m_t":"-- TAG-CLI-RSSI-RANGE-STOP","paragraph_zero_based":20004},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20006},{"literal_text_all_w_t_and_m_t":"–ClockQualityMetrics","paragraph_zero_based":20007},{"literal_text_all_w_t_and_m_t":"The IE ClockQualityMetrics is used to configure RAN timing synchronisation status information as specified in TS 38.473 [36]","paragraph_zero_based":20008},{"literal_text_all_w_t_and_m_t":"ClockQualityMetrics information element","paragraph_zero_based":20009},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20010},{"literal_text_all_w_t_and_m_t":"-- TAG-CLOCKQUALITYMETRICS-START","paragraph_zero_based":20011},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20012},{"literal_text_all_w_t_and_m_t":"ClockQualityMetrics-r18 ::= SEQUENCE {","paragraph_zero_based":20013},{"literal_text_all_w_t_and_m_t":"    synchronisationState-r18        ENUMERATED {locked, holdover, freerun, spare1}                        OPTIONAL,   -- Need N","paragraph_zero_based":20014},{"literal_text_all_w_t_and_m_t":"    tracebilityToUTC-r18            BOOLEAN                                                               OPTIONAL,   -- Need N","paragraph_zero_based":20015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6ed4b575840881e8ac2cc485e926948bc8a79b4f7e61104ad426c431c4ab2743","36f45317f9a408e7698e25fa9b5ecbb87823080af3a2a1a2b7301acaeb824577","b8640a06812fc97554498aa66b8ef5958d904d83a92f4b9bb7c0da9d819f2f59","d4ac256fba1aceaa53dc1d2c671405421a865f57084b9d1f25653fe1d40f910b","a3de13638fec0e746945b0ae4d9c170133a65503fa3d7c48f1bd3c66d28ee260","c51619b01ae42d266e6b0e1e11c99bb50a2ed51d3697deaff0fcfa9ae7228f8a","65ae431c52111927309ddbdb01d9f79f39586f8467c4c76c1fe56a6fc8554248","c1b9b6caf0634452921ad98d0e5050d5609dd4761ac7a31b07b8f6bd9ed59e5a","1c93bc5d55e2dc7e54f70723a898fb69de39025d247cf34873e0fdc54fbae1fc","90f90b9e05c7203e8f8cdc86c80f03b7ef3ef1d78a708984a2812688a78da20f","de64e7878eb718ba01ff248e6d978a0d3c561af51a3e885