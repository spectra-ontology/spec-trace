{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    cpich-EcN0                                BOOLEAN","paragraph_zero_based":31128},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31130},{"literal_text_all_w_t_and_m_t":"CellIndividualOffsetList-EUTRA-r18 ::=   SEQUENCE {","paragraph_zero_based":31131},{"literal_text_all_w_t_and_m_t":"    physCellId-r18                            EUTRA-PhysCellId,","paragraph_zero_based":31132},{"literal_text_all_w_t_and_m_t":"    cellIndividualOffset-r18                  EUTRA-Q-OffsetRange","paragraph_zero_based":31133},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31135},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGINTERRAT-STOP","paragraph_zero_based":31136},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31138},{"literal_text_all_w_t_and_m_t":"Editor's Note: FFS how to include two thresholds for SL-RSRP and SD-RSRP in event X1, X2, Y2.","paragraph_zero_based":31139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31140},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT field descriptions","paragraph_zero_based":31141},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":31142},{"literal_text_all_w_t_and_m_t":"Type of the configured measurement report. In (NG)EN-DC, and NR-DC, network does not configure report of type ReportCGI-EUTRA for SCG.","paragraph_zero_based":31143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31144},{"literal_text_all_w_t_and_m_t":"ReportCGI-EUTRA field descriptions","paragraph_zero_based":31145},{"literal_text_all_w_t_and_m_t":"useAutonomousGaps","paragraph_zero_based":31146},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the E-UTRAN neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":31147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31148},{"literal_text_all_w_t_and_m_t":"EventTriggerConfigInterRAT field descriptions","paragraph_zero_based":31149},{"literal_text_all_w_t_and_m_t":"b2-Threshold1","paragraph_zero_based":31150},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in inter RAT measurement report triggering condition for event B2.","paragraph_zero_based":31151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4246e5dfeb05f3b205dec0e7ff9479778fa5c6884f41a9f52ff0ccf8eda5ce84","b183ce22f7bfcb5f224e934280566a287c3ccf0e967b53ce91b7609d92233805","255526d1ceb183795d372a7e23fcbe613d5132cfc82e6b7bef7081fc5e7a1d29","df3355f5ea602eb85f0f88766dfb095da525aa3007952badbc13804cde18c06d","8bcfe0b42cc54cf986f79afaf4c06bf31deffcd828811c00623d1d148271fe96","9df0152d44d3af5bd468e7e7d25c35265de7732042a448cd75564ae19d0059eb","37fbdf594446ff80eb1644120b6860b31a4a681960c7dfaa20e861299923cf6c","2ba780cbd6e22f4ee3e6757349b0f6b96e3eeece0aa335eeafc5c1c12c228dc5","847d3c78605c488b252eefbb4e0fe9d0dc74b535f7ea6d4039e63cac3b0250eb","afd6509c2499fe525668712836fc2360e7dbfa4c02fa3f9cf8f44e0088d97042","46165a279ff31ff574ab5f8b127707ac02963d2e5525a3fc029b885c198ec870","507a2f56c7a1f1abf0b67d4c7f1e8b823b88385457dbfa03d66aee30ceb3c300","91e5bb72c7156cccc86960fbbab1b5b881c66d315b467da266d24ab41fdd6df0","7b0b590f74e86634b846bf0e6e6257f7765f739aecf3a0fb733c051a65cfa46f","6b7ba597d2208113fab75ab22e81ff29509cca0de6ac9db95a535ca68b84a5de","05933ac60c0dd742f5e0c7b71f970f352deb339929ebb1438fac23d0b53a5a48","e9d34e8523eaa9119532e2b0f9b43305de87352a464ecb96bf801b4dc2163a9e","214ab92dc0167fc49b81687f4e7d3fdcf0c5d018d11d9c7a634b8154472ad78a","dd11b4d42ee06727b46ed31f64c654f84a8d98637d1289aac1d831d0c45913e3","12631780d7bc28934f66bcf7bc9c533550a705978abe1daab54ad8bc95d29959","3d9541c8e08d30898d7b1056b7f8f688725b606e2d3b035f0aad60ec87caca6d","17de93cfb4eed2296dad996b26e0b537eddf85a6d978681aa87ffb8b1dfaeb86","1a00c28e942694a135a42a50aa48598476d85e1e77312a96c0eeefcf1241123a","107ff13948370ebd3e29ad57b4046a3130deb0417017592cf3f6e127a4c5aece"],"paragraph_range_zero_based":[31128,31151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31128"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"bN-ThresholdEUTRA","paragraph_zero_based":31152},{"literal_text_all_w_t_and_m_t":"E-UTRA threshold value associated with the selected trigger quantity (RSRP, RSRQ, SINR) to be used in inter RAT measurement report triggering condition for event number bN. In the same eventB2, the network configures the same CHOICE name (rsrp, rsrq or sinr) for the MeasTriggerQuantity of the b2-Threshold1 and for the MeasTriggerQuantityEUTRA of the b2-Threshold2EUTRA.","paragraph_zero_based":31153},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":31154},{"literal_text_all_w_t_and_m_t":"Choice of inter RAT event triggered reporting criteria.","paragraph_zero_based":31155},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":31156},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":31157},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31158},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":31159},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":31160},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":31161},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":31162},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field eventB1-UTRA-FDD or eventB2-UTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":31163},{"literal_text_all_w_t_and_m_t":"reportQuantityRelay","paragraph_zero_based":31164},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE measurement quantity to be included in measuremet report.","paragraph_zero_based":31165},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":31166},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":31167},{"literal_text_all_w_t_and_m_t":"bN-ThresholdUTRA-FDD","paragraph_zero_based":31168},{"literal_text_all_w_t_and_m_t":"UTRA-FDD threshold value associated with the selected trigger quantity (RSCP, EcN0) to be used in inter RAT measurement report triggering condition for event number bN.","paragraph_zero_based":31169},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP corresponds to CPICH_RSCP in TS 25.133 [46] for FDD. utra-FDD-EcN0 corresponds to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":31170},{"literal_text_all_w_t_and_m_t":"For utra-FDD-RSCP: The actual value is field value – 115 dBm.","paragraph_zero_based":31171},{"literal_text_all_w_t_and_m_t":"For utra-FDD-EcN0: The actual value is (field value – 49)/2 dB.","paragraph_zero_based":31172},{"literal_text_all_w_t_and_m_t":"y1-Threshold1","paragraph_zero_based":31173},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in measurement report triggering condition for event Y1.","paragraph_zero_based":31174},{"literal_text_all_w_t_and_m_t":"y1-Threshold2-Relay","paragraph_zero_based":31175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d79c23ac313b1c7468869089a822097f099a6a051650da18d3844ba0e0b3ba3f","1a