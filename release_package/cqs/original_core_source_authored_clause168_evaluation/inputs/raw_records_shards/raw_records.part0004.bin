{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43393},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC field descriptions","paragraph_zero_based":43394},{"literal_text_all_w_t_and_m_t":"appliedFreqBandListFilter","paragraph_zero_based":43395},{"literal_text_all_w_t_and_m_t":"In this field the UE mirrors the FreqBandList that the NW provided in the capability enquiry, if any. The UE filtered the band combinations in the supportedBandCombinationList in accordance with this appliedFreqBandListFilter.","paragraph_zero_based":43396},{"literal_text_all_w_t_and_m_t":"dummy1, dummy2","paragraph_zero_based":43397},{"literal_text_all_w_t_and_m_t":"The fields are not used in the specification and the network ignores the received values.","paragraph_zero_based":43398},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList","paragraph_zero_based":43399},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for (NG)EN-DC, or both (NG)EN-DC and NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":43400},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListNEDC-Only, supportedBandCombinationListNEDC-Only-v1610, supportedBandCombinationListNEDC-Only-v1780","paragraph_zero_based":43401},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports only for NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":43402},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":43403},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic UL Tx switching for (NG)EN-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":43404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43405},{"literal_text_all_w_t_and_m_t":"–RLC-Parameters","paragraph_zero_based":43406},{"literal_text_all_w_t_and_m_t":"The IE RLC-Parameters is used to convey capabilities related to RLC.","paragraph_zero_based":43407},{"literal_text_all_w_t_and_m_t":"RLC-Parameters information element","paragraph_zero_based":43408},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43409},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-PARAMETERS-START","paragraph_zero_based":43410},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43411},{"literal_text_all_w_t_and_m_t":"RLC-Parameters ::= SEQUENCE {","paragraph_zero_based":43412},{"literal_text_all_w_t_and_m_t":"    am-WithShortSN                  ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":43413},{"literal_text_all_w_t_and_m_t":"    um-WithShortSN                  ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":43414},{"literal_text_all_w_t_and_m_t":"    um-WithLongSN                   ENUMERATED {supported}  OPTIONAL,","paragraph_zero_based":43415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d965b65208d8af28fc4697e3b352a0a0341e499213620cfdfbfb838eebedd430","ba1203ea443ead672eefea0c84473872813ca9e815eaa7981a274aa92a5a69ad","071037bd7edff1afa4280a77039a9cb1cf23a135aef70b228f5dfbb0d48f0ae1","d6e88665afd1d3706637d92