{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dummy1, dummy2","paragraph_zero_based":32640},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification. If received it shall be ignored by the UE.","paragraph_zero_based":32641},{"literal_text_all_w_t_and_m_t":"dci-Format0-0-AndFormat1-0","paragraph_zero_based":32642},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI formats 0_0 and 1_0 according to TS 38.213 [13], clause 10.1.","paragraph_zero_based":32643},{"literal_text_all_w_t_and_m_t":"dci-Format2-0","paragraph_zero_based":32644},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_0 according to TS 38.213 [13], clause 10.1, 11.1.1.","paragraph_zero_based":32645},{"literal_text_all_w_t_and_m_t":"dci-Format2-1","paragraph_zero_based":32646},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_1 according to TS 38.213 [13], clause 10.1, 11.2.","paragraph_zero_based":32647},{"literal_text_all_w_t_and_m_t":"dci-Format2-2","paragraph_zero_based":32648},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_2 according to TS 38.213 [13], clause 10.1, 11.3.","paragraph_zero_based":32649},{"literal_text_all_w_t_and_m_t":"dci-Format2-3","paragraph_zero_based":32650},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_3 according to TS 38.213 [13], clause 10.1, 11.4","paragraph_zero_based":32651},{"literal_text_all_w_t_and_m_t":"dci-Format2-4","paragraph_zero_based":32652},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_4 according to TS 38.213 [13], clause 11.2A.","paragraph_zero_based":32653},{"literal_text_all_w_t_and_m_t":"dci-Format2-5","paragraph_zero_based":32654},{"literal_text_all_w_t_and_m_t":"If configured, IAB-MT monitors the DCI format 2_5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":32655},{"literal_text_all_w_t_and_m_t":"dci-Format2-6","paragraph_zero_based":32656},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_6 according to TS 38.213 [13], clause 10.1, 10.3. DCI format 2_6 can only be configured on the SpCell.","paragraph_zero_based":32657},{"literal_text_all_w_t_and_m_t":"dci-Format2-7","paragraph_zero_based":32658},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_7 according to TS 38.213 [13], clause 10.1, 10.4A.","paragraph_zero_based":32659},{"literal_text_all_w_t_and_m_t":"dci-Format2-9","paragraph_zero_based":32660},{"literal_text_all_w_t_and_m_t":"If configured, UE monitors the DCI format 2_9 according to TS 38.213 [13], clause 10.1, 11.5.","paragraph_zero_based":32661},{"literal_text_all_w_t_and_m_t":"dci-Format4-0","paragraph_zero_based":32662},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_0 with CRC scrambled by MCCH-RNTI/G-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":32663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f8f66d60768ec6f53d9c9a108f6e3d7eea830d658d58f05c36418bdd240f0cea","437f6e527d8d5056618d7fdea745d6f4e2bdd1177473f80a355198f4f2d28b8d","f6ad85e4eb118425ae9e4cbef70a09602715278fa98171c8409ebbc30fc97291","fab89c84476f3d7ccc1ca45cd790f45fa39e909c3ea30d5f2ab372674cdc682b","3215a91737f1342b34ead56d232b6ab72a9c67f42b5e4be15c0dbec1cfaead00","ee5e00178ad08037bb5f046a61e504efedd6c5d213cf4650937dd1c7fa7f0a92","7eddf23ccf92e743f2fd4f29db2de71960fe07ad2fc531167513e08592a0f468","5495063d2bf8b0c54e3f20b4d688de208023a49781d39870e52bfc2290090191","85f0630c1368cd62bf71b6daa7fc3f89682af9755bfbeed58f39ab4b2cd1c0c2","4f9160c27e50ec3a03e6c533bfcb4b5fd748c67007981a1c5a8ef2b1031849fe","f7b4065a6dd5eea46e74aaca8e06542bffb9a9850f0d19711e8d7f34a81bc43a","6d13ee7540f327b2412f37522b83295a43c987c84526930bbd05e3cf09d88488","a6408b59a58386992d2a9bfd217e8801e1f370763bed96738d60041b505d4c3d","5ad487d798c7fe85cae6d005b2babe390462aa5ff1ac60d33b1f8b5d11417fe3","9aab5ce557dc33a0a78be85413c38a460baba10229ce7c74f9ba09ec16615494","4d9ea32b44b32b2a8f673672fe4ff17c0981956cb4cf961a889fd577d83c4ea2","c9de20fc18a6befff4cae21e0303022ae2d71e8bb92c3ba5c92cc040eb2197d6","d98b24824e2877dff0297357bdf5e00a21aa4e284af317be051fb670c634238c","b5d5bc982daa51b628cac0ee0b932625c63c615c6959429a947b184c64bc673a","2328b185b07d8c6c810efd4b2a8a0a71243247a068619ddb4643ff3d22b956a0","f7bbb1c59da9c003fd61e676861c3d065e9866617b8c4efa06a691d640721a24","494380739afb322e7879d069c79834479a120bc7ad2366a69f6059e6db39164a","cf0b2e78680b6bd09b2338521640814d748580a92217fed8bdf0ba476112aae7","91e2abfa5c61bf139a8408370ed6cb816caaee8be079e669722c1cfc2ca3c242"],"paragraph_range_zero_based":[32640,32663],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32640"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dci-Format4-1-AndFormat4-2","paragraph_zero_based":32664},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 and 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [11.1].","paragraph_zero_based":32665},{"literal_text_all_w_t_and_m_t":"dci-Format4-1","paragraph_zero_based":32666},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_1 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":32667},{"literal_text_all_w_t_and_m_t":"dci-Format4-2","paragraph_zero_based":32668},{"literal_text_all_w_t_and_m_t":"If configured, the UE monitors the DCI format 4_2 with CRC scrambled by G-RNTI/G-CS-RNTI according to TS 38.213 [13], clause [10.1].","paragraph_zero_based":32669},{"literal_text_all_w_t_and_m_t":"dci-Formats","paragraph_zero_based":32670},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1.","paragraph_zero_based":32671},{"literal_text_all_w_t_and_m_t":"dci-FormatsExt","paragraph_zero_based":32672},{"literal_text_all_w_t_and_m_t":"If this field is present, the field dci-Formats is ignored and dci-FormatsExt is used instead to indicate whether the UE monitors in this USS for DCI format 0_2 and 1_2 or formats 0_1 and 1_1 and 0_2 and 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1). This field is not configured for operation with shared spectrum channel access in this release.","paragraph_zero_based":32673},{"literal_text_all_w_t_and_m_t":"dci-FormatsMC","paragraph_zero_based":32674},{"literal_text_all_w_t_and_m_t":"Indicate whether the UE monitors in this USS for DCI format 0_3 or for format 1_3 or for formats 0_3 and 1_3. Separate search space sets for DCI format 0_3/1_3 and legacy DCI formats are independently configured. If this field is present, the field dci-Formats is ignored.","paragraph_zero_based":32675},{"literal_text_all_w_t_and_m_t":"NOTE:This parameter is used only for SearchSpace configured to the scheduling cell, while another SearchSpace configured to the reference scheduled cell (if any) configures only nrofCandidates (i.e., all other optional fields are absent) with same serachSpaceId with that for scheduling cell.","paragraph_zero_based":32676},{"literal_text_all_w_t_and_m_t":"dci-Formats-MT","paragraph_zero_based":32677},{"literal_text_all_w_t_and_m_t":"Indicates whether the IAB-MT monitors the DCI formats 2-5 according to TS 38.213 [13], clause 14.","paragraph_zero_based":32678},{"literal_text_all_w_t_and_m_t":"dci-FormatsNCR","paragraph_zero_based":32679},{"literal_text_all_w_t_and_m_t":"Indicates whether the NCR-MT monitors the DCI formats 2-8 according to TS 38.213 [13], clause 20.","paragraph_zero_based":32680},{"literal_text_all_w_t_and_m_t":"dci-FormatsSL","paragraph_zero_based":32681},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE monitors in this USS for DCI formats 0-0 and 1-0 or for formats 0-1 and 1-1 or for format 3-0 or for format 3-1 or for formats 3-0 and 3-1. If this field is present, the field dci-Formats is ignored and dci-FormatsSL is used.","paragraph_zero_based":32682},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":32683},{"literal_text_all_w_t_and_m_t":"Number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the UE applies the value 1 slot, except for DCI format 2_0. The UE ignores this field for DCI format 2_0. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":32684},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, duration-r17 is used, and the configured duration is restricted to be an integer multiple of L slots and smaller than periodicity, where L is the configured length of the bitmap monitoringSlotsWithinSlotGroup-r17. If duration-r17 is absent, the UE assumes the duration in slots is equal to L. The maximum valid duration is periodicity-L.","paragraph_zero_based":32685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32686},{"literal_text_all_w_t_and_m_t":"For IAB-MT, duration indicates number of consecutive slots that a SearchSpace lasts in every occasion, i.e., upon every period as given in the periodicityAndOffset. If the field is absent, the IAB-MT applies the value 1 slot, except for DCI format 2_0 and DCI format 2_5. The IAB-MT ignores this field for DCI format 2_0 and DCI format 2_5. The maximum valid duration is periodicity-1 (periodicity as given in the monitoringSlotPeriodicityAndOffset).","paragraph_zero_based":32687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["edacc78595672e9fafe2bd83ee56f3b5e37533c3844c6f0be0b1a52ca22b69b8","44d31d16fc1ed59a2b63d476443c728e44baa1f5ab0565ef7bc143dfea7a30ec","c6b73cf71158d5aa98cce8dfdf390bc4edcdb1c6b7ee98902092e9f2ee5e1dd6","3d3b057977bf0d20841ee0657d3159687b5aa5421a3c948f16f3abb65fff1199","12e8b739e79d8b98e9be28c38c2bc3b41d04f77f8cf521b858a48605a33bd328","88841898f3b4bb8989ff5f66c179cd782729109129c18a75b380e9df8ec64b43","de8252c4e75f27117b0b5d9471689ec28fd19c0b29260f11f7811ab60a29da5c","f1720ed951e6f382dd109131176b0f607ed8b850e7cc6b8326dda8feded96567","c2bbe7fb3fc86ec3e49e37bf6efec30cfd24a6ceeca3dbf93bd766d2409b216c","581fa0d9772927d40832e9529d4b6682ed4e9a8d48ae3be6425ad51c330f0017","c07384d3a311da2a05a45ac82af0c2e892537b38d793ff643f19d2bdb20e0af9","6ca79827b9b7b62a27f4ccaf04d85769fa5a3459b0d5d95c8723fa86725da06b","972680f6c2beb783a6914fc455da783223c92597baaf8ecca8b83e02c1257a7a","c8bd9428f9f34425ee470e93137c0f4759aad0cb6deca7f7590416fe0cd4435b","32e24a58681f8460f42ceb7821a2eeba065921cc56fda54031ae544a3bac2bca","ca3b64b665eccd3080be507212495ae5821299f73ac380c8a75f2e6e9a262d3c","b99e5b3c304cc81aa525431689b82f64f0248239731c27f78a146a893e72c147","e3585dfa6fdb0823f765575530fa788b7f8508b2a613ca2a6a66801445a1e700","e3775eb76cd3860a68f587ce9f163ef38cf088680ee4882d1bec90826010de3b","6936e4143bec36811ce86698d3ee3a4c7eedf7a61648c0c6a39d5190ae66c964","5f5f6965a16d313d3c9463ca4575655771a211b1b2dfec7cbd246fc49e425aef","e9f3a86d2cb87f5b6b63caf1c2b6ad8af9dd58373355396d309ad29edf08d4c2","539c1c751ae08906d6fb14a0d570b857d029c0c260f37247d9f6fc32dcfd3317","f7087eeab76fc9f72920aa3c2b538065c84a71e2f4f8261f1c6acb07a40dfa6a"],"paragraph_range_zero_based":[32664,32687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32664"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"freqMonitorLocations","paragraph_zero_based":32688},{"literal_text_all_w_t_and_m_t":"Defines an association of the search space to multiple monitoring locations in the frequency domain and indicates whether the pattern configured in the associated CORESET is replicated to a specific RB set, see TS 38.213, clause 10.1. Each bit in the bitmap corresponds to one RB set, and the leftmost (most significant) bit corresponds to RB set 0 in the BWP. A bit set to 1 indicates that a frequency domain resource allocation replicated from the pattern configured in the associated CORESET is mapped to the RB set.","paragraph_zero_based":32689},{"literal_text_all_w_t_and_m_t":"monitoringSlotPeriodicityAndOffset","paragraph_zero_based":32690},{"literal_text_all_w_t_and_m_t":"Slots for PDCCH Monitoring configured as periodicity and offset.","paragraph_zero_based":32691},{"literal_text_all_w_t_and_m_t":"For SCS 15, 30, 60, and 120 kHz and if the UE is configured to monitor:","paragraph_zero_based":32692},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable.","paragraph_zero_based":32693},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213 [13], clause 10).","paragraph_zero_based":32694},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl1', 'sl2', 'sl4', 'sl5', 'sl8' and 'sl10' are applicable.","paragraph_zero_based":32695},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and if the UE is configured to monitor:","paragraph_zero_based":32696},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40', 'sl64', and 'sl80' are applicable.","paragraph_zero_based":32697},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl4′, ′sl8′, and ′sl16′ are applicable.","paragraph_zero_based":32698},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl4', 'sl8', 'sl16', 'sl20', 'sl32', 'sl40' are applicable.","paragraph_zero_based":32699},{"literal_text_all_w_t_and_m_t":"For SCS 960 kHz and if the UE is configured to monitor:","paragraph_zero_based":32700},{"literal_text_all_w_t_and_m_t":"- DCI format 2_0, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80', 'sl128', and 'sl160' are applicable.","paragraph_zero_based":32701},{"literal_text_all_w_t_and_m_t":"- DCI format 2_1, only the values ′sl8′, ′sl16′, and 'sl32' are applicable.","paragraph_zero_based":32702},{"literal_text_all_w_t_and_m_t":"- DCI format 2_4, only the values 'sl8', 'sl16', 'sl32', 'sl40', 'sl64', 'sl80' are applicable.","paragraph_zero_based":32703},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32704},{"literal_text_all_w_t_and_m_t":"For SCS 480 kHz and SCS 960 kHz, and the configured periodicity and offset are restricted to be an integer multiple of L slots, where L is the configured length of the bitmap provided by monitoringSlotsWithinSlotGroup-r17, i.e. for a given periodicity, the offset has a range of {0, L, 2*L, …, L*FLOOR(1/L*(periodicity-1))}.","paragraph_zero_based":32705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32706},{"literal_text_all_w_t_and_m_t":"For IAB-MT, If the IAB-MT is configured to monitor DCI format 2_1, only the values 'sl1', 'sl2' or 'sl4' are applicable. If the IAB-MT is configured to monitor DCI format 2_0 or DCI format 2_5, only the values ′sl1′, ′sl2′, ′sl4′, ′sl5′, ′sl8′, ′sl10′, ′sl16′, and ′sl20′ are applicable (see TS 38.213, clause 10).","paragraph_zero_based":32707},{"literal_text_all_w_t_and_m_t":"If monitoringSlotPeriodicityAndOffset-v1710 is present, any previously configured monitoringSlotPeriodicityAndOffset is released, and if monitoringSlotPeriodicityAndOffset is present, any previously configured monitoringSlotPeriodicityAndOffset-v1710 is released.","paragraph_zero_based":32708},{"literal_text_all_w_t_and_m_t":"monitoringSlotsWithinSlotGroup","paragraph_zero_based":32709},{"literal_text_all_w_t_and_m_t":"Indicates which slot(s) within a slot group are configured for multi-slot PDCCH monitoring. The first (leftmost, most significant) bit represents the first slot in the slot group, the second bit represents the second slot in the slot group, and so on. A bit set to '1' indicates that the corresponding slot is configured for multi-slot PDCCH monitoring (see TS 38.213 [13], clause 10). The number of slots for multi-slot PDCCH monitoring is configured according to clause 10 in TS 38.213 [13].","paragraph_zero_based":32710},{"literal_text_all_w_t_and_m_t":"monitoringSymbolsWithinSlot","paragraph_zero_based":32711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0280b5afc59812fa108705b91fb30dc4a455555dc299a7b87a6b4b575c8adb26","9a7a42328ded1bfca532413a9a3f2d0ce67bbd2826780941f5dbcce999685d1f","90f2198f8180522c7b1e2fa1330a8b47fb80b176a69abb9f7fcb607cc8ecf4d4","a71127279e034822cb25a7628c5aebee560d7f7a98c667c3426e142a2bffc604","12d96736518391789d3bae5d69a9019e98f3ced62906cd3d35ccce3bb365cd09","5f35fcf3d59c30e343056a2ff6679bf9bb81d0b1cac9f1e21c3709f9aee20380","0db4873a251690978371f4cb267bf27d7a212b6416b86b30cfb2555908b301eb","2cdc0520db9ee1713f9d245ab7f5fd25fd880d65a41e600082ded0b357284f97","488173665460e3a021edbe1d12b961ff71e73b517260201352a905dcd6c1f1d9","a0cd2da4c0dcf76d3de4f4f4ccf2c973180f02f2e7571509d82ddfd794b8e561","337d2b223f876c7a746249f9f92e9b3488626cce735c671eeb046ca255212133","8273f2413668b69933a85fb1dc11fe6971957e94dfa7f8706e6ab18ece5cdb25","f1bef16f4b75a53c0910f943e05dea548143fa04c8b93f8aa608e91ed0592f5d","e314814598db70e41b57454dc78d8619cbdd783b2607250c70f2e88c2db7fdeb","05d8f2ae780fa3372bb2b46deb813416d9ed291af9e3789fb470a8224ccb0393","44f7bb775737e8dbbb771ecc8b6dc5531b5f6cacde5bd443271c00cd36848418","5abf555abfd7c0ace25e92c7c288dfbfc893b05a739ff3c46caa09bbb8129b78","e25b927834e979d7e72b3e3a31c4ef3a45b40c782c188a82d75ea9d202193fa6","6ee184eec16e927f2417d87ccaa9de3401bc02a028b3f0db820eecb2481a298c","889122e5a65e6d1bcf725959e31b7f7bcb36c9809cd0d3b0fd0ecb633e96c303","79ad9f819d6621850ec4ffcfad67c5cc455aa1b40f785bc19f7c98bc00a84e70","0e9c46ae2daff3efd1ff7c3c7a61cb0ef4e3efc600f2283f83dce4109b1600fe","304acf4e48f2811a996427d92038b9942550c5c4c8cdded6d593d9f9a9e6008f","0d1d9e7afae0ed185fbc57be93031d0878c3f46483ca5c9fe6e1aa8db6feaa49"],"paragraph_range_zero_based":[32688,32711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32688"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The first symbol(s) for PDCCH monitoring in the slots configured for (multi-slot) PDCCH monitoring (see monitoringSlotPeriodicityAndOffset and duration). The most significant (left) bit represents the first OFDM in a slot, and the second most significant (left) bit represents the second OFDM symbol in a slot and so on. The bit(s) set to one identify the first OFDM symbol(s) of the control resource set within a slot. If the cyclic prefix of the BWP is set to extended CP, the last two bits within the bit string shall be ignored by the UE or IAB-MT.","paragraph_zero_based":32712},{"literal_text_all_w_t_and_m_t":"For DCI format 2_0, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":32713},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":32714},{"literal_text_all_w_t_and_m_t":"For IAB-MT: For DCI format 2_0 or DCI format 2_5, the first one symbol applies if the duration of CORESET (in the IE ControlResourceSet) identified by controlResourceSetId indicates 3 symbols, the first two symbols apply if the duration of CORESET identified by controlResourceSetId indicates 2 symbols, and the first three symbols apply if the duration of CORESET identified by controlResourceSetId indicates 1 symbol.","paragraph_zero_based":32715},{"literal_text_all_w_t_and_m_t":"See TS 38.213 [13], clause 10.","paragraph_zero_based":32716},{"literal_text_all_w_t_and_m_t":"nrofCandidates-CI","paragraph_zero_based":32717},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-4 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":32718},{"literal_text_all_w_t_and_m_t":"nrofCandidates-PEI","paragraph_zero_based":32719},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-7 for the configured aggregation level.","paragraph_zero_based":32720},{"literal_text_all_w_t_and_m_t":"nrofCandidates-SFI","paragraph_zero_based":32721},{"literal_text_all_w_t_and_m_t":"The number of PDCCH candidates specifically for format 2-0 for the configured aggregation level. If an aggregation level is absent, the UE does not search for any candidates with that aggregation level. The network configures only one aggregationLevel and the corresponding number of candidates (see TS 38.213 [13], clause 11.1.1). For a search space configured with freqMonitorLocations-r16, only value ′n1′ is valid.","paragraph_zero_based":32722},{"literal_text_all_w_t_and_m_t":"nrofCandidates","paragraph_zero_based":32723},{"literal_text_all_w_t_and_m_t":"Number of PDCCH candidates per aggregation level. The number of candidates and aggregation levels configured here applies to all formats unless a particular value is specified or a format-specific value is provided (see inside searchSpaceType). If configured in the SearchSpace of a cross carrier scheduled cell, this field determines the number of candidates and aggregation levels to be used on the linked scheduling cell (see TS 38.213 [13], clause 10).","paragraph_zero_based":32724},{"literal_text_all_w_t_and_m_t":"searchSpaceGroupIdList-r16, searchSpaceGroupIdList-r17","paragraph_zero_based":32725},{"literal_text_all_w_t_and_m_t":"List of search space group IDs which the search space is associated with. The network configures at most 2 search space groups per BWP where the group ID is either 0 or 1 if searchSpaceGroupIdList-r16 is included. The network configures at most 3 search space groups per BWP where the group ID is either 0, 1 or 2 if searchSpaceGroupIdList-r17 is included. And if searchSpaceGroupIdList-r17 is included, searchSpaceGroupIdList-r16 is ignored.","paragraph_zero_based":32726},{"literal_text_all_w_t_and_m_t":"searchSpaceId","paragraph_zero_based":32727},{"literal_text_all_w_t_and_m_t":"Identity of the search space. SearchSpaceId = 0 identifies the searchSpaceZero configured via PBCH (MIB) or ServingCellConfigCommon and may hence not be used in the SearchSpace IE. The searchSpaceId is unique among the BWPs of a Serving Cell. In case of cross carrier scheduling, search spaces with the same searchSpaceId in scheduled cell and scheduling cell are linked to each other. The UE applies the search space for the scheduled cell only if the DL BWPs in which the linked search spaces are configured in scheduling cell and scheduled cell are both active.","paragraph_zero_based":32728},{"literal_text_all_w_t_and_m_t":"For an IAB-MT, the search space defines how/where to search for PDCCH candidates for an IAB-MT where each search space is associated with one ControlResearchSet and for a scheduled cell in the case of cross carrier scheduling, except for nrofCandidates, all the optional fields are absent.","paragraph_zero_based":32729},{"literal_text_all_w_t_and_m_t":"SearchSpaceLinkingId","paragraph_zero_based":32730},{"literal_text_all_w_t_and_m_t":"This parameter is used to link two search spaces of same type in the same BWP. If two search spaces have the same SearchSpaceLinkingId UE assumes these search spaces are linked to PDCCH repetition REF. When PDCCH repetition is monitored in two linked search space (SS) sets, the UE does not expect a third monitored SS set to be linked with any of the two linked SS sets. The two linked SS sets have the same SS set type (USS/CSS). The two linked SS sets have the same DCI formats to monitor. For intra-slot PDCCH repetition: The two SS sets should have the same periodicity and offset (monitoringSlotPeriodicityAndOffset), and the same duration. For linking monitoring occasions across the two SS sets that exist in the same slot: The two SS sets have the same number of monitoring occasions within a slot and n-th monitoring occasion of one SS set is linked to n-th monitoring occasion of the other SS set. The following SS sets cannot be linked with another SS set for PDCCH repetition: SS set 0, searchSpaceSIB1, searchSpaceOtherSystemInformation, pagingSearchSpace, ra-SearchSpace, searchSpaceMCCH, searchSpaceMTCH, peiSearchSpace, and sdt-SearchSpace. SS set configured by recoverySearchSpaceId cannot be linked to another SS set for PDCCH repetition. When a scheduled serving cell is configured to be cross-carrier scheduled by a scheduling serving cell, two PDCCH candidates (with the same AL and candidate index associated with the scheduled serving cell) are linked only if the corresponding two SS sets in the scheduling serving cell are linked and two SS sets in the scheduled serving cell with the same SS set IDs are also linked.","paragraph_zero_based":32731},{"literal_text_all_w_t_and_m_t":"This parameter is not applicable to search space configured with dci-FormatsSL for monitoring format 3-0 or format 3-1 or for monitoring formats 3-0 and format 3-1.","paragraph_zero_based":32732},{"literal_text_all_w_t_and_m_t":"searchSpaceType","paragraph_zero_based":32733},{"literal_text_all_w_t_and_m_t":"Indicates whether this is a common search space (present) or a UE specific search space as well as DCI formats to monitor for.","paragraph_zero_based":32734},{"literal_text_all_w_t_and_m_t":"ue-Specific","paragraph_zero_based":32735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8178ba40faf27e139fa7927578719363e72c61382af39f35b46d6ca7d98b745e","92f579d4dc078f457775bf4711bea7e342c35b33aafd945fdbeb83a464a8edda","dab0a028d762cd6480dd7117658d25509a0f747fc6c4816aed214faa1cb3cca3","8dea8a72003a766b99dbb8b71da5e7c905b0c42783c9e8977d76b0614bdb283d","84068777d73f5ab81b07ef4c84d9bdddd7cbd633fa5142e26b369ec2283a4479","9bc5587c9171df9f1e06548aed78a820f5e814b622097f86aa76c3d821be3acd","1dad98a99f78c09b4154412d7bbefafef3182e6f573c67808f0d94e850fc1ce0","44d0aa3b2f62822743b758e43ee9a1fbebf40193d60bfa79410767277d40adb6","40956020e49b9ef0d15dfd3bffe79addf0baa05c844279a2a27a8437ad17fa77","2bcf3144720c305899f0cc04e3cccd7ca42e3855d3b7ea6f6f67df08306d2cbb","01b236a4940fe3886aa056636253d54e7c6eaca429ab35114ebbce1566506ad6","a37d361901da490c822ad08dd943cedce66fc217c4ef607a8b799ee898b00b2b","745110a37d37b9d124f8c3c7183c6b16a1da47fcc9a4c2a69b58adcd9b828964","c348d77d224bf747a294d2d15121cd4792e47f4066c78f07bbb09b0b0cb7c185","f7a65b432cee03da53b9cbcef74b89fb5050e6f178b3f41d491a78811c237b3d","0f6e66f801a96de6e4edbaab92581ff8129957eabbfa43159ce984e6adaf5c59","f84ba48ad45d5479427b8d13f5c924f06613ab3d267fdc222951a0ffa5cb9e8d","a0cf0c151ce21accca96b364d2be4a219ad243d1705676407d89a97b734f0200","bb3ae695e7d03e0ddcfb8d17c176a39ee4c0193b5a70bac9212382210e5c9014","932521682c2da8fcca3d6cbdec1b575060612d1247b5c0cacf16fba530a0d97c","41add23147866de10b87eaa7acc04f24219349cad3332d8b6b593d0a519a950f","11f57dac20d32b38cff0a82e8ad722632a0b5defec08eee22f6ac2bc71071344","0f6ae310414edd636cb3ac4cf217eee734e1864e22cd49a01cce7d0395c07ada","4d5e8d7b877263a331c02b7eb088ae5d2e5a957f3151c66069f677b127a5514b"],"paragraph_range_zero_based":[32712,32735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p32712"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configures this search space as UE specific search space (USS). The UE monitors the DCI format with CRC scrambled by C-RNTI, CS-RNTI (if configured), and SP-CSI-RNTI (if configured)","paragraph_zero_based":32736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32737},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":32738},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":32739},{"literal_text_all_w_t_and_m_t":"DedicatedOnly","paragraph_zero_based":32740},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present, Need R. Otherwise it is absent, Need R.","paragraph_zero_based":32741},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":32742},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is optionally present, Need M, otherwise.","paragraph_zero_based":32743},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":32744},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt-r16 of the parent IE with the field searchSpaceType-r16 or searchSpaceType-r17 included. Otherwise it is optionally present, Need M.","paragraph_zero_based":32745},{"literal_text_all_w_t_and_m_t":"Setup3","paragraph_zero_based":32746},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when a new SearchSpace is set up, if the same SearchSpace ID is not included in searchSpacesToAddModListExt (without suffix) of the parent IE with the field searchSpaceType (without suffix) included.  Otherwise it is optionally present, Need M.","paragraph_zero_based":32747},{"literal_text_all_w_t_and_m_t":"Setup4","paragraph_zero_based":32748},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset-v1710 is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":32749},{"literal_text_all_w_t_and_m_t":"Setup5","paragraph_zero_based":32750},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace if monitoringSlotPeriodicityAndOffset (without suffix) is not included. It is optionally present, Need M, otherwise.","paragraph_zero_based":32751},{"literal_text_all_w_t_and_m_t":"SetupOnly","paragraph_zero_based":32752},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new SearchSpace. It is absent, Need M, otherwise.","paragraph_zero_based":32753},{"literal_text_all_w_t_and_m_t":"SetupOnly2","paragraph_zero_based":32754},{"literal_text_all_w_t_and_m_t":"In PDCCH-Config, the field is optionally present upon creation of a new SearchSpace and absent, Need M upon reconfiguration of an existing SearchSpace.","paragraph_zero_based":32755},{"literal_text_all_w_t_and_m_t":"In PDCCH-ConfigCommon, the field is absent.","paragraph_zero_based":32756},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32757},{"literal_text_all_w_t_and_m_t":"–SearchSpaceId","paragraph_zero_based":32758},{"literal_text_all_w_t_and_m_t":"The IE SearchSpaceId is used to identify Search Spaces. The ID space is used across the BWPs of a Serving Cell. The search space with the SearchSpaceId = 0 identifies the search space configured via PBCH (MIB) and in ServingCellConfigCommon (searchSpaceZero). The number of Search Spaces per BWP is limited to 10 including the common and UE specific Search Spaces.","paragraph_zero_based":32759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha