{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>remove the entry with the matching physCellId from the ssb-PositionQCL-CellsToAddModList;","paragraph_zero_based":5472},{"literal_text_all_w_t_and_m_t":"3>if the received measObject includes the ssb-PositionQCL-CellsToAddModList:","paragraph_zero_based":5473},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the ssb-PositionQCL-CellsToAddModList:","paragraph_zero_based":5474},{"literal_text_all_w_t_and_m_t":"5>if an entry with the matching physCellId exists in the ssb-PositionQCL-CellsToAddModList:","paragraph_zero_based":5475},{"literal_text_all_w_t_and_m_t":"6>replace the entry with the value received for this physCellId;","paragraph_zero_based":5476},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5477},{"literal_text_all_w_t_and_m_t":"6>add a new entry for the received physCellId to the ssb-PositionQCL-CellsToAddModList;","paragraph_zero_based":5478},{"literal_text_all_w_t_and_m_t":"3>if the received measObject includes the cca-CellsToRemoveList:","paragraph_zero_based":5479},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the cca-CellsToRemoveList:","paragraph_zero_based":5480},{"literal_text_all_w_t_and_m_t":"5>remove the entry with the matching physCellId from the cca-CellsToAddModList;","paragraph_zero_based":5481},{"literal_text_all_w_t_and_m_t":"3>if the received measObject includes the cca-CellsToAddModList:","paragraph_zero_based":5482},{"literal_text_all_w_t_and_m_t":"4>for each physCellId included in the cca-CellsToAddModList:","paragraph_zero_based":5483},{"literal_text_all_w_t_and_m_t":"5>if an entry with the matching physCellId exists in the cca-CellsToAddModList:","paragraph_zero_based":5484},{"literal_text_all_w_t_and_m_t":"6>replace the entry with the value received for this physCellId;","paragraph_zero_based":5485},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5486},{"literal_text_all_w_t_and_m_t":"6>add a new entry for the received physCellId to the cca-CellsToAddModList;","paragraph_zero_based":5487},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5488},{"literal_text_all_w_t_and_m_t":"3>add a new entry for the received measObject to the measObjectList within VarMeasConfig.","paragraph_zero_based":5489},{"literal_text_all_w_t_and_m_t":"5.5.2.6Reporting configuration removal","paragraph_zero_based":5490},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5491},{"literal_text_all_w_t_and_m_t":"1>for each reportConfigId included in the received reportConfigToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":5492},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":5493},{"literal_text_all_w_t_and_m_t":"2>remove all measId associated with the reportConfigId from the measIdList within the VarMeasConfig, if any;","paragraph_zero_based":5494},{"literal_text_all_w_t_and_m_t":"2>if a measId is removed from the measIdList:","paragraph_zero_based":5495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7b3a23c79624bef2d8a425b4d07e29ffc1fda2c7520841687c82250fef4dad0c","4b06d9f0bc3e411af81c71a4c4625ce17575b6849c1281197cb2b933ccd5b9b4","cda9c5e1ddc38ae8c4a2efd46eb074cfd4b4b3a103bb36ca906d3c56387538d0","1c375689d6595dbb77aa3e0d59ea177a338c7a91767d0a6be15d9afd62e6fd01","cec2abe266bc9768ea78920aa25dc98a400e15a0936801969b4afebd3b9a9efd","32f07a1398eb2c5635f