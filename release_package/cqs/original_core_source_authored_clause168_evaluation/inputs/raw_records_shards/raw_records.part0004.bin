EGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig),","paragraph_zero_based":21206},{"literal_text_all_w_t_and_m_t":"            resourceSet3TDCP-r18        INTEGER (1..maxNrofNZP-CSI-RS-ResourceSetsPerConfig)              OPTIONAL  -- Need R","paragraph_zero_based":21207},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL,  -- Cond TDCP","paragraph_zero_based":21208},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-State-r18     CHOICE {","paragraph_zero_based":21209},{"literal_text_all_w_t_and_m_t":"        perSet-r18                      ENUMERATED {first, second},","paragraph_zero_based":21210},{"literal_text_all_w_t_and_m_t":"        perResource-r18                 SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF ENUMERATED {first, second}","paragraph_zero_based":21211},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL,  -- Need R","paragraph_zero_based":21212},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-State2-r18    CHOICE {","paragraph_zero_based":21213},{"literal_text_all_w_t_and_m_t":"         perSet-r18                     ENUMERATED {first, second},","paragraph_zero_based":21214},{"literal_text_all_w_t_and_m_t":"         perResource-r18                SEQUENCE (SIZE(1..maxNrofAP-CSI-RS-ResourcesPerSet)) OF  ENUMERATED {first, second}","paragraph_zero_based":21215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["47d2c48b7c48a089971ecff19a7bfbd6daa0a7590abdf671be5d55a1137397c9","85dfd64ba44cb3eccad94313637a121b07ca34883980ef99c61a6ec86822eefc"