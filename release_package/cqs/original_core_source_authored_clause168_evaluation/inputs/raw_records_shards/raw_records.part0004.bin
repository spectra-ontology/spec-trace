{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SIB-Mapping-v1700  ::=              SEQUENCE (SIZE (1..maxSIB)) OF SIB-TypeInfo-v1700","paragraph_zero_based":33816},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33817},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo ::=                    SEQUENCE {","paragraph_zero_based":33818},{"literal_text_all_w_t_and_m_t":"    type                                ENUMERATED {sibType2, sibType3, sibType4, sibType5, sibType6, sibType7, sibType8, sibType9,","paragraph_zero_based":33819},{"literal_text_all_w_t_and_m_t":"                                                     sibType10-v1610, sibType11-v1610, sibType12-v1610, sibType13-v1610,","paragraph_zero_based":33820},{"literal_text_all_w_t_and_m_t":"                                                     sibType14-v1610, spare3, spare2, spare1,... },","paragraph_zero_based":33821},{"literal_text_all_w_t_and_m_t":"    valueTag                            INTEGER (0..31)                                                 OPTIONAL, -- Cond SIB-TYPE","paragraph_zero_based":33822},{"literal_text_all_w_t_and_m_t":"    areaScope                           ENUMERATED {true}                                               OPTIONAL -- Need S","paragraph_zero_based":33823},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33825},{"literal_text_all_w_t_and_m_t":"SIB-TypeInfo-v1700 ::=              SEQUENCE {","paragraph_zero_based":33826},{"literal_text_all_w_t_and_m_t":"    sibType-r17                         CHOICE {","paragraph_zero_based":33827},{"literal_text_all_w_t_and_m_t":"        type1-r17                           ENUMERATED {sibType15, sibType16, sibType17, sibType18, sibType19, sibType20, sibType21,","paragraph_zero_based":33828},{"literal_text_all_w_t_and_m_t":"                                                        sibType22-v1800, sibType23-v1800 ,sibType24-v1800, sibType25-v1800,","paragraph_zero_based":33829},{"literal_text_all_w_t_and_m_t":"                                                        spare5, spare4, spare3, spare2, spare1,...},","paragraph_zero_based":33830},{"literal_text_all_w_t_and_m_t":"        type2-r17                           SEQUENCE {","paragraph_zero_based":33831},{"literal_text_all_w_t_and_m_t":"            posSibType-r17                      ENUMERATED {posSibType1-9, posSibType1-10, posSibType2-24, posSibType2-25,","paragraph_zero_based":33832},{"literal_text_all_w_t_and_m_t":"                                                            posSibType6-4, posSibType6-5, posSibType6-6, posSibType2-17a-v1770,","paragraph_zero_based":33833},{"literal_text_all_w_t_and_m_t":"                                                            posSibType2-18a-v1770, posSibType2-20a-v1770, posSibType1-11-v1800,","paragraph_zero_based":33834},{"literal_text_all_w_t_and_m_t":"                                                            posSibType1-12-v1800, posSibType2-26-v1800, posSibType2-27-v1800,","paragraph_zero_based":33835},{"literal_text_all_w_t_and_m_t":"                                                             posSibType6-7-v1800, posSibType7-1-v1800,..., posSibType7-2-v1800,","paragraph_zero_based":33836},{"literal_text_all_w_t_and_m_t":"                                                            posSibType7-3-v1800, posSibType7-4-v1800},","paragraph_zero_based":33837},{"literal_text_all_w_t_and_m_t":"            encrypted-r17                       ENUMERATED { true }                                     OPTIONAL, -- Need R","paragraph_zero_based":33838},{"literal_text_all_w_t_and_m_t":"            gnss-id-r17                         GNSS-ID-r16                                             OPTIONAL, -- Need R","paragraph_zero_based":33839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["25b784585512563409652eec0a0250ff8cd6cc4bbdb1547c55906ff216f31eb7","0b2552b11fdb9b0803f2fd73b5f1e3b820cba5b8d17455e7519ed86c24049f5e","182d090cfd3625333fab2a3a1a84509d9503ed71aec29e8dee251c7e98afee23","f64941d4e89bb09efda3898e917edc0ddde6f3863b01808130a8cd2c03cf474d","2ee9cc0a1b0fb63d1c4a8ed3cb545f35e38b9127e70d4c4d95eaf8aa950b57b4","d0165736464326c4609fa51c4052d190ac786f81b61fe2b7609a683f5dc0260f","ca27382f1b760d393a27b28cc2a7e03847eebdefc54793778850d48436052a94","093a7e8a714ed7c873a0b8bb1a9b104e43adbe4c08ae7677dd2464912572fbb5","35e7a37c9aa473fefdda44116842df6499dc22125ab66698f364b33107c4919c","e4136401cd3a5848497645a75cfbd6531942ae6191250e8d6516c5eccd2d7fce","34061a6ac7943b363bd2fc7bed48341e7b2e61175e75ef40f0046d6de38373b9","5ef0ccb12ff1aef1d94d18fe67f0d390e92aa9f808d0368e04aca93e02ec0c43","31974112e72c9c479ccfbf78f0f2dbdff318410ea40abb4e1b086e5f66a9afaf","eafdefed15405a91f800f99fdc1380c6730e7bfa8687616f064de93bbec8231e","fdeac132639fee40c159d8e5eed5332d075a4c765db7147c30dfef9c9739d287","ad11baeb8651267f4afda4d855d9be7875013d0aa12591ff115ec8dc757825f7","fa2a3c8d3be9b8663fdb88cd1618001932111edc857f0c60493fc31fdb835d58","97dc2ea5c558982eb23c959c2cbfe76a1932716435bea9726d28689a074bdefd","24420cdb85624c71d7ece3d02245e0eed103d3006edaea17fa30ef735a23dc56","4abe21765f02b24e6ba7ee1db44a7c4db06114af7971c875276776d913940999","4ab6561a589959a9c8977495ea6444296c6f613fd3349285d9a5d9fad285e8f0","dd015e19e9bc9a3009e397f40d808e16d8dcfe19b920935f1afb853f141a5537","64907addc74a1b0d6471becaf422420f146c6827c9c71d4de25890c281ae7cb6","3bd63d376b3d950d1e7ba7ceda96eb3255fbb9af38da3cbdaa9b72e7b7455917"],"paragraph_range_zero_based":[33816,33839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33816"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            sbas-id-r17                         SBAS-ID-r16                                             OPTIONAL  -- Cond GNSS-ID-SBAS","paragraph_zero_based":33840},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":33841},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":33842},{"literal_text_all_w_t_and_m_t":"    valueTag-r17                            INTEGER (0..31)                                             OPTIONAL, -- Cond NonPosSIB","paragraph_zero_based":33843},{"literal_text_all_w_t_and_m_t":"    areaScope-r17                           ENUMERATED {true}                                           OPTIONAL  -- Need S","paragraph_zero_based":33844},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33846},{"literal_text_all_w_t_and_m_t":"-- TAG-SI-SCHEDULINGINFO-STOP","paragraph_zero_based":33847},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33849},{"literal_text_all_w_t_and_m_t":"SchedulingInfo field descriptions","paragraph_zero_based":33850},{"literal_text_all_w_t_and_m_t":"areaScope","paragraph_zero_based":33851},{"literal_text_all_w_t_and_m_t":"Indicates that a SIB is area specific. If the field is absent, the SIB is cell specific.","paragraph_zero_based":33852},{"literal_text_all_w_t_and_m_t":"si-BroadcastStatus","paragraph_zero_based":33853},{"literal_text_all_w_t_and_m_t":"Indicates if the SI message is being broadcasted or not. Change of si-BroadcastStatus should not result in system information change notifications in Short Message transmitted with P-RNTI over DCI (see clause 6.5). The value of the indication is valid until the end of the BCCH modification period when set to broadcasting. When SIB19 is scheduled in an NTN cell, the si-BroadcastStatus for the mapped SIB19 is set to broadcasting.","paragraph_zero_based":33854},{"literal_text_all_w_t_and_m_t":"If si-SchedulingInfo-v1700 is present, the network ensures that the total number of SI messages with si-BroadcastStatus set to notBroadcasting in the list of concatenated SI messages configured by schedulingInfoList in si-SchedulingInfo and SI messages containing type1 SIB configured by schedulingInfoList2 in si-SchedulingInfo-v1700 does not exceed the limit of maxSI-Message when si-RequestConfig, si-RequestConfigRedCap or si-RequestConfigSUL is configured.","paragraph_zero_based":33855},{"literal_text_all_w_t_and_m_t":"si-Periodicity","paragraph_zero_based":33856},{"literal_text_all_w_t_and_m_t":"Periodicity of the SI-message in radio frames. Value rf8 corresponds to 8 radio frames, value rf16 corresponds to 16 radio frames, and so on.","paragraph_zero_based":33857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33858},{"literal_text_all_w_t_and_m_t":"SI-SchedulingInfo field descriptions","paragraph_zero_based":33859},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":33860},{"literal_text_all_w_t_and_m_t":"This field is not used in this specification. If received, it is ignored by the UE.","paragraph_zero_based":33861},{"literal_text_all_w_t_and_m_t":"si-RequestConfig","paragraph_zero_based":33862},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":33863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["17693e605dd6d7c94a97c1dd739729b3992d47e4d8463af58eb8baa01c769767","1225deca527fe484e5754f99e595529502f7fdf73bdd41a396fdca27f84802c1","84e43f938263450debf31b0d65c10ffdf03f302e04c96eb929921787ab0fc4be","a38fb9e3c061d666f1fb6e734c10fe3de07098f56a6bc63e91f17648eaf6f276","2f291d0e8e67a27a08baf3f27a367413cc6b6b68b6d5047fbaa0a0d6f0a29ecd","72f7b2cc2288f1cccfb1ba60cad4f32a41e0f4e146dc108a889f6a4298bdb98f","bc2f3b2cb68b970976f1225bfbc4b8dc669d24b4c5222af6ce44c6ddd22dda67","054df6d0b332117180e5af729e6b0950cdee9a2829f1bf63f8ed9c22ecb21d4e","48e3c6020aa755dff52611fc0f7cdf0cb4df8333093fc9c25de650a04f38baaf","fa0629517fdbd837563dda99a1b72ad54a3ab9a48ca5d62528eebbe0a643db3f","13bd53735bec1d997f66ca0c8d41ecf1e81851f5fe691f29f1c5e9d26c7e674c","b985d6eb2416270c373667b7991bae229cc386520072347af39f5fe107c4bdd4","2207d780563c8cb52a988299b2192383b361bd81d1b29e04e39eacae83ebbf06","5bc77b56c4d9b13ced0abb2a452708536abbc436a3aade651383cad416f09eb7","d154adf5d204d4406b057d49733ba521a536b6735d2aa393cd1bf4a86b1d032b","c2cbfa3dab91a50196f19f54ad479f817146e31c40467de4a624b2b2cf0d9d93","ff8931f487b1294d12545b7a8a31d8725eb3d321504aab1d4e056d042b0b9519","66b5878f4b2981ac8bd54a5efb87ae07fa2922e0a294de16f5bcd530fd23de37","9de0a1a3d0f924f702c6516badedcdbd0d6e6eb949597dde84470d870731e6a4","9ae9d7e99408632f3f3c300c60d0d5f232a6e8f4b78bf3ef2940b63f12bebd5e","46c3262e02439ea7ac7d5943e8b796d653b6b4dc73967775c15b63997a1e83f1","1c681ece049f7b1d2ec20fbf79ba3a7b0bb673ecac28246180c001c4ce68e4f3","1d3546edf159dbd9c2f1490e380a65c5d287fb61a31d39e23b9dbbff72f23953","36928f8acd0bb0cb5ec207d3f75630242377e42e3d755b3aff78682911842b93"],"paragraph_range_zero_based":[33840,33863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33840"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"si-RequestConfigMSG1-Repetition","paragraph_zero_based":33864},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources on NUL that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":33865},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap","paragraph_zero_based":33866},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources for initialUplinkBWP-RedCap that the (e)RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":33867},{"literal_text_all_w_t_and_m_t":"si-RequestConfigRedCap-MSG1-Repetition","paragraph_zero_based":33868},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources for initialUplinkBWP-RedCap that the RedCap UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":33869},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL","paragraph_zero_based":33870},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 resources that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting.","paragraph_zero_based":33871},{"literal_text_all_w_t_and_m_t":"si-RequestConfigSUL-MSG1-Repetition","paragraph_zero_based":33872},{"literal_text_all_w_t_and_m_t":"Configuration of Msg1 repetition resources on SUL that the UE uses for requesting SI-messages for which si-BroadcastStatus is set to notBroadcasting. This field is only applicable when Msg1 repetition resources can be used for requesting SI-messages.","paragraph_zero_based":33873},{"literal_text_all_w_t_and_m_t":"si-WindowLength","paragraph_zero_based":33874},{"literal_text_all_w_t_and_m_t":"The length of the SI scheduling window. Value s5 corresponds to 5 slots, value s10 corresponds to 10 slots and so on. The network always configures si-WindowLength to be shorter than or equal to the si-Periodicity. The values s2560-v1710 and s5120-v1710 are only applicable for SCS 480 kHz.","paragraph_zero_based":33875},{"literal_text_all_w_t_and_m_t":"systemInformationAreaID","paragraph_zero_based":33876},{"literal_text_all_w_t_and_m_t":"Indicates the system information area that the cell belongs to, if any. Any SIB with areaScope within the SI is considered to belong to this systemInformationAreaID. The systemInformationAreaID is unique within a PLMN/SNPN.","paragraph_zero_based":33877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33878},{"literal_text_all_w_t_and_m_t":"SchedulingInfo2 field descriptions","paragraph_zero_based":33879},{"literal_text_all_w_t_and_m_t":"encrypted","paragraph_zero_based":33880},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the pos-sib-type is encrypted as specified in TS 37.355 [49].","paragraph_zero_based":33881},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":33882},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":33883},{"literal_text_all_w_t_and_m_t":"posSibType","paragraph_zero_based":33884},{"literal_text_all_w_t_and_m_t":"The posSIBs as defined in TS 37.355 [49] mapped to SI for scheduling using schedulingInfoList2. ","paragraph_zero_based":33885},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":33886},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]).","paragraph_zero_based":33887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["06b922e2128f24cf97d7b23b808cd61815a8eeb957c9ae7d760875f84769f945","ed63751ec595d6ad72144d4e3caab6f4ba8851043812ab2e54b3b265fd2098f6","53f98a482904a76ccde41c673ad4e91ae06386ebc6da753a299dc2202e894eda","faf3787df791b9adf1b2ccf9e087e1cc71c37cfecd4e6c1a0ad1dfe0ad528729","2690d17ca8249cfdc9d556948ec20e1deb46de7f1054c1b47548ebf2a698376e","914d63d5d61cfa0b28759bb373892ae292a6cc07bf41f262042d52a96b341f4c","965997fd520a81bc9149b53a620348f1c0ba76e9e6e161c7c2409006f6894452","7f6df676ab1d11ea6a42d5a7c3f8ceeb4e0d7e8227629258a89169cbb30f87bc","e2dbc25c5053d7404508fcf572c9e3f14ed08066e8964dc1a07a2bd8db828b8b","f8ceb3cd6bd241cec6c1042c2744395f8c770027e59f58fe341dd43deba6389e","519cc3a5df0d57370b77196c088b528409573b1c48dd6ed3cf8591eeba8205e5","4ddc3aec293e01d2ca1bee36e8b050d2b97171358ae20e2897da1af023a45fab","55524ced3d7788b1c3f84891d7bf75caecd4d3432f7f41d69691436318d5d4a0","8bb1971bb18d95e6152da1578d3da492375db46521360976e29c275cb93cdb2e","440160fafdff8ee6eb316c67e1ff29bd915e3cbbd3ba701b136eccbc0e125ace","7f3a454048fa60d91723102869c3f5d2384cee069a9cb5d988401d02694f5e38","e2686955df08743eaf61a0df286af24c6c7008f30b2ec97a069dc707529fa210","6acf78efcacbc4249f8532d62947e5fbaa340a6f89ec14c8267fb9023da1bc83","7634c30551be849b72910867de1c149631b06850943ff534f43be24040ac6396","d12548e8596aa0d855d53973416c52745f31ae663a71bae582c58e8323e3018b","e8f6997f790865875eb197108a22f9d2f5babe2f2de90465272cd6151b882a63","b4aa91f4e60bc0e0a9a83341e84e15e62d4b38a4bd5b50f1001cc0e59acf4026","e865b9a36a6d25b1237c158bf4e18f331b2406f9fec71c0471a180a38870cd45","d93b8f6a9ebc3807960776a3b6de9b0150f14635368b0050dc8580e95ee95d29"],"p