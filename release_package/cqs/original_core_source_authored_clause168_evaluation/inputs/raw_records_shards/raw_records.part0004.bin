{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23736},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23737},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23738},{"literal_text_all_w_t_and_m_t":"CRS-IM","paragraph_zero_based":23739},{"literal_text_all_w_t_and_m_t":"For the serving cell with 15kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-15kHzSCS-r17, but not supporting crs-IM-nonDSS-15kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":23740},{"literal_text_all_w_t_and_m_t":"For the serving cell with 30kHz SCS, this field is mandatory present for the UE supporting the capability of crs-IM-nonDSS-NWA-30kHzSCS-r17, but not supporting crs-IM-nonDSS-30kHzSCS-r17, if RateMatchPatternLTE-CRS is not configured for this serving cell. Otherwise it is optionally present, Need S if RateMatchPatternLTE-CRS is configured for this serving cell; Need M otherwise.","paragraph_zero_based":23741},{"literal_text_all_w_t_and_m_t":"NotCellID","paragraph_zero_based":23742},{"literal_text_all_w_t_and_m_t":"If the field neighCellId is present, this field shall be absent; otherwise, it is optionally present if the IE LTE-NeighCellsCRS-AssistInfoList contains one list entry, Need S, or it is mandatory present if the IE LTE-NeighCellsCRS-AssistInfoList contains multiple list entries.","paragraph_zero_based":23743},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23744},{"literal_text_all_w_t_and_m_t":"–LTM-CandidateId","paragraph_zero_based":23745},{"literal_text_all_w_t_and_m_t":"The IE LTM-CandidateId is used to identify an LTM candidate configuration.","paragraph_zero_based":23746},{"literal_text_all_w_t_and_m_t":"LTM-CandidateId information element","paragraph_zero_based":23747},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23748},{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CANDIDATEID-START","paragraph_zero_based":23749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23750},{"literal_text_all_w_t_and_m_t":"LTM-CandidateId-r18 ::=                             INTEGER (1..maxNrofLTM-Configs-r18)","paragraph_zero_based":23751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23752},{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CANDIDATEID-STOP","paragraph_zero_based":23753},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23755},{"literal_text_all_w_t_and_m_t":"–LTM-Candidate","paragraph_zero_based":23756},{"literal_text_all_w_t_and_m_t":"The IE LTM-Candidate concerns a LTM candidate configuration to add or modify.","paragraph_zero_based":23757},{"literal_text_all_w_t_and_m_t":"LTM-Candidate information element","paragraph_zero_based":23758},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3f9d8d23b3deba093a029b5567ce20863177d239d6e0e83b5107369be002e7d0","11dbe37c588a4a8d867c37c4c4437fc1dfddd512154ce73f1e85f1d6cf79fbd8","5885c4afb6bee1a3c7a44e284787aea6af6a4972538572b4c6d363226e0bce21","3eb8117cd3a39175b9fabd50a6df70df7d319911504e1a5fe88dab3b53c5cdcf","4903ccb92f6ee0d22e5afbfaf936abc276055d73e53910eec62ba2c6efb8cbda","f0bf2035b2fef0b39235a4f4e073aee4a89b597705455e70b6cd1d9dd6b18626",