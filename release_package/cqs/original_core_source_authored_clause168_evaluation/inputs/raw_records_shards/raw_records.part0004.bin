{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":2352},{"literal_text_all_w_t_and_m_t":"2>reconfigure the RLC entity or entities in accordance with the received rlc-Config;","paragraph_zero_based":2353},{"literal_text_all_w_t_and_m_t":"2>reconfigure the logical channel in accordance with the received mac-LogicalChannelConfig;","paragraph_zero_based":2354},{"literal_text_all_w_t_and_m_t":"1>else (a backhaul logical channel with the given BH-RLC-ChannelID was not configured before within the same cell group):","paragraph_zero_based":2355},{"literal_text_all_w_t_and_m_t":"2>establish an RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2356},{"literal_text_all_w_t_and_m_t":"2>configure this MAC entity with a logical channel in accordance to the received mac-LogicalChannelConfig.","paragraph_zero_based":2357},{"literal_text_all_w_t_and_m_t":"5.3.5.5.12Uu Relay RLC channel release","paragraph_zero_based":2358},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE or N3C relay UE shall:","paragraph_zero_based":2359},{"literal_text_all_w_t_and_m_t":"1>for each Uu-RelayRLC-ChannelID value included in the uu-RelayRLC-ChannelToReleaseList that is part of the current configuration within the same cell group (LCH release):","paragraph_zero_based":2360},{"literal_text_all_w_t_and_m_t":"2>release the RLC entity as specified in TS 38.322 [4], clause 5.1.3;","paragraph_zero_based":2361},{"literal_text_all_w_t_and_m_t":"2>release the corresponding logical channel.","paragraph_zero_based":2362},{"literal_text_all_w_t_and_m_t":"5.3.5.5.13Uu Relay RLC channel addition/modification","paragraph_zero_based":2363},{"literal_text_all_w_t_and_m_t":"For each Uu-RelayRLC-ChannelConfig received in the uu-RelayRLC-ChannelToAddModList the L2 U2N Relay UE or N3C relay UE shall:","paragraph_zero_based":2364},{"literal_text_all_w_t_and_m_t":"1>if the current configuration contains a Uu Relay RLC channel with the same uu-RelayRLC-ChannelID within the same cell group:","paragraph_zero_based":2365},{"literal_text_all_w_t_and_m_t":"2>if reestablishRLC is received:","paragraph_zero_based":2366},{"literal_text_all_w_t_and_m_t":"3>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":2367},{"literal_text_all_w_t_and_m_t":"2>reconfigure the RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2368},{"literal_text_all_w_t_and_m_t":"2>reconfigure the logical channel in accordance with the received mac-LogicalChannelConfig;","paragraph_zero_based":2369},{"literal_text_all_w_t_and_m_t":"1>else (a logical channel with the given uu-RelayRLC-ChannelID was not configured before within the same cell group):","paragraph_zero_based":2370},{"literal_text_all_w_t_and_m_t":"2>establish an RLC entity in accordance with the received rlc-Config;","paragraph_zero_based":2371},{"literal_text_all_w_t_and_m_t":"2>configure this MAC entity with a logical channel in accordance to the received mac-LogicalChannelConfig.","paragraph_zero_based":2372},{"literal_text_all_w_t_and_m_t":"5.3.5.5.14NCR-Fwd configuration","paragraph_zero_based":2373},{"literal_text_all_w_t_and_m_t":"The NCR-MT shall:","paragraph_zero_based":2374},{"literal_text_all_w_t_and_m_t":"1>if ncr-FwdConfig is set to setup:","paragraph_zero_based":2375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3f69d71378efbd4e167663c5a0a451e1c1525676d29d3aaa7f97eae9cff6b6d2","b666baa0e531c1665de872d991b6888f78f1defa