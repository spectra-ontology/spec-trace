{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28344},{"literal_text_all_w_t_and_m_t":"    iab-Support-r16                     ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":28345},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28346},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28347},{"literal_text_all_w_t_and_m_t":"    trackingAreaList-r17                SEQUENCE (SIZE (1..maxTAC-r17)) OF TrackingAreaCode             OPTIONAL,      -- Need R","paragraph_zero_based":28348},{"literal_text_all_w_t_and_m_t":"    gNB-ID-Length-r17                   INTEGER (22..32)                                                OPTIONAL    -- Cond eventID-TSS","paragraph_zero_based":28349},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28350},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28351},{"literal_text_all_w_t_and_m_t":"    mobileIAB-Support-r18               ENUMERATED {true}                                               OPTIONAL       -- Need S","paragraph_zero_based":28352},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28353},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28354},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-STOP","paragraph_zero_based":28355},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28356},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28357},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo field descriptions","paragraph_zero_based":28358},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":28359},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (per PLMN), as defined in TS 38.304 [20]. This field is ignored by IAB-MT and NCR-MT.","paragraph_zero_based":28360},{"literal_text_all_w_t_and_m_t":"gNB-ID-Length","paragraph_zero_based":28361},{"literal_text_all_w_t_and_m_t":"Indicates the length of the gNB ID out of the 36-bit long cellIdentity. This field is always present if the mobileIAB-Support is broadcasted in a cell.","paragraph_zero_based":28362},{"literal_text_all_w_t_and_m_t":"iab-Support","paragraph_zero_based":28363},{"literal_text_all_w_t_and_m_t":"This field combines both the support of IAB and the cell status for IAB. If the field is present, the cell supports IAB and the cell is also considered as a candidate for cell (re)selection for IAB-node; if the field is absent, the cell does not support IAB and/or the cell is barred for IAB-node.","paragraph_zero_based":28364},{"literal_text_all_w_t_and_m_t":"mobileIAB-Support","paragraph_zero_based":28365},{"literal_text_all_w_t_and_m_t":"This field indicates the support of mobile IAB. If the field is absent, the cell is barred for mobile IAB-node.","paragraph_zero_based":28366},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":28367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4111753ecd915d37c2007c064153acf81476c54b50f985606551e9e872692300","f407bab252309fd4d91eee936a805f22bd9917ba137e88ba3ac43235dbfb1e69","712fc581c87643be9bea3ce539cffaeed198dc8c02694ccec3f2ad74f9f421a9","1ed8abb0159550c17daeede5a0a0c87c9a7c607f54b8e1c893a4a2db2097e52e","9ad523126a5a7a566ba31c850380d52188e7fcae01a8d75d2cf207a6e7ec2bbe","228ecd41068097112e73b49d5735d3fecce0984934bff8f6fe3178c004220e4f","ed1c2e823c73a1ec4299a4c8f2153556d500a7f805a6b8a9dedddd8aac8072fd","b8b515b42e51bd6fbee799810565003ae82751d041f80