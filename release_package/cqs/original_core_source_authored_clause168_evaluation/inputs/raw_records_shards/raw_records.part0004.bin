{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    codebook1-r18               ENUMERATED {ng1n4n1, ng1n2n2},","paragraph_zero_based":29664},{"literal_text_all_w_t_and_m_t":"    codebook2-r18               ENUMERATED {ng2},","paragraph_zero_based":29665},{"literal_text_all_w_t_and_m_t":"    codebook3-r18               ENUMERATED {ng4},","paragraph_zero_based":29666},{"literal_text_all_w_t_and_m_t":"    codebook4-r18               ENUMERATED {ng8}","paragraph_zero_based":29667},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29669},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigDCI-0-3-r18 ::=                   SEQUENCE {","paragraph_zero_based":29670},{"literal_text_all_w_t_and_m_t":"    resourceAllocationDCI-0-3-r18                 ENUMERATED {resourceAllocationType0, resourceAllocationType1, dynamicSwitch}","paragraph_zero_based":29671},{"literal_text_all_w_t_and_m_t":"                                                                                                                 OPTIONAL,   -- Need M","paragraph_zero_based":29672},{"literal_text_all_w_t_and_m_t":"    rbg-SizeDCI-0-3-r18                           ENUMERATED {config2, config3}                                  OPTIONAL,   -- Need S","paragraph_zero_based":29673},{"literal_text_all_w_t_and_m_t":"    resourceAllocationType1GranularityDCI-0-3-r18 ENUMERATED {n2,n4,n8,n16}                                      OPTIONAL,   -- Need S","paragraph_zero_based":29674},{"literal_text_all_w_t_and_m_t":"    numberOfBitsForRV-DCI-0-3-r18                 INTEGER (0..2)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":29675},{"literal_text_all_w_t_and_m_t":"    harq-ProcessNumberSizeDCI-0-3-r18             INTEGER (0..5)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":29676},{"literal_text_all_w_t_and_m_t":"    uci-OnPUSCH-ListDCI-0-3-r18                   SetupRelease { UCI-OnPUSCH-ListDCI-0-1-r16  }                  OPTIONAL    -- Need M","paragraph_zero_based":29677},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29679},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIG-STOP","paragraph_zero_based":29680},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29682},{"literal_text_all_w_t_and_m_t":"PUSCH-Config field descriptions","paragraph_zero_based":29683},{"literal_text_all_w_t_and_m_t":"antennaPortsFieldPresenceDCI-0-2","paragraph_zero_based":29684},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Antenna ports\" field in DCI format 0_2. When the field is configured, then the \"Antenna ports\" field is present in DCI format 0_2. Otherwise, the field size is set to 0 for DCI format 0_2 (See TS 38.212 [17], clause 7.3.1.1.3). If neither dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 nor dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 is configured, this field is absent.","paragraph_zero_based":29685},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":29686},{"literal_text_all_w_t_and_m_t":"This field indicates, for a PUSCH transmission, if UE applies the first or the second \"indicated\" UL only TCI or joint TCI as specified in TS 38.214 [19], clause 6.1. This field is absent if more than one value for the field coresetPoolIndex is configured in controlResourceSet for a DL BWP used with this UL BWP.","paragraph_zero_based":29687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d38388506efadfaebd69377f835ae9102f44b878cfbf34138b061cfec6c59c15","2067f83a3c1b28c7b3f6b4322ae7fc32af237d51f1c0bb3423917485b7d7efda","2ce6350c2def8ee81bf6b1bbfae41f7a1faa0ce4027733dff98a7fe9f50f94b4","aeb7596f919b9afd12d1a77cdce694b3e1bf1c40a2a140a483bcd0da83b3dfad","e6d4be1c7bd795470df29834515a12bef475be2efd9470b3e58eacd378b56bcc","549c44521b6a22e55a3d546c3f6e38415d720105f22ea352a2f05ec8355cc7c6","5ddae3223929c3d6b788cf236499ee25d58c97e5c49f9602d81a073f09a417c3","022c330aa592979820cb95c5fac66724f715c7f80cf2226733f43cf83f9ff5b3","be20f7aa41822f6709f0dbe2d0650145fed08f7d4d6abdd15778e160e2764df4","d6f3e4c1448ac1dd7c3f816b079154ea2507f9c09bcf8e51d0c1c8e0be2b0d10","760cab712eb26a865e172b77b9fc4bfb8b8e911e6cfe279329fad746e9258c84","d8b32e92842bcdf1c8572d1d5d443b45f075e1669c830db71c9980e0a4bf055e","8e9d70d5556b046aa5a643adc93643bd09d76a47dc7a6f27ca7d115f42eb7399","d0d5a1cc4074007d6b819eb5e063db9d4345529074f5981ba0fbc96aa3b6de84","620a3c0a7466ced622b00b4b6c184797b523c83c969a529c6a5c83e22ea2a449","118efcf72a6371aaee03083bcf296c6e8a835cceb17d90c300b61b14d1daa2d4","dffd72778d33a44ddc0100cf87ff7fee76cb760918e7010aa8b3475ae918c1e5","14adeb583819bd0180d6286ceeb45fa11ec1d93d659d745704470ba20f6107db","381a34c303d94ab405f89496972fbb75de3ee2b58fb424d0782f8f33e63f8975","591db1b1fff5768342c0f3d8c9e90740fa016fcc0b0555543793708a23ec456f","5aca93d101d0b3e6487dd725a93fd12a3cdac23b957f166615c62f6c6f7d4bd7","aaf30357820ca5550988caf1f98e34026c6d26dfc01d8a8e03b8200eae776402","548fcf2ae33fbaacf171b0686d0e012027bf103a384cdaef5126901294606065","34a466d926f53ae48463eceeaf2961a261fc444ca5e2bec7f888d96eea1302df"],"paragraph_range_zero_based":[29664,29687],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29664"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"availableSlotCounting","paragraph_zero_based":29688},{"literal_text_all_w_t_and_m_t":"Indicate whether PUSCH repetitions counted on the basis of available slots is enabled. If the field is absent, PUSCH repetitions counted on the basis of available slots is disabled.","paragraph_zero_based":29689},{"literal_text_all_w_t_and_m_t":"betaOffsetsCrossPri0, betaOffsetsCrossPri1, betaOffsetsCrossPri0DCI-0-2, betaOffsetsCrossPri1DCI-0-2","paragraph_zero_based":29690},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for multiplexing HARQ-ACK on dynamically scheduled PUSCH with different priorities, see TS 38.213 [13], clause 9.3.","paragraph_zero_based":29691},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0 indicates multiplexing low priority (LP) HARQ-ACK on dynamically scheduled high priority (HP) PUSCH.","paragraph_zero_based":29692},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH.","paragraph_zero_based":29693},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio0DCI-0-2 indicates multiplexing LP HARQ-ACK on dynamically scheduled HP PUSCH by DCI format 0_2.","paragraph_zero_based":29694},{"literal_text_all_w_t_and_m_t":"The field betaOffsetsCrossPrio1DCI-0-2 indicates multiplexing HP HARQ-ACK on dynamically scheduled LP PUSCH by DCI format 0_2.","paragraph_zero_based":29695},{"literal_text_all_w_t_and_m_t":"codebookSubset, codebookSubsetDCI-0-2","paragraph_zero_based":29696},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TPMI, where PMIs are those supported by UEs with maximum coherence capabilities (see TS 38.214 [19], clause 6.1.1.1). The field codebookSubset applies to DCI formats 0_1 and 0_3, and the field codebookSubsetDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1).","paragraph_zero_based":29697},{"literal_text_all_w_t_and_m_t":"codebookTypeUL","paragraph_zero_based":29698},{"literal_text_all_w_t_and_m_t":"Configures a codebook and the corresponding number of antenna port groups for codebook-based transmission of PUSCH with 8 antenna ports, see TS 38.211 [16], tables 6.3.1.5-9 to 6.3.1.5-47, and table 6.3.1.5-8 respectively). The values ng1n4n1 and ng1n2n2 correspond to codebooks with one antenna port group (Ng=1), while ng2, ng4, and ng8 correspond to codebooks with Ng=2, 4, and 8 antenna port groups, respectively.","paragraph_zero_based":29699},{"literal_text_all_w_t_and_m_t":"dataScramblingIdentityPUSCH","paragraph_zero_based":29700},{"literal_text_all_w_t_and_m_t":"Identifier used to initialise data scrambling (c_init) for PUSCH. If the field is absent, the UE applies the physical cell ID. (see TS 38.211 [16], clause 6.3.1.1).","paragraph_zero_based":29701},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUSCH-Config","paragraph_zero_based":29702},{"literal_text_all_w_t_and_m_t":"Configure the parameters for DMRS bundling for PUSCH (see TS 38.214 [19], clause 6.1.7). In this release, this is not applicable to FR2-2.","paragraph_zero_based":29703},{"literal_text_all_w_t_and_m_t":"dmrs-SequenceInitializationDCI-0-2","paragraph_zero_based":29704},{"literal_text_all_w_t_and_m_t":"Configure whether the field \"DMRS Sequence Initialization\" is present or not in DCI format 0_2. If the field is absent, then 0 bit for the field \"DMRS Sequence Initialization\" in DCI format 0_2. If the field is present, then the number of bits is determined in the same way as DCI format 0_1 (see TS 38.212 [17], clause 7.3.1).  ","paragraph_zero_based":29705},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeA, dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2","paragraph_zero_based":29706},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type A (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeA applies to DCI formats 0_1 and 0_3, and the field dmrs-UplinkForPUSCH-MappingTypeA-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29707},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkForPUSCH-MappingTypeB, dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2","paragraph_zero_based":29708},{"literal_text_all_w_t_and_m_t":"DMRS configuration for PUSCH transmissions using PUSCH mapping type B (chosen dynamically via PUSCH-TimeDomainResourceAllocation). Only the fields dmrs-Type, dmrs-AdditionalPosition and maxLength may be set differently for mapping type A and B. The field dmrs-UplinkForPUSCH-MappingTypeB applies to DCI formats 0_1 and 0_3, and the field dmrs-UplinkForPUSCH-MappingTypeB-DCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29709},{"literal_text_all_w_t_and_m_t":"dynamicTransformPrecoderFieldPresenceDCI-0-1","paragraph_zero_based":29710},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Dynamic Transform Precoder\" field in DCI format 0_1. When the field is configured, then the \"Dynamic Transform Precoder\" field is present in DCI format 0_1. Otherwise, the field size is set to 0 for DCI format 0_1 (See TS 38.212 [17]). The network ensures dynamicTransformPrecoderFieldPresenceDCI-0-1-r18 and twoPHRMode-r17 cannot be configured at the same time for a UE.","paragraph_zero_based":29711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4a794372d122d9da36f0d8a4021a70eaeb1afbfd3bbfe19ad49e94f28212ac5a","85f3959abe40ba39c0b0c6017883a4b400eff3fd10d5033fa8cba8d220970817","cca585bbe22e0ed88bd7980ebda908ac5f05d79848e973c80223b542e9b1416f","678f07bbbbf5a726feb9f7c76a26300b3199e3ca180970a27217ffa4a5159611","12cbc6de400af05a9e990604428a8e0202a72f0ec13cd02fe184100a450c8458","f19e2ca3313491bb885c6105be09e1a7c7873e23825e4a2dc280757a5fc3a9f2","845b3bda6e25b659aa52e4fcfd62d9a31f954fa7cbe27179a07b6b04dac50f4a","a1f96b7ce7fba9394fd3b0a546b5128502717583eddce1b520458081c9b4b83f","c4fdd4fd07b8b24eb798cca686b2a7c4bb0489f1e7c16912f688dfaa2cefd914","555382c1151fc9a040538fd4c682005d5751a07b5421e87240f97b04b7f90cd7","970e5cbcd22aae9079807e0bd2dfc29d2396ab4a3ce9006f859746c27c389361","4dfcabac1d4c32f450552f9b74c7b7d1521555f398cf5c19776478264dfaec05","aaded9d566f2b14aad6deac913cbc4fda97b51da506b5e1362f305d6ae3c25cf","8352e635ea5f358b306b48be6e3b9056c6d43bb2c860addfe152755b35d6e109","e311f56083dec6f78d6266b0800a42a403ed6b000289a7970ac3310b39da86eb","f3d4c56ddaf8736a35786a1c6b66fb6cd0417f7e0a68072b7ce39085de8ed437","a61901f87efcc062965e368b2613e336fb72bf60656310219bdb8efa43ae4094","eb3dc68691cc50abb16e6beb9b15d3e1e2db0e578d46d1cef4d7c0464b15228d","ff3e72b6f716e29ad3c44c69234fbdd25325b26111d2d0b55021cde7211b5bb5","96795e70b9ddfc78d6826de66a09c558151902b5918217bc7a76889cf35fe921","300116a099d0cfffffc793d78c4bbe5cb4d6f64c7cf9a4b0aecc06a27f5959a6","e98a66fc4fb26570c8742cf59bbcea8dd028c004fee35c3c0e1da310f81c1fc8","371534c267e4e6cfcd23ddfbfe040c23f0cfa5095d2ae2b2978521058d13457a","d8985b2992139c6843959fa17f96acbc7fd8009452b568e0e8bab11a702a96c4"],"paragraph_range_zero_based":[29688,29711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29688"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dynamicTransformPrecoderFieldPresenceDCI-0-2","paragraph_zero_based":29712},{"literal_text_all_w_t_and_m_t":"Configure the presence of \"Dynamic Transform Precoder\" field in DCI format 0_2. When the field is configured, then the \"Dynamic Transform Precoder\" field is present in DCI format 0_2. Otherwise, the field size is set to 0 for DCI format 0_2 (See TS 38.212 [17]). The network ensures dynamicTransformPrecoderFieldPresenceDCI-0-2-r18 and twoPHRMode-r17 cannot be configured at the same time for a UE.","paragraph_zero_based":29713},{"literal_text_all_w_t_and_m_t":"frequencyHopping","paragraph_zero_based":29714},{"literal_text_all_w_t_and_m_t":"The value intraSlot enables 'Intra-slot frequency hopping' and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for 'pusch-RepTypeA' (see TS 38.214 [19], clause 6.3). The field frequencyHopping applies to DCI formats 0_0, 0_1 and 0_3 for 'pusch-RepTypeA'.","paragraph_zero_based":29715},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-1","paragraph_zero_based":29716},{"literal_text_all_w_t_and_m_t":"Indicates the frequency hopping scheme for DCI format 0_1 when pusch-RepTypeIndicatorDCI-0-1 is set to 'pusch-RepTypeB', The value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. If the field is absent, frequency hopping is not configured for DCI format 0_1 for 'pusch-RepTypeB' (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":29717},{"literal_text_all_w_t_and_m_t":"frequencyHoppingDCI-0-2","paragraph_zero_based":29718},{"literal_text_all_w_t_and_m_t":"Indicate the frequency hopping scheme for DCI format 0_2. The value intraSlot enables 'intra-slot frequency hopping', and the value interRepetition enables 'Inter-repetition frequency hopping', and the value interSlot enables 'Inter-slot frequency hopping'. When pusch-RepTypeIndicatorDCI-0-2 is not set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'intra-slot frequency hopping and 'inter-slot frequency hopping' if enabled. When pusch-RepTypeIndicatorDCI-0-2 is set to 'pusch-RepTypeB', the frequency hopping scheme can be chosen between 'inter-repetition frequency hopping' and 'inter-slot frequency hopping' if enabled. If the field is absent, frequency hopping is not configured for DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":29719},{"literal_text_all_w_t_and_m_t":"frequencyHoppingOffsetLists, frequencyHoppingOffsetListsDCI-0-2","paragraph_zero_based":29720},{"literal_text_all_w_t_and_m_t":"Set of frequency hopping offsets used when frequency hopping is enabled for granted transmission (not msg3) and type 2 configured grant activation (see TS 38.214 [19], clause 6.3). The field frequencyHoppingOffsetLists applies to DCI formats 0_0, 0_1 and 0_3, and the field frequencyHoppingOffsetListsDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.3).","paragraph_zero_based":29721},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-0-2","paragraph_zero_based":29722},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29723},{"literal_text_all_w_t_and_m_t":"invalidSymbolPattern","paragraph_zero_based":29724},{"literal_text_all_w_t_and_m_t":"Indicates one pattern for invalid symbols for PUSCH transmission repetition type B applicable to both DCI format 0_1 and 0_2. If InvalidSymbolPattern is not configured, semi-static flexible symbols are used for PUSCH. Segmentation occurs only around semi-static DL symbols (see TS 38.214 [19] clause 6.1).","paragraph_zero_based":29725},{"literal_text_all_w_t_and_m_t":"invalidSymbolPatternIndicatorDCI-0-1, invalidSymbolPatternIndicatorDCI-0-2","paragraph_zero_based":29726},{"literal_text_all_w_t_and_m_t":"Indicates the presence of an additional bit in the DCI format 0_1/0_2. If invalidSymbolPattern is absent, then both invalidSymbolPatternIndicatorDCI-0-1 and invalidSymbolPatternIndicatorDCI-0-2 are absent. The field invalidSymbolPatternIndicatorDCI-0-1 applies to the DCI format 0_1 and the field invalidSymbolPatternIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19] clause 6.1). If the field is absent, the UE behaviour is specified in TS 38.214 [19], clause 6.1.2.1.","paragraph_zero_based":29727},{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":29728},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when two SRS resource sets are configured in srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook' for PUSCH transmission and the PUSCH transmission occasions are associated with both SRS resource sets.","paragraph_zero_based":29729},{"literal_text_all_w_t_and_m_t":"maxRank, maxRankDCI-0-2","paragraph_zero_based":29730},{"literal_text_all_w_t_and_m_t":"Subset of PMIs addressed by TRIs from 1 to ULmaxRank (see TS 38.214 [19], clause 6.1.1.1). The field maxRank applies to DCI formats 0_1 and 0_3, and the field maxRankDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.1.1). If network configures maxRank-v1810 UE ignores maxRank (without suffix).","paragraph_zero_based":29731},{"literal_text_all_w_t_and_m_t":"mcs-Table, mcs-TableFormat0-2","paragraph_zero_based":29732},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH without transform precoder (see TS 38.214 [19], clause 6.1.4.1). If the field is absent the UE applies the value 64QAM. The field mcs-Table applies to DCI formats 0_0, 0_1 and 0_3, and the field mcs-TableDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":29733},{"literal_text_all_w_t_and_m_t":"mcs-TableTransformPrecoder, mcs-TableTransformPrecoderDCI-0-2","paragraph_zero_based":29734},{"literal_text_all_w_t_and_m_t":"Indicates which MCS table the UE shall use for PUSCH with transform precoding (see TS 38.214 [19], clause 6.1.4.1) If the field is absent the UE applies the value 64QAM. The field mcs-TableTransformPrecoder applies to DCI format 0_0, 0_1 and 0_3, and the field mcs-TableTransformPrecoderDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.4.1).","paragraph_zero_based":29735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9380a515783936cff2d24a136aa578da4eb2f2e5736a5cda8c4f16becd2e838d","5028f99ef2a1a1517de40b64e5db8dc7f0cd2160bf9e21a4b932d9258a465d75","7d3dd3fcc2e5135511152ae2669cec9e1b3e333f4584834d8fbb93c2b9ae5e8a","1387e5b39e8250bf712f155cf7adc65cc886663df54c06253fe19d6eff92e59a","792af950deed4a4652cea62a1ac5cc0b09d8b2171a88e575a67facd4dd7c56a8","6ddd7881eda7879092c146a66a5d7a178e47c92fe544d1598c9351cb18c27132","23fa55091be8491eadc4928e9cb533695ad100355148cdd23912618713e91b90","2bee21287f3751ca342602ff81a94fa58a3a635738afae89c9754fc1e1159ea3","ebc7f39cf232d42abc8b5c88adb6777ba614a2426ec9ed52ffcfbfc78fe2dd4a","992de02d20a2132e3b96380c33d42b1aef67ebf2ebd47914b6fce3e7fc9d313d","46746530cc42d4b0e0f9e258a5af087103a0de8373673e1758c47fc1cece3aef","897101a2031375c08cd5d105071d584398b8f385bf0abc08df3396e6baa86aec","d57e0b7545d9781c73eedde9a229434d9340b3796ef6c7458f6787916f59fb9f","819f8b827fa69bf88d5f7423ffd3386b2978f40689a510b8d82627a8c9c7e390","85f81c8939f01a3b645b71ec91de69dc06de2b423fb46f9a5e813d5486a94448","fd8c7628efee5c8fad6e18f4dd3bc333235086d99ce6875f3ab00d5c91f99a6b","217390e250fdbdca991c1b6ff22711f041656b852afc964421fa1bccc3760161","127333075a6e12430d4b43274d72dc865392ddc381d53cc57b0d830b1b1fb03f","c1c31eb525db26f0da42ff0a868cb100cc30f04046b4cefaa4aafb18b098f901","de255a71b851046cae7add2dce3af16e2cdefe982e2fd3db25c70b37dec3f93b","099d3fe0e1e665835624170d65be834d7138a32c22d3881d2d77d9cf87a7e4dd","98d3d3e42a94741ccea7c5876f3edc16fc28c6ba46ec40d0fca6fb4b5bf169eb","6fc04853a6e56d184dbb3532e5da7fd4576726b6202d5745531d1be4bbb5e918","4411d868984db4ca23f36001904efc57cad8f4b66c51060465657be4056fce44"],"paragraph_range_zero_based":[29712,29735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29712"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK2","paragraph_zero_based":29736},{"literal_text_all_w_t_and_m_t":"List of minimum K2 values. Minimum K2 parameter denotes minimum applicable value(s) for the Time domain resource assignment table for PUSCH (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29737},{"literal_text_all_w_t_and_m_t":"mpe-ResourcePoolToAddModList","paragraph_zero_based":29738},{"literal_text_all_w_t_and_m_t":"List of SSB/CSI-RS resources for P-MPR reporting. Each resource is configured with serving cell index where the resource is configured for the UE. The additionalPCI is configured only if the resource is SSB. For each resource, if neither cell nor additionalPCI is present, the SSB/CSI-RS resource is from the serving cell where the PUSCH-Config is configured.","paragraph_zero_based":29739},{"literal_text_all_w_t_and_m_t":"multipanelSchemeSDM","paragraph_zero_based":29740},{"literal_text_all_w_t_and_m_t":"Configures UE with a multiple panel simultaneous uplink transmission SDM scheme for PUSCH. Network does not configure multipanelSchemeSDM with multipanelSchemeSFN. When this paramater is configured, more than one value for the field coresetPoolIndex  are configured and two SRS resource sets for codebook or noncodebook are configured.","paragraph_zero_based":29741},{"literal_text_all_w_t_and_m_t":"multipanelSchemeSFN","paragraph_zero_based":29742},{"literal_text_all_w_t_and_m_t":"Configures UE with a multiple panel simultaneous uplink transmission SFN scheme for PUSCH. Network does not configure multipanelSchemeSFN with multipanelSchemeSDM. When this paramater is configured, more than one value for the field coresetPoolIndex are configured and two SRS resource sets for codebook or noncodebook are configured.","paragraph_zero_based":29743},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-0-2","paragraph_zero_based":29744},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29745},{"literal_text_all_w_t_and_m_t":"numberOfInvalidSymbolsForDL-UL-Switching","paragraph_zero_based":29746},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols after the last semi-static DL symbol that are invalid symbols for PUSCH repetition Type B. If it is absent, no symbol is explicitly defined for DL-to-UL switching (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":29747},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-0-1, priorityIndicatorDCI-0-2","paragraph_zero_based":29748},{"literal_text_all_w_t_and_m_t":"Configures the presence of \"priority indicator\" in DCI format 0_1/0_2. When the field is absent in the IE, then the UE shall apply 0 bit for \"Priority indicator\" in DCI format 0_1/0_2. The field priorityIndicatorDCI-0-1 applies to DCI format 0_1 and the field priorityIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13] clause 9).","paragraph_zero_based":29749},{"literal_text_all_w_t_and_m_t":"pusch-AggregationFactor","paragraph_zero_based":29750},{"literal_text_all_w_t_and_m_t":"Number of repetitions for data (see TS 38.214 [19], clause 6.1.2.1). If the field is absent the UE applies the value 1.","paragraph_zero_based":29751},{"literal_text_all_w_t_and_m_t":"pusch-PowerControl","paragraph_zero_based":29752},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUSCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":29753},{"literal_text_all_w_t_and_m_t":"pusch-RepTypeIndicatorDCI-0-1, pusch-RepTypeIndicatorDCI-0-2","paragraph_zero_based":29754},{"literal_text_all_w_t_and_m_t":"Indicates whether UE follows the behavior for \"PUSCH repetition type A\" or the behavior for \"PUSCH repetition type B\" for the PUSCH scheduled by DCI format 0_1/0_2 and for Type 2 CG associated with the activating DCI format 0_1/0_2.The value pusch-RepTypeA enables the 'PUSCH repetition type A' and the value pusch-RepTypeB enables the 'PUSCH repetition type B'. The field pusch-RepTypeIndicatorDCI-0-1 applies to DCI format 0_1 and the field pusch-RepTypeIndicatorDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29755},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationList","paragraph_zero_based":29756},{"literal_text_all_w_t_and_m_t":"List of time domain allocations for timing of UL assignment to UL data (see TS 38.214 [19], table 6.1.2.1.1-1). The field pusch-TimeDomainAllocationList applies to DCI format 0_0, or DCI formats 0_1 and 0_3 when the field pusch-TimeDomainAllocationListDCI-0-1 is not configured (see TS 38.214 [19], table 6.1.2.1.1-1 and tables 6.1.2.1.1-1A and 6.1.2.1.1-1C). The network does not configure the pusch-TimeDomainAllocationList (without suffix) simultaneously with the pusch-TimeDomainAllocationListDCI-0-2-r16 or pusch-TimeDomainAllocationListDCI-0-1-r16 or pusch-TimeDomainAllocationListForMultiPUSCH-r16.","paragraph_zero_based":29757},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-1","paragraph_zero_based":29758},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI formats 0_1 and 0_3 (see TS 38.214 [19], clause 6.1, tables 6.1.2.1.1-1A and 6.1.2.1.1-1C).","paragraph_zero_based":29759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["586edaf858642c5b3d3d7fdbf8d97f6da250e2dbdc88bb9abbd1d488e3a8013d","cb4ee6d15255e068f341d3ab67db96c39887453c6647ca64f909ea2002a2a288","ebf23eea3bb18f061cab0a5f4108aa53da5992c1093a2eb7cdef4d2c989189cd","90f8697b54c056330bd9b05dfad1dcbfc4123144ef1c5d2bd51b735f47f96150","d2e22968d777f23bb0432a54060c895e9fb0f23cb6e51fd32f2ec2280f06e232","9ef00100a1e7c836bed8896ec8237a41184822ff3805b0c62dd814b574998ad6","366a6cbfd1a58841138afca9145004cc49c8458f149f04703922bb471c4a491b","5d621f49963fd9a40b1465330968c0dab2796d10656ca8541558b7af724ebc00","61d2938564ada278f5193d707c4ade2c9549b2cac62c1874d2664159b01c698c","45348a6858f48cf2bd1de4a711eb743bda4e74a53faf71a68e4b4c8a649e9ae4","7506dc302a79f6ba85da37ff589f04384c1bd2af0b1afeab7ce150e151202085","6615d644686bcf9c5f17413a1851f145a76efb1502a11128437c75c9810020b8","40bb19a89cf71098df390015f849d1e8deb2766aaf70567ed67b324e0cc41d9d","4d55b00c4ae1477316f5c1ace211946a5d6383586f00a6169362ec0b23bc55da","f6cda3860934a5ee006c6119c3d5aec72d4a35b51192e68c542b6478a5f9e195","aa8ad3dd0c7e789522e238cf846ac14ef57b5d87a188acad77a0117a2e3a544f","87d2a68fcabb167768b2a78276119ba79da8297d58b425c068356def2862ba01","9048d392058161660a67b96bebe72b64cf988661a837f8942491f5d42c3fb7cf","b2c02de700c82a776b107c895a2af77cb835d80e8bbbb4b537cc2efa52ac8113","ec25a7ef95839f8ef428a584cad8ce62815a45b7301db38f7c6c5b6e17fd3e02","e557b4d2042b819dbf9ea580d73eee9aa15842208da52b9fd33025f51f021eff","69a2f89fcb36a4b65ed7aba8cb9683e0854569a0f98564fb236a007a7ecb1030","d87880a77cd56875ad391b9a71db7e74b97962229ca5e38517ebb352bf1a4d60","ec7d6478f6ef94f3d83996b5584e4670c4475797bd768bc3addc7e8538fb9e9d"],"paragraph_range_zero_based":[29736,29759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29736"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListDCI-0-2","paragraph_zero_based":29760},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for DCI format 0_2 (see TS 38.214 [19], clause 6.1.2, table 6.1.2.1.1-1B).","paragraph_zero_based":29761},{"literal_text_all_w_t_and_m_t":"pusch-TimeDomainAllocationListForMultiPUSCH","paragraph_zero_based":29762},{"literal_text_all_w_t_and_m_t":"Configuration of the time domain resource allocation (TDRA) table for multiple PUSCH (see TS 38.214 [19], clause 6.1.2). The network configures at most 64 rows in this TDRA table in PUSCH-TimeDomainResourceAllocationList-r16 configured by this field. This field is not configured simultaneously with pusch-AggregationFactor. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the pusch-TimeDomainAllocationListDCI-0-1-r16. The network does not configure the pusch-TimeDomainAllocationListForMultiPUSCH-r16 simultaneously with the numberOfSlotsTBoMS-r17.","paragraph_zero_based":29763},{"literal_text_all_w_t_and_m_t":"rbg-Size","paragraph_zero_based":29764},{"literal_text_all_w_t_and_m_t":"Selection between configuration 1 and configuration 2 for RBG size for PUSCH except PUSCH scheduled by DCI format 0_3. The UE does not apply this field if resourceAllocation is set to resourceAllocationType1. Otherwise, the UE applies the value config1 when the field is absent (see TS 38.214 [19], clause 6.1.2.2.1).","paragraph_zero_based":29765},{"literal_text_all_w_t_and_m_t":"resourceAllocation, resourceAllocationDCI-0-2","paragraph_zero_based":29766},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for non-fallback DCI (see TS 38.214 [19], clause 6.1.2). The field resourceAllocation applies to DCI format 0_1 and the field resourceAllocationDCI-0-2 applies to DCI format 0_2 (see TS 38.214 [19], clause 6.1.2).","paragraph_zero_based":29767},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-0-2","paragraph_zero_based":29768},{"literal_text_all_w_t_and_m_t":"Configures the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 0_2. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 6.1.2.2.2).","paragraph_zero_based":29769},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-0-1, secondTPCFieldDCI-0-2","paragraph_zero_based":29770},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-0-1 and DCI-0-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1,","paragraph_zero_based":29771},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":29772},{"literal_text_all_w_t_and_m_t":"Configures the RV offset for the starting RV for the first repetition (first actual repetition in PUSCH repetition Type B) towards the second 'SRS resource set' for PUSCH configured in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage 'codebook' or 'noncodebook'.","paragraph_zero_based":29773},{"literal_text_all_w_t_and_m_t":"sTx-2Panel","paragraph_zero_based":29774},{"literal_text_all_w_t_and_m_t":"Parameter to enable PUSCH+PUSCH multiple panel simultaneous uplink transmission in multi-DCI based mTRP system. When this paramater is configured, more than one value for the field coresetPoolIndex is configured and two SRS resource sets for codebook or noncodebook are configured.","paragraph_zero_based":29775},{"literal_text_all_w_t_and_m_t":"tp-pi2BPSK","paragraph_zero_based":29776},{"literal_text_all_w_t_and_m_t":"Enables pi/2-BPSK modulation with transform precoding if the field is present and disables it otherwise. ","paragraph_zero_based":29777},{"literal_text_all_w_t_and_m_t":"transformPrecoder","paragraph_zero_based":29778},{"literal_text_all_w_t_and_m_t":"The UE specific selection of transformer precoder for PUSCH (see TS 38.214 [19], clause 6.1.3). When the field is absent the UE applies the value of the field msg3-transformPrecoder from rach-ConfigCommon included directly within BWP configuration (i.e., not included in additionalRACH-ConfigList).","paragraph_zero_based":29779},{"literal_text_all_w_t_and_m_t":"txConfig","paragraph_zero_based":29780},{"literal_text_all_w_t_and_m_t":"Whether UE uses codebook based or non-codebook based transmission (see TS 38.214 [19], clause 6.1.1). If the field is absent, the UE transmits PUSCH on one antenna port, see TS 38.214 [19], clause 6.1.1.","paragraph_zero_based":29781},{"literal_text_all_w_t_and_m_t":"uci-OnPUSCH-ListDCI-0-1, uci-OnPUSCH-ListDCI-0-2","paragraph_zero_based":29782},{"literal_text_all_w_t_and_m_t":"Configuration for up to 2 HARQ-ACK codebooks specific to DCI format 0_1/0_2. The field uci-OnPUSCH-ListDCI-0-1 applies to DCI format 0_1 and the field uci-OnPUSCH-ListDCI-0-2 applies to DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":29783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8aafd7fbf87df502129552d32f96bca175e4cd89c4934c4bb2a15b5686d07f16","baff1c90ff00a8230fb53b9a245e2fe8bacc8b8ea1302a55b9c7f2f0a09d9750","2dda21385b09ed9ac9f41785d7491c34e56d67945eecdf2158526948c00a49ea","f041bb1cce9e5f7fc2fb716b9e5cd45b8485807a7e1526619f821518fd5336ac","82e8ffc44fad2aab468ee267f1175fcc828b361e6a3cae1cc0e9ebcf2ae782ee","a48ee292e4195ce0ae9f0ab2b8a55ec717cb5cacef71cfb3ff8ffe898fff1dfa","00887740665d4b8e44415c08ca8beca59541bbf96dc50f3ee291a07c99af2cfe","54165d428cd348cbd926897941bd63d4f11c3f3aaeb3db8a2f5f0eb29a6c75af","4d37269f3da7d972545fbfa61451d4df456573b54f7da01a28fd830b3d7c5efb","5c9681b549bb850f3c41a5e14befaaf1c34b20fbaa43552f7a51b380366f4aec","43870e67fa20ceff4fc8ba6829d6eb05498814ff5a08894c71bb3692d2cf0a75","98f5ab773ee235fa229bfa75d393c142fbb59845bac7e1485d423b84ce16d3c2","57ddffdd7f72b7a9cb493b5aef5f5f5691066da7680a67504c71bf67a48f3aa7","acebbfc57cb2220ccf7dfe96d491c1207b3282c2c7b01fc785e61986fa6510d0","5b121977e2f6b90b692271722985f12e5da76d8e4256aad3e150b9e413761df4","c088586f5b661147112441636857f9c59b5536f9e4ee8faf7c162bca08bb2d18","0734c28556bb0867adb5be5e12d808c37843344b6db82eadbf784da3ecfb25da","f5d099aa0a2f33c89761f71285d982350f124df3371b9f33b94ed176b7288370","58afb4c4b7bbf7514829b681fac486cf60f151bba14af21092d620bf94c5170e","a0d7f19b82079b8d81deb2b509d04a061d9fd00286ccde0c61b5dec23a6bfe9c","741d7a91300a452c7c008b3c7317335625e97fb75c9f78a20057d04ddfde5fba","2daeb03bb6ebe15aa95e6ecc0fe9d997890fa1a1d5730a24090eb5a8f8ea0327","51bf680b20e52f94896dc2032f7d8a03d68fec7504166f9d27b49ee7dff3154f","0c81c17c84833543804328bbeb7bcedbcaae5179c7299ea9d1b0e995a2c25cd7"],"paragraph_range_zero_based":[29760,29783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29760"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-0-1, ul-AccessConfigListDCI-0-2","paragraph_zero_based":29784},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension, channel access priority class (CAPC), and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable for DCI format 0_1 and DCI format 0_2, respectively. The fields ul-AccessConfigListDCI-0-1-r16 and ul-AccessConfigListDCI-0-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.1.2-35). The field ul-AccessConfigListDCI-0-1-r17 only contains a list of UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.1.2-35A).","paragraph_zero_based":29785},{"literal_text_all_w_t_and_m_t":"ul-FullPowerTransmission","paragraph_zero_based":29786},{"literal_text_all_w_t_and_m_t":"Configures the UE with UL full power transmission mode as specified in TS 38.213 [13]. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":29787},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29788},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigDCI-0-3 field descriptions","paragraph_zero_based":29789},{"literal_text_all_w_t_and_m_t":"harq-ProcessNumberSizeDCI-0-3","paragraph_zero_based":29790},{"literal_text_all_w_t_and_m_t":"Configure the number of bits for the field \"HARQ process number\" in DCI format 0_3 (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":29791},{"literal_text_all_w_t_and_m_t":"numberOfBitsForRV-DCI-0-3","paragraph_zero_based":29792},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Redundancy version\" in the DCI format 0_3 (see TS 38.212 [17], clause 7.3.1 and TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29793},{"literal_text_all_w_t_and_m_t":"rbg-SizeDCI-0-3","paragraph_zero_based":29794},{"literal_text_all_w_t_and_m_t":"Selection among configuration 1, configuration 2 and configuration 3 for RBG size for PUSCH scheduled by DCI format 0_3. The UE does not apply this field if resourceAllocationDCI-0-3 is set to resourceAllocationType1. Otherwise, the UE applies the value config1 when the field is absent (see TS 38.214 [19], clause 6.1.2.2.1).","paragraph_zero_based":29795},{"literal_text_all_w_t_and_m_t":"resourceAllocationDCI-0-3","paragraph_zero_based":29796},{"literal_text_all_w_t_and_m_t":"Configuration of resource allocation type 0 and resource allocation type 1 for DCI format 0_3 (see TS 38.214 [19], clause 6.1.2).","paragraph_zero_based":29797},{"literal_text_all_w_t_and_m_t":"resourceAllocationType1GranularityDCI-0-3","paragraph_zero_based":29798},{"literal_text_all_w_t_and_m_t":"Configures the scheduling granularity applicable for both the starting point and length indication for resource allocation type 1 in DCI format 0_3. If this field is absent, the granularity is 1 PRB (see TS 38.214 [19], clause 6.1.2.2.2).","paragraph_zero_based":29799},{"literal_text_all_w_t_and_m_t":"uci-OnPUSCH-ListDCI-0-3","paragraph_zero_based":29800},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for DCI format 0_3.","paragraph_zero_based":29801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29802},{"literal_text_all_w_t_and_m_t":"SDM-Scheme field descriptions","paragraph_zero_based":29803},{"literal_text_all_w_t_and_m_t":"maxRankSDM, maxRankSDM-DCI-0-2","paragraph_zero_based":29804},{"literal_text_all_w_t_and_m_t":"configure maximal number of MIMO layers of each panel in SDM scheme for codebook based PUSCH or for DCI 0_2 for codebook based PUSCH.","paragraph_zero_based":29805},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29806},{"literal_text_all_w_t_and_m_t":"SFN-Scheme field descriptions","paragraph_zero_based":29807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4646a5548a7266e5c8ead93be55eb312c52487bd9a075223c43afdaf95fbf705","a2aced326c059f15041186943aaa37c35378f497e4d821b61a568b80d99ac676","f7e717cbbfbebcfca5763a560c2beaf5a952b0f9581bb8041d09cd8bf0911319","8a062423e89b4b9ad3b8e51710db475d707f817081d11b36e555bfcedac57a2a","ce7b6065b0cdbec863623216f1225d0252f35e0cdb181734e07f1d83de89201d","913aa58056239e4b326f7524588c15f252c250c5c0f17c6723940026ca85b1c7","8a73aab696fe258fb39a58a138fa111949bb288cd7af11902cebef7dc2b6052b","5cec0d51ad45423c2687e6696fd29d11a10d9f74f58cb2b5c53904c6fcf7ae32","ab77ece9a3008c70eb6b2e1d7203e8b8d20fba6cc2eec5129fe5369d7e4c7137","84ab71b4d38306962fd5ecec6493c862a76b2d8f81c1d9771052022439f6704b","6b5270bd5984103cb780af558bd7e1e37ca637b0800b8fd89172a7221d34c97f","6066ed47fba2a8a6ed4dd8449514d2ec39241f62c647fa15f2a6dcb36e16dee7","f1641aae20ce81da6f022b724e82ac8de3ef4d815eb189ab8d704cc6db6ab7d4","c27b79849adcbe8f591df50e131d23861f290dc9c20cef1062ef7e2f46c7e876","252e4caeb6ba6b87b38fad18eb53210313af2f75cd75979e7ae4c0017e51effa","cfa031679ee05a8534e3ff8f0a5d5cb0d0ff684a323d570c6bc4ea607eb4f8e2","ffa69e648e1f3436f4b43abdc6f300ac08038a9aaf2e29f77a8de35051b8e01f","809cbc5ee1dddcea0577cfdd2fece3d454d3a70c85df6de8d437ecea9d033752","2ccf55a67953747d95121e933cf51e3fe3e7c2a2da6033cff65712f4360c9eff","a31f10005fb98db58975c34186af1e51bf305a7fc12dd78a8fa8b1787361accc","6047a343d957191169bfec649f62b3bb4462d0aa67fbd62c684e38f6161ec227","6e829a536c8763cfc43722c21f6f0e3a7dac7ce9578640b8e0dad904a29f91e4","4c193c6ee3fdec9a969a89e3a8ce2bc9dd3691b3ed46e1d2d07cff6ae55a5291","9f47f31d45bee81aa8893294abf8c3a885ccc656c3b77f2476243aa45a7dbcb0"],"paragraph_range_zero_based":[29784,29807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29784"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxRankSFN, maxRankSFN-DCI-0-2","paragraph_zero_based":29808},{"literal_text_all_w_t_and_m_t":"configure maximal number of MIMO layers of each panel in SFN scheme for codebook based PUSCH or for DCI 0_2 for codebook based PUSCH.","paragraph_zero_based":29809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29810},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH field descriptions","paragraph_zero_based":29811},{"literal_text_all_w_t_and_m_t":"betaOffsets","paragraph_zero_based":29812},{"literal_text_all_w_t_and_m_t":"Selection between and configuration of dynamic and semi-static beta-offset for DCI formats other than DCI format 0_2. If the field is not configured, the UE applies the value 'semiStatic' (see TS 38.213 [13], clause 9.3).","paragraph_zero_based":29813},{"literal_text_all_w_t_and_m_t":"scaling","paragraph_zero_based":29814},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI formats other than DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on. The value configured herein is applicable for PUSCH with configured grant (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":29815},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29816},{"literal_text_all_w_t_and_m_t":"UCI-OnPUSCH-DCI-0-2 field descriptions","paragraph_zero_based":29817},{"literal_text_all_w_t_and_m_t":"betaOffsetsDCI-0-2","paragraph_zero_based":29818},{"literal_text_all_w_t_and_m_t":"Configuration of beta-offset for DCI format 0_2. If semiStaticDCI-0-2 is chosen, the UE shall apply the value of 0 bit for the field of beta offset indicator in DCI format 0_2. If dynamicDCI-0-2 is chosen, the UE shall apply the value of 1 bit or 2 bits for the field of beta offset indicator in DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13] clause 9.3).","paragraph_zero_based":29819},{"literal_text_all_w_t_and_m_t":"dynamicDCI-0-2","paragraph_zero_based":29820},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'dynamic' for DCI format 0_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.3).","paragraph_zero_based":29821},{"literal_text_all_w_t_and_m_t":"semiStaticDCI-0-2","paragraph_zero_based":29822},{"literal_text_all_w_t_and_m_t":"Indicates the UE applies the value 'semiStatic' for DCI format 0_2. (see TS 38.212 [17], clause 7.3.1 and see TS 38.213 [13], clause 9.3).","paragraph_zero_based":29823},{"literal_text_all_w_t_and_m_t":"scalingDCI-0-2","paragraph_zero_based":29824},{"literal_text_all_w_t_and_m_t":"Indicates a scaling factor to limit the number of resource elements assigned to UCI on PUSCH for DCI format 0_2. Value f0p5 corresponds to 0.5, value f0p65 corresponds to 0.65, and so on (see TS 38.212 [17], clause 6.3).","paragraph_zero_based":29825},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29826},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29827},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29828},{"literal_text_all_w_t_and_m_t":"codebookBased","paragraph_zero_based":29829},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if txConfig is set to codebook and absent otherwise.","paragraph_zero_based":29830},{"literal_text_all_w_t_and_m_t":"RepTypeB","paragraph_zero_based":29831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b209d3f0a3865497db956a3e60ed5b3ee07cf19fc45eac59fa296f974da39