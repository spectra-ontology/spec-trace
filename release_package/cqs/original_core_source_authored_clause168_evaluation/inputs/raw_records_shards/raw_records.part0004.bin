{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    physCellId-r17                    PhysCellId,","paragraph_zero_based":47640},{"literal_text_all_w_t_and_m_t":"    carrierFreq-r17                   ARFCN-ValueNR                                  OPTIONAL  -- Need S","paragraph_zero_based":47641},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47642},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47643},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NEIGHBOURCELLLIST-STOP","paragraph_zero_based":47644},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47646},{"literal_text_all_w_t_and_m_t":"MBS-NeighbourCellList field descriptions","paragraph_zero_based":47647},{"literal_text_all_w_t_and_m_t":"carrierFreq","paragraph_zero_based":47648},{"literal_text_all_w_t_and_m_t":"Indicates the frequency of the neighbour cell indicated by physCellId. Absence of the IE means that the neighbour cell is on the same frequency as the current cell.","paragraph_zero_based":47649},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47650},{"literal_text_all_w_t_and_m_t":"–MBS-NonServingInfoList","paragraph_zero_based":47651},{"literal_text_all_w_t_and_m_t":"The IE MBS-NonServingInfoList is used to inform network of the frequencies, CFR information and subcarrier spacing for MBS broadcast reception on the non-serving cell.","paragraph_zero_based":47652},{"literal_text_all_w_t_and_m_t":"MBS-NonServingInfoList information element","paragraph_zero_based":47653},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47654},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-NONSERVINGINFOLIST-START","paragraph_zero_based":47655},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47656},{"literal_text_all_w_t_and_m_t":"MBS-NonServingInfoList-r18 ::=    SEQUENCE (SIZE (1..maxFreqMBS-r17)) OF NonServingInfo-r18","paragraph_zero_based":47657},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47658},{"literal_text_all_w_t_and_m_t":"NonServingInfo-r18 ::=            SEQUENCE {","paragraph_zero_based":47659},{"literal_text_all_w_t_and_m_t":"    freqInfoMBS-r18                   FreqInfoMBS-r18                                          OPTIONAL,","paragraph_zero_based":47660},{"literal_text_all_w_t_and_m_t":"    cfr-InfoMBS-r18                   CHOICE {","paragraph_zero_based":47661},{"literal_text_all_w_t_and_m_t":"        cfr-Bandwidth-r18                 INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":47662},{"literal_text_all_w_t_and_m_t":"        cfr-LocationAndBW-r18             CFR-LocationAndBW-r18","paragraph_zero_based":47663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["eb52d560b6b5d2582a007895b89e0f70135bc266429e4a0f1ad9182c652a2dba","f1a88efb04a4b449f56db7ea9a3fb0f783be75a81a4e64e7abcda4ccbcb38c22","a342a0ae6696f756db6ef32fb7b2894dbd5aeb29feecf211b618f52504f4ac2f","d6951f1418f52762d49a9c72e6b1b1ea696eac5826b477e44e15a96071910807","7fdf231d0c89c76275a56f063893988cdfac8da52865778efd783057836aa957","93500492afbdc891508b81d12f457efa065c60595af02c2c9f5854c94ceb3f08","952e159154e58e2d463a1de2bda2c6763e297a0ab825e9c1d2015d29c2f6ca70","d4a2cb1c25227ce982984e43fff97815db18602e833f88b2d7f31a14153b5dbf","4fb29595d2faddff71fc870ccf55429ede5605302f3bc72e1d0ed256663798d9","c2aefe97e331e48b629ba4e64f7c8f5e174d9a4f314e5525d1ab246892a951f7","16a04ae993a9c1816cfb495ebaa23cb17c0f07eba4b19769926e8d8814884965","2e301f323b00ed4b0b6e841990b596a33ea3780c49a7d82815fc2d924a88abe1","3259f2