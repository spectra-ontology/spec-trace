{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"scg-Response","paragraph_zero_based":12816},{"literal_text_all_w_t_and_m_t":"In case of NR-DC (nr-SCG-Response), this field includes the RRCReconfigurationComplete message. In case of NE-DC (eutra-SCG-Response), this field includes the E-UTRA RRCConnectionReconfigurationComplete message as specified in TS 36.331 [10].","paragraph_zero_based":12817},{"literal_text_all_w_t_and_m_t":"selectedCondRRCReconfig","paragraph_zero_based":12818},{"literal_text_all_w_t_and_m_t":"This field indicates the ID of the selected conditional reconfiguration the UE applied upon the execution of CPA or inter-SN CPC.","paragraph_zero_based":12819},{"literal_text_all_w_t_and_m_t":"selectedPSCellForCHO-WithSCG","paragraph_zero_based":12820},{"literal_text_all_w_t_and_m_t":"This field indicates the information of the selected target PSCell to target MN at execution of a conditional reconfiguration for CHO with candidate SCG(s).","paragraph_zero_based":12821},{"literal_text_all_w_t_and_m_t":"selectedSK-Counter","paragraph_zero_based":12822},{"literal_text_all_w_t_and_m_t":"This field includes the selected sk-counter value for security key update upon the execution of subsequent CPAC.","paragraph_zero_based":12823},{"literal_text_all_w_t_and_m_t":"uplinkTxDirectCurrentList","paragraph_zero_based":12824},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for the configured serving cells and BWPs if requested by the NW (see reportUplinkTxDirectCurrent in CellGroupConfig).","paragraph_zero_based":12825},{"literal_text_all_w_t_and_m_t":"uplinkTxDirectCurrentMoreCarrierList","paragraph_zero_based":12826},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for the configured intra-band CA requested by reportUplinkTxDirectCurrentMoreCarrier-r17.","paragraph_zero_based":