{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32832},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32833},{"literal_text_all_w_t_and_m_t":"–ScramblingId","paragraph_zero_based":32834},{"literal_text_all_w_t_and_m_t":"The IE ScramblingID is used for scrambling channels and reference signals.","paragraph_zero_based":32835},{"literal_text_all_w_t_and_m_t":"ScramblingId information element","paragraph_zero_based":32836},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32837},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-START","paragraph_zero_based":32838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32839},{"literal_text_all_w_t_and_m_t":"ScramblingId ::=                    INTEGER(0..1023)","paragraph_zero_based":32840},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32841},{"literal_text_all_w_t_and_m_t":"-- TAG-SCRAMBLINGID-STOP","paragraph_zero_based":32842},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32843},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32844},{"literal_text_all_w_t_and_m_t":"–SCS-SpecificCarrier","paragraph_zero_based":32845},{"literal_text_all_w_t_and_m_t":"The IE SCS-SpecificCarrier provides parameters determining the location and width of the actual carrier or the carrier bandwidth. It is defined specifically for a numerology (subcarrier spacing (SCS)) and in relation (frequency offset) to Point A.","paragraph_zero_based":32846},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier information element","paragraph_zero_based":32847},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32848},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-START","paragraph_zero_based":32849},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32850},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier ::=             SEQUENCE {","paragraph_zero_based":32851},{"literal_text_all_w_t_and_m_t":"    offsetToCarrier                     INTEGER (0..2199),","paragraph_zero_based":32852},{"literal_text_all_w_t_and_m_t":"    subcarrierSpacing                   SubcarrierSpacing,","paragraph_zero_based":32853},{"literal_text_all_w_t_and_m_t":"    carrierBandwidth                    INTEGER (1..maxNrofPhysicalResourceBlocks),","paragraph_zero_based":32854},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f157366f918ddd93925ba0d94043de76c003d000c98e735d83045639d8e84fab","aa2f4efb8d5702172f2adc9905251e7dc51012dc2ce4522437137e187161dd1d","552164738f2eb3f2202d523cab92c742f4c4908e073c18294ac1ec1da4987e7a","67b69602b701f11e115e0a6cd91622e0cd910bc363fd2c1f29f51ec47f24dde1","630c6f3cf7825064fd5e027968aea4aba685bd7598278ab05ace7ef9beaabc18","4cb11318d9bd5f79c0cdc05f873c2fe09dd680b992acc9aac2c1b40176319517","e178c41dca28d38e768ca9ebe319d74e9061e56f934ebeae0b9ea0bdc8ce05c6","2e3e416250f5b36a3f02657aa66e8e429e106702512358635f3dd898dd2fb9f0","a6c7d05f12ee39dd26a4134c35904664914cf1438c02ebed78cea2e18151be0c","b75f728369b60edc0fd0aa3c4eac8e776ad1ff8df4b2bc65b206c925d72601bd","3544c51aae1030e1db169cf55e940ad5df906ab95597cba740acab098e340528","68f7c520059bc0014a71236f513a8fed830f12eb47b91c2b05f75e1ec515d06b","422eb206e7c58c0e069308f4c0a190b6f395ffde4d3cf1e8da638a504fe212c7","01cf3d1192b59bb85fa54377682b4b131079a37afbced392d34821a6bd8cd68b","95d38d3cac1f63f3dff6466baab3f87ea06affc0b214d7b56c3d4220ab9abe8a","15718cedab04977ebbe525b70008a9400652f6d85cf52ef0b0031d0f57e8e689","88504f497595565ef279d60e8e6b9a538b85426f32f9bccbf24ed6ba14a85313","32c0fc6b934df7544455941a4cb7c9d4d2e5286e31a06f07339193ad2509ec7a","b2e09c3fa399f72faf2c4e8e61a129c9ea9ad8268330948b1924adfd465f9057","8f776797495ec0869eae977caea09275cc2404d2bb2569ce67ecbab6fab098b0","22c57edc8511a550ca7e4d52efe26ef200d7992b7b53b431a2728e05dfff6364","ba49d0db4f6b384c64950c7ce25027015437eb4521f9f380fae5503136bc1206","09229e710fc762e9ab7c2dfab6a951e2c8c1c0d26c22fe5cb75af19f27eefc7a","6832f6aa064945f3b3111f55dddfbb92aa5454d4783adff9cd2f8e169b99298a"],"paragraph_range_zero_based":[32832,32855],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32832"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32856},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation         INTEGER (0..4095)                                       OPTIONAL            -- Need S","paragraph_zero_based":32857},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":32858},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32860},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-STOP","paragraph_zero_based":32861},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32863},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier field descriptions","paragraph_zero_based":32864},{"literal_text_all_w_t_and_m_t":"carrierBandwidth","paragraph_zero_based":32865},{"literal_text_all_w_t_and_m_t":"Width of this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier) (see TS 38.211 [16], clause 4.4.2).","paragraph_zero_based":32866},{"literal_text_all_w_t_and_m_t":"offsetToCarrier","paragraph_zero_based":32867},{"literal_text_all_w_t_and_m_t":"Offset in frequency domain between Point A (lowest subcarrier of common RB 0) and the lowest usable subcarrier on this carrier in number of PRBs (using the subcarrierSpacing defined for this carrier). The maximum value corresponds to 275*8-1. See TS 38.211 [16], clause 4.4.2.","paragraph_zero_based":32868},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":32869},{"literal_text_all_w_t_and_m_t":"Indicates the downlink Tx Direct Current location for the carrier. A value in the range 0..3299 indicates the subcarrier index within the carrier. The values in the value range 3301..4095 are reserved and ignored by the UE. If this field is absent for downlink within ServingCellConfigCommon and ServingCellConfigCommonSIB, the UE assumes the default value of 3300 (i.e. \"Outside the carrier\"). (see TS 38.211 [16], clause 4.4.2). Network does not configure this field via ServingCellConfig or for uplink carriers.","paragraph_zero_based":32870},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":32871},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of this carrier. It is used to convert the offsetToCarrier into an actual frequency.","paragraph_zero_based":32872},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":32873},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":32874},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":32875},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":32876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32877},{"literal_text_all_w_t_and_m_t":"–SDAP-Config","paragraph_zero_based":32878},{"literal_text_all_w_t_and_m_t":"The IE SDAP-Config is used to set the configurable SDAP parameters for a data radio bearer. All configured instances of SDAP-Config with the same value of pdu-Session correspond to the same SDAP entity as specified in TS 37.324 [24].","paragraph_zero_based":32879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b31b8dd6fc6d7cdad6de000f1ec8131538f95c438cdd93dd6b98773243197efe","c4f895575da1ab501d5ed56e78b7ddcf30fbb751b3f833ddd47a687b730e3d87","d1b6b5b0307c706cf8d9bc4127bb6bca00b099a1960f11203b0ebbda903a3202","f1ad6e7ad4d93a0c99450c267972e5681170372b95a5e16f63f8f11379e04db2","eb92402c2d7abf88ca39beb75cb8cf38162614b228cc2bcf708488aa477f9f23","edaab59ce810ad1adda0da4cb86a9516543afff1303300e411b5459cb402e382","0a00c3978557ff889d814c35757cf392384b2436084f71bbaed8202ce352132f","67ed6a74d3b845152c2a4c3a9165cc907e955238a81c6dfcaeb71f9b5d63b0c5","7d7cf291940738a565f5b3433f189900588e0de005344af0a03ca80c235c3765","7e874d6503e683ae96b5326b74ea50fcac9d567205f0223e8b711558425929fe","22a5e422710598fe00d59d761629d3cebb3baeddd436198faa7fcaef81ce83c7","0e1220f29b918ec42707b4ea7cc4c690a6ed133937ae76195b746ec81c95741c","464dc0c7656a77500f8abe7adcc7928060c4312b3e40a8525a254c3c88eb27db","883b386c83958b9127c1e81e4424784e125fd2ee59e3db8530e4c13b8119fd81","699739bfadb83847f2bf68e8d5937a35fb2b1e03bcba516f01a74126626de596","93f1e140232a7425c52aa0eb9bb950976d25a298658072a429de3855cf925dee","1198a5e8fef94089d558811e3c01b3df865222e46fe7e67944ff375b5141b53e","d8857c695def8d0318e8b0540b9af75d2192618bd27ef4d15d8bbca366e1d312","4660415f2d115aee55e665d1679e9bd9be68715eda43f61693df6486bd67d791","86d56d84a37e4af31ef5a0a512bb2507a0a4e3953c05c46d0ee3a12c6553459a","9ace960336d486fe24c920b54bc14e6d420e5e435d3d5014577ddaeb183c8d96","ea3ec367365dc85a80840e2b8c00a40f91d1ddbd4db083df49cc37ee87289c9e","6ee1d7356ac236d59b6dce8b281f5bb00cc631469820f4e259f0207036919ecb","ad6ed81231694d07213d3ce2c5d523e06c5a3f07bbcd0108ff4dcfbdb142f171"],"paragraph_range_zero_based":[32856,32879],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32856"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SDAP-Config information element","paragraph_zero_based":32880},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32881},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-START","paragraph_zero_based":32882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32883},{"literal_text_all_w_t_and_m_t":"SDAP-Config ::=                     SEQUENCE {","paragraph_zero_based":32884},{"literal_text_all_w_t_and_m_t":"    pdu-Session                         PDU-SessionID,","paragraph_zero_based":32885},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderDL                       ENUMERATED {present, absent},","paragraph_zero_based":32886},{"literal_text_all_w_t_and_m_t":"    sdap-HeaderUL                       ENUMERATED {present, absent},","paragraph_zero_based":32887},{"literal_text_all_w_t_and_m_t":"    defaultDRB                          BOOLEAN,","paragraph_zero_based":32888},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToAdd                SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":32889},{"literal_text_all_w_t_and_m_t":"    mappedQoS-FlowsToRelease            SEQUENCE (SIZE (1..maxNrofQFIs)) OF QFI                                 OPTIONAL, -- Need N","paragraph_zero_based":32890},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32891},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32893},{"literal_text_all_w_t_and_m_t":"-- TAG-SDAP-CONFIG-STOP","paragraph_zero_based":32894},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32895},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32896},{"literal_text_all_w_t_and_m_t":"SDAP-Config field descriptions","paragraph_zero_based":32897},{"literal_text_all_w_t_and_m_t":"defaultDRB","paragraph_zero_based":32898},{"literal_text_all_w_t_and_m_t":"Indicates whether or not this is the default DRB for this PDU session. Among all configured instances of SDAP-Config with the same value of pdu-Session, this field shall be set to true in at most one instance of SDAP-Config and to false in all other instances.","paragraph_zero_based":32899},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToAdd","paragraph_zero_based":32900},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of UL QoS flows of the PDU session to be additionally mapped to this DRB. A QFI value can be included at most once in all configured instances of SDAP-Config with the same value of pdu-Session. For QoS flow remapping, the QFI value of the remapped QoS flow is only included in mappedQoS-FlowsToAdd in sdap-Config corresponding to the new DRB and not included in mappedQoS-FlowsToRelease in sdap-Config corresponding to the old DRB.","paragraph_zero_based":32901},{"literal_text_all_w_t_and_m_t":"mappedQoS-FlowsToRelease","paragraph_zero_based":32902},{"literal_text_all_w_t_and_m_t":"Indicates the list of QFIs of QoS flows of the PDU session to be released from existing QoS flow to DRB mapping of this DRB. ","paragraph_zero_based":32903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3b299a1232cb767842988b7584ef16a32c93f3d242045b87ac91a7e575da39aa","e44ca27ad014f56f53ccbf4f729bc9b7f71dbacb3921b866124d60524712a04f","bfc09d15b1ca17537f17d2d2f8d595b0d446ae3195b3257973b048643bb0f32e","4fa53e34369e75d98ee9b4de760397e94ac3fec967a37c27ddc11c7b4fab9b66","3756e3f65e896a9a4db759d2013a3085af92afc6fceaae8e1c1d033720b