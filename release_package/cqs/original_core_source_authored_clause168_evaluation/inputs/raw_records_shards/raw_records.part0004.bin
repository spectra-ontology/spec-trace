{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-DataToUL-ACK-MulticastDCI-Format4-1","paragraph_zero_based":29112},{"literal_text_all_w_t_and_m_t":"List of timing for given group-common PDSCH to the DL ACK (see TS 38.213 [13], clause 9.1.2). The field dl-DataToUL-ACK-MulticastDciFormat4-1 applies to DCI format 4_1 for MBS multicast (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":29113},{"literal_text_all_w_t_and_m_t":"dmrs-BundlingPUCCH-Config","paragraph_zero_based":29114},{"literal_text_all_w_t_and_m_t":"Configuration of the parameters for DMRS bundling for PUCCH (see TS 38.214 [19], clause 6.1.7). DMRS bundling for PUCCH is not supported for PUCCH format 0/2. In this release, this is not applicable to FR2-2.","paragraph_zero_based":29115},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecodingPUCCH","paragraph_zero_based":29116},{"literal_text_all_w_t_and_m_t":"This field is used for PUCCH formats 3 and 4 according to TS 38.211, Clause 6.4.1.3.3.1.","paragraph_zero_based":29117},{"literal_text_all_w_t_and_m_t":"format0","paragraph_zero_based":29118},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 0.","paragraph_zero_based":29119},{"literal_text_all_w_t_and_m_t":"format1","paragraph_zero_based":29120},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 1.","paragraph_zero_based":29121},{"literal_text_all_w_t_and_m_t":"format2","paragraph_zero_based":29122},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 2.","paragraph_zero_based":29123},{"literal_text_all_w_t_and_m_t":"format3","paragraph_zero_based":29124},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 3.","paragraph_zero_based":29125},{"literal_text_all_w_t_and_m_t":"format4","paragraph_zero_based":29126},{"literal_text_all_w_t_and_m_t":"Parameters that are common for all PUCCH resources of format 4.","paragraph_zero_based":29127},{"literal_text_all_w_t_and_m_t":"mappingPattern","paragraph_zero_based":29128},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE should follow Cyclical mapping pattern or Sequential mapping pattern for when a PUCCH resource used for repetitions of a PUCCH transmission includes first and second spatial settings for FR2, or first and second sets of power control parameters for FR1 (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":29129},{"literal_text_all_w_t_and_m_t":"numberOfBitsForPUCCH-ResourceIndicatorDCI-1-2","paragraph_zero_based":29130},{"literal_text_all_w_t_and_m_t":"Configuration of the number of bits for \"PUCCH resource indicator\" in DCI format 1_2 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.2.3).","paragraph_zero_based":29131},{"literal_text_all_w_t_and_m_t":"powerControlSetInfoToAddModList","paragraph_zero_based":29132},{"literal_text_all_w_t_and_m_t":"Configures power control sets for repetition of a PUCCH transmission in FR1. This field is not configured if ul-powerControl is configured in the BWP-UplinkDedicated in which the PUCCH-Config is included.","paragraph_zero_based":29133},{"literal_text_all_w_t_and_m_t":"pucch-PowerControl","paragraph_zero_based":29134},{"literal_text_all_w_t_and_m_t":"Configures power control parameters PUCCH transmission. This field is not configured if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":29135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b7e70e1f75e11b8bc56ef8ee6f5f81490e05f73df300f4d18df25e1eb2198514","773ef60b8e510645e2f73d9a176c471039ebe5b62867f80b0c4f3516d6360b51","23c857d2e8af635cbbe5946ebdc456fe98c67628d05006a78577c2111396799b","93e6f2807abcf5e155a5e75b57b4d4efe96bca17a3d18a6f41d2bd5323ce3bb6","ab641aeb3982e582eab05f737c0bfb6966a26832190fdf1d5ce7acbdfad9cb78","2dd7ef3cfe38491ed9b9fec59f4193f787dbd1d5a61fa9caa365304fdc04b395","17dec176dca3a8282b995fe2c16b73b3c84428f410af23413f3707d54e11dd22","422baf0002a6f74b0634206c1ea6cb9d780f93c4f56f321e117d57c0600abe08","f5b61a482afb77241e743d84bb8a4ee46f75733896e6d80bb626a60f50c93827","06764381e825da02a9373117d996684c39ceca358b670c271880f8afd51280e7","551a86189fda84bc803fa5976f3e11aac822866564907cc3b4ad1d24ea4b81eb","1dde9afb4709c05f4e6583e2c2641fe00dbe5ae7448951d6ddb5432d4813e7bf","8f4217b7a92091eb53fbdfa8866512d282aabdab5eef82c78562f159bd008071","3774b6e24221e38793e9b41e9d0c7f39ccc4ce672bf0565e4323a11ac48eae88","4b974452ceb3b8fc7cb59b2e7212e621e475c356bddc098213085d8dd3dfdd1e","38e8389bce0b82ed2340a7caafb4a1d39c797dde119663162ee171676cb7d79f","862c08bc55d269d07b7294d6ed9db9494da4307c056fb24dc22845810668c03a","d4cf13f96d1f9dc5690b5d0416e84d8dea313b97fb8b63bc67a6ee5eb7cc0994","23d683faedb083385e87a7a14359f03a04ee33e5e1b4220e9660735038a39f4b","06f3ee9e3c764c3121bacab8be82138c5196972032d2f4e7284d6c30cbbf3073","88004d758998928cc47ba9ffb4bd462771785b78a816de3bd941dc1d548da301","0402fe2bffecacc5f1d818e748beeff9ef19d77c937dbf203ad78709d504dc9b","87c2da40e86be7d3e54247e0a4ec2bfa40457cbd397f5f009ddde08359dbbc04","70004db3d5eb348b6ce8e16609f0cc1bd5b0fc13b4732f0868a508159a36b9f1"],"paragraph_range_zero_based":[29112,29135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29112"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"resourceGroupToAddModList, resourceGroupToReleaseList","paragraph_zero_based":29136},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing groups of PUCCH resources that can be updated simultaneously for spatial relations with a MAC CE.","paragraph_zero_based":29137},{"literal_text_all_w_t_and_m_t":"resourceSetToAddModList, resourceSetToReleaseList","paragraph_zero_based":29138},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resource sets (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":29139},{"literal_text_all_w_t_and_m_t":"resourceToAddModList, resourceToAddModListExt, resourceToReleaseList","paragraph_zero_based":29140},{"literal_text_all_w_t_and_m_t":"Lists for adding and releasing PUCCH resources applicable for the UL BWP and serving cell in which the PUCCH-Config is defined. The resources defined herein are referred to from other parts of the configuration to determine which resource the UE shall use for which report. If the network includes of resourceToAddModListExt, it includes the same number of entries, and listed in the same order, as in resourceToAddModList.","paragraph_zero_based":29141},{"literal_text_all_w_t_and_m_t":"secondTPCFieldDCI-1-1, secondTPCFieldDCI-1-2","paragraph_zero_based":29142},{"literal_text_all_w_t_and_m_t":"A second TPC field can be configured via RRC for DCI-1-1 and DCI-1-2. Each TPC field is for each closed-loop index value respectively (i.e., 1st /2nd TPC fields correspond to \"closedLoopIndex\" value = 0 and 1.","paragraph_zero_based":29143},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToAddModList, spatialRelationInfoToAddModListSizeExt , spatialRelationInfoToAddModListExt","paragraph_zero_based":29144},{"literal_text_all_w_t_and_m_t":"Configuration of the spatial relation between a reference RS and PUCCH. Reference RS can be SSB/CSI-RS/SRS. If the list has more than one element, MAC-CE selects a single element (see TS 38.321 [3], clause 5.18.8 and TS 38.213 [13], clause 9.2.2). The UE shall consider entries in spatialRelationInfoToAddModList and in spatialRelationInfoToAddModListSizeExt as a single list, i.e. an entry created using spatialRelationInfoToAddModList can be modified using spatialRelationInfoToAddModListSizeExt (or deleted using spatialRelationInfoToReleaseListSizeExt) and vice-versa. If the network includes spatialRelationInfoToAddModListExt, it includes the same number of entries, and listed in the same order, as in the concatenation of spatialRelationInfoToAddModList and of spatialRelationInfoToAddModListSizeExt. If unifiedTCI-StateType is configured for the serving cell, no element in this list is configured.","paragraph_zero_based":29145},{"literal_text_all_w_t_and_m_t":"spatialRelationInfoToReleaseList, spatialRelationInfoToReleaseListSizeExt, spatialRelationInfoToReleaseListExt","paragraph_zero_based":29146},{"literal_text_all_w_t_and_m_t":"Lists of spatial relation configurations between a reference RS and PUCCH to be released by the UE.","paragraph_zero_based":29147},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-List","paragraph_zero_based":29148},{"literal_text_all_w_t_and_m_t":"Indicates a list of PUCCH resources for DL SPS HARQ ACK. The field maxPayloadSize is absent for the first and the last SPS-PUCCH-AN in the list. If configured, this overrides n1PUCCH-AN in SPS-config.","paragraph_zero_based":29149},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-ListMulticast","paragraph_zero_based":29150},{"literal_text_all_w_t_and_m_t":"The field is used to configure the list of PUCCH resources per HARQ ACK codebook for MBS multicast.","paragraph_zero_based":29151},{"literal_text_all_w_t_and_m_t":"subslotLengthForPUCCH","paragraph_zero_based":29152},{"literal_text_all_w_t_and_m_t":"Indicates the sub-slot length for sub-slot based PUCCH feedback in number of symbols (see TS 38.213 [13], clause 9). Value n2 corresponds to 2 symbols, value n6 corresponds to 6 symbols, value n7 corresponds to 7 symbols. For normal CP, the value is either n2 or n7. For extended CP, the value is either n2 or n6.","paragraph_zero_based":29153},{"literal_text_all_w_t_and_m_t":"ul-AccessConfigListDCI-1-1, ul-AccessConfigListDCI-1-2","paragraph_zero_based":29154},{"literal_text_all_w_t_and_m_t":"List of the combinations of cyclic prefix extension and UL channel access type (see TS 38.212 [17], clause 7.3.1) applicable, respectively, to DCI format 1_1 and DCI format 1_2. The fields ul-AccessConfigListDCI-1-1-r16 and ul-AccessConfigListDCI-1-2-r17 are only applicable for FR1 (see TS 38.212 [17], Table 7.3.1.2.2-6). The field ul-AccessConfigListDCI-1-1-r17 indicates a list which only contains UL channel access types and is only applicable for FR2-2 (see TS 38.212 [17], Table 7.3.1.2.2-6A).","paragraph_zero_based":29155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29156},{"literal_text_all_w_t_and_m_t":"PUCCH-format3 field descriptions","paragraph_zero_based":29157},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":29158},{"literal_text_all_w_t_and_m_t":"The supported values are 1,2,3,4,5,6,8,9,10,12,15 and 16. The UE shall ignore this field when format-v1610 is configured.","paragraph_zero_based":29159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4f96cb90e6c364c802bd66b6598d8879a2f8336d3a2c6d46eb1e0ff89611fc40","3376598691b2756bc22e53071aa5fdfb92584983cba426e86bfe42d57205e928","823dc31d04e6b2f85abc2f59ddae280e9901e7a045fe0684784760e423a01983","02f0ff2bf68bb2218cd2a1a80316f73fb7cc040946663bacf5977a4b32681d6e","f9d979810b7a181d21d45248b6b089330e84d6fe27b7474cd81308a3efc5270f","ab3751a86b7196373b5a4b764c72a0dad2e2f9857196fb9d4e570ef00945ec8b","536d34aff8c4b10b0d800627940823f86b493786c08b48c9b9a284000c5fcb36","b9318ab38b0ce569bfbd4364afac41e4d5b1e982f3f4e47e899f335b2e8f9794","de72addaed83de95e73a19d67a1c870954735ca9934763c090609ceb58a0f4c4","ba92afc5cb2de18fa85c37a441c8a0d7892a609f8b324a4563dc117dd4b3c7b7","b8ae0b1eb5993b3e66b7d1b9d07ee9c7769bb59de0691a272cb8f894cf5d3331","5bf8868c6b360a864a3a7ce1603cbbf50f5a3b74ab7588a2e3cdb8252bcea337","a1e7529626d91984dfe36c771179991cdd6d731caf1d958875b2aa42519af79d","8e9b11468d5642c564188c87aa2ce54c3b3d5a92a33249402d1c1e394ec0a02d","d3f739c2df6a6ec68826e0553b80c4d76dd82e15fa19ad17a21621bc9fcea3a2","dba55328b7c0bd3eb827a6df5beff6605d71ba99dbc3258d038cf1fb84e83114","ba2addc09100160e2279e8e2ac20b80d6613be73c0849bf0a20a42762297f3dd","70c1ee791d2c72eb1dc3a185413d348bfa2efdc162c8677c92f2d251a0754457","9cccae542d710cf7780cb600b91e0981c9f26ff7d5d893656326cb6e0e305b9f","8f0452ad2cfe40039a86b1d930f18ca1e34dbd04f90bbc6b8ead78fa35b54c69","3367836525999b42392c842e417a1dd21e0045cfb723600f97791e453d7dd3c1","b04883fb054cf121ddd48c8de30bd7ceb8cd883dd4c9c673e74a842479496fb2","8142af1ad93b23eb08f59a838d7c01c9f26aefeb4bd04ca175a7b0896307ad16","6e98b6455e48194f39a5e7a45ebe251631f9b2c0e73746bacc0ff9e2f486823d"],"paragraph_range_zero_based":[29136,29159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29136"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29160},{"literal_text_all_w_t_and_m_t":"PUCCH-FormatConfig, PUCCH-FormatConfigExt field descriptions","paragraph_zero_based":29161},{"literal_text_all_w_t_and_m_t":"additionalDMRS","paragraph_zero_based":29162},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables 2 DMRS symbols per hop of a PUCCH Format 3 or 4 if both hops are more than X symbols when FH is enabled (X=4). And it enables 4 DMRS symbols for a PUCCH Format 3 or 4 with more than 2X+1 symbols when FH is disabled (X=4). The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.2.","paragraph_zero_based":29163},{"literal_text_all_w_t_and_m_t":"interslotFrequencyHopping","paragraph_zero_based":29164},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE enables inter-slot frequency hopping when PUCCH Format 0, 1, 2, 3 or 4 is repeated over multiple slots. For a PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":29165},{"literal_text_all_w_t_and_m_t":"maxCodeRate","paragraph_zero_based":29166},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":29167},{"literal_text_all_w_t_and_m_t":"maxCodeRateLP","paragraph_zero_based":29168},{"literal_text_all_w_t_and_m_t":"Max coding rate to determine how to feedback UCI on PUCCH for format 2, 3 or 4. The field is not applicable for format 0 and 1. This field configures additional max code rate in the second entry of PUCCH-ConfigurationList-r16 for multiplexing low-priority (LP) HARQ-ACK and high-priority (HP) UCI in a PUCCH as described Clause 9.2.5.3 of TS 38.213 [13]. The field is absent for the first entry of PUCCH-ConfigurationList-r16.","paragraph_zero_based":29169},{"literal_text_all_w_t_and_m_t":"nrofSlots","paragraph_zero_based":29170},{"literal_text_all_w_t_and_m_t":"Number of slots with the same PUCCH. When the field is absent the UE applies the value n1. See TS 38.213 [13], clause 9.2.6.","paragraph_zero_based":29171},{"literal_text_all_w_t_and_m_t":"pi2BPSK","paragraph_zero_based":29172},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses pi/2 BPSK for UCI symbols instead of QPSK for PUCCH. The field is not applicable for format 0, 1 and 2. See TS 38.213 [13], clause 9.2.5.","paragraph_zero_based":29173},{"literal_text_all_w_t_and_m_t":"rb-SetIndex","paragraph_zero_based":29174},{"literal_text_all_w_t_and_m_t":"Indicates the RB set where PUCCH resource is allocated.","paragraph_zero_based":29175},{"literal_text_all_w_t_and_m_t":"simultaneousHARQ-ACK-CSI","paragraph_zero_based":29176},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses simultaneous transmission of CSI and HARQ-ACK feedback with or without SR with PUCCH Format 2, 3 or 4. See TS 38.213 [13], clause 9.2.5. When the field is absent the UE applies the value off. The field is not applicable for format 0 and 1.","paragraph_zero_based":29177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29178},{"literal_text_all_w_t_and_m_t":"PUCCH-Resource, PUCCH-ResourceExt field descriptions","paragraph_zero_based":29179},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":29180},{"literal_text_all_w_t_and_m_t":"This field indicates, for PUCCH transmission(s) corresponding to this PUCCH resource, if UE applies the first, the second or both \"indicated\" UL only TCI or joint TCI as specified in TS 38.213 9.2.2. For PUCCH resources belonging to a PUCCH group, network configures same value. If more than one value for the field coresetPoolIndex is configured in IE controlResourceSet for the BWP, the value 'first' corresponds to the \"indicated\" joint/UL TCI states specific to coresetPoolIndex value 0 and the value 'second' corresponds to the value 1, respectively. In this case, network does not configure the value 'both'.","paragraph_zero_based":29181},{"literal_text_all_w_t_and_m_t":"format","paragraph_zero_based":29182},{"literal_text_all_w_t_and_m_t":"Selection of the PUCCH format (format 0 – 4) and format-specific parameters, see TS 38.213 [13], clause 9.2. format0 and format1 are only allowed for a resource in a first PUCCH resource set. format2, format3 and format4 are only allowed for a resource in non-first PUCCH resource set. The network can only configure format-v1610 when format is set to format2 or format3. The network only configures format-v1700 when format is set to format0, format1 or format4.","paragraph_zero_based":29183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e8a1fc0b11be8763c223adbf6fb59ad9fd833c281d57328643a91619de013480","563470b069f4027795fc466a1c9499369f3c7ad951c695c3418940299b0c74cd","2fb0837cadb10020829d9a8bc30fdff177d7b883d6a6859f9d087589c2e4a108","6f6c6f5756d05c6c7c0618feb4a2507c87a8f651119d8a62c977545e854d2519","8639e531a2e36f55255ac08a9f1fa4e3825465ab2f0b12a3a256d137722efe33","eb6ab69d60c902d7e9c7af421da0203d175cb19bf660de24ca33b37dd22cd44c","10ac63647a4ed8d04c99a075e27188883706965d3dafd792f541415508949d2f","dfb10ad3f6b3efa06247fddf0b0cf6042646d415efee87328132155288074c01","5998cf7e17b79a6d9b7c6a0adf697da8dead514b0a07470b4d7dcc6c94a163af","20b682a7c235d78f0adf903f2940ceb9aac1c5a61a25aabfeaa136af77fa6af3","876b5e64cee6409458c903ad0fc8dc9a9795ced7d42128bd79d623f8a1331198","0cfedb7af73a94b2121789937841b5a6e0f42734f3cde709cf479dc797bb58c3","3680548644475b5942d2fd5b9939069aae48dbf42665725436d4156b24e8943f","1ff0b8480751ad105095bba13d1d0b51cfd2da6c469abbfeda70f8fcb7b67513","38dea65fe5edf4a23e93253c6ff3c6b2f5a3f52841ecfcda7d86eaaf86bfe7f8","adbf9a7eb7efbd7e4b5198d472c4620fb1b9ae25c0b6766365e6e23ceefa24b5","4ba1444fa832ad3b57d180c8022af58d5f19195fb1c3a0969b124cb92880db33","95808ca8b94558b80b357a47e29cfa5fbb210457c5d88f0520aeca1c99ec11a0","c506737e4d35a1c506242585ef7c368cd4a8ec60e0440b02ac620143ed836d2c","0e770e77cc0bd7ce5b21ef616e91e7ab1ce5714099d22e3f8f1f270ee72a4c06","9c54da889fdaa158c3bfd7e8a41de6aec847fbc507ada9af69f7e24dbc626ff0","9a2f4cd364a8ed7f391afc1ea9cb823aa344adbbbbd8e214ccfb2bc51a296a11","cce15fed1ef575e36a7205065f01a04a2b3df7f559874460f58f39a251df505c","2d466e02843b9fbaaa3b3538ade69773adda976446554c7563c61e9899409ea2"],"paragraph_range_zero_based":[29160,29183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29160"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"interlace0","paragraph_zero_based":29184},{"literal_text_all_w_t_and_m_t":"This is the only interlace of interlaced PUCCH Format 0 and 1 and the first interlace for interlaced PUCCH Format 2 and 3.","paragraph_zero_based":29185},{"literal_text_all_w_t_and_m_t":"interlace1","paragraph_zero_based":29186},{"literal_text_all_w_t_and_m_t":"A second interlace, in addition to interlace 0, as specified in TS 38.213 [13], clause 9.2.1. For 15kHz SCS, values {0..9} are applicable; for 30kHz SCS, values {0..4} are applicable. For 15kHz SCS, the values of interlace1 shall satisfy interlace1=mod(interlace0+X,10) where X=1, -1, or 5.","paragraph_zero_based":29187},{"literal_text_all_w_t_and_m_t":"intraSlotFrequencyHopping","paragraph_zero_based":29188},{"literal_text_all_w_t_and_m_t":"Enabling intra-slot frequency hopping, applicable for all types of PUCCH formats. For long PUCCH over multiple slots, the intra and inter slot frequency hopping cannot be enabled at the same time for a UE. See TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":29189},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":29190},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for the PUCCH format, see TS 38.213 [13], clause 9.2.1. This field is applicable for PUCCH format0, format1, and format4 in FR2-2. The supported values for format4 are 1,2,3,4,5,6,8,9,10,12,15 and 16.","paragraph_zero_based":29191},{"literal_text_all_w_t_and_m_t":"multipanelSFN-Scheme","paragraph_zero_based":29192},{"literal_text_all_w_t_and_m_t":"Parameter to configure multiple panel simultaneous uplink transmission SFN scheme for PUCCH resources, see TS 38.214 [19] clause 6.1.1.","paragraph_zero_based":29193},{"literal_text_all_w_t_and_m_t":"occ-Index","paragraph_zero_based":29194},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code index (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":29195},{"literal_text_all_w_t_and_m_t":"occ-Length","paragraph_zero_based":29196},{"literal_text_all_w_t_and_m_t":"Indicates the orthogonal cover code length (see TS 38.213 [13], clause 9.2.1). This field is applicable when useInterlacePUCCH-PUSCH-16 is configured.","paragraph_zero_based":29197},{"literal_text_all_w_t_and_m_t":"pucch-RepetitionNrofSlots","paragraph_zero_based":29198},{"literal_text_all_w_t_and_m_t":"Configuration of PUCCH repetition factor per PUCCH resource with associated scheduling DCI corresponding to Rel-17 dynamic PUCCH repetition. For a PUCCH resource, if both the field pucch-RepetitionNrofSlots and the field nrofSlots are present, the field nrofSlots is ignored and apply the value of pucch-RepetitionNrofSlots corresponding to Rel-17 dynamic PUCCH repetition. If this field is absent in a PUCCH resource with associated scheduling DCI, the UE applies the value of field nrofSlots.","paragraph_zero_based":29199},{"literal_text_all_w_t_and_m_t":"pucch-ResourceId","paragraph_zero_based":29200},{"literal_text_all_w_t_and_m_t":"Identifier of the PUCCH resource.","paragraph_zero_based":29201},{"literal_text_all_w_t_and_m_t":"secondHopPRB","paragraph_zero_based":29202},{"literal_text_all_w_t_and_m_t":"Index of first PRB after frequency hopping of PUCCH. This value is applicable for intra-slot frequency hopping (see TS 38.213 [13], clause 9.2.1) or inter-slot frequency hopping (see TS 38.213 [13], clause 9.2.6).","paragraph_zero_based":29203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29204},{"literal_text_all_w_t_and_m_t":"PUCCH-ResourceSet field descriptions","paragraph_zero_based":29205},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":29206},{"literal_text_all_w_t_and_m_t":"Maximum number of UCI information bits that the UE may transmit using this PUCCH resource set (see TS 38.213 [13], clause 9.2.1). In a PUCCH occurrence, the UE chooses the first of its PUCCH-ResourceSet which supports the number of bits that the UE wants to transmit. The field is absent in the first set (Set0) and in the last configured set since the UE derives the maximum number of UCI information bits as specified in TS 38.213 [13], clause 9.2.1. This field can take integer values that are multiples of 4.","paragraph_zero_based":29207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2370937cf33255f01b76fcae5087008c3f5bbccf62ecf49cc38df23625ab6448","966cc94a9d2a66b0ef6bf0022c33ccfe81535c6e49b8b5b35dcf8b91931d7afe","d72b818be2c62ee35aeb88257293a0169130a398a763ca325de2a92803d194d2","1d6c8aa1584332e1a29794f9bb196a876b54396708644ce22f9e3bd4416c1747","466f613a3588e6e62e82474a7c6cb526653bfb2ba539f43a5364c23627b82477","922bcee3021a43157a03aeb885154ce0d5a76c0b010c9b93bc4d0ee0e528988b","7a2709babce61e5157ad9a0ea237d51f6fa9161cfd864f85c7d88ba1bb29a34c","3c43105bcedef67ae7868dc223190cfc5df6ec11904af4be45e9d64d4f81b274","5ad247a6803cccd0d9e0a0ef86e25b534cde73ec058bcec41b7fadc5da59e333","de1421ffe34a4a445a6ea2bc7fc3bab756d789648f455c4146c1a73be1de5f1a","8aec64b274e266d38ce6e33557154202af88ecc530d4f0ff00e11d7235fba131","380227bb78e902047a700341bc857b37ddb7424f82a674fe5d9809918cfa9340","fd8ed4fe5c8c658471c059ebc7f255c9857da83a5bdfcdbfb7d6093f341f9600","53cc900c3a297a2224717da68c0f0fec44e3754000947ed6f2e8845e4421e808","f41bd84549ea927cede0c916756665c9a2db79d6d6f750eecbe65652d133d778","376f0d76a22cfefb25a42f659de0e0356b501a1f06d4cbe6ac7335c01cc01b6e","ea8c490adaa4706d96931f45f4011b9522ad5c4421dd50ed6eee4e9eeb742c5c","cba07b7d98ab2488cae1aaef5edaccd039ac5307caf741ecfcac780518f03500","27a7a048ef39874cc481abc9514b94e115802a2fbae7e484951b7c948d0e8f2f","2da32c0acd5e4cec5183e10c5dcdba1fd8246d307e00fce129b76644cecd991a","3348d7557938bb63843cd07d543b79c9a19e8d3efa97c43df51a5f2b4d483576","52394c48a21a49fe18dc1ac62311292c35c0e7bbd34de2b591358a8a40601e64","fa1d4c5480fbff43bd4c77af7d70962c9ed7e603c58adfa00b9675f42da0959f","b8ad7fdb473ef6d2827a2803d7e9d21ba76c7420c2947259c44a856cd2f41e4f"],"paragraph_range_zero_based":[29184,29207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"resourceList","paragraph_zero_based":29208},{"literal_text_all_w_t_and_m_t":"PUCCH resources of format0 and format1 are only allowed in the first PUCCH resource set, i.e., in a PUCCH-ResourceSet with pucch-ResourceSetId = 0. This set may contain between 1 and 32 resources. PUCCH resources of format2, format3 and format4 are only allowed in a PUCCH-ResourceSet with pucch-ResourceSetId > 0. If present, these sets contain between 1 and 8 resources each. The UE chooses a PUCCH-Resource from this list as specified in TS 38.213 [13], clause 9.2.3. Note that this list contains only a list of resource IDs. The actual resources are configured in PUCCH-Config.","paragraph_zero_based":29209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29210},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29211},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29212},{"literal_text_all_w_t_and_m_t":"PI2-BPSK","paragraph_zero_based":29213},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if format3 and/or format4 are configured and pi2BPSK is configured in each of them. It is absent, Need R otherwise.","paragraph_zero_based":29214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29215},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigCommon","paragraph_zero_based":29216},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigCommon is used to configure the cell specific PUCCH parameters.","paragraph_zero_based":29217},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon information element","paragraph_zero_based":29218},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29219},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-START","paragraph_zero_based":29220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29221},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon ::=              SEQUENCE {","paragraph_zero_based":29222},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommon                INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-Only","paragraph_zero_based":29223},{"literal_text_all_w_t_and_m_t":"    pucch-GroupHopping                  ENUMERATED { neither, enable, disable },","paragraph_zero_based":29224},{"literal_text_all_w_t_and_m_t":"    hoppingId                           INTEGER (0..1023)                                    OPTIONAL,   -- Need R","paragraph_zero_based":29225},{"literal_text_all_w_t_and_m_t":"    p0-nominal                          INTEGER (-202..24)                                   OPTIONAL,   -- Need R","paragraph_zero_based":29226},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29227},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29228},{"literal_text_all_w_t_and_m_t":"    nrofPRBs                            INTEGER (1..16)                                      OPTIONAL,   -- Need R","paragraph_zero_based":29229},{"literal_text_all_w_t_and_m_t":"    intra-SlotFH-r17                    ENUMERATED {fromLowerEdge, fromUpperEdge}            OPTIONAL,   -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":29230},{"literal_text_all_w_t_and_m_t":"    pucch-ResourceCommonRedCap-r17     INTEGER (0..15)                                      OPTIONAL,   -- Cond InitialBWP-RedCap","paragraph_zero_based":29231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d88eceab7ccea4377f5c5c9adebb8eba95e9c7606801760a5921c4b826740832","03152c7f6b1dc6159032fad5a7430acd9e4572111e0c321125f9000747be9129","cda110ca070403066a7d59cfabb09487c2a4ded7687695545d3a95a3e3e27f77","08f8cce7b4768915de1b21a8da3c9c4b16388a4a4f929754d7b92647eb89a895","55e09f6b41ee8c49ad7ab845cca4c8cab0b2745930c7a3cf02a87cfd796c4d95","3109dbac178c637b1a0c18525e5f823f8b79ff8e5e3838adc7a0525134fd5606","2b383a3755d07405be2393df0736d6e52ab1173adcc1d7c55c11b7dca602b0bf","d1edf5d9b17baa75878f2dac2f3bbc3dbb0681540905e80339c46a7f3f034634","e63aafa333b2a29cac32758bf4f2ee1c281eef31d218700eeee353d99d6c1de0","50d403448f5e8f1076afcc43324e71a675e759931286fc9c9898515ab7fe6e2c","1661d15cee4370c3594806ad2820ebb70c95d584ee97f0004c61a05e0f62b2fb","da8ea313b00158af7fbd8f62e79c4e41947347484c425e78c43c2b4e92c842cc","9d0a8583aaa97fa91b5d40db74c8d9aeb876dcfacd868267b090e5b4bf98bb1d","a40ac5c865263408fe575445bec4d5471df53655dc98e04d76aed1a833256537","3ea4ebebc6fffa88a5d40541f43e730cfc6d45089be5d82ce04e98c38ae49bb0","36f6da67ab9001b840ee207d4190a8b722687e92c56798ad137fe558db6de1e9","9f64940439be3731f7ef1ce2424c4195318dc8ab99ee318ff58e6efd69228d54","013781dc23af7c5562cf90a21663ee34ef8d489c053dd81d648f9d7daee1d927","c714e1667dfda470be57063f8e972bb1d558b9ae0a8efa1a06fd401e46bf84bd","82a4c19c4b63fc2c62204f255bf68ef1e60051a0a09586114dd96c9206f6cbd5","6dc3aa337a894d91d92fa546ff8a7fc79acc17c9f2de81b26aa16e3d74baa4c4","5ad5b04f0549607066f829d9eaff005e081ec189a4062e1b5efcd08a35c83a72","cf80d165a14dca7a0f7c9a7598edb2781ceb124807e0906119d75147f6e0a19f","5e860c5ecf27df0617720b4fdb55ebfa49a3fe353302bbee261dd6247aed7cab"],"paragraph_range_zero_based":[29208,29231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    additionalPRBOffset-r17                 ENUMERATED {n2, n3, n4, n6, n8, n9, n10, n12}        OPTIONAL    -- Cond InitialBWP-RedCapOnly","paragraph_zero_based":29232},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29233},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29234},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29235},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGCOMMON-STOP","paragraph_zero_based":29236},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29238},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigCommon field descriptions","paragraph_zero_based":29239},{"literal_text_all_w_t_and_m_t":"additionalPRBOffset","paragraph_zero_based":29240},{"literal_text_all_w_t_and_m_t":"When intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is disabled, each common PUCCH resource is mapped to a single PRB on one side of the UL BWP. This parameter determines an additional PRB offset in the PRB mapping for the PUCCH resource. If the field is not configured, the UE shall assume an additional PRB offset of zero.","paragraph_zero_based":29241},{"literal_text_all_w_t_and_m_t":"hoppingId","paragraph_zero_based":29242},{"literal_text_all_w_t_and_m_t":"Cell-specific scrambling ID for group hopping and sequence hopping if enabled, see TS 38.211 [16], clause 6.3.2.2.","paragraph_zero_based":29243},{"literal_text_all_w_t_and_m_t":"intra-SlotFH-r17","paragraph_zero_based":29244},{"literal_text_all_w_t_and_m_t":"In case a separate initial UL BWP is configured for (e)RedCap UEs, the presence of this parameter indicates whether intra-slot PUCCH frequency hopping within the separate initial UL BWP in the common PUCCH resource is enabled for (e)RedCap UEs. If this field is absent, intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is enabled. If this field is present, intra-slot PUCCH frequency hopping within RedCap-specific initial UL BWP is disabled and each PUCCH resource is mapped to a single PRB on one side of the UL BWP and this parameter determines whether the PRB index in the PRB mapping is counted in increasing order from the lower edge or in decreasing order from the upper edge of the UL BWP.","paragraph_zero_based":29245},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":29246},{"literal_text_all_w_t_and_m_t":"Indicates the number of PRBs used per PUCCH resource for PUCCH format 0 and format 1 in FR2-2, see TS 38.213 [13], clause 9.2.1.","paragraph_zero_based":29247},{"literal_text_all_w_t_and_m_t":"p0-nominal","paragraph_zero_based":29248},{"literal_text_all_w_t_and_m_t":"Power control parameter P0 for PUCCH transmissions. Value in dBm. Only even values (step size 2) allowed (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29249},{"literal_text_all_w_t_and_m_t":"pucch-GroupHopping","paragraph_zero_based":29250},{"literal_text_all_w_t_and_m_t":"Configuration of group- and sequence hopping for all the PUCCH formats 0, 1, 3 and 4. Value neither implies neither group or sequence hopping is enabled. Value enable enables group hopping and disables sequence hopping. Value disable disables group hopping and enables sequence hopping (see TS 38.211 [16], clause 6.3.2.2).","paragraph_zero_based":29251},{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommon","paragraph_zero_based":29252},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":29253},{"literal_text_all_w_t_and_m_t":"pucch-ResourceCommonRedCap","paragraph_zero_based":29254},{"literal_text_all_w_t_and_m_t":"An entry into a 16-row table where each row configures a set of cell-specific PUCCH resources/parameters for (e)RedCap UEs. The UE uses those PUCCH resources until it is provided with a dedicated PUCCH-Config (e.g. during initial access) on the initial uplink BWP. Once the network provides a dedicated PUCCH-Config for that bandwidth part the UE applies that one instead of the one provided in this field (see TS 38.213 [13], clause 9.2).","paragraph_zero_based":29255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dec6e27ee84353acda51acfccdcd3312d77650b3625a0e3714902df5a08d8976","46e67b21a6f74736a05e3d3bdac8fa376548575b46c4895fc062cf7302b29196","1dac74721c9ef1a14eec35f2889973bcdd581b5894e5d424caceace756e7e9e0","a30d3093d1a27dba9e03570e968739015744fe90f1ae4e5a7fbc3925f6542481","5326ddbaa321f96426b2ae7fa06a64b79abbf5932e0df9169ed0de0fdaf89f92","4cc1d9e7b9a4552833aee2828c50d33b3073f9c116071f9afee634620e2389d3","6b7473ba0478031d1f2c5609dfc096fedfc684856f93dca509270ba07748b6bf","554437eefe72472b1f2553405dd8c0d91757f752592dd5d68c75421100f5db9b","29fcd7e0710568b44b00d709b946675fa982f5935806b967f11cd9dafaa41525","cba25b6abcc787c1f4cd8e66a8afad880a6b785d8292db15bc706c8bc6b167cc","71907b7e028590d1d3584364fe06a1a865d1dc6125af09bd5042c47b6e169510","c859b746a9a581fe7f471027a35c9673f588075756363d83606b976bedf509ce","8574f4271bf51c8f649435fc0009e97b7c60901ea9ddd6f3eff5bc3e54046f0e","60461fdd72ade3e6733dfad79ec35b313a8bdcfe488c185f8ca7ec1924b23409","22cd33a240284d6d487c622bdb61c523bdeeb20261287e865b5eaf3fca5d2952","9c1baa0048a148e4036091d54e5089e762a6723abdecd884921759ae1555507a","7abef9c4be8fbc287347f1b482872cb81c330c58ba1e110f5deab2ea4b1d3d46","17eaa578bb9ae626ce6802a1b4816cc8fb1cd0fc5872b44a9ab9313bffe2f31e","f584d6a31ff67c409ab70a08e5a1bfca767ee1cd57411e2d64b6464caf88d1d5","5ba806a89bfa627ff7ffaa9b927a41e2e8664571add2b2a1bea51b8ff961dc31","535628527a2f827828a8eae8a99370bef0cb63edb3ae39ef2a20c5770891de9e","2c8972e10670659c3d52a153c17b92ff8ba262e4efb2ccbe3e4da606f9f3b866","d403fa771896b7edf3d9de3700b3131755e18eee01dd74e7cb7ec153724762f4","49e13c3af6806cdbdf3024ff0b6e37ed2be2c0e9364f1838e44ae4f811b506b4"],"paragraph_range_zero_based":[29232,29255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29256},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29257},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29258},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":29259},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the initial BWP (BWP#0) in SIB1. It is absent in other BWPs including the RedCap-specific initial uplink BWP, if configured.","paragraph_zero_based":29260},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCap","paragraph_zero_based":29261},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the PUCCH-ConfigCommon of the RedCap-specific initial BWP. It is optional present, Need R, in the PUCCH-ConfigCommon of the initial BWP configured by initialUplinkBWP. It is absent in other BWPs.","paragraph_zero_based":29262},{"literal_text_all_w_t_and_m_t":"InitialBWP-RedCapOnly","paragraph_zero_based":29263},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need S, in the PUCCH-ConfigCommon of the RedCap-specific initial BWP. It is absent in other BWPs.","paragraph_zero_based":29264},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29265},{"literal_text_all_w_t_and_m_t":"–PUCCH-ConfigurationList","paragraph_zero_based":29266},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-ConfigurationList is used to configure UE specific PUCCH parameters (per BWP) for two simultaneously constructed HARQ-ACK codebooks. See TS 38.213 [13], clause 9.1.","paragraph_zero_based":29267},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList information element","paragraph_zero_based":29268},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29269},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-START","paragraph_zero_based":29270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29271},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList-r16  ::=     SEQUENCE (SIZE (1..2)) OF PUCCH-Config","paragraph_zero_based":29272},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29273},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-STOP","paragraph_zero_based":29274},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29275},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29276},{"literal_text_all_w_t_and_m_t":"–PUCCH-CSI-Resource","paragraph_zero_based":29277},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-CSI-Resource is used to indicate a PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":29278},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource information element","paragraph_zero_based":29279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0185a06972167df4097e0af97aebf5ffe00a10bd3d13395de14debecab2f5c27","395fe5755bee6496b924cfc22cc8c93fcdd9d6400eef1cc26585b8f600149043","ab6c34098b44982991fdb169d344731c7fdada01443a1d68bd92755e527d407c","b3c310be930311450dea607c6e16aa2058e327ac69220a88500a4ab7fba8dcc0","0acbd2d7cf0d5baffbb44257ed6eaccac4caccc39a75cf77a324782d3054bc21","f9b14848f7ecc9f6b64b916b8cc912045a5afcc8ad4d13c98a3c8b6df6984dfc","1c269b0afca149b4a9e58be17f1dc483534d80415b0b12030172c9ada1da9a6d","be4cfd77e01d02130100068b0f632cf601fa8dbeab48921b78c2461848b227ff","6fa26d9598f2080a24a48602f21380bb7044611c770307aa97fde26a719ed4f6","68c27bfcdd699684def984817b2851cd2df68f580754b0b5ec23c75c03f729f2","765271325527045be221a4fff5abb245b09156249d19086b41a8e