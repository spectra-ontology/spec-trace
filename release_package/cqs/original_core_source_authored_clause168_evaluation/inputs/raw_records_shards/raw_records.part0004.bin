{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        dot5                                ENUMERATED {evenPRBs, oddPRBs},","paragraph_zero_based":22008},{"literal_text_all_w_t_and_m_t":"        one                                 NULL,","paragraph_zero_based":22009},{"literal_text_all_w_t_and_m_t":"        three                               NULL,","paragraph_zero_based":22010},{"literal_text_all_w_t_and_m_t":"        spare                               NULL","paragraph_zero_based":22011},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":22012},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation,","paragraph_zero_based":22013},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22014},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22015},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22016},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-STOP","paragraph_zero_based":22017},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22019},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping field descriptions","paragraph_zero_based":22020},{"literal_text_all_w_t_and_m_t":"cdm-Type","paragraph_zero_based":22021},{"literal_text_all_w_t_and_m_t":"CDM type (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":22022},{"literal_text_all_w_t_and_m_t":"density","paragraph_zero_based":22023},{"literal_text_all_w_t_and_m_t":"Density of CSI-RS resource measured in RE/port/PRB (see TS 38.211 [16], clause 7.4.1.5.3).","paragraph_zero_based":22024},{"literal_text_all_w_t_and_m_t":"Values 0.5 (dot5), 1 (one) and 3 (three) are allowed for X=1, values 0.5 (dot5) and 1 (one) are allowed for X=2, 16, 24 and 32, value 1 (one) is allowed for X=4, 8, 12.","paragraph_zero_based":22025},{"literal_text_all_w_t_and_m_t":"For density = 1/2, includes 1-bit indication for RB level comb offset indicating whether odd or even RBs are occupied by CSI-RS.","paragraph_zero_based":22026},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain2","paragraph_zero_based":22027},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. See TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":22028},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":22029},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS. See TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":22030},{"literal_text_all_w_t_and_m_t":"freqBand","paragraph_zero_based":22031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["25afb429ef8b423c1b42d45fcd673440a7580ae44de18de6d482c95132d6f66d","19f9fd169b120481a4e37257579123f5112f321f2b57a1773290383ac8318c43","7ee0c66cc490522576c09470438e550984d884ced96e62cbc25393b8e108e6dd","9387c2261b73b68a00d6e09a733b12a8b3e2a425f5f3d82352c7a3d5345231b9","4ca936404acdf79fe6c864a44b5b5b03d22822e0b9083a9a7ef61be5bf289e69","1e2d19d7cd897b2020bce34fad2a2aad03d30853cc6acbb5e1810769fc3048b9","20657324bda3197305645fc9065a0548d1cc7026b38348e2b41f8b6a1428635e","cc3d0e9994dd4a9a3986afa728d21083fdb247f8243f2f8b4bfbc381469c3d60","2b24b6827a0121268556196e6eeb36e5394cf768943131e67306eb3aa7d950c6","69ad1e167103c872505d8694be1060ee7275577bcc548f301c9724df8aa6dc82","23f3097ba102afb74b123385fb70fafe2c5977bac8000367ccfc03361c8510ad","676840613146106e06d