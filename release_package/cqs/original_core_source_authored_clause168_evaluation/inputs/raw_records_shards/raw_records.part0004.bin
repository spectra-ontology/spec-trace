{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46153},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGDEDICATEDNR-STOP","paragraph_zero_based":46154},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46155},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46156},{"literal_text_all_w_t_and_m_t":"SL-ConfigDedicatedNR field descriptions","paragraph_zero_based":46157},{"literal_text_all_w_t_and_m_t":"sl-LBT-SchedulingRequestId","paragraph_zero_based":46158},{"literal_text_all_w_t_and_m_t":"Indicates the scheduling request configuration applicable for sidelink consistent LBT failure report, as specified in TS 38.321 [3].","paragraph_zero_based":46159},{"literal_text_all_w_t_and_m_t":"sl-MaxTransPowerCA","paragraph_zero_based":46160},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all sidelink carriers.","paragraph_zero_based":46161},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToAddModList","paragraph_zero_based":46162},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to add and/or modify.","paragraph_zero_based":46163},{"literal_text_all_w_t_and_m_t":"sl-MeasConfigInfoToReleaseList","paragraph_zero_based":46164},{"literal_text_all_w_t_and_m_t":"This field indicates the RSRP measurement configurations for unicast destinations to remove.","paragraph_zero_based":46165},{"literal_text_all_w_t_and_m_t":"sl-PHY-MAC-RLC-Config","paragraph_zero_based":46166},{"literal_text_all_w_t_and_m_t":"This field indicates the lower layer sidelink radio bearer configurations.","paragraph_zero_based":46167},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToAddModList","paragraph_zero_based":46168},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to add and/or modify. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":46169},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerToReleaseList","paragraph_zero_based":46170},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations to remove. This field is not configured to the PC5 connection used for L2 U2N relay operation.","paragraph_zero_based":46171},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46172},{"literal_text_all_w_t_and_m_t":"SL-PHY-MAC-RLC-Config field descriptions","paragraph_zero_based":46173},{"literal_text_all_w_t_and_m_t":"networkControlledSyncTx","paragraph_zero_based":46174},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall transmit synchronisation information (i.e. become synchronisation source). Value on indicates the UE to transmit synchronisation information while value off indicates the UE to not transmit such information.","paragraph_zero_based":46175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f6591b7895b9c498c448283f55b69609482269f2b026a0bb5c931db56ef2af32","8a0f2e79c03b82f77362a6f0e6b0b9e5237d8fbf01fe309e8ed8210601968e61","9a4cfde4715fafcc73d59d52daa4664d4746d63cd04f6f73a5405fa32bc9c321","d7c8d1d15bf3ebb28bfdd219d63d5712a890a64a11d484f10fdac6ce961226d3","b501391453f39dfc0b70a7412879f961ff81f1472786ad0f092e5b44dd4ef207","a0515c407bd277a8c7ff1fbf895d8bb604e526638836d3dc872d77cbec4c61bc","22c59a090503601b0fe4037d0368891d2b23f7d1e2bf0382637f542cec4e9686","2587609728511161a773be207d9af8c0698690280fd97dc8cfc6c133e21a9d98","aa0ecd787c58364c7f07e4223b9d9ae4f2cb0e542a260495e1211c783053ca3e","afb5cbc74baf098a14cc19fd55baf58641acc51b7ca3232aeceb6b0857d8cd6b","b079ab28cee0e1578d3bd7ea1137a4eac4d60dee001fa2a9aceccf06ac5c4c38","a48e93820c1e481e2846c37f66ddc8a42be47fdb28cf72e81042441c5c39cd7a","34b8f2908f42410b6ba0a3043881c3ffad848ca62e21e42bd2ede901133bfa10","bc00b9803dc79a10fcac724e7625a9899f9f21a634623f071f77854aefbdd6f3","fe786631987b9a0a943dad95cb7c4968fc3e527de1e439d0f77737bc1d5022bb","236116fdf71dfe96fe31dddc323b008bc09ac66dcd5e0d21a42debe781d807b1","c03ef2742c172791bc77747f1d9495822f084e644708a3b85c0e6335bc4611a5","5afd3e916b4a6c0ec65d24785852cdd852f3a8dbe7408865392a1dbd993ef2fb","6e922355fe2eeaa51d39717f33bebf13c26d63862fa9c975c0d3b63df3d94397","430245933813a7888ba6ed765aa9d5d7ca1dc4f130302a726e04f36dc7a653eb","861109c25f665be6dc2f64e123168005fb375073d7f906563379cf3bde5fc8e5","eb2e977b51b1f4535b1a8393429450dd266cbe5f8c8431012bbcd61833fb7cb3","682ee66a1407f0ff97debfb60f93e1def5b0c9a07ef88dfb2511b8d523936bba","6fd6b9df89e93c558cc2eabb1fac13d4cdbace5d64a7d7025a1df4b9ca13a325"],"paragraph_range_zero_based":[46152,46175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46152"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DRX-Config","paragraph_zero_based":46176},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration(s) for unicast, groupcast and/or broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":46177},{"literal_text_all_w_t_and_m_t":"sl-MaxNumConsecutiveDTX","paragraph_zero_based":46178},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of consecutive HARQ DTX before triggering sidelink RLF. Value n1 corresponds to 1, value n2 corresponds to 2, and so on.","paragraph_zero_based":46179},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToAddModList, sl-FreqInfoToAddModListExt","paragraph_zero_based":46180},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to add and/or modify. If the network includes sl-FreqInfoToAddModListExt, it includes the same number of entries, and listed in the same order, as in sl-FreqInfoToAddModList.","paragraph_zero_based":46181},{"literal_text_all_w_t_and_m_t":"sl-FreqInfoToReleaseList","paragraph_zero_based":46182},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication configuration on some carrier frequency (ies) to remove. In this release, only one entry can be configured in the list.","paragraph_zero_based":46183},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToAddModList, sl-RLC-BearerToAddModListSizeExt","paragraph_zero_based":46184},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to add and/or modify.","paragraph_zero_based":46185},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerToReleaseList, sl-RLC-BearerToReleaseListSizeExt","paragraph_zero_based":46186},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations to remove.","paragraph_zero_based":46187},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToAddModList","paragraph_zero_based":46188},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to add and/or modify. Each PC5 Relay RLC channel configuration provided by network to L2 U2N Relay UE is uniquely associated with one L2 U2N Remote UE.","paragraph_zero_based":46189},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelToReleaseList","paragraph_zero_based":46190},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple PC5 Relay RLC Channel configurations to remove.","paragraph_zero_based":46191},{"literal_text_all_w_t_and_m_t":"sl-ScheduledConfig","paragraph_zero_based":46192},{"literal_text_all_w_t_and_m_t":"Indicates the configuration for UE to transmit NR sidelink communication based on network scheduling. This field is not configured simultaneously with sl-UE-SelectedConfig. This field is not configured to a L2 U2N Remote UE.","paragraph_zero_based":46193},{"literal_text_all_w_t_and_m_t":"sl-UE-SelectedConfig","paragraph_zero_based":46194},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection. This field is not configured simultaneously with sl-ScheduledConfig.","paragraph_zero_based":46195},{"literal_text_all_w_t_and_m_t":"sl-CSI-Acquisition","paragraph_zero_based":46196},{"literal_text_all_w_t_and_m_t":"Indicates whether CSI reporting is enabled in sidelink unicast. If the field is absent, sidelink CSI reporting is disabled.","paragraph_zero_based":46197},{"literal_text_all_w_t_and_m_t":"sl-CSI-SchedulingRequestId","paragraph_zero_based":46198},{"literal_text_all_w_t_and_m_t":"If present, it indicates the scheduling request configuration applicable for Sidelink CSI Reporting MAC CE and Sidelink DRX Command MAC CE, as specified in TS 38.321 [3].","paragraph_zero_based":46199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ab6c88774443eb674be615c3b9dfbe9fdca894f62d2f4fc2e8a6089073d75f6d","2beecd43ac6771c92dc01bf047cb79ea7f2fd86ed31e6b58bb435356541e0054","1dc5acc248ebb2a54984493ebad77e74b61568ba1f2b195e5299cfc27dab61c3","c2a5736df95324c50d1a33e3ddf4f7fcf64e262e3ced0dbeb31417f953829138","97aff24d8625a72ad1dc63748eba5eb1380409e42f3cce8191acc5e6ddf7532f","c19679602f4f90e517f9276478a65cf949a14730f05e3ce4c407615ce15b93ce","7fc5af813102245a3d7d776133ee9e963a9cf47c6484dc541ef72f740af0ad48","a11f0c6730a7ff625e4a21ee74dcee2125eb88a070dbb1f544b87aae0167c7a8","e5f5e2f1ddbcd503efa36e474897cd667550c7b8ee43a3aeae8e854463ea9224","620e86ad6513fea92377849c09e09bb504cfcc7570e73419eee4e97e0d55464a","eeb3164f79190c50ef996a58a28fd516dffdb78f991f50728137aa9cc644ffa2","1d1bf09b05520892a6f14e30fac9b755e093288f4281e8517826a0197d7b981e","5863fe70520f5441fd06025644a5689eb0a61192256c9ad32042fa285f37aec5","33437b534c3e89f0ffcb74f597420472a41f0a6872993eba66f76dacf6441a52","46b3b67498fdb0d446b6df28950cfa615f53fc762cefd7f2d749dae900ef7862","dec2281e2eac0ebcf6d7234b636354721bd35a28d9790c21238418ab7f657d5c","9d139d9fdc2de8d324192ddace54d94fc16c0ea4a1f72a27e2071a95ae47348c","dc5b49303620173f0aea123293f92ca9ae39f32b0c51f55d8f0f76931c95d0ee","3c5fdefbcb7731f69f7bf70578b6c6da9b1243a508ceccd553819790b2d7bae4","e7811b19607baf08e9b27466fbc45fd8a0a600ad386a36165204ada9ea036d5c","2bc37ada0eeb4229e1f2665e87e8ebcfac308a35bccec6ba59fbc7720c6bd6c2","40499c06a6f4e321f494f0350918a51d4a2ca782c5950d90cca96c177b963ff2","0e8af76a36f6c6904e667f2e40e836b629f9126766b09d3a52ae6890329573b6","7cd42f6303488cdf0ab213b7bce5d7eabd4307ad9b5ede34a6360d21a38918ed"],"paragraph_range_zero_based":[46176,46199],"projection":