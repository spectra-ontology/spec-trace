{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SidelinkUEInformationNR","paragraph_zero_based":14304},{"literal_text_all_w_t_and_m_t":"The SidelinkUEinformationNR message is used for the indication of NR sidelink UE information to the network.","paragraph_zero_based":14305},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":14306},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":14307},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":14308},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":14309},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR message","paragraph_zero_based":14310},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":14311},{"literal_text_all_w_t_and_m_t":"-- TAG-SIDELINKUEINFORMATIONNR-START","paragraph_zero_based":14312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14313},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR-r16::=         SEQUENCE {","paragraph_zero_based":14314},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":14315},{"literal_text_all_w_t_and_m_t":"        sidelinkUEInformationNR-r16         SidelinkUEInformationNR-r16-IEs,","paragraph_zero_based":14316},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":14317},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":14318},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14320},{"literal_text_all_w_t_and_m_t":"SidelinkUEInformationNR-r16-IEs ::=    SEQUENCE {","paragraph_zero_based":14321},{"literal_text_all_w_t_and_m_t":"    sl-RxInterestedFreqList-r16            