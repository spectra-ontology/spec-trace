{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    singlePA-TxDirectCurrent-r16                  UplinkTxDirectCurrentTwoCarrierInfo-r16,","paragraph_zero_based":36600},{"literal_text_all_w_t_and_m_t":"    secondPA-TxDirectCurrent-r16                  UplinkTxDirectCurrentTwoCarrierInfo-r16            OPTIONAL","paragraph_zero_based":36601},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36602},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36603},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCarrierInfo-r16 ::=      SEQUENCE {","paragraph_zero_based":36604},{"literal_text_all_w_t_and_m_t":"    servCellIndex-r16                             ServCellIndex,","paragraph_zero_based":36605},{"literal_text_all_w_t_and_m_t":"    servCellInfo-r16                              CHOICE {","paragraph_zero_based":36606},{"literal_text_all_w_t_and_m_t":"        bwp-Id-r16                                    BWP-Id,","paragraph_zero_based":36607},{"literal_text_all_w_t_and_m_t":"        deactivatedCarrier-r16                        ENUMERATED {deactivated}","paragraph_zero_based":36608},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":36609},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36611},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo-r16 ::=   SEQUENCE {","paragraph_zero_based":36612},{"literal_text_all_w_t_and_m_t":"    referenceCarrierIndex-r16                     ServCellIndex,","paragraph_zero_based":36613},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz-r16                             BOOLEAN,","paragraph_zero_based":36614},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation-r16                   INTEGER (0..3301)","paragraph_zero_based":36615},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36616},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36617},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTTWOCARRIERLIST-STOP","paragraph_zero_based":36618},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36620},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo field descriptions","paragraph_zero_based":36621},{"literal_text_all_w_t_and_m_t":"referenceCarrierIndex","paragraph_zero_based":36622},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the carrier which is to be used as the reference for interpreting the Tx Direction Current location as reported using txDirectCurrentLocation-r16. The numerology of the uplink BWP ID reported with bwp-Id-r16 for this serving cell is the numerology used for interpreting the reported subcarrier location. ","paragraph_zero_based":36623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bf379c03ba5e59d22c93b46117b01b0c444c639ac04f518c03cfed3088f7c0b4","ee6a025261c9fc95d84cd5c65dda7b82102d9bfbb32525f0070db6258233682c","648dc16586255deec29bfaafb9b5e35c3772aac1d48620c947bcf239514ccf03","8389de1705319c8060a59a99b0df2b394a68137bf9d4a226e98ce995413bb659","74a8484c89bf10ba58dc4dd5e02a1357a728c74527c95b37f29d67bbe454fa7a","b18b3467421f77f84a8dc901ea9837fa8f62dbdbfe5a71651a909df26b75749b","bed1199eb05978122f5572774bb303a813585ab11ac0ec68f50ca182c16bd1b5","5a5d380a08d32ecabb348b74a7703d2bf7649c3c13ea4cb11c2011333ea1d6ab","2dd998efeec535a95ef36cf825c9b7d6b295f34117f7124269ff280010d9af05","26285ac8acaa8d0554de19ff773a8fd243268a78729d765a8007f9daa595d1e9","e058297d2eba