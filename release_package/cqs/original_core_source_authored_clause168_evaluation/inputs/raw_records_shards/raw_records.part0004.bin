abbb36b0bc164f6e52","a5fa248724e5075154a11551d811fd2556144e843fc5a16a978a4e2736bc866b","db021be76acb5a3fe4b44a10977d765ef858161d5b0b96d122f6a2dd337886fd","49be5fdbe348304d98a12ac72d0ceb693029363e06f45aef974d3206d270a371","0581d4cb6a4db51c5279387e62932f1122d994d9662ca6c975631728751e7418","79dade8b7a61205cf504ed1ac2a2d966548bd6b01b003b1f0e47de04c98a5c8f","f32007ad348a378b5f7a2c33347fadba7a67d6fa2ad51a85dc6b0860fd04c416","12a4f40b9029e8b8c94e91aedaf027f9a5983e70e441872cf3819ef692bd3bd8","2921631abce34a545d574ded02316350e473767e3f2189b59004f35dc16a123f"],"paragraph_range_zero_based":[26592,26615],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p26592"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26616},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-IntraFreq field descriptions","paragraph_zero_based":26617},{"literal_text_all_w_t_and_m_t":"servCellId","paragraph_zero_based":26618},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell which contains the target SSB (associated with the initial DL BWP) to be measured.","paragraph_zero_based":26619},{"literal_text_all_w_t_and_m_t":"gapIndicationIntra","paragraph_zero_based":26620},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform intra-frequency SSB based measurements on the concerned serving cell. Value gap indicates that a measurement gap is needed if any of the UE configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB) do not contain the frequency domain resources of the SSB associated to the initial DL BWP (CD-SSB). Value ncsg indicates that a NCSG is needed if any of the UE configured BWPs do not contain the frequency domain resources of the SSB associated to the initial DL BWP. Value nogap-noncsg indicates that neither a measurement gap nor a NCSG is needed to measure the SSB associated to the initial DL BWP (CD-SSB) for all configured BWPs (except the BWP(s) configured with servingCellMO associated with NCD-SSB), no matter the SSB is within the configured BWP or not. This field shall be set to 'nogap-noncsg' for the serving cell cell(s) belonging to the corresponding band(s) where bwpOperationMeasWithoutInterrupt-r18 is supported by the UE. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26621},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26622},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-NR field descriptions","paragraph_zero_based":26623},{"literal_text_all_w_t_and_m_t":"bandNR","paragraph_zero_based":26624},{"literal_text_all_w_t_and_m_t":"Indicates the NR target band to be measured.","paragraph_zero_based":26625},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":26626},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on the concerned NR target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that a NCSG is needed, and value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26628},{"literal_text_all_w_t_and_m_t":"–NeedForInterruptionInfoNR","paragraph_zero_based":26629},{"literal_text_all_w_t_and_m_t":"The IE NeedForInterruptionInfoNR indicates whether interruption is needed for the UE to perform SSB based measurements on an NR target band without measurement gap while NR-DC or NE-DC is not configured.","paragraph_zero_based":26630},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR information element","paragraph_zero_based":26631},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26632},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForInterruptionInfoNR-START","paragraph_zero_based":26633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26634},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR-r18 ::=    SEQUENCE {","paragraph_zero_based":26635},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForInterruption-r18    NeedForInterruptionIntraFreqList-r18,","paragraph_zero_based":26636},{"literal_text_all_w_t_and_m_t":"    interFreq-needForInterruption-r18    NeedForInterruptionBandListNR-r18,","paragraph_zero_based":26637},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26638},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ae3b6594fbcefc51ab0a155ce94b8cd5774d14b6cd54b412be32f62ced6e25f2","0d48fd080a736c86c1e9a5bc405b189bb5ce0f2373a3d7d81fad3f15bc7e14cf","bbf6289b0b40258dbdd85c3fb59c4a3e7c322aaf7b24bb32bbe7bdb9227d4db3","ce725dff950c6dbe8ede6aa673131e095d75ecbf78995c4257e86791f2ff63b1","56d620be74e9e55a66a90314838d97fb14a3e6317d0b922d16e76006d5983c6c","1e398bbadb85e3b5ce63e5edc3c3292bf131876ccb93b653a73c3a118c8375be","7726d776fba65f8ffb039233d55590d6f969adc1e6dd2b1b2f1605271dd2caf0","e6af190cd56bbe465c4d60502aa3c38a7fdc10ca607d3d0a498c7a603db2824a","47e737af9ad58849cfba37d956f79f2689e063864b5dcb9159a2c0d7f336ee34","7b8c127d08e8963f77f3ef0b15626292d2e4eadc7d801abe7d253be3b4a46f33","6fc07bc4ab638b677a6e8fd84e2b8d3fc2ce7b7b70a4a69e01a90a36ed417cbd","7e69e425e0cdee3be0f386f5a33e556aafc9030e0b8cf6e682b2960a67cc4978","3b70d9e4f93ddddfeb314a45a32549fb84fad05eb68ebf45a84e6d6eeb0c5539","733c221311d86a2c7ea7dbe2fd7a8598de54c097483f71ff31a9d1b9525f1113","89e824f38b71b22428cb734dcf9308472972bb338c7c6c591b5cd37d045e3bfc","0180e9f211d4657f38b5a47b8be084f0f8a7501d60f397828f4fa864bad5d2ee","dfa992636ede30d8c8501385d43cb56f3c7f34ed7a6406550975febe25042aaf","b2109c97372efa4146bf3e3f65ccce34ff675510975010bfe2c41f02f12f48a2","b769d1c6d7eff3289b92b82bd5633da91236ccc416065a323e58c44972e5ddc8","4026119c57ced28e4180fe6acd4b8a835ad570bf094c78937b5d85c506564e2a","f2b068312b3eecb4b9c0a83b780c63bc35390bab70bbce16bd9fa544c2de9c7f","54d1377585ebf86efd14c0bd7ea37b0486f090cbdbb3fdc2549a208d30e609b9","1ece5f62dbea8155441f7941699ca9aa84ca668160b01acb011cc86a762c07ab","518ab643ed9b01d1b86a75c46ff66a4804ed053a696ee28d6515dc0a7b39cf4c"],"paragraph_range_zero_based":[26616,26639],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p26616"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26640},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionIntraFreqList-r18 ::=          SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForInterruptionNR-r18","paragraph_zero_based":26641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26642},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionBandListNR-r18 ::=             SEQUENCE (SIZE (1..maxBands)) OF NeedForInterruptionNR-r18","paragraph_zero_based":26643},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26644},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionNR-r18  ::=       SEQUENCE {","paragraph_zero_based":26645},{"literal_text_all_w_t_and_m_t":"    interruptionIndication-r18           ENUMERATED {no-gap-with-interruption, no-gap-no-interruption}                     OPTIONAL","paragraph_zero_based":26646},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26647},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26648},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForInterruptionInfoNR-STOP","paragraph_zero_based":26649},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26650},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26651},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionInfoNR field descriptions","paragraph_zero_based":26652},{"literal_text_all_w_t_and_m_t":"intraFreq-needForInterruption","paragraph_zero_based":26653},{"literal_text_all_w_t_and_m_t":"Indicates the interruption requirement information for NR intra-frequency measurement. Each entry in the list is associated to the entry in list intraFreq-needForGap-r16 with the same index. This field shall be set to no-gap-no-interruption for the serving cell(s) belonging to the corresponding band(s) where bwpOperationMeasWithoutInterrupt-r18 is supported by the UE.","paragraph_zero_based":26654},{"literal_text_all_w_t_and_m_t":"interFreq-needForInterruption","paragraph_zero_based":26655},{"literal_text_all_w_t_and_m_t":"Indicates the interruption requirement information for NR inter-frequency measurement. Each entry in the list is associated to the entry in list interFreq-needForGap-r16 with the same index.","paragraph_zero_based":26656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26657},{"literal_text_all_w_t_and_m_t":"NeedForInterruptionNR field descriptions","paragraph_zero_based":26658},{"literal_text_all_w_t_and_m_t":"interruptionIndication","paragraph_zero_based":26659},{"literal_text_all_w_t_and_m_t":"Indicates whether interruption is needed for the UE to perform SSB based measurements without measurement gap. Value no-gap-with-interruption indicates that interruption is needed. Value no-gap-no-interruption indicates interruption is not needed. ","paragraph_zero_based":26660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26661},{"literal_text_all_w_t_and_m_t":"–NextHopChainingCount","paragraph_zero_based":26662},{"literal_text_all_w_t_and_m_t":"The IE NextHopChainingCount is used to update the KgNB key and corresponds to parameter NCC: See TS 33.501 [11].","paragraph_zero_based":26663}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5c4d8abccf7ca3a2800d347d92015e2400aa2573d4b491d39866ec7588059783","b813b30cc09778d696ebe94f48c932dabb695e7b64f9d32d806cdb7625d772ae","63ff448a38eb390355cdc35129d7197ea5d21b109944d95c81ac323d959934f3","f208a45ebdf99ee8b9cfd9abfc4deacaec26eb677d35a680bcf7a4e77739d94d","8105e8a4cf2835e7fba96aa9d8acaf14bcf3db4a13f3575b428bd999891f9654","afafb67e26f65f77