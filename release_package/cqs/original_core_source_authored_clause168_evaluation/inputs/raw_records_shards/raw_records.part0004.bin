93e3a1234cf078f75a84ac750cc62ff00dc8df213b6221a34a4eb1d","10aed17368ac7648cfd08546fc857258fd836517e1f6f214cb26fefb5728eac2","603462d5fa24487ed216f4b2815e661e111764af3ef1fb9a3a4bd132b42b73c6","b5349896a56c7eff61d1afcff1d34b5767fee824f77ee4bf5f2dc912863729b4","c1bca610889825b85b829b1f0ab91ecff8bdeedc6d9bbff6992846ca1fdbf36c","fa5e7a62d0c744cd047bf2c14b5f833192729393bc385f6f201ea3456ab0a7a6","3d566bd13fd7a21497f75d0bdf830707726f84d3f2f5e90afaddcf5bc6935b92","86f7a3e172c1bae032e1bcf67576517435524485a67f051b702800e4c1eb614b","a37249dadb50d9a4d6e3c98139bee9c5ddaa1a7e2c3ea7cf013392c22ce181aa","41a1a6567b3a22c37562ce36a88d5ee9e001956e685b5da8e7d8172f946c9431","5ef3eae0c693c41bcf8077194484dd94b8286d1bdcba6264117ce5de1d723ffc","20581e91f59a9916a0d409831f462979b81f7d2e505af9d35d637915d06d88d7","ce162050b7e0975cc4d20f0dd374d92d910b1a3c073b79ebd40fb5dd92306e72"],"paragraph_range_zero_based":[17568,17591],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p17568"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17592},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB18-STOP","paragraph_zero_based":17593},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17595},{"literal_text_all_w_t_and_m_t":"SIB18 field descriptions","paragraph_zero_based":17596},{"literal_text_all_w_t_and_m_t":"gin-ElementList","paragraph_zero_based":17597},{"literal_text_all_w_t_and_m_t":"The gin-ElementList contains one or more GIN elements. Each GIN element contains either one GIN, which is identified by a PLMN ID and a NID, or multiple GINs that share the same PLMN ID. The total number of GINs indicated does not exceed maxGIN-r17. The GIN index m is defined as d1+d2+…+d(n-1)+i for the GIN included in the n-th entry of the gin-ElementList and the i-th entry of its corresponding GIN-Element, where d(k) is the number of GIN index values used in the k-th gin-ElementList entry.","paragraph_zero_based":17598},{"literal_text_all_w_t_and_m_t":"gins-PerSNPN-List","paragraph_zero_based":17599},{"literal_text_all_w_t_and_m_t":"Indicates the supported GINs for each SNPN. The network includes the same number of entries as the number of SNPNs in snpn-AccessInfoList in provided in SIB1, and the n-th entry in this list corresponds to the n-th SNPN listed in snpn-AccessInfoList provided in SIB1. The network configures this field only if the cell broadcasts more than one SNPN in SIB1. If this field is absent, as in case of a single SNPN broadcasted in SIB1, the UE shall associate all GINs in gin-ElementList to that SNPN. ","paragraph_zero_based":17600},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17601},{"literal_text_all_w_t_and_m_t":"GINs-PerSNPN field descriptions","paragraph_zero_based":17602},{"literal_text_all_w_t_and_m_t":"supportedGINs","paragraph_zero_based":17603},{"literal_text_all_w_t_and_m_t":"Indicates the GINs which are supported by the given SNPN. The first/leftmost bit corresponds to the GIN with GIN index 1, the second bit corresponds to the GIN with GIN index 2 and so on. A bit set to 1 indicates that the GIN is supported by the SNPN. If the field is not present, then the corresponding SNPN does not support any GINs. ","paragraph_zero_based":17604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17605},{"literal_text_all_w_t_and_m_t":"–SIB19","paragraph_zero_based":17606},{"literal_text_all_w_t_and_m_t":"SIB19 contains satellite assistance information for NTN access.","paragraph_zero_based":17607},{"literal_text_all_w_t_and_m_t":"SIB19 information element","paragraph_zero_based":17608},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17609},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB19-START","paragraph_zero_based":17610},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17611},{"literal_text_all_w_t_and_m_t":"SIB19-r17 ::= SEQUENCE {","paragraph_zero_based":17612},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                           NTN-Config-r17                                  OPTIONAL,       -- Need R","paragraph_zero_based":17613},{"literal_text_all_w_t_and_m_t":"    t-Service-r17                            INTEGER (0..549755813887)                       OPTIONAL,       -- Need R","paragraph_zero_based":17614},{"literal_text_all_w_t_and_m_t":"    referenceLocation-r17                    ReferenceLocation-r17                           OPTIONAL,       -- Need R","paragraph_zero_based":17615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48