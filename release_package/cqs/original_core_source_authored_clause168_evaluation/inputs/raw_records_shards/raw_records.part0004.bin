    ]]","paragraph_zero_based":27927},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27929},{"literal_text_all_w_t_and_m_t":"MPE-Config-FR2-r16 ::=              SEQUENCE {","paragraph_zero_based":27930},{"literal_text_all_w_t_and_m_t":"    mpe-ProhibitTimer-r16               ENUMERATED {sf0, sf10, sf20, sf50, sf100, sf200, sf500, sf1000},","paragraph_zero_based":27931},{"literal_text_all_w_t_and_m_t":"    mpe-Threshold-r16                   ENUMERATED {dB3, dB6, dB9, dB12}","paragraph_zero_based":27932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27934},{"literal_text_all_w_t_and_m_t":"MPE-Config-FR2-r17 ::=              SEQUENCE {","paragraph_zero_based":27935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["132090418f5c6d780d139b02e62c45e3038739d64b1428e02b5d68710788979d","3786e70766ed7c41c53b3068dd1bc79026112ef76fd4d212e9e15537773ce889","182c80baa0f9c5ee245b39c31829bf6c3d92db3a561265aa9e8ec35d93ce38ab","6d2e796e0ff3cb2635fbc16c01497bc4dd597a39765e985f73adfee2da432b46","d38a0356425222561f6dbe31b10fade4f619a68511cdec3e2701ba7c287b7b79","ba1517c22c8112b202a5b9aa1762de54cb5d8b1f619a87317a78b6a9976a729a","7f8dac5cc04cd0223556db6e12a54faaf1ded71733657178f7b379a67011eada","6488387be5b4b432f3882936099cb87db68d26b2c907c722c5644deecdc73581","e6b012b1909d47dbdf515593fa669b7dcb71c85bd0a8580aa9a351a8749633c4","b620b613098fed15ca07058ef115f17269a024b1492ddbeef82af4f53a434795","c285edcfa21002c24461250ddd5d4f02cc9dc80533f0fd696c103840e6cad522","756680b2fede524a8a46a91214827d7be062440c02e965b604e827b98e3c4b55","224217d048ae57