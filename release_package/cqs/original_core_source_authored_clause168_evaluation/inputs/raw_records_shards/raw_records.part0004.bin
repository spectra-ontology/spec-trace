{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33912},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon ::=         SEQUENCE {","paragraph_zero_based":33913},{"literal_text_all_w_t_and_m_t":"    physCellId                          PhysCellId                                                          OPTIONAL,   -- Cond HOAndServCellAdd,","paragraph_zero_based":33914},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommon                                                OPTIONAL,   -- Cond HOAndServCellAdd","paragraph_zero_based":33915},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommon                                                  OPTIONAL,   -- Need M","paragraph_zero_based":33916},{"literal_text_all_w_t_and_m_t":"    supplementaryUplinkConfig           UplinkConfigCommon                                                  OPTIONAL,   -- Need S","paragraph_zero_based":33917},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                                   OPTIONAL,   -- Need S","paragraph_zero_based":33918},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                CHOICE {","paragraph_zero_based":33919},{"literal_text_all_w_t_and_m_t":"        shortBitmap                         BIT STRING (SIZE (4)),","paragraph_zero_based":33920},{"literal_text_all_w_t_and_m_t":"        mediumBitmap                        BIT STRING (SIZE (8)),","paragraph_zero_based":33921},{"literal_text_all_w_t_and_m_t":"        longBitmap                          BIT STRING (SIZE (64))","paragraph_zero_based":33922},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond AbsFreqSSB","paragraph_zero_based":33923},{"literal_text_all_w_t_and_m_t":"    ssb-periodicityServingCell          ENUMERATED { ms5, ms10, ms20, ms40, ms80, ms160, spare2, spare1 }   OPTIONAL, -- Need S","paragraph_zero_based":33924},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":33925},{"literal_text_all_w_t_and_m_t":"    lte-CRS-ToMatchAround               SetupRelease { RateMatchPatternLTE-CRS }                            OPTIONAL, -- Need M","paragraph_zero_based":33926},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToAddModList        SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPattern   OPTIONAL, -- Need N","paragraph_zero_based":33927},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternToReleaseList       SEQUENCE (SIZE (1..maxNrofRateMatchPatterns)) OF RateMatchPatternId OPTIONAL, -- Need N","paragraph_zero_based":33928},{"literal_text_all_w_t_and_m_t":"    ssbSubcarrierSpacing                SubcarrierSpacing                                                   OPTIONAL, -- Cond HOAndServCellWithSSB","paragraph_zero_based":33929},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                              OPTIONAL, -- Cond TDD","paragraph_zero_based":33930},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":33931},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":33932},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33933},{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":33934},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":33935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_