{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46224},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46225},{"literal_text_all_w_t_and_m_t":"–SL-QoS-Profile","paragraph_zero_based":46226},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-Profile is used to give the QoS parameters for a sidelink QoS flow. Need codes or conditions specified for SL-QoS-Profile do not apply, in case SL-QoS-Profile is included in SidelinkUEInformationNR.","paragraph_zero_based":46227},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile information element","paragraph_zero_based":46228},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46229},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-PROFILE-START","paragraph_zero_based":46230},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46231},{"literal_text_all_w_t_and_m_t":"SL-QoS-Profile-r16 ::=        SEQUENCE {","paragraph_zero_based":46232},{"literal_text_all_w_t_and_m_t":"    sl-PQI-r16                    SL-PQI-r16                                                  OPTIONAL,   -- Need R","paragraph_zero_based":46233},{"literal_text_all_w_t_and_m_t":"    sl-GFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":46234},{"literal_text_all_w_t_and_m_t":"    sl-MFBR-r16                   INTEGER (0..4000000000)                                     OPTIONAL,   -- Need R","paragraph_zero_based":46235},{"literal_text_all_w_t_and_m_t":"    sl-Range-r16                  INTEGER (1..1000)                                           OPTIONAL,   -- Need R","paragraph_zero_based":46236},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":46237},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46239},{"literal_text_all_w_t_and_m_t":"SL-PQI-r16 ::=                CHOICE {","paragraph_zero_based":46240},{"literal_text_all_w_t_and_m_t":"    sl-StandardizedPQI-r16        INTEGER (0..255),","paragraph_zero_based":46241},{"literal_text_all_w_t_and_m_t":"    sl-Non-StandardizedPQI-r16    SEQUENCE {","paragraph_zero_based":46242},{"literal_text_all_w_t_and_m_t":"        sl-ResourceType-r16           ENUMERATED {gbr, non-GBR, delayCriticalGBR, spare1}     OPTIONAL,   -- Need R","paragraph_zero_based":46243},{"literal_text_all_w_t_and_m_t":"        sl-PriorityLevel-r16          INTEGER (1..8)                                          OPTIONAL,   -- Need R","paragraph_zero_based":46244},{"literal_text_all_w_t_and_m_t":"        sl-PacketDelayBudget-r16      INTEGER (0..1023)                                       OPTIONAL,   -- Need R","paragraph_zero_based":46245},{"literal_text_all_w_t_and_m_t":"        sl-PacketErrorRate-r16        INTEGER (0..9)                                          OPTIONAL,   -- Need R","paragraph_zero_based":46246},{"literal_text_all_w_t_and_m_t":"        sl-AveragingWindow-r16        INTEGER (0..4095)                                       OPTIONAL,   -- Need R","paragraph_zero_based":46247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e924a8000928eae25db8bec995d35682e72b93f53914f3c5df3a5c6560c693ce","0c01cdbf159028512e3010809891390be48e149acdfc7c728b98492cfcb1162b","2b3d33563e1d6524a382f070dd692374a435b1b047b8004464f8e04708b5ae79","9c6a8db9908176fdc8c1cf3afc8c366807539cd16aca210d914b571a94599699","650ba4eb3a31410699682fd47e2a23428a2ce3b41269bd1cfc8bda5e777c9d3e","1642db21d0f442f1451f5d928111b0664fcde1e654a7dc9fdb6912df37f49866","0f45b8