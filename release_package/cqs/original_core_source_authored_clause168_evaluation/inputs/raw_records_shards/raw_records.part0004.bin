},{"literal_text_all_w_t_and_m_t":"timeSpent","paragraph_zero_based":44275},{"literal_text_all_w_t_and_m_t":"This field indicates the duration of stay in the cell or in any cell selection state and/or camped on any cell state in NR or E-UTRA approximated to the closest second. If included in VisitedPSCellInfo, it indicates the duration of stay in the PSCell or without any PSCell. If the duration of stay exceeds 4095s, the UE shall set it to 4095s.","paragraph_zero_based":44276},{"literal_text_all_w_t_and_m_t":"visitedCellId","paragraph_zero_based":44277},{"literal_text_all_w_t_and_m_t":"This field indicates the visited cell id including NR and E-UTRA cells.","paragraph_zero_based":44278},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["13790281479490085c940272ae636b3512b723a4940220bea1a72a65eeee6469","4a7edefc6e4126de5ad5d9a27386eaf21934a86c32e35a70ffb85537c9218425","915c77ee94f6da04c217c8a6aa2cad9bbc3ead47a3af5edb848f878828255a9f","93030cba607c7d1b5cc8822b1ac17e4e4ccd28b30b1bc5e52b76b57bd46459e3","575e74930ed1e90306d53d68b104ddd1a18ccc8e3d5376c12561c527bf976e5b","556ad3e3c16dd1e612436ce230ab15b091a5c0e006b9d58c55f400e2595841cc","72bfb8e517ac24839be9846e828cdcb9eb8c8edc037ce3ee4f9e62934f528359","5e3fbdd3ad18e622b4ccb4c803dfe181b560b1ed39bb0fae592a95df4771da10","8a87509740b7eb52cc31c5a1dd1e2b03ff0710eddce48ce566cac7bbd31728c5","4c56b9642fa3bc52bf58bf151bc63d60c704f4d8c02394ed5f2f932dc3e6fe40","2a216602d36506d7a50ad2d8f804c34547440edf329e7da3851db12c5dbcb1d5","222432b65c54cfbb735f374a9a0b8add9cda1ef304aefb08b55b953585016886","350ee8f917d6b7d4c8c6b22ac9cb019b1e895632e07a7b9755766c3db373eb7c","970ac7a7bd134