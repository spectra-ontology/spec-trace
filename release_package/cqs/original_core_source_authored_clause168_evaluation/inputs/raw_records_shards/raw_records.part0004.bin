nd_m_t":"-- ASN1STOP","paragraph_zero_based":50203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50204},{"literal_text_all_w_t_and_m_t":"VarShortMAC-Input field descriptions","paragraph_zero_based":50205},{"literal_text_all_w_t_and_m_t":"targetCellIdentity","paragraph_zero_based":50206},{"literal_text_all_w_t_and_m_t":"An input variable used to calculate the shortMAC-I. Set to the cellIdentity of the first PLMN-Identity in the PLMN-IdentityInfoList broadcasted in SIB1 of the target cell i.e. the cell the UE is trying to reestablish the connection.","paragraph_zero_based":50207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["07451d1d96ced3a798e8a6b7b119e62985ce8b8014a55f6922bf59cdf22ba034","0986345ebec953ffad1d2443b93ff02646c9fed0175c9ccf4f4edc59e559638a","b926432b6c137f931dc0a34fb21ff9564c6300b40f446088f6724668dc21597c","753a7368de8fad2e78d1acc23d60c830444a5c2425714e92341f68ba14611bfe","7cc677815da1a416c7b1c5b6b4f70307a3cc46f85631483d51f52f7718d4b611","254846a7e8b893ae4ffc99dfae49bd94996e7ea9ac2d8156a02481bdc0aebcd5","e45d1ebaeed5e6ee8867cf7a3125b7653bf13021da5030170077517c6f6cfc19","f95e4d2f611a7987f413dea0eedf9aaf07020cdf0ae1396640d970f7cf191ce1","867fe244b56fab2617f0480b0fa88eef08a47023c0bde994c19e665145296de2","db2ad599f01ea999e0e67d6a5886b032bec5a554c5335217e582a76bd5165f2b","0bfde68148515d24d794e0c8f57fad906eef530244133b704ff445a1750047b8","adab1236e9ab005e87dac20802d3395a7956acd5644646dc5ef993853dd2ecae","5cdc79f476542884170ed3a635f056bab1ce8cd9eb98e31d105ab70239aadb4d","1bbc16c703fa88349a537c7e6b3bef69b6a9d777124603a3a371a4a4189c7721","d13d4bf214454926d8c83a8a5a64e59281365a4ea74eef6a110bb5e1001ad100","dd6c7bdadd4b31da602f271b3aa67b79fdcb0779516