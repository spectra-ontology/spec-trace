{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if sl-PosFreqInfoList is included in sl-PosConfigCommonNR:","paragraph_zero_based":1200},{"literal_text_all_w_t_and_m_t":"3>if configured to perform SL-PRS measurement:","paragraph_zero_based":1201},{"literal_text_all_w_t_and_m_t":"4>use the resource pool(s) indicated by sl-PRS-RxPool for SL-PRS measurement, as specified in 5.8.18.2;","paragraph_zero_based":1202},{"literal_text_all_w_t_and_m_t":"3>if configured to transmit SL-PRS:","paragraph_zero_based":1203},{"literal_text_all_w_t_and_m_t":"4>use the resource pool(s) indicated by sl-PRS-TxPoolSelectedNormal or sl-PRS-TxPoolExceptional for SL-PRS transmission, as specified in 5.8.18.3;","paragraph_zero_based":1204},{"literal_text_all_w_t_and_m_t":"4>perform CBR measurement on the transmission resource pool(s) indicated by sl-PRS-TxPoolSelectedNormal or sl-PRS-TxPoolExceptional for SL-PRS transmission, as specified in 5.5.3.1;","paragraph_zero_based":1205},{"literal_text_all_w_t_and_m_t":"4>use the synchronization configuration parameters for NR sidelink positioning on frequencies included in sl-PosFreqInfoList, as specified in 5.8.5;","paragraph_zero_based":1206},{"literal_text_all_w_t_and_m_t":"The UE should discard any stored segments for SIB23 if the complete SIB23 has not been assembled within a period of 3 hours. The UE shall discard any stored segments for SIB23 upon cell (re-)selection.","paragraph_zero_based":1207},{"literal_text_all_w_t_and_m_t":"5.2.2.4.26Actions upon reception of SIB24","paragraph_zero_based":1208},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of SIB24 apply other than those specified elsewhere e.g., within procedures using the concerned system information, and/or within the corresponding field descriptions.","paragraph_zero_based":1209},{"literal_text_all_w_t_and_m_t":"5.2.2.4.27Actions upon reception of SIB25","paragraph_zero_based":1210},{"literal_text_all_w_t_and_m_t":"No UE requirements related to the contents of SIB25 apply other than those specified elsewhere e.g. within procedures using the concerned system information, and/or within the corresponding field descriptions.","paragraph_zero_based":1211},{"literal_text_all_w_t_and_m_t":"5.2.2.5Essential system information missing","paragraph_zero_based":1212},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1213},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE or in RRC_INACTIVE or in RRC_CONNECTED while T311 is running:","paragraph_zero_based":1214},{"literal_text_all_w_t_and_m_t":"2>if the UE is unable to acquire the MIB:","paragraph_zero_based":1215},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":1216},{"literal_text_all_w_t_and_m_t":"3>perform barring as if intraFreqReselection, or intraFreqReselectionRedCap for RedCap UEs, or intraFreqReselection-eRedCap for eRedCap UEs or intraFreqReselection2RxXR for 2Rx XR UEs, is set to allowed;","paragraph_zero_based":1217},{"literal_text_all_w_t_and_m_t":"2>else if the UE is unable to acquire the SIB1:","paragraph_zero_based":1218},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":1219},{"literal_text_all_w_t_and_m_t":"3>if the UE is a RedCap UE:","paragraph_zero_based":1220},{"literal_text_all_w_t_and_m_t":"4>perform barring as if intraFreqReselectionRedCap is set to allowed;","paragraph_zero_based":1221},{"literal_text_all_w_t_and_m_t":"3>else if the UE is an eRedCap UE:","paragraph_zero_based":1222},{"literal_text_all_w_t_and_m_t":"4>perform barring as if intraFreqReselection-eRedCap is set to allowed;","paragraph_zero_based":1223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b14f718f403fc506817e91802067ee514274655892d21522b92e7fbf953d7629","e567b96e04f0e6c97e782ce0e388102f5e9cbe3f6800e10f13ce24fa70323d0f","643026074e3679150756915f3b08d9648a1d376766db427aad2c4a8e0a08eaae","1afdde3021636a2bbd4dfa35960486166ecbb79afdb0a9e8237c11421a734763","717c6bd494248815e729fe02d0ec2dd04145bde23fad75bc4cc9b69e0e8df04e","b39daaa37a83b25012d520047ece957268f0aafa19648ab045b12f40997cb477","947bf79407466836bcbf562e37abfb825410a62ed9b1dc99cae2d91be7a4527c","a50f4554740b1a6206f07a6afc845d9151c1fbdcf63fb5eb51521fd2f163b900","e08d9eca00a63e0358054a6c3a20eb3599c5d433685e5635d1ac1686a39b14e2","eec7ad44068ba7c1e76dc727a8ae05a390197c3f067820ce6e66e7e9d430e724","7ca2c9cefe41fd28dfee226c97f4adb08d95e62f2c1c62f523d6c555f351fdeb","7bfec5686a6fe4efdf1a25981b168a24d7481fc46c562c86682d944807902cf7","5c8947e68eacef3d3ada3d8e8a80f5453869b3b9688025fb9b34f6634865ae47","f6038b3f8d4af6f1c64a887b3d7ab39d0d6f43d6a2aa0606522a2cf12d8f6b91","f8f0e40968e7460c3afbc451c037dd21254e3b1b4dcdd2dcb545213246a57bad","b4991e16cd09cbacc36900b8cf16960771abde8e5c33101a7368d8477b8134cb","5926609be12d2febe6459fd8103fcde88b3fcf3382f1c7040dcac7b53c21c201","c22c68176a29fb360851c29d34abda4fbefa1784eab9cb3ce633c12ba1588e50","949e4f18452c486620b2c929c0cc7524bdf45d48d5ef2bd2a4b94aeebab26f12","7305b7feec9304fb426103796023b6d5be57f8c826592e35e2726ea0bffbe773","04fcccff8bbeabc07e65158f36b4b10b8713e79f1ce21aab44b1b775d500ca42","acfcf4dcfd94eae61139476db57faa237a2f6c7c0aa33cbf17db71e3ea19a06d","893f9af66c2003804db7d527268437c5644d1356517852d37bfdc6b61ea8cb19","7fb339d4b7af14cf92eafed082f40e5e21e991c183a3f993029511a3228f72d2"],"paragraph_range_zero_based":[1200,1223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else if the UE is a 2Rx XR UE:","paragraph_zero_based":1224},{"literal_text_all_w_t_and_m_t":"4>perform barring as if intraFreqReselection2RxXR is set to allowed;","paragraph_zero_based":1225},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1226},{"literal_text_all_w_t_and_m_t":"4>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20].","paragraph_zero_based":1227},{"literal_text_all_w_t_and_m_t":"NOTE 1:The SIB19 is essential for NTN access. If UE is unable to acquire the SIB19 for NTN access, the action is up to UE implementation (e.g., cell re-selection to other cells).","paragraph_zero_based":1228},{"literal_text_all_w_t_and_m_t":"NOTE 2: The SIB22 is essential for ATG access. If UE is unable to acquire the SIB22 for ATG access, the action is up to UE implementation (e.g., cell re-selection to other cells).","paragraph_zero_based":1229},{"literal_text_all_w_t_and_m_t":"5.2.2.6T430 expiry","paragraph_zero_based":1230},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":1231},{"literal_text_all_w_t_and_m_t":"1>if T430 for serving cell expires and if in RRC_CONNECTED:","paragraph_zero_based":1232},{"literal_text_all_w_t_and_m_t":"2>inform lower layers that UL synchronisation is lost;","paragraph_zero_based":1233},{"literal_text_all_w_t_and_m_t":"2>acquire SIB19 as defined in clause 5.2.2.3.2;","paragraph_zero_based":1234},{"literal_text_all_w_t_and_m_t":"2>upon successful acquisition of SIB19:","paragraph_zero_based":1235},{"literal_text_all_w_t_and_m_t":"3>inform lower layers when UL synchronisation is obtained;","paragraph_zero_based":1236},{"literal_text_all_w_t_and_m_t":"NOTE:The exact time when UL synchronisation is obtained (after SIB19 is acquired) is left to UE implementation, which can be from the subframe indicated by epochTime and optionally before the subframe indicated by epochTime.","paragraph_zero_based":1237},{"literal_text_all_w_t_and_m_t":"5.3Connection control","paragraph_zero_based":1238},{"literal_text_all_w_t_and_m_t":"5.3.1Introduction","paragraph_zero_based":1239},{"literal_text_all_w_t_and_m_t":"5.3.1.1RRC connection control","paragraph_zero_based":1240},{"literal_text_all_w_t_and_m_t":"RRC connection establishment involves the establishment of SRB1. The network completes RRC connection establishment prior to completing the establishment of the NG connection, i.e. prior to receiving the UE context information from the 5GC. Consequently, AS security is not activated during the initial phase of the RRC connection. During this initial phase of the RRC connection, the network may configure the UE to perform measurement reporting, but the UE only sends the corresponding measurement reports after successful AS security activation. However, the UE only accepts a re-configuration with sync message when AS security has been activated.","paragraph_zero_based":1241},{"literal_text_all_w_t_and_m_t":"Upon receiving the UE context from the 5GC, the RAN activates AS security (both ciphering and integrity protection) using the initial AS security activation procedure. The RRC messages to activate AS security (command and successful response) are integrity protected, while ciphering is started only after completion of the procedure. That is, the response to the message used to activate AS security is not ciphered, while the subsequent messages (e.g. used to establish SRB2, DRBs and multicast MRBs) are both integrity protected and ciphered. After having initiated the initial AS security activation procedure, the network may initiate the establishment of SRB2 and DRBs and/or multicast MRBs, i.e. the network may do this prior to receiving the confirmation of the initial AS security activation from the UE. In any case, the network will apply both ciphering and integrity protection for the RRC reconfiguration messages used to establish SRB2, DRBs and/or multicast MRBs. The network should release the RRC connection if the initial AS security activation and/ or the radio bearer establishment fails. A configuration with SRB2 without DRB or multicast MRB, or with DRB or multicast MRB without SRB2 is not supported (i.e., SRB2 and at least one DRB or multicast MRB must be configured in the same RRC Reconfiguration message, and it is not allowed to release all the DRBs and multicast MRBs without releasing the RRC Connection). For IAB-MT and NCR-MT, a configuration with SRB2 without any DRB/MRB is supported.","paragraph_zero_based":1242},{"literal_text_all_w_t_and_m_t":"The release of the RRC connection normally is initiated by the network. The procedure may be used to re-direct the UE to an NR frequency or an E-UTRA carrier frequency.","paragraph_zero_based":1243},{"literal_text_all_w_t_and_m_t":"The suspension of the RRC connection is initiated by the network. When the RRC connection is suspended, the UE stores the UE Inactive AS context and any configuration received from the network, and transits to RRC_INACTIVE state. The RRC message to suspend the RRC connection is integrity protected and ciphered.","paragraph_zero_based":1244},{"literal_text_all_w_t_and_m_t":"The resumption of a suspended RRC connection is initiated by upper layers when the UE needs to transit from RRC_INACTIVE state to RRC_CONNECTED state or by RRC layer to perform a RNA update or by RAN paging from NG-RAN or for SDT. When the RRC connection is resumed, network configures the UE according to the RRC connection resume procedure based on the stored UE Inactive AS context and any RRC configuration received from the network. The RRC connection resume procedure re-activates AS security and re-establishes SRB(s) and DRB(s) and/or multicast MRB(s), if configured.","paragraph_zero_based":1245},{"literal_text_all_w_t_and_m_t":"Upon initiating the resume procedure for SDT, AS security (both ciphering and integrity protection) is re-activated for SRB2 (if configured for SDT) and for SRB1. In addition, AS security is also re-activated (if security is configured) for all the DRBs configured for SDT. Further, the PDCP entities of SRB1 and PDCP entities of the radio bearers configured for SDT are re-established and resumed whilst the UE remains in RRC_INACTIVE state. Transmission and reception of data and/or signalling messages over radio bearers configured for SDT can happen whilst the UE is in RRC_INACTIVE state and SDT procedure is ongoing.","paragraph_zero_based":1246},{"literal_text_all_w_t_and_m_t":"In response to a request to resume the RRC connection or in response to a resume procedure initiated for SDT, the network may resume the suspended RRC connection and send UE to RRC_CONNECTED, or reject the request to resume and send UE to RRC_INACTIVE (with a wait timer), or directly re-suspend the RRC connection and send UE to RRC_INACTIVE, or directly release the RRC connection and send UE to RRC_IDLE, or instruct the UE to initiate NAS level recovery (in this case the network sends an RRC setup message).","paragraph_zero_based":1247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["974d17c171338fdcfa565dfbf56576dd2ad826ec2b5454a97aeacdcf0de8f479","a068216195bc3760a5662de85689db0e030756d84f4ac1957f4ec74b38c6af4a","c3ec4277c66f8c44e0b4577244f34c5b831148b213cda547a4ab8178f25cdcd3","01a0a536987dce22de6f8abe4ae2c3a8cbe2d053ae9d0432f75096e11ddb802d","64d1c9308e8832070a81506fd41a408b562a627a7d5dd100584f13a72282f0a5","656a5017b92490804115469d4b14f0742c02ec871a7c8f7cf2efe6d75bbd4ab4","1c34a3886a2a8e3b06ec46c616047735ad5b6be88ed947499d11134d40605e6e","e0ca670989c11d5c419a24f66a78da553ba2c3921bd7ddef2ce54ad46be181a4","2cfb59fb2b5ba076b0805fae3e0aef0b1f2023ed7d0f55f65fde059da67e9227","1e88e7efb8cfb4cf8fef404234d8b1d9ca3eb7059dfcc731655defcc8a6fe48b","45da2f7cb3157d5e18a5aace216b33032e52fd8fa3fdb82aa509696ec0d147a8","722f03e961e693ca354982f64a481f821e199039961b91b1c00398c2762f9b79","76d20be64bee4ef20fa924655148c260aa0b00a16ae752976af9edfe3ffcaeb3","a876588cc2e7c95a215b2d3932007a064512e3420a9d4ad10199bfc86c1ef9e3","96ee7f4ace488a4376463180ea66acad931952493dc997ab58105fac6703da9f","8d00dc64e1aec1ce76fb6b614da251efbcb64cd0adfb9746ef4198c427292652","9d7cc1a02af9cffb4198fba049c1f2a1054beecd7445f2c197f252f517cf1e47","46469ef05eba8479db2057ec827402b619cf352886ef656bfd4cd81a8a40762b","33be4e4e4dc5337255e19655face975ae33d7d5c447730448e842aee1cac58c4","93b9e07c11859b74971ff858dbec64c7e2c56b40d20b4c37d2577232144e7ca3","f0acc91bca1a0ce425cb3e260d01f3472f8fdf3f86fd88e18f94f122126f6731","612a49af61aa7a5bfd204ce8e3fffe9b3f6461c1b6538980ac996323cb91b3ee","298c3014afd86a734e2c16e2f257020a052a00d83d2c8ea8ce8e5eaf26d68199","7d02b549e61664113667b2eaf631244c867ab6a9126fefa0ee6e5981d1104290"],"paragraph_range_zero_based":[1224,1247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1224"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE:In case the UE receives the configurations for NR sidelink communication via the E-UTRA, the configurations for NR sidelink communication in SIB12 and sl-ConfigDedicatedNR within RRCReconfiguration used in clause 5.3 are provided by the configurations in SystemInformationBlockType28 and sl-ConfigDedicatedForNR within RRCConnectionReconfiguration as specified in TS 36.331[10], respectively.","paragraph_zero_based":1248},{"literal_text_all_w_t_and_m_t":"5.3.1.2AS Security","paragraph_zero_based":1249},{"literal_text_all_w_t_and_m_t":"AS security comprises of the integrity protection and ciphering of RRC signalling (SRBs) and user data (DRBs).","paragraph_zero_based":1250},{"literal_text_all_w_t_and_m_t":"RRC handles the configuration of the AS security parameters which are part of the AS configuration: the integrity protection algorithm, the ciphering algorithm, if integrity protection and/or ciphering is enabled for a DRB and two parameters, namely the keySetChangeIndicator and the nextHopChainingCount, which are used by the UE to determine the AS security keys upon reconfiguration with sync (with key change), connection re-establishment and/or connection resume.","paragraph_zero_based":1251},{"literal_text_all_w_t_and_m_t":"The integrity protection algorithm is common for SRB1, SRB2, SRB3 (if configured), SRB4 (if configured), SRB5 (if configured) and DRBs configured with integrity protection, with the same keyToUse value. The ciphering algorithm is common for SRB1, SRB2, SRB3 (if configured), SRB4 (if configured), SRB5 (if configured) and DRBs configured with the same keyToUse value. Neither integrity protection nor ciphering applies for SRB0.","paragraph_zero_based":1252},{"literal_text_all_w_t_and_m_t":"NOTE 0:All DRBs related to the same PDU session have the same enable/disable setting for ciphering and the same enable/disable setting for integrity protection, as specified in TS 33.501 [11].","paragraph_zero_based":1253},{"literal_text_all_w_t_and_m_t":"RRC integrity protection and ciphering are always activated together, i.e. in one message/procedure. RRC integrity protection and ciphering for SRBs are never de-activated. However, it is possible to switch to a 'NULL' ciphering algorithm (nea0).","paragraph_zero_based":1254},{"literal_text_all_w_t_and_m_t":"The 'NULL' integrity protection algorithm (nia0) is used only for SRBs and for the UE in limited service mode, see TS 33.501 [11] and when used for SRBs, integrity protection is disabled for DRBs. In case the ′NULL' integrity protection algorithm is used, 'NULL' ciphering algorithm is also used.","paragraph_zero_based":1255},{"literal_text_all_w_t_and_m_t":"NOTE 1:Lower layers discard RRC messages for which the integrity protection check has failed and indicate the integrity protection verification check failure to RRC.","paragraph_zero_based":1256},{"literal_text_all_w_t_and_m_t":"The AS applies four different security keys: one for the integrity protection of RRC signalling (KRRCint), one for the ciphering of RRC signalling (KRRCenc), one for integrity protection of user data (KUPint) and one for the ciphering of user data (KUPenc). All four AS keys are derived from the KgNB key. The KgNB key is based on the KAMF key (as specified in TS 33.501 [11]), which is handled by upper layers.","paragraph_zero_based":1257},{"literal_text_all_w_t_and_m_t":"The integrity protection and ciphering algorithms can only be changed with reconfiguration with sync. The AS keys (KgNB, KRRCint, KRRCenc, KUPint and KUPenc) change upon reconfiguration with sync (if masterKeyUpdate is included), and upon connection re-establishment and connection resume.","paragraph_zero_based":1258},{"literal_text_all_w_t_and_m_t":"For each radio bearer an independent counter (COUNT, as specified in TS 38.323 [5]) is maintained for each direction. For each radio bearer, the COUNT is used as input for ciphering and integrity protection.","paragraph_zero_based":1259},{"literal_text_all_w_t_and_m_t":"It is not allowed to use the same COUNT value more than once for a given security key. As specified in TS 33.501 clause 6.9.4.1 [11], the network is responsible for avoiding reuse of the COUNT with the same RB identity and with the same key, e.g. due to the transfer of large volumes of data, release and establishment of new RBs, and multiple termination point changes for RLC-UM bearers and multiple termination point changes for RLC-AM bearer with SN terminated PDCP re-establishment (COUNT reset) due to SN only full configuration whilst the key stream inputs (i.e. bearer ID, security key) at MN have not been updated. In order to avoid such re-use, the network may e.g. use different RB identities for RB establishments, change the AS security key, or an RRC_CONNECTED to RRC_IDLE/RRC_INACTIVE and then to RRC_CONNECTED transition.","paragraph_zero_based":1260},{"literal_text_all_w_t_and_m_t":"In order to limit the signalling overhead, individual messages/ packets include a short sequence number (PDCP SN, as specified in TS 38.323 [5]). In addition, an overflow counter mechanism is used: the hyper frame number (HFN, as specified in TS 38.323 [5]). The HFN needs to be synchronized between the UE and the network.","paragraph_zero_based":1261},{"literal_text_all_w_t_and_m_t":"For each SRB, the value provided by RRC to lower layers to derive the 5-bit BEARER parameter used as input for ciphering and for integrity protection is the value of the corresponding srb-Identity with the MSBs padded with zeroes.","paragraph_zero_based":1262},{"literal_text_all_w_t_and_m_t":"For a UE provided with an sk-counter, keyToUse indicates whether the UE uses the master key (KgNB) or the secondary key (S-KeNB or S-KgNB) for a particular DRB. The secondary key is derived from the master key and sk-Counter, as defined in TS 33.501[11]. Whenever there is a need to refresh the secondary key, e.g. upon change of MN with KgNB change or to avoid COUNT reuse, the security key update is used (see 5.3.5.7). When the UE is in NR-DC, the network may provide a UE configured with an SCG with an sk-Counter even when no DRB is setup using the secondary key (S-KgNB) in order to allow the configuration of SRB3. The network can also provide the UE with an sk-Counter, even if no SCG is configured, when using SN terminated MCG bearers.","paragraph_zero_based":1263},{"literal_text_all_w_t_and_m_t":"5.3.2Paging","paragraph_zero_based":1264},{"literal_text_all_w_t_and_m_t":"5.3.2.1General","paragraph_zero_based":1265},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1266},{"literal_text_all_w_t_and_m_t":"Figure 5.3.2.1-1: Paging","paragraph_zero_based":1267},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is:","paragraph_zero_based":1268},{"literal_text_all_w_t_and_m_t":"-to transmit paging information to a UE in RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":1269},{"literal_text_all_w_t_and_m_t":"-to transmit paging information for a L2 U2N Remote UE in RRC_IDLE or RRC_INACTIVE to its serving L2 U2N Relay UE in any RRC state.","paragraph_zero_based":1270},{"literal_text_all_w_t_and_m_t":"5.3.2.2Initiation","paragraph_zero_based":1271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cc14f84945e40e0e5faff74c6ed6323f6a211747b25091e5c70b29a5c3bd1384","10c8ae50a5bd76ba8fe3c1e8105b13ba8fe023a83f3c07c02cc0a5af2d7f041e","d094ad0d5bd876ae4fae6926c9d458365cb3ccfd5ad7cb4330ae1a6291195944","c98e815fdbf6b97225c74edef4b2f30434e49236bdc4845ccb9fae9f443da225","8bc6292a3fc1c46b62c02d17623de4b87b4ad539741f7a05ba68dd92a8190967","94b1d8cd8f9bfbef7ffa602ef68471259a4a41c83e8869eaee7275b608cbf68a","c9791e71aeb498aa6dd936e73fa9b8411f565a09039a3a2cfea81e0a1f11675b","9b567c2c6a5b28ed17e1bd1d0e33f6d4bd86320949689de7e217f612158caa4a","40dc20fb77de0ac20b19608b7c50e28a3e17e4e025183e25d6fd76c3cdf1933d","e1f4c1baf711fb3f4185a16a605f48db8ad2853cb080fca48efd59160d59acde","44ef71909daa4f52bf43468306568c0224a88e3a8ed7b1252707d96d8fe80afe","890cc0cc0f41f5f7d9720721805b726154c4cb7a8c129758a0ee2515a0481bc1","2f63b99f5247ec99a30833a81e616b3110a62c87adb2e4c131cdae4f53524d12","fb0a051a9a4065e251e0690535b22749686258ae877a0440f45a26b72a8e3cb1","1fcde134d0a0c8f1403f569420a70384e439df95326420cce8c2951a613999db","ddbf5d6996cf381f1eef77f6c3ab47e1780d0ff9d4b651719918dd936dd7bf78","b475e29efbb214c6f4c6ea45d1bb2e1cb6ae04c8791e0782b4d04451306f2396","916af8fb474a5a8b6cdaa2f17807d0e254ddf55033a6e8ca15d1fdc6f5cf49ae","d6e02f75fd84893f424c6b6c734653f6689c7cc95f53950842bc2df4698a7a7b","edd681eea4649e6e72366414b7a5e8cbb82ed032bd6b528cd8c00fe8c53e9ebd","6dec9351a90e3f6c7506a3e53fca77206095324cdc1daeceab603d1081dc701d","1e6d2574e128c359ec3dce449ebf15ac1e76f787513296faecd21e4c53aa076d","539bf4bba33b508d105b5df753beca3a718d715cd402dbb1aadc185283918a74","8f373a1126193f02998eb84ea00122dc7fa9136d693145593a1a41ab4320ce97"],"paragraph_range_zero_based":[1248,1271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The network initiates the paging procedure by transmitting the Paging message at the UE's paging occasion as specified in TS 38.304 [20]. The network may address multiple UEs within a Paging message by including one PagingRecord for each UE. The network may also include one or multiple TMGI(s) in the Paging message to page UEs for specific MBS multicast session(s).","paragraph_zero_based":1272},{"literal_text_all_w_t_and_m_t":"5.3.2.3Reception of the Paging message by the UE or PagingRecord by the L2 U2N Remote UE","paragraph_zero_based":1273},{"literal_text_all_w_t_and_m_t":"Upon receiving the Paging message by the UE or receiving PagingRecord from its connected L2 U2N Relay UE by a L2 U2N Remote UE, the UE shall:","paragraph_zero_based":1274},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for each of the PagingRecord, if any, included in the Paging message, or","paragraph_zero_based":1275},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for the PagingRecord, if any, included in the UuMessageTransferSidelink message received from the connected L2 U2N Relay UE:","paragraph_zero_based":1276},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1277},{"literal_text_all_w_t_and_m_t":"3>if upper layers indicate the support of paging cause:","paragraph_zero_based":1278},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity, accessType (if present) and paging cause (if determined) to the upper layers;","paragraph_zero_based":1279},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1280},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity and accessType (if present) to the upper layers;","paragraph_zero_based":1281},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the L2 U2N Relay UE supports the MUSIM feature, it can forward the paging cause to the connected L2 U2N Remote UE.","paragraph_zero_based":1282},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE, for each of the PagingRecord, if any, included in the Paging message, or","paragraph_zero_based":1283},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE, for the PagingRecord, if any, included in the UuMessageTransferSidelink message received from the connected L2 U2N Relay UE:","paragraph_zero_based":1284},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord matches the UE's stored fullI-RNTI:","paragraph_zero_based":1285},{"literal_text_all_w_t_and_m_t":"3>if the UE is configured by upper layers with Access Identity 1:","paragraph_zero_based":1286},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mps-PriorityAccess;","paragraph_zero_based":1287},{"literal_text_all_w_t_and_m_t":"3>else if the UE is configured by upper layers with Access Identity 2:","paragraph_zero_based":1288},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mcs-PriorityAccess;","paragraph_zero_based":1289},{"literal_text_all_w_t_and_m_t":"3>else if the UE is configured by upper layers with one or more Access Identities equal to 11-15:","paragraph_zero_based":1290},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to highPriorityAccess;","paragraph_zero_based":1291},{"literal_text_all_w_t_and_m_t":"3>else if mt-SDT indication was included in the paging message and if the conditions for initiating SDT for a resume procedure initiated in response to RAN paging according to 5.3.13.1b are fulfilled:","paragraph_zero_based":1292},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mt-SDT:","paragraph_zero_based":1293},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1294},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set to mt-Access;","paragraph_zero_based":1295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c67d2a2e865b93525cdfdeb0e78791d0bad276cbdee7fee671ce8a60b80c3489","3fff1fcb012340d0ac85cfe0644da5d10d0135403e02d7b89f41ba2483c4e8fd","29942da92b3f076af03a5784c216abc241099253ab6722aa8d6f1f9cd9549513","44fcb4b0d2aed90680dec0f3e47f0cb56ff89bc071aab3b3b16b3bb0eda95267","5a3ce0d0c6e8cca25153af116c558ae946999e1d498c5d5785f564b896ce675f","42dd62c831a490b26f6a2e68a7a036dc3ee4975433e10b85201b65a15940f7fb","b31577a926f0b6822e6e4d3c04a5899e2c08adbfc4c6c87610ed1dab6d02699f","c1ca1fa738ad8fff1236180e66e07a01a167287105c2ec53129ee658d2cc3283","541861dae2c9fccee93dfb0cbfb138452fd2b6c27252dbf668e7ed21dc07682c","e2997c6f498234e44d910862767dc33e8d41d95a86dc8e395608f81ac30d286c","d25e65c7604a32fbfc0b2187bcea2a67c1ef5b3b2ce8cbcd9818fa862827f7a9","ad59139662144c18a5b9da7cf15e1b87b41a39a70b271ef5273f1338d014b4e7","6911da531e81d3b30068a0db70a1e3f5a198dae3c36f713cba3cc8cd71d003de","c31356ab791821b3b28b1e4e6874dd629a106c237820e2ed3f651051e791a5b9","e6871b992e7d5db9e15361eaa4b413e106017e0cfa0db2cdfed052090e602b25","8b34483e6f40286c2b8c72f4b34fe54f387197a6c12e545a6655389225fdfdc9","deb9ca3d4d22141b1b546b450120ba87786861a5ba07c86fee41dc8f89c626f0","c94dca6edf65a8389d95e1e4c729f20623e3b0167f1adef282d8777a0bff57e1","a6e2b45e746004994dbf61e8cbd9bb37e7131b76152507ca2f68a67ca3d9a422","197b847364a5a3e7f5df6ec05d8f1d91423a1f300ae5985ff129e8121fb176de","f24cc421b950e97b1873f63571b68433785b50a75673f2ac5225e06fe6441b34","7cd006352f42eb66b580f5b46b29c97d83daef497b59065aef1053e6eefedf2d","8583c44caf673216593e50fab54ce9152a12f4abe161ed9aef0ebaddc9acf1d2","f7056c74bfb150b6718464c1b9ea458e8a72ed7dc959cb3f66a2325662961bee"],"paragraph_range_zero_based":[1272,1295],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1272"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 2:If both conditions for initiating MT-SDT and MO-SDT according to 5.3.13.1b are fulfilled, UE may initiate RRC connection resumption procedure for MT-SDT or MO-SDT based on implementation.","paragraph_zero_based":1296},{"literal_text_all_w_t_and_m_t":"NOTE 3:A MUSIM UE may not initiate the RRC connection resumption procedure, e.g. when it decides not to respond to the Paging message due to UE implementation constraints as specified in TS 24.501 [23].","paragraph_zero_based":1297},{"literal_text_all_w_t_and_m_t":"2>else if the ue-Identity included in the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1298},{"literal_text_all_w_t_and_m_t":"3>if upper layers indicate the support of paging cause:","paragraph_zero_based":1299},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity, accessType (if present) and paging cause (if determined) to the upper layers;","paragraph_zero_based":1300},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1301},{"literal_text_all_w_t_and_m_t":"4>forward the ue-Identity and accessType (if present) to the upper layers;","paragraph_zero_based":1302},{"literal_text_all_w_t_and_m_t":"3>perform the actions upon going to RRC_IDLE as specified in 5.3.11 with release cause 'other';","paragraph_zero_based":1303},{"literal_text_all_w_t_and_m_t":"1>if in RRC_IDLE, for each TMGI included in pagingGroupList, if any, included in the Paging message:","paragraph_zero_based":1304},{"literal_text_all_w_t_and_m_t":"2>if the UE has joined an MBS session indicated by the TMGI included in the pagingGroupList:","paragraph_zero_based":1305},{"literal_text_all_w_t_and_m_t":"3>forward the TMGI to the upper layers;","paragraph_zero_based":1306},{"literal_text_all_w_t_and_m_t":"1>if in RRC_INACTIVE and the UE has joined one or more MBS session(s) indicated by the TMGI(s) included in the pagingGroupList:","paragraph_zero_based":1307},{"literal_text_all_w_t_and_m_t":"2>if PagingRecordList is not included in the Paging message; or","paragraph_zero_based":1308},{"literal_text_all_w_t_and_m_t":"2>if none of the ue-Identity included in any of the PagingRecord matches the UE identity allocated by upper layers or the UE's stored fullI-RNTI:","paragraph_zero_based":1309},{"literal_text_all_w_t_and_m_t":"3>if the UE is not configured to receive multicast in RRC_INACTIVE for at least one of the MBS sessions indicated by the TMGI(s) that the UE has joined; or ","paragraph_zero_based":1310},{"literal_text_all_w_t_and_m_t":"3>if inactiveReceptionAllowed is not included for at least one of the MBS sessions indicated by the TMGI(s) that the UE has joined:","paragraph_zero_based":1311},{"literal_text_all_w_t_and_m_t":"4>initiate the RRC connection resumption procedure according to 5.3.13 with resumeCause set as below:","paragraph_zero_based":1312},{"literal_text_all_w_t_and_m_t":"5>if the UE is configured by upper layers with Access Identity 1:","paragraph_zero_based":1313},{"literal_text_all_w_t_and_m_t":"6>set resumeCause to mps-PriorityAccess;","paragraph_zero_based":1314},{"literal_text_all_w_t_and_m_t":"5>else if the UE is configured by upper layers with Access Identity 2:","paragraph_zero_based":1315},{"literal_text_all_w_t_and_m_t":"6>set resumeCause to mcs-PriorityAccess;","paragraph_zero_based":1316},{"literal_text_all_w_t_and_m_t":"5>else if the UE is configured by upper layers with one or more Access Identities equal to 11-15:","paragraph_zero_based":1317},{"literal_text_all_w_t_and_m_t":"6>set resumeCause to highPriorityAccess;","paragraph_zero_based":1318},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":1319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9ff552b91a62476f416b576e83ab8b119bdcfafdc60ed2149d6571eb99ad7731","7500099e421547045828ccff11f7d78da665716f83e2d5d1cda23b6b4c86b43d","b0858d1639e6c5d602c3ddce8e473cf3af8891ad9b4680ce1882cacb64b54cff","4c17ec6de45a88400e793856d2da176b8cb70954937b8eeba939cbd23ff38c50","48a2d6cc328739ae97b120405bf215b9b6491c891f526412b0beff3d6eccbd75","7539fe988b6c8aae198be3ed8889d9bbe87912bd3f26e1c50c6ffdb31d8383f2","1279b2a4136aa6deea5e7a539f0e7c6926f35a1e18fae8d71dab971a259e0e47","5670ef973d4cdcad5c2f221c56d9523c540c7e3ebb363398a1d521dc0951420b","b974f1a43016482f109fc017197360dfac9a8daaf1ab8aebc4cedc2a9dc52bb6","5e3e83adb3664d0ef29c13d7632f03d5ae9522ae6af4d947f9d23af2025a4946","b08dee243187192bd6c46d2fe8d299b5a3648faa8f206a52154649586d9a41f7","7513edc0176fb3bb751a9fec0928486f0e48a57ca20e5bb2e9a0ca1ace8c4908","b2a81f6811f2800a9fedd37d81c6949ecded8855d1b892fdfe914d9f8d82f2c2","310768ddfbc5030316512a0f0653ff7a6372d8ed2f7ac9193e45c50cf7e43c5f","f40ea5ca6580d5d112602ba6a1fc64f9922c45e3ff4a5060228141744061bc0e","5dce98abe6a19049460d958e44ea73021dfc760cdd3a2da8699da96746f99125","d86bcd61dcd25fc81b4605c552078f3ed01b92ddb0bfd4b615d7649059d432c1","eafd03a6ac81242f61107b2fa9f4eb6ced86a1c32970ea6a15553b32fd618273","ffa1a8a52cd2cb9da89eac7e20f26f1b495da62540eb464ba0d09059fcf1510a","c3b09c1dd15be124aca3c4f90ad3116f219f364dd75c7e6224fcc28a235117ee","8c5156f5afc4cb5aa099ed4081a84ff9f9b729fe3c1fcb8dcc7c2cb735f5bca1","de9e62eb5d7678f272bd6bd414f6b52d0fa19ccd793ba7f01907ee2f7755d488","e3c37aa3a8e38e0da2ebc319463465724964f6fb60d207b60750eeabecadaffd","9a0c81277c6c84310f9ce7f3b39245e5f5b6c4c4a72c9987059300fbfe9a325b"],"paragraph_range_zero_based":[1296,1319],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1296"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>set resumeCause to mt-Access;","paragraph_zero_based":1320},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1321},{"literal_text_all_w_t_and_m_t":"4>start monitoring the G-RNTI(s), if configured, corresponding to the TMGI(s);","paragraph_zero_based":1322},{"literal_text_all_w_t_and_m_t":"4> if the UE was notified to stop monitoring the G-RNTI(s) for all the joined multicast sessions that are configured for reception in RRC_INACTIVE:","paragraph_zero_based":1323},{"literal_text_all_w_t_and_m_t":"5>if multicast MCCH is present:","paragraph_zero_based":1324},{"literal_text_all_w_t_and_m_t":"6>start monitoring the Multicast MCCH-RNTI;","paragraph_zero_based":1325},{"literal_text_all_w_t_and_m_t":"6>acquire the MBSMulticastConfiguration message on multicast MCCH;","paragraph_zero_based":1326},{"literal_text_all_w_t_and_m_t":"4>else if the UE was notified to stop monitoring the G-RNTI for at least one multicast session for which the PTM configuration was not included in RRCRelease message:","paragraph_zero_based":1327},{"literal_text_all_w_t_and_m_t":"5>acquire the MBSMulticastConfiguration message on multicast MCCH;","paragraph_zero_based":1328},{"literal_text_all_w_t_and_m_t":"2>else if the ue-Identity included in any of the PagingRecord matches the UE identity allocated by upper layers:","paragraph_zero_based":1329},{"literal_text_all_w_t_and_m_t":"3>forward the TMGI(s) to the upper layers;","paragraph_zero_based":1330},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as a L2 U2N Relay UE, for each of the PagingRecord, if any, included in the Paging message:","paragraph_zero_based":1331},{"literal_text_all_w_t_and_m_t":"2>if the ue-Identity included in the PagingRecord in the Paging message matches the UE identity in sl-PagingIdentityRemoteUE included in sl-PagingInfo-RemoteUE received in RemoteUEInformationSidelink message from a L2 U2N Remote UE:","paragraph_zero_based":1332},{"literal_text_all_w_t_and_m_t":"3>inititate the Uu Message transfer in sidelink to that UE as specified in 5.8.9.9;","paragraph_zero_based":1333},{"literal_text_all_w_t_and_m_t":"5.3.3RRC connection establishment","paragraph_zero_based":1334},{"literal_text_all_w_t_and_m_t":"5.3.3.1General","paragraph_zero_based":1335},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1336},{"literal_text_all_w_t_and_m_t":"Figure 5.3.3.1-1: RRC connection establishment, successful","paragraph_zero_based":1337},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1338},{"literal_text_all_w_t_and_m_t":"Figure 5.3.3.1-2: RRC connection establishment, network reject","paragraph_zero_based":1339},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to establish an RRC connection. RRC connection establishment involves SRB1 establishment. The procedure is also used to transfer the initial NAS dedicated information/ message from the UE to the network.","paragraph_zero_based":1340},{"literal_text_all_w_t_and_m_t":"The network applies the procedure e.g.as follows:","paragraph_zero_based":1341},{"literal_text_all_w_t_and_m_t":"-When establishing an RRC connection;","paragraph_zero_based":1342},{"literal_text_all_w_t_and_m_t":"-When UE is resuming or re-establishing an RRC connection, and the network is not able to retrieve or verify the UE context. In this case, UE receives RRCSetup and responds with RRCSetupComplete.","paragraph_zero_based":1343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d509c4ad69d9b62178190b5191f5c90b65dfb2fd7abded3bfe1cdf9e304db5ba","4b1393e08a50d700ded8d64530681709da9d8197a068b79c147854a37dcb4825","4d621ce698c48ecac95b891c8affc37f740e802ef94dbd7f64a174fb06225e6a","bd0ea454853f29ddc1fc5f47bf7832855a81a43385ceddde8eacc72bbf16ff7f","a4b8c834996889394cbacc028c4776889448ac742f9b57855a976670383236f9","621c4b7027415852e7756b71f2a473413bf2885f19c2b8009c871c0769fe83b0","63d158395c083fc350f9ba6dc2c0a07fc961401ce49f25280d76e3f8047e6071","7d87759d502ab6c3c44dfba1b76da33e91b0d87d0d40217fb9f6d3a375e0feb1","30c661ce3727bbc2b1519124ce9a6b4e5efb38f407f4af5904382388d3ba37ba","bf78b42007aadb55bb8f3c439ba8481e96992c2925720d215162435ca27f8bae","4c74828d848c44615397401b1e5c669c19882feda329996f6c4672669a207ead","b21dff528c7dff4fce9c2adb786fd15fe5af3eb43a2e0952cad3a77dc34ad7af","ae4bb0857bbd0d02accd3d431c329122be8854a0522ea1ba618c2e559d14c12e","ae35d3e980189a627a53517f481aea72de90d896380c3356a7c046e9144b2eec","f2d867095ee8cd3fbdcc5bee40a4d15d4de99acbfedfac27c716684b7d9dddb4","446331f684cfcd4f91651db3c17912ae9f182134cc655762324975580e2d53b8","167959d39732136648aea452edccfdaa0cb62e06142ec23486e53f8e76f3f500","8a6893e542d06236682baea8dfbb6507d864c7830e0573c2a222f68050fb8460","017a584ecc1d2ca6378467cacd9b5b24dc6f0654f785bbfaa379b0c741f3ec96","7ef946fa934a7e83e11cf1f2ed566b241511873eabfe02e54e425a74e28795f0","ee29bc9ae42ac80d65cfcd02aa2bda7de66748e113335a3fecafeb0b5bf61d85","9eba46db141faf944d3a618bdf13df7e4c82c80d898ecb61af95e92e13ee97f1","aa37739fc18626ad649420359b006ed323021f55d2eb48f4e8e085c1ddb84bd9","bfe34e9d003a1a1c8561d874650da5433a923e3a1e087efc7069f99781c2bb16"],"paragraph_range_zero_based":[1320,1343],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1320"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.3.1aConditions for establishing RRC Connection for NR sidelink communication/discovery/V2X sidelink communication/MP operation","paragraph_zero_based":1344},{"literal_text_all_w_t_and_m_t":"For NR sidelink communication/discovery, an RRC connection establishment is initiated only in the following cases:","paragraph_zero_based":1345},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink communication and related data is available for transmission:","paragraph_zero_based":1346},{"literal_text_all_w_t_and_m_t":"2>if the frequency on which the UE is configured to transmit NR sidelink communication is included in sl-FreqInfoList/sl-FreqInfoListSizeExt within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 does not include sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":1347},{"literal_text_all_w_t_and_m_t":"1>if configured by upper layers to transmit NR sidelink discovery and related data is available for transmission:","paragraph_zero_based":1348},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L2 U2N relay discovery messages and sl-L2U2N-Relay is included in SIB12; or","paragraph_zero_based":1349},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink L3 U2N relay discovery messages and sl-L3U2N-RelayDiscovery is included in SIB12; or","paragraph_zero_based":1350},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured by upper layers to transmit NR sidelink non-relay discovery messages and sl-NonRelayDiscovery is included in SIB12:","paragraph_zero_based":1351},{"literal_text_all_w_t_and_m_t":"3>if the frequency on which the UE is configured to transmit NR sidelink discovery is included in sl-FreqInfoList within SIB12 provided by the cell on which the UE camps; and if the valid version of SIB12 includes neither sl-DiscTxPoolSelected nor sl-TxPoolSelectedNormal for the concerned frequency;","paragraph_zero_based":1352},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE in RRC_IDLE, an RRC connection establishment is initiated in the following cases:","paragraph_zero_based":1353},{"literal_text_all_w_t_and_m_t":"1>if any message is received from a L2 U2N Remote UE via SL-RLC0 as specified in 9.1.1.4 or SL-RLC1 as specified in 9.2.4; or","paragraph_zero_based":1354},{"literal_text_all_w_t_and_m_t":"1>if RemoteUEInformationSidelink containing the connectionForMP is received from a L2 U2N Remote UE as specified in 5.8.9.8.3;","paragraph_zero_based":1355},{"literal_text_all_w_t_and_m_t":"For V2X sidelink communication, an RRC connection is initiated only when the conditions specified for V2X sidelink communication in clause 5.3.3.1a of TS 36.331 [10] are met.","paragraph_zero_based":1356},{"literal_text_all_w_t_and_m_t":"NOTE 1:Upper layers initiate an RRC connection (except if the RRC connection is initiated at the L2 U2N Relay UE upon reception of a message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1). The interaction with NAS is left to UE implementation.","paragraph_zero_based":1357},{"literal_text_all_w_t_and_m_t":"For N3C relay UE in RRC_IDLE, an RRC connection establishment is initiated when a N3C remote UE indicates it to enter RRC_CONNECTED state.","paragraph_zero_based":1358},{"literal_text_all_w_t_and_m_t":"NOTE 2:How/when the N3C remote UE to indicate N3C relay UE to enter RRC_CONNECTED state is left to UE implementation, e.g. before reporting relay UE information with non-3GPP connection(s).","paragraph_zero_based":1359},{"literal_text_all_w_t_and_m_t":"5.3.3.1bVoid","paragraph_zero_based":1360},{"literal_text_all_w_t_and_m_t":"5.3.3.2Initiation","paragraph_zero_based":1361},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure when upper layers request establishment of an RRC connection while the UE is in RRC_IDLE and it has acquired essential system information, or for sidelink communication as specified in clause 5.3.3.1a.","paragraph_zero_based":1362},{"literal_text_all_w_t_and_m_t":"The UE shall ensure having valid and up to date essential system information as specified in clause 5.2.2.2 before initiating this procedure.","paragraph_zero_based":1363},{"literal_text_all_w_t_and_m_t":"Upon initiation of the procedure, the UE shall:","paragraph_zero_based":1364},{"literal_text_all_w_t_and_m_t":"1>if the upper layers provide an Access Category and one or more Access Identities upon requesting establishment of an RRC connection:","paragraph_zero_based":1365},{"literal_text_all_w_t_and_m_t":"2>perform the unified access control procedure as specified in 5.3.14 using the Access Category and Access Identities provided by upper layers;","paragraph_zero_based":1366},{"literal_text_all_w_t_and_m_t":"3>if the access attempt is barred, the procedure ends;","paragraph_zero_based":1367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["945644ef02e63024c95a0f6d99578f40d4b6ccc3a64efe1b524c10902d22b2c1","06d8392613536ffc87fd5440fd976de342da944899b54ad57d55eb3a0665de54","51d40b5e1d9337575486a34ac037e46a4af5da413586eff3f09ee43bcd491b31","fad3927e10b89b383bc90746a4df2cdda9dade9ee18c65535b8f8a757e3e5390","3e9ad5fc183ebbc68b5abbef70df36d2735f55668ff39dd67079c42790df9c3b","aefc61a12073e8e986a2e7209a2072f440403a8a1f1feca39ff473023549a1cd","d985b330cf5dd6039803d8418e5147cc2a34f4773b79ea874cd2500de5dcff43","312e553cd755ae4e02b669e966af2f9b58f9dec53e48bc3de72d075b3131f694","137665557fe7e6945eb38fde077ab9f03445427af9df6d1c3f9b13135467d280","4aa2aa27daad2cb10e780b49d8601ee33247fcf5bb9e9e6ec8506d2c4aeb4674","65ec1351c01d95c891f8c5cb68411595c9f0aecfc52ed9524b4ff269ff0ccc87","dbe021d1674c8904af7a15d13ea51a75eab18d1586a5b1269913c4ec7be40709","e31fecf322735dfc2fffbcba12cc35a56e1862980684718e31d4d9427838a330","ace184ddb9985fbc80a5d7ec6bb3f634b54642fdfae0dcbee0ae4990e2638a3c","aaf37edbe7b5aba29f0698d2aa240ecac27c86812db1b86a1350347b06500c46","eaf03e351310f4ca5d4e48ba18b68d58d0f67fedab676459e592c0b3170f7f60","a5edb57222cec1100ba1b01d842c416d3dda7874ebd62ca2679712ca001d82a1","3380274cd310bedb19397104171e457a3a9c00a8ebd61329cbbd3be36777618a","4a407610d92eca262efd51a2a7186563cdedb875d6130c540bac791cb08a4e38","5a9667563301615b82855d507f176c50f0547db2218765359af24945cbd2e80e","e08c1421e5574407764a7e8ec1f28c993c0666fe69cab0750cf1f58da617a9bc","3752be44e578b78eab304947742ddc26d9e177172e0d58bdd851607935ec8f04","5b8717fdd2fc838d27935669ead84717ef65e7238996d3a87e1c2054d3e86f98","7d76b16052de8661e3d9f5170ea60b16b58ca9912d46a974d2965208c948732a"],"paragraph_range_zero_based":[1344,1367],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1344"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if the upper layers provide NSAG information and one or more S-NSSAI(s) triggering the access attempt (TS 23.501 [32] and TS 24.501 [23]):","paragraph_zero_based":1368},{"literal_text_all_w_t_and_m_t":"2>apply the NSAG with highest NSAG priority among the NSAGs that are included in SIB1 (i.e., in FeatureCombination and/or in RA-PrioritizationSliceInfo), and that are associated with the S-NSSAI(s) triggering the access attempt, in the Random Access procedure (TS 38.321 [3], clause 5.1);","paragraph_zero_based":1369},{"literal_text_all_w_t_and_m_t":"NOTE:If there are multiple NSAGs with the same highest NAS-provided NSAG priority identified for access attempt as above, it is left to UE implementation to select the NSAG to be applied in the Random Access procedure.","paragraph_zero_based":1370},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":1371},{"literal_text_all_w_t_and_m_t":"2>establish a SRAP entity as specified in TS 38.351 [66], if no SRAP entity has been established;","paragraph_zero_based":1372},{"literal_text_all_w_t_and_m_t":"2>apply the specified configuration of SL-RLC0 as specified in 9.1.1.4;","paragraph_zero_based":1373},{"literal_text_all_w_t_and_m_t":"2>apply the SDAP configuration and PDCP configuration as specified in 9.1.1.2 for SRB0;","paragraph_zero_based":1374},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1375},{"literal_text_all_w_t_and_m_t":"2>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":1376},{"literal_text_all_w_t_and_m_t":"2>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":1377},{"literal_text_all_w_t_and_m_t":"2>apply the CCCH configuration as specified in 9.1.1.2;","paragraph_zero_based":1378},{"literal_text_all_w_t_and_m_t":"2>apply the timeAlignmentTimerCommon included in SIB1;","paragraph_zero_based":1379},{"literal_text_all_w_t_and_m_t":"1>start timer T300;","paragraph_zero_based":1380},{"literal_text_all_w_t_and_m_t":"1>initiate transmission of the RRCSetupRequest message in accordance with 5.3.3.3;","paragraph_zero_based":1381},{"literal_text_all_w_t_and_m_t":"5.3.3.3Actions related to transmission of RRCSetupRequest message","paragraph_zero_based":1382},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of RRCSetupRequest message as follows:","paragraph_zero_based":1383},{"literal_text_all_w_t_and_m_t":"1>set the ue-Identity as follows:","paragraph_zero_based":1384},{"literal_text_all_w_t_and_m_t":"2>if upper layers provide a 5G-S-TMSI:","paragraph_zero_based":1385},{"literal_text_all_w_t_and_m_t":"3>set the ue-Identity to ng-5G-S-TMSI-Part1;","paragraph_zero_based":1386},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1387},{"literal_text_all_w_t_and_m_t":"3>draw a 39-bit random value in the range 0..239-1 and set the ue-Identity to this value;","paragraph_zero_based":1388},{"literal_text_all_w_t_and_m_t":"NOTE 1:Upper layers provide the 5G-S-TMSI if the UE is registered in the TA of the current cell.","paragraph_zero_based":1389},{"literal_text_all_w_t_and_m_t":"1>if the establishment of the RRC connection is the result of release with redirect with mpsPriorityIndication (either in NR or E-UTRAN):","paragraph_zero_based":1390},{"literal_text_all_w_t_and_m_t":"2>set the establishmentCause to mps-PriorityAccess;","paragraph_zero_based":1391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8a868a7eedbcc69538bcf1e895d771072a81819e418aabab038481b8e5b29a00","c4df838a9b0be46ba790d35f12624a06c95d5ef9ef07be5285da51ad221b9fd1","99f6a01f010b469504cbd10e338b1f343e2e3ef27f27117cba248be8c51aebf7","d77177590b547ac742c348a7755051dee71508f320e37f6a62994b96f0408afe","99089dd88f8c4f3221686ca4775f56383f005660626994852c24bbfbe24b1adc","f488c3ef3b358da35ed029ccbd1cbb53a34e417e7e2935d5db44f16d3094e0df","5f8801a2e37cd4ad78323d9b62cb37678f8532dc559802623e153a1f0bd7a38c","20d96b18de413eb4b772220d7d5ce166973ee59c2d66e6a0dcdd4df623a92929","e882932538858d57cdd7a8e278a45a9354abae42a7a6be1bd4b0353a0a92b845","e7f817e9cf11089c839feb4ca4e3a4e836868c44bcea71dbddf2bd6298d3d450","2e852338402f496d9fab2e59d598667421007ee52accf0d433c8f07f178214f3","8d3eea171ef6a87cbfeb3a5b3c47bdba72fc55581901a780538e2946d76ff92a","e6804325ac3ee47cffe19f07b5ed62bdbd215f4d2cc1ba67ccd610c1720e082b","88c80abbda70380047dd1765078361664693ddf13d249f43d02fb85c39ca62e5","ff88dfbadb578b7fffbbc5f42bdb1a98f4c6464afa2695dd07a811f54a806734","6ffc3571cadd016e08d2a9869abe6eb2be642396aa1548708ec17b86f4aca2a8","f363fbf45e4f56b58c543f76059ffe53db1c3a41ab73b319ef4b67706e97480d","3f27cb4ae0c7028ba57bcc3288444e2bcc8cb3f7baf5d0983ff1d515844ff1bf","cd773e0789214923ac92a0be7038fab69bdde725b1abf0adbeac2f65ff5551e2","1166b943df27b87957a3bff563c465d902f120a75e201a6b6afa1aba51976e1d","4a8c8b16af593c5e90f95af07653b4466f2e143a0d9f960a3b58b5de3ae3080a","785714e37e33275376a285189a07c3841fd36518acf9773024423651569d1ece","31cae8acccfbefbf8a743a99bb887510c3c92f9e18591ee6452258c2effaa46e","c5225cb914667cc7b916999a03b63ae9aee36ba4dbc7997dcc9656b08df32006"],"paragraph_range_zero_based":[1368,1391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1368"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1392},{"literal_text_all_w_t_and_m_t":"2>set the establishmentCause in accordance with the information received from upper layers;","paragraph_zero_based":1393},{"literal_text_all_w_t_and_m_t":"NOTE 2:In case the L2 U2N Relay UE initiates RRC connection establishment triggered either by reception of message from a L2 U2N Remote UE via SL-RLC0 or SL-RLC1, or by reception of message RemoteUEInformationSidelink containing the connectionForMP, as specified in 5.3.3.1a, the L2 U2N Relay UE sets the establishmentCause by implementation, but: (1) for SL-RLC0, it can only set the emergency, mps-PriorityAccess, or mcs-PriorityAccess as establishmentCause if the same cause value is in the message received from the L2 U2N Remote UE via SL-RLC0; and (2) for SL-RLC1, it sets the establishmentCause to emergency if the message received from the L2 U2N Remote UE via SL-RLC1 is over PC5 link established for emergency service as indicated by upper layer [72].","paragraph_zero_based":1394},{"literal_text_all_w_t_and_m_t":"1>if ta-Report or ta-ReportATG is configured with value enabled and the UE supports TA reporting:","paragraph_zero_based":1395},{"literal_text_all_w_t_and_m_t":"2>indicate TA report initiation to lower layers;","paragraph_zero_based":1396},{"literal_text_all_w_t_and_m_t":"The UE shall submit the RRCSetupRequest message to lower layers for transmission.","paragraph_zero_based":1397},{"literal_text_all_w_t_and_m_t":"If the UE is an (e)RedCap UE and the RedCap-specific initial downlink BWP is not associated with CD-SSB, the UE may continue cell re-selection related measurements as well as cell re-selection evaluation, otherwise the UE shall continue cell re-selection related measurements as well as cell re-selection evaluation. If the conditions for cell re-selection are fulfilled, the UE shall perform cell re-selection as specified in 5.3.3.6.","paragraph_zero_based":1398},{"literal_text_all_w_t_and_m_t":"NOTE 3:For L2 U2N Remote UE in RRC_IDLE, the cell (re)selection procedure as specified in TS 38.304 [20] and relay (re)selection procedure as specified in 5.8.15.3 are performed independently and up to UE implementation to select either a cell or a L2 U2N Relay UE.","paragraph_zero_based":1399},{"literal_text_all_w_t_and_m_t":"5.3.3.4Reception of the RRCSetup by the UE","paragraph_zero_based":1400},{"literal_text_all_w_t_and_m_t":"The UE shall perform the following actions upon reception of the RRCSetup:","paragraph_zero_based":1401},{"literal_text_all_w_t_and_m_t":"1>if the RRCSetup is received in response to an RRCReestablishmentRequest; or","paragraph_zero_based":1402},{"literal_text_all_w_t_and_m_t":"1>if the RRCSetup is received in response to an RRCResumeRequest or RRCResumeRequest1:","paragraph_zero_based":1403},{"literal_text_all_w_t_and_m_t":"2>if the UE is NCR-MT:","paragraph_zero_based":1404},{"literal_text_all_w_t_and_m_t":"3>indicate to NCR-Fwd to cease forwarding;","paragraph_zero_based":1405},{"literal_text_all_w_t_and_m_t":"2>if sdt-MAC-PHY-CG-Config is configured:","paragraph_zero_based":1406},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the cg-SDT-TimeAlignmentTimer, if it is running;","paragraph_zero_based":1407},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to start the timeAlignmentTimer associated with the PTAG, if it is not running;","paragraph_zero_based":1408},{"literal_text_all_w_t_and_m_t":"2>if srs-PosRRC-Inactive is configured:","paragraph_zero_based":1409},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the inactivePosSRS-TimeAlignmentTimer, if it is running;","paragraph_zero_based":1410},{"literal_text_all_w_t_and_m_t":"2>if srs-PosRRC-InactiveValidityAreaPreConfigList or srs-PosRRC-InactiveValidityAreaNonPreConfig is configured:","paragraph_zero_based":1411},{"literal_text_all_w_t_and_m_t":"3>instruct the MAC entity to stop the inactivePosSRS-ValidityAreaTAT, if it is running;","paragraph_zero_based":1412},{"literal_text_all_w_t_and_m_t":"2>if the UE is configured with multicast reception in RRC_INACTIVE:","paragraph_zero_based":1413},{"literal_text_all_w_t_and_m_t":"3>reset MAC;","paragraph_zero_based":1414},{"literal_text_all_w_t_and_m_t":"2>discard any stored UE Inactive AS context and suspendConfig;","paragraph_zero_based":1415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f85f7590acb53367f1d0904cf0f8c5ca293a828c2a9dc03a43a3e3ea274164b3","4ae78349289fb3e217c5d94c429fc072b82de21bcb846106994ab21cd41d9e14","17471602855b37d07ae86d2405b69d7b7983c5e8d20ebb7329c4b6f63b18cc94","4e8b161d6e4327560cec85be641e22c652d90f097d7681d40b29b1d2ad2dc03a","251a0adec3e2ecdd9d409880e05066195cf9bc0f19e79c228acc178c2b513cdb","bd1ffb3cda604b1e76515f71a9fc9f37338230ec042c36fab069fc1d2488d605","cbfdde96d4dc6b19566b05ff6508f5b9365e69a2323473132648f046b4cfb92f","bf1bfc2c3540bbaf4129e0e85b0c97bcfdbf0a6ca22c352b5cc8350fd5c0294e","40a4ab504603a5fca0171f016b3735977788928fe36616c62dc20222946c8484","2141c445f48c2c85e54b826770c9f44726c0557f5e076b3c0dffecadc66b240c","7f6892bb69e52fb5678157e9acad3a5cca45479bfeb5822aeb85ede46cee3cf6","58b9ab7518e49380250671bb4c4edd93c3c775e4228dd8d3f7b79a7e2d98bbe1","a4098f0fa2711c7ec95062434d5992b60ada088e9c4756fa84f91c4fb6a3d09b","83e955a6032b7650963c060c71e9b2da5752fe1a518b35f03c0aa1953bd62f23","6ca1b9793891b73024c103b0f6397d1fbe974322a1c542b83e48a11b855f52b8","6aa0de6b582369a61b9a6d42c3d30aeffab78bd34e2218b7e22c00fbed51ebcf","c0b8feecdac0ad05bac81355cbdff0c25eb61a5d381b747013990377066c05bf","ba1bd9f16728a7e4a6720b4f1b850b5bb65e74df62f9fa71facbfae10d38ce58","768e397d8d34f788ede811e5b988572b508d72c21042b0f28973ac8c5d90e1d9","e2235d108d6aab77bb90f4bb41d7821c5f3bfbcfd0abf63cc2bf8a8f041889c5","748c63e99293df152cb55336aa6196f13bc6abc31be76a82ea23c9c441c496e9","cf9a41062708ee27052648ab85fe72451eb87a70abe769f651ad8c7249d4646c","f984e81fec512086c51ea387715a2202e2627d44bd400a31c959d223b6661cf9","6b428360cfd75d9b1a18ac0b27a0ae6a4bb3717909e3d057a1b2e28c41f88d74"],"paragraph_range_zero_based":[1392,1415],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p1392"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>discard any current AS security context including the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key;","paragraph_zero_based":1416},{"literal_text_all_w_t_and_m_t":"2>release radio resources for all established RBs except SRB0 and broadcast MRBs, including release of the RLC entities, of the associated PDCP entities and of SDAP;","paragraph_zero_based":1417},{"literal_text_all_w_t_and_m_t":"2>release the RRC configuration except for the default L1 parameter values, default MAC Cell Group configuration, CCCH configuration and broadcast MRBs;","paragraph_zero_based":1418},{"literal_text_all_w_t_and_m_t":"2>indicate to upper layers fallback of the RRC connection;","paragraph_zero_based":1419},{"literal_text_all_w_t_and_m_t":"2>for each application layer measurement configuration with appLayerIdleInactiveConfig absent:","paragraph_zero_based":1420},{"literal_text_all_w_t_and_m_t":"3>forward the measConfigAppLayerId and inform upper layers about the release of the application layer measurement configuration;","paragraph_zero_based":1421},{"literal_text_all_w_t_and_m_t":"3>release the application layer measurement configuration;","paragraph_zero_based":1422},{"literal_text_all_w_t_and_m_t":"3>discard any application layer measurement reports which were not yet fully submitted to lower layers for transmission;","paragraph_zero_based":1423},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to send application layer measurement reports for the measConfigAppLayerId;","paragraph_zero_based":1424},{"literal_text_all_w_t_and_m_t":"2>stop timer T380, if running;","paragraph_zero_based":1425},{"literal_text_all_w_t_and_m_t":"1>perform the cell group configuration procedure in accordance with the received masterCellGroup and as specified in 5.3.5.5;","paragraph_zero_based":1426},{"literal_text_all_w_t_and_m_t":"1>perform the radio bearer configuration procedure in accordance with the received radioBearerConfig and as specified in 5.3.5.6;","paragraph_zero_based":1427},{"literal_text_all_w_t_and_m_t":"1>if stored, discard the cell reselection priority information provided by the cellReselectionPriorities or inherited from another RAT;","paragraph_zero_based":1428},{"literal_text_all_w_t_and_m_t":"1>stop timer T300, T301, T319;","paragraph_zero_based":1429},{"literal_text_all_w_t_and_m_t":"1>if T319a is running:","paragraph_zero_based":1430},{"literal_text_all_w_t_and_m_t":"2>stop T319a;","paragraph_zero_based":1431},{"literal_text_all_w_t_and_m_t":"2>consider SDT procedure is not ongoing;","paragraph_zero_based":1432},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":1433},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":1434},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":1435},{"literal_text_all_w_t_and_m_t":"1>if T302 is running:","paragraph_zero_based":1436},{"literal_text_all_w_t_and_m_t":"2>stop timer T302;","paragraph_zero_based":1437},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":1438},{"literal_text_all_w_t_and_m_t":"1>stop timer T320, if running;","paragraph_zero_based":1439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c5857c311a8c585469030f752df7b2fd5f6f5b68de963b6f746bc90feb706643","c6121ec221a4dfddea68a601cdbce3fb221065cf39a598f349fc2c2ff3147873","72f2f4e7d90911fbe22e48a58f37bbf1d34e2981