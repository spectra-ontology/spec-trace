{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-STOP","paragraph_zero_based":44160},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44163},{"literal_text_all_w_t_and_m_t":"Sensor-NameList field descriptions","paragraph_zero_based":44164},{"literal_text_all_w_t_and_m_t":"measUncomBarPre","paragraph_zero_based":44165},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the uncompensated Barometric pressure measurement as defined in TS 37.355 [49].","paragraph_zero_based":44166},{"literal_text_all_w_t_and_m_t":"measUeSpeed","paragraph_zero_based":44167},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the UE speed measurement as defined in TS 37.355 [49].","paragraph_zero_based":44168},{"literal_text_all_w_t_and_m_t":"measUeOrientation","paragraph_zero_based":44169},{"literal_text_all_w_t_and_m_t":"If configured, the UE reports the UE orientation information as defined in TS 37.355 [49].","paragraph_zero_based":44170},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44171},{"literal_text_all_w_t_and_m_t":"–TraceReference","paragraph_zero_based":44172},{"literal_text_all_w_t_and_m_t":"The TraceReference contains parameter Trace Reference as defined in TS 32.422 [52].","paragraph_zero_based":44173},{"literal_text_all_w_t_and_m_t":"TraceReference information element","paragraph_zero_based":44174},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44175},{"literal_text_all_w_t_and_m_t":"-- TAG-TRACEREFERENCE-START","paragraph_zero_based":44176},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44177},{"literal_text_all_w_t_and_m_t":"TraceReference-r16 ::= SEQUENCE {","paragraph_zero_based":44178},{"literal_tex