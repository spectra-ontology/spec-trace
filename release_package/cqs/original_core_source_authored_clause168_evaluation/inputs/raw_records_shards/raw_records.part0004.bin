{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>set delayBudgetReport to type1 according to a desired value;","paragraph_zero_based":7728},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide overheating assistance information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":7729},{"literal_text_all_w_t_and_m_t":"2>if the UE experiences internal overheating:","paragraph_zero_based":7730},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum secondary component carriers:","paragraph_zero_based":7731},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":7732},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsDL to the number of maximum SCells the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":7733},{"literal_text_all_w_t_and_m_t":"4>set reducedCCsUL to the number of maximum SCells the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":7734},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1:","paragraph_zero_based":7735},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":7736},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1;","paragraph_zero_based":7737},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1;","paragraph_zero_based":7738},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1:","paragraph_zero_based":7739},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":7740},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-1;","paragraph_zero_based":7741},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-1;","paragraph_zero_based":7742},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-2:","paragraph_zero_based":7743},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxBW-FR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":7744},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR2-2;","paragraph_zero_based":7745},{"literal_text_all_w_t_and_m_t":"4>set reducedBW-FR2-2-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR2-2;","paragraph_zero_based":7746},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR1:","paragraph_zero_based":7747},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR1 in the OverheatingAssistance IE;","paragraph_zero_based":7748},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-DL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":7749},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR1-UL to the number of maximum MIMO layers of each serving cell operating on FR1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":7750},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-1:","paragraph_zero_based":7751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be630893dfdb3a8cbf64a7e21986f641d96eea1237c99d3f7c119521c4e0ee7e","6560442de645af23d2ea960bbeeb6b0a21102f220477afa3d833fef50e6aecf6","196777d5d8d5f850a8f8dc7262f6ed464d75e6a6245572c5b818de9a23bec769","300e62e726925778d225825594dd7923e7c5be8d234e68b337d56baf9a0d3917","a4800efa4e90a5811bf3ac434e0efe2eff5f55c27308c704096b369223701aa2","fa10a819ec236ecb8b2802eeaf4c0fcc7e931e2b0daf03eea1e15aa7f2ae858e","82ab54b54c8bf882b65710c073ddafb26586e6efac60974f3e21f97850e45a0f","cccbb8950d8d4b53fc1b1185a68fa134c141d6cb8c1da1ae582b4d5438eb3a96","25b43c54cde13eb67ab5ec9f84270afda8490a158a990e29f077a35b9bf11b30","458a07fbf29f7fb403fdd10da987cd1e4296c2df0ac285ab584200c86e7dd6f4","9c01d00d8dbbcfe215a6f13cd042457a871edd193ab459686a0245c2913675e9","c68597262294270553b3b69a68482a559fa747b19785a5ebf9cebed4ae546cef","de5b1db20fdae27974430101444913d78bd5fd3b56ad9732b155be42eac4093b","4b814c097713fe246e1248c874a2b57f7b3d3511a2ca90a21b23e9ee1708a688","9376757bd5d5d3cab7be141f6370731ea86c17aae363674a4ddef9a024141355","b881d88d788f7e68048386922a8430cb975845919439e4421d0a9daacd130486","e0d5e920e8d570736b26f00984f685d05ed2f295d91c4b7457a4c35259c1c697","89531f5b4f4fa9130d918024c2b73a7836a10a2d8bbafd521f8b749cab658bef","d93f94fc03b6d1f08d14be53c59cbf0087cec8f950d717749e4833ac8f64af65","31f4087023601c2dd02048da48653fcc97cb1c246d30ab9fa9c6874dcaed30ef","ea05023353d9e3a40241126cfae1ef5c6a682a40289279ddeda5b99e6f4a1539","cb2782b34c62cfc9ff742099431923687518947fe23a7248bac4e68221b5841f","504f591b5819c33a9754f261df9daca284288288abddedb920fb149b0897294e","e5752558a6c3d43442864287bb48cecb6ecaf61c138afec2d6d36b84030f6fae"],"paragraph_range_zero_based":[7728,7751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7728"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2 in the OverheatingAssistance IE;","paragraph_zero_based":7752},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-DL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":7753},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-UL to the number of maximum MIMO layers of each serving cell operating on FR2-1 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":7754},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to temporarily reduce the number of maximum MIMO layers of each serving cell operating on FR2-2:","paragraph_zero_based":7755},{"literal_text_all_w_t_and_m_t":"4>include reducedMaxMIMO-LayersFR2-2 in the OverheatingAssistance IE;","paragraph_zero_based":7756},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-DL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":7757},{"literal_text_all_w_t_and_m_t":"4>set reducedMIMO-LayersFR2-2-UL to the number of maximum MIMO layers of each serving cell operating on FR2 the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":7758},{"literal_text_all_w_t_and_m_t":"2>else (if the UE no longer experiences an overheating condition):","paragraph_zero_based":7759},{"literal_text_all_w_t_and_m_t":"3>do not include reducedMaxCCs, reducedMaxBW-FR1, reducedMaxBW-FR2, reducedMaxBW-FR2-2, reducedMaxMIMO-LayersFR1, reducedMaxMIMO-LayersFR2 or reducedMaxMIMO-LayersFR2-2 in OverheatingAssistance IE;","paragraph_zero_based":7760},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide IDC assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7761},{"literal_text_all_w_t_and_m_t":"2>if there is at least one carrier frequency included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":7762},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqList with an entry for each affected carrier frequency included in candidateServingFreqListNR;","paragraph_zero_based":7763},{"literal_text_all_w_t_and_m_t":"3>for each carrier frequency included in the field affectedCarrierFreqList, include interferenceDirection and set it accordingly;","paragraph_zero_based":7764},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":7765},{"literal_text_all_w_t_and_m_t":"3>include victimSystemType for each UL CA or NR-DC combination included in affectedCarrierFreqCombList;","paragraph_zero_based":7766},{"literal_text_all_w_t_and_m_t":"3>if the UE sets victimSystemType to wlan or bluetooth:","paragraph_zero_based":7767},{"literal_text_all_w_t_and_m_t":"4>include affectedCarrierFreqCombList with an entry for each supported UL CA combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":7768},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":7769},{"literal_text_all_w_t_and_m_t":"4>optionally include affectedCarrierFreqCombList with an entry for each supported UL CA or NR-DC combination comprising of carrier frequencies included in candidateServingFreqListNR, that is affected by IDC problems;","paragraph_zero_based":7770},{"literal_text_all_w_t_and_m_t":"2>if there is at least one affected frequency range overlapping with one candidate frequency range included in candidateServingFreqRangeListNR, and the center frequency of the affected frequency range is within the candidate frequency range included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":7771},{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqRangeList with an entry for each affected frequency range;","paragraph_zero_based":7772},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeList, include centerFreq and affectedBandwidth;","paragraph_zero_based":7773},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeList, include interferenceDirection and optionally victimSystemType, and set it accordingly;","paragraph_zero_based":7774},{"literal_text_all_w_t_and_m_t":"2>if there is at least one supported UL CA or NR-DC combinations comprising of candidate frequency ranges included in candidateServingFreqRangeListNR, and each affected frequency range in the UL CA or NR-DC combination overlapping with one candidate frequency range included in candidateServingFreqRangeListNR, and the center frequency of the affected frequency range is within the candidate frequency range included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself:","paragraph_zero_based":7775}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0cbcbb933198fa0c01eaea798ecde615f5416294a87d03b626d0b3a34ec44e4e","8fd0480601743c2ccb732d84f944db57235c07830fc17704857994c928dfd302","812565f9b2698a0658e6445259280fce43e84ae88c5e3614a99d062c86a0d04e","11caefc94e2b26166a48fca8ccef5df2b5b5cb03edc530d8b05e327b3be6091b","de7fed072caa55ad2fef61bb3312cb1206bedbffe748cddc774533e77f406bde","30b761ad10c5a962947f8bc4dd946c7424cc730622faf2315f269d25fdae0218","44794f5dc0e8e88e9689006dfb468a8719b8477a3954c637173bda2fd02b1f91","0e64700b14e6a69961b8aae13f69256f3ec200eecb41290fed7e92cb54d5c16b","1a0e56711b33ef9f4c6d0ad8dd5311f95a046845536b4c9a7c43b00a5143fa5c","f14f8b9a0c5680fb43edabb8203232b06a6eb023f1a7439940d6fa3fc6e9abcb","0b26397d5c05957c3587407ac86c3b3e6bfb216a6fe396ce163b628a069e4357","69ca83001ec8990ed0b1b783f6ffb6fded2569c8fcfdba04d5d3fc8d46886867","727093669ff547bd800835be7102e679ed3d52ec1ae8ab9fe55e12b9a2533108","7be5166f02964bf2250ee614927ea89d00331f0428b80d7d777a45f00d98913e","3de3936142fd95483c555576f1b2e2f3db874674661ce6b7ec5f62d38bd7cf4f","9da71a5be8cadc7e22ea2f7e19044dc3bd5c1bea4bed85954d19c7e29e3fe483","8a9dd2f4e65d33629e5b54575bbce7b966671abb5ccbb87e0bb8d05c182ceab0","fd8ddd1ce76f525a67daca3cbd9adf09dc2f07279c42632e45a88c06f723cfa5","6b2642d940c68203d49d13b3604a5bd41153cf4d3cd38ee7c9af39a9dc90f10a","9929dc71f9657bcd254ca1078dd0d417ffd9cc3a7e96a5f976a12899247023bb","ef427fd7bef7417fb67b275655554a82a032a944f24e5a3b73411280a8c49e78","b52749410492720b82b5bbcf7a85570f8966b6f0a3b49f5d69a0f939effae366","0dabc197fbf671f62b21dd2ac9d6f3a57fa1f06f29e60fb11fd7558c3be8a97e","ee5a643a72d001d86d54d84b4b6e6da17b41d2be439563cad8a986ea089201bf"],"paragraph_range_zero_based":[7752,7775],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7752"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include the field affectedCarrierFreqRangeCombList with an entry for each supported UL CA or NR-DC combination comprising of frequency ranges that is affected by IDC problems;","paragraph_zero_based":7776},{"literal_text_all_w_t_and_m_t":"3>for each affected frequency range included in the field affectedCarrierFreqRangeCombList, include centerFreq and affectedBandwidth;","paragraph_zero_based":7777},{"literal_text_all_w_t_and_m_t":"3>for each UL CA or NR-DC combination included in the field affectedCarrierFreqRangeCombList, include interferenceDirection and optionally victimSystemType, and set it accordingly;","paragraph_zero_based":7778},{"literal_text_all_w_t_and_m_t":"2>if there is at least one candidate carrier frequency included in candidateServingFreqListNR or candidate frequency range included in candidateServingFreqRangeListNR or one supported UL CA or NR-DC combination comprising of candidate carrier frequencies included in candidateServingFreqListNR or candidate frequency ranges included in candidateServingFreqRangeListNR, the UE is experiencing IDC problems that it cannot solve by itself, and affectedCarrierFreqList or affectedCarrierFreqCombList or affectedCarrierFreqRangeList or affectedCarrierFreqRangeCombList is included, and idc-TDM-AssistanceConfig is set to setup:","paragraph_zero_based":7779},{"literal_text_all_w_t_and_m_t":"3>include Time Domain Multiplexing (TDM) based assistance information as indicated by idc-TDM-Assistance that could be used to resolve the IDC problems;","paragraph_zero_based":7780},{"literal_text_all_w_t_and_m_t":"NOTE 1:When sending an UEAssistanceInformation message to inform the IDC problems, the UE includes all IDC assistance information (rather than providing e.g. the changed part(s) of the IDC assistance information).","paragraph_zero_based":7781},{"literal_text_all_w_t_and_m_t":"NOTE 2:Upon not anymore experiencing a particular IDC problem that the UE previously reported, the UE provides an IDC indication with the modified contents of the UEAssistanceInformation message (e.g. by not including the IDC assistance information in the idc-Assistance or idc-FDM-Assistance or idc-TDM-Assistance fields).","paragraph_zero_based":7782},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide drx-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7783},{"literal_text_all_w_t_and_m_t":"2>include drx-Preference in the UEAssistanceInformation message;","paragraph_zero_based":7784},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on DRX parameters for the cell group:","paragraph_zero_based":7785},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the long DRX cycle:","paragraph_zero_based":7786},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-LongCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":7787},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the DRX inactivity timer:","paragraph_zero_based":7788},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-InactivityTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":7789},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX cycle:","paragraph_zero_based":7790},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycle in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":7791},{"literal_text_all_w_t_and_m_t":"3>if the UE has a preference for the short DRX timer:","paragraph_zero_based":7792},{"literal_text_all_w_t_and_m_t":"4>include preferredDRX-ShortCycleTimer in the DRX-Preference IE and set it to the preferred value;","paragraph_zero_based":7793},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference on DRX parameters for the cell group):","paragraph_zero_based":7794},{"literal_text_all_w_t_and_m_t":"3>do not include preferredDRX-LongCycle, preferredDRX-InactivityTimer, preferredDRX-ShortCycle and preferredDRX-ShortCycleTimer in the DRX-Preference IE;","paragraph_zero_based":7795},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide maxBW-Preference of a cell group for power saving according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7796},{"literal_text_all_w_t_and_m_t":"2>include maxBW-Preference in the UEAssistanceInformation message;","paragraph_zero_based":7797},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference on the maximum aggregated bandwidth for the cell group:","paragraph_zero_based":7798},{"literal_text_all_w_t_and_m_t":"3>if the UE prefers to reduce the maximum aggregated bandwidth of FR1:","paragraph_zero_based":7799}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["149c6a3b7d45dc7af5a24204977d99fa7580ae48b3fbe540a5a1fd5d86f86634","14dfec9f0b2817cb9aeff01b713bdc27b8ca7ff3613d7f76d3781940d3e59d2a","bd46f75d946aa726d8035468eddc7c496c4aff5fa1c9c6fc7c84654df8961b37","aebbc96ca8687657374c1673150e18086978552ae2a9b04b579731794854df87","8056c5b76c7bf12a9279d3725cd1973f98e203b36bfdb7df49b1d747a07052a7","63ed559de9dae5665c5355110fc3a657394c0a75aeaa1e96e04a7794d804a545","4771d2216693fdbe29e8e2ac472a5edcdd850cbfee742e830f859721b2730ea5","e48b2bc3b83de1b1ef474dcb961b534008cd0b7f83ffaef933a737bd12c3ff7d","550557bc1a4e3a2a8cd50c601a4516bffcc7e7224caa7b9b33c5feaaa45ccd00","a449c36a0b6aad075ec009b6b13034d8c4