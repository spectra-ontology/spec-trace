{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    searchSpacesToReleaseList           SEQUENCE(SIZE (1..10)) OF SearchSpaceId                          OPTIONAL,   -- Need N","paragraph_zero_based":26976},{"literal_text_all_w_t_and_m_t":"    downlinkPreemption                  SetupRelease { DownlinkPreemption }                              OPTIONAL,   -- Need M","paragraph_zero_based":26977},{"literal_text_all_w_t_and_m_t":"    tpc-PUSCH                           SetupRelease { PUSCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":26978},{"literal_text_all_w_t_and_m_t":"    tpc-PUCCH                           SetupRelease { PUCCH-TPC-CommandConfig }                         OPTIONAL,   -- Need M","paragraph_zero_based":26979},{"literal_text_all_w_t_and_m_t":"    tpc-SRS                             SetupRelease { SRS-TPC-CommandConfig}                            OPTIONAL,   -- Need M","paragraph_zero_based":26980},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":26981},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26982},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToAddModListSizeExt-v1610 SEQUENCE (SIZE (1..2)) OF ControlResourceSet             OPTIONAL,   -- Need N","paragraph_zero_based":26983},{"literal_text_all_w_t_and_m_t":"    controlResourceSetToReleaseListSizeExt-r16 SEQUENCE (SIZE (1..5)) OF ControlResourceSetId-r16        OPTIONAL,   -- Need N","paragraph_zero_based":26984},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-r16     SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-r16                     OPTIONAL,   -- Need N","paragraph_zero_based":26985},{"literal_text_all_w_t_and_m_t":"    uplinkCancellation-r16              SetupRelease { UplinkCancellation-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":26986},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-r16      ENUMERATED { r15monitoringcapability,r16monitoringcapability }   OPTIONAL,   -- Need M","paragraph_zero_based":26987},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r16         SearchSpaceSwitchConfig-r16                                      OPTIONAL    -- Need R","paragraph_zero_based":26988},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":26989},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26990},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1700   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1700                   OPTIONAL,   -- Need N","paragraph_zero_based":26991},{"literal_text_all_w_t_and_m_t":"    monitoringCapabilityConfig-v1710    ENUMERATED { r17monitoringcapability }                           OPTIONAL,   -- Need M","paragraph_zero_based":26992},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchConfig-r17         SearchSpaceSwitchConfig-r17                                      OPTIONAL,   -- Need R","paragraph_zero_based":26993},{"literal_text_all_w_t_and_m_t":"    pdcch-SkippingDurationList-r17      SEQUENCE(SIZE (1..3)) OF SCS-SpecificDuration-r17                OPTIONAL    -- Need R","paragraph_zero_based":26994},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":26995},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":26996},{"literal_text_all_w_t_and_m_t":"    pdcch-MonitoringResumptionAfterNack-r18 ENUMERATED {true}                                            OPTIONAL,   -- Need R","paragraph_zero_based":26997},{"literal_text_all_w_t_and_m_t":"    searchSpacesToAddModListExt-v1800   SEQUENCE(SIZE (1..10)) OF SearchSpaceExt-v1800                   OPTIONAL    -- Need N","paragraph_zero_based":26998},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":26999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["840c9a6ef2c27e5a21c1c5e2fcd25254761e36f5c8f3990daac131b6f56fcf22","a6a6102f54955f12ee6b5822e2c1a104d0eee73962efb74c38e119947f594713","858b0dd546d2a791a0ccd3fd658f8219e050dc44303590c66052ec10ddcbd369","79bd964da88ad4baea8c614e2309f7283f5860c58b8905b12ebee2634557b44e","de5c06ba97352988f6634b566b02b03ce21656718d1ccc0d3d7374b8f5e52482","9a8c06c01176fc6a9e0d82c20be1649b5888cc593780e9315d32dfdab195e7b9","b568a62b5450e0d3b7c6e6388043959fedffa70bdc63837fe91d4a470916d8f1","3a8cbf6780da9ba7b20ef527e983ee1d7ba40bcf2976eded8245cfafe941d4c4","640f71b8ac654ccf277614cf42481ad314e24b351c2aabbe03bf2227f4999a8a","333b896f29609e70631fee1130d9015323b161d4185396e1dc7c41e695143937","ecf6581d9616fb992e1fca98af8e5ea91692e33820306d3f0d0844e549ce7fc3","b414a381908962f3f29be3d1532a20a8bdd2f309988bc538cac1ad1a60dff492","74b9094404ea0e5389c262e113bed12fff3b0d2b522e415b5a6a669bcfd9ee30","13754040bbec0ca22a5e0cac40f0dc79097bf9db91564a3fea7d6e3c84ebb72b","43eee7bf6f4929fe8ecc78467f0d660ea4e952edb2ef0fc4ecaf8bf7d56d8527","3d8b8719501b0e1b9fa9acda7fcae17a7095260682af62d7c0e3f73a46190c82","553593546db327751351225992d74181f2edf8b80d8d3ed4971d31de3fa9b299","39ae3149e1060852eeed6a3767b8caddabaaa28a484ee57f5a7be625e5c500d5","c9413d14a22e42a7b26d57e07018759b49bc88bdaaddfe3dbb043633cef37ca6","0c38b37f0219b23131ac7e975c02845b5d6ee3a4dfa7e06b78d543c91f41392e","16604a5fceebf4ae648337864f7acdf8c399761d4224878692a094ed7b09c4ce","7e745654413c78d3c562fa94e1a9fb48fcb7a42d2e8eb75ba990b9fb9a7d8da9","46cf3548702dff3ce5ce04e794dd40a221ae8b47087558681899e2c67dbefec8","ede16897d5e55ec1647920bd9d4537ed462c30357fe9698a8dee747f2eda08ef"],"paragraph_range_zero_based":[26976,26999],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state 