{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of L2 U2N Remote UEs to be added and modified to the L2 U2N Relay UE.","paragraph_zero_based":45672},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-ToReleaseList","paragraph_zero_based":45673},{"literal_text_all_w_t_and_m_t":"List of L2 U2N Remote UEs to be released by the L2 U2N Relay UE.","paragraph_zero_based":45674},{"literal_text_all_w_t_and_m_t":"sl-U2U-RemoteUE-ToAddModList","paragraph_zero_based":45675},{"literal_text_all_w_t_and_m_t":"List of L2 U2U Remote UEs for which the related configuration is to be added and modified to the L2 U2U Relay UE.","paragraph_zero_based":45676},{"literal_text_all_w_t_and_m_t":"sl-U2U-RemoteUE-ToReleaseList","paragraph_zero_based":45677},{"literal_text_all_w_t_and_m_t":"List of L2 U2U Remote UEs for which the related configuration is to be released by the L2 U2U Relay UE.","paragraph_zero_based":45678},{"literal_text_all_w_t_and_m_t":"sl-U2U-SourceRemoteUE-ToAddModList","paragraph_zero_based":45679},{"literal_text_all_w_t_and_m_t":"List of Source L2 U2U Remote UEs for which the related configuration is to be added and modified.","paragraph_zero_based":45680},{"literal_text_all_w_t_and_m_t":"sl-U2U-SourceRemoteUE-ToReleaseList","paragraph_zero_based":45681},{"literal_text_all_w_t_and_m_t":"List of Source L2 U2U Remote UEs for which the related configuration is to be released.","paragraph_zero_based":45682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45683},{"literal_text_all_w_t_and_m_t":"–SL-L2RemoteUE-Config","paragraph_zero_based":45684},{"literal_text_all_w_t_and_m_t":"The IE SL-L2RemoteUE-Config is used to configure L2 U2N relay operation related configurations used by L2 U2N Remote UE, or L2 U2U relay operation related configurations used by L2 U2U Remote UE.","paragraph_zero_based":45685},{"literal_text_all_w_t_and_m_t":"S