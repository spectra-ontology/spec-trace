{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>include minSchedulingOffsetPreferenceExt in the UEAssistanceInformation message;","paragraph_zero_based":7872},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 (TS 38.214 [19], clause 5.1.2.1) for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":7873},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":7874},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K0 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":7875},{"literal_text_all_w_t_and_m_t":"5>include preferredK0-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K0;","paragraph_zero_based":7876},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 480 kHz SCS:","paragraph_zero_based":7877},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-480kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":7878},{"literal_text_all_w_t_and_m_t":"4>if the UE has a preference for the value of K2 for cross-slot scheduling with 960 kHz SCS:","paragraph_zero_based":7879},{"literal_text_all_w_t_and_m_t":"5>include preferredK2-SCS-960kHz in the minSchedulingOffsetPreferenceExt IE and set it to the desired value of K2;","paragraph_zero_based":7880},{"literal_text_all_w_t_and_m_t":"3>else (if the UE has no preference on the minimum scheduling offset for cross-slot scheduling for the cell group):","paragraph_zero_based":7881},{"literal_text_all_w_t_and_m_t":"4>do not include preferredK0 and preferredK2 in the minSchedulingOffsetPreferenceExt IE;","paragraph_zero_based":7882},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide a release preference according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7883},{"literal_text_all_w_t_and_m_t":"2>include releasePreference in the UEAssistanceInformation message;","paragraph_zero_based":7884},{"literal_text_all_w_t_and_m_t":"2>set preferredRRC-State to the desired RRC state on transmission of the UEAssistanceInformation message;","paragraph_zero_based":7885},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference in being provisioned with reference time information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7886},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference in being provisioned with reference time information:","paragraph_zero_based":7887},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to true;","paragraph_zero_based":7888},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7889},{"literal_text_all_w_t_and_m_t":"3>set referenceTimeInfoPreference to false.","paragraph_zero_based":7890},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on FR2 UL gap according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7891},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for FR2 UL gap configuration:","paragraph_zero_based":7892},{"literal_text_all_w_t_and_m_t":"3>set ul-GapFR2-PatternPreference to the preferred FR2 UL gap pattern;","paragraph_zero_based":7893},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has no preference for the FR2 UL gap configuration):","paragraph_zero_based":7894},{"literal_text_all_w_t_and_m_t":"3>do not include ul-GapFR2-PatternPreference in the UL-GapFR2-Preference IE.","paragraph_zero_based":7895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9363ad0c01523843568701fe2482cfbc231b6cbd66af14c517244a99b2fb9c3e","c6cc1fd9c9a01ec0627c60f610d2de63909c21709cbd7d3026c19ff202d18d5f","392b61dcb2e0de2dd69ec6eaad76de9696d8bb4677a91dbadb2d97750ec64bd9","c5d11f2b56e282dea66dd526bacd1867961256e0ee02ec321efcc59b9af3e2bf","68a32447d9c877149a14254e3b6a68f48050f5000c85e651207866ddb30bc168","ccb02114449f89939b1ffb88906703ad5e248c2abeb292475d5d2efb017c1085","330400fed1b55c6dfb033dbf2ea78c63c35a377138a247e8f71c534a0bb3a880","09e8201a7c04eefbed43d03754f3ef04cda8fe07fb7139ac7f3cbb22dab69cae","7dfb3339ad98fd5822aa3184c008d6e697c471aa7752ffbb7808bcdd1918507a","fc0976a3057f6cef8fd1da01904205873852b9205b0b2ff4c71445ffd1f734d2","e6d1283f79b1fa153e87ea43bd960fcdc99102f394d8dd6b4524a5ead9f24470","4fb1231da533ab6df956c4a77c93f4329f627f5a08da6144941010600e39587e","9c76db5c72ae3d28bc4941b7ba4cf263a63029f67ecbe2f67f2736d7519b88f9","9cbfaf0206fc9e419a288aed8a805cdf79bf4b20150e62d2df9f3b2dd25fa33f","fe8ef6aaf61914f9deb3f4d3d857f799b315648e7c95776a92631a5d56d8d58e","6a2b693860b5e4c36704ea4fd528293b27db82cf54024c85cdceaffcd2bb5b4d","f1f53e1853772f752ff36f2b63378ba04646883aea2bd01af94d3373d22e55f9","86ad8bcf1192ca8afe3631dae86f7f5cbe04d6431d4d2f37146f186eddc86cca","eecd07094b9c7ad29674f56743bfe8c43885fadb93df296202b34b6a49c372a1","e80b353a152ebba8805c9f4e76e0a98f1742663a8d97b288c5d46197b62cbc65","36bb300e583b7fb2b82303ccb0b307fc9811b42b164076201cbf5f432a1457d2","6633780eb3fd76e5b1b8775cd3fb3b2eb6cd3d5211c1b986af4f498150eac96f","35210eccd488e22d30fed88e34b1fc94cd772050aa248c63761f37f84a9ff14a","cea7063f714c236bd16f22a14c53277c5ce5311d1846d8e52186ea63685e61aa"],"paragraph_range_zero_based":[7872,7895],"projection":"All w:t and m:t including tracked insertion/