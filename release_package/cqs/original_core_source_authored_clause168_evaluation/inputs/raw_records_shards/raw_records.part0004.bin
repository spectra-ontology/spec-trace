{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is used to transfer UE capability information used for paging. The gNB generates the ue-RadioPagingInfo and the contained UE capability information is absent when not supported by the UE.","paragraph_zero_based":53064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53065},{"literal_text_all_w_t_and_m_t":"–UERadioAccessCapabilityInformation","paragraph_zero_based":53066},{"literal_text_all_w_t_and_m_t":"This message is used to transfer UE radio access capability information, covering both upload to and download from the 5GC.","paragraph_zero_based":53067},{"literal_text_all_w_t_and_m_t":"Direction: ng-eNB or gNB to/ from 5GC","paragraph_zero_based":53068},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation message","paragraph_zero_based":53069},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":53070},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-ACCESS-CAPABILITY-INFORMATION-START","paragraph_zero_based":53071},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53072},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation ::= SEQUENCE {","paragraph_zero_based":53073},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":53074},{"literal_text_all_w_t_and_m_t":"        c1                                  CHOICE{","paragraph_zero_based":53075},{"literal_text_all_w_t_and_m_t":"            ueRadioAccessCapabilityInformation    UERadioAccessCapabilityInformation-IEs,","paragraph_zero_based":53076},{"literal_text_all_w_t_and_m_t":"            spare7 NULL,","paragraph_zero_based":53077},{"literal_text_all_w_t_and_m_t":"            spare6 NULL, spare5 NULL, spare4 NULL,","paragraph_zero_based":53078},{"literal_text_all_w_t_and_m_t":"            spare3 NULL, spare2 NULL, spare1 NULL","paragraph_zero_based":53079},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":53080},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":53081},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":53082},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":53083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53084},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation-IEs ::= SEQUENCE {","paragraph_zero_based":53085},{"literal_text_all_w_t_and_m_t":"    ue-RadioAccessCapabilityInfo               OCTET STRING (CONTAINING UE-CapabilityRAT-ContainerList),","paragraph_zero_based":53086},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                       SEQUENCE {}                                                   OPTIONAL","paragraph_zero_based":53087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ec008ec691a2eafa5386f35ddee1ef01d41c2cc62d9588db00561f3679c003d8","4887c558212d61c46d7348f6900bf0ba9ededc9b5ffa2ba5b4d0619efa0de943","4ce96fa3f99f49dc12cd120cd685b136cdd89452858025c90feeaac82010ea0a","3b05e3b2675d4b131de67a07b5a4a418da85b31d5444a08118664d05df5d996b","55143ca6fe3497edfeb401b495c73ddaf4b1c6d227db05ead0177e5d41798f0b","35bf88d8cfe7b1873434a5dcc97d27b8dc1d0e86d19411a1a8697e7ea32f6f93","90d13a8ce80267acaff5ebd3887728cf1a5f73b2a087f05fc9704bd4af8bfc1c","817a1d40c70f4c0776645d04067221af1d637a340568b3966ce145025c0c8a5f","986949bee6adf00bd22cd1ddd11900f9fb75416d5305d9a0be04f26a6ac2c611","2cd937600efc56e9dd5b209168632e81035dc588a7a26cd584669517a1cd5aa3","99f51356756418eae207d55349d426368b44f61c7a4b8afb7411754d66f06c1f","d0282a674ec0b050a9876d01edb1e2f2d9c29b67f9a016cd3600a8ec90570cc0","bea6dde5896e20b235193a8651271bdb0852a68ef48986632c14474e130fd7fd","09cc18dbf86088ae7098741213498b90497307f75d2ed78be4f101180f3a98f5","85af2d14df37e7127f3ea4b751dea5815fa677a504fafa92b8a652cd78f7a85a","e16dce188e0c5c91f13e21b8f8ca2d313629cb6856b4ca7b1568cca3fb0b4fce","f93309267138b15a6d59b30fd1ea2e6529d9f29fed141f217c3b61a7c353eff1","79bedadf980525ba48bdf3cbf487cd7f5704aeb23ab4f360de4923c4243f75cd","fde320bd541d1da3402822881672ed0b85f62380bbc59adb06f2934c5328b5f9","28429250881b61f06750488857a7e6130c0ee02286f0bbedee72d9fff8bb18dc","fc19529e7df0fbd9ccfa1474bc4207abde4753590f44d1b7b4beba3fdee82134","798ac32a0f7b8f49b6fdb34524bb68e36c0342a7a6c46a2d89db2b74b7d0756a","4256f4a5c34feebbce198ea6ae9c33e76fd97213c704d8e8bf0c378810c647e2","09834113d66112d00e9cd50372c2b9b2a3aa16bfb97e9ec397c4373bd9ddf635"],"paragraph_range_zero_based":[53064,53087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p53064"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":53088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53089},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-RADIO-ACCESS-CAPABILITY-INFORMATION-STOP","paragraph_zero_based":53090},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":53091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53092},{"literal_text_all_w_t_and_m_t":"UERadioAccessCapabilityInformation-IEs field descriptions","paragraph_zero_based":53093},{"literal_text_all_w_t_and_m_t":"ue-RadioAccessCapabilityInfo","paragraph_zero_based":53094},{"literal_text_all_w_t_and_m_t":"Including NR, MR-DC, E-UTRA radio access capabilities. A gNB that retrieves MRDC related capability containers ensures that the set of included MRDC containers is consistent w.r.t. the feature set related information.","paragraph_zero_based":53095},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":53096},{"literal_text_all_w_t_and_m_t":"11.2.3Mandatory information in inter-node RRC messages","paragraph_zero_based":53097},{"literal_text_all_w_t_and_m_t":"For the AS-Config transferred within the HandoverPreparationInformation:","paragraph_zero_based":53098},{"literal_text_all_w_t_and_m_t":"-The source node shall include all fields necessary to reflect the current AS configuration of the UE, except for the fields sourceSCG-NR-Config, sourceSCG-EUTRA-Config and sourceRB-SN-Config, which can be omitted in case the source MN did not receive the latest configuration from the source SN. For RRCReconfiguration included in the field rrcReconfiguration, ReconfigurationWithSync is included with only the mandatory subfields (e.g. newUE-Identity and t304) and ServingCellConfigCommon;","paragraph_zero_based":53099},{"literal_text_all_w_t_and_m_t":"-Need codes or conditions specified for subfields according to IEs defined in clause 6 do not apply. I.e. some fields shall be included regardless of the \"Need\" or \"Cond\" e.g. discardTimer;","paragraph_zero_based":53100},{"literal_text_all_w_t_and_m_t":"-Based on the received AS configuration, the target node can indicate the delta (difference) to the current AS configuration (as included in HandoverCommand)to the UE. The fields newUE-Identity and t304 included in ReconfigurationWithSync are not used for delta configuration purpose.","paragraph_zero_based":53101},{"literal_text_all_w_t_and_m_t":"The candidateCellInfoListSN(-EUTRA) in CG-Config and the candidateCellInfoListMN(-EUTRA)/candidateCellInfoListSN(-EUTRA) in CG-ConfigInfo need not be included in procedures that do not involve a change of node.","paragraph_zero_based":53102},{"literal_text_all_w_t_and_m_t":"For fields scg-CellGroupConfig, scg-CellGroupConfigEUTRA and scg-RB-Config in CG-Config (sent upon SN initiated SN change or other conditions as specified in field descriptions) and fields mcg-RB-Config, scg-RB-Config and sourceConfigSCG in CG-ConfigInfo (sent upon change of SN):","paragraph_zero_based":53103},{"literal_text_all_w_t_and_m_t":"-The source node shall include all fields necessary to reflect the current AS configuration of the UE, unless stated otherwise in the field description. For RRCReconfiguration included in the field scg-CellGroupConfig in CG-Config, ReconfigurationWithSync is included with only the mandatory subfields (e.g. newUE-Identity and t304) and ServingCellConfigCommon;","paragraph_zero_based":53104},{"literal_text_all_w_t_and_m_t":"-Need codes or conditions specified for subfields according to IEs defined in clause 6 do not apply;","paragraph_zero_based":53105},{"literal_text_all_w_t_and_m_t":"-Based on the received AS configuration, the target node can indicate the delta (difference) as compared to the current AS configuration to the UE. The fields newUE-Identity and t304 in ReconfigurationWithSync are always included by the target node, i.e. they are not used for delta configuration purpose to UE.","paragraph_zero_based":53106},{"literal_text_all_w_t_and_m_t":"For fields in CG-Config and CG-ConfigInfo listed below, absence of the field means that the receiver maintains the values informed via the previous message. Note that every time there is a change in the configuration covered by a listed field, the MN or SN shall include the field and it shall provide the full configuration provided by that field unless stated otherwise. Otherwise, if there is no change, the field can be omitted:","paragraph_zero_based":53107},{"literal_text_all_w_t_and_m_t":"-configRestrictInfo;","paragraph_zero_based":53108},{"literal_text_all_w_t_and_m_t":"-gapPurpose;","paragraph_zero_based":53109},{"literal_text_all_w_t_and_m_t":"-measGapConfig (for which delta signaling applies);","paragraph_zero_based":53110},{"literal_text_all_w_t_and_m_t":"-measGapConfigFR2 (for which delta signaling applies);","paragraph_zero_based":53111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2da07477eabe8d3bdee4f63f1cd3eabf31294ef0f46ad3b6df7e125134bdbc67","6697cd11104865e29597ab6fb743d00adc4f51f8df4f9f2b3e1737debc31edb4","8108417c0d9e527bf6ed0d9b7a5f59b812fd4446c251ae374cad7cdd7dad5904","1b2bbb714b679fa78144da2210893d16fdb52fece212a3ecb0a5f5664a3c58e6","5c1ec7fb034d2ec9ce25e4d00b84ca64af9baf62c0f9d86749eccd6831f9f2a3","3704fccf857b3888a792bdcb89f675db019140e3f4e3e9ffa5a45e279db61c99","c5def7b327d5a635240f2f6d5de8e8da565a16766d4050f7cd918a90a4ed0486","a79a9cce4c88323a869490dd492c1810202f4b523d0ea65fab7d537428b85ef0","6c21f58b095b8bc0c0bcdd14deeb45a7acc6fd021248f4779c50ed27c69ec0d1","02fc92c86755f0be2a52898c69051f694cd35ce0e74