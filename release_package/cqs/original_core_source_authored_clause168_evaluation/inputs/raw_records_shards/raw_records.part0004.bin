{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"npn-IdentityList","paragraph_zero_based":26784},{"literal_text_all_w_t_and_m_t":"The npn-IdentityList contains one or more NPN Identity elements.","paragraph_zero_based":26785},{"literal_text_all_w_t_and_m_t":"trackingAreaCode","paragraph_zero_based":26786},{"literal_text_all_w_t_and_m_t":"Indicates the Tracking Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":26787},{"literal_text_all_w_t_and_m_t":"ranac","paragraph_zero_based":26788},{"literal_text_all_w_t_and_m_t":"Indicates the RAN Area Code to which the cell indicated by cellIdentity field belongs. ","paragraph_zero_based":26789},{"literal_text_all_w_t_and_m_t":"cellReservedForOperatorUse","paragraph_zero_based":26790},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved for operator use (for the NPN(s) identified in the npn-IdentityList) as defined in TS 38.304 [20]. This field is ignored by NPN capable IAB-MT and NPN capable NCR-MT.","paragraph_zero_based":26791},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26792},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-PDC-Info","paragraph_zero_based":26793},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-PDC-Info defines downlink PRS configuration for PDC.","paragraph_zero_based":26794},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-Info information element","paragraph_zero_based":26795},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26796},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-DL-PRS-PDC-INFO-START","paragraph_zero_based":26797},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26798},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-Info-r17 ::=    SEQUENCE {","paragraph_zero_based":26799},{"literal_text_all_w_t_and_m_t":"    nr-DL-PRS-PDC-ResourceSet-r1