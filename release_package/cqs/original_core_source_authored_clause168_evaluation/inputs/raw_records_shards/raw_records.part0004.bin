{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SERVCELLINDEX-STOP","paragraph_zero_based":32904},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32906},{"literal_text_all_w_t_and_m_t":"–ServingCellConfig","paragraph_zero_based":32907},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfig is used to configure (add or modify) the UE with a serving cell, which may be the SpCell or an SCell of an MCG or SCG. The parameters herein are mostly UE specific but partly also cell specific (e.g. in additionally configured bandwidth parts). Reconfiguration between a PUCCH and PUCCHless SCell is only supported using an SCell release and add.","paragraph_zero_based":32908},{"literal_text_all_w_t_and_m_t":"ServingCellConfig information element","paragraph_zero_based":32909},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32910},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIG-START","paragraph_zero_based":32911},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32912},{"literal_text_all_w_t_and_m_t":"ServingCellConfig ::=               SEQUENCE {","paragraph_zero_based":32913},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationDedicated    TDD-UL-DL-ConfigDedicated                                                OPTIONAL,   -- Cond TDD","paragraph_zero_based":32914},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP                  BWP-DownlinkDedicated                                                    OPTIONAL,   -- Need M","paragraph_zero_based":32915},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToReleaseList           SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Id                               OPTIONAL,   -- Need N","paragraph_zero_based":32916},{"literal_text_all_w_t_and_m_t":"    downlinkBWP-ToAddModList            SEQUENCE (SIZE (1..maxNrofBWPs)) OF BWP-Downlink                         OPTIONAL,   -- Need N","paragraph_zero_based":32917},{"literal_text_all_w_t_and_m_t":"    firstActiveDownlinkBWP-Id           BWP-Id                                                                   OPTIONAL,   -- Cond SyncAndCellAdd","paragraph_zero_based":32918},{"literal_text_all_w_t_and_m_t":"    bwp-InactivityTimer                 ENUMERATED {ms2, ms3, ms4, ms5, ms6, ms8, ms10, ms20, ms30,","paragraph_zero_based":32919},{"literal_text_all_w_t_and_m_t":"                                                    ms40,ms50, ms60, ms80,ms100, ms200,ms300, ms500,","paragraph_zero_based":32920},{"literal_text_all_w_t_and_m_t":"                                                    ms750, ms1280, ms1920, ms2560, spare10, spare9, spare8,","paragraph_zero_based":32921},{"literal_text_all_w_t_and_m_t":"                                                    spare7, spare6, spare5, spare4, spare3, spare2, spare1 }    OPTIONAL,   --Need R","paragraph_zero_based":32922},{"literal_text_all_w_t_and_m_t":"    defaultDownlinkBWP-Id               BWP-Id                                                                  OPTIONAL,   -- Need S","paragraph_zero_based":32923},{"literal_text_all_w_t_and_m_t":"    uplinkConfig                        UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":32924},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfig                                                            OPTIONAL,   -- Need M","paragraph_zero_based":32925},{"literal_text_all_w_t_and_m_t":"    pdcch-ServingCellConfig             SetupRelease { PDCCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":32926},{"literal_text_all_w_t_and_m_t":"    pdsch-ServingCellConfig             SetupRelease { PDSCH-ServingCellConfig }                                OPTIONAL,   -- Need M","paragraph_zero_based":32927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2a6a49473066bd03e9d25444d6279e7a8d58363e1b7821c3811dfec69e6184db","c40483945061ebd00ea59f7042eb1315c5ba1935a0d06edeff126c181a54c3ba","b4190e00eecd5d00c5cc74918255faf5b09a72bf001c920cc2675cc4b012d4e7","65eeda90b64ec4b6fe6f1fbe07619bb11e9f9e7bf94b1d5e6b5ccd51ce80ad80","9b301a05180a130c33b7e597e33cb9d54c4eee1d12868e980c77b436a754e5a8","382f594dca2fadc6f29f30256be8c7fa8bf4b8c4d9fd1e9a7121011f6fb1d7ca","ff572dca06a4506ff4b8db5f619ef06ebbd3bd32c5f617c26dfde5dd2d23bb35","235a5923efca8d8f9ba46aeb7e52f038bd5882c3d9aa5beca6cc905aa29f882e","c9e4133bb974dbd209bdb0982ef753c149f35062784e3b385640d2260e77860e","c0dbeb8025f880c30cb9bb3d2d673b396b5aab864d820aee01457fa9cb3da3ae","d889de1659a1a504e1301f11e1663f485dfa2ee30b9ad1189443bf6d0b7a941d","a47abccb86dd569de5b5cd681e0f4839553baecd38eded748ff056e18a533a24","f3754e25729e16078c44bdd2d6100afe4f4bf18c3fab7007e244df308050fc26","c6eff114e9342beea8b18f60eded6c66308136834f76a91f838b5ed0ddce049f","5ed894bcd8dbefd5c69ac8e0635f6c642413ec5281f33d3118eeba0c5887811f","bfa269b674b93db3c36ae97e2d96b8f02b4ff68b5cb07ecc8513ba51651e1e6a","7dae007b160331af260e11ad490127595d4b6eef3099940cf272662a5b8b961c","9ef6a2b30a06c5da37c65d81c85ece5a60b98cd176828b6fb67c203bdc944237","e918cf3be556fef534efd31bc5181858bd1784bb073ae6085d2562498d08e909","1c458d3757baa8a29170a130a97b7d36120285b791269e45f773aa41309201b5","2b0e6c862e5b660e71aa32935b8a4d8ce6a23f244cdf77aff2b06d4f3d8f7bcb","ba099a2e6b68be13d4f096cad2a1237fc2fe38b94750375488a45ac8e11caad5","defe704be20a84c379e987b9bbcff96b8a7d48e73a55e4e128c7ecbf74d7edab","e88c34ed343b5081e68953f5226f42c0639970b4d7848cee16c5206a