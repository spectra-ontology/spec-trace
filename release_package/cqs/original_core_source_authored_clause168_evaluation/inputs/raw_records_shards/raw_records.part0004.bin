{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"(show related CRs)","paragraph_zero_based":96},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":97},{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":98},{"literal_text_all_w_t_and_m_t":" O&M Specifications","paragraph_zero_based":99},{"literal_text_all_w_t_and_m_t":"TS/TR ... CR ... ","paragraph_zero_based":100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":102},{"literal_text_all_w_t_and_m_t":"Other comments:","paragraph_zero_based":103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":106},{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":111},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":113},{"literal_text_all_w_t_and_m_t":"3Definitions, symbols and abbreviations","paragraph_zero_based":114},{"literal_text_all_w_t_and_m_t":"3.1Definitions","paragraph_zero_based":115},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the terms and definitions given in TR 21.905 [1] and the following apply. A term defined in the present document takes precedence over the definition of the same term, if any, in TR 21.905 [1].","paragraph_zero_based":116},{"literal_text_all_w_t_and_m_t":"2Rx XR UE: Two antenna port XR UE as specified in TS 38.101-1 [15]. ","paragraph_zero_based":117},{"literal_text_all_w_t_and_m_t":"A2X communication: A communication to support A2X services leveraging PC5 reference points, as defined in TS 23.256 [76]. A2X services are realized by various types of A2X applications, e.g., BRID or DAA.","paragraph_zero_based":118},{"literal_text_all_w_t_and_m_t":"Additional RLC bearer: If the sidelink PDCP entity is associated with two sidelink RLC entities, the additional RLC bearer is the RLC bearer configured by sl-RLC-BearerToAddModListSizeExt in sl-ConfigDedicatedNR, or sl-RLC-BearerConfigListSizeExt in SIB12 or in SidelinkPreconfigNR.","paragraph_zero_based":119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["75959f88c57540fe62c37ad620c3d213603e6d8ad1e8f313de20b39383f7d7c7","8d1acfb8dc3094c729c3f8ca0c9b8b9743cf8ad880f47d9f44043e17b5eba4e9","4ccc9699359875dd18b78fc63375b00d104c4a9ac5dd6db561c5f036fe574c9c","abcd4760a7a67ee19813e3911be03f07322c05695c446553f9a295515f6c286f","6d1257f78ff80446a7270fb93649201d1e8e7b294e3d7e248335431ebbb4168f","52193f594ed39770e5d2dee7c47f885d9981de2dd14ef188ff93df9b2a50aa80","1d8c82b1d33851c6f52d3cd18614ea49e8fbb9aa61ce0a9207dc6e5ec17a07cc","6de8a63bc5027db7cbe12337e61ad76082eba49ce9478869e17bbf340b3d7054","b96cda392a4c031084dcb6ee46a771e2d19adc39099ce91c59e1a80d13f883c2","0af2891c2a0729c11b12b5b3198fcb9e1bdaa795bdd6292e0950f30d4e2014ac","6ac220a25a84d71ed0acdabbf9e2b538821e596971f597df19e35d9d3f83f5fb","c14bb4489c9d5f5e6440596335dea760ecdd17fd10d3e74a4ea8fbb852cfd3eb","53933607c9f660df1cbbbdd9a23fb02a3c24ccf17ab4ba402f68b305d32ac9b9","045e1f190af776042e3bef78e1a9d0f396aca98e6a3d899f58e0249a9972e570","e4d9f8a5d6eadac1be492154ead69ff084427e66ab4412520ff666ef108676c8","c3d1e88d6e230e0aaf43fdbe1a892a3422401e8671323152ea43a6b126d7e1cd","ea5fc2e3998bad8aa56aa7a09d05afb7d1f410ddcdb8889b33ebcf5aeab10845","18fe44e8d220899367bc0cdcd32f217619d423f4bff37b0fc3717bbf89dff42b","41a1fa40e0d8eeaafb763943ce87b11671eb0fa38124ef14e415272291975812","c4938dd73e7d13133a7414c51759292716f0a62fe18b321f190bfa83e61ee78d","51ae37455b61d93f4e2a5c4cf981ddbb2d01faa15a80fc9936cb19ff6b7c69be","71889382af7820cecae1d4521067fa0e7b4311e7d68b3a2cf6e799c0190ef4b3","88204c88c3711c800fbf752d0d39eed546d2ce2aa7efbc04bb3fdc351d153804","3afadc570338942aef86f5f33f576dc7792414383e83ac19b5dddf37e226fdcd"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p96"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Aerial UE: UE performing Aerial UE communication, as defined in TS 38.300 [2], clause 16.18 and TS 23.256 [76].","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"AM MRB: An MRB associated with at least an AM RLC bearer for PTP transmission.","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"BH RLC channel: An RLC channel between two nodes, which is used to transport backhaul packets.","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"Broadcast MRB: A radio bearer configured for MBS broadcast delivery.","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"CEIL: Mathematical function used to 'round up' i.e. to the nearest integer having a higher or equal value.","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"DAPS bearer: a bearer whose radio protocols are located in both the source gNB and the target gNB during DAPS handover to use both source gNB and target gNB resources.","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"Data Burst: A set of multiple PDUs generated and sent by the application in a short period of time, as defined in TS 23.501 [32].","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"Dedicated signalling: Signalling sent on DCCH logical channel between the network and a single UE.","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"Dormant BWP: The dormant BWP is one of downlink BWPs configured by the network via dedicated RRC signalling. In the dormant BWP, the UE stops monitoring PDCCH on/for the SCell, but continues performing CSI measurements, Automatic Gain Control (AGC) and beam management, if configured. For each serving cell other than the SpCell or PUCCH SCell, the network may configure one BWP as a dormant BWP.","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"eRedCap UE: A UE with enhanced reduced capabilities as specified in clause 4.2.22.1 in TS 38.306 [26].","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"Field: The individual contents of an information element are referred to as fields.","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"FLOOR: Mathematical function used to 'round down' i.e. to the nearest integer having a lower or equal value.","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"Frequency Selection Area ID: An identity used for broadcast MBS session to guide the frequency selection of the UE as defined in TS 23.247 [67].","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"Global cell identity: An identity to uniquely identifying an NR cell. It is consisted of cellIdentity and plmn-Identity of the first PLMN-Identity in plmn-IdentityList in SIB1.","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"Information element: A structural element containing single or multiple fields is referred as information element.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"Candidate configuration: A configuration part of an RRCReconfiguration message associated with a candidate cell, e.g., for LTM or subsequent CPAC. A candidate configuration can be a complete candidate configuration or a delta configuration relatively to a reference configuration.","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"Reference configuration: A configuration provided by the network to the UE that is common, within the same cell group, to a group of configured non-complete candidate configurations.","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"MBS Radio Bearer: A radio bearer that is configured for MBS delivery.","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"Mobile IAB-MT: mobile IAB-node function that terminates the Uu interface to the parent node using the procedures and behaviours specified for UEs unless stated otherwise. The mobile IAB-MT uses the same procedures and behaviours specified for the IAB-MT, unless explicitly stated otherwise.","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"Mobile IAB-node: RAN node that supports NR access links to UEs and an NR backhaul link to a parent node, and that can conduct physical mobility across the RAN area. The mobile IAB-node function used in 38-series of 3GPP Specifications corresponds to the MBSR function defined in TS 23.501 [32]. The mobile IAB-node uses the same procedures and behaviours specified for the IAB-node, unless explicitly stated otherwise.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"Multicast/Broadcast Service: A point-to-multipoint service as defined in TS 23.247 [67].","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"Multicast MRB: A radio bearer configured for MBS multicast delivery.","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"MUSIM gap: Period that the UE may use to perform MUSIM operations.","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"Multi-path: Mode of operation of a UE in RRC_CONNECTED configured with one direct path on which the UE connects to gNB using NR Uu, and one indirect path on which the UE connects to the same gNB via another UE using PC5 unicast link or Non-3GPP Connection.","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c3776072bceeabbf9d3396cff6b6a354ff999f6e7874aeb600d54a64c0354cbe","e0422d3cfec33efd51c8c929ab96885ca9917500328e35629e65bc60aa39e847","5e220012b4321247dec60d1075b03e2020bc8660e70470790aecb99c5ac27a2c","1b7f4ac8abeb6fb58683f7fd98a7eb71122ad3f4708def0301251a652f068710","34569a8f13a56542307e40afdc35b567a02a1fd1f5c0e6f048f483e767e2d465","80d7e0ef8d5e9017f0721ec1bf6e73f941f48bcf8f2a28fdce24eac105e9794c","b9a52c770e1a25fad0d28b692fedc6075daea5d0cfece68e6f27a452a62674f2","e781c3f2ca00ff465cb894b50fd44ef94c7fffb481d5753c161c029c2bf5d25c","3d422efef2de7579ce4303aff01ed0100f3ff2573984fefd3233f1092f1ddf3b","63b41552ec0bd283d25453991b2ce7071f0b937d1b4377a81e5ebed8639340c5","cbcefc8f933c1d9fca556bde79db1167c108a88fc2c00d19fd6d997748f91c66","907704db4a32ee0d20494c46bfc7edb0d513892f4c5eafb932c919d27997140e","c9b1c1e09972846cf177555d070a9c8d009e8c083be2983a75d1e6bf2b9948a9","b2615063fddd5110f70d1af15a9bda3418a24237dcca5a35ad416ff5d843c129","4107ceac5388bfc1dc825e5c72608be953f58a9f0ce0c8303dcfb7dffc1c665a","d28fa15be897d6fd8ac9969859b380ed10f002dc8b044a46bc4c5dad33e5f6dd","b4b9b7925f99e7d8bc33a76579cf5bb0ee930168b69c19e0d10ea78b485b8dc5","e805bd1e439ddefd4a3273340fae26f453645e5473a3e0d2b27c82c4cc8ef367","75614fccec3f0ce8409966b1f952d0195a2de6c7cb5342c904750a36b32108c8","e673aaecf4012e07c1fd94df7f11af48ccf7ab626f84bdbefa935c6773e3ea90","38e0a489ef3e96f0a9a3e650441e413a60284f58f7c4b30b6bd9154058233737","250f00027ee618da5f140b004284fdf9205efc521c99214eb5ab948695940d6a","a24144733b7511372824a5ad436c2b7ee477e43e1fc38c09643d6c611a47d1bf","1ea13a0ba9a806f44154316bcc42250604d966634e7f52ddc65d0ee0082578ee"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MP remote UE: A UE configured with Multi-path. When the connectivity of indirect path is PC5 unicast link, the MP remote UE is acting as a L2 U2N Remote UE. When the connectivity of indirect path is Non-3GPP Connection, the MP remote UE is acting as a N3C remote UE.","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"MP relay UE: A UE that provides connectivity of indirect path to a MP remote UE. When the connectivity is PC5 unicast link, the MP relay UE is acting as a L2 U2N Relay UE. When the connectivity is Non-3GPP Connection, the MP relay UE is acting as a N3C relay UE.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"NCSG: Network controlled small gap as defined in TS 38.133 [14].","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"NPN-only Cell: A cell that is only available for normal service for NPNs' subscriber. An NPN-capable UE determines that a cell is NPN-only Cell by detecting that the cellReservedForOtherUse IE is set to true while the npn-IdentityInfoList IE is present in CellAccessRelatedInfo.","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"N3C indirect path: In Multi-path, the indirect path using Non-3GPP Connection between remote UE and relay UE.","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"NR sidelink communication: AS functionality enabling at least V2X Communication as defined in TS 23.287 [55] and/or A2X Communication as defined in TS 23.256 [76] and/or ProSe Communication (including ProSe UE-to-Network Relay, non-Relay communication, and ProSe UE-to-UE Relay Communication including UE-to-UE Relay communication with integrated discovery) as defined in TS 23.304 [65] between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"NR sidelink discovery: AS functionality enabling ProSe non-Relay Discovery, ProSe UE-to-Network Relay discovery and ProSe UE-to-UE Relay discovery for Proximity based Services as defined in TS 23.304 [65] between two or more nearby UEs, using NR technology but not traversing any network node.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"NR sidelink positioning: AS functionality which determines geographical or relative location and possibly velocity of a target UE or ranging via PC5 interface using SL-PRS transmission and reception as defined in TS 38.305 [73] and TS 38.355 [77].","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"PNI-NPN identity: an identifier of a PNI-NPN comprising of a PLMN ID and a CAG-ID combination.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"Primary Cell: The MCG cell, operating on the primary frequency, in which the UE either performs the initial connection establishment procedure or initiates the connection re-establishment procedure.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"PC5 Relay RLC channel: An RLC channel between L2 U2N Remote UE and L2 U2N Relay UE, or between L2 U2U Remote UE and L2 U2U Relay UE, which is used to transport packets over PC5 for L2 UE-to-Network relay or L2 UE-to-UE relay.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"PDU Set: one or more PDUs carrying the payload of one unit of information generated at the application level (e.g. frame(s) or video slice(s) for XR Services), as defined in TS 23.501 [32].","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"Primary SCG Cell: For dual connectivity operation, the SCG cell in which the UE performs random access when performing the Reconfiguration with Sync procedure.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"Primary Timing Advance Group: Timing Advance Group containing the SpCell.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"PUCCH SCell: An SCell configured with PUCCH by PUCCH-Config.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"PUSCH-Less SCell: An SCell configured without PUSCH.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"RedCap UE: A UE with reduced capabilities as specified in clause 4.2.21.1 in TS 38.306 [26].","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"RLC bearer configuration: The lower layer part of the radio bearer configuration comprising the RLC and logical channel configurations.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"Secondary Cell: For a UE configured with CA, a cell providing additional radio resources on top of Special Cell.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"Secondary Cell Group: For a UE configured with dual connectivity, the subset of serving cells comprising of the PSCell and zero or more secondary cells.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"Serving Cell: For a UE in RRC_CONNECTED not configured with CA/DC there is only one serving cell comprising of the primary cell. For a UE in RRC_CONNECTED configured with CA/ DC the term 'serving cells' is used to denote the set of cells comprising of the Special Cell(s) and all secondary cells.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"Small Data Transmission: A procedure used for transmission of data and/or signalling over allowed radio bearers in RRC_INACTIVE state (i.e. without the UE transitioning to RRC_CONNECTED state).","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"SNPN identity: an identifier of an SNPN comprising of a PLMN ID and an NID combination.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"SL indirect path: In Multi-path, the indirect path using PC5 unicast link between remote UE and relay UE.","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0b23c8023ac0923490ea77d7c896e126299bee6e10da0dbecbe8cc3d2028df00","0a430ab2503e3db1550bf6ee47394b37e23b3b4daaf919ccb403c74f032f4236","5a7664590dd28d183a44c817a98e9660948b60d0a75b665730ea2f45458d37b5","7f7ebd882c1bd1659c600c854f335a1d48dd6f0ff6e69cebc2798455b37da546","d4c9a5058f9946e4669c1ae15851c6ee405fdc5093d64905d588df2e8de6d86c","d37da07564e776c237f0d72a0ae7e2460bd4a277f82e9ad3f8c4a4bcaad83d3f","c123c051d8593a4720758043ef83216f8d9e209cffcc94ae6cd3891f43e1e62a","f97c284ca991f591ae46afc92b14eb979ae1805c489c2fb66d7cfaab341a9664","3e592fff981681d1f5a5eccc547d9e7d2e9b7623fd676c916c96999f958787a0","7214cdc9c0a83a6b11a7e41bd2a1bdc443962ff6a471b92de941a7570ba9d730","bc735811f77378efffbfdcd839103483a6b1f46fe07a74e2e7ee5bc15829b66f","ec4fe0768eb0388f46cbe89516e57556f0932a6624d30f7d1288b2c14a630b87","ee03c88ea40624145727c76fe98e1771cea63c81ce63a90e233d7d416df796bb","f7cd411d9614e241d6f9652e44da6b0fc3a3a46bc48fbfeaac218db89ef1e91a","d35d351498a3c437882e94fe2e74a9087ee4b5574ba37bfb42af488f918a4bfd","29e393be53ec843cf1587791caa7223d0023e886341a01031b9b4b3c2c4f66b2","3d24ce2bba3d03d99ba277b1754ba6fa5e6ef5b2182aeab7dac3cc6138cbe8da","a46e84a0683069edfcddea53eb8eb28701d2c74308209abd9980fcc8c3e66b49","212ca5bd2baf57f6676200ffbba36c80878e0a5aabe21330d4063d6a78eed383","a374153f26f0cebd1541fc981c15ef0a0ee940f23221c348867539f2230b0f8b","b0813fcbe447a126566664654da8fb92364b0f43b18e77e0e746a709290a773b","579a1ef50f150ceebdc8062f6279bebb7023a41119bc964ed6f676600fd6af47","dd7659d8f7d729dcbc686d07046c456c0f5f92a947d68d4043ddbd4fef46db43","cb1267b6e8db56eedd71c923c328aa9d514f0280bf94ff6917b264c92ace5875"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p144"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Special Cell: For Dual Connectivity operation the term Special Cell refers to the PCell of the MCG or the PSCell of the SCG, otherwise the term Special Cell refers to the PCell.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"Split DRB: In MR-DC, a DRB that supports transmission via MCG and SCG, as well as duplication of PDCP PDUs as defined in TS 37.340 [41]; or in MP, a DRB that supports transmission via direct path and indirect path, as well as duplication of PDCP PDUs.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"Split SRB: In MR-DC, an SRB that supports transmission via MCG and SCG as well as duplication of RRC PDUs as defined in TS 37.340 [41]; or in MP, a SRB that supports transmission via direct path and indirect path, as well as duplication of PDCP PDUs.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"SSB Frequency: Frequency referring to the position of resource element RE=#0 (subcarrier #0) of resource block RB#10 of the SS block.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"U2N Relay UE: A UE that provides functionality to support connectivity to the network for U2N Remote UE(s).","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"U2N Remote UE: A UE that communicates with the network via a U2N Relay UE.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"U2U Relay UE: A UE that provides functionality to support connectivity between two U2U Remote UEs.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"U2U Remote UE: A UE that communicates with other UEs via a U2U Relay UE.","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"Uu Relay RLC channel: An RLC channel between L2 U2N Relay UE and gNB, which is used to transport packets over Uu for L2 UE-to-Network relay or for indirect path in case of MP.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"UE Inactive AS Context: UE Inactive AS Context is stored when the connection is suspended and restored when the connection is resumed. It includes information as defined in clause 5.3.8.3.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"V2X sidelink communication: AS functionality enabling V2X Communication as defined in TS 23.285 [56], between nearby UEs, using E-UTRA technology but not traversing any network node.","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"3.2Abbreviations","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"For the purposes of the present document, the abbreviations given in TR 21.905 [1] and the following apply. An abbreviation defined in the present document takes precedence over the definition of the same abbreviation, if any, in TR 21.905 [1].","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"5GC5G Core Network","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"A2XAircraft-to-Everything","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"ACKAcknowledgement","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"AMAcknowledged Mode","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"ARQAutomatic Repeat Request","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"ASAccess Stratum","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"ASN.1Abstract Syntax Notation One","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"ATGAir to Ground","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"BAPBackhaul Adaptation Protocol","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"BCDBinary Coded Decimal","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"BFDBeam Failure Detection","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["32e2582171008154b7bd0c025f055c84e6acbfadb11b6f089d229a6b6ecc79cb","b1d68113b14e5ce8da8fe91b024f4c87c92c4fe968f134f20aa474b54311ee37","732dc86ece41a00dd3075f7624592f925d7134440ba2399f31a2552250693da4","fe9c7ba401ab014d9cdab62bab792a02dbabc98e374c1555570df87068820d2a","5339bad8bbc46e602869e05c4db5b1f544aa24c838aeaf44271639df3159b56b","52974568dbcda6078b9354f3e5e62b192dd439edb22d2c96b407cc5244912452","8cbd0c55e1ac086aa0acbc866aa7d38fc30b88eac2205823958b45d728e06ec1","ed12347e1ad3a62eb4efb319c846cf4bbb17c76e4a3fb36c0bb571245377886d","d9539fa5fd1c262c9d36fe5c590a6758beb1db61073d0aa1cd67bfc62108a4b2","909bd81faa9ec0bdde0fdf0d8532b2beea08b8a721e53c32cf54eac4e8bcaa6f","43a43dae73a2056d61675cb444c49f8f589a0c75effa889d9cce1e0124bfd990","7d220157b1a8336806953ffed7df227721190389656f4361081b858595d29c3d","249d6c79c91a0dc382d808be8c1025317a6fb091accf469c7f095032a1cfb329","e7cf738968b993d33c45cc8a0cc5a56a0b7fe335a7eb6acbb6e479035d527985","60009eeb86ca44869be4837f864133d0dbc116a358d207dbb7bf936d3e9f6779","1d68fb0c1ca64ed40d7cc2125e748f96f6bb0e1d80a0495f5726dfad9e597180","14c75f34a18462ce71d8b0e4739e0ce0041f021aaad1847026159793dc7618fd","56832ce1fdfbe9a16e8a1115b09ed33ac08d11c6133d69987dc3066d55628eb5","7287a16cf35f431408c03d5700add01d75ef9213b847f3a9b1afeee0d98ff062","63dcefc4b8e8bdabecda767aa7bb77dab317b47d2af4fa9447d022a88206e3eb","8bb4d8912661f978d6b61ae20bf8e0fcfc28f5cc882996b65fe816ad7ddebc83","68fcf624a6a1648c91fc145b09262ce421ea5ed59de29c2d5470c8f2a2ea2f47","0b308881e5a2c209174c8ac395f515d51de98738c72085a307ad60d8cbaaa78a","7ff89571df72f539e930e8cf5cf329c1016027b59813abe397f9acf65ac389d0"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-stat