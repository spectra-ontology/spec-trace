{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present at RLC bearer setup. It is optionally present, need M, at RLC re-establishment. Otherwise it is absent. Need M.","paragraph_zero_based":32112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32113},{"literal_text_all_w_t_and_m_t":"–RLF-TimersAndConstants","paragraph_zero_based":32114},{"literal_text_all_w_t_and_m_t":"The IE RLF-TimersAndConstants is used to configure UE specific timers and constants.","paragraph_zero_based":32115},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants information element","paragraph_zero_based":32116},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32117},{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-START","paragraph_zero_based":32118},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32119},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants ::=          SEQUENCE {","paragraph_zero_based":32120},{"literal_text_all_w_t_and_m_t":"    t310                                ENUMERATED {ms0, ms50, ms100, ms200, ms500, ms1000, ms2000, ms4000, ms6000},","paragraph_zero_based":32121},{"literal_text_all_w_t_and_m_t":"    n310                                ENUMERATED {n1, n2, n3, n4, n6, n8, n10, n20},","paragraph_zero_based":32122},{"literal_text_all_w_t_and_m_t":"    n311                                ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10},","paragraph_zero_based":32123},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32124},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32125},{"literal_text_all_w_t_and_m_t":"    t311                                ENUMERATED {ms1000, ms3000, ms5000, ms10000, ms15000, ms20000, ms30000}","paragraph_zero_based":32126},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":32127},{"liter