{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-RB-Identity-r17 ::=         CHOICE {","paragraph_zero_based":47280},{"literal_text_all_w_t_and_m_t":"    srb-Identity-r17                        INTEGER (0..3),","paragraph_zero_based":47281},{"literal_text_all_w_t_and_m_t":"    drb-Identity-r17                        DRB-Identity,","paragraph_zero_based":47282},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47283},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47285},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIG-STOP","paragraph_zero_based":47286},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47288},{"literal_text_all_w_t_and_m_t":"SL-SRAP-Config field descriptions","paragraph_zero_based":47289},{"literal_text_all_w_t_and_m_t":"sl-LocalIdentity","paragraph_zero_based":47290},{"literal_text_all_w_t_and_m_t":"Indicates the local UE ID of the L2 U2N Remote UE used in SRAP as specified in TS 38.351 [66].","paragraph_zero_based":47291},{"literal_text_all_w_t_and_m_t":"sl-MappingToAddModList","paragraph_zero_based":47292},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be added or modified.","paragraph_zero_based":47293},{"literal_text_all_w_t_and_m_t":"sl-MappingToReleaseList","paragraph_zero_based":47294},{"literal_text_all_w_t_and_m_t":"Indicates the list of mappings between the bearer identity of the L2 U2N Remote UE and the egress RLC channel as specified in TS 38.351 [66] to be released.","paragraph_zero_based":47295},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-RB-Identity","paragraph_zero_based":47296},{"literal_text_all_w_t_and_m_t":"Identity of the end-to-end Uu bearer identity of the L2 U2N Remote UE. The value 3 for the field srb-identity-r17 (i.e., for configuring SRB3) is not supported in this version of the specification.","paragraph_zero_based":47297},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelUu","paragraph_zero_based":47298},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on Uu Hop for uplink transmissions at the L2 U2N Relay UE.","paragraph_zero_based":47299},{"literal_text_all_w_t_and_m_t":"sl-EgressRLC-ChannelPC5","paragraph_zero_based":47300},{"literal_text_all_w_t_and_m_t":"Indicates the egress RLC channel on PC5 Hop for downlink transmissions at the L2 U2N Relay UE and for uplink transmissions at the L2 U2N Remote UE.","paragraph_zero_based":47301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47302},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ec5e9bb19f8adb6dc581a43acdd8c2fa171026dc209b869c82f3d02421848675","633cb617b306cc92bc0556e4e898d0e33d9f483376f4d05ecf9f60002bfa7936","5a1494614fb8285b80c2cb7a48cba69708b54b7442b7f4d421169133919f496c","311fceccf82ae918feb6d1a2c799882084185c40b65667f7087dab53a061c950","2ad53bc3181a645cd82c7fa3374727f9853f3031a3076b608edcaf389126b9fa","64d310d9ee7a166443c8715bc6f5a56e7e686110f287bb2fb263ec7a2070df54","3db98a96a800c5ffddbba694ed4006b011e93657f71cdbb877cadfbf2fb61d0f","f075f44ce40b34e4608392178f2b8a673833983996aa9f4cece8d8a35c7637d8","57ed8e93620228bc9c136e4b25fec4c5ad29d448bb310af4a5ed0ec950886e4e","abc3b665be38c361795c3de31ae9c4b401de45ff261af47cad2bcee151294705","ae5c38bb931cb7e95334dd28