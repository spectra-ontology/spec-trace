{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo field descriptions","paragraph_zero_based":29424},{"literal_text_all_w_t_and_m_t":"pucch-PathLossReferenceRS-Id","paragraph_zero_based":29425},{"literal_text_all_w_t_and_m_t":"When pucch-PathLossReferenceRS-Id-v1610 is configured, the UE shall ignore pucch-PathLossReferenceRS-Id (without suffix).","paragraph_zero_based":29426},{"literal_text_all_w_t_and_m_t":"pucch-SpatialRelationInfoId","paragraph_zero_based":29427},{"literal_text_all_w_t_and_m_t":"When pucch-SpatialRelationInfoId-v1610 is configured, the UE shall ignore pucch-SpatialRelationInfoId (without suffix). If pucch-SpatialRelationInfoId-v1610 is absent, the UE shall use the pucch-SpatialRelationInfoId (without suffix).","paragraph_zero_based":29428},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29429},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the ServCellId of the serving cell in which this PUCCH-SpatialRelationInfo is configured","paragraph_zero_based":29430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29431},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo-Id","paragraph_zero_based":29432},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo-Id is used to identify a PUCCH-SpatialRelationInfo","paragraph_zero_based":29433},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo-Id information element","paragraph_zero_based":29434},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29435},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":29436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29437},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId ::=         INTEGER (1..maxNrofSpatialRelationInfos)","paragraph_zero_based":29438},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29439},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-r16 ::=     INTEGER (1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":29440},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29441},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfoId-v1610::=    INTEGER (maxNrofSpatialRelationInfos-plus-1..maxNrofSpatialRelationInfos-r16)","paragraph_zero_based":29442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29443},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":29444},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29446},{"literal_text_all_w_t_and_m_t":"–PUCCH-TPC-CommandConfig","paragraph_zero_based":29447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["fd04851c9d0bd2889f509d48e44682d8c0d1020811a8587200563150da493c95","eba63ea1f8f600fbea1e29763e2ba2a655ef69f4fb16e0cdfe65dc7894ccd732","eddd01993bff4e44bc3aa3d7f2693996850be2fa22359093923df278be3b03ec","532e4f9d97af44014b7fffc3dd734f94ce70d85e7cadeb6b0d60990eb361fa67","43753bc610a3ee5559435d2f59ab373a2d1bb1a3515d219c27ab14abc15fda45","a39be49acf06f55c7e47f1a1256809c2d30eb1139c9228941e1c1ba0898d3999","a1b00c2ebe4d760e43d48fc10b4bb199dd68797e0d214edff3ebd600c53f26c3","33635f70475371e9e2c7d339e68b667d7cdcc79e9d1b46ca24d18ea00231e9a3","ea80b947a536b4177d912461e5529288830b6caad14631b00e219c089099481b","09ce10964d1768c9717c517241b0cf30ce8b34566b798d41d688496642c20941","18fbe3a25dd6cf0d759f2d77dd396e6eaec384c435867a3833bc4f4603a9501a","42bbaebd6040b25de