7f929d69499e190e986d172796ca2e4e7458aa9decd23ab8caa","a109cb8f54695ffbcb3643226f4fe8a98897afcc08ea16186ec44f75d294040e","3c61ad2ba0b8f0fe718c18f5b34bd09f447df54b33ebcc9c5cfea6cf2afd978d","76100eff64dc797ac7c030e9920f5a18c0083e5a667dc22ec162371a93aef321","55a62bc5fa7307f13177a1a7def13826749c2aeda9b2fb58d50a07a1b2b7fcc2","81d28523db7888d7afec16991b3a823473cabd48dbe9e5f60176b5686e394afa","bb9a110ab83879e38f0d2f4d286b537f94e669c86a5f9864b3c49ca0a335e7e3","281828c869cd399b491892af9dd6bed0cc92e171073faa0a5914d1e5744638da","a9ac7510cedb06705cde6f88ef9cc8fb78a3c038dc19034bc78b38e1ebdb214d","5cbe846fbc5db61157e0c967748372050e5ca03073e228ae6955aa5e846860a2","b8eb1ea4ab5e77e267425ac04f5cff8fe27aeb9c145c2b56d9fe13eb4d828f20","04a51de9ac1d874531724181efe246ade5d71f651f01bd301bcbcce835e25f50","f51a2b1081b71c8fecbc4116dd16dddd1058d89b9ccf3e776791ea1c21805771","8cbcf0f8d60a7b0ec221baf1f7806c95648c0d753ded1bca550f1e0c01a3ea5b","94fb2729c78acbc574fc20abf9a47364a8b09f4eb3d54cca88b49c343684ce47","fc3e3c4e600a883416434f4f05a83bf9bf36bad84e69115b28daa3d78fd23683","9f3c2e755a6bc3a59f38481a4cedc0d6c31a620d9d065719cb424c7e1f7660f5","6179b445c5c0034b0c54cafd394cfd504da293b178304d7af19740c575b11768","761f17633479ce7c811b6d056d8d9938d89bbfc0aeb555275f56b2a91b70b114","a5250a529afe640148d9353a108d12dba53a77c61bf2211de9111e4ad81a36be","b2907f4e9e34e041738532a4d7015e62b1f247e17d95476d99af490ae7913359"],"paragraph_range_zero_based":[27024,27047],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27024"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27048},{"literal_text_all_w_t_and_m_t":"NTN-Config field descriptions","paragraph_zero_based":27049},{"literal_text_all_w_t_and_m_t":"EphemerisInfo","paragraph_zero_based":27050},{"literal_text_all_w_t_and_m_t":"This field provides satellite ephemeris either in format of position and velocity state vector or in format of orbital parameters. This field is excluded when determining changes in system information, i.e. changes to ephemerisInfo should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":27051},{"literal_text_all_w_t_and_m_t":"epochTime","paragraph_zero_based":27052},{"literal_text_all_w_t_and_m_t":"If this field is absent for the serving cell, the epoch time is the end of SI window where this SIB19 is scheduled. This field is mandatory present when ntn-Config is provided in dedicated configuration. If this field is absent in ntn-Config provided via NTN-NeighCellConfig or SatSwitchWithReSync the UE uses epoch time of the serving cell, otherwise the field is based on the timing of the serving cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the serving cell. In case of handover or conditional handover, this field is based on the timing of the target cell, i.e. the SFN and sub-frame number indicated in this field refers to the SFN and sub-frame of the target cell. For the target cell the UE considers epoch time, indicated by the SFN and sub-frame number in this field, to be the frame nearest to the frame in which the message indicating the epoch time is received. This field is excluded when determining changes in system information, i.e. changes to epochTime should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":27053},{"literal_text_all_w_t_and_m_t":"cellSpecificKoffset","paragraph_zero_based":27054},{"literal_text_all_w_t_and_m_t":"Scheduling offset used for the timing relationships that are modified for NTN (see TS 38.213 [13]). The unit of the field K_offset is number of slots for a given subcarrier spacing of 15 kHz. If the field is absent UE assumes value 0.","paragraph_zero_based":27055},{"literal_text_all_w_t_and_m_t":"kmac","paragraph_zero_based":27056},{"literal_text_all_w_t_and_m_t":"Scheduling offset provided by network if downlink and uplink frame timing are not aligned at gNB. If the field is absent UE assumes value 0. The unit of kmac is number of slots for a given subcarrier spacing of 15 kHz.","paragraph_zero_based":27057},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationDL","paragraph_zero_based":27058},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates polarization information for downlink transmission on service link: including Right hand, Left hand circular polarizations (RHCP, LHCP) and Linear polarization.","paragraph_zero_based":27059},{"literal_text_all_w_t_and_m_t":"ntn-PolarizationUL","paragraph_zero_based":27060},{"literal_text_all_w_t_and_m_t":"If present, this parameter indicates Polarization information for uplink service link.","paragraph_zero_based":27061},{"literal_text_all_w_t_and_m_t":"If not present and ntn-PolarizationDL is present, UE assumes the same polarization for UL and DL.","paragraph_zero_based":27062},{"literal_text_all_w_t_and_m_t":"ntn-UlSyncValidityDuration","paragraph_zero_based":27063},{"literal_text_all_w_t_and_m_t":"A validity duration configured by the network for assistance information (i.e. Serving and/or neighbour satellite ephemeris and Common TA parameters) which indicates the maximum time duration (from epochTime) during which the UE can apply assistance information without having acquired new assistance information.","paragraph_zero_based":27064},{"literal_text_all_w_t_and_m_t":"The unit of ntn-UlSyncValidityDuration is second. Value s5 corresponds to 5 s, value s10 indicate 10 s and so on. This parameter applies to both connected and idle mode UEs. If this field is absent in ntn-Config provided via NTN-NeighCellConfig or SatSwitchWithReSync, the UE uses validity duration from the serving cell assistance information. This field is excluded when determining changes in system information, i.e. changes of ntn-UlSyncValidityDuration should neither result in system information change notifications nor in a modification of valueTag in SIB1. ntn-UlSyncValidityDuration is only updated when at least one of epochTime, ta-Info, ephemerisInfo is updated.","paragraph_zero_based":27065},{"literal_text_all_w_t_and_m_t":"ta-Common","paragraph_zero_based":27066},{"literal_text_all_w_t_and_m_t":"Network-controlled common timing advanced value and it may include any timing offset considered necessary by the network. ta-Common with value of 0 is supported. The granularity of ta-Common is 4.072 × 10^(-3) μs. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-Common should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":27067},{"literal_text_all_w_t_and_m_t":"ta-CommonDrift","paragraph_zero_based":27068},{"literal_text_all_w_t_and_m_t":"Indicate drift rate of the common TA. The granularity of ta-CommonDrift is 0.2 × 10^(-3) μs⁄s. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDrift should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":27069},{"literal_text_all_w_t_and_m_t":"ta-CommonDriftVariant","paragraph_zero_based":27070},{"literal_text_all_w_t_and_m_t":"Indicate drift rate variation of the common TA. The granularity of ta-CommonDriftVariant is 0.2×10^(-4) μs⁄s^2. Values are given in unit of corresponding granularity. This field is excluded when determining changes in system information, i.e. changes of ta-CommonDriftVariant should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":27071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e58671b39281ab5139a327c309e92d71dfb6596cc7ee2b089e5e850cde8f6771","3d682fd44b658a45f546a0099011a3ee1114a2a8b0684d3e5065dee3abaa690a","a33aada0ca67c2b84485fdcca970e1ce54e27ae2f2a2f6f66e41e16bbd25ebe9","25f677bb80d7a640a16d482bb74affb886a2b56818eda87a5e57dfba19c6ec8b","afe9be9af7eec2150c773bcf8bc7d2969571e970c5b670cde222f98ecd02a7fb","ed4da5c394aefac5e42e490c780f47afdc5cbad773ee488c98a6a0f74d3f7f9b","466d93e5d0cc4b906975e3287f3dd230b35dfac771da552071101419e65a8c6d","438dfd7141a10b8898f4e639d89f5ead69e7c024f9ec66264c9ddcbdbda50ee7","3076109f9af02ebfb3b16da4bbcccb12b032eebef3f95bf29404948abd3a5338","3509f8c5873a3015df65cf8aff6978d0fb403e566360eccef0108bf73219415a","1fa608d0b092421648b64d3ab45fbc835838187cf9de4953465b923a951cf696","fa438815b7e2cd68ec27b1f22b9975ab02ef6f0568b278bf9f63d4b78b05a4ba","99b1cbc81c60c2a1b83389a81ea5ec867bc1583aec80f0eb65f92f8b9721693c","621de80fbb7df8dc83b92839068222b2c4ed51281c12f0ade6fd55a8ce0513ae","886fc6d9489e61d5ef8f63b7ed766cc7412cb72611a68349d0e29ec687144d43","ea26896f2bd03fe063dc66fa30f8e7cd250797e5e37ba68f6926fcc02ed51b4a","df2dc88b235780a1bbd31ba7aa2911c497abef48fd7517fe73c04c86c8b0520e","b85629e66ff1601b0a0b7a5912d3747ea25a96760100384c07c0665968fae1dd","33887095d69588fbf1dbc12718b1e5fd8fe9f2b5772c98bf02fe8c26b37fe75b","c992c1e4e20708ec5e69840cb538d4fa76ded67ada6213584f57cb96b2ea11e0","296313cbaca1bd7205fe651cb5c74530cb82afae4082d2caabbdecfb94be7847","dca71ad9f67912ca7f2d21d36905bb1578b7e7959769f6ef9b3423ffe1af416d","93c5434b7054ba6eebc6f124f69d7ac8df4a03bb2cf322efe69a77a0857bb8ac","8a238c17d330e863708c97589e13384a74c6ca4b59a0c24815051370514d5e55"],"paragraph_range_zero_based":[27048,27071],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27048"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ta-Report","paragraph_zero_based":27072},{"literal_text_all_w_t_and_m_t":"When this field is included in SIB19, it indicates reporting of timing advanced is enabled during Random Access due to RRC connection establishment or RRC connection resume, and during RRC connection reestablishment. When this field is included in ServingCellConfigCommon within dedicated signalling, it indicates TA reporting is enabled during Random Access due to reconfiguration with sync (see TS 38.321 [3], clause 5.4.8).","paragraph_zero_based":27073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27074},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27075},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27076},{"literal_text_all_w_t_and_m_t":"SIB19","paragraph_zero_based":27077},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for the serving cell in SIB19. The field is optionally present, Need R, otherwise.","paragraph_zero_based":27078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27079},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-Resource","paragraph_zero_based":27080},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-Resource is used to configure Non-Zero-Power (NZP) CSI-RS transmitted in the cell where the IE is included, which the UE may be configured to measure on (see TS 38.214 [19], clause 5.2.2.3.1). A change of configuration between periodic, semi-persistent or aperiodic for an NZP-CSI-RS-Resource is not supported without a release and add.","paragraph_zero_based":27081},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource information element","paragraph_zero_based":27082},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27083},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCE-START","paragraph_zero_based":27084},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27085},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-Resource ::=             SEQUENCE {","paragraph_zero_based":27086},{"literal_text_all_w_t_and_m_t":"    nzp-CSI-RS-ResourceId               NZP-CSI-RS-ResourceId,","paragraph_zero_based":27087},{"literal_text_all_w_t_and_m_t":"    resourceMapping                     CSI-RS-ResourceMapping,","paragraph_zero_based":27088},{"literal_text_all_w_t_and_m_t":"    powerControlOffset                  INTEGER (-8..15),","paragraph_zero_based":27089},{"literal_text_all_w_t_and_m_t":"    powerControlOffsetSS                ENUMERATED{db-3, db0, db3, db6}                 OPTIONAL,   -- Need R","paragraph_zero_based":27090},{"literal_text_all_w_t_and_m_t":"    scramblingID                        ScramblingId,","paragraph_zero_based":27091},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL,   -- Cond PeriodicOrSemiPersistent","paragraph_zero_based":27092},{"literal_text_all_w_t_and_m_t":"    qcl-InfoPeriodicCSI-RS              TCI-StateId                                     OPTIONAL,   -- Cond Periodic","paragraph_zero_based":27093},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27094},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6a9df305630700437d6ff772843713f60abdf596f4da369fb9c3e3ea525a5020","2fd4581ed1820557c8801ffb795237f1f1adafc20eb32a482d6763790851a7f4","5f8a9117a55e57c89752515bca5a7ac9b0cac6312a9742187753f56c1d7528f4","47d70a24286a86456