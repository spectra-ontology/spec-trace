{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ReferenceTimeInfo contains timing information for 5G internal system clock used for, e.g., time stamping, see TS 23.501 [32], clause 5.27.1.2.","paragraph_zero_based":30864},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo information element","paragraph_zero_based":30865},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30866},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-START","paragraph_zero_based":30867},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30868},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo-r16 ::= SEQUENCE {","paragraph_zero_based":30869},{"literal_text_all_w_t_and_m_t":"    time-r16                            ReferenceTime-r16,","paragraph_zero_based":30870},{"literal_text_all_w_t_and_m_t":"    uncertainty-r16                     INTEGER (0..32767)          OPTIONAL,   -- Need S","paragraph_zero_based":30871},{"literal_text_all_w_t_and_m_t":"    timeInfoType-r16                    ENUMERATED {localClock}     OPTIONAL,   -- Need S","paragraph_zero_based":30872},{"literal_text_all_w_t_and_m_t":"    referenceSFN-r16                    INTEGER (0..1023)           OPTIONAL    -- Cond RefTime","paragraph_zero_based":30873},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30874},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30875},{"literal_text_all_w_t_and_m_t":"ReferenceTime-r16 ::=           SEQUENCE {","paragraph_zero_based":30876},{"literal_text_all_w_t_and_m_t":"    refDays-r16                         INTEGER (0..72999),","paragraph_zero_based":30877},{"literal_text_all_w_t_and_m_t":"    refSeconds-r16                      INTEGER (0..86399),","paragraph_zero_based":30878},{"literal_text_all_w_t_and_m_t":"    refMilliSeconds-r16                 INTEGER (0..999),","paragraph_zero_based":30879},{"literal_text_all_w_t_and_m_t":"    refTenNanoSeconds-r16               INTEGER (0..99999)","paragraph_zero_based":30880},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30882},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCETIMEINFO-STOP","paragraph_zero_based":30883},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30884},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30885},{"literal_text_all_w_t_and_m_t":"ReferenceTimeInfo field descriptions","paragraph_zero_based":30886},{"literal_text_all_w_t_and_m_t":"referenceSFN","paragraph_zero_based":30887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6651270cb8ecabd6d0adc1255380c06ad413e2275638da290a3534ef2069280a","646164e3ab20ecdba2a473110aa8f7df6411a72ebeb3e8edbfb862f7fc0452d0","fcfb10086a379eba59e1b45f723801b2a5df8da41c96cb5db13127b7d3c0f0da","c970b2ac7cbb950318c7a04e818ac28e0f8984249abae000d7d0f189986ce985","1b890290caa24c48faa59911466545fb6efd3dea7d941d504e8405300b9fe131","8811544dc808135ca681e7be7df8df89912ca2d0165898a1098a289644fe9cd8","f0afb12bde6431aae95dd7b7c0bba9c8aedd0014dbc0ff2508bcf4654c7469cd","6f64ecb5ca28aaba31c4ed2f401e8df9e1c6c0249a4622ae1213a8d65f30c553","7c4b3f9fa66fb3e492f575dbcaa9da42368e051b7a8c77754d725ec8ba47288e","d8e36cacdeead72199c40d67f69c33c195e7524f516e3e5924e0c5f62e32c396","ed950bb01ed3fc9c195cffda04bd9035b4f6c838df6a27f062d36ef3efee4477","08e8455a0cb531c08a1890a3a74e1dc710cc98f24163bc1e9452312def08e8bd","3dc1fd52312317ff8b20528c35bd710ab5003f8fd4521b62a62fb0b6787a0fe8","3c6e7b9a7f1009449e1e8f1a0a40c593a60ff117876d4dc7ac758236c33905ee","cecffef4ac830081509faedd1f92ef9deb00f7b6150d0a90da36dc17e04f0f59","0a9c4a55e8059ed71ce28fe55e66626fdabe04abc6d0e747d8cad054f6e81c87","801131037d528ce2ced4057c1772bd3b8b3f4a2ee37f07acf1904d7b0b32cbae","be32d2ab0bce0980be0855d020474d0eade0625780d187bbf348bb152f5bed93","6d853e67d6dfc91e53d4ca78ab271dc3aeaaf725e68ed5e373fbad8fc8da325f","8402d6d4f7afeb2add388b8f599abffba28c12f2677f0a22e159235653660693","d15e8809a32c1207f5e1d35ed677f59c68a4ad3f4451b3c56c4e455ca46a1014","92e229e59caac6931e764f812fa072ffdb30c090d71f46357f4f12d66af863c6","8e0c2c85b11a1717b30a9feac2fa85c192a48f1aa4554a71cb7001a471660a2d","339eb43687403500f3a140367201f65541c7d9cab02dda9d01ede595ee3903ce"],"paragraph_range_zero_based":[30864,30887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30864"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the reference SFN corresponding to the reference time information. If referenceTimeInfo field is received in DLInformationTransfer message, this field indicates the SFN of PCell.","paragraph_zero_based":30888},{"literal_text_all_w_t_and_m_t":"time","paragraph_zero_based":30889},{"literal_text_all_w_t_and_m_t":"This field indicates time reference with 10ns granularity. If included in DLInformationTransfer and if UE-side TA PDC is de-activated, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. If included in DLInformationTransfer and if UE is requested to transmit UE Rx-Tx time difference measurement, the indicated time may not be referenced at the network, i.e., gNB may pre-compensate for RF propagation delay. Otherwise, the indicated time is referenced at the network, i.e., without compensating for RF propagation delay. In an NTN cell, the indicated time is referenced at the uplink time synchronization reference point (RP), i.e., UE should take into account the propagation delay between UE and RP when determining the UTC time at the UE.","paragraph_zero_based":30890},{"literal_text_all_w_t_and_m_t":"The indicated time in 10ns unit from the origin is refDays*86400*1000*100000 + refSeconds*1000*100000 + refMilliSeconds*100000 + refTenNanoSeconds. The refDays field specifies the sequential number of days (with day count starting at 0) from the origin of the time field.","paragraph_zero_based":30891},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in DLInformationTransfer message, the time field indicates the time at the ending boundary of the system frame indicated by referenceSFN. The UE considers this frame (indicated by referenceSFN) to be the frame which is nearest to the frame where the message is received (which can be either in the past or in the future).","paragraph_zero_based":30892},{"literal_text_all_w_t_and_m_t":"If the referenceTimeInfo field is received in SIB9, the time field indicates the time at the SFN boundary at or immediately after the ending boundary of the SI-window in which SIB9 is transmitted.","paragraph_zero_based":30893},{"literal_text_all_w_t_and_m_t":"If referenceTimeInfo field is received in SIB9, this field is excluded when determining changes in system information, i.e. changes of time should neither result in system information change notifications nor in a modification of valueTag in SIB1.","paragraph_zero_based":30894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30895},{"literal_text_all_w_t_and_m_t":"NOTE:The estimated time in an NTN-cell may be less accurate than the estimated time in a TN-cell.","paragraph_zero_based":30896},{"literal_text_all_w_t_and_m_t":"timeInfoType","paragraph_zero_based":30897},{"literal_text_all_w_t_and_m_t":"If timeInfoType is not included, the time indicates the GPS time and the origin of the time field is 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time). If timeInfoType is set to localClock, the origin of the time is unspecified.","paragraph_zero_based":30898},{"literal_text_all_w_t_and_m_t":"uncertainty","paragraph_zero_based":30899},{"literal_text_all_w_t_and_m_t":"This field indicates the uncertainty of the reference time information provided by the time field. The uncertainty is 25ns multiplied by this field. If this field is absent, the uncertainty is unspecified.","paragraph_zero_based":30900},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30901},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30902},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30903},{"literal_text_all_w_t_and_m_t":"RefTime","paragraph_zero_based":30904},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if referenceTimeInfo is included in DLInformationTransfer message; otherwise the field is absent.","paragraph_zero_based":30905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30906},{"literal_text_all_w_t_and_m_t":"–RejectWaitTime","paragraph_zero_based":30907},{"literal_text_all_w_t_and_m_t":"The IE RejectWaitTime is used to provide the value in seconds for timer T302.","paragraph_zero_based":30908},{"literal_text_all_w_t_and_m_t":"RejectWaitTime information element","paragraph_zero_based":30909},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30910},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-START","paragraph_zero_based":30911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["eb1485e7bc4ca4030920268786beb43d63b988f55e0953346b71d7621742dadd","d2b5fecb425bdd1cc5dffe76e506027dd681b785de72626465ac2cb66de72b20","ec705f5f6e594ffee3a884af3099358d9990a13cfc310699d3707465a4ca094d","104ae2e9079151bcb7a8e99a586460e6a72bcdb4a3b3486d4f8dcb3046d9812a","7c8b32e51b7c57c5212c4c584db27ed567f73c1bde0dfbcc24cfc88ee18bbc48","0e03a9e4c0782d177c25d5bcd938bcfa8917b3870f698a75c4be324a4e2de480","72986783498c4604dc056ec70a562cf44e34a32e31e8ae5d11c91054c5d4b5d0","86d1b28f04cd63bdbf9abb30aaa81f89599cad56b8e8faef6db22fbae3aff9d6","1dc6152c2b5abe613645f709704271d341dfe26a6000e40511c759110ae24884","e900ee35a1e224d2fea02a9b707eb9296d3b92e1eadf8a3027f7d83e81662d5c","196b9df2cc035ef15e7b1bd51687854c06e7bf6eb94899939c26e174e5458764","98f8aafeee2a8cc18acb6a7069551af19f5ca0bcdb2a66c31db5d27559b53f7f","e55ebfe79a529f3a1201b10f1650f6d471e9ec655dbd42cedd0e766692887ad6","29370d52a7ad6675110e641d712bbf853c17f86de724912146902eadc3d8e680","f705842f