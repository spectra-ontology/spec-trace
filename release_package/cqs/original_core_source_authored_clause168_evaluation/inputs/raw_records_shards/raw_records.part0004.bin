{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The serving cell to which the acquired power control commands are applicable. If the value is absent, the UE applies the TPC commands to the serving cell on which the command has been received.","paragraph_zero_based":30192},{"literal_text_all_w_t_and_m_t":"tpc-Index","paragraph_zero_based":30193},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":30194},{"literal_text_all_w_t_and_m_t":"tpc-IndexSUL","paragraph_zero_based":30195},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":30196},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30197},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30198},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30199},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":30200},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured within ServingCellConfig. It is absent otherwise.","paragraph_zero_based":30201},{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":30202},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured within ServingCellConfig. It is mandatory present otherwise.","paragraph_zero_based":30203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30204},{"literal_text_all_w_t_and_m_t":"–QFI","paragraph_zero_based":30205},{"literal_text_all_w_t_and_m_t":"The IE QFI is used to indicate the QoS Flow Identifier.","paragraph_zero_based":30206},{"literal_text_all_w_t_and_m_t":"QFI information element","paragraph_zero_based":30207},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30208},{"literal_text_all_w_t_and_m_t":"-- TAG-QFI-START","paragraph_zero_based":30209},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30210},{"literal_text_all_w_t_and_m_t":"QFI ::=                             INTEGER (0..maxQFI)","paragraph_zero_based":30211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30212},{"literal_text_all_w_t_and_m_t":"-- TAG-QFI-STOP","paragraph_zero_based":30213},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5a0bdd905d5e07362395d1249b634992033092b6810f8499f83b8e7e4063c88e","6f6efb8aa63a343ddcf6eaaf5fe39403d2982431075b217bb33a397d394d0d22","2107ffc8525bb88d89c2552383e3c8fa7acdd2b7f94935e091a02743b8cf1152","2e9f05b148a5698aff460f5150c6777a78dffb8791849c70d539bb0f201c94d1","b3f09d81c005d63bab6ebc6344c72fa60e1628861733600c0e123111a55e9e2f","1cb0efcde295f67e5f683fb804ff91c512c60625475839378e271afde9274ee1","eab0623b2d25d82aba28c99c3c91958f915043bd64d7fe4d6d9b59dfe03fbbe1","6a8f9d39ab144d1191dc85c167743c3571769a31cccfd69c3bb6e837ef09a9cc","2ee8fb3740b16d42da352890c70105103a7d99d5a04d971540c30fab728c7898","f0f5f0e5a682793a3ea6c43419e00601ef2fc09dcfc0a061d6dc6b713fb2e30d","e529d3fe2f504f5ed62108bc8e29bfeed7316b1c8aac8865c908e1598adbeb5a","ac70a0c7b58dafa145bb971747d2f903882d5e54bcc3e6f410fdaa6ecd0a134b","2cc45d6fc4b88ad50f984cf33e1503b358edf2718bc1480264463c9a1885f0f2","2cb8a615a1fd99456042e037560161cec791166d7b6cd43bf4a71cac963c0159","cafe96825c1ce49765cc88533ecab15732631876405a37483b673e11c49db