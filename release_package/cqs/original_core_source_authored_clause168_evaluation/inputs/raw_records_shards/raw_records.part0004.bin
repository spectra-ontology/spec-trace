{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETUPLINKPERCC-ID-START","paragraph_zero_based":39072},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39073},{"literal_text_all_w_t_and_m_t":"FeatureSetUplinkPerCC-Id ::=            INTEGER (1..maxPerCC-FeatureSets)","paragraph_zero_based":39074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39075},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETUPLINKPERCC-ID-STOP","paragraph_zero_based":39076},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39078},{"literal_text_all_w_t_and_m_t":"–FreqBandIndicatorEUTRA","paragraph_zero_based":39079},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39080},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATOREUTRA-START","paragraph_zero_based":39081},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39082},{"literal_text_all_w_t_and_m_t":"FreqBandIndicatorEUTRA ::=  INTEGER (1..maxBandsEUTRA)","paragraph_zero_based":39083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39084},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDINDICATOREUTRA-STOP","paragraph_zero_based":39085},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39087},{"literal_text_all_w_t_and_m_t":"–FreqBandList","paragraph_zero_based":39088},{"literal_text_all_w_t_and_m_t":"The IE FreqBandList is used by the network to request NR CA, NR non-CA and/or MR-DC band combinations for specific NR and/or E-UTRA frequency bands and/or up to a specific number of carriers and/or up to specific aggregated bandwidth. This is also used to request feature sets (for NR) and feature set combinations (for NR and MR-DC). For NR sidelink communication, this is used by the initiating UE to request sidelink UE radio access capabilities from the peer UE. This is also used to request lower MSD capability for specific NR frequency bands for the UE supporting lower MSD.","paragraph_zero_based":39089},{"literal_text_all_w_t_and_m_t":"FreqBandList information element","paragraph_zero_based":39090},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39091},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDLIST-START","paragraph_zero_based":39092},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39093},{"literal_text_all_w_t_and_m_t":"FreqBandList ::=                SEQUENCE (SIZE (1..maxBandsMRDC)) OF FreqBandInformation","paragraph_zero_based":39094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["584f4fc4ee85a045c45f11623c30d0cd409b5f11ecae1d9281d640a9a7ce9601","6151787926dd9eff82b38c5bcffb13c4313889b69a7bfd008cd27acf13ae1065","81c7e8c81b3b87efca4cb4cdd4523e4200076ab04f9ba19918d52d801f3fd1e0","1df1331f92d1825be13b42eff0bd5d4e9be1c643897ced5159b5480d1b4503e7","4e4a9b8dd8b6ad397c4be15ea20731166214460871b806c15139150c6ed08cdf","dbdcff3d2519a5a9a5a6ba4776bc928e8d9ce2276914ad32519dc7d848a9a043","eeb20fd80b5265d9a831c345a891d8a24cc7c91f5a7ce84bb7ca8d7e71e8b3cd","2bc61044aff4aa956333c356ec7661a150879a76f5d2dda7084c968608682b56","337eb17466de93c084d615ad3fe789d2961332ee473860c88d0071c97bf73649","1d5fe5b7eb3f6cff231c7730ec814b03970e7634f0f366ca26216682c942a963","d99b8b135675aba2ff56da30414e95c94a660d7a47137f91496ceb182b5ee618","d51371e810add0fb7867befdaff6d3492970080342025a02c28d202e7c64e0d8","396ca53c792147508dded5ed83e4f97488791117ab73be4134d757