{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26425},{"literal_text_all_w_t_and_m_t":"NCR-SemiPersistentFwdResourceId-r18 ::= INTEGER (0..maxNrofSemiPersistentFwdResource-1-r18)","paragraph_zero_based":26426},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26427},{"literal_text_all_w_t_and_m_t":"-- TAG-NCR-SEMIPERSISTENTFWDRESOURCESET-STOP","paragraph_zero_based":26428},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26430},{"literal_text_all_w_t_and_m_t":"NCR-SemiPersistentFwdResourceSet field descriptions","paragraph_zero_based":26431},{"literal_text_all_w_t_and_m_t":"beamIndex","paragraph_zero_based":26432},{"literal_text_all_w_t_and_m_t":"Indicates logical beam index for NCR-Fwd access link. NCR-Fwd is assumed to be ON over the indicated time domain resource if there is beam indication.","paragraph_zero_based":26433},{"literal_text_all_w_t_and_m_t":"durationInSymbols","paragraph_zero_based":26434},{"literal_text_all_w_t_and_m_t":"Indicates the time duration in number of symbols.","paragraph_zero_based":26435},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":26436},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity and slot offset for the semi-persistent forwarding resource. All the semi-persistent forwarding resources configured within the same resource set should have the same periodicity. If the periodicity is expressed in [ms], the value range of slot offset is from 0 to Periodicity[ms] * referenceSCS[kHz]/15 -1.","paragraph_zero_based":26437},{"literal_text_all_w_t_and_m_t":"priorityFlag","paragraph_zero_based":26438},{"literal_text_all_w_t_and_m_t":"Indicates the priority for the list of semi-persistent forwarding resources, as specified in TS 38.213 [13], clause 20.","paragraph_zero_based":26439},{"literal_text_all_w_t_and_m_t":"referenceSCS","paragraph_zero_based":26440},{"literal_text_all_w_t_and_m_t":"Indicates the reference subcarrier spacing for all the time resources in the list. Only values kHz15, kHz30, kHz60, kHz120 and kHz240 are applicable.","paragraph_zero_based":26441},{"literal_text_all_w_t_and_m_t":"semiPersistentFwdRsrcToAddModList","paragraph_zero_based":26442},{"literal_text_all_w_t_and_m_t":"List of semi-persistent forwarding resources to be added or modified.","paragraph_zero_based":26443},{"literal_text_all_w_t_and_m_t":"symbolOffset","paragraph_zero_based":26444},{"literal_text_all_w_t_and_m_t":"Indicates the symbol offset in one slot.","paragraph_zero_based":26445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26446},{"literal_text_all_w_t_and_m_t":"–NCR-SemiPersistentFwdResourceSetId","paragraph_zero_based":26447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e13d0f1ea33997f26c66dfd5cdb509308fad8239dfe5c00d573e901d541dfb26","3053edb72372013134395e6ec5555dd4801259cf0d9d6f2918b137c82cee6aab","5e394298178d75ca13613d1d7c971fd5b3d4dc46e6c525a6bac43dca69ebe429","65cc5d7f486edd1c867b3e2c36b375f2182a4b536b3816f9bf5b365206218f55","817ad7f253a83c868271b4d1ca665bc79385aab98a68591af99f8c4bc496bc02","72b121ae59f2c779b320ec80acd8e308d5adb508a26b9acec0e11cce7fc70dba","6ce06c36fca6035e7caddc492d1ad5309108438065a811a1d39c808755f73bf9","4b197dd06863c5729127faae2ed26546f205c19e17c1da9c15ea32f6e060931d","439c6af2c2835dcbb73e50635710b78fa1a09aa09b6e054b7c13edb426445d9f","6da43d8fcb286672a3f5465ee6b7c877a659e0797f7a399e69b