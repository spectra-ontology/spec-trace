{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25392},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYSTATEPARAMETERS-STOP","paragraph_zero_based":25393},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25395},{"literal_text_all_w_t_and_m_t":"MobilityStateParameters field descriptions","paragraph_zero_based":25396},{"literal_text_all_w_t_and_m_t":"n-CellChangeHigh","paragraph_zero_based":25397},{"literal_text_all_w_t_and_m_t":"The number of cell changes to enter high mobility state. Corresponds to NCR_H in TS 38.304 [20].","paragraph_zero_based":25398},{"literal_text_all_w_t_and_m_t":"n-CellChangeMedium","paragraph_zero_based":25399},{"literal_text_all_w_t_and_m_t":"The number of cell changes to enter medium mobility state. Corresponds to NCR_M in TS 38.304 [20].","paragraph_zero_based":25400},{"literal_text_all_w_t_and_m_t":"t-Evaluation","paragraph_zero_based":25401},{"literal_text_all_w_t_and_m_t":"The duration for evaluating criteria to enter mobility states. Corresponds to TCRmax in TS 38.304 [20]. Value in seconds, s30 corresponds to 30 s and so on.","paragraph_zero_based":25402},{"literal_text_all_w_t_and_m_t":"t-HystNormal","paragraph_zero_based":25403},{"literal_text_all_w_t_and_m_t":"The additional duration for evaluating criteria to enter normal mobility state. Corresponds to TCRmaxHyst in TS 38.304 [20]. Value in seconds, value s30 corresponds to 30 seconds and so on.","paragraph_zero_based":25404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25405},{"literal_text_all_w_t_and_m_t":"–MRB-Identity","paragraph_zero_based":25406},{"literal_text_all_w_t_and_m_t":"The IE MRB-Identity is used to identify a multicast MRB used by a UE.","paragraph_zero_based":25407},{"literal_text_all_w_t_and_m_t":"MRB-Identity information element","paragraph_zero_based":25408},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25409},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-START","paragraph_zero_based":25410},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25411},{"literal_text_all_w_t_and_m_t":"MRB-Identity-r17 ::=                    INTEGER (1..512)","paragraph_zero_based":25412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25413},{"literal_text_all_w_t_and_m_t":"-- TAG-MRB-IDENTITY-STOP","paragraph_zero_based":25414},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["310bb74148935c51eb7e9bb0c465d12028cec7b1931f34a9018c3fc7fbf0bbad","9aa1fd9bdf37771355c280cb7f10eb7ff671181181076c3b2047b9dd9e79ab64","c8fcbb523bb5c086d1c713fbfcb8e37f4270ce9382476c5dd9e2ec2eb9250089","f3d4b98d1326322b11949037763499f3e2e6c40860043aa628ed9e96acd27abd","e942596f173e377c2a1bb0307e1c9e9d5735fab5928864ff2620a26917ecde28","2c6c3dac8da1c334f43005e93f657cede0b46eac3b8deef3685c0cfd7d997f90","ad1e4d9ab58c8b337c8a040d2a6eb73c7b7feb509e248cdc34a9c70a64cb61cf","9b5043fb9e3c35274b7caade7c6471837403a6fe15d346ce53cd4a7b0e5c0058","a9756b0d74c8ce1668ee549f501e8ec5862f409db25ab1507fc2b3fafa2db97c","cd20a22ef308fc30a502442b152b07359d0444541cba336ef77a2834e9d13573","692b5de27c50c5b92c4df3b2742bd7edc77cfdafce53b5177367e203edd09dab","39da64d0db24db095058c0da1619d5bac21058f8bec309a5c4e6e43f15d9c5fe","34f310b692deadbdbe0bb838c106c44fd37c93d45d510b9718e826665e9173ca","f55c613996009b443a845542e82c44ca48ce29c6d4c19fb9c70059abda64d1d3","775b3fca5f4769b5d0bfa88652fb4310fd571c96d5a51d6d6c12761521b563be","141