{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47064},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47065},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelConfig field descriptions","paragraph_zero_based":47066},{"literal_text_all_w_t_and_m_t":"sl-MAC-LogicalChannelConfig","paragraph_zero_based":47067},{"literal_text_all_w_t_and_m_t":"The field is used to configure MAC SL logical channel parameters.","paragraph_zero_based":47068},{"literal_text_all_w_t_and_m_t":"sl-RLC-ChannelID","paragraph_zero_based":47069},{"literal_text_all_w_t_and_m_t":"Indicates the PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE, or between L2 U2U Remote UE and L2 U2U Relay UE.","paragraph_zero_based":47070},{"literal_text_all_w_t_and_m_t":"sl-RLC-Config","paragraph_zero_based":47071},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters.","paragraph_zero_based":47072},{"literal_text_all_w_t_and_m_t":"sl-PacketDelayBudget","paragraph_zero_based":47073},{"literal_text_all_w_t_and_m_t":"Indicates the Packet Delay Budget for a PC5 Relay RLC channel used in L2 U2N relay operation. Upper bound value for the delay that a packet may experience expressed in unit of 0.5ms.","paragraph_zero_based":47074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47075},{"literal_text_all_w_t_and_m_t":"–SL-RLC-ChannelID","paragraph_zero_based":47076},{"literal_text_all_w_t_and_m_t":"The IE SL-RLC-ChannelID is used to identify a PC5 Relay RLC channel in the link between L2 U2N Relay UE and L2 U2N Remote UE, or between L2 U2U Relay UE and L2 U2U Remote UE.","paragraph_zero_based":47077},{"literal_text_all_w_t_and_m_t":"SL-RLC-ChannelID information element","paragraph_zero_based":47078},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zer