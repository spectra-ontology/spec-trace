18b95caa44a54bd8e1a02ef3895","7a48b2cdd173d2a5d8951887e5ad6dc1928fb157de368f3635926cbaf419c147","75cd39af8d494d2c5b54782927e9bb819c6d64495882570d104a717eb8e7bca7","af4197fd78bc37c3ca97d56a8d2db98f61c8151a8a4299df9f7b94464aa82880","ef8969ad3606c7f1338b69bf2fd085b37fec63c5bc0828faa5282ef81540cde9","5bfba45ed0600047d2c8bbcddbe09a8dda7fab1f5b988f9b47445ff358ea75cb","cabf68c14a6021e7a4aeaa2cc2ce8ce9fa680daec556393020c895875282e73f","7bb7d236a9186e9fb3aed2b94f7113052430e5de8f7d35a08ee2beef89d5741c","77e3839dffa24db8b1e0dc9a39c0bb63b979acc054f3aaecd44993e795c1a2d5","a24dc4d0a7e7c9700c85094f8264dfcc1d1908af0ebf145c1c8180f94ca1979c","84f09fbfcd748d0b86335986fcaf6830d3a321e7c9487830de6d4d3fdca333c2","b93909da8e241f4b9bad3a3878e88f2575c95f40fe1e1501d989562f80ef52d4","3140b54eac76e2b16c7ab4a17c7802b4c8f80be5c9ecb640622ed6a11a4e9a2b","298ecfa90954c8854b2c723331cabf498aff75f3cbe37924a7bf1cee536b263b","a82a436e41ed05c610374e27513de895bd49335bad928c0934b9aa3aa000c760","d998f09634c9d49c54a4faa8ec2c99f6e2afe1ba6d3273a795f335fb80bf837d"],"paragraph_range_zero_based":[30528,30551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30528"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30552},{"literal_text_all_w_t_and_m_t":"DRB-ToAddMod and MRB-ToAddMod field descriptions","paragraph_zero_based":30553},{"literal_text_all_w_t_and_m_t":"cnAssociation","paragraph_zero_based":30554},{"literal_text_all_w_t_and_m_t":"Indicates if the bearer is associated with the eps-bearerIdentity (when connected to EPC) or sdap-Config (when connected to 5GC).","paragraph_zero_based":30555},{"literal_text_all_w_t_and_m_t":"daps-Config","paragraph_zero_based":30556},{"literal_text_all_w_t_and_m_t":"Indicates that the bearer is configured as DAPS bearer.","paragraph_zero_based":30557},{"literal_text_all_w_t_and_m_t":"drb-Identity","paragraph_zero_based":30558},{"literal_text_all_w_t_and_m_t":"In case of DC, the DRB identity is unique within the scope of the UE, i.e. an MCG DRB cannot use the same value as a split DRB. For a split DRB the same identity is used for the MCG and SCG parts/indirect path of the configuration.","paragraph_zero_based":30559},{"literal_text_all_w_t_and_m_t":"eps-BearerIdentity","paragraph_zero_based":30560},{"literal_text_all_w_t_and_m_t":"The EPS bearer ID determines the EPS bearer.","paragraph_zero_based":30561},{"literal_text_all_w_t_and_m_t":"mbs-SessionId","paragraph_zero_based":30562},{"literal_text_all_w_t_and_m_t":"Indicates which multicast MBS session the bearer is associated with.","paragraph_zero_based":30563},{"literal_text_all_w_t_and_m_t":"mrb-Identity","paragraph_zero_based":30564},{"literal_text_all_w_t_and_m_t":"Identification of the multicast MRB.","paragraph_zero_based":30565},{"literal_text_all_w_t_and_m_t":"mrb-IdentityNew","paragraph_zero_based":30566},{"literal_text_all_w_t_and_m_t":"New identity of the multicast MRB when mrb-Identity needs to be changed, e.g. as a result of a handover.","paragraph_zero_based":30567},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":30568},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to termination point change for the bearer, reconfiguration with sync, resuming an RRC connection, or the first reconfiguration after reestablishment. It is also applicable for LTE procedures when NR PDCP is configured. Network doesn't include this field for DRB if the bearer is configured as DAPS bearer or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE.","paragraph_zero_based":30569},{"literal_text_all_w_t_and_m_t":"recoverPDCP","paragraph_zero_based":30570},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should perform recovery according to TS 38.323 [5]. Network doesn't include this field if the bearer is configured as DAPS bearer or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE.","paragraph_zero_based":30571},{"literal_text_all_w_t_and_m_t":"sdap-Config","paragraph_zero_based":30572},{"literal_text_all_w_t_and_m_t":"The SDAP configuration determines how to map QoS flows to DRBs when NR or E-UTRA connects to the 5GC and presence/absence of UL/DL SDAP headers.","paragraph_zero_based":30573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30574},{"literal_text_all_w_t_and_m_t":"RadioBearerConfig field descriptions","paragraph_zero_based":30575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e3a403710a95a13552cb749e7703bcacf14c1e9f789e47e75fedea499cae9c7a","daddcba149e65ce541aa7d2945d61b8745b3b09addb7c14fec0a903326001342","03f5734bbc2ad63801871349e6c15fd2d8310071d994d257d0129aba9211f7e4","408986a8fc28cb1afeef1cf2ddbca6e2e7170fc1f7eec9e6bc099f97342ac767","60bc54dd53fdfd5b04a26f40ba906a7c6614ece90e4725882d80e4a66e6ecdf6","b87de14e3f5325f995d6459330dbd2fe54d238799e9bd010d434a82515ea8a72","4b909a87fa7e60fb06c4673713f6e37d11ac5e04614ea5c2e6c5ee807f164c89","4c073b83bfd13bb550ab7ab53f4879988f94a10b94c1779629447154b8ddc0c7","bcd084ccf99e363116c15d2efef0ecc43f18ab5de09cf094fe50bfd82efed45f","5a83584fb6d4023ab2aa04ee5da704a20a05cefe4a1ba3b6ea596089935cff18","892708ee729d27494c06dc59b6808dee247015a2acbdc5773058d0d2c8c970e8","8834ee0d854f59da41edb49ecd32604c04062893c19f9caf9ff8b8d475c4559e","c41c45ccfda2e94527a2cc73f59b953394ce3f773cb50a7c7a94caa7a32cea9c","bdf131325546ecfcfac34e7d58f0bc8aeb9ffc1c93db5684d82171afa97b1df3","9eff4ed9256c95a264848992c3fa573da51eecc5ee64dcdccb23bf560d993c2d","08b1ccf2df7f3093a22f3655267db0952b61be5ae00f7b650a201ec3197bcf79","0fa53fcefbae37e7bc22e32e46f75abfce7200d7e9ce5ccb648f2652b6e8e1bc","4089201695b4fe5ecb047beeffee11eee9d7602382eec1b7ae0040ca92bdc86f","e4eff633d3b3e1258ce4194fbccee834c92d4c2e0811a82c664ca02ce124b9d6","38fbb8bd4a47d75edd11c3bcadbabfa2b0012f5a941f545256ac484f13fd9164","32233f88b2b38377c432ba3fabcad5e9c41e9f10a45d31c50c3568ec1083dc89","59311a9a58e7722dfb24f2edcc07dc80d8f64dd542566b28fe4775f9a0b472b1","ec018c218333b04ca338bee9814db0bb1d2715655a14fee6b2daa4267399f330","0bdf44e470704833d117cfb37f96513bce6e99a30f61bd2fea267eca673108af"],"paragraph_range_zero_based":[30552,30575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30552"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"securityConfig","paragraph_zero_based":30576},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm and key to use for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included after AS security has been activated, the UE shall continue to use the currently configured keyToUse and security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig. The field is not included when configuring SRB1 before AS security is activated.","paragraph_zero_based":30577},{"literal_text_all_w_t_and_m_t":"srb3-ToRelease","paragraph_zero_based":30578},{"literal_text_all_w_t_and_m_t":"Release SRB3. SRB3 release can only be done over SRB1 and only at SCG release and reconfiguration with sync.","paragraph_zero_based":30579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30580},{"literal_text_all_w_t_and_m_t":"SecurityConfig field descriptions","paragraph_zero_based":30581},{"literal_text_all_w_t_and_m_t":"keyToUse","paragraph_zero_based":30582},{"literal_text_all_w_t_and_m_t":"Indicates if the bearers configured with the list in this IE RadioBearerConfig are using the master key or the secondary key for deriving ciphering and/or integrity protection keys. For MR-DC, network should not configure SRB1 and SRB2 with secondary key and SRB3 with the master key. When the field is not included, the UE shall continue to use the currently configured keyToUse for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":30583},{"literal_text_all_w_t_and_m_t":"securityAlgorithmConfig","paragraph_zero_based":30584},{"literal_text_all_w_t_and_m_t":"Indicates the security algorithm for the signalling and data radio bearers configured with the list in this IE RadioBearerConfig. When the field is not included, the UE shall continue to use the currently configured security algorithm for the radio bearers reconfigured with the lists in this IE RadioBearerConfig.","paragraph_zero_based":30585},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30586},{"literal_text_all_w_t_and_m_t":"SRB-ToAddMod field descriptions","paragraph_zero_based":30587},{"literal_text_all_w_t_and_m_t":"discardOnPDCP","paragraph_zero_based":30588},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should discard stored SDU and PDU according to TS 38.323 [5].","paragraph_zero_based":30589},{"literal_text_all_w_t_and_m_t":"reestablishPDCP","paragraph_zero_based":30590},{"literal_text_all_w_t_and_m_t":"Indicates that PDCP should be re-established. Network sets this to true whenever the security key used for this radio bearer changes. Key change could for example be due to reconfiguration with sync, for SRB2 when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment in NR, the network does not set this field to true. For LTE SRBs using NR PDCP, it could be for handover, RRC connection reestablishment or resume. Network doesn't include this field if any DAPS bearer is configured or if the RadioBearerConfig IE is part of an RRCReconfiguration message within the LTM-Config IE.","paragraph_zero_based":30591},{"literal_text_all_w_t_and_m_t":"srb-Identity, srb-Identity-v1700, srb-Identity-v1800","paragraph_zero_based":30592},{"literal_text_all_w_t_and_m_t":"Value 1 is applicable for SRB1 only. Value 2 is applicable for SRB2 only. Value 3 is applicable for SRB3 only. Value 4 is applicable for SRB4 only. Value 5 is applicable for SRB5 only. If srb-Identity-v1700 or srb-Identity-v1800 is received for an SRB, the UE shall ignore srb-Identity (i.e. without suffix) for this SRB.","paragraph_zero_based":30593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30594},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30595},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30596},{"literal_text_all_w_t_and_m_t":"RBTermChange","paragraph_zero_based":30597},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":30598},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":30599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b1ff7f101b05641203acd90202a83866a9cd835615a0d44aa0ea1f34dc851fa6","9fd44ea51f039b57209b61b6396e1f39ee19bfaf46105d4a32d37dabc224a848","c55cf56126019bb8727582dfed15accabbf8c356bdacfdbf9f0fb5acc70b75b2","ab7d70aec750be2ae09f2b6d4a5b16def5b2e0bdeefb4df4342a5fe5ede2b455","66f0bb222d6542922d18cd9fa5660ba6416dd16164269a8c0db269872f7762db","8b3fa10c163c038696cde99a233c0236868cb50c83bff4bf4a1c8928bb3d77a5","ccc522ea6fcca5485288fc9ced173006dce8b7acd29ce48a3fd4315e4d9250d8","91dc71e01ca0bfa143f3c411d55148e2ac1348a3f41399bf29cca536939769d0","1b36510817ff47b00852561193233cff99fea947bf240542ab8e4bd9be30af4e","a115c378f81c79006b50788ba3fb5761216250d7b9da7a85d0588b5eaaa6e913","73e5dd166bea06a722984d8392763dd42b8a56c5adf39baab0a18e4cc1e1875d","2df54404496c634a028ce81e1d9d9a993e9a79c838a9f54213ff1b48612f337b","72ce4b1e72a12ef304f7551b2a78c653b488672d77f43c65f0d37fd84e075983","0adc0428bb6638bdf86ca112b6dea6291959e1dc4156c9b7e443fb8a4b3bbb67","c0fba4e6023fbdfff313204ff29992e6b536d53ca44e6167e46a7450b5bf0f9a","51a5a234b8576f6a95f12da67d5926fd6c52493b2e8cb9a790e150719411d9d2","43b8ca411e491b727c835cc71e9890ded088e0ee5358686c2f5003785a106b65","99115da4e0546360ab97c4a45d9330af18938c7a78e6f0f8897dcc89c39a90a8","cc93776d793abbbfd323867c686a7b3f475e8d9e4d828c2d26ebc9d768615f6f","fca41e4faf39625fd3ea8ce4a3c2ea4647edf04c9bef9443bb3b380cfab65578","1ae993d16981807d85fb15e2bf285a18a93e369183c45e9690cedace2c4de10f","35d6890689298e59ce5e761a8ed244239ac4e14d354d8ce4d94165a446c5e783","cb760fcccf555dac1d8e99dfef785e902e505b09f5c53fef6ac7939bdbaeeb36","7f1fdf30f83da19b4cd0ce0011e1de1b4b80add70e4aeb508bee1c123894540f"],"paragraph_range_zero_based":[30576,30599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30576"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN.","paragraph_zero_based":30600},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":30601},{"literal_text_all_w_t_and_m_t":"RBTermChange1","paragraph_zero_based":30602},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of:","paragraph_zero_based":30603},{"literal_text_all_w_t_and_m_t":"-set up of signalling and data radio bearer,","paragraph_zero_based":30604},{"literal_text_all_w_t_and_m_t":"-change of termination point for the radio bearer between MN and SN,","paragraph_zero_based":30605},{"literal_text_all_w_t_and_m_t":"-handover from E-UTRA/EPC or E-UTRA/5GC to NR,","paragraph_zero_based":30606},{"literal_text_all_w_t_and_m_t":"-handover from NR or E-UTRA/EPC to E-UTRA/5GC if the UE supports NGEN-DC.","paragraph_zero_based":30607},{"literal_text_all_w_t_and_m_t":"It is optionally present otherwise, Need S.","paragraph_zero_based":30608},{"literal_text_all_w_t_and_m_t":"PDCP","paragraph_zero_based":30609},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB/multicast MRB is being setup or corresponding DRB/multicast MRB is reconfigured with NR PDCP or corresponding SRB associated with two RLC entities is being setup or if the number of RLC bearers associated with the DRB/multicast MRB or SRB is changed. The field is optionally present, Need S, if the corresponding SRB associated with one RLC entity is being setup or corresponding SRB is reconfigured with NR PDCP; otherwise the field is optionally present, need M.","paragraph_zero_based":30610},{"literal_text_all_w_t_and_m_t":"DRBSetup","paragraph_zero_based":30611},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding DRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":30612},{"literal_text_all_w_t_and_m_t":"HO-Conn","paragraph_zero_based":30613},{"literal_text_all_w_t_and_m_t":"The field is mandatory present","paragraph_zero_based":30614},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":30615},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured,","paragraph_zero_based":30616},{"literal_text_all_w_t_and_m_t":"-or in case of RRCSetup.","paragraph_zero_based":30617},{"literal_text_all_w_t_and_m_t":"Otherwise the field is optionally present, need N.","paragraph_zero_based":30618},{"literal_text_all_w_t_and_m_t":"Upon RRCSetup, only SRB1 can be present.","paragraph_zero_based":30619},{"literal_text_all_w_t_and_m_t":"HO-toNR","paragraph_zero_based":30620},{"literal_text_all_w_t_and_m_t":"If mrb-ToAddModList is not included, the field is mandatory present for UEs other than NCR-MT","paragraph_zero_based":30621},{"literal_text_all_w_t_and_m_t":"-in case of inter-system handover from E-UTRA/EPC to E-UTRA/5GC or NR,","paragraph_zero_based":30622},{"literal_text_all_w_t_and_m_t":"-or when the fullConfig is included in the RRCReconfiguration message and NE-DC/NR-DC is not configured.","paragraph_zero_based":30623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c3f5475e41d50664c1d92271e7f716ef642b10483c4315345abae0a9057fca3f","2d156ab0a579a91304f46818845fd9bb490ed224cfe1e9d4689585d6186043e0","039db103acb370e94591504a3677980dd5cf9d58686fd8c07345346b095a4335","fd247531ada5d13e1c1e232c3a7a36a3e6d4d67f31f51a14567e15ee62af9d98","61c12c7fbcd68c5cd58a175c1d47a1bc1ed7210e2bebcb3fef703aa67183fdf7","73aeb0aa3edc3d29ee4dc5a6be5436dca403ee707b4972bf21f2be12141367aa","afaac0ff2f035c7dccf6e48aca4c16b028807bed9987f1325c25be59737ff8dc","b23f965b25451dbcf513ba4c182a61caad543b9bd3371477fa0c584d7aca4799","8ba56f80609e9ea8f62bf7b833692c7ad5a292190addb3307e8811aab65c2a24","3bf911125bf164633b4bb5347d40cc84b6ab0a9769da6d6685805bf3d66be3af","3e885d18f411154bb8dcbc012ccf56ac7176fc7bd1c220ec36da2acead0f7b6f","2882b600e5e6379b16af3fa8a6fbd40284d44b343994b1c28894e74a6c05de5e","7f5d91f8c7854bd7a313f42fb6df6a8e21f5caa7298a771b02c2503284519900","22c92e8165e0c075111d62a29f1e64109bd06915479571822f77e32347ba0a27","b100398d145d918a9908c17b0b322f0c0784686efce33b2511bb7a32170acddf","34b50bdf539e88d469fe8632de29ffbe0ec0057fc57e0b4cf228e5af3356dc3f","8c6bb8a0b2264b7c9ba746afbfdfd477b6cef166dcb0a03f8febd218539d9221","17a1ffe636a5f643ff03c3185562ef0eed934472b8051e1b9a60615e66830bcc","46ab7801ebadb943ad90d53dd768e86a98f019215bc3ac7b29eda1209d9322bd","9dc94cec6fa0cee8e30ec2361cd9ea62932cbe676ca661cff6be29039ebf18a5","13b4d85d436a8431c79a40e45f410f329e0b5e66fe71cebf477507a6861131d9","0d6654044154b2139b48edd5810e95fd390a6ab490f1988e50d481013e4ff595","630bd1f6c0e7ec9f86e7d03b3bf935048c047d8fefab42c7c341a6b68f55f6db","f37f3c776a5331f427886f4e87771847fa517b1831ad89d872728d0130099ea4"],"paragraph_range_zero_based":[30600,30623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30600"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"In case of RRCSetup, the field is absent; otherwise the field is optionally present, need N.","paragraph_zero_based":30624},{"literal_text_all_w_t_and_m_t":"DAPS","paragraph_zero_based":30625},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need N, in case masterCellGroup includes ReconfigurationWithSync, SCell(s) and SCG are  not configured, multi-DCI/single-DCI based multi-TRP are not configured in any DL BWP, supplementaryUplink is not configured, ethernetHeaderCompression is not configured for the DRB, conditionalReconfiguration is not configured, and NR sidelink and V2X sidelink are not configured. Otherwise the field is absent.","paragraph_zero_based":30626},{"literal_text_all_w_t_and_m_t":"MRBSetup","paragraph_zero_based":30627},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the corresponding multicast MRB is being setup; otherwise the field is optionally present, need M.","paragraph_zero_based":30628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30629},{"literal_text_all_w_t_and_m_t":"–RadioLinkMonitoringConfig","paragraph_zero_based":30630},{"literal_text_all_w_t_and_m_t":"The IE RadioLinkMonitoringConfig is used to configure radio link monitoring for detection of beam- and/or cell radio link failure. See also TS 38.321 [3], clause 5.1.1.","paragraph_zero_based":30631},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig information element","paragraph_zero_based":30632},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30633},{"literal_text_all_w_t_and_m_t":"-- TAG-RADIOLINKMONITORINGCONFIG-START","paragraph_zero_based":30634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30635},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringConfig ::=       SEQUENCE {","paragraph_zero_based":30636},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToAddModList   SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS","paragraph_zero_based":30637},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":30638},{"literal_text_all_w_t_and_m_t":"    failureDetectionResourcesToReleaseList  SEQUENCE (SIZE(1..maxNrofFailureDetectionResources)) OF RadioLinkMonitoringRS-Id","paragraph_zero_based":30639},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":30640},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount             ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                          OPTIONAL, -- Need R","paragraph_zero_based":30641},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer               ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}  OPTIONAL, -- Need R","paragraph_zero_based":30642},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30643},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30644},{"literal_text_all_w_t_and_m_t":"    beamFailure-r17                         BeamFailureDetection-r17                                              OPTIONAL  -- Need R","paragraph_zero_based":30645},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30646},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["