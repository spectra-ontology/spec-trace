{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    groupB-ConfiguredTwoStepRA-r16                       GroupB-ConfiguredTwoStepRA-r16                                 OPTIONAL, -- Need S","paragraph_zero_based":30456},{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-RootSequenceIndex-r16                     CHOICE {","paragraph_zero_based":30457},{"literal_text_all_w_t_and_m_t":"        l839                                                 INTEGER (0..837),","paragraph_zero_based":30458},{"literal_text_all_w_t_and_m_t":"        l139                                                 INTEGER (0..137),","paragraph_zero_based":30459},{"literal_text_all_w_t_and_m_t":"        l571                                                 INTEGER (0..569),","paragraph_zero_based":30460},{"literal_text_all_w_t_and_m_t":"        l1151                                                INTEGER (0..1149)","paragraph_zero_based":30461},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                   OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30462},{"literal_text_all_w_t_and_m_t":"    msgA-TransMax-r16                                    ENUMERATED {n1, n2, n4, n6, n8, n10, n20, n50, n100, n200}     OPTIONAL, -- Need R","paragraph_zero_based":30463},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-Threshold-r16                              RSRP-Range                                                     OPTIONAL, -- Cond 2Step4Step","paragraph_zero_based":30464},{"literal_text_all_w_t_and_m_t":"    msgA-RSRP-ThresholdSSB-r16                           RSRP-Range                                                     OPTIONAL, -- Need R","paragraph_zero_based":30465},{"literal_text_all_w_t_and_m_t":"    msgA-SubcarrierSpacing-r16                       