{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":32136},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":32137},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a CLI measurement resource in srsTriggeredList or rssiTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":32138},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":32139},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":32140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32141},{"literal_text_all_w_t_and_m_t":"CLI-PeriodicalReportConfig field descriptions","paragraph_zero_based":32142},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":32143},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":32144},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":32145},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":32146},{"literal_text_all_w_t_and_m_t":"reportQuantityCLI","paragraph_zero_based":32147},{"literal_text_all_w_t_and_m_t":"The CLI measurement quantities to be included in the measurement report.","paragraph_zero_based":32148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32149},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfig field descriptions","paragraph_zero_based":32150},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":32151},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":32152},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":32153},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":32154},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":32155},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":32156},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":32157},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":32158},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":32159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b456815321561068e7d5953bc9fbd39bbe70cfae8104aa110fe5e095c0196d7f","4ecb67f106ce08eb5fe3508b49a75ef622c862e7eab40a131f36956bba32a6ce","28b172bc32ce9fefaa8d7cc77996c1cf783e97eb289200489b69ab6e997d724a","e08cf6dfa0c75904e18eb39f43f77007c3ab241ab3682bcddae2b22a92ebe24b","c11b253eb62dce3a063dff0ff8caf9c6c59ed4c5f4571290d004715a59873240","fa84222f1e6c575a6450cbbdb57b26ac9d5a3e474b06a85902ae1948f6eff997","8e073376e88a40f43dfce9e9e90961f7346de2395296d21031a10328aa6e8c01","564f5e2a8d6f53ac3496e44cd526bf67c7596daf4d80b69effff69dcf0b87fea","452ec05df3de15f3061d8396187eda748794fd4a571144e32df2892169c48ca6","effdcdae3af7da45058eedc96aeb6f42f5c58e3f0962e034f81083d80e03f9d8","4815ae2d81b4f99b7e2bfddbfffa4c7a87d94d862a9ce6abff02def6ef1be206","c065e0e175f067d3698581820b0161c8de29c50ab905b7e7a6100305ec12c56b","3a246d35e09cf98c87d09faaba9c21496b8ff1418afa4d49af