{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    searchSpaceGroupIdList-r17          SEQUENCE (SIZE (1.. 3)) OF INTEGER (0.. maxNrofSearchSpaceGroups-1-r17)  OPTIONAL,  -- Cond DedicatedOnly","paragraph_zero_based":32616},{"literal_text_all_w_t_and_m_t":"    searchSpaceLinkingId-r17            INTEGER (0..maxNrofSearchSpacesLinks-1-r17)                     OPTIONAL    -- Cond DedicatedOnly","paragraph_zero_based":32617},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32618},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32619},{"literal_text_all_w_t_and_m_t":"SearchSpaceExt-v1800 ::=            SEQUENCE {","paragraph_zero_based":32620},{"literal_text_all_w_t_and_m_t":"    searchSpaceType-r18                 SEQUENCE {","paragraph_zero_based":32621},{"literal_text_all_w_t_and_m_t":"        common-r18                          SEQUENCE {","paragraph_zero_based":32622},{"literal_text_all_w_t_and_m_t":"            dci-Format2-9-r18                   SEQUENCE {","paragraph_zero_based":32623},{"literal_text_all_w_t_and_m_t":"                ...","paragraph_zero_based":32624},{"literal_text_all_w_t_and_m_t":"            }                                                                                           OPTIONAL,   -- Need R","paragraph_zero_based":32625},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":32626},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":32627},{"literal_text_all_w_t_and_m_t":"    }                                                                                                   OPTIONAL,   -- Need R","paragraph_zero_based":32628},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":32629},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32631},{"literal_text_all_w_t_and_m_t":"-- TAG-SEARCHSPACE-STOP","paragraph_zero_based":32632},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32633},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32634},{"literal_text_all_w_t_and_m_t":"SearchSpace field descriptions","paragraph_zero_based":32635},{"literal_text_all_w_t_and_m_t":"common","paragraph_zero_based":32636},{"literal_text_all_w_t_and_m_t":"Configures this search space as common search space (CSS) and DCI formats to monitor.","paragraph_zero_based":32637},{"literal_text_all_w_t_and_m_t":"controlResourceSetId","paragraph_zero_based":32638},{"literal_text_all_w_t_and_m_t":"The CORESET applicable for this SearchSpace. Value 0 identifies the common CORESET#0 configured in MIB and in ServingCellConfigCommon. Values 1..maxNrofControlResourceSets-1 identify CORESETs configured in System Information or by dedicated signalling. The CORESETs with non-zero controlResourceSetId are configured in the same BWP as this SearchSpace except commonControlResourceSetExt which is configured by SIB20. If the field controlResourceSetId-r16 is present, UE shall ignore the controlResourceSetId (without suffix).","paragraph_zero_based":32639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1262185da1f9d417a167b6ae7686cc623a9acb51bed44eee49232beadd184699","afbb45bed352b8862894e6103fb8b41380de702ab082283c246e0bc9cc478a34","988286081ccdfc6aa14462305f095ded66dde094f712f58e06403102232d49a5","26a4ab008915230a7e852744e02d2ce4e7264395f7bfa01438722fa8cd2e8f34","d98ae631a0961d9ab7a359d285d8326b421b706ad42fb37c99ecd37fc6add302","c3e6626c012092891059c72d196194c5df0229a58a56a339a1879430e4ccdca7","0de9194c90ad482c712243269b891c57a4396a67f