{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45481},{"literal_text_all_w_t_and_m_t":"SL-ThresholdRSRP-Condition1-B-1-r17 ::=   SEQUENCE {","paragraph_zero_based":45482},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r17                           INTEGER (1..8),","paragraph_zero_based":45483},{"literal_text_all_w_t_and_m_t":"    sl-ThresholdRSRP-Condition1-B-1-r17       INTEGER (0..66)","paragraph_zero_based":45484},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45486},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-INTERUE-COORDINATIONCONFIG-STOP","paragraph_zero_based":45487},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45488},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45489},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme1 field descriptions","paragraph_zero_based":45490},{"literal_text_all_w_t_and_m_t":"sl-Condition1-A-2","paragraph_zero_based":45491},{"literal_text_all_w_t_and_m_t":"Indicates disabling the use of condition of excluding from preferred resource set resource(s) in slot(s) where UE-A, when it is intended receiver of UE-B, does not expect to perform SL reception from UE-B due to half duplex operation.","paragraph_zero_based":45492},{"literal_text_all_w_t_and_m_t":"sl-ContainerCoordInfo","paragraph_zero_based":45493},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of inter-UE coordination information transmission from UE-A to UE-B in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":45494},{"literal_text_all_w_t_and_m_t":"sl-ContainerRequest","paragraph_zero_based":45495},{"literal_text_all_w_t_and_m_t":"Indicates whether a SCI format 2-C can be used as the container of an explicit request for inter-UE coordination information transmission from UE-B to UE-A in Scheme 1 in addition to using MAC CE.","paragraph_zero_based":45496},{"literal_text_all_w_t_and_m_t":"sl-DetermineResourceType","paragraph_zero_based":45497},{"literal_text_all_w_t_and_m_t":"Indicates how to determine the resource set type to be provided by inter-UE coordination information transmission. Value \"uea\" means the resource set type is determined by UE-A's implementation. Value \"ueb\" means the resource set type is determined by UE-B's request.","paragraph_zero_based":45498},{"literal_text_all_w_t_and_m_t":"sl-IUC-Condition","paragraph_zero_based":45499},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by a condition is enabled or not other than explicit request reception.","paragraph_zero_based":45500},{"literal_text_all_w_t_and_m_t":"sl-IUC-Explicit","paragraph_zero_based":45501},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination information triggered by an explicit request is enabled or not. ","paragraph_zero_based":45502},{"literal_text_all_w_t_and_m_t":"sl-MaxSlotOffsetTRIV","paragraph_zero_based":45503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b18120e3a5a03c86936673da50785774feee8f7437ba09c689e94ddaa8facb25","28cb119368af9d3a981d8a9487709639f05784f9062009f8ac19c4999c086a35","9f4f4bb637180b704a08e864de3b553a58706bd9541408fed424f0bd3e576473","0048ee015e8a81b829ac082b392cef1dba54f9792d4bcba0afa6b755acba254b","097499a224139b2ad7ab3167b0b77bec4655b2d7eb5b15070d93a00057d9878f","82070c32950ad2487fcaeaa7d0734f5f52b04551d8900926a4526df7893b4f52","57cc29f0dd0421a7ac536fd0d984c7255c44b27d6acbdfa0f9934e85f55246a5","90743d3be7a1c2e58e2f97fb3c262d9e6d6a25bd417d277cf3f237efd27e59eb","becb16af1f0b39b940439e407c8b7eaf83187a66494ada65b31c120749f4d0f2","53f07a82154980fbf9fb587d22f1135b0a9ba76c592e5473b62677792bf31d93","fd9c2d5df61d4e41d5b75f863bd92449a284d0d691a2c9a3bc4e912fbdaec244","0669d7b65d6451a75ba98f6fbb8c78cb919857417d6bd6ecd3d718c2bc7b4860","ba2977ec01aa3b7f812c286c86a2b4936f83551d988b81cbeff1ec1b92abb1c5","2a881cd8c43e45139a03e8aa4c13a5bab82d779a21308ee978a80b3b8d372793","a8329a2a333f6a5d408981e327b4dc8af5430b1acb7a256d8cb6cd5de80155fc","f19037a2ba0f6a7a7bfda581755c6c365770199137f820d1e49622a04082774a","498f66f77b10136ea2462c11c3877cc290848cd2bb593961fc87704ef0db1fd6","9c9e26b44f55991ca57d35331605dbcb9f01cd8c09bdb6e4bf4d6c03a9688fef","225ff584284fbf97b02679929b0321e57e48cda50984e1fb6fac838ff6421a18","5b542573f93df86912fc53a21da021c04704ae8faec19c3f245e05cc803064b2","f940739603e08c3f49c1dcdf1a22b05d897b9e73d5ed4af6eb6099953b7a0af8","4b3a5b56c504d5634c73c5930ad1d4ce4803414c3e1f20e93d204dad47f66a75","b67b677674e2e8822878e0274a5c30a0d8ab34cb92d15d66e748182f0c9baee5","171715167cc8bbdc7bbecaabbbee05c8a1e8fdc83aba5eef2a342ac2cf602711"],"paragraph_range_zero_based":[45480,45503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p45480"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the maximum value of logical slot offset with respect to a reference slot that is used for representing the first resource location of each TRIV to indicate the set of resources in Scheme 1 as specified in TS 38.214 [19].","paragraph_zero_based":45504},{"literal_text_all_w_t_and_m_t":"sl-NumSubCH-PreferredResousrceSet","paragraph_zero_based":45505},{"literal_text_all_w_t_and_m_t":"Indicates the number of sub-channels used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":45506},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoCondition","paragraph_zero_based":45507},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by a condition other than explicit request reception in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":45508},{"literal_text_all_w_t_and_m_t":"sl-PriorityCoordInfoExplicit","paragraph_zero_based":45509},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC MAC CE, triggered by an explicit request in Scheme 1. The priority value of IUC MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":45510},{"literal_text_all_w_t_and_m_t":"sl-PriorityPreferredResourceSet","paragraph_zero_based":45511},{"literal_text_all_w_t_and_m_t":"Indicates the priority value used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition other than explicit request reception.","paragraph_zero_based":45512},{"literal_text_all_w_t_and_m_t":"sl-PriorityRequest","paragraph_zero_based":45513},{"literal_text_all_w_t_and_m_t":"Parameter used to determine the priority values for the purpose defined in TS 38.213 [13] and TS 38.214 [19] including, the priority value for sensing and candidate resource (re-)selection for transmitting the TB carrying the IUC request MAC CE and the priority value in the SCI Format 1-A corresponding to the TB carrying the IUC request MAC CE, in an explicit request for inter-UE coordination information in Scheme 1. The priority value of IUC request MAC CE used in LCP procedure (see TS 38.321 [3]) is fixed as \"1\".","paragraph_zero_based":45514},{"literal_text_all_w_t_and_m_t":"sl-ReservedPeriodPreferredResourceSet","paragraph_zero_based":45515},{"literal_text_all_w_t_and_m_t":"Indicates the resource reservation interval used for determining the preferred resource set in Scheme 1 when the inter-UE coordination information transmission is triggered by a condition, by means of an index to the corresponding entry of sl-ResourceReservePeriodList-r16. ","paragraph_zero_based":45516},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionCoordInfo","paragraph_zero_based":45517},{"literal_text_all_w_t_and_m_t":"Indicates the additional alternative trigger condition of inter-UE coordination information triggered by a condition rather than request reception in Scheme-1 from UE-A to UE-B. Value 0 means inter-UE coordination information is triggered by UE-A's implementation. Value 1 means inter-UE coordination information can be triggered only when UE-A has data to be transmitted together with the inter-UE coordination information to UE-B.","paragraph_zero_based":45518},{"literal_text_all_w_t_and_m_t":"sl-TriggerConditionRequest","paragraph_zero_based":45519},{"literal_text_all_w_t_and_m_t":"Indicates the trigger condition of an explicit request from UE-B to UE-A. Value 0 means the explicit request is triggered by UE-B's implementation. Value 1 means the explicit request can be triggered only when UE-B has data or SL-PRS to be transmitted to UE-A.","paragraph_zero_based":45520},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option1List","paragraph_zero_based":45521},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is larger than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":45522},{"literal_text_all_w_t_and_m_t":"sl-ThresholdRSRP-Condition1-B-1-Option2List","paragraph_zero_based":45523},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to determine reserved resource(s) of other UE(s) whose RSRP measurement is smaller than it as the set of resource(s) non-preferred for UE-B's transmission for Condition 1-B-1 of Scheme 1, as specified in TS 38.214 [19]. Value 0 corresponds to minus infinity dBm, value 1 corresponds to -128dBm, value 2 corresponds to -126dBm, value n corresponds to (-128 + (n-1)*2) dBm and so on, value 66 corresponds to infinity dBm.","paragraph_zero_based":45524},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45525},{"literal_text_all_w_t_and_m_t":"SL-InterUE-CoordinationScheme2 field descriptions","paragraph_zero_based":45526},{"literal_text_all_w_t_and_m_t":"sl-DeltaRSRP-Thresh","paragraph_zero_based":45527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["dc1dc58868d41c0b40fffc8f9be5494778717b7da7f47fe02b365f33db9ed229","783f944d779e1603b26ee1a13fc1260f94d6b441b196e72c043e7abb663d8ba3","5de88bbd12cb988329c606bbd05856d386e094cbd524ff02f1118742c70c64ea","285d5d64f8ea00e76f5e5afee3a157770ef7bdb375fac94304c9fb9d9d339e0f","35f2ff14a3d089637aea3d2a9b6d905c0d17f221c3d86de55d80474aca8c9611","c983032c4d906bdab707905c1fc4cf0bddeefaa0766ff5205eff531eab5298da","86bd22ee832f3351aeab94278a732c3af09249c6a362d0ca10aff9ec1b14a64d","6e91bac8b1db5e9be8f27d67f39c505fcd856dd79bb1c32b245adf955a1ea938","09cce8803abfccecf429db197ddcffde6f1d369398c5824446242dec48cd4ee8","df739df29d9c7c5b2b59b139ea345406a14241afc909789f7ace4b40cf630cb1","bc888d58c95de265595d4de80fede362674a5377a092e74e722640e24bc66fe1","4c69c21bc797ad48490bd77ac046e2d64405338da4fb3befde647cdadc83f68d","e1c2236eff8bfa5d027072ede6c2cc77fb99d91889fa087ae8bae87b9a24c873","95eec97daf4f0b4ff28fd8c364eda718741265babe76302079b9d4c85ad5240e","dba0c46b3085c3229317ea0e1ee19138ee151b013193f15200d4603a32de9ba4","a2e3daa6c97cfbd7582763b9887edd17b8c7a8cedef113c4603180dad9338f19","ab0fc6c076bbb03b58e60592abda76dcb2551212baf07f4b77a62f702286b144","be2aace5cef75dbf877be698daa40c1c7515faaf7166b8a84946f3c872bf6b2d","0975c58033383fc17b014c5ef74e601c46fc0ebfc40ec81d67126d5e3ab077b1","b0ea452dd726ad88c4d16470e474df92faaa4e925495630b22b3192f9ab7baee","0529ebc99549eacca596068027fb06c939ebe360857ea5c1cc87ca0b3456a614","172a0deb61018ab207548a27621dfd635147aed54f6d1dd2e3400e456dc91c5f","9db14d1236c0d9642d871f2039c80ce1c22563a023b4e50ab98f567936f7184b","e0caa1b2b663063e7dbcfabb0a0f15a9ec9c122c8fb5e6aa55ecac126b4338b0"],"paragraph_range_zero_based":[45504,45527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p45504"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold delta value corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13] and used to determine reserved resource(s) of other UE(s). Value in dB. Only even values (step size 2) allowed.","paragraph_zero_based":45528},{"literal_text_all_w_t_and_m_t":"sl-IndicationUE-B","paragraph_zero_based":45529},{"literal_text_all_w_t_and_m_t":"Indicates whether to enable or disable the usage of 1 LSB of reserved bits of a SCI format 1-A to indicate of whether UE scheduling a conflict TB can be UE-B or not.","paragraph_zero_based":45530},{"literal_text_all_w_t_and_m_t":"sl-IUC-Scheme2","paragraph_zero_based":45531},{"literal_text_all_w_t_and_m_t":"Indicates whether inter-UE coordination Scheme 2 is enabled or not.","paragraph_zero_based":45532},{"literal_text_all_w_t_and_m_t":"sl-OptionForCondition2-A-1","paragraph_zero_based":45533},{"literal_text_all_w_t_and_m_t":"Indicates the RSRP threshold used to consider additional criteria for condition 2-A-1. Value 0 corresponds to using the RSRP threshold according to the priorities included in the SCI, UE uses thresholds sl-Thres-RSRP-List, in its resource pool configuration sl-UE-SelectedConfigRP, corresponding to ThresPSSCH-RSRP-List specified in clause 16.3.0 of TS 38.213 [13]. Value 1 corresponds to using a (pre)configured RSRP threshold delta value sl-DeltaRSRP-Thresh, corresponding to deltaRSRPThresh specified in clause 16.3.0 of TS 38.213 [13].","paragraph_zero_based":45534},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-Occasion","paragraph_zero_based":45535},{"literal_text_all_w_t_and_m_t":"Indicates the reference slot from which a PSFCH occasion for inter-UE coordination information transmission is derived. Value 0 corresponds to the slot where UE-B's SCI is transmitted and value 1 corresponds to the slot where expected/potential resource conflict occurs on PSSCH resource indicated by UE-B's SCI.","paragraph_zero_based":45536},{"literal_text_all_w_t_and_m_t":"sl-RB-SetPSFCH","paragraph_zero_based":45537},{"literal_text_all_w_t_and_m_t":"Indicates the set of PRBs that are actually used for inter-UE coordination information transmission and reception in Scheme 2. The leftmost bit of the bitmap refers to the lowest RB index in the resource pool, and so on.","paragraph_zero_based":45538},{"literal_text_all_w_t_and_m_t":"sl-SlotLevelResourceExclusion","paragraph_zero_based":45539},{"literal_text_all_w_t_and_m_t":"Indicates that physical layer of UE-B reports resources in a slot including the next reserved resource indicated by the corresponding UE-B's SCI to higher layer.","paragraph_zero_based":45540},{"literal_text_all_w_t_and_m_t":"sl-TypeUE-A","paragraph_zero_based":45541},{"literal_text_all_w_t_and_m_t":"Indicates that a non-destination UE of a TB transmitted by UE-B can be UE-A which sends inter-UE coordination information to UE-B, when UE-A is a destination UE of another TB conflicting with the TB transmitted by UE-B.","paragraph_zero_based":45542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45543},{"literal_text_all_w_t_and_m_t":"–SL-LBT-FailureRecoveryConfig","paragraph_zero_based":45544},{"literal_text_all_w_t_and_m_t":"The IE SL-LBT-FailureRecoveryConfig-r18 is used to configure the parameters used for detection and cancellation of sidelink consistent LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":45545},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig information element","paragraph_zero_based":45546},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45547},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LBT-FAILURERECOVERYCONFIG-START","paragraph_zero_based":45548},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45549},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig-r18 ::=    SEQUENCE {","paragraph_zero_based":45550},{"literal_text_all_w_t_and_m_t":"    sl-lbt-FailureInstanceMaxCount-r18      ENUMERATED {n4, n8, n16, n32, n64, n128}                   OPTIONAL,               -- Need M","paragraph_zero_based":45551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c3fff6b2507c938ecebfc0e77d1b242e4ac43e858e7dc1fd0727e6da43502a25","a6279023ca1cf58d696cda8d6ac7d0d09b779a97b3fe97e2947d670676a790a0","fe0050fd98e968b22fd7a4d9c4076337fd3b8fbae8d386543bf06c367eef45ae","dc0cc3be82bb4620f6398a81e938e226e6bcee25b1116388039e32a946f9f257","91d653a284e8e0a8b589f004d6294fd73b1ad2ef10b1adda2d7618d0164be099","eab828380e9ea1ac79c93ac23f9bdf3a3dd526d2b2a6b0ba1e64269296f89ae7","785c072b132f195296f2a86b65b19b710501c4ff747e71af37fcff7ce6dfab13","de9f088396aea0037411540d7de155b39455c825e0c18a234fe47707e343d3bc","166aac1970aee60b5885a3b63079d81761ac1270a0d49050392b3509cdac615d","66ad82497b3aa351d292752f72dc95059b06d4e8347450d61c20c1de693d9d80","b49151f19d8918fca021441c52bd9d9b73f473331814b4e18f20eacebc1e92e4","03f4026335abb9da9e261d4ee015accdd0eefff049e63d0f06e6cd95acb76b25","d953eb8d7490245421c62db89d3fecf90a6295730ad5c414de20cfd53574cbb4","26528d67cbe1ece12de856c95f405caf560c98c44a6229c7c66cc5672ece8d5a","9ac53bb3ffd29197ddc9f5083c4a49909a5582312d13b3082366e4a3c3f235fd","593e2f252c18d733da02f3a272606485e5c624f038eaef0cc90c54a6a67da395","379ceae5b3920b38178559aeebbe47d1f97dcfd912502d7de9e517bded6b07be","655952c0d9f57a3cd5725afd88722ddf37065990239fd35ed2bdcc467e7f4f50","31c2dbde7d90bfb85f16329d286ce4a5b3713fa0488d0baf821ae26ba5ec0e66","df668ffccdf489d28fd11cb6c11963f9c2f79caf722e50e70743dd8faaa8a98f","aa18f2a425a400351f467bdb6a45227fdb6df9e8c0b16ee3e9a4d23c8e2bfc16","a1649dc136d6ec75441a2e25fd125393cd3cb690229a7ad105737bddf4de0039","277d0d05c89f67c57e312681ae7191c8fce8f01a8824ef40cc658dd385f7dad9","7163d3574df48caafb93846acdee2233ce8e54538d5e250ce53c8cda0e7ad2bd"],"paragraph_range_zero_based":[45528,45551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p45528"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-lbt-FailureDetectionTimer-r18        ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320}          OPTIONAL,               -- Need M","paragraph_zero_based":45552},{"literal_text_all_w_t_and_m_t":"    sl-LBT-RecoveryTimer-r18                ENUMERATED {ms10, ms20, ms40, ms80, ms160, ms320}          OPTIONAL,               -- Need M","paragraph_zero_based":45553},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45554},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45556},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LBT-FAILURERECOVERYCONFIG-STOP","paragraph_zero_based":45557},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45559},{"literal_text_all_w_t_and_m_t":"SL-LBT-FailureRecoveryConfig field descriptions","paragraph_zero_based":45560},{"literal_text_all_w_t_and_m_t":"sl-lbt-FailureDetectionTimer","paragraph_zero_based":45561},{"literal_text_all_w_t_and_m_t":"Timer for consistent sidelink LBT failure detection (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":45562},{"literal_text_all_w_t_and_m_t":"sl-lbt-FailureInstanceMaxCount","paragraph_zero_based":45563},{"literal_text_all_w_t_and_m_t":"This field determines after how many LBT failure indications received from the physical layer the UE triggers sidelink LBT failure recovery (see TS 38.321 [3]). Value n4 corresponds to 4, value n8 corresponds to 8, and so on.","paragraph_zero_based":45564},{"literal_text_all_w_t_and_m_t":"sl-lbt-RecoveryTimer","paragraph_zero_based":45565},{"literal_text_all_w_t_and_m_t":"Timer for consistent sidelink LBT failure cancellation (see TS 38.321 [3]). Value ms10 corresponds to 10 ms, value ms20 corresponds to 20 ms, and so on.","paragraph_zero_based":45566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45567},{"literal_text_all_w_t_and_m_t":"–SL-LogicalChannelConfig","paragraph_zero_based":45568},{"literal_text_all_w_t_and_m_t":"The IE SL-LogicalChannelConfig is used to configure the sidelink logical channel parameters.","paragraph_zero_based":45569},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig information element","paragraph_zero_based":45570},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45571},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-LOGICALCHANNELCONFIG-START","paragraph_zero_based":45572},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45573},{"literal_text_all_w_t_and_m_t":"SL-LogicalChannelConfig-r16 ::=            SEQUENCE {","paragraph_zero_based":45574},{"literal_text_all_w_t_and_m_t":"    sl-Priority-r16                            INTEGER (1..8),","paragraph_zero_based":45575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["02c1ba98dcda8ab44d7ddace2a2b7cdf98e35a07421354fb6ea0d722ae4fd8da","83efd0ebd33d111184b05be65cba4a337964d92961ba5cf72722be35a4623daf","50e18f4339c310e2855dd5546a180ca7fdac4457ec75dcad47831199c9a5ceb8","55d8b660ec2ac895a4ef37b135d9b5ef326aa7733fbd145f0e250cb087fff8d8","cb3d450937c7658556b84cb533bab4a61ec2aa1b119480cd5b839fb827881d1c","3235d2c12de16364996b341f834fdae916977871ff05c743cb97f405804a77ed","d1b71ecb2e80b2f53f1f8554575b4ff889d8160af18d810cdda75e2ca1dc11bc","2530e5040e3bc66e769443910cc4afdc846a11acf0065718ef5971221a5be5f6","3844a7c481456cd94947a12750ab3082d7807149286568fb50ca0e2d3dc74f86","64492b5733d3322c7868c79b27a2