_based":44316},{"literal_text_all_w_t_and_m_t":"    sl-TransmissionStructureForPSCCHandPSSCH-r18 ENUMERATED {contigousRB, interlaceRB}                     OPTIONAL,  -- Need M","paragraph_zero_based":44317},{"literal_text_all_w_t_and_m_t":"    sl-GapOfAdditionalSSSB-Occasion-r18  INTEGER (0..639)                                                  OPTIONAL,  -- Need M","paragraph_zero_based":44318},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-NonAnchorList-r18 SEQUENCE (SIZE (1.. maxSL-NonAnchorRBsets)) OF ARFCN-ValueNR OPTIONAL,  -- Need M","paragraph_zero_based":44319},{"literal_text_all_w_t_and_m_t":"    sl-NumOfSSS-Brepetition-r18          SEQUENCE (SIZE (1..5)) OF INTEGER (2..9)                          OPTIONAL,  -- Need M","paragraph_zero_based":44320},{"literal_text_all_w_t_and_m_t":"    sl-CPE-StartingPositionS-SSB-r18     INTEGER (1..9)                                                    OPTIONAL,  -- Need M","paragraph_zero_based":44321},{"literal_text_all_w_t_and_m_t":"    sl-CWS-ForPsschWithoutHarqAck-r18    ENUMERATED {t1, t8, t16, t32, infinity}                           OPTIONAL,  -- Need M","paragraph_zero_based":44322},{"literal_text_all_w_t_and_m_t":"    sl-NumOfAdditionalSSSBOccasion-r18   INTEGER (0..4)                                                    OPTIONAL,  -- Need M","paragraph_zero_based":44323},{"literal_text_all_w_t_and_m_t":"    sl-SSSBPowerOffsetOfAnchorRBSet-r18  ENUMERATED {value1, value2}                                       OPTIONAL,  -- Need M","paragraph_zero_based":44324},{"literal_text_all_w_t_and_m_t":"    sl-RBSetConfigList-r18               SEQUENCE (SIZE (1..5)) OF SL-RBSetConfig-r18                      OPTIONAL,  -- Need M","paragraph_zero_based":44325},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigA2X-r18             SetupRelease {SL-BWP-PoolConfig-r16}                              OPTIONAL,  -- Need M","paragraph_zero_based":44326},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PRS-PoolConfig-r18            SetupRelease {SL-BWP-PRS-PoolConfig-r18}                          OPTIONAL   -- Need M","paragraph_zero_based":44327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d7be5c7aa6a32abe8114887a63220202ff2fe79336b95fa8cdd6675d53f5880f","de88f7f26e86a27ed8d8570e38dd403782e3941df6714cfc5071f0350f120c3d","57db28b43c34cb16e76416e70a7fe2938a27e73652e4a9b2c768ac97039a42b4","eb962fb0e5533978bc262e2a421bbc4d38d68c858fd631a39e5c466ad3ff341f","c72725135d2d25e1bd582e93bc7324e3291aa786891583e2e536e32f03d864f6","10bc620c630d982f623c4eda0282911bd31298f7facba4a2af4fe0292647d5f1","42b5594a1fe71d96fb26f6afd7a99cc10cf6807ada4277230e5aade371732462","14871b6c811ff4e48b27e0dac9e81345f99e84229d677279ac4c600ecbb89f17","53717f5fd2697c734331b58f21c67a10e9bf561d52d2e0d5449f9e37587041b9","1d16c8a4faea36ef09ce69fb37971378ae04882ee2fdfff4a83be1c590fd08e3","1e0627c7f6c3821ed0ae89470641eb6e908b7335449f0aa8d75d37291c0f4900","0bd1c9d8fd83538051378bf4df7b851cabdb06fe64d7571b31446175d488b86e","68f7955bbb215522a65d5069f6103f131c35acb13ea512a1c24894c23cb33e72","b7ce04117276cbb56d5c446104e29ccda488cf0eafc99090efccf952eaa588d6","b9414cd556c7c53d90660914c5b9d27fa8c1c1db4551ac18a3aa9a2bbcf94440","7095d89e42a727b51e4557b443166028a85061f117313c8a1819ab6379ac20f6","60b49b7cae6e074fc0053b15456356cf25ca628572c3fe1bf367dbd3dc7054cd","6a214012f83f98877544e42e032b93a2c460c0ba229aaf68f2da8257da059c49","97206ec88a0e08123e1a37089c5bc5ae8fe3170c6d4ea569ff0a381f33e7adcb","01989d66e8c2ac68f5a4fe33b4982dd17708e1040e38ad219529217096bcd029","3c3ac39cc3d6e912bbbc77432650f265787db8a5eb9c21bb584bb0dfe3da8b4e","06cb82bb6ed79e37f9ae90670bd65980a368d95d92126c6119a8c33e53d36e4b","c1266f27e301feb937617491fb26f5e066c057a9c863777137eaea956c7a6c23","e275dabb0b25c7f1039ccf54bc8d71559e6eeaf5273c68ce0580b39bd8ad4f5f"],"paragraph_range_zero_based":[44304,44327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44304"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44328},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44329},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44330},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic-r16 ::=                   SEQUENCE {","paragraph_zero_based":44331},{"literal_text_all_w_t_and_m_t":"    sl-BWP-r16                               BWP                                                                OPTIONAL,    -- Need M","paragraph_zero_based":44332},{"literal_text_all_w_t_and_m_t":"    sl-LengthSymbols-r16                     ENUMERATED {sym7, sym8, sym9, sym10, sym11, sym12, sym13, sym14}   OPTIONAL,    -- Need M","paragraph_zero_based":44333},{"literal_text_all_w_t_and_m_t":"    sl-StartSymbol-r16                       ENUMERATED {sym0, sym1, sym2, sym3, sym4, sym5, sym6, sym7}        OPTIONAL,    -- Need M","paragraph_zero_based":44334},{"literal_text_all_w_t_and_m_t":"    sl-PSBCH-Config-r16                      SetupRelease {SL-PSBCH-Config-r16}                                 OPTIONAL,    -- Need M","paragraph_zero_based":44335},{"literal_text_all_w_t_and_m_t":"    sl-TxDirectCurrentLocation-r16           INTEGER (0..3301)                                                  OPTIONAL,    -- Need M","paragraph_zero_based":44336},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":44337},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44338},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44339},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-STOP","paragraph_zero_based":44340},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44342},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config field descriptions","paragraph_zero_based":44343},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB-NonAnchorList","paragraph_zero_based":44344},{"literal_text_all_w_t_and_m_t":"Indicates the lowest S-SSB in a non-anchor RB set via each parameter in this list. Anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates.","paragraph_zero_based":44345},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfig","paragraph_zero_based":44346},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":44347},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":44348},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":44349},{"literal_text_all_w_t_and_m_t":"sl-BWP-Id","paragraph_zero_based":44350},{"literal_text_all_w_t_and_m_t":"An identifier for this sidelink bandwidth part.","paragraph_zero_based":44351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c8b0b2523f3450ded2e7969a9b7bf3087461920b29cf1829025fb521e00646b4","55815d30038568d26e79b3de0fb9071a1cbd85729b3dc9f1a4a861530226f5cc","74e6ae39f56670b2c2ef07830a8c4e10f3ddc2bc9b023ac8b1728cc9f01cde1b","b172c0404967d43dd28897558f0f093aa925b955ddc53bb9af3831abc9c9d85e","9160eb6923a0a0a4a959f312ace4968f38b193d37ee5103dbaae2f3c38e7b877","837e41ca54d0311766669253993e64e5f762a91b780b31e53350eb34abc0aad5","5aea4878687e21b3f2c8261632c77c522cd747765aee910204b32186c432d0e9","8f6dd6459c4a9c1ff85073fd82a3ecbeec3b9b9ce8ebc8a944544e10dda0a147","2a33bfa7574c88f1088cc98db55743a62b2dcf1ba275ec4aab55ae837d83b259","08a1941a05acc8c4cad89c037e78256bf81bdbf85a45eda3a247b442c807b389","5086d2b9fca79827cffabc5d0ed8396e441399da0da67e4148b54dcc21b3d3cc","8f81dcb5b047621f0721c203d2559fc86446d27e6afd005cb46d56254cb12d07","f68ac9f4d37604095cf6b829b5e4e9ba5033f4297587b6385ef6249cc2c26a0f","2e8223a13481aed15aee4c4f79c663d6d547c4634fa72d75567987dd2e2ccc20","7cdd097dba4a200e4b3b2f92a09185af404eab5c68ef924e53d52c5281ee4f8d","bd6c57975d8eedf70a400470eeadb4534bbdcfc25c217200d20cfd0aea57afaa","12afc161ee7fdfccdf65bc63bbcfc2052aea3bbd88f7e461519abe8b0ca0dba1","1ff43a0285f0be54d1872d243dd8f8d1ce934180f8ef9bee0f45c14141924146","29aa4abe33d6b2c35060332a751d89a952e6e55358b64b9eabb1ed3470d18b09","02f706c9dc9e3f824c3b18c22939cd04680ce76d4d957b3c30aba99e71f0268d","b00ec4d986c6dad2e5877dc0537845c00b65004f75af3dff67fbe6066debc396","f0ae15c9b8f0478cc5a702ff53f874fe508495eea353dc91446ee9b6947c989e","8f90fb858bc340a06fa8d1dd2530fde2a5f9d9ec0707e3a5c0c7fe303d4b603f","ef79bf83de8b9f47d3baee2bd947ea60b2c9cf13c9587d94efd87fb7ab84ae4a"],"paragraph_range_zero_based":[44328,44351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44328"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfig","paragraph_zero_based":44352},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":44353},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigA2X","paragraph_zero_based":44354},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP. This field does not include sl-TxPoolScheduling.","paragraph_zero_based":44355},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigPS","paragraph_zero_based":44356},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":44357},{"literal_text_all_w_t_and_m_t":"sl-BWP-PRS-PoolConfig","paragraph_zero_based":44358},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink PRS dedicated resource pool configurations for SL-PRS on the configured sidelink BWP. This field does not include sl-PRS-TxPoolExceptional.","paragraph_zero_based":44359},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionS-SSB","paragraph_zero_based":44360},{"literal_text_all_w_t_and_m_t":"Indicates the CPE starting position within the GP symbol before S-SSB transmission. The value is an index of the set of all candidate CPE starting positions specified in Table 5.3.1-3 of [16, TS 38.211] for Ci=1 and the corresponding SCS of the SL BWP.","paragraph_zero_based":44361},{"literal_text_all_w_t_and_m_t":"sl-CWS-ForPsschWithoutHarqAck","paragraph_zero_based":44362},{"literal_text_all_w_t_and_m_t":"The latest CW_p is autonomously increased to the next higher allowed value for every priority class p of {1,2,3,4} if the same CW_p which is different from CW_(max,p) is consecutively used for general of N_init in SL Type 1 LBT for a number of times indicated by this parameter. This operation is restricted only to PSCCH/PSSCH transmission(s) with \"HARQ feedback enabled/disabled indicator\" in the 2nd stage SCI set to disabled, regardless of whether PSFCH resources being configured in a resource pool.","paragraph_zero_based":44363},{"literal_text_all_w_t_and_m_t":"sl-GapOfAdditionalSSSB-Occasion","paragraph_zero_based":44364},{"literal_text_all_w_t_and_m_t":"Indicate the gap between each R16/R17 NR SL S-SSB slot and its first corresponding additional candidate S-SSB occasion, and the gap between adjacent two additional candidate S-SSB occasions corresponding to a R16/R17 NR SL S-SSB slot.","paragraph_zero_based":44365},{"literal_text_all_w_t_and_m_t":"sl-LBT-FailureRecoveryConfig","paragraph_zero_based":44366},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection and cancellation of sidelink consistent LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":44367},{"literal_text_all_w_t_and_m_t":"sl-NumOfAdditionalSSSBOccasion","paragraph_zero_based":44368},{"literal_text_all_w_t_and_m_t":"Indicate the number of additional candidate S-SSB occasion(s) for each R16/R17 NR SL S-SSB slot.","paragraph_zero_based":44369},{"literal_text_all_w_t_and_m_t":"sl-NumOfSSS-Brepetition","paragraph_zero_based":44370},{"literal_text_all_w_t_and_m_t":"Indicate the number of S-SSB repetitions in frequency domain in one RB set, where first value corresponds to first RB set, second value corresponds to second RB set and so on. Legacy S-SSB are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":44371},{"literal_text_all_w_t_and_m_t":"sl-SSSBPowerOffsetOfAnchorRBSet","paragraph_zero_based":44372},{"literal_text_all_w_t_and_m_t":"Indicate the power offset for one S-SSB transmission on anchor RB set, where anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates. Value value1 corresponds to the power offset of 10lg(N), where N is the number of S-SSB repetitions within the anchor RB set, and value2 corresponds to the power offset of 10leg(W), where W is the maximum total number of S-SSB repetitions on RB sets within the SL-BWP.","paragraph_zero_based":44373},{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolFirst","paragraph_zero_based":44374},{"literal_text_all_w_t_and_m_t":"Indicates the location of first starting symbol within a slot. Value sym0 corresponds to first symbol, value sym1 corresponds to the second symbol and so on. If the field is not configured, the UE shall use value sym0.","paragraph_zero_based":44375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["35a70d46b77d311f6aaa9ab804ff7ac7c4a3f1368783bb229c9f03b10fa7e4a7","a3131a9aa63928481c74c9c8ed7f36e6163565f99e93f2811f6abbc8ae0d8fd2","22676548ca68594e84f453c2e397b1796f1936a3c535aea3b5cac907275ef866","47a0239f7c8f1398fb9f384a99348e578a35edf1d397e158fb12c9fd76a8fc5b","54eb48f33cac51f7b93d883702b8c169c8c9ea8566b783c976dbe9c58362b1eb","fcb2fc98d8620f3e143071928693e2603a54efdbf5a784cb13fc8eefc2afc037","f8ed3e17d3acdbb9d7cd2d2d59d92bdd228ce90557983ef9399845ed52e9f29c","0a65aef445f1f371f2d3c68e7bef2ce3240ed3e0583d85977b29a31d316d52bf","6198bc62ff26ae9a92403e1a2cd1f9f17120dc2003018c9053d6df4021bb6b26","5e3aff7f8eedb3765dd054c5ba8f792c3e80b103a5ec059e4270f180bc2f2c1a","5c37a77cd7d9bc7a2b3859e1b83ea1b4ea837df0b81910e4856bfe95e447f8f6","ef2b7bf00cf48a8878d4a4505cf165ea1753216d173150ae8a3a4d57cd45d82e","768d751f6a6364e7bde91128a98b434be50b26cd9882315e1a3fdca9e4652c99","6a5de9974268e94c5c28cc108ece07be832421f5525dcbd47f6c8c002c1bb62d","fcf1deb98f7b164a38bd622f10baf88ff7b91ba73bb9134da0942a8b5bef1a6b","a80847092a1b412543046b81dbc3606b69b0b6f522d415a88f65bd90318e7dc6","5cc726f395166421688132d3c46cfeb8bd013a9a59d74f05fc7a177c480d2c13","a8846b7170c61015b718fc7d3f8991a58a9d01be507729342cd39f0919ceb014","226623085b9d6a986bc532064c2bd4a9f9ec9fcbd1848df51e02ed6f00c2210c","143e907ca8a07fb8b31088d9e5ab1d94b957765880dd26253ea1d7fb4970dba5","e8c9a562a02848a44ab75f74b8fb88ecb68e4167fab29343a85c912df5ea946e","656f11531c7130898f7e2fad8513044c8a6fe8f87541ec0535c43259d016a80e","4412092b5545d002b56eae669de87e90ff7cd4132fe5f5ac595165f2a2740a3f","2ad779bcc3355f8669c40913000973d26f791752a2567fa4c527debf01cb9eba"],"paragraph_range_zero_based":[44352,44375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44352"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolSecond","paragraph_zero_based":44376},{"literal_text_all_w_t_and_m_t":"Indicates the location of second starting symbol within a slot. Value sym3 corresponds to fourth symbol, value sym4 corresponds to the fifth symbol and so on.","paragraph_zero_based":44377},{"literal_text_all_w_t_and_m_t":"The number of symbols used for PSCCH/PSSCH transmission from second starting symbol is not smaller than 6. Within a slot, the second starting symbol is later than the first starting symbol. PSCCH/PSSCH transmission starting from first or second starting symbol shall have the same ending symbol within a slot.","paragraph_zero_based":44378},{"literal_text_all_w_t_and_m_t":"sl-TransmissionStructureForPSCCHandPSSCH","paragraph_zero_based":44379},{"literal_text_all_w_t_and_m_t":"Indicate a SL-BWP is (pre-)configured with contiguous RB-based or interlace RB-based PSCCH/PSSCH transmission. Legacy PSCCH/PSSCH are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":44380},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44381},{"literal_text_all_w_t_and_m_t":"SL-BWP-Generic field descriptions","paragraph_zero_based":44382},{"literal_text_all_w_t_and_m_t":"sl-LengthSymbols","paragraph_zero_based":44383},{"literal_text_all_w_t_and_m_t":"This field indicates the number of symbols used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":44384},{"literal_text_all_w_t_and_m_t":"sl-StartSymbol","paragraph_zero_based":44385},{"literal_text_all_w_t_and_m_t":"This field indicates the starting symbol used for sidelink in a slot without S-SSB. A single value can be (pre)configured per sidelink bandwidth part.","paragraph_zero_based":44386},{"literal_text_all_w_t_and_m_t":"sl-TxDirectCurrentLocation","paragraph_zero_based":44387},{"literal_text_all_w_t_and_m_t":"The sidelink Tx/Rx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding sidelink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":44388},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44389},{"literal_text_all_w_t_and_m_t":"–SL-BWP-ConfigCommon","paragraph_zero_based":44390},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-ConfigCommon is used to configure the cell-specific configuration information on one particular sidelink bandwidth part.","paragraph_zero_based":44391},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon information element","paragraph_zero_based":44392},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44393},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-START","paragraph_zero_based":44394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44395},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon-r16 ::=              SEQUENCE {","paragraph_zero_based":44396},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                            OPTIONAL,    -- Need R","paragraph_zero_based":44397},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommon-r16              SL-BWP-PoolConfigCommon-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":44398},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":44399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314