47e043b5f66981a7fce8fdc2b7294d8f2d1a609","f9cdbe4ed9a03df09dd575c74d27c519187a75d5569991b46c297d5a53b65770","2bf5dcb9c9effbbe03efe7d1c10c787b2e80a20d6206d9b98782c2b4638da161","5e829c3e8237682e4da22cdc6efd5b38ca7a3633ffe8379f8b34d275f362a9ec","8cf6cd7d897bb50e9c66f04c2332942b03d2d53ad16933772ae81b6c7cc00925","973d82887759c5fc7de483c489c5593348861b6b4562c5607eeb9587d770383c","d26489f739add54abb299252e7f1a11a6559b3ef2addaf22901999680bedb915"],"paragraph_range_zero_based":[29352,29375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p29352"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f1","paragraph_zero_based":29376},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 1 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29377},{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f2","paragraph_zero_based":29378},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 2 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29379},{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f3","paragraph_zero_based":29380},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 3 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29381},{"literal_text_all_w_t_and_m_t":"deltaF-PUCCH-f4","paragraph_zero_based":29382},{"literal_text_all_w_t_and_m_t":"deltaF for PUCCH format 4 with 1dB step size (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29383},{"literal_text_all_w_t_and_m_t":"p0-Set","paragraph_zero_based":29384},{"literal_text_all_w_t_and_m_t":"A set with dedicated P0 values for PUCCH, i.e.,  {P01, P02,... } (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29385},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRSs, pathlossReferenceRSs-v1610","paragraph_zero_based":29386},{"literal_text_all_w_t_and_m_t":"A set of Reference Signals (e.g. a CSI-RS config or a SS block) to be used for PUCCH pathloss estimation. Up to maxNrofPUCCH-PathlossReference-RSs may be configured. If the field is not configured, the UE uses the SSB as reference signal (see TS 38.213 [13], clause 7.2). The set includes Reference Signals indicated in pathlossReferenceRSs (without suffix) and in pathlossReferenceRSs-v1610. The UE maintains pathlossReferenceRSs and pathlossReferenceRSs-v1610 separately: Receiving pathlossReferenceRSs-v1610 set to release releases only the entries that were configured by pathlossReferenceRSs-v1610, and receiving pathlossReferenceRSs-v1610 set to setup replaces only the entries that were configured by pathlossReferenceRSs-v1610 with the newly signalled entries.","paragraph_zero_based":29387},{"literal_text_all_w_t_and_m_t":"twoPUCCH-PC-AdjustmentStates","paragraph_zero_based":29388},{"literal_text_all_w_t_and_m_t":"Number of PUCCH power control adjustment states maintained by the UE (i.e., g(i)). If the field is present (n2) the UE maintains two power control states (i.e., g(i,0) and g(i,1)). If the field is absent, it maintains one power control state (i.e., g(i,0)) (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29390},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo","paragraph_zero_based":29391},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo is used to configure the spatial setting for PUCCH transmission and the parameters for PUCCH power control, see TS 38.213, [13], clause 9.2.2.","paragraph_zero_based":29392},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo information element","paragraph_zero_based":29393},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29394},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-START","paragraph_zero_based":29395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29396},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo ::=           SEQUENCE {","paragraph_zero_based":29397},{"literal_text_all_w_t_and_m_t":"    pucch-SpatialRelationInfoId         PUCCH-SpatialRelationInfoId,","paragraph_zero_based":29398},{"literal_text_all_w_t_and_m_t":"    servingCellId                           ServCellIndex                                                    OPTIONAL,   -- Need S","paragraph_zero_based":29399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["46e861181916a5de41e36a772ccd16d89b415c4a3ef0d006332ab4d10cc38b21","ebc91d3c093cef4e10cfe03ab796180bccea81ed2bf5596f084f6011fa787ec7","cb839b4d2ba695cbcda08495220e113c0e539331f6fe871fa549052e016410be","3387193d69426b9a8a46cb315d1a1f15b46b1ae2ffb45bb19f184b938a5aa414","51c8117629d05511fc79b72532214001b1cc85705fa4ed205db6f4cc16e7dc17","c47eeb98e89f11ff69f2de49955056624067d9711aab5b36ca5330ecd6794694","3d1f4bf281d0abba032b4bff7283d8865837c4579710cb746322fdb1f46aef15","74c2d971d5e44ee0e7cd2a607b279f9b5e751a4495160eaca8f59302a9274591","9272eafc34739194ec3d0b275d77274a87efe41b8c8b8889d2f4e845c8e024d4","9d74844a3d49a843c12d6bc8a71a7515c141615183749d662665d0b76cb4350f","c1f26efbcd7f59dc506a0da7d61c10c9925ec262fc7e355069f944a8b23d3f0e","e458e9b529d2fa373b3e385e2ec1b871807774cfaea41eefb7c33a609eafb4f8","e1dc8a9ead55f068c4dae48091b03b618bbff1269504d11a4d290978becbcf7a","0025194f180595197ded4a6b41f32a9032fe04e7d4b88d6c448bf1aefedfcb2b","0bc1d1ad139921f6f4a15392cb9015c9fedafde5d05a2a10a2682755540d1b8e","8dac76583e7187bc839bc99c0005c0ac80a1b00dcff37bd7b2ee1a62c5cad6a9","306d2d6e00de3d0fb80ecd940e77c7b181703aaf1033e69bf73552bb5596fe23","17d189ffa169fce46b4c663e1ffce40bc7d8ada8aad4bd77f67637360da26f64","e1df9361fdb104b0bf5ca2c9d4185716e2903a9ff11e5becc9a7d7cbd2763912","af44aad71e82382db6ac0cd42edad54dc96fc84151e6a9d69ea577f9ba36d774","41d669c458e829eb2066e409bca195c05d3579b6fb6f497cac5e6b37c5cbb6b9","015d5033633cf38ab8048d717a4db76f02e933765c1a181e5fd87a4ba51313b2","e2d72b7f6cc2eb809d539db848192e006c925e3cc29f3dbf52d5c54728dff043","8786e3a5e6e9dc9e21e916a79f5eed847e476936fd7b8763f7d80c0ab02ed737"],"paragraph_range_zero_based":[29376,29399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpreta