{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    chIE1-ConfigurableFeature           ChIE1-ConfigurableFeature       OPTIONAL        -- Need N","paragraph_zero_based":54000},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54001},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54002},{"literal_text_all_w_t_and_m_t":"ChildIE1-WithoutEM-vNx0 ::=     SEQUENCE {","paragraph_zero_based":54003},{"literal_text_all_w_t_and_m_t":"    chIE1-ConfigurableFeature-vNx0      ChIE1-ConfigurableFeature-vNx0  OPTIONAL    -- Cond ConfigF","paragraph_zero_based":54004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54006},{"literal_text_all_w_t_and_m_t":"ChIE1-ConfigurableFeature ::=       CHOICE {","paragraph_zero_based":54007},{"literal_text_all_w_t_and_m_t":"    release                             NULL,","paragraph_zero_based":54008},{"literal_text_all_w_t_and_m_t":"    setup                               SEQUENCE {","paragraph_zero_based":54009},{"literal_text_all_w_t_and_m_t":"        -- Root encoding","paragraph_zero_based":54010},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":54011},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54013},{"literal_text_all_w_t_and_m_t":"ChIE1-ConfigurableFeature-vNx0 ::=  SEQUENCE {","paragraph_zero_based":54014},{"literal_text_all_w_t_and_m_t":"    chIE1-NewField-rN                   INTEGER (0..31)","paragraph_zero_based":54015},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54017},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":54018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54019},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":54020},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":54021},{"literal_text_all_w_t_and_m_t":"ConfigF","paragraph_zero_based":54022},{"literal_text_all_w_t_and_m_t":"The field is optional present, need R, in case of chIE1-ConfigurableFeature is included and set to \"setup\"; otherwise the field is absent and the UE shall delete any existing value for this field.","paragraph_zero_based":54023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["41ab7fa5f810503776c00439c6bf0bcf56b4bb22f181012c5f41d14862959d0b","fb9835e62660522d6407ae0e7065e664a24dfe9cf58873fdc4957ca05c236071","498af1be9d3b80e359b12fe9f64cc2f9d363297583c53632c1f51b038bca6066","4a9a2985c03583445c2f41f235b45b94157fb4ecac953d2ded0acc6ebdac305a","050c15e63ca858b484b8e38bc4efcbc11a60a8705b0f454ab31fe88543c12ac2","3040205854b91cfa0382bb3e06419d290a50f5cbe88e84c12790bdb9554e1a08","bf8bc3872bcac5577bc543e0dc7182b19e4de7aec43e0d98b2df787b17ecd703","2f58d0f685163eb94ef2cf44b30053986e6ea0ceff459267ae74bc2b7ae94ae6","07c0ff54a6fc58a389295b455c3ce0a416e2fb3965ee728c0c48b1f721c1eebd","196f749f6368c028a1b07852428872735849b72d985990c7ad319ea5b68ca107","337467ce959460dced93e65fcb0379a1cce6479c675cbfdf0fd80686f119b623","a08f4f9b3e6049f9d52d930e8d0314364f75b369e4ed4a4c78137f7aed465b79","237fa6dd841674d9476d0cb51e3313cb59902a19ec4e47cb20ca4734e20c3b47","8ced2661d50b5da7cfc1dd42974496e3e2b6975a135cb16d50e578527bacd075","b5b6c43dcd07a6f0d1a175716963413481561b07b4335c48d9907a40d80acaf6","bec15477f403145bbe5ff926c6199f7588709a1ba52738da4bad1bf2d7895856","a57ccbcc6ed352fec6097c1a1ce9321b7bcb0481ee25c4090b8a0ce990ac5368","9f268d96f1c92016e5158be1d3c39a5426ea86