{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicatedSL-PRS-RP-r18 ::= SEQUENCE {","paragraph_zero_based":46320},{"literal_text_all_w_t_and_m_t":"    sl-ConfigIndexCG-r18                               SL-ConfigIndexCG-r16,","paragraph_zero_based":46321},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG-r18                                    SL-PeriodCG-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":46322},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePoolID-r18                              SL-ResourcePoolID-r16                                       OPTIONAL, -- Need M","paragraph_zero_based":46323},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrantDedicated-SL-PRS-RP-r18 SEQUENCE {","paragraph_zero_based":46324},{"literal_text_all_w_t_and_m_t":"        sl-TimeOffsetCG-Type1-r18                          INTEGER (0..7999)                                       OPTIONAL, -- Need R","paragraph_zero_based":46325},{"literal_text_all_w_t_and_m_t":"        sl-TimeReferenceSFN-Type1-r18                      ENUMERATED {sfn512}                                     OPTIONAL, -- Need S","paragraph_zero_based":46326},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r18                        INTEGER (0..496)                                        OPTIONAL, -- Need M","paragraph_zero_based":46327},{"literal_text_all_w_t_and_m_t":"        sl-PRS-ResourceIndicationFirstType1-r18            INTEGER(0..11)                                          OPTIONAL, -- Need M","paragraph_zero_based":46328},{"literal_text_all_w_t_and_m_t":"        sl-PRS-ResourceIndicationFutureType1-r18           INTEGER(0..143)                                         OPTIONAL  -- Need M","paragraph_zero_based":46329},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":46330},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46332},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIGDEDICATEDSL-PRS-RP-STOP","paragraph_zero_based":46333},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46335},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfigDedicated-SL-PRS-RP field descriptions","paragraph_zero_based":46336},{"literal_text_all_w_t_and_m_t":"sl-ConfigIndexCG","paragraph_zero_based":46337},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant. The field value should not be duplicated with sl-ConfigIndexCG in IE SL-ConfiguredGrantConfig.","paragraph_zero_based":46338},{"literal_text_all_w_t_and_m_t":"sl-PeriodCG","paragraph_zero_based":46339},{"literal_text_all_w_t_and_m_t":"This field indicates the period of SL PRS configured grant in a dedicated resources in ms for either CG type 1 or CG type 2.","paragraph_zero_based":46340},{"literal_text_all_w_t_and_m_t":"sl-ResourcePoolID","paragraph_zero_based":46341},{"literal_text_all_w_t_and_m_t":"Indicates the resource pool in which the configured sidelink grant Type 1 is applied. The field value should not be duplicated with sl-ResourcePoolID in IE SL-ConfiguredGrantConfig.","paragraph_zero_based":46342},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetCG-Type1","paragraph_zero_based":46343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["153861da5d935a50429c7086eeb4c73c7320ae49e94fd18758cf8a3cfb6ee84b","9a2c3b1408bdbdb7a5ca8b6b8faee6550756e2b8