{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43440},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-START","paragraph_zero_based":43441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43442},{"literal_text_all_w_t_and_m_t":"DedicatedInfoF1c-r17 ::=        OCTET STRING","paragraph_zero_based":43443},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43444},{"literal_text_all_w_t_and_m_t":"-- TAG-DEDICATEDINFOF1C-STOP","paragraph_zero_based":43445},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43446},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43447},{"literal_text_all_w_t_and_m_t":"–EUTRA-AllowedMeasBandwidth","paragraph_zero_based":43448},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-AllowedMeasBandwidth is used to indicate the maximum allowed measurement bandwidth on a carrier frequency as defined by the parameter Transmission Bandwidth Configuration \"NRB\" in TS 36.104 [33]. The values mbw6, mbw15, mbw25, mbw50, mbw75, mbw100 indicate 6, 15, 25, 50, 75 and 100 resource blocks, respectively.","paragraph_zero_based":43449},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth information element","paragraph_zero_based":43450},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43451},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-START","paragraph_zero_based":43452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43453},{"literal_text_all_w_t_and_m_t":"EUTRA-AllowedMeasBandwidth ::=              ENUMERATED {mbw6, mbw15, mbw25, mbw50, mbw75, mbw100}","paragraph_zero_based":43454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43455},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-ALLOWEDMEASBANDWIDTH-STOP","paragraph_zero_based":43456},{"literal_text_all_w_t_and_m_t":"