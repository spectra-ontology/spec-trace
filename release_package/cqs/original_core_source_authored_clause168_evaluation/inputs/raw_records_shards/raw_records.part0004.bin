{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22416},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-START","paragraph_zero_based":22417},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22418},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon ::=        SEQUENCE {","paragraph_zero_based":22419},{"literal_text_all_w_t_and_m_t":"    frequencyInfoDL                 FrequencyInfoDL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":22420},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP              BWP-DownlinkCommon                              OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":22421},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22422},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22423},{"literal_text_all_w_t_and_m_t":"    initialDownlinkBWP-RedCap-r17   BWP-DownlinkCommon                              OPTIONAL    -- Need R","paragraph_zero_based":22424},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22425},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22426},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22427},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22428},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKCONFIGCOMMON-STOP","paragraph_zero_based":22429},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22430},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22431},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon field descriptions","paragraph_zero_based":22432},{"literal_text_all_w_t_and_m_t":"frequencyInfoDL","paragraph_zero_based":22433},{"literal_text_all_w_t_and_m_t":"Basic parameters of a downlink carrier and transmission thereon.","paragraph_zero_based":22434},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP","paragraph_zero_based":22435},{"literal_text_all_w_t_and_m_t":"The initial downlink BWP configuration for a serving cell. The network configures the locationAndBandwidth so that the initial downlink BWP contains the entire CORESET#0 of this serving cell in the frequency domain.","paragraph_zero_based":22436},{"literal_text_all_w_t_and_m_t":"initialDownlinkBWP-RedCap","paragraph_zero_based":22437},{"literal_text_all_w_t_and_m_t":"If present, (e)RedCap UEs use this DL BWP instead of initialDownlinkBWP.","paragraph_zero_based":22438},{"literal_text_all_w_t_and_m_t":"If absent, (e)RedCap UEs use initialDownlinkBWP provided that it does not exceed the (e)RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":22439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d531cc95868ff400c2c326a1860ccd518f45a8f63044514faf840ec6cc9a5c98","213f29bf7bf998b147287ed614cb7418a2f74d3679080655a58e297782d82cdd","653b55f23b7d8fd35bdb9e1908d7993973e60c6cc36faf7b827de3dd8ce68919","a7ae4ce7e5570b456f8e8b5cbed29f36798d0da870c8fcba46053bfed76ea519","2c213e8d5e094a1a2672d45fc20115af79a9eb34f1b77dd19c0a6e226b65dfe8","02f71eded58c73092fe78cbcf3b401de9e59a536f821ed3fe5fe8e18d0029bf5","e4ed73f2301671de73015e88675db1e9a7b18d637c48bb7b7136c49b6f92c99c","f6aef4c6110e0a2936303db85c3269cbf104b2f43de8c7f62f30248911ae8a87","7099663e977168cf1e0a4f9c1b1568305f1fda2f8b5bf1cd9bc80daa6b484696","e3bf0c7843e5539a0a7952f89de2b8777b1b6277f9ca9c77aec08453185e6caa","c79bcb23dd52f59ce7bc6f6463931f8dd5407805f48a1700309d3fe3543cc14b","cef2fd1590bb47c241e5fcfbfb34b6e793d93bfb2eeb409e4413a6497ce4c4e6","bc064f9e2f541ec