 for SL relay_update.docx:p792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if the UE is in RRC_IDLE or in RRC_INACTIVE, or if the UE is in RRC_CONNECTED while T311 is running; and","paragraph_zero_based":816},{"literal_text_all_w_t_and_m_t":"2>if the cellBarredATG in the acquired SIB1 is set to barred or the cellBarredATG is not included in the acquired SIB1:","paragraph_zero_based":817},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":818},{"literal_text_all_w_t_and_m_t":"3>perform cell re-selection to other cells on the same frequency as the barred cell as specified in TS 38.304 [20], upon which the procedure ends;","paragraph_zero_based":819},{"literal_text_all_w_t_and_m_t":"1>if the UE is a RedCap UE and it is in RRC_IDLE or in RRC_INACTIVE, or if the RedCap UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":820},{"literal_text_all_w_t_and_m_t":"2>if intraFreqReselectionRedCap is not present in SIB1:","paragraph_zero_based":821},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":822},{"literal_text_all_w_t_and_m_t":"3>perform barring as if intraFreqReselectionRedCap is set to allowed, upon which the procedure ends;","paragraph_zero_based":823},{"literal_text_all_w_t_and_m_t":"2> else:","paragraph_zero_based":824},{"literal_text_all_w_t_and_m_t":"3>if the cellBarredRedCap1Rx is present in the acquired SIB1 and is set to barred and the UE is equipped with 1 Rx branch; or","paragraph_zero_based":825},{"literal_text_all_w_t_and_m_t":"3>if the cellBarredRedCap2Rx is present in the acquired SIB1 and is set to barred and the UE is equipped with 2 Rx branches; or","paragraph_zero_based":826},{"literal_text_all_w_t_and_m_t":"3>if the halfDuplexRedCapAllowed is not present in the acquired SIB1 and the UE supports only half-duplex FDD operation:","paragraph_zero_based":827},{"literal_text_all_w_t_and_m_t":"4>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":828},{"literal_text_all_w_t_and_m_t":"4>perform barring based on intraFreqReselectionRedCap as specified in TS 38.304 [20], upon which the procedure ends;","paragraph_zero_based":829},{"literal_text_all_w_t_and_m_t":"1>if the UE is a 2Rx XR UE and is in RRC_IDLE or in RRC_INACTIVE, or if the 2Rx XR UE is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":830},{"literal_text_all_w_t_and_m_t":"2>if the cellBarred2RxXR is present in the acquired SIB1:","paragraph_zero_based":831},{"literal_text_all_w_t_and_m_t":"3>consider the cell as barred in accordance with TS 38.304 [20];","paragraph_zero_based":832},{"literal_text_all_w_t_and_m_t":"3>if the intraFreqReselection2RxXR is present in the acquired SIB1:","paragraph_zero_based":833},{"literal_text_all_w_t_and_m_t":"4>perform barring based on intraFreqReselection2RxXR as specified in TS 38.304 [20] upon which the procedure ends;","paragraph_zero_based":834},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":835},{"literal_text_all_w_t_and_m_t":"4>perform barring as if intraFreqReselection2RxXR is set to allowed upon which the procedure ends;","paragraph_zero_based":836},{"literal_text_all_w_t_and_m_t":"1>if the UE supports nes-CellDTX-DRX and it is in RRC_IDLE or in RRC_INACTIVE, or if the UE supporting nes-CellDTX-DRX is in RRC_CONNECTED while T311 is running:","paragraph_zero_based":837},{"literal_text_all_w_t_and_m_t":"2>if cellBarred in the acquired MIB is set to barred:","paragraph_zero_based":838},{"literal_text_all_w_t_and_m_t":"3>if cellBarredNES is absent in the acquired SIB1:","paragraph_zero_based":839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d