{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ServingCellConfig is used to configure UE specific PDCCH parameters applicable across all bandwidth parts of a serving cell.","paragraph_zero_based":27600},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig information element","paragraph_zero_based":27601},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27602},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-SERVINGCELLCONFIG-START","paragraph_zero_based":27603},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27604},{"literal_text_all_w_t_and_m_t":"PDCCH-ServingCellConfig ::=         SEQUENCE {","paragraph_zero_based":27605},{"literal_text_all_w_t_and_m_t":"    slotFormatIndicator                 SetupRelease { SlotFormatIndicator }                                OPTIONAL,   -- Need M","paragraph_zero_based":27606},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":27607},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27608},{"literal_text_all_w_t_and_m_t":"    availabilityIndicator-r16           SetupRelease {AvailabilityIndicator-r16}                            OPTIONAL,   -- Need M","paragraph_zero_based":27609},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-r16          INTEGER (1..80)                                                     OPTIONAL    -- Need R","paragraph_zero_based":27610},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27611},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27612},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-v1710        INTEGER (81..1280)                                                  OPTIONAL    -- Need R","paragraph_zero_based":27613},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27614},{"literal_text_all_w_t_and_