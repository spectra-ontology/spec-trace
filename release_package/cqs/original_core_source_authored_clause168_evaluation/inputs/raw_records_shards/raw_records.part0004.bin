:"","paragraph_zero_based":54573},{"literal_text_all_w_t_and_m_t":"RP-232570: Addition of extended number range for NS value","paragraph_zero_based":54574},{"literal_text_all_w_t_and_m_t":"3900","paragraph_zero_based":54575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["69d3ebf9fc9cc571a667a3e640c6620cfe2be02ad66efa397f26168ac8bb6d36","e33451b65e2fe4c08ed98df244acf9ad3f72ff498a1219f3c3ec816a56b36d24","cfd944b946d87185af194cd7359788ae7ba4091823aeaed5c1692201a08b532b","319503d39d5573aa5f1d21855dc12c2d081b0025d3e1e9fa45be4392bef9521a","6ae8f35b2b265c74e7556d112f77d5904545ddf2b2fede26cc436dcc8716ceb2","36851cea2fc7d1ed47134b1f6a34c07ce65bc4ae70dcd5d067eb7cf79f5101d9","8dc714d27b4cd57112656e6537e75ecfdf05a3a762c77d70e470ee793875b1de","23a5fc0bcd468e68a7abc1b2b3fdd1202b90a02a9fde656d0c9bda5411e6f5e7","ba4a371031281b39a92c1a2770e35b359909099bee914d42e44790c1ed496a34","5475f41dbd3eee77efc5dd293d4209f25268d661d101dc586445b5b06b5328ed","8c1f857dcc4d0c4e2add0666a3e6e062deec9657c2e04880ea3543ebdc384d84","8f43d97b50d675588837dfb601bdd1d2571a79167838d4b211cf507cbe8edf8b","bb64e6f7dd24440f39345cab2bf83dce588b8d1d70862588674bcf722b32a368","7bd2c1489562a580a7b1e8118974c4b41a6f2a9be96d67d969441f5066e22424","383ce8474bbe1eb5f06f3eb7add38ee7ab3f40c8fb2fb28c195f9c7ee0d942f9","b2a3931c6609bf0d5bb80c65a317592ac8a5ebff186556def6a86aa1b99b16ff","2d59ba618c98b1630d3f18cc64f822ab7049ce293eeb59fef22fc432416aad89","c9c543fd13a0a7a9a1cc94e721ebd0b726e6dc938833ac600925e7d95c78bf88","f38330ba3d15c6e59944db9eeb8b7cf50fa7699938d9afe7336bc1c2d2d7e35f","9efce7ace9085ff23e1141377fdbd3323fc47cd75e843f3a4b7901d140f6ec0e","121c792a1c5a58360fb120cfa4662c4aba5c036ba7932d7461c08b963a8965f5","56c894ed7586e0e7d1697f641a8e49d2dab9baf39ac5c2323386c0e834c96804","26dcee626cc8aa97b61f3a6232b6e775602368cf300a573763227f620be3241c","572fb15166688abedb0e2d4f6f1d4897076ad3cc4b1137fbe88ea34912fdfdfa"],"paragraph_range_zero_based":[54552,54575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54552"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6","paragraph_zero_based":54576},{"literal_text_all_w_t_and_m_t":"Release 16","paragraph_zero_based":54577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54578},{"literal_text_all_w_t_and_m_t":"RP-233888: Introduction of FR2 FBG2 CA BW classes","paragraph_zero_based":54579},{"literal_text_all_w_t_and_m_t":"2867","paragraph_zero_based":54580},{"literal_text_all_w_t_and_m_t":"6","paragraph_zero_based":54581},{"literal_text_all_w_t_and_m_t":"Release 15","paragraph_zero_based":54582},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54583},{"literal_text_all_w_t_and_m_t":"RP-233882: Enhancing SCell A2 event reporting","paragraph_zero_based":54584},{"literal_text_all_w_t_and_m_t":"4375","paragraph_zero_based":54585},{"literal_text_all_w_t_and_m_t":"2","paragraph_zero_based":54586},{"literal_text_all_w_t_and_m_t":"Release 15","paragraph_zero_based":54587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54588},{"literal_text_all_w_t_and_m_t":"RP-233890: PTM retransmission reception for multicast DRX with HARQ feedback disabled [PTM_ReTx_Mcast_HARQ_Disb]","paragraph_zero_based":54589},{"literal_text_all_w_t_and_m_t":"4504","paragraph_zero_based":54590},{"literal_text_all_w_t_and_m_t":"-","paragraph_zero_based":54591},{"literal_text_all_w_t_and_m_t":"Release 17","paragraph_zero_based":54592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54595},{"literal_text_all_w_t_and_m_t":"Annex D (normative):UE requirements on ASN.1 comprehension","paragraph_zero_based":54596},{"literal_text_all_w_t_and_m_t":"This clause specifies UE requirements regarding the ASN.1 transfer syntax support, i.e. the ASN.1 definitions to be comprehended by the UE.","paragraph_zero_based":54597},{"literal_text_all_w_t_and_m_t":"A UE that indicates release X in field accessStratumRelease shall comprehend the entire transfer syntax (ASN.1) of release X, in particular at least the first version upon ASN.1 freeze. The UE is however not required to support dedicated signalling related transfer syntax associated with optional features it does not support.","paragraph_zero_based":54598},{"literal_text_all_w_t_and_m_t":"In case a UE that indicates release X in field accessStratumRelease supports a feature specified in release Y, which is later than release X, (i.e. early UE implementation) additional requirements apply. The UE obviously also has to support the ASN.1 parts related to indicating support of the feature (in UE capabilities).","paragraph_zero_based":54599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["87c736cf50be51256e0b99d7d9113f2c8945c6a658de8b4cb5fdf3479db29699","632f3f12dbddb76e43d9146f3aaf34fae3040548a13556c5b47656a0e4ce9fdc","19667cf68bb9919e6067c91f843cfd9da5a9ec6b75b7f664b99a13790c35c4f7","2c4dd799eb86555c06da86d30043ffc1e5228b4a30dd675ce35b1654686f475b","d0810d1648cd9ccd61776bf16557e8f1ca138c310abede0015bcf5cedc8f48d8","5fa6e6133c7c2a69928ba3eec4d761a7e75dfdf3961e5c6206008e0e501251f0","4f58be997723b637127e6fe5af099a0435516508270a943747499a21fcf34f8f","e912b88dc266711f657e0bef6736632024ad69a43f08f168b792be2d757e6c57","344bbe474f4c10bb9026a2308fcfd2d41ff28057cc65746bc6cabe68ad307e24","1762b335e0d1babea5291301c09a3d084814a6ce3dae378a885308a8a7a0d0d3","f4fc32fa8f191cf80033e1704bf897d9bf41cfdd7fce51f9697d194110c16d97","233651b946e43e7d7629a762a89883510c90c52c1af1635bd061e5974abacd3f","6fde474040a83223e1ed95fd1202b66080432fc60b4919914020691b6b868390","37e50472d47487c40852704355b95f356b875eb0dd9ee387aab6dc6ee5ec6fd8","278d5ac2b563dd52c8fc4202551814e851a4614483bbdcfcdef9e219134c4027","da3538e175df7ac6cf0a80bbbdbf5b0f438b60a26268d7121ddd6f8ae55defa5","e91d0464e3b8640e4fe7d92d96ec511c02b78775a67c2109f46bb3b887a667d6","491ee957fbf89fa0ce23c82eff1402a8fa24c89c511cbd7b6084029dfa24a48e","addf9d3ecd2ebe33da4afe8d029b685a418d2a2ae85e70e502581dd73f5f87ec","745286da25ad397c3a5cfef1690d337ed17ee24c5f7049602deface05bea3489","c85a718eaf1516a5469345ec372856404700ca7141181e00bfd69139c83f8c2a","ecf23b89a51bff47db64990efb1542f7265b993f15ce2db8e2a9f1842cad4e27","58a99821e443e2324c45dd90c5d7f608e0f32b3abf8d107f714f5d3ed79abf74","138ad20f752ca5bab7a16c91086014273957903d4603d6e279e321653195559c"],"paragraph_range_zero_based":[54576,54599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54576"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Critical extensions (dedicated signaling)","paragraph_zero_based":54600},{"literal_text_all_w_t_and_m_t":"If the early implemented feature involves one or more critical extensions in dedicated signalling, the UE shall comprehend the parts of the transfer syntax (ASN.1) of release Y that are related to the feature implemented early. This, in particular, concerns the ASN.1 parts related to configuration of the feature.","paragraph_zero_based":54601},{"literal_text_all_w_t_and_m_t":"If configuration of an early implemented feature introduced in release Y involves a message or field that has been critically extended, the UE shall support configuration of all features supported by the UE that are associated with sub-fields of this critical extension. Apart from the early implemented feature(s), the UE needs, however, not to support functionality beyond what is defined in the release the UE indicates in access stratum release.","paragraph_zero_based":54602},{"literal_text_all_w_t_and_m_t":"Let's consider the example of a UE indicating value X in field accessStratumRelease that supports the features A1, A3, and A5, associated with fields fieldA1, fieldA3 and fieldA5 of InformationElementA (see ASN.1 below).","paragraph_zero_based":54603},{"literal_text_all_w_t_and_m_t":"The feature A5 implemented early is associated with fieldA5, and can only be configured by the –rY version of InformationElementA. In such case, the UE should support configuration of all the features A1, A3 and A5 associated with fields fieldA1, fieldA3 and fieldA5 by the –rY version of InformationElementA.","paragraph_zero_based":54604},{"literal_text_all_w_t_and_m_t":"If, however, one of the features was modified, e.g. the feature A3 associated with fieldA3, the network should assume the UE only supports the feature A3 according to the release it indicated in field accessStratumRelease (i.e. X).","paragraph_zero_based":54605},{"literal_text_all_w_t_and_m_t":"The UE is neither required to support the additional code-point (n80-vY0) nor the additional sub-field (fieldA3c-rY).","paragraph_zero_based":54606},{"literal_text_all_w_t_and_m_t":"InformationElementA-rX ::=      SEQUENCE {","paragraph_zero_based":54607},{"literal_text_all_w_t_and_m_t":"fieldA1-rX                      InformationElementA1-rX                 OPTIONAL,   -- Need N","paragraph_zero_based":54608},{"literal_text_all_w_t_and_m_t":"    fieldA2-rX                      InformationElementA2-rX                 OPTIONAL,   -- Need R","paragraph_zero_based":54609},{"literal_text_all_w_t_and_m_t":"    fieldA3-rX                      InformationElementA3-rX                 OPTIONAL    -- Need R","paragraph_zero_based":54610},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54611},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54612},{"literal_text_all_w_t_and_m_t":"InformationElementA-rY ::=      SEQUENCE {","paragraph_zero_based":54613},{"literal_text_all_w_t_and_m_t":"    fieldA1-rY                      InformationElementA1-rX                 OPTIONAL,   -- Need N","paragraph_zero_based":54614},{"literal_text_all_w_t_and_m_t":"    fieldA2-rY                      InformationElementA2-rX                 OPTIONAL,   -- Need R","paragraph_zero_based":54615},{"literal_text_all_w_t_and_m_t":"    fieldA3-rY                      InformationElementA3-rY                 OPTIONAL,   -- Need R","paragraph_zero_based":54616},{"literal_text_all_w_t_and_m_t":"    fieldA4-rY                      InformationElementA4-rY                 OPTIONAL,   -- Need R","paragraph_zero_based":54617},{"literal_text_all_w_t_and_m_t":"    fieldA5-rY                      InformationElementA5-rY                 OPTIONAL    -- Need R","paragraph_zero_based":54618},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54619},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54620},{"literal_text_all_w_t_and_m_t":"InformationElementA3-rX ::= SEQUENCE {","paragraph_zero_based":54621},{"literal_text_all_w_t_and_m_t":"    fieldA3a-rX                     InformationElementA3a-rX                OPTIONAL,   -- Need N","paragraph_zero_based":54622},{"literal_text_all_w_t_and_m_t":"    fieldA3b-rX                     ENUMERATED {n10, n20, n40}              OPTIONAL    -- Need R","paragraph_zero_based":54623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ba194321f00a160a3da44a33b624435ce1781cf9f19345c695a95abd8a9431b1","c42f2bed86f6182e83028e8386b9e39f58d8340bf22a91b74686c505b912de0a","6c7876c2f6adc5f2173b98aab79fbb8251382a57ca7a5362f3074cfa8c58caa8","56fce16ab8737a05a08b585e47b17d752efcb3cc40773e8c17fe1d717ee6e5e4","2d6a773f3d674eb9e5e791deb4c266cd153c1a2a2786c4d79eed4f4c29bf055d","7cde413ddf22b826d8b2de3310b45d89aa827d85c777e343c658002e5630b3a4","e4f7ab402178427fb70b87672fb42d702f00a112ed99236d5d3a4d68c44da77c","487f98c5fafe00dd8153bd9bfb64f9a70ff351d5fd9ca81b8f48d298ec85cbbf","6d2a6d96b76b3c41942fdce2aafae908f309d4030398877b9180d58469ac2eb6","fbf1ef55448897adcd942bc6a41936469de971b88dc6103efc683c8b28a42b38","4ae7add0ec1ddb1f1f3dcc3de1b6c5977ef8b81caa2f57023f5b1225ec08e7c8","11899bdd676bc808afe96e99e9c8d3aacddad40f66b637c09f286cf5a17e8c67","9bb0257e6b9581c087e5d17e325859fdbe021e0a7240b5282f90331417841542","65aeb4fb728f8cc5dccc13ef3afc87d8ffe39358d39d5b356d931304e146c58f","3b60259097b1e82c0d90a824494bb4a43cca6b595ea4130f2b1a8afff5150150","b8d3e5715894e0ddadaded5741cdb59fa80b584b9170528027313f9ecfcbe1cf","fa7966bf775ea9c130a79bd70fea8995dedf94ef36ccb92b3322dd1b7302e5d8","84913368881cb399960cfb95d4f4b0cb5dbc67c53e5753e0c77fe34c6cd4115b","2c162d723334773be07c26c57f04b88d5b4392bd5a2ef7b8e4a41a2e8e219d46","6f0c56c98448ba4202f9176852771d2fecca306616c6bae61df1b01942a73426","840a37028d311430fa06d846f43c08656e18046266eeac5e78d353339c98d4be","bf3cc20f211f4693f2c4dd32822d893b17b75f95674b4146be4d9b1354293d2f","fefe982a6d05e7745ee67dcd5ec28b3eb2e34de682065a6a9d892d6a41b2d881","a438e1fc67af714f393ac493141083cdf5fc84d13f919c19c05125f18b216a13"],"paragraph_range_zero_based":[54600,54623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54600"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54625},{"literal_text_all_w_t_and_m_t":"InformationElementA3-rY ::=    SEQUENCE {","paragraph_zero_based":54626},{"literal_text_all_w_t_and_m_t":"    fieldA3a-rY                     InformationElementA3a-rX                OPTIONAL,   -- Need N","paragraph_zero_based":54627},{"literal_text_all_w_t_and_m_t":"    fieldA3b-rY                     ENUMERATED {n10, n20, n40, n80-vY0}     OPTIONAL,   -- Need R","paragraph_zero_based":54628},{"literal_text_all_w_t_and_m_t":"    fieldA3c-rY                     InformationElementA3c-rY                OPTIONAL    -- Need R","paragraph_zero_based":54629},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54631},{"literal_text_all_w_t_and_m_t":"Non-critical extensions (dedicated and broadcast signaling)","paragraph_zero_based":54632},{"literal_text_all_w_t_and_m_t":"If the early implemented feature involves one or more non-critical extensions, the UE shall comprehend the parts of the transfer syntax (ASN.1) of release Y that are related to the feature implemented early.","paragraph_zero_based":54633},{"literal_text_all_w_t_and_m_t":"If the early implemented feature involves one or more non-critical extensions in dedicated signaling, the network does not include extensions introduced after the release X that are not the parts related to the feature which the UE indicates early support of in UE capabilities. The UE shall anyway comprehend the parts of the transfer syntax (ASN.1) which indicate absence of such extensions.","paragraph_zero_based":54634},{"literal_text_all_w_t_and_m_t":"If the early implemented feature involves one or more non-critical extensions in system information, the SIB(s) containing the release Y fields related to the early implemented features may also include other extensions introduced after the release X that are not the parts related to the feature which the UE supports. The UE shall comprehend such intermediate fields (but again is not required to support the functionality associated with these intermediate fields, in case this concerns optional features not supported by the UE).","paragraph_zero_based":54635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54636},{"literal_text_all_w_t_and_m_t":"Annex E (informative):Change history","paragraph_zero_based":54637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54638},{"literal_text_all_w_t_and_m_t":"Change history","paragraph_zero_based":54639},{"literal_text_all_w_t_and_m_t":"Date","paragraph_zero_based":54640},{"literal_text_all_w_t_and_m_t":"Meeting","paragraph_zero_based":54641},{"literal_text_all_w_t_and_m_t":"TDoc","paragraph_zero_based":54642},{"literal_text_all_w_t_and_m_t":"CR","paragraph_zero_based":54643},{"literal_text_all_w_t_and_m_t":"Rev","paragraph_zero_based":54644},{"literal_text_all_w_t_and_m_t":"Cat","paragraph_zero_based":54645},{"literal_text_all_w_t_and_m_t":"Subject/Comment","paragraph_zero_based":54646},{"literal_text_all_w_t_and_m_t":"New version","paragraph_zero_based":54647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a9121a6507a48d703294a4004156b234074fa15054caaad8b58cec8c89e50e1a","a10a2f68fd155057a890d5cd5b70ab6e56407bba8b3adffd3e2855fc7510c6e5","246ee9000c0b689191a4ac6e249100e5c552950dda8f28690efe21c07d22ec72","1f51aaf9befe3d16b4c6005b911d0f103e0503dfb168615811ec74ab40eb0baf","79e6d983d5952f174229467382ad481afbc446a533