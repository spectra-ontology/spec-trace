{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"X","paragraph_zero_based":24},{"literal_text_all_w_t_and_m_t":"Core Network","paragraph_zero_based":25},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28},{"literal_text_all_w_t_and_m_t":"Title:","paragraph_zero_based":29},{"literal_text_all_w_t_and_m_t":"Introduction of barring exemption for eRedCap UEs for emergency calls [eRedCap_EM_Call]","paragraph_zero_based":30},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32},{"literal_text_all_w_t_and_m_t":"Source to WG:","paragraph_zero_based":33},{"literal_text_all_w_t_and_m_t":"Apple, China Telecom, Vodafone, Verizon, TMobile USA, ZTE, Vivo, Ericsson","paragraph_zero_based":34},{"literal_text_all_w_t_and_m_t":"Source to TSG:","paragraph_zero_based":35},{"literal_text_all_w_t_and_m_t":"R2","paragraph_zero_based":36},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38},{"literal_text_all_w_t_and_m_t":"Work item code:","paragraph_zero_based":39},{"literal_text_all_w_t_and_m_t":"TEI18","paragraph_zero_based":40},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":41},{"literal_text_all_w_t_and_m_t":"Date:","paragraph_zero_based":42},{"literal_text_all_w_t_and_m_t":"2024-05-09","paragraph_zero_based":43},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["da417f416206cf5f87eaf7f31352ad301c9ee3520856e12f6dcea32a83931ec5","e6f444e0286cc8f70fa5a14142804bfa8187a5bdf8440c1987994debce1e3210","7496636b09b179b2a5e1b06efcfacd5e8d6800179c7f863d1f65d8f76703fd04","2f3b1ee53129758100419258117645c060ebf1b92958e3c5b893f33b575f00e0","212b1ccfd5416973f2f37c07a91f84acad961f7c7f678651d680830e5b6247f4","a529e2b757a674423c6abcb466240303d27400b2effb090bca5fa9c479d21e79","365cdd719b1234891ac98736315c30f2ea5c7c938e6d973b179d635f636b4989","b80d7f4973be29649ff5495e712788a9f81934e6cd3a2b18a3328c3b481bff8d","06f8b7ecc124aedd6a16d9ba3fea184a67ae6cb8c08753f5026e94496f051ebf","5cde668f4179d88bd3af3220fea84f66cd692fb3ad518dc68af1fbf1769c8257","f379514e95260538894ba1ef39aa96c105d7dbd527dc28443e615d14fe4541f6","08c0e5db7b46c10787ab0f133e53e9f7659f8f01bfd15f8b14af524559d4f314","af29de8257c4d188d343bdb1e12d3d6fe8389c15e5e4a92686d28e44e29312c5","73808dab7f052b737ad090b70cadda6c05726333045e2ea2f47e688450606e4f","1a22e55e0bcb5a7d2cb566fe6567a33afe82f7d8942c677673f5b2f870c833de","d70b9ebb5c68f7962c7b256346d7e89f3a8c6c751b6e1b09c85117482cf1d493","5c74da838a963b206014cd436b2abfe3b3ac5d444a80396a4ebc4cedc55f14d5","1a0d677002a48aa40b58b7e5fdcd7aa315e9ba3492f87c34487d2f6a8bda443d","d3469d8a329e09901e529efa073f871ed173ee0c28e6ffb2a32fabd1b097f352","e5e746f7196b58ed9f660a9862cc385245e389125c7233a8fd10112b11e273af","b582203f2c210cc94b343e406b53b06b9e1869cc0390e6587897741911786b12","909f79870ff345ea4728771cfa553dfb755015d72de51f2654edf7431acfd467","c56f52425e11818267c5906c4a5dec8c1f5f073035f06a0ae4ebf0cd943e5e5f","1264e4ec593e8b5073a45ba20896c8a7edc47df283a44e6f49d1b768fb46a71d"],"paragraph_range_zero_based":[24,47],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p24"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":48},{"literal_text_all_w_t_and_m_t":"Category:","paragraph_zero_based":49},{"literal_text_all_w_t_and_m_t":"B","paragraph_zero_based":50},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51},{"literal_text_all_w_t_and_m_t":"Release:","paragraph_zero_based":52},{"literal_text_all_w_t_and_m_t":"Rel-18","paragraph_zero_based":53},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54},{"literal_text_all_w_t_and_m_t":"Use one of the following categories:F  (correction)A  (mirror corresponding to a change in an earlier release)B  (addition of feature), C  (functional modification of feature)D  (editorial modification)","paragraph_zero_based":55},{"literal_text_all_w_t_and_m_t":"Detailed explanations of the above categories canbe found in 3GPP TR 21.900.","paragraph_zero_based":56},{"literal_text_all_w_t_and_m_t":"Use one of the following releases:Rel-8(Release 8)Rel-9(Release 9)Rel-10(Release 10)Rel-11(Release 11)…Rel-17(Release 17)Rel-18(Release 18)Rel-19(Release 19) Rel-20(Release 20)","paragraph_zero_based":57},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":58},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":59},{"literal_text_all_w_t_and_m_t":"Reason for change:","paragraph_zero_based":60},{"literal_text_all_w_t_and_m_t":"It is not possible for a UE to make an emergency call if the cell is barred. A network may enable the access for eRedCap UEs in a cell, yet bar those UEs based on whether the eRedCap UE uses 1Rx or 2Rx branches. The motivation for this functionality was to introduce control for the network over which device to access due to potential impact on, for example, performance.","paragraph_zero_based":61},{"literal_text_all_w_t_and_m_t":"If the cell enables access for eRedCap UEs but the eRedCap UEs consider this cell as barred based on the 1Rx or 2Rx support or both, it would be beneficial to introduce an exception for those UEs to have access to the cell to make an emergency call or receive emergency information broadcast when possible if the cell enables access for eRedCap UEs.","paragraph_zero_based":62},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":63},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":64},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":65},{"literal_text_all_w_t_and_m_t":"Summary of change:","paragraph_zero_based":66},{"literal_text_all_w_t_and_m_t":"This CR introduces a mechanism to allow eRedCap UEs to have access to the cell to make an emergency call or receive emergency information broadcast, when possible, if the cell enables access for eRedCap UEs but the eRedCap UEs consider this cell as barred based on the 1Rx or 2Rx support .","paragraph_zero_based":67},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":68},{"literal_text_all_w_t_and_m_t":"The following changes are made:","paragraph_zero_based":69},{"literal_text_all_w_t_and_m_t":"Indication in SIB1 on whether a eRedCap UE is allowed to make an emergency call if the cell enables access for eRedCap UEs but it bars eRedCap UEs based on the support of 1Rx or 2Rx branches.","paragraph_zero_based":70},{"literal_text_all_w_t_and_m_t":"Impact analysis","paragraph_zero_based":71}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["d383b19e108033832d241a2d7d23cdc6f9bf358de009ef4b244272ddc4932ddf","ea862fe5caa5520a0faa22f254abab0b47110969f4dc944d226d74c609943ed7","de6b0257e00b196e4a8aa85e1eeb2eaadace8d2e4fbaa8902a2e8d5c88500f48","f27345ab3e9902a54a4ba677a748fb216f9206781ce6ae54cf13410eb1c58ace","aa9f382ebcd54a465136b5ac8dc7e350dc2b1263cc3137173d594f5aa944ce96","3dce1068a888b62266c11873b4ee30526d285e61e75c640942d911d13d1bd868","6ef3db64b9ea12874d63ad8fc981400fbc46d792c33e54cf8285ad36b2d6ace9","a733fee710c70ab68e24604017b8b7a2545a41898c4c50b8e98ddcd2caffbf0e","594a02a517a0d347b0a4f178e75570ba42e93f8763126dac5ef57bef544f9971","cba1e859ff36732f91a2acf0ff5fa9a4f89611c0e825670545fb59305f1389fb","1fe10a8cd0fc4ebb588333906625e6382a876a98d009baef0b86ebcf56fd0883","fe2d135c2c639a64bbc2efc50e5c1818f8f9543e9a0f427a596628bfea2caabc","641356d3f7af9f5b94c87c537d5c5e53b4bccbe02f058e29c13665f32bb601c5","8fa5c9abf31633085b31a0232f5b4c7191eb1a7024d4677c5a717ec9aa2277ed","96caf84141e4c95607dcf8c5a4b03863b7175e6201b7ed6ff0124b4ecce7cb2a","303426962bdca85b33a52763735fb13aad2e8ce71480e133c1ed4436bd2997ef","8a47497dfedd6dd698876223d1fbf6b408c567c388295abcd4cf3286c993db35","bf68ce3702fbc0fa665154b1da8019d514034d704c4d2777cf33313fc9286836","cec1c7e3eb8aba4ddf6faa13f207d500184c1ae872549d9c401cbf513577dd0a","1213d5fc51877e2bea399df5d95a660c0e25985fe6fab68a5c6541f9e4680fc3","1174aa6d5b827b5c98aff5fb0d051576a1b8833142ed244c12719ef36cc07f04","e25847931c1368fa18cecdf0f72427752f47ef18bba20f599478a18d1ab86f47","4909095f88f55d5f4f467c51f7b258a24dc7d817a009b8ce1a2f949f1b3e2c96","d62169b85b99aabc37a17b17c2153f4efc9c2242013c6d0ca49571058c67df25"],"paragraph_range_zero_based":[48,71],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx:p48"}
{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Impacted 5G architecture options:","paragraph_zero_based":72},{"literal_text_all_w_t_and_m_t":"NR-SA","paragraph_zero_based":73},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":74},{"literal_text_all_w_t_and_m_t":"Impacted functionality:","paragraph_zero_based":75},{"literal_text_all_w_t_and_m_t":"Cell selection/reselection in IDLE mode and Emergency call functionality","paragraph_zero_based":76},{"literal_text_all_w_t_and_m_t":"Inter-operability: ","paragraph_zero_based":77},{"literal_text_all_w_t_and_m_t":"If the UE is implemented with the CR while the NW is not, there is no inter-operability issue, as the UE cannot initiate an emergency call in such a case.","paragraph_zero_based":78},{"literal_text_all_w_t_and_m_t":"If the NW is implemented with the CR while the UE is not, there is no inter-operability issue as the UE behaves as legacy device.","paragraph_zero_based":79},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":80},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":81},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":82},{"literal_text_all_w_t_and_m_t":"Consequences if not approved:","paragraph_zero_based":83},{"literal_text_all_w_t_and_m_t":"An eRedCap UE cannot make emergency calls in a cell where access for eRedCap UEs is enabled but eRedCap UEs with 1Rx or 2Rx branches are barred.","paragraph_zero_based":84},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":85},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":86},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":87},{"literal_text_all_w_t_and_m_t":"Clauses affected:","paragraph_zero_based":88},{"literal_text_all_w_t_and_m_t":"6.2.2","paragraph_zero_based":89},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":90},{"literal_text_all_w_t_and_m_