{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable or the group of serving cells as indicated by CellGroupsForSwitch-r16 containing this servingCellId.","paragraph_zero_based":34536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34537},{"literal_text_all_w_t_and_m_t":"–S-NSSAI","paragraph_zero_based":34538},{"literal_text_all_w_t_and_m_t":"The IE S-NSSAI (Single Network Slice Selection Assistance Information) identifies a Network Slice end to end and comprises a slice/service type and a slice differentiator, see TS 23.003 [21].","paragraph_zero_based":34539},{"literal_text_all_w_t_and_m_t":"S-NSSAI information element","paragraph_zero_based":34540},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34541},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-START","paragraph_zero_based":34542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34543},{"literal_text_all_w_t_and_m_t":"S-NSSAI  ::=                        CHOICE{","paragraph_zero_based":34544},{"literal_text_all_w_t_and_m_t":"    sst                                 BIT STRING (SIZE (8)),","paragraph_zero_based":34545},{"literal_text_all_w_t_and_m_t":"    sst-SD                              BIT STRING (SIZE (32))","paragraph_zero_based":34546},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34547},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34548},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-STOP","paragraph_zero_based":34549},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34550},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34551},{"literal_text_all_w_t_and_m_t":"S-NSSAI field descriptions","paragraph_zero_based":34552},{"literal_text_all_w_t_and_m_t":"sst","paragraph_zero_based":34553},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type, see TS 23.003 [21].","paragraph_zero_based":34554},{"literal_text_all_w_t_and_m_t":"sst-SD","paragraph_zero_based":34555},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type and Slice Differentiator, see TS 23.003 [21].","paragraph_zero_based":34556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34557},{"literal_text_all_w_t_and_m_t":"–SpeedStateScaleFactors","paragraph_zero_based":34558},{"literal_text_all_w_t_and_m_t":"The IE SpeedStateScaleFactors concerns factors, to be applied when the UE is in medium or high speed state, used for scaling a mobility control related parameter.","paragraph_zero_based":34559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a3ab03bbf3619de50710abcf26a2a1fcfbf90c5311e77d4a45347aa35491446b","9b73b0e3669c44e05a726c5adf8a244d5f0cf9195750c94aa87ccb0593f541d7","508d90a46dfbb22757e32bddeb91fcf231feaf8fe5f37da24eb48c09766a1bb9","8838581c3e7ba49ed09d93e6878e516547018696f487d14bbc599df3e6734d25","581ed0178f9c48ec58473d828013a7f8da5528810118613bc746abed8e92975e","b8b8253b7df8c1bf015fab394f19fef99dc358b17a3e4324ad7079cc5e93b886","be27f8e96a8b39f5b568beb2feb13d9230e58944a935968d4db0e493d42ad1d8","c6c537db092090a5ffb67b9efe383535e1d9bc241eb12afe20381ac82efa2b1f","3df508077636f925aca3566c76365f2896379dae36bd576c742dbd1a1daa9ca4","817d1d16e25170d934cee9657b2b19c4b902c9f32ae6b9dabefa3da43b8b4d5f","decb5377e6383f03d4a1260b8dc771f4a691beebe6164f30d044d75fad08d3f2","5040b06015a28d8fa5fc4c051969e8c92a85afa3144612c1aff29937cb255658","5fb89d2a4a40b2dd622a687b8bb1521b10f245ca61ee63380fcd0b3078e0a6ce","0fa8e903cd26e22e91a8