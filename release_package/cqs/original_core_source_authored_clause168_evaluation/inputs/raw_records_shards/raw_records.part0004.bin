{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    channelAccessMode-r16               CHOICE {","paragraph_zero_based":33600},{"literal_text_all_w_t_and_m_t":"        dynamic                             NULL,","paragraph_zero_based":33601},{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":33602},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":33603},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16      ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}               OPTIONAL, -- Need R","paragraph_zero_based":33604},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                 HighSpeedConfig-r16                                         OPTIONAL  -- Need R","paragraph_zero_based":33605},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33606},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33607},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":33608},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-v1700    ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25} OPTIONAL,  -- Need R","paragraph_zero_based":33609},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                      OPTIONAL, -- Need R","paragraph_zero_based":33610},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommonSIB-v1700                                 OPTIONAL  -- Need R","paragraph_zero_based":33611},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33612},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33613},{"literal_text_all_w_t_and_m_t":"    enhancedMeasurementLEO-r17          ENUMERATED {true}                                           OPTIONAL  -- Need R","paragraph_zero_based":33614},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33615},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33616},{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17                ENUMERATED {enabled}                                        OPTIONAL  -- Cond SharedSpectrum2","paragraph_zero_based":33617},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33618},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33619},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon-v1760          DownlinkConfigCommonSIB-v1760                               OPTIONAL, -- Need R","paragraph_zero_based":33620},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1760            UplinkConfigCommonSIB-v1760                                 OPTIONAL  -- Need R","paragraph_zero_based":33621},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":33622},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["671ee01f4098657ad54fddb0375638b79c7f1372bf74a0d49003888f712f9ea0","a2cb4d8c6eb51a7beab2a7d1a4a7de262f691e4f91bece7dee6687f64b4a5ed5","e7d3133d70cabbf2d3e02781b8d5900e063755f66cb0e99b6230886c027bc813","6297876f965da2bc1b195e93355ee35e981c584454f978c9f1dcd07e6d2aa7e0","b466c7a43663e286cce1e5593477f61e6fd22cafc8637b7ba73d1b7de2871fd3","bbc8ca3d722bdb23d66db4981097b0a4a54cbf103565d2df60f3017a063c2b47","f6f70f30ac8e220512455a47f16ca28e69f9d44313984f2d71e453437640f71a","126c42b2ed9717475be8f94f6d3a4354c9a6c930bd118b766c4469ab8fefb414","3c8a400ca3c4fec98980aa2f7821647237b43b4d6893896023b1969770e9f7be","78b8e81dc8edae6e4833f1c109f9cb5aa3df57c1196931f443a9d7a16e01e963","12591d39ff60e8b3ecc844421812eb7a03797d6c31f8dcd1d938ddd70c515498","d1f98eb91ca5ec4692763c5f93e1c807f69e084f71c925ffbf3f7e9d98ed2e59","674d1a6d2de6493d7cfb394353d6966a6eb6350ed3d89fc630709a3e23a7817d","fff94d0defcaea676ace86cd8c464ed09f1a68c54d2eb8565c338b5e0a912654","511e93421fac3a3282712213693e830f101858f63014845aa1dfa7f4484d5e0c","46ffc2f0dfe80729fefb6d093b1afb1624cd5e9ac1da988fb6be40d7292563f3","854bfb889a5b468d7ed4dc8ae9ea904ade174ab9c8fd8bc133f92145a6aeff4a","99dd193834c6bcbfe65d06de1636a2203b892119cf4e6daa468df7e2da86301e","68b0d69d4a88f8f821d1300eef6996aad02fed6c5835bd9ff435844670c09176","b904ce4031c2a5a82abff2f088e2ae9035d7fe22789bc071523325b8bc3e1363","c91bef32350c63bd8fb88f1c0b456564b2373e74b6aa48f44ba55e65a857d924","c6d57f1e8202e9c256845195570cf3f27578da0ecacd9ed492bc1f717c031863","dcc216f89679aeb714e725fb84e28a82af848f03ffad5841dfd67ad0df919d8b","39c6b088133724b43407757dd48692c80f153ce2403fc001a97421eff59018be"],"paragraph_range_zero_based":[33600,33623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33600"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33624},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-STOP","paragraph_zero_based":33625},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33627},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB field descriptions","paragraph_zero_based":33628},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":33629},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":33630},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":33631},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":33632},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":33633},{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-v1700 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":33634},{"literal_text_all_w_t_and_m_t":"enhancedMeasurementLEO","paragraph_zero_based":33635},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports the enhanced cell reselection requirements for NTN LEO in RRC_IDLE/RRC_INACTIVE, the UE shall apply the enhanced cell reselection requirements for NTN LEO as specified in TS 38.133 [14], clauses 4.2C.2.3 and 4.2C.2.4.","paragraph_zero_based":33636},{"literal_text_all_w_t_and_m_t":"groupPresence","paragraph_zero_based":33637},{"literal_text_all_w_t_and_m_t":"This field is present when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to the SS/PBCH index 0-7, the second bit corresponds to SS/PBCH block 8-15, and so on. Value 0 in the bitmap indicates that the SSBs according to inOneGroup are absent. Value 1 indicates that the SS/PBCH blocks are transmitted in accordance with inOneGroup.","paragraph_zero_based":33638},{"literal_text_all_w_t_and_m_t":"inOneGroup","paragraph_zero_based":33639},{"literal_text_all_w_t_and_m_t":"When maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1, only the 4 leftmost bits are valid; the UE ignores the 4 rightmost bits. When maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1, all 8 bits are valid. The first/ leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. When maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1, all 8 bit are valid; The first/ leftmost bit corresponds to the first SS/PBCH block index in the group (i.e., to SSB index 0, 8, and so on); the second bit corresponds to the second SS/PBCH block index in the group (i.e., to SSB index 1, 9, and so on), and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted.","paragraph_zero_based":33640},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":33641},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for random access on this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":33642},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":33643},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":33644},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":33645},{"literal_text_all_w_t_and_m_t":"Time domain positions of the transmitted SS-blocks in an SS-burst as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33646},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access in FR1, only inOneGroup is used and the UE interprets this field same as mediumBitmap in ServingCellConfigCommon. The UE assumes that a bit in inOneGroup at position k > NSSBQCL is 0, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1. For operation with shared spectrum channel access in FR2-2, the m-th bit in groupPresence is set to 0 for m > NSSBQCL/8, where NSSBQCL is obtained from MIB as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["beac9598e0a6b65a1abfb1cdf2d44d6cbeb0ab2e529f2d0895c9b29cea1b0010","b09c3a0dee585b7bd5bd1c9dffc22d258672748071fe101771249b78fbb80750","7cc1f590b71d01e64d767c94caab4e37ef074e583b8d3864b92dd08ac247e8a3","0145f868863296f660faa025461df37ee46a2b38d4db5d05b984effafcf59124","4236cbc25dc5510b663d9deb0b68fc68ed119bb11bf46fd177ff8f608d0a1556","f24e400fd509442108edd918a5fcffd62bf01ed7f5da85165c7549e89e1cdfc9","11554815e4639ac72422612cb04469ffe5576f6b436b6afbf00fb23b376202ae","3aace2ceba5e7ec19e9d62d6c4613bd0bbec34e5c7b02e03f2945a54d2eb267e","306577c76145ea76a9d7c4b85f5a00b11ddb378bafb9ebaced62bc32bcce65be","863bc3373872db7afd6a599c40737d5ea51d43647630b53d79a4a5c9f1c0d1b1","54b2082e6cbf3a6e9294b131c666d6cf47dd1c7cb7d0319e12018d8d33c04ca4","e5498e6dfcb109d60f616b4e29123473d0894d70c37d6e680cdbceaa36b4bfec","fcc18aa834bfa383bb36e98dbf2db9856d29e41f69b647eef3fae965206371e2","9a08839a57cb8d6898724d7fcc48511767edcdfe50dab480cd4ece1363481bd3","4cae271885bfa71c85604d223b89da3caedcd77a0a8170325054476fda26dd9a","f006474332525bc0486d1992c1763488f8662f365ac19c445df24108f766fd10","22536fc70fa7ed148038b4f5ec6ad0d85174b6002ff09eca92c7b7510d34659b","399e9482a434086f63ff7276e0ff7186bc42238786735d26a695e65f30d55025","59dbb614d70cce0a81d3655bd5c83b5deb8ac4ce8270dd2f3fb612b55674c2ad","72118fccb2806c746d7b6253bcf1fa56c6dfc2378facfa81e2a144937b774218","27342e5f67652d7b546b70565d89d59ca0fc5ed8c0d18269ea8f3b1a93b47b08","d3ef99c182e28572e8f41a7a552001644f3355033be26e41cb36c611301ae731","3abd3e4e39377e87e707805354e67db9be0ad48b54e4851b79a5a5180af5d4c2","720506bf41bb21d3d9777a7f5ebe288419aeef1d67ceaf17f3fca0818d7854f7"],"paragraph_range_zero_based":[33624,33647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33624"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":33648},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":33649},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33650},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":33651},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":33652},{"literal_text_all_w_t_and_m_t":"FR2-Only","paragraph_zero_based":33653},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for an FR2 carrier frequency. It is absent otherwise and UE releases any configured value.","paragraph_zero_based":33654},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":33655},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":33656},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":33657},{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":33658},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":33659},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":33660},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33661},{"literal_text_all_w_t_and_m_t":"–ShortI-RNTI-Value","paragraph_zero_based":33662},{"literal_text_all_w_t_and_m_t":"The IE ShortI-RNTI-Value is used to identify the suspended UE context of a UE in RRC_INACTIVE using fewer bits compared to I-RNTI-Value.","paragraph_zero_based":33663},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value information element","paragraph_zero_based":33664},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33665},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-START","paragraph_zero_based":33666},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33667},{"literal_text_all_w_t_and_m_t":"ShortI-RNTI-Value ::=   BIT STRING (SIZE(24))","paragraph_zero_based":33668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33669},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTI-RNTI-VALUE-STOP","paragraph_zero_based":33670},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b7ab24f4671685d59beaecc137c3250a543e9155fd86da43ade41b40b48641c1","7040d8b20c56df0436de3c56bd955c50ffb3818c8b118f3eac8b812e6a6a2111","b32ced5bcda39c03d883dfb7e415852831ae909fdfe3e83e0a1ac830eec6b595","ff18ebc2d7079f0100037d73a2d3e54a601f793122806ab9679c5e8b299e3441","db4b0c850d7e7578c7735316731850d84318b1d1012a0d20bb17589f5c071d15","1b7f9405022752d1a3f9f6b35a0897b6fcd7e0fb6fcaa427ea5300a2b6d33c70","f31e00deb8bb84d132a0f9934812135157a308b7554a5fadf95ddb6e86a142a5","6f9d2d7c7f087504e8b75dd62a971b8468642737d956c83e5df5ea79972064e3","b37996ee703b3ef7203d1b8aff67d1478b54e9bcc89f400fa58d6ae0e220f688","d05405ada6a36ff8c4cdf2f9e44a0193314a96b50791e3f424b9e1013f8a3f96","f6a077b7326ce0904d467e40eac1275915280d51330514709a666febf17d317e","5ae80f63627989503d095da3db8bbaee69294c70a5fa5fded6ec4a0f86f5a7a5","b5dac53705abcec9cebdbada42fc268536067cc908cd2393249302525bde7c36","f9b3049eee4e97da07b416acdab8bdd8d7af2644f51dedeb4db5db5119609281","b50f70da71e47627d40eee997124edd9188cc23b40ca78abb1f86a69df08ccf9","39f3df547ee7f29990a39f49dd44e59fee6a7e8a263d98780c29789c6b89d300","586b1fc23f790aac886636676973dd14d05f4312fb89ee1905fb7c3124e2d56a","b0bd07560f22733df94b9f86c4c734a804d99722ea1791ed5d5dae591e008881","b038ae59cae25950873cd90f21d45a83446bfaa5663dad48d7af5276c221df5a","d3b1ac7a1aa7eaeac5c2d6d42d9979c132a4284f71cf58add8c330e90eb96308","fed65cd4ea00302160bb321d2c9b428a467de733b991cc586350a41b06d29ca9","93e5a196ad26c1d032cb30b0739c6796c5b5f6f28460689c33f3dab02bae468c","50ca6ae572f96c0be3473b5f691742c24191d91bf2286e18fc07d4c0b0677177","913d3c224d1513e8259a5fc6f8ba51b631b521e73f7019869d2450ed5e59bdf3"],"paragraph_range_zero_based":[33648,33671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33648"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33672},{"literal_text_all_w_t_and_m_t":"–ShortMAC-I","paragraph_zero_based":33673},{"literal_text_all_w_t_and_m_t":"The IE ShortMAC-I is used to identify and verify the UE at RRC connection re-establishment. The 16 least significant bits of the MAC-I calculated using the AS security configuration of the source PCell, as specified in 5.3.7.4.","paragraph_zero_based":33674},{"literal_text_all_w_t_and_m_t":"ShortMAC-I information element","paragraph_zero_based":33675},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33676},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-START","paragraph_zero_based":33677},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33678},{"literal_text_all_w_t_and_m_t":"ShortMAC-I ::=                      BIT STRING (SIZE (16))","paragraph_zero_based":33679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33680},{"literal_text_all_w_t_and_m_t":"-- TAG-SHORTMAC-I-STOP","paragraph_zero_based":33681},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33683},{"literal_text_all_w_t_and_m_t":"–SINR-Range","paragraph_zero_based":33684},{"literal_text_all_w_t_and_m_t":"The IE SINR-Range specifies the value range used in SINR measurements and thresholds. For measurements, integer value for SINR measurements is according to Table 10.1.16.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 46) / 2 dB.","paragraph_zero_based":33685},{"literal_text_all_w_t_and_m_t":"SINR-Range information element","paragraph_zero_based":33686},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33687},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-START","paragraph_zero_based":33688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33689},{"literal_text_all_w_t_and_m_t":"SINR-Range ::=                      INTEGER(0..127)","paragraph_zero_based":33690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33691},{"literal_text_all_w_t_and_m_t":"-- TAG-SINR-RANGE-STOP","paragraph_zero_based":33692},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33694},{"literal_text_all_w_t_and_m_t":"–SI-RequestConfig","paragraph_zero_based":33695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fea761044c278fd6fb7d394412cc45dc2f59737c958de8d0fc859ee389c8cd45","2be0fac2d45394d0787abc0773f51827123f25a797773b96fc3271e64c9db4f5","8a3d9651f0c7667903515f2133289ac6ba7e4122fb538d1a4aa6dfe025ae8b29","a17182415e5ef0bd089b75a51b0a811d4c370c80513b33540b156ad19fbb27bb","057e3ceea762de8f14a921a8d243e4418e535009cf878661f3af3da8cebd098e","bbf841f714ab9959813ed59a59acc74fcbe36964b91a93d4e300d21ff8a0377b","67e5e56f565632737d4dd5c42c05e1a7e61cfccd9612687e51bb80c23938d2fd","d0af6864851b6303119a2e36f14aee3dff984492b1dde9c9dfeab6c599a181e3","d1718b1e2f637db6a052efa3bce76dd94600077ed65ee8266d451fd8b32be012","8e16b6f0e6b27209d5b35b6fa0a29a26392550eb452e82acc70f068356f3bc6b","0b91a8cc51c4607f70cc1467e56bd8c4668040daa17d45df6171e9599f06beb5","d856e702a093c4800504e4e1d719ba346d2d2e8d5ac77d1226b2942863a7fb3f","fa316303b2e06b75b9d5adfee3215668f51181f378b023af76710c653e365a2b","33fb5c558c1d10e6b66893f3292cf4445bc791fc1149956ad2b678faea3fab8a","08686c63ab4b1cf7470e2e3d778bb47dd955cca401b11a968b4c1985e64dc914","89a38ab352505cce3ed5533e0e78eba0f0b031aa998c185bcd65adb2e82f7579","2f21df267452c6473d0281bbc262c2267d1a4595