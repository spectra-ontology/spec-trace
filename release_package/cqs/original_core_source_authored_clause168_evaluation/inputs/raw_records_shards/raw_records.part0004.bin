{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex information element","paragraph_zero_based":36072},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36073},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-START","paragraph_zero_based":36074},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36075},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetIndex ::=                INTEGER (1..maxBarringInfoSet)","paragraph_zero_based":36076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36077},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETINDEX-STOP","paragraph_zero_based":36078},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36079},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36080},{"literal_text_all_w_t_and_m_t":"–UAC-BarringInfoSetList","paragraph_zero_based":36081},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringInfoSetList provides a list of access control parameter sets. An access category can be configured with access parameters according to one of the sets.","paragraph_zero_based":36082},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList information element","paragraph_zero_based":36083},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36084},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-START","paragraph_zero_based":36085},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36086},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList ::=          SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet","paragraph_zero_based":36087},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36088},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList-v1700 ::= SEQUENCE (SIZE(1..maxBarringInfoSet)) OF UAC-BarringInfoSet-v1700","paragraph_zero_based":36089},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36090},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet ::=              SEQUENCE {","paragraph_zero_based":36091},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactor                   ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40,","paragraph_zero_based":36092},{"literal_text_all_w_t_and_m_t":"                                                    p50, p60, p70, p75, p80, p85, p90, p95},","paragraph_zero_based":36093},{"literal_text_all_w_t_and_m_t":"    uac-BarringTime                     ENUMERATED {s4, s8, s16, s32, s64, s128, s256, s512},","paragraph_zero_based":36094},{"literal_text_all_w_t_and_m_t":"    uac-BarringForAccessIdentity        BIT STRING (SIZE(7))","paragraph_zero_based":36095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ee902153e99e6d2c6de191cf72f8b9c7cdc252e998bd5896bfaa1a79f13ae7c2","f79cd3fa955feb5f8fa3b74e4b3a87f743b1badd62fa31694bd140fdb95f30b8","302425267f20777aa51657ca1b1c8bb1fbd4256d3c04b117c488a3206b67d594","7950342bff8bbe19028fab256e675404b4d3ca64fcdb2eddea6a28d68205d2cc","e0622da47900efc5382c3db9071f78fe1052d88ceb73da61be052faad959eed4","34e3cfa067e658cba282ccf69993d01f54968f1bd9b127363fb3a5baa2e251f4","bb562224451231854bc8e47ae6f2d7f41ec47d256c380602e700ac7c0cd3ce10","ecff9caed98e4ea8ced27a9b336384a5166a8b8b8e8e8cfc9af8cf4fc445d28e","154812102229640b0041d77301944b06528135585d52ab6552d9324c111a462c","599b7d3dc6e088830d62f4f27e72cac447b98ba0884a05ea8ec2defb008062b7","8f8d3456036a86269a58ec747569fc90382b37b2fb86acc8714c75bc18a2c4d9","1dacdecd33aeb4520bf442150c9bdb6f367c11fcf987b0dd6635c303e16639d9","69df5d5e36a9cf917bffc84bd400b94c77839bcd0f2e1455cb12b65664269dfa","797baec1beb47b37fa91dcc7e216bbb62bc5609bceff24afcb6e30c581a26d32","f7322890b9eca78a950596f020e3a2104068843e39d64714bb53ecff3dc7d1d1","5f54efa26a47710600076296b6dabcfc72c5ea5f33122e50fa65285c16110cd9","2d19dd7209857ea6a6ef85ac4e9999c53f2a212156a762be4fb4a32c83843a26","1e3a632be47bc854de07525a9cbd3ac0b784219ab4fa71ad840d752e27c48353","616dc398d9200243dd38f6eaeddd6ac014c4e0f31c1dea23fde6ccae78b723cb","5669fc89a0e54396734d9cffde30e99ec79fd97c1e36511919210445657b28d6","5d6df066d535ae9127d93b4e8ef0ac7d26420024577f6ad9bdad84052295827c","c98a01da5289da6f4a09336a8f1ef6edd7ef7fc54eebada0e15296fa53527d61","80698290575289920b2ab2c448eea7f6007bb1cc2d1ee1f5bb321b1c0442b6c5","34a4893e2994dab25f0f4f930830d918038f5c02b1a17cbef0634a44a9216cf6"],"paragraph_range_zero_based":[36072,36095],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p36072"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36096},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36097},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSet-v1700 ::= SEQUENCE {","paragraph_zero_based":36098},{"literal_text_all_w_t_and_m_t":"    uac-BarringFactorForAI3-r17  ENUMERATED {p00, p05, p10, p15, p20, p25, p30, p40, p50, p60, p70, p75, p80, p85, p90, p95}","paragraph_zero_based":36099},{"literal_text_all_w_t_and_m_t":"                                                                       OPTIONAL  -- Need S","paragraph_zero_based":36100},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36102},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGINFOSETLIST-STOP","paragraph_zero_based":36103},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36105},{"literal_text_all_w_t_and_m_t":"UAC-BarringInfoSetList field descriptions","paragraph_zero_based":36106},{"literal_text_all_w_t_and_m_t":"uac-BarringInfoSetList","paragraph_zero_based":36107},{"literal_text_all_w_t_and_m_t":"List of access control parameter sets. Each access category can be configured with access parameters corresponding to a particular set by uac-barringInfoSetIndex. Association of an access category with an index that has no corresponding entry in the uac-BarringInfoSetList is valid configuration and indicates no barring.","paragraph_zero_based":36108},{"literal_text_all_w_t_and_m_t":"uac-BarringForAccessIdentity","paragraph_zero_based":36109},{"literal_text_all_w_t_and_m_t":"Indicates whether access attempt is allowed for each Access Identity. The leftmost bit, bit 0 in the bit string corresponds to Access Identity 1, bit 1 in the bit string corresponds to Access Identity 2, bit 2 in the bit string corresponds to Access Identity 11, bit 3 in the bit string corresponds to Access Identity 12, bit 4 in the bit string corresponds to Access Identity 13, bit 5 in the bit string corresponds to Access Identity 14, and bit 6 in the bit string corresponds to Access Identity 15. Value 0 means that access attempt is allowed for the corresponding access identity.","paragraph_zero_based":36110},{"literal_text_all_w_t_and_m_t":"uac-BarringFactor","paragraph_zero_based":36111},{"literal_text_all_w_t_and_m_t":"Represents the probability that access attempt would be allowed during access barring check.","paragraph_zero_based":36112},{"literal_text_all_w_t_and_m_t":"uac-BarringFactorForAI3","paragraph_zero_based":36113},{"literal_text_all_w_t_and_m_t":"Barring factor applicable for Access Identity 3. Represents the probability that access attempt would be allowed during access barring check. If absent, the UE considers the access attempt as allowed.","paragraph_zero_based":36114},{"literal_text_all_w_t_and_m_t":"uac-BarringTime","paragraph_zero_based":36115},{"literal_text_all_w_t_and_m_t":"The average time in seconds before a new access attempt is to be performed after an access attempt was barred at access barring check for the same access category, see 5.3.14.5.","paragraph_zero_based":36116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36117},{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerCatList","paragraph_zero_based":36118},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerCatList provides access control parameters for a list of access categories.","paragraph_zero_based":36119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_El