{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47808},{"literal_text_all_w_t_and_m_t":"-- TAG-MBS-SESSIONINFOLISTMULTICAST-START","paragraph_zero_based":47809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47810},{"literal_text_all_w_t_and_m_t":"MBS-SessionInfoListMulticast-r18 ::=      SEQUENCE (SIZE (1..maxNrofMBS-Session-r17)) OF MBS-SessionInfoMulticast-r18","paragraph_zero_based":47811},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47812},{"literal_text_all_w_t_and_m_t":"MBS-SessionInfoMulticast-r18 ::=   SEQUENCE {","paragraph_zero_based":47813},{"literal_text_all_w_t_and_m_t":"    mbs-SessionId-r18                  TMGI-r17,","paragraph_zero_based":47814},{"literal_text_all_w_t_and_m_t":"    g-RNTI-r18                         RNTI-Value                                   OPTIONAL, -- Need R","paragraph_zero_based":47815},{"literal_text_all_w_t_and_m_t":"    mrb-ListMulticast-r18              MRB-ListMulticast-r18                        OPTIONAL, -- Need R","paragraph_zero_based":47816},{"literal_text_all_w_t_and_m_t":"    mtch-SchedulingInfo-r18            DRX-ConfigPTM-Index-r17                      OPTIONAL, -- Need S","paragraph_zero_based":47817},{"literal_text_all_w_t_and_m_t":"    mtch-NeighbourCell-r18             BIT STRING (SIZE(maxNeighCellMBS-r17))       OPTIONAL, -- Need S","paragraph_zero_based":47818},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigIndex-r18              PDSCH-ConfigIndex-r17                        OPTIONAL, -- Need S","paragraph_zero_based":47819},{"literal_text_all_w_t_and_m_t":"    mtch-SSB-MappingWindowIndex-r18    MTCH-SSB-MappingWindowIndex-r17              OPTIONAL, -- Cond MTCH-Mapping","paragraph_zero_based":47820},{"literal_text_all_w_t_and_m_t":"    thresholdIndex-r18                 INTEGER (0..maxNrofThresholdMBS-r18)         OPTIONAL, -- Need R","paragraph_zero_based":47821},{"literal_text_all_w_t_and_m_t":"    pdcp-SYNC-Indicator-r18            ENUMERATED {true}                            OPTIONAL, -- Cond RRCRelease","paragraph_zero_based":47822},{"literal_text_all_w_t_and_m_t":"    stopMonitoringRNTI-r18             ENUMERATED {true}                            OPTIONAL  -- Need R","paragraph_zero_based":47823},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47825},{"literal_text_all_w_t_and_m_t":"MRB-ListMulticast-r18 ::=          SEQUENCE (SIZE (1.. maxMRB-r17)) OF MRB-InfoMulticast-r18","paragraph_zero_based":47826},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47827},{"literal_text_all_w_t_and_m_t":"MRB-InfoMulticast-r18 ::=          SEQUENCE {","paragraph_zero_based":47828},{"literal_text_all_w_t_and_m_t":"    pdcp-Config-r18                    MRB-PDCP-ConfigMulticast-r18,","paragraph_zero_based":47829},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r18                     MRB-RLC-ConfigMulticast-r18,","paragraph_zero_based":47830},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d1a94c3e7bcefa122f5a43803116e699345562c69d9c237e78d9c5986ee25c50","2b783a7abfc10d1ed92d258f49fa8d2108cb36efb89da79d7b772b57475bba70","4e28b4ae191036b6eb6bf0a5647f3af020de32c0bfcb34d76493d32cacf78815","48b3e1de77a85b33f9eef51431e2139b036897b78c3b810a4729752b969c4eb5","fcf4eb7745ceaf0d386394400fa028f8cf2d86136628867336a5422b3316b17b","287d68276134ab2374215202dac673c0d8462585b7ce1825abd5dd6537a40508","58b03a4b0c07dca6924ed5fb43e8658ba1d1db856bf