{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-DRX-Config field descriptions","paragraph_zero_based":45048},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigGC-BC","paragraph_zero_based":45049},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":45050},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToReleaseList","paragraph_zero_based":45051},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to remove.","paragraph_zero_based":45052},{"literal_text_all_w_t_and_m_t":"sl-DRX-ConfigUC-ToAddModList","paragraph_zero_based":45053},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configurations for corresponding unicast destinations to add and/or modify.","paragraph_zero_based":45054},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45055},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45056},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45057},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":45058},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":45059},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45060},{"literal_text_all_w_t_and_m_t":"–SL-DRX-ConfigGC-BC","paragraph_zero_based":45061},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-ConfigGC-BC is used to configure DRX related parameters for NR sidelink groupcast and broadcast communication, unicast/broadcast based communication of Direct Link Establishment Request (TS 24.587 [57]), and discovery message (TS 24.554 [72]).","paragraph_zero_based":45062},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC information element","paragraph_zero_based":45063},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45064},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGGC-BC-START","paragraph_zero_based":45065},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45066},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC-r17 ::=      SEQUENCE {","paragraph_zero_based":45067},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-BC-PerQoS-List-r17    SEQUENCE (SIZE (1..maxSL-GC-BC-DRX-QoS-r17)) OF SL-DRX-GC-BC-QoS-r17        OPTIONAL,    -- Need M","paragraph_zero_based":45068},{"literal_text_all_w_t_and_m_t":"    sl-DRX-GC-generic-r17           SL-DRX-GC-Generic-r17                                                       OPTIONAL,    -- Need M","paragraph_zero_based":45069},{"literal_text_all_w_t_and_m_t":"    sl-DefaultDRX-GC-BC-r17         SL-DRX-GC-BC-QoS-r17                                                        OPTIONAL,    -- Need M","paragraph_zero_based":45070},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["075294fb8aac26c201ba46cf7e1746b7ce3e6221c78ff3f1ffd19536472bf259","dd248946fe664366f700d6e5084cbb1e0519b1312a7ad2d821cad358612d4ab1","a4b820bd14d14046b3a6298f0f2bff5488aae82ba04c80d14cda392441f94237","591c99b65421ff5af3e0d52f9983d88a7447260e7a11bf65797d29cd39050087","eaccaec46c76c1f828e8eb47adf658b5c7ad274bcd2afdf9defb08ef183f04fc","91942793be171f48d5c2c88aea077792f83e4ec40bc7bd8d0e6fbe98d5795b9b","c95381d37123247d5be9ae2c43eb5f86ab06d637a41f0c754628eba1b6847417","0c07164879ee363af02b669e63caeb45964d