{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":24504},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR idle/inactive measurement parameters apply. The UE shall select the first listed band which it supports in the frequencyBandList field to represent the NR neighbour carrier frequency.","paragraph_zero_based":24505},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":24506},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall include beam measurements in the NR idle/inactive measurement results.","paragraph_zero_based":24507},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":24508},{"literal_text_all_w_t_and_m_t":"Max number of beam indices to include in the idle/inactive measurement result.","paragraph_zero_based":24509},{"literal_text_all_w_t_and_m_t":"measCellListEUTRA","paragraph_zero_based":24510},{"literal_text_all_w_t_and_m_t":"Indicates the list of E-UTRA cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":24511},{"literal_text_all_w_t_and_m_t":"measCellListNR","paragraph_zero_based":24512},{"literal_text_all_w_t_and_m_t":"Indicates the list of NR cells which the UE is requested to measure and report for idle/inactive measurements.","paragraph_zero_based":24513},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListEUTRA","paragraph_zero_based":24514},{"literal_text_all_w_t_and_m_t":"Indicates the E-UTRA carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":24515},{"literal_text_all_w_t_and_m_t":"measIdleCarrierListNR","paragraph_zero_based":24516},{"literal_text_all_w_t_and_m_t":"Indicates the NR carriers to be measured during RRC_IDLE or RRC_INACTIVE.","paragraph_zero_based":24517},{"literal_text_all_w_t_and_m_t":"measIdleDuration","paragraph_zero_based":24518},{"literal_text_all_w_t_and_m_t":"Indicates the duration for performing idle/inactive measurements while in RRC_IDLE or RRC_INACTIVE. Value sec10 correspond to 10 seconds, value sec30 to 30 seconds and so on.","paragraph_zero_based":24519},{"literal_text_all_w_t_and_m_t":"measIdleValidityDuration, measReselectionValidityDuration","paragraph_zero_based":24520},{"literal_text_all_w_t_and_m_t":"Indicates time values for UE to determine validity of reported idle/inactive and reselection measurements as defined in TS 38.133[14]. Value s5 correspond to 5 seconds, value s10 correspond to 10 seconds and so on.","paragraph_zero_based":24521},{"literal_text_all_w_t_and_m_t":"measReselectionCarrierListNR","paragraph_zero_based":24522},{"literal_text_all_w_t_and_m_t":"Indicates the NR carriers for reselection measurement reporting.","paragraph_zero_based":24523},{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":24524},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation.","paragraph_zero_based":24525},{"literal_text_all_w_t_and_m_t":"qualityThreshold","paragraph_zero_based":24526},{"literal_text_all_w_t_and_m_t":"Indicates the quality thresholds for reporting the measured cells for idle/inactive NR measurements.","paragraph_zero_based":24527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4ca47e4ec2190b56fa904a64947d404f3a9158d2a094e7a69bc701dd29dce7b8","0eef21591f067bab646150b4de3e544ea15ef63100a38c6081c2a4c2643e9b4e","422d396da2fe77eecbd27081ae81ed201f6ee27e4840b472124863125a77876e","c1d758960e076600f