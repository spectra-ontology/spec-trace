{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing-r17          INTEGER (0..100)                                                    OPTIONAL,   -- Need M","paragraph_zero_based":47232},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic-r17                INTEGER (0..30)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":47233},{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime-r17         ENUMERATED { enabled, disabled }                                    OPTIONAL,   -- Need M","paragraph_zero_based":47234},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47235},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47237},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PBPS-CPS-CONFIG-STOP","paragraph_zero_based":47238},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47239},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47240},{"literal_text_all_w_t_and_m_t":"SL-PBPS-CPS-Config field descriptions","paragraph_zero_based":47241},{"literal_text_all_w_t_and_m_t":"sl-Additional-PBPS-Occasion","paragraph_zero_based":47242},{"literal_text_all_w_t_and_m_t":"Indicates that UE additionally monitors periodic sensing occasions that correspond to a set of values. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":47243},{"literal_text_all_w_t_and_m_t":"sl-AllowedResourceSelectionConfig","paragraph_zero_based":47244},{"literal_text_all_w_t_and_m_t":"Indicates the allowed resource selection mechanism(s), i.e. full sensing only, partial sensing only, random resource selection only, or any combination(s) thereof. (see TS 38.214 [19], clause 8.1.4). Only c1, c4 , c5 or c7 can be configured for a Rel-16 resource pool. If this field is not configured for a resource pool included in sl-TxPoolSelectedNormal, only full sensing is allowed in the corresponding resource pool.","paragraph_zero_based":47245},{"literal_text_all_w_t_and_m_t":"c1: only full sensing allowed","paragraph_zero_based":47246},{"literal_text_all_w_t_and_m_t":"c2: only partial sensing allowed","paragraph_zero_based":47247},{"literal_text_all_w_t_and_m_t":"c3: only random selection allowed","paragraph_zero_based":47248},{"literal_text_all_w_t_and_m_t":"c4: full sensing+random selection allowed","paragraph_zero_based":47249},{"literal_text_all_w_t_and_m_t":"c5: full sensing+ partial sensing allowed","paragraph_zero_based":47250},{"literal_text_all_w_t_and_m_t":"c6: partial sensing + random selection allowed","paragraph_zero_based":47251},{"literal_text_all_w_t_and_m_t":"c7: full sensing+ partial sensing + random selection allowed.","paragraph_zero_based":47252},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowAperiodic","paragraph_zero_based":47253},{"literal_text_all_w_t_and_m_t":"Parameter that indicates the minimum size of contiguous partial sensing window in logical slot units for a resource (re)selection procedure and re-evaluation/pre-emption checking triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4). If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":47254},{"literal_text_all_w_t_and_m_t":"sl-CPS-WindowPeriodic","paragraph_zero_based":47255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["425593c9f5025788579a6e5c1b41164ed60f0c613e8d370ad326fdf6a68914df","8ce3025198ef1cfa5e46ee92fc3d268bdffbc9e8b1cb6a8a02689ace9ceceb16","853cc711d0e80708d7d8d4902cc142b3b952ae1aa315ea810face99ee8e121c0","33deda21edf8123ffc64e6adbd9aa0eb5138cbc579acd93bbf9a602ef455d12b","98312c99c8c26b1967c13a2a98ce5babf2d733cd5de1b1a0ce8275376b851552","fb8bc64ed5afe08f5969391cc71361b6434eb54c25189d33e21a430a89b24067","4980c57ce2e0f2f6b3af4d3787b29872c838f7e260dba777cf0be21eecb9aed7","04cbb701f6c42c076c7a1384388c9341f6e2f0d3f4001502c350edd22622ecd5","5125d68013731180ba5d5c6bf70c767f7316e51865f2c3bb2cac2d4bf255b90e","e244fee9255595a2467a0a0096291ba86895f04bc0cf44d2adc47b1165e83534","d9e292f3547901e3cc6f6c83871c4648670b7d9984774f4289fed8a2ea0ffb1c","c92051b7be4c822b52ec06e5d9cc799ffae2b5149e79611cf86ffa165c67c33b","b8eeb73999bc47bd55160981051f0479075f307d1d9d7be83d9a010f314fb139","b8701668f403278c4270a8467058d7f8d940101fbf705421ccc44d570e911c53","ff455aa7f854b71bd7461c3e6bb9a4afb965421123930efba8e8b4c190b24bf1","95c2902c34dbac1ca10f7b603b6dbffa9c4116046eb62ca8deebb6859f990154","ce74105c53b054b71273402636f5a5d28c6c58a22623284f168907ff91b8a848","c1ccac95ffdd2aa8711f95100979c7d0679d2e0835f325e76ba72c4092a10773","066212338625094baa69c52659920e40df7d69e6e304fa7b3b3f75a00c8b5f51","da75486c7dd1e53b8b94b0bea4343e64b77f3335e7ac76e118b9a430143c2670","f429ce7e0d776b9b323a76bfb2f1d40c0a24258a50c87e43d473b968f0604697","912ee237460da0276cb82e1f2cd674c75bc2a32153a70d5538a47d8e27c4431b","c5c60947dd3c2be8560564f6ee11e9e709cd11fffa9ec7bba45d26c7934dda89","e95707ac490d68125bf81b5df6a73416e287ffb0dd6a14c6c3b8327c6fcf243c"],"paragraph_range_zero_based":[47232,47255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the size of contiguous partial sensing window in logical slot units when UE performs periodic-based and contiguous partial sensing for a resource (re)selection procedure triggered by periodic transmission. If not configured, the size of contiguous partial sensing window in logical slot units is 31.","paragraph_zero_based":47256},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-PartialSensing","paragraph_zero_based":47257},{"literal_text_all_w_t_and_m_t":"Indicates default value of SL CBR measurement for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured) if the number of SL RSSI measurement slots over CBR measurement window is below sl-MinNumRssiMeasurementSlots, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":47258},{"literal_text_all_w_t_and_m_t":"sl-DefaultCBR-RandomSelection","paragraph_zero_based":47259},{"literal_text_all_w_t_and_m_t":"Indicates default value of CBR measurement for a UE that performs random resource selection if no SL CBR measurement result over SL CBR measurement window, (see TS 38.214 [19], clause 8.1.6). Value 0 corresponds to 0, value 1 to 0.01, value 2 to 0.02, and so on.","paragraph_zero_based":47260},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsAperiodic","paragraph_zero_based":47261},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y' slots that are included in the possible candidate resources corresponding to periodic-based partial sensing and/or contiguous partial sensing for resource (re)selection triggered by aperiodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":47262},{"literal_text_all_w_t_and_m_t":"sl-MinNumCandidateSlotsPeriodic","paragraph_zero_based":47263},{"literal_text_all_w_t_and_m_t":"Indicates the minimum number of Y slots that are included in the possible candidate resources corresponding to periodic-based partial sensing for resource (re)selection triggered by periodic transmission. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":47264},{"literal_text_all_w_t_and_m_t":"sl-MinNumRssiMeasurementSlots","paragraph_zero_based":47265},{"literal_text_all_w_t_and_m_t":"Indicates a threshold for a minimum number of SL RSSI measurement slots over CBR measurement window for which the SL RSSI is measured for a UE that is configured to perform partial sensing by its higher layer (including when SL DRX is configured). (see TS 38.214 [19], clause 8.1.6).","paragraph_zero_based":47266},{"literal_text_all_w_t_and_m_t":"sl-PartialSensingInactiveTime","paragraph_zero_based":47267},{"literal_text_all_w_t_and_m_t":"Indicates whether or not UE is required to perform SL reception of PSCCH and RSRP measurement for partial sensing on slots in SL DRX inactive time when partial sensing is configured by its higher layer. (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":47268},{"literal_text_all_w_t_and_m_t":"sl-PBPS-OccasionReservePeriodList","paragraph_zero_based":47269},{"literal_text_all_w_t_and_m_t":"Indicates the subset of periodicity values from sl-ResourceReservePeriodList used to determine periodic sensing occasions in periodic-based partial sensing, by means of an index to the corresponding entry in sl-ResourceReservePeriodList-r16. If not configured, all periodicity values from sl-ResourceReservePeriodList are used to determine periodic sensing occasions in periodic-based partial sensing (see TS 38.214 [19], clause 8.1.4).","paragraph_zero_based":47270},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47271},{"literal_text_all_w_t_and_m_t":"–SL-PDCP-Config","paragraph_zero_based":47272},{"literal_text_all_w_t_and_m_t":"The IE SL-PDCP-Config is used to set the configurable PDCP parameters for a sidelink radio bearer.","paragraph_zero_based":47273},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config information element","paragraph_zero_based":47274},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47275},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-START","paragraph_zero_based":47276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47277},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config-r16 ::=       SEQUENCE {","paragraph_zero_based":47278},{"literal_text_all_w_t_and_m_t":"    sl-DiscardTimer-r16          ENUMERATED {ms3, ms10, ms20, ms25, ms30, ms40, ms50, ms60, ms75, ms100, ms150, ms200,","paragraph_zero_based":47279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["803313a8a42eaa1cb7579fdcfcc60c0a46b810d658d3d89529ae785c8b8d2d53","6a6b3ea4f7d4c3c815bff526c92c510da64386ded55aabf924fe1ea854f15cfd","c3d447a2b5e0d0f5964f1edcbd540fb20aa07c1fdade7932139e5a81e7076f35","e9bdb9c82e7fbd8f414d7de36ebf4b844ea6b2ac3651c7f6515330ad11004c3e","a706b4684a9544462e7c031d3a54a2c78ecd2acc17a5a0b37a83d35fc655ef60","23b5f738065d04556962f0941224bf95257d991af4211a5c9fd3830fde4cd025","008cd6ba694d4bc6411886bbcceda65042ad9d3aedef13587186627bc8b9afb1","eb0903cc087deda5e05375f85aa560c3ab0f94288ea70aef4a5f70320ecd5a0a","66c4fbd8f2aecf411a2c815c5893cd65c0b277cf1ad6167ce1665d83743b66da","c257988bfb12a764fac5c84a5c831f1d79fc9075602d97aa25ec35bd30ed88d9","a1c854024e95ad640081487d5a133508783b6db3a77dde14bebf7c066eb63485","d501b1d65825864f5048d11ddac5622cd78809f5a9f977455105a7317950a0e4","0b2bd4a6caba67dc589a4cf95bffde09c409add5ea05a813308aefd66c800ac3","6ed1458b7ff3ad017fb35d7369ae02523b65c8d1a08607d29ca51a63444a96bc","bacd05b45c3a06e311e2a1006aa36de120be5348df99dcf9751db4cba656390b","203afc48dba29ba70e90e81066b0c15c3b052ad9506047ee3da7bbea995e0401","4fe0d09f185d2d8a51b190670d443acb9a76536444f3454fd345ea8dc94ed81d","aebb65e36a9acbbec6feaf2769c98b40ecfe9b479e0fbb661f62b265e9946d90","147593327bcc30a096b1c893ec7273caf0c399d315a70c43e8ba98710810bdec","e93110941b4e7183f35b35928670114bd8a826e6756913b8dad365213c496349","dfa3ee923d503c3596803bd0f0900a872e2614534e1f4050975940d83eb723a4","e0009b9ee1ddd63cd1a0358cd93a59acf5c144d9f23760afd03f94cc8dd8a733","b5a215c9fcffa49b042aed82b9b97a23ff63a45536d4206f250fb35f8983b731","daf9f10eb7c4372df602d37c0fb1b71426c44a21aba5c0f136cdaf3313167fce"],"paragraph_range_zero_based":[47256,47279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p47256"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                 ms250, ms300, ms500, ms750, ms1500, infinity}                                   OPTIONAL, -- Cond Setup","paragraph_zero_based":47280},{"literal_text_all_w_t_and_m_t":"    sl-PDCP-SN-Size-r16          ENUMERATED {len12bits, len18bits}                                               OPTIONAL, -- Cond Setup2","paragraph_zero_based":47281},{"literal_text_all_w_t_and_m_t":"    sl-OutOfOrderDelivery        ENUMERATED { true }                                                             OPTIONAL,    -- Need R","paragraph_zero_based":47282},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":47283},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47285},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PDCP-CONFIG-STOP","paragraph_zero_based":47286},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47288},{"literal_text_all_w_t_and_m_t":"SL-PDCP-Config field descriptions","paragraph_zero_based":47289},{"literal_text_all_w_t_and_m_t":"sl-DiscardTimer","paragraph_zero_based":47290},{"literal_text_all_w_t_and_m_t":"Value in ms of discardTimer specified in TS 38.323 [5]. Value ms50 corresponds to 50 ms, value ms100 corresponds to 100 ms and so on.","paragraph_zero_based":47291},{"literal_text_all_w_t_and_m_t":"sl-OutOfOrderDelivery","paragraph_zero_based":47292},{"literal_text_all_w_t_and_m_t":"Indicates whether or not outOfOrderDelivery specified in TS 38.323 [5] is configured. This field should be either always present or always absent, after the radio bearer is established.","paragraph_zero_based":47293},{"literal_text_all_w_t_and_m_t":"sl-PDCP-SN-Size","paragraph_zero_based":47294},{"literal_text_all_w_t_and_m_t":"PDCP sequence number size for unicast NR sidelink communication, 12 or 18 bits, as specified in TS 38.323 [5]. For groupcast and broadcast NR sidelink communication, only 12 bits is applicable, as specified in 9.1.1.5.","paragraph_zero_based":47295},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47296},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47297},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47298},{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":47299},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via dedicated signaling and in case of sidelink DRB configuration via system information and pre-configuration; otherwise the field is optionally present, need M.","paragraph_zero_based":47300},{"literal_text_all_w_t_and_m_t":"Setup2","paragraph_zero_based":47301},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in case of sidelink DRB setup via dedicated signaling and in case of sidelink DRB configuration via system information and pre-configuration for RLC-AM and RLC-UM for unicast NR sidelink communication; otherwise the field is not present, Need M.","paragraph_zero_based":47302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c5fc6e6b5f25caaee80e3f6bfaa06173aeda9e71863215e1ced59fbb4f99101d","186cef169d57c99d83ff2c86b649ac27560e6d90bc535df15bf2764b5881c3bf","07209e00013786dd23095c8f6379147e087608b7a8608b839bb6e05e0ac64646","40128cafb94050ee5ff56fa5b8b7db302ec7ff632ef68722b2d0b90c966d9a12","4ac2b32bac5d0960b3d6e00edc784