{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26064},{"literal_text_all_w_t_and_m_t":"NeedForGapsConfigNR field descriptions","paragraph_zero_based":26065},{"literal_text_all_w_t_and_m_t":"requestedTargetBandFilterNR","paragraph_zero_based":26066},{"literal_text_all_w_t_and_m_t":"Indicates the target NR bands that the UE is requested to report the gap requirement information.","paragraph_zero_based":26067},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26068},{"literal_text_all_w_t_and_m_t":"–NeedForGapsInfoNR","paragraph_zero_based":26069},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapsInfoNR indicates whether measurement gap is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":26070},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR information element","paragraph_zero_based":26071},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26072},{"literal_text_all_w_t_and_m_t":"-- TAG-NeedForGapsInfoNR-START","paragraph_zero_based":26073},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26074},{"literal_text_all_w_t_and_m_t":"NeedForGapsInfoNR-r16 ::=        SEQUENCE {","paragraph_zero_based":26075},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForGap-r16      NeedForGapsIntraFreqList-r16,","paragraph_zero_based":26076},{"literal_text_all_w_t_and_m_t":"    interFreq-needForGap-r16      NeedForGapsBandListNR-r16","paragraph_zero_based":26077},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26079},{"literal_text_all_w_t_and_m_t":"NeedForGapsIntraFreqList-r16 ::=          SEQUENCE (SIZE (1.. maxNrofServingCells)) OF NeedForGapsIntraFreq-r16","paragraph_zero_based":26080},{"literal_text_all_w_t_and_m_t":