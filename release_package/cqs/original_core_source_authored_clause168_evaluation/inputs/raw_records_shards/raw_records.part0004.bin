{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"   maxNrofPorts-SDM-r18                     ENUMERATED {n1, n2}                                     OPTIONAL    -- Need R","paragraph_zero_based":28872},{"literal_text_all_w_t_and_m_t":"   ]]","paragraph_zero_based":28873},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28874},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28875},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-UPLINKCONFIG-STOP","paragraph_zero_based":28876},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28878},{"literal_text_all_w_t_and_m_t":"PTRS-UplinkConfig field descriptions","paragraph_zero_based":28879},{"literal_text_all_w_t_and_m_t":"frequencyDensity","paragraph_zero_based":28880},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of UL PT-RS for CP-OFDM waveform as a function of scheduled BW If the field is absent, the UE uses K_PT-RS = 2 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":28881},{"literal_text_all_w_t_and_m_t":"maxNrofPorts, maxNrofPorts-SDM","paragraph_zero_based":28882},{"literal_text_all_w_t_and_m_t":"The maximum number of UL PTRS ports for CP-OFDM (see TS 38.214 [19], clause 6.2.3.1).","paragraph_zero_based":28883},{"literal_text_all_w_t_and_m_t":"ptrs-Power","paragraph_zero_based":28884},{"literal_text_all_w_t_and_m_t":"UL PTRS power boosting factor per PTRS port (see TS 38.214 [19], clause 6.1, table 6.2.3.1.3).","paragraph_zero_based":28885},{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":28886},{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for UL PTRS for CP-OFDM. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 6.4.1.2.2).","paragraph_zero_based":28887},{"literal_text_all_w_t_and_m_t":"sampleDensity","paragraph_zero_based":28888},{"literal_text_all_w_t_and_m_t":"Sample density of PT-RS for DFT-s-OFDM, pre-DFT, indicating a set of thresholds T={NRBn, n=0,1,2,3,4}, that indicates dependency between presence of PT-RS and scheduled BW and the values of X and K the UE should use depending on the scheduled BW, see TS 38.214 [19], clause 6.1, table 6.2.3.2-1.","paragraph_zero_based":28889},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":28890},{"literal_text_all_w_t_and_m_t":"Presence and time density of UL PT-RS for CP-OFDM waveform as a function of MCS If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":28891},{"literal_text_all_w_t_and_m_t":"timeDensityTransformPrecoding","paragraph_zero_based":28892},{"literal_text_all_w_t_and_m_t":"Time density (OFDM symbol level) of PT-RS for DFT-s-OFDM. If the field is absent, the UE applies value d1 (see TS 38.214 [19], clause 6.1).","paragraph_zero_based":28893},{"literal_text_all_w_t_and_m_t":"transformPrecoderDisabled","paragraph_zero_based":28894},{"literal_text_all_w_t_and_m_t":"Configuration of UL PTRS without transform precoder (with CP-OFDM).","paragraph_zero_based":28895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["168b44d6f42dd42265a69567afcede5c7f94faaf334d2024d3bf76cd3c3a3990","40198aad2bbbf4fa5e8d76786bf3d341612b0f1448413054677ce61695f1777f","016d444e9ede2dda8533650f761285f15c636072cf9079a485a369e4643fb69a","7d6e1871368933590d1bf0685c14b3a5f05913dcd3052edfd3e067ed3830df7d","7e7faac796daeeae7985fb6c8b486a5a755bd6050cae6b0e28011d56a6308b5d","3842ffd99ffa20d3e8b0ecd26fd2c2d3c05a02fd72d3ee3b