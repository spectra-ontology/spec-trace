{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    cfra                            CFRA                                                                    OPTIONAL, -- Need S","paragraph_zero_based":30144},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization               RA-Prioritization                                                       OPTIONAL, -- Need N","paragraph_zero_based":30145},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30146},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30147},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationTwoStep-r16    RA-Prioritization                                                       OPTIONAL, -- Need N","paragraph_zero_based":30148},{"literal_text_all_w_t_and_m_t":"    cfra-TwoStep-r16                CFRA-TwoStep-r16                                                        OPTIONAL  -- Need S","paragraph_zero_based":30149},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30150},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30151},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30152},{"literal_text_all_w_t_and_m_t":"CFRA ::=                    SEQUENCE {","paragraph_zero_based":30153},{"literal_text_all_w_t_and_m_t":"    occasions                       SEQUENCE {","paragraph_zero_based":30154},{"literal_text_all_w_t_and_m_t":"        rach-ConfigGeneric              RACH-ConfigGeneric,","paragraph_zero_based":30155},{"literal_text_all_w_t_and_m_t":"        ssb-perRACH-Occasion            ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen}","paragraph_zero_based":30156},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL  -- Cond Mandatory","paragraph_zero_based":30157},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Need S","paragraph_zero_based":30158},{"literal_text_all_w_t_and_m_t":"    resources                       CHOICE {","paragraph_zero_based":30159},{"literal_text_all_w_t_and_m_t":"        ssb                             SEQUENCE {","paragraph_zero_based":30160},{"literal_text_all_w_t_and_m_t":"            ssb-ResourceList                SEQUENCE (SIZE(1..maxRA-SSB-Resources)) OF CFRA-SSB-Resource,","paragraph_zero_based":30161},{"literal_text_all_w_t_and_m_t":"            ra-ssb-OccasionMaskIndex        INTEGER (0..15)","paragraph_zero_based":30162},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":30163},{"literal_text_all_w_t_and_m_t":"        csirs                           SEQUENCE {","paragraph_zero_based":30164},{"literal_text_all_w_t_and_m_t":"            csirs-ResourceList              SEQUENCE (SIZE(1..maxRA-CSIRS-Resources)) OF CFRA-CSIRS-Resource,","paragraph_zero_based":30165},{"literal_text_all_w_t_and_m_t":"            rsrp-ThresholdCSI-RS            RSRP-Range","paragraph_zero_based":30166},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":30167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb5b0fc683f1e2859ba753325c85407fb2bb397c8861b60a49ba81fdbd6b1d39","270a2a54813210cebaf94949669794e5b2d8509494c872be0af7c3276a01d909","ab28d4619e9c1fadcad6b918001e212d678dce55955c5ef1f82469e79f159fba","9fd274dc03606318ed23da1872ade7752442d57943ec5d8dbc4c32173f59ac07","f7708355e796042d2698a4044a742d85e844a35595bfd86640498892843fda1b","6fcfaf63f202a3318053d7b7ca64b6382094e0c1f92fe629e0fb19a8ed3ecd