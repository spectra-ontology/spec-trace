{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":312},{"literal_text_all_w_t_and_m_t":"nrTime-r17SEQUENCE {","paragraph_zero_based":313},{"literal_text_all_w_t_and_m_t":"nr-PhysCellID-r17NR-PhysCellID-r16,","paragraph_zero_based":314},{"literal_text_all_w_t_and_m_t":"nr-ARFCN-r17ARFCN-ValueNR-r15,","paragraph_zero_based":315},{"literal_text_all_w_t_and_m_t":"nr-CellGlobalID-r17NCGI-r15OPTIONAL,-- Need ON","paragraph_zero_based":316},{"literal_text_all_w_t_and_m_t":"nr-SFN-r17INTEGER (0..1023),","paragraph_zero_based":317},{"literal_text_all_w_t_and_m_t":"nr-Slot-r17CHOICE {","paragraph_zero_based":318},{"literal_text_all_w_t_and_m_t":"scs15-r17INTEGER (0..9),","paragraph_zero_based":319},{"literal_text_all_w_t_and_m_t":"scs30-r17INTEGER (0..19),","paragraph_zero_based":320},{"literal_text_all_w_t_and_m_t":"scs60-r17INTEGER (0..39),","paragraph_zero_based":321},{"literal_text_all_w_t_and_m_t":"scs120-r17INTEGER (0..79)","paragraph_zero_based":322},{"literal_text_all_w_t_and_m_t":"}OPTIONAL-- Need ON","paragraph_zero_based":323},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":324},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":325},{"literal_text_all_w_t_and_m_t":"}OPTIONAL,-- Need ON","paragraph_zero_based":326},{"literal_text_all_w_t_and_m_t":"relativeTime-r17INTEGER (1..1024)OPTIONAL-- Need ON","paragraph_zero_based":327},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":329},{"literal_text_all_w_t_and_m_t":"TargetIntegrityRisk-r17 ::=INTEGER (10..90)","paragraph_zero_based":330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":331},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":332},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["fc5d93066c4e0054fafcdd923dbc002952be524fab8e8abbcc0db8bb4e535843","df908c7251ffdd6718a1a09938cd8f44468f67a74f37634f98e76c7aaaa5451d","5f4aca4a9303245ce01e9b4e390aec2a7a162c76fe49d3f2da0f6f84331aa9c8","dc2af3ef2d3afc214ba68e371f00ae3844f2f3148f55eb0ff261e0dcf245538f","4f4ac7aee2332e6e2cd36a4f9d0dc4fcb093d8b18f37f96f917d2f433ed4f451","9f70ab5f7f8ae43d17b21896702235b392015e63b51118adb62069cc90194f9e","72169d0e771eec2e304b1f29a2f0442810fbef15ae93ddeff87a38b533b9fbd1","8e4eb44745a7ece7b6ea98a15604b1af29bdbe7736ddbc2bbc37b588fb92041d","e9ed89a17b120286190002d3ef484d9f5e59aeeb5f1effd08b38f9081ab4ae31","be1f1f443afea4d4ce9352048e0813d3e23f87ecc9ec00994a394c1257022e1a","e62ce008a9c0a80e9e7b9d8d6549ddafb41c8552641a3146d7c2584dd4adbd30","e661bd3bdd017a2e83fb28cc083360b427e1860f66c9a4d87f0abd302e138f11","b1801e3accfbd5ab3655c8c7218ccfe3945e7e24094214c2f8b4888f5e8931bd","5b265561ce6dd82318366e897ad55d2d4f7d0e1a63a6746a550726badeed4a4f","124c7aa3c5daa0dc213e35ed5b7f9b23dc565b1407ae53f067a7244575af12b5","b5c89e7bfa3e19b960fa04dc9a19f0d0d9b62c4a7feef4a3bdd2f9e026c9c4f7","3ab619ea1966496269f08fa5c81ed194aef9aa04e19f28127cba62baeb4bddda","cb02030b187494927e3864ff6377744da8543999041dddc851b22cd2d672a65f","75085660a3bb0b8aae435f9366a0ae321388c731c1122308369cce53ccbd7a13","190ed4f51e874027b3b4c5cd0136d3d996210a8028cdd70abd0a06493b130152","df3b5d0fdcbb9d5d8e217fa343cf0fc4af925bfe5a047b93271dc0a57f33b632","d199ee9899dd953baa7b8197a468ddca0937e6a3db1f1acd98f9c22277e0e171","954ed04162dd12554f86c7f55e403f244d989b80cac52fbece61449706b5e0f2","e4fe835c1fa0054c4b3ec55f9a73a0873fe1e0739019786f8831c8076c55641a"],"paragraph_range_zero_based":[312,335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p312"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":336},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":337},{"literal_text_all_w_t_and_m_t":"ECID","paragraph_zero_based":338},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need ON, if E-CID or NR E-CID is requested. Otherwise it is not present.","paragraph_zero_based":339},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":340},{"literal_text_all_w_t_and_m_t":"CommonIEsRequestLocationInformation field descriptions","paragraph_zero_based":341},{"literal_text_all_w_t_and_m_t":"locationInformationType","paragraph_zero_based":342},{"literal_text_all_w_t_and_m_t":"This IE indicates whether the server requires a location estimate or measurements. For 'locationEstimateRequired', the target device shall return a location estimate if possible, or indicate a location error if not possible. For 'locationMeasurementsRequired', the target device shall return measurements if possible, or indicate a location error if not possible. For 'locationEstimatePreferred', the target device shall return a location estimate if possible, but may also or instead return measurements for any requested position methods for which a location estimate is not possible. For 'locationMeasurementsPreferred', the target device shall return location measurements if possible, but may also or instead return a location estimate for any requested position methods for which return of location measurements is not possible. For 'locationEstimateAndMeasurementsRequired', the PRU shall return both location estimate and measurements if possible, or indicate a measurements error if not possible.","paragraph_zero_based":343},{"literal_text_all_w_t_and_m_t":"NOTE:'locationEstimateAndMeasurementsRequired' only applies to PRUs. If the PRU is requested to return both location estimate and measurements, the location estimate is determined independently of the reported measurements, and the measurements shall be valid at the reported location.","paragraph_zero_based":344},{"literal_text_all_w_t_and_m_t":"triggeredReporting","paragraph_zero_based":345},{"literal_text_all_w_t_and_m_t":"This IE indicates that triggered reporting is requested and comprises the following subfields:","paragraph_zero_based":346},{"literal_text_all_w_t_and_m_t":"-cellChange: If this field is set to TRUE, the target device provides requested location information each time the primary cell has changed.","paragraph_zero_based":347},{"literal_text_all_w_t_and_m_t":"-reportingDuration: Maximum duration of triggered reporting in seconds. A value of zero is interpreted to mean an unlimited (i.e. \"infinite\") duration. The target device should continue triggered reporting for the reportingDuration or until an LPP Abort or LPP Error message is received.","paragraph_zero_based":348},{"literal_text_all_w_t_and_m_t":"The triggeredReporting field should not be included by the location server and shall be ignored by the target device if the periodicalReporting IE or responseTime IE or responseTimeNB IE is included in CommonIEsRequestLocationInformation.","paragraph_zero_based":349},{"literal_text_all_w_t_and_m_t":"periodicalReporting","paragraph_zero_based":350},{"literal_text_all_w_t_and_m_t":"This IE indicates that periodic reporting is requested and comprises the following subfields:","paragraph_zero_based":351},{"literal_text_all_w_t_and_m_t":"-reportingAmount indicates the number of periodic location information reports requested. Enumerated values correspond to 1, 2, 4, 8, 16, 32, 64, or infinite/indefinite number of reports. If the reportingAmount is 'infinite/indefinite', the target device shou-ld continue periodic reporting until an LPP Abort message is received. The value 'ra1' shall not be used by a sender.","paragraph_zero_based":352},{"literal_text_all_w_t_and_m_t":"-reportingInterval indicates the interval between location information reports and the response time requirement for the first location information report. Enumerated values ri0-25, ri0-5, ri1, ri2, ri4, ri8, ri16, ri32, ri64 correspond to reporting intervals of 1, 2, 4, 8, 10, 16, 20, 32, and 64 seconds, respectively. Measurement reports containing no measurements or no location estimate are required when a reportingInterval expires before a target device is able to obtain new measurements or obtain a new location estimate. The value 'noPeriodicalReporting' shall not be used by a sender.","paragraph_zero_based":353},{"literal_text_all_w_t_and_m_t":"additionalInformation","paragraph_zero_based":354},{"literal_text_all_w_t_and_m_t":"This IE indicates whether a target device is allowed to return additional information to that requested. If this IE indicates 'onlyReturnInformationRequested' then the target device shall not return any additional information to that requested by the server. If this IE indicates 'mayReturnAdditionalInformation' then the target device may return additional information to that requested by the server. If a location estimate is returned, any additional information is restricted to that associated with a location estimate (e.g. might include velocity if velocity was not requested but cannot include measurements). If measurements are returned, any additional information is restricted to additional measurements (e.g. might include E-CID measurements if A-GNSS measurements were requested but not E-CID measurements).","paragraph_zero_based":355},{"literal_text_all_w_t_and_m_t":"qos","paragraph_zero_based":356},{"literal_text_all_w_t_and_m_t":"This IE indicates the quality of service and comprises a number of sub-fields. In the case of measurements, some of the sub-fields apply to the location estimate that could be obtained by the server from the measurements provided by the target device assuming that the measurements are the only sources of error. Fields are as follows:","paragraph_zero_based":357},{"literal_text_all_w_t_and_m_t":"-horizontalAccuracy indicates the maximum horizontal error in the location estimate at an indicated confidence level. The 'accuracy' corresponds to the encoded uncertainty as defined in TS 23.032 [15] and 'confidence' corresponds to confidence as defined in TS 23.032 [15].","paragraph_zero_based":358},{"literal_text_all_w_t_and_m_t":"-verticalCoordinateRequest indicates whether a vertical coordinate is required (TRUE) or not (FALSE)","paragraph_zero_based":359}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["d648acaa5831371e0cc9698c8286931b07508c4b9a6b85a16e57140d92f791ff","94fee1224527bae9eee2c3ca3e6978d516cde7d9a7e7284190499d6805d93d4f","d6c0f255005b8a2242cff5f63e3ae7defbba77fd63b50c78fbb19166df6a8c14","e9bc12c5f0458765763a0263b82bb50d677e4c72a7e2df1eaa3700569b89b093","73522814ce6eb7f9ba866d79b4c1ee0d46043ede3f49d5d8dc2fe85d82fbdbd5","40923d3b6dcc656a3ef1f3773303039da1fcf1ddc85210247f28c8d5d2a387df","393f71f5bf048c38f78703e4d7770699da62eefe335b719e2f15da967254aa5d","59bac06ab40aecbf5c7fb5d81da146b75f785297c8efb2d87705f48ce07e5273","fe3d31603ce00de8d43f2b5adf0ec542a0058749d9d8abb02435dffc8385862f","cbc015a22c2fd840ee388c12457be9e7b9264f3294d3ef356c50e981af5196c9","45351acfb426e875537c16437259b90864c6667f750e0c47fe3fdda8dd64a2ba","b08bdbf26ec0f44d8d2c2eb47f559380f22e849d5696674ef50947bdfefae710","1b1bc152a4b440382e657d8362961cd957d84df203dda2ce2d53efa6bcd5a53b","734fbfe9fc569c312047b6cb195dd0b427cb27545beee31b1140a1c331754ffd","f8164b901ff4afd5cb7d984fee976e22493b36e1277dd65b410e3ce440ed9e90","f5aaae9573e50ff0cbe8bc07b0a8d4aeb07583c6e5c16aa901b9910ca4e8e31c","85ec9785ad56666bb12e1f886dc79a2e74132a933ac2de2957565f0e29d5fe93","d791e068f4fe4309e5ef68f34926d4bd5ff429cb38fbe0a585b61d77c14ada5d","8ce405b34a628ae9fba35d32c46f78e738db6614433deface5bc9e6f5dea6d6c","92fb35424b7a32498a6226ccbce5f3d29324cda2221e3bca3af074d9e26eb007","cc66d81a18da3e43a596feaed2798619f8c1d4a347585c17b058d37836ec8ea5","b75d3b5567b5cc2c30fb3153aa102c22837fbc1c84d964a36a083e8909e7fad4","5a461f181e152d931045200e09b55de204a2e027b4b0ac3e8925f1e575765599","f7c361a0081055effb9367619139de065f8b43d0ef1c490d7694ba94059bce25"],"paragraph_range_zero_based":[336,359],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p336"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-verticalAccuracy indicates the maximum vertical error in the location estimate at an indicated confidence level and is only applicable when a vertical coordinate is requested. The 'accuracy' corresponds to the encoded uncertainty altitude as defined in TS 23.032 [15] and 'confidence' corresponds to confidence as defined in TS 23.032 [15].","paragraph_zero_based":360},{"literal_text_all_w_t_and_m_t":"-responseTime","paragraph_zero_based":361},{"literal_text_all_w_t_and_m_t":"-time indicates the maximum response time as measured between receipt of the RequestLocationInformation and transmission of a ProvideLocationInformation. If the unit field is absent, this is given as an integer number of seconds between 1 and 128. If the unit field is present with enumerated value 'ten-seconds', the maximum response time is given in units of 10-seconds, between 10 and 1280 seconds. If the unit field is present with enumerated value 'ten-milli-seconds', the maximum response time is given in units of 10-milli-seconds, between 0.01 and 1.28 seconds. If the periodicalReporting IE is included in CommonIEsRequestLocationInformation, this field should not be included by the location server and shall be ignored by the target device (if included).","paragraph_zero_based":362},{"literal_text_all_w_t_and_m_t":"-responseTimeEarlyFix indicates the maximum response time as measured between receipt of the RequestLocationInformation and transmission of a ProvideLocationInformation containing early location measurements or an early location estimate. If the unit field is absent, this is given as an integer number of seconds between 1 and 128. If the unit field is present with enumerated value 'ten-seconds', the maximum response time is given in units of 10-seconds, between 10 and 1280 seconds. If the unit field is present with enumerated value 'ten-milli-seconds', the maximum response time is given in units of 10-milli-seconds, between 0.01 and 1.28 seconds. When this IE is included, a target should send a ProvideLocationInformation (or more than one ProvideLocationInformation if location information will not fit into a single message) containing early location information according to the responseTimeEarlyFix IE and a subsequent ProvideLocationInformation (or more than one ProvideLocationInformation if location information will not fit into a single message) containing final location information according to the time IE. A target shall omit sending a ProvideLocationInformation if the early location information is not available at the expiration of the time value in the responseTimeEarlyFix IE. A server should set the responseTimeEarlyFix IE to a value less than that for the time IE. A target shall ignore the responseTimeEarlyFix IE if its value is not less than that for the time IE.","paragraph_zero_based":363},{"literal_text_all_w_t_and_m_t":"-unit indicates the unit of the time and responseTimeEarlyFix fields. Enumerated value 'ten-seconds' corresponds to a resolution of 10 seconds. Enumerated value 'ten-milli-seconds' corresponds to a resolution of 0.01 seconds. If this field is absent, the unit/resolution is 1 second. Enumerated value 'ten-milli-seconds' is only applicable for NR E-CID Positioning, NR DL-TDOA Positioning, NR DL-AoD Positioning, and NR Multi-RTT Positioning. If the enumerated value 'ten-milli-seconds' is included for methods others than NR E-CID Positioning, NR DL-TDOA Positioning, NR DL-AoD Positioning, and NR Multi-RTT Positioning the target device shall ignore the unit field.","paragraph_zero_based":364},{"literal_text_all_w_t_and_m_t":"-velocityRequest indicates whether velocity (or measurements related to velocity) is requested (TRUE) or not (FALSE).","paragraph_zero_based":365},{"literal_text_all_w_t_and_m_t":"-responseTimeNBIf the periodicalReporting IE or responseTime IE is included in CommonIEsRequestLocationInformation, this field should not be included by the location server and shall be ignored by the target device (if included).","paragraph_zero_based":366},{"literal_text_all_w_t_and_m_t":"-timeNB indicates the maximum response time as measured between receipt of the RequestLocationInformation and transmission of a ProvideLocationInformation. If the unitNB field is absent, this is given as an integer number of seconds between 1 and 512. If the unitNB field is present, the maximum response time is given in units of 10-seconds, between 10 and 5120 seconds.","paragraph_zero_based":367},{"literal_text_all_w_t_and_m_t":"-responseTimeEarlyFixNB indicates the maximum response time as measured between receipt of the RequestLocationInformation and transmission of a ProvideLocationInformation containing early location measurements or an early location estimate. If the unitNB field is absent, this is given as an integer number of seconds between 1 and 512. If the unitNB field is present, the maximum response time is given in units of 10-seconds, between 10 and 5120 seconds. When this IE is included, a target should send a ProvideLocationInformation (or more than one ProvideLocationInformation if location information will not fit into a single message) containing early location information according to the responseTimeEarlyFixNB IE and a subsequent ProvideLocationInformation (or more than one ProvideLocationInformation if location information will not fit into a single message) containing final location information according to the timeNB IE. A target shall omit sending a ProvideLocationInformation if the early location information is not available at the expiration of the time value in the responseTimeEarlyFixNB IE. A server should set the responseTimeEarlyFixNB IE to a value less than that for the timeNB IE. A target shall ignore the responseTimeEarlyFixNB IE if its value is not less than that for the timeNB IE.","paragraph_zero_based":368},{"literal_text_all_w_t_and_m_t":"-unitNB indicates the unit of the timeNB and responseTimeEarlyFixNB fields. Enumerated value 'ten-second' corresponds to a resolution of 10 seconds. If this field is absent, the unit/resolution is 1 second.","paragraph_zero_based":369},{"literal_text_all_w_t_and_m_t":"-horizontalAccuracyExt indicates the maximum horizontal error in the location estimate at an indicated confidence level. The 'accuracyExt' corresponds to the encoded high accuracy uncertainty as defined in TS 23.032 [15] and 'confidence' corresponds to confidence as defined in TS 23.032 [15]. This field should not be included by the location server and shall be ignored by the target device if the horizontalAccuracy field is included in QoS.","paragraph_zero_based":370},{"literal_text_all_w_t_and_m_t":"-verticalAccuracyExt indicates the maximum vertical error in the location estimate at an indicated confidence level and is only applicable when a vertical coordinate is requested. The 'accuracyExt' corresponds to the encoded high accuracy uncertainty as defined in TS 23.032 [15] and 'confidence' corresponds to confidence as defined in TS 23.032 [15]. This field should not be included by the location server and shall be ignored by the target device if the verticalAccuracy field is included in QoS.","paragraph_zero_based":371},{"literal_text_all_w_t_and_m_t":"All QoS requirements shall be obtained by the target device to the degree possible but it is permitted to return a response that does not fulfill all QoS requirements if some were not attainable. The single exception is time and timeNB which shall always be fulfilled – even if that means not fulfilling other QoS requirements.","paragraph_zero_based":372},{"literal_text_all_w_t_and_m_t":"A target device supporting NB-IoT access shall support the responseTimeNB IE.","paragraph_zero_based":373},{"literal_text_all_w_t_and_m_t":"A target device supporting HA GNSS shall support the HorizontalAccuracyExt, VerticalAccuracyEx, and unit fields with enumerated value 'ten-seconds'.","paragraph_zero_based":374},{"literal_text_all_w_t_and_m_t":"A target device supporting NB-IoT access and HA GNSS shall support the unitNB field.","paragraph_zero_based":375},{"literal_text_all_w_t_and_m_t":"environment","paragraph_zero_based":376},{"literal_text_all_w_t_and_m_t":"This field provides the target device with information about expected multipath and non line of sight (NLOS) in the current area. The following values are defined:","paragraph_zero_based":377},{"literal_text_all_w_t_and_m_t":"-badArea:possibly heavy multipath and NLOS conditions (e.g. bad urban or urban).","paragraph_zero_based":378},{"literal_text_all_w_t_and_m_t":"-notBadArea:no or light multipath and usually LOS conditions (e.g. suburban or rural).","paragraph_zero_based":379},{"literal_text_all_w_t_and_m_t":"-mixedArea:environment that is mixed or not defined.","paragraph_zero_based":380},{"literal_text_all_w_t_and_m_t":"If this field is absent, a default value of 'mixedArea' applies.","paragraph_zero_based":381},{"literal_text_all_w_t_and_m_t":"locationCoordinateTypes","paragraph_zero_based":382},{"literal_text_all_w_t_and_m_t":"This field provides a list of the types of location estimate that the target device may return when a location estimate is obtained by the target.","paragraph_zero_based":383}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["cd776fa97ca0b2e6202138189a72904bb9e5ebe4572ad3291e65ce5beec667c4","e0655de2379864aba7793c862142d82960d3dc70d67c4be762a3eb86671a36f5","78ab3023b1a7e48123c8172c0d3c2ad08a703b55d115e6104dc96ae6427f4a1a","6449bb6e11f957571733eb43456fd0b488f2aa39442af258324c18dc596bc399","ce7a1bb66e398ce5aca4b198e4662bdab21d5ee8628df6aaf1f86636416cc779","30ae86d93ffdec64b9fd4a427b000fa2b3e8ddfec4bb548f19b9d872e449b84c","69e961e9cb913990fc0e7a1daed79a91a8adbc12fda9bc74a180546aa1249da8","a1dfa7e60b22d8a996c28573d38bd32f40384d0889160376ea42642eacac0d37","10e3f0540ef719ee8b538398e2b47132f9c1c9fafede7d32a51133db538b45e3","7ac969e2737cce4eda278cc23d1cd6fd04c535d628c3a6ff4f546fd60b9d7357","04445f76d11b11dedf507360c69b8d05be44ead9b9b72f9945ff6f41eb2bae72","dbe843c5d474e2d7d5c9987d3085c8b06ad6db72d97c7b6f1062e9dd09c7d4ae","3fb148510dfabdffe97d3e587bdfd82aa85d5a175e6ed1bfdaf01f5b37270b94","f85de2b53dedfb778288df9d133a174f8fece7710e7a1020171dc6c0881b33cd","936417f241b3e18c54e9fe4b74b27c7daf26bc5df2112ef41810ffbc06b41bbe","3ead90082982d720af0292e56421bf08f9e42c06385ab52e4303661345923940","8244296a2464a2f9ba3726739cc231f6653a2be0adb7ef5cbf687ff64cc162ec","73cefc09d6701309c9263d26ec097e02e88d1e223d914a38838451efe92808ed","2ffb338431f115d262fbecc8157557e8f9ecac95c95bafe2ff79cafcfff6197d","fe01973475b2f568ed07619d2abcc003dedc9df5aec90c0328c1b5b19b51317f","0344c4adbafb8f1192a97a2aeb65fb547f6fffc4a571c020db21dac92af5b821","61121a2aec077aaa0a3453da993f6a20e87a8ca65793ec9f40a217dfae69014a","7537915ecc43d7dd2f16980cf01df64862cc3dcce364b5f1e6e326d1085874f9","84dccab457cae5d978d7038ff5dc7108e2eb4ee33ad6f3813d0b3e6b70ca6161"],"paragraph_range_zero_based":[360,383],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p360"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"velocityTypes","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"This fields provides a list of the types of velocity estimate that the target device may return when a velocity estimate is obtained by the target.","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"messageSizeLimitNB","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"This field provides an octet limit on the amount of location information a target device can return.","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"-measurementLimit indicates the maximum amount of location information the target device should return in response to the RequestLocationInformation message received from the location server.The limit applies to the overall size of the LPP message at LPP level (LPP Provide Location Information), and is specified in steps of 100 octets. The message size limit is then given by the value provided in measurementLimit times 100 octets.","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"segmentationInfo","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"This field indicates whether this RequestLocationInformation message is one of many segments, as specified in clause 4.3.5","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"scheduledLocationTime","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"This field indicates that the target device is requested to obtain location measurements or location estimate valid at the scheduledLocationTime T and comprises the following subfields:","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"-utcTime provides T in UTC in the form of YYMMDDhhmmssZ.","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"-gnssTime provides T in GNSS system time of the GNSS indicated by gnss-TimeID.","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"-gnss-TOD-msec specifies the GNSS TOD in 1-milli-second resolution rounded down to the nearest millisecond unit.","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"-networkTime provides T in E-UTRA or NR network time.","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"-lte-PhysCellId, lte-ArfcnEUTRA, lte-CellGlobalId identifies the reference cell (E-UTRA) that is used for the network time.","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"-lte-systemFrameNumber specifies the system frame number in E-UTRA.","paragraph_zero_based":398},{"literal_text_all_w_t_and_m_t":"-nr-PhysCellID, nr-ARFCN , nr-CellGlobalID identifies the reference cell (NR) that is used for the network time.","paragraph_zero_based":399},{"literal_text_all_w_t_and_m_t":"-nr-SFN specifies the system frame number in NR.","paragraph_zero_based":400},{"literal_text_all_w_t_and_m_t":"-nr-Slot specifies the slot number in NR for the indicated subcarrier spacing (SCS). The total NR network time is given by nr-SFN + nr-Slot.","paragraph_zero_based":401},{"literal_text_all_w_t_and_m_t":"-relativeTime provides T in seconds from current time, where current time is defined as the time the CommonIEsRequestLocationInformation was received.","paragraph_zero_based":402},{"literal_text_all_w_t_and_m_t":"NOTE 1:A location estimate returned to an LCS Client, AF or UE for a scheduled location time can be treated by the LCS Client, AF or UE as an estimate of the location of the UE at the scheduled location time (see TS 23.273 [42]).","paragraph_zero_based":403},{"literal_text_all_w_t_and_m_t":"NOTE 2:If this field is present, at least one of utcTime, gnssTime, networkTime, or relativeTime shall be present.","paragraph_zero_based":404},{"literal_text_all_w_t_and_m_t":"targetIntegrityRisk","paragraph_zero_based":405},{"literal_text_all_w_t_and_m_t":"This field indicates the TIR for which the PL is requested. The TIR is calculated by P=10-0.1n [hour-1] where n is the value of targetIntegrityRisk and the range is 10-1 to 10-9 per hour.","paragraph_zero_based":406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["73d1fa434f36b4a6b1db6b5ce058f7c7117fe2f60f828fb26723d6a909590d20","adca08ef6eb2d1c4b7e4049350e586e1ffa5a4ef5daf34472e60f8152bceed67","87f21fd752efeb4a4e9a9e3212c8cd89ce8e0d5dd8a2da0e43c878cceb83d031","9d53d01e430c098fc3d71ad247bd4984581ae3db2b514c87d3f72316e8c70f1f","147b25521cbf6ed53357afbfe3973d7f8c0d2b297858181309b21edc4005795e","3a622bbed4dfcea65c3741280e0db6817110050692d93612bf6fad1ddc3bb44f","6be9530d2cd66b1b0084d63f10a9ab9c7143d2636d416e1e9561f36f1037e7cd","c7aa42ae2db6727fbeffdc2476d98decfaad8c69483d4939cc95a0e6aac26ace","c740f26ede5050e1ac62a59b75e79d6702ae492fc06fd90669ea45f5aa6ebcb1","56a591972113634fb60a14db05dbe1f4ead4a1483359ffaefd199b59b2cd1dca","7771e7b8a490748e384b72ddb4375ed7920e7516cb9478bdb4e873523ca0e5cd","976e8d4e34404ebd6885f260a49628595238e9d693df9ccadb0ee40ff52362ef","6ef4782f92f199fdedb5c73a3413daf0e4832405f2c259d59175e54d18ab2328","526f40b7ecd07cd5218910b27007b52dc17a1af1707ffa3b2b12fc5e3373d1a4","468a1063eded55effb61fbff75c920b2ec962a503f67ffd3d357d82b395a0def","b4eb45b1cf5e3090a6f806297d7e26d966a8995d2cf00521499cf31a9a44196c","2f21797378eec6f90ff44ac4f492f5a906bfdb348714925aff3ba26ab1d39c2b","740bdd58f9a92fbe67450dac70b1d035603b8b58ad69ea52387022e5eefdf571","191ca16306fcfe1114e9e6563a9ccae32800b853aa064a195a0d13c51d56be4a","8e8676757d296ddcadf5a5211d9f88f4abb0e44577267d16cacdad2a25876d9d","6b52f285f10bf262a13fc270766c660664bec45ad1e3d96a5c8df26e72057659","9937ba98fb1f0ac58f95d6c1f71a3853bf46475719c1bb79a221a04391630357","9e7ed5da0f4d44a1bb8c28787298b1cdec81733a98ad6f2631338f1a30ea05aa","4b7108c988a77695411974dbfd13c9000885f5f28ef9fe5daabf18d20eae13e5"],"paragraph_range_zero_based":[384,407],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p384"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":408},{"literal_text_all_w_t_and_m_t":"6.4.3Common NR Positioning Information Elements","paragraph_zero_based":409},{"literal_text_all_w_t_and_m_t":"–NR-DL-PRS-MeasurementTimeWindowsConfig","paragraph_zero_based":410},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-PRS-MeasurementTimeWindowsConfig provides a set of indicated time window(s) which is configured for the target device to perform measurements on indicated DL-PRS Resource Set(s) occurring within indicated time window(s).","paragraph_zero_based":411},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":413},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig-r18 ::=","paragraph_zero_based":414},{"literal_text_all_w_t_and_m_t":"SEQUENCE (SIZE(1..2)) OF","paragraph_zero_based":415},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfigElement-r18","paragraph_zero_based":416},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":417},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfigElement-r18 ::= SEQUENCE {","paragraph_zero_based":418},{"literal_text_all_w_t_and_m_t":"nr-StartSFN-TimeWindow-r18INTEGER (0..1023),","paragraph_zero_based":419},{"literal_text_all_w_t_and_m_t":"nr-PeriodicOrOneShotTimeWindow-r18 CHOICE {","paragraph_zero_based":420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":421},{"literal_text_all_w_t_and_m_t":"nr-PeriodicityAndSlotOffsetTimeWindow-r18","paragraph_zero_based":422},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-Periodicity-and-ResourceSetSlotOffset-r16,","paragraph_zero_based":423},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":424},{"literal_text_all_w_t_and_m_t":"nr-OneShotSlotOffsetTimeWindow-r18 CHOICE {","paragraph_zero_based":425},{"literal_text_all_w_t_and_m_t":"    scs15-r18                      INTEGER (0..10239),","paragraph_zero_based":426},{"literal_text_all_w_t_and_m_t":"    scs30-r18                      INTEGER (0..20479),","paragraph_zero_based":427},{"literal_text_all_w_t_and_m_t":"    scs60-r18                      INTEGER (0..40959),","paragraph_zero_based":428},{"literal_text_all_w_t_and_m_t":"    scs120-r18                     INTEGER (0..81919)","paragraph_zero_based":429},{"literal_text_all_w_t_and_m_t":"} ","paragraph_zero_based":430},{"literal_text_all_w_t_and_m_t":"} OPTIONAL, -- Need ON","paragraph_zero_based":431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["8f6861ccdd480273b52b9baf10972fa5b180212e44467fdded1fec46c99da861","52a4fad6ecaadcea5bc27ebf695dd0ba81377e14a62de54d6b24c813252fc82b","eb4bbde97b38f37737f14a023e4800ef1b1024f97570de0bf4880afb6192d7c0","fb09ece048887536aebcd1fbf8efb17960e87fd5a62ffb5618bd310e105524e7","b286c450461eb440fa495061af87460c76a8001dc46f5b5119db1696a9563410","27bf5ffe70d5829b3cb375372114448ba330906ab20af7ab53f4202d15be3728","ebb38ae74137d6e98d58e8b07437b36f170fce6fce89c6a36a6a609bf73817f4","d84c178fa17c0f2635d3240d0b0448648eb44a70cf2da8e34f21abc7caa4f135","c4891b8219a66ab455a0b2596ea3509eece32c3c53c99e47bf40712316e0812f","d5f126512d09060157adf6a184371c349b5bf112e9b277c69ef032d34f9dd454","2c545590da625b596623348b0d919fc0667c3ef5452fdb3ee27b11c51e4045cd","8fa48902e3624bb2791d494433f86b0c8b3a52c6a2c97e6003fbc9c4da75e370","1a50f262accc3a6c469c1d21ae499010f96b5885ab11846dc4ea6ef5634bae58","c200b64ef8eed261757faa96777bb24963d3efb8af2ce4d1f52287b6387142d5","bd426c145f35eeaad7b5bd207f2ec629859c9