{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the length of each geographic zone.","paragraph_zero_based":47496},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47497},{"literal_text_all_w_t_and_m_t":"–SLRB-Uu-ConfigIndex","paragraph_zero_based":47498},{"literal_text_all_w_t_and_m_t":"The IE SLRB-Uu-ConfigIndex is used to identify a sidelink DRB configuration from the network side.","paragraph_zero_based":47499},{"literal_text_all_w_t_and_m_t":"SLRB-Uu-ConfigIndex information element","paragraph_zero_based":47500},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47501},{"literal_text_all_w_t_and_m_t":"-- TAG-SLRB-UU-CONFIGINDEX-START","paragraph_zero_based":47502},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47503},{"literal_text_all_w_t_and_m_t":"SLRB-Uu-ConfigIndex-r16 ::=                    INTEGER (1..maxNrofSLRB-r16)","paragraph_zero_based":47504},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47505},{"literal_text_all_w_t_and_m_t":"-- TAG-SLRB-UU-CONFIGINDEX-STOP","paragraph_zero_based":47506},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47507},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47508},{"literal_text_all_w_t_and_m_t":"6.3.6MBS information elements","paragraph_zero_based":47509},{"literal_text_all_w_t_and_m_t":"–CarrierFreqListMBS","paragraph_zero_based":47510},{"literal_text_all_w_t_and_m_t":"The IE CarrierFreqListMBS is used to inform network of the frequencies on which the UE is receiving or interested to receive MBS broadcast service via a broadcast MRB.","paragraph_zero_based":47511},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS information element","paragraph_zero_based":47512},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47513},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERFREQLISTMBS-START","paragraph_zero_based":47514},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47515},{"literal_text_all_w_t_and_m_t":"CarrierFreqListMBS-r17 ::=      SEQUENCE (SIZE (1..maxFreqMBS-r17)) OF ARFCN-ValueNR","paragraph_zero_based":47516},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47517},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERFREQLISTMBS-STOP","paragraph_zero_based":47518},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47519}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5ce1a09f28ef982712a000aaeb3601dc94ad00c9c03e5515c4daf96ea62ea403","06a559540b32091863fdffd9cb2aae1f8fafc9c32ff8a0b4d9c46a3529c19245","910fb3d0b7cb44c002d661c0917915f21970fdd0a8be74b840d31e99f2207388","9f949d7ee13717020699de040ef67bbd9c470d3fd24cc436f9fc005d3b75409b","7e6326ad75545f81d882baa09386d3a9fd3f1ae2f6fe8fb7006e1503acf12112","e4218110b597ce357095ecb19c9abfa559566aaf600cb591e3579ab2664a594e","4448d34ca285942d97fb8b270a8d117af171ebb2593aa7e8cca01e594a841e5b","a72f9150ee8e994ce10c8d52232c62bc88c6c882a67c420cfc57f239f83cb9df","a979a0fff848b3b2678302eb4d9c07de5cf857d0f6dc889a28334c6ce3ecb84e","0c64c08bb9ebbff585e2c8e081bb884654a1d36bc9e7ce40cefee9b473842fe5","4618ec111fc5a377828c70edb7dfbb59ea06efe6ab6e11d877a707754f506a26","d025070ed16e74244f97b24179aa61b685cca10e48a28c77cde70fc319b606b2","b22e3246aab0ede32dc9f0f0c4bbaec7d83fb15b67803c561da935fa790227d2","539c6728bdf0cb8764beb911d9ff45a7503bf461db7764d88dfc8b9e69610157","75c17498cc07393a80099ab387cb889b24f2da4f2c9aed61a445737546ad9aaf","d08700f39abc0833bf4daf85cf6ec94a4b761e7f7f4be87931210f226a408a0d","3920dc42fd06f7a542257c19bcc5edf48808e9b18ccd7c4c5a69e01d2959c072","a850df67de3b