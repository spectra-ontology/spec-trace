{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18264},{"literal_text_all_w_t_and_m_t":"-- TAG-ATG-CONFIG-STOP","paragraph_zero_based":18265},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18267},{"literal_text_all_w_t_and_m_t":"ATG-Config field descriptions","paragraph_zero_based":18268},{"literal_text_all_w_t_and_m_t":"atg-gNB-Location","paragraph_zero_based":18269},{"literal_text_all_w_t_and_m_t":"Indicates the BS location for ATG access.","paragraph_zero_based":18270},{"literal_text_all_w_t_and_m_t":"cellSpecificKoffset","paragraph_zero_based":18271},{"literal_text_all_w_t_and_m_t":"Scheduling offset used for the timing relationships that are modified for ATG. Unit in slot.","paragraph_zero_based":18272},{"literal_text_all_w_t_and_m_t":"heightgNB","paragraph_zero_based":18273},{"literal_text_all_w_t_and_m_t":"Indicates the height of the BS for ATG access relative to the sea level. Unit in meter.","paragraph_zero_based":18274},{"literal_text_all_w_t_and_m_t":"ta-ReportATG","paragraph_zero_based":18275},{"literal_text_all_w_t_and_m_t":"When this field is included in SIB22, it indicates reporting of timing advanced is enabled during Random Access due to RRC connection establishment or RRC connection resume, and during RRC connection reestablishment. When this field is included in ServingCellConfigCommon within dedicated signalling, it indicates TA reporting is enabled during Random Access due to reconfiguration with sync (see TS 38.321 [3], clause 5.4.8).","paragraph_zero_based":18276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18277},{"literal_text_all_w_t_and_m_t":"–AvailabilityCombinationsPerCell","paragraph_zero_based":18278},{"literal_text_all_w_t_and_m_t":"The IE AvailabilityCombinationsPerCell is used to configure the AvailabilityCombinations applicable for a cell of the IAB DU (see TS 38.213 [13], clause 14). Note that the IE AvailabilityCombinationsPerCellIndex can only be configured up to 511.","paragraph_zero_based":18279},{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationsPerCell information element","paragraph_zero_based":18280},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18281},{"literal_text_all_w_t_and_m_t":"-- TAG-AVAILABILITYCOMBINATIONSPERCELL-START","paragraph_zero_based":18282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18283},{"literal_text_all_w_t_and_m_t":"AvailabilityCombinationsPerCell-r16 ::=     SEQUENCE {","paragraph_zero_based":18284},{"literal_text_all_w_t_and_m_t":"    availabilityCombinationsPerCellIndex-r16     AvailabilityCombinationsPerCellIndex-r16,","paragraph_zero_based":18285},{"literal_text_all_w_t_and_m_t":"    iab-DU-CellIdentity-r16                      CellIdentity,","paragraph_zero_based":18286},{"literal_text_all_w_t_and_m_t":"    positionInDCI-AI-r16                         INTEGER(0..maxAI-DCI-PayloadSize-1-r16)                              OPTIONAL, -- Need M","paragraph_zero_based":18287}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5a77edb878e69d5fdaa6752beaa790f1e1a42438fec3d0d2b182660e139d3c0d","55e9420ceae60822403640d4abd24dd76556c333f70a3e7b41798d6fcbdac9a4","6ade45a7eaf70fe71b0c1225516be41da76238dab1c90f6d85b8fc4a211e82c1","11a0e260cf8fed1545068c4e782d77b8350238d5e4e9c58e32dad7d15751c191","8fb230e7b9b4996196586fbc300c4bfdfab27a5b69fa23f9672e9560c1460b05","7bf308b55649c77dc4ea885c19731deffa9077762b410c9a052dbdab089e6569","4a8764423fe08a77c8