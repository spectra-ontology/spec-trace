824d04","eb3f5fdf84c41b26911faad97b9cf022abdddceb2a8b3fff9059a0512238dbc1","c9dbe9e2fdb0b0ecb642f440c653fa9c6140e188de914cf2d3750f89a5af673d","c76d0b9c3030715d3576aa6da9c23ebfb6e93b614b0596f0927005f1825f2fb8","ff559d83d98199eebd4b8ef536767569d4b3d485cbdd462ec99014c6619cc081","1117affb206701f9e6b0d94ae37319cb156d539bb1ef14fea4eb5cba32011467","8244cb8b5a5b3827a14fa6e2363bac13606e3ec8dc2bedb17966f9c707ccd955","4535135b42ce17d2dd25da593cdaf7865fa96a12f8e1ca0b35424db3910713c5","4467461110af4396393b1456c5a1b5169d112ccf83dec719185180ab18d3feee","d354eb05e4ae93592da1df0946bdd16faa5dfe15485524c30e73a1cb3e20ac8d","3c13f826cb9dfefa1c6da4bd6fe031499a319efd23a15e003d1df73a45197af9"],"paragraph_range_zero_based":[28128,28151],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28128"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-PHYSICALCELLGROUPCONFIG-STOP","paragraph_zero_based":28152},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28154},{"literal_text_all_w_t_and_m_t":"PhysicalCellGroupConfig field descriptions","paragraph_zero_based":28155},{"literal_text_all_w_t_and_m_t":"ackNackFeedbackMode","paragraph_zero_based":28156},{"literal_text_all_w_t_and_m_t":"Indicates which among the joint and separate ACK/NACK feedback modes to use within a slot as specified in TS 38.213 [13] (clause 9).","paragraph_zero_based":28157},{"literal_text_all_w_t_and_m_t":"bdFactorR","paragraph_zero_based":28158},{"literal_text_all_w_t_and_m_t":"Parameter for determining and distributing the maximum numbers of BD/CCE for mPDCCH based mPDSCH transmission as specified in TS 38.213 [13] Clause 10.1.","paragraph_zero_based":28159},{"literal_text_all_w_t_and_m_t":"cs-RNTI","paragraph_zero_based":28160},{"literal_text_all_w_t_and_m_t":"RNTI value for downlink SPS (see SPS-Config) and uplink configured grant (see ConfiguredGrantConfig).","paragraph_zero_based":28161},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-0-2","paragraph_zero_based":28162},{"literal_text_all_w_t_and_m_t":"Indicates if \"Downlink assignment index\" is present or absent in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is absent, then 0 bit for \"Downlink assignment index\" in DCI format 0_2. If the field \"downlinkAssignmentIndexDCI-0-2\" is present, then the bitwidth of \"Downlink assignment index\" in DCI format 0_2 is defined in the same was as that in DCI format 0_1 (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":28163},{"literal_text_all_w_t_and_m_t":"downlinkAssignmentIndexDCI-1-2","paragraph_zero_based":28164},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for \"Downlink assignment index\" in DCI format 1_2. If the field is absent, then 0 bit is applied for \"Downlink assignment index\" in DCI format 1_2. Note that 1 bit and 2 bits are applied if only one serving cell is configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic. 4 bits is applied if more than one serving cell are configured in the DL and pdsch-HARQ-ACK-Codebook is set to dynamic (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 9.1).","paragraph_zero_based":28165},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH","paragraph_zero_based":28166},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUCCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUCCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clause 9.1.2.1). If the field harq-ACK SpatialBundlingPUCCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUCCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":28167},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUCCH-secondaryPUCCHgroup","paragraph_zero_based":28168},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clause 9.1.2.1). When the field is absent, the use of spatial bundling of PUCCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUCCH. See TS 38.213 [13], clause 9.1.2.1. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":28169},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH","paragraph_zero_based":28170},{"literal_text_all_w_t_and_m_t":"Enables spatial bundling of HARQ ACKs. It is configured per cell group (i.e. for all the cells within the cell group) for PUSCH reporting of HARQ-ACK. It is only applicable when more than 4 layers are possible to schedule. When the field is absent, the spatial bundling of PUSCH HARQ ACKs for the primary PUCCH group is disabled (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). If the field harq-ACK SpatialBundlingPUSCH-secondaryPUCCHgroup is present, harq-ACK-SpatialBundlingPUSCH is only applied to primary PUCCH group. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":28171},{"literal_text_all_w_t_and_m_t":"harq-ACK-SpatialBundlingPUSCH-secondaryPUCCHgroup","paragraph_zero_based":28172},{"literal_text_all_w_t_and_m_t":"Indicates whether spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is enabled or disabled. The field is only applicable when more than 4 layers are possible to schedule (see TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2). When the field is absent, the use of spatial bundling of PUSCH HARQ ACKs for the secondary PUCCH group is indicated by harq-ACK-SpatialBundlingPUSCH. See TS 38.213 [13], clauses 9.1.2.2 and 9.1.3.2. Network does not configure for a UE both spatial bundling of HARQ ACKs and codeBlockGroupTransmission within the same cell group.","paragraph_zero_based":28173},{"literal_text_all_w_t_and_m_t":"intraBandNC-PRACH-simulTx","paragraph_zero_based":28174},{"literal_text_all_w_t_and_m_t":"Enables parallel PRACH and SRS/PUCCH/PUSCH transmissions across CCs in intra-band non-contiguous CA (see TS 38.213 [13], clause 8.1 and TS 38.214 [19], clause 6.2.1). This field is absent in the IE CellGroupConfig when provided as part of RRCSetup message.","paragraph_zero_based":28175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["61072e21181cdbe5a206f0be9b843699df59f50ab5c1091babded73a17a1e08f","1452ffb6e0166b1887c9ffce6ef82ea751cd574137ac2b0ac926aa59901c4de9","4a5f7b347a87b3d3ccff3d3c2512510975f2432df93bc01da8babd2271912971","7d1fd35778f0b46f430b86ed97327e5aa42248789aa0f279b6dd56c7b96a1f0a","5e272b5bbf80b9575fe09cdb66e40682edc3bcf3bac42b505a32110b9b46f958","82c570e6718de9ddf42c00c3d435eda1e5d24cd9d1bf95e6667fc9c1b8bba783","0e09e9db2efa5cb65c8a0c9937b575bb12dbd703e1bbad72ee8a316e238db8bb","42a1153d48aa290b3fb61b3bee29b44971872f38006f6f009ade24495912a0dc","a84a2a945df7bca105eca8778123aa9c9144f28c97f34a609a02e4727c323673","732b4834353acfa1f6e3af2baed6ccb5de79ca093a41f199d79ddb75fd54bb79","f0a7c91ab6d6bfab8f87ad5bce7c6817bacf6910f93ec4fdec1567de28161437","101245b128eea252bf83f700012baa6adbfa8ac320dad170d3b6b3bf672b5007","b84cc8e6b16b3f2bdef5490891f65df8d20cadc6840e9b0380b8370a2f236840","3dd77678e04b3429b66a2a019377deb602d853d4a96b0a06834d6f3ce807408f","211858d7df6e962e41b4ba8c1a27847f921d4ba1a639dcbef3e4cea08c5c91b8","11034652d22394e146ad84686c92e1df979ab50b8e3dd8ff193390491a8d1a77","8899d1a14329d649f7a6e68a1ed9e81069ba776a100e9e8cde703c21b9aa4b7c","2781cd0774c0c42d843bb24daa795f94133dc554e5c2484a0b0e70becd33a417","acd99f79c64d8183d0c986fe34919bf98e64a5625e844490ad28e5b85c02c3d8","5ebe906a28f807a8c2488f0358a2d2d1ed23ee4260234d8d3c3486bdd37482aa","4e47210819aea6389823817e5ce4f42f9ca901f7b2044461453a663bd90848f6","ab0754d0bc3e01310b8b8b0043c20bfe665dfef6f59cd1dd9f80c772cb407069","91dacdb08bbb8d7062c7e136b3595d1108e0b3d7c13300aedf54b0b49fbc9828","110148aa8c9d1c1c6268f0c0dabbf9912e565fb5fdb234c5739d82d128be0d62"],"paragraph_range_zero_based":[28152,28175],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28152"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"mcs-C-RNTI","paragraph_zero_based":28176},{"literal_text_all_w_t_and_m_t":"RNTI to indicate use of qam64LowSE for grant-based transmissions. When the mcs-C-RNTI is configured, RNTI scrambling of DCI CRC is used to choose the corresponding MCS table.","paragraph_zero_based":28177},{"literal_text_all_w_t_and_m_t":"ncr-RNTI","paragraph_zero_based":28178},{"literal_text_all_w_t_and_m_t":"RNTI value for NCR-MT, used to scramble the PDCCHs carrying side control information (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":28179},{"literal_text_all_w_t_and_m_t":"nfi-TotalDAI-Included","paragraph_zero_based":28180},{"literal_text_all_w_t_and_m_t":"Indicates whether the NFI and total DAI fields of the non-scheduled PDSCH group is included in the non-fallback DL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":28181},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR1","paragraph_zero_based":28182},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 1 (FR1) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":28183},{"literal_text_all_w_t_and_m_t":"nrdc-PCmode-FR2","paragraph_zero_based":28184},{"literal_text_all_w_t_and_m_t":"Indicates the uplink power sharing mode that the UE uses in NR-DC in frequency range 2 (FR2) (see TS 38.213 [13], clause 7.6).","paragraph_zero_based":28185},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetection, pdcch-BlindDetection2, pdcch-BlindDetection3, pdcch-BlindDetection4","paragraph_zero_based":28186},{"literal_text_all_w_t_and_m_t":"Indicates the reference number of cells for PDCCH blind detection for the CG. Network configures the field for each CG when the UE is in NR DC and sets the value in accordance with the constraints specified in TS 38.213 [13]. The network configures pdcch-BlindDetection only if the UE is in NR-DC. The network configures pdcch-BlindDetection2 only if the UE is in NR-DC with at least one downlink cell using Rel-16 PDCCH monitoring capability. The network configures pdcch-BlindDetection3 only if the UE is in NR-DC with at least one downlink cell using Rel-15 PDCCH monitoring capability. The network configures pdcch-BlindDetection4 only if the UE is in NR-DC with at least one downlink cell using Rel-17 PDCCH monitoring capability.","paragraph_zero_based":28187},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator","paragraph_zero_based":28188},{"literal_text_all_w_t_and_m_t":"Configure one combination of pdcch-BlindDetectionCA1 (for R15) and pdcch-BlindDetectionCA2 (for R16) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 as UE capability. The combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 configured by pdcch-BlindDetectionCA-CombIndicator is from the more than one combination of pdcch-BlindDetectionCA1 and pdcch-BlindDetectionCA2 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":28189},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r17 is used to configure one combination of pdcch-BlindDetectionCA1 (for R15), pdcch-BlindDetectionCA2 (for R16) and pdcch-BlindDetectionCA3 (for R17) for UE to use for scaling PDCCH monitoring capability if the number of serving cells configured to a UE is larger than the reported capability, and if UE reports more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 as UE capability. The combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 configured by pdcch-BlindDetectionCA-CombIndicator-r17 is from the more than one combination of pdcch-BlindDetectionCA1, pdcch-BlindDetectionCA2 and pdcch-BlindDetectionCA3 reported by UE (see TS 38.213 [13], clause 10).","paragraph_zero_based":28190},{"literal_text_all_w_t_and_m_t":"pdcch-BlindDetectionCA-CombIndicator-r16 and pdcch-BlindDetectionCA-CombIndicator-r17 are not configured simultaneously.","paragraph_zero_based":28191},{"literal_text_all_w_t_and_m_t":"p-NR-FR1","paragraph_zero_based":28192},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 1 (FR1). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR1 (configured total for all serving cells operating on FR1).","paragraph_zero_based":28193},{"literal_text_all_w_t_and_m_t":"p-NR-FR2","paragraph_zero_based":28194},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE in this NR cell group across all serving cells in frequency range 2 (FR2). The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-UE-FR2 (configured total for all serving cells operating on FR2). This field is only used in NR-DC. A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":28195},{"literal_text_all_w_t_and_m_t":"prioLowDG-HighCG","paragraph_zero_based":28196},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where low-priority dynamic grant-PUSCH collides with high-priority configured grant-PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":28197},{"literal_text_all_w_t_and_m_t":"prioHighDG-LowCG","paragraph_zero_based":28198},{"literal_text_all_w_t_and_m_t":"Enable PHY prioritization for the case where high-priority dynamic grant PUSCH collides with low-priority configured grant PUSCH on a BWP of a serving cell (see TS 38.213 [13], clause 9), when the UE has generated transport blocks for both DG-PUSCH and CG-PUSCH as described in TS 38.321 [3].","paragraph_zero_based":28199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0d09ee10841353c16d8dd6b4e8688287b2d1fd6ce1ac84445013113e65cab05c","1353dd835d753b344a042c04e578f8c1a6ce52740d2a0896f04430ef07cd04a4","d287fe24b2c52b775ec2e0329dc4c95a4fe0691054e77400bc749d228a63cd28","7f6c8ea7ee4d1745803190222a828f0bdbf00912cc09784b3597bc3eb5b8448a","73e8af7485e4c86cedc5cfb1aee110f80d65a813b22327c57d2ab9e947ce77ff","7092e66c07c29aa5b165882e1f81c642ed77b25d767e2259675e1de059b433f2","cada1c0cf652087cffb16dfb98d55d966103ea114013f12bbc3a68d0b99b3f04","e507c537f3588d364a599e53e84719d5056d76f6fa658a6859e5b7193f7f1543","af291a5bca051b23120e38ff0e84b3b95dffd775b09a6efcbc440b02cd5c8b8b","785228ea4770e67379c59ae8bf9acbf970348453302287b31ac513a9f21237a2","56eb51e1a253c61ed29099e704a11d41a87e7a12334d88de841086d5a1f56a5a","bb474c4de7c73768bb01fab71a8f7eaa4a00f9ec6d5050fd765470f61ada8e7c","37b84d308e5d3f6ddd73d2f526c00122356319f77d4182e687564a1eaf3af1c0","4f2b9d9d6544a9631a8320debc2c57c877e0b376218449eb8bb85fa2f405c4fc","31c67fef3ccb04d8422b60f461c7d069b31ab4e24a3cd101099391967f41a438","ce591bd9a2f8b02edeb1262b9a2f419e7387a9324330af167e535e8268287d51","9ce1c8ce9efeb96ec13bf60d103695ba395afc807c888f51a784cd833a269f90","31405c247aa57377bfe23e2ec0c5f9c26b0d5610700ac2596fa18a2efbe8c618","5525016d0c3fde9a805a351cac05c120dc2bc96ec9cdc1d25f748ca02a56bef6","9c046ab8ac86d3132930cb80acb80f08f68ce5b215e8032711f3c7305d0702e7","2d03d435ffb73e0f9bc43bd69fcd6f0e1a26253dcd4da1bd9d9f8794428b6ec9","a3f3f6e1aead39dcdb0601b33ecae1a79e6df83056f577c261109bace591164a","dcfe5050f2e424538ba3b81d7d640459a2c7ba21cdf248c02db61b3995398d72","7b3edf013916d1c11b37781924671599ce6854fe11b5642c1accfaa5bb052115"],"paragraph_range_zero_based":[28176,28199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28176"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ps-RNTI","paragraph_zero_based":28200},{"literal_text_all_w_t_and_m_t":"RNTI value for scrambling CRC of DCI format 2-6 used for power saving (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":28201},{"literal_text_all_w_t_and_m_t":"ps-Offset","paragraph_zero_based":28202},{"literal_text_all_w_t_and_m_t":"The start of the search-time of DCI format 2-6 with CRC scrambled by PS-RNTI relative to the start of the drx-onDurationTimer of Long DRX (see TS 38.213 [13], clause 10.3). Value in multiples of 0.125ms (milliseconds). 1 corresponds to 0.125 ms, 2 corresponds to 0.25 ms, 3 corresponds to 0.375 ms and so on.","paragraph_zero_based":28203},{"literal_text_all_w_t_and_m_t":"ps-WakeUp","paragraph_zero_based":28204},{"literal_text_all_w_t_and_m_t":"Indicates the UE to wake-up if DCI format 2-6 is not detected outside active time (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not wake-up if DCI format 2-6 is not detected outside active time.","paragraph_zero_based":28205},{"literal_text_all_w_t_and_m_t":"ps-PositionDCI-2-6","paragraph_zero_based":28206},{"literal_text_all_w_t_and_m_t":"Starting position of UE wakeup and SCell dormancy indication in DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":28207},{"literal_text_all_w_t_and_m_t":"ps-TransmitPeriodicL1-RSRP","paragraph_zero_based":28208},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic L1-RSRP report(s) when the drx-onDurationTimer does not start.","paragraph_zero_based":28209},{"literal_text_all_w_t_and_m_t":"ps-TransmitOtherPeriodicCSI","paragraph_zero_based":28210},{"literal_text_all_w_t_and_m_t":"Indicates the UE to transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start (see TS 38.321 [3], clause 5.7). If the field is absent, the UE does not transmit periodic CSI report(s) other than L1-RSRP reports when the drx-onDurationTimer does not start.","paragraph_zero_based":28211},{"literal_text_all_w_t_and_m_t":"p-UE-FR1","paragraph_zero_based":28212},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 1 (FR1) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR1 (configured for the cell group).","paragraph_zero_based":28213},{"literal_text_all_w_t_and_m_t":"p-UE-FR2","paragraph_zero_based":28214},{"literal_text_all_w_t_and_m_t":"The maximum total transmit power to be used by the UE across all serving cells in frequency range 2 (FR2) across all cell groups. The maximum transmit power that the UE may use may be additionally limited by p-Max (configured in FrequencyInfoUL) and by p-NR-FR2 (configured for the cell group). A UE does not expect to be configured with this parameter in this release of the specification.","paragraph_zero_based":28215},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook","paragraph_zero_based":28216},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to both CA and non-CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). If pdsch-HARQ-ACK-Codebook-r16 is signalled, UE shall ignore the pdsch-HARQ-ACK-Codebook (without suffix). For the HARQ-ACK for sidelink, if pdsch-HARQ-ACK-Codebook-r16 is signalled, the UE uses pdsch-HARQ-ACK-Codebook (without suffix) and ignores pdsch-HARQ-ACK-Codebook-r16. If the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary PUCCH group. Otherwise, this field is applied to the cell group (i.e. for all the cells within the cell group). For the HARQ-ACK for sidelink, if the field pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup is present, pdsch-HARQ-ACK-Codebook is applied to primary and secondary PUCCH group and the UE ignores pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup.","paragraph_zero_based":28217},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookList","paragraph_zero_based":28218},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured). For the HARQ-ACK for sidelink, the UE uses pdsch-HARQ-ACK-Codebook and ignores pdsch-HARQ-ACK-CodebookList if this field is present.","paragraph_zero_based":28219},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Codebook-secondaryPUCCHgroup","paragraph_zero_based":28220},{"literal_text_all_w_t_and_m_t":"The PDSCH HARQ-ACK codebook is either semi-static or dynamic. This is applicable to CA operation (see TS 38.213 [13], clauses 9.1.2 and 9.1.3). It is configured for secondary PUCCH group.","paragraph_zero_based":28221},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3DCI-Field, pdsch-HARQ-ACK-EnhType3DCI-FieldSecondaryPUCCHgroup","paragraph_zero_based":28222},{"literal_text_all_w_t_and_m_t":"Indicates the enhanced Type 3 codebook through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in the primary PUCCH group if the more than one enhanced Type 3 HARQ-ACK codebook is configured for the primary PUCCH group, or in the secondary PUCCH group if the more than one enhanced Type 3 HARQ-ACK code is configured for the secondary PUCCH group, respectively.","paragraph_zero_based":28223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["18f58ad69ce519aeaeff9b14cf368dc8a3d63d751632ecb2c56726c0fdd42747","cd7094e64313ae148b432d3766865cdff28aed38fe18827310a29e4ac55ecd01","a62bec872183368d490cfdc07d62d5b94fadd541294ff5598b2989f39bbbcf19","f4660e3a8d0c8bdf9f4eab2daa536454e9b5264d808a5c3a2fba0a4839c57f30","6242e81a6abaf241de88474d86547aeb7aa0fbf9eb34e54f847cae1d093574fa","8637a5a8e6086ecb4dd0e29f81837c63b4277d52dc9cb00f13898028fb59503d","ff123d6593727393acd568d8b8264d0b478d69c2895f6986f4de8c2492ba71c3","b4c678a50b441775e5aa5c2aed042dd5002e0a5d761cd84fe3e2d1962d61d75f","6fcae5cc78c45dc73f3ef28f1a22c0cb029b167e6a624ab28d5197434b9c739f","302c636637e99f1afa88ecd2e2934f6c1f7dcaa4d16d58b6b2525b78357b6c69","d29fad98537e15a2e4c13b20b83772529cec076a44dd69ae49d187c4c9c06cae","53f86ca126141fefc93f1c279429e783cb6ac1af4a859f7c24cbc606566409ce","e815d2a16a6b1ae07fe01604b1275cf912ca5b0126bae65dcda756765b81b9ae","67436de37d66cd2522b4f5c8e18ae45954a64aa46c96fdff2ef11ee9226e1db1","0151fb5ba7e69bb02be2f7f45b9749b646c6a3f75026ae93d4ba3ac3d84e776a","c350a2422a0336269b641dd19a37634746dbbf8126d8601d54a591237a7d8d53","d643c96f7afcba087f1a7cd7209244a5c037e064d926f2a86658c5d88db863c0","1342a3db8a5c4bc094f4156bdc0f92bd0abf9a6f54f33b34cf8c76df23dc1e16","071cff7bf5b7b16d96725263bbb022168c246803d0262ebf8a32c355fde8af40","4bb5c391b5b52c6a716a1a8a752e46306009c9d3837226244857a7f3b1df843f","5f5d173cd7f7e4bdc516cb62d6e11fd0f1c36f67831752a5fd9edf8971253b2b","3a4235e54ed11c1c83dd02061a04af9c2ad5fb7c59ecf04773559efb7442d372","c072d71a243bdd34363ad8dd523a676e0cc65c9bf50a269e22701ff765402f66","e13e95dd89cd1aae1592f4d125eee15d7457e27ab03ead4d4ec3e4e14f1ea803"],"paragraph_range_zero_based":[28200,28223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28200"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3ToAddModList, pdsch-HARQ-ACK-EnhType3SecondaryToAddModList","paragraph_zero_based":28224},{"literal_text_all_w_t_and_m_t":"Configure the list of enhanced Type 3 HARQ-ACK codebooks for the primary PUCCH group and the secondary PUCCH group, respectively. When configured, DCI format 1_1 can request the UE to report A/N for one of the configured enhanced Type 3 HARQ-ACK codebooks in the corresponding PUCCH group (see TS 38.213 [13], clause 9.1.4). The network can configure pdsch-HARQ-ACK-EnhType3SecondaryToAddModList only if secondary PUCCH group is configured.","paragraph_zero_based":28225},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedback","paragraph_zero_based":28226},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group (see TS 38.212 [17], clause 7.3.1).","paragraph_zero_based":28227},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackCBG","paragraph_zero_based":28228},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include CBG level A/N for each CC with CBG level transmission configured. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":28229},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackNDI","paragraph_zero_based":28230},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to include NDI for each A/N reported. The network configures this only when pdsch-HARQ-ACK-OneShotFeedback is configured.","paragraph_zero_based":28231},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-Retx, pdsch-HARQ-ACK-RetxSecondaryPUCCHgroup","paragraph_zero_based":28232},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource in the primary PUCCH group and the secondary PUCCH group, respectively (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":28233},{"literal_text_all_w_t_and_m_t":"pucch-sSCell, pucch-sSCellSecondaryPUCCHgroup","paragraph_zero_based":28234},{"literal_text_all_w_t_and_m_t":"indictates the alternative PUCCH cells for PUCCH cell switching in the primary and the secondary PUCCH group, respectively. For the primary PUCCH group, it is configured for cells on top of SpCell. For the secondary PUCCH group, it is configured for cell on top of the PUCCH SCell.","paragraph_zero_based":28235},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDyn, pucch-sSCellDynsecondaryPUCCHgroup","paragraph_zero_based":28236},{"literal_text_all_w_t_and_m_t":"When configured, PUCCH cell switching based on dynamic indication in DCI format 1_1 is enabled (see TS 38.213 [13], clause 9.A, clause 9.1.5), respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":28237},{"literal_text_all_w_t_and_m_t":"pucch-sSCellPattern, pucch-sSCellPatternSecondaryPUCCHgroup","paragraph_zero_based":28238},{"literal_text_all_w_t_and_m_t":"When configured, the UE applies the semi-static PUCCH cell switching (see TS 38.213 [13], clause 9.A) using the time domain pattern of applicable PUCCH cells indicated by this field, respectively for the primary PUCCH group and the secondary PUCCH group.","paragraph_zero_based":28239},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH, simultaneousPUCCH-PUSCH-SecondaryPUCCHgroup","paragraph_zero_based":28240},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions with different priorities for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":28241},{"literal_text_all_w_t_and_m_t":"simultaneousPUCCH-PUSCH-SamePriority, simultaneousPUCCH-PUSCH-SamePriority-SecondaryPUCCHgroup","paragraph_zero_based":28242},{"literal_text_all_w_t_and_m_t":"Enables simultaneous PUCCH and PUSCH transmissions on different cells in different bands with same prioritiy for the primary PUCCH group and the secondary PUCCH group, respectively, as specified in clause 9 of TS 38.213 [13].","paragraph_zero_based":28243},{"literal_text_all_w_t_and_m_t":"simultaneousSR-PUSCH-diffPUCCH-Groups","paragraph_zero_based":28244},{"literal_text_all_w_t_and_m_t":"Enables simultaneous SR and PUSCH transmissions in different PUCCH groups (see TS 38.321 [3], clause 5.4.1, clause 5.4.4).","paragraph_zero_based":28245},{"literal_text_all_w_t_and_m_t":"sizeDCI-2-6","paragraph_zero_based":28246},{"literal_text_all_w_t_and_m_t":"Size of DCI format 2-6 (see TS 38.213 [13], clause 10.3).","paragraph_zero_based":28247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a05c96e9f1f71dcc7295228201568d8c423ab560ee7b2045c3d5ed2bc3ad5fea","a08dafc3a89b42ef0064c82d97f23374d4eca7fca33c8150a27793efb2f244e1","cb7f961ea5f780e6941f6637d9a4667b1249089664feb57cc2049736ab17a67e","e3421dc7684ac52d763ac7a7f24d23fbe579a284e899e9978c9193442b36ebda","7f1de5f5000c31e0cae610804a06012677adcee9bc153fe07e33794b187cbfb2","73bc1bb945e871d2dad94376776505266108e1caadf07b703af3fac118e5ff7b","0aa26b8792443c39870bbcaefb3453cd41fcbe1d4bc22e37f9f351a92722a0e6","de6f561f70786efb46cfb8fa9b7254d6d88d87c98b4871a05ed7e962708c012e","a760d7c706dae7d09b8166ac3a3acb70324411332b8f2ada2150ec6046276668","bf38de6537cd87d5b036d3034a8e839c876a3e1b2762bacd095d077043bf22da","4d60f383525601f147b45fd20f64266c9f4b3a6de3ca6a4284e12fe795277cbb","e8ad7d9048b3d37b4f369742526968de5cc5ce12fcbf8a4beb2cd3464c5476fd","91a09e3cfdff9022fc8806f3612416052d3f3662948965b57ada85c118b120d3","4a9de31442ea66dc71969c6c9ac46f0ed35a73bc40904a8ef56955591feb2953","31f7f4d71cddad60cdb70057690e023c2c981351f4fabf6be9a41d5ea2370db0","609653a6d73e152398bb6e439e17891d5117349b2707f3708a11dfbcd48636e4","f16ec0b4187147db0302a60233c01e0dec472645bb8d46b6ec074abf90d7b8f4","3c5acdd95678cca56026119bc661515e483754714574ab18701f909fc603d262","7e14a6a078368a8a18ebe154249db228076358c937652dc0adca66e588d6b54c","fb77fda07ecc81fd0fa8af49c69038c6ecea49f9ae69a2a156b62dc1dd2d2b0c","24437f1ba4c1786c7be8cf89f66880e4e45dd76e8a2d9b2fc53fcb629fcb6315","d510b1aec6b46c5cb193ec5e8f9885d861bb5e2c87776871d8fa93443fcc9e61","c2d0d10cc148a3d7c482a3767e0a7dc53fb95fa60b8701ff77980ce828b62ceb","ff89625eec6e2d4155b89a383be096c2ec58b12ee54549a86318d547d37fe9a1"],"paragraph_range_zero_based":[28224,28247],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28224"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sp-CSI-RNTI","paragraph_zero_based":28248},{"literal_text_all_w_t_and_m_t":"RNTI for Semi-Persistent CSI reporting on PUSCH (see CSI-ReportConfig) (see TS 38.214 [19], clause 5.2.1.5.2). Network always configures the UE with a value for this field when at least one CSI-ReportConfig with reportConfigType set to semiPersistentOnPUSCH is configured.","paragraph_zero_based":28249},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH-RNTI","paragraph_zero_based":28250},{"literal_text_all_w_t_and_m_t":"RNTI used for PUCCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":28251},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH-RNTI","paragraph_zero_based":28252},{"literal_text_all_w_t_and_m_t":"RNTI used for PUSCH TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":28253},{"literal_text_all_w_t_and_m_t":"tpc-SRS-RNTI","paragraph_zero_based":28254},{"literal_text_all_w_t_and_m_t":"RNTI used for SRS TPC commands on DCI (see TS 38.213 [13], clause 10.1).","paragraph_zero_based":28255},{"literal_text_all_w_t_and_m_t":"twoQCLTypeDforPDCCHRepetition","paragraph_zero_based":28256},{"literal_text_all_w_t_and_m_t":"Indicates whether a UE is expected UE to identify and monitor two QCL-TypeD properties for multiple overlapping CORESETs in the case of PDCCH repetition.","paragraph_zero_based":28257},{"literal_text_all_w_t_and_m_t":"uci-MuxWithDiffPrio, uci-MuxWithDiffPrio-secondaryPUCCHgroup","paragraph_zero_based":28258},{"literal_text_all_w_t_and_m_t":"When configured, enables multiplexing a high-priority (HP) HARQ-ACK UCI and a low-priority (LP) HARQ-ACK UCI into a PUCCH or PUSCH for the primary PUCCH group and the secondary PUCCH group, respectively.","paragraph_zero_based":28259},{"literal_text_all_w_t_and_m_t":"ul-TotalDAI-Included","paragraph_zero_based":28260},{"literal_text_all_w_t_and_m_t":"Indicates whether the total DAI fields of the additional PDSCH group is included in the non-fallback UL grant DCI (see TS 38.212 [17], clause 7.3.1). The network configures this only when enhanced dynamic codebook is configured (pdsch-HARQ-ACK-Codebook is set to enhancedDynamic).","paragraph_zero_based":28261},{"literal_text_all_w_t_and_m_t":"xScale","paragraph_zero_based":28262},{"literal_text_all_w_t_and_m_t":"The UE is allowed to drop NR only if the power scaling applied to NR results in a difference between scaled and unscaled NR UL of more than xScale dB (see TS 38.213 [13]). If the value is not configured for dynamic power sharing, the UE assumes default value of 6 dB.","paragraph_zero_based":28263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28264},{"literal_text_all_w_t_and_m_t":"MulticastConfig field descriptions","paragraph_zero_based":28265},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-CodebookListMulticast","paragraph_zero_based":28266},{"literal_text_all_w_t_and_m_t":"A list of configurations for one or two HARQ-ACK codebooks for MBS multicast. Each configuration in the list is defined in the same way as pdsch-HARQ-ACK-Codebook (see TS 38.212 [17], clause 7.3.1.2.2 and TS 38.213 [13], clauses 7.2.1, 9.1.2, 9.1.3 and 9.2.1). If this field is present, the field pdsch-HARQ-ACK-Codebook is ignored. If this field is present, the value of this field is applied for primary PUCCH group and for secondary PUCCH group (if configured).","paragraph_zero_based":28267},{"literal_text_all_w_t_and_m_t":"type1CodebookGenerationMode","paragraph_zero_based":28268},{"literal_text_all_w_t_and_m_t":"Indicates the mode of Type-1 HARQ-ACK codebook generation, as specified in TS 38.213 [13]. Mode 1 is based on the k1 values that are in the intersection of K1 set for unicast and K1 set for multicast. Mode 2 is based on the k1 values that are in the union of K1 set for unicast and K1 set for multicast.","paragraph_zero_based":28269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28270},{"literal_text_all_w_t_and_m_t":"PDSCH-HARQ-ACK-EnhType3 field descriptions","paragraph_zero_based":28271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e5d5dd76b9c4c6cf87fa8211c76be644ffbbb9c156eb601e77dcae5d9de3ed30","ae6fe9c9b29955c9429a889d0ab8aad88eb15b8b1a13129626133d31d4c21632","68bc2502a366c8e4702c17718044297a9c6f62e791875520868e4948e41239a2","6ba6c93d3900b11128b4d167fe5cd3b19ff7986a07e42d987ccfb793867d48b6","02330ae6d0c2cfee889900781f1308a83368f9d699fa729c6c95ea349ad0ee4f","1e64c479d29ee85924ecde517e304f2ade597955c309c385f682508654b0ad6a","ea9c7e848dd7f5e432394bb00aa1abb5e5ffc541b239a41c4c4b02a334515879","429326b054738cc17ff407be6fe49e67ce1fc1f185ed7ef525594aa6dfa98526","1599bf309811c7161fff4aceeb87f286b7b7a86c9d76fa0076ba631369c00185","1e7574f667865892701a27fbe7c6443f845c4c89c2ad1cbe27731c65b8d4cc74","5ab2c604b4aa28a069ed5088b64ba750694684899c24107c49aa28be0538ea41","4466eb7fa929bf06b0d7f93d30723585d9ab833e48505d5b04a6e6182630c319","c0f6da4761d9093ef4b8c1edfcb6b85c790f6904d76ee24368699f196495a054","0f8bf4b175afad44b9799144339b586692750e2ee40138a50ea267e9a5b29aab","0728c4de0849298779dfb9d20398d59a778194b33aa52555b176504b72b1399c","7783f48f36675ff0597e8139c9504b430e243c5e02268ebfd4cf6fcb8f975fe2","02141d98c810fc29133b317e1ab0bf3a274c12f26a1219ca2e375f0203f242d2","1ce1f046d84a698124641e595e57c58c06bd41490b1bc23ab868d27a3c6d942a","490ba8e6f7cf997e93678f34aaef7686bf16583ea80da7acbb8b12c85890d94f","b0dcafbe0d4a686dbacfc34e05db1b72341d706d6d8414872f6c09c3ddd05e58","0ae0efa8a09ce2368bbceb33a6d4e34c94226a1a25a5b71852d9971ee0f8be85","bda57987fe2a7f3f1179b8195921f14491e2ce02e49802e46a49f78c3f59811c","02c362a8ccc4a48cae2dc8bf5405bd85cc3b59997974dce0ff2f048c17f8fbfc","d6f73b5cd76b38785bd609d1c8f2ea76a44a8a044c439429e2a9126af0cc93b7"],"paragraph_range_zero_based":[28248,28271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p28248"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3CBG","paragraph_zero_based":28272},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include CBG level A/N for each CC with CBG level transmission configured of the enhanced Type 3 HARQ-ACK codebook. When not configured, the UE will report TB level A/N even if CBG level transmission is configured for a CC.","paragraph_zero_based":28273},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-EnhType3NDI","paragraph_zero_based":28274},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_1 or DCI format 1_2 can request the UE to include NDI for each A/N reported of the enhanced Type 3 HARQ-ACK codebook.","paragraph_zero_based":28275},{"literal_text_all_w_t_and_m_t":"perCC","paragraph_zero_based":28276},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per CC configuration.","paragraph_zero_based":28277},{"literal_text_all_w_t_and_m_t":"perHARQ, perHARQ-Ext","paragraph_zero_based":28278},{"literal_text_all_w_t_and_m_t":"Configures enhanced Type 3 HARQ-ACK codebook using per HARQ process and CC configuration. perHARQ-Ext is present only when nrofHARQ-ProcessesForPDSCH-v1700 is present in pdsch-ServingCellConfig of at least one serving cell in the PUCCH group. If perHARQ-Ext is present, the UE ignores perHARQ.","paragraph_zero_based":28279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28280},{"literal_text_all_w_t_and_m_t":"CellDTRX-DCI-config field descriptions","paragraph_zero_based":28281},{"literal_text_all_w_t_and_m_t":"cellDTRX-RNTI","paragraph_zero_based":28282},{"literal_text_all_w_t_and_m_t":"The RNTI value for scrambling CRC of DCI format 2_9 for activating and/or deactivating Cell DTX/DRX and/or NES mode for CHO indication.","paragraph_zero_based":28283},{"literal_text_all_w_t_and_m_t":"sizeDCI-2-9","paragraph_zero_based":28284},{"literal_text_all_w_t_and_m_t":"The size of DCI format 2_9.","paragraph_zero_based":28285},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28286},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28287},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28288},{"literal_text_all_w_t_and_m_t":"MCG-Only","paragraph_zero_based":28289},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, in the PhysicalCellGroupConfig of the MCG. It is absent otherwise. ","paragraph_zero_based":28290},{"literal_text_all_w_t_and_m_t":"NCR","paragraph_zero_based":28291},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M for NCR-MT. It is absent otherwise.","paragraph_zero_based":28292},{"literal_text_all_w_t_and_m_t":"SCG-Only","paragraph_zero_based":28293},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in the PhysicalCellGroupConfig of the SCG in (NG)EN-DC as defined in TS 38.213 [13]. It is absent otherwise.","paragraph_zero_based":28294},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":28295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f0dab735e4f120fdd36f5dae6d6b140c5c16d086e2af32245a6d58a4457f9448","a9d5a5936657d41f435608bb348bd34fff48503d1bbbf86f5763818cd9bb77e9","0a3413f3730013e04e5d97ce9415eca52e69cdbd650dfe9cc52eca0769b40c53","821abaf5663a01ed44363cbb6bba08c7b23f6d6c8789b6a785deb13e927e59d5","7c2fe6b38a52e4386515ded6273fb460a6c802a7c784ee6bdb7357ea56196147","d1218aac71128d112c1b7a763937abcfcc46f728dafac34868e8ff0903c7e372","eee1d2f96b6a4b3a1f1a