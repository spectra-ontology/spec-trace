{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–EUTRA-NS-PmaxList","paragraph_zero_based":44904},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-NS-PmaxList concerns a list of additionalPmax and additionalSpectrumEmission, as defined in TS 36.101 [22], table 6.2.4-1 for UEs neither in CE nor BL UEs, TS 36.101 [22], table 6.2.4E-1 for UEs in CE or BL UEs, and TS 36.101 [22], table TBD for Aerial UEs,for a given frequency band.","paragraph_zero_based":44905},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList information element","paragraph_zero_based":44906},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44907},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-START","paragraph_zero_based":44908},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44909},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxList ::=               SEQUENCE (SIZE (1..maxEUTRA-NS-Pmax)) OF EUTRA-NS-PmaxValue","paragraph_zero_based":44910},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44911},{"literal_text_all_w_t_and_m_t":"EUTRA-NS-PmaxValue ::=              SEQUENCE {","paragraph_zero_based":44912},{"literal_text_all_w_t_and_m_t":"    additionalPmax                      INTEGER (-30..33)                       OPTIONAL,   -- Need R","paragraph_zero_based":44913},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission          INTEGER (1..288)                        OPTIONAL    -- Need R","paragraph_zero_based":44914},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44915},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44916},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-NS-PMAXLIST-STOP","paragraph_zero_based":44917},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44918},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44919},{"literal_text_all_w_t_and_m_t":"–EUTRA-PhysCellId","paragraph_zero_based":44920},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-PhysCellId is used to indicate the physical layer identity of the cell, as defined in TS 36.211 [31].","paragraph_zero_based":44921},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId information element","paragraph_zero_based":44922},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44923},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-PHYSCELLID-START","paragraph_zero_based":44924},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44925},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellId ::=                        INTEGER (0..503)","paragraph_zero_based":44926},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["302bb97abfef92fe97d7b239c2074defb458eed6b87ce53a15de0f58665513f2","bc4540eb641e41dc7bf0e2024fcd47bcca6c9d8d0857de6eec7979f83de3575a","e422b44b23291d37ee3fa6b41afe4d3ab0d8a2826754d3032956001383704aaf","c1b50b44ac5470c47f0f34197ec478faf9bb751e2cfdcac90f74d1ff24e45195","665e1247ddb90d699fe7246128e7f3358d1a7016acd54f438ab9e49c067fd27e","9ab4187a330515cc0a8f303ba9d2458f57814b53c14c7004f619ff8e0b0b0643","20c1bb47a37c6f4ac417249c36e7f297a2d8afd5f3e188ff2ee12c82c8bf900d","2e6614c45106f9eb2f0bc670631da4ad6af2d3e8b3039ce8b8889164eb12714c","c587b73b9ae4c3bfb4cf677ec05c755922a552c8f5b7547263ca832a6bc0e252","70207adb3bb7ca163eac97d34fbc2fbadc51f51e18c41bae6436b41ad2796580","6cc8f353e5beb5a0ff69d354728403803a2289301f321d0440d2bf7d56614690","fda2074d78c8245bdb2225842d64694597ad7f625c64339b3849b870be6a2b68","c4c2036b32209b0fafc1d178354e54b8fbcfd1b5cd3cf4910331d64c12990