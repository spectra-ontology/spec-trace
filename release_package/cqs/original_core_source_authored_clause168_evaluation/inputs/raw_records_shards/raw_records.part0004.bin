{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierList-r16 ::=   SEQUENCE (SIZE (1..maxNrofTxDC-TwoCarrier-r16)) OF UplinkTxDirectCurrentTwoCarrier-r16","paragraph_zero_based":36168},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36169},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrier-r16 ::=       SEQUENCE {","paragraph_zero_based":36170},{"literal_text_all_w_t_and_m_t":"    carrierOneInfo-r16                            UplinkTxDirectCurrentCarrierInfo-r16,","paragraph_zero_based":36171},{"literal_text_all_w_t_and_m_t":"    carrierTwoInfo-r16                            UplinkTxDirectCurrentCarrierInfo-r16,","paragraph_zero_based":36172},{"literal_text_all_w_t_and_m_t":"    singlePA-TxDirectCurrent-r16                  UplinkTxDirectCurrentTwoCarrierInfo-r16,","paragraph_zero_based":36173},{"literal_text_all_w_t_and_m_t":"    secondPA-TxDirectCurrent-r16                  UplinkTxDirectCurrentTwoCarrierInfo-r16            OPTIONAL","paragraph_zero_based":36174},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36175},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36176},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCarrierInfo-r16 ::=      SEQUENCE {","paragraph_zero_based":36177},{"literal_text_all_w_t_and_m_t":"    servCellIndex-r16                             ServCellIndex,","paragraph_zero_based":36178},{"literal_text_all_w_t_and_m_t":"    servCellInfo-r16                              CHOICE {","paragraph_zero_based":36179},{"literal_text_all_w_t_and_m_t":"        bwp-Id-r16                                    BWP-Id,","paragraph_zero_based":36180},{"literal_text_all_w_t_and_m_t":"        deactivatedCarrier-r16                        ENUMERATED {deactivated}","paragraph_zero_based":36181},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":36182},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36183},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36184},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo-r16 ::=   SEQUENCE {","paragraph_zero_based":36185},{"literal_text_all_w_t_and_m_t":"    referenceCarrierIndex-r16                     ServCellIndex,","paragraph_zero_based":36186},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz-r16                             BOOLEAN,","paragraph_zero_based":36187},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation-r16                   INTEGER (0..3301)","paragraph_zero_based":36188},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36189},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36190},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTTWOCARRIERLIST-STOP","paragraph_zero_based":36191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3b78a801005ef169f97aaf46cbb3075be0ef4b91751982f2c25162bf13e52de5","4ab3610fcb192f48c1d17658d6c152386fef4b407a458ed8229986d10a53cb30","5640e81e440c51b2fd45df948541691cfe5ac92d8401340364e26bd13a30cc78","42d2047141def4c4718308942bd6a43ddd45e4c3d426d39d2e83894297993e3a","4b27aef379a2f5815600efe6cb04a57e6e3665cdc619a08eef79dfc60bc622c1","bf379c03ba5e59d22c93b46117b01b0c444c639ac04f518c03cfed3088f7c0b4","ee6a025261c9fc95d84cd5c65dda7b82102d9bfbb32525f0070db6258233682c","648dc16586255deec29bfaafb9b5e35c3772aac1d48620c947bcf239514ccf03","8389de1705319c8060a59a99b0df2b394a68137bf9d4a226e98ce995413bb659","74a8484c89bf10ba58dc4dd5e02a1357a728c74527c95b37f29d67bbe454fa7a","b18b3467421f77f84a8dc901ea9837fa8f62dbdbfe5a71651a909df26b75749b","bed1199eb05978122f5572774bb303a813585ab11ac0ec68f50ca182c16bd1b5","5a5d380a08d32ecabb348b74a7703d2bf7649c3c13ea4cb11c2011333ea1d6ab","2dd998efeec535a95ef36cf825c9b7d6b295f34117f7124269ff280010d9af05","26285ac8acaa8d0554de19ff773a8fd243268a78729d765a8007f9daa595d1e9","e058297d2eba4c1ac97be06bfd2ab718bdd82cdbb0831d18ab49aecf7cb8ea06","c717794dee7a42669f106ecd3ed8a18a7312d0c6a147e4ecb8a993b1cd647b73","1d8c31ccd11346883298efa420066acc959cd6d2fa60d102245faa15977d5101","48936b3473966b292da5b8f664dd4d58db98e449d7a578d73a476add2d38bf71","f9a45d1b0860fc140394bbf679420d377b136279b8babadcb9bd735f3de98042","d0fa49887723f9ac0cbdf10b49448f93f8f417ebd66881e1f159da739e35b96a","62b85d9a94cd0a8f7fc7eb7fc0699c35176a85815426bb48123adee61648d802","3a2c3b9a3df9ba12e13ffd307c82a6daac46bf2eb59b067588fcd1832551fa66","7c57a9436a2bc05d4cd1e020f9adff88323cf9a87ce02c9f99db373e290b8192"],"paragraph_range_zero_based":[36168,36191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p36168"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36192},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36193},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrierInfo field descriptions","paragraph_zero_based":36194},{"literal_text_all_w_t_and_m_t":"referenceCarrierIndex","paragraph_zero_based":36195},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the carrier which is to be used as the reference for interpreting the Tx Direction Current location as reported using txDirectCurrentLocation-r16. The numerology of the uplink BWP ID reported with bwp-Id-r16 for this serving cell is the numerology used for interpreting the reported subcarrier location. ","paragraph_zero_based":36196},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":36197},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":36198},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":36199},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the two carrier uplink CA with the serving cells reported using carrierOneInfo-r16 and carrierTwoInfo-r16. Values in the range of this field between 0 and 3299 indicate the subcarrier index of the uplink Tx Direct Current location with the subcarrier taken from the serving cell with ID referenceCarrierIndex and the numerology of the corresponding uplink BWP reported for this serving cell. Value 3300 indicates \"Outside the carrier\" and value 3301 indicates \"Undetermined position within the carrier\".","paragraph_zero_based":36200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36201},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCarrierInfo field descriptions","paragraph_zero_based":36202},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":36203},{"literal_text_all_w_t_and_m_t":"The BWP ID of the serving cell which is part of the two carrier uplink carrier aggregation. The UE shall not report this field if the serving cell is reported as deactivated using deactivatedCarrier-r16.","paragraph_zero_based":36204},{"literal_text_all_w_t_and_m_t":"deactivatedCarrier","paragraph_zero_based":36205},{"literal_text_all_w_t_and_m_t":"For the reported uplink Tx Direct Current location(s) corresponding to singlePA-TxDirectCurrent-r16, indicates whether the carrier is deactivated or not for this serving cell. If the carrier refers to the PCell, the UE shall not set this field to deactivated.","paragraph_zero_based":36206},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":36207},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell which is part of the two carrier uplink carrier aggregation.","paragraph_zero_based":36208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36209},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentTwoCarrier field descriptions","paragraph_zero_based":36210},{"literal_text_all_w_t_and_m_t":"carrierOneInfo","paragraph_zero_based":36211},{"literal_text_all_w_t_and_m_t":"The serving cell ID and BWP ID of the first carrier of the uplink carrier aggregation for which the uplink Tx Direct Current location(s) are being reported. ","paragraph_zero_based":36212},{"literal_text_all_w_t_and_m_t":"carrierTwoInfo","paragraph_zero_based":36213},{"literal_text_all_w_t_and_m_t":"The serving cell ID and BWP ID of the second carrier of the uplink carrier aggregation for which the uplink Tx Direct Current location(s) are being reported.","paragraph_zero_based":36214},{"literal_text_all_w_t_and_m_t":"singlePA-TxDirectCurrent","paragraph_zero_based":36215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["60068dce6f7f6dd8797346be11f44fccf272f748edf31f62a637a352574bb1de","5ef269e180934f86e7336db1454d3ed566399f74f509ca689011482c6b0b2796","e9314688582cf51797e3b06f1a79c4fa48eb6000eec2524f033de88e316d2b67","7f7ea413af72d2dbc8694b53d5310d5fb0e9b23f20c28d3fcd145a6249644ded","ea471cba9a5602f43be9526c07eb5eba8897c3991e719b360d0eebfd75e960d7","ce91ecea0d433c287bf0ade594e56e6eaa6c2ab0bf228ad5b647eadba3e81db0","09f7abd0afcbc51519013914bc204a82ee98c9e0275d141270d81a397eca3fac","9fab34b89c8192717a49eb4a25058c963ae4737789ec67a10c4f218cf52239d5","a7e839fc460c8582727753cbe56e956e98511607f819e4f65f57fbc1fa43e11e","0d619bad673d1fe5c6444e6df5893ec092fb0fa4114ab7c27917bf0b88fc0dd5","0d054050b6e5ffda44a00432f68711c4050fc1997974398d6ae342fbf140e263","5b466191d9efa030017c936d21c303ae8561a7cec0d79cfcb2e48f616aff40ea","a57db4d92677a064af236a8e789ef83140f3013a5b15b9fa80e8688965d8b49d","f6373b3d8e78d8a734967985dcf4d575e99db8625cd74f62207ce6b8328e9b46","f051ab8946695e967cd78956c5d07c72a1d62d2a6512ff51eaa9cd0766ea6ac4","2a5115ccd8031d2a5cc2a8cddb094e52e3aecee762f6054c36c97ce64be9e87e","1c99334182ea012e77a191c70897cdae88354a1a80cb64789899370224a96d67","1786e96e44425a15ee22c74eef3b34858492f051910cc56107e1ca0b7e6ba7cc","39abde8b42338a6574437432c360d3e525cf17c589f8ef09d00f077dac3c2bc7","a1cb4063584146ed2a6a68ebf6aedd8c393ac44493cc0b38d78b998f9149e03e","3e9d76cfd3e92a29141d76974aa8c80f7cff22eb743baef1bad6180be680c1c8","fa9315501e79a01321153557c9f4c8a2dab3d6db8fda7551253a0dc254961bbd","67c4ab2caaf25c300118849ada99ba6ebf221b5b911e8336d5a793f90855f5cb","f75bc05f9ddafca767dfbeaf3c8b41748530760319352ff67283beb845fba7bd"],"paragraph_range_zero_based":[36192,36215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p36192"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the UE which support single PA for this uplink carrier aggregation. For the UEs which support dual PA for this uplink carrier aggregation, this field is for reporting the uplink Tx Direct Current location of the first PA.  ","paragraph_zero_based":36216},{"literal_text_all_w_t_and_m_t":"secondPA-TxDirectCurrent","paragraph_zero_based":36217},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location used by the UE with the second PA for the UEs which support dual PA for this uplink carrier aggregation. This field shall be absent for the UplinkTxDirectCurrentTwoCarrier entity where deactivatedCarrier of carrierOneInfo or carrierTwoInfo is set to deactivated.","paragraph_zero_based":36218},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36219},{"literal_text_all_w_t_and_m_t":"–ZP-CSI-RS-Resource","paragraph_zero_based":36220},{"literal_text_all_w_t_and_m_t":"The IE ZP-CSI-RS-Resource is used to configure a Zero-Power (ZP) CSI-RS resource (see TS 38.214 [19], clause 5.1.4.2). Reconfiguration of a ZP-CSI-RS-Resource between periodic or semi-persistent and aperiodic is not supported.","paragraph_zero_based":36221},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-Resource information element","paragraph_zero_based":36222},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36223},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCE-START","paragraph_zero_based":36224},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36225},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-Resource ::=              SEQUENCE {","paragraph_zero_based":36226},{"literal_text_all_w_t_and_m_t":"    zp-CSI-RS-ResourceId                ZP-CSI-RS-ResourceId,","paragraph_zero_based":36227},{"literal_text_all_w_t_and_m_t":"    resourceMapping                     CSI-RS-ResourceMapping,","paragraph_zero_based":36228},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL, --Cond PeriodicOrSemiPersistent","paragraph_zero_based":36229},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36230},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36232},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-ResourceId ::=            INTEGER (0..maxNrofZP-CSI-RS-Resources-1)","paragraph_zero_based":36233},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36234},{"literal_text_all_w_t_and_m_t":"-- TAG-ZP-CSI-RS-RESOURCE-STOP","paragraph_zero_based":36235},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36236},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36237},{"literal_text_all_w_t_and_m_t":"ZP-CSI-RS-Resource field descriptions","paragraph_zero_based":36238},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":36239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6ce4049c95929188e2b26949187fe9f9d047f402cc57a7df766e007d2e828220","334534b2a35820c6707fb4aa231e291e28c8183d0a0ef0b5b908170207979af9","0af375dc34757dcfa9a7327412658d13d22905643f40230e21d31295ce93036a","aac664542f6e990e8897cf4bc374c9c6df826af65fb4883e1cd1bd5404f92c6a","77c1391a30343cddc35fa8fa6a259f59c40c77f45c4750f1a82082d7eb2ca1c8","43e7db8e2c983a3fe27ea8f61f83c1c3aded840d68c04261bd4f7b3b8834b05d","45889bf91a9d99a2e07d51e7d533c21ceffc8798582a661af3774b324c92d904","b2595c5af4cf3321ce67ae3417d5460d80730bdea3523e5f1e2005fa19f0310d","5a