{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25440},{"literal_text_all_w_t_and_m_t":"–MsgA-PUSCH-Config","paragraph_zero_based":25441},{"literal_text_all_w_t_and_m_t":"The IE MsgA-PUSCH-Config is used to specify the PUSCH allocation for MsgA in 2-step random access type procedure.","paragraph_zero_based":25442},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config information element","paragraph_zero_based":25443},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25444},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-START","paragraph_zero_based":25445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25446},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config-r16 ::=                      SEQUENCE {","paragraph_zero_based":25447},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupA-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond InitialBWPConfig","paragraph_zero_based":25448},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-ResourceGroupB-r16                  MsgA-PUSCH-Resource-r16                                       OPTIONAL, -- Cond GroupBConfigured","paragraph_zero_based":25449},{"literal_text_all_w_t_and_m_t":"    msgA-TransformPrecoder-r16                    ENUMERATED {enabled, disabled}                                 OPTIONAL, -- Need R","paragraph_zero_based":25450},{"literal_text_all_w_t_and_m_t":"    msgA-DataScramblingIndex-r16                   INTEGER (0..1023)                                             OPTIONAL, -- Need S","paragraph_zero_based":25451},{"literal_text_all_w_t_and_m_t":"    msgA-DeltaPreamble-r16                         INTEGER (-1..6)                                               OPTIONAL  -- Need R","paragraph_zero_based":25452},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25454},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource-r16 ::=                    SEQUENCE {","paragraph_zero_based":25455},{"literal_text_all_w_t_and_m_t":"    msgA-MCS-r16                                   INTEGER (0..15),","paragraph_zero_based":25456},{"literal_text_all_w_t_and_m_t":"    nrofSlotsMsgA-PUSCH-r16                        INTEGER (1..4),","paragraph_zero_based":25457},{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-PerSlot-r16                        ENUMERATED {one, two, three, six},","paragraph_zero_based":25458},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainOffset-r16                INTEGER (1..32),","paragraph_zero_based":25459},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-TimeDomainAllocation-r16            INTEGER (1..maxNrofUL-Allocations)                            OPTIONAL, -- Need S","paragraph_zero_based":25460},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLengthMsgA-PO-r16                INTEGER (0..127)                                              OPTIONAL, -- Need S","paragraph_zero_based":25461},{"literal_text_all_w_t_and_m_t":"    mappingTypeMsgA-PUSCH-r16                      ENUMERATED {typeA, typeB}                                     OPTIONAL, -- Need S","paragraph_zero_based":25462},{"literal_text_all_w_t_and_m_t":"    guardPeriodMsgA-PUSCH-r16                      INTEGER (0..3)                                                OPTIONAL, -- Need R","paragraph_zero_based":25463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b46a341564494b6db414913f11b603753cde8012a0d23f0259b5b43a5b21f4dc","61342b64ce0f258da04fdf62dc5fd164a6dccd49