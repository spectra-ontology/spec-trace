{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    uplinkDirectCurrentBWP                  SEQUENCE (SIZE (1..maxNrofBWPs)) OF UplinkTxDirectCurrentBWP,","paragraph_zero_based":36072},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":36073},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":36074},{"literal_text_all_w_t_and_m_t":"    uplinkDirectCurrentBWP-SUL              SEQUENCE (SIZE (1..maxNrofBWPs)) OF UplinkTxDirectCurrentBWP               OPTIONAL","paragraph_zero_based":36075},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":36076},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36077},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36078},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP ::=            SEQUENCE {","paragraph_zero_based":36079},{"literal_text_all_w_t_and_m_t":"    bwp-Id                                  BWP-Id,","paragraph_zero_based":36080},{"literal_text_all_w_t_and_m_t":"    shift7dot5kHz                           BOOLEAN,","paragraph_zero_based":36081},{"literal_text_all_w_t_and_m_t":"    txDirectCurrentLocation                 INTEGER (0..3301)","paragraph_zero_based":36082},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36083},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36084},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-STOP","paragraph_zero_based":36085},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36087},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentBWP field descriptions","paragraph_zero_based":36088},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":36089},{"literal_text_all_w_t_and_m_t":"The BWP-Id of the corresponding uplink BWP.","paragraph_zero_based":36090},{"literal_text_all_w_t_and_m_t":"shift7dot5kHz","paragraph_zero_based":36091},{"literal_text_all_w_t_and_m_t":"Indicates whether there is 7.5 kHz shift or not. 7.5 kHz shift is applied if the field is set to true. Otherwise 7.5 kHz shift is not applied.","paragraph_zero_based":36092},{"literal_text_all_w_t_and_m_t":"txDirectCurrentLocation","paragraph_zero_based":36093},{"literal_text_all_w_t_and_m_t":"The uplink Tx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding uplink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":36094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["debc2eb32af586a141d116ef610f5693045e70e85b009033b15a0315861347f3","cae073d846679c27b58ebc95b88f4a7792e22be79795dcb7b39f2ce1dbbcc43f","c6f0589b7586e477f5240b5c9b004a0204f062f034582ddbd1ef576dae1e9cb4","2abba457aca2141401a7a06b8b8ff349e1d92a6b024975b71b0683199d707071","8f824845880ec45f1dfe9adb192471da7caaed238f899ffb01c9d940f8a46fd6","ff99e2bef40edfbb86c3305ae851383c2527a25dcaf93fd0fdbd0d1c36c52374","cf8bc625d6cfe6578eff69acfa58fba09e7831aaf916b7feea829df8015ca54e","9ca360969a4a84bc13d14a5b887f421a439092cef8f67b5b24f483c66b69f7c4","d234d2518a299046c244ce5ec487f3203ff3f88f2467c108cdd39d7ff4d36e4b","3ef2f91a6c1748c5481c3a126c2cdee2fb467661135b68c11a8f629747673793","2601ad74077d3c3714b8582f9ec63f0e1e6bcff7b4774bedcf679c6d4035c