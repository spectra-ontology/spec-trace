 sym6, sym7}                          OPTIONAL,    -- Need M","paragraph_zero_based":45707},{"literal_text_all_w_t_and_m_t":"    sl-TransmissionStructureForPSCCHandPSSCH-r18 ENUMERATED {contigousRB, interlaceRB}                          OPTIONAL,    -- Need M","paragraph_zero_based":45708},{"literal_text_all_w_t_and_m_t":"    sl-GapOfAdditionalSSSB-Occasion-r18      INTEGER (0..639)                                                   OPTIONAL,    -- Need M","paragraph_zero_based":45709},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-NonAnchorList-r18 SEQUENCE (SIZE (1.. maxSL-NonAnchorRBsets)) OF ARFCN-ValueNR      OPTIONAL,    -- Need M","paragraph_zero_based":45710},{"literal_text_all_w_t_and_m_t":"    sl-CPE-StartingPositionS-SSB-r18         INTEGER (1..9)                                                     OPTIONAL,    -- Need M","paragraph_zero_based":45711},{"literal_text_all_w_t_and_m_t":"    sl-CWS-ForPsschWithoutHarqAck-r18        ENUMERATED {t1, t8, t16, t32, infinity}                            OPTIONAL,    -- Need M","paragraph_zero_based":45712},{"literal_text_all_w_t_and_m_t":"    sl-NumOfAdditionalSSSBOccasion-r18       INTEGER (0..4)                                                     OPTIONAL,    -- Need M","paragraph_zero_based":45713},{"literal_text_all_w_t_and_m_t":"    sl-SSSBPowerOffsetOfAnchorRBSet-r18      ENUMERATED {value1, value2}                                        OPTIONAL,    -- Need M","paragraph_zero_based":45714},{"literal_text_all_w_t_and_m_t":"    sl-RBSetConfigList-r18                   SEQUENCE (SIZE (1..5)) OF SL-RBSetConfig-r18                       OPTIONAL,    -- Need M","paragraph_zero_based":45715},{"literal_text_all_w_t_and_m_t":"    sl-IntraCellGuardBandsSL-List-r18        SEQUENCE (SIZE (1..maxSCSs)) OF IntraCellGuardBandsPerSCS-r16      OPTIONAL     -- Need M","paragraph_zero_based":45716},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":45717},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45718},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["74e6ae39f56670b2c2ef07830a8c4e10f3ddc2bc9b023ac8b1728cc9f01cde1b","b172c0404967d43dd28897558f0f093aa925b955ddc53bb9af3831abc9c9d85e","9160eb6923a0a0a4a959f312ace4968f38b193d37ee5103dbaae2f3c38e7b877","837e41ca54d0311766669253993e64e5f762a91b780b31e53350eb34abc0aad5","5aea4878687e21b3f2c8261632c77c522cd747765aee910204b32186c432d0e9","8f6dd6459c4a9c1ff85073fd82a3ecbeec3b9b9ce8ebc8a944544e10dda0a147","2a33bfa7574c88f1088cc98db55743a62b2dcf1ba275ec4aab55ae837d83b259","1fb5a8951c7c336500f9034c5901e5da7929d0e020e6ea7b476e354ac1f9bebc","368c6b8788c563b06c80f5ac0ba6fbe4ea76749f40bdbf1bfc76d4d7f0ea976b","3f08b9ecebfc72d60b2af418f6b59145b79da1b5259778e642454e277f808eae","e639b95d96b79a3cf64a66b2ffafa01a27698fa82495dc71ae4e644743b8a575","acd661e5c845b82f849b3c9b68076835ed46514c00695c20fcb46c36630d76f5","c36e267acebed592cbfa1e9e0ecfe705134a4edf57db361360c1b74eb3f686ac","acef982826bbf87190202a2939ed4eaf83eba5faae9461d51cb349e804d01378","55a44059472bce5e5581e53decbe35c1c7c00c6d46537cf2100f2fabc0275ec3","b97838fa77d4d422ff08b2a7ab1e55611ec4c3ddd34197073be8093572050cb4","8f4c0c7192f37ebf9ea64a35b0dbf49a7527baaf5a98eebf049dbab2a53b24d8","79899ecbcaf5d006ba5dd7901447af181ac93a81a1fdae6711c2c079307a8c67","745bcaf92c2bf128fe1d69261ab7adb2a2ae661d51e307331f4d44c2a3625e3d","117ae9b7454e1f1cd20f41cb780a1982f4576e01c5763fcab452986005fdd225","2ad2241b5272b1d69fe29d9d9fcc30fd5d2f30df22047cba4d81ef17b5bd34e6","57440469903c2b22442207e91a2ff8549c15eb5b8fd650e19744579f9cbf85a1","5086d2b9fca79827cffabc5d0ed8396e441399da0da67e4148b54dcc21b3d3cc","8f81dcb5b047621f0721