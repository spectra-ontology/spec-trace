{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42672},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-Container ::=        SEQUENCE {","paragraph_zero_based":42673},{"literal_text_all_w_t_and_m_t":"    rat-Type                              RAT-Type,","paragraph_zero_based":42674},{"literal_text_all_w_t_and_m_t":"    ue-CapabilityRAT-Container            OCTET STRING","paragraph_zero_based":42675},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42677},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-STOP","paragraph_zero_based":42678},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42679},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42680},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList field descriptions","paragraph_zero_based":42681},{"literal_text_all_w_t_and_m_t":"ue-CapabilityRAT-Container","paragraph_zero_based":42682},{"literal_text_all_w_t_and_m_t":"Container for the UE capabilities of the indicated RAT. The encoding is defined in the specification of each RAT:","paragraph_zero_based":42683},{"literal_text_all_w_t_and_m_t":"For rat-Type set to nr: the encoding of UE capabilities is defined in UE-NR-Capability.","paragraph_zero_based":42684},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra-nr: the encoding of UE capabilities is defined in UE-MRDC-Capability.","paragraph_zero_based":42685},{"literal_text_all_w_t_and_m_t":"For rat-Type set to eutra: the encoding of UE capabilities is defined in UE-EUTRA-Capability specified in TS 36.331 [10].","paragraph_zero_based":42686},{"literal_text_all_w_t_and_m_t":"For rat-Type set to utra-fdd: the octet string contains the INTER RAT HANDOVER INFO message defined in TS 25.331 [45].","paragraph_zero_based":42687},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42688},{"literal_text_all_w_t_and_m_t":"–UE-CapabilityRAT-RequestList","paragraph_zero_based":42689},{"literal_text_all_w_t_and_m_t":"The IE UE-CapabilityRAT-RequestList is used to request UE capabilities for one or more RATs from the UE.","paragraph_zero_based":42690},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList information element","paragraph_zero_based":42691},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42692},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-REQUESTLIST-START","paragraph_zero_based":42693},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42694},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-RequestList ::=        SEQUENCE (SIZE (1..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Request","paragraph_zero_based":42695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4a734c3ed2b0a34ec1c9af9cbb4fcf6229701d23277678df2b71b7b462eaf5da","f20ae13e7a60ee5f39c58ad10cadc6668b1db50bb4a6a431d14158d33ff9ba82","4875a139aa132df4d8c0037a124d2b6ca65ca5be759f52bc882206eb3db91384","ca66ea44a7897e01b4887ae2372170420f23169ddf5d0d31ff2b09848fdad9f3","4c8b00596700e761491f3ed5fcd583b635f8f9895521236b53f7bf664453e257","4c036e8c1d1943a3b8edaa2b4f9084be76c28ddff6c1d9f60c1dfaf5d3ffb24b","dc9a9a5d2b0e17ee8233fbfa2f97786480a9360386700b51e6a15ca4794645fa","8f67b3886cc7f487a6325c732da3e389114f6318a7a26fba668a1a6e5ddb9ac0","070e48cfca95f1957a639fa04e95a30c19c4351c39517ea470283fdcf0e59131","4be19590c5e9c5bac047b9b27fbd64ddc9685d210b5dd5f39b83cb4116c132f8","fc1eec9d6f5b9b324c409195733a9553a04ceaa268da3309be01e5cca0aa0bfb","58f36791fdbce0431359dfc8209d18ed