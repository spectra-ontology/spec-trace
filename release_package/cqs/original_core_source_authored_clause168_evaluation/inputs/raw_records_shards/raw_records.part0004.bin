{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    powerRampingStep                    ENUMERATED {dB0, dB2, dB4, dB6},","paragraph_zero_based":30720},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow                   ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80},","paragraph_zero_based":30721},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30722},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30723},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationPeriodScaling-IAB-r16    ENUMERATED {scf1,scf2,scf4,scf8,scf16,scf32,scf64}              OPTIONAL,   -- Need R","paragraph_zero_based":30724},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationFrameOffset-IAB-r16      INTEGER (0..63)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":30725},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationSOffset-IAB-r16          INTEGER (0..39)                                                 OPTIONAL,   -- Need R","paragraph_zero_based":30726},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1610                     ENUMERATED { sl60, sl160}                                       OPTIONAL,   -- Need R","paragraph_zero_based":30727},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex-v1610              INTEGER (256..262)                                              OPTIONAL    -- Need R","paragraph_zero_based":30728},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":30729},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30730},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1700                     ENUMERATED {sl240, sl320, sl640, sl960, sl1280, sl1920, sl2560} OPTIONAL    -- Need R","paragraph_zero_based":30731},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30732},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30734},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-STOP","paragraph_zero_based":30735},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30737},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric field descriptions","paragraph_zero_based":30738},{"literal_text_all_w_t_and_m_t":"msg1-FDM","paragraph_zero_based":30739},{"literal_text_all_w_t_and_m_t":"The number of PRACH transmission occasions FDMed in one time instance. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":30740},{"literal_text_all_w_t_and_m_t":"msg1-FrequencyStart","paragraph_zero_based":30741},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmission occasion in frequency domain with respective to PRB 0. The value is configured so that the corresponding RACH resource is entirely within the bandwidth of the UL BWP. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":30742},{"literal_text_all_w_t_and_m_t":"powerRampingStep","paragraph_zero_based":30743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8097d43da85b98a0a02741c3552f354a16cd4b17f8f92f2bee79c6107058e869","e8db99fc189d8896ee7ecc7aa9c12dde5c0a72012e5e1d344779a864f69d093c","38b3df37dbb9c32572b4a928966de69d5d8e52ad0c38be2fb412306dbbc4be72","0630cfaaef68de03b8019cbf15cd2d48e36d265b81cb94197bbd2f1c087d030d","7f33f1e0bb8b846f70e8f81672e6e38e63cbd0950e92ee491272b2b9b0847f2f","ead53f79eb9f01cec0bab27d021d550e87b008c56fc9fb69640774a898d3f2af","78d19e32b9af2fa4ef09cd70c8cde914ac7f8fad0588f76655ec9dd7854b5431","38f0f7b22d55b0730302de2f40e93743e1764e770339c928a7f250891365884f","70367cfd81f578c59a4b77c55a586e09c45be215e5ab321962b83dd7bff92296","0f614f35e0c7dd44b1c96dc26b1f88e6fde26a3b76f946f59c523cd36328e590","47c8df5ff7c5814a6072de5eb02ebe120bb0172ff5d1fc83730fed5b20b41850","8518dc07f44b1d7188542e3ce311f7888494e459b18b46272f198c493ad843bd","da50c466a0a52e571c8f3c38d57facb3608f7c3a84da24fa6b9cdd6b1f11be1b","c335a089d4985d83042700b929afa8e5c95b7d09151511dbbf1b31ecf8b250e8","e0e86e316aa8c9ba88d9b42dc3a0f97792bc6a2d372a9df92be115634fd467e8","83f74b6838fc317f3af750674321b40c2c0502ca59bb5f3458ef47be2306f6ce","f4aabfdc80c761e30331ee5d0b44b156a5f0f305367704c756d4dc6da2d3eb89","8cf41eb613d428dea72c94481d837ebe691e324ede60daf6047fcdc0ec5f22f1","79ff5762fbc429a60a2cb66b510c86fa40b50b81c5598407eb4aba05004f41fd","4d00f2332ec99b7561fdf11c3b65ef7790659c02f5b996ed3031434cea74a505","393546d875f33aa7612d1193e219f44d2270f63c9e858567c396951f114340a8","c6abbf2d95c89f5e9622273a55dba512ad0340c0c0fd45c30fab34f30e87e50a","ce7ba5f696d784b111150ffee73cc67e6c7136e54dca0b1d3896f5dd9e2125ea","30e8a53f34572bf9f4fd68667f85e715501986f41c8389be149041e3fc73340c"],"paragraph_range_zero_based":[30720,30743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30720"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Power ramping steps for PRACH (see TS 38.321 [3],5.1.3). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":30744},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationFrameOffset-IAB","paragraph_zero_based":30745},{"literal_text_all_w_t_and_m_t":"Frame offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":30746},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationIndex","paragraph_zero_based":30747},{"literal_text_all_w_t_and_m_t":"PRACH configuration index. For prach-ConfigurationIndex configured under beamFailureRecoveryConfig, the prach-ConfigurationIndex can only correspond to the short preamble format, (see TS 38.211 [16], clause 6.3.3.2). If the field prach-ConfigurationIndex-v1610 is present, the UE shall ignore the value provided in prach-ConfigurationIndex (without suffix).","paragraph_zero_based":30748},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationPeriodScaling-IAB","paragraph_zero_based":30749},{"literal_text_all_w_t_and_m_t":"Scaling factor to extend the periodicity of the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. Value scf1 corresponds to scaling factor of 1 and so on. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":30750},{"literal_text_all_w_t_and_m_t":"prach-ConfigurationSOffset-IAB","paragraph_zero_based":30751},{"literal_text_all_w_t_and_m_t":"Subframe/Slot offset for ROs defined in the baseline configuration indicated by prach-ConfigurationIndex and is used only by the IAB-MT. (see TS 38.211 [16], clause 6.3.3.2).","paragraph_zero_based":30752},{"literal_text_all_w_t_and_m_t":"preambleReceivedTargetPower","paragraph_zero_based":30753},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.4, TS 38.321 [3], clauses 5.1.2, 5.1.3). Only multiples of 2 dBm may be chosen (e.g. -202, -200, -198, ...). This field is set to the same value for different repetition numbers associated with a specific FeatureCombination.","paragraph_zero_based":30754},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":30755},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5). The UE shall ignore this field in case rach-ConfigGeneric is included within an EarlyUL-SyncConfig IE.","paragraph_zero_based":30756},{"literal_text_all_w_t_and_m_t":"ra-ResponseWindow","paragraph_zero_based":30757},{"literal_text_all_w_t_and_m_t":"Msg2 (RAR) window length in number of slots. The network configures a value lower than or equal to 10 ms when Msg2 is transmitted in licensed spectrum and a value lower than or equal to 40 ms when Msg2 is transmitted with shared spectrum channel access (see TS 38.321 [3], clause 5.1.4). UE ignores the field if included in SCellConfig. If ra-ResponseWindow-v1610 or ra-ResponseWindow-v1700 is signalled, UE shall ignore the ra-ResponseWindow (without suffix). The field ra-ResponseWindow-v1700 is applicable to SCS 480 kHz and SCS 960 kHz. The UE shall ignore this field in case rach-ConfigGeneric is included within an EarlyUL-SyncConfig IE.","paragraph_zero_based":30758},{"literal_text_all_w_t_and_m_t":"zeroCorrelationZoneConfig","paragraph_zero_based":30759},{"literal_text_all_w_t_and_m_t":"N-CS configuration, see Table 6.3.3.1-5 in TS 38.211 [16].","paragraph_zero_based":30760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30761},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGenericTwoStepRA","paragraph_zero_based":30762},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGenericTwoStepRA is used to specify the 2-step random access type parameters.","paragraph_zero_based":30763},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA information element","paragraph_zero_based":30764},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30765},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-START","paragraph_zero_based":30766},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a59ac9bd36332d9043c359cac90e5cd5961537a93aa412cc526458b1b0dd4ea8","dc4ad451de4f2f4b59168409dfe73b4e3c1808ef3accd85b1cf389883a3096f2","cce227d705d98dfa2ba684d71ce6dbbc21d07c5c26c21fa0914cc93c0f66df93","fed0ce2d6b2ad91341df007f0c752ab1073f73e498d0367e660a7156d8ce8554","11ce0ba16924aa97620ca373c060d2a61bd896442d040eb9a853f206d8aabf98","0261b5a4493cd8e2e33b05209ff1bac47ce7d17f918f307d8d30febf0078df64","da3e9ba456b7d6bd71e61066d13b9b99062790f21e9c5bda36cc566c971c9701","2c02c91568e6565e0ef01a1250f357cec207402e8b9c757114f7d8f8a70e8cd0","bb2d4a1c16ee02cc169917b2156f863af66d340cfbc8a975b9182155b1894b11","cb71cc233eff27bea233a0825e21326daed2c1bcebbdb573ea8689c62f05a5c0","71d8910f68f561eef2ed4d1b92d167232941bbd2721429c80f5f89225d969e73","43ab70725f62f7050f621b50d933dc3014b80c91b984aef3b14bdb15a0822684","b1733ffff8490d7b4adf62b95ac83f90d51d2a230a50457f94fccafa0315e46e","8126ca993eb90a7c1c52f12976d68164282b17ec64c114bb8585bdcb76132949","d5848450090e5d98db3c201debe960d0600ca494750c33aea40cc9ab75fefb99","d3da6d55a0cc96bea1d8425394b5590cd3ee89bb9f51e27780f6d9eeb0e8f068","bf80d144847417e6f40b98146012bf6101df906e5113fa4acae384ec01a21ecb","251bd473e7ff50b8aaa4451c98acd26975ab6dd10fcac93f6c536333fd6df482","af9eb239aca62375bc8dd3b6cec81e1ff470047f9895611366e9a94d06ac39ec","17648b46b5c0b733b487f5f442dd929795c7964084a1be79bf76fc52ce6ffbcb","2f4ed1cf8fc1fcbd9ddc80044cc879915adcf0942838f9fe75711b149488e4c3","e7c1239f26a186ed5be7cf97c8028567e9fcfca5433211c4fff08608c25d219d","f4680ba990b9faf736515653d3a0a2e40840edd125db5e870300c260098d61f6","84a5292991ebc139a5bbb67610cb44e693aef701dc9160173e4aff81c0ddfa91"],"paragraph_range_zero_based":[30744,30767],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30744"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA-r16 ::=     SEQUENCE {","paragraph_zero_based":30768},{"literal_text_all_w_t_and_m_t":"    msgA-PRACH-ConfigurationIndex-r16       INTEGER (0..262)                                                OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30769},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FDM-r16                         ENUMERATED {one, two, four, eight}                              OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30770},{"literal_text_all_w_t_and_m_t":"    msgA-RO-FrequencyStart-r16              INTEGER (0..maxNrofPhysicalResourceBlocks-1)                    OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30771},{"literal_text_all_w_t_and_m_t":"    msgA-ZeroCorrelationZoneConfig-r16      INTEGER (0..15)                                                 OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30772},{"literal_text_all_w_t_and_m_t":"    msgA-PreamblePowerRampingStep-r16       ENUMERATED {dB0, dB2, dB4, dB6}                                 OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":30773},{"literal_text_all_w_t_and_m_t":"    msgA-PreambleReceivedTargetPower-r16    INTEGER (-202..-60)                                             OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":30774},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-r16                 ENUMERATED {sl1, sl2, sl4, sl8, sl10, sl20, sl40, sl80, sl160, sl320}","paragraph_zero_based":30775},{"literal_text_all_w_t_and_m_t":"                                                                                                            OPTIONAL, -- Cond NoCFRA","paragraph_zero_based":30776},{"literal_text_all_w_t_and_m_t":"    preambleTransMax-r16                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200}  OPTIONAL, -- Cond 2StepOnlyNoCFRA","paragraph_zero_based":30777},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30778},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30779},{"literal_text_all_w_t_and_m_t":"    msgB-ResponseWindow-v1700               ENUMERATED {sl240, sl640, sl960, sl1280, sl1920, sl2560}        OPTIONAL  -- Cond NoCFRA2","paragraph_zero_based":30780},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30781},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30782},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30783},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERICTWOSTEPRA-STOP","paragraph_zero_based":30784},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30786},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGenericTwoStepRA field descriptions","paragraph_zero_based":30787},{"literal_text_all_w_t_and_m_t":"msgA-PreamblePowerRampingStep","paragraph_zero_based":30788},{"literal_text_all_w_t_and_m_t":"Power ramping steps for msgA PRACH. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of powerRampingStep in RACH-ConfigGeneric in the configured BWP (see TS 38.321 [3], 5.1.3). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreamblePowerRampingStep in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":30789},{"literal_text_all_w_t_and_m_t":"msgA-PreambleReceivedTargetPower","paragraph_zero_based":30790},{"literal_text_all_w_t_and_m_t":"The target power level at the network receiver side (see TS 38.213 [13], clause 7.1.1 and TS 38.321 [3], clause 5.1.1). Only multiples of 2 dBm may be chosen (e.g -202, -200, -198, …). If the field is absent, UE shall use the value of preambleReceivedTargetPower in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of msgA-PreambleReceivedTargetPower in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":30791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1004b0999601136c1761abaf2f3b92bb77b8214d4fc6a218082dddbc593950f2","fe9e4fd02af513de509df3704b4db35dad9c911fb3cb75ca188d2c35bc59cedf","9bb4cfb69fc85365a3123934f099843e04cc0d18a06f73d770b827ce16f1031f","7862ca266e322d83d7328590ba4918fc70546b1a52eed6297c32e1ef98b39fab","435619198d8bc49b3222d204603739be8eda4382c932d1024589af8fa4f7826d","478e04dbd4861f3f6fd4c3c9a7021bcc004e201e13d2974568e78ac9efff4ff1","c930ce82cfa6a91e384840427ad4e3dce0ad8b8d3dfd45724e4a80b242c01440","8fb2d5622cb2ce851f352725f3b801e97089a5cb59f5e5fd1711e03f2c06fb1d","d05f56c045698bd95d033674a1b773cbd08282e03665dae121ec9b7cca1870f7","0839d7d008d2b82345edcbbabc28f0b4b426c19d3f15457305f762a2cd045dd5","add6d309863904b9954eecbfc454314a73477f1b243ea50eb744f909bb4be1dd","bff685f8b07f4cc55d6d61912411e1b437d6cc66013787a61a39aa8f2970b941","7205a6118667b306cf10466f8214950e74ffb38a5e9edae660659712b4805855","901ae2add1872acf3efb781544f78b35a41de1b5c7700767ba40c41f28ad6d95","3835b70c1ecfa65415170acbf107b00e1f1b0b2f3f57c4241f3852fcad1b5f41","fef231470e0e2074e1a9b7ee310182968a31609e713a49e8622e2631f4b13849","f5316446fcdf1561e15e9df62224bad0745dadbffc4885f03b98350e9cff7423","c90c4c7eb2a042d136f9636865567e5e03da74ea38fb647917cb863d3bc36e17","555442748e9a810b62622d59237b350740d08279ebf5ee4a2671d445380a9866","4ef512b44c2410bceaac8d7ab068ac9cf6525c7d7922d1734f47491fedfebfe4","638da140fa4e8f5d6477abea4cbe4278332ea11f5869eaedb5a8cc65fcc8bb21","adfcf1291e733a7aa22bc0c92c448745c22379ec0eab1f9603e0752785ee1f48","7eea53b1da831d90ddd92eaef994af2fb5ab305846127b74ca943199458d37a8","7dd3c672f767e66aa5a389ad575636b9c2cad1c8cdf935a3c8d33fe8213db9a5"],"paragraph_range_zero_based":[30768,30791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30768"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-PRACH-ConfigurationIndex","paragraph_zero_based":30792},{"literal_text_all_w_t_and_m_t":"Cell-specific PRACH configuration index for 2-step RA type. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), the UE shall use the value of corresponding 4-step random access parameter in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the value is in the range of 256 to 262, the field prach-ConfigurationIndex-v1610 should be considered configured (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":30793},{"literal_text_all_w_t_and_m_t":"msgA-RO-FDM","paragraph_zero_based":30794},{"literal_text_all_w_t_and_m_t":"The number of msgA PRACH transmission occasions Frequency-Division Multiplexed in one time instance. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FDM in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FDM in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clause 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":30795},{"literal_text_all_w_t_and_m_t":"msgA-RO-FrequencyStart","paragraph_zero_based":30796},{"literal_text_all_w_t_and_m_t":"Offset of lowest PRACH transmissions occasion in frequency domain with respect to PRB 0. If the field is absent in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), UE shall use value of msg1-FrequencyStart in RACH-ConfigGeneric in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the value of msg1-FrequencyStart in RACH-ConfigCommon in the same AdditionalRACH-Config (see TS 38.211 [16], clauses 5.3.2 and 6.3.3.2). This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":30797},{"literal_text_all_w_t_and_m_t":"msgA-ZeroCorrelationZoneConfig","paragraph_zero_based":30798},{"literal_text_all_w_t_and_m_t":"N-CS configuration for msgA preamble, see Table 6.3.3.1-5 in TS 38.211 [16]. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use value zeroCorrelationZoneConfig in RACH-ConfigGeneric in the configured BWP. This field may only be present if no 4-step type RA is configured in the BWP or in the case of separate ROs with 4-step type RA.","paragraph_zero_based":30799},{"literal_text_all_w_t_and_m_t":"msgB-ResponseWindow","paragraph_zero_based":30800},{"literal_text_all_w_t_and_m_t":"MsgB monitoring window length in number of slots. The network configures a value lower than or equal to 40ms (see TS 38.321 [3], clause 5.1.1). The network does not configure msgB-ResponseWindow-r16 simultaneously with msgB-ResponseWindow-v1700, and if both fields are absent, the UE uses the value of msgB-ResponseWindow in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":30801},{"literal_text_all_w_t_and_m_t":"preambleTransMax","paragraph_zero_based":30802},{"literal_text_all_w_t_and_m_t":"Max number of RA preamble transmission performed before declaring a failure (see TS 38.321 [3], clauses 5.1.4, 5.1.5). If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config. If the field is absent in other cases, UE shall use the value of preambleTransMax in RACH-ConfigGeneric in the configured BWP. The field is absent if RACH-ConfigGenericTwoStepRA is included in CFRA-TwoStep in RACH-ConfigDedicated and then the UE uses the value of preambleTransMax in RACH-ConfigGenericTwoStepRA configured for CBRA.","paragraph_zero_based":30803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30804},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30805},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30806},{"literal_text_all_w_t_and_m_t":"2StepOnly","paragraph_zero_based":30807},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in BWP-UplinkCommon if rach-ConfigCommon field is absent in this BWP-UplinkCommon, otherwise the field is optionally present in msgA-ConfigCommon field in BWP-UplinkCommon, Need S.","paragraph_zero_based":30808},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon in AdditionalRACH-Config if rach-ConfigCommon field is absent in this AdditionalRACH-Config, otherwise the field is optionally present in msgA-ConfigCommon field in AdditionalRACH-Config, Need S.","paragraph_zero_based":30809},{"literal_text_all_w_t_and_m_t":"2StepOnlyNoCFRA","paragraph_zero_based":30810},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigCommonTwoStepRA and there are no 4-step random access configurations configured in the BWP (i.e only 2-step random access type configured in the BWP), otherwise (i.e. 4-step random access configuration also exists in the BWP) the field is optionally present, Need S. When RACH-ConfigGenericTwoStepRA is included in the RACH-ConfigDedicated, this field is absent.","paragraph_zero_based":30811},{"literal_text_all_w_t_and_m_t":"NoCFRA","paragraph_zero_based":30812},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r17 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":30813},{"literal_text_all_w_t_and_m_t":"NoCFRA2","paragraph_zero_based":30814},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgB-ResponseWindow-r16 is absent and RACH-ConfigGenericTwoStepRA is not included in CFRA-TwoStep in RACH-ConfigDedicated, otherwise the field is absent, Need S.","paragraph_zero_based":30815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c4aa8e54ce61d8e240b0ec09e244a10ad004f3d601fdc274148c97f0afb23fa0","146576e4ef83a8820bbbd8fc720af984bc6b3df38d88904dcf81f22e65730d10","b90c3a8add8e98da36acddf120dfd1824c2640c54101e9bf121640f0838e34f9","552738d90860e181111c8c2fa5acb0af26eaf1ad2c11fa0a0d4fec4d335f07a6","6a70252e3b72693120c93a1fb93063f716e805204230cb789f43704b585c801f","3386908bfacdf36e8beb62305ed7a19f006f223e3947963d114beccc5b52fcb6","42fd3a7c5e06c2e46a75e7d36a0b359ff7618ee2c1a70076c382a6b1c83a02b4","033d0da027954630a2afae5113aa12da77c77f63e05104b76bd3b0f3bc64621a","3288e50c3047eaba94a9b820b08d03322c9f08ff034528050260d1c5ef08ca80","421ddf87da6562241461128c48896fcde4ea0c850dd7a3f70d94b732aab522f5","71c7011fde1692ba58f6ee8fe4daa3a9360e44756456d9c97e81d12706493b18","5f9eff49e9134ebd063912da8f0ae97c18533e31d5ee3c94dbed