{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":528},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":529},{"literal_text_all_w_t_and_m_t":"Integrity1","paragraph_zero_based":530},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OR, if nr-TRP-LocationInfo is present and nr-IntegrityTRP-LocationBounds is present in IE NR-TRP-LocationInfo; otherwise it is not present.","paragraph_zero_based":531},{"literal_text_all_w_t_and_m_t":"Integrity2","paragraph_zero_based":532},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OR, if nr-DL-PRS-BeamInfo is present and nr-IntegrityBeamInfoBounds is present in IE NR-DL-PRS-BeamInfo; otherwise it is not present.","paragraph_zero_based":533},{"literal_text_all_w_t_and_m_t":"Integrity3","paragraph_zero_based":534},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OR, if nr-RTD-Info is present and nr-IntegrityRTD-InfoBounds is present in IE NR-RTD-Info; otherwise it is not present.","paragraph_zero_based":535},{"literal_text_all_w_t_and_m_t":"Integrity4","paragraph_zero_based":536},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need OR, if nr-TRP-BeamAntennaInfo is present and nr-IntegrityBeamPowerBounds is present in IE NR-TRP-BeamAntennaInfo; otherwise it is not present.","paragraph_zero_based":537},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":538},{"literal_text_all_w_t_and_m_t":"NR-PositionCalculationAssistance field descriptions","paragraph_zero_based":539},{"literal_text_all_w_t_and_m_t":"nr-TRP-LocationInfo","paragraph_zero_based":540},{"literal_text_all_w_t_and_m_t":"This field provides the location coordinates of the TRPs and location coordinates of antenna reference points for DL-PRS Resource Set(s) and DL-PRS Resources of the TRPs.","paragraph_zero_based":541},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-BeamInfo","paragraph_zero_based":542},{"literal_text_all_w_t_and_m_t":"This field provides the spatial directions of DL-PRS Resources for TRPs.","paragraph_zero_based":543},{"literal_text_all_w_t_and_m_t":"nr-RTD-Info","paragraph_zero_based":544},{"literal_text_all_w_t_and_m_t":"This field provides the time synchronization information between the reference TRP and neighbour TRPs. ","paragraph_zero_based":545},{"literal_text_all_w_t_and_m_t":"nr-TRP-BeamAntennaInfo","paragraph_zero_based":546},{"literal_text_all_w_t_and_m_t":"This field provides the relative DL-PRS Resource power between DL-PRS Resources per angle per TRP.","paragraph_zero_based":547},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-ExpectedLOS-NLOS-Assistance","paragraph_zero_based":548},{"literal_text_all_w_t_and_m_t":"This field provides the expected likelihood of a LOS propagation path from a TRP to the target device. The information is provided per TRP or per DL-PRS Resource.","paragraph_zero_based":549},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-TRP-TEG-Info","paragraph_zero_based":550},{"literal_text_all_w_t_and_m_t":"This field provides the TRP Tx TEG ID associated with the transmission of each DL-PRS Resource of the TRP.","paragraph_zero_based":551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["af5bb05db61f6b6c86816995f1cb8686e450bb97f3b24e29b4aea69f5c197d06","5f20215b148ae7fa308d9ebcd4a3b9791840c8f4ab21b2ad7c123d1f01663a3d","b4a577379bc075a62d719f528fecefd0a0b8fdf2c4b8d8011a7da2558d0f7a06","93490d9afb4a9965933a179bd83954152610f70e88154b6c94f676a7c9e7b0c6","496f30ea598467c4920b5239e842def0f03de6a80ee27e5