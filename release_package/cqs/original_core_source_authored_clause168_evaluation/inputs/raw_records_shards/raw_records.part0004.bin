{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28152},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-CONFIGCOMMON-STOP","paragraph_zero_based":28153},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28155},{"literal_text_all_w_t_and_m_t":"PDSCH-ConfigCommon field descriptions","paragraph_zero_based":28156},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocationList","paragraph_zero_based":28157},{"literal_text_all_w_t_and_m_t":"List of time-domain configurations for timing of DL assignment to DL data (see table 5.1.2.1.1-1 in TS 38.214 [19]).","paragraph_zero_based":28158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28159},{"literal_text_all_w_t_and_m_t":"–PDSCH-ServingCellConfig","paragraph_zero_based":28160},{"literal_text_all_w_t_and_m_t":"The IE PDSCH-ServingCellConfig is used to configure UE specific PDSCH parameters that are common across the UE's BWPs of one serving cell.","paragraph_zero_based":28161},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig information element","paragraph_zero_based":28162},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28163},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-SERVINGCELLCONFIG-START","paragraph_zero_based":28164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28165},{"literal_text_all_w_t_and_m_t":"PDSCH-ServingCellConfig ::=             SEQUENCE {","paragraph_zero_based":28166},{"literal_text_all_w_t_and_m_t":"    codeBlockGroupTransmission              SetupRelease { PDSCH-CodeBlockGroupTransmission }              OPTIONAL,   -- Need M","paragraph_zero_based":28167},{"literal_text_all_w_t_and_m_t":"    xOverhead                               ENUMERATED { xOh6, xOh12, xOh18 }                              OPTIONAL,   -- Need S","paragraph_zero_based":28168},{"literal_text_all_w_t_and_m_t":"    nrofHARQ-ProcessesForPDSCH              ENUMERATED {n2, n4, n6, n10, n12, n16}                         OPTIONAL,   -- Need S","paragraph_zero_based":28169},{"literal_text_all_w_t_and_m_t":"    pucch-Cell                              ServCellIndex                                                  OPTIONAL,   -- Cond SCellAddOnly","paragraph_zero_based":28170},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28171},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28172},{"literal_text_all_w_t_and_m_t":"    maxMIMO-Layers                          INTEGER (1..8)                                                 OPTIONAL,   -- Need M","paragraph_zero_based":28173},{"literal_text_all_w_t_and_m_t":"    processingType2Enabled                  BOOLEAN                                                        OPTIONAL    -- Need M","paragraph_zero_based":28174},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":28175}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2655512040d3ae17d3ce4f55f66b62fdb9a7d6d39e17ccc230a78dd3367c44c5","071af4370fd51e73dc6d3d802bd10be1f326deea543caa4a8f9f8cdf1574530c","df2376e6a7b9952e0b5ef15f7b2f28eda5718f57e4f0066d6dffd06c274dcc72","ea934c814f3288d03a0c3bd1e73c39e9e95934ce1c72ccf8e1f25e2b345b178a","855bf56af9a2d4c2622312ccde1cf075e60b8e3afb809e8073bf9dfe8d3eb395","fa099635c5b04509e3746e0ca0c14a9a27501341920084b0d6256638e2d9ed14","fee322f6df69de00ba1a696eb6e271923b2aff0519bdeafaaeb7d9538a882759","e224db21824668be15a8a4c2e7f6a5fc5d5ac2e07b234d9a7f9f742eb4606e14","5228fdb28fac25ad919318010c9c678f96e11007ce120eac