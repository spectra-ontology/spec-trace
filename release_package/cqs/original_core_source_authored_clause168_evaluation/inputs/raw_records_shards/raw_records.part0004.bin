ation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18456"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS. If the field is absent, the UE uses the preamble index associated with the SSB that is QCLed with this CSI-RS.","paragraph_zero_based":18480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18481},{"literal_text_all_w_t_and_m_t":"BFR-SSB-Resource field descriptions","paragraph_zero_based":18482},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":18483},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing BFR upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":18484},{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":18485},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell. It determines a candidate beam for beam failure recovery (BFR).","paragraph_zero_based":18486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18487},{"literal_text_all_w_t_and_m_t":"–BeamFailureRecoveryRSConfig","paragraph_zero_based":18488},{"literal_text_all_w_t_and_m_t":"The IE BeamFailureRecoveryRSConfig is used to configure the UE with candidate beams for beam failure recovery in case of beam failure detection. See also TS 38.321 [3], clause 5.17.","paragraph_zero_based":18489},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig information element","paragraph_zero_based":18490},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18491},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYRSCONFIG-START","paragraph_zero_based":18492},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18493},{"literal_text_all_w_t_and_m_t":"BeamFailureRecoveryRSConfig-r16 ::= SEQUENCE {","paragraph_zero_based":18494},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdBFR-r16               RSRP-Range                                                               OPTIONAL, -- Need M","paragraph_zero_based":18495},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List-r16            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL, -- Need M","paragraph_zero_based":18496},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18497},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18498},{"literal_text_all_w_t_and_m_t":"    candidateBeamRS-List2-r17            SEQUENCE (SIZE(1..maxNrofCandidateBeams-r16)) OF CandidateBeamRS-r16     OPTIONAL  -- Need R","paragraph_zero_based":18499},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18500},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18501},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18502},{"literal_text_all_w_t_and_m_t":"-- TAG-BEAMFAILURERECOVERYRSCONFIG-STOP","paragraph_zero_based":18503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9aa4a464cacfcc21037d885e3a3eb79eeb54d7125d5b9a2e6d6f59efb796c52f","a472634a4a796935acb2c1dbd6c7690e7cde0b8212b1a9ca3f7330a4a5b8649c","79fe7a07c8af42803132de3ece2e0031de7ba78690ad1210c351bd308ed1f714","76f5be2485b276eba976f0154e2640c1d65d59c0ef9e040ad05556c7598a3c88","62b7e8dad009d56c98f5135e0c5fec5731c2d50d0660d65df177d8bec0d30d12","521c5cc493c403fb2f2947cdcc36d8201b2b03e60ac6e4a609d856e03d8f6de1","3c52f1b155f227812655ae2552e7ebdf36548e5ad177d300036a817d9dce0f3a","ad7f453734a9a8e97ccfa084d7a1cefcba787b9bcae604e5117d2722a0885728","f6c999ad40bb2d492a5c126ba5aaf3d01adc598db15a066391145d60684e1864","f15a7f4f6f1cfd107b055f