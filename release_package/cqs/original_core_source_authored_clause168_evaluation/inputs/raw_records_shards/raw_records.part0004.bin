{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11448},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer-v1800-IEs ::= SEQUENCE {","paragraph_zero_based":11449},{"literal_text_all_w_t_and_m_t":"    eventID-TSS-r18                     INTEGER(0..63)                      OPTIONAL,   -- Cond ClockQualityDetailsLevel","paragraph_zero_based":11450},{"literal_text_all_w_t_and_m_t":"    clockQualityDetailsLevel-r18        CHOICE {","paragraph_zero_based":11451},{"literal_text_all_w_t_and_m_t":"        clockQualityMetrics-r18             ClockQualityMetrics-r18,","paragraph_zero_based":11452},{"literal_text_all_w_t_and_m_t":"        clockQualityAcceptanceStatus-r18    ENUMERATED {acceptable, notAcceptable}","paragraph_zero_based":11453},{"literal_text_all_w_t_and_m_t":"    }                                                                       OPTIONAL,   -- Need N","paragraph_zero_based":11454},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                         OPTIONAL","paragraph_zero_based":11455},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11457},{"literal_text_all_w_t_and_m_t":"-- TAG-DLINFORMATIONTRANSFER-STOP","paragraph_zero_based":11458},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":11459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11460},{"literal_text_all_w_t_and_m_t":"DLInformationTransfer field descriptions","paragraph_zero_based":11461},{"literal_text_all_w_t_and_m_t":"clockQualityDetailsLevel","paragraph_zero_based":11462},{"literal_text_all_w_t_and_m_t":"This field indicates the clock quality reporting control information as defined in TS 23.501 [32].","paragraph_zero_based":11463},{"literal_text_all_w_t_and_m_t":"eventID-TSS","paragraph_zero_based":11464},{"literal_text_all_w_t_and_m_t":"This field indicates the status of the 5G access stratum time distribution parameter Clock Quality Reporting Control Information as defined in TS 23.501 [32].","paragraph_zero_based":11465},{"literal_text_all_w_t_and_m_t":"rxTxTimeDiff-gNB","paragraph_zero_based":11466},{"literal_text_all_w_t_and_m_t":"Indicates the Rx-Tx time difference measurement at the gNB (see clause 5.2.3, TS 38.215 [9]). Upon receiving this field, the UE calculates the propagation delay based on the RTT-based PDC mechanism method as described in TS 38.300 [2]. The network does not configure this field, if the UE is configured with ta-PDC with value activate.","paragraph_zero_based":11467},{"literal_text_all_w_t_and_m_t":"sib9Fallback","paragraph_zero_based":11468},{"literal_text_all_w_t_and_m_t":"Indicates that the UE fallbacks to receive referenceTimeInfo in SIB9.","paragraph_zero_based":11469},{"literal_text_all_w_t_and_m_t":"ta-PDC","paragraph_zero_based":11470},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE-side TA-based propagation delay compensation (PDC) is activated or de-activated. The network does not configure this field with activate, if the field rxTxTimeDiff-gNB is configured.","paragraph_zero_based":11471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b51add2590dcc730d24c621a458d168bf762f0939fd846305a0814fdf49275d1","74aa0255d13ebe8d5b82f2021341de95a8904a4f3896c62ca8094fe39e9c470b","f1d6ac7a11325578171aa639b292f269387f919915bf09bf1f477e3aa007cf4e","3138d14b44814eda70c9795aec302a53a10d65d307697d53ca0db47a815ee090","1a434bc35d6d88e4c6929aef39f8890f2c03e7b6e4e4656b3df636c4d466b36a","caa6582da6