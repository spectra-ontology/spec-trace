{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CandidateBeamRS-r16 ::=                SEQUENCE {","paragraph_zero_based":19104},{"literal_text_all_w_t_and_m_t":"    candidateBeamConfig-r16                CHOICE {","paragraph_zero_based":19105},{"literal_text_all_w_t_and_m_t":"        ssb-r16                                SSB-Index,","paragraph_zero_based":19106},{"literal_text_all_w_t_and_m_t":"        csi-RS-r16                             NZP-CSI-RS-ResourceId","paragraph_zero_based":19107},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":19108},{"literal_text_all_w_t_and_m_t":"    servingCellId                          ServCellIndex                                                            OPTIONAL  -- Need R","paragraph_zero_based":19109},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19111},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATEBEAMRS-STOP","paragraph_zero_based":19112},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19114},{"literal_text_all_w_t_and_m_t":"CandidateBeamRS field descriptions","paragraph_zero_based":19115},{"literal_text_all_w_t_and_m_t":"candidateBeamConfig","paragraph_zero_based":19116},{"literal_text_all_w_t_and_m_t":"Indicates the resource (i.e. SSB or CSI-RS) defining this beam resource.","paragraph_zero_based":19117},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":19118},{"literal_text_all_w_t_and_m_t":"If the field is absent, the RS belongs to the serving cell in which BeamFailureRecoveryRSConfig is configured.","paragraph_zero_based":19119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19120},{"literal_text_all_w_t_and_m_t":"–CandidateTCI-State","paragraph_zero_based":19121},{"literal_text_all_w_t_and_m_t":"The IE CandidateTCI-State defines a TCI states configuration which associate one or more reference signal with a corresponding quasi-colocation (QCL) type.","paragraph_zero_based":19122},{"literal_text_all_w_t_and_m_t":"CandidateTCI-State information element","paragraph_zero_based":19123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19124},{"literal_text_all_w_t_and_m_t":"-- TAG-CANDIDATETCI-STATE-START","paragraph_zero_based":19125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19126},{"literal_text_all_w_t_and_m_t":"CandidateTCI-State-r18 ::=           SEQUENCE {","paragraph_zero_based":19127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d0b0d0c082cb3eb0812353e79096776adc4fc7e8b1fa303e1eab50d3c02a513a","133615f2c58dac267cdb112cd587b799eff39167cc18a90dccee8ba2719f904d","a390aba6b3829681d754a358811b2d8e667b8c10e1a48e46d31520544507c346","89f8a531b88bc27cc52a027d60808f291c0f0d7ae1016a7e23c00ef884761693","7d613145db01805c12f277d03ae9f8ca5d8d92220c0f71daeccd367d414e94f0","6a42c22d32e0a8ff43173078b07b8af457d72ab7ef7c25581a7127576272da7d","63f6d7af7d685e2e1dd19a95a88333e395a64c089ab6db9d4262c39a1c0a714a","b7bf3189e9a6b5c1e4c0644f38ed333bf70bfdaa4d992587cf8ebcd90858c448","cb45c316ecd915b3476d6c74d606840b22e6470b7b722ee09e8b0b1da322c760","7a09d62f44e7d0cfb9c0a511b1778109db4ef94c04446b4df6d56fba208f50a9","89a110eaab3f56ea245c121de8e32f7d769509f201726da6e7f274540d761c01","21f7f4acade46d3c711a3d37f23035c345d0d8657bd5c9a3503bf0652479aaef","c0464b13d241572eb627839863c672dda195fba2645e586c7d30e190e4e3c547","b2a24bdbcd2cc728a921c8c876e63f2a9683ee1fb761c4f3ea156e68009a389c","1b550b737b9c99e967