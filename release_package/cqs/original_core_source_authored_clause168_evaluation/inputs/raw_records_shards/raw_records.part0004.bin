{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-TxDirectCurrentLocation","paragraph_zero_based":45768},{"literal_text_all_w_t_and_m_t":"The sidelink Tx/Rx Direct Current location for the carrier. Only values in the value range of this field between 0 and 3299, which indicate the subcarrier index within the carrier corresponding to the numerology of the corresponding sidelink BWP and value 3300, which indicates \"Outside the carrier\" and value 3301, which indicates \"Undetermined position within the carrier\" are used in this version of the specification.","paragraph_zero_based":45769},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45770},{"literal_text_all_w_t_and_m_t":"–SL-BWP-ConfigCommon","paragraph_zero_based":45771},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-ConfigCommon is used to configure the cell-specific configuration information on one particular sidelink bandwidth part.","paragraph_zero_based":45772},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon information element","paragraph_zero_based":45773},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45774},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-START","paragraph_zero_based":45775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45776},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon-r16 ::=              SEQUENCE {","paragraph_zero_based":45777},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                            OPTIONAL,    -- Need R","paragraph_zero_based":45778},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommon-r16              SL-BWP-PoolConfigCommon-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":45779},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":45780},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":45781},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonPS-r17            SL-BWP-PoolConfigCommon-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":45782},{"literal_text_all_w_t_and_m_t":"    sl-BWP-DiscPoolConfigCommon-r17          SL-BWP-DiscPoolConfigCommon-r17                               OPTIONAL     -- Need R","paragraph_zero_based":45783},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":45784},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":45785},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonA2X-r18       SL-BWP-PoolConfigCommon-r16                                       OPTIONAL      -- Need R","paragraph_zero_based":45786},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":45787},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45789},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-STOP","paragraph_zero_based":45790},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1a1196ea287b99b6473234d712888289603321302ccbb88219114020d9cff064","e90b562ad72a68b89d46188427bacc8833abf4bf6a98bbe6442f753b17001464","b6645cb73fc815cff19e556215f7ac1aba24993c6628d6c129407c329bb638d9","fdbd647e01e6dae2b6cdba73877206ecd0627d2d11a472ebd1ba04a5c9fc0ddb","7921b9d211d43f4b7205ba3cdcb7d483c713c6dda04184b63c148f3a67abf0dc","52d6bc17af41a2a9019cf94b35e908530f19a3e7ae7240238ec04a567b9ecf5b","b76f8b15331a05b2488dce0fa7b1d1accc3f58b8280967f6