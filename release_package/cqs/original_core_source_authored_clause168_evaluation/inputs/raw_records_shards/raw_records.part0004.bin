{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Provides the establishment cause for the RRCSetupRequest in accordance with the information received from upper layers. gNB is not expected to reject an RRCSetupRequest due to unknown cause value being used by the UE.","paragraph_zero_based":13776},{"literal_text_all_w_t_and_m_t":"ue-Identity","paragraph_zero_based":13777},{"literal_text_all_w_t_and_m_t":"UE identity included to facilitate contention resolution by lower layers.","paragraph_zero_based":13778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13779},{"literal_text_all_w_t_and_m_t":"InitialUE-Identity field descriptions","paragraph_zero_based":13780},{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part1","paragraph_zero_based":13781},{"literal_text_all_w_t_and_m_t":"The rightmost 39 bits of 5G-S-TMSI.","paragraph_zero_based":13782},{"literal_text_all_w_t_and_m_t":"randomValue","paragraph_zero_based":13783},{"literal_text_all_w_t_and_m_t":"Integer value in the range 0 to 239 – 1.","paragraph_zero_based":13784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13785},{"literal_text_all_w_t_and_m_t":"–RRCSystemInfoRequest","paragraph_zero_based":13786},{"literal_text_all_w_t_and_m_t":"The RRCSystemInfoRequest message is used to request SI message(s) required by the UE as specified in clause 5.2.2.3.3 and 5.2.2.3.3a.","paragraph_zero_based":13787},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":13788},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":13789},{"literal_text_all_w_t_and_m_t":"Logical channel: CCCH","paragraph_zero_based":13790},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":13791},{"literal_text_all_w_t_and_m_t":"RRCSystemInfoRequest message","paragraph_zero_based":13792},{"literal_t