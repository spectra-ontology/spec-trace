{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nrofMsgA-PO-FDM-r16                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":25872},{"literal_text_all_w_t_and_m_t":"    msgA-IntraSlotFrequencyHopping-r16             ENUMERATED {enabled}                                          OPTIONAL, -- Need R","paragraph_zero_based":25873},{"literal_text_all_w_t_and_m_t":"    msgA-HoppingBits-r16                           BIT STRING (SIZE(2))                                          OPTIONAL, -- Cond FreqHopConfigured","paragraph_zero_based":25874},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-Config-r16                           MsgA-DMRS-Config-r16,","paragraph_zero_based":25875},{"literal_text_all_w_t_and_m_t":"    nrofDMRS-Sequences-r16                         INTEGER (1..2),","paragraph_zero_based":25876},{"literal_text_all_w_t_and_m_t":"    msgA-Alpha-r16                                 ENUMERATED {alpha0, alpha04, alpha05, alpha06,","paragraph_zero_based":25877},{"literal_text_all_w_t_and_m_t":"                                                               alpha07, alpha08, alpha09, alpha1}                OPTIONAL, -- Need S","paragraph_zero_based":25878},{"literal_text_all_w_t_and_m_t":"    interlaceIndexFirstPO-MsgA-PUSCH-r16           INTEGER (1..10)                                               OPTIONAL, -- Need R","paragraph_zero_based":25879},{"literal_text_all_w_t_and_m_t":"    nrofInterlacesPerMsgA-PO-r16                   INTEGER (1..10)                                               OPTIONAL, -- Need R","paragraph_zero_based":25880},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25881},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25883},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config-r16 ::=                       SEQUENCE {","paragraph_zero_based":25884},{"literal_text_all_w_t_and_m_t":"    msgA-DMRS-AdditionalPosition-r16               ENUMERATED {pos0, pos1, pos3}                                 OPTIONAL, -- Need S","paragraph_zero_based":25885},{"literal_text_all_w_t_and_m_t":"    msgA-MaxLength-r16                             ENUMERATED {len2}                                             OPTIONAL, -- Need S","paragraph_zero_based":25886},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-DMRS-CDM-Group-r16                  INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":25887},{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-NrofPorts-r16                       INTEGER (0..1)                                                OPTIONAL, -- Need S","paragraph_zero_based":25888},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID0-r16                         INTEGER (0..65535)                                            OPTIONAL, -- Need S","paragraph_zero_based":25889},{"literal_text_all_w_t_and_m_t":"    msgA-ScramblingID1-r16                         INTEGER (0..65535)                                            OPTIONAL  -- Need S","paragraph_zero_based":25890},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25891},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25892},{"literal_text_all_w_t_and_m_t":"-- TAG-MSGA-PUSCH-CONFIG-STOP","paragraph_zero_based":25893},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d719aca9a4b0f272e83d8ebcec6dcbc936e97f5e1c6bf906e997609d707402b6","ee5874f51f7fb44ec65f5861cf56dd542183a73df060b66e09f42ace9aa1320c","63c65ae51ed473d3cca665b19df58c01f826aa61d608fa859eaf33264655d6b1","a65391e22cdf79aef36c9d10fec0dfc00e1ffea1d42cf8dc4cad9a7f81055753","8849ae7741f94778a00efd8141cf0dfa403236a19a3783bed723b17bc74a28f9","6c9302a206a3b486798b0037811f9413ae4ba1b9ff6367cf65867b88f90285ea","6039519237933ab6cabae1389cba9a5809cbe02bd552aad226be5ba04c40c19c","ee4c75dffb5f97af8f976d26225382628d011af703d042b73b109e5084fd5fc0","e446354ce1ed8396fbda9576fb115d2db348059a515680c9bc6db0ec06c89d2f","9a8b41e1ac4b5d7313a013c783fa1c4ef0d9a4abfb26d48d692459712dd32b4c","1c5f65d732f52ec3d8f87d3098ce44b7781319d40a15d0b20cee4404026c0bff","11b032d34e769ad88f4929f9c6b5323cb2032920ce16bb10c090e6c59f8a1645","616b69ab17dc7d1cc4923b1696e43f05cabbec9de7e5e7c3cf7faee85a855ad9","8a600e022015102fdd2d41e4124c558f521bea410053f18f771061e34123ce24","9ef3ad3b8bcaad2e355077f24ca905ca497328b3a97c3284914119011f9ce0b0","fe701fb1f51a55243160f897f4d0ca0c9febe05211c2345d4ce2c8313bd0e8aa","e3884cbc5565473f6688aa09f872f90b5e029c57e02975e7e7f7db09ba6c85d1","6a528bd92b0f0bdb94f708687e662ec31c7d3513ffc599c86d71c573ae4728ce","1e7cbe4ae54b6a4170e861a1ab409beb9319977fc1a6a8f44fb5448f40226247","742ed13e0cd2b26abdd1d5692a6420e035d013476e26f7324531225f784f638e","1e4e9cc1aed6943e14091015487f7c549ae4602d79f806d2f98fab2fd66b9dbf","5eb2d3db334c21bb343642d2d9a29bd61c9858ffb0e072916822920d8c2bbc43","3fac65f310ff558b3d841747633a68a12c54d54bd722fd44ccf8d9ea74a377ce","5be2c9e7ad8ced256c6198ed4c562ea66d7ba2fdde325d10cdc0480a958a5e78"],"paragraph_range_zero_based":[25872,25895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25872"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Config field descriptions ","paragraph_zero_based":25896},{"literal_text_all_w_t_and_m_t":"msgA-DataScramblingIndex","paragraph_zero_based":25897},{"literal_text_all_w_t_and_m_t":"Identifier used to initiate data scrambling (c_init) for msgA PUSCH. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":25898},{"literal_text_all_w_t_and_m_t":"msgA-DeltaPreamble","paragraph_zero_based":25899},{"literal_text_all_w_t_and_m_t":"Power offset of msgA PUSCH relative to the preamble received target power. Actual value = field value * 2 [dB] (see TS 38.213 [13], clause 7.1).","paragraph_zero_based":25900},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupA","paragraph_zero_based":25901},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group A. If field is not configured for the selected UL BWP, the UE shall use the MsgA PUSCH configuration for group A of initial UL BWP or RedCap-specific initial UL BWP (if configured) for (e)RedCap UEs.","paragraph_zero_based":25902},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-ResourceGroupB","paragraph_zero_based":25903},{"literal_text_all_w_t_and_m_t":"MsgA PUSCH resources that the UE shall use when performing MsgA transmission using preambles group B.","paragraph_zero_based":25904},{"literal_text_all_w_t_and_m_t":"msgA-TransformPrecoder","paragraph_zero_based":25905},{"literal_text_all_w_t_and_m_t":"Enables or disables the transform precoder for MsgA transmission (see clause 6.1.3 of TS 38.214 [19]).","paragraph_zero_based":25906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25907},{"literal_text_all_w_t_and_m_t":"MsgA-PUSCH-Resource field descriptions ","paragraph_zero_based":25908},{"literal_text_all_w_t_and_m_t":"guardBandMsgA-PUSCH","paragraph_zero_based":25909},{"literal_text_all_w_t_and_m_t":"PRB-level guard band between FDMed PUSCH occasions (see TS 38.213 [13], clause 8.1A). If interlaced PUSCH is configured, value 0 is applied.","paragraph_zero_based":25910},{"literal_text_all_w_t_and_m_t":"guardPeriodMsgA-PUSCH","paragraph_zero_based":25911},{"literal_text_all_w_t_and_m_t":"Guard period between PUSCH occasions in the unit of symbols (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25912},{"literal_text_all_w_t_and_m_t":"frequencyStartMsgA-PUSCH","paragraph_zero_based":25913},{"literal_text_all_w_t_and_m_t":"Offset of lowest PUSCH occasion in frequency domain with respect to PRB 0 (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25914},{"literal_text_all_w_t_and_m_t":"interlaceIndexFirstPO-MsgA-PUSCH","paragraph_zero_based":25915},{"literal_text_all_w_t_and_m_t":"Interlace index of the first PUSCH occasion in frequency domain if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25916},{"literal_text_all_w_t_and_m_t":"mappingTypeMsgA-PUSCH","paragraph_zero_based":25917},{"literal_text_all_w_t_and_m_t":"PUSCH mapping type A or B. If the field is absent, the UE shall use the parameter msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25918},{"literal_text_all_w_t_and_m_t":"msgA-Alpha","paragraph_zero_based":25919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["132108fbef955b3119aaee2834330d6a5d1b7efe3bb950c62b5bb9bc4866cacf","a6496e2cc763b88ba88824e281223a9d4c168293a25c8f2f7e3edae1b1d90f93","e3345527c00147bd53446fb668a7676f487d8fdd69663a6e8fb46c994d8531d3","9608bb2027ebaec5df47231a8fd0f216be3a67a82c0007b8c927baf2442a6ac5","bb75690862812cdceb8b501a524c7c01314ba9e256f66e1217510b53735cde83","c0369f6d5c66a5625486d5e821c95ad3d136d0005a241842f848862541cd5735","0bab9bb3cd84d98bce0c570b676136528e76c17c7f07f9fb9ed4330fb3b7ab48","6fe40250d4d632e9e3ab905abfeade5af2dc8c96e099eb578ab5c5331e7559bd","329ad0296b205f825c4c04c11adeab66fdae06fc030da477b925861521c5e58b","6084e94e01a230943afbe9615375b9af06ef65b45e8f7209669b0e64e0fb04f7","b6401405cddc88583bdfcd3f592dfabb1d428f296f1e42186c5735d7630b2ce3","f6d156d1fb81e07df2a3e061dfa88d476396139f1176c7d647ac839801cc7601","c32a49058cf012f6ca2f7b9daaaaf3bd1b002078cd8ea2f5a557af8782dd2e35","3694ae48e6dc74d898599a9855d43c15225f843706ea5286b1d3fa9f0d6fb2bb","50ad3c4817cfae65cc0397b7c0fbaa9fa388c1351d6f64c05b75f4989fe211ba","b6729028561d75d0c0995ef36a8f828fad8adfba03ec153824b1ad7e534d0b05","b6b1fb77e87311af555f7aa0d4a34ccd10ae346903a05b370c4dbff445b60b64","44878dd4c8ce6e13e152db1f6d81d26f2bf047aacd19d79ba4d9a9c0d4548bff","a73824dd98cc45e8056e6b641ae36583384c717ba3981e6c995f6724e61f87b3","c3cc7b2c5707505b60855a3c7a2191c4e5655a9167f35c397d21a9bf8a72c574","f8e50b75ed0be1b2d279f1d9ea6870bf5701b0eb5747405019c0f4eba0718a70","98d4f4c34640c6647150b0095dcb8336fea7c27a45a3fd0819184251c09782f3","85c7c08293002e6eb61b5964ea09a745fbeb045a4cd9c1ba2d6f0167b300eb04","1212cecdd97fb1b1ed0ce1ee1c7f5ee99b166882731d99d40d11f51d46ae8047"],"paragraph_range_zero_based":[25896,25919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25896"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Dedicated alpha value for MsgA PUSCH. If the field is absent, the UE shall use the value of msg3-Alpha if configured, else UE applies value 1 (see TS 38.213 [13], clause 7.1.1).","paragraph_zero_based":25920},{"literal_text_all_w_t_and_m_t":"msgA-DMRS-Config","paragraph_zero_based":25921},{"literal_text_all_w_t_and_m_t":"DMRS configuration for msgA PUSCH (see TS 38.213 [13], clause 8.1A and TS 38.214 [19] clause 6.2.2).","paragraph_zero_based":25922},{"literal_text_all_w_t_and_m_t":"msgA-HoppingBits","paragraph_zero_based":25923},{"literal_text_all_w_t_and_m_t":"Value of hopping bits to indicate which frequency offset to be used for second hop. See Table 8.3-1 in TS 38.213 [13].","paragraph_zero_based":25924},{"literal_text_all_w_t_and_m_t":"msgA-IntraSlotFrequencyHopping","paragraph_zero_based":25925},{"literal_text_all_w_t_and_m_t":"Intra-slot frequency hopping per PUSCH occasion (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25926},{"literal_text_all_w_t_and_m_t":"msgA-MCS","paragraph_zero_based":25927},{"literal_text_all_w_t_and_m_t":"Indicates the MCS index for msgA PUSCH from the Table 6.1.4.1-1 for DFT-s-OFDM and Table 5.1.3.1-1 for CP-OFDM in TS 38.214 [19].","paragraph_zero_based":25928},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainAllocation","paragraph_zero_based":25929},{"literal_text_all_w_t_and_m_t":"Indicates a combination of start symbol and length and PUSCH mapping type from the TDRA table (PUSCH-TimeDomainResourceAllocationList if provided in PUSCH-ConfigCommon, or else the default Table 6.1.2.1.1-2 in 38.214 [19] is used if pusch-TimeDomainAllocationList is not provided in PUSCH-ConfigCommon). The parameter K2 in the table is not used for msgA PUSCH. The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of startSymbolAndLenghtMsgA-PO.","paragraph_zero_based":25930},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-TimeDomainOffset","paragraph_zero_based":25931},{"literal_text_all_w_t_and_m_t":"A single time offset with respect to the start of each PRACH slot (with at least one valid RO), counted as the number of slots (based on the numerology of active UL BWP). See TS 38.213 [13], clause 8.1A.","paragraph_zero_based":25932},{"literal_text_all_w_t_and_m_t":"nrofDMRS-Sequences","paragraph_zero_based":25933},{"literal_text_all_w_t_and_m_t":"Number of DMRS sequences for MsgA PUSCH for CP-OFDM. In case of single PUSCH configuration or if the DMRS symbols of multiple configurations are not overlapped, if the DMRS resources configured in one PUSCH occasion is no larger than 8 (for len2) or 4 (for len1), then only DMRS port is configured.","paragraph_zero_based":25934},{"literal_text_all_w_t_and_m_t":"nrofInterlacesPerMsgA-PO","paragraph_zero_based":25935},{"literal_text_all_w_t_and_m_t":"Number of consecutive interlaces per PUSCH occasion if interlaced PUSCH is configured. For 30kHz SCS only the integers 1, 2, 3, 4, 5 are applicable (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25936},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-FDM","paragraph_zero_based":25937},{"literal_text_all_w_t_and_m_t":"The number of msgA PUSCH occasions FDMed in one time instance (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25938},{"literal_text_all_w_t_and_m_t":"nrofMsgA-PO-PerSlot","paragraph_zero_based":25939},{"literal_text_all_w_t_and_m_t":"Number of time domain PUSCH occasions in each slot. PUSCH occasions including guard period are contiguous in time domain within a slot (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25940},{"literal_text_all_w_t_and_m_t":"nrofPRBs-PerMsgA-PO","paragraph_zero_based":25941},{"literal_text_all_w_t_and_m_t":"Number of PRBs per PUSCH occasion (see TS 38.213 [13], clause 8.1A). An eRedcap UE ignores the PRACH and PUSCH resource parameters (for preambles group A and B, or only group B as specified in TS 38.321 [3]) for transmission of MsgA in 2-step random access type procedure if configured number of PRBs per corresponding PUSCH resources is larger than the maximum number of PRBs that can be scheduled per slot or per hop.","paragraph_zero_based":25942},{"literal_text_all_w_t_and_m_t":"nrofSlotsMsgA-PUSCH","paragraph_zero_based":25943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["834812e60dc21f038e241c2b44ee2c4d32d3f6b9969e47f32ab5a9ac8459a1be","07a8cefa15b0c5ecd1a586e0caf785e09d19bfc5e0725bafad0c09286a932cb7","3f13ba7bf4c7ea8519c28db0b8cd07c609d675c775c2724bd87e4469adeb42a4","665f64702577c7132b9b00ed13cb44cf07f57648124c1b28724fab4bd80071a8","08c119774bbcda61dd2f9bd4885122491141edec53127ac4e8f3271c2114d292","aec62ca6e0609bdb61826d84f6adef3537bca7df6cbb76bbe7a758f88e218708","e129239b57aecaacccb95ace9a67043d31ef1fc50eae675b5c3c36ecc1fb6032","b43d6111d248c27965958ee8ecb63f8152de50dbd56ea11b261c1a4cc01cb8d5","d00634d0f6433e469afb105090f41f82fc03f88b92ae39239d32daa66fcffc1c","6c93dfd25b5e74bf0683984187b30fff6dbe9a3591f18a12acb614c5077df337","8040afc3c6199a942acf9e3b9d4e961f0ebae1bdfaf32385f174e5c96707745d","b48d340917b6f5147753a0c7f95d7ed45d7373f95c247b4f48b0e54109a2d18e","ca3f17febe3dc868422b1d7e4c8a683c2dd46482d95440a0ad1649952d009a29","e8570d6e588528b6561a232a6be9a27ee14dc6fa53e9651422e3d1753888d561","e655f267ca24badfa31a12aac3b4a2fdbc2cfcffd1f072384960eacbc8f6db44","19a5df3fc415d5f6264b72dab9a097def26358b5dee889834b35fc2f88818cb5","0df28973a293d048a041af281bc4f3712699cae46392db384ded3ae5eac7ee4f","4ad6434185fb1f96d937284edb2129305bac847630203f81b63cefd1ac8d62c8","c932cca4941fffb35de8eb67de7e9cd8fe84b8d6df6ee4652cf7720c7dda3d14","465441b5198331d9afa44afff1cbce99e9ffb87ea94e7a97850747353ef16714","b963b0364c3cbbe1fc8430e7600ef819b744aa99474e30a01646c5d722ec3e8b","a8cb2554ffc21ceb762eb097186ace7a738e5fc8e1a85b48c9a1b9ce288b0d52","284a712018500552d4ea1d297952eef3b76e2f27e0b6d400eacd6ac84fa87f17","bbe0beab4f05b89d28806af10137e5e6f912f87fae4c0760f79d77f9764b38cb"],"paragraph_range_zero_based":[25920,25943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25920"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Number of slots (in active UL BWP numerology) containing one or multiple PUSCH occasions, each slot has the same time domain resource allocation (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25944},{"literal_text_all_w_t_and_m_t":"startSymbolAndLengthMsgA-PO","paragraph_zero_based":25945},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol, length and mapping type as start and length indicator (SLIV) for the first msgA PUSCH occasion, for RRC_CONNECTED UEs in non-initial BWP as described in TS 38.214 [19] clause 6.1.2. The network configures the field so that the allocation does not cross the slot boundary. The number of occupied symbols excludes the guard period. If the field is absent, the UE shall use the value in msgA-PUSCH-TimeDomainAllocation (see TS 38.213 [13], clause 8.1A). The network configures one of msgA-PUSCH-TimeDomainAllocation and startSymbolAndLengthMsgA-PO, but not both. If the field is absent, the UE shall use the value of msgA-PUSCH-TimeDomainAllocation.","paragraph_zero_based":25946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25947},{"literal_text_all_w_t_and_m_t":"MsgA-DMRS-Config field descriptions ","paragraph_zero_based":25948},{"literal_text_all_w_t_and_m_t":"msgA-DMRS-AdditionalPosition","paragraph_zero_based":25949},{"literal_text_all_w_t_and_m_t":"Indicates the position for additional DM-RS. If the field is absent, the UE applies value pos2.","paragraph_zero_based":25950},{"literal_text_all_w_t_and_m_t":"msgA-MaxLength","paragraph_zero_based":25951},{"literal_text_all_w_t_and_m_t":"indicates single-symbol or double-symbol DMRS. If the field is absent, the UE applies value len1.","paragraph_zero_based":25952},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-DMRS-CDM-Group","paragraph_zero_based":25953},{"literal_text_all_w_t_and_m_t":"1-bit indication of indices of CDM group(s). If the field is absent, then both CDM groups are used.","paragraph_zero_based":25954},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-NrofPorts","paragraph_zero_based":25955},{"literal_text_all_w_t_and_m_t":"0 indicates 1 port per CDM group, 1 indicates 2 ports per CDM group. If the field is absent then 4 ports per CDM group are used (see TS 38.213 [13], clause 8.1A).","paragraph_zero_based":25956},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID0","paragraph_zero_based":25957},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":25958},{"literal_text_all_w_t_and_m_t":"msgA-ScramblingID1","paragraph_zero_based":25959},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. If the field is absent the UE applies the value Physical cell ID (physCellID).","paragraph_zero_based":25960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25961},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":25962},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":25963},{"literal_text_all_w_t_and_m_t":"FreqHopConfigured","paragraph_zero_based":25964},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when the field msgA-IntraSlotFrequencyHopping is configured. Otherwise, the field is absent.","paragraph_zero_based":25965},{"literal_text_all_w_t_and_m_t":"GroupBConfigured","paragraph_zero_based":25966},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if groupB-ConfiguredTwoStepRA is configured in RACH-ConfigCommonTwoStepRA, otherwise the field is absent.","paragraph_zero_based":25967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["94be8fe7700e575efa747b5071443a583c48c0887772a7842171eb4a0c2184bb","4af54a8ee78a321877fbf4b0f0872902ba97a184fc97ca0839343b5d63011c16","7542fb82f7f1ed6fb480f5e80f8905c05c9616933972cb8f2b6883b7a99b9231","bc2b1116e5903b2b4714498b2ac0d32ebd02c261dab84dea3ef8066525fcedcb","1bd8e36e6ca8e16ad461e7247dbdbf7e16a909b658358b9f9cd47ec5ece80134","24dbcdc8b532ddf374ac9126a74fb48682cd9261f6482e29195c6c889b0e53e7","d1c76346f43720cda1bac454a50e65fafe8497b1d4fcfa36a4b56457b59a52a7","f254d3bed282b9ba0159bdfbbded8319f41057ab07b7cb584d6b3617bb5d9693","66fd19adbc66681a64d49154f83db5a01e69ee27c401e9c75df5304d9c5daca7","c55d96b89e8b9a62aece10394e1e3a1653141cfc16c8217c22b7721e6ba461bb","997b7cdd5b212f33ea11c2f1bab177d3b84c0637aeb4a151610d15d0e42636cc","062f911201cd428b12e53f4a9aa11cceb354ac184050cf1caf4dd4d528c89f25","06f2f5e33e81ab885e3d24a127e5e75d1a10fdd39264f955e1f1b2b1fe9616a3","d05ab5bdbfa2ad23a6e70bcccbe45251b813557a57722ee0584eee8a68ea2abc","be3e6e213f74c457830b589f438e8ee71c50a391202c8e788808a655946720df","fc334855059e39e6979a04b31a67b02f5aeb50b02c69a9bce3e5a1776bd5ef53","56fc5a05d3f198e06a25b27d3d8e8af3958b0322916a74057fecf43d5ef269e5","a5278eacffb59c18a058ebdb0ccedbeb969e6fc9b90374eb565d21cf02abf744","dabfb7d4a2b3a2397283fa76c2325c16ed3fae4f615892fc50fc9227e5e1dea9","d80a8df6dc11d54ff02840ee5986f0a8df919715291874302ac21d813b0ec57a","2711d1b543b34a49470339e4dad96f76f22a4fbc5e0464afba660f6751bfd4af","8ed8c4f71e13562006d81fef72eab03f65bc607a618978c003a8889ee82ca5c5","46bc01a1015b8b976b3dd1b56c8eeb58ea57ce118f38f4d765e66b35d9904a9a","e9ac6f4d4ebd17d6488200da9ae8b81db3dd3bcfba514c16a9832d4f079ae9c9"],"paragraph_range_zero_based":[25944,25967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p25944"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"InitialBWPConfig","paragraph_zero_based":25968},{"literal_text_all_w_t_and_m_t":"The field is mandatory present when MsgA-ConfigCommon is configured for the initial uplink BWP, or when MsgA-ConfigCommon is configured for a non-initial uplink BWP and MsgA-ConfigCommon is not configured for the initial uplink BWP, otherwise the field is optionally present, Need S.","paragraph_zero_based":25969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25970},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR","paragraph_zero_based":25971},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR is used to configure a list of one or multiple NR frequency bands.","paragraph_zero_based":25972},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR information element","paragraph_zero_based":25973},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25974},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-START","paragraph_zero_based":25975},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25976},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR ::=        SEQUENCE (SIZE (1..maxNrofMultiBands)) OF FreqBandIndicatorNR","paragraph_zero_based":25977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25978},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-STOP","paragraph_zero_based":25979},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25980},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25981},{"literal_text_all_w_t_and_m_t":"–MultiFrequencyBandListNR-SIB","paragraph_zero_based":25982},{"literal_text_all_w_t_and_m_t":"The IE MultiFrequencyBandListNR-SIB indicates the list of frequency bands, for which cell (re-)selection parameters are common, and a list of additionalPmax and additionalSpectrumEmission.","paragraph_zero_based":25983},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB information element","paragraph_zero_based":25984},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25985},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIFREQUENCYBANDLISTNR-SIB-START","paragraph_zero_based":25986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25987},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB ::=            SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo","paragraph_zero_based":25988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25989},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo ::=                        SEQUENCE {","paragraph_zero_based":25990},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR                         FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":25991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["cb4e5cbc5fe61a5de9851983620ba870ece6fbb5aada9defd76885e558c25fd8","fc4763d79bbb90cc769deed257188e0cca5908eb42498616159fca4937e2b9c8","6ababacb0e859c768cea679addd6d6424d31d318a9368e4fe05bf9022d26e605","8190a968625cfdfb80442f2e0a6220dc1d3f0aa83ad6c5d8bc7937e971b0fc42","09f6fb0ee414927f5123ae0f55df4e976b653322ac071f8bb00baaf781beab50","4d8be402a914580549ef6d97fd2463d59ce455e28a512e32e199e16b5b9c35f4","fb1a707ddc3887ca1e818b98807b2c528bff963903ac57476979fd83dc7a9245","dd3136022902b502c94677c6c319e1e2e987118df142e8f311096c3be11f5404","c432871e9405b49cb5b2c420e3fed8bdc226e1b77304181994bfca18292a3769","fba261d9ff2e0cc2ecb197d49080accd475964f5ea587373ef4bffb96cff91ab",