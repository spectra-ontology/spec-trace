{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":8016},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via the E-UTRA MCG embedded in E-UTRA RRC message ULInformationTransferMRDC as specified in TS 36.331 [10].","paragraph_zero_based":8017},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in NR-DC:","paragraph_zero_based":8018},{"literal_text_all_w_t_and_m_t":"2>if the UE assistance configuration that triggered this UE assistance information is associated with the SCG:","paragraph_zero_based":8019},{"literal_text_all_w_t_and_m_t":"3>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":8020},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":8021},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8022},{"literal_text_all_w_t_and_m_t":"4>submit the UEAssistanceInformation message via the NR MCG embedded in NR RRC message ULInformationTransferMRDC as specified in 5.7.2a.3;","paragraph_zero_based":8023},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":8024},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB1 to lower layers for transmission;","paragraph_zero_based":8025},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":8026},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation message to lower layers for transmission.","paragraph_zero_based":8027},{"literal_text_all_w_t_and_m_t":"5.7.4.3aSetting the contents of OverheatingAssistance IE","paragraph_zero_based":8028},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of OverheatingAssistance IE if initiated to provide overheating assistance indication for SCG in (NG)EN-DC according to clause 5.6.10.3 as specified in TS 36.331 [10]:","paragraph_zero_based":8029},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce the number of maximum secondary component carriers for SCG:","paragraph_zero_based":8030},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxCCs in the OverheatingAssistance IE;","paragraph_zero_based":8031},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsDL to the number of maximum PSCell and SCells of the SCG the UE prefers to be temporarily configured in downlink;","paragraph_zero_based":8032},{"literal_text_all_w_t_and_m_t":"2>set reducedCCsUL to the number of maximum PSCell and SCells of the SCG the UE prefers to be temporarily configured in uplink;","paragraph_zero_based":8033},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR1 for SCG:","paragraph_zero_based":8034},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR1 in the OverheatingAssistance IE;","paragraph_zero_based":8035},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-DL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all downlink carriers of FR1 of the SCG;","paragraph_zero_based":8036},{"literal_text_all_w_t_and_m_t":"2>set reducedBW-FR1-UL to the maximum aggregated bandwidth the UE prefers to be temporarily configured across all uplink carriers of FR1 of the SCG;","paragraph_zero_based":8037},{"literal_text_all_w_t_and_m_t":"1>if the UE prefers to temporarily reduce maximum aggregated bandwidth of FR2-1 for SCG:","paragraph_zero_based":8038},{"literal_text_all_w_t_and_m_t":"2>include reducedMaxBW-FR2 in the OverheatingAssistance IE;","paragraph_zero_based":8039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea2