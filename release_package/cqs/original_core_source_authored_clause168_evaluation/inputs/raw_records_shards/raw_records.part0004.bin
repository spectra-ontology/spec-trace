rom the UE Inactive AS context, if stored;","paragraph_zero_based":4645},{"literal_text_all_w_t_and_m_t":"1>release musim-LeaveAssistanceConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4646},{"literal_text_all_w_t_and_m_t":"1>release musim-CapabilityRestrictionConfig from the UE Inactive AS context, if stored and stop timer T346n, if running;","paragraph_zero_based":4647},{"literal_text_all_w_t_and_m_t":"1>release propDelayDiffReportConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4648},{"literal_text_all_w_t_and_m_t":"1>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":4649},{"literal_text_all_w_t_and_m_t":"1>release rrm-MeasRelaxationReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4650},{"literal_text_all_w_t_and_m_t":"1>release multiRx-PreferenceReportingConfigFR2 if configured, and stop timer T346m, if running;","paragraph_zero_based":4651},{"literal_text_all_w_t_and_m_t":"1>release aerial-FlightPathAvailabilityConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4652},{"literal_text_all_w_t_and_m_t":"1>release ul-TrafficInfoReportingConfig from the UE Inactive AS context, if stored;","paragraph_zero_based":4653},{"literal_text_all_w_t_and_m_t":"1>stop all instances of timer T346l, if running;","paragraph_zero_based":4654},{"literal_text_all_w_t_and_m_t":"1>if the UE is acting as L2 U2N Remote UE:","paragraph_zero_based":4655}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7d940e0183955e2b31105e53675fa9db5b9ba7b7e16e3fddb95d734829179c1e","9d5b088efd3e79dd0ae20e79a0845d72f1225802d614325c45cd2ed95113f57e","4858b5c2a54f26e9d0c4a95