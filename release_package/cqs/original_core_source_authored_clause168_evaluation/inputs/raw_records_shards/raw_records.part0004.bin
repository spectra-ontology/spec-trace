{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Setup","paragraph_zero_based":34920},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon configuration of SRS-ResourceSet or SRS-Resource and optionally present, Need M, otherwise.","paragraph_zero_based":34921},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34922},{"literal_text_all_w_t_and_m_t":"–SRS-PosTx-Hopping","paragraph_zero_based":34923},{"literal_text_all_w_t_and_m_t":"The IE SRS-PosTx-Hopping specifies the frequency hopping configuration for SRS for Positioning transmission.","paragraph_zero_based":34924},{"literal_text_all_w_t_and_m_t":"SRS-PosTx-Hopping information element","paragraph_zero_based":34925},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34926},{"literal_text_all_w_t_and_m_t":"-- TAG- SRS-PosTx-Hopping-START","paragraph_zero_based":34927},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34928},{"literal_text_all_w_t_and_m_t":"SRS-PosTx-Hopping-r18 ::=                       SEQUENCE {","paragraph_zero_based":34929},{"literal_text_all_w_t_and_m_t":"    srs-PosConfig-r18                               SRS-PosConfig-r17,","paragraph_zero_based":34930},{"literal_text_all_w_t_and_m_t":"    bwp-r18                                         BWP                                                              OPTIONAL,  -- Need R","paragraph_zero_based":34931},{"literal_text_all_w_t_and_m_t":"    srs-PosUplinkTransmissionWindowConfig-r18       SetupRelease { SRS-PosUplinkTransmissionWindowConfig-r18 }       OPTIONAL  -- Need M","paragraph_zero_based":34932},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34933},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34934},{"literal_text_all_w_t_and_m_t":"SRS-PosUplinkTransmissionWindowConfig-r18 ::=   SEQUENCE {","paragraph_zero_based":34935},{"literal_text_all_w_t_and_m_t":"    startSFN-r18                                    INTEGER(0..1023),","paragraph_zero_based":34936},{"literal_text_all_w_t_and_m_t":"    windowPeriodicityAndOffset-r18                  CHOICE {","paragraph_zero_based":34937},{"literal_text_all_w_t_and_m_t":"        periodicityAndOffset-r18                        SRS-PeriodicityAndOffset-r16,","paragraph_zero_based":34938},{"literal_text_all_w_t_and_m_t":"        periodicityAndOffset-Ext-r18                    SRS-PeriodicityAndOffsetExt-r16","paragraph_zero_based":34939},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":34940},{"literal_text_all_w_t_and_m_t":"    duration-r18                                    ENUMERATED {s1,s2,s4,s6},","paragraph_zero_based":34941},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":34942},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4bd8bbe6d76b54be660a7469e78649ee4c9f3730467daf1a739cfa649e72d0e7","cf53152f2621fe080ac8991263661bf4f7c6170fda0782edc7454f4a23f16c9d","e9c10e4bea18c9b7cdc561a661ecdd0abf5dec1e7665fa172f77c53e8dbb5343","00e26ee7ad894b556dc88e0a7040e42c74db6d6fbc5aa3d7f7ba23eddd16d1e0","ababdd6bde2657a2132af86e92d47ff65a1e908818c33c081d42455beb71dfb2","9d012df4b85f6c1fd84d21c2a16f50eeca2dd7418a1bfc0866db6464bbd8b16b","c712a6bdf3cc6ad3e916c03d8f8c7fb09b398ac346fe79bbfa7c4ea76919f4a8","2e6d59d24ff7ac69dc9f396ece462063cf94772dd8aebeb0033841d2fdc29884","09599b00505ffb31d60801059009228f8849eaff67d3459eabb9b7ce52c1d9c2","e28fa5271e3016f1f5bca4d6a3c49bef6d1fa79c1f6456e10aa244c23372fc56","87d9786ec2f8df62c2d83cbce085376d927d756df3970c0a01bd4720d10044cb","27cb30e