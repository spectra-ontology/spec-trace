{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are sent either across the X2-, Xn- or the NG-interface, either to or from the gNB, i.e. a single 'logical channel' is used for all RRC messages transferred across network nodes. The information could originate from or be destined for another RAT.","paragraph_zero_based":51672},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":51673},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-INTER-NODE-DEFINITIONS-START","paragraph_zero_based":51674},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51675},{"literal_text_all_w_t_and_m_t":"NR-InterNodeDefinitions DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":51676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51677},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":51678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51679},{"literal_text_all_w_t_and_m_t":"IMPORTS","paragraph_zero_based":51680},{"literal_text_all_w_t_and_m_t":"    AffectedCarrierFreqCombList-r16,","paragraph_zero_based":51681},{"literal_text_all_w_t_and_m_t":"    AffectedCarrierFreqRangeCombList-r18,","paragraph_zero_based":51682},{"literal_text_all_w_t_and_m_t":"    ARFCN-ValueNR,","paragraph_zero_based":51683},{"literal_text_all_w_t_and_m_t":"    ARFCN-ValueEUTRA,","paragraph_zero_based":51684},{"literal_text_all_w_t_and_m_t":"    CandidateServingFreqListNR-r16,","paragraph_zero_based":51685},{"literal_text_all_w_t_and_m_t":"    CandidateServingFreqRangeListNR-r18,","paragraph_zero_based":51686},{"literal_text_all_w_t_and_m_t":"    CellIdentity,","paragraph_zero_based":51687},{"literal_text_all_w_t_and_m_t":"    CGI-InfoEUTRA,","paragraph_zero_based":51688},{"literal_text_all_w_t_and_m_t":"    CGI-InfoNR,","paragraph_zero_based":51689},{"literal_text_all_w_t_and_m_t":"  