{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-CBR-PriorityTxConfigList-v1650","paragraph_zero_based":44664},{"literal_text_all_w_t_and_m_t":"If included, it includes the same number of entries, and listed in the same order, as in SL-CBR-PriorityTxConfigList-r16.","paragraph_zero_based":44665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44666},{"literal_text_all_w_t_and_m_t":"–SL-CBR-CommonTxConfigList","paragraph_zero_based":44667},{"literal_text_all_w_t_and_m_t":"The IE SL-CBR-CommonTxConfigList indicates the list of PSSCH transmission parameters (such as MCS, sub-channel number, retransmission number, CR limit) in sl-CBR-PSSCH-TxConfigList, and the list of CBR ranges in sl-CBR-RangeConfigList, to configure congestion control to the UE for sidelink communication.","paragraph_zero_based":44668},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList information element","paragraph_zero_based":44669},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44670},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-START","paragraph_zero_based":44671},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44672},{"literal_text_all_w_t_and_m_t":"SL-CBR-CommonTxConfigList-r16 ::=     SEQUENCE {","paragraph_zero_based":44673},{"literal_text_all_w_t_and_m_t":"    sl-CBR-RangeConfigList-r16            SEQUENCE (SIZE (1..maxCBR-Config-r16)) OF SL-CBR-LevelsConfig-r16     OPTIONAL,   -- Need M","paragraph_zero_based":44674},{"literal_text_all_w_t_and_m_t":"    sl-CBR-PSSCH-TxConfigList-r16         SEQUENCE (SIZE (1.. maxTxConfig-r16)) OF SL-CBR-PSSCH-TxConfig-r16    OPTIONAL    -- Need M","paragraph_zero_based":44675},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44676},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44677},{"literal_text_all_w_t_and_m_t":"SL-CBR-LevelsConfig-r16 ::=           SEQUENCE (SIZE (1..maxCBR-Level-r16)) OF SL-CBR-r16","paragraph_zero_based":44678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44679},{"literal_text_all_w_t_and_m_t":"SL-CBR-PSSCH-TxConfig-r16 ::=         SEQUENCE {","paragraph_zero_based":44680},{"literal_text_all_w_t_and_m_t":"    sl-CR-Limit-r16                       INTEGER(0..10000)                                                     OPTIONAL,   -- Need M","paragraph_zero_based":44681},{"literal_text_all_w_t_and_m_t":"    sl-TxParameters-r16                   SL-PSSCH-TxParameters-r16                                             OPTIONAL    -- Need M","paragraph_zero_based":44682},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44683},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44684},{"literal_text_all_w_t_and_m_t":"SL-CBR-r16 ::=                        INTEGER (0..100)","paragraph_zero_based":44685},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44686},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CBR-COMMONTXCONFIGLIST-STOP","paragraph_zero_based":44687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0dc8ba71a8ea7b001270696a1780eb29d87c1330c56daf67ca1294d370382f57","36512a0334e06b0f141f787e88a1c8908672a2535a1dedfcf1aaed896fe02105","18430a41c35a240bea2c7efbded07f74e6f6f0c2551ee0a99108ad494fe14050","1d9a54acc40bec4d155b59fd040949d5884c69b9b674062d9f2637249d915436","a863452d5c14da4b3440612991b7eb557e98b466c5996aa549ecd19c73c31c2b","26a245a5386c117ba337bc0f3c7547ea26dae38055a3729ca2f6ef7fe0e7da88","0b1e243326efbdd9eac6e623edd6997ad7b77ff9cea901029c05c45b30bf5081","0d365fee0243a30342384ef38ec2ebac7084771cac1b39d1ef4e9a09db41e9d1","3b2262cea