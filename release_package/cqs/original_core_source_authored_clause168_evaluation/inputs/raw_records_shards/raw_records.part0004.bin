.docx:p12120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12144},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-START","paragraph_zero_based":12145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12146},{"literal_text_all_w_t_and_m_t":"MIB ::=                             SEQUENCE {","paragraph_zero_based":12147},{"literal_text_all_w_t_and_m_t":"    systemFrameNumber                   BIT STRING (SIZE (6)),","paragraph_zero_based":12148},{"literal_text_all_w_t_and_m_t":"    subCarrierSpacingCommon             ENUMERATED {scs15or60, scs30or120},","paragraph_zero_based":12149},{"literal_text_all_w_t_and_m_t":"    ssb-SubcarrierOffset                INTEGER (0..15),","paragraph_zero_based":12150},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeA-Position                 ENUMERATED {pos2, pos3},","paragraph_zero_based":12151},{"literal_text_all_w_t_and_m_t":"    pdcch-ConfigSIB1                    PDCCH-ConfigSIB1,","paragraph_zero_based":12152},{"literal_text_all_w_t_and_m_t":"    cellBarred                          ENUMERATED {barred, notBarred},","paragraph_zero_based":12153},{"literal_text_all_w_t_and_m_t":"    intraFreqReselection                ENUMERATED {allowed, notAllowed},","paragraph_zero_based":12154},{"literal_text_all_w_t_and_m_t":"    spare                               BIT STRING (SIZE (1))","paragraph_zero_based":12155},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12157},{"literal_text_all_w_t_and_m_t":"-- TAG-MIB-STOP","paragraph_zero_based":12158},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12160},{"literal_text_all_w_t_and_m_t":"MIB field descriptions","paragraph_zero_based":12161},{"literal_text_all_w_t_and_m_t":"cellBarred","paragraph_zero_based":12162},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred, as defined in TS 38.304 [20]. This field is ignored by IAB-MT and NCR-MT. This field is ignored for connectivity to NTN or ATG.","paragraph_zero_based":12163},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":12164},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.2) and uplink (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":12165},{"literal_text_all_w_t_and_m_t":"intraFreqReselection","paragraph_zero_based":12166},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells when the highest ranked cell is barred, or treated as barred by the UE, as specified in TS 38.304 [20]. This field is ignored by IAB-MT and NCR-MT.","paragraph_zero_based":12167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["399434bbec3323f0b7aefaec1d2d80734e9f68cac6cb178f1a21ace45a765356","ff44896728dd27bc5f050dc17f7212527a2128f200f5cb45b7c721f7c5e559ef","46707368e80c202906442281bd90bb66907129294b8ba200f2bea8a1b0408846","c9c1f47d55575532cd4fb757101134e1b6e6adec8a485851ba3864de04eab68d","29febb53c727638c703e1dbabf8f1c42f3c17ce56067d9c1f749820d00602b26","2caa810d3861ce0034e868c613408442bcaf42164ea6e48a2c702e0983e0c059","f9be696468f884edfb2e24779de9c04b5546661e4139c4d0d54906d75b88074d","e3fda40b6895bb94637c8b57a958b551741925a243a2f134c2a291359f2ad6d0","aa0593fdfb6b5d6b2177f84070ff03a8f4f33d254e1028c84e4f3da44b48048f","e488999795ed237b9ab7e981a8f2ee4e39931659d76671fdfd01625ee09cea0e","4674e493335734c01cf0202cec7d3038eca03b40dd15dddd6132748df041f18b","0f35e50ba77f4c2a4394a749b5056c72fe1fa36d18583775eb3f445f96868a11","cc36b01ca16d728f696be2c1759f9cb401b05371e6b6290b818fc11eff693360","4c69ce1e249359c236fde4148a89d394dadef96f452a694efd1cbfe05f4361e1","57d81bf95f5edda14a9c5887640fa1526099af0b147d475f05292386ba0f9eb9","57d1a2c292c2f0aab4bc0a3a1675167895e88797b94e8d3eca9b0d393d75553e","7c09569d31c9c1a355ebcffacebb1755cf61e05508f4cd424e7f2316ed064f33","a05bcf558ff8d8284d9bbd39832cbd59a177812ecd5f2e96cdc4c913b2cbe005","185ebb934cadfbdeb9bf4fef4d40666a999790714d5fe3e1438068bd5396d63c","30ad774ad603c520bcae33dc435d0a198c9e0a9d8644624d0948f0af361b67f7","1ab094fbd1581f5fc69f849ff8af852b2c56b8fd0e98fbd07b358e4472428538","0288d28aa4303177b430a84821fe8e2c917cb68cbeb51f324b6c36758539fd1b","c69370187d789ceb551ec59abfd431babd10b27a19cde150d0a69e68781e226d","d13e72220a7131e532204c82b4529da16e21092cd8a7ebf878429d665dee5df3"],"paragraph_range_zero_based":[12144,12167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12144"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdcch-ConfigSIB1","paragraph_zero_based":12168},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET), a common search space and necessary PDCCH parameters. If the field ssb-SubcarrierOffset indicates that SIB1 is absent, the field pdcch-ConfigSIB1 indicates the frequency positions where the UE may find SS/PBCH block with SIB1 or the frequency range where the network does not provide SS/PBCH block with SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":12169},{"literal_text_all_w_t_and_m_t":"ssb-SubcarrierOffset","paragraph_zero_based":12170},{"literal_text_all_w_t_and_m_t":"Corresponds to kSSB (see TS 38.213 [13]), which is the frequency domain offset between SSB and the overall resource block grid in number of subcarriers. (See TS 38.211 [16], clause 7.4.3.1). For operation with shared spectrum channel access in FR1 (see 37.213 [48]), this field corresponds to kSSB, and kSSB is obtained from  (see TS 38.211 [16], clause 7.4.3.1); the LSB of this field is used also for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":12171},{"literal_text_all_w_t_and_m_t":"The value range of this field may be extended by an additional most significant bit encoded within PBCH as specified in TS 38.213 [13].","paragraph_zero_based":12172},{"literal_text_all_w_t_and_m_t":"This field may indicate that this cell does not provide SIB1 and that there is hence no CORESET#0 configured in MIB (see TS 38.213 [13], clause 13). In this case, the field pdcch-ConfigSIB1 may indicate the frequency positions where the UE may (not) find a SS/PBCH with a control resource set and search space for SIB1 (see TS 38.213 [13], clause 13).","paragraph_zero_based":12173},{"literal_text_all_w_t_and_m_t":"subCarrierSpacingCommon","paragraph_zero_based":12174},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages. If the UE acquires this MIB on an FR1 carrier frequency, the value scs15or60 corresponds to 15 kHz and the value scs30or120 corresponds to 30 kHz. If the UE acquires this MIB on an FR2 carrier frequency, the value scs15or60 corresponds to 60 kHz and the value scs30or120 corresponds to 120 kHz. For operation with shared spectrum channel access in FR1 (see 37.213 [48]) and for operation in FR2-2, the subcarrier spacing for SIB1, Msg.2/4 and MsgB for initial access, paging and broadcast SI-messages is same as that for the corresponding SSB. For operation with shared spectrum channel access, this field instead is used for deriving the QCL relation between SS/PBCH blocks as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":12175},{"literal_text_all_w_t_and_m_t":"systemFrameNumber","paragraph_zero_based":12176},{"literal_text_all_w_t_and_m_t":"The 6 most significant bits (MSB) of the 10-bit System Frame Number (SFN). The 4 LSB of the SFN are conveyed in the PBCH transport block as part of channel coding (i.e. outside the MIB encoding), as defined in clause 7.1 in TS 38.212 [17].","paragraph_zero_based":12177},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12178},{"literal_text_all_w_t_and_m_t":"–MobilityFromNRCommand","paragraph_zero_based":12179},{"literal_text_all_w_t_and_m_t":"The MobilityFromNRCommand message is used to command handover from NR to E-UTRA/EPC, E-UTRA/5GC or UTRA-FDD.","paragraph_zero_based":12180},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":12181},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":12182},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":12183},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":12184},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand message","paragraph_zero_based":12185},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12186},{"literal_text_all_w_t_and_m_t":"-- TAG-MOBILITYFROMNRCOMMAND-START","paragraph_zero_based":12187},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12188},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand ::=           SEQUENCE {","paragraph_zero_based":12189},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":12190},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":12191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0cbcab2fb624a3d0c3bafe75873f2635af444f98ddcba217ff62a04a6ebb6465","50d95a323ec32b8fb5ea1b46abb9d9e92f354ce97528b252a6fc4dd2cba65707","bb42deeb97370448d10b1b1b0a23bad0506f262e23b7003fcb77744dc4879bda","209bb7b3eec2f411db66cfadf4741aac96c9fb89acfb6065a07a3c83c3f5bb2e","a26dfe2f156a2b446676e6003ad0e009961104186290ee604ed3b868b7587687","0c75ff920ca872761fc33fded2dfb7aab4debe0a3ee7de4e7c7b75201695e950","15df475a6eda5daedbbe2cccde7b3ec62984da6e733f0cc336d58fabb9dc1446","4b09757e8cd334da47301d358805b4773d955ec6a6cc6cf2e35c755d65b0c1f7","46136a5e241f354418a46cd97de4a0d433ca216127a3d3b9f5190c712a7970c0","ea84418db82a68b71291c5a3af456a35b8e1d641dc2331feb2a5f32b7c9bf8d3","97b60cc9d300069985a0010c9126e44c3a5dfcf8df48e9137d0ff1e85f1b92cc","13cbdd020bc4ca9bdc72bb210ed65e7eb7acf016e7005f0a141be03907fe834d","57b39ce1f98bd94d67627f880012c244537541dfad46080dc0c1308d89d09b6d","d6736b3ffa7df1fcc970c30c228f0af037cffe7fb259f12b221935d8aa59a98a","e8ae1b61643000ca273