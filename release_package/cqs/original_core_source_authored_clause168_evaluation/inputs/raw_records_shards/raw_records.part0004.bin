{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-GapAssistanceConfig","paragraph_zero_based":45408},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for gap preference.","paragraph_zero_based":45409},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityAssistanceConfig","paragraph_zero_based":45410},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to provide MUSIM assistance information for gap(s) priority or MUSIM gaps keep preference.","paragraph_zero_based":45411},{"literal_text_all_w_t_and_m_t":"musim-GapProhibitTimer","paragraph_zero_based":45412},{"literal_text_all_w_t_and_m_t":"Prohibit timer for MUSIM assistance information reporting for gap preference.","paragraph_zero_based":45413},{"literal_text_all_w_t_and_m_t":"musim-LeaveAssistanceConfig","paragraph_zero_based":45414},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for leaving RRC_CONNECTED for MUSIM purpose.","paragraph_zero_based":45415},{"literal_text_all_w_t_and_m_t":"musim-LeaveWithoutResponseTimer","paragraph_zero_based":45416},{"literal_text_all_w_t_and_m_t":"Indicates the timer for the UE to enter RRC_IDLE for MUSIM purpose as defined in clause 5.3.8.6.","paragraph_zero_based":45417},{"literal_text_all_w_t_and_m_t":"musim-ProhibitTimer","paragraph_zero_based":45418},{"literal_text_all_w_t_and_m_t":"Indicates the prohibit timer for UE temporary restricted capabilities for MUSIM operation. Value in milliseconds. Value ms0 means prohibit timer is set to 0 milliseconds, value ms10 means prohibit timer is set to 10 milliseconds and so on.","paragraph_zero_based":45419},{"literal_text_all_w_t_and_m_t":"musim-WaitTimer","paragraph_zero_based":45420},{"literal_text_all_w_t_and_m_t":"Indicates the wait timer for UE temporary restricted capabilities for MUSIM operation. Value in milliseconds. Value ms10 means wait timer is set to 10 milliseconds, value ms20 means wait timer is set to 20 milliseconds and so on.","paragraph_zero_based":45421},{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":45422},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":45423},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":45424},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":45425},{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":45426},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":45427},{"literal_text_all_w_t_and_m_t":"pdu-SessionsToReportUL-TrafficInfoList","paragraph_zero_based":45428},{"literal_text_all_w_t_and_m_t":"A list of PDU sessions for which the UE shall report UL traffic information.","paragraph_zero_based":45429},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":45430},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":45431}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558e