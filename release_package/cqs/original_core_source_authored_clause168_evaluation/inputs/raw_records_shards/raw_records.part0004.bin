{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UL-PDCP-ExcessDelayResult-r17 ::= SEQUENCE {","paragraph_zero_based":25416},{"literal_text_all_w_t_and_m_t":"    drb-Id-r17                        DRB-Identity,","paragraph_zero_based":25417},{"literal_text_all_w_t_and_m_t":"    excessDelay-r17                   INTEGER (0..31),","paragraph_zero_based":25418},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25419},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25421},{"literal_text_all_w_t_and_m_t":"TimeBetweenEvent-r17 ::= INTEGER (0..1023)","paragraph_zero_based":25422},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25423},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTS-STOP","paragraph_zero_based":25424},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25426},{"literal_text_all_w_t_and_m_t":"MeasResultEUTRA field descriptions","paragraph_zero_based":25427},{"literal_text_all_w_t_and_m_t":"eutra-PhysCellId","paragraph_zero_based":25428},{"literal_text_all_w_t_and_m_t":"Identifies the physical cell identity of the E-UTRA cell for which the reporting is being performed. The UE reports a value in the range 0..503, other values are reserved.","paragraph_zero_based":25429},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25430},{"literal_text_all_w_t_and_m_t":"MeasResultNR field descriptions","paragraph_zero_based":25431},{"literal_text_all_w_t_and_m_t":"averageDelay","paragraph_zero_based":25432},{"literal_text_all_w_t_and_m_t":"Indicates average delay for the packets during the reporting period, as specified in TS 38.314 [53]. Value 0 corresponds to 0 millisecond, value 1 corresponds to 0.1 millisecond, value 2 corresponds to 0.2 millisecond, and so on.","paragraph_zero_based":25433},{"literal_text_all_w_t_and_m_t":"cellResults","paragraph_zero_based":25434},{"literal_text_all_w_t_and_m_t":"Cell level measurement results.","paragraph_zero_based":25435},{"literal_text_all_w_t_and_m_t":"choCandidate","paragraph_zero_based":25436},{"literal_text_all_w_t_and_m_t":"This field indicates whether the associated cell is a candidate target cell for conditional handover or conditional PSCell change or addition. This field may be included only in the SuccessHO-Report or SuccessPSCell-Report within UEInformationResponse message.","paragraph_zero_based":25437},{"literal_text_all_w_t_and_m_t":"choConfig","paragraph_zero_based":25438},{"literal_text_all_w_t_and_m_t":"If the associated cell is a candidate target cell for conditional handover, this field indicates the conditional handover execution condition for each measId within condTriggerConfig associated to the cell. This field may be included only in the rlf-report within UEInformationResponse message.","paragraph_zero_based":25439}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["91216946a1971007044b9f1896ce8461e17b7d861f3793f2a0ca05b84d16939e","8a4b42af519b85acc1c883234fb63524b8847ee9a3ef4611c502ae2079c09dd4","dbf804c3b63d4415af6e5c2ffb2460160a0409936173a7faf11a53d61bdf5221","b863d78633dcc98ca94fcf315df049c4691ee720ee8874868e003576019c8a2a","b2ba6fd72537c2804f156ed1d4fa70b631d3fc5c812833809654cfd081cc0d56","b40b08503010f1dac6c42cccc943b44b225d9a81579c0804430b82c6c2a77966","39257e48b3fc96d16130fb6cf341b47c666825878300b9c211ae29a8568db4af","3f5d0797abdc77257bf59749d157c62194e3b695be625ff5a7ad02abf4b8d1d4","2d6f39766017e06264ac67c742f3905e