{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList information element","paragraph_zero_based":28848},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28849},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-START","paragraph_zero_based":28850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28851},{"literal_text_all_w_t_and_m_t":"PUCCH-ConfigurationList-r16  ::=     SEQUENCE (SIZE (1..2)) OF PUCCH-Config","paragraph_zero_based":28852},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28853},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CONFIGURATIONLIST-STOP","paragraph_zero_based":28854},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28855},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28856},{"literal_text_all_w_t_and_m_t":"–PUCCH-CSI-Resource","paragraph_zero_based":28857},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-CSI-Resource is used to indicate a PUCCH resource to use for reporting on PUCCH.","paragraph_zero_based":28858},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource information element","paragraph_zero_based":28859},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28860},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CSI-RESOURCE-START","paragraph_zero_based":28861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28862},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource ::=              SEQUENCE {","paragraph_zero_based":28863},{"literal_text_all_w_t_and_m_t":"    uplinkBandwidthPartId               BWP-Id,","paragraph_zero_based":28864},{"literal_text_all_w_t_and_m_t":"    pucch-Resource                      PUCCH-ResourceId","paragraph_zero_based":28865},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28867},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CSI-RESOURCE-STOP","paragraph_zero_based":28868},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28870},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource field descriptions","paragraph_zero_based":28871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0a2f5a57162f82cfd4927a683b96f5fc7a146a9ed5ccd10e7b89610dbd669c1b","215bccb649d1335afb42e7513e13568b24d69baff0d478caa7f4c0d42e8b42ae","4db832172f3fb1d44b0b0b9d8bab27476ddb4eeedf476490f4ec6bcdc60149ff","f94a341560aa60326a2173275e2dfc7bb4aefc4260dd7beedafee37fce1fd1df","7f7618f5446769bd77461a6c9f67b2ef9306c6e42dc6ae40d81e3b41e601815c","f50a6bcfb9bd4257606a780c7a8e15afcda550708552da6d9685bac2cd5278f3","56ee2de6c4359c6360d9b038a46538854cadbafa393d0ba896085b135930357f","50dd0130c971dd710adcbbf096cfd8d7db1e2a6dce091c2aca0b45cab2b59b29","0eaba9a13182ed511e5ab1c6fb246c872f4f17e706fa8c70e67b2076355f074d","6fc08d212f960a4d9981230299cde366c21c4c2cb54c14610ac41d992970ae5b","1a582af1e051509253fd904d48d38518b36cdb7edb1934967b57147b6a0d1fe3","6c4f7fccb044c862f3bad0bf4c11d0c6bc4dc0cdcb025cf593c4a32f2ddaab1d","2d3bf0a6ce6c5f4f65ac1d6f779defcca4d007163de8b1d59dd4b74b407f87b1","7eafa570992a2c6488ee27a9f811aa71bc53f100b556346f98fed568dccc84d9","d28228005f30f7ff45fff1484b62b68d450b8c8405e84ba6d1014ff365d16a32","4c2eaa4d1a016768dd5e9345cd19a4b2ea5f73ad23b50059a05cec78b722a6a8","307c74527e27a3952c622850e1761d7559ec1b45c964f64ebdfed908dbfbc32c","5f6dec0d508ebcfdfacf46d2ba7a5f75a10321723b7468e5bd0067d6ec662a93","8ddb1cb5ea056ecc3d42a8dff57eb4dc8bba3d6e8fda6f1fbd6892edb9b20703","a4661d076fd5a577525de33577bcc