ac1381c9d4d3a79dcadbd6f753","da9e9c1f450d0ea6ed2ba0d4323e44aa970474bcf7b66788d9c8efecacc2de7c","193d1f6a832e3825bf59768833971ef8762b34d0450a1463f5cd858b621ef0f8","684a150bd1fd345a92c263084fe56f642af0eb15aad4b73eef799cec71fba773","65478476979b7ed9b3f6da51f876d8ae6cb9b212bb818d624676b306d95983a9","ca674b67f5b49d3106c89aa79ca47e20ea74251ca758920999b83d6ef9492e3c","5c01ccd2b9a223cb8f9825ce7e9f707572980dccae248edbf7bd36777308f562","175bf398a4f90a123650b70ce1c0ec36556eb67e6218d047c7e564ec6ad7c12e","90be04033080145d611f4c53b524408ca99b507e44608336acf09a51d944231e","848b9717eefba647c2edbca0b2d489ecb785fa07c2f8459f0beba0d74f5c177f"],"paragraph_range_zero_based":[51480,51503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p51480"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-DRX-PreConfig-GC-BC","paragraph_zero_based":51504},{"literal_text_all_w_t_and_m_t":"This field indicates the sidelink DRX configuration for groupcast and broadcast communication, as specified in TS 38.321 [3].","paragraph_zero_based":51505},{"literal_text_all_w_t_and_m_t":"sl-OffsetDFN","paragraph_zero_based":51506},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on. If the field is absent, no offset is applied.","paragraph_zero_based":51507},{"literal_text_all_w_t_and_m_t":"sl-PreconfigDiscConfig","paragraph_zero_based":51508},{"literal_text_all_w_t_and_m_t":"This field indicates the configuration for discovery message transmission used by NR sidelink U2N Remote UE, used by NR sidelink U2U Relay UE or used by NR sidelink U2U Remote UE. ","paragraph_zero_based":51509},{"literal_text_all_w_t_and_m_t":"sl-PreconfigEUTRA-AnchorCarrierFreqList","paragraph_zero_based":51510},{"literal_text_all_w_t_and_m_t":"This field indicates the EUTRA anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":51511},{"literal_text_all_w_t_and_m_t":"sl-PreconfigFreqInfoList, sl-PreconfigFreqInfoListSizeExt","paragraph_zero_based":51512},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink communication and/ or NR sidelink discovery configuration some carrier frequency(ies). In this release, only one SL-FreqConfig can be configured in sl-PreconfigFreqInfoList. More entries of SL-FreqConfig can be configured in sl-PreconfigFreqInfoListSizeExt..","paragraph_zero_based":51513},{"literal_text_all_w_t_and_m_t":"sl-PreconfigNR-AnchorCarrierFreqList","paragraph_zero_based":51514},{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink communication configuration.","paragraph_zero_based":51515},{"literal_text_all_w_t_and_m_t":"sl-RadioBearerPreConfigList","paragraph_zero_based":51516},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink radio bearer configurations.","paragraph_zero_based":51517},{"literal_text_all_w_t_and_m_t":"sl-RLC-BearerPreConfigList, sl-RLC-BearerPreConfigListSizeExt","paragraph_zero_based":51518},{"literal_text_all_w_t_and_m_t":"This field indicates one or multiple sidelink RLC bearer configurations.","paragraph_zero_based":51519},{"literal_text_all_w_t_and_m_t":"sl-RoHC-Profiles","paragraph_zero_based":51520},{"literal_text_all_w_t_and_m_t":"This field indicates the supported RoHC profiles for NR sidelink communications.","paragraph_zero_based":51521},{"literal_text_all_w_t_and_m_t":"sl-SSB-PriorityNR","paragraph_zero_based":51522},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":51523},{"literal_text_all_w_t_and_m_t":"sl-SyncFreqList","paragraph_zero_based":51524},{"literal_text_all_w_t_and_m_t":"Indicates a list of candidate carrier frequencies that can be used for the synchronisation of NR sidelink communication. For SL-Freq-Id-r16, the value 1 corresponds to the frequency of first entry in sl-PreconfigFreqInfoList, the value 2 corresponds to the frequency of first entry in sl-PreconfigFreqInfoListSizeExt, the value 3 corresponds to the frequency of second entry in sl-PreconfigFreqInfoListSizeExt and so on.","paragraph_zero_based":51525},{"literal_text_all_w_t_and_m_t":"sl-SyncTxMultiFreq","paragraph_zero_based":51526},{"literal_text_all_w_t_and_m_t":"Indicates that the UE transmits S-SSB on multiple carrier frequencies for NR sidelink communication. If this field is absent, the UE transmits S-SSB only on the synchronisation carrier frequency.","paragraph_zero_based":51527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5bf5ad69023d05fc2a85af00b8aa40f840a274168b1e2167213ff1b3a93792be","cd2ec818a02ee0a97d97fd3c8a118e74f6438bbcf0eb5cee44ac389878c9f73b","872d4bb428e0925039063d96930ad623f3ebf3402687153793ef6a2886b6e588","882464ba0141719cf00867367b79374b5c95e240d230afbc0b4d1259938658a1","c20e4a45299a216ee0b917620a8af796b37b75e0f77883fa4f01cd0787d8367d","c6e460569a4be6c0cc2038f97e7bd77306697eca0dc2054cf2a6b2306bab4644","4cd82fd5096201eed42351c73da3d5e98cdc11f6c66fead5e73e10977f5f22cc","67635c7b57ac8a7ab436b9bccf52eb75ed607ce3b8704d120b2cc8b8dc4c129b","8f10a34bb21633af28db463efdc37395f44d4317daa4d32414b70862698e4485","b6e3896b50b80da4c656460ad88f2562676eef0085b86b4d2f77c977f92b8588","c7cfd9f8ae34935f234a6de07c97c3b47e6dd6b539157cc67a6ae0f657719f17","e7d469515dca850e51a51798bc7acdbd8e1e0c28d9b47d998669c662c66b5747","94da3e3466828b59f1f1730467060ad699647bed4e17e0d3958b7449b0dccb59","086a2ea3a1994464e62a29f4de90d9868c25cd7cb27c7cec61ee4ec932fcef54","db5d3d3e709c14ddfe8af4301efe4b8f63d1c989db1880a26822218eaae137bf","21992e87dc8a9ce9f50cc579ba17e9b00d4e17e980f8aff31809dea50e218ac8","16a433ac45e59f6634aa62c676219b775f3a7827d68dd0b8f574f2b16a825865","d021ac9575e0e3f374f9593ddb6703cfc3a0dbaa354f96612114aeb239ace052","326e2a476b3f0e298329b66bd9ef57381418953fd7c67b199840dd46d4db8822","2284b9270a6a9b78251dfa78ad815feec7c36281c036295995996dca47895fca","a46e9b241960e636e7fcc8301cd39ef1d21e1290f4daa888ff9b74da5a7da274","7c4c1ca265f76f5a5131a30d12f44dd63f18e513a0842c4eff85fe9ba26a6392","016eeac3b4102f654ac0de161f1f1eb527c8862352ecd9b0b4ed3926a60bca00","f0db3d010926eede42995a08f24f1e8fef7adca36