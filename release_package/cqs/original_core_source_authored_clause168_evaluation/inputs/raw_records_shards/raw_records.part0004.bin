{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39120},{"literal_text_all_w_t_and_m_t":"–FreqSeparationClass","paragraph_zero_based":39121},{"literal_text_all_w_t_and_m_t":"The IE FreqSeparationClass is used for an intra-band non-contiguous CA band combination to indicate frequency separation between lower edge of lowest CC and upper edge of highest CC in a frequency band.","paragraph_zero_based":39122},{"literal_text_all_w_t_and_m_t":"FreqSeparationClass information element","paragraph_zero_based":39123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":39124},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQSEPARATIONCLASS-START","paragraph_zero_based":39125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39126},{"literal_text_all_w_t_and_m_t":"FreqSeparationClass ::= ENUMERATED { mhz800, mhz1200, mhz1400, ..., mhz400-v1650, mhz600-v1650}","paragraph_zero_based":39127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39128},{"literal_text_all_w_t_and_m_t":"FreqSeparationClassDL-v1620 ::= ENUMERATED {mhz1000, mhz1600, mhz1800, mhz2000, mhz2200, mhz2400}","paragraph_zero_based":39129},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39130},{"literal_text_all_w_t_and_m_t":"FreqSeparationClassUL-v1620 ::= ENUMERATED {mhz1000}","paragraph_zero_based":39131},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39132},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQSEPARATIONCLASS-STOP","paragraph_zero_based":39133},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":39134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":39135},{"literal_text_all_w_t_and_m_t":"–FreqSeparationClassDL-Only","paragraph_zero_based":39136},{"literal_text_all_w_t_and_m_t":"The IE FreqSeparationClassDL-Only is used to indicate the frequency separation between lower 