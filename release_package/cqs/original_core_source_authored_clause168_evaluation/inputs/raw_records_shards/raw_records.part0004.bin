{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31896},{"literal_text_all_w_t_and_m_t":"-- TAG-RESUMECAUSE-STOP","paragraph_zero_based":31897},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31898},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31899},{"literal_text_all_w_t_and_m_t":"–RLC-BearerConfig","paragraph_zero_based":31900},{"literal_text_all_w_t_and_m_t":"The IE RLC-BearerConfig is used to configure an RLC entity, a corresponding logical channel in MAC and the linking to a PDCP entity (served radio bearer).","paragraph_zero_based":31901},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig information element","paragraph_zero_based":31902},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31903},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-START","paragraph_zero_based":31904},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31905},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig ::=                        SEQUENCE {","paragraph_zero_based":31906},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity                      LogicalChannelIdentity,","paragraph_zero_based":31907},{"literal_text_all_w_t_and_m_t":"    servedRadioBearer                           CHOICE {","paragraph_zero_based":31908},{"literal_text_all_w_t_and_m_t":"        srb-Identity                                SRB-Identity,","paragraph_zero_based":31909},{"literal_text_all_w_t_and_m_t":"        drb-Identity                                DRB-Identity","paragraph_zero_based":31910},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":31911},{"literal_text_all_w_t_and_m_t":"    reestablishRLC                              ENU