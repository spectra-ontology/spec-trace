eral_text_all_w_t_and_m_t":"requestedPosSIB-List","paragraph_zero_based":11366},{"literal_text_all_w_t_and_m_t":"Contains a list of posSIB(s) the UE requests while in RRC_CONNECTED.","paragraph_zero_based":11367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11368},{"literal_text_all_w_t_and_m_t":"PosSIB-ReqInfo field descriptions","paragraph_zero_based":11369},{"literal_text_all_w_t_and_m_t":"gnss-id","paragraph_zero_based":11370},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific GNSS. Indicates a specific GNSS (see also TS 37.355 [49])","paragraph_zero_based":11371},{"literal_text_all_w_t_and_m_t":"sbas-id","paragraph_zero_based":11372},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the request positioning SIB type is for a specific SBAS. Indicates a specific SBAS (see also TS 37.355 [49]). If the UE includes this field it shall set gnss-id to sbas.","paragraph_zero_based":11373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11374},{"literal_text_all_w_t_and_m_t":"–DLDedicatedMessageSegment","paragraph_zero_based":11375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["09d1dd5fd705c79b835e227687cbf5c996475a9d809d8d9a855987e56830f11d","53c566622630d0366ee28e025ca8e2e789cc064f300c83d7f112d61a5f8682cd","eb869a19dff61e12d5586375e40e95e43b43d44800bb865fdbe70917e76f8a58","4509a3c84b1bd6eb551b3756c39ccb1a69cc490fa9aff57bbf700387b3e36aa4","82593512b29ac54fc3fc8e978211ab200376210bf437f64a3b246592c82888d8","6e24bbf79b0ec7d453118531371b9cdc494bc9f780296e144542b158c575db83","96726aaffb323149adb63f45b2b971b7a987a41b9c9e6bf2bd253a3607789cc0","5538fd2d9a