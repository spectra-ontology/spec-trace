{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46968},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46969},{"literal_text_all_w_t_and_m_t":"CONNECTED","paragraph_zero_based":46970},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need M, in an RRCReconfiguration message, for a SL DRB with additional RLC bearer being configured. The field is absent otherwise.","paragraph_zero_based":46971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46972},{"literal_text_all_w_t_and_m_t":"–SL-L2RelayUE-Config","paragraph_zero_based":46973},{"literal_text_all_w_t_and_m_t":"The IE SL-L2RelayUE-Config is used to configure L2 U2N relay operation related configurations used by L2 U2N Relay UE, or L2 U2U relay operation related configurations used by L2 U2U Relay UE.","paragraph_zero_based":46974},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config information element","paragraph_zero_based":46975},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46976},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-START","paragraph_zero_based":46977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46978},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config-r17 ::=        SEQUENCE {","paragraph_zero_based":46979},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToAddModList-r17       SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-RemoteUE-ToAddMod-r17    OPTIONAL,    -- Need N","paragraph_zero_based":46980},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-ToReleaseList-r17      SEQUENCE (SIZE (1..maxNrofRemoteUE-r17)) OF SL-DestinationIdentity-r16  OPTIONAL,    -- Need N","paragraph_zero_based":46981},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46982},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46983},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToAddModList-r18   SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-U2U-RemoteUE-ToAddMod-r18 OPTIONAL,    -- Need N","paragraph_zero_based":46984},{"literal_text_all_w_t_and_m_t":"    sl-U2U-RemoteUE-ToReleaseList-r18  SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIdentity-r16   OPTIONAL     -- Need N","paragraph_zero_based":46985},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46986},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46987},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46988},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ToAddMod-r17 ::=       SEQUENCE {","paragraph_zero_based":46989},{"literal_text_all_w_t_and_m_t":"    sl-L2IdentityRemote-r17            SL-DestinationIdentity-r16,","paragraph_zero_based":46990},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigRelay-r17            SL-SRAP-Config-r17                                                      OPTIONAL,    -- Need M","paragraph_zero_based":46991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1a0690a8ff40ae33fdf9546c4d575555b9551a473949656cae88287ed3d8753c","6bc8c7c8a63fe913c8902eff8e57ec2dee853fc85551b3ac000c2ff0b5e590b1","5cbb048d9352acb30147118e0be28ad29fcaa6bb1588c55b8fb2d782eb55b242","3943fbc9b8a32e3e1edb09edbcf24fe743456ccb415b6b67f30fce636a2bf4f6","85007b6343435fbcfb0350e3ddf38b8b62f5f04d2cf2b048c0ae58517fd628ca","392aaf5cf44029c1a6e45065b1a18ebf3a2f9a50d0d5ffde82533349c3673db9","8909ba212c6f499916d2db433aedbb09e70412c7e5afb5c53bd6046cfe1fce9b","5fcb809fb8b8fc6556cf82cd67c8ad6e3ae8383c93bff39cbe7f613826b6e043","fb90b132e5d62663bad392e5a4835257e5