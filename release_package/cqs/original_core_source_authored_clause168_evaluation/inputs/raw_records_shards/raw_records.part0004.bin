{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17232},{"literal_text_all_w_t_and_m_t":"NOTE 1:The UE may use this field together with the leapSeconds field to obtain GPS time as follows: GPS Time (in seconds) = timeInfoUTC (in seconds) -  2,524,953,600 (seconds) + leapSeconds, where 2,524,953,600 is the number of seconds between 00:00:00 on Gregorian calendar date 1 January, 1900 and 00:00:00 on Gregorian calendar date 6 January, 1980 (start of GPS time).","paragraph_zero_based":17233},{"literal_text_all_w_t_and_m_t":"–SIB10","paragraph_zero_based":17234},{"literal_text_all_w_t_and_m_t":"SIB10 contains the HRNNs of the NPNs listed in SIB1.","paragraph_zero_based":17235},{"literal_text_all_w_t_and_m_t":"SIB10 information element","paragraph_zero_based":17236},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17237},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-START","paragraph_zero_based":17238},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17239},{"literal_text_all_w_t_and_m_t":"SIB10-r16 ::=               SEQUENCE {","paragraph_zero_based":17240},{"literal_text_all_w_t_and_m_t":"    hrnn-List-r16               HRNN-List-r16                                   OPTIONAL,   -- Need R","paragraph_zero_based":17241},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension    OCTET STRING                                    OPTIONAL,","paragraph_zero_based":17242},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17243},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17244},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17245},{"literal_text_all_w_t_and_m_t":"HRNN-List-r16 ::=           SEQUENCE (SIZE (1..maxNPN-r16)) OF HRNN-r16","paragraph_zero_based":17246},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17247},{"literal_text_all_w_t_and_m_t":"HRNN-r16 ::=                SEQUENCE {","paragraph_zero_based":17248},{"literal_text_all_w_t_and_m_t":"    hrnn-r16                    OCTET STRING (SIZE(1.. maxHRNN-Len-r16))        OPTIONAL   -- Need R","paragraph_zero_based":17249},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17250},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17251},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB10-STOP","paragraph_zero_based":17252},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17253},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17254},{"literal_text_all_w_t_and_m_t":"SIB10 field descriptions","paragraph_zero_based":17255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b822066c8c10051704e7286b6bf1dbe03e62908b246a44ec76ef4dd6895e03d4","606c52eda2adee1734ae6a6366040edf56acb4947b5f6f6509673e63c84090a6","1c1ca35d4b215d488cd7057544263b4eb5a92d5e535afe8c589a69f78b0c2200","b49a9795364403b50a85f44c75183b6761f0739442f3fe86259d9f040f5d1815","7a88bbdcdfc92983ef34dce2c51b1596316303803ce6475137d9612c6c0ef461","1b274dad5d8d65b3f3a08db977749f7070c8c6c6d94b3195fce2942e00d55d77","488d82843c4f774fb9e00f4e414c44a0e3145ab4d8921b7d71c73aedf452a87a","01b62ea965d03e2fcc7d9b56be2698a9acc53ef66a55bbc4b958dac0cd49202c","33a528c74fb3c338d38fdf6c2c74045aa20b6e89de3744941c58893bcc31bb7f","5ffb7f6da3f80cd557a152d8145ca9fa42038f1a8b7bb6329cabb15a452736c0","6337248ee449b69f06884909d180fc361d8b57da819a37e461ff95bf67bed950","d1554172bc91e55140edc2a682fab742940b937f1941a49ae456ae927f1c7975","845a1b197d84c25654319eb278e573910038688af97d26b8da743bd779491e8d","e5c5d6257638060373d7593685ffb4b04ea67668ffa1efd1d551343dc