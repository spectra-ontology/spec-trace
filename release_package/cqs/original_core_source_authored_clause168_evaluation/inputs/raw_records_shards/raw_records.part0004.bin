teral_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29629},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29630},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29631},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":29632},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":29633},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29634},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29635},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29636},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-0-2-r16 ::=           INTEGER (1..4)","paragraph_zero_based":29637},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-n8-r18 ::=            INTEGER (5..8)","paragraph_zero_based":29638},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29639}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a77f1330fa0303bb986b3698fbbe5ddb51b807427e649c8a9c4ff3d9ddcc1625","59fecfe1b3baf1a1b56731621bd4d8bedd566d230312edaf3b76af4e29f7ce14","1e0c629712b76c20f59f4e7d342dd5c58d6238b46c20a0597b0edd067edec5d7","ee2484639621fa601ec1dcba45137d25d4cbc712a5df9495f3a45445093c469b","e37e92cd284f00cf19539c850bf5c6f2f3adcddd838cb95790abbe41b3dbcf18","695d9d7b5089f93655cdfa88067c05f950995e0874e7b8e0b36a7a7687003496","3618bd2c31570b6546ff8420e8d24ddecee2d87e87bd8b8dfb3942d06267925a","ea35725a0c8562a92f9b0eac04721da7090a28537bb5f252f776ba6c6a01f3e8","4d258c6577c4843c8fb663911db0999d6676175eb12bffeefab716e18eff55b3","24a6f2fef9f206c3dc09244953d61c570f8c799939d13f607c8fdc180fdd7155","7f4f7da36f4b3aafa91d