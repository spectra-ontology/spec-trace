{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    slotConfig-r17                      CHOICE {","paragraph_zero_based":21936},{"literal_text_all_w_t_and_m_t":"        ms4                                 INTEGER (0..255),","paragraph_zero_based":21937},{"literal_text_all_w_t_and_m_t":"        ms5                                 INTEGER (0..319),","paragraph_zero_based":21938},{"literal_text_all_w_t_and_m_t":"        ms10                                INTEGER (0..639),","paragraph_zero_based":21939},{"literal_text_all_w_t_and_m_t":"        ms20                                INTEGER (0..1279),","paragraph_zero_based":21940},{"literal_text_all_w_t_and_m_t":"        ms40                                INTEGER (0..2559)","paragraph_zero_based":21941},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL  -- Need R","paragraph_zero_based":21942},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21943},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21944},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21945},{"literal_text_all_w_t_and_m_t":"CSI-RS-Index ::=                    INTEGER (0..maxNrofCSI-RS-ResourcesRRM-1)","paragraph_zero_based":21946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21947},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCECONFIGMOBILITY-STOP","paragraph_zero_based":21948},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21950},{"literal_text_all_w_t_and_m_t":"CSI-RS-CellMobility field descriptions","paragraph_zero_based":21951},{"literal_text_all_w_t_and_m_t":"csi-rs-ResourceList-Mobility","paragraph_zero_based":21952},{"literal_text_all_w_t_and_m_t":"List of CSI-RS resources for mobility. The maximum number of CSI-RS resources that can be configured per measObjectNR depends on the configuration of associatedSSB and the support of increasedNumberofCSIRSPerMO capability (see TS 38.214 [19], clause 5.1.6.1.3).","paragraph_zero_based":21953},{"literal_text_all_w_t_and_m_t":"density","paragraph_zero_based":21954},{"literal_text_all_w_t_and_m_t":"Frequency domain density for the 1-port CSI-RS for L3 mobility. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":21955},{"literal_text_all_w_t_and_m_t":"nrofPRBs","paragraph_zero_based":21956},{"literal_text_all_w_t_and_m_t":"Allowed size of the measurement BW in PRBs. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":21957},{"literal_text_all_w_t_and_m_t":"startPRB","paragraph_zero_based":21958},{"literal_text_all_w_t_and_m_t":"Starting PRB index of the measurement bandwidth. See TS 38.211 [16], clause 7.4.1.","paragraph_zero_based":21959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bed1ffa0ace49d6addcf1dbc3d2700ba20a3c0f7520950137073d9855073d153","ccd1d9443622c17fdb211d67c23bfa82b1a17a64744eef991afafc15e67026ee","66a10dc04e67ee17baf38f1593391de4fcff36d0eec0ac98d14f4bbc74c8a3db","d4373d161a2c0e1546688fbeb6d47e91a459ac4aaf2fc115b7d478f70727f0ba","11211388d8e066904c6698502ea36cc8d66d7a479c6715e21508274738bf1a50","a19e1da98287134b0c748e29ea4fcda7f9340a8d64e8118d67b06c640ae180de","fdcdbf3ce9fb1fec1ec3f8a7442b64110e2a2d7959d86db9e3a64c3ef894f2cd","001ffd3d409362cb0d909546dd9b642f6bb534b62c530b39d2b3533836c82ae9","cc1d87f0980fa4a537b5b0f3807c534a69f5a95de367ffa4f62689588714739e","161b817704bfbfdba966b02e02dd9db925dc08e174f1c80f6dcb3a69a5bc46e0","8e7f67ac382cfe1692df7a2a0e00bef6afaf928cabfbd918dbb986053afadb6e","e21122ab379112ba9ad86a09c4d93e31b632c2c752257b480d6c78aba071ec95","27da520e2cd2081fb81c9dbd2212263e460189b43091b0f23be48f1476cb8f66","bfef2e8ff9c38756b42963a3bb5f64776fee6096686fab89f32f5d05aca98e46","6a545e19dd4debcaf8fb5a57c91e13465fdb2ea0647f15fa80f381a41c3fb3df","cc1f8a3c8a08d337a7329578091bc9f5ca0ec7acdafe4dc427364d9cae7c887a","ebcc0a722eaa85fb97d9bbcee29009357ca5b96e373210c1a95df721e94a705d","5400f115236472482f54fcadded5d19be1128b0ef8a059a1679ac3e214eca03a","1b3b8865b3b4a2fb74d8d838315857655834da654a2b06f5fa1dcc4179a8ceff","190cda8417a86f024d1ba5f3cb871e52d5fb0e0064d4cd1a89f4885187592825","0db8c54ac238b85f116effa2618578f9f0e30340ae3c6e71aef82fb958fd7905","3d3de38085a7ddbf01fcc750b78f6d753e64cd84e0ee70c15ec534140f15e329","b955ae691e0c75960ba8c27e08993b1dbc7495b50aa139353b64f353c4cf437d","546db7395379687e124ed9e5cdd4085e8875d42c812822956daab4a6b89be2c7"],"paragraph_range_zero_based":[21936,21959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21936"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21960},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceConfigMobility field descriptions","paragraph_zero_based":21961},{"literal_text_all_w_t_and_m_t":"csi-RS-CellList-Mobility","paragraph_zero_based":21962},{"literal_text_all_w_t_and_m_t":"List of cells for CSI-RS based RRM measurements.","paragraph_zero_based":21963},{"literal_text_all_w_t_and_m_t":"refServCellIndex","paragraph_zero_based":21964},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell providing the timing reference for CSI-RS resources without associatedSSB. The field may be present only if there is at least one CSI-RS resource configured without associatedSSB. If this field is absent, the UE shall use the timing of the PCell for measurements on the CSI-RS resources without associatedSSB. The CSI-RS resources and the serving cell indicated by refServCellIndex for timing reference should be located in the same band.","paragraph_zero_based":21965},{"literal_text_all_w_t_and_m_t":"subcarrierSpacing","paragraph_zero_based":21966},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of CSI-RS.","paragraph_zero_based":21967},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":21968},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":21969},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":21970},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":21971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21972},{"literal_text_all_w_t_and_m_t":"CSI-RS-Resource-Mobility field descriptions","paragraph_zero_based":21973},{"literal_text_all_w_t_and_m_t":"associatedSSB","paragraph_zero_based":21974},{"literal_text_all_w_t_and_m_t":"If this field is present, the UE may base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the cell indicated by the cellId in the CSI-RS-CellMobility. In this case, the UE is not required to monitor that CSI-RS resource if the UE cannot detect the SS/PBCH block indicated by this associatedSSB and cellId. If this field is absent, the UE shall base the timing of the CSI-RS resource indicated in CSI-RS-Resource-Mobility on the timing of the serving cell indicated by refServCellIndex. In this case, the UE is required to measure the CSI-RS resource even if SS/PBCH block(s) with cellId in the CSI-RS-CellMobility are not detected.","paragraph_zero_based":21975},{"literal_text_all_w_t_and_m_t":"CSI-RS resources with and without associatedSSB may be configured in accordance with the rules in TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":21976},{"literal_text_all_w_t_and_m_t":"csi-RS-Index","paragraph_zero_based":21977},{"literal_text_all_w_t_and_m_t":"CSI-RS resource index associated to the CSI-RS resource to be measured (and used for reporting).","paragraph_zero_based":21978},{"literal_text_all_w_t_and_m_t":"firstOFDMSymbolInTimeDomain","paragraph_zero_based":21979},{"literal_text_all_w_t_and_m_t":"Time domain allocation within a physical resource block. The field indicates the first OFDM symbol in the PRB used for CSI-RS, see TS 38.211 [16], clause 7.4.1.5.3.","paragraph_zero_based":21980},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":21981},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3 including table 7.4.1.5.2-1. The number of bits that may be set to one depend on the chosen row in that table.","paragraph_zero_based":21982},{"literal_text_all_w_t_and_m_t":"isQuasiColocated","paragraph_zero_based":21983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e5950a5b1256f459c1dd906cc99a7b1670e91209028eb680b7abd1332ce43148","d9ab44ab1ba79c3b12b91b466c6d69755b4cf3559f599e042b018d6decaf8aa2","e14ee2a2dbaf521e986785a800084d546c001ff3caddf5af932a5c6eab869eb6","ef25b70d1fa1a580cfcafa1463a6f7f079e2aa0ca217148d7d1fcffc1e9be197","181d3c9900eb8ed008e8301f05a8d8601207f9ac1df621a3bd2e0c1260a57731","73e2baba7538189494c7a69593e15a914a22320f7cf4fecc6f6c78b0fad6f68c","b8e9ba76b47f9ded14a9f5c55f56a9eeb8f1f7e2bbc783c9aa4513f50d822a15","e342fbeb3b15832b7c57d78cdb6646b75a8b56e51ef3fecdabd9def13827a344","c414dacfe754ee1ee469376fe4720167fc99b3bad9206381bd3dc029db0ff706","d1bab00edbc95003de01c08af7a45f8baa588894410f14fea5e2b456f20dcb03","0216097596b4a4c2c328cc36b12766347a4ba4499add57ac6767fba155fe01bf","667a8b0c53afea6ccf6b9f74ec0f1f656faf06abc3875b59af5bb68eb2ffc327","28626b55a5828dc0227218e541ccf497425737d36f94d1a1a7044db9ea010ead","c658b629732f2eead35134ddfe5a3ef525f31c82310165b7c4a5fcc0bef38f02","b059b81571b5821bcdb6297c3cdb5149eca3859f24705adaa5d01d69cd2f031a","2d16192a12cd7b7eab6ed2e7876254fab0ef2d40c430011502f25c7a4d0f8ae8","aefa77811414ce51c9f360a8b63490071d60699fd5fd231b5b9b4ff061f6ea63","01037385b4b41c20b98307f2ae8a3e8dec29319520be590220c975cea0bbf981","dd0adf66eef9265cc5085844dbd92194efd6884224102f718fb591c9d1db4261","7308219ce95c27f22d84f5abdec617eb31b107743e76601315775d1ff25e20ed","a8d866392bdeae5dd867d320e40cf953cad9813c98796cb5e71199d142df38a5","5bc0e5ab7cd293bce63c4b9e53e8fa941ddb5c8322765a752b31cb63cb595921","8944c4357083eab5361e3aa088b71a47c2b44ca53611b3d7e532e1290fa5faf6","3825f3d8cf2d79c0f65506adc3eba34732530a4644800d665bef8414a73872ad"],"paragraph_range_zero_based":[21960,21983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates that the CSI-RS resource is quasi co-located with the associated SS/PBCH block, see TS 38.214 [19], clause 5.1.6.1.3.","paragraph_zero_based":21984},{"literal_text_all_w_t_and_m_t":"sequenceGenerationConfig","paragraph_zero_based":21985},{"literal_text_all_w_t_and_m_t":"Scrambling ID for CSI-RS (see TS 38.211 [16], clause 7.4.1.5.2).","paragraph_zero_based":21986},{"literal_text_all_w_t_and_m_t":"slotConfig","paragraph_zero_based":21987},{"literal_text_all_w_t_and_m_t":"Indicates the CSI-RS periodicity (in milliseconds) and for each periodicity the offset (in number of slots). When subcarrierSpacing is set to kHz15, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 3/4/9/19/39 slots. When subcarrierSpacing is set to kHz30, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 7/9/19/39/79 slots. When subcarrierSpacing is set to kHz60, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 15/19/39/79/159 slots. When subcarrierSpacing is set kHz120, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 31/39/79/159/319 slots. When subcarrierSpacing is set to kHz480, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 127/159/319/639/1279 slots. When subcarrierSpacing is set to kHz960, the maximum offset values for periodicities ms4/ms5/ms10/ms20/ms40 are 255/319/639/1279/2559 slots. If slotConfig-r17 is present, UE shall ignore the slotConfig (without suffix).","paragraph_zero_based":21988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21989},{"literal_text_all_w_t_and_m_t":"–CSI-RS-ResourceMapping","paragraph_zero_based":21990},{"literal_text_all_w_t_and_m_t":"The IE CSI-RS-ResourceMapping is used to configure the resource element mapping of a CSI-RS resource in time- and frequency domain.","paragraph_zero_based":21991},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping information element","paragraph_zero_based":21992},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21993},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RS-RESOURCEMAPPING-START","paragraph_zero_based":21994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21995},{"literal_text_all_w_t_and_m_t":"CSI-RS-ResourceMapping ::=          SEQUENCE {","paragraph_zero_based":21996},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation           CHOICE {","paragraph_zero_based":21997},{"literal_text_all_w_t_and_m_t":"        row1                                BIT STRING (SIZE (4)),","paragraph_zero_based":21998},{"literal_text_all_w_t_and_m_t":"        row2                                BIT STRING (SIZE (12)),","paragraph_zero_based":21999},{"literal_text_all_w_t_and_m_t":"        row4                                BIT STRING (SIZE (3)),","paragraph_zero_based":22000},{"literal_text_all_w_t_and_m_t":"        other                               BIT STRING (SIZE (6))","paragraph_zero_based":22001},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":22002},{"literal_text_all_w_t_and_m_t":"    nrofPorts                           ENUMERATED {p1,p2,p4,p8,p12,p16,p24,p32},","paragraph_zero_based":22003},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain         INTEGER (0..13),","paragraph_zero_based":22004},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain2        INTEGER (2..12)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":22005},{"literal_text_all_w_t_and_m_t":"    cdm-Type                            ENUMERATED {noCDM, fd-CDM2, cdm4-FD2-TD2, cdm8-FD2-TD4},","paragraph_zero_based":22006},{"literal_text_all_w_t_and_m_t":"    density                             CHOICE {","paragraph_zero_based":22007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ad3d671dd115a5364c431b7380f19352241a70bd073eebbf5b1ab2ffd41844f0","cb0c847a7cd8027b40b49ea98e931fb51c1a252096198ccb6c184afaf6745d5b","e8e2363403390e583ed03cce0465d5c9daffd48f4c7314dac99de53a8cd3b5c6","7ea6ada015bdcf4738e02164e19714b076ed43d370a237f77704d346ef782616","68da64323015e8bb861f91a218f5f3ed33d994c935b25473ea2974c57f002ee9","ca5937002d0fd022dc186a928ce087764735964ea5482ccb28a668c3d7bb3230","a4d3ebfb346b473bdf5af485314cd66eb9bbc98848b767c6c3302bbce243c732","c17fa17c100645e7f35c4d2dc62587d6eb12413abb047f549cbf2a42cedef84e","95517596f326d282b651535c473b93c1a1b4492e8d2a08a15ad0cfd870024c75","fc8180162dabccaad335257ac3de5d6ebeb75d25f6dabb0fb051b65a409621e4","52eb9cc660aaa8b04148a01a1780b4433957695f8ed64c66f24a7153941a7924","f9c2cccaeec7f42996cd23d555db94d23c5fb427e66cab371e40f6dfab937794","fd00ac2b1d1705c82475a27d50cc173fe3244c00e9eedade55eb7d067af5c9d2","2fbae6e22c0cd6e3514897fee445224c5e7f2dc2c8ee8c9f5f60e7109c2780d7","cd1bd288ed00302cd61aa60be5af21e66ee335d16cd0faba14350fe0ea75fcaf","28a2c76d0d3bcf14cf1ecf40e7442417082f9a0e1755ed2bfa21a10ee83deeb1","9189751f21e10ddf16e2b8a66b9787a4558ac3cb47f7ed41b31c38145f047508","265b962936e6cd009a8ff24c738c65c9c0d27e544c73313cfeb78af3c1abb132","eccca1e714210896f028e6fecdd54bac405a50d82135bde1c4dbcdf2e3f99f96","fd9fe808f3a0a9aef2aaaa4b3b447201fe2bb6354c88d2a702260694c320811e","d1333f75a800bdf9fe139976b5c76d47924e126b9cf3c738e35619dd015096ca","b65d87e939c474a88cb5584bfdaf89c2920a59ac9ad1b320f4f1d01128ea6f0a","bddc44f40c93beaf6a59d3abdc8df05a753cd4d178de7d4f5d2e99d1da8e9e14","2d5754aee7be9e1834743534131975bc6f7edd555d9d1f6b92a352eb0d001b0e"],"paragraph_range_zero_based":[21984,22007],"projection":"All 