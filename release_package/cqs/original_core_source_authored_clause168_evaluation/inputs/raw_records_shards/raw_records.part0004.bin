{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31849},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGTOADDMODLIST-STOP","paragraph_zero_based":31850},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31852},{"literal_text_all_w_t_and_m_t":"–ReportInterval","paragraph_zero_based":31853},{"literal_text_all_w_t_and_m_t":"The IE ReportInterval indicates the interval between periodical reports. The ReportInterval is applicable if the UE performs periodical reporting (i.e. when reportAmount exceeds 1) when reportType is set to either eventTriggered, periodical, cli-EventTriggered or cli-Periodical. Value ms120 corresponds to 120 ms, value ms240 corresponds to 240 ms and so on, while value min1 corresponds to 1 min, min6 corresponds to 6 min and so on.","paragraph_zero_based":31854},{"literal_text_all_w_t_and_m_t":"ReportInterval information element","paragraph_zero_based":31855},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31856},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-START","paragraph_zero_based":31857},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31858},{"literal_text_all_w_t_and_m_t":"ReportInterval ::=                  ENUMERATED {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960,","paragraph_zero_based":31859},{"literal_text_all_w_t_and_m_t":"                                                    min1,min6, min12, min30 }","paragraph_zero_based":31860},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31861},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTINTERVAL-STOP","paragraph_zero_based":31862},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":31863},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31864},{"literal_text_all_w_t_and_m_t":"–ReselectionThreshold","paragraph_zero_based":31865},{"literal_text_all_w_t_and_m_t":"The IE ReselectionThreshold is used to indicate an Rx level threshold for cell reselection. Actual value of threshold = field value * 2 [dB].","paragraph_zero_based":31866},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold information element","paragraph_zero_based":31867},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":31868},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLD-START","paragraph_zero_based":31869},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31870},{"literal_text_all_w_t_and_m_t":"ReselectionThreshold ::=                INTEGER (0..31)","paragraph_zero_based":31871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e0f58856917eb72d4fd7708ab6a449c684a85c8743e7dbc7dafc5f57283906fa","c3c589f9a26a0a469a3c17d9ab525a043455f9a9e6dec8ea7bd5979af6220409","ebef80dfda22f17b6ead73ef4660c225c33e6f5a32d4ac3c3077a1a82e70481e","c29fc57a379e546c68ea182fe5eb17a162fd72aa9e257a6a88dcb9a9d72e36f5","b960a5e10fa1c86af1ca10bd67236233be911529198fa26281ab95e005ac8a82","71dd0a65a30e2a0a740e49372f926c3433eb045ffd6f636be902313aa2910793","bb30f5c621354ead4d7312c174a3f47bb1177cc714a0f6f947714f8196a4f73f","6d61784348841b18b468ca728690f09e45f1501fa5543ae98b9b39e44f8abbbd","94c5f89c6445de0b9afa0705ddd698a8a7030608f6dc43175e9c62b5c902fa08","ecbd0aabb96a73bc072a09751613273de3942e5b5a85d667f3bf0db795411ba3","411485f88078d3c7ab8e3f36fb9ce3c6559a46e726dde03fa8fc6793a0cc0762","0a7c3b6661578f4535da8a8b5922e03fd42487301df3e8a54a8bfdc4d2657123","2fd978cff53ab44008