{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26569},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFOEUTRA-STOP","paragraph_zero_based":26570},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26571},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26572},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoEUTRA field descriptions","paragraph_zero_based":26573},{"literal_text_all_w_t_and_m_t":"needForNCSG-EUTRA","paragraph_zero_based":26574},{"literal_text_all_w_t_and_m_t":"Indicates the measurement gap and NCSG requirement information for E-UTRA measurement.","paragraph_zero_based":26575},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26576},{"literal_text_all_w_t_and_m_t":"NeedForNCSG-EUTRA field descriptions","paragraph_zero_based":26577},{"literal_text_all_w_t_and_m_t":"bandEUTRA","paragraph_zero_based":26578},{"literal_text_all_w_t_and_m_t":"Indicates the EUTRA target band to be measured.","paragraph_zero_based":26579},{"literal_text_all_w_t_and_m_t":"gapIndication","paragraph_zero_based":26580},{"literal_text_all_w_t_and_m_t":"Indicates whether measurement gap or NCSG is required for the UE to perform measurements on the concerned EUTRA target band while NR-DC or NE-DC is not configured. The UE determines this information based on the resultant configuration of the RRCReconfiguration message or RRCResume message that triggers this response. Value gap indicates that a measurement gap is needed, value ncsg indicates that NCSG is needed, value nogap-noncsg indicates neither a measurement gap nor a NCSG is needed. Value nogap-noncsg also indicates interruption is not needed.","paragraph_zero_based":26581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26582},{"literal_text_all_w_t_and_m_t":"–NeedForGapNCSG-InfoNR","paragraph_zero_based":26583},{"literal_text_all_w_t_and_m_t":"The IE NeedForGapNCSG-InfoNR indicates whether measurement gap or NCSG is required for the UE to perform SSB based measurements on an NR target band while NR-DC or NE-DC is not configured.","paragraph_zero_based":26584},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR information element","paragraph_zero_based":26585},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26586},{"literal_text_all_w_t_and_m_t":"-- TAG-NEEDFORGAPNCSG-INFONR-START","paragraph_zero_based":26587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26588},{"literal_text_all_w_t_and_m_t":"NeedForGapNCSG-InfoNR-r17 ::=     SEQUENCE {","paragraph_zero_based":26589},{"literal_text_all_w_t_and_m_t":"    intraFreq-needForNCSG-r17         NeedForNCSG-IntraFreqList-r17,","paragraph_zero_based":26590},{"literal_text_all_w_t_and_m_t":"    interFreq-needForNCSG-r17         NeedForNCSG-BandListNR-r17","paragraph_zero_based":26591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1b45e174a3a1973d595bc2af92dc2407798433aa5bc30f28897ceded67caed39","71204a815b3c16511fc8859ad644b0a4c8c3fba27a22bab9a77e84d8e59ee530","e1d610037070e447de9c3f612d4695e410abaa5ac2c489e1cb34bd475905a447","e5ece48f16792a7c305e49a969b2a6ef88149f58fd62c90ca8efbd0df48b787f","a75988ab18f98a59b223466638082eb74fb8fc95fd60dbba9708767e118895b1","b81ece45d81f8e7c034f076c1428c42eb2f4ad566208e2eb89439bfc822596ee","c3e5d8a3ae581d1cd9ac3d2ee96bf91b60dd5ecd915d4ff47ebc3014bcdd4831","29218026245c6a9c91059c0d9936c6190e8bedaa1fc3cd11cbcc0b0d525843a2","14ec53523a4f270bb3deef65d8ea6c51d9bd93f3ecc869359