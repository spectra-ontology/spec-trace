267d3ba4bdc58cc1c8c5fab2b4afb79efea66e","4edb5ba7f3ff26a0262df717c0bad1adbb0f133e9e0be4279b2d26f100c4f084","26a19b4fbeef850262c9b773dc4d4155dbb7902a815de02b86e20d8291cc1fad","7602629f4c93915e14232fc2e892fb2ae0cff9c30028ffd6627932e4445f016a","131c53e2d7d71f2f0220f7512403c3b82e4ea2b0c560154e8faefc0f780a5226"],"paragraph_range_zero_based":[696,719],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p696"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"vertical-r18INTEGER (0..255)","paragraph_zero_based":720},{"literal_text_all_w_t_and_m_t":"},","paragraph_zero_based":721},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":722},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":723},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":724},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":726},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":727},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":728},{"literal_text_all_w_t_and_m_t":"NotSameAsPrev","paragraph_zero_based":729},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in the first entry of the NR-TRP-LocationInfoPerFreqLayer in the nr-TRP-LocationInfo list; otherwise it is optionally present, need OP.","paragraph_zero_based":730},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":731},{"literal_text_all_w_t_and_m_t":"NR-TRP-LocationInfo field descriptions","paragraph_zero_based":732},{"literal_text_all_w_t_and_m_t":"referencePoint","paragraph_zero_based":733},{"literal_text_all_w_t_and_m_t":"This field specifies the reference point used to define the location of TRPs provided in the trp-LocationInfoList. If this field is absent, the reference point is the same as in the previous entry of the NR-TRP-LocationInfoPerFreqLayer in the NR-TRP-LocationInfo list.","paragraph_zero_based":734},{"literal_text_all_w_t_and_m_t":"trp-LocationInfoList","paragraph_zero_based":735},{"literal_text_all_w_t_and_m_t":"This field provides the antenna reference point locations of the DL-PRS Resources for the TRPs together with integrity information and comprises the following sub-fields:","paragraph_zero_based":736},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ID: This field is used along with a DL-PRS Resource Set ID and a DL-PRS Resource ID to uniquely identify a DL-PRS Resource, and is associated to a single TRP.","paragraph_zero_based":737},{"literal_text_all_w_t_and_m_t":"-nr-PhysCellID: This field specifies the physical cell identity of the associated TRP.","paragraph_zero_based":738},{"literal_text_all_w_t_and_m_t":"-nr-CellGlobalID: This field specifies the NCGI, the globally unique identity of a cell in NR, of the associated TRP.","paragraph_zero_based":739},{"literal_text_all_w_t_and_m_t":"-nr-ARFCN: This field specifies the NR-ARFCN of the TRP's CD-SSB (as defined in TS 38.300 [47]) corresponding to nr-PhysCellID.","paragraph_zero_based":740},{"literal_text_all_w_t_and_m_t":"-associated-DL-PRS-ID: This field, if present, specifies the dl-PRS-ID of the associated TRP from which the trp-location or trp-LocationCartesian information is adopted. If the field is present, the field trp-Location and trp-LocationCartesian shall be absent.","paragraph_zero_based":741},{"literal_text_all_w_t_and_m_t":"-trp-Location, trp-LocationCartesian: This field provides the location of the TRP relative to the referencePoint location either in geodetic coordinates (trp-Location) or local Cartesian coordinates (trp-LocationCartesian). If none of trp-Location, trp-LocationCartesian is present, the TRP location coincides with the referencePoint location, unless the field associated-dl-PRS-ID is present, in which case the trp-Location or trp-LocationCartesian is adopted from the associated TRP indicated by associated-dl-PRS-ID.","paragraph_zero_based":742},{"literal_text_all_w_t_and_m_t":"-nr-IntegrityTRP-LocationBounds: This field provides the mean and standard deviation TRP location error bound which is the mean value and the standard deviation of an overbounding model that bounds the TRP location error. This field comprises the following sub-fields:","paragraph_zero_based":743}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["cf98e43553ce5caaec430fea49e9f928c32a4dca5997f766c67fc7e2f2486482","3c6a25c6ce98d5e5c7389208f291feb91fc0a922c609d1a194aca71e95ad58f0","590692beec95fea87a2d5ea5f171e0ad9a542c76d3de9df44d647c7af39e9808","7332429f0b50dc42b1412fc0397ad6c8312ff844b688b6d30c8d829bc4ae54ce","ffda53de6576d22ee2568b4adc5ce02133356f28fbb2b8e908e1100e69e35443","9b0f00ca61ae67fbbc723ba84266295c23d738cb8551f551375e7955b3e6d776","df572800e53a9faa71b4ce52766c94b6c81cf776adb4719018ece9ca9310b501","b2f98b60482eae1dce601d34371245cb81f59523aa9d71166e28ff4ea4745ef3","416ae187c5678b9692f4cc00861c62edcfcf89b4bb3dfa854e59f86d151bbab7","adf59473d39c917440c67eacfa1abf37ea6828ee10f983141d1ad655dd119446","b4e5bbefd7576e6abe7ac9b188d165a5104ef8e24495f3347f868b526101a2a3","e9515eb0ac73203c08485006985b059424b3ccc65d030b804eccd0404a9e26ec","640c9448e132992e652e908ddf0bbec8e3ea398d61e9ad85277200d68c4ec118","be228bcf527aae32253f4a66657b710a41440980fcb8f558388dc829d30c7708","2e6fbe53f4c8fcc778086c23d3caec1794f4a28f36ec685cff367bf3392d58a2","6aeb44ec88e04905d249f045e490eacef9785bfd2fff53a0eb59fe35ca1a9ba0","8cd2ed0e658302de19aea2d8f48a077f5fcc95b397ce4d08704ee9b65b20bd65","ac33bf7594a5333e1e97406a2062ee5ce587eaab25b3c15e6d9c9aab8d86da17","f1f822d154aea31459d4efe0c4a9ef076f42d69673cca5d6a0c9d9e1a1fcf4f3","6753771d5ccb02127cb3563feb2c0c099fa12110db88fff6bbe9bc6f31f426cb","ba4c1f739b80b6ab81b6943ed1ce70fc9d8fcd1e264ccb962cf05b49baf583c6","688241ca4dc86e0cbd9bd1933b313f48962d8209c1ece26f88008b71b7af7c22","24f9bee749d66f0689afc5caa8d4236676988f612eb74e89954423251806e76b","b60a8d21753047b20c97cd56d52fa048ea4688ad9e37b1416ab583736c2bf992"],"paragraph_range_zero_based":[720,743],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p720"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-units: This field specifies the units (scale factor) for the meanLocationErrorBound and stdDevLocationErrorBound. Enumerated values mm, cm, and m correspond to 10-3 metre, 10-2 metre, and 1 metre, respectively.","paragraph_zero_based":744},{"literal_text_all_w_t_and_m_t":"-meanLocationErrorBound: This field specifies the mean TRP Location Error bound in horizontal and vertical direction, which are the mean values for a set of two overbounding models that bound the TRP location error in horizontal and vertical directions.","paragraph_zero_based":745},{"literal_text_all_w_t_and_m_t":"Scale factor is 1 with units provided in units field.","paragraph_zero_based":746},{"literal_text_all_w_t_and_m_t":"-stdDevLocationErrorBound: This field specifies the standard deviation TRP Location Error bound in horizontal and vertical direction, which are the standard deviation values for a set of two overbounding models that bound the TRP location error in horizontal and vertical directions.","paragraph_zero_based":747},{"literal_text_all_w_t_and_m_t":"Scale factor is 1 with units provided in units field.","paragraph_zero_based":748},{"literal_text_all_w_t_and_m_t":"-trp-DL-PRS-ResourceSets: This field provides the antenna reference point location(s) of the DL-PRS Resource Set(s) associated with this TRP together with integrity information. If this field is absent, the antenna reference point location(s) of the DL-PRS Resource Set(s) coincides with the trp-Location/trp-LocationCartesian location. This field comprises the following sub-fields:","paragraph_zero_based":749},{"literal_text_all_w_t_and_m_t":"-dl-PRS-ResourceSetARP, dl-PRS-ResourceSetARP-Cartesian: This field provides the antenna reference point location of the DL-PRS Resource Set relative to the trp-Location or trp-LocationCartesian location. If none of dl-PRS-ResourceSetARP, dl-PRS-ResourceSetARP-Cartesian is present, the antenna reference point location of this DL-PRS Resource Set coincides with the trp-Location or trp-LocationCartesian location.","paragraph_zero_based":750},{"literal_text_all_w_t_and_m_t":"-nr-IntegrityDL-PRS-ResourceSetARP-LocationBounds: This field provides the mean and the standard deviation ARP of the location error bound of the DL-PRS Resource Set of an overbounding model that bounds the antenna reference point location error of the DL-PRS Resource Set. This field comprises the sub-fields units, meanLocationErrorBound, and stdDevLocationErrorBound, as described under nr-IntegrityTRP-LocationBounds.","paragraph_zero_based":751},{"literal_text_all_w_t_and_m_t":"-dl-PRS-Resource-ARP-List: This field provides the antenna reference point location(s) of the DL-PRS Resource(s) associated with this Resource Set of the TRP together with integrity information. If this field is absent, the antenna reference point location(s) of the DL-PRS Resources coincides with the dl-PRS-ResourceSetARP location or dl-PRS-ResourceSetARP-Cartesian. This field comprises the following sub-fields:","paragraph_zero_based":752},{"literal_text_all_w_t_and_m_t":"-dl-PRS-Resource-ARP-location, dl-PRS-Resource-ARP-locationCartesian: This field provides the antenna reference point location of the DL-PRS Resource associated with the DL-PRS Resource Set of the TRP relative to the dl-PRS-ResourceSetARP/dl-PRS-ResourceSetARP-Cartesian location. If none of dl-PRS-Resource-ARP-location, dl-PRS-Resource-ARP-locationCartesian is present, the antenna reference point location of this DL-PRS Resource coincides with the dl-PRS-ResourceSetARP location or dl-PRS-Resource-ARP-locationCartesian.","paragraph_zero_based":753},{"literal_text_all_w_t_and_m_t":"-nr-IntegrityDL-PRS-ResourceARP-LocationBounds: This field provides the mean and the standard deviation ARP of the location error bound of the DL-PRS Resources of an overbounding model that bounds the antenna reference point location error of the DL-PRS Resource. This field comprises the sub-fields units, meanLocationErrorBound, and stdDevLocationErrorBound, as described under nr-IntegrityTRP-LocationBounds.","paragraph_zero_based":754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":755},{"literal_text_all_w_t_and_m_t":"NOTE 5:The locations may be provided in either geodetic coordinates (RelativeLocation) or local Cartesian coordinates (RelativeCartesianLocation), but not both.","paragraph_zero_based":756},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":757},{"literal_text_all_w_t_and_m_t":"6.5.2.2GNSS Assistance Data Elements","paragraph_zero_based":758},{"literal_text_all_w_t_and_m_t":"–GNSS-LOS-NLOS-GridPoints","paragraph_zero_based":759},{"literal_text_all_w_t_and_m_t":"The IE GNSS-LOS-NLOS-GridPoints is used by the location server to provide a list of grid point coordinates or an array of correction points (\"grid\") for which specific assistance data can be provided.","paragraph_zero_based":760},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":761},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":762},{"literal_text_all_w_t_and_m_t":"GNSS-LOS-NLOS-GridPoints-r18 ::= SEQUENCE {","paragraph_zero_based":763},{"literal_text_all_w_t_and_m_t":"gridPointsSetID-r18INTEGER (0..16383),","paragraph_zero_based":764},{"literal_text_all_w_t_and_m_t":"horizontalGridPoints-r18ArrayOfGridPoints-r18,","paragraph_zero_based":765},{"literal_text_all_w_t_and_m_t":"referenceAltitudeFine-r18INTEGER (0..9)OPTIONAL, -- Need OP","paragraph_zero_based":766},{"literal_text_all_w_t_and_m_t":"verticalGridPoints-r18VerticalGridPoints-r18OPTIONAL, -- Cond 3D","paragraph_zero_based":767}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d6