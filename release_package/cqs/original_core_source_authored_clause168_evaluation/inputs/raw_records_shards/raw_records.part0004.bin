{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–ULInformationTransfer","paragraph_zero_based":16296},{"literal_text_all_w_t_and_m_t":"The ULInformationTransfer message is used for the uplink transfer of NAS or non-3GPP dedicated information, or IAB-DU specific F1-C related information.","paragraph_zero_based":16297},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB2 or SRB1 (only if SRB2 not established yet). If SRB2 is suspended, the UE does not send this message until SRB2 is resumed. If only dedicatedInfoF1c is included, SRB2 is used.","paragraph_zero_based":16298},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":16299},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":16300},{"literal_text_all_w_t_and_m_t":"Direction: UE to network","paragraph_zero_based":16301},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer message","paragraph_zero_based":16302},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16303},{"literal_text_all_w_t_and_m_t":"-- TAG-ULINFORMATIONTRANSFER-START","paragraph_zero_based":16304},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16305},{"literal_text_all_w_t_and_m_t":"ULInformationTransfer ::=           SEQUENCE {","paragraph_zero_based":16306},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":16307},{"literal_text_all_w_t_and_m_t":"        ulInformationTransfer               ULInformationTransfer-IEs,","paragraph_zero_based":16308},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":16309},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":16310},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16311},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_