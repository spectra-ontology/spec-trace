{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":29832},{"literal_text_all_w_t_and_m_t":"RepTypeB2","paragraph_zero_based":29833},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if pusch-RepTypeIndicatorDCI-0-1 or pusch-RepTypeIndicatorDCI-0-2 is set to pusch-RepTypeB. It is absent otherwise.","paragraph_zero_based":29834},{"literal_text_all_w_t_and_m_t":"SRSsets","paragraph_zero_based":29835},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when UE is configured with two SRS sets in either srs-ResourceSetToAddModList or srs-ResourceSetToAddModListDCI-0-2 with usage codebook or non-codebook.","paragraph_zero_based":29836},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29837},{"literal_text_all_w_t_and_m_t":"–PUSCH-ConfigCommon","paragraph_zero_based":29838},{"literal_text_all_w_t_and_m_t":"The IE PUSCH-ConfigCommon is used to configure the cell specific PUSCH parameters.","paragraph_zero_based":29839},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon information element","paragraph_zero_based":29840},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29841},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-START","paragraph_zero_based":29842},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29843},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon ::=                  SEQUENCE {","paragraph_zero_based":29844},{"literal_text_all_w_t_and_m_t":"    groupHoppingEnabledTransformPrecoding   ENUMERATED {enabled}                                                OPTIONAL,   -- Need R","paragraph_zero_based":29845},{"literal_text_all_w_t_and_m_t":"    pusch-TimeDomainAllocationList          PUSCH-TimeDomainResourceAllocationList                              OPTIONAL,   -- Need R","paragraph_zero_based":29846},{"literal_text_all_w_t_and_m_t":"    msg3-DeltaPreamble                      INTEGER (-1..6)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":29847},{"literal_text_all_w_t_and_m_t":"    p0-NominalWithGrant                     INTEGER (-202..24)                                                  OPTIONAL,   -- Need R","paragraph_zero_based":29848},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29849},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29851},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-CONFIGCOMMON-STOP","paragraph_zero_based":29852},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29853},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29854},{"literal_text_all_w_t_and_m_t":"PUSCH-ConfigCommon field descriptions","paragraph_zero_based":29855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e721927e5df5c24d590cb1b7f40dabff817f5c6dd0e3ae9edb9a2a21623fdff6","b39a3f1d5f4520e08fbc8a78dff4c8fea26984adf9e4980ab60bbd1020915b12","707797de590780a98f0a61be3394c2c8780d03db9903ffd90b275d52a711b6ab","a4049f6ceb41e9f1171b5ec59f1d653ec95ee2d06c26ecee22933652b78fe639","159fe81aacdc7226c11decf0f75fcabea4f2ffdfef2d966724efa6060d83a163","87b77b37ad8463cac371bb46e45091af2c3649286ca50c251d47cbde4388b975","617fff6e29be441009c6903367e72c25c3f0bab2dd4378e35aaaa22121c59b9f","4f80dd0be0561121d2c3f58b5af82f50c2b12b0e86dccac91089c1e5fedf6e08","2238ad140d65e69e0b33f946708c9acde8495cfd319dc2