{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The first element contains the first MCC digit, the second element the second MCC digit and so on. If the field is absent, it takes the same value as the mcc of the immediately preceding IE PLMN-Identity. See TS 23.003 [21].","paragraph_zero_based":28320},{"literal_text_all_w_t_and_m_t":"mnc","paragraph_zero_based":28321},{"literal_text_all_w_t_and_m_t":"The first element contains the first MNC digit, the second element the second MNC digit and so on. See TS 23.003 [21].","paragraph_zero_based":28322},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28323},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28324},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28325},{"literal_text_all_w_t_and_m_t":"MCC","paragraph_zero_based":28326},{"literal_text_all_w_t_and_m_t":"This field is mandatory present when PLMN-Identity is not used in a list or if it is the first entry of PLMN-Identity in a list. Otherwise it is optionally present, Need S.","paragraph_zero_based":28327},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28328},{"literal_text_all_w_t_and_m_t":"–PLMN-IdentityInfoList","paragraph_zero_based":28329},{"literal_text_all_w_t_and_m_t":"The IE PLMN-IdentityInfoList includes a list of PLMN identity information.","paragraph_zero_based":28330},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList information element","paragraph_zero_based":28331},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28332},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITYINFOLIST-START","paragraph_zero_based":28333},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28334},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfoList ::=               SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-IdentityInfo","paragraph_zero_based":28335},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28336},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityInfo ::=                   SEQUENCE {","paragraph_zero_based":28337},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityList                       SEQUENCE (SIZE (1..maxPLMN)) OF PLMN-Identity,","paragraph_zero_based":28338},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode                        TrackingAreaCode                                            OPTIONAL,       -- Need R","paragraph_zero_based":28339},{"literal_text_all_w_t_and_m_t":"    ranac                                   RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":28340},{"literal_text_all_w_t_and_m_t":"    cellIdentity                            CellIdentity,","paragraph_zero_based":28341},{"literal_text_all_w_t_and_m_t":"    cellReservedForOperatorUse              ENUMERATED {reserved, notReserved},","paragraph_zero_based":28342},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["079ab8acc66d286579f839ddb9b1f89fb904c045f6b78a146b2332138fce2663","afd5f577ff9a1670a90ee918c1e3bfac5c802c3c72bc1240f3d9f9d3bc6ed63d","870229805d67b5c6cf35dfc60fc8a3ff1c0156ef6300a9d4f09fcb3ca3b8d415","6d9e09905e56dcd785ada73fb12eee5bd6fe57e646e699818efe143f3ec7acb4","1391561445a7793d378d7f9ef8c3b5b8ec0c3ed5d2255e4e6eb92a51803d5f92","077fafba68f3996b5fca7f72eec47bb177d3b4537a18c2ba8d18e09de475f686","8414b1574e8ed25e7c17e0520b74af08dcb81e8ca806fdb2072e7986fd6fa1e8","8c9cb7797c3a783140782a0a134cb4fb1223742c85d91c3832134b1495cce177","6d594a8cbd1eb04db1aa6c2ed0957de815