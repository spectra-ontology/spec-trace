{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44136},{"literal_text_all_w_t_and_m_t":"–RRC-TransactionIdentifier","paragraph_zero_based":44137},{"literal_text_all_w_t_and_m_t":"The IE RRC-TransactionIdentifier is used, together with the message type, for the identification of an RRC procedure (transaction).","paragraph_zero_based":44138},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier information element","paragraph_zero_based":44139},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44140},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-START","paragraph_zero_based":44141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44142},{"literal_text_all_w_t_and_m_t":"RRC-TransactionIdentifier ::=       INTEGER (0..3)","paragraph_zero_based":44143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44144},{"literal_text_all_w_t_and_m_t":"-- TAG-RRC-TRANSACTIONIDENTIFIER-STOP","paragraph_zero_based":44145},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44146},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44147},{"literal_text_all_w_t_and_m_t":"–Sensor-NameList","paragraph_zero_based":44148},{"literal_text_all_w_t_and_m_t":"The IE Sensor-NameList is used to indicate the names of the sensors which the UE is configured to measure.","paragraph_zero_based":44149},{"literal_text_all_w_t_and_m_t":"Sensor-NameList information element","paragraph_zero_based":44150},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44151},{"literal_text_all_w_t_and_m_t":"-- TAG-SENSORNAMELIST-START","paragraph_zero_based":44152},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44153},{"literal_text_all_w_t_and_m_t":"Sensor-NameList-r16 ::= SEQUENCE {","paragraph_zero_based":44154},{"literal_text_all_w_t_and_m_t":"    measUncomBarPre-r16     ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":44155},{"literal_text_all_w_t_and_m_t":"    measUeSpeed             ENUMERATED {true}            OPTIONAL,  -- Need R","paragraph_zero_based":44156},{"literal_text_all_w_t_and_m_t":"    measUeOrientation       ENUMERATED {true}            OPTIONAL   -- Need R","paragraph_zero_based":44157},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44158},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f2e986cd5a1863f538b446c1481134aa77a791245f3ee430a3634ab305720cda","25169a3cf7b43ddb358a48d5b89609db99b96a201349613189cefddeb45200fb","5ce1b1a3393c0efe5a452d19100243ae485ab4c0116031b91244bea7b811eac0","c93066c52f47f9f7c0a2fba40251e841b44c96a21e3c7232ee2051a534cfb322","ca99ff6f9f71bc75338f9dbfad1218a0721ad2f4717b8a360025abebb22016b2","902ae00b5a2e44d6f402e4f3b966dad40e92b50b1b5b4828b652317333481c31","4e8c02841b54c276b60370ab1cd44e7b6ebc2a9f00fe59c6853a48cd6e3b1bb3","a455a02ff5faa946453a6f9cc79c109497098982a5b65b30ca0f58c25c28609a","317c716843a19d292d221132ed722efbeee8c6f838c4b5760f440b2ef1a37563","61d1143c019f31d769e3bbabf315dfa1429e112d5a71bbb55cebfd4c8324eec5","6966dbe766bab16f7bbff851b4be91a65ea894c24928e22ee0dd73469127467d","8b9f4a284d5c9772196e8234d91aae6de6c299c212b61bb1cc5f920a4f195d66","4db5d6918bd875e58c844d9330a7855ac2b22974ec69ecf7ce23f7cafee095c7","efbcd3fb0716d33bd31371de3aeaaa22f832bd8bf9eb38391b4e23eb14370d3b","169020292a960b2a1e9c10ef54cb108d030e85d2dc0be5dd39ffadfa1d6eb99a","12067a3800e6ff09a7806cbc6ea480a258468a355645768fbaf82dcf6c64cd77","959c198e96cae08ea20d12cad782dc84afadfc92731a0d0d3b1