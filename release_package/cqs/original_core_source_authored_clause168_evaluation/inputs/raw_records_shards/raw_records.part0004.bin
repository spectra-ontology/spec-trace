{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPOWER-STOP","paragraph_zero_based":47424},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47425},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47426},{"literal_text_all_w_t_and_m_t":"–SL-TypeTxSync","paragraph_zero_based":47427},{"literal_text_all_w_t_and_m_t":"The IE SL-TypeTxSync indicates the synchronization reference type.","paragraph_zero_based":47428},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync information element","paragraph_zero_based":47429},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47430},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-START","paragraph_zero_based":47431},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47432},{"literal_text_all_w_t_and_m_t":"SL-TypeTxSync-r16 ::=                     ENUMERATED {gnss, gnbEnb, ue}","paragraph_zero_based":47433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47434},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TYPETXSYNC-STOP","paragraph_zero_based":47435},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47436},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47437},{"literal_text_all_w_t_and_m_t":"–SL-UE-SelectedConfig","paragraph_zero_based":47438},{"literal_text_all_w_t_and_m_t":"IE SL-UE-SelectedConfig specifies sidelink communication configurations used for UE autonomous resource selection.","paragraph_zero_based":47439},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig information element","paragraph_zero_based":47440},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47441},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-UE-SELECTEDCONFIG-START","paragraph_zero_based":47442},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47443},{"literal_text_all_w_t_and_m_t":"SL-UE-SelectedConfig-r16 ::=                 SEQUENCE {","paragraph_zero_based":47444},{"literal_text_all_w_t_and_m_t":"    sl-PSSCH-TxConfigList-r16                    SL-PSSCH-TxConfigList-r16                                   OPTIONAL,    -- Cond sib12","paragraph_zero_based":47445},{"literal_text_all_w_t_and_m_t":"    sl-ProbResourceKeep-r16                      ENUMERATED {v0, v0dot2, v0dot4, v0dot6, v0dot8}             OPTIONAL,    -- Need R","paragraph_zero_based":47446},{"literal_text_all_w_t_and_m_t":"    sl-ReselectAfter-r16                         ENUMERATED {n1, n2, n3, n4, n5, n6, n7, n8, n9}             OPTIONAL,    -- Need R","paragraph_zero_based":47447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["12c365eca5f9bdb2fe849d8d57e04e44282abbbc57009cc42052fc46e6a0c106","fe7a61772b8cc8b9189ee587057d910e0430f9990f31c2ee26ec9f6a14dd095c","b4985871577b351bf71714e823fdb1143b2273c642abec8d126111200fd9907b","c2b6540571b3f170e22e80c5695cc49039a77f39121285396e29fe396fe060e4","216b3b1720484c62603fff6e102a72f6a5422a81406b83988ed0d658dd0eee5c","2eb7bd71dfa27393093b7458c503cc0a3dcd392d41015ad192418546dd41bff7","2a9dc94b200740a2232d9390907f40937021b97100ec3a3abc911348c3195247","fbe5f4c79ded201f1dfefeb2c188e3b81b5026b52c276472ca39dcf7d4bdf567","962320311bcfe48331bc41004492aede598b76402f9e5b18f4ba622f62bb9554","3f09a6b35649b8edb689c6cf21707d528a28df6da45a328d6a38ce01f2b4e68a","cf46b65a37320fc38f764435afb5fece327f94520b55d48232b443c3a92b88b0","a10df9a8f37f162c9acceb43d16147f4c060deb3686bc612924900447ce20987","0a9e4372158508829d966dddbc9c274260454bcc2ae92a45139461788bf0d952","2369ea28bf1077dd8111034eb17db8a46b29ffb294b38cb38eb7947ae0e6baa9","dd39ec61c5bedc7c4d946125728083ca91