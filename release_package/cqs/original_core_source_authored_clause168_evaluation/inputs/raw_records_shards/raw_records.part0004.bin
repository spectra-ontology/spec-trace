{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":" -And so on","paragraph_zero_based":37272},{"literal_text_all_w_t_and_m_t":"srs-TxSwitch","paragraph_zero_based":37273},{"literal_text_all_w_t_and_m_t":"Indicates supported SRS antenna switch capability for the associated band. If the UE indicates support of SRS-SwitchingTimeNR, the UE is allowed to set this field for a band with associated FeatureSetUplinkId set to 0 for SRS carrier switching.","paragraph_zero_based":37274},{"literal_text_all_w_t_and_m_t":"uplinkTxSwitchingBandParametersList-v1700","paragraph_zero_based":37275},{"literal_text_all_w_t_and_m_t":"Indicates a list of per band per band combination capabilities for UL Tx switching.","paragraph_zero_based":37276},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37277},{"literal_text_all_w_t_and_m_t":"–BandCombinationListSidelinkEUTRA-NR","paragraph_zero_based":37278},{"literal_text_all_w_t_and_m_t":"The IE BandCombinationListSidelinkEUTRA-NR contains a list of V2X sidelink and NR sidelink band combinations.","paragraph_zero_based":37279},{"literal_text_all_w_t_and_m_t":"BandCombinationListSidelinkEUTRA-NR information element","paragraph_zero_based":37280},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37281},{"literal_text_all_w_t_and_m_t":"-- TAG-BANDCOMBINATIONLISTSIDELINKEUTRANR-START","paragraph_zero_based":37282},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37283},{"literal_text_all_w_t_and_m_t":"BandCombinationListSidelinkEUTRA-NR-r16 ::= SEQUENCE (SIZE (1..maxBandComb)) OF BandCombinationParametersSidelinkEUTRA-NR-r16","paragraph_zero_based":37284},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37285},{"literal_text_all_w_t_and_m_t":"BandCombinationListSidelinkEUTRA-NR-v1630 ::= SEQUENCE (SIZE (1..maxBandComb)) OF BandCombinationParameters