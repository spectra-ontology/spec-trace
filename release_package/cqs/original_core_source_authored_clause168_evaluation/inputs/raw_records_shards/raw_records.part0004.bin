{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21792},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigId-r18 ::=              INTEGER (0..maxNrofCSI-ReportSubconfigPerCSI-ReportConfig-1-r18)","paragraph_zero_based":21793},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21794},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGID-STOP","paragraph_zero_based":21795},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21797},{"literal_text_all_w_t_and_m_t":"–CSI-ReportSubConfigTriggerList","paragraph_zero_based":21798},{"literal_text_all_w_t_and_m_t":"The IE CSI-ReportSubConfigTriggerList is used to configure a list of sub-configuration ID(s) of N sub-configurations out of L configured sub-configurations within a CSI-ReportConfig associated with a triggering state for semi-persistent CSI reporting on PUSCH and aperiodic CSI reporting.","paragraph_zero_based":21799},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigTriggerList information element","paragraph_zero_based":21800},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21801},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGTRIGGERLIST-START","paragraph_zero_based":21802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21803},{"literal_text_all_w_t_and_m_t":"CSI-ReportSubConfigTriggerList-r18 ::= SEQUENCE (SIZE(1..maxNrofCSI-ReportSubconfigPerCSI-ReportConfig-r18)) OF CSI-ReportSubConfigId-r18","paragraph_zero_based":21804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21805},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-REPORTSUBCONFIGTRIGGERLIST-STOP","paragraph_zero_based":21806},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21808},{"literal_text_all_w_t_and_m_t":"–CSI-ResourceConfig","paragraph_zero_based":21809},{"literal_text_all_w_t_and_m_t":"The IE CSI-ResourceConfig defines a group of one or more NZP-CSI-RS-ResourceSet, CSI-IM-ResourceSet and/or CSI-SSB-ResourceSet.","paragraph_zero_based":21810},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig information element","paragraph_zero_based":21811},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21812},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-RESOURCECONFIG-START","paragraph_zero_based":21813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21814},{"literal_text_all_w_t_and_m_t":"CSI-ResourceConfig ::=      SEQUENCE {","paragraph_zero_based":21815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["582c9040c8a733219c6f6391f9ce1ad13c481849e143bd8b1eeeb94cf78205c7","92065b32c69aa459e65cebb3c4337a24b86ce197f932fff1897181294dd5e4fd","8f92e261ecf0efb6048d66292cb859c92b825f394f95845f85944a4faa6280cd","f42a90b918753bd977613c2fe12e44dc43b5d441fff307d69fdca348ac3b0961","369b6af0178207ce2c960f1df3129e60e5a12ff9dc2b26981764e2dbd393dc0e","f5e132dc905052865585087a19c4e0e651e79a223aa587b7cf509f1704567844","9a89e38725b5363018d844e1d00e9a53a52bd24be5d2e4e04c8e25313ffcc65a","2015bd9836ba1e634110f31fe1a049b1a1d4f5b1c1f9ccbc3314a8d93b43cb17","5ce59ffa5402825cc21aa1715561232440706b25289d835822ca0d385038c4eb","6e8bf036bc38d12efe883ab6971100225f43c44f4c1b0bcbdcdf082e4f937711","a89738d4d933481eb4b8fe5e48b6a2f5607b4592f84ffc64af7376594fedad56","5f09c53eae003a60fcc333263edc608bdb2a291b623a6a3361b419903fe7952c","19437fe872e9cfdea78fd95129ba62cc3cb32612d20b0c3f3110d64e3b76eda4","4ae06b92f8