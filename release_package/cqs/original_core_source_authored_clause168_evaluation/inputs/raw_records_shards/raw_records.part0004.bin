ber; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["debf12a2d914b510d11261a040849381db06eb1efeb08bdc28f080487ce20838","96b14f27ef6d36cd5480b7ecaac6f9f8f605cc53ee8110846aaf2fd5c8c9c77d","55f97f622a4c3a32e5d97cd235ce7faf5abe45689ebfc0288cb8be58728a4dea","789144cc904ff05fbb1eba1430b9235854f67111a77661e227464e024fef2789","6249916c6e6fcd85ada063a7015fa8a4521c4e670c70bbce029f2acea6a85078","a8452344307b32e882e88042db7c1d1a61ab4e384087e87ad0d38278792ee67f","169272a0b523961e2959be5afac08dfb9a2e6f24c3810a9562b087b4731d00b9","7a3ca10709d23e704b5ca40d3fdda36435afff9352a25d35b8468286eb4e01e3","5f44abbc4a2a97ce4100401fbf5f24c1059a78a91d70aca15d4ce9143eeabcf9","10ff4d65fc0587d6ec15e999f1fc4a0066be2469ac7f94a1cdd293b577822f41","170c6ac7d68d9865ee6fd7b33d396914e7bdfb086906f66dc6ac94767033a48b","0f5c40b8ee106e6c79488cc100141240e9dc2dd6183dc6805c766f8cf8cd3c7a","c75d3c92f32f1bbe0d127b0d498ea60fcf055e2ab2e3b5303bd11022f1230dcc","f7115a1c74cdf7bf149351a8f3b8d58d344b2a3c725042b93429784b6e26b6c4","15f57412ed85820691c12771ea9bef94ee6a3f39c8639d870fa8e976408784b5","06e05d974ee5d0903b340aa1aec7aac747e3ce45d00871c490d08ccf81c5365b","5dfec446dfd3dda531bf7d2a37b03760614b95b8da890c572ac5f5e0d23fd4a3","427300c976f46a0bfda6df9d19f695fc2cbb15a2d31ee402e976a13aa809a70c","5a4c0793b15a7fe6cd5a7785d3ba0072894a8943aad457649844dcac1d0b673f","aae07415456f150027a6a537710056935f461f58cf60e8c7b16a8be977a822ee","ebc746516a618bc6811ae084764c07a765ccba5054d1adeeb2caaed96082c89a","46cc392c64211176f155bc593e76ca180224372772c653bfa46facd12362ffa3","74acaa07bb330207b39afff4bff942cb87c21d4de15021d5dc8a567814da2041","c37be19748290138775253fe760a4adaad373e5d676ff28e07591bfac96462c8"],"paragraph_range_zero_based":[27072,27095],"projection":"All w:t and m:t including trac