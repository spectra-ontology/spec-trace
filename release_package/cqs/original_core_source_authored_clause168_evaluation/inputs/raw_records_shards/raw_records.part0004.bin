{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47520},{"literal_text_all_w_t_and_m_t":"–CFR-ConfigMCCH-MTCH","paragraph_zero_based":47521},{"literal_text_all_w_t_and_m_t":"The IE CFR-ConfigMCCH-MTCH is used to configure the common frequency resource used for MCCH and MTCH reception.","paragraph_zero_based":47522},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH information element","paragraph_zero_based":47523},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47524},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMCCH-MTCH-START","paragraph_zero_based":47525},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47526},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH-r17 ::= SEQUENCE {","paragraph_zero_based":47527},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidthBroadcast-r17          LocationAndBandwidthBroadcast-r17  OPTIONAL,  -- Need S","paragraph_zero_based":47528},{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMCCH-r17                       PDSCH-ConfigBroadcast-r17          OPTIONAL,  -- Need S","paragraph_zero_based":47529},{"literal_text_all_w_t_and_m_t":"    commonControlResourceSetExt-r17            ControlResourceSet                 OPTIONAL   -- Cond NotSIB1CommonControlResource","paragraph_zero_based":47530},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47531},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47532},{"literal_text_all_w_t_and_m_t":"LocationAndBandwidthBroadcast-r17 ::= CHOICE {","paragraph_zero_based":47533},{"literal_text_all_w_t_and_m_t":"    sameAsSib1ConfiguredLocationAndBW          NULL,","paragraph_zero_based":47534},{"literal_text_all_w_t_and_m_t":"    locationAndBandwidth                       INTEGER (0..37949)","paragraph_zero_based":47535},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47536},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47537},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMCCH-MTCH-STOP","paragraph_zero_based":47538},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47539},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47540},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMCCH-MTCH field descriptions","paragraph_zero_based":47541},{"literal_text_all_w_t_and_m_t":"commonControlResourceSetExt","paragraph_zero_based":47542},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for searchSpaceMCCH/searchSpaceMTCH or UE-specific search space in the BWP where searchSpaceMCCH is configured. It is contained in the bandwidth of the CFR for broadcast and larger than CORESET#0.","paragraph_zero_based":47543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3a5e2723827e2172ebf21639ed2e1e363d3e5bc0b0c49de6e4be4a7a06eeae1b","ea98a37c51727c2819663902c02abe4ce06bd0ddac55cfec37977cccef454a0c","b752842c01363f1bc44c9c3500c352894d58ed02bd754e99bac5083a56a62c80","0e55c13e65ff4017aeca381a6988e7124a9b38fc6886172f7bf6db28a45dcd64","f5513882f7863cc20c8218c8447573aaa0d79b6868765af27137d3c7989c7278","5cfb6d643713a73e57abd1dc5feed9762822568434052a98d096290811425dab","09b333406a4c8c52e6d94bdded4b8844c2be2e08d6cdd1edb4561caaa8866e26","801e7c122a564c8aacbe026ae4857fb377617f030636841472eed308d164027c","40c62a021261122287319a3b470200dec9d3a626be1e3b6e8581d3412a0db0a3","08f8763e3052f519070ecbd99e83e916e8f98c103a88d8120100d1d7cbee8257","91d42f292fca3bf961207f5095e330fca2c8e99ceb0bb863d8acf2710b4cd9fa","3747537dc5b8656f906267016248300bf88dba8f3a0e949b38438455b7ce7569","7063f8ebc2844a4eb102846fd9e2d8a9bf8475358c1b86e02db95879f2710390","addedca06e5cc35e51e1a6d087bfd0f7544cd083e0d4da67fda1062165fd6a6b","88bc9d194f5115259093d694356eb616e631b75ca8eeddfba488bc7dcd1b6332","def8a63fbecb476ae57274195d562064e4636c26417c532f253dcbc0cd62193b","877cf07c023fddd8ea6bec0f17a8746b694f5076b5b2beb56f58c67c06a6ac84","70922db89f63db4e3abaf23aea531233559ac7e86d3562404f06f617d1947050","f97db1070e3eb74230f0f81a6beaf818d77f2c84f07b42724cd13f9369002c7b","3ffa62618a0ce46b22dca165542b5306317859aa059314502db3e5978ec6d976","494879fc3e46af6a4bf31299fddedbb341ac20222b0d4da54656000f3983097f","e4bfb73d7f0d28e19604a8787b3aa33333fd267c0036a28bcd6de841e54716d3","658a8e2c273e35790b4b650c5a2f4720d3160e0fddb53a8b38c75ec125ac6216","3cbad68ca91dec8f5def653403b9b57c053eb5a342d306dcaf79bb221ce4d52c"],"paragraph_range_zero_based":[47520,47543],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p47520"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"locationAndBandwidthBroadcast","paragraph_zero_based":47544},{"literal_text_all_w_t_and_m_t":"Indicates starting PRB and the number of PRBs of CFR used for MCCH and MTCH reception.","paragraph_zero_based":47545},{"literal_text_all_w_t_and_m_t":"Value sameAsSib1ConfiguredLocationAndBW means the CFR for broadcast has the same location and size as the locationAndBandwidth for initial BWP (for RedCap UEs: initialDownlinkBWP-RedCap if it is configured and includes CD-SSB and the entire CORESET#0) configured in SIB1.","paragraph_zero_based":47546},{"literal_text_all_w_t_and_m_t":"Value locationAndBandwidth is used to configure CFR with bandwidth that is larger than and fully contains the bandwidth for the initial DL BWP (for RedCap UEs: initialDownlinkBWP-RedCap if it is configured and includes CD-SSB and the entire CORESET#0) configured in SIB1 and CORESET#0. The value of the field shall be interpreted as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13].","paragraph_zero_based":47547},{"literal_text_all_w_t_and_m_t":"This field is not included in cfr-ConfigMCCH-MTCH-RedCap if initialDownlinkBWP-RedCap in SIB1 is configured but does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":47548},{"literal_text_all_w_t_and_m_t":"If the field is absent, the CFR for broadcast has the same location and size as CORESET#0.","paragraph_zero_based":47549},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMCCH","paragraph_zero_based":47550},{"literal_text_all_w_t_and_m_t":"Indicates PDSCH parameters used for MCCH transmission. If the field is absent, PDSCH parameters used for MCCH are the same as those of PDSCH configuration provided in initialDownlinkBWP in SIB1.","paragraph_zero_based":47551},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47552},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":47553},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47554},{"literal_text_all_w_t_and_m_t":"NotSIB1CommonControlResource","paragraph_zero_based":47555},{"literal_text_all_w_t_and_m_t":"The field is optional present in case commonControlResourceSet is not configured in SIB1, Need R, otherwise it is absent.","paragraph_zero_based":47556},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47557},{"literal_text_all_w_t_and_m_t":"–DRX-ConfigPTM","paragraph_zero_based":47558},{"literal_text_all_w_t_and_m_t":"The IE DRX-Config-PTM is used to configure DRX related parameters for PTM transmission as specified in TS 38.321 [3].","paragraph_zero_based":47559},{"literal_text_all_w_t_and_m_t":"DRX-Config-PTM information element","paragraph_zero_based":47560},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47561},{"literal_text_all_w_t_and_m_t":"-- TAG-DRX-CONFIGPTM-START","paragraph_zero_based":47562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47563},{"literal_text_all_w_t_and_m_t":"DRX-ConfigPTM-r17 ::=             SEQUENCE {","paragraph_zero_based":47564},{"literal_text_all_w_t_and_m_t":"    drx-onDurationTimerPTM-r17        CHOICE {","paragraph_zero_based":47565},{"literal_text_all_w_t_and_m_t":"        subMilliSeconds                   INTEGER (1..31),","paragraph_zero_based":47566},{"literal_text_all_w_t_and_m_t":"        milliSeconds                      ENUMERATED {","paragraph_zero_based":47567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cd6b3550c75c59378fb07ec87b77740b7970c3c41d996362f8cda6ab72330cce","66705d93e11c9aa90639f4d0d2ae6