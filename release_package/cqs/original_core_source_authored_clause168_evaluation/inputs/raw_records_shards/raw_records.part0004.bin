{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DMRS based L3 filter configuration:","paragraph_zero_based":46296},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter configuration for sidelink RSRP measurement result from the L1 fiter(s), as defined in TS 38.215 [9].","paragraph_zero_based":46297},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46298},{"literal_text_all_w_t_and_m_t":"–SL-RadioBearerConfig","paragraph_zero_based":46299},{"literal_text_all_w_t_and_m_t":"The IE SL-RadioBearerConfig specifies the sidelink DRB configuration information for NR sidelink communication.","paragraph_zero_based":46300},{"literal_text_all_w_t_and_m_t":"SL-RadioBearerConfig information element","paragraph_zero_based":46301},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46302},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RADIOBEARERCONFIG-START","paragraph_zero_based":46303},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46304},{"literal_text_all_w_t_and_m_t":"SL-RadioBearerConfig-r16 ::=     SEQUENCE {","paragraph_zero_based":46305},{"literal_text_all_w_t_and_m_t":"    slrb-Uu-ConfigIndex-r16           SLRB-Uu-ConfigIndex-r16,","paragraph_zero_based":46306},{"literal_text_all_w_t_and_m_t":"    sl-SDAP-Config-r16                SL-SDAP-Config-r16                                                 OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":46307},{"literal_text_all_w_t_and_m_t":"    sl-PDCP-Config-r16                SL-PDCP-Config-r16                                                 OPTIONAL,    -- Cond SLRBSetup","paragraph_zero_based":46308},{"literal_text_all_w_t_and_m_t":"    sl-TransRange-r16                 ENUMERATED {m20, m50, m80, m100, m120, m150, m180, m200, m220, m250, m270, m300, m350, m370,","paragraph_zero_based":46309},{"literal_text_all_w_t_and_m_t":"                            