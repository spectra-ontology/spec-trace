{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Wideband or partial band CSI-RS, (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":22032},{"literal_text_all_w_t_and_m_t":"frequencyDomainAllocation","paragraph_zero_based":22033},{"literal_text_all_w_t_and_m_t":"Frequency domain allocation within a physical resource block in accordance with TS 38.211 [16], clause 7.4.1.5.3. The applicable row number in table 7.4.1.5.3-1 is determined by the frequencyDomainAllocation for rows 1, 2 and 4, and for other rows by matching the values in the column Ports, Density and CDMtype in table 7.4.1.5.3-1 with the values of nrofPorts, cdm-Type and density below and, when more than one row has the 3 values matching, by selecting the row where the column (k bar, l bar) in table 7.4.1.5.3-1 has indexes for k ranging from 0 to 2*n-1 where n is the number of bits set to 1 in frequencyDomainAllocation.","paragraph_zero_based":22034},{"literal_text_all_w_t_and_m_t":"nrofPorts","paragraph_zero_based":22035},{"literal_text_all_w_t_and_m_t":"Number of ports (see TS 38.214 [19], clause 5.2.2.3.1).","paragraph_zero_based":22036},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22037},{"literal_text_all_w_t_and_m_t":"–CSI-SemiPersistentOnPUSCH-TriggerStateList","paragraph_zero_based":22038},{"literal_text_all_w_t_and_m_t":"The CSI-SemiPersistentOnPUSCH-TriggerStateList IE is used to configure the UE with list of trigger states for semi-persistent reporting of channel state information on L1. See also TS 38.214 [19], clause 5.2.","paragraph_zero_based":22039},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList information element","paragraph_zero_based":22040},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22041},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-SEMIPERSISTENTONPUSCHTRIGGERSTATELIST-START","paragraph_zero_based":22042},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22043},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerStateList ::= SEQUENCE(SIZE (1..maxNrOfSemiPersistentPUSCH-Triggers)) OF CSI-SemiPersistentOnPUSCH-TriggerState","paragraph_zero_based":22044},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22045},{"literal_text_all_w_t_and_m_t":"CSI-SemiPersistentOnPUSCH-TriggerState ::=     SEQUENCE {","paragraph_zero_based":22046},{"literal_text_all_w_t_and_m_t":"    associatedReportConfigInfo                     CSI-ReportConfigId,","paragraph_zero_based":22047},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":22048},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22049},{"literal_text_all_w_t_and_m_t":"    sp-CSI-MultiplexingMode-r17                    ENUMERATED {enabled}                                           OPTIONAL   -- Need R","paragraph_zero_based":22050},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":22051},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22052},{"literal_text_all_w_t_and_m_t":"    csi-ReportSubConfigTriggerList-r18             CSI-ReportSubConfigTriggerList-r18                             OPTIONAL,  -- Need R","paragraph_zero_based":22053},{"literal_text_all_w_t_and_m_t":"    ltm-AssociatedReportConfigInfo-r18             LTM-CSI-ReportConfigId-r18                                     OPTIONAL   -- Need R","paragraph_zero_based":22054},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f62d2a1af23b74e450ae2c21a2d2956873d5