{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell field descriptions","paragraph_zero_based":36096},{"literal_text_all_w_t_and_m_t":"servCellIndex","paragraph_zero_based":36097},{"literal_text_all_w_t_and_m_t":"The serving cell ID of the serving cell corresponding to the uplinkDirectCurrentBWP.","paragraph_zero_based":36098},{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP","paragraph_zero_based":36099},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":36100},{"literal_text_all_w_t_and_m_t":"uplinkDirectCurrentBWP-SUL","paragraph_zero_based":36101},{"literal_text_all_w_t_and_m_t":"The Tx Direct Current locations for all the supplementary uplink BWPs configured at the corresponding serving cell.","paragraph_zero_based":36102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36103},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentMoreCarrierList","paragraph_zero_based":36104},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentMoreCarrierList indicates the Tx Direct Current locations for intra-band CA including one, two or more uplink carriers. The UE does not report the uplink Direct Current location information for SUL carrier(s).","paragraph_zero_based":36105},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList information element","paragraph_zero_based":36106},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36107},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTMORECARRIERLIST-START","paragraph_zero_based":36108},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36109},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentMoreCarrierList-r17 ::=   SEQUENCE (SIZE (1..maxNrofCC-Group-r17)) OF CC-Group-r17","paragraph_zero_based":36110},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36111},{"literal_text_all_w_t_and_m_t":"CC-Group-r17 ::=           SEQUENCE {","paragraph_zero_based":36112},{"literal_text_all_w_t_and_m_t":"    servCellIndexLower-r17     ServCellIndex,","paragraph_zero_based":36113},{"literal_text_all_w_t_and_m_t":"    servCellIndexHigher-r17    ServCellIndex              OPTIONAL,","paragraph_zero_based":36114},{"literal_text_all_w_t_and_m_t":"    defaultDC-Location-r17     DefaultDC-Location-r17,","paragraph_zero_based":36115},{"literal_text_all_w_t_and_m_t":"    offsetToDefault-r17        CHOICE{","paragraph_zero_based":36116},{"literal_text_all_w_t_and_m_t":"        offsetValue                OffsetValue-r17,","paragraph_zero_based":36117},{"literal_text_all_w_t_and_m_t":"        offsetlist                 SEQUENCE (SIZE(1..maxNrofReqComDC-Location-r17)) OF OffsetValue-r17","paragraph_zero_based":36118},{"literal_text_all_w_t_and_m_t":"    }                                                     OPTIONAL","paragraph_zero_based":36119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["0cd1a2dcf68e303465fb9619fe0802a5a79d605f3b31729b81be9cff526d8456","d061e93cf630bc2bf2d97f4e03f749ebb5dcd436bcf4df82bca91569e73248f3","a2f205289a711ce48f23eb84eda33f99ee297396e1cd18a664becb4a10805594","ccc8fbc5d55e8c95e9da9bd845737a8f0cf55fe8f298117945ae5fd84d0c1e03","113e2e9d7a92a18bf05fcb79ff618cbec9554fb839c76ffac3a488cab1fee984","74528684bb5c709cecf46edfd2d9b332b2af09a5e0a3fb314e8df4c204969c9f","22f9299ab9d3875b0cd324b391d72a2f12f025ea091c218937efc658ac78d47e","0947496eccf22f588e6c32cab77e3faeba35216f9777360a04d553fa45b001f3","4149d79a94f5f4e0d7e15fddef96192d02b78dde