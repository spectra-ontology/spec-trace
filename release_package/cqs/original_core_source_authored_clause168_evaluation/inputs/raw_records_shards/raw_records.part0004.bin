{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45792},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon field descriptions","paragraph_zero_based":45793},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfigCommon","paragraph_zero_based":45794},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":45795},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":45796},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":45797},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommon","paragraph_zero_based":45798},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":45799},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonA2X","paragraph_zero_based":45800},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":45801},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonPS","paragraph_zero_based":45802},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":45803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45804},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfig","paragraph_zero_based":45805},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfig is used to configure UE specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":45806},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig information element","paragraph_zero_based":45807},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45808},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-START","paragraph_zero_based":45809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45810},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig-r17 ::=        SEQUENCE {","paragraph_zero_based":45811},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                    SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16        OPTIONAL,    -- Cond HO","paragraph_zero_based":45812},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17            SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need M","paragraph_zero_based":45813},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolScheduling-r17          SL-TxPoolDedicated-r16                                               OPTIONAL     -- Need N","paragraph_zero_based":45814},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4048f1faff6e2c2a8d32e1f12df4cc501c35e3cc9f5300c0bfc54f3ea5112d68","8e249a6ad884bcccea212349cc7a0c10880eb397db01d2a2b6e02e11fc89c2fa","e21c7806e587b6100f47503cfb390e96acb436eb6a000f76ffbd0767f2c912c6","d6fc59ddc01c93ed3935b513b15b7c62658ba282b4d6a8f2d6be944935d6a01b","bf998c103d56561fb66f34148bf7a020d7f660b33a46e2980bf9f511353da7ec","f8a1a811f3d0a9a8f34316767bf0f5bc382143a3755b634f227ede407191d8c2","d7659bb582bdaa173f79512cf45086b9512aff5131d969d2e9dc8548483bcac8","7ecf7e420d7b74c25dfb3cfb9dbc01b1ab3e46e638133c6edad9b385ed10a7d4","6007701e8c11caba6795cf892969fb41bf2964731f8911f5cbcb4d1be65ba28f","7fced6fcd92691b20ba0a4edda5614959ad1ce1c51e658ef5850ad11f7ae6657","fb1cb4500e9b87d19670d9d63821059cbceb15c47fade617df949705dd69affc","9965333c9fef14db03f1333e92d25d8684e8acecdd422f93d9a7486eb213ecba","7566a0260c830a6cef017d27de28f663588259a24b09065f5271b3b4be261aed","e81400fe19438c5ae4500840412eb724b47ba22fdb25dd2477645d8eaf27d538","3ec28b7e4ceb1b15f69206ca5fbf5d215413ca4765c672e4516e28aa46b69c78","11e0a2d118685ed337f23a426e4be654cdabc76835552163be8e2c9fe09eb702","f854b545aaa058dc8077806622d736ff37f6b43fbe53684faca9eb8a1151282b","6605911341bd29e5bf206d7921e7c26f3434c1e6c1fedf449111f52e4facf17e","2f915293f593c8eba70ae3beeaeb48d10c6b455a349fd905e440120ca5083f4b","c7fa744a86ac01bab6e27ffd79c4ce9a09af9b532aff3d0104b6464314196f18","46abaa09f8f495e3f832a68c083b804072f174b994104a7912add94885817a82","aadc602994147747ae3814604f751a775d0de39053e3cab601cb14da6b7f0200","f0f49927ccc70eb62daf76ea5166226a7f86427a973ae27ac354502a875d444f","ca0c54744fc919f7143a0087b876e9539a700537e471901d718a4ab3134616ea"],"paragraph_range_zero_based":[45792,45815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p45792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45816},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-STOP","paragraph_zero_based":45817},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45818},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45819},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig field descriptions","paragraph_zero_based":45820},{"literal_text_all_w_t_and_m_t":"sl-DiscTxPoolScheduling","paragraph_zero_based":45821},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to transmit NR sidelink discover based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":45822},{"literal_text_all_w_t_and_m_t":"When this field is configured together with sl-TxPoolScheduling, the resource pool index (which is used in DCI Format 3_0 in TS 38.212 [17], clause 7.3.1.4.1) is defined as 0, 1,  …,  x-1 for the resource pools included in the sl-TxPoolScheduling, and x, x+1, …, x+y-1 for the resource pools included in sl-DiscTxPoolScheduling, where x is the number of the resource pools in sl-TxPoolScheduling, and y is the number of resource pools in sl-DiscTxPoolScheduling.","paragraph_zero_based":45823},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45824},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45825},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45826},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":45827},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, need M.","paragraph_zero_based":45828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45829},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfigCommon","paragraph_zero_based":45830},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfigCommon is used to configure the cell-specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":45831},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon information element","paragraph_zero_based":45832},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45833},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIGCOMMON-START","paragraph_zero_based":45834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45835},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon-r17 ::= SEQUENCE {","paragraph_zero_based":45836},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                   SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16         OPTIONAL,    -- Need R","paragraph_zero_based":45837},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17           SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16   OPTIONAL,    -- Need R","paragraph_zero_based":45838},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["14c41ae62b343b074c24bb21f61805381af38f6a6c217d1a75a316d2e411774d","c45d7b6f0f26cf9b46a2ac3d633e900b534d0ea26ff711d606e03f1141cd9c1a","6a3072384c2f714c2b39b9070207f28b9fca78602fc687a1881204638d9298c0","adeaf9277756194b696c33ef7cc2ab3a8d81d70ec01f2565a0df7fde6a0559a9","9ec4dd9ffee779af83d8ce1763f3bc7d5c0a7f0b981e0fdea1170978d5a5adc0","f3c2bf657d9e4688ef7b6558f7618a02965e