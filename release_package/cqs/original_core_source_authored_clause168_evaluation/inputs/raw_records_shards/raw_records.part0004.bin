{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16848},{"literal_text_all_w_t_and_m_t":"InterFreqExcludedCellList ::=       SEQUENCE (SIZE (1..maxCellExcluded)) OF PCI-Range","paragraph_zero_based":16849},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16850},{"literal_text_all_w_t_and_m_t":"InterFreqAllowedCellList-r16 ::=    SEQUENCE (SIZE (1..maxCellAllowed)) OF PCI-Range","paragraph_zero_based":16851},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16852},{"literal_text_all_w_t_and_m_t":"InterFreqCAG-CellListPerPLMN-r16 ::= SEQUENCE {","paragraph_zero_based":16853},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityIndex-r16              INTEGER (1..maxPLMN),","paragraph_zero_based":16854},{"literal_text_all_w_t_and_m_t":"    cag-CellList-r16                    SEQUENCE (SIZE (1..maxCAG-Cell-r16)) OF PCI-Range","paragraph_zero_based":16855},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16857},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB4-STOP","paragraph_zero_based":16858},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16860},{"literal_text_all_w_t_and_m_t":"SIB4 field descriptions","paragraph_zero_based":16861},{"literal_text_all_w_t_and_m_t":"absThreshSS-BlocksConsolidation","paragraph_zero_based":16862},{"literal_text_all_w_t_and_m_t":"Threshold for consolidation of L1 measurements per RS index. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":16863},{"literal_text_all_w_t_and_m_t":"accessAllowed2RxXR","paragraph_zero_based":16864},{"literal_text_all_w_t_and_m_t":"Indicates if the cells on the frequency support 2Rx XR UEs. If present, 2Rx XR UEs shall consider only these NR frequencies in cell reselection evaluation.","paragraph_zero_based":16865},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":16866},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the neighbor cells on the inter-frequency apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the neighbor cells on the inter-frequency do not apply any channel access procedure.","paragraph_zero_based":16867},{"literal_text_all_w_t_and_m_t":"deriveSSB-IndexFromCell","paragraph_zero_based":16868},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE may use the timing of any detected cell on that frequency to derive the SSB index of all neighbour cells on that frequency. If this field is set to true, the UE assumes SFN and frame boundary alignment across cells on the neighbor frequency as specified in TS 38.133 [14].","paragraph_zero_based":16869},{"literal_text_all_w_t_and_m_t":"dl-CarrierFreq","paragraph_zero_based":16870},{"literal_text_all_w_t_and_m_t":"This field indicates center frequency of the SS block of the neighbour cells, where the frequency corresponds to a GSCN value as specified in TS 38.101-1 [15] or TS 38.101-5 [75].","paragraph_zero_based":16871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4cf1933dd7c5928f536128609177d0a61c2f3de941fca9f083bbebb8a3aa9426","2cdb920c58f9310d6515eb232736a17b220c1a56ba89f4228fd193893a1f747b","e2536dcd4b4e021dcea1f8595e32f65f7c2b75bddb0cdd9032936737b48ee803","a6f42d0dd7c5972487d6711d05bf821908941b2da1c62a8a08e7df864b9af4fb","e11c16c363541a2a784b96233cfd11671c0468cfce1337e0c411b4bbbc538852","103d651ddb6588a02beb802e28fe7c1de8e6f23f83194655af5ec4138ca3407c","37d14d9c1cb0fca03583087cc8f4d8470c378e8286e091dc7ad7585acff5e156","ec5e7bcd2a2e37db78194f05d033f1517a41b804bb4ab6c7fceab4ad8fca731a","9b0a5204ce4d5524bfd3a512e73f7fd40dd1be904c879983dd34eab82e5cb128","f3985c91e32d185e1de3ce07e3e08ebb4fa2d6e8a46a1b3360eac6a7f80857ac","6758c6e80f29d4719b5e480a9811d50eb37bb90f0be2d0fd49a890df4375db42","6679e8e9c7c1ee8abab51b58f9d9f9fed74be64cb52068ad09f2a534e397e7be","c390a7a6612feee5b3c998d83c9d39f8098d7d74062775a3e80b496010b56384","11a6247cfc063e8661c9fb03459510dfc3b875749b33b7aa7a346575925ef328","576b7aa03349ab1000b1f4547a4f88e27aa5bf18fc3c84ad099fcbb63bf2fca2","f4ea616b0961f4b806a61eef957367700e8797ed76919fb08dc8106c9dd99087","af0ebc6408b5b010789c1a601355b25892a3125458d0f2f7e2c164dd95d6edea","293ed3812196cf69944c70a4a02d5408ccdeecca2cfeb8b13f38a9b1405ca6a9","52f67c3d84c0f20b5c5f88ec0cdaae0005836115dc11e3828db326ba6c7e08d0","ed3a9021b92253fd0ebb97f58e594c0ddedfe2e1e175a39da8323ac538b75d81","2c35914a203414cd5dbe9205850c2becde62cda5a5331c54164a8584efaebac5","0dbc05f46b3c14110fc116674a025292a677f00a50a98b0b32c8123143ef576f","e5d139cf7a8c56850186163f5cae34054bf95716a6356deb0f9295d4dceb4497","3048eda168fcb5732cf6d96cdbb4ee8bd483cf3dde3b3937719ac534effd2385"],"paragraph_range_zero_based":[16848,16871],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16848"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"eRedCapAccessAllowed","paragraph_zero_based":16872},{"literal_text_all_w_t_and_m_t":"Indicates whether eRedCap UEs are allowed to access cells on the frequency.","paragraph_zero_based":16873},{"literal_text_all_w_t_and_m_t":"frequencyBandList","paragraph_zero_based":16874},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for which the NR cell reselection parameters apply.","paragraph_zero_based":16875},{"literal_text_all_w_t_and_m_t":"frequencyBandListAerial","paragraph_zero_based":16876},{"literal_text_all_w_t_and_m_t":"Indicates the list of frequency bands for aerial operation for which the NR cell reselection parameters apply. The UE behaviour in case the field is absent is described in clause 5.2.2.4.5.","paragraph_zero_based":16877},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":16878},{"literal_text_all_w_t_and_m_t":"If the field is set to true and UE supports high speed inter-frequency IDLE/INACTIVE measurements, the UE shall apply the enhanced inter-frequency RRM requirements on the inter-frequency carrier to support high speed up to 500 km/h in RRC_IDLE/RRC_INACTIVE as specified in TS 38.133 [14].","paragraph_zero_based":16879},{"literal_text_all_w_t_and_m_t":"interFreqAllowedCellList","paragraph_zero_based":16880},{"literal_text_all_w_t_and_m_t":"List of allow-listed inter-frequency neighbouring cells, see TS 38.304 [20], clause 5.2.4.","paragraph_zero_based":16881},{"literal_text_all_w_t_and_m_t":"interFreqCAG-CellList","paragraph_zero_based":16882},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring CAG cells (as defined in TS 38.304 [20] per PLMN.","paragraph_zero_based":16883},{"literal_text_all_w_t_and_m_t":"interFreqCarrierFreqList","paragraph_zero_based":16884},{"literal_text_all_w_t_and_m_t":"List of neighbouring carrier frequencies and frequency specific cell re-selection information. If interFreqCarrierFreqList-v1610, interFreqCarrierFreqList-v1700, interFreqCarrierFreqList-v1720, interFreqCarrierFreqList-v1730, interFreqCarrierFreqList-v1760 or InterFreqCarrierFreqInfo-v1800 are present, they shall contain the same number of entries, listed in the same order as in interFreqCarrierFreqList (without suffix).","paragraph_zero_based":16885},{"literal_text_all_w_t_and_m_t":"interFreqExcludedCellList","paragraph_zero_based":16886},{"literal_text_all_w_t_and_m_t":"List of exclude-listed inter-frequency neighbouring cells.","paragraph_zero_based":16887},{"literal_text_all_w_t_and_m_t":"interFreqNeighCellList","paragraph_zero_based":16888},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring cells with specific cell re-selection parameters. If interFreqNeighCellList-v1610 is present, it shall contain the same number of entries, listed in the same order as in interFreqNeighCellList (without suffix).","paragraph_zero_based":16889},{"literal_text_all_w_t_and_m_t":"interFreqNeighHSDN-CellList","paragraph_zero_based":16890},{"literal_text_all_w_t_and_m_t":"List of inter-frequency neighbouring HSDN cells as specified in TS 38.304 [20].","paragraph_zero_based":16891},{"literal_text_all_w_t_and_m_t":"mobileIAB-CellList","paragraph_zero_based":16892},{"literal_text_all_w_t_and_m_t":"Contains a PCI range on which mobile IAB cells may be deployed.","paragraph_zero_based":16893},{"literal_text_all_w_t_and_m_t":"mobileIAB-Freq","paragraph_zero_based":16894},{"literal_text_all_w_t_and_m_t":"If present, it indicates that a mobile IAB node may deployed on the inter-frequency carrier.","paragraph_zero_based":16895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["84f0d35e707e41e63da3877e246f7393c1745e1ed06a92f3e697a30c02d7fdd5","1354ddd7de2d95dcbcfe3e06f217a6b2876729a43eef40fb39a590ed4f938a1e","58e6c21e7c2139f5c155b1b1b4d312d21a400d6876111e85906bde0ab80687b1","85c037d64c8817f88b184f0a2425ef53d16f50ac7f67d1776efcdd0e486be94c","eca87f74275b496139a23bb4c868c6acf1b169f32e5b264106e11b96dcaf5c05","cddd2f7370fc73dbfdbfb30c4ee19d85960d3ef81fe0962ade50e5f293916b7f","362b8e4bb3abccd78433c919cbcf407417bbe4b12de8ae3f2a640ec205f38c5a","8463cab36bf40f5a6a2f2a792b9ee715996910a003cd3a95d8b601a00d459750","b6c3824380e977d3dc68127d776f776afb2a8d934733a2c4dc28d9f56be46a67","50f4ff61d1b16acd209a97102b571b56b1eeab2fb9e53abb0b7168c093ef460c","fe4919df92ac5ddd02149a4f7f4d613d9e3a64d8b11d67fdb11bcc0930aa1d7f","2cd06e2f11ae863767a352a6a08bb2cd1d67429c9264fd13dd84d732029984d5","ed652b4108dab8cdb6519764ebf7bf277b5e538ed1fbdd293598a7baf2097ae8","b2c3c52b412f5a88ce340392980c90681b348d1c81c5dd1b6c75463fecd03203","f9d03788e3bf8261f63a75c09556d18769d375987280aa6ff5c17444aa75e0fb","3a1884b630df4164a262200384cf7737a31d7ef07e5923ff2dcf8077888e38cc","0923726d01ba6f10b0957f917b0681da596d19dc4465cfb629ca2214b3d9001d","7a8615193866651e13139c1fff31e6ccc6884b2af2db48e8eed7f529f3eb453c","310a30afb0f9d2cbd5c67e6c4f9381f30fecab1b81d7a742a4d32e3f89c6b38c","ad6f0cd2ba92fb1a90675235d2534ed00dde32ae9c27f2af175e7855b4ccc35d","4b70a423edddf860b6f9580b36f9d97bbd60a83a6dc3b099b8e0054e380ebc18","b8e3ed459319ab88ffa5b4603d43670316deae7784e010daee6b005531fdd906","f754dc1874c457a01937f6aea22bc1353aca69fa53791ef0977201a14af9e102","e2e60d1c0c6f630fb75d3478ed7511ecfa90d6af0168b7a5723005f21513a8b1"],"paragraph_range_zero_based":[16872,16895],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16872"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nrofSS-BlocksToAverage","paragraph_zero_based":16896},{"literal_text_all_w_t_and_m_t":"Number of SS blocks to average for cell measurement derivation. If the field is absent, the UE uses the measurement quantity as specified in TS 38.304 [20].","paragraph_zero_based":16897},{"literal_text_all_w_t_and_m_t":"p-Max","paragraph_zero_based":16898},{"literal_text_all_w_t_and_m_t":"Value in dBm applicable for the neighbouring NR cells on this carrier frequency. If absent the UE applies the maximum power according to TS 38.101-1 [15] in case of an FR1 cell, TS 38.101-2 [39] in case of an FR2 cell or TS 38.101-5 [75] in case of an NTN cell. In this release of the specification, if p-Max is present on a carrier frequency in FR2, the UE shall ignore the field and applies the maximum power according to TS 38.101-2 [39]. This field is ignored by IAB-MT. The IAB-MT applies output power and emissions requirements, as specified in TS 38.174 [63].","paragraph_zero_based":16899},{"literal_text_all_w_t_and_m_t":"q-OffsetCell","paragraph_zero_based":16900},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsets,n\" in TS 38.304 [20].","paragraph_zero_based":16901},{"literal_text_all_w_t_and_m_t":"q-OffsetFreq","paragraph_zero_based":16902},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsetfrequency\" in TS 38.304 [20].","paragraph_zero_based":16903},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":16904},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20]. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.","paragraph_zero_based":16905},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":16906},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 38.304 [20]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":16907},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":16908},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":16909},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":16910},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 38.304 [20]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":16911},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCellSUL","paragraph_zero_based":16912},{"literal_text_all_w_t_and_m_t":"Parameter \"QrxlevminoffsetcellSUL\" in TS 38.304 [20]. Actual value QrxlevminoffsetcellSUL = field value * 2 [dB].","paragraph_zero_based":16913},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":16914},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20].","paragraph_zero_based":16915},{"literal_text_all_w_t_and_m_t":"redCapAccessAllowed","paragraph_zero_based":16916},{"literal_text_all_w_t_and_m_t":"Indicates whether RedCap UEs are allowed to access cells on the frequency.","paragraph_zero_based":16917},{"literal_text_all_w_t_and_m_t":"smtc","paragraph_zero_based":16918},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency measurement. If this field is absent, the UE assumes that SSB periodicity is 5 ms in this frequency. If the field is broadcast by an NTN cell, the offset (derived from parameter periodicityAndOffset) is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference.","paragraph_zero_based":16919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d751be20f1d23f853d1f6970092ee985bbfd2fbfca17abc64d18e98336b3d5b0","a676888219b441dd0f73ffc4b04d96250ee5d26d30133a1cacf318a283a72fee","059730091fcb4d60f040e59d5fb7e1c553dac59b58d8193c77b85e7c396032b0","3303b283c327e2927c3372061d0b4d1e4f008c160e4f062aad2442b9203a2b65","dc063fad3c04b785f0161d0267576e57152c5d335fd5013a9b99cd5563edb06e","6e1c50d931d323e34bdc279f6c478c3792ebc130819209df3c2fceae9d4492e7","b8844f66e84037476f1d55bc06b03d95f3bf91852fb7d5bb83ec9d92e55fe9f8","2d93bf5ebc04de6bb2c9c7ccf06280cfdc568d24d12f803552bb62b3ae4d570f","62a6be40cbd4aed53bc863aac045c9d081627e73e1c3703e7c4fbb7d596e6839","8e0e86f1abb180a29356d707b7232bfacb77f91274801f8de2b76500c4b6550d","a171c014bd9626bed16aafc9c5562a81c3d86334ef1985cdbd027049d521e5ee","0125e193cee2cc5300207a1b197a92f5476bb1e4cdbf2b8347455327821b4684","23789bc10bb696b483bb81a0b959c679314de1b850d0fd985c324177fe135c55","fa5196e4d18f1b2498a11d387702649d59a5ff6e692b2777cae991413f8ad184","ba4e2dc9cae0a00f16e6dac4c83740bd720f9e38a64664738e8db7b149a79c3b","11904039610bacf2fae4e695ca537f8ea92ca185b0dcf2b5b828146ced3c8604","a97a84f2fc69f6ca352b699bfdb6e0366b0f25684370a6ebb63401ebb1f807d9","7c44efdf03ce82a14a22636617410feba9e0b1d9d7d7e055725a8224de9088b0","7ec8a0e76bb29fcc1238ed694f2f89767240ce991205d701d841ebe9f4d0a80b","3941656b8559c4d2ae7cdf6b2ebd30d5f621674d8269d23ad73cb32cee41e562","2a2ebac889d23049d2ab30c702d357fbec7b216d828411a6ffd9c3a637337f4e","91033f62960118172ca5998de3244834766c39561bc745803ca6b07984b6c353","bdd49083de73ebef329860c3f174a2a84b44af5a36e4c6b10a992a078a9cee1f","b352c1ee035e09710eae5f11079ff5b4aad0e6babce7635d344eb3dc9eb9f9a6"],"paragraph_range_zero_based":[16896,16919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16896"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"smtc2-LP","paragraph_zero_based":16920},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration for inter-frequency neighbour cells with a Long Periodicity (LP) indicated by periodicity in smtc2-LP. The timing offset and duration are equal to the offset and duration indicated in smtc in InterFreqCarrierFreqInfo. The periodicity in smtc2-LP can only be set to a value strictly larger than the periodicity in smtc in InterFreqCarrierFreqInfo (e.g. if smtc indicates sf20 the Long Periodicity can only be set to sf40, sf80 or sf160, if smtc indicates sf160, smtc2-LP cannot be configured). The pci-List, if present, includes the physical cell identities of the inter-frequency neighbour cells with Long Periodicity. If smtc2-LP is absent, the UE assumes that there are no inter-frequency neighbour cells with a Long Periodicity.","paragraph_zero_based":16921},{"literal_text_all_w_t_and_m_t":"smtc4list","paragraph_zero_based":16922},{"literal_text_all_w_t_and_m_t":"Measurement timing configuration list for NTN deployments, see clause 5.5.2.10. The offset of each SSB-MTC4 in smtc4list is based on the assumption that the gNB-UE propagation delay difference between the serving cell and neighbour cells equals to 0 ms, and UE can adjust the actual offset based on the actual propagation delay difference. For a UE that supports less SMTCs than what is included in this list, it is up to the UE to select which SMTCs to consider.","paragraph_zero_based":16923},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":16924},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific neighbor cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the common value signalled by ssb-PositionQCL-Common in SIB4 for the indicated cell.","paragraph_zero_based":16925},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL-Common","paragraph_zero_based":16926},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for inter-frequency neighbor cells as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":16927},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":16928},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration (see TS 38.215 [9]). When the field is absent the UE measures on all SS-blocks.","paragraph_zero_based":16929},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":16930},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":16931},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":16932},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":16933},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":16934},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":16935},{"literal_text_all_w_t_and_m_t":"threshX-HighP","paragraph_zero_based":16936},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighP\" in TS 38.304 [20].","paragraph_zero_based":16937},{"literal_text_all_w_t_and_m_t":"threshX-HighQ","paragraph_zero_based":16938},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, HighQ\" in TS 38.304 [20].","paragraph_zero_based":16939},{"literal_text_all_w_t_and_m_t":"threshX-LowP","paragraph_zero_based":16940},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowP\" in TS 38.304 [20].","paragraph_zero_based":16941},{"literal_text_all_w_t_and_m_t":"threshX-LowQ","paragraph_zero_based":16942},{"literal_text_all_w_t_and_m_t":"Parameter \"ThreshX, LowQ\" in TS 38.304 [20].","paragraph_zero_based":16943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9cc1d58f8800133a8012c5d7999749da532994de0b3b5a7cfe1f60e5f67da568","6ec501497b1685eb8b37475036a29993e491823f77f9ef077a12ab0b97bdd936","7c02c20bf7e4dcb7d1486d9e3e24f812158158612b8723ce32b9665bc53ecac1","b93d00bd685e1a60b0b8b44bc5a3871aa2232ab4b9d159a50a97ec871e3ae721","e4bea66a52e0db2033a250b8bec1fc49523b659d2c94f627ba712dce9cc861c2","f7755d118c149486550f0eca5e5f13e9e62845775e1f49722a05af4d634b2873","093c36d40e94e25ccb78bd5c7f3eaa845ff705fa67388c8ae75383d2ff8c71f7","ac60df3c5538b8981a7172b6db3a1b70f2b03703a9c2bbb6c4f78d45503b2af9","31d9fb7d23117dd6469d6f123d5cabc8e9c46cba2c948362808519567e6cd7d6","c04f0c5b450705581b387d05c8bf0576980861f604a8c4892e70d3b5fa5b7490","ee0bea1edd765287e8d2bcb23135bce456a73449c5ceef032c0dd4b74a467cbe","8f564556dd65e46d7d9e80b498687763462c872b69546aa7c10d30bdab02a5e6","f367621543faa898762c7909f02b3e8335231adf90cdb61278978c186ce634e9","adf6199a471dc905835bdcc8b7cfdacf05bcee2ee97b57d1978ee10c58c080fe","eb8e74de81d80b7906087955fb58abb2ddc6bf64352aa53e0c83e92074efebd3","183ce3a0b3fab9423b5a94fd86660d35109319c44b26eec65d1661e07936a746","9d730af88907bbf791992a97ae2eae57eef4bec37ec6e23b7d146fc97192b0e0","1f886fb201376fe25da9bb177cd869b4c16946b49551ce53c38ad1149a60b6e0","bf4f7b4fc40fac4f39caba343db8fabe826c6d660aa1f2fe93c282dc83d71cdf","647c8bf8b3844d7fee0891080baf2b18e4be1d93bb9bd4cd7828a42ef0d44ff9","e82518ec81fecec7bf2da7cdc310321a74dce59a5dcef6b010e144f09ad0d7c8","92ca874e03dcea4535cb9580628d95d47261c5f25bdb4c9cafde2b8674f2e02d","6bc410b526d00d866ba829d11ebeae81917b84079911b76aca5913c73484a35e","018949c500eccded91a5b3e7f16e82bc9ba7c85880721cc1f3dc92caf782ff6b"],"paragraph_range_zero_based":[16920,16943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16920"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"tn-AreaIdList","paragraph_zero_based":16944},{"literal_text_all_w_t_and_m_t":"List of TN area identifiers. The associated coverage information is provided in SIB25.","paragraph_zero_based":16945},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR","paragraph_zero_based":16946},{"literal_text_all_w_t_and_m_t":"Parameter \"TreselectionNR\" in TS 38.304 [20].","paragraph_zero_based":16947},{"literal_text_all_w_t_and_m_t":"t-ReselectionNR-SF","paragraph_zero_based":16948},{"literal_text_all_w_t_and_m_t":"Parameter \"Speed dependent ScalingFactor for TreselectionNR\" in TS 38.304 [20]. If the field is absent, the UE behaviour is specified in TS 38.304 [20].","paragraph_zero_based":16949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16950},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":16951},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":16952},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":16953},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in SIB4.","paragraph_zero_based":16954},{"literal_text_all_w_t_and_m_t":"RSRQ","paragraph_zero_based":16955},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if threshServingLowQ is present in SIB2; otherwise it is absent.","paragraph_zero_based":16956},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":16957},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this inter-frequency operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":16958},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":16959},{"literal_text_all_w_t_and_m_t":"The field is optional present, Need R, if this inter-frequency or neighbor cell operates with shared spectrum channel access. Otherwise, it is absent, Need R.","paragraph_zero_based":16960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16961},{"literal_text_all_w_t_and_m_t":"–SIB5","paragraph_zero_based":16962},{"literal_text_all_w_t_and_m_t":"SIB5 contains information relevant only for inter-RAT cell re-selection i.e. information about E-UTRA frequencies and E-UTRAs neighbouring cells relevant for cell re-selection. The IE includes cell re-selection parameters common for a frequency.","paragraph_zero_based":16963},{"literal_text_all_w_t_and_m_t":"SIB5 information element","paragraph_zero_based":16964},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16965},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB5-START","paragraph_zero_based":16966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["aa6ee4e99b5294eda8530c6bc0b62f0dbd5f00b310daf0e1ca2162cc935d1286","e24901c5c5e867c338316fcab5e7f8054ce00600ca3cf186212464fb1ff7e4e1","51e255cb61ae0e028874d4f26218b7c787307dec62a0941fd034d2aab89fab63","c80838f4979c6fcbbda1dedf450aa6ba2aa13d42a6d7943fac9ad84da9ebfbfc","1bf11558f0aa981c4d1c175419a1d713bb1b5678bb050bb483e446b386117416","bc2afe36c7ea22b5df39fa0fc828285a2af27ef54353954fb6db6667c96d50a0","be2d92b235b8ac4334c096b301cca9441326459b3c79d5699a46e519d9e3b4ae","f39cd98cc146b613aa62b7fecd621ee3fea9de18223c0fe630e4f2937b1a7f9b","ff9e81f11e18d2333f01bf5ad301cd182f3d99f7d4cd59e2f92d2c048f2d66fb","0e38d288900cf166e397817bd31eaeaab53f6a6226123917775ca5a6d7b22803","275f490874d14ab8996db24667571c5b2b34d3e917778a7d2e190954752842eb","70a103701b959e956296d63828f310997c9124a