{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission ::=    SEQUENCE {","paragraph_zero_based":30048},{"literal_text_all_w_t_and_m_t":"    maxCodeBlockGroupsPerTransportBlock     ENUMERATED {n2, n4, n6, n8},","paragraph_zero_based":30049},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30050},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30051},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30052},{"literal_text_all_w_t_and_m_t":"MaxMIMO-LayersDCI-0-2-r16 ::=           INTEGER (1..4)","paragraph_zero_based":30053},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30054},{"literal_text_all_w_t_and_m_t":"UplinkHARQ-mode-r17 ::=                 BIT STRING (SIZE (32))","paragraph_zero_based":30055},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30056},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-SERVINGCELLCONFIG-STOP","paragraph_zero_based":30057},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30058},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30059},{"literal_text_all_w_t_and_m_t":"PUSCH-CodeBlockGroupTransmission field descriptions","paragraph_zero_based":30060},{"literal_text_all_w_t_and_m_t":"maxCodeBlockGroupsPerTransportBlock","paragraph_zero_based":30061},{"literal_text_all_w_t_and_m_t":"Maximum number of code-block-groups (CBGs) per TB (see TS 38.213 [13], clause 9.1).","paragraph_zero_based":30062},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30063},{"literal_text_all_w_t_and_m_t":"PUSCH-ServingCellConfig field descriptions","paragraph_zero_based":30064},{"literal_text_all_w_t_and_m_t":"codeBlockGroupTransmission","paragraph_zero_based":30065},{"literal_text_all_w_t_and_m_t":"Enables and configures code-block-group (CBG) based transmission (see TS 38.214 [19], clause 5.1.5).","paragraph_zero_based":30066},{"literal_text_all_w_t_and_m_t":"The network does not configure this field if the SCS of at least one UL BWP configured in the cell is 480 or 960 kHz.","paragraph_zero_based":30067},{"literal_text_all_w_t_and_m_t":"maxMIMO-Layers","paragraph_zero_based":30068},{"literal_text_all_w_t_and_m_t":"Indicates the maximum MIMO layer to be used for PUSCH in all BWPs of the corresponding UL of this serving cell (see TS 38.212 [17], clause 5.4.2.1). If present, the network sets maxRank to the same value. The field maxMIMO-Layers refers to DCI format 0_1. If network configures maxMIMO-Layers-v1810 the UE ignores maxMIMO-Layers (without suffix).","paragraph_zero_based":30069},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayersforSDM","paragraph_zero_based":30070},{"literal_text_all_w_t_and_m_t":"Parameter to indicate maximal number of MIMO layers of each panel for PUSCH with SDM scheme for NCB PUSCH","paragraph_zero_based":30071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["28a2b8c31d34a34ab97014121401f3edb91d5b870dab8bcea804e14662013bd2","ad0520d4ead4e45748516e91108d426e18c8067118121eb753a71123db015373","f276e13421629c2e93721156c02107dd4146347e4061f5d7056384ece6ec9445","b55de118bb60fa8c91303e61f018e28c088d84faa719bc9557bc9413bf5ee716","7eae9c3803cc32a0fd004eccda8b195df5f617375dcaad7748faaa10504c761d","3a1445c017821ab9179de8c76f742bd0e75a59d6710ae195b699b3e1c463cacb","6b9f25040f581ef17d61b0862f16ac26be0d81991d3e6450309aa8926540b044","387188f17dc0c3994636a3740702af65aecc8823fe0c16ad50c13a5361077d29","8af6e832bab3882e38f3ab9a12805906ae51abfd0fb67435b7a4568b6ba2fabc","ae9d734a66dfe7ff40b4eba875fb5b8191dfb0aeccc038bd30e6930093c15301","ddcebcb2dd