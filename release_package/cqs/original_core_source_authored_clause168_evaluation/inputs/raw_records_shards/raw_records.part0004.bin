_text_all_w_t_and_m_t":"","paragraph_zero_based":18783},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToAddModList-r17 ::=    SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-PreConfig-r17","paragraph_zero_based":18784},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18785},{"literal_text_all_w_t_and_m_t":"DL-PPW-PreConfigToReleaseList-r17 ::=   SEQUENCE (SIZE (1..maxNrofPPW-Config-r17)) OF DL-PPW-ID-r17","paragraph_zero_based":18786},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18787},{"literal_text_all_w_t_and_m_t":"TCI-inDCI-r18 ::=                   SEQUENCE {","paragraph_zero_based":18788},{"literal_text_all_w_t_and_m_t":"    tci-SelectionPresentInDCI-r18       ENUMERATED { enabled }                                            OPTIONAL,   -- Need R","paragraph_zero_based":18789},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-StateDCI-1-0-r18  ENUMERATED {first, second, both}                                  OPTIONAL    -- Need R","paragraph_zero_based":18790},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18791}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d18d0137c97411447bb0b7318fe22709fe926ee2b96273a60dc0097919eb5577","c56596f447500221cb19e6c4bd1dc1e861499df0cb65948b878be537c3200ef1","354f8d61b5259278c3f7566280b6ebf3fb579afe1db065588cc0f6eb94f1c58e","815ef4ce26a41b3fec3f706e8b265adb901241599c5ac543107d8d3e4ae3df3a","a8d1cf26f346fe836d80cf6c1816e297045120bfed3ad9b4c691c7b9bde87e0b","ab2db5960808d547c9b3bfc5d7115153016c82bc5487681c257b60c9c938fbf3","fcc9485d763a2262cd5c49861545290c4eca89bb6d3810437d4544af8c89ffe8","be00b93dcdccbcc95909417e4097d4ae2ac5808ad9c410720758580d433ad204","43c976b435f6426e383e7a1df14360d774cdc76e9002c265ff097f7aff6cc65b","f28b2597ee4cd85658fbca95e0f3c695c67c1bf7c01b44a3b8022c0561fd7111","481065e17578b1d4e85c9bc6bcb7eed5c3b95e1cf416b1f5619bd0955e3e5b2c","d171ebcd899a42bdc555e2a9b6cefffb415b1708ec316fc545d171c428ddd02e","35ac11094224cf4d791901e3d9eb2635f1949f3c25c8a06309ba76debbffd06b","d528e357879419aeeba67ca31dced8a2759b253145aa6492c74e5564a89642c6","dcb205ab4b4b6d701b288b156776ceab7639ac9a64ab2feac3280dd76474294c","728dc504b96d3ffd54833634024710bbb7fb72b05ee54ed1800524b3a2c97b63","ec373c3523a79de9e011263364467f9f8b353e5f5f107650639c05c184209730","e69d8fa7b2a01cf4af9196f33c85be029e60b6183362c8e7565cf960fc304a66","0324cbe5283a9a68210d3388e3b0e9029d68568b01be1b9db27650bcd5ae312a","f7e1e6bb1d38560ef429692adcaf239c02ddd845836e05033e523f09434a1391","3ad870400c97ec9721c840a231bf882aba458a0eaa3de4b50642079d4d44d3bf","dd3cfa8a17f786c86687fd8a65f1f796c71805354804cd7b6cfd8db3a0105991","8e3dffe17760c8c13925abc63a5fdf94770257a41525229dd01898242feabd10","d96c79b47c53ca74b7155748144c02a5cf6695d95323c7f4fd5470ead2dbd5c6"],"paragraph_range_zero_based":[18768,18791],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18768"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18792},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKDEDICATED-STOP","paragraph_zero_based":18793},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18794},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18795},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated field descriptions","paragraph_zero_based":18796},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-StateDCI-1-0","paragraph_zero_based":18797},{"literal_text_all_w_t_and_m_t":"This field indicates, for PDSCH reception scheduled or activated by DCI format 1_0, if UE applies the first, the second or both \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5. Only when the UE is configured with PDSCH-CJT(cjt-Scheme-PDSCH in IE ServingCellConfig) and the UE supports two joint TCI states for PDSCH-CJT or the UE is configured with PDSCH-SFN(sfnSchemePDSCH in IE ServingCellConfig), the RRC configuration can indicate both indicated joint/DL TCI states are applied. This field is absent if more than one value for the field coresetPoolIndex is configured in controlResourceSet for the same DL BWP.","paragraph_zero_based":18798},{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySCellConfig","paragraph_zero_based":18799},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on SCells.","paragraph_zero_based":18800},{"literal_text_all_w_t_and_m_t":"beamFailureRecoverySpCellConfig","paragraph_zero_based":18801},{"literal_text_all_w_t_and_m_t":"Configuration of candidate RS for beam failure recovery on the SpCell. This field can only be configured when beamFailure-r17 is configured in RadioLinkMonitoringConfig.","paragraph_zero_based":18802},{"literal_text_all_w_t_and_m_t":"cfr-ConfigMulticast","paragraph_zero_based":18803},{"literal_text_all_w_t_and_m_t":"UE specific common frequency resource configuration for MBS multicast for one dedicated BWP. This field can be configured within at most one serving cell.","paragraph_zero_based":18804},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToAddModList","paragraph_zero_based":18805},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be added or modified for the dedicated DL BWP.","paragraph_zero_based":18806},{"literal_text_all_w_t_and_m_t":"dl-PPW-PreConfigToReleaseList","paragraph_zero_based":18807},{"literal_text_all_w_t_and_m_t":"Indicates a list of DL-PRS processing window configurations to be released for the dedicated DL BWP.","paragraph_zero_based":18808},{"literal_text_all_w_t_and_m_t":"harq-FeedbackEnablingforSPSactive","paragraph_zero_based":18809},{"literal_text_all_w_t_and_m_t":"If enabled, UE reports ACK/NACK for the first SPS PDSCH after activation, regardless of if HARQ feedback is enabled or disabled for the HARQ process corresponding to the first SPS PDSCH after activation. Otherwise, UE follows configuration of HARQ feedback enabled/disabled for the HARQ process corresponding to the first SPS PDSCH after activation.","paragraph_zero_based":18810},{"literal_text_all_w_t_and_m_t":"nonCellDefiningSSB","paragraph_zero_based":18811},{"literal_text_all_w_t_and_m_t":"If configured, the UE operating in this BWP uses this SSB for the purposes for which it would otherwise have used the CD-SSB of the serving cell (e.g. obtaining sync, measurements, RLM, BFD, beam management). Furthermore, other parts of the BWP configuration that refer to an SSB (e.g. the \"SSB\" configured in the QCL-Info IE; the \"ssb-Index\" configured in the RadioLinkMonitoringRS; CFRA-SSB-Resource; PRACH-ResourceDedicatedBFR) refer implicitly to this NCD-SSB.","paragraph_zero_based":18812},{"literal_text_all_w_t_and_m_t":"The NCD-SSB has the same values for the properties (e.g., ssb-PositionsInBurst, PCI, ssb-PBCH-BlockPower) of the corresponding CD-SSB apart from the values of the properties configured in the NonCellDefiningSSB-r17 IE. In the MIB associated with this NCD-SSB, the systemFrameNumber field indicates the frame boundary and frame number of the NCD-SSB. The subCarrierSpacingCommon and dmrs-TypeA-Position field in the MIBs associated with CD-SSB and NCD-SSB in the same cell are configured with the same values, respectively.","paragraph_zero_based":18813},{"literal_text_all_w_t_and_m_t":"pdcch-Config","paragraph_zero_based":18814},{"literal_text_all_w_t_and_m_t":"UE specific PDCCH configuration for one BWP.","paragraph_zero_based":18815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["862b1960211795a52fdeb8142da616129a794e425accaa6608117fa428b8556f","672d96a922227cec595911118d9c01b15d045cb59d05ef54af8619fd06dfd385","fb3b418fde73a6ca6fa27020fbead6620796350e19e8eb3c1b50e1e3f9b3daaa","d3f9230637d76387882b89264241de2080a79af1f63c206836a4c38e4281bda5","4daeb3cad1bcf86511f2b0ee86665ed4f5cb227638fb7ff08f33128f738a45a0","016706239dcd8824e9d3a73e12872c7d1f12811dc4fae6407b246d59f5963d84","03b3c4712e41f42018d4c1f5457e6405cfa44eabc10a127eecc4faa55b37ab82","b43083897b2e41c98e08f5aac992626587da498ae8a61bfef5aa102a87991483","f77464897be3ab9865549c573e417097988ec264cb35056f7a563db070602731","ec58caf537653b7c07af47f12a798ace8e68cfc925530909dbec62ede585328a","3a283c64f9277ed0b89ba667c4dc32b9737c7ab25ba7558232cef6745031cada","8670c8af596a58c4c9b361df795d8048f9bec63989ac3cc85b66fa6c5f7eb65c","6d39671fec1f58f0d075776d778f67af6759d5b9052f3e05dd7132691c5db132","7b0c9d84ef0e6785959ec90e54f16740b1d2771b4e60d216717d0cceda80b3d7","c4b3680968bacd85b95e76f79275a6f1b83b461cad874ded0a35a608a9df1b09","393cdd58eaf2f382f715a812ea7e25ef625ee0a89b7f1bf8b112f83a17ab9443","4dfea19c7ca53e9efbd6a2a444717c7f2d81aaf3cfe8284dc91eb92c00a6532b","97eb5228724cb20ff06d96563fe60ef70ec464d34e4b4b73f70c1482169192c2","6f4d628aa968fe0f8461e44028ba3b09df01c4cfc93a60f42d45af0c7963500b","9019178f00a8763bd357f9c577d44def39202be1752561216d0961eb8d3a7715","6aed258543aee2c061511f9b9bb235a8cb3008cefa14ff0dd249a52d893be78e","117198c02fd1769e474c9f6c23e2062a09ae44db3a655d3d01df5e3e8e5c64cb","5ee9f02d0d0e2f21ef8cfc32077232caaa4fc55156c04e4f57010fef2ae8e368","41fec343fab850fadfb7c64efe830878131c6329377e5a58804ef39b25a2d22b"],"paragraph_range_zero_based":[18792,18815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"pdsch-Config","paragraph_zero_based":18816},{"literal_text_all_w_t_and_m_t":"UE specific PDSCH configuration for one BWP.","paragraph_zero_based":18817},{"literal_text_all_w_t_and_m_t":"preConfGapStatus","paragraph_zero_based":18818},{"literal_text_all_w_t_and_m_t":"Indicates whether the pre-configured measurement gaps (i.e. the gaps configured with preConfigInd) are activated or deactivated upon the switch to this BWP. If this field is configured, the UE shall apply network-controlled mechanism for activation and deactivation of the pre-configured measurement gaps, otherwise the UE shall apply the autonomous activation/deactivation mechanism, as specified in TS 38.133 [14]. The first/leftmost bit corresponds to the measurement gap with gap ID 1, the second bit corresponds to measurement gap with gap ID 2, and so on. Value 0 indicates that the corresponding pre-configured measurement gap is deactivated while value 1 indicates that the corresponding pre-configured measurement gap is activated. The UE shall ignore the bit if the corresponding measurement gap is not a pre-configured measurement gap.","paragraph_zero_based":18819},{"literal_text_all_w_t_and_m_t":"servingCellMO","paragraph_zero_based":18820},{"literal_text_all_w_t_and_m_t":"measObjectId of the MeasObjectNR in MeasConfig which is associated to the serving cell. For this MeasObjectNR, the following relationship applies between this MeasObjectNR and nonCellDefiningSSB in BWP-DownlinkDedicated of the associated downlink BWP: if ssbFrequency is configured, its value is the same as the absoluteFrequencySSB in the nonCellDefiningSSB. If the field is present in a downlink BWP and the BWP is activated, the UE uses this measurement object for serving cell measurements (e.g., including those used in measurement report triggering events), otherwise, the UE uses the servingCellMO in ServingCellConfig IE.","paragraph_zero_based":18821},{"literal_text_all_w_t_and_m_t":"sps-Config","paragraph_zero_based":18822},{"literal_text_all_w_t_and_m_t":"UE specific SPS (Semi-Persistent Scheduling) configuration for one BWP. Except for reconfiguration with sync, the NW does not reconfigure sps-Config when there is an active configured downlink assignment (see TS 38.321 [3]). However, the NW may release the sps-Config at any time. Network can only configure SPS in one BWP using either this field or sps-ConfigToAddModList. Network does not configure SPS in one BWP using this field and sps-ConfigMulticastToAddModList-r17 simultaneously.","paragraph_zero_based":18823},{"literal_text_all_w_t_and_m_t":"sps-ConfigDeactivationStateList","paragraph_zero_based":18824},{"literal_text_all_w_t_and_m_t":"Indicates a list of the deactivation states in which each state can be mapped to a single or multiple SPS configurations to be deactivated, see clause 10.2 in TS 38.213 [13]. If a state is mapped to multiple SPS configurations, each of these SPS configurations is configured with the same harq-CodebookID.","paragraph_zero_based":18825},{"literal_text_all_w_t_and_m_t":"sps-ConfigToAddModList","paragraph_zero_based":18826},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be added or modified in one BWP. Except for reconfiguration with sync, the NW does not reconfigure a SPS configuration when it is active (see TS 38.321 [3]).","paragraph_zero_based":18827},{"literal_text_all_w_t_and_m_t":"sps-ConfigToReleaseList","paragraph_zero_based":18828},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":18829},{"literal_text_all_w_t_and_m_t":"radioLinkMonitoringConfig","paragraph_zero_based":18830},{"literal_text_all_w_t_and_m_t":"UE specific configuration of radio link monitoring for detecting cell- and beam radio link failure occasions. The maximum number of failure detection resources should be limited up to 8 for both cell and beam radio link failure detection. For SCells, only periodic 1-port CSI-RS can be configured in IE RadioLinkMonitoringConfig.","paragraph_zero_based":18831},{"literal_text_all_w_t_and_m_t":"sl-PDCCH-Config","paragraph_zero_based":18832},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving the SL grants (via SL-RNTI or SL-CS-RNTI) for NR sidelink communication/discovery.","paragraph_zero_based":18833},{"literal_text_all_w_t_and_m_t":"sl-V2X-PDCCH-Config","paragraph_zero_based":18834},{"literal_text_all_w_t_and_m_t":"Indicates the UE specific PDCCH configurations for receiving SL grants (i.e. sidelink SPS) for V2X sidelink communication.","paragraph_zero_based":18835},{"literal_text_all_w_t_and_m_t":"tci-SelectionPresentInDCI","paragraph_zero_based":18836},{"literal_text_all_w_t_and_m_t":"Indicates if a [TCI selection field] is present or absent in DCI format 1_1 and DCI format 1_2 for a DL BWP, see TS 38.214 [19] clause 5.1.5 and TS 38.212 [17] clauses 7.3.1.2.2 and 7.3.1.2.3.","paragraph_zero_based":18837},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18838},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ab7ad4ffa355487b4de8c2370bea39581e5642818b7cd8dac0db7e1da2a4204d","b19ddf4de8fe18d4fddcee36d0b87fde247307d42f355dc52f146ec6d27ced97","a2b84c250268ec650ed2f5c4e95ca2fb12fa0a837c4d47cf550e58913c7d56a7","739008e76ee6275c1d3f24a521e1c57d11d04430e5ea5219a9b3db9cb04e2b20","b1341da783cd6335158d3ed8387984022847d3a54004466d5bb3038c1ef6cb7d","8c68185a3f93ff5cbf0bded1f023ca8e5e90ce8cb1462bd190d6dda21254c07f","88e30c69d547b2ddd83a3c2d048d7fccc923865d4b740a91575adb2eb008fe55","b484a0c2e46fb0f81604792bb5928e1c96017ae774fb3c389db92213f6657d20","da2f517fe4e0002740f2ebbbd0769a8209a95edfd07fa94b126a1cd43c7ffbfc","bed723c91c2e91169b6acb44b2691fbcfddd72f9de9fe5859491e3c59c5f1342","b54716be39943200c8f918e780913bd7443a92cbc312852f481d09108ba48bd3","1f9aaa2c2891b36581d577821a0598b1c991b71147cb8228c01b6f2932ea4bdd","120e1945210053e4ff3138f1021764a8ef7a1c46fadb444c285c040d6987ce61","413994a782aa1ee5f67ca805ca97559ba126d83dfc6c9d52d50e1cc9fe5b40cb","55049dbc0de55fa7d1f58d38fe56a42bbad6e42e95ba19d81877719df93397b4","92616eebb6831f76a5cc7fc5d4862b1b2341e7f8791073f196b541915bf99d80","826f9c93a4c3d4f3277960835fa82c38229ea7353a422d8d46e7d58d80e298db","49dd1b3d09e7cb328dce2e9b13753cbdde1b4c974c024d7a20b288a929d14af3","f376f755bb8e869ef90d929747ed7e3f0cf647fc236f4779ca534a4f75d41f17","c3756268db2245db24a0aafbbfacd43dd926ffb38f1c2145904edbdc1960ac51","15311d97ce6c88948fadaccb2d01b698aead6d637339cffa16b35c4fcafe6e2b","93ef97df04793674256e3bce603bf1266adc2309f3e6c54998103ef22665d1d8","9d7005756e4c44f465c357dcd81f2bb5bc89b8c66141dff5ee26b6d2f8f72571","003ad1d0c774957b6d9ddecbc821c3f965f44ef53dd4ca1e7e2b74102012c444"],"paragraph_range_zero_based":[18816,18839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18816"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18840},{"literal_text_all_w_t_and_m_t":"MeasObject-NCD-SSB","paragraph_zero_based":18841},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if nonCellDefiningSSB is configured in this DL BWP. It is absent otherwise.","paragraph_zero_based":18842},{"literal_text_all_w_t_and_m_t":"PreConfigMG","paragraph_zero_based":18843},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if there is at least one per UE gap configured with preConfigInd or there is at least one per FR gap of the same FR which the BWP belongs to and configured with preConfigInd. It is absent, Need R, otherwise.","paragraph_zero_based":18844},{"literal_text_all_w_t_and_m_t":"ScellOnly","paragraph_zero_based":18845},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Scell. It is absent otherwise.","paragraph_zero_based":18846},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":18847},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-DownlinkDedicated of an Spcell. It is absent otherwise.","paragraph_zero_based":18848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18849},{"literal_text_all_w_t_and_m_t":"–BWP-Id","paragraph_zero_based":18850},{"literal_text_all_w_t_and_m_t":"The IE BWP-Id is used to refer to Bandwidth Parts (BWP). The initial BWP (including RedCap-specific initial BWP, if configured) is referred to by BWP-Id 0. The other BWPs are referred to by BWP-Id 1 to maxNrofBWPs.","paragraph_zero_based":18851},{"literal_text_all_w_t_and_m_t":"BWP-Id information element","paragraph_zero_based":18852},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18853},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-START","paragraph_zero_based":18854},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18855},{"literal_text_all_w_t_and_m_t":"BWP-Id ::=                          INTEGER (0..maxNrofBWPs)","paragraph_zero_based":18856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18857},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-ID-STOP","paragraph_zero_based":18858},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18859},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18860},{"literal_text_all_w_t_and_m_t":"–BWP-Uplink","paragraph_zero_based":18861},{"literal_text_all_w_t_and_m_t":"The IE BWP-Uplink is used to configure an additional uplink bandwidth part (not for the initial BWP).","paragraph_zero_based":18862},{"literal_text_all_w_t_and_m_t":"BWP-Uplink information element","paragraph_zero_based":18863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9755be4457052c33fa8c91ba11f5afcf196ebc0eb3e65136f7f9242e8eb86d8a","e12b4132384a085905e2f11c9efa018ec0f806f5703c2957db717094ddc55b24","d6b21ed8937843f7deb701820e3cb15a736214f068a0f321c0adc89a48ab8ecf","b6badaf7bf5255d7ce4f1adee7aabaa9aac70cb8207441d00f766e2e16abdafb","90332543d9810fa0b306068cdb0f7f0af7c408243b9ce262211080e89029dbda","a918ee1d01ec52ae763f49829ef37f4af5782db687ca3ce4b11cf279df6d9447","5473ce38d43edc60adccb8527bb826cbfffa9455b1054b68b8367b52f40412ad","c405751beaf029fbc9db95a4319d01c2fc62eed80d9f2b0538bd3aa83b22c92f","a9fd45a16f1b60c03e45d25f3b541ac2cec2d243ff9a87fcf06dc2d130eac5e6","d934fc74bc9116265f6163f9758ec183bf17565bf84f561eb7c1aa81c79a4389","4693d46ef523215e9e0243663fcfee0589ae03f28778109c2ab7cd6732ec0660","36c0e97f99e6ce7387bd1c42c24f7c2ec4bc2f07b2628c289fc3d73430906819","57dd5fdf591278095423b54dec779ebbf2368e087cc00af9e0b1343edee6b87f","4fe2d13dc4b0b3ab5b1f67e8401407824294410a13c270310382e4952a7c42ea","cfcd2b3fa17074b1a0040b1cf7edc608390cf7aa194440c3091f618245475d4e","6c6bdacaea2216ece421032c0b4d352fb5e8eafc1d33d87d63ac6459c6129f2a","05f3319bf0662d6cee3acdb4f557bce2523a21c2bdc0b7d7df5e19e4f4d41b9c","0d43e447d9fb1edd524df5b747b8ede98d870b7e95253a67da3b17679fde1d66","e703bd95f38372243ddfff584d623dbd3090a4b6bbd6c511ff7eda3087a03e3b","b13662b41f320c50b67cc2d5833f347b89425a2cce627a33540d6a8c035a2113","a05128b055e8fdc502bf9155ff62a21d3f45468736dea314a987c674b2883960","ad09785c915aba4126401dcf7b628b09c809bd782a1a13779ac95243685f2783","da8b88dff09c270cb6900dfd15fd533cd077693c0a1eef8d4ab6ebe0b6b42db0","d0415c27654869fffadd07a533c22472a491dfd605405d2c28286e493f6aa9ad"],"paragraph_range_zero_based":[18840,18863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18840"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18864},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-START","paragraph_zero_based":18865},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18866},{"literal_text_all_w_t_and_m_t":"BWP-Uplink ::=                      SEQUENCE {","paragraph_zero_based":18867},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id,","paragraph_zero_based":18868},{"literal_text_all_w_t_and_m_t":"    bwp-Common                          BWP-UplinkCommon                                            OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":18869},{"literal_text_all_w_t_and_m_t":"    bwp-Dedicated                       BWP-UplinkDedicated                                         OPTIONAL,   -- Cond SetupOtherBWP","paragraph_zero_based":18870},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18871},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18872},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18873},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINK-STOP","paragraph_zero_based":18874},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18876},{"literal_text_all_w_t_and_m_t":"BWP-Uplink field descriptions","paragraph_zero_based":18877},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":18878},{"literal_text_all_w_t_and_m_t":"An identifier for this bandwidth part. Other parts of the RRC configuration use the BWP-Id to associate themselves with a particular bandwidth part.","paragraph_zero_based":18879},{"literal_text_all_w_t_and_m_t":"The network configures the BWPs with consecutive IDs from 1. The Network does not include the value 0, since value 0 is reserved for the initial BWP.","paragraph_zero_based":18880},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18881},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18882},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18883},{"literal_text_all_w_t_and_m_t":"SetupOtherBWP","paragraph_zero_based":18884},{"literal_text_all_w_t_and_m_t":"The field is mandatory present upon configuration of a new UL BWP. The field is optionally present, Need M, otherwise. ","paragraph_zero_based":18885},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18886},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkCommon","paragraph_zero_based":18887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["44ebc2ce0fc275499ba1b004b1e2165bb1bfa796b343501f43a60a82e9891949","b8e0f68dedea6c3c816b09c591de4fe3320fa3628e82537dcd591fa040b1a123","1bb833877c675391a45dcf466d017d216aa803815fb4b2edd1fc9ab5b93f8f66","f6d9c52d3e37855e5c789117f12e3bcb9e9377a3113b01241ceb6fbb91fe806d","c155e64e273f9aa7edbab487841e0f72c1af34c3a48ff746c3038980d5ec1516","a476133308174a7b8a0f7b91dc8770de41beef3f2b792bb101f080c0e7a06c97","3faeaa5b9fce4f1b7081b2a08bc1ad23213c109bdbd3eec72a8ab9c93b434ef0","0053485720cb560e6fdcaf37de9f05286d4f802b555c3f077f62cf402e74dcc6","269d80e611ee99c93befaaf8530d5fa0061ec8962510773be3439e59dc04d0b5","323d1b8aa0357fd3e91e3b384d2da98cccb66e5fb7e322723d5cbc439f1c443e","fd983490f95ecaeff3bba1cd2128bd87ee71e509af39c37a0d51525ca2aab4b2","eb9b353ed757f291df70c591b19b3a0d9fd54caa7df094e3047cb645e34a389d","88648ef00520d707e190a4a3f47452ef99ed1efeb16aaf6dd3b1ba8d5003af3d","247059d539a946d7bf7bb071f1876cc27cc11028c48ec0b4f0662c9c0b853f1a","4b24aaaa062a0ce074a4f0d0d660162372a1189ca269302e28ad049d1314a864","d4b125768888186370df801cfb3a75e58fd40eeb2cd11fddf94a26b2550bbaff","3f605fcb1b96373482c7fc97b1a334dd41099c85567a6ef3f2237eb3f91b7c0c","d35390b0de23ca129c412618e6c5ba0736e8ccfc34d3cdb27f49478ff6256130","ec87eece8cdd19739be9919ef71dc939969b6249b7200a0e42677401b9cc70dc","3dbbfd37201275c6a323c2c937486c22d267e752a69d55270b3ed4e37fa49c25","9736a0ec96ed4927a038ee8d583040b0f79944804e0d1c78f22abe7454451f41","87c848057268636667dbce807b2a601063b5019a1b5325c419824f70246e0f91","c3b87b472a8842da73d2cab4989ac1d0db081663fcfffc8b30c2b18cfff6aab9","3c61af9a73a48c3cc4b7e28a39dd8c958b82e76b2e96a032345bceae57d58229"],"paragraph_range_zero_based":[18864,18887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18864"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkCommon is used to configure the common parameters of an uplink BWP. They are \"cell specific\" and the network ensures the necessary alignment with corresponding parameters of other UEs. The common parameters of the initial bandwidth part of the PCell, excluding additionalRACH-perPCI-ToAddModList and additionalRACH-perPCI-ToReleaseList, are also provided via system information. For all other serving cells, the network provides the common parameters via dedicated signalling.","paragraph_zero_based":18888},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon information element","paragraph_zero_based":18889},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18890},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-START","paragraph_zero_based":18891},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18892},{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon ::=                SEQUENCE {","paragraph_zero_based":18893},{"literal_text_all_w_t_and_m_t":"    genericParameters                   BWP,","paragraph_zero_based":18894},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon                   SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":18895},{"literal_text_all_w_t_and_m_t":"    pusch-ConfigCommon                  SetupRelease { PUSCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":18896},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigCommon                  SetupRelease { PUCCH-ConfigCommon }                                     OPTIONAL,   -- Need M","paragraph_zero_based":18897},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18898},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18899},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommonIAB-r16            SetupRelease { RACH-ConfigCommon }                                      OPTIONAL,   -- Need M","paragraph_zero_based":18900},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":18901},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r16               SetupRelease { MsgA-ConfigCommon-r16 }                                  OPTIONAL    -- Cond SpCellOnly2","paragraph_zero_based":18902},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":18903},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18904},{"literal_text_all_w_t_and_m_t":"    enableRA-PrioritizationForSlicing-r17 BOOLEAN                                                    OPTIONAL, -- Cond RA-PrioSliceAI","paragraph_zero_based":18905},{"literal_text_all_w_t_and_m_t":"    additionalRACH-ConfigList-r17       SetupRelease { AdditionalRACH-ConfigList-r17 }               OPTIONAL, -- Cond SpCellOnly2","paragraph_zero_based":18906},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg3-r17              RSRP-Range                                                   OPTIONAL, -- Need R","paragraph_zero_based":18907},{"literal_text_all_w_t_and_m_t":"    numberOfMsg3-RepetitionsList-r17    SEQUENCE (SIZE (4)) OF NumberOfMsg3-Repetitions-r17                  OPTIONAL,  -- Cond Msg3Rep","paragraph_zero_based":18908},{"literal_text_all_w_t_and_m_t":"    mcs-Msg3-Repetitions-r17            SEQUENCE (SIZE (8)) OF INTEGER (0..31)                               OPTIONAL   -- Cond Msg3Rep","paragraph_zero_based":18909},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":18910},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c6f17ebb76ac21976e7059c14db69731641543f8d98d134cad1463c9502f0c76","8b5d3e394f957ec4ca9f196c4f3dc2bd83984e44643509df846d5e5315e8bc34","8e419ba55b5a4c7d3694ba1380bfc5d18f08d151bb95ec75dc1ef79a5b1596c3","f50673063c12300c775c1753d52c0461849e950bbf6de693956a3fafd6cc12eb","1f98a6515ac44c94b7a40bc02102361b2c539d92e86e27db38fa456c705c4716","2eb6f6dab3b8646ee88489586345029c970975d785715b9d5c47becd8450ddaf","c6ae11d4086571b10b105f169e1abaeaf9c64fce97fcf439e4d94a00881a3c03","16295783a0ab05e15702fcc83d3bfcfe0c91280bd229f8e056756af1ceef4bbb","c414f13e7c87b10ea30e3eb3e4ddc5ba911ecb99d74426c88922e071b359edbd","23cc5299a0d33439398a9faf4d9ed6ee65b95276117ec44f83397631d1daac8a","d893afe1a2fed15bed799267f9cf164881b71c4541bbf0afe7bb026ad351a6c9","492f14388f944bf0195bb3a6f8fa93c06cb7cc2624c2149d4ce096bc05e66335","8cd49d9bb8400f06d156fee8e4984f30ad33f0d582125f6d097fde608547a861","061868c3ce3ecb4d3a34c9b1074147f4053f6b27199c5b2ae1596fec808afc7e","8ae331544920eae3ee5a7f120025ea9264d8f9a908d237108a09d8153f7f1fd2","dedd486c0a7a050cb57a44e8bbff22002d25957c3d740045cc7139dc2cb6b062","c91616f6ea4673893ef414509b91884aa9202051bd56f763631e89c586210513","99a1a80d47d36e3023f20a1aec6551d326fecebd0879e5133e1bdefef51b8994","c0bd62f40a8d874405105718c8863ed0a53e0a4ec838a256cf6fccc48977a9db","2982eb5b46bcb35da81102aaca3f8ceb83bd7546d0b6f01dca91cce4cf8e565a","1160ea76f74162a08843a971ac39702bdbac22cef9359fe56608eaf536ca528d","5f1d67cab05316b70215558a3fce3aa24c5e8d2944d348a82aa3d9ebbec36f9c","1d72a4a5669e441d1182cb69bac85e5917eeb78e27ceea0b2f295156d8887dc9","51dfd38fa86a99c89db1711576d103790fcc0410f9bd83077ba07e07e60e0250"],"paragraph_range_zero_based":[18888,18911],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state i