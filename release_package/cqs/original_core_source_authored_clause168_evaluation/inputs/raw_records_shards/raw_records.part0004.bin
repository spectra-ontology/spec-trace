{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigNR-r17         SetupRelease {NeedForGapNCSG-ConfigNR-r17}                      OPTIONAL, -- Need M","paragraph_zero_based":13368},{"literal_text_all_w_t_and_m_t":"    needForGapNCSG-ConfigEUTRA-r17      SetupRelease {NeedForGapNCSG-ConfigEUTRA-r17}                   OPTIONAL, -- Need M","paragraph_zero_based":13369},{"literal_text_all_w_t_and_m_t":"    scg-State-r17                       ENUMERATED {deactivated}                                        OPTIONAL, -- Need N","paragraph_zero_based":13370},{"literal_text_all_w_t_and_m_t":"    appLayerMeasConfig-r17              AppLayerMeasConfig-r17                                          OPTIONAL, -- Need M","paragraph_zero_based":13371},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                RRCResume-v1800-IEs                                             OPTIONAL","paragraph_zero_based":13372},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13373},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13374},{"literal_text_all_w_t_and_m_t":"RRCResume-v1800-IEs ::=             SEQUENCE {","paragraph_zero_based":13375},{"literal_text_all_w_t_and_m_t":"    needForInterruptionConfigNR-r18     ENUMERATED { disabled, enabled }                                OPTIONAL, -- Need M","paragraph_zero_based":13376},{"literal_text_all_w_t_and_m_t":"    reselectionMeasurementReq-r18       ENUMERATED { true }                                             OPTIONAL, -- Need N","paragraph_zero_based":13377},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}                                                     OPTIONAL","paragraph_zero_based":13378},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13380},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-STOP","paragraph_zero_based":13381},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13383},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs field descriptions","paragraph_zero_based":13384},{"literal_text_all_w_t_and_m_t":"appLayerMeasConfig","paragraph_zero_based":13385},{"literal_text_all_w_t_and_m_t":"This field is used to configure application layer measurements. This field is absent when the UE is configured to operate with shared spectrum channel access.","paragraph_zero_based":13386},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementReq","paragraph_zero_based":13387},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the idle/inactive measurements, if available, to the network in the RRCResumeComplete message","paragraph_zero_based":13388},{"literal_text_all_w_t_and_m_t":"masterCellGroup","paragraph_zero_based":13389},{"literal_text_all_w_t_and_m_t":"Configuration of the master cell group.","paragraph_zero_based":13390},{"literal_text_all_w_t_and_m_t":"mrdc-SecondaryCellGroup","paragraph_zero_based":13391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e06e700676f8b69001e38bbd5e3f2db9b7dfce2434ca57d69b302f3afdbe3a4c","6e50c734f183fb69d70602488825dcc15af1fdc1bd4f9679d558f140be44d0a9","6d88a4bc9b740b43882a8e734e7d742f805e5f57502646ec5bfd52a2bc726dd5","c68cf998a83b9d6356310f9373dffb8ad2a74bdc3c2bd6e8d49551caeb8751b7","897f83fb6c44e85a5412f90cdbb09bc0b687227464df8cc055e1c28c9c5aacea","59ee7aeab7f29b85499786f1ee84d6bc8057147beed472bd079287942270b7ff","75202c50c949cfe8a07f5270adf6ecc9c57f06f2af4e2ae762289cd3e451c508","716e09eaece0f612014e5164e10220ed79e5453f4d740678c0bf59eef5a4af62","bdd6de9d73b6612525cd064f120f812b7b4b4868a333a664e37a180799482078","5b72aeb228de7b4955d13624765ff1cc3d947399a1b4249961a00acda0316e09","ee891f0e061f033d2675b74e18b60f6e373c4ec54715dda0bea7d209477f1df1","7e5b705ece8eafc22c6aa5810fc5644c5dd543ecfcd6914393bc4f83e2fc1436","8d1d70c67b4199f65b58fee8691c9a0f913c96a00c33f891acfb92756650039b","e136f0df49513453ac74b3bc8637938ab098b6f5e134402d258eafefb9effba5","8a79131aaa17d89ae3609e3038aa0ce0f2e4f83b59df5c18f2cafdcbb91a70f9","f5db5b9d4766075a7f4cc635c004a10f5a715cf0010ce8d9ede17dc20615f405","678a71f08eab234a6013b9ba406735a2a36fbc460899c3485ecbe2ac14f5a5f9","6eacbfc3270d42dd78e3a5c29c1e873fdc97494302391aa9af81d8fea7b704d1","7537db13f78a83ba7caac379475d5353747fc973660fbe8e68c90ec198bb3200","5e065d6cae4b147040e8f7a18ca0d736861ba1afa809d0796c53766322752a94","084ab28ccf01e21c21af31774ee2b362de8859f1f58406e6c478951c51f2afc8","10dfcce7c668ef63f9f9b24cf008eb668d34440555416afa85943771945b5ea6","438a93b91d59978807c889a4165f9ae2753d0fb808002081d779bcb608df0534","a355eb21866e6bdb5b405ebb95ef1953343cbeb3354ff165df9363080416a479"],"paragraph_range_zero_based":[13368,13391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p13368"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Includes an RRC message for SCG configuration in NR-DC or NE-DC.","paragraph_zero_based":13392},{"literal_text_all_w_t_and_m_t":"For NR-DC (nr-SCG), mrdc-SecondaryCellGroup contains the RRCReconfiguration message as generated (entirely) by SN gNB. In this version of the specification, the RRC message can only include fields secondaryCellGroup (with at least reconfigurationWithSync), otherConfig and measConfig.","paragraph_zero_based":13393},{"literal_text_all_w_t_and_m_t":"For NE-DC (eutra-SCG), mrdc-SecondaryCellGroup includes the E-UTRA RRCConnectionReconfiguration message as specified in TS 36.331 [10]. In this version of the specification, the E-UTRA RRC message only include the field scg-Configuration with at least mobilityControlInfoSCG.","paragraph_zero_based":13394},{"literal_text_all_w_t_and_m_t":"needForGapsConfigNR","paragraph_zero_based":13395},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":13396},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigEUTRA","paragraph_zero_based":13397},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of EUTRA target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":13398},{"literal_text_all_w_t_and_m_t":"needForGapNCSG-ConfigNR","paragraph_zero_based":13399},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report measurement gap and NCSG requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message.","paragraph_zero_based":13400},{"literal_text_all_w_t_and_m_t":"needForInterruptionConfigNR","paragraph_zero_based":13401},{"literal_text_all_w_t_and_m_t":"Indicates whether the UE shall report interruption requirement information of NR target bands in the RRCReconfigurationComplete and RRCResumeComplete message. The network sets this field to enabled only if the needForGapsConfigNR is configured. The network sets this field to disabled if the needForGapsConfigNR is released.","paragraph_zero_based":13402},{"literal_text_all_w_t_and_m_t":"radioBearerConfig","paragraph_zero_based":13403},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs, multicast MRBs) including SDAP/PDCP.","paragraph_zero_based":13404},{"literal_text_all_w_t_and_m_t":"radioBearerConfig2","paragraph_zero_based":13405},{"literal_text_all_w_t_and_m_t":"Configuration of Radio Bearers (DRBs, SRBs) including SDAP/PDCP. This field can only be used if the UE supports NR-DC or NE-DC.","paragraph_zero_based":13406},{"literal_text_all_w_t_and_m_t":"reselectionMeasurementReq","paragraph_zero_based":13407},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the reselection measurements, if available, to the network in the RRCResumeComplete message.","paragraph_zero_based":13408},{"literal_text_all_w_t_and_m_t":"restoreMCG-SCells","paragraph_zero_based":13409},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the MCG SCells from the UE Inactive AS Context, if stored.","paragraph_zero_based":13410},{"literal_text_all_w_t_and_m_t":"restoreSCG","paragraph_zero_based":13411},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall restore the SCG configurations from the UE Inactive AS Context, if stored.","paragraph_zero_based":13412},{"literal_text_all_w_t_and_m_t":"scg-State","paragraph_zero_based":13413},{"literal_text_all_w_t_and_m_t":"Indicates that the SCG is in deactivated state.","paragraph_zero_based":13414},{"literal_text_all_w_t_and_m_t":"sk-Counter","paragraph_zero_based":13415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be02b505154fdbe5acaa693c279b7dff92396e29de4d093a32d4892218a6e928","29befad2081df8521ef38eeca5d8d30e3353cf4a927575e7f4a037962722a4e3","e7f8b279ac0c611202e66c7b2312a5b245cc6634b43c93fc822edaa4daee8308","a4eb02fdc66c3c5a970aa97394fd22287744314e0996f1bdd842f45c12e4f8be","38712ac4bc9749175f64efdedc34439361d550f623bea77c39f8b15074dfa082","c2d810c49c426c127872f621d7c89672d5f58a080a3585e3463f3361f81cbc36","a2ea21cd738ca37b15cd68164d06a2fdbc8739419b56dd84c7c03922bf5ff9d1","9194f5df1b83a4475fd5d61453be4b91300062a01b586f051f1ba0b8c74b94e0","feb22e3212b4579f3d30da13196302af479419618faf7f48e42dc4347e5565c0","03544b1a7d896d77145083238fc975f771ced5118692d73e08cbfe37d2ba264b","730f662aff03c7c8c428bf10d52bdae03b00955688f6924354607d9b1dd9cab4","479e07aa3b0152ffb6ba0e5a91db91f8b7ac7c46da019742a2653c557e865639","df231fb07dd335188bbff3d90cd6c486d2e2b384f655b761c29dbadd5172b705","8e5dc040a0883c9646cc8871e12d29716f81ac30a41c31e36bfd716fbc00742a","01955d2ded8b7fb3b049a458891f90435fdf244766f1c91dc4a92fb285272131","17b7fb30e7d4de26054766e27404c3fb94ee4cdd4bb108c37d7ee03c1bf21a2e","9265d00d0d29568edf9455e446c26db5cfa8dd346c4b59543486755fd771e230","d779bb0804da791a01ac0d9e2f78935147bc840536b7ccc965f45eafbb3b4681","c77b21ccab8a20e444ffa31d5362f9626dc8602bdba7d559a27e32443b26543b","84d776faef9f4ea20e75c6d979d61f618fe4ee2a0894a235946a49d498432270","9a9a931b53c76c2b344b0a790fc786d32ed754779caf2253ccfac14150c90387","f2fcf686dc32fdfc5e575f493ea8042ceca40faa0039e241434c19c9c13534e2","00e4e2a2afc578af0fb677e898f7c665489b31e8eef622787331f2ff931d4146","e4337af51f7d8851560c84d586ccaa1354cda68830150087d1176b19ed30432f"],"paragraph_range_zero_based":[13392,13415],"projection":"All w:t and m:t