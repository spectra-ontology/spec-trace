{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18744},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-DOWNLINKDEDICATED-START","paragraph_zero_based":18745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18746},{"literal_text_all_w_t_and_m_t":"BWP-DownlinkDedicated ::=           SEQUENCE {","paragraph_zero_based":18747},{"literal_text_all_w_t_and_m_t":"    pdcch-Config                        SetupRelease { PDCCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":18748},{"literal_text_all_w_t_and_m_t":"    pdsch-Config                        SetupRelease { PDSCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":18749},{"literal_text_all_w_t_and_m_t":"    sps-Config                          SetupRelease { SPS-Config }                                       OPTIONAL,   -- Need M","paragraph_zero_based":18750},{"literal_text_all_w_t_and_m_t":"    radioLinkMonitoringConfig           SetupRelease { RadioLinkMonitoringConfig }                        OPTIONAL,   -- Need M","paragraph_zero_based":18751},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18752},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18753},{"literal_text_all_w_t_and_m_t":"    sps-ConfigToAddModList-r16          SPS-ConfigToAddModList-r16                                        OPTIONAL,   -- Need N","paragraph_zero_based":18754},{"literal_text_all_w_t_and_m_t":"    sps-ConfigToReleaseList-r16         SPS-ConfigToReleaseList-r16                                       OPTIONAL,   -- Need N","paragraph_zero_based":18755},{"literal_text_all_w_t_and_m_t":"    sps-ConfigDeactivationStateList-r16 SPS-ConfigDeactivationStateList-r16                               OPTIONAL,   -- Need R","paragraph_zero_based":18756},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoverySCellConfig-r16  SetupRelease {BeamFailureRecoveryRSConfig-r16}                    OPTIONAL,   -- Cond SCellOnly","paragraph_zero_based":18757},{"literal_text_all_w_t_and_m_t":"    sl-PDCCH-Config-r16                 SetupRelease { PDCCH-Config }                                     OPTIONAL,   -- Need M","paragraph_zero_based":18758},{"literal_text_all_w_t_and_m_t":"    sl-V2X-PDCCH-Config-r16             SetupRelease { PDCCH-Config }                                     OPTIONAL    -- Need M","paragraph_zero_based":18759},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":18760},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18761},{"literal_text_all_w_t_and_m_t":"    preConfGapStatus-r17                BIT STRING (SIZE (maxNrofGapId-r17))                              OPTIONAL,   -- Cond PreConfigMG","paragraph_zero_based":18762},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoverySpCellConfig-r17 SetupRelease { BeamFailureRecoveryRSConfig-r16}                   OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":18763},{"literal_text_all_w_t_and_m_t":"    harq-FeedbackEnablingforSPSactive-r17 BOOLEAN                                                         OPTIONAL,   -- Need R","paragraph_zero_based":18764},{"literal_text_all_w_t_and_m_t":"    cfr-ConfigMulticast-r17             SetupRelease { CFR-ConfigMulticast-r17 }                          OPTIONAL,   -- Need M","paragraph_zero_based":18765},{"literal_text_all_w_t_and_m_t":"    dl-PPW-PreConfigToAddModList-r17    DL-PPW-PreConfigToAddModList-r17                                  OPTIONAL,   -- Need N","paragraph_zero_based":18766},{"literal_text_all_w_t_and_m_t":"    dl-PPW-PreConfigToReleaseList-r17   DL-PPW-PreConfigToReleaseList-r17                                 OPTIONAL,   -- Need N","paragraph_zero_based":18767}],"source":"Whole authentic original CR source member; all unfiltered body and nested ta