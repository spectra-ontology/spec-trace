{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5064},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":5065},{"literal_text_all_w_t_and_m_t":"1>if the access barring check was requested by upper layers:","paragraph_zero_based":5066},{"literal_text_all_w_t_and_m_t":"2>if the access attempt is considered as barred:","paragraph_zero_based":5067},{"literal_text_all_w_t_and_m_t":"3>if timer T302 is running:","paragraph_zero_based":5068},{"literal_text_all_w_t_and_m_t":"4>if timer T390 is running for Access Category '2':","paragraph_zero_based":5069},{"literal_text_all_w_t_and_m_t":"5>inform the upper layer that access barring is applicable for all access categories except categories '0', upon which the procedure ends;","paragraph_zero_based":5070},{"literal_text_all_w_t_and_m_t":"4>else","paragraph_zero_based":5071},{"literal_text_all_w_t_and_m_t":"5>inform the upper layer that access barring is applicable for all access categories except categories '0' and '2', upon which the procedure ends;","paragraph_zero_based":5072},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5073},{"literal_text_all_w_t_and_m_t":"4>inform upper layers that the access attempt for the Access Category is barred, upon which the procedure ends;","paragraph_zero_based":5074},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5075},{"literal_text_all_w_t_and_m_t":"3>inform upper layers that the access attempt for the Access Category is allowed, upon which the procedure ends;","paragraph_zero_based":5076},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5077},{"literal_text_all_w_t_and_m_t":"2>the procedure ends.","paragraph_zero_based":5078},{"literal_text_all_w_t_and_m_t":"5.3.14.3Void","paragraph_zero_based":5079},{"literal_text_all_w_t_and_m_t":"5.3.14.4T302, T390 expiry or stop (Barring alleviation)","paragraph_zero_based":5080},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5081},{"literal_text_all_w_t_and_m_t":"1>if timer T302 expires or is stopped:","paragraph_zero_based":5082},{"literal_text_all_w_t_and_m_t":"2>for each Access Category for which T390 is not running:","paragraph_zero_based":5083},{"literal_text_all_w_t_and_m_t":"3>consider the barring for this Access Category to be alleviated:","paragraph_zero_based":5084},{"literal_text_all_w_t_and_m_t":"1>else if timer T390 corresponding to an Access Category other than '2' expires or is stopped, and if timer T302 is not running:","paragraph_zero_based":5085},{"literal_text_all_w_t_and_m_t":"2>consider the barring for this Access Category to be alleviated;","paragraph_zero_based":5086},{"literal_text_all_w_t_and_m_t":"1>else if timer T390 corresponding to the Access Category '2' expires or is stopped:","paragraph_zero_based":5087}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6912eb679b6fdc43280ea1af0da1c270b878b1bef580e033f8c976da290f22cf","36d8ddad3b2a4068a1ca8a7ed41eef7bd56556221d36ba6779d53725eb232119","1edbd488fa3c1b30b3698424d85c11b14b11cdd448d8e879ced4b5017547d657","1c38f3e26ac7f532cb3e0846272514c8b660998608cc15b6b6aa9d414aba99d6","8503d5e48831390bba1d5bb8dec041300e95c52f7db317b8f3523897c8a68afe","c2d47e4bd9f3e012f1838286751064b2ed19da6f42916ea7d176686dea2858ce","23839ab530cf8ca588cbf190696e34d997a52548c0d27b5e09dda03f188ad725","7f3bcb910283b2ffa959ea7c222aa0ec13990191d3e7283c6bc9050cb0ce40e8","a7a172e759291f48785e4caa576d4ebc5db97dc7dab382e521c3f9cf92ea52c8","f4532caa5fce6f4fcb8b1266cae7befa2cfc83d4fc305ae4ce06511cd44e8cf1","9bf861584b23a484fba255b1873ac4599b8d99aabc0bf564b198382bff92db0c","d7c13c1af4d7a65e74fede8711dc73b505ac1540b009cbeb74450d095a550e04","3fcc1c1c5bb1312e3f7b9d89dcaae979727b711cfa376bf9682ea33166d73421","c5b7c0a1177f880806e66ef4fa889e880a70e4d91ed603da548514da436c5d16","dc28607e032334ae9a3cd78720a822280c4eceb0729f1a9ed19f73f3d2d710fc","1aa73002303a7476167b95c61d7069bf221f69415950e99a108f974a76d13f0c","082fb2903dcf41eb9121c7c0f7735b1a85698ce7a5ad2437653867fb566dbd4c","fb7f54d5d5182b95356ca5a803c4c05de2835fa91e9afe7b132c61f23ee49a74","96561d92d1670fbe9b9d223dbe18c6e87552c1a9468cc48185f5b8fd6044d553","e57f508e0c2c0aa58a343992ff5d49411dd5c71f50b73f535370b6594069b3fa","76b96c9d9719d7c16b174ac8fa25d6af3fe3a126add6cfc424ecf1458ba58b88","d3971e8315d43b44794661232f262ae1fe25143b61e107dc36f4f0f289edd70f","d6143017b9228a0b99e34f96f30ba75a75e570d127e8bac0e304f29f9023b9c9","19dd4cd4ed623254ad51b595c3687fdcc4da05d94aa399d9ef02f38fa1744fd9"],"paragraph_range_zero_based":[5064,5087],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5064"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>consider the barring for this Access Category to be alleviated;","paragraph_zero_based":5088},{"literal_text_all_w_t_and_m_t":"1>when barring for an Access Category is considered being alleviated:","paragraph_zero_based":5089},{"literal_text_all_w_t_and_m_t":"2>if the Access Category was informed to upper layers as barred:","paragraph_zero_based":5090},{"literal_text_all_w_t_and_m_t":"3>inform upper layers about barring alleviation for the Access Category.","paragraph_zero_based":5091},{"literal_text_all_w_t_and_m_t":"2>else if the Access Category is Access Category '0' for RRC resumption triggered by multicast reception as specified in 5.3.13.2:","paragraph_zero_based":5092},{"literal_text_all_w_t_and_m_t":"3>perform actions specified in 5.3.13.1d;","paragraph_zero_based":5093},{"literal_text_all_w_t_and_m_t":"2>if barring is alleviated for Access Category '8'; or","paragraph_zero_based":5094},{"literal_text_all_w_t_and_m_t":"2>if barring is alleviated for Access Category '2':","paragraph_zero_based":5095},{"literal_text_all_w_t_and_m_t":"3>perform actions specified in 5.3.13.8;","paragraph_zero_based":5096},{"literal_text_all_w_t_and_m_t":"5.3.14.5Access barring check","paragraph_zero_based":5097},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5098},{"literal_text_all_w_t_and_m_t":"1>if one or more Access Identities equal to 1, 2, 11, 12, 13, 14, or 15 are indicated according to TS 24.501 [23], and","paragraph_zero_based":5099},{"literal_text_all_w_t_and_m_t":"1>if for at least one of these Access Identities the corresponding bit in the uac-BarringForAccessIdentity contained in \"UAC barring parameter\" is set to zero:","paragraph_zero_based":5100},{"literal_text_all_w_t_and_m_t":"2>consider the access attempt as allowed;","paragraph_zero_based":5101},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":5102},{"literal_text_all_w_t_and_m_t":"2>if the establishment of the RRC connection is the result of release with redirect with mpsPriorityIndication (either in NR or E-UTRAN); and","paragraph_zero_based":5103},{"literal_text_all_w_t_and_m_t":"2>if the bit corresponding to Access Identity 1 in the uac-BarringForAccessIdentity contained in the \"UAC barring parameter\" is set to zero:","paragraph_zero_based":5104},{"literal_text_all_w_t_and_m_t":"3>consider the access attempt as allowed;","paragraph_zero_based":5105},{"literal_text_all_w_t_and_m_t":"2>else if Access Identity 3 is indicated:","paragraph_zero_based":5106},{"literal_text_all_w_t_and_m_t":"3>draw a random number 'rand' uniformly distributed in the range: 0 ≤ rand < 1;","paragraph_zero_based":5107},{"literal_text_all_w_t_and_m_t":"3>if 'rand' is lower than the value indicated by uac-BarringFactorForAI3 included in \"UAC barring parameter\":","paragraph_zero_based":5108},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":5109},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5110},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as barred;","paragraph_zero_based":5111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["329652ae17fbad3e4150b9ec017896b07bc0aa00ce5d4c30121f64f9fdc067ac","940238012660812dc30061bbd6520170d9dc198c48a060286be2e825d37c3565","6026b298dd876f5ad13e178a453e54fb89c7aab686162d3035adda851025eb3b","a6fa69c731cbb26218aa14dd76b6685f555a920110bbdf24d78afa6c6a6fcfbd","95f08af7e8e316970fae8f73e58ce50785236cdc7c32b891c2ee9be63bad967b","02aa5ac318cc72510c3a0e9df0cc46ecf33c2b5fc876b713ac75224c41ec9e2c","30bb707447bcc5b38d893f43771d25df0d43c21e1b7940e25a2f2c21be897eb7","40fdc4fd90114186678dd54e0a7ed5f6aa6ed132b4e563a495645e0d2552cdc3","c75fee2d745172b87be823b7046d1d09377f32e81c62d61fed9005fc73bc2dc8","6af8edba1260643b930e58174b4d64f34f8d92028519d73bd8fc4ec81d2369ae","6046a34125d052a868dbe62df957c89464f8f044b49b64cae604e417562ceffc","4def07299e120bcfa06935c3516cdcd86ef64a84ea61f4876d819ed837bfef74","05930ee6b425e7abc1a5b3607bf9ed88cd9119a388996095d7e4d9ce4731f830","1cd0f7a3b2b217149b873c3630add128dbb57e952ba39b402e8390d48a60b385","56f812102eb47a7f995173457b5be5bca64afce3296a6e4cfdbed4d63bfd8aa3","e612858d559cc8ad4fd03f15b7ece2dacb18404b8cb76dc8f9700675a7495565","c655bab107bf076b4e0bf54b192c2338561fcbc0683ecc2af069c6776f474efa","cc1fb92698694e154208773ad2a5b764b20a88cecf620cc7c59bb91a5f3b09bc","c8133dc28f2c257811311e3523b9d9322b85f905925f520ee1387cd367e86232","a210ac452a075e80202618fb897767528d63c3c3478727edddfa296181517882","b07719c718e535c6e789ab34f97b1b719f25dc7bee130a1167b656e5e6a39a8f","12502beec638faedde692aa0e0d1014f0ab7d4f57a102ec49139b8d8b3873ed1","6c5b94fefbd129f11b9fb2a300be4060ea9a5cedf8a6056911ec5d6c4dbe7a6c","c87144f57f94fbf417b8252caa22cdc03ddd3bbb6853f1c696f47299641ffd3d"],"paragraph_range_zero_based":[5088,5111],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5088"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5112},{"literal_text_all_w_t_and_m_t":"3>draw a random number 'rand' uniformly distributed in the range: 0 ≤ rand < 1;","paragraph_zero_based":5113},{"literal_text_all_w_t_and_m_t":"3>if 'rand' is lower than the value indicated by uac-BarringFactor included in \"UAC barring parameter\":","paragraph_zero_based":5114},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as allowed;","paragraph_zero_based":5115},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":5116},{"literal_text_all_w_t_and_m_t":"4>consider the access attempt as barred;","paragraph_zero_based":5117},{"literal_text_all_w_t_and_m_t":"1>if the access attempt is considered as barred:","paragraph_zero_based":5118},{"literal_text_all_w_t_and_m_t":"2>draw a random number 'rand' that is uniformly distributed in the range 0 ≤ rand < 1;","paragraph_zero_based":5119},{"literal_text_all_w_t_and_m_t":"2>start timer T390 for the Access Category with the timer value calculated as follows, using the uac-BarringTime included in \"UAC barring parameter\":","paragraph_zero_based":5120},{"literal_text_all_w_t_and_m_t":"T390 = (0.7+ 0.6 * rand) * uac-BarringTime.","paragraph_zero_based":5121},{"literal_text_all_w_t_and_m_t":"5.3.15RRC connection reject","paragraph_zero_based":5122},{"literal_text_all_w_t_and_m_t":"5.3.15.1Initiation","paragraph_zero_based":5123},{"literal_text_all_w_t_and_m_t":"The UE initiates the procedure upon the reception of RRCReject when the UE tries to establish or resume an RRC connection.","paragraph_zero_based":5124},{"literal_text_all_w_t_and_m_t":"5.3.15.2Reception of the RRCReject by the UE","paragraph_zero_based":5125},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5126},{"literal_text_all_w_t_and_m_t":"1>stop timer T300, if running;","paragraph_zero_based":5127},{"literal_text_all_w_t_and_m_t":"1>stop timer T319, if running;","paragraph_zero_based":5128},{"literal_text_all_w_t_and_m_t":"1>stop timer T319a, if running and consider SDT procedure is not ongoing;","paragraph_zero_based":5129},{"literal_text_all_w_t_and_m_t":"1>stop timer T302, if running;","paragraph_zero_based":5130},{"literal_text_all_w_t_and_m_t":"1>reset MAC and release the default MAC Cell Group configuration (except if the RRCReject is received in response to resuming RRC connection for multicast reception);","paragraph_zero_based":5131},{"literal_text_all_w_t_and_m_t":"1>if waitTime is configured in the RRCReject:","paragraph_zero_based":5132},{"literal_text_all_w_t_and_m_t":"2>start timer T302, with the timer value set to the waitTime;","paragraph_zero_based":5133},{"literal_text_all_w_t_and_m_t":"1>if RRCReject is received in response to a request from upper layers:","paragraph_zero_based":5134},{"literal_text_all_w_t_and_m_t":"2>inform the upper layer that access barring is applicable for all access categories except categories '0' and '2';","paragraph_zero_based":5135}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0813ffcf09843779bd9347fa8f507a6923c6a0ae373f8f6f5a8eff4b9f1bf437","83a6cbe78e3be3a6d57028c9948a831b91692e15f47573bcfb2ed2dba78d1404","b8c93c81b8d07a78d694b87969da68c77319de53e9ead057b8832243767ff4f3","88ff69ef7bedaf0899d0bb49882d9165071a8f53612ca6df1d7c7966dd7fb6f3","b3ede29355c3039193abd397494d444c0c18a39736172d10bea58d936f6e376a","5f61c974772ee9f9d383d0d4c477fa6939beafab9af523409b51b68cc5ecb949","a5323fb1129e073d07f002bdf5c0ddfec4e64574db8c97c4a0461125f9b6821a","19e0ab290d8b01417fb03966470fba050066c00f8f8e1248da7bc2a2239d0734","188f51abd48a46fc5a5e2f535640ebff521ba12cd372eed9edce31127de34d64","e33de0ffd7dc7aef92afedee67ce22eb13d06af82a320ca71702b1b77c017989","3193f56cd20b7beeb1fcb4670dcad85460a89dbf90a894e2e44d20eb2639f7f4","cb4df477350112e14fbb58926785059955d233c4bc620fbebf3e8eeed94eff51","a23e574366e5f543e22b7242fa0d9f01597d707ab377d988556eabb0abe23aa3","5a5d10ae6a243167fbdeca6fb31984b7ef1fd921551bbb934e8c4a5eaac64939","06e1f24233f9ec349bf82d7a8b93798569702959329e3f3c233a1dfdf4fe228b","725114bababb98ef1fe97a3611963813b6b219640a86f4d1c26464d967a4078b","ca4d4faeab3317ff6b36b95e96b4629d04febc29c0dac6c41a565db1e66643eb","51e6ba37d8be9a2b15b5e1bb459bddf7a0a32953f28487da2af8e7a5a8c1ebb1","8ad053f773f18e86b262d5429d027ffb4efdb263762cadd578397c5b72ade145","c6606e450760b9491c7d8a49e616007977e13beef075087686316fe8bf1d54a6","7bf02823c2558cc6294c0935367ea334f0b94ee4cd449c77b8b8d138d1bc35a3","6fed4d1f28397ed0b8bfa5e41b86d832af617eab8222d225b16f7b30b0da479e","a9f597a2e2aaeeaae502d1656866dc1abf1239d7615283a5154aadb744cb514f","5abf4ed93beb5327baa05fb924d2b7dd8b6a9da2a811fb4349096e2ea4652fae"],"paragraph_range_zero_based":[5112,5135],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5112"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if RRCReject is received in response to an RRCSetupRequest:","paragraph_zero_based":5136},{"literal_text_all_w_t_and_m_t":"2>inform upper layers about the failure to setup the RRC connection, upon which the procedure ends;","paragraph_zero_based":5137},{"literal_text_all_w_t_and_m_t":"1>else if RRCReject is received in response to an RRCResumeRequest or an RRCResumeRequest1:","paragraph_zero_based":5138},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered by upper layers:","paragraph_zero_based":5139},{"literal_text_all_w_t_and_m_t":"3>inform upper layers about the failure to resume the RRC connection;","paragraph_zero_based":5140},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered due to an RNA update; or","paragraph_zero_based":5141},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered for SDT and T380 has expired:","paragraph_zero_based":5142},{"literal_text_all_w_t_and_m_t":"3>set the variable pendingRNA-Update to true;","paragraph_zero_based":5143},{"literal_text_all_w_t_and_m_t":"2>discard the current KgNB key, the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key derived in accordance with 5.3.13.3;","paragraph_zero_based":5144},{"literal_text_all_w_t_and_m_t":"2>if resume is triggered for SDT:","paragraph_zero_based":5145},{"literal_text_all_w_t_and_m_t":"3>for SRB2, if it is resumed and for SRB1:","paragraph_zero_based":5146},{"literal_text_all_w_t_and_m_t":"4>trigger the PDCP entity to perform SDU discard as specified in TS 38.323 [5];","paragraph_zero_based":5147},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":5148},{"literal_text_all_w_t_and_m_t":"3>for each DRB that is not suspended:","paragraph_zero_based":5149},{"literal_text_all_w_t_and_m_t":"4>indicate PDCP suspend to lower layers;","paragraph_zero_based":5150},{"literal_text_all_w_t_and_m_t":"4>re-establish the RLC entity as specified in TS 38.322 [4];","paragraph_zero_based":5151},{"literal_text_all_w_t_and_m_t":"2>suspend SRB1 and the radio bearers configured for SDT, if any;","paragraph_zero_based":5152},{"literal_text_all_w_t_and_m_t":"2>the procedure ends.","paragraph_zero_based":5153},{"literal_text_all_w_t_and_m_t":"Upon L2 U2N Relay UE receives RRCReject, it either indicates to upper layers (to trigger PC5 unicast link release) or sends NotificationMessageSidelink message to the connected L2 U2N Remote UE(s) in accordance with 5.8.9.10.","paragraph_zero_based":5154},{"literal_text_all_w_t_and_m_t":"The RRC_INACTIVE UE shall continue to monitor paging while the timer T302 is running.","paragraph_zero_based":5155},{"literal_text_all_w_t_and_m_t":"NOTE:If timer T331 is running, the UE continues to perform idle/inactive measurements according to 5.7.8.","paragraph_zero_based":5156},{"literal_text_all_w_t_and_m_t":"5.4Inter-RAT mobility","paragraph_zero_based":5157},{"literal_text_all_w_t_and_m_t":"5.4.1Introduction","paragraph_zero_based":5158},{"literal_text_all_w_t_and_m_t":"Network controlled inter-RAT mobility between NR and E-UTRA, where E-UTRA can be connected to either EPC or 5GC, and from NR to UTRA-FDD is supported.","paragraph_zero_based":5159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a2305823286a0f051557e26372527a34fa1d888225a59d7c67c17238165c4f8d","9e54518aa64b3b0e1f1b02f98558a2973e87f725bfba8e39e1529d070230826c","3ab4c35bdb97d34de0bdb5f96eb9b54a28489aa24dea57bd7dd531c6fdb83d08","081c45a5da2ea45a7743869338a25f483f327d25b6dd91dec7e152ca83b9b8b5","8d7ab4bc2b48d9f84220f4df5772956757183a472de171d004138cc2b599d06e","b9b9bf7f49618718eb835ad3f2909c06c702095de233eaab4b3b9d7abe0aa171","15bdd06f6a156096bc0334f90de6b0a60f51e33b2217c06bd38c80d6f19a0c42","9f5581f48e6966910f14598b9bf727d7dafa8c7b17702cf6da0265a8cdeb1b12","9ccc0af3a0ed16bc5b952fc5adf36879a88fcb90e8f7a7e52dc6d2e965a9db71","618c3b4f1e730d086a8abdad491ee137095e449a0ac6a3b907eb00f98712d2cc","b37e25cb829c9b26f3ada9bbfc5afef7fcd30d238674b8cf490fa8206ccf9b63","40b4aa622b1994291052d1459f8521065c48594af22e2d6fdf9d8ba080b12da2","ac886b928b51648e8d434c0fc331ceae0cdd7e8069d2817fc30331a9690a9cfc","6e3c25fe38f4eb2eac2ebde4bdcb621f98626161fb64209bcdda68110fb63e80","6b919560d03a9073be7385b2a678a7d75fc7955f9478beedd7e434d54093ca75","299914d33304562020b626d50ccd4a5dae6e33f84d0d0a37f2e9a7191b27b58e","d10cbc5a569f7c961a580dfabba3b2dc0c483ce7ffecd03a67cbf2c5388fc156","79bb0a47ded53a73bc69338d63d5fc9de539adfd0a8ff6e03c9665356e7589aa","1bdd983efe46967c5dd25ee81d6db229948602cb0fecd814926f9cdfecbca2c7","452c4e747525b908987821fd2d5ecd43b15f39df986d8d5e9a3d61b64486a8e5","9883a872a58deae6f2271a0349bfb3419963e9e2b9966d41c7641f815fb52b57","01d9688f38adb9ae005073a08b13188a85041f4c35c9cbed279a395479b95137","77c23bc42468183b845c83fa1a3ead1a21f2d152ffe9725e0f8e14fda019ba9a","dacf3ea2a1057c27362ac7acf56df7021a6dbd031ab7157d6e5ae2ad610da23a"],"paragraph_range_zero_based":[5136,5159],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5136"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.4.2Handover to NR","paragraph_zero_based":5160},{"literal_text_all_w_t_and_m_t":"5.4.2.1General","paragraph_zero_based":5161},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5162},{"literal_text_all_w_t_and_m_t":"Figure 5.4.2.1-1: Handover to NR, successful","paragraph_zero_based":5163},{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to, under the control of the network, transfer a connection between the UE and another Radio Access Network (e.g. E-UTRAN) to NR.","paragraph_zero_based":5164},{"literal_text_all_w_t_and_m_t":"The handover to NR procedure applies when SRBs, possibly in combination with DRBs, are established in another RAT. Handover from E-UTRA to NR applies only after integrity has been activated in E-UTRA.","paragraph_zero_based":5165},{"literal_text_all_w_t_and_m_t":"5.4.2.2Initiation","paragraph_zero_based":5166},{"literal_text_all_w_t_and_m_t":"The RAN using another RAT initiates the handover to NR procedure, in accordance with the specifications applicable for the other RAT, by sending the RRCReconfiguration message via the radio access technology from which the inter-RAT handover is performed.","paragraph_zero_based":5167},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":5168},{"literal_text_all_w_t_and_m_t":"-to activate ciphering, possibly using NULL algorithm, if not yet activated in the other RAT;","paragraph_zero_based":5169},{"literal_text_all_w_t_and_m_t":"-to re-establish SRBs and one or more DRBs;","paragraph_zero_based":5170},{"literal_text_all_w_t_and_m_t":"5.4.2.3Reception of the RRCReconfiguration by the UE","paragraph_zero_based":5171},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5172},{"literal_text_all_w_t_and_m_t":"1>apply the default L1 parameter values as specified in corresponding physical layer specifications except for the parameters for which values are provided in SIB1;","paragraph_zero_based":5173},{"literal_text_all_w_t_and_m_t":"1>apply the default MAC Cell Group configuration as specified in 9.2.2;","paragraph_zero_based":5174},{"literal_text_all_w_t_and_m_t":"1>perform RRC reconfiguration procedure as specified in 5.3.5;","paragraph_zero_based":5175},{"literal_text_all_w_t_and_m_t":"NOTE:If the UE is connected to 5GC of the source E-UTRA cell, the delta configuration for PDCP and SDAP can be used for intra-system inter-RAT handover. For other cases, source RAT configuration is not considered when the UE applies the reconfiguration message of target RAT.","paragraph_zero_based":5176},{"literal_text_all_w_t_and_m_t":"Editor's Note: FFS whether to capture the agreement that all LTE QoE configurations are released at handover to NR in LTE specification or NR specification.","paragraph_zero_based":5177},{"literal_text_all_w_t_and_m_t":"5.4.3Mobility from NR","paragraph_zero_based":5178},{"literal_text_all_w_t_and_m_t":"5.4.3.1General","paragraph_zero_based":5179},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5180},{"literal_text_all_w_t_and_m_t":"Figure 5.4.3.1-1: Mobility from NR, successful","paragraph_zero_based":5181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":5182},{"literal_text_all_w_t_and_m_t":"Figure 5.4.3.1-2: Mobility from NR, failure","paragraph_zero_based":5183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b117a843ee5fcff65b00e4b49fa6751ef9b899618f9425fe555ec0acceed6a8d","63056cfcdd665da8dda6671d09a3292d92f457f973d5d9cb293e7440b6bc099e","d3aa7abf3742aa01800f4af627a32d635cfabf6db94a0190a850136bc58acdb0","9c6943f98835affff88888b132abffc5f065ce8fe21888f4fb21c6f14c07c8a8","03b5a233f6b1636e90b39cb9dee3b90b1c078b37c8b62ff54a4061c582f5247b","bdd1b178bb4cdf0904efa05b4bc948d8b7b4a8f70fc11478ffdf9e463dfb1b7d","973cc5c2eb29f75880f23325339724fa94f2066fc46035dc01a794a8014069f6","e6606673e7f3b13a3b24c71ebbc7cfa0ee925b3b46d1c8236456e342db4f9b67","0df56dab599224297f267543ea4b69a7772ad1be0580bdb43bc171a450cfd4d0","641e1b5c79fe6dd1064727f39f69ec532e5ea5cb279051104aad9a529aac6a17","e8400c7358476b2109b2a15d494f57f69d4b7688b3afa92262ad1a6f6735b541","803b816f9212078f65bc0e8d7bcf3d71193e06633f190f237bf802ea50ede26d","a75973f7c506fe8fb3ef2e9e68111f7cce893a85395d38ef5dc88e10d8b32773","1ee9bebb44b0702b8749ad527e850c122cb091d6c4ae4ce940069e00ead06adc","fc4ecc7397e76e7f93db53ac18246e28dbf45188c6134c52b582560277f9e286","c46fa438aeafcb83e3bf1cfc6b708b93a6b8871cc4a018c8625774cc681588dc","f150d477ef9e5134bb6e77eb3ec3f3f9988c5be5f9cc1c5c8687ebddbd490201","f9e3bf36536efe0ad122a23d5d35fbfe0701d7a14a5ac04ad27a6ef8c4b88b03","2ed03e95ee9ff4e601735aa630881048279665a86fbd8d94da0905a563761124","d1fb921c56f50341cc2d2c9fee0673323d618af401384fe964d8490f8623a075","81fd3f488c302619010fe17471116527380d2622b6331c3043eec9736a5bd828","de435eb4692da01ebba9f14e9dbbf5823d8ebb72629dce200afad7d0c21b04d2","b90faa82bdf15b36577701bc120d94588579809deeccf20bf25580e872481c44","b77248f300bd546f5bff2f1f9294fe345e4b10bc7c820512698e014478ac24f7"],"paragraph_range_zero_based":[5160,5183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5160"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The purpose of this procedure is to move a UE in RRC_CONNECTED to a cell using other RAT, e.g. E-UTRA, UTRA-FDD. The mobility from NR procedure covers the following type of mobility:","paragraph_zero_based":5184},{"literal_text_all_w_t_and_m_t":"-handover, i.e. the MobilityFromNRCommand message includes radio resources that have been allocated for the UE in the target cell;","paragraph_zero_based":5185},{"literal_text_all_w_t_and_m_t":"5.4.3.2Initiation","paragraph_zero_based":5186},{"literal_text_all_w_t_and_m_t":"The network initiates the mobility from NR procedure to a UE in RRC_CONNECTED, possibly in response to a MeasurementReport or an MCGFailureInformation message, by sending a MobilityFromNRCommand message. The network applies the procedure as follows:","paragraph_zero_based":5187},{"literal_text_all_w_t_and_m_t":"-the procedure is initiated only when AS security has been activated, and SRB2 with at least one DRB or multicast MRB are setup and not suspended;","paragraph_zero_based":5188},{"literal_text_all_w_t_and_m_t":"-the procedure is not initiated if any DAPS bearer is configured;","paragraph_zero_based":5189},{"literal_text_all_w_t_and_m_t":"5.4.3.3Reception of the MobilityFromNRCommand by the UE","paragraph_zero_based":5190},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5191},{"literal_text_all_w_t_and_m_t":"1>stop timer T310, if running;","paragraph_zero_based":5192},{"literal_text_all_w_t_and_m_t":"1>stop timer T312, if running;","paragraph_zero_based":5193},{"literal_text_all_w_t_and_m_t":"1>if T316 is running:","paragraph_zero_based":5194},{"literal_text_all_w_t_and_m_t":"2>stop timer T316;","paragraph_zero_based":5195},{"literal_text_all_w_t_and_m_t":"2>if the UE supports RLF-Report for fast MCG recovery procedure as specified in 38.306 [26]:","paragraph_zero_based":5196},{"literal_text_all_w_t_and_m_t":"3>set the elapsedTimeT316 in the VarRLF-Report to the value of the elapsed time of the timer T316;","paragraph_zero_based":5197},{"literal_text_all_w_t_and_m_t":"3>set the pSCellId in the VarRLF-Report to the global cell identity of the PSCell, if available, otherwise to the physical cell identity and carrier frequency of the PSCell;","paragraph_zero_based":5198},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5199},{"literal_text_all_w_t_and_m_t":"3>clear the information included in VarRLF-Report, if any;","paragraph_zero_based":5200},{"literal_text_all_w_t_and_m_t":"1>else if T316 is not running:","paragraph_zero_based":5201},{"literal_text_all_w_t_and_m_t":"2>if successHO-Config is configured when connected to the source PCell and the targetRAT-Type is set to eutra:","paragraph_zero_based":5202},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide the successful handover information for inter-RAT handover in accordance with 5.7.10.6;","paragraph_zero_based":5203},{"literal_text_all_w_t_and_m_t":"1>if T390 is running:","paragraph_zero_based":5204},{"literal_text_all_w_t_and_m_t":"2>stop timer T390 for all access categories;","paragraph_zero_based":5205},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.3.14.4;","paragraph_zero_based":5206},{"literal_text_all_w_t_and_m_t":"1>inform upper layers about the release of all application layer measurement configurations;","paragraph_zero_based":5207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["051f8a1f9740d51bcea07c5fb677ae2009ddb91906203d6b6f9de8f2e70344d2","a6561a0ea2049a5b74e784630af8eb9d6ec85a33143fc8058911d89cbdf620f4","6293a787dafd0b4cde0db93a67b30cf5d4e4e1c971285dfcb82763e481964c5c","4186ff5b78931c53150d0f0b5c74c603c49ea2e347f3171742c8f0def94bab4e","f8079e3cdebb557151c6e4f421a58ca961dd221b0c71221264bf66491ac6696c","67ff83e36620ed59df9da7ca8b13dd329d4beca51d1ba36f10701150fc8cb7e3","c7fa0bbd1a1f84778b84c699ded92fb6d52d183b2665062c9f0e4128bd1e1cf7","dfa91d1eb5a09dad68e60151514331545be21e888183ff0e62bf3e4168da2c22","6272ff5a52056e8670b5e659b6145940dc585bb0447a49244182c0a0725e1623","fe82634a57b1f7cfbe9b04fdb6aa205e5d530faf2bd0ec55e3b1db5d14e36b91","2ee9e7af96f3e6fa58b29a5b2de511c617b11c0e1a29f1751da60abea065364d","d2c482b62e32f7fabaa8442ad3136d7e3aeca9b477f27ed6ebe2c60e042d95a7","9a177ee92b9d3f0408820f2d8e5333078651abf5c68d2d96309f57e428e738b2","a60bd8ddc81f9df846f7d01e1c0a1135a396d32ac38c8586f3f84a45630f4d07","b49c1349c2268f1730fe63502ee471ccec55f0fc90923a9b7ca42e4db6102535","f4e00896d31ffac16f8eb3b265346d370c5ad1d8213290ff976fd13d2309553c","576e61b4f55044c09ad90c4e7b3c2df2cbc27c422ad06f5ad15c2d9b3783d0f2","077be6bab99dac294523ae22aa6ed540d7583c6947c39295c53ebd74e3031e7e","d7fbc81e6e4f24cd7357630a24890c2822bc0316ca753d5c10f56819b2e12aec","d31ad5250ddd057c0b2721401a8a1ded8038d9246c562a1951b7317fd5131a84","6b2db738acecd50b711b965c7c09e4ad12fad45366eeb29950c2a9becb9a75e0","fc643fed9486092df0a171c4b7e9b1ff5b2dda606d9cbe03ac2e21664aecee39","0170c58c0e6074cd742fd1922ae1fb59a4b097a4a849244ef7dcb37a156b17eb","65fbbcf1b055f705191c8204e68f6872f512f8c6de3a2bd0190d9f389ffed9b6"],"paragraph_range_zero_based":[5184,5207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>release all application layer measurement configurations including their fields in UE variables VarAppLayerIdleConfig and VarAppLayerPLMN-ListConfig;","paragraph_zero_based":5208},{"literal_text_all_w_t_and_m_t":"1>discard any application layer measurement reports which were not yet fully submitted to lower layers for transmission;","paragraph_zero_based":5209},{"literal_text_all_w_t_and_m_t":"1>consider itself not to be configured to send application layer measurement reports;","paragraph_zero_based":5210},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to eutra:","paragraph_zero_based":5211},{"literal_text_all_w_t_and_m_t":"2>consider inter-RAT mobility as initiated towards E-UTRA;","paragraph_zero_based":5212},{"literal_text_all_w_t_and_m_t":"2>forward the nas-SecurityParamFromNR to the upper layers, if included;","paragraph_zero_based":5213},{"literal_text_all_w_t_and_m_t":"1>else if the targetRAT-Type is set to utra-fdd:","paragraph_zero_based":5214},{"literal_text_all_w_t_and_m_t":"2>consider inter-RAT mobility as initiated towards UTRA-FDD;","paragraph_zero_based":5215},{"literal_text_all_w_t_and_m_t":"2>forward the nas-SecurityParamFromNR to the upper layers, if included;","paragraph_zero_based":5216},{"literal_text_all_w_t_and_m_t":"1>access the target cell indicated in the inter-RAT message in accordance with the specifications of the target RAT.","paragraph_zero_based":5217},{"literal_text_all_w_t_and_m_t":"5.4.3.4Successful completion of the mobility from NR","paragraph_zero_based":5218},{"literal_text_all_w_t_and_m_t":"Upon successfully completing the handover, at the source side the UE shall:","paragraph_zero_based":5219},{"literal_text_all_w_t_and_m_t":"1>reset MAC;","paragraph_zero_based":5220},{"literal_text_all_w_t_and_m_t":"1>stop all timers that are running except T325, T330 and T400;","paragraph_zero_based":5221},{"literal_text_all_w_t_and_m_t":"1>release ran-NotificationAreaInfo, if stored;","paragraph_zero_based":5222},{"literal_text_all_w_t_and_m_t":"1>release the AS security context including the KRRCenc key, the KRRCint key, the KUPint key and the KUPenc key, if stored;","paragraph_zero_based":5223},{"literal_text_all_w_t_and_m_t":"1>release all radio resources, including release of the RLC entity and the MAC configuration;","paragraph_zero_based":5224},{"literal_text_all_w_t_and_m_t":"1>release the associated PDCP entity and SDAP entity for all established RBs;","paragraph_zero_based":5225},{"literal_text_all_w_t_and_m_t":"NOTE :PDCP and SDAP configured by the source RAT prior to the handover that are reconfigured and re-used by target RAT when delta signalling (i.e., during inter-RAT intra-system handover when fullConfig is not present) is used, are not released as part of this procedure.","paragraph_zero_based":5226},{"literal_text_all_w_t_and_m_t":"1>if the UE was configured with successHO-Config when connected to the source PCell and the targetRAT-Type is set to eutra:","paragraph_zero_based":5227},{"literal_text_all_w_t_and_m_t":"2>perform the actions for the successful handover report determination for inter-RAT handover as specified in clause 5.7.10.6.","paragraph_zero_based":5228},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to eutra and the nas-SecurityParamFromNR is included: or","paragraph_zero_based":5229},{"literal_text_all_w_t_and_m_t":"1>if the targetRAT-Type is set to utra-fdd:","paragraph_zero_based":5230},{"literal_text_all_w_t_and_m_t":"2>indicate the release of the RRC connection to upper layers together with the release cause 'other'.","paragraph_zero_based":5231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2ca33a253b740bea699eb6eb856c422cdd1823d24b6f5d288472e76f48cddb67","ebe432b9c805f0c09b28606064b42e72e634cb36ac5f5fb3c6b7f46926876b89","47abf4a53870d2723585a57dfe8d2df68eb726fda983fb8bc18dc197c308cc25","77c5b9bec6d20131c4c63255c1fdb57643212fa09b51ba39007bacd70a3ac291","3b0ce822ae076f2ed4087bc954a621571165d684e928313fd7a3bd61b4586e43","442e2e8a86143e68bf1fe3d4cf0585fc3a4d7d9785b8d9e06df9f12566aeced0","3696315a33d3edb94391b132ccd73385d208ac3d3e0c9d961f0f91e4860b46f5","f10c74b0fca69231f9693b090ff6f4cc5e467dac8897108a4ed14f2a35dc409c","3b0deec43c01aef66dffb8b2b09e6b19ff55f4831f51d725a598948bbcd67490","9d7aaf16b15b886b3f12dc19fab37594d45e49c9c8c90c8259d14c60d73068cb","7edce48d534d1ad9d3385fe95fa4423b2a596f226bb47f52072ee1dc89e44033","1fdbd8e54c196fa3a7d68dfed5ab4bd6c887b70348a0ab5bc15fd5169243a276","9509a72d5969836ebfc93ec85dc506de27dd02aa38d1d0cb082e4225295034f5","c845eaaf2d193d21a54a247e79c4a078435098cadc4725770bbd0a9b4bc7a2a7","5211ef3c20fffe233d23a00408da67e01a2c6d869a8277294755551aa797c35c","bf5cf94c026db58996769df6a7bb49968d459e7cb01c86fa3db53793cfcb5f91","2d971464d1809ce288009243b3868e756e2a7a24b0c7b80a5b7b656ce2646485","ca2ad8a1b22559bd6b826c1f3b833af84cf8bf50f96e052ee7f25169e5d75032","82b7396c4fdb7012c2af69a1eb57095ad529d0136c077b6b0909ed1361eba82f","2c47620a06dc0b88f41c96da2325d5ce07c33a66ff6ec3030826b6b313e7f3f7","7ae1709742232c4742e275e07b640f5c71241c743867fb46d90c99435b961931","13a9c106d91cdbbf2a19baa79a1de7e9986abb0bcaac3f31db5631c8f4f9cf4b","f63acb696a3a9751834025de90aa92e93c27deec1dfb4da118cd762ecb9aeda5","1750965582027b38166b0f59a33ca0969bc568390f5496cdecafdb2842aadf05"],"paragraph_range_zero_based":[5208,5231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.4.3.5Mobility from NR failure","paragraph_zero_based":5232},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5233},{"literal_text_all_w_t_and_m_t":"1>if the UE does not succeed in establishing the connection to the target radio access technology:","paragraph_zero_based":5234},{"literal_text_all_w_t_and_m_t":"2>if the targetRAT-Type in the received MobilityFromNRCommand is set to eutra and the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA:","paragraph_zero_based":5235},{"literal_text_all_w_t_and_m_t":"3>store handover failure information in VarRLF-Report according to 5.3.10.5;","paragraph_zero_based":5236},{"literal_text_all_w_t_and_m_t":"2>if voiceFallbackIndication is included in the MobilityFromNRCommand message; or","paragraph_zero_based":5237},{"literal_text_all_w_t_and_m_t":"2>if the mobility from NR procedure is for emergency services fallback as specified in TS 23.502 [43]:","paragraph_zero_based":5238},{"literal_text_all_w_t_and_m_t":"3>attempt to select an E-UTRA cell:","paragraph_zero_based":5239},{"literal_text_all_w_t_and_m_t":"4>if a suitable E-UTRA cell is selected; or","paragraph_zero_based":5240},{"literal_text_all_w_t_and_m_t":"4>if no suitable E-UTRA cell is available and an acceptable E-UTRA cell supporting emergency call is selected when the UE has an ongoing emergency call:","paragraph_zero_based":5241},{"literal_text_all_w_t_and_m_t":"5>perform the actions upon going to RRC_IDLE as specified in 5.3.11, with release cause 'RRC connection failure';","paragraph_zero_based":5242},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5243},{"literal_text_all_w_t_and_m_t":"5>revert back to the configuration used in the source PCell;","paragraph_zero_based":5244},{"literal_text_all_w_t_and_m_t":"5>initiate the connection re-establishment procedure as specified in clause 5.3.7;","paragraph_zero_based":5245},{"literal_text_all_w_t_and_m_t":"NOTE:It is left to UE implementation to determine whether the mobility from NR procedure is for emergency services fallback as specified in TS 23.502 [43].","paragraph_zero_based":5246},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5247},{"literal_text_all_w_t_and_m_t":"3>revert back to the configuration used in the source PCell;","paragraph_zero_based":5248},{"literal_text_all_w_t_and_m_t":"3>initiate the connection re-establishment procedure as specified in clause 5.3.7;","paragraph_zero_based":5249},{"literal_text_all_w_t_and_m_t":"1>else if the UE is unable to comply with any part of the configuration included in the MobilityFromNRCommand message; or","paragraph_zero_based":5250},{"literal_text_all_w_t_and_m_t":"1>if there is a protocol error in the inter RAT information included in the MobilityFromNRCommand message, causing the UE to fail the procedure according to the specifications applicable for the target RAT:","paragraph_zero_based":5251},{"literal_text_all_w_t_and_m_t":"2>if the targetRAT-Type in the received MobilityFromNRCommand is set to eutra and the UE supports Radio Link Failure Report for Inter-RAT MRO EUTRA:","paragraph_zero_based":5252},{"literal_text_all_w_t_and_m_t":"3>store handover failure information in VarRLF-Report according to 5.3.10.5;","paragraph_zero_based":5253},{"literal_text_all_w_t_and_m_t":"2>revert back to the configuration used in the source PCell;","paragraph_zero_based":5254},{"literal_text_all_w_t_and_m_t":"2>initiate the connection re-establishment procedure as specified in clause 5.3.7.","paragraph_zero_based":5255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["22ec27bed35eae403d3d6167064b0836a9214db2aa4a3b7f036548f1dfd3db6c","a38fb5b9fd90708faeeaa49bb1b1e13ed1aa3b189c90bb32bd3be8cdb1f02659","3cdc67c5ce455ec8b82803830e2fcf3dae3817629a9b755e1dfbb578d1883596","f4dcdd1dabdab1788aacc72fc6ff1f92bbdb58393c13f4e6835fdb523295778c","1b0c71f9dbb9121b348062f719cc7194722fb7c9ff8f211f65bd9c85759ff06a","ca68dc868831e0409c7b5e0bcc96b25f97140b4534fc065e82b36c7be9d0ddbd","096fbbf22e9cb1d5db33bf4447ada88425ccf26bf8b7908a5f6cde92b14072d4","9d506afa8766d1912505e5f311bdb408851e4f50f7281e1c7491784d236185a5","6f88b5a2c9f664bc47b010d0990e33098530d0ddc46fb992862e2fe2eb559710","fc7f9ee021adcd73c9cd96a3e34d653686ce8bee3b790d424217d8a7be3aa468","b550ca0d9ffc745e10111cef6b0318208ecfe315b3aadec08749e50a76aa6c88","b96b7f9f35b6ec0b34d325324c3f6772b91ecc9cad4e5adfbc357e68a8b09266","99ec7c977cec25af0424029dd67e14e5c16b83b9b57535322438891832d57ee5","67a448ec747007f59b1b687de571d14d5bc5b9de30907003c372d71bc67b0c3d","6776c98991d0f891107c5637cbc411fc76bfab03f713dc2b2aa54e33c8b2af6c","cef8844085527ad85ac2b9d86b29e83a651181a943aa59c899a2a271c27da2c5","ab5c28635c61d979e80c5a269e1ac38e5dafc145b16cad615ed70d6295ca65dc","7245039d42c69474222a6cc3a557cda5d3c027b56a6c7af5bc7595fe609a6e1d","0d61d6312f9b271660e17f1c1a320ac37b95ecc432e8d27caa037d71e98feb2c","5b955a771d100290fc4ec9154ef6c7ba882d97de7268f110402271f73f82a1d2","d6f2e91502ccc67ef6219e4dec0fca64461f3b2e73b03358e30f3f1c85821eaf","fb4e76609cdb763f4bbf802615cc67a4933bb193da95aaa9b623672603c3574c","c7fe5a70a8d3f6dc62cd9ace1b914728383d1c95832b9ed9f7f3820103397a74","203d932ae9c797399fe536550d6d1fd5c54c7ca5b6b35681a8d73eb39690bb88"],"paragraph_range_zero_based":[5232,5255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.5Measurements","paragraph_zero_based":5256},{"literal_text_all_w_t_and_m_t":"5.5.1Introduction","paragraph_zero_based":5257},{"literal_text_all_w_t_and_m_t":"The network may configure an RRC_CONNECTED UE to perform measurements. The network may configure the UE to report them in accordance with the measurement configuration or perform conditional reconfiguration evaluation in accordance with the conditional reconfiguration. The measurement configuration is provided by means of dedicated signalling i.e. using the RRCReconfiguration or RRCResume.","paragraph_zero_based":5258},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to perform the following types of measurements:","paragraph_zero_based":5259},{"literal_text_all_w_t_and_m_t":"-NR measurements;","paragraph_zero_based":5260},{"literal_text_all_w_t_and_m_t":"-Inter-RAT measurements of E-UTRA frequencies;","paragraph_zero_based":5261},{"literal_text_all_w_t_and_m_t":"-Inter-RAT measurements of UTRA-FDD frequencies;","paragraph_zero_based":5262},{"literal_text_all_w_t_and_m_t":"-NR sidelink measurements of L2 U2N Relay UEs.","paragraph_zero_based":5263},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following measurement information based on SS/PBCH block(s):","paragraph_zero_based":5264},{"literal_text_all_w_t_and_m_t":"-Measurement results per SS/PBCH block;","paragraph_zero_based":5265},{"literal_text_all_w_t_and_m_t":"-Measurement results per cell based on SS/PBCH block(s);","paragraph_zero_based":5266},{"literal_text_all_w_t_and_m_t":"-SS/PBCH block(s) indexes.","paragraph_zero_based":5267},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following measurement information based on CSI-RS resources:","paragraph_zero_based":5268},{"literal_text_all_w_t_and_m_t":"-Measurement results per CSI-RS resource;","paragraph_zero_based":5269},{"literal_text_all_w_t_and_m_t":"-Measurement results per cell based on CSI-RS resource(s);","paragraph_zero_based":5270},{"literal_text_all_w_t_and_m_t":"-CSI-RS resource measurement identifiers.","paragraph_zero_based":5271},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to perform the following types of measurements for NR sidelink and V2X sidelink:","paragraph_zero_based":5272},{"literal_text_all_w_t_and_m_t":"-CBR measurements.","paragraph_zero_based":5273},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following CLI measurement information based on SRS resources:","paragraph_zero_based":5274},{"literal_text_all_w_t_and_m_t":"-Measurement results per SRS resource;","paragraph_zero_based":5275},{"literal_text_all_w_t_and_m_t":"-SRS resource(s) indexes.","paragraph_zero_based":5276},{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following CLI measurement information based on CLI-RSSI resources:","paragraph_zero_based":5277},{"literal_text_all_w_t_and_m_t":"-Measurement results per CLI-RSSI resource;","paragraph_zero_based":5278},{"literal_text_all_w_t_and_m_t":"-CLI-RSSI resource(s) indexes.","paragraph_zero_based":5279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4e3e0037db252a86579213d60ed184179f36710a326e971752d4c974805f3662","63b08b71c4da4f9456eac4b9007c5ceb75e7d42c3f85e0662d67a7ecacf0d96f","d77e4e6fc48bd5420790d07beb4a16ef94a64caf807443db609a42aa849ea2fd","a4b129991b388fdaa72db4fe171a9fad89b14f28c59abcba24ecd72162dc0ad5","2014d21c8969b034a1d357844a29d1b957550f8ed004e41aa7d2ff46d2e52ce2","59b5d3c24113599320fe0ac1ab00d15b262f317854cf7b1ceff8a2edf9ddbb04","fa39d0e387bf2366e3013036618bacc564f915f76cb81350f9b4dbdec691ca51","6c80949bf082b0a898397005891a3a2308be4396f64efd4965ea94223d30d67c","259c9854a9433929265768194e4e702056d7c731c69b7dd423c3cb3b2848891e","95440c1263ba68c8912e362dacabf5f70776ed2629370ad51659494184bdc720","ad9695817171d4a354bb887b68fbbe85debe33debf8e6e4cebc617e10035042a","7ff869e889a7311bfe833f7767d5496879a6da578fcc0e618b650907adc71d94","e839e2edfa4baff21a9316d88c90c5bdd412ac7549d82a482ce39255dd98e7b3","d5bca70c51b79c2c806f31d274b122914ee011cf8c31bd9ca383db33209481b0","05292681796f614bf90f9d40155b09ed36ce137db61b129ef1e8680c80ff4825","ebaf4b4c055c4ea552605b8cccbf61301181e804e7bc24f59fa7b1175c114ea9","53d58e244203d650627b3d6d26f695c892a0a2d32e4d66f4c45bdc7240b73f5a","3615308f2642767c4f8be60f2a961faf49d7e70472b443ffa2ea14a8aed800bf","234376a2e0f76fef4ce02a00b956ca14c9e45a0c860abd7f28312d5891410cad","59f804024d0c4ea790ccaf0934993998ca21acc09c02672bd05a70e8e5663ffa","a3ea4fe75240ae26372ed58c277cf56bf847b8eb45f4aa029fd632ee3b529e81","17b50687f50ed5b96fd231ddac61f48f00f4fa159dc38b823426fc3c89f3f3ba","196df3676e3601eb785fd85dc2882337c116f81cc1d902898cd60dee6b0aafa2","e49be62e9cdf749f0dcf342e36e71ad3caadd4fe09d241069508cf868c535d26"],"paragraph_range_zero_based":[5256,5279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5256"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The network may configure the UE to report the following Rx-Tx time difference measurement information based on CSI-RS for tracking or PRS:","paragraph_zero_based":5280},{"literal_text_all_w_t_and_m_t":"-UE Rx-Tx time difference measurement result.","paragraph_zero_based":5281},{"literal_text_all_w_t_and_m_t":"The measurement configuration includes the following parameters:","paragraph_zero_based":5282},{"literal_text_all_w_t_and_m_t":"1.Measurement objects: A list of objects on which the UE shall perform the measurements.","paragraph_zero_based":5283},{"literal_text_all_w_t_and_m_t":"-For intra-frequency and inter-frequency measurements a measurement object indicates the frequency/time location and subcarrier spacing of reference signals to be measured. Associated with this measurement object, the network may configure a list of cell specific offsets, a list of 'exclude-listed' cells and a list of 'allow-listed' cells. Exclude-listed cells are not applicable in event evaluation or measurement reporting. Allow-listed cells are the only ones applicable in event evaluation or measurement reporting.","paragraph_zero_based":5284},{"literal_text_all_w_t_and_m_t":"-The measObjectId of the MO which corresponds to each serving cell is indicated by servingCellMO within the serving cell configuration.","paragraph_zero_based":5285},{"literal_text_all_w_t_and_m_t":"-For inter-RAT E-UTRA measurements a measurement object is a single E-UTRA carrier frequency. Associated with this E-UTRA carrier frequency, the network can configure a list of cell specific offsets and a list of 'exclude-listed' cells. Exclude-listed cells are not applicable in event evaluation or measurement reporting.","paragraph_zero_based":5286},{"literal_text_all_w_t_and_m_t":"-For inter-RAT UTRA-FDD measurements a measurement object is a set of cells on a single UTRA-FDD carrier frequency.","paragraph_zero_based":5287},{"literal_text_all_w_t_and_m_t":"-For NR sidelink measurements of L2 U2N Relay UEs, a measurement object is a single NR sidelink frequency to be measured.","paragraph_zero_based":5288},{"literal_text_all_w_t_and_m_t":"-For CBR measurement of NR sidelink communication, a measurement object is a set of transmission resource pool(s) on a single carrier frequency for NR sidelink communication.","paragraph_zero_based":5289},{"literal_text_all_w_t_and_m_t":"-For CBR measurement of NR sidelink discovery, a measurement object is a set of discovery dedicated resource pool(s) or transmission resource pool(s) also used for NR sidelink discovery on a single carrier frequency for NR sidelink discovery.","paragraph_zero_based":5290},{"literal_text_all_w_t_and_m_t":"-For CBR measurement of NR sidelink positioning, a measurement object is a set of positioning dedicated resource pool(s) or transmission resource pool(s) also used for NR sidelink positioning on a single carrier frequency for NR sidelink positioning.","paragraph_zero_based":5291},{"literal_text_all_w_t_and_m_t":"-For CLI measurements a measurement object indicates the frequency/time location of SRS resources and/or CLI-RSSI resources, and subcarrier spacing of SRS resources to be measured.","paragraph_zero_based":5292},{"literal_text_all_w_t_and_m_t":"2.Reporting configurations: A list of reporting configurations where there can be one or multiple reporting configurations per measurement object. Each measurement reporting configuration consists of the following:","paragraph_zero_based":5293},{"literal_text_all_w_t_and_m_t":"-Reporting criterion: The criterion that triggers the UE to send a measurement report. This can either be periodical or a single event description.","paragraph_zero_based":5294},{"literal_text_all_w_t_and_m_t":"-RS type: The RS that the UE uses for beam and cell measurement results (SS/PBCH block or CSI-RS).","paragraph_zero_based":5295},{"literal_text_all_w_t_and_m_t":"-Reporting format: The quantities per cell and per beam that the UE includes in the measurement report (e.g. RSRP) and other associated information such as the maximum number of cells and the maximum number beams per cell to report.","paragraph_zero_based":5296},{"literal_text_all_w_t_and_m_t":"In case of conditional reconfiguration, each configuration consists of the following:","paragraph_zero_based":5297},{"literal_text_all_w_t_and_m_t":"-Execution criteria: The criteria the UE uses for conditional reconfiguration execution.","paragraph_zero_based":5298},{"literal_text_all_w_t_and_m_t":"-RS type: The RS that the UE uses for obtaining beam and cell measurement results (SS/PBCH block-based or CSI-RS-based), used for evaluating conditional reconfiguration execution condition.","paragraph_zero_based":5299},{"literal_text_all_w_t_and_m_t":"3.Measurement identities: For measurement reporting, a list of measurement identities where each measurement identity links one measurement object with one reporting configuration. By configuring multiple measurement identities, it is possible to link more than one measurement object to the same reporting configuration, as well as to link more than one reporting configuration to the same measurement object. The measurement identity is also included in the measurement report that triggered the reporting, serving as a reference to the network. For conditional reconfiguration triggering, one measurement identity links to exactly one conditional reconfiguration trigger configuration. And up to 2 measurement identities can be linked to one conditional reconfiguration execution condition.","paragraph_zero_based":5300},{"literal_text_all_w_t_and_m_t":"4.Quantity configurations: The quantity configuration defines the measurement filtering configuration used for all event evaluation and related reporting, and for periodical reporting of that measurement. For NR measurements, the network may configure up to 2 quantity configurations with a reference in the NR measurement object to the configuration that is to be used. In each configuration, different filter coefficients can be configured for different measurement quantities, for different RS types, and for measurements per cell and per beam.","paragraph_zero_based":5301},{"literal_text_all_w_t_and_m_t":"5.Measurement gaps: Periods that the UE may use to perform measurements.","paragraph_zero_based":5302},{"literal_text_all_w_t_and_m_t":"6.Effective measurement window: Periods that the UE may use to perform inter RAT measurements.","paragraph_zero_based":5303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f490cc4e4e9b157e4f38cd605a0f5ed3e3efcf5154648b0c0203e0874a66d1f0","d75988b4638710c006fbc388feb6ec97ad699bf6d000f9c63b23e2ce2eb98c87","79de0bebaa8f76d8d4a1853ce141c9a208100dbe82005a15d71a2f8860b0558d","41ec3df642b4f71902259a6755330782d0eecdf23c3d3cef0ae1ddc5767d159a","7c1676fc7ca4fa3607753257741011777f9f5ffa465fdf6b184e1d93ec38b550","425009f5b0676211a768ef5809fba93ddf7a9d180396f3763116cc8bfaeebcf4","f4f2bfdba9803e7da521c025cbd07b7fb4d2f99d82300bd0ca8bd047ad69259f","d1f13f0926a2b88973d590e8a99156fe8f8796b6adeaace1234648f04574e7e1","7596a748ff0bc0c989c77be6290fbcf4e9040dd10b855fbb12428cf67b878ca3","ad9bbf6ab295f6e426330e774c7db1dadc84c0b324d264a04f83909ed8eb5fd5","e6399f6d4b858160adf84ec92a7944464112230f9007dba8468067cb0f70b6c1","11a66109eac841e86514e4410f890312d36e9ff6fe0b842caa8c62394884f95e","9847b4ab0aedbe8b113b3568234c9aac4e060877eda8b572c7034b8160b9fb85","7bab44cace07b529a4f42b7e430917a66dbde4b882cdc78afd2abff22790f251","6651816177fd9064a69c8765077645ef52c760ad9a0d68abc708dc1fb6eda7b4","6d3670b087c730b99cea656163271532629faf95e24e078a670285f3a34c87c1","4b6ade05561f6f3743f991ac09dc825d4ee11772fae2d9627db19388c6e122b7","6d889dbe77bbf15acf12c4296eb6fd148ac3ac4717294d556e7f48984b0e2f91","f8f81eeb0bddfe415e9228b159f6fafb703852a1a75013fc69a23efc7a1afe84","d1c029420e5259108032e7a115f2e7511df18ba4671c996d1c96d0ac53aefd4a","3a7b9f8304683f94889472a0abe61e813bb2a0c95131f7e9dc070478c1caa8ed","43b6c96e807f01b325f900485832945db8eaa388fb56b6a4780ad54363399dc2","ef1c1b3035b9c76e0dd7469b0a13f3e0a35756bfc954df44456ed8ae2dd119ec","b3d9641d12a421e33ece660c3929a13ec61ab07682b9436a9b39fbb2b3b6b153"],"paragraph_range_zero_based":[5280,5303],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5280"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"A UE in RRC_CONNECTED maintains a measurement object list, a reporting configuration list, and a measurement identities list according to signalling and procedures in this specification. The measurement object list possibly includes NR measurement object(s), CLI measurement object(s), inter-RAT objects, and L2 U2N Relay objects. Similarly, the reporting configuration list includes NR, inter-RAT, and L2 U2N Relay reporting configurations. Any measurement object can be linked to any reporting configuration of the same RAT type. Some reporting configurations may not be linked to a measurement object. Likewise, some measurement objects may not be linked to a reporting configuration.","paragraph_zero_based":5304},{"literal_text_all_w_t_and_m_t":"The measurement procedures distinguish the following types of cells:","paragraph_zero_based":5305},{"literal_text_all_w_t_and_m_t":"1.The NR serving cell(s) – these are the SpCell and one or more SCells.","paragraph_zero_based":5306},{"literal_text_all_w_t_and_m_t":"2.Listed cells – these are cells listed within the measurement object(s).","paragraph_zero_based":5307},{"literal_text_all_w_t_and_m_t":"3.Detected cells – these are cells that are not listed within the measurement object(s) but are detected by the UE on the SSB frequency(ies) and subcarrier spacing(s) indicated by the measurement object(s).","paragraph_zero_based":5308},{"literal_text_all_w_t_and_m_t":"For NR measurement object(s), the UE measures and reports on the serving cell(s)/serving Relay UE (for L2 U2N Remote UE), listed cells and/or detected cells. For inter-RAT measurements object(s) of E-UTRA, the UE measures and reports on listed cells and detected cells and, for RSSI and channel occupancy measurements, the UE measures and reports on the configured resources on the indicated frequency. For inter-RAT measurements object(s) of UTRA-FDD, the UE measures and reports on listed cells. For CLI measurement object(s), the UE measures and reports on configured measurement resources (i.e. SRS resources and/or CLI-RSSI resources). For L2 U2N Relay object(s), the UE measures and reports on the serving NR cell(s), as well as the discovered L2 U2N Relay UEs.","paragraph_zero_based":5309},{"literal_text_all_w_t_and_m_t":"Whenever the procedural specification, other than contained in clause 5.5.2, refers to a field it concerns a field included in the VarMeasConfig unless explicitly stated otherwise i.e. only the measurement configuration procedure covers the direct UE action related to the received measConfig.","paragraph_zero_based":5310},{"literal_text_all_w_t_and_m_t":"In NR-DC, the UE may receive two independent measConfig:","paragraph_zero_based":5311},{"literal_text_all_w_t_and_m_t":"-a measConfig, associated with MCG, that is included in the RRCReconfiguration message received via SRB1; and","paragraph_zero_based":5312},{"literal_text_all_w_t_and_m_t":"-a measConfig, associated with SCG, that is included in the RRCReconfiguration message received via SRB3, or, alternatively, included within a RRCReconfiguration message embedded in a RRCReconfiguration message received via SRB1.","paragraph_zero_based":5313},{"literal_text_all_w_t_and_m_t":"In this case, the UE maintains two independent VarMeasConfig and VarMeasReportList, one associated with each measConfig, and independently performs all the procedures in clause 5.5 for each measConfig and the associated VarMeasConfig and VarMeasReportList, unless explicitly stated otherwise.","paragraph_zero_based":5314},{"literal_text_all_w_t_and_m_t":"The configurations related to CBR measurements are only included in the measConfig associated with MCG.","paragraph_zero_based":5315},{"literal_text_all_w_t_and_m_t":"The configurations related to Rx-Tx time difference measurement are only included in the measConfig associated with MCG.","paragraph_zero_based":5316},{"literal_text_all_w_t_and_m_t":"5.5.2Measurement configuration","paragraph_zero_based":5317},{"literal_text_all_w_t_and_m_t":"5.5.2.1General","paragraph_zero_based":5318},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":5319},{"literal_text_all_w_t_and_m_t":"-to ensure that, whenever the UE has a measConfig associated with a CG, it includes a measObject for the SpCell and for each NR SCell of the CG to be measured;","paragraph_zero_based":5320},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity across all CGs using a reporting configuration with the reportType set to reportCGI;","paragraph_zero_based":5321},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity per the node hosting PDCP entity using a reporting configuration with the ul-DelayValueConfig;","paragraph_zero_based":5322},{"literal_text_all_w_t_and_m_t":"-to configure at most one measurement identity per the node hosting PDCP entity using a reporting configuration with the ul-ExcessDelayConfig;","paragraph_zero_based":5323},{"literal_text_all_w_t_and_m_t":"-to ensure that, in the measConfig associated with a CG:","paragraph_zero_based":5324},{"literal_text_all_w_t_and_m_t":"-for all SSB based measurements there is at most one measurement object with the same ssbFrequency;","paragraph_zero_based":5325},{"literal_text_all_w_t_and_m_t":"-an smtc1 included in any measurement object with the same ssbFrequency has the same value and that an smtc2 included in any measurement object with the same ssbFrequency has the same value and that an smtc3list included in any measurement object with the same ssbFrequency has the same value and that an smtc4list included in any measurement object with the same ssbFrequency has the same value;","paragraph_zero_based":5326},{"literal_text_all_w_t_and_m_t":"-to ensure that all measurement objects configured in this specification and in TS 36.331 [10] with the same ssbFrequency have the same ssbSubcarrierSpacing;","paragraph_zero_based":5327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f74797f694926ba25676229b9509e69c2cb474145ec75e531d9472b3df78f697","5a4b20769efafc66962bf457d60dd2b8b26201059e14e9c30e57c135ffa83afb","e5bdb2e6c4ad86621fbfba65e65d002d7437f54cb290355dd4a11576f0337b91","b0a60f218fb78fea89e143d458f1f3a946870325cd61f05c9e991c0b37441844","b5554f2fe00e90f7f650aec3caf9c2ec6309fa13b4f6015153a0039691d1b1a8","995d54f3e7180d1efa440e1bc37b610a59f2f51d6b43f0916555d276df6edb5d","90affbf44d0fd69d86186ec5edbebd6a46bc2aa3332aabb396ba844e2c9b3604","74f3c8200c92c714e408e9601d5843ed021decd8792314a89e31b6bfd278c223","48c1be3965d9e3b2b90333b8ff4bccee7362171524400ddc30efc7c39b5adb6c","54264d340843f704fcde56ffd3f5151dbfe1c793eff00e29fc6efbddaaf0955f","8911e70b00a65540f950ac30dab06ae05828bbfb321bc2f6d0a944c861c6a5ae","039b210730a3630624910f61ad89f8294f8c21d98ba1e20aa1591739b5ce6410","84117788931c9fececf6caf80d84f3e3eec5447cfb25c207d0145a2ec519e677","74963c7c7746e310d616aca43f4f14e23a5f234cd846c03cc77137d028ce952e","afbbb724ddab626dc7d18e770deeb11ae6c55084941238553a3520711dd6802b","83476c075a5ba2c472dc9ce8d64f68b09aa73411664f0a20f1f60f633d9806c4","466cb9de5dabd7ce3e8181dcbe321669f0ebe3d7ccb9bce1df9d9b372f5b83e1","fb25486764f91c4dac84977950840df8c01a411f681e8b4357366217c291718c","e677a30e45802a6534dbe8f4783ac8ccacb925fc8f8447f390f41236109226c1","a759ce60b2e62c2bc97df509226c96071bc72f667dd1546b65b61a69e113859d","f5f8360288a5d42f9dfc5da61114cea4c486a353f5a40f1e2620f16d454b70ef","f7862eb3d81d88aa0c81afc6e829281c590809f189a01ebf9ebfdb677b870bb6","fec892d749189f9861d4b1609824f6178d29b3743ee80e1db02a07ffd17f9129","cd4eb5b779d0d896776686b93f12120b5af9d5f7283cba9240ed0f5302d16d69"],"paragraph_range_zero_based":[5304,5327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5304"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-to ensure that, if a measurement object associated with the MCG has the same ssbFrequency as a measurement object associated with the SCG:","paragraph_zero_based":5328},{"literal_text_all_w_t_and_m_t":"-for that ssbFrequency, the measurement window according to the smtc1 configured by the MCG includes the measurement window according to the smtc1 configured by the SCG, or vice-versa, with an accuracy of the maximum receive timing difference specified in TS 38.133 [14].","paragraph_zero_based":5329},{"literal_text_all_w_t_and_m_t":"-if both measurement objects are used for RSSI measurements, bits in measurementSlots in both objects corresponding to the same slot are set to the same value. Also, the endSymbol is the same in both objects.","paragraph_zero_based":5330},{"literal_text_all_w_t_and_m_t":"-to ensure that, if a measurement object has the same ssbFrequency as a measurement object configured in TS 36.331 [10]:","paragraph_zero_based":5331},{"literal_text_all_w_t_and_m_t":"-for that ssbFrequency, the measurement window according to the smtc configured in TS 36.331 [10] includes the measurement window according to the smtc1 configured in TS 38.331, or vice-versa, with an accuracy of the maximum receive timing difference specified in TS 38.133 [14].","paragraph_zero_based":5332},{"literal_text_all_w_t_and_m_t":"-if both measurement objects are used for RSSI measurements, bits in measurementSlots in both objects corresponding to the same slot are set to the same value. Also, the endSymbol is the same in both objects.","paragraph_zero_based":5333},{"literal_text_all_w_t_and_m_t":"-when the UE is in NE-DC, NR-DC, or NR standalone, to configure at most one measurement identity across all CGs using a reporting configuration with the reportType set to reportSFTD;","paragraph_zero_based":5334},{"literal_text_all_w_t_and_m_t":"For CSI-RS resources, the network applies the procedure as follows:","paragraph_zero_based":5335},{"literal_text_all_w_t_and_m_t":"-to ensure that all CSI-RS resources configured in each measurement object have the same center frequency, (startPRB+floor(nrofPRBs/2))","paragraph_zero_based":5336},{"literal_text_all_w_t_and_m_t":"-to ensure that the total number of CSI-RS resources configured in each measurement object does not exceed the maximum number specified in TS 38.214 [19].","paragraph_zero_based":5337},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5338},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measObjectToRemoveList:","paragraph_zero_based":5339},{"literal_text_all_w_t_and_m_t":"2>perform the measurement object removal procedure as specified in 5.5.2.4;","paragraph_zero_based":5340},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measObjectToAddModList:","paragraph_zero_based":5341},{"literal_text_all_w_t_and_m_t":"2>perform the measurement object addition/modification procedure as specified in 5.5.2.5;","paragraph_zero_based":5342},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the reportConfigToRemoveList:","paragraph_zero_based":5343},{"literal_text_all_w_t_and_m_t":"2>perform the reporting configuration removal procedure as specified in 5.5.2.6;","paragraph_zero_based":5344},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the reportConfigToAddModList:","paragraph_zero_based":5345},{"literal_text_all_w_t_and_m_t":"2>perform the reporting configuration addition/modification procedure as specified in 5.5.2.7;","paragraph_zero_based":5346},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the quantityConfig:","paragraph_zero_based":5347},{"literal_text_all_w_t_and_m_t":"2>perform the quantity configuration procedure as specified in 5.5.2.8;","paragraph_zero_based":5348},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measIdToRemoveList:","paragraph_zero_based":5349},{"literal_text_all_w_t_and_m_t":"2>perform the measurement identity removal procedure as specified in 5.5.2.2;","paragraph_zero_based":5350},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measIdToAddModList:","paragraph_zero_based":5351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["62280177e2cad0f373bc0a8b8426b4a11f68e91b700411fa36528621c870b22a","2286d71a1f7833c08c43ae6fdaccc2bb8f4815411c38f5740463450f0bc3aeff","17b06b26260e9ab80e45a045d2726783ae56d57f85fde64feffa48f4948f66f0","a8cce1782281befe70ac44490e270c35b7f314dea7d465dc98b41030fefbc44c","011d2141cbec0b07b805c6f2a659e6b5ae9d38ab4cbca899249b7aa2bc1200af","64b83c2bb77c16c7d7f5beacb557bb1e93bd767a473ef91626f071ed5c185cd4","4bb5212a93e962b5fa59a4234c68fd5e8e2f3b5feeb3ab0015479acc68429e17","8864f078a81267295d502be062d760d62654794148c49fbebe133cb2e559aaf6","ac3588fec86becf82842ee66a3ded43551612fceed63740071b2fda43a3fca3e","697dfcf18cbff81b09d0cbddf4ddf9ea11dee2e6dbdec97209f522cd8afac375","d2d5ed97b94e1c17cf41f2fa31f2c8daffea672d874d2b8aae43c68e544a23e4","04f0166a55104e43ccd1a3743d80b72d8d3fa09a99456438729676b62671a040","a28aa9cf5ce4a0bba3607fe88fb74932a8ec2937b4aefc2fb18f763fc78580a4","77e47297bc79113a0ee1ffc3c41242108ab4b5c5dc6cd49c336339ad50c2ebad","4ace024dcf462f89f48b170ad64c3f2b26e859ca95e5ac83bb975e1155e80416","a02586481b4cb19ab447123add7d4490a2b0db57c5bcf07901a4801fdf1d302a","9042672cd04d668c51d64aa64bc26326180ebdff7147ce1441921ab3392de9d4","4ee16be2236069fc39d0ea7dc1a250f9f1bdfd561f3e440dd9fe1ed92ce7dd63","e217661fd57cdefde1ee6158f3530b23ea4cd4c385db7af5888f9abbb9a62553","aac7f161eab688ad5605dd9466f384f97c3a35e672a1928620eef3c914499d8a","b9618c13cf983ebb22ae25f851c9ba23fca89a83fe3051d5435d1b3ba777ec33","02eb80d07319248f8c9e5e41b1e38b6129991f3579282197c8723f2cc6b02bce","2269b11a7516139f1689cadb6b14a2641dc5441eb5be57eb0ae1c39395a11019","ba6ae9c4f04f7169654376a9b4a112623fecfba376708f8c74a772c448219b67"],"paragraph_range_zero_based":[5328,5351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5328"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>perform the measurement identity addition/modification procedure as specified in 5.5.2.3;","paragraph_zero_based":5352},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measGapConfig:","paragraph_zero_based":5353},{"literal_text_all_w_t_and_m_t":"2>perform the measurement gap configuration procedure as specified in 5.5.2.9;","paragraph_zero_based":5354},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the measGapSharingConfig:","paragraph_zero_based":5355},{"literal_text_all_w_t_and_m_t":"2>perform the measurement gap sharing configuration procedure as specified in 5.5.2.11;","paragraph_zero_based":5356},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the s-MeasureConfig:","paragraph_zero_based":5357},{"literal_text_all_w_t_and_m_t":"2>if s-MeasureConfig is set to ssb-RSRP, set parameter ssb-RSRP of s-MeasureConfig within VarMeasConfig to the threshold value of the RSRP indicated by the received value of s-MeasureConfig which is derived as specified in 6.3.2;","paragraph_zero_based":5358},{"literal_text_all_w_t_and_m_t":"2>else, set parameter csi-RSRP of s-MeasureConfig within VarMeasConfig to the threshold value of the RSRP indicated by the received value of s-MeasureConfig which is derived as specified in 6.3.2.","paragraph_zero_based":5359},{"literal_text_all_w_t_and_m_t":"1>if the received measConfig includes the effectiveMeasWindowConfig:","paragraph_zero_based":5360},{"literal_text_all_w_t_and_m_t":"2>perform the effective measurement window configuration as specified in 5.5.2.12;","paragraph_zero_based":5361},{"literal_text_all_w_t_and_m_t":"5.5.2.2Measurement identity removal","paragraph_zero_based":5362},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5363},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the received measIdToRemoveList that is part of the current UE configuration in VarMeasConfig:","paragraph_zero_based":5364},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":5365},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5366},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":5367},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportOnActivation in the reportConfig associated with this measId:","paragraph_zero_based":5368},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layer to disable the measurement reporting for fast unknown SCell activation.","paragraph_zero_based":5369},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the measIdToRemoveList includes any measId value that is not part of the current UE configuration.","paragraph_zero_based":5370},{"literal_text_all_w_t_and_m_t":"5.5.2.3Measurement identity addition/modification","paragraph_zero_based":5371},{"literal_text_all_w_t_and_m_t":"The network applies the procedure as follows:","paragraph_zero_based":5372},{"literal_text_all_w_t_and_m_t":"-configure a measId only if the corresponding measurement object, the corresponding reporting configuration and the corresponding quantity configuration, are configured.","paragraph_zero_based":5373},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5374},{"literal_text_all_w_t_and_m_t":"1>for each measId included in the received measIdToAddModList:","paragraph_zero_based":5375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["01ffd502bb84cae9e0927cf9caf03a0d1fe2c1fcf482d8992f5bf08e1c87fff3","8a2c96ceabc1b7ad657bff854e24a97f02de4bebed4ec665465f5071d320e5d3","2e1d286d80a18fc3dbb852130a09467763358eced8d81f5cf1158929615fb289","043a4baf025b62fd156fc93c8130ffb989862d658b92ee3c74f95a7f74b76cdb","ecd4f255b7606d1d7b51ae446110d377e1d6a8ecdb6389e3749e42612fe4e161","e493ce9160dc1da5100f897ea55e290729c3cc122b707943f67432774386f3f9","c0b7bddfb4a925a38248fce071dd640180eb4f0cb703d4fb1ebd9fa3edea2735","34dce3db6a7de749215e240a90679d10c0c235b2f1c3473015ba860bbb159452","91e1c44c6b252670bc0494553430570ef5167344de52d38e8ce2b197840e44e0","93f58ea2106153e11868dc989ae4873d4429988234a6ff2cf5dd0bbe369bd506","1f76f3cbb19805979d195b6f9e08443f69d85694a5265375156d1220a1b6e48f","8b437325f385a4147f96b4827841ff7f014e635d21b9526f6bd4bab78fb24b71","c91ce7d823e1ee15af431e203f98cea87da9deaf771ec03f4693e6f9030db414","664462250a9db06bcf6752c88eef4a8a561bc4805aceee3a27bdd0ecb24c608a","dc5a6f2f6797b8e28608854b0e24c10b7f6f31eb44cfe74cc962008ffab0cecd","27774c4684d42ea85d5ba6d70c7b84da236cd72e409b774a7929206ddfb8e558","f0d455cb76c61a0798b06a2cc6b34eb08af31ccbdd1f5cc6de71826014624c20","2ba8264486d4233ab2f63992277da0492e4899d578776550b50d83a88903e281","2ae06bc055a3966d423b3a65af984f1e8732cf0d0a2336a33881e339deedd4ea","8a9b33a2ed73db693295dacc24de0066c9b3387c9ae7113681361678fb751537","b68f0fccb8c92dcbd33949fc0a46bc68b80d683388586105f6ede122bca857f8","9e947e96f3cb90ed5b6698249852ccb0ffc69a550e9e0fe68363fbf7a1bda7db","fa64888d74d777cc7d0c8b70535b05f0b964ccdfe04fc2a4fc459c4ce74189f4","fec23b6cf19ef4802fdeb178c9940cac903a4bee6179c7c1bf35aebd14998c66"],"paragraph_range_zero_based":[5352,5375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5352"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>if an entry with the matching measId exists in the measIdList within the VarMeasConfig:","paragraph_zero_based":5376},{"literal_text_all_w_t_and_m_t":"3>replace the entry with the value received for this measId;","paragraph_zero_based":5377},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":5378},{"literal_text_all_w_t_and_m_t":"3>add a new entry for this measId to the measIdList within the VarMeasConfig;","paragraph_zero_based":5379},{"literal_text_all_w_t_and_m_t":"2>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5380},{"literal_text_all_w_t_and_m_t":"2>stop the periodical reporting timer or timer T321 or timer T322, whichever one is running, and reset the associated information (e.g. timeToTrigger) for this measId;","paragraph_zero_based":5381},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the measId associated with reportConfig for conditional reconfiguration is modified, the conditions are considered to be not fulfilled as specified in 5.3.5.13.4.","paragraph_zero_based":5382},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportCGI in the reportConfig associated with this measId:","paragraph_zero_based":5383},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns E-UTRA:","paragraph_zero_based":5384},{"literal_text_all_w_t_and_m_t":"4>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":5385},{"literal_text_all_w_t_and_m_t":"5>start timer T321 with the timer value set to 200 ms for this measId;","paragraph_zero_based":5386},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":5387},{"literal_text_all_w_t_and_m_t":"5>start timer T321 with the timer value set to 1 second for this measId;","paragraph_zero_based":5388},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns NR:","paragraph_zero_based":5389},{"literal_text_all_w_t_and_m_t":"4>if the measObject associated with this measId concerns FR1:","paragraph_zero_based":5390},{"literal_text_all_w_t_and_m_t":"5>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":5391},{"literal_text_all_w_t_and_m_t":"6>if the UE is an (e)RedCap UE with 1 Rx branch","paragraph_zero_based":5392},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 3 seconds for this measId;","paragraph_zero_based":5393},{"literal_text_all_w_t_and_m_t":"6>else","paragraph_zero_based":5394},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 2 seconds for this measId;","paragraph_zero_based":5395},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5396},{"literal_text_all_w_t_and_m_t":"6>start timer T321 with the timer value set to 2 seconds for this measId;","paragraph_zero_based":5397},{"literal_text_all_w_t_and_m_t":"4>if the measObject associated with this measId concerns FR2:","paragraph_zero_based":5398},{"literal_text_all_w_t_and_m_t":"5>if the useAutonomousGaps is included in the reportConfig associated with this measId:","paragraph_zero_based":5399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["55a85dc2c9e7abfdbe516246981056a44303607e2d23ec3efd1f0013c89e8064","fad8679b008cb674d5e1437165994569816fab236370c8446dabd3f2341c85f9","560d790cbd518a9989c989786dc37a07abba799d4dab5a3173e37ab85bb7368d","002ec9841e9e37f2be67b76dde624a487e6f838a8a81c27a7bb74eff4389c0c6","a70f6723758e09dcc5891a2ae802badbd9b123d5f18d792589b6e6fc6dc99e8e","ab15c05c88a05fbcb7ee04210d9a75c73020a6ec4442dd3bdf47ac24d85c3386","ced613f20254483fb5a348e4fb0b74661f95231e009a525382ac30788fdb9513","9bae72b8c81a5d9ae457887cad45127f2b1587f092cc8cee5ef00fd04109f99e","4dbe0bab25c9af7f466dadbd345d9103ad4a8ddafb69f8609538dd060a2c8606","845e3e1e93357baf607d468cc7f967ae3d3bc3595240f9c342a817193061599b","c0cf872c74309987fda83c706e3397715d23c9fe843f54aef7a8232b17d6db33","e896518a6d591cd8f32319e837f448c7b046b1d6c6710797f70f4b8d930d0206","cccfd6e31ad7593b6622f82bca777a087845dc437253db06abad9ec62df865d4","aa098e924f411de95d74a17c1625608a5f0813a34996a1e516bce5208d1ed0b3","4afee57507829b50edccd3bc594ecaa8f435525a290671b546371920c6d7611f","6bf6792bf9880a8905705db866f68f78cd2a7c60def8154eca191ed49683432c","d1d45c52149a26f8d3849a405c44063873883d33fc15e7b96362a5a21048ecbb","6e041affbbcdf119704c1f19b1f37870fb2915f93fa02f15df7f182253aae484","2dc545801ef34ccfab3e31d61c9c58d0fc9fc119c4b1df949643e5862f6c907d","760652c9829134ab1f1cac4677c5d159e0334f0b09127feaaa61e50b30c88e43","23a03c8e9c41191e880078d92daca322c95007cedeee99a33bf3104c16aeecc9","158725eca206550e97e0754b18ef436baed45aaf4ce92f71e9c180ce1314a912","65fc0b787feb2b152cd24f268bcfda46e464e5cf08d446c2f5b2c05ecacdbeed","ea5644d9f73645f6cfc1ac379aee71616c315a3fa7c1fa6264c2f1f2cb5457d0"],"paragraph_range_zero_based":[5376,5399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p5376"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>if the UE is a RedCap UE with 1 Rx branch","paragraph_zero_based":5400},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 6 seconds for this measId;","paragraph_zero_based":5401},{"literal_text_all_w_t_and_m_t":"6>else","paragraph_zero_based":5402},{"literal_text_all_w_t_and_m_t":"7>start timer T321 with the timer value set to 5 seconds for this measId;","paragraph_zero_based":5403},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":5404},{"literal_text_all_w_t_and_m_t":"6>start timer T321 with the timer value set to 16 seconds for this measId.","paragraph_zero_based":5405},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportSFTD in the reportConfigNR associated with this measId and the drx-SFTD-NeighMeas is included:","paragraph_zero_based":5406},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns FR1:","paragraph_zero_based":5407},{"literal_text_all_w_t_and_m_t":"4>start timer T322 with the timer value set to 3 seconds for this measId;","paragraph_zero_based":5408},{"literal_text_all_w_t_and_m_t":"3>if the measObject associated with this measId concerns FR2:","paragraph_zero_based":5409},{"literal_text_all_w_t_and_m_t":"4>start timer T322 with the timer value set to 24 seconds for this measId.","paragraph_zero_based":5410},{"literal_text_all_w_t_and_m_t":"2>if the reportType is set to reportOnActivation in the reportConfig associated with this measId:","paragraph_zero_based":5411},{"literal_text_all_w_t_and_m_t":"3>indicate to lower layer to enable the measurement reporting for fast unknown SCell activation.","paragraph_zero_based":5412},{"literal_text_all_w_t_and_m_t":"5.5.2.4Measurement object removal","paragraph_zero_based":5413},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5414},{"literal_text_all_w_t_and_m_t":"1>for each measObjectId included in the received measObjectToRemoveList that is part of measObjectList in VarMeasConfig:","paragraph_zero_based":5415},{"literal_text_all_w_t_and_m_t":"2>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":5416},{"literal_text_all_w_t_and_m_t":"2>remove all measId associated with this measObjectId from the measIdList within the VarMeasConfig, if any;","paragraph_zero_based":5417},{"literal_text_all_w_t_and_m_t":"2>if a measId is removed from the measIdList:","paragraph_zero_based":5418},{"literal_text_all_w_t_and_m_t":"3>remove the measurement reporting entry for this measId from the VarMeasReportList, if included;","paragraph_zero_based":5419},{"literal_text_all_w_t_and_m_t":"3>stop the periodical reporting timer or timer T321 or timer T322, whichever is running, and reset the associated information (e.g. timeToTrigger) for this measId.","paragraph_zero_based":5420},{"literal_text_all_w_t_and_m_t":"NOTE:The UE does not consider the message as erroneous if the measObjectToRemoveList includes any measObjectId value that is not part of the current UE configuration.","paragraph_zero_based":5421},{"literal_text_all_w_t_and_m_t":"5.5.2.5Measurement object addition/modification","paragraph_zero_based":5422},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":5423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9d7bbbfcec1dce8854d3812e42693c1c265bfc3ec46b04c343fbf4b4af553c06","667d4ad92d552e649f1ba89e1dd1f134e1d81f1d9d8e8d59614c46c568dc96e7","c08a54f22c1cf82dee5f574d5a3c41