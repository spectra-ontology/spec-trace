{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-START","paragraph_zero_based":32568},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32569},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants ::=          SEQUENCE {","paragraph_zero_based":32570},{"literal_text_all_w_t_and_m_t":"    t310                                ENUMERATED {ms0, ms50, ms100, ms200, ms500, ms1000, ms2000, ms4000, ms6000},","paragraph_zero_based":32571},{"literal_text_all_w_t_and_m_t":"    n310                                ENUMERATED {n1, n2, n3, n4, n6, n8, n10, n20},","paragraph_zero_based":32572},{"literal_text_all_w_t_and_m_t":"    n311                                ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10},","paragraph_zero_based":32573},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32574},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32575},{"literal_text_all_w_t_and_m_t":"    t311                                ENUMERATED {ms1000, ms3000, ms5000, ms10000, ms15000, ms20000, ms30000}","paragraph_zero_based":32576},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":32577},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32579},{"literal_text_all_w_t_and_m_t":"-- TAG-RLF-TIMERSANDCONSTANTS-STOP","paragraph_zero_based":32580},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32582},{"literal_text_all_w_t_and_m_t":"RLF-TimersAndConstants field descriptions","paragraph_zero_based":32583},{"literal_text_all_w_t_and_m_t":"n3xy","paragraph_zero_based":32584},{"literal_text_all_w_t_and_m_t":"Constants are described in clause 7.3. Value n1 corresponds to 1, value n2 corresponds to 2 and so on.","paragraph_zero_based":32585},{"literal_text_all_w_t_and_m_t":"t3xy","paragraph_zero_based":32586},{"literal_text_all_w_t_and_m_t":"Timers are described in clause 7.1. Value ms0 corresponds to 0 ms, value ms50 corresponds to 50 ms and so on.","paragraph_zero_based":32587},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32588},{"literal_text_all_w_t_and_m_t":"–RNTI-Value","paragraph_zero_based":32589},{"literal_text_all_w_t_and_m_t":"The IE RNTI-Value represents a Radio Network Temporary Identity.","paragraph_zero_based":32590},{"literal_text_all_w_t_and_m_t":"RNTI-Value information element","paragraph_zero_based":32591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["279a181d8ac157c4f8a599003440ed322473c2dc08749b3095941ddf30cb2c42","b8b8af756c66c72b46e48ef0d49868cd05f8bd32829de2dadcb49c9605915d90","bb80aabc85ab5b8e18fff9ff9fab17aa74ee04d25410ebb99c3403e8fc8e4655","fb8f3796e896f2f5ed78025d116ed173ac90a8c77a00051c4682a266bb8bb554","d5b14bd75cb94f04ecbd311d99fee386cb17e9cf5ab6d81dc6d386f825dc1590","165134029c36017a90124292719ce671f54be8c54624e958ac33c658d7150243","b1e5e8c834c940258f8d7340e942d6632e8daa4b68e1aa3b68ebdd3d5da19b52","862f58401b6b3c846c8e17f8b68d938919a17091af17380519ed1a2ef400fa05","75414ff08d3e623e7bed3a14efb4257d92527aa3579079f650b20ae1ef18cf90","4f57664d36244ef8af06051c65d99c9e4e22aecc6beac0171f8ffea79c7fa0e3","a98022d6f2add06e893372b5993c4fa3bb2a0b3ffc217ea90de7e8d59746e2b7","53e67fc7b680e64ad5a94b43a27b3eea8f8c3549992dad1ab9352565865c5a02","47eea6d8da1c7dda353f61b8564aac0e673273052fb6415732529261c840d345","3d05ac7cc830101bbb610a94497f99a7c668d5c56c169ed5796d251e7ff50b96","635a83d817f671414959025a1e674cfc2748221993285ca733c8c89cc40ac2a