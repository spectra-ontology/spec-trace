     SEQUENCE (SIZE(1..maxNrofMultiplePDSCHs-r17)) OF PDSCH-TimeDomainResourceAllocation-r16,","paragraph_zero_based":28264},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28265},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28267},{"literal_text_all_w_t_and_m_t":"-- TAG-PDSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-STOP","paragraph_zero_based":28268},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28270},{"literal_text_all_w_t_and_m_t":"PDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":28271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["efa2adf7bc79c71f25bec6622e001f09523ca60d11d4d76f2b00bce4719f790e","f586dfdde8f1e7857367f7de4df1195cbcb89a55f9597de54a534d3816d236a9","2b6848cfb5177ed1754eb746fe424470041d6333d0908dbab0c476d9a6a44b81","b226dcc0fbf3cf27283497affa90113dfc836ffae18ac6a3c159a4cdda7afd8d","27e63eec5a9bdbee98633ce032444d5d7ec95e48f15c267c58cefbe0b9fd06e7","aab605523868dac2266726706cb75cc6fdcdb7829e6441a452bd87fccd377f0e","597ce54c8f632db119e6df9af5d5d4a233088974f3b606e721bbfb363e739c6d","3ba88d033b6992e76c867165d777eb351fb24b0783fd98adddead6c94fb0d168","865d9edbf689f50cff406256c6f7ece22f4c42e610164fefd8716d9686ca84c4","27395aaaf1dc8e8de6ee6cdc9a73ac7d9af0d564b98df4abf5f3b0e6b67c7076","5763cb405f1f4ab3025efbe4bc829679ee0dc5dcc695f604a33f0301a173141d","1c5d44e0154a7d50723f00af822c3a05f9035da26b7ee45f3a951231dc6fe268","37cd0fe09b4f87f841220163fec6d27af5afd749d5fd14608bde71fdd7a29ceb","97066999417c83e30e731c2691ebee976f51366d1309e658532454f61d4dba26","829cc762d7d41b0f4965c6037d5a3ea763c11d54cb0145c76855dfd317e5b8cd","7515336398605a41c70d591ba1b1aa5ae999e48b5cce4074ee2231f90508533e","034808aa128ccb956adc85b71260e5a6492d08d14affb8a351829caa234ec4fa","8b309fbc6a1a074eb2e625827994263165e464ab2d8202b4d3e8cf7a73d3cf44","ba6fbf1cc6e3a2f61db6be52da2d67b479d6b36f2a3f588b1842e1aa6742dcfe","4d19a80f87614f88aea96b4ebaf76af836677b3089b03cda7ad946b9da5859fa","36927c95754ade220411e4b65bce624f695253c2972d066120e6c5f4879db22b","2cad8c1d5e58861ed4113de2f05ad20c25dc6baf970f02e969151f6249da12fe","594063c774131f2f8686a96937d8de4f274d753f9de3095df6a4db321c862aa3","b0019b1e1c5c795394decaedc1bc03f1954ef36f4971ddf0b9e6ed0285c3bb9c"],"paragraph_range_zero_based":[28248,28271],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28248"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"k0","paragraph_zero_based":28272},{"literal_text_all_w_t_and_m_t":"Slot offset between DCI and its scheduled PDSCH (see TS 38.214 [19], clause 5.1.2.1). k0-v1710 is only applicable for PDSCH SCS of 480 kHz and 960 kHz. If multiple PDSCHs are configured per PDCCH, the network always configures this field. Otherwise, when the field is absent and only one PDSCH is configured per PDCCH, the UE applies the value 0.","paragraph_zero_based":28273},{"literal_text_all_w_t_and_m_t":"mappingType","paragraph_zero_based":28274},{"literal_text_all_w_t_and_m_t":"PDSCH mapping type (see TS 38.214 [19], clause 5.3).","paragraph_zero_based":28275},{"literal_text_all_w_t_and_m_t":"repetitionNumber","paragraph_zero_based":28276},{"literal_text_all_w_t_and_m_t":"Indicates the number of PDSCH transmission occasions for slot-based repetition scheme in IE RepetitionSchemeConfig. The parameter is used as specified in 38.214 [19].","paragraph_zero_based":28277},{"literal_text_all_w_t_and_m_t":"startSymbolAndLength","paragraph_zero_based":28278},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol and length (jointly encoded) as start and length indicator (SLIV). The network configures the field so that the allocation does not cross the slot boundary (see TS 38.214 [19], clause 5.1.2.1).","paragraph_zero_based":28279},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28280},{"literal_text_all_w_t_and_m_t":"MultiPDSCH-TimeDomainResourceAllocation field descriptions","paragraph_zero_based":28281},{"literal_text_all_w_t_and_m_t":"pdsch-TDRA-List","paragraph_zero_based":28282},{"literal_text_all_w_t_and_m_t":"One or multiple PDSCHs which can be in consecutive or non-consecutive slots (see TS 38.214 [19], clause 5.1.2.1). ","paragraph_zero_based":28283},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28284},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":28285},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":28286},{"literal_text_all_w_t_and_m_t":"Format1-2","paragraph_zero_based":28287},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, this field is optionally present, Need R. It is absent, Need R, otherwise.","paragraph_zero_based":28288},{"literal_text_all_w_t_and_m_t":"Formats1-0_1-1_4-0_4-1_4-2","paragraph_zero_based":28289},{"literal_text_all_w_t_and_m_t":"In pdsch-TimeDomainAllocationListDCI-1-2, pdsch-TimeDomainAllocationListForMultiPDSCH, and SIB20, this field is absent.","paragraph_zero_based":28290},{"literal_text_all_w_t_and_m_t":"Otherwise, in pdsch-TimeDomainResourceAllocationList-r16, this field is optionally present, Need R.","paragraph_zero_based":28291},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28292},{"literal_text_all_w_t_and_m_t":"–PDU-SessionID","paragraph_zero_based":28293},{"literal_text_all_w_t_and_m_t":"The IE PDU-SessionID identifies the PDU Session.","paragraph_zero_based":28294},{"literal_text_all_w_t_and_m_t":"PDU-SessionID information element","paragraph_zero_based":28295}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["783b3672e70391ac1c20a61327b827314403c9c30fa8163a00b193cf41a4f23e","c9f9b3b21db3fd81356ba28ec2929bf9c5d6db424b8dfa65f480d6064ea22829","0e3dff8712440dcba562662efcf9b219afbd34c6b1c17a13604cb935e2a4abf4","8bc7c39a6e5b4db42a85a5d588c160a8028c36a22cb891a36e7f89f15e2ea651","59820fdacf6d59a0c52cbbf6451c46bcd5f938fecfe36857283ac18d1d2a6b0e","68c6ed72e651527007046608d7452ec877406