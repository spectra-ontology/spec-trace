{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ng-5G-S-TMSI-Part2","paragraph_zero_based":13728},{"literal_text_all_w_t_and_m_t":"The leftmost 9 bits of 5G-S-TMSI.","paragraph_zero_based":13729},{"literal_text_all_w_t_and_m_t":"onboardingRequest","paragraph_zero_based":13730},{"literal_text_all_w_t_and_m_t":"This field indicates that the connection is being established for UE onboarding in the selected onboarding SNPN, see TS 23.501 [32].","paragraph_zero_based":13731},{"literal_text_all_w_t_and_m_t":"registeredAMF","paragraph_zero_based":13732},{"literal_text_all_w_t_and_m_t":"This field is used to transfer the GUAMI of the AMF where the UE is registered, as provided by upper layers, see TS 23.003 [21].","paragraph_zero_based":13733},{"literal_text_all_w_t_and_m_t":"reselectionMeasAvailable","paragraph_zero_based":13734},{"literal_text_all_w_t_and_m_t":"Indication that the UE has reselection measurement report available.","paragraph_zero_based":13735},{"literal_text_all_w_t_and_m_t":"selectedPLMN-Identity","paragraph_zero_based":13736},{"literal_text_all_w_t_and_m_t":"Index of the PLMN or SNPN selected by the UE from the plmn-IdentityInfoList or npn-IdentityInfoList fields included in SIB1.","paragraph_zero_based":13737},{"literal_text_all_w_t_and_m_t":"ul-RRC-Segmentation","paragraph_zero_based":13738},{"literal_text_all_w_t_and_m_t":"This field indicates the UE supports uplink RRC segmentation of UECapabilityInformation.","paragraph_zero_based":13739},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13740},{"literal_text_all_w_t_and_m_t":"–RRCSetupRequest","paragraph_zero_based":13741},{"literal_text_all_w_t_and_m_t":"The RRCSetupRequest message is used to request the establishment of an RRC connection.","paragraph_zero_based":13742},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB0","paragraph_zero_based":13743},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":13744},{"literal_text_all_w_t_and_m_t":"Logical channel: CCCH","paragraph_zero_based":13745},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":13746},{"literal_text_all_w_t_and_m_t":"RRCSetupRequest message","paragraph_zero_based":13747},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13748},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSETUPREQUEST-START","paragraph_zero_based":13749},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13750},{"literal_text_all_w_t_and_m_t":"RRCSetupRequest ::=                 SEQUENCE {","paragraph_zero_based":13751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b599770855528aeb0d1798f714295e99ac4c5799cdcb6a89479f301da0005cad","28e148f2159f03ee3ca30728ba0f4f9e76102451014108ff75a128adc409899b","3df85f94b0474436b59a47e618d64ee2b1c80890c19b48e6816e16688ce74ca6","0e9aacdce0025141a4dd0c70d1b1728d0ced6ed784e809a557b1ad51b8033163","7d5479dde1e5e706abc1e609c09b1c059aca807160a307f67caaa8ba40142b35","e0db384fb459e7dc4c1dea877dc3cd7277a07c0b8bc5e64b443dcd45f77d7ab4","50255e0cf6819ed6e2af4557515a5417d01efc0c562029e3ba0b7eab89edb0e1","020c473397328cfe0d8fa693efee2f352954e549b172122cca8c80ef153da7b8","1a490afe4c327c5c84bf7b3ae3b2b9fc7b126ab47e2a91cea1067ed06d63a7a9","8f70d1f15aa21115c18601e22cd7e07ae5a1aaf9d1b9ac0f2447dd3ce5b48b6c","6b2274e23302ce2b3a261442cb3bb3c31d4cad3aa0a925850ad3791450cb6160","99b0b0ce1f29479b4ee586f4a56c4cc2ba9a25056c1658a67c2340f48ac17162","b88a72a5ad390bf965f1ed55b706f1c6b042b5627c503b4e792856223f3538fb","76f4cdfd0f6da5ec69c493188bda49f30a6fa836b9222e55e9d19afed53