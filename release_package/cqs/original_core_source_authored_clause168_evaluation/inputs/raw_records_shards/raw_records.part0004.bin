"literal_text_all_w_t_and_m_t":"    plmn-IdentityInfoList               PLMN-IdentityInfoList,","paragraph_zero_based":19193},{"literal_text_all_w_t_and_m_t":"    cellReservedForOtherUse             ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":19194},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":19195},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19196},{"literal_text_all_w_t_and_m_t":"    cellReservedForFutureUse-r16        ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":19197},{"literal_text_all_w_t_and_m_t":"    npn-IdentityInfoList-r16            NPN-IdentityInfoList-r16      OPTIONAL    -- Need R","paragraph_zero_based":19198},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["89f9655ddb657ff5aed8a9531af8cf98ab9cc1c840015906f7ee30f9c7fc5d15","95abe03ee31eb0581c017676c3fb4503f7c145035d961a246751f716c728abae","3ec911218a3d69345b1291ce1673d7d33e53637e93234019dc6cd9db60547842","7dbd77b3b7011b8412eb2078ea08aa3d4fd13bc4f82e9f6660d02942a30926b6","9c900822243faa0c6417dedc9a0d1ed0d26455e0011945c88a74986e1c024ab2","83295070e93fcab93522df8799094680cf8031d2da08726218cd7231dc36bb3c","eec9dd2ce422afd9643f2052d10ecf54835bffa12426660653d8a1c3674718fe","0489618d979d7bda7ac8fcb18f2294a6a33ed5acf1c50ee00929207e46c78ea3","cbe233c784fadfc36c6671548d3ecd975fc1669db3ef9329067c39883bc3d4e2","686081723805738e52d48c932060755ad5ba29cd1ca62b2aa8b98a7c4ee5d702","2393c2d504ba6f1bef32a4f8a3211ed31085fb30f1291f0499e2d6319b1f4afb","2ab17a82bbaefe1483695b1d067283457f8824d6b54e73cb0cc2646cf1a96088","853c907caaf54e702193350f2c17bfc212c3df29e0d0c88098bb70c23cd94869","e7b486f511882faf3ac75383e3c02cc5673c8799cd107ddaee8e0db4f31cc1c0","770a0b5887c744ef54531cc67e26004e51853d27b86875f234e4357f8f041e97","cf69d0fea89f63d4e83908a93cf6192c54a2d474d2388115764d29f6d2f83340","c8a6c1cb46be760299f3262c6637c1c328d8798ef90d308312dc909ca87140b1","0c7894028a11f0a02c33c5c3977e4504ebf4c300647c5becea46e4d743f1238d","a210cd838d8fa6e1683e747432f63f2deea195b6afc3762e65ca61caed519c57","0d0e97d3589b5adeb4048720198b24bf84499e3929f595e80ab98409dbdb0c78","639b6f8b27e5f43be6eb271157b9be2fe512bcef8078bc79965505917342e9c3","43c017dc1cc46722425cd7087a3efd137e81f68eae452e88059c38c495365dc0","1cce19749a916e1a10c2ce2aac959ccdd5ec85b74a220a8eb1df9d16fc29efb8","cd5d2c302f35733fd850f4f4e8b14e2fd523f94ba30288789425fdcbfd5b0c39"],"paragraph_range_zero_based":[19176,19199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p19176"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19200},{"literal_text_all_w_t_and_m_t":"    snpn-AccessInfoList-r17             SEQUENCE (SIZE (1..maxNPN-r16)) OF SNPN-AccessInfo-r17    OPTIONAL    -- Need R","paragraph_zero_based":19201},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":19202},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19203},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19204},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo-r17 ::=         SEQUENCE {","paragraph_zero_based":19205},{"literal_text_all_w_t_and_m_t":"    extCH-Supported-r17                 ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":19206},{"literal_text_all_w_t_and_m_t":"    extCH-WithoutConfigAllowed-r17      ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":19207},{"literal_text_all_w_t_and_m_t":"    onboardingEnabled-r17               ENUMERATED {true}             OPTIONAL,   -- Need R","paragraph_zero_based":19208},{"literal_text_all_w_t_and_m_t":"    imsEmergencySupportForSNPN-r17      ENUMERATED {true}             OPTIONAL    -- Need R","paragraph_zero_based":19209},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19210},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19211},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFO-STOP","paragraph_zero_based":19212},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19214},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo field descriptions","paragraph_zero_based":19215},{"literal_text_all_w_t_and_m_t":"cellReservedForFutureUse","paragraph_zero_based":19216},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20] for future use. The field is applicable to all PLMNs and NPNs. This field is ignored by IAB-MT and NCR-MT.","paragraph_zero_based":19217},{"literal_text_all_w_t_and_m_t":"cellReservedForOtherUse","paragraph_zero_based":19218},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is reserved, as defined in 38.304 [20]. The field is applicable to all PLMNs. This field is ignored by IAB-MT and NCR-MT for cell barring determination, but still considered by NPN capable IAB-MT and NPN capable NCR-MT for determination of an NPN-only cell.","paragraph_zero_based":19219},{"literal_text_all_w_t_and_m_t":"npn-IdentityInfoList","paragraph_zero_based":19220},{"literal_text_all_w_t_and_m_t":"The npn-IdentityInfoList is used to configure a set of NPN-IdentityInfo elements. Each of those elements contains a list of one or more NPN Identities and additional information associated with those NPNs. The total number of PLMNs (identified by a PLMN identity in plmn -IdentityList), PNI-NPNs (identified by a PLMN identity and a CAG-ID), and SNPNs (identified by a PLMN identity and a NID) together in the PLMN-IdentityInfoList and NPN-IdentityInfoList does not exceed 12, except for the NPN-only cells. A PNI-NPN and SNPN can be included only once, and in only one entry of the NPN-IdentityInfoList. In case of NPN-only cells the PLMN-IdentityList contains a single element that does not count to the limit of 12 and the cellIdentity of the first entry of the PLMN-IdentityInfoList is set to the same value as the cellIdentity-r16 of the first entry of the NPN-IdentityInfoList. The NPN index is defined as B+c1+c2+…+c(n-1)+d1+d2+…+d(m-1)+e(i) for the NPN identity included in the n-th entry of NPN-IdentityInfoList and in the m-th entry of npn-Identitylist within that NPN-IdentityInfoList entry, and the i-th entry of its corresponding NPN-Identity, where","paragraph_zero_based":19221},{"literal_text_all_w_t_and_m_t":"- B is the index used for the last PLMN in the PLMN-IdentittyInfoList; in NPN-only cells B is considered 0;","paragraph_zero_based":19222},{"literal_text_all_w_t_and_m_t":"- c(j) is the number of NPN index values used in the j-th NPN-IdentityInfoList entry;","paragraph_zero_based":19223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["afe1c9779d4b2ba317344bcf0ac3166bf44c0335d0dfbd9fae8cd10f62d487e5","24125cfb05bd4fa6504a8d6e50ad8d4c51d299f5b946f85f48125c26d580b4f4","a0bb4bcbcec747955a50b4f22484b703220bae292d854465557ab78b031f51cc","eae238aebae86fded51d646fc2dcd3acc3370199e885729e4b31495dfb067146","995540aae2f67b490dbf2be29ac1c402d037f30697ffcf65e045137c770dce19","ad70c94a5e1a4f72ca3bb8c2a52051355ab92b7ad63aa6e2cee1117b630cef8b","41bc41e2fe1f36722ea4d47833e6c0ecba4b9074ff8dc008cc2c9869ace434f4","bcde9f3062b73785675a7d13a0eb205135e39af374a90015b24cd96af5803a53","483653c2bd85b64c81410d3e378e9fcd74c71bcc1858f511681538cf9d5123c4","f318479f5087f43bec6d4a28e79e764b7332f0d7133f3f28bbf5e150a25ac1b1","7b01633e54d87c2773294fa9906873a6a8077b96b2440022ccbb341b3a473951","9a91f222e283b1d4134fc1918a86415131f29f0cdc4c4e4a99a419e3dd523b1d","49291df11245bf5bee4ed59a7ebf26e62dbd63c0a4894a16a952cfb71652fcc0","7806fd3b06ef4159ef53b0bee5bd6739a06966f19632e6dd2c3329f6bc98fd9a","401f6f8115ac0ec96bed6414c6b4c40eb7b88b98049c2ee0b1b43e5255aa9a6f","b95df704f9ec6f738576e19e54d593a6a146386e3e436c7fc8b1f7c7df9c7bfd","15c2570cff216f7cc21871e114cb44076c6355240fd29bf8cdc596888caee484","7b1c53553ac282c229d3df66f2031e192219b3c08e5dabdef5a16e52333a13ba","f679caa80aa2848ea94d76a02191bd62535c1a596ec57b17d5f5e265a5a8a113","7623da6c36188b7ecdf6b4f3309b45d105d9de34d0ac0b789402fb24718cb70a","1a4ff650bab2a2179ca90c04b91e02586a1e7970fbb4350c12f64e42fd8abf78","d32fa014213c0dbfb9ae4dc91f56fdc2f12381730bd709ca2905176fa2125376","f67152cee80240071c20f521435ac06ca38a46936bec215461129880a2c46f0d","2a36d0927b8edd4ffaffadbc7224d97fcf983e8bc2706a3f634c18ef47a4c377"],"paragraph_range_zero_based":[19200,19223],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p19200"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"- d(k) is the number of NPN index values used in the k-th npn-IdentityList entry within the n-th NPN-IdentityInfoList entry;","paragraph_zero_based":19224},{"literal_text_all_w_t_and_m_t":"- e(i) is","paragraph_zero_based":19225},{"literal_text_all_w_t_and_m_t":"    - i if the n-th entry of NPN-IdentityInfoList entry is for SNPN(s);","paragraph_zero_based":19226},{"literal_text_all_w_t_and_m_t":"    - 1 if the n-th entry of NPN-IdentityInfoList entry is for PNI-NPN(s).","paragraph_zero_based":19227},{"literal_text_all_w_t_and_m_t":"plmn-IdentityInfoList","paragraph_zero_based":19228},{"literal_text_all_w_t_and_m_t":"The plmn-IdentityInfoList is used to configure a set of PLMN-IdentityInfo elements. Each of those elements contains a list of one or more PLMN Identities and additional information associated with those PLMNs. A PLMN-identity can be included only once, and in only one entry of the PLMN-IdentityInfoList. The PLMN index is defined as b1+b2+…+b(n-1)+i for the PLMN included at the n-th entry of PLMN-IdentityInfoList and the i-th entry of its corresponding PLMN-IdentityInfo, where b(j) is the number of PLMN-Identity entries in each PLMN-IdentityInfo, respectively.","paragraph_zero_based":19229},{"literal_text_all_w_t_and_m_t":"snpn-AccessInfoList","paragraph_zero_based":19230},{"literal_text_all_w_t_and_m_t":"This list provides access related information for each SNPN in npn-IdentityInfoList, see TS 23.501 [32]. The n-th entry of the list contains the access related information of the n-th SNPN in npn-IdentityInfoList. ","paragraph_zero_based":19231},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19232},{"literal_text_all_w_t_and_m_t":"SNPN-AccessInfo field descriptions","paragraph_zero_based":19233},{"literal_text_all_w_t_and_m_t":"extCH-Supported","paragraph_zero_based":19234},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports access using credentials from a Credentials Holder as specified in TS 23.501 [32].","paragraph_zero_based":19235},{"literal_text_all_w_t_and_m_t":"extCH-WithoutConfigAllowed","paragraph_zero_based":19236},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN allows registration attempts with credentials from a Credentials Holder from UEs that are not explicitly configured to select the SNPN as specified in TS 23.501 [32].","paragraph_zero_based":19237},{"literal_text_all_w_t_and_m_t":"imsEmergencySupportForSNPN","paragraph_zero_based":19238},{"literal_text_all_w_t_and_m_t":"Indicates whether the SNPN supports IMS emergency bearer services for UEs in limited service mode in the cell. If absent, IMS emergency call is not supported by the SNPN in the cell for UEs in limited service mode.","paragraph_zero_based":19239},{"literal_text_all_w_t_and_m_t":"onboardingEnabled","paragraph_zero_based":19240},{"literal_text_all_w_t_and_m_t":"Indicates whether the onboarding SNPN allows registration for onboarding in the cell as specified in TS 23.501 [32].","paragraph_zero_based":19241},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19242},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo-EUTRA-5GC","paragraph_zero_based":19243},{"literal_text_all_w_t_and_m_t":"The IE CellAccessRelatedInfo-EUTRA-5GC indicates cell access related information for an LTE cell connected to 5GC.","paragraph_zero_based":19244},{"literal_text_all_w_t_and_m_t":"CellAccessRelatedInfo-EUTRA-5GC information element","paragraph_zero_based":19245},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":19246},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-5GC-START","paragraph_zero_based":19247}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1