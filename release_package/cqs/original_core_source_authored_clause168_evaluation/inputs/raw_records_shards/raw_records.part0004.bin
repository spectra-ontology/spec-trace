{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"DRX-ConfigSL field descriptions","paragraph_zero_based":22824},{"literal_text_all_w_t_and_m_t":"drx-HARQ-RTT-TimerSL","paragraph_zero_based":22825},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of symbols of the activated DL BWP of PCell. For other cases, value in number of symbols of the BWP where the PDCCH was transmitted. Value 0 is used in case sl-PUCCH-Config is not configured and the corresponding resource pool is not configured with PSFCH.","paragraph_zero_based":22826},{"literal_text_all_w_t_and_m_t":"drx-RetransmissionTimerSL","paragraph_zero_based":22827},{"literal_text_all_w_t_and_m_t":"For sidelink configured grant Type 1, value in number of slot lengths of the activated DL BWP of PCell. For other cases, value in number of slot lengths of the BWP where the PDCCH was transmitted. sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on.","paragraph_zero_based":22828},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22829},{"literal_text_all_w_t_and_m_t":"–EarlyUL-SyncConfig","paragraph_zero_based":22830},{"literal_text_all_w_t_and_m_t":"The IE EarlyUL-SyncConfig is used to configure random access resources for the early UL synchronization procedure.","paragraph_zero_based":22831},{"literal_text_all_w_t_and_m_t":"EarlyUL-SyncConfig information element","paragraph_zero_based":22832},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22833},{"literal_text_all_w_t_and_m_t":"-- TAG-EARLYUL-SYNCCONFIG-START","paragraph_zero_based":22834},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22835},{"literal_text_all_w_t_and_m_t":"EarlyUL-SyncConfig-r18 ::=         SEQUENCE {","paragraph_zero_based":22836},{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL-r18                FrequencyInfoUL,","paragraph_zero_based":22837},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGeneric-r18             RACH-ConfigGeneric,","paragraph_zero_based":22838},{"literal_text_all_w_t_and_m_t":"    bwp-GenericParameters-r18          BWP,","paragraph_zero_based":22839},{"literal_text_all_w_t_and_m_t":"    ssb-PerRACH-Occasion-r18           ENUMERATED {oneEighth, oneFourth, oneHalf, one, two, four, eight, sixteen} OPTIONAL, -- Need R","paragraph_zero_based":22840},{"literal_text_all_w_t_and_m_t":"    prach-RootSequenceIndex-r18        CHOICE {","paragraph_zero_based":22841},{"literal_text_all_w_t_and_m_t":"        l839                               INTEGER (0..837),","paragraph_zero_based":22842},{"literal_text_all_w_t_and_m_t":"        l139                               INTEGER (0..137)","paragraph_zero_based":22843},{"literal_text_all_w_t_and_m_t":"    }                                                                                                             OPTIONAL, -- Need R","paragraph_zero_based":22844},{"literal_text_all_w_t_and_m_t":"    ltm-PRACH-SubcarrierSpacing-r18    SubcarrierSpacing                                                          OPTIONAL, -- Need L139","paragraph_zero_based":22845},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset-r18          ENUMERATED { n0, n25600, n39936, spare1 }                                  OPTIONAL, -- Need R","paragraph_zero_based":22846},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":22847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d0a08cbaf110099cc714c0e33cdc66889c652ca511e2c0323b806c51211d4f38","4d1b5087541d6990e22f1ecbf15fa5353b2b2dfbcce20