_based":30478},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30479}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["a9a7888b14cd4df96ed07b538c87d3dcf8e246581efb339b8b813aa842c3ea8a","b60511c17f7aa337da976b145cfa088e26efdd1608e76c316d1bf9e6bf9b0254","82cc6e3eec543c2ceb069b15acd08a21c3252e5a5f49bf2ff1e87aaebc613b04","891fafdd6cb35be161d83207ae35239b052bc2cf38b5ea6903fefa881e02504b","c3d7ac40760c84512e605ac3ef060909724b0d84ef7df760b4f983e7a50e84b5","a318763c554cc84c8bdd7e8f5a3933f161541aae4cf46768b4c0858a673a7e1f","988f51a8eef314e2712a1e8615b1aa356d9356a47a2e493628bdf0dc7b44fb55","036f8ce7047cf6fcc5ddfafba4f3ebf46f104e16ef138de3fccc4ac8db073a49","b7dae0a7e44967f2178098784bb58b4090d07a6c1a78401c9e2851d68de76c6c","549e60d71e09792d82d376b210e26bef55cff1484fe5f227e3608347efcc6af1","deb1a68ed5a2230d01d4426e55187b1bb233cdaefc14b537e83af51a2f518866","e865d82c6ce30213401bff19f42d39792c973e9435cf0d0adea7b89d7b4af87c","1b6b14999c4f3b4603d7a9dd650eb360986a3e2d197467b572c9ccbfa1fcd0a5","314557b07fead26aea2e4b3c6a54182e60d53737ae2002b48b31e97be22205a8","29171f45820e442da655d7c29689b51877cde83f761ea0bbb11490fe210666e9","98e54392e79045cd57d22d12b965240a65937e3b28be986a5a26f1339f253343","97d5ce81b79306e82b0ff18ce9c7ed4214105a83a9b6555ce7d21ad082ed3904","33dc0215fb460af2ebc2e6523fa9aeabeae8f8095bc05f4840bf89b8ea60c81c","7471c6d214ada31ae0d725bcc7b0dc4be725211e66ff8a7d4249895579905177","2dd0fad9f7cf34671d9dcfd9d8d6d6554cd53d71cb6d1a25a51570d3b8360290","93a1484f5f9d118ea005138062a4affe7d7dab8edd56da3d34340d75c5859c52","1e4910d20153d825152ae67a70eafba64a98c6b8460bfeaa5f10773230f282cc","8d20d79c571275cbbfe1e6b0986b59961d40b2058159c0d906424a0d4fcb39a6","8ff88ca3f74a5c7977f34792ed18b0f60ca7b0761c12f07e9348cb0893126546"],"paragraph_range_zero_based":[30456,30479],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30456"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30480},{"literal_text_all_w_t_and_m_t":"GroupB-ConfiguredTwoStepRA-r16 ::=                       SEQUENCE {","paragraph_zero_based":30481},{"literal_text_all_w_t_and_m_t":"    ra-MsgA-SizeGroupA-r16                               ENUMERATED {b56, b144, b208, b256, b282, b480, b640, b800,","paragraph_zero_based":30482},{"literal_text_all_w_t_and_m_t":"                                                                     b1000, b72, spare6, spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":30483},{"literal_text_all_w_t_and_m_t":"    messagePowerOffsetGroupB-r16                         ENUMERATED {minusinfinity, dB0, dB5, dB8, dB10, dB12, dB15, dB18},","paragraph_zero_based":30484},{"literal_text_all_w_t_and_m_t":"    numberOfRA-PreamblesGroupA-r16                       INTEGER (1..64)","paragraph_zero_based":30485},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30486},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30487},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-STOP","paragraph_zero_based":30488},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30489},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30490},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA field descriptions","paragraph_zero_based":30491},{"literal_text_all_w_t_and_m_t":"featureCombinationPreamblesList","paragraph_zero_based":30492},{"literal_text_all_w_t_and_m_t":"Specifies a series of preamble partitions each associated to a combination of features and 2-step RA. The network does not configure this list to have more than 16 entries.","paragraph_zero_based":30493},{"literal_text_all_w_t_and_m_t":"groupB-ConfiguredTwoStepRA","paragraph_zero_based":30494},{"literal_text_all_w_t_and_m_t":"Preamble grouping for 2-step random access type. If the field is absent then there is only one preamble group configured and only one msgA PUSCH configuration.","paragraph_zero_based":30495},{"literal_text_all_w_t_and_m_t":"msgA-CB-PreamblesPerSSB-PerSharedRO","paragraph_zero_based":30496},{"literal_text_all_w_t_and_m_t":"Number of contention-based preambles used for 2-step RA type from the non-CBRA 4-step type preambles associated with each SSB for RO shared with 4-step type RA. The number of preambles for 2-step RA type shall not exceed the number of preambles per SSB minus the number of contention-based preambles per SSB for 4-step type RA. The possible value range for this parameter needs to be aligned with value range for the configured SSBs per RACH occasion in ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon. The field is only applicable for the case of shared ROs with 4-step type random access.","paragraph_zero_based":30497},{"literal_text_all_w_t_and_m_t":"msgA-PRACH-RootSequenceIndex","paragraph_zero_based":30498},{"literal_text_all_w_t_and_m_t":"PRACH root sequence index. If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e., not within AdditionalRACH-Config), the UE applies the value in field prach-RootSequenceIndex in RACH-ConfigCommon in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE applies the corresponding value of prach-RootSequenceIndex in RACH-ConfigCommon in the same AdditionalRACH-Config. When both 2-step and 4-step type random access is configured, this field is only configured for the case of separate ROs between 2-step and 4-step type random access.","paragraph_zero_based":30499},{"literal_text_all_w_t_and_m_t":"For FR2-2, only the following values are applicable depending on the used subcarrier spacing:","paragraph_zero_based":30500},{"literal_text_all_w_t_and_m_t":"120 kHz:  L=139, L=571, and L=1151","paragraph_zero_based":30501},{"literal_text_all_w_t_and_m_t":"480 kHz:  L=139, and L=571","paragraph_zero_based":30502},{"literal_text_all_w_t_and_m_t":"960 kHz:  L=139","paragraph_zero_based":30503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e25d54c7c9d2fe32c878ff63094b7ce656274a800fc48a0728353d3f9b4d0579","759d28dcedc9bbcfd86120edc71ceb625f61c716d9b21c1a17f243f712d78f5e","651292053ee9d8aa89340a2c89ce60d7549c3cf4920926284b1035a71ba8bc20","c4058f586dfacbe855839b84cfab1029f9f85acce1f9399019345f0070b35e44","80ce7c1e30a3101b06c6a36b6db71134024cfce6a5e70c943caa42c78c116212","0339705b53f41d10e87b2062b0dca18822a9546a8a7f2c771428ea1351c3b0c6","5825fa01f8ec664a790ef62f4610791087c6a8d9e7a621eb149f717c6c6437df","681df347e24da8f1153544828193bab53025281ff1e860c767d3662e30a6e520","7b49e7a50beedd947feddc0148bceb18c3940aed0800bf2e1551621b1e922989","ffad7b72cdbd56f27f23c9cfbf694b4bd911ab48702176344be8228dc3d3586e","cbdb0d85bf2377fe41aad24cbb654fa07868649456d3bb3f0f4eed297e5f846e","721cda716fff5e12b2f170ab76b30ee8427d59f228140cee0ede36680a2cfa98","1c9b74bdd4e9fe5689ecb926a331367f5f67156572716bd524e305401f1208de","876e386315a1efd1265c659e52e0c184565b2e2835c4d10df9d2c9d6a88cda5b","123a6c3a0e71379a985af83878e6619f7b306b56550135c5306129e5f21500c8","64eb6379a8344dadce8c631c024a95268983f0b6ee7205e738398f5a7afc03a8","9b454aaf1764b4452a362952366da863d33633f8c8066da2345edbd71474774c","dd81fb45286dcbb2c7046dd86826248ae2a70bdf325cd21b94dd5187c18fba82","c42b6b50dcc2b01e8b0a7b522408837ffb4d539b5a7871f003e4870482e2ed8f","67006bb9e765fbf66170adea281e9b692e3082e80dc2c0bb1848c2f40072f1ed","aeb25597e8c9f0db892dd574800ccbb1dd22b90e973c0dc0dd885fc18b9e3380","b15c198405d251d548ab9f6c738270a1cd20b2a9ba55474487e6d7f8695ecdcc","a61a3629bab85baf3b5903cb816a9e865515ad23161fe5930cd281de5f81d78d","02dd0b40ca95a421de04a21349970a7c6eb2de7f3feaa86128fe8a225281377b"],"paragraph_range_zero_based":[30480,30503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30480"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-RestrictedSetConfig","paragraph_zero_based":30504},{"literal_text_all_w_t_and_m_t":"Configuration of an unrestricted set or one of two types of restricted sets for 2-step random access type preamble. If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config), the UE applies the value in field restrictedSetConfig in RACH-ConfigCommon in the configured BWP. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE applies the value of restrictedSetConfig in RACH-ConfigCommon in the same AdditionalRACH-Config. When both 2-step and 4-step type random access is configured, this field is only configured for the case of separate ROs between 2-step and 4-step type random access.","paragraph_zero_based":30505},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-Threshold","paragraph_zero_based":30506},{"literal_text_all_w_t_and_m_t":"The UE selects 2-step random access type to perform random access based on this threshold (see TS 38.321 [3], clause 5.1.1). This field is only present if both 2-step and 4-step RA type are configured for the BWP.","paragraph_zero_based":30507},{"literal_text_all_w_t_and_m_t":"msgA-RSRP-ThresholdSSB","paragraph_zero_based":30508},{"literal_text_all_w_t_and_m_t":"UE may select the SS block and corresponding PRACH resource for path-loss estimation and (re)transmission based on SS blocks that satisfy the threshold (see TS 38.213 [13]).","paragraph_zero_based":30509},{"literal_text_all_w_t_and_m_t":"msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB","paragraph_zero_based":30510},{"literal_text_all_w_t_and_m_t":"The meaning of this field is twofold: the CHOICE conveys the information about the number of SSBs per RACH occasion. Value oneEight corresponds to one SSB associated with 8 RACH occasions, value oneFourth corresponds to one SSB associated with 4 RACH occasions, and so on. The ENUMERATED part indicates the number of Contention Based preambles per SSB. Value n4 corresponds to 4 Contention Based preambles per SSB, value n8 corresponds to 8 Contention Based preambles per SSB, and so on. The total number of CB preambles in a RACH occasion is given by CB-preambles-per-SSB * max(1, SSB-per-rach-occasion). If the field is not configured in RACH-ConfigCommonTwoStepRA which is configured directly within a BWP (i.e. not within AdditionalRACH-Config) and both 2-step and 4-step are configured for the BWP, the UE applies the value in the field ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon. If the field is not configured in AdditionalRACH-Config and both 2-step and 4-step are configured in AdditionalRACH-Config, the UE applies the value in the field ssb-perRACH-OccasionAndCB-PreamblesPerSSB in RACH-ConfigCommon in the same AdditionalRACH-Config. The field is not present when RACH occasions are shared between 2-step and 4-step type random access in the BWP.","paragraph_zero_based":30511},{"literal_text_all_w_t_and_m_t":"msgA-SSB-SharedRO-MaskIndex","paragraph_zero_based":30512},{"literal_text_all_w_t_and_m_t":"Indicates the subset of 4-step type ROs shared with 2-step random access type for each SSB. This field is configured when there is more than one RO per SSB. If the field is absent, and 4-step and 2-step has shared ROs, then all ROs are shared.","paragraph_zero_based":30513},{"literal_text_all_w_t_and_m_t":"msgA-SubcarrierSpacing","paragraph_zero_based":30514},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of PRACH (see TS 38.211 [16], clause 5.3.2).","paragraph_zero_based":30515},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":30516},{"literal_text_all_w_t_and_m_t":"FR1:    15 or 30 kHz","paragraph_zero_based":30517},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":30518},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz.","paragraph_zero_based":30519},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the SCS as derived from the msgA-PRACH-ConfigurationIndex in RACH-ConfigGenericTwoStepRA (see tables Table 6.3.3.1-1, Table 6.3.3.1-2, Table 6.3.3.2-2 and Table 6.3.3.2-3, TS 38.211 [16]) in case of 2-step only BWP, otherwise the UE applies the same SCS as Msg1 derived from RACH-ConfigCommon. The value also applies to contention free 2-step random access type (RACH-ConfigDedicated).","paragraph_zero_based":30520},{"literal_text_all_w_t_and_m_t":"msgA-TotalNumberOfRA-Preambles","paragraph_zero_based":30521},{"literal_text_all_w_t_and_m_t":"Indicates the total number of preambles used for contention-based and contention-free 2-step random access type when ROs for 2-step are not shared with 4-step. If the field is absent, and 2-step and 4-step does not have shared ROs, all 64 preambles are available for 2-step random access type.","paragraph_zero_based":30522},{"literal_text_all_w_t_and_m_t":"msgA-TransMax","paragraph_zero_based":30523},{"literal_text_all_w_t_and_m_t":"Max number of MsgA preamble transmissions performed before switching to 4-step random access (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when 2-step and 4-step RA type are configured and switching to 4-step type RA is supported. If the field is absent, switching from 2-step RA type to 4-step RA type is not allowed.","paragraph_zero_based":30524},{"literal_text_all_w_t_and_m_t":"ra-ContentionResolutionTimer","paragraph_zero_based":30525},{"literal_text_all_w_t_and_m_t":"The initial value for the contention resolution timer for fallback RAR in case no 4-step random access type is configured (see TS 38.321 [3], clause 5.1.5). Value sf8 corresponds to 8 subframes, value sf16 corresponds to 16 subframes, and so on. If both 2-step and 4-step random access type resources are configured on the BWP, then this field is absent. If the field is absent in RACH-ConfigCommonTwoStepRA in AdditionalRACH-Config, the UE shall apply the corresponding value in RACH-ConfigCommon in the same AdditionalRACH-Config.","paragraph_zero_based":30526},{"literal_text_all_w_t_and_m_t":"ra-Prioritization","paragraph_zero_based":30527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3d7f56ba65dc7181f7791d76dd67bd0cb45ba6c92ddbcea95074a13f757fb22c","ee0c28ce9863d8f586a2c2f8be801c6596198c1aaf31f145bc89f9f6be23f58b","2b1c65653fd34f43cc1e1e7ce66a3108333164f63b77746dd191f4c1377aa9f4","ecf2ab0b384065a9ed7558d6a10bd56ca2364df3df4a799fdfcecae606aee46c","968f0e25fde857d6f95979ac32460de0f01b5f90347037eebaebf26adf9d5604","babc1ded112d4ad2bd43d0a7e11f35e15430fa0260ee892dd7b989b07af1e762","57d2ff339d4dfb14f03ecc602ca4c150e935043a45bd41793977fa386aece62c","e3c6f50737b640d037966b43c3de502655c4f6243252bc2e02a405b6e7b70f1d","076405e9e80d95f2e3b607e53749b3939650474fb99febbf821bc1e484f47d82","163921da807f90f9025d5f7e983070ce01df323de80475dfef48f13965f0ff1b","b3e81c50b4175900f7d8eb7d091133282c4fe182234d636d27aa439f631eaca3","e2c9b0c0fb72762b199459590984707db67fc870ed81127f20ed6cbef170c485","1c870268cd6227d3cde89c42f3e3a08d809a993632b6a73201fbcdbcb6982977","deb54057fab70b7f7706bde36f10799b7683226846cc25165f7b49190965a461","398e079a56a643cf1ee386903ea2334a650b496e222914a050868a0b81493e39","bbfecddbda6d560076434f2c147bd04ec61a54d0df9e5b521682e4aea6e90603","9d17d0aa4e43ad7591cd9db7061cc693d91748b1ea5d78cce7dafcd0ad754887","28a5fd7e3f4d4976327f6e7322efe7a1efe4124046b5745861b3eb045979f3c6","ee8fb124f0f27da5b72138d587a6cf7fd862f62f760eb5e5acf285948fbec379","54083eda9cbaa0f9744ee9b0c6c2237d2ecaa279e980b955c810f8846aa6b75f","ae62448247a512a00ca031d99a65f27895f2db8419a21fdc17321f44318808d9","a12f1bc6a7fb27bdb73dc1aa72e6e2ee6115d369a41f4b0479e28e85dec0741b","45d07ca6be4f82a34864fde8e46d91df17909700c62982cf5859fe3c583cc356","be460c3894b12b07785c7cd485376042cac726e1e9caa6c893633267907f1e0e"],"paragraph_range_zero_based":[30504,30527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30504"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure on any UL BWP of SpCell for specific Access Identities (see TS 38.321 [3], clause 5.1.1a).","paragraph_zero_based":30528},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForAI","paragraph_zero_based":30529},{"literal_text_all_w_t_and_m_t":"Indicates whether the field ra-Prioritization-r16 applies for Access Identities. The first/leftmost bit corresponds to Access Identity 1, the next bit corresponds to Access Identity 2. Value 1 for an Access Identity indicates that the field ra-Prioritization-r16 applies, otherwise the field does not apply.","paragraph_zero_based":30530},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationForSlicingTwoStep","paragraph_zero_based":30531},{"literal_text_all_w_t_and_m_t":"Parameters which apply to configure prioritized CBRA 2-step random access type for slicing.","paragraph_zero_based":30532},{"literal_text_all_w_t_and_m_t":"rach-ConfigGenericTwoStepRA","paragraph_zero_based":30533},{"literal_text_all_w_t_and_m_t":"2-step random access type parameters for both regular random access and beam failure recovery.","paragraph_zero_based":30534},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30535},{"literal_text_all_w_t_and_m_t":"GroupB-ConfiguredTwoStepRA field descriptions","paragraph_zero_based":30536},{"literal_text_all_w_t_and_m_t":"messagePowerOffsetGroupB","paragraph_zero_based":30537},{"literal_text_all_w_t_and_m_t":"Threshold for preamble selection. Value is in dB. Value minusinfinity corresponds to –infinity. Value dB0 corresponds to 0 dB, dB5 corresponds to 5 dB and so on. (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":30538},{"literal_text_all_w_t_and_m_t":"numberOfRA-PreamblesGroupA","paragraph_zero_based":30539},{"literal_text_all_w_t_and_m_t":"The number of CB preambles per SSB in group A for idle/inactive or connected mode. The setting of the number of preambles for each group should be consistent with msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB or msgA-CB-PreamblesPerSSB-PerSharedRO if configured.","paragraph_zero_based":30540},{"literal_text_all_w_t_and_m_t":"ra-MsgA-SizeGroupA","paragraph_zero_based":30541},{"literal_text_all_w_t_and_m_t":"Transport block size threshold in bits below which the UE shall use a contention-based RA preamble of group A. (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":30542},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30543},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30544},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30545},{"literal_text_all_w_t_and_m_t":"2Step4Step","paragraph_zero_based":30546},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if both 2-step random access type and 4-step random access type are configured in the BWP, otherwise the field is not present.","paragraph_zero_based":30547},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in AdditionalRACH-Config if both 2-step random access type and 4-step random access type are configured for the same feature combination in the BWP.","paragraph_zero_based":30548},{"literal_text_all_w_t_and_m_t":"2StepOnlyL139","paragraph_zero_based":30549},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if msgA-PRACH-RootSequenceIndex L=139 and no 4-step random access type is configured, otherwise the field is absent, Need S.","paragraph_zero_based":30550},{"literal_text_all_w_t_and_m_t":"2StepOnly","paragraph_zero_based":30551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["13a64447697b34ca1040df386e673bdccdafac8817f178c07c81941a2ed1372e","6e42b37f6165e1d942d8697724189d75adaf762c64ebe23ce430a83413560221","45ff12050c25fb1c71234e3588b9934bd6abf2db0a2619b0a56265659976e95b","ce27624d6bbc0e303beaf4a31e7181dca711f387379de2ea0b816ec4f9d35dff","0dcb4a80e24b5a1641a6bcd563c5d78a13ae65ef18807dd1ad39718a6717f7ec","0f42e360fc29852c5ed7562a8c46732f0626a42b627a71183fc4d44c43e0aa3c","325c0853e49fdf0521d37092571c170e73b6b041d8b662e772a005de8ace75f8","6fd2311248e953d67153b363016ea229557b04f169cfb39cdcfafabbc4de3717","a2a788068a0b0aa1beb72f4cc6be35ed99dfc11acd4054ad9755b66b75804cff","341b97191aa5c88a1f5d92e3b70588142486fbc9f17e4ca52b6dcf6f179053fb","624d3c6ff0f8cbe862fc28a72e8471dd831781307ab3b5be1fc5c3697c83f5d3","8efd698894a8f389144396ec7e380b698515f8f209e2d048e748d354eccdb8ec","5aa5b5562348407865eff228fe62092ce57d222d2d3e490a4307fe3278222eb6","8fd68dd8037f83e73e5e7eda95980a1f8a1b00280aa4dd143ec89d08904fb85c","1b581e082605cb965143463e1f8e7adbbed7e05b1d744337451a9320dc8306ce","8e7feb7a1c9f36b538e9d4d233fd6df985c74544a6d1da5967a0d65a19258522","23a2afcf5393d6d379882212a71271dea7a415737225304b8d1d6ac31ee9c95a","20c9b5b72d9f30f855d0d667c38027a63a47289b0526ca2f49ae062b532c4c7c","2bc931aee11e34d5cdd9375edbc215351145237e3da875c648dfccfddadea5d6","aa040914f679ad08f5c5cfe74eaf21cbd4fc59acfe538aef3954834d3c869b0c","d48daf1e38d5b6e17a19df4f926a751893b8372b7f7e67100909b49bf38cd445","30052c4923c22b4069f7400e759abaa62deed97b15dc0c6cc0219e26753dfbd7","fef5f917ccd6f22c24737b567c6c7f2563f1b4b661d169685bae0c05dae36305","1b4530b90c4279d0b47ffaf6258f73f35e8022c7e1fea8263cc3e4a5f36897d0"],"paragraph_range_zero_based":[30528,30551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30528"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in BWP-UplinkCommon if rach-ConfigCommon field is absent in this BWP-UplinkCommon, otherwise the field is optionally present in msgA-ConfigCommon field in BWP-UplinkCommon, Need S.","paragraph_zero_based":30552},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in msgA-ConfigCommon field in AdditionalRACH-Config if rach-ConfigCommon field is absent in this AdditionalRACH-Config, otherwise the field is optionally present in msgA-ConfigCommon field in AdditionalRACH-Config, Need S.","paragraph_zero_based":30553},{"literal_text_all_w_t_and_m_t":"AdditionalRACH","paragraph_zero_based":30554},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the msgA-ConfigCommon is included in an AdditionalRACH-Config. When included in initialUplinkBWP-RedCap to indicate other feature(s) than redcap, this field is mandatory present with at least two FeatureCombinationPreambles list entries: one list entry indicating only redcap and the other(s) indicating both redcap and one or multiple other feature(s) (e.g. smallData, nsag or msg3-Repetitions).","paragraph_zero_based":30555},{"literal_text_all_w_t_and_m_t":"Otherwise, it is optional, Need R.","paragraph_zero_based":30556},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":30557},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initial BWP of SpCell. Otherwise, the field is absent.","paragraph_zero_based":30558},{"literal_text_all_w_t_and_m_t":"SharedRO","paragraph_zero_based":30559},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the 2-step random access type occasions are shared with 4-step random access type, otherwise the field is not present.","paragraph_zero_based":30560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30561},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigDedicated","paragraph_zero_based":30562},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigDedicated is used to specify the dedicated random access parameters.","paragraph_zero_based":30563},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated information element","paragraph_zero_based":30564},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30565},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGDEDICATED-START","paragraph_zero_based":30566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30567},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30568},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated ::=        SEQUENCE {","paragraph_zero_based":30569},{"literal_text_all_w_t_and_m_t":"    cfra                            CFRA                                                                    OPTIONAL, -- Need S","paragraph_zero_based":30570},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization               RA-Prioritization                                                       OPTIONAL, -- Need N","paragraph_zero_based":30571},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30572},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30573},{"literal_text_all_w_t_and_m_t":"    ra-PrioritizationTwoStep-r16    RA-Prioritization                                                       OPTIONAL, -- Need N","paragraph_zero_based":30574},{"literal_text_all_w_t_and_m_t":"    cfra-TwoStep-r16                CFRA-TwoStep-r16                                                        OPTIONAL  -- Need S","paragraph_zero_based":30575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf81