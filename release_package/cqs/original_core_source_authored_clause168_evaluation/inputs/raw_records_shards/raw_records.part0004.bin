"483cc528c02c8e106d33b3e7f90bca21b2a6d2aaab1dc76d237f6f8f8f859ac4","98b5d05d2e9ed2ec6bef573b1e7fbac60039a7484251f0eb5851f7ab5b3803cd","d3923f8b9b59992448e3d7ac01d1fec5ecd4c399219ee6606749daf75d454948","077db4d1c891c7ab438574f2f55235915b9ece2022b5cc0aa2d1842a6d72f709","15ae3901b4df76cece16b5153a112d01426045eabc685ab4133dbb3b3d6b2a4a","b364585b7c62e31e489b9cc6fedc75d798df8313fec0b370accbe516a9c7174e","3c14a4e5b91d5bafdb09b77119dc4e02a9c892eabfa761df14c41cbfba49c80c","6a23cf37545e35eea3cfc7ccf0385f0e6d7d76f84f27f834855a363d38608e8a","da23830937b129b8b7b340b52fb2aff90879e0f6113623ce1372f11bec5cc409","de60cc9d953fed534b1ce2c570517cb6ba06e95feb9815d3e1fc5a272716ad43","b54b25ae7a71a1b5ec7cda70289bf03f3a45fbf22ccffa2fd814a1396b1ce487","a64a0efa1f824f67854ceb7810ccd347a19d51dc82b0d67ef6c8f117628afdc9"],"paragraph_range_zero_based":[35376,35399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35376"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":35400},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB. In case the servingCellId is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field servingCellId. Otherwise, it refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell where the ul-TCI-StateList is applied by the UE.","paragraph_zero_based":35401},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":35402},{"literal_text_all_w_t_and_m_t":"The DL BWP which the CSI-RS is located in or UL BWP where the SRS is located in.","paragraph_zero_based":35403},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":35404},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-UL-State is applied by the UE.","paragraph_zero_based":35405},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":35406},{"literal_text_all_w_t_and_m_t":"The ID of the reference Signal (e.g. a CSI-RS or a SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the UL TCI State is applied by the UE.","paragraph_zero_based":35407},{"literal_text_all_w_t_and_m_t":"tag-Id-ptr","paragraph_zero_based":35408},{"literal_text_all_w_t_and_m_t":"It indicates the TAG that is associated with this TCI state, value n0 means the TCI state associate with the TAG indicated by tag-Id, value n1 means this TCI state associated with the TAG indicated by tag2-Id. The tag_id_ptr refers to the TAG of the serving cell where the TCI state is applied.","paragraph_zero_based":35409},{"literal_text_all_w_t_and_m_t":"ul-powerControl","paragraph_zero_based":35410},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the ul-TCI-ToAddModList is configured.","paragraph_zero_based":35411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35412},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35413},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35414},{"literal_text_all_w_t_and_m_t":"2TA","paragraph_zero_based":35415},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if tag2 is present for the serving cell. It is absent, Need R, otherwise.","paragraph_zero_based":35416},{"literal_text_all_w_t_and_m_t":"CSI-RSorSRS-Indicated","paragraph_zero_based":35417},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if referenceSignal is set to csi-RS-index or to srs, absent otherwise","paragraph_zero_based":35418},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":35419},{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":35420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35421},{"literal_text_all_w_t_and_m_t":"–TCI-UL-StateId","paragraph_zero_based":35422},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-StateId is used to identify one TCI-UL-State configuration.","paragraph_zero_based":35423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256"