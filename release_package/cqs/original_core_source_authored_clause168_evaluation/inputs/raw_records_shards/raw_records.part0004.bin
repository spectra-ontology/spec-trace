{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33329},{"literal_text_all_w_t_and_m_t":"–ServingCellAndBWP-Id","paragraph_zero_based":33330},{"literal_text_all_w_t_and_m_t":"The IE ServingCellAndBWP-Id is used to indicate a serving cell and an uplink or a downlink BWP.","paragraph_zero_based":33331},{"literal_text_all_w_t_and_m_t":"ServingCellAndBWP-Id information element","paragraph_zero_based":33332},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33333},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLANDBWP-ID-START","paragraph_zero_based":33334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6ff17cac3b0dd012c0ca52f53160f1073210146d7d74c017162bf5581a13fc64","263d0f2d7da2f4b25c6f59b401930d343e0a2630977dd9b739b8d2d6e7302119","9f7ef0de6f8d9b3b8bf98f4f705f917665f6a52f106c7039f3720851a1bc6efd","f1a9089916bf36de9ed37041e260095d6636af2a0a0a07cb76db066bfaeded15","11af5060efcbbdd254ab6a441cdbb89a41ed46e27384ab9e76a29c03294075c5","77f62a03c040fb5048569ee32528066c999b6cb15f6599a45717d9037b59fe10","6084c713313a94f6a335fe04a26787465c5bc9452e202def7583fea9970bf1d8","5e6470a1c99338e13f57d923d7c6fb705b523bb26032494c00e7b5b034db4c5b","a1de9f05eee6665b9c876205452779b6fb16ac4ee9e2d7b434c1e9c0aa6781e6","6ec66a20c53f124f36570eb7f25f2fae06139ec1e4d0ade5ebae1597bccd6a77","44691bb57584e185a53c976f4483cfee8ecf85b4b69e9e7bb18917d1766529d1","92f0a2e7cd137f44d8b9985c9ce0f8c3a7786ea5ed3bfdd2f187b25af57413ce","7f088ab80eb3443753895f16d4e66607bb0bca4645040d337f5033a7065d6697","88dc4ab4b695a51d45a3371fe4f3001cb286e1d7d430233b8ca9c06b57fb72fd","2245cc94442befcf7994f7b6efc104af0405993c28312a6797db