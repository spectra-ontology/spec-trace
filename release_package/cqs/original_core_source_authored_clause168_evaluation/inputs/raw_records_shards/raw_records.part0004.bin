{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46344},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RBSETCONFIG-STOP","paragraph_zero_based":46345},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46346},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46347},{"literal_text_all_w_t_and_m_t":"SL-RBSetConfig field descriptions","paragraph_zero_based":46348},{"literal_text_all_w_t_and_m_t":"sl-GapBetweenSSSBRepetition","paragraph_zero_based":46349},{"literal_text_all_w_t_and_m_t":"Indicate the gap between two adjacent S-SSB repetitions in frequency domain in one RB set, and the gap is between the lowest subcarrier of the upper PSBCH and the highest subcarrier of the lower PSBCH. The Unit is PRB.","paragraph_zero_based":46350},{"literal_text_all_w_t_and_m_t":"sl-NumOfSSSBRepetition","paragraph_zero_based":46351},{"literal_text_all_w_t_and_m_t":"Indicate the number of S-SSB repetitions in frequency domain in one RB set. Legacy S-SSB are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":46352},{"literal_text_all_w_t_and_m_t":"sl-RBSetIndex","paragraph_zero_based":46353},{"literal_text_all_w_t_and_m_t":"Indicates the index of RB-set for which the configuration applies.","paragraph_zero_based":46354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46355},{"literal_text_all_w_t_and_m_t":"–SL-RelayUE-Config","paragraph_zero_based":46356},{"literal_text_all_w_t_and_m_t":"The IE SL-RelayUE-Config specifies the configuration information for NR sidelink U2N Relay UE.","paragraph_zero_based":46357},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config information element","paragraph_zero_based":46358},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46359},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIG-START","paragraph_zero_based":46360},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46361},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config-r17::=           SEQUENCE {","paragraph_zero_based":46362},{"literal_text_all_w_t_and_m_t":"    threshHighRelay-r17                RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":46363},{"literal_text_all_w_t_and_m_t":"    threshLowRelay-r17                 RSRP-Range                              OPTIONAL,     -- Need R","paragraph_zero_based":46364},{"literal_text_all_w_t_and_m_t":"    hystMaxRelay-r17                   Hysteresis                              OPTIONAL,     -- Cond ThreshHighRelay","paragraph_zero_based":46365},{"literal_text_all_w_t_and_m_t":"    hystMinRelay-r17                   Hysteresis                              OPTIONAL      -- Cond ThreshLowRelay","paragraph_zero_based":46366},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46367}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f5aa6d6a55a6b90b6d31d10764e9a3dea1d5b16f070b3467bf74e43762175071","4eb554e0b1b09e56bd83aa8b71a3a6c9834273f76c984fa54742e4181db2326b","bd106b8601c9bfe5b318f3cd6be80bef32cba05be0fb6ea7ab6aa024f2c59ca1","fca4cbf04fe4df64879477c017d467727dc83028c91b956ce32f91c050f05cf1","10ec880a3065385d90fcd899a49fc16983ef5ab3644179d8512c66550838250a","6a7efecdd0d1515b26718da1605610dca6bc557bfedeafb5b154df878ca6a37e","aec114c53e1e9b2849bce733487141bb401e29a3f330aeea4e2fad812535e1b2","36d7f079936496358da023af82dce2efd5d97790e39abd3ce4c0f2857ce65705","1dd0e56072e143c07f8c52b9764f17864df71c01a9b4d730377e134b7f84b986","9e31d221a7a8b90e9b8b31b916d51f3857275d463e05085ad26f03ea7c06d5dd","1e97ac3547adc7cd