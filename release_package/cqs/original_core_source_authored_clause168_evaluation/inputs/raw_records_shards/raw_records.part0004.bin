{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45024},{"literal_text_all_w_t_and_m_t":"–SL-DRX-Config","paragraph_zero_based":45025},{"literal_text_all_w_t_and_m_t":"The IE SL-DRX-Config is used to configure DRX related parameters for NR sidelink communication/discovery. The SL DRX timers should be calculated in the unit of physical slot.","paragraph_zero_based":45026},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config information element","paragraph_zero_based":45027},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45028},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIG-START","paragraph_zero_based":45029},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45030},{"literal_text_all_w_t_and_m_t":"SL-DRX-Config-r17 ::=                      SEQUENCE {","paragraph_zero_based":45031},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigGC-BC-r17                     SL-DRX-ConfigGC-BC-r17                                                 OPTIONAL,     -- Cond HO","paragraph_zero_based":45032},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-ToReleaseList-r17          SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DestinationIndex-r16     OPTIONAL,     -- Need N","paragraph_zero_based":45033},{"literal_text_all_w_t_and_m_t":"    sl-DRX-ConfigUC-ToAddModList-r17           SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-DRX-ConfigUC-Info-r17    OPTIONAL,     -- Need N","paragraph_zero_based":45034},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45035},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45036},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45037},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigUC-Info-r17 ::=               SEQUENCE {","paragraph_zero_based":45038},{"literal_text_all_w_t_and_m_t":"    sl-DestinationIndex-r17                 