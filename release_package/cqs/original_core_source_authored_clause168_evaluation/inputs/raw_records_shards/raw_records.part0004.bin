{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27120},{"literal_text_all_w_t_and_m_t":"LTM","paragraph_zero_based":27121},{"literal_text_all_w_t_and_m_t":"The field is optionally present in an LTM-Candidate IE. Otherwise, the field is absent.","paragraph_zero_based":27122},{"literal_text_all_w_t_and_m_t":"Periodic","paragraph_zero_based":27123},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":27124},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":27125},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent NZP-CSI-RS-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":27126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27127},{"literal_text_all_w_t_and_m_t":"–NZP-CSI-RS-ResourceId","paragraph_zero_based":27128},{"literal_text_all_w_t_and_m_t":"The IE NZP-CSI-RS-ResourceId is used to identify one NZP-CSI-RS-Resource.","paragraph_zero_based":27129},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId information element","paragraph_zero_based":27130},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27131},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-START","paragraph_zero_based":27132},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27133},{"literal_text_all_w_t_and_m_t":"NZP-CSI-RS-ResourceId ::=           INTEGER (0..maxNrofNZP-CSI-RS-Resources-1)","paragraph_zero_based":27134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27135},{"literal_text_all_w_t_and_m_t":"-- TAG-NZP-CSI-RS-RESOURCEID-STOP","paragraph_zero_ba