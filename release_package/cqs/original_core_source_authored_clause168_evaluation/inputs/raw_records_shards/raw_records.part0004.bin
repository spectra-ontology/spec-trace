OPTIONAL,   -- Cond SymbolPeriodicity","paragraph_zero_based":36301},{"literal_text_all_w_t_and_m_t":"        timeGranularityForCI-r16                 ENUMERATED {n1, n2, n4, n7, n14, n28},","paragraph_zero_based":36302},{"literal_text_all_w_t_and_m_t":"        frequencyRegionForCI-r16                 INTEGER (0..37949),","paragraph_zero_based":36303},{"literal_text_all_w_t_and_m_t":"        deltaOffset-r16                          INTEGER (0..2),","paragraph_zero_based":36304},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":36305},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":36306},{"literal_text_all_w_t_and_m_t":"    uplinkCancellationPriority-v1610         ENUMERATED {enabled}                                                  OPTIONAL    -- Need S","paragraph_zero_based":36307},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36308},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36309},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-STOP","paragraph_zero_based":36310},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["28f9d408bd31cfcce3e37b6ccb72f118a6541029e4935d2389f5ae6e139e70f3","086172fcab0046a566960463b644f0fab52420b3b1f3478a089f84a2d113c0f2","741f175a97753a0dda9c52a988f879fbc696420e6a6ac5d85d28e51b8aa6dcb7","2229ffd3d9fa23988dae020bab9a207268e3289dc0e3e8355fad695af34fcac6","b58f69e82c8fa366cd789f8e0144b7093c9607ac3e0141cdda2f6d899912ccdf","df4e6f994e1836a231fe3468b0335b1e99e60b4feeb873b1431cd8393a8fda8e","734ae10ee725e94ddb558e649db52703d888bbdfbae8dc24f8b4ad49af14b016","62c4164295f455c1b60e4f8a416608d00006acca6f3b