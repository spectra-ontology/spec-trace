{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6192},{"literal_text_all_w_t_and_m_t":"Inequality C1-2 (Leaving condition)","paragraph_zero_based":6193},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6194},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6195},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":6196},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":6197},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c1-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":6198},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":6199},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":6200},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Ms.","paragraph_zero_based":6201},{"literal_text_all_w_t_and_m_t":"5.5.4.12Event C2 (The NR sidelink channel busy ratio is below a threshold)","paragraph_zero_based":6202},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6203},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C2-1, as specified below, is fulfilled;","paragraph_zero_based":6204},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C2-2, as specified below, is fulfilled;","paragraph_zero_based":6205},{"literal_text_all_w_t_and_m_t":"Inequality C2-1 (Entering condition)","paragraph_zero_based":6206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6207},{"literal_text_all_w_t_and_m_t":"Inequality C2-2 (Leaving condition)","paragraph_zero_based":6208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":6209},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6210},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of channel busy ratio of the transmission resource pool, not taking into account any offsets.","paragraph_zero_based":6211},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR-SL for this event).","paragraph_zero_based":6212},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. c2-Threshold as defined within reportConfigNR-SL for this event).","paragraph_zero_based":6213},{"literal_text_all_w_t_and_m_t":"Ms is expressed in decimal from 0 to 1 in steps of 0.01.","paragraph_zero_based":6214},{"literal_text_all_w_t_and_m_t":"Hys is expressed is in the same unit as Ms.","paragraph_zero_based":6215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e3c60d9e9d6235ecca9c648d9083566a66ecf8d7019b7378c017ae05f9028885","3e28fbb377087ef146fabf8e5f053ae0bdbce5e6fea4eaf59a098c37aeb89c43","3692663dd6bc49da8aaa40d7573c976bb1690bea6393f830265646687a9b3ba5","c6e7ee130bc0aff1ebe9e3a9cca186f1dea88e3aad687ec7110cd766c0eef74a","2fb225448293afc68aad2e85fdc5bcfa4c8e3d9f98484c36f562e3ce6a3eed1d","053cff8b2d6f1f52b760719c135eff91a2c40504d93e508314ddaaa7c898debf","dd7536447694e4529736c488dced14e018d2b3846f