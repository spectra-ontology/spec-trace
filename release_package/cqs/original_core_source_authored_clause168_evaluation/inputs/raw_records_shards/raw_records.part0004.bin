{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32376},{"literal_text_all_w_t_and_m_t":"MulticastRLC-BearerConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":32377},{"literal_text_all_w_t_and_m_t":"    servedMBS-RadioBearer-r17                   MRB-Identity-r17,","paragraph_zero_based":32378},{"literal_text_all_w_t_and_m_t":"    isPTM-Entity-r17                            ENUMERATED {true}                                   OPTIONAL    -- Need S","paragraph_zero_based":32379},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32380},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32381},{"literal_text_all_w_t_and_m_t":"LogicalChannelIdentityExt-r17 ::=           INTEGER (320..65855)","paragraph_zero_based":32382},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32383},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-STOP","paragraph_zero_based":32384},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32386},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig field descriptions","paragraph_zero_based":32387},{"literal_text_all_w_t_and_m_t":"isPTM-Entity","paragraph_zero_based":32388},{"literal_text_all_w_t_and_m_t":"If configured, indicates that the RLC entity is used for PTM reception. When the field is absent the RLC entity is used for PTP transmission/reception.","paragraph_zero_based":32389},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentity","paragraph_zero_based":32390},{"literal_text_all_w_t_and_m_t":"ID used commonly for the MAC logical channel and for the RLC bearer. Value 4 is not configured for DRBs if SRB4 is configured.","paragraph_zero_based":32391},{"literal_text_all_w_t_and_m_t":"logicalChannelIdentityExt","paragraph_zero_based":32392},{"literal_text_all_w_t_and_m_t":"Extended logical channel ID used commonly for the MAC logical channel and for the RLC bearer for PTM reception. If this field is configured, the UE shall ignore logicalChannelIdentity.","paragraph_zero_based":32393},{"literal_text_all_w_t_and_m_t":"reestablishRLC","paragraph_zero_based":32394},{"literal_text_all_w_t_and_m_t":"Indicates that RLC should be re-established. Network sets this to true at least whenever the security key used for the radio bearer associated with this RLC entity changes. For SRB2, multicast MRBs and DRBs, unless full configuration is used, it is also set to true during the resumption of the RRC connection or the first reconfiguration after reestablishment. For SRB1, when resuming an RRC connection, or at the first reconfiguration after RRC connection reestablishment, the network does not set this field to true. The network does not include this field if servedRadioBearer is set to drb-Identity and the RLC-BearerConfig IE is part of an RRCReconfiguration message contained in ltm-CandidateConfig. For SRB3 and DRBs, network doesn't include this field if the RLC-BearerConfig IE is part of an RRCReconfiguration message associated with subsequent CPAC within the ConditionalReconfiguration IE.","paragraph_zero_based":32395},{"literal_text_all_w_t_and_m_t":"rlc-Config","paragraph_zero_based":32396},{"literal_text_all_w_t_and_m_t":"Determines the RLC mode (UM, AM) and provides corresponding parameters. RLC mode reconfiguration can only be performed by DRB/multicast MRB release/addition or full configuration. The network may configure rlc-Config-v1610 only when rlc-Config (without suffix) is set to am.","paragraph_zero_based":32397},{"literal_text_all_w_t_and_m_t":"servedMBS-RadioBearer","paragraph_zero_based":32398},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with a multicast MRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedMBS-RadioBearer.","paragraph_zero_based":32399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3529a17605a37d62c05192c67f67ca63cd4839f336e1585306f108fc314c59eb","34e5d4e872ae5bc04a088937c1d87ca5cb846924cdc32822b2496644e4bbed68","f4a89fa63cb2c2738361ca0b62710ed53af3f062737d29b9d6b0f4cc31a624ac","947980b6b4d8db5bb2ce95059b396bdc3386ebe8db9fa4dd2936f20649712806","f289d753fa9bd325f813fa1832b172a8a3b51b7c600dcdc066c109bfc307ff2e","522c602978733772a0beb58500c5b3c097d2b635e64877f3180ba2334b82edf1","7f6fef487e9454de63c5be1f1c522d5dc4584de02df876454e34e9ef453dfb55","a42e515cdef23011e0e14ae07cef7becc0736531007bd50c6bb72dcc5013be80","8fb6c6f8e2df1f2373c2c23d3ec185689a8e908f2471e9fb1ee9899911a25f67","6eda04c1a8200de80d8db827a09f72b041f006198952c68d6783d7d7e187b4c1","1eb3d028af6d11164e29c34d2a79e9570cbab76f6f7d61498226cf9ac74618ec","cb4f460d86cc11cb8a89cf07c0e908ca4570fca329bfc5611e8d2c5f37479b65","45cdbcd0afa662046e6304b6afcd0ccd4cb365c29d931b0c8dc771bbf2e1de6b","68d8046ee234355faddc1c9b46e27b1214cb8199be7b8e14e31767b8ced63dcc","909553c6dc4c785aec2570aec904db88e018d206b3374165f65c8a6af1c91003","b3a739d21006699a9135fbf8549ab0294c31d95b8502da27275328245ab9e5df","ebc75f112b0465936b8c901f4fe79f6b6b821c900bb739dc5182c4fab09e9103","e9250274995f52bce078df87efcc78d483240c04d302affd6d1e1a38def3eec3","2af0a733c6889b7ad09865b0d30e6b2ffe15bd4896dbad08c7520c471176b903","b50ec73b290a1e433a33f13eb0446e1ae956c89829e08bddbe9325dabb4753ce","60ac6a6babf28d59a3228508b4a65fea50bfcee6d6b1e7b97665a470935fefe6","2bea408997ab77970d4dd959480659d56a340376b008f83c7d3576b41d5345c2","8f521a9e21cb02f0f27415bcc005e74822f9140f42f3013fc6efd843dd6d6471","f8752c48643716c79ffa755eb2d65bf2d7ff9035d2848af39421ef09be7b94aa"],"paragraph_range_zero_based":[32376,32399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32376"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"servedRadioBearer, servedRadioBearerSRB4","paragraph_zero_based":32400},{"literal_text_all_w_t_and_m_t":"Associates the RLC Bearer with an SRB or a DRB. The UE shall deliver DL RLC SDUs received via the RLC entity of this RLC bearer to the PDCP entity of the servedRadioBearer. Furthermore, the UE shall advertise and deliver uplink PDCP PDUs of the uplink PDCP entity of the servedRadioBearer to the uplink RLC entity of this RLC bearer unless the uplink scheduling restrictions (moreThanOneRLC in PDCP-Config and the restrictions in LogicalChannelConfig) forbid it to do so.","paragraph_zero_based":32401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32402},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":32403},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":32404},{"literal_text_all_w_t_and_m_t":"LCH-Setup","paragraph_zero_based":32405},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or a multicast MRB or SRB4. This field is optionally present, Need S, upon creation of a new logical channel for an SRB except SRB4. It is optionally present, Need M, otherwise.","paragraph_zero_based":32406},{"literal_text_all_w_t_and_m_t":"LCH-SetupModMRB","paragraph_zero_based":32407},{"literal_text_all_w_t_and_m_t":"This field is optionally present upon creation of a new logical channel for PTM reception for a multicast MRB. If this field is included upon creation of a new logical channel for PTM reception for a multicast MRB, it shall be present when modifying this logical channel. The field is absent for logical channels configured for an SRB and a DRB.","paragraph_zero_based":32408},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnly","paragraph_zero_based":32409},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a DRB or an SRB (servedRadioBearer). It is absent, Need M otherwise.","paragraph_zero_based":32410},{"literal_text_all_w_t_and_m_t":"LCH-SetupOnlyMRB","paragraph_zero_based":32411},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a multicast MRB and upon modification of MRB-Identity of the served MRB. It is absent, Need M otherwise.","paragraph_zero_based":32412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32413},{"literal_text_all_w_t_and_m_t":"–RLC-Config","paragraph_zero_based":32414},{"literal_text_all_w_t_and_m_t":"The IE RLC-Config is used to specify the RLC configuration of SRBs, multicast MRBs and DRBs.","paragraph_zero_based":32415},{"literal_text_all_w_t_and_m_t":"RLC-Config information element","paragraph_zero_based":32416},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32417},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-CONFIG-START","paragraph_zero_based":32418},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32419},{"literal_text_all_w_t_and_m_t":"RLC-Config ::=                      CHOICE {","paragraph_zero_based":32420},{"literal_text_all_w_t_and_m_t":"    am                                  SEQUENCE {","paragraph_zero_based":32421},{"literal_text_all_w_t_and_m_t":"        ul-AM-RLC                           UL-AM-RLC,","paragraph_zero_based":32422},{"literal_text_all_w_t_and_m_t":"        dl-AM-RLC                           DL-AM-RLC","paragraph_zero_based":32423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["511424254260ef47be756a