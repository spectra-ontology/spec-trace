{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":46176},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":46177},{"literal_text_all_w_t_and_m_t":"    sl-ParametersAboveThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL,    -- Need R","paragraph_zero_based":46178},{"literal_text_all_w_t_and_m_t":"    sl-ParametersBelowThres-v1650    SL-MinMaxMCS-List-r16                               OPTIONAL     -- Need R","paragraph_zero_based":46179},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":46180},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46181},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46182},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46183},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxParameters-r16 ::=    SEQUENCE {","paragraph_zero_based":46184},{"literal_text_all_w_t_and_m_t":"    sl-MinMCS-PSSCH-r16              INTEGER (0..27),","paragraph_zero_based":46185},{"literal_text_all_w_t_and_m_t":"    sl-MaxMCS-PSSCH-r16              INTEGER (0..31),","paragraph_zero_based":46186},{"literal_text_all_w_t_and_m_t":"    sl-MinSubChannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":46187},{"literal_text_all_w_t_and_m_t":"    sl-MaxSubchannelNumPSSCH-r16     INTEGER (1..27),","paragraph_zero_based":46188},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxTransNumPSSCH-r16        INTEGER (1..32),","paragraph_zero_based":46189},{"literal_text_all_w_t_and_m_t":"    sl-MaxTxPower-r16                SL-TxPower-r16                                      OPTIONAL    -- Cond CBR","paragraph_zero_based":46190},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46192},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-PSSCH-TXCONFIGLIST-STOP","paragraph_zero_based":46193},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46195},{"literal_text_all_w_t_and_m_t":"SL-PSSCH-TxConfigList field descriptions","paragraph_zero_based":46196},{"literal_text_all_w_t_and_m_t":"sl-MaxTxTransNumPSSCH","paragraph_zero_based":46197},{"literal_text_all_w_t_and_m_t":"Indicates the maximum transmission number (including new transmission and retransmission) for PSSCH.","paragraph_zero_based":46198},{"literal_text_all_w_t_and_m_t":"sl-MaxTxPower","paragraph_zero_based":46199}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["570f1d8af7c28442ff13ec7e2c65fecff6d8a5bff712ed6621a1300819a1cbc8","2d56619d6a69c208a93297242804980e003c8bbd0ea6f182f221343f5afc3e14","28c038cb1a90fbb5909a3fc0e0c60e3cf5cfdf44f23575bc56e913e5e58f187d","5a4e3a01126193b0252696a867be03bcd4e464ed860d2000a761fac34274397e","d582d7ed8febf080aaa7680fb10442ace266f407fa343629dbb23015bcdada05","cbb65717db3b9d24f64ce20c85c4db59994821d602d23bf8e609a1982f7852d8","945719403830fd845c9ae96043f9054ebba5f43ac84fb8a1585b7c46b698f846","dd2e4da320e293ed768ce33e888d419a545fa3f9eba975555098bb726f7f9cfe","9e7770b24c58cd94a16c8ec797a24651d896985702e4945b5dc85855337942bd","e4199e58aacd3c25946ec8e51046427a5d2c5f75084c5f9a5b820b5c372fdbda","3037c78304c0eb4e7f3036e7d6bf60e78c1979df1cc2b3ff8f4fb1d31cedaa8f","cc28e0a1f005eea0ff07a99fdfd4cb0becf94553e328ab0bf1bf059010cd595b","512617c3567284092b8084918d15fbbb1dc8f1074eaaf02f324b127f4f54a377","4d19472ea932142623cae12f59ec823ad4cc138518076977f3e0d7c124312004","34ab1e655bb848f3b613091571ce8ecc5accc4e290b6839e4ba563b1ee5f3186","01cbbb84f0995a41a57d9c5e92f4250305bdb4de46118ce0f286f138c8313f56","06699d36a9584e0a3bba7e614763e5016335cd556659022c617dde29841fec03","e6f36ec8ec24e4812a4836bdca2d255575a4f1ab9012d68877686461ad7201a2","ec62456199edce817f60988b4ba472f45da33aed2bf00f9edb5659acba8b38a6","397f183bab0017d45756e95ea6e16d74b729872fb25e0e9d75429f82020f3ca1","51161b6dcf1df6c5cc32a830c54304712982a496c94478df4e13fab988906153","b3f5ace46697d4c00daaebba3f4f1db38e6cb8341d67fbdbf1a0946647814a83","3f6bbf5c8c7a3e858315bbdf1829775918897a9455d8aeae0c7d424e8f1fd36b","1ccd055f88b06c343ede96442d794f6c597b2d00feb01316409f985a897bee68"],"paragraph_range_zero_based":[46176,46199],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p46176"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the maximum transmission power for transmission on PSSCH and PSCCH.","paragraph_zero_based":46200},{"literal_text_all_w_t_and_m_t":"sl-MinMCS-PSSCH, sl-MaxMCS-PSSCH","paragraph_zero_based":46201},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum MCS values used for transmissions on PSSCH. The UE shall ignore the minimum and maximum MCS values used for the associated MCS table(s) in sl-ParametersAboveThres-r16 and sl-ParametersBelowThres-r16 if sl-ParametersAboveThres-v1650 and sl-ParametersBelowThres-v1650 are present, respectively.","paragraph_zero_based":46202},{"literal_text_all_w_t_and_m_t":"sl-MinSubChannelNumPSSCH, sl-MaxSubChannelNumPSSCH","paragraph_zero_based":46203},{"literal_text_all_w_t_and_m_t":"This field indicates the minimum and maximum number of sub-channels which may be used for transmissions on PSSCH.","paragraph_zero_based":46204},{"literal_text_all_w_t_and_m_t":"sl-TypeTxSync","paragraph_zero_based":46205},{"literal_text_all_w_t_and_m_t":"This field indicates the synchronization reference type. For configurations by the eNB/gNB, only gnbEnb can be configured; and for pre-configuration or when this field is absent, the configuration is applicable for all synchronization reference types. ","paragraph_zero_based":46206},{"literal_text_all_w_t_and_m_t":"sl-ThresUE-Speed","paragraph_zero_based":46207},{"literal_text_all_w_t_and_m_t":"This field indicates a UE absolute speed threshold.","paragraph_zero_based":46208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46209},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46210},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46211},{"literal_text_all_w_t_and_m_t":"CBR","paragraph_zero_based":46212},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, when the IE SL-PSSCH-TxParameters is present in SL-CBR-CommonTxConfigList, SL-UE-SelectedConfig, SIB12 or SidelinkPreconfigNR; otherwise the field is not present, need R.","paragraph_zero_based":46213},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46214},{"literal_text_all_w_t_and_m_t":"–SL-QoS-FlowIdentity","paragraph_zero_based":46215},{"literal_text_all_w_t_and_m_t":"The IE SL-QoS-FlowIdentity is used to identify a sidelink QoS flow.","paragraph_zero_based":46216},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity information element","paragraph_zero_based":46217},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46218},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-START","paragraph_zero_based":46219},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46220},{"literal_text_all_w_t_and_m_t":"SL-QoS-FlowIdentity-r16 ::=                    INTEGER (1..maxNrofSL-QFIs-r16)","paragraph_zero_based":46221},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46222},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-QOS-FLOWIDENTITY-STOP","paragraph_zero_based":46223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fcc885c7d8f4880a6f2d1f28b18f4e0cf73c9fc2c5eda1ca5120296ed48f2bdd","62f6a48c0966d61b54dce01c6924cff4f23665a633a3cd99b88f32be76b18d13","bc821d93798743cf7da8646b25314ce0361ed0c54cddaff92bcab7574a4a86f2","394dcb464654dd5dcdf4831cbda552e55d99722cdd4676ae7c123edd2c957bc7","36d299f26a05ef79fde24e84ca8df5b9358610404d353b789c3a1657e5f0578f","6038e09e6da2bd8597d5d067d1a75b25cc78dc0dff962e9a979b9a811e2b5633","b0688a8eb0baf0e9fdc385d4abfbe634bf96e238ea7df3bb8ad30c872