{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44400},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonPS-r17            SL-BWP-PoolConfigCommon-r16                                   OPTIONAL,    -- Need R","paragraph_zero_based":44401},{"literal_text_all_w_t_and_m_t":"    sl-BWP-DiscPoolConfigCommon-r17          SL-BWP-DiscPoolConfigCommon-r17                               OPTIONAL     -- Need R","paragraph_zero_based":44402},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":44403},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":44404},{"literal_text_all_w_t_and_m_t":"    sl-LBT-FailureRecoveryConfig-r18     SetupRelease { SL-LBT-FailureRecoveryConfig-r18 }                 OPTIONAL,     -- Need R","paragraph_zero_based":44405},{"literal_text_all_w_t_and_m_t":"    sl-StartingSymbolFirst-r18           ENUMERATED {sym0, sym1, sym2, sym3, sym4, sym5, sym6}             OPTIONAL,     -- Need R","paragraph_zero_based":44406},{"literal_text_all_w_t_and_m_t":"    sl-StartingSymbolSecond-r18          ENUMERATED {sym3, sym4, sym5, sym6, sym7}                         OPTIONAL,     -- Need R","paragraph_zero_based":44407},{"literal_text_all_w_t_and_m_t":"    sl-TransmissionStructureForPSCCHandPSSCH-r18 ENUMERATED {contigousRB, interlaceRB}                     OPTIONAL,     -- Need R","paragraph_zero_based":44408},{"literal_text_all_w_t_and_m_t":"    sl-GapOfAdditionalSSSB-Occasion-r18  INTEGER (0..639)                                                  OPTIONAL,     -- Need R","paragraph_zero_based":44409},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-NonAnchorList-r18 SEQUENCE (SIZE (1.. maxSL-NonAnchorRBsets)) OF ARFCN-ValueNR OPTIONAL,     -- Need R","paragraph_zero_based":44410},{"literal_text_all_w_t_and_m_t":"    sl-NumOfSSS-Brepetition-r18          SEQUENCE (SIZE (1..5)) OF INTEGER (2..9)                          OPTIONAL,     -- Need R","paragraph_zero_based":44411},{"literal_text_all_w_t_and_m_t":"    sl-CPE-StartingPositionS-SSB-r18     INTEGER (1..9)                                                    OPTIONAL,     -- Need R","paragraph_zero_based":44412},{"literal_text_all_w_t_and_m_t":"    sl-CWS-ForPsschWithoutHarqAck-r18    ENUMERATED {t1, t8, t16, t32, infinity}                           OPTIONAL,     -- Need R","paragraph_zero_based":44413},{"literal_text_all_w_t_and_m_t":"    sl-NumOfAdditionalSSSBOccasion-r18   INTEGER (0..4)                                                    OPTIONAL,     -- Need R","paragraph_zero_based":44414},{"literal_text_all_w_t_and_m_t":"    sl-SSSBPowerOffsetOfAnchorRBSet-r18  ENUMERATED {value1, value2}                                       OPTIONAL,     -- Need R","paragraph_zero_based":44415},{"literal_text_all_w_t_and_m_t":"    sl-PSFCHPowerOffset-r18              INTEGER (0..10)                                                   OPTIONAL,     -- Need R","paragraph_zero_based":44416},{"literal_text_all_w_t_and_m_t":"    sl-RBSetConfigList-r18               SEQUENCE (SIZE (1..5)) OF SL-RBSetConfig-r18                      OPTIONAL,     -- Need R","paragraph_zero_based":44417},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfigCommonA2X-r18       SL-BWP-PoolConfigCommon-r16                                       OPTIONAL     -- Need R","paragraph_zero_based":44418},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":44419},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44420},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44421},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIGCOMMON-STOP","paragraph_zero_based":44422},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5270fd2c5fdbd25fa769fc52c355b294611fe3118e34eef3ef36e4ec962c5cce","ca15df001dcfb798f930e6656329283e1e5fc4a4758ab970b2236802ef1c8953","4e53b73614960e404ff565ca9a4ed41f4c4cce90bf6b94bdf88a0373ba7ece0f","80c2a3f185f86843f9605a733b4f8b6c57c6445b8ecc5d244c5c76bbc6dec82e","a7fe33734adac5e5f5d3b637add97457e51c9fdf6808c0d770bb5f64fdf2c5ed","1a5bb1086fabd6005c67248e49d363b79f4b3067e385ad994a48fd75ebf55d32","4e6dd59b9a244d09071ce101adf5882c2a581f5387718c34c0eb1150c9663c38","0c7a10901b07cf5f917327dce1ccc79ac2d319a661ff0049969761e9ed8b829d","ada879870a5656888282f2fa8e0175aa59f6479fca2c23a61e663aa27c122b25","f8e7f7cd141b8b3d5cde676aac01d405d94d2757b6c7b3bd040d574c623cc44e","a9aa1dbd4d433dec761bc49ad4bce85ab30718acd8dc76eba0168ec6ff2508a0","6ee509dc19caafd83125ba1581900b0ecd69c40d527c49fa5124020c696bef9c","cc3cb33544ea08899b93536303f6a88928f0582f2be5889f2e34b919ee3e5d20","e4b42423d593c5992dd64aef7bdc157c93714f02a971d80b0a886079f55f4aa4","c61857d6372c822cf8500724e47a0a3bcd5c8c0477ed932ede7082b6c09e5ff8","26699c71f60cb48d9c83f0db9cb2fe353affc37ca1d4e45065642e0f6d08baaf","a9adc1f8c42153d1349395fda26e7bb6def4b0d752db0995e4687f1722c90843","bbad9ba639733fa0a137140d192bb9d6c57d608fb0c6d9d2338f43e2aadb1fa0","e27b6c1f31a4df1eb61fc4678b5e86cb15eb23a9123fcb5405739166ccb99ef4","33a3dfa4a6449204eb8cb785ebad459172ed751579600dbd29a15923455d3edb","ef1401dea21fa24e9e829d5880959075c8095000d3b7d306b1816426b731748b","d0f6dc935c36d2091d765c1e436a37da3c7c046e90cb598474d5dbc8c33de81b","0d4ddc8f12ccd1a82777a54e88ddd52d495fbc5795e33c0eeaf9299807d8a537","30a3034b05d513cbbf44c41887cfe81b1362fc72619c78c04f25d6689b402058"],"paragraph_range_zero_based":[44400,44423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44400"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44424},{"literal_text_all_w_t_and_m_t":"SL-BWP-ConfigCommon field descriptions","paragraph_zero_based":44425},{"literal_text_all_w_t_and_m_t":"sl-AbsoluteFrequencySSB-NonAnchorList","paragraph_zero_based":44426},{"literal_text_all_w_t_and_m_t":"Indicates the lowest S-SSB in a non-anchor RB set via each parameter in this list. Anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates.","paragraph_zero_based":44427},{"literal_text_all_w_t_and_m_t":"sl-BWP-DiscPoolConfigCommon","paragraph_zero_based":44428},{"literal_text_all_w_t_and_m_t":"This field indicates the NR sidelink discovery dedicated resource pool configurations on the configured sidelink BWP. The total number of Rx/Tx resource pools configured for communication and discovery does not exceed the maximum number of Rx/Tx resource pool for NR sidelink communication (i.e. maxNrofRXPool-r16/maxNrofTXPool-r16).","paragraph_zero_based":44429},{"literal_text_all_w_t_and_m_t":"sl-BWP-Generic","paragraph_zero_based":44430},{"literal_text_all_w_t_and_m_t":"This field indicates the generic parameters on the configured sidelink BWP.","paragraph_zero_based":44431},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommon","paragraph_zero_based":44432},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations on the configured sidelink BWP.","paragraph_zero_based":44433},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonA2X","paragraph_zero_based":44434},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for A2X services on the configured sidelink BWP.","paragraph_zero_based":44435},{"literal_text_all_w_t_and_m_t":"sl-BWP-PoolConfigCommonPS","paragraph_zero_based":44436},{"literal_text_all_w_t_and_m_t":"This field indicates the resource pool configurations for power saving on the configured sidelink BWP. This field does not include sl-TxPoolExceptional.","paragraph_zero_based":44437},{"literal_text_all_w_t_and_m_t":"sl-CPE-StartingPositionS-SSB","paragraph_zero_based":44438},{"literal_text_all_w_t_and_m_t":"Indicates the CPE starting position within the GP symbol before S-SSB transmission. The value is an index of the set of all candidate CPE starting positions specified in Table 5.3.1-3 of [16, TS 38.211] for Ci=1 and the corresponding SCS of the SL BWP.","paragraph_zero_based":44439},{"literal_text_all_w_t_and_m_t":"sl-CWS-ForPsschWithoutHarqAck","paragraph_zero_based":44440},{"literal_text_all_w_t_and_m_t":"The latest CW_p is autonomously increased to the next higher allowed value for every priority class p of {1,2,3,4} if the same CW_p which is different from CW_(max,p) is consecutively used for general of N_init in SL Type 1 LBT for a number of times indicated by this parameter. This operation is restricted only to PSCCH/PSSCH transmission(s) with \"HARQ feedback enabled/disabled indicator\" in the 2nd stage SCI set to disabled, regardless of whether PSFCH resources being configured in a resource pool.","paragraph_zero_based":44441},{"literal_text_all_w_t_and_m_t":"sl-GapOfAdditionalSSSB-Occasion","paragraph_zero_based":44442},{"literal_text_all_w_t_and_m_t":"Indicate the gap between each R16/R17 NR SL S-SSB slot and its first corresponding additional candidate S-SSB occasion, and the gap between adjacent two additional candidate S-SSB occasions corresponding to a R16/R17 NR SL S-SSB slot.","paragraph_zero_based":44443},{"literal_text_all_w_t_and_m_t":"sl-LBT-FailureRecoveryConfig","paragraph_zero_based":44444},{"literal_text_all_w_t_and_m_t":"Configures parameters used for detection and cancellation of sidelink consistent LBT failures for operation with shared spectrum channel access, as specified in TS 38.321 [3].","paragraph_zero_based":44445},{"literal_text_all_w_t_and_m_t":"sl-NumOfAdditionalSSSBOccasion","paragraph_zero_based":44446},{"literal_text_all_w_t_and_m_t":"Indicate the number of additional candidate S-SSB occasion(s) for each R16/R17 NR SL S-SSB slot.","paragraph_zero_based":44447}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["4048f1faff6e2c2a8d32e1f12df4cc501c35e3cc9f5300c0bfc54f3ea5112d68","14b728915471f56b785d95a2ed5454341cc36023ae8dcb99c777d8360be43f9c","e1f4adcaa4ca4cd2b770e9fcc734d2d3f3c3cd6fef890557903f205313f5ece9","df836fff3d8a39edee67b2082940107059aba4acbfc1d28c7628a895b6980a61","5a79235305f1af534831c583be2a9ff5113039c1149a5909d2e86e35ee903d87","f64fd0611572d889392b056ed56e1e318f3fb97d4cb984473d3b1277a195aa6b","16a7d6726935939221e80a4c6e5e4a49cdd100ae3f7d68750b712f98a62d2d3e","8e978f9af4050277de27354e3b498a39f4471616271ce6ffd70c02d0c7ca9892","71fedcb52be5a0e464306130bbc19b7e7083d38ac746273c4ada5660f30f0b62","7dc9a69b4c69c15269ab26c9431764146f7df745582f6ab32cf7c2b6266d2914","861d60741b243f90271a7dd8b5e5867bf70b2d42fae2feaf85009d3300f4b46c","7bcc8b4e81f107d08f57515c0412ed833822e2d9f1ced78b79bbf08efe7cd1b7","e0f844ee962ab346d50538356e8e33e459a7138eda4071a27ec09e70d3b8a9e9","b9a704b92def73c994cc399c2e3c4d94f4adecd7cd60a3c4fae00cdb959b84b8","27ccf09e20687082d747e508d1fabc84a23b22225fbc12505fb30eed132369b1","828ccfc9fbf9c1c76a653bbf5c62bb4936678b23c0b6f6a8f8a246cc0940108b","185cb055cefe0a902f2b322ba24e4cac23a6c1ae0994a4e95d87e7cfa996fd06","9bb2ac332d3385ee0799e54e3bcd43a42a6f2f334ee79ed46ff2b5ed1f415ea3","c20df1e8d02732efa70a5bd0f93a93824023eb696dff32d5ec11fe16c80c2908","081ba562235ed819c53bf194f24e7261a37da45b41d49d9674a35f580f890db6","3528216ec3ac73a8b5b3b75eca8b2c8975ecb4b7b7ca33d7bab14bdf95152da3","1a5ecc12ff1458c647567512729fcc0c3da158b161c57d4b2899a161c233a1d9","5c4714e7c88ab31ebd942674cf5f6754353a40ce3b944f86664cbe21f7533c44","950436e92c7c12407795e036d5c953a0b8d553aa251e6cb19159f114bae960c1"],"paragraph_range_zero_based":[44424,44447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44424"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-NumOfSSS-Brepetition","paragraph_zero_based":44448},{"literal_text_all_w_t_and_m_t":"Indicate the number of S-SSB repetitions in frequency domain in one RB set, where first value corresponds to first RB set, second value corresponds to second RB set and so on. Legacy S-SSB are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":44449},{"literal_text_all_w_t_and_m_t":"sl-PSFCHPowerOffset","paragraph_zero_based":44450},{"literal_text_all_w_t_and_m_t":"Indicates the power offset between Tx power on one common PRB (P_common) and Tx power on one dedicated PRB (P_dedicated) when transmissionStructureForPSFCH is (pre-)configured as common interlace, i.e., P_common = P_dedicated - offset. UE expects the same (pre-)configured value of PSFCHPowerOffset across all resource pools. The unit is dB.","paragraph_zero_based":44451},{"literal_text_all_w_t_and_m_t":"sl-SSSBPowerOffsetOfAnchorRBSet","paragraph_zero_based":44452},{"literal_text_all_w_t_and_m_t":"Indicate the power offset for one S-SSB transmission on anchor RB set, where anchor RB set refers to the RB set where S-SSB indicated by sl-AbsoluteFrequencySSB-r16 locates. Value value1 corresponds to the power offset based on the number of S-SSB repetitions within the anchor RB set, and value2 corresponds to the power offset based on the maximum total number of S-SSB repetitions on RB sets within the SL-BWP.","paragraph_zero_based":44453},{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolFirst","paragraph_zero_based":44454},{"literal_text_all_w_t_and_m_t":"Indicates the location of first starting symbol within a slot. Value sym0 corresponds to first symbol, value sym1 corresponds to the second symbol and so on. If the field is not configured, the UE shall use value sym0.","paragraph_zero_based":44455},{"literal_text_all_w_t_and_m_t":"sl-StartingSymbolSecond","paragraph_zero_based":44456},{"literal_text_all_w_t_and_m_t":"Indicates the location of second starting symbol within a slot. Value sym3 corresponds to fourth symbol, value sym4 corresponds to the fifth symbol and so on.","paragraph_zero_based":44457},{"literal_text_all_w_t_and_m_t":"The number of symbols used for PSCCH/PSSCH transmission from second starting symbol is not smaller than 6. Within a slot, the second starting symbol is later than the first starting symbol. PSCCH/PSSCH transmission starting from first or second starting symbol shall have the same ending symbol within a slot.","paragraph_zero_based":44458},{"literal_text_all_w_t_and_m_t":"sl-TransmissionStructureForPSCCHandPSSCH","paragraph_zero_based":44459},{"literal_text_all_w_t_and_m_t":"Indicate a SL-BWP is (pre-)configured with contiguous RB-based or interlace RB-based PSCCH/PSSCH transmission. Legacy PSCCH/PSSCH are applicable in region with no OCB requirement, or with OCB exemption.","paragraph_zero_based":44460},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44461},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfig","paragraph_zero_based":44462},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfig is used to configure UE specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":44463},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig information element","paragraph_zero_based":44464},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44465},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-START","paragraph_zero_based":44466},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44467},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig-r17 ::=        SEQUENCE {","paragraph_zero_based":44468},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                    SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16        OPTIONAL,    -- Cond HO","paragraph_zero_based":44469},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17            SL-TxPoolDedicated-r16                                               OPTIONAL,    -- Need M","paragraph_zero_based":44470},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolScheduling-r17          SL-TxPoolDedicated-r16                                               OPTIONAL     -- Need N","paragraph_zero_based":44471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e8a22dfbb54b8b62678c7eb3c8d6d48ab24dc8c75aaf868ddc4b5bd3b355b559","c123861966e7485fdd9b94f1eacdd8e78d1f1b285519fe506c7ffb641d2f10d3","af796c405f8cb24d7845a3f814ec04fe9a266fbabcb5ed1e2a57899312c9ab62","1a15be85a67b62dab8ec10bf69996fb0f5e6d9d8fd188ef4bdf8a8d49e296849","73f691644f66f47d437ca7d0d07ab9c2ac3ecbbab7ea226cd511d57951c80dc1","4e4c1c38d01d6637ffede29ed62b1a1816ab58e4779e10de5279023bfb9012f0","0b75349a9dec5856094e1bf16f1e03c7458720df251beca761c4fd3780ad8486","87368d3b8344b5967c1c27535e94f7b88660e82e89a4cb91457d85febc8bf72e","bb3be5066ecd50916d0208aea01a558e6d090923850a9e815b50d16c7d7c49f1","adc84d87b98064fea659455408b87f6cefbdbfe39d340b63aac0b04c4fb46dee","e0745e63c17f942a54dbfbc851194a0926fe30eaff19e2163beb28182caf1f76","c5af810a8d644c6ea54891cd7243033a25dc887bc5a44d195424e6a7f27cc1e2","12e4feb18fe9bef47457d434443e5a61192012c2255119c833111ac272091e28","7566a0260c830a6cef017d27de28f663588259a24b09065f5271b3b4be261aed","c5da05e46fc5711a7eca3d6a1f71dabc4e9ea62dede9a2775699dd2d3f814444","0526a84bb552b7d4fe8ae7ff659df7a516a92dda8665605e53c5b1a92016635e","8c556fd62a74351946320066f4e2ce0c4ba8920c66de5730600d992d43dc501a","f854b545aaa058dc8077806622d736ff37f6b43fbe53684faca9eb8a1151282b","6605911341bd29e5bf206d7921e7c26f3434c1e6c1fedf449111f52e4facf17e","2f915293f593c8eba70ae3beeaeb48d10c6b455a349fd905e440120ca5083f4b","c7fa744a86ac01bab6e27ffd79c4ce9a09af9b532aff3d0104b6464314196f18","46abaa09f8f495e3f832a68c083b804072f174b994104a7912add94885817a82","aadc602994147747ae3814604f751a775d0de39053e3cab601cb14da6b7f0200","f0f49927ccc70eb62daf76ea5166226a7f86427a973ae27ac354502a875d444f"],"paragraph_range_zero_based":[44448,44471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44448"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44472},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44473},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIG-STOP","paragraph_zero_based":44474},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44475},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44476},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfig field descriptions","paragraph_zero_based":44477},{"literal_text_all_w_t_and_m_t":"sl-DiscTxPoolScheduling","paragraph_zero_based":44478},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to transmit NR sidelink discover based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":44479},{"literal_text_all_w_t_and_m_t":"When this field is configured together with sl-TxPoolScheduling, the resource pool index (which is used in DCI Format 3_0 in TS 38.212 [17], clause 7.3.1.4.1) is defined as 0, 1,  …,  x-1 for the resource pools included in the sl-TxPoolScheduling, and x, x+1, …, x+y-1 for the resource pools included in sl-DiscTxPoolScheduling, where x is the number of the resource pools in sl-TxPoolScheduling, and y is the number of resource pools in sl-DiscTxPoolScheduling.","paragraph_zero_based":44480},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44481},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":44482},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":44483},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":44484},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, need M.","paragraph_zero_based":44485},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44486},{"literal_text_all_w_t_and_m_t":"–SL-BWP-DiscPoolConfigCommon","paragraph_zero_based":44487},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-DiscPoolConfigCommon is used to configure the cell-specific NR sidelink discovery dedicated resource pool.","paragraph_zero_based":44488},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon information element","paragraph_zero_based":44489},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44490},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-DISCPOOLCONFIGCOMMON-START","paragraph_zero_based":44491},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44492},{"literal_text_all_w_t_and_m_t":"SL-BWP-DiscPoolConfigCommon-r17 ::= SEQUENCE {","paragraph_zero_based":44493},{"literal_text_all_w_t_and_m_t":"    sl-DiscRxPool-r17                   SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16         OPTIONAL,    -- Need R","paragraph_zero_based":44494},{"literal_text_all_w_t_and_m_t":"    sl-DiscTxPoolSelected-r17           SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16   OPTIONAL,    -- Need R","paragraph_zero_based":44495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ca0c54744fc919f7143a0087b876e9539a700537e471901d718a4ab3134616ea","14c41ae62b343b074c24bb21f61805381af38f6a6c217d1a75a316d2e411774d","c45d7b6f0f26cf9b46a2ac3d633e900b534d0ea26ff711d606e03f1141cd9c1a","6a3072384c2f714c2b39b9070207f28b9fca78602fc687a1881204638d9298c0","adeaf9277756194b696c33ef7cc2ab3a8d81d70ec01f2565a0df7fde6a0559a9","bba500061597f8143259fd4396119ab2f57636e245b79e50870d608e00263372",