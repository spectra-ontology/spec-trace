{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The AreaConfiguration indicates area for which UE is requested to perform measurement logging. If not configured, measurement logging is not restricted to specific cells or tracking areas but applies as long as the RPLMN is contained in plmn-IdentityList stored in VarLogMeasReport.","paragraph_zero_based":44712},{"literal_text_all_w_t_and_m_t":"AreaConfiguration information element","paragraph_zero_based":44713},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44714},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-START","paragraph_zero_based":44715},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44716},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r16 ::=        SEQUENCE {","paragraph_zero_based":44717},{"literal_text_all_w_t_and_m_t":"    areaConfig-r16                   AreaConfig-r16,","paragraph_zero_based":44718},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r16          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":44719},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44720},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44721},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-r17 ::=      SEQUENCE {","paragraph_zero_based":44722},{"literal_text_all_w_t_and_m_t":"    areaConfig-r17                   AreaConfig-r16                                                      OPTIONAL, -- Need R","paragraph_zero_based":44723},{"literal_text_all_w_t_and_m_t":"    interFreqTargetList-r17          SEQUENCE(SIZE (1..maxFreq)) OF InterFreqTargetInfo-r16              OPTIONAL  -- Need R","paragraph_zero_based":44724},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44725},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44726},{"literal_text_all_w_t_and_m_t":"AreaConfiguration-v1800 ::=      SEQUENCE {","paragraph_zero_based":44727},{"literal_text_all_w_t_and_m_t":"    cag-ConfigList-r18               CAG-ConfigList-r18                                                  OPTIONAL, -- Need R","paragraph_zero_based":44728},{"literal_text_all_w_t_and_m_t":"    snpn-ConfigList-r18              SNPN-ConfigList-r18                                                 OPTIONAL  -- Need R","paragraph_zero_based":44729},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44730},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44731},{"literal_text_all_w_t_and_m_t":"AreaConfig-r16 ::=     CHOICE {","paragraph_zero_based":44732},{"literal_text_all_w_t_and_m_t":"    cellGlobalIdList-r16             CellGlobalIdList-r16,","paragraph_zero_based":44733},{"literal_text_all_w_t_and_m_t":"    trackingAreaCodeList-r16         TrackingAreaCodeList-r16,","paragraph_zero_based":44734},{"literal_text_all_w_t_and_m_t":"    trackingAreaIdentityList-r16     TrackingAreaIdentityList-r16","paragraph_zero_based":44735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3e96ddd1715a77d774e75bdb5b5a181b88f4ebf95cd2388733f68b1d5dd09749","d4a756d88ca0fcd8dd763729da49e686978d486153abc3d62a1d4f20101a4584","6b6e2dd213841a5e11046eb7d9eba4b6f21038095a3a067ea1d2c5fcd67ecb48","53617fddf7da95f317fd414bc98a8102f875fdc6d0a3837e22cf36f679031146","908df36852d571b8a96ad4f9e9a1a385b8e0f6ec8b58aea7a1c2d91966917e36","2f7eb850c8b69d33e8c4535d93a3acebebd5313bc7b2ca90f6a1bfc01f5b82c0","f9a1a33337ebdde89cc0b173cf513979c9f2f70968454cad5225dbc66d03834b","05645e891446a4d4671a576aa5769ef3eb48de21cad44b1f529c0cd2907f1ea