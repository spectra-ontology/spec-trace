{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SCGFailureInformation field descriptions","paragraph_zero_based":13896},{"literal_text_all_w_t_and_m_t":"measResultFreqList","paragraph_zero_based":13897},{"literal_text_all_w_t_and_m_t":"The field contains available results of measurements on NR frequencies the UE is configured to measure by measConfig.","paragraph_zero_based":13898},{"literal_text_all_w_t_and_m_t":"measResultSCG-Failure","paragraph_zero_based":13899},{"literal_text_all_w_t_and_m_t":"The field contains the MeasResultSCG-Failure IE which includes available results of measurements on NR frequencies the UE is configured to measure by the NR SCG RRCReconfiguration message. ","paragraph_zero_based":13900},{"literal_text_all_w_t_and_m_t":"previousPSCellId","paragraph_zero_based":13901},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell that is the source PSCell of the last PSCell change. In case of PSCell addition failure, this field is absent.","paragraph_zero_based":13902},{"literal_text_all_w_t_and_m_t":"failedPSCellId","paragraph_zero_based":13903},{"literal_text_all_w_t_and_m_t":"This field indicates the physical cell id and carrier frequency of the cell in which SCG failure is detected or the target PSCell of the failed PSCell change or failed PSCell addition.","paragraph_zero_based":13904},{"literal_text_all_w_t_and_m_t":"timeSCGFailure","paragraph_zero_based":13905},{"literal_text_all_w_t_and_m_t":"This field is used to indicate the time elapsed since the last execution of RRCReconfiguration with reconfigurationWithSync for the SCG until the SCG failure. Actual value = field value * 100ms. The maximum value 1023 means 102.3s or longer.","paragraph_zero_based":13906},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13907},{"literal_text_all_w_t_and_m_t":"–SCGFailureInformationEUTRA","paragraph_zero_based":13908},{"literal_text_all_w_t_and_m_t":"The SCGFailureInformationEUTRA message is used to provide information regarding E-UTRA SCG failures detected by the UE.","paragraph_zero_based":13909},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":13910},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":13911},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":13912},{"literal_text_all_w_t_and_m_t":"Direction: UE to Network","paragraph_zero_based":13913},{"literal_text_all_w_t_and_m_t":"SCGFailureInformationEUTRA message","paragraph_zero_based":13914},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13915},{"literal_text_all_w_t_and_m_t":"-- TAG-SCGFAILUREINFORMATIONEUTRA-START","paragraph_zero_based":13916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13917},{"literal_text_all_w_t_and_m_t":"SCGFailureInformationEUTRA ::=                SEQUENCE {","paragraph_zero_based":13918},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                                CHOICE {","paragraph_zero_based":13919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["175d1c18c46dc4c0aefcef23b987d7321193d167befd4a0f6b857d4cb68ed1e9","042b2b595da2f32bc54ab1ebcf7d61c8c62052e52c782f0a3dbfd51f3d9ac124","5fb80db38447fe174d452d11c7f53bc4d3188602b20998042fec78fe2de10e82","e1316303a7541555a93cb10bdb78048aee28f8c47fc7a4238d483fe2ed4cbd1d","718924adfd95075f9f68c9db5dbd02daee0156aaa0873a47978cec12041b04b4","830ff12f40211dffae84d39ca3d71375672c34961765f17e119ce01c6a9ebb7e","251d653868c2d293ea57636dbe2ab2a1242