{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sfn-r17                        INTEGER(0..1023),","paragraph_zero_based":22944},{"literal_text_all_w_t_and_m_t":"    subFrameNR-r17                 INTEGER(0..9)","paragraph_zero_based":22945},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22947},{"literal_text_all_w_t_and_m_t":"-- TAG-EPOCHTIME-STOP","paragraph_zero_based":22948},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22950},{"literal_text_all_w_t_and_m_t":"EpochTime field descriptions","paragraph_zero_based":22951},{"literal_text_all_w_t_and_m_t":"sfn","paragraph_zero_based":22952},{"literal_text_all_w_t_and_m_t":"For serving cell, it indicates the current SFN or the next upcoming SFN after the frame where the message indicating the epochTime is received. For neighbour cell, it indicates the SFN nearest to the frame where the message indicating the epochTime is received.","paragraph_zero_based":22953},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22954},{"literal_text_all_w_t_and_m_t":"–EUTRA-C-RNTI","paragraph_zero_based":22955},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-C-RNTI identifies a UE having a RRC connection within an E-UTRA cell.","paragraph_zero_based":22956},{"literal_text_all_w_t_and_m_t":"EUTRA-C-RNTI information element","paragraph_zero_based":22957},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22958},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRACRNTI-START","paragraph_zero_based":22959},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22960},{"literal_text_all_w_t_and_m_t":"EUTRA-C-RNTI ::=                      BIT STRING (SIZE (16))","paragraph_zero_based":22961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22962},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRACRNTI-STOP","paragraph_zero_based":22963},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22964},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22965},{"literal_text_all_w_t_and_m_t":"–FeatureCombination","paragraph_zero_based":22966},{"literal_text_all_w_t_and_m_t":"The IE FeatureCombination indicates a feature or a combination of features to be associated with a set of Random Access resources (i.e. an instance of FeatureCombinationPreambles).","paragraph_zero_based":22967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["aa26b88287bc75f94e67b96802bbc54737f142cfb53183b5ec456cc02fafc995","8840d9f1554b1f928b11344bd51f4c1fdeac21a214fb19cc0b3dc09e1242d57c","6df305906a331396e9e60bb73e3530353cf0f9b925c7d8292d7350b497e47fa9","374c567990693699c1b7082526279bb9d7b3a5ebcd6d0dbb9eb2851b3af2159c","2c2990c19b26ccdf2ff6925f12d886a427ef778a91911132cdad148b3f0e9376","880d4cdfd020ee745851df762299307297be680245c4ccaadbd14e9e4186058e","7c70c6249d4f40d4f6e68fd7cd607be0d54eb178c557230715e901c8e000729f","bcebddff5251ceedb93b514d787c5ed7339e55420c5e164f33b0c6fc0bb9f6aa","cfb8e7116397590a88add83ae5941a5f24621cadf4b20a0056bd431b8f89fad8","fd0f5d54b65fa720c274dc2eb03c28b36e0926d84731dabb19dcc6caa8e01d28","a63af6ac480bdac4e8793114fae8a2384fe22c6affee59d56e1465df9f231e25","900de62c36f5db0e4da6b681a56a5608356beb7a5102755ac8451126dadf3842","0c03fc9a8a28be674b5667e40ce4489dba87cdad6ce2e60d70f1e93399668252","c1dc86872a4bc0ee02196a90c518b78001f6bb144ca880821479f5a5f9ce898c","2ca0f7a57f03b29eb862649c10a8412c001bb7b99915b39223bb504190b536f0","67a8264d3f9cd30c33c9c1ee63891046b83f08d94a6c2eaf8c50c82202adbe90","8b60159bf114a09c5010275f2a58071363665bb90928be4507a17ea06bf644ef","ae10ebeb009e9a0b4aab3f2b22a859560b1b05405d5a0ffe070753ee7322f4df","0bd1b00bf44b6afa4269391c1cbe89d08e7d0dc860ed8a22e730d1cb73929fbf","e2ae1594f162cb5fd1ed7f7b25780c81fc85aa39769865927ceff3b9c0330247","dbf4f11f2b0bd047006d9f8860b1092632451f558412190da5d31cccd5747886","ee10ebe729b2a2023974ac1cd8ec7561dac742d163fe44436c903764387b63ba","b2202b9133e0f257c29beee9dfff8f7bd1acd7f5cde98a89de64bda6d48ae896","59d141f7f5030860831074e5d703306c61f3a77e2a6b759027628447a0f7115b"],"paragraph_range_zero_based":[22944,22967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22944"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"FeatureCombination information element","paragraph_zero_based":22968},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":22969},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-START","paragraph_zero_based":22970},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22971},{"literal_text_all_w_t_and_m_t":"FeatureCombination-r17 ::= SEQUENCE {","paragraph_zero_based":22972},{"literal_text_all_w_t_and_m_t":"    redCap-r17                 ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22973},{"literal_text_all_w_t_and_m_t":"    smallData-r17              ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22974},{"literal_text_all_w_t_and_m_t":"    nsag-r17                   NSAG-List-r17                                        OPTIONAL,  -- Need R","paragraph_zero_based":22975},{"literal_text_all_w_t_and_m_t":"    msg3-Repetitions-r17       ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22976},{"literal_text_all_w_t_and_m_t":"    msg1-Repetitions-r18       ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22977},{"literal_text_all_w_t_and_m_t":"    eRedCap-r18                ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22978},{"literal_text_all_w_t_and_m_t":"    spare2                     ENUMERATED {true}                                    OPTIONAL,  -- Need R","paragraph_zero_based":22979},{"literal_text_all_w_t_and_m_t":"    spare1                     ENUMERATED {true}                                    OPTIONAL   -- Need R","paragraph_zero_based":22980},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22981},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22982},{"literal_text_all_w_t_and_m_t":"NSAG-List-r17 ::= SEQUENCE (SIZE (1.. maxSliceInfo-r17)) OF NSAG-ID-r17","paragraph_zero_based":22983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22984},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURECOMBINATION-STOP","paragraph_zero_based":22985},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22987},{"literal_text_all_w_t_and_m_t":"FeatureCombination field descriptions","paragraph_zero_based":22988},{"literal_text_all_w_t_and_m_t":"eRedCap","paragraph_zero_based":22989},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that eRedCap is part of this feature combination. The fields redCap and eRedCap shall not be both set to true. If the UE is an eRedCap UE and there is no set of configured RA resources with eRedCap set to true among all sets of configured RA resources, the UE considers redCap to be applicable for random access procedure. This field is not configured in a set of preambles that is configured with 2-step random-access type.","paragraph_zero_based":22990},{"literal_text_all_w_t_and_m_t":"msg1-Repetitions","paragraph_zero_based":22991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["db139b3787acf4afe78809c4a8bcde3e0f0848c7c0daa39b05933774209cd6c8","f8cfa5f5cb3feb2d36869df157bd88bca77c454dc1466b8d1657fa6fbac34949","060f87b2f61543227510bff03ac0fa3b768115e92425304ced585499ca57c9d1","6b27a443582dd0e04f9bc6cc62f57b10f696b890c4528bfb1a03433627760d39","b6af0f82bd50b4886fe0fc58bffc8e320f8d4a68e06d0377b3a59d287e2a74e