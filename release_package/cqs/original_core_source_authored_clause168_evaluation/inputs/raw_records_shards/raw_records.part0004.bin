{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present when bandwidth aggregation is performed in RRC_CONNECTED state and SRS for positioning is configured in the same carrier as data for bandwidth aggregation, otherwise it is absent Need R.","paragraph_zero_based":35448},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35449},{"literal_text_all_w_t_and_m_t":"–SRS-RSRP-Range","paragraph_zero_based":35450},{"literal_text_all_w_t_and_m_t":"The IE SRS-RSRP-Range specifies the value range used in SRS-RSRP measurements and thresholds. The integer value for SRS-RSRP measurements is according to Table 10.1.22.1.2-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value –140) dBm, except for the IE value 98, in which case the actual value is infinity.","paragraph_zero_based":35451},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range information element","paragraph_zero_based":35452},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35453},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-START","paragraph_zero_based":35454},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35455},{"literal_text_all_w_t_and_m_t":"SRS-RSRP-Range-r16 ::=                      INTEGER(0..98)","paragraph_zero_based":35456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35457},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-RSRP-RANGE-STOP","paragraph_zero_based":35458},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35460},{"literal_text_all_w_t_and_m_t":"–SRS-TPC-CommandConfig","paragraph_zero_based":35461},{"literal_text_all_w_t_and_m_t":"The IE SRS-TPC-CommandConfig is used to configure the UE for extracting TPC commands for SRS from a group-TPC messages on DCI.","paragraph_zero_based":35462},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig information element","paragraph_zero_based":35463},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35464},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-TPC-COMMANDCONFIG-START","paragraph_zero_based":35465},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35466},{"literal_text_all_w_t_and_m_t":"SRS-TPC-CommandConfig ::=               SEQUENCE {","paragraph_zero_based":35467},{"literal_text_all_w_t_and_m_t":"    startingBitOfFormat2-3                  INTEGER (1..31)                                                     OPTIONAL,   -- Need R","paragraph_zero_based":35468},{"literal_text_all_w_t_and_m_t":"    fieldTypeFormat2-3                      INTEGER (0..1)                                                      OPTIONAL,   -- Need R","paragraph_zero_based":35469},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35470},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1e51a653f45076ced70170a00cbcec237f5bf5dbb0b3166cdafd94fd72429728","bc1ed827c2ef4b99fc89029372917d9f4ff017b7eb5b05ad8007fb4c574deb16","a92e7c989d058680331fede964cc1d3b8c7c9e5ec902061b5e05bcc7ec4045b2","b4e1eade10f87bcfc7cfa91ae7a777820d8db1956f758654cad6e2761bdf8c77","d5d7c15daee613f1545cb24a4858b27c3da2b1763f0e95675ce82ca8ee8c7c2f","a91d8d47ceb9077cb7cee00bfb26c443bc82e646a2a056e4a21448c2b37f5ae7","24435e0d5c568a7e39846d8deecf909882672ef97bd6897aa6a04b9c3eb7bdf9","aa541fcadca97a1ed9bd364eda311daa99088e8cb8e1d5273375578cc86dc1c4","b250546e302874b3620333474daa9a2ff8d057cddd66dde5154b7d2238e9a94d","b7b6ce9104009afcbc442f