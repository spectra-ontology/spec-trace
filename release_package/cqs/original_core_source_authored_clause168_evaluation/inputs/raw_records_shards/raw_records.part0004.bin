{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>release sl-AssistanceConfigNR, if configured;","paragraph_zero_based":3864},{"literal_text_all_w_t_and_m_t":"3>release obtainCommonLocation, if configured;","paragraph_zero_based":3865},{"literal_text_all_w_t_and_m_t":"3>release scg-DeactivationPreferenceConfig, if configured, and stop timer T346i, if running;","paragraph_zero_based":3866},{"literal_text_all_w_t_and_m_t":"3>release musim-GapAssistanceConfig, if configured and stop timer T346h, if running;","paragraph_zero_based":3867},{"literal_text_all_w_t_and_m_t":"3>release musim-GapPriorityAssistanceConfig, if configured;","paragraph_zero_based":3868},{"literal_text_all_w_t_and_m_t":"3>release musim-LeaveAssistanceConfig, if configured;","paragraph_zero_based":3869},{"literal_text_all_w_t_and_m_t":"3>release musim-CapabilityRestrictionConfig, if configured and stop timer T346n, if running;","paragraph_zero_based":3870},{"literal_text_all_w_t_and_m_t":"3>release propDelayDiffReportConfig, if configured;","paragraph_zero_based":3871},{"literal_text_all_w_t_and_m_t":"3>release ul-GapFR2-PreferenceConfig, if configured;","paragraph_zero_based":3872},{"literal_text_all_w_t_and_m_t":"3>release rrm-MeasRelaxationReportingConfig, if configured;","paragraph_zero_based":3873},{"literal_text_all_w_t_and_m_t":"3>release maxBW-PreferenceConfigFR2-2, if configured;","paragraph_zero_based":3874},{"literal_text_all_w_t_and_m_t":"3>release maxMIMO-LayerPreferenceConfigFR2-2, if configured;","paragraph_zero_based":3875},{"literal_text_all_w_t_and_m_t":"3>release minSchedulingOffsetPreferenceConfigExt, if configured;","paragraph_zero_based":3876},{"literal_text_all_w_t_and_m_t":"3>release aerial-FlightPathAvailabilityConfig, if configured;","paragraph_zero_based":3877},{"literal_text_all_w_t_and_m_t":"3>release ul-TrafficInfoReportingConfig, if configured, and stop all instances of timer T346l, if running;","paragraph_zero_based":3878},{"literal_text_all_w_t_and_m_t":"3>suspend all RBs, and BH RLC channels for the IAB-MT, except SRB0 and broadcast MRBs;","paragraph_zero_based":3879},{"literal_text_all_w_t_and_m_t":"2>remove all the entries within the MCG VarConditionalReconfig, if any;","paragraph_zero_based":3880},{"literal_text_all_w_t_and_m_t":"2>perform the LTM configuration release procedure for the MCG and the SCG as specified in clause 5.3.5.18.7;","paragraph_zero_based":3881},{"literal_text_all_w_t_and_m_t":"2>for each measId, if the associated reportConfig has a reportType set to condTriggerConfig:","paragraph_zero_based":3882},{"literal_text_all_w_t_and_m_t":"3>for the associated reportConfigId:","paragraph_zero_based":3883},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching reportConfigId from the reportConfigList within the VarMeasConfig;","paragraph_zero_based":3884},{"literal_text_all_w_t_and_m_t":"3>if the associated measObjectId is only associated to a reportConfig with reportType set to condTriggerConfig:","paragraph_zero_based":3885},{"literal_text_all_w_t_and_m_t":"4>remove the entry with the matching measObjectId from the measObjectList within the VarMeasConfig;","paragraph_zero_based":3886},{"literal_text_all_w_t_and_m_t":"3>remove the entry with the matching measId from the measIdList within the VarMeasConfig;","paragraph_zero_based":3887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4bceb83f70f686a4c09b7bae93f0b84fddc71c6ea73ccea0e60bb0b908834f55","31c9a5f80af99941cf2fd276ab3eedc812e7665afa0aec5c19592ba80cf4227d","5aa07d4322ba78065d4eaeaec24