ates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["03a8d6a8669aac3b255cc4205ab15ee12bc57f807be6e38dc43a5c60707f44c3","2d20ab0cbe9b7ff976ec1e32d2c6ba5fa7d133e8cf2493dae0e8e7d2a67783eb","658711394b24eeaf991f01d60209645b20761ad351df9319a950415f6bd8eb9b","02fb20ae44a23d84c9c1958118c24f14d23a48a81e6db24bbd8f83ef7ff0edc3","453f5b6353cb89beac4d4b98378a25e660dbf21029de6193b13c96fc30e60e7b","c8030c475a90addbbf6ef2aeec9e621199f950e3e5ac1370acab3267769d747e","2087efed2cdd04273dcb76fec327faf620450d5f305319aa3e46abd1863aab7c","76bfda423c829431a8b53f4ca0466e63a6d25ceef0434297fddca59e73a6fc32","c11b04edf8d1b154d534d848d6f000f5162c20714989fcd52f2deba53d247944","fa154daf4704c6281a175e2b276349e45901275c878f3c187a38581c3bbe27a3","dde4f56f8a19f1865f4526db4e6044f64e862b54df58e4e8752d906547f1a18e","7baf164b3f94d50099f942f0f7a959a23985f3e212afd82893bce0fa782b62c5","ca927dae057ff340d554b9660069acd362221cbd83e46b1e393823b209f5829c","3466ec547274f7bf2c06a1d4441827b00c1189d92ad7c1f2b07698491f4ae0fe","d5e05249af4b0f1af64e4d25ebab9e75b2c37dd46d954088a9e0358dfb81d3a4","0a5fa11f4c16c869e834d01e55cdc533e7ddb862c01587517347f9f0714d480c","1babb30260034916644a9ec92b546ed919c2b5994907da14dc741204d5498888","03171f0ac3b53a8e887ccc56692f133790b4b87a10c4e350ad8b8fc507e55af3","bd6a1e10848a1f54685a9cf3e790690a75b4b918693c60c8d64e8014daa3010f","1de83d13d02b81c7341949bbd57b6d904e02c3df402e7fd5f279e2ab5203c5c5","13060e4c5b32506f7213f22aa2e3d1baef65aaf1049b5b1c0d6f6751c13565ae","c91041c4bc21d1fe8b00103572ac4d4d2dfe2227473fd36c45044925430a865d","97aed4980eccd40879d423b8ccf8911d5e7bf375a99907ebb66ad5fd448bc0cf","120da14374c8b2fb22014768e07c69bc53d4555af0ff08efc8a0e3be26c192ab"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p96"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"4.5Cell Categories","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"The cells are categorised according to which services they offer:","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"acceptable cell:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"An \"acceptable cell\" is a cell on which the UE may camp to obtain limited service (originate emergency calls and receive ETWS and CMAS notifications). Such a cell shall fulfil the following requirements, which is the minimum set of requirements to initiate an emergency call and to receive ETWS and CMAS notification in an NR network:","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"-The cell is not barred, see clause 5.3.1 for details and exceptions;","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"-The cell selection criteria are fulfilled, see clause 5.2.3.2.","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"suitable cell:","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"For UE not operating in SNPN Access Mode, a cell is considered as suitable if the following conditions are fulfilled:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"-The cell is part of either the selected PLMN or the registered PLMN or PLMN of the Equivalent PLMN list, and for that PLMN either:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"-The PLMN-ID of that PLMN is broadcast by the cell with no associated CAG-IDs and CAG-only indication in the UE for that PLMN (TS 23.501 [10]) is absent or false;","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"-Allowed CAG list in the UE for that PLMN (TS 23.501 [10]) includes a CAG-ID broadcast by the cell for that PLMN;","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"-The cell selection criteria are fulfilled, see clause 5.2.3.2.","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"<<next change>>","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"5.3Cell Reservations and Access Restrictions","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["ea28f9e2bca270710b8baabed2cf0c22d954d5dc0f5d17bc572eb2692d8f7182","dcc45daa76fed09c7fc9591d5cc3a660914a88b54f19b4c8da34c4b5eadee3e9","900cea413e939bd00f52a59d1820b50c9250fc0b4a1f8483ae428efbaaaac57b","2d00809453c086bae9a200eed545e8094145e1fb71845d0d2d74c9bd63ee43dc","e48c7f6f173a3c8f65c423671e6dd5eab3b5fc8ad43638f9cbdc59648f92519f","cb3879bd0168f1cef3db52ddb6fd2e252bdf5df6921b92d8f74faa41b2fb66f2","a97ef27680555fcbc6ff449a3568a9f1941903d5ea21452b815c432b194ac61f","aeff371ed44ec856d7d57ceb46e10bf7757b37a2e7deb80d9948514628f1d071","b99cbb1d4e85b865a56298674455aa01f79ded567bb1f0428f6c2083973392b2","1a66285c7a3ca6eb6e0ed92892c253e2e7bf2cfc609d065b3cee7828fe4449cf","a70d7f4eea8eb3ad08ba85b34c4c47e42e8f96e19ee18691aa092129406c91d6","0c4a97e59008ee584630ceb4d50e82956830150cf48909233c3859948115ea4c","5cb0e61e4463fa339d5528eba46f62c72370f26e01b9233eaf37253d78353028","a986983a368d7eeeb94586ffa89c20006c75664ad5702580bf46577456dc2a8c","5137c515acbf4add133df4c9eb965b0051e32402f6f0553822f2ba667fe5eac1","263c09ac637619c191c7f8cdc756b2c2ac468900c9b7cd606fe9c536fe3c713f","99f55f2c540179b6639102afbad75d24040fd5ad84007b032a140f3fe9d17373","8e3aede181e914d4e8da5608160cfed67eee839eb7374373dbeab7f46ab3763a","3309d02a5e53711d60b16c304cf31afac1e962a2a1de08f076e59b3cf9d70767","27b471a671960048116ce5f1c61bc49849892c63acf5c49082a589c13c05930e","8118e76d1677592a8eb835ee29eeefb6f564a97410e415768dda72da33de6075","ff42882a550530662d66614540ff3bab963d394fb91ecd94165277d5034701bc","88f2ae1252c837148e9f77e9179fe53d3237a8047a6e7b97f3e1d4ec01255144","8dba4ab6265abb2f93d2a37df817d6903c989f8d1c4cf41d4dc9c3dadb61c9f8"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p120"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3.0Introduction","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"There are two mechanisms which allow an operator to impose cell reservations or access restrictions. The first mechanism uses indication of cell status and special reservations for control of cell selection and reselection procedures. The second mechanism, referred to as Unified Access Control as specified in TS 38.331 [3], shall allow preventing selected access categories or access identities from sending initial access messages for load control reasons.","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"Unified Access Control does not apply to IAB-MTs and NCR-MTs.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"5.3.1Cell status and cell reservations","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"Cell status and cell reservations are indicated in the MIB or SIB1 message as specified in TS 38.331 [3] by means of following fields:","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"-cellBarred (IE type: \"barred\" or \"not barred\") Indicated in MIB message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is ignored by UEs supporting NTN while cellBarredNTN is included in SIB1.","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"-cellBarredNES (IE type: \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to UEs capable of NES cell DTX/DRX.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"-cellBarred-eRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to eRedCap UEs.","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"-cellBarred-eRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to eRedCap UEs.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"-cellBarredNTN (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is ignored if the UE does not support NTN connectivity.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"-cellBarredATG (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to ATG UEs.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"-cellBarredFixedVSAT (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is only applicable to VSAT UEs using NTN access.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"-cellBarredMobileVSAT (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is only applicable to VSAT UEs using NTN access.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"-cellBarredNES (IE type: \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to UEs indicating any of the values in nes-CellDTX-DRX as specified in TS 38.306 [24].","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"-cellBarredNTN (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is ignored if the UE does not support NTN access.","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"-cellReservedForOperatorUse (IE type: \"reserved\" or \"not reserved\") Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"-cellReservedForOtherUse (IE type: \"true\") Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"-cellReservedForFutureUse (IE type: \"true\") Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"NOTE 0:IAB-MT ignores the cellBarred, cellReservedForOperatorUse, cellReservedForFutureUse, and intraFreqReselection (i.e. treats intraFreqReselection as if it was set to allowed) as defined in TS 38.331 [3]. IAB-MT also ignores cellReservedForOtherUse for cell barring determination (i.e. NPN capable IAB-MT considers cellReservedForOtherUse for determination of an NPN-only cell) as defined in TS 38.331 [3].","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"NOTE 0a: NCR-MT ignores the cellBarred, cellReservedForOperatorUse, cellReservedForFutureUse, and intraFreqReselection (i.e. treats intraFreqReselection as if it was set to allowed) as defined in TS 38.331 [3]. NCR-MT also ignores cellReservedForOtherUse for cell barring determination (i.e. NPN capable NCR-MT considers cellReservedForOtherUse for determination of an NPN-only cell) as defined in TS 38.331 [3].","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["984842aac0077f413e04b517b30ec15fce13219972c98a4ab3e4eaa7c462fbac","e3865ac6cf0cb7d919dc4194818040ed1b59a31dfad2a1402daacf078c84e4b0","99c6641d567d6ec44f00c49bcb95f9c3e961b6a430ac5363dfa0253c5411042e","4df4ae1dac5d8e9724cde886a47623b9c6e097e1e19004d3583a396a85f85f26","6911196d8180e6fc5ee3819252d624831bcbc304da1ffae1fd8a8c5170733fb0","80af343b6df3941099a25fc8bf9e5a4231b184afb78adc923b99323b976b5dfa","5ec4fccc007a564437588c62f2d69d3bcadd162f3d1f92eb5ee0ea4f4185d474","9b2fd28975d19d8ee3fcbd8be4bfc635c0915e133c941d2224b8aa4d1902b476","f2190c60e75a13128a28208029371da18a5cece1f1d85200e31aa5333763bd05","b372779437e7017ee72bb233d14cae7322823b37a047a8c8d3e9a72ef8292e53","e39b4a8132b07dab93fd4f5f7d339aa89ffb9f30cd3b887ac393e6b6e496f368","56907eeca26b60b86343ac47b540659806b8ef1ca9e19f325241914d838a4744","bfff4d3bf3948c0bfa2075c0cd4a21407d2e1b49b2ffb6d18bef9be19efa0651","c16af62112deaab3e5af780ddefc34c0af5b449d618506552ee5b8cb47960e7b","ae3fdceb79281b01f8546b97e7daa65761ac9dbc2aed307f4cf0ed5c35780f0c","164a8d6df9a2b9abee7221ada35f40947453a0705d5eef62e5a6e949579f416e","6844d51d86447b87fc36d0ed82f703d481ac4056d4813e86e10fa05b5cf05a38","8bb3f2921d551f2a9e568bdb31f2bd97567513e1d9a4cab3bf09b8cd9bce7993","5aabb196644b7c9992edd9c6bb935153e1bbed890332ad724170914e5ab8f68f","b1106e60a7cd13717233b7f34079c2e75bf60f8e95cae2019a77558fccf0c27a","5248fed105ee71c1d84a8bc67db66691e9d9a1acdb6824eeb89f10e2fe4968ff","4951203dac0560fa789f66765dae6c644ba2f02dfb67c1109feaad3806a6c2e0","01e811e3e87d8923a152784f455502e8d12db4a1c30abf076e9d324923c694e8","0d49e0824e22903056deb883f3778214daee351f48a4f4b83b7020b00aaabe5e"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p144"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-halfDuplexRedCapAllowed (IE type: \"true\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to (e)RedCap UEs.","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-iab-Support (IE type: \"true\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"-ncr-Support (IE type: \"true\")","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs.","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"-mobileIAB-Support (IE type: “true”)","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"not barred\" and \"not reserved\" for operator use and not \"true\" for other use and not \"true\" for future use,","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"-UEs shall treat this cell as candidate during the cell selection and cell reselection procedures.","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"When cell broadcasts any CAG-IDs or NIDs and the cell status is indicated as \"not barred\" and \"not reserved\" for operator use and \"true\" for other use, and not \"true\" for future use:","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"-All NPN-capable UEs shall treat this cell as candidate during the cell selection and cell reselection procedures, other UEs shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"true\" for other use, and either cell does not broadcast any CAG-IDs or NIDs or does not broadcast any CAG-IDs and the UE is not operating in SNPN Access Mode,","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"-The UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"true\" for future use,","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"-The UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"When cellBarredNES is absent and cellBarred is set to \"barred\",","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"-The UE capable of NES cell DTX/DRX shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"When cellBarredNTN is not broadcast in this cell,","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"-For NTN access, the UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"When halfDuplexRedCapAllowed is not broadcast in this cell,","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"-The (e)RedCap UE only capable of operating in half-duplex for FDD shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"When cellBarredATG is not broadcast in this cell,","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"-For ATG access, the UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"When cellBarredFixedVSAT is not broadcast in this cell,","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["0c2da8d05ce6344f0e277ca655f212bcd0a98463d7e42b5acdd564b494e15ebb","c7b61ec1aa84bcc27b9b077b2a1bcf309487bbf9c87af5bb3e9933972211370c","a99a1d9131022cd6c0d7a003ba4ee4c29e430bfb06884fdda7c9c5d1bd35f546","2fe1a6fd9bb33a08dafa259c626cfacb8fa918ab31bb3b969f80d766e02a8d51","2d0e524cf2a9627a513c52dad2ee95e6fa7cb09b26c4ccb07690fccca6bf6202","f3c00d7f55883016a5fcb9030437e2ccea78ecffe6e76b3e3cba9d2b297c05f8","523f70a185994f2e5d0c34c58423a8188c47f3b98577bd06191549a0eaa9f919","66fa1840b53c502b37e137987f653f2349753a576302187a377879d96f782f5e","28df512c02e38b0d8ae1c1673f253e48412295d3381cac57507af85054bf644c","301699b29be15cf6af9e8308118265f1c2591f8cbb1e332edced4bffbf384186","2ed9522046357830d23eae2fc5a34d267bf00fa39c08f6aa65b5f9f6b823b5d6","2615aa11afd8d4f291df3b3afad1687e4ae3cb2f7272054781c6fbe6d8e8d1bb","28c90a4083a07a76c9c9c92d3d8effe35ec45bb5fed4470af6fd48122c34d48d","5320801762a3774583a4f783342c06321ba2f1860f246c002ddb15a8e6ae56ab","b46a739ba8565a17abed30ebbcce8512d7593ba97941ae372d9556d7a8b3756b","7771d81aa47c02d6a0ca146c23b0520a3e37c5c3913e961f0150dbf1e39dcf08","17aec652450f26b92ede9e92c16a9d2c040133e53635e6c8b69fb3e24dfc15ce","0b66af1d7646153da29b7644476549f0130bf19ac787d28c9b89aae1d06984f4","e7ad373cc6e1f8097dfa286a4deea022832aab3ae07b88a58f16c4369a44670f","9b565d3bc68e378a67a60f991889017ca9eed2d167df03a427c81539cdba1645","3303171e7d860484032ab53f22d198c0a1052f44834920eab6737578f9d12365","915bff875de9e39ecb3c37c3b9aac628724f5655edd4e5ca6dc6e15cb47a7b51","32391fd2f8286eafe9f0a9cadbf3256e6ceb7827b6c4e4f6a18d0aa1defd60f2","f304e2988b8796cbd516bea39b55a72503353f35b2c490e93115753901a972e2"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p168"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-For NTN access, the fixed VSAT UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"When cellBarredMobileVSAT is not broadcast in this cell,","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"-For NTN access, the mobile VSAT UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"When cellBarred2RxXR is broadcast in this cell,","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"-The 2Rx XR UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"not barred\" and \"reserved\" for operator use for any PLMN/SNPN and not \"true\" for other use and not \"true\" for future use,","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 11 or 15 operating in their HPLMN/EHPLMN shall treat this cell as candidate during the cell selection and reselection procedures if the field cellReservedForOperatorUse for that PLMN set to \"reserved\".","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 11 or 15 shall treat this cell as candidate during the cell selection and reselection procedures if the field cellReservedForOperatorUse for selected/registered SNPN is set to \"reserved\".","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"-UEs assigned to an Access Identity 0, 1, 2 and 12 to 14 shall behave as if the cell status is \"barred\" in case the cell is \"reserved for operator use\" for the registered PLMN/SNPN or the selected PLMN/SNPN.","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 3 shall behave as if the cell status is \"barred\" in case the cell is \"reserved for operator use\" for the registered PLMN or the selected PLMN.","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"NOTE 1:Access Identities 11, 15 are only valid for use in the HPLMN/ EHPLMN and registered/selected SNPN; Access Identities 12, 13, 14 are only valid for use in the home country and registered/selected SNPN as specified in TS 22.261 [12].","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"NOTE 1a:Access Identity 3 is only valid for PLMNs that indicate to potential Disaster Inbound Roamers that the UEs can access the PLMN as specified in TS 22.261 [12].","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"When cell status \"barred\" is indicated or to be treated as if the cell status is \"barred\",","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"-The UE is not permitted to select/reselect this cell, not even for emergency calls except for the below cases:","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"-When cellBarred-eRedCap1Rx is set to “barred” in SIB1, an eRedCap UE that supports only 1Rx branch can consider the cell as acceptable cell, only if cell selection criteria are fulfilled as defined in clause 5.2.3, cellBarred in MIB is not set to “barred” and in SIB1, barringExempt-eRedCap is set to “true” and, if the eRedCap UE supports only half duplex FDD operation, halfDuplex-eRedCapAllowed is set to “true”; or ","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":"-When cellBarred-eRedCap2Rx is set to “barred” in SIB1, an eRedCap UE that supports 2Rx branches can consider the cell as acceptable cell, only if cell selection criteria are fulfilled as defined in clause 5.2.3, cellBarred in MIB is not set to “barred” and in SIB1, barringExempt-eRedCap is set to “true” and, if the eRedCap UE supports only half duplex FDD operation, halfDuplex-eRedCapAllowed is set to “true”;   ","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"-The UE shall select another cell according to the following rule:","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the MIB:","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if the selection criteria are fulfilled.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-If the UE is a RedCap UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselectionRedCap in SIB1', if available;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["b588fe2f2f8885069d7150cb02162cd331afb2c26c45ecce9e38277f2f3bae5e","1f3a89e58a6ec10a3ecb97ec77c18a27b40edfbfca46db25c3a4fd6b6e85bedf","bf94e610efff2b6dd64b9d9f987f15edd74c4c2bcab9b41df1ec9b0206603fa5","591c89959299bc2789da9e89cb64a348e96bf20182f7b6cf32e4c7635b9e92a2","46a19016882dca34ef16a5a43ac37b072f44ff40b99cbb8606310a07584fe8c8","4bf2a6b204061cf27d69be78c44d13e615b354cff0f9cd3c82f5f9f4c9affba3","64e2983fb9f6a42a3df7e0ac51448ce7b52ad3c4843a08d8f50fc04683483e9f","ad727d4b3728b4c1cfbc3566a380c9dd1bea55d9d8bf13b4512449d65a4971b4","13fb7742f976cbbb887beeda49595bd8f7da75b29f0d158ba6a4da83ba9452b2","1f8a4608c24d69369797c598fd7896215d1e6ff40ab3b0d0140357d0f012123c","2219e093a24142bb2f2ed378de5050eab5e675f8ac7d2911ddf7aace9b35ba8d","34fdf84b172870e1c43bcd7fa1f92ecba48ad8232867f256ce61ef5bfb5d3c91","84bb6edf5ea3d7c76522bc19fe38c9090459e04892b6971f30b14a6541be66d3","faa971598171dd221d389dcdca0d13d07f120f3b75cd506e58fc8e68b10f9505","9a9aaa6812052ccc0cf729320c948f87a19e271602ed74399100c84d561640b4","27afac1961bf3b3ace585100a45f70749751fce62127a77bd0d187d506682893","9a9bf6d5d75674f9ddbd1789312c15ae9b420fefb0722331121b643c7a232da5","bf689983bf67c21f262f37b90f24e94caf2a28c84c32feced407ff7afac3bf52","56c5ed13410199c7fbb4ab4c1edf6256beb9b48d9cc77b85a54ac839d11abb00","f474482559c49964bab700a80037e3d8b674039a1838468e103e7c1058ad11aa","55d362e0eecb9b9aa9a5da7fec7db00dc5b5a895a6e8f0f2ff90a30f16819555","49b9222b9b1910b2818fe6e67c318c58d6f87519179ba5f24de11fa9e74b87af","4cdf5854e52b532b608f99491e48845352c264e9b1c6b70c82f0e109ce1eb725","ab6995a8cbc3cb6d10f8bc72e3ee280cb5106385dc7b16d2749be17e3fe86a35"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p192"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-If the UE is an eRedCap UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselection-eRedCap in SIB1', if available;","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"-If the UE is a 2Rx XR UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselection2RxXR in SIB1', if available:","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if the selection criteria are fulfilled.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"-If the cell status \"barred\" is indicated in MIB but the UE is unable to acquire the SIB1; or","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to not supporting (e)RedCap UEs; or","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to not supporting 2Rx XR UEs:","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if re-selection criteria are fulfilled.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"-If the UE is neither a RedCap UE nor an eRedCap UE nor a 2Rx XR UE, or if the UE is a RedCap UE and intraFreqReselectionRedCap in SIB1 is available, or if the UE is an eRedCap UE and intraFreqReselection-eRedCap in SIB1 is available, or if the UE is a 2Rx XR UE and intraFreqReselection2RxXR in SIB1 is available:","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"-If the field intraFreqReselection in MIB message is set to \"allowed\":","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if re-selection criteria are fulfilled;","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds;","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"-If the field intraFreqReselection in MIB message is set to \"not allowed\":","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds;","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-If the cell operates in licensed spectrum:","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-the UE shall not re-select to another cell on the same frequency as the barred cell and exclude such cell(s) as candidate(s) for cell selection/reselection for 300 seconds;","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"-the UE may select to another cell on the same frequency if the reselection criteria are fulfilled.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["c58bcbc1ec648281af266960eaa4ed9415de0aa6070cbe76c6bb680db07c1011","9b65a3e03afb50c8f39dd8b96f99a24d2d54ed83e5f8d10188ec05c1ad622275","24d9a3b02eec0840bfe9054813cda7a86557effd3ebaa6292a5a07b53252ea05","da8121c76e3e003de153eb843ef8d15139808abf909d27a7097671ad0ebee6de","59e6532102587032b2b940f9e5d2ce6d71b1a16fc656fa0223631a521b67de53","1b74741907bce76a696baf650af2b42d7e55ae165db86d55762b6da770fefd76","f590c89c7ac858fcc6de8e8a45100e7bdc13e30367642ab4747d050e5e35bdd7","70ad7798f2ee9179f6c6fb18e179988083430363dacfdd32edc63d7927c85e52","c5d3e50b2a44689ab3ad510cf1229193167c6213b5d5731e97888b3476ef6420","5c5c00b4123cd9eca8a48e3e3b69f112619832a9ec37b1e45b66ab836ce7e490","e4fb9d8b5c2a690263e46dd3e9ea3518ff0ec867c0b2b28b59305259d0cb0224","4d9f5f5cf0c1ded5bed616d22c643baab64588b13edda9673eb409c8dca5209f","d722470433cb8a31dd09b6276a081e5c4fa9e15c022337e4550fc58c84b28798","09162bd11a036350e16ee411cbf4a9ce3c47c4d7440d242e8ee2fec9f82d4df0","cc808e203dd4b054a1c26986635f2d97bfdd2b06f105a7c64c9841e92adea9ab","a2e5c0fb9471ab1a43fece5527b08d782ce7b37859d356f307b246560e0265f3","6a0cd7dee9626b2dca6e89137b63340a19d8259e192158bf3da9bff944392416","0b138af1d809ad7a2c5e58f5d20e7bb4bea20e1a1532ecb5d78f3fb0c07c799b","44a6bdb9a232019176450b3c5c410931c840f222fc631b83fc76c95421877c5b","6265586a111d2475c270773bbe097c2d45a46b339a4b1c5cdaa72ac238a270f3","a25530342484aa0fd71bd0ffb8b69b26450b4f2697f0e7e67aada840cfd8b12c","1d2c0047bfec7b456cfcbd8fcc8135facc136194524b5bcc133c258192088f80","0dc0711259ec31fb6f3d79baf54179dbe0ac05d9e60a96306934488a44a1125b","a9ef03dfdd6bdcc5d3b6344108255dd93598e736097e67dd2d4a833069f1bc35"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p216"}
{"fields":{"filename":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"-If the cell operates in licensed spectrum, or if this cell belongs to a PLMN which is indicated as being equivalent to the registered PLMN or the selected PLMN of the UE, or if this cell belongs to an SNPN which is equal to or indicated as being equivalent to the registered SNPN or the selected SNPN of the UE:","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"-the UE shall not re-select to another cell on the same frequency as the barred cell and exclude such cell(s) as candidate(s) for cell selection/reselection for 300 seconds;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"-the UE may select to another cell on the same frequency if the reselection criteria are fulfilled.","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"The cell selection of another cell may also include a change of RAT.","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"NOTE 2:If barring of a cell is triggered by the condition of trackingAreaCode and trackingAreaList not being provided, as specified in TS 38.331 [3], the barring only applies to this PLMN and the UE can re-evaluate the barring condition again due to selection of another PLMN.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"5.3.2Unified access control","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"The information on cell access restrictions associated with Access Categories and Identities is broadcast in SIB1 as part of Unified Access Control as specified in TS 38.331 [3].","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"The UE shall ignore Access Category and Identity related cell access restrictions for cell reselection. A change of the indicated access restriction shall not trigger cell reselection by the UE.","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"The UE shall consider Access Category and Identity related cell access restrictions for NAS initiated access attempts and RNAU as specified in TS 38.331 [3].","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"A L2 U2N Relay UE does not need to perform the Unified Access Control as specified in TS 38.331 [3], due to the U2N Remote UE access attempt.","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":253}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"149f253d927d2e74973b61e63368b372768ae593ee515748b2b87e29cd977f5e","original_member_sha256":"829e02e952e6f3af7735a714ccf87bf08599df9fa8f969fd9b58bfe5e176d96a","paragraph_ElementTree_utf8_XML_sha256":["2a92c9e06934821290be4d4957045ee8156d08beddb3c09cbbbad4b654562560","b47662ac1b41e702fc1e68d5d5a7b181fa037eaab65ee9d4995b2230ab3b973b","6662c46b07263b29f2dd1d010e3e042e0fb69883fac6771915cb1ec5466e1dc0","7223b057a26db0b2c8c6de8d3805be3a532dca016f52ecaed6f3b34a5c280518","1e3125a20525fcf0b25873679db6e26a695ed06dff6ade5744e3037ee51feac5","e38c3fa33ffd939deee7281eaac7a24773759179561b0bfe2900efef5a5c19eb","721f669165ac533ee8caa6e26eb25a60b0464a0e4976d3bd116eecec5d28a709","d6eb30b86d49da5c6afe84f02e186de707c13653ddcfbac8ce52633ddc906c6c","592c377fe134a66a2926f75cbfeb8524cd284d9c8388d91f1f9c649089bfda9f","4172f9711768bf59e4c179d38b74e3de79edd04179078f2f2e25ae327500c687","8e52a3a62f1465f146f0a85a58cc3c0c8997e854c0a3d6fdb3d28e9f0c5dc502","8f52e699541afe45478b3605593f1bb70b1f1bf860abbbca3a1001eb47a8a120","8a9489e029faa715197e93ce8d0a999ca7381e70ec80ce4983f4b2095abadc58","023a05bd6453a59ec493005d9a444294761a15f5f45a284682fead9d39f28887"],"paragraph_range_zero_based":[240,253],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404645.zip::R2-2404645_R18_eRedCap_304.docx:p240"}
