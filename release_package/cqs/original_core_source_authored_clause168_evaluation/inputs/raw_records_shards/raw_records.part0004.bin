inerList contains a list of radio access technology specific capability containers.","paragraph_zero_based":42666},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList information element","paragraph_zero_based":42667},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42668},{"literal_text_all_w_t_and_m_t":"-- TAG-UE-CAPABILITYRAT-CONTAINERLIST-START","paragraph_zero_based":42669},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42670},{"literal_text_all_w_t_and_m_t":"UE-CapabilityRAT-ContainerList ::=    SEQUENCE (SIZE (0..maxRAT-CapabilityContainers)) OF UE-CapabilityRAT-Container","paragraph_zero_based":42671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e5829b2adb6c7a8d34243f9bb877f96031313e5c597ebfb1ac053423f0b7bd6d","8a573ac6534072ceb405590c3d78c9c603b810d016244a2e8b455ecdb7ccc642","40b9ea5652bdec1ee35946384cdd38b036e9c57fc3e13dce4d6572a4c7439eef","b836c36696da9f9784b54674b0977f8492681c22293c9eac20f484fafb6ae027","9dffaa5dd24b598b9a5ac5e546420df90cbe5f2476ecec46e1bb98aee92296d5","8e37061bad2564bc73a03dfbe9eb8bb5c32638d2ae0445e2884eb517e70f5579","495f2731bc9a12a3de3e8e3bb561a1b3c57aff99b614b579f2ba06f8a38193cf","c6f6a9505563b7d59cde22359427c7b68ce6a63da6cb688212c36cdabe494b55","31e0f19016753137691ab68d6dcdaaa60aa32e479070665528a3caae1a489938","d4af589db349223f317ca85a7e6058b28689d7e5c0b897c5d15d890a26a98ed4","7bc3e7b3a22e3779763b5838651e8524c8a1991563559db3e539fb530985d472","02fa32e0373e80a446831b7ab3a526cb6b46b937023da92b58e4a9e2c341e2db","3b34479c2f939fcead35344bfd9f558ec5b1cd743b3c2f8736f676615623aba0","ab8d8ba3d1b31e482d3cbda156794cf56e256880f83c68b0282925ba87ff1f33","09c12d1afd5de72377ce756ee35e8dac72a5732f307213f