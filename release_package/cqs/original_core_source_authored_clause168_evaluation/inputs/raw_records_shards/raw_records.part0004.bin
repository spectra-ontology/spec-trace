{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25104},{"literal_text_all_w_t_and_m_t":"MeasObjectNR-SL field descriptions","paragraph_zero_based":25105},{"literal_text_all_w_t_and_m_t":"sl-Frequency","paragraph_zero_based":25106},{"literal_text_all_w_t_and_m_t":"Indicates the sidelink frequency associated to this MeasObjectNR-SL. The value 1 corresponds to the frequency of first entry in sl-FreqInfoList broadcast in SIB12, the value 2 corresponds to the frequency of first entry in sl-FreqInfoListSizeExt broadcast in SIB12, the value 3 corresponds to the frequency of second entry in sl-FreqInfoListSizeExt broadcast in SIB12 and so on.","paragraph_zero_based":25107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25108},{"literal_text_all_w_t_and_m_t":"–MeasObjectRxTxDiff","paragraph_zero_based":25109},{"literal_text_all_w_t_and_m_t":"The IE MeasObjectRxTxDiff is used to configure the measurement object for UE Rx-Tx time difference measurement.","paragraph_zero_based":25110},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff information element","paragraph_zero_based":25111},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25112},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASOBJECTRXTXDIFF-START","paragraph_zero_based":25113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25115},{"literal_text_all_w_t_and_m_t":"MeasObjectRxTxDiff-r17 ::=      SEQUENCE {","paragraph_zero_based":25116},{"literal_text_all_w_t_and_m_t":"    dl-Ref-r17      CHOICE {","paragraph_zero_based":25117},{"literal_text_all_w_t_and_m_t":"        prs-Ref-r17             NULL,","paragraph_zero_based":25118},{"literal_text_all_w_t_and_m_t":"        csi-RS-Ref-r17          NULL,","paragraph_zero_based":25119},{"lite