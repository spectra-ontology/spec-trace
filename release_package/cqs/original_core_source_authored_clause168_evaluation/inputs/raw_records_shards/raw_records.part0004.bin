184c9c319ebddafae6b935b011fca995e384cca","9315bb47040b83bf3601efaba91022f18320145e1ec98b75f64fa1e17e54cd72","ebf74a9c18727bb6264185fb36d686590289c730844241f262b25fa80cc5705d","1f47c66b3360f98567d3f62fd43feff26566b55a4a568407fe2d6dc0ac2e6f1a","13df23a859dcb7d7e109ae59af65744ab5001bdd38a9b5e6c26495d54570e7a9","dd49b9ddad5de99911cfa019beccf4cfcf64616588e5569cc5cbc37cdfedb671","72cfa8f26e346515ad916bbf79e7266e9ec3fcd0650370387e9d6b0a6f88eeb2","143854fc93b58d09623ee2f321dac78f1e08985786ef96c8eacb4de28701ed05","7c8d1da5bb96e33ec02a2fdf1763cbc84e2ccfecfe9cbd5b2c883687f491db26","29078a88fc6fb156e074b72db106df559a895872f393674cebd17b0335cbef6d","350077acf87e0019908f9d59405fef9afef4f76139540f426a2cd619504eaca2","30e7217f23dca9dcef8788a381e9870d838f7c765f03114b7524ba40ed667677","c8c80f4f8f28d33e957c5e8da9b6b3e245676ec15b7e754331218f99c10b815b","f6663a16c61f0be453902b84ccef68cd0d29c50aa56359ff06c3e55027928d71","47a6def99db3a1d3e4a35020298e763ffb83f239a358b13290fbaa0635b10923","6b59d502a93c975aedb4b6cef34429cdd606283ee38d8e74aed0291f097c50ac","4de4be7439f7357a43135d2beb46007f10a6b9022b2525ee4a94cd649146238b"],"paragraph_range_zero_based":[47352,47375],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p47352"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to GNSS. If not configured, the synchronization configuration is used for SLSS transmission/reception when the UE is synchronized to eNB/gNB.","paragraph_zero_based":47376},{"literal_text_all_w_t_and_m_t":"sl-SyncRefMinHyst","paragraph_zero_based":47377},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using absolute comparison.","paragraph_zero_based":47378},{"literal_text_all_w_t_and_m_t":"sl-SyncRefDiffHyst","paragraph_zero_based":47379},{"literal_text_all_w_t_and_m_t":"Hysteresis when evaluating a SyncRef UE using relative comparison.","paragraph_zero_based":47380},{"literal_text_all_w_t_and_m_t":"sl-NumSSB-WithinPeriod","paragraph_zero_based":47381},{"literal_text_all_w_t_and_m_t":"Indicates the number of sidelink SSB transmissions within one sidelink SSB period. The applicable values are related to the subcarrier spacing and frequency as follows:","paragraph_zero_based":47382},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 15 kHz: 1","paragraph_zero_based":47383},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 30 kHz: 1, 2","paragraph_zero_based":47384},{"literal_text_all_w_t_and_m_t":"FR1, SCS = 60 kHz: 1, 2, 4","paragraph_zero_based":47385},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 60 kHz: 1, 2, 4, 8, 16, 32","paragraph_zero_based":47386},{"literal_text_all_w_t_and_m_t":"FR2, SCS = 120 kHz: 1, 2, 4, 8, 16, 32, 64","paragraph_zero_based":47387},{"literal_text_all_w_t_and_m_t":"All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-NumSSB-WithinPeriod in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":47388},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetSSB","paragraph_zero_based":47389},{"literal_text_all_w_t_and_m_t":"Indicates the slot offset from the start of sidelink SSB period to the first sidelink SSB. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeOffsetSSB in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":47390},{"literal_text_all_w_t_and_m_t":"sl-TimeInterval","paragraph_zero_based":47391},{"literal_text_all_w_t_and_m_t":"Indicates the slot interval between neighboring sidelink SSBs. This value is applicable when there are more than one sidelink SSBs within one sidelink SSB period. All values in sl-TimeInterval in sl-SSB-TimeAllocation1 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeInterval in sl-SSB-TimeAllocation2 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured. All values in sl-TimeInterval in sl-SSB-TimeAllocation3 is set to be same across all carrier frequencies configured for UEs performing NR sidelink communication on multiple carrier frequencies, if configured.","paragraph_zero_based":47392},{"literal_text_all_w_t_and_m_t":"sl-SSID","paragraph_zero_based":47393},{"literal_text_all_w_t_and_m_t":"Indicates the ID of sidelink synchronization signal associated with different synchronization priorities.","paragraph_zero_based":47394},{"literal_text_all_w_t_and_m_t":"syncInfoReserved","paragraph_zero_based":47395},{"literal_text_all_w_t_and_m_t":"Reserved for future use.","paragraph_zero_based":47396},{"literal_text_all_w_t_and_m_t":"syncTxThreshIC, syncTxThreshOoC","paragraph_zero_based":47397},{"literal_text_all_w_t_and_m_t":"Indicates the thresholds used while in coverage and out of coverage, respectively. Value 0 corresponds to -infinity, value 1 to -115 dBm, value 2 to -110 dBm, and so on (i.e. in steps of 5 dBm) until value 12, which corresponds to -60 dBm, while value 13 corresponds to +infinity.","paragraph_zero_based":47398},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["98d1b5576ad962b6a865df97b0197dfc5655b11c69ff0ee3b041c5ea379874e4","0ce076e7ed5a82037e1d56fbd3b3899fcf30586ae34ff98b11601bd306762db3","75b63bd863f4a48407d3e773e7bfbcddd362d9926412e289c454ba57b8f248cc","ed582c8b44a86a556024f5d85fd4d18b976206f5712b9c9ff0e66f4e69c05262","0028e58ad3f0397cdf74909cc6f75b21fe390c3947ed6bb52d7268d020bba432","2c12f51016e63ef5dd88b64a330b6a5c8a46e87132b0af8a5cc5a8ca3d6d48b6","ab784e93bf1327bf0c1f1f248210c6aaba53e9834ab5964f567e19cf0ac2a787","06f2c66a7f62ccffba7ff0286363c8ed9eb981e0967a81b114dc2