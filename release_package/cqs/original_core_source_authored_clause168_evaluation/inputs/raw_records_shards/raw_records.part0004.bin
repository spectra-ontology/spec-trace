{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":35760},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35761},{"literal_text_all_w_t_and_m_t":"    tag-Id-ptr-r18                      ENUMERATED {n0,n1}                                          OPTIONAL    -- Cond 2TA","paragraph_zero_based":35762},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":35763},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35764},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35765},{"literal_text_all_w_t_and_m_t":"QCL-Info ::=                        SEQUENCE {","paragraph_zero_based":35766},{"literal_text_all_w_t_and_m_t":"    cell                                ServCellIndex                                               OPTIONAL,   -- Need R","paragraph_zero_based":35767},{"literal_text_all_w_t_and_m_t":"    bwp-Id                              BWP-Id                                                      OPTIONAL, -- Cond CSI-RS-Indicated","paragraph_zero_based":35768},{"literal_text_all_w_t_and_m_t":"    referenceSignal                     CHOICE {","paragraph_zero_based":35769},{"literal_text_all_w_t_and_m_t":"        csi-rs                              NZP-CSI-RS-ResourceId,","paragraph_zero_based":35770},{"literal_text_all_w_t_and_m_t":"        ssb                                 SSB-Index","paragraph_zero_based":35771},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":35772},{"literal_text_all_w_t_and_m_t":"    qcl-Type                            ENUMERATED {typeA, typeB, typeC, typeD},","paragraph_zero_based":35773},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35774},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35775},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35776},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-STOP","paragraph_zero_based":35777},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35778},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35779},{"literal_text_all_w_t_and_m_t":"QCL-Info field descriptions","paragraph_zero_based":35780},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":35781},{"literal_text_all_w_t_and_m_t":"The DL BWP which the RS is located in. If the field is absent, the RS is located in the DL BWP in which the TCI-State is applied by the UE.","paragraph_zero_based":35782},{"literal_text_all_w_t_and_m_t":"cell","paragraph_zero_based":35783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ba3154a6687776509fb40a3e9e94fae1cfa0797d8a9c4fbe55fe249ccc93ddc4","e678ee2fdbfbbd79cb83b2bec103b2c0f82ea1dd80d424af5944bb0b5c68afb5","95e85869dc328419b0668ab9acd28602a28ff8546819c40006c68b93fe72cf64","8fad2920a1ab4afc0ef568377a1a3a48cfbd1c34859547e0d76da8b820b25e9e","7967f6e61257679d4e62f1a70b8c27b91ba6b5aa88a8a0c800ed63d768d0c879","4304a0b21aff26d7937ca64b27b0a53414a713f80abe9c22fe247b336a692d1d","776a2a3e46d0324f21a04b97c93c3ea5c1203776e7aa322022299245778131b3","552f356f9a0993d322afcd501039b8dfa5188b24ebe446e2027c2ab99740921d","62ec1dda0ffd80cc04c59dcf6db74b09198be8fb159f925f0f9e83a7cc532ce9","1640a11a5c4a553c70e52f43a082e7a94d545df9e9093a7cf08fb79b4aaaa63e","8bd7df6d5d3e2f373ebc25f82154ca86c05870852df3d2da79872b37d75d2635","23a23c69d2b6f7efdf817cf2f9ff3a86c8d4bb713c743c301f840fb43de76253","bb682ea9251feee1db3f8dba0159f7cfa8f967371064831feb8296e4e6943b43","832dcbcbedab79c5583d020dba7aaa58f3ea3d488947221b3fe232c572952a7e","afc1884d371a0daa104822216c58eae0464c02999734551207bea22ff69907ea","9cdaff90fdb4249fba086f54fe407f79c747803e0cc90fe7f5588d3cf7bce029","e54c105ae7cb6d99d5db6f2b707d063d336647da4165a64a4ac8a0024d6cac28","0cae958f1fc34599d312d39d507c8b34d8df5132ef00bacdae6fd916c8af2afe","6833a8f42e927c5caa1f8e133832f44ea38fed301a50456c003adf38fcd5ff3a","a3983a26461950d5b94b491d5080fa35d537cf953cf89afae7543daa39a5ccd1","542fc44be963f7dd400992e38b2b08a4eb58b955deeb7f13866d16aa9d598bac","633feae3bcf8a7c9c26d1b48468475d99cb57e0e4a358ed1b5d49ddc7ed01c2d","45e30e2a76f36940e8c7bfb2633730e86dfdf8ba5f4de0847c2cdc6fcce4c466","e1ee2e6a8e36a40831fc0968bdd080671276522f692a0c9f153eac6f18049cf3"],"paragraph_range_zero_based":[35760,35783],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35760"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-State is applied by the UE. The RS can be located on a serving cell other than the serving cell for which the TCI-State is applied by the UE only if the qcl-Type is configured as typeC or typeD. If the referenceSignal is set to csi-rs and unifiedTCI-StateType is configured, either both cell and bwp-Id are present or both cell and bwp-Id are absent. See TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35784},{"literal_text_all_w_t_and_m_t":"referenceSignal","paragraph_zero_based":35785},{"literal_text_all_w_t_and_m_t":"Reference signal with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35786},{"literal_text_all_w_t_and_m_t":"qcl-Type","paragraph_zero_based":35787},{"literal_text_all_w_t_and_m_t":"QCL type as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35789},{"literal_text_all_w_t_and_m_t":"TCI-State field descriptions","paragraph_zero_based":35790},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":35791},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB for both QCL-Type1 and QCL-Type2. In case the cell is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field cell. Otherwise, it refers to a PCI value configured in a list additionalPCI-ToAddModList configured in the serving cell where the TCI-State is applied by the UE. When this field is present the cell for qcl-Type1 and qcl-Type2 is configured with same value, if present.","paragraph_zero_based":35792},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":35793},{"literal_text_all_w_t_and_m_t":"The ID of the reference signal (e.g. a CSI-RS or an SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the TCI State is applied by the UE.","paragraph_zero_based":35794},{"literal_text_all_w_t_and_m_t":"qcl-Type1, qcl-Type2","paragraph_zero_based":35795},{"literal_text_all_w_t_and_m_t":"QCL information for the TCI state as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35796},{"literal_text_all_w_t_and_m_t":"tag-Id-ptr","paragraph_zero_based":35797},{"literal_text_all_w_t_and_m_t":"It indicates the TAG that is associated with this TCI state, value n0 means the TCI state associate with the TAG indicated by tag-Id, value n1 means this TCI state associated with the TAG indicated by tag2-Id. The tag-Id-ptr refers to the TAG of the serving cell where the TCI state is applied.","paragraph_zero_based":35798},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":35799},{"literal_text_all_w_t_and_m_t":"ID number of the TCI state.","paragraph_zero_based":35800},{"literal_text_all_w_t_and_m_t":"ul-PowerControl","paragraph_zero_based":35801},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the dl-OrJointTCI-StateToAddModList is configured.","paragraph_zero_based":35802},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35803},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35804},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35805},{"literal_text_all_w_t_and_m_t":"2TA","paragraph_zero_based":35806},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if tag2 is present for the serving cell and the serving cell is configured with unifiedTCI-StateType set to joint. It is absent, Need R, otherwise.","paragraph_zero_based":35807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5f58bd89a121cef4108389c78bbe200b7224938385c2c46257405d1872f05f95","5e88cb8eae5e7ed537053eaadfb2ab3913cc24676d7e8bf1003d2bfd41cc4259","cad9512301c3529e1cdba587b05f395d61361bfc1044077a16165b65a56083fe","f8412efe249bef2bc811364ad587bc1ef7373a0af184d7997015edad0cc90615","61fad970b03a4c63466b9416e3771da2a7a19dba4de684d74cb7e2fad03b9a85","2190425260c8662dbd79f943883981507985633433eb594fd28056b4056e9951","bf0f7d498d239c8c96af72d6ab75fff1f413023d94364afd418099b5fdd681f5","a4903051d78912fbd16d1cb3fdf65e435052ca7dabbfb02c20bbf8cdf7f7735d","debea49ff023034176c7960cd1d73deae7f72fffc86488812ee2c5bbf2ef25b3","5c9c03dc0eff1a96fd8cd5684c68e9b8bd71859a3eb2bf704ae8fcee6add82e9","30ec7292ce2639e10d8c4fc9c8e7deb233c555b17199febfa1fdc132ef4f4b1e","eade06ef3f3ad0a881df362b75183152edd624292ef2c843d2210d438916cde6","0de582805466e81b1adaddc9c0d03bfd8c93eb5fb9a312918d2239d09545d87b","163c52692867f45b989610e53137b083a101344f15ebfd8274757138178349ae","841cd7a2db983d66834753572bb810f8afc92d954c850e47f8548c9af05e6259","0851e9166daa7f3d2c9fdb31513c74ecf4d0cccc72546a569ee72b7ff5f202de","7fb73305dc6713897e1996d3a476e7d5f5cb03c048e55a48666422376e3ccc24","7135c667c7e725549e250e85955accd456600d5b8330d5e2b3a7c9755f9829ee","a880af2271be9d52ea59bfb866139402f800e03948bbbdced570b0525a8cf04d","3a3a8a0bec97cd7b1d93d489d778d20ad21b0a9ca5d736aa27d40f5ca6b98eef","399fea7aa21f4404a66b451aa66126856fec18de79803ddbd2fd3bf57c5a1820","273b2342fabea225b9104e562d2e68deedbb110e9fe56d6eba107d32558af8de","a4ea9f6d1730cffefe30ae782277feae02bce7774ab061467b1c917b8e826d08","746c4e7db300da50ac288e2582afa6a65ee2902efada75c0ab3996e8e50a468a"],"paragraph_range_zero_based":[35784,35807],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p35784"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CSI-RS-Indicated","paragraph_zero_based":35808},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs is included and unifiedTCI-StateType is not configured. This field is optionally present, Need R, if csi-rs is included and unifiedTCI-StateType is configured. Otherwise, it is absent, Need R.","paragraph_zero_based":35809},{"literal_text_all_w_t_and_m_t":"JointTCI","paragraph_zero_based":35810},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":35811},{"literal_text_all_w_t_and_m_t":"JointTCI1","paragraph_zero_based":35812},{"literal_text_all_w_t_and_m_t":"This field is mandatory present, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":35813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35814},{"literal_text_all_w_t_and_m_t":"–TCI-StateId","paragraph_zero_based":35815},{"literal_text_all_w_t_and_m_t":"The IE TCI-StateId is used to identify one TCI-State configuration.","paragraph_zero_based":35816},{"literal_text_all_w_t_and_m_t":"TCI-StateId information element","paragraph_zero_based":35817},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35818},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-START","paragraph_zero_based":35819},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35820},{"literal_text_all_w_t_and_m_t":"TCI-StateId ::=                     INTEGER (0..maxNrofTCI-States-1)","paragraph_zero_based":35821},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35822},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-STOP","paragraph_zero_based":35823},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35824},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35825},{"literal_text_all_w_t_and_m_t":"–TCI-UL-State","paragraph_zero_based":35826},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-State indicates the TCI state information for UL transmission.","paragraph_zero_based":35827},{"literal_text_all_w_t_and_m_t":"TCI-UL-State information element","paragraph_zero_based":35828},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35829},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-UL-STATE-START","paragraph_zero_based":35830},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35831}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["be2059547dbee186b5e35314c4861c426d66fa77d8cb1a8b34995d80f619514e","64ccbed81488ba617f37e947c1193b6a36ce6ab49733938b7294d303787e852f","c3270c66be038736581606a819ed6e3049be4b3130be396775eabc230f663209","8720e7800f1523e6159f7076f024e5b9565574bc1213df0b5f7957deab77d192","9d5059c18a9bbfb402d19c530daba43eea316d648d49e8a72bb3a678d2684361","43716eb6b714511b26a353c3bd893842e5a7d18621ecf37e71f5178958b0c789","29d6c1fbe4b3c9d71cc349f24cc85e3e3ae918f83539ab9c5592c425ea536ade","36ce9481c2c96d820d0c2abc1802a6b99606f47594f282147ef24e29eb9833bd","3e982af2fd6d17814c87ce7b20fa268404bce0b6be8be35173e0c0ef26231e81","50cbb84c57afdeee4d12237b421d8199f5aa807896092d2c50ce37b3b27256f7","bab395b8a12373323f6a5ba7a5af6b59248215ef17587494f43cc6bf3a85a8c9","c7b41ea525f23adeabeb511b26caea5bb8a6ea3cf2744d38e463056417c99681","cc310c98caef335ef033fa50811ec8e61c19f1f05596bf1626f12c265c585a25","469987f787de9938cdcf9286ce3ab96a6d76d08ed9a2accda590ef0eeb8be7df","3bccbde