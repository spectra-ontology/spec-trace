{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>setup the FR1 measurement gap configuration indicated by the gapFR1 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5520},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":5521},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":5522},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":5523},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":5524},{"literal_text_all_w_t_and_m_t":"1>else if gapFR1 is set to release:","paragraph_zero_based":5525},{"literal_text_all_w_t_and_m_t":"2>release the FR1 measurement gap configuration configured by gapFR1;","paragraph_zero_based":5526},{"literal_text_all_w_t_and_m_t":"1>if gapFR2 is set to setup:","paragraph_zero_based":5527},{"literal_text_all_w_t_and_m_t":"2>if an FR2 measurement gap configuration configured by gapFR2 is already setup, release the FR2 measurement gap configuration;","paragraph_zero_based":5528},{"literal_text_all_w_t_and_m_t":"2>setup the FR2 measurement gap configuration indicated by the gapFR2 in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5529},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":5530},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":5531},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":5532},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":5533},{"literal_text_all_w_t_and_m_t":"1>else if gapFR2 is set to release:","paragraph_zero_based":5534},{"literal_text_all_w_t_and_m_t":"2>release the FR2 measurement gap configuration configured by gapFR2;","paragraph_zero_based":5535},{"literal_text_all_w_t_and_m_t":"1>if gapUE is set to setup:","paragraph_zero_based":5536},{"literal_text_all_w_t_and_m_t":"2>if a per UE measurement gap configuration configured by gapUE is already setup, release the per UE measurement gap configuration;","paragraph_zero_based":5537},{"literal_text_all_w_t_and_m_t":"2>setup the per UE measurement gap configuration indicated by the gapUE in accordance with the received gapOffset, i.e., the first subframe of each gap occurs at an SFN and subframe meeting the following condition:","paragraph_zero_based":5538},{"literal_text_all_w_t_and_m_t":"SFN mod T = FLOOR(gapOffset/10);","paragraph_zero_based":5539},{"literal_text_all_w_t_and_m_t":"subframe = gapOffset mod 10;","paragraph_zero_based":5540},{"literal_text_all_w_t_and_m_t":"with T = MGRP/10 as defined in TS 38.133 [14];","paragraph_zero_based":5541},{"literal_text_all_w_t_and_m_t":"2>apply the specified timing advance mgta to the gap occurrences calculated above (i.e. the UE starts the measurement mgta ms before the gap subframe occurrences);","paragraph_zero_based":5542},{"literal_text_all_w_t_and_m_t":"1>else if gapUE is set to release:","paragraph_zero_based":5543}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095