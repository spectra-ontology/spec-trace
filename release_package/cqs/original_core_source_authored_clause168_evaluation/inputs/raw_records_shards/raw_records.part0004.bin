{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–SIB13","paragraph_zero_based":17400},{"literal_text_all_w_t_and_m_t":"SIB13 contains configurations of V2X sidelink communication defined in TS 36.331 [10].","paragraph_zero_based":17401},{"literal_text_all_w_t_and_m_t":"SIB13 information element","paragraph_zero_based":17402},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17403},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB13-START","paragraph_zero_based":17404},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17405},{"literal_text_all_w_t_and_m_t":"SIB13-r16 ::=                       SEQUENCE {","paragraph_zero_based":17406},{"literal_text_all_w_t_and_m_t":"    sl-V2X-ConfigCommon-r16             OCTET STRING,","paragraph_zero_based":17407},{"literal_text_all_w_t_and_m_t":"    dummy                               OCTET STRING,","paragraph_zero_based":17408},{"literal_text_all_w_t_and_m_t":"    tdd-Config-r16                      OCTET STRING,","paragraph_zero_based":17409},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                          OPTIONAL,","paragraph_zero_based":17410},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17411},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17413},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB13-STOP","paragraph_zero_based":17414},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17415},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17416},{"literal_text_all_w_t_and_m_t":"SIB13 field descriptions","paragraph_zero_based":17417},{"literal_text_all_w_t_and_m_t":"dummy","paragraph_zero_based":17418},{"literal_text_all_w_t_and_m_t":"This field is not used in the specification and the UE ignores the received value.","paragraph_zero_based":17419},{"literal_text_all_w_t_and_m_t":"sl-V2X-ConfigCommon","paragraph_zero_based":17420},{"literal_text_all_w_t_and_m_t":"This field includes the E-UTRA SystemInformationBlockType21 message as specified in TS 36.331 [10].","paragraph_zero_based":17421},{"literal_text_all_w_t_and_m_t":"tdd-Config","paragraph_zero_based":17422},{"literal_text_all_w_t_and_m_t":"This field includes the tdd-Config in E-UTRA SystemInformationBlockType1 message as specified in TS 36.331 [10].","paragraph_zero_based":17423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["19254b2618dff623a031d445039999a445695db83ae03af559b499ef67199878","56b1f38c06d60ea2fe6b7798abcd50255d3fb35ce5317339adef3e1de7a3fa6e","6d914fde1ea7220b3676a55196c73c6fd399a7fb22003b35c2e30aec8121acd5","6b03a5e11bcaa126b6c4a6a89d208f2399cc5e72a3d96a2271b88d59c99ea23f","1de24d70a67fe0be00ff29191fd6e6b4f3eebdc36660683d11aaf852172cd7f9","e7a5bbe4d44a481616456bf850cc9b5431d6a4c6273d1bc320fa7101e1b93748","2446a46a75cbf3955f7ba87559ff1db7e11aa50095b602dc923403dd82800503","ff235d080398bcf035491f0387405c51303f836bd0576a2c42842b1122bf86ab","cd7f998ce0d3ac3cda05b8cd6783f6b166ca94ca51ce78e1db0886b80eac08dd","e1e11baebebf6173fa66806a95136d228b72ec0d2220f37bec3377bace56598c","c6b4b0dbb780cf7c45ca1668715acf0582619c77024d0e3d7b13213278da5d0c","19c66b995f798c25090717752c4205b3a40bd29f9bb62899047258f915c1bd54","8d3898294ccc3ed5a7bb968d5b18d131e04071a9d9c13097459ca3460a9a7694","66b321395db72c8f332eb2999aa235e2af7bc609936d3412310dd93969be431a","3aaf5ec9ddf8a2b3bc0a84da5b28b22639a96da93c6419f6ecb7b57dbab1eea6","f373888722e532995a937f930cef0ff4ee9d908b81d536152600df5e90a0564c","9be162fbca43c