{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30912},{"literal_text_all_w_t_and_m_t":"RejectWaitTime ::=                  INTEGER (1..16)","paragraph_zero_based":30913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30914},{"literal_text_all_w_t_and_m_t":"-- TAG-REJECTWAITTIME-STOP","paragraph_zero_based":30915},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30916},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30917},{"literal_text_all_w_t_and_m_t":"–RepetitionSchemeConfig","paragraph_zero_based":30918},{"literal_text_all_w_t_and_m_t":"The IE RepetitionSchemeConfig is used to configure the UE with repetition schemes as specified in TS 38.214 [19] clause 5.1.","paragraph_zero_based":30919},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig information element","paragraph_zero_based":30920},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30921},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-START","paragraph_zero_based":30922},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30923},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig-r16 ::= CHOICE {","paragraph_zero_based":30924},{"literal_text_all_w_t_and_m_t":"    fdm-TDM-r16                        SetupRelease { FDM-TDM-r16 },","paragraph_zero_based":30925},{"literal_text_all_w_t_and_m_t":"    slotBased-r16                      SetupRelease { SlotBased-r16 }","paragraph_zero_based":30926},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30927},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30928},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig-v1630 ::=   SEQUENCE {","paragraph_zero_based":30929},{"literal_text_all_w_t_and_m_t":"    slotBased-v1630                    SetupRelease { SlotBased-v1630 }","paragraph_zero_based":30930},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30931},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30932},{"literal_text_all_w_t_and_m_t":"FDM-TDM-r16 ::=                SEQUENCE {","paragraph_zero_based":30933},{"literal_text_all_w_t_and_m_t":"    repetitionScheme-r16           ENUMERATED {fdmSchemeA, fdmSchemeB,tdmSchemeA },","paragraph_zero_based":30934},{"literal_text_all_w_t_and_m_t":"    startingSymbolOffsetK-r16      INTEGER (0..7)                                    OPTIONAL  -- Need R","paragraph_zero_based":30935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["292a607e97966481b47bbf5b87b7cb12864238d948d5146cb8cef972612e8840","8a9c7d1d801b1ac95de7361434483855464e42f5490774308e3734b063acdb90","b246cecc6f88dcd36470172c9f4e5dde3b349668263c91dfd1b6eb85efdf3b93","ae0c6428aeb43b0238f8a21ae2aee5d8846d70a1000f41bf8d96041d8d182207","480febb73c68e5675aac63af535309aa08ec31fdbd1b3ab96059c72c109a7094","773531db0e22973fff6f243a042c12328bfd5ae6c31fbfb92df395295e0198c3","26105d100e09cf7a3a4724bf5288698812195aac626d0e845b121efb01bd8d7f","5d0e5678fd2007fde051e49b4da067701e7fca08d93aa0f2fc074ffd0acd1262","ef4b4be30250382ebf66712f3e18252f54c152fee603ae5cbfdf6b586e235105","aed31fa73568a837da49ac32001cbf0197b9d50b5f26753dff4ff1a1dafce420","804f936c6b315b9c1e7e84208cc1a3006670fec2e25ca4fc5b6e66ffad2a873e","e0cecf434873dfa9125df7771cfb3e4dc4cef98f45098090cd0532f050d60f99","a22e4c795fba1f0ecddfbb14b51218037a07cebbbc1389cea64fa6bcfc7261fd","da126eb47912f2a157e29ed570a01f2ec8fcaa5f85520ef5424294182068bdc4","0a7d7df2c25c4469e69ea3b37dff980c92e6d1e72b21e1ce55e7ca821adaae00","9bd7a8b243bfc8a509cdcd23ee3d629ff71ca95dfc35ef978f194892d37463e3","689e06f80e72a08289bc2054905b83fc37cbb792a3b07bf31e984478f4c74871","ff413da6f829fc532aeb3af1c4dec8bf4f94511687aa43c1036e4179c67398fb","5d75d5d42ba262e013140d2859aaaacc4a2a50ef20b6f093e46be95c9b1814cd","09024caea70db6a5ac1e427dacacc301718137073e989127c2519d08f5ef7aad","e9a906e7c8b57ef004b8bbaf689aa6804c612a00169b474af5b9a37d1bd1af46","52770ffd568112487918eba568c9ab17083ce2fdb7447eed9842ff9d95e1219c","b5aa716c21c464e6f3271615c3314c2450ff08ec31c147be9fa99aec216e1c4f","1d2f06e765b2414ed8c6e2120f25fb4c539b6e0a284f623680571cb066b12a10"],"paragraph_range_zero_based":[30912,30935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p30912"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30936},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30937},{"literal_text_all_w_t_and_m_t":"SlotBased-r16 ::=              SEQUENCE {","paragraph_zero_based":30938},{"literal_text_all_w_t_and_m_t":"    tciMapping-r16                 ENUMERATED {cyclicMapping, sequentialMapping},","paragraph_zero_based":30939},{"literal_text_all_w_t_and_m_t":"    sequenceOffsetForRV-r16        INTEGER (1..3)","paragraph_zero_based":30940},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30941},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30942},{"literal_text_all_w_t_and_m_t":"SlotBased-v1630 ::=            SEQUENCE {","paragraph_zero_based":30943},{"literal_text_all_w_t_and_m_t":"    tciMapping-r16                 ENUMERATED {cyclicMapping, sequentialMapping},","paragraph_zero_based":30944},{"literal_text_all_w_t_and_m_t":"    sequenceOffsetForRV-r16        INTEGER (0)","paragraph_zero_based":30945},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30946},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30947},{"literal_text_all_w_t_and_m_t":"-- TAG-REPETITIONSCHEMECONFIG-STOP","paragraph_zero_based":30948},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30949},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30950},{"literal_text_all_w_t_and_m_t":"RepetitionSchemeConfig field descriptions","paragraph_zero_based":30951},{"literal_text_all_w_t_and_m_t":"fdm-TDM","paragraph_zero_based":30952},{"literal_text_all_w_t_and_m_t":"Configures UE with a repetition scheme among fdmSchemeA, fdmSchemeB and tdmSchemeA as specified in clause 5.1 of TS 38.214 [19]. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release slotBased if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":30953},{"literal_text_all_w_t_and_m_t":"sequenceOffsetForRV","paragraph_zero_based":30954},{"literal_text_all_w_t_and_m_t":"For slot-based repetition scheme, selected RV sequence is applied to transmission occasions associated to the first TCI state. The RV sequence associated to the second TCI state is determined by a RV offset from that selected RV sequence.","paragraph_zero_based":30955},{"literal_text_all_w_t_and_m_t":"slotBased","paragraph_zero_based":30956},{"literal_text_all_w_t_and_m_t":"Configures UE with slot-based repetition scheme. Network always configures this field when the parameter repetitionNumber is present in IE PDSCH-TimeDomainResourceAllocationList. The network does not set this field to release. Upon reception of this field in RepetitionSchemeConfig-r16, the UE shall release fdm-TDM if previously configured in the same instance of RepetitionSchemeConfig-r16.","paragraph_zero_based":30957},{"literal_text_all_w_t_and_m_t":"startingSymbolOffsetK","paragraph_zero_based":30958},{"literal_text_all_w_t_and_m_t":"The starting symbol of the second transmission occasion has K symbol offset relative to the last symbol of the first transmission occasion. When UE is configured with tdmSchemeA, the parameter startingSymbolOffsetK is present, otherwise absent.","paragraph_zero_based":30959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb44228640561f1d30f732d972452e8558c21622b9ef3d1223a4cc54ea98b456","af5074b260544ab937c8527ebca9d702744b6ed1843501602b1ab46c99c05e9f","a4c5a91ce69cb0ac27e9e31b98f55e1eea239b8602542635bb538bf18009bf5b","6e93b480946c2c43bf4c34bd3d6948a5