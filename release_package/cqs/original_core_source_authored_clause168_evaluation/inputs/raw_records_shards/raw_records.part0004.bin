{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide MUSIM assistance information according to 5.7.4.2 or 5.3.5.3:","paragraph_zero_based":7896},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM periodic gap(s):","paragraph_zero_based":7897},{"literal_text_all_w_t_and_m_t":"3>include musim-GapPreferenceList with an entry for each periodic gap the UE prefers to be configured;","paragraph_zero_based":7898},{"literal_text_all_w_t_and_m_t":"4>set musim-GapLength and musim-GapRepetitionAndOffset in the musim-GapInfo IE to the values of the length and the repetition/offset of the gap(s), respectively, the UE prefers to be configured with;","paragraph_zero_based":7899},{"literal_text_all_w_t_and_m_t":"4>if UE has a preference for MUSIM gap priority;","paragraph_zero_based":7900},{"literal_text_all_w_t_and_m_t":"5>include the musim-GapPriorityPreferenceList the UE prefers to be configured;","paragraph_zero_based":7901},{"literal_text_all_w_t_and_m_t":"5>if the UE has preference to keep all colliding MUSIM gaps for periodic MUSIM gap(s):","paragraph_zero_based":7902},{"literal_text_all_w_t_and_m_t":"6>include the musim-GapKeepPreference;","paragraph_zero_based":7903},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for MUSIM aperiodic gap:","paragraph_zero_based":7904},{"literal_text_all_w_t_and_m_t":"3>include the field musim-GapPreferenceList, with one entry for the aperiodic gap the UE prefers to be configured;","paragraph_zero_based":7905},{"literal_text_all_w_t_and_m_t":"4>include musim-GapLength in the musim-GapInfo IE and set it to the values of the length of the gap the UE prefers to be configured with;","paragraph_zero_based":7906},{"literal_text_all_w_t_and_m_t":"4>optionally include musim-Starting-SFN-AndSubframe in the musim-GapInfo IE and set it to the starting SFN/subframe of the gap the UE prefers to be configured with;","paragraph_zero_based":7907},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for the periodic/aperiodic gaps:","paragraph_zero_based":7908},{"literal_text_all_w_t_and_m_t":"3>do not include musim-GapPreferenceList in the musim-Assistance IE;","paragraph_zero_based":7909},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference to leave RRC_CONNECTED state:","paragraph_zero_based":7910},{"literal_text_all_w_t_and_m_t":"3>set musim-PreferredRRC-State to the preferred RRC state.","paragraph_zero_based":7911},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference for MUSIM gap priority:","paragraph_zero_based":7912},{"literal_text_all_w_t_and_m_t":"3>include the musim-GapPriorityPreferenceList the UE prefers to be configured;","paragraph_zero_based":7913},{"literal_text_all_w_t_and_m_t":"3>if the UE has preference to keep all colliding MUSIM gaps for periodic MUSIM gap(s):","paragraph_zero_based":7914},{"literal_text_all_w_t_and_m_t":"4>include the musim-GapKeepPreference;","paragraph_zero_based":7915},{"literal_text_all_w_t_and_m_t":"2>if UE has a preference for temporary capability restriction:","paragraph_zero_based":7916},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference for serving cell(s) and/or SCG to be released:","paragraph_zero_based":7917},{"literal_text_all_w_t_and_m_t":"4>include the musim-Cell-SCG-ToRelease;","paragraph_zero_based":7918},{"literal_text_all_w_t_and_m_t":"5>set musim-CellToRelease to include the serving cell(s) the UE prefers to be released;","paragraph_zero_based":7919}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["21b561574c49480ddb6b9b524c5d2124b394b797bcb629cb9687dcf37ddff8db","3cd06727ea591446a3d480601372eb94f3eea520e8406d6f6a8a20d4ba622992","8c5342fc6470d9434adfa5abf37bd6a1bcfdcc6f8b5d749f75ed95c5ec4221de","af7eb4103375aad398d1a5f6a42b61f346aa5787d9ed41b430ce7f1ae0aee452","41e408758dc485e86047b94e9d99b28514dd9410f697faadacad4bf84bdc2cdc","667a42a2b4c42a07e2383e9dfde2ce6457fe113582e2a261943e12d70acb27b7","91943f48402ac7bd8d51fc9b2559ddd167d4c65f27c02ec52cc052678c228d51","b3a32433307da4a0576f9f8c289c3065319afb163c6fa4fe988778be7c6db405","e19ce3a584bd8e4c5e1d007222dbd475aa203f5f578d914eb5a9e33f906768e1","4f670a3707a4789ff51805edee975cf573ae40951325e69de9307fc0d7ee912c","74e626b2fd5e4cc6aed7fa4c1c1122fc600937f8acb95128c3fe16040193525f","8a756c5f9371a117af235771fc0ff787a9c21cd03e8afa3497e94474925923b7","97d93a726c5722d06ce0b62b8964a395bc9bf64b813afd2645a17b4daea329ef","cc5a281bef700d05d774c6d530260ac7edb55b82f6bc07e7b80773284e5be979","057e754213277f4754221a53cdde99baf334aaabc06d30d49ca1c0e24bd41644","8bb50b5f8ccf5a9b782a2328eaac9f27aa41f07cc4640c68e959d8f086e44e80","5257260aa4ad9d723f1bdbdd14a1db447197f6f265ba49e51c7e068361b73a5f","f488f2fb55aa44c7c1f1ae3dda43751c63e675ef30139f133093cc12afc051fa","93a40556d0e7996be20d8c6f87d558bd778be4cf2c5843c781d2ea6297a52a81","e887bc7e30c488777ac6550e1c43a542bdf72f9847412fd5911074517b78372f","bf196d0b33b0cb578299167556bf8b5e865ee207cba871a9d37f677372c1c792","4758703fcb0da2238803e3323c608f1d2c1278ef2e3ac7ade96e3f992eb5703c","e3ec39285e9645cf6060b23c3d285ad7ad391454622915cba9651e77c56d7c42","435c4241f0c69aae7d3852d1b671f9e45e508d4b931176e3b4d636c6f7099925"],"paragraph_range_zero_based":[7896,7919],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7896"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>set scg-ReleasePreference to scgReleasePreferred if the UE prefers the SCG to be released;","paragraph_zero_based":7920},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate the serving cells with restricted capabilities:","paragraph_zero_based":7921},{"literal_text_all_w_t_and_m_t":"4>include the musim-CellToAffectList the UE prefers to be configured;","paragraph_zero_based":7922},{"literal_text_all_w_t_and_m_t":"5>include the musim-ServCellIndex and the musim-MIMO-Layers-DL/ musim-MIMO-Layers-UL/ musim-SupportedBandwidth-DL/ musim-SupportedBandwidth-UL for the corresponding serving cell;","paragraph_zero_based":7923},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate the maximum number of CCs:","paragraph_zero_based":7924},{"literal_text_all_w_t_and_m_t":"4>include the musim-caRestriction for the corresponding musim-MaxCC the UE prefers to be configured;","paragraph_zero_based":7925},{"literal_text_all_w_t_and_m_t":"5>include the the musim-MaxCC-DL/ musim-MaxCC-UL for the corresponding maximum number of CCs;","paragraph_zero_based":7926},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate band(s) and/or combination(s) of bands with capabilities restricted which comprise of the band(s) that is/are indicated in musim-CandidateBandList:","paragraph_zero_based":7927},{"literal_text_all_w_t_and_m_t":"4>include the musim-AffectededBandsList the UE prefer to be configured with capabilities restricted;","paragraph_zero_based":7928},{"literal_text_all_w_t_and_m_t":"5>include the musim-bandEntryIndex for each band or each band of the combination(s) for which capabilities are restricted;","paragraph_zero_based":7929},{"literal_text_all_w_t_and_m_t":"5>include the musim-CapabilityRestricted for the corresponding band;","paragraph_zero_based":7930},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference to indicate band(s) and/or combination(s) of bands to be avoided which comprise of band(s) that is indicated in musim-CandidateBandList:","paragraph_zero_based":7931},{"literal_text_all_w_t_and_m_t":"4>include the musim-AvoidedBandsList the UE prefers not to be configured;","paragraph_zero_based":7932},{"literal_text_all_w_t_and_m_t":"5>include the musim-bandEntryIndex for each band or each band of the combination(s) to be avoided;","paragraph_zero_based":7933},{"literal_text_all_w_t_and_m_t":"3>if UE has a preference for measurement gap requirement:","paragraph_zero_based":7934},{"literal_text_all_w_t_and_m_t":"4>if the TargetBandFilterNR-r16 of NeedForGapsConfigNR is configured:","paragraph_zero_based":7935},{"literal_text_all_w_t_and_m_t":"5>include the musim-NeedForGapsInfoNR to provide the measurement gap requirement information from the requestedTargetBandFilterNR-r16 of NeedForGapsConfigNR configuration in RRCResume message or RRCReconfiguration message of NR target bands the UE prefer to be configured;","paragraph_zero_based":7936},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":7937},{"literal_text_all_w_t_and_m_t":"5>include the musim-NeedForGapsInfoNR to provide the measurement gap requirement information   for all the supported bands;","paragraph_zero_based":7938},{"literal_text_all_w_t_and_m_t":"4>include the gap requirement information of intra-frequency measurement for each supported NR serving cell.","paragraph_zero_based":7939},{"literal_text_all_w_t_and_m_t":"2>if the UE has no longer preference for temporary capability restriction:","paragraph_zero_based":7940},{"literal_text_all_w_t_and_m_t":"3>do not include the corresponding temporary capability restriction preference in the musim-CapRestriction in the musim-Assistance IE;","paragraph_zero_based":7941},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of RLM measurements of a cell group according to 5.7.4.2:","paragraph_zero_based":7942},{"literal_text_all_w_t_and_m_t":"2>if the UE performs RLM measurement relaxation on the cell group according to TS 38.133 [14]:","paragraph_zero_based":7943}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d0a460df0c329968e61079c92c65041cf1b4ede0178fcdceec7f24ecd408e9f7","98aa880e59447d1401b04c07d63b4782b8a0815f2a3d25a6121304fae20f23fd","b3d6df4bb99961e735fb84ea949e146edb9e1f715efdead9438ab94c59fa004a","0c8a7e8786fafdf26b4f7d835ab3a4088bd7b550b85480ad3696dd2a5f3ba55a","33c63b5c7b8936a6a8b4afc4da40373063742c103b3a845a58c66e918c7e237f","41059d6e9e4c5e0acadb5b68604413400ef5902aeab15c2e60016c0b671f1285","b5b8db4efe8dc1009b8b46a32f10eb29511d8bd3438ac05e146976801efa475d","2d52572b13449ea8b6431fd3d72469cc73b0b9e9a53f43149bba2e8853729ba2","0295a990a8a21b19bb864c4430f411888f63156857a7b6fdc6facbdae245e964","473550f1627ae9ebe38f187cd3ecc06e03cadc7acb1c790031584dea38996e14","1c5e51451fe6ef269385736f34cc5c6d711070dc0fdda9f3a6ee98b942785c97","2c1875b36cef7bbc6ad959d330c5f9c771872aa9524c8c9111fa7198c863ed85","a13adb12b1cd3db14efe7408cf94790e5249807a0496f3988d30467dffd7fbcd","8c966a63bf8e9f5282130489f50ee438aba48db4348049753c9e9672bf157148","5555b4a449fcd8b74664516511a9ebc942d4873ba14ef825a50f7e97dc231b4c","367e73f079b9bbc9d6cfae4fa25ae4ec25cfefd9bca894a649f3828655b67032","99a4461676b2567c2c5b590283f827d03d0cf2df5f3bd25ee782b6bf0293ee9b","ef3debd02f6ec9dd134035f77560af72b00e23d9984a142e93cde45971bbfe3b","de0f42a428c95c9b17915f48d2d88931134a4a285a044e15edf1e7b67f16a938","1646fe7577819dbe27e63c2a43386b4fcb17425cd7d1da70a823f67e73386359","effc4bf9a3c2cc1639cc234424328607904b2b88d0f03db454228f133a3d8ef8","6e263d0cc4107af706485bf572df6b7bb1bdc4460248be145c2a9f0ed5cacad8","c689ba144b57ba2cbb6f17434c1ad9b70fb525f732e1ed6a1fdc87dfc8e50068","2c550268641217a5a33f7205196b327f1be63f5c7afe44a684640c123172fa47"],"paragraph_range_zero_based":[7920,7943],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7920"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to true;","paragraph_zero_based":7944},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7945},{"literal_text_all_w_t_and_m_t":"3>set the rlm-MeasRelaxationState to false;","paragraph_zero_based":7946},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the relaxation state of BFD measurements of a cell group:","paragraph_zero_based":7947},{"literal_text_all_w_t_and_m_t":"2>for each serving cell of the cell group:","paragraph_zero_based":7948},{"literal_text_all_w_t_and_m_t":"3>if the UE performs BFD measurement relaxation on this serving cell according to TS 38.133 [14]:","paragraph_zero_based":7949},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '1', where n is equal to the servCellIndex value + 1 of the serving cell;","paragraph_zero_based":7950},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":7951},{"literal_text_all_w_t_and_m_t":"4>set the n-th bit of bfd-MeasRelaxationState to '0', where n is equal to the servCellIndex value + 1 of the serving cell.","paragraph_zero_based":7952},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate availability of data mapped to radio bearers not configured for SDT according to 5.7.4.2:","paragraph_zero_based":7953},{"literal_text_all_w_t_and_m_t":"2>include the nonSDT-DataIndication in the UEAssistanceInformation message;","paragraph_zero_based":7954},{"literal_text_all_w_t_and_m_t":"2>include and set the resumeCause according to the information received from the upper layers, if provided.","paragraph_zero_based":7955},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication of preference for SCG deactivation according to 5.7.4.2:","paragraph_zero_based":7956},{"literal_text_all_w_t_and_m_t":"2>include scg-DeactivationPreference in the UEAssistanceInformation message;","paragraph_zero_based":7957},{"literal_text_all_w_t_and_m_t":"2>set the scg-DeactivationPreference to scgDeactivationPreferred if the UE prefers the SCG to be deactivated, otherwise set it to noPreference;","paragraph_zero_based":7958},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication that the UE has uplink data related to a deactivated SCG according to 5.7.4.2:","paragraph_zero_based":7959},{"literal_text_all_w_t_and_m_t":"2>include uplinkData in the UEAssistanceInformation message.","paragraph_zero_based":7960},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide an indication about whether the criterion for RRM relaxation for connected mode is fulfilled or not fulfilled:","paragraph_zero_based":7961},{"literal_text_all_w_t_and_m_t":"2>if the criterion for RRM measurement relaxation for connected mode is fulfilled:","paragraph_zero_based":7962},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to true;","paragraph_zero_based":7963},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":7964},{"literal_text_all_w_t_and_m_t":"3>set the rrm-MeasRelaxationFulfilment to false.","paragraph_zero_based":7965},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide the service link propagation delay difference between serving cell and neighbour cell(s) according to 5.7.4.2;","paragraph_zero_based":7966},{"literal_text_all_w_t_and_m_t":"2>include the propagationDelayDifference for each neighbour cell in the neighCellInfoList;","paragraph_zero_based":7967}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8f2e4d41bfe390020548f7532691196a9e68e23c36aae228ace611346a7cb0a0","dc67cefdf5a81ca09f51974b48a6734116bf350ba39eeed84e8bc3ee2503679f","4f6ecf7ca2db959fa42190c68dea577ae80df79621b787b3dac34074f5f293d8","e408118593b34a23ca54434b286d6a23dfd9df7e9a8ce0cd38def21989c879d9","fdbe074d615acffc9ee4e7edcac61524df29d1083898928cc727c0066b55c1a8","2e9751ad7ccf9c6dbdfd3563dbcd42920db7ec12dc6ef892ff75a92f086baf21","1b2c232b47158ad4ddb5e27bf38ea25932f2e0a7dac19f57dec0944de7f1c4e9","9d013a828941fcab18412026aa88b086627828c49a0b20b1406bf8c4877fe718","e5cb228fc34a75ad79a006a968d7b4f68cd1127d20e9a64950e0ed3cc68331fb","56146ee49e0b3b0690889ea0f532c34ca7c5f29c91d397d72a76a2d3fc8735fb","73bfb90083f2458cd7bec89017a6277fb516f40aab4746b4455b51d5bc218010","50d8c396a48934b90504c42449d3251703a161ef92db861e3aceac7de63fd846","1d62392b8b58e2da86b5cb59dab2f6a3cd8d323e5f29dfc4f2393dffb79a6258","1c7faf8d439eb79aa10498ebe9b20660f8d82a6aa46f5928230cc9c09d580ad8","464c964e83f1b7938ca880f6399c49df9166219d690707908a0a30263fb4d86d","f5f590a5e6052285e62850f2ab444ee3274a13fd5520e397d24725f444f27545","ce44b9d3d2b8d498505249a6baba9a5ced01afb71b1afa4144d440d6f4dc4c64","8fb8ea62300afb04a51508202377c810d606387ab43935f124c70fc62d83c105","f65e307d6c885891af8b72ea6238b53b492047b5036f85454a9904909c92f5e6","a5b0d95b22c0d8ffc5f4d64a3f73c6c2b4be3981d0510ce884e6eb218e3655de","b8d77a08ef36d4ccd025ddcb68f43e6ee8aa58fe107e2bed584c33f310c3a371","ae04489c7b7ed15ae718c9beb6f05cca6be08e5dcad6ae354d5d22eae9ac859c","1cd2c3b140b3cd3aa5f2cd9c339c14ad42d386d841f3801e98f9ce42ba1f9d7c","358455825647bb1db4b735b71bb998f7bfbbbdc77c565e5b485bbedfad0bb3fa"],"paragraph_range_zero_based":[7944,7967],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7944"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide preference on multi-Rx operation for FR2 according to 5.7.4.2:","paragraph_zero_based":7968},{"literal_text_all_w_t_and_m_t":"2>if the UE has a preference for not operating on multi-Rx (i.e. not supporting simultaneous reception with different QCL-typeD) for FR2:","paragraph_zero_based":7969},{"literal_text_all_w_t_and_m_t":"3>set multiRx-PreferenceFR2 to single;","paragraph_zero_based":7970},{"literal_text_all_w_t_and_m_t":"2>else (if the UE has the preference for operating on multi-Rx for FR2):","paragraph_zero_based":7971},{"literal_text_all_w_t_and_m_t":"3>set multiRx-PreferenceFR2 to multiple.","paragraph_zero_based":7972},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to indicate the availability of flight path information according to 5.7.4.2 or 5.3.5.3;","paragraph_zero_based":7973},{"literal_text_all_w_t_and_m_t":"2>include the flightPathInfoAvailable;","paragraph_zero_based":7974},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to provide UL traffic information according to 5.7.4.2:","paragraph_zero_based":7975},{"literal_text_all_w_t_and_m_t":"2>for each PDU session for which the UE intends to provide UL traffic information in this UEAssistanceInformation message:","paragraph_zero_based":7976},{"literal_text_all_w_t_and_m_t":"3>set pdu-SessionID to the value of the concerned PDU session ID;","paragraph_zero_based":7977},{"literal_text_all_w_t_and_m_t":"3>for each QoS flow of this PDU session for which timer T346l is not running and for which the UE intends to provide UL traffic information in this UEAssistanceInformation message:","paragraph_zero_based":7978},{"literal_text_all_w_t_and_m_t":"4>start timer T346l associated to this QoS flow with the timer value set to the value of ul-TrafficInfoProhibitTimer;","paragraph_zero_based":7979},{"literal_text_all_w_t_and_m_t":"4>set qfi to the value of the concerned QFI;","paragraph_zero_based":7980},{"literal_text_all_w_t_and_m_t":"4>if the jitter range measurement is available; and","paragraph_zero_based":7981},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide jitter range since it was configured to provide UL traffic information, or if the measured jitter range has changed since the last transmission of the UEAssistanceInformation message containing jitterRange:","paragraph_zero_based":7982},{"literal_text_all_w_t_and_m_t":"5>set jitterRange to the latest measured value of the jitter range;","paragraph_zero_based":7983},{"literal_text_all_w_t_and_m_t":"4>if the burst arrival time measurement is available; and","paragraph_zero_based":7984},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide burst arrival time since it was configured to provide UL traffic information, or if the measured burst arrival time has changed since the last transmission of the UEAssistanceInformation message containing burstArrivalTime:","paragraph_zero_based":7985},{"literal_text_all_w_t_and_m_t":"5>set burstArrivalTime to the latest measured value of the burst arrival time;","paragraph_zero_based":7986},{"literal_text_all_w_t_and_m_t":"4>if the traffic periodicity measurement is available; and","paragraph_zero_based":7987},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide traffic periodicity since it was configured to provide UL traffic information, or if the measured traffic periodicity has changed since the last transmission of the UEAssistanceInformation message containing trafficPeriodicity:","paragraph_zero_based":7988},{"literal_text_all_w_t_and_m_t":"5>set trafficPeriodicity to the latest measured value of the traffic periodicity;","paragraph_zero_based":7989},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide pduSetIdentification since it was configured to provide UL traffic information, or if the information previously provided in pduSetIdentification has changed since the last transmission of the UEAssistanceInformation message containing pduSetIdentification:","paragraph_zero_based":7990},{"literal_text_all_w_t_and_m_t":"5>if the UE is able to identify PDU Set(s) for the QoS flow:","paragraph_zero_based":7991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6c2d71faadc0f7db1a1dd5670c4d33fe1912aeb35349b7db27b54043e11f5f80","d64830fb6be6be1160394444e788e3f5055a6176171ce64f660328d5277c3f1e","0d60e47663a85ff3378493eccbb744487a64c77b725ca13b0c92a4e6882c72aa","a3211328583011476dbc4c6cc767ff10ae2d81f33f0a46bde3cf414cf915edca","30f71668740a6cc8e2b8a04fa111e2eb618c066028cdf51e14135551fc62958a","b90ce04c2badf2f99ddde22e66913f31941553d103d9c7cfef61dace2a075c15","e34b0a9e427ce6d217ff5d02cba9f8c2408a2a65ca01d097cdfe552f0ef5cedb","31df013805399e0db21845ffa8c08666639ececa8c399515f07a021b1d9e92a9","72b0b888a336eeae77cff08923dcbd7f1f43f2b5a74580a4cbe4b7c3b45dcffa","4bf9004c09266a12bb36542b1b2eb97adafce630b6a47f9054e8646e3f04ba5d","bb9ad70b2939f5a7402f18fc2764fbff3eaf187c9b117561a753c3be83a75d22","e279880406a9a801564dd7a1803bde887c65266aef6a3b9ad6f7b37c950a04ab","9b7df2be5a039b84e7ddb2bd0e67b73de42a94fd40495984041497cb4ce27714","bbf94c340d3b1386bbf1c2d5e73098fa06dcedb1a67e0532076876887c03bf20","bde989851473a144d44f9fc284a314d2f5e77f65d20f5d06fe06d1cfed7c2918","c84d80d294d96a0397ee59fc3113d12c3357bef6f818ee8ca46ea78a75832768","b2ec15f673f48c07fbaa4f3a34d31e1459a557b549717e0287d263f26565e19c","ceee605c3b558e17cc80e65ade4b6bf87fdf8d18a5a9d292b22b4b52c5e0f720","bc889b9a16c8b4bfd087b277978868bc80206ad9a741cda19b563f1f4de0c750","88e13b89c088067c5ac8695f40f365b2e04bc34a6b0a1001550a724ca04c2784","07eb5d7c1a3d07952d9543fb29bdd9f7dd8dad5f790ffbea0cc35e78ddf8d5fb","8c608705d7f35dc07658dcb0c6cf0aab1fe26b9308435e3e447f02ff70a0a4a8","7c37589d98cd467249603b5b83b1401d2c4f0fc7c5c02c7678195c46375b9289","1fca5f9873747325e4c05c6b181e140e41754a62e220ad490ae6ef30d20c5234"],"paragraph_range_zero_based":[7968,7991],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p7968"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"6>set pduSetIdentification to true;","paragraph_zero_based":7992},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":7993},{"literal_text_all_w_t_and_m_t":"6>set pduSetIdentification to false.","paragraph_zero_based":7994},{"literal_text_all_w_t_and_m_t":"4>if the UE did not provide psiIdentification since it was configured to provide UL traffic information, or if the information previously provided in psiIdentification has changed since the last transmission of the UEAssistanceInformation message containing psiIdentification:","paragraph_zero_based":7995},{"literal_text_all_w_t_and_m_t":"5>if the UE is able to identify PSI(s) for the QoS flow:","paragraph_zero_based":7996},{"literal_text_all_w_t_and_m_t":"6>set psiIdentification to true;","paragraph_zero_based":7997},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":7998},{"literal_text_all_w_t_and_m_t":"6>set psiIdentification to false.","paragraph_zero_based":7999},{"literal_text_all_w_t_and_m_t":"1>if transmission of the UEAssistanceInformation message is initiated to report relay UE information with non-3GPP connection(s) according to 5.7.4.2:","paragraph_zero_based":8000},{"literal_text_all_w_t_and_m_t":"2>include n3c-relayUE-InfoList in the UEAssistanceInformation message;","paragraph_zero_based":8001},{"literal_text_all_w_t_and_m_t":"The UE shall set the contents of the UEAssistanceInformation message for configured grant assistance information for NR sidelink communication or NR sidelink positioning:","paragraph_zero_based":8002},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink:","paragraph_zero_based":8003},{"literal_text_all_w_t_and_m_t":"2>include the sl-UE-AssistanceInformationNR;","paragraph_zero_based":8004},{"literal_text_all_w_t_and_m_t":"1>if configured to provide configured grant assistance information for NR sidelink positioning:","paragraph_zero_based":8005},{"literal_text_all_w_t_and_m_t":"2>include the sl-PRS-UE-AssistanceInformationNR;","paragraph_zero_based":8006},{"literal_text_all_w_t_and_m_t":"NOTE 4:It is up to UE implementation when and how to trigger configured grant assistance information for NR sidelink communication or NR sidelink positioning.","paragraph_zero_based":8007},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8008},{"literal_text_all_w_t_and_m_t":"1>if the procedure was triggered to provide configured grant assistance information for NR sidelink communication by an NR RRCReconfiguration message that was embedded within an E-UTRA RRCConnectionReconfiguration:","paragraph_zero_based":8009},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation to lower layers via SRB1, embedded in E-UTRA RRC message ULInformationTransferIRAT as specified in TS 36.331 [10], clause 5.6.28;","paragraph_zero_based":8010},{"literal_text_all_w_t_and_m_t":"1>else if the procedure was triggered to provide UE preference for SCG deactivation or to indicate that the UE with a deactivate SCG has uplink data to send on a DRB for which there is no MCG RLC bearer:","paragraph_zero_based":8011},{"literal_text_all_w_t_and_m_t":"2>submit the UEAssistanceInformation via SRB1 to lower layers for transmission;","paragraph_zero_based":8012},{"literal_text_all_w_t_and_m_t":"1>else if the UE is in (NG)EN-DC:","paragraph_zero_based":8013},{"literal_text_all_w_t_and_m_t":"2>if SRB3 is configured and the SCG is not deactivated:","paragraph_zero_based":8014},{"literal_text_all_w_t_and_m_t":"3>submit the UEAssistanceInformation message via SRB3 to lower layers for transmission;","paragraph_zero_based":8015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e777c70a93ef70cdd1e45c1b7157fffe38aa26c7c8ceef953d606627f9349418","b300cc7e532a009854f5d842d5a970d2df1fa17a42430275c9fca3778cbca8a2","c151696f37a0b9664f86c209914a6799ad5b6649d1347e0e14832a84724a72ee","3b4702b224828ee29983a7d10bb2d89e8df6d243dde12287062db4f619876447","05d1907ceff084a75abc9560155a99368f39dac249725b13f19a5c645292ea93","86a089db57556bde6c16026fc60c3409a0fef7ec9eb31a6b02e6273831426ffd","f7656b6b1fedbf2c8882588fa00c7b5ef93ea03ecdc3bb5a8b57b422b5bbe52a","579e700dfe170af1f3accc3c41ac818dd2c9a17d54fe6ce43487e891ecd531e6","24799514132dc64cc6a8768269e309e2ea5b80b774b2c5b0b0ed1ba059b31226","4c8c95670112e3b8b2f483e9a630cb0e12cee31de879d10e5a2f3009ce97949d","105c74e990da049ae29857feb40cb6b6415954542ef02bafd1440f05a2d966d4","f32ec1e09b6473c362ad33453a02d852f2be1d49bfaf45fc317d9b0ac59f0210","2480c38663863201549823041520868a28201e83c6895b173a0dbba6f9150408","48c6854b92c039bb5f742c9a9dc19b2382912419930147ea46a9c1641363a442","f2d071ead4300639c84a34d2d13cdb232da9391f309a80c2c04e7de62ee0c869","b833112ba997c037815b4708b1afbbd9337cd1233119fd8dfd2f197d9deeac45","becfe7cf082b873155e49a91c825aad19bab5ec458d2d205281dade101fb42a3","d5b422bf924852ed44fc8c7daead8f108c1501aa0ec14ea886a9acd5a3f23daa","6e711ccccfbe1ae3fa57deab73be409cbcb3ce2653e99e094a7e552c123e2299","67eb2a592d02ff6974ed83aa743f9f7f9b6d9c0f59a6f0e3d32dfed7a74028e7","a3a7f45807d393d5938d363912277dd8b295be652ff524e7b565cfc6512c9656","e67423467e74793410d2288e0c904ab367dad17c9f2680f91e86773b8b5f013d","3e62359deab829d216ada90bd0a43f5e20d92522526c9c2e5fbe647256ccf29b","d542d8142222f691c83c67caf8fbec840b6706273c3dd3683a77584e762ecb1f"],"paragraph_range_zero_based":[7992,8015],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"