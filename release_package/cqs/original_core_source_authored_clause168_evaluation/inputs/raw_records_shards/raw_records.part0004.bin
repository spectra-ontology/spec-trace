{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SUL","paragraph_zero_based":30432},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in rach-ConfigCommon in initialUplinkBWP if supplementaryUplink is configured in ServingCellConfigCommonSIB or if supplementaryUplinkConfig is configured in ServingCellConfigCommon; otherwise, the field is absent. This field is not configured in additionalRACH-Config.","paragraph_zero_based":30433},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30434},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigCommonTwoStepRA","paragraph_zero_based":30435},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigCommonTwoStepRA is used to specify cell specific 2-step random-access type parameters.","paragraph_zero_based":30436},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA information element","paragraph_zero_based":30437},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30438},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGCOMMONTWOSTEPRA-START","paragraph_zero_based":30439},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30440},{"literal_text_all_w_t_and_m_t":"RACH-ConfigCommonTwoStepRA-r16 ::=                   SEQUENCE {","paragraph_zero_based":30441},{"literal_text_all_w_t_and_m_t":"    rach-ConfigGenericTwoStepRA-r16                      RACH-ConfigGenericTwoStepRA-r16,","paragraph_zero_based":30442},{"literal_text_all_w_t_and_m_t":"    msgA-TotalNumberOfRA-Preambles-r16                   INTEGER (1..63)                                    OPTIONAL, -- Need S","paragraph_zero_based":30443},{"literal_text_all_w_t_and_m_t":"    msgA-SSB-PerRACH-OccasionAndCB-PreamblesPerSSB-r16   CHOICE {","paragraph_zero_based":30444},{"literal_text_all_w_t_and_m_t":"        oneEighth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30445},{"literal_text_all_w_t_and_m_t":"        oneFourth                                            ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30446},{"literal_text_all_w_t_and_m_t":"        oneHalf                                              ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30447},{"literal_text_all_w_t_and_m_t":"        one                                                  ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32,n36,n40,n44,n48,n52,n56,n60,n64},","paragraph_zero_based":30448},{"literal_text_all_w_t_and_m_t":"        two                                                  ENUMERATED {n4,n8,n12,n16,n20,n24,n28,n32},","paragraph_zero_based":30449},{"literal_text_all_w_t_and_m_t":"        four                                                 INTEGER (1..16),","paragraph_zero_based":30450},{"literal_text_all_w_t_and_m_t":"        eight                                                INTEGER (1..8),","paragraph_zero_based":30451},{"literal_text_all_w_t_and_m_t":"        sixteen                                              INTEGER (1..4)","paragraph_zero_based":30452},{"literal_text_all_w_t_and_m_t":"    }                                                                                                                   OPTIONAL, -- Cond 2StepOnly","paragraph_zero_based":30453},{"literal_text_all_w_t_and_m_t":"    msgA-CB-PreamblesPerSSB-PerSharedRO-r16              INTEGER (1..60)                                                OPTIONAL, -- Cond SharedRO","paragraph_zero_based":30454},{"literal_text_all_w_t_and_m_t":"    msgA-SSB-SharedRO-MaskIndex-r16                      INTEGER (1..15)                                                OPTIONAL, -- Need S","paragraph_zero_based":30455}],"source":"Whole authentic original CR source member; all unfiltered body and neste