{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22608},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell ::= SEQUENCE {","paragraph_zero_based":22609},{"literal_text_all_w_t_and_m_t":"    servingCellId                       ServCellIndex,","paragraph_zero_based":22610},{"literal_text_all_w_t_and_m_t":"    positionInDCI                       INTEGER (0..maxINT-DCI-PayloadSize-1)","paragraph_zero_based":22611},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22612},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22613},{"literal_text_all_w_t_and_m_t":"-- TAG-DOWNLINKPREEMPTION-STOP","paragraph_zero_based":22614},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22615},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22616},{"literal_text_all_w_t_and_m_t":"DownlinkPreemption field descriptions","paragraph_zero_based":22617},{"literal_text_all_w_t_and_m_t":"dci-PayloadSize","paragraph_zero_based":22618},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with INT-RNTI (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":22619},{"literal_text_all_w_t_and_m_t":"int-ConfigurationPerServingCell","paragraph_zero_based":22620},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the 14 bit INT values inside the DCI payload (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":22621},{"literal_text_all_w_t_and_m_t":"int-RNTI","paragraph_zero_based":22622},{"literal_text_all_w_t_and_m_t":"RNTI used for indication pre-emption in DL (see TS 38.213 [13], clause 10).","paragraph_zero_based":22623},{"literal_text_all_w_t_and_m_t":"timeFrequencySet","paragraph_zero_based":22624},{"literal_text_all_w_t_and_m_t":"Set selection for DL-preemption indication (see TS 38.213 [13], clause 11.2) The set determines how the UE interprets the DL preemption DCI payload.","paragraph_zero_based":22625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22626},{"literal_text_all_w_t_and_m_t":"INT-ConfigurationPerServingCell field descriptions","paragraph_zero_based":22627},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":22628},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the 14 bit INT value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2). Must be multiples of 14 (bit).","paragraph_zero_based":22629},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22630},{"literal_text_all_w_t_and_m_t":"–DRB-Identity","paragraph_zero_based":22631}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8d494bdd6fd423a8d29351e8b105213438d81c541fd7702fe2f07c8c3821b731","9cd18b02c384fbda663f92dfc85b07471773c00a2c18299000d5f0cf98252c5d","339aa6ff99f56a66626256561c7ca34b0975ab8f45096cced4ee16467759265b","08122913d72db3e42ce4608a395730f02d3a8e86cf29388d9d8b620713f751e2","f396136d98326ef6ea69a69ed621f73d60ef40c28711f585cd41f062d2951b4b","c52ea4a82c7a87a3a9736ff1d42b8274be028a2ff97671c27d461eafa25a7697","f4b39e49dd365aa598a8724d14f74614bb7ee08af69152f07d03f72d21714fe8","dd745133df8da063d1028d3293e3b29475117c767746c03ed637c4deac76e21c","f28fe400c7a348cd155c8a8395837465dd7bd0fd2419b558dbdded7dcba40cf7","008db3b48875e5daeac0f79d6ace3b5cf27b491cca2fe553cb4338d36095121f","9a9e9a1c5631411ca9057e1d1315fc71720287a58954fe82302c5fa289c321c6","02a588c937fef2fffce50a9229afe5e2288061f5b24d95f72aba9b56ce09a5c2","7e9c1936654f596c8d02a28b5925a3cc00eb12f9e15ee419dc518b380ff7a316","f1e