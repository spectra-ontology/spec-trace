{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1080},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-ReportConfig-r16 ::= SEQUENCE {","paragraph_zero_based":1081},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSTD-MeasurementsPerTRP-Pair-r16INTEGER (1..4)OPTIONAL, -- Need ON","paragraph_zero_based":1082},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor-r16INTEGER (0..5)OPTIONAL, -- Need ON","paragraph_zero_based":1083},{"literal_text_all_w_t_and_m_t":"...,","paragraph_zero_based":1084},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1085},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs-r17","paragraph_zero_based":1086},{"literal_text_all_w_t_and_m_t":"ENUMERATED { n0, n2, n3, n4, n6, n8, ... }","paragraph_zero_based":1087},{"literal_text_all_w_t_and_m_t":"OPTIONAL, -- Need ON","paragraph_zero_based":1088},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples-r17ENUMERATED { requested, ... }OPTIONAL, -- Need ON","paragraph_zero_based":1089},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2-r17ENUMERATED { requested }OPTIONAL  -- Need ON","paragraph_zero_based":1090},{"literal_text_all_w_t_and_m_t":"]],","paragraph_zero_based":1091},{"literal_text_all_w_t_and_m_t":"[[","paragraph_zero_based":1092},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactorExt-r18INTEGER (-6..-1)OPTIONAL, -- Need ON","paragraph_zero_based":1093},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig-r18","paragraph_zero_based":1094},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-MeasurementTimeWindowsConfig-r18OPTIONAL  -- Need ON","paragraph_zero_based":1095},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1096},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1097},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1098},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":1099},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1100},{"literal_text_all_w_t_and_m_t":"NR-DL-TDOA-RequestLocationInformation field descriptions","paragraph_zero_based":1101},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RstdMeasurementInfoRequest","paragraph_zero_based":1102},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device is requested to report DL-PRS Resource ID(s) or DL-PRS Resource Set ID(s) used for determining the timing of each TRP in RSTD measurements. ","paragraph_zero_based":1103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["2fd042fc9eaff1f91aaa048e250f8dfbaa0e9651239fb06f7343114e400a211a","4bb7a16d92cd4209c0fb70c431ad908840fa095e1b8e713ecd5bf57567f52ef0","f411c6a2a9c0a461b9b23b5feadd116d00df91f2841b143173032aa8e695a5be","19d89e4e329f6d1ba7788d38f9258c46b07007eba0f4241447b4cc1e788a8125","8eb1374f11e836e7a8d28f2c4ba3434eb6ad5f9cc6059e701de67474ae32fff9","6e88f25cd5671cc299063c3dcd0d620cdcd353b6c1acaaac450cb1608952a92f","f6cb34e14cc45882f738bea8ae21fc657534993efd08193f5a908f6ed27cc647","4e9aa05a1b56fb64eea5dbbe05a051d78f6c7a2e8f53cba1dc6475c1d69bb193","f49738a038bd1443702bb99c808866c97202d4f492716f2059e59540583b5467","c1f7a5a236d4106923ccca031b2792c5dde218b6c05b653df2489c6f11c97530","a5948dcf2d6b0bcc18fa3a7ce6300bf97e736d2e677ab300b533779ac2deab9f","d742fe7006e93b7eff940a520f0ff431c6db6053773be374533a6faea0d1ca51","35d20b37d99db65df239651874f9f6b3ff183724b676c07782edaac866f1c849","18c2541a7b2107f761fe75c11f06c9199d906585c955ded934ed063cfc5784e4","94047bb62c2014c8a334d645cf7cb514bdaf6277dd5fb9c3ddee37fd887905e5","23f1eab5a6e353f3340173458324917dcc10d18a99862887677cd34eabe056be","ee1202292204288e8310e70c3bd15144f63d33232784e13f4859aeb1f78e1b8e","6a9b50fdb1315ced2e0f1db349ae043f80d7748d2e4ef38d7dc6dcd1a2fe7022","0391ff5bf8536801047ea638b7cd334bbcd0d4198770eef95c5cefeaef0ed763","fc7a132ae0fa52c1fe4f97a857b2f01401c3e13a016da8916f2e8ef038e6cd52","852480051066c9d97b9fa4f7d53ffa691d842d54fb84d938d3c53059a06ad580","4a316317a574b9c42d3f3a662e13442b72cc0d01b353e885ae8663827f4ff192","ba8e8d6d2aa5cf50f07d43de91ad61154ce4d8af2337e1a65d72d9c14d39f9d6","f6ecba072d8493668486b5162abcb9e529f5c259347d128844ac653b902e2d3d"],"paragraph_range_zero_based":[1080,1103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1080"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-RequestedMeasurements","paragraph_zero_based":1104},{"literal_text_all_w_t_and_m_t":"This field specifies the NR DL-TDOA measurements requested. This is represented by a bit string, with a onevalue at the bit position means the particular measurement is requested; a zerovalue means not requested. The dl-PRS-RSCPD-Request means that the target device is requested to provide DL RSCPD measurement.","paragraph_zero_based":1105},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability","paragraph_zero_based":1106},{"literal_text_all_w_t_and_m_t":"This field indicates whether the target device may request additional DL-PRS assistance data from the server. TRUE means allowed and FALSE means not allowed.","paragraph_zero_based":1107},{"literal_text_all_w_t_and_m_t":"additionalPaths","paragraph_zero_based":1108},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathList in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPathsExt shall be absent.","paragraph_zero_based":1109},{"literal_text_all_w_t_and_m_t":"nr-UE-RxTEG-Request","paragraph_zero_based":1110},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-UE-Rx-TEG-ID in IE NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":1111},{"literal_text_all_w_t_and_m_t":"nr-los-nlos-IndicatorRequest","paragraph_zero_based":1112},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the indicated type and granularity of the estimated LOS-NLOS-Indicator in the NR-DL-TDOA-SignalMeasurementInformation.","paragraph_zero_based":1113},{"literal_text_all_w_t_and_m_t":"additionalPathsExt","paragraph_zero_based":1114},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-AdditionalPathListExt in IE NR-DL-TDOA-SignalMeasurementInformation. If this field is present, the field additionalPaths shall be absent.","paragraph_zero_based":1115},{"literal_text_all_w_t_and_m_t":"additionalPathsDL-PRS-RSRP-Request","paragraph_zero_based":1116},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide the nr-DL-PRS-RSRPP for the additional paths in fields nr-AdditionalPathList or nr-AdditionalPathListExt.","paragraph_zero_based":1117},{"literal_text_all_w_t_and_m_t":"multiMeasInSameReport","paragraph_zero_based":1118},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to provide multiple measurement instances in a single measurement report; i.e., include the nr-DL-TDOA-SignalMeasurementInstances (in the case of UE-assisted mode is requested) or nr-DL-TDOA-LocationInformationInstances (in the case of UE-based mode is requested) in IE NR-DL-TDOA-ProvideLocationInformation.","paragraph_zero_based":1119},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequest","paragraph_zero_based":1120},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to perform joint measurement across aggregated PFLs. ","paragraph_zero_based":1121},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-JointMeasurementRequestedPFL-List","paragraph_zero_based":1122},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the target device is requested to perform joint measurements on the indicated two or three PFLs. Value 0 corresponds to the first frequency layer provided in nr-DL-PRS-AssistanceDataList, value 1 to the second frequency layer in nr-DL-PRS-AssistanceDataList, and so on.","paragraph_zero_based":1123},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingRequest","paragraph_zero_based":1124},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use DL-PRS Rx hopping for performing RSTD, RSRP (if requested in nr-RequestedMeasurements), or RSRPP measurements (if requested in nr-RequestedMeasurements) and report the hopping information used for performing the measurements. This field is not included when dl-PRS-RSCPD-Request or nr-DL-PRS-JointMeasurementRequest is included.","paragraph_zero_based":1125},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-RxHoppingTotalBandwidth","paragraph_zero_based":1126},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates the total bandwidth in MHz across all hops for the DL-PRS measurement. If the configured value nr-DL-PRS-RxHoppingTotalBandwidth is larger than the configured DL-PRS bandwidth in the provided assistance data, the UE shall assume that the actual nr-DL-PRS-RxHoppingTotalBandwidth is equal to the width of the configured DL-PRS in the provided assistance data. ","paragraph_zero_based":1127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["6f9923e4ad9e370a60d10c543e630ba4a10fe465f372c4a61d1816c26ecf5b36","23223b81aaadf244146b57321e313a21f8de9a0b937e64e6b3c3e47cd89791ff","5e12c6b469733d73d24aa423caa83476338cba29063d09e2444e9b0a015e2844","e857241d10c232e1e5f6e1293eba9e1f7fbf20b204d9e7597faa1f75c1922856","0303b16d0710e8f35a2eb43067e8ae2b0a6b3f1e6a185eb40b980108fcc5a6d8","14dd2856159b3f3061da99c0a1b248271934a47b2e3544b23180099b12f6d575","7e5972ed664385ec301803b4b91665373e8c3fa0921cbde91de5106a83a21a9c","8337af42783e9d5b423e2c782b374177988d007ee870e7eab4ae1e9916726514","c5b0eb9f93eaaf1b8be33c143d764e35b49b8465028412e3ea9fc17ba3df1c58","0595f69f608ffb515c3ed6e3350b8a5b73a02579729977afc1201450e321e3bb","325934f1cedb37246b692712c434016882469c95fc7ab6b87793ef379fa64f05","967388b3f98ba8479c99ff9fefcb4e63b4b0d1e52333ed7adc229f6122f45d8c","f39624d305cbc8be7779f8da2a2d5747c20b4a4ca88defe7efa77597c31b9612","cb1e3d003ff9766a9445d25c81c894082b316afce0d4c64e582a4292a79df775","11a094888f169ecd2e1aec6c77976b701cc56b2c5db4342ebebc06df1cc9f517","9eb2a4b984b1c9c4adeff28f6511f9b8daf7e0d10b2c66706b37ff6f5b93f2d5","46bbe4835533463bd1246ea6b5c1a98c237eb4144f8f67dbb4d2f0dbe4663d3c","13842886e0e74f235cae085148b09352aef2bb842014b00e5126e4797f1e3b1a","78c14ccde8a0e3c88514070492dd4093360c487865347c9e1af06596b868ecf4","1b1a9807346ecedfed2cb851f08ea2d3e1c24bf5e6eb20b553963550d0bac8f7","c30d7986c085dffba25b4f0a64d4734a820aa77b63444ea4709d3cae07557667","8bae62f26be6fef4630d477d482758d408d45dabac10fce295c881f3466f1ad2","ed79e6f26b1e82d0c01fc9068025a6dae400d1a102bca9d1e4b8ba3e2b691d14","a7593a7143cae374c5a11ad9838d371d6c43fb8b02427d7e5cf84c6268cdde35"],"paragraph_range_zero_based":[1104,1127],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx:p1104"}
{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1129},{"literal_text_all_w_t_and_m_t":"maxDL-PRS-RSTD-MeasurementsPerTRP-Pair","paragraph_zero_based":1130},{"literal_text_all_w_t_and_m_t":"This field specifies the maximum number of DL-PRS RSTD measurements per pair of TRPs. The maximum number is defined across all Positioning Frequency Layers. When requested for aggregated measurements by the location server, this field specifies the maximum number of aggregated DL-PRS RSTD measurements per pair of TRPs. The maximum number is defined across all Positioning Frequency Layers.","paragraph_zero_based":1131},{"literal_text_all_w_t_and_m_t":"timingReportingGranularityFactor, timingReportingGranularityFactorExt","paragraph_zero_based":1132},{"literal_text_all_w_t_and_m_t":"This field specifies the recommended reporting granularity for the DL RSTD measurements. Value (0..5) corresponds to (k0..k5) and value (-6..-1) corresponds to (kMinus6..kMinus1) used for nr-RSTD and nr-RSTD-ResultDiff in NR-DL-TDOA-MeasElement. The UE may select a different granularity value for nr-RSTD and nr-RSTD-ResultDiff. The timingReportingGranularityFactorExt should not be included by the location server and shall be ignored by the target device if timingReportingGranularityFactor is included.The timingReportingGranularityFactor should not be included by the location server and shall be ignored by the target device if timingReportingGranularityFactorExt is included.","paragraph_zero_based":1133},{"literal_text_all_w_t_and_m_t":"measureSameDL-PRS-ResourceWithDifferentRxTEGs","paragraph_zero_based":1134},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with N different UE Rx TEGs. Enumerated value 'n0' indicates that the number N of different UE Rx TEGs to measure the same DL-PRS Resource can be determined by the target device, value 'n2' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 2 different UE Rx TEGs, value 'n3' indicates that the target device is requested to measure the same DL-PRS Resource of a TRP with 3 different UE Rx TEGs, and so on.","paragraph_zero_based":1135},{"literal_text_all_w_t_and_m_t":"If this field is present, the field nr-UE-RxTEG-Request should also be present. When the location server requests aggregated measurements, the target device is requested to measure the same aggregated DL-PRS Resources of a TRP with N different UE Rx TEGs.","paragraph_zero_based":1136},{"literal_text_all_w_t_and_m_t":"reducedDL-PRS-ProcessingSamples","paragraph_zero_based":1137},{"literal_text_all_w_t_and_m_t":"This field, if present and set to 'requested', indicates that the target device is requested to perform the requested measurements with reduced number of samples (M=1 or M=2) as specified in TS 38.133 [46]. When requested for aggregated measurements by the location server, this field indicates processing of reduced number of samples for the aggregated measurements.","paragraph_zero_based":1138},{"literal_text_all_w_t_and_m_t":"lowerRxBeamSweepingFactor-FR2","paragraph_zero_based":1139},{"literal_text_all_w_t_and_m_t":"This field, if present, indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability. When requested for aggregated measurements by the location server, this field indicates that the target device is requested to use a lower Rx beam sweeping factor than 8 for FR2 according to UE's capability for the aggregated measurements.","paragraph_zero_based":1140},{"literal_text_all_w_t_and_m_t":"nr-DL-PRS-MeasurementTimeWindowsConfig","paragraph_zero_based":1141},{"literal_text_all_w_t_and_m_t":"This field indicates DL-PRS Resource Set(s) occurring within time window(s) for performing measurements where the time window is indicated by a start time, periodicity, offset and duration.","paragraph_zero_based":1142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1143},{"literal_text_all_w_t_and_m_t":"NEXT CHANGE","paragraph_zero_based":1144},{"literal_text_all_w_t_and_m_t":"6.5.11.5NR DL-AoD Location Information Request","paragraph_zero_based":1145},{"literal_text_all_w_t_and_m_t":"–NR-DL-AoD-RequestLocationInformation","paragraph_zero_based":1146},{"literal_text_all_w_t_and_m_t":"The IE NR-DL-AoD-RequestLocationInformation is used by the location server to request NR DL-AoD location measurements from a target device.","paragraph_zero_based":1147},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":1148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1149},{"literal_text_all_w_t_and_m_t":"NR-DL-AoD-RequestLocationInformation-r16 ::= SEQUENCE {","paragraph_zero_based":1150},{"literal_text_all_w_t_and_m_t":"nr-AssistanceAvailability-r16BOOLEAN,","paragraph_zero_based":1151}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["d0b95891f2503592b707b2739a27ff1f20b93841c1e98c8756ad4b0df1e5afb1","f766eb42a391491688ceeb6e71b966659d4ff7fe4076268c9dc139f0381d9ea9","34c27f8854d5d210dbfcf9e3bd1749a9bc491a35adceeb5ddee27c744f5655d9","c5c66f935625aad60dcd19557572dc9dcf6fda5bd6ede845d008c22fce98ad3a","fcb37ad54cd61e7b206665ded5e19ec8fa6b9cf47f239ef86a76634d5133ae45","342e114b3ede93fe0d1182d0480e6b35d33ac8fb2a3af8e80585984a2a030440","804618b671c9fb8a0e40b177822a2cea1c0e8f271eabea8e490e56d1fc709742","17d706578528d6da7a13ee80a4384e6187766eb