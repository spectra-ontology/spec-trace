eed R","paragraph_zero_based":16982},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":16983},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16984},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16985},{"literal_text_all_w_t_and_m_t":"CarrierFreqListEUTRA ::=            SEQUENCE (SIZE (1..maxEUTRA-Carrier)) OF CarrierFreqEUTRA","paragraph_zero_based":16986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16987},{"literal_text_all_w_t_and_m_t":"CarrierFreqListEUTRA-v1610 ::=      SEQUENCE (SIZE (1..maxEUTRA-Carrier)) OF CarrierFreqEUTRA-v1610","paragraph_zero_based":16988},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16989},{"literal_text_all_w_t_and_m_t":"CarrierFreqListEUTRA-v1700 ::=      SEQUENCE (SIZE (1..maxEUTRA-Carrier)) OF CarrierFreqEUTRA-v1700","paragraph_zero_based":16990},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16991}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7811f9ba05ea6dd3a8a772dbc0f5f1ee94f7cf0bc8e00b2c1e038aac338bf2c0","174710f44b5a6c17de872e281f66b2cefb077675a3d2527ff945e1671df07558","713434597e6e4e690c789a773c64cd96f901b60e34b68bebded463fa22b71f44","865ac040878b8d66094de17eff057c30e021952ca40d5d02a5d12b7c4b016e20","b4dbc55d892db5696bfa61e795ac194de514287cf676fcb3cba0d4aba0fc9aca","aa94addbc71ade806b48ff2d0357cafcb77023cdf0fecf8ba89db5ea73b5cb1c","bd609d2a3249dfb6e06f44a45ba3718dfff3c4be6297f25521a246707db67346","b9eabaf4b7a673a50f06b6f0fb10f85e8d3c1fa553ec5bdac68a1646911cbedd","01281ca65eb62e4cdf096cc7a853ab95910462de10edeceba7dcdca68f89f1ea","4d16c7a888910afc13bd3a81832c3aa734257f25f9c756cb8cf9df7f2b89af95","0cd946ae5aecec274af92ce5de851be5ffd4c7daa175398566916f44