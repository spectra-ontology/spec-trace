{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-UEINFORMATIONREQUEST-STOP","paragraph_zero_based":15384},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":15385},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":15386},{"literal_text_all_w_t_and_m_t":"UEInformationRequest-IEs field descriptions","paragraph_zero_based":15387},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":15388},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":15389},{"literal_text_all_w_t_and_m_t":"connEstFailReportReq","paragraph_zero_based":15390},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the connection failure.","paragraph_zero_based":15391},{"literal_text_all_w_t_and_m_t":"flightPathInfoReq","paragraph_zero_based":15392},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report the flight path information, if available, and to specify the flight path information report configuration.","paragraph_zero_based":15393},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementReq","paragraph_zero_based":15394},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the idle/inactive measurement information, if available, to the network in the UEInformationResponse message.  ","paragraph_zero_based":15395},{"literal_text_all_w_t_and_m_t":"logMeasReportReq","paragraph_zero_based":15396},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about logged measurements.","paragraph_zero_based":15397},{"literal_text_all_w_t_and_m_t":"mobilityHistoryReportReq","paragraph_zero_based":15398},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about mobility history information.","paragraph_zero_based":15399},{"literal_text_all_w_t_and_m_t":"ra-ReportReq","paragraph_zero_based":15400},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the random access procedure.","paragraph_zero_based":15401},{"literal_text_all_w_t_and_m_t":"reselectionMeasurementReq","paragraph_zero_based":15402},{"literal_text_all_w_t_and_m_t":"This field indicates that the UE shall report the reselection measurement information, if available, to the network in the UEInformationResponse message.  ","paragraph_zero_based":15403},{"literal_text_all_w_t_and_m_t":"rlf-ReportReq","paragraph_zero_based":15404},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the radio link failure.","paragraph_zero_based":15405},{"literal_text_all_w_t_and_m_t":"successHO-ReportReq","paragraph_zero_based":15406},{"literal_text_all_w_t_and_m_t":"This field is used to indicate whether the UE shall report information about the successful handover report.","paragraph_zero_based":15407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c81bc26bb899b9b346043e7cecc7d2a8254274382f5e78d8440408d8149747e7","e41c46af2bbda5b4e04975ff7e35edb8144c218839639aa476f3cb3d99475c20","e6662434d327da7a6b9100114d0989b0d12b6dacd00990df1eb0553db394a75b","f5bf021e5142733b77881b0be1a6741ebc495240ec43d5bb5dfebb28bd6226a0","7fb170cf2c74c8a24ef6bcf85da8f4d42136df9548b86d8172af2698f5306e2f","79a0c19f03b571d321b6a8c69aa7e65c0a22f512d8ac9a0800b08b69ae3cd6b3","1ca1f9a3bf3d73a46df16b7a4f2275f44532159c1766f1c55c09ebf27c0b6229","18