":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["0472a40e635d91206e72eb9b04ecab6549944606412bb4ea3a0adf60b5f7ce78","f0b7dff5a81c710892aa109b28f40860e32458a47a97200cfec13248498bb057","b79038da1c763fad09cf99f63ba0804bab6f7e9f5b9bb664b6ad9946be15976d","e89640bbed866f9eef25e5857bee29bfcb3f2d3a8bd907edc64324ea9d97f236","95442c901b472e2c7ebe4f2e587183a22801090eddc48d23c8c51b77c82cb600","f02b9fee2783e92f327473e291addb23f69363703f20ead853c82ca72a348689","01a4abd9c258f47963e182058253c0c16f4fd32919d83d66174028d9b23b1081","e00636bd59e408be49066c2b7bacff8ce7daa8cb14e07420b4176094b6277b87","e31793c766617af2cb96a52d512eb1cecf010852e9f00e95f91190525ad80742","e3e55f27cb2cba6b1442be35eb3d73a1d5806229b333ef20c90e77e6ebab2482","d85d4dabbcec525ffda0febad135430dfe4d0591b98d53085c19d68fbb317022","e4450bf8a12ae8d3720115e90b50164e4342b6861b66dc100fe5e7cf3b8131aa","8adfa705e489624d31f7b9afdb805d875b15be2a6439446f5de902490d1901ca","1d1d512f02c34b2e9985a50128081bf38b4f61fcfa49ee8fc90c49a99b5874a4","d76cbf48a192606caa724aa02f767dc14d3196406e4e34feaedd091e3a739c97","52289e159f2bfef202b020c0a0712cdb9ffef0cc6417a071a0d1ed133203670c","1166fe9cba44ca598b0e7a0e7ed115599e4ca301fbb30ffbfea4edd2bfb0ea62","6d9029ae73b20a9b9906b4371f70cfc59109e75c4a5d3cd1d7104f8d0d04a6a1","5ee1d2207d1aa1fa89b2eb0f6852d6e2193eec6a239b20a648a5018ad6d8db8e","a5d913a4fcbb6ce9027fb2f6d9b7be6a19c1971d0cc8f15e6017c7bc956a43c0","9a5105d2eb0746c4c9cbdff942cf652bf645b4c5364ff398d8d3be54b24e371f","50d5b1c82cacb2d63597cd49b9d5225508a181d55f8ae1ae49383998f22b007b","d8629b1340827d8563f160a509a4fb292d10f7c6aa67cddffbef6bdb48a95be8","f95dde058122341f0767cf8a82d6bfe766f5364c6f5a22df2bf16009126305bf"],"paragraph_range_zero_based":[96,119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p96"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This CR's revision history:","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"4.5Cell Categories","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"The cells are categorised according to which services they offer:","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"acceptable cell:","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"An \"acceptable cell\" is a cell on which the UE may camp to obtain limited service (originate emergency calls and receive ETWS and CMAS notifications). Such a cell shall fulfil the following requirements, which is the minimum set of requirements to initiate an emergency call and to receive ETWS and CMAS notification in an NR network:","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"-The cell is not barred, see clause 5.3.1 for details and exceptions;","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"-The cell selection criteria are fulfilled, see clause 5.2.3.2.","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"suitable cell:","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"For UE not operating in SNPN Access Mode, a cell is considered as suitable if the following conditions are fulfilled:","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"-The cell is part of either the selected PLMN or the registered PLMN or PLMN of the Equivalent PLMN list, and for that PLMN either:","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"-The PLMN-ID of that PLMN is broadcast by the cell with no associated CAG-IDs and CAG-only indication in the UE for that PLMN (TS 23.501 [10]) is absent or false;","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"-Allowed CAG list in the UE for that PLMN (TS 23.501 [10]) includes a CAG-ID broadcast by the cell for that PLMN;","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"-The cell selection criteria are fulfilled, see clause 5.2.3.2.","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"<<next change>>","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["45c68da121f2b1d42ebe55182b72a58b267a451182a2db27196d00aebc560f45","5081cc665f1617ab5b950bdec511f38c572bd2be1a05c46bf6a665c4da4e725c","d5011429e4d40f993d08770a0594b8f1433f619924b097dcb5441682c8cb3f46","dc6b18bc2f7e4d8e4f9c929658bb886e36371be2737bf259ce5d7f40dc2a426c","2d00809453c086bae9a200eed545e8094145e1fb71845d0d2d74c9bd63ee43dc","e48c7f6f173a3c8f65c423671e6dd5eab3b5fc8ad43638f9cbdc59648f92519f","cb3879bd0168f1cef3db52ddb6fd2e252bdf5df6921b92d8f74faa41b2fb66f2","a97ef27680555fcbc6ff449a3568a9f1941903d5ea21452b815c432b194ac61f","cf97a7259200c651d7ab82cc1943f1802bc4417910342f7325b03bd8258591df","b0950ccb385e846a444c467145865f192e19eed3029b90419b366df6fed0c0ca","df91671e07aafa9531f75e7b18f31277eee8760b76ba045fa07ba137c609fb87","d066fec2d1e319959958d7c69cc81e156b20970c1343f1f9a7a52f6b9536855d","8c5530f1eb84accc84dea11863ae1d65fc2c9255e54df2cece321829936d778f","9536709def877bbe84aa16d1bdac828b77d43b58636f62323321cfefb9ad8bb8","2bdbcca666b26387b55aee5b32bb9853dd4ce7ba939763b3b6be893e07300939","19be17b6f9dea583b9468501e907058ed4ebbfb76e71080159209404e2d14c2b","a63900dff4dea99d9935305f7bfda6fc0bee2d1698b37c5e03ed38ea99777034","143938a00f1dc9ef06832ed151fa8b7a809337a7e25ebaab28b8ff4635c4592c","540d59b6355c3e5f953d7a551c7a811e2b3d210d2161086255ce137c5c8e108c","0341a20e13838336bcb435ba0aa20fd4ff558fbf2a5633be32ad9219b7b6ad3b","c5773a2d6e9844d656d1af521f78b10a599bc6e0920e4d111a2a7c03f765044c","84c28476666af418895e6a10d32ccf2f6edafc94e1ec68ea60249fd41d2ab0c6","749f44929bc74db9297262fb7a4a05008cf3d919cb71c8ed23cec4ce00a20a1f","7331ba930559dc0f692534a37c99d87192ccc57259948eb94f8ee228e0b737b6"],"paragraph_range_zero_based":[120,143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p120"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5.3Cell Reservations and Access Restrictions","paragraph_zero_based":144},{"literal_text_all_w_t_and_m_t":"5.3.0Introduction","paragraph_zero_based":145},{"literal_text_all_w_t_and_m_t":"There are two mechanisms which allow an operator to impose cell reservations or access restrictions. The first mechanism uses indication of cell status and special reservations for control of cell selection and reselection procedures. The second mechanism, referred to as Unified Access Control as specified in TS 38.331 [3], shall allow preventing selected access categories or access identities from sending initial access messages for load control reasons.","paragraph_zero_based":146},{"literal_text_all_w_t_and_m_t":"Unified Access Control does not apply to IAB-MTs and NCR-MTs.","paragraph_zero_based":147},{"literal_text_all_w_t_and_m_t":"5.3.1Cell status and cell reservations","paragraph_zero_based":148},{"literal_text_all_w_t_and_m_t":"Cell status and cell reservations are indicated in the MIB or SIB1 message as specified in TS 38.331 [3] by means of following fields:","paragraph_zero_based":149},{"literal_text_all_w_t_and_m_t":"-cellBarred (IE type: \"barred\" or \"not barred\") Indicated in MIB message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is ignored by UEs supporting NTN while cellBarredNTN is included in SIB1.","paragraph_zero_based":150},{"literal_text_all_w_t_and_m_t":"-cellBarredNES (IE type: \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to UEs capable of NES cell DTX/DRX.","paragraph_zero_based":151},{"literal_text_all_w_t_and_m_t":"-cellBarred-eRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to eRedCap UEs.","paragraph_zero_based":152},{"literal_text_all_w_t_and_m_t":"-cellBarred-eRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to eRedCap UEs.","paragraph_zero_based":153},{"literal_text_all_w_t_and_m_t":"-cellBarredNTN (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is ignored if the UE does not support NTN connectivity.","paragraph_zero_based":154},{"literal_text_all_w_t_and_m_t":"-cellBarredATG (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to ATG UEs.","paragraph_zero_based":155},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":156},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":157},{"literal_text_all_w_t_and_m_t":"-cellBarredFixedVSAT (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is only applicable to VSAT UEs using NTN access.","paragraph_zero_based":158},{"literal_text_all_w_t_and_m_t":"-cellBarredMobileVSAT (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is only applicable to VSAT UEs using NTN access.","paragraph_zero_based":159},{"literal_text_all_w_t_and_m_t":"-cellBarredNES (IE type: \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to UEs indicating any of the values in nes-CellDTX-DRX as specified in TS 38.306 [24].","paragraph_zero_based":160},{"literal_text_all_w_t_and_m_t":"-cellBarredNTN (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs. This field is ignored if the UE does not support NTN access.","paragraph_zero_based":161},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap1Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":162},{"literal_text_all_w_t_and_m_t":"-cellBarredRedCap2Rx (IE type: \"barred\" or \"not barred\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to RedCap UEs.","paragraph_zero_based":163},{"literal_text_all_w_t_and_m_t":"-cellReservedForOperatorUse (IE type: \"reserved\" or \"not reserved\") Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":164},{"literal_text_all_w_t_and_m_t":"-cellReservedForOtherUse (IE type: \"true\") Indicated in SIB1 message. In case of multiple PLMNs indicated in SIB1, this field is common for all PLMNs.","paragraph_zero_based":165},{"literal_text_all_w_t_and_m_t":"-cellReservedForFutureUse (IE type: \"true\") Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs.","paragraph_zero_based":166},{"literal_text_all_w_t_and_m_t":"NOTE 0:IAB-MT ignores the cellBarred, cellReservedForOperatorUse, cellReservedForFutureUse, and intraFreqReselection (i.e. treats intraFreqReselection as if it was set to allowed) as defined in TS 38.331 [3]. IAB-MT also ignores cellReservedForOtherUse for cell barring determination (i.e. NPN capable IAB-MT considers cellReservedForOtherUse for determination of an NPN-only cell) as defined in TS 38.331 [3].","paragraph_zero_based":167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["c642793283e997ef1fefc80e372abb334a84ceb39c6842d269baf510556e2d47","a254cb3ec87fe469ca903c0a8999cb0b09b1990355937cfd006db353189794b4","e3865ac6cf0cb7d919dc4194818040ed1b59a31dfad2a1402daacf078c84e4b0","f5722284af22d317dacbd3a2ac5a17f7976a38d0218586ee8fb59f068baf4f29","47f4120f25d690e46704d40e1ae2e0a634f94cd943d8191d1d7aae53be22642b","6911196d8180e6fc5ee3819252d624831bcbc304da1ffae1fd8a8c5170733fb0","80af343b6df3941099a25fc8bf9e5a4231b184afb78adc923b99323b976b5dfa","5ec4fccc007a564437588c62f2d69d3bcadd162f3d1f92eb5ee0ea4f4185d474","9b2fd28975d19d8ee3fcbd8be4bfc635c0915e133c941d2224b8aa4d1902b476","f2190c60e75a13128a28208029371da18a5cece1f1d85200e31aa5333763bd05","b372779437e7017ee72bb233d14cae7322823b37a047a8c8d3e9a72ef8292e53","e39b4a8132b07dab93fd4f5f7d339aa89ffb9f30cd3b887ac393e6b6e496f368","56907eeca26b60b86343ac47b540659806b8ef1ca9e19f325241914d838a4744","bfff4d3bf3948c0bfa2075c0cd4a21407d2e1b49b2ffb6d18bef9be19efa0651","b0f5381b5e699641634e93287724f1de13379e826a487b734b1a99c1f0a52c7a","2c06a4334296ffe626c893b9a9cb8eaf29f5c83afb05c2fdc85e3d32a508697f","cbb0467556b731886daf8d3f3847cc146274076c291878e3f13ddfda5a5be962","7e5730eb951afe152fc7d97d09c3daf5dac2d44380557e172369dd022d4d3ee8","847b56ef87ae60534558ea6e8c33699e8de1e9d8cbef4728399976da996ff069","4f1acdc4ed60f17608402e72ed68d7a1629a0ec36fed0b54504bb122761ab0f7","b1106e60a7cd13717233b7f34079c2e75bf60f8e95cae2019a77558fccf0c27a","ccfddadb41fa82722427b60fa7e305df57a594d19b1e5270e9971000232e5cbf","4951203dac0560fa789f66765dae6c644ba2f02dfb67c1109feaad3806a6c2e0","01e811e3e87d8923a152784f455502e8d12db4a1c30abf076e9d324923c694e8"],"paragraph_range_zero_based":[144,167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p144"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"NOTE 0a: NCR-MT ignores the cellBarred, cellReservedForOperatorUse, cellReservedForFutureUse, and intraFreqReselection (i.e. treats intraFreqReselection as if it was set to allowed) as defined in TS 38.331 [3]. NCR-MT also ignores cellReservedForOtherUse for cell barring determination (i.e. NPN capable NCR-MT considers cellReservedForOtherUse for determination of an NPN-only cell) as defined in TS 38.331 [3].","paragraph_zero_based":168},{"literal_text_all_w_t_and_m_t":"-halfDuplexRedCapAllowed (IE type: \"true\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs. This field is only applicable to (e)RedCap UEs.","paragraph_zero_based":169},{"literal_text_all_w_t_and_m_t":"-iab-Support (IE type: \"true\")Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":170},{"literal_text_all_w_t_and_m_t":"-ncr-Support (IE type: \"true\")","paragraph_zero_based":171},{"literal_text_all_w_t_and_m_t":"Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is common for all PLMNs and NPNs.","paragraph_zero_based":172},{"literal_text_all_w_t_and_m_t":"-mobileIAB-Support (IE type: “true”)","paragraph_zero_based":173},{"literal_text_all_w_t_and_m_t":"Indicated in SIB1 message. In case of multiple PLMNs or NPNs indicated in SIB1, this field is specified per PLMN or per SNPN.","paragraph_zero_based":174},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":175},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"not barred\" and \"not reserved\" for operator use and not \"true\" for other use and not \"true\" for future use,","paragraph_zero_based":176},{"literal_text_all_w_t_and_m_t":"-UEs shall treat this cell as candidate during the cell selection and cell reselection procedures.","paragraph_zero_based":177},{"literal_text_all_w_t_and_m_t":"When cell broadcasts any CAG-IDs or NIDs and the cell status is indicated as \"not barred\" and \"not reserved\" for operator use and \"true\" for other use, and not \"true\" for future use:","paragraph_zero_based":178},{"literal_text_all_w_t_and_m_t":"-All NPN-capable UEs shall treat this cell as candidate during the cell selection and cell reselection procedures, other UEs shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":179},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"true\" for other use, and either cell does not broadcast any CAG-IDs or NIDs or does not broadcast any CAG-IDs and the UE is not operating in SNPN Access Mode,","paragraph_zero_based":180},{"literal_text_all_w_t_and_m_t":"-The UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":181},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"true\" for future use,","paragraph_zero_based":182},{"literal_text_all_w_t_and_m_t":"-The UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":183},{"literal_text_all_w_t_and_m_t":"When cellBarredNES is absent and cellBarred is set to \"barred\",","paragraph_zero_based":184},{"literal_text_all_w_t_and_m_t":"-The UE capable of NES cell DTX/DRX shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":185},{"literal_text_all_w_t_and_m_t":"When cellBarredNTN is not broadcast in this cell,","paragraph_zero_based":186},{"literal_text_all_w_t_and_m_t":"-For NTN access, the UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":187},{"literal_text_all_w_t_and_m_t":"When halfDuplexRedCapAllowed is not broadcast in this cell,","paragraph_zero_based":188},{"literal_text_all_w_t_and_m_t":"-The (e)RedCap UE only capable of operating in half-duplex for FDD shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":189},{"literal_text_all_w_t_and_m_t":"When cellBarredATG is not broadcast in this cell,","paragraph_zero_based":190},{"literal_text_all_w_t_and_m_t":"-For ATG access, the UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["0d49e0824e22903056deb883f3778214daee351f48a4f4b83b7020b00aaabe5e","0c2da8d05ce6344f0e277ca655f212bcd0a98463d7e42b5acdd564b494e15ebb","c7b61ec1aa84bcc27b9b077b2a1bcf309487bbf9c87af5bb3e9933972211370c","a99a1d9131022cd6c0d7a003ba4ee4c29e430bfb06884fdda7c9c5d1bd35f546","2fe1a6fd9bb33a08dafa259c626cfacb8fa918ab31bb3b969f80d766e02a8d51","2d0e524cf2a9627a513c52dad2ee95e6fa7cb09b26c4ccb07690fccca6bf6202","f3c00d7f55883016a5fcb9030437e2ccea78ecffe6e76b3e3cba9d2b297c05f8","523f70a185994f2e5d0c34c58423a8188c47f3b98577bd06191549a0eaa9f919","66fa1840b53c502b37e137987f653f2349753a576302187a377879d96f782f5e","28df512c02e38b0d8ae1c1673f253e48412295d3381cac57507af85054bf644c","301699b29be15cf6af9e8308118265f1c2591f8cbb1e332edced4bffbf384186","2ed9522046357830d23eae2fc5a34d267bf00fa39c08f6aa65b5f9f6b823b5d6","2615aa11afd8d4f291df3b3afad1687e4ae3cb2f7272054781c6fbe6d8e8d1bb","28c90a4083a07a76c9c9c92d3d8effe35ec45bb5fed4470af6fd48122c34d48d","5320801762a3774583a4f783342c06321ba2f1860f246c002ddb15a8e6ae56ab","b46a739ba8565a17abed30ebbcce8512d7593ba97941ae372d9556d7a8b3756b","7771d81aa47c02d6a0ca146c23b0520a3e37c5c3913e961f0150dbf1e39dcf08","17aec652450f26b92ede9e92c16a9d2c040133e53635e6c8b69fb3e24dfc15ce","0b66af1d7646153da29b7644476549f0130bf19ac787d28c9b89aae1d06984f4","e7ad373cc6e1f8097dfa286a4deea022832aab3ae07b88a58f16c4369a44670f","9b565d3bc68e378a67a60f991889017ca9eed2d167df03a427c81539cdba1645","3303171e7d860484032ab53f22d198c0a1052f44834920eab6737578f9d12365","915bff875de9e39ecb3c37c3b9aac628724f5655edd4e5ca6dc6e15cb47a7b51","32391fd2f8286eafe9f0a9cadbf3256e6ceb7827b6c4e4f6a18d0aa1defd60f2"],"paragraph_range_zero_based":[168,191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p168"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"When cellBarredFixedVSAT is not broadcast in this cell,","paragraph_zero_based":192},{"literal_text_all_w_t_and_m_t":"-For NTN access, the fixed VSAT UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":193},{"literal_text_all_w_t_and_m_t":"When cellBarredMobileVSAT is not broadcast in this cell,","paragraph_zero_based":194},{"literal_text_all_w_t_and_m_t":"-For NTN access, the mobile VSAT UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":195},{"literal_text_all_w_t_and_m_t":"When cellBarred2RxXR is broadcast in this cell,","paragraph_zero_based":196},{"literal_text_all_w_t_and_m_t":"-The 2Rx XR UE shall treat this cell as if cell status is \"barred\".","paragraph_zero_based":197},{"literal_text_all_w_t_and_m_t":"When cell status is indicated as \"not barred\" and \"reserved\" for operator use for any PLMN/SNPN and not \"true\" for other use and not \"true\" for future use,","paragraph_zero_based":198},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 11 or 15 operating in their HPLMN/EHPLMN shall treat this cell as candidate during the cell selection and reselection procedures if the field cellReservedForOperatorUse for that PLMN set to \"reserved\".","paragraph_zero_based":199},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 11 or 15 shall treat this cell as candidate during the cell selection and reselection procedures if the field cellReservedForOperatorUse for selected/registered SNPN is set to \"reserved\".","paragraph_zero_based":200},{"literal_text_all_w_t_and_m_t":"-UEs assigned to an Access Identity 0, 1, 2 and 12 to 14 shall behave as if the cell status is \"barred\" in case the cell is \"reserved for operator use\" for the registered PLMN/SNPN or the selected PLMN/SNPN.","paragraph_zero_based":201},{"literal_text_all_w_t_and_m_t":"-UEs assigned to Access Identity 3 shall behave as if the cell status is \"barred\" in case the cell is \"reserved for operator use\" for the registered PLMN or the selected PLMN.","paragraph_zero_based":202},{"literal_text_all_w_t_and_m_t":"NOTE 1:Access Identities 11, 15 are only valid for use in the HPLMN/ EHPLMN and registered/selected SNPN; Access Identities 12, 13, 14 are only valid for use in the home country and registered/selected SNPN as specified in TS 22.261 [12].","paragraph_zero_based":203},{"literal_text_all_w_t_and_m_t":"NOTE 1a:Access Identity 3 is only valid for PLMNs that indicate to potential Disaster Inbound Roamers that the UEs can access the PLMN as specified in TS 22.261 [12].","paragraph_zero_based":204},{"literal_text_all_w_t_and_m_t":"When cell status \"barred\" is indicated or to be treated as if the cell status is \"barred\",","paragraph_zero_based":205},{"literal_text_all_w_t_and_m_t":"-The UE is not permitted to select/reselect this cell, not even for emergency calls except for the below cases:","paragraph_zero_based":206},{"literal_text_all_w_t_and_m_t":"-When cellBarredRedCap1Rx is set to “barred” in SIB1, a RedCap UE that supports only 1Rx branch can consider the cell as acceptable cell, only if cell selection criteria are fulfilled as defined in clause 5.2.3, cellBarred in MIB is not set to “barred” and in SIB1, barringExemptRedCap is set to “true” and, if the RedCap UE supports only half duplex FDD operation, halfDuplexRedCapAllowed is set to “true”; or ","paragraph_zero_based":207},{"literal_text_all_w_t_and_m_t":" ","paragraph_zero_based":208},{"literal_text_all_w_t_and_m_t":"-When cellBarredRedCap2Rx is set to “barred” in SIB1, a RedCap UE that supports 2Rx branches can consider the cell as acceptable cell, only if cell selection criteria are fulfilled as defined in clause 5.2.3, cellBarred in MIB is not set to “barred” and in SIB1, barringExemptRedCap is set to “true” and, if the RedCap UE supports only half duplex FDD operation, halfDuplexRedCapAllowed is set to “true”;  ","paragraph_zero_based":209},{"literal_text_all_w_t_and_m_t":"-The UE shall select another cell according to the following rule:","paragraph_zero_based":210},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the MIB:","paragraph_zero_based":211},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds.","paragraph_zero_based":212},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if the selection criteria are fulfilled.","paragraph_zero_based":213},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":214},{"literal_text_all_w_t_and_m_t":"-If the UE is a RedCap UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselectionRedCap in SIB1', if available;","paragraph_zero_based":215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["6a68bd55b79fe692f3e0837440d19e1fbcc5c94b889f344e219dcf45f7dffcb9","f4f4fdce7f0c8d650c4213d935ab73290cefe02b41a6e638da36fb24676a1cb9","2cad8a936365e6cc4479e3700d2ffc7fd5783aeb1924eecf01e3596077c94653","8fd92eb4a86a74429607727d3257b6ae3aa461928808c39a61500e6a4be74a5b","bf4adc38edcbd66c980bd5cfd60aeef2c9587c0b8a2a22b5ed4e4116d4b25a68","de3b3ba4a99bfc46d2491a9b27aa50a9760ab3c894534cb9afdca4b22dc7df9d","4bf2a6b204061cf27d69be78c44d13e615b354cff0f9cd3c82f5f9f4c9affba3","64e2983fb9f6a42a3df7e0ac51448ce7b52ad3c4843a08d8f50fc04683483e9f","ad727d4b3728b4c1cfbc3566a380c9dd1bea55d9d8bf13b4512449d65a4971b4","13fb7742f976cbbb887beeda49595bd8f7da75b29f0d158ba6a4da83ba9452b2","1f8a4608c24d69369797c598fd7896215d1e6ff40ab3b0d0140357d0f012123c","2219e093a24142bb2f2ed378de5050eab5e675f8ac7d2911ddf7aace9b35ba8d","34fdf84b172870e1c43bcd7fa1f92ecba48ad8232867f256ce61ef5bfb5d3c91","84bb6edf5ea3d7c76522bc19fe38c9090459e04892b6971f30b14a6541be66d3","d69cb114b25d80e81e1d5525c885f9f499145f38a30f07c9c7139c13d785933a","ff07633e965fae26c9c01c8360f608fe6b3618c1c60903c671f4523af8e1bf2c","d046dca5f85bb3c1d5f47ae6ab4147180601cf95cc6be63420038d3a0feba77d","78d7c01f401cbf0b17ac53484c26f25109bb4266c66cc247a86968de4a2335b7","56c5ed13410199c7fbb4ab4c1edf6256beb9b48d9cc77b85a54ac839d11abb00","f474482559c49964bab700a80037e3d8b674039a1838468e103e7c1058ad11aa","55d362e0eecb9b9aa9a5da7fec7db00dc5b5a895a6e8f0f2ff90a30f16819555","49b9222b9b1910b2818fe6e67c318c58d6f87519179ba5f24de11fa9e74b87af","4cdf5854e52b532b608f99491e48845352c264e9b1c6b70c82f0e109ce1eb725","fed512728bc84435dd5d68dcca7de4175e82ea45d7cc93a045e8b46ca737fe2e"],"paragraph_range_zero_based":[192,215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p192"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-If the UE is an eRedCap UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselection-eRedCap in SIB1', if available;","paragraph_zero_based":216},{"literal_text_all_w_t_and_m_t":"-If the UE is a 2Rx XR UE, the UE shall acquire SIB1 and, in the remainder of this procedure, consider 'intraFreqReselection in MIB' to be 'intraFreqReselection2RxXR in SIB1', if available:","paragraph_zero_based":217},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":218},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds.","paragraph_zero_based":219},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if the selection criteria are fulfilled.","paragraph_zero_based":220},{"literal_text_all_w_t_and_m_t":"-If the cell status \"barred\" is indicated in MIB but the UE is unable to acquire the SIB1; or","paragraph_zero_based":221},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to not supporting (e)RedCap UEs; or","paragraph_zero_based":222},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to not supporting 2Rx XR UEs:","paragraph_zero_based":223},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":224},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if re-selection criteria are fulfilled.","paragraph_zero_based":225},{"literal_text_all_w_t_and_m_t":"-If the UE is neither a RedCap UE nor an eRedCap UE nor a 2Rx XR UE, or if the UE is a RedCap UE and intraFreqReselectionRedCap in SIB1 is available, or if the UE is an eRedCap UE and intraFreqReselection-eRedCap in SIB1 is available, or if the UE is a 2Rx XR UE and intraFreqReselection2RxXR in SIB1 is available:","paragraph_zero_based":226},{"literal_text_all_w_t_and_m_t":"-If the field intraFreqReselection in MIB message is set to \"allowed\":","paragraph_zero_based":227},{"literal_text_all_w_t_and_m_t":"-the UE may select another cell on the same frequency if re-selection criteria are fulfilled;","paragraph_zero_based":228},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":229},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds;","paragraph_zero_based":230},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":231},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":232},{"literal_text_all_w_t_and_m_t":"-If the field intraFreqReselection in MIB message is set to \"not allowed\":","paragraph_zero_based":233},{"literal_text_all_w_t_and_m_t":"-If the cell is to be treated as if the cell status is \"barred\" due to being unable to acquire the SIB1:","paragraph_zero_based":234},{"literal_text_all_w_t_and_m_t":"-the UE may exclude the barred cell as a candidate for cell selection/reselection for up to 300 seconds;","paragraph_zero_based":235},{"literal_text_all_w_t_and_m_t":"-If the cell operates in licensed spectrum:","paragraph_zero_based":236},{"literal_text_all_w_t_and_m_t":"-the UE shall not re-select to another cell on the same frequency as the barred cell and exclude such cell(s) as candidate(s) for cell selection/reselection for 300 seconds;","paragraph_zero_based":237},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":238},{"literal_text_all_w_t_and_m_t":"-the UE may select to another cell on the same frequency if the reselection criteria are fulfilled.","paragraph_zero_based":239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["5011b15590f9b9b6e5ab6fdd862fed5c84a34f9fddaed5ba4aaf5067acb1c5aa","f8f7392b69cc82b2a177f1fa28622228e2422d5d1f74b5cf430b671f8f26f3db","cf170975507d71b15dea2bf29634a71cd96adfcfc89669868be5fc637b36efbf","fae43ea2bbd3bd25e9df0c0d463bab58cb85c7647b2c1b32cc20ee9171e7bb5e","f531f32fb66f2f0d1464e1fa1fa795bbc37bb361a157060646118bc588e645ce","c02a7d2b58463eb5f5ca11958e6ddc6ce5ee51682d0e8b64d36f980ae823f72b","cedab5ed6d60e47689c6d03504eb92a57e6c3441794fe75a2fb7fddf4d66e7c4","a8ca1a640e97308cbde41773a99e54dfcc9b3dc60b4a72416ed895cb036bec39","11fd7d560db30d2792f4bae2cf0749e10ede959cf02d0bd414392397eada16bb","ab478e37528bcffe5907070ad315db4302d95e39ca9fe10e1d6e648079553c8b","9d6a7f653a9bd83e4addb2921abb0dd9b50f8cf1755107b448593b4d5f6908ca","e27d9641c1575e90e94a0ecdb5848761e727b0e2f66981432d98037909a38759","f411926c8132b811b4c5153fc867fad6e258927d2f0cd3c018cf4294a0d60d5c","a505f52b3d84dfb5d18f64fa7113ec5e1b66dd0e60fc40bf62776111c251bcf4","3d2bb5828884e50d4ba4e24a2035957ed89a21296728530a38b51c32d06e4e49","66ef109fef11772d184fc55da85409b2cb190b4ed6ec9a9413aaae23244fa467","164cd309bc4916ec837befba67c25102c66211189dc73ac0b706a34a94d32ea1","864c7dbfea712abbd99e1100dcb05d47470d7ea700aa7d7b38e50ae8f0064bfc","7cfe4ff66e29b6efb2dd598f5113630c631e7cafb6c6b6389512ca7504fd2480","1bf7d88bacbd048df95ff339f0d672f5c28877e66290e21fb508d10a62fbd264","16fedda09edd04cd124ff097406aeab81399514bda7b7a6163da53ef8050d7a0","49d7bc9cd2f2146ad4a49a6005e890b04a90faa15a86df3bfd535701ebc09e4f","3535ce9beb0af3523eb7cccb26bb4d0786f48bbd67265050cf013691eaeede83","fc98cf46e39484e767f4d6b8958d989aa5a78bc0110a293d447fe9ea813093d0"],"paragraph_range_zero_based":[216,239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p216"}
{"fields":{"filename":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":240},{"literal_text_all_w_t_and_m_t":"-If the cell operates in licensed spectrum, or if this cell belongs to a PLMN which is indicated as being equivalent to the registered PLMN or the selected PLMN of the UE, or if this cell belongs to an SNPN which is equal to or indicated as being equivalent to the registered SNPN or the selected SNPN of the UE:","paragraph_zero_based":241},{"literal_text_all_w_t_and_m_t":"-the UE shall not re-select to another cell on the same frequency as the barred cell and exclude such cell(s) as candidate(s) for cell selection/reselection for 300 seconds;","paragraph_zero_based":242},{"literal_text_all_w_t_and_m_t":"-else:","paragraph_zero_based":243},{"literal_text_all_w_t_and_m_t":"-the UE may select to another cell on the same frequency if the reselection criteria are fulfilled.","paragraph_zero_based":244},{"literal_text_all_w_t_and_m_t":"-the UE shall exclude the barred cell as a candidate for cell selection/reselection for 300 seconds.","paragraph_zero_based":245},{"literal_text_all_w_t_and_m_t":"The cell selection of another cell may also include a change of RAT.","paragraph_zero_based":246},{"literal_text_all_w_t_and_m_t":"NOTE 2:If barring of a cell is triggered by the condition of trackingAreaCode and trackingAreaList not being provided, as specified in TS 38.331 [3], the barring only applies to this PLMN and the UE can re-evaluate the barring condition again due to selection of another PLMN.","paragraph_zero_based":247},{"literal_text_all_w_t_and_m_t":"5.3.2Unified access control","paragraph_zero_based":248},{"literal_text_all_w_t_and_m_t":"The information on cell access restrictions associated with Access Categories and Identities is broadcast in SIB1 as part of Unified Access Control as specified in TS 38.331 [3].","paragraph_zero_based":249},{"literal_text_all_w_t_and_m_t":"The UE shall ignore Access Category and Identity related cell access restrictions for cell reselection. A change of the indicated access restriction shall not trigger cell reselection by the UE.","paragraph_zero_based":250},{"literal_text_all_w_t_and_m_t":"The UE shall consider Access Category and Identity related cell access restrictions for NAS initiated access attempts and RNAU as specified in TS 38.331 [3].","paragraph_zero_based":251},{"literal_text_all_w_t_and_m_t":"A L2 U2N Relay UE does not need to perform the Unified Access Control as specified in TS 38.331 [3], due to the U2N Remote UE access attempt.","paragraph_zero_based":252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":253}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"5e5425942b125f8bf1a0c4b31b3fbdc89816aeda841df4bfe6eb6f99049b1c7a","original_member_sha256":"a9c358edc3817339131c050b5424d9eebf6fc7fa5fa6582fc43cc5c6759faf0b","paragraph_ElementTree_utf8_XML_sha256":["6833fe5fbef4be0eb29833cbf3bf697c8bd21358a82c2d5f301219d9e233de63","093ae0f391c5215234de52c5d340877a4ea184ebaf27b28ab85e03fdd7787c32","61c8d8c87f626c8151fe0cbc480f5e3d4084a0cf057c23742a16013a69ce66ef","771b413addc6e52141c796eb6a2de1d3a06b7e195f8cd596ed2a46b3fb9f8cae","2ef0368e4176d41018463db4c4f1b8f8fb92f08b20995f4641ea9d1455e0b6e0","5afbe90cf5f4c0a16f4e1a8ffc174004adec099a8b251f90d6f9b4c9e5a8ad48","e0d21288e5ae3ac80bb5b36ab0054151c10b4e1f3a1b8fb60d4aff4337d99cb6","75d359280819fb052d257d0b405b8aa76bb65e0b470b4619059dd52d415e25eb","90dfd7dd2dfb299887ffadd467d4a845d5f320276b48c7e934957a843ffd80a7","4172f9711768bf59e4c179d38b74e3de79edd04179078f2f2e25ae327500c687","8e52a3a62f1465f146f0a85a58cc3c0c8997e854c0a3d6fdb3d28e9f0c5dc502","8f52e699541afe45478b3605593f1bb70b1f1bf860abbbca3a1001eb47a8a120","8a9489e029faa715197e93ce8d0a999ca7381e70ec80ce4983f4b2095abadc58","023a05bd6453a59ec493005d9a444294761a15f5f45a284682fead9d39f28887"],"paragraph_range_zero_based":[240,253],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2404643.zip::R2-2404643_R17_RedCap_304.docx:p240"}
