{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23352},{"literal_text_all_w_t_and_m_t":"-- TAG-GAPPRIORITY-START","paragraph_zero_based":23353},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23354},{"literal_text_all_w_t_and_m_t":"GapPriority-r17 ::=                       INTEGER (1..maxNrOfGapPri-r17)","paragraph_zero_based":23355},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23356},{"literal_text_all_w_t_and_m_t":"-- TAG-GAPPRIORITY-STOP","paragraph_zero_based":23357},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23358},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23359},{"literal_text_all_w_t_and_m_t":"–HighSpeedConfig","paragraph_zero_based":23360},{"literal_text_all_w_t_and_m_t":"The IE HighSpeedConfig is used to configure parameters for high speed scenarios.","paragraph_zero_based":23361},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig information element","paragraph_zero_based":23362},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23363},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-START","paragraph_zero_based":23364},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23365},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-r16 ::=  SEQUENCE {","paragraph_zero_based":23366},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlag-r16    ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":23367},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodFlag-r16   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":23368},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23369},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23371},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig-v1700 ::=  SEQUENCE {","paragraph_zero_based":23372},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasCA-Scell-r17    ENUMERATED {true}        OPTIONAL,   -- Cond SCellOnly","paragraph_zero_based":23373},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasInterFreq-r17   ENUMERATED {true}        OPTIONAL,   -- Cond SpCellOnly2","paragraph_zero_based":23374},{"literal_text_all_w_t_and_m_t":"    highSpeedDemodCA-Scell-r17   ENUMERATED {true}        OPTIONAL,   -- Need R","paragraph_zero_based":23375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f3bb820816563b81a78a023ff8c4eae52f62c17301070d8c7728168158236c03","aa328778ed51121d7e7834bcf58b5e8f7734915e6475f7251a510d57d6812e71","33e6c10036411c7da4a19ed8f9b49e4939c17f6ecb76e397550d1b82b14949b6","80ba36db3cc865283af66231516b104e3583bd778e9d5d298483b4903aa9dad3","5164704785fd50b39cc969dd7397f633a3f86b23edc9a30ab52a48353f1718be","b0dd90c1d2c3d91314ede191f921809b9408c8e922444fddf2074cbfaf97d463","313cd6d4a519d89f820aa8bb5d84bb8f01174fdc32b6f0d2de779a1347866180","317f83fbe6339683b82a8cba180375a4c0b461f8d6506908c80ef283663ff7b0","e2804bc4f4fede7fde2fa3e73970a3390e6b276e6a483ada048a3077c1e28437","7ec6804b55d5524ffa61cb26c9acff311ccbd7913da6d5dc5a79e35d9a37ceff","fe5604c4270287fde93d678ccea6a73b9c4258bb3de382130c138d7d6895f585","12126c1145182d627fe61270c1b1085158302311eacfc32dc8d8a2d3dcb43c42","b1deef0b6a32a1da604e6227c9b4d7da317fa129c0f4ea0d9d786c4826bfa406","368ad2d8849767a52516af5efd83ad5ec1e2935a8941e824a0d78e2179754e6d","b099fd64456d4756e3df2977838d64b4267a1028434c7269bd817245f2a7bb94","e71a24d25c8561c82dedec7cbfc867d00a3f1dfb6a107748dbe801804f47bfaa","fd7b68dbbf90845cd558079e1d51b52e