 of consecutive physical cell identities (including start) in the range. For fields comprising multiple occurrences of EUTRA-PhysCellIdRange, NW may configure overlapping ranges of physical cell identities.","paragraph_zero_based":43554},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellIdRange information element","paragraph_zero_based":43555},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43556},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-PHYSCELLIDRANGE-START","paragraph_zero_based":43557},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43558},{"literal_text_all_w_t_and_m_t":"EUTRA-PhysCellIdRange ::=       SEQUENCE {","paragraph_zero_based":43559}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6cc8f353e5beb5a0ff69d354728403803a2289301f321d0440d2bf7d56614690","fda2074d78c8245bdb2225842d64694597ad7f625c64339b3849b870be6a2b68","c4c2036b32209b0fafc1d178354e54b8fbcfd1b5cd3cf4910331d64c12990497","3fa9c8df7580c21f3d02943798d8f16c6a5266eae4344355ed7df27e0f92af29","177717770aec4c6af496d8b2352634891191b91512f478f1b2b3918e9f6a1689","ba5ec9161c2ba0f66f60a98606e86bd050af9c321811f6122d0699b5a18e80ff","3803b280799194aee06153f2add65cb752f31d3ebf99066125e72708496fe9cc","49434357237b92e22619763e41f67da34d676f7c17756fe0b45aadd58bf22f01","0e380fb72767a9914f961971671d22f0df8254b8685d830fa488e2d759de399d","7d69cae1870402a76301413a64066b4dcd77b1ab492dbdf79434514552921210","e7ce98bdad079542991e18329998dcba691435bd0da7a77e3bb1e45dbfaff60d","5973e63e05a1d814c6991afa269a7a99a88f987f429be0302a5da97a6eb762c1","7212b8a7b544da7505d365b13059f2a58e672e8dcff605c9d72c1f28a2c6edda","6d084e40c358d9e946b0963ac7ca2e00486de9d7ad17444c487735ef5e55434a","b2c9cfd0670d75fd