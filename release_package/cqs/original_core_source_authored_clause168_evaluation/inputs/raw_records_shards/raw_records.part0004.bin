{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"source-c-RNTI","paragraph_zero_based":50208},{"literal_text_all_w_t_and_m_t":"Set to C-RNTI that the UE had in the PCell it was connected to prior to the reestablishment.","paragraph_zero_based":50209},{"literal_text_all_w_t_and_m_t":"sourcePhysCellId","paragraph_zero_based":50210},{"literal_text_all_w_t_and_m_t":"Set to the physical cell identity of the PCell the UE was connected to prior to the reestablishment.","paragraph_zero_based":50211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50212},{"literal_text_all_w_t_and_m_t":"–VarSuccessHO-Report","paragraph_zero_based":50213},{"literal_text_all_w_t_and_m_t":"The UE variable VarSuccessHO-Report includes the successful handover information.","paragraph_zero_based":50214},{"literal_text_all_w_t_and_m_t":"VarSccessHO-Report variable","paragraph_zero_based":50215},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":50216},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSUCCESSHO-Report-START","paragraph_zero_based":50217},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50218},{"literal_text_all_w_t_and_m_t":"VarSuccessHO-Report-r17-IEs ::= SEQUENCE {","paragraph_zero_based":50219},{"literal_text_all_w_t_and_m_t":"    successHO-Report-r17            SuccessHO-Report-r17,","paragraph_zero_based":50220},{"literal_text_all_w_t_and_m_t":"    identityList-r18                CHOICE {","paragraph_zero_based":50221},{"literal_text_all_w_t_and_m_t":"        plmn-IdentityList-r18           PLMN-IdentityList2-r16,","paragraph_zero_based":50222},{"literal_text_all_w_t_and_m_t":"        snpn-IdentityList-r18           SEQUENCE (SIZE (1..maxNPN-r16)) OF SNPN-Identity-r18","paragraph_zero_based":50223},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":50224},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":50225},{"literal_text_all_w_t_and_m_t":"-- TAG-VARSUCCESSHO-Report-STOP","paragraph_zero_based":50226},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":50227},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":50228},{"literal_text_all_w_t_and_m_t":"–VarSuccessPSCell-Report","paragraph_zero_based":50229},{"literal_text_all_w_t_and_m_t":"The UE variable VarSuccessPSCell-Report includes the successful PSCell change or addition information.","paragraph_zero_based":50230},{"literal_text_all_w_t_and_m_t":"VarSuccessPSCell-Report variable","paragraph_zero_based":50231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["39bf64c0b11fa25eb84aba6c0ce138dfa54c9df1c93c32d33f5acc2f1e39f33b","b47e080b330e8072d0cdff4e531755c90c7e853fd406cbcc2a6372c2700bd6e7","810d607f63610ca5dd37371fd7b682f97fd23c33c4c86d4b3b81f07eee177e38","d56dd2ce0160523f632f9aa5d17fa6fc2a4156d9bbcc4565736da1adadfeb499","b76322dd91c2641705cd40c93b67e237a03bb422fb8e97239d1a3cf86185558a","0dc34b6b630a21f4f4cd2db62d9d437e2784e73e7d9bf960b5fb13a2bd1d4a25","37b928969b79afa89948aa1d5db80fc05c8a694444a811e7884223b1fb843024","ba6d63008b8610635fc8e1164b0480cd2f15d8e15df91ac8bd0ff9ca50f5cfc0","469e0df9281a11085493fec21ae6f8c464de52cdd68988403567387cfa00d410","a6e40a95407d82e3aedbb5a7df26a7ae3081c7538ba19de443642e4ee3ea7e4a","1c04eeff7b77bf9dbc3004df06c145b3907bb37278af492ebdd1eb93469dde7a","10dc18174f3bcf2ba7be803c8491d67f4fd55bf7d2e361dd84cb3446c0b69d74","e1925135643df3cd4edd50e89271c0ea72bbc831d8df057a5d3aa2c7c1e306bb","5339009792f23f83d49093312b5a08703ae0f97d21c9df78147ec2f7cbd83a8b","997d59aa9d973638f2f2b73cff2cafffaf74c66f813045947db6eec5b6a8296a","93628a1aa553363dafda0f05f33f8ccf0