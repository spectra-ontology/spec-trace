{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The ID of the serving cell for which the configuration is applicable or the group of serving cells as indicated by CellGroupsForSwitch-r16 containing this servingCellId.","paragraph_zero_based":34080},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34081},{"literal_text_all_w_t_and_m_t":"–S-NSSAI","paragraph_zero_based":34082},{"literal_text_all_w_t_and_m_t":"The IE S-NSSAI (Single Network Slice Selection Assistance Information) identifies a Network Slice end to end and comprises a slice/service type and a slice differentiator, see TS 23.003 [21].","paragraph_zero_based":34083},{"literal_text_all_w_t_and_m_t":"S-NSSAI information element","paragraph_zero_based":34084},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34085},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-START","paragraph_zero_based":34086},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34087},{"literal_text_all_w_t_and_m_t":"S-NSSAI  ::=                        CHOICE{","paragraph_zero_based":34088},{"literal_text_all_w_t_and_m_t":"    sst                                 BIT STRING (SIZE (8)),","paragraph_zero_based":34089},{"literal_text_all_w_t_and_m_t":"    sst-SD                              BIT STRING (SIZE (32))","paragraph_zero_based":34090},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34091},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34092},{"literal_text_all_w_t_and_m_t":"-- TAG-S-NSSAI-STOP","paragraph_zero_based":34093},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34095},{"literal_text_all_w_t_and_m_t":"S-NSSAI field descriptions","paragraph_zero_based":34096},{"literal_text_all_w_t_and_m_t":"sst","paragraph_zero_based":34097},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type, see TS 23.003 [21].","paragraph_zero_based":34098},{"literal_text_all_w_t_and_m_t":"sst-SD","paragraph_zero_based":34099},{"literal_text_all_w_t_and_m_t":"Indicates the S-NSSAI consisting of Slice/Service Type and Slice Differentiator, see TS 23.003 [21].","paragraph_zero_based":34100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34101},{"literal_text_all_w_t_and_m_t":"–SpeedStateScaleFactors","paragraph_zero_based":34102},{"literal_text_all_w_t_and_m_t":"The IE SpeedStateScaleFactors concerns factors, to be applied when the UE is in medium or high speed state, used for scaling a mobility control related parameter.","paragraph_zero_based":34103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["191b63a302c87b13991014df7237b1d39460adf10f41d98e7432a3511d35d9a1","9b73b0e3669c44e05a726c5adf8a244d5f0cf9195750c94aa87ccb0593f541d7","07e9027fdaa6246fbbf33a923d18f6cd61364a8c694024a756d875509b9d72f7","8838581c3e7ba49ed09d93e6878e516547018696f487d14bbc599df3e6734d25","581ed0178f9c48ec58473d828013a7f8da5528810118613bc746abed8e92975e","b8b8253b7df8c1bf015fab394f19fef99dc358b17a3e4324ad7079cc5e93b886","be27f8e96a8b39f5b568beb2feb13d9230e58944a935968d4db0e493d42ad1d8","c6c537db092090a5ffb67b9efe383535e1d9bc241eb12afe20381ac82efa2b1f","3df508077636f925aca3566c76365f2896379dae36bd576c742dbd1a1daa9ca4","817d1d16e25170d934cee9657b2b19c4b902c9f32ae6b9dabefa3da43b8b4d5f","decb5377e6383f03d4a1260b8dc771f4a691beebe6164f30d044d75fad08d3f2","5040b06015a28d8fa5fc4c051969e8c92a85afa3144612c1aff29937cb255658","5fb89d2a4a40b2dd622a687b8bb1521b10f245ca61ee63380fcd0b3078e0a6ce","0fa8e903cd26e22e91a8d2134d9ba3db44825168a7cbab9bfcff65a736a09e39","2af2d473dee3a705fc38bb4dee0c8bc09260cdfdbb38e7839c212e2ff7f81f6f","272a17dd31499b4f70d1792cc7553be14e0a4a932bdcec45f93957230cc68507","797c631988ba9ceee2ff9ae11fab388fdab987a1be596c9ec2d569d2e35414c9","1cb4851e3416625a21e08e34eb8ade6a5c1a001ae9c307f813b586879f2d25b5","6d8c4a784629632c904012aa52e677149b47889ce9f650e7639fc655b89cd2da","676feeeb13cdbcca2db392a72bd9ab81add0f768383166f68eb8d38e1378fb6d","c94d527e072c35c3a0c3390207a0b1a5cd8848f00ad711822ee0dfab3d43812f","ccdf2340b827b98ce392d796c98ef5e66c79646392a5f16cf37ebb1d2cee2a68","065b54c2d137329880130af50e330bc1f181d3482e258eaed1c761128289a811","543b3bcfb919c40393a32e647326ac9786f2b208824f3686adfdb1e78b20c957"],"paragraph_range_zero_based":[34080,34103],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p34080"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors information element","paragraph_zero_based":34104},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34105},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-START","paragraph_zero_based":34106},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34107},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors ::=          SEQUENCE {","paragraph_zero_based":34108},{"literal_text_all_w_t_and_m_t":"    sf-Medium                           ENUMERATED {oDot25, oDot5, oDot75, lDot0},","paragraph_zero_based":34109},{"literal_text_all_w_t_and_m_t":"    sf-High                             ENUMERATED {oDot25, oDot5, oDot75, lDot0}","paragraph_zero_based":34110},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34111},{"literal_text_all_w_t_and_m_t":"-- TAG-SPEEDSTATESCALEFACTORS-STOP","paragraph_zero_based":34112},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34113},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34114},{"literal_text_all_w_t_and_m_t":"SpeedStateScaleFactors field descriptions","paragraph_zero_based":34115},{"literal_text_all_w_t_and_m_t":"sf-High","paragraph_zero_based":34116},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in High Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, oDot75 corresponds to 0.75 and so on.","paragraph_zero_based":34117},{"literal_text_all_w_t_and_m_t":"sf-Medium","paragraph_zero_based":34118},{"literal_text_all_w_t_and_m_t":"The concerned mobility control related parameter is multiplied with this factor if the UE is in Medium Mobility state as defined in TS 38.304 [20]. Value oDot25 corresponds to 0.25, value oDot5 corresponds to 0.5, value oDot75 corresponds to 0.75, and so on.","paragraph_zero_based":34119},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34120},{"literal_text_all_w_t_and_m_t":"–SPS-Config","paragraph_zero_based":34121},{"literal_text_all_w_t_and_m_t":"The IE SPS-Config is used to configure downlink semi-persistent transmission. Multiple Downlink SPS configurations may be configured in one BWP of a serving cell.","paragraph_zero_based":34122},{"literal_text_all_w_t_and_m_t":"SPS-Config information element","paragraph_zero_based":34123},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34124},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-CONFIG-START","paragraph_zero_based":34125},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34126},{"literal_text_all_w_t_and_m_t":"SPS-Config ::=                  SEQUENCE {","paragraph_zero_based":34127}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["957a771dc33856a9e37164f2d0271f349aff639bd3b032fec9a7a0b345f2b66e","a0f98370910d06d5c2a47017e57ad2294dff380ac969dee7ffeebe6bf7dbefdf","f069148daf761c29ad71d7ae59fcbbc1634d7b3eef813bb02411a588e626d685","d82cf50d0810baea7aad93bd1b23acf532938e857b4221e3e9d7cf2ecd04eda5","64a3732eab17a639dc3bb4dc425d62392a82472b05699c8be85e3495d9241c0f","2287579e847b91f6b5f2783de1163a8de4de10738029646d6f77a67fb6907fe3","e856037a4c43cbd302c933e148ea547911eced93026cf953389fde9c275efc33","f98d009f7bf3282359417b5a01a8a360f38011b9079b58ad5c34938ecc8a2beb","73d24393cff1cdf7f29d293f47338f0a6d73390e30ea580e86699121ab5c97ee","e705edba532ad0d6173747402a382d07027e9a8dbb821a4a5fc0dbb1058d2bcb","e93559fd784a45d665901a121ea370c61eade39596cdb58e195cd15c1130a47b","257b1ed0e6