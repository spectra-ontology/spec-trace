{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"3>notify upper layers that clockQualityDetailsLevel may have changed;","paragraph_zero_based":1080},{"literal_text_all_w_t_and_m_t":"3>store the eventID-TSS received within SIB9 as the storedEventID within VarTSS-Info;","paragraph_zero_based":1081},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":1082},{"literal_text_all_w_t_and_m_t":"4>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of NPN-IdentityInfoList in SIB1 as defined in TS 38.413 [42];","paragraph_zero_based":1083},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1084},{"literal_text_all_w_t_and_m_t":"4>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, and PLMN-Identity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, as defined in TS 38.413 [42];","paragraph_zero_based":1085},{"literal_text_all_w_t_and_m_t":"3> store the gNB identity derived from SIB1 as the storedGnbID within VarTSS-Info.","paragraph_zero_based":1086},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1087},{"literal_text_all_w_t_and_m_t":"3>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":1088},{"literal_text_all_w_t_and_m_t":"4>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of NPN-IdentityInfoList in SIB1 as defined in TS 38.413 [42];","paragraph_zero_based":1089},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":1090},{"literal_text_all_w_t_and_m_t":"4>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, and PLMN-Identity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, as defined in TS 38.413 [42];","paragraph_zero_based":1091},{"literal_text_all_w_t_and_m_t":"3>if the storedGnbID within VarTSS-Info is different from the gNB identity derived from SIB1:","paragraph_zero_based":1092},{"literal_text_all_w_t_and_m_t":"4>notify upper layers that clockQualityDetailsLevel may have changed;","paragraph_zero_based":1093},{"literal_text_all_w_t_and_m_t":"4>store the gNB identity derived from SIB1 as the storedGnbID within VarTSS-Info.","paragraph_zero_based":1094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1095},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":1096},{"literal_text_all_w_t_and_m_t":"2>store the eventID-TSS received within SIB9 as the storedEventID within VarTSS-Info;","paragraph_zero_based":1097},{"literal_text_all_w_t_and_m_t":"2>if the UE is NPN capable and the cell is an NPN-only cell:","paragraph_zero_based":1098},{"literal_text_all_w_t_and_m_t":"3>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of NPN-IdentityInfoList in SIB1 as defined in TS 38.413 [42];","paragraph_zero_based":1099},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":1100},{"literal_text_all_w_t_and_m_t":"3>derive the gNB identity from gNB-ID-Length and cellIdentity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, and PLMN-Identity of the first PLMN-IdentityInfo list entry of PLMN-IdentityInfoList in SIB1, as defined in TS 38.413 [42];","paragraph_zero_based":1101},{"literal_text_all_w_t_and_m_t":"2>store the gNB identity derived from SIB1 as the storedGnbID value within VarTSS-Info;","paragraph_zero_based":1102},{"literal_text_all_w_t_and_m_t":"2>notify upper layers that clockQualityDetailsLevel may have changed.","paragraph_zero_based":1103}],"source":"Whole authentic original CR source member; all unfiltered body an