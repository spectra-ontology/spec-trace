{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RelayLCH-SetupOnly","paragraph_zero_based":36048},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon creation of a new logical channel for a Uu Relay RLC channel. It is absent otherwise.","paragraph_zero_based":36049},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36050},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelID","paragraph_zero_based":36051},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelID is used to identify a Uu Relay RLC channel in the link between L2 U2N Relay UE and network.","paragraph_zero_based":36052},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID information element","paragraph_zero_based":36053},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36054},{"literal_text_all_w_t_and_m_t":"-- TAG-UU-RELAYRLC-CHANNELID-START","paragraph_zero_based":36055},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36056},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelID-r17 ::= INTEGER (1..maxLC-ID)","paragraph_zero_based":36057},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36058},{"literal_text_all_w_t_and_m_t":"-- TAG-UU-RELAYRLC-CHANNELID-STOP","paragraph_zero_based":36059},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36060},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36061},{"literal_text_all_w_t_and_m_t":"–UplinkTxDirectCurrentList","paragraph_zero_based":36062},{"literal_text_all_w_t_and_m_t":"The IE UplinkTxDirectCurrentList indicates the Tx Direct Current locations per serving cell for each configured UL BWP in the serving cell, based on the BWP numerology and the associated carrier bandwidth.","paragraph_zero_based":36063},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentList information element","paragraph_zero_based":36064},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36065},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKTXDIRECTCURRENTLIST-START","paragraph_zero_based":36066},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36067},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentList ::=           SEQUENCE (SIZE (1..maxNrofServingCells)) OF UplinkTxDirectCurrentCell","paragraph_zero_based":36068},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36069},{"literal_text_all_w_t_and_m_t":"UplinkTxDirectCurrentCell ::=           SEQUENCE {","paragraph_zero_based":36070},{"literal_text_all_w_t_and_m_t":"    servCellIndex                           ServCellIndex,","paragraph_zero_based":36071}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9025fd2c412923c571b99d8d956e17d8338406478b31bd1fd1b8fd6febf38f66","cd6aeb89005a02381b132741fba37b61f4016e2124af8f9f1a24ef5475ea1bf0","b9fcb933fc10921b5ae4dc9d799041ddd3a8921bf089551acd1476a1cdcf4fb6","325db0612b1fdb10783a9810bd91e59ef1d3a8f15946575c7d6bf6a1c9b8af6e","ef648ba204eacb4e0e99097587c4d0b902392610c173c90ee250dd24179b7c6d","318734edb8b8eadc9c31358a7b14f53338b4a0c6153b2dcc4fa82bc7b87e7979","0f964529a87d45079336dc9ce63137aff82b1d388ccf57250b1f877ec98e222e","9504ddebb301c8dff90bb4842a77f9e87897b06403e00d86fec28589101d74b7","49cd44ecef4c9db5e0d47fcde36bc0674a5c40b3b74b5b9de1651f44c5f00bdb","50e8cf26d5865daceebf276d4405ea84300773aa5c98d35fe00fc5f10c581e44","d3f993a66fb589bdc65644b3d7e11d58c94d8bcd9477703312f8e7d6cc961a88","3d987d7fe9917bff9d720c889b9a3b27365f9485c591a483e499219f3b80b4eb","d2b52fffc8967b1d610c17d50a8d332ac6e76a389e7ca87a7abb013ca5bcfe5e","adcc83f87e4663a96a90b3718b6e17ca1eae66759d2f107b14acf5898