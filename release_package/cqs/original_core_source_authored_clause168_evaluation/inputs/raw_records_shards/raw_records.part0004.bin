76b0ad13fb25a0698ac88828ddaf56ab0ac63f759d33eea4758","d8779ee4c827bf71d7573463ff46bf19163be44c13052deeb48291f401b39966","edd11dd398123b649280a894c9756b81923f4216787d7ad06c78510ad91d5aad","6b4b819cb7c97e805e3d979e08b5b741e7d8ed249ac2ba56222fd2a899b9afba","be67dc3caec695e999a3bc8f10079e361dc91318a38a7b3e793de4396b97c485","7b7371e935dcd5d14c6d6695abd9cb42a32ebf6cdd7873e82b87bed5eeb34b9f","7a7980146a93352bdae2f1627036a771e1679c21aa0a86e149930bfc6f9cff84","13ad857fc3747a5a834a94758fb472b12dcf291ad9c3bcf728666498df33bd28"],"paragraph_range_zero_based":[16656,16679],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p16656"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16680},{"literal_text_all_w_t_and_m_t":"SIB3 field descriptions","paragraph_zero_based":16681},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":16682},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that intra-frequency neighbor cells apply channel access mode procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the intra-frequency neighbor cells do not apply any channel access procedure.","paragraph_zero_based":16683},{"literal_text_all_w_t_and_m_t":"intraFreqAllowedCellList","paragraph_zero_based":16684},{"literal_text_all_w_t_and_m_t":"List of allow-listed intra-frequency neighbouring cells, see TS 38.304 [20], clause 5.2.4.","paragraph_zero_based":16685},{"literal_text_all_w_t_and_m_t":"intraFreqCAG-CellList","paragraph_zero_based":16686},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring CAG cells (as defined in TS 38.304 [20]) per PLMN.","paragraph_zero_based":16687},{"literal_text_all_w_t_and_m_t":"intraFreqExcludedCellList","paragraph_zero_based":16688},{"literal_text_all_w_t_and_m_t":"List of exclude-listed intra-frequency neighbouring cells.","paragraph_zero_based":16689},{"literal_text_all_w_t_and_m_t":"intraFreqNeighCellList","paragraph_zero_based":16690},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring cells with specific cell re-selection parameters. If intraFreqNeighCellList-v1610 is present, it shall contain the same number of entries, listed in the same order as in intraFreqNeighCellList (without suffix).","paragraph_zero_based":16691},{"literal_text_all_w_t_and_m_t":"intraFreqNeighHSDN-CellList","paragraph_zero_based":16692},{"literal_text_all_w_t_and_m_t":"List of intra-frequency neighbouring HSDN cells as specified in TS 38.304 [20].","paragraph_zero_based":16693},{"literal_text_all_w_t_and_m_t":"q-OffsetCell","paragraph_zero_based":16694},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsets,n\" in TS 38.304 [20].","paragraph_zero_based":16695},{"literal_text_all_w_t_and_m_t":"q-QualMinOffsetCell","paragraph_zero_based":16696},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffsetcell\" in TS 38.304 [20]. Actual value Qqualminoffsetcell = field value [dB].","paragraph_zero_based":16697},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCell","paragraph_zero_based":16698},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffsetcell\" in TS 38.304 [20]. Actual value Qrxlevminoffsetcell = field value * 2 [dB].","paragraph_zero_based":16699},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffsetCellSUL","paragraph_zero_based":16700},{"literal_text_all_w_t_and_m_t":"Parameter \"QrxlevminoffsetcellSUL\" in TS 38.304 [20]. Actual value QrxlevminoffsetcellSUL = field value * 2 [dB].","paragraph_zero_based":16701},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":16702},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SS/PBCH blocks for a specific intra-frequency neighbor cell as specified in TS 38.213 [13], clause 4.1. If provided, the cell specific value overwrites the value signalled by ssb-PositionQCL-Common in SIB2 for the indicated cell.","paragraph_zero_based":16703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["18ae2845ddb9a69eb48939548701d4a50cf91529555b7e3a5777bb726e5c2b06","c30149758d02fc25d78c089f59b626f176a88c4f2ce9503ca571946f44c56d22","dfc2024d077b614120961e68095f6cce