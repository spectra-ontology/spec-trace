{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pucch-PathlossReferenceRS-Id-v1610        PUCCH-PathlossReferenceRS-Id-v1610                             OPTIONAL,    --Need R","paragraph_zero_based":28992},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":28993},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28995},{"literal_text_all_w_t_and_m_t":"PUCCH-SRS ::=                       SEQUENCE {","paragraph_zero_based":28996},{"literal_text_all_w_t_and_m_t":"    resource                            SRS-ResourceId,","paragraph_zero_based":28997},{"literal_text_all_w_t_and_m_t":"    uplinkBWP                           BWP-Id","paragraph_zero_based":28998},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28999},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29000},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-SPATIALRELATIONINFO-STOP","paragraph_zero_based":29001},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29002},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29003},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo field descriptions","paragraph_zero_based":29004},{"literal_text_all_w_t_and_m_t":"pucch-PathLossReferenceRS-Id","paragraph_zero_based":29005},{"literal_text_all_w_t_and_m_t":"When pucch-PathLossReferenceRS-Id-v1610 is configured, the UE shall ignore pucch-PathLossReferenceRS-Id (without suffix).","paragraph_zero_based":29006},{"literal_text_all_w_t_and_m_t":"pucch-SpatialRelationInfoId","paragraph_zero_based":29007},{"literal_text_all_w_t_and_m_t":"When pucch-SpatialRelationInfoId-v1610 is configured, the UE shall ignore pucch-SpatialRelationInfoId (without suffix). If pucch-SpatialRelationInfoId-v1610 is absent, the UE shall use the pucch-SpatialRelationInfoId (without suffix).","paragraph_zero_based":29008},{"literal_text_all_w_t_and_m_t":"servingCellId","paragraph_zero_based":29009},{"literal_text_all_w_t_and_m_t":"If the field is absent, the UE applies the ServCellId of the serving cell in which this PUCCH-SpatialRelationInfo is configured","paragraph_zero_based":29010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29011},{"literal_text_all_w_t_and_m_t":"–PUCCH-SpatialRelationInfo-Id","paragraph_zero_based":29012},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-SpatialRelationInfo-Id is used to identify a PUCCH-SpatialRelationInfo","paragraph_zero_based":29013},{"literal_text_all_w_t_and_m_t":"PUCCH-SpatialRelationInfo-Id information element","paragraph_zero_based":29014},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3ecef283b55475979a78857ea0ea802f2d04a72ce410e96620eb19ce444ac7c8","01e34f2813e3a4dff41da7120d03af06f7cce4fb28b4c0e8e9d65ab9926a7504","7bc83a4d60232022afdb7a29423dc7d72bfaeb313c466f7d3054b8b2667835ff","f3119436e1438248e1d97a00ae6e7a1f1d50f31212a4f1beba828cc136f6d7c8","1657bb63675df76b47ebce1397010bab5b5eb0dfe0a9785e2918b18c0850c78a","d49120504ddb25d17a9180ff06b4989dc48013426940a61ab0f5fb408c87bae3","79fd280b4099acf7f9ba665e19a81f3d7222e115924e0a6b263b449bffd50837","6d0bf0f9ad4beab30f960abd37a96843a1d691293d17c7df9aa8932802cb6c4b","bb8e8a6f44157c4f696e59510213d440e9ace0367c4bc6c530d30ca86f11619d","f1c62b96c16bde0a86bb310e3eb7d0917387562395f6ba7890ae249b3bbfbb78","e0483696c0f0339cb413d04cea4b1baba65d3b0010f730ea6077d75f2650e595","d62bbc39a6a815a0e1fdbd548b8e2e09717197a57cb3e8c7279fd6cb3ed3a939","5632ba284065c9899dbf9d504f4bfd4