{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Inequality A6-2 (Leaving condition)","paragraph_zero_based":6120},{"literal_text_all_w_t_and_m_t":"Mn + Ocn + Hys < Ms + Ocs + Off","paragraph_zero_based":6121},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6122},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the neighbouring cell, not taking into account any offsets.","paragraph_zero_based":6123},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the neighbour cell (i.e. cellIndividualOffset as defined within the associated measObjectNR), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":6124},{"literal_text_all_w_t_and_m_t":"Ms is the measurement result of the serving cell, not taking into account any offsets.","paragraph_zero_based":6125},{"literal_text_all_w_t_and_m_t":"Ocs is the cell specific offset of the serving cell (i.e. cellIndividualOffset as defined within the associated measObjectNR, or cellIndividualOffset as defined within reportConfigNR), and is set to zero if not configured for the serving cell.","paragraph_zero_based":6126},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":6127},{"literal_text_all_w_t_and_m_t":"Off is the offset parameter for this event (i.e. a6-Offset as defined within reportConfigNR for this event).","paragraph_zero_based":6128},{"literal_text_all_w_t_and_m_t":"Mn, Ms are expressed in dBm in case of RSRP, or in dB in case of RSRQ and RS-SINR.","paragraph_zero_based":6129},{"literal_text_all_w_t_and_m_t":"Ocn, Ocs, Hys, Off are expressed in dB.","paragraph_zero_based":6130},{"literal_text_all_w_t_and_m_t":"5.5.4.8Event B1 (Inter RAT neighbour becomes better than threshold)","paragraph_zero_based":6131},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6132},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition B1-1, as specified below, is fulfilled;","paragraph_zero_based":6133},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition B1-2, as specified below, is fulfilled.","paragraph_zero_based":6134},{"literal_text_all_w_t_and_m_t":"Inequality B1-1 (Entering condition)","paragraph_zero_based":6135},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh","paragraph_zero_based":6136},{"literal_text_all_w_t_and_m_t":"Inequality B1-2 (Leaving condition)","paragraph_zero_based":6137},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh","paragraph_zero_based":6138},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6139},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the inter-RAT neighbour cell, not taking into account any offsets.","paragraph_zero_based":6140},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the frequency of the inter-RAT neighbour cell (i.e. eutra-Q-OffsetRange as defined within the measObjectEUTRA corresponding to the frequency of the neighbour inter-RAT cell, utra-FDD-Q-OffsetRange as defined within the measObjectUTRA-FDD corresponding to the frequency of the neighbour inter-RAT cell).","paragraph_zero_based":6141},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the inter-RAT neighbour cell (i.e. cellIndividualOffset as defined within the measObjectEUTRA corresponding to the neighbour inter-RAT cell, or cellIndividualOffset as defined within reportConfigInterRAT), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":6142},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":6143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e38a3b4b2fc3c10274d63f58c54546c882eb0555f7e9fcf4de24b3ad846edef9","edbd2709d5bafbeef580deae92c6d95852e87b2526c1973ec172085b5e7ed4e9","fa868bed7fc7425a72275859d426b7443a8a1b63ea2a233720b053196dfa1406","f81c9aeb790de5fd4debc43a93491f9f4bbf99b767af967a247eba80dd9954fa","6fedc0be90610ffe6c00f65ec9f991b046088c356659aab1975161e9d2f0a782","78f29addd656951167a88f96ed849ec3cc8df50ffb01e1a7f2752aea9f03050d","da54e107b5be815c31fad7433a72f26dc6de1dfa58a9b84097b856df5e2e130c","e5d57c2f285b3ee26d8f2270050a75f385bbb35ae082f38e4e9e2fcfdd45651f","915eda072f7dd8085d20276097996e0151f28d571a27e4a59cbf959776060a77","ea8fc47b920d39d06b30ccf28606ee83f74343ea9d875a295a9100145b590df2","4a079f67b682dfde2c67ae2dbd185417e52bd9756605bbd13d61d817cb5b820a","72d8ed02688d100407df2acd457522096b1004a41e490fdd4583a4b8fb94e512","3963b165d87d77059278d2eebc28bc099b77acd4629f199e43bf8478e36a5d1b","b1fcdd0db65273dab90f301a1e694a4b8575901196e67dffa3581de0121a6dd5","3f6c5cb6eb91d5e6546bcff96299620d2d858adb66e3472b34a6a6a667d1cbfa","da2c7b442e2cc07ad49ac9bb1d49fb02493224b8c4ade61116556b2366577d67","76f0bbbc12cb1b1972c35ec047d78f09c3357592c1e31d5ece6bbb9fd80c36eb","ea4ff8f06fc5e60a7b0c7cfc2c2d8908a3eaa5e47e7953ce7bcce7aa9b2078d7","3adf5bd73d93ef9199161e87ca35cad715cc0c42f2813e9bf06661fa74d07b7c","ce2364d65cbc55ab4401cee26c0dfb55192d9e472e2f5ba41ed6a03edca656b3","b99d3768d4506cc949ec0edbf2c0ff9f2d156164b20325d1dbfdc7fa4fd7839a","60d1f86cd0d1123319e6a53c013670b6f3638e4a6b812b312126af7e8b333482","bbc61c379612fea8778293f27d2e085877721d71b5d0203f2d85f7b89de73200","7740aeff68b05f9d9a0b65848d01bf54aaf28847adf0a54a58bd300ce5b99f37"],"paragraph_range_zero_based":[6120,6143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. b1-ThresholdEUTRA as defined within reportConfigInterRAT for this event, b1-ThresholdUTRA-FDD as defined for UTRA-FDD within reportConfigInterRAT for this event).","paragraph_zero_based":6144},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm or in dB, depending on the measurement quantity of the inter-RAT neighbour cell.","paragraph_zero_based":6145},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":6146},{"literal_text_all_w_t_and_m_t":"Thresh is expressed in the same unit as Mn.","paragraph_zero_based":6147},{"literal_text_all_w_t_and_m_t":"5.5.4.9Event B2 (PCell becomes worse than threshold1 and inter RAT neighbour becomes better than threshold2)","paragraph_zero_based":6148},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6149},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when both condition B2-1 and condition B2-2, as specified below, are fulfilled;","paragraph_zero_based":6150},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition B2-3 or condition B2-4, i.e. at least one of the two, as specified below, is fulfilled;","paragraph_zero_based":6151},{"literal_text_all_w_t_and_m_t":"Inequality B2-1 (Entering condition 1)","paragraph_zero_based":6152},{"literal_text_all_w_t_and_m_t":"Mp + Hys < Thresh1","paragraph_zero_based":6153},{"literal_text_all_w_t_and_m_t":"Inequality B2-2 (Entering condition 2)","paragraph_zero_based":6154},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn – Hys > Thresh2","paragraph_zero_based":6155},{"literal_text_all_w_t_and_m_t":"Inequality B2-3 (Leaving condition 1)","paragraph_zero_based":6156},{"literal_text_all_w_t_and_m_t":"Mp – Hys > Thresh1","paragraph_zero_based":6157},{"literal_text_all_w_t_and_m_t":"Inequality B2-4 (Leaving condition 2)","paragraph_zero_based":6158},{"literal_text_all_w_t_and_m_t":"Mn + Ofn + Ocn + Hys < Thresh2","paragraph_zero_based":6159},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6160},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the PCell, not taking into account any offsets.","paragraph_zero_based":6161},{"literal_text_all_w_t_and_m_t":"Mn is the measurement result of the inter-RAT neighbour cell, not taking into account any offsets.","paragraph_zero_based":6162},{"literal_text_all_w_t_and_m_t":"Ofn is the measurement object specific offset of the frequency of the inter-RAT neighbour cell (i.e. eutra-Q-OffsetRange as defined within the measObjectEUTRA corresponding to the frequency of the inter-RAT neighbour cell, utra-FDD-Q-OffsetRange as defined within the measObjectUTRA-FDD corresponding to the frequency of the neighbour inter-RAT cell).","paragraph_zero_based":6163},{"literal_text_all_w_t_and_m_t":"Ocn is the cell specific offset of the inter-RAT neighbour cell (i.e. cellIndividualOffset as defined within the measObjectEUTRA corresponding to the neighbour inter-RAT cell, or cellIndividualOffset as defined within reportConfigInterRAT), and set to zero if not configured for the neighbour cell.","paragraph_zero_based":6164},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigInterRAT for this event).","paragraph_zero_based":6165},{"literal_text_all_w_t_and_m_t":"Thresh1 is the threshold parameter for this event (i.e. b2-Threshold1 as defined within reportConfigInterRAT for this event).","paragraph_zero_based":6166},{"literal_text_all_w_t_and_m_t":"Thresh2 is the threshold parameter for this event (i.e. b2-Threshold2EUTRA as defined within reportConfigInterRAT for this event, b2-Threshold2UTRA-FDD as defined for UTRA-FDD within reportConfigInterRAT for this event).","paragraph_zero_based":6167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8a390f3eab41a3e97cf7762ff70f1fd666907b94993a0d33ea60052d897dcadb","751358be31d2edc159f78ec4195c50f71a0d6a8f069c22e29d2dcc6f63c1fb97","e8df711b5f0ea4fd5ba6483006b31a0ebb9d4ce601e373632708729d28a91397","2c62efe8fda88a3f213fa5402d52694a207283ae65caf4816528abf0cb3c0d62","fcca3d48897c9ca505851c17d438e5eb3a73e68391ddb410a25edf9f45425d7a","0dc792d258ce012a1c139cd252011a892ffba6d66d9f2b72afe86417f6606e69","cdceabd8d9fe9bd38cf97ec8a7bf01bf3ac5385cce52810bea3be30acc49a3b2","aa620280c618685e1ae1f1be664b7907ed4473b42c3fa5358ce96a13c5c93257","57038bde36cc07ab8eece22919d3a9eedd1b1c08c93efc2c0e31cbae175c8451","d274512dec45f583f046efbf0609f66a9b4c63acc7c0a538f89dc23417182fac","81556312ee3c78dbacca558e63a18c792048c039eb6f6dd1f42b824fc2f4795b","3cd4fff554f1ac61ffe1c9eae8e52dda8447f5d704da36177c125644dc553129","90567ab2e2ed42a73aef98466007961d9e58b0b6532c15e51a598faad7af0bdd","2e1145e27ceb5c63a392512cdda6820f7a55b8a830a9820e8f52a0cebcc8d802","c82a39218b1d248430519ab4fdcc6473ad6ede6866e687bddb64ebfc4a51776a","a66ddc46215f60118d2a4a560c7ab341c306ed04570fa2e612a1b73ad2a66714","13bdab42990c906b094552680cd540efbde39afb707a365acdc2bafb69cbe24f","8c4dbf9364c9abee90a787f2833475d0ff875dbbf1f4a22ba25d4318f0fa05a3","13040227bb7efd514ee07ac700775addda0bf3fe9007b7470606255e02a1e35c","afa9ef9953c4ef3f66daab322ae21ded5b84b624a316cbb1a4edc50c6579afa3","dfe8f45619cb89f7740f86ba1f95035a8d12d2e2e2fc9736adb43ef54b8b7751","c197145d48fa1dc5352a60a487cfab78e3517dc0f0371f4bbc55f78689f691a8","75353b19a565367a0fb2a9d56ac803bf8e0073defa21d7ad6a5d93284404bd0a","52b89f757aa53bd83699b368c6ee3390aa35f64ec5183d6ee240507643e96832"],"paragraph_range_zero_based":[6144,6167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p6144"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Mp is expressed in dBm in case of RSRP, or in dB in case of RSRQ and SINR.","paragraph_zero_based":6168},{"literal_text_all_w_t_and_m_t":"Mn is expressed in dBm or dB, depending on the measurement quantity of the inter-RAT neighbour cell.","paragraph_zero_based":6169},{"literal_text_all_w_t_and_m_t":"Ofn, Ocn, Hys are expressed in dB.","paragraph_zero_based":6170},{"literal_text_all_w_t_and_m_t":"Thresh1 is expressed in the same unit as Mp.","paragraph_zero_based":6171},{"literal_text_all_w_t_and_m_t":"Thresh2 is expressed in the same unit as Mn.","paragraph_zero_based":6172},{"literal_text_all_w_t_and_m_t":"5.5.4.10Event I1 (Interference becomes higher than threshold)","paragraph_zero_based":6173},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6174},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition I1-1, as specified below, is fulfilled;","paragraph_zero_based":6175},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition I1-2, as specified below, is fulfilled.","paragraph_zero_based":6176},{"literal_text_all_w_t_and_m_t":"Inequality I1-1 (Entering condition)","paragraph_zero_based":6177},{"literal_text_all_w_t_and_m_t":"Mi – Hys > Thresh","paragraph_zero_based":6178},{"literal_text_all_w_t_and_m_t":"Inequality I1-2 (Leaving condition)","paragraph_zero_based":6179},{"literal_text_all_w_t_and_m_t":"Mi+ Hys < Thresh","paragraph_zero_based":6180},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6181},{"literal_text_all_w_t_and_m_t":"Mi is the measurement result of the interference, not taking into account any offsets.","paragraph_zero_based":6182},{"literal_text_all_w_t_and_m_t":"Hys is the hysteresis parameter for this event (i.e. hysteresis as defined within reportConfigNR for this event).","paragraph_zero_based":6183},{"literal_text_all_w_t_and_m_t":"Thresh is the threshold parameter for this event (i.e. i1-Threshold as defined within reportConfigNR for this event).","paragraph_zero_based":6184},{"literal_text_all_w_t_and_m_t":"Mi, Thresh are expressed in dBm.","paragraph_zero_based":6185},{"literal_text_all_w_t_and_m_t":"Hys is expressed in dB.","paragraph_zero_based":6186},{"literal_text_all_w_t_and_m_t":"5.5.4.11Event C1 (The NR sidelink channel busy ratio is above a threshold)","paragraph_zero_based":6187},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":6188},{"literal_text_all_w_t_and_m_t":"1>consider the entering condition for this event to be satisfied when condition C1-1, as specified below, is fulfilled;","paragraph_zero_based":6189},{"literal_text_all_w_t_and_m_t":"1>consider the leaving condition for this event to be satisfied when condition C1-2, as specified below, is fulfilled;","paragraph_zero_based":6190},{"literal_text_all_w_t_and_m_t":"Inequality C1-1 (Entering condition)","paragraph_zero_based":6191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["96b3e89dcb14786f72ae63214083ed5a80cec8c82bd646a52c9242aa7b7a3458","686fc961f43c8be340a89ea11bf172ca3faa833c6ac34f9c49ba012bc1b447b5","3ba688cc539dc351fb59fbea4fb1fd677a834bcfb30bf0e86eeae4e667e3b490","4b9536d172da6ac39ce9efa9dc9de251d0f5d9697b6528de427ba090921b81c6","e2621ccbb9987d3d7e58ff380b1ba7ffca137d66b04f60dc30f7fd2294777544","388b63c0308d3c3802576aeacb1d03c1c1c6e3a74164bb7c4ea5c77d0ceb6071","3fc6ba35c1543535b472b7450f445bc2fc74d95