ased":35992},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToAddModList-IAB-MT","paragraph_zero_based":35993},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationToAddModList-IAB-MT allows overriding UL/DL allocations provided in tdd-UL-DL-configurationCommon with a limitation that effectively only flexible symbols can be overwritten in Rel-16.","paragraph_zero_based":35994},{"literal_text_all_w_t_and_m_t":"slotSpecificConfigurationsToReleaseList-IAB-MT","paragraph_zero_based":35995},{"literal_text_all_w_t_and_m_t":"The slotSpecificConfigurationsToReleaseList-IAB-MT allows release of a set of slot configuration previously add with slotSpecificConfigurationToAddModList-IAB-MT.","paragraph_zero_based":35996},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35997},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-SlotConfig field descriptions","paragraph_zero_based":35998},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":35999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2b6200a2f46d51a76e884c1bb9cbb61e87d7abccb9ff26ade6da62268fb2bcbb","364e0caf4774f4852884583d37f86e089e137cfe19cbebd4238bda6b5ee5730e","047fc35cb7fd7584fdd16546e715618172335ee4270abda4a9cb7a4404149941","6f51735cec0efa78854fb78141f8186a0e1c29d1c121707d57e7768600ee0e1b","fcf1a7f7d088319cf5df32300ebec0e1b6c2a34875191e21c72144be9ab207cd","0047ed9289afc38e962e66e6c7407cfe855ecbe177b81a5c567574564c98e657","1e7cd01eb8ce76ac46ec3f60ea22a5f87f7b851980d7116909710de66b3fa419","a2ae85fc68759fae68c65fcbc65f122a18758e91f9a48c0b5902b22f542b0dc4","0a9430c3cb301ca178e38db3efff57f5ba2ce58b01ee1d00f01a9cfab310bebc","f06fb7a53e83d565377d48810b4b0a44ae9b451d4cf4926b9cb