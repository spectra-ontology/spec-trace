{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44929},{"literal_text_all_w_t_and_m_t":"SL-PeriodCG-r16 ::=            CHOICE{","paragraph_zero_based":44930},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG1-r16               ENUMERATED {ms100, ms200, ms300, ms400, ms500, ms600, ms700, ms800, ms900, ms1000, spare6,","paragraph_zero_based":44931},{"literal_text_all_w_t_and_m_t":"                                               spare5, spare4, spare3, spare2, spare1},","paragraph_zero_based":44932},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG2-r16               INTEGER (1..99)","paragraph_zero_based":44933},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44934},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44935},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-STOP","paragraph_zero_based":44936},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44937},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44938},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig field descriptions","paragraph_zero_based":44939},{"literal_text_all_w_t_and_m_t":"rrc-ConfiguredSidelinkGrant","paragraph_zero_based":44940},{"literal_text_all_w_t_and_m_t":"Configuration for \"sidelink configured grant\" transmission with fully RRC-configured SL grant (Type1). If this field is not configured, the UE uses SL grant configured by DCI addressed to SL-CS-RNTI (Type2).","paragraph_zero_based":44941},{"literal_text_all_w_t_and_m_t":"sl-ConfigIndexCG","paragraph_zero_based":44942},{"literal_text_all_w_t_and_m_t":"This field indicates the ID to identify sidelink configured grant.","paragraph_zero_based":44943},{"literal_text_all_w_t_and_m_t":"sl-CG-MaxTransNumList","paragraph_zero_based":44944},{"literal_text_all_w_t_and_m_t":"This field indicates the maximum number of times that a TB can be transmitted using the resources provided by the sidelink configured grant. sl-Priority corresponds to the logical channel priority.","paragraph_zero_based":44945},{"literal_text_all_w_t_and_m_t":"sl-FreqResourceCG-Type1","paragraph_zero_based":44946},{"literal_text_all_w_t_and_m_t":"Indicates the frequency resource location of sidelink configured grant type 1. An index giving valid combinations of one or two starting sub-channel and length (jointly encoded) as resource indicator value (RIV), as defined in TS 38.214 [19].","paragraph_zero_based":44947},{"literal_text_all_w_t_and_m_t":"sl-HARQ-ProcID-Offset","paragraph_zero_based":44948},{"literal_text_all_w_t_and_m_t":"Indicates the offset used in deriving the HARQ process ID for sidelink configured grant type 1 or sidelink configured grant type 2, see TS 38.321 [3], clause 5.8.3.","paragraph_zero_based":44949},{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN","paragraph_zero_based":44950},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for sidelink configured grant type 1. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":44951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f1cd8ebe1400cc1c8db3caff5285ceb7e8a4f07f0b751bfa3b1a375641a1a363","ce4e8b558a8a6944cf71a3bb31736aeaf4cb676fe7f6a3d782dfa42630d109d1","2afdf70ca685f0ab7cfbb7939df04075a9fd65b3c3196b941e58f47a04f024a9","ee40001f0d17eaedaa9adbc1214261f151b73ca5f4126671881a99b12a908fc5","6d54f8aaf276a10b4592f4f2d237364d3e594864ad98d122552459477ec7b58e","bcdafc02610841b4e392659a955831fbe86a7e87c0135004c142f5a1413be74b","9295d69dd7244a73d05971fa42da5bad01e0b92ec5f9deff1d562cb960bdbd1f","950665d81aac8dd8ae7d5fc103a62cb5f76ff04f9d0ab185053c196e0ed81a31","618e3fd672a9efb5a331da4a7143d56f1465a96ad53126051f0f80b9fb60670f","c0eac4535cc441c3a88cc1121ccca3f564818b3ce8eb7066e82883aaf0c8cf9d","2fc44d329093961f258c794fca4ff3c3514bbfdea2dccd2358b909e7db535a73","dd47b582519fc1a67252290c11a4fb396e13cb3520afb8109126d3faf0b06b35","d7feeeaa7be09f76cf578ce40790e0a84af4876c81721a18a8d51f9369fa1eae","d4fc87b8e5f4c5559da24dcdd3a9efd2bd6da476f66650850b7a8c16dc733a07","4fab0bd9006a887301abb7e5fe3531c28f0e21abc8b8ed9d1f7c275eb541e370","a7bd7b97574930933b928f21f40c2aac6f2e831e2ee061c85a852a6e5222fa7b","7c27f0c001d5acd4a90cf7e5bba0557e94234b85f11e4960658011f82443e71c","9f0562796b3f48c519537d9cdbe1fd95d237d9e636b3eb677b1fa5c783aba1d5","1d0fde5b07e908c95fb509cbe75f6c3e9ffa96e5b7445dc15c8d08aa889abe8c","0ca3f5a1624230dc98aa14b1d5a0a89c59939ccbe0a3db5ee803b58ca07766d5","bc623b01073a40f052f21b35baffe69117525836c0736237e7b9df179166910e","08c03eab1f59abd1ef53874796950d360dcda42f1f5d2e1d428c9a78ddc4a6c4","af31793b58c70a642e5e9a296a8a7f2d6e9b679381b484d1dae6c6532ff23b3e","e17fb8b1d04b60347f0bb085d18949e5364d541ac808d79ab78de1c06106a427"],"paragraph_range_zero_based":[44928,44951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44928"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"sl-N1PUCCH-AN-Type2","paragraph_zero_based":44952},{"literal_text_all_w_t_and_m_t":"This field indicates the PUCCH resource for HARQ feedback for PSCCH/PSSCH transmissions without a corresponding PDCCH on sidelink configured grant type 2. The actual PUCCH-Resource is configured in sl-PUCCH-Config and referred to by its ID.","paragraph_zero_based":44953},{"literal_text_all_w_t_and_m_t":"sl-NrOfHARQ-Processes","paragraph_zero_based":44954},{"literal_text_all_w_t_and_m_t":"This field indicates the number of HARQ processes configured for a specific sidelink configured grant. It applies for both type 1 and type 2.","paragraph_zero_based":44955},{"literal_text_all_w_t_and_m_t":"sl-PeriodCG","paragraph_zero_based":44956},{"literal_text_all_w_t_and_m_t":"This field indicates the period of sidelink configured grant in the unit of ms.","paragraph_zero_based":44957},{"literal_text_all_w_t_and_m_t":"sl-PSFCH-ToPUCCH-CG-Type1","paragraph_zero_based":44958},{"literal_text_all_w_t_and_m_t":"This field, for sidelink configured grant type 1, indicates slot offset between the PSFCH associated with the last PSSCH resource of each period and the PUCCH occasion used for reporting sidelink HARQ.","paragraph_zero_based":44959},{"literal_text_all_w_t_and_m_t":"sl-ResourcePoolID","paragraph_zero_based":44960},{"literal_text_all_w_t_and_m_t":"Indicates the resource pool in which the sidelink configured grant type 1 is applied.","paragraph_zero_based":44961},{"literal_text_all_w_t_and_m_t":"sl-StartRBsetCG-Type1","paragraph_zero_based":44962},{"literal_text_all_w_t_and_m_t":"Indicates starting RB set index of the initial PSSCH transmission of the sidelink configured grant Type 1 for interlace RB-based PSSCH transmission.","paragraph_zero_based":44963},{"literal_text_all_w_t_and_m_t":"sl-StartSubchannelCG-Type1","paragraph_zero_based":44964},{"literal_text_all_w_t_and_m_t":"This field indicates the starting sub-channel of sidelink configured grant type 1. An index giving valid sub-channel index.","paragraph_zero_based":44965},{"literal_text_all_w_t_and_m_t":"sl-TimeOffsetCG-Type1","paragraph_zero_based":44966},{"literal_text_all_w_t_and_m_t":"This field indicates the slot offset with respect to logical slot defined by sl-TimeReferenceSFN-Type1, as specified in TS 38.321 [3].","paragraph_zero_based":44967},{"literal_text_all_w_t_and_m_t":"sl-TimeReferenceSFN-Type1","paragraph_zero_based":44968},{"literal_text_all_w_t_and_m_t":"Indicates SFN used for determination of the offset of a resource in time domain. If it is present, the UE uses the 1st logical slot of associated resource pool after the starting time of the closest SFN with the indicated number preceding the reception of the sidelink configured grant configuration type 1 as reference logical slot, see TS 38.321 [3], clause 5.8.3. If it is not present, the reference SFN is 0.","paragraph_zero_based":44969},{"literal_text_all_w_t_and_m_t":"sl-TimeResourceCG-Type1","paragraph_zero_based":44970},{"literal_text_all_w_t_and_m_t":"This field indicates the time resource location of sidelink configured grant type 1. An index giving valid combinations of up to two slot positions (jointly encoded) as time resource indicator value (TRIV), as defined in TS 38.212 [17].","paragraph_zero_based":44971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44973},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfigDedicatedSL-PRS-RP","paragraph_zero_based":44974},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfigDedicatedSL-PRS-RP specifies the configured grant configuration information for NR sidelink positioning in a dedicated SL-PRS resource pool.","paragraph_zero_based":44975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d376fd2a6c28cf395e473b9d61284b54e7ba51e3767e53378eae75a68056599e","24d51bafeadb4f290a24e8c4aab1ca97397ef46718a24d6f6b993a28c130402b","079e040fcf96d92060a3d6fbda9ae2fd896bde6cfa82b796fbe18531ce687648","e2c2790c8fea37050903226d79260cb8949e0217c902c29900baa48f0ad284f9","25a99639b703bc4528fadc168efb648fb927d4b3ee8a4c1e8b1dc8e467c4d1bb","6ab7df4229099f1216fc87a91477ac79d43c33d5d85b640eddd96d5511fbc0f0","c3bceccc6f2cb709f81ef19c8bf0dd5dbd069f3f7138e0c9686a0b015bae5cba","bfea24c5134d1274b3a5e74ec3e616e3e6141eb2a4a2b6d9d01aaeb389ce6dc7","39d67e69146719ceb515816a0706571d03540c696aa7748300a6c8d0bb77662f","f3095b7ddc5441cd6ad503ca613ad314498ddb130ace3605d9507cda69f0f4be","a6c259382e4106b7fb2a7d2c2348b7f14fd6516f9463418a2418bffaccb28e16","ba0d8cff48a5c4d707f303773c252979ef9277146c956854024501351c83f9e3","8168e840296dce5910425fbd69ca346b8d0a43b0fd67ce0f11534d1bfba162ea","851dc65e9737314895b7f0fbdf6e8776372f647a8c77471b8525aada09af8703","2ea1666dbade63e84f170032af4ae77da169f9d8c10478514145104302534f40","32cfad65cfb1d6d31f15089d67cacc7486c5a245e96ef52e65ddc705782d96c3","9af52c2b379f89ec8f8e180f36fb9a81b90db4a04f7db1bed7bdbf85edd71118","6f1622fd35f0389f9d63d3c3a38aaa62d4f0cf70eca3cc131e63c73df50736ad","c6938b457f0d04f327837db9eead51f241743209fd8357a515dae566333eb419","5a51840710e13b29b6613572d7f73ea9dee31898a30df7133829c8a119c0bc06","1fd17aa081b90c7b45c33945efe4c6accabe81039bc97f75938b3c2a6f191e41","af4800563732acb7e2d08cd0f4932b17221bfa28b64490208fd986a08a65396e","c327faec615c8c7feca3808de619fe53daeea13e492df42fee828ee442debb0d","c728da2764e84c43c1ae3b32031ab7baa4a7c9b23831622384cf0b82f3151abe"],"paragraph_range_zero_based":[44952,44975],"projection":"All w:t and m:t including tracked insertion/dele