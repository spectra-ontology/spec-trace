{"fields":{"filename":"R2-2404646.zip::R2-2404646_R18_eRedCap_331.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MT-SDT2","paragraph_zero_based":384},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":385},{"literal_text_all_w_t_and_m_t":"NTN","paragraph_zero_based":386},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, in a cell where cellBarredNTN is included with value notBarred, otherwise it is absent.","paragraph_zero_based":387},{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":388},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":390},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":392},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":393},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":395},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":396},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":397},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":398}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"fcf63c4c1de9c2c6b71269418540853f7126ebda5290bc44bc72acac10e7b05c","original_member_sha256":"7eb6c31a6f49c3c9e36bb49a5ca0faea22077db3c45ef9d26d1b6c53f6d24b03","paragraph_ElementTree_utf8_XML_sha256":["a7c736058e0630a99d8cd138cb0489eb3ec41555701e19a44ecd388f1ae722ff","877d569e409386b7794d1a2a0196d9435a10e532581ace74a9dae64ae95bb455","dda020f6623165cbef11297b480ca0