{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    uplinkCancellationPriority-v1610         ENUMERATED {enabled}                                                  OPTIONAL    -- Need S","paragraph_zero_based":35880},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35882},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCANCELLATION-STOP","paragraph_zero_based":35883},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35884},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35885},{"literal_text_all_w_t_and_m_t":"UplinkCancellation field descriptions","paragraph_zero_based":35886},{"literal_text_all_w_t_and_m_t":"ci-ConfigurationPerServingCell","paragraph_zero_based":35887},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the ci-PaylaodSize bit CI values inside the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35888},{"literal_text_all_w_t_and_m_t":"ci-RNTI","paragraph_zero_based":35889},{"literal_text_all_w_t_and_m_t":"RNTI used for indication cancellation in UL (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35890},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeForCI","paragraph_zero_based":35891},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with CI-RNTI (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35892},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35893},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell field descriptions","paragraph_zero_based":35894},{"literal_text_all_w_t_and_m_t":"ci-PayloadSize","paragraph_zero_based":35895},{"literal_text_all_w_t_and_m_t":"Configures the field size for each UL cancelation indicator of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35896},{"literal_text_all_w_t_and_m_t":"deltaOffset","paragraph_zero_based":35897},{"literal_text_all_w_t_and_m_t":"Configures the additional offset from the end of a PDCCH reception where the UE detects the DCI format 2_4 and the first symbol of the T_\"CI\" symbols, in the unit of OFDM symbols (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35898},{"literal_text_all_w_t_and_m_t":"frequencyRegionForCI","paragraph_zero_based":35899},{"literal_text_all_w_t_and_m_t":"Configures the reference frequency region where a detected UL CI is applicable (see TS 38.213 [13], clause 11.2A). It is defined in the same way as locationAndBandwidth.","paragraph_zero_based":35900},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":35901},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35902},{"literal_text_all_w_t_and_m_t":"positionInDCI-ForSUL","paragraph_zero_based":35903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b0e8d993dcbd556436d7894910052ec8f184529eada421f5b8426a54ea5b466d","fc563b7e3b74081fb161637b3629f0a457fb2a6b6215d76ff6c00e35da868880","f47c9a864c1e1767637f95b050bfb745494058d45bcdf39160ef5944a5006e01","6a232c3fcec4f5b84b67a943b73bd499a777d4d24115984b968afc1cee4eb8ee","2734d7d21f65cfeaa7dece060e5028a847b3469ca071f063a5501d582be69d6e","e0eaa3cd2b71cdf7f3ca4083ef641faf590ad9f840dec62f795e9a29c2f22b14","8a8e86bd7e1f412e35404fd826b11fcede0e601adb88f32f8bfb553ada80afa2","33c1fa33a136ecacad4d9fd5f275924e2bd717f6c7b0cf6678e0a2739cda4038","12c0af609f935b21fe8f137def65a83ded0217cf5c0164e9b0f555d778e85954","73e404fe6647d2fa46ea58c16f71e550510831e993690657998db8f1fe3adf00","b79578b8347580001025b2b5a59b6da761d6b5f24b6e8c20090fe3c15625dadc","ef59257b519a0d5025d165d606536a44fb94248a5adba905260cf7276363feda","ed8c73f9d71734bd4f093b448d390035bb2123a3ea78dbdf19ce9deeac4e1ab9","1eb8924a383e383df28f7f5b680c58a638f3ba7c64a2d5c11ed87c4c808ee774","b1c9d5da65218e652cfbb26af3535506672d731ee4d2708e0aa7c40889c3a40a","298919916d714497ef1f08a48d53dcdcd1b84c7aa11c98e8a5e6b25bc58405f2","2bf6471f6a9bb9ad851f7d633e4982bd94ee52f57b251e2d6473bdfdf13229ef","193eda6ae209d7cc7a7b137ed0d2aaf06289ef84919f1310d94444b0b48ee3ba","c7fd6c14ea4f168b22c5fcde33773507bb13fc215046e472bbc16dd270b1ad25","352b2f5887c81bd1ad7acb88c366aa451f077ac4e176e0c076cc7b6f3eb572ef","3aec50fa72eb6c81c10f400658c570e9bcd653c36706bc55bf7d9181448563a0","c5e2bfda5b64a6468d1dfc530776434a1d568d3b0fac1899198d6cbe49b5eede","1e54e566acca6efeb50236413a7bbcd18311233beb5b2b8231be33ded9b3d6f8","abb80730d8f4dc1551b81d81f9f147d3527602bfa1b404fdc5222967ba1e85e7"],"paragraph_range_zero_based":[35880,35903],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35880"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for SUL of this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35904},{"literal_text_all_w_t_and_m_t":"timeDurationForCI","paragraph_zero_based":35905},{"literal_text_all_w_t_and_m_t":"Configures the duration of the reference time region in symbols where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A). If the field is absent, i.e., the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is larger than 1 slot or 1 slot with only one monitoring occasion, the UE applies the value of the configured UL CI monitoring periodicity,","paragraph_zero_based":35906},{"literal_text_all_w_t_and_m_t":"timeFrequencyRegion","paragraph_zero_based":35907},{"literal_text_all_w_t_and_m_t":"Configures the reference time and frequency region where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35908},{"literal_text_all_w_t_and_m_t":"timeGranularityForCI","paragraph_zero_based":35909},{"literal_text_all_w_t_and_m_t":"Configures the number of partitions within the time region of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35910},{"literal_text_all_w_t_and_m_t":"uplinkCancellationPriority","paragraph_zero_based":35911},{"literal_text_all_w_t_and_m_t":"Configures uplink cancellation behavior if both UL CI and intra-UE priority indicator are configured for a given UE. If the field is present, then UL CI is only applicable to the UL transmissions indicated/configured as low priority level. If the field is absent, UL CI is applicable to UL transmission irrespective of its priority level (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":35912},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35913},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35914},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35915},{"literal_text_all_w_t_and_m_t":"SUL-Only","paragraph_zero_based":35916},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, if supplementaryUplink is configured in ServingCellConfig. It is absent otherwise.","paragraph_zero_based":35917},{"literal_text_all_w_t_and_m_t":"SymbolPeriodicity","paragraph_zero_based":35918},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is 1 slot with more than one monitoring occasion, otherwise absent.","paragraph_zero_based":35919},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35920},{"literal_text_all_w_t_and_m_t":"–UplinkConfigCommon","paragraph_zero_based":35921},{"literal_text_all_w_t_and_m_t":"The IE UplinkConfigCommon provides common uplink parameters of a cell.","paragraph_zero_based":35922},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon information element","paragraph_zero_based":35923},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35924},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-START","paragraph_zero_based":35925},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35926},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon ::=              SEQUENCE {","paragraph_zero_based":35927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d3