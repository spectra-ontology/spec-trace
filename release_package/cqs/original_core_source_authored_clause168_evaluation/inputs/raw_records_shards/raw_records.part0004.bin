fe885b10e135213","190e2a624ec443d5621e6adc58fe21d9ab2e42095fd087f8f7b791c48a3bd423","c43149acd02665afcfb6482965fc0ca6db448bc56a312c7c45888552438ba8b4","28eb3e38c0d8841d30633cc7f4d0d0026e3c58ed3552a04dceaad8941624afd3","6e490c73cb1b1940233418548f4a106a00f3d6e255ff490f573839643aefa504","b5284251d0756f43094a61e476eb042e65a76cdb7b0902c152c49bebb0f2029b","8263f241f9b3eba579904275aba35dce606233b7a42c6e0c7c947b26cd88e72c","4c8d1503d84ebae798d01f2e9fddb695374bd7ae381f0e98f1744c94615d48e1","53e6a4cc52d5c9d4366b96e445b1d41d0accd722d10686238e8ef8beabfc7893","f280b9bbf1ec7b80aa77e1376dade78434fd15429d375a10649d089620ac5e0d","b8c47134ab5b84d438ccefc7c6fc8a708074679b47aa480ecb2ade9bd5f54b67","0ba95944314c249d01161fb81059e496c49e8247d0cb24e85fb5988d308ff578","d0f932e22ee084ee60c2b88d5c414a86ba6164d1b32060779d02f76649aa763a","f729a37f62f631cf31a7cd053b4571a4f015ae5a81c363cd99fe5907bf612238","456b347daf5a22c353e394c967bab685c0866b97723fab31cc540a3437b0058a"],"paragraph_range_zero_based":[12192,12215],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12192"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":12216},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12217},{"literal_text_all_w_t_and_m_t":"MobilityFromNRCommand-IEs field descriptions","paragraph_zero_based":12218},{"literal_text_all_w_t_and_m_t":"nas-SecurityParamFromNR","paragraph_zero_based":12219},{"literal_text_all_w_t_and_m_t":"If targetRAT-Type is eutra, this field is used to deliver the key synchronisation and Key freshness for the NR to LTE/EPC handovers and a part of the downlink NAS COUNT as specified in TS 33.501 [11] and the content of the parameter is defined in TS 24.501 [23]. If targetRAT-Type is utra-fdd, this field is used to deliver the key synchronisation and Key freshness for the NR to FDD UTRAN handover and a part of the downlink NAS COUNT as specified in TS 33.501 [11] and the content of the parameter is defined in TS 24.501 [23].","paragraph_zero_based":12220},{"literal_text_all_w_t_and_m_t":"targetRAT-MessageContainer","paragraph_zero_based":12221},{"literal_text_all_w_t_and_m_t":"The field contains a message specified in another standard, as indicated by the targetRAT-Type, and carries information about the target cell identifier(s) and radio parameters relevant for the target radio access technology. A complete message is included, as specified in the other standard. See NOTE 1","paragraph_zero_based":12222},{"literal_text_all_w_t_and_m_t":"targetRAT-Type","paragraph_zero_based":12223},{"literal_text_all_w_t_and_m_t":"Indicates the target RAT type.","paragraph_zero_based":12224},{"literal_text_all_w_t_and_m_t":"voiceFallbackIndication","paragraph_zero_based":12225},{"literal_text_all_w_t_and_m_t":"Indicates the handover is triggered by EPS fallback for IMS voice as specified in TS 23.502 [43].","paragraph_zero_based":12226},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12227},{"literal_text_all_w_t_and_m_t":"NOTE 1:The correspondence between the value of the targetRAT-Type, the standard to apply, and the message contained within the targetRAT-MessageContainer is shown in the table below:","paragraph_zero_based":12228},{"literal_text_all_w_t_and_m_t":"targetRAT-Type","paragraph_zero_based":12229},{"literal_text_all_w_t_and_m_t":"Standard to apply","paragraph_zero_based":12230},{"literal_text_all_w_t_and_m_t":"targetRAT-MessageContainer","paragraph_zero_based":12231},{"literal_text_all_w_t_and_m_t":"eutra","paragraph_zero_based":12232},{"literal_text_all_w_t_and_m_t":"TS 36.331 [10] (clause 5.4.2)","paragraph_zero_based":12233},{"literal_text_all_w_t_and_m_t":"DL-DCCH-Message including the RRCConnectionReconfiguration","paragraph_zero_based":12234},{"literal_text_all_w_t_and_m_t":"utra-fdd","paragraph_zero_based":12235},{"literal_text_all_w_t_and_m_t":"TS 25.331 [45] (clause 10.2.16a)","paragraph_zero_based":12236},{"literal_text_all_w_t_and_m_t":"Handover TO UTRAN command","paragraph_zero_based":12237},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12238},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":12239}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["734448bfcb0f19465ce6228f306ea49c5f1dfc8a1fc92bab26b72575184a254c","073d3773389d94a8cba3d3c996e30232dc82fc58b34ed5e52451b2b37bd8b6ef","2dac15cfaa485577a065278a664fe3e1286a32be2b01ed557123b6ae0da4d054","1f6f39b0161e73fab549612c0f2529492324bc65620f466fc2add57eac28d8f0","2ad3ed87297cf6ad25a9ddc354f2759bd1217d13959bbf142feb2514b416806f","b48b1fe670878da24f75fa0067021484475c0dc6c257fdbc800607cff14666a6","9b7abc9a0305222d87090df5d955e15797bebc52eda9c506bf0b4cf18406ad2c","803fa46bedfb3aa3a396d4eacfd0204ae1d075a1cd53dce31192627fe3d60385","d88f0e361466075a03a02bddd7572584227671d13568b40cd99482d944fb3cf2","4b1b662ed4fb8298bdd5510b03035e65fd81f77074f13b983ae40e0bac2f54aa","e0b2c8ac6e33e3653f16c313a1e30cea651a3797ede8de154f7b161a4eac3882","2652806a857cd727f2d932134ea7c7e07ac8ab16a7d128b7971f63668d5635e7","512257204fa43c08b80d287524a817e40e54d013ab8d4c718e1c73d2697cd21e","d38681baf8aef92678c61a596ababb32d551ff72193ee6c00f6896f6c2cd91e5","d897d3513bc10dfb4632ba66f983f7af097f4c774e7035e6c3c46556f7bf005b","6764be3207da973012cd9eb2e0a89d504292f3588e624389208a6e631aebfb1f","eae7547589d9174172eba0dca5d860206fbe9a229567b54c5a759bae93f5a0f9","a50bae481c73a734e29af116f4f9e85b9769b063e323b63083b29a84625092cf","2630e64cb212cb3a7bbfa8ec57757ef301b268534379e15009304ff3859f6222","2a9b0458d87a1279e745ac400f8d0b5d65ccdbfa907536a5baea4085146f9696","08532bd420a84ce89826175b10812eb99184b3c9d58682e0ebb652dc641960c0","151c5e98ab678a63762afd88aa385187c71c7736b1e6388529f68a931c7ffa31","3c651064d771fc95e960f5ae22b35af461a13e21f234bf55659f960c5acca779","b3c4174cdd89d6fcfcde9ddfb0129ecc5fc587d4a288c13577f8586f2c49318e"],"paragraph_range_zero_based":[12216,12239],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p12216"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":12240},{"literal_text_all_w_t_and_m_t":"HO-ToEPCUTRAN","paragraph_zero_based":12241},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in case of inter system handover to \"EPC\" or \"FDD UTRAN\". Otherwise it is absent.","paragraph_zero_based":12242},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12243},{"literal_text_all_w_t_and_m_t":"–Paging","paragraph_zero_based":12244},{"literal_text_all_w_t_and_m_t":"The Paging message is used for the notification of one or more UEs.","paragraph_zero_based":12245},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":12246},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":12247},{"literal_text_all_w_t_and_m_t":"Logical channel: PCCH","paragraph_zero_based":12248},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":12249},{"literal_text_all_w_t_and_m_t":"Paging message","paragraph_zero_based":12250},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":12251},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-START","paragraph_zero_based":12252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12253},{"literal_text_all_w_t_and_m_t":"Paging ::=                          SEQUENCE {","paragraph_zero_based":12254},{"literal_text_all_w_t_and_m_t":"    pagingRecordList                    PagingRecordList                                                        OPTIONAL, -- Need N","paragraph_zero_based":12255},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":12256},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                Paging-v1700-IEs                                                        OPTIONAL","paragraph_zero_based":12257},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":12258},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":12259},{"literal_text_all_w_t_and_m_t":"Paging-v1700-IEs ::=                SEQUENCE {","paragraph_zero_based":12260},{"literal_text_all_w_t_and_m_t":"    pagingRecordList-v1700              PagingRecordList-v1700                                                  OPTIONAL, -- Need N","paragraph_zero_based":12261},{"literal_text_all_w_t_and_m_t":"    pagingGroupList-r17                 PagingGroupList-r17                                                     OPTIONAL, -- Need N","paragraph_zero_based":12262},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                Paging-v1800-IEs                                                        OPTIONAL","paragraph_zero_based":12263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["036a2590868e336ae0928ca96fd73b01bbf7a9104365fbdfef265fb722c5b974","9f4f6670ee33e410c397407a656f6b22cf95697b623c28bff6f076eba4f2f16d","28b6119718245d1ac80e888a7492c5942c1e5c9733efefe13710e6e7fc0f73b6","c58e08be83823aa63198f23a1c15a9a6d77cadc233e143ec3f84eb716fece0cb","5a305f9eca094250137b53a5b6b7e928ac9e1ecc747d971efcc28aeaae7d9a12","85582f063e1914a2a48dd6ca0444d8ed72d2687112db5c02addef666035ec642","79708b6d7dba3d45cba887ef5a11aaf4b119efb8c59dcd598a47167ef463a106","91b4ba352f2a2f8a2a32858a96a87de719380004b806a86e8acdf0cfdcd622a4","b81248878e1b6025ab7f3f236b71e583307b510e8d4f86656b5ce23c54eb035d","4f5fd1f2b82218fb05ac14f2db75b1bee1f78298ca3d6306f5bc497c9708e400","82613104bd0897f7bc3585d6eacb240fff5fd890f7b07d659d