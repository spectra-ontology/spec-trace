{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"OtherBWP","paragraph_zero_based":27576},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is not the initialDownlinkBWP and pagingSearchSpace is configured in this BWP. Otherwise this field is absent.","paragraph_zero_based":27577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27578},{"literal_text_all_w_t_and_m_t":"–PDCCH-ConfigSIB1","paragraph_zero_based":27579},{"literal_text_all_w_t_and_m_t":"The IE PDCCH-ConfigSIB1 is used to configure CORESET#0 and search space#0.","paragraph_zero_based":27580},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 information element","paragraph_zero_based":27581},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":27582},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-START","paragraph_zero_based":27583},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27584},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 ::=                SEQUENCE {","paragraph_zero_based":27585},{"literal_text_all_w_t_and_m_t":"    controlResourceSetZero              ControlResourceSetZero,","paragraph_zero_based":27586},{"literal_text_all_w_t_and_m_t":"    searchSpaceZero                     SearchSpaceZero","paragraph_zero_based":27587},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27589},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGSIB1-STOP","paragraph_zero_based":27590},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27591},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27592},{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigSIB1 field descriptions","paragraph_zero_based":27593},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":27594},{"literal_text_all_w_t_and_m_t":"Determines a common ControlResourceSet (CORESET) with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":27595},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":27596},{"literal_text_all_w_t_and_m_t":"Determines a common search space with ID #0, see TS 38.213 [13], clause 13.","paragraph_zero_based":27597},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27598},{"literal_text_all_w_t_and_m_t":"–PDCCH-ServingCellConfig","paragraph_zero_based":27599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["30c3b587f785d913184231a38cff20536a7b24b81077c37890071f0b92f1d068","d6b7326bc501d11906c3057d7fdd84354fd6d84c437035b393220c60d18dc9af","2dd0819e50b3f9b37dc5b8473c3ab722cff9925b135f6f7674ebd443b34f83f9","8887db26381caa927c87ed76aaddc3e19fff27e32f1b0a2af859ca2290313c16","e2a5e90bce4062fffdc46c49f7ea12eb739edbda971b4e6443c6f0ba2665a239","8075c445f75ec08da80271a67a6402daf3d6cfc2d2d7340c40d01968fcdc7d26","c29b87a14dedc93bfb21bf1538e6eceed5b91b2a6ed74ccef7dc2e488f4aafe1","c502fcf03443cc79be8297b6e17a962ac7bdbd4b1e6d910d3b91077e71143d36","d6d11898582535f35e97003e905c2d7d3f2aa19d4fbe76f92e734e601a2ff875","e95b5a9018e8402bd32a4be4819c33b5f03b824d80789c7d18aa48a9b8a9493e","ed7db67155cb7c7dcea1596c966f636c45d6427129ee2d2b520bb53dc14df1d1","4002c4b9150f37a86c8f876f235717ad6b1c211ac98c635f01b18eaa4ee8633b","65e3ac25505dc184c9982f69820bc80e924969c35aa09e635773a47629f9b87f","8d095d3dd29d8adf1f9ee1441d490140d158f79e26da55ed9e55e08b4acd7d00","673e622d621fa68403bfb2c79ae2653b10b93b127014756f61f1d0783e79688b","b8ff6639cc2be0db1306c49f4d3777d29c84a85681346e4f0c370ff139c2edb9","c7ca2bb0f194626afcad75ea3e99759f0