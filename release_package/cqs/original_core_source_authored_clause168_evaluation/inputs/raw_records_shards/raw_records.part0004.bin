_t_and_m_t":"fr1ENUMERATED {mhz40, mhz50, mhz80, mhz100},","paragraph_zero_based":1073},{"literal_text_all_w_t_and_m_t":"fr2ENUMERATED {mhz100, mhz200, mhz400}","paragraph_zero_based":1074},{"literal_text_all_w_t_and_m_t":"}OPTIONAL -- Need ON","paragraph_zero_based":1075},{"literal_text_all_w_t_and_m_t":"}OPTIONAL -- Need ON","paragraph_zero_based":1076},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":1077},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":1078},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":1079}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["11f9172447bf255dd0bbe59042e55be66bdfb679ee88140e1c14b55ff6b5ec16","55f7994b6fbd2f9e936082f9eac5520a96d71b4acadaade9c1eb4fbb23e876f3","c9541a080f0fd60df280dd34412b8fdd59cf806a1a52b3148dc8c3804ba5d5e4","7c61c2493bbe2de643893fb91afb2df008d8e437b791491fb0cb88701fade86d","96d805ed21288f3a5a8ec17ebd3550326c17b5c8e01051f519175a3a4866c4d4","a649e6cd145421f5d5b38c078d276cc47051cc0a8193f34bb6387c47d2c373d4","838c072c4760fccde2df3f903f1fce2308eb42c12b914037a501617396d33ad6","1d3c88fec1e4b1192f7d0b6d8a2cde982055c7ece693e9e48fe41c423d59a276","fe3f90f702f09ea56e3e602e2075208a54d819ba3b032f730fc36bfff1248473","ceb937558580d038c085d463ea895d17f49c217d4459f4ac465299182f8d6f60","5d4676f2f3c0070e872d8bcd172533e060d19178f7eb161016ea6e18432d967d","99781854637f8e4a8b5e9ffd9a5bfe6fcb581a89c2b518c483285d31b52ef5c7","fbeee808ae7654f982df9af02416f29d14b8a7ea1cb19027c0852a8475771ce1","81487ad8023f15bea2dd01e2f7302b93b7bba6b560cdc4633724730af1b18515","4904fb1cebdf22280cb9a213594592fd2fb2314bc1695e34035956d69cadb608","5ccd5e132eb906f01d70224efba3d788bfe70fefedd9ab2ea0cfec72c90ecd1c","3cec0770cc22352be943c