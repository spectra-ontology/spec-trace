{"literal_text_all_w_t_and_m_t":"    qcl-Type                            ENUMERATED {typeA, typeB, typeC, typeD},","paragraph_zero_based":35319},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35320},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35321},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35322},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATE-STOP","paragraph_zero_based":35323},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35324},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35325},{"literal_text_all_w_t_and_m_t":"QCL-Info field descriptions","paragraph_zero_based":35326},{"literal_text_all_w_t_and_m_t":"bwp-Id","paragraph_zero_based":35327}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["efafd9c3802ba580d6214b0c71729dcd8bcfdd9e8820dc2cd07af838a455cca4","9ae620ace8c4bc76880be3ce2c4893dfb519c6911cb45e7412fd1f2abb54afa0","ba3154a6687776509fb40a3e9e94fae1cfa0797d8a9c4fbe55fe249ccc93ddc4","e678ee2fdbfbbd79cb83b2bec103b2c0f82ea1dd80d424af5944bb0b5c68afb5","95e85869dc328419b0668ab9acd28602a28ff8546819c40006c68b93fe72cf64","8fad2920a1ab4afc0ef568377a1a3a48cfbd1c34859547e0d76da8b820b25e9e","7967f6e61257679d4e62f1a70b8c27b91ba6b5aa88a8a0c800ed63d768d0c879","4304a0b21aff26d7937ca64b27b0a53414a713f80abe9c22fe247b336a692d1d","776a2a3e46d0324f21a04b97c93c3ea5c1203776e7aa322022299245778131b3","552f356f9a0993d322afcd501039b8dfa5188b24ebe446e2027c2ab99740921d","62ec1dda0ffd80cc04c59dcf6db74b09198be8fb159f925f0f9e83a7cc532ce9","1640a11a5c4a553c70e52f43a082e7a94d545df9e9093a7cf08fb79b4aaaa63e","8bd7df6d5d3e2f373ebc25f82154ca86c05870852df3d2da79872b37d75d2635","23a23c69d2b6f7efdf817cf2f9ff3a86c8d4bb713c743c301f840fb43de76253","bb682ea9251feee1db3f8dba0159f7cfa8f967371064831feb8296e4e6943b43","832dcbcbedab79c5583d020dba7aaa58f3ea3d488947221b3fe232c572952a7e","afc1884d371a0daa104822216c58eae0464c02999734551207bea22ff69907ea","9cdaff90fdb4249fba086f54fe407f79c747803e0cc90fe7f5588d3cf7bce029","e54c105ae7cb6d99d5db6f2b707d063d336647da4165a64a4ac8a0024d6cac28","0cae958f1fc34599d312d39d507c8b34d8df5132ef00bacdae6fd916c8af2afe","6833a8f42e927c5caa1f8e133832f44ea38fed301a50456c003adf38fcd5ff3a","a3983a26461950d5b94b491d5080fa35d537cf953cf89afae7543daa39a5ccd1","542fc44be963f7dd400992e38b2b08a4eb58b955deeb7f13866d16aa9d598bac","8e153f779ce4f336beb52adaae6df43bee8f2cfd45b98f88e8d9e1c9d19bcb34"],"paragraph_range_zero_based":[35304,35327],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35304"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The DL BWP which the RS is located in. If the field is absent, the RS is located in the DL BWP in which the TCI-State is applied by the UE.","paragraph_zero_based":35328},{"literal_text_all_w_t_and_m_t":"cell","paragraph_zero_based":35329},{"literal_text_all_w_t_and_m_t":"The UE's serving cell in which the referenceSignal is configured. If the field is absent, the referenceSignal is configured in the serving cell in which the TCI-State is applied by the UE. The RS can be located on a serving cell other than the serving cell for which the TCI-State is applied by the UE only if the qcl-Type is configured as typeC or typeD. If the referenceSignal is set to csi-rs and unifiedTCI-StateType is configured, either both cell and bwp-Id are present or both cell and bwp-Id are absent. See TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35330},{"literal_text_all_w_t_and_m_t":"referenceSignal","paragraph_zero_based":35331},{"literal_text_all_w_t_and_m_t":"Reference signal with which quasi-collocation information is provided as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35332},{"literal_text_all_w_t_and_m_t":"qcl-Type","paragraph_zero_based":35333},{"literal_text_all_w_t_and_m_t":"QCL type as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35334},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35335},{"literal_text_all_w_t_and_m_t":"TCI-State field descriptions","paragraph_zero_based":35336},{"literal_text_all_w_t_and_m_t":"additionalPCI","paragraph_zero_based":35337},{"literal_text_all_w_t_and_m_t":"Indicates the physical cell IDs (PCI) of the SSBs when referenceSignal is configured as SSB for both QCL-Type1 and QCL-Type2. In case the cell is present, the additionalPCI refers to a PCI value configured in the list configured using additionalPCI-ToAddModList in the serving cell indicated by the field cell. Otherwise, it refers to a PCI value configured in a list additionalPCI-ToAddModList configured in the serving cell where the TCI-State is applied by the UE. When this field is present the cell for qcl-Type1 and qcl-Type2 is configured with same value, if present.","paragraph_zero_based":35338},{"literal_text_all_w_t_and_m_t":"pathlossReferenceRS-Id","paragraph_zero_based":35339},{"literal_text_all_w_t_and_m_t":"The ID of the reference signal (e.g. a CSI-RS or an SS block) used for PUSCH, PUCCH and SRS path loss estimation. This field refers to an element in the list configured using pathlossReferenceRSToAddModList in the serving cell and UL BWP where the TCI State is applied by the UE.","paragraph_zero_based":35340},{"literal_text_all_w_t_and_m_t":"qcl-Type1, qcl-Type2","paragraph_zero_based":35341},{"literal_text_all_w_t_and_m_t":"QCL information for the TCI state as specified in TS 38.214 [19] clause 5.1.5.","paragraph_zero_based":35342},{"literal_text_all_w_t_and_m_t":"tag-Id-ptr","paragraph_zero_based":35343},{"literal_text_all_w_t_and_m_t":"It indicates the TAG that is associated with this TCI state, value n0 means the TCI state associate with the TAG indicated by tag-Id, value n1 means this TCI state associated with the TAG indicated by tag2-Id. The tag_id_ptr refers to the TAG of the serving cell where the TCI state is applied.","paragraph_zero_based":35344},{"literal_text_all_w_t_and_m_t":"tci-StateId","paragraph_zero_based":35345},{"literal_text_all_w_t_and_m_t":"ID number of the TCI state.","paragraph_zero_based":35346},{"literal_text_all_w_t_and_m_t":"ul-PowerControl","paragraph_zero_based":35347},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUCCH, PUSCH and SRS for this TCI state. The field is present here only if ul-powerControl is not configured in any BWP-Uplink-Dedicated of this serving cell. This field refers to an element in the list configured using uplink-PowerControlToAddModList in the serving cell where the dl-OrJointTCI-StateToAddModList is configured.","paragraph_zero_based":35348},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35349},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35350},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["45e30e2a76f36940e8c7bfb2633730e86dfdf8ba5f4de0847c2cdc6fcce4c466","e1ee2e6a8e36a40831fc0968bdd080671276522f692a0c9f153eac6f18049cf3","5edeb87ea2cc882d0a422f684b6569e2e5405f1ae046d01f3edee51a81987837","5a7f43d96e31be9d9cd44d019c1adb80da96c5d04f468c3b63e43f537f57241b","cad9512301c3529e1cdba587b05f395d61361bfc1044077a16165b65a56083fe","ccb0ca555771e27abbc9837e2b7743c27314fdb6419b190df0bd020326ac5d1d","61fad970b03a4c63466b9416e3771da2a7a19dba4de684d74cb7e2fad03b9a85","2190425260c8662dbd79f943883981507985633433eb594fd28056b4056e9951","bf0f7d498d239c8c96af72d6ab75fff1f413023d94364afd418099b5fdd681f5","3a4b06b23fd954b8ed23843ac6a2779b2e86992e8a9cdf89c763636c5f6b17c1","53a15f259c987a835b5c4945fe1d0c51fb8f2167784e063e656eb669cb36c8f2","946e07cd6b912a9c06a16089f21f1abb6e982945f17f64f6c33985152b4e8b8a","81a0998ffca1c6803d7d253ee89a8656f347ec18ca3ed1285d194ea418bc5e09","eade06ef3f3ad0a881df362b75183152edd624292ef2c843d2210d438916cde6","0de582805466e81b1adaddc9c0d03bfd8c93eb5fb9a312918d2239d09545d87b","fa0a96e30d858ace787b35cf568911c94f909ebc85217225a6d14edbca5c9920","a0132168b088099f17a84787523963179b27a5d088c4c96dbd0e9074ec568720","0b284b6b7c68d21f08386d6fd2c010cb08bbacd5057220ccfb527638e6ef8c67","7fb73305dc6713897e1996d3a476e7d5f5cb03c048e55a48666422376e3ccc24","c46e9b7b4dcbe65cf2d56f1d37a74ced52de1b023ce35961f998c97d8caa2cb3","27e60ed24c129a93e9f7ebf2530b1ad263d53ecce738ee52741f00e48c902b24","3a3a8a0bec97cd7b1d93d489d778d20ad21b0a9ca5d736aa27d40f5ca6b98eef","399fea7aa21f4404a66b451aa66126856fec18de79803ddbd2fd3bf57c5a1820","273b2342fabea225b9104e562d2e68deedbb110e9fe56d6eba107d32558af8de"],"paragraph_range_zero_based":[35328,35351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35328"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2TA","paragraph_zero_based":35352},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if tag2 is present for the serving cell. It is absent, Need R, otherwise.","paragraph_zero_based":35353},{"literal_text_all_w_t_and_m_t":"CSI-RS-Indicated","paragraph_zero_based":35354},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if csi-rs is included and unifiedTCI-StateType is not configured. This field is optionally present, Need R, if csi-rs is included and unifiedTCI-StateType is configured. Otherwise, it is absent, Need R.","paragraph_zero_based":35355},{"literal_text_all_w_t_and_m_t":"JointTCI","paragraph_zero_based":35356},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":35357},{"literal_text_all_w_t_and_m_t":"JointTCI1","paragraph_zero_based":35358},{"literal_text_all_w_t_and_m_t":"This field is mandatory present, if this serving cell is configured with unifiedTCI-StateType set to 'joint'. It is absent, Need R, otherwise.","paragraph_zero_based":35359},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35360},{"literal_text_all_w_t_and_m_t":"–TCI-StateId","paragraph_zero_based":35361},{"literal_text_all_w_t_and_m_t":"The IE TCI-StateId is used to identify one TCI-State configuration.","paragraph_zero_based":35362},{"literal_text_all_w_t_and_m_t":"TCI-StateId information element","paragraph_zero_based":35363},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35364},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-START","paragraph_zero_based":35365},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35366},{"literal_text_all_w_t_and_m_t":"TCI-StateId ::=                     INTEGER (0..maxNrofTCI-States-1)","paragraph_zero_based":35367},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35368},{"literal_text_all_w_t_and_m_t":"-- TAG-TCI-STATEID-STOP","paragraph_zero_based":35369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35371},{"literal_text_all_w_t_and_m_t":"–TCI-UL-State","paragraph_zero_based":35372},{"literal_text_all_w_t_and_m_t":"The IE TCI-UL-State indicates the TCI state information for UL transmission.","paragraph_zero_based":35373},{"literal_text_all_w_t_and_m_t":"TCI-UL-State information element","paragraph_zero_based":35374},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a4ea9f6d1730cffefe30ae782277feae02bce7774ab061467b1c917b8e826d08","027ddb4c5fcdb09a474cec9cc9e21c8dc97ea8e974d4bfb818b81053444302ff","be2059547dbee186b5e35314c4861c426d66fa77d8cb1a8b34995d80f619514e","af28f4ee1068d106ee861531365b851411dbc69b32a6a45121775a6db7c321e9","87ac3649eef4dd9931d11af63105c9e5f2b6f67d47cba26baa94c7b7a93a8c16","3a9fc841104f4da61f7c2ede85b81a114971bed7c4795f95949e4a8be8c68693","9d5059c18a9bbfb402d19c530daba43eea316d648d49e8a72bb3a678d2684361","3d7cd91ea45e6fd3714fea03fde79ea926272ece3229876c3044a1083f5c79cf","29d6c1fbe4b3c9d71cc349f24cc85e3e3ae918f83539ab9c5592c425ea536ade","3902674ab3d91be1d830df23c95e3fb6b12298b2e65b9b371c4370c3efcfedb1","f22f9dfe59a0c6a884957c774401b2a36264977cc9905a08d3529539e63aa8b2","516ef39f87c9b38851f6e55bf931086e970b3dc3a0dd74ce86065d6862631190","bab395b8a12373323f6a5ba7a5af6b59248215ef17587494f43cc6bf3a85a8c9","c7b41ea525f23ad