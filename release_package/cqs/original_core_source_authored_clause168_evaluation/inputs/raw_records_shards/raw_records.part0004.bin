docx:p31656"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Threshold value associated to the selected trigger quantity (e.g. SRS-RSRP, CLI-RSSI) to be used in CLI measurement report triggering condition for event i1.","paragraph_zero_based":31680},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":31681},{"literal_text_all_w_t_and_m_t":"Choice of CLI event triggered reporting criteria.","paragraph_zero_based":31682},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":31683},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":31684},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31685},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":31686},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":31687},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a CLI measurement resource in srsTriggeredList or rssiTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":31688},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":31689},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":31690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31691},{"literal_text_all_w_t_and_m_t":"CLI-PeriodicalReportConfig field descriptions","paragraph_zero_based":31692},{"literal_text_all_w_t_and_m_t":"maxReportCLI","paragraph_zero_based":31693},{"literal_text_all_w_t_and_m_t":"Max number of CLI measurement resource to include in the measurement report.","paragraph_zero_based":31694},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31695},{"literal_text_all_w_t_and_m_t":"Number of measurement reports.","paragraph_zero_based":31696},{"literal_text_all_w_t_and_m_t":"reportQuantityCLI","paragraph_zero_based":31697},{"literal_text_all_w_t_and_m_t":"The CLI measurement quantities to be included in the measurement report.","paragraph_zero_based":31698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31699},{"literal_text_all_w_t_and_m_t":"PeriodicalReportConfig field descriptions","paragraph_zero_based":31700},{"literal_text_all_w_t_and_m_t":"coarseLocationRequest","paragraph_zero_based":31701},{"literal_text_all_w_t_and_m_t":"This field is used to request UE to report coarse location information.","paragraph_zero_based":31702},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":31703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["dabd9792565674a987fd8553cbc6e1463dc7f1045a248d0e297ebacb55306b93","a39008dc593ef2b856e08d5ccb5c4a238b2d777bbf84ad1f61fea1da157aaf3e","a096dcbcb013778f896691a2c9f93857c9ce167a4858ab8fd38957355582df9f","c6f8fa55925f00552a5db9e817bcfcb4107f1c15856f8ce597590c4a960dcf5f","bfa05067a7984435f104e9643f8615e8b80767e9c9c35898ec74a7aac3997316","64a47c22d3cb3f4de5c0a6ab9897866a9cbc1fac7f80e025f3f838fca8a7b429","b456815321561068e7d5953bc9fbd39bbe70cfae8104aa110fe5e095c0196d7f","5e754fb4d68df04fef33c442eb6b34e3283f09e64a8e1955404712e91d021d13","3338a79a11c3bf048ea7eda5c4b57818a04acf549a6749ed3d7eb851ee4d94e1","d427b54f4d4a74adb3bfa96a4dbf6b7238cb24d93b1b7f750b8db9518c3a088c","c11b253eb62dce3a063dff0ff8caf9c6c59ed4c5f4571290d004715a59873240","fa84222f1e6c575a6450cbbdb57b26ac9d5a3e474b06a85902ae1948f6eff997","8df7d1857bc812416b07173c7dc040e6c70f540959ca1994e7f83e519fe152fd","72f896bfd24269c3f0065a0dbb62d84693a439bfd78cc1f91cd9b4cc41aa75b8","452ec05df3de15f3061d8396187eda748794fd4a571144e32df2892169c48ca6","329e538cf27eeddc9b10f7207668c23b6b8e4d9918bb9fcae92e9f87b96831eb","4815ae2d81b4f99b7e2bfddbfffa4c7a87d94d862a9ce6abff02def6ef1be206","390c4ba8de1b8e6880e0728536b7ae65f0e0c510046ae6d8a1017df80b29e1fa","3a246d35e09cf98c87d09faaba9c21496b8ff1418afa4d49af94d304bfd60c3d","f8343eb6d2ce43f91bc69a1717dff9ef07b9cb260dc4a247bfd83dd782e611fd","88a553121e8d8da6efd0d6d18da2dcaac9aad8708d7b6c0b3f9d2d069e558e71","f814e9492166c20f4af01dde542613f6aa72dc26dac4f1707b24946b2f0bcaf8","de5f8552381bff27e225b9faeabc9e81c61ac01c50e8118e64743fa8ced250e9","069308aaa9c8d2f9206656efd2ce900d95a2cffae277f0b831f604084887a203"],"paragraph_range_zero_based":[31680,31703],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31680"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":31704},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":31705},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells to include in the measurement report.","paragraph_zero_based":31706},{"literal_text_all_w_t_and_m_t":"reportAddNeighMeas","paragraph_zero_based":31707},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall include the best neighbour cells per serving frequency.","paragraph_zero_based":31708},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31709},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":31710},{"literal_text_all_w_t_and_m_t":"reportQuantityCell","paragraph_zero_based":31711},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report.","paragraph_zero_based":31712},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":31713},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index the UE shall include in the measurement report.","paragraph_zero_based":31714},{"literal_text_all_w_t_and_m_t":"ul-DelayValueConfig","paragraph_zero_based":31715},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Packet Average Delay measurement per DRB as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Packet Average Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":31716},{"literal_text_all_w_t_and_m_t":"ul-ExcessDelayConfig","paragraph_zero_based":31717},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE shall perform the actual UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53] and the UE shall ignore the fields reportQuantityCell and maxReportCells. The applicable values for the corresponding reportInterval are (one of the) {ms120, ms240, ms480, ms640, ms1024, ms2048, ms5120, ms10240, ms20480, ms40960, min1,min6, min12, min30}. The reportInterval indicates the periodicity for performing and reporting of UL PDCP Excess Packet Delay per DRB measurement as specified in TS 38.314 [53].","paragraph_zero_based":31718},{"literal_text_all_w_t_and_m_t":"useAllowedCellList","paragraph_zero_based":31719},{"literal_text_all_w_t_and_m_t":"Indicates whether only the cells included in the allow-list of the associated measObject are applicable as specified in 5.5.4.1.","paragraph_zero_based":31720},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31721},{"literal_text_all_w_t_and_m_t":"ReportSFTD-NR field descriptions","paragraph_zero_based":31722},{"literal_text_all_w_t_and_m_t":"cellForWhichToReportSFTD","paragraph_zero_based":31723},{"literal_text_all_w_t_and_m_t":"Indicates the target NR neighbour cells for SFTD measurement between PCell and NR neighbour cells.","paragraph_zero_based":31724},{"literal_text_all_w_t_and_m_t":"drx-SFTD-NeighMeas","paragraph_zero_based":31725},{"literal_text_all_w_t_and_m_t":"Indicates that the UE shall use available idle periods (i.e. DRX off periods) for the SFTD measurement in NR standalone. The network only includes drx-SFTD-NeighMeas field when reprtSFTD-NeighMeas is set to true.","paragraph_zero_based":31726},{"literal_text_all_w_t_and_m_t":"reportSFTD-Meas","paragraph_zero_based":31727}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["40e798fc154c4924b563db11a72ed6b186d8042edb02f38e1f38c634de2be96b","f990e97f3170bce2cee59998e94a2c85de44e0539e4747703c5631764e076029","a6912e08af4823b640275e0b5958a1f05087e8c580b4502b3185c73f97c19e04","f4741a133b7633466a865ca147ee7f4917de1e394041da0b561662000218f37d","dfe2956857337f60eb7821298a3a522bb5bd037871006534e6929c8d57df09ee","56eedae87cb89a4c6fc1fd4b0a153f83d0cd5512dba3c31d0f28e0ffcce342cc","dec3e75d2f4f8c590e40f19b366e98a7ff6830174f9f4c4455a9360d3a23dca0","f9b04ef5e05d1a945b25f6d2a7dce793f2736617bb4562aeb87a1101e31fcd5d","35f89dd3b8610a39640b248cb8b2c47291e673b990a6830d610e628df60d5fce","d662574bc00e08410d3ce00fd99353f85adedf47f0de2430df67f84dc81b63a3","ad25829c50d18e2416898cb5322ff710191ff1bb600c0486da1ce5b4a4b664c4","38bd2099663964894bbe2b3d187a2dcfdb2e2ef59773e2565e19166a165626b1","ed8bcaf41b1ddae9ca1634d72d69d9405faa275734d8768d0bc397c8adf29712","e388f669bee3d625d64144a95d8b01fe7031d066175acd5589dfb41a87910495","177edaa9c03d56a91dca85f7c6535ea6b7ead5a22b4f11ba10bcf6734bedbd3d","14a82277db47500c745612d430a664cac577e217d2c226b5bd8bf361b0175237","91f4c8d21cca682713446693f50909f0de52700dcc40074546f9f60162b7704f","9a2d1e7450d7329f1c7d2b7c151f5b193bd53f81e14d2b642a1717e1482811d8","8cb978f3ce3d75e23aaea8625772b24e85746b829a5c90fd51a3ace839716d3a","ebac125e9b4bc79ea1fa1d6d59e1a801e142beaf62e567b80e7e8dbf5d0999fc","237f3152324baa7603c75b9031f5628d38818ebb959ca6598cb7af68889901a2","d23b887d937ea358e74f019cf9b8791a4f2cc6ef94523d51cac3742b38f01b97","eec595da6b6feaa9398a718aad81be7b69dc5702d9924b84009b096c8ed18ed6","ceaaab830ab295e24e8a042802edf082c814cccd44cb07da7b46f5341d85d835"],"paragraph_range_zero_based":[31704,31727],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p31704"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR PSCell in NR-DC.","paragraph_zero_based":31728},{"literal_text_all_w_t_and_m_t":"reportSFTD-NeighMeas","paragraph_zero_based":31729},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to perform SFTD measurement between PCell and NR neighbour cells in NR standalone. The network does not include this field if reportSFTD-Meas is set to true.","paragraph_zero_based":31730},{"literal_text_all_w_t_and_m_t":"reportRSRP","paragraph_zero_based":31731},{"literal_text_all_w_t_and_m_t":"Indicates whether UE is required to include RSRP result of NR PSCell or NR neighbour cells in SFTD measurement result, derived based on SSB. If it is set to true, the network should ensure that ssb-ConfigMobility is included in the measurement object for NR PSCell or NR neighbour cells.","paragraph_zero_based":31732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31733},{"literal_text_all_w_t_and_m_t":"RxTxPeriodical field descriptions","paragraph_zero_based":31734},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31735},{"literal_text_all_w_t_and_m_t":"This field indicates the number of UE Rx-Tx time difference measurement reports. If configured to r1, the network does not configure rxTxReportInterval and only one measurement is reported. If configured to infinity, UE periodically reports measurements according to the periodicity configured by rxTxReportInterval.","paragraph_zero_based":31736},{"literal_text_all_w_t_and_m_t":"rxTxReportInterval","paragraph_zero_based":31737},{"literal_text_all_w_t_and_m_t":"This field indicates the measurement reporting periodicity of UE Rx-Tx time difference.","paragraph_zero_based":31738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31739},{"literal_text_all_w_t_and_m_t":"other field descriptions","paragraph_zero_based":31740},{"literal_text_all_w_t_and_m_t":"MeasTriggerQuantity","paragraph_zero_based":31741},{"literal_text_all_w_t_and_m_t":"SINR is applicable only for CONNECTED mode events.","paragraph_zero_based":31742},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31743},{"literal_text_all_w_t_and_m_t":"ReportOnScellActivation field descriptions","paragraph_zero_based":31744},{"literal_text_all_w_t_and_m_t":"rsType","paragraph_zero_based":31745},{"literal_text_all_w_t_and_m_t":"Indicates which RS is used to provide the measurement result. Only value ssb can be set in this release.","paragraph_zero_based":31746},{"literal_text_all_w_t_and_m_t":"reportQuantityRS-Indexes","paragraph_zero_based":31747},{"literal_text_all_w_t_and_m_t":"Indicates which measurement information per RS index is used to sort the reported measurement results and is included in the measurement report.","paragraph_zero_based":31748},{"literal_text_all_w_t_and_m_t":"maxNrofRS-IndexesToReport","paragraph_zero_based":31749},{"literal_text_all_w_t_and_m_t":"Max number of RS indexes to include in the measurement report.","paragraph_zero_based":31750},{"literal_text_all_w_t_and_m_t":"includeBeamMeasurements","paragraph_zero_based":31751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["1928274b1f09c9ba083c488149f34fce1726aba3237bdae6391d59cecb9a2fa6","13ab3e0b6a0973160a6a39993298b04663da4a237d45bfd1688337cc5da33eeb","673414b4ae4acf221a7987eafac0ed29f9109b294cb584af8fde53b82b9df755","77089c88c3dfc588ea3a344f7fb4513ffc8aa0025f1bddbc2d56a6bae18a6372","9722af78936e8fb105f51f0d6c5a4a1425da2fd8a26df01d2df753161d18ed87","ea37c1