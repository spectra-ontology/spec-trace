{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44544},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PoolConfigCommon","paragraph_zero_based":44545},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PoolConfigCommon is used to configure the cell-specific NR sidelink communication resource pool.","paragraph_zero_based":44546},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon information element","paragraph_zero_based":44547},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44548},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIGCOMMON-START","paragraph_zero_based":44549},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44550},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon-r16 ::=      SEQUENCE {","paragraph_zero_based":44551},{"literal_text_all_w_t_and_m_t":"    sl-RxPool-r16                        SEQUENCE (SIZE (1..maxNrofRXPool-r16)) OF SL-ResourcePool-r16         OPTIONAL,    -- Need R","paragraph_zero_based":44552},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolSelectedNormal-r16          SEQUENCE (SIZE (1..maxNrofTXPool-r16)) OF SL-ResourcePoolConfig-r16   OPTIONAL,    -- Need R","paragraph_zero_based":44553},{"literal_text_all_w_t_and_m_t":"    sl-TxPoolExceptional-r16             SL-ResourcePoolConfig-r16                                             OPTIONAL     -- Need R","paragraph_zero_based":44554},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44555},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44556},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIGCOMMON-STOP","paragraph_zero_based":44557},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44558},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44559},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfigCommon field descriptions","paragraph_zero_based":44560},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":44561},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. This field is not present when SL-BWP-PoolConfigCommon is included in SidelinkPreconfigNR.","paragraph_zero_based":44562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44563},{"literal_text_all_w_t_and_m_t":"–SL-BWP-PRS-PoolConfig","paragraph_zero_based":44564},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-PRS-PoolConfig is used to configure UE specific NR sidelink PRS dedicated resource pool.","paragraph_zero_based":44565},{"literal_text_all_w_t_and_m_t":"SL-BWP-PRSPoolConfig information element","paragraph_zero_based":44566},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44567}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2e756afd1dfdac16aa06a63792b296a7892a765b416db7ee732c56ccd9cedf0f","c10b4daf4ab51ec42486493eed4e4c779c1c704328eb6c06203be250eed62533","477fd03077825e93526973681373936f4c543b3e5a84a20f6e310f75d64d1492","a1c9bab37211fd94a97b10ff28c9e5a100967a8e39e324087ab8ecff40c88ec9","94483ba192cf0c5080de5e5a3dd82abe561b80ea8496d5c395e44e5a991e4ec9","1c581d5c954e06ce34634d06af1ed2171ab39ad62836616de49ea6fc9040ffac","5033bbc02845fd20d80e652600549574163735900f3d2a4d0e58c62692ecd829","4eacdbcecb11672bf2883949769f4cb45d1b3fd10a82599ca5730c988375511b","4f1f2e4cc7ed2464fc670f8b0558e1340baa067af835bb460f7d6cb23cd9540d","12b97c0b7a4e28f91a3044b6859592ca475217608bf1401795b