r17           CMRGroupingAndPairing-r17                                               OPTIONAL,  -- Need R","paragraph_zero_based":27157},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffset-r17       INTEGER (0..124)                                                        OPTIONAL,  -- Need S","paragraph_zero_based":27158},{"literal_text_all_w_t_and_m_t":"    aperiodicTriggeringOffsetL2-r17     INTEGER(0..31)                                                          OPTIONAL   -- Need R","paragraph_zero_based":27159},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27160},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27161},{"literal_text_all_w_t_and_m_t":"    resourceType-r18                    ENUMERATED {periodic}                                                   OPTIONAL   -- Cond LTM","paragraph_zero_based":27162},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27165},{"literal_text_all_w_t_and_m_t":"CMRGroupingAndPairing-r17 ::=        SEQUENCE {","paragraph_zero_based":27166},{"literal_text_all_w_t_and_m_t":"    nrofResourcesGroup1-r17              INTEGER (1..7),","paragraph_zero_based":27167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3631a5d88aaac41cda4d02751fbb123366159fd8afac267282ae7a2d21b73afd","f9c517511b5ec1d9e1e717683470502e606dc93a20119b61353966158b830986","e4139a235ac54d9791520562e8e30d02c9f7dd7bc999fc47e540ed0ce939578e","d9452da3b172d368315b549f7151aab9a02972d9a91f5f8a5acbfcd2fccfe779","414890ca513c3fc83a113c63ecc49c7e5b274a98379b29507dffa69168dde034","f6