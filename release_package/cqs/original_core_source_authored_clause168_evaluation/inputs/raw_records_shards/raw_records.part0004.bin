AS notification.","paragraph_zero_based":17153},{"literal_text_all_w_t_and_m_t":"SIB8 information element","paragraph_zero_based":17154},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17155},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB8-START","paragraph_zero_based":17156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17157},{"literal_text_all_w_t_and_m_t":"SIB8 ::=                        SEQUENCE {","paragraph_zero_based":17158},{"literal_text_all_w_t_and_m_t":"    messageIdentifier               BIT STRING (SIZE (16)),","paragraph_zero_based":17159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4cfd071e350c71975b5847d62ffa6c8a1d65fc37070a6cd2026a203a0405d068","67cbb04a0985f770110ceaa95629fdd9480e61ff3b4910ede42f9de2418de017","f3b27195c29b868f521591fa38f2cb75e9dc548498984ec0ea0bfb999ad8b33e","ace383e63d192be6418fd373a5def67d7addad583995bbb3f485d94c06489ab2","89d0588cbc2229b7fa6407a72bd2efe7ba959c3b67521b14661fbf68e76dcb35","f58653347b6f70569840873a4049d5f5092d6a36b17fa11437a610e6784140fe","60f635913741ff1d74ec6a557a46afc1a2766509cd9b87eb1b52af80502d38db","4b74216905a9d90091caf0ff8ba6a3bf1a32a69882daa01f2a4e2271f4b63886","8d71f3b48c1eac4d0e96087078dc8b1522072e43005e88072f70168ec686b2ae","f377fd499f5df11df48bef3fd689168bb3923a45c71726d479056e7337408339","05454a53a3b95b77b93f6b9280a0f42c95f01e875ee569421a730798df00a30f","e5859e810fc0851299e2dbcf414f39adada959419f273630f5f33caf3ea302e6","281ee145b007f852f55135f9c36b9b2257fb11b2a8647fb9858b2e4cb9693c9e","6e7f0151768ed3bdc307e64be69e21bc24b01ec3cfa949d4e3ae2877e55c0aee","b561f3385b274012a2c47178562b0351e84c24e4784a5da97f017e4d2650976d","c22f71448186dde309e87e640cae0c2addba3cfd9c0c04c44