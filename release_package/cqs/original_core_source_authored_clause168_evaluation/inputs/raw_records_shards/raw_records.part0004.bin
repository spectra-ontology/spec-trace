:25693},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25694},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25695},{"literal_text_all_w_t_and_m_t":"MUSIM-Starting-SFN-AndSubframe-r17 ::= SEQUENCE {","paragraph_zero_based":25696},{"literal_text_all_w_t_and_m_t":"    starting-SFN-r17                       INTEGER (0..1023),","paragraph_zero_based":25697},{"literal_text_all_w_t_and_m_t":"    startingSubframe-r17                   INTEGER (0..9)","paragraph_zero_based":25698},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25699},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25700},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-STOP","paragraph_zero_based":25701},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25702},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25703}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["c9ab7f9119ae7a28acc6b21f23ea4fb9ac9ba3ad958600f6f370105921edd986","d6a71028bd9c506d0317ffdf39fcca699f3d66f6d7eb475d5c6bdcad962b7cf2","d27f74799b7011c8e1d659d71a44d999bc5b4962eab30dfe26ceeeede2c2a0b6","3c4c2b95645e5aa497233a849596baf893e2cb81e87bdd3c2fc400ab51dfb3c5","df3732cfcc5303fe2043ebb38e2bd8e1f68403aeca11d428f001853ab4f5d355","59928c6c792afd19374bec2e6b041624bd95b7f2d9c174e9fb43c60d3b4982f5","db7704623e19aacd08bc3155c4063fd275382f146673f1e9c83fb275ae739fbc","7e2a851cdf8bba4f1fc075231bc450bdb2a7d9a7e6d9d2b19f767315ff9e91b2","31c30bf34165d7320a2dc8f9dfabab9dd5e6db2be0e6a8f6bbcdfe0bdd5796f4","8316e4ee5a88c4e86d25c0c0c72686821876f68a240e7b956781d88d0841a8d1","e2e1160b44e97c7d5c755300fa1963e13679622830baaf868b3fb69d42696202","21ce6fdd28cd6858bdfde0382f25b780ce2eb64f2a5d16