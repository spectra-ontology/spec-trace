{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    msgA-PUSCH-Resource-Index-r16   INTEGER (0..3071)     OPTIONAL  -- Cond 2StepCFRA","paragraph_zero_based":30624},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30625},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30626},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30627},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30628},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource ::=         SEQUENCE {","paragraph_zero_based":30629},{"literal_text_all_w_t_and_m_t":"    csi-RS                          CSI-RS-Index,","paragraph_zero_based":30630},{"literal_text_all_w_t_and_m_t":"    ra-OccasionList                 SEQUENCE (SIZE(1..maxRA-OccasionsPerCSIRS)) OF INTEGER (0..maxRA-Occasions-1),","paragraph_zero_based":30631},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                INTEGER (0..63),","paragraph_zero_based":30632},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30633},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30634},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30635},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGDEDICATED-STOP","paragraph_zero_based":30636},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30637},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30638},{"literal_text_all_w_t_and_m_t":"CFRA-CSIRS-Resource field descriptions","paragraph_zero_based":30639},{"literal_text_all_w_t_and_m_t":"csi-RS","paragraph_zero_based":30640},{"literal_text_all_w_t_and_m_t":"The ID of a CSI-RS resource defined in the measurement object associated with this serving cell.","paragraph_zero_based":30641},{"literal_text_all_w_t_and_m_t":"ra-OccasionList","paragraph_zero_based":30642},{"literal_text_all_w_t_and_m_t":"RA occasions that the UE shall use when performing CF-RA upon selecting the candidate beam identified by this CSI-RS. The network ensures that the RA occasion indexes provided herein are also configured by prach-ConfigurationIndex and msg1-FDM. Each RACH occasion is sequentially numbered, first, in increasing order of frequency resource indexes for frequency multiplexed PRACH occasions; second, in increasing order of time resource indexes for time multiplexed PRACH occasions within a PRACH slot and Third, in increasing order of indexes for PRACH slots.","paragraph_zero_based":30643},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":30644},{"literal_text_all_w_t_and_m_t":"The RA preamble index to use in the RA occasions associated with this CSI-RS.","paragraph_zero_based":30645},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30646},{"literal_text_all_w_t_and_m_t":"CFRA field descriptions","paragraph_zero_based":30647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d3ed19287dabc5fd436e62917264bf86e8c6c3d4158a3efcf0eafecb07dbce75","3339666899d79588c53badc1dce5e65b06ad31affede47bde2ab60062bebfda8","c95abb0f077c8c0f6025e0dfc3fc9a083959ff4f20b2316f05a596ca55c0b3dc","59088c01cdecd79bb200b79290ac12a4b3d4be5da5ac770e1f84a858d761575e","8517b17f31a5d5205d1f7f38c1fc3b6debbd9c4b6bf4436d0d4d67bc99284c23","687cf6c82953b32aee684627249d003d5f068979e68609cb79427869ba0ea7cf","e5854ac158a0afaa105f8e1c428c0d12d1066d456e92736b1421d2e91e3ad1b7","63d77af0de24dad738bcaaa3d1bf40e15c5f6c777a3e505720cfd6c1588ec5a5","2b401bc7499ff3d8c49ab1559cce342e9874b310286b3f0bcee2fe8501feabe1","2269a8d080d4815bd18d1e643c595d3d0f7a674112430a41d9ad4ac5d1edc0b6","447897ca1ff8e31679c85a3656903db2bf07fc6761b711e1519e98f874532aee","1b12cfae35f934aa423eec08138465c805e46dda0b032b66ebbde3f871582d14","830a9cd18de062da490461a43eb379dd7a030730dc762cff6b33c7e6efd8d0a3","5b233d898ac050d27081960f21c3b8bf8ee15c77c8460a7ce89ed83781c198c5","d543e5befb49d2f2000a971edc50b58176e3588f59dd9783e25cca8144a565e5","5baa72e91ece378a0b1ec84078dc02a1f7c722f6dd39358c1ef9418a127202fe","ffa9ec0bfde40789b2442892a45b8494e3bee799c31a3c36ce0bf22a2fcc845a","34bd436fe736c2500384536e88606779da621b1a70f06ed933617317b0e9ced7","5c5eeaef1c73a09fc1201e45d99dd20ccc1141157bbe12be8fdea5621b7b2f81","c7a35498ef359fa37b9d1bdfd84d2ebdcb65533ed386ead0066f6603da0c3838","3ad19726d805764e70dbf21075e3c732ab28d8f97aa495861495b293a604f62e","92821fd1594c3369bf043a4297bc9e58a8a8f71f3ddb173744884b4ba76207da","ba6cd5e87f333dd9b0a79ae5840af4fb31f94d3c5c72b987ad11aa26b1322f90","a6694789cb5397854b0d7b86fd717f5e015c40ebd077099dd7f625e08028f736"],"paragraph_range_zero_based":[30624,30647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30624"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msg1-RepetitionNum","paragraph_zero_based":30648},{"literal_text_all_w_t_and_m_t":"Indicates the MSG1 repetition number used for contention free 4-step random access type in TS 38.321 [3]. If this field is absent, the UE performs contention free 4-step random access without MSG1-Repetitions.","paragraph_zero_based":30649},{"literal_text_all_w_t_and_m_t":"occasions","paragraph_zero_based":30650},{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommon in the first active UL BWP.","paragraph_zero_based":30651},{"literal_text_all_w_t_and_m_t":"ra-ssb-OccasionMaskIndex","paragraph_zero_based":30652},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":30653},{"literal_text_all_w_t_and_m_t":"rach-ConfigGeneric","paragraph_zero_based":30654},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA. The UE shall ignore preambleReceivedTargetPower, preambleTransMax, powerRampingStep, ra-ResponseWindow signaled within this field and use the corresponding values provided in RACH-ConfigCommon.","paragraph_zero_based":30655},{"literal_text_all_w_t_and_m_t":"ssb-perRACH-Occasion","paragraph_zero_based":30656},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion.","paragraph_zero_based":30657},{"literal_text_all_w_t_and_m_t":"totalNumberOfRA-Preambles","paragraph_zero_based":30658},{"literal_text_all_w_t_and_m_t":"Total number of preambles used for contention free random access in the RACH resources defined in CFRA, excluding preambles used for other purposes (e.g. for SI request). If the field is absent but the field occasions is present, the UE may assume all the 64 preambles are for RA. The setting should be consistent with the setting of ssb-perRACH-Occasion, if present, i.e. it should be a multiple of the number of SSBs per RACH occasion.","paragraph_zero_based":30659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30660},{"literal_text_all_w_t_and_m_t":"CFRA-SSB-Resource field descriptions","paragraph_zero_based":30661},{"literal_text_all_w_t_and_m_t":"msgA-PUSCH-Resource-Index","paragraph_zero_based":30662},{"literal_text_all_w_t_and_m_t":"Identifies the index of the PUSCH resource used for MSGA CFRA. The PUSCH resource index indicates a valid PUSCH occasion (as specified in TS 38.213 [13], clause 8.1A) and the associated DMRS resources corresponding to a PRACH slot. The PUSCH resource indexes are sequentially numbered and are mapped to valid PUSCH occasions corresponding to a PRACH slot which are ordered, first, in increasing order of frequency resource indexes for frequency multiplexed PUSCH occasions; second, in increasing order of DMRS resource indexes within a PUSCH occasion, where a DMRSid resource index is determined first in an ascending order of a DMRS port index and then in an ascending order of a DMRS sequence index, third in increasing order of time resource indexes for time multiplexed PUSCH occasions within a PUSCH slot and fourth, in increasing order of indexes for PUSCH slots. For the case of contention free 2-step random access type, if this field is absent, the UE shall use the value 0.","paragraph_zero_based":30663},{"literal_text_all_w_t_and_m_t":"ra-PreambleIndex","paragraph_zero_based":30664},{"literal_text_all_w_t_and_m_t":"The preamble index that the UE shall use when performing CF-RA upon selecting the candidate beams identified by this SSB.","paragraph_zero_based":30665},{"literal_text_all_w_t_and_m_t":"ssb","paragraph_zero_based":30666},{"literal_text_all_w_t_and_m_t":"The ID of an SSB transmitted by this serving cell.","paragraph_zero_based":30667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30668},{"literal_text_all_w_t_and_m_t":"CFRA-TwoStep field descriptions","paragraph_zero_based":30669},{"literal_text_all_w_t_and_m_t":"msgA-CFRA-PUSCH","paragraph_zero_based":30670},{"literal_text_all_w_t_and_m_t":"PUSCH resource configuration(s) for msgA CFRA.","paragraph_zero_based":30671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["671afd950b1b5f89106755e552386e8562531a803b4ad0a7a250aebd2f698c26","4b0cdabc9174c14af6e79b593e3db35d9befb5b9ec5170f23502681f98dd0655","f8ec2eff3364995d7c7e008861a73ea0911a4716f53b7726b498283f447ecc00","f5945a5889434911b3f9e0a69a3c1303b48746f2858854327bc81dc1fc223289","9c9b87b2bda5d9fef7ac502803a2edac972919f752bad5183b84d4e34d35bf3c","b8c6dd0a1e1089336752981177f957c270c0e856c65d99ed7995db6bb1194749","5409e3e224cd4ac1d96acc13408811dc59d1246b5e115d89240aba1a182cad21","c943204cfe347eb85a0544d978b1c517ebd4c53bec5a5b0fdc65d20ffb6faa76","c2d1dd862ddb7c2edbbc5451ea035a110c11725049ca7d2aa757dff44c1178bb","236551a70b8bf28f881062527953bd140d6718814834cc5aac6467cce696859e","7f3a1302ec2bb1001c91c5d7baf5eb889cf2fef31923b8e67035bf5db074d43e","bad16c0927f229784a8265e4f176aa1e9b090737bafed79b36a17e0c6b201435","f4156b1806e99d0b414ddb725280464f27d17ca52adc88ae9e0478c29792f7ac","9eeef5d3d7e8c420fa721dd3008cc66c26d3e4ff74b2f32414adb73e3582a341","cc54db3795eb3b84d844a9774ae8d39ed6ef89da7464e4f32f480fef0b5a28a4","c3150f264c68e8166f8b870569e555b262ebb2afb867db60f2a5fbf12e289040","be6963486e1f58c2535b020287b4cc4ae41029347560dc83fc9d317484cbc06e","644f63ef08f3befe7d0c05dcd624ed8f2dd56bd04c616ae0c54d5311c89341ce","fe8418dfe9140bf3fef3a972595f6a4fb0f664c1e2a557f857c50b6d8a216e4a","ed7f4b5dd2d03862054d0370ab8c7978962217d5bcc3702ef5879a32842f6f1c","6275fea8a3f93899d1392571a46a630d5814157f21b61dfc941abc45ce7288ca","433a82c2980d3424306ee61b8c2a8824d13e8997fecd41df050747ee94a9c6a0","55782196f7571b13eaa0846e9db52eed9b94c628ffa2c28740af268c4d4782b0","103cc141c331f1601c8c3bd29100293cc83059b1d2dfc394c91c2d7007729add"],"paragraph_range_zero_based":[30648,30671],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30648"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"msgA-TransMax","paragraph_zero_based":30672},{"literal_text_all_w_t_and_m_t":"Max number of MsgA preamble transmissions performed before switching to 4-step type random access (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when 2-step and 4-step RA type are configured and switching to 4-step type RA is supported. If the field is absent in cfra-TwoStep, switching from 2-step RA type to 4-step RA type is not allowed.","paragraph_zero_based":30673},{"literal_text_all_w_t_and_m_t":"occasionsTwoStepRA","paragraph_zero_based":30674},{"literal_text_all_w_t_and_m_t":"RA occasions for contention free random access. If the field is absent, the UE uses the RA occasions configured in RACH-ConfigCommonTwoStepRA in the first active UL BWP.","paragraph_zero_based":30675},{"literal_text_all_w_t_and_m_t":"ra-SSB-OccasionMaskIndex","paragraph_zero_based":30676},{"literal_text_all_w_t_and_m_t":"Explicitly signalled PRACH Mask Index for RA Resource selection in TS 38.321 [3]. The mask is valid for all SSB resources signalled in ssb-ResourceList.","paragraph_zero_based":30677},{"literal_text_all_w_t_and_m_t":"rach-ConfigGenericTwoStepRA","paragraph_zero_based":30678},{"literal_text_all_w_t_and_m_t":"Configuration of contention free random access occasions for CFRA 2-step random access type.","paragraph_zero_based":30679},{"literal_text_all_w_t_and_m_t":"ssb-PerRACH-OccasionTwoStep","paragraph_zero_based":30680},{"literal_text_all_w_t_and_m_t":"Number of SSBs per RACH occasion for 2-step random access type.","paragraph_zero_based":30681},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30682},{"literal_text_all_w_t_and_m_t":"RACH-ConfigDedicated field descriptions","paragraph_zero_based":30683},{"literal_text_all_w_t_and_m_t":"cfra","paragraph_zero_based":30684},{"literal_text_all_w_t_and_m_t":"Parameters for contention free random access to a given target cell. If this field and cfra-TwoStep are absent, the UE performs contention based random access.","paragraph_zero_based":30685},{"literal_text_all_w_t_and_m_t":"cfra-TwoStep","paragraph_zero_based":30686},{"literal_text_all_w_t_and_m_t":"Parameters for contention free 2-step random access type to a given target cell. Network ensures that cfra and cfra-TwoStep are not configured at the same time. If this field and cfra are absent, the UE performs contention based random access. This field may only be present if msgA-ConfigCommon is configured on the BWP.","paragraph_zero_based":30687},{"literal_text_all_w_t_and_m_t":"ra-prioritization","paragraph_zero_based":30688},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized random access procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":30689},{"literal_text_all_w_t_and_m_t":"ra-PrioritizationTwoStep","paragraph_zero_based":30690},{"literal_text_all_w_t_and_m_t":"Parameters which apply for prioritized 2-step random access type procedure to a given target cell (see TS 38.321 [3], clause 5.1.1).","paragraph_zero_based":30691},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30692},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":30693},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":30694},{"literal_text_all_w_t_and_m_t":"Mandatory","paragraph_zero_based":30695}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2dd935beeac5adfaf03c215515e1e3a85eb3c13fe7f1e8975b9246f64e4233fc","54e7cc5ee748592b5248093a2d737dc3b84f62a409e18d5b737035ec9bafbd0a","5810a415dbffdbb119bc258ccf1500a63ea27ff1e4e884fbc2bc859ce019a7a4","78b920cbc157001fa2955ae00d3cdd81e7baddf7a676a42cd33e4bcec18b182f","a7c10d37002bc00707cc6ce9a57c4736dde01d79c5acc22cf4ad05b66635b66f","f617d70a11207b13ae07c96bd4cee3fc84ffeba92a60b00643c9814dfffe04eb","8accb35c75ca145510a61335969472821617045004bd75112eb4c88d83a4b6ce","c56ba3c984b90a002226bb3c59c77ed2a8625f5fd1ea8e8ab52490bc7e04e1cf","a4c25a2cda3418418dcddd0508fa380e3150ee53f3bf0e3164c5fb1623742cae","f944efc1a1fb79c5c836ab08e3f4e2903b397cda765a36202f316c30fe8ad5bb","6e6aef36c33ca83ebc86710c92d52bbe5d9531f5d1e1a5703dde2b6f809a7b56","fdf4599122871dedef7dac500a48f5d7cc902f21f731bef3ac6219b99b7d54b3","cd28f7c7140d54afe99ef7a4d4baedcb9abc3d58d6f3a06c4a0924697f500dd4","aeb55700560078130bf62dd8d1e2b3d10368ffc76cd5ff2fe041a88d9a9aab3c","6d3e4d63d2ab750008c873d61c79e8fbc40701eea22947badc864d2e72a12fcc","66a90666ef46da73d72e862b047e95bc5af41b72913bdc3447cb28d8f25bc8ab","82395f412b25be970d096562e5b355533229a2003d74d184301eb2f95b62f44d","2ad56da875183184ae1b9bd12c8df320956a58dae55c14e7de7b137a3136ce43","9267e0ef28b2318cc35ef5f2d09e27f5090f40d2694acce23685cdc1a8cce4be","e8d9de2a9e2c29a0974e63fe2ecb20a093ac8027436a90ab79d4bd49a04037d2","67a521bf91d43c344774495eeb677e1f9b928dca807c3a9f3f37edc87a51d44f","f032fba282f428d355f159bf76ab8d51db3ec932610e2507e67fdbad3c6c6299","ef79a1c816d9a24f09ae0c79d95b5f7b6266f8d52d1e1b69768e710ffa88e04a","c7041ffed5f426e975b7ddee5ee6fa5f18824a061bf00eb16f6b7a8a5835bb57"],"paragraph_range_zero_based":[30672,30695],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p30672"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is mandatory present.","paragraph_zero_based":30696},{"literal_text_all_w_t_and_m_t":"Occasions","paragraph_zero_based":30697},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, if the field occasions is present, otherwise it is absent.","paragraph_zero_based":30698},{"literal_text_all_w_t_and_m_t":"2StepCFRA","paragraph_zero_based":30699},{"literal_text_all_w_t_and_m_t":"The field is optionally present for the case of 2-step RA type contention free random access, Need S, otherwise it is absent.","paragraph_zero_based":30700},{"literal_text_all_w_t_and_m_t":"4StepCFRArep","paragraph_zero_based":30701},{"literal_text_all_w_t_and_m_t":"For non-(e)RedCap UEs, the field is optionally present, Need S, if resources is set to ssb and there is one FeatureCombinationPreambles entry indicating only msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":30702},{"literal_text_all_w_t_and_m_t":"For RedCap UEs or if RedCap is considered to be applicable for this Random Access procedure for eRedCap UEs, the field is optionally present, Need S, if resources is set to ssb and there is one FeatureCombinationPreambles entry indicating only redCap and msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":30703},{"literal_text_all_w_t_and_m_t":"For eRedCap UEs, if eRedCap is considered to be applicable for this Random Access procedure, the field is optional present, Need S, if resource is set to ssb and there is one FeatureCombinationPreambles entry indicating only eRedCap and msg1-Repetitions which is associated with the same Msg1 repetition number.","paragraph_zero_based":30704},{"literal_text_all_w_t_and_m_t":"Otherwise, it is absent.","paragraph_zero_based":30705},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30706},{"literal_text_all_w_t_and_m_t":"–RACH-ConfigGeneric","paragraph_zero_based":30707},{"literal_text_all_w_t_and_m_t":"The IE RACH-ConfigGeneric is used to specify the random-access parameters both for regular random access as well as for beam failure recovery.","paragraph_zero_based":30708},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric information element","paragraph_zero_based":30709},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30710},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-START","paragraph_zero_based":30711},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30712},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric ::=              SEQUENCE {","paragraph_zero_based":30713},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex            INTEGER (0..255),","paragraph_zero_based":30714},{"literal_text_all_w_t_and_m_t":"    msg1-FDM                            ENUMERATED {one, two, four, eight},","paragraph_zero_based":30715},{"literal_text_all_w_t_and_m_t":"    msg1-FrequencyStart                 INTEGER (0..maxNrofPhysicalResourceBlocks-1),","paragraph_zero_based":30716},{"literal_text_all_w_t_and_m_t":"    zeroCorrelationZoneConfig           INTEGER(0..15),","paragraph_zero_based":30717},{"literal_text_all_w_t_and_m_t":"    preambleReceivedTargetPower         INTEGER (-202..-60),","paragraph_zero_based":30718},{"literal_text_all_w_t_and_m_t":"    preambleTransMax                    ENUMERATED {n3, n4, n5, n6, n7, n8, n10, n20, n50, n100, n200},","paragraph_zero_based":30719}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["496a4aa