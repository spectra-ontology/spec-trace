{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34657},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN","paragraph_zero_based":34658},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN is used to indicate a PUCCH resource for HARQ ACK and configure the corresponding maximum payload size for the PUCCH resource.","paragraph_zero_based":34659},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN information element","paragraph_zero_based":34660},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34661},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-START","paragraph_zero_based":34662},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34663},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-r16  ::=           SEQUENCE {","paragraph_zero_based":34664},{"literal_text_all_w_t_and_m_t":"    sps-PUCCH-AN-ResourceID-r16     PUCCH-ResourceId,","paragraph_zero_based":34665},{"literal_text_all_w_t_and_m_t":"    maxPayloadSize-r16              INTEGER (4..256)                     OPTIONAL    -- Need R","paragraph_zero_based":34666},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34668},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-STOP","paragraph_zero_based":34669},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34671},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN field descriptions","paragraph_zero_based":34672},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":34673},{"literal_text_all_w_t_and_m_t":"Indicates the maximum payload size for the corresponding PUCCH resource ID.","paragraph_zero_based":34674},{"lite