{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            rrcPosSystemInfoRequest-r16         RRC-PosSystemInfoRequest-r16-IEs,","paragraph_zero_based":13800},{"literal_text_all_w_t_and_m_t":"            criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":13801},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":13802},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":13803},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13804},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13805},{"literal_text_all_w_t_and_m_t":"RRCSystemInfoRequest-IEs ::=    SEQUENCE {","paragraph_zero_based":13806},{"literal_text_all_w_t_and_m_t":"    requested-SI-List                   BIT STRING (SIZE (maxSI-Message)),  --32bits","paragraph_zero_based":13807},{"literal_text_all_w_t_and_m_t":"    spare                               BIT STRING (SIZE (12))","paragraph_zero_based":13808},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13809},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13810},{"literal_text_all_w_t_and_m_t":"RRC-PosSystemInfoRequest-r16-IEs ::=  SEQUENCE {","paragraph_zero_based":13811},{"literal_text_all_w_t_and_m_t":"    requestedPosSI-List                   BIT STRING (SIZE (maxSI-Message)),  --32bits","paragraph_zero_based":13812},{"literal_text_all_w_t_and_m_t":"    spare                                 BIT STRING (SIZE (11))","paragraph_zero_based":13813},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13814},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13815},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCSYSTEMINFOREQUEST-STOP","paragraph_zero_based":13816},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":13817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13818},{"li