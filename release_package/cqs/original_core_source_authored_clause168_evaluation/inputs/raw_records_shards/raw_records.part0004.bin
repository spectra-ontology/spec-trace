":6325},{"literal_text_all_w_t_and_m_t":"Inequality Y1-1 (Entering condition 1)","paragraph_zero_based":6326},{"literal_text_all_w_t_and_m_t":"Mp + Hys < Thresh1","paragraph_zero_based":6327},{"literal_text_all_w_t_and_m_t":"Inequality Y1-2 (Entering condition 2)","paragraph_zero_based":6328},{"literal_text_all_w_t_and_m_t":"Mr– Hys > Thresh2","paragraph_zero_based":6329},{"literal_text_all_w_t_and_m_t":"Inequality Y1-3 (Leaving condition 1)","paragraph_zero_based":6330},{"literal_text_all_w_t_and_m_t":"Mp – Hys > Thresh1","paragraph_zero_based":6331},{"literal_text_all_w_t_and_m_t":"Inequality Y1-4 (Leaving condition 2)","paragraph_zero_based":6332},{"literal_text_all_w_t_and_m_t":"Mr + Hys < Thresh2","paragraph_zero_based":6333},{"literal_text_all_w_t_and_m_t":"The variables in the formula are defined as follows:","paragraph_zero_based":6334},{"literal_text_all_w_t_and_m_t":"Mp is the measurement result of the PCell, not taking into account any offsets.","paragraph_zero_based":6335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["b6abaa15e0c05596575b8cb2985702d6ff5f5bd48b70b921440436c4adb45e87","f26ae869529109105d5911d5945ec342d588bc1c1e717dcdb0955e416df2e37e","f03562175907f8c6c1a0690c36b0908f0dee2ae19cf44394a0a2b26f5991b4e7","bf3ef98c77d1f9e34af7a5d4b00dc8ff8c3831795caf790ec762feb17ef80735","0a863cd759c09a597ddefc70e74e13fc6317a7957ef8ea165104c945b6d2d979","c58d3f5402144c5de817233e425cdc06cb8f8fe5852df06b8d5098fcca4685f4","8bd473fea5eb3597fea7662287d69f9c968f2d3ce5067d82b7d150782e637be4","5e949c3d2e98f4392f1f27430be95e3196288dc5aed57dfe897a84327cabbcfa","ed6a1572449d1bbab6ce1144f6ae51446a1c89a8c4ced04cfccca3ae0feefd18","1d88a923f5a964b49430f294af6ed2e74a4646700d1