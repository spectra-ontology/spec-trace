{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":36432},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36433},{"literal_text_all_w_t_and_m_t":"Uplink-powerControlId-r17 ::= INTEGER(1.. maxUL-TCI-r17)","paragraph_zero_based":36434},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36435},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINK-POWERCONTROL-STOP","paragraph_zero_based":36436},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":36437},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36438},{"literal_text_all_w_t_and_m_t":"Uplink-PowerControl field descriptions","paragraph_zero_based":36439},{"literal_text_all_w_t_and_m_t":"p0AlphaSetforPUSCH, p0AlphaSetforPUCCH, p0AlphaSetforSRS","paragraph_zero_based":36440},{"literal_text_all_w_t_and_m_t":"Configures power control parameters for PUSCH, PUCCH and SRS (see TS 38.213 [13], clause 7.2). When the field alpha is absent in p0AlphaSetforPUSCH, the UE applies the value 1 for PUSCH power control. When the field alpha is absent in p0AlphaSetforSRS, the UE applies the value 1 for SRS power control. In p0AlphaSetForPUCCH, the field alpha is absent (not used).","paragraph_zero_based":36441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36442},{"literal_text_all_w_t_and_m_t":"–Uu-RelayRLC-ChannelConfig","paragraph_zero_based":36443},{"literal_text_all_w_t_and_m_t":"The IE Uu-RelayRLC-ChannelConfig is used to configure an RLC entity, a corresponding logical channel in MAC for Uu Relay RLC channel between L2 U2N Relay UE and network, or between a N3C relay UE and network in case of MP.","paragraph_zero_based":36444},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig information element","paragraph_zero_based":36445},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":36446},{"literal_text_all_w_t_and_m_t":"-- TAG-UU-RELAYRLC-CHANNELCONFIG-START","paragraph_zero_based":36447},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36448},{"literal_text_all_w_t_and_m_t":"Uu-RelayRLC-ChannelConfig-r17::= SEQUENCE {","paragraph_zero_based":36449},{"literal_text_all_w_t_and_m_t":"    uu-LogicalChannelIdentity-r17    LogicalChannelIdentity                    OPTIONAL,   -- Cond RelayLCH-SetupOnly","paragraph_zero_based":36450},{"literal_text_all_w_t_and_m_t":"    uu-RelayRLC-ChannelID-r17        Uu-RelayRLC-ChannelID-r17,","paragraph_zero_based":36451},{"literal_text_all_w_t_and_m_t":"    reestablishRLC-r17               ENUMERATED {true}                         OPTIONAL,   -- Need N","paragraph_zero_based":36452},{"literal_text_all_w_t_and_m_t":"    rlc-Config-r17                   RLC-Config                                OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":36453},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig-r17     LogicalChannelConfig                      OPTIONAL,   -- Cond RelayLCH-Setup","paragraph_zero_based":36454},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":36455}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2a1b4ef25ea0bf6329107b3c0bfa29469afcaf2ba2a270df8bc9fd74e77c84db","ddc1506fb0e320cc51f297b070d59bab4cee86affa80b6eaef45804b8db94785","c33f2c52a0cab998c20c9486c781604b1c07bad55ac4b52463d9d4c253ba4970","4bde7dadb7fb43b8b28119d5e527b811649d795f963ed5bfb642cc8e2130486f","898a8d2d2cf2ad8ea9563ce567932b01b5d3d4a75dac398468dc41cc081d65c0","7e1123914896991158b359670aa5251cc8b182addeeabe7af7d93c4b0181cc03","dd7680478b95044ddf0dabba1053a1f09c737f809a8792e13ba3ab