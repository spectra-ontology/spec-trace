{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise, Need R. ","paragraph_zero_based":28296},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28297},{"literal_text_all_w_t_and_m_t":"–PLMN-Identity","paragraph_zero_based":28298},{"literal_text_all_w_t_and_m_t":"The IE PLMN-Identity identifies a Public Land Mobile Network. Further information regarding how to set the IE is specified in TS 23.003 [21].","paragraph_zero_based":28299},{"literal_text_all_w_t_and_m_t":"PLMN-Identity information element","paragraph_zero_based":28300},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28301},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-START","paragraph_zero_based":28302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28303},{"literal_text_all_w_t_and_m_t":"PLMN-Identity ::=                   SEQUENCE {","paragraph_zero_based":28304},{"literal_text_all_w_t_and_m_t":"    mcc                                 MCC                 OPTIONAL,                   -- Cond MCC","paragraph_zero_based":28305},{"literal_text_all_w_t_and_m_t":"    mnc                                 MNC","paragraph_zero_based":28306},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28308},{"literal_text_all_w_t_and_m_t":"MCC ::=                             SEQUENCE (SIZE (3)) OF MCC-MNC-Digit","paragraph_zero_based":28309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28310},{"literal_text_all_w_t_and_m_t":"MNC ::=                             SEQUENCE (SIZE (2..3)) OF MCC-MNC-Digit","paragraph_zero_based":28311},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28312},{"literal_text_all_w_t_and_m_t":"MCC-MNC-Digit ::=                   INTEGER (0..9)","paragraph_zero_based":28313},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28314},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMN-IDENTITY-STOP","paragraph_zero_based":28315},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28316},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28317},{"literal_text_all_w_t_and_m_t":"PLMN-Identity field descriptions","paragraph_zero_based":28318},{"literal_text_all_w_t_and_m_t":"mcc","paragraph_zero_based":28319}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["277e74992959ce83c5a3ccd728d6b440abe533434486ceea5d97c182ed9ab642","6278f655befa4b164e8720e0af3eeee9e45910f64de97c97c8037fc189d14d6c","11c2ea79291d9c5538d4d514e1f0a45fc8a03f4d5d5f3e50724d872af9a22490","3f8674adda4d1c8f277122aebb8fbe799fe2b4259fa876da3da63ae857704ffa","461e51d46be20cb6c7d33016c22dfb0217a3ed8a3ad5c4b9c59e80c146dbe166","237de05876874f793e7965467adb56086412208b19d70cfc6726b500054cfaa6","e1300dc962b628fc1187c6617b329c43ea21c404fe19b88459e8447ad019a63d","845c23612c25984efddcb8843c2b69fa20884c4279826ef5200f987d258ed766","f19513373ad371928fbd29daf3d23ac6a97e92b97db8ce5c954aad6abc63870a","9c0630a2bcea22364429a068368af78f6243ce0031e9823ca45bd72774c766af","d34c4937e7843b871a1353d27e5c7ba1f341aea1e8042319111337ba4ec8e7cb","43ee723192333a4ddf2ce97e45b3071b777505b0f0e04f109e65d68286644c0c","338fc2901df2609e9d4e1a0e3ff976caf0a56bf334e10812552b7bbad73a111b","510f07f23d7f1a56f4b5c79f0c85cc20a7365bf0cef6837195b9ee54349c6ec7","d684d7ff518b144fe87c3ad78431c5aeac7405fcfbbcaf4651aa6562b95a6908","765d7c6790cc8c619e8c186c044f14dc5503be61dbe97b9eb69f7a27bc8919a4","126abba6aadf7a32c31e65afa56c0be18f6d45276edb8a7f4e451a2a4dc3f864",