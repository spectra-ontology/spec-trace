eference and stop timer T346h, if running;","paragraph_zero_based":2796},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the musim-LeaveAssistanceConfig:","paragraph_zero_based":2797},{"literal_text_all_w_t_and_m_t":"2>if musim-LeaveAssistanceConfig is set to setup:","paragraph_zero_based":2798},{"literal_text_all_w_t_and_m_t":"3>consider itself to be configured to provide MUSIM assistance information for leaving RRC_CONNECTED in accordance with 5.7.4;","paragraph_zero_based":2799},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":2800},{"literal_text_all_w_t_and_m_t":"3>consider itself not to be configured to provide MUSIM assistance information for leaving RRC_CONNECTED and stop timer T346g, if running.","paragraph_zero_based":2801},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the musim-GapPriorityAssistanceConfig:","paragraph_zero_based":2802},{"literal_text_all_w_t_and_m_t":"2>consider itself to be configured to provide MUSIM assistance information for gap(s) priority in accordance with 5.7.4;","paragraph_zero_based":2803},{"literal_text_all_w_t_and_m_t":"1>else:","paragraph_zero_based":2804},{"literal_text_all_w_t_and_m_t":"2>consider itself not to be configured to provide MUSIM assistance information for gap(s) priority;","paragraph_zero_based":2805},{"literal_text_all_w_t_and_m_t":"1>if the received otherConfig includes the musim-CapabilityRestrictionConfig:","paragraph_zero_based":2806},{"literal_text_all_w_t_and_m_t":"2>if musim-CapabilityRestrictionConfig is set to setup:","paragraph_zero_based":2807}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c2dfe9381682e1d05e3e1c0a6f68f949e57acca8b05