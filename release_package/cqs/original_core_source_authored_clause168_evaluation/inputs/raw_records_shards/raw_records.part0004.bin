{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Includes the UL-DCCH-Message. In this version of the specification, the field is only used to transfer the NR RRC MeasurementReport, RRCReconfigurationComplete, UEAssistanceInformation, FailureInformation, and IABOtherInformation messages when sent via SRB1 and to transfer the NR MCGFailureInformation message when sent via SRB3.","paragraph_zero_based":16392},{"literal_text_all_w_t_and_m_t":"ul-DCCH-MessageEUTRA","paragraph_zero_based":16393},{"literal_text_all_w_t_and_m_t":"Includes the UL-DCCH-Message. In this version of the specification, the field is only used to transfer the E-UTRA RRC MeasurementReport message when sent via SRB1 and to transfer the E-UTRA MCGFailureInformation message when sent via SRB3.","paragraph_zero_based":16394},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16395},{"literal_text_all_w_t_and_m_t":"6.3RRC information elements","paragraph_zero_based":16396},{"literal_text_all_w_t_and_m_t":"6.3.0Parameterized types","paragraph_zero_based":16397},{"literal_text_all_w_t_and_m_t":"–SetupRelease","paragraph_zero_based":16398},{"literal_text_all_w_t_and_m_t":"SetupRelease allows the ElementTypeParam to be used as the referenced data type for the setup and release entries. See A.3.8 for guidelines.","paragraph_zero_based":16399},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16400},{"literal_text_all_w_t_and_m_t":"-- TAG-SETUPRELEASE-START","paragraph_zero_based":16401},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16402},{"literal_text_all_w_t_and_m_t":"SetupRelease { ElementTypeParam } ::= CHOICE {","paragraph_zero_based":16403},{"literal_text_all_w_t_and_m_t":"    release         NULL,","paragraph_zero_based":16404},{"literal_text_all_w_t_and_m_t":"    setup           ElementTypeParam","paragraph_zero_based":16405},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":16406},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16407},{"literal_text_all_w_t_and_m_t":"-- TAG-SETUPRELEASE-STOP","paragraph_zero_based":16408},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":16409},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":16410},{"literal_text_all_w_t_and_m_t":"6.3.1System information blocks","paragraph_zero_based":16411},{"literal_text_all_w_t_and_m_t":"–SIB2","paragraph_zero_based":16412},{"literal_text_all_w_t_and_m_t":"SIB2 contains cell re-selection information common for intra-frequency, inter-frequency and/or inter-RAT cell re-selection (i.e. applicable for more than one type of cell re-selection but not necessarily all) as well as intra-frequency cell re-selection information other than neighbouring cell related.","paragraph_zero_based":16413},{"literal_text_all_w_t_and_m_t":"SIB2 information element","paragraph_zero_based":16414},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":16415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["361c15b57326c15a21316f6c7fd7917207d0429e5025bb14c99c0a19e1d32b69","2f5f6afb9c6df99291c9a8106980ca442278ca23cd09289f12ae04998f3800b9","4f35208fe810f56ea1454bc1f1919b19e5828eba7c8658ea881d689b48d6f438","4a32352f9236de2d049856a7a809810019157aefa81ed12003e8c82dde57470a","176ccc85b61c459348a809e9786a950a34ded2bb9bd4ef7113ef284afa624316","5177d2c4010d27f5a4ea7930c5ec0d763bd2757cd5685c93f4fcb7f4fe3d2824","8451e4943a6fee2fea0154b4d93aaccf2a41553326416179a5d893ec7d599b34","2e91a712f86253c6132000f5fea2036a2d4d7eec783e96ba5e18560a956d9aa5","698317e41d1f3adec1a0a5e5d90c