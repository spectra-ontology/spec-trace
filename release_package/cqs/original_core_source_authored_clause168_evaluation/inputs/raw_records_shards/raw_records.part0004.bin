{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RAN-AreaCode information element","paragraph_zero_based":30720},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30721},{"literal_text_all_w_t_and_m_t":"-- TAG-RAN-AREACODE-START","paragraph_zero_based":30722},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30723},{"literal_text_all_w_t_and_m_t":"RAN-AreaCode ::=                INTEGER (0..255)","paragraph_zero_based":30724},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30725},{"literal_text_all_w_t_and_m_t":"-- TAG-RAN-AREACODE-STOP","paragraph_zero_based":30726},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30727},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30728},{"literal_text_all_w_t_and_m_t":"–RateMatchPattern","paragraph_zero_based":30729},{"literal_text_all_w_t_and_m_t":"The IE RateMatchPattern is used to configure one rate matching pattern for PDSCH, see TS 38.214 [19], clause 5.1.4.1.","paragraph_zero_based":30730},{"literal_text_all_w_t_and_m_t":"RateMatchPattern information element","paragraph_zero_based":30731},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30732},{"literal_text_all_w_t_and_m_t":"-- TAG-RATEMATCHPATTERN-START","paragraph_zero_based":30733},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30734},{"literal_text_all_w_t_and_m_t":"RateMatchPattern ::=                SEQUENCE {","paragraph_zero_based":30735},{"literal_text_all_w_t_and_m_t":"    rateMatchPatternId                  RateMatchPatternId,","paragraph_zero_based":30736},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30737},{"literal_text_all_w_t_and_m_t":"    patternType                         CHOICE {","paragraph_zero_based":30738},{"literal_text_all_w_t_and_m_t":"        bitmaps                             SEQUENCE {","paragrap