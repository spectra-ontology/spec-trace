{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34200},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34201},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN","paragraph_zero_based":34202},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN is used to indicate a PUCCH resource for HARQ ACK and configure the corresponding maximum payload size for the PUCCH resource.","paragraph_zero_based":34203},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN information element","paragraph_zero_based":34204},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34205},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-START","paragraph_zero_based":34206},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34207},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN-r16  ::=           SEQUENCE {","paragraph_zero_based":34208},{"literal_text_all_w_t_and_m_t":"    sps-PUCCH-AN-ResourceID-r16     PUCCH-ResourceId,","paragraph_zero_based":34209},{"literal_text_all_w_t_and_m_t":"    maxPayloadSize-r16              INTEGER (4..256)                     OPTIONAL    -- Need R","paragraph_zero_based":34210},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34212},{"literal_text_all_w_t_and_m_t":"-- TAG-SPS-PUCCH-AN-STOP","paragraph_zero_based":34213},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34214},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34215},{"literal_text_all_w_t_and_m_t":"SPS-PUCCH-AN field descriptions","paragraph_zero_based":34216},{"literal_text_all_w_t_and_m_t":"maxPayloadSize","paragraph_zero_based":34217},{"literal_text_all_w_t_and_m_t":"Indicates the maximum payload size for the corresponding PUCCH resource ID.","paragraph_zero_based":34218},{"literal_text_all_w_t_and_m_t":"sps-PUCCH-AN-ResourceID","paragraph_zero_based":34219},{"literal_text_all_w_t_and_m_t":"Indicates the PUCCH resource ID","paragraph_zero_based":34220},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34221},{"literal_text_all_w_t_and_m_t":"–SPS-PUCCH-AN-List","paragraph_zero_based":34222},{"literal_text_all_w_t_and_m_t":"The IE SPS-PUCCH-AN-List is used to configure the list of PUCCH resources per HARQ ACK codebook","paragraph_zero_based":34223}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["391ff1a0e4cb08a5465a2bc9158ffc457b77050ef59b8d877b20058f0f3d6be6","ec222dfbef51a119fffa916970039daf3f0604b8369516b7451d9df653fce31c","6633628e0a2e313ffc902b0c189b06b6c16acc304bb37b7467f0bb5bb7799459","d9c174e3994f231994370035766a642f15f1bf3426a7a293d13c4e91c33a3cc8","7521b7e8bd5adebac0b1507082a4f2482f283ba51440570c59799e6abe27a7fa","3b65a700c06e807ee4190cd6b6471c8b309e0dc98b015b862d43dc730a0bc1d5","02cb2eb0b72827e6021b87800e058c330613d4acf57007b661791036f5631e0c","5c66d2ac301c06ba98d24abd4b9222da0957cec06da9bec9a2e7d822f01a4af9","ee8fc875c467d218f480d24af9be3a68fa616450f10fddf410aa204fd93851c4","e0707f027a40396ec43cf8c1cad0cc10ee0ffd5c2d4712c8320add315fed1864","155814fe4410c161b7c87d9ff9735e25f133170019a0e987694a7dd11d5c6f42","236a3760a712b8f08f333ebe94e0eb372ce277b18781fe57bd9ad5c1b6e791d3","230dbbb0ca216463848728efb4fed7956c5f78a34cf0be398f0601824129f240","215afe049581996d6ce75fa4673ca9b69b6ac127c78a5fb60e806a093603cb43","421c281934f04db8d870998521185ec265021b9f4bf1a378ae3a95fd24007d46","33afda5e16a412d15773ff46227d0c1317b19ae98a0f3a8c8508ed63c2de92f4","2519972e54b58c37bdcea6d034bdc43f6438a5e1d3f27b14646b52e031192fe0","d95d71410237c2958cfec4d64e5c74e61449a2aa0cb78