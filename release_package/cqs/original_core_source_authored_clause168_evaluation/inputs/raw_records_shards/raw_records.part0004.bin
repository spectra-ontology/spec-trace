{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25008},{"literal_text_all_w_t_and_m_t":"UL-PDCP-DelayValueResult-r16 ::= SEQUENCE {","paragraph_zero_based":25009},{"literal_text_all_w_t_and_m_t":"    drb-Id-r16                       DRB-Identity,","paragraph_zero_based":25010},{"literal_text_all_w_t_and_m_t":"    averageDelay-r16                 INTEGER (0..10000),","paragraph_zero_based":25011},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25014},{"literal_text_all_w_t_and_m_t":"UL-PDCP-ExcessDelayResultList-r17 ::= SEQUENCE (SIZE (1..maxDRB)) OF UL-PDCP-ExcessDelayResult-r17","paragraph_zero_based":25015},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25016},{"literal_text_all_w_t_and_m_t":"UL-PDCP-ExcessDelayResult-r17 ::= SEQUENCE {","paragraph_zero_based":25017},{"literal_text_all_w_t_and_m_t":"    drb-Id-r17                        DRB-Identity,","paragraph_zero_based":25018},{"literal_text_all_w_t_and_m_t":"    excessDelay-r17                   INTEGER (0..31),","paragraph_zero_based":25019},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25020},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25021},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25022},{"literal_text_all_w_t_and_m_t":"TimeBetweenEvent-r17 ::= INTEGER (0..1023)","paragraph_zero_based":25023},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25024},{"literal_text_all_w_t_and_m_t":"-- TAG-MEASRESULTS-STOP","paragraph_zero_based":25025},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25026},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25027},{"literal_text_all_w_t_and_m_t":"MeasResultEUTRA field descriptions","paragraph_zero_based":25028},{"literal_text_all_w_t_and_m_t":"eutra-PhysCellId","paragraph_zero_based":25029},{"literal_text_all_w_t_and_m_t":"Identifies the physical cell identity of the E-UTRA cell for which the reporting is being performed. The UE reports a value in the range 0..503, other values are reserved.","paragraph_zero_based":25030},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["a35298b80b928243a405051fe929dde4766288887c46e5ff87d0696fca7222d8","28849a95c638721f76f23b9dfe5ce2a3da6386ac7207c6c53ff5a135fb922a37","31f9f4562f6dc644d2d82bf45b71c3012af09df38a4bdada60e58af3bf79ca48","a469d1bbc2cc0584085c935867d3651b02b3983ca8038f1195079d5604cd0498","f7881578bf00839b7cdd0a13f3f57ac717db949d9ed99d0a6d01ee5a963321a6","c423a0e5d0bd7b3b28cfb0e799be450bfcb28339198e353cabe57bbe522faf06","349b5e59cb6173d30d3f1bce34732be4508a4b5cec1d0f4b673c6175aee1b264","f604fabf36fee51d377189229fd8b2c5dcb9c25dd793b486586563f37c1ba695","d086295d5b6b8b992c0dce9bc94839d32435ab08f911ece905321cfe05fdee9d","91216946a1971007044b9f1896ce8461e17b7d861f3793f2a0ca05b84d16939e","8a4b42af519b85acc1c883234fb63524b8847ee9a3ef4611c502ae2079c09dd4","dbf804c3b63d4415af6e5c2ffb2460160a0409936173a7faf11a53d61bdf5221","b863d78633dcc98ca94fcf315df049c4691ee720ee8874868e003576019c8a2a","b2ba6fd72537c2804f156ed1d4fa70b631d3fc5c812833809654cfd081cc0d56","b40b08503010f1dac6c42cccc943b44b225d9a81579c0804430b82c6c2a77966","39257e48b3fc96d16130fb6cf341b47c666825878300b9c211ae29a8568db4af","3f5d0797abdc77257bf59749d157c62194e3b695be625ff5a7ad02abf4b8d1d4","758123e814012290459a1726d4f0202e5fa3a05019066734d1ac4746bbfd4383","a2c22d425cda7d5c1ec49600b804e80425c35770dd3053f0d4b7ff64b824e862","f3651b7395e98ed7f241f685f3b44979fd6026751600322b05045bb791329f3a","c352c14ba6e462f05a4267b8ff5b50e4d1a94e22b7f4e3660b3b83ceda4c66a5","8178531db31d7f9c68e835360ba0ed2cb2d6d36c0f8af5530ddeab673a66555f","13954fe29ae80804a11d41216477af7e1153cf0f768c3a320564fcb2e9b48d6f","48f93f0fb5d2bc2a80db88a1ae3bdce0490891c3784d0a3eb6a3aef6c949082a"],"paragraph_range_zero_based":[25008,25031],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p25008"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"MeasResultNR field descriptions","paragraph_zero_based":25032},{"literal_text_all_w_t_and_m_t":"averageDelay","paragraph_zero_based":25033},{"literal_text_all_w_t_and_m_t":"Indicates average delay for the packets during the reporting period, as specified in TS 38.314 [53]. Value 0 corresponds to 0 millisecond, value 1 corresponds to 0.1 millisecond, value 2 corresponds to 0.2 millisecond, and so on.","paragraph_zero_based":25034},{"literal_text_all_w_t_and_m_t":"cellResults","paragraph_zero_based":25035},{"literal_text_all_w_t_and_m_t":"Cell level measurement results.","paragraph_zero_based":25036},{"literal_text_all_w_t_and_m_t":"choCandidate","paragraph_zero_based":25037},{"literal_text_all_w_t_and_m_t":"This field indicates whether the associated cell is a candidate target cell for conditional handover or conditional PSCell change or addition. This field may be included only in the SuccessHO-Report or SuccessPSCell-Report within UEInformationResponse message.","paragraph_zero_based":25038},{"literal_text_all_w_t_and_m_t":"choConfig","paragraph_zero_based":25039},{"literal_text_all_w_t_and_m_t":"If the associated cell is a candidate target cell for conditional handover, this field indicates the conditional handover execution condition for each measId within condTriggerConfig associated to the cell. This field may be included only in the rlf-report within UEInformationResponse message.","paragraph_zero_based":25040},{"literal_text_all_w_t_and_m_t":"drb-Id","paragraph_zero_based":25041},{"literal_text_all_w_t_and_m_t":"Indicates DRB value for which uplink PDCP delay ratio or value is provided, according to TS 38.314 [53].","paragraph_zero_based":25042},{"literal_text_all_w_t_and_m_t":"firstTriggeredEvent","paragraph_zero_based":25043},{"literal_text_all_w_t_and_m_t":"This field is set to condFirstEvent if the execution condition associated to the first entry of choConfig was fulfilled first in time. This field is set to condSecondEvent if the execution condition associated to the second entry of choConfig was fulfilled first in time. This field may be included in rlf-report within UEInformationResponse message or in SCGFailureInformation message.","paragraph_zero_based":25044},{"literal_text_all_w_t_and_m_t":"locationInfo","paragraph_zero_based":25045},{"literal_text_all_w_t_and_m_t":"Positioning related information and measurements.","paragraph_zero_based":25046},{"literal_text_all_w_t_and_m_t":"physCellId","paragraph_zero_based":25047},{"literal_text_all_w_t_and_m_t":"The physical cell identity of the NR cell for which the reporting is being performed.","paragraph_zero_based":25048},{"literal_text_all_w_t_and_m_t":"resultsSSB-Cell","paragraph_zero_based":25049},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":25050},{"literal_text_all_w_t_and_m_t":"resultsSSB-Indexes","paragraph_zero_based":25051},{"literal_text_all_w_t_and_m_t":"Beam level measurement results based on SS/PBCH related measurements.","paragraph_zero_based":25052},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Cell","paragraph_zero_based":25053},{"literal_text_all_w_t_and_m_t":"Cell level measurement results based on CSI-RS related measurements.","paragraph_zero_based":25054},{"literal_text_all_w_t_and_m_t":"resultsCSI-RS-Indexes","paragraph_zero_based":25055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["aa7ee72ea77c26d78cf58d15706f3cc076077b953296186f33937ea71738d838","1f60657ff3ac1aaf74f6405bae9bef