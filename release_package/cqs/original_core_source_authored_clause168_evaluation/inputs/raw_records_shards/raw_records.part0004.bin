{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–AppLayerMeasConfig","paragraph_zero_based":43248},{"literal_text_all_w_t_and_m_t":"The IE AppLayerMeasConfig indicates configuration of application layer measurements.","paragraph_zero_based":43249},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig information element","paragraph_zero_based":43250},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43251},{"literal_text_all_w_t_and_m_t":"-- TAG-APPLAYERMEASCONFIG-START","paragraph_zero_based":43252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43253},{"literal_text_all_w_t_and_m_t":"AppLayerMeasConfig-r17 ::=           SEQUENCE {","paragraph_zero_based":43254},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToAddModList-r17   SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayer-r17     OPTIONAL, -- Need N","paragraph_zero_based":43255},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerToReleaseList-r17  SEQUENCE (SIZE (1..maxNrofAppLayerMeas-r17)) OF MeasConfigAppLayerId-r17   OPTIONAL, -- Need N","paragraph_zero_based":43256},{"literal_text_all_w_t_and_m_t":"    rrc-SegAllowedSRB4-r17               ENUMERATED {enabled}                                                       OPTIONAL, -- Need R","paragraph_zero_based":43257},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":43258},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":43259},{"literal_text_all_w_t_and_m_t":"    rrc-SegAllowedSRB5-r18               ENUMERATED {enabled}                                                       OPTIONAL, -- Need R","paragraph_zero_based":43260},{"literal_text_all_w_t_and_m_t":"    idleInactiveReportAllowed-r18        ENUMERATED {enabled}                                                       OPTIONAL  -- Need R","paragraph_zero_based":43261},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":43262},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":43263},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43264},{"literal_text_all_w_t_and_m_t":"MeasConfigAppLayer-r17 ::=           SEQUENCE {","paragraph_zero_based":43265},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerId-r17             MeasConfigAppLayerId-r17,","paragraph_zero_based":43266},{"literal_text_all_w_t_and_m_t":"    measConfigAppLayerContainer-r17      OCTET STRING (SIZE (1..8000))                                              OPTIONAL, -- Need N","paragraph_zero_based":43267},{"literal_text_all_w_t_and_m_t":"    serviceType-r17                      ENUMERATED {streaming, mtsi, vr, spare5, spare4, spare3, spare2, spare1}   OPTIONAL, -- Need M","paragraph_zero_based":43268},{"literal_text_all_w_t_and_m_t":"    pauseReporting-r17                   BOOLEAN                                                                    OPTIONAL, -- Need M","paragraph_zero_based":43269},{"literal_text_all_w_t_and_m_t":"    transmissionOfSessionStartStop-r17   BOOLEAN                                                                    OPTIONAL, -- Need M","paragraph_zero_based":43270},{"literal_text_all_w_t_and_m_t":"    ran-VisibleParameters-r17            SetupRelease {RAN-VisibleParameters-r17}                         OPTIONAL, -- Cond ServiceType","paragraph_zero_based":43271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["15e7ce9bc50e70de624a13d9ccd1fb25d4f95946924b3ca601fb9d4ae2442298","b5638e5b80521d95cf5c703d612dc8cf705a75a47c448a010b9cc16780a66db4","643e4979e4dea4aa5fdd9e886721c45793542de2918e6833027c6f8d02827d89","350b1383e3e51b48a6e