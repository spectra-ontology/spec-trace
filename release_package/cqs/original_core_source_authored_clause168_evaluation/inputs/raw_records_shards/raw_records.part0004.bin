{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"List of periodic forwarding resources to be added or modified.","paragraph_zero_based":25968},{"literal_text_all_w_t_and_m_t":"periodicFwdRsrcToReleaseList","paragraph_zero_based":25969},{"literal_text_all_w_t_and_m_t":"List of periodic forwarding resources to be released.","paragraph_zero_based":25970},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":25971},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity and slot offset for the periodic forwarding resource. All the periodic forwarding resources configured within the same resource set should have the same periodicity. If the periodicity is expressed in [ms], the value range of slot offset is from 0 to Periodicity[ms] * referenceSCS[kHz]/15 -1.","paragraph_zero_based":25972},{"literal_text_all_w_t_and_m_t":"priorityFlag","paragraph_zero_based":25973},{"literal_text_all_w_t_and_m_t":"Indicates the priority for the list of periodic forwarding resources, as specified in TS 38.213 [13], clause 20.","paragraph_zero_based":25974},{"literal_text_all_w_t_and_m_t":"referenceSCS","paragraph_zero_based":25975},{"literal_text_all_w_t_and_m_t":"Indicates the reference subcarrier spacing for all the time resources in the list. Only values kHz15, kHz30, kHz60, kHz120 and kHz240 are applicable.","paragraph_zero_based":25976},{"literal_text_all_w_t_and_m_t":"symbolOffset","paragraph_zero_based":25977},{"literal_text_all_w_t_and_m_t":"Indicates the symbol offset in one slot.","paragraph_zero_based":25978},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25979},{"literal_text_all_w_t_and_m_t":"–NCR-PeriodicFwdResourceSetId","paragraph_zero_based":25980},{"literal_text_all_w_t_and_m_t":"The IE NCR-PeriodicFwdResourceSetId is used to identify one NCR-PeriodicFwdResourceSet.","paragraph_zero_based":25981},{"li