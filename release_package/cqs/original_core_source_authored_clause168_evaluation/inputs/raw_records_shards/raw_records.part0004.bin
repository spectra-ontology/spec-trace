{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":35568},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":35569},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":35570},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35571},{"literal_text_all_w_t_and_m_t":"SSB-MTC2 field descriptions","paragraph_zero_based":35572},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35573},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":35574},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35575},{"literal_text_all_w_t_and_m_t":"SSB-MTC3 field descriptions","paragraph_zero_based":35576},{"literal_text_all_w_t_and_m_t":"duration","paragraph_zero_based":35577},{"literal_text_all_w_t_and_m_t":"Duration of the measurement window in which to receive SS/PBCH blocks. It is given in number of subframes (see TS 38.213 [13], clause 4.1).","paragraph_zero_based":35578},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35579},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC, used for IAB-node discovery.","paragraph_zero_based":35580},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":35581},{"literal_text_all_w_t_and_m_t":"Periodicity and offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Periodicity and offset are given in number of subframes.","paragraph_zero_based":35582},{"literal_text_all_w_t_and_m_t":"ssb-ToMeasure","paragraph_zero_based":35583},{"literal_text_all_w_t_and_m_t":"The set of SS blocks to be measured within the SMTC measurement duration. The first/leftmost bit corresponds to SS block index 0, the second bit corresponds to SS block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS block is not to be measured while value 1 indicates that the corresponding SS block is to be measured (see TS 38.215 [9]). When the field is not configured the IAB-MT measures on all SS blocks. Regardless of the value of this field, SS blocks outside of the applicable smtc are not to be measured. See TS 38.215 [9] clause 5.1.1.","paragraph_zero_based":35584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35585},{"literal_text_all_w_t_and_m_t":"SSB-MTC4 field descriptions","paragraph_zero_based":35586},{"literal_text_all_w_t_and_m_t":"pci-List","paragraph_zero_based":35587},{"literal_text_all_w_t_and_m_t":"PCIs that follow this SMTC.","paragraph_zero_based":35588},{"literal_text_all_w_t_and_m_t":"offset","paragraph_zero_based":35589},{"literal_text_all_w_t_and_m_t":"Offset of the measurement window in which to receive SS/PBCH blocks, see 5.5.2.10. Offset is given in number of subframes.","paragraph_zero_based":35590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35591}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8c78eed390e60016ded7ee3fe02fa1d4e73622ad62836404b6b2e8184d32fc65","adf738721994938c5e3a449b3b480fcd33c7772988346f77eb57e2d7f0035e52","a66b2dd02d0fb144b66ecda90295a693aac48c6a13852dd13f000644d53ede50","3a9bbfef0476d919fda3caa12a07a6ebfa6c653058a5d9df5118658bbb85a96a","13fe82b0a0ef1088f5147aba90012c3baa9ae9ef75ef60c64b00fa60ad8e5220","cf416400