c02fa3f9cf8f44e0088d97042","46165a279ff31ff574ab5f8b127707ac02963d2e5525a3fc029b885c198ec870","3477df8c8acab236812d9ece0f2b0916b08bc95514f9883e59654c93e8c162a7","ed0536dbd2966943a486ec22e182bfb397503252317b7c01dd7a4a55ddfcc2c7","c0a9a12c6131b7e2765d3fc8816095fd0434f18421192abf24212be890edae25","e9d34e8523eaa9119532e2b0f9b43305de87352a464ecb96bf801b4dc2163a9e","be5bdc8d4997aac972e6a3bbba7320933aa7a5fd00bafcd142c89d45bd6f2cb9","6b952c7c90d59fa7b634044f661d092838a85d05951cd2a6d796f1bfb32801b7"],"paragraph_range_zero_based":[31560,31583],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p31560"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE is allowed to use autonomous gaps in acquiring system information from the E-UTRAN neighbour cell. When the field is included, the UE applies the corresponding value for T321.","paragraph_zero_based":31584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31585},{"literal_text_all_w_t_and_m_t":"EventTriggerConfigInterRAT field descriptions","paragraph_zero_based":31586},{"literal_text_all_w_t_and_m_t":"b2-Threshold1","paragraph_zero_based":31587},{"literal_text_all_w_t_and_m_t":"NR threshold to be used in inter RAT measurement report triggering condition for event B2.","paragraph_zero_based":31588},{"literal_text_all_w_t_and_m_t":"bN-ThresholdEUTRA","paragraph_zero_based":31589},{"literal_text_all_w_t_and_m_t":"E-UTRA threshold value associated with the selected trigger quantity (RSRP, RSRQ, SINR) to be used in inter RAT measurement report triggering condition for event number bN. In the same eventB2, the network configures the same CHOICE name (rsrp, rsrq or sinr) for the MeasTriggerQuantity of the b2-Threshold1 and for the MeasTriggerQuantityEUTRA of the b2-Threshold2EUTRA.","paragraph_zero_based":31590},{"literal_text_all_w_t_and_m_t":"eventId","paragraph_zero_based":31591},{"literal_text_all_w_t_and_m_t":"Choice of inter RAT event triggered reporting criteria.","paragraph_zero_based":31592},{"literal_text_all_w_t_and_m_t":"maxReportCells","paragraph_zero_based":31593},{"literal_text_all_w_t_and_m_t":"Max number of non-serving cells/candidate L2 U2N Relay UEs to include in the measurement report.","paragraph_zero_based":31594},{"literal_text_all_w_t_and_m_t":"reportAmount","paragraph_zero_based":31595},{"literal_text_all_w_t_and_m_t":"Number of measurement reports applicable for eventTriggered as well as for periodical report types","paragraph_zero_based":31596},{"literal_text_all_w_t_and_m_t":"reportOnLeave","paragraph_zero_based":31597},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the UE shall initiate the measurement reporting procedure when the leaving condition is met for a cell in cellsTriggeredList, as specified in 5.5.4.1.","paragraph_zero_based":31598},{"literal_text_all_w_t_and_m_t":"reportQuantity, reportQuantityUTRA-FDD","paragraph_zero_based":31599},{"literal_text_all_w_t_and_m_t":"The cell measurement quantities to be included in the measurement report. If the field eventB1-UTRA-FDD or eventB2-UTRA-FDD is present, the UE shall ignore the value(s) provided in reportQuantity.","paragraph_zero_based":31600},{"literal_text_all_w_t_and_m_t":"reportQuantityRelay","paragraph_zero_based":31601},{"literal_text_all_w_t_and_m_t":"The L2 U2N Relay UE measurement quantity to be included in measuremet report.","paragraph_zero_based":31602},{"literal_text_all_w_t_and_m_t":"timeToTrigger","paragraph_zero_based":31603},{"literal_text_all_w_t_and_m_t":"Time during which specific criteria for the event needs to be met in order to trigger a measurement report.","paragraph_zero_based":31604},{"literal_text_all_w_t_and_m_t":"bN-ThresholdUTRA-FDD","paragraph_zero_based":31605},{"literal_text_all_w_t_and_m_t":"UTRA-FDD threshold value associated with the selected trigger quantity (RSCP, EcN0) to be used in inter RAT measurement report triggering condition for event number bN.","paragraph_zero_based":31606},{"literal_text_all_w_t_and_m_t":"utra-FDD-RSCP corresponds to CPICH_RSCP in TS 25.133 [46] for FDD. utra-FDD-EcN0 corresponds to CPICH_Ec/No in TS 25.133 [46] for FDD.","paragraph_zero_based":31607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86e