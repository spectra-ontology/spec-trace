{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46440},{"literal_text_all_w_t_and_m_t":"SL-ReselectionConfig field descriptions","paragraph_zero_based":46441},{"literal_text_all_w_t_and_m_t":"sl-FilterCoefficientRSRP","paragraph_zero_based":46442},{"literal_text_all_w_t_and_m_t":"Specifies L3 filter coefficient for SL communication/ discovery RSRP measurement results from L1 filter.","paragraph_zero_based":46443},{"literal_text_all_w_t_and_m_t":"sl-RSRP-Thresh","paragraph_zero_based":46444},{"literal_text_all_w_t_and_m_t":"Indicates the threshold of SL communication/ discovery RSRP for a U2N remote UE to perform relay UE selection/ reselection.","paragraph_zero_based":46445},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46446},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46447},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46448},{"literal_text_all_w_t_and_m_t":"SL-RSRP-Thresh","paragraph_zero_based":46449},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if sl-RSRP-Thresh is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":46450},{"literal_text_all_w_t_and_m_t":"ThreshHighRemote","paragraph_zero_based":46451},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if threshHighRemote is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":46452},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46453},{"literal_text_all_w_t_and_m_t":"–SL-RemoteUE-ConfigU2U","paragraph_zero_based":46454},{"literal_text_all_w_t_and_m_t":"The IE SL-RemoteUE-ConfigU2U specifies the threshold configuration information for NR sidelink U2U Remote UE.","paragraph_zero_based":46455},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ConfigU2U information element","paragraph_zero_based":46456},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46457},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-REMOTEUE-CONFIGU2U-START","paragraph_zero_based":46458},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46459},{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ConfigU2U-r18::=           SEQUENCE {","paragraph_zero_based":46460},{"literal_text_all_w_t_and_m_t":"    sl-RSRP-ThreshU2U-r18                  SL-RSRP-Range-r16                                    OPTIONAL,     -- Need R","paragraph_zero_based":46461},{"literal_text_all_w_t_and_m_t":"    sl-FilterCoefficientU2U-r18            FilterCoefficient                                    OPTIONAL,     -- Need R","paragraph_zero_based":46462},{"literal_text_all_w_t_and_m_t":"    sl-HystMinU2U-r18                      Hysteresis                                           OPTIONAL,     -- Cond SL-RSRP-ThreshU2U","paragraph_zero_based":46463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["61c58b9fc56ba6b6e7bf6edc5168ae092ff1e07dd90cc02955702080ef784888","24240e98b05fb4e2471ae027fec39d3cf682f87bf9e4568569d06d68eb7ba803","9bb54e4f153a0e9f50612a2b123223b469e8fa8dc16a8785f1748cf1c718a3a2","9b707dbc55a099558eebb4d4ac982af70e58567235141da1249c9c17b2928d8a","ce8e3030db428e10ee315ad8176325312785590aa6d4d895b0012857f89a497e","117d58ffddef75df3bf6702ca8c7f42685e32dba4e5b5ad464179663c5864f18","d8de67a099bebf9028d79a050564bd9bbbcb7032ab0d666d74425fa65f8f5eb3","e2b39fd42b10a53ff5979d5cee411afd103f76d2a4185f0b2d89b6ac5fbdcfff","b601a262f400023170a8de6bc8b7051c8594f26c4dbdabaebadc28ee19f0f67e","0067bc6cb7213eda4ea03f84451d848bea6ce0de8e40bdc282cee836668f6de3","cdef3186d90b215b704620862cddbfe611c49c1cfc87eb84fddc29