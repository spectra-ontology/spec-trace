{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    pdsch-ConfigMulticast-r17                      PDSCH-Config                             OPTIONAL,    -- Need M","paragraph_zero_based":19872},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToAddModList-r17            SPS-ConfigMulticastToAddModList-r17      OPTIONAL,    -- Need N","paragraph_zero_based":19873},{"literal_text_all_w_t_and_m_t":"    sps-ConfigMulticastToReleaseList-r17           SPS-ConfigMulticastToReleaseList-r17     OPTIONAL     -- Need N","paragraph_zero_based":19874},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19876},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToAddModList-r17 ::=SEQUENCE (SIZE (1..8)) OF SPS-Config","paragraph_zero_based":19877},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19878},{"literal_text_all_w_t_and_m_t":"SPS-ConfigMulticastToReleaseList-r17 ::= SEQUENCE (SIZE (1..8)) OF SPS-ConfigIndex-r16","paragraph_zero_based":19879},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19880},{"literal_text_all_w_t_and_m_t":"-- TAG-CFR-CONFIGMULTICAST-STOP","paragraph_zero_based":19881},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19882},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19883},{"literal_text_all_w_t_and_m_t":"CFR-ConfigMulticast field descriptions","paragraph_zero_based":19884},{"literal_text_all_w_t_and_m_t":"locationAndBandwidthMulticast","paragraph_zero_based":19885},{"literal_text_all_w_t_and_m_t":"Frequency domain location and bandwidth for MBS multicast. The value of the field shall be interpreted as resource indicator value (RIV) as defined in TS 38.214 [19] with assumptions as described in TS 38.213 [13], clause 12, i.e. setting  N^size_BWP=275. The first PRB is a PRB determined by subcarrierSpacing of the associated BWP and offsetToCarrier corresponding to this subcarrier spacing. If not configured, the UE applies the value of locationAndBandwidth of the DL BWP in which the cfr-ConfigMulticast is configured.","paragraph_zero_based":19886},{"literal_text_all_w_t_and_m_t":"pdcch-ConfigMulticast","paragraph_zero_based":19887},{"literal_text_all_w_t_and_m_t":"UE specific group-common PDCCH configuration for MBS multicast for one CFR.","paragraph_zero_based":19888},{"literal_text_all_w_t_and_m_t":"pdsch-ConfigMulticast","paragraph_zero_based":19889},{"literal_text_all_w_t_and_m_t":"UE specific group-common PDSCH configuration for MBS multicast for one CFR.","paragraph_zero_based":19890},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToAddModList","paragraph_zero_based":19891},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations for MBS multicast.","paragraph_zero_based":19892},{"literal_text_all_w_t_and_m_t":"sps-ConfigMulticastToReleaseList","paragraph_zero_based":19893},{"literal_text_all_w_t_and_m_t":"Indicates a list of one or more DL SPS configurations to be released. The NW may release a SPS configuration at any time.","paragraph_zero_based":19894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19895}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ed8f865859e8c28dc84020cb0edeaeec07a1636dacb79e6f9987d2b7a293550a","33904b771b2df90911c8722e1f7f6564accfce17eacc05e73ffabe53b99c66fd","117159acf86968207baacfe3e636657a42b2fc21ec056a1c168fa54671f0287f","7467bd452fd7a369e9cd9b82f657b8a20c4f92fc7fd8d00fd83298e293b74ae2","50f53d52f89193b78b98df6178001dd2b5b58f630a9ffc9a37fd24ac48