{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"delayBudgetReportingProhibitTimer","paragraph_zero_based":43992},{"literal_text_all_w_t_and_m_t":"Prohibit timer for delay budget reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot4 means prohibit timer is set to 0.4 seconds, and so on.","paragraph_zero_based":43993},{"literal_text_all_w_t_and_m_t":"drx-PreferenceConfig","paragraph_zero_based":43994},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's DRX preferences for power saving.","paragraph_zero_based":43995},{"literal_text_all_w_t_and_m_t":"drx-PreferenceProhibitTimer","paragraph_zero_based":43996},{"literal_text_all_w_t_and_m_t":"Prohibit timer for DRX preferences assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":43997},{"literal_text_all_w_t_and_m_t":"idc-AssistanceConfig","paragraph_zero_based":43998},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected IDC problem.","paragraph_zero_based":43999},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfig","paragraph_zero_based":44000},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving.","paragraph_zero_based":44001},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceProhibitTimer","paragraph_zero_based":44002},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred bandwidth assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44003},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceConfig","paragraph_zero_based":44004},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of carriers for power saving.","paragraph_zero_based":44005},{"literal_text_all_w_t_and_m_t":"maxBW-PreferenceConfigFR2-2","paragraph_zero_based":44006},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred bandwidth for power saving for FR2-2.","paragraph_zero_based":44007},{"literal_text_all_w_t_and_m_t":"maxCC-PreferenceProhibitTimer","paragraph_zero_based":44008},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of carriers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44009},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfig","paragraph_zero_based":44010},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving.","paragraph_zero_based":44011},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceConfigFR2-2","paragraph_zero_based":44012},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred number of MIMO layers for power saving for FR2-2.","paragraph_zero_based":44013},{"literal_text_all_w_t_and_m_t":"maxMIMO-LayerPreferenceProhibitTimer","paragraph_zero_based":44014},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred number of number of MIMO layers assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44015}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bbadb10b637c5ff6f45fd707e4ef5dc91f3f4ba35ebb1c023fa16dd8c44a0284","4784fbf674b34b6f819cb8babe11b146a65b63da6c1ce23b4c2667f0f0128326","45e7d93008ed23722687b38321772913b33972dab1267fa4da2ac475836050c7","06e3ef39d65d3db94510b2f00e43dd5212d968f8ec2bed8b8bb0458d071a729c","7c8764c452767dbf81f8169897e7481c4c62be271c952990dffaf1a7bfe7c18d","0d87dbec48701eea7ce633675d43c6634b1cdee625f019a2592e2d6a280ea040","c2ef037c780af5a948ad2fbdd19267cde7120f49bc14eca906c334d6303ba16f","a309555d0a4c7793ab1a529e2379cc8f8a15a1839a74a092a48dac46ce11d4da","625a9b85de70ff064e06b740dff958cf64f0ca930109badaef73a9a7c23bbac9","e0464ca20c323a278c5fae03d4578940059c4f1ceb00bae6d9b67702ccaf4922","f69747139c7056ae8df2d52096749e385c5b88d4b0030cc299324bf3a3daa5dd","d7967005cabc6d1c4c756e08f43854ae383cb4a47186b2ec9270ed33935670ac","d9112fab877db976c87dfb32c745a50e85dec086bfaf8e160d3a9d658def99d7","845b731f6670ac2ce6c25ebad56bf2adddd156cbbe8efc760e1ab0585f9089e6","71c4616b16562bd2fa48e5e6c28cb3e0700ab9acc9562114189d77e78b7f97bd","1b7c847600819277f2156e09be2eb453de61a1bf34ed4d3a96802206ffcf627a","88eb8f3f97c8105fdfea89d7f007c961af631c710ffa964c1f186cf3d89df425","72dc1e00547da9761bad3012b77ea9f12b01fdcb37e925a36fdc4ce2d769e5cb","717c57d6836cd4ae7eb978e049c24988f34fea71d9821d772a98d2f84891e16d","e19a0f8a2629c95cbca44b1b6afb2496244d84fd335d2c5c2e46676d9e170429","e2eae68e6b61fc4c40b9a7d143925296ebac2a4701019f5e361a002d87c1a8d8","62e072d7c1d47d969f2ae3e7e7b213f6687997a