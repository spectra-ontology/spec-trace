{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sl-ResourcePoolID-r16            SL-ResourcePoolID-r16,","paragraph_zero_based":45864},{"literal_text_all_w_t_and_m_t":"    sl-ResourcePool-r16              SL-ResourcePool-r16                                                  OPTIONAL    -- Need M","paragraph_zero_based":45865},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45866},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45867},{"literal_text_all_w_t_and_m_t":"SL-ResourcePoolID-r16 ::=        INTEGER (1..maxNrofPoolID-r16)","paragraph_zero_based":45868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45869},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-POOLCONFIG-STOP","paragraph_zero_based":45870},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45871},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45872},{"literal_text_all_w_t_and_m_t":"SL-BWP-PoolConfig field descriptions","paragraph_zero_based":45873},{"literal_text_all_w_t_and_m_t":"sl-RxPool","paragraph_zero_based":45874},{"literal_text_all_w_t_and_m_t":"Indicates the receiving resource pool on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SL-ResourcePool entries is considered to be newly created.","paragraph_zero_based":45875},{"literal_text_all_w_t_and_m_t":"sl-TxPoolExceptional","paragraph_zero_based":45876},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission in exceptional conditions on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":45877},{"literal_text_all_w_t_and_m_t":"sl-TxPoolScheduling","paragraph_zero_based":45878},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission based on network scheduling on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":45879},{"literal_text_all_w_t_and_m_t":"sl-TxPoolSelectedNormal","paragraph_zero_based":45880},{"literal_text_all_w_t_and_m_t":"Indicates the resources by which the UE is allowed to perform NR sidelink transmission by UE autonomous resource selection on the configured BWP. For the PSFCH related configuration, if configured, will be used for PSFCH transmission/reception.","paragraph_zero_based":45881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45882},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":45883},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":45884},{"literal_text_all_w_t_and_m_t":"HO","paragraph_zero_based":45885},{"literal_text_all_w_t_and_m_t":"This field is optionally present, need M, in an RRCReconfiguration message including reconfigurationWithSync; otherwise it is absent, Need M.","paragraph_zero_based":45886},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7b1ba34ad5504726e582434bde534a12b4b2d5fded0e0d48feb5a47d5602cedd","6f8631db66c6beff76a3e9a499e637e5050717ddb155d74173a0a240da596b95","113c44d9698b32cbe59bbd408a5361c8d6c373820586a51afb3c64cde434677f","3f69942f926179e79aaa847ca98b6f421fe9c628ca18a2e7834f271d20a2044d","465a3deae5e7619d8f27e