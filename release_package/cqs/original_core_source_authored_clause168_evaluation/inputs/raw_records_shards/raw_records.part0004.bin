{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    sdt-LogicalChannelSR-DelayTimer-r18  ENUMERATED { sf20, sf40, sf64, sf128, sf512, sf1024, sf2560, spare1}  OPTIONAL, -- Cond MT-SDT1","paragraph_zero_based":14184},{"literal_text_all_w_t_and_m_t":"    t319a-r18                            ENUMERATED { ms100, ms200, ms300, ms400, ms600, ms1000, ms2000,","paragraph_zero_based":14185},{"literal_text_all_w_t_and_m_t":"                                                      ms3000, ms4000, spare7, spare6, spare5, spare4,","paragraph_zero_based":14186},{"literal_text_all_w_t_and_m_t":"                                                      spare3, spare2, spare1}                                  OPTIONAL  -- Cond MT-SDT2","paragraph_zero_based":14187},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":14188},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14189},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB1-STOP","paragraph_zero_based":14190},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":14191},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14192},{"literal_text_all_w_t_and_m_t":"SIB1 field descriptions","paragraph_zero_based":14193},{"literal_text_all_w_t_and_m_t":"cellBarred2RxXR","paragraph_zero_based":14194},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell is barred for 2Rx XR UEs. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated as specified in TS 38.101-1 [15]. If this field is absent on a cell operating in a frequency band where 4RX antenna ports are mandated, a 2RX XR UE shall treat the cell as not barred, as specified in TS 38.304 [20].","paragraph_zero_based":14195},{"literal_text_all_w_t_and_m_t":"cellBarredATG","paragraph_zero_based":14196},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to ATG, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to ATG. If not present, the UE considers the cell is not allowed for connectivity to ATG, as defined in TS 38.304 [20]. This field is only applicable to ATG-capable UEs.","paragraph_zero_based":14197},{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap1Rx","paragraph_zero_based":14198},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":14199},{"literal_text_all_w_t_and_m_t":"cellBarred-eRedCap2Rx","paragraph_zero_based":14200},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for an eRedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-eRedCap UEs.","paragraph_zero_based":14201},{"literal_text_all_w_t_and_m_t":"cellBarredFixedVSAT","paragraph_zero_based":14202},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for fixed VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for fixed VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":14203},{"literal_text_all_w_t_and_m_t":"cellBarredMobileVSAT","paragraph_zero_based":14204},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for mobile VSAT UEs, as defined in TS 38.304 [20]. If not present, the cell is not allowed for mobile VSAT UEs. This field is ignored by non-VSAT UEs.","paragraph_zero_based":14205},{"literal_text_all_w_t_and_m_t":"cellBarredNES","paragraph_zero_based":14206},{"literal_text_all_w_t_and_m_t":"This field indicates the cell barring status for UEs supporting nes-CellDTX-DRX as described in 5.2.2.4.2.","paragraph_zero_based":14207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["847e07c4a0e6e91bf705a15038a0bfef1be1efb19420fb3f9e58116b03e1d681","cdaec68231d67b50213921d48091883cf979f06f3e18a1e65024723ac407a521","9b378924df4e63edf9eb022221786a9304fd3c804068037eaea7d9a04cf513ca","474b63ab30b282d092e51d1dccbdc09f17634f0ec4315ddf055b474d6f9d7ca6","30cbfea1e0a71b496f37946da682fceee3bb990ab499c1180a4f316d5dac780e","518cdd3fcc6903450a8d53d5d5ef480ef60296f4f13e2dac762ee299c4dde279","19b237607e125a92ac89795e9fedff6cf5ed9cf4fbed66db9f7f8ab0dd009ad0","a0b113ec92b493a76019e92d5245a2912897e364cc5afacf45801d3afd955eb9","e9288d308a6e915503536828a738154e2173bf659c7e121bf75b63a51633a2a4","db83b85fe18ca39856231b1ec6bae67ea7f0150844b0bc1560c6a9221b882d48","70317e63a7247bc3bd3debc6dd6fb7bb96dca7fb719d0af43eb7c828e4387a8c","cff5691945e8977e0eeadaa1d6564dd05e47aeb43b884dc6f813ca6a89ad7ca1","c15ca1a114ee81a6a92c3575e568ec2d744586bc01f055a5f2e05f955a02ffe7","886a0cbeba539f9300e682c139be5dc0ce45bbb64d1e0da832c4fa3bc1889d75","7dfcac9689ae65616b12ac2068603e979661802542a537a6b6dbd5217d98cfed","6f66b71e28d68a581bfd0c49f921ed9303ac1cd4185a6ee6cb27b8c8435d6873","c12560763db61cfbbee72527f072ade168b435fe7db8f3e4f1bbdef080165a96","fd4213b88b4285da325f7bf9f757b497313be090e2ede6192754aa509b6980d5","d59529385099efe872c720b90abda2d761ed5ecc84c2ba19dcb56463521c202c","8f9fca32f61d1deb6cf4b33c8c97d52298a61c0669f77c4b46ef597718600463","1639abd494907b98926ee00201c1ceda88e3d136345d7d8b0146265250f91bb5","8c734092bfc94aa088409d292d3846373029718deb9e8fb853def9052e864dab","934544defe050461ba89da8eca65162e690818f498d0d02776bc894ac552c69f","6bc9fb23fbe547f0a05b9a06c809257e9f4f834b899298be6b71430dd0890a34"],"paragraph_range_zero_based":[14184,14207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cellBarredNTN","paragraph_zero_based":14208},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for connectivity to NTN, as defined in TS 38.304 [20]. Value notBarred means that the cell is allowed for connectivity to NTN. If not present, the UE considers the cell is not allowed for connectivity to NTN, as defined in TS 38.304 [20]. This field is only applicable to NTN-capable UEs.","paragraph_zero_based":14209},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap1Rx","paragraph_zero_based":14210},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 1 Rx branch, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":14211},{"literal_text_all_w_t_and_m_t":"cellBarredRedCap2Rx","paragraph_zero_based":14212},{"literal_text_all_w_t_and_m_t":"Value barred means that the cell is barred for a RedCap UE with 2 Rx branches, as defined in TS 38.304 [20]. This field is ignored by non-RedCap UEs.","paragraph_zero_based":14213},{"literal_text_all_w_t_and_m_t":"cellSelectionInfo","paragraph_zero_based":14214},{"literal_text_all_w_t_and_m_t":"Parameters for cell selection related to the serving cell.","paragraph_zero_based":14215},{"literal_text_all_w_t_and_m_t":"eCallOverIMS-Support","paragraph_zero_based":14216},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports eCall over IMS services as defined in TS 23.501 [32]. If absent, eCall over IMS is not supported by the network in the cell.","paragraph_zero_based":14217},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedIdle","paragraph_zero_based":14218},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that extended DRX for CN paging is allowed in the cell for UEs in RRC_IDLE or RRC_INACTIVE. The UE shall stop using extended DRX for CN paging in RRC_IDLE or RRC_INACTIVE if eDRX-AllowedIdle is not present.","paragraph_zero_based":14219},{"literal_text_all_w_t_and_m_t":"eDRX-AllowedInactive","paragraph_zero_based":14220},{"literal_text_all_w_t_and_m_t":"The presence of eDRX-AllowedInactive-r17 this field indicates that extended DRX cycle equal to or shorter than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle equal to or shorter than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r17 is not present. The presence of eDRX-AllowedInactive-r18 indicates that extended DRX cycle longer than 10.24 s for RAN paging is allowed in the cell for UEs in RRC_INACTIVE. The UE shall stop using extended DRX cycle longer than 10.24 s for RAN paging in RRC_INACTIVE if eDRX-AllowedInactive-r18 is not present.","paragraph_zero_based":14221},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":14222},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as (e)RedCap, Slicing, SDT, MSG1-Repetitions and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":14223},{"literal_text_all_w_t_and_m_t":"halfDuplexRedCap-Allowed","paragraph_zero_based":14224},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that the cell supports half-duplex FDD (e)RedCap UEs.","paragraph_zero_based":14225},{"literal_text_all_w_t_and_m_t":"hsdn-Cell","paragraph_zero_based":14226},{"literal_text_all_w_t_and_m_t":"This field indicates this is a HSDN cell as specified in TS 38.304 [20].","paragraph_zero_based":14227},{"literal_text_all_w_t_and_m_t":"hyperSFN","paragraph_zero_based":14228},{"literal_text_all_w_t_and_m_t":"Indicates hyper SFN which increments by one when the SFN wraps around. This field is excluded when determining changes in system information, i.e. changes of hyper SFN should not result in system information change notifications.","paragraph_zero_based":14229},{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsEUTRA","paragraph_zero_based":14230},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for EUTRA idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform EUTRA idle/inactive measurements.","paragraph_zero_based":14231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3dcbfe93ae2800286aa3eefc19a3cf30df386b3f9725be104a9442ceb1483311","70fa343eb9033f8a969b486e3a521eec75711fa4fa49acb4d7962ab3e7288ae0","73326b9eedf0683899f4b275a7fcd2f8d680636bcfc62fd2521ed8ae60fbe53c","5bc0082c7f86e07e683f15d1409f62ff5080e80108a9967cfe96efdc423d373f","34f8c356d9550e073ceaef36b059a5902d884f0a746b14ec81216cfd9531cb4b","deb3d75eccf285c43c5d9d36061196504bd62847ed7327dbea1a8d1dfdc7f0a0","df073ae99f0b1d7007593d158215ba7223ba479650b0f4b312c30a9130d20c0f","2170385bf8c05f5eb473db05d7f5665138e2f72702571492e2d996a6367c4642","3ea8acbd3fb8edad0a99f64b1743f6c10931c66203718f521fcaf5fa89f73ada","ac2107d7078ccfb73355d319bf706b29b47755e154fd2d42a03055465ba42da5","f5f37fce17648b34e60e3645e7be5a070c83e45f71f7610680e0a9830cb65fc1","ce01a3601146405b19c997d12657f083dfd155e190e24083d84b44d41e5dab88","2b844adba60612a9714e540fc7fa5b49cfbaf00609334b928f53bef8580e37be","bd3da57dd941e640baac8245e4cb0f8429ada314950c1301d96dc259c8ad3d64","27995d29dbf964337d9120e2da7dc2dc23a3c8a5f77710a9ce90066c183c8c5d","9a5268db135ebe644424a4c01d359aac98b408c9e058ea394b350f2a6013966e","d0eba0572b63d29ef841e180596a5246e82ae12aba325df933311f6fb235b7d7","ac86e760027fcd1c71a1caa22e9492846d05f0732a44eea7998cec40bce15f88","148fcd022dc501c6824737b9540a8a7d091d031e5fb90c14da2feea3e4845380","fc50cfd0c592e7dfcb5ceaca6ae040fb72775b9a63908dcc2b3ac2fd8b4c0def","0d5eab6f5ff9a6d7ad5e2a028fa7516491d3827bc96a76ade389456e4d6ed292","bce68eaaf763a3850555a94a9eb9de5aab42cb7a3b1ede802510dd2e2e6a2ed7","3095f40202faf2fece34dbbb1c8c1fd6a77e203a68fcdf772cd2acca17d399a9","1376888f98766db1d128f671c0cf07cf5c8f801db8fbb17a424cc85ef20e2abe"],"paragraph_range_zero_based":[14208,14231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"idleModeMeasurementsNR","paragraph_zero_based":14232},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR idle/inactive measurements shall perform the measurements while camping in this cell and report availability of these measurements when establishing or resuming a connection in this cell. If absent, a UE is not required to perform NR idle/inactive measurements.","paragraph_zero_based":14233},{"literal_text_all_w_t_and_m_t":"ims-EmergencySupport","paragraph_zero_based":14234},{"literal_text_all_w_t_and_m_t":"Indicates whether the cell supports IMS emergency bearer services for UEs in limited service mode. If absent, IMS emergency call is not supported by the network in the cell for UEs in limited service mode.","paragraph_zero_based":14235},{"literal_text_all_w_t_and_m_t":"intraFreqReselection2RxXR","paragraph_zero_based":14236},{"literal_text_all_w_t_and_m_t":"This field controls cell selection/reselection to intra-frequency cells for 2Rx XR UEs when this cell is barred or treated as barred by the 2Rx XR UE, as specified in TS 38.304 [20]. This field is ignored by all UEs that are not 2Rx XR UEs. This field may be configured only if the cell operates in a frequency band where 4Rx antenna ports are mandated, as specified in TS 38.101-1 [15].","paragraph_zero_based":14237},{"literal_text_all_w_t_and_m_t":"intraFreqReselection-eRedCap","paragraph_zero_based":14238},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for eRedCap UEs when this cell is barred, or treated as barred by the eRedCap UE, as specified in TS 38.304 [20]. If not present, an eRedCap UE treats the cell as barred, i.e., the UE considers that the cell does not support eRedCap.","paragraph_zero_based":14239},{"literal_text_all_w_t_and_m_t":"intraFreqReselectionRedCap","paragraph_zero_based":14240},{"literal_text_all_w_t_and_m_t":"Controls cell selection/reselection to intra-frequency cells for RedCap UEs when this cell is barred, or treated as barred by the RedCap UE, as specified in TS 38.304 [20]. If not present, a RedCap UE treats the cell as barred, i.e.,the UE considers that the cell does not support RedCap.","paragraph_zero_based":14241},{"literal_text_all_w_t_and_m_t":"mobileIAB-Cell","paragraph_zero_based":14242},{"literal_text_all_w_t_and_m_t":"The presence of this field indicates that this is a mobile IAB cell.","paragraph_zero_based":14243},{"literal_text_all_w_t_and_m_t":"mt-SDT-RSRP-Threshold","paragraph_zero_based":14244},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether MT-SDT procedure can be initiated, as specified in TS 38.321 [3]. If the field is absent, and the field sdt-RSRP-Threshold is present, the UE applies the value in the field sdt-RSRP-Threshold.","paragraph_zero_based":14245},{"literal_text_all_w_t_and_m_t":"musim-CapRestrictionAllowed","paragraph_zero_based":14246},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to send the musim-CapRestrictionInd in RRCSetupComplete and RRCResumeComplete messages.","paragraph_zero_based":14247},{"literal_text_all_w_t_and_m_t":"n3c-Support","paragraph_zero_based":14248},{"literal_text_all_w_t_and_m_t":"This field indicates the support of N3C MP. If the field is present, the UE can perform early detection of candidate N3C relay UEs. If absent, a UE is not required to perform early detection of candidate N3C relay UEs.","paragraph_zero_based":14249},{"literal_text_all_w_t_and_m_t":"ncr-Support","paragraph_zero_based":14250},{"literal_text_all_w_t_and_m_t":"This field combines both the support of NCR and the cell status for NCR. If the field is present, the cell supports NCR and the cell is also considered as a candidate for cell (re)selection for NCR-node; if the field is absent, the cell does not support NCR and/or the cell is barred for NCR-node.","paragraph_zero_based":14251},{"literal_text_all_w_t_and_m_t":"nonServingCellMII","paragraph_zero_based":14252},{"literal_text_all_w_t_and_m_t":"Indicates whether the MBSInterestIndication message for MBS broadcast reception on a non-serving cell is allowed to be transmitted to the serving gNB.","paragraph_zero_based":14253},{"literal_text_all_w_t_and_m_t":"q-QualMin","paragraph_zero_based":14254},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualmin\" in TS 38.304 [20], applicable for serving cell. If the field is absent, the UE applies the (default) value of negative infinity for Qqualmin.  ","paragraph_zero_based":14255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4047e3f6450d8d610742b95132c00d005e3b94af3b7758264499aff7c2dc0d5e","d8477e0bd8d7ecb6e5beb6f1ce450eb220b318b239622283d1386672f42f5fb5","59677be7acacf690ccb29647e42e73b6f96f485e430e6c411401f87fffd9fe4e","0788fc9985e067ecc1e3a1da0d61dc031e8d076da958ca84483741b9b36a7c04","187cf4fba9bc8f2d3c5538c0fead4bebceb1cedca46e184f76f3b10d1daeda7e","6a5f0ec58a66c49a560754481e4052a87d359fdf2cbb973ec15199971e5e2e6e","1015fbb3e5d9be9bc5f52c8b776797bfc0f634c8b5b41a1cf4f3780dea1cc1e9","215a8546e431173c4fd8510e457ba8739e4f82e4cd9b845ab83f2ce73b391c39","d1f3ac81c5cb6ba8fd5a34d829c77514f02ea654f1f53bc62e46a3e5f7af4705","4d89faadd3dc4a521e31cc5d92d8d38d42ef6f99df9937a1cf516222190a62af","1e626f47bb8265902a9ac08ab252bd10b255ff5cdd5914480fd391beeecd72d9","c060d6e4cb36ea429785921f03c61d1a9003cd97f296d557597e4303d1dabfa2","a9859c1b3c9a42c62d877a9a715e3e725372b07f44e93ce620ddb4223507ed37","679b611699b871998279732dbf488826ea7ac8bd73e866a8173ac43191f10f81","69573b62cbee9ccd62180f8dae155667f7367150cc5b1bd713a99aab6b70d6ae","0b9f547af4a62507d8acdd7a78f4119a8fed64821c2ec1082809c5b03a9c1176","e23544493b6d39b903da9a8a17de9697c06507ddb8fc00846a7de2ed2cb71db1","3db62b9ef10453241569038c0b1c1c92d5248792c49e685650a1f5f9374016cf","df1096255c66f3ddd34ff74017d58e9e73fe50877aa880296f73ea653277b403","c652b3b8301e827b644ea6e47c2ed2f8f98c36176640c73fe9ef45c194629223","7598dd368db8ba836b6b04ea3fb942d013b2c628b67fc49ccfe88714ee3d42c2","60f26e9607901b53d4a018ccda2aaac37ced9c79d5c223b187b67556e469e022","76ef51633ad9cb3be5287794d974d4ada7ecf0e6364c1f34e854237a61adf4e4","d98d47d28f5f2459a1899b15c48799fd57243f1d02e25d7b6f9ff4758c48998e"],"paragraph_range_zero_based":[14232,14255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"q-QualMinOffset","paragraph_zero_based":14256},{"literal_text_all_w_t_and_m_t":"Parameter \"Qqualminoffset\" in TS 38.304 [20]. Actual value Qqualminoffset = field value [dB]. If the field is absent, the UE applies the (default) value of 0 dB for Qqualminoffset. Affects the minimum required quality level in the cell.","paragraph_zero_based":14257},{"literal_text_all_w_t_and_m_t":"q-RxLevMin","paragraph_zero_based":14258},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":14259},{"literal_text_all_w_t_and_m_t":"q-RxLevMinOffset","paragraph_zero_based":14260},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevminoffset\" in TS 38.304 [20]. Actual value Qrxlevminoffset = field value * 2 [dB]. If absent, the UE applies the (default) value of 0 dB for Qrxlevminoffset. Affects the minimum required Rx level in the cell.","paragraph_zero_based":14261},{"literal_text_all_w_t_and_m_t":"q-RxLevMinSUL","paragraph_zero_based":14262},{"literal_text_all_w_t_and_m_t":"Parameter \"Qrxlevmin\" in TS 38.304 [20], applicable for serving cell.","paragraph_zero_based":14263},{"literal_text_all_w_t_and_m_t":"reselectionMeasurementsNR","paragraph_zero_based":14264},{"literal_text_all_w_t_and_m_t":"This field indicates that a UE that is configured for NR reselection measurements shall report availability of these measurements when establishing or resuming a connection in this cell.","paragraph_zero_based":14265},{"literal_text_all_w_t_and_m_t":"sdt-BeamFailureRecoveryProhibitTimer","paragraph_zero_based":14266},{"literal_text_all_w_t_and_m_t":"The value of the prohibit timer used for RACH for beam failure indication during SDT as specified in TS 38.321 [3]. Value ms50 corresponds to 50 milliseconds, value ms100 corresponds to 100 milliseconds and so on.","paragraph_zero_based":14267},{"literal_text_all_w_t_and_m_t":"sdt-DataVolumeThreshold","paragraph_zero_based":14268},{"literal_text_all_w_t_and_m_t":"Data volume threshold used to determine whether SDT can be initiated, as specified in TS 38.321 [3]. Value byte32 corresponds to 32 bytes, value byte100 corresponds to 100 bytes, and so on.","paragraph_zero_based":14269},{"literal_text_all_w_t_and_m_t":"sdt-LogicalChannelSR-DelayTimer","paragraph_zero_based":14270},{"literal_text_all_w_t_and_m_t":"The value of logicalChannelSR-DelayTimer applied during SDT for logical channels configured with SDT, as specified in TS 38.321 [3]. Value in number of subframes. Value sf20 corresponds to 20 subframes, sf40 corresponds to 40 subframes, and so on. If sdt-LogicalChannelSR-DelayTimer-r18 is absent and sdt-LogicalChannelSR-DelayTimer-r17 is present then, the UE applies the value configured in sdt-LogicalChannelSR-DelayTimer-r17 for this field. If this field is not configured, then logicalChannelSR-DelayTimer is not applied for SDT logical channels.","paragraph_zero_based":14271},{"literal_text_all_w_t_and_m_t":"sdt-RSRP-Threshold","paragraph_zero_based":14272},{"literal_text_all_w_t_and_m_t":"RSRP threshold used to determine whether SDT procedure can be initiated, as specified in TS 38.321 [3].","paragraph_zero_based":14273},{"literal_text_all_w_t_and_m_t":"servingCellConfigCommon","paragraph_zero_based":14274},{"literal_text_all_w_t_and_m_t":"Configuration of the serving cell.","paragraph_zero_based":14275},{"literal_text_all_w_t_and_m_t":"t319a","paragraph_zero_based":14276},{"literal_text_all_w_t_and_m_t":"Initial value of the timer T319a used for detection of SDT failure. Value ms100 corresponds to 100 milliseconds, value ms200 corresponds to 200 milliseconds and so on. If t319a-r18 is absent, the UE applies the value configured in t319a-r17.","paragraph_zero_based":14277},{"literal_text_all_w_t_and_m_t":"uac-AccessCategory1-SelectionAssistanceInfo","paragraph_zero_based":14278},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. If plmnCommon is chosen, the UAC-AccessCategory1-SelectionAssistanceInfo is applicable to all the PLMNs and SNPNs in plmn-IdentityInfoList and npn-IdentityInfoList. If individualPLMNList is chosen, the 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. If uac-AC1-SelectAssistInfo-r16 is present, the UE shall ignore the uac-AccessCategory1-SelectionAssistanceInfo.","paragraph_zero_based":14279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bb0998b66e16306bfb14a628f94312e9f3f49f21a1c7c6894a8de49b34dc0668","a9da2cb1b4de5ea5feed1beb64bba7a327fe277e7576cfe74b77c7aba846a5a9","7a92e4c8e34da237baa52a54dc578bf07251991e71e84fc9d42a0105b098a5b6","75c7351f52d1329b23d9ddc4bd08706a4e5910a4abc2e414706a1c8268aeccdc","76d8cc16f8cc55ec67a53ffaaa431395be0d7924c9ba344e2765214e4f0782a6","f400038c129bfaa2cdd4b440797e5078d050c9477456639083768b1ea4211cb7","1a950d483969729a3b1a2c37f9d93ae0483d37e8483b63be9737b357223cd960","c88191f6357fee387513aef86c9154b085e3650c4295ffe0c32e3895ec935262","9482fc303f342f803c66d5f15e2f21ec9fcdc846e1d7ed4beb56ae2ac699ac8b","2600e04cfefa6ddf0e340fc85e3b30aa9bb37ede0b08ca5134422567ce2214d6","b950f5bcb78ae962dde0f656b8ec08347dd871c5d5effc92ef1ae92a3620ebd2","671c47bce9a7decec57ae6a5014f250b9be37c12886888a70cf433bdf4f379a9","3984ad6bc787322a0dac8ab355cac0bf0853f7ffc4c632ddc6a8cbb212a38753","22319d724af0e5ec339ca899054775877ffa1b6c02f8ff8eea15ba17b874e049","540b5b80110f329cd28d0acd79a25eee4279b699470419e5fd9197ee303bb600","bb43906661c2fe095012f78dbf8be2b2068906e147bf06dc3fc18103c81d927a","b7ae34c79b2aa60d150a673772bbdc47239bf7e7874a3edcb735ca897f1bebb6","7f43584b272a21bb82a3a4be3ce3fa268ecf2cff5675fdd09f9058ab1bbb74a0","f2181730f3251b4ded290217a2f83b44dc24fa80025336fb29dc75872162aa59","c9cd3cdbe7576f7bf290a6374fea2f1889fa3168fa56d58a0412fef9ea5b227f","818ba924a059afe1cba9c4c715bad516e1bce2b566065f32a5f3fca0cfc2c274","094e984f1eb37daeb7f283bb8c8773ec1d0032953fded0cb835c62af35092319","0a0e292f2e61b4154d1c1f0f0b63706fb1715f07d7d3431eee82b912d70b0a69","850ac51a37ed103ba3911f8571cc1b28ee996bb1c4898064c1839fc2baa8d04a"],"paragraph_range_zero_based":[14256,14279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p14256"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"uac-AC1-SelectAssistInfo","paragraph_zero_based":14280},{"literal_text_all_w_t_and_m_t":"Information used to determine whether Access Category 1 applies to the UE, as defined in TS 22.261 [25]. The 1st entry in the list corresponds to the first network within all of the PLMNs and SNPNs across the plmn-IdentityList and npn-IdentityInfoList, the 2nd entry in the list corresponds to the second network within all of the PLMNs and SNPNs across the plmn-IdentityList and the npn-IdentityInfoList and so on. Value notConfigured indicates that Access Category1 is not configured for the corresponding PLMN/SNPN.","paragraph_zero_based":14281},{"literal_text_all_w_t_and_m_t":"uac-BarringForCommon","paragraph_zero_based":14282},{"literal_text_all_w_t_and_m_t":"Common access control parameters for each access category. Common values are used for all PLMNs/SNPNs, unless overwritten by the PLMN/SNPN specific configuration provided in uac-BarringPerPLMN-List. The parameters are specified by providing an index to the set of configurations (uac-BarringInfoSetList). UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":14283},{"literal_text_all_w_t_and_m_t":"ue-TimersAndConstants","paragraph_zero_based":14284},{"literal_text_all_w_t_and_m_t":"Timer and constant values to be used by the UE. The cell operating as PCell always provides this field.","paragraph_zero_based":14285},{"literal_text_all_w_t_and_m_t":"useFullResumeID","paragraph_zero_based":14286},{"literal_text_all_w_t_and_m_t":"Indicates which resume identifier and Resume request message should be used. UE uses fullI-RNTI and RRCResumeRequest1 if the field is present, or shortI-RNTI and RRCResumeRequest if the field is absent.","paragraph_zero_based":14287},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14288},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":14289},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":14290},{"literal_text_all_w_t_and_m_t":"EDRX-RC","paragraph_zero_based":14291},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that enables eDRX-AllowedIdle, otherwise it is absent.","paragraph_zero_based":14292},{"literal_text_all_w_t_and_m_t":"MINT","paragraph_zero_based":14293},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in a cell that provides a configuration for disaster roaming, otherwise it is absent, Need R.","paragraph_zero_based":14294},{"literal_text_all_w_t_and_m_t":"MT-SDT1","paragraph_zero_based":14295},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":14296},{"literal_text_all_w_t_and_m_t":"MT-SDT2","paragraph_zero_based":14297},{"literal_text_all_w_t_and_m_t":"This field is mandatory present in a cell that supports MT-SDT if sdt-ConfigCommon-r17 is not present, otherwise it is absent.","paragraph_zero_based":14298},{"literal_text_all_w_t_and_m_t":"NTN","paragraph_zero_based":14299},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need S, in a cell where cellBarredNTN is included with value notBarred, otherwise it is absent.","paragraph_zero_based":14300},{"literal_text_all_w_t_and_m_t":"Standalone","paragraph_zero_based":14301},{"literal_text_all_w_t_and_m_t":"The field is mandatory present in a cell that supports standalone operation, otherwise it is absent.","paragraph_zero_based":14302},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":14303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9