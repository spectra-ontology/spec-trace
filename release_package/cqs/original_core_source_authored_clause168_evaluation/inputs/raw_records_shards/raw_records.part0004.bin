{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28800},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-START","paragraph_zero_based":28801},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28802},{"literal_text_all_w_t_and_m_t":"PLMN-IdentityList2-r16 ::= SEQUENCE (SIZE (1..16)) OF PLMN-Identity","paragraph_zero_based":28803},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28804},{"literal_text_all_w_t_and_m_t":"-- TAG-PLMNIDENTITYLIST2-STOP","paragraph_zero_based":28805},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28806},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28807},{"literal_text_all_w_t_and_m_t":"–PRB-Id","paragraph_zero_based":28808},{"literal_text_all_w_t_and_m_t":"The IE PRB-Id identifies a Physical Resource Block (PRB) position within a carrier.","paragraph_zero_based":28809},{"literal_text_all_w_t_and_m_t":"PRB-Id information element","paragraph_zero_based":28810},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28811},{"literal_text_all_w_t_and_m_t":"-- TAG-PRB-ID-START","paragraph_zero_based":28812},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28813},{"literal_text_all_w_t_and_m_t":"PRB-Id ::=                          INTEGER (0..maxNrofPhysicalResourceBlocks-1)","paragraph_zero_based":28814},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28815},{"literal_text_all_w_t_and_m_t":"-- TAG-PRB-ID-STOP","paragraph_zero_based":28816},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28817},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28818},{"literal_text_all_w_t_and_m_t":"–PTRS-DownlinkConfig","paragraph_zero_based":28819},{"literal_text_all_w_t_and_m_t":"The IE PTRS-DownlinkConfig is used to configure downlink phase tracking reference signals (PTRS) (see TS 38.214 [19] clause 5.1.6.3)","paragraph_zero_based":28820},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig information element","paragraph_zero_based":28821},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28822},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-START","paragraph_zero_based":28823}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["1f2984b1b9e0efa733460ee849482bd53fb50795d28bf03661ceaf50003a9a5f","9bc8c83324cacefbc6fe220d837ef84eb78fbc121481142d03c02302eed87091","2b2d81b14c5895783a994db7f2ccfe769e61d6f743204f9619fccd470a6d33e9","9f62479aaf94551c0cca7deab616019681307c9a574168f120ce6f1ddc099996","8929074eae2044203a142500d92d52e77f2f0f2fe891858f84550c8b5f3a9f0f","2797294a5fc2f76d25bdcb4ae0f0eb1967cdf92ff17b0e9deec11aa7db941cb8","99805d9dbdde252a4fd03343502e0add5b75bcf3e8eeb37ef0810174fa55eaa0","9ec769374165548888246a652da66b4aef673de454a3b98ac0fb6094cbbb14b5","a503bc8efd6849e434ce42af6bf29b8e8b3a08c1d5cf3ddc93764141f2187f7d","9b9a1e1ea6eab75e7fae70c9fead1199c43573553720edbde0c227a188221f5b","9e7ba90f8cb4b7f2ab655ad2239c78ea2e97160e9469e53a0095bcb8b81c7a89","f66e2e95f440b569593b5d1d6bcdea3ceb5a48fb4e3b0508cecdbb5a34ac244a","f103a290b9c0165cd9783ea9eeba7b096095fa7610d78b5d0d2224ea04934d40","bb98a1181348a444cf46aae3736fbc85c4c475cae9419886d6803ac38b75747f","be7bd01c3a0f3cc1cab73926d10042e637b85632632ff5890d329c626aa3ec6a","297cd7be29153aa79840c258fe927620d418ed127600b8e592e3cfe78b2192de","03080dbf4e68291c73f157148181d000d3dfe4984afa941811fa460cf9834e51","5a66e92a3efa09c0f0c032316ef23b0104e49a2db8d804d1c07622580b6f6242","479957beecff993d5cd42c214273807533e880c8a7c7686ddd6ba8c3b3c0eeaa","c9aa598a3650c91a234918d0d47e0f2aac878b4104521b457ffeeed1b891e8c6","23f79235f360ab806e108b585e84472e6caaadb4959e2f6ecb12cf2439d3f0f7","02cd1acdc4e551666680b250e488c00210293369ce84e60d0fbe4ace217739a8","4e32791e0bef2d009746441f89990c7dece85cb4c9d4bd40ee997068dc433119","2c01b7ffa90612e7a9c481b0b770ba340d1a0032d69a91f94f6a69411acbcb3e"],"paragraph_range_zero_based":[28800,28823],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28800"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28824},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig ::=             SEQUENCE {","paragraph_zero_based":28825},{"literal_text_all_w_t_and_m_t":"    frequencyDensity                    SEQUENCE (SIZE (2)) OF INTEGER (1..276)                                 OPTIONAL,   -- Need S","paragraph_zero_based":28826},{"literal_text_all_w_t_and_m_t":"    timeDensity                         SEQUENCE (SIZE (3)) OF INTEGER (0..29)                                  OPTIONAL,   -- Need S","paragraph_zero_based":28827},{"literal_text_all_w_t_and_m_t":"    epre-Ratio                          INTEGER (0..3)                                                          OPTIONAL,   -- Need S","paragraph_zero_based":28828},{"literal_text_all_w_t_and_m_t":"    resourceElementOffset               ENUMERATED { offset01, offset10, offset11 }                             OPTIONAL,   -- Need S","paragraph_zero_based":28829},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28830},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":28831},{"literal_text_all_w_t_and_m_t":"    maxNrofPorts-r16                    ENUMERATED {n1, n2}                                                     OPTIONAL    -- Need R","paragraph_zero_based":28832},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":28833},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28834},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":28835},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28836},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-DOWNLINKCONFIG-STOP","paragraph_zero_based":28837},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":28838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28839},{"literal_text_all_w_t_and_m_t":"PTRS-DownlinkConfig field descriptions","paragraph_zero_based":28840},{"literal_text_all_w_t_and_m_t":"epre-Ratio","paragraph_zero_based":28841},{"literal_text_all_w_t_and_m_t":"EPRE ratio between PTRS and PDSCH. Value 0 corresponds to the codepoint \"00\" in table 4.1-2. Value 1 corresponds to codepoint \"01\", and so on. If the field is not provided, the UE applies value 0 (see TS 38.214 [19], clause 4.1).","paragraph_zero_based":28842},{"literal_text_all_w_t_and_m_t":"frequencyDensity","paragraph_zero_based":28843},{"literal_text_all_w_t_and_m_t":"Presence and frequency density of DL PT-RS as a function of Scheduled BW. If the field is absent, the UE uses K_PT-RS = 2 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-2).","paragraph_zero_based":28844},{"literal_text_all_w_t_and_m_t":"maxNrofPorts","paragraph_zero_based":28845},{"literal_text_all_w_t_and_m_t":"The maximum number of DL PTRS ports specified in TS 38.214 [19] (clause 5.1.6.3). 2 PT-RS ports can only be configured for a DL BWP that is configured, as specified in TS 38.214 [19] clause 5.1, with a mode where a single PDSCH has association between the DM-RS ports and the TCI states as defined in TS 38.214 [19] clause 5.1.6.2.","paragraph_zero_based":28846},{"literal_text_all_w_t_and_m_t":"resourceElementOffset","paragraph_zero_based":28847}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["6196f0888f7269dcdb383a9d2a594983deba2b2c59af7f5a2d11db78f95a2bba","629a9d4b82027e8d1418fa67d52f29885083ebb7030df32ad7dc1f438e50e804","2619d2422a81d47786e9faa43a0eb19297f3d2f53b9cc69a52d64d959187b147","8dfbe9b31d52c3145cfa4002e75a2313a8462b6bd1fecc06871cf2589be0428c","4c5906fb02e0fac3d2b9cf29ac0c9a4dfb2b7c6b40fe47b3c906113dde43a002","dddbf9fc5d27fd548d1bdbdf64d1115db45efcd1579c6691a6ccee75fa0be989","ca2dd7d3fe3a52d7d5b517ce511814543294ac0df3fe1097d93f4390c9bfb86f","402633d5c3b19d8ad2a7e45203e04343d158d2f01facd9e715a8060b909abb6d","33980d923012b09c11332285df1f50a75c09cabc08fc1a3befb4bb50d58b29eb","7a86f2c5ca2d4a3e7700bf9b97039823d2a770d0e84e727a7eeba511ab756d24","8cda1676b1cf7ac201bc738f128bc0a8f86f8ca7aa2683aad6d3546ed5344690","3a208b140e67b5f70fa9ccfb6c42ecfca682d3827baa77739305022fd9eafb07","ec3d295430b24a9d73cdfc410ef5cc13d484b56da81e4ccf62236213d573bc53","6051a0b9816c494133fed9a4d6cb438054b4fbb054937a7f4ccc2b9481f53936","4432309404d9d3a844b8cef4667932f3cbea25a939f8488d61edab6bed197346","e0067d1abdb217226bec1a48380c17c39a36311e1d28de38f8ee32d0c4e5e97f","be7bf83160eb29cffed6aeb6b20d5057c8ed0b2806231d55092fc07064b408c1","24da75380ebb2417ddf8f9bf2a55b3e02cffa7ed7d422aa3cc707e57a06ea1b8","4a8ccea27bad357f4da11251bcb7066f9b190947a884e220e37acf50bc4fd38e","9cc5c977393c428d98dcc21b85bb5162c93efa3a31ef8b7795345af8438e5ee5","4268b44d52f585b897122627b3a39649abf62e5c2b0ff0972ba1597053099c69","23a701b90b533767958406cea1d0d00d1b23cde132b103c9ff54666226cc5674","2d0650f4b01510681dab83804816270c024312f6c393bd579af2e00d02e59176","1e835e80c05ae499e07e1fe37e25e5bab14b2fd991c09e97071aa0b27ed5c9b8"],"paragraph_range_zero_based":[28824,28847],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p28824"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the subcarrier offset for DL PTRS. If the field is absent, the UE applies the value offset00 (see TS 38.211 [16], clause 7.4.1.2.2).","paragraph_zero_based":28848},{"literal_text_all_w_t_and_m_t":"timeDensity","paragraph_zero_based":28849},{"literal_text_all_w_t_and_m_t":"Presence and time density of DL PT-RS as a function of MCS. The value 29 is only applicable for MCS Table 5.1.3.1-1 (TS 38.214 [19]). If the field is absent, the UE uses L_PT-RS = 1 (see TS 38.214 [19], clause 5.1.6.3, table 5.1.6.3-1).","paragraph_zero_based":28850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28851},{"literal_text_all_w_t_and_m_t":"–PTRS-UplinkConfig","paragraph_zero_based":28852},{"literal_text_all_w_t_and_m_t":"The IE PTRS-UplinkConfig is used to configure uplink Phase-Tracking-Reference-Signals (PTRS).","paragraph_zero_based":28853},{"literal_text_all_w_t_and_m_t":"PTRS-UplinkConfig information element","paragraph_zero_based":28854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":28855},{"literal_text_all_w_t_and_m_t":"-- TAG-PTRS-UPLINKCONFIG-START","paragraph_zero_based":28856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":28857},{"literal_text_all_w_t_and_m_t":"PTRS-UplinkConfig ::=                   SEQUENCE {","paragraph_zero_based":28858},{"literal_text_all_w_t_and_m_t":"    transformPrecoderDisabled               SEQUENCE {","paragraph_zero_based":28859},{"literal_text_all_w_t_and_m_t":"        frequencyDensity                    SEQUENCE (SIZE (2)) OF INTEGER (1..276)                 OPTIONAL,   -- Need S","paragraph_zero_based":28860},{"literal_text_all_w_t_and_m_t":"        timeDensity                         SEQUENCE (SIZE (3)) OF INTEGER (0..29)                  OPTIONAL,   -- Need S","paragraph_zero_based":28861},{"literal_text_all_w_t_and_m_t":"        maxNrofPorts                        ENUMERATED {n1, n2},","paragraph_zero_based":28862},{"literal_text_all_w_t_and_m_t":"        resourceElementOffset               ENUMERATED {offset01, offset10, offset11 }              OPTIONAL,   -- Need S","paragraph_zero_based":28863},{"literal_text_all_w_t_and_m_t":"        ptrs-Power                          ENUMERATED {p00, p01, p10, p11}","paragraph_zero_based":28864},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":28865},{"literal_text_all_w_t_and_m_t":"    transformPrecoderEnabled                SEQUENCE {","paragraph_zero_based":28866},{"literal_text_all_w_t_and_m_t":"        sampleDensity                           SEQUENCE (SIZE (5)) OF INTEGER (1..276),","paragraph_zero_based":28867},{"literal_text_all_w_t_and_m_t":"        timeDensityTransformPrecoding           ENUMERATED {d2}                                     OPTIONAL    -- Need S","paragraph_zero_based":28868},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL,   -- Need R","paragraph_zero_based":28869},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":28870},{"literal_text_all_w_t_and_m_t":"   [[","paragraph_zero_based":28871}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bcee0c44eb706af09c0798a0cccb5ad924adcf2db32449546baacad6d850b5bf","348d3193754fd0ead9439fe4b19dbd58f3b647e288083a9691daafb2149b53e9","ef6b73408382daa5bfbc0cd59073201a3066e84b91aa3452741f46ff00e5fd42","22adaa4