ZE(1..maxRA-SSB-Resources)) OF CFRA-SSB-Resource,","paragraph_zero_based":30613},{"literal_text_all_w_t_and_m_t":"        ra-ssb-OccasionMaskIndex                INTEGER (0..15)","paragraph_zero_based":30614},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":30615},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30616},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30617},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30618},{"literal_text_all_w_t_and_m_t":"CFRA-SSB-Resource ::=           SEQUENCE {","paragraph_zero_based":30619},{"literal_text_all_w_t_and_m_t":"    ssb                             SSB-Index,","paragraph_zero_based":30620},{"literal_text_all_w_t_and_m_t":"    ra-PreambleIndex                INTEGER (0..63),","paragraph_zero_based":30621},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":30622},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["62f7f2bcae26765f612a209be8d930f682fbd3de084a70dd0e68fb234c66bf1f","5fb17953f9bf04b30ec64c991fac86f5f9ad62a56ea9c6ad8924a7c284ffc40a","ee22a498f0904a94b0f4928bc3630fd4121bea090cf3f787c2ee5fde6a58b5f8","b8d1b0aaa1caa4e1ba86a7f3608fd55cadbbb71fc41419e77f15e9507029aed5","8a4a947208fb283cef273ce5918290a2ae6848a8aec94d9e2aa26602f7a00bc7","b18833675e6f5c5484eb011409a47d70476c862af5291b8a1fbf59f91956afea","d51daa1e30612324f18866e8325bc6ea25d2c7677ae9bce5cbdd90971f8f62a0","6434c61e26d239c50750e55e568d7ec315ce04e3ecaa758748a8ed3387b8ca1e","95b849698d31eebc7c15c602ae2684032dc68ee8115a1ffa0c939897cd4a176a","a52d016a8e45481cc24d25caf5ee05acefe6d521782ba403cac73754c2bc79c8","aa1030bbd274af