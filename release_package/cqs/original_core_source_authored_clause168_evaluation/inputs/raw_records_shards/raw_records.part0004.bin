{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For L2 U2N Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":44880},{"literal_text_all_w_t_and_m_t":"L2U2N","paragraph_zero_based":44881},{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2N Relay UE and L2 U2N Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":44882},{"literal_text_all_w_t_and_m_t":"L2U2U","paragraph_zero_based":44883},{"literal_text_all_w_t_and_m_t":"The field is optional present for L2 U2U Relay UE and L2 U2U Remote UE, need N. Otherwise, it is absent.","paragraph_zero_based":44884},{"literal_text_all_w_t_and_m_t":"U2URelayUE","paragraph_zero_based":44885},{"literal_text_all_w_t_and_m_t":"For U2U Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":44886},{"literal_text_all_w_t_and_m_t":"U2URemoteUE","paragraph_zero_based":44887},{"literal_text_all_w_t_and_m_t":"For U2U Remote UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":44888},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44889},{"literal_text_all_w_t_and_m_t":"–SL-ConfiguredGrantConfig","paragraph_zero_based":44890},{"literal_text_all_w_t_and_m_t":"The IE SL-ConfiguredGrantConfig specifies the configured grant configuration information for NR sidelink communication.","paragraph_zero_based":44891},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig information element","paragraph_zero_based":44892},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":44893},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-CONFIGUREDGRANTCONFIG-START","paragraph_zero_based":44894},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44895},{"literal_text_all_w_t_and_m_t":"SL-ConfiguredGrantConfig-r16 ::=           SEQUENCE {","paragraph_zero_based":44896},{"literal_text_all_w_t_and_m_t":"    sl-ConfigIndexCG-r16                       SL-ConfigIndexCG-r16,","paragraph_zero_based":44897},{"literal_text_all_w_t_and_m_t":"    sl-PeriodCG-r16                            SL-PeriodCG-r16                                                       OPTIONAL, -- Need M","paragraph_zero_based":44898},{"literal_text_all_w_t_and_m_t":"    sl-NrOfHARQ-Processes-r16                  INTEGER (1..16)                                                       OPTIONAL, -- Need M","paragraph_zero_based":44899},{"literal_text_all_w_t_and_m_t":"    sl-HARQ-ProcID-offset-r16                  INTEGER (0..15)                                                       OPTIONAL, -- Need M","paragraph_zero_based":44900},{"literal_text_all_w_t_and_m_t":"    sl-CG-MaxTransNumList-r16                  SL-CG-MaxTransNumList-r16                                             OPTIONAL, -- Need M","paragraph_zero_based":44901},{"literal_text_all_w_t_and_m_t":"    rrc-ConfiguredSidelinkGrant-r16            SEQUENCE {","paragraph_zero_based":44902},{"literal_text_all_w_t_and_m_t":"        sl-TimeResourceCG-Type1-r16                INTEGER (0..496)                                                  OPTIONAL, -- Need M","paragraph_zero_based":44903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3b4aecc1b67b34b8eb2ef33509321607ccfa77327d617b8096b7eb2f6c1960cd","42b637f3e7c0b6d2afdebbea57a2be524943fcc98fb7e8aca6cd53109b624b98","bc2d2c88cc5d17e2deccebd2cac85550b8d083e2a6e57bedf7c0538b4482efe4","c19bdaabcdadff3aab367864544f3d441792755dd6ae31fa01f2faf653465ae2","c257efc04132146f493ab35e964a13a31038912e6c9c5a25af3b7ae14b67b43e","f262ccf75e46