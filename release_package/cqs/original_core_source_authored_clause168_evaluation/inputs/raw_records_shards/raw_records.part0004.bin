{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nid-IdentityList-r18             SEQUENCE (SIZE (1..maxNPN-r16)) OF NID-r16","paragraph_zero_based":44784},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":44785},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44786},{"literal_text_all_w_t_and_m_t":"-- TAG-AREACONFIGURATION-STOP","paragraph_zero_based":44787},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":44788},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44789},{"literal_text_all_w_t_and_m_t":"AreaConfiguration field descriptions","paragraph_zero_based":44790},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":44791},{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":44792},{"literal_text_all_w_t_and_m_t":"InterFreqTargetInfo","paragraph_zero_based":44793},{"literal_text_all_w_t_and_m_t":"If configured, it indicates the neighbouring frequency and cells for which UE is requested to perform measurement logging. It can include sync raster or non-sync raster frequencies.","paragraph_zero_based":44794},{"literal_text_all_w_t_and_m_t":"nid-IdentityList","paragraph_zero_based":44795},{"literal_text_all_w_t_and_m_t":"The nid-IdentityList contains one or more NID. All NIDs associated to the same PLMN ID are listed in the same nid-IdentityList entry.","paragraph_zero_based":44796},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":44797},{"literal_text_all_w_t_and_m_t":"–BT-NameList","paragraph_zero_based":44798},{"literal_text_all_w_t_and_m_t":"The IE BT-NameList is used to indicate the names of the Bluetooth beacon which the UE is configured to measure.","paragraph_zero_based":44799},{