{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27000},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27001},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig-r16 ::=     SEQUENCE {","paragraph_zero_based":27002},{"literal_text_all_w_t_and_m_t":"    cellGroupsForSwitchList-r16         SEQUENCE(SIZE (1..4)) OF CellGroupForSwitch-r16                  OPTIONAL,   -- Need R","paragraph_zero_based":27003},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchDelay-r16          INTEGER (10..52)                                                 OPTIONAL    -- Need R","paragraph_zero_based":27004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27006},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig-r17 ::=     SEQUENCE {","paragraph_zero_based":27007},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchTimer-r17          SCS-SpecificDuration-r17                                         OPTIONAL,   -- Need R","paragraph_zero_based":27008},{"literal_text_all_w_t_and_m_t":"    searchSpaceSwitchDelay-r17          INTEGER (10..52)                                                 OPTIONAL    -- Need R","paragraph_zero_based":27009},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27010},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27011},{"literal_text_all_w_t_and_m_t":"CellGroupForSwitch-r16 ::=          SEQUENCE(SIZE (1..16)) OF ServCellIndex","paragraph_zero_based":27012},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27013},{"literal_text_all_w_t_and_m_t":"SCS-SpecificDuration-r17   ::=      INTEGER (1..166)","paragraph_zero_based":27014},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27015},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIG-STOP","paragraph_zero_based":27016},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27017},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27018},{"literal_text_all_w_t_and_m_t":"PDCCH-Config field descriptions","paragraph_zero_based":27019},{"literal_text_all_w_t_and_m_t":"controlResourceSetToAddModList, controlResourceSetToAddModListSizeExt","paragraph_zero_based":27020},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be used by the UE. The network restrictions on configuration of CORESETs per DL BWP are specified in TS 38.213 [13], clause 10.1 and TS 38.306 [26]. The UE shall consider entries in controlResourceSetToAddModList and in controlResourceSetToAddModListSizeExt as a single list, i.e. an entry created using controlResourceSetToAddModList can be modified using controlResourceSetToAddModListSizeExt (or deleted using controlResourceSetToReleaseListSizeExt) and vice-versa. In case network reconfigures control resource set with the same ControlResourceSetId as used for commonControlResourceSet or commonControlResourceSetExt configured via PDCCH-ConfigCommon or via SIB20, the configuration from PDCCH-Config always takes precedence and should not be updated by the UE based on servingCellConfigCommon or based on SIB20.","paragraph_zero_based":27021},{"literal_text_all_w_t_and_m_t":"controlResourceSetToReleaseList, controlResourceSetToReleaseListSizeExt","paragraph_zero_based":27022},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Control Resource Sets (CORESETs) to be released by the UE. This field only applies to CORESETs configured by controlResourceSetToAddModList or controlResourceSetToAddModListSizeExt and does not release the field commonControlResourceSet configured by PDCCH-ConfigCommon and commonControlResourceSetExt configured by SIB20.","paragraph_zero_based":27023}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["68955c44c999c572e27dd93c17389ad345fae211ea767b0d56715fe833bdadaf","68482c6e8d2f95293e67d1fdc7e57063fb8bd271d6309ff8255ddf90ded978ec","d6a497a4801ee1fed2d98a7c58ea68ce9484c9c75a50f2d987b02e349a3bb729","c60514e1c5ea4498bf22842100abc2e1a52f935f33d17955788c0ded8da59a00","de6197db54bd3e129b0f77291ffb53f0e470574f862d17492ce86147b264a1c3","71b3819b94acd039ab0c152b1e28602138cd5513b210dd4e0db10b10cf11c605","6ec64f617047d94df638c4ac5546211a28f0953f2a781586429b97b6476ae9a1","c46907e2f5f72bc6ddec4756d088665270ffd0a6363de8330adc927d24ae3f97","d3ca7928b4f0590bc43b439d4c0898c7c5e10db4647bc94615765946d8d1a2f8","cba1dd056def4c4bcf3a063dc73b1c94c5c3a545d0ea73d3d0ec2f2288be406f","a0575bcdbe00daec757771a9fb10d8bad1926e255dae5d94f67607e62e545a32","c0c5b4eb4832cc2c635195002adcd74aeb59df7e0cb0a1a7430ebfce5f079d2b","e2f8e5706276b8ccffaf7c51d2887e984cee0a1670ecaf975dedd3fff42336d5","7ae78ea1a6d26662357bde685200e854e590da35714aa0b19ccc3a56ac5fda9a","f3b942649e84f05ae8a6ecb4ff262f5222a3d5408d57e9682c24f0f06238d093","024c15f3d8d9dbbe2a5de730eb33d558bbdd412fdd2341b22ff2148d2fe99985","35993840e7fd7f7d3a8e3ef4bf0b895b12f89206f4359dbbc85a60841d635fde","285692c731ba84c26d03def54574ca1abc51ce9ed4def4ad73654687a1342945","cf8e24c289d61a3585197ca5712501d72a14976657150f363586e7afdc9af833","cab86fa171047fd51d2caedc8d3442b534673115ec17c13a8242c17b7004eca6","6f2d8b3e32ac31a838d6fc5e11ba6e9e695d78dff9c89722fa63052663d5a5b0","0657e58afc9dbb559b351f8f9d28c90b17c723e2bf48020ecc3d618a038b3cc6","a1e740a710c3086b3b16de84a742d9c81a55534d19dd801a080b9c55d6b66809","7c2af1cf516718276debdc6fa1daab20ba0f157a1769b8c8f00b321bfe36a2cb"],"paragraph_range_zero_based":[27000,27023],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p27000"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"downlinkPreemption","paragraph_zero_based":27024},{"literal_text_all_w_t_and_m_t":"Configuration of downlink preemption indications to be monitored in this cell (see TS 38.213 [13], clause 11.2).","paragraph_zero_based":27025},{"literal_text_all_w_t_and_m_t":"monitoringCapabilityConfig","paragraph_zero_based":27026},{"literal_text_all_w_t_and_m_t":"Configures either Rel-15 PDCCH monitoring capability, Rel-16 PDCCH monitoring capability or Rel-17 PDCCH monitoring capability for PDCCH monitoring on a serving cell (see TS 38.213 [13], clause 10.1). Value r15monitoringcapability enables the Rel-15 monitoring capability, and value r16monitoringcapability enables the Rel-16 PDCCH monitoring capability. r17monitoringcapability enables the Rel-17 PDCCH multi-slot monitoring capability. For 480 and 960 kHz SCS, only value r17monitoringcapability is applicable.","paragraph_zero_based":27027},{"literal_text_all_w_t_and_m_t":"pdcch-MonitoringResumptionAfterNack","paragraph_zero_based":27028},{"literal_text_all_w_t_and_m_t":"This field is used to enable UE PDCCH monitoring resumption after PDCCH skipping has started, if the UE transmits a NACK due to incorrectly decoding a PDSCH scheduled by a DCI format received from the serving cell (see TS 38.213 [13], clause 10.4).","paragraph_zero_based":27029},{"literal_text_all_w_t_and_m_t":"pdcch-SkippingDurationList","paragraph_zero_based":27030},{"literal_text_all_w_t_and_m_t":"Provides one or more values to derive the skipping duration in unit of slots, as specified in TS 38.213 [13], clause 10.4. The DCI which schedules data indicates which of the values is to be applied (see TS 38.213 [13], clause 10.4). For the 15kHz SCS, for each entry, only the first 26 values are valid and correspond to {1, 2, 3, …, 20, 30, 40, 50, 60, 80, 100}. For the 30kHz SCS, for each entry, only the first 46 values are valid and correspond to {1, 2, 3, …, 40, 60, 80, 100, 120, 160, 200}. For the 60kHz SCS, for each entry, only the first 86 values are valid and correspond to {1, 2, 3, …, 80, 120, 160, 200, 240, 320, 400}. For the 120kHz SCS, for each entry, the 166 values correspond to {1, 2, 3, …, 160, 240, 320, 400, 480, 640, 800}. For the 480kHz SCS, for each entry, the 166 values correspond to {4, 8, 12, …, 640, 960, 1280, 1600, 1920, 2560, 3200}. For the 960kHz SCS, for each entry, the 166 values correspond to {8, 16, 24, …, 1280, 1920, 2560, 3200, 3840, 5120, 6400}.","paragraph_zero_based":27031},{"literal_text_all_w_t_and_m_t":"searchSpacesToAddModList, searchSpacesToAddModListExt","paragraph_zero_based":27032},{"literal_text_all_w_t_and_m_t":"List of UE specifically configured Search Spaces or MBS multicast Search Spaces. The network configures at most 10 Search Spaces per BWP per cell (including UE-specific and common Search Spaces). If the network includes searchSpacesToAddModListExt, it includes the same number of entries, and listed in the same order, as in searchSpacesToAddModList in each of them.","paragraph_zero_based":27033},{"literal_text_all_w_t_and_m_t":"searchSpaceSwitchConfig","paragraph_zero_based":27034},{"literal_text_all_w_t_and_m_t":"Configuration to control the UE behavior to switch from search space group X back to search space group 0, as specified in clause 10 of TS 38.213 [13]. The network only configures either searchSpaceSwitchConfig-r16 or searchSpaceSwitchConfig-r17 for a UE.","paragraph_zero_based":27035},{"literal_text_all_w_t_and_m_t":"tpc-PUCCH","paragraph_zero_based":27036},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUCCH.","paragraph_zero_based":27037},{"literal_text_all_w_t_and_m_t":"tpc-PUSCH","paragraph_zero_based":27038},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for PUSCH.","paragraph_zero_based":27039},{"literal_text_all_w_t_and_m_t":"tpc-SRS","paragraph_zero_based":27040},{"literal_text_all_w_t_and_m_t":"Enable and configure reception of group TPC commands for SRS.","paragraph_zero_based":27041},{"literal_text_all_w_t_and_m_t":"uplinkCancellation","paragraph_zero_based":27042},{"literal_text_all_w_t_and_m_t":"Configuration of uplink cancellation indications to be monitored in this cell (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":27043},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27044},{"literal_text_all_w_t_and_m_t":"SearchSpaceSwitchConfig field descriptions","paragraph_zero_based":27045},{"literal_text_all_w_t_and_m_t":"cellGroupsForSwitchList","paragraph_zero_based":27046},{"literal_text_all_w_t_and_m_t":"The list of serving cells which are bundled for the search space group switching purpose (see TS 38.213 [13], clause 10.4). A serving cell can belong to only one CellGroupForSwitch. The network configures the same list for all BWPs of serving cells in the same CellGroupForSwitch.","paragraph_zero_based":27047}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["75e7be05d5ba261bb8efe7370b185a263c9f6e4a1059fb43758003afb41e8429","1ec7a41a11f27abcbb26650f1a642cb01d9bd4e66e60a71134993c1d4ae1cdb1","551e582ac15f245fff126bb6704ad64a0ca7b1d3aea1df004a44404ea85916f9","2c47645a8063dd23be7f208c5a7822a4c1b4a336d2f71ca7a394f4d9da29aa65","e718cec827e398dd97121e641a4690039cf3f287bac76a1238717920ec0118ef","3a55573bf8e2c7e520f11d2383473ed8924c1e0ae5ad3da11fcf48a6fdb2c76f","6da4f02f8711fdd316d2204ee206979a56ee989b7048f04caa4df4acb1d9200a","e2ce9dea815ab96133a0927e5c91ca03ffba7d9e04f590e39f17505b8bc904cf","e6a97fc11c78462151005b6a23be7e06581e1b4e0490e7