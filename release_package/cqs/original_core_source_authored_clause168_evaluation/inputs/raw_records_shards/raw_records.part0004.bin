{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension             OCTET STRING                        OPTIONAL,","paragraph_zero_based":18096},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18097},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18099},{"literal_text_all_w_t_and_m_t":"-- TAG-SIPOS-STOP","paragraph_zero_based":18100},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18101},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18102},{"literal_text_all_w_t_and_m_t":"SIBpos field descriptions","paragraph_zero_based":18103},{"literal_text_all_w_t_and_m_t":"assistanceDataSIB-Element","paragraph_zero_based":18104},{"literal_text_all_w_t_and_m_t":"Parameter AssistanceDataSIBelement defined in TS 37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":18105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18106},{"literal_text_all_w_t_and_m_t":"6.3.2Radio resource control information elements","paragraph_zero_based":18107},{"literal_text_all_w_t_and_m_t":"–AdditionalSpectrumEmission","paragraph_zero_based":18108},{"literal_text_all_w_t_and_m_t":"The IE AdditionalSpectrumEmission is used to indicate emission requirements to be fulfilled by the UE (see TS 38.101-1 [15], clause 6.2.3/6.2A.3, TS 38.101-2 [39], clause 6.2.3/6.2A.3, and TS 38.101-5 [75], clause 6.2.3). If an extension is signalled using the extended value range (as defined by the IE AdditionalSpectrumEmission-v1760), the corresponding original field, using the value range as defined by the IE AdditionalSpectrumEmission (without suffix) shall be set to value 7.","paragraph_zero_based":18109},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission information element","paragraph_zero_based":18110},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18111},{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-START","paragraph_zero_based":18112},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18113},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission ::=              INTEGER (0..7)","paragraph_zero_based":18114},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18115},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission-v1760 ::=        INTEGER (8..39)","paragraph_zero_based":18116},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18117},{"literal_text_all_w_t_and_m_t":"AdditionalSpectrumEmission-r18 ::=          INTEGER (0..39)","paragraph_zero_based":18118},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c99b03422027b391ac363bc3cbcaa2db68d977a06166d5b7028f92b174022218","44b838a00496bc63310ffacf4954c51a309c503e05b7ad36a5c3f46737ab6be0","6fc52ad963ef30fdc1b7b9a271270aca6a565a160a323f881017d3798b4ff3a8","f844a080b6626a1942c0de19f53558b1f433cd2aabea1d266b0dcc241f0f49c1","b03cf9956017729eb2d2fc9b3c2f35d203060d353e248f0e904a591f15c10013","24e82becb0afd4a633ff147b323ebaa8c3699c98c9866c521bb84b419def7cb3","94700668621e87135a6397c6d6ffb25aa526216fad5104f0ad3339005eff522a","923ab409155a357e4256053f48d5e9b26b4532766842e77ad724a43b0a70dba7","a2052afbe4c33039ad078c61e0bcf3bd96cbb73b1aa98de0871936506b6ad3fa","9ba72e90b32cec8a0bfdcb500f9ec1f613e01adbe32ff9a3d9a47e92ad0aa013","d04a130da45585af3126935796ea0751086d9204e71aad002e0c306e438bc879","f599d86edbfac3a3869f601398bb32aa