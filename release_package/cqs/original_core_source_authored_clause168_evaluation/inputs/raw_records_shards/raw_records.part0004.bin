{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25584},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo ::=                        SEQUENCE {","paragraph_zero_based":25585},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR                         FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":25586},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList                              NR-NS-PmaxList              OPTIONAL    -- Need S","paragraph_zero_based":25587},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25588},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25589},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-SIB-v1760 ::=      SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfo-v1760","paragraph_zero_based":25590},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25591},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfo-v1760 ::=                  SEQUENCE {","paragraph_zero_based":25592},{"literal_text_all_w_t_and_m_t":"    nr-NS-PmaxList-v1760                        NR-NS-PmaxList-v1760        OPTIONAL    -- Need S","paragraph_zero_based":25593},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25594},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25595},{"literal_text_all_w_t_and_m_t":"MultiFrequencyBandListNR-Aerial-SIB-r18 ::= SEQUENCE (SIZE (1.. maxNrofMultiBands)) OF NR-MultiBandInfoAerial-r18","paragraph_zero_based":25596},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25597},{"literal_text_all_w_t_and_m_t":"NR-MultiBandInfoAerial-r18 ::=              SEQUENCE {","paragraph_zero_based":25598},{"literal_text_all_w_t_and_m_t":"    freqBandIndicatorNR-Aerial-r18              FreqBandIndicatorNR         OPTIONAL,   -- Cond OptULNotSIB2","paragraph_zero_based":25599},{"literal_tex