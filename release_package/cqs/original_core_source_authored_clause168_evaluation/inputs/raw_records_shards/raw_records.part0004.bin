{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–RRCResume","paragraph_zero_based":13320},{"literal_text_all_w_t_and_m_t":"The RRCResume message is used to resume the suspended RRC connection.","paragraph_zero_based":13321},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":13322},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":13323},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":13324},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":13325},{"literal_text_all_w_t_and_m_t":"RRCResume message","paragraph_zero_based":13326},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":13327},{"literal_text_all_w_t_and_m_t":"-- TAG-RRCRESUME-START","paragraph_zero_based":13328},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13329},{"literal_text_all_w_t_and_m_t":"RRCResume ::=                       SEQUENCE {","paragraph_zero_based":13330},{"literal_text_all_w_t_and_m_t":"    rrc-TransactionIdentifier           RRC-TransactionIdentifier,","paragraph_zero_based":13331},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                  CHOICE {","paragraph_zero_based":13332},{"literal_text_all_w_t_and_m_t":"        rrcResume                           RRCResume-IEs,","paragraph_zero_based":13333},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture            SEQUENCE {}","paragraph_zero_based":13334},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":13335},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":13336},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":13337},{"literal_text_all_w_t_and_m_t":"RRCResume-IEs ::=                   SEQUENCE {","paragraph_zero_based":13338},{"literal_text_all_w_t_and_m_t":"    radioBearerConfig                   RadioBearerConfig                                               OPTIONAL, -- Need M","paragraph_zero_based":13339},{"literal_text_all_w_t_and_m_t":"    masterCellGroup                     OCTET STRING (CONTAINING CellGroupConfig)                       OPTIONAL, -- Need M","paragraph_zero_based":13340},{"literal_text_all_w_t_and_m_t":"    measConfig                          MeasConfig                                                      OPTIONAL, -- Need M","paragraph_zero_based":13341},{"literal_text_all_w_t_and_m_t":"    fullConfig                          ENUMERATED {true}                                               OPTIONAL, -- Need N","paragraph_zero_based":13342},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                    OPTIONAL,","paragraph_zero_based":13343}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["56503de1ea2caa944c2c109efc84aef0450faf2e31d9d11008003f88b64375ae","38e41fa234b9baf1b9ce63362ad622171ed26ac6c5661375ee971753b2320551","48d66959f6d21fc92f9955bf28b576d48b44c0fc0c3649ebcaf78b540346e32f","bcacfae9cd963dd2fcdf01d254613558d1da2d76207374e29b378663e754ae3a","046024aee2de7abac582490ba5ec574ca7101477b2ee03361d5e449d3e05b5da","2b2e1c01da8a357faeec20eec60f902473e31eecd0e0e9563355e9cb213b9cc2","f1cb6f407088dd1fc0b4f9a9cbeaf2f4afc7a203d261f8eb7f34f6ae4a33756c","c9ab7890e9568705ed50abadf6eb80253b7295566ea72c701fccbbea81d34777","d943caff6ff95b86325a300214b46d1c213a8214f661fa59c6c602158bc72d8b","0872fe82460cc8b111d11c2085926de6e9bc7e0bda9bf1b9633239c974ed4f7f","2654d7b4168005741e02e837464a39ccf463b2ceced71469a39eda7384516eec","3e93ce8674dbf4a52ca794e05d1ef