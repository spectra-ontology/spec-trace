{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerCatList","paragraph_zero_based":35664},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerCatList provides access control parameters for a list of access categories.","paragraph_zero_based":35665},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList information element","paragraph_zero_based":35666},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35667},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERCATLIST-START","paragraph_zero_based":35668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35669},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList ::=           SEQUENCE (SIZE (1..maxAccessCat-1)) OF UAC-BarringPerCat","paragraph_zero_based":35670},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35671},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCat ::=               SEQUENCE {","paragraph_zero_based":35672},{"literal_text_all_w_t_and_m_t":"   accessCategory                       INTEGER (1..maxAccessCat-1),","paragraph_zero_based":35673},{"literal_text_all_w_t_and_m_t":"   uac-barringInfoSetIndex              UAC-BarringInfoSetIndex","paragraph_zero_based":35674},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35675},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35676},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERCATLIST-STOP","paragraph_zero_based":35677},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35679},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerCatList field descriptions","paragraph_zero_based":35680},{"literal_text_all_w_t_and_m_t":"accessCategory","paragraph_zero_based":35681},{"literal_text_all_w_t_and_m_t":"The Access Category according to TS 22.261 [25].","paragraph_zero_based":35682},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35683},{"literal_text_all_w_t_and_m_t":"–UAC-BarringPerPLMN-List","paragraph_zero_based":35684},{"literal_text_all_w_t_and_m_t":"The IE UAC-BarringPerPLMN-List provides access category specific access control parameters, which are configured per PLMN/SNPN.","paragraph_zero_based":35685},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN-List information element","paragraph_zero_based":35686},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ad2aabb3c1e7cf4a3fdb0978c4a9b7539730065d4a595af9245866ef1ee526ba","ef44cd415826043228e639c837be14e0760fa4e95d61ea7c5f7313d9af0af38a","af8fe40a30d121307075e5a52aad197d70cd1ddc2edab02a76bd06e98d089e03","963ad62ffddb95f68cf4d262207fbb1adb3ae4e01e851abae9ba5e327ea88f8f","604be2503f605ea4da5eae2db831a1ea854b393d1a9e9cf807ae4b009f284450","02a4e3d9956eff1a7d6dda516f5c58405da0a377814b374d6f9ba5efb18ee6e7","603289501ded9356583a2e17400695bf33a0df06a755c96e64825fecb8b96dd8","3135ad947931341af94bbf864a18696911815e24c0e918f506c4f6cedc464e83","87b97512eb705f8ddd59ea34bbcb0f4f63f92ab4b9f2808640fb8548325cac15","61d19419781d94a290b31e4e6eb7d11b141aab4eefafe09b90552d1509ebfe9a","88101f21b7d3f2fc5e165c62c52143f4d8f6983384739d8a6a049b45a015ce9a","cb8d23c841faaa88f54b7b9c7e9b82d0c2329341ad873baede60e16a7d1e3c20","5cd2ef9e5034704c32fb82e03bea857aec10c3a5b698efe7cb38510c6718586d","beba113582cf29ec23e741f2cba91e97bad6e3714b8b4d06b080e6fe078432a0","3a4c4b933ff4e99e606594fb3bd635ca719d32b47a4e6688d5dad0099998ac2e","dd17648e029765ece4735739629deba2138afd7882f94c7bc4c5dd2b52de2367","c1bc71e32c772d426c4f5c53281ed01ddf51