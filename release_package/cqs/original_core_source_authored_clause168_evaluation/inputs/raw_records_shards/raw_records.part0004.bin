                                   OPTIONAL,   -- Need R","paragraph_zero_based":30300},{"literal_text_all_w_t_and_m_t":"    prach-ConfigurationIndex-v1610              INTEGER (256..262)                                              OPTIONAL    -- Need R","paragraph_zero_based":30301},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":30302},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":30303},{"literal_text_all_w_t_and_m_t":"    ra-ResponseWindow-v1700                     ENUMERATED {sl240, sl320, sl640, sl960, sl1280, sl1920, sl2560} OPTIONAL    -- Need R","paragraph_zero_based":30304},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":30305},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30307},{"literal_text_all_w_t_and_m_t":"-- TAG-RACH-CONFIGGENERIC-STOP","paragraph_zero_based":30308},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30309},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30310},{"literal_text_all_w_t_and_m_t":"RACH-ConfigGeneric field descriptions","paragraph_zero_based":30311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["5f8a028ea45e1d2ab1451f5ebfb70535da5df2e65f9cd0146e0746416a8c7ed3","629a38964a8b4050b5953b0392ebfdb38c6cb96a095aafc07be1db69f70f8c7c","50f1df29b412b46ec0b730b118ebc0b374c1012ac48261ed8f29dbb6a2e999ed","3e0c465fb51c1b49620ebde5c1dbe869323dbfd874e6c00bc859ea13da9bd779","85768d6b68842f8640d9ccb4353f0258cf111609f8dd14d3f764cb1fe77f48ad","8097d43da85b98a0a02741c3552f354a16cd4b17f8f92f2bee79c6107058e869","e8db99fc189d8896ee7ecc7aa9c12dde5c0a72012e5e1d344779a864f69d093c","38b3df37db