{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"            sCS120KHZoneT-SCS60KHZhalfT-SCS30KHZquarterT-SCS15KHZoneEighthT  SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..1119),","paragraph_zero_based":27504},{"literal_text_all_w_t_and_m_t":"            sCS120KHZhalfT-SCS60KHZquarterT-SCS30KHZoneEighthT-SCS15KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..2239),","paragraph_zero_based":27505},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..4479),","paragraph_zero_based":27506},{"literal_text_all_w_t_and_m_t":"            sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..8959),","paragraph_zero_based":27507},{"literal_text_all_w_t_and_m_t":"            sCS480KHZquarterT-SCS120KHZoneSixteenthT                         SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..17919),","paragraph_zero_based":27508},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneEighthT                                           SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..35839),","paragraph_zero_based":27509},{"literal_text_all_w_t_and_m_t":"            sCS480KHZoneSixteenthT                                        SEQUENCE (SIZE (1..maxPEI-perPF-r17)) OF INTEGER (0..71679)","paragraph_zero_based":27510},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":27511},{"literal_text_all_w_t_and_m_t":"    }                                                                                           OPTIONAL     -- Cond InitialBWP-Paging","paragraph_zero_based":27512},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27513},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27514},{"literal_text_all_w_t_and_m_t":"    followUnifiedTCI-State-v1720           ENUMERATED {enabled}                                  OPTIONAL     -- Need R","paragraph_zero_based":27515},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":27516},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":27517},{"literal_text_all_w_t_and_m_t":"    applyIndicatedTCI-State-r18            ENUMERATED {first, second, both, none}                OPTIONAL,   -- Cond FollowUTCI","paragraph_zero_based":27518},{"literal_text_all_w_t_and_m_t":"    commonSearchSpaceListExt-r18           SEQUENCE (SIZE(1..4)) OF SearchSpaceExt-v1800         OPTIONAL,   -- Need R","paragraph_zero_based":27519},{"literal_text_all_w_t_and_m_t":"    searchSpaceMulticastMCCH-r18           SearchSpaceId                                         OPTIONAL,   -- Need R","paragraph_zero_based":27520},{"literal_text_all_w_t_and_m_t":"    searchSpaceMulticastMTCH-r18           SearchSpaceId                                         OPTIONAL    -- Need S","paragraph_zero_based":27521},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":27522},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":27523},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27524},{"literal_text_all_w_t_and_m_t":"-- TAG-PDCCH-CONFIGCOMMON-STOP","paragraph_zero_based":27525},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":27526},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e9a6ee1a58e5cfe57ad740d097dbb571b1c34d71942f2d68f077991bbba11830","d7d63f86334cf31e132e0155938cb8a6e41335ee82822cf4dd8af1766fab2365","c91340663cc3ce0b8717d6c4fa6aa14886c37af189e571a24e9faa7890c2499a","5d19ccc9012795920b8fb728db9f2ffe5b1ce8951222b2b2a5d6b9605c8c9fb5","c1767aac3e03de04cd4d5f6f6a5ddd6b1d9d745c16efcb6229341fe93a766a6f","05a825e1061756a1ff48c582342b8d9a284e2e78f7d6e18489860483897400ad","489ea1d6ba1f2c7720e4fd710737c7dba69e3e0c28dd23e60820eb0e902af0f2","09b789596e46e238b43ecc45888a3fe07df10797fff7bf65de679ea26f1ca78f","4b2a47c5588e8d0786c841ca4952c44a1b420d6c4f6b67bbfbd087c5e373803e","617221702e21b0c082cbfe19aebf2862e77d3cd9f30b923a73a1ebd4dd1eb124","27494bbde4d5a6b92c461266b1f39f4f8ac9ab3373f558b2c499b4a20115ad8b","58f4c9ada007b0e19336645a320fe9bd4a730c85aa62fe5818ad9ca37e08bc0f","ab08e79683ed1b4d6bb1f00debac94b525d947fb5f8b494c1291ba33b23ba660","107d3a371bb7c76bbd432319052641711d800b24fdddb7736296c5eb8ac0a7dc","76f6cf6fc8fdef3c977f0dd0b9a97753f563649b4e4eeecf339debf29da441b5","68cb6f6d5f5cbb0e84346d171c1f6feff0186158b0acb05d76536acf04029018","562478e1e095bb2ac8e2d4d713c02937df81e8b5a9dddabf04b6bcd1d8c69ffb","bb9334ed0d5475eb604f2ae71c03b52dd0a883973da8a2c8ed5427f581aa6b63","21843f89848d36f4f6b2555d6c3cfb02b6e95c6d04f62783b571132cd09b9f49","21eb85459313f0ff8db02bb05cfdb4c171db53a026fcfd44bc8c1e9e94cade72","91597b8e1cdf2d0b1ea0e61ffd57081e8bb9eda30f86c53f9505bb2909c742c1","9e64cdb16102ba6c6600fb34ef48184da6d055a733faaa359dca9bb47003ca27","0fc3ace7994cfa316be42328625b9cb74de070c0fb5f96b63fe2939c83992040","faff0addfeb6183982daea14cf177c7b04baaf42a58313e63f57864213261d34"],"paragraph_range_zero_based":[27504,27527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27504"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-ConfigCommon field descriptions","paragraph_zero_based":27528},{"literal_text_all_w_t_and_m_t":"applyIndicatedTCI-State","paragraph_zero_based":27529},{"literal_text_all_w_t_and_m_t":"This field indicates, for PDCCH reception in CORESET #0, if UE applies the first, the second, both or none of the \"indicated\" DL only TCI or joint TCI as specified in TS 38.213 [13], clause 10.1.","paragraph_zero_based":27530},{"literal_text_all_w_t_and_m_t":"commonControlResourceSet","paragraph_zero_based":27531},{"literal_text_all_w_t_and_m_t":"An additional common control resource set which may be configured and used for any common or UE-specific search space. If the network configures this field, it uses a ControlResourceSetId other than 0 for this ControlResourceSet. The network configures the commonControlResourceSet in SIB1 so that it is contained in the bandwidth of CORESET#0. If the RedCap-specific initial downlink BWP does not contain the entire CORESET#0, the network configures the commonControlResourceSet in the (e)RedCap-specific initial downlink BWP in SIB1 for (e)RedCap such that it does not have to be contained in the bandwidth of CORESET#0.","paragraph_zero_based":27532},{"literal_text_all_w_t_and_m_t":"commonSearchSpaceList, commonSearchSpaceListExt, commonSearchSpaceListExt2","paragraph_zero_based":27533},{"literal_text_all_w_t_and_m_t":"A list of additional common search spaces. If the network configures this field, it uses the SearchSpaceIds other than 0. If the field is included, it replaces any previous list, i.e. all the entries of the list are replaced and each of the SearchSpace entries is considered to be newly created and the conditions and Need codes for setup of the entry apply. If the network includes commonSearchSpaceListExt/commonSearchSpaceListExt2, it includes the same number of entries, and listed in the same order, as in commonSearchSpaceList.","paragraph_zero_based":27534},{"literal_text_all_w_t_and_m_t":"controlResourceSetZero","paragraph_zero_based":27535},{"literal_text_all_w_t_and_m_t":"Parameters of the common CORESET#0 which can be used in any common or UE-specific search spaces. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0) controlResourceSetZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions defined in TS 38.213 [13], clause 10 are satisfied.","paragraph_zero_based":27536},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPEI-O","paragraph_zero_based":27537},{"literal_text_all_w_t_and_m_t":"Offset, in number of symbols, from the start of the reference frame for PEI-O to the start of the first PDCCH monitoring occasion of PEI-O on this BWP, see TS 38.213 [13], clause 10.4A. For the case po-NumPerPEI is smaller than Ns, UE applies the (floor(i_s/po-NumPerPEI)+1)-th value out of (N_s/po-NumPerPEI) configured values in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset. When po-NumPerPEI is one or multiple of Ns, UE applies the first configured value in firstPDCCH-MonitoringOccasionOfPEI-O for the symbol-level offset.","paragraph_zero_based":27538},{"literal_text_all_w_t_and_m_t":"firstPDCCH-MonitoringOccasionOfPO","paragraph_zero_based":27539},{"literal_text_all_w_t_and_m_t":"Indicates the first PDCCH monitoring occasion of each PO of the PF on this BWP, see TS 38.304 [20]. The field sCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS120KHZoneSixteenthT can be applied for SCS 480kHz, corresponding to sCS480KHZoneT-SCS120KHZquarterT-SCS60KHZoneEighthT-SCS30KHZoneSixteenthT, sCS480KHZhalfT-SCS120KHZoneEighthT-SCS60KHZoneSixteenthT and sCS480KHZquarterT-SCS120KHZoneSixteenthT in IE DownlinkConfigCommonSIB respectively.","paragraph_zero_based":27540},{"literal_text_all_w_t_and_m_t":"followUnifiedTCI-State","paragraph_zero_based":27541},{"literal_text_all_w_t_and_m_t":"When set to enabled, for PDCCH reception in CORESET #0, the UE applies the \"indicated\" DL only TCI or joint TCI as specified in TS 38.214 [19], clause 5.1.5.","paragraph_zero_based":27542},{"literal_text_all_w_t_and_m_t":"pagingSearchSpace","paragraph_zero_based":27543},{"literal_text_all_w_t_and_m_t":"ID of the search space for paging (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive paging in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing, shall monitor paging in the initial DL BWP that includes CORESET#0.","paragraph_zero_based":27544},{"literal_text_all_w_t_and_m_t":"pei-ConfigBWP","paragraph_zero_based":27545},{"literal_text_all_w_t_and_m_t":"Provides the configuration for PEI reception in this BWP. If the field is absent, the UE does not receive PEI in this BWP. For the initialDownlinkBWP-RedCap not including CD-SSB and the entire CORESET#0, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE while SDT procedure is not ongoing monitors PEI in the initialDownlinkBWP that includes CORESET#0, if the initialDownlinkBWP is configured with pei-ConfigBWP.","paragraph_zero_based":27546},{"literal_text_all_w_t_and_m_t":"pei-SearchSpace","paragraph_zero_based":27547},{"literal_text_all_w_t_and_m_t":"ID of dedicated search space for PEI. It can be configured to one of up to 4 common SS sets configured by commonSearchSpaceList with SearchSpaceId > 0. The CCE aggregation levels and maximum number of PDCCH candidates per CCE aggregation level follows Table 10.1-1 of TS38.213 [13]. SearchSpaceId = 0 can be configured for the case of SS/PBCH block and CORESET multiplexing pattern 2 or 3.","paragraph_zero_based":27548},{"literal_text_all_w_t_and_m_t":"ra-SearchSpace","paragraph_zero_based":27549},{"literal_text_all_w_t_and_m_t":"ID of the Search space for random access procedure (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive RAR in this BWP. This field is mandatory present in the DL BWP(s) if the conditions described in TS 38.321 [3], clause 5.15 are met.","paragraph_zero_based":27550},{"literal_text_all_w_t_and_m_t":"sdt-SearchSpace","paragraph_zero_based":27551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d4e35b40f6c08a789292f863b819daca9b5d26ade290897613f5790f7bc94609","cefa1e1f77ab8ba609e9479eed4123f9df1964fb0d63fb8042a45ba58d5ece13","a0231bc120b95caeb56579d94cd98e4aedb6ff1a5caab601d9083afd44867309","67cd71311198d106699990a45096bcebb495d2032992d8d29b008a38eb9b34c9","67b98a0e9e7013618b95c4211bcabad3c4f5f0bf9120cbcb00e73d430db856fc","96a75cbaba77565bc035fe4ff089df75ebf4636c92a76421687de52b1852dd18","b12749b9124a096a20817a9c7245d9f350f6791974c9e695addc1adccd72628b","2d800eab0e67638ac7f6140aa01675851621ada44efa5887da0edebedc66c1c2","6e1f380cf171795d657388c0cdf5eed9c020675c2a671eed671f53be15034af8","4a6ad6043916b4e26dca9d64df1261a3f4a7803ec715edffe0bdea9e5d8391a2","51bdbd190231313c1d2a4897f9efb22f03dd0dd76bb26bf58870e5ca6de8df9f","8aa99d3db41ae4cbf4d1e1af4436b2b780e09d146fa97d6bcffe139f150dea6e","13c2a74ff13ca80df3d91ce907f6156500647418d6680f860b3461bb0ebbef86","265be0509016341be807bd65aef4d368e712f1877e50be4f8cf3b52f36a70422","cc4eef83a62bfc2328f7c53aed527bb2d8ac329cb9445d3ee9518374c3c8e4d2","5b808202f6e251273a162ca2640ac416b13131ca11c02939a8a67dbafdfa1aab","e12ee8f085669e1bd2093fd85ed150fdf722943ff77f4fe0d8f6b0c4aa89a4ff","7023643236214ccde400da49698a2be64c3b7fa2892fa9f3bb4a0096e62f54a8","b75afe01f56ffacfa40395e6075227d42b109ba70457e2aebb7497530770721d","025c61f3b6f8c240ae7f225414354f60ee3686fe8d7c251434df21ade173398f","3ce1671ad25305e8858607ae14d539600101a1254d583e24b26ec455ea5bb648","b4e3cf326edc03cd472667cab40b008be0b2514a1f9ae31b6a92affb7174cdc4","402e5f9bf7510452a24dc27595ec008d363c6bbdf047cdf7b708f8643907fc63","4e12bbc01a207bd03de632d5a41ffb79007c8789b65901156774e65784ea33e5"],"paragraph_range_zero_based":[27528,27551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p27528"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Common search space for CG-SDT and RA-SDT (see TS 38.213 [13]). If an existingSearchSpace is used, the network only signals the search space ID of the ra-SearchSpace.","paragraph_zero_based":27552},{"literal_text_all_w_t_and_m_t":"searchSpaceMCCH","paragraph_zero_based":27553},{"literal_text_all_w_t_and_m_t":"ID of the search space for MCCH. If the field is absent, the UE does not receive MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27554},{"literal_text_all_w_t_and_m_t":"searchSpaceMTCH","paragraph_zero_based":27555},{"literal_text_all_w_t_and_m_t":"ID of the search space for MTCH of MBS broadcast. If the field is absent, the UE applies searchSpaceMCCH also for MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27556},{"literal_text_all_w_t_and_m_t":"searchSpaceMulticastMCCH","paragraph_zero_based":27557},{"literal_text_all_w_t_and_m_t":"ID of the search space for multicast MCCH. If the field is absent, the UE does not receive multicast MCCH in this BWP (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27558},{"literal_text_all_w_t_and_m_t":"searchSpaceMulticastMTCH","paragraph_zero_based":27559},{"literal_text_all_w_t_and_m_t":"ID of the search space for multicast MTCH. If the field is absent, the UE applies searchSpaceMulticastMCCH also for multicast MTCH, (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial downlink BWP, if it does not include CD-SSB and the entire CORESET#0.","paragraph_zero_based":27560},{"literal_text_all_w_t_and_m_t":"searchSpaceOtherSystemInformation","paragraph_zero_based":27561},{"literal_text_all_w_t_and_m_t":"ID of the Search space for other system information, i.e., SIB2 and beyond (see TS 38.213 [13], clause 10.1). If the field is absent, the UE does not receive other system information in this BWP. This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive other system information using searchSpaceOtherSystemInformation in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":27562},{"literal_text_all_w_t_and_m_t":"searchSpaceSIB1","paragraph_zero_based":27563},{"literal_text_all_w_t_and_m_t":"ID of the search space for SIB1 message. In the initial DL BWP of the UE′s PCell, the network sets this field to 0. If the field is absent, the UE does not receive SIB1 in this BWP. (see TS 38.213 [13], clause 10). This field is absent for the RedCap-specific initial DL BWP, if it does not include CD-SSB and the entire CORESET#0. In that case, an (e)RedCap UE in RRC_IDLE or RRC_INACTIVE shall monitor PDCCH to receive SIB1 using searchSpaceSIB1 in the initial DL BWP that includes CD-SSB and the entire CORESET#0.","paragraph_zero_based":27564},{"literal_text_all_w_t_and_m_t":"searchSpaceZero","paragraph_zero_based":27565},{"literal_text_all_w_t_and_m_t":"Parameters of the common SearchSpace#0. The values are interpreted like the corresponding bits in MIB pdcch-ConfigSIB1. Even though this field is only configured in the initial BWP (BWP#0), searchSpaceZero can be used in search spaces configured in other DL BWP(s) than the initial DL BWP if the conditions described in TS 38.213 [13], clause 10, are satisfied.","paragraph_zero_based":27566},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":27567},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":27568},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":27569},{"literal_text_all_w_t_and_m_t":"FollowUTCI","paragraph_zero_based":27570},{"literal_text_all_w_t_and_m_t":"The field is absent if the field followUnifiedTCI-State is present. Otherwise, it is optionally present, Need R.","paragraph_zero_based":27571},{"literal_text_all_w_t_and_m_t":"InitialBWP-Only","paragraph_zero_based":27572},{"literal_text_all_w_t_and_m_t":"If SIB1 is broadcast the field is mandatory present in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon except it is the RedCap-specific initial BWP not including CD-SSB and the entire CORESET#0 in which case the field is absent, Need R; it is absent in other BWPs and when sent in system information. If SIB1 is not broadcast and there is an SSB associated to the cell, the field is optionally present, Need M, in the PDCCH-ConfigCommon of the initial BWP (BWP#0) in ServingCellConfigCommon (still with the same setting for all UEs). In other cases, the field is absent.","paragraph_zero_based":27573},{"literal_text_all_w_t_and_m_t":"InitialBWP-Paging","paragraph_zero_based":27574},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if this BWP is the initialDownlinkBWP or initialDownlinkBWP-RedCap including CD-SSB and the entire CORESET#0, and pei-Config is configured in DownlinkConfigCommonSIB. Otherwise, this field is absent.","paragraph_zero_based":27575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8ff0477e49c0efea2056130d3203c37554fc58c04c341ad697e2b131718845ed","797fed4b5ece