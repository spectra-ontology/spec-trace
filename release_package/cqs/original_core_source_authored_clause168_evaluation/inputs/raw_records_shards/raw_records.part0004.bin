{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36312},{"literal_text_all_w_t_and_m_t":"UplinkCancellation field descriptions","paragraph_zero_based":36313},{"literal_text_all_w_t_and_m_t":"ci-ConfigurationPerServingCell","paragraph_zero_based":36314},{"literal_text_all_w_t_and_m_t":"Indicates (per serving cell) the position of the ci-PaylaodSize bit CI values inside the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36315},{"literal_text_all_w_t_and_m_t":"ci-RNTI","paragraph_zero_based":36316},{"literal_text_all_w_t_and_m_t":"RNTI used for indication cancellation in UL (see TS 38.212 [17] clause 7.3.1 and TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36317},{"literal_text_all_w_t_and_m_t":"dci-PayloadSizeForCI","paragraph_zero_based":36318},{"literal_text_all_w_t_and_m_t":"Total length of the DCI payload scrambled with CI-RNTI (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36319},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":36320},{"literal_text_all_w_t_and_m_t":"CI-ConfigurationPerServingCell field descriptions","paragraph_zero_based":36321},{"literal_text_all_w_t_and_m_t":"ci-PayloadSize","paragraph_zero_based":36322},{"literal_text_all_w_t_and_m_t":"Configures the field size for each UL cancelation indicator of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36323},{"literal_text_all_w_t_and_m_t":"deltaOffset","paragraph_zero_based":36324},{"literal_text_all_w_t_and_m_t":"Configures the additional offset from the end of a PDCCH reception where the UE detects the DCI format 2_4 and the first symbol of the T_\"CI\" symbols, in the unit of OFDM symbols (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36325},{"literal_text_all_w_t_and_m_t":"frequencyRegionForCI","paragraph_zero_based":36326},{"literal_text_all_w_t_and_m_t":"Configures the reference frequency region where a detected UL CI is applicable (see TS 38.213 [13], clause 11.2A). It is defined in the same way as locationAndBandwidth.","paragraph_zero_based":36327},{"literal_text_all_w_t_and_m_t":"positionInDCI","paragraph_zero_based":36328},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36329},{"literal_text_all_w_t_and_m_t":"positionInDCI-ForSUL","paragraph_zero_based":36330},{"literal_text_all_w_t_and_m_t":"Starting position (in number of bit) of the ci-PayloadSize bit CI value applicable for SUL of this serving cell (servingCellId) within the DCI payload (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36331},{"literal_text_all_w_t_and_m_t":"timeDurationForCI","paragraph_zero_based":36332},{"literal_text_all_w_t_and_m_t":"Configures the duration of the reference time region in symbols where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A). If the field is absent, i.e., the configured UL CI monitoring periodicity indicated by monitoringSlotPeriodicityAndOffset for DCI format 2_4 is larger than 1 slot or 1 slot with only one monitoring occasion, the UE applies the value of the configured UL CI monitoring periodicity,","paragraph_zero_based":36333},{"literal_text_all_w_t_and_m_t":"timeFrequencyRegion","paragraph_zero_based":36334},{"literal_text_all_w_t_and_m_t":"Configures the reference time and frequency region where a detected UL CI is applicable of this serving cell (servingCellId) (see TS 38.213 [13], clause 11.2A).","paragraph_zero_based":36335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e0eaa3cd2b71cdf7f3ca4083ef641faf590ad9f840dec62f795e9a29c2f22b14","2278e9321fda2f5b95e5dfe625d2d70d71a460f38ce91d3631712580d4eef3f6","b4bc56e34982484dfae34620e2fd4bc016266bc33949a36876bdee8727d15e33","d08f95219a04eddc9abad83eea8a080f80c169e1d9a6f3018f14fb367945ce7e","73e404fe6647d2fa46ea58c16f71e550510831e993690657998db8f1fe3adf00","b79578b8347580001025b2b5a59b6da761d6b5f24b6e8c20090fe3c15625dadc","760b435f4a2d417dabd4886107e9f421b91d4ed173bbdde2ec30b33905a563c4","ed8c73f9d71734bd4f093b448d390035bb2123a3ea78dbdf19ce9deeac4e1ab9","1eb8924a383e383df28f7f5b680c58a638f3ba7c64a2d5c11ed87c4c808ee774","a5ff3ec7f387a2e15de9fa33725ef3e451d8f3169e2f93e29436c475311ae21d","79df2a336c05341a3331ab6c7039765a93be5d868de4eb4e24e5d12be0570182","036a8161d9a7da060f5d90b22713a9f4c3bfaa47f3677a0fcc6f05d974ad10fb","d444ccc1b427b36bae6c81034a103e56013f219bcbe8ceb918a64852a649fdbc","c7fd6c14ea4f168b22c5fcde33773507bb13fc215046e472bbc16dd270b1ad25","a4618f98ab9e056f8cf3530141972e5e4f452947f5337801c3c1b7c2d1de8591","693f280c6ad9194a8f8cb899cd9e4b9bb11a550fbe3411164787d6cb6617a395","9dbead10920ede3c166e8e5bfc0712c502b021cf0bbdaa1a4c16688a37aca558","b01841e82e420f6c11b37b41137558ce252942b53acfb7d948fca23840a59753","3b44d8890b7235d410d376ebd1de3c3b2c22083cc6766b639d6789740b9b4644","dd00d23178218e9874b74a0feed50a6fee58d04316c87f09c3a1c12ac3cd8588","01fa94242fa629186cad279ed091d68cea680b0ee633768a30ec83e8804bf87f","2e4887680b7f8ccce7dad12ccc9b4bb58ee475deefd17386659fb752f554bd82","829de484a5b9bc8dd1bcb95ce0e604399c2657420ea1328f11e6a593036ea889","7f33fc8b792a060eb0bcea5a8cb59373884559ef3dceac6a263ea8f686fbb4b6"],"paragraph_range_zero_based":[36312,36335],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-24