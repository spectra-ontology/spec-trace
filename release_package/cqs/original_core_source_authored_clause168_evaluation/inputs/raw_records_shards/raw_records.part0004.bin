{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45240},{"literal_text_all_w_t_and_m_t":"SL-FreqConfig-r16 ::=              SEQUENCE {","paragraph_zero_based":45241},{"literal_text_all_w_t_and_m_t":"    sl-Freq-Id-r16                     SL-Freq-Id-r16,","paragraph_zero_based":45242},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16     SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":45243},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16     ARFCN-ValueNR                                                   OPTIONAL,  -- Need M","paragraph_zero_based":45244},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16        ARFCN-ValueNR                                                   OPTIONAL,  -- Need R","paragraph_zero_based":45245},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16         ENUMERATED {true}                                               OPTIONAL,  -- Cond V2X-SL-Shared","paragraph_zero_based":45246},{"literal_text_all_w_t_and_m_t":"    valueN-r16                         INTEGER (-1..1),","paragraph_zero_based":45247},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToReleaseList-r16           SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF BWP-Id               OPTIONAL,  -- Need N","paragraph_zero_based":45248},{"literal_text_all_w_t_and_m_t":"    sl-BWP-ToAddModList-r16            SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-Config-r16    OPTIONAL,  -- Need N","paragraph_zero_based":45249},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16              SL-SyncConfigList-r16                                           OPTIONAL,  -- Need M","paragraph_zero_based":45250},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16                ENUMERATED {gnss, gnbEnb}                                       OPTIONAL   -- Need M","paragraph_zero_based":45251},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45252},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45253},{"literal_text_all_w_t_and_m_t":"SL-Freq-Id-r16 ::=                     INTEGER (1.. maxNrofFreqSL-r16)","paragraph_zero_based":45254},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45255},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigExt-v1800 ::=             SEQUENCE {","paragraph_zero_based":45256},{"literal_text_all_w_t_and_m_t":"    absenceOfAnyOtherTechnology-r18        ENUMERATED {true}                                           OPTIONAL,  -- Need M","paragraph_zero_based":45257},{"literal_text_all_w_t_and_m_t":"    sl-FreqSelectionConfig-r18             SL-FreqSelectionConfig-r18                                  OPTIONAL,  -- Need M","paragraph_zero_based":45258},{"literal_text_all_w_t_and_m_t":"    sl-SyncTxDisabled-r18                  ENUMERATED {true}                                           OPTIONAL,  -- Need M","paragraph_zero_based":45259},{"literal_text_all_w_t_and_m_t":"    sl-EnergyDetectionConfig-r18           CHOICE {","paragraph_zero_based":45260},{"literal_text_all_w_t_and_m_t":"        sl-MaxEnergyDetectionThreshold-r18     INTEGER (-85..-52),","paragraph_zero_based":45261},{"literal_text_all_w_t_and_m_t":"        sl-EnergyDetectionThresholdOffset-r18  INTEGER (-13..20)","paragraph_zero_based":45262},{"literal_text_all_w_t_and_m_t":"    }                                                                                                      OPTIONAL,  -- Need M","paragraph_zero_based":45263}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["cfda39dcfd557f16f6f7