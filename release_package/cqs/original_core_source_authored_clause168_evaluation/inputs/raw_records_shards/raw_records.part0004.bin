{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40032},{"literal_text_all_w_t_and_m_t":"FreqBandInformationNR ::=       SEQUENCE {","paragraph_zero_based":40033},{"literal_text_all_w_t_and_m_t":"    bandNR                          FreqBandIndicatorNR,","paragraph_zero_based":40034},{"literal_text_all_w_t_and_m_t":"    maxBandwidthRequestedDL         AggregatedBandwidth                     OPTIONAL,   -- Need N","paragraph_zero_based":40035},{"literal_text_all_w_t_and_m_t":"    maxBandwidthRequestedUL         AggregatedBandwidth                     OPTIONAL,   -- Need N","paragraph_zero_based":40036},{"literal_text_all_w_t_and_m_t":"    maxCarriersRequestedDL          INTEGER (1..maxNrofServingCells)        OPTIONAL,   -- Need N","paragraph_zero_based":40037},{"literal_text_all_w_t_and_m_t":"    maxCarriersRequestedUL          INTEGER (1..maxNrofServingCells)        OPTIONAL    -- Need N","paragraph_zero_based":40038},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":40039},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40040},{"literal_text_all_w_t_and_m_t":"AggregatedBandwidth ::=         ENUMERATED {mhz50, mhz100, mhz150, mhz200, mhz250, mhz300, mhz350,","paragraph_zero_based":40041},{"literal_text_all_w_t_and_m_t":"                                            mhz400, mhz450, mhz500, mhz550, mhz600, mhz650, mhz700, mhz750, mhz800}","paragraph_zero_based":40042},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40043},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQBANDLIST-STOP","paragraph_zero_based":40044},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":40045},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40046},{"literal_text_all_w_t_and_m_t":"–FreqSeparationClass","paragraph_zero_based":40047},{"literal_text_all_w_t_and_m_t":"The IE FreqSeparationClass is used for an intra-band non-contiguous CA band combination to indicate frequency separation between lower edge of lowest CC and upper edge of highest CC in a frequency band.","paragraph_zero_based":40048},{"literal_text_all_w_t_and_m_t":"FreqSeparationClass information element","paragraph_zero_based":40049},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":40050},{"literal_text_all_w_t_and_m_t":"-- TAG-FREQSEPARATIONCLASS-START","paragraph_zero_based":40051},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40052},{"literal_text_all_w_t_and_m_t":"FreqSeparationClass ::= ENUMERATED { mhz800, mhz1200, mhz1400, ..., mhz400-v1650, mhz600-v1650}","paragraph_zero_based":40053},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":40054},{"literal_text_all_w_t_and_m_t":"FreqSeparationClassDL-v1620 ::= ENUMERATED {mhz1000, mhz1600, mhz1800, mhz2000, mhz2200, mhz2400}","paragraph_zero_based":40055}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f5926942139038d7d84a5a60e97c00c15c44163260ca802b4ee9194bb166c6ae","bd9777535a8be331108a42d6a3eb2c8a87aecc839f264b4861f5ba2dcfbbe169","ee23171f35f07f77e3b2e5d5a96cb1a076a89c56eb604d0a56bc7c1181d5802e","e65e61fe9cf777acd69ce6d298ee6b588c87d27afa6117197d64c0a3bdb87d93","cc1905bcb5c28faee0d7866dd8281e22e6b3c2570069461d2b821379b987d698","abc28c7c66a706e062e060f9da86f76cea9884aca1573fa5e4b8e84b28ea87b4","ab2703be96b5bffeec1dd9455b83067d7e210093432ba27b3e3e29a926dbbc4e","37fd50af7ed5d17e09aac9ef49f6f692dac3a0d4478e9ddcf62d634424f5e23e","a6fe6920169db3338a47c81e0184270f585d30fdef9b14959d0f6d52239558f0","cfeb9c186c93a984662b5315385239421582aa330adf01868d3a742c0702ee2e","5d8dac880