{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"tciMapping","paragraph_zero_based":30960},{"literal_text_all_w_t_and_m_t":"Enables TCI state mapping method to PDSCH transmission occasions.","paragraph_zero_based":30961},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30962},{"literal_text_all_w_t_and_m_t":"–ReportConfigId","paragraph_zero_based":30963},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigId is used to identify a measurement reporting configuration.","paragraph_zero_based":30964},{"literal_text_all_w_t_and_m_t":"ReportConfigId information element","paragraph_zero_based":30965},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30966},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-START","paragraph_zero_based":30967},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30968},{"literal_text_all_w_t_and_m_t":"ReportConfigId ::=                          INTEGER (1..maxReportConfigId)","paragraph_zero_based":30969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30970},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGID-STOP","paragraph_zero_based":30971},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30973},{"literal_text_all_w_t_and_m_t":"–ReportConfigInterRAT","paragraph_zero_based":30974},{"literal_text_all_w_t_and_m_t":"The IE ReportConfigInterRAT specifies criteria for triggering of an inter-RAT measurement reporting event, or an L2 U2N relay measurement reporting event. The inter-RAT measurement reporting events for E-UTRA and UTRA-FDD are labelled BN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled YN with N equal to 1, 2 and so on. The measurement reporting events for L2 U2N relay UE are labelled Z1.","paragraph_zero_based":30975},{"literal_text_all_w_t_and_m_t":"Event B1:Neighbour becomes better than absolute threshold;","paragraph_zero_based":30976},{"literal_text_all_w_t_and_m_t":"Event B2:PCell becomes worse than absolute threshold1 AND Neighbour becomes better than another absolute threshold2;","paragraph_zero_based":30977},{"literal_text_all_w_t_and_m_t":"Event Y1: PCell becomes worse than absolute threshold1 AND candidate L2 U2N Relay UE becomes better than another absolute threshold2;","paragraph_zero_based":30978},{"literal_text_all_w_t_and_m_t":"Event Y2: Candidate L2 U2N Relay UE becomes better than absolute threshold;","paragraph_zero_based":30979},{"literal_text_all_w_t_and_m_t":"Event Z1: Serving L2 U2N Relay UE becomes worse than absolute threshold1 AND candidate L2 U2N Relay UE becomes better than another absolute threshold2;","paragraph_zero_based":30980},{"literal_text_all_w_t_and_m_t":"ReportConfigInterRAT information element","paragraph_zero_based":30981},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30982},{"literal_text_all_w_t_and_m_t":"-- TAG-REPORTCONFIGINTERRAT-START","paragraph_zero_based":30983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["3953a27b5778ca5a77fdd24701e73ccdb262cc80b257647b491d360c5443cdbc","3f2ee9da6554ebe35c392f138c0ba7125c4dc39db8bd0e22e8543279d064a189","3175c2d405cd637cac312a668abeb8bf6b38592c90fa13fab70545ffceaea207","0cf1852d009d8f56a25d51326c6a148b5bccd810957fac1abc70e2b399788c1e","a2af254277a35de4bdc40a7b50f15ae4a35d71c473f8b6166e09ff5baa735eeb","9dd81eda7ddef5dc9245d753891d7ce3ef20252335fbaba86b9a75b0804006ed","1ff80ecae82d9faa32cdc84006eb6a1cc39a95d8a56b764a4de08dc1f1a5c0b4","0990813188a726d057c6db9d3a6bc945d