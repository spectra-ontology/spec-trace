{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":47304},{"literal_text_all_w_t_and_m_t":"L2RelayUE","paragraph_zero_based":47305},{"literal_text_all_w_t_and_m_t":"For L2 U2N Relay UE, the field is optionally present, Need M. Otherwise, it is absent.","paragraph_zero_based":47306},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47307},{"literal_text_all_w_t_and_m_t":"–SL-SRAP-ConfigU2U","paragraph_zero_based":47308},{"literal_text_all_w_t_and_m_t":"The IE SL-SRAP-ConfigU2U is used to set the configurable SRAP parameters used by L2 U2U Relay UE and L2 U2U Remote UE as specified in TS 38.351 [66].","paragraph_zero_based":47309},{"literal_text_all_w_t_and_m_t":"SL-SRAP-ConfigU2U information element","paragraph_zero_based":47310},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47311},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-SRAP-CONFIGU2U-START","paragraph_zero_based":47312},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47313},{"literal_text_all_w_t_and_m_t":"SL-SRAP-ConfigU2U-r18 ::=               SEQUENCE {","paragraph_zero_based":47314},{"literal_text_all_w_t_and_m_t":"    sl-MappingToAddMod-U2U-List-r18         SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SL-MappingToAddMod-U2U-r18     OPTIONAL, -- Need N","paragraph_zero_based":47315},{"literal_text_all_w_t_and_m_t":"    sl-MappingToRelease-U2U-List-r18        SEQUENCE (SIZE (1..maxSL-LCID-r16)) OF SLRB-Uu-ConfigIndex-r16        OPTIONAL  -- Need N","paragraph_zero_based":47316},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47317},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47318},{"literal_text_all_w_t_and_m_t":"SL-MappingToAddMod-U2U-r18 ::=          SEQUENCE {","paragraph_zero_based":47319},{"literal_text_all_w_t_and_m_t":"    sl-RemoteUE-SLRB-Identity-r18           SLRB-Uu-Confi