{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"cag-Identity","paragraph_zero_based":26736},{"literal_text_all_w_t_and_m_t":"A CAG-ID as specified in TS 23.003 [21]. The PLMN ID and a CAG ID in the NPN-Identity identifies a PNI-NPN.","paragraph_zero_based":26737},{"literal_text_all_w_t_and_m_t":"cag-IdentityList","paragraph_zero_based":26738},{"literal_text_all_w_t_and_m_t":"The cag-IdentityList contains one or more CAG IDs. All CAG IDs associated to the same PLMN ID are listed in the same cag-IdentityList entry.","paragraph_zero_based":26739},{"literal_text_all_w_t_and_m_t":"manualCAGselectionAllowed","paragraph_zero_based":26740},{"literal_text_all_w_t_and_m_t":"The manualCAGselectionAllowed indicates that the CAG ID can be selected manually even if it is outside the UE's allowed CAG list.","paragraph_zero_based":26741},{"literal_text_all_w_t_and_m_t":"NID","paragraph_zero_based":26742},{"literal_text_all_w_t_and_m_t":"A NID as specified in TS 23.003 [21]. The PLMN ID and a NID in the NPN-Identity identifies a SNPN.","paragraph_zero_based":26743},{"literal_text_all_w_t_and_m_t":"nid-List","paragraph_zero_based":26744},{"literal_text_all_w_t_and_m_t":"The nid-List contains one or more NID.","paragraph_zero_based":26745},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26746},{"literal_text_all_w_t_and_m_t":"–NPN-IdentityInfoList","paragraph_zero_based":26747},{"literal_text_all_w_t_and_m_t":"The IE NPN-IdentityInfoList includes a list of NPN identity information.","paragraph_zero_based":26748},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList information element","paragraph_zero_based":26749},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26750},{"literal_text_all_w_t_and_m_t":"-- TAG-NPN-IDENTITYINFOLIST-START","paragraph_zero_based":26751},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26752},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfoList-r16 ::=     SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-IdentityInfo-r16","paragraph_zero_based":26753},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26755},{"literal_text_all_w_t_and_m_t":"NPN-IdentityInfo-r16 ::=         SEQUENCE {","paragraph_zero_based":26756},{"literal_text_all_w_t_and_m_t":"    npn-IdentityList-r16             SEQUENCE (SIZE (1..maxNPN-r16)) OF NPN-Identity-r16,","paragraph_zero_based":26757},{"literal_text_all_w_t_and_m_t":"    trackingAreaCode-r16             TrackingAreaCode,","paragraph_zero_based":26758},{"literal_text_all_w_t_and_m_t":"    ranac-r16                        RAN-AreaCode                                                OPTIONAL,       -- Need R","paragraph_zero_based":26759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["298209200140c08c47d9fe2e875de1b56d003a57ef234d2c30ce6a07adec6a1b","5e6736aeb8c2536ffd9ea0ee2d5c8cbca4f04c982efc4c2136133d3f7d671275","c650fc0859b2e17aecb473d567200a6e35da581a70e86f34d62dc7b68097161e","29bb8d7b77fc775e44b02cfd80af4f3a1d7f22c204d815ab58f060065f5ddec9","c1116e7be54be9e44f4af8f8e16a78868f52693d69d16bfe007c94634bfa851f","320500b7e762f368254d732b1b2d3cc2f998208af9cd4e3b5e68528016ddfa44","03e662a440f8df4aacb19b5593d96c5d04cb8f06bacdf3cbcf8a23fa6a179977","600e872a8b1371f6ef27c1ddec4e06a9627e628724a3b1316db67ea5cefe974b","4404c3a809623dfc3d4f4dfd48343e4294c4905e4e363954fed6e080ae577ec6","d052507bcbd3898eb9ab11888b3155bfac13f2f4052e8cd73347c326a516feeb","e398559457d963c617513829e72b97a1a89f1c526fbe66debf1280840f051d2c","1dbf187a7d03c4bbf3b3f132