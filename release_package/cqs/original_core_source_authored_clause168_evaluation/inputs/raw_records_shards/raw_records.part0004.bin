{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33792},{"literal_text_all_w_t_and_m_t":"DormantBWP-Config field descriptions","paragraph_zero_based":33793},{"literal_text_all_w_t_and_m_t":"dormancyGroupWithinActiveTime","paragraph_zero_based":33794},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy within active time, to which this SCell belongs. The use of the Dormancy within active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":33795},{"literal_text_all_w_t_and_m_t":"dormancyGroupOutsideActiveTime","paragraph_zero_based":33796},{"literal_text_all_w_t_and_m_t":"This field contains the ID of an SCell group for Dormancy outside active time, to which this SCell belongs. The use of the Dormancy outside active time for SCell groups is specified in TS 38.213 [13].","paragraph_zero_based":33797},{"literal_text_all_w_t_and_m_t":"dormantBWP-Id","paragraph_zero_based":33798},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be used as dormant BWP. If this field is configured, its value is different from defaultDownlinkBWP-Id, and at least one of the withinActiveTimeConfig and outsideActiveTimeConfig should be configured.","paragraph_zero_based":33799},{"literal_text_all_w_t_and_m_t":"firstOutsideActiveTimeBWP-Id","paragraph_zero_based":33800},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy outside active time.","paragraph_zero_based":33801},{"literal_text_all_w_t_and_m_t":"firstWithinActiveTimeBWP-Id","paragraph_zero_based":33802},{"literal_text_all_w_t_and_m_t":"This field contains the ID of the downlink bandwidth part to be activated when receiving a DCI indication for SCell dormancy within active time.","paragraph_zero_based":33803},{"literal_text_all_w_t_and_m_t":"outsideActiveTimeConfig","paragraph_zero_based":33804},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy outside active time, as specified in TS 38.213 [13]. The field can only be configured when the cell group the SCell belongs to is configured with dcp-Config.","paragraph_zero_based":33805},{"literal_text_all_w_t_and_m_t":"withinActiveTimeConfig","paragraph_zero_based":33806},{"literal_text_all_w_t_and_m_t":"This field contains the configuration to be used for SCell dormancy within active time, as specified in TS 38.213 [13]. ","paragraph_zero_based":33807},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33808},{"literal_text_all_w_t_and_m_t":"GuardBand field descriptions","paragraph_zero_based":33809},{"literal_text_all_w_t_and_m_t":"startCRB","paragraph_zero_based":33810},{"literal_text_all_w_t_and_m_t":"Indicates the starting RB of the guard band.","paragraph_zero_based":33811},{"literal_text_all_w_t_and_m_t":"nrofCRB","paragraph_zero_based":33812},{"literal_text_all_w_t_and_m_t":"Indicates the length of the guard band in RBs. When set to 0, zero-size guard band is used.","paragraph_zero_based":33813},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33814},{"literal_text_all_w_t_and_m_t":"MC-DCI-SetOfCells field descriptions","paragraph_zero_based":33815}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["aa7c7af5d56d305e42f3698ad30fb6bb618419cd68c6a77f65a49448ef51007d","c1e862fb2becb217c6966cc19821fd426598c83cfa1448e0e764cbfd6bb9b703","182d9c3ef991aa2e6dbdacb0ef63c68add982e83e8d192a749cf9cd0d626d2bf","dd4010b93872462e465834b7d87611fb3ebad566ec775bafd5580e4acfb19e7f","217bbd14dfcb7960743b79505648d77351b39f0a1c193ea5a3699326c950bc2d","6c75a20b7357e35f9853c1cdd092245ae9b431751af178d1931e606dd8669e28","9861ef361f0575187ffec0176f4fac82f1bbb483c4a2a8d3931d9fba8a086d02","ab7d17c1011a63084ca9c8d56ee855bc5fc3fbbc03fbeb5ecee768491a7d41b5","347397d8f76346071450b3d21139f343db3900c72990510d6b5c9fba989fc7ab","ea0473c452b3b55d2af3d005b130d1a0b83f333b7367e9ca259ac4aec74c033b","b477cc4ea2e30d786a3abead0645d0cf0aa1ebd85ee4883662a55443e46a200d","a9685751cac8b6b16aaf9964506dc8153b8b9c3fa399ddd61b86c5abafd80095","98959a329252459c343a5c904630b84f440f889350360cb7ef5212bd3f8135ad","1bced2b5d504b8619aa28594a1e8e28ea56f5ba36b05221de72318ffa3db5747","92b67cab56e83bb6f4de5537809b773656c8712a267ed09de1cfbaa8075cf737","0ed2e94e3070d03c19031b0a2b9b169494c8605f2acb95414d8699f69b615ff8","26d5d1f6752486344a81009ba074a983e5466c05e5664524309d3ee1bc98eea6","2d9c0c07016cb06f6af669f7c24567ad03a4d0dce2671c90862147f58ad07b50","5da452ed56faae7ecbec1d0234e948ecb716f74e461ab3fd3e00d2ae5d01011d","aa6134a0ab0e708f657f0e9fb4dc6d5d29380c93fea6f36d56d32dd541e927f5","d45ef51da4830c2a5af1f37960e1cbbdd1c9b8478161f7ecefffd081b85ede2e","5cb7fbe0aa02d81191f853053e813b38ba4a7da937114ae5c92627a0b254f5ab","e632438f619f7656e261ad2145e9a0c741f271807a10c98512727e1898e47646","dcd43fa9a3886bffdafae18d036d6017503910bd52d4695efbb160384a20485c"],"paragraph_range_zero_based":[33792,33815],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33792"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"antennaPortsDCI1-3, antennaPortsDCI0-3","paragraph_zero_based":33816},{"literal_text_all_w_t_and_m_t":"Configure the indication type for antenna port(s) field in DCI format 1_3 and DCI format 0_3, respectively (see TS 38.212, clauses 7.3.1.2.4 and 7.3.1.1.4).","paragraph_zero_based":33817},{"literal_text_all_w_t_and_m_t":"dormancyDCI-1-3, dormancyDCI-0-3","paragraph_zero_based":33818},{"literal_text_all_w_t_and_m_t":"Configure the presence of Scell dormancy indication field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33819},{"literal_text_all_w_t_and_m_t":"minimumSchedulingOffsetK0DCI-1-3, minimumSchedulingOffsetK0DCI-0-3","paragraph_zero_based":33820},{"literal_text_all_w_t_and_m_t":"Configure the presence of minimum applicable scheduling offset indicator field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33821},{"literal_text_all_w_t_and_m_t":"nCI-Value","paragraph_zero_based":33822},{"literal_text_all_w_t_and_m_t":"Configure n_CI value used for the set of cells, where unique n_CI value is configured for each set of cells.","paragraph_zero_based":33823},{"literal_text_all_w_t_and_m_t":"pdcchMonAdaptDCI-1-3, pdcchMonAdaptDCI-0-3","paragraph_zero_based":33824},{"literal_text_all_w_t_and_m_t":"Configure the presence of PDCCH monitoring adaptation indication field in DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33825},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-enhType3DCI-1-3","paragraph_zero_based":33826},{"literal_text_all_w_t_and_m_t":"Enable the enhanced Type 3 HARQ-ACK codebook triggering using DCI format 1_3.","paragraph_zero_based":33827},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-enhType3DCIfieldDCI-1-3","paragraph_zero_based":33828},{"literal_text_all_w_t_and_m_t":"Enables the enhanced Type 3 CB through a new DCI field to indicate the enhanced Type 3 HARQ-ACK codebook in DCI format 1_3 if the more than one enhanced Type HARQ-ACK codebook is configured for the primary PUCCH cell group.","paragraph_zero_based":33829},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-OneShotFeedbackDCI-1-3","paragraph_zero_based":33830},{"literal_text_all_w_t_and_m_t":"When configured, the DCI_format 1_3 can request the UE to report A/N for all HARQ processes and all CCs configured in the PUCCH group.","paragraph_zero_based":33831},{"literal_text_all_w_t_and_m_t":"pdsch-HARQ-ACK-retxDCI-1-3","paragraph_zero_based":33832},{"literal_text_all_w_t_and_m_t":"When configured, the DCI format 1_3 can request the UE to perform a HARQ-ACK re-transmission on a PUCCH resource (see TS 38.213 [13], clause 9.1.5).","paragraph_zero_based":33833},{"literal_text_all_w_t_and_m_t":"priorityIndicatorDCI-1-3, priorityIndicatorDCI-0-3","paragraph_zero_based":33834},{"literal_text_all_w_t_and_m_t":"Configure the presence of priority indicator field in DCI format 1_3 and DCI format 0_3, respectively (see TS 38.212 [17], clauses 7.3.1.2.4 and 7.3.1.1.4 and TS 38.213 [13] clause 9).","paragraph_zero_based":33835},{"literal_text_all_w_t_and_m_t":"pucch-sSCellDynDCI-1-3","paragraph_zero_based":33836},{"literal_text_all_w_t_and_m_t":"Configure the UE with PUCCH cell switching based on dynamic indication in DCI format 1_3 (see TS 38.213 [13], clause 9.A).","paragraph_zero_based":33837},{"literal_text_all_w_t_and_m_t":"RateMatchDCI-1-3","paragraph_zero_based":33838},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint rate matching indication table for DL scheduling via DCI format 1_3, where bitmap for a cell points to a corresponding rate matching indication applicable for DCI format 1-1 (i.e., MSB and LSB of bitmap refer rateMatchPatternGroup1 and rateMatchPatternGroup2 for a cell, respectively), the order of rate matching indication bitmap in each row refers the order of cells in ScheduledCell-ListDCI-1-3, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP (i.e., first bitmap is for the first cell in ScheduledCell-ListDCI-1-X, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP and so on), the number of entries in a row of rateMatchDCI-1-3 should be the same as the number of cells, that are configured with rateMatchPatternGroup1 or rateMatchPatternGroup2 on at least one DL BWP, included in ScheduledCell-ListDCI-1-3, and entries for co-scheduled cells in a row of rateMatchDCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33839}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3d1537b4ddb5e7aaabc7249e6c683d32c68bd0cde8d6c4c9a88452f34d016ecf","445c47f246bc264abd930aa1805c5cafe78f7efacb22cdd75c5dca9e29f73aa5","d26fa4b8b03534cecea1dfbc487f9484ca8e38a67e6c4d5b8a6e614fec8f082d","16b221f599c7030f451536081125a91d8f0e0541b09647c294c701e1a4bde4bc","c6912dddcf5f5382a8ac52ec8445bcce681b5561a32c8288c5c7b4fb6330ae36","df7b36f553ebe83a0a8b9ebfebfcf67b778b307780b99d2b5eb525c0d05e7419","e2837392c89501f6d706ca2276d4c78c02822328f0b1d223ae3d6805018e2f5a","7c0b6baf47b307d3b6cdf3da8abd3916928a4572735d9bf8e0502b050c8b2a04","ccf9345b6e6d2c4388e308cb2e48565854548d83e95547a26e190b4b1fef0021","79237bed5fd3276099a41fb6100fe4d8d1792d5f29fd119b8002b4dd8a9d1e50","d3cf9b3b518e8213e7547955dc1da80f361f628569707f1cd57a75a7bbe89f10","bd09a29a9fd9947707ce04694adbdf5ead8f6fbbef3a4f5ddeb1e9bce849a02b","40d48371a3b0221ccf64a0a76a2e744698d32f49db9190f423b7ecb0b68233d4","d796c7717e844ff6a3626954b7c0654344ebb4b6fd2b97381dee6b878940275b","e5253d2e8365ac1f21050fe649c6cec4241ff8f200af1c85eaa19100146b3912","dce6dcc02d9d37b91bcd0a5493ef50e56db5dba68aa91e7cc672399129e738c0","e68cfc6d5b8d2e9192cde0bab311505a5c449b38f40d45635db6217402947036","9363e78f8e0729b59e73941ccb8c523f1f812e2e053674276c244ed352d778c9","ded907070f0caa509fdc2dffbd618f9933cbaaec18c4214ac4e9ef4888f865d9","0787624e093aff2940256e4149c6551b41b8a09fd827365db9cbb50ed90b4b84","6300a6dec6c3a1e630ab91fed8c3969ab3b6d4aadcc029716f5ad6094d8d289e","279c433975f6d434141cb343dae0235963e132baeccf331a103faf2e30c4bea8","db0fadd4334fd831faa784fa8453fc96f3c1b0acda2ecb40de8f5406a66738d6","ffedb12ff62fc284d6d5508c91aa79a3d1eb260ba300a8c6a7a5fde111be355e"],"paragraph_range_zero_based":[33816,33839],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33816"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"rateMatchListDCI-1-3","paragraph_zero_based":33840},{"literal_text_all_w_t_and_m_t":"Configure joint rate matching indication table for DL scheduling via DCI format 1_3.","paragraph_zero_based":33841},{"literal_text_all_w_t_and_m_t":"ScheduledCellCombo","paragraph_zero_based":33842},{"literal_text_all_w_t_and_m_t":"Configure each row of the table for combinations of co-scheduled cells for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index with value INTEGER (0...3) of co-scheduled cell refers to scheduledCellListDCI-1-3 for DL and scheduledCellListDCI-0-3 for UL.","paragraph_zero_based":33843},{"literal_text_all_w_t_and_m_t":"scheduledCellComboListDCI-1-3, scheduledCellComboListDCI-0-3","paragraph_zero_based":33844},{"literal_text_all_w_t_and_m_t":"Configure the table for combinations of co-scheduled cells for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33845},{"literal_text_all_w_t_and_m_t":"scheduledCellListDCI-1-3, scheduledCellListDCI-0-3","paragraph_zero_based":33846},{"literal_text_all_w_t_and_m_t":"Configure the list of possible co-scheduled cells in the set for DL scheduling via DCI format 1_3 and DCI format 0_3 respectively, where the serving cells in the list are in ascending order of serving cell indices and are mapped to index {0, 1, 2, 3} in the set. Total number of cells within the same set of cells i.e., in scheduledCellListDCI-1-3 and scheduledCellListDCI-0-3, is up to 4.","paragraph_zero_based":33847},{"literal_text_all_w_t_and_m_t":"When a cell is included in either or both of scheduledCellListDCI-1-3 or scheduledCellListDCI-0-3 for one set of cells MC-DCI-SetofCells, the cell cannot be included in any of scheduledCellListDCI-1-3 or scheduledCellListDCI-0-3 for any other set of cells.","paragraph_zero_based":33848},{"literal_text_all_w_t_and_m_t":"setOfCellsId","paragraph_zero_based":33849},{"literal_text_all_w_t_and_m_t":"Configure index of the set of cells to be indicated in DCI format 0_3/1_3.","paragraph_zero_based":33850},{"literal_text_all_w_t_and_m_t":"sri-DCI0-3","paragraph_zero_based":33851},{"literal_text_all_w_t_and_m_t":"Configure the indication type for SRS resource indicator field in DCI format 0_3 (See TS 38.212, clause 7.3.1.1.4).","paragraph_zero_based":33852},{"literal_text_all_w_t_and_m_t":"SRS-OffsetCombo","paragraph_zero_based":33853},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint SRS offset indicator table for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index for a cell points to a corresponding SRS offset indicator applicable for DCI format 1-1 and 0-1, and the order of SRS offset indicator index in each row refers the order of cells in scheduledCell-ListDCI-1-3 (i.e., first index is for the first cell in scheduledCellListDCI-1-3, that are configured with more than one entry in availableSlotOffsetList for at least one aperiodic SRS resource set on at least one UL BWP and so on) for DL and scheduledCellListDCI-0-3 for UL, included in scheduledCellListDCI-1-3 for srs-OffsetListDCI-1-3 and scheduledCellListDCI-0-3 for srs-OffsetListDCI-0-3, and entries for co-scheduled cells in a row of SRS-OffsetCombo are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3/0_3.","paragraph_zero_based":33854},{"literal_text_all_w_t_and_m_t":"srs-OffsetListDCI-1-3, srs-OffsetListDCI-0-3","paragraph_zero_based":33855},{"literal_text_all_w_t_and_m_t":"Configure joint SRS offset indicator table for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33856},{"literal_text_all_w_t_and_m_t":"SRS-RequestCombo","paragraph_zero_based":33857},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint SRS request table for DL scheduling via DCI format 1_3 and for UL scheduling via DCI format 0_3, where index for a cell points to a corresponding SRS request applicable for DCI format 1-1 and 0-1, and the order of SRS request index in each row refers the order of cells in scheduledCellListDCI-1-3 (i.e., first index is for the first cell in scheduledCellListDCI-1-3 and so on) for DL and scheduledCellListDCI-0-3 for UL. The number of entries in a row of SRS-RequestCombo should be the same as the number of cells included in scheduledCellListDCI-1-3 for srs-RequestListDCI-1-3 and scheduledCellListDCI-0-3 for srs-RequestListDCI-0-3, and entries for co-scheduled cells in a row of SRS-RequestCombo are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3/0_3.","paragraph_zero_based":33858},{"literal_text_all_w_t_and_m_t":"srs-RequestListDCI-1-3, srs-RequestListDCI-0-3","paragraph_zero_based":33859},{"literal_text_all_w_t_and_m_t":"Configure joint SRS request table for DL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33860},{"literal_text_all_w_t_and_m_t":"TCI-DCI-1-3","paragraph_zero_based":33861},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TCI table for DL scheduling via DCI format 1_3, where index for a cell points to a corresponding TCI applicable for DCI format 1-1, and the order of TCI index in each row refers the order of cells in scheduledCellListDCI-1-3 (i.e., first index is for the first cell in scheduledCellListDCI-1-3 that configured with tci-StatesToAddModList and so on), the number of entries in a row of TCI-DCI-1-3 should be the same as the number of cells that configured with tci-StatesToAddModList on at least one DL BWP, included in scheduledCellListDCI-1-3, and entries for co-scheduled cells in a row of TCI-DCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33862},{"literal_text_all_w_t_and_m_t":"tci-ListDCI-1-3","paragraph_zero_based":33863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["00385bdbd851adb90034f7b59046b38cec9265a17fe2b42abf631b3d8f443fdc","cb585ceb32e3e9e9ac082465ed4c8a735d56aee088e704608e2ba63593fe2dea","2433327bb900a0912d0554f5083fdc5118dd7f712d83162b0f6d05fb2c545334","e35b614923788d5539769f4e64bb3bbe9dcefba120f831f31d05614825c2bd1d","2f12c3cb4ab5f5ee1c205e8d6c82fd59a54ef78638725553b6897c2308fe848b","20a4791e4c10ea1ec20a9c733b38422a121c0fb8a2924cd441f6be4a9680a389","8e58a1bb3599386badf50f354625165af769def263e7493f5454e51405ac088d","b0231bf2b59be6aabbf24fcd53a3cb354ff1174a3e41d6a95bd071f256be1f18","706458f6a616153342e34d485943c4fa1d5aa9b8a58689d3e39e37dc1b186725","05d9a38df2609ff4476b93958467e411647d505dd638188ffec03f5d009f7bc0","d2a1629cdb5dbe786b70ced9a2289e8dd81ee400f9d595baf59cbb03e9d9f3de","f2310154a7aa1078607c955f84702982e9f91e2576dac6fa762f070ae31a6cf0","2c4ffd7e6f545be1fe0eb656a6ebfe6f4d1c1dbd05846ca66540089ba2c39a7a","ecb7e61bea2a430422d77f9f435d8296a0f5fff8f49f9490d91883571c69c047","7c50b9fe6b2e63c44999102b77489962f1e5eafbd67384421f4c25af8560e440","82e751881426e5da4788ca17de8eb68bafb34daf162b1f370101eec6324d2415","3c189d4c18ea30feed51c4ba42750e39ae8caadf4d24b1ea6a8fb7e2df164409","e873a6a55e5062e1ac8ab7f80c89052af1e8c57eecd366f5a0009c7d8ed905cc","e38ffdeea238000927f229295957d86c4ba238386fd788e06056b2eb30d45d13","60429747abddcd9f933f4480dd95aa84031ae0f4f3ae1a4514101f0893363bd1","3f508bf99a5fe0f75ecc348e9862775096f8c0e893cac0692d3815a042583c50","fa2597f5d663fb7e3f3cebde491deb05689690b8bd4fe6e016e54f5db379ad0e","4114bcc16ab0dace72885dc462eb84f891de1e69695733257aef00c69a3f69b9","4eaa7a5c25fe55ee5ad8884f371d24103301c7e787f1673e2cb0138c1988d025"],"paragraph_range_zero_based":[33840,33863],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33840"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Configure joint TCI table for DL scheduling via DCI format 1_3","paragraph_zero_based":33864},{"literal_text_all_w_t_and_m_t":"TDRA-FieldIndexDC-0-3","paragraph_zero_based":33865},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TDRA field table for UL scheduling via DCI format 0_3 containing the applicable TDRA field indexes for multiple BWPs/cells, where the TDRA index for a BWP of a cell points to a corresponding TDRA in the TDRA table applicable for DCI format 0-1, the order of TDRA index in each row refers the BWP-Id for a cell and the order of cells in scheduledCellListDCI-0-3 (i.e., first TDRA index in a row is for the smallest BWP-Id that can be scheduled by the DCI format 0-3, as specified in 38.212, of the first cell in scheduledCellListDCI-0-3, second TDRA index in a row is for the second smallest BWP-Id 1 that can be scheduled by the DCI format 0-3, as specified in 38.212, of the first cell and so on), and the number of TDRA indices in a row of TDRA-FieldIndexDCI-0-3 should be the same as the total number of BWPs that can be scheduled by the DCI format 0-3, as specified in 38.212, across cells included in scheduledCellListDCI-0-3.","paragraph_zero_based":33866},{"literal_text_all_w_t_and_m_t":"TDRA-FieldIndexDCI-1-3","paragraph_zero_based":33867},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint TDRA field table for DL scheduling via DCI format 1_3 containing the applicable TDRA field indexes for multiple BWPs/cells, where the TDRA index for a BWP of a cell points to a corresponding TDRA in the TDRA table applicable for DCI format 1-1, the order of TDRA index in each row refers the BWP-Id for a cell and the order of cells in scheduledCellListDCI-1-3 (i.e., first TDRA index in a row is for the smallest BWP-Id that can be scheduled by the DCI format 1-3, as specified in 38.212, of the first cell in scheduledCellListDCI-1-3, second TDRA index in a row is for the second smallest BWP-Id that can be scheduled by the DCI format 1-3, as specified in 38.212, of the first cell and so on ), and the number of TDRA indices in a row of TDRA-FieldIndexDCI-1-3 should be the same as the total number of BWPs that can be scheduled by the DCI format 1-3, as specified in 38.212, across cells included in scheduledCellListDCI-1-3.","paragraph_zero_based":33868},{"literal_text_all_w_t_and_m_t":"tdra-FieldIndexListDCI-1-3, tdra-FieldIndexListDCI-0-3","paragraph_zero_based":33869},{"literal_text_all_w_t_and_m_t":"Configure joint TDRA table for UL scheduling via DCI format 1_3 and DCI format 0_3, respectively.","paragraph_zero_based":33870},{"literal_text_all_w_t_and_m_t":"tpmi-DCI0-3","paragraph_zero_based":33871},{"literal_text_all_w_t_and_m_t":"Configure the indication type for precoding information and number of layers field in DCI format 0_3 (See TS 38.212, clause 7.3.1.1.4).","paragraph_zero_based":33872},{"literal_text_all_w_t_and_m_t":"ZP-CSI-DCI-1-3","paragraph_zero_based":33873},{"literal_text_all_w_t_and_m_t":"Configure each row of the joint ZP-CSI-RS trigger table for DL scheduling via DCI format 1_3, where index for a cell points to a corresponding ZP-CSI-RS trigger applicable for DCI format 1-1, and the order of ZP-CSI-RS trigger index in each row refers the order of cells in scheduledCellListDCI-1-3 (i.e., first index is for the first cell in scheduledCellListDCI-1-3, that are configured with aperiodic-ZP-CSI-RS-ResourceSetsToAddModList on at least one DL BWP and so on), the number of entries in a row of ZP-CSI-DCI-1-3 should be the same as the number of cells, that are configured with aperiodic-ZP-CSI-RS-ResourceSetsToAddModList on at least one DL BWP, included in scheduledCellListDCI-1-3, and entries for co-scheduled cells in a row of ZP-CSI-DCI-1-3 are interpreted based on the BWPs of co-scheduled cells that is determined by the BWP indicator field of DCI format 1_3.","paragraph_zero_based":33874},{"literal_text_all_w_t_and_m_t":"zp-CSI-RSListDCI-1-3","paragraph_zero_based":33875},{"literal_text_all_w_t_and_m_t":"Configure joint ZP-CSI-RS trigger table for DL scheduling via DCI format 1_3.","paragraph_zero_based":33876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33877},{"literal_text_all_w_t_and_m_t":"NOTE 1:If the dedicated part of initial UL/DL BWP configuration is absent, the initial BWP can be used but with some limitations. For example, changing to another BWP requires RRCReconfiguration since DCI format 1_0 doesn't support DCI-based switching.","paragraph_zero_based":33878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33879},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":33880},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":33881},{"literal_text_all_w_t_and_m_t":"AsyncCA","paragraph_zero_based":33882},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for SCells whose slot offset between the SpCell is not 0. Otherwise it is absent, Need S.","paragraph_zero_based":33883},{"literal_text_all_w_t_and_m_t":"MeasObject","paragraph_zero_based":33884},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for the SpCell if the UE has a measConfig, and it is optionally present, Need M, for SCells. For (e)RedCap UEs, this field is optionally present, Need M.","paragraph_zero_based":33885},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":33886},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for SCells. It is absent otherwise. ","paragraph_zero_based":33887}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["af261a7f66247c60534784252d7b38851bfdac0877440caaed1d9db539c12b1f","f59f111187450083cd0ed79cb9351ff8ca2e83ea4e40ffbddf9cae6a1f1c703d","b08965e3d58aea6089735000e76aee31406a07a84ee5e2642fa5e0d66f47d2c0","b0f72fa4bbe85bd32f1335813cf6e955bab4a22a34e4d251ad2c8ae4a9620309","4407b902d9144d5c9999cc4c29ba078e5a9abb682c0d04833c2870175fc0d34e","14ebdc10e1e487c249756233d841c92560594eac59a5638d2a53650dd8c3ca73","8f108dd0988f14b183313f55e6210b6fd01fa0e482096fb4ace06dc750d2aaa0","5e5469dbb36cce7bebdc3556ae7ede8965bf4ac5f01051a5ec0263a8877f7230","0a08b3552a4e23c81c572348d040b6db2f1196fe4eede9b1b3d87e435e7c90db","232e1c99ddccfe9659dd1314a2c569be71b18eabf72d46d96ef247accee8dcfb","286c510335c1b86668862d4560f1e2fc53a28a2ede3f21d8ed9b8481d9b52e5d","62a8b65872ed37aa6234ed55c473f25543cb7a839c62f069b000dfe87a588886","86c9ff0d11e997606232b9ea0b24ed7e3f809c17aee2726834baa58c0a0a4cad","e8a145127a563fce503ee59818065708a2763e75c000c493f2072f9bac7aa7f0","14b29bf9137be7efd2a03046d52e57e420e126c687d0cc37ce14f743d0504a84","a3b21fadba52cc64603545411c4559c038957842d9026612b145a93b0a82ffca","a42e08e397a471c5f6fc6b1f0a095c6efae90e03ba4279f315ff0f0dc122b5b5","709bfc9f52d7806af4db795ab07f1587ec3a4736aaea862020215c917db7a882","845e51d44f5a0a2eb3a95b79175bc0437ae05b21ca4999f992d91f0aa7d73ce3","928f1f33d7ffad9c116567dad4561fe352938e906e67e7e98be7a51110a944e9","4e7ffb88208dcaa20f45be67034493ab951b4b0cfa577851d8b1b2e876adfb7e","71558026d977c0564e23a77108f1e862aa02ce7df834fdd279e2f84a55e845e6","290f8f7e59df18ce63b35f49e47b7dc50463717550285f6b94f18f18fcc0211d","29883d6a0071e8f31940bffc2f252e491eac0342a1360233dc393f4d1830da54"],"paragraph_range_zero_based":[33864,33887],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33864"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ServingCellWithoutPUCCH","paragraph_zero_based":33888},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, for SCells except PUCCH SCells. It is absent otherwise.","paragraph_zero_based":33889},{"literal_text_all_w_t_and_m_t":"SyncAndCellAdd","paragraph_zero_based":33890},{"literal_text_all_w_t_and_m_t":"This field is mandatory present for a SpCell upon reconfiguration with reconfigurationWithSync and upon RRCSetup/RRCResume.","paragraph_zero_based":33891},{"literal_text_all_w_t_and_m_t":"The field is optionally present for an SpCell, Need N, upon reconfiguration without reconfigurationWithSync.","paragraph_zero_based":33892},{"literal_text_all_w_t_and_m_t":"The field is mandatory present for an SCell upon addition, and absent for SCell in other cases, Need M.","paragraph_zero_based":33893},{"literal_text_all_w_t_and_m_t":"TCI_ActivatedConfig","paragraph_zero_based":33894},{"literal_text_all_w_t_and_m_t":"This field is optional Need N for SCells if sCellState is configured, otherwise it is absent.","paragraph_zero_based":33895},{"literal_text_all_w_t_and_m_t":"This field is optional Need S for the PSCell when the SCG is indicated as deactivated or is being activated, otherwise it is absent.","paragraph_zero_based":33896},{"literal_text_all_w_t_and_m_t":"This field is absent for the PCell.","paragraph_zero_based":33897},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":33898},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":33899},{"literal_text_all_w_t_and_m_t":"TDD_IAB","paragraph_zero_based":33900},{"literal_text_all_w_t_and_m_t":"For IAB-MT, this field is optionally present, Need R, for TDD cells. It is absent otherwise.","paragraph_zero_based":33901},{"literal_text_all_w_t_and_m_t":"TypeDCI0-3","paragraph_zero_based":33902},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ScheduledCellListDCI-0-3 is configured, otherwise it is absent, Need R.","paragraph_zero_based":33903},{"literal_text_all_w_t_and_m_t":"TypeDCI1-3","paragraph_zero_based":33904},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if ScheduledCellListDCI-1-3 is configured, otherwise it is absent, Need R.","paragraph_zero_based":33905},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33906},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommon","paragraph_zero_based":33907},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommon is used to configure cell specific parameters of a UE's serving cell. The IE contains parameters which a UE would typically acquire from SSB, MIB or SIBs when accessing the cell from IDLE. With this IE, the network provides this information in dedicated signalling when configuring a UE with a SCells or with an additional cell group (SCG). It also provides it for SpCells (MCG and SCG) upon reconfiguration with sync.","paragraph_zero_based":33908},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon information element","paragraph_zero_based":33909},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33910},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-START","paragraph_zero_based":33911}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["0cbca5523d8527a26875836c6c78ca5dcbff697d7600731b616518725ff6aee1","b7747369d92f8832f95cf5dbba6c0826363433d35a365e5ad5947e53b7bd9822","24563d0a2d2930db07f75647297b256141bc052cc666d233bfb7