{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    slotOffsetForRemainingHopsList-r18  SEQUENCE (SIZE (1..maxNrofHops-r18-1) ) OF SlotOffsetForRemainingHops-r18,","paragraph_zero_based":35160},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35161},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35162},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35163},{"literal_text_all_w_t_and_m_t":"SlotOffsetForRemainingHops-r18 ::=  SEQUENCE {","paragraph_zero_based":35164},{"literal_text_all_w_t_and_m_t":"    slotOffsetRemainingHops-r18         CHOICE {","paragraph_zero_based":35165},{"literal_text_all_w_t_and_m_t":"        aperiodic-r18                       SEQUENCE {","paragraph_zero_based":35166},{"literal_text_all_w_t_and_m_t":"            slotOffset-r18                      INTEGER (1..32)                                            OPTIONAL,   -- Need S","paragraph_zero_based":35167},{"literal_text_all_w_t_and_m_t":"            startPosition-r18                   INTEGER (0..13)                                            OPTIONAL,   -- Need R","paragraph_zero_based":35168},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":35169},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":35170},{"literal_text_all_w_t_and_m_t":"        semi-persistent-r18                 SEQUENCE {","paragraph_zero_based":35171},{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-sp-r18         SRS-PeriodicityAndOffset-r16                               OPTIONAL,   -- Need R","paragraph_zero_based":35172},{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-sp-Ext-r18     SRS-PeriodicityAndOffsetExt-r16                            OPTIONAL,   -- Need R","paragraph_zero_based":35173},{"literal_text_all_w_t_and_m_t":"            startPosition-r18                   INTEGER (0..13)                                            OPTIONAL,   -- Need R","paragraph_zero_based":35174},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":35175},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":35176},{"literal_text_all_w_t_and_m_t":"        periodic-r18                        SEQUENCE {","paragraph_zero_based":35177},{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-p-r18          SRS-PeriodicityAndOffset-r16                               OPTIONAL,   -- Need R","paragraph_zero_based":35178},{"literal_text_all_w_t_and_m_t":"            periodicityAndOffset-p-Ext-r18      SRS-PeriodicityAndOffsetExt-r16                            OPTIONAL,   -- Need R","paragraph_zero_based":35179},{"literal_text_all_w_t_and_m_t":"            startPosition-r18                   INTEGER (0..13)                                            OPTIONAL,   -- Need S","paragraph_zero_based":35180},{"literal_text_all_w_t_and_m_t":"            ...","paragraph_zero_based":35181},{"literal_text_all_w_t_and_m_t":"          },","paragraph_zero_based":35182},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["db2fd40f6fb425328884f6497f1fd412286e1677935c473d17806548fb8b9cfb","33c75761d3c786a34b635bd3f14d892e844fe2a48e60284d5bf929c107e6e02b","90f89106e8c9e1daac3db29ed5d75664b9402188348cdb4eb02413e75f81cca7","0fa121c7881360742d1f802bbe07d75c4b3d1e38aaee05ca8511e44250199317","415dccf7119ddaa4c5c4ed4ed3559e5d9cebeade24c439be40b793e5b4b5bb12","c45f3b1df5a72e0452965bcb07a31cc5f17127267e4c174564f84795fa532e95","3f4d5ac1288a17b7af5d6d9