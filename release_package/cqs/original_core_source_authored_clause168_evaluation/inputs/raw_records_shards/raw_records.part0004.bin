ingRS ::=           SEQUENCE {","paragraph_zero_based":31094},{"literal_text_all_w_t_and_m_t":"    radioLinkMonitoringRS-Id            RadioLinkMonitoringRS-Id,","paragraph_zero_based":31095},{"literal_text_all_w_t_and_m_t":"    purpose                             ENUMERATED {beamFailure, rlf, both},","paragraph_zero_based":31096},{"literal_text_all_w_t_and_m_t":"    detectionResource                   CHOICE {","paragraph_zero_based":31097},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":31098},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                        NZP-CSI-RS-ResourceId","paragraph_zero_based":31099},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":31100},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":31101},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":31102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":31103}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e750fdef64bdf41cb0b727bd0d621ff806b1988f7abd4b71ca2c1f4a45422e0d","bdfd3430cecfdabb798b4949be26cd275f8d6c4626af203decdd900512ce99e7","3bab28f176bb32ce2327b4d30ce931c6327b4529e5058e5cf5f5d9b0ddc81af4","09aa14a51b7946fde739c251b282061842c50cabcfa8058fb8a2e522514ed850","245acbc186f04268b287872ee756a098448d65509b4f7a95d25b2c185b585abd","28654968bc32a9a6a59ebe0e61fd4d8e4a9ec1848519c7ce2ea4cbc5db1c6280","eb5c8aab1ceb2124bcb249ba12a5624864b058be2f704aa210f12cb4b35136a9","44688870b07b3966e069749fd8e169ac370c6e6722f695c44404b3ea01dafa2f","d05476d7b3d30f0a618a7ecac679dac4b6366b859fab803781b8ee984e54165c","a79442b970f3656e58d3e971b5c98bcf9cde43eec7a3486177de39ff5bdf682d","64d185e