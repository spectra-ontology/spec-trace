{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"WLAN-Name","paragraph_zero_based":45672},{"literal_text_all_w_t_and_m_t":"If configured, the UE only performs WLAN measurements according to the names identified. For each name, it refers to Service Set Identifier (SSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":45673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45674},{"literal_text_all_w_t_and_m_t":"6.3.5Sidelink information elements","paragraph_zero_based":45675},{"literal_text_all_w_t_and_m_t":"–SL-BWP-Config","paragraph_zero_based":45676},{"literal_text_all_w_t_and_m_t":"The IE SL-BWP-Config is used to configure the UE specific NR sidelink communication/discovery/positioning on one particular sidelink bandwidth part.","paragraph_zero_based":45677},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config information element","paragraph_zero_based":45678},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45679},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-BWP-CONFIG-START","paragraph_zero_based":45680},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45681},{"literal_text_all_w_t_and_m_t":"SL-BWP-Config-r16 ::=                    SEQUENCE {","paragraph_zero_based":45682},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Id                                BWP-Id,","paragraph_zero_based":45683},{"literal_text_all_w_t_and_m_t":"    sl-BWP-Generic-r16                       SL-BWP-Generic-r16                                            OPTIONAL,  -- Need M","paragraph_zero_based":45684},{"literal_text_all_w_t_and_m_t":"    sl-BWP-PoolConfig-r16                    SL-BWP-PoolConfig-r16                                         OPTIONAL,  -- Need M","paragraph_zero_based":45685},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":45686},{"literal_text_all_w_t_and_m_