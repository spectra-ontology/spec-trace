{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The DLDedicatedMessageSegment message is used to transfer one segment of the RRCResume or RRCReconfiguration messages.","paragraph_zero_based":11376},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: SRB1","paragraph_zero_based":11377},{"literal_text_all_w_t_and_m_t":"RLC-SAP: AM","paragraph_zero_based":11378},{"literal_text_all_w_t_and_m_t":"Logical channel: DCCH","paragraph_zero_based":11379},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":11380},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment message","paragraph_zero_based":11381},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11382},{"literal_text_all_w_t_and_m_t":"-- TAG-DLDEDICATEDMESSAGESEGMENT-START","paragraph_zero_based":11383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11385},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment-r16 ::=       SEQUENCE {","paragraph_zero_based":11386},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                      CHOICE {","paragraph_zero_based":11387},{"literal_text_all_w_t_and_m_t":"        dlDedicatedMessageSegment-r16           DLDedicatedMessageSegment-r16-IEs,","paragraph_zero_based":11388},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture                SEQUENCE {}","paragraph_zero_based":11389},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":11390},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11391},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11392},{"literal_text_all_w_t_and_m_t":"DLDedicatedMessageSegment-r16-IEs ::=   SEQUENCE {","paragraph_zero_based":11393},{"literal_text_all_w_t_and_m_t":"    segmentNumber-r16                       INTEGER(0..4),","paragraph_zero_based":11394},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentContainer-r16         OCTET STRING,","paragraph_zero_based":11395},{"literal_text_all_w_t_and_m_t":"    rrc-MessageSegmentType-r16              ENUMERATED {notLastSegment, lastSegment},","paragraph_zero_based":11396},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension                OCTET STRING                                  OPTIONAL,","paragraph_zero_based":11397},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                    SEQUENCE {}                                   OPTIONAL","paragraph_zero_based":11398},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2222d1016964e34a969b5f02f06d52a64c3922ab536b2e3b71fe488ec97806b1","606e56cc4d850fb7b2696c1740d0feee55aaf483284591761f675b34fd54b60f","a6667e906e2640242c43f9ec838ef1cd3b2d678cf79f2f4f0a14435ab63223c1","ce82c39bf59346fc52361a041e6b3c522fd9da9c456d2275f49b93eaee86f3ca","961f1731b01700b1e5954a09262628aeda1e6ded63c3b59ab9d81555b0b85b08","f499a3a17d23574a53df4f6c52f09707b78e160c7ec51fbd23d6000e3b1dba34","c95e82251e90602c605d1f326bd9f16206230f0a56252d4d76858aebb4ec19be","22787f532c2986c4e585d6c97abd694a901bac8b209a7e42e9b752c633e513a5","5a0260e46cecca3e00c4bde07fa5021f732964ae0e90d2aa7925212bb07d13e8","374ff54c3e4cb6639eb46f50fb7d799d5f803173e9f0f622bff6a2c6b335d7d6","5a8c17a26e6cd8244880d0b2ecec3a4dae66678fb972541cd5c9d646bf91febe","f11dbf825fceaa58c21dc7f2e339bb89d0bd49da53a794e229cdb1dae4c9323a","612f2eb2eb3998322995afd01bec1c93d12255269e88fa157187731d4fc0b8c0","3d5848ee1f91076858558763cec7ef177886ec1294ee1db19960ae1b8