{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47976},{"literal_text_all_w_t_and_m_t":"TMGI-r17 ::=                     SEQUENCE {","paragraph_zero_based":47977},{"literal_text_all_w_t_and_m_t":"    plmn-Id-r17                      CHOICE {","paragraph_zero_based":47978},{"literal_text_all_w_t_and_m_t":"        plmn-Index                       INTEGER (1..maxPLMN),","paragraph_zero_based":47979},{"literal_text_all_w_t_and_m_t":"        explicitValue                    PLMN-Identity","paragraph_zero_based":47980},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":47981},{"literal_text_all_w_t_and_m_t":"    serviceId-r17                    OCTET STRING (SIZE (3))","paragraph_zero_based":47982},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":47983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47984},{"literal_text_all_w_t_and_m_t":"-- TAG-TMGI-STOP","paragraph_zero_based":47985},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":47986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47987},{"literal_text_all_w_t_and_m_t":"TMGI field descriptions","paragraph_zero_based":47988},{"literal_text_all_w_t_and_m_t":"plmn-Index","paragraph_zero_based":47989},{"literal_text_all_w_t_and_m_t":"PLMN index or NPN index according to the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1. If this field is included in the MRB-ToAddMod-r17, the UE translates the plmn-Index into the PLMN Identity or SNPN Identity based on the configuration in SIB1 (which is the SIB1 of the target cell in case of handover). The explicitValue is not used for MBS service(s) of an SNPN.","paragraph_zero_based":47990},{"literal_text_all_w_t_and_m_t":"serviceId","paragraph_zero_based":47991},{"literal_text_all_w_t_and_m_t":"Uniquely identifies the identity of an MBS service within a PLMN. The field contains octet 3- 5 of the IE Temporary Mobile Group Identity (TMGI) as defined in TS 24.008 [38]. The first octet contains the third octet of the TMGI, the second octet contains the fourth octet of the TMGI and so on.","paragraph_zero_based":47992},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47993},{"literal_text_all_w_t_and_m_t":"6.4RRC multiplicity and type constraint values","paragraph_zero_based":47994},{"literal_text_all_w_t_and_m_t":"–Multiplicity and type constraint definitions","paragraph_zero_based":47995},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":47996},{"literal_text_all_w_t_and_m_t":"-- TAG-MULTIPLICITY-AND-TYPE-CONSTRAINT-DEFINITIONS-START","paragraph_zero_based":47997},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":47998},{"literal_text_all_w_t_and_m_t":"maxAdditionalRACH-r17                   INTEGER ::= 256     -- Maximum number of additional RACH configurations.","paragraph_zero_based":47999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["790eedf3dcd0c6558c00fe3e68434b53b987e84996b99b612c85df35a07eef32","dc17d72479048a922d5403506382e7935ebed1791346c0862f785fa5c1ac9ae1","e0c054bf1bcf5104b8e0d36fa20ce22e070fabaaea8178598a4d35a370ef02d7","d15574c7fa8dfdcc053cc1de5d18e7371bd3043b24575f2cff4bb92afe0c9056","69f4f51d84058197f761473f5e843bc4baf33ddb8b1901d5c5bfb62de0663d05","e6181639b4c663a3354dd55ead5d1ae204f0b8597c0f5a7cca9278c95e837b0a","8bf78519dfdffc87ed29018575715a294881e53bb0b63d763a665ecf5bacfa76","9f56bbe4c4d437adb88f9d43b5d3cc9bc9849356d62c446545f0e245334c157c","8d71c6888eb61d8f25b5ed53121a27e3f0ac37ec3c890f816e46864f5a70a2fb","07dcc967d8c8ad173866cb5c0742f90857