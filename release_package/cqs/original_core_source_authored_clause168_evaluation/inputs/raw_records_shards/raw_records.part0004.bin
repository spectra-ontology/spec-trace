{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"t3xy","paragraph_zero_based":32136},{"literal_text_all_w_t_and_m_t":"Timers are described in clause 7.1. Value ms0 corresponds to 0 ms, value ms50 corresponds to 50 ms and so on.","paragraph_zero_based":32137},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32138},{"literal_text_all_w_t_and_m_t":"–RNTI-Value","paragraph_zero_based":32139},{"literal_text_all_w_t_and_m_t":"The IE RNTI-Value represents a Radio Network Temporary Identity.","paragraph_zero_based":32140},{"literal_text_all_w_t_and_m_t":"RNTI-Value information element","paragraph_zero_based":32141},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32142},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-START","paragraph_zero_based":32143},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32144},{"literal_text_all_w_t_and_m_t":"RNTI-Value ::=                      INTEGER (0..65535)","paragraph_zero_based":32145},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32146},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-STOP","paragraph_zero_based":32147},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32148},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32149},{"literal_text_all_w_t_and_m_t":"–RSRP-Range","paragraph_zero_based":32150},{"literal_text_all_w_t_and_m_t":"The IE RSRP-Range specifies the value range used in RSRP measurements and thresholds. For measurements, integer value for RSRP measurements is according to Table 10.1.6.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 156) dBm, except for the IE value 127, in which case the actual value is infinity.","paragraph_zero_based":32151},{"literal_text_all_w_t_and_m_t":"RSRP-Range information element","paragraph_zero_based":32152},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32153},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-START","paragraph_zero_based":32154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32155},{"literal_text_all_w_t_and_m_t":"RSRP-Range ::=                      INTEGER(0..127)","paragraph_zero_based":32156},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32157},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-STOP","paragraph_zero_based":32158},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32159}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["bb7ce9d54b4b6a4e1022b3e7ec7cf504641f696fd758cdf47daea50e5d1d8756","1b4478576796efcfc2534749d636bf1abecbfd3114eedbb4547d4dafa6a82ea2","e5f38344c0ff1dc952c735ec39186e6a48d45816958750026c5fb582c29465a6","55b6475d7fbd2e075d28649488f30e930b730ed63dfd19bf01fb428c14d7f78f","0e0db69a927c9793b1abf15c337b90212aab56d614978040c27d81a1d5d41d4a","eb1895c7d6314ec5380ef98b081f4a98d13f157e4af44c9aadd1261a9240a7ad","929c6b5510cfc1283b2e9410d742355cadc7aa5ecb858ce00f84280e15440ad5","52cd4d25291a83dd256265b20fe2f6621be8e19bff628da362b6c3fb709fad5a","647b9e6b4d478ef019184857834ecf90d3b3f86dbc8457f66760d9aeebf5cd80","08e87b6cea2ce4eaef8b4b75caa933b381fc70ea33409e4203b3f3fbed642c02","aa49be70b6ff3cb1955822c6c350f076075536b8969f719d76fd20498b9ae5e4","559808a4588a66cc6674fecdc700b99a8e4872167d09600522434bfb1f1d04e5","f48923d02f5a683af6e493f19e321f0ffcbacbcdca3986fe8f5b8c59d710d5d9","d304fb262fbb4e8dd39d0ec3d35d9e0ad5009ef216c038c0bb7ebad52d22b5e1","03beae6475c92d7f59bc1f661d9bda7e7467ac5d3cfa577cd1e9d8d5603a6ff3","614d3a419c401750025d67dbb5370c78d299cead5b852d05af46a97cea4607a8","38616f3105e03bd75a00a6c089d628ed3fae016fe