h_zero_based":43576},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":43577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":43578},{"literal_text_all_w_t_and_m_t":"–EUTRA-Q-OffsetRange","paragraph_zero_based":43579},{"literal_text_all_w_t_and_m_t":"The IE EUTRA-Q-OffsetRange is used to indicate a cell, or frequency specific offset to be applied when evaluating triggering conditions for measurement reporting. The value in dB. Value dB-24 corresponds to -24 dB, value dB-22 corresponds to -22 dB and so on.","paragraph_zero_based":43580},{"literal_text_all_w_t_and_m_t":"EUTRA-Q-OffsetRange information element","paragraph_zero_based":43581},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":43582},{"literal_text_all_w_t_and_m_t":"-- TAG-EUTRA-Q-OFFSETRANGE-START","paragraph_zero_based":43583}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["82f94725b81a252ad158fd7e79698fbaf72d2f1f72d07db69d0e068e1530a40b","a40d9b8ea0c704b9a461bccd7b9b4f22788804249bdb3bf6f73b825c0688969e","b2ca58c95368271175ba2981ea6752e3243faf50d05293eba78f08dad25531fa","9eba01fb25412f9175f0c0d318165546a2d0a087377889e91ca220c3d74c139d","004bf2c9f7f76f03ccb130aeb0384461adc7fca7f8d6f38cc2c7e7db81d6e5a7","46426d871d0e1675b130f9bd1345f4163a5615903dbca12396b943dad09fc263","666cb7d6e28fbb9ccba07764f8df984495b98be27b2528d7e23db33f2bcd9c1a","2a097816678ee1fe82f6354323ae08d7be377b3f9bdfd6ed46cf08fae861a7de","9e5221e50895d437288a0f66191f25932a654e2b5f35969258d1fb364672993e","fc25e9f0d5263cc5b1ea80202b82882ff6d00e73956780adb21fb1f0c5d76be8","483ab3e5dfd89e169a5160a71b9fe90910487bd56d1399d9c37967b1f794841c","8e1eed5696814f0524d6b1883a8e2ff19f31480ae875cb295f4b6cb511cb