{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46368},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIG-STOP","paragraph_zero_based":46369},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46370},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46371},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-Config field descriptions","paragraph_zero_based":46372},{"literal_text_all_w_t_and_m_t":"threshHighRelay","paragraph_zero_based":46373},{"literal_text_all_w_t_and_m_t":"Indicates the upper threshold of Uu RSRP for a UE that is in network coverage to evaluate AS layer conditions for U2N relay UE operation.","paragraph_zero_based":46374},{"literal_text_all_w_t_and_m_t":"threshLowRelay","paragraph_zero_based":46375},{"literal_text_all_w_t_and_m_t":"Indicates the lower threshold of Uu RSRP for a UE that is in network coverage to evaluate AS layer conditions for U2N relay UE operation.","paragraph_zero_based":46376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46377},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":46378},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":46379},{"literal_text_all_w_t_and_m_t":"ThreshHighRelay","paragraph_zero_based":46380},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if threshHighRelay is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":46381},{"literal_text_all_w_t_and_m_t":"ThreshLowRelay","paragraph_zero_based":46382},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if threshLowRelay is included. Otherwise, the field is absent, Need R.","paragraph_zero_based":46383},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46384},{"literal_text_all_w_t_and_m_t":"–SL-RelayUE-ConfigU2U","paragraph_zero_based":46385},{"literal_text_all_w_t_and_m_t":"The IE SL-RelayUE-ConfigU2U specifies the threshold configuration information for NR sidelink U2U Relay UE.","paragraph_zero_based":46386},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-ConfigU2U information element","paragraph_zero_based":46387},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":46388},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-RELAYUE-CONFIGU2U-START","paragraph_zero_based":46389},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46390},{"literal_text_all_w_t_and_m_t":"SL-RelayUE-ConfigU2U-r18::=           SEQUENCE {","paragraph_zero_based":46391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f1c0c47f36ae9f82c05a292d1c6a2d4df0f56a9215d2ea6f8e93485e0786cb05","f669f968707037586be823330f4555eb62eced4164c1a00c415846bdcc4ac211","a19fa93172d5c812a6775416d67bc5c83ba584e343ce961268cd70654239ed8e","d1e14fdb07a13e3f868627af9d346f48c937b38401a4206c3bb58c21e5ff3b86","e6ce886a4cb72124bfee490cb6526dc20be582a41fa6c5ce4ce5efa6841ffefb","7fb797dd8690eb4608853510574286a31767e88eebf855c6d4f0262146577805","11490ef3fdfbab4d93ce885bd6ccd6a2935148e8ef923267984c4f7a2fa1a58c","aa189435a015b139f839e2258b7b6cb96b4c7f73d708a39fdf190036de8f7ba4","d374321e8c77a548a3016c5aa6019e02a3e0c476e1ae6135f55503e3ad2b4128","892e426b12cb3f35c041f8ae7e4b0d65bc3ea739a5e60fb079796bc903dfdbe8","e385c3e9b4bb05347f0f7b5c17305b4d3562320fee901f6a345a67980542b266","7c39a25e57852c209c2251f50b13cfb08228c7faebb35bd98d0927c3108a0136","a092bb40c472642db31064c54f7c7ca52e441546c934781cf9a76fbf328ed69f","f057fb4adb0fa1181a4258c835305b120ab63260b80041a664a1209e9821f551","a2164006a1406a2089582ee1cfbf9258cab950db07f262860174f288d179568d","8539103ca1c5a24ea5bf80195