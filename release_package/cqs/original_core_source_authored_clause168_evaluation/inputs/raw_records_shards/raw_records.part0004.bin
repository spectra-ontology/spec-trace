ha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["afbd892b8745d13d1dfb67ca2008dcfc7e9383b934d46ced26cad151ef52eb19","1b728de1e07bdaba3fea2724ae5f1f417701748f7e1acc12ef72af75a05388a8","b960a34560f5aea5abdafb598dcb82dcf270fd325046b75f0faeb1beb95599f5","ea50d494f8cd541c32af4d550d376412e57d4346aa90ed66f7ff9e5cc86a0f5a","b1201a735082cd7215f7cc2a7312331bef3a6312063edf46e5325a746fffc59a","0e0b00e6ff52f773a1e7cd72ea5dd9e1f334d5405ab74bab11ab2a018bf406dd","421356409c5545179b49bcdfa1e633a248920e4bf2f15aecce44cd379c144063","433f881fe606bbcf5614ec0f831dae2705b0ab621588607e244da73924b91142","b7d5f7823866ea901e5091a079d5e5793ae29d37ee3e1c9e1dc2d1a0e1fa4e06","b501bec4adccd161ecf0bff327274d0774f6a5cb6e657be6eba4b06bf717cec7","e0cebf5c41d5d5c712a5645654b22e1ba4b845c47bb21e2e79591bf067f9f9f9","03b9484d4ef5ad31239a5b276ebec839b7e5797cf40d58146e96b6eb01808a78","c9fcc49b60d739b59f5e9822cc2c26443cbccd60d81087889b6a901c5d582a30","f7371e2e9336a769c9b70285e9f880844eb2ad6a0f3db68d9c6608815ed35a4f","f1806d42f5592569638225db348940260a60778e97961d5fb4e685638d7f6fd8","ddce1af89d2d9359a5b49ed84a55f388ef5357508b929cc649e934f5adb40abc","7052996b6c6cb2a5ba9e4f695c22c0edbcf1c2f5932d2d68cbc24d2860ccd860","5750cbcba96fa978f0473dbb5fb56ad8240337817265ab66e9ec5383a804cbc8","197468c1b49b4420fa4acc59012fbb6b371c77910959b143efb35af553161e39","504facb1cfa0e0f7abc381116dba981d3c08fdf50a943fd98a23d9cb8833ff79","4e6df3ba5a671ee2ee6f12a9821dfd0211ffe98705c6ba1e620503af8c46b4c8","16965220da44868bf897c1ad7f0c4a49ffe8be429d237aeb1b3c08456aaee064","091eb1db7f6953de51c566ab81798653575d894d512fc8d2efb2867e74a42933","cd3cc5d74c1d7e9e79538b8a52538e2a743888128be88df88bd3f3d233d133d0"],"paragraph_range_zero_based":[46416,46439],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p46416"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                                spare7, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":46440},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":46441},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46442},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-DRX-CONFIGGC-BC-STOP","paragraph_zero_based":46443},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":46444},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":46445},{"literal_text_all_w_t_and_m_t":"SL-DRX-ConfigGC-BC field descriptions","paragraph_zero_based":46446},{"literal_text_all_w_t_and_m_t":"sl-DefaultDRX-GC-BC","paragraph_zero_based":46447},{"literal_text_all_w_t_and_m_t":"Indicates the default sidelink DRX configuration for groupcast and broadcast communications, which is used for QoS profile(s) that cannot be mapped into DRX configuration(s) configured for dedicated QoS profile(s). This field can be applied for the broadcast based or unicast based communication of Direct Link Establishment Request as described in TS 24.587 [57], ProSe Direct Link Establishment Request message and discovery message as described in TS 24.554 [72].","paragraph_zero_based":46448},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-PerQoS-List","paragraph_zero_based":46449},{"literal_text_all_w_t_and_m_t":"List of one or multiple sidelink DRX configurations for groupcast and broadcast communication, which are mapped from QoS profile(s).","paragraph_zero_based":46450},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-Cycle","paragraph_zero_based":46451},{"literal_text_all_w_t_and_m_t":"Value in ms, ms10 corresponds to 10ms, ms20 corresponds to 20 ms, ms32 corresponds to 32 ms, and so on. ","paragraph_zero_based":46452},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-MappedQoS-FlowsList","paragraph_zero_based":46453},{"literal_text_all_w_t_and_m_t":"List of QoS profiles of the NR sidelink communication, which are mapped to a sidelink DRX configuration.","paragraph_zero_based":46454},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-BC-OnDurationTimer","paragraph_zero_based":46455},{"literal_text_all_w_t_and_m_t":"Value in multiples of 1/32 ms (subMilliSeconds) or in ms (milliSecond). For the latter, value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, and so on.","paragraph_zero_based":46456},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-HARQ-RTT-Timer1, sl-DRX-GC-HARQ-RTT-Timer2","paragraph_zero_based":46457},{"literal_text_all_w_t_and_m_t":"Value in number of slot lengths of the sidelink BWP where the transport block was received. Value sl0 corresponds to 0 slots, sl1 corresponds to 1 slot, sl2 corresponds to 2 slots, and so on. sl-DRX-GC-HARQ-RTT-Timer1 is used for HARQ feedback enabled sidelink retransmission if SCI does not indicate retransmission resource(s). sl-DRX-GC-HARQ-RTT-Timer2 is used for HARQ feedback disabled sidelink retransmission in resource pool configured with PSFCH if SCI does not indicate retransmission resource(s).","paragraph_zero_based":46458},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-Generic","paragraph_zero_based":46459},{"literal_text_all_w_t_and_m_t":"Indicates a sidelink DRX configuration for groupcast communication, which is applicable to any QoS profile or any Destination Layer-2 ID.","paragraph_zero_based":46460},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-InactivityTimer","paragraph_zero_based":46461},{"literal_text_all_w_t_and_m_t":"Value in multiple integers of 1 ms, ms0 corresponds to 0, ms1 corresponds to 1 ms, ms2 corresponds to 2 ms, and so on. This field is only valid for groupcast communication.","paragraph_zero_based":46462},{"literal_text_all_w_t_and_m_t":"sl-DRX-GC-RetransmissionTimer","paragraph_zero_based":46463}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["13fa006a75b0a8a93a2b5f58cabe8566ab0e0b07ef53b06cbd7ca07b0b399ed9","cdd3ebbe4ec4790287536008e89299dc0d7a338d730ded0d2d21da887ecf9297","7967eda94498fcc9b44aad374b441bcc90c27f399efa8dc9ef78461b51b88fa6","d6df40ad9c62582799602f1eb9e81ea12108782b5b611ebadbbdb37a0ba767fa","f9f4c8b7f3145ccd6a8f56556271df65bdbba177eee15aaed7d0f5816ca1e32c","489b8426a37e41ea362f844c382d049ae7e68d44f325c742ba9cc86889972e67","3a1a1e3a28962effeaf189e0d01b7cd48d6902e121678d724b172726dcd6a2f4","4c01841fd3a50e7e0222b141796288abe2da6f59f4af90b8272e687f5ff9c40f","2e8e7d1d229380e0b1ad587947759a5867154cd8b5d5832ece2f3f92350d00e6","319e83707a7c57ae9a3bd262aa104aed0a070fd05cce3fd1a0a32ac77f912997","c85081aa2be2b565b8fc519be32cdb9e89919ad0ce5f7c6ed88c8a8c5a564f17","d81885b32d3080d72cf9ebe0d5aa762f72dd95c308cfcfcbde90b2b7a0892e49","b69a90578b6f2e33af65533feed982885dcb42d049cf574bc9d6f29721462fa4","272012177924d1d186a89ed235142625170c0a1dfc8f8045fb07a49707c8fa51","35457d82ff336b597bf93bbcdcbcbc59557cb9d94c1f977acd0bffea58c9f2d4","9c25bae83a3537af6a8a6f08f79053de82c979954a9c012f4d58d8eee98eda58","d5a69abb2f421de5f37ec5a54a13265e98a08954910b161f022651bbef3e3fde","dc4d7199b35aafb8e4a521c986a82e6f9c704e83bcf1c0b343a020f4405addac","5166c7ff799f7f9b3434f86754af03c954e4bf9d961218079be704eab6b5715a","1bd4f9864e72fed1597694809a09c44b3f3c371136f3fc3ff2088c771f54afdd","84642f6322510a0d4d57fa86f56eb1f4fb86add4eee9d7fd9af423d48607781f","f0c5b453c2c71cb8523202690d6e34add0226a02439b5b02f4294727c8a5cda3","a3b7b736012a9c7a653ba88b3c5a14afaf01502262081fe51b65c1956dc7d460","30c575bd7907122b57ce3701f22053ebd81a1a8c927ad43afb0f4b3d6f8d7c5f"],"paragraph_range_zero_based":[46440,46463],"projection":"All w:t and m:t including tracked insert