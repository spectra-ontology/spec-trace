{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17            ENUMERATED {enabled}                                                OPTIONAL -- Cond SharedSpectrum2","paragraph_zero_based":33960},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33961},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33962},{"literal_text_all_w_t_and_m_t":"    featurePriorities-v1800             SEQUENCE {","paragraph_zero_based":33963},{"literal_text_all_w_t_and_m_t":"        msg1-Repetitions-Priority-r18       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33964},{"literal_text_all_w_t_and_m_t":"        eRedCapPriority-r18                 FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":33965},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Need R","paragraph_zero_based":33966},{"literal_text_all_w_t_and_m_t":"    atg-Config-r18                      ATG-Config-r18                                                      OPTIONAL   -- Need R","paragraph_zero_based":33967},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":33968},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33969},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33970},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":33971},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33972},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33973},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":33974},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":33975},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":33976},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":33977},{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":33978},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":33979},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":33980},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":33981},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":33982},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":33983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8c1dedb0b05307e1b153ba83e8d362096ad17b2b387ba1c1de569d6441eca908","af14e5fc678c7cb465c8aea9899c83cbcbb38f1ff8e940377134a98cdfa6d924","1ade68020d8e4aa02948efa1fd982bd7f101e6a8a10208e228c07f4609fb1379","992f674f0a3294e0d59c04429dcf92848fe69e8f238d2efb095771fe60dd0ed2","1cea40042faa5b161fd7db4836d52809986ce8b2a0d76feff6749df13fc71584","5f3dee508cd1fa838a49de2a78bd86f8286626488c4ae3951b5b96745e39ed75","0231bfd273e1a2a5e2d8a874ae7f5cb81977b1aedfc73363199498d9b465ed94","b50d8fad90eaeacbea3bb8ae166a9628c959751ed639ae4f28f5acc00ea53110","cc1a94f261e5a92ec34889a45c97edc1e54825dfbafa9e94763d4fe62346bf52","619a896a65e6450888ff2b0f2345e37c8f486821bc91153a94889c781e7555fb","1aabe67c82c68ccae3f548492332520dab29b7f508eee45f003d352674641d06","e7bf7d548d451d4cd581f6f9f1839929f32fdd3caf077a3e8aa38b33f166e62a","cfb9edaa125a679a0e9e14c8a1c39a4cb62b85da7c301f7f45071d037e2756cc","3ea532e53eb5973f9fa6de54b82c24c333c3f3f955398fcb8ea82ad42b5f9d87","639306451cbd0ca94c3578faed24e714e88f2894b9a7768da352059677fb9f24","cfb43a52bf085ff394d44e40770e3dc88541e4da00213529efbedcedae15bf50","16d25806ee45141a5267d5db398870d4e9432b6af961faa21da825ad2998f0bb","abf4b63f635a55154c234877f312cb78d6f76d26137bd0cb092da7858caea45b","88d67fc2d0cb34e9a1360ff4df1786b011a36dfd333f90dc3a65d2281b5a6ef6","26d8931b9d64c7e101df2939acc6b2f7612ba8579efd4b3e1b9384ac65c9afaf","994c070d793df661f8dd393d49b958b3d36c1ea9f9938d3d1f0e826299bcc232","9e3273e01406aab913f0f3e1e3e8a55356089d10f1e0bfc4a752f21e7e9a7297","3dceb12c308974a2eaabdfc14ae1b6d9d6020bb8a0f085bcb4de56878573ae9e","2077ab33055d49e5458b26d8731477e5bd9f594c05dba77a630f7d2c23a96555"],"paragraph_range_zero_based":[33960,33983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":33984},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":33985},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as (e)RedCap, Slicing, SDT, MSG1-Repetitions, and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":33986},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":33987},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33988},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":33989},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":33990},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":33991},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33992},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":33993},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell if n-TimingAdvanceOffset is not configured. If tag2 is configured for this serving cell, this field is to be applied to all uplink transmissions associated to tag-id configured for this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":33994},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":33995},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":33996},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":33997},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":33998},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":33999},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":34000},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":34001},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":34002},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":34003},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":34004},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":34005},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":34006},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":34007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9a76251242b4e4d6bb14c0c84466ddc7c16112704e20788176f07e48ef96f447","d0ac63f39d33be026181b007ac3bd318aa651ca92538b265cdf1d34d737eb540","fd737d28d34667fc533a067d6e26bde11fc2cd2247ca9221c5a62c62efc493e5","e958b46ff0a17772c9a82fc4f8385bb68f9217ae57c5823880ad9896a341932d","6acff9f895b7ebca108c078695779c212e88f9411aae6b8d839d35458f903587","968a4e04b0d4dc628bff62c4d71c96219d60064b0ab2252490c197a6e5b49602","380a1fbdf504e4e924e7298493eacf9eca3092d5073980e213c1f19aa79f2d79","17c46a60167313703572519100d10be0f27b8e3f0f109f7bd9cd36e12f0d3a55","6c23c6250d4e44cf4bb7aba6f78ab3ae98850a4ccd3e6ac4afe196e5eac36b31","e263d575f35b45f2cff6685c5df155e837d9e596c234f344b3cbc47ec5786374","3e76fe6c56d64b5f8b2c70465a87e55c887943d175c66aceb11e257bc7e2a243","02270666c0ea67aa49d50ab51c0b16d525f498fce204686dcaa0689749a3b143","1eb096d2a1541db24d5f9321cc872d5b497111b2c84775a911c90641ef07e4dc","5edf0aa75f546d4144bf3a3910455ab46fba27a9727b2d8624aed7e1573f6c44","6d30c8b55aa5d64728f8c51f6944787ffc3f8e165c54dd368c8de89f8540113f","e79616a982d0252b1ed95f986e6494f6c4c1b57ee35d61f0bd131d71485fe2b8","4ab6824e010f997119e60f56339c3f62f56742ff0836e284aeffc41800617b38","336bb3f696b2268c8ef3e93b6b27e2bc5ccefefe90dfcf0c26b7cb50e6d1b701","70dfb4a9ef3482db6456878b388e907b24f6beaf06cb9da91c95ec1237afd9bc","8ff554ac6bf8fb1f6b8e4fd18f510a7b72ce22490ad66aaf8311ded47bd5b0fc","44dc97b1dfe70c02964386e50098e835784d5109be8c7a339344ca0d525ce1e3","93994686399775e11eaaba59c686a3c4bcec98cba0b0f8937aa8d36b5020dd5f","15e24a37d342f5a7339a846d7ed197e60257380e0a268f0e76f28929e5a9066f","23dd4ab4953ff3c137bb64eacbf5ce3fea1f31546d877d9c66b64ba50bba1a86"],"paragraph_range_zero_based":[33984,34007],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p33984"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":34008},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":34009},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":34010},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":34011},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":34012},{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":34013},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":34014},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":34015},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":34016},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":34017},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":34018},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":34019},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34020},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":34021},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":34022},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":34023},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":34024},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":34025},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch between a serving cell and a L2 U2N Relay UE) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":34026},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":34027},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":34028},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":34029},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":34030},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":34031}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c12004658a3a9aac5865008c129a58a64745fd86e75be322f2f5eefdf4463429","aec439747ecd348c6b486d93ff7c5e622bc38437335db3a9258fec070eb46196","df8122bfd1e28a20fb4c6f341ff4566568e187fd2db30864477acc807f52d29a","fcfaacac6c2dc6e75662ae2bd4824923ef7f6f2fddc9a5adeece8328e714c220","85c7a33b5cc7bfcb5147611f49339c0e59b31e6e2201eba702e56bf9e656e54c","660ea053a8dd7c08db970889713c27e34143d720d092101c74087602a404991b","d9d02570823a14718e9dfe0c6001dde00fc3829b138b07db6a97822adf33cb76","9a2e6aace1183a9bc2f55f1f1fb1b3397e34620b0399dcb1f4341b1297d1db79","5f4c0c616971f4f5750b3f69f2c3865ce8a7815c570bc8e1ae6dc4027269c408","60f35c2c0d8cb4ac9bad2f91eeb75af0d198496a94441f1ad5d52d7c7402a139","bcfa40380f7e5ee1234db2fb36d7288c39d3b4f725ef12a3b4b8929fe04b3e1f","358b38e040af8588da7aa9bf52e400e7072f4d389e2eb504280ff0721f412c52","d3ecdcbdeca62eae612774564a4a010316563c13624c3e8d8ac678e440aab35c","c247c7d78f084794156756f4e67db080e90ba5da5b0c523f20ae85c27ed83796","7c058071f59553dd4402fd5ea31fd391237