{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":22368},{"literal_text_all_w_t_and_m_t":"    dmrs-TypeEnh-r18                    ENUMERATED {enabled}                                                OPTIONAL    -- Need R","paragraph_zero_based":22369},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":22370},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22371},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22372},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkTransformPrecoding-r16  ::=  SEQUENCE {","paragraph_zero_based":22373},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID0                   INTEGER(0..65535)                                               OPTIONAL,   -- Need S","paragraph_zero_based":22374},{"literal_text_all_w_t_and_m_t":"    pi2BPSK-ScramblingID1                   INTEGER(0..65535)                                               OPTIONAL    -- Need S","paragraph_zero_based":22375},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":22376},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22377},{"literal_text_all_w_t_and_m_t":"-- TAG-DMRS-UPLINKCONFIG-STOP","paragraph_zero_based":22378},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":22379},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22380},{"literal_text_all_w_t_and_m_t":"DMRS-UplinkConfig field descriptions","paragraph_zero_based":22381},{"literal_text_all_w_t_and_m_t":"dmrs-AdditionalPosition","paragraph_zero_based":22382},{"literal_text_all_w_t_and_m_t":"Position for additional DM-RS in UL (see TS 38.211 [16], clause 6.4.1.1.3). If the field is absent, the UE applies the value pos2. See also clause 6.4.1.1.3 for additional constraints on how the network may set this field depending on the setting of other fields.","paragraph_zero_based":22383},{"literal_text_all_w_t_and_m_t":"dmrs-Type","paragraph_zero_based":22384},{"literal_text_all_w_t_and_m_t":"Selection of the DMRS type to be used for UL (see TS 38.211 [16], clause 6.4.1.1.3) If the field is absent, the UE uses DMRS type 1.","paragraph_zero_based":22385},{"literal_text_all_w_t_and_m_t":"dmrs-TypeEnh","paragraph_zero_based":22386},{"literal_text_all_w_t_and_m_t":"Enables the use of enhanced DMRS type1 or enhanced DMRS type2 with field dmrs-Type (see TS 38.211 [16], clause 6.4.1.1.3). If the field is present and dmrs-Type is absent, the UE uses DMRS eType 1. If the field is present and dmrs-Type is present, the UE uses DMRS eType 2","paragraph_zero_based":22387},{"literal_text_all_w_t_and_m_t":"dmrs-Uplink","paragraph_zero_based":22388},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used, as specified in TS38.211 [16], clause 6.4.1.1.1.1.","paragraph_zero_based":22389},{"literal_text_all_w_t_and_m_t":"dmrs-UplinkTransformPrecoding","paragraph_zero_based":22390},{"literal_text_all_w_t_and_m_t":"This field indicates whether low PAPR DMRS is used for PUSCH with pi/2 BPSK modulation, as specified in TS38.211 [16], clause 6.4.1.1.1.2. The network configures this field only if tp-pi2BPSK is configured in PUSCH-Config.","paragraph_zero_based":22391}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8451096fa9bcbd82af5cd9a70ab459b8133a00f11d62b1f02ddd5e00fb698e45","705632ac2a267fb5ef9b6a245ff1740adb720ac84f2f2bc6f7d76f4765c8effc","7f342dc24eacb78d409453315a27a48aba9acc5471d9b5168ff6c9933a30d960","9ebda7b752fbc7b173c6ecb278cf020355a0981b9857b11cfae6f441e4bfa527","b21a3d96ab492d2a4f01848ad9c7b9ad947f4999425b0f7238ace53c29e46946","2d3beea9850db4787fe70bc3289aaf9564b64738b0172769a03d5466aa633c48","571150b776cdb0dfd296bfd3a8b5e6cd0f9fba0f522209801224a26aca44b63a","20736a1f1bafeb5c6f4b1d0ad391d8fe69f4c2bf9cee412688ee8feb6330e5e4","66efc3d362f2157fe8b4371f3a800dc7ab6a34f0899bef338792be3a12e49293","2d79eac2f3330883da97e30155a941daec39b57107ea83d23ee3ebf05cf5e22b","b0bd5d3bbad64c75aba7334c2ddf2befa9bc04e9af140f923560c98524e46e49","e670eecdab92a295e14b55e988a5e4ba1c9e758996d5cc0968bf1a583ec6687e","19918234ea213b7f30ca8b9195fe3048a495ed653a8e4d62f9b5d232f2763c04","a0c1b0972d4c2f8310c37862c347d20febfa428674a7b8e3a843fa468cb2b109","bfcd0eb9747a6c027f9fdc0ce5ae6f0eec100a1daacfbede5993854298b373f1","1317a5bedb593461d9c23ec0f56307a20351a4f52836bebec5409f64f3037d98","43f4d55f3a13aaa4213eab97327e318a1d4cf62035a944b10e16966204286038","aeaf86bc76b3caf49071efd012477c4ce658297e14e06131ef44f4842fd4e681","ff72905eca38841710acd788dd27a506a9caccea47e5069b16bc5e2445905796","a49cb4efce2b071ee20ea05e615b162173148694909c9fa8936fd070aed2231a","9011adea5eabb0ab7e816983cdeb26b00be086d8442c694b989071c54e6ffce5","68556aa8b69de843d09423902063a47440462be7d152c8c30c36a832b2342acb","78ccba65a3dc00b164d806a92c7f0383de7539288d23584c57e618253c2b8499","c03aeaad6eaa7c866072d66ea124b4d38ca5ee6c45c9f95a6012a201a6dab815"],"paragraph_range_zero_based":[22368,22391],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p22368"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"maxLength","paragraph_zero_based":22392},{"literal_text_all_w_t_and_m_t":"The maximum number of OFDM symbols for UL front loaded DMRS. len1 corresponds to value 1. len2 corresponds to value 2. If the field is absent, the UE applies value len1. If set to len2, the UE determines the actual number of DM-RS symbols by the associated DCI. (see TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":22393},{"literal_text_all_w_t_and_m_t":"nPUSCH-Identity","paragraph_zero_based":22394},{"literal_text_all_w_t_and_m_t":"Parameter: N_ID^(PUSCH) for DFT-s-OFDM DMRS. If the value is absent or released, the UE uses the value Physical cell ID (physCellId). See TS 38.211 [16].","paragraph_zero_based":22395},{"literal_text_all_w_t_and_m_t":"phaseTrackingRS","paragraph_zero_based":22396},{"literal_text_all_w_t_and_m_t":"Configures uplink PTRS (see TS 38.211 [16]).","paragraph_zero_based":22397},{"literal_text_all_w_t_and_m_t":"pi2BPSK-ScramblingID0, pi2BPSK-ScramblingID1","paragraph_zero_based":22398},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for pi/2 BPSK DMRS for PUSCH (see TS 38.211 [16], Clause 6.4.1.1.2). When the field is absent the UE applies the value Physical cell ID (physCellId) of the serving cell.","paragraph_zero_based":22399},{"literal_text_all_w_t_and_m_t":"scramblingID0","paragraph_zero_based":22400},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":22401},{"literal_text_all_w_t_and_m_t":"scramblingID1","paragraph_zero_based":22402},{"literal_text_all_w_t_and_m_t":"UL DMRS scrambling initialization for CP-OFDM. (see TS 38.211 [16], clause 6.4.1.1.1.1). When the field is absent the UE applies the value Physical cell ID (physCellId).","paragraph_zero_based":22403},{"literal_text_all_w_t_and_m_t":"sequenceGroupHopping","paragraph_zero_based":22404},{"literal_text_all_w_t_and_m_t":"For DMRS transmission with transform precoder the NW may configure group hopping by the cell-specific parameter groupHoppingEnabledTransformPrecoding in PUSCH-ConfigCommon. In this case, the NW may include this UE specific field to disable group hopping for PUSCH transmission except for Msg3, i.e., to override the configuration in PUSCH-ConfigCommon (see TS 38.211 [16]). If the field is absent, the UE uses the same hopping mode as for Msg3.","paragraph_zero_based":22405},{"literal_text_all_w_t_and_m_t":"sequenceHopping","paragraph_zero_based":22406},{"literal_text_all_w_t_and_m_t":"Determines if sequence hopping is enabled for DMRS transmission with transform precoder for PUSCH transmission other than Msg3 (sequence hopping is always disabled for Msg3). If the field is absent, the UE uses the same hopping mode as for msg3. The network does not configure simultaneous group hopping and sequence hopping. See TS 38.211 [16], clause 6.4.1.1.1.2.","paragraph_zero_based":22407},{"literal_text_all_w_t_and_m_t":"transformPrecodingDisabled","paragraph_zero_based":22408},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for Cyclic Prefix OFDM.","paragraph_zero_based":22409},{"literal_text_all_w_t_and_m_t":"transformPrecodingEnabled","paragraph_zero_based":22410},{"literal_text_all_w_t_and_m_t":"DMRS related parameters for DFT-s-OFDM (Transform Precoding).","paragraph_zero_based":22411},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":22412},{"literal_text_all_w_t_and_m_t":"–DownlinkConfigCommon","paragraph_zero_based":22413},{"literal_text_all_w_t_and_m_t":"The IE DownlinkConfigCommon provides common downlink parameters of a cell.","paragraph_zero_based":22414},{"literal_text_all_w_t_and_m_t":"DownlinkConfigCommon information element","paragraph_zero_based":22415}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3a3da55690dc840fe99295d1b08c0680b2a094cdddafb81d32dafa3ca84bb76d","606ca2652ca4ec683421440a7e0c4c2f20c8793946606d53efe1a4bf97965015","d7f26617d07068133ab80c3d58f1355833afd62792fe6e37559855a6a8be7e81","4d0c8929d1753a95f50f504fc2e7da960fbe914ed5e76a80dcc8bb472c67b729","ce41bd93f06ccba883b5e9a026ec94b6c82cf92ac5c3284fc4bf1f12aa077ec6","d4170b2188a1071794d6219e8c46cfe86946762759cd729e051851563606353e","47b6bc39b164e76e3dad1d1dff05daa8114aca5febd87f6c593eba4b3aca1b11","ffd996dada1618e26371976e5dd6a100670d4350e80e4c5ac9b919383bbb5fa0","703788a84a559d7a1d52a54d916ad1cfce371f797f80f339937119c87f633c0e","6549b5ea9ac4fc2305fd71dbc7caf5c54b834016900e6f89733adee8108a2c77","a62bbca1bc41546148fe13332e97c3052461888a1828509a9b9f497a712e0eb2","53e2274ed7d9e1a084e5f772223d1a094351e6674e357f02b7fef91622166d3f","765c2db919603a19b54200540f158c1129df3220db28fe5d4b82b52e18508acd","f5cc7fd5ec84eb0260dd5e7fcc037b8a2e35a4eef3858d0b375cfbb38f888f7d","f573735484dd4e5f2f0803ff6a08e0ec47c753cfdb699a19fc6b185f1d84a18e","d2068580239a43ee25aed486b29daf6d376aa22837744afd79964e78d57348d8","fd78cc1f3116c9fee65ec8d1fc489874beee51a2507c1d441a34cb0e64ed24ad","2063b654610a11da4bbed47fdde02b84f95db0c25895e470f843fa6467e2d2fa","87446b0bca16095f8df2d41789e1e270e1a420558de7069571bb5a18b84d856b","81cd5a83dd0e74f0f1abfb4559b1791399293c9286189a5100ca182fdd1e4052","39366ed248ff8a952e6cc6f72f5847878df2b30149a275588010a163d420bc89","f679028f3af7e39f864cbd2bc0161c8db7727fb89fe1a2c3e3b0cc9141394453","af02a503ef684554abeba70520c298a2b43fb09001a86213ab3be23a9241bf77","468d25975fa287cd8f8e4b98405ee58a62c486138d3f9070db40ab5904717697"],"paragraph_range_z