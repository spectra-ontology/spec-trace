{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"PDCCH-BlindDetectionMixed1-r18::=            SEQUENCE {","paragraph_zero_based":37584},{"literal_text_all_w_t_and_m_t":"    pdcch-BlindDetectionCG-UE-Mixed-r18          SEQUENCE{","paragraph_zero_based":37585},{"literal_text_all_w_t_and_m_t":"        pdcch-BlindDetectionMCG-UE-Mixed-r18         PDCCH-BlindDetectionCG-UE-Mixed-r18,","paragraph_zero_based":37586},{"literal_text_all_w_t_and_m_t":"        pdcch-BlindDetectionSCG-UE-Mixed-r18         PDCCH-BlindDetectionCG-UE-Mixed-r18","paragraph_zero_based":37587},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":37588},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":37589},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37590},{"literal_text_all_w_t_and_m_t":"-- TAG-CA-PARAMETERS-NRDC-STOP","paragraph_zero_based":37591},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":37592},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37593},{"literal_text_all_w_t_and_m_t":"CA-ParametersNRDC field descriptions","paragraph_zero_based":37594},{"literal_text_all_w_t_and_m_t":"ca-ParametersNR-forDC (with and without suffix)","paragraph_zero_based":37595},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the UE capabilities when NR-DC is configured with the band combination. If a version of this field (i.e., with or without suffix) is absent for a band combination, the corresponding ca-ParametersNR field version in BandCombination is applicable to the UE configured with NR-DC for the band combination. If a version of this field (i.e., with or without suffix) is present for a band combination but does not contain any parameters, the UE does not support the corresponding field version when configured with NR-DC for the band combination.","paragraph_zero_based":37596},{"literal_text_all_w_t_and_m_t":"featureSetCombinationDC","paragraph_zero_based":37597},{"literal_text_all_w_t_and_m_t":"If this field is present for a band combination, it reports the feature set combination supported for the band combination when NR-DC is configured. If this field is absent for a band combination, the featureSetCombination in BandCombination (without suffix) is applicable to the UE configured with NR-DC for the band combination.","paragraph_zero_based":37598},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37599},{"literal_text_all_w_t_and_m_t":"–CarrierAggregationVariant","paragraph_zero_based":37600},{"literal_text_all_w_t_and_m_t":"The IE CarrierAggregationVariant informs the network about supported \"placement\" of the SpCell in an NR cell group.","paragraph_zero_based":37601},{"literal_text_all_w_t_and_m_t":"CarrierAggregationVariant information element","paragraph_zero_based":37602},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":37603},{"literal_text_all_w_t_and_m_t":"-- TAG-CARRIERAGGREGATIONVARIANT-START","paragraph_zero_based":37604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":37605},{"literal_text_all_w_t_and_m_t":"CarrierAggregationVariant ::=          SEQUENCE {","paragraph_zero_based":37606},{"literal_text_all_w_t_and_m_t":"    fr1fdd-FR1TDD-CA-SpCellOnFR1FDD         ENUMERATED {supported}                      OPTIONAL,","paragraph_zero_based":37607}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["80d569272b9a8e531743cd42f67a459f92aea70179cfedd6bcdaad7164ab4a47","dd3d36daca3e56403eafe74d78700e9192cbc20c411ad2ff2bb73447c93746ba","efc7accd4a26293d9c719de429d224301a6577493f93