{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    csi-rs-ResourceList-Mobility        SEQUENCE (SIZE (1..maxNrofCSI-RS-ResourcesRRM)) OF CSI-RS-Resource-Mobility","paragraph_zero_based":21912},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21913},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21914},{"literal_text_all_w_t_and_m_t":"CSI-RS-Resource-Mobility ::=        SEQUENCE {","paragraph_zero_based":21915},{"literal_text_all_w_t_and_m_t":"    csi-RS-Index                        CSI-RS-Index,","paragraph_zero_based":21916},{"literal_text_all_w_t_and_m_t":"    slotConfig                          CHOICE {","paragraph_zero_based":21917},{"literal_text_all_w_t_and_m_t":"        ms4                                 INTEGER (0..31),","paragraph_zero_based":21918},{"literal_text_all_w_t_and_m_t":"        ms5                                 INTEGER (0..39),","paragraph_zero_based":21919},{"literal_text_all_w_t_and_m_t":"        ms10                                INTEGER (0..79),","paragraph_zero_based":21920},{"literal_text_all_w_t_and_m_t":"        ms20                                INTEGER (0..159),","paragraph_zero_based":21921},{"literal_text_all_w_t_and_m_t":"        ms40                                INTEGER (0..319)","paragraph_zero_based":21922},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21923},{"literal_text_all_w_t_and_m_t":"    associatedSSB                       SEQUENCE {","paragraph_zero_based":21924},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":21925},{"literal_text_all_w_t_and_m_t":"        isQuasiColocated                    BOOLEAN","paragraph_zero_based":21926},{"literal_text_all_w_t_and_m_t":"    }                                                                                                           OPTIONAL, -- Need R","paragraph_zero_based":21927},{"literal_text_all_w_t_and_m_t":"    frequencyDomainAllocation           CHOICE {","paragraph_zero_based":21928},{"literal_text_all_w_t_and_m_t":"        row1                                BIT STRING (SIZE (4)),","paragraph_zero_based":21929},{"literal_text_all_w_t_and_m_t":"        row2                                BIT STRING (SIZE (12))","paragraph_zero_based":21930},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21931},{"literal_text_all_w_t_and_m_t":"    firstOFDMSymbolInTimeDomain         INTEGER (0..13),","paragraph_zero_based":21932},{"literal_text_all_w_t_and_m_t":"    sequenceGenerationConfig            INTEGER (0..1023),","paragraph_zero_based":21933},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21934},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f8518e9bd2767c569a69fb95aef8bc9f056f71251b4cb748e61072aec73588c0","ecc683aa8e518fdf8e46fe05194bcc279194bc6022730a72aaf340b3d78bbd3b","a509c14cdd9ef5f58b0ee26f2f33f4619d9beecb100a3c2e1ff0eb379f02d40a","92c7cb0d78b3e6819d2010baa10e1a18018915a972b7b38d1e888ea4ab71309a","69327bce6e08c38e7dcb868f5dad6b462ef3cba729b8207a5d365f6fd644420f","99f9e46ee7ca4b6b73dc7fb70c189eb42fa106f05b41d3572a2fef46b03703d0","9857774c3df5c8ba468ec293facea1709219f9aff78c52fa8178afae7c669d6a","b76579fa0350011fe9508b4abd8b1c203c95de613a68d00b08b10b5a7e3075f6","fbe949d2029a43af8543cbcc4795d2929d316bfde497fd5a9d52fd706ff9946f","99d4517713e8e6ffa98867489104885f6a238a01ca7b623a6be11d39e91fb8c9","568eacea17001aaf2c2e3858bf120842014fd53f703746642f2c16ead52b943e","e2ff