{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    cc-IndexInOneCC-Set                 INTEGER (0..7)                                                          OPTIONAL    -- Need M","paragraph_zero_based":34728},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":34729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34730},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CARRIERSWITCHING-STOP","paragraph_zero_based":34731},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":34732},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34733},{"literal_text_all_w_t_and_m_t":"SRS-CC-SetIndex field descriptions","paragraph_zero_based":34734},{"literal_text_all_w_t_and_m_t":"cc-IndexInOneCC-Set","paragraph_zero_based":34735},{"literal_text_all_w_t_and_m_t":"Indicates the CC index in one CC set for Type A (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network always includes this field when the srs-TPC-PDCCH-Group is set to typeA.","paragraph_zero_based":34736},{"literal_text_all_w_t_and_m_t":"cc-SetIndex","paragraph_zero_based":34737},{"literal_text_all_w_t_and_m_t":"Indicates the CC set index for Type A associated (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network always includes this field when the srs-TPC-PDCCH-Group is set to typeA. The network does not configure this field to 3 in this release of specification.","paragraph_zero_based":34738},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34739},{"literal_text_all_w_t_and_m_t":"SRS-CarrierSwitching field descriptions","paragraph_zero_based":34740},{"literal_text_all_w_t_and_m_t":"monitoringCells","paragraph_zero_based":34741},{"literal_text_all_w_t_and_m_t":"A set of serving cells for monitoring PDCCH conveying SRS DCI format with CRC scrambled by TPC-SRS-RNTI (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.3).","paragraph_zero_based":34742},{"literal_text_all_w_t_and_m_t":"srs-SwitchFromServCellIndex","paragraph_zero_based":34743},{"literal_text_all_w_t_and_m_t":"Indicates the serving cell whose UL transmission may be interrupted during SRS transmission on a PUSCH-less SCell. During SRS transmission on a PUSCH-less SCell, the UE may temporarily suspend the UL transmission on a serving cell with PUSCH in the same CG to allow the PUSCH-less SCell to transmit SRS. (see TS 38.214 [19], clause 6.2.1.3).","paragraph_zero_based":34744},{"literal_text_all_w_t_and_m_t":"srs-TPC-PDCCH-Group","paragraph_zero_based":34745},{"literal_text_all_w_t_and_m_t":"Network configures the UE with either typeA-SRS-TPC-PDCCH-Group or typeB-SRS-TPC-PDCCH-Group, if any.","paragraph_zero_based":34746},{"literal_text_all_w_t_and_m_t":"typeA","paragraph_zero_based":34747},{"literal_text_all_w_t_and_m_t":"Type A trigger configuration for SRS transmission on a PUSCH-less SCell (see TS 38.213 [13], clause 11.4). In this release, the network configures at most one entry (the first entry) of typeA, and the first entry corresponds to the serving cell in which the SRS-CarrierSwitching field is configured. SRS carrier switching to SUL carrier is not supported in this version of the specification.","paragraph_zero_based":34748},{"literal_text_all_w_t_and_m_t":"typeB","paragraph_zero_based":34749},{"literal_text_all_w_t_and_m_t":"Type B trigger configuration for SRS transmission on a PUSCH-less SCell (see TS 38.213 [13], clause 11.4).","paragraph_zero_based":34750},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34751}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["33e341e0847eb7dc62c36daaf169d570160f58bc06b3ce58b0e6edce1ebc88c6","04d4e3ef567389af11ae97c663d5fe0b888692a000ce9b0c49c35624111db67a","7fa20383a5a91e6fd3a78ad8012bbfde91c3ddb93668a89f10e51b322490b5e7","89eb9f5e1495c1485805873a0397763d1e435f588b5b0f42e96f7ff0c2810681","80e27e1728772f501be73c41aea9c5ce518864860d2491b92f71b06e32c1050e","01415ff228fe0d7c5f87d8d94d808c6b8c6e6ed52ba2c5de5c11e100d3bf6b37","e1411bd8bea179218b7eef9fc103bdb9bb77d756f7f0e70a2c72c56cb55c37ea","8344939cd460988bdd3f23988039931546c53830a812f998302d5b4863086c99","58394bde26f0cba9e26c214d17fe0e956ca0c83b74072f13227bce7a44df1916","6a36ba37cdba55d29442110c37c8c394829122e0cf443fe650d96cced8b0581a","cb3df497854ab28e7658d9d5c4ae2bfa438283bf2827d83bce78cd605df84a22","1104d39f0a92c1d5cdab2272badeac4432f36143c7d53c61c87362f3db0594a8","0940f437cdb373222902aedf023cf3e2d0a03ca2b5ad3e0a556ab84e56607c50","4eefa2518d383ed571f4f56b6aa30646609c77b4698119822dd73955f5cca741","ed29df63e797d3544a5c0e72b051c6b004b6a385d482b707db83185dc959228f","059b66ca4b1e4cd44fce16cdf3e2b654f76d44542ef4abee1cbbc3ab28181d41","3cf6734a37892fd77b047d8be6e210f78576fd218f3625565fe2175d0ba0ae1d","3998070a7b5c8b49ccce9048e862f5f1dbcc0c391c6f3ef2e9b5f0bcbd179450","5a893e0b2e63bfb380d7ad557fe573b8733b49d106636a02f17840a277ee0fd7","5da8d81688add52928be63be638e0c96c5d81e56dd5464b6fd13114dee254c63","0b99c2bd41034efcee6945fd73f901807aef962e0221dc3eef9af10d59d7a381","e82b256db0fa25be28543743ebdb3ba58ae03e33096c5fb400b9905506fc4a56","ecc4763eb5dbbb3b018b63210d20c936778d09ce0319da23b16418038dd51da1","281f4340346d7c06f059631b67ebb9bf18fd16ff7cfa0aaa47d49d1dca27710a"],"paragraph_range_zero_based":[34728,34751],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p34728"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SRS-TPC-PDCCH-Config field descriptions","paragraph_zero_based":34752},{"literal_text_all_w_t_and_m_t":"srs-CC-SetIndexlist","paragraph_zero_based":34753},{"literal_text_all_w_t_and_m_t":"A list of pairs of [cc-SetIndex; cc-IndexInOneCC-Set] (see TS 38.212 [17], TS 38.213 [13], clause 7.3.1, 11.4). The network does not configure this field for typeB.","paragraph_zero_based":34754},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34755},{"literal_text_all_w_t_and_m_t":"–SRS-Config","paragraph_zero_based":34756},{"literal_text_all_w_t_and_m_t":"The IE SRS-Config is used to configure sounding reference signal transmissions. The configuration defines a list of SRS-Resources, a list of SRS-PosResources, a list of SRS-PosResourceSets and a list of SRS-ResourceSets. Each resource set defines a set of SRS-Resources or SRS-PosResources. The network triggers the transmission of the set of SRS-Resources or SRS-PosResources using a configured aperiodicSRS-ResourceTrigger (L1 DCI). The network does not configure SRS specific power control parameters alpha (without suffix) or pathlossReferenceRS if unifiedTCI-StateType is configured for the serving cell.","paragraph_zero_based":34757},{"literal_text_all_w_t_and_m_t":"SRS-Config information element","paragraph_zero_based":34758},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":34759},{"literal_text_all_w_t_and_m_t":"-- TAG-SRS-CONFIG-START","paragraph_zero_based":34760},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":34761},{"literal_text_all_w_t_and_m_t":"SRS-Config ::=                          SEQUENCE {","paragraph_zero_based":34762},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseList            SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL,   -- Need N","paragraph_zero_based":34763},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModList             SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL,   -- Need N","paragraph_zero_based":34764},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToReleaseList               SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-ResourceId              OPTIONAL,   -- Need N","paragraph_zero_based":34765},{"literal_text_all_w_t_and_m_t":"    srs-ResourceToAddModList                SEQUENCE (SIZE(1..maxNrofSRS-Resources)) OF SRS-Resource                OPTIONAL,   -- Need N","paragraph_zero_based":34766},{"literal_text_all_w_t_and_m_t":"    tpc-Accumulation                        ENUMERATED {disabled}                                                   OPTIONAL,   -- Need S","paragraph_zero_based":34767},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":34768},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":34769},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-1-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":34770},{"literal_text_all_w_t_and_m_t":"    srs-RequestDCI-0-2-r16                  INTEGER (1..2)                                                          OPTIONAL, -- Need S","paragraph_zero_based":34771},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToAddModListDCI-0-2-r16  SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSet          OPTIONAL, -- Need N","paragraph_zero_based":34772},{"literal_text_all_w_t_and_m_t":"    srs-ResourceSetToReleaseListDCI-0-2-r16 SEQUENCE (SIZE(1..maxNrofSRS-ResourceSets)) OF SRS-ResourceSetId        OPTIONAL, -- Need N","paragraph_zero_based":34773},{"literal_text_all_w_t_and_m_t":"    srs-PosResourceSetToReleaseList-r16     SEQUENCE (SIZE(1..maxNrofSRS-PosResourceSets-r16)) OF SRS-PosResourceSetId-r16","paragraph_zero_based":34774},{"literal_te