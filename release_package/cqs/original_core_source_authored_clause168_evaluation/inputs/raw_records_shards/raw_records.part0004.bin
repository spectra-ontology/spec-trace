:R2-2403537 RRC.docx:p33456"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"        semiStatic                          SemiStaticChannelAccessConfig-r16","paragraph_zero_based":33480},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":33481},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r16          ENUMERATED {ms0dot5, ms1, ms2, ms3, ms4, ms5}                   OPTIONAL, -- Need R","paragraph_zero_based":33482},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r16                     SSB-PositionQCL-Relation-r16                                    OPTIONAL, -- Cond SharedSpectrum","paragraph_zero_based":33483},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-r16                     HighSpeedConfig-r16                                             OPTIONAL  -- Need R","paragraph_zero_based":33484},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33485},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33486},{"literal_text_all_w_t_and_m_t":"    highSpeedConfig-v1700               HighSpeedConfig-v1700                                               OPTIONAL, -- Need R","paragraph_zero_based":33487},{"literal_text_all_w_t_and_m_t":"    channelAccessMode2-r17              ENUMERATED {enabled}                                                OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":33488},{"literal_text_all_w_t_and_m_t":"    discoveryBurstWindowLength-r17      ENUMERATED {ms0dot125, ms0dot25, ms0dot5, ms0dot75, ms1, ms1dot25}  OPTIONAL, -- Need R","paragraph_zero_based":33489},{"literal_text_all_w_t_and_m_t":"    ssb-PositionQCL-r17                 SSB-PositionQCL-Relation-r17                                        OPTIONAL, -- Cond SharedSpectrum2","paragraph_zero_based":33490},{"literal_text_all_w_t_and_m_t":"    highSpeedConfigFR2-r17              HighSpeedConfigFR2-r17                                              OPTIONAL, -- Need R","paragraph_zero_based":33491},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon-v1700            UplinkConfigCommon-v1700                                            OPTIONAL, -- Need R","paragraph_zero_based":33492},{"literal_text_all_w_t_and_m_t":"    ntn-Config-r17                      NTN-Config-r17                                                      OPTIONAL  -- Need R","paragraph_zero_based":33493},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33494},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33495},{"literal_text_all_w_t_and_m_t":"    featurePriorities-r17               SEQUENCE {","paragraph_zero_based":33496},{"literal_text_all_w_t_and_m_t":"        redCapPriority-r17                  FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33497},{"literal_text_all_w_t_and_m_t":"        slicingPriority-r17                 FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33498},{"literal_text_all_w_t_and_m_t":"        msg3-Repetitions-Priority-r17       FeaturePriority-r17                                             OPTIONAL, -- Need R","paragraph_zero_based":33499},{"literal_text_all_w_t_and_m_t":"        sdt-Priority-r17                    FeaturePriority-r17                                             OPTIONAL  -- Need R","paragraph_zero_based":33500},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL  -- Need R","paragraph_zero_based":33501},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33502},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33503}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b5d0ae42e584b76eddf9ab52dda0155f021a46e3769bfe6ec61d653d78040c2d","89a705255c6cbe13defe0ff0899a202f77673497ef2f939930190db378ca8153","4a0f7b460ca7a2b04bc435737b3b58a8583d4b53f9edd74ef7e8af6d2f2d7157","08da4cdb02a2a68565d692f1b7ef1caabb6201364029074100643109afc1ea31","72300460e5bbe93ba47aa40ef13eb9aba63f940a5c30f86ce69ab57780794a88","0399dfcb9c4777ac7e0267177c5d972af6cee9638e1f7c53efa3e7fc263746fa","d8da9436bc941b4881c6597028dcf6ebd0cce08b59b4d2e71970044a4b59e2df","e2160405738f37e45dc45ad4d8b12e89ffb46c1ea301f6297ece8dafb96be1ec","a5278940ff869cc46dc76b7371524484b32adf3d2356a514b5ce78458832f768","9baa279212ddf0e86d85b0a32079bf3691fed6f1203c24cf6a1a23a907a96201","8d8aa5771d683dff8990433b16b86344d9a348fe572e9b5f57679573db8a4e48","91bfc860e10c4c39d0c391f3e02fec0e2ddf71e0ae6b7459aa66cbcd25341c1d","4b0cbff955c57da02c9fd8bc60283074b3d8ab84a285be926a63bb7e218c5ab2","d5657d338beec563a3475bf2b2ea24fa4940f12fff29672b128f21f9b7ab53ba","1e0b33a2ef92cf30da66c0f89e67a2b43b884c2a256e94be340c6260e6d79666","71bbc410247a9507e80922d0c9e35cbb2bf54b748998a2ea7495d37beff363dc","b43ad10ed42da8b86cfbaebad416fb1784ace57fd32ad7cd0e6f976fddbfcfe8","96d30e6737cea5d96861e279552e3ba3dcbee811d8c36b311cb0942c2ff49d13","6d69ec9b9c6d2fda898d8fe84ac39243fc80f1282b38d245989ed8efe55a34e0","75886d6c05a3943f53ef97ccea411f47a1c99c1eb3611599a8213b3cea19845e","e9507f4c48ef5e533c915e7eff719bcba48692c18cb3d981d7ad0dc13a382059","55db90212b7be90eb1ade8c590c3ef1a643975b2f283e545afd1da174556028e","002a2355a0a073c8453182dda4fc3ea3b654e5ccc363ae53170de3a0401ebe85","6b4128845efbf1ee964775fd3a7be144f422e667ffa2c99639792e65970707ab"],"paragraph_range_zero_based":[33480,33503],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33480"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ra-ChannelAccess-r17            ENUMERATED {enabled}                                                OPTIONAL -- Cond SharedSpectrum2","paragraph_zero_based":33504},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":33505},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33506},{"literal_text_all_w_t_and_m_t":"    featurePriorities-v1800             SEQUENCE {","paragraph_zero_based":33507},{"literal_text_all_w_t_and_m_t":"        msg1-Repetitions-Priority-r18       FeaturePriority-r17                                             OPTIONAL,","paragraph_zero_based":33508},{"literal_text_all_w_t_and_m_t":"        eRedCapPriority-r18                 FeaturePriority-r17                                             OPTIONAL -- Need R","paragraph_zero_based":33509},{"literal_text_all_w_t_and_m_t":"    }                                                                                                       OPTIONAL, -- Need R","paragraph_zero_based":33510},{"literal_text_all_w_t_and_m_t":"    atg-Config-r18                      ATG-Config-r18                                                      OPTIONAL  -- Need R","paragraph_zero_based":33511},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":33512},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33513},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33514},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMON-STOP","paragraph_zero_based":33515},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33516},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33517},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommon field descriptions","paragraph_zero_based":33518},{"literal_text_all_w_t_and_m_t":"channelAccessMode","paragraph_zero_based":33519},{"literal_text_all_w_t_and_m_t":"If present, this field indicates which channel access procedures to apply for operation with shared spectrum channel access as defined in TS 37.213 [48]. If the field is configured as \"semiStatic\", the UE shall apply the channel access procedures for semi-static channel occupancy as described in clause 4.3 in TS 37.213. If the field is configured as \"dynamic\", the UE shall apply the channel access procedures as defined in TS 37.213, clause 4.1 and 4.2.","paragraph_zero_based":33520},{"literal_text_all_w_t_and_m_t":"channelAccessMode2","paragraph_zero_based":33521},{"literal_text_all_w_t_and_m_t":"If present, the UE shall apply channel access procedures for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4 for FR2-2. If absent, the UE shall not apply any channel access procedure. The network always configures this field if channel access procedures are required for the serving cell within this region by regulations.","paragraph_zero_based":33522},{"literal_text_all_w_t_and_m_t":"dmrs-TypeA-Position","paragraph_zero_based":33523},{"literal_text_all_w_t_and_m_t":"Position of (first) DM-RS for downlink (see TS 38.211 [16], clause 7.4.1.1.1) and uplink (TS 38.211 [16], clause 6.4.1.1.3).","paragraph_zero_based":33524},{"literal_text_all_w_t_and_m_t":"downlinkConfigCommon","paragraph_zero_based":33525},{"literal_text_all_w_t_and_m_t":"The common downlink configuration of the serving cell, including the frequency information configuration and the initial downlink BWP common configuration. The parameters provided herein should match the parameters configured by MIB and SIB1 (if provided) of the serving cell, with the exception of controlResourceSetZero and searchSpaceZero which can be configured in ServingCellConfigCommon even if MIB indicates that they are absent.","paragraph_zero_based":33526},{"literal_text_all_w_t_and_m_t":"discoveryBurstWindowLength","paragraph_zero_based":33527}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8c1dedb0b05307e1b153ba83e8d362096ad17b2b387ba1c1de569d6441eca908","af14e5fc678c7cb465c8aea9899c83cbcbb38f1ff8e940377134a98cdfa6d924","1ade68020d8e4aa02948efa1fd982bd7f101e6a8a10208e228c07f4609fb1379","992f674f0a3294e0d59c04429dcf92848fe69e8f238d2efb095771fe60dd0ed2","a1d12575ce66988ed268204cc2f4e884b711c66994422f9effe1db61673fa44a","5da6c9642286b1583e19a7b374cf0d5a64971122e9e04688acc531c13e948e98","0231bfd273e1a2a5e2d8a874ae7f5cb81977b1aedfc73363199498d9b465ed94","c55b127384abf5f5ae2433a6cda855914b786cc7a2669c1367704a81e957eec2","cc1a94f261e5a92ec34889a45c97edc1e54825dfbafa9e94763d4fe62346bf52","619a896a65e6450888ff2b0f2345e37c8f486821bc91153a94889c781e7555fb","1aabe67c82c68ccae3f548492332520dab29b7f508eee45f003d352674641d06","e7bf7d548d451d4cd581f6f9f1839929f32fdd3caf077a3e8aa38b33f166e62a","cfb9edaa125a679a0e9e14c8a1c39a4cb62b85da7c301f7f45071d037e2756cc","3ea532e53eb5973f9fa6de54b82c24c333c3f3f955398fcb8ea82ad42b5f9d87","3478db66f303ccd1b2bee411b7be8a8d7a82fd217deba310482125910a55ecc4","2c91f4b5c4a7ba2284649d5bfbee1e67a08cdd604a120743f8dcbfff4859c9bb","9fc15050ee853f35c479528735badbb421f3d10030c11bb34b9e668581da4ed3","abf4b63f635a55154c234877f312cb78d6f76d26137bd0cb092da7858caea45b","88d67fc2d0cb34e9a1360ff4df1786b011a36dfd333f90dc3a65d2281b5a6ef6","a42d55e484727d0372990e19ee62411c78245a235ae280b8601024d6c336d4bc","994c070d793df661f8dd393d49b958b3d36c1ea9f9938d3d1f0e826299bcc232","e59708341667e6950aea9d068aa7d8ff86bca4cf2b1d486c9bdd85a6b79f0105","b29b047a26fd32b459bb736ac8f9480b68c25de95dca22f144c8295c79556d7a","7cc9781d3295584810b006c5476df6793c8b6b5ffef2bdc22d0312c1baadbf2e"],"paragraph_range_zero_based":[33504,33527],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33504"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Indicates the window length of the discovery burst in ms (see TS 37.213 [48]). The field discoveryBurstWindowLength-r17 is applicable to SCS 480 kHz and SCS 960 kHz.","paragraph_zero_based":33528},{"literal_text_all_w_t_and_m_t":"featurePriorities","paragraph_zero_based":33529},{"literal_text_all_w_t_and_m_t":"Indicates priorities for features, such as (e)RedCap, Slicing, SDT, MSG1-Repetitions, and MSG3-Repetitions for Coverage Enhancements. These priorities are used to determine which FeatureCombinationPreambles the UE shall use when a feature maps to more than one FeatureCombinationPreambles, as specified in TS 38.321 [3]. A lower value means a higher priority. The network does not signal the same priority for more than one feature. The network signals a priority for all feature that map to at least one FeatureCombinationPreambles.","paragraph_zero_based":33530},{"literal_text_all_w_t_and_m_t":"longBitmap","paragraph_zero_based":33531},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 64 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33532},{"literal_text_all_w_t_and_m_t":"lte-CRS-ToMatchAround","paragraph_zero_based":33533},{"literal_text_all_w_t_and_m_t":"Parameters to determine an LTE CRS pattern that the UE shall rate match around.","paragraph_zero_based":33534},{"literal_text_all_w_t_and_m_t":"mediumBitmap","paragraph_zero_based":33535},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 8 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33536},{"literal_text_all_w_t_and_m_t":"n-TimingAdvanceOffset","paragraph_zero_based":33537},{"literal_text_all_w_t_and_m_t":"The N_TA-Offset to be applied for all uplink transmissions on this serving cell if n-TimingAdvanceOffset is not configured. If tag2 is configured for this serving cell, this field is to be applied to all uplink transmissions associated to tag-id configured for this serving cell. If the field is absent, the UE applies the value defined for the duplex mode and frequency range of this serving cell. See TS 38.133 [14], table 7.1.2-2.","paragraph_zero_based":33538},{"literal_text_all_w_t_and_m_t":"ra-ChannelAccess","paragraph_zero_based":33539},{"literal_text_all_w_t_and_m_t":"If present, this field indicates that the UE shall apply channel access procedures before msg1/msgA transmission for operation with shared spectrum channel access in accordance with TS 37.213 [48], clause 4.4.5 for FR2-2.","paragraph_zero_based":33540},{"literal_text_all_w_t_and_m_t":"rateMatchPatternToAddModList","paragraph_zero_based":33541},{"literal_text_all_w_t_and_m_t":"Resources patterns which the UE should rate match PDSCH around. The UE rate matches around the union of all resources indicated in the rate match patterns. Rate match patterns defined here on cell level apply only to PDSCH of the same numerology (see TS 38.214 [19], clause 5.1.4.1). If a RateMatchPattern with the same RateMatchPatternId is configured in both ServingCellConfig/ServingCellConfigCommon and in SIB20/MCCH, the entire RateMatchPattern configuration, including the set of RBs/REs indicated by the patterns for the rate matching around, shall be the same and they are counted as a single rate match pattern in the total configured rate match patterns as defined in TS 38.214 [19].","paragraph_zero_based":33542},{"literal_text_all_w_t_and_m_t":"shortBitmap","paragraph_zero_based":33543},{"literal_text_all_w_t_and_m_t":"Bitmap when maximum number of SS/PBCH blocks per half frame equals to 4 as defined in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33544},{"literal_text_all_w_t_and_m_t":"ss-PBCH-BlockPower","paragraph_zero_based":33545},{"literal_text_all_w_t_and_m_t":"Average EPRE of the resources elements that carry secondary synchronization signals in dBm that the NW used for SSB transmission, see TS 38.213 [13], clause 7.","paragraph_zero_based":33546},{"literal_text_all_w_t_and_m_t":"ssb-periodicityServingCell","paragraph_zero_based":33547},{"literal_text_all_w_t_and_m_t":"The SSB periodicity in ms for the rate matching purpose. If the field is absent, the UE applies the value ms5. (see TS 38.213 [13], clause 4.1)","paragraph_zero_based":33548},{"literal_text_all_w_t_and_m_t":"ssb-PositionQCL","paragraph_zero_based":33549},{"literal_text_all_w_t_and_m_t":"Indicates the QCL relation between SSB positions for this serving cell as specified in TS 38.213 [13], clause 4.1.","paragraph_zero_based":33550},{"literal_text_all_w_t_and_m_t":"ssb-PositionsInBurst","paragraph_zero_based":33551}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["d576f3e8fbf9df2cae5807f57ab2ef2729619003ae9ba99d577307f42fa01183","95c4fdb77bedf12304eb107b69b874441e1b7e0687e5984ec7374a17b6b428f9","57c34761c5686c9d3f32a3ac25aca67c230f9338e2dc1d47605676ff625d8a3c","5cef33f05f990c27b36391822865d26e15dafcfdc044171d8bbe6ffa674607b3","6acff9f895b7ebca108c078695779c212e88f9411aae6b8d839d35458f903587","8f58b7dec882bc813b4d32835a95e7e56bf5f54acf141b87aea98813e6e7b718","380a1fbdf504e4e924e7298493eacf9eca3092d5073980e213c1f19aa79f2d79","c1a24880bb76c3056ff813a45fd6382d9474a3c7a93751abe1ef7c2bfaf9c242","6c23c6250d4e44cf4bb7aba6f78ab3ae98850a4ccd3e6ac4afe196e5eac36b31","148a111def530aba192790decdfc3f1fc3924fc63b378edf14e7b4d0031406b2","c1c9e400633b0ab45911811712ca542f836659bec0892e73167ece59c30de34f","255aae92c048a8dfe0a4f62ade6e6eb0ae4b6b0908b611e882f13de7a10ce38b","bb73fc3a2399c6fd565dc59277ef7428eb0d8ccf57c8c4e6e45a90c700dfd3ad","9d94bb97cadd2b07f79f15d9cb9692975f98f434e538d8381108f784e164bc75","6ce22ddf1819f32f5a858897638897b80d7169b6c376ea78cbdec262f2b4069b","c50d1da45c7b3d7597c1a96b4dbbbaeb6fb941ad07f9374814adaac540a2a4fa","4ab6824e010f997119e60f56339c3f62f56742ff0836e284aeffc41800617b38","f10ca3d33463e982ef1f5d1779e7a21e6b82521bf003d177ac2ad49ddab437f2","70dfb4a9ef3482db6456878b388e907b24f6beaf06cb9da91c95ec1237afd9bc","589111175373d613ee853bfe2392305971fa8bfdf31863a377303f3a09dd6006","2a18793cbfb6427ac198457a9b3b374ab27fbe47b6aabc2c4cc321ad5c72f4d3","f7a58ea20ce30c7284c0b4765fc1cfad7847512e0168257e156575675ec53948","15e24a37d342f5a7339a846d7ed197e60257380e0a268f0e76f28929e5a9066f","4622c6aadc09311abb3aa5b2cc5f0af40e8cf68952d12736b14d0123ece1ada7"],"paragraph_range_zero_based":[33528,33551],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33528"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"For operation in licensed spectrum, indicates the time domain positions of the transmitted SS-blocks in a half frame with SS/PBCH blocks as defined in TS 38.213 [13], clause 4.1. The first/leftmost bit corresponds to SS/PBCH block index 0, the second bit corresponds to SS/PBCH block index 1, and so on. Value 0 in the bitmap indicates that the corresponding SS/PBCH block is not transmitted while value 1 indicates that the corresponding SS/PBCH block is transmitted. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB.","paragraph_zero_based":33552},{"literal_text_all_w_t_and_m_t":"For operation with shared spectrum channel access, the UE assumes that one or more SS/PBCH blocks indicated by ssb-PositionsInBurst may be transmitted within the discovery burst transmission window and have candidate SS/PBCH blocks indexes corresponding to SS/PBCH block indexes provided by ssb-PositionsInBurst (see TS 38.213 [13], clause 4.1). If the k-th bit of ssb-PositionsInBurst is set to 1, the UE assumes that one or more SS/PBCH blocks within the discovery burst transmission window with candidate SS/PBCH block indexes corresponding to SS/PBCH block index equal to k – 1 may be transmitted; if the kt-th bit is set to 0, the UE assumes that the corresponding SS/PBCH block(s) are not transmitted. The k-th bit is set to 0, where k > ssb-PositionQCL and the number of actually transmitted SS/PBCH blocks is not larger than the number of 1's in the bitmap. The network configures the same pattern in this field as in the corresponding field in ServingCellConfigCommonSIB. For operation with shared spectrum channel access in FR1, only mediumBitmap is used, and for FR2-2, longBitmap is used.","paragraph_zero_based":33553},{"literal_text_all_w_t_and_m_t":"ssbSubcarrierSpacing","paragraph_zero_based":33554},{"literal_text_all_w_t_and_m_t":"Subcarrier spacing of SSB.","paragraph_zero_based":33555},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":33556},{"literal_text_all_w_t_and_m_t":"FR1:   15 or 30 kHz","paragraph_zero_based":33557},{"literal_text_all_w_t_and_m_t":"FR2-1:  120 or 240 kHz","paragraph_zero_based":33558},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":33559},{"literal_text_all_w_t_and_m_t":"supplementaryUplinkConfig","paragraph_zero_based":33560},{"literal_text_all_w_t_and_m_t":"The network configures this field only if uplinkConfigCommon is configured. If this field is absent, the UE shall release the supplementaryUplinkConfig and the supplementaryUplink configured in ServingCellConfig of this serving cell, if configured.","paragraph_zero_based":33561},{"literal_text_all_w_t_and_m_t":"tdd-UL-DL-ConfigurationCommon","paragraph_zero_based":33562},{"literal_text_all_w_t_and_m_t":"A cell-specific TDD UL/DL configuration, see TS 38.213 [13], clause 11.1.","paragraph_zero_based":33563},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33564},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":33565},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":33566},{"literal_text_all_w_t_and_m_t":"AbsFreqSSB","paragraph_zero_based":33567},{"literal_text_all_w_t_and_m_t":"The field is absent when absoluteFrequencySSB in frequencyInfoDL is absent, otherwise the field is mandatory present.","paragraph_zero_based":33568},{"literal_text_all_w_t_and_m_t":"HOAndServCellAdd","paragraph_zero_based":33569},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change (including path switch between a serving cell and a L2 U2N Relay UE) and upon serving cell (PSCell/SCell) addition. Otherwise, the field is absent.","paragraph_zero_based":33570},{"literal_text_all_w_t_and_m_t":"HOAndServCellWithSSB","paragraph_zero_based":33571},{"literal_text_all_w_t_and_m_t":"This field is mandatory present upon SpCell change and upon serving cell (SCell with SSB or PSCell) addition. Otherwise, the field is absent.","paragraph_zero_based":33572},{"literal_text_all_w_t_and_m_t":"SharedSpectrum","paragraph_zero_based":33573},{"literal_text_all_w_t_and_m_t":"This field is mandatory present if this cell operates with shared spectrum channel access in FR1. Otherwise, it is absent, Need R.","paragraph_zero_based":33574},{"literal_text_all_w_t_and_m_t":"SharedSpectrum2","paragraph_zero_based":33575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["26f8040ee5f9b22e5d2a0ad2e759bca250f4e181ae46d8a7a952b3ff27923ea4","d061e969d57c299a5b806233075302dcb564227f0c993fde2145a2b7082d0400","361ea3e32d15eebb9066f088c4cc3be3bc82257f114e63fca32c3d37b020b4f1","fcfaacac6c2dc6e75662ae2bd4824923ef7f6f2fddc9a5adeece8328e714c220","85c7a33b5cc7bfcb5147611f49339c0e59b31e6e2201eba702e56bf9e656e54c","660ea053a8dd7c08db970889713c27e34143d720d092101c74087602a404991b","d9d02570823a14718e9dfe0c6001dde00fc3829b138b07db6a97822adf33cb76","9a2e6aace1183a9bc2f55f1f1fb1b3397e34620b0399dcb1f4341b1297d1db79","35e04a57a776f9689111e9cb2194f406772b6eef0200e83a747bbec2c18025d4","6c2cc60cef7a4a61a9a0ccbeec00cfe5e3075ab488d28d3164b11d843c824547","ba7a5c7c2577b56a9abd7aef9a23611a815b9736cf5c179d9f6b6f1ba8149cc8","358b38e040af8588da7aa9bf52e400e7072f4d389e2eb504280ff0721f412c52","d3ecdcbdeca62eae612774564a4a010316563c13624c3e8d8ac678e440aab35c","c247c7d78f084794156756f4e67db080e90ba5da5b0c523f20ae85c27ed83796","7c058071f59553dd4402fd5ea31fd391237dad7035a3e00a7b22d6b962c35bf5","f04789eb5083b901bcc0e20ee9dd34592405de4fc4f0738df554b68a1bd2d697","3abf6f309205196bca2baa4cc22a3ec34eeaa6a6224966543ea9c965be80fed3","dfd4b7213590da113be1087ac358f4b9ba17a018cbe39bfd7e9bdcfdf8a9b885","412b31495b5696dfaf55440eaa6dc7855b1ff2d0fbb72504a3619c265bb6b663","c4b80dc5bae0a9ca3f4c803f0a3cbe813dd73d705ffe85e8da9e01bf6da9c7d6","2491db78761fa4b24a65f434cc4a720469dcfe72b8ec0b70b206729d45743c1d","ef7a2a650ad411a0c90632b52bf1123b4689bbf0d0025eb375128dff08276e02","f93aa327d730c2190f461581c773886eaa5d0939ad5a422a8965630a574fe443","d926e2437d8eb0d59190df8aef6689f2542fc58766512c4d94c1ca984ff23170"],"paragraph_range_zero_based":[33552,33575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p33552"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field is optionally present if this cell operates with shared spectrum channel access in FR2-2, Need R. Otherwise, it is absent, Need R.","paragraph_zero_based":33576},{"literal_text_all_w_t_and_m_t":"TDD","paragraph_zero_based":33577},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, for TDD cells; otherwise it is absent.","paragraph_zero_based":33578},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33579},{"literal_text_all_w_t_and_m_t":"–ServingCellConfigCommonSIB","paragraph_zero_based":33580},{"literal_text_all_w_t_and_m_t":"The IE ServingCellConfigCommonSIB is used to configure cell specific parameters of a UE's serving cell in SIB1.","paragraph_zero_based":33581},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB information element","paragraph_zero_based":33582},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33583},{"literal_text_all_w_t_and_m_t":"-- TAG-SERVINGCELLCONFIGCOMMONSIB-START","paragraph_zero_based":33584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33585},{"literal_text_all_w_t_and_m_t":"ServingCellConfigCommonSIB ::=      SEQUENCE {","paragraph_zero_based":33586},{"literal_text_all_w_t_and_m_t":"    downlinkConfigCommon                DownlinkConfigCommonSIB,","paragraph_zero_based":33587},{"literal_text_all_w_t_and_m_t":"    uplinkConfigCommon                  UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":33588},{"literal_text_all_w_t_and_m_t":"    supplementaryUplink                 UplinkConfigCommonSIB                                       OPTIONAL, -- Need R","paragraph_zero_based":33589},{"literal_text_all_w_t_and_m_t":"    n-TimingAdvanceOffset               ENUMERATED { n0, n25600, n39936 }                           OPTIONAL, -- Need S","paragraph_zero_based":33590},{"literal_text_all_w_t_and_m_t":"    ssb-PositionsInBurst                SEQUENCE {","paragraph_zero_based":33591},{"literal_text_all_w_t_and_m_t":"        inOneGroup                          BIT STRING (SIZE (8)),","paragraph_zero_based":33592},{"literal_text_all_w_t_and_m_t":"        groupPresence                       BIT STRING (SIZE (8))                                   OPTIONAL  -- Cond FR2-Only","paragraph_zero_based":33593},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":33594},{"literal_text_all_w_t_and_m_t":"    ssb-PeriodicityServingCell          ENUMERATED {ms5, ms10, ms20, ms40, ms80, ms160},","paragraph_zero_based":33595},{"literal_text_all_w_t_and_m_t":"    tdd-UL-DL-ConfigurationCommon       TDD-UL-DL-ConfigCommon                                      OPTIONAL, -- Cond TDD","paragraph_zero_based":33596},{"literal_text_all_w_t_and_m_t":"    ss-PBCH-BlockPower                  INTEGER (-60..50),","paragraph_zero_based":33597},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":33598},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":33599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["502df2101d6583f923355c6850e084f52f101d606435bb0131e3590edc79b179","2c425ad3c0089a1bbb9b9f8a5c3770a87a05c77db40135484fcbf7c6d3074355","35c4e67ea8f4dee783a9e38f4aba1defcc58d3716fafdae804f78407ec5153a5","a7851834070a7e1ecb7a4b7c5732b98e0d37957aa484ecaaecddcf24ee81d536","700bcafbf92675ee695105e90dc0229a565a1f8109fe05e1f3da3cdc9224fc6b","16dd50fa102cb6afed4cfa07051815a5d0970d779f22c34b98e59c13e27da186","28fa17da768ceae6b898474fdc9af31ea53ab10413d806b66294d1fc1752b38d","d5d26f3bf781