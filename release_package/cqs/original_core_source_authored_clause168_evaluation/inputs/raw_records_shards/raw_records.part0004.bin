b3d215b83ea01f3106dc49ca","dceec2852cf2046bdd965d4b176853d803c8ba70ca156a7471bfb3924f348a7c","77b31909da30ae3bce3cceed91f86dfd6e9e0b69895803fc332df47b9bd184d6","4da2223c3700f3fcdf638dc5409eae8a979d59a90e3903b78adcffc9671d1a39","727b52e8553fc56da39c84ad1d38fa775089fe8ffe42ac25caf2c1a88d86c0a9","e0fd07543947e4ce69e05200a92d255437b1a18d268332fc83ea726841b6ad5a","e98107278ea6d1cb7a183e36dd41753e6d52c0364cb3922a0870f88b3104d93f","4022a81f4e3b4aebb2edf61edf00e6bbacd52957963c4164ac3f426db29e7257","2028a258ff6d56bdc834f2a30d6733d7dd94701308e106f57e1e392a6862d788","14058d75c52435c7a1300322833e063f5bf49a1e585747dfea1e6a5a915fe903","bc9b6bd40ddb95b9a8248e2c1b50d43a3cdff9706de491e410f0371ac6dda18b"],"paragraph_range_zero_based":[38424,38447],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p38424"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38448},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlink field descriptions","paragraph_zero_based":38449},{"literal_text_all_w_t_and_m_t":"featureSetListPerDownlinkCC","paragraph_zero_based":38450},{"literal_text_all_w_t_and_m_t":"Indicates which features the UE supports on the individual DL carriers of the feature set (and hence of a band entry that refer to the feature set). The UE shall hence include at least as many FeatureSetDownlinkPerCC-Id in this list as the number of carriers it supports according to the ca-BandwidthClassDL, except if indicating additional functionality by reducing the number of FeatureSetDownlinkPerCC-Id in the feature set (see NOTE 1 in FeatureSetCombination IE description). The order of the elements in this list is not relevant, i.e., the network may configure any of the carriers in accordance with any of the FeatureSetDownlinkPerCC-Id in this list.","paragraph_zero_based":38451},{"literal_text_all_w_t_and_m_t":"supportedSRS-Resources","paragraph_zero_based":38452},{"literal_text_all_w_t_and_m_t":"Indicates supported SRS resources for SRS carrier switching to the band associated with this FeatureSetDownlink. The UE is only allowed to set this field for a band with associated FeatureSetUplinkId set to 0.","paragraph_zero_based":38453},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38454},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkId","paragraph_zero_based":38455},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkId identifies a downlink feature set. The FeatureSetDownlinkId of a FeatureSetDownlink is the index position of the FeatureSetDownlink in the featureSetsDownlink list in the FeatureSets IE. The first element in that list is referred to by FeatureSetDownlinkId = 1. The FeatureSetDownlinkId=0 is not used by an actual FeatureSetDownlink but means that the UE does not support a carrier in this band of a band combination.","paragraph_zero_based":38456},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId information element","paragraph_zero_based":38457},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38458},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-START","paragraph_zero_based":38459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38460},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkId ::=            INTEGER (0..maxDownlinkFeatureSets)","paragraph_zero_based":38461},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38462},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKID-STOP","paragraph_zero_based":38463},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38464},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38465},{"literal_text_all_w_t_and_m_t":"–FeatureSetDownlinkPerCC","paragraph_zero_based":38466},{"literal_text_all_w_t_and_m_t":"The IE FeatureSetDownlinkPerCC indicates a set of features that the UE supports on the corresponding carrier of one band entry of a band combination.","paragraph_zero_based":38467},{"literal_text_all_w_t_and_m_t":"FeatureSetDownlinkPerCC information element","paragraph_zero_based":38468},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":38469},{"literal_text_all_w_t_and_m_t":"-- TAG-FEATURESETDOWNLINKPERCC-START","paragraph_zero_based":38470},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["47968f42299b10688a65d096940db288fe251048c60bff6400c4