{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ReselectionThresholdQ information element","paragraph_zero_based":32328},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32329},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLDQ-START","paragraph_zero_based":32330},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32331},{"literal_text_all_w_t_and_m_t":"ReselectionThresholdQ ::=           INTEGER (0..31)","paragraph_zero_based":32332},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32333},{"literal_text_all_w_t_and_m_t":"-- TAG-RESELECTIONTHRESHOLDQ-STOP","paragraph_zero_based":32334},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32335},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32336},{"literal_text_all_w_t_and_m_t":"–ResumeCause","paragraph_zero_based":32337},{"literal_text_all_w_t_and_m_t":"The IE ResumeCause is used to indicate the resume cause in RRCResumeRequest, RRCResumeRequest1 and UEAssistanceInformation.","paragraph_zero_based":32338},{"literal_text_all_w_t_and_m_t":"ResumeCause information element","paragraph_zero_based":32339},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32340},{"literal_text_all_w_t_and_m_t":"-- TAG-RESUMECAUSE-START","paragraph_zero_based":32341},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32342},{"literal_text_all_w_t_and_m_t":"ResumeCause ::=             ENUMERATED {emergency, highPriorityAccess, mt-Access, mo-Signalling,","paragraph_zero_based":32343},{"literal_text_all_w_t_and_m_t":"                                        mo-Data, mo-VoiceCall, mo-VideoCall, mo-SMS, rna-Update, mps-PriorityAccess,","paragraph_zero_based":32344},{"literal_text_all_w_t_and_m_t":"                                        mcs-PriorityAccess, mt-SDT-v1810, srs-PosConfigOrActivationReq-v1800, spare3, spare2, spare1 }","paragraph_zero_based":32345},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32346},{"literal_text_all_w_t_and_m_t":"-- TAG-RESUMECAUSE-STOP","paragraph_zero_based":32347},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32348},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32349},{"literal_text_all_w_t_and_m_t":"–RLC-BearerConfig","paragraph_zero_based":32350},{"literal_text_all_w_t_and_m_t":"The IE RLC-BearerConfig is used to configure an RLC entity, a corresponding logical channel in MAC and the linking to a PDCP entity (served radio bearer).","paragraph_zero_based":32351}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f81e2ed31d445b60140224d8a89a53a3688c1cf6a76b1aeaccb8b977528a576e","770120f5ca6d97ddeeeec3365affc20a9310d5cb53ea96059f807755dc3d7f90","6d4cbab4292ebf9a6bff9528b318d1f8db4faebba3416c9379f076f27ff5c5e3","6565129f0f434e53e3dd52c1ce77a8efc84e0a54fe89ce3338018547be51b360","fe3f9b948894fc148ac9577d820981fc182d25590ef26eb39dec242bdf59c790","6dbd2b70ffc8528e199c14fd489fa34c86337a37821496431241e4a10e5f770e","ae94bd881e977b989d01d16c15828f2fac8ff9f315658645f3b0199b52b1ae42","756afcb1e7996b7d76f2af97e92802903b7448e2bc91ed004ab3000c12f135f0","a2774d17d6c13792dc54b0acfb243ecc6ee02db1908992e8e295c3c536d652e1","0941fb9bedcf9390b563fd5cf335cab228bc824640d25010f569b605e6c5563f","1a1e887ad58d6b0ba27e6585e24b54b3f2235d009f2e516c14197bd8e90468e4","2a221f8f86c69586e2dc647df5d9e6c3cd0e35c62d00fa3fd422eff2b55ec53b","4f2fe8408ff2234284ab15fff587c21c477b69784707266dc7ca968ab355e267","e2e0c2c2f4b1d3b79753ff38724fcc1d4e7c64ae8e71b2e071a8f58d59f72865","d7a28efa6b8085442dacc3ef59b11677fdda96746c4fa403dc81ff9200984945","c9e362a9b7bca142470bb4d7ac4f36eb9a216be6662948fb9008de53a60b1a87","2a055a41d7998a7db1519ad1968b77e17b185d334707b34e3fedcc5872f1b53b","7a8bb92a68704fb170b922ae31327b43e368af0c69849c31b40d56fa64861193","fffd9b8bf601c41150e10ed938a9cc2d19049caeb5ff19aa118d36770ba52e33","8047922ed40c05c09606713aceb9c98b29f0eda3cc2cce8a90f85f46e48e2df9","9dd7480fc3b781695bf04f26038589ac8f2b1fac77884700b88244d323657ad0","b91e0e5d2a6fae9a746d96e9934cc7d9ffb2a7594ce21d1a2e0a1a5f7a099c6d","06db778dd2361359e52e964b1545e58bc1030eb4eea3b3803fa7c61a4e4b070b","f26b7dca787a5e7fcb1fc1c9c26f125875e63ab2e4c31b5974afe43ab95d29d1"],"paragraph_range_zero_based":[32328,32351],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p32328"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig information element","paragraph_zero_based":32352},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32353},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-BEARERCONFIG-START","paragraph_zero_based":32354},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32355},{"literal_text_all_w_t_and_m_t":"RLC-BearerConfig ::=                        SEQUENCE {","paragraph_zero_based":32356},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentity                      LogicalChannelIdentity,","paragraph_zero_based":32357},{"literal_text_all_w_t_and_m_t":"    servedRadioBearer                           CHOICE {","paragraph_zero_based":32358},{"literal_text_all_w_t_and_m_t":"        srb-Identity                                SRB-Identity,","paragraph_zero_based":32359},{"literal_text_all_w_t_and_m_t":"        drb-Identity                                DRB-Identity","paragraph_zero_based":32360},{"literal_text_all_w_t_and_m_t":"    }                                                                                               OPTIONAL,   -- Cond LCH-SetupOnly","paragraph_zero_based":32361},{"literal_text_all_w_t_and_m_t":"    reestablishRLC                              ENUMERATED {true}                                   OPTIONAL,   -- Need N","paragraph_zero_based":32362},{"literal_text_all_w_t_and_m_t":"    rlc-Config                                  RLC-Config                                          OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":32363},{"literal_text_all_w_t_and_m_t":"    mac-LogicalChannelConfig                    LogicalChannelConfig                                OPTIONAL,   -- Cond LCH-Setup","paragraph_zero_based":32364},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":32365},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32366},{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1610                            RLC-Config-v1610                                    OPTIONAL    -- Need R","paragraph_zero_based":32367},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":32368},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":32369},{"literal_text_all_w_t_and_m_t":"    rlc-Config-v1700                            RLC-Config-v1700                                    OPTIONAL,   -- Need R","paragraph_zero_based":32370},{"literal_text_all_w_t_and_m_t":"    logicalChannelIdentityExt-r17               LogicalChannelIdentityExt-r17                       OPTIONAL,   -- Cond LCH-SetupModMRB","paragraph_zero_based":32371},{"literal_text_all_w_t_and_m_t":"    multicastRLC-BearerConfig-r17               MulticastRLC-BearerConfig-r17                       OPTIONAL,   -- Cond LCH-SetupOnlyMRB","paragraph_zero_based":32372},{"literal_text_all_w_t_and_m_t":"    servedRadioBearerSRB4-r17                   SRB-Identity-v1700                                  OPTIONAL    -- Need N","paragraph_zero_based":32373},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":32374},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":32375}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["df4549788453b67bc86bbcd0a8079f6367acf97ada353172f5e3dcd96ce42176","1ed11943345b9ae1cee3658c3ec57eaef8d9490872d84d2e136b61e8b330a04e","1d7b2ccf5229cf1f01aaeebc582f448c8a9b51afdf6aaf0544d5f62d278b9759","aa5a01dc0c26adb619111eef142540f36ef41bbe6644d37e9cbda1726233a583","2a8bf1cbfcabc93304e6f4e9bbd4ce795e0b2bf8f69b59817cb85e88e23731ce","f5152072a