{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"                                         tensofnanoseconds,","paragraph_zero_based":45096},{"literal_text_all_w_t_and_m_t":"                                         nanoseconds,","paragraph_zero_based":45097},{"literal_text_all_w_t_and_m_t":"                                         tenthsofnanoseconds,","paragraph_zero_based":45098},{"literal_text_all_w_t_and_m_t":"                                         ...},","paragraph_zero_based":45099},{"literal_text_all_w_t_and_m_t":"    rttAccuracy-r16                  INTEGER (0..255)             OPTIONAL,","paragraph_zero_based":45100},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45101},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45102},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45103},{"literal_text_all_w_t_and_m_t":"-- TAG-LOGMEASRESULTLISTWLAN-STOP","paragraph_zero_based":45104},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45105},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45106},{"literal_text_all_w_t_and_m_t":"LogMeasResultListWLAN field descriptions","paragraph_zero_based":45107},{"literal_text_all_w_t_and_m_t":"Bssid","paragraph_zero_based":45108},{"literal_text_all_w_t_and_m_t":"Basic Service Set Identifier (BSSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":45109},{"literal_text_all_w_t_and_m_t":"Hessid","paragraph_zero_based":45110},{"literal_text_all_w_t_and_m_t":"Homogenous Extended Service Set Identifier (HESSID) defined in IEEE 802.11-2012 [50].","paragraph_zero_based":45111},{"literal_text_all_w_t_and_m_t":"rssiWLAN","paragraph_zero_based":45112},{"literal_text_all_w_t_and_m_t":"Measured WLAN RSSI result in dBm. The IE WLAN-RSSI-Range specifies the value range used in WLAN RSSI measurements and thresholds. Integer value for WLAN RSSI measurements is according to mapping table in TS 36.133 [40]. Value 0 corresponds to –infinity, value 1 to -100dBm, value 2 to -99dBm, and so on (i.e. in steps of 1dBm) until value 140, which corresponds to 39dBm, while value 141 corresponds to +infinity.","paragraph_zero_based":45113},{"literal_text_all_w_t_and_m_t":"rtt-WLAN","paragraph_zero_based":45114},{"literal_text_all_w_t_and_m_t":"This field provides the measured roundtrip time between the target device and WLAN AP and optionally the accuracy expressed as the standard deviation of the delay. Units for each of these are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":45115},{"literal_text_all_w_t_and_m_t":"rttValue","paragraph_zero_based":45116},{"literal_text_all_w_t_and_m_t":"This field specifies the Round Trip Time (RTT) measurement between the target device and WLAN AP in units given by the field rttUnits as defined in TS 37.355 [49].","paragraph_zero_based":45117},{"literal_text_all_w_t_and_m_t":"rttUnits","paragraph_zero_based":45118},{"literal_text_all_w_t_and_m_t":"This field specifies the Units for the fields rttValue and rttAccuracy. The available Units are 1000ns, 100ns, 10ns, 1ns, and 0.1ns as defined in TS 37.355 [49].","paragraph_zero_based":45119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3a00ca10712f77eca5694c40407bcd26a0d2b4611d4e67da4cf231b7ffd10dc4","12a1ac8aa7c5ad368c65551289e33a4c49aaf73278826b03130086d9457ae1dc","0ae3ab057e085828037c4c1cd4cd4e2f287cc31422c7a2ddd0b5a7b1c8ad639f","88e55654233c4fae410925d60145cf91ba376d9665257134e63fa894446772e0","d0ddc684939e98a0bb0f57e49d2d0624f8b0f31f29792f8985fc02a30bf16bff"