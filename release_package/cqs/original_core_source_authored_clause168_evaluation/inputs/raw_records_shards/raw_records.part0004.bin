{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42072},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC-v16e0 ::=                     SEQUENCE {","paragraph_zero_based":42073},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch-v16e0   BandCombinationList-UplinkTxSwitch-v16e0        OPTIONAL","paragraph_zero_based":42074},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":42075},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42076},{"literal_text_all_w_t_and_m_t":"-- TAG-RF-PARAMETERSMRDC-STOP","paragraph_zero_based":42077},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":42078},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42079},{"literal_text_all_w_t_and_m_t":"RF-ParametersMRDC field descriptions","paragraph_zero_based":42080},{"literal_text_all_w_t_and_m_t":"appliedFreqBandListFilter","paragraph_zero_based":42081},{"literal_text_all_w_t_and_m_t":"In this field the UE mirrors the FreqBandList that the NW provided in the capability enquiry, if any. The UE filtered the band combinations in the supportedBandCombinationList in accordance with this appliedFreqBandListFilter.","paragraph_zero_based":42082},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList","paragraph_zero_based":42083},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports for (NG)EN-DC, or both (NG)EN-DC and NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":42084},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationListNEDC-Only, supportedBandCombinationListNEDC-Only-v1610","paragraph_zero_based":42085},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports only for NE-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":42086},{"literal_text_all_w_t_and_m_t":"supportedBandCombinationList-UplinkTxSwitch","paragraph_zero_based":42087},{"literal_text_all_w_t_and_m_t":"A list of band combinations that the UE supports dynamic UL Tx switching for (NG)EN-DC. The FeatureSetCombinationId:s in this list refer to the FeatureSetCombination entries in the featureSetCombinations list in the UE-MRDC-Capability IE.","paragraph_zero_based":42088},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42089},{"literal_text_all_w_t_and_m_t":"–RLC-Parameters","paragraph_zero_based":42090},{"literal_text_all_w_t_and_m_t":"The IE RLC-Parameters is used to convey capabilities related to RLC.","paragraph_zero_based":42091},{"literal_text_all_w_t_and_m_t":"RLC-Parameters information element","paragraph_zero_based":42092},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":42093},{"literal_text_all_w_t_and_m_t":"-- TAG-RLC-PARAMETERS-START","paragraph_zero_based":42094},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":42095}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f9813abd3024ff7f91555843fb97c39db98378328ac6b715f4bcf51deb70edf3","3237c29fbc3ffa7e7346bf9ee58c5412c81561d47c765806ccf75b6d90018d41","eccf7cd58389d172d1b7cb296fc76b280a105c9c93dad6922a94041fce3b9ceb","e56f6890997c4d699a380a47fd4b2c56ed261d4c1524d6af421b997d46c20d83","c72328fdf1757768d2b5bb3a46a159b9f522c6be95897d23bfd03a66d963143f","ad9dede55b9915b0214dfbf01de0f4715a250fee244d6a0abfa3fb3007f34b76","d965b65208d8af28fc4697e3b352a0a034