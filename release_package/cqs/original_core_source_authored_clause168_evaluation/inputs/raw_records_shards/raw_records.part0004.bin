{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"listElementToAddModListSizeExt-vNwz  SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElement-rN   OPTIONAL,    -- Need N","paragraph_zero_based":54144},{"literal_text_all_w_t_and_m_t":"    listElementToReleaseListSizeExt-vNwz SEQUENCE (SIZE (1..maxNrofListElementsDiff-rN)) OF ListElementId-vNwz     OPTIONAL    -- Need N","paragraph_zero_based":54145},{"literal_text_all_w_t_and_m_t":"]]","paragraph_zero_based":54146},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54147},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54148},{"literal_text_all_w_t_and_m_t":"ListElement ::=                      SEQUENCE {","paragraph_zero_based":54149},{"literal_text_all_w_t_and_m_t":"    elementId                            ListElementId,","paragraph_zero_based":54150},{"literal_text_all_w_t_and_m_t":"    field1                               INTEGER (0..3),","paragraph_zero_based":54151},{"literal_text_all_w_t_and_m_t":"    field2                               ENUMERATED { value1, value2, value3 }","paragraph_zero_based":54152},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54153},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54154},{"literal_text_all_w_t_and_m_t":"ListElementExt-vMxy ::=              SEQUENCE {","paragraph_zero_based":54155},{"literal_text_all_w_t_and_m_t":"    field3-rM                            BIT STRING (SIZE (8))                                              OPTIONAL     -- Need R","paragraph_zero_based":54156},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54158},{"literal_text_all_w_t_and_m_t":"ListElement-rN ::=                   SEQUENCE {","paragraph_zero_based":54159},{"literal_text_all_w_t_and_m_t":"    elementId-vNwz                       ListElementId-vNwz,","paragraph_zero_based":54160},{"literal_text_all_w_t_and_m_t":"    field1                               INTEGER (0..3),","paragraph_zero_based":54161},{"literal_text_all_w_t_and_m_t":"    field2                               ENUMERATED { value1, value2, value3 },","paragraph_zero_based":54162},{"literal_text_all_w_t_and_m_t":"    field3-rN                            BIT STRING (SIZE (8))                                              OPTIONAL     -- Need R","paragraph_zero_based":54163},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54164},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54165},{"literal_text_all_w_t_and_m_t":"ListElementId ::= INTEGER (0..maxNrofListElements-1)","paragraph_zero_based":54166},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6e8115406481d009c70615b0e1be517443db28460b21da6f0c5e61b8760dcdfb","07837bdf228f5f61043ce8a82a6b303c5d95cc63387b3e30f0dd8912b9db624d","5163f744beae96c9648361c3f18b03bb1e3116df536c0d08e44a13077b1eb763","6235c40daf7854250851d8ff4c16b196c4df7a64533c3f6847c0b6f3a513ab3c","a3609205ff6a346d4e5cf4e02aeb023021486bd0a9b1647971168d29107694dc","d40171d31a8e95998914aa8bc95147acbfbd1dec40a257262978be55514f8802","5131cd329269cacc3aa360ff02068d8d01687f8c6991983bd8eaedf234f94b80","09d241f1cf994c9550a627db1cc83d91b6af89f318e24676117cbe95d77190b2","9b4af94974775dd70bcc1e0a807a3bf52cab41b4d3611e78a65de4df31d5c0f0","b3c3af2846b6d5f7749c141abbdda4d353b62298b507e77a9c59695f22ff7a47","70e0f5196e5b8f1f34c6b08196b99dd2660ca3798c34edac05623dbc6e8bf161","41cc6ee7bfd04d3344d9bc5491010e4b2ddeb60284a1f01c60dc2537a0516223","f73ad3a1237acbd7a69741dee8d60ff19e2098882b06ca92830e718f32221774","64224533463fad6a5b4d05271ad7c308ea1a3d0a6e90d0bfa6246e9ba9dbfa7c","6c839fefcb4c40772a1c0db4e68718e5c9beb6f1475794ba7c9984c647a03992","43733d7adaadf7d5def86c45e0e80bb40f1cc75ef441011fa14dda5f8520a873","aab7bc2320105c75598a4a352233f1b2413ee5a7429594ed88bb33388d9b10d1","b9d4337003f4532e295fa7d268bc906db533d13710a1b6b3dd71002f94a0a53a","6cd6e50ac9e6771a59747eeb9f8972310252cf5dbce3af6af72b7d2b1398e197","2b6dde693aa7a5eee8d13fd1d0dcb0ef801ae3250b8e4edc272accfdf3e08bce","3507a77b782163d56279a697a4394b506429df869eabd0937204c8f392cbc273","17810667d9c9e50679ce5aec98e723d473c6dfe3e6c9d7c2cca59de3f6291295","4bbc257f30176897ccf14a5dd69e23f6ffbc1ee6c9c6d55f8c7937470055130e","f7b2decca273c1b90f46889ea763999dbd3d4a9d2e5d031d93598f626850b1f0"],"paragraph_range_zero_based":[54144,54167],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54144"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ListElementId-vNwz ::= INTEGER (maxNrofListElements..maxNrofListElementsDiff-1-rN)","paragraph_zero_based":54168},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":54169},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54170},{"literal_text_all_w_t_and_m_t":"A.5Guidelines regarding inclusion of transaction identifiers in RRC messages","paragraph_zero_based":54171},{"literal_text_all_w_t_and_m_t":"The following rules provide guidance on which messages should include a Transaction identifier","paragraph_zero_based":54172},{"literal_text_all_w_t_and_m_t":"1:DL messages on CCCH that move UE to RRC-Idle should not include the RRC transaction identifier.","paragraph_zero_based":54173},{"literal_text_all_w_t_and_m_t":"2:All network initiated DL messages by default should include the RRC transaction identifier.","paragraph_zero_based":54174},{"literal_text_all_w_t_and_m_t":"3:All UL messages that are direct response to a DL message with an RRC Transaction identifier should include the RRC Transaction identifier.","paragraph_zero_based":54175},{"literal_text_all_w_t_and_m_t":"4:All UL messages that require a direct DL response message should include an RRC transaction identifier.","paragraph_zero_based":54176},{"literal_text_all_w_t_and_m_t":"5:All UL messages that are not in response to a DL message nor require a corresponding response from the network should not include the RRC Transaction identifier.","paragraph_zero_based":54177},{"literal_text_all_w_t_and_m_t":"A.6Guidelines regarding use of need codes","paragraph_zero_based":54178},{"literal_text_all_w_t_and_m_t":"The following rule provides guidance for determining need codes for optional downlink fields:","paragraph_zero_based":54179},{"literal_text_all_w_t_and_m_t":"- if the field needs to be stored by the UE (i.e. maintained) when absent:","paragraph_zero_based":54180},{"literal_text_all_w_t_and_m_t":"- use Need M (=Maintain);","paragraph_zero_based":54181},{"literal_text_all_w_t_and_m_t":"- else, if the field needs to be released by the UE when absent:","paragraph_zero_based":54182},{"literal_text_all_w_t_and_m_t":"- use Need R (=Release);","paragraph_zero_based":54183},{"literal_text_all_w_t_and_m_t":"- else, if UE shall take no action when the field is absent (i.e. UE does not even need to maintain any existing value of the field):","paragraph_zero_based":54184},{"literal_text_all_w_t_and_m_t":"- use Need N (=None);","paragraph_zero_based":54185},{"literal_text_all_w_t_and_m_t":"- else (UE behaviour upon absence does not fit any of the above conditions):","paragraph_zero_based":54186},{"literal_text_all_w_t_and_m_t":"- use Need S (=Specified);","paragraph_zero_based":54187},{"literal_text_all_w_t_and_m_t":"- specify the UE behaviour upon absence of the field in the procedural text or in the field description table.","paragraph_zero_based":54188},{"literal_text_all_w_t_and_m_t":"A.7Guidelines regarding use of conditions","paragraph_zero_based":54189},{"literal_text_all_w_t_and_m_t":"Conditions are primarily used to specify network restrictions, for which the following types can be distinguished:","paragraph_zero_based":54190},{"literal_text_all_w_t_and_m_t":"-Message Contents related constraints e.g. that a field B is mandatory present if the same message includes field A and when it is set value X.","paragraph_zero_based":54191}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["ac14e476030b130644a2d7af1b12ac571151b09f7a85f88e9f7a08f7cdc04b2e","0a4dbe02e5d1a2395af2345367484a0fbd756c0acc83de9514a458a7393a4b6e","f384e11d3d9cf83906e4f3824e84eb93154adb7a793e157f3c5b7462362fb551","d2f8a68d3283ed47b62032e32807f3be693df62c8f182457376008d412e1c2bb","050b8d4b84df9f1e278b37c9941a500be4c4815bb7486c104decc6da4be2fd7b","1a93bfabf88fd87f6327b5b11fd448c11124bd2e59cc619a1ac157eda4f7833e","1e0a1994073c02aa7d5eceaea260c420e15c29597c19540842e230d63cea5d8a","23670659783f91e89ad5f8330b3499525882d351cb292d8bac19e652b2021bb1","82f22026c30af18dfd4e2b49a3cb24542ce0fad71aa6f103df0a8dc565b40ed2","0e8b28d851a18eb30a867894ec91f5ac070a2219496b93748b90ec19ed871d68","9432327aad15d0349d3f3d0a204269d59b22892fa776a34581ea582f681597c0","94a2999181697625978303b26c51a2c0306465a3bcc8e5ecdc6d1feb7ef73fbf","017eff5802f01055fd7b8d0d67a1b03fd46ddda14dcaf54eb2ad9009ddbfabf3","3a174872eb102b5064a118ae6a2bb23a58f163d94b01001c882d3df5af3af373","945d41965f2552d1975a5c365d60f6fa5cfc3c7927cb918fb9845944985050bd","65c2ce3752bd1a821f5ac01628738e05a24f182fda680559b611750987a9b6c2","c2a5bc0598ab9230165244312106b90e7095ef130c14c82b27a4e859d7509ecd","bbd819219c37aecb541e1189488d2309623252bdef71eacdb4141356ca32dbed","d03ca52c4c54c3e6a724aa3ca6f45ef0ef1886e897f125b81d49cda1d88fd83b","d05a3699a4916e6f198b7b07ce0fef257b068018d73f71370c4fb9209e3687c5","424454a7874b157c639a384540ee4a768b039b4107c94164451560d9016bd194","af5d790df5f0a73ba6067e4c782499d54a84269d2ef575ecade400c914de3945","1fff0155204e54f0b9b37d3ce8591a0062c0337c02ef1c111d223f41d8970ed0","cdf0c11d3fd99ffea9f774834bc3f64085c4d90a31b6b88c20158b9cb4b880f3"],"paragraph_range_zero_based":[54168,54191],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p54168"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-Configuration Constraints e.g. that a field D can only be signalled if field C is configured and set to value Y. (i.e. regardless of whether field C is present in the same message or previously configured).","paragraph_zero_based":54192},{"literal_text_all_w_t_and_m_t":"The use of these conditions is illustrated by an example.","paragraph_zero_based":54193},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":54194},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54195},{"literal_text_all_w_t_and_m_t":"RRCMessage-IEs ::= SEQUENCE {","paragraph_zero_based":54196},{"literal_text_all_w_t_and_m_t":"    fieldA                          FieldA                  OPTIONAL,   -- Need M","paragraph_zero_based":54197},{"literal_text_all_w_t_and_m_t":"    fieldB                          FieldB                  OPTIONAL,   -- Cond FieldAsetToX","paragraph_zero_based":54198},{"literal_text_all_w_t_and_m_t":"    fieldC                          FieldC                  OPTIONAL,   -- Need M","paragraph_zero_based":54199},{"literal_text_all_w_t_and_m_t":"    fieldD                          FieldD                  OPTIONAL,   -- Cond FieldCsetToY","paragraph_zero_based":54200},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension            SEQUENCE {}             OPTIONAL","paragraph_zero_based":54201},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":54202},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54203},{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1STOP","paragraph_zero_based":54204},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54205},{"literal_text_all_w_t_and_m_t":"Conditional presence","paragraph_zero_based":54206},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":54207},{"literal_text_all_w_t_and_m_t":"FieldAsetToX","paragraph_zero_based":54208},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if fieldA is included and set to valueX. Otherwise the field is optionally present, need R.","paragraph_zero_based":54209},{"literal_text_all_w_t_and_m_t":"FieldCsetToY","paragraph_zero_based":54210},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need M, if fieldC is configured and set to valueY. Otherwise the field is absent and the UE does not maintain the value","paragraph_zero_based":54211},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":54212},{"literal_text_all_w_t_and_m_t":"A.8Miscellaneous","paragraph_zero_based":54213},{"literal_text_all_w_t_and_m_t":"The following miscellaneous convention should be used:","paragraph_zero_based":54214},{"literal_text_all_w_t_and_m_t":"-UE capabilities: TS 38.306 [26] specifies that the network should in general respect the UE's capabilities. Hence there is no need to include statement clarifying that the network, when setting the value of a certain configuration field, shall respect the related UE capabilities unless there is a particular need e.g. particularly complicated cases.","paragraph_zero_based":54215}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["7f928fe4e12ae7f44aecc387234028ae93f216d06ff8b2655f5693dbae963907","969b1733ac7d486dc9ac6f862ca6f619ae7c653ee6a8f8da4ca9193c7b1ede6c","73be78bc93c299a5e03498f9b3751f68b6621b68e572f47d6f17b653331620ee","407506157bf645352df420ab910baa675c6784a253da7cf1396479de3c94dbad","e64763a014f2d2bdd4a36242eb6e306a745cb5ae690bbf553b17f16e4efac6fc","eb6917eff6887d3bd666b5089835b79bea76f4334d1eae124727ce51d5caa23f","a47f94681b9e18e115d15c6e16830da5