                                                         OPTIONAL,","paragraph_zero_based":38868},{"literal_text_all_w_t_and_m_t":"    rf-RxRetunTimeFR1-r18                            ENUMERATED {n70, n140, n210}                        OPTIONAL,","paragraph_zero_based":38869},{"literal_text_all_w_t_and_m_t":"    rf-RxRetunTimeFR2-r18                            ENUMERATED {n35, n70, n140}                         OPTIONAL,","paragraph_zero_based":38870},{"literal_text_all_w_t_and_m_t":"    numOfOverlappingPRB-r18                          ENUMERATED {n0, n1, n2, n4}                         OPTIONAL,","paragraph_zero_based":38871},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":38872},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":38873},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38874},{"literal_text_all_w_t_and_m_t":"-- TAG-DL-PRS-MEASUREMENTWITHRXFH-RRC-CONNECTED-STOP","paragraph_zero_based":38875},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":38876},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":38877},{"literal_text_all_w_t_and_m_t":"–ERedCapParameters","paragraph_zero_based":38878},{"literal_text_all_w_t_and_m_t":"The IE ERedCapParameters is used to indicate the UE capabilities supported by eRedCap UEs.","paragraph_zero_based":38879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["18ce662c8f1a44efcb6ce0b0938059225ecba13c352803e9a1fbe339120fb618","151cce92f7b83128f71988bf3fde552602da682677abaa45a6a15ea1c29b4e41","be5deaeef88d71574fb1d8c37f3aae01a2418e0da1560af50bef2e7c0c4203f1","582769661819feebfaab0de904220476f85fcac51d3c6cebd4a7fb4822b4f696","34e274cd9a8a931d1518267e28f7f1b607aeca638f07