{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSlots                   INTEGER (0..maxNrofSlots),","paragraph_zero_based":35448},{"literal_text_all_w_t_and_m_t":"    nrofDownlinkSymbols                 INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":35449},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSlots                     INTEGER (0..maxNrofSlots),","paragraph_zero_based":35450},{"literal_text_all_w_t_and_m_t":"    nrofUplinkSymbols                   INTEGER (0..maxNrofSymbols-1),","paragraph_zero_based":35451},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":35452},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":35453},{"literal_text_all_w_t_and_m_t":"    dl-UL-TransmissionPeriodicity-v1530     ENUMERATED {ms3, ms4}                                               OPTIONAL -- Need R","paragraph_zero_based":35454},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":35455},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35456},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35457},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGCOMMON-STOP","paragraph_zero_based":35458},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35459},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35460},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigCommon field descriptions","paragraph_zero_based":35461},{"literal_text_all_w_t_and_m_t":"referenceSubcarrierSpacing","paragraph_zero_based":35462},{"literal_text_all_w_t_and_m_t":"Reference SCS used to determine the time domain boundaries in the UL-DL pattern which must be common across all subcarrier specific carriers, i.e., independent of the actual subcarrier spacing using for data transmission.","paragraph_zero_based":35463},{"literal_text_all_w_t_and_m_t":"Only the following values are applicable depending on the used frequency:","paragraph_zero_based":35464},{"literal_text_all_w_t_and_m_t":"FR1:    15, 30, or 60 kHz","paragraph_zero_based":35465},{"literal_text_all_w_t_and_m_t":"FR2-1:  60 or 120 kHz","paragraph_zero_based":35466},{"literal_text_all_w_t_and_m_t":"FR2-2:  120, 480, or 960 kHz","paragraph_zero_based":35467},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35468},{"literal_text_all_w_t_and_m_t":"The network configures a not larger than any SCS of configured BWPs for the serving cell. The network or SL-PreconfigGeneral configures a not larger than the SCS of (pre-)configured SL BWP.See TS 38.213 [13], clause 11.1.","paragraph_zero_based":35469},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35470},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-Pattern field descriptions","paragraph_zero_based":35471}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f2022c0a767d35deb885a57381e516ab37bdfd53a14924ac6d9cf7bc949ccc46","24636dc02c3905c5af201b45fd4b31b293f38fbf4c323c110e8c5aa3414dc2f6","9112abeb73b0a5c49f5ad720705f241945ad8ab42585ab6dac01c407cbefe421","a8a2f3f464c8c529e32f0ab215e3c762be293387bf0afcf0b8d3b569ce3fe11d","666abfb19b994b2d20a0ded9451b0b7d9c795f3a8aaa2ab6d68086c1b1b4db8e","4a0c2bb791ac3a58fb3cdc65e372746c2c8288eaf139627febd2372261632d8d","73b310e1dab5e49ed7f3a03a666d70d143453f872b780408659e9210a64004cf","b5e48bb31e9de13efa0514f83a697b95a4bab2db7711edc91459f969bf294ad1","ac1c440663605dd58018e2610821c4762b4f0b872e319ddb289cac00fa6f1199","1f6c0488a518b29983ea7df856d55913e29aec3e31582b321de95ef88f6c834f","b7973aced0078a81f1b426a223af1d75b5919e063dad8af104ca530cb62e2006","ca181799eeceed110ee02b651bea6857575b8f4999f27685c485eaac75a75770","5f71c3fe849a1e7743a6f0af93dceab8881676dbcebba7c7b5f106c6907d2571","ebb3ab0dcd8b0fb43cbd4a34c2bbef3eea3fafe13b566de197939f966f051bb5","4fc51b8f67a2120d2dcc09d5b241b3d1304d5793425fb1b2dd9c41666a3daefc","e14d1337b6c021ee62a3d2920129929a5a90609018953526f2d0bb3e6f118874","29d0e472123cc690848f5dc273a01310ba66542e031cf6470f7032214eb36324","d5e3fc6f6d013a860976b64394ddb64bfa7a80a995f2cda43cadac4113647416","b0105105b8cbf1ea100c38cc4c8851828652f56630fa520efa6a848403f4446a","6ebe26d20dd296f2621f933bc61d3f1028fb3e02b2cd65f5951582eda299ae55","c223e6d21e37da995b0a8fc0ee615d3f1facb2eff0744701aa2e43407d60b3fe","1944b4ba319358ff9fc2f3bfb982a41b3f094574bef78398f7fc749fecf07ccd","be1f8e871c4af3f9cfa5254369d0227bd772ad8dcc041ce56f1219c53ed17ad1","060ad345183d1b802f05b160dfa166c1b4bcb1dae4b7f89260d59d5d7515f2e8"],"paragraph_range_zero_based":[35448,35471],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p35448"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"dl-UL-TransmissionPeriodicity","paragraph_zero_based":35472},{"literal_text_all_w_t_and_m_t":"Periodicity of the DL-UL pattern, see TS 38.213 [13], clause 11.1. If the dl-UL-TransmissionPeriodicity-v1530 is signalled, UE shall ignore the dl-UL-TransmissionPeriodicity (without suffix).","paragraph_zero_based":35473},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSlots","paragraph_zero_based":35474},{"literal_text_all_w_t_and_m_t":"Number of consecutive full DL slots at the beginning of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":35475},{"literal_text_all_w_t_and_m_t":"nrofDownlinkSymbols","paragraph_zero_based":35476},{"literal_text_all_w_t_and_m_t":"Number of consecutive DL symbols in the beginning of the slot following the last full DL slot (as derived from nrofDownlinkSlots). The value 0 indicates that there is no partial-downlink slot. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":35477},{"literal_text_all_w_t_and_m_t":"nrofUplinkSlots","paragraph_zero_based":35478},{"literal_text_all_w_t_and_m_t":"Number of consecutive full UL slots at the end of each DL-UL pattern, see TS 38.213 [13], clause 11.1. In this release, the maximum value for this field is 320.","paragraph_zero_based":35479},{"literal_text_all_w_t_and_m_t":"nrofUplinkSymbols","paragraph_zero_based":35480},{"literal_text_all_w_t_and_m_t":"Number of consecutive UL symbols in the end of the slot preceding the first full UL slot (as derived from nrofUplinkSlots). The value 0 indicates that there is no partial-uplink slot. (see TS 38.213 [13], clause 11.1).","paragraph_zero_based":35481},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35482},{"literal_text_all_w_t_and_m_t":"–TDD-UL-DL-ConfigDedicated","paragraph_zero_based":35483},{"literal_text_all_w_t_and_m_t":"The IE TDD-UL-DL-ConfigDedicated determines the UE-specific Uplink/Downlink TDD configuration.","paragraph_zero_based":35484},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated information element","paragraph_zero_based":35485},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35486},{"literal_text_all_w_t_and_m_t":"-- TAG-TDD-UL-DL-CONFIGDEDICATED-START","paragraph_zero_based":35487},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35488},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated ::=       SEQUENCE {","paragraph_zero_based":35489},{"literal_text_all_w_t_and_m_t":"    slotSpecificConfigurationsToAddModList      SEQUENCE (SIZE (1..maxNrofSlots)) OF TDD-UL-DL-SlotConfig       OPTIONAL, -- Need N","paragraph_zero_based":35490},{"literal_text_all_w_t_and_m_t":"    slotSpecificConfigurationsToReleaseList     SEQUENCE (SIZE (1..maxNrofSlots)) OF TDD-UL-DL-SlotIndex        OPTIONAL, -- Need N","paragraph_zero_based":35491},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35492},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35493},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35494},{"literal_text_all_w_t_and_m_t":"TDD-UL-DL-ConfigDedicated-IAB-MT-r16::=         SEQUENCE {","paragraph_zero_based":35495}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["8441a5355e779e22762f94fc6fdfe829edb832697e530b1055b8efd3253f2659","9e338efe0475b65f9790d5a6171fadc7e1916c32d4bcd6ffe83ece376c3952e0","ee01e559e8dc5a29d3a9e2670279d04f0236d313e9f4b2ccf44c812249235cc2","9df5ba7f363a13cec43f35caf37b9d36f903c81972b426127b67173d8ccab355","f867378d7990a22119d