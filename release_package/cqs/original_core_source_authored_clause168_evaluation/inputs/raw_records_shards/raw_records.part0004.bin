{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CSI-REPORTCONFIG-STOP","paragraph_zero_based":23880},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23881},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23882},{"literal_text_all_w_t_and_m_t":"LTM-CSI-ReportConfig field descriptions","paragraph_zero_based":23883},{"literal_text_all_w_t_and_m_t":"ltm-ReportContent","paragraph_zero_based":23884},{"literal_text_all_w_t_and_m_t":"This field defines the content of the LTM L1 measurement report.","paragraph_zero_based":23885},{"literal_text_all_w_t_and_m_t":"reportSlotConfig","paragraph_zero_based":23886},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset (see TS 38.214 [19], clause 5.2.1.4).","paragraph_zero_based":23887},{"literal_text_all_w_t_and_m_t":"reportSlotOffsetList, reportSlotOffsetListDCI-0-1, reportSlotOffsetListDCI-0-2","paragraph_zero_based":23888},{"literal_text_all_w_t_and_m_t":"Timing offset Y for semi persistent reporting using PUSCH and aperiodic reporting.","paragraph_zero_based":23889},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23890},{"literal_text_all_w_t_and_m_t":"LTM-ReportContent field descriptions","paragraph_zero_based":23891},{"literal_text_all_w_t_and_m_t":"nrOfReportedCells","paragraph_zero_based":23892},{"literal_text_all_w_t_and_m_t":"This field defines how many cells are reported within a single L1 measurement report instance.","paragraph_zero_based":23893},{"literal_text_all_w_t_and_m_t":"nrOfReportedRS-PerCell","paragraph_zero_based":23894},{"literal_text_all_w_t_and_m_t":"This field defines how many RSs per cell are reported within a single L1 measurement report instance.","paragraph_zero_based":23895},{"literal_text_all_w_t_and_m_t":"spCellInclusion","paragraph_zero_based":23896},{"literal_text_all_w_t_and_m_t":"This field indicates whether the UE shall include a L1 measurement report associated to the current SpCell. This field can only be configured if the current SpCell is configured as an LTM candidate cell.","paragraph_zero_based":23897},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23898},{"literal_text_all_w_t_and_m_t":"–LTM-CSI-ReportConfigId","paragraph_zero_based":23899},{"literal_text_all_w_t_and_m_t":"The IE LTM-CSI-ReportConfigId is used to identify an LTM-CSI-ReportConfig.","paragraph_zero_based":23900},{"literal_text_all_w_t_and_m_t":"LTM-CSI-ReportConfigId information element","paragraph_zero_based":23901},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":23902},{"literal_text_all_w_t_and_m_t":"-- TAG-LTM-CSI-REPORTCONFIGID-START","paragraph_zero_based":23903}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["4fba8bfcbc022fca4dc2f2c26a415d0191d940123cc2df86859684400031441d","f78fe3c6b6265ec9bd03c64ced7df798eaf06e9082fbec276e31715cfe6de4a3","48d75275fb73cd0b72cdd64c674fff92cdb4075c2b1edf79e5b9ed923df057f8","b626688f1241b5a5f306f084ef920743a2139d972587c61e399726a8c5020af0","ce53c30db5cffd0bfd31a78549c9211206d77148093d8f1f98ba3c7e44ee2d4b","d73fd81c46140cb44550aa0db1784a83b1f710ac9468ca75d682a5b537e4519a","baf38bf61691be2eba84d57e2ac8886d2dce0b1e64fd94bbefe3ee4faa2233da","779725f40f4d32877ea9fc2a7870da17a566b117a3ad9d2779c32fbecb137849","cb2653f058bebcb2d00f23f253e753de00620d39b04d7cf1fb8801d9071f684f","8b9ed6ae34930a668c6e8efe3de4809de675a077ee67db0c70de42f1d5bc3e20","24526303542db77b0388a5ca9787eac0e13c908c7881946d403e951b801a6a3e","97bbe770a74209311a5290eebedcc092b1c03fd4d855836ce71c51550718c1f1","d1e143c36f2bc8ddb872266468da7