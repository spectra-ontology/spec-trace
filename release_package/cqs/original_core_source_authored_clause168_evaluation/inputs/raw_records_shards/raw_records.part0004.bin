{"fields":{"filename":"R2-2403818.zip::R2-2403818 Corrections to TS 37.355.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"nr-IntegrityServiceParameters","paragraph_zero_based":552},{"literal_text_all_w_t_and_m_t":"This field specifies the range of Integrity Risk (IR) for which the integrity assistance data are valid.","paragraph_zero_based":553},{"literal_text_all_w_t_and_m_t":"nr-IntegrityServiceAlert","paragraph_zero_based":554},{"literal_text_all_w_t_and_m_t":"This field indicates whether the corresponding assistance data can be used for integrity related applications.","paragraph_zero_based":555},{"literal_text_all_w_t_and_m_t":"trp-ErrorCorrelationTime","paragraph_zero_based":556},{"literal_text_all_w_t_and_m_t":"This field specifies the TRP Error Correlation Time which is the upper bound of the correlation time of the TRP error. The time is calculated using:","paragraph_zero_based":557},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":558},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":559},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSetARP-ErrorCorrelationTime","paragraph_zero_based":560},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the DL-PRS Resource Set ARP Error Correlation Time which is the upper bound of the correlation time of the DL-PRS Resource Set ARP error. The time is calculated using:","paragraph_zero_based":561},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":562},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":563},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceARP-ErrorCorrelationTime","paragraph_zero_based":564},{"literal_text_all_w_t_and_m_t":"This field, if present, specifies the DL-PRS Resource ARP Error Correlation Time which is the upper bound of the correlation time of the DL-PRS Resource ARP error. The time is calculated using:","paragraph_zero_based":565},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":566},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":567},{"literal_text_all_w_t_and_m_t":"rtd-ErrorCorrelationTime","paragraph_zero_based":568},{"literal_text_all_w_t_and_m_t":"This field specifies the inter-TRP synchronization error Correlation Time which is the upper bound of the correlation time of the inter-TRP synchronization error. The correlation time is calculated using:","paragraph_zero_based":569},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         1≤&i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                   234<i  [s]","paragraph_zero_based":570},{"literal_text_all_w_t_and_m_t":"Where i is the value given by rtdErrorCorrelationTime. Range is 1-28,200 s.","paragraph_zero_based":571},{"literal_text_all_w_t_and_m_t":"dl-PRS-BeamInfoErrorCorrelationTime","paragraph_zero_based":572},{"literal_text_all_w_t_and_m_t":"This field specifies the Beam Boresight Direction Angle Error Correlation Time which is the upper bound of the correlation time of the DL-PRS Resource angle error. The time is calculated using:","paragraph_zero_based":573},{"literal_text_all_w_t_and_m_t":"t=10i,                                                         &i≤1801800+100(i-180),  180<&i≤234 7200+1000i-234,                    &i>234 [s]","paragraph_zero_based":574},{"literal_text_all_w_t_and_m_t":"Range is 1-28,200 s.","paragraph_zero_based":575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"e47b79743f7f668dac0c837a3ce23ecd71537dc2c3d64c043690847a357e7e80","original_member_sha256":"47772c0117bde699cb677c5e317a254942a85deef6390c97d04168794b0fb47a","paragraph_ElementTree_utf8_XML_sha256":["4cf95d5f66cf4303c2f84396298460aec967fb8e6a9393f794f84e35a6c29106","83f9da84fda9eb6f75088bafd4ed327b116794d01196989979cea6e8af24cd33","542bd2c7aa3dcf21caf65f5b4e1e31925b087b051c8a2b91c9405d3ee46af924","2b85b8790dba4addf9f87fdf36abf200e1884c411b255b7ff781212ad9b9ed85","56ee8e1fe250b027ca9b01908a4dbee8f7d61c77dcc55d94ca4b3e682c80c24f","1421ff62a2de1733b8fb82a33e99d1d31052ffe56c8e032537ec2679e64f9cac","9c51a15ea552305e868a684863e92cbc79c0659be2f9e258f540e30201bc60c6","654c9f233cd194a64c93cec38d1a58352051971f7144589dd41d25dcb4c4e9f3","67d3f1725dbe27f046720e1e22d7b5699303a5e272bac4c965a9b76cf1ef83b1","a2310c67c0f60075ebc67da2909c0c20460879c83fef6dd8ae9d5bb7abdf6ade","417379f5135f4a946357b854ccff989a0e53be149f31333ace33eb40da96621d","3c55cdc415d85f79a51832a90664f58f20bcd70d1ab9a096130d87159d4528b1","2b393c2f1dcc39e807be8a06136644a6989d40c43da33982439c9083f0458b4c","ce2e69006b0a6ab142c3c24297be3f980b7e6eb77b88106a8a2ae0329bd3921a","bb4d6e4c928b34b8184b7591f6b9843077e13b6d8ce3c3c90f157b165fb485d5","9d230a795e6fcb56fc07efe9b660113b4667a4e7480049d10840c3cac71f363a","3cdc4ba2a14364d00d20abce884b74f74a70a2b59eeec9575c9382c82e152cd8","32d71a4519921e12c7f47c859c158a140b84e43c9497ae73cf942486ca829fe7","589925acd5423a43498eb2a2c236f2ec9caa603cf2cff1be49f6765783023d11","8e8ca4c2e2c6f52e045de734a7ae0f7ccfa2e03f970764ed91b56fcc2b967245","6634821af5c02e52a6a208e346e5632d5cf32975b7f7bf0c9d4e9a5025af6e6a","6d5eca49335383d220c1835d50c85f3313df6ca44514cf9ee3c43860eeab42f8","6ec637bc581713d8eb5c2407d432aa2ab1d4fd7f5c2d56c89541de1e086d9a3f","01ecee51077b67e10250a1567a1bd294d161a0e2b8d3e587ab140f9b4ca6243f"],"paragraph_range_zero_based":[552,575],"projection":"All w:t and m:t including tracked insertion/deletion runs; n