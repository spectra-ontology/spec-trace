{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29280},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CSI-RESOURCE-START","paragraph_zero_based":29281},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29282},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource ::=              SEQUENCE {","paragraph_zero_based":29283},{"literal_text_all_w_t_and_m_t":"    uplinkBandwidthPartId               BWP-Id,","paragraph_zero_based":29284},{"literal_text_all_w_t_and_m_t":"    pucch-Resource                      PUCCH-ResourceId","paragraph_zero_based":29285},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29286},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29287},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-CSI-RESOURCE-STOP","paragraph_zero_based":29288},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29289},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29290},{"literal_text_all_w_t_and_m_t":"PUCCH-CSI-Resource field descriptions","paragraph_zero_based":29291},{"literal_text_all_w_t_and_m_t":"pucch-Resource","paragraph_zero_based":29292},{"literal_text_all_w_t_and_m_t":"PUCCH resource for the associated uplink BWP. Only PUCCH-Resource of format 2, 3 and 4 is supported. The actual PUCCH-Resource is configured in PUCCH-Config and referred to by its ID. When two PUCCH-Config are configured within PUCCH-ConfigurationList, PUCCH-ResourceId in a PUCCH-CSI-Resource refers to a PUCCH-Resource in the PUCCH-Config used for HARQ-ACK with low priority.","paragraph_zero_based":29293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29294},{"literal_text_all_w_t_and_m_t":"–PUCCH-PathlossReferenceRS-Id","paragraph_zero_based":29295},{"literal_text_all_w_t_and_m_t":"The IE PUCCH-PathlossReferenceRS-Id is an ID for a reference signal (RS) configured as PUCCH pathloss reference (see TS 38.213 [13], clause 7.2).","paragraph_zero_based":29296},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id information element","paragraph_zero_based":29297},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29298},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-PATHLOSSREFERENCERS-ID-START","paragraph_zero_based":29299},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29300},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id ::=            INTEGER (0..maxNrofPUCCH-PathlossReferenceRSs-1)","paragraph_zero_based":29301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29302},{"literal_text_all_w_t_and_m_t":"PUCCH-PathlossReferenceRS-Id-v1610 ::=      INTEGER (maxNrofPUCCH-PathlossReferenceRSs..maxNrofPUCCH-PathlossReferenceRSs-1-r16)","paragraph_zero_based":29303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2d3bf0a6ce6c5f4f65ac1d6f779defcca4d007163de8b1d59dd4b74b407f87b1","7eafa570992a2c6488ee27a9f811aa71bc53f100b556346f98fed568dccc84d9","d28228005f30f7ff45fff1484b62b68d450b8c8405e84ba6d1014ff365d16a32","4c2eaa4d1a016768dd5e9345cd19a4b2ea5f73ad23b50059a05cec78b722a6a8","307c74527e27a3952c622850e1761d7559ec1b45c964f64ebdfed908dbfbc32c","5f6dec0d508ebcfdfacf46d2ba7a5f75a10321723b7468e5bd0067d6ec662a93","8ddb1cb5ea056ecc3d42a8dff57eb4dc8bba3d6e8fda6f1fbd6892edb9b20703","a4661d076fd5a577525de33577bcca727b7bae0bee6d07880e827c6da56a3504","643928dc61c82164c6686dfe0ecec9c0cfcb7c0ad8010860123e744705a62449","a7a1c9d5ea6192704463ba811f38286b81ceb548ecace006d51bb0651f2d45ad","37a8b34556a7136f0530e5943049e94f0841b89a790a9ffe2fa77d5eb3bfbf8a","dc302c4a0e2bac3a7