{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10920},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10921},{"literal_text_all_w_t_and_m_t":"RRCMessage-1570-IEs ::=           SEQUENCE {","paragraph_zero_based":10922},{"literal_text_all_w_t_and_m_t":"    field3                            InformationElement3            OPTIONAL,  -- Need M","paragraph_zero_based":10923},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              RRCMessage-v1640-IEs           OPTIONAL","paragraph_zero_based":10924},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10925},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10926},{"literal_text_all_w_t_and_m_t":"RRCMessage-v1640-IEs ::=          SEQUENCE {","paragraph_zero_based":10927},{"literal_text_all_w_t_and_m_t":"    field4                            InformationElement4            OPTIONAL,  -- Need R","paragraph_zero_based":10928},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension              SEQUENCE {}                    OPTIONAL","paragraph_zero_based":10929},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":10930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":10931},{"literal_text_all_w_t_and_m_t":"InformationElement1 ::=           SEQUENCE {","paragraph_zero_based":10932},{"literal_text_all_w_t_and_m_t":"    field10                           InformationElement10           OPTIONAL,  -- Need N","paragraph_zero_based":10933},{"literal_text_all_w_t_and_m_t":"    field11                           InformationElement11           OPTIONAL,  -- Need M","paragraph_zero_based":10934},{"literal_text_all_w_t_and_m_t":"    field12                           InformationElement12           OPTIONAL,  -- Need R","paragraph_zero_based":10935},{"literal_text_all_w_t_and_m_t":"    ...,","paragra