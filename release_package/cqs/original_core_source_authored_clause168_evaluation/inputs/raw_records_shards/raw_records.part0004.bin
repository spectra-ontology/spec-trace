{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE ConfiguredGrantConfigIndex is used to indicate the index of one of multiple UL Configured Grant configurations in one BWP.","paragraph_zero_based":20952},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigIndex information element","paragraph_zero_based":20953},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20954},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIGINDEX-START","paragraph_zero_based":20955},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20956},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigIndex-r16 ::= INTEGER (0.. maxNrofConfiguredGrantConfig-1-r16)","paragraph_zero_based":20957},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20958},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIGINDEX-STOP","paragraph_zero_based":20959},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20961},{"literal_text_all_w_t_and_m_t":"–ConfiguredGrantConfigIndexMAC","paragraph_zero_based":20962},{"literal_text_all_w_t_and_m_t":"The IE ConfiguredGrantConfigIndexMAC is used to indicate the unique Configured Grant configurations index per MAC entity.","paragraph_zero_based":20963},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigIndexMAC information element","paragraph_zero_based":20964},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20965},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIGINDEXMAC-START","paragraph_zero_based":20966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20967},{"literal_text_all_w_t_and_m_t":"ConfiguredGrantConfigIndexMAC-r16 ::= INTEGER (0.. maxNrofConfiguredGrantConfigMAC-1-r16)","paragraph_zero_based":20968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20969},{"literal_text_all_w_t_and_m_t":"-- TAG-CONFIGUREDGRANTCONFIGINDEXMAC-STOP","paragraph_zero_based":20970},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20971},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20972},{"literal_text_all_w_t_and_m_t":"–ConnEstFailureControl","paragraph_zero_based":20973},{"literal_text_all_w_t_and_m_t":"The IE ConnEstFailureControl is used to configure parameters for connection establishment failure control.","paragraph_zero_based":20974},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl information element","paragraph_zero_based":20975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["bbca2cec7d4d2b0fed33a58101ddcc1b0150590400f2b27abce593d4e531108b","b51e37789a09ccf165a03fc4e78753c5c4fcff8b53a8ab8de704cfb831a056f6","1865d4d54a717818b9a134ebe3f56c52212f3e9d507400f7097691bc72c6b686","51f7503d8e0697d1dd1e2c3fcc675f9f20bb26d032230f4ff55b140e392d3f19","00e67b003e87d30d69399d2011a1f23cf75cf790f430f24da0ba1812123f85f2","377eb8583d6c092a91e360df61a6b7d20b80b9a4182e0c172217df5c03d82859","d285bbc359836ff8aa4efb22b123692e41b97460d9a252b910f60783e2d511be","7b818f96a21f5fe145ea5cc849aaa4f7203aca4e081a2274eace740e04d161c0","a75658eb476c7668f96cd61a43569418bbce56462a87d7488d18a0ff43bc3814","9195db2a435ec0d0c395c7d33c0131959faf4d03fcb97673f72a1e557ae9ae01","b488626776dec8fe8644ccfcb64d44c1cebed3ed5615a7b59e740e3ff065eded","7f23761a61b9f072e02ddd23fe052a477b8029935fc8c6f48a8276ce79d2ba82","b2d8fff8206652c3ef534798feef08818e15e9f51fa0ad17e8c2267c19828e8b","366370808ab7a26c4b75d84397925c5c118c21f092ba21f15292640e669d8f5c","49269e5c5ef8b141d90dcd832ec15ae8ba39774d5755a164bea97f93748607bb","26425eaf653f0e713d02771383cb688afdfe58893d0c91153ae1e3cda3f3b4f9","bac87db5dafa70702ba8f8dfdde922486daf11d02f1360d8f37b9b5fd13c73dc","9ae035a10aab1622b8c3979f7e36e39f6e93ac615ae6d5f620cf02764920a732","3a47829202c66bdb05c36073dae83c39404f89bea5ff763863c5c082a9f41cf4","6a7de3e90c9db1e710021a247292433f1e1b697d1dd392e2a3a6b8d9c4c7cac8","b9c2f209291c8bf48bab328fb213d90e3469dc05d4bc4686628a87df1a9af87a","8e0bfe6f98c9d96e8340fe040917499a781bb2f96840dc40dcbfc4202fa55cf9","75071f71a38b5bac371730fb3088d42260d7ec08162f910bc69facbd32e241b6","15ddc6e9b930c54a7dee08c61123d1b0ea83ea2358cefd8337c1362a314f4433"],"paragraph_range_zero_based":[20952,20975],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p20952"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20976},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-START","paragraph_zero_based":20977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20978},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl ::=   SEQUENCE {","paragraph_zero_based":20979},{"literal_text_all_w_t_and_m_t":"    connEstFailCount                    ENUMERATED {n1, n2, n3, n4},","paragraph_zero_based":20980},{"literal_text_all_w_t_and_m_t":"    connEstFailOffsetValidity           ENUMERATED {s30, s60, s120, s240, s300, s420, s600, s900},","paragraph_zero_based":20981},{"literal_text_all_w_t_and_m_t":"    connEstFailOffset                   INTEGER (0..15)                                                         OPTIONAL    -- Need S","paragraph_zero_based":20982},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":20983},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20984},{"literal_text_all_w_t_and_m_t":"-- TAG-CONNESTFAILURECONTROL-STOP","paragraph_zero_based":20985},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":20986},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20987},{"literal_text_all_w_t_and_m_t":"ConnEstFailureControl field descriptions","paragraph_zero_based":20988},{"literal_text_all_w_t_and_m_t":"connEstFailCount","paragraph_zero_based":20989},{"literal_text_all_w_t_and_m_t":"Number of times that the UE detects T300 expiry on the same cell before applying connEstFailOffset.","paragraph_zero_based":20990},{"literal_text_all_w_t_and_m_t":"connEstFailOffset","paragraph_zero_based":20991},{"literal_text_all_w_t_and_m_t":"Parameter \"Qoffsettemp\" in TS 38.304 [20]. If the field is absent, the value of infinity shall be used for \"Qoffsettemp\".","paragraph_zero_based":20992},{"literal_text_all_w_t_and_m_t":"connEstFailOffsetValidity","paragraph_zero_based":20993},{"literal_text_all_w_t_and_m_t":"Amount of time that the UE applies connEstFailOffset before removing the offset from evaluation of the cell. Value s30 corresponds to 30 seconds, value s60 corresponds to 60 seconds, and so on.","paragraph_zero_based":20994},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":20995},{"literal_text_all_w_t_and_m_t":"–ControlResourceSet","paragraph_zero_based":20996},{"literal_text_all_w_t_and_m_t":"The IE ControlResourceSet is used to configure a time/frequency control resource set (CORESET) in which to search for downlink control information (see TS 38.213 [13], clause 10.1). For the UE not supporting multipleCORESET in FR1, in order to receive MBS multicast in CFR within the UE's active BWP, if a CORESET is not configured within the PDCCH-ConfigMulticast, the CORESET other than CORESET#0 configured within the UE's active BWP for scheduling unicast can be used for scheduling MBS multicast, and the CORESET is expected to be included completely within the CFR and the parameters configured in the CORESET are expected to be supported by the UE for MBS multicast.","paragraph_zero_based":20997},{"literal_text_all_w_t_and_m_t":"ControlResourceSet information element","paragraph_zero_based":20998},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":20999}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["77d2acacfba316feceec39ce64165978c6eec6bc5786231f373357cb7f65be63","665beaf9b5753216a81e0d476c7def36461685604a4dbcacfab2ddd484d374c8","e9b2fadd1b230dd7ac4115a2c91dbb57f6b58dfaf85920c1e4496b79509abb99","d8c23e10c0804c8a8be0eb9e8