{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SL-RemoteUE-ToAddMod-r17 ::=       SEQUENCE {","paragraph_zero_based":45648},{"literal_text_all_w_t_and_m_t":"    sl-L2IdentityRemote-r17            SL-DestinationIdentity-r16,","paragraph_zero_based":45649},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigRelay-r17            SL-SRAP-Config-r17                                                      OPTIONAL,    -- Need M","paragraph_zero_based":45650},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45651},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45652},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45653},{"literal_text_all_w_t_and_m_t":"SL-U2U-RemoteUE-ToAddMod-r18 ::=    SEQUENCE {","paragraph_zero_based":45654},{"literal_text_all_w_t_and_m_t":"    sl-L2IdentityRemote-r18             SL-DestinationIdentity-r16,","paragraph_zero_based":45655},{"literal_text_all_w_t_and_m_t":"    sl-SourceRemoteUE-ToAddModList-r18  SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-SourceRemoteUE-ToAddMod-r18 OPTIONAL,    -- Need N","paragraph_zero_based":45656},{"literal_text_all_w_t_and_m_t":"    sl-SourceRemoteUE-ToReleaseList-r18 SEQUENCE (SIZE (1..maxNrofSL-Dest-r16)) OF SL-SourceIdentity-r17          OPTIONAL,    -- Need N","paragraph_zero_based":45657},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45658},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45659},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45660},{"literal_text_all_w_t_and_m_t":"SL-SourceRemoteUE-ToAddMod-r18 ::= SEQUENCE {","paragraph_zero_based":45661},{"literal_text_all_w_t_and_m_t":"    sl-SourceUE-Identity-r18           SL-SourceIdentity-r17,","paragraph_zero_based":45662},{"literal_text_all_w_t_and_m_t":"    sl-SRAP-ConfigU2U-r18              SL-SRAP-ConfigU2U-r18,","paragraph_zero_based":45663},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":45664},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":45665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45666},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-L2RELAYUE-CONFIG-STOP","paragraph_zero_based":45667},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":45668},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45669},{"literal_text_all_w_t_and_m_t":"SL-L2RelayUE-Config field descriptions","paragraph_zero_based":45670},{"literal_text_all_w_t_and_m_t":"sl-RemoteUE-ToAddModList","paragraph_zero_based":45671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["63d03766de612b8be5cd3bb10bcc0a8776c195bb9a3fc1b5e043885f567ed7c0","bd8fefcb2432e50f8f476f8d49b07464e472fa1f47784af345bec63d837621cc","b605ffa81a18f01fa63a6548fcf8d021788a2fcbe59a468c897383b9248013f7","9412684d1356c4391b116cbdca14b261693fa1422be7b92793e5d2c53e115580","26343922627ebc933df9098958c0423a6e5ea6a39b2027680c53d501ef57ede0","fb62c5af980e93894ef459a04f01d0ad106c6aae763baf458025a3438e292e34","13ec9247374918e1b016a689ad68a1df147f7cead1b4f9585f9d18c053f63fb7","8fc6a26fdefdc8a2587c2dd3efabdc478182b8764a2650fd971ce57b6c7d0499","a774316e4aa1c6be8d065501ae25f0203cd046718bea8321bbf4f2f057e2e10f","5002b5e1399ecdc679a1f52d4b79ced225855625e475035ff71dfd7f781e5250","1a57b421ae59df415c0535c253e3bb21e209722491d2d64c49a208ccce8132fe","11ae4fb421f9d837fab40857d17b38a09f0bd7d8746d4c63735b0f1b938afeda","9bc0a2bfd26809d2af1f13fb1fc834a391be203e458b56fdab0dd7fc8750d349","f1b1586ae15e7f16ac6111ddc5c59f87ce3a79a11308908474c1eb43f171e9b7","c74ff19237ed819c449f5e66aba3bdf8983fbac36e83d0b56f4ad6bea879bf71","10eff8