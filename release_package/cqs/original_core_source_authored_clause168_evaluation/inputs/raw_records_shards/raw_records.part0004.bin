{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    frequencyInfoUL                     FrequencyInfoUL                                 OPTIONAL,   -- Cond InterFreqHOAndServCellAdd","paragraph_zero_based":35928},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP                    BWP-UplinkCommon                                OPTIONAL,   -- Cond ServCellAdd","paragraph_zero_based":35929},{"literal_text_all_w_t_and_m_t":"    dummy                               TimeAlignmentTimer","paragraph_zero_based":35930},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35931},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35932},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon-v1700 ::=        SEQUENCE {","paragraph_zero_based":35933},{"literal_text_all_w_t_and_m_t":"    initialUplinkBWP-RedCap-r17         BWP-UplinkCommon                                OPTIONAL    -- Need R","paragraph_zero_based":35934},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35936},{"literal_text_all_w_t_and_m_t":"-- TAG-UPLINKCONFIGCOMMON-STOP","paragraph_zero_based":35937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35939},{"literal_text_all_w_t_and_m_t":"UplinkConfigCommon field descriptions","paragraph_zero_based":35940},{"literal_text_all_w_t_and_m_t":"frequencyInfoUL","paragraph_zero_based":35941},{"literal_text_all_w_t_and_m_t":"Absolute uplink frequency configuration and subcarrier specific virtual carriers.","paragraph_zero_based":35942},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP","paragraph_zero_based":35943},{"literal_text_all_w_t_and_m_t":"The initial uplink BWP configuration for a serving cell (see TS 38.213 [13], clause 12).","paragraph_zero_based":35944},{"literal_text_all_w_t_and_m_t":"initialUplinkBWP-RedCap","paragraph_zero_based":35945},{"literal_text_all_w_t_and_m_t":"If present, (e)RedCap UEs use this UL BWP instead of initialUplinkBWP.","paragraph_zero_based":35946},{"literal_text_all_w_t_and_m_t":"If absent, (e)RedCap UEs use initialUplinkBWP provided that it does not exceed the (e)RedCap UE maximum bandwidth (see also clause 5.2.2.4.2).","paragraph_zero_based":35947},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35948},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":35949},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":35950},{"literal_text_all_w_t_and_m_t":"InterFreqHOAndServCellAdd","paragraph_zero_based":35951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["6c26a1db27d631fcb8d7d512ffb6d92e4df295b843f0e11a5d18d2e850b5401f","f66542ce204a2dd4fc1299cdefe7de5d5909a4bb9dfe8b07cec320e0d0620523","c6e248a49343b3ab7e73dd6336e5d792cf748f00e0313714d0352f87fd45e0fa","4e5b1eccbd74737e1379b8dff8e14a13d90de5d4125a9f97508f0084ac2e1e9a","92e5cd28940da5f2ddde51ca9fb20084aa356eb029e563f20ea0f82d5cc13594","3d7fd9d159717cd3ab15b7330d47b72834ed493f50c8af95efb3d6375a4fc636","ee85b748bc23cffbde44acd000e039a49cc4f90adadfacd8ef775d12b0d59a0c","6db8cd0b100fff134a2c9a0b28067abe9f220992d45e680470536391caf138f1","db0fcc4894763911ac4a07d0bc619328da7ed2d1d5e269477de4096d7e5f5507","592f4a01f2e7f3f7bb69a68e529b7ec0e3e21c7c9c0c1398470b127f7f404b12","e6bec6c0b145745d8c3de9f6f675ab20dd8e40a642f0147089ab3887e192e05d","f65f2eddc5a15efd5af35f46e7953553a47c8bd98988c992edd99ce360db23c6","88db23aa46a0f6d68b63c57bd953f701c01cfcd46c48de029c5fea077c940139","92fc9dca860fe12e3ecc2271e9ca