{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30840},{"literal_text_all_w_t_and_m_t":"–ReferenceConfiguration","paragraph_zero_based":30841},{"literal_text_all_w_t_and_m_t":"The IE ReferenceConfiguration is used provide a configuration that is common, within the same cell group, to all configured non-complete candidate configurations.","paragraph_zero_based":30842},{"literal_text_all_w_t_and_m_t":"ReferenceConfiguration information element","paragraph_zero_based":30843},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30844},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCECONFIGURATION-START","paragraph_zero_based":30845},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30846},{"literal_text_all_w_t_and_m_t":"ReferenceConfiguration-r18 ::= OCTET STRING (CONTAINING RRCReconfiguration)","paragraph_zero_based":30847},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30848},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCECONFIGURATION-STOP","paragraph_zero_based":30849},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30850},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30851},{"literal_text_all_w_t_and_m_t":"–ReferenceLocation","paragraph_zero_based":30852},{"literal_text_all_w_t_and_m_t":"The IE ReferenceLocation contains location information used as a reference location. The value of the field is same as Ellipsoid-Point defined in TS37.355 [49]. The first/leftmost bit of the first octet contains the most significant bit.","paragraph_zero_based":30853},{"literal_text_all_w_t_and_m_t":"ReferenceLocation information element","paragraph_zero_based":30854},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":30855},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-START","paragraph_zero_based":30856},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30857},{"literal_text_all_w_t_and_m_t":"ReferenceLocation-r17 ::= OCTET STRING","paragraph_zero_based":30858},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30859},{"literal_text_all_w_t_and_m_t":"-- TAG-REFERENCELOCATION-STOP","paragraph_zero_based":30860},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":30861},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30862},{"literal_text_all_w_t_and_m_t":"–ReferenceTimeInfo","paragraph_zero_based":30863}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["993d26acaf045a7761dfdc91159589ee1d57d9d3302f32981a2a0d137da90a23","78e165a39fcf22a4cbee2f1379b98e25cfa473b2be1d5a52022d5e6aa1d6d4b3","bdd0b46febfc0a1ac3b9f3769892d5f6ea356931b6869a8fabc32435ba2e828b","978750f94ace1ee25e4ba1d95db1394024bfd4c194e0a8acdad52bdb86c1d379","c68aadf930b1efb7ce99af6d89ab798ac40973feb302b2d46b403df01cbd9bb4","eacc45a370ea24f2056619decc1179919188be08a7bef9fb3e8b26ff548d760a","5c3f882d5936fafb4b591135041eb354a83e098f78606bc7e52e22b3f37a3402","7d75a1b832cf42e0fcf4a24ed5d5188c8b0bc9e0a00cdb2d7b7198d26687d83e","cf52f2db77fca0dda26bfff219b32ca7f38885628dc67ed64d7d26f1b95a011e","4a9ac93dc5f0f789865e23228e593e754d5e6347d4cfe5a9332f5d1668c09f3b","5683e548f7542690f7e7fe3b30463a36b27fd01abc8d15ee3878380b3dc6590e","4ad90c9532bc096a6e9d3f33f90a4a3d36249b16d61d59270c3eb6948557467a","4ec84a3d417adf988e5e33dbc9511468c0b0923e43e5ab9cdec0080a24616603","7e6cc4f439d286305761f415302ccf2d981a9e168f72d40412349587ffa3797c","689f823b357c255c8903c2d7ea8449a918cfcd8f07ee2507cfde414da24a45d1","2adacde26c915c83728961ec358fe937bc1be41fa3927cf8095d5d7001b3527a","eefdeb4dbeea3f8077476a73fa353bd83f9ac2e