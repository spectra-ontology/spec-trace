{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-ADDITIONALSPECTRUMEMISSION-STOP","paragraph_zero_based":18120},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18121},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18122},{"literal_text_all_w_t_and_m_t":"–AdvancedReceiver-MU-MIMO","paragraph_zero_based":18123},{"literal_text_all_w_t_and_m_t":"The IE AdvancedReceiver-MU-MIMO is used to provide a set of assistance information for R-ML (reduced complexity ML) receivers with enhanced inter-user interference suppression for MU-MIMO transmissions.","paragraph_zero_based":18124},{"literal_text_all_w_t_and_m_t":"AdvancedReceiver-MU-MIMO information element","paragraph_zero_based":18125},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18126},{"literal_text_all_w_t_and_m_t":"-- TAG-ADVANCEDRECEIVER-MU-MIMO-START","paragraph_zero_based":18127},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18128},{"literal_text_all_w_t_and_m_t":"AdvancedReceiver-MU-MIMO-r18 ::=      SEQUENCE {","paragraph_zero_based":18129},{"literal_text_all_w_t_and_m_t":"    precodingAndResourceAllocation-r18    BOOLEAN                                                OPTIONAL,    -- Need M","paragraph_zero_based":18130},{"literal_text_all_w_t_and_m_t":"    dmrsPowerBoosting-r18                 BOOLEAN                                                OPTIONAL,    -- Need M","paragraph_zero_based":18131},{"literal_text_all_w_t_and_m_t":"    pdsch-TimeDomainAllocation-r18        BOOLEAN                                                OPTIONAL,    -- Need M","paragraph_zero_based":18132},{"literal_text_all_w_t_and_m_t":"    mcs-Table-r18                         ENUMERATED {qam1024, qam256, qam64, spare1}            OPTIONAL,    -- Need R","paragraph_zero_based":18133},{"literal_text_all_w_t_and_m_t":"    advReceiver-MU-MIMO-DCI-1-1-r18       ENUMERATED {enabled}                                   OPTIONAL,    -- Need R","paragraph_zero_based":18134},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18135},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18137},{"literal_text_all_w_t_and_m_t":"-- TAG-ADVANCEDRECEIVER-MU-MIMO-STOP","paragraph_zero_based":18138},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18139},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18140},{"literal_text_all_w_t_and_m_t":"Editor's note: whether the IE type BOOLEAN within AdvancedReceiver-MU-MIMO-r18 needs to be changed to ENUMERATED {true} depends on further RAN4 clarification.","paragraph_zero_based":18141},{"literal_text_all_w_t_and_m_t":"Editor's note: whether dmrsPowerBoosting-r18 needs to be removed depends on further RAN4 clarification.","paragraph_zero_based":18142},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["771774d9427c6c61389c7397b82489aadaab1c30173cec0ede519582101b7e25","6780bc444ae8435b4146d8f44ca0db40cd0c8c4dd2c103824c435bea6f19f8a1","256e65488a5090d12f0880b670854c5f3a78099ad9bfaf520337877fdffe0bcd","d6d1dc76ffb04824e8cac6491e755f89bba5dad620304c52151d0f0a3b27b8b9","919c901548ec961c95958f2d9aabd22f83accb99047764f059bc6bd50bca7655","409eb6fd5313b2157886eb15cfc24f3943f0b4c4f0b28550f06e80613ab48a52","c5f67884ba7a8f3e7bc62782e35abe006f1cff7607476abda4751a1bc0986684","8cb3448c2a5496b36ccc651e0a12a4d3b906146db37fcbfb6c32d1907c1e1980","6c52d9fe8f0b2b0148ee25b83ee6b0cdd61ba5b92e42ee23837505422cb8acf5","ffb7daf50871d8c8881b5e01b5fab1d6efe50bab49d2964554ee219e4f4fd758","bacdf0fab8b192c3299c25ac7db9c40a99c1bacd5608273827883c55782dd753","e79526ffc1efe5bfc11bf9306ff547ecfcf5f0e38d8ef7a867609b6ce7439df7","48f44bd960a9da6b8c7be2d422d61a59f311845ee14d31cc14c143b2974bfb1e","e90fc3a4eb637cb0c955ae160cde6ec569e2ba6390cec698659a2852f6641482","08c79d9469851c66a738a0278dad8518eda0b239fdc33604e15fccf660f778c2","4eec99c350c673f684522174d24a8f882db7e3c5408af5702882a35c10e1ef88","eca3ffb8feb99e6ef9fd83ede5d740457cdc3c93e818a8825c51401541633b57","d948556a2e3b3d6d09ac7184e7c5043043d416f5c4f5536c127736b7eb1e0aa7","71a5f498f3fb4024bd03632e4e8563d291f4d09d2acea9dc2b29f67bc72ef7ec","987f8671969e5baa944709cb20c93162deadf2e0569999af56a3c010e95d5419","b21909ede52c228221d5e9d5c3efd3efcd63b0d5e66f04d3d6f6db804e5b2f1e","645352c6450d0b7a23b6a5b6396f8c35b8ffb2b8e939ccdccd90d15f1c10846f","753b7c78bdfdfcad8f0338e3af71ed07ca5eb13454e4285eed2371f6ceea1a9c","37c0b1e604b3d78e7bc53291c5bdc0473a1cc8575223cc191b2904bc1abd6164"],"paragraph_range_zero_based":[18120,18143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"AdvancedReceiver-MU-MIMO field descriptions","paragraph_zero_based":18144},{"literal_text_all_w_t_and_m_t":"advReceiver-MU-MIMO-DCI-1-1","paragraph_zero_based":18145},{"literal_text_all_w_t_and_m_t":"Configure the presence of the co-scheduled UE information field in DCI format 1_1 (see TS 38.212 [17], clause 7.3.1.2.2).","paragraph_zero_based":18146},{"literal_text_all_w_t_and_m_t":"dmrsPowerBoosting","paragraph_zero_based":18147},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE can assume the DMRS power boosting configurations (i.e., Number of DMRS CDM groups without data, see TS 38.214 [19], table 4.1-1) of all the co-scheduled UE(s), which has the same DM-RS sequence as the target UE, is the same as the target UE.","paragraph_zero_based":18148},{"literal_text_all_w_t_and_m_t":"If the field is set to false, the UE can not assume the DMRS power boosting configurations (i.e., Number of DMRS CDM groups without data, see TS 38.214 [19], table 4.1-1) of all the co-scheduled UE(s), which has the same DM-RS sequence as the target UE, is the same as the target UE.","paragraph_zero_based":18149},{"literal_text_all_w_t_and_m_t":"mcs-Table","paragraph_zero_based":18150},{"literal_text_all_w_t_and_m_t":"Indicates the MCS table with the highest modulation order among all MCS tables configured to the co-scheduled UE(s), which has the same DMRS sequence as the target UE.","paragraph_zero_based":18151},{"literal_text_all_w_t_and_m_t":"pdsch-TimeDomainAllocation","paragraph_zero_based":18152},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE can assume the time domain resource assignment for PDSCH symbols of all the co-scheduled UE(s), which has the same DMRS sequence as the target UE, is same as the target UE.","paragraph_zero_based":18153},{"literal_text_all_w_t_and_m_t":"If the field is set to false, the UE can not assume the time domain resource assignment for PDSCH symbols of all the co-scheduled UE(s), which has the same DMRS sequence as the target UE, is same as the target UE.","paragraph_zero_based":18154},{"literal_text_all_w_t_and_m_t":"precodingAndResourceAllocation","paragraph_zero_based":18155},{"literal_text_all_w_t_and_m_t":"If the field is set to true, the UE can assume the precoding and resource allocation of the co-scheduled UE are the same in the PRG-level grid configured to the target UE when PRG=2 or 4, when the target UE and any co-scheduled UEs are in different CDM groups and with the same DMRS sequence.","paragraph_zero_based":18156},{"literal_text_all_w_t_and_m_t":"If the field is set to false, the UE can not assume the precoding or resource allocation of the co-scheduled UE is the same in the PRG-level grid configured to the target UE when PRG=2 or 4, when the target UE and any co-scheduled UEs are in different CDM groups and with the same DMRS sequence.","paragraph_zero_based":18157},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18158},{"literal_text_all_w_t_and_m_t":"NOTE:the same DMRS sequence represents the same root DMRS sequence r(n), see TS 38.211 [16], clause 7.4.1.1.1.","paragraph_zero_based":18159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18160},{"literal_text_all_w_t_and_m_t":"–Aerial-Config","paragraph_zero_based":18161},{"literal_text_all_w_t_and_m_t":"The IE Aerial-Config provides configuration parameters for aerial UE.","paragraph_zero_based":18162},{"literal_text_all_w_t_and_m_t":"Aerial-Config information element","paragraph_zero_based":18163},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18164},{"literal_text_all_w_t_and_m_t":"-- TAG-AERIAL-CONFIG-START","paragraph_zero_based":18165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18166},{"literal_text_all_w_t_and_m_t":"Aerial-Config-r18 ::= SEQUENCE {","paragraph_zero_based":18167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["363e5596c9ca08f30e4363da685c3ed1b89236372fb1ca5703fed3c7a821cf50","4e212086a4a5e5e519d897445cfb408a37a8a27aef420e1b259294e0392e04b7","267145189d187573fdcf62dce717b9de791951c55d9fd0ec72a06843417e641d","af940b72cec8ac1d383726ec600a7d3cd8e6d636b7312683e859aae9798a40d8","a24afed6035d47e910ec1db239e2685f2af5df5abca354f43213747fea352be1","ea39c7d200f82cf1bd45062006b1ab7ac6e57991e81dc502d54a43f86639928b","26a0aac6dbec7dbe8dac71b9b764c0093bdee1c191bdd7d996cde17c0c3c3ce2","6f133fc3220003aec3bc5b946092241fb7c698ff3b29660caf19e516f532067c","b1036e31286aa6dde294f7f8e2bd96e20075257e5efdf716dae9389731ac64f2","dd9d185143ad3eeb61e0d24478b9f90884a2a1f46e75a7b12695b0900a0fb473","84db8c967df319ce2a4ea20fec5ee845a641684c2738abe655910da10cd230ab","2804ad3af6d1bef323003ac561edc1ee2a9439f25e66818ccff129d654dd1423","2c6f26d726277e9aa864711482a78fba34c24c38862a4f619ee1b97c2107e396","52b44b08c8e5957f049f8a07f2ef31e778d48e0cd373fa3d4c5b7ecc5f3bd838","3b9e7dd7f79286594e788c27494ef967fb170464f47fcb8c3ba6e2ac7f467eb8","3179af74e9e142a1b4cb01fffb50c8691baf10ca951f9f1627fc24d69335ddce","4a917f983736c7a5a1fd57b8923f9e5f851315c3f000fc1f1cfb19df1fb49424","821a0e1eac4d0bc4e830a71bb5678f9d1539f9a5a9598a0c2a4d74a1512e6105","d934ef84da26b447cb3c2dcb5df60d4dacbd5b549fb96a4e3631e86afe812995","223ec5ec0376c68c55869dd58880ad88de8ef6be35ce65db6d11b9ed848f37f3","ecf601c6d3e949a1ba773e48a3212d845884403ca88109c1cdb76edad5f99324","fdf0654555c2821cf123cf6a51ad9ec95fe3a8127932841ed9f71669f322e35f","c1a89145bc579438fda599fe250f7f9f238d13c7a3fffd8d1eadff5ecbbec4fb","d3d18b2bfdbcfe2c02df4609b757b9471de0ab300204624bf355844a744b57ee"