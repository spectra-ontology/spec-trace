{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"If included, the field indicates a signalling based logged measurement configuration (See TS 37.320 [61]).","paragraph_zero_based":11832},{"literal_text_all_w_t_and_m_t":"tce-Id","paragraph_zero_based":11833},{"literal_text_all_w_t_and_m_t":"Parameter Trace Collection Entity Id: See TS 32.422 [52].","paragraph_zero_based":11834},{"literal_text_all_w_t_and_m_t":"traceRecordingSessionRef","paragraph_zero_based":11835},{"literal_text_all_w_t_and_m_t":"Parameter Trace Recording Session Reference: See TS 32.422 [52].","paragraph_zero_based":11836},{"literal_text_all_w_t_and_m_t":"reportType","paragraph_zero_based":11837},{"literal_text_all_w_t_and_m_t":"Parameter configures the type of MDT configuration, specifically Periodic MDT configuration or Event Triggerd MDT configuration.","paragraph_zero_based":11838},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11839},{"literal_text_all_w_t_and_m_t":"–MBSBroadcastConfiguration","paragraph_zero_based":11840},{"literal_text_all_w_t_and_m_t":"The MBSBroadcastConfiguration message contains the control information applicable for MBS broadcast services transmitted via broadcast MRB.","paragraph_zero_based":11841},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":11842},{"literal_text_all_w_t_and_m_t":"RLC-SAP: UM","paragraph_zero_based":11843},{"literal_text_all_w_t_and_m_t":"Logical channel: MCCH","paragraph_zero_based":11844},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":11845},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration message","paragraph_zero_based":11846},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":11847},{"literal_text_all_w_t_and_m_t":"-- TAG-MBSBROADCASTCONFIGURATION-START","paragraph_zero_based":11848},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":11849},{"literal_text_all_w_t_and_m_t":"MBSBroadcastConfiguration-r17 ::= SEQUENCE {","paragraph_zero_based":11850},{"literal_text_all_w_t_and_m_t":"    criticalExtensions                CHOICE {","paragraph_zero_based":11851},{"literal_text_all_w_t_and_m_t":"        mbsBroadcastConfiguration-r17     MBSBroadcastConfiguration-r17-IEs,","paragraph_zero_based":11852},{"literal_text_all_w_t_and_m_t":"        criticalExtensionsFuture          SEQUENCE {}","paragraph_zero_based":11853},{"literal_text_all_w_t_and_m_t":"    }","paragraph_zero_based":11854},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":11855}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3537cf6df073b3d52855e537fb957f9289e682bad808f96ed7bb00e01fe8ec80","549e21b693ec3b855fc39b14b737fe0e8d56b6e877d3a529d43792291f77648b","932cf54df40428af7d2f2100370308d5a79c28c61a7ffaea17a65d5052ad561d","1fe5ad313f3f23a6d94d9326981ee600b510e994626338e2be47676768d6ccea","55f889866fee6b5299ec48a978269253c75b84b0ad4bbc045cc6184780ac29a1","914a185d20a972c507d183303bf11827edcfa1109e625193a4c492aa2bd29414","82ea5c8a6e827cb3f81154ba948b65519ee1ed520f5e8f4da41863c38ef23441","dab6c07771a039a34ca8032450b6e9e3882aa8aa630b54dd3085a64603b62fb5","bd20e4775fedf055586d100c98461078bb6519e08e4d74de804bdc666c56dc0c","c3ba7276198ef58b2f9dacf2be7dac8866ca316eb3909f1b5913bf104768d512","e22bf885f2bec1ff1b82753ff372595c74ce3528269bef33e03436cb470bf46c","10ca91bcd94679d49cb87954192b131964060bffbf89dded677ed53ba3cdb617","f49132d494ac569b65bb332d8e1e796d00f36778ba8dc09ef534c3853be9c1b0","9eabefa2036076a25ebb28e7168684086cc7c934b793a6da3a1604b1744e6dd3","3a073a4d2b98c68f50f9f