{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    CellAccessRelatedInfo,","paragraph_zero_based":51552},{"literal_text_all_w_t_and_m_t":"    SL-ServingCellInfo-r17","paragraph_zero_based":51553},{"literal_text_all_w_t_and_m_t":"FROM NR-RRC-Definitions;","paragraph_zero_based":51554},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51555},{"literal_text_all_w_t_and_m_t":"SL-AccessInfo-L2U2N-r17 ::=             SEQUENCE {","paragraph_zero_based":51556},{"literal_text_all_w_t_and_m_t":"    cellAccessRelatedInfo-r17               CellAccessRelatedInfo,","paragraph_zero_based":51557},{"literal_text_all_w_t_and_m_t":"    sl-ServingCellInfo-r17                  SL-ServingCellInfo-r17,","paragraph_zero_based":51558},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":51559},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":51560},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51561},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":51562},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51563},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-ACCESSINFO-L2U2N-STOP","paragraph_zero_based":51564},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":51565},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51566},{"literal_text_all_w_t_and_m_t":"9.5Radio Information Related to TX Profile","paragraph_zero_based":51567},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC information elements that are transferred in Tx Profile.","paragraph_zero_based":51568},{"literal_text_all_w_t_and_m_t":"–SL-TxProfile","paragraph_zero_based":51569},{"literal_text_all_w_t_and_m_t":"The IE SL-TXProfile includes the Tx profile information.","paragraph_zero_based":51570},{"literal_text_all_w_t_and_m_t":"SL-TxProfile information elements","paragraph_zero_based":51571},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":51572},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPROFILE-START","paragraph_zero_based":51573},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51574},{"literal_text_all_w_t_and_m_t":"SL-TxProfile DEFINITIONS AUTOMATIC TAGS ::=","paragraph_zero_based":51575}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e5540b48ae3171c99fa5c12e82e800b8203757f886aea14df2275e1e9e129bf2","3c75b4e36c90d69453932251019649a87671a339a85f9f67d772209ff0966c8b","217970579acd63de8b061eed8153ee2a2fe89bac3f23462c1ae946b2b1fcba5e","1350a75ea9f4c08223549a7598050479aab5955729110633d3de9621c53da13d","082ac5dcd1fa49698824d822eebb4bb6a4702d94ee5d9c11f98490d1578efd0e","e9c93593ac0591c7a6855d45874ded91223e89cfff5fc25a27934a986cc11706","1f5a17865760bc6704bd826890404b0548314b9f85a054732ec63d51e87e0473","e95aa84c887d5497b3f274f13f2bdf8a6251a92aa4cb88aa56d882b9a99d1256","a4831527970708d9bf3b2822faa822cd1de162ec8d283ec0b46ced45eb81b0c2","fb038436fabd6ef672950520e02002c13d5ab44732a236ee68b755319d69ba1a","09c749bbf97ed2a1815faddd1b04ab1cc084709b1c2e685e39adfc63f7dc3673","808dc01fb1a5f9f1fa6ca943059adf1a0208f5bfa307e11b7b30b3bc85a240e2","27b3b9917dce3b69bce462568927f90033bd0564c4903e5caba5bb2c44796a11","4438ac36fbdf6ad625449a100d80c7e98f9a722b1ac1e428804409f4e551f25f","41e646ba0e40b42b322526a978944925a65812952731e00ba7ac429fd475d345","670484b1a302b6029f9ff78e5e7e02c533bf0ef3b9e992317e10a2dd198f6386","ab118101c654c354d5d3da0cc389bc8e4d5a8cbbf1f49489076bc259d6739e25","0541f6fdeeab9afd5ce048edd9063e7692f86b19c9cdf6ed69ef8eabce670509","e8d520fbaa3775d938790a3318ad7eafa99f24ff7ddb9e66bc40b8e60e251055","f20281c7643dbfa9b34c8dc84a9028ff6e242d207768d693216884955d6ce8b1","12451d82f602040b2c3dccdf9e51def29eb800a4accfa7889543cae3490307f3","6a5243907d084ee1002f75be9f29ca1c2ff2315ac7c1ce5e2a1bffe34fb4a44d","38e27fdd221adb304368d04199d427fe9232246be30d2b75188a2458da2fda97","727e695e879a0d0284bfc82667b28eee0473bbe11347a4387b8168f3a558f7c8"],"paragraph_range_zero_based":[51552,51575],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p51552"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51576},{"literal_text_all_w_t_and_m_t":"BEGIN","paragraph_zero_based":51577},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51578},{"literal_text_all_w_t_and_m_t":"SL-TxProfile-v1800 ::=                ENUMERATED {backwardsCompatible, backwardsIncompatible, spare6, spare5, spare4, spare3, spare2, spare1}","paragraph_zero_based":51579},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51580},{"literal_text_all_w_t_and_m_t":"END","paragraph_zero_based":51581},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51582},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-TXPROFILE-STOP","paragraph_zero_based":51583},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":51584},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51585},{"literal_text_all_w_t_and_m_t":"10Generic error handling","paragraph_zero_based":51586},{"literal_text_all_w_t_and_m_t":"10.1General","paragraph_zero_based":51587},{"literal_text_all_w_t_and_m_t":"The generic error handling defined in the subsequent clauses applies unless explicitly specified otherwise e.g. within the procedure specific error handling.","paragraph_zero_based":51588},{"literal_text_all_w_t_and_m_t":"The UE shall consider a value as not comprehended when it is set:","paragraph_zero_based":51589},{"literal_text_all_w_t_and_m_t":"-to an extended value that is not defined in the version of the transfer syntax supported by the UE;","paragraph_zero_based":51590},{"literal_text_all_w_t_and_m_t":"-to a spare or reserved value unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved value.","paragraph_zero_based":51591},{"literal_text_all_w_t_and_m_t":"The UE shall consider a field as not comprehended when it is defined:","paragraph_zero_based":51592},{"literal_text_all_w_t_and_m_t":"-as spare or reserved unless the specification defines specific behaviour that the UE shall apply upon receiving the concerned spare/reserved field.","paragraph_zero_based":51593},{"literal_text_all_w_t_and_m_t":"10.2ASN.1 violation or encoding error","paragraph_zero_based":51594},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":51595},{"literal_text_all_w_t_and_m_t":"1>when receiving an RRC message on the BCCH, CCCH, PCCH, MCCH or a PC5 RRC message on SBCCH for which the abstract syntax is invalid [6]:","paragraph_zero_based":51596},{"literal_text_all_w_t_and_m_t":"2>ignore the message.","paragraph_zero_based":51597},{"literal_text_all_w_t_and_m_t":"NOTE:This clause applies in case one or more fields is set to a value, other than a spare, reserved or extended value, not defined in this version of the transfer syntax. E.g. in the case the UE receives value 12 for a field defined as INTEGER (1..11). In cases like this, it may not be possible to reliably detect which field is in the error hence the error handling is at the message level.","paragraph_zero_based":51598},{"literal_text_all_w_t_and_m_t":"10.3Field set to a not comprehended value","paragraph_zero_based":51599}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["b2eef1104dd45ce76122de4a357bd340a3b5d96a5c31c5140cdb82c2711d93a7","a74be0aaa63a9dad01fae7d2e306ac13db5ab60dd9cd86fd73e27685025413fe","6d321750c0be4ad8146960a8fa057a71f4ffadea3e96e7aee2fd6bcd062cffaf","28922b7537a92166c05a2969eabb2c726e936f033f29f51d77a628d0699b1c33","63e62b8f60a9127b34bc58cb3fd8ae513a17b43a0e19f77320223819a4eefdef","67aefa36136dadc04a01fc0e4b9108d545d817959d6dec15424892cfe429d6a1","faf36783aa737c17d7caa80fb9941622b1d83fbaa06f64e3ac2a6e6ffdcbf907","09ce629f740539230ff7e372e97c57312403f300f8944b16d8d64ee760892089","45808258732096c7ecd496edf332aea03e3fc16fb946c95833aa3ab9ec3baa0d","e97b36baee898d45a77952bd35e85771f32df7abd71260e693cce07824f27b4a","2f741a790deb4c15a5c2d2fe6ed6f7d27ed05d00f1f02668282cc6a7a68dec14","5e9a9893bf5da22c7879bd1ec58c5513133bfd983212a93c68addcc987345002","3565c50bcc6af52bb205e967d7e9369dd4628bee6a35315475492c73bfc09add","520de358a99607d1c0d4ac2cf71b712629830005f9d971070e1ecb5c2627defc","b370d80bd010508a5610e10c1b2a0bffff1e90bafbadbc96cbdfff56babf5598","4649edb50cf02621ad30f8bb95558e40d2160237646cc8fa1264b1ac13e2274a","bf7aa08781d3e61eab66cb0d3208e080aa58d30117e1edb2df04994c6a730a67","eca4cac3fd7a4a0fb11169fd1ccaaef7e4eb97b8bc5c43649b66ac065f93fc2c","4605b1fd4fb55e88ab21f5db124197105338c4734c165e69ea0b5483eb299dd0","6546c009fb503151df01e3068f6ea304bd7b15af5482f7e70f0f31df015004d6","4fd2a738dc482cb5e844d720f79d490357bab294928b960e2e5aaeb92d87939d","b8c333fc8e9a33c1509ddf0973f473128b288b9ac1e16c5d560da3844a77b76c","78bbf0b25e11a60680d78214c2b7dc7d8c4a55adfdd51f94a21ad8043c50205a","115840de1ae2ccccc116bc036730024f6702e3b69f5265ee5e5f6c3f4482cc38"],"paragraph_range_zero_based":[51576,51599],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p51576"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The UE shall, when receiving an RRC message or PC5 RRC message on any logical channel:","paragraph_zero_based":51600},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that has a value that the UE does not comprehend:","paragraph_zero_based":51601},{"literal_text_all_w_t_and_m_t":"2>if a default value is defined for this field:","paragraph_zero_based":51602},{"literal_text_all_w_t_and_m_t":"3>treat the message while using the default value defined for this field;","paragraph_zero_based":51603},{"literal_text_all_w_t_and_m_t":"2>else if the concerned field is optional:","paragraph_zero_based":51604},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with the need code for absence of the concerned field;","paragraph_zero_based":51605},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":51606},{"literal_text_all_w_t_and_m_t":"3>treat the message as if the field were absent and in accordance with clause 10.4.","paragraph_zero_based":51607},{"literal_text_all_w_t_and_m_t":"10.4Mandatory field missing","paragraph_zero_based":51608},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":51609},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that is mandatory to include in the message (e.g. because conditions for mandatory presence are fulfilled) and that field is absent or treated as absent:","paragraph_zero_based":51610},{"literal_text_all_w_t_and_m_t":"2>if the RRC message was not received on DCCH or CCCH; or","paragraph_zero_based":51611},{"literal_text_all_w_t_and_m_t":"2>if the PC5 RRC message was not received on SCCH:","paragraph_zero_based":51612},{"literal_text_all_w_t_and_m_t":"3>if the field concerns a (sub-field of) an entry of a list (i.e. a SEQUENCE OF):","paragraph_zero_based":51613},{"literal_text_all_w_t_and_m_t":"4>treat the list as if the entry including the missing or not comprehended field was absent;","paragraph_zero_based":51614},{"literal_text_all_w_t_and_m_t":"3>else if the field concerns a sub-field of another field, referred to as the 'parent' field i.e. the field that is one nesting level up compared to the erroneous field:","paragraph_zero_based":51615},{"literal_text_all_w_t_and_m_t":"4>consider the 'parent' field to be set to a not comprehended value;","paragraph_zero_based":51616},{"literal_text_all_w_t_and_m_t":"4>apply the generic error handling to the subsequent 'parent' field(s), until reaching the top nesting level i.e. the message level;","paragraph_zero_based":51617},{"literal_text_all_w_t_and_m_t":"3>else (field at message level):","paragraph_zero_based":51618},{"literal_text_all_w_t_and_m_t":"4>ignore the message.","paragraph_zero_based":51619},{"literal_text_all_w_t_and_m_t":"NOTE 1:The error handling defined in these clauses implies that the UE ignores a message with the message type or version set to a not comprehended value.","paragraph_zero_based":51620},{"literal_text_all_w_t_and_m_t":"NOTE 2:The nested error handling for messages received on logical channels other than DCCH, CCCH and SCCH applies for errors in extensions also, even for errors that can be regarded as invalid network operation e.g. the network not observing conditional presence.","paragraph_zero_based":51621},{"literal_text_all_w_t_and_m_t":"NOTE 3:UE behaviour on receipt of an RRC message on DCCH or CCCH or a PC5 RRC message on SCCH that does not include a field that is mandatory (e.g. because conditions for mandatory presence are fulfilled) is unspecified.","paragraph_zero_based":51622},{"literal_text_all_w_t_and_m_t":"The following ASN.1 further clarifies the levels applicable in case of nested error handling for errors in extension fields.","paragraph_zero_based":51623}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["295a75f366582b668c64902f7d7aada9e61c28ef90796c6218d9a6ef06ce6555","0a3edf0dd1a4992b15dcb24626d5d7ba20c186b453ec23cd0f39f97c6e1c4945","ac87ba7c975239d7bca5c95d54203c806bce824baf768432ed66d4b48fc9a5fa","d2a7d85eaf74b932e21b308408ecc7af157f7fd1e937f27d0a1f2eacb3abb719","762dab72927bce86566071974e5324ed86a25bb838c71c0464595a49f83c3a53","93d6560bac6f737a4c748b3ab164c208f28eef67bbd7d5f4e0aa7fa8688c6a0e","55f6c50c91ca812352be681159c2eec7f3bc2d53c4a181f131096ed56fe9d70c","0bd87f690134fbec30c42449ecf9e28e687705f3c7ec1955502907555ceb0764","1ec93f3e2fb6b10c65f0c4fab6bcf16abd351710ec7db4d31ef8bb1a0881930f","e4a112931995f389bad045eadaf78e6b872cbe99bbf7d09b7e587c44a2dc7460","74f0f7c5ec363529ab4f8b6d716a997ec937c7768451ada7d47cb2d60f22c159","c843470684e597bb673cd8fe3cfd06fa588781f52457a3599bac76b58d6829e8","9eb79c9eba1442f90239d00054f3e3b31caeba5e38019234e0ea974a6c5bea96","8442a907b88654ddab38b8e2b0f919e53afce9a20f238fe183c3aa92454be8b4","4962760d0daf95901cf34f05d9fc614f52cef5d536888d575ef4c364d2638c9d","246693260b313ba66fd92696846d6971f63ebe7834bb7c275a67c7a0034603e1","2cb42d9828dc142d8574408b8ed1d408face90875e66b283ef1ab09107ecf5ec","ba1f5ef3445ad50633feef082935d0ce47a77effed5ac58a1afa9ae4a82bae08","1955b62fe04e6a66aa0ac6f8cbd48de160b85e785bdfb308f0035ae543afd612","61992e2568ca6691a66d9ff4d5da3d04b55bc01d4a68126ef9820fcbbac74ecb","1e8f6e39ab05b8554fc5c06f83f4169d3c9d9b4348eeadc7d5287ecddf94fedd","b9d7174cebbdfa67ac8b05c227d8c70cb62bf7a65ce3ab26adec30e132da7bc5","73d60cf11eb8fbad575703cd3ac5c9ceaf98e8cb8a936a6e1f263a31d502e91b","3239b5a0aaf3baecc6b6cc6f03af600e5274b751343f09fdb65ec1547e70805a"],"paragraph_range_zero_based":[51600,51623],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p51600"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- /example/ ASN1START","paragraph_zero_based":51624},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51625},{"literal_text_all_w_t_and_m_t":"-- Example with extension addition group","paragraph_zero_based":51626},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51627},{"literal_text_all_w_t_and_m_t":"ItemInfoList ::=                    SEQUENCE (SIZE (1..max)) OFItemInfo","paragraph_zero_based":51628},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51629},{"literal_text_all_w_t_and_m_t":"ItemInfo ::=                        SEQUENCE {","paragraph_zero_based":51630},{"literal_text_all_w_t_and_m_t":"    itemIdentity                        INTEGER (1..max),","paragraph_zero_based":51631},{"literal_text_all_w_t_and_m_t":"    field1                              Field1,","paragraph_zero_based":51632},{"literal_text_all_w_t_and_m_t":"    field2                              Field2                  OPTIONAL,           -- Need N","paragraph_zero_based":51633},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":51634},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":51635},{"literal_text_all_w_t_and_m_t":"    field3-r9                       Field3-r9               OPTIONAL,              -- Cond Cond1","paragraph_zero_based":51636},{"literal_text_all_w_t_and_m_t":"    field4-r9                       Field4-r9               OPTIONAL               -- Need N","paragraph_zero_based":51637},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":51638},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":51639},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51640},{"literal_text_all_w_t_and_m_t":"-- Example with traditional non-critical extension (empty sequence)","paragraph_zero_based":51641},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51642},{"literal_text_all_w_t_and_m_t":"BroadcastInfoBlock1 ::=             SEQUENCE {","paragraph_zero_based":51643},{"literal_text_all_w_t_and_m_t":"    itemIdentity                        INTEGER (1..max),","paragraph_zero_based":51644},{"literal_text_all_w_t_and_m_t":"    field1                              Field1,","paragraph_zero_based":51645},{"literal_text_all_w_t_and_m_t":"    field2                              Field2                  OPTIONAL,           -- Need N","paragraph_zero_based":51646},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                BroadcastInfoBlock1-v940-IEs    OPTIONAL","paragraph_zero_based":51647}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["9ca44c3d35cb1e366c92e9fce063dc49141638d1cc36cfc43c0127d1cb01687d","035cc101cfa135139f952c276572500b8ada484beb093b184c9510057d279c36","3e58dc7aac9de78ce5d1b94e4bfe40e0f467df1b99fc1002d7c8d02fba65a027","e430660dbb52cdace669659cc6360044e8a5a228248700143e0395f533c1bd5c","0f591f4630f175a7d81a08256bf7f1e4d7654fefac9a292cce593ddc114d7675","04cfe0b36fb784f16da78fb6b5544eab4a87b4b98e3b49500f7b8c02f11ac444","28eaef9e5ed5189f832b7b92aab1d9895468f193bba9afbc62cc1e5510698695","ab262a577393b0f408a15cf7435a674644c071a531935bbe25353329648ebde0","93f46b39b247958b802355dc7e5ba0881375a5578674bfa8bfcd0c1732cf7f85","a8076bedd5b5cb4ec65decff791a07adf463b9dca18b1dd11ffa492486a631e0","606784bfee2e6abb20a44edc8e103bd5f41d2e7149833451b0586fb320614960","808b10af278fa473ca6b179eef3a1fdac99a8f2b462d6a58a40c75d0d1d7fd2f","dce20c1a9f41ea3ecb411b362b90d15b7ba6bd39fb7b2610778c35a8f57d8131","77f29544882ba2e3161f3aafb252c7466b380b4cc6c2c11500ef42813e8c6a65","c425159ac51bbe38d794cacd2d7fa19d60553ed0c0ea44afb4f9773b3fb7c032","a3c86885d159444395a185536993b2e73aac699dfd31b631e8c55a59294a64e8","79216e046b8624e9b8d372407de25f1d9890a19ef3507de6e530bd58ecf819eb","32122330a2af36186d3deebc8372901081c7e7db8547eea043c909e239c81b99","8f666bf507f1d671d808a66d4340ecb462d72d17e75847a62bf747398ed44401","fbe746ce8666ce8612ef3db962bfb9ac1720d3787475f5aeef3bf8af7a8c8135","9fccce5e61a6c84f9c40f403774eaf0af933ade42159250608a1f05146e20d62","a8588f0f09d1c97521e37c6e9829049fbcabba47aa2102de6390b6f80207579b","ed7af971812c9d59e4dbfee0fffaf10cfa540140fa7706802ca9146362dc43bb","9a59d96b00ef84a8aefce83462e8e6ff6ab35a14b4ee63f40d4ff1b0ed4b9845"],"paragraph_range_zero_based":[51624,51647],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p51624"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":51648},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51649},{"literal_text_all_w_t_and_m_t":"BroadcastInfoBlock1-v940-IEs::=SEQUENCE {","paragraph_zero_based":51650},{"literal_text_all_w_t_and_m_t":"    field3-r9                           Field3-r9               OPTIONAL,           -- Cond Cond1","paragraph_zero_based":51651},{"literal_text_all_w_t_and_m_t":"    field4-r9                           Field4-r9               OPTIONAL,           -- Need N","paragraph_zero_based":51652},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                SEQUENCE {}             OPTIONAL            -- Need S","paragraph_zero_based":51653},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":51654},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51655},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":51656},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51657},{"literal_text_all_w_t_and_m_t":"The UE shall, apply the following principles regarding the levels applicable in case of nested error handling:","paragraph_zero_based":51658},{"literal_text_all_w_t_and_m_t":"-an extension addition group is not regarded as a level on its own. E.g. in the ASN.1 extract in the previous, a error regarding the conditionality of field3 would result in the entire itemInfo entry to be ignored (rather than just the extension addition group containing field3 and field4);","paragraph_zero_based":51659},{"literal_text_all_w_t_and_m_t":"-a traditional nonCriticalExtension is not regarded as a level on its own. E.g. in the ASN.1 extract in the previous, an error regarding the conditionality of field3 would result in the entire BroadcastInfoBlock1 to be ignored (rather than just the non-critical extension containing field3 and field4).","paragraph_zero_based":51660},{"literal_text_all_w_t_and_m_t":"10.5Not comprehended field","paragraph_zero_based":51661},{"literal_text_all_w_t_and_m_t":"The UE shall, when receiving an RRC message on any logical channel:","paragraph_zero_based":51662},{"literal_text_all_w_t_and_m_t":"1>if the message includes a field that the UE does not comprehend:","paragraph_zero_based":51663},{"literal_text_all_w_t_and_m_t":"2>treat the rest of the message as if the field was absent.","paragraph_zero_based":51664},{"literal_text_all_w_t_and_m_t":"NOTE:This clause does not apply to the case of an extension to the value range of a field. Such cases are addressed instead by the requirements in clause 10.3.","paragraph_zero_based":51665},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":51666},{"literal_text_all_w_t_and_m_t":"11Radio information related interactions between network nodes","paragraph_zero_based":51667},{"literal_text_all_w_t_and_m_t":"11.1General","paragraph_zero_based":51668},{"literal_text_all_w_t_and_m_t":"This clause specifies RRC messages that are transferred between network nodes. These RRC messages may be transferred to or from the UE via another Radio Access Technology. Consequently, these messages have similar characteristics as the RRC messages that are transferred across the NR radio interface, i.e. the same transfer syntax and protocol extension mechanisms apply.","paragraph_zero_based":51669},{"literal_text_all_w_t_and_m_t":"11.2Inter-node RRC messages","paragraph_zero_based":51670},{"literal_text_all_w_t_and_m_t":"11.2.1General","paragraph_zero_based":51671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["f3a7b6ef722841fed1285ef5edaed72b9