B                   RSRP-Range                                                                OPTIONAL, -- Need M","paragraph_zero_based":18399},{"literal_text_all_w_t_and_m_t":"    candidateBeamRSList                 SEQUENCE (SIZE(1..maxNrofCandidateBeams)) OF PRACH-ResourceDedicatedBFR   OPTIONAL, -- Need M","paragraph_zero_based":18400},{"literal_text_all_w_t_and_m_t":"    ssb-perRACH-Occasion                ENUMERATED {oneEighth, oneFourth, oneHalf, one, two,","paragraph_zero_based":18401},{"literal_text_all_w_t_and_m_t":"                                                       four, eight, sixteen}                                      OPTIONAL, -- Need M","paragraph_zero_based":18402},{"literal_text_all_w_t_and_m_t":"    ra-ssb-OccasionMaskIndex            INTEGER (0..15)                                                           OPTIONAL, -- Need M","paragraph_zero_based":18403},{"literal_text_all_w_t_and_m_t":"    recoverySearchSpaceId               SearchSpaceId                                                             OPTIONAL, -- Need R","paragraph_zero_based":18404},{"literal_text_all_w_t_and_m_t":"    ra-Prioritization                   RA-Prioritization                                                         OPTIONAL, -- Need R","paragraph_zero_based":18405},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryTimer            ENUMERATED {ms10, ms20, ms40, ms60, ms80, ms100, ms150, ms200}            OPTIONAL, -- Need M","paragraph_zero_based":18406},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18407}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["16cc7b7ffae822623d85bc84e551a9792cf59799387e1078327827ff7c6525dd","b7efcb93f8ac50de