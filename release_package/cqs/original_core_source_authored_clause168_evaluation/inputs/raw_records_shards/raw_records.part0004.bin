{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Neigh","paragraph_zero_based":53400},{"literal_text_all_w_t_and_m_t":"Neighbour(ing)","paragraph_zero_based":53401},{"literal_text_all_w_t_and_m_t":"Param(s)","paragraph_zero_based":53402},{"literal_text_all_w_t_and_m_t":"Parameter(s)","paragraph_zero_based":53403},{"literal_text_all_w_t_and_m_t":"Phys","paragraph_zero_based":53404},{"literal_text_all_w_t_and_m_t":"Physical","paragraph_zero_based":53405},{"literal_text_all_w_t_and_m_t":"PCI","paragraph_zero_based":53406},{"literal_text_all_w_t_and_m_t":"Physical Cell Id","paragraph_zero_based":53407},{"literal_text_all_w_t_and_m_t":"Proc","paragraph_zero_based":53408},{"literal_text_all_w_t_and_m_t":"Process","paragraph_zero_based":53409},{"literal_text_all_w_t_and_m_t":"Reconfig","paragraph_zero_based":53410},{"literal_text_all_w_t_and_m_t":"Reconfiguration","paragraph_zero_based":53411},{"literal_text_all_w_t_and_m_t":"Reest","paragraph_zero_based":53412},{"literal_text_all_w_t_and_m_t":"Re-establishment","paragraph_zero_based":53413},{"literal_text_all_w_t_and_m_t":"Req","paragraph_zero_based":53414},{"literal_text_all_w_t_and_m_t":"Request","paragraph_zero_based":53415},{"literal_text_all_w_t_and_m_t":"Rx","paragraph_zero_based":53416},{"literal_text_all_w_t_and_m_t":"Reception","paragraph_zero_based":53417},{"literal_text_all_w_t_and_m_t":"Sched","paragraph_zero_based":53418},{"literal_text_all_w_t_and_m_t":"Scheduling","paragraph_zero_based":53419},{"literal_text_all_w_t_and_m_t":"SIB","paragraph_zero_based":53420},{"literal_text_all_w_t_and_m_t":"SystemInformationBlock","paragraph_zero_based":53421},{"literal_text_all_w_t_and_m_t":"Sync","paragraph_zero_based":53422},{"literal_text_all_w_t_and_m_t":"Synchronisation","paragraph_zero_based":53423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["01b91e7061d7154264a35b450165677c7495cb17c886df1cf10c710968211d56","7d8cb68d4cfcf8dab29492bd35cd24152d0c21612049fc24d0413888a17319c4","404616b3cc162936ce18c64fb51e1aeab4c6116bd6d75d7f996fbe7cb32eaabf","6d0b2b89cd06822373c0b8bd820dc3c459d2916c314828e1ccf3ea694139343c","226877458b1eb298bd40000c4c000e25bce268965c01de2a06a758dd13ca6c50","5930c14031ee781c02d65525a32f021b438f5797281371d60fd412a2a2237ba5","8e5ba8c86d6051e88849a045aff872373ae94a1029b4c880b675b1ce65e7a72a","fadf127ef476e1b0f12c6cd7336a72330c376955d1ecb49d6df16071838c487f","97e613be35813ac9a3e7980be8ea1e8585cf3a5e038aba801476b2614fe9afa8","05f4c65b5af0c2bdded7a6892096dc4230660ba1736e9db6571a5d484208ae15","88228d4fb81c2a5bc204630fed8e6d68c8f4d2643aa1803d5cecf0c671df9513","474c22da3392d930dd91025648ccff1698f219757fc1e612a1c912d3ab686a67","7222d72f461a71298a8335b69df32497a148d16d1dc990f1de03b453db764d12","dd8f5b3850e382f4924b0fef6e792ea41cc5a9b33bb83cb289323a94d1541d42","d6387916691bb234160b78aa5826e29d0433ce7be37d5c22fe1b7fa23b4e3d55","b800e3337f7097808374b38b0045e9cbccbe16d20adab47e8d7bc435baf68782","59b461ef5e2f20a53b07ab0ba35332c9f8359a823cb6373522dd3d42e11a6544","7d25855c9fb391c9cc3c6ed64ea5eed95c4e3287c3363b93fe052ac7dbe8b448","6ee809a95d16d3bb6adb0ecc1ce9881a4d47e29ed86f7075cabbee1bd8c15b3b","d359967a6144d2008cb345dc6181279d8dfd8b6f152fcdd1855f3d80be90ffbd","613768e62f379c4e2dc1cc764d615f2fa42fb5dcf82d1a7a63728c374a0ca820","15745a15965e23aabd58cbc7e52c5062ff9343be4bfd78444ebe4933070b4df9","7a208fa40a78ef62b6652eee6d7ffedf32023e9976f9626322152b52c4521d4e","2a34206a4caf93245fb7f0af6e629b234f1a280550ec4f8b4c52a2f58f724fb5"],"paragraph_range_zero_based":[53400,53423],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a 