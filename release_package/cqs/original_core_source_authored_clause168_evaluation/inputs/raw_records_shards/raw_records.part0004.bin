26920},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":26921},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":26922},{"literal_text_all_w_t_and_m_t":"    dl-PRS-r17                  SEQUENCE {","paragraph_zero_based":26923},{"literal_text_all_w_t_and_m_t":"        qcl-DL-PRS-ResourceID-r17       NR-DL-PRS-ResourceID-r17,","paragraph_zero_based":26924},{"literal_text_all_w_t_and_m_t":"        ...","paragraph_zero_based":26925},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":26926},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":26927}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f5e8f962d6d6b7ba39a62f2a5d0fb6302490d81db709c8660654be993a5398e0","265e315c5867ae4a83344d4953d9ed06d1145cab05ba534d166c7b59773a601c","b45e465f3d011ec7c14bf3997a24a350d2b7a041f0103718b2ca7ae27eaaa717","13ddc0776abcf1814765abdaacca0c353f95e393ebb5018fba64912bdf72f6ac","e2e73ba5a634e9743e424bdf5c4a6d0861f7d9116f50368da2bf6debb704ed29","a19ba80ee3e97130f565b3b4b3e344b7929ce12c81318855dcda4bcae09b0a87","8116d29f7601f0c3822a1195abcdc2c6d580dc7adb9d9c0da22bc3052e996ae1","8b320d5874be10336791539268606f82aec950b106213330b11e3d669e8bcc01","0c0bd634587a0346df44830025e5ce6f5e84f29b9579bc028cd91e8f268bc721","cd25dcb398a8d5094917a07f8aa36a2718670bf85b02df112fd1f121072e6e93","cd5af9d14015ee3795891626830814e1f1bafb57b990c7c8312e301b5885a650","a8bb6a215478bce03ac1989fbfeef9cde7d3e7bfbea0e0ef08bda14e976e1c1e","c3f7d76b8ffce772141840839bd098b82c2f2b26c7c3e14b19b7efd144c66be5","36a05101ad88fd8f872d67f34f79bb03cfffcf104cb21e2dff9bf530d53a0b6c","3794ed89fa13361091f91a46bc77ff37fc68f7f5e2bf25e93b738f2352db76b1","6f638fd71cda455ee03497318aaf06245f244b36592e9c7420e2c26db3fd90df","54c43695e856befb74409d71cab8a921dd3164c328df89d4e4627c9afd96454f","aad3ebc54ade9b9fcea57a3790c9607cb4b3cc0d2b395a58e9f9ae6d99989881","40504989f22e8c751e347c23c5468d60b9fda233924ce5802e220dfcd1004c96","dbee5a6f4d5add64661ccb70c36f7bbb287cf561662712d16b7a03e2cd266676","85877e2d6918a74be93c94b55541796aee911ab5cedfe60f77810426fb12000a","4964c96b3f5dc4f6429eee8c19af25e2f65ab921ea08008f5a83c8ce5c799abe","f6d3fc47fbbe572cef2e3cbc22bc6ba7b17d506f83b9485ae9490792c4b39f24","7eb925ebb496ca08c5aa37c15a158067a6ced57db82fec5ecab329e9697b3795"],"paragraph_range_zero_based":[26904,26927],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p26904"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26928},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26929},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-ResourceID-r17 ::= INTEGER (0..maxNrofPRS-ResourcesPerSet-1-r17)","paragraph_zero_based":26930},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26931},{"literal_text_all_w_t_and_m_t":"RepFactorAndTimeGap-r17 ::=  SEQUENCE {","paragraph_zero_based":26932},{"literal_text_all_w_t_and_m_t":"    repetitionFactor-r17         ENUMERATED {n2, n4, n6, n8, n16, n32, spare2, spare1},","paragraph_zero_based":26933},{"literal_text_all_w_t_and_m_t":"    timeGap-r17                  ENUMERATED {s1, s2, s4, s8, s16, s32, spare2, spare1}","paragraph_zero_based":26934},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26935},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26936},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-DL-PRS-PDC-INFO-STOP","paragraph_zero_based":26937},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26938},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26939},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-PDC-ResourceSet field descriptions","paragraph_zero_based":26940},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceBandwidth","paragraph_zero_based":26941},{"literal_text_all_w_t_and_m_t":"This field specifies the number of PRBs allocated for all the DL-PRS Resource (allocated DL-PRS bandwidth) in multiples of 4 PRBs in this resource set. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same bandwidth. Integer value 1 corresponds to 24 PRBs, value 2 corresponds to 28 PRBs, value 3 corresponds to 32 PRBs and so on.","paragraph_zero_based":26942},{"literal_text_all_w_t_and_m_t":"dl-PRS-StartPRB","paragraph_zero_based":26943},{"literal_text_all_w_t_and_m_t":"This field specifies the start PRB index defined as offset with respect to subcarrier 0 in common resource block 0 for the DL-PRS Resource. All DL-PRS Resources of the DL-PRS-PDC Resource Set have the same value of dl-PRS-StartPRB.","paragraph_zero_based":26944},{"literal_text_all_w_t_and_m_t":"numSymbols","paragraph_zero_based":26945},{"literal_text_all_w_t_and_m_t":"This field specifies the number of symbols per DL-PRS Resource within a slot. The UE does not expect to be configured for PDC with a PRS with numSymbols equals to n1 unless an SSB index is provided as a typeC or typeC-plus-typeD QCL source, or another PRS resource with numSymbols more than n1 is provided as QCL source.","paragraph_zero_based":26946},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":26947},{"literal_text_all_w_t_and_m_t":"This field specifies the periodicity of DL-PRS allocation in slots and the slot offset with respect to SFN #0 slot #0 in the PCell where the DL-PRS-PDC Resource Set is configured (i.e., slot where the first DL-PRS Resource of DL-PRS-PDC Resource Set occurs).","paragraph_zero_based":26948},{"literal_text_all_w_t_and_m_t":"repFactorAndTimeGap","paragraph_zero_based":26949},{"literal_text_all_w_t_and_m_t":"If this field is absent, the value for repetitionFactor is 1 (i.e., no resource repetition).","paragraph_zero_based":26950},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26951}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d3f9acc49be187f51b94ace6ac4e55c2faf98f01c3cc0a0473f4e2b2d31c9b0c","d14d1e980de4c5fad4a00de5d0dfe01141c16f2284695eb0d2b6f7ebc4da59f2","e0439f06714822594277917b99cc82c78c6509c91d8f8ead0599326ae48580ab","76ac4e456fcc36b3ed868ae16a1b64cbd7959175a37657dbb04fd2dfa3af55e7","52d7e9528f0e3c4fd4282f1ea9b52179729c5d04a45c6e7fabceb8e38c92f1a1","9b44f20d4c52f167290ca47b52ad7345d440677b73dd2294cb7be9c46e67360b","dc1845586a2a8266435a53c9d8389c04a18995033565a9bc693219e4041440d3","e98c5ed9b3cd046157d77262d40271dc2877ddad74f4ec5a4785b4dbb6a5c46d","c0d3c1e1f528a92ed1ec546c477eb8157d15cd22e372e253f86a0e299589081a","8439a25fbfca4294fe68d962397cad8a0eb77306e8cf2da22e4bf26a7e922145","62f4871a5df296d053e0117b30a8c8469348d5c69e8c64b95826797b2c81fe81","19018f5af1195866cf32443f4bce54adb719abf4204be003193c70d78eefb41e","88792385de2a5c2b299205b0e4e11ea804947071817f5a7b8256f89cd34f64fa","17c015fbbf37468eb8c1ab85142d962253ebb577fd276267ca414ec26b3c314b","ba95ddf145a90b6ea335bc684e9bb72230eb9f2832e0738db670d0d235611672","b731ea85312e4478525ad9608c2c430c068cbe39b20a13632dc4ab1ad8b7302a","7922e64f7871001fff680f389e6fcb358eadc3bf842180a656d778754778c120","32942cf64fa3189ae99ce3b3fc1a7c4acfb2b82263fca5c43f26a586dad9867b","324b00f240d0499d59168556ea198d6ba11963b5f81196ea8bc247f2e3ef0817","a26fc31a4f46b484b746e3d321d777313f57b94d9a96d76b9aac4e04d7ee5aba","610e95d8002ebc6ecb5c0c840dc16e393f63439d3ed20908a0480bbac57379ed","c7817cec248d24bb04f6f96efbd4a4d364cf1a1fff3fe24de65c78633ab234c3","62e5af71089f00da52ef3bbca9b231894a9efaf43f6fc7626fd740bc038a1d34","4b5d73f2ddbcfbf2236a97188f5bb5d5b25c5d61132686c46a81f0d5b4589cdf"],"paragraph_range_zero_based":[26928,26951],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p26928"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"RepFactorAndTimeGap field descriptions","paragraph_zero_based":26952},{"literal_text_all_w_t_and_m_t":"repetitionFactor","paragraph_zero_based":26953},{"literal_text_all_w_t_and_m_t":"This field specifies how many times each DL-PRS Resource is repeated for a single instance of the DL-PRS Resource Set. It is applied to all resources of the DL-PRS Resource Set. Enumerated values n2, n4, n6, n8, n16, n32 correspond to 2, 4, 6, 8, 16, 32 resource repetitions, respectively.","paragraph_zero_based":26954},{"literal_text_all_w_t_and_m_t":"timeGap","paragraph_zero_based":26955},{"literal_text_all_w_t_and_m_t":"This field specifies the offset in units of slots between two repeated instances of a DL-PRS Resource corresponding to the same DL-PRS Resource ID within a single instance of the DL-PRS Resource Set. The time duration spanned by one DL-PRS Resource Set containing repeated DL-PRS Resources should not exceed the periodicity configured by periodicityAndOffset.","paragraph_zero_based":26956},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26957},{"literal_text_all_w_t_and_m_t":"NR-DL-PRS-Resource field description","paragraph_zero_based":26958},{"literal_text_all_w_t_and_m_t":"dl-PRS-ResourceSymbolOffset","paragraph_zero_based":26959},{"literal_text_all_w_t_and_m_t":"This field specifies the starting symbol of the DL-PRS Resource within a slot. If dl-PRS-ResourceSymbolOffset-v1800 is present, the UE shall ignore dl-PRS-ResourceSymbolOffset-r17.","paragraph_zero_based":26960},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26961},{"literal_text_all_w_t_and_m_t":"–NR-NS-PmaxList","paragraph_zero_based":26962},{"literal_text_all_w_t_and_m_t":"The IE NR-NS-PmaxList is used to configure a list of additionalPmax and additionalSpectrumEmission, as defined in TS 38.101-1 [15], table 6.2.3.1-1A, TS 38.101-2 [39], table 6.2.3.1-2, and TS 38.101-5 [75], table 6.2.3.1-1A for a given frequency band.","paragraph_zero_based":26963},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList information element","paragraph_zero_based":26964},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":26965},{"literal_text_all_w_t_and_m_t":"-- TAG-NR-NS-PMAXLIST-START","paragraph_zero_based":26966},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26967},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList ::=                      SEQUENCE (SIZE (1..maxNR-NS-Pmax)) OF NR-NS-PmaxValue","paragraph_zero_based":26968},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26969},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxValue ::=                     SEQUENCE {","paragraph_zero_based":26970},{"literal_text_all_w_t_and_m_t":"    additionalPmax                          P-Max                               OPTIONAL,   -- Need N","paragraph_zero_based":26971},{"literal_text_all_w_t_and_m_t":"    additionalSpectrumEmission              AdditionalSpectrumEmission","paragraph_zero_based":26972},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26973},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26974},{"literal_text_all_w_t_and_m_t":"NR-NS-PmaxList-v1760 ::=                SEQUENCE (SIZE (1.. maxNR-NS-Pmax)) OF NR-NS-PmaxValue-v1760","paragraph_zero_based":26975}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["c381d6923deeac70bde418767505f679cb3ea479c516bd826088b5e58a3adf1b","9e1b9ae7665cee4e766311b76c83bf76f18288c26fd70d9f72a3a5de5b549e00","b08f5cf0769b1e1c2cce01c4d1927eaa3d52f46b1326822fa76939e9a7fc2ccf","81fa