{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERPLMN-LIST-START","paragraph_zero_based":35688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35689},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN-List ::=         SEQUENCE (SIZE (1.. maxPLMN)) OF UAC-BarringPerPLMN","paragraph_zero_based":35690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35691},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN ::=              SEQUENCE {","paragraph_zero_based":35692},{"literal_text_all_w_t_and_m_t":"    plmn-IdentityIndex                  INTEGER (1..maxPLMN),","paragraph_zero_based":35693},{"literal_text_all_w_t_and_m_t":"    uac-ACBarringListType               CHOICE{","paragraph_zero_based":35694},{"literal_text_all_w_t_and_m_t":"        uac-ImplicitACBarringList           SEQUENCE (SIZE(maxAccessCat-1)) OF UAC-BarringInfoSetIndex,","paragraph_zero_based":35695},{"literal_text_all_w_t_and_m_t":"        uac-ExplicitACBarringList           UAC-BarringPerCatList","paragraph_zero_based":35696},{"literal_text_all_w_t_and_m_t":"    }                                                                                                     OPTIONAL     -- Need S","paragraph_zero_based":35697},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35698},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35699},{"literal_text_all_w_t_and_m_t":"-- TAG-UAC-BARRINGPERPLMN-LIST-STOP","paragraph_zero_based":35700},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35701},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35702},{"literal_text_all_w_t_and_m_t":"UAC-BarringPerPLMN-List field descriptions","paragraph_zero_based":35703},{"literal_text_all_w_t_and_m_t":"uac-ACBarringListType","paragraph_zero_based":35704},{"literal_text_all_w_t_and_m_t":"Access control parameters for each access category valid only for a specific PLMN or SNPN. UE behaviour upon absence of this field is specified in clause 5.3.14.2.","paragraph_zero_based":35705},{"literal_text_all_w_t_and_m_t":"plmn-IdentityIndex","paragraph_zero_based":35706},{"literal_text_all_w_t_and_m_t":"Index of the PLMN or SNPN across the plmn-IdentityInfoList and npn-IdentityInfoList fields included in SIB1.","paragraph_zero_based":35707},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35708},{"literal_text_all_w_t_and_m_t":"–UAV-Config","paragraph_zero_based":35709},{"literal_text_all_w_t_and_m_t":"The IE UAV-Config provides configuration parameters for UAV UE.","paragraph_zero_based":35710},{"literal_text_all_w_t_and_m_t":"UAV-Config information element","paragraph_zero_based":35711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["110525ee70033aa2b5b6d2b5879a0434ebe408ab866eadcd230350801d6ccf70","adf47159cad61448588b615c0bca416d6251f3e4f189a8b700cface5110c0a71","75f82820a58a3caa3a635effe8dffb9f5544104aabf647e2d438edad07ba4d9b","48dcd276ee1987ff405b7de4533734758d09f094d04204292ae8e4fb900c19bb","7e57b57301c18f45bfd535feee28c3def620b14d74cc4437ab099535edfac682","fe585456be4b6e83aad2a84f0ca1fd1949324875454c7831e555b710ce253865","896b7e1777cf3a4a0d5509b822af346a8a12157a8b5748fe028e103f41937882","4f6573969ede65c0b5728f22042eaeb29bd97f03587bea3a169be006b02496ab","4e0f7a91e2b424d5e93ebab8550152e08e07d43dc6b49da338e3e82dd9356fa4","cdc49d20b4d0fd9e40e5f2532bfc0af6524e6cad5bef0dd97034175961e61f12","2b93edf55698506d07b67e94c2a18c469c60d08678b56a668c4726f29c3808e8","ae3fdf6fe5005f6ba4fda6da95ee27ee53950a83ce8f95a6bfcddc77b47c7f65","b4f6d3a18eae9553a1eeadb15b3c74071b7f384d1f94b9146ec48dc