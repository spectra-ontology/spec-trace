{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30648},{"literal_text_all_w_t_and_m_t":"BeamFailureDetection-r17 ::=        SEQUENCE {","paragraph_zero_based":30649},{"literal_text_all_w_t_and_m_t":"    failureDetectionSet1-r17            BeamFailureDetectionSet-r17                                               OPTIONAL, -- Need R","paragraph_zero_based":30650},{"literal_text_all_w_t_and_m_t":"    failureDetectionSet2-r17            BeamFailureDetectionSet-r17                                               OPTIONAL, -- Need R","paragraph_zero_based":30651},{"literal_text_all_w_t_and_m_t":"    additionalPCI-r17                   AdditionalPCIIndex-r17                                                    OPTIONAL  -- Need R","paragraph_zero_based":30652},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30653},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30654},{"literal_text_all_w_t_and_m_t":"RadioLinkMonitoringRS ::=           SEQUENCE {","paragraph_zero_based":30655},{"literal_text_all_w_t_and_m_t":"    radioLinkMonitoringRS-Id            RadioLinkMonitoringRS-Id,","paragraph_zero_based":30656},{"literal_text_all_w_t_and_m_t":"    purpose                             ENUMERATED {beamFailure, rlf, both},","paragraph_zero_based":30657},{"literal_text_all_w_t_and_m_t":"    detectionResource                   CHOICE {","paragraph_zero_based":30658},{"literal_text_all_w_t_and_m_t":"        ssb-Index                           SSB-Index,","paragraph_zero_based":30659},{"literal_text_all_w_t_and_m_t":"        csi-RS-Index                        NZP-CSI-RS-ResourceId","paragraph_zero_based":30660},{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":30661},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":30662},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":30663},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":30664},{"literal_text_all_w_t_and_m_t":"BeamFailureDetectionSet-r17  ::=    SEQUENCE {","paragraph_zero_based":30665},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToAddModList-r17        SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-r17","paragraph_zero_based":30666},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":30667},{"literal_text_all_w_t_and_m_t":"    bfdResourcesToReleaseList-r17       SEQUENCE (SIZE(1..maxNrofBFDResourcePerSet-r17)) OF BeamLinkMonitoringRS-Id-r17","paragraph_zero_based":30668},{"literal_text_all_w_t_and_m_t":"                                                                                                                  OPTIONAL, -- Need N","paragraph_zero_based":30669},{"literal_text_all_w_t_and_m_t":"    beamFailureInstanceMaxCount-r17     ENUMERATED {n1, n2, n3, n4, n5, n6, n8, n10}                              OPTIONAL, -- Need R","paragraph_zero_based":30670},{"literal_text_all_w_t_and_m_t":"    beamFailureDetectionTimer-r17       ENUMERATED {pbfd1, pbfd2, pbfd3, pbfd4, pbfd5, pbfd6, pbfd8, pbfd10}      OPTIONAL, -- Need R","paragraph_zero_based":30671}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["44688870b07b3966e069749fd8e169ac370c6e6722f695c44404b3ea01dafa2f","d05476d7b3d30f0a618a7ecac679dac4b6366b859fab803781b8ee984e54165c","a79442b970f3656e58d3e971b5c98bcf9cde43eec7a3486177de39ff5bdf682d","64d185e9e4ce57fa5f333595bb9a25c5066ed8796bc2d0664d57a50a979d9e14","0d13a8665e78648da449f782a5c8472b20feaa53