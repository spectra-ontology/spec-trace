{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18000},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfigMSG1-Repetition-r18         SI-RequestConfigRepetition-r18                   OPTIONAL,  -- Cond MSG-1","paragraph_zero_based":18001},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfigSUL-MSG1-Repetition-r18     SI-RequestConfigRepetition-r18                   OPTIONAL,  -- Cond SUL-MSG-1","paragraph_zero_based":18002},{"literal_text_all_w_t_and_m_t":"    posSI-RequestConfigRedCap-MSG1-Repetition-r18  SI-RequestConfigRepetition-r18                   OPTIONAL   -- Cond REDCAP-MSG-1","paragraph_zero_based":18003},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18004},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18005},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18006},{"literal_text_all_w_t_and_m_t":"PosSchedulingInfo-r16 ::= SEQUENCE {","paragraph_zero_based":18007},{"literal_text_all_w_t_and_m_t":"    offsetToSI-Used-r16          ENUMERATED {true}                                              OPTIONAL,  -- Need R","paragraph_zero_based":18008},{"literal_text_all_w_t_and_m_t":"    posSI-Periodicity-r16        ENUMERATED {rf8, rf16, rf32, rf64, rf128, rf256, rf512},","paragraph_zero_based":18009},{"literal_text_all_w_t_and_m_t":"    posSI-BroadcastStatus-r16    ENUMERATED {broadcasting, notBroadcasting},","paragraph_zero_based":18010},{"literal_text_all_w_t_and_m_t":"    posSIB-MappingInfo-r16       PosSIB-MappingInfo-r16,","paragraph_zero_based":18011},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18012},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18013},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18014},{"literal_text_all_w_t_and_m_t":"PosSIB-MappingInfo-r16 ::=   SEQUENCE (S