{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    additionalRACH-perPCI-ToAddModList-r18   SEQUENCE (SIZE (1.. maxNrofAdditionalPRACHConfigs-r18)) OF  RACH-ConfigTwoTA-r18","paragraph_zero_based":18912},{"literal_text_all_w_t_and_m_t":"                                                                                                             OPTIONAL, -- Cond 2TA-Only","paragraph_zero_based":18913},{"literal_text_all_w_t_and_m_t":"    additionalRACH-perPCI-ToReleaseList-r18  SEQUENCE (SIZE (1.. maxNrofAdditionalPRACHConfigs-r18)) OF RACH-ConfigTwoTAIndex-r18","paragraph_zero_based":18914},{"literal_text_all_w_t_and_m_t":"                                                                                                             OPTIONAL,  -- Need N","paragraph_zero_based":18915},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg1-RepetitionNum2-r18    RSRP-Range                                                      OPTIONAL,  -- Need R","paragraph_zero_based":18916},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg1-RepetitionNum4-r18    RSRP-Range                                                      OPTIONAL,  -- Need R","paragraph_zero_based":18917},{"literal_text_all_w_t_and_m_t":"    rsrp-ThresholdMsg1-RepetitionNum8-r18    RSRP-Range                                                      OPTIONAL,  -- Need R","paragraph_zero_based":18918},{"literal_text_all_w_t_and_m_t":"    preambleTransMax-Msg1-Repetition-r18     ENUMERATED {n1, n2, n4, n6, n8, n10, n20, n50, n100, n200}      OPTIONAL   -- Cond Msg1Rep1","paragraph_zero_based":18919},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":18920},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18921},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18922},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-ConfigList-r17 ::=       SEQUENCE (SIZE(1..maxAdditionalRACH-r17)) OF AdditionalRACH-Config-r17","paragraph_zero_based":18923},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18924},{"literal_text_all_w_t_and_m_t":"AdditionalRACH-Config-r17 ::=       SEQUENCE {","paragraph_zero_based":18925},{"literal_text_all_w_t_and_m_t":"    rach-ConfigCommon-r17               RACH-ConfigCommon                                                   OPTIONAL,  -- Need R","paragraph_zero_based":18926},{"literal_text_all_w_t_and_m_t":"    msgA-ConfigCommon-r17               MsgA-ConfigCommon-r16                                               OPTIONAL,  -- Need R","paragraph_zero_based":18927},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":18928},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":18929},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18930},{"literal_text_all_w_t_and_m_t":"NumberOfMsg3-Repetitions-r17::=         ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16}","paragraph_zero_based":18931},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18932},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKCOMMON-STOP","paragraph_zero_based":18933},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":18934},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18935}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["95e95939161a79b5ab8ae8245428db5cee580cbe5012c3224b7104e067f46e82","67c1df0f9e1063e5b2a90fefe598bccd4d98bd6e9d7bfb7de719091fcbe305aa","0f2f40be291dc9805f9c2d27b342da12372509947a8bddf3332d1a78969af57d","dfaee2a1096ec3a47b0b036d53335e74ae7ed5fe29993b101c67a4fd9a725a74","b66d4dc4cb6b8916f108995dfd78656550a55d0e8620c5797b20e6273dbb99e3","b26219c6d985d06b4abe788851d1f2a21fc96390a335ef95646d2848b7d412d4","b3da91fb661138c972fb203249dd5ec535f58f568ef15e3fd14f9598f472a77f","339d123b338764432030a62c3f62b95769f8e8a67cea2db3873ac2b4ee9d2862","6891dbecbc8d13d2ab7ab99883a2d3f39c5823ed0f1c4c208996574445a24fb5","d4f5c11b3af437f1c28d3bec59e9ad352a427ae93053c72a322d2f176403527a","ef6b605675b067c9632151c58cdeb1b42d5971b73a2087993ab39fbb350c873e","70fc149d2cca127ffe42bd3d01c4d6622d15d79014bea8f327131a9d63133a42","adc5604b38ee20d252022b402051667d2787ced2e5f096dbcd9a2c84ef65f0a1","f2ff274c1c523d88612237aa177645b68c3ca52cde1b4d10bcd711fa5ae00559","955b282e793dbccadacd3be511a3aa0a83568764ab76986f1807913b45967a17","eb60e93dc78f2bfe4259c3d17a1114ab5e5c120359d2afc09e873f3a8097472d","c54ceea5af43dfd2ef07b7fa2591f45337241e3ef418e8d92c3b4534e97c3daa","28ba67c5e9f7b5037ce92a316419971e5b68180a14dae39ef691019b13940b68","e99b62cfe5bdb2063b2426d0478c55967a467381b6d8c17beea0e348cf88dcf7","f76df32656ae82d295f33fae1c3115ecaf80e52fe3aa47b60bafcf2fc47f015c","e24aaee1134e67341db3d6e076950efd41a2de211517d86858691ea5c1a18931","cb28152bad424d20ff3de7b239f60657c97a109e4c8ff2010613c82f8ea32f02","2f7449bdfffeede40703f379284cab15ad9c2594f18ddacf8b04a9ae6eb9ec97","627002af82c59fab659a175132c09d9ab40c0f91ef2af965c79f9d9c15a8ffcc"],"paragraph_range_zero_based":[18912,18935],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18912"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"BWP-UplinkCommon field descriptions","paragraph_zero_based":18936},{"literal_text_all_w_t_and_m_t":"additionalRACH-ConfigList","paragraph_zero_based":18937},{"literal_text_all_w_t_and_m_t":"List of feature or feature combination-specific RACH configurations, i.e. the RACH configurations configured in addition to the one configured by rach-ConfigCommon and by msgA-ConfigCommon. The network associates all possible preambles of an additional RACH configuration to one or more feature(s) or feature combination(s). The network does not configure this list to have more than 32 entries. If both rach-ConfigCommon and msgA-ConfigCommon are configured for a specific FeatureCombination, the network always provides them in the same additionalRACH-Config.","paragraph_zero_based":18938},{"literal_text_all_w_t_and_m_t":"additionalRACH-perPCI-ToAddModList","paragraph_zero_based":18939},{"literal_text_all_w_t_and_m_t":"List of RACH configurations for the additional PCIs. The RACH configuration for an additional PCI is applied for Random Access procedure initiated by PDCCH order towards to the additional PCI, as specified in TS 38.321 clause 5.1.1b. This list includes the same number of elements like additionalPCI-ToAddModList for this serving cell and the n-th element of this list is for the PCI in the n-th element of additionalPCI-ToAddModList. This configuration may be different for different UEs.","paragraph_zero_based":18940},{"literal_text_all_w_t_and_m_t":"enableRA-PrioritizationForSlicing","paragraph_zero_based":18941},{"literal_text_all_w_t_and_m_t":"Indicates whether or not the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep should override the ra-PrioritizationForAccessIdentity. The field is applicable only when the UE is configured by upper layers with both NSAG and Access Identity 1 or 2. If value TRUE is configured, the UE should only apply the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep. If value FALSE is configured, the UE should only apply ra-PrioritizationForAccessIdentity. If the field is absent, whether to use ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep or ra-PrioritizationForAccessIdentity is up to UE implementation.","paragraph_zero_based":18942},{"literal_text_all_w_t_and_m_t":"mcs-Msg3-Repetitions","paragraph_zero_based":18943},{"literal_text_all_w_t_and_m_t":"Configuration of eight candidate MCS indexes for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. Only the first 4 configured or default MCS indexes are used for PUSCH transmission scheduled by RAR UL grant. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {0, 1, 2, 3, 4, 5, 6, 7} (see TS 38.214 [19], clause 6.1.4).","paragraph_zero_based":18944},{"literal_text_all_w_t_and_m_t":"msgA-ConfigCommon","paragraph_zero_based":18945},{"literal_text_all_w_t_and_m_t":"Configuration of the cell specific PRACH and PUSCH resource parameters for transmission of MsgA in 2-step random access type procedure. The NW can configure msgA-ConfigCommon only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or DL BWPs associated with nonCellDefiningSSB or, for (e)RedCap UEs, the RedCap-specific initial downlink BWP.","paragraph_zero_based":18946},{"literal_text_all_w_t_and_m_t":"numberOfMsg3-RepetitionsList","paragraph_zero_based":18947},{"literal_text_all_w_t_and_m_t":"The number of repetitions for PUSCH transmission scheduled by RAR UL grant and DCI format 0_0 with CRC scrambled by TC-RNTI. This field is only applicable when the UE selects Random Access resources indicating Msg3 repetition in this BWP. If this field is absent when the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon, the UE shall apply the values {n1, n2, n3, n4} (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":18948},{"literal_text_all_w_t_and_m_t":"preambleTransMax-Msg1-Repetition","paragraph_zero_based":18949},{"literal_text_all_w_t_and_m_t":"Max number of transmissions of MSG1 repetitions number (2, 4 and 8) performed before switching to higher repetition number (see TS 38.321 [3], clauses 5.1.1). This field is only applicable when more than one repetition numbers are configured in shared RO. If the field is absent, switching from lower repetition number to higher repetition number is not allowed.","paragraph_zero_based":18950},{"literal_text_all_w_t_and_m_t":"pucch-ConfigCommon","paragraph_zero_based":18951},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUCCH of this BWP. ","paragraph_zero_based":18952},{"literal_text_all_w_t_and_m_t":"pusch-ConfigCommon","paragraph_zero_based":18953},{"literal_text_all_w_t_and_m_t":"Cell specific parameters for the PUSCH of this BWP.","paragraph_zero_based":18954},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommon","paragraph_zero_based":18955},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters which the UE uses for contention based and contention free random access as well as for contention based beam failure recovery in this BWP. The NW configures SSB-based RA (and hence RACH-ConfigCommon) only for UL BWPs if the linked DL BWPs (same bwp-Id as UL-BWP) are the initial DL BWPs or DL BWPs containing the SSB associated to the initial DL BWP or DL BWPs associated with nonCellDefiningSSB or, for (e)RedCap UEs, the RedCap-specific initial downlink BWP. The network configures rach-ConfigCommon (without suffix) and/or rach-ConfigCommon-r17, whenever it configures contention free random access (for reconfiguration with sync or for beam failure recovery), the UE then applies the corresponding configuration depending on the RACH resource set selected upon RACH initialization, as specified in TS 38.321 [3]. For RedCap-specific initial uplink BWP, rach-ConfigCommon is always configured when msgA-ConfigCommon is configured in this BWP.","paragraph_zero_based":18956},{"literal_text_all_w_t_and_m_t":"rach-ConfigCommonIAB","paragraph_zero_based":18957},{"literal_text_all_w_t_and_m_t":"Configuration of cell specific random access parameters for the IAB-MT. The IAB specific IAB RACH configuration is used by IAB-MT, if configured.","paragraph_zero_based":18958},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdMsg1-RepetitionNum2, rsrp-ThresholdMsg1-RepetitionNum4, rsrp-ThresholdMsg1-RepetitionNum8","paragraph_zero_based":18959}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["74a3a1cb09be6b1ca41094ca158b7ad0d57179297914ff8caee2c8efef9aa958","39b985d5bfe151287c85b89037098735da0e0f53e0764024563a350bb18e971d","ecc8b04841106ee85139a4b55af6982207505952d7c1081304df8bb5a86e8177","691fe213f20497fc2d70a1edd3a69d762bc111e2d695f80b8f7459a014e2d79c","800276b2602e9a3a7cecdc932332b0990dcbd32ec30ef4a90ccf343cd2bb946e","13634cd409ef50e8c0ef3fbdb28a385b5ea160588c0627620f5e780a4498e7c9","a82a652cef912c1d9cc688fc75f1e85c9a79e3ba72ba3ca94a1a0a8c9cde7578","edba421fc45ddf81becec7153a0968ed879864796f9a3ddae579099f71e945a8","087e86f1c5692fd99639079272be81cae111b4d18abc597de3586e4aa285d11b","9670ebbe9b8f5e403d09659a90531b5e3d56a245a3622f2d1bc3dcf6dd00323a","3848f448b77bbc109d3b9fab56310c676e2717a094795382658830ed673da568","b79b7ab0797e0ae0489b155340b0d425f99a4aa27683bd75ed185e05a02a18fa","77bc2112d47671233b1b626554a3e6961861b5f42177bb78be3a0b8636713e42","3befedd8136eab5061f81825746f61bb392bc4efbef6cbc3e44da05daf783338","121b58e28c392e46ca8b809e202683f90b1cd12367e69c448a9805b2f142a893","8ebefcdbb4566f7961b57f0a3ea04bbb149f6de59ac4a008f93fe2d38e42e7da","9c2d6d62dd2b3b0f5e2f1d61ddfa337377577619cb8a0008cb479f82dfe5756d","e438e3be4424dbce798db65d8e3644a8cb26d86cd9ed628c925e7578f179426d","788dff8719ab88ea5da4a56a7f513ee1240e79a892b0c5520bcf74a5f72f91f8","fd7ced8491a52ce41dbce54c7a4b870b187c4636478899a6bd887b542b957fc4","3077d38bf000d7b927322d0e22edc47d275133294784604c2828f02aea5d136d","8f5962181448415349e26f62a5cecb98823534b3bb939b3709ca23277c092fec","86ed645ffcdeb51831bb8233e3e9ea1cb9858d336ef8f19a07ad595f41e1a624","5de712afcb17d7959148d6208c3afab56e88593255f1ddf3cce71296ab325fa8"],"paragraph_range_zero_based":[18936,18959],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18936"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"Threshold used by the UE for determining whether to select resources indicating Msg1 repetition number 2, 4 or 8 in this BWP, as specified in TS 38.321 [3]. The value applies to all the BWPs and all RACH configurations. For a given MSG1 repetition number, this corresponding field is mandatory if both set(s) of Random Access resources with MSG1 repetition indication associated with this MSG1 repetition number and set(s) of Random Access resources without MSG1 repetition indication are configured in the BWP, or if the set(s) of Random Access resources with MSG1 repetition indication associated with this MSG1 repetition number and set(s) of Random Access resources with MSG1 repetition indication associated with a lower repetition number are configured in the BWP. It is absent otherwise.","paragraph_zero_based":18960},{"literal_text_all_w_t_and_m_t":"rsrp-ThresholdMsg3","paragraph_zero_based":18961},{"literal_text_all_w_t_and_m_t":"Threshold used by the UE for determining whether to select resources indicating Msg3 repetition in this BWP, as specified in TS 38.321 [3]. The field is mandatory if both set(s) of Random Access resources with MSG3 repetition indication and set(s) of Random Access resources without MSG3 repetition indication are configured in the BWP. It is absent otherwise.","paragraph_zero_based":18962},{"literal_text_all_w_t_and_m_t":"useInterlacePUCCH-PUSCH","paragraph_zero_based":18963},{"literal_text_all_w_t_and_m_t":"If the field is present, the UE uses uplink frequency domain resource allocation Type 2 for cell-specific PUSCH, e.g., PUSCH scheduled by RAR UL grant (see TS 38.213 [13] clause 8.3 and TS 38.214 [19], clause 6.1.2.2) and uses interlaced PUCCH Format 0 and 1 for cell-specific PUCCH (see TS 38.213 [13], clause 9.2.1).","paragraph_zero_based":18964},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18965},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":18966},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":18967},{"literal_text_all_w_t_and_m_t":"Msg1Rep1","paragraph_zero_based":18968},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if the set(s) of Random Access resources with MSG1 repetition indication are configured in the BWP-UplinkCommon. It is absent otherwise.","paragraph_zero_based":18969},{"literal_text_all_w_t_and_m_t":"Msg3Rep","paragraph_zero_based":18970},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need S, if the set(s) of Random Access resources with MSG3 repetition indication are configured in the BWP-UplinkCommon. It is absent otherwise.","paragraph_zero_based":18971},{"literal_text_all_w_t_and_m_t":"RA-PrioSliceAI","paragraph_zero_based":18972},{"literal_text_all_w_t_and_m_t":"The field is optionally present in SIB1, Need R, if both parameters ra-PrioritizationForAccessIdentity and the ra-PrioritizationForSlicing/ra-PrioritizationForSlicingTwoStep are present in SIB1. It is absent otherwise.","paragraph_zero_based":18973},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":18974},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, in the BWP-UplinkCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":18975},{"literal_text_all_w_t_and_m_t":"2TA-Only","paragraph_zero_based":18976},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need N in the BWP-UplinkCommon if additionalPCI-ToAddModList is present in spCellConfigDedicated or sCellConfigDedicated and it has the same number of entries as the additionalPCI-ToAddModList. It is absent otherwise.","paragraph_zero_based":18977},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18978},{"literal_text_all_w_t_and_m_t":"–BWP-UplinkDedicated","paragraph_zero_based":18979},{"literal_text_all_w_t_and_m_t":"The IE BWP-UplinkDedicated is used to configure the dedicated (UE specific) parameters of an uplink BWP.","paragraph_zero_based":18980},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated information element","paragraph_zero_based":18981},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":18982},{"literal_text_all_w_t_and_m_t":"-- TAG-BWP-UPLINKDEDICATED-START","paragraph_zero_based":18983}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["5407436a60937d7e85fedbed2265895ae26ea1ea3c30d4c3af8551dc195ecc47","a12afe83a6fcab056baa06293542b04feea2599f4e3be42b32a04886ede30a23","7fb250c340f4eb6b7808c9eab24ef732e4f53457026431e994f27129c6befa12","4e1ab1f2a9d4a1656cc1382f52433b18e73e94ebb437e3463ac35c76bbe1fb5a","8a52ab354966a6e378571fe3405225457c00420e08ff045d704a22df1e04935f","1c6fa3438828ea5359cc4f6cf2de85e4ae01ffb2fbb263976aea13acaab7dda6","f30682b5e373bfacd7adadf8a300a4cde75f63dd384c27e812d9f58f72add33e","f498d772991515c0e0b593e8f8b9996ddca592ece5784906859803abfbe069f5","73ce57ab393027f49d3e0ea365385f1296f52af43c034303db28eb917584d372","bbb81a6654b69a7670171b0ef0d2d1dd171c0ba7558c1f21b9694a3ca6b741fb","f2fb5bcaa75a02dc3870b0ac7d4313a49e763fad8c39aa954d54e5b7707d694a","bd2d7a49a2a7965aedbe37ed588548397675f4bb8c9a740cd5822893cb788d2e","61caf3fb7e4b317fff402b50b33506a8749d900df527faba52a992595c542d7f","6e28b3722fe6be104fbee44d7042fb1dad091847cb2764f628c2270adc0420c3","d346eea67b70d54176f75ba2df38f23d04496b3644cda81797a38e64a739689b","22a93badc7a599bcc801b868333b893763256917e5f95f3e9552fa6ed48fbee1","9170575f483bae67590bf0d9ccf1b5a0b49fd21238466a39a9161c35ad0ebdb3","cf08fd072349481c8a461bc8f3a3f8305de6ac2c0b0e0b3dac37e3c19047decc","a4e1dc13ee962d27055ca7afc45578e2315f968dfddd28597b5973365b455979","a94a689ec0a5c40866b1f4912510d9d469e8897cb50903da59bf3c546a7bbb9b","44f6a50d939038268311805b58c6bd215edca6e8f92c468af9ee6c647bddd151","df748ec825b934a7ed47a6cb6e8548350f041dcc48eb59dc489cd3f53d95e27c","d21f35eb0504b076f64425cb291e3b82f718c36fbcef5d067fcbb93e9febacbd","fe4239cf3e74b346add203a70fa594826d0f92d0c6e9b15ac2c9d719bca6d54f"],"paragraph_range_zero_based":[18960,18983],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p18960"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":18984},{"literal_text_all_w_t_and_m_t":"BWP-UplinkDedicated ::=             SEQUENCE {","paragraph_zero_based":18985},{"literal_text_all_w_t_and_m_t":"    pucch-Config                        SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":18986},{"literal_text_all_w_t_and_m_t":"    pusch-Config                        SetupRelease { PUSCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":18987},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfig               SetupRelease { ConfiguredGrantConfig }                                  OPTIONAL,   -- Need M","paragraph_zero_based":18988},{"literal_text_all_w_t_and_m_t":"    srs-Config                          SetupRelease { SRS-Config }                                             OPTIONAL,   -- Need M","paragraph_zero_based":18989},{"literal_text_all_w_t_and_m_t":"    beamFailureRecoveryConfig           SetupRelease { BeamFailureRecoveryConfig }                              OPTIONAL,   -- Cond SpCellOnly","paragraph_zero_based":18990},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":18991},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":18992},{"literal_text_all_w_t_and_m_t":"    sl-PUCCH-Config-r16                 SetupRelease { PUCCH-Config }                                           OPTIONAL,   -- Need M","paragraph_zero_based":18993},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC2-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":18994},{"literal_text_all_w_t_and_m_t":"    cp-ExtensionC3-r16                  INTEGER (1..28)                                                         OPTIONAL,   -- Need R","paragraph_zero_based":18995},{"literal_text_all_w_t_and_m_t":"    useInterlacePUCCH-PUSCH-r16         ENUMERATED {enabled}                                                    OPTIONAL,   -- Need R","paragraph_zero_based":18996},{"literal_text_all_w_t_and_m_t":"    pucch-ConfigurationList-r16         SetupRelease { PUCCH-ConfigurationList-r16 }                            OPTIONAL,   -- Need M","paragraph_zero_based":18997},{"literal_text_all_w_t_and_m_t":"    lbt-FailureRecoveryConfig-r16       SetupRelease { LBT-FailureRecoveryConfig-r16 }                          OPTIONAL,   -- Need M","paragraph_zero_based":18998},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToAddModList-r16                 ConfiguredGrantConfigToAddModList-r16                 OPTIONAL,   -- Need N","paragraph_zero_based":18999},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigToReleaseList-r16                ConfiguredGrantConfigToReleaseList-r16                OPTIONAL,   -- Need N","paragraph_zero_based":19000},{"literal_text_all_w_t_and_m_t":"    configuredGrantConfigType2DeactivationStateList-r16   ConfiguredGrantConfigType2DeactivationStateList-r16   OPTIONAL    -- Need R","paragraph_zero_based":19001},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":19002},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":19003},{"literal_text_all_w_t_and_m_t":"    ul-TCI-StateList-r17                CHOICE {","paragraph_zero_based":19004},{"literal_text_all_w_t_and_m_t":"        explicitlist                        SEQUENCE {","paragraph_zero_based":19005},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToAddModList-r17             SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-State-r17          OPTIONAL,   -- Need N","paragraph_zero_based":19006},{"literal_text_all_w_t_and_m_t":"            ul-TCI-ToReleaseList-r17            SEQUENCE (SIZE (1..maxUL-TCI-r17)) OF TCI-UL-StateId-r17        OPTIONAL    -- Need N","paragraph_zero_based":19007}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["40ca600dd3022799283fc2cd07ba5caa6ca2dc32d1f37350512c90d460546d3e","89e0af94db14fcbc4ea5d9ce49aa63442033d7597147dcee1e42b6e9b8bcfa6c","1249f2bbd9498972b94e7a35c20ecb4f7c16a57fbcb9317f4747e3ed962a4d7f","5a3b428ba8693c88f1ac98feee646675b71719e6386126ff3739cc9099412bb2","95cdbc53da06720dd8f79644ced0e35d6d77dc475d32721f5bf2daf07b147e71","649c3198e502f83cf431d32eb747ba2ba2d0f26105262494ac26e9285f43e310","2795aff786f6cbdd02112beba08c0dcc9f24e4e9577883c60cd78648c9763128","c65557900c06a6d329c3a82ad86588f9d84fcb31eeb131afd97949f4df2a0289","c038f2fe7b1603e68be9e613edf4238418bc915856aa5defb97884abd9dd2223","9d4a4621a5339d68349519f4acf1a79bb48c22f769ddc47f4e6483eed3128d76","ff1d289922bb32c44ec306374706deea04684b372c25986cd289ba0e809b966e","241eb1b48803516c1539d7a4721d4709524b8f52a4c95c2c5aa11380d010dc8e","86c38841fe8d98f28ab3350edf6d1603c7e9cb81dbaa17842d380cb768aa53ee","34f9a4039e611b33a23c28322e78ade9cd4f6784dce64d0a889395c8ab242d88","4376f8047125332f29d2a2547eda4def0efa2580ce1fa1963c206b00f64d69c0","224b7dec12b9b161c4f4c013461b7340e26992375af7abe45a02197dd343791a","db681e9178b5abe86e33b9fa685ab1f32fc649e0c77dcba9886423fd1ee9792b","398438dc46c5d718edea61bf54f8960ae54a87dc80e8b9a02bc113d718245a90","4253f296d14d4cd214d34ff53a4e507b3eb417dc2822a539b39a44c72faf3672","6c2684ff823db1b3b9d66b185d77f7f8c20b44b851955027774e3a84f33a887b","aa782d9772d4b5ddaabdaa789996c3d8efcebedba89925be04aca28c3d0ae4ce","af97a470a0d88a609d09dc4cbf5fa524cd0c3b7d3da4d3a0f3db9046d13a2cd2","6000c7e0c125aacc480f141ed53fd2c1b3246ed2696adca9e997cfce16ba172d","9df69eeea3ea6c9eebd3c51c767af28ebe9b6b7a02e6342873387d2314