{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26016},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26017},{"literal_text_all_w_t_and_m_t":"NCR-SemiPersistentFwdResourceId-r18 ::= INTEGER (0..maxNrofSemiPersistentFwdResource-1-r18)","paragraph_zero_based":26018},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26019},{"literal_text_all_w_t_and_m_t":"-- TAG-NCR-SEMIPERSISTENTFWDRESOURCESET-STOP","paragraph_zero_based":26020},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26021},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26022},{"literal_text_all_w_t_and_m_t":"NCR-SemiPersistentFwdResourceSet field descriptions","paragraph_zero_based":26023},{"literal_text_all_w_t_and_m_t":"beamIndex","paragraph_zero_based":26024},{"literal_text_all_w_t_and_m_t":"Indicates logical beam index for NCR-Fwd access link. NCR-Fwd is assumed to be ON over the indicated time domain resource if there is beam indication.","paragraph_zero_based":26025},{"literal_text_all_w_t_and_m_t":"durationInSymbols","paragraph_zero_based":26026},{"literal_text_all_w_t_and_m_t":"Indicates the time duration in number of symbols.","paragraph_zero_based":26027},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":26028},{"literal_text_all_w_t_and_m_t":"Indicates the periodicity and slot offset for the semi-persistent forwarding resource. All the semi-persistent forwarding resources configured within the same resource set should have the same periodicity. If the periodicity is expressed in [ms], the value range of slot offset is from 0 to Periodicity[ms] * referenceSCS[kHz]/15 -1.","paragraph_zero_based":26029},{"literal_text_all_w_t_and_m_t":"priorityFlag","paragraph_zero_based":26030},{"literal_text_all_w_t_and_m_t":"Indicates the priority for the list of semi-persistent forwarding resources, as specified in TS 38.213 [13], clause 20.","paragraph_zero_based":26031},{"literal_text_all_w_t_and_m_t":"referenceSCS","paragraph_zero_based":26032},{"literal_text_all_w_t_and_m_t":"Indicates the reference subcarrier spacing for all the time resources in the list. Only values kHz15, kHz30, kHz60, kHz120 and kHz240 are applicable.","paragraph_zero_based":26033},{"literal_text_all_w_t_and_m_t":"semiPersistentFwdRsrcToAddModList","paragraph_zero_based":26034},{"literal_text_all_w_t_and_m_t":"List of semi-persistent forwarding resources to be added or modified.","paragraph_zero_based":26035},{"literal_text_all_w_t_and_m_t":"semiPersistentFwdRsrcToReleaseList","paragraph_zero_based":26036},{"literal_text_all_w_t_and_m_t":"List of semi-persistent forwarding resources to be released.","paragraph_zero_based":26037},{"literal_text_all_w_t_and_m_t":"symbolOffset","paragraph_zero_based":26038},{"literal_text_all_w_t_and_m_t":"Indicates the symbol offset in one slot.","paragraph_zero_based":26039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["e13d0f1ea33997f26c66dfd5cdb509308fad8239dfe5c00d573e901d541dfb26","3053edb72372013134395e6ec5555dd4801259cf0d9d6f2918b137c82cee6aab","cb286dbaa5f1fa349518f0d1a484818931a3943ca015588ccfc38d30e5533af1","65cc5d7f486edd1c867b3e2c36b375f2182a4b536b3816f9bf5b365206218f55","ea27b80ac9ab50cf9e61a51db2c55e7c97f6b628ea1259c746d4719cf111261e","72b121ae59f2c779b320ec80acd8e308d5adb508a26b9acec0e11cce7fc70dba","3e1b024d08f37fcbbd73cae874f7879040ea0fb7949ef8641eef0fdaa46f59b4","05a9017487dd015cea0582659f57922f008b7495e80432a2acc4b44758ffb6d2","84c731767d228c935f5e9230b9b6ceb5b419d4d76bf01280c8983d3e1db90837","8695847d5fd9ee01