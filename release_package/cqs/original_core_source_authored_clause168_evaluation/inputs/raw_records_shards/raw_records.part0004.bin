f the actual carrier or the carrier bandwidth. It is defined specifically for a numerology (subcarrier spacing (SCS)) and in relation (frequency offset) to Point A.","paragraph_zero_based":32396},{"literal_text_all_w_t_and_m_t":"SCS-SpecificCarrier information element","paragraph_zero_based":32397},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32398},{"literal_text_all_w_t_and_m_t":"-- TAG-SCS-SPECIFICCARRIER-START","paragraph_zero_based":32399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["2b7617e276ada1761771f012f4421b54956c33d70f6cf4612898847be8ee4aca","66b09692c3fe1f72d7d4aa6695852eb0a2caad4d8ae94bca8cdf77f87861c1aa","097f06acfa82a9adc8d3b3933effb225aaf7174f347067a01370f267c2182955","1c61de2dfebb7894d5fc20c012d7969487e1e6fcd62456e547ffae20198eef7f","f2e2d45f5ddc0254c9b601a1adee646e649e55ae85bd9d55e1718914b7d27370","b06ed3620f0164c7673116c7be4126da66b9d805c3de8e419f866d6cb097ed9f","f157366f918ddd93925ba0d94043de76c003d000c98e735d83045639d8e84fab","aa2f4efb8d5702172f2adc9905251e7dc51012dc2ce4522437137e187161dd1d","c6338233213b52ba214b8c136319105fba8e1b50d2cf1d747c6e3a9716e2c85e","841b976cc61919782170804dded4a48f4da8729e342434b72242b156f2f3950c","dc3498a87ccd8b84434a9e0b8d69224470b858ba61c9d70d3e6f7336f71143ab","4cb11318d9bd5f79c0cdc05f873c2fe09dd680b992acc9aac2c1b40176319517","e178c41dca28d38e768ca9ebe319d74e9061e56f934ebeae0b9ea0bdc8ce05c6","2e3e416250f5b36a3f02657aa66e8e429e106702512358635f3dd898dd2fb9f0","a6c7d05f12ee39dd26a4134c35904664914cf1438c02ebed78cea2e18151be0c","b75f728369b60edc0fd0aa3c4eac8e776ad1ff8df4b2bc65b206c925d72601bd","3544c51aae1030e1db169cf55e940ad5df906ab95597cba740acab098e340528","5b31012d57b63e6d21d31cab92910dc68