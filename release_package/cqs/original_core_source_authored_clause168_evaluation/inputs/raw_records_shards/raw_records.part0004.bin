{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource information element","paragraph_zero_based":21288},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21289},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-START","paragraph_zero_based":21290},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21291},{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource ::=                 SEQUENCE {","paragraph_zero_based":21292},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceId                   CSI-IM-ResourceId,","paragraph_zero_based":21293},{"literal_text_all_w_t_and_m_t":"    csi-IM-ResourceElementPattern           CHOICE {","paragraph_zero_based":21294},{"literal_text_all_w_t_and_m_t":"        pattern0                                SEQUENCE {","paragraph_zero_based":21295},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p0                   ENUMERATED { s0, s2, s4, s6, s8, s10 },","paragraph_zero_based":21296},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p0                       INTEGER (0..12)","paragraph_zero_based":21297},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":21298},{"literal_text_all_w_t_and_m_t":"        pattern1                                SEQUENCE {","paragraph_zero_based":21299},{"literal_text_all_w_t_and_m_t":"            subcarrierLocation-p1                   ENUMERATED { s0, s4, s8 },","paragraph_zero_based":21300},{"literal_text_all_w_t_and_m_t":"            symbolLocation-p1                       INTEGER (0..13)","paragraph_zero_based":21301},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":21302},{"literal_text_all_w_t_and_m_t":"    }                                                                                   OPTIONAL,   -- Need M","paragraph_zero_based":21303},{"literal_text_all_w_t_and_m_t":"    freqBand                            CSI-FrequencyOccupation                         OPTIONAL,   -- Need M","paragraph_zero_based":21304},{"literal_text_all_w_t_and_m_t":"    periodicityAndOffset                CSI-ResourcePeriodicityAndOffset                OPTIONAL,   -- Cond PeriodicOrSemiPersistent","paragraph_zero_based":21305},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":21306},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21308},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-IM-RESOURCE-STOP","paragraph_zero_based":21309},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21310},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["589e28de6a7e01e914aa2e6ecb56c1035801c8e20cf0b7125890d33be1ad7d88","0667a4d04b219940b20a47dc02f85be097062d2a65f1000fd657d40edec39b33","09ddc998856ce988023ee98fb05de8165f616386ff6e4395c8d6f495c4aee495","c0771cb5597a4e754c0cc95eff21c01c8ca57b1a5c7f1f0423fc854106e96c4c","49b82bd88e9dd5a6b5d2cdf21aa46a6cf08aa761a0d3bf08ec46dc8520a7705f","c20148cf734460b0679371ebc0d4570dff18067a7ba8ca2c5c55c3fe871d2b6f","1ad23922f75e4e7b0ac36e88a70a17b20dafc101128d03edf8f223ccae8c25f1","2d561745eb43ce932d4b4c766e3314c8f7edcea7e8a12370c184c85bd80f4755","c05d06d4876d27249e5ca5366106f1b93daa6bc60bb1ed85961ad76e36ed53d8","0deafc866678f7aba0b59123d5adfa9bf32315cca8ba0ecb9b13833b9b9b30bc","13e7117ff4f5888c00fb203879f1a9cf3e9f1dbc1ea75826e5ff00cc02173468","6e91c3f4202209244add2e9334113c6cbdfdd04519744138d27b66cfac8fcd57","24ede6bf13292f7b8cfb1e189a7e963c76247868db8207c6cd69db12f0a45466","5aba6084033b9a0a510778c00e9bd52226ecf0b5013f77a9a53da3b434d76dc1","44a2c23cf5eb374625d21b615b68158370576fab5a361def319cc9cee7d4b194","4ac4f52a118396fe9ca55db21d3113f4a1217276575a750dd8e0772d3847e14a","1e9a2f7b23b00e653d644bb2149ee63e82f0ec139c5b95dbb62ce4cc776d353a","f517b525afe8f895a42242e850c75f1c3f9e90d37a76a9396d80633cf8a16fbe","7d6f2c72d143c7d4c60c2b8b52ab37e9dbb612a3004adb9c851d186d574ba846","ed45df54bafbdc9722e22539216799574547b9982b82243b9b1022c3026b05ff","37227068f4297ba593c999479eebbd50c6c372b5779f5204e71e0031bcb9923f","001b9b6328945f18f83fde58667bde1692e74ea3ade18d09e5543db35e91fc31","d997452feacd5187303980800402273fc60f3392ad98d907b00e5534bca41127","2a20ba25522d3a923b462665d1631f6045bacbb7cce7fe24c93e187f7b132b32"],"paragraph_range_zero_based":[21288,21311],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21288"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"CSI-IM-Resource field descriptions","paragraph_zero_based":21312},{"literal_text_all_w_t_and_m_t":"csi-IM-ResourceElementPattern","paragraph_zero_based":21313},{"literal_text_all_w_t_and_m_t":"The resource element pattern (Pattern0 (2,2) or Pattern1 (4,1)) with corresponding parameters (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21314},{"literal_text_all_w_t_and_m_t":"freqBand","paragraph_zero_based":21315},{"literal_text_all_w_t_and_m_t":"Frequency-occupancy of CSI-IM (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21316},{"literal_text_all_w_t_and_m_t":"periodicityAndOffset","paragraph_zero_based":21317},{"literal_text_all_w_t_and_m_t":"Periodicity and slot offset for periodic/semi-persistent CSI-IM. Network always configures the UE with a value for this field for periodic and semi-persistent CSI-IM-Resources (as indicated in CSI-ResourceConfig). A change of configuration between periodic or semi-persistent and aperiodic for a CSI-IM-Resource is not supported without a release and add.","paragraph_zero_based":21318},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p0","paragraph_zero_based":21319},{"literal_text_all_w_t_and_m_t":"OFDM subcarrier occupancy of the CSI-IM resource for Pattern0 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21320},{"literal_text_all_w_t_and_m_t":"subcarrierLocation-p1","paragraph_zero_based":21321},{"literal_text_all_w_t_and_m_t":"OFDM subcarrier occupancy of the CSI-IM resource for Pattern1 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21322},{"literal_text_all_w_t_and_m_t":"symbolLocation-p0","paragraph_zero_based":21323},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CSI-IM resource for Pattern0 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21324},{"literal_text_all_w_t_and_m_t":"symbolLocation-p1","paragraph_zero_based":21325},{"literal_text_all_w_t_and_m_t":"OFDM symbol location of the CSI-IM resource for Pattern1 (see TS 38.214 [19], clause 5.2.2.4)","paragraph_zero_based":21326},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21327},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21328},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21329},{"literal_text_all_w_t_and_m_t":"PeriodicOrSemiPersistent","paragraph_zero_based":21330},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need M, for periodic and semi-persistent CSI-IM-Resources (as indicated in CSI-ResourceConfig). The field is absent otherwise.","paragraph_zero_based":21331},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21332},{"literal_text_all_w_t_and_m_t":"–CSI-IM-ResourceId","paragraph_zero_based":21333},{"literal_text_all_w_t_and_m_t":"The IE CSI-IM-ResourceId is used to identify one CSI-IM-Resource.","paragraph_zero_based":21334},{"literal_text_all_w_t_and_m_t":"CSI-IM-ResourceId information element","paragraph_zero_based":21335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["8a6494566c0d622187e7a71225261e89e5f298f9f3e6f2a318d736b87aa6e0f2","927948813217aa0a3800cbd7d19946898845ebbe648c50e8dd2d59717cdd3515","3a299716807ce3ae24e99649cf1ae5309b4dd6bbde98c41bc8ec815e3aeffd1c","10fcfdc731e1ee5ff5eb16bae9cccaf311e29c26e64e3a1bab486448ce3a84bd","e7ecc23e2f04908558a47c9108d4977ff396b3849035a712aabc824d51cd5368","b00fc867f887777fbbd66a52893a775dab1c1947d5719475f927e34759169a48","bba04b3bb635c0d83c4a05859a36d9a02e826465a4d01493eb2724e8f84d3c83","efb9b708