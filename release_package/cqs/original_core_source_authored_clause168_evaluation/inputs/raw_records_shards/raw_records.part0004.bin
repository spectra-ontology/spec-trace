{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29688},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29689},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList-r16 ::=  SEQUENCE (SIZE(1..maxNrofUL-Allocations-r16)) OF PUSCH-TimeDomainResourceAllocation-r16","paragraph_zero_based":29690},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29691},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocation-r16 ::=  SEQUENCE {","paragraph_zero_based":29692},{"literal_text_all_w_t_and_m_t":"    k2-r16                                     INTEGER(0..32)          OPTIONAL,   -- Need S","paragraph_zero_based":29693},{"literal_text_all_w_t_and_m_t":"    puschAllocationList-r16                    SEQUENCE (SIZE(1..maxNrofMultiplePUSCHs-r16)) OF PUSCH-Allocation-r16,","paragraph_zero_based":29694},{"literal_text_all_w_t_and_m_t":"...","paragraph_zero_based":29695},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29696},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29697},{"literal_text_all_w_t_and_m_t":"PUSCH-Allocation-r16 ::=  SEQUENCE {","paragraph_zero_based":29698},{"literal_text_all_w_t_and_m_t":"    mappingType-r16                           ENUMERATED {typeA, typeB}                     OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":29699},{"literal_text_all_w_t_and_m_t":"    startSymbolAndLength-r16                  INTEGER (0..127)                              OPTIONAL,   -- Cond NotFormat01-02-Or-TypeA","paragraph_zero_based":29700},{"literal_text_all_w_t_and_m_t":"    startSymbol-r16                           INTEGER (0..13)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":29701},{"literal_text_all_w_t_and_m_t":"    length-r16                                INTEGER (1..14)                               OPTIONAL,   -- Cond RepTypeB","paragraph_zero_based":29702},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitions-r16                   ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16} OPTIONAL,   -- Cond Format01-02","paragraph_zero_based":29703},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29704},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29705},{"literal_text_all_w_t_and_m_t":"    numberOfRepetitionsExt-r17                ENUMERATED {n1, n2, n3, n4, n7, n8, n12, n16, n20, n24, n28, n32, spare4, spare3, spare2,","paragraph_zero_based":29706},{"literal_text_all_w_t_and_m_t":"                                                          spare1}                           OPTIONAL,   -- Cond Format01-02-For-TypeA","paragraph_zero_based":29707},{"literal_text_all_w_t_and_m_t":"    numberOfSlotsTBoMS-r17                   ENUMERATED {n1, n2, n4, n8, spare4, spare3, spare2, spare1}   OPTIONAL,   -- Need R","paragraph_zero_based":29708},{"literal_text_all_w_t_and_m_t":"    extendedK2-r17                            INTEGER (0..128)                              OPTIONAL    -- Cond MultiPUSCH","paragraph_zero_based":29709},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29710},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29711}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["94639ac46552851aa87d6ab9419a06ecaeaff0e6e194444acfd05cfdf22f5ff1","7011fc19ba2dca040cb7161425447cc738a4bd4b65fda4ed4873da44b7c4df62","b896845852d8da2f1e6525b6ba90019c943cdb622b878f842c0f9b0d3ae930f5","9ef81942dac1933994d01e413cae8deba3c8b6b19f3367876935f652b27d4c47","87ceecbc2dafa03b0456958482dab59cb8f45b6120a7814d6d7b3a47f441ab06","d7c89df999a9a62d5efd84bf7848af08954ce5b245c04614cff9bea3caeaf1f3","36f3f9c806f0cf564e1501ed27c2184d0df5c7faa28558d321344b066534c14e","6070b853d41a35933d04f29f7a11a63214e378c4af94a51d7952695544b2e9b4","9585efbd5cecd3841edb1c1142a04de6c42821b290655ffcb139643b53318347","5de063fa574510617912129850a90bda0699bd07ddb8b18b2a381d576f4768b4","f152fd091b3841d65deb5ec647a58764c9ad491d793ac3d53b6c17fcaf1284bf","bb3c72ad3bd24f5bf1b2c682ff2b78d18b0d7e8a2b0cfe75f1dc9a360399be13","6bdcb58b47fa5f49111c1f6acf9e6d5e87473a545025de3f587f53a7bed4b2b8","46257158091c80991dddc095097985faf274a524f2e89c052e073edf994dc38c","a6fcd5b0dfb6eeb713ce347bbde50bee81ab64648f6d737b15ab9feebce59c2d","2d3f0f1b4a96dd24df39d1f0808b2aacbce7e50b698ef28537b8a3ca54293da6","8272dcb91638e3f9d7c8532b19511cc8ea7ed2a8890b281bca57e044e5b6770a","fe2bd9a896c72a6cc06a68800be6a69410dd8d918d9298c237c9aec4c02dad03","5d8c7a98a87ee863f4caa6affe5db1699d872228def0fa2019bf79dc925436aa","b2d1acb709e139b72aa46e4573aa68a20eee6ad684b8693102d76ecdb67ae806","54bda06e28927a3fcdf71e1c032dae1f6bb73a28722c52980847055c715fda71","94fd7cc0f9a690d17f2dd2bb0d1c42b2f344e093b8182d82d5bf67b2ffc647db","0603e1a38f1d9b3d2cb84bc71017137ccbead94879c41c6e1d0b77f4deb4c18d","75cb7f41b1e5f693d1b039abb95244ac996c17480e2115a02b17e8ce3834a340"],"paragraph_range_zero_based":[29688,29711],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29688"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29712},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TIMEDOMAINRESOURCEALLOCATIONLIST-STOP","paragraph_zero_based":29713},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29714},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29715},{"literal_text_all_w_t_and_m_t":"PUSCH-TimeDomainResourceAllocationList field descriptions","paragraph_zero_based":29716},{"literal_text_all_w_t_and_m_t":"extendedK2","paragraph_zero_based":29717},{"literal_text_all_w_t_and_m_t":"Corresponds to L1 parameter 'K2' (see TS 38.214 [19], clause 6.1.2.1) configurable per PUSCH allocation. Only values {0..32} are applicable for PUSCH SCS of 120 kHz.","paragraph_zero_based":29718},{"literal_text_all_w_t_and_m_t":"When the field is absent for the first PUSCH if multiple PUSCH are configured per PDCCH and k2-r16 is absent, or when the field is absent and only one PUSCH is configured per PDCCH and k2-r16 is absent, the UE applies the value 1 when PUSCH SCS is 15/30 kHz; the value 2 when PUSCH SCS is 60 kHz, the value 3 when PUSCH SCS is 120 kHz, the value 11 when PUSCH SCS is 480 kHz, and the value 21 when PUSCH SCS is 960 kHz. If multiple contiguous PUSCHs are configured per PDCCH, when the field extendedK2(n) corresponding to k2 of the PUSCH(s) in the n-th slot (n>1), or of the PUSCH(s) except the first PUSCH in the first slot (n=1), is absent, the UE applies k2 of the first PUSCH plus n-1.","paragraph_zero_based":29719},{"literal_text_all_w_t_and_m_t":"k2","paragraph_zero_based":29720},{"literal_text_all_w_t_and_m_t":"Corresponds to L1 parameter 'K2' (see TS 38.214 [19], clause 6.1.2.1). When the field is absent the UE applies the value 1 when PUSCH SCS is 15/30 kHz; the value 2 when PUSCH SCS is 60 kHz, and the value 3 when PUSCH SCS is 120 kHz. k2 is absent/ignored if extendedK2 is present.","paragraph_zero_based":29721},{"literal_text_all_w_t_and_m_t":"length","paragraph_zero_based":29722},{"literal_text_all_w_t_and_m_t":"Indicates the length allocated for PUSCH for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29723},{"literal_text_all_w_t_and_m_t":"mappingType","paragraph_zero_based":29724},{"literal_text_all_w_t_and_m_t":"Mapping type (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29725},{"literal_text_all_w_t_and_m_t":"numberOfRepetitions","paragraph_zero_based":29726},{"literal_text_all_w_t_and_m_t":"Number of repetitions for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1). When numberOfSlotsTBoMS-r17 is set to 2, 4 or 8 (i.e. TB processing over multi-slot (TBoMS) PUSCH is enabled), it indicates the number of repetitions of a single TBoMS.","paragraph_zero_based":29727},{"literal_text_all_w_t_and_m_t":"numberOfRepetitionsExt","paragraph_zero_based":29728},{"literal_text_all_w_t_and_m_t":"Number of repetitions for DCI format 0_1/0_2 if pusch-RepTypeIndicatorDCI-0-1/pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB (see TS 38.214 [19], clause 6.1.2.1). If this field is present, the field numberOfRepeitions-r16 is ignored for PUSCH repetition Type A.","paragraph_zero_based":29729},{"literal_text_all_w_t_and_m_t":"numberOfSlotsTBoMS","paragraph_zero_based":29730},{"literal_text_all_w_t_and_m_t":"Number of slots allocated for TB processing over multi-slot PUSCH for DCI format 0_1/0_2. If a number of repetitions K is configured by numberOfRepetitions or numberOfRepetitionsExt, the network configures numberOfSlotsTBoMS (N) and K such that N*K ≤ 32 (see TS 38.214 [19], clause 6.1.2.1). The network does not configure the numberOfSlotsTBoMS-r17 simultaneously with the pusch-TimeDomainAllocationListForMultiPUSCH-r16.","paragraph_zero_based":29731},{"literal_text_all_w_t_and_m_t":"puschAllocationList","paragraph_zero_based":29732},{"literal_text_all_w_t_and_m_t":"The field puschAllocationList-r16 indicates one or multiple PUSCH continuous in time domain which share a common k2 (see TS 38.214 [19], clause 6.1.2.1). In this release, this field configures one or multiple PUSCH that may be in consecutive or non-consecutive slots (see TS 38.214 [19], clause 6.1.2.1). The puschAllocationList-r16 only has one element in pusch-TimeDomainAllocationListDCI-0-1-r16 and in pusch-TimeDomainAllocationListDCI-0-2-r16.","paragraph_zero_based":29733},{"literal_text_all_w_t_and_m_t":"startSymbol","paragraph_zero_based":29734},{"literal_text_all_w_t_and_m_t":"Indicates the index of start symbol for PUSCH for DCI format 0_1/0_2 (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29735}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["fa58677d8a613eb0138eef375b8fc05575f53c0e8d5690e88a06944ec3869b1d","cb0fb3ba026a21df92933ca3dd8a7597f38fe30fa5b4ade6bb6f05a407f0d865","8de1f35304b2659618628697f3c4f112cb7f34b97a9a00c789902bdf8b34516b","d70796154eae5987f1d945e381342629371a334e3fe39c589b7b7a9f1f981f17","5d36558dc4b780b1213f4ad7bd9436558d2c5250c3419386f956d759823dd76a","1f6ea9e7efee4ce26fb4def93b538c3b9189933db80525a877ee011a633f9809","f7a0e9a03d5d7d4beca448984413b4ba07ca678888d2ffc61c1f96942b1ffc5c","6812546dbf08294b279a2c598fd43d64f2686c15a8b1b8b91975d0a7b701be58","dbbecbe1590bc81d1efa778d9927c97a06bd53674cfb1e821bb247efe15a5d44","40355a11519c7270a58109be7185f7a0d037385e8ce81aa05d2da80d52bd9c21","7cf461e71bf5ea9c5633349fe1521e931305e15ec129df83ba4d1849981c54c8","cdbdddd6b807cfd299f05d8e2e1c4fdccace17c66a97df6105d33c9b0dab3c12","2b8ad0f9a52bdeb8fcbdb666b6ba2a45e3ecc69f97113dc7f1e97236c83593b3","348a8b220023d217eb1cd6947400966fc23858e8f0f5881955ff2fc58bb08d76","abdfc3142134dcf38709e5a2981c402af9cda939bdcb00eb22e168931bba0bcb","941325c81e5805f636e02244c9f4c98db523be9b9e391e2aae9315b021d4171e","39976ebc2678579fca3f492891be064a74b4e1686d27c39f24d74e5c25bca3bd","315576c92d7fb1d819e64bed56f7ce5204d3a4b5711d11a2cb6027e61a22850e","ca9e63e72a41b6cbad2cbf4429637e558ef3bdc45ee98922a14c2680a98b8b40","c2c43be7e778cc9a61ac3e0bfa5b44b677ac9bd27c955636115efaf45bde5586","625df059e9dd295b1765995e8e614a0eff2f4a67e393b8aa5676fcc3ad4afaa9","27e2400b41f2f24d6df65ec1056e9b78ba5eb55e20c8f03c0a6c6127335da054","a6ef660a4ee34b186a099ff71cdb37e08022a609f05a5f2e7d63c12604764128","daca9a206e56d8a63f46ae38335984fbf221639bb1be2280fc9bd57927e8f5a7"],"paragraph_range_zero_based":[29712,29735],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29712"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"startSymbolAndLength","paragraph_zero_based":29736},{"literal_text_all_w_t_and_m_t":"An index giving valid combinations of start symbol and length (jointly encoded) as start and length indicator (SLIV). The network configures the field so that the allocation does not cross the slot boundary. (see TS 38.214 [19], clause 6.1.2.1).","paragraph_zero_based":29737},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29738},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29739},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29740},{"literal_text_all_w_t_and_m_t":"Format01-02","paragraph_zero_based":29741},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":29742},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1 and in pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present.","paragraph_zero_based":29743},{"literal_text_all_w_t_and_m_t":"Format01-02-For-TypeA","paragraph_zero_based":29744},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":29745},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is optionally present if pusch-RepTypeIndicatorDCI-0-1 is not set to pusch-RepTypeB, Need R. It is absent otherwise, Need R.","paragraph_zero_based":29746},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is optionally present if pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB, Need R. It is absent otherwise, Need R.","paragraph_zero_based":29747},{"literal_text_all_w_t_and_m_t":"NotFormat01-02-Or-TypeA","paragraph_zero_based":29748},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is mandatory present.","paragraph_zero_based":29749},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-1 is not set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":29750},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-2 is not set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":29751},{"literal_text_all_w_t_and_m_t":"RepTypeB","paragraph_zero_based":29752},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListForMultiPUSCH-r16, the field is absent.","paragraph_zero_based":29753},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-1, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-1 is set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":29754},{"literal_text_all_w_t_and_m_t":"In pusch-TimeDomainAllocationListDCI-0-2, the field is mandatory present if pusch-RepTypeIndicatorDCI-0-2 is set to pusch-RepTypeB. It is absent otherwise, Need R.","paragraph_zero_based":29755},{"literal_text_all_w_t_and_m_t":"MultiPUSCH","paragraph_zero_based":29756},{"literal_text_all_w_t_and_m_t":"In case size of puschAllocationList is higher than 1, the field extendedK2(n) corresponding to k2 of the n-th PUSCH, n>1, is mandatory present for all n, if any two consecutive PUSCHs are non-contiguous. Otherwise, it is optionally present, Need S.","paragraph_zero_based":29757},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29758},{"literal_text_all_w_t_and_m_t":"–PUSCH-TPC-CommandConfig","paragraph_zero_based":29759}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["53947ffd060398aa8b127f78e4fd71c39a94903ffb5e4c942fb06448b7c5f187","cec86d721e62b741a0aa959512f69c463200653fafe372616d6fea042dc4699c","5b2232ef551b1012947dc0afb9fb3878881eecca61061359da86a191a4a1465a","11d3c7cc5f9e7e9df9d0b62e64ac1a32b6708bd96c64558b2d7fbba79972120a","69d77bf2288b102e44c5945935977d89fd0db6ea0673de9796215bee437af520","fa2b196cfe615cd81e2343d141cc8997c82d8f18b5c808d30b9d12d2a207dabf","3cf24e00cd077fd7d488010ab22fb54d48d07fe20affae4def68b759e3ae1726","8468fa21d945604411f117a0e11e1c3cf8c542e0d355b95876d0927b9e94d480","399d6ac668e1ec7567fbdc6b0e143ac453508fa2b9647fa33a1f00337ca4bbee","fee8397c5a31e143d4c0c23b602e1c8620b174df35a67de8a84b6bbe5d6d576a","61bcec15137d76eddd43c752a7613a60ebdd54ce62964ba12df804aa94939ac6","d70c5d6e78c504c07fa0c045c15e2bd0f64520603a4ac0e69fb58cd763800bce","f106cc585a598005d9eae465aa99fde2bcb9ded0c90c3440c093262abb994578","1e98e3d9d6b6d4c0b7a37afda368a5b3fc2284e11ef378c9bba16ab6dc212b39","f28bef91b4031096dc4123bd5a33e4c1afa90d3f6d08a132c6b7144f72a91299","f2ff6869c1ae925a766145cac3c9400a902b90439820abf4957335723e88631f","eb0a512c7146e22e35647cfcaa1e1dbec740381ad70338ee6c96b529978e4c8c","4190aa316efa9881ee47438a4d0318d404c81db231e0111b1f773c9abdedb87e","aeeb02bfe2f2b622d24d477a98555c518ee0c921d12ecdcdb5f96269c227dec9","06c251a9fab5cad617c6ad9759280e46cd9a333a9d6b4cc034122a64bec0631d","73ae262064a5c5ebd076b5a4db51d0aac5033ff106966709c364a49396e324c4","896058adc09c63f350f562554a272757eff25c6cbd92cabc9fb6fd6e2b86bca5","312e64425b5122f3f200014a7d8af058890d60f1f6121005068a649383daf578","fcb5ccce1d5f379c10fc121691bbbbb44923a52ae81e6fcb77db35ff7aef9523"],"paragraph_range_zero_based":[29736,29759],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29736"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE PUSCH-TPC-CommandConfig is used to configure the UE for extracting TPC commands for PUSCH from a group-TPC messages on DCI.","paragraph_zero_based":29760},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig information element","paragraph_zero_based":29761},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":29762},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TPC-COMMANDCONFIG-START","paragraph_zero_based":29763},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29764},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig ::=         SEQUENCE {","paragraph_zero_based":29765},{"literal_text_all_w_t_and_m_t":"    tpc-Index                           INTEGER (1..15)                                                 OPTIONAL,   -- Cond SUL","paragraph_zero_based":29766},{"literal_text_all_w_t_and_m_t":"    tpc-IndexSUL                        INTEGER (1..15)                                                 OPTIONAL,   -- Cond SUL-Only","paragraph_zero_based":29767},{"literal_text_all_w_t_and_m_t":"    targetCell                          ServCellIndex                                                   OPTIONAL,   -- Need S","paragraph_zero_based":29768},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":29769},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29770},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29771},{"literal_text_all_w_t_and_m_t":"-- TAG-PUSCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":29772},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29773},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29774},{"literal_text_all_w_t_and_m_t":"PUSCH-TPC-CommandConfig field descriptions","paragraph_zero_based":29775},{"literal_text_all_w_t_and_m_t":"targetCell","paragraph_zero_based":29776},{"literal_text_all_w_t_and_m_t":"The serving cell to which the acquired power control commands are applicable. If the value is absent, the UE applies the TPC commands to the serving cell on which the command has been received.","paragraph_zero_based":29777},{"literal_text_all_w_t_and_m_t":"tpc-Index","paragraph_zero_based":29778},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":29779},{"literal_text_all_w_t_and_m_t":"tpc-IndexSUL","paragraph_zero_based":29780},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command inside the DCI format 2-2 payload.","paragraph_zero_based":29781},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29782},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29783}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["850c63a3bb7f4e4d5310c01296dfa371795c6b09ffb8f8469da13165017c8a29","6a0cbcdcc7cf9ff4c2f755be86c8ec6f879b92f711c06409d5b0e23b09edcd35","91c88ecd965319429c96f36935e819ee27cdf584a2edcf3fb08a8e3446a80ddb","fe4992dc12e50fa93586ae9334f32beec59b3f1c0a0048623a4b29c03447a00e","e61e461359caf828178df2b3e74f57d1306506e4d37723aae5bc3c6ffa090c34","7d2e1ff6e1a7d8e35dce2a1407556f91f1cf61dc3ea59dd1602c3fa1ae85b194","d6bd85aa9974d025acb0a158534e73ec3f7a244a6d82eb1583a8e8b3b72f972f","38b618dfeac970a37c3edff312cb1ad5b81a622210bc409829710849328ab18f","affa108d2822a84f7235648ba25020e39ea8d88a1ff6245889026ee7388c9f80","bc1904f51f1e2272447370c4f039b3d87fd451920897c4cec061dbf858c57676","d271debeb9605a1b7f736617d4b72032a8ce219f840f00e7f8dc605e259f4f61","da87942