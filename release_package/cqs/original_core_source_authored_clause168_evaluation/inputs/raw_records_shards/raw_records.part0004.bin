{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>store or replace the measReselectionValidityDuration of measIdleConfigSIB of SIB11 within VarMeasReselectionConfig;","paragraph_zero_based":8160},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8161},{"literal_text_all_w_t_and_m_t":"4>remove the measurementValidityDuration in VarMeasReselectionConfig, if stored;","paragraph_zero_based":8162},{"literal_text_all_w_t_and_m_t":"3>if SIB11 includes the measIdleConfigSIB and contains measIdleValidityDuration:","paragraph_zero_based":8163},{"literal_text_all_w_t_and_m_t":"4>store or replace the measIdleValidityDuration of measIdleConfigSIB of SIB11 within VarEnhMeasIdleConfig;","paragraph_zero_based":8164},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8165},{"literal_text_all_w_t_and_m_t":"4>remove the measIdleValidityDuration in VarEnhMeasIdleConfig, if stored;","paragraph_zero_based":8166},{"literal_text_all_w_t_and_m_t":"1>for each entry in the measIdleCarrierListNR within VarMeasIdleConfig that does not contain an ssb-MeasConfig received from the RRCRelease message:","paragraph_zero_based":8167},{"literal_text_all_w_t_and_m_t":"2>if there is an entry in measIdleCarrierListNR in measIdleConfigSIB of SIB11 that has the same carrier frequency and subcarrier spacing as the entry in the measIdleCarrierListNR within VarMeasIdleConfig and that contains ssb-MeasConfig:","paragraph_zero_based":8168},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":8169},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB11 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":8170},{"literal_text_all_w_t_and_m_t":"2>else if there is an entry in interFreqCarrierFreqList of SIB4 with the same carrier frequency and subcarrier spacing as the entry in measIdleCarrierListNR within VarMeasIdleConfig:","paragraph_zero_based":8171},{"literal_text_all_w_t_and_m_t":"3>delete the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":8172},{"literal_text_all_w_t_and_m_t":"3>store the SSB measurement configuration from SIB4 into nrofSS-BlocksToAverage, absThreshSS-BlocksConsolidation, smtc, ssb-ToMeasure, deriveSSB-IndexFromCell, and ss-RSSI-Measurement within ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig;","paragraph_zero_based":8173},{"literal_text_all_w_t_and_m_t":"2>else:","paragraph_zero_based":8174},{"literal_text_all_w_t_and_m_t":"3>remove the ssb-MeasConfig of the corresponding entry in the measIdleCarrierListNR within VarMeasIdleConfig, if stored;","paragraph_zero_based":8175},{"literal_text_all_w_t_and_m_t":"1>perform measurements according to 5.7.8.2a.","paragraph_zero_based":8176},{"literal_text_all_w_t_and_m_t":"5.7.8.2Void","paragraph_zero_based":8177},{"literal_text_all_w_t_and_m_t":"5.7.8.2aPerforming measurements","paragraph_zero_based":8178},{"literal_text_all_w_t_and_m_t":"When performing measurements on NR carriers according to this clause, the UE shall derive the cell quality as specified in 5.5.3.3 and consider the beam quality to be the value of the measurement results of the concerned beam, where each result is averaged as described in TS 38.215 [9].","paragraph_zero_based":8179},{"literal_text_all_w_t_and_m_t":"While in RRC_IDLE or RRC_INACTIVE, and T331 is running and SDT procedure is not ongoing, the UE shall:","paragraph_zero_based":8180},{"literal_text_all_w_t_and_m_t":"1>perform the measurements in accordance with the following:","paragraph_zero_based":8181},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListEUTRA and the SIB1 contains idleModeMeasurementsEUTRA:","paragraph_zero_based":8182},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListEUTRA within VarMeasIdleConfig:","paragraph_zero_based":8183}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["7f8fdbe3fdba391f03340b3eb91375aaa20737a3f89174323c5f01f04941ce99","5605f208004214015163bebf8180ff44511c2f6f6933cb2c13938ed068c3875e","83f44b317107c96e0e1fc7a6c10c7daee3f4bd96f78329134462d6e418da29f2","8f0ddfe7fc1ecdf0eb6718d3a79824a18bec70ffe1323ae187415c8933c29b07","8365d119fdc5c700a709617593a87c307b6cefbe233a15a2ec173ce59671afce","419c78b367f1ee1ab3fe3b4b71080d3381f952d778798ac397e9eb52939d6b1e","b925c808c5cb888e1ac6ece5f01ed3401ee17f848b77338080bb24317b4fd2be","09ce12b8ed51a37dbb6a79ee0709a88edb6e4d7ac4848e2f5bc06c07c34bffc5","2249cd033196a203d6355c3e5871e7901d2906862b2f9700bb1297a13ffb02b1","e52423ed0b78b95f6ca078ee9d43caee40d3527e76def8cbe0e486c326c80847","cd304de2bc0bc6595175dd854629e9626e7d01ab787a4f91d0608e10b2e97e20","8f2d654e1171c7439dd26880f9ff093bbd8d40815d80d2a1972b13a345ef12eb","091bde1f6bdbcf83b475d6f0c98d55f0b8df2260747950d3ff165ae01702d093","156f61021c9cbda21edbfc983fc76ec69d8467ea3eff002c4dba1712423f490b","e399ff939882aa25d4d486d8d31b945fcaa7dc0ef1710429dfacd10f0cbd9151","608d60a25766c4d812820801d5b9129ec33f8128c05387c6a8bcecefb9e1cf8f","9197fe3905b9f8edd216ea267334f5177f9aa1913539842061e1bfbdc66d06ab","6b3c6a6396cf0d7b262cfbc385f3d205a55ee241d79af6d8992b2e7632cb7d86","acfcf78e5d51e9286afd0d55b6bf22b4eebbd8db252445516ae3b6424533c137","bdc31d92bbe5049fdf87e5875a5a087b0eadc78257bed97082e7c3b96e6eb02e","4ab8e4f79b9adae20f182ff7d98376efcfdee81057a8a8ce64b66ba6d1c3e0ff","00ac9a5641ab4cf2ba00afc91749cdb3e2eb2ee46315ad613e6a7267b163789d","b39f38269a8678f37e4ea94735ba2303d9b58e59fd2a59996f5c55a5b2a024ea","a10ac38e9a50207ee8690d3c7e22e8d23ecbf72bd57870cd11187ea16b00daa7"],"paragraph_range_zero_based":[8160,8183],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p8160"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>if UE supports NE-DC between the serving carrier and the carrier frequency indicated by carrierFreqEUTRA within the corresponding entry:","paragraph_zero_based":8184},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and bandwidth indicated by carrierFreqEUTRA and allowedMeasBandwidth within the corresponding entry;","paragraph_zero_based":8185},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantitiesEUTRA is set to rsrq:","paragraph_zero_based":8186},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the sorting quantity;","paragraph_zero_based":8187},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8188},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the sorting quantity;","paragraph_zero_based":8189},{"literal_text_all_w_t_and_m_t":"5>if the measCellListEUTRA is included:","paragraph_zero_based":8190},{"literal_text_all_w_t_and_m_t":"6>consider cells identified by each entry within the measCellListEUTRA to be applicable for idle/inactive mode measurement reporting;","paragraph_zero_based":8191},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8192},{"literal_text_all_w_t_and_m_t":"6>consider up to maxCellMeasIdle strongest identified cells, according to the sorting quantity, to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":8193},{"literal_text_all_w_t_and_m_t":"5>for all cells applicable for idle/inactive measurement reporting, derive measurement results for the measurement quantities indicated by reportQuantitiesEUTRA;","paragraph_zero_based":8194},{"literal_text_all_w_t_and_m_t":"5>store the derived measurement results as indicated by reportQuantitiesEUTRA within the measReportIdleEUTRA in VarMeasIdleReport in decreasing order of the sorting quantity, i.e. the best cell is included first, as follows:","paragraph_zero_based":8195},{"literal_text_all_w_t_and_m_t":"6>if qualityThresholdEUTRA is configured:","paragraph_zero_based":8196},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from the cells applicable for idle/inactive measurement reporting whose RSRP/RSRQ measurement results are above the value(s) provided in qualityThresholdEUTRA;","paragraph_zero_based":8197},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":8198},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from all cells applicable for idle/inactive measurement reporting;","paragraph_zero_based":8199},{"literal_text_all_w_t_and_m_t":"2>if the VarMeasIdleConfig includes the measIdleCarrierListNR and the SIB1 contains idleModeMeasurementsNR:","paragraph_zero_based":8200},{"literal_text_all_w_t_and_m_t":"3>for each entry in measIdleCarrierListNR within VarMeasIdleConfig that contains ssb-MeasConfig:","paragraph_zero_based":8201},{"literal_text_all_w_t_and_m_t":"4>if UE supports carrier aggregation or NR-DC between serving carrier and the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry:","paragraph_zero_based":8202},{"literal_text_all_w_t_and_m_t":"5>perform measurements in the carrier frequency and subcarrier spacing indicated by carrierFreq and ssbSubCarrierSpacing within the corresponding entry;","paragraph_zero_based":8203},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantities is set to rsrq:","paragraph_zero_based":8204},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the cell sorting quantity;","paragraph_zero_based":8205},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8206},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the cell sorting quantity;","paragraph_zero_based":8207}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ddf71c4066e68346fcb6a33065b6f63a040f7c65f58da4384f12b41d95dbc884","663193f02d4b98a07072bd681e89937a56b07ded6743a6801ec4e3b07c698834","17742414156bb7eb40915abbdd30f538564b505809066ba64872e8e865da8d56","721ea87361956dbccd227cc474009c10244befdc9b09d64609c7d3e678e4fc20","c7a89a82aeb384d6f1f03c8ad5fff8e698865de459d37ad259b8ac17a2b7323e","5d6a1f999ca3d62354e67c8f6155e1ff88914a787c93d54887305f537a995340","6a7280bd542d069a0fca574b6de151d1c7c37eef4b9ad33b21c270d338e7abfb","e0c97bb48f26d1096ae43f7ff4407130a42a42e9db960e8a1d7a2b3f64088961","f7cfa621baf44ee392ebbca9d130d6f9324fe1f37b10f4a6c28ed5c90b107c25","75d81f30f1113c3d257c66c9386a9685b7e87c403aefeb318116d85687fc1f1b","a74932dba538f303e9daff5455f540447a67c33519c46f130c9248769b9f2618","0b3f63a73f05dea028c71b912ad3b927461dc7ea6c23be3a633b1f3be815b88e","6d4992cd513c7e86f7391eefd9593496d64f3187e5c359120ab52c904e7ab7a2","beab23d7c344c1710c6a5ad7538dc4f7d08d90a0bdfb897d7ade5c295cc450c7","bfa01df04351f993cd416a052fdb3e497c5bfb6f9fe828a03c9ce8f8a423311d","5cc46a2c5f2695f734763ccc455f6f5c246211f72365df7938a6d6affe96835c","ab9cd1a6b186fa26b8b3b1459e1947c19eb243a99ed5faf9d64fc6cc7a838e40","8e6d4a216d95eec0d97e0235a7fcae4e8c8dbd8d5f0db91bf2724989d224653c","37e43c167a0bedca2daaa26e10a5b78e8641a767c26e25d729cbfc026497902a","2a0282070bb504213a46516fa180dc96b4cdce474a940a731591086d9b18ef45","d32499cef4547cde60bffdc6dab0a7d28346de295af028bd7a68b5a8d8264eb1","28b9a47c8c1e92916d911387db68ccbf6d3dfcf2fc7754eeaf7dc03e3905f353","0adeb1fdb9c9288b01973dada475b6b4a0866c5ca49f8bec01c93df65a935e1c","b49b8564710c852c29dc1c5bc7b774eeff2f3c1b6949cbd9f6d0546acc2703e7"],"paragraph_range_zero_based":[8184,8207],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p8184"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>if the measCellListNR is included:","paragraph_zero_based":8208},{"literal_text_all_w_t_and_m_t":"6>consider cells identified by each entry within the measCellListNR to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":8209},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8210},{"literal_text_all_w_t_and_m_t":"6>consider up to maxCellMeasIdle strongest identified cells, according to the sorting quantity, to be applicable for idle/inactive measurement reporting;","paragraph_zero_based":8211},{"literal_text_all_w_t_and_m_t":"5>for all cells applicable for idle/inactive measurement reporting, derive cell measurement results for the measurement quantities indicated by reportQuantities;","paragraph_zero_based":8212},{"literal_text_all_w_t_and_m_t":"5>store the derived cell measurement results as indicated by reportQuantities for cells applicable for idle/inactive measurement reporting within measResultsPerCarrierListIdleNR in the measReportIdleNR in VarMeasIdleReport in decreasing order of the cell sorting quantity, i.e. the best cell is included first, as follows:","paragraph_zero_based":8213},{"literal_text_all_w_t_and_m_t":"6>if qualityThreshold is configured:","paragraph_zero_based":8214},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from the cells applicable for idle/inactive measurement reporting whose RSRP/RSRQ measurement results are above the value(s) provided in qualityThreshold;","paragraph_zero_based":8215},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":8216},{"literal_text_all_w_t_and_m_t":"7>include the measurement results from all cells applicable for idle/inactive measurement reporting;","paragraph_zero_based":8217},{"literal_text_all_w_t_and_m_t":"5>if beamMeasConfigIdle is included in the associated entry in measIdleCarrierListNR and if UE supports idleInactiveNR-MeasBeamReport for the FR of the carrier frequency indicated by carrierFreq within the associated entry, for each cell in the measurement results:","paragraph_zero_based":8218},{"literal_text_all_w_t_and_m_t":"6>derive beam measurements based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in TS 38.215 [9];","paragraph_zero_based":8219},{"literal_text_all_w_t_and_m_t":"6>if the reportQuantityRS-Indexes is set to rsrq:","paragraph_zero_based":8220},{"literal_text_all_w_t_and_m_t":"7>consider RSRQ as the beam sorting quantity;","paragraph_zero_based":8221},{"literal_text_all_w_t_and_m_t":"6>else:","paragraph_zero_based":8222},{"literal_text_all_w_t_and_m_t":"7>consider RSRP as the beam sorting quantity;","paragraph_zero_based":8223},{"literal_text_all_w_t_and_m_t":"6>set resultsSSB-Indexes to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes in order of decreasing beam sorting quantity as follows:","paragraph_zero_based":8224},{"literal_text_all_w_t_and_m_t":"7>include the index associated to the best beam for the sorting quantity and if absThreshSS-BlocksConsolidation is included, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":8225},{"literal_text_all_w_t_and_m_t":"6>if the includeBeamMeasurements is set to true:","paragraph_zero_based":8226},{"literal_text_all_w_t_and_m_t":"7>include the beam measurement results as indicated by reportQuantityRS-Indexes;","paragraph_zero_based":8227},{"literal_text_all_w_t_and_m_t":"2>if, as a result of the procedure in this clause, the UE performs measurements in one or more carrier frequency indicated by measIdleCarrierListNR or measIdleCarrierListEUTRA:","paragraph_zero_based":8228},{"literal_text_all_w_t_and_m_t":"3>store the cell measurement results for RSRP and RSRQ for the serving cell within measResultServingCell in the measReportIdleNR in VarMeasIdleReport.","paragraph_zero_based":8229},{"literal_text_all_w_t_and_m_t":"3>if the VarMeasIdleConfig includes the measIdleCarrierListNR and it contains an entry with carrierFreq set to the value of the serving frequency:","paragraph_zero_based":8230},{"literal_text_all_w_t_and_m_t":"4>if beamMeasConfigIdle is included in that entry, and if the UE supports idleInactiveNR- MeasBeamReport for the FR of the serving cell:","paragraph_zero_based":8231}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e2935f2eea6a12f58b81cba8a4ebcd27343071f288de274c8755c4a172469112","42118218ca169505c52bdd0d9a5298debe7ac71391fb2f6a62fa0deab4648feb","e27bc263fa42379aa63c3860e8fd20707c5fe351eed251657b078f22775c3475","75e0fd7832f2e3dff4891e2798871fbd4f15596dc97800195dac4120a9c5b5fc","af8d3de7fce682ef23b31b63a0c8bc2ce0f9415453e19b5f66e3c6fd1d91d030","83cc028c1f0cc06fa91a72fed8d4cf370e7f8cc5cd0a37bf9cd89c3cb8131e26","19a1e57345ccb262fb4a9dcf83775a97378ba2d524b13e32855d659290a2ce8e","cf575ead6f10b231eb96b6cf9d8b3d1ac8766254fe924913ee863f4e9de25901","2b03858361c7e5183ca1595e233e4c1ec1f42fef41e36ceab8aa8c256d5cd5ce","a70d377bf0ef53c038c4b777079bbf527e8be09d7c05b161d6d9c0faf5ae3246","5f6ce96fd959082d941de71fd478bcf1795e18e74efec24886dea0e57f0d8d4a","f8742247f4cba4937870f11de6078199c0dbe00db780af89163e0c5a71994bd3","d0284603a2eeb8dbdd3d6db5257a83b99167693121fc3bb1489a5e055498bf58","c56b993a86c2487fe6ca421996c0afd4fc01065bbc7d94ae4f403cca778b1f9a","4b552a98b7e87c8b89552a7e6248e22ce1d3d54cc509d8b05acbda8faf377bbe","89ab8e9d32b1cebc86cff36896108415b539830bee26b67f94c6576df379c46b","4b131afb729e526a55c7db1ce9f3cc0997d42965bb93eb91e8b10e486fc74bd7","d14846e9b4278f9c509df439ce78e2e4cc1fba8e71de9cb02751563998aa5a76","40350386a8c0fd591120e01b32d98987951cd85c9455eb6c204267c0f8193d81","eda2fa7d94fb191f7de38fdb0fbf23bfaf4b8f81299f9dd3d669a96168381200","ebdf3f404e8dd72ae35f05fc7cd5c87830a22f7d2fc7f8d7512c544d54484a59","d30a527d4b77defd1a799a4cd6c7baa647d77675c912fa251d3045611460e9da","027a4284f5a414495a26db6052928c0f0dec5a503f74c0d40e390d9b132c464c","7a5f008841c08010356b7e079824ee61b730b53132acd8b075471fe326e83def"],"paragraph_range_zero_based":[8208,8231],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p8208"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"5>derive beam measurements based on SS/PBCH block for each measurement quantity indicated in reportQuantityRS-Indexes, as described in TS 38.215 [9];","paragraph_zero_based":8232},{"literal_text_all_w_t_and_m_t":"5>if the reportQuantityRS-Indexes is set to rsrq:","paragraph_zero_based":8233},{"literal_text_all_w_t_and_m_t":"6>consider RSRQ as the beam sorting quantity;","paragraph_zero_based":8234},{"literal_text_all_w_t_and_m_t":"5>else:","paragraph_zero_based":8235},{"literal_text_all_w_t_and_m_t":"6>consider RSRP as the beam sorting quantity;","paragraph_zero_based":8236},{"literal_text_all_w_t_and_m_t":"5>set resultsSSB-Indexes to include up to maxNrofRS-IndexesToReport SS/PBCH block indexes in order of decreasing beam sorting quantity as follows:","paragraph_zero_based":8237},{"literal_text_all_w_t_and_m_t":"6>include the index associated to the best beam for the sorting quantity and if absThreshSS-BlocksConsolidation is included in SIB2 of serving cell, the remaining beams whose sorting quantity is above absThreshSS-BlocksConsolidation;","paragraph_zero_based":8238},{"literal_text_all_w_t_and_m_t":"5>if the includeBeamMeasurements is set to true:","paragraph_zero_based":8239},{"literal_text_all_w_t_and_m_t":"6>include the beam measurement results as indicated by reportQuantityRS-Indexes;","paragraph_zero_based":8240},{"literal_text_all_w_t_and_m_t":"NOTE 1:How the UE performs idle/inactive measurements is up to UE implementation as long as the requirements in TS 38.133 [14] are met for measurement reporting.","paragraph_zero_based":8241},{"literal_text_all_w_t_and_m_t":"NOTE 2:The UE is not required to perform idle/inactive measurements on a given carrier if the SSB configuration of that carrier provided via dedicated signaling is different from the SSB configuration broadcasted in the serving cell, if any.","paragraph_zero_based":8242},{"literal_text_all_w_t_and_m_t":"NOTE 3:How the UE prioritizes which frequencies to measure or report (in case it is configured with more frequencies than it can measure or report) is left to UE implementation.","paragraph_zero_based":8243},{"literal_text_all_w_t_and_m_t":"NOTE 4:When idleModeMeasVoiceFallback is included in SIB5, UE may decide to measure and report idle/inactive measurements for EUTRA carrier frequencies included in SIB5 even if it does not support NE-DC between the serving carrier and the EUTRA carrier frequencies.","paragraph_zero_based":8244},{"literal_text_all_w_t_and_m_t":"5.7.8.3T331 expiry or stop","paragraph_zero_based":8245},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8246},{"literal_text_all_w_t_and_m_t":"1>if T331 expires or is stopped:","paragraph_zero_based":8247},{"literal_text_all_w_t_and_m_t":"2>release the VarMeasIdleConfig.","paragraph_zero_based":8248},{"literal_text_all_w_t_and_m_t":"NOTE:It is up to UE implementation whether to continue idle/inactive measurements according to SIB11 and SIB4 configurations or according to E-UTRA SIB5 and E-UTRA SIB24 configurations as specified in TS 36.331 [10] upon inter-RAT cell reselection to E-UTRA, after T331 has expired or stopped.","paragraph_zero_based":8249},{"literal_text_all_w_t_and_m_t":"5.7.8.4Cell re-selection or cell selection while T331 is running","paragraph_zero_based":8250},{"literal_text_all_w_t_and_m_t":"The UE shall:","paragraph_zero_based":8251},{"literal_text_all_w_t_and_m_t":"1>if intra-RAT cell selection or reselection occurs while T331 is running:","paragraph_zero_based":8252},{"literal_text_all_w_t_and_m_t":"2>if validityAreaList is configured in VarMeasIdleConfig:","paragraph_zero_based":8253},{"literal_text_all_w_t_and_m_t":"3>if the serving frequency does not match with the carrierFreq of an entry in the validityAreaList; or","paragraph_zero_based":8254},{"literal_text_all_w_t_and_m_t":"3>if the serving frequency matches with the carrierFreq of an entry in the validityAreaList, the validityCellList is included in that entry, and the physical cell identity of the serving cell does not match with any entry in validityCellList:","paragraph_zero_based":8255}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["703c3099d13f7a72c46c307b6a47fd604dee4092f535655061619cb255218ee6","59955fee923b1c96292b9c3c51eac1c127746ec5d18796dedcb36dafc56ea619","766d714a97ecc106060be1e7c8f66a34b66fa9e88b9d122cb343d6f0e5e094d9","59f575ddd9b575743ac03261edff356079015762c6210691794fceca23564a47","9f699534515fed6154b05a77aa862597252831636eda0020382b9ba85dd974e1","c7491e5995c51d0de612b195125e457653ba920f201c487676542e4e6f9b21a1","f10f20babba839dc9e6448b562d53a914fd2aef67ca22e4360864fb6f82dc953","1499023faa3fd7573392d9ad4f7ec3f6ba5616a05ef0a5c47ecb47ce9eb33e24","ea7f2973c3146fbed99c7913d735b519ba3cf34bf1ddf4a9df1175c74d4b710e","86e360c12746ca6847a84725c8429fb8e4f7d94ebf1b98d15382c6a52dc9bcb5","decc198972e2be400f6e816bdfcf00cc608ecd34d45f6323a95deba4f6427f88","bf09c18899476661b0aa4984d414f970c0087f1f64f80a572e6681342fe8416f","242a652d146cd5c7c0a35929eda0fdf87a7de3fde370a7e0371d72078a41ce1b","6c9615411175596fdef941d2952fed81d160d38a1769216cc3d7508c482b687b","d8c05d7fbf67904550fc1ad987f0cc6e03494c8de4ea96c3972f1c5ebbf0b393","30b52924f00cb4d43b79ddcbb75e241a7fe12a5870225772df3129762b36ca92","b66d5bbedec5de2c9df21055d093b36bd76008dcb270a7648a6260d49d7c5b4b","4af5902de37809ea142c1f50ca135f21023a6eb726374b4878331b31d4e0b7d9","a52d477e9c20b7dc041079475ce9af83decc932d27e525dd31699601adc82581","c45cdbbfbd5397b7f5f0d9a22159e26e3232e27baadc8356df6d19a759f43456","5e068ba9c87556a9549083f2ad8c5d7637067911c2db86b610532697ceb7a75c","d96d59a2c104ecac348f2153ac7c694d78d12f21889d2b79ecbb03cb7b1572c0","98ce8fcea0a8cf46c4502fb5e9e273493a9e888f93ef9582f86a65f838f0333f","2667b7f3da6755cb40ea64f253bbdf121886f620fb46aeac4b8ca3da994c80cd"],"paragraph_range_zero_based":[8232,8255],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p8232"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"4>stop timer T331;","paragraph_zero_based":8256},{"literal_text_all_w_t_and_m_t":"4>perform the actions as specified in 5.7.8.3, upon which the procedure ends.","paragraph_zero_based":8257},{"literal_text_all_w_t_and_m_t":"1>else if inter-RAT cell selection or reselection occurs while T331 is running:","paragraph_zero_based":8258},{"literal_text_all_w_t_and_m_t":"2>stop timer T331;","paragraph_zero_based":8259},{"literal_text_all_w_t_and_m_t":"2>perform the actions as specified in 5.7.8.3;","paragraph_zero_based":8260},{"literal_text_all_w_t_and_m_t":"5.7.9Mobility history information","paragraph_zero_based":8261},{"literal_text_all_w_t_and_m_t":"5.7.9.1General","paragraph_zero_based":8262},{"literal_text_all_w_t_and_m_t":"This procedure specifies how the mobility history information is stored by the UE, covering RRC_IDLE, RRC_INACTIVE and RRC_CONNECTED and released by the UE upon deregistration as specified in TS 23.502 [43].","paragraph_zero_based":8263},{"literal_text_all_w_t_and_m_t":"5.7.9.2Initiation","paragraph_zero_based":8264},{"literal_text_all_w_t_and_m_t":"If the UE supports storage of mobility history information, the UE shall:","paragraph_zero_based":8265},{"literal_text_all_w_t_and_m_t":"1>If the UE supports PSCell mobility history information and upon addition of a PSCell:","paragraph_zero_based":8266},{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedPSCellInfoList in variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":8267},{"literal_text_all_w_t_and_m_t":"3>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":8268},{"literal_text_all_w_t_and_m_t":"4>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":8269},{"literal_text_all_w_t_and_m_t":"5>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":8270},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8271},{"literal_text_all_w_t_and_m_t":"4>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":8272},{"literal_text_all_w_t_and_m_t":"2>for the included entry:","paragraph_zero_based":8273},{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry according to following:","paragraph_zero_based":8274},{"literal_text_all_w_t_and_m_t":"4>if this is the first PSCell entry for the current PCell since entering the current PCell in RRC_CONNECTED:","paragraph_zero_based":8275},{"literal_text_all_w_t_and_m_t":"5>include the entry as the time spent with no PSCell since entering the current PCell in RRC_CONNECTED;","paragraph_zero_based":8276},{"literal_text_all_w_t_and_m_t":"4>else:","paragraph_zero_based":8277},{"literal_text_all_w_t_and_m_t":"5>include the time spent with no PSCell since last PSCell release since entering the current PCell in RRC_CONNECTED;","paragraph_zero_based":8278},{"literal_text_all_w_t_and_m_t":"1>If the UE supports PSCell mobility history information and upon change, or release of a PSCell while being connected to the current PCell:","paragraph_zero_based":8279}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3fc85f9afea51b9c3b923fa97493528c38980d71f877890f3c10c4bb7676a0d3","85a56a57935c3acc006ceea909dbfaee50b0b7f12b5af5b897a88c8f38ba8c79","27ae49dafe825e395b33314fcbf362d901a4f9d7688764ba350eab81431ce9a4","b35bb7f86ed20310f5385e4801bc599f072d75ef29389d761afe8f664054d4f7","057523b4358f5075c4ef9f674814e52ca97277b4a087af41a7bb242cc98b80cd","a43984c48e648f89b25ea9c757ada411679d6047d5e4a9680e21d52230f00d43","347e87a51a8029b6fd99b007b4149cd4ef8a09378dd8e929869d295589e9bd28","0252b6df7812940191e84dfad42ea8b3a93ffc494f0104ad562ffe560f34b064","9da692634a483401333d4222989072baa9d2fc500a540b76ec4b4a0bee34bfda","a772e47222ca6bb20db630d39948fdd589f89d9fe7ae305506c9c1f2130f7b74","dd81c2476a4b292de030ca5526721bbfd3bcd06034891e749dd5b6bee2379d28","1887f090f4018a46cd1175e1c40465d19c6950491e697df41570f8c9c716aa33","090397762f89afe341152703db2257853cb2e1b37b37d49982dcab2d635c6ba1","3e318b90579bbca4279c9d54f2c0d21c71bba54c3316ffe7fdd81094266da272","9598751b49ab5cd83bc4d4ebf01d97c727bb8e327ff04ef6bc7acb560bcbfbe7","fa038a09962d2df44711c5396526ba8c756b525b7e1953329084f825d21d9765","525047cba857a01bb7a7721f641ab61d5a027d0a23d38a94210a8f5c58f3672a","cfac3c587ebf30f7c33ae3e64749c0af3085f0b7c41895e42c241cf912583faa","d7881b484875ed59c8fc73003a2edf83eac546431bd86d11b35fc6c3998af5d2","d5a7ba477d99dd6d332c0c6541d54f20ad4fb948db2c22f2092a2c603d63989a","224b6a1b83b53f0560418528ba8fec62f0377e3e4c8495bf730b5ba4c26a08ff","88bdb7ac5069acaaf5a32326d6bc53bf554bb386d57722165baa08ec125d5478","5e8fd5c091a2e6fe2db3c127c6e1b6076d807f769d9ac6425a29507f0e50f54d","81b8eb081434c0a93bfc4f0fc2c43b7bcaf2fcb28e2d13306adfe7a72063fbd6"],"paragraph_range_zero_based":[8256,8279],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p8256"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedPSCellInfoList of the variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":8280},{"literal_text_all_w_t_and_m_t":"3>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":8281},{"literal_text_all_w_t_and_m_t":"4>for the oldest PCell entry in visitedCellInfoList including visitedPSCellInfoListReport;","paragraph_zero_based":8282},{"literal_text_all_w_t_and_m_t":"5>remove the oldest entry in the visitedPSCellInfoListReport;","paragraph_zero_based":8283},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8284},{"literal_text_all_w_t_and_m_t":"4>remove the oldest entry in visitedPSCellInfoList in variable VarMobilityHistoryReport;","paragraph_zero_based":8285},{"literal_text_all_w_t_and_m_t":"2>for the included entry:","paragraph_zero_based":8286},{"literal_text_all_w_t_and_m_t":"3>if the global cell identity of the previous PSCell is available:","paragraph_zero_based":8287},{"literal_text_all_w_t_and_m_t":"4>include the global cell identity of that cell in the field visitedCellId of the entry;","paragraph_zero_based":8288},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8289},{"literal_text_all_w_t_and_m_t":"4>include the physical cell identity and carrier frequency of that cell in the field visitedCellId of the entry;","paragraph_zero_based":8290},{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry as the time spent in the previous PSCell while being connected to the current PCell;","paragraph_zero_based":8291},{"literal_text_all_w_t_and_m_t":"1>Upon change of suitable cell, consisting of PCell in RRC_CONNECTED (for NR or E-UTRA cell) or serving cell in RRC_INACTIVE (for NR cell) or in RRC_IDLE (for NR or E-UTRA cell), to another NR or E-UTRA cell, or when entering any cell selection' state from 'camped normally' state in NR or LTE or when entering 'any cell selection' state from a suitable cell in RRC_CONNECTED state in NR or LTE:","paragraph_zero_based":8292},{"literal_text_all_w_t_and_m_t":"2>include an entry in visitedCellInfoList of the variable VarMobilityHistoryReport possibly after removing the oldest entry, if necessary, according to following:","paragraph_zero_based":8293},{"literal_text_all_w_t_and_m_t":"3>if the global cell identity of the previous PCell/serving cell is available:","paragraph_zero_based":8294},{"literal_text_all_w_t_and_m_t":"4>include the global cell identity of that cell in the field visitedCellId of the entry;","paragraph_zero_based":8295},{"literal_text_all_w_t_and_m_t":"3>else:","paragraph_zero_based":8296},{"literal_text_all_w_t_and_m_t":"4>include the physical cell identity and carrier frequency of that cell in the field visitedCellId of the entry;","paragraph_zero_based":8297},{"literal_text_all_w_t_and_m_t":"3>set the field timeSpent of the entry as the time spent in the previous PCell/serving cell;","paragraph_zero_based":8298},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the UE continues to be connected to the same PSCell during the change of the PCell in RRC_CONNECTED; or","paragraph_zero_based":8299},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the UE changes PSCell at the same time as the change of the PCell in RRC_CONNECTED; or","paragraph_zero_based":8300},{"literal_text_all_w_t_and_m_t":"3>if the UE supports PSCell mobility history information and if the PSCell is released at the same time as the change of the PCell in RRC_CONNECTED:","paragraph_zero_based":8301},{"literal_text_all_w_t_and_m_t":"4>include an entry in visitedPSCellInfoList of the variable VarMobilityHistoryReport possibly after performing the following, if necessary:","paragraph_zero_based":8302},{"literal_text_all_w_t_and_m_t":"5>if visitedPSCellInfoListReport is available in the visitedCellInfoList in variable VarMobilityHistoryReport:","paragraph_zero_based":8303}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["d63844e36d4de8af4856fa78666aa6100878d302741e81a55f822fa753aa02e4","18e18a98e665f96b43926cd7cb8dad7651037aa1109c2be1fa333dbbe7f322ad","06206e75540ecdd68194470a744e4e9f5bdbcd14aca24c6d9a5052cfc668d41e","aa8970925a1e793a6e5a072c6405d5146dd1384eb4f9b0f64c6c0e1fc859e9b4","bf6534c01d69fdb665f2c9894fc55bb676baadabab9b4f32c8a5f57ad7dfa204","ae5cbeb53fb10776a72a7b1e45691af41d4dcd691d238d47eb908c0b7d30095b","c1276f4fed39e0a0cd4b77f2d98b70bdb8387cdde0cef617b3dae26571e76f69","2bd759a0c275c66a5fb370f601646ac206e89a76c8a28adeabae19c6a56ef47b","f4d0c9314b14dc0990255354ffba37f66f1cfd53721ad7db9f9695bd4c2f40df","b872459ea5e45bd3283a86803fa89b8bb8b2ae06d798f170a971106f4a833aaa","ae7133d082547b072d945bc09c2d385fc0dd6c5b611fb27d1e946a616032c907","d0e04025cb98370713ff422285cb3cda0dee99ed360a2c0ec970949e66683706","6902afd5663e6d086710537a1c2ff9d58ea97a37ef2e4d3cf053e5a8e5dc5db0","5f9600ce709bada6f66451ac63d160bafd1e69dcca40af88a7716a504c66e3a2","7f6e1c8c178a02313616af3f293686af049458b880dafc4d1935629a4600d38b","61128d851a6e3d86883c65e4be9040547ca59409f4556d328654714b25c29b10","f127a6059828753d2ea7d0cf6b06d222098ef0ff130e95c33c9c74f9d322df2f","3b125f519c1fa3da7abf201a478a86fe74bbd858b60adbd0dbdb5f7aa7f49136","ea061a2e7104683d60601d804c6153ac985072b4dfcd00d8a85987f30a55ee42","dc88504472053ca9e984bdbc5765c0fa9b51fc56ea82c07f21aee0407e88d071","0d082076e61dae7fbc456fabf0c8ff6