{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":25728},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHCONFIGRELAY-START","paragraph_zero_based":25729},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25730},{"literal_text_all_w_t_and_m_t":"N3C-IndirectPathConfigRelay-r18 ::=    SEQUENCE {","paragraph_zero_based":25731},{"literal_text_all_w_t_and_m_t":"    n3c-MappingToReleaseList-r18           SEQUENCE (SIZE (1..maxLC-ID)) OF SL-RemoteUE-RB-Identity-r17        OPTIONAL, -- Need N","paragraph_zero_based":25732},{"literal_text_all_w_t_and_m_t":"    n3c-MappingToAddModList-r18            SEQUENCE (SIZE (1..maxLC-ID)) OF N3C-MappingToAddMod-r18            OPTIONAL, -- Need N","paragraph_zero_based":25733},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25734},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25735},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25736},{"literal_text_all_w_t_and_m_t":"N3C-MappingToAddMod-r18 ::=            SEQUENCE {","paragraph_zero_based":25737},{"literal_text_all_w_t_and_m_t":"    n3c-RemoteUE-RB-Identity-r18           SL-RemoteUE-RB-Identity-r17,","paragraph_zero_based":25738},{"literal_text_all_w_t_and_m_t":"    n3c-RLC-ChannelUu-r18                  Uu-RelayRLC-ChannelID-r17                                           OPTIONAL, -- Need M","paragraph_zero_based":25739},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":25740},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":25741},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25742},{"literal_text_all_w_t_and_m_t":"-- TAG-N3C-INDIRECTPATHCONFIGRELAY-STOP","paragraph_zero_based":25743},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":25744},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":25745},{"