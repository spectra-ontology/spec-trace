{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"SubcarrierSpacing ::=               ENUMERATED {kHz15, kHz30, kHz60, kHz120, kHz240, kHz480-v1700, kHz960-v1700, spare1}","paragraph_zero_based":35664},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35665},{"literal_text_all_w_t_and_m_t":"-- TAG-SUBCARRIERSPACING-STOP","paragraph_zero_based":35666},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":35667},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35668},{"literal_text_all_w_t_and_m_t":"–TAG-Config","paragraph_zero_based":35669},{"literal_text_all_w_t_and_m_t":"The IE TAG-Config is used to configure parameters for a time-alignment group.","paragraph_zero_based":35670},{"literal_text_all_w_t_and_m_t":"TAG-Config information element","paragraph_zero_based":35671},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":35672},{"literal_text_all_w_t_and_m_t":"-- TAG-TAG-CONFIG-START","paragraph_zero_based":35673},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35674},{"literal_text_all_w_t_and_m_t":"TAG-Config ::=                      SEQUENCE {","paragraph_zero_based":35675},{"literal_text_all_w_t_and_m_t":"    tag-ToReleaseList                   SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG-Id                          OPTIONAL,   -- Need N","paragraph_zero_based":35676},{"literal_text_all_w_t_and_m_t":"    tag-ToAddModList                    SEQUENCE (SIZE (1..maxNrofTAGs)) OF TAG                             OPTIONAL    -- Need N","paragraph_zero_based":35677},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35678},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35679},{"literal_text_all_w_t_and_m_t":"TAG ::=                             SEQUENCE {","paragraph_zero_based":35680},{"literal_text_all_w_t_and_m_t":"    tag-Id                              TAG-Id,","paragraph_zero_based":35681},{"literal_text_all_w_t_and_m_t":"    timeAlignmentTimer                  TimeAlignmentTimer,","paragraph_zero_based":35682},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":35683},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":35684},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35685},{"literal_text_all_w_t_and_m_t":"TAG-Id ::=                          INTEGER (0..maxNrofTAGs-1)","paragraph_zero_based":35686},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":35687}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["dc92ae5fee2f072e5611ed809609be5093a7c1af13e4de961ada2d5dca51b07e","1cc320d45b6bab102aa9d009e05250ad77d33d4edc6c33ddb91e1ca5a21bfb60","815ebb999a9031b7747783e3cb197d6258692ffdc9c8b5295fc8e119bfd542d6","afb2329fca7b7f4f665b0a64f9b0116a04713377ac2187b914314bafa9866ad2","e7395c229d1daee94a11c4f91c97d902f868179088a886cee0fd276d169bee20","81248b025f3178a0059f252262e7e2d74c44776007c3a9ca3527df5b4f71b93f","579543a8bb9cefa60031e2bd3db058ce95c4f9ff4556c17088986abfbfe6dc6a","dc2b950ca578f11327ad648f5248306840e124a96116398a2fc95611f0eea8f4","8b0624d3865aebc5f413e62018165453fa1b13f18f487a526c3d419daa2397f7","9f590561c500b3f1c16fd8fb4c6a358f4bc43ffaa4f94eebbad4a5737e4434d7","918c1a185d4a9e272dedb651aff6ffb54e0da3c4d21d685840728e2980aa0bbb","dba70db3dde149d7808e1ba4ccd89a93b66074998598dc480e34c9fd5efc4243","3e393fdafa1af50747e24d502117ccdc4eb8fa15df713455e8e54bf6c4eb5074","57529022e4889211f8690d4c656c8cc8e4ff8f1742a1465f76485befae6241fc","cdc6cdcbb16fce814d8c1c45e6e2d8d904b6db48392057dd6a3747894cdc13d4","8039b6313c10d9a6a1f50631ffe715fd779d3e1bea472bec8e879d35e55d442b",