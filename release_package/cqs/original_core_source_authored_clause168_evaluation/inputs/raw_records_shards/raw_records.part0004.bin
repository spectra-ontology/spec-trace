{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero information element","paragraph_zero_based":21096},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21097},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-START","paragraph_zero_based":21098},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21099},{"literal_text_all_w_t_and_m_t":"ControlResourceSetZero ::=                  INTEGER (0..15)","paragraph_zero_based":21100},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21101},{"literal_text_all_w_t_and_m_t":"-- TAG-CONTROLRESOURCESETZERO-STOP","paragraph_zero_based":21102},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21103},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21104},{"literal_text_all_w_t_and_m_t":"–CrossCarrierSchedulingConfig","paragraph_zero_based":21105},{"literal_text_all_w_t_and_m_t":"The IE CrossCarrierSchedulingConfig is used to specify the configuration when the cross-carrier scheduling is used in a cell.","paragraph_zero_based":21106},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig information element","paragraph_zero_based":21107},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21108},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-START","paragraph_zero_based":21109},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21110},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig ::=        SEQUENCE {","paragraph_zero_based":21111},{"literal_text_all_w_t_and_m_t":"    schedulingCellInfo                      CHOICE {","paragraph_zero_based":21112},{"literal_text_all_w_t_and_m_t":"        own                                     SEQUENCE {                  -- Cross carrier scheduling: scheduling cell","paragraph_zero_based":21113},{"literal_text_all_w_t_and_m_t":"            cif-Presence                            BOOLEAN","paragraph_zero_based":21114},{"literal_text_all_w_t_and_m_t":"        },","paragraph_zero_based":21115},{"literal_text_all_w_t_and_m_t":"        other                                   SEQUENCE {                  -- Cross carrier scheduling: scheduled cell","paragraph_zero_based":21116},{"literal_text_all_w_t_and_m_t":"            schedulingCellId                        ServCellIndex,","paragraph_zero_based":21117},{"literal_text_all_w_t_and_m_t":"            cif-InSchedulingCell                    INTEGER (1..7)","paragraph_zero_based":21118},{"literal_text_all_w_t_and_m_t":"        }","paragraph_zero_based":21119}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["92341916a644721f1bde05dc16fcf888f8a56d0767916e4ab9a217a809a9d79b","17d3204396332b8df2c8a482174d6049d38de8823187a4bd9dac2439823d3d6c","b5ec021a0aac51ff2533e0df8ee58988eaf107e48af10ec6e1cd42881bfac06c","9eef765758cb54f980e712321fb3d2517d86a7ab7ef134b0f70328019cf580c2","55afca752da2b904aad9f8b1ebaacf9a100b46a031b22add78e9208d89c2f6d7","793f4c17fd1118fdb94260f5e83ecb9087eb4b470f73c45961c4573af4987f51","9cad83cf5d25c81fd6ef68e8f4c08dcea6010d58360325e18e27501ae17655b2","ddbc262c0c6a62e84445c564748165e0bf89cfb55eb2d99799cb229586ea11af","a4e8b5f0d8130bf631027f40ff1c21539d87bccb48c6b414f947d842fcbc3637","3cfcc9fea5ce9a0454600fd1dc9ba289ef62bf72a08054b80c14a63e442255af","41a0c19519d9d12c19afc7e2b7957be51b1245acb1e5d424efebbc25eaf33169","82c63be35ca8bc37ca7553cc46d5e302b8a2ad774068e45622221fcfebe18722","14a58880123b9d7aa5dfe78492dd54447684b9c1f56671141bb1cbd1e630f1b4","ebdc15d10e5940f48f06ce209d7540a31d8234080c2dcbbfac3d210fd525d8db","f76f95cf39e6b14648afbd1d4874ee54655e4b429bdfd1bc86ccd74933293d7b","daa670650cd95ebca333ccfa2be25c1744de1aa671ab017e35719531f1920439","423d4de1efaf2c83b8a0349bce3a3298bae2c1404cbebffa9f863d8cd3af3692","37c4cac1101e668a1a5763463f2bf156686c78ccc6933ceae57b3b0f7d4ecbf7","c59e1b067dd7b81e1c2c54c96c3da894901ac415f02768307324cc41b7cdcb15","ed96e769611a3bfee9a7541d08c0f7802bdba855be447d79817578b33b32f8b0","705a8b70d79a62f934c5bfea8b7e47cb917a8d9f1808e147e06a9ab8ab45e8fe","a0d9b5c1394e1a9039b5794596be1d41bef6723aea181d3a7fa8d2efeb3409c3","47b1c49ba1a6265862d15405ea317012aca6041f0beab609d1aa52826b55a770","e7efa822e1f980f7c1ac59beb12961e29cd3a7075d45a0b1c80d647964c140b3"],"paragraph_range_zero_based":[21096,21119],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21096"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    },","paragraph_zero_based":21120},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":21121},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21122},{"literal_text_all_w_t_and_m_t":"    carrierIndicatorSize-r16            SEQUENCE {","paragraph_zero_based":21123},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-1-2-r16        INTEGER (0..3),","paragraph_zero_based":21124},{"literal_text_all_w_t_and_m_t":"        carrierIndicatorSizeDCI-0-2-r16        INTEGER (0..3)","paragraph_zero_based":21125},{"literal_text_all_w_t_and_m_t":"    }                                                                                       OPTIONAL,  -- Cond CIF-PRESENCE","paragraph_zero_based":21126},{"literal_text_all_w_t_and_m_t":"    enableDefaultBeamForCCS-r16         ENUMERATED {enabled}                                OPTIONAL  -- Need S","paragraph_zero_based":21127},{"literal_text_all_w_t_and_m_t":"    ]],","paragraph_zero_based":21128},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":21129},{"literal_text_all_w_t_and_m_t":"    ccs-BlindDetectionSplit-r17         ENUMERATED {oneSeventh, threeFourteenth, twoSeventh, threeSeventh,","paragraph_zero_based":21130},{"literal_text_all_w_t_and_m_t":"                                            oneHalf, fourSeventh, fiveSeventh, spare1}      OPTIONAL  -- Need R","paragraph_zero_based":21131},{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":21132},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":21133},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21134},{"literal_text_all_w_t_and_m_t":"-- TAG-CROSSCARRIERSCHEDULINGCONFIG-STOP","paragraph_zero_based":21135},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":21136},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21137},{"literal_text_all_w_t_and_m_t":"CrossCarrierSchedulingConfig field descriptions","paragraph_zero_based":21138},{"literal_text_all_w_t_and_m_t":"carrierIndicatorSizeDCI-0-2, carrierIndicatorSizeDCI-1-2","paragraph_zero_based":21139},{"literal_text_all_w_t_and_m_t":"Configures the number of bits for the field of carrier indicator in PDCCH DCI format 0_2/1_2. The field carrierIndicatorSizeDCI-0-2 refers to DCI format 0_2 and the field carrierIndicatorSizeDCI-1-2 refers to DCI format 1_2, respectively (see TS 38.212 [17], clause 7.3.1 and TS 38.213 [13], clause 10.1).","paragraph_zero_based":21140},{"literal_text_all_w_t_and_m_t":"ccs-BlindDetectionSplit","paragraph_zero_based":21141},{"literal_text_all_w_t_and_m_t":"Indicates the share of blind detection candidates and non-overlapping CCEs for PDCCH monitoring on an SpCell and an SCell when cross-carrier scheduling is configured from the SCell for the SpCell (see TS 38.213 [13], clause 10.1.1). The network only configures this field when it sets the field other for an SpCell, i.e., when it configures cross-carrier scheduling of the SpCell by a PDCCH on an Scell.","paragraph_zero_based":21142},{"literal_text_all_w_t_and_m_t":"cif-Presence","paragraph_zero_based":21143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f5d65cb56a519cb0a3ba4bf4b65b3a73e33918d75651a8f2a9fd89506230178a","2229ea24ce1f57943c8883011e1815b07b1fcf5c9b2964afa73017885ac821da","644f9ed49705e62a4cf9defecf13d96801d54adb8f5c4660605fdecfb135a5ad","54693089bc1afeca59e89d0fdb81f209e3cc25832b75a4ed596c927b7be2c99e","d6e8b32633fe470b4bd5d24d5f6928db80cd9ee31f12042bf814ed6addf2337d","7e69b49c2a11174e8c24b1dff960c75d8a4fc9a436f8bed9e7999cd58de2c5a5","8e44b812d1ddc4e00806a2439da79828db258f2ed79a862deccd06bb83a1cde6","6aca742e9662d00d782372cfefc43c51c5655d7a5244ad78309ebfeaa7836d30","df679dbd5852941dd7fe3d32e5ac37a6b984694fe7289bb60f26365a28b91cd4","96456981884b36078cbb8dc71edb8a7448328f34ffd9b9cd7e16e083927f497a","8b939208687eb9190fd02dbb76a4c61eab801ada90c22396de19b5b3d99eda22","c590323746d7166780c576a5baf5b0d25c4df8d526d80a619c0e8be18e46d296","115db68752f35e4393b81e1775625ca9e5865b6278951584d98832d2e5f0ee9d","8f495cbda3e7de1f3f2f297241078366b0274582302f08687002e3bdc418b231","193d8c56fa14f36acdce733e4e1cc93980b2f7c863fcf44244bedd724196aaa6","ae74630f62d2b67340511d08a159e6bf4d4364572886507becdbf01249c5d134","11093ea5a57b959f9f3bcd446d4858f994c81abc1dcfd82672cc8fdf26bf9a46","e78f99b72ee6ac6741e6d367b61142a200e2a6eee2d466d9663f037ef12478b0","82fed0b709a596a1e95a47556f2cd500f617d94d778c82793fb8722ba542f418","181ef9d1b51815a1f03c0cbf0f9788bace6565b505252d9d80bac3b4f46c3538","4993e270f9527991608755afaf703f6b670240e944e8bc3395ec76d2eee79041","f0ed8421e9b27f622d4ef45ec76487a45e6a1a3a56ef95475480b3afa5e67acb","3c830b1c35060187daf19d1fa3435572393c096f40d042b36d4fe21c4899b7fd","ac49508811c860e90f2090b2fc0ecec7df380057b4ed20719a21c4e6d6e9806f"],"paragraph_range_zero_based":[21120,21143],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p21120"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The field is used to indicate whether carrier indicator field is present (value true) or not (value false) in PDCCH DCI formats, see TS 38.213 [13]. If cif-Presence is set to true, the CIF value indicating a grant or assignment for this cell is 0.","paragraph_zero_based":21144},{"literal_text_all_w_t_and_m_t":"cif-InSchedulingCell","paragraph_zero_based":21145},{"literal_text_all_w_t_and_m_t":"The field indicates the CIF value used in the scheduling cell to indicate a grant or assignment applicable for this cell, see TS 38.213 [13]. If configured for an SpCell, the non-fallback DCI formats on the SpCell include same number of CIF bits as the corresponding non-fallback DCI formats on the scheduling cell, and the CIF bits are considered reserved.","paragraph_zero_based":21146},{"literal_text_all_w_t_and_m_t":"enableDefaultBeamForCCS","paragraph_zero_based":21147},{"literal_text_all_w_t_and_m_t":"This field indicates whether default beam selection for cross-carrier scheduled PDSCH or aperiodic CSI-RS is enabled, see TS 38.214 [19]. If not present, the default beam selection behaviour is not applied, i.e. Rel-15 behaviour is applied. This field can only be configured in the cross-scheduled SCell or SpCell.","paragraph_zero_based":21148},{"literal_text_all_w_t_and_m_t":"other","paragraph_zero_based":21149},{"literal_text_all_w_t_and_m_t":"Parameters for cross-carrier scheduling. If configured for an SpCell, the SpCell can be scheduled by the PDCCH on another SCell as well as by the PDCCH on the SpCell. If configured for an SCell, the SCell is scheduled by a PDDCH on another cell.","paragraph_zero_based":21150},{"literal_text_all_w_t_and_m_t":"own","paragraph_zero_based":21151},{"literal_text_all_w_t_and_m_t":"Parameters for self-scheduling, i.e., a serving cell is scheduled by its own PDCCH.","paragraph_zero_based":21152},{"literal_text_all_w_t_and_m_t":"schedulingCellId","paragraph_zero_based":21153},{"literal_text_all_w_t_and_m_t":"If configured for an SpCell, this field indicates which SCell, in addition to the SpCell, signals the downlink allocations and uplink grants, if applicable, for the concerned SpCell. If configured for an Scell, this field indicates which cell signals the downlink allocations and uplink grants, if applicable, for the concerned SCell. In case the UE is configured with DC, the scheduling cell is part of the same cell group (i.e. MCG or SCG) as the scheduled cell. In case the UE is configured with two PUCCH groups, the scheduling cell and the scheduled cell are within the same PUCCH group. If drx-ConfigSecondaryGroup is configured in the MAC-CellGroupConfig associated with this serving cell, the scheduling cell and the scheduled cell belong to the same Frequency Range. In addition, the serving cell with an aperiodic CSI trigger and the PUSCH resource scheduled for the report are on the same carrier and serving cell, but the cell for which CSI is reported may belong to the same or a different Frequency Range. The network should not trigger a CSI request for a serving cell in the other Frequency Range when that serving cell is outside Active Time.","paragraph_zero_based":21154},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21155},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":21156},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":21157},{"literal_text_all_w_t_and_m_t":"CIF-PRESENCE","paragraph_zero_based":21158},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the cif-Presence is set to true. The field is absent otherwise.","paragraph_zero_based":21159},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21160},{"literal_text_all_w_t_and_m_t":"–CSI-AperiodicTriggerStateList","paragraph_zero_based":21161},{"literal_text_all_w_t_and_m_t":"The CSI-AperiodicTriggerStateList IE is used to configure the UE with a list of aperiodic trigger states. Each codepoint of the DCI field \"CSI request\" is associated with one trigger state (see TS 38.321 [3], clause 6.1.3.13). Upon reception of the value associated with a trigger state, the UE will perform measurement of CSI-RS, CSI-IM and/or SSB (reference signals) and aperiodic reporting on L1 according to all entries in the associatedReportConfigInfoList for that trigger state.","paragraph_zero_based":21162},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList information element","paragraph_zero_based":21163},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":21164},{"literal_text_all_w_t_and_m_t":"-- TAG-CSI-APERIODICTRIGGERSTATELIST-START","paragraph_zero_based":21165},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":21166},{"literal_text_all_w_t_and_m_t":"CSI-AperiodicTriggerStateList ::=   SEQUENCE (SIZE (1..maxNrOfCSI-AperiodicTriggers)) OF CSI-AperiodicTriggerState","paragraph_zero_based":21167}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["2f26343592482bbd43ae44cf250f855eb3b0ddf52b2fe392552197ff50f23d45","31bf9b10574dd486499a97502b4fe08b705f23f70bf77f766385cca6e6892426","beb5214d11fb17c109930621c8187d0b941a9e5fa20491f6049882d5592f40ec","9c62ef4aff6a46b68667a00a2723b54f50edf1bef271026cb845b12575f3fb2d","cc2fd402655af498da45936e143e30bbcca05c43931deb7c2b805ee1202da881","3bcac17e5a015487f25c5d300320113985d8e610b8741e9fe33f182bafccb28b","5ac6385eb5927213f9cef103130fde482c68b22fc7c08a1f05e3f54a3a03a2c1","5ec6725222b4d591eedc7a4e37b0089f03375fadf3ecd5fdc6ffc813d0204c05","ac08d017a1064005fa17d10146e47