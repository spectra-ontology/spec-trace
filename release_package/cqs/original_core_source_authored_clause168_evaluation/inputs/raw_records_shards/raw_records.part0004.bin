{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"The IE SL-FreqConfigCommon specifies the cell-specific configuration information on one particular carrier frequency for NR sidelink communication.","paragraph_zero_based":45312},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon information element","paragraph_zero_based":45313},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":45314},{"literal_text_all_w_t_and_m_t":"-- TAG-SL-FREQCONFIGCOMMON-START","paragraph_zero_based":45315},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":45316},{"literal_text_all_w_t_and_m_t":"SL-FreqConfigCommon-r16 ::=      SEQUENCE {","paragraph_zero_based":45317},{"literal_text_all_w_t_and_m_t":"    sl-SCS-SpecificCarrierList-r16   SEQUENCE (SIZE (1..maxSCSs)) OF SCS-SpecificCarrier,","paragraph_zero_based":45318},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencyPointA-r16   ARFCN-ValueNR,","paragraph_zero_based":45319},{"literal_text_all_w_t_and_m_t":"    sl-AbsoluteFrequencySSB-r16      ARFCN-ValueNR                                                       OPTIONAL, -- Need R","paragraph_zero_based":45320},{"literal_text_all_w_t_and_m_t":"    frequencyShift7p5khzSL-r16       ENUMERATED {true}                                                   OPTIONAL, -- Cond V2X-SL-Shared","paragraph_zero_based":45321},{"literal_text_all_w_t_and_m_t":"    valueN-r16                       INTEGER (-1..1),","paragraph_zero_based":45322},{"literal_text_all_w_t_and_m_t":"    sl-BWP-List-r16                  SEQUENCE (SIZE (1..maxNrofSL-BWPs-r16)) OF SL-BWP-ConfigCommon-r16  OPTIONAL, -- Need R","paragraph_zero_based":45323},{"literal_text_all_w_t_and_m_t":"    sl-SyncPriority-r16              ENUMERATED {gnss, gnbEnb}                                           OPTIONAL, -- Need R","paragraph_zero_based":45324},{"literal_text_all_w_t_and_m_t":"    sl-NbAsSync-r16                  BOOLEAN                                                             OPTIONAL, -- Need R","paragraph_zero_based":45325},{"literal_text_all_w_t_and_m_t":"    sl-SyncConfigList-r16            SL-SyncConfigList-r16                                               OPTIONAL, -- Need R","paragraph_zero_based":45326},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":45327},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":45328},{"literal_text_all_w_t_and_m_t":"    sl-UnlicensedFreqConfigCommon-r18       SEQUENCE {","paragraph_zero_based":45329},{"literal_text_all_w_t_and_m_t":"        absenceOfAnyOtherTechnology-r18         ENUMERATED {true}                                                   OPTIONAL, -- Need R","paragraph_zero_based":45330},{"literal_text_all_w_t_and_m_t":"        sl-FreqSelectionConfig-r18              SL-FreqSelectionConfig-r18                                          OPTIONAL, -- Need R","paragraph_zero_based":45331},{"literal_text_all_w_t_and_m_t":"        sl-SyncTxDisabled-r18                   ENUMERATED {true}                                                   OPTIONAL, -- Need R","paragraph_zero_based":45332},{"literal_text_all_w_t_and_m_t":"        sl-EnergyDetectionConfig-r18            CHOICE {","paragraph_zero_based":45333},{"literal_text_all_w_t_and_m_t":"            sl-MaxEnergyDetectionThreshold-r18      INTEGER (-85..-52),","paragraph_zero_based":45334},{"literal_text_all_w_t_and_m_t":"            sl-EnergyDetectionThresholdOffset-r18   INTEGER (-13..20)","paragraph_zero_based":45335}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["95d96794a2cc5d06ba07f8d420ee2e1e8d6e8f9932e5