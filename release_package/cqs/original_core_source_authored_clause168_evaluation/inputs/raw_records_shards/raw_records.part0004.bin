{"fields":{"filename":"R2-2403724.zip::R2-2403724_sdtAsn1Cr.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"–Paging","paragraph_zero_based":120},{"literal_text_all_w_t_and_m_t":"The Paging message is used for the notification of one or more UEs.","paragraph_zero_based":121},{"literal_text_all_w_t_and_m_t":"Signalling radio bearer: N/A","paragraph_zero_based":122},{"literal_text_all_w_t_and_m_t":"RLC-SAP: TM","paragraph_zero_based":123},{"literal_text_all_w_t_and_m_t":"Logical channel: PCCH","paragraph_zero_based":124},{"literal_text_all_w_t_and_m_t":"Direction: Network to UE","paragraph_zero_based":125},{"literal_text_all_w_t_and_m_t":"Paging message","paragraph_zero_based":126},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":127},{"literal_text_all_w_t_and_m_t":"-- TAG-PAGING-START","paragraph_zero_based":128},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":129},{"literal_text_all_w_t_and_m_t":"Paging ::=                          SEQUENCE {","paragraph_zero_based":130},{"literal_text_all_w_t_and_m_t":"    pagingRecordList                    PagingRecordList                                                        OPTIONAL, -- Need N","paragraph_zero_based":131},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension            OCTET STRING                                                            OPTIONAL,","paragraph_zero_based":132},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                Paging-v1700-IEs                                                        OPTIONAL","paragraph_zero_based":133},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":134},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":135},{"literal_text_all_w_t_and_m_t":"Paging-v1700-IEs ::=                SEQUENCE {","paragraph_zero_based":136},{"literal_text_all_w_t_and_m_t":"    pagingRecordList-v1700              PagingRecordList-v1700                                                  OPTIONAL, -- Need N","paragraph_zero_based":137},{"literal_text_all_w_t_and_m_t":"    pagingGroupList-r17                 PagingGroupList-r17                                                     OPTIONAL, -- Need N","paragraph_zero_based":138},{"literal_text_all_w_t_and_m_t":"    nonCriticalExtension                Paging-v1800-IEs                                                        OPTIONAL","paragraph_zero_based":139},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":140},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":141},{"literal_text_all_w_t_and_m_t":"Paging-v1800-IEs ::=                SEQUENCE {","paragraph_zero_based":142},{"literal_text_all_w_t_and_m_t":"    pagingRecordList-v1800              PagingRecordList-v1800                                                  OPTIONAL, -- Need N","paragraph_zero_based":143}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"a7fbbad25f5e61406c00d893a00048429d2f65e919559dad8207277498aaf84c","original_member_sha256":"326259c3d4e9adcd33421f2abacaa9ec944d0ccf157ae0fe09123bf12588c1c0","paragraph_ElementTree_utf8_XML_sha256":["80a89a7aa1f2abe8a9861867c79d16cb3c27d2e6f4bc1d6558042ba493842f08","f5adfe311f74c22dd2e476f1c84ef2f6a4298947551542f5a55a8ba594e86464","3684f2eb9eb339cd19788d5bebbff3b37976f370f52afac27a242da075fb9fc6","c2f1ca44f958633f0e57e3050fd9ebe10ad3d8fe4baa0448af359fa1928d4720","8dc89f27ca877af524011b1347c2a1a3970e0cab33f2685762b52af869b45b39","b282dc5611dfac83bd151627eb5a88718fa5c41a6672435eb51ad17ae9be738c","b70b750beae2b58d3b06d3a2702ef37310b94b81ef8b02f8bb97a25df2056c9c","3a9e960ae01284e6872ae2634d32bc4a21b0483d07a1376e65db2e6448f5676a","185f81ce543ec2ae78e1fd74cc188816bd290a33c8f57ca91a41c61d376a6be7","eff754640e47634ed0b58074324d050e88891b6301287dfe0c2823f7cf6d5285","cf01874d65f139b78cdb84aaa6cf416472bb1d611d07e8c1228e3273eafd8f11","5930e7377fbd