:19264},{"literal_text_all_w_t_and_m_t":"    cellId-index                            INTEGER (1..maxPLMN)","paragraph_zero_based":19265},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":19266},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19267},{"literal_text_all_w_t_and_m_t":"-- TAG-CELLACCESSRELATEDINFOEUTRA-5GC-STOP","paragraph_zero_based":19268},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":19269},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":19270},{"literal_text_all_w_t_and_m_t":"–CellAccessRelatedInfo-EUTRA-EPC","paragraph_zero_based":19271}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["9b3f7db6a555325d4ab92bbd6fa147ac5684ea6a07d580519f0deb4db4c87899","74d3469efb570447d94aaec0edf7a2a60427c968718c884df81ea7db7c1bf167","9afa339271d273ae8784c921291f1d4f55053a080a95b5159d5346878536d6a4","3ce2dbc4c8899829b9a5aa9231b75e0f8f72f652fa70e86f1a2fbf0cf663b61f","e5038cd9ff1fb350bff1cc75994173c39f2643a3e1bc0443a71016c8bfc393a9","0fbac0a02a341e002653773b4ec4542fe38bd795cc65172ea11d9e2487f20c5b","e6e5cbc004c290ce0aa7837f18cbfb749161add71e0fc428063f918817d22468","5daa64c3df05b32b2f458e87109661984e1821e0b72322c3385360f3d679d902","0f5402ee5e289587085bf470a3178129830565192ec44d5d4286159a53548bca","0038f8098a02d803d461db49d026791b270c6853e9367109dd0ee1e73815595d","209fbfe1f2b2094a49454db7fc2e9a6554319f6857b4b13bbd96656fc028f144","19e207712bcc4b223cc9ed716caed6dc708a9ad15e48e04afde145664c407d45","67f45fb651eab5744e9316efa0ad6a27781e1cfbadf4c68ac4d91e09728dc32f","a0991c26b28daa245dcfdba00ef7b78cfd18ffd4a8ded08023f98ec24de22f4b","e22b3ed9b610e87b95f32b658890275ad6945570a586d58f067dc3c209dd4b28","ebd92b6a140e5ffc7499a59a1789