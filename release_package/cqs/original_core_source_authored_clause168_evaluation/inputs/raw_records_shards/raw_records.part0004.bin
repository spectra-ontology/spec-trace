{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32592},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-START","paragraph_zero_based":32593},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32594},{"literal_text_all_w_t_and_m_t":"RNTI-Value ::=                      INTEGER (0..65535)","paragraph_zero_based":32595},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32596},{"literal_text_all_w_t_and_m_t":"-- TAG-RNTI-VALUE-STOP","paragraph_zero_based":32597},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32598},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32599},{"literal_text_all_w_t_and_m_t":"–RSRP-Range","paragraph_zero_based":32600},{"literal_text_all_w_t_and_m_t":"The IE RSRP-Range specifies the value range used in RSRP measurements and thresholds. For measurements, integer value for RSRP measurements is according to Table 10.1.6.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 156) dBm, except for the IE value 127, in which case the actual value is infinity.","paragraph_zero_based":32601},{"literal_text_all_w_t_and_m_t":"RSRP-Range information element","paragraph_zero_based":32602},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32603},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-START","paragraph_zero_based":32604},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32605},{"literal_text_all_w_t_and_m_t":"RSRP-Range ::=                      INTEGER(0..127)","paragraph_zero_based":32606},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32607},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRP-RANGE-STOP","paragraph_zero_based":32608},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":32609},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":32610},{"literal_text_all_w_t_and_m_t":"–RSRQ-Range","paragraph_zero_based":32611},{"literal_text_all_w_t_and_m_t":"The IE RSRQ-Range specifies the value range used in RSRQ measurements and thresholds. For measurements, integer value for RSRQ measurements is according to Table 10.1.11.1-1 in TS 38.133 [14]. For thresholds, the actual value is (IE value – 87) / 2 dB.","paragraph_zero_based":32612},{"literal_text_all_w_t_and_m_t":"RSRQ-Range information element","paragraph_zero_based":32613},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":32614},{"literal_text_all_w_t_and_m_t":"-- TAG-RSRQ-RANGE-START","paragraph_zero_based":32615}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["929c6b5510cfc1283b2e9410d742355cadc7aa5ecb858ce00f84280e15440ad5","52cd4d25291a83dd256265b20fe2f6621be8e19bff628da362b6c3fb709fad5a","647b9e6b4d478ef019184857834ecf90d3b3f86dbc8457f66760d9aeebf5cd80","08e87b6cea2ce4eaef8b4b75caa933b381fc70ea33409e4203b3f3fbed642c02","aa49be70b6ff3cb1955822c6c350f076075536b8969f719d76fd20498b9ae5e4","559808a4588a66cc6674fecdc700b99a8e4872167d09600522434bfb1f1d04e5","f48923d02f5a683af6e493f19e321f0ffcbacbcdca3986fe8f5b8c59d710d5d9","d304fb262fbb4e8dd39d0ec3d35d9e0ad5009ef216c038c0bb7ebad52d22b5e1","587018fdda398ee9082faeff2ce4f1934856b6eea124fa81af652c81486ca7e9","614d3a419c401750025d67dbb5370c78d299cead5b852d05af46a97cea4607a8","38616f3105e03bd75a00a6c089d628ed3fae016fe6cddd15102d6e97f12de8c9","821083b33148bc467d741dfbbfe8bb96f97281ea455ce941061b2bb4acbd33aa","216767477400beffe3b0e513c94a5d830ee2a8627271f16ee001c75eed7e2328","238e93da7641fbb7bf93726ca3ebf24b6d507d334574bdbe09e848ec3d8373e3","90a1304c2238ca0790eb003b966897db9a1398575