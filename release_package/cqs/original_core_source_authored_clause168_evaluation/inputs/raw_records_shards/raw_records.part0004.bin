{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23376},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23377},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23378},{"literal_text_all_w_t_and_m_t":"HighSpeedConfigFR2-r17 ::=  SEQUENCE {","paragraph_zero_based":23379},{"literal_text_all_w_t_and_m_t":"    highSpeedMeasFlagFR2-r17                    ENUMERATED {set1, set2}                       OPTIONAL,   -- Need R","paragraph_zero_based":23380},{"literal_text_all_w_t_and_m_t":"    highSpeedDeploymentTypeFR2-r17              ENUMERATED {unidirectional, bidirectional}    OPTIONAL,   -- Need R","paragraph_zero_based":23381},{"literal_text_all_w_t_and_m_t":"    highSpeedLargeOneStepUL-TimingFR2-r17       ENUMERATED {true}                             OPTIONAL,   -- Need R","paragraph_zero_based":23382},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":23383},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":23384},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23385},{"literal_text_all_w_t_and_m_t":"-- TAG-HIGHSPEEDCONFIG-STOP","paragraph_zero_based":23386},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":23387},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23388},{"literal_text_all_w_t_and_m_t":"HighSpeedConfig field descriptions","paragraph_zero_based":23389},{"literal_text_all_w_t_and_m_t":"HighSpeedDemodCA-Scell","paragraph_zero_based":23390},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancementCA-r17, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SCell.","paragraph_zero_based":23391},{"literal_text_all_w_t_and_m_t":"highSpeedDemodFlag","paragraph_zero_based":23392},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports demodulationEnhancement-r16, the UE shall apply the enhanced demodulation processing for HST-SFN joint transmission scheme with velocity up to 500km/h as specified in TS 38.101-4 [59]. This parameter only applies to SpCell.","paragraph_zero_based":23393},{"literal_text_all_w_t_and_m_t":"highSpeedDeploymentTypeFR2","paragraph_zero_based":23394},{"literal_text_all_w_t_and_m_t":"If the field is present, and field value is unidirectional, the UE shall assume uni-directional deployment or if field value is birectional the UE shall assume bidirectional deployment for FR2 up to 350km/h as specified in TS 38.133 [14].","paragraph_zero_based":23395},{"literal_text_all_w_t_and_m_t":"highSpeedLargeOneStepUL-TimingFR2","paragraph_zero_based":23396},{"literal_text_all_w_t_and_m_t":"If the field is present, large one step UE autonomous uplink transmit timing adjustment for FR2 up to 350km/h as specified in TS 38.133 [14] is enabled.","paragraph_zero_based":23397},{"literal_text_all_w_t_and_m_t":"highSpeedMeasCA-Scell","paragraph_zero_based":23398},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementCA-r17, the UE shall apply the enhanced RRM requirements to the serving frequency of SCell for carrier aggregation to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":23399}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["ea724d60d960db06f918613e848431034950e2b9fee0138797e080e6d9a55884","408aff7c8b6f148f160fc24b1a1c1033e8415e1c54363046841c1a8f4e5c2ee6","6745bc5abf7a2204946fba89425ecc0ee835a9a2405dbf37f3658d8438a36def","892c12df2f0a63f86b4284b65dfa1759e19c41a04977402e88e87c8444bc9325","2e5e01b6788f7fcd9e98d1d1896d78fa1e0d70470c9d49e64538bb5a4f64d9ec","bad0272d705281ab0b92276feddb34d5205e4753ceea2e94b649709ad05b696a","15562963c963851c258c57f3b72032528e824d2ec1283ab03241d7ae8799ca7b","8c2f3b81087731d7c0747612d6dc5756c6bd3d4fef81e31a4c639934c566d5c0","7253f4c3ce6dd69fa0ef65389c230a7dcd79d45bc17e8b4a50849999b055c827","8134f026dfb95da83848d3d42ce41b3f4c3f221e58ea596b319fd8b983d312de","459168e90cac5f1ea65e4c048a6530cc53fb695474d33abb184548e6b59b3430","e9e94d54f349da30971804156a1527e868252657d8bcebbfa62f78a37b6fe1ad","2aa3fae8b0b0603332f953fc011e520085e9f55efe89b6a7355d717b42562866","5a7394fa92a09764bbf31eeb1a9061697b290a6245999e0861d5b62444f8e871","e37c6200a0c89ea71127b32529f8df324c12b049a64528057605ac4b7ceeddb7","a78ebe009acf81ab1748891bc287eaf302682ac5a3b7c9240e3d126932ec2ebd","d4f9cfc0276a87bd75c0771683aacc0db0dbbf9152a8add35fa0a856b30fa096","a34a7e376442a26690d2900371286fd561dbf2f9d0ea04e05d1c7a2b2ce6a992","7b236afa21c058fc51b063ddb3fb3f8bf1f288d75e28c5c464fe9e37ca35c142","9ee75d5ba3ffd3dd02741599d30480940600bbbafc0eff4552fcf2fba5540270","233de57fd26fe72674d4be5716572e09a7bc3bcb22f6b419ce5790457ea85beb","1c47558a7bf25835813de047dc4e6a863d05f924cc711e37369d2937e8afb3bb","f9a8d04e16b908460cf19dccfd6354d1c023559e418679db538c0b69c8b8639b","7065fb7555e257609f29c0357ff888eae73df04a25ef6eb6fa9c978f9cbba1aa"],"paragraph_range_zero_based":[23376,23399],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx:p23376"}
{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlag","paragraph_zero_based":23400},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancement-r16, the UE shall apply the enhanced intra-NR and inter-RAT EUTRAN RRM requirements to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":23401},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports intraNR-MeasurementEnhancement-r16, the UE shall apply enhanced intra-NR RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":23402},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports interRAT-MeasurementEnhancement-r16, the UE shall apply enhanced inter-RAT EUTRAN RRM requirement to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":23403},{"literal_text_all_w_t_and_m_t":"This parameter only applies to the serving frequency of SpCell.","paragraph_zero_based":23404},{"literal_text_all_w_t_and_m_t":"highSpeedMeasFlagFR2","paragraph_zero_based":23405},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports ue-PowerClass-v1700 set to pc6, the UE shall apply enhanced intra-frequency RRM requirement to the serving frequency of SpCell to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14].","paragraph_zero_based":23406},{"literal_text_all_w_t_and_m_t":"If the field is present and the UE supports enhanced inter-frequency RRM requirements for FR2 HST in RRC_IDLE and RRC_INACTIVE, the UE shall apply enhanced inter-frequency RRM requirement to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14] in RRC_IDLE and RRC_INACTIVE.","paragraph_zero_based":23407},{"literal_text_all_w_t_and_m_t":"If the field is present for SpCell and the UE supports measEnhCAInterFreqFR2-r18, the UE shall apply enhanced inter-frequency RRM requirement to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14] in RRC_CONNECTED.","paragraph_zero_based":23408},{"literal_text_all_w_t_and_m_t":"If the field is present for SCell(s) and and the UE supports measEnhCAInterFreqFR2-r18, the UE shall apply enhanced intra-frequency RRM requirements to the serving frequency of the corresponding SCell to support high speed up to 350 km/h for FR2 as specified in TS 38.133 [14] in RRC_CONNECTED.","paragraph_zero_based":23409},{"literal_text_all_w_t_and_m_t":"The field value, set1 or set2, is applied as specified in TS38.133 [14].","paragraph_zero_based":23410},{"literal_text_all_w_t_and_m_t":"highSpeedMeasInterFreq","paragraph_zero_based":23411},{"literal_text_all_w_t_and_m_t":"If the field is present and UE supports measurementEnhancementInterFreq-r17, the UE shall apply the enhanced RRM requirements for inter-frequency measurement in RRC_CONNECTED to support high speed up to 500 km/h as specified in TS 38.133 [14].","paragraph_zero_based":23412},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23413},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":23414},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":23415},{"literal_text_all_w_t_and_m_t":"SCellOnly","paragraph_zero_based":23416},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SCell. It is absent otherwise.","paragraph_zero_based":23417},{"literal_text_all_w_t_and_m_t":"SpCellOnly","paragraph_zero_based":23418},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommonSIB or in the ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":23419},{"literal_text_all_w_t_and_m_t":"SpCellOnly2","paragraph_zero_based":23420},{"literal_text_all_w_t_and_m_t":"The field is optionally present, Need R, in ServingCellConfigCommon of an SpCell. It is absent otherwise.","paragraph_zero_based":23421},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":23422},{"literal_text_all_w_t_and_m_t":"–Hysteresis","paragraph_zero_based":23423}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["691d3e99327b5c3577f9d0a851927ff1e97704ac7a7d969ce0836f855c851bce","3c19c8f64cd493f2fc69ae3cbc1fda60894992a0898c779cc0a62ff35c4a40bf","a4064763204316a41e5c3530f054d76c27af52ad75e53ab88ab364d94c1fcf6f","5f253713d0022a2632f8e747ae726d5fb5736ad0f3371455048ce6c159ccafc8","7f507e4d74f177d664967feffded31239ebe5f9d3e1126b3625f92068a26bbab","e1afec5862312d9d5392ca9403fec32c164ed6c4b172abec234a8f7303fd9ae0","a8bbfe13a9b697ae590520d4530d99f8b39c41fe853ef9399fa1f24b0e451960","b6c48e0a628fd29cbd875bc8ac20b2aed09d1b159007e1df01ebdb6af017f6b6","2f07922809eda9a90f1fa49223d5d9efd4fd24f1c94af0bcd4ea6f9dbd4c89fb","34b2ccf6891075a38d76a0b2338fe4df0efab6270b59afb6b7b209171fc6b001","34fe016aca0bf757770714e79678b02ce39208faf0d6f14ff9d286f3e902f389","69275607cc05098b9431d700757d4a002dd1b3cd4b21cf7f659f5b1503a5806c","9cac21a57fdfc93268c534dc09e022d30885927cccdca4e4601b4ca20ee11efa","d28fdf9adaffc91cdbc2a8b15ed1f2e23209611d5872aaa41c68d0479442ac4a","de46d9bae8c0a31ed728793ac9a54252284a7a29ca6bc76407624b31feda9319","4e825c0cf2925a5fd7356c61f794773034c07b2475a34d61f5d41db3caf6db64","55b31c0c8b148aff965796f137cbd6d358b69457af37530fa3858a026000d7a6","b37a7ea21b663c3f24f5911c9c33cce4e614ffa257a618dfa076e0ebaff95f4a","b60dddd9ef4205e1c5fb5299f590c22505a8559c8326671e64e21ab0ceebcff2","9b8e8f3deb2fd244366aa6db7e5a87467607699e3b842dc6095fff8c962fc845","b8818b9e1f3844cb3fb9a60c9f8d