{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"This field indicates the NR anchor carrier frequency list, which can provide the NR sidelink positioning configurations.","paragraph_zero_based":17856},{"literal_text_all_w_t_and_m_t":"sl-PosOffsetDFN","paragraph_zero_based":17857},{"literal_text_all_w_t_and_m_t":"Indicates the timing offset for the UE to determine DFN timing when GNSS is used for timing reference. Value 1 corresponds to 0.001 milliseconds, value 2 corresponds to 0.002 milliseconds, and so on.","paragraph_zero_based":17858},{"literal_text_all_w_t_and_m_t":"sl-PosSSB-PriorityNR","paragraph_zero_based":17859},{"literal_text_all_w_t_and_m_t":"This field indicates the priority of NR sidelink SSB transmission and reception.","paragraph_zero_based":17860},{"literal_text_all_w_t_and_m_t":"sl-PosUE-SelectedConfig","paragraph_zero_based":17861},{"literal_text_all_w_t_and_m_t":"Indicates the configuration used for UE autonomous resource selection.","paragraph_zero_based":17862},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17863},{"literal_text_all_w_t_and_m_t":"–SIB24","paragraph_zero_based":17864},{"literal_text_all_w_t_and_m_t":"SIB24 contains the information required to acquire the multicast MCCH/MTCH configuration for MBS multicast reception in RRC_INACTIVE.","paragraph_zero_based":17865},{"literal_text_all_w_t_and_m_t":"SIB24 information element","paragraph_zero_based":17866},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":17867},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB24-START","paragraph_zero_based":17868},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17869},{"literal_text_all_w_t_and_m_t":"SIB24-r18 ::= SEQUENCE {","paragraph_zero_based":17870},{"literal_text_all_w_t_and_m_t":"    multicastMCCH-Config-r18       MCCH-Config-r17         OPTIONAL,  -- Need S","paragraph_zero_based":17871},{"literal_text_all_w_t_and_m_t":"    cfr-ConfigMCCH-MTCH-r18        CFR-ConfigMCCH-MTCH-r17 OPTIONAL,  -- Need S","paragraph_zero_based":17872},{"literal_text_all_w_t_and_m_t":"    lateNonCriticalExtension       OCTET STRING            OPTIONAL,","paragraph_zero_based":17873},{"literal_text_all_w_t_and_m_t":"    ...","paragraph_zero_based":17874},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":17875},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17876},{"literal_text_all_w_t_and_m_t":"-- TAG-SIB24-STOP","paragraph_zero_based":17877},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":17878},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":17879}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["e7f2d97066369561e0a2f49a87b1471bb54da51cdde818c518d410f06e6cb5d1","40a604342b0b614806bbfea34b0fc2ca40abaeb70a9969cefffa537f96d31af2","311cd4810829e17a3bed87c04f9894c799a1f8460b384fe22a9cfbac4c337ba5","5ddb565bf953bef17a5bb6c4df100d62ac7df8948e2f39ac7efc12cc6a5258ef","a9a1702c55036bfc2a8a357d3c1ae2689a94df6654fb0118f7b9648a42d929aa","4f272ce34cff4ff8f8399d63c79049cb66a7a3a0f8e10c7ef0220c2666d10fb4","6e182b437c85f14c418820bbd71347dbf8674202005985de119b0a3279b63614","f76211ac3d8b4b1892fb678af812912e0ed064bdedd990cb33cd5377943c431f","15d0f982c2a05f96216c40c95d721fa2bd774ceb5715c22bb799b9513abacfa1","711f4b81de0cbe393756b45a281487917bfe809da47723cd33c6792f0fb40e68","fdf2b5640b3b8488725e8f0738a398fc71bd08ce45edbfce21ad1271341bca2e","815a4189149f9b62b41c22c88c8f074dc927c895cfd7b17f9dab7decc239cd10","679fbe9d654ceb9f909ce87241d17c47ad09036015c5a26edc0a283304091d5b","728a93ab525936f3736f8dec2a1de8672