{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfig","paragraph_zero_based":44016},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving.","paragraph_zero_based":44017},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceConfigExt","paragraph_zero_based":44018},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preferred minimumSchedulingOffset value for cross-slot scheduling for power saving for SCS 480 kHz and/or 960 kHz.","paragraph_zero_based":44019},{"literal_text_all_w_t_and_m_t":"minSchedulingOffsetPreferenceProhibitTimer","paragraph_zero_based":44020},{"literal_text_all_w_t_and_m_t":"Prohibit timer for preferred minimumSchedulingOffset assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44021},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceReportingConfigFR2","paragraph_zero_based":44022},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistant information to inform gNB about the UE's preference on multi-Rx operation for FR2.","paragraph_zero_based":44023},{"literal_text_all_w_t_and_m_t":"multiRx-PreferenceReportingConfigFR2ProhibitTimer","paragraph_zero_based":44024},{"literal_text_all_w_t_and_m_t":"Prohibit timer for multi-Rx operation for FR2 reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44025},{"literal_text_all_w_t_and_m_t":"musim-CandidateBandList","paragraph_zero_based":44026},{"literal_text_all_w_t_and_m_t":"A list of bands for which the UE is requested to provide information on temporary restricted capabilities for MUSIM operation","paragraph_zero_based":44027},{"literal_text_all_w_t_and_m_t":"musim-GapAssistanceConfig","paragraph_zero_based":44028},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for gap preference.","paragraph_zero_based":44029},{"literal_text_all_w_t_and_m_t":"musim-GapPriorityAssistanceConfig","paragraph_zero_based":44030},{"literal_text_all_w_t_and_m_t":"Indicates the UE is allowed to provide MUSIM assistance information for gap(s) priority or MUSIM gaps keep preference.","paragraph_zero_based":44031},{"literal_text_all_w_t_and_m_t":"musim-GapProhibitTimer","paragraph_zero_based":44032},{"literal_text_all_w_t_and_m_t":"Prohibit timer for MUSIM assistance information reporting for gap preference.","paragraph_zero_based":44033},{"literal_text_all_w_t_and_m_t":"musim-LeaveAssistanceConfig","paragraph_zero_based":44034},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information for leaving RRC_CONNECTED for MUSIM purpose.","paragraph_zero_based":44035},{"literal_text_all_w_t_and_m_t":"musim-LeaveWithoutResponseTimer","paragraph_zero_based":44036},{"literal_text_all_w_t_and_m_t":"Indicates the timer for the UE to enter RRC_IDLE for MUSIM purpose as defined in clause 5.3.8.6.","paragraph_zero_based":44037},{"literal_text_all_w_t_and_m_t":"musim-ProhibitTimer","paragraph_zero_based":44038},{"literal_text_all_w_t_and_m_t":"Indicates the prohibit timer for UE temporary restricted capabilities for MUSIM operation. Value in milliseconds. Value ms0 means prohibit timer is set to 0 milliseconds, value ms10 means prohibit timer is set to 10 milliseconds and so on.","paragraph_zero_based":44039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["557039555ea7eb0db531fba7384dbc8eb99a35c4f5939177816acd593271a815","a2b559a6580e425450e49f65491d921986d322ae55b1a6a6913fe81f0e7c8f82","02c546e2970ff35b2a6fce698904a9750781b04654973dfd81815716ea3b520a","ff1206e2a5ac6a78788e88013d051e13b8779f8a1f0e09348741f9cb011e458e","638498439e86e0f0a858f5ffac1399717835f71ff04d0bee86a0a2238722a24c","9af5fe03284f6deefd17dea669727fe6fa4ebf5dc5f81fde907bf16b34b143c2","43cb9e10bf69b67982383276d438414c828e3c55fd20c65ee68458dc30a7484b","b4cb5994fa9d4e6e617088a0be9bf6349f5246c0dca31ac991e7121eb2a66a3e","a7ec558e80b12a518416074785f514cc6bc8772c91a18653b5061d8eb6551b3b","899cb1b21e21a4ef698dade47d195bccb85591a598a4436b1d2e87fb841e486c","dbfb22340e2534c9595a620049e3decf8c7702251f09c815d6a91d1b229caa95","1fe5a04dad88061903c1a1c74a28fd266fa09e6b3e79b36b9418df805d0d0711","ab840f7bf832664f72e7757d4fbc0fb62ef614326bfea5369c3017a92d9d0e84","f650583a1bdd98661b6a759a36a90ffe674153804fd8cb80c51a32dea15d5e24","cbbe62835a7d6be271f051a542f049d67557f4dfdc64a7c70f158fb8eb0c9e09","6e61c93f078c34610e9e8978161c34cee14c983190503802a3aa440ae41deece","8e14fb1fc447b2960da3bf1570a0d1f0e2fd126e4bd0ce4dc555eb25f5c7dd0d","29d8c20b10e73e179fcd13921f2f7d7b2fd859882430fd95136d778080ce74b1","52ccdfc04cbb9738616d41f9da5e42e76e3709259787228717c85f9e66ce0bc5","95fb392d53f13612626de04046f60be234e89f3638a14aba9f0e3bcf9b8e52d3","b1f4528912a1ff60b7ede124a82d6f4226a2115ba4d2779e7883f68632138d8e","70f26494c9be49257650cd0e4c98d068c4748b4d1897f3dba28008340133e3b7","7bd2c05ac086a4b01ecf6618ebb9bc8f4ba3bdbfd3ce7a3fdee2ca695052e35e","b4c54ab6af9251945ae618036873305b68ab330aa7c8bf84890af5f2009e137c"],"paragraph_range_zero_based":[44016,44039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p44016"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"musim-WaitTimer","paragraph_zero_based":44040},{"literal_text_all_w_t_and_m_t":"Indicates the wait timer for UE temporary restricted capabilities for MUSIM operation. Value in milliseconds. Value ms10 means wait timer is set to 10 milliseconds, value ms20 means wait timer is set to 20 milliseconds and so on.","paragraph_zero_based":44041},{"literal_text_all_w_t_and_m_t":"obtainCommonLocation","paragraph_zero_based":44042},{"literal_text_all_w_t_and_m_t":"Requests the UE to attempt to have detailed location information available using GNSS. NR configures the field if includeCommonLocationInfo is configured for one or more measurements.","paragraph_zero_based":44043},{"literal_text_all_w_t_and_m_t":"overheatingAssistanceConfig","paragraph_zero_based":44044},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about UE detected internal overheating.","paragraph_zero_based":44045},{"literal_text_all_w_t_and_m_t":"overheatingIndicationProhibitTimer","paragraph_zero_based":44046},{"literal_text_all_w_t_and_m_t":"Prohibit timer for overheating assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on.","paragraph_zero_based":44047},{"literal_text_all_w_t_and_m_t":"pdu-SessionsToReportUL-TrafficInfoList","paragraph_zero_based":44048},{"literal_text_all_w_t_and_m_t":"A list of PDU sessions for which the UE shall report UL traffic information.","paragraph_zero_based":44049},{"literal_text_all_w_t_and_m_t":"propDelayDiffReportConfig","paragraph_zero_based":44050},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report service link propagation delay difference between serving cell and neighbour cell(s).","paragraph_zero_based":44051},{"literal_text_all_w_t_and_m_t":"qfi-ToReportUL-TrafficInfoList","paragraph_zero_based":44052},{"literal_text_all_w_t_and_m_t":"A list of QFIs of a PDU session for which the UE shall report UL traffic information.","paragraph_zero_based":44053},{"literal_text_all_w_t_and_m_t":"referenceTimePreferenceReporting","paragraph_zero_based":44054},{"literal_text_all_w_t_and_m_t":"If present, the field indicates the UE is configured to provide reference time assistance information.","paragraph_zero_based":44055},{"literal_text_all_w_t_and_m_t":"releasePreferenceConfig","paragraph_zero_based":44056},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report assistance information to inform the gNB about the UE's preference to leave RRC_CONNECTED state.","paragraph_zero_based":44057},{"literal_text_all_w_t_and_m_t":"rlm-RelaxationReportingConfig","paragraph_zero_based":44058},{"literal_text_all_w_t_and_m_t":"Configuration for the UE to report the relaxation state of RLM measurements.","paragraph_zero_based":44059},{"literal_text_all_w_t_and_m_t":"releasePreferenceProhibitTimer","paragraph_zero_based":44060},{"literal_text_all_w_t_and_m_t":"Prohibit timer for release preference assistance information reporting. Value in seconds. Value s0 means prohibit timer is set to 0 seconds, value s0dot5 means prohibit timer is set to 0.5 seconds, value s1 means prohibit timer is set to 1 second and so on. Value infinity means that once a UE has reported a release preference, the UE cannot report a release preference again during the RRC connection.","paragraph_zero_based":44061},{"literal_text_all_w_t_and_m_t":"s-SearchDeltaP-Stationary","paragraph_zero_based":44062},{"literal_text_all_w_t_and_m_t":"Parameter \"SSearchDeltaP-StationaryConnected\" in 5.7.4.4. Value dB2 corresponds to 2 dB, dB3 corresponds to 3 dB and so on.","paragraph_zero_based":44063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["db612679ecd22d7dcd92c149075a382df0b814265600e8725ee8a5bf9345fbc8","bc37a815cd7555059fa6825b5f934db171a79bba0db31f572af1350cebfbf1b1","4b22e2f1ed49d2c216a50251b09a6f3b1b2258c4df53605765849f7810562da6","e62422720ccccdfdbaebd6158674f083ca37a04ac00ca8e4134d60ddf7cf4c09","336545ef29781e42c6c3ae002a05fcd47d29c8be5607e0c055970498070ee251","743c4e4bf4ab238ebc4b0133f3d5bffb2459b9fa6ad53c7aa5e165d16f517945","6da041b3f619681f4712c55a663284cd29a2bfa825e25b4d8fd81f5fcc03da22","f44b62ac21844028d50bcc3fd124871df908e77f86b41cbb637d7871d4b67d0a","760d9ed249e685631f0378d22b858d56ce62719fbb1c4450c4d726a9814ad025","48621747ed40d9c0edede70902381df43503b6129f32f62931771de0e92d4560","151cf8591bb3ff8a75fbc50397a28d1af9b1ada1aa2b6447daf66d9b5ce3c0c1","7e995c476c5f307f97eef32840173185457b5a62a06bdde44ac2fd5f42efdffa","6268c8daf619357f6487fabb81fed7963c4bc17c214e182ad18ddf1a45f58c1f","95f5bfd79c0307c3b53e9a9cdf91a9d93c75220c71309d2dfec35ab950cfc785","806e7fe2189aa62807ae8142c2896af1028fec67657dd596fc08f892e0e1ba3f","c371b617e9900dacc7db1e78fda82702332ae211674221347beb441bf07bf00c","d714f10a392043b6fa1a18ecdeea4cbd76e6696125f86063bc1df31c6ad776c6","4a6e6d64e32bf0e0419b2484fd49470f53c353a40b60270fae11cf4934f1356d","f7f5a1476ee54bf828f60f44792e0c65e276e626860c97c1dcd2a3f8fd12494e","bc3e27e9b741c9abdb86ab5072c0e1aa99d6396468b17a38a4fd4a44918289d1","0c99be42cb047f5781b96579090528de33735dd8132a6d604a992f601589d0ad","91ce6efaab861bcc75f62afe27c48556f0cbc994947398e20f7791c731d04a1a","a32217820f0d710daddd6d3e16967d5e29af160221e3736e661b110a2612788a","f616535be72b08e7fe1bf1ce1e986466a96c8eb349243f995d84df8ba553b36f"],"paragraph_range_zero_based":[44040,44063],"projection":"All w:t and m:t including tracked insertion/del