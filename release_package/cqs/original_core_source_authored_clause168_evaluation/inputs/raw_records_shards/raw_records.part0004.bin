{"fields":{"filename":"R2-2405601.zip::R2-2405601 Rapp CR for SL relay_update.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33288},{"literal_text_all_w_t_and_m_t":"–SemiStaticChannelAccessConfigUE","paragraph_zero_based":33289},{"literal_text_all_w_t_and_m_t":"The IE SemiStaticChannelAccessConfigUE is used to configure channel access parameters for UE initiated semi-static channel access.","paragraph_zero_based":33290},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE information element","paragraph_zero_based":33291},{"literal_text_all_w_t_and_m_t":"-- ASN1START","paragraph_zero_based":33292},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-START","paragraph_zero_based":33293},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33294},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE-r17 ::=    SEQUENCE {","paragraph_zero_based":33295},{"literal_text_all_w_t_and_m_t":"    periodUE-r17                               ENUMERATED {ms1, ms2, ms2dot5, ms4, ms5, ms10, spare2, spare1},","paragraph_zero_based":33296},{"literal_text_all_w_t_and_m_t":"    offsetUE-r17                               INTEGER (0..559)","paragraph_zero_based":33297},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":33298},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33299},{"literal_text_all_w_t_and_m_t":"-- TAG-SEMISTATICCHANNELACCESSCONFIGUE-STOP","paragraph_zero_based":33300},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":33301},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33302},{"literal_text_all_w_t_and_m_t":"SemiStaticChannelAccessConfigUE field descriptions","paragraph_zero_based":33303},{"literal_text_all_w_t_and_m_t":"periodUE","paragraph_zero_based":33304},{"literal_text_all_w_t_and_m_t":"Indicates the period of a channel occupancy that the UE can initiate as described in TS 37.213 [48], clause 4.3. Value ms1 corresponds to 1 ms, value ms2 corresponds to 2 ms, value ms2dot5 corresponds to 2.5 ms, and so on.","paragraph_zero_based":33305},{"literal_text_all_w_t_and_m_t":"offsetUE","paragraph_zero_based":33306},{"literal_text_all_w_t_and_m_t":"Indicates the number of symbols from the beginning of the even indexed radio frame to the start of the first period within that radio frame that the UE can initiate a channel occupancy (see TS 37.213 [48], clause 4.3), based on the smallest SCS among the configured SCSs in the serving cell. The offset duration indicated by this field is less than the period duration indicated by periodUE. The maximum value is 139, 279 and 559 for 15, 30 and 60 kHz subcarrier spacing, respectively.","paragraph_zero_based":33307},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":33308},{"literal_text_all_w_t_and_m_t":"–Sensor-LocationInfo","paragraph_zero_based":33309},{"literal_text_all_w_t_and_m_t":"The IE Sensor-LocationInfo is used by the UE to provide sensor information.","paragraph_zero_based":33310},{"literal_text_all_w_t_and_m_t":"Sensor-LocationInfo information element","paragraph_zero_based":33311}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["f6ad9ba90b7a3ea95bf8a2af4d635f67e15bea9f30d0bfec9294ef9c5fab0e06","9b0257143e0e22936e6885d39677e487b32ce339543539e7a4922b67adc2f427","25123530151b71c4f10d21aeae65cdb2c73f6352af5766b4e957ff94396f0bd4","ad1f7be25d83314300599eb2e669f03ff5ecd297f1ca364e653382e2444a5237","0c1953fedb64afce3d6d2b9f65f715bb8cf9565881966facc1eb2536bf05c1ae","909e612a1ceba143ef268228dc1d1185bdc912c629fe588149aa6815c2dda9f6","6d9c0a4b47fa73a6d71bb157ba157beeb2f1ce94b5830cda86f2