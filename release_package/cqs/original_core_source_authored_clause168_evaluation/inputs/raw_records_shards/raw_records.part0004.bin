l_w_t_and_m_t":"    tpc-IndexPCell                          INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-OfSpcell","paragraph_zero_based":29034},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-SCell                    INTEGER (1..15)                         OPTIONAL,   -- Cond PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":29035},{"literal_text_all_w_t_and_m_t":"    ...,","paragraph_zero_based":29036},{"literal_text_all_w_t_and_m_t":"    [[","paragraph_zero_based":29037},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sSCell-r17                             INTEGER (1..15)                         OPTIONAL,  -- Need R","paragraph_zero_based":29038},{"literal_text_all_w_t_and_m_t":"    tpc-IndexPUCCH-sScellSecondaryPUCCHgroup-r17          INTEGER (1..15)                         OPTIONAL   -- Cond twoPUCCHgroup","paragraph_zero_based":29039}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["55dd6c0731f077fd0583a548b0709973b49bcf9ae54b087b66eabae693109f83","c6aff0b10e2d74be416d1d3778d4c121e32c3b13fd751647784d429cf387c855","0ba39a137d60737e2bfdfac08770c30a02f0ce77a10a7422ccaad85c900d9d74","88fff8fcc1986c0892d8f6b69062f12c453007d6e11b924981ffbd8eaa166181","31d47d0e9b51b91e819972f991139c8296993d41a9e2c8ec97e870e47c66f884","64501ac4834513d3c3511a923ad18fd89090cfecc2fb8da108189ba919c9dbc5","6109de5f829692758c04d59467cc91e7b2ddbc6556722822a6ca4ab55a60c1bc","8470684fa106f587b3e5e47dc460d8b770343a3128c0aec01c62957e5cea8202","d43598317e98aa3b18514ba950a5f0b4e6accaf79dc1a2709d4156b35a1c90b5","be87876dce03bbb0f36f2b9fac1f4078fd4b0b5474cbf986fe8bccfd184fed29","3029a338f7f499db5a91d0add2379894dd9eca7afd08c178f7059c77748cfee0","c37a433852e65410b29210745792534f14fa5bf35ff91cdeb8177762fd690ff1","8fb0bf8f6397af01cc1ae725adf83d999f77821fe6360188829878ad4296a711","b351c8bcd502a169c578d60f257a74d7ff15ed3296eff39ed124ff41192c4988","8f57480cd7d36c346c4483fab9da766e0903be0105cb33aaa08fac45df4e8378","a0f9700dcea7758521af345bca811fb5e060bcbbd96a6aebf465047e50061919","82b980d2bbc067f78ab313424a40890dccc26304185582e0cd918d800b51fdc6","82ec6d01d9185f8a7231d1233087e34f63e8c3c7e2efc4809145e4b367a837e2","9bd7da77431b47bc0889426d39377b98d1b18cff6e6a8ef22ce857deb18e21bd","7410ee0406fa99d4330dd0fdfd7a22f9ee0c2961853c2ea7d3c0ec74b404d7f9","0a10e1c9e0cfd9210825a60f19a710ea675b681d0aaddf52add3b43e700c2858","ec5b914ee5226d915882c9ef666171401591fc08e411e6c8a889c9bf2e0bb3d4","5fbfd0b9fa21d141614bfa1cd7af817a89abcd560d73428669152a1b974bb39c","04ccb12c968fa643efd8cadefc37fd674432a15cf4c048c68bcd78f7fae55a5c"],"paragraph_range_zero_based":[29016,29039],"projection":"All w:t and m:t including tracked insertion/deletion runs; not a final-edit-state interpretation or answer annotation."},"source_row":"R2-2403537.zip::R2-2403537 RRC.docx:p29016"}
{"fields":{"filename":"R2-2403537.zip::R2-2403537 RRC.docx","origin":"original_author_document_complete_unfiltered_paragraph_projection","paragraphs":[{"literal_text_all_w_t_and_m_t":"    ]]","paragraph_zero_based":29040},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":29041},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29042},{"literal_text_all_w_t_and_m_t":"-- TAG-PUCCH-TPC-COMMANDCONFIG-STOP","paragraph_zero_based":29043},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":29044},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29045},{"literal_text_all_w_t_and_m_t":"PUCCH-TPC-CommandConfig field descriptions","paragraph_zero_based":29046},{"literal_text_all_w_t_and_m_t":"tpc-IndexPCell","paragraph_zero_based":29047},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the SpCell) inside the DCI format 2-2 payload.","paragraph_zero_based":29048},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-SCell","paragraph_zero_based":29049},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the PUCCH SCell) inside the DCI format 2-2 payload.","paragraph_zero_based":29050},{"literal_text_all_w_t_and_m_t":"tpc-IndexPUCCH-sSCell, tpc-IndexPUCCH-sSCellSecondaryPUCCHgroup","paragraph_zero_based":29051},{"literal_text_all_w_t_and_m_t":"An index determining the position of the first bit of TPC command (applicable to the alternative PUCCH cell for PUCCH cell switching) inside the DCI format 2-2 payload, for the primary PUCCH group and the secondary PUCCH group respectively.","paragraph_zero_based":29052},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":29053},{"literal_text_all_w_t_and_m_t":"Conditional Presence","paragraph_zero_based":29054},{"literal_text_all_w_t_and_m_t":"Explanation","paragraph_zero_based":29055},{"literal_text_all_w_t_and_m_t":"PDCCH-OfSpcell","paragraph_zero_based":29056},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell. Otherwise, the field is absent, Need R.","paragraph_zero_based":29057},{"literal_text_all_w_t_and_m_t":"PDCCH-ofSpCellOrPUCCH-SCell","paragraph_zero_based":29058},{"literal_text_all_w_t_and_m_t":"The field is mandatory present if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the PUCCH-SCell.","paragraph_zero_based":29059},{"literal_text_all_w_t_and_m_t":"The field is optionally present, need R, if the UE is configured with a PUCCH SCell in this cell group and if the PUCCH-TPC-CommandConfig is provided in the PDCCH-Config for the SpCell.","paragraph_zero_based":29060},{"literal_text_all_w_t_and_m_t":"Otherwise, the field is absent, Need R.","paragraph_zero_based":29061},{"literal_text_all_w_t_and_m_t":"twoPUCCHgroup","paragraph_zero_based":29062},{"literal_text_all_w_t_and_m_t":"This field is optionally present, Need R, if secondary PUCCH group is configured. It is absent otherwise.","paragraph_zero_based":29063}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"3766e0911ef1aaf617f1c44270e04d314f46e1ea6b971f374458ec068bbc9bb5","original_member_sha256":"0471885931db9d8903847ae27a7db1ede99f912460c3f55d37683308dfbebd05","paragraph_ElementTree_utf8_XML_sha256":["13f819de0888384d673d86beb3185f42af264ffe9189fe620038be9f689c2a28","3512baac2b05df1f66259ef165d009b80dcdd2d7ee9d9fd87b55a4d979615679","e95b3fa1d877d0eccccd0b76ff191dc0c3c62227155fbddc19664827dbc78338","7458a380ade52c634d67d3446667c23113372518baef245cf13273b49a586f93","1f6f741db74e316be4606987152c6215f26f157a21f4c0911ed20ca51d277863","e966dcd546fb0af21ede86eec1455dec4a1962e24b1ce18f0ab16e4bad8b9312","965c39f0d15caf02b79417a63881271d777ba769adfc87b4349d367de4f786f0","67b9c9b773e08c77de3c578156650be00943e921f7a67d60998a823a52cbbe9b","2016af45f3c20802ffd406309dec4aa