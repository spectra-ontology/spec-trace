         INTEGER (0..9)","paragraph_zero_based":26103},{"literal_text_all_w_t_and_m_t":"}","paragraph_zero_based":26104},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26105},{"literal_text_all_w_t_and_m_t":"-- TAG-MUSIM-GAPINFO-STOP","paragraph_zero_based":26106},{"literal_text_all_w_t_and_m_t":"-- ASN1STOP","paragraph_zero_based":26107},{"literal_text_all_w_t_and_m_t":"","paragraph_zero_based":26108},{"literal_text_all_w_t_and_m_t":"MUSIM-GapInfo field descriptions","paragraph_zero_based":26109},{"literal_text_all_w_t_and_m_t":"musim-GapLength","paragraph_zero_based":26110},{"literal_text_all_w_t_and_m_t":"Indicates the length of the UE's MUSIM gap as specified in TS 38.133 [14] clause 9.1.10. This field is mandatory present for both periodic gap and aperiodic gap preference indication.","paragraph_zero_based":26111}],"source":"Whole authentic original CR source member; all unfiltered body and nested table paragraphs"},"source_cell_coordinates":{"document_XML_sha256":"9d1d70d9256212d4b7dc322b4b9f040a9786df5e243754184d613f861ae930ed","original_member_sha256":"cf818f4a328fc82c7558ea21f216bee86ef70a3f095c39da9ef1e843f48973c6","paragraph_ElementTree_utf8_XML_sha256":["3c4c2b95645e5aa497233a849596baf893e2cb81e87bdd3c2fc400ab51dfb3c5","df3732cfcc5303fe2043ebb38e2bd8e1f68403aeca11d428f001853ab4f5d355","59928c6c792afd19374bec2e6b041624bd95b7f2d9c174e9fb43c60d3b4982f5","db7704623e19aacd08bc3155c4063fd275382f146673f1e9c83fb275ae739fbc","7e2a851cdf8bba4f1fc075231bc450bdb2a7d9a7e6d9d2b19f767315ff9e91b2","31c30bf34165d7320a2dc8f9dfabab9dd5e6db2be0e6a8f6bbcdfe0bdd5796f4","8316e4ee5a88c4e86d25c0c0c72686821876f68a240e7b956781d88d0841a8d1","e2e1160b44e97c7d5c755300fa1963e13679622830baaf868b3fb69d42696202","21ce6fdd28cd6858bdfde0382f25b780ce2eb64f2a5d16aa9062cd12dceff435","2ab7a1935a08e1c6fda7ae2f0ea97781cb15bf82579977b4f792b3750233cc47","1abc088f983b2223b61d87e3ea64e1fe76fe16fa6a2f74e9f699908f721d8742","2100b25f9c864376c1fdb82cd644cd3b1d6f66830a14252cdb58b75a452f15b8","