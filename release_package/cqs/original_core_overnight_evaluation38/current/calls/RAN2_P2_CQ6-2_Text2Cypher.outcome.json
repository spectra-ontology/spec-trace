  "content": "{\"query\":\"MATCH (m:Meeting)\\nOPTIONAL MATCH (res:Resolution)-[:MADE_AT]->(m)\\nWITH m, collect(DISTINCT res) AS resList\\nWITH m, size(resList) AS totalRes,\\n     size([r IN resList WHERE EXISTS {\\n       MATCH (r)-[:REFERENCES]->(d)-[:SUBMITTED_BY]->(c:Company)\\n       WHERE toLower(c.companyName) CONTAINS 'huawei'\\n          OR any(a IN (CASE WHEN c.aliases IS NULL THEN [] WHEN c.aliases='' THEN [] ELSE (CASE WHEN valueType(c.aliases)='LIST<STRING NOT NULL>' THEN c.aliases ELSE [c.aliases] END) END) WHERE toLower(a) CONTAINS 'huawei')\\n     }]) AS huaweiRes\\nWHERE totalRes > 0\\nRETURN m.canonicalMeetingNumber AS canonicalMeetingNumber,\\n       toFloat(huaweiRes)/totalRes AS ratio\\nORDER BY m.meetingNumberInt\",\"abstain\":false}",
