  "abstain": false,
  "generated_query": "WITH huawei AS (SELECT node_id FROM Company WHERE companyName='Huawei'), meeting_tdocs AS (SELECT m.canonicalMeetingNumber AS mnum, COUNT(DISTINCT p.src_id) AS total FROM rel_PRESENTED_AT p JOIN Meeting m ON m.node_id=p.dst_id JOIN rel_SUBMITTED_BY s ON s.src_id=p.src_id JOIN huawei h ON h.node_id=s.dst_id GROUP BY m.canonicalMeetingNumber), meeting_res AS (SELECT m.canonicalMeetingNumber AS mnum, COUNT(DISTINCT r.src_id) AS contrib FROM rel_REFERENCES r JOIN Resolution res ON res.node_id=r.src_id JOIN rel_MADE_AT ma ON ma.src_id=res.node_id JOIN Meeting m ON m.node_id=ma.dst_id JOIN rel_SUBMITTED_BY s ON s.src_id=r.dst_id JOIN huawei h ON h.node_id=s.dst_id GROUP BY m.canonicalMeetingNumber) SELECT mt.mnum AS canonicalMeetingNumber, CAST(COALESCE(mr.contrib,0) AS REAL)/mt.total AS ratio FROM meeting_tdocs mt LEFT JOIN meeting_res mr ON mr.mnum=mt.mnum WHERE mt.total>0 ORDER BY mt.mnum",
