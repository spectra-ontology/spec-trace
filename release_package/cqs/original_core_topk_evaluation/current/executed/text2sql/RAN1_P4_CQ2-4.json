  "generated_query": "WITH cr_spec AS (SELECT src_id AS cr_id, dst_id AS spec_id FROM rel_AFFECTS_CORE_SPEC UNION SELECT src_id, dst_id FROM rel_AFFECTS_OM_SPEC UNION SELECT src_id, dst_id FROM rel_AFFECTS_TEST_SPEC), cr_only AS (SELECT cr_id, spec_id FROM cr_spec WHERE cr_id IN (SELECT node_id FROM CR)), reach AS (SELECT cr_id, COUNT(DISTINCT spec_id) AS n FROM cr_only GROUP BY cr_id) SELECT c.\"tdocNumber\" AS \"cr.tdocNumber\", (SELECT json_group_array(sn) FROM (SELECT DISTINCT s.\"specNumber\" AS sn FROM cr_only co JOIN Spec s ON s.node_id=co.spec_id WHERE co.cr_id=r.cr_id)) AS affectedSpecs FROM reach r JOIN CR c ON c.node_id=r.cr_id WHERE r.n >= (SELECT MIN(n) FROM (SELECT n FROM reach ORDER BY n DESC LIMIT 10))",
