  "sql": "SELECT DISTINCT child.sectionId AS sectionId FROM Section parent JOIN edge own ON own.src_id=parent.node_id AND own.rel_type='BELONGS_TO_SPEC' JOIN Spec edition ON edition.node_id=own.dst_id JOIN edge family ON family.src_id=edition.node_id AND family.rel_type='IN_RELEASE_OF' JOIN Spec hub ON hub.node_id=family.dst_id JOIN edge direct ON direct.src_id=parent.node_id AND direct.rel_type='HAS_SUB_SECTION' JOIN Section child ON child.node_id=direct.dst_id WHERE hub.specRelease IS NULL AND hub.specNumber='38.214' AND parent.sectionNumber='5.1'",
