  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT m.canonicalMeetingNumber AS meetingNumber,\n                            m.meetingNumberInt AS meetingOrdinal,\n                            COUNT(DISTINCT CASE WHEN EXISTS (\n                              SELECT 1 FROM rel_MODERATED_BY mb\n                              JOIN Company co ON co.node_id=mb.dst_id\n                              WHERE mb.src_id=unit.node_id AND co.companyName='ZTE'\n                            ) THEN unit.node_id END) AS moderatorSummaryCount\n                     FROM Meeting m LEFT JOIN rel_MADE_AT ma ON ma.dst_id=m.node_id\n                     LEFT JOIN Summary unit ON unit.node_id=ma.src_id\n                     GROUP BY m.node_id ORDER BY meetingOrdinal ASC",
