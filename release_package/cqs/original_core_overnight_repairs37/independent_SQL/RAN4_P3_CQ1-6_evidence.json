  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT DISTINCT o.figureId AS figureId,o.figureNumber AS figureNumber,o.figureCaption AS figureCaption FROM Spec hub\nJOIN rel_IN_RELEASE_OF ir ON ir.dst_id=hub.node_id JOIN Spec edition ON edition.node_id=ir.src_id\nJOIN rel_BELONGS_TO_SPEC bs ON bs.dst_id=edition.node_id JOIN Section a ON a.node_id=bs.src_id\nJOIN rel_CONTAINS_FIGURE e ON e.src_id=a.node_id JOIN TSFigure o ON o.node_id=e.dst_id\nWHERE hub.specNumber='38.141-2' AND hub.specRelease IS NULL AND a.sectionNumber='J.3'\nORDER BY figureId\n",
