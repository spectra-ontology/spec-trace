  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT sp.specNumber AS specNumber, COUNT(DISTINCT cr.node_id) AS crCount\n                     FROM Resolution r JOIN rel_REFERENCES rr ON rr.src_id=r.node_id\n                     JOIN CR cr ON cr.node_id=rr.dst_id\n                     JOIN rel_MODIFIES cm ON cm.src_id=cr.node_id\n                     JOIN Spec sp ON sp.node_id=cm.dst_id\n                     GROUP BY sp.specNumber ORDER BY crCount DESC, specNumber ASC",
