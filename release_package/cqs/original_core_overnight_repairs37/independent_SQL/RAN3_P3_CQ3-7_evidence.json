  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT DISTINCT cr.tdocNumber FROM CR cr\n JOIN rel_MODIFIES m ON m.src_id=cr.node_id JOIN Spec hub ON hub.node_id=m.dst_id\n JOIN rel_TARGET_RELEASE tr ON tr.src_id=cr.node_id JOIN Release target ON target.node_id=tr.dst_id\n WHERE hub.specNumber='38.423' AND hub.specRelease IS NULL\n AND cr.clausesAffected IS NOT NULL AND trim(cr.clausesAffected)<>''\n AND EXISTS (SELECT 1 FROM rel_IN_RELEASE_OF ir JOIN Spec rk ON rk.node_id=ir.src_id\n JOIN rel_BELONGS_TO_SPEC bs ON bs.dst_id=rk.node_id JOIN Section s ON s.node_id=bs.src_id\n WHERE ir.dst_id=hub.node_id AND rk.specRelease=target.releaseName\n AND declaration_token_member(cr.clausesAffected,s.sectionNumber)=1)\n ORDER BY cr.tdocNumber",
