  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT DISTINCT o.sectionId AS sectionId,o.sectionNumber AS sectionNumber,o.sectionTitle AS sectionTitle FROM Spec hub\nJOIN rel_IN_RELEASE_OF ir ON ir.dst_id=hub.node_id JOIN Spec edition ON edition.node_id=ir.src_id\nJOIN rel_BELONGS_TO_SPEC bs ON bs.dst_id=edition.node_id JOIN Section a ON a.node_id=bs.src_id\nJOIN rel_REFERENCES_SECTION e ON e.src_id=a.node_id JOIN Section o ON o.node_id=e.dst_id\nWHERE hub.specNumber='38.101-1' AND hub.specRelease IS NULL AND a.sectionNumber='3.2'\nORDER BY sectionId\n",
