  "named_sample_sql": "SELECT c.tdocNumber,e.rel_type,s.specNumber FROM CR c\n             JOIN edge e ON e.src_id=c.node_id JOIN Spec s ON s.node_id=e.dst_id\n             WHERE c.tdocNumber=? AND e.rel_type IN ('AFFECTS_CORE_SPEC','AFFECTS_TEST_SPEC','AFFECTS_OM_SPEC')\n             ORDER BY e.rel_type,s.specNumber",
