  "sql_full_population": "SELECT DISTINCT cr.node_id, cr.tdocNumber, cr.type, cr.status,\n cr.crNumber, cr.crRevision, cr.clausesAffected, r.releaseName\nFROM CR cr JOIN rel_MODIFIES m ON m.src_id=cr.node_id\nJOIN Spec hub ON hub.node_id=m.dst_id\nLEFT JOIN rel_TARGET_RELEASE tr ON tr.src_id=cr.node_id\nLEFT JOIN Release r ON r.node_id=tr.dst_id\nWHERE hub.specNumber='38.423' AND hub.specRelease IS NULL\nORDER BY cr.tdocNumber, r.releaseName",
  "sql_Section_domain": "SELECT DISTINCT s.node_id,s.sectionNumber,s.sectionId,s.sectionTitle,\n rk.node_id AS retainedSpecNodeId,rk.specRelease,rk.specVersion\nFROM Section s JOIN rel_BELONGS_TO_SPEC b ON b.src_id=s.node_id\nJOIN Spec rk ON rk.node_id=b.dst_id JOIN rel_IN_RELEASE_OF ir ON ir.src_id=rk.node_id\nJOIN Spec hub ON hub.node_id=ir.dst_id\nWHERE hub.specNumber='38.423' AND hub.specRelease IS NULL\nORDER BY rk.specRelease,s.sectionId,s.node_id",
