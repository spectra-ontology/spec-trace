{
  "kind": "Independent frozen SQL natural identity/multiplicity source witness; no nativegold admission",
  "db_sha256_before": "8c4c23348e2d0861e8ecf11393eb01a65d2add247b3e5f0df68f093500d8ddfd",
  "db_sha256_after": "8c4c23348e2d0861e8ecf11393eb01a65d2add247b3e5f0df68f093500d8ddfd",
  "db_manifest_sha256": "083401646b5d4a2c32b06479ef9f22bea95d9df215bed266d35666088ce12032",
  "queries": [
    {
      "query": "SELECT sp.specNumber AS specNumber,count(DISTINCT cr.node_id) AS CRNodeCount,count(DISTINCT cr.tdocNumber) AS tdocIdentityCount,count(DISTINCT cr.id) AS crIdCount,count(DISTINCT sp.node_id) AS reachableSpecNodeCount,count(*) AS pathCount,sum(CASE WHEN cr.tdocNumber IS NULL THEN 1 ELSE 0 END) AS missingTdocIdentityPaths FROM Resolution r JOIN edge er ON er.src_id=r.node_id AND er.rel_type=\"REFERENCES\" JOIN CR cr ON cr.node_id=er.dst_id JOIN edge ec ON ec.src_id=cr.node_id AND ec.rel_type=\"MODIFIES\" JOIN Spec sp ON sp.node_id=ec.dst_id GROUP BY sp.specNumber ORDER BY CRNodeCount DESC,sp.specNumber",
      "sha256": "7dc93255930dda79a221862b30911f6024eaba9a580f03621c5ff4fad1e9e83b"
    },
    {
      "query": "SELECT DISTINCT sp.specNumber,sp.specRelease,sp.specVersion,n.source_iri FROM Resolution r JOIN edge er ON er.src_id=r.node_id AND er.rel_type=\"REFERENCES\" JOIN CR cr ON cr.node_id=er.dst_id JOIN edge ec ON ec.src_id=cr.node_id AND ec.rel_type=\"MODIFIES\" JOIN Spec sp ON sp.node_id=ec.dst_id JOIN _node_record n ON n.node_id=sp.node_id ORDER BY sp.specNumber,sp.specRelease",
      "sha256": "5fb16bd47d668ebd8944f8440e1ecd8808dbdfaaed96c21a7464c85634be6b2d"
    },
    {
      "query": "SELECT DISTINCT cr.node_id,cr.id,cr.tdocNumber,n.source_iri FROM Resolution r JOIN edge er ON er.src_id=r.node_id AND er.rel_type=\"REFERENCES\" JOIN CR cr ON cr.node_id=er.dst_id JOIN edge ec ON ec.src_id=cr.node_id AND ec.rel_type=\"MODIFIES\" JOIN Spec sp ON sp.node_id=ec.dst_id JOIN _node_record n ON n.node_id=cr.node_id WHERE sp.specNumber=\"38.300\" ORDER BY cr.tdocNumber",
      "sha256": "32ab7da51c08d1dffa520f358683f4d6b73a50658527c2c388121dd9cb938a82"
    }
  ],
