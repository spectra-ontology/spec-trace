    "schema_hybrid_family_and_edition_roles": {
      "source": {
        "path": "/home/sihyeon/workspace/spectra/ontology/schema/tdoc-ontology.ttl",
        "sha256": "c7e7fae6f87059bf5971c06c30d54aaef5ce87f18d5d732437f3ed668183cab9",
        "bytes": 71963
      },
      "line_range_1based": [
        149,
        153
      ],
      "literal_lines": [
        {
          "line": 149,
          "text": "    rdfs:comment \"3GPP Release version (e.g., Rel-18, Rel-19)\"@en ."
        },
        {
          "line": 150,
          "text": ""
        },
        {
          "line": 151,
          "text": "tdoc:Spec a owl:Class ;"
        },
        {
          "line": 152,
          "text": "    rdfs:label \"Specification\"@en ;"
        },
        {
          "line": 153,
          "text": "    rdfs:comment \"A 3GPP Technical Specification (TS) or Technical Report (TR). v4.1 (release-aware, hybrid) — a Spec exists in two roles. (1) ABSTRACT HUB: one node per specNumber (IRI tdoc:spec/{specNumber_}, e.g. tdoc:spec/38_211), no tdoc:specRelease; the stable target of release-blind document references — Tdoc/CR MODIFIES & AFFECTS_CORE_SPEC, TRImpact IMPACTS_SPEC/SPEC_IMPACTED_BY (a CR modifies 'the spec', not a single release). (2) RELEASE-KEYED: one node per (specNumber, release) (IRI tdoc:spec/{specNumber_}/{release}, e.g. tdoc:spec/38_211/Rel-15), carries tdoc:specInRelease + tdoc:specRelease + that release's specVersion; the parent of release-specific Sections (BELONGS_TO_SPEC/HAS_SECTION); linked to its hub via tdoc:inReleaseOf. This hybrid preserves release-blind reference edges intact (no re-keying) while giving each release's Sections a release-keyed parent. Pre-v4.0 had a single specNumber node (latest snapshot); v4.0 had only release-keyed nodes (broke hub references) — v4.1 restores the hub additively.\"@en ."
        }
      ]
    },
    "schema_release_blind_population": {
      "source": {
        "path": "/home/sihyeon/workspace/spectra/ontology/schema/tdoc-ontology.ttl",
        "sha256": "c7e7fae6f87059bf5971c06c30d54aaef5ce87f18d5d732437f3ed668183cab9",
        "bytes": 71963
      },
      "line_range_1based": [
        291,
        305
      ],
      "literal_lines": [
        {
          "line": 291,
          "text": "tdoc:inReleaseOf a owl:ObjectProperty, owl:FunctionalProperty ;"
        },
        {
          "line": 292,
          "text": "    rdfs:label \"in release of\"@en ;"
        },
        {
          "line": 293,
          "text": "    rdfs:comment \"v4.1 (release-aware, hybrid): links a RELEASE-KEYED Spec node (specNumber, release) to its ABSTRACT HUB Spec node (specNumber only). Functional: each release-keyed Spec belongs to exactly one hub. Lets release-blind references resolve to the hub while Sections attach to the release-keyed parent; release-blind aggregation CQs traverse hub ← inReleaseOf ← release-keyed → Section. Neo4j relation type IN_RELEASE_OF.\"@en ;"
        },
        {
          "line": 294,
          "text": "    rdfs:domain tdoc:Spec ;"
        },
        {
          "line": 295,
          "text": "    rdfs:range tdoc:Spec ."
        },
        {
          "line": 296,
          "text": ""
        },
        {
          "line": 297,
          "text": "tdoc:hasReleaseVariant a owl:ObjectProperty ;"
        },
        {
          "line": 298,
          "text": "    rdfs:label \"has release variant\"@en ;"
        },
        {
          "line": 299,
          "text": "    rdfs:comment \"v4.1 (release-aware, hybrid): inverse of tdoc:inReleaseOf — an ABSTRACT HUB Spec node to its RELEASE-KEYED variants (one per release present in the corpus). 0..* (a spec lacking a frozen final for some release has no variant there).\"@en ;"
        },
        {
          "line": 300,
          "text": "    rdfs:domain tdoc:Spec ;"
        },
        {
          "line": 301,
          "text": "    rdfs:range tdoc:Spec ;"
        },
        {
          "line": 302,
          "text": "    owl:inverseOf tdoc:inReleaseOf ."
        },
        {
          "line": 303,
          "text": ""
        },
        {
          "line": 304,
          "text": "tdoc:presentedAt a owl:ObjectProperty ;"
        },
        {
          "line": 305,
          "text": "    rdfs:label \"presented at\"@en ;"
        }
      ]
    },
