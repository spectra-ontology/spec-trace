  "source_sql": "WITH effects AS (SELECT src_id,dst_id FROM rel_AFFECTS_CORE_SPEC UNION ALL SELECT src_id,dst_id FROM rel_AFFECTS_TEST_SPEC UNION ALL SELECT src_id,dst_id FROM rel_AFFECTS_OM_SPEC) SELECT cr.node_id,cr.tdocNumber,COUNT(e.dst_id) AS edgeCount,COUNT(DISTINCT e.dst_id) AS targetNodeCount,COUNT(DISTINCT sp.specNumber) AS impactCount,SUM(CASE WHEN e.dst_id IS NOT NULL AND sp.specNumber IS NULL THEN 1 ELSE 0 END) AS missingTargetNumbers FROM CR cr LEFT JOIN effects e ON e.src_id=cr.node_id LEFT JOIN Spec sp ON sp.node_id=e.dst_id GROUP BY cr.node_id ORDER BY impactCount DESC,cr.tdocNumber ASC",
