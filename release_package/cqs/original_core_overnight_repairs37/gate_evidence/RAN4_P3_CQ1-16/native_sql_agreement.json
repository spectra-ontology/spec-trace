  "source_sql": "WITH domain AS (SELECT DISTINCT specNumber FROM Spec WHERE specNumber IS NOT NULL),\nsection_counts AS (SELECT p.specNumber,count(DISTINCT s.sectionId) AS n FROM Section s\n JOIN rel_BELONGS_TO_SPEC e ON e.src_id=s.node_id JOIN Spec p ON p.node_id=e.dst_id GROUP BY p.specNumber)\nSELECT d.specNumber AS specNumber,coalesce(c.n,0) AS sectionCount\nFROM domain d LEFT JOIN section_counts c ON c.specNumber=d.specNumber\nORDER BY sectionCount DESC,specNumber ASC\n",
