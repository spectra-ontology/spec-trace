  "source_sql": "WITH family AS (SELECT DISTINCT specNumber FROM Spec WHERE specNumber LIKE '38.5%'),\ncounts AS (SELECT p.specNumber,count(DISTINCT s.sectionId) AS n\n FROM Section s JOIN rel_BELONGS_TO_SPEC e ON e.src_id=s.node_id JOIN Spec p ON p.node_id=e.dst_id GROUP BY p.specNumber)\nSELECT f.specNumber AS specNumber,coalesce(c.n,0) AS sectionCount\nFROM family f LEFT JOIN counts c ON c.specNumber=f.specNumber\nORDER BY sectionCount DESC,specNumber ASC\n",
