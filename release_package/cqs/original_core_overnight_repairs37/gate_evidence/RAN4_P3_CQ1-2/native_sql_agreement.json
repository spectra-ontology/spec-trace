  "source_sql": "SELECT DISTINCT o.sectionId AS sectionId,o.sectionNumber AS sectionNumber,o.sectionTitle AS sectionTitle FROM Spec hub\nJOIN rel_IN_RELEASE_OF ir ON ir.dst_id=hub.node_id JOIN Spec edition ON edition.node_id=ir.src_id\nJOIN rel_BELONGS_TO_SPEC bs ON bs.dst_id=edition.node_id JOIN Section a ON a.node_id=bs.src_id\nJOIN rel_HAS_SUB_SECTION e ON e.src_id=a.node_id JOIN Section o ON o.node_id=e.dst_id\nWHERE hub.specNumber='38.133' AND hub.specRelease IS NULL AND a.sectionNumber='10.1'\nORDER BY sectionId\n",
