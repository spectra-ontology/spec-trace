  "source_sql": "SELECT DISTINCT s.sectionNumber AS sectionNumber,s.sectionTitle AS sectionTitle FROM Spec hub JOIN rel_IN_RELEASE_OF ir ON ir.dst_id=hub.node_id JOIN Spec rk ON rk.node_id=ir.src_id JOIN rel_BELONGS_TO_SPEC bs ON bs.dst_id=rk.node_id JOIN Section s ON s.node_id=bs.src_id WHERE hub.specNumber=? AND hub.specRelease IS NULL AND s.level=1 AND EXISTS (SELECT 1 FROM CR cr JOIN rel_MODIFIES e ON e.src_id=cr.node_id WHERE e.dst_id=hub.node_id)",
