  "source_sql": "WITH effects AS (SELECT src_id,dst_id FROM rel_AFFECTS_CORE_SPEC UNION ALL SELECT src_id,dst_id FROM rel_AFFECTS_TEST_SPEC UNION ALL SELECT src_id,dst_id FROM rel_AFFECTS_OM_SPEC) SELECT cr.tdocNumber AS tdocNumber,COUNT(DISTINCT sp.specNumber) AS impactCount FROM CR cr LEFT JOIN effects e ON e.src_id=cr.node_id LEFT JOIN Spec sp ON sp.node_id=e.dst_id GROUP BY cr.node_id ORDER BY impactCount DESC,tdocNumber ASC",
