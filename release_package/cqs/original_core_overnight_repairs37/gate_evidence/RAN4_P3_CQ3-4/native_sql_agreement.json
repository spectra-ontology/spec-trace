  "source_sql": "SELECT DISTINCT c.tdocNumber AS tdocNumber\nFROM CR c JOIN edge modifies ON modifies.src_id=c.node_id AND modifies.rel_type='MODIFIES'\nJOIN Spec hub ON hub.node_id=modifies.dst_id\nWHERE hub.specNumber='38.133' AND hub.specRelease IS NULL\nAND c.clausesAffected IS NOT NULL AND trim(c.clausesAffected)<>''\nAND (regexp('(?s)(?<![A-Za-z0-9.])4[.]2(?:[.][A-Za-z0-9]+)*(?![A-Za-z0-9]|[.][A-Za-z0-9])',trim(c.clausesAffected))\n OR chapter_range_contains(trim(c.clausesAffected),4))\nORDER BY tdocNumber",
