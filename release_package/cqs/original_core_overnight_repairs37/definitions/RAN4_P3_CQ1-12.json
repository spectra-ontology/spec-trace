{
  "id": "RAN4_P3_CQ1-12",
  "question_en": "List the sub-sections of section 6 in spec 38.101-1 (drilling into a clause).",
  "original_query": "MATCH (rk:Spec {specNumber:'38.101-1'})<-[:BELONGS_TO_SPEC]-(p:Section {sectionNumber:'6'}) WHERE rk.specRelease IS NOT NULL WITH p,rk ORDER BY toInteger(replace(rk.specRelease,'Rel-','')) DESC LIMIT 1 MATCH (p)-[:HAS_SUB_SECTION]->(c:Section) RETURN c.sectionId, c.sectionNumber, c.sectionTitle ORDER BY c.sectionNumber LIMIT 25",
  "reference_query": "MATCH (hub:Spec {specNumber: '38.101-1'})\nWHERE hub.specRelease IS NULL\nMATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)\nMATCH (anchor:Section {sectionNumber: '6'})-[:BELONGS_TO_SPEC]->(edition)\nMATCH (anchor)-[:HAS_SUB_SECTION]->(obj:Section)\nRETURN DISTINCT obj.sectionId AS sectionId, obj.sectionNumber AS sectionNumber, obj.sectionTitle AS sectionTitle\nORDER BY sectionId",
  "required_fields": [
    {
      "name": "sectionId",
      "type": "string",
