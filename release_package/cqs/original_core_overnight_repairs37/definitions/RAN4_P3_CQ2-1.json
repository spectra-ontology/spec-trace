{
  "id": "RAN4_P3_CQ2-1",
  "question_en": "List the sections referenced by section 3.2 of spec 38.101-1 (outbound cross-references).",
  "original_query": "MATCH (rk:Spec {specNumber:'38.101-1'})<-[:BELONGS_TO_SPEC]-(a:Section {sectionNumber:'3.2'}) WHERE rk.specRelease IS NOT NULL WITH a,rk ORDER BY toInteger(replace(rk.specRelease,'Rel-','')) DESC LIMIT 1 MATCH (a)-[:REFERENCES_SECTION]->(b:Section) RETURN b.sectionId, b.sectionTitle ORDER BY b.sectionNumber LIMIT 25",
  "reference_query": "MATCH (hub:Spec {specNumber: '38.101-1'})\nWHERE hub.specRelease IS NULL\nMATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)\nMATCH (anchor:Section {sectionNumber: '3.2'})-[:BELONGS_TO_SPEC]->(edition)\nMATCH (anchor)-[:REFERENCES_SECTION]->(obj:Section)\nRETURN DISTINCT obj.sectionId AS sectionId, obj.sectionNumber AS sectionNumber, obj.sectionTitle AS sectionTitle\nORDER BY sectionId",
  "required_fields": [
    {
      "name": "sectionId",
      "type": "string",
      "nullable": false,
      "source_column_or_expression": "sectionId"
    }
  ],
