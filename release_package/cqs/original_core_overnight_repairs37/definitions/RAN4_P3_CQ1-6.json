{
  "id": "RAN4_P3_CQ1-6",
  "question_en": "List the figures in section J.3 of spec 38.141-2 (locating test-setup figures).",
  "original_query": "MATCH (rk:Spec {specNumber:'38.141-2'})<-[:BELONGS_TO_SPEC]-(sec:Section {sectionNumber:'J.3'}) WHERE rk.specRelease IS NOT NULL WITH sec,rk ORDER BY toInteger(replace(rk.specRelease,'Rel-','')) DESC LIMIT 1 MATCH (sec)-[:CONTAINS_FIGURE]->(f:TSFigure) RETURN f.figureId, f.figureNumber, f.figureCaption ORDER BY f.figureNumber LIMIT 15",
  "reference_query": "MATCH (hub:Spec {specNumber: '38.141-2'})\nWHERE hub.specRelease IS NULL\nMATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)\nMATCH (anchor:Section {sectionNumber: 'J.3'})-[:BELONGS_TO_SPEC]->(edition)\nMATCH (anchor)-[:CONTAINS_FIGURE]->(obj:TSFigure)\nRETURN DISTINCT obj.figureId AS figureId, obj.figureNumber AS figureNumber, obj.figureCaption AS figureCaption\nORDER BY figureId",
  "required_fields": [
