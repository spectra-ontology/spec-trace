{
  "id": "RAN3_P3_CQ1-6",
  "question_en": "List the figures in section 8.7.5.2 of spec 38.413 (locating diagrams).",
  "original_query": "MATCH (rk:Spec {specNumber:'38.413'})<-[:BELONGS_TO_SPEC]-(sec:Section {sectionNumber:'8.7.5.2'}) WHERE rk.specRelease IS NOT NULL WITH sec,rk ORDER BY toInteger(replace(rk.specRelease,'Rel-','')) DESC LIMIT 1 MATCH (sec)-[:CONTAINS_FIGURE]->(f:TSFigure) RETURN f.figureId, f.figureNumber, f.figureCaption",
  "reference_query": "MATCH (hub:Spec {specNumber: '38.413'})\nWHERE hub.specRelease IS NULL\nMATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)\nMATCH (anchor:Section {sectionNumber: '8.7.5.2'})-[:BELONGS_TO_SPEC]->(edition)\nMATCH (anchor)-[:CONTAINS_FIGURE]->(obj:TSFigure)\nRETURN DISTINCT obj.figureId AS figureId, obj.figureNumber AS figureNumber, obj.figureCaption AS figureCaption\nORDER BY figureId",
  "required_fields": [
