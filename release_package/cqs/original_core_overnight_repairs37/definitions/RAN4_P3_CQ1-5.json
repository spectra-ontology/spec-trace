{
  "id": "RAN4_P3_CQ1-5",
  "question_en": "List the tables in section 9.2.5.1 of spec 38.133 (locating requirement tables).",
  "original_query": "MATCH (rk:Spec {specNumber:'38.133'})<-[:BELONGS_TO_SPEC]-(sec:Section {sectionNumber:'9.2.5.1'}) WHERE rk.specRelease IS NOT NULL WITH sec,rk ORDER BY toInteger(replace(rk.specRelease,'Rel-','')) DESC LIMIT 1 MATCH (sec)-[:CONTAINS_TABLE]->(t:TSTable) RETURN t.tableId, t.tableNumber, t.tableCaption ORDER BY t.tableNumber LIMIT 25",
  "reference_query": "MATCH (hub:Spec {specNumber: '38.133'})\nWHERE hub.specRelease IS NULL\nMATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)\nMATCH (anchor:Section {sectionNumber: '9.2.5.1'})-[:BELONGS_TO_SPEC]->(edition)\nMATCH (anchor)-[:CONTAINS_TABLE]->(obj:TSTable)\nRETURN DISTINCT obj.tableId AS tableId, obj.tableNumber AS tableNumber, obj.tableCaption AS tableCaption\nORDER BY tableId",
  "required_fields": [
    {
      "name": "tableId",
      "type": "string",
      "nullable": false,
      "source_column_or_expression": "tableId"
    }
