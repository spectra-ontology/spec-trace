{
  "status": "ACTUAL_SOURCE_PREFIX_DISCRIMINATOR_NOT_FINAL",
  "id": "RAN1_P2_CQ5-2",
  "original_English": "List the agreements on HARQ feedback (HARQ decisions).",
  "original_question_sha256": "8a259718825797e558c2d0dc1591b3ce83f32c2154e1225d31578302de0e2107",
  "original_query": "MATCH (a:Agreement)-[:MADE_AT]->(m:Meeting) WHERE a.content CONTAINS 'HARQ' AND a.content CONTAINS 'feedback' RETURN m.meetingNumber, a.resolutionId, a.content ORDER BY m.meetingNumberInt DESC LIMIT 10",
  "original_query_sha256": "297db46938dcdfcad9b146143bf66477b8b4b66eb141d4612ce580b30858d247",
  "original_benchmark_pin": {
    "bytes": 399565,
    "sha256": "8fca9e16b39b387590e04d44d6e2bb6aa2189e5ab1745d7b7729c431e18af2ef"
  },
  "SQL": "SELECT a.*,m.meetingNumber,m.meetingNumberInt FROM Agreement a\n    JOIN edge r ON r.src_id=a.node_id AND r.rel_type='MADE_AT' JOIN Meeting m ON m.node_id=r.dst_id\n    WHERE instr(a.content,'HARQ')>0 AND instr(a.content,'feedback')>0\n    ORDER BY m.meetingNumberInt DESC,a.resolutionId",
  "SQL_diagnostic_ID_order_not_original_requirement": true,
