    "status": "full_native_SQL_multiset_equal",
    "sql": "WITH affected AS (\n SELECT dst_id AS other_id, src_id AS cr_id FROM rel_AFFECTS_CORE_SPEC\n UNION SELECT dst_id,src_id FROM rel_AFFECTS_TEST_SPEC\n UNION SELECT dst_id,src_id FROM rel_AFFECTS_OM_SPEC\n)\nSELECT s.specNumber AS affectedSpec, COUNT(DISTINCT c.node_id) AS crCount\nFROM Spec s JOIN affected a ON a.other_id=s.node_id JOIN CR c ON c.node_id=a.cr_id\nWHERE s.specNumber IS NOT NULL AND s.specNumber<>'38.214'\nAND EXISTS (SELECT 1 FROM rel_MODIFIES m JOIN Spec main ON main.node_id=m.dst_id WHERE m.src_id=c.node_id AND main.specNumber='38.214')\nGROUP BY s.specNumber ORDER BY crCount DESC, affectedSpec ASC",
