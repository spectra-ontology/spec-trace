{
  "id": "RAN5_P3_CQ5-2",
  "question_en": "Show each company's CR contributions per RAN5 spec (contribution matrix).",
  "original_query": "MATCH (cr:CR)-[:SUBMITTED_BY]->(c:Company), (cr)-[:MODIFIES]->(sp:Spec) WHERE sp.specNumber STARTS WITH '38.5' WITH c.companyName AS company, sp.specNumber AS spec, count(cr) AS cnt ORDER BY cnt DESC RETURN company, spec, cnt LIMIT 10",
  "reference_query": "MATCH (dimension:Spec)\nWHERE dimension.specNumber STARTS WITH '38.5'\n  AND NOT dimension.specNumber STARTS WITH '38.591'\nWITH collect(DISTINCT dimension.specNumber) AS specNumbers\nMATCH (company:Company)\nUNWIND specNumbers AS specNumber\nOPTIONAL MATCH (company)<-[:SUBMITTED_BY]-(cr:CR)-[:MODIFIES]->(modified:Spec)\nWHERE modified.specNumber=specNumber\nRETURN company.companyName AS companyName,specNumber,count(DISTINCT cr) AS crCount\nORDER BY companyName ASC,specNumber ASC",
  "required_fields": [
    {
      "name": "companyName",
      "type": "string",
