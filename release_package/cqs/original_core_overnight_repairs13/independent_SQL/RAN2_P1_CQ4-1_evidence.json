  "sql": "SELECT DISTINCT t.tdocNumber AS tdocNumber, m.meetingNumberInt AS meetingNumberInt\nFROM Tdoc AS t\nJOIN rel_SUBMITTED_BY AS sb ON sb.src_id=t.node_id\nJOIN Company AS co ON co.node_id=sb.dst_id AND co.companyName='Samsung'\nJOIN rel_RELATED_TO AS rt ON rt.src_id=t.node_id\nJOIN WorkItem AS wi ON wi.node_id=rt.dst_id AND wi.workItemCode='NR_Mob_enh2-Core'\nJOIN rel_PRESENTED_AT AS pa ON pa.src_id=t.node_id\nJOIN Meeting AS m ON m.node_id=pa.dst_id\nORDER BY meetingNumberInt DESC, tdocNumber ASC",
