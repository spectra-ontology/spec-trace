  "status": "full_native_SQL_multiset_equal",
  "sql": "SELECT DISTINCT s.sectionId AS sectionId FROM Section s JOIN edge retained ON retained.dst_id=s.node_id AND retained.rel_type='HAS_SECTION' JOIN Spec edition ON edition.node_id=retained.src_id JOIN edge family ON family.src_id=edition.node_id AND family.rel_type='IN_RELEASE_OF' JOIN Spec hub ON hub.node_id=family.dst_id WHERE s.level=1 AND hub.specNumber='38.331' AND hub.specRelease IS NULL AND EXISTS (SELECT 1 FROM edge modification JOIN CR cr ON cr.node_id=modification.src_id WHERE modification.dst_id=hub.node_id AND modification.rel_type='MODIFIES')",
