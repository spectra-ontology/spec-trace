    {
      "id": "determining_formatting_properties",
      "official_url": "https://learn.microsoft.com/en-us/openspecs/office_file_formats/ms-doc/d8b66123-1a3d-4e06-94c5-5ab16e9b6417",
      "section": "2.4.6.6",
      "original_HTML_bytes": 49773,
      "original_HTML_sha256": "f449a684b9ae347bb47cb8a842bda46a1372b132d4b5da77b0047a4f37dea8b2",
      "used_rule_paraphrase": "Formatting begins with defaults; table current character style and matching conditional character branches precede paragraph/current character style and final direct character properties. STSHI additional initial modifiers concern font indices. This bounds the proof that all style strike operations are absent, without choosing an unobserved paragraph style.",
      "HTML_included": false
    },
    {
