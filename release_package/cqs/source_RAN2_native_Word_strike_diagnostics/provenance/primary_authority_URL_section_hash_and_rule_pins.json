      "original_HTML_sha256": "41eb88fcba2a82b3ece715159c88dc2d2386b285c90aea23c4da7b8813a13107",
      "used_rule_paraphrase": "Arrays are applied in documented order; later operations determine the same property unless a specific SPRM overrides that convention. The17CP witness has exactly one strike SPRM and no subsequent strike/reset/wrapper.",
      "HTML_included": false
    },
