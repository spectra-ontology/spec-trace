{
  "id": "RAN1_P2_CQ2-3",
  "status": "MINIMUM_ROLES_FIXED_APPROVAL_PREDICATE_UNSEALED",
  "original_EN": "List the agreements at meeting RAN1#115 that approved a CR (tracing spec-change decisions).",
  "original_Korean": {
    "id": "CQ2-3",
    "category": "CQ2_Tdoc-Resolution추적",
    "question": "RAN1#115 회의에서 CR이 승인된 Agreement 목록은? (Spec 변경 결정 추적)",
    "cypher": "MATCH (a:Agreement)-[:MADE_AT]->(m:Meeting {canonicalMeetingNumber: 'RAN1#115'}) WHERE a.content CONTAINS 'CR' AND (a.content CONTAINS 'agreed' OR a.content CONTAINS 'approved') RETURN a.resolutionId, a.content ORDER BY a.sequence LIMIT 15"
  },
  "original_query": "MATCH (a:Agreement)-[:MADE_AT]->(m:Meeting {meetingNumber: 'RAN1#115'}) WHERE a.content CONTAINS 'CR' AND (a.content CONTAINS 'agreed' OR a.content CONTAINS 'approved') RETURN a.resolutionId, a.content ORDER BY a.sequence, a.resolutionId LIMIT 15",
  "original_EN_sha256": "fd30d7b012ff14c3aaacd40729875c0a7555405d257f30eddeb6ead46490270d",
  "original_query_sha256": "ea329019f1021129d19ca9c2a5f3c3fccb2ae8b843c6b319f3898bc6d0329df7",
  "required_requested_output": {
    "columns": [
      "resolutionId"
    ],
    "types": {
      "resolutionId": "string"
    },
    "collection": "set_of_Agreement_identities",
    "content_is_retained_context_not_new_required_projection": true
  },
  "source_context": "Original RAN1 Phase2 Agreement population and documentary MADE_AT meeting provenance. Retain original content proxy and subtype; do not invent CR/Decision objects as Agreement records.",
  "approval_role": "CR approval is explicit EN/KO. No new final-only/numbered-only/plenary-ratification/enacted-TS/causal-effect requirement. Draft endorsement and TP-for-CR counterauthority must be tested separately, before final predicate selection.",
  "cardinality_authority": "Preserve original authored LIMIT15 repeated in retained Korean query. Design default10 explicitly permits query-time limit adjustment; no output-based selection.",
  "selection_order": "Preserve original sequence ASC,resolutionId ASC for selected membership. English List asks no separate serialization order.",
  "counterauthority": [
    "Original authored content CONTAINS CR AND agreed/approved is a direct operational implementation; it is retained and not silently redefined.",
    "Original design CQ2-3 is comeback rather than this validation question, and content row444 refers to comeback patterns; that row alone does not explicitly define CR approval.",
    "Original design excludes a different approved-CR object list as Annex-dependent. This question requests Agreement identities, so exclusion does not automatically make every Agreement approval trace unsupported.",
    "Original §8 preserves complete LLM context, not an extra obligation to reproduce all content/equations for an identity list.",
    "Original lexeme CR can be only CRC and approved can be conditional; this is a concrete predicate-role counterexample rather than evidence of missing raw data."
  ],
