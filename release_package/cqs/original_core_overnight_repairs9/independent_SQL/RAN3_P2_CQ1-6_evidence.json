{
  "id": "RAN3_P2_CQ1-6",
  "status": "PASS",
  "sql": "WITH qualified_Resolution AS (\n SELECT DISTINCT ref.src_id AS rid\n FROM Spec AS s\n JOIN rel_MODIFIES AS mod ON mod.dst_id=s.node_id\n JOIN Tdoc AS t ON t.node_id=mod.src_id\n JOIN rel_REFERENCES AS ref ON ref.dst_id=t.node_id\n WHERE s.specNumber='38.423'\n)\nSELECT DISTINCT r.resolutionId AS resolutionId,m.meetingNumberInt AS meetingNumberInt,a.agendaNumber AS agendaNumber,r.sequence AS sequence\nFROM qualified_Resolution AS q\nJOIN Resolution AS r ON r.node_id=q.rid\nJOIN rel_MADE_AT AS ma ON ma.src_id=r.node_id\nJOIN Meeting AS m ON m.node_id=ma.dst_id\nLEFT JOIN rel_RESOLUTION_BELONGS_TO AS belongs ON belongs.src_id=r.node_id\nLEFT JOIN AgendaItem AS a ON a.node_id=belongs.dst_id\nORDER BY m.meetingNumberInt DESC,(a.agendaNumber IS NULL) ASC,a.agendaNumber ASC,r.sequence ASC,r.resolutionId ASC;\n",
  "parameters": [],
  "columns": [
    "resolutionId",
    "meetingNumberInt",
    "agendaNumber",
    "sequence"
  ],
