  "source_sql": "SELECT DISTINCT r.resolutionId AS resolutionId, m.meetingNumberInt AS meetingNumberInt, r.sequence AS sequence\nFROM Meeting AS m\nJOIN rel_MADE_AT AS ma ON ma.dst_id=m.node_id\nJOIN Resolution AS r ON r.node_id=ma.src_id\nJOIN rel_REFERENCES AS ref ON ref.src_id=r.node_id\nJOIN Tdoc AS t ON t.node_id=ref.dst_id\nWHERE t.tdocNumber='R2-2500064'\nORDER BY m.meetingNumberInt DESC,r.sequence ASC;\n",
