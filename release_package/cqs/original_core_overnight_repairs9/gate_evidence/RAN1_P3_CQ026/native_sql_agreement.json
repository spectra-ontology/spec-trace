  "source_sql": "SELECT DISTINCT a.resolutionId AS resolutionId\nFROM Agreement AS a\nWHERE a.hasTBD=1 AND EXISTS (\n  SELECT 1 FROM rel_REFERENCES AS ref\n  JOIN CR AS cr ON cr.node_id=ref.dst_id\n  JOIN rel_MODIFIES AS mod ON mod.src_id=cr.node_id\n  JOIN Spec AS s ON s.node_id=mod.dst_id\n  WHERE ref.src_id=a.node_id AND s.specNumber='38.213'\n);\n",
