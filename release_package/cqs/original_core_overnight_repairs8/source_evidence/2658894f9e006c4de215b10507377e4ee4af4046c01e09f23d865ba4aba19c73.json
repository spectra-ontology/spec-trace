  "original_six_questions": {
    "RAN3_P2_CQ3-1": {
      "id": "RAN3_P2_CQ3-1",
      "question_en": "Return how many of ZTE's TDocs led to resolutions (contribution effectiveness).",
      "original_query": "MATCH (t:Tdoc)-[:SUBMITTED_BY]->(c:Company {companyName: 'ZTE'}) OPTIONAL MATCH (r:Resolution)-[:REFERENCES]->(t) RETURN count(DISTINCT t) AS totalTdocs, count(DISTINCT r) AS resolutionLinkedTdocs"
    },
    "RAN3_P2_CQ3-3": {
      "id": "RAN3_P2_CQ3-3",
      "question_en": "Rank the main contributors to spec 38.423 (spec-ownership analysis).",
      "original_query": "MATCH (r:Resolution)-[:REFERENCES]->(t:Tdoc)-[:MODIFIES]->(s:Spec {specNumber: '38.423'}) MATCH (t)-[:SUBMITTED_BY]->(c:Company) RETURN c.companyName, count(DISTINCT t) AS cnt ORDER BY cnt DESC, c.companyName ASC LIMIT 10"
    },
    "RAN3_P2_CQ6-2": {
      "id": "RAN3_P2_CQ6-2",
      "question_en": "Show ZTE's resolution-contribution trend over time (influence trajectory).",
      "original_query": "MATCH (r:Resolution)-[:REFERENCES]->(t:Tdoc)-[:SUBMITTED_BY]->(c:Company {companyName: 'ZTE'}) MATCH (r)-[:MADE_AT]->(m:Meeting) RETURN m.canonicalMeetingNumber, m.meetingNumberInt AS mNum, count(DISTINCT r) AS cnt ORDER BY mNum ASC"
    },
    "RAN4_P2_CQ3-1": {
      "id": "RAN4_P2_CQ3-1",
      "question_en": "What share of Samsung's TDocs led to resolutions? (contribution success rate).",
      "original_query": "MATCH (t:Tdoc)-[:SUBMITTED_BY]->(c:Company {companyName: 'Samsung'}) OPTIONAL MATCH (r:Resolution)-[:REFERENCES]->(t) RETURN count(DISTINCT t) AS totalTdocs, count(DISTINCT r) AS resolutionLinkedTdocs"
    },
    "RAN4_P2_CQ3-3": {
      "id": "RAN4_P2_CQ3-3",
      "question_en": "Rank the leading contributors to spec 38.133 (key contributors to a spec).",
      "original_query": "MATCH (r:Resolution)-[:REFERENCES]->(t:Tdoc)-[:MODIFIES]->(s:Spec {specNumber: '38.133'}) MATCH (t)-[:SUBMITTED_BY]->(c:Company) RETURN c.companyName, count(DISTINCT t) AS cnt ORDER BY cnt DESC, c.companyName ASC LIMIT 10"
    },
    "RAN4_P2_CQ6-2": {
      "id": "RAN4_P2_CQ6-2",
      "question_en": "Show how Samsung's resolution contributions evolved over time (contributor trend).",
      "original_query": "MATCH (r:Resolution)-[:REFERENCES]->(t:Tdoc)-[:SUBMITTED_BY]->(c:Company {companyName: 'Samsung'}) MATCH (r)-[:MADE_AT]->(m:Meeting) RETURN m.canonicalMeetingNumber, m.meetingNumberInt AS mNum, count(DISTINCT r) AS cnt ORDER BY mNum ASC"
    }
  },
