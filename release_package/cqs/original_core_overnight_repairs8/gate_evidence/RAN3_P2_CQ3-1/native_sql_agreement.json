  "source_sql": "SELECT count(*) AS resolutionLinkedTdocCount\nFROM (\n  SELECT DISTINCT ref.dst_id\n  FROM rel_REFERENCES AS ref\n  JOIN Resolution AS r ON r.node_id=ref.src_id\n  JOIN rel_SUBMITTED_BY AS sub ON sub.src_id=ref.dst_id\n  JOIN Company AS c ON c.node_id=sub.dst_id\n  JOIN Tdoc AS t ON t.node_id=ref.dst_id\n  WHERE c.companyName='ZTE'\n) AS distinct_qualified_Tdoc;\n",
