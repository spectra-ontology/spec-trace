{
  "sql": "WITH sections AS (SELECT sp.specNumber,count(DISTINCT s.node_id) AS section_count FROM Spec sp JOIN rel_BELONGS_TO_SPEC e ON e.dst_id=sp.node_id JOIN Section s ON s.node_id=e.src_id GROUP BY sp.specNumber), crs AS (SELECT sp.specNumber,count(DISTINCT cr.node_id) AS cr_count FROM Spec sp JOIN rel_MODIFIES e ON e.dst_id=sp.node_id JOIN CR cr ON cr.node_id=e.src_id GROUP BY sp.specNumber) SELECT sp.specNumber,coalesce(sections.section_count,0) AS section_count,coalesce(crs.cr_count,0) AS cr_count FROM (SELECT DISTINCT specNumber FROM Spec) sp LEFT JOIN sections ON sections.specNumber=sp.specNumber LEFT JOIN crs ON crs.specNumber=sp.specNumber ORDER BY sp.specNumber",
