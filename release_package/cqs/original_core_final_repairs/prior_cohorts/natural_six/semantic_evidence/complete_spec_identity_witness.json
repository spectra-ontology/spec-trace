  "source_role_documentation": {
    "file": "scripts/tsg/RAN/formal/RAN3/phase-3/neo4j/01_load_ts_structure.py",
    "sha256": "2c9226c3d8591064210cfa4eea1667cd428f2b065b08cfb909c560572ce340cf",
    "source_passage": "# ---------------------------------------------------------------------------\ndef load_release_spec_nodes(session, extensions: list[dict]) -> tuple[int, int, int]:\n    \"\"\"Create release-keyed Spec nodes linked to their abstract hub.\n\n    Per TTL v4.1.0 (release-aware hybrid): one Spec node per (specNumber, release)\n    carrying specRelease + specVersion + SPEC_IN_RELEASE \u2192 Release, linked via\n    IN_RELEASE_OF to the pre-existing abstract hub (specNumber only, specRelease\n    IS NULL). The hub and its release-blind reference edges are NOT modified.\n    Runs BEFORE sections so BELONGS_TO_SPEC can MATCH the release-keyed parent.",
    "scope": "Current implementation documentation corroborates the measured IN_RELEASE_OF hub roles; this is not a verified historical producer version or raw-document coverage claim."
  }
