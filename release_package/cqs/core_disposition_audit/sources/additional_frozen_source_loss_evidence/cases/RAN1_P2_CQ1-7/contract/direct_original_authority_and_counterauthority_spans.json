            {
              "line": 455,
              "text": "    def _extract_content("
            },
            {
              "line": 456,
              "text": "        self,"
            },
            {
              "line": 457,
              "text": "        paragraphs: list,"
            },
            {
              "line": 458,
              "text": "        start_index: int,"
            },
            {
              "line": 459,
              "text": "        end_index: int"
            },
            {
              "line": 460,
              "text": "    ) -> str:"
            },
            {
              "line": 461,
              "text": "        \"\"\"Extract and join content paragraphs + embedded tables."
            },
            {
              "line": 462,
              "text": ""
            },
            {
              "line": 463,
              "text": "        Spec §3.1: content 필드 — 수식을 [EQUATION] 마커로 대체 (검색/쿼리용)"
            },
            {
              "line": 464,
              "text": ""
            },
            {
              "line": 465,
              "text": "        Body-aware extraction: paragraph 범위 사이에 끼어있는 w:tbl도"
            },
            {
              "line": 466,
              "text": "        pipe-delimited 텍스트로 변환하여 포함. body_children이 없으면"
            },
            {
              "line": 467,
              "text": "        기존 paragraph-only 로직으로 fallback."
            },
            {
              "line": 468,
              "text": "        \"\"\""
            },
            {
              "line": 469,
              "text": "        content_parts = []"
            },
            {
              "line": 470,
              "text": "        tbl_tag = f'{{{_W_NS}}}tbl'"
            },
            {
              "line": 471,
              "text": "        p_tag = f'{{{_W_NS}}}p'"
            },
            {
              "line": 472,
              "text": ""
            },
            {
              "line": 473,
              "text": "        if self._body_children and start_index in self._para_to_body:"
            },
            {
              "line": 474,
              "text": "            # Body-aware: paragraph 범위에 대응하는 body 구간 순회"
            },
            {
              "line": 475,
              "text": "            body_start = self._para_to_body[start_index]"
            },
            {
              "line": 476,
              "text": "            body_end = self._para_to_body.get(end_index, len(self._body_children))"
            },
            {
              "line": 477,
              "text": ""
            },
            {
              "line": 478,
              "text": "            # para_idx 매핑을 역산: body_idx → para_idx"
            },
            {
              "line": 479,
              "text": "            body_to_para: dict[int, int] = {}"
            },
            {
              "line": 480,
              "text": "            for pi, bi in self._para_to_body.items():"
            },
            {
              "line": 481,
              "text": "                body_to_para[bi] = pi"
            },
            {
              "line": 482,
              "text": ""
            },
            {
              "line": 483,
              "text": "            for body_idx in range(body_start, body_end):"
            },
            {
              "line": 484,
              "text": "                child = self._body_children[body_idx]"
            },
            {
              "line": 485,
              "text": "                if child.tag == p_tag:"
            },
            {
              "line": 486,
              "text": "                    para_idx = body_to_para.get(body_idx)"
            },
            {
              "line": 487,
              "text": "                    if para_idx is not None and para_idx < len(paragraphs):"
            },
            {
              "line": 488,
              "text": "                        if build_text_with_markers:"
            },
            {
              "line": 489,
              "text": "                            text = build_text_with_markers("
            },
            {
              "line": 490,
              "text": "                                paragraphs[para_idx]._element"
            },
            {
              "line": 491,
              "text": "                            ).strip()"
            },
            {
              "line": 492,
              "text": "                        else:"
            },
            {
              "line": 493,
              "text": "                            text = paragraphs[para_idx].text.strip()"
            },
            {
              "line": 494,
              "text": "                        if text:"
            },
            {
              "line": 495,
              "text": "                            content_parts.append(text)"
            },
            {
              "line": 496,
              "text": "                elif child.tag == tbl_tag:"
            },
            {
              "line": 497,
              "text": "                    table_text = self._table_to_text(child)"
            },
            {
              "line": 498,
              "text": "                    if table_text:"
            },
            {
              "line": 499,
              "text": "                        content_parts.append(table_text)"
            },
            {
              "line": 500,
              "text": "        else:"
            },
            {
              "line": 501,
              "text": "            # Fallback: 기존 paragraph-only 로직 (DOCM 또는 body_map 미지원)"
            },
            {
              "line": 502,
              "text": "            for idx in range(start_index, end_index):"
            },
            {
              "line": 503,
              "text": "                if build_text_with_markers:"
            },
            {
              "line": 504,
              "text": "                    text = build_text_with_markers(paragraphs[idx]._element).strip()"
            },
            {
              "line": 505,
              "text": "                else:"
            },
            {
              "line": 506,
              "text": "                    text = paragraphs[idx].text.strip()"
            },
            {
              "line": 507,
              "text": "                if text:"
            },
            {
              "line": 508,
              "text": "                    content_parts.append(text)"
            },
            {
              "line": 509,
              "text": ""
            },
            {
              "line": 510,
              "text": "        return '\\n'.join(content_parts)"
            }
          ]
        }
