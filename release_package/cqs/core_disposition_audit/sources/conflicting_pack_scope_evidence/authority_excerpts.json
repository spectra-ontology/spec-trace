          "line": 74,
          "text": "                records = list(result)"
        },
        {
          "line": 75,
          "text": ""
        },
        {
          "line": 76,
          "text": "                if len(records) > 0:"
        },
        {
          "line": 77,
          "text": "                    status = \"PASS\""
        },
        {
          "line": 78,
          "text": "                    pass_count += 1"
        },
        {
          "line": 79,
          "text": "                else:"
        },
        {
          "line": 80,
          "text": "                    status = \"NO_DATA\""
        },
        {
          "line": 81,
          "text": "                    no_data_count += 1"
        },
        {
          "line": 82,
          "text": ""
        },
        {
          "line": 83,
          "text": "                sample = None"
        },
        {
          "line": 84,
          "text": "                if records:"
        },
        {
          "line": 85,
          "text": "                    sample = serialize_value(dict(records[0]))"
        },
        {
          "line": 86,
          "text": ""
        },
        {
          "line": 87,
          "text": "                entry = {"
        },
        {
          "line": 88,
          "text": "                    \"id\": cq_id,"
        },
        {
          "line": 89,
          "text": "                    \"category\": category,"
        },
        {
          "line": 90,
          "text": "                    \"question\": question,"
        },
        {
          "line": 91,
          "text": "                    \"status\": status,"
        },
        {
          "line": 92,
          "text": "                    \"row_count\": len(records),"
        },
        {
          "line": 93,
          "text": "                    \"sample\": sample,"
        },
        {
          "line": 94,
          "text": "                }"
        }
      ]
