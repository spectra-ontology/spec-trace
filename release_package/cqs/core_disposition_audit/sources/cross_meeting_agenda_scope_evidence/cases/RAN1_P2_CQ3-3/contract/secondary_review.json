  "actual_ROOT_independent_generic_edge_SQL": "SELECT c.node_id,c.companyName,COUNT(DISTINCT a.node_id) AS contributionCount\nFROM Company c JOIN edge cb ON cb.dst_id=c.node_id AND cb.rel_type='SUBMITTED_BY'\nJOIN Tdoc t ON t.node_id=cb.src_id JOIN edge ar ON ar.dst_id=t.node_id AND ar.rel_type='REFERENCES'\nJOIN Agreement a ON a.node_id=ar.src_id JOIN edge ab ON ab.src_id=a.node_id AND ab.rel_type='RESOLUTION_BELONGS_TO'\nJOIN AgendaItem ai ON ai.node_id=ab.dst_id WHERE {predicate} GROUP BY c.node_id ORDER BY contributionCount DESC",
