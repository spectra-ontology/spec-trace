    "status": "full_native_SQL_multiset_equal",
    "sql": "SELECT DISTINCT target.specNumber AS specNumber,\n       creation.impactType AS impactType, report.trNumber AS trNumber\nFROM Spec target\nJOIN rel_IMPACTS_SPEC produced ON produced.dst_id=target.node_id\nJOIN TRImpact creation ON creation.node_id=produced.src_id\nJOIN rel_HAS_TR_IMPACT owned ON owned.dst_id=creation.node_id\nJOIN TechnicalReport report ON report.node_id=owned.src_id\nWHERE creation.impactType='NewTS' AND report.trNumber='38.769'\nORDER BY impactType ASC NULLS LAST,trNumber ASC NULLS LAST",
