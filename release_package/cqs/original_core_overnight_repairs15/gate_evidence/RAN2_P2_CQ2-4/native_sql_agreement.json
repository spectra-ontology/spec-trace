  "source_sql": "SELECT DISTINCT sp.specNumber AS specNumber\nFROM Spec AS sp\nWHERE EXISTS (\n  SELECT 1 FROM edge AS modifies\n  JOIN Tdoc AS t ON t.node_id = modifies.src_id\n  WHERE modifies.dst_id = sp.node_id AND modifies.rel_type = 'MODIFIES'\n    AND t.status = 'agreed'\n    AND EXISTS (\n      SELECT 1 FROM edge AS presented\n      JOIN Meeting AS m ON m.node_id = presented.dst_id\n      WHERE presented.src_id = t.node_id AND presented.rel_type = 'PRESENTED_AT'\n        AND m.canonicalMeetingNumber = 'RAN2#132'\n    )\n)\n",
