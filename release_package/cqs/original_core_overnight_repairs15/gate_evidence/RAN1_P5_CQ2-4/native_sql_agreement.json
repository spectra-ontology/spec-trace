    "status": "full_native_SQL_multiset_equal",
    "sql": "WITH exact_impacts(node_id) AS (\n SELECT DISTINCT impact.node_id\n FROM Spec target\n JOIN rel_IMPACTS_SPEC modifies ON modifies.dst_id=target.node_id\n JOIN TRImpact impact ON impact.node_id=modifies.src_id\n WHERE target.specNumber='38.211'\n   AND EXISTS (\n     SELECT 1 FROM Section endpoint\n     JOIN rel_IMPACTS_SECTION clause ON clause.dst_id=endpoint.node_id\n     WHERE clause.src_id=impact.node_id\n       AND endpoint.sectionNumber='8' AND endpoint.sectionId LIKE '38.211-%')\n)\nSELECT DISTINCT report.trNumber AS trNumber, impact.impactType AS impactType\nFROM exact_impacts selected\nJOIN TRImpact impact ON impact.node_id=selected.node_id\nJOIN rel_HAS_TR_IMPACT owns ON owns.dst_id=impact.node_id\nJOIN TechnicalReport report ON report.node_id=owns.src_id\nORDER BY impactType ASC NULLS LAST,trNumber ASC NULLS LAST",
    "parameters": [],
    "columns": [
      "trNumber",
      "impactType"
    ],
