    "status": "full_native_SQL_multiset_equal",
    "sql": "SELECT DISTINCT t.tdocNumber AS tdocNumber, m.meetingNumberInt AS meetingNumberInt, a.agendaNumber AS agendaNumber FROM Company c JOIN rel_SUBMITTED_BY sb ON sb.dst_id=c.node_id JOIN Tdoc t ON t.node_id=sb.src_id JOIN rel_PRESENTED_AT pa ON pa.src_id=t.node_id JOIN Meeting m ON m.node_id=pa.dst_id LEFT JOIN rel_BELONGS_TO bt ON bt.src_id=t.node_id LEFT JOIN AgendaItem a ON a.node_id=bt.dst_id WHERE c.companyName='Samsung' ORDER BY m.meetingNumberInt DESC, (a.agendaNumber IS NULL) ASC, a.agendaNumber COLLATE BINARY ASC, t.tdocNumber COLLATE BINARY ASC",
