  "sql": "SELECT DISTINCT cr.tdocNumber AS tdocNumber,m.meetingNumberInt AS meetingNumberInt,\n CASE WHEN substr(lower(m.canonicalMeetingNumber),-3)='bis' THEN 1 ELSE 0 END AS meetingBisOrdinal,\n cr.crNumber AS crNumber\n FROM Spec sp JOIN rel_MODIFIES e ON e.dst_id=sp.node_id\n JOIN CR cr ON cr.node_id=e.src_id\n JOIN rel_PRESENTED_AT p ON p.src_id=cr.node_id JOIN Meeting m ON m.node_id=p.dst_id\n WHERE sp.specNumber='38.133'\n ORDER BY meetingNumberInt DESC,meetingBisOrdinal DESC,(crNumber IS NULL) ASC,crNumber COLLATE BINARY ASC,tdocNumber COLLATE BINARY ASC",
