  "sql": "SELECT DISTINCT cr.tdocNumber AS tdocNumber,m.meetingNumberInt AS meetingNumberInt,\n CASE WHEN m.meetingNumber REGEXP '^RAN1#[0-9]+b(-e)?$' THEN 1 ELSE 0 END AS meetingBisOrdinal,\n cr.crNumber AS crNumber\n FROM Spec sp JOIN rel_MODIFIES e ON e.dst_id=sp.node_id\n JOIN CR cr ON cr.node_id=e.src_id JOIN rel_PRESENTED_AT p ON p.src_id=cr.node_id\n JOIN Meeting m ON m.node_id=p.dst_id WHERE sp.specNumber='38.213'\n ORDER BY meetingNumberInt DESC,meetingBisOrdinal DESC,(crNumber IS NULL) ASC,crNumber COLLATE BINARY ASC",
