  "sql": "WITH RECURSIVE\n target_cr(node_id) AS (\n   SELECT DISTINCT typed.node_id FROM Spec target\n   JOIN rel_MODIFIES changes ON changes.dst_id=target.node_id\n   JOIN CR typed ON typed.node_id=changes.src_id\n   WHERE target.specNumber='38.211'\n ),\n related_resolution(node_id) AS (\n   SELECT DISTINCT typed.node_id FROM target_cr target\n   JOIN rel_REFERENCES cited ON cited.dst_id=target.node_id\n   JOIN Resolution typed ON typed.node_id=cited.src_id\n ),\n ordinal_tail(node_id,tail) AS (\n   SELECT node_id,resolutionId FROM Resolution\n   UNION ALL\n   SELECT node_id,substr(tail,instr(tail,'-')+1)\n   FROM ordinal_tail WHERE instr(tail,'-')>0\n ),\n original_ordinal(node_id,sequence) AS (\n   SELECT node_id,CAST(tail AS INTEGER) FROM ordinal_tail WHERE instr(tail,'-')=0\n )\n SELECT DISTINCT resolution.resolutionId AS resolutionId,\n   meeting.meetingNumberInt AS meetingNumberInt,\n   COALESCE(resolution.sequence,ordinal.sequence) AS sequence\n FROM related_resolution selected\n JOIN Resolution resolution ON resolution.node_id=selected.node_id\n JOIN original_ordinal ordinal ON ordinal.node_id=resolution.node_id\n JOIN rel_MADE_AT occurred ON occurred.src_id=resolution.node_id\n JOIN Meeting meeting ON meeting.node_id=occurred.dst_id\n ORDER BY meetingNumberInt DESC,sequence ASC,resolutionId ASC",
  "parameters": [],
  "columns": [
    "resolutionId",
    "meetingNumberInt",
    "sequence"
  ],
