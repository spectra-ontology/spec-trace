  "question_en": "List the 20 most recent CRs modifying TS 38.213 (recent changes).",
  "reference_query": "MATCH (cr:CR)-[:MODIFIES]->(:Spec {specNumber: '38.213'})\nMATCH (cr)-[:PRESENTED_AT]->(m:Meeting)\nWITH DISTINCT cr, m.meetingNumberInt AS meetingNumberInt,\n  CASE WHEN m.meetingNumber =~ 'RAN1#[0-9]+b(-e)?' THEN 1 ELSE 0 END AS meetingBisOrdinal\nRETURN DISTINCT cr.tdocNumber AS tdocNumber, meetingNumberInt, meetingBisOrdinal, cr.crNumber AS crNumber\nORDER BY meetingNumberInt DESC, meetingBisOrdinal DESC, crNumber ASC",
