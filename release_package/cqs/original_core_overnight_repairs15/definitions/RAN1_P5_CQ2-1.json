  "question_en": "Did the Ambient IoT study (TR 38.769) create any new TS? If so, which TS and what impact type?",
  "original_query": "MATCH (tr:TechnicalReport {trNumber: '38.769'})-[:HAS_TR_IMPACT]->(ti:TRImpact)-[:IMPACTS_SPEC]->(sp:Spec) RETURN tr.trNumber, tr.trTitle, ti.impactType, sp.specNumber, ti.impactDescription",
  "reference_query": "MATCH (tr:TechnicalReport {trNumber:'38.769'})-[:HAS_TR_IMPACT]->(impact:TRImpact {impactType:'NewTS'})-[:IMPACTS_SPEC]->(spec:Spec)\nRETURN DISTINCT spec.specNumber AS specNumber, impact.impactType AS impactType, tr.trNumber AS trNumber\nORDER BY impactType ASC, trNumber ASC",
