  "question_en": "List the top 10 CRs that modify spec 38.133 (recent changes to the spec).",
  "original_query": "MATCH (cr:CR)-[:MODIFIES]->(sp:Spec {specNumber: '38.133'}) RETURN cr.tdocNumber, cr.title ORDER BY cr.tdocNumber DESC LIMIT 10",
  "reference_query": "MATCH (cr:CR)-[:MODIFIES]->(:Spec {specNumber: '38.133'})\nMATCH (cr)-[:PRESENTED_AT]->(meeting:Meeting)\nWITH DISTINCT cr, meeting\nRETURN cr.tdocNumber AS tdocNumber,\n       meeting.meetingNumberInt AS meetingNumberInt,\n       CASE WHEN toLower(meeting.canonicalMeetingNumber) ENDS WITH 'bis' THEN 1 ELSE 0 END AS meetingBisOrdinal,\n       cr.crNumber AS crNumber\nORDER BY meetingNumberInt DESC, meetingBisOrdinal DESC, crNumber ASC, tdocNumber ASC",
