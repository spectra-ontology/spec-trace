  "id": "RAN1_P2_CQ3-2",
  "unchanged_original_English": "How many of Samsung's TDocs fed into agreements, and what share? (contribution performance)",
  "unchanged_original_Korean_record": {
    "id": "CQ3-2",
    "category": "CQ3_회사기여도",
    "question": "Samsung이 Agreement에 기여한 Tdoc 수와 비율은? (표준 기여 성과 분석)",
    "cypher": "MATCH (c:Company {companyName: 'Samsung'})<-[:SUBMITTED_BY]-(t:Tdoc) WITH c, count(t) AS totalTdocs OPTIONAL MATCH (a:Agreement)-[:REFERENCES]->(t2:Tdoc)-[:SUBMITTED_BY]->(c) WITH c, totalTdocs, count(DISTINCT t2) AS agreementLinkedTdocs, count(DISTINCT a) AS agreementCount RETURN c.companyName, totalTdocs, agreementLinkedTdocs, agreementCount, round(100.0 * agreementLinkedTdocs / totalTdocs, 1) AS contributionRate"
  },
