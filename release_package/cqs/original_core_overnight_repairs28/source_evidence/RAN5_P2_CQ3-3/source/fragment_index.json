    "source_marker": {
      "meeting": 78,
      "w_p_ordinal": 4545,
      "marker_text": "following conclusion:",
      "marker_XML_sha256_ET_default": "940f7fa7f6ddbb3cb69c22dbc493c47c574a5397d88d4cf4134b3b346698f880",
      "own_text": "The CR is solely based on the justification of aligning test signalling value with network deployment value. RAN5 does allow such alignment on a case by case basis provided the proposed value is conformant to the core specifications as well it is a common deployment value, i.e. agreeable to all interested Carriers active in RAN5. Concerns about proposed change deviating from RAN4 core requirements have been raised in the responses to the RAN5 Chair, which were not fully convincing. From one of the responses received, it was advised the proposed value is not agreeable to a Carrier who has interest in B41 HP UE. This Carrier would like to see more discussions in RAN5 before reaching an agreement.\nSince the proposed value is not agreeable to all Carriers interested in B41 HP UE, RAN5 is not in a position to agree CR-4562 in R5-181652 in this meeting. Recommendation from the RAN5 Chair to Sprint is to continue offline discussions and try to reach agreement before RAN5#79 meeting.",
      "literal_Tdoc_ids": [
        "R5-181652"
      ],
      "boundary_ordinal": 4548,
      "boundary_reason": "document_Decision_field",
      "boundary_text": "Decision: \t\tThe document was rejected.\n\n",
      "nearby": [
        {
          "ordinal": 4542,
          "text": "Sprint: is confident there is no deviation, and respectfully reminds that the CR does not propose any change to any requirement from any core specification. The requirement for maximum output power & requirement for configured UE transmitted output power remain the same.",
          "XML_sha256_ET_default": "15ce900cda7337b64ede34459a8e11dd4800cc1ff0d3345dc3d114ac2e7b83bc"
        },
        {
          "ordinal": 4543,
          "text": "Rejected.",
          "XML_sha256_ET_default": "296c9108eb4b4c270ccb800c66b1eed23dbe9e19dd8620ec7e7e9ef2ae231d3a"
        },
        {
          "ordinal": 4544,
          "text": "Conclusion:",
          "XML_sha256_ET_default": "002cc3c7df7319023fd648764872ab7b2739f6e5b1c315332ac126d495247c4f"
        },
        {
          "ordinal": 4545,
          "text": "following conclusion:",
          "XML_sha256_ET_default": "940f7fa7f6ddbb3cb69c22dbc493c47c574a5397d88d4cf4134b3b346698f880"
        },
        {
          "ordinal": 4546,
          "text": "The CR is solely based on the justification of aligning test signalling value with network deployment value. RAN5 does allow such alignment on a case by case basis provided the proposed value is conformant to the core specifications as well it is a common deployment value, i.e. agreeable to all interested Carriers active in RAN5. Concerns about proposed change deviating from RAN4 core requirements have been raised in the responses to the RAN5 Chair, which were not fully convincing. From one of the responses received, it was advised the proposed value is not agreeable to a Carrier who has interest in B41 HP UE. This Carrier would like to see more discussions in RAN5 before reaching an agreement.",
          "XML_sha256_ET_default": "01137b684c549d38181a9c78b8fcdf87959d549cbb6d5461f277f4c02f311c0e"
        },
        {
          "ordinal": 4547,
          "text": "Since the proposed value is not agreeable to all Carriers interested in B41 HP UE, RAN5 is not in a position to agree CR-4562 in R5-181652 in this meeting. Recommendation from the RAN5 Chair to Sprint is to continue offline discussions and try to reach agreement before RAN5#79 meeting.",
          "XML_sha256_ET_default": "efb1c6650b995844b1b2e55e1b668ed8c538566f3b5bc745e989939f54a6a927"
        },
        {
          "ordinal": 4548,
          "text": "Decision: \t\tThe document was rejected.\n\n",
          "XML_sha256_ET_default": "1b29d550ae27b6a0055adfde965321fcf5e5d877b95197dd20fc63b8798aa263"
        },
        {
          "ordinal": 4549,
          "text": "R5-180742\tMinimum conformance requirements update for spurious emission band UE co-existence for CA (editorial)",
          "XML_sha256_ET_default": "992b28cdddb1cc84ecb61a31560189c6e4b0143815a6fceb2ed74f35d9a101be"
        },
        {
          "ordinal": 4550,
          "text": "\t\t\t\t\tType: CR\t\tFor: Agreement\n\t\t\t\t\t36.521-1 v15.0.0\t  CR4044  Cat: F (Rel-15)\n\t\t\t\t\tSource: CETECOM GmbH",
          "XML_sha256_ET_default": "d7342e1e8072e0e3bd73a9aada560ff38e92a9502fcac907cf7225c389c083e5"
        }
      ]
    },
    "own_Tdoc_header": {
