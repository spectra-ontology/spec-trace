      "context": [
        {
          "paragraph": 4531,
          "text": "R5-181652\tBand 41 HPUE Maximum Output Power",
          "xml_sha256_ET_default": "8a73d80f0decf68a0b873ec47a4531e2e8253cda28857bea2e0b2aa5f9548e6b"
