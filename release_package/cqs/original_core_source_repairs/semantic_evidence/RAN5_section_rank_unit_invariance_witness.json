  "sql_queries": [
    "SELECT sp.specNumber,sp.specRelease,count(DISTINCT s.node_id) AS nodeCount,count(DISTINCT s.sectionNumber) AS logicalNumberCount FROM Spec sp LEFT JOIN rel_BELONGS_TO_SPEC e ON e.dst_id=sp.node_id LEFT JOIN Section s ON s.node_id=e.src_id GROUP BY sp.specNumber,sp.specRelease ORDER BY sp.specNumber,sp.specRelease",
    "SELECT sp.specNumber,count(DISTINCT s.sectionNumber) AS logicalNumberCount FROM Spec sp LEFT JOIN rel_BELONGS_TO_SPEC e ON e.dst_id=sp.node_id LEFT JOIN Section s ON s.node_id=e.src_id GROUP BY sp.specNumber"
