  "semantic_evidence": [
    {
      "finding": "List the tables requests table identities. Nonnull tableId identifies each recorded release-aware object; caption, number, Section identity, edition and source XML may be explanatory context but are not new required answer roles. Existing source-enriched canonical required tableId/set/all remains the exact unchanged original definition.",
      "original_quote": "List the tables in section 9.2.5.1 of spec 38.133 (locating requirement tables).",
      "query_clauses": [
        "MATCH (hub:Spec {specNumber: '38.133'})",
        "WHERE hub.specRelease IS NULL",
        "MATCH (edition:Spec)-[:IN_RELEASE_OF]->(hub)",
        "MATCH (anchor:Section {sectionNumber: '9.2.5.1'})-[:BELONGS_TO_SPEC]->(edition)",
        "MATCH (anchor)-[:CONTAINS_TABLE]->(obj:TSTable)",
        "RETURN DISTINCT obj.tableId AS tableId, obj.tableNumber AS tableNumber, obj.tableCaption AS tableCaption",
        "ORDER BY tableId"
      ],
