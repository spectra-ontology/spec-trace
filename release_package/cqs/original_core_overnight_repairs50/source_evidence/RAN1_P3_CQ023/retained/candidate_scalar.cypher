MATCH (a:Agreement)-[:REFERENCES]->(c:CR)-[:MODIFIES]->(sp:Spec)
WHERE sp.specNumber='38.214'
WITH a,collect(DISTINCT c{.*,typed214:true,targetNumber:coalesce(toString(toInteger(toFloat(c.crNumber))), '')}) AS docs
UNWIND [coalesce(a.content,''),coalesce(a.contentWithEquations,''),coalesce(a.note,'')] AS fieldText
WITH a,docs,split(replace(replace(fieldText,'\r\n','\n'),'\r','\n'),'\n') AS lines
WITH *,coalesce(head([k IN CASE WHEN size(lines) = 0 THEN [] ELSE range(0,size(lines)-1) END WHERE (lines[k] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") | k]),size(lines)) AS cut
WITH *,reduce(own='',k IN CASE WHEN 0>cut-1 THEN [] ELSE range(0,cut-1) END | own+CASE WHEN k=0 THEN '' ELSE '\n' END+lines[k]) AS ownText
WITH *,((cut>0 AND cut<size(lines) AND any(document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[cut], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END)) AND NOT any(k IN CASE WHEN 0>cut-1 THEN [] ELSE range(0,cut-1) END WHERE ((lines[k] =~ "(?i)(?s:.*?)(?:^\\s*(?:Issue\\s*#?\\s*\\d|Reference signals\\b|[-* ]*End\\s+of\\s+(?:TP|text\\s+proposal|change\\s+request)))(?s:.*)") OR (lines[k] =~ "(?i)(?s:.*?)(?:^\\s*Follow\\s*up\\s+discussion\\b)(?s:.*)"))) AND NOT (ownText =~ "(?i)(?s:.*?)(?:\\b(?:down[- ]select(?:ion)?(?:\\s+one)?|one of (?:the )?following(?:s)?)\\b)(?s:.*)") AND NOT ((ownText =~ "(?i)(?s:.*?)(?:\\bOpt(?:ion)?\\s*1\\s*:)(?s:.*)") AND (ownText =~ "(?i)(?s:.*?)(?:\\bOpt(?:ion)?\\s*2\\s*:)(?s:.*)")) AND NOT ((lines[0] =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*\\d{3}(?!\\d))(?s:.*)") AND NOT (lines[0] =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)")) AND NOT (lines[0] =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND ((ownText =~ "(?i)(?s:.*?)(?:\\b(?:shall|is expected to|is not expected to|are applied|is transmitted|can only be|clarif(?:y|ied)|fix|add|remove|replace|amend|correct|apply existing agreements|further revised as follows|support\\s+\\w+\\s*=)\\b)(?s:.*)") OR ((ownText =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)") AND (ownText =~ "(?i)(?s:.*?)(?:\\b(?:(?:the\\s*)?TPs?(?=\\b|[0-9#_])|text proposals?\\b|proposals?\\s*\\d))(?s:.*)") AND size(reduce(documentIDs = [], tailPart IN tail(split(ownText, 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END))>0 AND NOT (ownText =~ "(?i)(?s:.*?)(?:\\b(?:not pursued|no consensus|not endorsed|not agreed|if approved)\\b)(?s:.*)")))) AS postfixedCandidate
UNWIND CASE WHEN size(lines) = 0 THEN [] ELSE range(0,size(lines)-1) END AS line0
WITH a,docs,lines,postfixedCandidate,line0,lines[line0] AS l,
 [document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[line0], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END)] AS lineDocs,
 coalesce(last([position IN range(0,line0) WHERE (lines[position] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") | head(reduce(documentIDs = [], tailPart IN tail(split(lines[position], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END))]),'') AS currentHeader
WITH *,
     size(reduce(documentIDs = [], tailPart IN tail(split(l, 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END))=0 AS noLineIDs,
     any(document IN docs WHERE document.tdocNumber=currentHeader AND document.typed214) AS headerTyped214,
     any(document IN docs WHERE document.typed214 AND document.targetNumber<>'' AND l =~ ('(?is).*?\\bCR\\s*#?\\s*0*'+document.targetNumber+'(?:\\s*(?:rev|r)\\s*\\d+)?\\b.*')) AS targetNumberTuple,
     ((l =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") AND any(document IN lineDocs WHERE document.typed214) AND any(openerPosition IN CASE WHEN line0=0 THEN [] ELSE range(0,line0-1) END WHERE ((NOT (lines[openerPosition] =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (lines[openerPosition] =~ "(?i)(?s:.*?)(?:(?:following\\s+(?:final\\s+)?CRs?.{0,80}\\b(?:agreed|endorsed|approved)|(?:final|draft)\\s*CRs?.{0,60}\\b(?:agreed|endorsed|approved).{0,20}\\bin\\s*:)|agreed\\s+(?:TPs?|text proposals?).{0,150}(?:following|draft\\s*CR)|(?:draft\\s*CR).{0,80}endorsed\\s+in\\s*:)(?s:.*)")) AND NOT any(betweenPosition IN CASE WHEN openerPosition+1>=line0 THEN [] ELSE range(openerPosition+1,line0-1) END WHERE ((NOT (lines[betweenPosition] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)")) AND trim(lines[betweenPosition])<>'' AND (NOT (lines[betweenPosition] =~ "(?i)(?s:.*?)(?:^\\s*(?:\\(?(?:Rel-|TS\\s*38)|R1-\\d|[,;]|MCC\\b|(?:The )?spec(?:ification)? editor))(?s:.*)")))))) AS listedApproved214,
     ((l =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") AND any(document IN lineDocs WHERE document.typed214) AND any(openerPosition IN CASE WHEN line0=0 THEN [] ELSE range(0,line0-1) END WHERE ((lines[openerPosition] =~ "(?i)(?s:.*?)(?:^\\s*(?:(?:Monday|Tuesday|Wednesday|Thursday|Friday)(?:\\s+decision)?:\\s*)?(?:The\\s+)?(?:following\\s+(?:(?:final|draft|alignment)\\s+)?CRs?\\s+(?:are\\s+)?(?:agreed|endorsed|approved)|agreed\\s+text\\s+proposals?.*captured\\s+in\\s+the\\s+following.*draft\\s+CRs?))(?s:.*)") AND (NOT (lines[openerPosition] =~ "(?i)(?s:.*?)(?:not\\s+(?:agreed|endorsed|approved))(?s:.*)"))) AND NOT any(betweenPosition IN CASE WHEN openerPosition+1>=line0 THEN [] ELSE range(openerPosition+1,line0-1) END WHERE (lines[betweenPosition] =~ "(?i)(?s:.*?)(?:^\\s*(?:Discussion:|Issue\\s*#?\\d|Decision:|No\\s+(?:agreement|consensus)|Noted\\b|For\\s+further\\s+study|Comeback\\b))(?s:.*)")))) AS openedApprovedCRList214,
     (any(document IN lineDocs WHERE document.typed214) AND ((l =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") OR (NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:TS\\s*)?\\d{2}\\.\\d{3}\\b)(?s:.*)"))) AND any(openerPosition IN CASE WHEN line0=0 THEN [] ELSE range(0,line0-1) END WHERE ((lines[openerPosition] =~ "(?i)(?s:.*?)(?:following\\s+(?:editorial\\s+changes|text\\s+proposals?|TPs?))(?s:.*)") AND ((lines[openerPosition] =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:agreed|endorsed|approved|adopted|agreeable)|^\\s*(?:Agree\\s+on|Adopt|Endorse|Approve|Accept)\\b)(?s:.*)") OR ((lines[openerPosition] =~ "(?i)(?s:.*?)(?:\\b(?:draft\\s*)?CRs?\\b)(?s:.*)") AND (lines[openerPosition] =~ "(?i)(?s:.*?)(?:include\\s+(?:them|these))(?s:.*)"))) AND (NOT (lines[openerPosition] =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)"))) AND NOT any(betweenPosition IN CASE WHEN openerPosition+1>=line0 THEN [] ELSE range(openerPosition+1,line0-1) END WHERE ((lines[betweenPosition] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") OR (lines[betweenPosition] =~ "(?i)(?s:.*?)(?:^\\s*(?:Discussion:|Issue\\s*#?\\d|No\\s+(?:consensus|agreement)|Noted\\b|Comeback\\b|Come\\s+back\\b|Reason\\s+for\\s+change|Consequences\\s+if\\s+not\\s+approved))(?s:.*)"))))) AS approvedTPList214
WITH a WHERE (postfixedCandidate OR ((l =~ "(?i)(?s:.*?)(?:^\\s*Include\\s+the\\s+following\\s+TP\\b)(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:\\balignment\\s+CR\\b)(?s:.*)") AND line0+1<size(lines) AND (lines[line0+1] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") AND any(document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[line0+1], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END))) OR (((l =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:\\b(?:(?:the\\s*)?TPs?(?=\\b|[0-9#_])|text proposals?\\b|proposals?\\s*\\d))(?s:.*)") AND NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:\\b(?:below|following)\\b)(?s:.*)") AND any(j IN CASE WHEN line0+1>size(lines)-1 THEN [] ELSE range(line0+1,size(lines)-1) END WHERE ((lines[j] =~ "(?i)(?s:.*?)(?:\\bStart\\s+of\\s+text\\s+proposal\\b)(?s:.*)") AND (lines[j] =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") AND (lines[j] =~ "(?i)(?s:.*?)(?:\\bwith\\s+draft\\s+CR\\b)(?s:.*)") AND any(document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[j], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END)) AND NOT any(k IN CASE WHEN line0+1>j THEN [] ELSE range(line0+1,j) END WHERE (lines[k] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)"))))) OR (((l =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:\\b(?:(?:the\\s*)?TPs?(?=\\b|[0-9#_])|text proposals?\\b|proposals?\\s*\\d))(?s:.*)") AND NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") AND any(j IN CASE WHEN line0+1>size(lines)-2 THEN [] ELSE range(line0+1,size(lines)-2) END WHERE ((lines[j] =~ "(?i)(?s:.*?)(?:^\\s*Final\\s+CR\\s+in\\s*:\\s*$)(?s:.*)") AND (lines[j+1] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") AND any(document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[j+1], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END))))) OR ((l =~ "(?i)(?s:.*?)(?:\\b(?:include\\s+it|include\\s+this)\\b)(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") AND (l =~ "(?i)(?s:.*?)(?:\\balignment\\s+CR\\b)(?s:.*)") AND any(j IN CASE WHEN 0>line0-1 THEN [] ELSE range(0,line0-1) END WHERE ((lines[j] =~ "(?s:.*?)(?:^\\s*R1-\\d{7}(?!\\d)\\s*\\t)(?s:.*)") AND any(document IN docs WHERE document.tdocNumber IN reduce(documentIDs = [], tailPart IN tail(split(lines[j], 'R1-')) | CASE WHEN substring(tailPart,0,7) =~ '[0-9]{7}' AND (size(tailPart)=7 OR NOT substring(tailPart,7,1) =~ '[0-9]') AND NOT ('R1-'+substring(tailPart,0,7)) IN documentIDs THEN documentIDs + ('R1-'+substring(tailPart,0,7)) ELSE documentIDs END) AND (coalesce(document.title,'') =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)")) AND NOT any(k IN CASE WHEN j>line0-1 THEN [] ELSE range(j,line0-1) END WHERE (lines[k] =~ "(?s:.*?)(?:^\\s*={3,})(?s:.*)")))))) OR ((((NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)")) AND any(d IN lineDocs WHERE (coalesce(d.typed214, '') = true))) OR (((NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:(?:TS\\s*)?38\\s*\\.\\s*214(?!\\d))(?s:.*)") AND targetNumberTuple) OR (((NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")) AND (l =~ "(?i)(?s:.*?)(?:\\b(?:is|are)\\s+(?:endorsed|approved|agreed|adopted|agreeable)|\\b(?:adopt|endorse|approve|accept|agree)\\b)(?s:.*)")) AND ((l =~ "(?i)(?s:.*?)(?:\\b(?:draft\\s*)?CRs?\\b)(?s:.*)") OR (l =~ "(?i)(?s:.*?)(?:\\b(?:(?:the\\s*)?TPs?(?=\\b|[0-9#_])|text proposals?\\b|proposals?\\s*\\d))(?s:.*)")) AND noLineIDs AND headerTyped214) OR listedApproved214 OR openedApprovedCRList214 OR (approvedTPList214 AND NOT (l =~ "(?i)(?s:.*?)(?:\\b(?:not|never)\\s+(?:yet\\s+)?(?:endorsed|approved|agreed|adopted)|\\b(?:no consensus|no agreement|if agreed|if approved|previously agreed|earlier agreed|already agreed)\\b|^\\s*(?:Reason for change|Consequences if not approved):)(?s:.*)")))
RETURN count(DISTINCT a) AS agrCount
