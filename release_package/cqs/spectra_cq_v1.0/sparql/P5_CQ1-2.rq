# SPARQL translation of P5_CQ1-2 — Return the trStatus and conclusions of TR 38.889 (NR-U) to assess standardization readiness.
# Source: ../cypher/P5_CQ1-2.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle ?trStatus ?conclusions
WHERE {
  FILTER EXISTS { ?tr a spectra:TechnicalReport }
  ?tr
      spectra:trNumber ?trNumber .
  FILTER(?trNumber = "38.889")
  OPTIONAL { ?tr spectra:trTitle ?trTitle }
  OPTIONAL { ?tr spectra:trStatus ?trStatus }
  OPTIONAL { ?tr spectra:conclusions ?conclusions }
}
