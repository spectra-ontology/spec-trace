# SPARQL translation of P1_CQ4-1 — List Samsung's prior TDocs in Work Item NR_eMIMO-Core across past meetings (technology-history tracing).
# Source: ../cypher/P1_CQ4-1.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?meetingNumber ?tdocNumber ?title ?status
WHERE {
  FILTER EXISTS { ?c a spectra:Company }
  ?c
     spectra:companyName "Samsung" .
  FILTER EXISTS { ?wi a spectra:WorkItem }
  ?wi
      spectra:workItemCode "NR_eMIMO-Core" .
  FILTER EXISTS { ?t a spectra:Tdoc }
  ?t
     spectra:submittedBy ?c ;
     spectra:relatedTo ?wi ;
     spectra:presentedAt ?m .
  FILTER EXISTS { ?m a spectra:Meeting }
  OPTIONAL { ?m spectra:meetingNumber ?meetingNumber }
  OPTIONAL { ?t spectra:tdocNumber ?tdocNumber }
  OPTIONAL { ?t spectra:title ?title }
  OPTIONAL { ?t spectra:status ?status }
  OPTIONAL { ?m spectra:meetingNumberInt ?meetingNumberInt }
}
ORDER BY DESC(?meetingNumberInt) ASC(?tdocNumber)
LIMIT 10
