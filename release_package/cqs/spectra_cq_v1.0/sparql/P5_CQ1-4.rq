# SPARQL translation of P5_CQ1-4 — Return the scope and conclusions of TR 38.885 (V2X Sidelink) — automotive-communications product planning.
# Source: ../cypher/P5_CQ1-4.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?trNumber ?trTitle ?trStatus ?scope ?conclusions
WHERE {
  FILTER EXISTS { ?tr a spectra:TechnicalReport }
  ?tr
      spectra:trNumber ?trNumber .
  FILTER(?trNumber = "38.885")
  OPTIONAL { ?tr spectra:trTitle ?trTitle }
  OPTIONAL { ?tr spectra:trStatus ?trStatus }
  OPTIONAL { ?tr spectra:scope ?scope }
  OPTIONAL { ?tr spectra:conclusions ?conclusions }
}
