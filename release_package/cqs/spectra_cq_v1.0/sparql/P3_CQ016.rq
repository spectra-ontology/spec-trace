# SPARQL translation of P3_CQ016 — Return the total CR count for TS 38.214 (amendment activity).
# Source: ../cypher/P3_CQ016.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT (COUNT(?cr) AS ?totalCR)
WHERE {
  FILTER EXISTS { ?cr a spectra:CR }
  ?cr
      spectra:modifies ?sp .
  FILTER EXISTS { ?sp a spectra:Spec }
  ?sp
      spectra:specNumber "38.214" .
}
