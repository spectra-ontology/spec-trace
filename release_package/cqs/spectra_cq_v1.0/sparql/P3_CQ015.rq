# SPARQL translation of P3_CQ015 — Return the 2-hop dependencies of TS 38.214 §5.1 (transitive references).
# Source: ../cypher/P3_CQ015.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?via ?target ?sectionTitle
WHERE {
  FILTER EXISTS { ?start a spectra:Section }
  ?start
         spectra:sectionId "38.214-5.1" ;
         spectra:referencesSection ?mid .
  FILTER EXISTS { ?mid a spectra:Section }
  ?mid
       spectra:referencesSection ?end .
  FILTER EXISTS { ?end a spectra:Section }
  ?mid spectra:belongsToSpec ?sp1 .
  FILTER EXISTS { ?sp1 a spectra:Spec }
  ?end spectra:belongsToSpec ?sp2 .
  FILTER EXISTS { ?sp2 a spectra:Spec }
  OPTIONAL { ?sp1 spectra:specNumber ?spNum1 }
  OPTIONAL { ?mid spectra:sectionNumber ?midNum }
  OPTIONAL { ?sp2 spectra:specNumber ?spNum2 }
  OPTIONAL { ?end spectra:sectionNumber ?endNum }
  OPTIONAL { ?end spectra:sectionTitle ?sectionTitle }
  BIND(CONCAT(?spNum1, "-", ?midNum) AS ?via)
  BIND(CONCAT(?spNum2, "-", ?endNum) AS ?target)
}
LIMIT 20
