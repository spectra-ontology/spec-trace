# SPARQL translation of P1_CQ1-7 — Return the purpose (For field, e.g., Discussion/Approval/Agreement) of TDoc R1-2501234.
# Source: ../cypher/P1_CQ1-7.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber ?title ?for
WHERE {
  FILTER EXISTS { ?t a spectra:Tdoc }
  ?t
     spectra:tdocNumber ?tdocNumber .
  FILTER(?tdocNumber = "R1-2501234")
  OPTIONAL { ?t spectra:title ?title }
  OPTIONAL { ?t spectra:for ?for }
}
LIMIT 1
