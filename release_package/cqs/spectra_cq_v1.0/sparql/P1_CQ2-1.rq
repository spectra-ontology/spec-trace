# SPARQL translation of P1_CQ2-1 — Return the revision history (predecessor/successor versions) of TDoc R1-2501234 (revision-lineage tracing).
# Source: ../cypher/P1_CQ2-1.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?previous ?current ?title ?revised_to
WHERE {
  FILTER EXISTS { ?t a spectra:Tdoc }
  ?t
     spectra:tdocNumber ?current .
  FILTER(?current = "R1-2501234")
  OPTIONAL { ?t spectra:title ?title }
  OPTIONAL {
    ?t spectra:isRevisionOf ?prev .
    FILTER EXISTS { ?prev a spectra:Tdoc }
    OPTIONAL { ?prev spectra:tdocNumber ?previous }
  }
  OPTIONAL {
    ?t spectra:revisedTo ?next .
    FILTER EXISTS { ?next a spectra:Tdoc }
    OPTIONAL { ?next spectra:tdocNumber ?revised_to }
  }
}
ORDER BY ASC(?current)
LIMIT 10
