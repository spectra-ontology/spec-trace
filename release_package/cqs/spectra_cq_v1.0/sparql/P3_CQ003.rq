# SPARQL translation of P3_CQ003 — Return the breadcrumb (path-to-root) of TS 38.214 §5.1.3.2.
# Source: ../cypher/P3_CQ003.cypher
# Note: Cypher PARENT_SECTION*0..10 path-to-root is translated with the parentSection* property
#       path; in this KG every Section has at most one parent, so the node set on the unique
#       path-to-root is identical.

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?sectionNumber ?sectionTitle
WHERE {
  FILTER EXISTS { ?target a spectra:Section }
  ?target
          spectra:sectionId "38.214-5.1.3.2" ;
          spectra:parentSection* ?n .
  FILTER EXISTS { ?n a spectra:Section }
  OPTIONAL { ?n spectra:sectionNumber ?sectionNumber }
  OPTIONAL { ?n spectra:sectionTitle ?sectionTitle }
  OPTIONAL { ?n spectra:level ?level }
}
ORDER BY ?level
