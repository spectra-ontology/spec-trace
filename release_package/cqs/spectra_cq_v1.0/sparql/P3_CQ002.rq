# SPARQL translation of P3_CQ002 — Return the immediate sub-sections of TS 38.214 §5.1 (PDSCH-procedure implementation reference).
# Source: ../cypher/P3_CQ002.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?sectionNumber ?sectionTitle
WHERE {
  FILTER EXISTS { ?root a spectra:Section }
  ?root
        spectra:sectionId "38.214-5.1" ;
        spectra:hasSubSection ?sub .
  FILTER EXISTS { ?sub a spectra:Section }
  OPTIONAL { ?sub spectra:sectionNumber ?sectionNumber }
  OPTIONAL { ?sub spectra:sectionTitle ?sectionTitle }
}
ORDER BY ?sectionNumber
