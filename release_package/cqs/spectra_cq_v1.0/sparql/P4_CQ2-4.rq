# SPARQL translation of P4_CQ2-4 — Return the CRs declaring the most affected specs (widest cross-spec impact).
# Source: ../cypher/P4_CQ2-4.cypher
# Realization note: affects*Spec edges sit on the Tdoc IRI of the paired
# CR/Tdoc twins and are emitted only for CRs, so the CR class restriction is
# implied and must not be re-checked against the Tdoc IRI.
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber (COUNT(DISTINCT ?sp) AS ?affectedSpecCount)
       (GROUP_CONCAT(DISTINCT ?specNumber; SEPARATOR=", ") AS ?affectedSpecs)
WHERE {
  VALUES ?rel { spectra:affectsCoreSpec spectra:affectsTestSpec spectra:affectsOmSpec }
  ?cr ?rel ?sp .
  FILTER EXISTS { ?sp a spectra:Spec }
  OPTIONAL { ?cr spectra:tdocNumber ?tdocNumber }
  OPTIONAL { ?sp spectra:specNumber ?specNumber }
}
GROUP BY ?tdocNumber
ORDER BY DESC(?affectedSpecCount) ASC(?tdocNumber)
LIMIT 10
