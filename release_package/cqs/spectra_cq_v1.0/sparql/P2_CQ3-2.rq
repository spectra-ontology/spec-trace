# SPARQL translation of P2_CQ3-2 — Return Samsung's Agreement-contributing TDoc count and ratio (standard-contribution analysis).
# Source: ../cypher/P2_CQ3-2.cypher
# Note: Agreement literals and Resolution edges live on paired IRIs sharing resolutionId (1:1 in the released TTL).
PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?companyName ?totalTdocs ?agreementCount
       ((ROUND(1000.0 * ?agreementCount / ?totalTdocs)) / 10.0 AS ?contributionRate)
WHERE {
  FILTER EXISTS { ?c a spectra:Company }
  ?c
     spectra:companyName ?companyName .
  FILTER (?companyName = 'Samsung')
  {
    SELECT ?c (COUNT(?t) AS ?totalTdocs)
    WHERE {
      FILTER EXISTS { ?c a spectra:Company }
      ?c
         spectra:companyName 'Samsung' .
      FILTER EXISTS { ?t a spectra:Tdoc }
      ?t
         spectra:submittedBy ?c .
    }
    GROUP BY ?c
  }
  {
    SELECT ?c (COUNT(DISTINCT ?a) AS ?agreementCount)
    WHERE {
      FILTER EXISTS { ?c a spectra:Company }
      ?c
         spectra:companyName 'Samsung' .
      OPTIONAL {
        FILTER EXISTS { ?r a spectra:Resolution }
        ?r
           spectra:resolutionId ?rid ;
           spectra:references ?t2 .
        FILTER EXISTS { ?a a spectra:Agreement }
        ?a
           spectra:resolutionId ?rid .
        FILTER EXISTS { ?t2 a spectra:Tdoc }
        ?t2
            spectra:submittedBy ?c .
      }
    }
    GROUP BY ?c
  }
}
