# SPARQL translation of P1_CQ2-5 — Return the CR category (F/A/B/C/D) and the affected clauses for CR R1-2504971.
# Source: ../cypher/P1_CQ2-5.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber ?title ?crCategory ?clausesAffected ?status
WHERE {
  FILTER EXISTS { ?t a spectra:Tdoc }
  ?t
     spectra:tdocNumber ?tdocNumber .
  FILTER(?tdocNumber = "R1-2504971")
  OPTIONAL { ?t spectra:title ?title }
  OPTIONAL { ?t spectra:crCategory ?crCategory }
  OPTIONAL { ?t spectra:clausesAffected ?clausesAffected }
  OPTIONAL { ?t spectra:status ?status }
}
LIMIT 1
