# SPARQL translation of P1_CQ1-6 — Return the decision status of TDoc R1-2501234 (single-TDoc status lookup).
# Source: ../cypher/P1_CQ1-6.cypher

PREFIX spectra: <https://w3id.org/spectra#>

SELECT ?tdocNumber ?title ?status
WHERE {
  FILTER EXISTS { ?t a spectra:Tdoc }
  ?t
     spectra:tdocNumber ?tdocNumber .
  FILTER(?tdocNumber = "R1-2501234")
  OPTIONAL { ?t spectra:title ?title }
  OPTIONAL { ?t spectra:status ?status }
}
LIMIT 1
