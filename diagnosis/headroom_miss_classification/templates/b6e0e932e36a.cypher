MATCH (p:CRPack {crPackId: '{ANCHOR}'})-[:HAS_CR|BELONGS_TO_CR_PACK]-(c) WITH DISTINCT p, c, replace(replace(replace(replace(replace(replace(toLower(toString(coalesce(c._targetRelease, head([(c)-[:TARGET_RELEASE]->(rlA:Release) | rlA.releaseName])))),'release',''),'rel',''),'r',''),'-',''),'_',''),' ','') AS rel WHERE rel IN ['18'] MATCH (dd:DecisionDisposition) WHERE dd.targetTdocNumber = c.tdocNumber OR (dd)-[:DISPOSITION_TARGET]->(c) WITH p, c, rel, dd, toLower(coalesce(toString(dd.evidenceStatus), '')) AS es, toLower(coalesce(toString(dd.assessmentMethod), '')) AS am WHERE NOT (es CONTAINS 'unverif' OR es CONTAINS 'not_verif' OR es CONTAINS 'not verif' OR es CONTAINS 'not-verif' OR es CONTAINS 'nonverif' OR es CONTAINS 'non_verif' OR es CONTAINS 'non-verif' OR es CONTAINS 'fail' OR es CONTAINS 'mismatch') AND NOT (am CONTAINS 'unverif' OR am CONTAINS 'not_verif' OR am CONTAINS 'not verif' OR am CONTAINS 'not-verif' OR am CONTAINS 'nonverif' OR am CONTAINS 'non_verif' OR am CONTAINS 'non-verif' OR am CONTAINS 'fail' OR am CONTAINS 'mismatch') AND (es CONTAINS 'verif' OR am CONTAINS 'verif') AND NOT toLower(coalesce(toString(dd.dispositionCode), '')) CONTAINS 'partial' MATCH (dd)-[:DISPOSITION_OF|HAS_DISPOSITION]-(r:Resolution)-[:MADE_AT]->(m:Meeting) WHERE toUpper(coalesce(toString(m.workingGroup), 'RAN1')) CONTAINS '1' WITH DISTINCT p, c, rel MATCH (c)-[:MODIFIES_SECTION]->(s:Section) WITH p, c, rel, s, [(s)-[:BELONGS_TO_SPEC|HAS_SECTION]-(sxA:Spec) | replace(replace(replace(replace(replace(replace(toLower(toString(coalesce(sxA.specRelease, head([(sxA)-[:SPEC_IN_RELEASE]->(syA:Release) | syA.releaseName]), split(toString(sxA.specVersion), '.')[0]))),'release',''),'rel',''),'r',''),'-',''),'_',''),' ','')] AS srels WHERE rel IN srels OR all(v IN srels WHERE v IS NULL) WITH DISTINCT rel, s, toInteger(reduce(dA = '', chA IN split(coalesce(toString(p.tsgMeeting), ''), '') | dA + CASE WHEN chA >= '0' AND chA <= '9' THEN chA ELSE '' END)) AS k MATCH (s2:Section)<-[:MODIFIES_SECTION]-(c2)-[:HAS_CR|BELONGS_TO_CR_PACK]-(p2:CRPack) WHERE s2.specNumber = s.specNumber AND s2.sectionNumber = s.sectionNumber WITH rel, s, k, c2, p2, toInteger(reduce(dB = '', chB IN split(coalesce(toString(p2.tsgMeeting), ''), '') | dB + CASE WHEN chB >= '0' AND chB <= '9' THEN chB ELSE '' END)) AS k2 WHERE replace(replace(replace(replace(replace(replace(toLower(toString(coalesce(c2._targetRelease, head([(c2)-[:TARGET_RELEASE]->(rlB:Release) | rlB.releaseName])))),'release',''),'rel',''),'r',''),'-',''),'_',''),' ','') = rel AND k2 < k WITH rel, s, max(k2) AS kmax, collect(DISTINCT {id: p2.crPackId, k: k2}) AS cands MATCH (p3:CRPack) WHERE p3.crPackId IN [x IN cands WHERE x.k = kmax | x.id] AND toInteger(reduce(dC = '', chC IN split(coalesce(toString(p3.tsgMeeting), ''), '') | dC + CASE WHEN chC >= '0' AND chC <= '9' THEN chC ELSE '' END)) = kmax RETURN DISTINCT s.specNumber AS specification, s.sectionNumber AS clause, p3.crPackId AS cr_pack, p3.tsgMeeting AS tsg_meeting
