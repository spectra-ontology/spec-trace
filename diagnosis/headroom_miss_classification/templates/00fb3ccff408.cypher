MATCH (c:Tdoc {tdocNumber: '{ANCHOR}'})-[:TARGET_RELEASE]->(rel:Release) WHERE toString(rel.releaseName) ENDS WITH '16' OR toString(rel.id) ENDS WITH '16' MATCH (c)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) WHERE ((sp)-[:SPEC_IN_RELEASE]->(rel) OR (sp.specRelease IS NOT NULL AND toString(sp.specRelease) IN [toString(rel.releaseName), toString(rel.id)])) WITH DISTINCT rel, sp.specNumber AS spec, s.sectionNumber AS clause MATCH (s2:Section {sectionNumber: clause})-[:BELONGS_TO_SPEC]->(sp2:Spec {specNumber: spec}) WHERE ((sp2)-[:SPEC_IN_RELEASE]->(rel) OR (sp2.specRelease IS NOT NULL AND toString(sp2.specRelease) IN [toString(rel.releaseName), toString(rel.id)])) MATCH (c2:Tdoc)-[:MODIFIES_SECTION]->(s2) WHERE c2.tdocNumber <> '{ANCHOR}' AND (c2)-[:TARGET_RELEASE]->(rel) MATCH (dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(c2) MATCH (r:Resolution)-[:HAS_DISPOSITION|DISPOSITION_OF]-(dd) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE (toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'verified' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'unverified' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'not' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'partial' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'fail') AND ((toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'whole' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'entire' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'full' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) IN ['document', 'tdoc', 'doc', 'documentlevel', 'tdoclevel']) AND NOT toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'part') AND (m.workingGroup IS NULL OR toUpper(toString(m.workingGroup)) CONTAINS '4') MATCH (cp:CRPack)-[:HAS_CR|BELONGS_TO_CR_PACK]-(c2) RETURN DISTINCT clause AS clause, c2.tdocNumber AS document, dd.dispositionCode AS disposition, m.meetingNumber AS wg_meeting, cp.crPackId AS cr_pack
