MATCH (c) WHERE (c:CR OR c:Tdoc) AND c.tdocNumber = '{ANCHOR}' MATCH (c)-[:MODIFIES_SECTION]->(s:Section) WITH DISTINCT s, [(s)-[:BELONGS_TO_SPEC|HAS_SECTION]-(sxA:Spec) | replace(replace(replace(replace(replace(replace(toLower(toString(coalesce(sxA.specRelease, head([(sxA)-[:SPEC_IN_RELEASE]->(syA:Release) | syA.releaseName]), split(toString(sxA.specVersion), '.')[0]))),'release',''),'rel',''),'r',''),'-',''),'_',''),' ','')] AS srels WHERE '17' IN srels OR all(v IN srels WHERE v IS NULL) MATCH (s2:Section)<-[:MODIFIES_SECTION]-(c2)-[:HAS_CR|BELONGS_TO_CR_PACK]-(p2:CRPack) WHERE s2.specNumber = s.specNumber AND s2.sectionNumber = s.sectionNumber AND c2.tdocNumber <> '{ANCHOR}' WITH DISTINCT s, c2, p2 WHERE replace(replace(replace(replace(replace(replace(toLower(toString(coalesce(c2._targetRelease, head([(c2)-[:TARGET_RELEASE]->(rlB:Release) | rlB.releaseName])))),'release',''),'rel',''),'r',''),'-',''),'_',''),' ','') = '17' MATCH (dd:DecisionDisposition) WHERE dd.targetTdocNumber = c2.tdocNumber OR (dd)-[:DISPOSITION_TARGET]->(c2) WITH s, c2, p2, dd, toLower(coalesce(toString(dd.evidenceStatus), '')) AS es, toLower(coalesce(toString(dd.assessmentMethod), '')) AS am WHERE NOT (es CONTAINS 'unverif' OR es CONTAINS 'not_verif' OR es CONTAINS 'not verif' OR es CONTAINS 'not-verif' OR es CONTAINS 'nonverif' OR es CONTAINS 'non_verif' OR es CONTAINS 'non-verif' OR es CONTAINS 'fail' OR es CONTAINS 'mismatch') AND NOT (am CONTAINS 'unverif' OR am CONTAINS 'not_verif' OR am CONTAINS 'not verif' OR am CONTAINS 'not-verif' OR am CONTAINS 'nonverif' OR am CONTAINS 'non_verif' OR am CONTAINS 'non-verif' OR am CONTAINS 'fail' OR am CONTAINS 'mismatch') AND (es CONTAINS 'verif' OR am CONTAINS 'verif') AND NOT toLower(coalesce(toString(dd.dispositionCode), '')) CONTAINS 'partial' MATCH (dd)-[:DISPOSITION_OF|HAS_DISPOSITION]-(r:Resolution)-[:MADE_AT]->(m:Meeting) WHERE toUpper(coalesce(toString(m.workingGroup), 'RAN1')) CONTAINS '1' RETURN DISTINCT s.sectionNumber AS clause, c2.tdocNumber AS document, dd.dispositionCode AS disposition, coalesce(m.canonicalMeetingNumber, m.meetingNumber) AS wg_meeting, p2.crPackId AS cr_pack
