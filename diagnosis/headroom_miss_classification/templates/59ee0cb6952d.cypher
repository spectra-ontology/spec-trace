MATCH (cp:CRPack {crPackId: '{ANCHOR}'})-[:HAS_CR|BELONGS_TO_CR_PACK]-(c:Tdoc) MATCH (dd:DecisionDisposition)-[:DISPOSITION_TARGET]->(c) MATCH (r:Resolution)-[:HAS_DISPOSITION|DISPOSITION_OF]-(dd) MATCH (r)-[:MADE_AT]->(m:Meeting) WHERE (toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'verified' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'unverified' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'not' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'partial' AND NOT toLower(replace(replace(replace(coalesce(toString(dd.evidenceStatus), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'fail') AND ((toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'whole' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'entire' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'full' OR toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) IN ['document', 'tdoc', 'doc', 'documentlevel', 'tdoclevel']) AND NOT toLower(replace(replace(replace(coalesce(toString(r.resolutionScope), ''), '_', ''), '-', ''), ' ', '')) CONTAINS 'part') AND (m.workingGroup IS NULL OR toUpper(toString(m.workingGroup)) CONTAINS '4') MATCH (c)-[:TARGET_RELEASE]->(rel:Release) MATCH (c)-[:MODIFIES_SECTION]->(s:Section)-[:BELONGS_TO_SPEC]->(sp:Spec) WHERE ((sp)-[:SPEC_IN_RELEASE]->(rel) OR (sp.specRelease IS NOT NULL AND toString(sp.specRelease) IN [toString(rel.releaseName), toString(rel.id)])) WITH DISTINCT c, rel, sp.specNumber AS spec, s.sectionNumber AS clause, (CASE WHEN coalesce(toString(cp.tsgMeeting), '') CONTAINS '#' THEN toInteger([ztpa IN split(reduce(zapa = '', zcpa IN [zipa IN range(0, size(split(coalesce(toString(cp.tsgMeeting), ''), '#')[-1]) - 1) | substring(split(coalesce(toString(cp.tsgMeeting), ''), '#')[-1], zipa, 1)] | zapa + CASE WHEN zcpa >= '0' AND zcpa <= '9' THEN zcpa ELSE ' ' END), ' ') WHERE ztpa <> ''][0]) ELSE toInteger([ztpb IN split(reduce(zapb = '', zcpb IN [zipb IN range(0, size(coalesce(toString(cp.tsgMeeting), '')) - 1) | substring(coalesce(toString(cp.tsgMeeting), ''), zipb, 1)] | zapb + CASE WHEN zcpb >= '0' AND zcpb <= '9' THEN zcpb ELSE ' ' END), ' ') WHERE ztpb <> ''][-1]) END) AS packNo WHERE NOT EXISTS { MATCH (s2:Section {sectionNumber: clause})-[:BELONGS_TO_SPEC]->(sp2:Spec {specNumber: spec}) MATCH (c2:Tdoc)-[:MODIFIES_SECTION]->(s2) MATCH (cp2:CRPack)-[:HAS_CR|BELONGS_TO_CR_PACK]-(c2) WHERE (c2)-[:TARGET_RELEASE]->(rel) AND ((sp2)-[:SPEC_IN_RELEASE]->(rel) OR (sp2.specRelease IS NOT NULL AND toString(sp2.specRelease) IN [toString(rel.releaseName), toString(rel.id)])) AND (CASE WHEN coalesce(toString(cp2.tsgMeeting), '') CONTAINS '#' THEN toInteger([ztqa IN split(reduce(zaqa = '', zcqa IN [ziqa IN range(0, size(split(coalesce(toString(cp2.tsgMeeting), ''), '#')[-1]) - 1) | substring(split(coalesce(toString(cp2.tsgMeeting), ''), '#')[-1], ziqa, 1)] | zaqa + CASE WHEN zcqa >= '0' AND zcqa <= '9' THEN zcqa ELSE ' ' END), ' ') WHERE ztqa <> ''][0]) ELSE toInteger([ztqb IN split(reduce(zaqb = '', zcqb IN [ziqb IN range(0, size(coalesce(toString(cp2.tsgMeeting), '')) - 1) | substring(coalesce(toString(cp2.tsgMeeting), ''), ziqb, 1)] | zaqb + CASE WHEN zcqb >= '0' AND zcqb <= '9' THEN zcqb ELSE ' ' END), ' ') WHERE ztqb <> ''][-1]) END) < packNo } RETURN DISTINCT c.tdocNumber AS document, spec AS specification, clause AS clause
